        1   block-level on error undo, throw.
        2   define input  parameter p-doc-code as character no-undo .
        3   define input  parameter p-cut-date as date      no-undo .
        4   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo initial "$Workfile: aht-prc.p $":U .
        8   define variable vss-archive     as character no-undo initial "$Archive: trg/aht-prc.p $":U .
        9   define variable vss-description as character no-undo initial "Создание складского архива по типам приобретения по переоценке".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28       assign
       29         p-vss-parameters = substitute('&1|&2':u,p-doc-code,p-cut-date)
       30       .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   procedure cur-time :
       84      define output parameter p-today as date      no-undo .
       85      define output parameter p-time  as integer   no-undo .
       86     do
       87     on error undo, return error
       88     :
       89       define variable v-date1 as date      no-undo .
       90       define variable v-date2 as date      no-undo .
       91       define variable v-time  as integer   no-undo .
       92       assign
       93         v-date1 = today
       94         v-time  = time
       95         v-date2 = today
       96       .
       97       if v-date1 <> v-date2
       98       then do:
       99         assign
      100           v-date1 = today
      101           v-time  = v-time
      102         .
      103       end.
      104       assign
      105         p-today = v-date1
      106         p-time  = v-time
      107       .
      108     end.
      109   end.
      110   function cur-time-date returns character
      111   :
      112     return string(today, '99/99/9999':U) .
      113   end.
      114   function cur-time-mjd returns decimal
      115   :
      116     define variable v-date as date      no-undo .
      117     define variable v-time as integer   no-undo .
      118     run cur-time in this-procedure
      119       (output v-date
      120       ,output v-time
      121       ) .
      122     return integer(v-date) - 2400002 + (v-time / 86400) .
      123   end.
      124   function cur-time-get-ending-index returns integer
      125   (input p-number as integer
      126   )
      127   :
      128     if p-number < 0
      129     or p-number = ?
      130     then do:
      131       return 1 .
      132     end.
      133     define variable v-rest as integer   no-undo .
      134     assign
      135       p-number = p-number modulo 100
      136     .
      137     if p-number < 20
      138     then do:
      139       assign
      140         v-rest = p-number
      141       .
      142     end.
      143     else do:
      144       assign
      145         v-rest = p-number modulo 10
      146       .
      147     end.
      148     case v-rest :
      149       when 1
      150       then do:
      151         return 2 .
      152       end.
      153       when 2 or
      154       when 3 or
      155       when 4
      156       then do:
      157         return 3 .
      158       end.
      159       otherwise do:
      160         return 1 .
      161       end.
      162     end case .
      163   end.
      164   procedure cur-time-mjd-to-date :
      165      define input  parameter i-mjd-diff as decimal no-undo.
      166      define output parameter o-Date     as date    no-undo.
      167      define output parameter o-Time     as integer no-undo.
      168      define variable v-day-number as integer   no-undo .
      169      if    i-mjd-diff < 0
      170         or i-mjd-diff = ?
      171      then do:
      172         return "?" .
      173      end.
      174      assign
      175         v-day-number = truncate(i-mjd-diff,0).
      176         o-Date = date(v-day-number + 2400002).
      177         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      178     .
      179   end.
      180   function cur-time-mjd-to-string returns character
      181   (input p-mjd-diff as decimal
      182   )
      183   :
      184     define variable v-day-number as integer   no-undo .
      185     define variable v-seconds    as integer   no-undo .
      186     define variable v-hour       as integer   no-undo .
      187     define variable v-min        as integer   no-undo .
      188     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      189     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      190     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      191     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      192     if p-mjd-diff < 0
      193     or p-mjd-diff = ?
      194     then do:
      195       return "?" .
      196     end.
      197     assign
      198       v-day-number = integer(truncate(p-mjd-diff,0))
      199       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      200     .
      201     if v-seconds > 86400
      202     then do:
      203       assign
      204         v-seconds = 86400 - 1
      205       .
      206     end.
      207     if v-seconds < 0
      208     then do:
      209       assign
      210         v-seconds = 0
      211       .
      212     end.
      213     assign
      214       v-hour = truncate(v-seconds / 3600, 0)
      215     .
      216     assign
      217       v-seconds = v-seconds modulo 3600
      218     .
      219     assign
      220       v-min = truncate(v-seconds / 60, 0)
      221     .
      222     assign
      223       v-seconds = v-seconds modulo 60
      224     .
      225     return
      226         (if v-day-number <> 0
      227           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0
      231           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      232           else ""
      233         )
      234       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      235           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      236           else ""
      237         )
      238       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      239       .
      240   end.
      241   function cur-time-string returns character
      242   :
      243     define variable v-date as date      no-undo .
      244     define variable v-time as integer   no-undo .
      245     run cur-time in this-procedure
      246       (output v-date
      247       ,output v-time
      248       ) .
      249     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      250   end.
      251   function cur-time-string-sec returns character
      252   :
      253     define variable v-date as date      no-undo .
      254     define variable v-time as integer   no-undo .
      255     run cur-time in this-procedure
      256       (output v-date
      257       ,output v-time
      258       ) .
      259     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      260   end.
      261   function cur-time-custom  returns character
      262   (input p-prefix as character
      263   ,input p-date-format as character
      264   ,input p-delimiter as character
      265   ,input p-time-format as character
      266   ,input p-suffix as character
      267   )
      268   :
      269     define variable v-date as date      no-undo .
      270     define variable v-time as integer   no-undo .
      271     run cur-time in this-procedure
      272       (output v-date
      273       ,output v-time
      274       ) .
      275     return
      276       p-prefix
      277       + string(v-date, p-date-format)
      278       + p-delimiter
      279       + string(v-time, p-time-format)
      280       + p-suffix
      281       .
      282   end.
      283   function cur-time-print  returns character
      284   :
      285     define variable v-date as date      no-undo .
      286     define variable v-time as integer   no-undo .
      287     run cur-time in this-procedure
      288       (output v-date
      289       ,output v-time
      290       ) .
      291     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      292   end.
      293   function cur-time-datetime returns datetime
      294   :
      295     define variable v-char as character no-undo .
      296     define variable v-datetime as datetime no-undo .
      297     v-char = cur-time-string().
      298     v-datetime = datetime(v-char).
      299     return  v-datetime.
      300   end.
      301   function cur-time-string-msec returns character
      302   :
      303     define variable v-date as datetime  no-undo .
      304     v-date = now.
      305     return string(v-date) .
      306   end.
      307   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      308   procedure factord :
      309     define input  parameter p-fact-date            as date    no-undo .
      310     define input  parameter p-fact-time            as integer no-undo .
      311     define input  parameter p-fact-num             as integer no-undo .
      312     define input  parameter p-shift-date           as date    no-undo .
      313     define input  parameter p-shift-num            as integer no-undo .
      314     define input  parameter p-shift-on             as logical no-undo .
      315     define output parameter p-fact-order           as decimal no-undo .
      316     define output parameter p-shift-end-fact-order as decimal no-undo .
      317     define output parameter p-day-end-fact-order   as decimal no-undo .
      318     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      319     if p-fact-date = ?
      320     then do:
      321       return error "Не указана фактическая дата" .
      322     end.
      323     define variable v-fact-date-num as integer no-undo .
      324     assign
      325       v-fact-date-num = integer(p-fact-date)
      326     .
      327     if p-fact-num = ?
      328     or p-fact-num = 0
      329     then do:
      330       return error "Не задан p-fact-num " + string(p-fact-num) .
      331     end.
      332     if p-fact-num < 0
      333     then do:
      334       return error "Отрицательный fact-num " + string(p-fact-num) .
      335     end.
      336     if p-fact-num >= 100000000
      337     then do:
      338       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      339     end.
      340     if p-shift-on = true
      341     then do:
      342       if p-shift-date = ?
      343       then do:
      344         return error "Не задана дата смены" .
      345       end.
      346       if p-shift-num = ?
      347       or p-shift-num = 0
      348       then do:
      349         return error "Не задан номер смены" .
      350       end.
      351     end.
      352     else do:
      353       assign
      354         p-shift-date = p-fact-date
      355         p-shift-num  = 24
      356       .
      357     end.
      358     define variable v-shift-offset as integer no-undo .
      359     if p-shift-date = p-fact-date
      360     then do:
      361       assign
      362         v-shift-offset = 1
      363       .
      364     end.
      365     if p-shift-date < p-fact-date
      366     then do:
      367       assign
      368         v-shift-offset = 0
      369       .
      370     end.
      371     if p-shift-date > p-fact-date
      372     then do:
      373       message
      374         vss-workfile vss-revision vss-description skip
      375         "Неправильная дата закрытия смены" skip
      376         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      377         view-as alert-box error .
      378       undo, return error
      379         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      380           ,string(p-fact-date, '99/99/9999':U)
      381           ,string(p-shift-date, '99/99/9999':U)
      382           )
      383       .
      384     end.
      385     if p-shift-num < 1
      386     or p-shift-num > 24
      387     then do:
      388       message
      389         vss-workfile vss-revision vss-description skip
      390         "Неправильный номер смены" skip
      391         "p-shift-num" p-shift-num skip
      392         view-as alert-box error .
      393       undo, return error return-value .
      394     end.
      395     assign
      396       p-fact-order           = v-fact-date-num
      397                              + v-shift-offset * 0.5
      398                              + p-shift-num    * 0.02 - 0.01
      399                              + p-fact-num     * 0.0000000001
      400       p-shift-end-fact-order = v-fact-date-num
      401                              + v-shift-offset * 0.5
      402                              + p-shift-num    * 0.02
      403       p-day-end-fact-order   = v-fact-date-num
      404                              + 0.99
      405     .
      406     if p-fact-order           <= v-fact-date-num
      407     or p-shift-end-fact-order <= v-fact-date-num
      408     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      409     or p-shift-end-fact-order >= p-day-end-fact-order
      410     then do:
      411       message
      412         vss-workfile vss-revision vss-description skip
      413         "Внутренняя ошибка при генерации фактического номера" skip
      414         "p-fact-date"            p-fact-date            skip
      415         "p-fact-time"            p-fact-time            skip
      416         "p-fact-num"             p-fact-num             skip
      417         "p-shift-date"           p-shift-date           skip
      418         "p-shift-num"            p-shift-num            skip
      419         "p-shift-on"             p-shift-on             skip
      420         "p-shift-end-fact-order" p-shift-end-fact-order skip
      421         "p-day-end-fact-order"   p-day-end-fact-order   skip
      422         "v-fact-date-num"        v-fact-date-num        skip
      423         view-as alert-box error .
      424       undo, return error return-value .
      425     end.
      426   end procedure.
      427   procedure day-begin-fact-order :
      428     define input  parameter p-fact-date            as date    no-undo .
      429     define output parameter p-day-begin-fact-order as decimal no-undo .
      430     do
      431     on error undo, return error return-value
      432     :
      433       if p-fact-date = ?
      434       then do:
      435         assign
      436           p-day-begin-fact-order = 0
      437         .
      438       end.
      439       else do:
      440         assign
      441           p-day-begin-fact-order = integer(p-fact-date)
      442         .
      443       end.
      444     end.
      445   end procedure.
      446   procedure factord-max-fact-order :
      447     define output parameter p-max-fact-order as decimal   no-undo .
      448     do
      449     on error undo, return error return-value
      450     :
      451       run day-begin-fact-order in this-procedure
      452         (input  date(1, 1, 5000)
      453         ,output p-max-fact-order
      454         ) .
      455     end.
      456   end procedure.
      457   procedure factord-cut-archive :
      458     define input  parameter p-obj-type             as character no-undo .
      459     define input  parameter p-obj-code             as integer   no-undo .
      460     define input  parameter p-fact-date            as date      no-undo .
      461     define output parameter p-shift-on             as logical   no-undo .
      462     define output parameter p-shift-date           as date      no-undo .
      463     define output parameter p-shift-num            as integer   no-undo .
      464     define output parameter p-day-end-fact-order   as decimal   no-undo .
      465     define output parameter p-shift-end-fact-order as decimal   no-undo .
      466     define variable v-fact-order as decimal   no-undo .
      467     define buffer buf_shift-obj for ub.shift-obj .
      468     do
      469     on error undo, return error return-value
      470     :
      471   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      472   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      473     (input  p-obj-type
      474     ,input  p-obj-code
      475     ,input  'shift-on=request'
      476     ,output p-shift-on
      477     ) no-error .
      478       if error-status :error
      479       then do:
      480         message
      481           vss-workfile vss-revision vss-description skip
      482           "Ошибка при определении атрибута объекта" skip
      483           "Объект" p-obj-type p-obj-code skip
      484           error-status :get-message(1) skip
      485           return-value skip
      486           view-as alert-box error .
      487         undo, return error return-value .
      488       end.
      489       if p-shift-on = false
      490       then do:
      491         assign
      492           p-shift-date               = ?
      493           p-shift-num                = 0
      494         .
      495       end.
      496       else do:
      497         find first buf_shift-obj share-lock
      498           where buf_shift-obj.obj-type   = p-obj-type
      499             and buf_shift-obj.obj-code   = p-obj-code
      500             and buf_shift-obj.shift-date > p-fact-date
      501           use-index pi
      502           no-error .
      503         if not available buf_shift-obj
      504         or buf_shift-obj.status_ <> 'зкр':U
      505         then do:
      506           message
      507             vss-workfile vss-revision vss-description skip
      508             "Невозможно вычислить последнюю смену" skip
      509             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      510             "Объект" p-obj-type p-obj-code skip
      511             "Дата" p-fact-date skip
      512             view-as alert-box error .
      513           undo, return error return-value .
      514         end.
      515         find last buf_shift-obj share-lock
      516           where buf_shift-obj.obj-type = p-obj-type
      517             and buf_shift-obj.obj-code = p-obj-code
      518             and buf_shift-obj.shift-date <= p-fact-date
      519           use-index pi
      520           no-error .
      521         if available buf_shift-obj
      522         then do:
      523           if  buf_shift-obj.status_ = 'зкр':U
      524           then do:
      525             assign
      526               p-shift-date = buf_shift-obj.shift-date
      527               p-shift-num  = buf_shift-obj.shift-num
      528             .
      529           end.
      530           else do:
      531             message
      532               vss-workfile vss-revision vss-description skip
      533               "Невозможно вычислить последнюю смену" skip
      534               "Статус смены отличен от статуса" 'зкр':U skip
      535               "Объект" p-obj-type p-obj-code skip
      536               "Дата" p-fact-date skip
      537               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      538               view-as alert-box error .
      539             undo, return error return-value .
      540           end.
      541         end.
      542         else do:
      543           assign
      544             p-shift-date = p-fact-date - 1
      545             p-shift-num  = 1
      546           .
      547         end.
      548       end.
      549       run factord in this-procedure
      550         (input  p-fact-date
      551         ,input  1
      552         ,input  1
      553         ,input  p-shift-date
      554         ,input  p-shift-num
      555         ,input  p-shift-on
      556         ,output v-fact-order
      557         ,output p-shift-end-fact-order
      558         ,output p-day-end-fact-order
      559         ) no-error .
      560       if error-status :error
      561       then do:
      562         message
      563           vss-workfile vss-revision vss-description skip
      564           "Ошибка при вызове процедуры factord"
      565           error-status :get-message(1) skip
      566           return-value skip
      567           view-as alert-box error .
      568         undo, return error return-value .
      569       end.
      570     end.
      571   end procedure.
      572   procedure factord-lock-shift :
      573     define input  parameter p-obj-type  as character no-undo .
      574     define input  parameter p-obj-code  as integer   no-undo .
      575     define input  parameter p-fact-date as date      no-undo .
      576     define parameter buffer buf_shift-obj for ub.shift-obj .
      577     define variable v-shift-on      as logical   no-undo .
      578     define variable v-extra-message as character no-undo .
      579     define variable v-error as character no-undo .
      580     do
      581     on error undo, return error return-value
      582     :
      583   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      584   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      585     (input  p-obj-type
      586     ,input  p-obj-code
      587     ,input  'shift-on=request'
      588     ,output v-shift-on
      589     ) no-error .
      590       if error-status :error
      591       then do:
      592         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      593         undo, return error v-error .
      594       end.
      595       if v-shift-on = true
      596       then do:
      597         find first buf_shift-obj share-lock
      598           where buf_shift-obj.obj-type   = p-obj-type
      599             and buf_shift-obj.obj-code   = p-obj-code
      600             and buf_shift-obj.shift-date > p-fact-date
      601           use-index pi
      602           no-error .
      603         if not available buf_shift-obj
      604         or buf_shift-obj.status_ <> 'зкр':U
      605         then do:
      606           find last buf_shift-obj
      607             where buf_shift-obj.obj-type = p-obj-type
      608               and buf_shift-obj.obj-code = p-obj-code
      609               and buf_shift-obj.status_  = 'зкр':U
      610             use-index stts
      611             no-error .
      612           if available buf_shift-obj
      613           then do:
      614             assign
      615               v-extra-message =
      616                     substitute("Дата начала последеней закрытой смены на объекте &1"
      617                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      618                               )
      619             .
      620           end.
      621           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      622           undo, return error v-error .
      623         end.
      624       end.
      625     end.
      626   end procedure.
      627   procedure factord-end-day :
      628     define input  parameter p-fact-date            as date    no-undo .
      629     define output parameter p-day-end-fact-order   as decimal no-undo .
      630     do
      631     on error undo, return error return-value
      632     :
      633       if p-fact-date = ?
      634       then do:
      635         return error "Не указана фактическая дата" .
      636       end.
      637       assign
      638         p-day-end-fact-order = integer(p-fact-date) + 0.99
      639       .
      640     end.
      641   end procedure.
      642   procedure factord-to-date :
      643     define input  parameter p-fact-order as decimal no-undo .
      644     define output parameter p-fact-date  as date    no-undo .
      645     define variable v-ref-date  as date      no-undo .
      646     define variable v-ref-delta as integer   no-undo .
      647     do
      648     on error undo, return error return-value
      649     :
      650       if p-fact-order = ?
      651       or p-fact-order = 0
      652       then do:
      653         return error "Не указан fact-order" .
      654       end.
      655       assign
      656         v-ref-date  = date(1, 1, 2000)
      657       .
      658       assign
      659         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      660       .
      661       assign
      662         p-fact-date = v-ref-date + v-ref-delta
      663       .
      664     end.
      665   end procedure.
      666   procedure factord-to-fact-num :
      667     define input  parameter p-fact-order as decimal no-undo .
      668     define output parameter p-fact-num   as integer no-undo .
      669     define variable v-fact-order-trunc as decimal no-undo .
      670     do
      671     on error undo, return error return-value
      672     :
      673       if p-fact-order = ?
      674       or p-fact-order = 0
      675       then do:
      676         return error "Не указан fact-order" .
      677       end.
      678       assign
      679        v-fact-order-trunc = truncate(p-fact-order, 2)
      680       .
      681       assign
      682         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      683       .
      684     end.
      685   end procedure.
      686   procedure factord-to-shift-num :
      687     define input  parameter p-fact-order as decimal no-undo .
      688     define output parameter p-shift-num   as integer no-undo .
      689     define variable  p-shift-numd  as decimal   no-undo .
      690     define variable v-fact-order-trunc as decimal no-undo .
      691     do
      692     on error undo, return error return-value
      693     :
      694       if p-fact-order = ?
      695       or p-fact-order = 0
      696       then do:
      697         return error "Не указан fact-order" .
      698       end.
      699       assign
      700        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      701       .
      702       if v-fact-order-trunc < 0.5 then do:
      703         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      704       end.
      705       assign
      706         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      707         .
      708        assign
      709         p-shift-num = truncate (p-shift-numd , 0)
      710       .
      711     end.
      712   end procedure.
