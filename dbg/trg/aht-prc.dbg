     2948   if varis-cons-parts-haveprl = no then do:
     2949     assign
     2950           vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc)
     2951           vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc).
     2952   end.
     2953   else do:
     2954     if vardoc-type = 'инв':U then do:
     2955       assign
     2956               vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl - varprice-base-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * vardoc-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc) * vardoc-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     2957               vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl - varprice-rubl-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * vardoc-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc) * vardoc-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     2958        .
     2959     end.
     2960     else do:
     2961       assign
     2962               vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl - varprice-base-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * varfact-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - varprice-base-consprl) * varvat-pc / (100 + varvat-pc) * varfact-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     2963               vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl - varprice-rubl-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * varfact-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - varprice-rubl-consprl) * varvat-pc / (100 + varvat-pc) * varfact-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     2964        .
     2965     end.
     2966   end.
     2967   assign
     2968   price-base-without-tax-saleprl = price-base-with-tax-saleprl - vat-base-saleprl - slt-base-saleprl - road-tax-base-saleprl
     2969   price-rubl-without-tax-saleprl = price-rubl-with-tax-saleprl - vat-rubl-saleprl - slt-rubl-saleprl - road-tax-rubl-saleprl.
     2970     end.
     2971   end procedure.
     2972   def var vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2973   define stream ahtlog .
     2974   define temp-table temp-aht-ot-tot no-undo like ub.aht-ot-tot .
     2975   define temp-table temp-aht-ot-line no-undo like ub.aht-ot-line .
     2976   define temp-table temp-aht-stk-tot no-undo like ub.aht-stk-tot .
     2977   define temp-table temp-aht-stk-line no-undo like ub.aht-stk-line .
     2978   procedure aht_get-sum-type :
     2979     define input  parameter p-aht-type        as character no-undo .
     2980     define output parameter p-allsum-sum-type as character no-undo .
     2981     do
     2982     on error undo, return error return-value
     2983     :
     2984       case p-aht-type :
     2985         when 'r':U then do:
     2986           assign
     2987             p-allsum-sum-type = 'сумма_по_выкупу_со_знаком':U
     2988           .
     2989         end.
     2990         when 'c':U then do:
     2991           assign
     2992             p-allsum-sum-type = 'сумма_по_консигнации_закупка_со_знаком':U
     2993           .
     2994         end.
     2995         when 'b':U then do:
     2996           assign
     2997             p-allsum-sum-type = 'сумма_по_консигнации_выгода_со_знаком':U
     2998           .
     2999         end.
     3000         when 's':U then do:
     3001           assign
     3002             p-allsum-sum-type = 'сумма_по_ответственному_хранению_со_знаком':U
     3003           .
     3004         end.
     3005         when 'o':U then do:
     3006           assign
     3007             p-allsum-sum-type = 'сумма_по_старой_консигнации_со_знаком':U
     3008           .
     3009         end.
     3010         when 'v':U then do:
     3011           assign
     3012             p-allsum-sum-type = 'сумма_по_услуге_со_знаком':U
     3013           .
     3014         end.
     3015         otherwise do:
     3016           message
     3017             vss-workfile vss-revision vss-description skip
     3018             vss-include-info26 skip
     3019             "Неизвестное значение типа приобретения" skip
     3020             "Тип приобретения" p-aht-type skip
     3021             view-as alert-box error .
     3022           undo, return error .
     3023         end.
     3024       end.
     3025     end.
     3026   end procedure.
     3027   procedure aht_get-stk-sum-type :
     3028     define input  parameter p-ot-sum-type      as character no-undo .
     3029     define input  parameter p-ext-doc-type     as character no-undo .
     3030     define output parameter p-stk-ext-sum-type as character no-undo .
     3031     do
     3032     on error undo, return error return-value
     3033     :
     3034       assign
     3035         p-stk-ext-sum-type = p-ot-sum-type + p-ext-doc-type
     3036       .
     3037     end.
     3038   end procedure.
     3039   procedure aht_store-ot-line :
     3040     define input  parameter p-doc-code       as character no-undo .
