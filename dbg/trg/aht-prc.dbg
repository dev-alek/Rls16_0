     1175   procedure prdoclib-clear-temp-prt-obj :
     1176     define buffer buf_temp-prt-obj for temp-prt-obj .
     1177     do
     1178     on error undo, return error return-value
     1179     :
     1180       for each buf_temp-prt-obj
