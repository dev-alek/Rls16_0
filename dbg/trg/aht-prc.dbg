     1332           "Бар-код" buf_main_price-list.b-code skip
     1333           view-as alert-box error .
     1334         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
     1335       end.
     1336       find first buf_goods no-lock
     1337         where buf_goods.artic     = buf_main_price-list.artic
     1338           and buf_goods.prod-type = buf_main_price-list.prod-type
     1339           and buf_goods.prod-code = buf_main_price-list.prod-code
     1340         no-error .
     1341       if not available buf_goods
     1342       then do:
     1343         message
