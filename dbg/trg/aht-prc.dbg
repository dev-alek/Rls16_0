     2426   procedure prdoclib-clear-temp-pl-gds :
     2427     define buffer buf_temp-pl-gds for temp-pl-gds .
     2428     do
     2429     on error undo, return error return-value
     2430     :
     2431       for each buf_temp-pl-gds
     2432       on error undo, return error return-value
     2433       :
     2434         delete buf_temp-pl-gds .
     2435       end.
     2436     end.
     2437   end procedure.
     2438   procedure prdoclib-init-temp-pl-gds :
     2439     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     2440     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     2441     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     2442     define buffer buf_pl-gds      for ub.pl-gds .
     2443     define buffer buf_temp-pl-gds for temp-pl-gds .
     2444     do
     2445     on error undo, return error return-value
     2446     :
     2447       run prdoclib-clear-temp-pl-gds in this-procedure .
     2448       for each buf_pl-gds
     2449         where buf_pl-gds.obj-type = p-obj-type
     2450           and buf_pl-gds.obj-code = p-obj-code
     2451           and buf_pl-gds.gds-code = p-gds-code
     2452       on error undo, return error return-value
     2453       :
     2454         create buf_temp-pl-gds .
     2455         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     2456       end.
     2457     end.
     2458   end procedure.
