        1   block-level on error undo, throw.
        2   define parameter buffer oldb for ub.pl-gds-attr.
        3   define parameter buffer newb for ub.pl-gds-attr.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "История атрибута товара на складском месте".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28       assign
       29         p-vss-parameters = substitute('&1|&2|&3|&4|&5'
       30                            , newb.obj-type
       31                            , newb.obj-code
       32                            , newb.pl-code
       33                            , newb.gds-code
       34                            , newb.attr-code
       35                            )
       36       .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   procedure cur-time :
       90      define output parameter p-today as date      no-undo .
       91      define output parameter p-time  as integer   no-undo .
       92     do
       93     on error undo, return error
       94     :
       95       define variable v-date1 as date      no-undo .
       96       define variable v-date2 as date      no-undo .
       97       define variable v-time  as integer   no-undo .
       98       assign
       99         v-date1 = today
      100         v-time  = time
      101         v-date2 = today
      102       .
      103       if v-date1 <> v-date2
      104       then do:
      105         assign
      106           v-date1 = today
      107           v-time  = v-time
      108         .
      109       end.
      110       assign
      111         p-today = v-date1
      112         p-time  = v-time
      113       .
      114     end.
      115   end.
      116   function cur-time-date returns character
      117   :
      118     return string(today, '99/99/9999':U) .
      119   end.
      120   function cur-time-mjd returns decimal
      121   :
      122     define variable v-date as date      no-undo .
      123     define variable v-time as integer   no-undo .
      124     run cur-time in this-procedure
      125       (output v-date
      126       ,output v-time
      127       ) .
      128     return integer(v-date) - 2400002 + (v-time / 86400) .
      129   end.
      130   function cur-time-get-ending-index returns integer
      131   (input p-number as integer
      132   )
      133   :
      134     if p-number < 0
      135     or p-number = ?
      136     then do:
      137       return 1 .
      138     end.
      139     define variable v-rest as integer   no-undo .
      140     assign
      141       p-number = p-number modulo 100
      142     .
      143     if p-number < 20
      144     then do:
      145       assign
      146         v-rest = p-number
      147       .
      148     end.
      149     else do:
      150       assign
      151         v-rest = p-number modulo 10
      152       .
      153     end.
      154     case v-rest :
      155       when 1
      156       then do:
      157         return 2 .
      158       end.
      159       when 2 or
      160       when 3 or
      161       when 4
      162       then do:
      163         return 3 .
      164       end.
      165       otherwise do:
      166         return 1 .
      167       end.
      168     end case .
      169   end.
      170   procedure cur-time-mjd-to-date :
      171      define input  parameter i-mjd-diff as decimal no-undo.
      172      define output parameter o-Date     as date    no-undo.
      173      define output parameter o-Time     as integer no-undo.
      174      define variable v-day-number as integer   no-undo .
      175      if    i-mjd-diff < 0
      176         or i-mjd-diff = ?
      177      then do:
      178         return "?" .
      179      end.
      180      assign
      181         v-day-number = truncate(i-mjd-diff,0).
      182         o-Date = date(v-day-number + 2400002).
      183         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      184     .
      185   end.
      186   function cur-time-mjd-to-string returns character
      187   (input p-mjd-diff as decimal
      188   )
      189   :
      190     define variable v-day-number as integer   no-undo .
      191     define variable v-seconds    as integer   no-undo .
      192     define variable v-hour       as integer   no-undo .
      193     define variable v-min        as integer   no-undo .
      194     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      195     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      196     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      197     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      198     if p-mjd-diff < 0
      199     or p-mjd-diff = ?
      200     then do:
      201       return "?" .
      202     end.
      203     assign
      204       v-day-number = integer(truncate(p-mjd-diff,0))
      205       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      206     .
      207     if v-seconds > 86400
      208     then do:
      209       assign
      210         v-seconds = 86400 - 1
      211       .
      212     end.
      213     if v-seconds < 0
      214     then do:
      215       assign
      216         v-seconds = 0
      217       .
      218     end.
      219     assign
      220       v-hour = truncate(v-seconds / 3600, 0)
      221     .
      222     assign
      223       v-seconds = v-seconds modulo 3600
      224     .
      225     assign
      226       v-min = truncate(v-seconds / 60, 0)
      227     .
      228     assign
      229       v-seconds = v-seconds modulo 60
      230     .
      231     return
      232         (if v-day-number <> 0
      233           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      234           else ""
      235         )
      236       + (if v-day-number <> 0 or v-hour <> 0
      237           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      238           else ""
      239         )
      240       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      241           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      242           else ""
      243         )
      244       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      245       .
      246   end.
      247   function cur-time-string returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      256   end.
      257   function cur-time-string-sec returns character
      258   :
      259     define variable v-date as date      no-undo .
      260     define variable v-time as integer   no-undo .
      261     run cur-time in this-procedure
      262       (output v-date
      263       ,output v-time
      264       ) .
      265     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      266   end.
      267   function cur-time-custom  returns character
      268   (input p-prefix as character
      269   ,input p-date-format as character
      270   ,input p-delimiter as character
      271   ,input p-time-format as character
      272   ,input p-suffix as character
      273   )
      274   :
      275     define variable v-date as date      no-undo .
      276     define variable v-time as integer   no-undo .
      277     run cur-time in this-procedure
      278       (output v-date
      279       ,output v-time
      280       ) .
      281     return
      282       p-prefix
      283       + string(v-date, p-date-format)
      284       + p-delimiter
      285       + string(v-time, p-time-format)
      286       + p-suffix
      287       .
      288   end.
      289   function cur-time-print  returns character
      290   :
      291     define variable v-date as date      no-undo .
      292     define variable v-time as integer   no-undo .
      293     run cur-time in this-procedure
      294       (output v-date
      295       ,output v-time
      296       ) .
      297     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      298   end.
      299   function cur-time-datetime returns datetime
      300   :
      301     define variable v-char as character no-undo .
      302     define variable v-datetime as datetime no-undo .
      303     v-char = cur-time-string().
      304     v-datetime = datetime(v-char).
      305     return  v-datetime.
      306   end.
      307   function cur-time-string-msec returns character
      308   :
      309     define variable v-date as datetime  no-undo .
      310     v-date = now.
      311     return string(v-date) .
      312   end.
      313   DEFINE VARIABLE v-today as date no-undo .
      314   DEFINE VARIABLE v-time as integer no-undo .
      315   define variable v-host-code like ub.sysconf.host-code no-undo .
      316   define buffer buf_c-pl-gds-attr for ub.c-pl-gds-attr.
      317   define buffer buf_c-plc-hist for ub.c-plc-hist.
      318   define buffer buf_c-gds-hist for ub.c-gds-hist.
      319   define buffer buf_c-table-bind for ub.c-table-bind.
      320   main-block:
      321   do
      322   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      323   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      324   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      325   :
      326     if g#news <> yes then do:
      327       run cur-time in this-procedure(output v-today, output v-time).
      328       create buf_c-pl-gds-attr.
      329       buffer-copy oldb except
      330       pl-code
      331       obj-type
      332       obj-code
      333       attr-code
      334       gds-code
      335       to buf_c-pl-gds-attr
      336       .
      337       assign
      338       buf_c-pl-gds-attr.obj-type           = newb.obj-type
      339       buf_c-pl-gds-attr.obj-code           = newb.obj-code
      340       buf_c-pl-gds-attr.pl-code            = newb.pl-code
      341       buf_c-pl-gds-attr.attr-code          = newb.attr-code
      342       buf_c-pl-gds-attr.gds-code           = newb.gds-code
      343       buf_c-pl-gds-attr.chip-num           = next-value (s-plc-chip, ub)
      344       buf_c-pl-gds-attr.corr-time          = v-time
      345       buf_c-pl-gds-attr.corr-user-db-num   = g#db-num
      346       buf_c-pl-gds-attr.corr-user-name     = g#userid
      347       buf_c-pl-gds-attr.corr-date          = v-today
      348       .
      349       create buf_c-plc-hist.
      350       buffer-copy buf_c-pl-gds-attr to buf_c-plc-hist
      351       assign
      352       buf_c-plc-hist.action             = integer( if new( newb )
      353                                                 then '1':U
      354                                                 else '2':U)
      355       buf_c-plc-hist.subject = 'pl-gds-attr':U
      356       buf_c-plc-hist.is-news = g#news
      357       .
      358   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      359   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      360     (input  newb.obj-type
      361     ,input  newb.obj-code
      362     ,output v-host-code
      363     )  .
      364       create buf_c-gds-hist.
      365       buffer-copy buf_c-pl-gds-attr
      366       except chip-num
      367       to buf_c-gds-hist
      368       assign
      369       buf_c-gds-hist.action = (if new newb then integer('1':U) else integer('2':U))
      370       buf_c-gds-hist.subject = 'pl-gds-attr':U
      371       buf_c-gds-hist.host-code = v-host-code
      372       buf_c-gds-hist.is-news = g#news
      373       buf_c-gds-hist.chip-num =   next-value (s-gds-chip, ub)
      374       buf_c-gds-hist.source-type = (if g#news then 'db':U else "":U)
      375       buf_c-gds-hist.source-ref = (if g#news then string(g#news-source-db) else "":U)
      376       .
      377       create buf_c-table-bind.
      378       assign
      379       buf_c-table-bind.chip-num-rec   = buf_c-gds-hist.chip-num
      380       buf_c-table-bind.chip-num-src   = buf_c-pl-gds-attr.chip-num
      381       buf_c-table-bind.corr-user-db-num     = buf_c-pl-gds-attr.corr-user-db-num
      382       buf_c-table-bind.tbl-name-rec   = 'c-gds-hist':U
      383       buf_c-table-bind.tbl-name-src   = 'c-plc-hist':U
      384       buf_c-table-bind.is-news         = g#news
      385       buf_c-table-bind.corr-user-name  = g#userid
      386       buf_c-table-bind.subject         = 'pl-gds-attr':U
      387       .
      388     end.
      389   end.
