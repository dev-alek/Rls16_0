     1417     .
     1418   end.
     1419       if p-trn-doc-close = true
     1420       then do:
     1421         run trndocrs-need-rsrv in this-procedure
     1422           (input  buf_trn-doc.doc-type
     1423           ,input  buf_doc-line.artic
     1424           ,input  buf_doc-line.prod-type
     1425           ,input  buf_doc-line.prod-code
     1426           ,output l-need-rsrv
     1427           ) no-error .
     1428         if error-status :error
     1429         then do:
     1430           message
     1431             vss-workfile vss-revision vss-description skip
     1432             "Ошибка при вызове процедуры trndocrs-need-rsrv" skip
     1433             "Документ" buf_trn-doc.doc-type skip
     1434             "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     1435             error-status :get-message(1) skip
     1436             return-value skip
     1437             view-as alert-box error .
     1438           undo, return error return-value .
     1439         end.
     1440       end.
     1441       else do:
     1442         assign
     1443           l-need-rsrv = false
     1444         .
     1445       end.
     1446   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1447   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1448     (input  buf_doc-line.artic
     1449     ,input  buf_doc-line.prod-type
     1450     ,input  buf_doc-line.prod-code
     1451     ,input  'twounit=request':u
     1452     ,output l-goods-twounit
     1453     ) no-error .
     1454       if error-status :error
     1455       then do:
     1456         message
