     1888     ,input  buf_pl-gds.cli-free-qnty
     1889     ,input  v-old-pl-gds-fact-qnty
     1890     ,input  v-old-pl-gds-cli-qnty
     1891     ,input  v-old-pl-gds-free-qnty
     1892     ,input  v-old-pl-gds-cli-fact-qnty
     1893     ,input  v-old-pl-gds-cli-free-qnty
     1894     ,input  'trn-doc':U
     1895     ,input  buf_trn-doc.doc-code
     1896     ,input  buf_trn-doc.fact-date
     1897     ,input  buf_trn-doc.user-db-num
     1898     ,input  buf_trn-doc.user-name
     1899     ,input  buf_trn-doc.sys-date
     1900     ,input  buf_trn-doc.sys-time-int
     1901     ,input  buf_trn-doc.sys-time
     1902     ) no-error .
     1903             if error-status :error
     1904             then do:
     1905               message
     1906                 vss-workfile vss-revision vss-description skip
     1907                 "Ошибка при создании истории по товару на складском месте" skip
     1908                 error-status :get-message(1) skip
     1909                 return-value skip
     1910                 view-as alert-box error .
     1911               undo, return error return-value .
     1912             end.
     1913           end.
     1914         end.
     1915         define variable v-corr-date   as date      no-undo .
     1916         define variable v-corr-time   as integer   no-undo .
     1917         run cur-time in this-procedure
     1918           (output v-corr-date
     1919           ,output v-corr-time
     1920           ) .
     1921   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1922   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gohist in g#library
     1923     (input  buf_gds-obj.obj-type
     1924     ,input  buf_gds-obj.obj-code
     1925     ,input  buf_gds-obj.gds-code
     1926     ,input  p-action-type
     1927     ,input  buf_gds-obj.fact-qnty
     1928     ,input  buf_gds-obj.fact-cli-qnty
     1929     ,input  buf_gds-obj.fact-base
     1930     ,input  buf_gds-obj.fact-rubl
     1931     ,input  buf_gds-obj.fact-sale
     1932     ,input  v-old-fact-qnty
     1933     ,input  v-old-fact-cli-qnty
     1934     ,input  v-old-fact-base
     1935     ,input  v-old-fact-rubl
     1936     ,input  v-old-fact-sale
     1937     ,input  'trn-doc':U
     1938     ,input  buf_trn-doc.doc-code
     1939     ,input  buf_trn-doc.fact-date
     1940     ,input  buf_trn-doc.user-db-num
     1941     ,input  buf_trn-doc.user-name
     1942     ,input  buf_trn-doc.sys-date
     1943     ,input  buf_trn-doc.sys-time-int
     1944     ,input  buf_trn-doc.sys-time
     1945     ) no-error .
     1946         if error-status :error
     1947         then do:
     1948           message
     1949             vss-workfile vss-revision vss-description skip
     1950             "Ошибка при создании истории по товару на объекте" skip
     1951             error-status :get-message(1) skip
     1952             return-value skip
     1953             view-as alert-box error .
     1954           undo, return error return-value .
     1955         end.
     1956       end.
     1957       if buf_goods.gds-type = 'т':U
     1958       then do:
     1959         if buf_trn-doc.doc-type = 'при':U
     1960         and buf_doc-line.fact-qnty <> 0
     1961         then do:
     1962           if p-trn-doc-close = true
     1963           then do:
     1964             if buf_gds-obj.in-date = ?
     1965             or buf_gds-obj.in-date <= buf_trn-doc.fact-date
     1966             then do:
     1967               assign
     1968                 buf_gds-obj.last-base = buf_doc-line.price-base
     1969                 buf_gds-obj.last-rubl = buf_doc-line.price-rubl
     1970                 buf_gds-obj.in-code   = buf_trn-doc.doc-code
     1971                 buf_gds-obj.in-date   = buf_trn-doc.fact-date
     1972               .
     1973             end.
     1974           end.
     1975           else do:
     1976             define buffer income_buf_doc-line for ub.doc-line .
     1977             define buffer income_buf_trn-doc for ub.trn-doc .
     1978             for each income_buf_doc-line no-lock
     1979               where income_buf_doc-line.obj-type     = buf_doc-line.obj-type
     1980                 and income_buf_doc-line.obj-code     = buf_doc-line.obj-code
     1981                 and income_buf_doc-line.artic        = buf_doc-line.artic
     1982                 and income_buf_doc-line.prod-type    = buf_doc-line.prod-type
     1983                 and income_buf_doc-line.prod-code    = buf_doc-line.prod-code
     1984                 and income_buf_doc-line.status_      = 'факт':U
     1985                 and income_buf_doc-line.doc-code    <> buf_doc-line.doc-code
     1986             ,first income_buf_trn-doc no-lock
     1987                where income_buf_trn-doc.doc-code = income_buf_doc-line.doc-code
     1988                  and income_buf_trn-doc.doc-type = 'при':U
     1989             by income_buf_doc-line.fact-order descending
     1990             on error undo, return error return-value
     1991             :
     1992               assign
     1993                 buf_gds-obj.last-base = income_buf_doc-line.price-base
     1994                 buf_gds-obj.last-rubl = income_buf_doc-line.price-rubl
     1995                 buf_gds-obj.in-code   = income_buf_trn-doc.doc-code
     1996                 buf_gds-obj.in-date   = income_buf_trn-doc.fact-date
     1997               .
     1998               leave .
     1999             end.
     2000           end.
     2001         end.
     2002       end.
     2003     end.
     2004   end procedure.
     2005   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2006   procedure tdparts :
     2007     define input parameter  p-trn-doc-host-code   like ub.trn-doc.host-code   no-undo .
     2008     define input parameter  p-trn-doc-doc-type    like ub.trn-doc.doc-type    no-undo .
     2009     define input parameter  p-trn-doc-internal    like ub.trn-doc.internal    no-undo .
     2010     define input parameter  p-trn-doc-discnt-type like ub.trn-doc.discnt-type no-undo .
     2011     define input parameter  p-trn-doc-doc-code    like ub.trn-doc.doc-code    no-undo .
     2012     define input parameter  p-obj-type            like ub.doc-line.obj-type   no-undo .
     2013     define input parameter  p-obj-code            like ub.doc-line.obj-code   no-undo .
     2014     define input parameter  p-artic               like ub.doc-line.artic      no-undo .
     2015     define input parameter  p-prod-type           like ub.doc-line.prod-type  no-undo .
     2016     define input parameter  p-prod-code           like ub.doc-line.prod-code  no-undo .
     2017     define input parameter  p-need-rsrv           as logical no-undo .
     2018     define input parameter  p-place-rsrv          as logical no-undo .
     2019     define input parameter  p-goods-twounit       as logical no-undo .
     2020     define output parameter p-change-qnty         like ub.gds-obj.fact-qnty no-undo .
     2021     define output parameter p-change-base-total   like ub.gds-obj.avrg-base no-undo .
     2022     define output parameter p-change-rubl-total   like ub.gds-obj.avrg-rubl no-undo .
     2023     define output parameter p-total-qnty          like ub.gds-obj.fact-qnty no-undo .
     2024     define output parameter p-total-cli-qnty      like ub.gds-obj.fact-qnty no-undo .
     2025     define output parameter p-total-base-total    like ub.gds-obj.avrg-base no-undo .
     2026     define output parameter p-total-rubl-total    like ub.gds-obj.avrg-rubl no-undo .
     2027     define output parameter p-return-qnty         like ub.gds-obj.fact-qnty no-undo .
     2028     define output parameter p-return-base-total   like ub.gds-obj.avrg-base no-undo .
     2029     define output parameter p-return-rubl-total   like ub.gds-obj.avrg-rubl no-undo .
     2030     define output parameter p-expense-qnty        like ub.gds-obj.fact-qnty no-undo .
     2031     define output parameter p-expense-base-total  like ub.gds-obj.avrg-base no-undo .
     2032     define output parameter p-expense-rubl-total  like ub.gds-obj.avrg-rubl no-undo .
     2033     define output parameter p-total-rsrv-qnty     like ub.gds-obj.fact-qnty no-undo .
     2034     define variable vss-description as character no-undo initial "tdparts: Сбор информации по партиям".
     2035     define buffer archive_parts                 for ub.parts .
     2036     define buffer check_archive_parts           for ub.parts .
     2037     define buffer buf_goods                     for ub.goods .
     2038     define buffer buf_doc-pl                    for ub.doc-pl .
     2039     define buffer buf_temp-trndocrs-pl-gds-rsrv for temp-trndocrs-pl-gds-rsrv .
     2040     define variable v-change-price-base as decimal no-undo .
     2041     define variable v-change-price-rubl as decimal no-undo .
     2042     define variable v-change-qnty       as decimal no-undo .
     2043     define variable v-rsrv-qnty         as decimal no-undo .
     2044     define variable v-change-cli-qnty   as decimal no-undo .
     2045     define variable v-pl-change-qnty    as decimal no-undo .
     2046     define variable v-cli-change-qnty   as decimal no-undo .
     2047     define variable v-cli-rsrv-qnty     as decimal no-undo .
     2048     do
     2049     on error undo, return error return-value
     2050     :
     2051       assign
     2052         p-change-qnty        = 0
     2053         p-change-base-total  = 0
     2054         p-change-rubl-total  = 0
     2055         p-total-qnty         = 0
     2056         p-total-cli-qnty     = 0
     2057         p-total-base-total   = 0
     2058         p-total-rubl-total   = 0
     2059         p-return-qnty        = 0
     2060         p-return-base-total  = 0
     2061         p-return-rubl-total  = 0
     2062         p-expense-qnty       = 0
     2063         p-expense-base-total = 0
     2064         p-expense-rubl-total = 0
     2065         p-total-rsrv-qnty    = 0
     2066       .
     2067       define variable v-prihod  as logical no-undo .
     2068       define variable v-vozvrat as logical no-undo .
     2069       assign
     2070         v-prihod = false
     2071       .
     2072       if (p-trn-doc-doc-type = 'при':U
     2073             and( p-trn-doc-internal = no
     2074               or
     2075               (p-trn-doc-internal = yes
     2076                   and p-trn-doc-discnt-type = 'прво':U
     2077               )
     2078             )
     2079         )
     2080       then do:
     2081         assign
     2082           v-prihod = true
     2083         .
     2084       end.
     2085       for each archive_parts no-lock
     2086         where archive_parts.out-code  = p-trn-doc-doc-code
     2087           and archive_parts.obj-type  = p-obj-type
     2088           and archive_parts.obj-code  = p-obj-code
     2089           and archive_parts.artic     = p-artic
     2090           and archive_parts.prod-type = p-prod-type
     2091           and archive_parts.prod-code = p-prod-code
     2092       on error undo, return error return-value
     2093       :
     2094         assign
     2095           v-change-qnty = archive_parts.fact-qnty
     2096           v-rsrv-qnty   = archive_parts.qnty
     2097         .
     2098         if p-goods-twounit = true
     2099         then do:
     2100           if archive_parts.fact-qnty = 0
     2101           then do:
     2102             assign
     2103               v-change-cli-qnty = 0
     2104             .
     2105           end.
     2106           else do:
     2107             if archive_parts.fact-qnty = archive_parts.qnty
     2108             then do:
     2109               assign
     2110                 v-change-cli-qnty = archive_parts.cli-qnty
     2111               .
     2112             end.
     2113             else do:
     2114               message
     2115                 vss-workfile vss-revision vss-description skip
     2116                 "Фактическое количество не совпадает с количеством по документу" skip
     2117                 "Документ" archive_parts.out-code skip
     2118                 "Артикул" archive_parts.artic archive_parts.prod-type archive_parts.prod-code skip
     2119                 view-as alert-box error .
     2120               undo, return error return-value .
     2121             end.
     2122           end.
     2123         end.
     2124         else do:
     2125           assign
     2126             v-change-cli-qnty = archive_parts.fact-qnty / archive_parts.cli-base-rate
     2127           .
     2128         end.
     2129         if p-trn-doc-doc-type = 'рас':U
     2130         or p-trn-doc-doc-type = 'спи':U
     2131         then do:
     2132           assign
     2133             v-change-qnty     = - v-change-qnty
     2134             v-rsrv-qnty       = - v-rsrv-qnty
     2135             v-change-cli-qnty = - v-change-cli-qnty
     2136           .
     2137         end.
     2138         if p-place-rsrv = true then do:
     2139           run trndocrs-pl-gds-accum in this-procedure
     2140             (input archive_parts.pl-code
     2141             ,input (if p-need-rsrv = true then v-rsrv-qnty else 0.0)
     2142             ,input 0.0
     2143             ,input v-change-qnty
     2144             ,input 0.0
     2145             ) no-error .
     2146           if error-status :error then do:
     2147             message
     2148               vss-workfile vss-revision vss-description skip
     2149               "Ошибка при изменении зарезервированных количеств trndocrs-pl-gds-accum" skip
     2150               error-status :get-message(1) skip
     2151               return-value skip
     2152               view-as alert-box error .
     2153             undo, return error return-value .
     2154           end.
     2155         end.
     2156         assign
     2157           v-change-price-base = archive_parts.price-base * v-change-qnty
     2158           v-change-price-rubl = archive_parts.price-rubl * v-change-qnty
     2159         .
     2160         assign
     2161           p-total-qnty       = p-total-qnty       + v-change-qnty
     2162           p-total-cli-qnty   = p-total-cli-qnty   + v-change-cli-qnty
     2163           p-total-base-total = p-total-base-total + v-change-price-base
     2164           p-total-rubl-total = p-total-rubl-total + v-change-price-rubl
     2165           p-total-rsrv-qnty  = p-total-rsrv-qnty  + v-rsrv-qnty
     2166         .
     2167         if v-change-qnty > 0
     2168         then do:
     2169           assign
     2170             p-return-qnty        = p-return-qnty        + v-change-qnty
     2171             p-return-base-total  = p-return-base-total  + v-change-price-base
     2172             p-return-rubl-total  = p-return-rubl-total  + v-change-price-rubl
     2173           .
     2174         end.
     2175         else do:
     2176           assign
     2177             p-expense-qnty       = p-expense-qnty       + v-change-qnty
     2178             p-expense-base-total = p-expense-base-total + v-change-price-base
     2179             p-expense-rubl-total = p-expense-rubl-total + v-change-price-rubl
     2180           .
     2181         end.
     2182         assign
     2183           v-vozvrat = false
     2184         .
     2185         if p-trn-doc-doc-type = 'возврат':U
     2186         or (p-trn-doc-doc-type = 'инв':U
     2187             and archive_parts.fact-qnty > 0
     2188            )
     2189         then do:
     2190           assign
     2191             v-vozvrat = true
     2192           .
     2193         end.
     2194         if  v-prihod  <> true
     2195         and v-vozvrat <> true
     2196         and archive_parts.in-code = archive_parts.out-code
     2197         then do:
     2198           next.
     2199         end.
     2200         if v-vozvrat = true
     2201         then do:
     2202           find first check_archive_parts no-lock
     2203             where check_archive_parts.obj-type   = archive_parts.obj-type
     2204               and check_archive_parts.obj-code   = archive_parts.obj-code
     2205               and check_archive_parts.artic      = archive_parts.artic
     2206               and check_archive_parts.prod-type  = archive_parts.prod-type
     2207               and check_archive_parts.prod-code  = archive_parts.prod-code
     2208               and check_archive_parts.in-code    = archive_parts.in-code
     2209               and check_archive_parts.out-code   = 'free-zone':U
     2210               and check_archive_parts.part-code  = archive_parts.part-code
     2211             no-error .
     2212           if not available check_archive_parts
     2213           or check_archive_parts.fact-qnty <= 0
     2214           then do:
     2215             next.
     2216           end.
     2217         end.
     2218         assign
     2219           p-change-qnty       = p-change-qnty       + v-change-qnty
     2220           p-change-base-total = p-change-base-total + v-change-price-base
     2221           p-change-rubl-total = p-change-rubl-total + v-change-price-rubl
     2222         .
     2223       end.
     2224       if p-place-rsrv = true then do:
     2225         find first buf_goods no-lock
     2226           where buf_goods.artic     = p-artic
     2227             and buf_goods.prod-type = p-prod-type
     2228             and buf_goods.prod-code = p-prod-code
     2229           .
     2230         for each buf_doc-pl no-lock
     2231           where buf_doc-pl.obj-type = p-obj-type
     2232             and buf_doc-pl.obj-code = p-obj-code
     2233             and buf_doc-pl.out-code = p-trn-doc-doc-code
     2234             and buf_doc-pl.gds-code = buf_goods.gds-code
     2235         on error undo, return error return-value
     2236         :
     2237           assign
     2238             v-pl-change-qnty  = buf_doc-pl.fact-qnty
     2239             v-cli-change-qnty = buf_doc-pl.cli-fact-qnty
     2240             v-cli-rsrv-qnty   = (if p-need-rsrv = true then buf_doc-pl.cli-doc-qnty else 0.0)
     2241           .
     2242           if p-trn-doc-doc-type = 'рас':U
     2243           or p-trn-doc-doc-type = 'спи':U
     2244           then do:
     2245             assign
     2246               v-pl-change-qnty  = - v-pl-change-qnty
     2247               v-cli-change-qnty = - v-cli-change-qnty
     2248               v-cli-rsrv-qnty   = - v-cli-rsrv-qnty
     2249             .
     2250           end.
     2251           run trndocrs-pl-gds-accum in this-procedure
     2252             (input buf_doc-pl.pl-code
     2253             ,input 0.0
     2254             ,input v-cli-rsrv-qnty
     2255             ,input 0.0
     2256             ,input v-cli-change-qnty
     2257             ) no-error .
     2258           if error-status :error
     2259           then do:
     2260             message
     2261               vss-workfile vss-revision vss-description skip
     2262               "Ошибка при изменении зарезервированных количеств trndocrs-pl-gds-accum" skip
     2263               error-status :get-message(1) skip
     2264               return-value skip
     2265               view-as alert-box error .
     2266             undo, return error return-value .
     2267           end.
     2268           find first buf_temp-trndocrs-pl-gds-rsrv
     2269             where buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_doc-pl.pl-code
     2270             .
     2271           if v-pl-change-qnty <> buf_temp-trndocrs-pl-gds-rsrv.fact-qnty
     2272             and v-pl-change-qnty <> 0.00
     2273           then do:
     2274             message
     2275               vss-workfile vss-revision vss-description skip
     2276               "Количество по партиям не совпадает с количеством по складским местам." skip
     2277               substitute( "Документ: &1", p-trn-doc-doc-code ) skip
     2278               substitute( "Товар: &1", buf_goods.gds-code )  skip
     2279               substitute( "Место хранения: &1", buf_doc-pl.pl-code )  skip
     2280               substitute( "Количество по партиям: &1 (&2)",  buf_temp-trndocrs-pl-gds-rsrv.fact-qnty , buf_goods.unit-base ) skip
     2281               substitute( "Количество по местам хр.: &1 (&2)", buf_doc-pl.fact-qnty, buf_goods.unit-base ) skip
     2282               view-as alert-box error .
     2283             undo, return error .
     2284           end.
     2285         end.
     2286       end.
     2287     end.
     2288   end procedure.
     2289   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2290   procedure partrqst :
     2291     define input  parameter p-doc-code                   like ub.doc-line.doc-code  no-undo .
     2292     define input  parameter p-obj-type                   like ub.doc-line.obj-type  no-undo .
     2293     define input  parameter p-obj-code                   like ub.doc-line.obj-code  no-undo .
     2294     define input  parameter p-artic                      like ub.doc-line.artic     no-undo .
     2295     define input  parameter p-prod-type                  like ub.doc-line.prod-type no-undo .
     2296     define input  parameter p-prod-code                  like ub.doc-line.prod-code no-undo .
     2297     define output parameter p-total-parts-qnty           like ub.parts.qnty         no-undo .
     2298     define output parameter p-total-parts-fact-qnty      like ub.parts.fact-qnty    no-undo .
     2299     define output parameter p-total-parts-cli-qnty       like ub.parts.cli-qnty     no-undo .
     2300     define output parameter p-total-parts-fact-cli-qnty  like ub.parts.cli-qnty     no-undo .
     2301     define output parameter p-total-parts-price-cli      as decimal                 no-undo .
     2302     define output parameter p-total-parts-price-base     as decimal                 no-undo .
     2303     define output parameter p-total-parts-price-rubl     as decimal                 no-undo .
     2304     define output parameter p-total-parts-transport-base as decimal                 no-undo .
     2305     define output parameter p-total-parts-transport-rubl as decimal                 no-undo .
     2306     define output parameter p-total-parts-other-base     as decimal                 no-undo .
     2307     define output parameter p-total-parts-other-rubl     as decimal                 no-undo .
     2308     define variable vss-description as character no-undo init "partrqst: Суммарная информация по всем зарезервированным партиям строки документа".
     2309     do
     2310     on error undo, return error return-value
     2311     :
     2312       assign
     2313         p-total-parts-qnty           = 0
     2314         p-total-parts-fact-qnty      = 0
     2315         p-total-parts-cli-qnty       = 0
     2316         p-total-parts-fact-cli-qnty  = 0
     2317         p-total-parts-price-cli      = 0
     2318         p-total-parts-price-base     = 0
     2319         p-total-parts-price-rubl     = 0
     2320         p-total-parts-transport-base = 0
     2321         p-total-parts-transport-rubl = 0
     2322         p-total-parts-other-base     = 0
     2323         p-total-parts-other-rubl     = 0
     2324       .
     2325       define buffer buf_parts for ub.parts .
     2326       for each buf_parts no-lock
     2327         where buf_parts.out-code  = p-doc-code
     2328           and buf_parts.obj-type  = p-obj-type
     2329           and buf_parts.obj-code  = p-obj-code
     2330           and buf_parts.artic     = p-artic
     2331           and buf_parts.prod-type = p-prod-type
     2332           and buf_parts.prod-code = p-prod-code
     2333       on error undo, return error return-value
     2334       :
     2335         define variable v-parts-fact-multiplier as decimal   no-undo .
     2336         assign
     2337           v-parts-fact-multiplier = 1
     2338         .
     2339         if buf_parts.qnty <> 0 then do:
     2340           assign
     2341             v-parts-fact-multiplier = buf_parts.fact-qnty / buf_parts.qnty
     2342           .
     2343         end.
     2344         assign
     2345           p-total-parts-qnty            = p-total-parts-qnty       + buf_parts.qnty
     2346           p-total-parts-fact-qnty       = p-total-parts-fact-qnty  + buf_parts.fact-qnty
     2347           p-total-parts-cli-qnty        = p-total-parts-cli-qnty   + buf_parts.cli-qnty
     2348           p-total-parts-fact-cli-qnty   = p-total-parts-fact-cli-qnty
     2349                                         + buf_parts.cli-qnty * v-parts-fact-multiplier
     2350           p-total-parts-price-cli       = p-total-parts-price-cli  + buf_parts.cli-qnty  * buf_parts.price-cli
     2351           p-total-parts-price-base      = p-total-parts-price-base + buf_parts.fact-qnty * buf_parts.price-base
     2352           p-total-parts-price-rubl      = p-total-parts-price-rubl + buf_parts.fact-qnty * buf_parts.price-rubl
     2353           p-total-parts-transport-base  = p-total-parts-transport-base
     2354                                         + buf_parts.fact-qnty
     2355                                           * (if   buf_parts.transport-base <> ?
     2356                                             then buf_parts.transport-base
     2357                                             else 0
     2358                                             )
     2359           p-total-parts-transport-rubl  = p-total-parts-transport-rubl
     2360                                         + buf_parts.fact-qnty
     2361                                           * (if   buf_parts.transport-rubl <> ?
     2362                                             then buf_parts.transport-rubl
     2363                                             else 0
     2364                                             )
     2365           p-total-parts-other-base      = p-total-parts-other-base
     2366                                         + buf_parts.fact-qnty
     2367                                           * (if   buf_parts.other-base <> ?
     2368                                             then buf_parts.other-base
     2369                                             else 0
     2370                                             )
     2371           p-total-parts-other-rubl      = p-total-parts-other-rubl
     2372                                         + buf_parts.fact-qnty
     2373                                           * (if   buf_parts.other-rubl <> ?
     2374                                             then buf_parts.other-rubl
     2375                                             else 0
     2376                                             )
     2377         .
     2378       end.
     2379     end.
     2380   end procedure.
     2381   define new global shared variable g#lib-trn  as handle no-undo .
     2382   define new global shared variable g#lib-trn2 as handle no-undo .
     2383   define new global shared variable g#lib-trn3 as handle no-undo .
     2384   define new global shared variable g#lib-trn4 as handle no-undo .
     2385   function hvrdtax return logical (input parrecid as recid):
     2386   define variable varresult as logical no-undo.
     2387   run hvrdtax-proc (input parrecid, output varresult).
     2388   return varresult.
     2389   end function.
     2390   procedure hvrdtax-proc:
     2391   define input  parameter parrecid  as recid   no-undo.
     2392   define output parameter parresult as logical no-undo.
     2393   define buffer bf_goods for ub.goods.
     2394   define buffer bf_units for ub.units.
     2395   define buffer rt_tax   for ub.tax.
     2396   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
     2397   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
     2398   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
     2399   if available rt_tax and
     2400       can-find(first ub.tax-units No-LOCK WHERE
     2401                      ub.tax-units.tax-code = rt_tax.tax-code AND
     2402                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
     2403                                                       else assign parresult = no.
     2404   end procedure.
     2405   def var vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2406   procedure gen-key-rec :
     2407     define input  parameter p-tbl-name    as character no-undo.
     2408     define input  parameter p-bh_tbl-name as handle    no-undo.
     2409     define output parameter p-key-rec     as character no-undo.
     2410     do
     2411     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2412     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     2413     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     2414     :
     2415       define variable fh               as handle    no-undo .
     2416       define variable v-ok             as logical   no-undo .
     2417       define variable v-inform         as character no-undo .
     2418       define variable v-ind            as integer   no-undo .
     2419       define variable v-idx-field-qnty as integer   no-undo .
     2420       if p-tbl-name = ?
     2421         or p-tbl-name = "":U
     2422       then do:
     2423         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info18 ).
     2424       end.
     2425       if not p-bh_tbl-name:available then do:
     2426         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info18, p-tbl-name ).
     2427       end.
     2428       assign
     2429         p-key-rec = p-tbl-name
     2430         v-inform  = p-bh_tbl-name:index-information(1)
     2431         v-ind     = 2
     2432       .
     2433       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2434       on error undo, return error
     2435       :
     2436         assign
     2437           v-inform = p-bh_tbl-name:index-information( v-ind )
     2438           v-ind    = v-ind + 1
     2439         .
     2440       end.
     2441       if v-inform = ?
     2442         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2443         or entry( 3, v-inform, ",":U ) <> "1":U
     2444       then do:
     2445         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info18, p-tbl-name ).
     2446       end.
     2447       else do:
     2448         assign
     2449           v-idx-field-qnty = num-entries( v-inform ) - 4
     2450         .
     2451         if v-idx-field-qnty < 2 then do:
     2452           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info18, v-inform, p-tbl-name ).
     2453         end.
     2454         do v-ind = 1 to v-idx-field-qnty by 2
     2455         on error undo, return error
     2456         :
     2457           assign
     2458             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     2459             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     2460           .
     2461         end.
     2462       end.
     2463       if p-key-rec = ? then do:
     2464         assign
     2465           p-key-rec = "":U
     2466         .
     2467         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info18, p-tbl-name ).
     2468       end.
     2469     end.
     2470     return.
     2471   end procedure.
     2472   procedure gen-where-keyr-tab :
     2473     define input  parameter i-tableSerach as character no-undo.
     2474     define input  parameter i-tablekey   as character  no-undo.
     2475     define input  parameter p-key-rec    as character  no-undo.
     2476     define input  parameter p-key-handle as handle     no-undo .
     2477     define input  parameter p-db-name    as character  no-undo .
     2478     define input  parameter p-tt-handle  as handle     no-undo .
     2479     define output parameter o-Where      as character  no-undo.
     2480     do
     2481     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2482     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2483     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     2484     :
     2485       define variable v-full-tbl-name  as character no-undo .
     2486       define variable bh_tbl-name      as handle    no-undo .
     2487       define variable fh_key           as handle    no-undo .
     2488       define variable fh_search        as handle    no-undo .
     2489       define variable v-field-num      as integer   no-undo .
     2490       define variable v-count-fld      as integer   no-undo .
     2491       define variable v-inform         as character no-undo .
     2492       define variable v-ind            as integer   no-undo .
     2493       define variable v-idx-field-qnty as integer   no-undo .
     2494       define variable v-field-name     as character no-undo .
     2495       define variable v-field-val      as character no-undo .
     2496       define variable v-word-link      as character no-undo .
     2497       define variable vTable           as character no-undo.
     2498       define variable bh_tbl-key       as handle    no-undo .
     2499       assign
     2500         p-key-rec = trim( p-key-rec )
     2501       .
     2502       if p-key-handle <> ? then do:
     2503         if not valid-handle(p-key-handle)
     2504            or p-key-handle:type <> "buffer"
     2505         then do:
     2506           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info18 ).
     2507         end.
     2508         if num-entries( p-key-rec, chr(3) ) > 1
     2509           or p-key-rec = ?
     2510           or p-key-rec = "":U
     2511         then do:
     2512           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info18, p-key-rec ).
     2513         end.
     2514       end.
     2515       else do:
     2516         if p-key-rec = ?
     2517           or p-key-rec = "":U
     2518         then do:
     2519           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info18 ).
     2520         end.
     2521       end.
     2522       assign
     2523         vTable = entry( 1 , p-key-rec, chr(3) )
     2524       .
     2525       if p-tt-handle <> ?
     2526         and ( not valid-handle(p-tt-handle)
     2527               or p-tt-handle:type <> "buffer"
     2528             )
     2529       then do:
     2530         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info18, vTable, chr(10) ).
     2531       end.
     2532       if p-tt-handle = ? then do:
     2533         assign
     2534           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     2535         .
     2536         create buffer bh_tbl-name for table v-full-tbl-name .
     2537       end.
     2538       else do:
     2539         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2540       end.
     2541       assign
     2542         v-inform = bh_tbl-name:index-information(1)
     2543         v-ind    = 2
     2544       .
     2545       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2546       on error undo, return error
     2547       :
     2548         assign
     2549           v-inform = bh_tbl-name:index-information( v-ind )
     2550           v-ind    = v-ind + 1
     2551         .
     2552       end.
     2553       if v-inform = ?
     2554         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2555         or entry( 3, v-inform, ",":U ) <> "1":U
     2556       then do:
     2557         delete object bh_tbl-name no-error.
     2558         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info18, vTable ).
     2559       end.
     2560       assign
     2561         v-idx-field-qnty = num-entries( v-inform ) - 4
     2562       .
     2563       if v-idx-field-qnty < 2 then do:
     2564         delete object bh_tbl-name no-error.
     2565         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info18, v-inform, vTable ).
     2566       end.
     2567       assign
     2568         o-where     = "where":U
     2569         v-word-link = "":U
     2570         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     2571         v-count-fld = 0
     2572       .
     2573       if i-tablekey ne "" and i-tablekey ne ?
     2574       then do:
     2575         assign
     2576           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     2577         .
     2578         create buffer bh_tbl-key for table v-full-tbl-name .
     2579       end.
     2580       if i-tableSerach ne "" and i-tableSerach ne ?
     2581       then do:
     2582         delete object bh_tbl-name no-error.
     2583         assign
     2584           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     2585         .
     2586         create buffer bh_tbl-name for table v-full-tbl-name .
     2587       end.
     2588       block_where:
     2589       do v-ind = 1 to v-idx-field-qnty by 2
     2590       on error undo, return error
     2591       :
     2592         assign
     2593           v-count-fld = v-count-fld + 1
     2594         .
     2595         if p-key-handle = ?
     2596           and v-count-fld > v-field-num
     2597         then do:
     2598           leave block_where.
     2599         end.
     2600         define variable VfieldKeyTable as handle no-undo.
     2601         assign
     2602           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2603           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     2604         .
     2605         if     bh_tbl-key ne ?
     2606         then do:
     2607            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     2608            if VfieldKeyTable eq ?
     2609            then next block_where.
     2610         end.
     2611         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     2612         then
     2613            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     2614         else
     2615            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     2616         if p-key-handle = ? then do:
     2617           assign
     2618             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     2619           .
     2620         end.
     2621         else do:
     2622           assign
     2623             fh_key = p-key-handle:buffer-field( v-field-name )
     2624           .
     2625           if fh_key = ?
     2626             or not valid-handle( fh_key )
     2627           then do:
     2628             delete object bh_tbl-name.
     2629             if     bh_tbl-key ne ?
     2630             then
     2631                delete object bh_tbl-key.
     2632             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info18, p-key-handle:name, v-field-name ).
     2633           end.
     2634           assign
     2635             v-field-val = fh_key:buffer-value
     2636           .
     2637         end.
     2638         if fh_search:data-type ="character":U then do:
     2639           assign
     2640             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2641             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2642             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2643             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2644             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2645             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2646             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2647             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2648             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2649             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2650             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2651             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2652             v-field-val = substitute( '"&1"', v-field-val )
     2653           .
     2654         end.
     2655         assign
     2656           o-where = substitute( "&1 &2", o-where, v-field-val )
     2657         .
     2658         if v-word-link = "":U then do:
     2659           assign
     2660             v-word-link = "and":U
     2661           .
     2662         end.
     2663       end.
     2664       delete object bh_tbl-name.
     2665       if     bh_tbl-key ne ?
     2666       then
     2667          delete object bh_tbl-key.
     2668       if p-key-handle = ?
     2669         and v-count-fld <> v-field-num
     2670       then do:
     2671         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info18, vTable ).
     2672       end.
     2673     end.
     2674   end procedure.
     2675   procedure gen-hn-keyr-tab :
     2676     define input  parameter i-tableSerach as character no-undo.
     2677     define input  parameter i-tablekey   as character no-undo.
     2678     define input  parameter p-key-rec    as character no-undo.
     2679     define input  parameter p-key-handle as handle    no-undo .
     2680     define input  parameter p-db-name    as character no-undo .
     2681     define input  parameter p-tt-handle  as handle    no-undo .
     2682     define input  parameter p-stts-lock  as integer   no-undo .
     2683     define output parameter o-hn         as handle    no-undo.
     2684     define variable v-full-tbl-name as character no-undo.
     2685     define variable v-where         as character no-undo.
     2686     define variable bh_tbl-name     as handle    no-undo.
     2687     define variable vTable          as character no-undo.
     2688     do
     2689     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2690     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2691     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2692         run gen-where-keyr-tab(i-tableSerach,
     2693                                i-tablekey,
     2694                                p-key-rec,
     2695                                p-key-handle,
     2696                                p-db-name,
     2697                                p-tt-handle,
     2698                                output v-where).
     2699         if i-tableSerach ne "" and i-tableSerach ne ?
     2700         then do:
     2701            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2702            create buffer bh_tbl-name for table v-full-tbl-name .
     2703         end.
     2704         else do:
     2705            if p-tt-handle = ? then do:
     2706               assign
     2707                  vTable = entry( 1 , p-key-rec, chr(3) )
     2708               .
     2709               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2710               create buffer bh_tbl-name for table v-full-tbl-name .
     2711            end.
     2712            else do:
     2713               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2714            end.
     2715         end.
     2716         if p-tt-handle = ? then do:
     2717            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2718         end.
     2719         else do:
     2720            bh_tbl-name:find-first( v-where ) no-error .
     2721         end.
     2722         o-hn = bh_tbl-name.
     2723      end.
     2724   end procedure.
     2725   procedure gen-hn-keyr :
     2726     define input  parameter p-key-rec    as character no-undo.
     2727     define input  parameter p-key-handle as handle    no-undo .
     2728     define input  parameter p-db-name    as character no-undo .
     2729     define input  parameter p-tt-handle  as handle    no-undo .
     2730     define input  parameter p-stts-lock  as integer   no-undo .
     2731     define output parameter o-hn         as handle    no-undo.
     2732     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2733   end.
     2734   procedure gen-row-keyr :
     2735     define input  parameter p-key-rec    as character no-undo.
     2736     define input  parameter p-key-handle as handle    no-undo .
     2737     define input  parameter p-db-name    as character no-undo .
     2738     define input  parameter p-tt-handle  as handle    no-undo .
     2739     define input  parameter p-stts-lock  as integer   no-undo .
     2740     define output parameter p-tbl-row    as rowid     no-undo.
     2741     define output parameter p-tbl-name   as character no-undo.
     2742     define variable vHn as handle no-undo.
     2743       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2744       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2745       p-tbl-name =  vHn:table.
     2746       delete object vHn no-error.
     2747     if p-tbl-row = ? then do:
     2748       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info18, p-tbl-name, p-key-rec ).
     2749     end.
     2750     else do:
     2751       return.
     2752     end.
     2753   end procedure.
     2754   procedure gen-key-fv :
     2755     define input  parameter p-key-rec    as character no-undo .
     2756     define output parameter p-field-list as character no-undo .
     2757     define output parameter p-value-list as character no-undo.
     2758     do
     2759     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2760     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2761     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2762     :
     2763       define variable v-full-tbl-name  as character no-undo .
     2764       define variable bh_tbl-name      as handle    no-undo .
     2765       define variable v-tbl-name       as character no-undo .
     2766       define variable v-field-num      as integer   no-undo .
     2767       define variable v-count-fld      as integer   no-undo .
     2768       define variable v-inform         as character no-undo .
     2769       define variable v-ind            as integer   no-undo .
     2770       define variable v-idx-field-qnty as integer   no-undo .
     2771       define variable v-delim-key      as character no-undo .
     2772       if p-key-rec = ?
     2773         or p-key-rec = "":U
     2774       then do:
     2775         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info18 ).
     2776       end.
     2777       assign
     2778         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2779         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2780       .
     2781       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2782       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info18 ).
     2783       assign
     2784         v-inform = bh_tbl-name:index-information(1)
     2785         v-ind    = 2
     2786       .
     2787       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2788       on error undo, return error
     2789       :
     2790         assign
     2791           v-inform = bh_tbl-name:index-information( v-ind )
     2792           v-ind    = v-ind + 1
     2793         .
     2794       end.
     2795       if v-inform = ?
     2796         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2797         or entry( 3, v-inform, ",":U ) <> "1":U
     2798       then do:
     2799         delete object bh_tbl-name no-error.
     2800         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info18, v-tbl-name ).
     2801       end.
     2802       assign
     2803         v-idx-field-qnty = num-entries( v-inform ) - 4
     2804       .
     2805       if v-idx-field-qnty < 2 then do:
     2806         delete object bh_tbl-name no-error.
     2807         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info18, v-inform, v-tbl-name ).
     2808       end.
     2809       assign
     2810         p-field-list = "":U
     2811         p-value-list = "":U
     2812         v-delim-key  = "":U
     2813         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2814         v-count-fld  = 0
     2815       .
     2816       block_where:
     2817       do v-ind = 1 to v-idx-field-qnty by 2
     2818       on error undo, return error
     2819       :
     2820         assign
     2821           v-count-fld = v-count-fld + 1
     2822         .
     2823         if v-count-fld > v-field-num then do:
     2824           leave block_where.
     2825         end.
     2826         assign
     2827           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2828           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2829         .
     2830         if v-ind = 1 then do:
     2831           assign
     2832             v-delim-key = chr(3)
     2833           .
     2834         end.
     2835       end.
     2836       delete object bh_tbl-name.
     2837       if v-count-fld <> v-field-num then do:
     2838         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info18, v-tbl-name ).
     2839       end.
     2840     end.
     2841   end procedure.
     2842   procedure gen-key-field :
     2843     define input  parameter p-table      as character no-undo .
     2844     define output parameter p-field-list as character no-undo .
     2845     do
     2846     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2847     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2848     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2849     :
     2850       define variable v-full-tbl-name  as character no-undo .
     2851       define variable bh_tbl-name      as handle    no-undo .
     2852       define variable v-tbl-name       as character no-undo .
     2853       define variable v-field-num      as integer   no-undo .
     2854       define variable v-count-fld      as integer   no-undo .
     2855       define variable v-inform         as character no-undo .
     2856       define variable v-ind            as integer   no-undo .
     2857       define variable v-idx-field-qnty as integer   no-undo .
     2858       define variable v-delim-key      as character no-undo .
     2859       if p-table = ?
     2860         or p-table = "":U
     2861       then do:
     2862         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info18 ).
     2863       end.
     2864       assign
     2865         v-tbl-name      = p-table
     2866         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2867       .
     2868       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2869       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info18 ).
     2870       assign
     2871         v-inform = bh_tbl-name:index-information(1)
     2872         v-ind    = 2
     2873       .
     2874       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2875       on error undo, return error
     2876       :
     2877         assign
     2878           v-inform = bh_tbl-name:index-information( v-ind )
     2879           v-ind    = v-ind + 1
     2880         .
     2881       end.
     2882       if v-inform = ?
     2883         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2884         or entry( 3, v-inform, ",":U ) <> "1":U
     2885       then do:
     2886         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info18, v-tbl-name ).
     2887       end.
     2888       assign
     2889         v-idx-field-qnty = num-entries( v-inform ) - 4
     2890       .
     2891       if v-idx-field-qnty < 2 then do:
     2892         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info18, v-inform, v-tbl-name ).
     2893       end.
     2894       assign
     2895         p-field-list = "":U
     2896         v-delim-key  = "":U
     2897         v-count-fld  = 0
     2898       .
     2899       block_where:
     2900       do v-ind = 1 to v-idx-field-qnty by 2
     2901       on error undo, return error
     2902       :
     2903         assign
     2904           v-count-fld = v-count-fld + 1
     2905         .
     2906         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2907         if v-ind = 1 then do:
     2908           assign
     2909             v-delim-key = chr(3)
     2910           .
     2911         end.
     2912       end.
     2913       delete object bh_tbl-name.
     2914     end.
     2915   end procedure.
     2916   def var vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2917   define variable vss-include-info20 as character format "X(65)" no-undo
     2918   initial "@(#)$Workfile$ $Revision$".
     2919   procedure xmlchar-test :
     2920   define input parameter p-in-string          as character        no-undo.
     2921   define output parameter p-out-string-enc    as character        no-undo.
     2922   define output parameter p-out-string-dec    as character        no-undo.
     2923   do
     2924   on error undo, return error
     2925   :
     2926          run xmlchar-encode in this-procedure
     2927       (
     2928             input p-in-string
     2929           , output p-out-string-enc
     2930       ).
     2931          run xmlchar-decode in this-procedure
     2932       (
     2933             input p-out-string-enc
     2934           , output p-out-string-dec
     2935       ).
     2936   end.
     2937   end .
     2938   procedure xmlchar-encode :
     2939   define input parameter p-in-string      as character        no-undo.
     2940   define output parameter p-out-string    as character        no-undo.
     2941       define variable v-position      as integer      no-undo.
     2942       define variable v-current-char  as character    no-undo.
     2943   do
     2944   on error undo, return error
     2945   :
     2946       assign
     2947           p-out-string = "":U
     2948       .
     2949       case p-in-string
     2950       :
     2951           when ?
     2952           then do:
     2953               assign
     2954                   p-out-string = "?":U
     2955               .
     2956           end.
     2957           when "?":U
     2958           then do:
     2959               assign
     2960                   p-out-string = "&#63;":U
     2961               .
     2962           end.
     2963           otherwise do:
     2964               do v-position = 1 to length( p-in-string )
     2965               :
     2966                   assign
     2967                       v-current-char = substring( p-in-string, v-position, 1 )
     2968                   .
     2969                   case v-current-char
     2970                   :
     2971                       when "&":U
     2972                       then do:
     2973                           assign
     2974                               p-out-string = p-out-string + "&amp;":U
     2975                           .
     2976                       end.
     2977                       when ">":U
     2978                       then do:
     2979                           assign
     2980                               p-out-string = p-out-string + "&gt;":U
     2981                           .
     2982                       end.
     2983                       when "<":U
     2984                       then do:
     2985                           assign
     2986                               p-out-string = p-out-string + "&lt;":U
     2987                           .
     2988                       end.
     2989                       when "'":U
     2990                       then do:
     2991                           assign
     2992                               p-out-string = p-out-string + "&apos;":U
     2993                           .
     2994                       end.
     2995                       when '"':U
     2996                       then do:
     2997                           assign
     2998                               p-out-string = p-out-string + "&quot;":U
     2999                           .
     3000                       end.
     3001                       when chr(1)
     3002                       then do:
     3003                           assign
     3004                               p-out-string = p-out-string + "":U
     3005                           .
     3006                       end.
     3007                       when chr(2)
     3008                       then do:
     3009                           assign
     3010                               p-out-string = p-out-string + "":U
     3011                           .
     3012                       end.
     3013                       when chr(3)
     3014                       then do:
     3015                           assign
     3016                               p-out-string = p-out-string + "":U
     3017                           .
     3018                       end.
     3019                       when chr(4)
     3020                       then do:
     3021                           assign
     3022                               p-out-string = p-out-string + "":U
     3023                           .
     3024                       end.
     3025                       when chr(5)
     3026                       then do:
     3027                           assign
     3028                               p-out-string = p-out-string + "":U
     3029                           .
     3030                       end.
     3031                       when chr(6)
     3032                       then do:
     3033                           assign
     3034                               p-out-string = p-out-string + "":U
     3035                           .
     3036                       end.
     3037                       when chr(7)
     3038                       then do:
     3039                           assign
     3040                               p-out-string = p-out-string + "":U
     3041                           .
     3042                       end.
     3043                       when chr(8)
     3044                       then do:
     3045                           assign
     3046                               p-out-string = p-out-string + "":U
     3047                           .
     3048                       end.
     3049                       when chr(9)
     3050                       then do:
     3051                           assign
     3052                               p-out-string = p-out-string + "":U
     3053                           .
     3054                       end.
     3055                       when chr(29)
     3056                       then do:
     3057                           assign
     3058                               p-out-string = p-out-string + "":U
     3059                           .
     3060                       end.
     3061                       when chr(10)
     3062                       then do:
     3063                           assign
     3064                               p-out-string = p-out-string + "&#10;":U
     3065                           .
     3066                       end.
     3067                       when chr(13)
     3068                       then do:
     3069                           assign
     3070                               p-out-string = p-out-string + "&#13;":U
     3071                           .
     3072                       end.
     3073                       otherwise do:
     3074                           assign
     3075                               p-out-string = p-out-string + v-current-char
     3076                           .
     3077                       end.
     3078                   end case.
     3079               end.
     3080           end.
     3081       end case.
     3082   end.
     3083   end .
     3084   procedure xmlchar-encode-1c :
     3085   define input parameter p-in-string      as character        no-undo.
     3086   define output parameter p-out-string    as character        no-undo.
     3087       define variable v-position      as integer      no-undo.
     3088       define variable v-current-char  as character    no-undo.
     3089   do
     3090   on error undo, return error
     3091   :
     3092       assign
     3093           p-out-string = "":U
     3094       .
     3095       case p-in-string
     3096       :
     3097           when ?
     3098           then do:
     3099               assign
     3100                   p-out-string = "?":U
     3101               .
     3102           end.
     3103           otherwise do:
     3104               do v-position = 1 to length( p-in-string )
     3105               :
     3106                   assign
     3107                       v-current-char = substring( p-in-string, v-position, 1 )
     3108                   .
     3109                   case v-current-char
     3110                   :
     3111                       when chr(1)
     3112                       then do:
     3113                           assign
     3114                               p-out-string = p-out-string + " ":U
     3115                           .
     3116                       end.
     3117                       when chr(2)
     3118                       then do:
     3119                           assign
     3120                               p-out-string = p-out-string + " ":U
     3121                           .
     3122                       end.
     3123                       when chr(3)
     3124                       then do:
     3125                           assign
     3126                               p-out-string = p-out-string + " ":U
     3127                           .
     3128                       end.
     3129                       when chr(4)
     3130                       then do:
     3131                           assign
     3132                               p-out-string = p-out-string + " ":U
     3133                           .
     3134                       end.
     3135                       when chr(5)
     3136                       then do:
     3137                           assign
     3138                               p-out-string = p-out-string + " ":U
     3139                           .
     3140                       end.
     3141                       when chr(6)
     3142                       then do:
     3143                           assign
     3144                               p-out-string = p-out-string + " ":U
     3145                           .
     3146                       end.
     3147                       when chr(7)
     3148                       then do:
     3149                           assign
     3150                               p-out-string = p-out-string + " ":U
     3151                           .
     3152                       end.
     3153                       when chr(8)
     3154                       then do:
     3155                           assign
     3156                               p-out-string = p-out-string + " ":U
     3157                           .
     3158                       end.
     3159                       when chr(9)
     3160                       then do:
     3161                           assign
     3162                               p-out-string = p-out-string + " ":U
     3163                           .
     3164                       end.
     3165                       when chr(29)
     3166                       then do:
     3167                           assign
     3168                               p-out-string = p-out-string + " ":U
     3169                           .
     3170                       end.
     3171                       when chr(10)
     3172                       then do:
     3173                           assign
     3174                               p-out-string = p-out-string + " ":U
     3175                           .
     3176                       end.
     3177                       when chr(13)
     3178                       then do:
     3179                           assign
     3180                               p-out-string = p-out-string + " ":U
     3181                           .
     3182                       end.
     3183                       otherwise do:
     3184                           assign
     3185                               p-out-string = p-out-string + v-current-char
     3186                           .
     3187                       end.
     3188                   end case.
     3189               end.
     3190           end.
     3191       end case.
     3192   end.
     3193   end .
     3194   procedure xmlchar-decode :
     3195   define input parameter p-in-string      as character        no-undo.
     3196   define output parameter p-out-string    as character        no-undo.
     3197       define variable v-position      as integer      no-undo.
     3198       define variable v-last-position as integer      no-undo.
     3199       define variable v-temp-integer  as integer      no-undo.
     3200       define variable v-current-char  as character    no-undo.
     3201       define variable v-next-char     as character    no-undo.
     3202       define variable v-success       as logical      no-undo.
     3203   do
     3204   on error undo, return error
     3205   :
     3206       assign
     3207           p-out-string = "":U
     3208           v-position   = 0
     3209       .
     3210       replace-cycle:
     3211       do while yes
     3212       on error undo, return error
     3213       :
     3214           assign
     3215               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     3216           .
     3217           if v-last-position <= v-position
     3218           then do:
     3219               if v-position = 0
     3220               then do:
     3221                   assign
     3222                       p-out-string = p-in-string
     3223                   .
     3224               end.
     3225               else do:
     3226                   assign
     3227                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     3228                   .
     3229               end.
     3230               leave replace-cycle.
     3231           end.
     3232           else do:
     3233               assign
     3234                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     3235                   v-position      = v-last-position
     3236                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     3237               .
     3238               if v-current-char = "#":U
     3239               then do:
     3240                   assign
     3241                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     3242                   .
     3243                   if v-last-position > 0
     3244                   then do:
     3245                       run xmlchar-read-integer in this-procedure
     3246                        (
     3247                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     3248                           , output v-temp-integer
     3249                           , output v-success
     3250                       ).
     3251                       if v-success = yes
     3252                       and v-temp-integer >= 1
     3253                       and v-temp-integer <= 255
     3254                       then do:
     3255                           assign
     3256                               p-out-string = p-out-string + chr( v-temp-integer )
     3257                               v-position   = v-last-position + 1
     3258                           .
     3259                       end.
     3260                       else do:
     3261                           assign
     3262                               p-out-string = p-out-string + "&":U
     3263                               v-position   = v-position   + 1
     3264                           .
     3265                       end.
     3266                   end.
     3267                   else do:
     3268                       assign
     3269                           p-out-string = p-out-string + "&":U
     3270                           v-position   = v-position   + 1
     3271                       .
     3272                   end.
     3273               end.
     3274               else do:
     3275                   case substring( p-in-string, v-position + 1, 3 )
     3276                   :
     3277                       when "lt;":U
     3278                       then do:
     3279                           assign
     3280                               p-out-string = p-out-string + "<":U
     3281                               v-position   = v-position   + 3
     3282                           .
     3283                       end.
     3284                       when "gt;":U
     3285                       then do:
     3286                           assign
     3287                               p-out-string = p-out-string + ">":U
     3288                               v-position   = v-position   + 3
     3289                           .
     3290                       end.
     3291                       otherwise do:
     3292                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     3293                           then do:
     3294                               assign
     3295                                   p-out-string = p-out-string + "&":U
     3296                                   v-position   = v-position   + 4
     3297                               .
     3298                           end.
     3299                           else do:
     3300                               case substring( p-in-string, v-position + 1, 5 )
     3301                               :
     3302                                   when "quot;":U
     3303                                   then do:
     3304                                       assign
     3305                                           p-out-string = p-out-string + '"':U
     3306                                           v-position   = v-position   + 5
     3307                                       .
     3308                                   end.
     3309                                   when "apos;":U
     3310                                   then do:
     3311                                       assign
     3312                                           p-out-string = p-out-string + "'":U
     3313                                           v-position   = v-position   + 5
     3314                                       .
     3315                                   end.
     3316                                   otherwise do:
     3317                                       assign
     3318                                           p-out-string = p-out-string + "&":U
     3319                                       .
     3320                                   end.
     3321                               end case.
     3322                           end.
     3323                       end.
     3324                   end case.
     3325               end.
     3326           end.
     3327       end.
     3328   end.
     3329   end .
     3330   procedure xmlchar-read-integer :
     3331   define input parameter p-input-string      as character        no-undo.
     3332   define output parameter p-output-integer   as integer          no-undo.
     3333   define output parameter p-success       as logical          no-undo.
     3334   do
     3335   on error undo, return error
     3336   :
     3337       assign
     3338           p-output-integer = integer( p-input-string )
     3339       no-error.
     3340       if error-status :error
     3341       then do:
     3342           assign
     3343               p-success           = no
     3344               p-output-integer    = 0
     3345           .
     3346       end.
     3347       else do:
     3348           assign
     3349               p-success           = yes
     3350           .
     3351       end.
     3352   end.
     3353   end.
     3354   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     3355   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     3356   define new global shared variable g#attr-lib  as handle no-undo .
     3357   define variable v-attr-lib-variable as handle no-undo .
     3358   define variable mMRCCode  as logical    no-undo.
     3359   define variable mTypeMark as character  no-undo.
     3360   function IS-NeedMark returns logical
     3361   ( input ib-code as integer  ,
     3362     input ib-str as character ):
     3363      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     3364      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     3365                                    and buf_prod-bc-attr.b-str  eq ib-str
     3366                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     3367        no-lock no-error.
     3368      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     3369   end.
     3370   function repTegforDm return char
     3371   (iDM as char ):
     3372       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     3373       define variable vteg as character no-undo.
     3374       define variable oDM as character no-undo.
     3375       define variable vi as integer no-undo.
     3376       oDM = iDm.
     3377       do vi = 1 to num-entries(vTeglist):
     3378          vTeg = entry(vi,vTeglist).
     3379          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     3380       end.
     3381       return oDM.
     3382   end.
     3383   function repSpecSimbforDm return char
     3384   (iDM as char ):
     3385       define variable oDM as character no-undo.
     3386     run
     3387       xmlchar-decode(iDM, output oDM).
     3388     return repTegforDm (oDM).
     3389   end.
     3390   function CheckGtin return logical
     3391   (iGtin as char):
     3392      define variable bar_code as character no-undo.
     3393      define variable vGtin as logical no-undo init "yes".
     3394      if length(iGtin) eq 14
     3395      then do:
     3396         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     3397         run str/chk-sum.p
     3398          (input-output bar_code ) no-error .
     3399         if iGtin ne  bar_code
     3400         then
     3401            vGtin = no.
     3402      end.
     3403      else
     3404         vGtin = no.
     3405      return vgtin.
     3406   end.
     3407   function repSpecSimbforXlm return char
     3408   (iDM as char ):
     3409       iDM = replace(iDM,chr(29),"").
     3410       return iDM.
     3411   end.
     3412   function getGtinByDM return char
     3413   (IDM as char):
     3414      define variable VTXT as char no-undo.
     3415      define variable vGtin as char no-undo.
     3416      vTXt = IdM.
     3417      vGtin = IDM.
     3418      if    length(vtxt) > 14
     3419      then do:
     3420         if   vtxt begins "(01)"
     3421                or vtxt begins "(02)"
     3422         then
     3423            vGtin = substring(vtxt,5,14).
     3424         else if   (vtxt begins "01"
     3425                or vtxt begins "02" )
     3426                and (   (    substring(iDm,17,2) eq "21"
     3427                         and length(vtxt) >= 21)
     3428                     or substring(iDm,17,2) eq "37"
     3429                     or substring(iDm,17,4) eq "(37)" )
     3430         then do:
     3431            vGtin = substring(vtxt,3,14).
     3432            if not checkGtin(vGtin)
     3433            then
     3434               vGtin = substring(vtxt,1,14).
     3435         end.
     3436         else if     length(vtxt) eq 14 + 7 + 4 + 4
     3437             or length(vtxt) eq 14 + 7 + 4
     3438             or length(vtxt) eq 14 + 7
     3439         then
     3440            vGtin = substring(vtxt,1,14).
     3441      end.
     3442      if not checkGtin(vGtin)
     3443      then
     3444         vGtin = "".
     3445      return vgtin.
     3446   end.
     3447   function getGdsCodeByGtin return int
     3448   (iGtin as char):
     3449      define buffer prod-bc  for ub.prod-bc.
     3450      define buffer bar-code for ub.bar-code.
     3451      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     3452      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     3453      return if avail bar-code then bar-code.gds-code else ?.
     3454   end.
     3455   function getQntyCodeByGtin return decimal
     3456   (iGtin as char):
     3457      define buffer prod-bc  for ub.prod-bc.
     3458      define buffer bar-code for ub.bar-code.
     3459      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     3460      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     3461      return if avail bar-code then bar-code.cli-base-rate else ?.
     3462   end.
     3463   function getGdsCodeByDM return int
     3464   (iDm as char):
     3465      define variable vGtin as char no-undo.
     3466      define buffer prod-bc for ub.prod-bc.
     3467      vGtin  = getGtinByDM (IDM ).
     3468      return getGdsCodeByGtin (vGtin).
     3469   end.
     3470   function ChekTypeMarkByGds return logical
     3471   (iGds-code as integer ):
     3472      define buffer goods-attr for ub.goods-attr.
     3473      find first goods-attr where goods-attr.gds-code   = iGds-code
     3474                              and goods-attr.attr-code  = 'mark-type':U
     3475      no-lock no-error.
     3476      if available goods-attr
     3477      then do:
     3478         mTypeMark = goods-attr.attr-value.
     3479         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     3480           .
     3481      end.
     3482      else
     3483         return no.
     3484   end.
     3485   function ChekTypeMarkByDm return logical
     3486   (iDM as char ):
     3487      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     3488   end.
     3489   function ChekTypeMarkByGtin return logical
     3490   (iGtin as char ):
     3491      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     3492   end.
     3493   function GetNextElement return character
     3494     (input iAllTeg        as logical
     3495     ,output oteg          as character
     3496     ,output otegval       as character
     3497     ,input-output pstr    as character
     3498      ):
     3499        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     3500        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     3501        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     3502        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     3503        define variable vTeg as character no-undo.
     3504        define variable vLength as integer no-undo.
     3505        define variable vi as integer no-undo.
     3506        define variable vj as integer no-undo.
     3507        define buffer code for ub.code.
     3508        find first code where Code.parent eq "MarkType"
     3509                          and Code.CodeValue   eq mTypeMark
     3510                          no-lock no-error.
     3511        if     available code
     3512           and Code.misc1 ne ""
     3513           and Code.misc1 ne ?
     3514        then do:
     3515           integer (Code.misc1) no-error.
     3516           if not error-status:error
     3517           then
     3518             entry (4,vlistleng) = Code.misc1.
     3519        end.
     3520        if iAllTeg
     3521        then
     3522           assign
     3523              vlistElem     = vlistElem    + vlistElemDop
     3524              vlistleng     = vlistleng    + vlistlengDop
     3525           .
     3526        else if mMRCCode
     3527        then
     3528           assign
     3529              vlistElem     = vlistElem    + ",(8005),8005"
     3530              vlistleng     = vlistleng    + ",000006,0006"
     3531           .
     3532       block-elem:
     3533       do vi = 1 to num-entries(vlistElem):
     3534          vTeg = entry(vi,vlistElem).
     3535          if pstr begins vTeg
     3536          then do:
     3537             if    vTeg eq "21"
     3538             then
     3539                vLength = index(pstr,chr(29)) - 2 no-error.
     3540             if vLength  <= 0
     3541             then
     3542                vLength = int(entry(vi,vlistleng)).
     3543             otegval = substring (pstr,length(vteg) + 1, vLength).
     3544             oteg = replace(replace(vteg,")",""),"(","").
     3545             vTeg = vteg + otegval.
     3546             otegval = replace(otegval,chr(29),"").
     3547             oteg = replace(replace(oteg,")",""),"(","").
     3548             pstr = substring (pstr,length(vTeg)+ 1).
     3549             vTeg = replace(vTeg,chr(29),"").
     3550             leave block-elem.
     3551          end.
     3552          else
     3553             vTeg = "".
     3554       end.
     3555       return vteg.
     3556   end.
     3557   function GetCodeIdent return character
     3558   (iDm as char):
     3559      define variable Velement   as character no-undo init "first".
     3560      define variable oCodeIdent as character no-undo.
     3561      define variable vteg as character no-undo.
     3562      define variable vtegval as character no-undo.
     3563      define variable vGtin as character no-undo.
     3564      define buffer marking for ub.marking.
     3565      for first marking no-lock where
     3566                marking.mark eq iDm
     3567            and marking.unit-ext = "LEVEL2"
     3568      :
     3569        return iDm.
     3570      end.
     3571      vGtin  = getGtinByDM (iDm ).
     3572      ChekTypeMarkByDm(idm).
     3573      if iDm begins 'tech_':U
     3574      then
     3575         oCodeIdent = iDm.
     3576      else if length(iDm) < 21
     3577      then do:
     3578         find first marking where marking.mark eq idm
     3579         no-lock no-error.
     3580         oCodeIdent = if available marking then marking.mark else  ?.
     3581      end.
     3582      else if     length(iDm) eq 29
     3583         and not iDm begins "01"
     3584         and not iDm begins "02"
     3585      then
     3586         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     3587      else  if     length(iDm) >= 24
     3588               and (  iDm begins "01"
     3589                   or iDm begins "02")
     3590               and  substring(iDm,17,2) ne "21"
     3591      then do:
     3592         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     3593                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     3594         then
     3595            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     3596         else
     3597            oCodeIdent = iDM.
     3598      end.
     3599      else  if     (   length(iDm) eq 25
     3600                    or length(iDm) eq 21)
     3601               and (not iDm begins "01"
     3602               and  not iDm begins "02")
     3603      then
     3604         oCodeIdent = substring(iDm,1,21).
     3605      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     3606      then
     3607         oCodeIdent = substring(iDm,1,21).
     3608      else do while Velement ne "" and idm ne "":
     3609         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     3610         oCodeIdent = oCodeIdent + Velement.
     3611      end.
     3612      return oCodeIdent.
     3613   end.
     3614   function GetTegCod return character
     3615   (icodeIdent as char, iTeg as char):
     3616      define variable Velement   as character no-undo init "first".
     3617      define variable oTeg as character no-undo init ?.
     3618      define variable vteg as character no-undo.
     3619      define variable vtegval as character no-undo.
     3620      if     ((length(icodeIdent) eq 21
     3621         and not icodeIdent begins "01"
     3622         and not icodeIdent begins "02")
     3623         or
     3624             ( length(icodeIdent) eq 25
     3625               and not icodeIdent begins "01"
     3626               and not icodeIdent begins "02"))
     3627      then do:
     3628         if iTeg eq "01" or iTeg eq "02"
     3629         then
     3630            oTeg = substring(icodeIdent,1,21).
     3631         else  if  iTeg eq "21"
     3632         then
     3633            oTeg = substring(icodeIdent,15,7).
     3634      end.
     3635      else do:
     3636         ChekTypeMarkByDm(icodeIdent).
     3637         block-teg:
     3638            do while Velement ne "" and icodeIdent ne "":
     3639            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     3640            if    Velement begins iTeg
     3641               or Velement begins "(" + iTeg + ")"
     3642            then do:
     3643               oTeg = vtegval.
     3644               leave block-teg.
     3645            end.
     3646         end.
     3647      end.
     3648      return oTeg.
     3649   end.
     3650   function isOAD return logical
     3651   (icodeIdent as character):
     3652      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     3653   end.
     3654   function isMark return logical
     3655   (icodeIdent as character):
     3656      define buffer buf_marking for ub.marking.
     3657      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     3658             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     3659   end.
     3660   function addBracketForCode return character
     3661   (icodeIdent as char):
     3662      define variable Velement   as character no-undo init "first".
     3663      define variable oTeg as character no-undo.
     3664      define variable vteg as character no-undo.
     3665      define variable vtegval as character no-undo.
     3666      define buffer marking for ub.marking.
     3667      find first marking no-lock where
     3668                 marking.mark begins icodeIdent no-error.
     3669      if    not ChekTypeMarkByDm(icodeIdent)
     3670         or length(icodeIdent) le 24
     3671         or (avail marking and marking.unit-ext = "LEVEL2")
     3672      then
     3673         oTeg = icodeIdent.
     3674      else do:
     3675         if (  icodeIdent begins "01"
     3676            or icodeIdent begins "02"
     3677            ) and CheckGtin(substring (icodeIdent,3,14))
     3678            and substring (icodeIdent,17,2) eq "21"
     3679         then do:
     3680            mMRCCode = yes.
     3681            ChekTypeMarkByDm(icodeIdent).
     3682            block-teg:
     3683            do while Velement ne "" and icodeIdent ne "":
     3684               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     3685               if vteg ne ""
     3686               then
     3687                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     3688            end.
     3689            mMRCCode = no.
     3690         end.
     3691         else do:
     3692            oTeg = icodeIdent.
     3693         end.
     3694      end.
     3695      return oTeg.
     3696   end.
     3697   function getlevelByCodId return int
     3698   (iCode as char):
     3699      define variable vLength as int no-undo.
     3700      define variable vLevel  as int no-undo.
     3701      if not ChekTypeMarkByDM (icode) then return ?.
     3702      vLength = length(iCode).
     3703      if    vLength eq 18
     3704         or vLength eq 20
     3705      then
     3706         Vlevel = 4.
     3707      else if vLength eq 21
     3708      then
     3709         Vlevel = 1.
     3710      else if vLength eq 25
     3711      then do:
     3712         if  iCode begins "01"
     3713         then
     3714            Vlevel = 3.
     3715         else
     3716            Vlevel = 1.
     3717      end.
     3718      else if     vLength >= 26
     3719              and vLength <= 46
     3720      then do:
     3721         if    substring(iCode,17,2) eq "11"
     3722            or substring(iCode,17,2) eq "13"
     3723            or (    substring(iCode,17,2) eq "21"
     3724                and vLength >= 33
     3725                and substring(iCode,26,4) ne "8005")
     3726         then
     3727            Vlevel = 4.
     3728         else if    vLength eq 31
     3729                 or vLength eq 38
     3730                 or vLength eq 39
     3731                 or vLength eq 45
     3732         then
     3733            Vlevel = 1.
     3734         else if    vLength eq 35
     3735                 or vLength eq 43
     3736         then
     3737            Vlevel = 3.
     3738         else
     3739            Vlevel = ?.
     3740      end.
     3741      else
     3742         Vlevel = ?.
     3743      return Vlevel.
     3744   end.
     3745   function getLevelMotpBycodid return character
     3746   (iDm as char):
     3747      define variable vLevel as integer no-undo.
     3748      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     3749      vLevel = getlevelByCodId(iDm).
     3750      if    vLevel eq ?
     3751         or vLevel < 1
     3752         or vLevel > 6
     3753      then
     3754         return ?.
     3755      else
     3756         return entry(vlevel,vList).
     3757   end.
     3758   function getLevelUTDByLevelMotp return character
     3759   (iUnit as char):
     3760      define variable vLevel as integer no-undo.
     3761      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     3762      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     3763      vLevel = lookup(iUnit,vListMOTP).
     3764      if    vLevel eq ?
     3765         or vLevel < 1
     3766         or vLevel > 4
     3767      then
     3768         return ?.
     3769      else
     3770         return entry(vlevel,vListutd).
     3771   end.
     3772   function getLevelMotpByDM return character
     3773   (iDm as char):
     3774      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     3775   end.
     3776   function getLevelUTDByCodId return character
     3777   (iDm as char):
     3778      define variable vLevel as integer no-undo.
     3779      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     3780      vLevel = getlevelByCodId(iDm).
     3781      if    vLevel eq ?
     3782         or vLevel < 1
     3783         or vLevel > 4
     3784      then
     3785         return ?.
     3786      else
     3787         return entry(vlevel,vList).
     3788   end.
     3789   function getLevelUTDByDM return character
     3790   (iDm as char):
     3791      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     3792   end.
     3793   define variable mNotMarkQnty as logical no-undo.
     3794   function getQntyUTDByCodId return decimal
     3795   (iDM as char):
     3796      define variable vLevel as integer no-undo.
     3797      define variable vList as character no-undo init "1,5,10,500".
     3798      define variable vGtin as character no-undo.
     3799      define variable vqnty as decimal no-undo init ?.
     3800      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     3801      if vqnty eq ?
     3802      then do:
     3803         if not mNotMarkQnty
     3804         then do:
     3805            define buffer marking for ub.marking.
     3806            define variable vCodident as character no-undo.
     3807            vCodident = GetCodeIdent(idm).
     3808            find first marking where marking.mark begins vCodident no-lock no-error.
     3809            if     available marking
     3810               and marking.box-qnty ne ?
     3811            then
     3812               return marking.box-qnty.
     3813         end.
     3814         vGtin = getGtinByDm(iDM).
     3815         if ChekTypeMarkByGtin (vGtin)
     3816         then do:
     3817            vLevel = getlevelByCodId(iDM).
     3818            if     vLevel >= 1
     3819               and vLevel <= 4
     3820            then
     3821               vqnty = int(entry(vlevel,vList)).
     3822         end.
     3823         else
     3824            vqnty = getQntyCodeByGtin(vgtin).
     3825      end.
     3826      return vqnty.
     3827   end.
     3828   function getQntyUTDByDM return decimal
     3829   (iDm as char):
     3830      define variable vDM as character no-undo.
     3831      if     length (iDm) ne 25
     3832         and length (iDm) ne 29
     3833         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     3834      then
     3835         vDM = substring (iDm,1,length (iDm) - 6 ).
     3836      else
     3837         vDM = substring (iDm,1,length (iDm) - 4 ).
     3838      return getQntyUTDByCodId(vDM).
     3839   end.
     3840   function getMRC4 return decimal
     3841   (iMRC as char):
     3842      define variable oMrc     as decimal no-undo init ?.
     3843      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     3844      define variable vi       as integer no-undo.
     3845      define variable vfound   as integer no-undo.
     3846      define variable vposStart   as integer no-undo.
     3847      do:
     3848      OMRc = 0.
     3849      do vi = 1 to 4:
     3850         define variable vsimb as character no-undo.
     3851         vsimb = substring(iMRC,vi,1).
     3852         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     3853         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     3854         if vfound > 0
     3855         then
     3856            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     3857         end.
     3858         OMRc = OMRc / 100.
     3859      end.
     3860      return OMRc.
     3861   end.
     3862   function getMRCByDM return decimal
     3863   (iDm as char):
     3864      define variable vMRC     as character no-undo.
     3865      define variable oMrc     as decimal no-undo init ?.
     3866      define variable Velement as character no-undo init "empty".
     3867      define variable vteg as character no-undo.
     3868      define variable vtegval as character no-undo.
     3869      if    length(idm) eq 14 + 7 + 4 + 4
     3870         or length(idm) eq 14 + 7 + 4
     3871      then do:
     3872         vMRC = substring(idm,22,4).
     3873         omrc = getMRC4(vMRC).
     3874      end.
     3875      else do:
     3876          ChekTypeMarkByDm(iDm).
     3877          block-mrc:
     3878          do while Velement ne "" and idm ne "":
     3879             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     3880             if Velement begins "8005"
     3881             then do:
     3882                vMRC = substring(Velement,5,6).
     3883                leave block-mrc.
     3884             end.
     3885             else if Velement begins "(8005)"
     3886             then do:
     3887                vMRC = substring(Velement,7,6).
     3888                leave block-mrc.
     3889             end.
     3890          end.
     3891          if vMRC ne ""
     3892          then
     3893             OMRc = dec(vmrc) / 100 no-error.
     3894      end.
     3895      return OMRc.
     3896   end.
     3897   function MoveDate return Date
     3898   (idate as date,
     3899    iMonth as int64):
     3900      define variable vMonth   as int64 no-undo.
     3901      define variable vYear    as int64 no-undo.
     3902      define variable vDateNew as date  no-undo.
     3903       define variable vDay     as int64 no-undo.
     3904       vMonth = month(iDate) + iMonth.
     3905       vYear =  year(iDate).
     3906       if vMonth <= 0
     3907       then assign
     3908          vMonth = vMonth + 12
     3909           vYear  = vYear - 1
     3910       .
     3911       else if vMonth > 12
     3912       then assign
     3913          vMonth = vMonth - 12
     3914           vYear  = vYear + 1
     3915       .
     3916       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     3917       do while error-status:error eq yes:
     3918          VDay = vDay + 1.
     3919          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     3920       end.
     3921       if VDay > 0
     3922       then
     3923          vDateNew + 1.
     3924       return vDateNew.
     3925   end.
     3926   procedure checkEMRC:
     3927   define input  parameter iDm as character no-undo.
     3928   define output parameter vok as logical   no-undo init yes.
     3929      define variable v-value-emrc as character no-undo.
     3930      define variable v-type-emrc  as character no-undo.
     3931      define variable vDateIso     as character no-undo.
     3932      define variable vMRC         as decimal no-undo.
     3933      define variable vqnty        as decimal no-undo.
     3934      define variable vPrice       as decimal no-undo.
     3935      define variable vparent      as character no-undo.
     3936      define variable vgds-code    as integer no-undo.
     3937      define buffer code for ub.code.
     3938      vMRC = getMRCByDM(iDm).
     3939      if vMRC > 0
     3940      then do:
     3941         vgds-code = getGdsCodeByDM(iDm).
     3942         vqnty     = getQntyUTDByDM(iDm).
     3943               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3944            (
     3945             input   vgds-code
     3946            ,input   'emrc-type':U
     3947            ,output   v-value-emrc
     3948            ,output   v-type-emrc
     3949          ) no-error.
     3950          if     v-value-emrc ne ""
     3951             and v-value-emrc ne ?
     3952          then do:
     3953             vDateIso = iso-date(today).
     3954             vPrice = vMRC / vqnty.
     3955             vparent ="emc" + chr(4) + v-value-emrc.
     3956             find last code where Code.parent      eq vparent
     3957                              and Code.code        le vDateIso
     3958                              and code.status_  eq 0
     3959             no-lock no-error.
     3960             if not available code or ( vPrice  >= dec(Code.CodeValue))
     3961             then
     3962                vOk = true .
     3963             else do:
     3964                 define variable vText      as character no-undo.
     3965                 define variable vDate      as date no-undo.
     3966                 define variable vDateLast  as character no-undo.
     3967                 define variable vDateFirst as character no-undo.
     3968                 define variable vDate3     as date no-undo.
     3969                 vdate = date(code.misc1).
     3970                 vDateLast = code.misc1.
     3971                 vDate3 = MoveDate(today, - 3 ).
     3972                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     3973                                      string(vDate3  , "99/99/9999"),
     3974                                      string(vDate   , "99/99/9999")
     3975                                      ).
     3976                 vdateIso = iso-date(vdate3).
     3977                 find last code  where Code.parent      eq vparent
     3978                                   and Code.code        le vDateIso
     3979                                   and code.status_  eq 0 no-lock no-error.
     3980                 if available code
     3981                 then
     3982                    vDateIso = code.code.
     3983                 vDateFirst = vDateIso.
     3984                 vDateLast = iso-date(vdate).
     3985                 define variable vGood as logical no-undo.
     3986                 define variable vDateSale as date no-undo.
     3987                 define buffer bcode for code.
     3988                 for last code where Code.parent   eq vparent
     3989                                 and code.status_  eq 0
     3990                                 and code.code     < vDateLast
     3991                                 and code.code     >= vDateFirst
     3992                 no-lock:
     3993                    find first bcode where bCode.parent   eq vparent
     3994                                       and bcode.status_  eq 0
     3995                                       and bcode.code     > code.code no-lock no-error.
     3996                    if available bcode
     3997                    then do:
     3998                       if vPrice < dec(Code.CodeValue)
     3999                       then
     4000                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     4001                                                     chr(10),
     4002                                                     string(    date( code.misc1)       ,"99/99/9999"),
     4003                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     4004                                                     ).
     4005                       else do:
     4006                          vGood = yes.
     4007                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     4008                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     4009                                                     chr(10),
     4010                                                     string(    date( code.misc1)         ,"99/99/9999"),
     4011                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     4012                                                     string(         vDateSale            ,"99/99/9999"),
     4013                                                     string(vDateSale - today)
     4014                                                     ).
     4015                       end.
     4016                    end.
     4017                 end.
     4018                 if vgood
     4019                 then do:
     4020                    define variable choice as integer no-undo .
     4021                    run gbl/d-askw.w (input "Уточнение"
     4022                           ,input  vText
     4023                           ,input "|"
     4024                           ,input "Принять|Вернуть"
     4025                           ,input "Принять данный товар|Вернуть товар постащику"
     4026                           ,input 1
     4027                           ,input 2
     4028                           ,output choice) no-error.
     4029                    vok = choice eq 1.
     4030                 end.
     4031                 else
     4032                    vok =false.
     4033             end.
     4034          end.
     4035      end.
     4036   end.
     4037   function addGs2Mark return character
     4038   (iMark as char):
     4039      define variable vDM   as character no-undo.
     4040      define variable vIdx  as integer   no-undo.
     4041      if index(iMark,chr(29),1) > 0
     4042      then return iMark.
     4043      if substring(iMark,26,4) = "8005" then
     4044      do:
     4045        vIdx = index(iMark,"93",26 + 4 + 5).
     4046        if vIdx > 1 then do:
     4047          vDM = substitute("&1&4&2&4&3",
     4048                           substring(iMark,1,25),
     4049                           substring(iMark,26,vIdx - 25 - 1),
     4050                           substring(iMark,vIdx),
     4051                           chr(29)) no-error.
     4052          vIdx = index(vDm,"240",vIdx + 4).
     4053          if vIdx > 0 then
     4054          do:
     4055            vDM = substitute("&1&3&2",
     4056                             substring(vDm,1,vIdx - 1),
     4057                             substring(vDm,vIdx),
     4058                             chr(29)) no-error.
     4059          end.
     4060        end.
     4061        else
     4062          vDM = substitute("&1&3&2",
     4063                           substring(iMark,1,25),
     4064                           substring(iMark,26),
     4065                           chr(29)) no-error.
     4066      end.
     4067      else if substring(iMark,32,2) = "91" then
     4068      do:
     4069        vIdx = index(iMark,"92",32).
     4070        if vIdx > 1 then
     4071          vDM = substitute("&1&4&2&4&3",
     4072                           substring(iMark,1,31),
     4073                           substring(iMark,32,vIdx - 31 - 1),
     4074                           substring(iMark,vIdx),
     4075                           chr(29)) no-error.
     4076        else
     4077          vDM = substitute("&1&3&2",
     4078                           substring(iMark,1,31),
     4079                           substring(iMark,32),
     4080                           chr(29)) no-error.
     4081      end.
     4082      else if substring(iMark,39,2) = "91" then
     4083      do:
     4084        vIdx = index(iMark,"92",38).
     4085        if vIdx > 1 then
     4086          vDM = substitute("&1&4&2&4&3",
     4087                           substring(iMark,1,38),
     4088                           substring(iMark,39,vIdx - 38 - 1),
     4089                           substring(iMark,vIdx),
     4090                           chr(29)) no-error.
     4091        else
     4092          vDM = substitute("&1&3&2",
     4093                           substring(iMark,1,38),
     4094                           substring(iMark,39),
     4095                           chr(29)) no-error.
     4096      end.
     4097      else if substring(iMark,25,2) = "93" then
     4098      do:
     4099        vIdx = index(iMark,"92",25).
     4100        if vIdx > 1 then
     4101          vDM = substitute("&1&4&2&4&3",
     4102                           substring(iMark,1,24),
     4103                           substring(iMark,25,vIdx - 24 - 1),
     4104                           substring(iMark,vIdx),
     4105                           chr(29)) no-error.
     4106        else
     4107          vIdx = index(iMark,"3103",25).
     4108          if vIdx > 0 then
     4109          vDM = substitute("&1&4&2&4&3",
     4110                           substring(iMark,1,24),
     4111                           substring(iMark,25,vIdx - 24 - 1),
     4112                           substring(iMark,vIdx),
     4113                           chr(29)) no-error.
     4114          else
     4115            vDM = substitute("&1&3&2",
     4116                             substring(iMark,1,24),
     4117                             substring(iMark,25),
     4118                             chr(29)) no-error.
     4119      end.
     4120      else if substring(iMark,32,2) = "93" then
     4121      do:
     4122        vDM = substitute("&1&3&2",
     4123              substring(iMark,1,31),
     4124              substring(iMark,32),
     4125              chr(29)) no-error.
     4126      end.
     4127      return if vDM <> "" then vDm else iMark.
     4128   end.
     4129   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4130   procedure partcopy :
     4131     define input parameter  p-free-output-copy as logical   no-undo .
     4132     define input parameter  p-out-code         like ub.parts.out-code no-undo .
     4133     define parameter buffer buf_orig_parts     for ub.parts .
     4134     define parameter buffer buf_parts          for ub.parts .
     4135     define input parameter  p-mark             as character no-undo .
     4136     define variable vss-description as character no-undo init "partcopy-01: процедура копирования партии".
     4137     define variable v-value-character as character no-undo .
     4138     define variable v-value-date      as date no-undo .
     4139     define variable v-value-decimal   as decimal no-undo .
     4140     define variable v-value-integer   as integer no-undo .
     4141     define variable v-izlcstpr        as logical no-undo .
     4142     define variable v-tth             as handle no-undo .
     4143     define variable v-type            as character no-undo .
     4144     define variable part-key-rec      as character no-undo .
     4145     define variable orig-part-key-rec as character no-undo .
     4146     define variable del-part-key-rec  as character no-undo .
     4147     define variable objMarks as class excisemarks  no-undo .
     4148     define variable v-parent-mark-sts as integer   no-undo .
     4149     define variable v-mark-sts-list   as character no-undo .
     4150     define variable oMarkSts as class ibs.th.str.marking.sts.mark .
     4151     oMarkSts = objSrv:Env:Marking:Sts:Mark.
     4152     define buffer buf_gen-attr for ub.gen-attr .
     4153     define buffer buf1_gen-attr for ub.gen-attr .
     4154     define buffer buf_doc-line  for ub.doc-line .
     4155     define buffer buf_marking for ub.marking .
     4156     define buffer buf_marking-childs for ub.marking .
     4157     define buffer orig_marking-lines for ub.marking-lines .
     4158     define buffer orig_marking-lines-childs for ub.marking-lines .
     4159     define buffer buf_marking-lines for ub.marking-lines .
     4160     define buffer buf_marking-lines-childs for ub.marking-lines .
     4161     define buffer buf_marking-pack for ub.marking .
     4162     define buffer buf_marking-chk for ub.marking-chk .
     4163     define buffer buf_goods for ub.goods .
     4164     define buffer buf_trn-doc for ub.trn-doc .
     4165     define buffer pri_trn-doc for ub.trn-doc .
     4166     define buffer buf_chk-doc for ub.chk-doc .
     4167     do
     4168     on error undo, return error return-value
     4169     :
     4170       if p-free-output-copy = true
     4171       then do:
     4172         if  p-out-code <> 'free-zone':U
     4173         and p-out-code <> 'out-zone':U
     4174         then do:
     4175           message
     4176             vss-workfile vss-revision vss-description skip
     4177             vss-include-info21 skip
     4178             "Ошибка задания входных параметров процедуры partcopy" skip
     4179             "p-free-output-copy" p-free-output-copy skip
     4180             "p-out-code" p-out-code skip
     4181             view-as alert-box error .
     4182           undo, return error .
     4183         end.
     4184       end.
     4185       if buf_orig_parts.out-code <> p-out-code
     4186       then do:
     4187         find first buf_parts exclusive-lock
     4188           where buf_parts.obj-type  = buf_orig_parts.obj-type
     4189             and buf_parts.obj-code  = buf_orig_parts.obj-code
     4190             and buf_parts.artic     = buf_orig_parts.artic
     4191             and buf_parts.prod-type = buf_orig_parts.prod-type
     4192             and buf_parts.prod-code = buf_orig_parts.prod-code
     4193             and buf_parts.in-code   = buf_orig_parts.in-code
     4194             and buf_parts.out-code  = p-out-code
     4195             and buf_parts.part-code = buf_orig_parts.part-code
     4196           no-error.
     4197         if not available buf_parts
     4198         then do:
     4199           define variable v-rsrv-free as logical   no-undo .
     4200           if p-out-code = 'free-zone':U
     4201           or p-out-code = 'out-zone':U
     4202           then do:
     4203             assign
     4204               v-rsrv-free =
     4205          (if p-out-code = 'free-zone':U then yes else no)
     4206             .
     4207           end.
     4208           else do:
     4209             assign
     4210               v-rsrv-free = ?
     4211             .
     4212           end.
     4213           create buf_parts .
     4214           buffer-copy buf_orig_parts to buf_parts
     4215           assign
     4216             buf_parts.out-code  = p-out-code
     4217             buf_parts.status_   = no
     4218             buf_parts.rsrv-free = v-rsrv-free
     4219             buf_parts.qnty      = 0
     4220             buf_parts.fact-qnty = 0
     4221             buf_parts.real-qnty = 0
     4222             buf_parts.cli-qnty  = 0
     4223           .
     4224           validate buf_parts .
     4225         end.
     4226         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     4227                                           ,input (buffer buf_orig_parts:handle)
     4228                                           ,output orig-part-key-rec).
     4229         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     4230                                           ,input (buffer buf_parts:handle)
     4231                                           ,output part-key-rec).
     4232         for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     4233               and ub.gen-attr.p-key =  orig-part-key-rec:
     4234             if not valid-object (objMarks)
     4235               then objMarks = new excisemarks (buf_parts.obj-type, buf_parts.obj-code).
     4236               if p-out-code = 'free-zone':U
     4237               and (entry(7,orig-part-key-rec,chr(3)) = entry(8,orig-part-key-rec,chr(3)) )
     4238                then
     4239               do:
     4240                   objMarks:CrFreeMarkForParts(buffer buf_orig_parts, buffer buf_parts, ub.gen-attr.attr-code) .
     4241                   if objMarks:StatusErr
     4242                       then
     4243                   do:
     4244                       message objMarks:ReturnMsg view-as alert-box error.
     4245                       delete object objMarks no-error.
     4246                       undo, return error.
     4247                   end.
     4248               end.
     4249             if (entry(7,orig-part-key-rec,chr(3)) <> entry(8,orig-part-key-rec,chr(3)) ) then
     4250             do:
     4251                 if p-mark <> "" then do:
     4252                 if p-out-code = 'free-zone':U then do:
     4253                   objMarks:RezervMarkForParts(buffer buf_parts, buffer buf_orig_parts, p-mark) .
     4254                 end.
     4255                 else do:
     4256                   objMarks:RezervMarkForParts(buffer buf_orig_parts, buffer buf_parts, p-mark) .
     4257                 end.
     4258                 if objMarks:StatusErr
     4259                   then
     4260                 do:
     4261                   message objMarks:ReturnMsg view-as alert-box error.
     4262                   delete object objMarks no-error.
     4263                   undo, return error.
     4264                 end.
     4265               end.
     4266             end.
     4267             if p-out-code = 'out-zone':U then
     4268             do:
     4269                 objMarks:CrOutMarkForParts(buffer buf_orig_parts, buffer buf_parts, ub.gen-attr.attr-code) .
     4270                 if objMarks:StatusErr
     4271                     then
     4272                 do:
     4273                     message objMarks:ReturnMsg view-as alert-box error.
     4274                     delete object objMarks no-error.
     4275                     undo, return error.
     4276                 end.
     4277             end.
     4278         end.
     4279         delete object objMarks no-error.
     4280         if p-mark = "news" then return .
     4281         find first pri_trn-doc no-lock where pri_trn-doc.doc-code = buf_orig_parts.out-code no-error .
     4282         find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-out-code no-error.
     4283         if not available buf_trn-doc
     4284         then
     4285            find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_orig_parts.out-code no-error .
     4286         if (
     4287             p-out-code = 'free-zone':U
     4288             and buf_orig_parts.in-code = buf_orig_parts.out-code
     4289            )
     4290         or
     4291            (
     4292             p-out-code = 'free-zone':U
     4293             and available pri_trn-doc
     4294             and (pri_trn-doc.ext-doc-type = 'iv':U or pri_trn-doc.ext-doc-type = 'rv':U)
     4295            )
     4296         or
     4297            (
     4298             available buf_trn-doc
     4299             and p-out-code = buf_trn-doc.doc-code
     4300             and buf_trn-doc.ext-doc-type = 'vt':U
     4301            )
     4302         or
     4303            (
     4304             p-mark = ""
     4305             and available buf_trn-doc
     4306             and p-out-code = 'free-zone':U
     4307             and buf_trn-doc.ext-doc-type = 'vt':U
     4308            )
     4309         or
     4310            (
     4311             p-mark = ""
     4312             and available buf_trn-doc
     4313             and p-out-code = 'free-zone':U
     4314             and buf_trn-doc.ext-doc-type = 'rs':U
     4315            )
     4316         then do :
     4317           find first ub.goods no-lock where ub.goods.artic = buf_parts.artic
     4318             and ub.goods.prod-type = buf_parts.prod-type
     4319             and ub.goods.prod-code = buf_parts.prod-code.
     4320           def buffer buf_orig_ml for ub.marking-lines.
     4321           for each buf_orig_ml where buf_orig_ml.gds-code = ub.goods.gds-code
     4322             and buf_orig_ml.obj-type = buf_orig_parts.obj-type
     4323             and buf_orig_ml.obj-code = buf_orig_parts.obj-code
     4324             and buf_orig_ml.in-code = buf_orig_parts.in-code
     4325             and buf_orig_ml.out-code = buf_orig_parts.out-code
     4326             and buf_orig_ml.part-code = buf_orig_parts.part-code
     4327             and buf_orig_ml.prt-code = buf_orig_parts.prt-code:
     4328             if available pri_trn-doc
     4329             and pri_trn-doc.ext-doc-type = 'iv':U
     4330             and buf_orig_ml.sts <> objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     4331             then do :
     4332               for first buf_marking exclusive-lock where buf_marking.mark = buf_orig_ml.mark :
     4333                 assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB .
     4334               end .
     4335               next .
     4336             end .
     4337             find first ub.marking-lines no-lock where ub.marking-lines.mark     = buf_orig_ml.mark
     4338                                                   and ub.marking-lines.gds-code = buf_orig_ml.gds-code
     4339                                                   and ub.marking-lines.obj-type = buf_orig_ml.obj-type
     4340                                                   and ub.marking-lines.obj-code = buf_orig_ml.obj-code
     4341                                                   and ub.marking-lines.in-code  = buf_orig_ml.in-code
     4342                                                   and ub.marking-lines.out-code = p-out-code
     4343                                                   and ub.marking-lines.part-code = buf_orig_ml.part-code
     4344                                                   and ub.marking-lines.prt-code = buf_orig_ml.prt-code
     4345                                                   no-error .
     4346             if not available ub.marking-lines
     4347             then do :
     4348               create ub.marking-lines.
     4349               buffer-copy buf_orig_ml to ub.marking-lines
     4350               assign
     4351                 ub.marking-lines.out-code  = p-out-code
     4352                 ub.marking-lines.fact-order = pri_trn-doc.fact-order when available pri_trn-doc
     4353               .
     4354               validate ub.marking-lines.
     4355             end .
     4356             if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U then do:
     4357             for first buf_marking exclusive-lock where buf_marking.mark = buf_orig_ml.mark
     4358               and not (buf_marking.sts = oMarkSts:MarkError:KeyIntDB and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U):
     4359               if buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB and
     4360                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB and
     4361                  not can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(buf_marking.sts)) and
     4362                  not can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(buf_marking.sts)) and
     4363                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     4364               then do:
     4365                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     4366                 validate buf_marking.
     4367               end.
     4368             end .
     4369           end .
     4370           end.
     4371         end .
     4372         define variable v-doc-type  as character no-undo .
     4373         define variable   v-status    as character no-undo .
     4374         define variable v-fact-qnty   as  decimal no-undo .
     4375         define variable ii    as integer no-undo .
     4376         find first buf_goods no-lock where buf_goods.artic = buf_orig_parts.artic
     4377                                        and buf_goods.prod-type = buf_orig_parts.prod-type
     4378                                        and buf_goods.prod-code = buf_orig_parts.prod-code
     4379                                        .
     4380         if available pri_trn-doc
     4381         and pri_trn-doc.ext-doc-type = 'rs':U
     4382         then do :
     4383           if p-mark <> ""
     4384           then do :
     4385           end .
     4386           else do :
     4387           end .
     4388         end .
     4389         else do :
     4390           if buf_orig_parts.in-code <> buf_orig_parts.out-code
     4391           and p-mark <> ""
     4392           then do :
     4393             if p-out-code = 'free-zone':U
     4394             then do:
     4395                 if chg-qnty < 0
     4396                 then do :
     4397                   find first orig_marking-lines no-lock where orig_marking-lines.mark       = p-mark
     4398                                                           and orig_marking-lines.gds-code   = buf_goods.gds-code
     4399                                                           and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     4400                                                           and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     4401                                                           and orig_marking-lines.in-code    = buf_orig_parts.in-code
     4402                                                           and orig_marking-lines.out-code   = buf_orig_parts.out-code
     4403                                                           and orig_marking-lines.part-code  = buf_orig_parts.part-code
     4404                                                           and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     4405                                                           no-error .
     4406                   if available orig_marking-lines
     4407                   then do :
     4408                     find first buf_marking-lines no-lock where buf_marking-lines.mark       = p-mark
     4409                                                            and buf_marking-lines.gds-code   = buf_goods.gds-code
     4410                                                            and buf_marking-lines.obj-type   = buf_parts.obj-type
     4411                                                            and buf_marking-lines.obj-code   = buf_parts.obj-code
     4412                                                            and buf_marking-lines.in-code    = buf_parts.in-code
     4413                                                            and buf_marking-lines.out-code   = buf_parts.out-code
     4414                                                            and buf_marking-lines.part-code  = buf_parts.part-code
     4415                                                            and buf_marking-lines.prt-code   = buf_parts.prt-code
     4416                                                            no-error .
     4417                     if not available buf_marking-lines
     4418                     then do :
     4419                       create buf_marking-lines .
     4420                       assign
     4421                         buf_marking-lines.mark       = p-mark
     4422                         buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     4423                         buf_marking-lines.gds-code   = buf_goods.gds-code
     4424                         buf_marking-lines.obj-type   = buf_parts.obj-type
     4425                         buf_marking-lines.obj-code   = buf_parts.obj-code
     4426                         buf_marking-lines.in-code    = buf_parts.in-code
     4427                         buf_marking-lines.out-code   = buf_parts.out-code
     4428                         buf_marking-lines.part-code  = buf_parts.part-code
     4429                         buf_marking-lines.prt-code   = buf_parts.prt-code
     4430                       .
     4431                       validate buf_marking-lines.
     4432                     end .
     4433                     for first buf_marking exclusive-lock where buf_marking.mark = p-mark :
     4434                       assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     4435                       for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     4436                         for first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_marking-chk.doc-code
     4437                                                         and buf_chk-doc.out-code = buf_orig_parts.out-code
     4438                                                         :
     4439                           assign buf_marking-chk.sts = 0 .
     4440                           validate buf_marking-chk.
     4441                         end .
     4442                       end .
     4443                       if buf_marking.unit-ext <> "UNIT" or
     4444                          (buf_marking.unit-ext = ? and buf_marking.box-qnty > 1)
     4445                       then do :
     4446                         run addChildMarkingLines in this-procedure (
     4447                           buf_marking.mark,
     4448                           objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB,
     4449                           buffer buf_marking-lines,
     4450                           buffer buf_parts,
     4451                           buffer orig_marking-lines,
     4452                           buffer buf_orig_parts,
     4453                           buffer buf_goods
     4454                         ).
     4455                       end .
     4456                     end.
     4457                     find current orig_marking-lines exclusive-lock .
     4458                     delete orig_marking-lines .
     4459                   end .
     4460                 end .
     4461             end.
     4462             else do:
     4463               find first orig_marking-lines exclusive-lock where orig_marking-lines.mark       = p-mark
     4464                                                              and orig_marking-lines.gds-code   = buf_goods.gds-code
     4465                                                              and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     4466                                                              and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     4467                                                              and orig_marking-lines.in-code    = buf_orig_parts.in-code
     4468                                                              and orig_marking-lines.out-code   = buf_orig_parts.out-code
     4469                                                              and orig_marking-lines.part-code  = buf_orig_parts.part-code
     4470                                                              and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     4471                                                              no-error .
     4472                 find first buf_marking-lines no-lock where  buf_marking-lines.mark       = p-mark
     4473                                                         and buf_marking-lines.gds-code   = buf_goods.gds-code
     4474                                                         and buf_marking-lines.obj-type   = buf_parts.obj-type
     4475                                                         and buf_marking-lines.obj-code   = buf_parts.obj-code
     4476                                                         and buf_marking-lines.in-code    = buf_parts.in-code
     4477                                                         and buf_marking-lines.out-code   = buf_parts.out-code
     4478                                                         and buf_marking-lines.part-code  = buf_parts.part-code
     4479                                                         and buf_marking-lines.prt-code   = buf_parts.prt-code
     4480                                                         no-error .
     4481                 if not available buf_marking-lines
     4482                 then do :
     4483                   create buf_marking-lines .
     4484                   assign
     4485                     buf_marking-lines.mark       = p-mark
     4486                     buf_marking-lines.doc-level  = 1
     4487                     buf_marking-lines.gds-code   = buf_goods.gds-code
     4488                     buf_marking-lines.obj-type   = buf_parts.obj-type
     4489                     buf_marking-lines.obj-code   = buf_parts.obj-code
     4490                     buf_marking-lines.in-code    = buf_parts.in-code
     4491                     buf_marking-lines.out-code   = buf_parts.out-code
     4492                     buf_marking-lines.part-code  = buf_parts.part-code
     4493                     buf_marking-lines.prt-code   = buf_parts.prt-code
     4494                     buf_marking-lines.sts        = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB
     4495                   .
     4496                   validate buf_marking-lines.
     4497                 end .
     4498                 for first buf_marking exclusive-lock where buf_marking.mark = p-mark :
     4499                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB .
     4500                   validate buf_marking.
     4501                   for first buf_marking-childs exclusive-lock where
     4502                             buf_marking-childs.mark = buf_marking.mark-parent:
     4503                     buf_marking-childs.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB .
     4504                     validate buf_marking-childs.
     4505                   end.
     4506                   for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     4507                     for first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_marking-chk.doc-code
     4508                                                     and buf_chk-doc.out-code = buf_parts.out-code
     4509                                                     :
     4510                       if buf_marking-chk.sts <> 2 then
     4511                       do:
     4512                          assign buf_marking-chk.sts = 1 .
     4513                          validate buf_marking-chk.
     4514                       end.
     4515                     end .
     4516                   end .
     4517                   if buf_marking.unit-ext <> "UNIT" or
     4518                      (buf_marking.unit-ext = ? and buf_marking.box-qnty > 1)
     4519                   then do :
     4520                     run addChildMarkingLines in this-procedure (
     4521                       buf_marking.mark,
     4522                       buf_marking.sts,
     4523                       buffer buf_marking-lines,
     4524                       buffer buf_parts,
     4525                       buffer orig_marking-lines,
     4526                       buffer buf_orig_parts,
     4527                       buffer buf_goods
     4528                     ).
     4529                   end .
     4530                 end.
     4531                 if available orig_marking-lines then
     4532                   delete orig_marking-lines .
     4533             end.
     4534           end.
     4535         end .
     4536         if p-out-code = 'out-zone':U
     4537         and trim(p-mark) = ""
     4538         then do :
     4539           for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     4540                                                 and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     4541                                                 and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     4542                                                 and orig_marking-lines.in-code    = buf_orig_parts.in-code
     4543                                                 and orig_marking-lines.out-code   = buf_orig_parts.out-code
     4544                                                 and orig_marking-lines.part-code  = buf_orig_parts.part-code
     4545                                                 and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     4546                                                 :
     4547             find first buf_marking-lines no-lock where  buf_marking-lines.mark       = orig_marking-lines.mark
     4548                                                     and buf_marking-lines.gds-code   = buf_goods.gds-code
     4549                                                     and buf_marking-lines.obj-type   = buf_parts.obj-type
     4550                                                     and buf_marking-lines.obj-code   = buf_parts.obj-code
     4551                                                     and buf_marking-lines.out-code   = p-out-code
     4552                                                     no-error .
     4553             if available buf_marking-lines
     4554             then do :
     4555               find current buf_marking-lines exclusive-lock .
     4556               delete buf_marking-lines .
     4557               for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     4558                 if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
     4559                 then do :
     4560                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     4561                   validate buf_marking.
     4562                 end.
     4563               end .
     4564             end .
     4565             else do :
     4566               if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U and buf_parts.out-code <> 'out-zone':U then do:
     4567               create buf_marking-lines .
     4568               assign
     4569                 buf_marking-lines.mark       = orig_marking-lines.mark
     4570                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     4571                 buf_marking-lines.gds-code   = buf_goods.gds-code
     4572                 buf_marking-lines.obj-type   = buf_parts.obj-type
     4573                 buf_marking-lines.obj-code   = buf_parts.obj-code
     4574                 buf_marking-lines.in-code    = buf_parts.in-code
     4575                 buf_marking-lines.out-code   = buf_parts.out-code
     4576                 buf_marking-lines.part-code  = buf_parts.part-code
     4577                 buf_marking-lines.prt-code   = buf_parts.prt-code
     4578               .
     4579               validate buf_marking-lines.
     4580               if buf_parts.out-code <> buf_parts.in-code
     4581               and buf_parts.out-code <> 'free-zone':U
     4582               and buf_parts.out-code <> 'out-zone':U
     4583               then do :
     4584                 find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.out-code no-error .
     4585                 if available buf_trn-doc then buf_marking-lines.fact-order = buf_trn-doc.fact-order .
     4586               end .
     4587               end.
     4588             end .
     4589             release buf_marking-lines no-error .
     4590           end.
     4591         end .
     4592         if p-mark <> "" and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U
     4593         then do:
     4594           for each orig_marking-lines no-lock where orig_marking-lines.mark         = p-mark
     4595                                                   and orig_marking-lines.gds-code   = buf_goods.gds-code
     4596                                                   and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     4597                                                   and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     4598                                                   and orig_marking-lines.in-code    = buf_orig_parts.in-code
     4599                                                   and orig_marking-lines.out-code   = buf_orig_parts.out-code
     4600                                                   and orig_marking-lines.part-code  = buf_orig_parts.part-code
     4601                                                   and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     4602                                                   .
     4603             find first buf_marking-lines no-lock where buf_marking-lines.mark       = p-mark
     4604                                                    and buf_marking-lines.gds-code   = buf_goods.gds-code
     4605                                                    and buf_marking-lines.obj-type   = buf_parts.obj-type
     4606                                                    and buf_marking-lines.obj-code   = buf_parts.obj-code
     4607                                                    and buf_marking-lines.in-code    = buf_parts.in-code
     4608                                                    and buf_marking-lines.out-code   = buf_orig_parts.out-code
     4609                                                    and buf_marking-lines.part-code  = buf_parts.part-code
     4610                                                    no-error .
     4611             for each ub.marking where ub.marking.mark = buf_marking-lines.mark:
     4612               if p-out-code = 'free-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
     4613                 then assign ub.marking.sts = oMarkSts:FreeZone:KeyIntDB.
     4614               if p-out-code = 'out-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
     4615                 then assign ub.marking.sts = oMarkSts:OutZone:KeyIntDB.
     4616               validate ub.marking.
     4617             end.
     4618             run partcopy-to-childs-mark (buffer buf_marking-lines, buffer orig_marking-lines, input buf_parts.out-code, oMarkSts).
     4619             if available (buf_marking-lines)
     4620             then do:
     4621               assign
     4622                 buf_marking-lines.mark       = p-mark
     4623                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     4624                 buf_marking-lines.gds-code   = buf_goods.gds-code
     4625                 buf_marking-lines.obj-type   = buf_parts.obj-type
     4626                 buf_marking-lines.obj-code   = buf_parts.obj-code
     4627                 buf_marking-lines.in-code    = buf_parts.in-code
     4628                 buf_marking-lines.out-code   = buf_parts.out-code
     4629                 buf_marking-lines.part-code  = buf_parts.part-code
     4630               .
     4631               validate buf_marking-lines.
     4632             end.
     4633           end.
     4634         end.
     4635       end.
     4636       else do:
     4637         find first buf_parts exclusive-lock
     4638           where recid(buf_parts) = recid(buf_orig_parts)
     4639           .
     4640       end.
     4641       if p-out-code = 'free-zone':U
     4642       or p-out-code = 'out-zone':U
     4643       then do:
     4644         if buf_parts.rsrv-free <>
     4645          (if buf_parts.out-code = 'free-zone':U then yes else no)
     4646         then do:
     4647           message
     4648             vss-workfile vss-revision vss-description skip
     4649             vss-include-info21 skip
     4650             "Ошибка типа резерва партии" skip
     4651             "Объект" buf_parts.obj-type buf_parts.obj-code  skip
     4652             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     4653             "Партия" buf_parts.in-code buf_parts.part-code skip
     4654             "Резерв" buf_parts.out-code skip
     4655             "Статус" buf_parts.status_ skip
     4656             "Тип резерва" buf_parts.rsrv-free skip
     4657             view-as alert-box error .
     4658           undo, return error .
     4659         end.
     4660       end.
     4661     end.
     4662   end procedure.
     4663   procedure partcopy-to-childs-mark :
     4664     define parameter buffer buf_ml for ub.marking-lines .
     4665     define parameter buffer buf_orig-ml for ub.marking-lines .
     4666     define input parameter p-out-code as character no-undo .
     4667     define input parameter THMarkSts as class ibs.th.str.marking.sts.mark no-undo .
     4668     define buffer buf_ml-childs for ub.marking-lines .
     4669     for each ub.marking where ub.marking.mark-parent = buf_ml.mark:
     4670       if p-out-code = 'free-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
     4671         then assign ub.marking.sts = THMarkSts:FreeZone:KeyIntDB.
     4672       if p-out-code = 'out-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
     4673         then assign ub.marking.sts = THMarkSts:OutZone:KeyIntDB.
     4674       for each buf_ml-childs exclusive-lock where buf_ml-childs.mark = ub.marking.mark
     4675         and buf_ml-childs.obj-type  = buf_orig-ml.obj-type
     4676         and buf_ml-childs.obj-code  = buf_orig-ml.obj-code
     4677         and buf_ml-childs.in-code   = buf_orig-ml.in-code
     4678         and buf_ml-childs.out-code  = buf_orig-ml.out-code
     4679         and buf_ml-childs.part-code = buf_orig-ml.part-code
     4680         and buf_ml-childs.prt-code  = buf_orig-ml.prt-code
     4681         :
     4682         assign
     4683           buf_ml-childs.out-code  = p-out-code
     4684         .
     4685         run partcopy-to-childs-mark (buffer buf_ml-childs, buffer buf_orig-ml, input p-out-code, input THMarkSts).
     4686       end.
     4687     end.
     4688   end.
     4689   procedure partcopy-update-parts :
     4690     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     4691     define input  parameter p-obj-type  like ub.doc-line.obj-type  no-undo .
     4692     define input  parameter p-obj-code  like ub.doc-line.obj-code  no-undo .
     4693     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     4694     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     4695     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     4696     define variable vss-description as character no-undo init "partcopy-update-parts-01: процедура обработки партий при закрытии документа".
     4697     define buffer buf_trn-doc for ub.trn-doc .
     4698     define buffer archive_parts for ub.parts .
     4699     define buffer buf_parts   for ub.parts .
     4700     define buffer orig_marking-lines for ub.marking-lines .
     4701     define buffer buf_marking for ub.marking .
     4702     define buffer buf_goods for ub.goods .
     4703     define variable v-rsrv-code     as character no-undo .
     4704     define variable v-goods-twounit as logical   no-undo .
     4705     define variable v-value-character as character no-undo .
     4706     define variable v-value-date      as date no-undo .
     4707     define variable v-value-decimal   as decimal no-undo .
     4708     define variable v-value-integer   as integer no-undo .
     4709     define variable v-izlcstpr        as logical no-undo .
     4710     define variable v-tth             as handle no-undo .
     4711     define variable v-type            as character no-undo .
     4712     define variable v-exch-rate  like ub.curr-accnt.exch-rate no-undo .
     4713     define variable v-exch-scale like ub.curr-accnt.exch-scale no-undo .
     4714     do
     4715     on error undo, return error return-value
     4716     :
     4717       find first buf_trn-doc no-lock
     4718         where buf_trn-doc.doc-code = p-doc-code
     4719         no-error .
     4720       if not available buf_trn-doc
     4721       then do:
     4722         message
     4723           vss-workfile vss-revision vss-description skip
     4724           vss-include-info21 skip
     4725           "Ошибка задания входных параметров" skip
     4726           "Не найден документ" skip
     4727           "Документ" p-doc-code skip
     4728           "Объект" p-obj-type p-obj-code skip
     4729           "Артикул" p-artic p-prod-type p-prod-code skip
     4730           error-status :get-message(1) skip
     4731           return-value skip
     4732           view-as alert-box error .
     4733         undo, return error .
     4734       end.
     4735       find first buf_goods no-lock where buf_goods.artic = p-artic
     4736                                      and buf_goods.prod-type = p-prod-type
     4737                                      and buf_goods.prod-code = p-prod-code
     4738                                      no-error .
     4739       if not available buf_goods
     4740       then do:
     4741         message
     4742           vss-workfile vss-revision vss-description skip
     4743           vss-include-info21 skip
     4744           "Ошибка задания входных параметров" skip
     4745           "Не найден товар" skip
     4746           "Документ" p-doc-code skip
     4747           "Объект" p-obj-type p-obj-code skip
     4748           "Артикул" p-artic p-prod-type p-prod-code skip
     4749           error-status :get-message(1) skip
     4750           return-value skip
     4751           view-as alert-box error .
     4752         undo, return error .
     4753       end.
     4754       if buf_trn-doc.ext-doc-type = 'vt':U
     4755       then do :
     4756           delete object v-tth no-error.
     4757           run adm/shattri.p (
     4758              input "get":U
     4759             ,input buf_trn-doc.obj-type
     4760             ,input buf_trn-doc.obj-code
     4761             ,input 'inv-obj':U
     4762             ,input  "izlcstpr"
     4763             ,output v-value-character
     4764             ,output v-value-date
     4765             ,output v-value-decimal
     4766             ,output v-value-integer
     4767             ,output v-izlcstpr
     4768             ,output v-type
     4769             ,INPUT-OUTPUT table-handle v-tth
     4770             ) no-error .
     4771             delete object v-tth no-error.
     4772           if error-status:error then do:
