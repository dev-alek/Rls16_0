     5245                   vss-include-info21 skip
     5246                   "Ошибка при создании партии" skip
     5247                   "Документ" buf_trn-doc.doc-code skip
     5248                   "Объект" archive_parts.obj-type archive_parts.obj-code skip
     5249                   "Артикул" archive_parts.artic archive_parts.prod-type archive_parts.prod-code skip
     5250                   "Партия" archive_parts.in-code archive_parts.part-code skip
     5251                   "Резерв" v-rsrv-code skip
     5252                   error-status :get-message(1) skip
     5253                   return-value skip
     5254                   view-as alert-box error .
     5255                 undo, return error .
     5256               end.
     5257               assign
     5258                 buf_parts.qnty      = buf_parts.qnty + abs(archive_parts.fact-qnty)
     5259                 buf_parts.fact-qnty = buf_parts.qnty
     5260               .
     5261               if v-goods-twounit = true
     5262               then do:
     5263                 define variable v-qnty-sign as integer   no-undo .
     5264                 assign
     5265                   v-qnty-sign = 1
     5266                 .
     5267                 if  buf_trn-doc.doc-type = 'инв':U
     5268                 and archive_parts.fact-qnty < 0
     5269                 then do:
     5270                   assign
     5271                     v-qnty-sign = - 1
     5272                   .
     5273                 end.
     5274                 if archive_parts.cli-qnty <> v-qnty-sign
     5275                 then do:
     5276                   message
     5277                     vss-workfile vss-revision vss-description skip
     5278                     vss-include-info21 skip
     5279                     "Клиентское количество для товара," skip
     5280                     "который учитывается по двум единицам измерения" skip
     5281                     "должно равняться" v-qnty-sign skip
     5282                     "Документ" p-doc-code skip
     5283                     "Объект" p-obj-type p-obj-code skip
     5284                     "Артикул" p-artic p-prod-type p-prod-code skip
     5285                     "Партия" archive_parts.in-code archive_parts.part-code skip
     5286                     "Количество по документу" archive_parts.qnty skip
     5287                     "Фактическое количество" archive_parts.fact-qnty skip
     5288                     "Клиентское количество" archive_parts.cli-qnty skip
     5289                     view-as alert-box error .
     5290                   undo, return error .
     5291                 end.
     5292                 if archive_parts.fact-qnty = archive_parts.qnty
     5293                 then do:
     5294                   assign
     5295                     buf_parts.cli-qnty = buf_parts.cli-qnty + abs(archive_parts.cli-qnty)
     5296                   .
     5297                 end.
     5298                 else do:
     5299                   message
     5300                     vss-workfile vss-revision vss-description skip
     5301                     vss-include-info21 skip
     5302                     "Фактическое количество для товара," skip
     5303                     "который учитывается по двум единицам измерения" skip
     5304                     "должно равняться нулю или количеству по документу" skip
     5305                     "Документ" p-doc-code skip
     5306                     "Объект" p-obj-type p-obj-code skip
     5307                     "Артикул" p-artic p-prod-type p-prod-code skip
     5308                     "Партия" archive_parts.in-code archive_parts.part-code skip
     5309                     "Количество по документу" archive_parts.qnty skip
     5310                     "Фактическое количество" archive_parts.fact-qnty skip
     5311                     "Клиентское количество" archive_parts.cli-qnty skip
     5312                     view-as alert-box error .
     5313                   undo, return error .
     5314                 end.
     5315               end.
     5316               else do:
     5317                 if buf_parts.cli-base-rate <> 0
     5318                 then do:
     5319                   assign
     5320                     buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     5321                   .
     5322                 end.
     5323                 else do:
     5324                   assign
     5325                     buf_parts.cli-qnty = 0
     5326                   .
     5327                 end.
     5328               end.
     5329               if  buf_parts.qnty      = 0
     5330               and buf_parts.fact-qnty = 0
     5331               then do:
     5332                 if v-goods-twounit = true
     5333                 then do:
     5334                   if buf_parts.cli-qnty <> 0
     5335                   then do:
     5336                     message
     5337                       vss-workfile vss-revision vss-description skip
     5338                       vss-include-info21 skip
     5339                       "Ошибка при удалении партии" skip
     5340                       "Документ" p-doc-code skip
     5341                       "Объект" p-obj-type p-obj-code skip
     5342                       "Артикул" p-artic p-prod-type p-prod-code skip
     5343                       "Партия" buf_parts.in-code buf_parts.part-code skip
     5344                       "Резерв" buf_parts.out-code skip
     5345                       "qnty" buf_parts.qnty skip
     5346                       "fact-qnty" buf_parts.fact-qnty skip
     5347                       "cli-qnty" buf_parts.cli-qnty skip
     5348                       view-as alert-box error .
     5349                     undo, return error .
     5350                   end.
     5351                 end.
     5352                 delete buf_parts .
     5353               end.
     5354             end.
     5355           end.
     5356           if  ( archive_parts.in-code = buf_trn-doc.doc-code
     5357           and archive_parts.supp-type =
     5358           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-type else buf_trn-doc.obj-type )
     5359           and archive_parts.supp-code =
     5360           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-code else buf_trn-doc.obj-code )
     5361           )
     5362           or buf_trn-doc.ext-doc-type = 'rv':U
     5363           then do:
     5364             if can-do('рас,спи':U,buf_trn-doc.doc-type)
     5365             or (buf_trn-doc.doc-type = 'инв':U
     5366                 and archive_parts.fact-qnty < 0
     5367               )
     5368             then do:
     5369               assign
     5370                 v-rsrv-code = 'free-zone':U
     5371               .
     5372             end.
     5373             else do:
     5374               assign
     5375                 v-rsrv-code = 'out-zone':U
     5376               .
     5377             end.
     5378             if not v-izlcstpr
     5379             then do :
     5380                 run partcopy in this-procedure
     5381                   (input  true
     5382                   ,input  v-rsrv-code
     5383                   ,buffer archive_parts
     5384                   ,buffer buf_parts
     5385                   ,input  ""
     5386                   ) no-error .
     5387                 if error-status :error
     5388                 then do:
     5389                   message
     5390                     vss-workfile vss-revision vss-description skip
     5391                     vss-include-info21 skip
     5392                     "Ошибка при создании партии" skip
     5393                     "Документ" p-doc-code skip
     5394                     "Объект" p-obj-type p-obj-code skip
     5395                     "Артикул" p-artic p-prod-type p-prod-code skip
     5396                     "Партия" archive_parts.in-code archive_parts.part-code skip
     5397                     "Резерв" v-rsrv-code skip
     5398                     error-status :get-message(1) skip
     5399                     return-value skip
     5400                     view-as alert-box error .
     5401                   undo, return error .
     5402                 end.
     5403                 assign
     5404                   buf_parts.qnty      = buf_parts.qnty - abs(archive_parts.fact-qnty)
     5405                   buf_parts.fact-qnty = buf_parts.qnty
     5406                 .
     5407                 if buf_trn-doc.ext-doc-type = 'rv':U
     5408                 then
     5409                 for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     5410                                                       and orig_marking-lines.obj-type   = archive_parts.obj-type
     5411                                                       and orig_marking-lines.obj-code   = archive_parts.obj-code
     5412                                                       and orig_marking-lines.in-code    = archive_parts.in-code
     5413                                                       and orig_marking-lines.out-code   = archive_parts.out-code
     5414                                                       and orig_marking-lines.part-code  = archive_parts.part-code
     5415                                                       and orig_marking-lines.prt-code   = archive_parts.prt-code,
     5416                 first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     5417                   if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
     5418                   then
     5419                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     5420                 end .
     5421                 if v-goods-twounit = true
     5422                 then do:
     5423                   message
     5424                     vss-workfile vss-revision vss-description skip
     5425                     vss-include-info21 skip
     5426                     "Запрещено порождение партий," skip
     5427                     "который учитывается по двум единицам измерения" skip
     5428                     "Документ" p-doc-code skip
     5429                     "Объект" p-obj-type p-obj-code skip
     5430                     "Артикул" p-artic p-prod-type p-prod-code skip
     5431                     "Партия" archive_parts.in-code archive_parts.part-code skip
     5432                     "Количество по документу" archive_parts.qnty skip
     5433                     "Фактическое количество" archive_parts.fact-qnty skip
     5434                     "Клиентское количество" archive_parts.cli-qnty skip
     5435                     view-as alert-box error .
     5436                   undo, return error .
     5437                 end.
     5438                 else do:
     5439                   if buf_parts.cli-base-rate <> 0
     5440                   then do:
     5441                     assign
     5442                       buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     5443                     .
     5444                   end.
     5445                   else do:
     5446                     assign
     5447                       buf_parts.cli-qnty = 0
     5448                     .
     5449                   end.
     5450                 end.
     5451             end.
     5452           end.
     5453           get next partcopy-select-parts .
     5454         end.
     5455       end.
     5456     end.
     5457   end procedure.
     5458   procedure partcopy-update-parts-delete :
     5459     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     5460     define input  parameter p-obj-type  like ub.doc-line.obj-type  no-undo .
     5461     define input  parameter p-obj-code  like ub.doc-line.obj-code  no-undo .
     5462     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     5463     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     5464     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     5465     define variable objMarks as class excisemarks no-undo.
     5466     define variable vss-description as character no-undo init "partcopy-update-parts-delete-01: процедура обработки партий при удалении документа".
     5467     define buffer buf_trn-doc    for ub.trn-doc .
     5468     define buffer archive_parts  for ub.parts .
     5469     define buffer buf_parts      for ub.parts .
     5470     define buffer buf_parts-attr for ub.parts-attr .
     5471     define variable v-rsrv-code as character no-undo .
     5472     define variable v-unrv-code as character no-undo .
     5473     define variable v-need-rsrv as logical   no-undo .
     5474     define variable v-need-unrv as logical   no-undo .
     5475     define variable v-rsrv-sign as integer   no-undo .
     5476     define variable v-unrv-sign as integer   no-undo .
     5477     define variable v-goods-twounit as logical   no-undo .
     5478     define variable v-value-character as character no-undo .
     5479     define variable v-value-date      as date no-undo .
     5480     define variable v-value-decimal   as decimal no-undo .
     5481     define variable v-value-integer   as integer no-undo .
     5482     define variable v-izlcstpr        as logical no-undo .
     5483     define variable v-tth             as handle no-undo .
     5484     define variable v-type            as character no-undo .
     5485     define buffer buf_marking-lines for ub.marking-lines .
     5486     define buffer del_marking-lines for ub.marking-lines .
     5487     define buffer free_marking-lines for ub.marking-lines .
     5488     define buffer buf_marking for ub.marking .
     5489     define buffer buf_marking-chk for ub.marking-chk .
     5490     define buffer buf_chk-doc for ub.chk-doc .
     5491     define variable part-key-rec as character no-undo .
     5492     define variable part-key-rec_arhive   as character no-undo .
     5493     define buffer buf1_gen-attr for ub.gen-attr .
     5494     do
     5495     on error undo, return error return-value
     5496     :
     5497       find first buf_trn-doc no-lock
     5498         where buf_trn-doc.doc-code = p-doc-code
     5499         no-error .
     5500       if not available buf_trn-doc
     5501       then do:
     5502         message
     5503           vss-workfile vss-revision vss-description skip
     5504           vss-include-info21 skip
     5505           "Ошибка задания входных параметров" skip
     5506           "Не найден документ" skip
     5507           "Документ" p-doc-code skip
     5508           "Объект" p-obj-type p-obj-code skip
     5509           "Артикул" p-artic p-prod-type p-prod-code skip
     5510           error-status :get-message(1) skip
     5511           return-value skip
     5512           view-as alert-box error .
     5513         undo, return error .
     5514       end.
     5515       if buf_trn-doc.ext-doc-type = 'vt':U
     5516       then do :
     5517           delete object v-tth no-error.
     5518           run adm/shattri.p (
     5519              input "get":U
     5520             ,input buf_trn-doc.obj-type
     5521             ,input buf_trn-doc.obj-code
     5522             ,input 'inv-obj':U
     5523             ,input  "izlcstpr"
     5524             ,output v-value-character
     5525             ,output v-value-date
     5526             ,output v-value-decimal
     5527             ,output v-value-integer
     5528             ,output v-izlcstpr
     5529             ,output v-type
     5530             ,INPUT-OUTPUT table-handle v-tth
     5531             ) no-error .
     5532             delete object v-tth no-error.
     5533           if error-status:error then do:
     5534             v-izlcstpr = false .
     5535           end.
     5536       end.
     5537       else do :
     5538           v-izlcstpr = false .
     5539       end.
     5540   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5541   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     5542     (input  p-artic
     5543     ,input  p-prod-type
     5544     ,input  p-prod-code
     5545     ,input  'twounit=request':u
     5546     ,output v-goods-twounit
     5547     ) no-error .
     5548       if error-status :error
     5549       then do:
     5550         message
     5551           vss-workfile vss-revision vss-description skip
     5552           vss-include-info21 skip
     5553           "Ошибка при определении атрибута товара" skip
     5554           "Артикул" p-artic p-prod-type p-prod-code skip
     5555           error-status :get-message(1) skip
     5556           return-value skip
     5557           view-as alert-box error .
     5558         undo, return error .
     5559       end.
     5560       define variable v-gds-code as integer   no-undo .
     5561   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5562   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     5563     (input  p-artic
     5564     ,input  p-prod-type
     5565     ,input  p-prod-code
     5566     ,output v-gds-code
     5567     ) no-error .
     5568       for each archive_parts
     5569         where archive_parts.obj-type  = p-obj-type
     5570           and archive_parts.obj-code  = p-obj-code
     5571           and archive_parts.artic     = p-artic
     5572           and archive_parts.prod-type = p-prod-type
     5573           and archive_parts.prod-code = p-prod-code
     5574           and archive_parts.out-code  = p-doc-code
     5575       on error undo, return error return-value
     5576       :
     5577         if archive_parts.fact-qnty <> 0
     5578         then do:
     5579           define variable v-create-part as logical   no-undo .
     5580           define variable v-old-return  as logical   no-undo .
     5581           assign
     5582             v-create-part = false
     5583             v-old-return  = false
     5584           .
     5585           if archive_parts.in-code = buf_trn-doc.doc-code
     5586           then do:
     5587             assign
     5588               v-create-part = true
     5589             .
     5590             if archive_parts.supp-type <>
     5591           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-type else buf_trn-doc.obj-type )
     5592             or archive_parts.supp-code <>
     5593           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-code else buf_trn-doc.obj-code )
     5594             then do:
     5595               assign
     5596                 v-old-return = true
     5597               .
     5598             end.
     5599           end.
     5600           define variable v-is-hold as logical   no-undo .
     5601   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5602   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     5603     (input  buf_trn-doc.doc-code
     5604     ,output v-is-hold
     5605     ) no-error .
     5606           if error-status :error
     5607           then do:
     5608             message
     5609               vss-workfile vss-revision vss-description skip
     5610               vss-include-info21
     5611               "Ошибка при определении типа документа hold-doc.i" skip
     5612               "Документ" p-doc-code skip
     5613               "Объект" p-obj-type p-obj-code skip
     5614               "Артикул" p-artic p-prod-type p-prod-code skip
     5615               error-status :get-message(1) skip
     5616               return-value skip
     5617               view-as alert-box error .
     5618             undo, return error .
     5619           end.
     5620   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partcond in g#library
     5621     (input  buf_trn-doc.ext-doc-type
     5622     ,input  v-is-hold
     5623     ,input  archive_parts.fact-qnty
     5624     ,input  v-create-part
     5625     ,input  v-old-return
     5626     ,output v-rsrv-code
     5627     ,output v-unrv-code
     5628     ,output v-need-rsrv
     5629     ,output v-need-unrv
     5630     ,output v-rsrv-sign
     5631     ,output v-unrv-sign
     5632     ) no-error .
     5633           if error-status :error
     5634           then do:
     5635             message
     5636               vss-workfile vss-revision vss-description skip
     5637               vss-include-info21
     5638               "Ошибка при определении параметров резервирования партии" skip
     5639               "Документ" p-doc-code skip
     5640               "Объект" p-obj-type p-obj-code skip
     5641               "Артикул" p-artic p-prod-type p-prod-code skip
     5642               error-status :get-message(1) skip
     5643               return-value skip
     5644               view-as alert-box error .
     5645             undo, return error .
     5646           end.
     5647           if v-izlcstpr and archive_parts.fact-qnty > 0 then v-need-unrv = false .
     5648           if v-need-rsrv = true
     5649           then do:
     5650             release buf_parts no-error .
     5651             if archive_parts.out-code <> v-rsrv-code and v-rsrv-sign = -1 and v-izlcstpr
     5652             then do:
     5653                 find first buf_parts exclusive-lock
     5654                   where buf_parts.obj-type  = archive_parts.obj-type
     5655                     and buf_parts.obj-code  = archive_parts.obj-code
     5656                     and buf_parts.artic     = archive_parts.artic
     5657                     and buf_parts.prod-type = archive_parts.prod-type
     5658                     and buf_parts.prod-code = archive_parts.prod-code
     5659                     and buf_parts.in-code   = archive_parts.out-code
     5660                     and buf_parts.out-code  = v-rsrv-code
     5661                     and buf_parts.part-code = archive_parts.part-code
     5662                   no-error.
     5663             end .
     5664             if not available  buf_parts
     5665             then do :
     5666                 run partcopy in this-procedure
     5667                   (input  true
     5668                   ,input  v-rsrv-code
     5669                   ,buffer archive_parts
     5670                   ,buffer buf_parts
     5671                   ,input  ""
     5672                   ) no-error .
     5673                 if error-status :error
     5674                 then do:
     5675                   message
     5676                     vss-workfile vss-revision vss-description skip
     5677                     vss-include-info21 skip
     5678                     "Ошибка при создании партии" skip
     5679                     "Документ" p-doc-code skip
     5680                     "Объект" p-obj-type p-obj-code skip
     5681                     "Артикул" p-artic p-prod-type p-prod-code skip
     5682                     "Партия" archive_parts.in-code archive_parts.part-code skip
     5683                     "Необходимо резервировать" v-need-rsrv skip
     5684                     "Резерв" v-rsrv-code skip
     5685                     "Необходимо снятие резервов" v-need-unrv skip
     5686                     "Снятие резервов" v-unrv-code skip
     5687                     error-status :get-message(1) skip
     5688                     return-value skip
     5689                     view-as alert-box error .
     5690                   undo, return error .
     5691                 end.
     5692             end.
     5693             if new(buf_parts)
     5694             then do:
     5695   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5696   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
