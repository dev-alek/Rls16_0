     1293   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1294   procedure trndocgs :
     1295     define input  parameter p-doc-code      like ub.doc-line.doc-code  no-undo .
     1296     define input  parameter p-artic         like ub.doc-line.artic     no-undo .
     1297     define input  parameter p-prod-type     like ub.doc-line.prod-type no-undo .
     1298     define input  parameter p-prod-code     like ub.doc-line.prod-code no-undo .
     1299     define input  parameter p-root-node     like ub.prt-obj.prt-code  no-undo .
     1300     define input  parameter p-news          as logical no-undo .
     1301     define input  parameter p-trn-doc-close as logical   no-undo .
     1302     define input  parameter p-update-host   as logical no-undo .
     1303     define buffer buf_db       for ub.db .
     1304     define buffer buf_trn-doc  for ub.trn-doc .
     1305     define buffer buf_doc-line for ub.doc-line .
     1306     define buffer buf_gds-dtl  for ub.gds-dtl .
     1307     define buffer buf_gds-obj  for ub.gds-obj .
     1308     define buffer buf_prt-obj  for ub.prt-obj .
     1309     define buffer buf_goods    for ub.goods .
     1310     define buffer buf_gds-prt  for ub.gds-prt .
     1311     define buffer buf_pl-gds   for ub.pl-gds .
     1312     define buffer buf_doc-pl   for ub.doc-pl .
     1313     define variable v-obj-type      like ub.gds-obj.obj-type  no-undo .
     1314     define variable v-obj-code      like ub.gds-obj.obj-code  no-undo .
     1315     define variable curr-node       like ub.gds-prt.node-code no-undo .
     1316     define variable l-need-rsrv     as logical                no-undo .
     1317     define variable l-goods-twounit as logical                no-undo .
     1318     define variable v-cmd           as character              no-undo .
     1319     define variable v-curr-db-num   like ub.db.db-num         no-undo .
     1320     define variable v-update-sign   as decimal   no-undo .
     1321     define variable v-doc-sign      as decimal   no-undo .
     1322     do
     1323     on error undo, return error return-value
     1324     :
     1325       if p-trn-doc-close = true
     1326       then do:
     1327         assign
     1328           v-update-sign = 1.0
     1329         .
     1330       end.
     1331       else do:
     1332         assign
     1333           v-update-sign = -1.0
     1334         .
     1335       end.
     1336       find first buf_doc-line no-lock
     1337         where buf_doc-line.doc-code  = p-doc-code
     1338           and buf_doc-line.artic     = p-artic
     1339           and buf_doc-line.prod-type = p-prod-type
     1340           and buf_doc-line.prod-code = p-prod-code
     1341         no-error .
     1342       if not available buf_doc-line
     1343       then do:
     1344         message
     1345           vss-workfile vss-revision vss-description skip
     1346           "Не найдена строка документа" skip
     1347           "Документ" p-doc-code skip
     1348           "Товар" p-artic p-prod-code p-prod-type skip
     1349           view-as alert-box error .
     1350         undo, return error return-value .
     1351       end.
     1352       if buf_doc-line.fact-order = ?
     1353       or buf_doc-line.fact-order = 0
     1354       then do:
     1355         message
     1356           vss-workfile vss-revision vss-description skip
     1357           "Не задан логический номер строки документа" skip
     1358           "Документ" buf_doc-line.doc-code skip
     1359           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     1360           "Логический номер документа" buf_doc-line.fact-order skip
     1361           view-as alert-box error .
     1362         undo, return error return-value .
     1363       end.
     1364       find first buf_goods no-lock
     1365         where buf_goods.artic     = p-artic
     1366           and buf_goods.prod-type = p-prod-type
     1367           and buf_goods.prod-code = p-prod-code
     1368         .
     1369       assign
     1370         v-obj-type  = buf_doc-line.obj-type
     1371         v-obj-code  = buf_doc-line.obj-code
     1372       .
     1373       find first buf_trn-doc no-lock
     1374         where buf_trn-doc.doc-code = p-doc-code
     1375         no-error .
     1376       if not available buf_trn-doc
     1377       then do:
     1378         message
     1379           vss-workfile vss-revision vss-description skip
     1380           "Не найден документ" skip
     1381           "Документ" p-doc-code skip
     1382           view-as alert-box error .
     1383         undo, return error return-value .
     1384       end.
     1385   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1386   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscr in g#library
     1387     (input  buf_doc-line.obj-type
     1388     ,input  buf_doc-line.obj-code
     1389     ,input  buf_doc-line.artic
     1390     ,input  buf_doc-line.prod-type
     1391     ,input  buf_doc-line.prod-code
     1392     ,input  p-root-node
     1393     ,buffer buf_gds-obj
     1394     ,buffer buf_prt-obj
     1395     ) no-error .
     1396       if error-status :error
     1397       then do:
     1398         message
