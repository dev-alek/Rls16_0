     1400           "Ошибка при создании информации о товаре на фирме" skip
     1401           error-status :get-message(1) skip
     1402           view-as alert-box error .
     1403         undo, return error return-value .
     1404       end.
     1405       find current buf_gds-obj exclusive-lock .
     1406   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1407   if  buf_gds-obj.first-doc <> ?
     1408   and buf_gds-obj.first-doc > buf_trn-doc.fact-date then do:
     1409     assign
     1410       buf_gds-obj.first-doc  = buf_trn-doc.fact-date
     1411     .
