      778   procedure trndocrs-pl-gds-accum :
      779     define input parameter p-pl-code       like ub.pl-gds.pl-code       no-undo .
      780     define input parameter p-rsrv-qnty     like ub.pl-gds.free-qnty     no-undo .
      781     define input parameter p-cli-rsrv-qnty like ub.pl-gds.cli-free-qnty no-undo .
      782     define input parameter p-fact-qnty     like ub.pl-gds.fact-qnty     no-undo .
      783     define input parameter p-cli-fact-qnty like ub.pl-gds.cli-fact-qnty no-undo .
      784     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      785     do
      786     on error undo, return error return-value
      787     :
      788       find first buf_temp-trndocrs-pl-gds-rsrv
      789         where buf_temp-trndocrs-pl-gds-rsrv.pl-code = p-pl-code
      790         no-error .
      791       if not available buf_temp-trndocrs-pl-gds-rsrv then do:
      792         create buf_temp-trndocrs-pl-gds-rsrv .
      793         assign
      794           buf_temp-trndocrs-pl-gds-rsrv.pl-code = p-pl-code
      795         .
      796       end.
      797       assign
      798         buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty     = buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty     + p-rsrv-qnty
      799         buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty = buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty + p-cli-rsrv-qnty
      800         buf_temp-trndocrs-pl-gds-rsrv.fact-qnty     = buf_temp-trndocrs-pl-gds-rsrv.fact-qnty     + p-fact-qnty
      801         buf_temp-trndocrs-pl-gds-rsrv.cli-fact-qnty = buf_temp-trndocrs-pl-gds-rsrv.cli-fact-qnty + p-cli-fact-qnty
      802       .
      803     end.
      804   end procedure.
      805   procedure trndocrs-gds-dtl-accum :
      806     define input parameter p-prt-code   like ub.gds-dtl.prt-code   no-undo .
      807     define input parameter p-rsrv-qnty like ub.gds-dtl.fact-qnty no-undo .
      808     define buffer buf_temp-trndocrs-gds-dtl-rsrv  for temp-trndocrs-gds-dtl-rsrv .
      809     do
      810     on error undo, return error return-value
      811     :
      812       find first buf_temp-trndocrs-gds-dtl-rsrv
      813         where buf_temp-trndocrs-gds-dtl-rsrv.prt-code = p-prt-code
      814         no-error .
      815       if not available buf_temp-trndocrs-gds-dtl-rsrv then do:
      816         create buf_temp-trndocrs-gds-dtl-rsrv .
      817         assign
      818           buf_temp-trndocrs-gds-dtl-rsrv.prt-code = p-prt-code
      819         .
      820       end.
      821       assign
      822         buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty = buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
      823                                                + p-rsrv-qnty
      824       .
      825     end.
      826   end procedure.
      827   procedure trndocrs-pl-gds-request :
      828     define input parameter p-doc-code               like ub.doc-line.doc-code  no-undo .
      829     define input parameter p-doc-type               like ub.trn-doc.doc-type   no-undo .
      830     define input parameter p-obj-type               like ub.doc-line.obj-type  no-undo .
      831     define input parameter p-obj-code               like ub.doc-line.obj-code  no-undo .
      832     define input parameter p-artic                  like ub.doc-line.artic     no-undo .
      833     define input parameter p-prod-type              like ub.doc-line.prod-type no-undo .
      834     define input parameter p-prod-code              like ub.doc-line.prod-code no-undo .
      835     define input parameter p-field-accum            as character no-undo .
      836     define variable vss-description as character no-undo init "trndocrs-pl-gds-request: Сбор информации о партиях на складских местах".
      837     define buffer buf_temp-trndocrs-pl-gds-rsrv for temp-trndocrs-pl-gds-rsrv .
      838     do
      839     on error undo, return error return-value
      840     :
      841       if lookup(p-field-accum, "before,after":u ) = 0 then do:
      842         message
      843           vss-workfile vss-revision vss-description skip
      844           vss-include-info4 skip
      845           "Ошибка задания входных параметров параметров" skip
      846           "Неизвестное значение параметра" skip
      847           "p-field-accum" p-field-accum skip
      848           view-as alert-box error .
      849         undo, return error return-value .
      850       end.
      851       case p-field-accum :
      852         when "before":u then do:
      853           for each buf_temp-trndocrs-pl-gds-rsrv
      854           on error undo, return error return-value
      855           :
      856             assign
      857               buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty = 0
      858               buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty  = 0
      859             .
      860           end.
      861         end.
      862         when "after":u then do:
      863           for each buf_temp-trndocrs-pl-gds-rsrv
      864           on error undo, return error return-value
      865           :
      866             assign
      867               buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty  = 0
      868               buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty   = 0
      869             .
      870           end.
      871         end.
      872         otherwise do:
      873           message
      874             vss-workfile vss-revision vss-description skip
      875             vss-include-info4 skip
      876             "Ошибка задания входных параметров параметров" skip
      877             "Неизвестное значение параметра" skip
      878             "p-field-accum" p-field-accum skip
      879             view-as alert-box error .
      880           undo, return error return-value .
      881         end.
      882       end.
      883       define buffer buf_parts for ub.parts.
      884       for each buf_parts no-lock
      885         where buf_parts.out-code  = p-doc-code
      886           and buf_parts.obj-type  = p-obj-type
      887           and buf_parts.obj-code  = p-obj-code
      888           and buf_parts.artic     = p-artic
      889           and buf_parts.prod-type = p-prod-type
      890           and buf_parts.prod-code = p-prod-code
      891       on error undo, return error return-value
      892       :
      893         find first buf_temp-trndocrs-pl-gds-rsrv
      894           where buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_parts.pl-code
      895           no-error .
      896         if not available buf_temp-trndocrs-pl-gds-rsrv then do:
      897           create buf_temp-trndocrs-pl-gds-rsrv .
      898           assign
      899             buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_parts.pl-code
      900           .
      901         end.
      902         if can-do('при,рас,спи':U, p-doc-type)
      903         or (p-doc-type = 'инв':U
      904             and buf_parts.fact-qnty < 0)
      905         then do:
      906           case p-field-accum :
      907             when "before":u then do:
      908               assign
      909                 buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
      910                   = buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
      911                   + abs(buf_parts.fact-qnty)
      912               .
      913             end.
      914             when "after":u then do:
      915               assign
      916                 buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
      917                   = buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
      918                   + abs(buf_parts.fact-qnty)
      919               .
      920             end.
      921             otherwise do:
      922               message
      923                 vss-workfile vss-revision vss-description skip
      924                 vss-include-info4 skip
      925                 "Ошибка задания входных параметров параметров" skip
      926                 "Неизвестное значение параметра" skip
      927                 "p-field-accum" p-field-accum skip
      928                 view-as alert-box error .
      929               undo, return error return-value .
      930             end.
      931           end.
      932         end.
      933         else do:
      934           case p-field-accum :
      935             when "before":u then do:
      936               assign
      937                 buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
      938                   = buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
      939                   + abs(buf_parts.fact-qnty)
      940               .
      941             end.
      942             when "after":u then do:
      943               assign
      944                 buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
      945                   = buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
      946                   + abs(buf_parts.fact-qnty)
      947               .
      948             end.
      949             otherwise do:
      950               message
      951                 vss-workfile vss-revision vss-description skip
      952                 vss-include-info4 skip
      953                 "Ошибка задания входных параметров параметров" skip
      954                 "Неизвестное значение параметра" skip
      955                 "p-field-accum" p-field-accum skip
      956                 view-as alert-box error .
      957               undo, return error return-value .
      958             end.
      959           end.
      960         end.
      961       end.
      962     end.
      963   end procedure.
      964   procedure trndocrs-pl-gds-calc-rsrv :
      965     define variable vss-description as character no-undo init "trndocrs-pl-gds-calc-rsrv: Сбор информации о партиях на складских местах".
      966     define buffer buf_temp-trndocrs-pl-gds-rsrv for temp-trndocrs-pl-gds-rsrv .
      967     do
      968     on error undo, return error return-value
      969     :
      970       for each buf_temp-trndocrs-pl-gds-rsrv
      971       on error undo, return error return-value
      972       :
      973         assign
      974           buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
      975             = buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
      976             - buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
      977           buf_temp-trndocrs-pl-gds-rsrv.rsrv-out-qnty
      978             = buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
      979             - buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
      980         .
      981       end.
      982     end.
      983   end procedure.
      984   procedure trndocrs-need-rsrv :
      985     define input  parameter p-doc-type     like ub.trn-doc.doc-type no-undo .
      986     define input  parameter p-artic        like ub.doc-line.artic     no-undo .
      987     define input  parameter p-prod-type    like ub.doc-line.prod-type no-undo .
      988     define input  parameter p-prod-code    like ub.doc-line.prod-code no-undo .
      989     define output parameter p-need-rsrv    as logical   no-undo .
      990     define buffer buf_goods   for ub.goods .
      991     do
      992     on error undo, return error return-value
      993     :
      994       find first buf_goods no-lock
      995         where buf_goods.artic     = p-artic
      996           and buf_goods.prod-type = p-prod-type
      997           and buf_goods.prod-code = p-prod-code
      998         .
      999       if buf_goods.gds-type = 'т':U
     1000       and ( p-doc-type = 'рас':U
     1001             or p-doc-type = 'спи':U
     1002           )
     1003       then do:
     1004         assign
     1005           p-need-rsrv = true
     1006         .
     1007       end.
     1008       else do:
     1009         assign
     1010           p-need-rsrv = false
     1011         .
     1012       end.
     1013     end.
     1014   end procedure.
     1015   procedure trndocrs-need-create-doc-pl :
     1016     define input  parameter p-extended-doc-type  as character no-undo .
     1017     define input  parameter p-news               as logical   no-undo .
     1018     define input  parameter p-sale-auto          as logical   no-undo .
     1019     define output parameter p-need-create-doc-pl as logical   no-undo .
     1020     do
     1021     on error undo, return error return-value
     1022     :
     1023       if  not p-news
     1024       and p-extended-doc-type <> 'ie':U
     1025       and p-extended-doc-type <> 'es':U
     1026       and p-extended-doc-type <> 'rs':U
     1027       and not p-sale-auto
     1028       then do:
     1029         assign
     1030           p-need-create-doc-pl = true
     1031         .
     1032       end.
     1033       else do:
     1034         assign
     1035           p-need-create-doc-pl = false
     1036         .
     1037       end.
     1038     end.
     1039   end procedure.
     1040   procedure trndocrs-validate :
     1041     define input parameter p-place-rsrv as logical no-undo .
     1042     define input parameter p-chg-qnty   as decimal no-undo .
     1043     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
     1044     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
     1045     define variable v-total-gds-dtl-rsrv-qnty as decimal no-undo .
     1046     define variable v-total-pl-gds-rsrv-qnty as decimal no-undo .
     1047     assign
     1048       v-total-gds-dtl-rsrv-qnty = 0
     1049       v-total-pl-gds-rsrv-qnty  = 0
     1050     .
     1051     do
     1052     on error undo, return error return-value
     1053     :
     1054       for each buf_temp-trndocrs-gds-dtl-rsrv
     1055       on error undo, return error return-value
     1056       :
     1057         assign
     1058           v-total-gds-dtl-rsrv-qnty = v-total-gds-dtl-rsrv-qnty
     1059                                     + buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
     1060         .
     1061       end.
     1062       for each buf_temp-trndocrs-pl-gds-rsrv
     1063       on error undo, return error return-value
     1064       :
     1065         assign
     1066           v-total-pl-gds-rsrv-qnty = v-total-pl-gds-rsrv-qnty
     1067                                    + buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
     1068         .
     1069       end.
     1070       if round(v-total-gds-dtl-rsrv-qnty, 0) <> round(p-chg-qnty, 0) then do:
     1071         message
     1072           vss-workfile vss-revision vss-description skip
     1073           vss-include-info4 skip
     1074           "Ошибка при резервировании свободных количеств" skip
     1075           "Запрошено резервирование:" skip
     1076           "По товару" p-chg-qnty skip
     1077           "По признакам" v-total-gds-dtl-rsrv-qnty skip
     1078           "По складским местам" v-total-pl-gds-rsrv-qnty skip
     1079           view-as alert-box error .
     1080         undo, return error return-value .
     1081       end.
     1082       if p-place-rsrv then do:
     1083         if round(v-total-pl-gds-rsrv-qnty, 0) <> round(p-chg-qnty, 0) then do:
     1084           message
     1085             vss-workfile vss-revision vss-description skip
     1086             vss-include-info4 skip
     1087             "Ошибка при резервировании свободных количеств" skip
     1088             "Запрошено резервирование:" skip
     1089             "По товару" p-chg-qnty skip
     1090             "По признакам" v-total-gds-dtl-rsrv-qnty skip
     1091             "По складским местам" v-total-pl-gds-rsrv-qnty skip
     1092             view-as alert-box error .
     1093           undo, return error return-value .
     1094         end.
     1095       end.
     1096     end.
     1097   end procedure.
     1098   procedure trndocrs :
     1099     define input parameter p-doc-code   like ub.doc-line.doc-code  no-undo .
     1100     define input parameter p-obj-type   like ub.doc-line.obj-type  no-undo .
     1101     define input parameter p-obj-code   like ub.doc-line.obj-code  no-undo .
     1102     define input parameter p-artic      like ub.doc-line.artic     no-undo .
     1103     define input parameter p-prod-type  like ub.doc-line.prod-type no-undo .
     1104     define input parameter p-prod-code  like ub.doc-line.prod-code no-undo .
     1105     define input parameter p-chg-qnty   as decimal no-undo .
     1106     define buffer buf_db         for ub.db .
     1107     define buffer buf_gds-obj    for ub.gds-obj .
     1108     define buffer buf_prt-obj    for ub.prt-obj .
     1109     define buffer buf_gds-prt    for ub.gds-prt .
     1110     define buffer buf_goods      for ub.goods .
     1111     define buffer buf_pl-gds     for ub.pl-gds .
     1112     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
     1113     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
     1114     define variable v-node-code   like ub.gds-prt.node-code no-undo .
     1115     define variable v-curr-db-num like ub.db.db-num         no-undo .
     1116     define variable v-cmd         as   character            no-undo .
     1117     do
     1118     on error undo, return error return-value
     1119     :
     1120   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1121   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1122     (input  p-obj-type
     1123     ,input  p-obj-code
     1124     ,input  p-artic
     1125     ,input  p-prod-type
     1126     ,input  p-prod-code
     1127     ,buffer buf_gds-obj
     1128     ) no-error .
     1129       if error-status :error then do:
     1130         message
     1131           vss-workfile vss-revision vss-description skip
     1132           vss-include-info4 skip
     1133           "Ошибка при поиске товара на объекте" skip
     1134           "p-obj-type"  p-obj-type  skip
     1135           "p-obj-code"  p-obj-code  skip
     1136           "p-artic"     p-artic     skip
     1137           "p-prod-type" p-prod-type skip
     1138           "p-prod-code" p-prod-code skip
     1139           error-status :get-message(1) skip
     1140           return-value skip
     1141           view-as alert-box error .
     1142         undo, return error return-value .
     1143       end.
     1144       find current buf_gds-obj exclusive-lock .
     1145       run trndocrs-validate in this-procedure
     1146         (input buf_gds-obj.place-rsrv
     1147         ,input p-chg-qnty
     1148         ) no-error .
     1149       if error-status :error then do:
     1150         message
     1151           vss-workfile vss-revision vss-description skip
     1152           vss-include-info4 skip
     1153           "Противоречивые данные для резервирования" skip
     1154           error-status :get-message(1) skip
     1155           return-value skip
     1156           view-as alert-box error .
     1157         undo, return error return-value .
     1158       end.
     1159       assign
     1160         buf_gds-obj.free-qnty   = buf_gds-obj.free-qnty - p-chg-qnty
     1161         buf_gds-obj.on-line-rest = buf_gds-obj.free-qnty
     1162       .
     1163   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
     1164     (input ?
     1165     ,input this-procedure:handle
     1166     ,input ?
     1167     ,input  'rest-update':U
     1168     ,input ?
     1169     ,input  buffer buf_gds-obj:handle
     1170     ,input 'fact-qnty,free-qnty'
     1171     ,input ''
     1172     ) no-error .
     1173   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1174   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1175     (output v-curr-db-num
     1176     )  .
     1177       find first buf_db no-lock
     1178         where buf_db.db-num = v-curr-db-num
     1179         .
     1180       if buf_db.db-num <> 0
     1181         and buf_db.on-line-rest = true
     1182       then do:
     1183         assign
     1184           v-cmd = "command":U + chr(1)
     1185                   + "create":U + chr(1)
     1186                   + "on-line-rest":U + chr(1)
     1187                   + substitute( "&1", buf_gds-obj.obj-type ) + chr(1)
     1188                   + substitute( "&1", buf_gds-obj.obj-code ) + chr(1)
     1189                   + substitute( "&1", buf_gds-obj.artic ) + chr(1)
     1190                   + substitute( "&1", buf_gds-obj.prod-type ) + chr(1)
     1191                   + substitute( "&1", buf_gds-obj.prod-code ) + chr(1)
     1192                   + substitute( "&1", buf_gds-obj.free-qnty ) + chr(1)
     1193         .
     1194         run nws/cr-route.p
     1195           ( input 'send-cmd':U
     1196             ,input v-cmd
     1197             ,input ?
     1198             ,input "0":U
     1199           ).
     1200       end.
     1201       if buf_gds-obj.place-rsrv = true then do:
     1202         for each buf_temp-trndocrs-pl-gds-rsrv
     1203         on error undo, return error return-value
     1204         :
     1205           find first buf_goods no-lock
     1206             where buf_goods.artic     = p-artic
     1207               and buf_goods.prod-type = p-prod-type
     1208               and buf_goods.prod-code = p-prod-code
     1209             no-error .
     1210           if not available buf_goods then do:
     1211             message
     1212               vss-workfile vss-revision vss-description skip
     1213               vss-include-info4 skip
     1214               "Не найдена товар" skip
     1215               "Артикул" p-artic p-prod-type p-prod-code skip
     1216               view-as alert-box error .
     1217             undo, return error return-value .
     1218           end.
     1219           find first buf_pl-gds exclusive-lock
     1220             where buf_pl-gds.obj-type = p-obj-type
     1221               and buf_pl-gds.obj-code = p-obj-code
     1222               and buf_pl-gds.gds-code = buf_goods.gds-code
     1223               and buf_pl-gds.pl-code  = buf_temp-trndocrs-pl-gds-rsrv.pl-code
     1224             no-error .
     1225           if not available buf_pl-gds then do:
     1226             message
     1227               vss-workfile vss-revision vss-description skip
     1228               vss-include-info4 skip
     1229               "Не найдена привязка товара к складскому месту" skip
     1230               "Код товара" buf_temp-trndocrs-pl-gds-rsrv.pl-code skip
     1231               view-as alert-box error .
     1232             undo, return error return-value .
     1233           end.
     1234           assign
     1235             buf_pl-gds.free-qnty     = buf_pl-gds.free-qnty     - buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
     1236             buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-free-qnty - buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty
     1237           .
     1238           if buf_pl-gds.free-qnty = buf_pl-gds.fact-qnty
     1239             and absolute( buf_pl-gds.cli-free-qnty - buf_pl-gds.cli-fact-qnty ) <= 0.01
     1240           then do:
     1241             assign
     1242               buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-fact-qnty
     1243             .
     1244           end.
     1245         end.
     1246       end.
     1247       for each buf_temp-trndocrs-gds-dtl-rsrv
     1248       on error undo, return error return-value
     1249       :
     1250   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     1251     (input  buf_temp-trndocrs-gds-dtl-rsrv.prt-code
     1252     ,output v-node-code
     1253     ) no-error .
     1254         if error-status :error then do:
     1255           message
     1256             vss-workfile vss-revision vss-description skip
     1257             vss-include-info4 skip
     1258             "Ошибка при определении первого терминального признака" skip
     1259             "prt-code" buf_temp-trndocrs-gds-dtl-rsrv.prt-code skip
     1260             view-as alert-box error .
     1261           undo, return error return-value .
     1262         end.
     1263         find first buf_gds-prt no-lock
     1264           where buf_gds-prt.node-code = v-node-code
     1265           .
     1266         do while available buf_gds-prt
     1267         on error undo, return error return-value
     1268         :
     1269   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1270   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtobjcr in g#library
     1271     (input  p-obj-type
     1272     ,input  p-obj-code
     1273     ,input  p-artic
     1274     ,input  p-prod-type
     1275     ,input  p-prod-code
     1276     ,input  buf_gds-prt.node-code
     1277     ,buffer buf_prt-obj
     1278     )  .
     1279           find current buf_prt-obj exclusive-lock .
     1280           assign
