     6110                     free_marking-lines.out-code   = buf_parts.out-code
     6111                     free_marking-lines.part-code  = buf_parts.part-code
     6112                     free_marking-lines.prt-code   = buf_parts.prt-code
     6113                   .
     6114                 end .
     6115                 if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U and buf_trn-doc.doc-type <> 'спи':U and
     6116                    not (buf_marking.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U)
     6117                   then assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     6118                 if buf_trn-doc.ext-doc-type = 'es':U
     6119                 then do :
     6120                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:SaleLock:KeyIntDB .
     6121                 end .
     6122                 for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     6123                   assign buf_marking-chk.sts = 0 .
     6124                 end .
     6125               end .
     6126               delete buf_marking-lines .
     6127             end.
     6128             if v-goods-twounit = true
     6129             then do:
     6130               assign
     6131                 buf_parts.cli-qnty = buf_parts.cli-qnty + v-unrv-sign * archive_parts.cli-qnty
     6132               .
     6133             end.
     6134             else do:
     6135               if buf_parts.cli-base-rate <> 0
     6136               then do:
     6137                 assign
     6138                   buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     6139                 .
     6140               end.
     6141               else do:
     6142                 assign
     6143                   buf_parts.cli-qnty = 0
     6144                 .
     6145               end.
     6146             end.
     6147             if  buf_parts.qnty      = 0
     6148             and buf_parts.fact-qnty = 0
     6149             then do:
     6150               if v-goods-twounit = true
     6151               then do:
     6152                 if buf_parts.cli-qnty <> 0
     6153                 then do:
     6154                   message
     6155                     vss-workfile vss-revision vss-description skip
     6156                     vss-include-info21 skip
     6157                     "Ошибка при удалении партии" skip
     6158                     "Документ" p-doc-code skip
     6159                     "Объект" p-obj-type p-obj-code skip
     6160                     "Артикул" p-artic p-prod-type p-prod-code skip
     6161                     "Партия" buf_parts.in-code buf_parts.part-code skip
     6162                     "Резерв" buf_parts.out-code skip
     6163                     "qnty" buf_parts.qnty skip
     6164                     "fact-qnty" buf_parts.fact-qnty skip
     6165                     "cli-qnty" buf_parts.cli-qnty skip
     6166                     view-as alert-box error .
     6167                   undo, return error .
     6168                 end.
     6169               end.
     6170               for each del_marking-lines exclusive-lock where del_marking-lines.gds-code = v-gds-code
     6171                                                           and del_marking-lines.obj-type = buf_parts.obj-type
     6172                                                           and del_marking-lines.obj-code = buf_parts.obj-code
     6173                                                           and del_marking-lines.in-code = buf_parts.in-code
     6174                                                           and del_marking-lines.out-code = buf_parts.out-code
     6175                                                           and del_marking-lines.part-code = buf_parts.part-code
     6176                                                           and del_marking-lines.prt-code = buf_parts.prt-code:
     6177                 delete del_marking-lines .
     6178               end.
     6179               run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     6180                                           ,input (buffer buf_parts:handle)
     6181                                           ,output part-key-rec).
     6182               for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     6183                                        and ub.gen-attr.p-key =  part-key-rec
     6184               :
     6185                 find first buf1_gen-attr no-lock where recid (buf1_gen-attr) = recid (ub.gen-attr).
     6186                 find current buf1_gen-attr exclusive-lock.
     6187                 delete buf1_gen-attr .
     6188               end.
     6189               delete buf_parts .
     6190             end.
     6191           end.
     6192         end.
     6193       end.
     6194     end.
     6195   end procedure.
     6196   procedure partcopy-rsrv-parts :
     6197     define input  parameter p-doc-code-rowid as rowid no-undo .
     6198     define input  parameter p-parts-rowid    as rowid no-undo .
     6199     define input  parameter p-rsrv-direction as logical   no-undo .
     6200     define input  parameter p-goods-twounit  as logical   no-undo .
     6201     define input  parameter p-is-hold        as logical   no-undo .
     6202     define variable vss-description as character no-undo init "partcopy-rsrv-parts-01: процедура обработки партий при удалении документа".
     6203     define buffer buf_trn-doc for ub.trn-doc .
     6204     define buffer archive_parts for ub.parts .
     6205     define buffer buf_parts   for ub.parts .
     6206     define buffer orig_marking-lines for ub.marking-lines .
     6207     define buffer buf_marking-lines for ub.marking-lines .
     6208     define buffer buf_marking   for ub.marking .
     6209     define buffer buf_goods for ub.goods .
     6210     define variable v-rsrv-code as character no-undo .
     6211     do
     6212     on error undo, return error return-value
     6213     :
     6214       find first buf_trn-doc no-lock
     6215         where rowid(buf_trn-doc) = p-doc-code-rowid
     6216         no-error .
     6217       if not available buf_trn-doc
     6218       then do:
     6219         message
     6220           vss-workfile vss-revision vss-description skip
     6221           vss-include-info21 skip
     6222           "Ошибка задания входных параметров" skip
     6223           "Не найден документ" skip
     6224           "Документ" string(p-doc-code-rowid) skip
     6225           "Партия" string(p-parts-rowid) skip
     6226           error-status :get-message(1) skip
     6227           return-value skip
     6228           view-as alert-box error .
     6229         undo, return error .
     6230       end.
     6231       find first archive_parts
     6232         where rowid(archive_parts) = p-parts-rowid
     6233         no-error .
     6234       if not available archive_parts
     6235       then do:
     6236         message
     6237           vss-workfile vss-revision vss-description skip
     6238           vss-include-info21 skip
     6239           "Ошибка задания входных параметров" skip
     6240           "Не найдена партия" skip
     6241           "Документ" string(p-doc-code-rowid) skip
     6242           "Партия" string(p-parts-rowid) skip
     6243           error-status :get-message(1) skip
     6244           return-value skip
     6245           view-as alert-box error .
     6246         undo, return error .
     6247       end.
     6248       if  archive_parts.out-code <> archive_parts.in-code
     6249       and archive_parts.qnty <> 0
     6250       and (buf_trn-doc.doc-type = 'при':U and buf_trn-doc.internal = yes ) = false
     6251       and (buf_trn-doc.doc-type = 'возврат':U and p-is-hold = true  ) = false
     6252       then do:
     6253         assign
     6254           v-rsrv-code =
     6255           ( if (lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 )
     6256         or (buf_trn-doc.doc-type = 'инв':U and archive_parts.qnty < 0)
     6257         then 'free-zone':U
     6258         else 'out-zone':U )
     6259         .
     6260         run partcopy in this-procedure
     6261           (input  true
     6262           ,input  v-rsrv-code
     6263           ,buffer archive_parts
     6264           ,buffer buf_parts
     6265           ,input  "news"
     6266           ) no-error .
     6267         if error-status :error
     6268         then do:
     6269           message
     6270             vss-workfile vss-revision vss-description skip
     6271             vss-include-info21 skip
     6272             "Ошибка при создании партии" skip
     6273             "Документ" buf_trn-doc.doc-code skip
     6274             "Объект" archive_parts.obj-type archive_parts.obj-code skip
     6275             "Артикул" archive_parts.artic archive_parts.prod-type archive_parts.prod-code skip
     6276             "Партия" archive_parts.in-code archive_parts.part-code skip
     6277             "Количество" archive_parts.qnty skip
     6278             "Резерв" v-rsrv-code skip
     6279             error-status :get-message(1) skip
     6280             return-value skip
     6281             view-as alert-box error .
     6282           undo, return error .
     6283         end.
     6284         assign
     6285           buf_parts.qnty      = buf_parts.qnty     - abs(archive_parts.qnty)
     6286                                                     * (if p-rsrv-direction = true
     6287                                                       then 1
     6288                                                       else -1
     6289                                                       )
     6290           buf_parts.fact-qnty = buf_parts.qnty
     6291         .
     6292         find first buf_goods no-lock where buf_goods.artic = archive_parts.artic
     6293                                        and buf_goods.prod-type = archive_parts.prod-type
     6294                                        and buf_goods.prod-code = archive_parts.prod-code
     6295                                        .
     6296         for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     6297                                               and orig_marking-lines.obj-type   = archive_parts.obj-type
     6298                                               and orig_marking-lines.obj-code   = archive_parts.obj-code
     6299                                               and orig_marking-lines.in-code    = archive_parts.in-code
     6300                                               and orig_marking-lines.out-code   = archive_parts.out-code
     6301                                               and orig_marking-lines.part-code  = archive_parts.part-code
     6302                                               and orig_marking-lines.prt-code   = archive_parts.prt-code
     6303                                               :
     6304           find first buf_marking-lines no-lock where  buf_marking-lines.mark       = orig_marking-lines.mark
     6305                                                   and buf_marking-lines.gds-code   = buf_goods.gds-code
     6306                                                   and buf_marking-lines.obj-type   = buf_parts.obj-type
     6307                                                   and buf_marking-lines.obj-code   = buf_parts.obj-code
     6308                                                   and buf_marking-lines.in-code    = buf_parts.in-code
     6309                                                   and buf_marking-lines.out-code   = buf_parts.out-code
     6310                                                   and buf_marking-lines.part-code  = buf_parts.part-code
     6311                                                   and buf_marking-lines.prt-code   = buf_parts.prt-code
     6312                                                   no-error .
     6313           if available buf_marking-lines
     6314           then do :
     6315             find current buf_marking-lines exclusive-lock .
     6316             delete buf_marking-lines .
     6317             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     6318               assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB .
     6319             end .
     6320           end .
     6321           else do :
     6322             create buf_marking-lines .
     6323             assign
     6324               buf_marking-lines.mark       = orig_marking-lines.mark
     6325               buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     6326               buf_marking-lines.gds-code   = buf_goods.gds-code
     6327               buf_marking-lines.obj-type   = buf_parts.obj-type
     6328               buf_marking-lines.obj-code   = buf_parts.obj-code
     6329               buf_marking-lines.in-code    = buf_parts.in-code
     6330               buf_marking-lines.out-code   = buf_parts.out-code
     6331               buf_marking-lines.part-code  = buf_parts.part-code
     6332               buf_marking-lines.prt-code   = buf_parts.prt-code
     6333             .
     6334             if buf_parts.out-code <> buf_parts.in-code
     6335             and buf_parts.out-code <> 'free-zone':U
     6336             and buf_parts.out-code <> 'out-zone':U
     6337             then do :
     6338               find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.out-code no-error .
     6339               if available buf_trn-doc then buf_marking-lines.fact-order = buf_trn-doc.fact-order .
     6340             end .
     6341             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     6342               assign
     6343                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB when buf_parts.out-code = 'free-zone':U
     6344                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB when buf_parts.out-code = 'out-zone':U
     6345               .
     6346             end .
     6347           end .
     6348           release buf_marking-lines no-error .
     6349         end.
     6350         if p-goods-twounit = true
     6351         then do:
     6352           assign
     6353             buf_parts.cli-qnty = buf_parts.cli-qnty - abs(archive_parts.cli-qnty)
     6354                                                     * (if p-rsrv-direction = true
     6355                                                       then 1
     6356                                                       else -1
     6357                                                       )
     6358           .
     6359         end.
     6360         if  buf_parts.qnty      = 0
     6361         and buf_parts.fact-qnty = 0
     6362         then do:
     6363           if p-goods-twounit = true
     6364           then do:
     6365             if buf_parts.cli-qnty <> 0
     6366             then do:
     6367               message
     6368                 vss-workfile vss-revision vss-description skip
     6369                 vss-include-info21 skip
     6370                 "Ошибка при удалении партии" skip
     6371                 "Документ" buf_trn-doc.doc-code skip
     6372                 "Объект" buf_parts.obj-type buf_parts.obj-code skip
     6373                 "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     6374                 "Партия" buf_parts.in-code buf_parts.part-code skip
     6375                 "Резерв" buf_parts.out-code skip
     6376                 "qnty" buf_parts.qnty skip
     6377                 "fact-qnty" buf_parts.fact-qnty skip
     6378                 "cli-qnty" buf_parts.cli-qnty skip
     6379                 view-as alert-box error .
     6380               undo, return error .
     6381             end.
     6382           end.
     6383           delete buf_parts .
     6384         end.
     6385       end.
     6386     end.
     6387   end procedure.
     6388   procedure partcopy-update-doc-line-tot-fact :
     6389     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     6390     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     6391     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     6392     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     6393     define variable vss-description as character no-undo init "partcopy-update-doc-line-tot-fact-01: процедура обновления средней учетной цены в строке документа".
     6394       define variable v-total-parts-qnty           like ub.parts.qnty      no-undo .   define variable v-total-parts-fact-qnty      like ub.parts.fact-qnty no-undo .   define variable v-total-parts-cli-qnty       like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-fact-cli-qnty  like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-price-cli      as decimal no-undo .   define variable v-total-parts-price-base     as decimal no-undo .   define variable v-total-parts-price-rubl     as decimal no-undo .   define variable v-total-parts-transport-base as decimal no-undo .   define variable v-total-parts-transport-rubl as decimal no-undo .   define variable v-total-parts-other-base     as decimal no-undo .   define variable v-total-parts-other-rubl     as decimal no-undo .
     6395     define buffer buf_doc-line for ub.doc-line .
     6396     do
     6397     on error undo, return error return-value
     6398     :
     6399       find first buf_doc-line exclusive-lock
     6400         where buf_doc-line.doc-code  = p-doc-code
     6401           and buf_doc-line.artic     = p-artic
     6402           and buf_doc-line.prod-type = p-prod-type
     6403           and buf_doc-line.prod-code = p-prod-code
     6404         no-error .
     6405       if error-status :error
     6406       then do:
     6407         message
     6408           vss-workfile vss-revision vss-description skip
     6409           vss-include-info21 skip
     6410           "Ошибка задания входных параметров" skip
     6411           "Не найдена строка документа" skip
     6412           "Документ" p-doc-code skip
     6413           "Артикул" p-artic p-prod-type p-prod-code skip
     6414           error-status :get-message(1) skip
     6415           return-value skip
     6416           view-as alert-box error .
     6417         undo, return error .
     6418       end.
     6419       run partrqst in this-procedure
     6420         (input buf_doc-line.doc-code
     6421         ,input buf_doc-line.obj-type
     6422         ,input buf_doc-line.obj-code
     6423         ,input buf_doc-line.artic
     6424         ,input buf_doc-line.prod-type
     6425         ,input buf_doc-line.prod-code
     6426               ,output v-total-parts-qnty   ,output v-total-parts-fact-qnty   ,output v-total-parts-cli-qnty   ,output v-total-parts-fact-cli-qnty   ,output v-total-parts-price-cli   ,output v-total-parts-price-base   ,output v-total-parts-price-rubl   ,output v-total-parts-transport-base   ,output v-total-parts-transport-rubl   ,output v-total-parts-other-base   ,output v-total-parts-other-rubl
     6427         ) no-error .
     6428       if error-status :error
     6429       then do:
     6430         message
     6431           vss-workfile vss-revision vss-description skip
     6432           vss-include-info21 skip
     6433           "Ошибка при сборе информации по партиям" skip
     6434           "Документ" p-doc-code skip
     6435           "Артикул" p-artic p-prod-type p-prod-code skip
     6436           view-as alert-box error .
     6437         undo, return error .
     6438       end.
     6439       if v-total-parts-fact-qnty <> 0
     6440       then do:
     6441         assign
     6442           buf_doc-line.price-base      = v-total-parts-price-base
     6443                                        / v-total-parts-fact-qnty
     6444           buf_doc-line.price-rubl      = v-total-parts-price-rubl
     6445                                        / v-total-parts-fact-qnty
     6446           buf_doc-line.transport-base  = v-total-parts-transport-base
     6447                                        / v-total-parts-fact-qnty
     6448           buf_doc-line.transport-rubl  = v-total-parts-transport-rubl
     6449                                        / v-total-parts-fact-qnty
     6450           buf_doc-line.other-base      = v-total-parts-other-base
     6451                                        / v-total-parts-fact-qnty
     6452           buf_doc-line.other-rubl      = v-total-parts-other-rubl
     6453                                        / v-total-parts-fact-qnty
     6454         .
     6455       end.
     6456       else do:
     6457       end.
     6458     end.
     6459   end procedure.
     6460   procedure partcopy-change-purch-code :
     6461     define input parameter  p-in-code          like ub.parts.in-code no-undo .
     6462     define input parameter  p-dest-purch-code  like ub.parts.purch-code no-undo .
     6463     define parameter buffer buf_orig_parts     for ub.parts .
     6464     define parameter buffer buf1_parts         for ub.parts .
     6465     define parameter buffer buf2_parts         for ub.parts .
     6466     define variable vss-description as character no-undo init "partcopy-change-purch-code01: процедура копирования партии при смене purch-code".
     6467     define variable var-out-code  like ub.parts.out-code no-undo .
     6468     define variable var-part-code like ub.parts.part-code no-undo .
     6469     define buffer buf_goods        for ub.goods .
     6470     define buffer buf_parts-root   for ub.parts-root.
     6471     define buffer buf_trn-doc      for ub.trn-doc.
     6472     define buffer buf-orig_trn-doc for ub.trn-doc.
     6473     define buffer buf_units        for ub.units .
     6474     do
     6475     on error undo, return error return-value
     6476     :
     6477       if buf_orig_parts.out-code = p-in-code
     6478       then do:
     6479         message
     6480           vss-workfile vss-revision vss-description skip
     6481           vss-include-info21 skip
     6482           "Ошибка задания входных параметров процедуры partcopy" skip
     6483           "buf_orig_parts.out-code" buf_orig_parts.out-code skip
     6484           "p-in-code" p-in-code skip
     6485           view-as alert-box error .
     6486         undo, return error .
     6487       end.
     6488       find first buf_trn-doc no-lock
     6489         where buf_trn-doc.doc-code = p-in-code
     6490         .
     6491       find first buf-orig_trn-doc where buf-orig_trn-doc.doc-code = buf_orig_parts.out-code.
     6492       find first buf_goods no-lock
     6493         where buf_goods.artic = buf_orig_parts.artic
     6494           and buf_goods.prod-type = buf_orig_parts.prod-type
     6495           and buf_goods.prod-code = buf_orig_parts.prod-code
     6496         .
     6497       find first buf_units where buf_units.unit-name = buf_goods.unit-base no-lock.
     6498       find first buf1_parts exclusive-lock
     6499         where buf1_parts.obj-type  = buf_orig_parts.obj-type
     6500           and buf1_parts.obj-code  = buf_orig_parts.obj-code
     6501           and buf1_parts.artic     = buf_orig_parts.artic
     6502           and buf1_parts.prod-type = buf_orig_parts.prod-type
     6503           and buf1_parts.prod-code = buf_orig_parts.prod-code
     6504           and buf1_parts.in-code   = buf_orig_parts.in-code
     6505           and buf1_parts.out-code  = p-in-code
     6506           and buf1_parts.part-code = buf_orig_parts.part-code
     6507         no-error.
     6508       if not available buf1_parts
     6509       then do:
     6510         create buf1_parts .
     6511         buffer-copy buf_orig_parts to buf1_parts
     6512         assign
     6513           buf1_parts.in-code    = buf_orig_parts.in-code
     6514           buf1_parts.out-code   = p-in-code
     6515           buf1_parts.status_    = no
     6516           buf1_parts.qnty       = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
     6517           buf1_parts.fact-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
     6518           buf1_parts.cli-qnty   = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.cli-qnty  else - buf_orig_parts.cli-qnty  )
     6519           buf1_parts.purch-code = buf_orig_parts.purch-code
     6520           buf1_parts.rsrv-free  = ?
     6521           buf1_parts.status_    = yes
     6522         .
     6523         validate buf1_parts .
     6524       end.
     6525       if  lookup('сер':U, buf_units.type) > 0
     6526       then do:
     6527          var-part-code = buf_orig_parts.part-code.
     6528       end.
     6529       else do:
     6530           run holdprts-get-part-code in this-procedure
     6531             (input  p-in-code
     6532             ,output var-part-code
     6533             ) no-error .
     6534           if error-status :error
     6535           then dO:
     6536             undo, return error return-value.
     6537           end.
     6538       end.
     6539       find first buf2_parts exclusive-lock
     6540         where buf2_parts.obj-type  = buf_orig_parts.obj-type
     6541           and buf2_parts.obj-code  = buf_orig_parts.obj-code
     6542           and buf2_parts.artic     = buf_orig_parts.artic
     6543           and buf2_parts.prod-type = buf_orig_parts.prod-type
     6544           and buf2_parts.prod-code = buf_orig_parts.prod-code
     6545           and buf2_parts.in-code   = p-in-code
     6546           and buf2_parts.out-code  = p-in-code
     6547           and buf2_parts.part-code = var-part-code
     6548         no-error.
     6549       if not available buf2_parts
     6550       then do:
     6551         create buf2_parts .
     6552         buffer-copy buf_orig_parts to buf2_parts
     6553         assign
     6554           buf2_parts.in-code   = p-in-code
     6555           buf2_parts.out-code  = p-in-code
     6556           buf2_parts.qnty      = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
     6557           buf2_parts.fact-qnty = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
     6558           buf2_parts.cli-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.cli-qnty  else buf_orig_parts.cli-qnty  )
     6559           buf2_parts.purch-code = p-dest-purch-code
     6560           buf2_parts.part-code  = var-part-code
     6561           buf2_parts.rsrv-free  = ?
     6562           buf2_parts.status_    = yes
     6563         .
     6564         validate buf2_parts .
     6565       end.
     6566       assign
     6567         buf_orig_parts.in-code    = p-in-code
     6568         buf_orig_parts.part-code  = buf2_parts.part-code
     6569         buf_orig_parts.purch-code = buf2_parts.purch-code
     6570       .
     6571       find first buf_parts-root
     6572         where buf_parts-root.doc-code       = p-in-code
     6573           and buf_parts-root.in-code        = p-in-code
     6574           and buf_parts-root.gds-code       = buf_goods.gds-code
     6575           and buf_parts-root.part-code      = buf2_parts.part-code
     6576           and buf_parts-root.orig-in-code   = buf1_parts.in-code
     6577           and buf_parts-root.orig-gds-code  = buf_goods.gds-code
     6578           and buf_parts-root.orig-part-code = buf1_parts.part-code
     6579         no-error .
     6580       if not available buf_parts-root
     6581       then do:
     6582         create buf_parts-root.
     6583         assign
     6584         buf_parts-root.doc-code       = p-in-code
     6585         buf_parts-root.in-code        = p-in-code
     6586         buf_parts-root.gds-code       = buf_goods.gds-code
     6587         buf_parts-root.part-code      = buf2_parts.part-code
     6588         buf_parts-root.orig-in-code   = buf1_parts.in-code
     6589         buf_parts-root.orig-gds-code  = buf_goods.gds-code
     6590         buf_parts-root.orig-part-code = buf1_parts.part-code
     6591         .
     6592       end.
     6593     end.
     6594   end procedure.
     6595   procedure addChildMarkingLines:
     6596     define input parameter iMark as character no-undo.
     6597     define input parameter iSts  as integer   no-undo.
     6598     define parameter buffer buf_marking-lines  for ub.marking-lines.
     6599     define parameter buffer buf_parts          for ub.parts.
     6600     define parameter buffer orig_marking-lines for ub.marking-lines.
     6601     define parameter buffer buf_orig_parts     for ub.parts.
     6602     define parameter buffer buf_goods          for ub.goods.
     6603     define buffer buf_marking-childs        for ub.marking.
     6604     define buffer buf_marking-lines-childs  for ub.marking-lines.
     6605     define buffer buf_marking-chk           for ub.marking-chk.
     6606     define buffer buf_chk-doc               for ub.chk-doc.
     6607     define buffer orig_marking-lines-childs for ub.marking-lines.
     6608     for each buf_marking-childs exclusive-lock where
     6609              buf_marking-childs.mark-parent = iMark :
     6610         find first buf_marking-lines-childs no-lock where
     6611                    buf_marking-lines-childs.mark       = buf_marking-childs.mark
     6612                and buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
     6613                and buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
     6614                and buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
     6615                and buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
     6616                and buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
     6617                and buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
     6618                and buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
     6619         no-error .
     6620         if not available buf_marking-lines-childs then
     6621         do:
     6622           create buf_marking-lines-childs .
     6623           assign
     6624             buf_marking-lines-childs.mark       = buf_marking-childs.mark
     6625             buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
     6626             buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
     6627             buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
     6628             buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
     6629             buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
     6630             buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
     6631             buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
     6632             buf_marking-lines-childs.fact-order = buf_marking-lines.fact-order
     6633             buf_marking-lines-childs.doc-level  = buf_marking-lines.doc-level + 1
     6634           .
     6635           validate buf_marking-childs.
     6636         end .
     6637         buf_marking-childs.sts = iSts .
     6638         for each buf_marking-chk exclusive-lock where
     6639                  buf_marking-chk.mark begins buf_marking-childs.mark
     6640         :
     6641           for first buf_chk-doc no-lock where
     6642                     buf_chk-doc.doc-code = buf_marking-chk.doc-code
     6643                 and buf_chk-doc.out-code = buf_parts.out-code
     6644           :
     6645             buf_marking-chk.sts = 0 .
     6646             validate buf_marking-chk.
     6647           end .
     6648         end .
     6649         if available orig_marking-lines
     6650         then do :
     6651           find first orig_marking-lines-childs exclusive-lock where
     6652                      orig_marking-lines-childs.mark       = buf_marking-childs.mark
     6653                  and orig_marking-lines-childs.gds-code   = buf_goods.gds-code
     6654                  and orig_marking-lines-childs.obj-type   = buf_orig_parts.obj-type
     6655                  and orig_marking-lines-childs.obj-code   = buf_orig_parts.obj-code
     6656                  and orig_marking-lines-childs.in-code    = buf_orig_parts.in-code
     6657                  and orig_marking-lines-childs.out-code   = buf_orig_parts.out-code
     6658                  and orig_marking-lines-childs.part-code  = buf_orig_parts.part-code
     6659                  and orig_marking-lines-childs.prt-code   = buf_orig_parts.prt-code
     6660           no-error .
     6661           if available orig_marking-lines-childs then
     6662             delete orig_marking-lines-childs .
     6663         end.
     6664         run addChildMarkingLines in this-procedure (
     6665           buf_marking-childs.mark,
     6666           iSts,
     6667           buffer buf_marking-lines,
     6668           buffer buf_parts,
     6669           buffer orig_marking-lines,
     6670           buffer buf_orig_parts,
     6671           buffer buf_goods
     6672         ).
     6673     end .
     6674   end.
     6675   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6676   procedure gdsobjcl :
     6677     define input parameter p-gds-obj-recid    as recid no-undo .
     6678     define input parameter p-update-fact-qnty as logical   no-undo .
     6679     define variable vss-description as character no-undo init "$Workfile$ gdsobjcl: расчет записи товар на объекте ".
     6680     define buffer buf_parts for ub.parts .
     6681     define variable v-total-avrg-base as decimal no-undo .
     6682     define variable v-total-avrg-rubl as decimal no-undo .
     6683     define variable v-total-avrg-qnty as decimal no-undo .
     6684     define variable v-parts-avrg-qnty as decimal no-undo .
     6685     define variable v-total-fact-base as decimal no-undo .
     6686     define variable v-total-fact-rubl as decimal no-undo .
     6687     define variable v-total-fact-qnty as decimal no-undo .
     6688     define variable v-parts-fact-qnty as decimal   no-undo .
     6689     define buffer buf_gds-obj for ub.gds-obj .
     6690     define buffer buf_prt-obj for ub.prt-obj .
     6691     define buffer buf_gds-prt for ub.gds-prt .
     6692     do
     6693     on error undo, return error return-value
     6694     :
     6695       find first buf_gds-obj exclusive-lock
     6696         where recid(buf_gds-obj) = p-gds-obj-recid
     6697         no-error .
     6698       if not available buf_gds-obj
     6699       then do:
     6700         message
     6701           vss-workfile vss-revision vss-description skip
     6702           "Ошибка задания входных параметров" skip
     6703           "Не найдена запись товар на объекте" skip
     6704           "Код записи (recid)" p-gds-obj-recid skip
     6705           view-as alert-box error .
     6706         undo, return error return-value .
     6707       end.
     6708       assign
     6709         v-total-avrg-base = 0
     6710         v-total-avrg-rubl = 0
     6711         v-total-avrg-qnty = 0
     6712         v-total-fact-base = 0
     6713         v-total-fact-rubl = 0
     6714         v-total-fact-qnty = 0
     6715       .
     6716       for each buf_parts no-lock
     6717         where buf_parts.obj-type  = buf_gds-obj.obj-type
     6718           and buf_parts.obj-code  = buf_gds-obj.obj-code
     6719           and buf_parts.artic     = buf_gds-obj.artic
     6720           and buf_parts.prod-type = buf_gds-obj.prod-type
     6721           and buf_parts.prod-code = buf_gds-obj.prod-code
     6722           and buf_parts.status_   = no
     6723           and buf_parts.rsrv-free = yes
     6724           and buf_parts.in-code   <> buf_parts.out-code
     6725           and buf_parts.doc-type  <> 'акт':U
     6726       on error undo, return error return-value
     6727       :
     6728         assign
     6729           v-parts-avrg-qnty = 0
     6730           v-parts-fact-qnty = 0
     6731         .
     6732         if buf_parts.out-code = 'free-zone':U
     6733         then do:
     6734           if buf_parts.fact-qnty > 0
     6735           then do:
     6736             assign
     6737               v-parts-avrg-qnty = buf_parts.qnty
     6738             .
     6739           end.
     6740           assign
     6741             v-parts-fact-qnty = buf_parts.qnty
     6742           .
     6743         end.
     6744         else do:
     6745           assign
     6746             v-parts-avrg-qnty = abs(buf_parts.qnty)
     6747             v-parts-fact-qnty = abs(buf_parts.qnty)
     6748           .
     6749         end.
     6750         assign
     6751           v-total-avrg-base = v-total-avrg-base
     6752                             + (buf_parts.price-base * v-parts-avrg-qnty)
     6753           v-total-avrg-rubl = v-total-avrg-rubl
     6754                             + (buf_parts.price-rubl * v-parts-avrg-qnty)
     6755           v-total-avrg-qnty = v-total-avrg-qnty
     6756                             + v-parts-avrg-qnty
     6757           v-total-fact-base = v-total-fact-base
     6758                             + (buf_parts.price-base * v-parts-fact-qnty)
     6759           v-total-fact-rubl = v-total-fact-rubl
     6760                             + (buf_parts.price-rubl * v-parts-fact-qnty)
     6761           v-total-fact-qnty = v-total-fact-qnty
     6762                             + v-parts-fact-qnty
     6763         .
     6764       end.
     6765       if v-total-avrg-qnty < 0
     6766       or v-total-avrg-qnty = ?
     6767       then do:
     6768         undo, return error
     6769           vss-description + chr(10)
     6770           + "Количество положительных партий в свободной зоне не может быть отрицательным или неопределенным" + chr(10)
     6771           + "v-total-avrg-qnty " + (if v-total-avrg-qnty <> ? then string(v-total-avrg-qnty) else "?")
     6772           .
     6773       end.
     6774       if v-total-fact-base = ?
     6775       or v-total-fact-rubl = ?
     6776       then do:
     6777         undo, return error
     6778           vss-description + chr(10)
     6779           + "Сумма учетных цен по товару на объекте не может иметь неопределенное значение" + chr(10)
     6780           + "v-total-fact-base " + (if v-total-fact-base <> ? then string(v-total-fact-base) else "?") + chr(10)
     6781           + "v-total-fact-rubl " + (if v-total-fact-rubl <> ? then string(v-total-fact-rubl) else "?") + chr(10)
     6782           .
     6783       end.
     6784       assign
     6785         buf_gds-obj.avrg-qnty = v-total-avrg-qnty
     6786         buf_gds-obj.fact-base = v-total-fact-base
     6787         buf_gds-obj.fact-rubl = v-total-fact-rubl
     6788       .
     6789       if p-update-fact-qnty
     6790       then do:
     6791         message
     6792           vss-workfile vss-revision vss-description skip
     6793           "Ошибка задания входных параметров"
     6794           "В данной версии обновление фактического количества не реализовано" skip
     6795           "p-update-fact-qnty" p-update-fact-qnty skip
     6796           view-as alert-box error .
     6797         undo, return error return-value .
     6798       end.
     6799       if buf_gds-obj.fact-qnty <> v-total-fact-qnty
     6800       then do:
     6801         undo, return error
     6802           vss-description + chr(10)
     6803           + "Не совпадает общее количество по партиям и фактическое количество по товару на объекте" + chr(10)
     6804           + "buf_gds-obj.fact-qnty " + (if buf_gds-obj.fact-qnty <> ? then string(buf_gds-obj.fact-qnty) else "?") + chr(10)
     6805           + "v-total-fact-qnty "     + (if v-total-fact-qnty     <> ? then string(v-total-fact-qnty)     else "?") + chr(10)
     6806           .
     6807       end.
     6808       if v-total-avrg-qnty > 0
     6809       then do:
     6810         assign
     6811           buf_gds-obj.avrg-base = v-total-avrg-base / v-total-avrg-qnty
     6812           buf_gds-obj.avrg-rubl = v-total-avrg-rubl / v-total-avrg-qnty
     6813         .
     6814       end.
     6815       else do:
     6816         if  buf_gds-obj.last-base > 0
     6817         and buf_gds-obj.last-rubl > 0
     6818         then do:
     6819           assign
     6820             buf_gds-obj.avrg-base = buf_gds-obj.last-base
     6821             buf_gds-obj.avrg-rubl = buf_gds-obj.last-rubl
     6822           .
     6823         end.
     6824       end.
     6825       define variable v-total-sale-fact-qnty as decimal   no-undo .
     6826       define variable v-total-fact-sale      as decimal   no-undo .
     6827       assign
     6828         v-total-sale-fact-qnty = 0
     6829         v-total-fact-sale      = 0
     6830       .
     6831       for each buf_prt-obj
     6832         where buf_prt-obj.obj-type  = buf_gds-obj.obj-type
     6833           and buf_prt-obj.obj-code  = buf_gds-obj.obj-code
     6834           and buf_prt-obj.artic     = buf_gds-obj.artic
     6835           and buf_prt-obj.prod-type = buf_gds-obj.prod-type
     6836           and buf_prt-obj.prod-code = buf_gds-obj.prod-code
     6837           and buf_prt-obj.is-term   = true
     6838       on error undo, return error return-value
     6839       :
     6840         assign
     6841           v-total-sale-fact-qnty  = v-total-sale-fact-qnty
     6842                                   + buf_prt-obj.fact-qnty
     6843           v-total-fact-sale       = v-total-fact-sale
     6844                                   + buf_prt-obj.fact-qnty * buf_prt-obj.price-sale
     6845         .
     6846       end.
     6847       if v-total-fact-sale = ?
     6848       then do:
     6849         undo, return error
     6850           vss-description + chr(10)
     6851           + "Сумма продажных цен по товару на объекте не может иметь неопределенное значение" + chr(10)
     6852           + "v-total-fact-sale " + (if v-total-fact-sale <> ? then string(v-total-fact-sale) else "?") + chr(10)
     6853           .
     6854       end.
     6855       if buf_gds-obj.fact-qnty <> v-total-sale-fact-qnty
     6856       then do:
     6857         undo, return error
     6858           vss-description + chr(10)
     6859           + "Не совпадает общее количество по признакам и фактическое количество по товару на объекте" + chr(10)
     6860           + "buf_gds-obj.fact-qnty "  + (if buf_gds-obj.fact-qnty <> ?  then string(buf_gds-obj.fact-qnty)  else "?") + chr(10)
     6861           + "v-total-sale-fact-qnty " + (if v-total-sale-fact-qnty <> ? then string(v-total-sale-fact-qnty) else "?") + chr(10)
     6862           .
     6863       end.
     6864       assign
     6865         buf_gds-obj.fact-sale = v-total-fact-sale
     6866       .
     6867     end.
     6868   end procedure .
     6869   procedure gdsobjcl-calc-goods :
     6870     define input parameter p-artic     like ub.goods.artic     no-undo .
     6871     define input parameter p-prod-type like ub.goods.prod-type no-undo .
     6872     define input parameter p-prod-code like ub.goods.prod-code no-undo .
     6873     define variable vss-description as character no-undo init "$Workfile$ gdsobjcl-calc-goods".
     6874     do
     6875     on error undo, return error return-value
     6876     :
     6877       define buffer buf_gds-obj for ub.gds-obj .
     6878       define buffer buf_prt-obj for ub.prt-obj .
     6879       do
     6880       on error undo, return error return-value
     6881       :
     6882         for each buf_prt-obj
     6883           where buf_prt-obj.artic     = p-artic
     6884             and buf_prt-obj.prod-type = p-prod-type
     6885             and buf_prt-obj.prod-code = p-prod-code
     6886         on error undo, return error return-value
     6887         :
     6888   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtobjup in g#library
     6889     (buffer buf_prt-obj
     6890     ) no-error .
     6891           if error-status :error
     6892           then do:
     6893             undo, return error
     6894               "объект "  + string(buf_prt-obj.obj-type) + " " + string(buf_prt-obj.obj-code) + chr(10)
     6895               + "артикул " + string(buf_prt-obj.artic) + " " + string(buf_prt-obj.prod-type) + " " + string(buf_prt-obj.prod-code) + chr(10)
     6896               + "признак " + string(buf_prt-obj.prt-code) + chr(10)
     6897               + return-value .
     6898           end.
     6899         end.
     6900         for each buf_gds-obj
     6901           where buf_gds-obj.artic     = p-artic
     6902             and buf_gds-obj.prod-type = p-prod-type
     6903             and buf_gds-obj.prod-code = p-prod-code
     6904         on error undo, return error return-value
     6905         :
     6906           run gdsobjcl in this-procedure
     6907             (input recid(buf_gds-obj)
     6908             ,input false
     6909             ) no-error .
     6910           if error-status :error
     6911           then do:
     6912             undo, return error
     6913               "объект " + string(buf_gds-obj.obj-type) + " " + string(buf_gds-obj.obj-code) + chr(10)
     6914               + return-value .
     6915           end.
     6916         end.
     6917       end.
     6918     end.
     6919   end procedure.
     6920   define new global shared variable g#libtfarh as handle no-undo .
     6921     define new global shared variable g#lib-rvs as handle no-undo.
     6922   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6923   define new global shared variable g#trdcalib as handle no-undo.
     6924   do
     6925   on error undo, return error return-value
     6926   :
     6927     define buffer buf_trn-doc   for ub.trn-doc .
     6928     define buffer buf_doc-line  for ub.doc-line .
     6929     define buffer buf_parts     for ub.parts .
     6930     define buffer buf_price-doc for ub.price-doc.
     6931     define buffer buf_rvs-doc   for ub.rvs-doc .
     6932     define buffer buf_gen-attr  for ub.gen-attr .
     6933     define buffer buf_marking-lines for ub.marking-lines .
     6934     define buffer free_marking-lines for ub.marking-lines .
     6935     define buffer buf_marking   for ub.marking .
     6936     define variable v-root-node         like ub.gds-prt.node-code no-undo .
     6937     define variable v-ind-goods            as integer   no-undo .
     6938     define variable v-start-time           as int64     no-undo .
     6939     define variable v-current-time         as character no-undo .
     6940     define variable v-current-action         as character no-undo .
     6941     define variable v-description-doc-type as character no-undo .
     6942     define variable v-doc-line-artic       like ub.doc-line.artic no-undo .
     6943     define variable part-key-rec as character no-undo .
     6944     define variable part-key-rec_free as character no-undo .
     6945     define variable part-key-rec_out as character no-undo .
     6946     define frame a
     6947       buf_trn-doc.doc-code                       label "Документ" skip
     6948       v-description-doc-type                     label "Тип документа" skip
     6949       v-current-action         format "x(40)"      no-label skip
     6950       v-ind-goods            format ">>>>>>>9"   label "Обработано артикулов" skip
     6951       v-doc-line-artic                           label "Текущий артикул" skip
