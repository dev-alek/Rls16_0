     7366                                                       and free_marking-lines.part-code  = buf_marking-lines.part-code
     7367                                                       and free_marking-lines.prt-code   = buf_marking-lines.prt-code
     7368                                                       no-error .
     7369               if not available free_marking-lines
     7370               then do :
     7371                 create free_marking-lines .
     7372                 assign
     7373                   free_marking-lines.mark       = buf_marking-lines.mark
     7374                   free_marking-lines.doc-level  = buf_marking-lines.doc-level
     7375                   free_marking-lines.gds-code   = buf_marking-lines.gds-code
     7376                   free_marking-lines.obj-type   = buf_marking-lines.obj-type
     7377                   free_marking-lines.obj-code   = buf_marking-lines.obj-code
     7378                   free_marking-lines.in-code    = buf_marking-lines.in-code
     7379                   free_marking-lines.out-code   = 'free-zone':U
     7380                   free_marking-lines.part-code  = buf_marking-lines.part-code
     7381                   free_marking-lines.prt-code   = buf_marking-lines.prt-code
     7382                 .
     7383               end .
     7384               if not (buf_marking.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U)
     7385                 then assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     7386             end .
     7387           end .
     7388           delete buf_marking-lines .
     7389         end.
     7390         delete buf_parts .
     7391       end.
     7392       define buffer buf_parts-root for ub.parts-root .
     7393       for each buf_parts-root exclusive-lock
     7394         where buf_parts-root.doc-code = buf_trn-doc.doc-code
     7395       on error undo, return error return-value
     7396       :
     7397         delete buf_parts-root .
     7398       end.
     7399       define buffer buf_parts-attr for ub.parts-attr .
     7400       for each buf_parts-attr exclusive-lock
     7401         where buf_parts-attr.in-code = buf_trn-doc.doc-code
     7402       on error undo, return error return-value
     7403       :
     7404         define buffer buf_goods for ub.goods .
     7405         find first buf_goods no-lock
     7406           where buf_goods.gds-code = buf_parts-attr.gds-code
     7407           no-error .
     7408         if not available buf_goods
     7409         then do:
     7410           undo, return error substitute( "&1. Не найден товар.&2"
     7411                                          + "Код товара &3&2"
     7412                                          + "Логический номер документа &4&2"
     7413                                          + "Расширенный тип документа &5&2"
     7414                                          ,vss-workfile
     7415                                          ,chr(10)
     7416                                          ,buf_parts-attr.gds-code
     7417                                          ,buf_doc-line.fact-order
     7418                                          ,buf_trn-doc.ext-doc-type
     7419                                         ).
     7420         end.
     7421         if not g#news then for each buf_parts no-lock
     7422           where buf_parts.artic     = buf_goods.artic
     7423             and buf_parts.prod-type = buf_goods.prod-type
     7424             and buf_parts.prod-code = buf_goods.prod-code
     7425             and buf_parts.in-code   = buf_parts-attr.in-code
     7426             and buf_parts.part-code = buf_parts-attr.part-code
     7427         on error undo, return error return-value
     7428         :
     7429           find first buf_price-doc no-lock
     7430             where buf_price-doc.doc-num = buf_parts.out-code
     7431             no-error .
     7432           if available buf_price-doc
     7433           then do:
     7434           end.
     7435           else do:
     7436             undo, return error substitute( "&1. Удаление невозможно.&2Найдены партии для атрибутов.&2"
     7437                                             + "Логический номер документа &3&2"
     7438                                             + "Расширенный тип документа &4&2"
     7439                                             + "Объект партии &5 &6&2"
     7440                                             ,vss-workfile
     7441                                             ,chr(10)
     7442                                             ,buf_trn-doc.fact-order
     7443                                             ,buf_trn-doc.ext-doc-type
     7444                                             ,buf_parts.obj-type
     7445                                             ,buf_parts.obj-code
     7446                                           )
     7447                              + substitute( "Товар &2&1&3&1&4&1"
     7448                                             + "Резерв &5&2"
     7449                                             + "Партия &6 &7&2"
     7450                                             + "Количество &8&2"
     7451                                             + "Фактическое количество &9&2"
     7452                                             ,chr(10)
     7453                                             ,buf_parts.artic
     7454                                             ,buf_parts.prod-type
     7455                                             ,buf_parts.prod-code
     7456                                             ,buf_parts.out-code
     7457                                             ,buf_parts.in-code
     7458                                             ,buf_parts.part-code
     7459                                             ,buf_parts.qnty
     7460                                             ,buf_parts.fact-qnty
     7461                                           ).
     7462           end.
     7463         end.
     7464         delete buf_parts-attr .
     7465       end.
     7466     end.
     7467     if buf_trn-doc.ext-doc-type = 'vt':U then do:
     7468        run str/del-invc.p
     7469          ( input buf_trn-doc.doc-code
     7470           ,input buf_trn-doc.obj-type
     7471           ,input buf_trn-doc.obj-code
     7472          ) no-error .
     7473       if error-status :error
     7474       then do:
     7475         undo, return error substitute( "&1. Не удалось удалить чеки по документу инвентаризации.&2"
     7476                                         + "Логический номер документа &3&2"
     7477                                         + "Расширенный тип документа &4&2&5&2&6&2"
     7478                                         ,vss-workfile
     7479                                         ,chr(10)
     7480                                         ,buf_trn-doc.fact-order
     7481                                         ,buf_trn-doc.ext-doc-type
     7482                                         ,error-status :get-message(1)
     7483                                         ,return-value
     7484                                       ).
     7485       end.
     7486     end.
     7487     if g#news
     7488     and g#db-num = 0
     7489     and (buf_trn-doc.ext-doc-type = 're':U OR
     7490           buf_trn-doc.ext-doc-type = 'ee':U)
     7491           and buf_trn-doc.d-card       <> ""
     7492           and buf_trn-doc.d-card       <> ?
     7493     then do:
     7494       define variable v-deleted as logical no-undo .
     7495   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-del in g#trdcalib (  input buf_trn-doc.doc-code ,
     7496                           input 'need-saledc':U ,
     7497                          output v-deleted ) no-error .
     7498     end.
     7499     if g#news
     7500     and g#db-num = 0
     7501     and (buf_trn-doc.ext-doc-type = 'vt':U
     7502       or buf_trn-doc.ext-doc-type = 'wm':U
     7503       or buf_trn-doc.ext-doc-type = 'we':U)
     7504     then do :
     7505       define buffer buf_utd for ub.utd .
     7506       for each buf_utd exclusive-lock where buf_utd.doc-code = buf_trn-doc.doc-code :
     7507         case buf_utd.sts :
     7508           when ObjSrv:Env:Utd:Sts:TH:LK_RECEIPT_New:KeyIntDB
     7509           or when ObjSrv:Env:Utd:Sts:TH:LK_RECEIPT_Signed:KeyIntDB
     7510           then do :
     7511             buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LK_RECEIPT_NewDelete:KeyIntDB .
     7512           end .
     7513           when ObjSrv:Env:Utd:Sts:TH:LK_RECEIPT_Sent:KeyIntDB
     7514           or when ObjSrv:Env:Utd:Sts:TH:LK_RECEIPT_Error:KeyIntDB
     7515           or when ObjSrv:Env:Utd:Sts:TH:LK_RECEIPT_Confirmed:KeyIntDB
     7516           then do :
     7517             buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LK_RECEIPT_SentDelete:KeyIntDB .
     7518           end .
     7519         end case .
     7520       end .
     7521     end .
     7522     run show-action in this-procedure
     7523       (input "Документ удален"
     7524       ).
     7525   end.
     7526   procedure show-action :
     7527     do
     7528     on error undo, return error
     7529     :
     7530       define input parameter p-action as character no-undo .
     7531       assign
     7532         v-current-time = string(integer(truncate((etime - v-start-time) / 1000, 0)), 'HH:MM:SS':U)
     7533         v-current-action = p-action
     7534       .
     7535       display
     7536         v-current-time v-current-action
     7537         with frame a.
     7538     end.
     7539   end procedure.
