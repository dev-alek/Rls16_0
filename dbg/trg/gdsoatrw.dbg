      433   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      434   procedure cur-time :
      435      define output parameter p-today as date      no-undo .
      436      define output parameter p-time  as integer   no-undo .
      437     do
      438     on error undo, return error
      439     :
      440       define variable v-date1 as date      no-undo .
      441       define variable v-date2 as date      no-undo .
      442       define variable v-time  as integer   no-undo .
      443       assign
      444         v-date1 = today
      445         v-time  = time
      446         v-date2 = today
      447       .
      448       if v-date1 <> v-date2
      449       then do:
      450         assign
      451           v-date1 = today
      452           v-time  = v-time
      453         .
      454       end.
      455       assign
      456         p-today = v-date1
      457         p-time  = v-time
      458       .
      459     end.
      460   end.
      461   function cur-time-date returns character
      462   :
      463     return string(today, '99/99/9999':U) .
      464   end.
      465   function cur-time-mjd returns decimal
      466   :
      467     define variable v-date as date      no-undo .
      468     define variable v-time as integer   no-undo .
      469     run cur-time in this-procedure
      470       (output v-date
      471       ,output v-time
      472       ) .
      473     return integer(v-date) - 2400002 + (v-time / 86400) .
      474   end.
      475   function cur-time-get-ending-index returns integer
      476   (input p-number as integer
      477   )
      478   :
      479     if p-number < 0
      480     or p-number = ?
      481     then do:
      482       return 1 .
      483     end.
      484     define variable v-rest as integer   no-undo .
      485     assign
      486       p-number = p-number modulo 100
      487     .
      488     if p-number < 20
      489     then do:
      490       assign
      491         v-rest = p-number
      492       .
      493     end.
      494     else do:
      495       assign
      496         v-rest = p-number modulo 10
      497       .
      498     end.
      499     case v-rest :
      500       when 1
      501       then do:
      502         return 2 .
      503       end.
      504       when 2 or
      505       when 3 or
      506       when 4
      507       then do:
      508         return 3 .
      509       end.
      510       otherwise do:
      511         return 1 .
      512       end.
      513     end case .
      514   end.
      515   procedure cur-time-mjd-to-date :
      516      define input  parameter i-mjd-diff as decimal no-undo.
      517      define output parameter o-Date     as date    no-undo.
      518      define output parameter o-Time     as integer no-undo.
      519      define variable v-day-number as integer   no-undo .
      520      if    i-mjd-diff < 0
      521         or i-mjd-diff = ?
      522      then do:
      523         return "?" .
      524      end.
      525      assign
      526         v-day-number = truncate(i-mjd-diff,0).
      527         o-Date = date(v-day-number + 2400002).
      528         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      529     .
      530   end.
      531   function cur-time-mjd-to-string returns character
      532   (input p-mjd-diff as decimal
      533   )
      534   :
      535     define variable v-day-number as integer   no-undo .
      536     define variable v-seconds    as integer   no-undo .
      537     define variable v-hour       as integer   no-undo .
      538     define variable v-min        as integer   no-undo .
      539     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      540     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      541     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      542     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      543     if p-mjd-diff < 0
      544     or p-mjd-diff = ?
      545     then do:
      546       return "?" .
      547     end.
      548     assign
      549       v-day-number = integer(truncate(p-mjd-diff,0))
      550       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      551     .
      552     if v-seconds > 86400
      553     then do:
      554       assign
      555         v-seconds = 86400 - 1
      556       .
      557     end.
      558     if v-seconds < 0
      559     then do:
      560       assign
      561         v-seconds = 0
      562       .
      563     end.
      564     assign
      565       v-hour = truncate(v-seconds / 3600, 0)
      566     .
      567     assign
      568       v-seconds = v-seconds modulo 3600
      569     .
      570     assign
      571       v-min = truncate(v-seconds / 60, 0)
      572     .
      573     assign
      574       v-seconds = v-seconds modulo 60
      575     .
      576     return
      577         (if v-day-number <> 0
      578           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      579           else ""
      580         )
      581       + (if v-day-number <> 0 or v-hour <> 0
      582           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      583           else ""
      584         )
      585       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      586           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      587           else ""
      588         )
      589       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      590       .
      591   end.
      592   function cur-time-string returns character
      593   :
      594     define variable v-date as date      no-undo .
      595     define variable v-time as integer   no-undo .
      596     run cur-time in this-procedure
      597       (output v-date
      598       ,output v-time
      599       ) .
      600     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      601   end.
      602   function cur-time-string-sec returns character
      603   :
      604     define variable v-date as date      no-undo .
      605     define variable v-time as integer   no-undo .
      606     run cur-time in this-procedure
      607       (output v-date
      608       ,output v-time
      609       ) .
      610     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      611   end.
      612   function cur-time-custom  returns character
      613   (input p-prefix as character
      614   ,input p-date-format as character
      615   ,input p-delimiter as character
      616   ,input p-time-format as character
      617   ,input p-suffix as character
      618   )
      619   :
      620     define variable v-date as date      no-undo .
      621     define variable v-time as integer   no-undo .
      622     run cur-time in this-procedure
      623       (output v-date
      624       ,output v-time
      625       ) .
      626     return
      627       p-prefix
      628       + string(v-date, p-date-format)
      629       + p-delimiter
      630       + string(v-time, p-time-format)
      631       + p-suffix
      632       .
      633   end.
      634   function cur-time-print  returns character
      635   :
      636     define variable v-date as date      no-undo .
      637     define variable v-time as integer   no-undo .
      638     run cur-time in this-procedure
      639       (output v-date
      640       ,output v-time
      641       ) .
      642     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      643   end.
      644   function cur-time-datetime returns datetime
      645   :
      646     define variable v-char as character no-undo .
      647     define variable v-datetime as datetime no-undo .
      648     v-char = cur-time-string().
      649     v-datetime = datetime(v-char).
      650     return  v-datetime.
      651   end.
      652   function cur-time-string-msec returns character
      653   :
      654     define variable v-date as datetime  no-undo .
      655     v-date = now.
      656     return string(v-date) .
      657   end.
