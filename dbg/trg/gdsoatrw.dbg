      941     end.
      942     if listPromoIds <> "" and
      943        not g#news and not g#esys and g#db-num > 0 then
      944     do:
      945       run str/diallog.w (
      946             input this-procedure
      947           , input this-procedure
      948           , input "str/promosend.p":U
      949           , input ('IBM-XML':U + chr(4) + ub.gds-obj-attr.obj-type + chr(4) + string(ub.gds-obj-attr.obj-code) + chr(4) + "U":U + chr(4) + listPromoIds)
      950           , input no
      951           , input "":U
      952           , input "Отправка промоакций на кассу"
      953       ) no-error.
      954     end.
      955     end.
      956     if g#oxml = yes
      957     then do:
      958       run str/calloxml.p (
      959             input 'update':U
      960           , input 'gds-obj-attr':U
      961           , input ( buffer ub.gds-obj-attr:handle )
      962       ) no-error.
      963       if error-status :error
      964       then do:
      965           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      966                                , chr(10)
      967                                , vss-workfile
      968                                , return-value
      969                                , error-status :get-message ( 1 ) ).
      970       end.
      971     end.
      972     if available (ub.gds-obj-attr) and ub.gds-obj-attr.attr-code = "dt-seasons" then
      973     do:
      974       run bge\send1cerp.p (?,
      975         this-procedure,
      976         this-procedure,
      977         "DTSeasons",
      978         (buffer ub.gds-obj-attr:handle),
      979         ?,
      980         ?) no-error.
      981       if error-status:error
      982         then
      983       do:
      984         message return-value view-as alert-box.
      985       end.
      986     end.
      987   end.
