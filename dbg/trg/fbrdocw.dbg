        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.fbr-doc old buffer old-fbr-doc .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись документа производства".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable v-message as character no-undo .
       79   main-block:
       80   do transaction
       81   on error undo main-block, return error
       82   :
       83       if ub.fbr-doc.creid = "" then do:
       84           assign
       85           ub.fbr-doc.creid = g#userid
       86           .
       87       end.
       88       if not g#news
       89       then do:
       90   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
       92     (output ub.fbr-doc.user-db-num
       93     ,output ub.fbr-doc.user-name
       94     ,output ub.fbr-doc.sys-date
       95     ,output ub.fbr-doc.sys-time
       96     ,output ub.fbr-doc.sys-time-int
       97     )  .
       98       end.
       99       if not g#news
      100       then do:
      101           run trg/fbrdoch.p (
      102             buffer old-fbr-doc
      103           , buffer ub.fbr-doc
      104           ) no-error .
      105           if error-status:error
      106           then do:
      107               message
      108                   vss-workfile vss-revision vss-description skip
      109                   "Ошибка при создании истории изменений документа производства" skip
      110                   "Документ" ub.fbr-doc.doc-code skip
      111                   view-as alert-box .
      112               undo main-block, return error.
      113           end.
      114       end.
      115       if ub.fbr-doc.status_ = 'факт':U then do:
      116           if not g#news then do:
      117           run gbl/chk-date.p
      118               (input ub.fbr-doc.obj-type
      119               ,input ub.fbr-doc.obj-code
      120               ,input ub.fbr-doc.fact-date
      121               ,input 1
      122               ,input ub.fbr-doc.shift-date
      123               ,input ub.fbr-doc.shift-num
      124               ,yes) no-error.
      125           if error-status:error then do:
      126               message "Ошибка при установке дат, времен, смен в документе производства(fbr-doc)."
      127               view-as alert-box.
      128               undo main-block, return error.
      129           end.
      130           end.
      131           if old-fbr-doc.status_ <> ub.fbr-doc.status_
      132           then do:
      133               run str/callnews.p
      134               (input "fbr-doc"
      135               ,input (buffer ub.fbr-doc:handle)
      136               ) no-error .
      137               if error-status:error then do:
      138               message
      139                   vss-workfile vss-revision vss-description skip
      140                   "Ошибка при передаче документа производства в новости" skip
      141                   "Документ" ub.fbr-doc.doc-code skip
      142                   view-as alert-box .
      143               undo main-block, return error.
      144               end.
      145           end.
      146       end.
      147       if g#oxml = yes
      148       then do:
      149       run str/calloxml.p (
      150             input 'update':U
      151           , input 'fbr-doc':U
      152           , input ( buffer ub.fbr-doc:handle )
      153       ) no-error.
      154       if error-status :error
      155       then do:
      156           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      157                                , chr(10)
      158                                , vss-workfile
      159                                , return-value
      160                                , error-status :get-message ( 1 ) ).
      161       end.
      162       end.
      163   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
      164     (input ?
      165     ,input this-procedure:handle
      166     ,input ?
      167     ,input 'event_fbr-doc':U
      168     ,input  buffer old-fbr-doc:handle
      169     ,input  buffer ub.fbr-doc:handle
      170     ,input ''
      171     ,input ''
      172     ) no-error .
      173       if error-status:error
      174       then do:
      175         v-message = substitute("&1 &2 &3&4Ошибка при вызове процедуры rum-runa.i&4&5&4&5&6"
      176                               ,vss-workfile
      177                               ,vss-revision
      178                               ,vss-description
      179                               ,chr(10)
      180                               , error-status:get-message(1)
      181                               , return-value ).
      182         if not g#news then do:
      183           message
      184           v-message
      185           view-as alert-box error .
      186         end.
      187         undo main-block,  return error v-message.
      188       end.
      189   END.
