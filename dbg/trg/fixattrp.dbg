        1   block-level on error undo, throw.
        2   define input parameter p-forced as logical no-undo .
        3   define input parameter p-read-only as logical no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Утилита импорта конфигурации атрибутов".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   procedure check-ap-version :
       81   define output parameter p-check as logical no-undo .
       82   define variable v-dopi1 as integer no-undo .
       83   define variable v-dopi2 as integer no-undo .
       84   define variable v-dopi3 as integer no-undo .
       85   define variable v-dopi4 as integer no-undo .
       86   define buffer buf_attr-prop for ub.attr-prop .
       87     do
       88     on error undo, return error
       89     :
       90       find first buf_attr-prop no-lock where
       91                 buf_attr-prop.node-code = 0
       92             and buf_attr-prop.table-name = '':U
       93             and buf_attr-prop.templ-rl-root = 0   no-error.
       94       if (not available buf_attr-prop
       95       or buf_attr-prop.property-value <> "v15_1.3" )
       96       then do:
       97         assign
       98         v-dopi1 = integer(entry(2, buf_attr-prop.property-value, "."))
       99         v-dopi2 = integer(entry(2, "v15_1.3", "."))
      100         v-dopi3 = integer(entry(2, entry(1, buf_attr-prop.property-value, "."), "_"))
      101         v-dopi4 = integer(entry(2, entry(1, "v15_1.3", "."), "_"))
      102         no-error .
      103         if error-status:error
      104         or v-dopi2 > v-dopi1
      105         or v-dopi4 > v-dopi3
      106         or left-trim(entry(1, buf_attr-prop.property-value, "."), "v":U) < "15"
      107         then do:
      108           assign
      109           p-check = yes.
      110         end.
      111       end.
      112     end.
      113   end procedure.
      114   procedure get-ap-version :
      115   define output parameter p-ap-version as character no-undo init ?.
      116   define buffer buf_attr-prop for ub.attr-prop .
      117   find first buf_attr-prop no-lock where
      118             buf_attr-prop.node-code = 0
      119         and buf_attr-prop.table-name = '':U
      120         and buf_attr-prop.templ-rl-root = 0   no-error.
      121   if available buf_attr-prop then do:
      122     p-ap-version = buf_attr-prop.property-value.
      123   end.
      124   end procedure.
      125   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126   define variable v-waitfram-action01         as character   no-undo .
      127   define variable v-waitfram-action02         as character   no-undo .
      128   define variable v-waitfram-action03         as character   no-undo .
      129   define variable mWaitFramTextBeg            as character   no-undo.
      130   define variable mWaitFramTextEnd            as character   no-undo.
      131   define variable mWaitFramView               as logical     no-undo.
      132   define variable mWaitProcEvent              as logical     no-undo init yes.
      133   define variable mWaitFramInterval           as integer     no-undo init 1 .
      134   define variable mWaitFramStop               as logical     no-undo.
      135   define variable mWaitFramStopUser           as logical     no-undo.
      136   define variable mWaitFramStopTimeOut        as logical     no-undo.
      137   define variable mWaitFramStartProc          as datetime-tz no-undo.
      138   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      139   define button B-WaitFramStop auto-end-key
      140        label "Стоп"
      141        size 10 by 1 tooltip "Остоновить процесс".
      142   define button B-viewProcInfo
      143        label "Информация"
      144        size 15 by 1 tooltip "Информация о процесс".
      145   define frame waitfram
      146     v-waitfram-action01 format "x(72)" no-label skip
      147     v-waitfram-action02 format "x(72)" no-label skip
      148     v-waitfram-action03 format "x(72)" no-label skip
      149     B-viewProcInfo
      150     B-WaitFramStop at row 4 col 30
      151     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      152     .
      153   define new global shared variable mBatchMode as logical no-undo init ?.
      154   define variable mFramBachModHandle as handle no-undo.
      155   mFramBachModHandle = frame waitfram:handle.
      156   define variable mFameOldVis as logical no-undo.
      157   define variable mVisCUrentVin as logical no-undo.
      158   if session:batch-mode
      159   then
      160      mBatchMode = yes.
      161   if mBatchMode = ? then do:
      162     mVisCUrentVin = current-window:visible.
      163     mFameOldVis = mFramBachModHandle:visible.
      164     mFramBachModHandle:visible  = yes.
      165     mBatchMode = mFramBachModHandle:visible ne yes.
      166     mFramBachModHandle:visible = mFameOldVis.
      167     current-window:visible = mVisCUrentVin.
      168   end.
      169    if  log-manager:logfile-name ne ?
      170     then DO:
      171         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      172         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      173         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      174     end.
      175   on choose of B-WaitFramStop in frame waitfram
      176   do:
      177     mWaitFramStop = yes.
      178     mWaitFramStopUser = yes.
      179   end.
      180   function waitfram-check-timeout returns logical():
      181      define variable vtime as int64 no-undo.
      182      if mWaitFramStopTimeOut
      183      then
      184         return yes.
      185      vtime = ( now - mWaitFramStartProc ) / 1000 .
      186      if     mWaitFramTimeOut ne ?
      187         and mWaitFramTimeOut ne 0
      188         and mWaitFramTimeOut lt vtime
      189      then do:
      190         mWaitFramStopTimeOut = yes.
      191      end.
      192      return mWaitFramStopTimeOut.
      193   end.
      194   procedure waitfram-hide :
      195     if not session:batch-mode
      196     then do
      197     on error undo, return error return-value
      198     :
      199       pause 0 before-hide .
      200       if not mBatchMode then
      201         hide frame waitfram .
      202     if     not mWaitFramView
      203        and mWaitProcEvent
      204     then
      205       process events .
      206     end.
      207   end procedure.
      208   procedure waitfram-show :
      209     define input  parameter p-message as character no-undo .
      210     define variable v-left-margin as integer   no-undo .
      211     if not session:batch-mode
      212     then do
      213     on error undo, return error return-value
      214     :
      215       if length(p-message) <= 70 then do:
      216         assign
      217           v-left-margin = integer((70 - length(p-message)) / 2)
      218         .
      219         assign
      220           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      221         .
      222         assign
      223           v-waitfram-action01 = " "
      224           v-waitfram-action02 = " "
      225                                    + fill(" ", v-left-margin)
      226                                    + p-message
      227           v-waitfram-action03 = " "
      228         .
      229       end.
      230       else do:
      231         define variable vRindex1 as integer no-undo.
      232         define variable vRindex2 as integer no-undo.
      233         vRindex1 = r-index(p-message," ",70).
      234         if vRindex1 = 0
      235         then
      236            vRindex1 = 70.
      237         if length(p-message)  <= vRindex1 + 70 then do:
      238           assign
      239             v-waitfram-action01 = " "
      240             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      241             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      242           .
      243         end.
      244         else do:
      245           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      246           if vRindex2 <= vRindex1
      247           then
      248              vRindex2 = vRindex1 + 70.
      249           assign
      250             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      251             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      252             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      253           .
      254         end.
      255       end.
      256       B-viewProcInfo:visible   in frame waitfram = no.
      257       B-viewProcInfo:sensitive in frame waitfram = no.
      258       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      259       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      260       if  (   mWaitFramView
      261          or  mWaitProcEvent)
      262          and not mBatchMode
      263       then
      264          display
      265             v-waitfram-action01 skip
      266             v-waitfram-action02 skip
      267             v-waitfram-action03 skip
      268          with frame waitfram .
      269       if     mWaitFramView
      270          then do:
      271             if     mWaitFramInterval ne ?
      272                and not mBatchMode
      273             then
      274                wait-for go of frame waitfram pause mWaitFramInterval.
      275          end.
      276          else
      277             if     mWaitProcEvent
      278                and not mBatchMode
      279             then
      280                process events .
      281     end.
      282   end procedure.
      283      procedure waitfram-show-this:
      284         define input  parameter iInterval as int64 no-undo.
      285         define variable vtime as int64 no-undo.
      286         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      287         mWaitFramInterval = iInterval.
      288         run waitfram-show (substitute("&1&2 &3&4" ,
      289                                       mWaitFramTextBeg ,
      290                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      291                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      292                                       mWaitFramTextEnd
      293                                      )
      294                           ).
      295      end.
      296      procedure WaitFramRunPause:
      297         define input  parameter iInterval as dec no-undo.
      298         define variable vStart  as datetime-tz no-undo.
      299         define variable vend    as datetime-tz no-undo.
      300         define variable vint as int64 no-undo.
      301         define variable vOk as logical no-undo.
      302         vStart = now.
      303         vend   = vStart.
      304         publish "WaitFramPause" (iInterval,output vOk).
      305         vend   =  now.
      306         vint = vend - vStart.
      307         vint = iInterval - vint / 1000.
      308         if     not mWaitFramStop
      309            and (   vint > 0
      310                 or (    not vOk
      311                     and iInterval eq ?
      312                     )
      313                 )
      314         then
      315            run waitfram-show-this (iInterval).
      316         vend   =  now.
      317         vint = vend - vStart.
      318         vint = iInterval - vint / 1000.
      319         if     not mWaitFramStop
      320            and vint > 0
      321         then do:
      322            run gbl/pause.p (vint * 1000).
      323         end.
      324         if iInterval ne ?
      325         then
      326            publish "WaitFramStop".
      327         waitfram-check-timeout().
      328      end.
      329      procedure WaitFramWaitFor:
      330         define input  parameter iInterval as dec no-undo.
      331         assign
      332            mWaitFramStartProc   = now
      333            mWaitFramStopUser    = no
      334            mWaitFramStopTimeOut = no
      335         .
      336         block-wait:
      337         do while not mWaitFramStop:
      338            run WaitFramRunPause (iInterval).
      339            if  waitfram-check-timeout()
      340            then do:
      341               leave block-wait.
      342            end.
      343         end.
      344         run waitfram-hide.
      345      end.
      346   procedure waitfram-join :
      347     define input  parameter p-line-1  as character no-undo .
      348     define input  parameter p-line-2  as character no-undo .
      349     define input  parameter p-line-3  as character no-undo .
      350     define output parameter p-message as character no-undo .
      351     do
      352     on error undo, return error return-value
      353     :
      354       assign
      355         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      356                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      357                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      358       .
      359     end.
      360   end procedure.
      361   function waitfram-join-function returns character
      362     (input p-line-1 as character
      363     ,input p-line-2 as character
      364     ,input p-line-3 as character
      365     ).
      366     define variable v-message as character no-undo .
      367     run waitfram-join in this-procedure
      368       (input  p-line-1
      369       ,input  p-line-2
      370       ,input  p-line-3
      371       ,output v-message
      372       ) .
      373     return v-message .
      374   end function .
      375   define stream imp-stream.
      376   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   define new shared temp-table temp-tables no-undo
      378   field tbl-name as character
      379   field buf-handle as handle
      380   field tbl-handle as handle
      381   index pi is unique primary
      382   tbl-name.
      383   define new shared temp-table temp-command no-undo
      384   field command-name as character
      385   field tbl-name as character
      386   field uniq-key-rec as character
      387   index pi is unique primary
      388   tbl-name
      389   command-name
      390   uniq-key-rec
      391   index icommand
      392   command-name
      393   tbl-name
      394   uniq-key-rec
      395   .
      396   define buffer buf_temp-tables for temp-tables.
      397   define variable v-check as logical no-undo .
      398   define variable v-force as logical no-undo .
      399   define variable v-mes   as character no-undo .
      400   define variable v-full-path        as character no-undo .
      401   define variable v-path             as character no-undo .
      402   define variable v-file-name        as character no-undo .
      403   define variable v-file-name-no-ext as character no-undo .
      404   define variable v-file-name-ext    as character no-undo .
      405   define variable v-md5-signature as character no-undo .
      406   define new shared temp-table tt-attr-prop no-undo like ub.attr-prop . find first buf_temp-tables where buf_temp-tables.tbl-name = "attr-prop" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "attr-prop"    buf_temp-tables.buf-handle = buffer tt-attr-prop:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
      407   define buffer buf_tt-attr-prop for tt-attr-prop.
      408   run waitfram-show in this-procedure ("Реинициализация конфигурации атрибутов").
      409   main-block:
      410   do
      411   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      412   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      413   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      414   :
      415     if ( g#db-num > 0 ) then return.
      416     if not p-forced then do:
      417       run check-ap-version in this-procedure (output v-check).
      418     end.
      419     if v-check
      420     or p-forced
      421     then do:
      422       if v-check
      423       and p-read-only
      424       then do:
      425         return error substitute("&1 &2 &3&4До начала работы с данной БД (режим RO) необходимо произвести вход в ОСНОВНУЮ БД!!!"
      426                                 ,vss-workfile
      427                                 ,vss-revision
      428                                 ,vss-description
      429                                 ,chr(10)).
      430       end.
      431       run gbl/md5.p (
      432          input  "cmp/fixattrp.txt"
      433         ,output v-md5-signature
      434         ) .
      435       if v-md5-signature <> "DE59B29624253F3DBA9EEE157BA08C70" then do:
      436         message
      437         substitute("Несовпадение файла эталонных записей по конфиг. атрибутов (fixattrp.txt) с контрольным числом")
      438         view-as alert-box error .
      439         undo, return error .
      440       end.
      441       run gbl/filename.p ( input "cmp/fixattrp.txt"
      442                           ,output v-full-path
      443                           ,output v-path
      444                           ,output v-file-name
      445                           ,output v-file-name-no-ext
      446                           ,output v-file-name-ext
      447                           ) no-error .
      448       if error-status:error then do:
      449         message
      450         substitute("Не найден файл эталонных записей по конфиг. атрибутов (fixattrp.txt)")
      451         view-as alert-box error .
      452         undo, return error .
      453       end.
      454       run str/diallog.w (
      455             input ?
      456           ,input this-procedure
      457           ,input ('utl/upgimptt.p' + chr(4)  +
      458                   '1' + chr(4) +
      459                   '1' + chr(4) +
      460                   '1' + chr(4) +
      461                   '1')
      462           ,input v-full-path
      463           ,input yes
      464           ,input 'Прервать'
      465           ,input 'Чтение файла в память') no-error .
      466       if error-status:error then do:
      467         message
      468         substitute("Ошибка при чтении в память файла кофигурации атрибутов (fixattrp.txt)&1&2&1&3"
      469                      , chr(10)
      470                      , error-status:get-message(1)
      471                      , return-value )
      472         view-as alert-box error .
      473         undo, return error .
      474       end.
      475       if v-check
      476       or p-forced
      477       then do:
      478         find first buf_tt-attr-prop no-lock where
      479                   buf_tt-attr-prop.table-name = '':U
      480               and buf_tt-attr-prop.templ-rl-root = 0
      481               and buf_tt-attr-prop.node-code = 0 no-error.
      482         if not available buf_tt-attr-prop
      483         or buf_tt-attr-prop.property-value <> "v15_1.3" then do:
      484           message
      485           substitute("Версии конфиг. атрибутов в r-кодах и файле конфигурации (fixattrp.txt) НЕ СОВПАДАЮТ&1" +
      486                      "в r-кодах - &2&1" +
      487                      "в файле - &3"
      488                      , chr(10)
      489                      , "v15_1.3"
      490                      , buf_tt-attr-prop.property-value
      491                      )
      492           view-as alert-box error .
      493           undo, return error .
      494         end.
      495       end.
      496       run add-attr-prop in this-procedure no-error .
      497       if error-status:error then do:
      498         run waitfram-hide in this-procedure .
      499         assign
      500         v-mes = substitute("Ошибки при инициализации конфигурации атрибутов:&1&2 &3"
      501                            , chr(10)
      502                            , error-status:get-message(1)
      503                            , return-value ).
      504         if p-forced then do:
      505           message
      506           v-mes
      507           view-as alert-box error .
      508         end.
      509         undo, return error v-mes.
      510       end.
      511     end.
      512     for each buf_temp-tables
      513     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      514     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      515     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      516     :
      517       if valid-handle(buf_temp-tables.tbl-handle) then do:
      518         delete object buf_temp-tables.tbl-handle.
      519        end.
      520     end.
      521   end.
      522   run waitfram-hide in this-procedure .
      523   procedure add-attr-prop :
      524   define variable v-cmp as logical no-undo .
      525   define variable v-error as logical no-undo .
      526   define buffer buf_tt-attr-prop for tt-attr-prop.
      527   define buffer buf2_tt-attr-prop for tt-attr-prop.
      528   define buffer buf_attr-prop for ub.attr-prop.
      529   define buffer buf2_attr-prop for ub.attr-prop.
      530   main-block:
      531   do
      532   on error undo, return error
      533   :
      534     _for:
      535     for each buf_tt-attr-prop
      536     where buf_tt-attr-prop.table-name > '':U
      537     break
      538     by buf_tt-attr-prop.table-name
      539     by buf_tt-attr-prop.templ-rl-root
      540     by buf_tt-attr-prop.node-code
      541     on error  undo _for, retry _for
      542     on stop   undo _for, retry _for
      543     on endkey undo _for, retry _for
      544     :
      545       if retry then do:
      546         v-error = yes.
      547         leave _for.
      548       end.
      549       if first-of(buf_tt-attr-prop.templ-rl-root) then do:
      550         for each buf2_tt-attr-prop where
      551                 buf2_tt-attr-prop.table-name = buf_tt-attr-prop.table-name
      552             and buf2_tt-attr-prop.templ-rl-root = buf_tt-attr-prop.templ-rl-root
      553         on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      554         on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      555         on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      556         :
      557           find first buf_attr-prop exclusive-lock where
      558                     buf_attr-prop.table-name = buf2_tt-attr-prop.table-name
      559                 and buf_attr-prop.templ-rl-root = buf2_tt-attr-prop.templ-rl-root
      560                 and buf_attr-prop.node-code = buf2_tt-attr-prop.node-code    no-error.
      561           v-cmp = yes.
      562           if not available buf_attr-prop then do:
      563             create buf_attr-prop.
      564             v-cmp = no.
      565           end.
      566           else do:
      567             buffer-compare buf_attr-prop to buf2_tt-attr-prop
      568             case-sensitive
      569             save result in v-cmp.
      570           end.
      571           if not v-cmp then do:
      572             buffer-copy buf2_tt-attr-prop to buf_attr-prop.
      573           end.
      574         end.
      575       end.
      576     end.
      577     if not v-error  then do:
      578       _for2:
      579       for each buf_attr-prop no-lock
      580       on error  undo _for2, retry _for2
      581       on stop   undo _for2, retry _for2
      582       on endkey undo _for2, retry _for2
      583       :
      584         if retry then do:
      585           v-error = yes.
      586           leave _for2.
      587         end.
      588         find first buf2_tt-attr-prop where
      589                   buf2_tt-attr-prop.table-name = buf_attr-prop.table-name
      590               and buf2_tt-attr-prop.templ-rl-root = buf_attr-prop.templ-rl-root
      591               and buf2_tt-attr-prop.node-code = buf_attr-prop.node-code no-error.
      592         if not available buf2_tt-attr-prop then do:
      593           find first buf2_attr-prop exclusive-lock where
      594                     recid(buf2_attr-prop) = recid(buf_attr-prop).
      595           delete buf2_attr-prop.
      596         end.
      597       end.
      598     end.
      599     if not v-error then do:
      600       find first buf_tt-attr-prop where
      601                 buf_tt-attr-prop.table-name = '':U
      602             and buf_tt-attr-prop.templ-rl-root = 0
      603             and buf_tt-attr-prop.node-code = 0 no-error .
      604       find first buf_attr-prop where
      605                 buf_attr-prop.table-name = '':U
      606             and buf_attr-prop.templ-rl-root = 0
      607             and buf_attr-prop.node-code = 0  no-error.
      608       if not available buf_attr-prop then do:
      609         create buf_attr-prop.
      610       end.
      611       if buf_attr-prop.property-value <> buf_tt-attr-prop.property-value then do:
      612         buffer-copy buf_tt-attr-prop to buf_attr-prop.
      613         release buf_tt-attr-prop no-error .
      614         if error-status:error then do:
      615           return error substitute("Ошибка при обновлении головной записи конфигурации атрибутов &1&2&3"
      616                                   , error-status:get-message(1)
      617                                   , return-value ).
      618         end.
      619       end.
      620     end.
      621     else do:
      622        return error substitute("Ошибка при обновлении конфигурации атрибутов &1&2&3"
      623                                , error-status:get-message(1)
      624                                , return-value ).
      625     end.
      626   end.
      627   end procedure.
