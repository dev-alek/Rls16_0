        1   block-level on error undo, throw.
        2   define input parameter parparentproc AS WIDGET-HANDLE NO-UNDO.
        3   define input parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
        4   define input parameter p-obj-type  like ub.doc-line.obj-type  no-undo .
        5   define input parameter p-obj-code  like ub.doc-line.obj-code  no-undo .
        6   define input parameter p-artic     like ub.doc-line.artic     no-undo .
        7   define input parameter p-prod-type like ub.doc-line.prod-type no-undo .
        8   define input parameter p-prod-code like ub.doc-line.prod-code no-undo .
        9   define input parameter p-update-doc-line as logical no-undo .
       10   define input parameter p-update-parts-info as character no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision$":U .
       12   define variable vss-author      as character no-undo init "$Author$":U .
       13   define variable vss-date        as character no-undo init "$Date$":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       15   define variable vss-archive     as character no-undo init "$Archive$":U .
       16   define variable vss-description as character no-undo init "Обновление информации в партиях на основании doc-line".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35       assign
       36         p-vss-parameters = substitute('&1|&2|&3',p-doc-code,p-update-doc-line,p-update-parts-info)
       37       .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74       define buffer   in-vatp-trn-doc  for ub.trn-doc .
       75       define buffer   in-vatp-parts    for ub.parts   .
       76       define buffer   in-vatp-doc      for ub.trn-doc .
       77       define buffer   in-vatp-goods    for ub.goods   .
       78       define buffer   in-vatp-sysconf  for ub.sysconf .
       79       define buffer   in-vatp_doc-attr for ub.doc-attr.
       80       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
       81       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
       82       define variable varinvprb                  as   character              no-undo.
       83       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
       84       define variable cli-base-rate              as   decimal                no-undo.
       85       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
       86       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
       87       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
       88       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
       89       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
       90       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
       91       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
       92       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
       93       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
       94       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
       95       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
       96       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
       97       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
       98       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
       99       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      100       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      101       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      102       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      103       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      104       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      105       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      106       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      107       define variable varinvatp-envd             as   character              no-undo.
      108       define variable varinvatp-type             as   character              no-undo.
      109   define new global shared variable g#language as character no-undo .
      110   if g#language <> '' and g#language <> 'rus':U then do:
      111     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      112   end.
      113   define new global shared variable g#library  as handle no-undo .
      114   define new global shared variable g#library2 as handle no-undo .
      115   define   shared variable g#auto as logical no-undo.
      116   define   shared variable g#news as logical no-undo.
      117   define   shared variable g#oxml as logical no-undo.
      118   define   shared variable g#esys as logical no-undo.
      119   define   shared variable g#news-source-db as integer no-undo.
      120   define   shared variable g#esys-source-esys as integer no-undo.
      121   define   shared variable g#db-num as integer   no-undo .
      122   define   shared variable g#userid as character no-undo .
      123   define   shared variable g#passwd as character no-undo .
      124   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   define temp-table temp-trndocrs-gds-dtl-rsrv no-undo
      126     field prt-code         like ub.gds-dtl.prt-code
      127     field rsrv-qnty        like ub.gds-dtl.fact-qnty
      128     field rsrv-out-qnty    like ub.gds-dtl.fact-qnty
      129     index xpk is primary unique prt-code
      130   .
      131   define temp-table temp-trndocrs-pl-gds-rsrv no-undo
      132     field pl-code          like ub.pl-gds.pl-code
      133     field rsrv-qnty        like ub.pl-gds.free-qnty
      134     field cli-rsrv-qnty    like ub.pl-gds.cli-free-qnty
      135     field rsrv-out-qnty    like ub.pl-gds.fact-qnty
      136     field before-free-qnty like ub.pl-gds.fact-qnty
      137     field before-out-qnty  like ub.pl-gds.fact-qnty
      138     field after-free-qnty  like ub.pl-gds.fact-qnty
      139     field after-out-qnty   like ub.pl-gds.fact-qnty
      140     field fact-qnty        like ub.pl-gds.fact-qnty
      141     field cli-qnty         like ub.pl-gds.cli-qnty
      142     field cli-fact-qnty    like ub.pl-gds.cli-fact-qnty
      143     index xpk is primary unique pl-code
      144   .
      145   procedure trndocrs-gds-dtl-clear :
      146     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      147     do
      148     on error undo, return error return-value
      149     :
      150       for each buf_temp-trndocrs-gds-dtl-rsrv
      151       on error undo, return error return-value
      152       :
      153         delete buf_temp-trndocrs-gds-dtl-rsrv .
      154       end.
      155     end.
      156   end procedure.
      157   procedure trndocrs-pl-gds-clear :
      158     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      159     do
      160     on error undo, return error return-value
      161     :
      162       for each buf_temp-trndocrs-pl-gds-rsrv
      163       on error undo, return error return-value
      164       :
      165         delete buf_temp-trndocrs-pl-gds-rsrv .
      166       end.
      167     end.
      168   end procedure.
      169   procedure trndocrs-clear :
      170     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      171     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      172     do
      173     on error undo, return error return-value
      174     :
      175       for each buf_temp-trndocrs-gds-dtl-rsrv
      176       on error undo, return error return-value
      177       :
      178         delete buf_temp-trndocrs-gds-dtl-rsrv .
      179       end.
      180       for each buf_temp-trndocrs-pl-gds-rsrv
      181       on error undo, return error return-value
      182       :
      183         delete buf_temp-trndocrs-pl-gds-rsrv .
      184       end.
      185     end.
      186   end procedure.
      187   procedure trndocrs-pl-gds-accum :
      188     define input parameter p-pl-code       like ub.pl-gds.pl-code       no-undo .
      189     define input parameter p-rsrv-qnty     like ub.pl-gds.free-qnty     no-undo .
      190     define input parameter p-cli-rsrv-qnty like ub.pl-gds.cli-free-qnty no-undo .
      191     define input parameter p-fact-qnty     like ub.pl-gds.fact-qnty     no-undo .
      192     define input parameter p-cli-fact-qnty like ub.pl-gds.cli-fact-qnty no-undo .
      193     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      194     do
      195     on error undo, return error return-value
      196     :
      197       find first buf_temp-trndocrs-pl-gds-rsrv
      198         where buf_temp-trndocrs-pl-gds-rsrv.pl-code = p-pl-code
      199         no-error .
      200       if not available buf_temp-trndocrs-pl-gds-rsrv then do:
      201         create buf_temp-trndocrs-pl-gds-rsrv .
      202         assign
      203           buf_temp-trndocrs-pl-gds-rsrv.pl-code = p-pl-code
      204         .
      205       end.
      206       assign
      207         buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty     = buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty     + p-rsrv-qnty
      208         buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty = buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty + p-cli-rsrv-qnty
      209         buf_temp-trndocrs-pl-gds-rsrv.fact-qnty     = buf_temp-trndocrs-pl-gds-rsrv.fact-qnty     + p-fact-qnty
      210         buf_temp-trndocrs-pl-gds-rsrv.cli-fact-qnty = buf_temp-trndocrs-pl-gds-rsrv.cli-fact-qnty + p-cli-fact-qnty
      211       .
      212     end.
      213   end procedure.
      214   procedure trndocrs-gds-dtl-accum :
      215     define input parameter p-prt-code   like ub.gds-dtl.prt-code   no-undo .
      216     define input parameter p-rsrv-qnty like ub.gds-dtl.fact-qnty no-undo .
      217     define buffer buf_temp-trndocrs-gds-dtl-rsrv  for temp-trndocrs-gds-dtl-rsrv .
      218     do
      219     on error undo, return error return-value
      220     :
      221       find first buf_temp-trndocrs-gds-dtl-rsrv
      222         where buf_temp-trndocrs-gds-dtl-rsrv.prt-code = p-prt-code
      223         no-error .
      224       if not available buf_temp-trndocrs-gds-dtl-rsrv then do:
      225         create buf_temp-trndocrs-gds-dtl-rsrv .
      226         assign
      227           buf_temp-trndocrs-gds-dtl-rsrv.prt-code = p-prt-code
      228         .
      229       end.
      230       assign
      231         buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty = buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
      232                                                + p-rsrv-qnty
      233       .
      234     end.
      235   end procedure.
      236   procedure trndocrs-pl-gds-request :
      237     define input parameter p-doc-code               like ub.doc-line.doc-code  no-undo .
      238     define input parameter p-doc-type               like ub.trn-doc.doc-type   no-undo .
      239     define input parameter p-obj-type               like ub.doc-line.obj-type  no-undo .
      240     define input parameter p-obj-code               like ub.doc-line.obj-code  no-undo .
      241     define input parameter p-artic                  like ub.doc-line.artic     no-undo .
      242     define input parameter p-prod-type              like ub.doc-line.prod-type no-undo .
      243     define input parameter p-prod-code              like ub.doc-line.prod-code no-undo .
      244     define input parameter p-field-accum            as character no-undo .
      245     define variable vss-description as character no-undo init "trndocrs-pl-gds-request: Сбор информации о партиях на складских местах".
      246     define buffer buf_temp-trndocrs-pl-gds-rsrv for temp-trndocrs-pl-gds-rsrv .
      247     do
      248     on error undo, return error return-value
      249     :
      250       if lookup(p-field-accum, "before,after":u ) = 0 then do:
      251         message
      252           vss-workfile vss-revision vss-description skip
      253           vss-include-info0 skip
      254           "Ошибка задания входных параметров параметров" skip
      255           "Неизвестное значение параметра" skip
      256           "p-field-accum" p-field-accum skip
      257           view-as alert-box error .
      258         undo, return error return-value .
      259       end.
      260       case p-field-accum :
      261         when "before":u then do:
      262           for each buf_temp-trndocrs-pl-gds-rsrv
      263           on error undo, return error return-value
      264           :
      265             assign
      266               buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty = 0
      267               buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty  = 0
      268             .
      269           end.
      270         end.
      271         when "after":u then do:
      272           for each buf_temp-trndocrs-pl-gds-rsrv
      273           on error undo, return error return-value
      274           :
      275             assign
      276               buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty  = 0
      277               buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty   = 0
      278             .
      279           end.
      280         end.
      281         otherwise do:
      282           message
      283             vss-workfile vss-revision vss-description skip
      284             vss-include-info0 skip
      285             "Ошибка задания входных параметров параметров" skip
      286             "Неизвестное значение параметра" skip
      287             "p-field-accum" p-field-accum skip
      288             view-as alert-box error .
      289           undo, return error return-value .
      290         end.
      291       end.
      292       define buffer buf_parts for ub.parts.
      293       for each buf_parts no-lock
      294         where buf_parts.out-code  = p-doc-code
      295           and buf_parts.obj-type  = p-obj-type
      296           and buf_parts.obj-code  = p-obj-code
      297           and buf_parts.artic     = p-artic
      298           and buf_parts.prod-type = p-prod-type
      299           and buf_parts.prod-code = p-prod-code
      300       on error undo, return error return-value
      301       :
      302         find first buf_temp-trndocrs-pl-gds-rsrv
      303           where buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_parts.pl-code
      304           no-error .
      305         if not available buf_temp-trndocrs-pl-gds-rsrv then do:
      306           create buf_temp-trndocrs-pl-gds-rsrv .
      307           assign
      308             buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_parts.pl-code
      309           .
      310         end.
      311         if can-do('при,рас,спи':U, p-doc-type)
      312         or (p-doc-type = 'инв':U
      313             and buf_parts.fact-qnty < 0)
      314         then do:
      315           case p-field-accum :
      316             when "before":u then do:
      317               assign
      318                 buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
      319                   = buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
      320                   + abs(buf_parts.fact-qnty)
      321               .
      322             end.
      323             when "after":u then do:
      324               assign
      325                 buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
      326                   = buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
      327                   + abs(buf_parts.fact-qnty)
      328               .
      329             end.
      330             otherwise do:
      331               message
      332                 vss-workfile vss-revision vss-description skip
      333                 vss-include-info0 skip
      334                 "Ошибка задания входных параметров параметров" skip
      335                 "Неизвестное значение параметра" skip
      336                 "p-field-accum" p-field-accum skip
      337                 view-as alert-box error .
      338               undo, return error return-value .
      339             end.
      340           end.
      341         end.
      342         else do:
      343           case p-field-accum :
      344             when "before":u then do:
      345               assign
      346                 buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
      347                   = buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
      348                   + abs(buf_parts.fact-qnty)
      349               .
      350             end.
      351             when "after":u then do:
      352               assign
      353                 buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
      354                   = buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
      355                   + abs(buf_parts.fact-qnty)
      356               .
      357             end.
      358             otherwise do:
      359               message
      360                 vss-workfile vss-revision vss-description skip
      361                 vss-include-info0 skip
      362                 "Ошибка задания входных параметров параметров" skip
      363                 "Неизвестное значение параметра" skip
      364                 "p-field-accum" p-field-accum skip
      365                 view-as alert-box error .
      366               undo, return error return-value .
      367             end.
      368           end.
      369         end.
      370       end.
      371     end.
      372   end procedure.
      373   procedure trndocrs-pl-gds-calc-rsrv :
      374     define variable vss-description as character no-undo init "trndocrs-pl-gds-calc-rsrv: Сбор информации о партиях на складских местах".
      375     define buffer buf_temp-trndocrs-pl-gds-rsrv for temp-trndocrs-pl-gds-rsrv .
      376     do
      377     on error undo, return error return-value
      378     :
      379       for each buf_temp-trndocrs-pl-gds-rsrv
      380       on error undo, return error return-value
      381       :
      382         assign
      383           buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
      384             = buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
      385             - buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
      386           buf_temp-trndocrs-pl-gds-rsrv.rsrv-out-qnty
      387             = buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
      388             - buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
      389         .
      390       end.
      391     end.
      392   end procedure.
      393   procedure trndocrs-need-rsrv :
      394     define input  parameter p-doc-type     like ub.trn-doc.doc-type no-undo .
      395     define input  parameter p-artic        like ub.doc-line.artic     no-undo .
      396     define input  parameter p-prod-type    like ub.doc-line.prod-type no-undo .
      397     define input  parameter p-prod-code    like ub.doc-line.prod-code no-undo .
      398     define output parameter p-need-rsrv    as logical   no-undo .
      399     define buffer buf_goods   for ub.goods .
      400     do
      401     on error undo, return error return-value
      402     :
      403       find first buf_goods no-lock
      404         where buf_goods.artic     = p-artic
      405           and buf_goods.prod-type = p-prod-type
      406           and buf_goods.prod-code = p-prod-code
      407         .
      408       if buf_goods.gds-type = 'т':U
      409       and ( p-doc-type = 'рас':U
      410             or p-doc-type = 'спи':U
      411           )
      412       then do:
      413         assign
      414           p-need-rsrv = true
      415         .
      416       end.
      417       else do:
      418         assign
      419           p-need-rsrv = false
      420         .
      421       end.
      422     end.
      423   end procedure.
      424   procedure trndocrs-need-create-doc-pl :
      425     define input  parameter p-extended-doc-type  as character no-undo .
      426     define input  parameter p-news               as logical   no-undo .
      427     define input  parameter p-sale-auto          as logical   no-undo .
      428     define output parameter p-need-create-doc-pl as logical   no-undo .
      429     do
      430     on error undo, return error return-value
      431     :
      432       if  not p-news
      433       and p-extended-doc-type <> 'ie':U
      434       and p-extended-doc-type <> 'es':U
      435       and p-extended-doc-type <> 'rs':U
      436       and not p-sale-auto
      437       then do:
      438         assign
      439           p-need-create-doc-pl = true
      440         .
      441       end.
      442       else do:
      443         assign
      444           p-need-create-doc-pl = false
      445         .
      446       end.
      447     end.
      448   end procedure.
      449   procedure trndocrs-validate :
      450     define input parameter p-place-rsrv as logical no-undo .
      451     define input parameter p-chg-qnty   as decimal no-undo .
      452     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      453     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      454     define variable v-total-gds-dtl-rsrv-qnty as decimal no-undo .
      455     define variable v-total-pl-gds-rsrv-qnty as decimal no-undo .
      456     assign
      457       v-total-gds-dtl-rsrv-qnty = 0
      458       v-total-pl-gds-rsrv-qnty  = 0
      459     .
      460     do
      461     on error undo, return error return-value
      462     :
      463       for each buf_temp-trndocrs-gds-dtl-rsrv
      464       on error undo, return error return-value
      465       :
      466         assign
      467           v-total-gds-dtl-rsrv-qnty = v-total-gds-dtl-rsrv-qnty
      468                                     + buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
      469         .
      470       end.
      471       for each buf_temp-trndocrs-pl-gds-rsrv
      472       on error undo, return error return-value
      473       :
      474         assign
      475           v-total-pl-gds-rsrv-qnty = v-total-pl-gds-rsrv-qnty
      476                                    + buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
      477         .
      478       end.
      479       if round(v-total-gds-dtl-rsrv-qnty, 0) <> round(p-chg-qnty, 0) then do:
      480         message
      481           vss-workfile vss-revision vss-description skip
      482           vss-include-info0 skip
      483           "Ошибка при резервировании свободных количеств" skip
      484           "Запрошено резервирование:" skip
      485           "По товару" p-chg-qnty skip
      486           "По признакам" v-total-gds-dtl-rsrv-qnty skip
      487           "По складским местам" v-total-pl-gds-rsrv-qnty skip
      488           view-as alert-box error .
      489         undo, return error return-value .
      490       end.
      491       if p-place-rsrv then do:
      492         if round(v-total-pl-gds-rsrv-qnty, 0) <> round(p-chg-qnty, 0) then do:
      493           message
      494             vss-workfile vss-revision vss-description skip
      495             vss-include-info0 skip
      496             "Ошибка при резервировании свободных количеств" skip
      497             "Запрошено резервирование:" skip
      498             "По товару" p-chg-qnty skip
      499             "По признакам" v-total-gds-dtl-rsrv-qnty skip
      500             "По складским местам" v-total-pl-gds-rsrv-qnty skip
      501             view-as alert-box error .
      502           undo, return error return-value .
      503         end.
      504       end.
      505     end.
      506   end procedure.
      507   procedure trndocrs :
      508     define input parameter p-doc-code   like ub.doc-line.doc-code  no-undo .
      509     define input parameter p-obj-type   like ub.doc-line.obj-type  no-undo .
      510     define input parameter p-obj-code   like ub.doc-line.obj-code  no-undo .
      511     define input parameter p-artic      like ub.doc-line.artic     no-undo .
      512     define input parameter p-prod-type  like ub.doc-line.prod-type no-undo .
      513     define input parameter p-prod-code  like ub.doc-line.prod-code no-undo .
      514     define input parameter p-chg-qnty   as decimal no-undo .
      515     define buffer buf_db         for ub.db .
      516     define buffer buf_gds-obj    for ub.gds-obj .
      517     define buffer buf_prt-obj    for ub.prt-obj .
      518     define buffer buf_gds-prt    for ub.gds-prt .
      519     define buffer buf_goods      for ub.goods .
      520     define buffer buf_pl-gds     for ub.pl-gds .
      521     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      522     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      523     define variable v-node-code   like ub.gds-prt.node-code no-undo .
      524     define variable v-curr-db-num like ub.db.db-num         no-undo .
      525     define variable v-cmd         as   character            no-undo .
      526     do
      527     on error undo, return error return-value
      528     :
      529   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      530   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      531     (input  p-obj-type
      532     ,input  p-obj-code
      533     ,input  p-artic
      534     ,input  p-prod-type
      535     ,input  p-prod-code
      536     ,buffer buf_gds-obj
      537     ) no-error .
      538       if error-status :error then do:
      539         message
      540           vss-workfile vss-revision vss-description skip
      541           vss-include-info0 skip
      542           "Ошибка при поиске товара на объекте" skip
      543           "p-obj-type"  p-obj-type  skip
      544           "p-obj-code"  p-obj-code  skip
      545           "p-artic"     p-artic     skip
      546           "p-prod-type" p-prod-type skip
      547           "p-prod-code" p-prod-code skip
      548           error-status :get-message(1) skip
      549           return-value skip
      550           view-as alert-box error .
      551         undo, return error return-value .
      552       end.
      553       find current buf_gds-obj exclusive-lock .
      554       run trndocrs-validate in this-procedure
      555         (input buf_gds-obj.place-rsrv
      556         ,input p-chg-qnty
      557         ) no-error .
      558       if error-status :error then do:
      559         message
      560           vss-workfile vss-revision vss-description skip
      561           vss-include-info0 skip
      562           "Противоречивые данные для резервирования" skip
      563           error-status :get-message(1) skip
      564           return-value skip
      565           view-as alert-box error .
      566         undo, return error return-value .
      567       end.
      568       assign
      569         buf_gds-obj.free-qnty   = buf_gds-obj.free-qnty - p-chg-qnty
      570         buf_gds-obj.on-line-rest = buf_gds-obj.free-qnty
      571       .
      572   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
      573     (input ?
      574     ,input this-procedure:handle
      575     ,input ?
      576     ,input  'rest-update':U
      577     ,input ?
      578     ,input  buffer buf_gds-obj:handle
      579     ,input 'fact-qnty,free-qnty'
      580     ,input ''
      581     ) no-error .
      582   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      583   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      584     (output v-curr-db-num
      585     )  .
      586       find first buf_db no-lock
      587         where buf_db.db-num = v-curr-db-num
      588         .
      589       if buf_db.db-num <> 0
      590         and buf_db.on-line-rest = true
      591       then do:
      592         assign
      593           v-cmd = "command":U + chr(1)
      594                   + "create":U + chr(1)
      595                   + "on-line-rest":U + chr(1)
      596                   + substitute( "&1", buf_gds-obj.obj-type ) + chr(1)
      597                   + substitute( "&1", buf_gds-obj.obj-code ) + chr(1)
      598                   + substitute( "&1", buf_gds-obj.artic ) + chr(1)
      599                   + substitute( "&1", buf_gds-obj.prod-type ) + chr(1)
      600                   + substitute( "&1", buf_gds-obj.prod-code ) + chr(1)
      601                   + substitute( "&1", buf_gds-obj.free-qnty ) + chr(1)
      602         .
      603         run nws/cr-route.p
      604           ( input 'send-cmd':U
      605             ,input v-cmd
      606             ,input ?
      607             ,input "0":U
      608           ).
      609       end.
      610       if buf_gds-obj.place-rsrv = true then do:
      611         for each buf_temp-trndocrs-pl-gds-rsrv
      612         on error undo, return error return-value
      613         :
      614           find first buf_goods no-lock
      615             where buf_goods.artic     = p-artic
      616               and buf_goods.prod-type = p-prod-type
      617               and buf_goods.prod-code = p-prod-code
      618             no-error .
      619           if not available buf_goods then do:
      620             message
      621               vss-workfile vss-revision vss-description skip
      622               vss-include-info0 skip
      623               "Не найдена товар" skip
      624               "Артикул" p-artic p-prod-type p-prod-code skip
      625               view-as alert-box error .
      626             undo, return error return-value .
      627           end.
      628           find first buf_pl-gds exclusive-lock
      629             where buf_pl-gds.obj-type = p-obj-type
      630               and buf_pl-gds.obj-code = p-obj-code
      631               and buf_pl-gds.gds-code = buf_goods.gds-code
      632               and buf_pl-gds.pl-code  = buf_temp-trndocrs-pl-gds-rsrv.pl-code
      633             no-error .
      634           if not available buf_pl-gds then do:
      635             message
      636               vss-workfile vss-revision vss-description skip
      637               vss-include-info0 skip
      638               "Не найдена привязка товара к складскому месту" skip
      639               "Код товара" buf_temp-trndocrs-pl-gds-rsrv.pl-code skip
      640               view-as alert-box error .
      641             undo, return error return-value .
      642           end.
      643           assign
      644             buf_pl-gds.free-qnty     = buf_pl-gds.free-qnty     - buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
      645             buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-free-qnty - buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty
      646           .
      647           if buf_pl-gds.free-qnty = buf_pl-gds.fact-qnty
      648             and absolute( buf_pl-gds.cli-free-qnty - buf_pl-gds.cli-fact-qnty ) <= 0.01
      649           then do:
      650             assign
      651               buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-fact-qnty
      652             .
      653           end.
      654         end.
      655       end.
      656       for each buf_temp-trndocrs-gds-dtl-rsrv
      657       on error undo, return error return-value
      658       :
      659   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
      660     (input  buf_temp-trndocrs-gds-dtl-rsrv.prt-code
      661     ,output v-node-code
      662     ) no-error .
      663         if error-status :error then do:
      664           message
      665             vss-workfile vss-revision vss-description skip
      666             vss-include-info0 skip
      667             "Ошибка при определении первого терминального признака" skip
      668             "prt-code" buf_temp-trndocrs-gds-dtl-rsrv.prt-code skip
      669             view-as alert-box error .
      670           undo, return error return-value .
      671         end.
      672         find first buf_gds-prt no-lock
      673           where buf_gds-prt.node-code = v-node-code
      674           .
      675         do while available buf_gds-prt
      676         on error undo, return error return-value
      677         :
      678   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      679   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtobjcr in g#library
      680     (input  p-obj-type
      681     ,input  p-obj-code
      682     ,input  p-artic
      683     ,input  p-prod-type
      684     ,input  p-prod-code
      685     ,input  buf_gds-prt.node-code
      686     ,buffer buf_prt-obj
      687     )  .
      688           find current buf_prt-obj exclusive-lock .
      689           assign
      690             buf_prt-obj.free-qnty = buf_prt-obj.free-qnty - buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
      691           .
      692           assign
      693             v-node-code = buf_gds-prt.upper-code
      694           .
      695           find first buf_gds-prt no-lock
      696             where buf_gds-prt.node-code = v-node-code
      697             no-error .
      698         end.
      699       end.
      700     end.
      701   end procedure.
      702   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      703   function octal-to-char return character
      704   ( p-string as character ) :
      705     def var v-asc     as integer no-undo .
      706     def var v-new-asc as integer no-undo .
      707     def var ind       as integer no-undo .
      708     if length(p-string) <> 3 then do:
      709       return ? .
      710     end.
      711     assign
      712       v-asc = 0
      713     .
      714     do ind = 1 to length(p-string)
      715     :
      716       assign
      717         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      718       .
      719       if v-new-asc < 0 or v-new-asc >= 8 then do:
      720         return ? .
      721       end.
      722       assign
      723         v-asc = v-asc * 8 + v-new-asc
      724       .
      725     end.
      726     return chr(v-asc) .
      727   end function .
      728   function char-to-octal return character
      729   ( p-chr as character ) :
      730     def var v-asc    as integer   no-undo .
      731     def var ind      as integer   no-undo .
      732     def var v-string as character no-undo .
      733     if length(p-chr) <> 1 then do:
      734       return ? .
      735     end.
      736     assign
      737       v-asc    = asc(p-chr)
      738       v-string = ""
      739     .
      740     do ind = 1 to 3
      741     :
      742       assign
      743         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      744       .
      745       assign
      746         v-asc = truncate(v-asc / 8, 0)
      747       .
      748     end.
      749     return v-string .
      750   end.
      751   function str-encode return character
      752   (   p-init-string       as character
      753     , p-encode-char       as character
      754     , p-special-char-list as character
      755   ) :
      756     def var p-encode-string as character no-undo .
      757     def var ind                as integer no-undo .
      758     def var v-num-special-char as integer no-undo .
      759     def var v-special-char     as character no-undo .
      760     if p-encode-char = ?
      761     or p-encode-char = "" then do:
      762       assign
      763         p-encode-char = "~~"
      764       .
      765     end.
      766     if p-init-string = ? then do:
      767       return "?" .
      768     end.
      769     if p-init-string = "?" then do:
      770       return p-encode-char + char-to-octal("?") .
      771     end.
      772     assign
      773       v-num-special-char = length(p-special-char-list)
      774       p-encode-string    = replace(p-init-string
      775                                   ,p-encode-char
      776                                   ,p-encode-char + char-to-octal(p-encode-char)
      777                                   )
      778     .
      779     do ind = 1 to v-num-special-char
      780     :
      781       assign
      782         v-special-char = substring(p-special-char-list, ind, 1)
      783       .
      784       if v-special-char <> p-encode-char then do:
      785         assign
      786           p-encode-string = replace (p-encode-string
      787                                     ,v-special-char
      788                                     ,p-encode-char + char-to-octal(v-special-char)
      789                                     )
      790         .
      791       end.
      792     end.
      793     return p-encode-string .
      794   end.
      795   function str-decode returns character
      796     (p-init-string   as character
      797     ,p-encode-char   as character
      798     ) :
      799     def var p-decode-string as character no-undo .
      800     def var ind                       as integer no-undo .
      801     def var v-num-entries-init-string as integer no-undo .
      802     def var v-sub-phrase              as character no-undo .
      803     def var v-special-char            as character no-undo .
      804     if p-encode-char = ?
      805     or p-encode-char = "" then do:
      806       assign
      807         p-encode-char = "~~"
      808       .
      809     end.
      810     if p-init-string = "?" then do:
      811       return ? .
      812     end.
      813     assign
      814       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      815     .
      816     if v-num-entries-init-string > 1 then do:
      817       assign
      818         p-decode-string = entry(1, p-init-string, p-encode-char)
      819       .
      820       do ind = 2 to v-num-entries-init-string
      821       :
      822         assign
      823           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      824         .
      825         assign
      826           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      827         .
      828         if v-special-char <> ? then do:
      829           assign
      830             p-decode-string = p-decode-string
      831                             + v-special-char
      832                             + substring(v-sub-phrase, 4)
      833           .
      834         end.
      835         else do:
      836           assign
      837             p-decode-string = p-decode-string
      838                             + p-encode-char
      839                             + v-sub-phrase
      840           .
      841         end.
      842       end.
      843     end.
      844     else do:
      845       assign
      846         p-decode-string = p-init-string
      847       .
      848     end.
      849     return p-decode-string .
      850   end.
      851   define buffer buf_doc-line for ub.doc-line .
      852   define buffer buf_trn-doc  for ub.trn-doc .
      853   define variable v-goods-twounit                  as logical   no-undo .
      854   define variable v-update-cst-code                as logical   no-undo .
      855   define variable v-cst-code                       as character no-undo .
      856   define variable v-update-last-date               as logical   no-undo .
      857   define variable v-last-date                      as date      no-undo .
      858   define variable v-update-contract-code           as logical   no-undo .
      859   define variable v-contract-code                  as integer   no-undo .
      860   define variable v-update-mark-code               as logical   no-undo .
      861   define variable v-mark-db-num                    as integer   no-undo .
      862   define variable v-mark-code                      as integer   no-undo .
      863   define variable v-update-alc-bottling-date       as logical   no-undo .
      864   define variable v-alc-bottling-date              as date      no-undo .
      865   define variable v-update-alc-ref-ab-path         as logical   no-undo .
      866   define variable v-alc-ref-ab-path                as character no-undo .
      867   define variable v-update-alc-quality-certif-path as logical   no-undo .
      868   define variable v-alc-quality-certif-path        as character no-undo .
      869   define variable v-update-alc-certif-path         as logical   no-undo .
      870   define variable v-alc-certif-path                as character no-undo .
      871   define variable v-update-alc-imp-type            as logical   no-undo .
      872   define variable v-alc-imp-type                   as character no-undo .
      873   define variable v-update-alc-imp-code            as logical   no-undo .
      874   define variable v-alc-imp-code                   as integer   no-undo .
      875   define variable v-update-dop                     as logical   no-undo .
      876   define variable v-dop                            as character   no-undo .
      877   main-block:
      878   do
      879   on error undo main-block, return error
      880   :
      881     run check-input-parameters in this-procedure
      882       (input p-update-parts-info
      883       ) no-error .
      884     if error-status :error
      885     then do:
      886       message
      887         vss-workfile vss-revision vss-description skip
      888         "Ошибка задания входных параметров" skip
      889         "Объект" p-obj-type p-obj-code skip
      890         "Артикул" p-artic p-prod-type p-prod-code skip
      891         "p-update-parts-info" p-update-parts-info skip
      892         error-status :error skip
      893         return-value skip
      894         view-as alert-box .
      895       undo, return error .
      896     end.
      897     find first buf_doc-line no-lock
      898       where buf_doc-line.doc-code  = p-doc-code
      899         and buf_doc-line.artic     = p-artic
      900         and buf_doc-line.prod-type = p-prod-type
      901         and buf_doc-line.prod-code = p-prod-code
      902       no-error .
      903     if not available buf_doc-line
      904     then do:
      905       message
      906         vss-workfile vss-revision vss-description skip
      907         "Не найдена строка накладной" skip
      908         "Документ" p-doc-code skip
      909         "Артикул" p-artic p-prod-type p-prod-code skip
      910         view-as alert-box error .
      911       undo, return error .
      912     end.
      913     find first buf_trn-doc no-lock
      914       where buf_trn-doc.doc-code = buf_doc-line.doc-code
      915       no-error .
      916     if not available buf_trn-doc
      917     then do:
      918       message
      919         vss-workfile vss-revision vss-description skip
      920         "Не найден складской документ" skip
      921         "Документ" buf_doc-line.doc-code skip
      922         view-as alert-box error .
      923       undo, return error .
      924     end.
      925   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
