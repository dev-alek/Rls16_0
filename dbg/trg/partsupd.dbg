     1153                                 + ub.parts.transport-base
     1154                                 + ub.parts.other-base
     1155         ub.parts.price-rubl     = ub.parts.price-rubl
     1156                                 + ub.parts.transport-rubl
     1157                                 + ub.parts.other-rubl
     1158       .
     1159       assign
     1160         ub.parts.pay-code      = buf_trn-doc.pay-code
     1161         ub.parts.supp-code     = buf_trn-doc.cli-code
     1162         ub.parts.supp-type     = buf_trn-doc.cli-type
     1163         ub.parts.exch-code     = buf_trn-doc.exch-code
     1164         ub.parts.VAT-type      = buf_trn-doc.vat-type
     1165         ub.parts.VAT-pc        = buf_doc-line.vat-pc
     1166         ub.parts.SLT-type      = buf_trn-doc.SLT-type
     1167         ub.parts.SLt-pc        = buf_doc-line.SLT-pc
     1168         ub.parts.host-code     = buf_trn-doc.host-code
     1169       .
     1170       if v-update-cst-code
     1171       then do:
     1172         assign
     1173           ub.parts.cst-code = v-cst-code
     1174         .
     1175       end.
     1176       else do:
     1177         if trim(ub.parts.cst-code) = ""
     1178         then do:
     1179           assign
     1180             ub.parts.cst-code = buf_trn-doc.cst-code
     1181           .
     1182         end.
     1183       end.
     1184       if v-update-last-date
     1185       then do:
     1186         assign
     1187           ub.parts.last-date = v-last-date
     1188         .
     1189       end.
     1190       if v-update-contract-code
     1191       then do:
     1192         assign
     1193           ub.parts.contract-code = v-contract-code
     1194         .
     1195       end.
     1196       if v-update-mark-code
     1197       then do:
     1198         assign
     1199           ub.parts.mark-db-num = v-mark-db-num
     1200           ub.parts.mark-code   = v-mark-code
     1201         .
     1202       end.
     1203       if v-update-alc-bottling-date
     1204       then do:
     1205         assign
     1206           ub.parts.alc-bottling-date = v-alc-bottling-date
     1207         .
     1208       end.
     1209       if v-update-alc-ref-ab-path
     1210       then do:
     1211         assign
     1212           ub.parts.alc-ref-ab-path = v-alc-ref-ab-path
     1213         .
     1214       end.
     1215       if v-update-alc-quality-certif-path
     1216       then do:
     1217         assign
     1218           ub.parts.alc-quality-certif-path = v-alc-quality-certif-path
     1219         .
     1220       end.
     1221       if v-update-alc-certif-path
     1222       then do:
     1223         assign
     1224           ub.parts.alc-certif-path = v-alc-certif-path
     1225         .
     1226       end.
     1227       if v-update-alc-imp-type
     1228       then do:
     1229         assign
     1230           ub.parts.alc-imp-type = v-alc-imp-type
     1231         .
     1232       end.
     1233       if v-update-alc-imp-code
     1234       then do:
     1235         assign
     1236           ub.parts.alc-imp-code = v-alc-imp-code
     1237         .
     1238       end.
     1239       if v-update-dop
     1240       then do:
     1241         assign
     1242           ub.parts.dop = v-dop
     1243         .
     1244       end.
     1245       if v-goods-twounit = false
     1246       then do:
     1247         assign
     1248           ub.parts.cli-base-rate = buf_doc-line.cli-base-rate
     1249         .
     1250   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run qntycalc in g#library
     1251     (input  'cli-qnty'
     1252     ,input  ub.parts.cli-base-rate
     1253     ,input  ub.parts.cli-qnty
     1254     ,input  ub.parts.qnty
     1255     ,output ub.parts.cli-qnty
     1256     ,output ub.parts.qnty
     1257     ) no-error .
     1258         if error-status :error
     1259         then do:
     1260           message
     1261             "Невозможно пересчитать количество по ТТН" skip
     1262             "Документ" ub.parts.out-code skip
     1263             "Артикул" ub.parts.artic ub.parts.prod-type ub.parts.prod-code skip
     1264             "Партия" + string(ub.parts.part-code) skip
     1265             return-value skip
     1266             view-as alert-box .
     1267           undo, return error .
     1268         end.
     1269       end.
     1270     end.
     1271     if p-update-doc-line
     1272     then do:
     1273       find current buf_doc-line exclusive-lock .
     1274       run trg/rsrv-gds.p
     1275         (input parparentproc
     1276         ,buffer buf_doc-line
     1277         ,input  0
     1278         ,input  0
     1279         ,input table temp-trndocrs-gds-dtl-rsrv
     1280         ,input table temp-trndocrs-pl-gds-rsrv
     1281         ) no-error .
     1282       if error-status :error
     1283       then do:
     1284         message
     1285           "Невозможно зарезервировать товар по признакам" skip
     1286           "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
     1287           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     1288           error-status :error skip
     1289           return-value skip
     1290           view-as alert-box .
     1291         undo, return error .
     1292       end.
     1293     end.
     1294   end.
     1295   procedure check-input-parameters :
     1296     define input parameter p-action as character no-undo .
     1297     define variable ind                    as integer no-undo .
     1298     define variable v-num-entries-p-action as integer no-undo .
     1299     assign
     1300       v-update-cst-code                = false
     1301       v-cst-code                       = ""
     1302       v-update-last-date               = false
     1303       v-last-date                      = ?
     1304       v-update-contract-code           = false
     1305       v-contract-code                  = 0
     1306       v-update-mark-code               = false
     1307       v-mark-db-num                    = 0
     1308       v-mark-code                      = 0
     1309       v-update-alc-bottling-date       = false
     1310       v-alc-bottling-date              = ?
     1311       v-update-alc-ref-ab-path         = false
     1312       v-alc-ref-ab-path                = ""
     1313       v-update-alc-quality-certif-path = false
     1314       v-alc-quality-certif-path        = ""
     1315       v-update-alc-certif-path         = false
     1316       v-alc-certif-path                = ""
     1317       v-update-alc-imp-type            = false
     1318       v-alc-imp-type                   = ""
     1319       v-update-alc-imp-code            = false
     1320       v-alc-imp-code                   = 0
     1321       v-dop                            = ""
     1322     .
     1323     assign
     1324       v-num-entries-p-action = num-entries(p-action)
     1325     .
     1326     do ind = 1 to v-num-entries-p-action
     1327     :
     1328       define variable v-option       as character no-undo .
     1329       define variable v-option-key   as character no-undo .
     1330       define variable v-option-value as character no-undo .
     1331       assign
     1332         v-option = entry(ind, p-action)
     1333       .
     1334       if v-option = ""
     1335       or v-option = ?
     1336       then do:
     1337         message
     1338           vss-workfile vss-revision vss-description skip
     1339           "Ошибка при задании параметров вызова резервирования" skip
     1340           "В качестве параметров резервирования задана пустая или неопределенная опция" skip
     1341           "v-option" v-option skip
     1342           "p-action" p-action skip
     1343           view-as alert-box error .
     1344         undo, return error .
     1345       end.
     1346       assign
     1347         v-option-key = entry(1, v-option, "=" )
     1348       .
     1349       case v-option-key :
     1350         when 'cst-code':U
     1351         then do:
     1352           if num-entries(v-option, "=") <> 2
     1353           then do:
     1354             message
     1355               vss-workfile vss-revision vss-description skip
     1356               "Ошибка при задании параметров вызова резервирования" skip
     1357               "Для указания кода ГТД необходимо указать строку" skip
     1358               "" 'cst-code':U + "=Код ГТД" skip
     1359               "v-option" v-option skip
     1360               "p-action" p-action skip
     1361               view-as alert-box error .
     1362             undo, return error .
     1363           end.
     1364           assign
     1365             v-option-value = entry(2, v-option, "=" )
     1366           .
     1367           assign
     1368             v-update-cst-code = true
     1369             v-cst-code        = str-decode(v-option-value, "")
     1370           .
     1371         end.
     1372         when 'last-date':U
     1373         then do:
     1374           if num-entries(v-option, "=") <> 2
     1375           then do:
     1376             message
     1377               vss-workfile vss-revision vss-description skip
     1378               "Ошибка при задании параметров вызова резервирования" skip
     1379               "Для указания списка типов приобретения необходимо указать строку" skip
     1380               "" 'last-date':U + "=Дата срока годности до" skip
     1381               "v-option" v-option skip
     1382               "p-action" p-action skip
     1383               view-as alert-box error .
     1384             undo, return error .
     1385           end.
     1386           assign
     1387             v-option-value = entry(2, v-option, "=" )
     1388           .
     1389           assign
     1390             v-update-last-date = true
     1391             v-last-date        = date(v-option-value)
     1392           .
     1393         end.
     1394         when 'contract-code':U
     1395         then do:
     1396           if num-entries(v-option, "=") <> 2
     1397           then do:
     1398             message
     1399               vss-workfile vss-revision vss-description skip
     1400               "Ошибка при задании параметров вызова резервирования" skip
     1401               "Для указания кода ГТД необходимо указать строку" skip
     1402               "" + 'contract-code':U + "=Код ГТД" skip
     1403               "v-option" v-option skip
     1404               "p-action" p-action skip
     1405               view-as alert-box error .
     1406             undo, return error .
     1407           end.
     1408           assign
     1409             v-option-value = entry(2, v-option, "=" )
     1410           .
     1411           assign
     1412             v-update-contract-code = true
     1413             v-contract-code        = integer(v-option-value)
     1414           .
     1415         end.
     1416         when 'mark-db-num':U
     1417         then do:
     1418           if num-entries(v-option, "=") <> 2
     1419           then do:
     1420             message
     1421               vss-workfile vss-revision vss-description skip
     1422               "Ошибка при задании параметров вызова резервирования" skip
     1423               "Для указания номера БД акцизной марки необходимо указать строку" skip
     1424               "" + 'mark-db-num':U + "=Номер БД" skip
     1425               "v-option" v-option skip
     1426               "p-action" p-action skip
     1427               view-as alert-box error .
     1428             undo, return error .
     1429           end.
     1430           assign
     1431             v-option-value = entry(2, v-option, "=" )
     1432           .
     1433           assign
     1434             v-update-mark-code = true
     1435             v-mark-db-num      = integer(v-option-value)
     1436           .
     1437         end.
     1438         when 'mark-code':U
     1439         then do:
     1440           if num-entries(v-option, "=") <> 2
     1441           then do:
     1442             message
     1443               vss-workfile vss-revision vss-description skip
     1444               "Ошибка при задании параметров вызова резервирования" skip
     1445               "Для указания кода акцизной марки необходимо указать строку" skip
     1446               "" + 'mark-code':U + "=Внутренний код марки" skip
     1447               "v-option" v-option skip
     1448               "p-action" p-action skip
     1449               view-as alert-box error .
     1450             undo, return error .
     1451           end.
     1452           assign
     1453             v-option-value = entry(2, v-option, "=" )
     1454           .
     1455           assign
     1456             v-update-mark-code = true
     1457             v-mark-code        = integer(v-option-value)
     1458           .
     1459         end.
     1460         when 'alc-bottling-date':U
     1461         then do:
     1462           if num-entries(v-option, "=") <> 2
     1463           then do:
     1464             message
     1465               vss-workfile vss-revision vss-description skip
     1466               "Ошибка при задании параметров вызова резервирования" skip
     1467               "Для указания даты разлива необходимо указать строку" skip
     1468               "" + 'alc-bottling-date':U + "=Дата разлива" skip
     1469               "v-option" v-option skip
     1470               "p-action" p-action skip
     1471               view-as alert-box error .
     1472             undo, return error .
     1473           end.
     1474           assign
     1475             v-option-value = entry(2, v-option, "=" )
     1476           .
     1477           assign
     1478             v-update-alc-bottling-date = true
     1479             v-alc-bottling-date        = date(v-option-value)
     1480           .
     1481         end.
     1482         when 'alc-ref-ab-path':U
     1483         then do:
     1484           if num-entries(v-option, "=") <> 2
     1485           then do:
     1486             message
     1487               vss-workfile vss-revision vss-description skip
     1488               "Ошибка при задании параметров вызова резервирования" skip
     1489               "Для указания ссылки на справку А+Б необходимо указать строку" skip
     1490               "" + 'alc-ref-ab-path':U + "=Файл справки А+Б" skip
     1491               "v-option" v-option skip
     1492               "p-action" p-action skip
     1493               view-as alert-box error .
     1494             undo, return error .
     1495           end.
     1496           assign
     1497             v-option-value = entry(2, v-option, "=" )
     1498           .
     1499           assign
     1500             v-update-alc-ref-ab-path = true
     1501             v-alc-ref-ab-path        = str-decode(v-option-value, "")
     1502           .
     1503         end.
     1504         when 'alc-quality-certif-path':U
     1505         then do:
     1506           if num-entries(v-option, "=") <> 2
     1507           then do:
     1508             message
     1509               vss-workfile vss-revision vss-description skip
     1510               "Ошибка при задании параметров вызова резервирования" skip
     1511               "Для указания ссылки на удостоверение качества необходимо указать строку" skip
     1512               "" + 'alc-quality-certif-path':U + "=Файл удостоверения качества" skip
     1513               "v-option" v-option skip
     1514               "p-action" p-action skip
     1515               view-as alert-box error .
     1516             undo, return error .
     1517           end.
     1518           assign
     1519             v-option-value = entry(2, v-option, "=" )
     1520           .
     1521           assign
     1522             v-update-alc-quality-certif-path = true
     1523             v-alc-quality-certif-path        = str-decode(v-option-value, "")
     1524           .
     1525         end.
     1526         when 'alc-certif-path':U
     1527         then do:
     1528           if num-entries(v-option, "=") <> 2
     1529           then do:
     1530             message
     1531               vss-workfile vss-revision vss-description skip
     1532               "Ошибка при задании параметров вызова резервирования" skip
     1533               "Для указания ссылки на сертификат соответствия необходимо указать строку" skip
     1534               "" + 'alc-certif-path':U + "=Файл сертификата соответствия" skip
     1535               "v-option" v-option skip
     1536               "p-action" p-action skip
     1537               view-as alert-box error .
     1538             undo, return error .
     1539           end.
     1540           assign
     1541             v-option-value = entry(2, v-option, "=" )
     1542           .
     1543           assign
     1544             v-update-alc-certif-path = true
     1545             v-alc-certif-path        = str-decode(v-option-value, "")
     1546           .
     1547         end.
     1548         when 'alc-imp-type':U
     1549         then do:
     1550           if num-entries(v-option, "=") <> 2
     1551           then do:
     1552             message
     1553               vss-workfile vss-revision vss-description skip
     1554               "Ошибка при задании параметров вызова резервирования" skip
     1555               "Для указания ссылки на сертификат соответствия необходимо указать строку" skip
     1556               "" + 'alc-imp-type':U + "=Тип импортера" skip
     1557               "v-option" v-option skip
     1558               "p-action" p-action skip
     1559               view-as alert-box error .
     1560             undo, return error .
     1561           end.
     1562           assign
     1563             v-option-value = entry(2, v-option, "=" )
     1564           .
     1565           assign
     1566             v-update-alc-imp-type = true
     1567             v-alc-imp-type        = str-decode(v-option-value, "")
     1568           .
     1569         end.
     1570         when 'alc-imp-code':U
     1571         then do:
     1572           if num-entries(v-option, "=") <> 2
     1573           then do:
     1574             message
     1575               vss-workfile vss-revision vss-description skip
     1576               "Ошибка при задании параметров вызова резервирования" skip
     1577               "Для указания ссылки на сертификат соответствия необходимо указать строку" skip
     1578               "" + 'alc-imp-code':U + "=Код импортера" skip
     1579               "v-option" v-option skip
     1580               "p-action" p-action skip
     1581               view-as alert-box error .
     1582             undo, return error .
     1583           end.
     1584           assign
     1585             v-option-value = entry(2, v-option, "=" )
     1586           .
     1587           assign
     1588             v-update-alc-imp-code = true
     1589             v-alc-imp-code        = INTEGER(str-decode(v-option-value, ""))
     1590           .
     1591         end.
     1592         when 'dop':u then do:
     1593           if  v-option-value <> "" then do:
     1594           assign
     1595             v-update-dop = true
     1596             v-dop        = str-decode(v-option-value, "")
     1597           .
     1598           end.
     1599         end.
     1600         otherwise do:
     1601           message
     1602             vss-workfile vss-revision vss-description skip
     1603             "Ошибка при задании параметров вызова резервирования" skip
     1604             "Неизвестная опция." v-option skip
     1605             "p-action" p-action skip
     1606             view-as alert-box error .
     1607           undo, return error .
     1608         end.
     1609       end.
     1610     end.
     1611   end.
