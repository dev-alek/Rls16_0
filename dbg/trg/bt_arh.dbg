      368   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369   procedure cur-time :
      370      define output parameter p-today as date      no-undo .
      371      define output parameter p-time  as integer   no-undo .
      372     do
      373     on error undo, return error
      374     :
      375       define variable v-date1 as date      no-undo .
      376       define variable v-date2 as date      no-undo .
      377       define variable v-time  as integer   no-undo .
      378       assign
      379         v-date1 = today
      380         v-time  = time
      381         v-date2 = today
      382       .
      383       if v-date1 <> v-date2
      384       then do:
      385         assign
      386           v-date1 = today
      387           v-time  = v-time
      388         .
      389       end.
      390       assign
      391         p-today = v-date1
      392         p-time  = v-time
      393       .
      394     end.
      395   end.
      396   function cur-time-date returns character
      397   :
      398     return string(today, '99/99/9999':U) .
      399   end.
      400   function cur-time-mjd returns decimal
      401   :
      402     define variable v-date as date      no-undo .
      403     define variable v-time as integer   no-undo .
      404     run cur-time in this-procedure
      405       (output v-date
      406       ,output v-time
      407       ) .
      408     return integer(v-date) - 2400002 + (v-time / 86400) .
      409   end.
      410   function cur-time-get-ending-index returns integer
      411   (input p-number as integer
      412   )
      413   :
      414     if p-number < 0
      415     or p-number = ?
      416     then do:
      417       return 1 .
      418     end.
      419     define variable v-rest as integer   no-undo .
      420     assign
      421       p-number = p-number modulo 100
      422     .
      423     if p-number < 20
      424     then do:
      425       assign
      426         v-rest = p-number
      427       .
      428     end.
      429     else do:
      430       assign
      431         v-rest = p-number modulo 10
      432       .
      433     end.
      434     case v-rest :
      435       when 1
      436       then do:
      437         return 2 .
      438       end.
      439       when 2 or
      440       when 3 or
      441       when 4
      442       then do:
      443         return 3 .
      444       end.
      445       otherwise do:
      446         return 1 .
      447       end.
      448     end case .
      449   end.
      450   procedure cur-time-mjd-to-date :
      451      define input  parameter i-mjd-diff as decimal no-undo.
      452      define output parameter o-Date     as date    no-undo.
      453      define output parameter o-Time     as integer no-undo.
      454      define variable v-day-number as integer   no-undo .
      455      if    i-mjd-diff < 0
      456         or i-mjd-diff = ?
      457      then do:
      458         return "?" .
      459      end.
      460      assign
      461         v-day-number = truncate(i-mjd-diff,0).
      462         o-Date = date(v-day-number + 2400002).
      463         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      464     .
      465   end.
      466   function cur-time-mjd-to-string returns character
      467   (input p-mjd-diff as decimal
      468   )
      469   :
      470     define variable v-day-number as integer   no-undo .
      471     define variable v-seconds    as integer   no-undo .
      472     define variable v-hour       as integer   no-undo .
      473     define variable v-min        as integer   no-undo .
      474     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      475     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      476     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      477     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      478     if p-mjd-diff < 0
      479     or p-mjd-diff = ?
      480     then do:
      481       return "?" .
      482     end.
      483     assign
      484       v-day-number = integer(truncate(p-mjd-diff,0))
      485       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      486     .
      487     if v-seconds > 86400
      488     then do:
      489       assign
      490         v-seconds = 86400 - 1
      491       .
      492     end.
      493     if v-seconds < 0
      494     then do:
      495       assign
      496         v-seconds = 0
      497       .
      498     end.
      499     assign
      500       v-hour = truncate(v-seconds / 3600, 0)
      501     .
      502     assign
      503       v-seconds = v-seconds modulo 3600
      504     .
      505     assign
      506       v-min = truncate(v-seconds / 60, 0)
      507     .
      508     assign
      509       v-seconds = v-seconds modulo 60
      510     .
      511     return
      512         (if v-day-number <> 0
      513           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      514           else ""
      515         )
      516       + (if v-day-number <> 0 or v-hour <> 0
      517           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      518           else ""
      519         )
      520       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      521           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      522           else ""
      523         )
      524       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      525       .
      526   end.
      527   function cur-time-string returns character
      528   :
      529     define variable v-date as date      no-undo .
      530     define variable v-time as integer   no-undo .
      531     run cur-time in this-procedure
      532       (output v-date
      533       ,output v-time
      534       ) .
      535     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      536   end.
      537   function cur-time-string-sec returns character
      538   :
      539     define variable v-date as date      no-undo .
      540     define variable v-time as integer   no-undo .
      541     run cur-time in this-procedure
      542       (output v-date
      543       ,output v-time
      544       ) .
      545     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      546   end.
      547   function cur-time-custom  returns character
      548   (input p-prefix as character
      549   ,input p-date-format as character
      550   ,input p-delimiter as character
      551   ,input p-time-format as character
      552   ,input p-suffix as character
      553   )
      554   :
      555     define variable v-date as date      no-undo .
      556     define variable v-time as integer   no-undo .
      557     run cur-time in this-procedure
      558       (output v-date
      559       ,output v-time
      560       ) .
      561     return
      562       p-prefix
      563       + string(v-date, p-date-format)
      564       + p-delimiter
      565       + string(v-time, p-time-format)
      566       + p-suffix
      567       .
      568   end.
      569   function cur-time-print  returns character
      570   :
      571     define variable v-date as date      no-undo .
      572     define variable v-time as integer   no-undo .
      573     run cur-time in this-procedure
      574       (output v-date
      575       ,output v-time
      576       ) .
      577     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      578   end.
      579   function cur-time-datetime returns datetime
      580   :
      581     define variable v-char as character no-undo .
      582     define variable v-datetime as datetime no-undo .
      583     v-char = cur-time-string().
      584     v-datetime = datetime(v-char).
      585     return  v-datetime.
      586   end.
      587   function cur-time-string-msec returns character
      588   :
      589     define variable v-date as datetime  no-undo .
      590     v-date = now.
      591     return string(v-date) .
      592   end.
      593   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      594   define variable v-waitfram-action01         as character   no-undo .
      595   define variable v-waitfram-action02         as character   no-undo .
      596   define variable v-waitfram-action03         as character   no-undo .
      597   define variable mWaitFramTextBeg            as character   no-undo.
      598   define variable mWaitFramTextEnd            as character   no-undo.
      599   define variable mWaitFramView               as logical     no-undo.
      600   define variable mWaitProcEvent              as logical     no-undo init yes.
      601   define variable mWaitFramInterval           as integer     no-undo init 1 .
      602   define variable mWaitFramStop               as logical     no-undo.
      603   define variable mWaitFramStopUser           as logical     no-undo.
      604   define variable mWaitFramStopTimeOut        as logical     no-undo.
      605   define variable mWaitFramStartProc          as datetime-tz no-undo.
      606   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      607   define button B-WaitFramStop auto-end-key
      608        label "Стоп"
      609        size 10 by 1 tooltip "Остоновить процесс".
      610   define button B-viewProcInfo
      611        label "Информация"
      612        size 15 by 1 tooltip "Информация о процесс".
      613   define frame waitfram
      614     v-waitfram-action01 format "x(72)" no-label skip
      615     v-waitfram-action02 format "x(72)" no-label skip
      616     v-waitfram-action03 format "x(72)" no-label skip
      617     B-viewProcInfo
      618     B-WaitFramStop at row 4 col 30
      619     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      620     .
      621   define new global shared variable mBatchMode as logical no-undo init ?.
      622   define variable mFramBachModHandle as handle no-undo.
      623   mFramBachModHandle = frame waitfram:handle.
      624   define variable mFameOldVis as logical no-undo.
      625   define variable mVisCUrentVin as logical no-undo.
      626   if session:batch-mode
      627   then
      628      mBatchMode = yes.
      629   if mBatchMode = ? then do:
      630     mVisCUrentVin = current-window:visible.
      631     mFameOldVis = mFramBachModHandle:visible.
      632     mFramBachModHandle:visible  = yes.
      633     mBatchMode = mFramBachModHandle:visible ne yes.
      634     mFramBachModHandle:visible = mFameOldVis.
      635     current-window:visible = mVisCUrentVin.
      636   end.
      637    if  log-manager:logfile-name ne ?
      638     then DO:
      639         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      640         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      641         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      642     end.
      643   on choose of B-WaitFramStop in frame waitfram
      644   do:
      645     mWaitFramStop = yes.
      646     mWaitFramStopUser = yes.
      647   end.
      648   function waitfram-check-timeout returns logical():
      649      define variable vtime as int64 no-undo.
      650      if mWaitFramStopTimeOut
      651      then
      652         return yes.
      653      vtime = ( now - mWaitFramStartProc ) / 1000 .
      654      if     mWaitFramTimeOut ne ?
      655         and mWaitFramTimeOut ne 0
      656         and mWaitFramTimeOut lt vtime
      657      then do:
      658         mWaitFramStopTimeOut = yes.
      659      end.
      660      return mWaitFramStopTimeOut.
      661   end.
      662   procedure waitfram-hide :
      663     if not session:batch-mode
      664     then do
      665     on error undo, return error return-value
      666     :
      667       pause 0 before-hide .
      668       if not mBatchMode then
      669         hide frame waitfram .
      670     if     not mWaitFramView
      671        and mWaitProcEvent
      672     then
      673       process events .
      674     end.
      675   end procedure.
      676   procedure waitfram-show :
      677     define input  parameter p-message as character no-undo .
      678     define variable v-left-margin as integer   no-undo .
      679     if not session:batch-mode
      680     then do
      681     on error undo, return error return-value
      682     :
      683       if length(p-message) <= 70 then do:
      684         assign
      685           v-left-margin = integer((70 - length(p-message)) / 2)
      686         .
      687         assign
      688           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      689         .
      690         assign
      691           v-waitfram-action01 = " "
      692           v-waitfram-action02 = " "
      693                                    + fill(" ", v-left-margin)
      694                                    + p-message
      695           v-waitfram-action03 = " "
      696         .
      697       end.
      698       else do:
      699         define variable vRindex1 as integer no-undo.
      700         define variable vRindex2 as integer no-undo.
      701         vRindex1 = r-index(p-message," ",70).
      702         if vRindex1 = 0
      703         then
      704            vRindex1 = 70.
      705         if length(p-message)  <= vRindex1 + 70 then do:
      706           assign
      707             v-waitfram-action01 = " "
      708             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      709             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      710           .
      711         end.
      712         else do:
      713           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      714           if vRindex2 <= vRindex1
      715           then
      716              vRindex2 = vRindex1 + 70.
      717           assign
      718             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      719             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      720             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      721           .
      722         end.
      723       end.
      724       B-viewProcInfo:visible   in frame waitfram = no.
      725       B-viewProcInfo:sensitive in frame waitfram = no.
      726       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      727       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      728       if  (   mWaitFramView
      729          or  mWaitProcEvent)
      730          and not mBatchMode
      731       then
      732          display
      733             v-waitfram-action01 skip
      734             v-waitfram-action02 skip
      735             v-waitfram-action03 skip
      736          with frame waitfram .
      737       if     mWaitFramView
      738          then do:
      739             if     mWaitFramInterval ne ?
      740                and not mBatchMode
      741             then
      742                wait-for go of frame waitfram pause mWaitFramInterval.
      743          end.
      744          else
      745             if     mWaitProcEvent
      746                and not mBatchMode
      747             then
      748                process events .
      749     end.
      750   end procedure.
      751      procedure waitfram-show-this:
      752         define input  parameter iInterval as int64 no-undo.
      753         define variable vtime as int64 no-undo.
      754         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      755         mWaitFramInterval = iInterval.
      756         run waitfram-show (substitute("&1&2 &3&4" ,
      757                                       mWaitFramTextBeg ,
      758                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      759                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      760                                       mWaitFramTextEnd
      761                                      )
      762                           ).
      763      end.
      764      procedure WaitFramRunPause:
      765         define input  parameter iInterval as dec no-undo.
      766         define variable vStart  as datetime-tz no-undo.
      767         define variable vend    as datetime-tz no-undo.
      768         define variable vint as int64 no-undo.
      769         define variable vOk as logical no-undo.
      770         vStart = now.
      771         vend   = vStart.
      772         publish "WaitFramPause" (iInterval,output vOk).
      773         vend   =  now.
      774         vint = vend - vStart.
      775         vint = iInterval - vint / 1000.
      776         if     not mWaitFramStop
      777            and (   vint > 0
      778                 or (    not vOk
      779                     and iInterval eq ?
      780                     )
      781                 )
      782         then
      783            run waitfram-show-this (iInterval).
      784         vend   =  now.
      785         vint = vend - vStart.
      786         vint = iInterval - vint / 1000.
      787         if     not mWaitFramStop
      788            and vint > 0
      789         then do:
      790            run gbl/pause.p (vint * 1000).
      791         end.
      792         if iInterval ne ?
      793         then
      794            publish "WaitFramStop".
      795         waitfram-check-timeout().
      796      end.
      797      procedure WaitFramWaitFor:
      798         define input  parameter iInterval as dec no-undo.
      799         assign
      800            mWaitFramStartProc   = now
      801            mWaitFramStopUser    = no
      802            mWaitFramStopTimeOut = no
      803         .
      804         block-wait:
      805         do while not mWaitFramStop:
      806            run WaitFramRunPause (iInterval).
      807            if  waitfram-check-timeout()
      808            then do:
      809               leave block-wait.
      810            end.
      811         end.
      812         run waitfram-hide.
      813      end.
      814   procedure waitfram-join :
      815     define input  parameter p-line-1  as character no-undo .
      816     define input  parameter p-line-2  as character no-undo .
      817     define input  parameter p-line-3  as character no-undo .
      818     define output parameter p-message as character no-undo .
      819     do
      820     on error undo, return error return-value
      821     :
      822       assign
      823         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      824                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      825                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      826       .
      827     end.
      828   end procedure.
      829   function waitfram-join-function returns character
      830     (input p-line-1 as character
      831     ,input p-line-2 as character
      832     ,input p-line-3 as character
      833     ).
      834     define variable v-message as character no-undo .
      835     run waitfram-join in this-procedure
      836       (input  p-line-1
      837       ,input  p-line-2
      838       ,input  p-line-3
      839       ,output v-message
      840       ) .
      841     return v-message .
      842   end function .
      843   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      844   procedure get-ro_get-read-only :
      845     define output parameter p-ro-set as logical   no-undo .
      846     do
      847     on error  undo, return error substitute( "&1(get-ro_get-read-only). &2&3&4", vss-include-info3, return-value, error-status :get-message( 1 ) )
      848     on stop   undo, return error substitute( "&1(get-ro_get-read-only). stop", vss-include-info3 )
      849     on endkey undo, return error substitute( "&1(get-ro_get-read-only). endkey", vss-include-info3 )
      850     :
      851       if lookup( 'READ-ONLY':U, DBRESTRICTIONS('ub':U) ) > 0
      852       then do:
      853         assign
      854           p-ro-set = true
      855         .
      856       end.
      857       else do:
      858         assign
      859           p-ro-set = false
      860         .
      861       end.
      862     end.
      863   end procedure.
      864   define stream slog .
      865   define temp-table doc-list no-undo    field doc-code   like ub.trn-doc.doc-code     field fact-date  like ub.trn-doc.fact-date    field fact-order like ub.trn-doc.fact-order   field obj-type   like ub.trn-doc.obj-type     field obj-code   like ub.trn-doc.obj-code     field is-trn-doc as logical                   field batchprocess_rowid as rowid             index xpk is primary unique doc-code          index xfact obj-type obj-code fact-order   index xdate fact-date  .
      866   define variable v-was-processing as logical   no-undo init false .
      867   define variable v-get-ro_read-only as logical   no-undo .
      868   main-block:
      869   do
      870   on error undo main-block, return error return-value
      871   :
      872     run get-ro_get-read-only in this-procedure
      873       (output v-get-ro_read-only
      874       ) .
      875     if  p-obj-type = ""
      876     and p-obj-code = 0
      877     then do:
      878       for each ub.db no-lock
      879       ,each ub.clients no-lock
      880         where ub.clients.db-num = ub.db.db-num
      881       on error undo, return error return-value
      882       :
      883         run waitfram-show in this-procedure
      884           (input substitute("Расчет складского архива по товарам. Объект &1 &2"
      885                            ,ub.clients.obj-type
      886                            ,ub.clients.obj-code
      887                            )
      888           ) .
      889         run process-object in this-procedure
      890           (input ub.clients.obj-type
      891           ,input ub.clients.obj-code
      892           ) no-error .
      893         if error-status :error
      894         then do:
      895           if error-status :get-message(1) <> ""
      896           then do:
      897             message
      898               vss-workfile vss-revision vss-description skip
      899               "Ошибка при вызове процедуры process-object" skip
      900               error-status :get-message(1) skip
      901               return-value skip
      902               view-as alert-box error .
      903           end.
      904         end.
      905       end.
      906     end.
      907     else do:
      908       find first ub.clients no-lock
      909         where ub.clients.obj-type = p-obj-type
      910           and ub.clients.obj-code = p-obj-code
      911         no-error .
      912       if not available ub.clients
      913       then do:
      914         message
      915           vss-workfile vss-revision vss-description skip
      916           "Ошибка задания входных параметров" skip
      917           "Неизвестный объект" p-obj-type p-obj-code skip
      918           view-as alert-box error .
      919         undo, return error return-value .
      920       end.
      921       run waitfram-show in this-procedure
      922         (input substitute("Расчет складского архива по товарам. Объект &1 &2"
      923                           ,ub.clients.obj-type
      924                           ,ub.clients.obj-code
      925                           )
      926         ) .
      927       run process-object in this-procedure
      928         (input ub.clients.obj-type
      929         ,input ub.clients.obj-code
      930         ) no-error .
      931       if error-status :error
      932       then do:
      933         if error-status :get-message(1) <> ""
      934         then do:
      935           message
      936             vss-workfile vss-revision vss-description skip
      937             "Ошибка при вызове процедуры process-object" skip
      938             error-status :get-message(1) skip
      939             return-value skip
      940             view-as alert-box error .
      941         end.
      942         undo, return error return-value .
      943       end.
      944     end.
      945     run waitfram-hide in this-procedure .
      946     if v-was-processing
      947     then do:
      948       return "true":u .
      949     end.
      950     else do:
      951       return "":u .
      952     end.
      953   end.
      954   procedure process-object :
      955     define input parameter p-obj-type like ub.clients.obj-type no-undo .
      956     define input parameter p-obj-code like ub.clients.obj-code no-undo .
      957     define variable v-today as date      no-undo.
      958     define variable v-time  as integer   no-undo.
      959     define variable v-arh-calc-char    as character no-undo .
      960     define variable v-arh-del-char     as character no-undo .
      961     define variable v-arh-disable-char as character no-undo .
      962     define variable v-arh-calc         as logical   no-undo .
      963     define variable v-arh-del          as logical   no-undo .
      964     define variable v-arh-disable      as logical   no-undo .
      965     define variable v-arh-recalc-char  as character no-undo .
      966     define variable v-arh-recalc       as date      no-undo .
      967     define variable v-attr-type        as character no-undo .
      968     define buffer buf_batchprocess for ub.batchprocess .
      969     define buffer calc-arh-lock_batchprocess for ub.batchprocess .
      970     define buffer stop-arh-restore-lock_btpr for ub.batchprocess .
      971     define buffer stop-arh-news-lock_btpr    for ub.batchprocess .
      972     do
      973     on error undo, return error return-value
      974     :
      975       if v-get-ro_read-only = false
      976       then do:
      977         run gbl/lock-prc.p
      978           (input  'btpr':U
      979           ,input  p-obj-code
      980           ,input  0
      981           ,input  0
      982           ,input  p-obj-type
      983           ,input  ""
      984           ,input  ""
      985           ,input  "Объект,,, ,,,Расчет складского архива по товарам"
      986           ,input  false
      987           ,buffer calc-arh-lock_batchprocess
      988           ) no-error .
      989         if error-status :error
      990         then do:
      991           if error-status :get-message(1) <> ""
      992           then do:
      993             message
      994               vss-workfile vss-revision vss-description skip
      995               "Ошибка при попытке заблокировать ресурс" skip
      996               "Невозможно произвести расчет складского архива по товарам" skip
      997               error-status :get-message(1) skip
      998               return-value skip
      999               view-as alert-box error .
     1000             undo, return error substitute("&1: Ошибка при попытке заблокировать ресурс &2"
     1001                                          ,vss-workfile
     1002                                          ,error-status :get-message(1)
     1003                                          ).
     1004           end.
     1005           undo, return error "В данный момент рассчитывается складской архив по товарам" .
     1006         end.
     1007       end.
     1008       run clntattr-value in this-procedure
     1009         (input  p-obj-type
     1010         ,input  p-obj-code
     1011         ,input  'arh-calc':U
     1012         ,output v-arh-calc-char
