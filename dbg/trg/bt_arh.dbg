     1482             and stop-arh-restore-lock_btpr.CharKey_Two   = ""
     1483             and stop-arh-restore-lock_btpr.CharKey_Three = ""
     1484           no-error .
     1485         if available stop-arh-restore-lock_btpr
     1486         then do:
     1487           undo, return error "Процедура восстановления складского архива запросила остановку автоматического расчета складского архива по товарам" .
     1488         end.
     1489         find first stop-arh-news-lock_btpr no-lock
     1490           where stop-arh-news-lock_btpr.bp_type       = 'lock':U + 'rsrn':U
     1491             and stop-arh-news-lock_btpr.bp_status     = 'N':U
     1492             and stop-arh-news-lock_btpr.Key#_One      = doc-list.obj-code
     1493             and stop-arh-news-lock_btpr.Key#_Two      = 0
     1494             and stop-arh-news-lock_btpr.Key#_Three    = 0
     1495             and stop-arh-news-lock_btpr.CharKey_One   = doc-list.obj-type
     1496             and stop-arh-news-lock_btpr.CharKey_Three = ""
     1497           no-error .
     1498         if available stop-arh-news-lock_btpr
     1499         then do:
     1500           undo, return error "Система новостей запросила остановку автоматического расчета складского архива по товарам" .
     1501         end.
     1502         output stream slog to objarh.txt append .
     1503         export stream slog doc-list except doc-list.batchprocess_rowid .
     1504         run cur-time in this-procedure ( output v-today
     1505                                        , output v-time
     1506                                        ).
     1507         export stream slog string(v-today, "99/99/9999") string(v-time, "hh:mm") .
     1508         output stream slog close .
     1509         assign
     1510           v-was-processing = true
     1511         .
     1512         do transaction
     1513         on error undo, return error return-value
     1514         :
     1515     find first buf_batchprocess exclusive-lock
     1516       where rowid(buf_batchprocess) = doc-list.batchprocess_rowid
     1517       no-error .
     1518     if not available buf_batchprocess then do:
     1519       message
     1520         vss-workfile vss-revision vss-description skip
     1521         "Не найдена запись пересчета архива" skip
     1522         view-as alert-box error .
     1523       undo, return error .
     1524     end.
     1525     if buf_batchprocess.bp_status <> 'N':U then do:
     1526       message
     1527         vss-workfile vss-revision vss-description skip
     1528         "Запись пересчета архива имеет статус, отличный от" 'N':U skip
     1529         "BP_Type"       buf_batchprocess.BP_Type       skip
     1530         "BP_Status"     buf_batchprocess.BP_Status     skip
     1531         "Key#_One"      buf_batchprocess.Key#_One      skip
     1532         "Key#_Two"      buf_batchprocess.Key#_Two      skip
     1533         "Key#_Three"    buf_batchprocess.Key#_Three    skip
     1534         "CharKey_One"   buf_batchprocess.CharKey_One   skip
     1535         "CharKey_Two"   buf_batchprocess.CharKey_Two   skip
     1536         "CharKey_Three" buf_batchprocess.CharKey_Three skip
     1537         view-as alert-box error .
     1538       undo, return error .
     1539     end.
     1540       define variable v-btpr_upd-today-11 as date      no-undo.
     1541     define variable v-btpr_upd-time-11  as integer   no-undo.
     1542     run cur-time in this-procedure ( output v-btpr_upd-today-11
     1543                                    , output v-btpr_upd-time-11
     1544                                    ).
     1545     assign
     1546       buf_batchprocess.bp_status         = 'D':U
     1547       buf_batchprocess.bp_execcounttries = buf_batchprocess.bp_execcounttries + 1
     1548       buf_batchprocess.bp_execuser_id    = g#userid
     1549       buf_batchprocess.bp_execsysdate    = v-btpr_upd-today-11
     1550       buf_batchprocess.bp_execsystime    = string(v-btpr_upd-time-11, 'hh:mm')
     1551       buf_batchprocess.bp_execsystimeint = v-btpr_upd-time-11
     1552     .
     1553           if doc-list.is-trn-doc
     1554           then do:
     1555             run trg/calc-arh.p
     1556               (input doc-list.doc-code
     1557               ,input ?
     1558               ).
     1559           end.
     1560           else do:
     1561             run trg/calc-apc.p
     1562               (input doc-list.doc-code
     1563               ,input ?
     1564               ).
     1565           end.
     1566         end.
     1567       end.
     1568     end.
     1569   end procedure.
