     1174           or error-status :get-message(1) <> ""
     1175           then do:
     1176             undo move_block, retry move_block.
     1177           end.
     1178         end.
     1179       end.
     1180       if p-move-resize
     1181       then do:
     1182         run diasize_position-resize-button in this-procedure .
     1183       end.
     1184       if v-diasize-wndstore = true
     1185       then do:
     1186         if connected("ub") = true
     1187         then do:
     1188           define variable v-cntxt-db-num        as integer   no-undo .
     1189           define variable v-cntxt-userid        as character no-undo .
     1190           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1191                                             , OUTPUT v-cntxt-userid
     1192                                             ) .
     1193           run gbl/wndsizew.p
     1194             (input  v-cntxt-db-num
     1195             ,input  v-cntxt-userid
     1196             ,input  v-diasize-proc-name
     1197             ,input  'width':u
     1198             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1199             ) .
     1200         end.
     1201       end.
     1202     end.
     1203     assign
     1204       v-diasize-change-size = false
     1205     .
     1206   end procedure.
     1207   procedure diasize_set-width :
     1208     define input  parameter p-new-width  as decimal   no-undo .
     1209     define input  parameter p-move-resize as logical   no-undo .
     1210     do
     1211     on error undo, return error return-value
     1212     :
     1213       run diasize_change-width in this-procedure
     1214         (input  (p-new-width - frame Dialog-Frame :width)
     1215         ,input  p-move-resize
     1216         ) .
     1217     end.
     1218   end procedure.
     1219   procedure diasize_position-resize-button :
     1220     do with frame Dialog-Frame
     1221     :
     1222       hide v-diasize-resize-button .
     1223       assign
     1224         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1225                     - 1
     1226                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1227         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1228                     - 1
     1229                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1230       .
     1231       view v-diasize-resize-button .
     1232     end.
     1233   end procedure.
     1234   on alt-right anywhere
     1235   do:
     1236     run diasize_change-width in this-procedure
     1237       (input 1
     1238       ,input true
     1239       ) .
     1240     return no-apply .
     1241   end.
     1242   on alt-left anywhere
     1243   do:
     1244     run diasize_change-width in this-procedure
     1245       (input -1
     1246       ,input true
     1247       ) .
     1248     return no-apply .
     1249   end.
     1250   on alt-down anywhere
     1251   do:
     1252     run diasize_change-height in this-procedure
     1253       (input 1
     1254       ,input true
     1255       ) .
     1256     return no-apply .
     1257   end.
     1258   on alt-up anywhere
     1259   do:
     1260     run diasize_change-height in this-procedure
     1261       (input -1
     1262       ,input true
     1263       ) .
     1264     return no-apply .
     1265   end.
     1266   on alt-enter of frame Dialog-Frame
     1267   do:
     1268     run diasize_maximize in this-procedure
     1269       (input  ?
     1270       ).
     1271     return no-apply .
     1272   end.
     1273   procedure diasize_end-move :
     1274     do
     1275     on error undo, return error return-value
     1276     :
     1277       define variable v-row-delta as decimal   no-undo .
     1278       define variable v-col-delta as decimal   no-undo .
     1279       define variable v-new-row as decimal   no-undo .
     1280       define variable v-new-col as decimal   no-undo .
     1281       assign
     1282         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1283         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1284       .
     1285       assign
     1286         v-row-delta = v-new-row - frame Dialog-Frame :height
     1287         v-col-delta = v-new-col - frame Dialog-Frame :width
     1288       .
     1289       run diasize_change-height in this-procedure
     1290         (input v-row-delta
     1291         ,input true
     1292         ) .
     1293       run diasize_change-width in this-procedure
     1294         (input v-col-delta
     1295         ,input true
     1296         ) .
     1297     end.
     1298   end procedure.
     1299   procedure diasize_maximize :
     1300     define input  parameter p-action as logical   no-undo .
     1301     do
     1302     on error undo, return error return-value
     1303     :
     1304       if p-action = ?
     1305       then do:
     1306         if v-diasize-need-maximize = true
     1307         then do:
     1308           assign
     1309             p-action = true
     1310           .
     1311         end.
     1312         else do:
     1313           assign
     1314             p-action = false
     1315           .
     1316         end.
     1317       end.
     1318       if p-action = true
     1319       then do:
     1320         run diasize_change-height in this-procedure
     1321           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1322               - frame Dialog-Frame :height-chars
     1323           ,input true
     1324           ) .
     1325         run diasize_change-width in this-procedure
     1326           (input session :width-chars
     1327               - frame Dialog-Frame :width-chars
     1328           ,input true
     1329           ) .
     1330         assign
     1331           v-diasize-need-maximize = false
     1332         .
     1333       end.
     1334       else do:
     1335         run diasize_change-width in this-procedure
     1336           (input v-diasize-orig-frame-width
     1337               - frame Dialog-Frame :width-chars
     1338           ,input true
     1339           ) .
     1340         run diasize_change-height in this-procedure
     1341           (input v-diasize-orig-frame-height
     1342               - frame Dialog-Frame :height-chars
     1343           ,input true
     1344           ) .
     1345         assign
     1346           v-diasize-need-maximize = true
     1347         .
     1348       end.
     1349     end.
     1350   end procedure.
     1351   procedure diasize_restore-orig-size :
     1352     do
     1353     on error undo, return error return-value
     1354     :
     1355       assign
     1356         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1357         v-diasize-current-frame-height = frame Dialog-Frame :height
     1358       .
     1359       run diasize_set-height in this-procedure
     1360         (input  v-diasize-orig-frame-height
     1361         ,input  true
     1362         ) .
     1363       run diasize_set-width in this-procedure
     1364         (input  v-diasize-orig-frame-width
     1365         ,input  true
     1366         ) .
     1367     end.
     1368   end procedure.
     1369   procedure diasize_restore-current-size :
     1370     do
     1371     on error undo, return error return-value
     1372     :
     1373       run diasize_set-height in this-procedure
     1374         (input  v-diasize-current-frame-height
     1375         ,input  true
     1376         ) .
     1377       run diasize_set-width in this-procedure
     1378         (input  v-diasize-current-frame-width
     1379         ,input  true
     1380         ) .
     1381     end.
     1382   end procedure.
     1383   procedure diasize_set-browse-handle :
     1384     define input  parameter p-browse-handle as handle   no-undo .
     1385     define buffer buf_temp-browse-handle for temp-browse-handle .
     1386     do
     1387     on error undo, return error return-value
     1388     :
     1389       assign
     1390         v-diasize-browse-handle = p-browse-handle
     1391       .
     1392       for each buf_temp-browse-handle
     1393       on error undo, return error return-value
     1394       :
     1395         delete buf_temp-browse-handle .
     1396       end.
     1397     end.
     1398   end procedure.
     1399   procedure diasize_add_browse :
     1400     define input  parameter p-browse-type   as character no-undo .
     1401     define input  parameter p-browse-handle as handle    no-undo .
     1402     define buffer buf_temp-browse-handle for temp-browse-handle .
     1403     do
     1404     on error undo, return error return-value
     1405     :
     1406       assign
     1407         v-diasize-browse-number = v-diasize-browse-number + 1
     1408       .
     1409       create buf_temp-browse-handle .
     1410       assign
     1411         buf_temp-browse-handle.browse-type   = p-browse-type
     1412         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1413         buf_temp-browse-handle.browse-handle = p-browse-handle
     1414       .
     1415     end.
     1416   end procedure.
     1417   procedure diasize_init :
     1418     define variable v-default-value    as logical   no-undo .
     1419     define variable v-restore-saved    as logical   no-undo .
     1420     define variable v-resize-value-str as character no-undo .
     1421     do
     1422     on error undo, return error return-value
     1423     :
     1424       do with frame Dialog-Frame
     1425       :
     1426         assign
     1427           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1428           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1429           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1430         .
     1431         create button v-diasize-resize-button
     1432         assign
     1433           parent        = frame Dialog-Frame :first-child
     1434           label         = "s"
     1435           height-pixels = 16
     1436           width-pixels  = 16
     1437           visible       = true
     1438           sensitive     = true
     1439           movable       = true
     1440           triggers:
     1441             on end-move persistent run diasize_end-move in this-procedure .
     1442           end triggers.
     1443         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1444         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1445         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1446         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1447         assign
     1448           v-diasize-wndmax = false
     1449         .
     1450         if connected("ub") = true
     1451         then do:
     1452           define variable v-cntxt-db-num        as integer   no-undo .
     1453           define variable v-cntxt-userid        as character no-undo .
     1454           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1455                                             , OUTPUT v-cntxt-userid
     1456                                             ) .
     1457           run gbl/wndpar_r.p
     1458             (input  v-cntxt-db-num
     1459             ,input  v-cntxt-userid
     1460             ,input  'wndmax':U
     1461             ,output v-diasize-wndmax
     1462             ,output v-default-value
     1463             ) .
     1464         end.
     1465         assign
     1466           v-diasize-wndstore = false
     1467         .
     1468         if connected("ub") = true
     1469         then do:
     1470           run gbl/wndpar_r.p
     1471             (input  v-cntxt-db-num
     1472             ,input  v-cntxt-userid
     1473             ,input  'wndstore':U
     1474             ,output v-diasize-wndstore
     1475             ,output v-default-value
     1476             ) .
     1477         end.
     1478         assign
     1479           v-diasize-proc-name = entry(1, program-name(2), '.')
     1480         .
     1481         if v-diasize-wndstore = true
     1482         then do:
     1483           assign
     1484             v-restore-saved = false
     1485           .
     1486           if connected("ub") = true
     1487           then do:
     1488             run gbl/wndsizer.p
     1489               (input  v-cntxt-db-num
     1490               ,input  v-cntxt-userid
     1491               ,input  v-diasize-proc-name
     1492               ,input  'height':u
     1493               ,output v-resize-value-str
     1494               ) .
     1495             if v-resize-value-str <> '':U
     1496             then do:
     1497               run diasize_change-height in this-procedure
     1498                 (input  integer(v-resize-value-str)
     1499                 ,input  true
     1500                 ) .
     1501               assign
     1502                 v-restore-saved = true
     1503               .
     1504             end.
     1505           end.
     1506           if connected("ub") = true
     1507           then do:
     1508             run gbl/wndsizer.p
     1509               (input  v-cntxt-db-num
     1510               ,input  v-cntxt-userid
     1511               ,input  v-diasize-proc-name
     1512               ,input  'width':u
     1513               ,output v-resize-value-str
     1514               ) .
     1515             if v-resize-value-str <> '':U
     1516             then do:
     1517               run diasize_change-width in this-procedure
     1518                 (input  integer(v-resize-value-str)
     1519                 ,input  true
     1520                 ) .
     1521               assign
     1522                 v-restore-saved = true
     1523               .
     1524             end.
     1525           end.
     1526           if v-restore-saved <> true
     1527           then do:
     1528             if v-diasize-wndmax = true
     1529             then do:
     1530               run diasize_maximize in this-procedure
     1531                 (input  true
     1532                 ) .
     1533             end.
     1534           end.
     1535         end.
     1536         else do:
     1537           if v-diasize-wndmax = true
     1538           then do:
     1539             run diasize_maximize in this-procedure
     1540               (input  true
     1541               ) .
     1542           end.
     1543         end.
     1544       end.
     1545     end.
     1546   end procedure.
     1547   procedure diasize_need-full-display :
     1548     define output parameter p-need-full-display as logical   no-undo .
     1549     do
     1550     on error undo, return error return-value
     1551     :
     1552       assign
     1553         p-need-full-display = v-diasize-need-full-display
     1554       .
     1555       assign
     1556         v-diasize-need-full-display = false
     1557       .
     1558     end.
     1559   end procedure.
     1560   procedure get-context :
     1561      define output parameter p-db-num as integer          no-undo.
     1562      define output parameter p-user-id as character        no-undo.
     1563      define variable v-login               as character    no-undo.
     1564      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1565      define buffer buf_user-login  for ub.user-login .
     1566      do
     1567      on error undo, return error
     1568      :
     1569            FIND FIRST buf_sys-ctrl no-lock.
     1570            ASSIGN
     1571               v-login = USERID("ub")
     1572               p-db-num = buf_sys-ctrl.db-num
     1573            .
     1574            FIND FIRST buf_user-login
     1575                 WHERE buf_user-login.db-num = p-db-num
     1576                   AND buf_user-login.user-login = v-login
     1577                 no-lock
     1578                 no-error
     1579                 .
     1580            IF AVAILABLE buf_user-login
     1581            THEN DO:
     1582               assign
     1583                  p-user-id = buf_user-login.user-id
     1584               .
     1585            END.
     1586      end.
     1587   end procedure.
     1588       run diasize_init in this-procedure .
     1589   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1590   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1591   MAIN-BLOCK:
     1592   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1593      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1594     RUN enable_UI.
     1595     apply "entry" to browse-1.
     1596     WAIT-FOR GO OF FRAME Dialog-Frame.
     1597   END.
     1598   RUN disable_UI.
     1599   PROCEDURE b-mark-press :
     1600   do
     1601   on error undo, return error
     1602   :
     1603       define variable v-focused-row       as integer              no-undo.
     1604       define variable v-repositioned-row  as integer              no-undo.
     1605       assign
     1606           v-focused-row      = browse-1 :focused-row in frame Dialog-Frame.
     1607           v-repositioned-row = current-result-row( "browse-1" )
     1608       .
     1609       if rcs-shops.status_ = '*'
     1610       then do:
     1611           assign
     1612               rcs-shops.status_ = ''
     1613           .
     1614       end.
     1615       else do:
     1616           assign
     1617               rcs-shops.status_ = '*'
     1618           .
     1619       end.
     1620       OPEN QUERY BROWSE-1 FOR EACH rcs-shops SHARE-LOCK.
     1621       if v-focused-row > browse-1 :height - 2
     1622       then do:
     1623           assign
     1624               v-repositioned-row  = v-repositioned-row + 1
     1625           .
     1626       end.
     1627       else do:
     1628           assign
     1629               v-focused-row       = v-focused-row + 1
     1630               v-repositioned-row  = v-repositioned-row + 1
     1631           .
     1632       end.
     1633       browse-1 :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dialog-Frame.
     1634       reposition browse-1 to row v-repositioned-row.
     1635   end.
     1636   END PROCEDURE.
     1637   PROCEDURE delete-objects :
     1638   do
     1639   on error undo, return error
     1640   :
     1641   define input parameter p-id  as character    no-undo.
     1642       define buffer buf_rcs-shops       for rcs-shops.
     1643       find first buf_rcs-shops exclusive-lock
     1644            where buf_rcs-shops.id    = p-id
     1645       no-error.
     1646       if not available buf_rcs-shops
     1647       then do:
     1648           undo, return error "delete-objects: Не удалось удалить запись." + chr(10) + return-value.
     1649       end.
     1650       else do:
     1651           delete buf_rcs-shops .
     1652       end.
     1653   end.
     1654   END PROCEDURE.
     1655   PROCEDURE disable_UI :
     1656     HIDE FRAME Dialog-Frame.
     1657   END PROCEDURE.
     1658   PROCEDURE enable_UI :
     1659     ENABLE b-exit b-mark b-add b-chg b-del b-help BROWSE-1
     1660         WITH FRAME Dialog-Frame.
     1661     VIEW FRAME Dialog-Frame.
     1662     OPEN QUERY BROWSE-1 FOR EACH rcs-shops SHARE-LOCK.
     1663   END PROCEDURE.
