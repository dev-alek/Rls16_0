      170   DEFINE BUTTON b-add
      171        LABEL "&Добавить"
      172        SIZE 10 BY 1.
      173   DEFINE BUTTON b-chg
      174        LABEL "&Изменить"
      175        SIZE 10 BY 1.
      176   DEFINE BUTTON b-del
      177        LABEL "&Удалить"
      178        SIZE 10 BY 1.
      179   DEFINE BUTTON b-exit
      180        LABEL "&Выход"
      181        SIZE 10 BY 1
      182        BGCOLOR 8 .
      183   DEFINE BUTTON b-help
      184        LABEL "Помощ&ь"
      185        SIZE 10 BY 1
      186        BGCOLOR 8 .
      187   DEFINE BUTTON b-mark
      188        LABEL "&*"
      189        SIZE 3 BY 1.
      190   DEFINE QUERY BROWSE-1 FOR
      191         rcs-shops SCROLLING.
      192   DEFINE BROWSE BROWSE-1
      193     QUERY BROWSE-1 SHARE-LOCK NO-WAIT DISPLAY
      194         rcs-shops.status_ COLUMN-LABEL "*" FORMAT "X(1)"
      195         rcs-shops.name
      196         rcs-shops.id
      197         rcs-shops.obj-type COLUMN-LABEL "Тип"
      198         rcs-shops.obj-code COLUMN-LABEL "Код" FORMAT "zzzzzz9"
      199       WITH NO-ROW-MARKERS SEPARATORS SIZE 78 BY 17.71.
      200   DEFINE FRAME Dialog-Frame
      201        b-exit AT ROW 1.17 COL 2
      202        b-mark AT ROW 1.17 COL 12
      203        b-add AT ROW 1.17 COL 15
      204        b-chg AT ROW 1.17 COL 25
      205        b-del AT ROW 1.17 COL 35
      206        b-help AT ROW 1.17 COL 70
      207        BROWSE-1 AT ROW 2.38 COL 2
      208        SPACE(1.12) SKIP(0.28)
      209       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      210            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      211            TITLE "Объекты РКС - настройка идентификаторов"
      212            DEFAULT-BUTTON b-exit.
      213   ASSIGN
      214          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      215          FRAME Dialog-Frame:HIDDEN           = TRUE.
      216   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      217   DO:
      218     APPLY "END-ERROR":U TO SELF.
      219   END.
      220   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      221   DO:
      222       run rcs/rcscnfmf.w (
      223               input 'добавить-узлы':U
      224             , input ""
      225       ) no-error .
      226       if error-status :error
      227       then do:
      228           message
      229           vss-workfile vss-revision vss-description
      230           skip "Ошибка добавления описания объекта."
      231           skip return-value
      232           skip trim(error-status :get-message(1))
      233           trim(error-status :get-message(2))
      234           trim(error-status :get-message(3))
      235           trim(error-status :get-message(4))
      236           trim(error-status :get-message(5))
      237           view-as alert-box error.
      238           undo, return no-apply .
      239       end.
      240       OPEN QUERY BROWSE-1 FOR EACH rcs-shops SHARE-LOCK.
      241   END.
      242   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      243   DO:
      244       run rcs/rcscnfmf.w (
      245               input 'изменить-узлы':U
      246             , input rcs-shops.id
      247       ) no-error .
      248       if error-status :error
      249       then do:
      250           message
      251           vss-workfile vss-revision vss-description
      252           skip "Ошибка добавления имени файла."
      253           skip return-value
      254           skip trim(error-status :get-message(1))
      255           trim(error-status :get-message(2))
      256           trim(error-status :get-message(3))
      257           trim(error-status :get-message(4))
      258           trim(error-status :get-message(5))
      259           view-as alert-box error.
      260           undo, return no-apply .
      261       end.
      262       browse-1 :refresh ().
      263   END.
      264   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      265   DO:
      266       run delete-objects in this-procedure (
      267             input rcs-shops.id
      268       ) no-error .
      269       if error-status :error
      270       then do:
      271           message
      272           vss-workfile vss-revision vss-description
      273           skip "Ошибка удаления записи."
      274           skip return-value
      275           skip trim(error-status :get-message(1))
      276           trim(error-status :get-message(2))
      277           trim(error-status :get-message(3))
      278           trim(error-status :get-message(4))
      279           trim(error-status :get-message(5))
      280           view-as alert-box error.
      281           undo, return no-apply .
      282       end.
      283       OPEN QUERY BROWSE-1 FOR EACH rcs-shops SHARE-LOCK.
      284   END.
      285   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      286   DO:
      287       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
      288   END.
      289   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      290   or insert-mode of browse-1 IN FRAME Dialog-Frame
      291   DO:
      292       run b-mark-press in this-procedure no-error .
      293       if error-status :error
      294       then do:
      295           message
      296           vss-workfile vss-revision vss-description
      297           skip "Ошибка добавления имени файла."
      298           skip return-value
      299           skip trim(error-status :get-message(1))
      300           trim(error-status :get-message(2))
      301           trim(error-status :get-message(3))
      302           trim(error-status :get-message(4))
      303           trim(error-status :get-message(5))
      304           view-as alert-box error.
      305           undo, return no-apply .
      306       end.
      307       display
      308           rcs-shops.status_
      309       with browse browse-1.
      310   END.
      311   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      312   on help of frame Dialog-Frame
      313   do:
      314     run gbl/app_help.p
      315       (input this-procedure :file-name
      316       ,input ''
      317       ,input ?
      318       ) no-error.
      319     if error-status :error then do:
      320       message
      321         "Ошибка при вызове помощи"
      322         error-status :get-message(1)
      323         view-as alert-box .
      324     end.
      325   end.
      326   run minbtn-set in this-procedure .
      327   on choose of b-help in frame Dialog-Frame
      328   do:
      329     apply "help":u to frame Dialog-Frame .
      330   end.
      331   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      332   procedure minbtn-set :
      333       do
      334           on error undo, return error return-value
      335           :
      336           define variable ii              as integer       no-undo .
      337           define variable fh              as widget-handle no-undo .
      338           define variable hh              as widget-handle no-undo .
      339           define variable v-h             as handle        extent 4 no-undo .
      340           define variable v-name-button   as character     no-undo .
      341           define variable v-help-old-x    as decimal       no-undo .
      342           define variable v-help-old-y    as decimal       no-undo .
      343           define variable v-help-old-size as decimal       no-undo .
      344           define variable v-frame-width   as decimal       no-undo .
      345           define variable jj              as integer       no-undo .
      346           do
      347               on error undo, return error
      348               :
      349               assign
      350                   v-frame-width = frame Dialog-Frame:width - 0.3
      351                   fh            = frame Dialog-Frame:first-child
      352                   hh            = fh:first-child
      353                   ii            = 1
      354                   .
      355               do while valid-handle(hh):
      356                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      357                   do:
      358                       case lc(hh:name) :
      359                           when "b-help" then
      360                               do:
      361                                   hh:load-image-up("cmp/b-help.bmp":u) .
      362                                   hh:load-image-down("cmp/b-help.bmp":u) .
      363                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      364                                   hh:TOOLTIP = "Помощь" .
      365                                   v-help-old-x = hh:column .
      366                                   v-help-old-y = hh:row    .
      367                                   v-help-old-size = hh:width .
      368                                   hh:width-chars = 2.5 .
      369                               end.
      370                           when "b-print" then
      371                               do:
      372                                   hh:load-image("cmp/b-print.bmp":u) .
      373                                   hh:TOOLTIP = "Печать" .
      374                                   v-h[ii] = hh:handle .
      375                                   ii = ii + 1 .
      376                                   hh:width-chars = 3 .
      377                               end.
      378                           when "b-history" or
      379                           when "b-hist" then
      380                               do:
      381                                   hh:load-image("cmp/b-hist.bmp":u) .
      382                                   hh:TOOLTIP = "История" .
      383                                   v-h[ii] = hh:handle .
      384                                   ii = ii + 1 .
      385                                   hh:width-chars = 3 .
      386                               end.
      387                           when "b-sch" then
      388                               do:
      389                                   hh:load-image("cmp/b-sch.bmp":u) .
      390                                   hh:TOOLTIP = "Установка Фильтра" .
      391                                   v-h[ii] = hh:handle .
      392                                   ii = ii + 1 .
      393                                   hh:width-chars = 3 .
      394                               end.
      395                           when "b-hist-user" then
      396                               do:
      397                                   hh:load-image("cmp/b-hist.bmp":u) .
      398                                   hh:TOOLTIP = "История пользователя" .
      399                                   ii = ii + 1 .
      400                               end.
      401                       end case.
      402                   end.
      403                   hh = hh:next-sibling.
      404               end.
      405               b-help:column = v-frame-width - b-help:width-chars.
      406               jj = 0.
      407               repeat ii = 4 to 1 by -1 :
      408                   if valid-handle (v-h[ii] ) then
      409                   do:
      410                       jj  = jj + 1 .
      411                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      412                       v-h[ii]:row    = v-help-old-y .
      413                   end.
      414               end.
      415           end.
      416       end.
      417   end procedure.
      418   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      419   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      420   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      421   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      422   define variable v-diasize-current-frame-width  as decimal   no-undo .
      423   define variable v-diasize-current-frame-height as decimal   no-undo .
      424   define variable v-diasize-change-size          as logical   no-undo .
      425   define variable v-diasize-resize-button        as handle    no-undo .
      426   define variable v-diasize-wndmax               as logical   no-undo .
      427   define variable v-diasize-wndstore             as logical   no-undo .
      428   define variable v-diasize-proc-name            as character no-undo .
      429   define variable v-diasize-browse-handle        as handle    no-undo .
      430   define variable v-diasize-browse-number        as integer   no-undo .
      431   define variable v-diasize-need-full-display    as logical   no-undo init false .
      432   define temp-table temp-diasize-handle no-undo
      433     field handle-value  as handle
      434     field save-position as decimal
      435     index xpk is primary unique handle-value
      436     .
      437   define temp-table temp-browse-handle no-undo
      438     field browse-type   as character
      439     field browse-number as integer
      440     field browse-handle as handle
      441     field original-size as decimal
      442     index xpk is primary unique browse-type browse-number
      443     index xie browse-type browse-handle
      444   .
      445   procedure diasize_change-height :
      446     define input  parameter p-change-value  as decimal   no-undo .
      447     define input  parameter p-move-resize   as logical   no-undo .
      448     define variable v-field-group-handle    as handle    no-undo .
      449     define variable v-object-handle         as handle    no-undo .
      450     define variable v-frame-height          as decimal   no-undo .
      451     define variable v-frame-virtual-height  as decimal   no-undo .
      452     define variable v-browse-height         as decimal   no-undo .
      453     define variable v-window-height         as decimal   no-undo .
      454     define variable v-window-virtual-height as decimal   no-undo .
      455     define variable v-change-sign           as integer   no-undo .
      456     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      457     define buffer buf_temp-browse-handle  for temp-browse-handle .
      458     if p-change-value > 0
      459     then do:
      460       if frame Dialog-Frame :height + p-change-value
      461           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      462       then do:
      463         assign
      464           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      465                           - (frame Dialog-Frame :height-chars)
      466         .
      467         if p-change-value <= 0
      468         then do:
      469           run diasize_position-resize-button in this-procedure .
      470           return .
      471         end.
      472       end.
      473     end.
      474     if p-change-value < 0
      475     then do:
      476       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      477       then do:
      478         assign
      479           p-change-value = v-diasize-orig-frame-height
      480                          - (frame Dialog-Frame :height-chars)
      481         .
      482         if p-change-value >= 0
      483         then do:
      484           run diasize_position-resize-button in this-procedure .
      485           return .
      486         end.
      487       end.
      488     end.
      489     if p-change-value >= 0
      490     then do:
      491       assign
      492         v-change-sign = 1
      493       .
      494     end.
      495     else do:
      496       assign
      497         v-change-sign = -1
      498       .
      499     end.
      500     assign
      501       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      502     .
      503     if p-change-value = 0
      504     then do:
      505       run diasize_position-resize-button in this-procedure .
      506       return .
      507     end.
      508     move_block:
      509     do
      510     on error undo move_block, retry move_block
      511     :
      512       if retry
      513       then do:
      514         do
      515         on error undo move_block, leave move_block
      516         :
      517           if p-change-value > 0
      518           then do:
      519             for each buf_temp-diasize-handle
      520             on error undo, next
      521             :
      522               assign
      523                 v-object-handle = buf_temp-diasize-handle.handle-value
      524               .
      525               if v-object-handle <> v-diasize-resize-button
      526               then do:
      527                 assign
      528                   v-object-handle :row = buf_temp-diasize-handle.save-position
      529                 .
      530               end.
      531             end.
      532             assign
      533               v-diasize-browse-handle :height = v-browse-height
      534             .
      535             for each buf_temp-browse-handle
