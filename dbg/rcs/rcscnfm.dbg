      843     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      844     define buffer buf_temp-browse-handle  for temp-browse-handle .
      845     if p-change-value > 0
      846     then do:
      847       if frame Dialog-Frame :width + p-change-value >
      848           session :width-chars
      849       then do:
      850         assign
      851           p-change-value = session :width-chars - frame Dialog-Frame :width
      852         .
      853         if p-change-value <= 0
      854         then do:
      855           run diasize_position-resize-button in this-procedure .
      856           return .
      857         end.
      858       end.
      859     end.
