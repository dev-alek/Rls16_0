       93   define variable v-mail-IDChannel            as character      no-undo.
       94   define variable v-mail-ReportNumber         as character      no-undo.
       95   define variable v-default-gds-grp-node-code as integer        no-undo.
       96   define variable v-default-cli-grp-node-code as integer        no-undo.
       97   define variable v-default-wrkr              as integer        no-undo.
