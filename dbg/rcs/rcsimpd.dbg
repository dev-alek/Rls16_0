     1173           or error-status :get-message(1) <> ""
     1174           then do:
     1175             undo move_block, retry move_block.
     1176           end.
     1177         end.
     1178       end.
     1179       if p-move-resize
     1180       then do:
     1181         run diasize_position-resize-button in this-procedure .
     1182       end.
     1183       if v-diasize-wndstore = true
     1184       then do:
     1185         if connected("ub") = true
     1186         then do:
     1187           define variable v-cntxt-db-num        as integer   no-undo .
     1188           define variable v-cntxt-userid        as character no-undo .
     1189           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1190                                             , OUTPUT v-cntxt-userid
     1191                                             ) .
     1192           run gbl/wndsizew.p
     1193             (input  v-cntxt-db-num
     1194             ,input  v-cntxt-userid
     1195             ,input  v-diasize-proc-name
     1196             ,input  'width':u
     1197             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1198             ) .
     1199         end.
     1200       end.
     1201     end.
     1202     assign
     1203       v-diasize-change-size = false
     1204     .
     1205   end procedure.
     1206   procedure diasize_set-width :
     1207     define input  parameter p-new-width  as decimal   no-undo .
     1208     define input  parameter p-move-resize as logical   no-undo .
     1209     do
     1210     on error undo, return error return-value
     1211     :
     1212       run diasize_change-width in this-procedure
     1213         (input  (p-new-width - frame Dialog-Frame :width)
     1214         ,input  p-move-resize
     1215         ) .
     1216     end.
     1217   end procedure.
     1218   procedure diasize_position-resize-button :
     1219     do with frame Dialog-Frame
     1220     :
     1221       hide v-diasize-resize-button .
     1222       assign
     1223         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1224                     - 1
     1225                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1226         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1227                     - 1
     1228                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1229       .
     1230       view v-diasize-resize-button .
     1231     end.
     1232   end procedure.
     1233   on alt-right anywhere
     1234   do:
     1235     run diasize_change-width in this-procedure
     1236       (input 1
     1237       ,input true
     1238       ) .
     1239     return no-apply .
     1240   end.
     1241   on alt-left anywhere
     1242   do:
     1243     run diasize_change-width in this-procedure
     1244       (input -1
     1245       ,input true
     1246       ) .
     1247     return no-apply .
     1248   end.
     1249   on alt-down anywhere
     1250   do:
     1251     run diasize_change-height in this-procedure
     1252       (input 1
     1253       ,input true
     1254       ) .
     1255     return no-apply .
     1256   end.
     1257   on alt-up anywhere
     1258   do:
     1259     run diasize_change-height in this-procedure
     1260       (input -1
     1261       ,input true
     1262       ) .
     1263     return no-apply .
     1264   end.
     1265   on alt-enter of frame Dialog-Frame
     1266   do:
     1267     run diasize_maximize in this-procedure
     1268       (input  ?
     1269       ).
     1270     return no-apply .
     1271   end.
     1272   procedure diasize_end-move :
     1273     do
     1274     on error undo, return error return-value
     1275     :
     1276       define variable v-row-delta as decimal   no-undo .
     1277       define variable v-col-delta as decimal   no-undo .
     1278       define variable v-new-row as decimal   no-undo .
     1279       define variable v-new-col as decimal   no-undo .
     1280       assign
     1281         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1282         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1283       .
     1284       assign
     1285         v-row-delta = v-new-row - frame Dialog-Frame :height
     1286         v-col-delta = v-new-col - frame Dialog-Frame :width
     1287       .
     1288       run diasize_change-height in this-procedure
     1289         (input v-row-delta
     1290         ,input true
     1291         ) .
     1292       run diasize_change-width in this-procedure
     1293         (input v-col-delta
     1294         ,input true
     1295         ) .
     1296     end.
     1297   end procedure.
     1298   procedure diasize_maximize :
     1299     define input  parameter p-action as logical   no-undo .
     1300     do
     1301     on error undo, return error return-value
     1302     :
     1303       if p-action = ?
     1304       then do:
     1305         if v-diasize-need-maximize = true
     1306         then do:
     1307           assign
     1308             p-action = true
     1309           .
     1310         end.
     1311         else do:
     1312           assign
     1313             p-action = false
     1314           .
     1315         end.
     1316       end.
     1317       if p-action = true
     1318       then do:
     1319         run diasize_change-height in this-procedure
     1320           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1321               - frame Dialog-Frame :height-chars
     1322           ,input true
     1323           ) .
     1324         run diasize_change-width in this-procedure
     1325           (input session :width-chars
     1326               - frame Dialog-Frame :width-chars
     1327           ,input true
     1328           ) .
     1329         assign
     1330           v-diasize-need-maximize = false
     1331         .
     1332       end.
     1333       else do:
     1334         run diasize_change-width in this-procedure
     1335           (input v-diasize-orig-frame-width
     1336               - frame Dialog-Frame :width-chars
     1337           ,input true
     1338           ) .
     1339         run diasize_change-height in this-procedure
     1340           (input v-diasize-orig-frame-height
     1341               - frame Dialog-Frame :height-chars
     1342           ,input true
     1343           ) .
     1344         assign
     1345           v-diasize-need-maximize = true
     1346         .
     1347       end.
     1348     end.
     1349   end procedure.
     1350   procedure diasize_restore-orig-size :
     1351     do
     1352     on error undo, return error return-value
     1353     :
     1354       assign
     1355         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1356         v-diasize-current-frame-height = frame Dialog-Frame :height
     1357       .
     1358       run diasize_set-height in this-procedure
     1359         (input  v-diasize-orig-frame-height
     1360         ,input  true
     1361         ) .
     1362       run diasize_set-width in this-procedure
     1363         (input  v-diasize-orig-frame-width
     1364         ,input  true
     1365         ) .
     1366     end.
     1367   end procedure.
     1368   procedure diasize_restore-current-size :
     1369     do
     1370     on error undo, return error return-value
     1371     :
     1372       run diasize_set-height in this-procedure
     1373         (input  v-diasize-current-frame-height
     1374         ,input  true
     1375         ) .
     1376       run diasize_set-width in this-procedure
     1377         (input  v-diasize-current-frame-width
     1378         ,input  true
     1379         ) .
     1380     end.
     1381   end procedure.
     1382   procedure diasize_set-browse-handle :
     1383     define input  parameter p-browse-handle as handle   no-undo .
     1384     define buffer buf_temp-browse-handle for temp-browse-handle .
     1385     do
     1386     on error undo, return error return-value
     1387     :
     1388       assign
     1389         v-diasize-browse-handle = p-browse-handle
     1390       .
     1391       for each buf_temp-browse-handle
     1392       on error undo, return error return-value
     1393       :
     1394         delete buf_temp-browse-handle .
     1395       end.
     1396     end.
     1397   end procedure.
     1398   procedure diasize_add_browse :
     1399     define input  parameter p-browse-type   as character no-undo .
     1400     define input  parameter p-browse-handle as handle    no-undo .
     1401     define buffer buf_temp-browse-handle for temp-browse-handle .
     1402     do
     1403     on error undo, return error return-value
     1404     :
     1405       assign
     1406         v-diasize-browse-number = v-diasize-browse-number + 1
     1407       .
     1408       create buf_temp-browse-handle .
     1409       assign
     1410         buf_temp-browse-handle.browse-type   = p-browse-type
     1411         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1412         buf_temp-browse-handle.browse-handle = p-browse-handle
     1413       .
     1414     end.
     1415   end procedure.
     1416   procedure diasize_init :
     1417     define variable v-default-value    as logical   no-undo .
     1418     define variable v-restore-saved    as logical   no-undo .
     1419     define variable v-resize-value-str as character no-undo .
     1420     do
     1421     on error undo, return error return-value
     1422     :
     1423       do with frame Dialog-Frame
     1424       :
     1425         assign
     1426           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1427           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1428           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1429         .
     1430         create button v-diasize-resize-button
     1431         assign
     1432           parent        = frame Dialog-Frame :first-child
     1433           label         = "s"
     1434           height-pixels = 16
     1435           width-pixels  = 16
     1436           visible       = true
     1437           sensitive     = true
     1438           movable       = true
     1439           triggers:
     1440             on end-move persistent run diasize_end-move in this-procedure .
     1441           end triggers.
     1442         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1443         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1444         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1445         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1446         assign
     1447           v-diasize-wndmax = false
     1448         .
     1449         if connected("ub") = true
     1450         then do:
     1451           define variable v-cntxt-db-num        as integer   no-undo .
     1452           define variable v-cntxt-userid        as character no-undo .
     1453           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1454                                             , OUTPUT v-cntxt-userid
     1455                                             ) .
     1456           run gbl/wndpar_r.p
     1457             (input  v-cntxt-db-num
     1458             ,input  v-cntxt-userid
     1459             ,input  'wndmax':U
     1460             ,output v-diasize-wndmax
     1461             ,output v-default-value
     1462             ) .
     1463         end.
     1464         assign
     1465           v-diasize-wndstore = false
     1466         .
     1467         if connected("ub") = true
     1468         then do:
     1469           run gbl/wndpar_r.p
     1470             (input  v-cntxt-db-num
     1471             ,input  v-cntxt-userid
     1472             ,input  'wndstore':U
     1473             ,output v-diasize-wndstore
     1474             ,output v-default-value
     1475             ) .
     1476         end.
     1477         assign
     1478           v-diasize-proc-name = entry(1, program-name(2), '.')
     1479         .
     1480         if v-diasize-wndstore = true
     1481         then do:
     1482           assign
     1483             v-restore-saved = false
     1484           .
     1485           if connected("ub") = true
     1486           then do:
     1487             run gbl/wndsizer.p
     1488               (input  v-cntxt-db-num
     1489               ,input  v-cntxt-userid
     1490               ,input  v-diasize-proc-name
     1491               ,input  'height':u
     1492               ,output v-resize-value-str
     1493               ) .
     1494             if v-resize-value-str <> '':U
     1495             then do:
     1496               run diasize_change-height in this-procedure
     1497                 (input  integer(v-resize-value-str)
     1498                 ,input  true
     1499                 ) .
     1500               assign
     1501                 v-restore-saved = true
     1502               .
     1503             end.
     1504           end.
     1505           if connected("ub") = true
     1506           then do:
     1507             run gbl/wndsizer.p
     1508               (input  v-cntxt-db-num
     1509               ,input  v-cntxt-userid
     1510               ,input  v-diasize-proc-name
     1511               ,input  'width':u
     1512               ,output v-resize-value-str
     1513               ) .
     1514             if v-resize-value-str <> '':U
     1515             then do:
     1516               run diasize_change-width in this-procedure
     1517                 (input  integer(v-resize-value-str)
     1518                 ,input  true
     1519                 ) .
     1520               assign
     1521                 v-restore-saved = true
     1522               .
     1523             end.
     1524           end.
     1525           if v-restore-saved <> true
     1526           then do:
     1527             if v-diasize-wndmax = true
     1528             then do:
     1529               run diasize_maximize in this-procedure
     1530                 (input  true
     1531                 ) .
     1532             end.
     1533           end.
     1534         end.
     1535         else do:
     1536           if v-diasize-wndmax = true
     1537           then do:
     1538             run diasize_maximize in this-procedure
     1539               (input  true
     1540               ) .
     1541           end.
     1542         end.
     1543       end.
     1544     end.
     1545   end procedure.
     1546   procedure diasize_need-full-display :
     1547     define output parameter p-need-full-display as logical   no-undo .
     1548     do
     1549     on error undo, return error return-value
     1550     :
     1551       assign
     1552         p-need-full-display = v-diasize-need-full-display
     1553       .
     1554       assign
     1555         v-diasize-need-full-display = false
     1556       .
     1557     end.
     1558   end procedure.
     1559   procedure get-context :
     1560      define output parameter p-db-num as integer          no-undo.
     1561      define output parameter p-user-id as character        no-undo.
     1562      define variable v-login               as character    no-undo.
     1563      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1564      define buffer buf_user-login  for ub.user-login .
     1565      do
     1566      on error undo, return error
     1567      :
     1568            FIND FIRST buf_sys-ctrl no-lock.
     1569            ASSIGN
     1570               v-login = USERID("ub")
     1571               p-db-num = buf_sys-ctrl.db-num
     1572            .
     1573            FIND FIRST buf_user-login
     1574                 WHERE buf_user-login.db-num = p-db-num
     1575                   AND buf_user-login.user-login = v-login
     1576                 no-lock
     1577                 no-error
     1578                 .
     1579            IF AVAILABLE buf_user-login
     1580            THEN DO:
     1581               assign
     1582                  p-user-id = buf_user-login.user-id
     1583               .
     1584            END.
     1585      end.
     1586   end procedure.
     1587       run diasize_init in this-procedure .
     1588   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1589   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1590   MAIN-BLOCK:
     1591   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1592      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1593     RUN enable_UI.
     1594     apply "entry" to browse-1.
     1595     WAIT-FOR GO OF FRAME Dialog-Frame.
     1596   END.
     1597   RUN disable_UI.
     1598   PROCEDURE b-mark-press :
     1599   do
     1600   on error undo, return error
     1601   :
     1602       define variable v-focused-row       as integer              no-undo.
     1603       define variable v-repositioned-row  as integer              no-undo.
     1604       assign
     1605           v-focused-row      = browse-1 :focused-row in frame Dialog-Frame.
     1606           v-repositioned-row = current-result-row( "browse-1" )
     1607       .
     1608       if rcs-destn.status_ = '*'
     1609       then do:
     1610           assign
     1611               rcs-destn.status_ = ''
     1612           .
     1613       end.
     1614       else do:
     1615           assign
     1616               rcs-destn.status_ = '*'
     1617           .
     1618       end.
     1619       OPEN QUERY BROWSE-1 FOR EACH rcs-destn SHARE-LOCK     BY rcs-destn.name.
     1620       if v-focused-row > browse-1 :height - 2
     1621       then do:
     1622           assign
     1623               v-repositioned-row  = v-repositioned-row + 1
     1624           .
     1625       end.
     1626       else do:
     1627           assign
     1628               v-focused-row       = v-focused-row + 1
     1629               v-repositioned-row  = v-repositioned-row + 1
     1630           .
     1631       end.
     1632       browse-1 :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dialog-Frame.
     1633       reposition browse-1 to row v-repositioned-row.
     1634   end.
     1635   END PROCEDURE.
     1636   PROCEDURE delete-objects :
     1637   do
     1638   on error undo, return error
     1639   :
     1640   define input parameter p-destination_rowid  as character    no-undo.
     1641       define buffer buf_rcs-destn       for rcs-destn.
     1642       find first buf_rcs-destn exclusive-lock
     1643            where buf_rcs-destn.destination_rowid    = p-destination_rowid
     1644       no-error.
     1645       if not available buf_rcs-destn
     1646       then do:
     1647           undo, return error "delete-objects: Не удалось удалить запись." + chr(10) + return-value.
     1648       end.
     1649       else do:
     1650           delete buf_rcs-destn.
     1651       end.
     1652   end.
     1653   END PROCEDURE.
     1654   PROCEDURE disable_UI :
     1655     HIDE FRAME Dialog-Frame.
     1656   END PROCEDURE.
     1657   PROCEDURE enable_UI :
     1658     ENABLE b-exit b-mark b-add b-chg b-del b-help BROWSE-1
     1659         WITH FRAME Dialog-Frame.
     1660     VIEW FRAME Dialog-Frame.
     1661     OPEN QUERY BROWSE-1 FOR EACH rcs-destn SHARE-LOCK     BY rcs-destn.name.
     1662   END PROCEDURE.
