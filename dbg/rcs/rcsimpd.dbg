      124   procedure proc-alt-shift-f2:
      125     if not ibs.th.gbl.gbl-var:rcode
      126   then
      127     run gbl\inidebug.p .
      128   end.
      129   procedure proc-alt-shift-f3:
      130     run gbl/prvssinf.p
      131       ( input this-procedure
      132       ) .
      133   end.
      134   define variable v-inform-launched as logical no-undo initial false .
      135   procedure proc-alt-shift-f4:
      136     define variable v-action as character no-undo .
      137     if v-inform-launched = false then do:
      138       assign
      139         v-inform-launched = true
      140       .
      141       run gbl/d-inform.w
      142         (  input self
      143         ,  input this-procedure
      144         , output v-action
      145         ) no-error .
      146       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      147       assign
      148         v-inform-launched = false
      149       .
      150     end.
      151   end.
      152   procedure proc-alt-f1:
      153     run gbl/corrhelp.p
      154       (input this-procedure
      155       ) .
      156   end .
      157   on alt-shift-f2 anywhere do:
      158     run proc-alt-shift-f2.
      159   end.
      160   on alt-shift-f3 anywhere do:
      161     run proc-alt-shift-f3 in this-procedure .
      162   end.
      163   on alt-shift-f4 anywhere do:
      164     run proc-alt-shift-f4 in this-procedure.
      165   end.
      166   on alt-f1 anywhere do:
      167     run proc-alt-f1 in this-procedure .
      168   end.
      169   DEFINE BUTTON b-add
      170        LABEL "&Добавить"
      171        SIZE 10 BY 1.
      172   DEFINE BUTTON b-chg
      173        LABEL "&Изменить"
      174        SIZE 10 BY 1.
      175   DEFINE BUTTON b-del
      176        LABEL "&Удалить"
      177        SIZE 10 BY 1.
      178   DEFINE BUTTON b-exit
      179        LABEL "&Выход"
      180        SIZE 10 BY 1
      181        BGCOLOR 8 .
      182   DEFINE BUTTON b-help
      183        LABEL "Помощ&ь"
      184        SIZE 10 BY 1
      185        BGCOLOR 8 .
      186   DEFINE BUTTON b-mark
      187        LABEL "&*"
      188        SIZE 3 BY 1.
      189   DEFINE QUERY BROWSE-1 FOR
      190         rcs-destn SCROLLING.
      191   DEFINE BROWSE BROWSE-1
      192     QUERY BROWSE-1 SHARE-LOCK NO-WAIT DISPLAY
      193         rcs-destn.status_ COLUMN-LABEL "*" FORMAT "X(1)"
      194         rcs-destn.destination_rowid
      195         rcs-destn.name
      196         rcs-destn.chanel COLUMN-LABEL "Канал" FORMAT "X(4)"
      197         rcs-destn.entity-th
      198       WITH NO-ROW-MARKERS SEPARATORS SIZE 95.5 BY 17.71.
      199   DEFINE FRAME Dialog-Frame
      200        b-exit AT ROW 1.17 COL 2
      201        b-mark AT ROW 1.17 COL 12
      202        b-add AT ROW 1.17 COL 15
      203        b-chg AT ROW 1.17 COL 25
      204        b-del AT ROW 1.17 COL 35
      205        b-help AT ROW 1.17 COL 87.5
      206        BROWSE-1 AT ROW 2.38 COL 2.13
      207        SPACE(0.49) SKIP(0.28)
      208       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      209            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      210            TITLE "Таблицы РКС - настройка идентификаторов"
      211            DEFAULT-BUTTON b-exit.
      212   ASSIGN
      213          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      214          FRAME Dialog-Frame:HIDDEN           = TRUE.
      215   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      216   DO:
      217     APPLY "END-ERROR":U TO SELF.
      218   END.
      219   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      220   DO:
      221       run rcs/rcsimpdf.w (
      222               input 'добавить-узлы':U
      223             , input ""
      224       ) no-error .
      225       if error-status :error
      226       then do:
      227           message
      228           vss-workfile vss-revision vss-description
      229           skip "Ошибка добавления описания объекта."
      230           skip return-value
      231           skip trim(error-status :get-message(1))
      232           trim(error-status :get-message(2))
      233           trim(error-status :get-message(3))
      234           trim(error-status :get-message(4))
      235           trim(error-status :get-message(5))
      236           view-as alert-box error.
      237           undo, return no-apply .
      238       end.
      239       OPEN QUERY BROWSE-1 FOR EACH rcs-destn SHARE-LOCK     BY rcs-destn.name.
      240   END.
      241   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      242   DO:
      243       run rcs/rcsimpdf.w (
      244               input 'изменить-узлы':U
      245             , input rcs-destn.destination_rowid
      246       ) no-error .
      247       if error-status :error
      248       then do:
      249           message
      250           vss-workfile vss-revision vss-description
      251           skip "Ошибка добавления имени файла."
      252           skip return-value
      253           skip trim(error-status :get-message(1))
      254           trim(error-status :get-message(2))
      255           trim(error-status :get-message(3))
      256           trim(error-status :get-message(4))
      257           trim(error-status :get-message(5))
      258           view-as alert-box error.
      259           undo, return no-apply .
      260       end.
      261       browse-1 :refresh ().
      262   END.
      263   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      264   DO:
      265       run delete-objects in this-procedure (
      266             input rcs-destn.destination_rowid
      267       ) no-error .
      268       if error-status :error
      269       then do:
      270           message
      271           vss-workfile vss-revision vss-description
      272           skip "Ошибка удаления записи."
      273           skip return-value
      274           skip trim(error-status :get-message(1))
      275           trim(error-status :get-message(2))
      276           trim(error-status :get-message(3))
      277           trim(error-status :get-message(4))
      278           trim(error-status :get-message(5))
      279           view-as alert-box error.
      280           undo, return no-apply .
      281       end.
      282       OPEN QUERY BROWSE-1 FOR EACH rcs-destn SHARE-LOCK     BY rcs-destn.name.
      283   END.
      284   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      285   DO:
      286       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
      287   END.
      288   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      289   or insert-mode of browse-1 IN FRAME Dialog-Frame
      290   DO:
      291       run b-mark-press in this-procedure no-error .
      292       if error-status :error
      293       then do:
      294           message
      295           vss-workfile vss-revision vss-description
      296           skip "Ошибка добавления имени файла."
      297           skip return-value
      298           skip trim(error-status :get-message(1))
      299           trim(error-status :get-message(2))
      300           trim(error-status :get-message(3))
      301           trim(error-status :get-message(4))
      302           trim(error-status :get-message(5))
      303           view-as alert-box error.
      304           undo, return no-apply .
      305       end.
      306       display
      307           rcs-destn.status_
      308       with browse browse-1.
      309   END.
      310   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      311   on help of frame Dialog-Frame
      312   do:
      313     run gbl/app_help.p
      314       (input this-procedure :file-name
      315       ,input ''
      316       ,input ?
      317       ) no-error.
      318     if error-status :error then do:
      319       message
      320         "Ошибка при вызове помощи"
      321         error-status :get-message(1)
      322         view-as alert-box .
      323     end.
      324   end.
      325   run minbtn-set in this-procedure .
      326   on choose of b-help in frame Dialog-Frame
      327   do:
      328     apply "help":u to frame Dialog-Frame .
      329   end.
      330   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      331   procedure minbtn-set :
      332       do
      333           on error undo, return error return-value
      334           :
      335           define variable ii              as integer       no-undo .
      336           define variable fh              as widget-handle no-undo .
      337           define variable hh              as widget-handle no-undo .
      338           define variable v-h             as handle        extent 4 no-undo .
      339           define variable v-name-button   as character     no-undo .
      340           define variable v-help-old-x    as decimal       no-undo .
      341           define variable v-help-old-y    as decimal       no-undo .
      342           define variable v-help-old-size as decimal       no-undo .
      343           define variable v-frame-width   as decimal       no-undo .
      344           define variable jj              as integer       no-undo .
      345           do
      346               on error undo, return error
      347               :
      348               assign
      349                   v-frame-width = frame Dialog-Frame:width - 0.3
      350                   fh            = frame Dialog-Frame:first-child
      351                   hh            = fh:first-child
      352                   ii            = 1
      353                   .
      354               do while valid-handle(hh):
      355                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      356                   do:
      357                       case lc(hh:name) :
      358                           when "b-help" then
      359                               do:
      360                                   hh:load-image-up("cmp/b-help.bmp":u) .
      361                                   hh:load-image-down("cmp/b-help.bmp":u) .
      362                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      363                                   hh:TOOLTIP = "Помощь" .
      364                                   v-help-old-x = hh:column .
      365                                   v-help-old-y = hh:row    .
      366                                   v-help-old-size = hh:width .
      367                                   hh:width-chars = 2.5 .
      368                               end.
      369                           when "b-print" then
      370                               do:
      371                                   hh:load-image("cmp/b-print.bmp":u) .
      372                                   hh:TOOLTIP = "Печать" .
      373                                   v-h[ii] = hh:handle .
      374                                   ii = ii + 1 .
      375                                   hh:width-chars = 3 .
      376                               end.
      377                           when "b-history" or
      378                           when "b-hist" then
      379                               do:
      380                                   hh:load-image("cmp/b-hist.bmp":u) .
      381                                   hh:TOOLTIP = "История" .
      382                                   v-h[ii] = hh:handle .
      383                                   ii = ii + 1 .
      384                                   hh:width-chars = 3 .
      385                               end.
      386                           when "b-sch" then
      387                               do:
      388                                   hh:load-image("cmp/b-sch.bmp":u) .
      389                                   hh:TOOLTIP = "Установка Фильтра" .
      390                                   v-h[ii] = hh:handle .
      391                                   ii = ii + 1 .
      392                                   hh:width-chars = 3 .
      393                               end.
      394                           when "b-hist-user" then
      395                               do:
      396                                   hh:load-image("cmp/b-hist.bmp":u) .
      397                                   hh:TOOLTIP = "История пользователя" .
      398                                   ii = ii + 1 .
      399                               end.
      400                       end case.
      401                   end.
      402                   hh = hh:next-sibling.
      403               end.
      404               b-help:column = v-frame-width - b-help:width-chars.
      405               jj = 0.
      406               repeat ii = 4 to 1 by -1 :
      407                   if valid-handle (v-h[ii] ) then
      408                   do:
      409                       jj  = jj + 1 .
      410                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      411                       v-h[ii]:row    = v-help-old-y .
      412                   end.
      413               end.
      414           end.
      415       end.
      416   end procedure.
      417   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      418   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      419   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      420   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      421   define variable v-diasize-current-frame-width  as decimal   no-undo .
      422   define variable v-diasize-current-frame-height as decimal   no-undo .
      423   define variable v-diasize-change-size          as logical   no-undo .
      424   define variable v-diasize-resize-button        as handle    no-undo .
      425   define variable v-diasize-wndmax               as logical   no-undo .
      426   define variable v-diasize-wndstore             as logical   no-undo .
      427   define variable v-diasize-proc-name            as character no-undo .
      428   define variable v-diasize-browse-handle        as handle    no-undo .
      429   define variable v-diasize-browse-number        as integer   no-undo .
      430   define variable v-diasize-need-full-display    as logical   no-undo init false .
      431   define temp-table temp-diasize-handle no-undo
      432     field handle-value  as handle
      433     field save-position as decimal
      434     index xpk is primary unique handle-value
      435     .
      436   define temp-table temp-browse-handle no-undo
      437     field browse-type   as character
      438     field browse-number as integer
      439     field browse-handle as handle
      440     field original-size as decimal
      441     index xpk is primary unique browse-type browse-number
      442     index xie browse-type browse-handle
      443   .
      444   procedure diasize_change-height :
      445     define input  parameter p-change-value  as decimal   no-undo .
      446     define input  parameter p-move-resize   as logical   no-undo .
      447     define variable v-field-group-handle    as handle    no-undo .
      448     define variable v-object-handle         as handle    no-undo .
      449     define variable v-frame-height          as decimal   no-undo .
      450     define variable v-frame-virtual-height  as decimal   no-undo .
      451     define variable v-browse-height         as decimal   no-undo .
      452     define variable v-window-height         as decimal   no-undo .
      453     define variable v-window-virtual-height as decimal   no-undo .
      454     define variable v-change-sign           as integer   no-undo .
      455     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      456     define buffer buf_temp-browse-handle  for temp-browse-handle .
      457     if p-change-value > 0
      458     then do:
      459       if frame Dialog-Frame :height + p-change-value
      460           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      461       then do:
      462         assign
      463           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      464                           - (frame Dialog-Frame :height-chars)
      465         .
      466         if p-change-value <= 0
      467         then do:
      468           run diasize_position-resize-button in this-procedure .
      469           return .
      470         end.
      471       end.
      472     end.
      473     if p-change-value < 0
      474     then do:
      475       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      476       then do:
      477         assign
      478           p-change-value = v-diasize-orig-frame-height
      479                          - (frame Dialog-Frame :height-chars)
      480         .
      481         if p-change-value >= 0
      482         then do:
      483           run diasize_position-resize-button in this-procedure .
      484           return .
      485         end.
      486       end.
      487     end.
      488     if p-change-value >= 0
      489     then do:
      490       assign
      491         v-change-sign = 1
      492       .
      493     end.
      494     else do:
      495       assign
      496         v-change-sign = -1
      497       .
      498     end.
      499     assign
      500       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      501     .
      502     if p-change-value = 0
      503     then do:
      504       run diasize_position-resize-button in this-procedure .
      505       return .
      506     end.
      507     move_block:
      508     do
      509     on error undo move_block, retry move_block
      510     :
      511       if retry
      512       then do:
      513         do
      514         on error undo move_block, leave move_block
      515         :
      516           if p-change-value > 0
      517           then do:
      518             for each buf_temp-diasize-handle
      519             on error undo, next
      520             :
      521               assign
      522                 v-object-handle = buf_temp-diasize-handle.handle-value
      523               .
      524               if v-object-handle <> v-diasize-resize-button
      525               then do:
      526                 assign
      527                   v-object-handle :row = buf_temp-diasize-handle.save-position
      528                 .
      529               end.
      530             end.
      531             assign
      532               v-diasize-browse-handle :height = v-browse-height
      533             .
      534             for each buf_temp-browse-handle
