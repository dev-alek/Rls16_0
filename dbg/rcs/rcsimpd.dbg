       99   define variable v-default-boss              as integer        no-undo.
      100   define variable v-unit-pieces               as character      no-undo.
      101   define variable v-unit-divisional           as character      no-undo.
      102   define variable v-unit-weight               as character      no-undo.
      103   define variable v-selected-object-name      as character      no-undo.
      104   define variable v-goods-parameter-dif-nam1  as logical  init yes no-undo.
      105   define variable v-goods-parameter-dif-nam2  as logical  init no  no-undo.
      106   define variable v-param-type                as character         no-undo.
