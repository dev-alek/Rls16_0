        1   define input parameter p-mode               as character    no-undo.
        2   define input parameter p-destination_rowid  as character    no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Импорт данных из РКС - диалог настройки таблиц.".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   DEFINE BUTTON b-exit
      113        LABEL "&Выход"
      114        SIZE 10 BY 1
      115        BGCOLOR 8 .
      116   DEFINE BUTTON b-help
      117        LABEL "Помощ&ь"
      118        SIZE 10 BY 1
      119        BGCOLOR 8 .
      120   DEFINE VARIABLE fi-chanal AS CHARACTER FORMAT "X(5)"
      121        LABEL "Канал"
      122        VIEW-AS FILL-IN
      123        SIZE 7.38 BY 1.
      124   DEFINE VARIABLE fi-entity-th AS CHARACTER FORMAT "X(30)"
      125        LABEL "Сущности TH"
      126        VIEW-AS FILL-IN
      127        SIZE 29.13 BY 1.
      128   DEFINE VARIABLE fi-id AS CHARACTER FORMAT "X(22)"
      129        LABEL "Идентификатор"
      130        VIEW-AS FILL-IN
      131        SIZE 29 BY 1.
      132   DEFINE VARIABLE fi-name AS CHARACTER FORMAT "X(30)"
      133        LABEL "Имя объекта"
      134        VIEW-AS FILL-IN
      135        SIZE 29.13 BY 1.
      136   DEFINE FRAME Dialog-Frame
      137        b-exit AT ROW 1.17 COL 2
      138        b-help AT ROW 1.17 COL 35.5
      139        fi-id AT ROW 2.67 COL 1.13
      140        fi-name AT ROW 3.96 COL 3.13
      141        fi-entity-th AT ROW 5.29 COL 3.13
      142        fi-chanal AT ROW 6.5 COL 9.13
      143        SPACE(23.36) SKIP(0.78)
      144       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      145            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      146            TITLE "Имя файла"
      147            DEFAULT-BUTTON b-exit.
      148   ASSIGN
      149          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      150          FRAME Dialog-Frame:HIDDEN           = TRUE.
      151   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      152   DO:
      153     APPLY "END-ERROR":U TO SELF.
      154   END.
      155   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      156   DO:
      157       run assign-fields in this-procedure(
      158             input fi-id :screen-value
      159           , input fi-name :screen-value
      160           , input fi-entity-th :screen-value
      161           , input fi-chanal :screen-value
      162           , input recid( rcs-destn )
      163       ) no-error.
      164       if error-status :error
      165       then do:
      166           message
      167           "Ошибка записи: " + return-value
      168           view-as alert-box warning.
      169           undo, return no-apply.
      170       end.
      171       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
      172   END.
      173   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      174   on help of frame Dialog-Frame
      175   do:
      176     run gbl/app_help.p
      177       (input this-procedure :file-name
      178       ,input ''
      179       ,input ?
      180       ) no-error.
      181     if error-status :error then do:
      182       message
      183         "Ошибка при вызове помощи"
      184         error-status :get-message(1)
      185         view-as alert-box .
      186     end.
      187   end.
      188   run minbtn-set in this-procedure .
      189   on choose of b-help in frame Dialog-Frame
      190   do:
      191     apply "help":u to frame Dialog-Frame .
      192   end.
      193   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      194   procedure minbtn-set :
      195       do
      196           on error undo, return error return-value
      197           :
      198           define variable ii              as integer       no-undo .
      199           define variable fh              as widget-handle no-undo .
      200           define variable hh              as widget-handle no-undo .
      201           define variable v-h             as handle        extent 4 no-undo .
      202           define variable v-name-button   as character     no-undo .
      203           define variable v-help-old-x    as decimal       no-undo .
      204           define variable v-help-old-y    as decimal       no-undo .
      205           define variable v-help-old-size as decimal       no-undo .
      206           define variable v-frame-width   as decimal       no-undo .
      207           define variable jj              as integer       no-undo .
      208           do
      209               on error undo, return error
      210               :
      211               assign
      212                   v-frame-width = frame Dialog-Frame:width - 0.3
      213                   fh            = frame Dialog-Frame:first-child
      214                   hh            = fh:first-child
      215                   ii            = 1
      216                   .
      217               do while valid-handle(hh):
      218                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      219                   do:
      220                       case lc(hh:name) :
      221                           when "b-help" then
      222                               do:
      223                                   hh:load-image-up("cmp/b-help.bmp":u) .
      224                                   hh:load-image-down("cmp/b-help.bmp":u) .
      225                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      226                                   hh:TOOLTIP = "Помощь" .
      227                                   v-help-old-x = hh:column .
      228                                   v-help-old-y = hh:row    .
      229                                   v-help-old-size = hh:width .
      230                                   hh:width-chars = 2.5 .
      231                               end.
      232                           when "b-print" then
      233                               do:
      234                                   hh:load-image("cmp/b-print.bmp":u) .
      235                                   hh:TOOLTIP = "Печать" .
      236                                   v-h[ii] = hh:handle .
      237                                   ii = ii + 1 .
      238                                   hh:width-chars = 3 .
      239                               end.
      240                           when "b-history" or
      241                           when "b-hist" then
      242                               do:
      243                                   hh:load-image("cmp/b-hist.bmp":u) .
      244                                   hh:TOOLTIP = "История" .
      245                                   v-h[ii] = hh:handle .
      246                                   ii = ii + 1 .
      247                                   hh:width-chars = 3 .
      248                               end.
      249                           when "b-sch" then
      250                               do:
      251                                   hh:load-image("cmp/b-sch.bmp":u) .
      252                                   hh:TOOLTIP = "Установка Фильтра" .
      253                                   v-h[ii] = hh:handle .
      254                                   ii = ii + 1 .
      255                                   hh:width-chars = 3 .
      256                               end.
      257                           when "b-hist-user" then
      258                               do:
      259                                   hh:load-image("cmp/b-hist.bmp":u) .
      260                                   hh:TOOLTIP = "История пользователя" .
      261                                   ii = ii + 1 .
      262                               end.
      263                       end case.
      264                   end.
      265                   hh = hh:next-sibling.
      266               end.
      267               b-help:column = v-frame-width - b-help:width-chars.
      268               jj = 0.
      269               repeat ii = 4 to 1 by -1 :
      270                   if valid-handle (v-h[ii] ) then
      271                   do:
      272                       jj  = jj + 1 .
      273                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      274                       v-h[ii]:row    = v-help-old-y .
      275                   end.
      276               end.
      277           end.
      278       end.
      279   end procedure.
      280   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      281   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      282   MAIN-BLOCK:
      283   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      284      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      285       if p-mode = 'добавить-узлы':U
      286       then do:
      287           do transaction:
      288               create rcs-destn.
      289               assign
      290                   p-destination_rowid         = "<Новый идентификатор>"
      291                   rcs-destn.destination_rowid = p-destination_rowid
      292               .
      293           end.
      294       end.
      295       else do:
      296           find first rcs-destn no-lock
      297                where rcs-destn.destination_rowid = p-destination_rowid
      298           no-error.
      299           if not available rcs-destn
      300           then do:
      301               undo, return error "Неверно выбрана запись для изменения." + chr(10) + return-value.
      302           end.
      303       end.
      304       RUN enable_UI.
      305       assign
      306           fi-id           = rcs-destn.destination_rowid
      307       .
      308       if p-mode <> 'добавить-узлы':U
      309       then do:
      310           assign
      311               fi-name         = rcs-destn.name
      312               fi-entity-th    = rcs-destn.entity-th
      313               fi-chanal       = rcs-destn.chanel
      314           .
      315       end.
      316       display
      317           fi-id
      318           fi-name
      319           fi-entity-th
      320           fi-chanal
      321       with frame Dialog-Frame.
      322       apply "entry" to fi-id.
      323       WAIT-FOR GO OF FRAME Dialog-Frame.
      324   END.
      325   RUN disable_UI.
      326   PROCEDURE assign-fields :
      327   do
      328   on error undo, return error
      329   :
      330   define input parameter p-id                 as character    no-undo.
      331   define input parameter p-name               as character    no-undo.
      332   define input parameter p-entity-th          as character    no-undo.
      333   define input parameter p-chanel             as character    no-undo.
      334   define input parameter p-current-recid      as recid        no-undo.
      335       define buffer buf_rcs-destn         for rcs-destn.
      336       define buffer buf_current_rcs-destn for rcs-destn.
      337       find first buf_current_rcs-destn exclusive-lock
      338            where recid( buf_current_rcs-destn )    = p-current-recid
      339       no-error .
      340       if not available buf_current_rcs-destn
      341       then do:
      342           undo, return error "Ошибка поиска текущей записи" + chr(10) + return-value.
      343       end.
      344       find first buf_rcs-destn no-lock
      345            where buf_rcs-destn.destination_rowid    = p-id
      346              and recid( buf_rcs-destn ) <> recid( buf_current_rcs-destn )
      347       no-error .
      348       if available buf_rcs-destn
      349       then do:
      350           undo, return error "Уже есть запись с таким идентификатором." + chr(10) + return-value.
      351       end.
      352       find first buf_rcs-destn no-lock
      353            where buf_rcs-destn.name    = p-name
      354              and recid( buf_rcs-destn ) <> recid( buf_current_rcs-destn )
      355       no-error .
      356       if available buf_rcs-destn
      357       then do:
      358           undo, return error "Уже есть запись для такого поля." + chr(10) + return-value.
      359       end.
      360       assign
      361           buf_current_rcs-destn.destination_rowid     = p-id
      362           buf_current_rcs-destn.name                  = p-name
      363           buf_current_rcs-destn.entity-th             = p-entity-th
      364           buf_current_rcs-destn.chanel                = p-chanel
      365       .
      366   end.
      367   END PROCEDURE.
      368   PROCEDURE disable_UI :
      369     HIDE FRAME Dialog-Frame.
      370   END PROCEDURE.
      371   PROCEDURE enable_UI :
      372     DISPLAY fi-id fi-name fi-entity-th fi-chanal
      373         WITH FRAME Dialog-Frame.
      374     ENABLE b-exit b-help fi-id fi-name fi-entity-th fi-chanal
      375         WITH FRAME Dialog-Frame.
      376     VIEW FRAME Dialog-Frame.
      377   END PROCEDURE.
