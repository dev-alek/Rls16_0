        1   define input parameter p-mode               as character    no-undo.
        2   define input parameter p-id  as character    no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Импорт данных из РКС - диалог настройки объектов.".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   DEFINE BUTTON b-exit
      113        LABEL "&Выход"
      114        SIZE 10 BY 1
      115        BGCOLOR 8 .
      116   DEFINE BUTTON b-help
      117        LABEL "Помощ&ь"
      118        SIZE 10 BY 1
      119        BGCOLOR 8 .
      120   DEFINE VARIABLE fi-id AS CHARACTER FORMAT "X(22)"
      121        LABEL "Идентификатор"
      122        VIEW-AS FILL-IN
      123        SIZE 29 BY 1.
      124   DEFINE VARIABLE fi-name AS CHARACTER FORMAT "X(30)"
      125        LABEL "Имя объекта"
      126        VIEW-AS FILL-IN
      127        SIZE 29.13 BY 1.
      128   DEFINE VARIABLE fi-obj-code AS DECIMAL FORMAT ">>>>>>9" INITIAL 0
      129        LABEL "Код объекта"
      130        VIEW-AS FILL-IN
      131        SIZE 13.88 BY 1.
      132   DEFINE VARIABLE rs-obj-type AS INTEGER
      133        VIEW-AS RADIO-SET HORIZONTAL
      134        RADIO-BUTTONS
      135             "Магазин", 1,
      136   "Склад", 2
      137        SIZE 29.25 BY 1 NO-UNDO.
      138   DEFINE FRAME Dialog-Frame
      139        b-exit AT ROW 1.17 COL 2
      140        b-help AT ROW 1.17 COL 35.5
      141        fi-id AT ROW 2.5 COL 1.13
      142        fi-name AT ROW 4 COL 3.13
      143        rs-obj-type AT ROW 5.5 COL 16.13 NO-LABEL
      144        fi-obj-code AT ROW 7 COL 3.13
      145        "Тип объекта:" VIEW-AS TEXT
      146             SIZE 12.5 BY 1.17 AT ROW 5.38 COL 2.88
      147        SPACE(31.49) SKIP(2.11)
      148       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      149            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      150            TITLE "Объекты"
      151            DEFAULT-BUTTON b-exit.
      152   ASSIGN
      153          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      154          FRAME Dialog-Frame:HIDDEN           = TRUE.
      155   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      156   DO:
      157     APPLY "END-ERROR":U TO SELF.
      158   END.
      159   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      160   DO:
      161       define variable v-obj-type     as character         no-undo.
      162       assign
      163           rs-obj-type
      164           v-obj-type  = ( if rs-obj-type = 1 then 'маг':U else 'скл':U )
      165       .
      166       run assign-fields in this-procedure(
      167             input fi-id :screen-value
      168           , input fi-name :screen-value
      169           , input v-obj-type
      170           , input fi-obj-code :screen-value
      171           , input recid( rcs-shops )
      172       ) no-error.
      173       if error-status :error
      174       then do:
      175           message
      176           "Ошибка записи: " + return-value
      177           view-as alert-box warning.
      178           undo, return no-apply.
      179       end.
      180       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
      181   END.
      182   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      183   on help of frame Dialog-Frame
      184   do:
      185     run gbl/app_help.p
      186       (input this-procedure :file-name
      187       ,input ''
      188       ,input ?
      189       ) no-error.
      190     if error-status :error then do:
      191       message
      192         "Ошибка при вызове помощи"
      193         error-status :get-message(1)
      194         view-as alert-box .
      195     end.
      196   end.
      197   run minbtn-set in this-procedure .
      198   on choose of b-help in frame Dialog-Frame
      199   do:
      200     apply "help":u to frame Dialog-Frame .
      201   end.
      202   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      203   procedure minbtn-set :
      204       do
      205           on error undo, return error return-value
      206           :
      207           define variable ii              as integer       no-undo .
      208           define variable fh              as widget-handle no-undo .
      209           define variable hh              as widget-handle no-undo .
      210           define variable v-h             as handle        extent 4 no-undo .
      211           define variable v-name-button   as character     no-undo .
      212           define variable v-help-old-x    as decimal       no-undo .
      213           define variable v-help-old-y    as decimal       no-undo .
      214           define variable v-help-old-size as decimal       no-undo .
      215           define variable v-frame-width   as decimal       no-undo .
      216           define variable jj              as integer       no-undo .
      217           do
      218               on error undo, return error
      219               :
      220               assign
      221                   v-frame-width = frame Dialog-Frame:width - 0.3
      222                   fh            = frame Dialog-Frame:first-child
      223                   hh            = fh:first-child
      224                   ii            = 1
      225                   .
      226               do while valid-handle(hh):
      227                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      228                   do:
      229                       case lc(hh:name) :
      230                           when "b-help" then
      231                               do:
      232                                   hh:load-image-up("cmp/b-help.bmp":u) .
      233                                   hh:load-image-down("cmp/b-help.bmp":u) .
      234                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      235                                   hh:TOOLTIP = "Помощь" .
      236                                   v-help-old-x = hh:column .
      237                                   v-help-old-y = hh:row    .
      238                                   v-help-old-size = hh:width .
      239                                   hh:width-chars = 2.5 .
      240                               end.
      241                           when "b-print" then
      242                               do:
      243                                   hh:load-image("cmp/b-print.bmp":u) .
      244                                   hh:TOOLTIP = "Печать" .
      245                                   v-h[ii] = hh:handle .
      246                                   ii = ii + 1 .
      247                                   hh:width-chars = 3 .
      248                               end.
      249                           when "b-history" or
      250                           when "b-hist" then
      251                               do:
      252                                   hh:load-image("cmp/b-hist.bmp":u) .
      253                                   hh:TOOLTIP = "История" .
      254                                   v-h[ii] = hh:handle .
      255                                   ii = ii + 1 .
      256                                   hh:width-chars = 3 .
      257                               end.
      258                           when "b-sch" then
      259                               do:
      260                                   hh:load-image("cmp/b-sch.bmp":u) .
      261                                   hh:TOOLTIP = "Установка Фильтра" .
      262                                   v-h[ii] = hh:handle .
      263                                   ii = ii + 1 .
      264                                   hh:width-chars = 3 .
      265                               end.
      266                           when "b-hist-user" then
      267                               do:
      268                                   hh:load-image("cmp/b-hist.bmp":u) .
      269                                   hh:TOOLTIP = "История пользователя" .
      270                                   ii = ii + 1 .
      271                               end.
      272                       end case.
      273                   end.
      274                   hh = hh:next-sibling.
      275               end.
      276               b-help:column = v-frame-width - b-help:width-chars.
      277               jj = 0.
      278               repeat ii = 4 to 1 by -1 :
      279                   if valid-handle (v-h[ii] ) then
      280                   do:
      281                       jj  = jj + 1 .
      282                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      283                       v-h[ii]:row    = v-help-old-y .
      284                   end.
      285               end.
      286           end.
      287       end.
      288   end procedure.
      289   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      290   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      291   MAIN-BLOCK:
      292   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      293      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      294       if p-mode = 'добавить-узлы':U
      295       then do:
      296           do transaction:
      297               create rcs-shops.
      298               assign
      299                   p-id         = "<Новый идентификатор>"
      300                   rcs-shops.id    = p-id
      301                   rcs-shops.obj-type = 'маг':U
      302                                   rcs-shops.obj-code = 0
      303               .
      304           end.
      305       end.
      306       else do:
      307           find first rcs-shops no-lock
      308                where rcs-shops.id = p-id
      309           no-error.
      310           if not available rcs-shops
      311           then do:
      312               undo, return error "Неверно выбрана запись для изменения." + chr(10) + return-value.
      313           end.
      314       end.
      315       RUN enable_UI.
      316       assign
      317           fi-id           = rcs-shops.id
      318           rs-obj-type     = ( if rcs-shops.obj-type = 'маг':U then 1 else 2 )
      319           fi-obj-code     = rcs-shops.obj-code
      320       .
      321       if p-mode <> 'добавить-узлы':U
      322       then do:
      323           assign
      324               fi-name         = rcs-shops.name
      325           .
      326       end.
      327       display
      328           fi-id
      329           fi-name
      330           rs-obj-type
      331           fi-obj-code
      332       with frame Dialog-Frame.
      333       apply "entry" to fi-id.
      334       WAIT-FOR GO OF FRAME Dialog-Frame.
      335   END.
      336   RUN disable_UI.
      337   PROCEDURE assign-fields :
      338   do
      339   on error undo, return error
      340   :
      341   define input parameter p-id                 as character    no-undo.
      342   define input parameter p-name               as character    no-undo.
      343   define input parameter p-obj-type           as character    no-undo.
      344   define input parameter p-obj-code           as integer      no-undo.
      345   define input parameter p-current-recid      as recid        no-undo.
      346       define buffer buf_rcs-shops         for rcs-shops.
      347       define buffer buf_current_rcs-shops for rcs-shops.
      348       find first buf_current_rcs-shops exclusive-lock
      349            where recid( buf_current_rcs-shops )    = p-current-recid
      350       no-error .
      351       if not available buf_current_rcs-shops
      352       then do:
      353           undo, return error "Ошибка поиска текущей записи" + chr(10) + return-value.
      354       end.
      355       find first buf_rcs-shops no-lock
      356            where buf_rcs-shops.id    = p-id
      357              and recid( buf_rcs-shops ) <> recid( buf_current_rcs-shops )
      358       no-error .
      359       if available buf_rcs-shops
      360       then do:
      361           undo, return error "Уже есть запись с таким идентификатором." + chr(10) + return-value.
      362       end.
      363       find first buf_rcs-shops no-lock
      364            where buf_rcs-shops.obj-type   = p-obj-type
      365              and buf_rcs-shops.obj-code   = p-obj-code
      366              and recid( buf_rcs-shops ) <> recid( buf_current_rcs-shops )
      367       no-error .
      368       if available buf_rcs-shops
      369       then do:
      370           undo, return error "Уже есть запись для такого объекта." + chr(10) + return-value.
      371       end.
      372       assign
      373           buf_current_rcs-shops.id        = p-id
      374           buf_current_rcs-shops.name      = p-name
      375           buf_current_rcs-shops.obj-type  = p-obj-type
      376           buf_current_rcs-shops.obj-code  = p-obj-code
      377       .
      378   end.
      379   END PROCEDURE.
      380   PROCEDURE disable_UI :
      381     HIDE FRAME Dialog-Frame.
      382   END PROCEDURE.
      383   PROCEDURE enable_UI :
      384     DISPLAY fi-id fi-name rs-obj-type fi-obj-code
      385         WITH FRAME Dialog-Frame.
      386     ENABLE b-exit b-help fi-id fi-name rs-obj-type fi-obj-code
      387         WITH FRAME Dialog-Frame.
      388     VIEW FRAME Dialog-Frame.
      389   END PROCEDURE.
