        1   block-level on error undo, throw.
        2   define input parameter p-fi as handle       no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: exp-ini.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: rcs/exp-ini.p $":U .
        8   define variable vss-description as character no-undo init "Начальная выгрузка данных для RCS".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define  temp-table temp-host no-undo
       69     field host-code like ub.store.host-code
       70     index xpk host-code
       71   .
       72   define  temp-table temp-obj no-undo
       73     field obj-type  like ub.clients.obj-type
       74     field obj-code  like ub.clients.obj-code
       75     field host-code like ub.store.host-code
       76     field db-num    like ub.clients.db-num
       77     index xpk  obj-type obj-code
       78     index xie1 host-code
       79     index xie2 db-num host-code
       80   .
       81   procedure init-temphost:
       82     define buffer buf_store   for ub.store .
       83     define buffer buf_shop    for ub.shop .
       84     define buffer buf_clients for ub.clients .
       85     define buffer buf_db for ub.db .
       86     define buffer buf_temp-host for temp-host .
       87     define buffer buf_temp-obj for temp-obj .
       88     do
       89     on error undo, return error return-value
       90     :
       91       for each buf_store
       92       on error undo, return error
       93       :
       94         find first buf_temp-host
       95           where buf_temp-host.host-code = buf_store.host-code
       96           no-error .
       97         if not available buf_temp-host
       98         then do:
       99           create buf_temp-host .
      100           assign
      101             buf_temp-host.host-code = buf_store.host-code
      102           .
      103         end.
      104         find first buf_clients no-lock
      105           where buf_clients.obj-type = 'скл':U
      106             and buf_clients.obj-code = buf_store.obj-code
      107           no-error .
      108         if not available buf_clients
      109         then do:
      110           message
      111             "Ошибка при поиске клиента" skip
      112             "Клиент" 'скл':U buf_store.obj-code skip
      113             view-as alert-box error .
      114           undo, return error .
      115         end.
      116         create buf_temp-obj .
      117         assign
      118           buf_temp-obj.obj-type  = 'скл':U
      119           buf_temp-obj.obj-code  = buf_store.obj-code
      120           buf_temp-obj.host-code = buf_store.host-code
      121           buf_temp-obj.db-num    = buf_clients.db-num
      122         .
      123       end.
      124       for each buf_shop
      125       on error undo, return error
      126       :
      127         find first buf_temp-host
      128           where buf_temp-host.host-code = buf_shop.host-code
      129           no-error .
      130         if not available buf_temp-host
      131         then do:
      132           create buf_temp-host .
      133           assign
      134             buf_temp-host.host-code = buf_shop.host-code
      135           .
      136         end.
      137         find first buf_clients no-lock
      138           where buf_clients.obj-type = 'маг':U
      139             and buf_clients.obj-code = buf_shop.obj-code
      140           no-error .
      141         if not available buf_clients then do:
      142           message
      143             "Ошибка при поиске клиента" skip
      144             "Клиент" 'маг':U buf_shop.obj-code skip
      145             view-as alert-box error .
      146           undo, return error .
      147         end.
      148         create buf_temp-obj .
      149         assign
      150           buf_temp-obj.obj-type  = 'маг':U
      151           buf_temp-obj.obj-code  = buf_shop.obj-code
      152           buf_temp-obj.host-code = buf_shop.host-code
      153           buf_temp-obj.db-num    = buf_clients.db-num
      154         .
      155       end.
      156     end.
      157   end.
      158   define stream out-stream.
      159   define temp-table temp_gds-costs no-undo
      160       field artic     as character
      161       field prod-type as character
      162       field prod-code as integer
      163       field empty     as logical
      164       field cost      as decimal
      165   index pi is primary unique artic prod-type prod-code
      166   index emp empty
      167   .
      168   define temp-table temp_gds-prices no-undo
      169       field artic     as character
      170       field prod-type as character
      171       field prod-code as integer
      172       field price     as decimal
      173   index pi is primary unique artic prod-type prod-code
      174   .
      175   do
      176   on error undo, return error
      177   :
      178       run export-goods in this-procedure no-error .
      179       if error-status :error
      180       then do:
      181           message
      182           vss-workfile vss-revision vss-description
      183           skip "Ошибка выгрузки товарного ряда."
      184           skip return-value
      185           skip trim(error-status :get-message(1))
      186               trim(error-status :get-message(2))
      187               trim(error-status :get-message(3))
      188               trim(error-status :get-message(4))
      189               trim(error-status :get-message(5))
      190           view-as alert-box error.
      191           undo, return error .
      192       end.
      193       run export-costs in this-procedure no-error .
      194       if error-status :error
      195       then do:
      196           message
      197           vss-workfile vss-revision vss-description
      198           skip "Ошибка выгрузки приходных цен."
      199           skip return-value
      200           skip trim(error-status :get-message(1))
      201               trim(error-status :get-message(2))
      202               trim(error-status :get-message(3))
      203               trim(error-status :get-message(4))
      204               trim(error-status :get-message(5))
      205           view-as alert-box error.
      206           undo, return error .
      207       end.
      208       run export-prices in this-procedure no-error .
      209       if error-status :error
      210       then do:
      211           message
      212           vss-workfile vss-revision vss-description
      213           skip "Ошибка выгрузки продажных цен."
      214           skip return-value
      215           skip trim(error-status :get-message(1))
      216               trim(error-status :get-message(2))
      217               trim(error-status :get-message(3))
      218               trim(error-status :get-message(4))
      219               trim(error-status :get-message(5))
      220           view-as alert-box error.
      221           undo, return error .
      222       end.
      223   end.
      224   procedure export-goods :
      225   do
      226   on error undo, return error
      227   :
      228       define variable v-count     as integer           no-undo.
      229       define buffer buf_goods     for goods.
      230       define buffer buf_bar-code  for bar-code.
      231       define buffer buf_prod-bc   for prod-bc.
      232       output stream out-stream to "bcodes.txt".
      233       for each buf_goods no-lock
      234       :
      235           for each buf_bar-code no-lock
      236              where buf_bar-code.gds-code   = buf_goods.gds-code
      237           :
      238               export stream out-stream delimiter ","
      239                   buf_goods.artic
      240                   buf_goods.prod-type
      241                   buf_goods.prod-code
      242                   buf_bar-code.b-code
      243                   'соб-БК':U
      244               .
      245           end.
      246           for each buf_prod-bc no-lock
      247              where buf_prod-bc.b-code   = buf_goods.gds-code
      248           :
      249               export stream out-stream delimiter ","
      250                   buf_goods.artic
      251                   buf_goods.prod-type
      252                   buf_goods.prod-code
      253                   buf_prod-bc.b-str
      254                   'доп-БК':U
      255               .
      256           end.
      257           assign
      258               v-count = v-count + 1
      259           .
      260           if v-count modulo 100 = 0
      261           then do:
      262               assign
      263                   p-fi :screen-value = "Обработано товаров: " + string( v-count )
      264               .
      265           end.
      266       end.
      267       output stream out-stream close.
      268   end.
      269   end procedure.
      270   procedure export-costs :
      271   do
      272   on error undo, return error
      273   :
      274       define variable v-temp-gds-count     as integer init 0          no-undo.
      275       define variable v-filled-gds-count   as integer                 no-undo.
      276       define buffer buf_trn-doc       for trn-doc.
      277       define buffer buf_doc-line      for doc-line.
      278       define buffer buf_gds-obj       for gds-obj.
      279       output stream out-stream to "goods.txt".
      280       RUN init-temphost.
      281       object-of-base:
      282       for each temp-obj
      283       :
      284           for each temp_gds-costs
      285           :
      286               delete temp_gds-costs.
      287           end.
      288           assign
      289               v-filled-gds-count  = 0
      290               v-temp-gds-count    = 0
      291           .
      292           for each buf_gds-obj
      293              where buf_gds-obj.obj-type = temp-obj.obj-type
      294                and buf_gds-obj.obj-code = temp-obj.obj-code
      295           break by buf_gds-obj.artic
      296                 by buf_gds-obj.prod-type
      297                 by buf_gds-obj.prod-code
      298           :
      299               if first-of( buf_gds-obj.prod-code )
      300               then do:
      301                   create temp_gds-costs.
      302                   assign
      303                       temp_gds-costs.artic        = buf_gds-obj.artic
      304                       temp_gds-costs.prod-type    = buf_gds-obj.prod-type
      305                       temp_gds-costs.prod-code    = buf_gds-obj.prod-code
      306                       temp_gds-costs.empty        = yes
      307                   .
      308                   assign
      309                       v-temp-gds-count    = v-temp-gds-count + 1
      310                   .
      311                   if v-temp-gds-count modulo 100 = 0
      312                   then do:
      313                       assign
      314                           p-fi :screen-value = temp-obj.obj-type + string( temp-obj.obj-code ) + ". Прочитано товаров: " + string( v-temp-gds-count )
      315                       .
      316                   end.
      317               end.
      318           end.
      319           for each buf_trn-doc no-lock
      320              where buf_trn-doc.obj-type   = temp-obj.obj-type
      321                and buf_trn-doc.obj-code   = temp-obj.obj-code
      322                and buf_trn-doc.internal   = no
      323                and buf_trn-doc.doc-type   = 'при':U
      324                and buf_trn-doc.status_    = 'факт':U
      325           by doc-date
      326           :
      327               for each buf_doc-line no-lock
      328                  where buf_doc-line.doc-code  = buf_trn-doc.doc-code
      329               :
      330                   find first temp_gds-costs
      331                        where temp_gds-costs.artic     = buf_doc-line.artic
      332                          and temp_gds-costs.prod-type = buf_doc-line.prod-type
      333                          and temp_gds-costs.prod-code = buf_doc-line.prod-code
      334                          and temp_gds-costs.empty     = yes
      335                   no-error.
      336                   if available temp_gds-costs
      337                   then do:
      338                       assign
      339                           temp_gds-costs.cost     = buf_doc-line.price-rubl
      340                           temp_gds-costs.empty    = no
      341                           v-filled-gds-count      = v-filled-gds-count + 1
      342                       .
      343                       if v-filled-gds-count modulo 100 = 0
      344                       then do:
      345                           assign
      346                               p-fi :screen-value = temp-obj.obj-type + string( temp-obj.obj-code ) + ". Заполнено товаров: " + string( v-filled-gds-count ) + " из " + string( v-temp-gds-count )
      347                           .
      348                       end.
      349                       if v-filled-gds-count   = v-temp-gds-count
      350                       then do:
      351                           assign
      352                               p-fi :screen-value = temp-obj.obj-type + string( temp-obj.obj-code ) + ". Вывод товаров: " + string( v-filled-gds-count ) + " из " + string( v-temp-gds-count )
      353                           .
      354                           run export-temp-gds-costs in this-procedure (
      355                                 input temp-obj.host-code
      356                               , input temp-obj.obj-type
      357                               , input temp-obj.obj-code
      358                           ) no-error.
      359                           if error-status :error
      360                           then do:
      361                               undo, return error "export-costs: Ошибка записи товаров с приходными ценами." + chr(10) + return-value.
      362                           end.
      363                           next object-of-base.
      364                       end.
      365                   end.
      366               end.
      367           end.
      368           assign
      369               p-fi :screen-value = temp-obj.obj-type + string( temp-obj.obj-code ) + ". Вывод товаров: " + string( v-filled-gds-count ) + " из " + string( v-temp-gds-count )
      370           .
      371           run export-temp-gds-costs in this-procedure (
      372                 input temp-obj.host-code
      373               , input temp-obj.obj-type
      374               , input temp-obj.obj-code
      375           ) no-error.
      376           if error-status :error
      377           then do:
      378               undo, return error "export-costs: Ошибка записи товаров с приходными ценами." + chr(10) + return-value.
      379           end.
      380       end.
      381       output stream out-stream close.
      382   end.
      383   end procedure.
      384   procedure export-temp-gds-costs :
      385   do
      386   on error undo, return error
      387   :
      388   define input parameter p-host-code as integer      no-undo.
      389   define input parameter p-obj-type  as character    no-undo.
      390   define input parameter p-obj-code  as integer      no-undo.
      391       for each temp_gds-costs
      392          where temp_gds-costs.empty = no
      393       :
      394           export stream out-stream delimiter ","
      395               p-host-code
      396               p-obj-type
      397               p-obj-code
      398               temp_gds-costs.artic
      399               temp_gds-costs.prod-type
      400               temp_gds-costs.prod-code
      401               temp_gds-costs.cost
      402           .
      403       end.
      404   end.
      405   end procedure.
      406   procedure export-prices :
      407   do
      408   on error undo, return error
      409   :
      410       define variable v-temp-gds-count     as integer     no-undo.
      411       define buffer buf_goods             for goods.
      412       define buffer buf_gds-prt           for gds-prt.
      413       define buffer buf_price-list        for price-list.
      414       define buffer buf_root_price-list   for price-list.
      415       output stream out-stream to "prices.txt".
      416       RUN init-temphost.
      417       object-of-base:
      418       for each temp-obj
      419       :
      420           assign
      421               v-temp-gds-count = 0
      422           .
      423           for each temp_gds-prices
      424           :
      425               delete temp_gds-prices.
      426           end.
      427           for each buf_price-list no-lock
      428              where buf_price-list.obj-type = temp-obj.obj-type
      429                and buf_price-list.obj-code = temp-obj.obj-code
      430           break by artic
      431                 by prod-type
      432                 by prod-code
      433           :
      434               if first-of( prod-code )
      435               then do:
      436                   find first buf_goods no-lock
      437                        where buf_goods.artic      = buf_price-list.artic
      438                          and buf_goods.prod-type  = buf_price-list.prod-type
      439                          and buf_goods.prod-code  = buf_price-list.prod-code
      440                   no-error .
      441                   if not available buf_goods
      442                   then do:
      443                       undo, return error "export-prices: Не удалось найти в базе данных товар для строки прайс-листа."
      444                                       + chr(10) + "Артикул товара: " + string( buf_price-list.artic )
      445                                       + chr(10) + "Производитель : " + string( buf_price-list.prod-type )
      446                                       + chr(10) + "                " + string( buf_price-list.prod-code )
      447                       .
      448                   end.
      449                   find first buf_gds-prt no-lock
      450                        where buf_gds-prt.upper-code = buf_goods.prt-root
      451                   no-error .
      452                   if not available buf_gds-prt
      453                   then do:
      454                       undo, return error "export-prices: В карточке товара неверно задан код шкалы."
      455                                       + chr(10) + "Артикул товара: " + string( buf_price-list.artic )
      456                                       + chr(10) + "Производитель : " + string( buf_price-list.prod-type )
      457                                       + chr(10) + "                " + string( buf_price-list.prod-code )
      458                       .
      459                   end.
      460                   find last buf_root_price-list no-lock
      461                       where buf_root_price-list.obj-type  = buf_price-list.obj-type
      462                         and buf_root_price-list.obj-code  = buf_price-list.obj-code
      463                         and buf_root_price-list.b-code    = buf_goods.gds-code
      464                         and buf_root_price-list.price-type = "":U
      465                   use-index fact-close
      466                   no-error.
      467                   if not available buf_root_price-list
      468                   then do:
      469                       undo, return error "export-prices: Не заданы цены для корня шкалы товара."
      470                                       + chr(10) + "Артикул товара: " + string( buf_price-list.artic )
      471                                       + chr(10) + "Производитель : " + string( buf_price-list.prod-type )
      472                                       + chr(10) + "                " + string( buf_price-list.prod-code )
      473                       .
      474                   end.
      475                   else do:
      476                       create temp_gds-prices.
      477                       assign
      478                           temp_gds-prices.artic       = buf_price-list.artic
      479                           temp_gds-prices.prod-type   = buf_price-list.prod-type
      480                           temp_gds-prices.prod-code   = buf_price-list.prod-code
      481                           temp_gds-prices.price       = buf_root_price-list.price-sale
      482                           v-temp-gds-count            = v-temp-gds-count + 1
      483                       .
      484                       if v-temp-gds-count modulo 100 = 0
      485                       then do:
      486                           assign
      487                               p-fi :screen-value = temp-obj.obj-type + string( temp-obj.obj-code ) + ". Прочитано цен: " + string( v-temp-gds-count )
      488                           .
      489                       end.
      490                   end.
      491               end.
      492           end.
      493           assign
      494               p-fi :screen-value = temp-obj.obj-type + string( temp-obj.obj-code ) + ". Вывод цен: " + string( v-temp-gds-count )
      495           .
      496           run export-temp-gds-prices in this-procedure (
      497                 input temp-obj.host-code
      498               , input temp-obj.obj-type
      499               , input temp-obj.obj-code
      500           ) no-error.
      501           if error-status :error
      502           then do:
      503               undo, return error "export-costs: Ошибка записи товаров с продажными ценами." + chr(10) + return-value.
      504           end.
      505       end.
      506       output stream out-stream close.
      507   end.
      508   end procedure.
      509   procedure export-temp-gds-prices :
      510   do
      511   on error undo, return error
      512   :
      513   define input parameter p-host-code as integer      no-undo.
      514   define input parameter p-obj-type  as character    no-undo.
      515   define input parameter p-obj-code  as integer      no-undo.
      516       for each temp_gds-prices
      517       :
      518           export stream out-stream delimiter ","
      519               p-host-code
      520               p-obj-type
      521               p-obj-code
      522               temp_gds-prices.artic
      523               temp_gds-prices.prod-type
      524               temp_gds-prices.prod-code
      525               temp_gds-prices.price
      526           .
      527       end.
      528   end.
      529   end procedure.
