      398   procedure xmlchar-test :
      399   define input parameter p-in-string          as character        no-undo.
      400   define output parameter p-out-string-enc    as character        no-undo.
      401   define output parameter p-out-string-dec    as character        no-undo.
      402   do
      403   on error undo, return error
      404   :
      405          run xmlchar-encode in this-procedure
      406       (
      407             input p-in-string
      408           , output p-out-string-enc
      409       ).
      410          run xmlchar-decode in this-procedure
      411       (
      412             input p-out-string-enc
      413           , output p-out-string-dec
      414       ).
      415   end.
      416   end .
      417   procedure xmlchar-encode :
      418   define input parameter p-in-string      as character        no-undo.
      419   define output parameter p-out-string    as character        no-undo.
      420       define variable v-position      as integer      no-undo.
      421       define variable v-current-char  as character    no-undo.
      422   do
      423   on error undo, return error
      424   :
      425       assign
      426           p-out-string = "":U
      427       .
      428       case p-in-string
      429       :
      430           when ?
      431           then do:
      432               assign
      433                   p-out-string = "?":U
      434               .
      435           end.
      436           when "?":U
      437           then do:
      438               assign
      439                   p-out-string = "&#63;":U
      440               .
      441           end.
      442           otherwise do:
      443               do v-position = 1 to length( p-in-string )
      444               :
      445                   assign
      446                       v-current-char = substring( p-in-string, v-position, 1 )
      447                   .
      448                   case v-current-char
      449                   :
      450                       when "&":U
      451                       then do:
      452                           assign
      453                               p-out-string = p-out-string + "&amp;":U
      454                           .
      455                       end.
      456                       when ">":U
      457                       then do:
      458                           assign
      459                               p-out-string = p-out-string + "&gt;":U
      460                           .
      461                       end.
      462                       when "<":U
      463                       then do:
      464                           assign
      465                               p-out-string = p-out-string + "&lt;":U
      466                           .
      467                       end.
      468                       when "'":U
      469                       then do:
      470                           assign
      471                               p-out-string = p-out-string + "&apos;":U
      472                           .
      473                       end.
      474                       when '"':U
      475                       then do:
      476                           assign
      477                               p-out-string = p-out-string + "&quot;":U
      478                           .
      479                       end.
      480                       when chr(1)
      481                       then do:
      482                           assign
      483                               p-out-string = p-out-string + "":U
      484                           .
      485                       end.
      486                       when chr(2)
      487                       then do:
      488                           assign
      489                               p-out-string = p-out-string + "":U
      490                           .
      491                       end.
      492                       when chr(3)
      493                       then do:
      494                           assign
      495                               p-out-string = p-out-string + "":U
      496                           .
      497                       end.
      498                       when chr(4)
      499                       then do:
      500                           assign
      501                               p-out-string = p-out-string + "":U
      502                           .
      503                       end.
      504                       when chr(5)
      505                       then do:
      506                           assign
      507                               p-out-string = p-out-string + "":U
      508                           .
      509                       end.
      510                       when chr(6)
      511                       then do:
      512                           assign
      513                               p-out-string = p-out-string + "":U
      514                           .
      515                       end.
      516                       when chr(7)
      517                       then do:
      518                           assign
      519                               p-out-string = p-out-string + "":U
      520                           .
      521                       end.
      522                       when chr(8)
      523                       then do:
      524                           assign
      525                               p-out-string = p-out-string + "":U
      526                           .
      527                       end.
      528                       when chr(9)
      529                       then do:
      530                           assign
      531                               p-out-string = p-out-string + "":U
      532                           .
      533                       end.
      534                       when chr(29)
      535                       then do:
      536                           assign
      537                               p-out-string = p-out-string + "":U
      538                           .
      539                       end.
      540                       when chr(10)
      541                       then do:
      542                           assign
      543                               p-out-string = p-out-string + "&#10;":U
      544                           .
      545                       end.
      546                       when chr(13)
      547                       then do:
      548                           assign
      549                               p-out-string = p-out-string + "&#13;":U
      550                           .
      551                       end.
      552                       otherwise do:
      553                           assign
      554                               p-out-string = p-out-string + v-current-char
      555                           .
      556                       end.
      557                   end case.
      558               end.
      559           end.
      560       end case.
      561   end.
      562   end .
      563   procedure xmlchar-encode-1c :
