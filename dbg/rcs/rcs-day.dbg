        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter p-xml-file-name      as character        no-undo.
        4   define input parameter p-date               as date             no-undo.
        5   define input parameter p-range              as integer          no-undo.
        6   define input parameter p-obj-list           as character        no-undo.
        7   define input parameter hedt                 as handle           no-undo.
        8   define input parameter hcnt                 as handle           no-undo.
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: rcs-day.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: rcs/rcs-day.p $":U .
       14   define variable vss-description as character no-undo init "Выгрузка свёртки по объектам по датам для внешней системы".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   define  temp-table temp-host no-undo
       77     field host-code like ub.store.host-code
       78     index xpk host-code
       79   .
       80   define  temp-table temp-obj no-undo
       81     field obj-type  like ub.clients.obj-type
       82     field obj-code  like ub.clients.obj-code
       83     field host-code like ub.store.host-code
       84     field db-num    like ub.clients.db-num
       85     index xpk  obj-type obj-code
       86     index xie1 host-code
       87     index xie2 db-num host-code
       88   .
       89   procedure init-temphost:
       90     define buffer buf_store   for ub.store .
       91     define buffer buf_shop    for ub.shop .
       92     define buffer buf_clients for ub.clients .
       93     define buffer buf_db for ub.db .
       94     define buffer buf_temp-host for temp-host .
       95     define buffer buf_temp-obj for temp-obj .
       96     do
       97     on error undo, return error return-value
       98     :
       99       for each buf_store
      100       on error undo, return error
      101       :
      102         find first buf_temp-host
      103           where buf_temp-host.host-code = buf_store.host-code
      104           no-error .
      105         if not available buf_temp-host
      106         then do:
      107           create buf_temp-host .
      108           assign
      109             buf_temp-host.host-code = buf_store.host-code
      110           .
      111         end.
      112         find first buf_clients no-lock
      113           where buf_clients.obj-type = 'скл':U
      114             and buf_clients.obj-code = buf_store.obj-code
      115           no-error .
      116         if not available buf_clients
      117         then do:
      118           message
      119             "Ошибка при поиске клиента" skip
      120             "Клиент" 'скл':U buf_store.obj-code skip
      121             view-as alert-box error .
      122           undo, return error .
      123         end.
      124         create buf_temp-obj .
      125         assign
      126           buf_temp-obj.obj-type  = 'скл':U
      127           buf_temp-obj.obj-code  = buf_store.obj-code
      128           buf_temp-obj.host-code = buf_store.host-code
      129           buf_temp-obj.db-num    = buf_clients.db-num
      130         .
      131       end.
      132       for each buf_shop
      133       on error undo, return error
      134       :
      135         find first buf_temp-host
      136           where buf_temp-host.host-code = buf_shop.host-code
      137           no-error .
      138         if not available buf_temp-host
      139         then do:
      140           create buf_temp-host .
      141           assign
      142             buf_temp-host.host-code = buf_shop.host-code
      143           .
      144         end.
      145         find first buf_clients no-lock
      146           where buf_clients.obj-type = 'маг':U
      147             and buf_clients.obj-code = buf_shop.obj-code
      148           no-error .
      149         if not available buf_clients then do:
      150           message
      151             "Ошибка при поиске клиента" skip
      152             "Клиент" 'маг':U buf_shop.obj-code skip
      153             view-as alert-box error .
      154           undo, return error .
      155         end.
      156         create buf_temp-obj .
      157         assign
      158           buf_temp-obj.obj-type  = 'маг':U
      159           buf_temp-obj.obj-code  = buf_shop.obj-code
      160           buf_temp-obj.host-code = buf_shop.host-code
      161           buf_temp-obj.db-num    = buf_clients.db-num
      162         .
      163       end.
      164     end.
      165   end.
      166   define variable vss-include-info1 as character format "X(65)" no-undo
      167   initial "@(#)$Workfile$ $Revision$".
      168   DEF STREAM stmXMLHead.
      169   DEF STREAM stmXMLBody.
