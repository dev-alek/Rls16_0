      653                               p-out-string = p-out-string + " ":U
      654                           .
      655                       end.
      656                       when chr(13)
      657                       then do:
      658                           assign
      659                               p-out-string = p-out-string + " ":U
      660                           .
      661                       end.
      662                       otherwise do:
      663                           assign
      664                               p-out-string = p-out-string + v-current-char
      665                           .
      666                       end.
      667                   end case.
      668               end.
      669           end.
      670       end case.
      671   end.
      672   end .
      673   procedure xmlchar-decode :
      674   define input parameter p-in-string      as character        no-undo.
      675   define output parameter p-out-string    as character        no-undo.
      676       define variable v-position      as integer      no-undo.
      677       define variable v-last-position as integer      no-undo.
      678       define variable v-temp-integer  as integer      no-undo.
      679       define variable v-current-char  as character    no-undo.
      680       define variable v-next-char     as character    no-undo.
      681       define variable v-success       as logical      no-undo.
      682   do
      683   on error undo, return error
      684   :
      685       assign
      686           p-out-string = "":U
      687           v-position   = 0
      688       .
      689       replace-cycle:
      690       do while yes
      691       on error undo, return error
      692       :
      693           assign
      694               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      695           .
      696           if v-last-position <= v-position
      697           then do:
      698               if v-position = 0
      699               then do:
      700                   assign
      701                       p-out-string = p-in-string
      702                   .
      703               end.
      704               else do:
      705                   assign
      706                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      707                   .
      708               end.
      709               leave replace-cycle.
      710           end.
      711           else do:
      712               assign
      713                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      714                   v-position      = v-last-position
      715                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      716               .
      717               if v-current-char = "#":U
      718               then do:
      719                   assign
      720                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      721                   .
      722                   if v-last-position > 0
      723                   then do:
      724                       run xmlchar-read-integer in this-procedure
      725                        (
      726                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      727                           , output v-temp-integer
      728                           , output v-success
      729                       ).
      730                       if v-success = yes
      731                       and v-temp-integer >= 1
      732                       and v-temp-integer <= 255
      733                       then do:
      734                           assign
      735                               p-out-string = p-out-string + chr( v-temp-integer )
      736                               v-position   = v-last-position + 1
      737                           .
      738                       end.
      739                       else do:
      740                           assign
      741                               p-out-string = p-out-string + "&":U
      742                               v-position   = v-position   + 1
      743                           .
      744                       end.
      745                   end.
      746                   else do:
      747                       assign
      748                           p-out-string = p-out-string + "&":U
      749                           v-position   = v-position   + 1
      750                       .
      751                   end.
      752               end.
      753               else do:
      754                   case substring( p-in-string, v-position + 1, 3 )
      755                   :
      756                       when "lt;":U
      757                       then do:
      758                           assign
      759                               p-out-string = p-out-string + "<":U
      760                               v-position   = v-position   + 3
      761                           .
      762                       end.
      763                       when "gt;":U
      764                       then do:
      765                           assign
      766                               p-out-string = p-out-string + ">":U
      767                               v-position   = v-position   + 3
      768                           .
      769                       end.
      770                       otherwise do:
      771                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      772                           then do:
      773                               assign
      774                                   p-out-string = p-out-string + "&":U
      775                                   v-position   = v-position   + 4
      776                               .
      777                           end.
      778                           else do:
      779                               case substring( p-in-string, v-position + 1, 5 )
      780                               :
      781                                   when "quot;":U
      782                                   then do:
      783                                       assign
      784                                           p-out-string = p-out-string + '"':U
      785                                           v-position   = v-position   + 5
      786                                       .
      787                                   end.
      788                                   when "apos;":U
      789                                   then do:
      790                                       assign
      791                                           p-out-string = p-out-string + "'":U
      792                                           v-position   = v-position   + 5
      793                                       .
      794                                   end.
      795                                   otherwise do:
      796                                       assign
      797                                           p-out-string = p-out-string + "&":U
      798                                       .
      799                                   end.
      800                               end case.
      801                           end.
      802                       end.
      803                   end case.
      804               end.
      805           end.
      806       end.
      807   end.
      808   end .
      809   procedure xmlchar-read-integer :
      810   define input parameter p-input-string      as character        no-undo.
      811   define output parameter p-output-integer   as integer          no-undo.
      812   define output parameter p-success       as logical          no-undo.
      813   do
      814   on error undo, return error
      815   :
      816       assign
      817           p-output-integer = integer( p-input-string )
      818       no-error.
      819       if error-status :error
      820       then do:
      821           assign
      822               p-success           = no
      823               p-output-integer    = 0
      824           .
      825       end.
      826       else do:
      827           assign
      828               p-success           = yes
      829           .
      830       end.
      831   end.
      832   end.
      833   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
      834                                             INPUT iFlagEmpty AS INTEGER).
      835     DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
      836     IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
      837       DO:
      838         IF iFlagEmpty = 0 THEN RETURN "".
      839         ELSE IF iFlagEmpty = 1                    THEN RETURN sParName + "=&#034;&#034;".
      840         ELSE IF iFlagEmpty = 2 AND sToPlace = "0" THEN RETURN sParName + "=&#034;0&#034;".
      841         ELSE IF iFlagEmpty = 3 AND sToPlace = ""  THEN RETURN sParName + "=&#034;&#034;".
      842         ELSE RETURN "".
      843       END.
      844     ELSE DO:
      845           run xmlchar-encode in this-procedure (
      846                 input sToPlace
      847               , output sToPlace
      848           ).
      849           ASSIGN
      850               sToPlace = sParName + '="' + sToPlace + '"'
      851           .
      852        RETURN sToPlace.
      853     END.
      854   END FUNCTION.
      855   PROCEDURE wp-XMLTagOpen:
      856     DEF INPUT PARAM iStmNum   AS INTEGER NO-UNDO.
      857     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
      858     DEF INPUT PARAM sTagName  AS CHAR NO-UNDO.
      859     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
      860       run xmlchar-encode in this-procedure (
      861             input sParValue
      862           , output sParValue
      863       ).
      864      if istmnum = 1
      865      then do:
      866           PUT STREAM stmXMLHead UNFORMATTED chr(10) + FILL(" ", 4 * iTagLevel) +
      867                           "<" + sTagName + (IF sParValue = "" OR sParValue = ? then "" ELSE " ") +
      868                           sParValue + ">".
      869      end.
      870      else do:
      871           PUT STREAM stmXMLBody UNFORMATTED chr(10) + FILL(" ", 4 * iTagLevel) +
      872                           "<" + sTagName + (IF sParValue = "" OR sParValue = ? then "" ELSE " ") +
      873                           sParValue + ">".
      874      end.
      875   END PROCEDURE.
      876   PROCEDURE wp-XMLTagPut:
      877     DEF INPUT PARAM iStmNum   AS INTEGER NO-UNDO.
      878     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
      879     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
      880     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
      881     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
      882      if istmnum = 1
      883      then do:
      884           IF  iFlagEmpty = 1
      885           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
      886           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
      887           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
      888           THEN DO:
      889               run xmlchar-encode in this-procedure (
      890                     input sParValue
      891                   , output sParValue
      892               ).
      893               PUT STREAM stmXMLHead UNFORMATTED chr(10) + FILL(" ", 4 * iTagLevel) +
      894                                   '<' + sTagName + '>' + sParValue + '</' + sTagName + '>'.
      895           END.
      896      end.
      897      else do:
      898           IF  iFlagEmpty = 1
      899           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
      900           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
      901           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
      902           THEN DO:
      903               run xmlchar-encode in this-procedure (
      904                     input sParValue
      905                   , output sParValue
      906               ).
      907               PUT STREAM stmXMLBody UNFORMATTED chr(10) + FILL(" ", 4 * iTagLevel) +
      908                                   '<' + sTagName + '>' + sParValue + '</' + sTagName + '>'.
      909           END.
      910      end.
      911   END PROCEDURE.
      912   PROCEDURE wp-XMLTagClose:
      913     DEF INPUT PARAM iStmNum   AS INTEGER NO-UNDO.
      914     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
      915     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
      916      if istmnum = 1
      917      then do:
      918           PUT STREAM stmXMLHead UNFORMATTED  chr(10) + FILL(" ", 4 * iTagLevel) + '</' + sTagName + '>'.
      919      end.
      920      else do:
      921           PUT STREAM stmXMLBody UNFORMATTED chr(10) + FILL(" ", 4 * iTagLevel) + '</' + sTagName + '>'.
      922      end.
      923   END PROCEDURE.
      924   PROCEDURE wp-XMLWriteLog:
      925     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
      926     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
      927     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
      928   OUTPUT STREAM stmXMLLog TO VALUE(sFileName) APPEND.
      929       PUT STREAM stmXMLLog UNFORMATTED chr(10).
      930       PUT STREAM stmXMLLog UNFORMATTED (IF (iLogLevel = 0 OR sToWrite = "&DLine"
      931                                         OR sToWrite = "&Line") THEN "" ELSE
      932                                         cur-time-string-sec() + " ").
      933       PUT STREAM stmXMLLog UNFORMATTED
      934               (IF sToWrite = "&Line" THEN FILL("-", 80)
      935                ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
      936                ELSE sToWrite).
      937   OUTPUT STREAM stmXMLLog CLOSE.
      938   END PROCEDURE.
      939   PROCEDURE wp-XMLWriteEDT:
      940     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
      941     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
      942     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
      943       if valid-handle ( hEDT )
      944       then do:
      945           hEDT :move-to-eof().
      946           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
      947                                           OR sToWrite = "&Line") THEN "" ELSE
      948                                           cur-time-string-sec() + " ").
      949           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
      950                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
      951                   ELSE FILL(" ", iLogLevel) + sToWrite).
      952           hEDT :insert-string(chr(10)).
      953       end.
      954   END PROCEDURE.
      955   PROCEDURE wp-XMLShowCNT:
      956     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
      957       if valid-handle( hCNT )
      958       then do:
      959           ASSIGN hCNT :VISIBLE = TRUE.
      960       end.
      961   END PROCEDURE.
      962   PROCEDURE wp-XMLHideCNT:
      963     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
      964       if valid-handle( hCNT )
      965       then do:
      966           ASSIGN hCNT :VISIBLE = FALSE.
      967       end.
      968   END PROCEDURE.
      969   PROCEDURE wp-XMLWriteCNT:
      970     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
      971     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
      972       if valid-handle( hCNT )
      973       then do:
      974           ASSIGN hCNT :SCREEN-VALUE = sCounter.
      975       end.
      976   END PROCEDURE.
      977   procedure rcs-xml-write-header:
      978   do
      979   on error undo, return error
      980   :
      981   define input parameter p-num-tables         as integer      no-undo.
      982   define input parameter p-xml-file-name-head as character    no-undo.
      983   define input parameter p-table-id-head      as character    no-undo.
      984   define input parameter p-xml-file-name-body as character    no-undo.
      985   define input parameter p-table-id-body      as character    no-undo.
      986       define variable v-reportnumber          as integer      no-undo.
      987       run get-next-reportnumber in this-procedure (
      988           output v-reportnumber
      989       ) no-error.
      990       if error-status :error
      991       then do:
      992           assign
      993               v-reportnumber = 0
      994           .
      995       end.
      996       output stream stmXMLHead to value( p-xml-file-name-head + ".xm1" ) convert target "1251".
      997           put stream stmXMLHead unformatted "<DESTINATION_ROID " + p-table-id-head + ">".
      998           run wp-xmltagopen( 1, 0, "mail Parameters","").
      999           run wp-xmltagput( 1, 1, "X-ReportType",    string( 1 ), 0).
     1000           run wp-xmltagput( 1, 1, "X-IDChannel",     string( 3 ), 0).
     1001           run wp-xmltagput( 1, 1, "X-ReportNumber",  string( v-reportnumber ), 0).
     1002           run wp-xmltagclose( 1, 0, "mail Parameters").
     1003           put stream stmXMLHead unformatted skip "<ROWSET>".
     1004       output stream stmXMLHead close.
     1005       if p-num-tables > 1
     1006       then do:
     1007           output stream stmXMLBody to value( p-xml-file-name-body + ".xm1" ) convert target "1251".
     1008               put stream stmXMLBody unformatted "<DESTINATION_ROID " + p-table-id-body + ">".
     1009               run wp-xmltagopen( 2, 0, "mail Parameters","").
     1010               run wp-xmltagput( 2, 1, "X-ReportType",    string( 1 ), 0).
     1011               run wp-xmltagput( 2, 1, "X-IDChannel",     string( 3 ), 0).
     1012               run wp-xmltagput( 2, 1, "X-ReportNumber",  string( v-reportnumber ), 0).
     1013               run wp-xmltagclose( 2, 0, "mail Parameters").
     1014               put stream stmXMLBody unformatted skip "<ROWSET>".
     1015           output stream stmXMLBody close.
     1016       end.
     1017   end.
     1018   end procedure.
     1019   procedure rcs-xml-write-footer:
     1020   do
     1021   on error undo, return error
     1022   :
     1023   define input parameter p-num-tables         as integer      no-undo.
     1024   define input parameter p-xml-head-file-name as character    no-undo.
     1025   define input parameter p-xml-body-file-name as character    no-undo.
     1026       define variable v-error-num     as integer           no-undo.
     1027       output stream stmXMLHead to value( p-xml-head-file-name + ".xm1" ) convert target "1251" append.
     1028          put stream stmXMLHead unformatted skip "</ROWSET>" chr(10).
     1029       output stream stmXMLHead close.
     1030       if p-num-tables > 1
     1031       then do:
     1032           output stream stmXMLBody to value( p-xml-body-file-name + ".xm1" ) convert target "1251" append.
     1033               put stream stmXMLBody unformatted skip "</ROWSET>" chr(10).
     1034           output stream stmXMLBody close.
     1035       end.
     1036   end.
     1037   end procedure.
     1038   function format-decimal returns character ( input p-decimal as decimal ).
     1039       if p-decimal = ?
     1040       then do:
     1041           return "?".
     1042       end.
     1043       else do:
     1044           if abs( p-decimal ) < 1
     1045           then do:
     1046               return right-trim( string( p-decimal, "-9.9999999999" ), "0" ).
     1047           end.
     1048           else do:
     1049               return string( p-decimal ).
     1050           end.
     1051       end.
     1052   end function.
     1053   procedure get-next-reportnumber :
     1054   do
     1055   on error undo, return error
     1056   :
     1057   define output parameter p-reportnumber as integer      no-undo.
     1058       define buffer buf_usr-flt       for ubflt.usr-flt.
     1059       find first buf_usr-flt exclusive-lock
     1060            where buf_usr-flt.user-name  = 'все':U
     1061              and buf_usr-flt.call-point = 'тек':U
     1062       no-error .
     1063       if not available buf_usr-flt
     1064       then do:
     1065           create buf_usr-flt.
     1066           assign
     1067               buf_usr-flt.user-name    = 'все':U
     1068               buf_usr-flt.call-point   = 'тек':U
     1069               buf_usr-flt.Naim = "1"
     1070           .
     1071       end.
     1072       assign
     1073           p-reportnumber   = integer( buf_usr-flt.Naim )
     1074           buf_usr-flt.Naim = string( p-reportnumber + 1 )
     1075       .
     1076   end.
     1077   end procedure.
     1078   define variable vss-include-info4 as character format "X(65)" no-undo
     1079   initial "@(#)$Workfile$ $Revision$".
     1080   procedure get-shops-type-and-code :
     1081   do
     1082   on error undo, return error
     1083   :
     1084   define input parameter p-shops-id           as character    no-undo.
     1085   define output parameter p-shops-obj-type    as character    no-undo.
     1086   define output parameter p-shops-obj-code    as integer      no-undo.
     1087       define buffer buf_rcs-shops     for rcs-shops.
     1088       find first buf_rcs-shops no-lock
     1089            where buf_rcs-shops.id = p-shops-id
     1090       no-error.
     1091       if not available buf_rcs-shops
     1092       then do:
     1093           undo, return error "get-shops-id: Не найден объект."
     1094                   + chr(10) + "ID объекта: " + p-shops-id
     1095           .
     1096       end.
     1097       else do:
     1098           assign
     1099               p-shops-obj-type    = buf_rcs-shops.obj-type
     1100               p-shops-obj-code    = buf_rcs-shops.obj-code
     1101           .
     1102       end.
     1103   end.
     1104   end procedure.
     1105   procedure get-destination-id :
     1106   do
     1107   on error undo, return error
     1108   :
     1109   define input parameter p-destination-name   as character    no-undo.
     1110   define output parameter p-destination-id    as character    no-undo.
     1111       define buffer buf_rcs-destn     for rcs-destn.
     1112       find first buf_rcs-destn no-lock
     1113            where buf_rcs-destn.name = p-destination-name
     1114       no-error.
     1115       if not available buf_rcs-destn
     1116       then do:
     1117           assign
     1118               p-destination-id = ""
     1119           .
     1120       end.
     1121       else do:
     1122           assign
     1123               p-destination-id = buf_rcs-destn.destination_rowid
     1124           .
     1125       end.
     1126   end.
     1127   end procedure.
     1128   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1129     define variable v-cntxt-db-num        as integer   no-undo .
     1130     define variable v-cntxt-userid        as character no-undo .
     1131     define variable v-cntxt-level         as character no-undo .
     1132     define variable v-cntxt-host-code-obj as integer   no-undo .
     1133     define variable v-cntxt-obj-type      as character no-undo .
     1134     define variable v-cntxt-obj-code      as integer   no-undo .
     1135     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1136     define variable v-cntxt-is-admin      as logical   no-undo .
     1137   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1138       define temp-table temp_good no-undo
     1139           field id                    as character
     1140           field gds-code              like goods.gds-code
     1141           field artic                 like goods.artic
     1142           field prod-type             like goods.prod-type
     1143           field prod-code             like goods.prod-code
     1144           field gds-name              like goods.gds-name
     1145           field qnty-first            like stk-line.fact-qnty
     1146           field qnty-last             like stk-line.fact-qnty
     1147           index pi is primary unique gds-code
     1148       .
