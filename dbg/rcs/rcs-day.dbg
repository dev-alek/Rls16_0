     1152           field first-base            like stk-line.sum-base
     1153           field last-rubl             like stk-line.sum-rubl
     1154           field last-base             like stk-line.sum-base
     1155           field write-result          as logical
     1156           index pi is primary unique tag-name
     1157       .
     1158       define temp-table temp_turn-over no-undo
     1159           field ext-doc-type          like ot-tot.ext-doc-type
     1160           field qnty                  like ot-tot.fact-qnty
     1161           field sum-rubl              like ot-tot.sum-rubl
     1162           field sum-rubl-cost         like ot-tot.sum-rubl
     1163           field sum-base              like ot-tot.sum-base
     1164           field sum-base-cost         like ot-tot.sum-base
     1165           field write-result          as logical
     1166           index pi is primary unique ext-doc-type
     1167       .
     1168       define variable sHomeDir            as character            no-undo.
     1169       define variable sOutFile            as character            no-undo.
     1170       define variable sLogFile            as character            no-undo.
     1171       define variable bLocked             as logical    init no   no-undo.
     1172       define variable iRep                as integer    init 0    no-undo.
     1173       define variable ErrorLevel          as integer              no-undo.
     1174       define variable v-counter           as integer           no-undo.
     1175       define variable v-obj-counter       as integer           no-undo.
     1176       define variable v-log-file-name     as character         no-undo.
     1177       define variable v-fact-order-from   like stk-tot.fact-order no-undo.
     1178       define variable v-fact-order-to     like stk-tot.fact-order no-undo.
     1179       define variable v-docs-exists       as logical              no-undo.
     1180       define variable v-object-state      as character            no-undo.
     1181       define variable v-rcs-object-id     as character         no-undo.
     1182       define variable v-log-string        as character         no-undo.
     1183       define variable v-write-good        as logical           no-undo.
     1184       define variable v-destination-rowid as character         no-undo.
     1185       define variable v-today             as date         no-undo.
     1186       define variable v-time              as integer      no-undo.
     1187       define variable v-archive-ok        as logical      no-undo.
     1188       define variable v-comment           as character    no-undo.
     1189       define buffer buf_rcs-shops     for rcs-shops.
     1190   do
     1191   for buf_rcs-shops
     1192   on error undo, return error
     1193   :
     1194       run cur-time in this-procedure (
     1195             output v-today
     1196           , output v-time
     1197       ).
     1198   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1199     run mainmenu_getcntxt in p-mainmenu-handle
     1200       (output v-cntxt-db-num
     1201       ,output v-cntxt-userid
     1202       ,output v-cntxt-level
     1203       ,output v-cntxt-host-code-obj
     1204       ,output v-cntxt-obj-type
     1205       ,output v-cntxt-obj-code
     1206       ,output v-cntxt-db-num-obj
     1207       ,output v-cntxt-is-admin
     1208       ) .
     1209       RUN init-temphost.
     1210       assign
     1211           v-log-string = ", по всем фирмам"
     1212       .
     1213       case p-range:
     1214       when 2
     1215       then do:
     1216           for each temp-obj
     1217           where temp-obj.host-code <> v-cntxt-host-code-obj
     1218           :
     1219               delete temp-obj.
     1220           end.
     1221           assign
     1222               v-log-string = ", по фирме (код фирмы " + string( v-cntxt-host-code-obj ) + ")"
     1223           .
     1224       end.
     1225       when 3
     1226       then do:
     1227           for each temp-obj
     1228           :
     1229               delete temp-obj.
     1230           end.
     1231           do v-obj-counter = 1 to num-entries ( p-obj-list ) / 2
     1232           :
     1233               create temp-obj.
     1234               assign
     1235                   temp-obj.obj-type = entry( v-obj-counter * 2 - 1, p-obj-list )
     1236                   temp-obj.obj-code = integer( entry( v-obj-counter * 2, p-obj-list ) )
     1237               no-error .
     1238               if error-status :error
     1239               then do:
     1240                   message
     1241                   vss-workfile vss-revision vss-description
     1242                   skip "Ошибка чтения списка объектов"
     1243                   skip return-value
     1244                   skip trim(error-status :get-message(1))
     1245                       trim(error-status :get-message(2))
     1246                       trim(error-status :get-message(3))
     1247                       trim(error-status :get-message(4))
     1248                       trim(error-status :get-message(5))
     1249                   view-as alert-box error.
     1250                   undo, return error .
     1251               end.
     1252   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1253   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1254     (input  temp-obj.obj-type
     1255     ,input  temp-obj.obj-code
     1256     ,output temp-obj.host-code
     1257     ) no-error .
     1258               if error-status :error
     1259               then do:
     1260                   message
     1261                   vss-workfile vss-revision vss-description
     1262                   skip "Не найдена фирма для объекта" temp-obj.obj-type temp-obj.obj-code
     1263                   skip return-value
     1264                   skip trim(error-status :get-message(1))
     1265                       trim(error-status :get-message(2))
     1266                       trim(error-status :get-message(3))
     1267                       trim(error-status :get-message(4))
     1268                       trim(error-status :get-message(5))
     1269                   view-as alert-box error.
     1270                   undo, return error .
     1271               end.
     1272           end.
     1273           assign
     1274               v-log-string = ", по объектам: " + p-obj-list
     1275           .
     1276       end.
     1277       end case.
     1278       ASSIGN v-log-file-name = p-xml-file-name + ".log".
     1279       run get-destination-id in this-procedure (
     1280             input "RETAIL1_CONVOLUTION"
     1281           , output v-destination-rowid
     1282       ) no-error.
     1283       if error-status :error
     1284       or v-destination-rowid = ""
     1285       then do:
     1286           message
     1287             vss-workfile vss-revision vss-description
     1288             skip "Не удалось получить DESTINATION-ROWID для RETAIL1_CONVOLUTION."
     1289             skip return-value
     1290             skip trim(error-status :get-message(1))
     1291                  trim(error-status :get-message(2))
     1292                  trim(error-status :get-message(3))
     1293                  trim(error-status :get-message(4))
     1294                  trim(error-status :get-message(5))
     1295           view-as alert-box error.
     1296           undo, return error .
     1297       end.
     1298       run rcs-xml-write-header in this-procedure (
     1299                 input 1
     1300               , input p-xml-file-name
     1301               , input v-destination-rowid
     1302               , input ""
     1303               , input ""
     1304       ) no-error .
     1305       if error-status :error
     1306       then do:
     1307           undo, return error "rcs-docs: Ошибка записи заголовка файла." + chr(10) + return-value.
     1308       end.
     1309   object-of-list:
     1310   for each temp-obj
     1311   :
     1312       for each temp_good
     1313       :
     1314           delete temp_good.
     1315       end.
     1316       find first buf_rcs-shops no-lock
     1317            where buf_rcs-shops.obj-type = temp-obj.obj-type
     1318              and buf_rcs-shops.obj-code = temp-obj.obj-code
     1319       no-error.
     1320       if not available buf_rcs-shops
     1321       then do:
     1322           message
     1323               "В настройках не определено соответствие объекта " temp-obj.obj-type temp-obj.obj-code
     1324               skip "объекту RCS. Сведения о товарах по этому объекту не могут быть экспортированы."
     1325           view-as alert-box information.
     1326           next object-of-list.
     1327       end.
     1328       run wp-XMLWriteEDT( hEDT, 1, string(temp-obj.obj-type) + " " + string(temp-obj.obj-code) ).
     1329       run wp-XMLWriteEDT( hEDT, 4,  "Расчет архивов").
     1330       process events.
     1331       run bge/bge-ahz.p (
     1332             input p-mainmenu-handle
     1333           , input temp-obj.obj-type
     1334           , input temp-obj.obj-code
     1335           , input yes
     1336           , input no
     1337           , input no
     1338           , input v-today
     1339           , input v-today
     1340           , output v-archive-ok
     1341           , output v-comment
     1342       ) no-error.
     1343       if error-status :error
     1344       then do:
     1345           message
     1346           vss-workfile vss-revision vss-description
     1347           skip "Ошибка проверки архивов на объекте."
     1348           skip "Тип объекта:" temp-obj.obj-type
     1349           skip "Код объекта:" temp-obj.obj-code
     1350           skip return-value
     1351           skip trim(error-status :get-message(1))
     1352               trim(error-status :get-message(2))
     1353               trim(error-status :get-message(3))
     1354           view-as alert-box error.
     1355           undo, return error .
     1356       end.
     1357       run wp-XMLWriteEDT( hEDT, 4,  "Расчет архивов завершен. Идет выгрузка данных по объекту").
     1358       process events.
     1359       run rep/get-fo.p (
     1360                     input  temp-obj.obj-type
     1361                   , input  temp-obj.obj-code
     1362                   , input  p-date
     1363                   , input  p-date
     1364                   , output v-fact-order-from
     1365                   , output v-fact-order-to
     1366                   , output v-docs-exists
     1367                   ).
     1368       if v-docs-exists = no
     1369       then do:
     1370           run wp-XMLWriteEDT( hEDT, 4, "Нет закрытых документов за дату " + string( p-date ) ).
     1371           process events.
     1372           next object-of-list .
     1373       end.
     1374       run wp-XMLShowCNT(hCNT).
     1375       run calc-conv in this-procedure (
     1376                         input buf_rcs-shops.id
     1377                       , input temp-obj.obj-type
     1378                       , input temp-obj.obj-code
     1379                       , input p-date
     1380                       , input v-fact-order-from
     1381                       , input v-fact-order-to
     1382                       , input p-xml-file-name
     1383                       , input v-log-file-name
     1384                       , input hEDT
     1385                       , input hCNT
     1386                                       ) no-error.
     1387       if error-status :error
     1388       then do:
     1389           message
     1390               "Ошибка при выгрузке данных свертки."
     1391           view-as alert-box.
     1392           run wp-XMLWriteEDT( hEDT, 1, string( return-value ) ).
     1393           process events.
     1394       end.
     1395       run wp-XMLHideCNT(hCNT).
     1396       process events.
     1397   end.
     1398       run rcs-xml-write-footer in this-procedure (
     1399                 input 1
     1400               , input p-xml-file-name
     1401               , input ""
     1402       ) no-error .
     1403       if error-status :error
     1404       then do:
     1405           undo, return error "rcs-docs: Ошибка окончания записи файла." + chr(10) + return-value.
     1406       end.
     1407   end.
     1408   procedure calc-conv :
     1409       define buffer buf_gds-obj       for gds-obj.
     1410   do
     1411   for buf_gds-obj
     1412   on error undo, return error
     1413   :
     1414   define input parameter p-object-id          as character    no-undo.
     1415   define input parameter p-obj-type           as character    no-undo.
     1416   define input parameter p-obj-code           as integer      no-undo.
     1417   define input parameter p-date               as date         no-undo.
     1418   define input parameter p-fact-order-from    as integer      no-undo.
     1419   define input parameter p-fact-order-to      as integer      no-undo.
     1420   define input parameter p-xml-file-name      as character    no-undo.
     1421   define input parameter p-log-file-name      as character    no-undo.
     1422   define input parameter p-ed                 as handle       no-undo.
     1423   define input parameter p-fi                 as handle       no-undo.
     1424   define variable v-good-counter  as integer        no-undo.
     1425   define variable v-qnty          as integer        no-undo.
     1426   define variable v-current-price as decimal        no-undo.
     1427   define buffer buf_goods                 for goods.
     1428   define buffer buf_rcs-retail1product    for rcs-retail1product.
     1429   output stream stmXMLHead to value( p-xml-file-name + ".xm1") convert target "1251" append.
     1430   create temp_good.
     1431   good-on-object:
     1432   for each buf_gds-obj no-lock
     1433      where buf_gds-obj.obj-type   = p-obj-type
     1434        and buf_gds-obj.obj-code   = p-obj-code
     1435   :
     1436       if buf_gds-obj.first-doc > p-date
     1437           or ( buf_gds-obj.last-doc < p-date
     1438               and buf_gds-obj.fact-qnty = 0
     1439               and buf_gds-obj.avrg-qnty = 0
     1440              )
     1441       then do:
     1442           next good-on-object.
     1443       end.
     1444       find first buf_goods no-lock
     1445            where buf_goods.artic      = buf_gds-obj.artic
     1446              and buf_goods.prod-type  = buf_gds-obj.prod-type
     1447              and buf_goods.prod-code  = buf_gds-obj.prod-code
     1448       no-error .
     1449       if not available buf_goods
     1450       then do:
     1451           undo, return error "calc-conv: Не найдена карточка товара. "
     1452               + chr(10) + "Артикул:       " + buf_gds-obj.artic
     1453               + chr(10) + "Производитель: " + buf_gds-obj.prod-type + " " + string( buf_gds-obj.prod-code )
     1454           .
     1455       end.
     1456       else do:
     1457           assign
     1458               temp_good.gds-code              = buf_goods.gds-code
     1459           .
     1460           find first buf_rcs-retail1product no-lock
     1461                where buf_rcs-retail1product.gds-code = buf_goods.gds-code
     1462           no-error .
     1463           if not available buf_rcs-retail1product
     1464           then do:
     1465               run wp-XMLWriteEDT( hEDT, 1, "Не найден PRODUCT для товара с кодом " + string( buf_goods.gds-code )  ).
     1466               assign
     1467                   temp_good.id = "0"
     1468               .
     1469           end.
     1470           else do:
     1471               assign
     1472                   temp_good.id = buf_rcs-retail1product.id
     1473               .
     1474           end.
     1475       end.
     1476       assign
     1477           temp_good.artic                 = buf_gds-obj.artic
     1478           temp_good.prod-type             = buf_gds-obj.prod-type
     1479           temp_good.prod-code             = buf_gds-obj.prod-code
     1480           temp_good.gds-name              = ""
     1481           temp_good.qnty-first            = 0
     1482           temp_good.qnty-last             = 0
     1483           v-write-good                    = no
     1484       .
     1485       run form-turn-over in this-procedure ( input rowid( buf_gds-obj ), input 'es':U ).
     1486       run form-turn-over in this-procedure ( input rowid( buf_gds-obj ), input 'rs':U ).
     1487       run form-stk in this-procedure ( input rowid( buf_gds-obj ), input 'cost':U, input "cost", output temp_good.qnty-first, output temp_good.qnty-last ).
     1488       run form-stk in this-procedure ( input rowid( buf_gds-obj ), input 'crsa':U, input "sale", output v-qnty, output v-qnty ).
     1489       if v-write-good = yes
     1490       then do:
     1491           run get-current-price in this-procedure (
     1492                 input p-obj-type
     1493               , input p-obj-code
     1494               , input temp_good.artic
     1495               , input temp_good.prod-type
     1496               , input temp_good.prod-code
     1497               , output v-current-price
     1498           ) no-error .
     1499           if error-status :error
     1500           then do:
     1501               undo, return error "calc-conv: Не удалось вычислить текущую продажную цену для товара на объекте."
     1502                                   + chr(10) + "Артикул товара:    " + temp_good.artic
     1503                                   + chr(10) + "Наименование товара: " + temp_good.gds-name
     1504                                   + return-value.
     1505           end.
     1506           run process-result in this-procedure (
     1507                 input p-object-id
     1508               , input string( v-current-price )
     1509               , input string( year( p-date ) ) + string( month( p-date ), "99" ) + string( day( p-date ), "99" ) + string( "000000" )
     1510               , input buf_gds-obj.obj-type
     1511               , input buf_gds-obj.obj-code
     1512           ).
     1513       end.
     1514   end.
     1515   output stream stmXMLHead close.
     1516   end.
     1517   end procedure.
     1518   procedure form-turn-over :
     1519   define input parameter p-gds-obj-rowid  as rowid            no-undo.
     1520   define input parameter p-ext-doc-type   like ot-tot.ext-doc-type    no-undo.
     1521       define buffer buf_gds-obj       for gds-obj.
     1522       define buffer buf_sale_stk-line      for stk-line.
     1523       define buffer buf_cost_stk-line      for stk-line.
     1524   do
     1525   for buf_gds-obj
     1526     , buf_sale_stk-line
     1527     , buf_cost_stk-line
     1528   on error undo, return error
     1529   :
     1530   find first buf_gds-obj no-lock
     1531        where rowid( buf_gds-obj ) = p-gds-obj-rowid
     1532   .
     1533   find first temp_turn-over
     1534        where temp_turn-over.ext-doc-type  = p-ext-doc-type
     1535   no-error.
     1536   if not available temp_turn-over
     1537   then do:
     1538       create temp_turn-over.
     1539       assign
     1540           temp_turn-over.ext-doc-type = p-ext-doc-type
     1541       .
     1542   end.
     1543   assign
     1544       temp_turn-over.qnty             = 0
     1545       temp_turn-over.sum-rubl         = 0
     1546       temp_turn-over.sum-rubl-cost    = 0
     1547       temp_turn-over.sum-base         = 0
     1548       temp_turn-over.sum-base-cost    = 0
     1549   .
     1550   run fill-turn-over in this-procedure (
     1551           input buf_gds-obj.obj-type
     1552         , input buf_gds-obj.obj-code
     1553         , input buf_gds-obj.artic
     1554         , input buf_gds-obj.prod-type
     1555         , input buf_gds-obj.prod-code
     1556         , input 'sadt':U + p-ext-doc-type
     1557         , input v-fact-order-from
     1558         , input v-fact-order-to
     1559         , input yes
     1560   ) no-error.
     1561   if error-status :error
     1562   then do:
     1563       undo, return error "Ошибка вычисления оборотов по товару." + chr(10) + return-value.
     1564   end.
     1565   run fill-turn-over in this-procedure (
     1566           input buf_gds-obj.obj-type
     1567         , input buf_gds-obj.obj-code
     1568         , input buf_gds-obj.artic
     1569         , input buf_gds-obj.prod-type
     1570         , input buf_gds-obj.prod-code
     1571         , input 'csdt':U + p-ext-doc-type
     1572         , input v-fact-order-from
     1573         , input v-fact-order-to
     1574         , input no
     1575   ) no-error.
     1576   if error-status :error
     1577   then do:
     1578       undo, return error "Ошибка вычисления оборотов по товару." + chr(10) + return-value.
     1579   end.
     1580   if   temp_turn-over.qnty     = 0
     1581    and temp_turn-over.sum-rubl = 0
     1582    and temp_turn-over.sum-base = 0
     1583   then do:
     1584       assign
     1585           temp_turn-over.write-result = no
     1586       .
     1587   end.
     1588   else do:
     1589       assign
     1590           temp_turn-over.write-result = yes
     1591           v-write-good                = yes
     1592       .
     1593   end.
     1594   end.
     1595   end procedure.
     1596   procedure fill-turn-over :
     1597   do
     1598   on error undo, return error
     1599   :
     1600   define input parameter p-obj-type           as character    no-undo.
     1601   define input parameter p-obj-code           as integer      no-undo.
     1602   define input parameter p-artic              as character    no-undo.
     1603   define input parameter p-prod-type          as character    no-undo.
     1604   define input parameter p-prod-code          as integer      no-undo.
     1605   define input parameter p-sum-type           as character    no-undo.
     1606   define input parameter p-fact-order-from    as integer      no-undo.
     1607   define input parameter p-fact-order-to      as integer      no-undo.
     1608   define input parameter p-calc-qnty          as logical      no-undo.
     1609       define buffer buf_stk-line      for stk-line.
     1610       find last buf_stk-line no-lock
     1611           where buf_stk-line.obj-type   = p-obj-type
     1612             and buf_stk-line.obj-code   = p-obj-code
     1613             and buf_stk-line.artic      = p-artic
     1614             and buf_stk-line.prod-type  = p-prod-type
     1615             and buf_stk-line.prod-code  = p-prod-code
     1616             and buf_stk-line.sum-type   = p-sum-type
     1617             and buf_stk-line.cat-id     = '##,##':U
     1618             and buf_stk-line.fact-order <= p-fact-order-to
     1619       use-index category
     1620       no-error.
     1621       if available buf_stk-line
     1622       then do:
     1623           if p-calc-qnty = yes
     1624           then do:
     1625               assign
     1626                   temp_turn-over.qnty         = temp_turn-over.qnty     + buf_stk-line.fact-qnty
     1627                   temp_turn-over.sum-rubl     = temp_turn-over.sum-rubl + buf_stk-line.sum-rubl
     1628                   temp_turn-over.sum-base     = temp_turn-over.sum-base + buf_stk-line.sum-base
     1629               .
     1630           end.
     1631           else do:
     1632               assign
     1633                   temp_turn-over.sum-rubl-cost    = temp_turn-over.sum-rubl-cost + buf_stk-line.sum-rubl
     1634                   temp_turn-over.sum-base-cost    = temp_turn-over.sum-base-cost + buf_stk-line.sum-base
     1635               .
     1636           end.
     1637           find last buf_stk-line no-lock
     1638             where buf_stk-line.obj-type     = p-obj-type
     1639               and buf_stk-line.obj-code     = p-obj-code
     1640               and buf_stk-line.artic        = p-artic
     1641               and buf_stk-line.prod-type    = p-prod-type
     1642               and buf_stk-line.prod-code    = p-prod-code
     1643               and buf_stk-line.sum-type     = p-sum-type
     1644               and buf_stk-line.cat-id       = '##,##':U
     1645               and buf_stk-line.fact-order  <= p-fact-order-from
     1646           use-index category
     1647           no-error.
     1648           if available buf_stk-line
     1649           then do:
     1650               if p-calc-qnty = yes
     1651               then do:
     1652                   assign
     1653                       temp_turn-over.qnty       = temp_turn-over.qnty     - buf_stk-line.fact-qnty
     1654                       temp_turn-over.sum-rubl   = temp_turn-over.sum-rubl - buf_stk-line.sum-rubl
     1655                       temp_turn-over.sum-base   = temp_turn-over.sum-base - buf_stk-line.sum-base
     1656                   .
     1657               end.
     1658               else do:
     1659                   assign
     1660                       temp_turn-over.sum-rubl-cost  = temp_turn-over.sum-rubl-cost - buf_stk-line.sum-rubl
     1661                       temp_turn-over.sum-base-cost  = temp_turn-over.sum-base-cost - buf_stk-line.sum-base
     1662                   .
     1663               end.
     1664           end.
     1665       end.
     1666   end.
     1667   end procedure.
     1668   procedure form-stk :
     1669   define input parameter p-gds-obj-rowid  as rowid            no-undo.
     1670   define input parameter p-sum-type    like stk-tot.sum-type            no-undo.
     1671   define input parameter p-tag-name    as character                     no-undo.
     1672   define output parameter p-qnty-first like stk-tot.fact-qnty  init 0   no-undo.
     1673   define output parameter p-qnty-last  like stk-tot.fact-qnty  init 0   no-undo.
     1674       define buffer buf_gds-obj       for gds-obj.
     1675   do
     1676   for buf_gds-obj
     1677   on error undo, return error
     1678   :
     1679       find first buf_gds-obj no-lock
     1680            where rowid( buf_gds-obj ) = p-gds-obj-rowid
     1681       .
     1682       find first temp_good-sum
     1683            where temp_good-sum.tag-name = p-tag-name
     1684       no-error.
     1685       if not available temp_good-sum
     1686       then do:
     1687           create temp_good-sum.
     1688           assign
     1689               temp_good-sum.tag-name          = p-tag-name
     1690           .
     1691       end.
     1692       assign
     1693           temp_good-sum.first-rubl        = 0
     1694           temp_good-sum.first-base        = 0
     1695           temp_good-sum.last-rubl         = 0
     1696           temp_good-sum.last-base         = 0
     1697       .
     1698       find last stk-line no-lock
     1699           where stk-line.obj-type  = buf_gds-obj.obj-type
     1700             and stk-line.obj-code  = buf_gds-obj.obj-code
     1701             and stk-line.artic     = buf_gds-obj.artic
     1702             and stk-line.prod-type = buf_gds-obj.prod-type
     1703             and stk-line.prod-code = buf_gds-obj.prod-code
     1704             and stk-line.sum-type  = p-sum-type
     1705             and stk-line.cat-id    = '##,##':U
     1706             and stk-line.fact-order <= v-fact-order-to
     1707       use-index category
     1708       no-error.
     1709       if available stk-line
     1710       then do:
     1711           assign
     1712               p-qnty-last             = stk-line.fact-qnty
     1713               temp_good-sum.last-rubl = temp_good-sum.last-rubl + stk-line.sum-rubl
     1714               temp_good-sum.last-base = temp_good-sum.last-base + stk-line.sum-base
     1715           .
     1716       end.
     1717       if  buf_gds-obj.last-doc < p-date
     1718       then do:
     1719           assign
     1720               p-qnty-first                = p-qnty-last
     1721               temp_good-sum.first-rubl    = temp_good-sum.last-rubl
     1722               temp_good-sum.first-base    = temp_good-sum.last-base
     1723           .
     1724       end.
     1725       else do:
     1726           find last stk-line no-lock
     1727               where stk-line.obj-type  = buf_gds-obj.obj-type
     1728                 and stk-line.obj-code  = buf_gds-obj.obj-code
     1729                 and stk-line.artic     = buf_gds-obj.artic
     1730                 and stk-line.prod-type = buf_gds-obj.prod-type
     1731                 and stk-line.prod-code = buf_gds-obj.prod-code
     1732                 and stk-line.sum-type  = p-sum-type
     1733                 and stk-line.cat-id    = '##,##':U
     1734                 and stk-line.fact-order <= v-fact-order-from
     1735           use-index category
     1736           no-error.
     1737           if available stk-line
     1738           then do:
     1739               assign
     1740                   p-qnty-first                = p-qnty-first             + stk-line.fact-qnty
     1741                   temp_good-sum.first-rubl    = temp_good-sum.first-rubl + stk-line.sum-rubl
     1742                   temp_good-sum.first-base    = temp_good-sum.first-base + stk-line.sum-base
     1743               .
     1744           end.
     1745       end.
     1746       if   p-qnty-first             = 0
     1747        and temp_good-sum.first-rubl = 0
     1748        and temp_good-sum.first-base = 0
     1749       then do:
     1750           assign
     1751               temp_good-sum.write-result = no
     1752           .
     1753       end.
     1754       else do:
     1755           assign
     1756               temp_good-sum.write-result = yes
     1757               v-write-good               = yes
     1758           .
     1759       end.
     1760   end.
     1761   end procedure.
     1762   procedure process-result :
     1763   do
     1764   on error undo, return error
     1765   :
     1766   define input parameter p-object-id              as character        no-undo.
     1767   define input parameter p-current-price-string   as character        no-undo.
     1768   define input parameter p-date-string            as character        no-undo.
     1769   define input parameter p-obj-type               as character        no-undo.
     1770   define input parameter p-obj-code               as integer          no-undo.
     1771       define variable v-good-counter      as integer           no-undo.
     1772       define variable v-sum-all           as decimal           no-undo.
     1773       define variable v-sum-all-cost      as decimal           no-undo.
     1774       define variable v-qnty-all          as decimal           no-undo.
     1775       process events.
     1776       assign
     1777           v-good-counter = v-good-counter + 1
     1778       .
     1779       run wp-xmltagopen( 1, 1, "ROW","").
     1780       run wp-xmltagput( 1, 2, "SITE_ID"    , string( p-object-id )         , 0 ).
     1781       run wp-xmltagput( 1, 2, "DOCDATE"    , p-date-string                 , 0 ).
     1782       run wp-xmltagput( 1, 2, "TOV"        , string( temp_good.id )        , 0 ).
     1783       run wp-xmltagput( 1, 2, "gdsCode"    , string( temp_good.gds-code )  , 0 ).
     1784       run wp-xmltagput( 1, 2, "PRICE_COST" , p-current-price-string               , 0 ).
     1785       run wp-xmltagput( 1, 2, "COUNT_REST" , format-decimal( temp_good.qnty-last ), 0 ).
     1786       for each temp_turn-over
     1787          where temp_turn-over.write-result = yes
     1788       break by temp_turn-over.ext-doc-type
     1789       :
     1790           assign
     1791               v-sum-all       = v-sum-all      + temp_turn-over.sum-rubl
     1792               v-qnty-all      = v-qnty-all + temp_turn-over.qnty
     1793               v-sum-all-cost  = v-sum-all-cost + temp_turn-over.sum-rubl-cost
     1794           .
     1795       end.
     1796       run wp-xmltagput( 1, 2, "COUNT_SALE", format-decimal(  ( -1 ) * v-qnty-all      ), 0 ).
     1797       run wp-xmltagput( 1, 2, "SUM_SALE"  , format-decimal(  ( -1 ) * v-sum-all       ), 0 ).
     1798       run wp-xmltagput( 1, 2, "SUM_COST"  , format-decimal(  ( -1 ) * v-sum-all-cost  ), 0 ).
     1799       run wp-xmltagclose( 1, 1, "ROW").
     1800       if v-good-counter modulo 25 = 0
     1801       then do:
     1802           run wp-XMLWriteCnt( hcnt, "Товар " + p-obj-type + string( p-obj-code ) + "  " + string( v-good-counter ) ).
     1803           process events.
     1804       end.
     1805   end.
     1806   end procedure.
     1807   procedure get-current-price :
     1808   do
     1809   on error undo, return error
     1810   :
     1811   define input parameter p-obj-type  as character    no-undo.
     1812   define input parameter p-obj-code  as integer      no-undo.
     1813   define input parameter p-artic     as character    no-undo.
     1814   define input parameter p-prod-type as character    no-undo.
     1815   define input parameter p-prod-code as integer      no-undo.
     1816   define output parameter p-current-price as decimal      no-undo.
     1817       define buffer buf_price-list    for price-list.
     1818       define buffer buf_goods         for goods.
     1819       define buffer buf_gds-prt       for gds-prt.
     1820       find first buf_goods no-lock
     1821            where buf_goods.artic      = p-artic
     1822              and buf_goods.prod-type  = p-prod-type
     1823              and buf_goods.prod-code  = p-prod-code
     1824       no-error .
     1825       if not available buf_goods
     1826       then do:
     1827           undo, return error "get-current-price: Ошибка поиска товара в базе данных." + chr(10) + return-value.
     1828       end.
     1829       find first buf_gds-prt no-lock
     1830            where buf_gds-prt.upper-code = buf_goods.prt-root
     1831       .
     1832       if not available buf_gds-prt
     1833       then do:
     1834           undo, return error "get-current-price: Ошибка поиска корневого признака товара в базе данных." + chr(10) + return-value.
     1835       end.
     1836       find last buf_price-list no-lock
     1837           where buf_price-list.obj-type   = p-obj-type
     1838             and buf_price-list.obj-code   = p-obj-code
     1839             and buf_price-list.b-code     = buf_goods.gds-code
     1840             and buf_price-list.price-type = "":U
     1841       use-index fact-close
     1842       no-error.
     1843       if not available buf_price-list
     1844       then do:
     1845           assign
     1846               p-current-price = 0
     1847           .
     1848       end.
     1849       else do:
     1850           assign
     1851               p-current-price = buf_price-list.price-sale
     1852           .
     1853       end.
     1854   end.
     1855   end procedure.
