      590   procedure xmlchar-decode :
      591   define input parameter p-in-string      as character        no-undo.
      592   define output parameter p-out-string    as character        no-undo.
      593       define variable v-position      as integer      no-undo.
      594       define variable v-last-position as integer      no-undo.
      595       define variable v-temp-integer  as integer      no-undo.
      596       define variable v-current-char  as character    no-undo.
      597       define variable v-next-char     as character    no-undo.
      598       define variable v-success       as logical      no-undo.
      599   do
      600   on error undo, return error
      601   :
      602       assign
      603           p-out-string = "":U
      604           v-position   = 0
      605       .
      606       replace-cycle:
      607       do while yes
      608       on error undo, return error
      609       :
      610           assign
      611               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      612           .
      613           if v-last-position <= v-position
      614           then do:
      615               if v-position = 0
      616               then do:
      617                   assign
      618                       p-out-string = p-in-string
      619                   .
      620               end.
      621               else do:
      622                   assign
      623                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      624                   .
      625               end.
      626               leave replace-cycle.
      627           end.
      628           else do:
      629               assign
      630                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      631                   v-position      = v-last-position
      632                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      633               .
      634               if v-current-char = "#":U
      635               then do:
      636                   assign
      637                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      638                   .
      639                   if v-last-position > 0
      640                   then do:
      641                       run xmlchar-read-integer in this-procedure
      642                        (
      643                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      644                           , output v-temp-integer
      645                           , output v-success
      646                       ).
      647                       if v-success = yes
      648                       and v-temp-integer >= 1
      649                       and v-temp-integer <= 255
      650                       then do:
      651                           assign
      652                               p-out-string = p-out-string + chr( v-temp-integer )
      653                               v-position   = v-last-position + 1
      654                           .
      655                       end.
      656                       else do:
      657                           assign
      658                               p-out-string = p-out-string + "&":U
      659                               v-position   = v-position   + 1
      660                           .
      661                       end.
      662                   end.
      663                   else do:
      664                       assign
      665                           p-out-string = p-out-string + "&":U
      666                           v-position   = v-position   + 1
      667                       .
      668                   end.
      669               end.
      670               else do:
      671                   case substring( p-in-string, v-position + 1, 3 )
      672                   :
      673                       when "lt;":U
      674                       then do:
      675                           assign
      676                               p-out-string = p-out-string + "<":U
      677                               v-position   = v-position   + 3
      678                           .
      679                       end.
      680                       when "gt;":U
      681                       then do:
      682                           assign
      683                               p-out-string = p-out-string + ">":U
      684                               v-position   = v-position   + 3
      685                           .
      686                       end.
      687                       otherwise do:
      688                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      689                           then do:
      690                               assign
      691                                   p-out-string = p-out-string + "&":U
      692                                   v-position   = v-position   + 4
      693                               .
      694                           end.
      695                           else do:
      696                               case substring( p-in-string, v-position + 1, 5 )
      697                               :
      698                                   when "quot;":U
      699                                   then do:
      700                                       assign
      701                                           p-out-string = p-out-string + '"':U
      702                                           v-position   = v-position   + 5
      703                                       .
      704                                   end.
      705                                   when "apos;":U
      706                                   then do:
      707                                       assign
      708                                           p-out-string = p-out-string + "'":U
      709                                           v-position   = v-position   + 5
      710                                       .
      711                                   end.
      712                                   otherwise do:
      713                                       assign
      714                                           p-out-string = p-out-string + "&":U
      715                                       .
      716                                   end.
      717                               end case.
      718                           end.
      719                       end.
      720                   end case.
      721               end.
      722           end.
      723       end.
      724   end.
      725   end .
      726   procedure xmlchar-read-integer :
      727   define input parameter p-input-string      as character        no-undo.
      728   define output parameter p-output-integer   as integer          no-undo.
      729   define output parameter p-success       as logical          no-undo.
      730   do
      731   on error undo, return error
      732   :
      733       assign
      734           p-output-integer = integer( p-input-string )
      735       no-error.
      736       if error-status :error
      737       then do:
      738           assign
      739               p-success           = no
      740               p-output-integer    = 0
      741           .
      742       end.
      743       else do:
      744           assign
      745               p-success           = yes
      746           .
      747       end.
      748   end.
      749   end.
      750   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
      751                                             INPUT iFlagEmpty AS INTEGER).
      752     DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
      753     IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
      754       DO:
      755         IF iFlagEmpty = 0 THEN RETURN "".
      756         ELSE IF iFlagEmpty = 1                    THEN RETURN sParName + "=&#034;&#034;".
      757         ELSE IF iFlagEmpty = 2 AND sToPlace = "0" THEN RETURN sParName + "=&#034;0&#034;".
      758         ELSE IF iFlagEmpty = 3 AND sToPlace = ""  THEN RETURN sParName + "=&#034;&#034;".
      759         ELSE RETURN "".
      760       END.
      761     ELSE DO:
      762           run xmlchar-encode in this-procedure (
      763                 input sToPlace
      764               , output sToPlace
      765           ).
      766           ASSIGN
      767               sToPlace = sParName + '="' + sToPlace + '"'
      768           .
      769        RETURN sToPlace.
      770     END.
      771   END FUNCTION.
      772   PROCEDURE wp-XMLTagOpen:
      773     DEF INPUT PARAM iStmNum   AS INTEGER NO-UNDO.
      774     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
      775     DEF INPUT PARAM sTagName  AS CHAR NO-UNDO.
      776     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
      777       run xmlchar-encode in this-procedure (
      778             input sParValue
      779           , output sParValue
      780       ).
      781      if istmnum = 1
      782      then do:
      783           PUT STREAM stmXMLHead UNFORMATTED chr(10) + FILL(" ", 4 * iTagLevel) +
      784                           "<" + sTagName + (IF sParValue = "" OR sParValue = ? then "" ELSE " ") +
      785                           sParValue + ">".
      786      end.
      787      else do:
      788           PUT STREAM stmXMLBody UNFORMATTED chr(10) + FILL(" ", 4 * iTagLevel) +
      789                           "<" + sTagName + (IF sParValue = "" OR sParValue = ? then "" ELSE " ") +
      790                           sParValue + ">".
      791      end.
      792   END PROCEDURE.
      793   PROCEDURE wp-XMLTagPut:
      794     DEF INPUT PARAM iStmNum   AS INTEGER NO-UNDO.
      795     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
      796     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
      797     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
      798     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
      799      if istmnum = 1
      800      then do:
      801           IF  iFlagEmpty = 1
      802           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
      803           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
      804           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
      805           THEN DO:
      806               run xmlchar-encode in this-procedure (
      807                     input sParValue
      808                   , output sParValue
      809               ).
      810               PUT STREAM stmXMLHead UNFORMATTED chr(10) + FILL(" ", 4 * iTagLevel) +
      811                                   '<' + sTagName + '>' + sParValue + '</' + sTagName + '>'.
      812           END.
      813      end.
      814      else do:
      815           IF  iFlagEmpty = 1
      816           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
      817           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
      818           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
      819           THEN DO:
      820               run xmlchar-encode in this-procedure (
      821                     input sParValue
      822                   , output sParValue
      823               ).
      824               PUT STREAM stmXMLBody UNFORMATTED chr(10) + FILL(" ", 4 * iTagLevel) +
      825                                   '<' + sTagName + '>' + sParValue + '</' + sTagName + '>'.
      826           END.
      827      end.
      828   END PROCEDURE.
      829   PROCEDURE wp-XMLTagClose:
      830     DEF INPUT PARAM iStmNum   AS INTEGER NO-UNDO.
      831     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
      832     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
      833      if istmnum = 1
      834      then do:
      835           PUT STREAM stmXMLHead UNFORMATTED  chr(10) + FILL(" ", 4 * iTagLevel) + '</' + sTagName + '>'.
      836      end.
      837      else do:
      838           PUT STREAM stmXMLBody UNFORMATTED chr(10) + FILL(" ", 4 * iTagLevel) + '</' + sTagName + '>'.
      839      end.
      840   END PROCEDURE.
      841   PROCEDURE wp-XMLWriteLog:
      842     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
      843     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
      844     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
      845   OUTPUT STREAM stmXMLLog TO VALUE(sFileName) APPEND.
      846       PUT STREAM stmXMLLog UNFORMATTED chr(10).
      847       PUT STREAM stmXMLLog UNFORMATTED (IF (iLogLevel = 0 OR sToWrite = "&DLine"
      848                                         OR sToWrite = "&Line") THEN "" ELSE
      849                                         cur-time-string-sec() + " ").
      850       PUT STREAM stmXMLLog UNFORMATTED
      851               (IF sToWrite = "&Line" THEN FILL("-", 80)
      852                ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
      853                ELSE sToWrite).
      854   OUTPUT STREAM stmXMLLog CLOSE.
      855   END PROCEDURE.
      856   PROCEDURE wp-XMLWriteEDT:
      857     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
      858     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
      859     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
      860       if valid-handle ( hEDT )
      861       then do:
      862           hEDT :move-to-eof().
      863           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
      864                                           OR sToWrite = "&Line") THEN "" ELSE
      865                                           cur-time-string-sec() + " ").
      866           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
      867                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
      868                   ELSE FILL(" ", iLogLevel) + sToWrite).
      869           hEDT :insert-string(chr(10)).
      870       end.
      871   END PROCEDURE.
      872   PROCEDURE wp-XMLShowCNT:
      873     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
      874       if valid-handle( hCNT )
      875       then do:
      876           ASSIGN hCNT :VISIBLE = TRUE.
      877       end.
      878   END PROCEDURE.
      879   PROCEDURE wp-XMLHideCNT:
      880     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
      881       if valid-handle( hCNT )
      882       then do:
      883           ASSIGN hCNT :VISIBLE = FALSE.
      884       end.
      885   END PROCEDURE.
      886   PROCEDURE wp-XMLWriteCNT:
      887     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
      888     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
      889       if valid-handle( hCNT )
      890       then do:
      891           ASSIGN hCNT :SCREEN-VALUE = sCounter.
      892       end.
      893   END PROCEDURE.
      894   procedure rcs-xml-write-header:
      895   do
      896   on error undo, return error
      897   :
      898   define input parameter p-num-tables         as integer      no-undo.
      899   define input parameter p-xml-file-name-head as character    no-undo.
      900   define input parameter p-table-id-head      as character    no-undo.
      901   define input parameter p-xml-file-name-body as character    no-undo.
      902   define input parameter p-table-id-body      as character    no-undo.
      903       define variable v-reportnumber          as integer      no-undo.
      904       run get-next-reportnumber in this-procedure (
      905           output v-reportnumber
      906       ) no-error.
      907       if error-status :error
      908       then do:
      909           assign
      910               v-reportnumber = 0
      911           .
      912       end.
      913       output stream stmXMLHead to value( p-xml-file-name-head + ".xm1" ) convert target "1251".
      914           put stream stmXMLHead unformatted "<DESTINATION_ROID " + p-table-id-head + ">".
      915           run wp-xmltagopen( 1, 0, "mail Parameters","").
      916           run wp-xmltagput( 1, 1, "X-ReportType",    string( 1 ), 0).
      917           run wp-xmltagput( 1, 1, "X-IDChannel",     string( 3 ), 0).
      918           run wp-xmltagput( 1, 1, "X-ReportNumber",  string( v-reportnumber ), 0).
      919           run wp-xmltagclose( 1, 0, "mail Parameters").
      920           put stream stmXMLHead unformatted skip "<ROWSET>".
      921       output stream stmXMLHead close.
      922       if p-num-tables > 1
      923       then do:
      924           output stream stmXMLBody to value( p-xml-file-name-body + ".xm1" ) convert target "1251".
      925               put stream stmXMLBody unformatted "<DESTINATION_ROID " + p-table-id-body + ">".
      926               run wp-xmltagopen( 2, 0, "mail Parameters","").
      927               run wp-xmltagput( 2, 1, "X-ReportType",    string( 1 ), 0).
      928               run wp-xmltagput( 2, 1, "X-IDChannel",     string( 3 ), 0).
      929               run wp-xmltagput( 2, 1, "X-ReportNumber",  string( v-reportnumber ), 0).
      930               run wp-xmltagclose( 2, 0, "mail Parameters").
      931               put stream stmXMLBody unformatted skip "<ROWSET>".
      932           output stream stmXMLBody close.
      933       end.
      934   end.
      935   end procedure.
      936   procedure rcs-xml-write-footer:
      937   do
      938   on error undo, return error
      939   :
      940   define input parameter p-num-tables         as integer      no-undo.
      941   define input parameter p-xml-head-file-name as character    no-undo.
      942   define input parameter p-xml-body-file-name as character    no-undo.
      943       define variable v-error-num     as integer           no-undo.
      944       output stream stmXMLHead to value( p-xml-head-file-name + ".xm1" ) convert target "1251" append.
      945          put stream stmXMLHead unformatted skip "</ROWSET>" chr(10).
      946       output stream stmXMLHead close.
      947       if p-num-tables > 1
      948       then do:
      949           output stream stmXMLBody to value( p-xml-body-file-name + ".xm1" ) convert target "1251" append.
      950               put stream stmXMLBody unformatted skip "</ROWSET>" chr(10).
      951           output stream stmXMLBody close.
      952       end.
      953   end.
      954   end procedure.
      955   function format-decimal returns character ( input p-decimal as decimal ).
      956       if p-decimal = ?
      957       then do:
      958           return "?".
      959       end.
      960       else do:
      961           if abs( p-decimal ) < 1
      962           then do:
      963               return right-trim( string( p-decimal, "-9.9999999999" ), "0" ).
      964           end.
      965           else do:
      966               return string( p-decimal ).
      967           end.
      968       end.
      969   end function.
      970   procedure get-next-reportnumber :
      971   do
      972   on error undo, return error
      973   :
      974   define output parameter p-reportnumber as integer      no-undo.
      975       define buffer buf_usr-flt       for ubflt.usr-flt.
      976       find first buf_usr-flt exclusive-lock
      977            where buf_usr-flt.user-name  = 'все':U
      978              and buf_usr-flt.call-point = 'тек':U
      979       no-error .
      980       if not available buf_usr-flt
      981       then do:
      982           create buf_usr-flt.
      983           assign
      984               buf_usr-flt.user-name    = 'все':U
      985               buf_usr-flt.call-point   = 'тек':U
      986               buf_usr-flt.Naim = "1"
      987           .
      988       end.
      989       assign
      990           p-reportnumber   = integer( buf_usr-flt.Naim )
      991           buf_usr-flt.Naim = string( p-reportnumber + 1 )
      992       .
      993   end.
      994   end procedure.
      995       define variable l-exist-operation   as logical  no-undo.
      996       define variable v-qnty              like ot-tot.fact-qnty   no-undo.
      997       define variable v-doc-date          like trn-doc.doc-date   no-undo.
      998       define variable v-fact-date         like trn-doc.fact-date  no-undo.
      999       define variable v-pay-code          like trn-doc.fact-date  no-undo.
     1000       define variable v-doc-PS            like trn-doc.PS         no-undo.
     1001       define variable v-parts-cst-code    like parts.cst-code     no-undo.
     1002       define variable v-rcs-doc-id        as character            no-undo.
     1003       define temp-table temp_inkas-pay no-undo
     1004           field pay-code  like inkas-pay.pay-code
     1005           field tot-base  like inkas-pay.tot-base
     1006           field tot-rubl  like inkas-pay.tot-rubl
     1007           field tot-sum   like inkas-pay.tot-sum
     1008       index pi is primary unique pay-code
     1009       .
     1010       define buffer buf_ot-tot-sale           for ot-tot.
     1011       define buffer buf_ot-tot-cost           for ot-tot.
     1012       define buffer buf_ot-tot-crsa           for ot-tot.
     1013       define buffer buf_ot-line-sale          for ot-line.
     1014       define buffer buf_ot-line-cost          for ot-line.
     1015       define buffer buf_ot-line-crsa          for ot-line.
     1016       define buffer buf_doc-line              for doc-line.
     1017       define buffer buf_rcs-shops             for rcs-shops.
     1018       define buffer buf_rcs-retail1subject    for rcs-retail1subject.
     1019       define buffer buf_rcs-retail1product    for rcs-retail1product.
     1020       define buffer buf_rcs-retail1bill       for rcs-retail1bill.
     1021       define buffer buf_rcs-retail1price      for rcs-retail1price.
     1022   do
     1023   for buf_ot-tot-sale
     1024     , buf_ot-tot-cost
     1025     , buf_ot-tot-crsa
     1026     , buf_ot-line-sale
     1027     , buf_ot-line-cost
     1028     , buf_ot-line-crsa
     1029     , buf_doc-line
     1030     , buf_rcs-shops
     1031     , buf_rcs-retail1subject
     1032     , buf_rcs-retail1product
     1033     , buf_rcs-retail1bill
     1034     , buf_rcs-retail1price
     1035   on error undo, return error
     1036   :
     1037       assign
     1038       l-exist-operation = no
     1039       .
     1040       output stream stmXMLHead to value( p-head-file + ".xm1") convert target "1251" append .
     1041       output stream stmXMLBody to value( p-body-file + ".xm1") convert target "1251" append .
     1042       run wp-XMLWriteCNT( input hCNT, input "":U ).
     1043       if p-ext-doc-type = 'ot':U
     1044       then do:
     1045   define variable vss-include-info3 as character format "X(65)" no-undo
     1046   initial "@(#)$Workfile$ $Revision$".
     1047   for each  buf_ot-tot-sale no-lock
     1048       where buf_ot-tot-sale.obj-type     = p-obj-type
     1049         and buf_ot-tot-sale.obj-code     = p-obj-code
     1050         and buf_ot-tot-sale.ext-doc-type = p-ext-doc-type
     1051         and buf_ot-tot-sale.fact-order   > p-fact-order-from
     1052         and buf_ot-tot-sale.fact-order  <= p-fact-order-to
     1053         and buf_ot-tot-sale.sum-type     = 'crsa':U
     1054   :
     1055     if not l-exist-operation
     1056     then do:
     1057         run wp-XMLWriteEDT( hEDT, 4, "Операция " + string(p-oper-name) ).
     1058         run wp-XMLWriteLog(sLogFile, 0, "&Line").
     1059         run wp-XMLWriteLog(sLogFile, 1, "XML - Вывод операции " + string(p-oper-name) + " (" + p-ext-doc-type + ")").
     1060         assign
     1061               l-exist-operation = yes
     1062         .
     1063     end.
     1064           find first price-doc no-lock
     1065                where price-doc.doc-num = buf_ot-tot-sale.doc-code
     1066           no-error.
     1067           if not available price-doc
     1068           then do:
     1069               message
     1070                   "В архивах найден несуществующий документ переоценки N "
     1071                   + string(buf_ot-tot-sale.doc-code)
     1072                   view-as alert-box.
     1073               run wp-XMLWriteLog(  sLogFile,
     1074                                           1,
     1075                                   "*** ERR: *** Не удалось найти документ переоценки N "
     1076                                   + string(buf_ot-tot-sale.doc-code)
     1077                               ).
     1078               undo, leave.
     1079           end.
     1080           else do:
     1081               assign
     1082                   v-doc-date  = price-doc.doc-date
     1083                   v-fact-date  = price-doc.fact-date
     1084                   v-doc-PS    = price-doc.ps
     1085               .
     1086           end.
     1087           find first buf_rcs-retail1price no-lock
     1088                where buf_rcs-retail1price.doc-num = buf_ot-tot-sale.doc-code
     1089           no-error.
     1090           if available buf_rcs-retail1price
     1091           then do:
     1092               assign
     1093                   v-rcs-doc-id = buf_rcs-retail1price.price_id
     1094               .
     1095           end.
     1096           else do:
     1097               assign
     1098                   v-rcs-doc-id = ""
     1099               .
     1100           end.
     1101         run wp-XMLWriteCnt(
     1102               hcnt,
     1103               "   " + string(buf_ot-tot-sale.doc-code) + " от " + string(v-fact-date))
     1104         .
     1105         process events.
     1106           find first buf_rcs-shops no-lock
     1107                where buf_rcs-shops.obj-type = buf_ot-tot-sale.obj-type
     1108                  and buf_rcs-shops.obj-code = buf_ot-tot-sale.obj-code
     1109           no-error.
     1110           if not available buf_rcs-shops
     1111           then do:
     1112               undo, return error "rcs-oper: Не найден ID объекта."
     1113                       + chr(10) + "Тип объекта: " + buf_ot-tot-sale.obj-type
     1114                       + chr(10) + "Код объекта: " + string( buf_ot-tot-sale.obj-code )
     1115               .
     1116           end.
     1117           run wp-xmltagopen( 1, 1, "ROW","").
     1118           run wp-xmltagput( 1, 2, "ID",             buf_ot-tot-sale.doc-code, 0).
     1119           run wp-xmltagput( 1, 2, "RCS_ID",         v-rcs-doc-id,             0).
     1120           run wp-xmltagput( 1, 2, "DDAT",           string( year( v-doc-date ) ) + string( month( v-doc-date ), "99" ) + string( day( v-doc-date ), "99" ) + string( "000000" ), 0).
     1121           run wp-xmltagput( 1, 2, "FDAT",           string( year( v-fact-date ) ) + string( month( v-fact-date ), "99" ) + string( day( v-fact-date ), "99" ) + string( "000000" ), 0).
     1122           run wp-xmltagput( 1, 2, "DNOM",           buf_ot-tot-sale.doc-code, 0).
     1123           run wp-xmltagput( 1, 2, "DTYPE",          string( p-rcs-doc-type ), 0).
     1124           run wp-xmltagput( 1, 2, "STAD",           "1", 0).
     1125           run wp-xmltagput( 1, 2, "DMODE",          ( if p-ext-doc-type = 'ie':U or p-ext-doc-type = 'ot':U then "-1" else "0" ), 0).
     1126           run wp-xmltagput( 1, 2, "SITE",           string( buf_rcs-shops.id ), 0).
     1127           run wp-xmltagput( 1, 2, "MESS",  v-doc-PS, 0).
     1128         .
     1129         for each buf_ot-line-sale no-lock
     1130             where buf_ot-line-sale.doc-code = buf_ot-tot-sale.doc-code
     1131               and buf_ot-line-sale.sum-type = buf_ot-tot-sale.sum-type
     1132         :
     1133             run wp-xmltagopen( 2, 1, "ROW","").
     1134             run wp-xmltagput( 2, 2, "DOC_HEAD_ID",  buf_ot-tot-sale.doc-code, 0).
     1135             find first goods no-lock
     1136                  where goods.artic      = buf_ot-line-sale.artic
     1137                    and goods.prod-type  = buf_ot-line-sale.prod-type
     1138                    and goods.prod-code  = buf_ot-line-sale.prod-code
     1139             no-error.
     1140             if available goods
     1141             then do:
     1142                   find first buf_rcs-retail1product no-lock
     1143                        where buf_rcs-retail1product.gds-code = goods.gds-code
     1144                   no-error.
     1145                   if not available buf_rcs-retail1product
     1146                   then do:
     1147                       run wp-XMLWriteEDT( hEDT, 4, "Не удалось найти PRODUCT для товара с кодом " + string( goods.gds-code ) ).
     1148                       run wp-xmltagput( 2, 2, "gdsCode",    string( goods.gds-code ),   0).
     1149                   end.
     1150                   else do:
     1151                       run wp-xmltagput( 2, 2, "TOV",        string( buf_rcs-retail1product.id ),         0).
     1152                       run wp-xmltagput( 2, 2, "gdsCode",    string( buf_rcs-retail1product.gds-code ),   0).
     1153                   end.
     1154             end.
     1155             else do:
     1156                   run wp-xmltagput( 2, 2, "TOV",       "",         0).
     1157             end.
     1158    assign
     1159          v-qnty = buf_ot-line-sale.fact-qnty
     1160    .
     1161             .
     1162                   run wp-xmltagput( 2, 2, "CEN01", string( buf_ot-line-sale.sum-rubl ), 2).
     1163             .
     1164             run wp-xmltagclose( 2, 1, "ROW").
     1165         end.
     1166         run wp-xmltagclose( 1, 1, "ROW").
     1167   end.
     1168       end.
     1169       else do:
     1170   define variable vss-include-info4 as character format "X(65)" no-undo
     1171   initial "@(#)$Workfile$ $Revision$".
     1172   for each  buf_ot-tot-sale no-lock
     1173       where buf_ot-tot-sale.obj-type     = p-obj-type
     1174         and buf_ot-tot-sale.obj-code     = p-obj-code
     1175         and buf_ot-tot-sale.ext-doc-type = p-ext-doc-type
     1176         and buf_ot-tot-sale.fact-order   > p-fact-order-from
     1177         and buf_ot-tot-sale.fact-order  <= p-fact-order-to
     1178         and (     buf_ot-tot-sale.sum-type = 'sale':U
     1179               or  buf_ot-tot-sale.sum-type = 'sasr':U
     1180             )
     1181   :
     1182     if not l-exist-operation
     1183     then do:
     1184         run wp-XMLWriteEDT( hEDT, 4, "Операция " + string(p-oper-name) ).
     1185         run wp-XMLWriteLog(sLogFile, 0, "&Line").
     1186         run wp-XMLWriteLog(sLogFile, 1, "XML - Вывод операции " + string(p-oper-name) + " (" + p-ext-doc-type + ")").
     1187         assign
     1188               l-exist-operation = yes
     1189         .
     1190     end.
     1191           find first trn-doc no-lock
     1192                where trn-doc.doc-code = buf_ot-tot-sale.doc-code
     1193           no-error.
     1194           if not available trn-doc
     1195           then do:
     1196               message
     1197                   "В архивах найден несуществующий документ N "
     1198                   + string(buf_ot-tot-sale.doc-code)
     1199                   view-as alert-box.
     1200               run wp-XMLWriteLog(  sLogFile,
     1201                                           1,
     1202                                   "*** ERR: *** Не удалось найти документ N "
     1203                                   + string(buf_ot-tot-sale.doc-code)
     1204               ).
     1205               undo, leave.
     1206           end.
     1207           else do:
     1208               assign
     1209                   v-doc-date  = trn-doc.doc-date
     1210                   v-fact-date = trn-doc.fact-date
     1211                   v-doc-PS    = trn-doc.ps
     1212               .
     1213           end.
     1214           find first buf_rcs-retail1bill no-lock
     1215                where buf_rcs-retail1bill.doc-code = buf_ot-tot-sale.doc-code
     1216           no-error.
     1217           if available buf_rcs-retail1bill
     1218           then do:
     1219               assign
     1220                   v-rcs-doc-id = buf_rcs-retail1bill.id
     1221               .
     1222           end.
     1223           else do:
     1224               assign
     1225                   v-rcs-doc-id = ""
     1226               .
     1227           end.
     1228         run wp-XMLWriteCnt(
     1229               hcnt,
     1230               "   " + string(buf_ot-tot-sale.doc-code) + " от " + string(v-fact-date))
     1231         .
     1232         process events.
     1233           find first buf_rcs-shops no-lock
     1234                where buf_rcs-shops.obj-type = buf_ot-tot-sale.obj-type
     1235                  and buf_rcs-shops.obj-code = buf_ot-tot-sale.obj-code
     1236           no-error.
     1237           if not available buf_rcs-shops
     1238           then do:
     1239               undo, return error "rcs-oper: Не найден ID объекта."
     1240                       + chr(10) + "Тип объекта: " + buf_ot-tot-sale.obj-type
     1241                       + chr(10) + "Код объекта: " + string( buf_ot-tot-sale.obj-code )
     1242               .
     1243           end.
     1244           run wp-xmltagopen( 1, 1, "ROW","").
     1245           run wp-xmltagput( 1, 2, "ID",             buf_ot-tot-sale.doc-code, 0).
     1246           run wp-xmltagput( 1, 2, "RCS_ID",         v-rcs-doc-id,             0).
     1247           run wp-xmltagput( 1, 2, "DDAT",           string( year( v-doc-date ) ) + string( month( v-doc-date ), "99" ) + string( day( v-doc-date ), "99" ) + string( "000000" ), 0).
     1248           run wp-xmltagput( 1, 2, "FDAT",           string( year( v-fact-date ) ) + string( month( v-fact-date ), "99" ) + string( day( v-fact-date ), "99" ) + string( "000000" ), 0).
     1249           run wp-xmltagput( 1, 2, "DNOM",           buf_ot-tot-sale.doc-code, 0).
     1250           run wp-xmltagput( 1, 2, "DTYPE",          string( p-rcs-doc-type ), 0).
     1251           run wp-xmltagput( 1, 2, "STAD",           "1", 0).
     1252           run wp-xmltagput( 1, 2, "DMODE",          ( if p-ext-doc-type = 'ie':U or p-ext-doc-type = 'ot':U then "-1" else "0" ), 0).
     1253           run wp-xmltagput( 1, 2, "SITE",           string( buf_rcs-shops.id ), 0).
     1254           find first buf_rcs-retail1subject no-lock
     1255                where buf_rcs-retail1subject.obj-type = trn-doc.cli-type
     1256                  and buf_rcs-retail1subject.obj-code = trn-doc.cli-code
     1257           no-error.
     1258           if not available buf_rcs-retail1subject
     1259           then do:
     1260               run wp-XMLWriteEDT( hEDT, 4, "Не удалось найти SUBJECT для документа " + string( trn-doc.doc-code ) ).
     1261           end.
     1262           else do:
     1263               run wp-xmltagput( 1, 2, "CORR", string( buf_rcs-retail1subject.id ), 0).
     1264           end.
     1265           run wp-xmltagput( 1, 2, "cliType", string( trn-doc.cli-type  ), 0).
     1266           run wp-xmltagput( 1, 2, "cliCode", string( trn-doc.cli-code  ), 0).
     1267           run wp-xmltagput( 1, 2, "MESS",  v-doc-PS, 0).
     1268             find first buf_ot-tot-cost no-lock
     1269                  where buf_ot-tot-cost.doc-code = buf_ot-tot-sale.doc-code
     1270                    and (  buf_ot-tot-cost.sum-type     = 'cost':U
     1271                        or buf_ot-tot-cost.sum-type     = 'cssr':U
     1272                        )
     1273                    and buf_ot-tot-cost.cat-id = '##,##':U
     1274             no-error.
     1275             if not available buf_ot-tot-cost
     1276             then do:
     1277             end.
     1278             find first buf_ot-tot-crsa no-lock
     1279                  where buf_ot-tot-crsa.doc-code = buf_ot-tot-sale.doc-code
     1280                    and (  buf_ot-tot-crsa.sum-type     = 'crsa':U
     1281                        or buf_ot-tot-crsa.sum-type     = 'cgsr':U
     1282                        )
     1283             no-error.
     1284             if not available buf_ot-tot-crsa
     1285             then do:
     1286             end.
     1287         .
     1288         for each buf_ot-line-sale no-lock
     1289             where buf_ot-line-sale.doc-code = buf_ot-tot-sale.doc-code
     1290               and buf_ot-line-sale.sum-type = buf_ot-tot-sale.sum-type
     1291         :
     1292             run wp-xmltagopen( 2, 1, "ROW","").
     1293             run wp-xmltagput( 2, 2, "DOC_HEAD_ID",  buf_ot-tot-sale.doc-code, 0).
     1294             find first goods no-lock
     1295                  where goods.artic      = buf_ot-line-sale.artic
     1296                    and goods.prod-type  = buf_ot-line-sale.prod-type
     1297                    and goods.prod-code  = buf_ot-line-sale.prod-code
     1298             no-error.
     1299             if available goods
     1300             then do:
     1301                   find first buf_rcs-retail1product no-lock
     1302                        where buf_rcs-retail1product.gds-code = goods.gds-code
     1303                   no-error.
     1304                   if not available buf_rcs-retail1product
     1305                   then do:
     1306                       run wp-XMLWriteEDT( hEDT, 4, "Не удалось найти PRODUCT для товара с кодом " + string( goods.gds-code ) ).
     1307                       run wp-xmltagput( 2, 2, "gdsCode",    string( goods.gds-code ),   0).
     1308                   end.
     1309                   else do:
     1310                       run wp-xmltagput( 2, 2, "TOV",        string( buf_rcs-retail1product.id ),         0).
     1311                       run wp-xmltagput( 2, 2, "gdsCode",    string( buf_rcs-retail1product.gds-code ),   0).
     1312                   end.
     1313             end.
     1314             else do:
     1315                   run wp-xmltagput( 2, 2, "TOV",       "",         0).
     1316             end.
     1317             find first buf_doc-line no-lock
     1318                  where buf_doc-line.doc-code   = buf_ot-line-sale.doc-code
     1319                    and buf_doc-line.artic      = buf_ot-line-sale.artic
     1320                    and buf_doc-line.prod-type  = buf_ot-line-sale.prod-type
     1321                    and buf_doc-line.prod-code  = buf_ot-line-sale.prod-code
     1322             no-error.
     1323             if not available buf_doc-line
     1324             then do:
     1325             end.
     1326    assign
     1327          v-qnty = buf_ot-line-sale.fact-qnty
     1328    .
     1329               if p-ext-doc-type <> 'vt':U      and
     1330                  p-ext-doc-type <> 'vp':U
     1331               then do:
     1332                   run wp-xmltagput( 2, 2, "KOL02",   string(v-qnty), 0).
     1333               end.
     1334             .
     1335                 find first buf_ot-line-cost no-lock
     1336                     where buf_ot-line-cost.doc-code = buf_ot-tot-sale.doc-code
     1337                       and  buf_ot-line-cost.artic      = buf_ot-line-sale.artic
     1338                       and  buf_ot-line-cost.prod-type  = buf_ot-line-sale.prod-type
     1339                       and  buf_ot-line-cost.prod-code  = buf_ot-line-sale.prod-code
     1340                       and (buf_ot-line-cost.sum-type   = 'cost':U
     1341                         or buf_ot-line-cost.sum-type   = 'cssr':U
     1342                           )
     1343                 .
     1344                 if available buf_ot-line-cost
     1345                 then do:
     1346                       if buf_ot-line-cost.fact-qnty <> 0
     1347                       then do:
     1348                           run wp-xmltagput( 2, 2, "CEN01", string(abs(buf_ot-line-cost.sum-rubl / buf_ot-line-cost.fact-qnty ) ), 2).
     1349                       end.
     1350                 end.
     1351                 else do:
     1352                 end.
     1353                 find first buf_ot-line-crsa no-lock
     1354                     where buf_ot-line-crsa.doc-code = buf_ot-tot-sale.doc-code
     1355                       and  buf_ot-line-crsa.artic      = buf_ot-line-sale.artic
     1356                       and  buf_ot-line-crsa.prod-type  = buf_ot-line-sale.prod-type
     1357                       and  buf_ot-line-crsa.prod-code  = buf_ot-line-sale.prod-code
     1358                       and (buf_ot-line-crsa.sum-type   = 'crsa':U
     1359                         or buf_ot-line-crsa.sum-type   = 'cgsr':U
     1360                           )
     1361                 .
     1362                 if available buf_ot-line-crsa
     1363                 then do:
     1364                       if buf_ot-line-crsa.fact-qnty <> 0
     1365                       then do:
     1366                           run wp-xmltagput( 2, 2, "CEN02", string(abs(buf_ot-line-crsa.sum-rubl / buf_ot-line-crsa.fact-qnty )), 2).
     1367                       end.
     1368                 end.
     1369                 else do:
     1370                 end.
     1371             .
     1372             run wp-xmltagclose( 2, 1, "ROW").
     1373         end.
     1374         run wp-xmltagclose( 1, 1, "ROW").
     1375   end.
     1376       end.
     1377       output stream stmxmlhead close.
     1378       output stream stmxmlbody close.
     1379   end.
