      125   define variable vss-include-info1 as character format "X(65)" no-undo
      126   initial "@(#)$Workfile$ $Revision$".
      127   define temp-table temp_grplib_grp no-undo
      128       field sel           as character
      129       field nabor         as character
      130       field full-name     as character
      131       field print-code    as character
      132       field sort-name     as character
      133       field node-code     as integer
      134       field upper-code    as integer
      135       field calc-method   as character
      136       field round-method  as character
      137       field increase-pc   as decimal
      138       field min-marg      as character
      139       field max-marg      as character
      140       field cli-type      as character
      141       field cli-code      as integer
      142       field notcorr      as character
      143       field name          as character
      144       field level         as integer
      145       field mark          as character
      146       index pi is primary unique sort-name
      147       index fn full-name
      148       index nc is unique node-code
      149       index sl sel
      150       index uc upper-code
      151   .
      152   define temp-table temp_grplib_found-grp no-undo
      153       field full-name   as character
      154       field sort-name   as character
      155       field node-code   as integer
      156       field level       as integer
      157       field is-terminal as logical
      158       index pi is primary unique sort-name
      159       index fn full-name
      160       index lv level
      161       index it is-terminal
      162   .
      163   define temp-table temp_found-result-nodelist no-undo
      164       field node-code     as recid
      165       field processed     as logical
      166       field sort-name     as character
      167       field full-name     as character
      168       index pi is primary unique node-code
      169       index ps processed
      170   .
      171   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
      172   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
      173   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
      174   procedure grplib-get-parameters :
      175   define input parameter p-store-type     as character        no-undo.
      176   define input parameter p-store-code     as integer          no-undo.
      177   do
      178   on error undo, return error
      179   :
      180       assign
      181           v-grplib-not-fill-extra-info = no
      182       .
      183   end.
      184   end procedure.
      185   procedure grplib-get-sort-name :
      186   do
      187   on error undo, return error
      188   :
      189   define input parameter p-node-code  as integer      no-undo.
      190   define output parameter p-sort-name as character    no-undo.
      191       define variable v-upper-code    as integer           no-undo.
      192       define buffer buf_gds-grp       for ub.gds-grp.
      193       define buffer buf_upper_gds-grp for ub.gds-grp.
      194       find first buf_gds-grp no-lock
      195            where buf_gds-grp.node-code = p-node-code
      196       no-error.
      197       if not available buf_gds-grp
      198       then do:
      199           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      200       end.
      201       assign
      202           p-sort-name  = ""
      203           v-upper-code = 1
      204       .
      205       do while buf_gds-grp.upper-code <> 0
      206       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      207       :
      208           assign
      209               p-sort-name  = buf_gds-grp.node-name
      210                            + (if p-sort-name <> "" then chr(2) else "")
      211                            + p-sort-name
      212               v-upper-code = buf_gds-grp.upper-code
      213           .
      214           find first buf_gds-grp no-lock
      215                where buf_gds-grp.node-code = v-upper-code
      216           no-error.
      217           if not available buf_gds-grp
      218           then do:
      219               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      220                                   + string( v-upper-code )
      221                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      222           end.
      223       end.
      224   end.
      225   end procedure.
      226   define variable vss-include-info2 as character format "X(65)" no-undo
      227   initial "@(#)$Workfile$ $Revision$".
      228   procedure grplib-get-full-name :
      229      define input parameter p-node-code  as integer      no-undo.
      230      define output parameter p-full-name as character    no-undo.
      231      do
      232   on error undo, return error
      233   :
      234       define variable v-upper-code    as integer           no-undo.
      235       define buffer buf_gds-grp       for ub.gds-grp.
      236       define buffer buf_upper_gds-grp for ub.gds-grp.
      237       find first buf_gds-grp no-lock
      238            where buf_gds-grp.node-code = p-node-code
      239       no-error.
      240       if not available buf_gds-grp
      241       then do:
      242           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      243       end.
      244       assign
      245           p-full-name  = ""
      246           v-upper-code = 1
      247       .
      248       do while buf_gds-grp.upper-code <> 0
      249       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      250       :
      251           assign
      252               p-full-name  = buf_gds-grp.node-name
      253                            + (if p-full-name <> "" then chr(47) else "")
      254                            + p-full-name
      255               v-upper-code = buf_gds-grp.upper-code
      256           .
      257           find first buf_gds-grp no-lock
      258                where buf_gds-grp.node-code = v-upper-code
      259           no-error.
      260           if not available buf_gds-grp
      261           then do:
      262               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      263                                   + string( v-upper-code )
      264                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      265           end.
      266       end.
      267       assign
      268       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      269       .
      270   end.
      271   end .
      272   procedure grplib-get-node-from-full-name :
      273   define input parameter p-full-name as character no-undo .
      274   define output parameter p-node-code as integer no-undo .
      275   define variable v-ii as integer no-undo .
      276   define variable v-upper-code as integer no-undo .
      277   define variable v-root-code as integer no-undo .
      278   define variable v-entry as character no-undo .
      279   define buffer buf_gds-grp       for ub.gds-grp.
      280   do
      281   on error undo, return error
      282   :
      283     find first buf_gds-grp no-lock
      284         where buf_gds-grp.upper-code = 0
      285     no-error .
      286     if not available buf_gds-grp
      287     then do:
      288         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      289     end.
      290     else do:
      291       assign
      292       v-root-code = buf_gds-grp.node-code
      293       .
      294     end.
      295     v-upper-code = v-root-code.
      296     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      297       assign
      298       v-entry = entry(v-ii, p-full-name, chr(47)).
      299       if v-entry = '' then leave.
      300       find first buf_gds-grp no-lock where
      301                 buf_gds-grp.node-name = v-entry
      302             and buf_gds-grp.upper-code = v-upper-code
      303             no-error.
      304       if not available buf_gds-grp then do:
      305         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      306       end.
      307       else do:
      308         p-node-code = buf_gds-grp.node-code.
      309         v-upper-code = buf_gds-grp.node-code.
      310       end.
      311     end.
      312   end.
      313   end .
      314   procedure grplib-get-root-code :
      315   do
      316   on error undo, return error
      317   :
      318   define output parameter p-root-code as integer      no-undo.
      319       define buffer buf_gds-grp       for ub.gds-grp.
      320       find first buf_gds-grp no-lock
      321           where buf_gds-grp.upper-code = 0
      322       no-error .
      323       if not available buf_gds-grp
      324       then do:
      325           undo, return error .
      326       end.
      327       else do:
      328           assign
      329               p-root-code = buf_gds-grp.node-code
      330           .
      331       end.
      332   end.
      333   end procedure.
      334   procedure grplib-find-grp-by-full-name :
      335   do
      336   on error undo, return error
      337   :
      338   define input parameter p-search-name  as character    no-undo.
      339   define input parameter p-fill-path    as logical      no-undo.
      340   define output parameter p-found       as logical      no-undo.
      341       define variable v-upper-code    as integer          no-undo.
      342       define variable v-counter       as integer           no-undo.
      343       define variable v-level         as integer           no-undo.
      344       define variable v-full-name     as character         no-undo.
      345       define variable v-sort-name     as character         no-undo.
      346       define buffer buf_gds-grp       for ub.gds-grp.
      347       assign
      348           p-search-name = replace( p-search-name, chr(47), chr(2) )
      349       .
      350       run grplib-get-root-code ( output v-upper-code ) no-error .
      351       if error-status :error
      352       then do:
      353           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
      354       end.
      355       assign
      356           v-full-name  = ""
      357           v-level      = num-entries( p-search-name, chr(2) )
      358       .
      359       for each temp_grplib_found-grp
      360       :
      361           delete temp_grplib_found-grp.
      362       end.
      363       start-name-analyze:
      364       do v-counter = 1 to v-level
      365       :
      366           if v-counter < v-level
      367           then do:
      368               find first buf_gds-grp no-lock
      369                    where buf_gds-grp.upper-code = v-upper-code
      370                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      371               no-error .
      372               if not available buf_gds-grp
      373               then do:
      374                   assign
      375                       v-full-name  = p-search-name
      376                       v-sort-name  = p-search-name
      377                   .
      378                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      379               end.
      380               else do:
      381                   assign
      382                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
      383                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
      384                       v-upper-code = buf_gds-grp.node-code
      385                   .
      386                   if p-fill-path = yes
      387                   then do:
      388                       create temp_grplib_found-grp.
      389                       assign
      390                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
      391                           temp_grplib_found-grp.sort-name = v-sort-name
      392                           temp_grplib_found-grp.node-code = v-upper-code
      393                           temp_grplib_found-grp.level     = v-counter
      394                       .
      395                   end.
      396               end.
      397           end.
      398           else do:
      399               for each buf_gds-grp no-lock
      400                  where buf_gds-grp.upper-code = v-upper-code
      401                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      402               :
      403                   assign
      404                       p-found = yes
      405                   .
      406                   create temp_grplib_found-grp.
      407                   assign
      408                       temp_grplib_found-grp.full-name = v-full-name
      409                                                           + (if v-full-name = "" then "" else chr(47) )
      410                                                           + buf_gds-grp.node-name + chr(47)
      411                       temp_grplib_found-grp.sort-name = v-sort-name
      412                                                           + ( if v-sort-name = "" then "" else chr(2) )
      413                                                           + buf_gds-grp.node-name
      414                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
      415                       temp_grplib_found-grp.level     = v-level
      416                   .
      417               end.
      418               if p-found = no
      419               then do:
      420                   assign
      421                       v-full-name  = p-search-name
      422                       v-sort-name  = p-search-name
      423                   .
      424                   for each temp_grplib_found-grp
      425                   :
      426                       delete temp_grplib_found-grp.
      427                   end.
      428                   assign
      429                       p-found = no
      430                   .
      431               end.
      432           end.
      433       end.
      434   end.
      435   end procedure.
      436   procedure grplib-find-all-subgroup :
      437   do
      438   on error undo, return error
      439   :
      440   define input parameter p-start-node-code    as integer      no-undo.
      441   define input parameter p-terminal-only      as logical      no-undo.
      442       define variable v-start-full-name   as character     no-undo.
      443       define variable v-start-sort-name   as character     no-undo.
      444       define variable v-not-found         as logical       no-undo.
      445       define variable v-is-terminal       as logical       no-undo.
      446       define buffer buf_gds-grp           for ub.gds-grp.
      447       create temp_found-result-nodelist.
      448       assign
      449           temp_found-result-nodelist.node-code = p-start-node-code
      450           temp_found-result-nodelist.processed = no
      451       .
      452       run grplib-get-full-name in this-procedure (
      453             input p-start-node-code
      454           , output v-start-full-name
      455       ).
      456       run grplib-get-full-name in this-procedure (
      457             input p-start-node-code
      458           , output v-start-sort-name
      459       ).
      460       process-nodes:
      461       do while yes
      462       :
      463           find first temp_found-result-nodelist
      464                where temp_found-result-nodelist.node-code = p-start-node-code
      465           .
      466           assign
      467               temp_found-result-nodelist.processed = yes
      468           .
      469           for each buf_gds-grp no-lock
      470              where buf_gds-grp.upper-code = p-start-node-code
      471           on error undo, return error
      472           :
      473               run grplib-is-terminal in this-procedure (
      474                     input buf_gds-grp.node-code
      475                   , output v-is-terminal
      476               ).
      477               if v-is-terminal = yes
      478               then do:
      479                   create temp_grplib_found-grp.
      480                   assign
      481                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      482                                                           chr(47) + buf_gds-grp.node-name + chr(47)
      483                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      484                                                           chr(2) + buf_gds-grp.node-name + chr(2)
      485                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      486                       temp_grplib_found-grp.is-terminal = yes
      487                   .
      488               end.
      489               else do:
      490                   create temp_found-result-nodelist.
      491                   assign
      492                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
      493                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      494                                                              chr(47) + buf_gds-grp.node-name + chr(47)
      495                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      496                                                              chr(2) + buf_gds-grp.node-name + chr(2)
      497                       temp_found-result-nodelist.processed = no
      498                   .
      499                   if p-terminal-only = no
      500                   then do:
      501                       create temp_grplib_found-grp.
      502                       assign
      503                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      504                                                               chr(47) + buf_gds-grp.node-name + chr(47)
      505                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      506                                                               chr(2) + buf_gds-grp.node-name + chr(2)
      507                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      508                           temp_grplib_found-grp.is-terminal = no
      509                       .
      510                   end.
      511               end.
      512           end.
      513           find first temp_found-result-nodelist
      514                where temp_found-result-nodelist.processed = no
      515           no-error.
      516           if not available temp_found-result-nodelist
      517           then do:
      518               leave process-nodes.
      519           end.
      520           else do:
      521               assign
      522                   p-start-node-code = temp_found-result-nodelist.node-code
      523                   v-start-full-name = temp_found-result-nodelist.full-name
      524                   v-start-sort-name = temp_found-result-nodelist.sort-name
      525               .
      526           end.
      527       end.
      528   end.
      529   end procedure.
      530   procedure grplib-expand-name :
      531   define input parameter p-start-name as character        no-undo.
      532   define output parameter p-end-name  as character        no-undo.
      533       define variable v-is-terminal   as logical      no-undo.
      534       define variable v-found         as character    no-undo.
      535       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
      536   do
      537   for buf_temp_grplib_found-grp
      538   on error undo, return error
      539   :
      540       run grplib-find-grp-by-full-name in this-procedure (
      541             input p-start-name
      542           , input no
      543           , output v-found
      544       ) no-error.
      545       run grplib-get-max-substring in this-procedure (
      546                   input length( p-start-name )
      547                 , output p-end-name
      548       ) no-error .
      549       if error-status :error
      550       then do:
      551           assign
      552               p-end-name = ""
      553           .
      554       end.
      555       else do:
      556           find first temp_grplib_found-grp
      557               where temp_grplib_found-grp.full-name = p-end-name
      558           no-error.
      559           if available temp_grplib_found-grp
      560           then do:
      561               find first buf_temp_grplib_found-grp
      562                   where buf_temp_grplib_found-grp.full-name begins p-end-name
      563                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
      564               no-error.
      565               if not available buf_temp_grplib_found-grp
      566               then do:
      567                   run grplib-is-terminal in this-procedure (
      568                       input temp_grplib_found-grp.node-code
      569                       , output v-is-terminal
      570                   ).
      571               end.
      572           end.
      573       end.
      574   end.
      575   end procedure.
      576   procedure grplib-get-max-substring :
      577   do
      578   on error undo, return error
      579   :
      580   define input parameter p-min-substring-length   as integer      no-undo.
      581   define output parameter p-substring             as character    no-undo.
      582           define variable v-char-counter  as integer           no-undo.
      583           define variable v-current-char  as character         no-undo.
      584           define variable v-names-counter  as integer           no-undo.
      585           define variable v-base-string   as character         no-undo.
      586           assign
      587               v-char-counter  = p-min-substring-length
      588           .
      589           find first temp_grplib_found-grp no-error.
      590           if not available temp_grplib_found-grp
      591           then do:
      592               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
      593           end.
      594           else do:
      595               assign
      596                   v-base-string  = temp_grplib_found-grp.full-name
      597                   v-char-counter = 0
      598               .
      599               counter-block:
      600               do while yes
      601               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
      602               :
      603                   assign
      604                       v-char-counter  = v-char-counter + 1
      605                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      606                       v-names-counter = 0
      607                   .
      608                   compare-block:
      609                   for each temp_grplib_found-grp
      610                   :
      611                       assign
      612                           v-names-counter = v-names-counter + 1
      613                       .
      614                       if v-names-counter = 1
      615                       then do:
      616                           next compare-block.
      617                       end.
      618                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      619                       then do:
      620                           leave counter-block.
      621                       end.
      622                   end.
      623                   if v-names-counter = 1
      624                   then do:
      625                       assign
      626                           p-substring = v-base-string
      627                       .
      628                       return.
      629                   end.
      630               end.
      631               assign
      632                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      633               .
      634           end.
      635   end.
      636   end procedure.
      637   procedure grplib-is-terminal :
      638   do
      639   on error undo, return error "Ошибка процедуры grplib-is-terminal"
      640   :
      641   define input parameter p-node-code      as integer      no-undo.
      642   define output parameter p-is-terminal   as logical      no-undo.
      643       define buffer buf_gds-grp       for ub.gds-grp.
      644       find first buf_gds-grp no-lock
      645           where buf_gds-grp.upper-code = p-node-code
      646       no-error .
      647       if not available buf_gds-grp
      648       then do:
      649           assign
      650               p-is-terminal = yes
      651           .
      652       end.
      653       else do:
      654           assign
      655               p-is-terminal = no
      656           .
      657       end.
      658   end.
      659   end procedure.
      660   procedure grplib-have-goods :
      661   do
      662   on error undo, return error
      663   :
      664   define input parameter p-node-code      as integer      no-undo.
      665   define output parameter p-have-goods   as logical      no-undo.
      666       define buffer buf_goods         for ub.goods.
      667       find first buf_goods no-lock
      668            where buf_goods.grp-code = p-node-code
      669       no-error .
      670       if available buf_goods
      671       then do:
      672           assign
      673               p-have-goods = yes
      674           .
      675       end.
      676       else do:
      677           assign
      678               p-have-goods = no
      679           .
      680       end.
      681   end.
      682   end procedure.
      683   procedure grplib-find-by-substring :
      684   do
      685   on error undo, return error
      686   :
      687   define input parameter p-start-code         as integer      no-undo.
      688   define input parameter p-full-search-string as character    no-undo.
      689   define output parameter p-found-code        as integer      no-undo.
      690   define output parameter p-full-name         as character    no-undo.
      691       define variable v-start-code     as integer           no-undo.
      692       define variable v-found          as logical  init no  no-undo.
      693       define buffer buf_gds-grp       for ub.gds-grp.
      694       search-grp:
      695       for each buf_gds-grp no-lock
      696           where buf_gds-grp.node-code > p-start-code
      697       :
      698           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
      699           then do:
      700               assign
      701                   p-found-code = buf_gds-grp.node-code
      702                   v-found      = yes
      703               .
      704               run grplib-get-full-name in this-procedure (
      705                     input p-found-code
      706                   , output p-full-name
      707               ) no-error .
      708               if error-status :error
      709               then do:
      710                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
      711               end.
      712               leave search-grp.
      713           end.
      714       end.
      715       if v-found = yes
      716       then do:
      717       end.
      718       else do:
      719           assign
      720               p-full-name  = ""
      721               p-found-code = 0
      722           .
      723       end.
      724   end.
      725   end procedure.
      726   procedure grplib-analyze-grp-name :
      727   do
      728   on error undo, return error
      729   :
      730   define input parameter p-grp-name       as character            no-undo.
      731   define input parameter p-upper-code     as integer              no-undo.
      732   define output parameter p-error-message as character init ""    no-undo.
      733       define variable v-char-list     as character    no-undo.
      734       define variable v-char-counter  as integer      no-undo.
      735       define variable v-full-name     as character    no-undo.
      736       if p-grp-name = "" then do:
      737           assign
      738               p-error-message = "Название группы не может быть пустым.".
      739           .
      740       end.
      741       else do:
      742           assign
      743               v-char-list = "47,92,58,63,34,60,62,171,187,183"
      744           .
      745           do v-char-counter = 1 to num-entries( v-char-list )
      746           :
      747               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
      748               then do:
      749                   assign
      750                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
      751                   .
      752                   return.
      753               end.
      754           end.
      755           if p-upper-code > 0
      756           then do:
      757               run grplib-get-full-name in this-procedure (
      758                     input p-upper-code
      759                   , output v-full-name
      760               ) no-error .
      761               if error-status :error
      762               then do:
      763                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
      764               end.
      765               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
      766               then do:
      767                   assign
      768                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
      769                   .
      770               end.
      771           end.
      772       end.
      773   end.
      774   end procedure.
      775   procedure grplib-get-lvl-num :
      776   define input parameter p-node-code  as integer      no-undo.
      777   define output parameter p-lvl-num   as integer      no-undo.
      778       define variable v-full-name    as character    no-undo.
      779   do
      780   on error undo, return error
      781   :
      782       run grplib-get-full-name in this-procedure (
      783             input p-node-code
      784           , output v-full-name
      785       ).
      786       assign
      787           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
      788       .
      789       if p-lvl-num = -1
      790       then do:
      791           assign
      792               p-lvl-num = 0
      793           .
      794       end.
      795   end.
      796   end procedure.
      797   procedure proc-alt-shift-f2:
      798     if not ibs.th.gbl.gbl-var:rcode
      799   then
      800     run gbl\inidebug.p .
      801   end.
      802   procedure proc-alt-shift-f3:
      803     run gbl/prvssinf.p
      804       ( input this-procedure
      805       ) .
      806   end.
      807   define variable v-inform-launched as logical no-undo initial false .
      808   procedure proc-alt-shift-f4:
      809     define variable v-action as character no-undo .
      810     if v-inform-launched = false then do:
      811       assign
      812         v-inform-launched = true
      813       .
      814       run gbl/d-inform.w
      815         (  input self
      816         ,  input this-procedure
      817         , output v-action
      818         ) no-error .
      819       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      820       assign
      821         v-inform-launched = false
      822       .
      823     end.
      824   end.
      825   procedure proc-alt-f1:
      826     run gbl/corrhelp.p
      827       (input this-procedure
      828       ) .
      829   end .
      830   on alt-shift-f2 anywhere do:
      831     run proc-alt-shift-f2.
      832   end.
      833   on alt-shift-f3 anywhere do:
      834     run proc-alt-shift-f3 in this-procedure .
      835   end.
      836   on alt-shift-f4 anywhere do:
      837     run proc-alt-shift-f4 in this-procedure.
      838   end.
      839   on alt-f1 anywhere do:
      840     run proc-alt-f1 in this-procedure .
      841   end.
