      103   define variable v-unit-weight               as character      no-undo.
      104   define variable v-selected-object-name      as character      no-undo.
      105   define variable v-goods-parameter-dif-nam1  as logical  init yes no-undo.
      106   define variable v-goods-parameter-dif-nam2  as logical  init no  no-undo.
      107   define variable v-param-type                as character         no-undo.
      108   define variable v-value-character           as character         no-undo.
