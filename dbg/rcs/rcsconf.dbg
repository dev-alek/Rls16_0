     1930   PROCEDURE select-default-cli-grp :
     1931   do
     1932   on error undo, return error
     1933   :
     1934   define output parameter p-grp-name       as character    no-undo.
     1935   define output parameter p-cancel        as logical      no-undo.
     1936       define variable v-can-write as logical      no-undo.
     1937       define variable v-grp-recid-string      as character no-undo.
     1938       define buffer buf_usr-flt       for ubflt.usr-flt.
     1939       define buffer buf_cli-grp          for cli-grp.
     1940       find first buf_usr-flt exclusive-lock
     1941            where buf_usr-flt.user-name    = 'все':U
     1942              and buf_usr-flt.call-point   = 'группа-клиентов':U
     1943       no-error .
     1944       if not available buf_usr-flt
     1945       then do:
     1946           create buf_usr-flt.
     1947           assign
     1948               buf_usr-flt.user-name    = 'все':U
     1949               buf_usr-flt.call-point   = 'группа-клиентов':U
     1950               v-grp-recid-string = ""
     1951           .
     1952       end.
     1953       else do:
     1954           find first buf_cli-grp no-lock
     1955                where buf_cli-grp.node-code = integer( buf_usr-flt.Naim )
     1956           no-error .
     1957           if not available buf_cli-grp
     1958           then do:
     1959               assign
     1960                   v-grp-recid-string = ""
     1961               .
     1962           end.
     1963           else do:
     1964               assign
     1965                   v-grp-recid-string = string( recid( buf_cli-grp ) )
     1966               .
     1967           end.
     1968       end.
     1969       run ref/cli-grps.w ( input p-mainmenu-handle, input 'терм':U + ',b-sel', input-output v-grp-recid-string ).
     1970       if v-grp-recid-string = ""
     1971       then do:
     1972           assign
     1973               p-cancel = yes
     1974           .
     1975       end.
     1976       else do:
     1977           find first buf_cli-grp no-lock
     1978                where recid ( buf_cli-grp ) = integer ( v-grp-recid-string )
     1979           no-error .
     1980           if not available buf_cli-grp
     1981           then do:
     1982               assign
     1983                   buf_usr-flt.Naim = "0"
     1984                   p-grp-name       = ""
     1985               .
     1986           end.
     1987           else do:
     1988               assign
     1989                   buf_usr-flt.Naim    = string( buf_cli-grp.node-code )
     1990                   p-cancel            = no
     1991               .
     1992               assign
     1993                   p-grp-name = buf_cli-grp.node-name
     1994               .
     1995           end.
     1996       end.
     1997   end.
     1998   END PROCEDURE.
     1999   PROCEDURE select-default-gds-grp :
     2000   do
     2001   on error undo, return error
     2002   :
     2003   define output parameter p-grp-name       as character    no-undo.
     2004   define output parameter p-cancel        as logical      no-undo.
     2005       define variable v-can-write as logical      no-undo.
     2006       define variable v-grp-recid-string      as character no-undo.
     2007       define buffer buf_usr-flt       for ubflt.usr-flt.
     2008       define buffer buf_gds-grp       for gds-grp.
     2009       find first buf_usr-flt exclusive-lock
     2010            where buf_usr-flt.user-name    = 'все':U
     2011              and buf_usr-flt.call-point   = 'группа':U
     2012       no-error .
     2013       if not available buf_usr-flt
     2014       then do:
     2015           create buf_usr-flt.
     2016           assign
     2017               buf_usr-flt.user-name    = 'все':U
     2018               buf_usr-flt.call-point   = 'группа':U
     2019               v-grp-recid-string = ""
     2020           .
     2021       end.
     2022       else do:
     2023           find first buf_gds-grp no-lock
     2024                where buf_gds-grp.node-code = integer( buf_usr-flt.Naim )
     2025           no-error .
     2026           if not available buf_gds-grp
     2027           then do:
     2028               assign
     2029                   v-grp-recid-string = ""
     2030               .
     2031           end.
     2032           else do:
     2033               assign
     2034                   v-grp-recid-string = string( recid( buf_gds-grp ) )
     2035               .
     2036           end.
     2037       end.
     2038   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2039     run mainmenu_getcntxt in p-mainmenu-handle
     2040       (output v-cntxt-db-num
     2041       ,output v-cntxt-userid
     2042       ,output v-cntxt-level
     2043       ,output v-cntxt-host-code-obj
     2044       ,output v-cntxt-obj-type
     2045       ,output v-cntxt-obj-code
     2046       ,output v-cntxt-db-num-obj
     2047       ,output v-cntxt-is-admin
     2048       ) .
     2049       run ref/gds-grp.w (
     2050             input p-mainmenu-handle
     2051           , input 'терм':U + ',b-sel'
     2052           , input v-cntxt-obj-type
     2053           , input v-cntxt-obj-code
     2054           , input-output v-grp-recid-string
     2055       ).
     2056       if v-grp-recid-string = ""
     2057       then do:
     2058           assign
     2059               p-cancel = yes
     2060           .
     2061       end.
     2062       else do:
     2063           find first buf_gds-grp no-lock
     2064                where recid ( buf_gds-grp ) = integer ( v-grp-recid-string )
     2065           no-error .
     2066           if not available buf_gds-grp
     2067           then do:
     2068               assign
     2069                   buf_usr-flt.Naim = "0"
     2070                   p-grp-name       = ""
     2071               .
     2072           end.
     2073           else do:
     2074               assign
     2075                   buf_usr-flt.Naim    = string( buf_gds-grp.node-code )
     2076                   p-cancel            = no
     2077               .
     2078               run grplib-get-full-name in this-procedure (
     2079                     input buf_gds-grp.node-code
     2080                   , output p-grp-name
     2081               ) no-error .
     2082               if error-status :error
     2083               then do:
     2084                   assign
     2085                       p-grp-name = ""
     2086                   .
     2087               end.
     2088           end.
     2089       end.
     2090   end.
     2091   END PROCEDURE.
     2092   PROCEDURE select-dir :
     2093   do
     2094   on error undo, return error
     2095   :
     2096   define input parameter p-impexp-type    as character    no-undo.
     2097   define output parameter p-dir           as character    no-undo.
     2098   define output parameter p-cancel        as logical      no-undo.
     2099       define variable v-dir-type  as character    no-undo.
     2100       define variable v-can-write as logical      no-undo.
     2101       define buffer buf_usr-flt       for ubflt.usr-flt.
     2102       run gbl/dir-sel.p (
     2103             output p-dir
     2104           , output v-dir-type
     2105           , output v-can-write
     2106       ) no-error .
     2107       if error-status :error
     2108       then do:
     2109           assign
     2110               p-cancel = yes
     2111           .
     2112           undo, return error "Ошибка выбора каталога импортируемых файлов." .
     2113       end.
     2114       else do:
     2115           if v-can-write = no
     2116           then do:
     2117               assign
     2118                   p-cancel = yes
     2119               .
     2120           end.
     2121           else do:
     2122               find first buf_usr-flt exclusive-lock
     2123                    where buf_usr-flt.user-name    = 'все':U
     2124                      and buf_usr-flt.call-point   = p-impexp-type
     2125               no-error .
     2126               if not available buf_usr-flt
     2127               then do:
     2128                   create buf_usr-flt.
     2129                   assign
     2130                       buf_usr-flt.user-name    = 'все':U
     2131                       buf_usr-flt.call-point   = p-impexp-type
     2132                   .
     2133               end.
     2134               assign
     2135                   buf_usr-flt.Naim = p-dir
     2136                   p-cancel = no
     2137               .
     2138           end.
     2139       end.
     2140   end.
     2141   END PROCEDURE.
     2142   PROCEDURE select-units :
     2143   do
     2144   on error undo, return error
     2145   :
     2146   define input parameter p-unit-type  as character    no-undo.
     2147   define output parameter p-unit-name as character    no-undo.
     2148   define output parameter p-cancel    as logical      no-undo.
     2149       define variable v-unit-recid     as recid             no-undo.
     2150       define buffer buf_usr-flt       for ubflt.usr-flt.
     2151       define buffer buf_units         for units.
     2152       find first buf_usr-flt exclusive-lock
     2153            where buf_usr-flt.user-name    = 'все':U
     2154              and buf_usr-flt.call-point   = p-unit-type
     2155       no-error .
     2156       if not available buf_usr-flt
     2157       then do:
     2158           create buf_usr-flt.
     2159           assign
     2160               buf_usr-flt.user-name    = 'все':U
     2161               buf_usr-flt.call-point   = p-unit-type
     2162           .
     2163       end.
     2164       run ref/units.w (
     2165             input p-mainmenu-handle
     2166           , input yes
     2167           , output v-unit-recid
     2168       ) no-error .
     2169       if error-status :error
     2170       then do:
     2171           undo, return error "select-units: Невозможно выбрать единицы измерения." + chr(10) + return-value.
     2172       end.
     2173       if v-unit-recid = ?
     2174       then do:
     2175           assign
     2176               p-cancel    = yes
     2177           .
     2178       end.
     2179       else do:
     2180           find first buf_units no-lock
     2181                where recid ( buf_units ) = v-unit-recid
     2182           no-error .
     2183           if not available buf_units
     2184           then do:
     2185               assign
     2186                   p-unit-name = ""
     2187                   p-cancel    = no
     2188               .
     2189           end.
     2190           else do:
     2191               assign
     2192                   buf_usr-flt.Naim = buf_units.unit-name
     2193                   p-unit-name      = buf_units.unit-name
     2194                   p-cancel         = no
     2195               .
     2196           end.
     2197       end.
     2198   end.
     2199   END PROCEDURE.
     2200   PROCEDURE select-wrkr-agnt-boss :
