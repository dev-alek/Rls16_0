       95   define variable v-mail-ReportNumber         as character      no-undo.
       96   define variable v-default-gds-grp-node-code as integer        no-undo.
       97   define variable v-default-cli-grp-node-code as integer        no-undo.
       98   define variable v-default-wrkr              as integer        no-undo.
       99   define variable v-default-agnt              as integer        no-undo.
      100   define variable v-default-boss              as integer        no-undo.
      101   define variable v-unit-pieces               as character      no-undo.
