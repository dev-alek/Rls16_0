     1410   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1411   on help of frame Dialog-Frame
     1412   do:
     1413     run gbl/app_help.p
     1414       (input this-procedure :file-name
     1415       ,input ''
     1416       ,input ?
     1417       ) no-error.
     1418     if error-status :error then do:
     1419       message
     1420         "Ошибка при вызове помощи"
     1421         error-status :get-message(1)
     1422         view-as alert-box .
     1423     end.
     1424   end.
     1425   run minbtn-set in this-procedure .
     1426   on choose of b-help in frame Dialog-Frame
     1427   do:
     1428     apply "help":u to frame Dialog-Frame .
     1429   end.
     1430   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1431   procedure minbtn-set :
     1432       do
     1433           on error undo, return error return-value
     1434           :
     1435           define variable ii              as integer       no-undo .
     1436           define variable fh              as widget-handle no-undo .
     1437           define variable hh              as widget-handle no-undo .
     1438           define variable v-h             as handle        extent 4 no-undo .
     1439           define variable v-name-button   as character     no-undo .
     1440           define variable v-help-old-x    as decimal       no-undo .
     1441           define variable v-help-old-y    as decimal       no-undo .
     1442           define variable v-help-old-size as decimal       no-undo .
     1443           define variable v-frame-width   as decimal       no-undo .
     1444           define variable jj              as integer       no-undo .
     1445           do
     1446               on error undo, return error
     1447               :
     1448               assign
     1449                   v-frame-width = frame Dialog-Frame:width - 0.3
     1450                   fh            = frame Dialog-Frame:first-child
     1451                   hh            = fh:first-child
     1452                   ii            = 1
     1453                   .
     1454               do while valid-handle(hh):
     1455                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1456                   do:
     1457                       case lc(hh:name) :
     1458                           when "b-help" then
     1459                               do:
     1460                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1461                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1462                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1463                                   hh:TOOLTIP = "Помощь" .
     1464                                   v-help-old-x = hh:column .
     1465                                   v-help-old-y = hh:row    .
     1466                                   v-help-old-size = hh:width .
     1467                                   hh:width-chars = 2.5 .
     1468                               end.
     1469                           when "b-print" then
     1470                               do:
     1471                                   hh:load-image("cmp/b-print.bmp":u) .
     1472                                   hh:TOOLTIP = "Печать" .
     1473                                   v-h[ii] = hh:handle .
     1474                                   ii = ii + 1 .
     1475                                   hh:width-chars = 3 .
     1476                               end.
     1477                           when "b-history" or
     1478                           when "b-hist" then
     1479                               do:
     1480                                   hh:load-image("cmp/b-hist.bmp":u) .
     1481                                   hh:TOOLTIP = "История" .
     1482                                   v-h[ii] = hh:handle .
     1483                                   ii = ii + 1 .
     1484                                   hh:width-chars = 3 .
     1485                               end.
     1486                           when "b-sch" then
     1487                               do:
     1488                                   hh:load-image("cmp/b-sch.bmp":u) .
     1489                                   hh:TOOLTIP = "Установка Фильтра" .
     1490                                   v-h[ii] = hh:handle .
     1491                                   ii = ii + 1 .
     1492                                   hh:width-chars = 3 .
     1493                               end.
     1494                           when "b-hist-user" then
     1495                               do:
     1496                                   hh:load-image("cmp/b-hist.bmp":u) .
     1497                                   hh:TOOLTIP = "История пользователя" .
     1498                                   ii = ii + 1 .
     1499                               end.
     1500                       end case.
     1501                   end.
     1502                   hh = hh:next-sibling.
     1503               end.
     1504               b-help:column = v-frame-width - b-help:width-chars.
     1505               jj = 0.
     1506               repeat ii = 4 to 1 by -1 :
     1507                   if valid-handle (v-h[ii] ) then
     1508                   do:
     1509                       jj  = jj + 1 .
     1510                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1511                       v-h[ii]:row    = v-help-old-y .
     1512                   end.
     1513               end.
     1514           end.
     1515       end.
     1516   end procedure.
     1517   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1518   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1519   MAIN-BLOCK:
     1520   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1521      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1522     RUN enable_UI.
     1523       run init-fields in this-procedure no-error .
     1524       if error-status :error
     1525       then do:
     1526           message
     1527           vss-workfile vss-revision vss-description
     1528           skip "Ошибка инициализации полей формы."
     1529           skip return-value
     1530           skip trim(error-status :get-message(1))
     1531           trim(error-status :get-message(2))
     1532           trim(error-status :get-message(3))
     1533           trim(error-status :get-message(4))
     1534           trim(error-status :get-message(5))
     1535           view-as alert-box error.
     1536           undo, return error .
     1537       end.
     1538     WAIT-FOR GO OF FRAME Dialog-Frame.
     1539   END.
     1540   RUN disable_UI.
     1541   PROCEDURE disable_UI :
     1542     HIDE FRAME Dialog-Frame.
     1543   END PROCEDURE.
     1544   PROCEDURE enable_UI :
     1545     DISPLAY fi-dir-imp fi-dir-exp fi-gds-grp fi-cli-grp fi-unit-integer
     1546             fi-trn-doc-wrkr fi-unit-divisional fi-trn-doc-agnt fi-unit-weight
     1547             fi-trn-doc-boss
     1548         WITH FRAME Dialog-Frame.
     1549     ENABLE b-exit b-help bt-objects bt-mag bt-bind bt-dir-imp bt-dir-exp
     1550            bt-gds-grp bt-cli-grp bt-sel-integer bt-sel-trn-doc-wrkr
     1551            bt-sel-divisional bt-sel-trn-doc-agnt bt-sel-weight
     1552            bt-sel-trn-doc-boss
     1553         WITH FRAME Dialog-Frame.
     1554     VIEW FRAME Dialog-Frame.
     1555   END PROCEDURE.
     1556   PROCEDURE init-fields :
     1557       define variable v-dir           as character         no-undo.
     1558       define variable v-grp-name      as character         no-undo.
     1559       define variable v-unit-name     as character         no-undo.
     1560       define variable v-person-name   as character         no-undo.
     1561       define variable v-cancel        as logical           no-undo.
     1562       define buffer buf_usr-flt       for ubflt.usr-flt.
     1563       define buffer buf_gds-grp       for gds-grp.
     1564       define buffer buf_cli-grp       for cli-grp.
     1565       define buffer buf_clients       for clients.
     1566       find first buf_usr-flt no-lock
     1567            where buf_usr-flt.user-name    = 'все':U
     1568              and buf_usr-flt.call-point   = 'rcs-import-directory':u
     1569       no-error .
     1570       if not available buf_usr-flt
     1571       then do:
     1572           run select-dir in this-procedure (
     1573                 input 'rcs-import-directory':u
     1574               , output v-dir
     1575               , output v-cancel
     1576           ) no-error .
     1577           if error-status :error
     1578           then do:
     1579               undo, return error "init-fields: Ошибка выбора каталога." + chr(10) + return-value.
     1580           end.
     1581           if v-cancel = no
     1582           then do:
     1583               assign
     1584                   fi-dir-imp :screen-value in frame Dialog-Frame = v-dir
     1585               .
     1586           end.
     1587       end.
     1588       else do:
     1589           assign
     1590               fi-dir-imp :screen-value in frame Dialog-Frame = buf_usr-flt.Naim
     1591           .
     1592       end.
     1593       find first buf_usr-flt no-lock
     1594            where buf_usr-flt.user-name    = 'все':U
     1595              and buf_usr-flt.call-point   = 'rcs-export-directory':u
     1596       no-error .
     1597       if not available buf_usr-flt
     1598       then do:
     1599           run select-dir in this-procedure (
     1600                 input 'rcs-export-directory':u
     1601               , output v-dir
     1602               , output v-cancel
     1603           ) no-error .
     1604           if error-status :error
     1605           then do:
     1606               undo, return error "init-fields: Ошибка выбора каталога." + chr(10) + return-value.
     1607           end.
     1608           if v-cancel = no
     1609           then do:
     1610               assign
     1611                   fi-dir-exp :screen-value in frame Dialog-Frame = v-dir
     1612               .
     1613           end.
     1614       end.
     1615       else do:
