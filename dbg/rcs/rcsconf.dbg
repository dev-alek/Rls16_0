      114   define temp-table temp_rcs-retail1bill          no-undo like rcs-retail1bill        .
      115   define temp-table temp_rcs-retail1billitem      no-undo like rcs-retail1billitem    .
      116   define temp-table temp_rcs-retail1subject       no-undo like rcs-retail1subject     .
      117   define temp-table temp_rcs-retail1bank          no-undo like rcs-retail1bank        .
      118   define temp-table temp_rcs-retail1attr          no-undo like rcs-retail1attr        .
      119   define temp-table temp_rcs-retail1product       no-undo like rcs-retail1product     .
      120   define temp-table temp_rcs-retail1price         no-undo like rcs-retail1price       .
      121   define temp-table temp_rcs-retail1priceitem     no-undo like rcs-retail1priceitem   .
      122   define temp-table temp_rcs-retail1barcode       no-undo like rcs-retail1barcode     .
