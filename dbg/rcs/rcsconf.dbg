     2206   define output parameter p-cancel    as logical      no-undo.
     2207       define variable v-person-recid-str     as character             no-undo.
     2208       define buffer buf_usr-flt       for ubflt.usr-flt.
     2209       define buffer buf_clients       for clients.
     2210       define buffer buf_person        for person.
     2211       find first buf_usr-flt exclusive-lock
     2212            where buf_usr-flt.user-name    = 'все':U
     2213              and buf_usr-flt.call-point   = p-person
     2214       no-error .
     2215       if not available buf_usr-flt
     2216       then do:
     2217           create buf_usr-flt.
     2218           assign
     2219               buf_usr-flt.user-name    = 'все':U
     2220               buf_usr-flt.call-point   = p-person
     2221           .
     2222       end.
     2223       run ref/cli-all.w (
     2224             input p-mainmenu-handle
     2225           , input "b-sel"
     2226           , input 'все':U
     2227           , input 'все':U
     2228           , input 'все':U
     2229           , input ?
     2230           , input ",,,,,,NO,,":u
     2231           , input "":U
     2232           , output v-person-recid-str
     2233       ) no-error .
     2234       if error-status :error
     2235       then do:
     2236           undo, return error "select-wrkr-agnt-boss: Невозможно выбрать клиента." + chr(10) + return-value + ". " + trim(error-status :get-message(1)).
     2237       end.
     2238       if v-person-recid-str = ?
     2239       or v-person-recid-str = ""
     2240       then do:
     2241           assign
     2242               p-cancel    = yes
     2243           .
     2244       end.
     2245       else do:
     2246           find first buf_clients no-lock
     2247                where recid( buf_clients ) = integer( v-person-recid-str )
     2248           no-error .
     2249           if not available buf_clients
     2250           then do:
     2251               assign
     2252                   p-person-name = ""
     2253                   p-cancel    = no
     2254               .
     2255           end.
     2256           else do:
     2257               find first buf_person no-lock
     2258                    where buf_person.psn-code = buf_clients.obj-code
     2259               no-error .
     2260               if not available buf_person
     2261               then do:
     2262                   undo, return error "select-wrkr-agnt-boss: Не найдена запись таблицы person." .
     2263               end.
     2264               assign
     2265                   buf_usr-flt.Naim = string( buf_person.psn-code )
     2266                   p-person-name    = buf_clients.obj-name
     2267                   p-cancel         = no
     2268               .
     2269           end.
     2270       end.
     2271   end.
     2272   END PROCEDURE.
