      980        bt-sel-trn-doc-agnt AT ROW 14.17 COL 60.13
      981        fi-trn-doc-agnt AT ROW 14.21 COL 40 COLON-ALIGNED NO-LABEL
      982        fi-unit-weight AT ROW 15.17 COL 11.5 COLON-ALIGNED NO-LABEL
      983        bt-sel-weight AT ROW 15.17 COL 20
      984        fi-trn-doc-boss AT ROW 15.21 COL 40 COLON-ALIGNED NO-LABEL
      985        bt-sel-trn-doc-boss AT ROW 15.21 COL 60.13
      986        "Исполнитель" VIEW-AS TEXT
      987             SIZE 14.25 BY .96 AT ROW 14.21 COL 27.13
      988        "Кладовщик" VIEW-AS TEXT
      989             SIZE 14 BY .96 AT ROW 13.21 COL 27.13
      990        "Штучный" VIEW-AS TEXT
      991             SIZE 8.5 BY .96 AT ROW 13.21 COL 2.63
      992        "Дробный" VIEW-AS TEXT
      993             SIZE 8.5 BY .96 AT ROW 14.21 COL 2.63
      994        "Весовой" VIEW-AS TEXT
      995             SIZE 8.5 BY .96 AT ROW 15.21 COL 2.63
      996        "Менеджер" VIEW-AS TEXT
      997             SIZE 14.38 BY .96 AT ROW 15.21 COL 27.13
      998        "Приходные накладные" VIEW-AS TEXT
      999             SIZE 30.63 BY 1.08 AT ROW 11.92 COL 27
     1000        "Единицы измерения" VIEW-AS TEXT
     1001             SIZE 21.75 BY 1.08 AT ROW 11.92 COL 2.63
     1002        SPACE(40.11) SKIP(3.78)
     1003       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1004            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1005            TITLE "Настройки обмена данными с РКС".
     1006   ASSIGN
     1007          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1008          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1009   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1010   DO:
     1011     APPLY "END-ERROR":U TO SELF.
     1012   END.
     1013   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     1014   DO:
     1015       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
     1016   END.
     1017   ON CHOOSE OF bt-bind IN FRAME Dialog-Frame
     1018   DO:
     1019       message
     1020               "Операция может занять много времени."
     1021               skip "Запустить выгрузку?"
     1022           view-as alert-box question
     1023           buttons yes-no
     1024           title "Начальная выгрузка данных"
     1025           update v-yesno as logical
     1026       .
     1027       if v-yesno = yes
     1028       then do:
     1029           hide bt-dir-imp fi-dir-imp bt-objects bt-mag.
     1030           view
     1031               fi-count
     1032           .
     1033           run rcs/exp-ini.p ( input fi-count :handle ) no-error.
     1034           if error-status :error
     1035           then do:
     1036               message
     1037                 vss-workfile vss-revision vss-description
     1038                 skip "Ошибка начальной выгрузки данных по товарам."
     1039                 skip return-value
     1040                 skip trim(error-status :get-message(1))
     1041                      trim(error-status :get-message(2))
     1042                      trim(error-status :get-message(3))
     1043               view-as alert-box error.
     1044               hide fi-count.
     1045               view bt-dir-imp fi-dir-imp bt-objects bt-mag.
     1046               undo, return no-apply .
     1047           end.
     1048           hide fi-count.
     1049           view bt-dir-imp fi-dir-imp bt-objects bt-mag.
     1050       end.
     1051   END.
     1052   ON CHOOSE OF bt-cli-grp IN FRAME Dialog-Frame
     1053   DO:
