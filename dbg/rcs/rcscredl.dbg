        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter p-trn-doc-doc-code   as character    no-undo .
        4   define input parameter p-gds-code           as integer      no-undo .
        5   define input parameter p-required-qnty      as decimal      no-undo .
        6   define input parameter p-price-cost         as decimal      no-undo .
        7   define input parameter p-base-rate          as decimal      no-undo.
        8   define input parameter p-base-scale         as integer      no-undo.
        9   define input parameter p-line-num           as integer      no-undo.
       10   define variable vss-revision    as character no-undo init "$Revision: 5baf537283c9, 2487, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
       12   define variable vss-date        as character no-undo init "$Date: 2020/06/26 13:47:04 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: rcscredl.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: rcs/rcscredl.p $":U .
       15   define variable vss-description as character no-undo init "".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define new global shared variable g#lib-trn  as handle no-undo .
       86   define new global shared variable g#lib-trn2 as handle no-undo .
       87   define new global shared variable g#lib-trn3 as handle no-undo .
       88   define new global shared variable g#lib-trn4 as handle no-undo .
       89       define variable v-doc-line-recid            as recid     no-undo .
       90       define variable v-out-price-base            as decimal   no-undo .
       91       define variable v-out-price-rubl            as decimal   no-undo .
       92       define variable v-allsum-sum-dsc-base-acc   as decimal   no-undo .
       93       define variable v-allsum-sum-dsc-rubl-acc   as decimal   no-undo .
       94       define variable v-allsum-vat-base-acc       as decimal   no-undo .
       95       define variable v-allsum-vat-rubl-acc       as decimal   no-undo .
       96       define variable v-vat-pc                    as decimal   no-undo .
       97       define variable v-host-code                 as integer   no-undo.
       98       define variable v-cons-vat-pc               as decimal   no-undo.
       99       define buffer buf_goods         for goods.
      100       define buffer buf_gds-prt       for gds-prt.
      101       define buffer buf_trn-doc       for trn-doc.
      102       define buffer buf_doc-line      for doc-line.
      103       define buffer buf_gds-dtl       for gds-dtl.
      104   do
      105   for buf_goods
      106     , buf_gds-prt
      107     , buf_trn-doc
      108     , buf_doc-line
      109     , buf_gds-dtl
      110   on error undo, return error
      111   :
      112       find first buf_goods no-lock
      113            where buf_goods.gds-code = p-gds-code
      114       .
      115       find first buf_gds-prt no-lock
      116            where buf_gds-prt.upper-code = buf_goods.prt-root
      117       .
      118       find first buf_trn-doc exclusive-lock
      119            where buf_trn-doc.doc-code = p-trn-doc-doc-code
      120       .
      121   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      123     (input  buf_trn-doc.obj-type
      124     ,input  buf_trn-doc.obj-code
      125     ,output v-host-code
      126     )  .
      127   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcvat in g#library
      129     (input  v-host-code
      130     ,output v-cons-vat-pc
      131     )  .
      132   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      134     (input  buf_goods.gds-code
      135     ,input  '1':U
      136     ,input  ?
      137     ,input  v-host-code
      138     ,input  buf_trn-doc.obj-type
      139     ,input  buf_trn-doc.obj-code
      140     ,output v-vat-pc
      141     )  .
      142       find first buf_doc-line exclusive-lock
      143            where buf_doc-line.doc-code  = buf_trn-doc.doc-code
      144              and buf_doc-line.artic     = buf_goods.artic
      145              and buf_doc-line.prod-type = buf_goods.prod-type
      146              and buf_doc-line.prod-code = buf_goods.prod-code
      147       no-error.
      148       if not available buf_doc-line
      149       then do:
      150           create buf_doc-line.
      151           assign
      152               buf_doc-line.doc-code      = buf_trn-doc.doc-code
      153               buf_doc-line.status_       = buf_trn-doc.status_
      154               buf_doc-line.artic         = buf_goods.artic
      155               buf_doc-line.prod-type     = buf_goods.prod-type
      156               buf_doc-line.prod-code     = buf_goods.prod-code
      157               buf_doc-line.obj-type      = buf_trn-doc.obj-type
      158               buf_doc-line.obj-code      = buf_trn-doc.obj-code
      159               buf_doc-line.prt-root      = buf_goods.prt-root
      160               buf_doc-line.cli-qnty      = p-required-qnty / buf_goods.cli-base-rate
      161               buf_doc-line.doc-qnty      = p-required-qnty
      162               buf_doc-line.fact-qnty     = p-required-qnty
      163               buf_doc-line.price-rubl    = p-price-cost
      164               buf_doc-line.price-base    = p-price-cost / p-base-rate * p-base-scale
      165               buf_doc-line.price-cli     = p-price-cost
      166               buf_doc-line.VAT-pc        = v-vat-pc
      167               buf_doc-line.VAT-pc        = 0
      168               buf_doc-line.line-num      = p-line-num
      169               buf_doc-line.unit-cli      = buf_goods.unit-base
      170               buf_doc-line.cli-base-rate = 1
      171               buf_doc-line.prt-ok        = yes
      172               buf_doc-line.cons-vat-pc   = v-cons-vat-pc
      173               buf_doc-line.doc-qnty      = p-required-qnty
      174           .
      175       end.
      176       else do:
      177           message
      178                    vss-workfile vss-revision vss-description
      179               skip "Строка с импортируемым товаром уже есть в документе."
      180               skip "Номер документа:" buf_trn-doc.doc-code
      181               skip "Товар:" buf_goods.artic buf_goods.gds-name
      182               skip return-value
      183               skip trim(error-status :get-message(1))
      184                    trim(error-status :get-message(2))
      185                    trim(error-status :get-message(3))
      186           view-as alert-box error.
      187           undo, return error .
      188       end.
      189       assign
      190           v-doc-line-recid = recid( buf_doc-line )
      191       .
      192       run rsrv-good in this-procedure (
      193             input buf_goods.gds-code
      194           , input buf_trn-doc.doc-code
      195           , input v-doc-line-recid
      196           , input p-price-cost
      197           , input p-price-cost / p-base-rate * p-base-scale
      198           , input p-required-qnty
      199       ) no-error.
      200       if error-status :error
      201       then do:
      202           message
      203             vss-workfile vss-revision vss-description
      204             skip "Ошибка резервирования товара."
      205             skip return-value
      206             skip trim(error-status :get-message(1))
      207                  trim(error-status :get-message(2))
      208                  trim(error-status :get-message(3))
      209           view-as alert-box error.
      210           undo, return error .
      211       end.
      212       find first buf_gds-dtl exclusive-lock
      213            where buf_gds-dtl.doc-code  = buf_trn-doc.doc-code
      214              and buf_gds-dtl.artic     = buf_goods.artic
      215              and buf_gds-dtl.prod-type = buf_goods.prod-type
      216              and buf_gds-dtl.prod-code = buf_goods.prod-code
      217              and buf_gds-dtl.prt-code  = buf_gds-prt.node-code
      218        .
      219       assign
      220           buf_gds-dtl.doc-qnty    = p-required-qnty
      221           buf_gds-dtl.fact-qnty   = p-required-qnty
      222       .
      223   end.
      224   procedure rsrv-good :
      225   do
      226   on error undo, return error
      227   :
      228   define input parameter p-gds-code           as integer   no-undo .
      229   define input parameter p-trn-doc-doc-code   as character no-undo .
      230   define input parameter p-doc-line-recid     as recid     no-undo .
      231   define input parameter p-price-cost-rubl    as decimal   no-undo .
      232   define input parameter p-price-cost-base    as decimal   no-undo .
      233   define input parameter p-required-qnty      as decimal   no-undo .
      234       define variable v-r-b-is-base   as logical      no-undo.
      235       define buffer buf_goods         for goods.
      236       define buffer buf_gds-prt       for gds-prt.
      237       define buffer buf_gds-dtl       for gds-dtl.
      238       define buffer buf_trn-doc       for trn-doc.
      239       define buffer buf_doc-line      for doc-line.
      240       find first buf_goods no-lock
      241            where buf_goods.gds-code = p-gds-code
      242       .
      243       find first buf_gds-prt no-lock
      244            where buf_gds-prt.upper-code = buf_goods.prt-root
      245       .
      246       find first buf_trn-doc no-lock
      247            where buf_trn-doc.doc-code = p-trn-doc-doc-code
      248       .
      249       find first buf_doc-line no-lock
      250            where recid( buf_doc-line ) = p-doc-line-recid
      251       .
      252   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      253   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
      254     (output v-r-b-is-base
      255     )  .
      256   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
      257     ( input buf_trn-doc.obj-code
      258      ,input buf_trn-doc.obj-type
      259      ,input buf_trn-doc.doc-code
      260      ,input buf_goods.artic
      261      ,input buf_goods.prod-code
      262      ,input buf_goods.prod-type
      263      ,input buf_gds-prt.node-code
      264      ,input yes
      265     ) no-error .
      266       if error-status:error
      267       then do:
      268           message
      269               "Ошибка при создании признака."
      270               skip return-value
      271           view-as alert-box error.
      272       end.
      273       find first buf_gds-dtl
      274            where buf_gds-dtl.doc-code  = buf_trn-doc.doc-code
      275              and buf_gds-dtl.artic     = buf_goods.artic
      276              and buf_gds-dtl.prod-type = buf_goods.prod-type
      277              and buf_gds-dtl.prod-code = buf_goods.prod-code
      278              and buf_gds-dtl.prt-code  = buf_gds-prt.node-code
      279        .
      280       if p-required-qnty = 0
      281       then do:
      282           message
      283             vss-workfile vss-revision vss-description
      284             skip "Невозможно зарезервировать количество 0."
      285             skip "Товар: " buf_goods.artic buf_goods.gds-name
      286             skip return-value
      287             skip trim(error-status :get-message(1))
      288                  trim(error-status :get-message(2))
      289                  trim(error-status :get-message(3))
      290           view-as alert-box error.
      291           undo, return error .
      292       end.
      293       if p-price-cost-rubl <= 0
      294       then do:
      295           message
      296               "Неправильные цены резервирования:"
      297               skip "Учетная цена, рубли:   " p-price-cost-rubl
      298               skip "Товар: " buf_goods.artic buf_goods.gds-name
      299           view-as alert-box error.
      300           undo, return error.
      301       end.
      302       run trg/rsrv-dtl.p (
      303             input p-mainmenu-handle
      304           , input 'reserv':U
      305           , buffer buf_gds-dtl
      306           , input-output p-required-qnty
      307           , input-output p-price-cost-base
      308           , input-output p-price-cost-rubl
      309           , input -1
      310           , input ""
      311       ) no-error.
      312       if error-status :error
      313       then do:
      314           if error-status :get-message(1) <> ""
      315           then do:
      316               message
      317                       vss-workfile vss-revision vss-description
      318                   skip "Ошибка при резервировании товара."
      319                   skip return-value
      320                   skip trim(error-status :get-message(1))
      321                       trim(error-status :get-message(2))
      322                       trim(error-status :get-message(3))
      323               view-as alert-box error.
      324               undo, return error .
      325           end.
      326       end.
      327   end.
      328   end procedure.
