      118   procedure get-shops-type-and-code :
      119   do
      120   on error undo, return error
      121   :
      122   define input parameter p-shops-id           as character    no-undo.
      123   define output parameter p-shops-obj-type    as character    no-undo.
      124   define output parameter p-shops-obj-code    as integer      no-undo.
      125       define buffer buf_rcs-shops     for rcs-shops.
      126       find first buf_rcs-shops no-lock
      127            where buf_rcs-shops.id = p-shops-id
      128       no-error.
      129       if not available buf_rcs-shops
      130       then do:
      131           undo, return error "get-shops-id: Не найден объект."
      132                   + chr(10) + "ID объекта: " + p-shops-id
      133           .
      134       end.
      135       else do:
      136           assign
      137               p-shops-obj-type    = buf_rcs-shops.obj-type
      138               p-shops-obj-code    = buf_rcs-shops.obj-code
      139           .
      140       end.
      141   end.
      142   end procedure.
      143   procedure get-destination-id :
      144   do
      145   on error undo, return error
      146   :
      147   define input parameter p-destination-name   as character    no-undo.
      148   define output parameter p-destination-id    as character    no-undo.
      149       define buffer buf_rcs-destn     for rcs-destn.
      150       find first buf_rcs-destn no-lock
      151            where buf_rcs-destn.name = p-destination-name
      152       no-error.
      153       if not available buf_rcs-destn
      154       then do:
      155           assign
      156               p-destination-id = ""
      157           .
      158       end.
      159       else do:
      160           assign
      161               p-destination-id = buf_rcs-destn.destination_rowid
      162           .
      163       end.
      164   end.
      165   end procedure.
