     5665   PROCEDURE import-rcs :
     5666   do
     5667   on error undo, return error
     5668   :
     5669   define input parameter p-fi     as handle       no-undo.
     5670   define input parameter p-ed     as handle       no-undo.
     5671   define input parameter p-dir    as character    no-undo.
     5672       define variable v-not-first     as logical  init no  no-undo.
     5673       define variable v-counter       as integer           no-undo.
     5674       define variable v-filename      as character         no-undo.
     5675       define variable v-par-value     as character         no-undo.
     5676       define variable v-par-type      as character         no-undo.
     5677       define buffer buf_rcs-destn     for rcs-destn.
     5678       define buffer buf_usr-flt       for ubflt.usr-flt.
     5679       run get-default-value in this-procedure (
     5680             input 'группа':U
     5681           , output v-par-value
     5682       ) no-error .
     5683       if error-status :error
     5684       then do:
     5685           undo, return error "import-rcs: Не задана группа по определению для товара." + chr(10) + return-value.
     5686       end.
     5687       assign
     5688           v-default-gds-grp-node-code = integer( v-par-value )
     5689       .
     5690       run get-default-value in this-procedure (
     5691             input 'группа-клиентов':U
     5692           , output v-par-value
     5693       ) no-error .
     5694       if error-status :error
     5695       then do:
     5696           undo, return error "import-rcs: Не задана группа по определению для поставщика ." + chr(10) + return-value.
     5697       end.
     5698       assign
     5699           v-default-cli-grp-node-code = integer( v-par-value )
     5700       .
     5701       run get-default-value in this-procedure (
     5702             input 'шту':U
     5703           , output v-unit-pieces
     5704       ) no-error .
     5705       if error-status :error
     5706       then do:
     5707           undo, return error "import-rcs: Не задана единица измерения для штучного товара." + chr(10) + return-value.
     5708       end.
     5709       run get-default-value in this-procedure (
     5710             input 'дро':U
     5711           , output v-unit-divisional
     5712       ) no-error .
     5713       if error-status :error
     5714       then do:
     5715           undo, return error "import-rcs: Не задана единица измерения для дробного товара." + chr(10) + return-value.
     5716       end.
     5717       run get-default-value in this-procedure (
     5718             input 'вес':U
     5719           , output v-unit-weight
     5720       ) no-error .
     5721       if error-status :error
     5722       then do:
     5723           undo, return error "import-rcs: Не задана единица измерения для весового товара." + chr(10) + return-value.
     5724       end.
     5725       run get-default-value in this-procedure (
     5726             input 'подготовка':U
     5727           , output v-par-value
     5728       ) no-error .
     5729       if error-status :error
     5730       then do:
     5731           undo, return error "import-rcs: Не задана единица измерения для штучного товара." + chr(10) + return-value.
     5732       end.
     5733       assign
     5734           v-default-wrkr = integer( v-par-value )
     5735       .
     5736       run get-default-value in this-procedure (
     5737             input 'разрешение':U
     5738           , output v-par-value
     5739       ) no-error .
     5740       if error-status :error
     5741       then do:
     5742           undo, return error "import-rcs: Не задана единица измерения для штучного товара." + chr(10) + return-value.
     5743       end.
     5744       assign
     5745           v-default-agnt = integer( v-par-value )
     5746       .
     5747       run get-default-value in this-procedure (
     5748             input 'отгрузка':U
     5749           , output v-par-value
     5750       ) no-error .
     5751       if error-status :error
     5752       then do:
     5753           undo, return error "import-rcs: Не задана единица измерения для штучного товара." + chr(10) + return-value.
     5754       end.
     5755       assign
     5756           v-default-boss = integer( v-par-value )
     5757       .
     5758       for each temp_rcs-retail1bill
     5759       :
     5760           delete temp_rcs-retail1bill.
     5761       end.
     5762       for each temp_rcs-retail1billitem
     5763       :
     5764           delete temp_rcs-retail1billitem.
     5765       end.
     5766       for each temp_rcs-retail1subject
     5767       :
     5768           delete temp_rcs-retail1subject.
     5769       end.
     5770       for each temp_rcs-retail1bank
     5771       :
     5772           delete temp_rcs-retail1bank.
     5773       end.
     5774       for each temp_rcs-retail1attr
     5775       :
     5776           delete temp_rcs-retail1attr.
     5777       end.
     5778       for each temp_rcs-retail1product
     5779       :
     5780           delete temp_rcs-retail1product.
     5781       end.
     5782       for each temp_rcs-retail1price
     5783       :
     5784           delete temp_rcs-retail1price.
     5785       end.
     5786       for each temp_rcs-retail1priceitem
     5787       :
     5788           delete temp_rcs-retail1priceitem.
     5789       end.
     5790       for each temp_rcs-retail1barcode
     5791       :
     5792           delete temp_rcs-retail1barcode.
     5793       end.
     5794       for each temp_rcs-retail1convolution
     5795       :
     5796           delete temp_rcs-retail1convolution.
     5797       end.
     5798       run write-to-log-editor( p-ed, 1, "Импорт из файлов:" ).
     5799       assign
     5800           v-import-record-count   = 0
     5801       .
     5802       input stream dirstream from os-dir( p-dir ).
     5803       read-file:
     5804       repeat
     5805       :
     5806           find first temp_file no-error.
     5807           if not available temp_file
     5808           then do:
     5809               create temp_file.
     5810           end.
     5811           import stream dirstream temp_file.
     5812           if temp_file.type = "F":U
     5813           then do:
     5814               define variable v-new-filename-full     as character         no-undo.
     5815               run write-to-log-editor( p-ed, 4, temp_file.name ).
     5816               process events.
     5817               assign
     5818                   v-selected-object-start = no
     5819               .
     5820               run read-file in this-procedure ( input p-fi, input p-ed, input temp_file.fullname ) no-error.
     5821               if error-status :error
     5822               then do:
     5823                   undo, return error "import-rcs: Ошибка чтения файла." + chr(10) + return-value.
     5824               end.
     5825               else do:
     5826                   run check-and-create-subdir in this-procedure ( input p-dir, input "old" ) no-error.
     5827                   if error-status :error
     5828                   then do:
     5829                       run write-to-log-editor( p-ed, 4, "Не удалось создать подкаталог OLD. Импортированный файл не будет удален." ).
     5830                       next read-file.
     5831                   end.
     5832                   run get-or-generate-filename in this-procedure (
     5833                         input p-dir + chr(92) + "old"
     5834                       , input temp_file.name
     5835                       , output v-new-filename-full
     5836                   ) no-error.
     5837                   if error-status :error
     5838                   then do:
     5839                       run write-to-log-editor( p-ed, 4, "Невозможно получить имя файла для переименования. Импортированный файл не будет удален." ).
     5840                       next read-file.
     5841                   end.
     5842                   os-rename value( temp_file.fullname ) value( v-new-filename-full ).
     5843                   if os-error <> 0
     5844                   then do:
     5845                       run write-to-log-editor( p-ed, 4, "Невозможно переименовать файл. Импортированный файл не будет удален." ).
     5846                       next read-file.
     5847                   end.
     5848               end.
     5849           end.
     5850       end.
     5851       run write-to-log-editor( p-ed, 1, "Чтение файлов завершено." ).
     5852       run adm/shattri.p (
     5853           input "get":U
     5854           ,input  '':U
     5855           ,input  0
     5856           ,input  'gds-ref':U
     5857           ,input  'dif-nam1':U
     5858           ,output v-value-character
     5859           ,output v-value-date
     5860           ,output v-value-decimal
     5861           ,output v-value-integer
     5862           ,output v-goods-parameter-dif-nam1
     5863           ,output v-param-type
     5864           ,INPUT-OUTPUT table-handle v-tth
     5865           ) no-error.
     5866       delete object v-tth.
     5867       run adm/shattri.p (
     5868           input "get":U
     5869           ,input  '':U
     5870           ,input  0
     5871           ,input  'gds-ref':U
     5872           ,input  'dif-nam2':U
     5873           ,output v-value-character
     5874           ,output v-value-date
     5875           ,output v-value-decimal
     5876           ,output v-value-integer
     5877           ,output v-goods-parameter-dif-nam2
     5878           ,output v-param-type
     5879           ,INPUT-OUTPUT table-handle v-tth
     5880           ) no-error.
     5881       delete object v-tth.
     5882       run adm/shattri.p (
     5883           input "get":U
     5884           ,input  '':U
     5885           ,input  0
     5886           ,input  'gds-ref':U
     5887           ,input  'dif-pdbc':U
     5888           ,output v-value-character
     5889           ,output v-value-date
     5890           ,output v-value-decimal
     5891           ,output v-value-integer
     5892           ,output dif-pdbc
     5893           ,output v-param-type
     5894           ,INPUT-OUTPUT table-handle v-tth
     5895           ) no-error.
     5896       delete object v-tth.
     5897       run adm/shattri.p (
     5898           input "get":U
     5899           ,input  '':U
     5900           ,input  0
     5901           ,input  'gds-ref':U
     5902           ,input  'pbc-veto':U
     5903           ,output v-value-character
     5904           ,output v-value-date
     5905           ,output v-value-decimal
     5906           ,output v-value-integer
     5907           ,output pbc-veto
     5908           ,output v-param-type
     5909           ,INPUT-OUTPUT table-handle v-tth
     5910           ) no-error.
     5911       delete object v-tth.
     5912       for each buf_rcs-destn no-lock
     5913          where buf_rcs-destn.status_ = '*'
     5914       by buf_rcs-destn.chanel
     5915       :
     5916           run write-to-log-editor( p-ed, 1, buf_rcs-destn.name ).
     5917           run create-base-record-from-temp-table in this-procedure (
     5918               input buf_rcs-destn.name
     5919               , input p-ed
     5920           ) no-error .
     5921           if error-status :error
     5922           then do:
     5923               undo, return error "Ошибка создания записи базы данных." + chr(10) + return-value.
     5924           end.
     5925       end.
     5926       if v-import-record-count = 0
     5927       then do:
     5928           run write-to-log-editor( p-ed, 1, "Не было импортировано ни одной записи." ).
     5929       end.
     5930       else do:
     5931           run write-to-log-editor( p-ed, 1, "Количество новых записей: " + string( v-import-record-count ) ).
     5932       end.
     5933       run write-to-log-editor( p-ed, 1, "Импорт завершен." ).
     5934   end.
     5935   END PROCEDURE.
     5936   PROCEDURE import-subject :
     5937   do
     5938   on error undo, return error
     5939   :
     5940   define input parameter p-firm-id    as character    no-undo.
     5941   define input parameter p-ed         as handle       no-undo.
     5942       define variable v-firm-code     as integer           no-undo.
     5943       define variable v-bank-num      as integer           no-undo.
     5944       define variable v-today         as date      no-undo.
     5945       define variable v-time          as integer   no-undo.
     5946       define buffer buf_clients                   for clients.
     5947       define buffer buf_cli-grp                   for cli-grp.
     5948       define buffer buf_firm                      for firm.
     5949       define buffer buf_fin-bank                  for fin-bank.
     5950       define buffer buf_rcs-retail1bank           for rcs-retail1bank.
     5951       define buffer buf_rcs-retail1subject        for rcs-retail1subject.
     5952       define buffer buf_temp_rcs-retail1subject   for temp_rcs-retail1subject.
     5953       define buffer buf_temp_rcs-retail1bank      for temp_rcs-retail1bank.
     5954       define buffer buf_rcs-clients               for rcs-clients.
     5955       find first buf_temp_rcs-retail1subject
     5956            where buf_temp_rcs-retail1subject.id = p-firm-id
     5957       no-error.
     5958       if not available buf_temp_rcs-retail1subject
     5959       then do:
     5960           undo, return error "import-subject: Ошибка поиска во временной таблице." + chr(10) + return-value.
     5961       end.
     5962       find first buf_rcs-retail1subject no-lock
     5963            where buf_rcs-retail1subject.id = p-firm-id
     5964       no-error.
     5965       if available buf_rcs-retail1subject
     5966       then do:
     5967           run write-to-log-editor in this-procedure (
     5968                 input p-ed
     5969               , input 1
     5970               , input "Поставщик с ID = " + p-firm-id  + " уже был импортирован."
     5971           ).
     5972       end.
     5973       else do:
     5974           find first buf_cli-grp no-lock
     5975                where buf_cli-grp.node-code = v-default-cli-grp-node-code
     5976           no-error.
     5977           if not available buf_cli-grp
     5978           then do:
     5979               undo, return error "import-subject: Ошибка поиска группы для поставщика." + chr(10) + return-value.
     5980           end.
     5981           run cur-time in this-procedure ( output v-today
     5982                                          , output v-time
     5983                                          ).
     5984           do transaction
     5985           :
     5986               run create-firm in this-procedure (
     5987                     input ""
     5988                   , input 0
     5989                   , input buf_temp_rcs-retail1subject.official_address
     5990                   , input ""
     5991                   , input ""
     5992                   , input ""
     5993                   , input ""
     5994                   , input ""
     5995                   , input ""
     5996                   , input ""
     5997                   , input 0
     5998                   , input buf_temp_rcs-retail1subject.inn
     5999                   , input ""
     6000                   , input ""
     6001                   , input ""
     6002                   , input ""
     6003                   , input ""
     6004                   , input ""
     6005                   , input ""
     6006                   , input ""
     6007                   , input 0
     6008                   , output v-firm-code
     6009               ) no-error .
     6010               if error-status :error
     6011               then do:
     6012                   undo, return error "import-subject: Ошибка создания записи фирмы поставщика." + chr(10) + return-value.
     6013               end.
     6014               run create-clients in this-procedure (
     6015                     input 'орг':U
     6016                   , input v-firm-code
     6017                   , input buf_temp_rcs-retail1subject.cname
     6018                   , input buf_cli-grp.node-code
     6019                   , input -1
     6020                   , input 0
     6021                   , input ""
     6022                   , input buf_cli-grp.node-name
     6023                   , input 0
     6024                   , input no
     6025                   , input yes
     6026                   , input no
     6027                   , input no
     6028                   , input no
     6029                   , input no
     6030                   , input no
     6031                   , input 0
     6032               ) no-error .
     6033               if error-status :error
     6034               then do:
     6035                   undo, return error "import-subject: Ошибка создания записи поставщика." + chr(10) + return-value.
     6036               end.
     6037               create buf_rcs-retail1subject.
     6038               assign
     6039                   buf_rcs-retail1subject.id                   = p-firm-id
     6040                   buf_rcs-retail1subject.obj-code             = v-firm-code
     6041                   buf_rcs-retail1subject.obj-type             = 'орг':U
     6042                   buf_rcs-retail1subject.file-name            = fi-dir-imp :screen-value in frame Dialog-Frame
     6043                   buf_rcs-retail1subject.cname                = buf_temp_rcs-retail1subject.cname
     6044                   buf_rcs-retail1subject.imp-date             = v-today
     6045                   buf_rcs-retail1subject.imp-time             = v-time
     6046                   buf_rcs-retail1subject.imp-user             = v-cntxt-userid
     6047                   buf_rcs-retail1subject.inn                  = buf_temp_rcs-retail1subject.inn
     6048                   buf_rcs-retail1subject.official_address     = buf_temp_rcs-retail1subject.official_address
     6049                   buf_rcs-retail1subject.retail_subject_type  = buf_temp_rcs-retail1subject.retail_subject_type
     6050                   v-import-record-count                       = v-import-record-count + 1
     6051               .
     6052               create buf_rcs-clients.
     6053               assign
     6054                   buf_rcs-clients.id          = p-firm-id
     6055                   buf_rcs-clients.obj-type    = 'орг':U
     6056                   buf_rcs-clients.obj-code    = v-firm-code
     6057                   buf_rcs-clients.name        = buf_temp_rcs-retail1subject.cname
     6058               .
     6059               find first buf_temp_rcs-retail1bank no-lock
     6060                    where buf_temp_rcs-retail1bank.id = buf_temp_rcs-retail1subject.bank_id
     6061               no-error .
     6062               if available buf_temp_rcs-retail1bank
     6063               then do:
     6064                   create buf_fin-bank.
     6065                   run genscode-generate-num-bank in this-procedure ( output v-bank-num ) no-error .
     6066                   if error-status :error
     6067                   then do:
     6068                       undo, return error "import-subject: Ошибка генерации уникального кода для банка." + chr(10) + return-value.
     6069                   end.
     6070                   assign
     6071                       buf_fin-bank.host-code = v-firm-code
     6072                       buf_fin-bank.code-bank = integer( buf_temp_rcs-retail1bank.bic )
     6073                   .
     6074                   create buf_rcs-retail1bank.
     6075                   assign
     6076                       buf_rcs-retail1bank.id                      = buf_temp_rcs-retail1bank.id
     6077                       buf_rcs-retail1bank.bank_address            = buf_temp_rcs-retail1bank.bank_address
     6078                       buf_rcs-retail1bank.bank_name               = buf_temp_rcs-retail1bank.bank_name
     6079                       buf_rcs-retail1bank.corresponding_account   = buf_temp_rcs-retail1bank.corresponding_account
     6080                       buf_rcs-retail1bank.bic                     = buf_temp_rcs-retail1bank.bic
     6081                       buf_rcs-retail1bank.bank-num                = v-bank-num
     6082                       buf_rcs-retail1bank.file-name               = fi-dir-imp :screen-value in frame Dialog-Frame
     6083                       buf_rcs-retail1bank.imp-date                = v-today
     6084                       buf_rcs-retail1bank.imp-time                = v-time
     6085                       buf_rcs-retail1bank.imp-user                = v-cntxt-userid
     6086                   .
     6087               end.
     6088               process events.
     6089               assign
     6090                   fi-log :screen-value in frame Dialog-Frame = "Импортирован поставщик: "
     6091                                                   + buf_temp_rcs-retail1subject.id
     6092                                                   + "   " + string( v-firm-code )
     6093                                                   + "   " + buf_temp_rcs-retail1subject.cname
     6094               .
     6095           end.
     6096       end.
     6097   end.
     6098   END PROCEDURE.
     6099   PROCEDURE init-fields :
     6100   do
     6101   on error undo, return error
     6102   :
     6103       define variable v-dir     as character         no-undo.
     6104       define buffer buf_usr-flt       for ubflt.usr-flt.
     6105       define variable v-cancel     as logical           no-undo.
     6106       define variable v-param-type                as character                no-undo.
     6107       define variable v-value-character           as character                no-undo.
     6108       define variable v-value-date                as date                     no-undo.
     6109       define variable v-value-decimal             as decimal                  no-undo.
     6110       define variable v-value-integer             as INTEGER                  no-undo.
     6111       define variable v-value-logical             AS LOGICAL                  no-undo.
     6112       define variable v-tth                       as handle                   no-undo.
     6113       find first buf_usr-flt no-lock
     6114            where buf_usr-flt.user-name    = 'все':U
     6115              and buf_usr-flt.call-point   = 'rcs-import-directory':u
     6116       no-error .
     6117       if not available buf_usr-flt
     6118       then do:
     6119           run select-dir in this-procedure (
     6120                 input 'rcs-import-directory':u
     6121               , output v-dir
     6122               , output v-cancel
     6123           ) no-error .
     6124           if error-status :error
     6125           then do:
     6126               undo, return error "init-fields: Ошибка выбора каталога." + chr(10) + return-value.
     6127           end.
     6128           if v-cancel = no
     6129           then do:
     6130               assign
     6131                   fi-dir-imp :screen-value in frame Dialog-Frame = v-dir
     6132               .
     6133           end.
     6134       end.
     6135       else do:
     6136           assign
     6137               fi-dir-imp :screen-value in frame Dialog-Frame = buf_usr-flt.Naim
     6138           .
     6139       end.
     6140       find first buf_usr-flt no-lock
     6141            where buf_usr-flt.user-name    = 'все':U
     6142              and buf_usr-flt.call-point   = 'rcs-export-directory':u
     6143       no-error .
     6144       if not available buf_usr-flt
     6145       then do:
     6146           run select-dir in this-procedure (
     6147                 input 'rcs-export-directory':u
     6148               , output v-dir
     6149               , output v-cancel
     6150           ) no-error .
     6151           if error-status :error
     6152           then do:
     6153               undo, return error "init-fields: Ошибка выбора каталога." + chr(10) + return-value.
     6154           end.
     6155           if v-cancel = no
     6156           then do:
     6157               assign
     6158                   fi-dir-exp :screen-value in frame Dialog-Frame = v-dir
     6159               .
     6160           end.
     6161       end.
     6162       else do:
     6163           assign
     6164               fi-dir-exp :screen-value in frame Dialog-Frame = buf_usr-flt.Naim
     6165           .
     6166       end.
     6167           run adm/shattri.p (
     6168               input "get":U
     6169               ,input  '':U
     6170               ,input  0
     6171               ,input  'gds-ref':U
     6172               ,input  'dif-nam1':U
     6173               ,output v-value-character
     6174               ,output v-value-date
     6175               ,output v-value-decimal
     6176               ,output v-value-integer
     6177               ,output v-goods-parameter-dif-nam1
     6178               ,output v-param-type
     6179               ,INPUT-OUTPUT table-handle v-tth
     6180               ) no-error.
     6181           delete object v-tth.
     6182           run adm/shattri.p (
     6183               input "get":U
     6184               ,input  '':U
     6185               ,input  0
     6186               ,input  'gds-ref':U
     6187               ,input  'dif-nam2':U
     6188               ,output v-value-character
     6189               ,output v-value-date
     6190               ,output v-value-decimal
     6191               ,output v-value-integer
     6192               ,output v-goods-parameter-dif-nam2
     6193               ,output v-param-type
     6194               ,INPUT-OUTPUT table-handle v-tth
     6195               ) no-error.
     6196           delete object v-tth.
     6197   end.
     6198   END PROCEDURE.
     6199   PROCEDURE objects-tuning :
     6200   do
     6201   on error undo, return error
     6202   :
     6203       run rcs/rcsimpd.w no-error .
     6204       if error-status :error
     6205       then do:
     6206           undo, return error "objects-tuning: Ошибка настройки объектов rcs." + chr(10) + return-value.
     6207       end.
     6208   end.
     6209   END PROCEDURE.
     6210   PROCEDURE read-file :
     6211   do
     6212   on error undo, return error
     6213   :
     6214   define input parameter p-fi     as handle       no-undo.
     6215   define input parameter p-ed     as handle       no-undo.
     6216   define input parameter p-filename as character    no-undo.
     6217       define variable v-xml-bufer     as character         no-undo.
     6218       define variable v-counter       as integer           no-undo.
     6219       input stream istream from value( p-filename ).
     6220       repeat :
     6221           import stream istream unformatted
     6222               v-xml-bufer
     6223           .
     6224           assign
     6225               v-counter = v-counter + 1
     6226           .
     6227           if v-selected-object-start = yes
     6228               or index( v-xml-bufer, "DESTINATION_ROID" ) <> 0
     6229           then do:
     6230               run xmlvalid in this-procedure (
     6231                   input this-procedure :handle
     6232                   , input v-xml-bufer
     6233                   , input 'fatal':u
     6234               ) no-error .
     6235               if error-status :error
     6236               then do:
     6237                   undo, return error "read-file: Ошибка импорта из файла '" + p-filename + "'" + chr(10) + return-value.
     6238               end.
     6239           end.
     6240           if v-counter mod 100 = 0
     6241           then do:
     6242               assign
     6243                   p-fi :screen-value  = "Файл: " + p-filename + ". Прочитано строк: " + string( v-counter )
     6244               .
     6245           end.
     6246       end.
     6247       input stream istream close.
     6248   end.
     6249   END PROCEDURE.
     6250   PROCEDURE select-dir :
     6251   do
     6252   on error undo, return error
     6253   :
     6254   define input parameter p-impexp-type    as character    no-undo.
     6255   define output parameter p-dir           as character    no-undo.
     6256   define output parameter p-cancel        as logical      no-undo.
     6257       define variable v-dir-type  as character    no-undo.
     6258       define variable v-can-write as logical      no-undo.
     6259       define buffer buf_usr-flt       for ubflt.usr-flt.
     6260       run gbl/dir-sel.p (
     6261                       output p-dir
     6262                     , output v-dir-type
     6263                     , output v-can-write
     6264       ) no-error .
     6265       if error-status :error
     6266       then do:
     6267           assign
     6268               p-cancel = yes
     6269           .
     6270           undo, return error "Ошибка выбора каталога импортируемых файлов." .
     6271       end.
     6272       else do:
     6273           if v-can-write = no
     6274           then do:
     6275               assign
     6276                   p-cancel = yes
     6277               .
     6278           end.
     6279           else do:
     6280               find first buf_usr-flt exclusive-lock
     6281                    where buf_usr-flt.user-name    = 'все':U
     6282                      and buf_usr-flt.call-point   = p-impexp-type
     6283               no-error .
     6284               if not available buf_usr-flt
     6285               then do:
     6286                   create buf_usr-flt.
     6287                   assign
     6288                       buf_usr-flt.user-name    = 'все':U
     6289                       buf_usr-flt.call-point   = p-impexp-type
     6290                   .
     6291               end.
     6292               assign
     6293                   buf_usr-flt.Naim = p-dir
     6294                   p-cancel = no
     6295               .
     6296           end.
     6297       end.
     6298   end.
     6299   END PROCEDURE.
     6300   PROCEDURE write-to-log-editor :
     6301   do
     6302   on error undo, return error
     6303   :
     6304     def input parameter hedt as handle no-undo.
     6305     def input parameter iloglevel as integer  no-undo.
     6306     def input parameter stowrite  as char     no-undo.
     6307       if valid-handle ( hedt )
     6308       then do:
     6309           hedt :move-to-eof().
     6310           hedt :insert-string( if ( iloglevel = 0
     6311                                or stowrite = "&dline"
     6312                                or stowrite = "&line" )
     6313                                then ""
     6314                                else cur-time-string-sec() + " "
     6315                              ).
     6316           hedt :insert-string( if stowrite = "&line"
     6317                                then fill("-", 80 )
     6318                                else if stowrite = "&dline"
     6319                                then fill("=", 80)
     6320                                else fill(" ", iloglevel) + stowrite).
     6321           hedt :insert-string(chr(10)).
     6322       end.
     6323       output to 'rcsimp.log' append.
     6324       put unformatted
     6325           skip chr(10) cur-time-string-sec() fill(" ", iloglevel) stowrite
     6326       .
     6327       output close.
     6328   end.
     6329   END PROCEDURE.
     6330   PROCEDURE import-attr :
     6331   do
     6332   on error undo, return error
     6333   :
     6334   define input parameter p-attr-id as character    no-undo.
     6335   define input parameter p-ed         as handle       no-undo.
     6336       define variable v-today         as date      no-undo.
     6337       define variable v-time          as integer   no-undo.
     6338       define variable v-firm-code     as integer   no-undo.
     6339       define variable v-root-code     as integer   no-undo.
     6340       define buffer buf_temp_rcs-retail1attr  for temp_rcs-retail1attr.
     6341       define buffer buf_rcs-retail1attr       for rcs-retail1attr.
     6342       define buffer buf_rcs-pack              for rcs-pack.
     6343       define buffer buf_rcs-mark              for rcs-mark.
     6344       define buffer buf_rcs-place             for rcs-place.
     6345       define buffer buf_rcs-country           for rcs-country.
     6346       define buffer buf_rcs-clients           for rcs-clients.
     6347       define buffer buf_rcs-city              for rcs-city.
     6348       define buffer buf_country               for country.
     6349       define buffer buf_units                 for units.
     6350       define buffer buf_clients               for clients.
     6351       define buffer buf_cli-grp               for cli-grp.
     6352       define buffer buf_firm                  for firm.
     6353       define buffer buf_gds-grp               for gds-grp.
     6354       find first buf_temp_rcs-retail1attr
     6355            where buf_temp_rcs-retail1attr.id = p-attr-id
     6356       no-error.
     6357       if not available buf_temp_rcs-retail1attr
     6358       then do:
     6359           undo, return error "import-attr: Ошибка поиска во временной таблице." + chr(10) + return-value.
     6360       end.
     6361       find first buf_rcs-retail1attr no-lock
     6362            where buf_rcs-retail1attr.id = p-attr-id
     6363       no-error.
     6364       if available buf_rcs-retail1attr
     6365       then do:
     6366           run write-to-log-editor in this-procedure (
     6367                 input p-ed
     6368               , input 1
     6369               , input "Справочник (attr) с идентификатором '" + p-attr-id + "' уже был импортирован."
     6370           ).
     6371       end.
     6372       else do:
     6373           run cur-time in this-procedure ( output v-today
     6374                                          , output v-time
     6375                                          ).
     6376           case buf_temp_rcs-retail1attr.retail_attr_type
     6377           :
     6378               when 1
     6379               then do:
     6380                   find first buf_rcs-pack no-lock
     6381                        where buf_rcs-pack.id = buf_temp_rcs-retail1attr.id
     6382                   no-error.
     6383                   if available buf_rcs-pack
     6384                   then do:
     6385                       run write-to-log-editor in this-procedure ( ed-log :handle in frame Dialog-Frame, 1, "Упаковка с идентификатором '" + p-attr-id + "' уже была импортирована." ).
     6386                   end.
     6387                   else do:
     6388                       do transaction
     6389                       :
     6390                           create buf_rcs-pack.
     6391                           assign
     6392                               buf_rcs-pack.id     = buf_temp_rcs-retail1attr.id
     6393                               buf_rcs-pack.name   = buf_temp_rcs-retail1attr.name
     6394                           .
     6395                           create buf_rcs-retail1attr.
     6396                           assign
     6397                               buf_rcs-retail1attr.id                  = buf_temp_rcs-retail1attr.id
     6398                               buf_rcs-retail1attr.retail_attr_type    = 1
     6399                               buf_rcs-retail1attr.name                = buf_temp_rcs-retail1attr.name
     6400                               buf_rcs-retail1attr.file-name           = fi-dir-imp :screen-value in frame Dialog-Frame
     6401                               buf_rcs-retail1attr.imp-date            = v-today
     6402                               buf_rcs-retail1attr.imp-time            = v-time
     6403                               buf_rcs-retail1attr.imp-user            = v-cntxt-userid
     6404                               v-import-record-count                   = v-import-record-count + 1
     6405                           .
     6406                       end.
     6407                   end.
     6408               end.
     6409               when 2
     6410               then do:
     6411                   find first buf_rcs-mark no-lock
     6412                        where buf_rcs-mark.id = buf_temp_rcs-retail1attr.id
     6413                   no-error.
     6414                   if available buf_rcs-mark
     6415                   then do:
     6416                       run write-to-log-editor in this-procedure ( ed-log :handle in frame Dialog-Frame, 1, "Маркировка с идентификатором '" + p-attr-id + "' уже была импортирована." ).
     6417                   end.
     6418                   else do:
     6419                       do transaction
     6420                       :
     6421                           create buf_rcs-mark.
     6422                           assign
     6423                               buf_rcs-mark.id     = buf_temp_rcs-retail1attr.id
     6424                               buf_rcs-mark.name   = buf_temp_rcs-retail1attr.name
     6425                           .
     6426                           create buf_rcs-retail1attr.
     6427                           assign
     6428                               buf_rcs-retail1attr.id                  = buf_temp_rcs-retail1attr.id
     6429                               buf_rcs-retail1attr.retail_attr_type    = 2
     6430                               buf_rcs-retail1attr.name                = buf_temp_rcs-retail1attr.name
     6431                               buf_rcs-retail1attr.file-name           = fi-dir-imp :screen-value in frame Dialog-Frame
     6432                               buf_rcs-retail1attr.imp-date            = v-today
     6433                               buf_rcs-retail1attr.imp-time            = v-time
     6434                               buf_rcs-retail1attr.imp-user            = v-cntxt-userid
     6435                               v-import-record-count                   = v-import-record-count + 1
     6436                           .
     6437                       end.
     6438                   end.
     6439               end.
     6440               when 3
     6441               then do:
     6442                   find first buf_rcs-place no-lock
     6443                        where buf_rcs-place.id = buf_temp_rcs-retail1attr.id
     6444                   no-error.
     6445                   if available buf_rcs-place
     6446                   then do:
     6447                       run write-to-log-editor in this-procedure ( ed-log :handle in frame Dialog-Frame, 1, "Упаковка с идентификатором '" + p-attr-id + "' уже была импортирована." ).
     6448                   end.
     6449                   else do:
     6450                       do transaction
     6451                       :
     6452                           run grplib-get-root-code ( output v-root-code ) no-error .
     6453                           if error-status :error
     6454                           then do:
     6455                               undo, return error "import-attr: Ошибка при вычислении кода корневой группы." + chr(10) + return-value.
     6456                           end.
     6457                           find first buf_gds-grp no-lock
     6458                                where buf_gds-grp.upper-code = v-root-code
     6459                                  and buf_gds-grp.node-name  = buf_temp_rcs-retail1attr.name
     6460                           no-error.
     6461                           if available buf_gds-grp
     6462                           then do:
     6463                               run write-to-log-editor in this-procedure ( ed-log :handle in frame Dialog-Frame, 1, "Группа '" + buf_temp_rcs-retail1attr.name + "' уже была импортирована." ).
     6464                           end.
     6465                           else do:
     6466                               create buf_gds-grp.
     6467                               assign
     6468                                   buf_gds-grp.node-code   = next-value (s-gds-grp, ub)
     6469                                   buf_gds-grp.upper-code  = v-root-code
     6470                                   buf_gds-grp.node-name   = buf_temp_rcs-retail1attr.name
     6471                                   buf_gds-grp.calc-method = 'Учетная':U
     6472                               .
     6473                               create buf_rcs-place.
     6474                               assign
     6475                                   buf_rcs-place.id        = buf_temp_rcs-retail1attr.id
     6476                                   buf_rcs-place.name      = buf_temp_rcs-retail1attr.name
     6477                                   buf_rcs-place.node-code = buf_gds-grp.node-code
     6478                               .
     6479                               create buf_rcs-retail1attr.
     6480                               assign
     6481                                   buf_rcs-retail1attr.id                  = buf_temp_rcs-retail1attr.id
     6482                                   buf_rcs-retail1attr.retail_attr_type    = 3
     6483                                   buf_rcs-retail1attr.name                = buf_temp_rcs-retail1attr.name
     6484                                   buf_rcs-retail1attr.file-name           = fi-dir-imp :screen-value in frame Dialog-Frame
     6485                                   buf_rcs-retail1attr.imp-date            = v-today
     6486                                   buf_rcs-retail1attr.imp-time            = v-time
     6487                                   buf_rcs-retail1attr.imp-user            = v-cntxt-userid
     6488                                   v-import-record-count                   = v-import-record-count + 1
     6489                               .
     6490                           end.
     6491                       end.
     6492                   end.
     6493               end.
     6494               when 4
     6495               then do:
     6496                   find first buf_rcs-country no-lock
     6497                        where buf_rcs-country.id = buf_temp_rcs-retail1attr.id
     6498                   no-error.
     6499                   if available buf_rcs-country
     6500                   then do:
     6501                       run write-to-log-editor in this-procedure ( ed-log :handle in frame Dialog-Frame, 1, "Страна с идентификатором '" + buf_temp_rcs-retail1attr.id + "' уже была импортирована." ).
     6502                   end.
     6503                   else do:
     6504                       do transaction
     6505                       :
     6506                           find first buf_country no-lock
     6507                                where buf_country.short-name = buf_temp_rcs-retail1attr.name
     6508                           no-error.
     6509                           create buf_rcs-country.
     6510                           assign
     6511                               buf_rcs-country.id     = buf_temp_rcs-retail1attr.id
     6512                               buf_rcs-country.name   = buf_temp_rcs-retail1attr.name
     6513                               buf_rcs-country.num-code = ( if available buf_country then buf_country.num-code else 0 )
     6514                           .
     6515                           create buf_rcs-retail1attr.
     6516                           assign
     6517                               buf_rcs-retail1attr.id                  = buf_temp_rcs-retail1attr.id
     6518                               buf_rcs-retail1attr.retail_attr_type    = 4
     6519                               buf_rcs-retail1attr.name                = buf_temp_rcs-retail1attr.name
     6520                               buf_rcs-retail1attr.file-name           = fi-dir-imp :screen-value in frame Dialog-Frame
     6521                               buf_rcs-retail1attr.imp-date            = v-today
     6522                               buf_rcs-retail1attr.imp-time            = v-time
     6523                               buf_rcs-retail1attr.imp-user            = v-cntxt-userid
     6524                               v-import-record-count                   = v-import-record-count + 1
     6525                           .
     6526                       end.
     6527                   end.
     6528               end.
     6529               when 5
     6530               then do:
     6531                   find first buf_rcs-clients no-lock
     6532                        where buf_rcs-clients.id = buf_temp_rcs-retail1attr.id
     6533                   no-error.
     6534                   if available buf_rcs-clients
     6535                   then do:
     6536                       run write-to-log-editor in this-procedure ( ed-log :handle in frame Dialog-Frame, 1, "Производитель с идентификатором '" + p-attr-id + "' уже был импортирован." ).
     6537                   end.
     6538                   else do:
     6539                       do transaction
     6540                       :
     6541                           find first buf_cli-grp no-lock
     6542                                where buf_cli-grp.node-code = 3
     6543                           no-error.
     6544                           if not available buf_cli-grp
     6545                           then do:
     6546                               undo, return error "import-attr: Ошибка поиска группы для поставщика." + chr(10) + return-value.
     6547                           end.
     6548                           run create-firm in this-procedure (
     6549                                 input ""
     6550                               , input 0
     6551                               , input ""
     6552                               , input ""
     6553                               , input ""
     6554                               , input ""
     6555                               , input ""
     6556                               , input ""
     6557                               , input ""
     6558                               , input ""
     6559                               , input 0
     6560                               , input ""
     6561                               , input ""
     6562                               , input ""
     6563                               , input ""
     6564                               , input ""
     6565                               , input ""
     6566                               , input ""
     6567                               , input ""
     6568                               , input ""
     6569                               , input 0
     6570                               , output v-firm-code
     6571                           ) no-error .
     6572                           if error-status :error
     6573                           then do:
     6574                               undo, return error "import-subject: Ошибка создания записи фирмы поставщика." + chr(10) + return-value.
     6575                           end.
     6576                           run create-clients in this-procedure (
     6577                                 input 'орг':U
     6578                               , input v-firm-code
     6579                               , input buf_temp_rcs-retail1attr.name
     6580                               , input buf_cli-grp.node-code
     6581                               , input -1
     6582                               , input 0
     6583                               , input ""
     6584                               , input buf_cli-grp.node-name
     6585                               , input 0
     6586                               , input yes
     6587                               , input no
     6588                               , input no
     6589                               , input no
     6590                               , input no
     6591                               , input no
     6592                               , input no
     6593                               , input 0
     6594                           ) no-error .
     6595                           if error-status :error
     6596                           then do:
     6597                               undo, return error "import-subject: Ошибка создания записи поставщика." + chr(10) + return-value.
     6598                           end.
     6599                           create buf_rcs-clients.
     6600                           assign
     6601                               buf_rcs-clients.id          = buf_temp_rcs-retail1attr.id
     6602                               buf_rcs-clients.name        = buf_temp_rcs-retail1attr.name
     6603                               buf_rcs-clients.obj-type    = 'орг':U
     6604                               buf_rcs-clients.obj-code    = v-firm-code
     6605                           .
     6606                           create buf_rcs-retail1attr.
     6607                           assign
     6608                               buf_rcs-retail1attr.id                  = buf_temp_rcs-retail1attr.id
     6609                               buf_rcs-retail1attr.retail_attr_type    = 5
     6610                               buf_rcs-retail1attr.name                = buf_temp_rcs-retail1attr.name
     6611                               buf_rcs-retail1attr.file-name           = fi-dir-imp :screen-value in frame Dialog-Frame
     6612                               buf_rcs-retail1attr.imp-date            = v-today
     6613                               buf_rcs-retail1attr.imp-time            = v-time
     6614                               buf_rcs-retail1attr.imp-user            = v-cntxt-userid
     6615                               v-import-record-count                   = v-import-record-count + 1
     6616                           .
     6617                       end.
     6618                   end.
     6619               end.
     6620               when 6
     6621               then do:
     6622                   find first buf_rcs-city no-lock
     6623                        where buf_rcs-city.id = buf_temp_rcs-retail1attr.id
     6624                   no-error.
     6625                   if available buf_rcs-city
     6626                   then do:
     6627                       run write-to-log-editor in this-procedure ( ed-log :handle in frame Dialog-Frame, 1, "Город с идентификатором '" + p-attr-id + "' уже был импортирован." ).
     6628                   end.
     6629                   else do:
     6630                       do transaction
     6631                       :
     6632                           create buf_rcs-city.
     6633                           assign
     6634                               buf_rcs-city.id     = buf_temp_rcs-retail1attr.id
     6635                               buf_rcs-city.name   = buf_temp_rcs-retail1attr.name
     6636                           .
     6637                           create buf_rcs-retail1attr.
     6638                           assign
     6639                               buf_rcs-retail1attr.id                  = buf_temp_rcs-retail1attr.id
     6640                               buf_rcs-retail1attr.retail_attr_type    = 6
     6641                               buf_rcs-retail1attr.name                = buf_temp_rcs-retail1attr.name
     6642                               buf_rcs-retail1attr.file-name           = fi-dir-imp :screen-value in frame Dialog-Frame
     6643                               buf_rcs-retail1attr.imp-date            = v-today
     6644                               buf_rcs-retail1attr.imp-time            = v-time
     6645                               buf_rcs-retail1attr.imp-user            = v-cntxt-userid
     6646                               v-import-record-count                   = v-import-record-count + 1
     6647                           .
     6648                       end.
     6649                   end.
     6650               end.
     6651           end case.
     6652       end.
     6653   end.
     6654   END PROCEDURE.
     6655   PROCEDURE import-product :
     6656   do
     6657   on error undo, return error
     6658   :
     6659   define input parameter p-product-id as character    no-undo.
     6660   define input parameter p-ed         as handle       no-undo.
     6661       define variable v-today         as date              no-undo.
     6662       define variable v-time          as integer           no-undo.
     6663       define variable v-host-code     as integer           no-undo.
     6664       define variable v-prod-type     as character         no-undo.
     6665       define variable v-prod-code     as integer           no-undo.
     6666       define variable v-recid         as recid             no-undo.
     6667       define variable v-country       as character         no-undo.
     6668       define variable v-gds-code      as integer           no-undo.
     6669       define variable v-grp-code      as integer           no-undo.
     6670       define variable v-full-name     as character         no-undo.
     6671       define buffer buf_temp_rcs-retail1product   for temp_rcs-retail1product.
     6672       define buffer buf_temp_rcs-retail1attr      for temp_rcs-retail1attr.
     6673       define buffer buf_rcs-retail1product        for rcs-retail1product.
     6674       define buffer buf_goods                     for goods.
     6675       define buffer buf_rcs-clients               for rcs-clients.
     6676       define buffer buf_gds-prt                   for gds-prt.
     6677       define buffer buf_gds-grp                   for gds-grp.
     6678       define buffer buf_units                     for units.
     6679       define buffer buf_rcs-place                 for rcs-place.
     6680       define buffer buf_rcs-country               for rcs-country.
     6681       define buffer buf_country                   for country.
     6682       find first buf_temp_rcs-retail1product
     6683            where buf_temp_rcs-retail1product.id = p-product-id
     6684       no-error.
     6685       if not available buf_temp_rcs-retail1product
     6686       then do:
     6687           undo, return error "import-product: Ошибка поиска во временной таблице." + chr(10) + return-value.
     6688       end.
     6689       find first buf_rcs-retail1product no-lock
     6690            where buf_rcs-retail1product.id = p-product-id
     6691       no-error.
     6692       if available buf_rcs-retail1product
     6693       then do:
     6694           run write-to-log-editor in this-procedure (
     6695                 input p-ed
     6696               , input 1
     6697               , input substitute( "Товар с идентификатором '&1' уже был импортирован. Код товара &2."
     6698                                   , p-product-id
     6699                                   , buf_rcs-retail1product.gds-code
     6700                                 )
     6701           ).
     6702       end.
     6703       run cur-time in this-procedure (
     6704             output v-today
     6705           , output v-time
     6706       ).
     6707       find first buf_rcs-clients no-lock
     6708            where buf_rcs-clients.id = buf_temp_rcs-retail1product.retail_producer_id
     6709       no-error.
     6710       if not available buf_rcs-clients
     6711       then do:
     6712           undo, return error "import-product: Не найден производитель товара с ID "
     6713                               + buf_temp_rcs-retail1product.retail_producer_id
     6714                               + chr(10) + "    ID товара: " + p-product-id
     6715                               + chr(10) + return-value
     6716           .
     6717       end.
     6718       else do:
     6719           assign
     6720               v-prod-type = buf_rcs-clients.obj-type
     6721               v-prod-code = buf_rcs-clients.obj-code
     6722           .
     6723       end.
     6724       find first buf_gds-prt no-lock
     6725            where buf_gds-prt.node-name = '_Пустая шкала':U
     6726       no-error.
     6727       if not available buf_gds-prt
     6728       then do:
     6729           undo, return error "import-product: Не найден код пустой шкалы для товара." + chr(10) + return-value.
     6730       end.
     6731       find first buf_rcs-place no-lock
     6732               where buf_rcs-place.id = buf_temp_rcs-retail1product.retail_place_id
     6733       no-error .
     6734       if not available buf_rcs-place
     6735       then do:
     6736           assign
     6737               v-grp-code = v-default-gds-grp-node-code
     6738           .
     6739       end.
     6740       else do:
     6741           find first buf_gds-grp no-lock
     6742                where buf_gds-grp.node-code = buf_rcs-place.node-code
     6743           no-error.
     6744           if not available buf_gds-grp
     6745           then do:
     6746               assign
     6747                   v-grp-code = v-default-gds-grp-node-code
     6748               .
     6749           end.
     6750           else do:
     6751               assign
     6752                   v-grp-code = buf_gds-grp.node-code
     6753               .
     6754           end.
     6755       end.
     6756       find first buf_rcs-country no-lock
     6757            where buf_rcs-country.id = buf_temp_rcs-retail1product.retail_country_id
     6758       no-error .
     6759       if not available buf_rcs-country
     6760       or buf_rcs-country.num-code = 0
     6761       then do:
     6762           assign
     6763               v-country = "XX"
     6764           .
     6765       end.
     6766       else do:
     6767           find first buf_country no-lock
     6768                   where buf_country.num-code = buf_rcs-country.num-code
     6769           no-error.
     6770           if not available buf_country
     6771           then do:
     6772               assign
     6773                   v-country = "XX"
     6774               .
     6775           end.
     6776           else do:
     6777               assign
     6778                   v-country = buf_country.alpha1
     6779               .
     6780           end.
     6781       end.
     6782       case buf_temp_rcs-retail1product.weight_flag :
     6783           when 0
     6784           then do:
     6785               find first buf_units no-lock
     6786                       where buf_units.unit-name = v-unit-pieces
     6787               no-error .
     6788           end.
     6789           when 1
     6790           then do:
     6791               find first buf_units no-lock
     6792                       where buf_units.unit-name = v-unit-divisional
     6793               no-error .
     6794           end.
     6795           when 2
     6796           then do:
     6797               find first buf_units no-lock
     6798                       where buf_units.unit-name = v-unit-weight
     6799               no-error .
     6800           end.
     6801       end case.
     6802       if not available buf_units
     6803       then do:
     6804           undo, return error "import-product: Не найдена единица измерения товара."
     6805                               + chr(10) + "    ID товара: " + p-product-id
     6806                               + chr(10) + return-value
     6807           .
     6808       end.
     6809       if buf_temp_rcs-retail1product.full_name = ""
     6810       then do:
     6811           assign
     6812               v-full-name = "без названия"
     6813           .
     6814       end.
     6815       else do:
     6816           assign
     6817               v-full-name = buf_temp_rcs-retail1product.full_name
     6818           .
     6819       end.
     6820       do transaction
     6821       :
     6822           find first buf_rcs-retail1product exclusive-lock
     6823                where buf_rcs-retail1product.id = p-product-id
     6824           no-error.
     6825           if available buf_rcs-retail1product
     6826           then do:
     6827               run write-to-log-editor in this-procedure ( ed-log :handle in frame Dialog-Frame, 1, "Товар с идентификатором '" + p-product-id + "' уже был импортирован." ).
     6828               find first buf_goods no-lock
     6829                    where buf_goods.gds-code = buf_rcs-retail1product.gds-code
     6830               no-error.
     6831               if not available buf_goods
     6832               then do:
     6833                   run write-to-log-editor in this-procedure ( ed-log :handle in frame Dialog-Frame, 1, "В базе данных не найден импортированный ранее товар с идентификатором '" + p-product-id + "'." ).
     6834                   undo, return error vss-description + "В базе данных не найден импортированный ранее товар с идентификатором '" + p-product-id + "'.".
     6835               end.
     6836               assign
     6837                   v-recid = recid( buf_goods )
     6838               .
     6839               run rcs/rcsgds.p (
     6840                     input parparentproc
     6841                   , input 'ИЗМЕНЕНИЕ':U
     6842                   , input no
     6843                   , input 0
     6844                   , input no
     6845                   , input yes
     6846                   , input no
     6847                   , input yes
     6848                   , input v-cntxt-host-code-obj
     6849                   , input v-cntxt-obj-type
     6850                   , input v-cntxt-obj-code
     6851                   , input yes
     6852                   , input 0
     6853                   , input ""
     6854                   , input buf_goods.prod-type
     6855                   , input buf_goods.prod-code
     6856                   , input buf_gds-prt.node-code
     6857                   , input v-grp-code
     6858                   , input v-full-name
     6859                   , input ""
     6860                   , input v-full-name
     6861                   , input v-full-name
     6862                   , input replace( replace( v-full-name, chr( 39 ), "" ), chr( 34 ), "" )
     6863                   , input v-country
     6864                   , input buf_goods.unit-base
     6865                   , input buf_goods.unit-base
     6866                   , input 0.0
     6867                   , input 0.0
     6868                   , input 1
     6869                   , input 1
     6870                   , input 0
     6871                   , input 0
     6872                   , input 0
     6873                   , input 0
     6874                   , input 'Группа':U
     6875                   , input 0
     6876                   , input yes
     6877                   , input 0
     6878                   , input 0
     6879                   , input ""
     6880                   , input ""
     6881                   , input ""
     6882                   , input ""
     6883                   , input ""
     6884                   , input ""
     6885                   , input 0
     6886                   , input 0
     6887                   , input ""
     6888                   , input 0.0
     6889                   , input 0
     6890                   , input 0
     6891                   , input ""
     6892                   , input ""
     6893                   , input ""
     6894                   , input 0
     6895                   , input 0
     6896                   , input ""
     6897                   , input no
     6898                   , input no
     6899                   , input no
     6900                   , input no
     6901                   , input "no"
     6902                   , input v-goods-parameter-dif-nam1
     6903                   , input v-goods-parameter-dif-nam2
     6904                   , input yes
     6905                   , input no
     6906                   , input-output v-recid
     6907                   , output v-gds-code
     6908               ) no-error .
     6909               if error-status :error
     6910               then do:
     6911                   message
     6912                     vss-workfile vss-revision vss-description
     6913                     skip "Ошибка изменения товара."
     6914                     skip return-value
     6915                     skip trim(error-status :get-message(1))
     6916                          trim(error-status :get-message(2))
     6917                          trim(error-status :get-message(3))
     6918                          trim(error-status :get-message(4))
     6919                          trim(error-status :get-message(5))
     6920                   view-as alert-box error.
     6921                   undo, return error "Ошибка создания товара в базе данных."
     6922                                       + chr(10) + "ID товара: " + p-product-id
     6923                                       + chr(10) + trim(error-status :get-message(1))
     6924                   .
     6925               end.
     6926               assign
     6927                   buf_rcs-retail1product.id                   = buf_temp_rcs-retail1product.id
     6928                   buf_rcs-retail1product.file-name            = fi-dir-imp :screen-value in frame Dialog-Frame
     6929                   buf_rcs-retail1product.full_name            = buf_temp_rcs-retail1product.full_name
     6930                   buf_rcs-retail1product.gds-code             = v-gds-code
     6931                   buf_rcs-retail1product.imp-date             = v-today
     6932                   buf_rcs-retail1product.imp-time             = v-time
     6933                   buf_rcs-retail1product.imp-user             = v-cntxt-userid
     6934                   buf_rcs-retail1product.retail_city_id       = buf_temp_rcs-retail1product.retail_city_id
     6935                   buf_rcs-retail1product.retail_country_id    = buf_temp_rcs-retail1product.retail_country_id
     6936                   buf_rcs-retail1product.retail_label_id      = buf_temp_rcs-retail1product.retail_label_id
     6937                   buf_rcs-retail1product.retail_mark_id       = buf_temp_rcs-retail1product.retail_mark_id
     6938                   buf_rcs-retail1product.retail_pack_id       = buf_temp_rcs-retail1product.retail_pack_id
     6939                   buf_rcs-retail1product.retail_place_id      = buf_temp_rcs-retail1product.retail_place_id
     6940                   buf_rcs-retail1product.retail_producer_id   = buf_temp_rcs-retail1product.retail_producer_id
     6941                   buf_rcs-retail1product.short_name           = buf_temp_rcs-retail1product.short_name
     6942                   buf_rcs-retail1product.weight_flag          = buf_temp_rcs-retail1product.weight_flag
     6943                   buf_rcs-retail1product.active               = buf_temp_rcs-retail1product.active
     6944               .
     6945               assign
     6946                   v-import-record-count                       = v-import-record-count + 1
     6947               .
     6948               assign
     6949                   fi-log :screen-value in frame Dialog-Frame = "Изменен товар: "
     6950                                                   + buf_temp_rcs-retail1product.id
     6951                                                   + "   " + string( v-gds-code )
     6952                                                   + "   " + buf_temp_rcs-retail1product.full_name
     6953               .
     6954           end.
     6955           else do:
     6956               run rcs/rcsgds.p (
     6957                     input parparentproc
     6958                   , input 'ДОБАВЛЕНИЕ':U
     6959                   , input no
     6960                   , input 0
     6961                   , input no
     6962                   , input yes
     6963                   , input no
     6964                   , input yes
     6965                   , input v-cntxt-host-code-obj
     6966                   , input v-cntxt-obj-type
     6967                   , input v-cntxt-obj-code
     6968                   , input yes
     6969                   , input 0
     6970                   , input ""
     6971                   , input v-prod-type
     6972                   , input v-prod-code
     6973                   , input buf_gds-prt.node-code
     6974                   , input v-grp-code
     6975                   , input v-full-name
     6976                   , input ""
     6977                   , input v-full-name
     6978                   , input v-full-name
     6979                   , input replace( replace( v-full-name, chr( 39 ), "" ), chr( 34 ), "" )
     6980                   , input v-country
     6981                   , input buf_units.unit-name
     6982                   , input buf_units.unit-name
     6983                   , input 0.0
     6984                   , input 0.0
     6985                   , input 1
     6986                   , input 1
     6987                   , input 0
     6988                   , input 0
     6989                   , input 0
     6990                   , input 0
     6991                   , input 'Группа':U
     6992                   , input 0
     6993                   , input yes
     6994                   , input 0
     6995                   , input 0
     6996                   , input ""
     6997                   , input ""
     6998                   , input ""
     6999                   , input ""
     7000                   , input ""
     7001                   , input ""
     7002                   , input 0
     7003                   , input 0
     7004                   , input ""
     7005                   , input 0.0
     7006                   , input 0
     7007                   , input 0
     7008                   , input ""
     7009                   , input ""
     7010                   , input ""
     7011                   , input 0
     7012                   , input 0
     7013                   , input ""
     7014                   , input no
     7015                   , input no
     7016                   , input no
     7017                   , input no
     7018                   , input "no"
     7019                   , input v-goods-parameter-dif-nam1
     7020                   , input v-goods-parameter-dif-nam2
     7021                   , input yes
     7022                   , input no
     7023                   , input-output v-recid
     7024                   , output v-gds-code
     7025               ) no-error .
     7026               if error-status :error
     7027               then do:
     7028                   message
     7029                     vss-workfile vss-revision vss-description
     7030                     skip "Ошибка создания карточки товара."
     7031                     skip return-value
     7032                     skip trim(error-status :get-message(1))
     7033                          trim(error-status :get-message(2))
     7034                          trim(error-status :get-message(3))
     7035                          trim(error-status :get-message(4))
     7036                          trim(error-status :get-message(5))
     7037                   view-as alert-box error.
     7038                   undo, return error "Ошибка создания товара в базе данных."
     7039                                       + chr(10) + "ID товара: " + p-product-id
     7040                                       + chr(10) + trim(error-status :get-message(1))
     7041                                       + chr(10) + return-value
     7042                   .
     7043               end.
     7044               else do:
     7045                   create buf_rcs-retail1product.
     7046                   assign
     7047                       buf_rcs-retail1product.id                   = buf_temp_rcs-retail1product.id
     7048                       buf_rcs-retail1product.file-name            = fi-dir-imp :screen-value in frame Dialog-Frame
     7049                       buf_rcs-retail1product.full_name            = buf_temp_rcs-retail1product.full_name
     7050                       buf_rcs-retail1product.gds-code             = v-gds-code
     7051                       buf_rcs-retail1product.imp-date             = v-today
     7052                       buf_rcs-retail1product.imp-time             = v-time
     7053                       buf_rcs-retail1product.imp-user             = v-cntxt-userid
     7054                       buf_rcs-retail1product.retail_city_id       = buf_temp_rcs-retail1product.retail_city_id
     7055                       buf_rcs-retail1product.retail_country_id    = buf_temp_rcs-retail1product.retail_country_id
     7056                       buf_rcs-retail1product.retail_label_id      = buf_temp_rcs-retail1product.retail_label_id
     7057                       buf_rcs-retail1product.retail_mark_id       = buf_temp_rcs-retail1product.retail_mark_id
     7058                       buf_rcs-retail1product.retail_pack_id       = buf_temp_rcs-retail1product.retail_pack_id
     7059                       buf_rcs-retail1product.retail_place_id      = buf_temp_rcs-retail1product.retail_place_id
     7060                       buf_rcs-retail1product.retail_producer_id   = buf_temp_rcs-retail1product.retail_producer_id
     7061                       buf_rcs-retail1product.short_name           = buf_temp_rcs-retail1product.short_name
     7062                       buf_rcs-retail1product.weight_flag          = buf_temp_rcs-retail1product.weight_flag
     7063                       buf_rcs-retail1product.active               = buf_temp_rcs-retail1product.active
     7064                   .
     7065                   assign
     7066                       v-import-record-count                       = v-import-record-count + 1
     7067                   .
     7068                   assign
     7069                       fi-log :screen-value in frame Dialog-Frame = "Импортирован товар: "
     7070                                                       + buf_temp_rcs-retail1product.id
     7071                                                       + "   " + string( v-gds-code )
     7072                                                       + "   " + buf_temp_rcs-retail1product.full_name
     7073                   .
     7074               end.
     7075           end.
     7076       end.
     7077   end.
     7078   END PROCEDURE.
     7079   PROCEDURE create-firm :
     7080   do
     7081   on error undo, return error
     7082   :
     7083   define input parameter p-city            as character    no-undo.
     7084   define input parameter p-ind             as integer      no-undo.
     7085   define input parameter p-addres1         as character    no-undo.
     7086   define input parameter p-addres2         as character    no-undo.
     7087   define input parameter p-director        as character    no-undo.
     7088   define input parameter p-gen-acct        as character    no-undo.
     7089   define input parameter p-phone           as character    no-undo.
     7090   define input parameter p-fax             as character    no-undo.
     7091   define input parameter p-engl-name       as character    no-undo.
     7092   define input parameter p-contact-psn     as character    no-undo.
     7093   define input parameter p-tobj-code       as integer      no-undo.
     7094   define input parameter p-inn             as character    no-undo.
     7095   define input parameter p-okpo            as character    no-undo.
     7096   define input parameter p-okonh           as character    no-undo.
     7097   define input parameter p-phone1-note     as character    no-undo.
     7098   define input parameter p-e-mail          as character    no-undo.
     7099   define input parameter p-post-addr1      as character    no-undo.
     7100   define input parameter p-post-addr2      as character    no-undo.
     7101   define input parameter p-telex           as character    no-undo.
     7102   define input parameter p-main-obj-type   as character    no-undo.
     7103   define input parameter p-main-obj-code   as integer      no-undo.
     7104   define output parameter p-firm-code      as integer      no-undo.
     7105       define buffer buf_firm      for firm.
     7106       run gen-b-code in this-procedure ( input 'fmgb':U, output p-firm-code) no-error .
     7107       if error-status :error
     7108       then do:
     7109           undo, return error "create-firm: Ошибка генерации уникального кода для фирмы поставщика." + chr(10) + return-value.
     7110       end.
     7111       create buf_firm.
     7112       assign
     7113           buf_firm.firm-code      = p-firm-code
     7114           buf_firm.city           = p-city
     7115           buf_firm.ind            = p-ind
     7116           buf_firm.addres1        = p-addres1
     7117           buf_firm.addres2        = p-addres2
     7118           buf_firm.director       = p-director
     7119           buf_firm.gen-acct       = p-gen-acct
     7120           buf_firm.phone          = p-phone
     7121           buf_firm.fax            = p-fax
     7122           buf_firm.engl-name      = p-engl-name
     7123           buf_firm.contact-psn    = p-contact-psn
     7124           buf_firm.tobj-code      = p-tobj-code
     7125           buf_firm.inn            = p-inn
     7126           buf_firm.okpo           = p-okpo
     7127           buf_firm.okonh          = p-okonh
     7128           buf_firm.phone1-note    = p-phone1-note
     7129           buf_firm.e-mail         = p-e-mail
     7130           buf_firm.post-addr1     = p-post-addr1
     7131           buf_firm.post-addr2     = p-post-addr2
     7132           buf_firm.telex          = p-telex
     7133       .
     7134   end.
     7135   END PROCEDURE.
     7136   PROCEDURE create-clients :
     7137   do
     7138   on error undo, return error
     7139   :
     7140   define input parameter p-obj-type  as character    no-undo.
     7141   define input parameter p-obj-code  as integer      no-undo.
     7142   define input parameter p-obj-name  as character    no-undo.
     7143   define input parameter p-grp-code  as integer      no-undo.
     7144   define input parameter p-db-num    as integer      no-undo.
     7145   define input parameter p-stts      as integer      no-undo.
     7146   define input parameter p-PS        as character    no-undo.
     7147   define input parameter p-grp-name  as character    no-undo.
     7148   define input parameter p-num_podr  as integer      no-undo.
     7149   define input parameter p-is-prod   as logical      no-undo.
     7150   define input parameter p-sup-gds   as logical      no-undo.
     7151   define input parameter p-sup-serv  as logical      no-undo.
     7152   define input parameter p-buy-gds   as logical      no-undo.
     7153   define input parameter p-buy-serv  as logical      no-undo.
     7154   define input parameter p-buy-cons  as logical      no-undo.
     7155   define input parameter p-sup-cons  as logical      no-undo.
     7156   define input parameter p-lim-kr    as decimal      no-undo.
     7157   define buffer buf_clients       for clients.
     7158       create buf_clients.
     7159       assign
     7160           buf_clients.obj-type    = p-obj-type
     7161           buf_clients.obj-code    = p-obj-code
     7162           buf_clients.obj-name    = p-obj-name
     7163           buf_clients.grp-code    = p-grp-code
     7164           buf_clients.stts        = p-stts
     7165           buf_clients.PS          = p-PS
     7166           buf_clients.grp-name    = p-grp-name
     7167           buf_clients.num_podr    = p-num_podr
     7168           buf_clients.is-prod     = p-is-prod
     7169           buf_clients.sup-gds     = p-sup-gds
     7170           buf_clients.sup-serv    = p-sup-serv
     7171           buf_clients.buy-gds     = p-buy-gds
     7172           buf_clients.buy-serv    = p-buy-serv
     7173           buf_clients.buy-cons    = p-buy-cons
     7174           buf_clients.sup-cons    = p-sup-cons
     7175           buf_clients.lim-kr      = p-lim-kr
     7176       .
     7177       if p-db-num <> -1
     7178       then do:
     7179           assign
     7180               buf_clients.db-num      = p-db-num
     7181           .
     7182       end.
     7183   end.
     7184   END PROCEDURE.
     7185   PROCEDURE import-bill :
     7186   do
     7187   on error undo, return error
     7188   :
     7189   define input parameter p-bill-id    as character    no-undo.
     7190   define input parameter p-ed         as handle       no-undo.
     7191       define variable v-today         as date           no-undo.
     7192       define variable v-time          as integer        no-undo.
     7193       define variable v-obj-type      as character      no-undo.
     7194       define variable v-obj-code      as integer        no-undo.
     7195       define variable v-host-code     as integer        no-undo.
     7196       define variable v-host-name     as character      no-undo.
     7197       define variable v-base-code     as integer        no-undo.
     7198       define variable v-down-pay      as integer        no-undo.
     7199       define variable v-doc-code      as character      no-undo.
     7200       define variable v-line-num      as integer        no-undo.
     7201       define variable v-was-moving    as logical        no-undo.
     7202       define variable v-cli-type      as character      no-undo.
     7203       define variable v-cli-code      as integer        no-undo.
     7204       define variable v-cli-name      as character      no-undo.
     7205       define variable v-base-rate     as decimal        no-undo.
     7206       define variable v-base-scale    as integer        no-undo.
     7207       define variable vss-description as character  init "import-bill: "       no-undo.
     7208       define buffer buf_temp_rcs-retail1bill      for temp_rcs-retail1bill.
     7209       define buffer buf_temp_rcs-retail1billitem  for temp_rcs-retail1billitem.
     7210       define buffer buf_rcs-retail1bill           for rcs-retail1bill.
     7211       define buffer buf_rcs-retail1billitem       for rcs-retail1billitem.
     7212       define buffer buf_rcs-retail1product        for rcs-retail1product.
     7213       define buffer buf_rcs-retail1subject        for rcs-retail1subject.
     7214       define buffer buf_pay-type                  for pay-type.
     7215       define buffer buf_trn-doc                   for trn-doc.
     7216       define buffer buf_curr-accnt                for curr-accnt.
     7217       define buffer buf_goods                     for goods.
     7218       define buffer buf_cli-gds                   for cli-gds.
     7219       find first buf_temp_rcs-retail1bill
     7220            where buf_temp_rcs-retail1bill.id = p-bill-id
     7221       no-error.
     7222       if not available buf_temp_rcs-retail1bill
     7223       then do:
     7224           undo, return error vss-description + "Ошибка поиска во временной таблице.".
     7225       end.
     7226       find first buf_rcs-retail1bill no-lock
     7227            where buf_rcs-retail1bill.id = buf_temp_rcs-retail1bill.id
     7228       no-error.
     7229       if available buf_rcs-retail1bill
     7230       then do:
     7231           run write-to-log-editor(
     7232                 input p-ed
     7233               , input 1
