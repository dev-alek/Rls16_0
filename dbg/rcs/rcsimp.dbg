     3784   define variable v-cur-rt as decimal   no-undo .
     3785   define variable v-cur-ex as decimal   no-undo .
     3786   find first buf_price-doc-forming no-lock where
     3787              recid(buf_price-doc-forming) = p-price-doc-forming-recid  no-error .
     3788              if error-status :error then return error .
     3789   find first buf_goods no-lock where
     3790              buf_goods.gds-code  = p-gds-code no-error .
     3791              if error-status :error then return error .
     3792   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3793     (input  buf_goods.gds-code
     3794     ,input  ?
     3795     ,output main-b-code
     3796     ) no-error .
     3797   run check-use-bar-code (main-b-code) no-error .
     3798   if error-status :error then return .
     3799   run create-line-pdf-mpl-lib (
     3800        input buf_price-doc-forming.plt-db-num
     3801       ,input buf_price-doc-forming.plt-id
     3802       ,input buf_price-doc-forming.pdf-db
     3803       ,input buf_price-doc-forming.pdf-id
     3804       ,input p-line-num
     3805       ,input main-b-code
     3806       ,input buf_goods.artic
     3807       ,input buf_goods.prod-type
     3808       ,input buf_goods.prod-code
     3809       ,input ""
     3810       ,input 0
     3811       ,input p-price-sale
     3812       ,input ""
     3813       ,input 0
     3814      ,input-output v-sec ) no-error .
     3815      if error-status :error  then do:
     3816        message
     3817          vss-workfile vss-revision vss-description skip
     3818          error-status :get-message(1) skip
     3819          return-value skip
     3820          "2"
     3821          view-as alert-box error
     3822        .
     3823      end.
     3824   define buffer old_price-list for ub.price-list  .
     3825   if par-pr-notls = "yes" then do:
     3826   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3827   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3828     (input  p-obj-type
     3829     ,input  p-obj-code
     3830     ,input  main-b-code
     3831     ,input  0
     3832     ,input  0
     3833     ,output v-cur-dn
     3834     ,output v-cur-pr
     3835     ,output v-cur-rt
     3836     ,output v-cur-ex
     3837     )  .
     3838   end.
     3839   if par-pr-altex = "yes" and
     3840      par-pr-notls = "yes" then do:
     3841       if v-cur-dn <> "" then do:
     3842           for each old_price-list no-lock where
     3843                    old_price-list.doc-num = v-cur-dn and
     3844                    old_price-list.artic      = buf_goods.artic and
     3845                    old_price-list.prod-type  = buf_goods.prod-type and
     3846                    old_price-list.prod-code  = buf_goods.prod-code and
     3847                    old_price-list.main-price = no,
     3848                   first buf_bar-code no-lock where
     3849                         buf_bar-code.b-code   = old_price-list.b-code and
     3850                         buf_bar-code.unit-cli <> buf_goods.unit-base
     3851                         :
     3852                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     3853                          if error-status :error then next.
     3854                    run create-line-pdf-mpl-lib (
     3855                          input buf_price-doc-forming.plt-db-num
     3856                         ,input buf_price-doc-forming.plt-id
     3857                         ,input buf_price-doc-forming.pdf-db
     3858                         ,input buf_price-doc-forming.pdf-id
     3859                         ,input p-line-num
     3860                         ,input old_price-list.b-code
     3861                         ,input buf_goods.artic
     3862                         ,input buf_goods.prod-type
     3863                         ,input buf_goods.prod-code
     3864                         ,input ""
     3865                         ,input 0
     3866                         ,input old_price-list.price-sale
     3867                         ,input ""
     3868                         ,input 0
     3869                        ,input-output v-sec ) no-error .
     3870           end.
     3871       end.
     3872   end.
     3873   if par-pr-sclex = "yes" and
     3874      par-pr-notls = "yes" then do:
