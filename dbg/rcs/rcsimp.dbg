     7488   PROCEDURE import-price :
     7489   do
     7490   on error undo, return error
     7491   :
     7492   define input parameter p-price-id as character    no-undo.
     7493   define input parameter p-ed         as handle       no-undo.
     7494       define variable v-today             as date         no-undo.
     7495       define variable v-time              as integer      no-undo.
     7496       define variable v-obj-type          as character    no-undo.
     7497       define variable v-obj-code          as integer      no-undo.
     7498       define variable v-price-doc-recid   as recid        no-undo.
     7499       define variable v-update            as logical      no-undo.
     7500       define buffer buf_temp_rcs-retail1price     for temp_rcs-retail1price.
     7501       define buffer buf_temp_rcs-retail1priceitem for temp_rcs-retail1priceitem.
     7502       define buffer buf_rcs-retail1priceitem      for rcs-retail1priceitem.
     7503       define buffer buf_rcs-retail1price          for rcs-retail1price.
     7504       define buffer buf_price-doc                 for price-doc.
     7505       find first buf_temp_rcs-retail1price
     7506            where buf_temp_rcs-retail1price.price_id = p-price-id
     7507       no-error.
     7508       if not available buf_temp_rcs-retail1price
     7509       then do:
     7510           undo, return error "import-price: Ошибка поиска во временной таблице." .
     7511       end.
     7512       find first buf_rcs-retail1price no-lock
     7513            where buf_rcs-retail1price.price_id = buf_temp_rcs-retail1price.price_id
     7514       no-error.
     7515       if available buf_rcs-retail1price
     7516       then do:
     7517           run write-to-log-editor(
     7518                 input p-ed
     7519               , input 1
     7520               , input substitute( "Переоценка &1 от &2 уже была импортирована.", buf_rcs-retail1price.doc-num, buf_rcs-retail1price.ddat  )
     7521           ).
     7522           undo, return.
     7523       end.
     7524       run cur-time in this-procedure ( output v-today
     7525                                      , output v-time
     7526                                      ).
     7527       run get-shops-type-and-code (
     7528             input buf_temp_rcs-retail1price.site_id
     7529           , output v-obj-type
     7530           , output v-obj-code
     7531       ) no-error.
     7532       if error-status :error
     7533       then do:
     7534           undo, return error "import-price: Ошибка вычисления кода объекта для документа переоценки." + chr(10) + return-value.
     7535       end.
     7536       do transaction :
     7537           run prcreate-new-price-doc in this-procedure (
     7538                 input v-cntxt-db-num
     7539               , input v-obj-type
     7540               , input v-obj-code
     7541               , input ?
     7542               , input ?
     7543               , input ?
     7544               , input ?
     7545               , output v-price-doc-recid
     7546           ) no-error.
     7547           if error-status:error
     7548           then do:
     7549               undo, return error "import-price: Не удалось создать документ переоценки." + chr(10) + return-value.
     7550           end.
     7551           find first buf_price-doc exclusive-lock
     7552                where recid( buf_price-doc ) = v-price-doc-recid
     7553           .
     7554           assign
     7555               buf_price-doc.PS = "@ Импорт RCS"
     7556           .
     7557           for each buf_temp_rcs-retail1priceitem
     7558              where buf_temp_rcs-retail1priceitem.price_id = buf_temp_rcs-retail1price.price_id
     7559           :
     7560               find first rcs-retail1product no-lock
     7561                    where rcs-retail1product.id = buf_temp_rcs-retail1priceitem.id
     7562               no-error .
     7563               if not available rcs-retail1product
     7564               then do:
     7565                   undo, return error "create-bill: Не удалось найти товар для строки прайс-листа."
     7566                                   + chr(10) + "ID товара: " + buf_temp_rcs-retail1priceitem.id
     7567                   .
     7568               end.
     7569               else do:
     7570                   run prcreate-new-price-list in this-procedure (
     7571                         input v-price-doc-recid
     7572                       , input rcs-retail1product.gds-code
     7573                       , input buf_temp_rcs-retail1priceitem.price_cost
     7574                       , output v-update
     7575                   ) no-error.
     7576                   if error-status:error
     7577                   then do:
     7578                       undo, return error substitute( "import-price: Не удалось создать строку документа переоценки для товара с кодом: &1", rcs-retail1product.gds-code ) + chr(10) + return-value.
     7579                   end.
     7580                   create buf_rcs-retail1priceitem.
     7581                   assign
     7582                       buf_rcs-retail1priceitem.id         = buf_temp_rcs-retail1priceitem.id
     7583                       buf_rcs-retail1priceitem.price_id   = buf_temp_rcs-retail1priceitem.price_id
     7584                       buf_rcs-retail1priceitem.price_cost = buf_temp_rcs-retail1priceitem.price_cost
     7585                       buf_rcs-retail1priceitem.active     = buf_temp_rcs-retail1priceitem.active
     7586                       buf_rcs-retail1priceitem.file-name  = fi-dir-imp :screen-value in frame Dialog-Frame
     7587                       buf_rcs-retail1priceitem.imp-date   = v-today
     7588                       buf_rcs-retail1priceitem.imp-time   = v-time
     7589                       buf_rcs-retail1priceitem.imp-user   = v-cntxt-userid
     7590                   .
     7591               end.
     7592           end.
     7593           create buf_rcs-retail1price.
     7594           assign
     7595               buf_rcs-retail1price.price_id   = buf_temp_rcs-retail1price.price_id
     7596               buf_rcs-retail1price.site_id    = buf_temp_rcs-retail1price.site_id
     7597               buf_rcs-retail1price.ddat       = buf_temp_rcs-retail1price.ddat
     7598               buf_rcs-retail1price.corr       = buf_temp_rcs-retail1price.corr
     7599               buf_rcs-retail1price.stad       = buf_temp_rcs-retail1price.stad
     7600               buf_rcs-retail1price.doc-mode   = buf_temp_rcs-retail1price.doc-mode
     7601               buf_rcs-retail1price.doc_type   = buf_temp_rcs-retail1price.doc_type
     7602               buf_rcs-retail1price.doc-num    = buf_price-doc.doc-num
     7603               buf_rcs-retail1price.obj-type   = buf_price-doc.obj-type
     7604               buf_rcs-retail1price.obj-code   = buf_price-doc.obj-code
     7605               buf_rcs-retail1price.file-name  = fi-dir-imp :screen-value in frame Dialog-Frame
     7606               buf_rcs-retail1price.imp-date   = v-today
     7607               buf_rcs-retail1price.imp-time   = v-time
     7608               buf_rcs-retail1price.imp-user   = v-cntxt-userid
     7609           .
     7610       end.
     7611       assign
     7612           v-import-record-count                       = v-import-record-count + 1
     7613       .
     7614       assign
     7615           fi-log :screen-value in frame Dialog-Frame = "Закачана переоценка: ID = " + buf_rcs-retail1price.price_id
     7616                                           + "  DDAT = " + string( buf_rcs-retail1price.ddat )
     7617                                           + "  DOCNUM = " + string( buf_rcs-retail1price.doc-num )
     7618       .
     7619   end.
     7620   END PROCEDURE.
     7621   PROCEDURE get-default-value :
     7622   do
     7623   on error undo, return error
     7624   :
     7625   define input parameter p-value-type as character    no-undo.
     7626   define output parameter p-value     as character    no-undo.
     7627   define buffer buf_usr-flt   for ubflt.usr-flt.
     7628       find first buf_usr-flt no-lock
     7629            where buf_usr-flt.user-name    = 'все':U
     7630              and buf_usr-flt.call-point   = p-value-type
     7631       no-error .
     7632       if not available buf_usr-flt
     7633       then do:
     7634           undo, return error "get-default-value: Ошибка получения значения по умолчанию.".
     7635       end.
     7636       else do:
     7637           assign
     7638               p-value = buf_usr-flt.Naim
     7639           .
     7640       end.
     7641   end.
     7642   END PROCEDURE.
     7643   PROCEDURE import-barcode :
     7644   do
     7645   on error undo, return error
     7646   :
     7647   define input parameter p-barcode-id as character    no-undo.
     7648   define input parameter p-ed         as handle       no-undo.
     7649       define variable v-unit-name     as character        no-undo.
     7650       define variable v-today         as date             no-undo.
     7651       define variable v-time          as integer          no-undo.
     7652       define variable v-go-next       as logical  init no no-undo.
     7653       define variable l-is-weight as logical no-undo .
     7654       define variable l-is-pgweight as logical no-undo .
     7655       define variable l-is-petrolium as logical no-undo .
     7656       define buffer buf_temp_rcs-retail1barcode   for temp_rcs-retail1barcode.
     7657       define buffer buf_rcs-retail1product        for rcs-retail1product.
     7658       define buffer buf_rcs-retail1barcode        for rcs-retail1barcode.
     7659       define buffer buf_prod-bc                   for prod-bc.
     7660       define buffer buf_goods                     for goods.
     7661       define buffer buf_gds-prt                   for gds-prt.
     7662       find first buf_temp_rcs-retail1barcode
     7663            where buf_temp_rcs-retail1barcode.id = p-barcode-id
     7664       no-error.
     7665       if not available buf_temp_rcs-retail1barcode
     7666       then do:
     7667           undo, return error "import-barcode: Ошибка поиска во временной таблице." .
     7668       end.
     7669       find first buf_rcs-retail1product no-lock
     7670            where buf_rcs-retail1product.id = buf_temp_rcs-retail1barcode.retail_product_id
     7671       no-error.
     7672       if not available buf_rcs-retail1product
     7673       then do:
     7674           undo, return error "import-barcode: Не был закачан товар для привязки бар-кода." .
     7675       end.
     7676       else do:
     7677           find first buf_prod-bc no-lock
     7678                where buf_prod-bc.b-str = buf_temp_rcs-retail1barcode.barcode
     7679           no-error.
     7680           if available buf_prod-bc
     7681           then do:
     7682               run write-to-log-editor( p-ed, 5, "import-barcode: Бар-код с ID '" + p-barcode-id + "' ( barcode = '" + buf_temp_rcs-retail1barcode.barcode + "' ) уже есть в базе данных." ).
     7683               assign
     7684                   v-go-next = yes
     7685               .
     7686           end.
     7687           else do:
     7688               find first buf_goods no-lock
     7689                    where buf_goods.gds-code = buf_rcs-retail1product.gds-code
     7690               no-error.
     7691               if not available buf_goods
     7692               then do:
     7693                   undo, return error "import-barcode: Нет закачанного товара для привязки бар-кода." .
     7694               end.
     7695               else do:
     7696                   find first buf_gds-prt no-lock
     7697                        where buf_gds-prt.upper-code = buf_goods.prt-root
     7698                   no-error .
     7699                   if not available buf_gds-prt
     7700                   then do:
     7701                       undo, return error "import-barcode: В карточке товара неверно задан код шкалы."
     7702                                       + chr(10) + "Артикул товара: " + string( buf_goods.artic )
     7703                                       + chr(10) + "Производитель : " + string( buf_goods.prod-type )
     7704                                       + chr(10) + "                " + string( buf_goods.prod-code )
     7705                       .
     7706                   end.
     7707                   else do:
     7708                       case buf_rcs-retail1product.weight_flag
     7709                       :
     7710                           when 0
     7711                           then do:
     7712                               assign
     7713                                   v-unit-name = v-unit-pieces
     7714                               .
     7715                           end.
     7716                           when 1
     7717                           then do:
     7718                               assign
     7719                                   v-unit-name = v-unit-divisional
     7720                               .
     7721                           end.
     7722                           when 2
     7723                           then do:
     7724                               assign
     7725                                   v-unit-name = v-unit-weight
     7726                               .
     7727                           end.
     7728                           otherwise do:
     7729                               undo, return error "import-barcode: Товар с ID '" + buf_rcs-retail1product.id + "был импортирован с неверным значением единицы измерения".
     7730                           end.
     7731                       end case.
     7732                       if v-unit-name <> buf_goods.unit-base
     7733                       then do:
     7734                           undo, return error "import-barcode: Единица измерения для бар-кода не соответствует импортируемой для товара с ID '" + buf_rcs-retail1product.id + "' ( кодом '" + string( buf_rcs-retail1product.gds-code ) + "' ) ".
     7735                       end.
     7736                   end.
     7737               end.
     7738           end.
     7739       end.
     7740       if v-go-next = no
     7741       then do:
     7742   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7743   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbctv in g#library
     7744     (input buf_temp_rcs-retail1barcode.barcode
     7745     ,input  buf_goods.unit-base
     7746     ,input  buf_goods.unit-base
     7747     ,input  'weight=request':u
     7748     ,output l-is-weight
     7749     )  .
     7750   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7751   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbctv in g#library
     7752     (input buf_temp_rcs-retail1barcode.barcode
     7753     ,input  buf_goods.unit-base
     7754     ,input  buf_goods.unit-base
     7755     ,input  'pgweight=request':u
     7756     ,output l-is-pgweight
     7757     )  .
     7758   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7759   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbctv in g#library
     7760     (input buf_temp_rcs-retail1barcode.barcode
     7761     ,input  buf_goods.unit-base
     7762     ,input  buf_goods.unit-base
     7763     ,input  'petrolium=request':u
     7764     ,output l-is-petrolium
     7765     )  .
     7766           if (l-is-weight
     7767           or l-is-pgweight
     7768           or l-is-petrolium
     7769           ) then do:
     7770             undo, return error "import-barcode: Невоможно импортировать весовой или топливный бар-код для товара с ID '" + buf_rcs-retail1product.id + "' ( кодом '" + string( buf_rcs-retail1product.gds-code ) + "' ) ".
     7771           end.
     7772           run cur-time in this-procedure (
     7773                 output v-today
     7774               , output v-time
     7775           ).
     7776           do transaction :
     7777             define variable v-b-str as character no-undo .
     7778             define variable rid as recid no-undo .
     7779             v-b-str = buf_temp_rcs-retail1barcode.barcode.
     7780             rid = ?.
     7781             run trg/prod-bc1.p (
     7782                                 input  parparentproc
     7783                                 ,input yes
     7784                                 ,input dif-pdbc
     7785                                 ,input pbc-veto
     7786                                 ,input no
     7787                                 ,input ''
     7788                                 ,input ""
     7789                                 ,buffer buf_goods
     7790                                 ,input buf_rcs-retail1product.gds-code
     7791                                 ,input-output v-b-str
     7792                                 ,output rid
     7793                                 ) no-error.
     7794              if error-status :error then do:
     7795                undo, return error "import-barcode: Ошибка при  импорте бар-кода для товара с ID '" + buf_rcs-retail1product.id + "' ( кодом '" + string( buf_rcs-retail1product.gds-code ) + "' ) ".
     7796              end.
     7797              else if rid = ? then do:
     7798                undo, return error "import-barcode: Невоможно импортировать бар-код для товара с ID '" + buf_rcs-retail1product.id + "' ( кодом '" + string( buf_rcs-retail1product.gds-code ) + "' ) ".
     7799              end.
     7800               create buf_rcs-retail1barcode.
     7801               assign
     7802                   buf_rcs-retail1barcode.id                   = buf_temp_rcs-retail1barcode.id
     7803                   buf_rcs-retail1barcode.barcode              = buf_temp_rcs-retail1barcode.barcode
     7804                   buf_rcs-retail1barcode.retail_product_id    = buf_temp_rcs-retail1barcode.retail_product_id
     7805                   buf_rcs-retail1barcode.b-code               = buf_goods.gds-code
     7806                   buf_rcs-retail1barcode.b-str                = buf_temp_rcs-retail1barcode.barcode
     7807                   buf_rcs-retail1barcode.file-name            = fi-dir-imp :screen-value in frame Dialog-Frame
     7808                   buf_rcs-retail1barcode.imp-date             = v-today
     7809                   buf_rcs-retail1barcode.imp-time             = v-time
     7810                   buf_rcs-retail1barcode.imp-user             = v-cntxt-userid
     7811               .
     7812           end.
     7813           assign
     7814               v-import-record-count                       = v-import-record-count + 1
     7815           .
     7816           assign
     7817               fi-log :screen-value in frame Dialog-Frame = "Закачан бар-код: ID = " + buf_rcs-retail1barcode.id
     7818                                               + "  BARCODE = " + string( buf_temp_rcs-retail1barcode.barcode )
     7819           .
     7820       end.
     7821   end.
     7822   END PROCEDURE.
     7823   PROCEDURE get-shops-id :
     7824   do
     7825   on error undo, return error
     7826   :
     7827   define input parameter p-shops-obj-type as character    no-undo.
     7828   define input parameter p-shops-obj-code as integer      no-undo.
     7829   define output parameter p-shops-id      as character    no-undo.
     7830       define buffer buf_rcs-shops     for rcs-shops.
     7831       find first buf_rcs-shops no-lock
     7832            where buf_rcs-shops.obj-type = p-shops-obj-type
     7833              and buf_rcs-shops.obj-code = p-shops-obj-code
     7834       no-error.
     7835       if not available buf_rcs-shops
     7836       then do:
     7837           undo, return error "get-shops-id: Не найден ID объекта."
     7838                   + chr(10) + "Тип объекта: " + p-shops-obj-type
     7839                   + chr(10) + "Код объекта: " + string( p-shops-obj-code )
     7840           .
     7841       end.
     7842       else do:
     7843           assign
     7844               p-shops-id = buf_rcs-shops.id
     7845           .
     7846       end.
     7847   end.
     7848   END PROCEDURE.
     7849   PROCEDURE check-and-create-subdir :
     7850   do
     7851   on error undo, return error
     7852   :
     7853   define input parameter p-parent-dir as character    no-undo.
     7854   define input parameter p-subdir     as character    no-undo.
     7855       define variable v-dir-exists     as logical init no   no-undo.
     7856       find first temp_dir no-error.
     7857       if not available temp_dir
     7858       then do:
     7859           create temp_dir.
     7860       end.
     7861       input from os-dir( p-parent-dir ).
     7862       search-dir:
     7863       repeat
     7864       :
     7865           import temp_dir.
     7866           if temp_dir.type = "D"
     7867           then do:
     7868               if caps( temp_file.name ) = "OLD"
     7869               then do:
     7870                   assign
     7871                       v-dir-exists = yes
     7872                   .
     7873                   leave search-dir.
     7874               end.
     7875               else do:
     7876                   assign
     7877                       v-dir-exists = no
     7878                   .
     7879               end.
     7880           end.
     7881       end.
     7882       input close.
     7883       if v-dir-exists = no
     7884       then do:
     7885           os-create-dir value( p-parent-dir + chr(92) + p-subdir ) .
     7886           if os-error <> 0
     7887           then do:
     7888               undo, return error "Ошибка создания подкаталога OLD".
     7889           end.
     7890       end.
     7891   end.
     7892   END PROCEDURE.
     7893   PROCEDURE get-or-generate-filename :
     7894   do
     7895   on error undo, return error
     7896   :
     7897   define input parameter p-dir            as character    no-undo.
     7898   define input parameter p-filename       as character    no-undo.
     7899   define output parameter p-full-filename as character    no-undo.
     7900       define variable v-counter       as integer          no-undo.
     7901       assign
     7902           v-counter = 0
     7903           p-full-filename = p-dir + chr(92) + p-filename
     7904       .
     7905       if search ( p-full-filename ) <> ?
     7906       then do:
     7907           generate-filename:
     7908           do while true
     7909           :
     7910               assign
     7911                   v-counter = v-counter + 1
     7912                   p-full-filename = p-dir + chr(92) + entry( 1, p-filename, "." )   + string( v-counter )
     7913                                           + ( if num-entries( p-filename, "." ) > 1 then entry( 2, p-filename, "." ) else "." )
     7914               .
     7915               if search ( p-full-filename ) = ?
     7916               then do:
     7917                   leave generate-filename.
     7918               end.
     7919           end.
     7920       end.
     7921   end.
     7922   END PROCEDURE.
     7923   PROCEDURE delete-record :
     7924   do
     7925   on error undo, return error
     7926   :
     7927   define input parameter p-name   as character    no-undo.
     7928   define input parameter p-id     as character    no-undo.
     7929   define variable v-today as date      no-undo.
     7930   define variable v-time  as integer   no-undo.
     7931   define variable vss-description as character init "delete-record: " no-undo.
     7932   define buffer buf_bar-code              for bar-code.
     7933   define buffer buf_prod-bc               for prod-bc.
     7934   define buffer buf_rcs-retail1barcode    for rcs-retail1barcode.
     7935   define buffer buf_rcs-retail1delete     for rcs-retail1delete.
     7936   case p-name
     7937   :
     7938       when "RETAIL1_BARCODE"
     7939       then do:
     7940           find first buf_rcs-retail1barcode no-lock
     7941                where buf_rcs-retail1barcode.id = p-id
     7942           no-error.
     7943           if not available buf_rcs-retail1barcode
     7944           then do:
     7945               undo, return error vss-description + "Попытка удалить не импортированный бар-код.".
     7946           end.
     7947           find first buf_bar-code no-lock
     7948                where buf_bar-code.b-code = buf_rcs-retail1barcode.b-code
     7949           no-error.
     7950           if not available buf_bar-code
     7951           then do:
     7952               undo, return error vss-description + "Не найден основной бар-код товара.".
     7953           end.
     7954           run cur-time in this-procedure ( output v-today
     7955                                          , output v-time
     7956                                          ).
     7957           do transaction :
     7958               find first buf_prod-bc exclusive-lock
     7959                    where buf_prod-bc.b-code           = buf_bar-code.b-code
     7960                      and buf_prod-bc.b-str            = buf_rcs-retail1barcode.b-str
     7961               no-error.
     7962               if error-status :error
     7963               then do:
     7964                   undo, return error vss-description + "Не найден дополнительный бар-код товара.".
     7965               end.
     7966               delete buf_prod-bc.
     7967               create buf_rcs-retail1delete.
     7968               assign
     7969                   buf_rcs-retail1delete.id            = p-id
     7970                   buf_rcs-retail1delete.name          = p-name
     7971                   buf_rcs-retail1delete.file-name     = fi-dir-imp :screen-value in frame Dialog-Frame
     7972                   buf_rcs-retail1delete.imp-date      = v-today
     7973                   buf_rcs-retail1delete.imp-time      = v-time
     7974                   buf_rcs-retail1delete.imp-user      = v-cntxt-userid
     7975               .
     7976           end.
     7977           assign
     7978               v-import-record-count                       = v-import-record-count + 1
     7979           .
     7980           assign
     7981               fi-log :screen-value in frame Dialog-Frame = "Удален бар-код: ID = " + buf_rcs-retail1delete.id
     7982                                               + "  BARCODE = " + string( buf_rcs-retail1barcode.b-str )
     7983           .
     7984       end.
     7985       otherwise do:
     7986           undo, return error vss-description + "Не определено удаление для заданной записи.".
     7987       end.
     7988   end case.
     7989   end.
     7990   END PROCEDURE.
     7991   procedure genscode-generate-num-bank :
     7992   do
     7993   on error undo, return error
     7994   :
     7995   define output parameter p-bank-num as integer no-undo.
     7996   assign
     7997       p-bank-num = next-value( s-bank, ub )
     7998   .
     7999   end.
     8000   end procedure.
