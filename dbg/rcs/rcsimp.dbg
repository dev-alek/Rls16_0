     4122   DEFINE VARIABLE ed-log AS CHARACTER
     4123        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL LARGE
     4124        SIZE 97 BY 15.92 NO-UNDO.
     4125   DEFINE VARIABLE fi-dir-exp AS CHARACTER FORMAT "X(256)":U
