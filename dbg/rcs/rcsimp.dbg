     4134   DEFINE FRAME Dialog-Frame
     4135        b-exit AT ROW 1.17 COL 2
     4136        bt-config AT ROW 1.17 COL 12
     4137        bt-import AT ROW 1.17 COL 40
     4138        bt-export AT ROW 1.17 COL 51
     4139        b-help AT ROW 1.17 COL 89
     4140        fi-dir-imp AT ROW 2.38 COL 13.13 NO-LABEL
     4141        fi-dir-exp AT ROW 2.38 COL 63.5 NO-LABEL
     4142        fi-log AT ROW 3.5 COL 2 NO-LABEL
     4143        ed-log AT ROW 4.67 COL 2 NO-LABEL
     4144        "Импорт из:" VIEW-AS TEXT
     4145             SIZE 10.88 BY 1.08 AT ROW 2.29 COL 2.25
     4146        "Экспорт в:" VIEW-AS TEXT
     4147             SIZE 11.5 BY 1.08 AT ROW 2.29 COL 51.88
     4148        SPACE(36.49) SKIP(17.41)
     4149       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     4150            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     4151            TITLE "Обмен данными с РКС".
     4152   ASSIGN
     4153          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     4154          FRAME Dialog-Frame:HIDDEN           = TRUE.
     4155   ASSIGN
     4156          ed-log:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     4157   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     4158   DO:
     4159     APPLY "END-ERROR":U TO SELF.
     4160   END.
     4161   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     4162   DO:
     4163       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
     4164   END.
     4165   ON CHOOSE OF bt-config IN FRAME Dialog-Frame
     4166   DO:
     4167       run rcs/rcsconf.w (
     4168           input parparentproc
     4169       ) no-error.
     4170       if error-status :error
     4171       then do:
     4172           message
     4173           vss-workfile vss-revision vss-description
     4174           skip "Ошибка при изменении параметров обмена данными с системой RCS."
     4175           skip return-value
     4176           skip trim(error-status :get-message(1))
     4177           trim(error-status :get-message(2))
     4178           trim(error-status :get-message(3))
     4179           view-as alert-box error.
     4180           undo, return no-apply .
     4181       end.
     4182       run init-fields in this-procedure no-error .
     4183       if error-status :error
     4184       then do:
     4185           message
     4186             vss-workfile vss-revision vss-description
     4187             skip "Ошибка присвоения начальных значений полей формы."
     4188             skip return-value
     4189             skip trim(error-status :get-message(1))
     4190                  trim(error-status :get-message(2))
     4191                  trim(error-status :get-message(3))
     4192                  trim(error-status :get-message(4))
     4193                  trim(error-status :get-message(5))
     4194           view-as alert-box error.
     4195           undo, return no-apply .
     4196       end.
     4197   END.
     4198   ON CHOOSE OF bt-export IN FRAME Dialog-Frame
     4199   DO:
     4200       run export-rcs in this-procedure (
     4201             input fi-log :handle
     4202           , input ed-log :handle
     4203           , input fi-dir-exp :screen-value
     4204       ) no-error .
     4205       if error-status :error
     4206       then do:
     4207           message
     4208           vss-workfile vss-revision vss-description
     4209           skip "Ошибка экспорта."
     4210           skip return-value
     4211           skip trim(error-status :get-message(1))
     4212           trim(error-status :get-message(2))
     4213           trim(error-status :get-message(3))
     4214           trim(error-status :get-message(4))
     4215           trim(error-status :get-message(5))
     4216           view-as alert-box error.
     4217           undo, return no-apply .
     4218       end.
     4219   END.
     4220   ON CHOOSE OF bt-import IN FRAME Dialog-Frame
     4221   DO:
     4222       run import-rcs in this-procedure (
     4223             input fi-log :handle
     4224           , input ed-log :handle
     4225           , input fi-dir-imp :screen-value
     4226       ) no-error .
     4227       if error-status :error
     4228       then do:
     4229           message
     4230           vss-workfile vss-revision vss-description
     4231           skip "Ошибка импорта."
     4232           skip return-value
     4233           skip trim( error-status :get-message( 1 ) )
     4234           trim( error-status :get-message( 2 ) )
     4235           trim( error-status :get-message( 3 ) )
     4236           view-as alert-box error.
     4237           run write-to-log-editor(
     4238                 input ed-log :handle
     4239               , input 1
     4240               , input substitute( "Ошибка импорта. &1. &2."
     4241                                           , return-value
     4242                                           , trim( error-status :get-message( 1 ) )
     4243                                 )
     4244           ).
     4245           undo, return no-apply .
     4246       end.
     4247   END.
     4248   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4249   on help of frame Dialog-Frame
     4250   do:
     4251     run gbl/app_help.p
     4252       (input this-procedure :file-name
     4253       ,input ''
     4254       ,input ?
     4255       ) no-error.
     4256     if error-status :error then do:
     4257       message
     4258         "Ошибка при вызове помощи"
     4259         error-status :get-message(1)
     4260         view-as alert-box .
     4261     end.
     4262   end.
     4263   run minbtn-set in this-procedure .
     4264   on choose of b-help in frame Dialog-Frame
     4265   do:
     4266     apply "help":u to frame Dialog-Frame .
     4267   end.
     4268   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4269   procedure minbtn-set :
     4270       do
     4271           on error undo, return error return-value
     4272           :
     4273           define variable ii              as integer       no-undo .
     4274           define variable fh              as widget-handle no-undo .
     4275           define variable hh              as widget-handle no-undo .
     4276           define variable v-h             as handle        extent 4 no-undo .
     4277           define variable v-name-button   as character     no-undo .
     4278           define variable v-help-old-x    as decimal       no-undo .
     4279           define variable v-help-old-y    as decimal       no-undo .
     4280           define variable v-help-old-size as decimal       no-undo .
     4281           define variable v-frame-width   as decimal       no-undo .
     4282           define variable jj              as integer       no-undo .
     4283           do
     4284               on error undo, return error
     4285               :
     4286               assign
     4287                   v-frame-width = frame Dialog-Frame:width - 0.3
     4288                   fh            = frame Dialog-Frame:first-child
     4289                   hh            = fh:first-child
     4290                   ii            = 1
     4291                   .
     4292               do while valid-handle(hh):
     4293                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     4294                   do:
     4295                       case lc(hh:name) :
     4296                           when "b-help" then
     4297                               do:
     4298                                   hh:load-image-up("cmp/b-help.bmp":u) .
     4299                                   hh:load-image-down("cmp/b-help.bmp":u) .
     4300                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     4301                                   hh:TOOLTIP = "Помощь" .
     4302                                   v-help-old-x = hh:column .
     4303                                   v-help-old-y = hh:row    .
     4304                                   v-help-old-size = hh:width .
     4305                                   hh:width-chars = 2.5 .
     4306                               end.
     4307                           when "b-print" then
     4308                               do:
     4309                                   hh:load-image("cmp/b-print.bmp":u) .
     4310                                   hh:TOOLTIP = "Печать" .
     4311                                   v-h[ii] = hh:handle .
     4312                                   ii = ii + 1 .
     4313                                   hh:width-chars = 3 .
     4314                               end.
     4315                           when "b-history" or
     4316                           when "b-hist" then
     4317                               do:
     4318                                   hh:load-image("cmp/b-hist.bmp":u) .
     4319                                   hh:TOOLTIP = "История" .
     4320                                   v-h[ii] = hh:handle .
     4321                                   ii = ii + 1 .
     4322                                   hh:width-chars = 3 .
     4323                               end.
     4324                           when "b-sch" then
     4325                               do:
     4326                                   hh:load-image("cmp/b-sch.bmp":u) .
     4327                                   hh:TOOLTIP = "Установка Фильтра" .
     4328                                   v-h[ii] = hh:handle .
     4329                                   ii = ii + 1 .
     4330                                   hh:width-chars = 3 .
     4331                               end.
     4332                           when "b-hist-user" then
     4333                               do:
     4334                                   hh:load-image("cmp/b-hist.bmp":u) .
     4335                                   hh:TOOLTIP = "История пользователя" .
     4336                                   ii = ii + 1 .
     4337                               end.
     4338                       end case.
     4339                   end.
     4340                   hh = hh:next-sibling.
     4341               end.
     4342               b-help:column = v-frame-width - b-help:width-chars.
     4343               jj = 0.
     4344               repeat ii = 4 to 1 by -1 :
     4345                   if valid-handle (v-h[ii] ) then
     4346                   do:
     4347                       jj  = jj + 1 .
     4348                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     4349                       v-h[ii]:row    = v-help-old-y .
     4350                   end.
     4351               end.
     4352           end.
     4353       end.
     4354   end procedure.
     4355   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     4356   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     4357   MAIN-BLOCK:
     4358   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4359      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4360   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4361     run mainmenu_getcntxt in parparentproc
     4362       (output v-cntxt-db-num
     4363       ,output v-cntxt-userid
     4364       ,output v-cntxt-level
     4365       ,output v-cntxt-host-code-obj
     4366       ,output v-cntxt-obj-type
     4367       ,output v-cntxt-obj-code
     4368       ,output v-cntxt-db-num-obj
     4369       ,output v-cntxt-is-admin
     4370       ) .
     4371   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4372     run mainmenu_getcntxt in parparentproc
     4373       (output v-cntxp-db-num
     4374       ,output v-cntxp-userid
     4375       ,output v-cntxp-level
     4376       ,output v-cntxp-curr-host-code
     4377       ,output v-cntxp-obj-type
     4378       ,output v-cntxp-obj-code
     4379       ,output v-cntxp-db-num-obj
     4380       ,output v-cntxp-is-admin
     4381       ) .
     4382     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
     4383        v-cntxp-obj-code <> 0 then do:
     4384   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4385     (input  'is-prt'
     4386     ,input  0
     4387     ,input  ''
     4388     ,input  0
     4389     ,input  ''
     4390     ,input  ''
     4391     ,input  ''
     4392     ,input  yes
     4393     ,output v-cntxp-conf-par
     4394     ,output v-cntxp-par-type
     4395     ) no-error .
     4396       case v-cntxp-obj-type :
     4397         when 'скл':U then do:
     4398           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
     4399           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
     4400           assign
     4401             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
     4402             v-cntxp-price-calc      = bf-cntxp_store.price-calc
     4403             v-cntxp-inout-price     = bf-cntxp_store.inout-price
     4404             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
     4405             v-cntxp-out-rate        = bf-cntxp_store.out-rate
     4406             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
     4407             v-cntxp-in-ov           = bf-cntxp_store.in-ov
     4408             v-cntxp-in-perm         = bf-cntxp_store.in-perm
     4409             v-cntxp-no-eq           = bf-cntxp_store.no-eq
     4410             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
     4411             v-cntxp-load-time       = bf-cntxp_store.load-time
     4412             v-cntxp-holidays        = bf-cntxp_store.holidays
     4413             v-cntxp-in-pay          = bf-cntxp_store.in-pay
     4414             v-cntxp-out-pay         = bf-cntxp_store.out-pay
     4415             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
     4416             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
     4417             v-cntxp-down-pay        = bf-cntxp_store.down-pay
     4418             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
     4419             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
     4420             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     4421             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     4422             .
     4423         end.
     4424         when 'маг':U then do:
     4425           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
     4426           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
     4427           assign
     4428             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
     4429             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
     4430             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
     4431             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
     4432             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
     4433             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
     4434             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
     4435             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
     4436             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
     4437             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
     4438             v-cntxp-load-time       = bf-cntxp_shop.load-time
     4439             v-cntxp-holidays        = bf-cntxp_shop.holidays
     4440             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
     4441             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
     4442             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
     4443             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
     4444             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
     4445             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
     4446             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
     4447             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     4448             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     4449             .
     4450         end.
     4451       end case.
     4452     end.
     4453       RUN enable_UI.
     4454       run init-fields in this-procedure no-error .
     4455       if error-status :error
     4456       then do:
     4457           message
     4458             vss-workfile vss-revision vss-description
     4459             skip "Ошибка вычисления начальных значений для полей формы."
     4460             skip return-value
     4461             skip trim(error-status :get-message(1))
     4462                  trim(error-status :get-message(2))
     4463                  trim(error-status :get-message(3))
     4464                  trim(error-status :get-message(4))
     4465                  trim(error-status :get-message(5))
     4466           view-as alert-box error.
     4467           undo, return error .
     4468       end.
     4469       WAIT-FOR GO OF FRAME Dialog-Frame.
     4470   END.
     4471   RUN disable_UI.
     4472   PROCEDURE cb-xmlparse-tag-end-mail :
     4473   do
     4474   on error undo, return error
     4475   :
     4476       assign
     4477           v-mail-parameters-start = no
     4478       .
     4479   end.
     4480   END PROCEDURE.
     4481   PROCEDURE cb-xmlparse-tag-start-mail :
     4482   do
     4483   on error undo, return error
     4484   :
     4485       assign
     4486           v-mail-parameters-start = yes
     4487       .
     4488   end.
     4489   END PROCEDURE.
     4490   PROCEDURE cb-xmlparse-tag-start-DESTINATION_ROID :
     4491   do
     4492   on error undo, return error
     4493   :
     4494   define input parameter p-param as character    no-undo.
     4495       define buffer buf_rcs-destn     for rcs-destn.
     4496       find first buf_rcs-destn no-lock
     4497            where buf_rcs-destn.destination_rowid = p-param
     4498              and buf_rcs-destn.status_ = '*'
     4499       no-error.
     4500       if available buf_rcs-destn
     4501       then do:
     4502           assign
     4503               v-selected-object-start = yes
     4504               v-selected-object-name  = buf_rcs-destn.name
     4505           .
     4506       end.
     4507       else do:
     4508           assign
     4509               v-selected-object-start = no
     4510           .
     4511       end.
     4512   end.
     4513   END PROCEDURE.
     4514   PROCEDURE cb-xmlparse-tag-start-ROW :
     4515   do
     4516   on error undo, return error
     4517   :
     4518   define input parameter p-param as character    no-undo.
     4519       if v-selected-object-start = yes
     4520       then do:
     4521           run create-temp-table-record in this-procedure (
     4522                 input v-selected-object-name
     4523               , input v-xmlvalid-tag-value
     4524           ) no-error .
     4525           if error-status :error
     4526           then do:
     4527               undo, return error "Ошибка создания записи временной таблицы." + chr(10) + return-value.
     4528           end.
     4529       end.
     4530   end.
     4531   END PROCEDURE.
     4532   PROCEDURE cb-xmlvalid-procedure-not-found :
     4533   do
     4534   on error undo, return error
     4535   :
     4536   define input parameter p-type       as character    no-undo.
     4537   define input parameter p-value      as character    no-undo.
     4538   define input parameter p-parameters as character    no-undo.
     4539       case p-type
     4540       :
     4541           when "tag-end"
     4542           then do:
     4543               run fill-temp-table-record in this-procedure (
     4544                     input v-selected-object-name
     4545                   , input p-value
     4546                   , input v-xmlvalid-tag-value
     4547               ) no-error .
     4548               if error-status :error
     4549               then do:
     4550                   undo, return error "Ошибка заполнения временной таблицы." + chr(10) + return-value.
     4551               end.
     4552           end.
     4553           when "tag-start"
     4554           then do:
     4555               if p-value = "DESTINATION_ROID"
     4556               then do:
     4557                   assign
     4558                       v-selected-object-start = no
     4559                   .
     4560                   run cb-xmlparse-tag-start-DESTINATION_ROID in this-procedure ( input p-parameters ).
     4561               end.
     4562           end.
     4563           when "text"
     4564           then do:
     4565           end.
     4566           otherwise do:
     4567           end.
     4568       end case.
     4569   end.
     4570   END PROCEDURE.
     4571   PROCEDURE create-base-record-from-temp-table :
     4572   do
     4573   on error undo, return error
     4574   :
     4575   define input parameter p-rcs-name   as character    no-undo.
     4576   define input parameter p-ed         as handle       no-undo.
     4577       case p-rcs-name
     4578       :
     4579           when "BILL"
     4580           then do:
     4581               for each temp_rcs-retail1bill
     4582               :
     4583                   run import-bill in this-procedure (
     4584                         input temp_rcs-retail1bill.id
     4585                       , input p-ed
     4586                   ) no-error.
     4587                   if error-status :error
     4588                   then do:
     4589                       undo, return error "Ошибка импорта товаров." + chr(10) + return-value.
     4590                   end.
     4591               end.
     4592           end.
     4593           when "BILL_ITEM"
     4594           then do:
     4595           end.
     4596           when "RETAIL1_SUBJECT"
     4597           then do:
     4598               for each temp_rcs-retail1subject
     4599               :
     4600                   run import-subject in this-procedure (
     4601                         input temp_rcs-retail1subject.id
     4602                       , input p-ed
     4603                   ) no-error.
     4604                   if error-status :error
     4605                   then do:
     4606                       undo, return error "Ошибка импорта поставщика." + chr(10) + return-value.
     4607                   end.
     4608               end.
     4609           end.
     4610           when "RETAIL1_ATTR"
     4611           then do:
     4612               for each temp_rcs-retail1attr
     4613               :
     4614                   run import-attr in this-procedure (
     4615                         input temp_rcs-retail1attr.id
     4616                       , input p-ed
     4617                   ) no-error.
     4618                   if error-status :error
     4619                   then do:
     4620                       undo, return error "Ошибка импорта справочников (attr)." + chr(10) + return-value.
     4621                   end.
     4622               end.
     4623           end.
     4624           when "RETAIL1_PRODUCT"
     4625           then do:
     4626               for each temp_rcs-retail1product
     4627               :
     4628                   run import-product in this-procedure (
     4629                         input temp_rcs-retail1product.id
     4630                       , input p-ed
     4631                   ) no-error.
     4632                   if error-status :error
     4633                   then do:
     4634                       undo, return error "Ошибка импорта товаров." + chr(10) + return-value.
     4635                   end.
     4636               end.
     4637           end.
     4638           when "RETAIL1_PRICE_ITEM"
     4639           then do:
     4640           end.
     4641           when "RETAIL1_PRICE"
     4642           then do:
     4643               for each temp_rcs-retail1price
     4644               :
     4645                   run import-price in this-procedure (
     4646                         input temp_rcs-retail1price.price_id
     4647                       , input p-ed
     4648                   ) no-error.
     4649                   if error-status :error
     4650                   then do:
     4651                       undo, return error "Ошибка импорта прайс-листа с ID = " + temp_rcs-retail1price.price_id + chr(10) + return-value.
     4652                   end.
     4653               end.
     4654           end.
     4655           when "RETAIL1_BARCODE"
     4656           then do:
     4657               for each temp_rcs-retail1barcode
     4658               :
     4659                   run import-barcode in this-procedure (
     4660                         input temp_rcs-retail1barcode.id
     4661                       , input p-ed
     4662                   ) no-error.
     4663                   if error-status :error
     4664                   then do:
     4665                       undo, return error "Ошибка импорта бар-кода с ID = " + temp_rcs-retail1barcode.id + chr(10) + return-value.
     4666                   end.
     4667               end.
     4668           end.
     4669           when "RETAIL1_DELETE"
     4670           then do:
     4671               for each temp_rcs-retail1delete
     4672               :
     4673                   run delete-record in this-procedure (
     4674                         input temp_rcs-retail1delete.name
     4675                       , input temp_rcs-retail1delete.id
     4676                   ) no-error.
     4677                   if error-status :error
     4678                   then do:
     4679                       undo, return error "Ошибка удаления '" + temp_rcs-retail1delete.name + "'" + " с ID '" + temp_rcs-retail1delete.id + "'" + chr(10) + return-value.
     4680                   end.
     4681               end.
     4682           end.
     4683           otherwise do:
     4684           end.
     4685       end case.
     4686   end.
     4687   END PROCEDURE.
     4688   PROCEDURE create-temp-table-record :
     4689   do
     4690   on error undo, return error
     4691   :
     4692   define input parameter p-rcs-name   as character    no-undo.
     4693   define input parameter p-tag-value  as character    no-undo.
     4694       case p-rcs-name
     4695       :
     4696           when "BILL"
     4697           then do:
     4698               find first temp_rcs-retail1bill
     4699                    where temp_rcs-retail1bill.id = ""
     4700               no-error .
     4701               if available temp_rcs-retail1bill
     4702               then do:
     4703                   undo, return error "Неопределенный идентификатор ID таблицы BILL при импорте." + chr(10) + return-value.
     4704               end.
     4705               else do:
     4706                   create temp_rcs-retail1bill.
     4707                   assign
     4708                       temp_rcs-retail1bill.id = ""
     4709                   .
     4710               end.
     4711           end.
     4712           when "BILL_ITEM"
     4713           then do:
     4714               find first temp_rcs-retail1billitem
     4715                    where temp_rcs-retail1billitem.bill_id    = ""
     4716                      and temp_rcs-retail1billitem.product_id = ""
     4717               no-error .
     4718               if available temp_rcs-retail1billitem
     4719               then do:
     4720                   undo, return error "Неопределенные идентификаторы таблицы BILL_ITEM при импорте." + chr(10) + return-value.
     4721               end.
     4722               else do:
     4723                   create temp_rcs-retail1billitem .
     4724                   assign
     4725                       temp_rcs-retail1billitem.bill_id    = ""
     4726                       temp_rcs-retail1billitem.product_id = ""
     4727                   .
     4728               end.
     4729           end.
     4730           when "RETAIL1_BANK"
     4731           then do:
     4732               find first temp_rcs-retail1bank
     4733                    where temp_rcs-retail1bank.id = ""
     4734               no-error .
     4735               if available temp_rcs-retail1bank
     4736               then do:
     4737                   undo, return error "Неопределенные идентификаторы таблицы RETAIL1_BANK при импорте." + chr(10) + return-value.
     4738               end.
     4739               else do:
     4740                   create temp_rcs-retail1bank.
     4741                   assign
     4742                       temp_rcs-retail1bank.id = ""
     4743                       temp_rcs-retail1bank.bank-code = 0
     4744                   .
     4745               end.
     4746           end.
     4747           when "RETAIL1_SUBJECT"
     4748           then do:
     4749               find first temp_rcs-retail1subject
     4750                    where temp_rcs-retail1subject.id = ""
     4751               no-error .
     4752               if available temp_rcs-retail1subject
     4753               then do:
     4754                   undo, return error "Неопределенные идентификаторы таблицы RETAIL1_SUBJECT при импорте." + chr(10) + return-value.
     4755               end.
     4756               else do:
     4757                   create temp_rcs-retail1subject.
     4758                   assign
     4759                       temp_rcs-retail1subject.id = ""
     4760                       temp_rcs-retail1subject.obj-type = ""
     4761                       temp_rcs-retail1subject.obj-code = 0
     4762                   .
     4763               end.
     4764           end.
     4765           when "RETAIL1_ATTR"
     4766           then do:
     4767               find first temp_rcs-retail1attr
     4768                    where temp_rcs-retail1attr.id = ""
     4769               no-error .
     4770               if available temp_rcs-retail1attr
     4771               then do:
     4772                   undo, return error "Неопределенный идентификатор ID таблицы RETAIL1_ATTR при импорте." + chr(10) + return-value.
     4773               end.
     4774               else do:
     4775                   create temp_rcs-retail1attr.
     4776                   assign
     4777                       temp_rcs-retail1attr.id = ""
     4778                   .
     4779               end.
     4780           end.
     4781           when "RETAIL1_PRODUCT"
     4782           then do:
     4783               find first temp_rcs-retail1product
     4784                    where temp_rcs-retail1product.id = ""
     4785               no-error .
     4786               if available temp_rcs-retail1product
     4787               then do:
     4788                   undo, return error "Неопределенный идентификатор ID таблицы RETAIL1_PRODUCT при импорте." + chr(10) + return-value.
     4789               end.
     4790               else do:
     4791                   create temp_rcs-retail1product.
     4792                   assign
     4793                       temp_rcs-retail1product.id = ""
     4794                       temp_rcs-retail1product.gds-code = 0
     4795                   .
     4796               end.
     4797           end.
     4798           when "RETAIL1_PRICE"
     4799           then do:
     4800               find first temp_rcs-retail1price
     4801                    where temp_rcs-retail1price.price_id = ""
     4802               no-error .
     4803               if available temp_rcs-retail1price
     4804               then do:
     4805                   undo, return error "Неопределенный идентификатор ID таблицы RETAIL1_PRICE при импорте." + chr(10) + return-value.
     4806               end.
     4807               else do:
     4808                   create temp_rcs-retail1price.
     4809                   assign
     4810                       temp_rcs-retail1price.price_id = ""
     4811                   .
     4812               end.
     4813           end.
     4814           when "RETAIL1_PRICE_ITEM"
     4815           then do:
     4816               find first temp_rcs-retail1priceitem
     4817                    where temp_rcs-retail1priceitem.price_id   = ""
     4818                      and temp_rcs-retail1priceitem.id         = ""
     4819               no-error .
     4820               if available temp_rcs-retail1priceitem
     4821               then do:
     4822                   undo, return error "Неопределенные идентификаторы таблицы RETAIL1_PRICE_ITEM при импорте." + chr(10) + return-value.
     4823               end.
     4824               else do:
     4825                   create temp_rcs-retail1priceitem .
     4826                   assign
     4827                       temp_rcs-retail1priceitem.price_id   = ""
     4828                       temp_rcs-retail1priceitem.id         = ""
     4829                   .
     4830               end.
     4831           end.
     4832           when "RETAIL1_BARCODE"
     4833           then do:
     4834               find first temp_rcs-retail1barcode
     4835                    where temp_rcs-retail1barcode.id = ""
     4836               no-error .
     4837               if available temp_rcs-retail1barcode
     4838               then do:
     4839                   undo, return error "Неопределенный идентификатор ID таблицы RETAIL1_BARCODE при импорте." + chr(10) + return-value.
     4840               end.
     4841               else do:
     4842                   create temp_rcs-retail1barcode.
     4843                   assign
     4844                       temp_rcs-retail1barcode.id = ""
     4845                   .
     4846               end.
     4847           end.
     4848           when "RETAIL1_DELETE"
     4849           then do:
     4850               create temp_rcs-retail1delete.
     4851               assign
     4852                   temp_rcs-retail1delete.name = ""
     4853                   temp_rcs-retail1delete.id = ""
     4854               .
     4855           end.
     4856           when "RETAIL1_CONVOLUTION"
     4857           then do:
     4858               find first temp_rcs-retail1convolution
     4859                    where temp_rcs-retail1convolution.site_id  = ""
     4860                      and temp_rcs-retail1convolution.docdate  = ?
     4861                      and temp_rcs-retail1convolution.tov      = ""
     4862               no-error .
     4863               if available temp_rcs-retail1convolution
     4864               then do:
     4865                   undo, return error "Неопределенные идентификаторы таблицы RETAIL1_CONVOLUTION при импорте." + chr(10) + return-value.
     4866               end.
     4867               else do:
     4868                   create temp_rcs-retail1convolution.
     4869                   assign
     4870                       temp_rcs-retail1convolution.site_id  = ""
     4871                       temp_rcs-retail1convolution.docdate  = ?
     4872                       temp_rcs-retail1convolution.tov      = ""
     4873                   .
     4874               end.
     4875           end.
     4876           otherwise do:
     4877           end.
     4878       end case.
     4879   end.
     4880   END PROCEDURE.
     4881   PROCEDURE disable_UI :
     4882     HIDE FRAME Dialog-Frame.
     4883   END PROCEDURE.
     4884   PROCEDURE enable_UI :
     4885     DISPLAY fi-dir-imp fi-dir-exp fi-log ed-log
     4886         WITH FRAME Dialog-Frame.
     4887     ENABLE b-exit bt-config bt-import bt-export b-help ed-log
     4888         WITH FRAME Dialog-Frame.
     4889     VIEW FRAME Dialog-Frame.
     4890   END PROCEDURE.
     4891   PROCEDURE export-rcs :
     4892   do
     4893   on error undo, return error
     4894   :
     4895   define input parameter p-fi     as handle       no-undo.
     4896   define input parameter p-ed     as handle       no-undo.
     4897   define input parameter p-dir    as character    no-undo.
     4898   define variable v-date-from         as date             no-undo.
     4899   define variable v-date-to           as date             no-undo.
     4900   define variable v-range             as integer          no-undo.
     4901   define variable v-obj-list          as character        no-undo.
     4902   define variable v-pay-type-list     as character        no-undo.
     4903   define variable v-pay-code          as logical          no-undo.
     4904   define variable v-cst               as logical          no-undo.
     4905   define variable v-xml-file-name     as character        no-undo.
     4906   define variable v-log-file-name     as character        no-undo.
     4907   define variable v-counter           as integer          no-undo.
     4908       define variable v-host-code     as integer      no-undo.
     4909       define variable v-doc-type-list as character    no-undo.
     4910       define variable v-cancel        as logical      no-undo.
     4911       define variable v-void-logical  as logical      no-undo.
     4912       run bge/bge-dper.w (
     4913             input parparentproc
     4914           , input 1
     4915           , input "":U
     4916           , output v-date-from
     4917           , output v-date-to
     4918           , output v-range
     4919           , output v-host-code
     4920           , output v-obj-list
     4921           , OUTPUT v-pay-type-list
     4922           , output v-doc-type-list
     4923           , output v-pay-code
     4924           , output v-cst
     4925           , output v-void-logical
     4926           , output v-void-logical
     4927           , output v-void-logical
     4928           , output v-void-logical
     4929           , output v-void-logical
     4930           , output v-void-logical
     4931           , output v-void-logical
     4932           , output v-cancel
     4933       ) no-error .
     4934       if error-status :error
     4935       then do:
     4936           message
     4937             vss-workfile vss-revision vss-description
     4938             skip "Ошибка ввода параметров выгрузки документов."
     4939             skip return-value
     4940             skip trim(error-status :get-message(1))
     4941                  trim(error-status :get-message(2))
     4942                  trim(error-status :get-message(3))
     4943                  trim(error-status :get-message(4))
     4944                  trim(error-status :get-message(5))
     4945           view-as alert-box error.
     4946           undo, return error .
     4947       end.
     4948       if v-cancel = yes
     4949       then do:
     4950           undo, return.
     4951       end.
     4952       generate-filename:
     4953       do while true
     4954       :
     4955           assign
     4956               v-counter = v-counter + 1
     4957               v-xml-file-name = p-dir + chr(92) + "out" + string( v-counter )
     4958           .
     4959           if search ( v-xml-file-name + ".xml" ) = ?
     4960           then do:
     4961               leave generate-filename.
     4962           end.
     4963       end.
     4964       ASSIGN v-log-file-name = v-xml-file-name + ".log".
     4965       output to value( v-xml-file-name + ".xm1" ) convert target "1251" .
     4966       output close.
     4967       if v-date-from = ? or v-date-to = ? then return error.
     4968       run write-to-log-editor( p-ed, 1, "Экспорт документов"
     4969                                   + ", диапазон дат " + string(v-date-from, "99.99.99")
     4970                                   + " - " + string(v-date-to, "99.99.99")
     4971                         ).
     4972       run write-to-log-editor( p-ed, 1, "Диапазон:"
     4973                                   + ( if v-range = 1
     4974                                       then " по всем фирмам"
     4975                                       else ( if v-range = 2
     4976                                              then " по всем объектам текущей фирмы"
     4977                                              else " по объектам: " + v-obj-list ) )
     4978                         ).
     4979       if v-pay-code = yes
     4980       then do:
     4981           run write-to-log-editor( p-ed, 1, "С кодами оплаты в документах" ).
     4982       end.
     4983       if v-cst = yes
     4984       then do:
     4985           run write-to-log-editor( p-ed, 1, "Со строкой ГТД в документах" ).
     4986       end.
     4987       process events.
     4988       run rcs/rcs-docs.p (
     4989             input parparentproc
     4990           , input p-dir + chr(92) + 'h'
     4991           , input p-dir + chr(92) + 'b'
     4992           , input v-date-from
     4993           , input v-date-to
     4994           , input v-range
     4995           , input v-obj-list
     4996           , input v-pay-code
     4997           , input v-cst
     4998           , input p-ed
     4999           , input p-fi
     5000       ) no-error.
     5001       if error-status :error
     5002       then do:
     5003           message
     5004             vss-workfile vss-revision vss-description
     5005             skip "Ошибка экспорта документов"
     5006             skip return-value
     5007             skip trim(error-status :get-message(1))
     5008                  trim(error-status :get-message(2))
     5009                  trim(error-status :get-message(3))
     5010                  trim(error-status :get-message(4))
     5011                  trim(error-status :get-message(5))
     5012           view-as alert-box error.
     5013           undo, return error .
     5014       end.
     5015       run write-to-log-editor( p-ed, 1, "Копирование в файл экспорта." ).
     5016       os-append value( p-dir + chr(92) + 'h' + ".xm1" ) value( v-xml-file-name + ".xm1" ).
     5017       if os-error <> 0
     5018       then do:
     5019           run write-to-log-editor( p-ed, 1, "Ошибка копирования файла шапок документов. Код ошибки " + string( os-error ) + ". Данные остались во временном файле." ).
     5020       end.
     5021       os-append value( p-dir + chr(92) + 'b' + ".xm1" ) value( v-xml-file-name + ".xm1" ).
     5022       if os-error <> 0
     5023       then do:
     5024           run write-to-log-editor( p-ed, 1, "Ошибка копирования файла строк документов. Код ошибки " + string( os-error ) + ". Данные остались во временном файле." ).
     5025       end.
     5026       run write-to-log-editor( p-ed, 1, "Экспорт документов завершен." ).
     5027       run write-to-log-editor( p-ed, 1, "Экспорт свертки"
     5028                                   + " за дату " + string(v-date-to, "99.99.99")
     5029                         ).
     5030       run rcs/rcs-day.p (
     5031             input parparentproc
     5032           , input p-dir + chr(92) + 's'
     5033           , input v-date-to
     5034           , input v-range
     5035           , input v-obj-list
     5036           , input p-ed
     5037           , input p-fi
     5038       ) no-error.
     5039       if error-status :error
     5040       then do:
     5041           message
     5042             vss-workfile vss-revision vss-description
     5043             skip "Ошибка экспорта свертки."
     5044             skip return-value
     5045             skip trim(error-status :get-message(1))
     5046                  trim(error-status :get-message(2))
     5047                  trim(error-status :get-message(3))
     5048                  trim(error-status :get-message(4))
     5049                  trim(error-status :get-message(5))
     5050           view-as alert-box error.
     5051           undo, return error .
     5052       end.
     5053       run write-to-log-editor( p-ed, 1, "Копирование в файл экспорта." ).
     5054       os-append value( p-dir + chr(92) + 's' + ".xm1" ) value( v-xml-file-name + ".xm1" ).
     5055       if os-error <> 0
     5056       then do:
     5057           run write-to-log-editor( p-ed, 1, "Ошибка копирования файла свертки. Код ошибки " + string( os-error ) + ". Данные остались во временном файле." ).
     5058       end.
     5059       run write-to-log-editor( p-ed, 1, "Экспорт свертки завершен." ).
     5060       run write-to-log-editor( p-ed, 1, "Экспорт весовых бар-кодов." ).
     5061       run rcs/rcs-bcod.p (
     5062             input parparentproc
     5063           , input p-dir + chr(92) + 'x'
     5064           , input v-date-to
     5065           , input v-range
     5066           , input v-obj-list
     5067           , input p-ed
     5068           , input p-fi
     5069       ) no-error.
     5070       if error-status :error
     5071       then do:
     5072           message
     5073             vss-workfile vss-revision vss-description
     5074             skip "Ошибка экспорта весовых бар-кодов."
     5075             skip return-value
     5076             skip trim(error-status :get-message(1))
     5077                  trim(error-status :get-message(2))
     5078                  trim(error-status :get-message(3))
     5079                  trim(error-status :get-message(4))
     5080                  trim(error-status :get-message(5))
     5081           view-as alert-box error.
     5082           undo, return error .
     5083       end.
     5084       run write-to-log-editor( p-ed, 1, "Копирование в файл экспорта." ).
     5085       os-append value( p-dir + chr(92) + 'x' + ".xm1" ) value( v-xml-file-name + ".xm1" ).
     5086       if os-error <> 0
     5087       then do:
     5088           run write-to-log-editor( p-ed, 1, "Ошибка копирования файла весовых бар-кодов. Код ошибки " + string( os-error ) + ". Данные остались во временном файле." ).
     5089       end.
     5090       run write-to-log-editor( p-ed, 1, "Экспорт весовых бар-кодов завершен.").
     5091       os-rename value( v-xml-file-name + ".xm1" ) value( v-xml-file-name + ".xml" ).
     5092       if os-error = 999
     5093       then do:
     5094           os-copy value( v-xml-file-name + ".xm1" ) value( v-xml-file-name + ".xml" ).
     5095           if os-error = 0 then do:
     5096               os-delete value( v-xml-file-name + ".xm1" ) .
     5097           end.
     5098       end.
     5099   end.
     5100   END PROCEDURE.
     5101   PROCEDURE fill-temp-table-record :
     5102   do
     5103   on error undo, return error
     5104   :
     5105   define input parameter p-rcs-name   as character    no-undo.
     5106   define input parameter p-tag-name   as character    no-undo.
     5107   define input parameter p-tag-value  as character    no-undo.
     5108       if v-mail-parameters-start = yes
     5109       then do:
     5110           case p-tag-name
     5111           :
     5112               when "X-ReportType"
     5113               then do:
     5114                   assign
     5115                       v-mail-ReportType = p-tag-value
     5116                   .
     5117               end.
     5118               when "X-IDChannel"
     5119               then do:
     5120                   assign
     5121                       v-mail-IDChannel = p-tag-value
     5122                   .
     5123               end.
     5124               when "X-ReportNumber"
     5125               then do:
     5126                   assign
     5127                       v-mail-ReportNumber = p-tag-value
     5128                   .
     5129               end.
     5130           end case.
     5131       end.
     5132       else do:
     5133           case p-rcs-name
     5134           :
     5135               when "BILL"
     5136               then do:
     5137                   case p-tag-name
     5138                   :
     5139                       when "ID"
     5140                       then do:
     5141                           define buffer buf_del_temp_rcs-retail1bill      for temp_rcs-retail1bill.
     5142                           define buffer buf_del_temp_rcs-retail1billitem  for temp_rcs-retail1billitem.
     5143                           find first buf_del_temp_rcs-retail1bill
     5144                                where buf_del_temp_rcs-retail1bill.id = p-tag-value
     5145                           no-error.
     5146                           if available buf_del_temp_rcs-retail1bill
     5147                           then do:
     5148                               run write-to-log-editor in this-procedure (
     5149                                     input ed-log :handle in frame Dialog-Frame
     5150                                   , input 1
     5151                                   , input substitute( "Повторные данные о приходе с id: &1. Данные будут загружены из файла: &2"
     5152                                                       , p-tag-value
     5153                                                       , temp_file.name
     5154                                                      )
     5155                               ).
     5156                               delete buf_del_temp_rcs-retail1bill.
