      443   procedure xmlchar-decode :
      444   define input parameter p-in-string      as character        no-undo.
      445   define output parameter p-out-string    as character        no-undo.
      446       define variable v-position      as integer      no-undo.
      447       define variable v-last-position as integer      no-undo.
      448       define variable v-temp-integer  as integer      no-undo.
      449       define variable v-current-char  as character    no-undo.
      450       define variable v-next-char     as character    no-undo.
      451       define variable v-success       as logical      no-undo.
      452   do
      453   on error undo, return error
      454   :
      455       assign
      456           p-out-string = "":U
      457           v-position   = 0
      458       .
      459       replace-cycle:
      460       do while yes
      461       on error undo, return error
      462       :
      463           assign
      464               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      465           .
      466           if v-last-position <= v-position
      467           then do:
      468               if v-position = 0
      469               then do:
      470                   assign
      471                       p-out-string = p-in-string
      472                   .
      473               end.
      474               else do:
      475                   assign
      476                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      477                   .
      478               end.
      479               leave replace-cycle.
      480           end.
      481           else do:
      482               assign
      483                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      484                   v-position      = v-last-position
      485                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      486               .
      487               if v-current-char = "#":U
      488               then do:
      489                   assign
      490                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      491                   .
      492                   if v-last-position > 0
      493                   then do:
      494                       run xmlchar-read-integer in this-procedure
      495                        (
      496                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      497                           , output v-temp-integer
      498                           , output v-success
      499                       ).
      500                       if v-success = yes
      501                       and v-temp-integer >= 1
      502                       and v-temp-integer <= 255
      503                       then do:
      504                           assign
      505                               p-out-string = p-out-string + chr( v-temp-integer )
      506                               v-position   = v-last-position + 1
      507                           .
      508                       end.
      509                       else do:
      510                           assign
      511                               p-out-string = p-out-string + "&":U
      512                               v-position   = v-position   + 1
      513                           .
      514                       end.
      515                   end.
      516                   else do:
      517                       assign
      518                           p-out-string = p-out-string + "&":U
      519                           v-position   = v-position   + 1
      520                       .
      521                   end.
      522               end.
      523               else do:
      524                   case substring( p-in-string, v-position + 1, 3 )
      525                   :
      526                       when "lt;":U
      527                       then do:
      528                           assign
      529                               p-out-string = p-out-string + "<":U
      530                               v-position   = v-position   + 3
      531                           .
      532                       end.
      533                       when "gt;":U
      534                       then do:
      535                           assign
      536                               p-out-string = p-out-string + ">":U
      537                               v-position   = v-position   + 3
      538                           .
      539                       end.
      540                       otherwise do:
      541                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      542                           then do:
      543                               assign
      544                                   p-out-string = p-out-string + "&":U
      545                                   v-position   = v-position   + 4
      546                               .
      547                           end.
      548                           else do:
      549                               case substring( p-in-string, v-position + 1, 5 )
      550                               :
      551                                   when "quot;":U
      552                                   then do:
      553                                       assign
      554                                           p-out-string = p-out-string + '"':U
      555                                           v-position   = v-position   + 5
      556                                       .
      557                                   end.
      558                                   when "apos;":U
      559                                   then do:
      560                                       assign
      561                                           p-out-string = p-out-string + "'":U
      562                                           v-position   = v-position   + 5
      563                                       .
      564                                   end.
      565                                   otherwise do:
      566                                       assign
      567                                           p-out-string = p-out-string + "&":U
      568                                       .
      569                                   end.
      570                               end case.
      571                           end.
      572                       end.
      573                   end case.
      574               end.
      575           end.
      576       end.
      577   end.
      578   end .
      579   procedure xmlchar-read-integer :
      580   define input parameter p-input-string      as character        no-undo.
      581   define output parameter p-output-integer   as integer          no-undo.
      582   define output parameter p-success       as logical          no-undo.
      583   do
      584   on error undo, return error
      585   :
      586       assign
      587           p-output-integer = integer( p-input-string )
      588       no-error.
      589       if error-status :error
      590       then do:
      591           assign
      592               p-success           = no
      593               p-output-integer    = 0
      594           .
      595       end.
      596       else do:
      597           assign
      598               p-success           = yes
      599           .
      600       end.
      601   end.
      602   end.
      603   define variable vss-include-info3 as character format "X(65)" no-undo
      604   initial "@(#)$Workfile$ $Revision$".
      605   define temp-table temp_xmlparse-attrs no-undo
      606   field field-name as character
      607   field attr-code as character
      608   field attr-value as character
      609   index pi is unique primary
      610   field-name attr-code
      611   .
      612   procedure xmlparse :
      613   define input parameter p-handle         as handle           no-undo.
      614   define input parameter p-XML-buffer     as character        no-undo.
      615   define input parameter p-call-mode      as character        no-undo.
      616       define variable v-procedure-type        as character    no-undo.
      617       define variable v-procedure-name        as character    no-undo.
      618       define variable v-temp-string           as character    no-undo.
      619       define variable v-current-position      as integer      no-undo.
      620       define variable v-end-position          as integer      no-undo.
      621       define variable v-text-position         as integer      no-undo.
      622       define variable v-input-buffer-length   as integer      no-undo.
      623       define variable v-handle                as handle       no-undo.
      624       define variable v-call-mode             as character    no-undo.
      625       define variable v-proc-type             as character    no-undo.
      626       define variable v-proc-name             as character    no-undo.
      627       define variable v-decode-string         as character    no-undo.
      628   do
      629   on error undo, return error
      630   :
      631       if not valid-handle( p-handle )
      632       then do:
      633           return.
      634       end.
      635       assign
      636           v-end-position          = 1
      637           v-current-position      = 1
      638           v-input-buffer-length   = length( p-XML-buffer )
      639       .
      640       do
      641       while v-end-position < v-input-buffer-length
      642       :
      643           assign
      644               v-current-position = index( p-XML-buffer, "<":U, v-end-position )
      645           .
      646           if v-current-position = 0
      647           then do:
      648               assign
      649                   v-decode-string = substring( p-XML-buffer, v-end-position )
      650               .
      651               run xmlchar-decode in this-procedure (
      652                     input v-decode-string
      653                   , output v-temp-string
      654               ).
      655               assign
      656                   v-handle     = p-handle
      657                   v-call-mode  = p-call-mode
      658                   v-proc-type  = 'text':U
      659                   v-proc-name  = '':U
      660               .
      661               run run-callback-procedure in this-procedure (
      662                     input v-handle
      663                   , input v-call-mode
      664                   , input v-proc-type
      665                   , input v-proc-name
      666                   , input v-temp-string
      667               ).
      668               assign
      669                   v-end-position = v-input-buffer-length
      670               .
      671           end.
      672           else do:
      673               if v-current-position > v-end-position
      674               then do:
      675                   assign
      676                       v-decode-string = substring( p-XML-buffer, v-end-position, v-current-position - v-end-position )
      677                   .
      678                   run xmlchar-decode in this-procedure (
      679                         input v-decode-string
      680                       , output v-temp-string
      681                   ).
      682                   assign
      683                       v-end-position = v-current-position
      684                   .
      685                   assign
      686                       v-handle     = p-handle
      687                       v-call-mode  = p-call-mode
      688                       v-proc-type  = 'text':U
      689                       v-proc-name  = '':U
      690                   .
      691                   run run-callback-procedure in this-procedure (
      692                         input v-handle
      693                       , input v-call-mode
      694                       , input v-proc-type
      695                       , input v-proc-name
      696                       , input v-temp-string
      697                   ).
      698               end.
      699               assign
      700                   v-decode-string = substring( p-XML-buffer, v-end-position + 1, 1 )
      701               .
      702               if v-decode-string = "/":U
      703               then do:
      704                   assign
      705                       v-procedure-type    = "tag-end":U
      706                       v-end-position      = v-current-position + 1
      707                   .
      708               end.
      709               else do:
      710                   assign
      711                       v-procedure-type    = "tag-start":U
      712                       v-end-position      = v-current-position
      713                   .
      714               end.
      715               assign
      716                   v-current-position  = index(p-XML-buffer, "/>":U, v-end-position)
      717               .
      718               if v-current-position <= v-end-position
      719               then do:
      720                   assign
      721                       v-current-position  = index(p-XML-buffer, ">":U, v-end-position)
      722                   .
      723               end.
      724               assign
      725                   v-end-position      = v-end-position + 1
      726               .
      727               if v-current-position <= v-end-position
      728               then do:
      729                   run run-cb-xmlparse-error in this-procedure
      730                                           (   input p-handle
      731                                           ,   input 'Ошибка: знак < без завершающего > на той же строке'
      732                                           ).
      733                   assign
      734                       v-temp-string   = "<":U + substring(p-XML-buffer, v-end-position)
      735                       v-end-position  = v-input-buffer-length
      736                   .
      737                   assign
      738                       v-handle     = p-handle
      739                       v-call-mode  = p-call-mode
      740                       v-proc-type  = 'text':U
      741                       v-proc-name  = '':U
      742                   .
      743                   run run-callback-procedure in this-procedure (
      744                         input v-handle
      745                       , input v-call-mode
      746                       , input v-proc-type
      747                       , input v-proc-name
      748                       , input v-temp-string
      749                   ).
      750               end.
      751               else do:
      752                   assign
      753                       v-temp-string   = trim( substring(      p-XML-buffer
      754                                                           ,   v-end-position
      755                                                           ,   v-current-position - v-end-position
      756                                             )          )
      757                       v-text-position = index( v-temp-string, " ":U )
      758                   .
      759                   if v-text-position <> 0
      760                   then do:
      761                       assign
      762                           v-procedure-name    =   trim( substring(      v-temp-string
      763                                                                       ,   1
      764                                                                       ,   v-text-position
      765                                                         )          )
      766                           v-temp-string       =   trim( substring(    v-temp-string
      767                                                                   ,   v-text-position + 1
      768                                                       )          )
      769                       .
      770                   end.
      771                   else do:
      772                       assign
      773                           v-procedure-name    =   v-temp-string
      774                           v-temp-string       =   "":U
      775                       .
      776                   end.
      777                   assign
      778                       v-end-position      = v-current-position + 1
      779                   .
      780                   assign
      781                       v-handle          = p-handle
      782                       v-call-mode       = p-call-mode
      783                   .
      784                   run run-callback-procedure in this-procedure (
      785                         input v-handle
      786                       , input v-call-mode
      787                       , input v-procedure-type
      788                       , input v-procedure-name
      789                       , input v-temp-string
      790                   ).
      791               end.
      792           end.
      793       end.
      794   end.
      795   end procedure.
      796   procedure run-callback-procedure :
      797   define input parameter p-handle             as handle           no-undo.
      798   define input parameter p-call-mode          as character        no-undo.
      799   define input parameter p-procedure-type     as character        no-undo.
      800   define input parameter p-procedure-name     as character        no-undo.
      801   define input parameter p-param-value        as character        no-undo.
      802       define variable v-data-type         as character            no-undo.
      803       define variable v-data-value        as character            no-undo.
      804       define variable v-procedure-name    as character            no-undo.
      805       define variable v-procedure-exists  as logical      no-undo.
      806   do
      807   on error undo, return error
      808   :
      809       if p-call-mode = "call-all":U
      810       or p-call-mode = "call-named":U
      811       then do:
      812           case p-procedure-type :
      813               when "text":U
      814               then do:
      815                   assign
      816                       v-procedure-name = "cb-xmlparse-text":U
      817                   .
      818               end.
      819               when "tag-end":U
      820               then do:
      821                   assign
      822                       v-procedure-name = "cb-xmlparse-tag-end-":U + p-procedure-name
      823                   .
      824               end.
      825               when "tag-start":U
      826               then do:
      827                   assign
      828                       v-procedure-name = "cb-xmlparse-tag-start-":U + p-procedure-name
      829                   .
      830               end.
      831               otherwise do:
      832                   assign
      833                       v-procedure-name = p-procedure-name
      834                   .
      835               end.
      836           end case.
      837           if p-handle :get-signature( v-procedure-name ) = "":U
      838           then do:
      839               assign
      840                   v-procedure-exists = no
      841               .
      842           end.
      843           else do:
      844               assign
      845                   v-procedure-exists = yes
      846               .
      847           end.
      848           if v-procedure-exists = yes
      849           then do:
      850               run value(v-procedure-name) in p-handle (input p-param-value) no-error.
      851               if error-status :error
      852               then do:
      853                   run run-cb-xmlparse-error in this-procedure (
      854                       input p-handle
      855                       , input "Ошибка при вызове программы " + v-procedure-name
      856                   ).
      857               end.
      858           end.
      859       end.
      860       if ( p-call-mode = "call-all":U
      861           and v-procedure-exists <> yes )
      862       or p-call-mode = "call-unnamed":U
      863       then do:
      864           case p-procedure-type :
      865               when 'text':U
      866               then do:
      867                   assign
      868                       v-data-type     = 'text':U
      869                       v-data-value    = p-param-value
      870                   .
      871               end.
      872               when 'tag-end':U
      873               then do:
      874                   assign
      875                       v-data-type     = 'tag-end':U
      876                       v-data-value    = p-procedure-name
      877                   .
      878               end.
      879               when 'tag-start':U
      880               then do:
      881                   assign
      882                       v-data-type     = 'tag-start':U
      883                       v-data-value    = p-procedure-name
      884                   .
      885               end.
      886               otherwise do:
      887                   assign
      888                       v-data-type     = 'text':U
      889                       v-data-value    = p-procedure-name
      890                   .
      891               end.
      892           end case.
      893           run run-cb-xmlparse-procedure-not-found in this-procedure (
      894                 input p-handle
      895               , input v-data-type
      896               , input v-data-value
      897               , input p-param-value
      898           ).
      899       end.
      900   end.
      901   end procedure.
      902   procedure run-cb-xmlparse-error :
      903   do
      904   on error undo, return error
      905   :
      906       def input parameter p-handle            as handle no-undo.
      907       def input parameter p-error-message as char no-undo.
      908       if lookup("cb-xmlparse-error", p-handle :internal-entries) > 0
      909       then do:
      910           run cb-xmlparse-error in p-handle  (input p-error-message).
      911       end.
      912   end.
      913   end procedure.
      914   procedure run-cb-xmlparse-procedure-not-found :
      915   do
      916   on error undo, return error
      917   :
      918       def input parameter p-handle            as handle no-undo.
      919       def input parameter p-data-type         as char no-undo.
      920       def input parameter p-data-value        as char no-undo.
      921       def input parameter p-param-value       as char no-undo.
      922       if lookup("cb-xmlparse-procedure-not-found", p-handle :internal-entries) > 0
      923       then do:
      924           run cb-xmlparse-procedure-not-found in p-handle    (   input p-data-type
      925                                                             , input p-data-value
      926                                                             , input p-param-value
      927                                                           ) no-error.
      928           if error-status :error
      929           then do:
      930               run run-cb-xmlparse-error in this-procedure
      931                                       (   input p-handle
      932                                       ,   input "Ошибка при вызове программы cb-xmlparse-procedure-not-found"
      933                                       ).
      934           end.
      935       end.
      936       else do:
      937           run run-cb-xmlparse-error in this-procedure
      938                                   (   input p-handle
      939                                   ,   input "Ошибка: Не определена программа cb-xmlparse-procedure-not-found"
      940                                   ).
      941       end.
      942   end.
      943   end procedure.
      944   procedure cb-xmlparse-attributes :
      945   define input  parameter p-handle            as handle no-undo.
      946   define input  parameter p-field-name        as character no-undo .
      947   define input  parameter p-field-value       as character no-undo .
      948   define variable ii as integer no-undo init 1.
      949   define variable v-input-buffer-length   as integer no-undo.
      950   define variable v-dc as logical no-undo .
      951   define variable v-sc as logical no-undo .
      952   define variable v-eq as logical no-undo .
      953   define variable v-char as character no-undo .
      954   define variable v-code as character no-undo .
      955   define variable v-value as character no-undo .
      956   define buffer buf_temp_xmlparse-attrs for temp_xmlparse-attrs.
      957     do
      958     on error undo, return error
      959     :
      960       if index(p-field-value, '>':U) > 0 then do:
      961         run run-cb-xmlparse-error in this-procedure
      962                                 (   input p-handle
      963                                 ,   input substitute("Ошибка: тэг &1 содержит другие тэги", p-field-name)
      964                                 ).
      965       end.
      966       assign
      967       p-field-value = trim(p-field-value)
      968       .
      969       for each buf_temp_xmlparse-attrs where
      970               buf_temp_xmlparse-attrs.field-name = p-field-name:
      971         delete buf_temp_xmlparse-attrs.
      972       end.
      973       assign
      974       v-input-buffer-length = length( p-field-value )
      975       .
      976       do while ii <= v-input-buffer-length:
      977         assign
      978         v-char = substr(p-field-value, ii, 1)
      979         ii = ii + 1
      980         .
      981         CASE v-char:
      982           when "=":U then do:
      983             if v-eq
      984             and not v-dc
      985             and not v-sc then do:
      986               return error.
      987             end.
      988             assign
      989             v-eq = yes
      990             .
      991           end.
      992           when chr(34) then do:
      993           if v-eq then
      994           assign
      995           v-dc = not(v-dc)
      996           .
      997           else return error.
      998           end.
      999           when chr(39) then do:
     1000           if v-eq then
     1001           assign
     1002           v-sc = not(v-sc)
     1003           .
     1004           else return error.
     1005           end.
     1006           when chr(32) then do:
     1007             if not v-dc
     1008             and not v-sc
     1009             then do:
     1010               assign
     1011               v-sc = no
     1012               v-dc = no
     1013               v-eq = no
     1014               .
     1015               create buf_temp_xmlparse-attrs.
     1016               assign
     1017               buf_temp_xmlparse-attrs.field-name = p-field-name
     1018               buf_temp_xmlparse-attrs.attr-code  = v-code
     1019               buf_temp_xmlparse-attrs.attr-value = trim(v-value, (if v-value begins chr(34) then chr(34) else chr(39)))
     1020               v-code = "":U
     1021               v-value = "":U
     1022               .
     1023             end.
     1024           end.
     1025         END CASE.
     1026         if not v-eq
     1027         then do:
     1028           if not v-char = chr(32) then
     1029           assign
     1030           v-code = v-code + v-char
     1031           .
     1032         end.
     1033         else do:
     1034           if v-char <> "=":U
     1035           then
     1036           assign
     1037           v-value = v-value + v-char
     1038           .
     1039         end.
     1040       end.
     1041       if v-code <> "":U then do:
     1042         create buf_temp_xmlparse-attrs.
     1043         assign
     1044         buf_temp_xmlparse-attrs.field-name = p-field-name
     1045         buf_temp_xmlparse-attrs.attr-code  = v-code
     1046         buf_temp_xmlparse-attrs.attr-value = trim(v-value, (if v-value begins chr(34) then chr(34) else chr(39)))
     1047         .
     1048       end.
     1049     end.
     1050   end procedure.
     1051   FUNCTION cb-xmlparse-get-attr returns character (
     1052         input p-handle        as handle
     1053       , input p-field-name    as character
     1054       , input p-field-value   as character
     1055       , input p-attr-code     as character
     1056       , input p-reparse       as logical
     1057   ) :
     1058   define buffer buf_temp_xmlparse-attrs for temp_xmlparse-attrs.
     1059     do
     1060     on error undo, return error
     1061     :
     1062       if p-reparse then do:
     1063         run cb-xmlparse-attributes in this-procedure (
     1064                                                       input p-handle
     1065                                                     , input p-field-name
     1066                                                     , input p-field-value) no-error .
     1067         if error-status:error then return ? .
     1068       end.
     1069       find first buf_temp_xmlparse-attrs no-lock where
     1070                 buf_temp_xmlparse-attrs.field-name = p-field-name
     1071             AND buf_temp_xmlparse-attrs.attr-code   = p-attr-code no-error .
     1072       if not avail buf_temp_xmlparse-attrs then return ?.
     1073       return buf_temp_xmlparse-attrs.attr-value.
     1074     end.
     1075   end FUNCTION.
     1076   FUNCTION cb-xmlparse-get-date returns date (
     1077                                               input p-string as character):
     1078   define variable v-date as date.
     1079   if index(p-string, "-":U) = 0
     1080   or NOT (length(p-string) = 10
     1081           or
     1082           length(p-string) = 19)
     1083   then return error.
     1084   assign
     1085   v-date =  date(
     1086             int( substr( p-string, 6, 2 ) ) ,
     1087             int( substr( p-string, 9, 2 ) ),
     1088             int( substr( p-string, 1, 4 ) )
     1089               )
     1090   no-error .
     1091   if error-status:error then return error.
     1092   return v-date.
     1093   END FUNCTION.
     1094   FUNCTION cb-xmlparse-get-time returns integer (input p-string as character):
     1095   define variable v-time as integer no-undo .
     1096   define variable v-shift as integer no-undo .
     1097   if index(p-string, ":":U) = 0
     1098   or not (
     1099           length(p-string) = 19
     1100           or
     1101           length(p-string) = 8
     1102           )
     1103   then return error.
     1104   if length(p-string) = 19 then v-shift = 11.
     1105   assign
     1106   v-time =  int( substr( p-string, v-shift + 1, 2 ) ) * 3600 +
     1107             int( substr( p-string, v-shift + 4, 2 ) ) * 60  +
     1108             int( substr( p-string, v-shift + 7, 2) )
     1109   no-error .
     1110   if error-status:error then return error.
     1111   return v-time.
     1112   END FUNCTION.
     1113   define variable vss-include-info4 as character format "X(65)" no-undo
     1114   initial "@(#)$Workfile$ $Revision$".
     1115   define variable v-xmlvalid-error-mode       as character    no-undo.
     1116   define variable v-xmlvalid-tag-value        as character    no-undo.
     1117   define variable v-xmlvalid-current-level    as integer      no-undo.
     1118   define variable v-xmlvalid-in-tag           as logical      no-undo.
     1119   define variable v-xmlvalid-read-vartype     as logical      no-undo.
     1120   define temp-table temp_xmlvalid-taglist no-undo
     1121       field level-num as integer
     1122       field tag-name  as character
     1123       index lv  is primary unique level-num
     1124   .
     1125   define temp-table temp_xmlvalid-field-types no-undo
     1126       field field-name as character
     1127       field field-type as character
     1128       index fn is primary unique field-name
     1129   .
     1130   procedure xmlvalid :
     1131     do
     1132     on error undo, return error
     1133     :
     1134       def input parameter p-handle                as handle   no-undo.
     1135       def input parameter p-buffer-string         as char     no-undo.
     1136       def input parameter p-xmlvalid-error-mode   as char     no-undo.
     1137       assign
     1138           v-xmlvalid-error-mode   = p-xmlvalid-error-mode
     1139       .
     1140       run xmlparse in this-procedure (
     1141                 input p-handle
     1142               , input p-buffer-string
     1143               , input "call-all":U
     1144       ).
     1145     end.
     1146   end procedure.
     1147   procedure cb-xmlparse-tag-start-varType :
     1148   do
     1149   on error undo, return error
     1150   :
     1151   define input parameter p-param as character    no-undo.
     1152       assign
     1153           v-xmlvalid-read-vartype = yes
     1154       .
     1155       run cb-xmlparse-procedure-not-found in this-procedure (
     1156             input "tag-start":U
     1157           , input "varType":U
     1158           , input p-param
     1159       ).
     1160   end.
     1161   end procedure.
     1162   procedure cb-xmlparse-tag-end-varType :
     1163   do
     1164   on error undo, return error
     1165   :
     1166   define input parameter p-param as character    no-undo.
     1167       assign
     1168           v-xmlvalid-read-vartype = no
     1169       .
     1170       define variable v-vartype-list     as character         no-undo.
     1171       for each temp_xmlvalid-field-types
     1172       :
     1173           if index( "character,integer,decimal,date,logical", temp_xmlvalid-field-types.field-type ) = 0
     1174           then do:
     1175               run run-cb-xmlvalid-error  in this-procedure
     1176                                           (     input this-procedure :handle
     1177                                               , input "Замечание: Тип переменной в секции varType определен неверно. "
     1178                                                       + "Тэг " + temp_xmlvalid-field-types.field-name
     1179                                                       + " не будет проверен на соответствие типу данных"
     1180                                           ).
     1181               delete temp_xmlvalid-field-types.
     1182           end.
     1183           else do:
     1184                                           assign
     1185                                               v-vartype-list = v-vartype-list + temp_xmlvalid-field-types.field-name
     1186                                               + temp_xmlvalid-field-types.field-type + chr(10)
     1187                                           .
     1188           end.
     1189       end.
     1190       run cb-xmlparse-procedure-not-found in this-procedure (
     1191                                           input "tag-end":U
     1192                                           , input "varType":U
     1193                                           , input p-param
     1194                                                           ).
     1195   end.
     1196   end procedure.
     1197   procedure cb-xmlparse-procedure-not-found :
     1198   do
     1199   on error undo, return error
     1200   :
     1201   def input parameter p-tag-type      as char no-undo.
     1202   def input parameter p-tag-value     as char no-undo.
     1203   def input parameter p-param-value   as char no-undo.
     1204   def buffer buf_temp_xmlvalid-taglist for temp_xmlvalid-taglist.
     1205   def var v-found    as logical  no-undo.
     1206   if p-tag-type = "tag-start"
     1207   then do:
     1208       assign
     1209           v-xmlvalid-current-level = v-xmlvalid-current-level + 1
     1210           v-xmlvalid-in-tag        = yes
     1211       .
     1212       find first temp_xmlvalid-taglist
     1213            where temp_xmlvalid-taglist.level-num = v-xmlvalid-current-level
     1214       no-error.
     1215       if not available temp_xmlvalid-taglist
     1216       then do:
     1217           create temp_xmlvalid-taglist.
     1218           assign
     1219               temp_xmlvalid-taglist.level-num = v-xmlvalid-current-level
     1220           .
     1221       end.
     1222       assign
     1223           temp_xmlvalid-taglist.tag-name = p-tag-value
     1224           v-xmlvalid-tag-value = ""
     1225       .
     1226       if v-xmlvalid-read-vartype = yes and p-tag-value <> "varType":U
     1227       then do:
     1228           find first temp_xmlvalid-field-types
     1229                where temp_xmlvalid-field-types.field-name = p-tag-value
     1230           no-error.
     1231           if available temp_xmlvalid-field-types
     1232           then do:
     1233               run run-cb-xmlvalid-error  in this-procedure
     1234                                           (     input this-procedure :handle
     1235                                               , input "Замечание: Тип переменной в секции varType определен повторно"
     1236                                           ).
     1237           end.
     1238           else do:
     1239               create temp_xmlvalid-field-types.
     1240               assign
     1241                   temp_xmlvalid-field-types.field-name = p-tag-value
     1242               .
     1243           end.
     1244       end.
     1245   end.
     1246   if p-tag-type = "tag-end"
     1247   then do:
     1248       find first temp_xmlvalid-taglist
     1249            where temp_xmlvalid-taglist.level-num = v-xmlvalid-current-level
     1250              and temp_xmlvalid-taglist.tag-name  = p-tag-value
     1251       no-error.
     1252       if available temp_xmlvalid-taglist
     1253       then do:
     1254           assign
     1255               v-xmlvalid-current-level = v-xmlvalid-current-level - 1
     1256               v-xmlvalid-in-tag        = no
     1257           .
     1258       end.
     1259       else do:
     1260           if v-xmlvalid-error-mode = 'fatal'
     1261           then do:
     1262               run run-cb-xmlvalid-error  in this-procedure
     1263                                           (     input this-procedure :handle
     1264                                               , input "Ошибка: Попытка закрыть не открытый тэг"
     1265                                           ).
     1266           end.
     1267           else do:
     1268               find first temp_xmlvalid-taglist
     1269                    where temp_xmlvalid-taglist.tag-name = p-tag-value
     1270               no-error.
     1271               if not available temp_xmlvalid-taglist
     1272               then do:
     1273                   assign
     1274                       v-xmlvalid-tag-value = v-xmlvalid-tag-value + "</" + p-tag-value + ">" + chr(10)
     1275                   .
     1276               end.
     1277               else do:
     1278                   for each buf_temp_xmlvalid-taglist
     1279                      where buf_temp_xmlvalid-taglist.level-num > temp_xmlvalid-taglist.level-num
     1280                   :
     1281                       assign
     1282                           v-xmlvalid-tag-value = "<" + buf_temp_xmlvalid-taglist.tag-name + ">" + chr(10) + v-xmlvalid-tag-value
     1283                           v-xmlvalid-current-level = temp_xmlvalid-taglist.level-num - 1
     1284                       .
     1285                   end.
     1286               end.
     1287           end.
     1288       end.
     1289   end.
     1290   if p-tag-type = "text"
     1291   then do:
     1292       if v-xmlvalid-read-vartype = yes
     1293       then do:
     1294           if available temp_xmlvalid-field-types
     1295           then do:
     1296               assign
     1297                   temp_xmlvalid-field-types.field-type = v-xmlvalid-tag-value
     1298               .
     1299           end.
     1300       end.
     1301       else do:
     1302           find first temp_xmlvalid-field-types
     1303               where temp_xmlvalid-field-types.field-name = temp_xmlvalid-taglist.tag-name
     1304           no-error.
     1305           if available temp_xmlvalid-field-types
     1306           then do:
     1307           end.
     1308           else do:
     1309           end.
     1310       end.
     1311       assign
     1312           v-xmlvalid-tag-value = v-xmlvalid-tag-value + p-tag-value
     1313       .
     1314   end.
     1315   run run-cb-xmlvalid-procedure-not-found in this-procedure
     1316                                           (     input this-procedure :handle
     1317                                               , input p-tag-type
     1318                                               , input p-tag-value
     1319                                               , input p-param-value
     1320                                           ).
     1321   end.
     1322   end procedure.
     1323   procedure run-cb-xmlvalid-procedure-not-found :
     1324   do
     1325   on error undo, return error
     1326   :
     1327       def input parameter p-handle            as handle   no-undo.
     1328       def input parameter p-data-type         as char     no-undo.
     1329       def input parameter p-data-value        as char     no-undo.
     1330       def input parameter p-param-value       as char     no-undo.
     1331       if lookup("cb-xmlvalid-procedure-not-found", p-handle :internal-entries) > 0
     1332       then do:
     1333           run cb-xmlvalid-procedure-not-found in p-handle (   input p-data-type
     1334                                                             , input p-data-value
     1335                                                             , input p-param-value
     1336                                                           ) no-error.
     1337           if error-status :error
     1338           then do:
     1339               run run-cb-xmlvalid-error in this-procedure
     1340                                       (   input p-handle
     1341                                       ,   input "Ошибка при вызове программы cb-xmlvalid-procedure-not-found"
     1342                                       ).
     1343           end.
     1344       end.
     1345       else do:
     1346           run run-cb-xmlvalid-error in this-procedure
     1347                                   (   input p-handle
     1348                                   ,   input "Ошибка: Не определена программа cb-xmlvalid-procedure-not-found"
     1349                                   ).
     1350       end.
     1351   end.
     1352   end procedure.
     1353   procedure run-cb-xmlvalid-error :
     1354   do
     1355   on error undo, return error
     1356   :
     1357       def input parameter p-handle            as handle no-undo.
     1358       def input parameter p-error-message as char no-undo.
     1359       if lookup("cb-xmlvalid-error", p-handle :internal-entries) > 0
     1360       then do:
     1361           run cb-xmlvalid-error in p-handle  (input p-error-message).
     1362       end.
     1363   end.
     1364   end procedure.
     1365   procedure run-cb-xmlvalid-procedure :
     1366   do
     1367   on error undo, return error
     1368   :
     1369   def input parameter p-handle            as handle no-undo.
     1370   def input parameter p-procedure-name    as char no-undo.
     1371   def var v-data-type     as char no-undo.
     1372   def var v-data-value    as char no-undo.
     1373   def var v-param-value   as char no-undo.
     1374       if lookup( p-procedure-name, p-handle :internal-entries) > 0
     1375       then do:
     1376           run value(p-procedure-name) in p-handle no-error.
     1377           if error-status :error
     1378           then do:
     1379               run run-cb-xmlvalid-error in this-procedure
     1380                                       (   input p-handle
     1381                                       ,   input "Ошибка при вызове программы " + p-procedure-name
     1382                                       ).
     1383           end.
     1384       end.
     1385       else do:
     1386           if substring(p-procedure-name, 1, 20) = "cb-xmlvalid-tag-end-"
     1387           then do:
     1388               assign
     1389                   v-data-type     = "tag-end"
     1390                   v-data-value    = substring(p-procedure-name, 21)
     1391               .
     1392           end.
     1393           else do:
     1394               if substring(p-procedure-name, 1, 22) = "cb-xmlvalid-tag-start-"
     1395               then do:
     1396                   assign
     1397                       v-data-type     = "tag-start"
     1398                       v-data-value    = substring(p-procedure-name, 23)
     1399                   .
     1400               end.
     1401               else do:
     1402                   assign
     1403                       v-data-type     = "text"
     1404                       v-data-value    = p-procedure-name
     1405                   .
     1406               end.
     1407           end.
     1408           run run-cb-xmlvalid-procedure-not-found in this-procedure
     1409                                                  (   input p-handle
     1410                                                     , input v-data-type
     1411                                                     , input v-data-value
     1412                                                     , input v-param-value
     1413                                                   ).
     1414       end.
     1415   end.
     1416   end procedure.
     1417   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1418   procedure gen-b-code :
     1419     define input  parameter type-code like ub.code-range.range-type no-undo .
     1420     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
     1421     do
     1422     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1423     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
     1424     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
     1425     :
     1426       define buffer buf_thbj-attr     for ub.thbj-attr .
     1427       define buffer buf_sys-ctrl   for ub.sys-ctrl .
     1428       define buffer buf_code-range for ub.code-range .
     1429       define variable l-code         as   integer              no-undo .
     1430       define variable v-db-num       like ub.db.db-num         no-undo .
     1431       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
     1432       if type-code = 'sslc':U
     1433       or type-code = 'ssgb':U
     1434       then do:
     1435         message
     1436           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
     1437           "Обратитесь к администратору системы."
     1438           view-as alert-box error .
     1439         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
     1440       end.
     1441       run trg/getpcode.p ( input  type-code
     1442                      ,output cfg-param-code
     1443                     ).
     1444       run get-next-seq( input  type-code,
     1445                         output l-code
     1446                       ).
     1447       find first buf_sys-ctrl no-lock.
     1448       if type-code = 'sclc':U
     1449       or type-code = 'pglc':U
     1450       then do:
     1451         assign
     1452           v-db-num = 0
     1453         .
     1454       end.
     1455       else do:
     1456         assign
     1457           v-db-num = buf_sys-ctrl.db-num
     1458         .
     1459       end.
     1460       find first buf_code-range no-lock
     1461         where buf_code-range.db-num     = v-db-num
     1462           and buf_code-range.range-type = type-code
     1463           and buf_code-range.stts       = "a"
     1464         use-index stts
     1465         no-error .
     1466       if available buf_code-range
     1467          and l-code <= buf_code-range.last-code
     1468          and l-code >= buf_code-range.first-code then do:
     1469         assign
     1470           p-b-code = l-code
     1471         .
     1472       end.
     1473       else do:
     1474         if available buf_code-range
     1475            and l-code < buf_code-range.last-code then do:
     1476           message
     1477             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
     1478             "Обратитесь к администратору системы."
     1479             view-as alert-box error .
     1480           undo, return error "sequence":U .
     1481         end.
     1482         do transaction
     1483         on error undo, return error
     1484         :
     1485           find first buf_thbj-attr exclusive-lock
     1486             where buf_thbj-attr.upper-prop-code = 'code-range':U
     1487               and buf_thbj-attr.prop-code = cfg-param-code
     1488               and buf_thbj-attr.obj-type   = 'БД':U
     1489               and buf_thbj-attr.obj-code   = v-db-num
     1490             no-error .
     1491           if not available buf_thbj-attr then do:
     1492             find first buf_thbj-attr exclusive-lock
     1493               where buf_thbj-attr.upper-prop-code = 'code-range':U
     1494                 and buf_thbj-attr.prop-code = cfg-param-code
     1495                 and buf_thbj-attr.obj-type   = ''
     1496                 and buf_thbj-attr.obj-code   = 0
     1497               no-error .
     1498             if not available buf_thbj-attr then do:
     1499               if not locked buf_thbj-attr then do:
     1500                 message
     1501                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
     1502                   "Обратитесь к администратору системы."
     1503                   view-as alert-box error .
     1504               end.
     1505               undo, return error "config":U .
     1506             end.
     1507           end.
     1508           run get-next-seq( input type-code,
     1509                             output l-code
     1510                           ).
     1511           find first buf_code-range
     1512             where buf_code-range.db-num     = v-db-num
     1513               and buf_code-range.range-type = type-code
     1514               and buf_code-range.stts       = "a"
     1515             use-index stts
     1516             no-error .
     1517           if available buf_code-range
     1518           and l-code <= buf_code-range.last-code
     1519           and l-code >= buf_code-range.first-code
     1520           then do:
     1521             assign
     1522               p-b-code = l-code
     1523             .
     1524           end.
     1525           else do:
     1526             if available buf_code-range then do:
     1527               assign
     1528                 buf_code-range.stts = "u"
     1529               .
     1530             end.
     1531             find first buf_code-range
     1532               where buf_code-range.db-num     = v-db-num
     1533                 and buf_code-range.range-type = type-code
     1534                 and buf_code-range.stts       = "f"
     1535               use-index stts
     1536               no-error .
     1537             if not available buf_code-range then do:
     1538               message
     1539                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
     1540                 "Обратитесь к администратору системы"
     1541                 view-as alert-box error .
     1542               undo, return error "code-range":U .
     1543             end.
     1544             assign
     1545               buf_code-range.stts           = "a"
     1546             .
     1547             if buf_code-range.first-code = 1 then do:
     1548               run set-seq-cr( input type-code,
     1549                               input buf_code-range.first-code
     1550                             ).
     1551               assign
     1552                 p-b-code = 1
     1553               .
     1554             end.
     1555             else do:
     1556               run set-seq-cr( input type-code,
     1557                               input ( buf_code-range.first-code - 1 )
     1558                             ).
     1559               run get-next-seq( input type-code,
     1560                                 output p-b-code
     1561                               ).
     1562             end.
     1563           end.
     1564         end.
     1565       end.
     1566     end.
     1567   end procedure.
     1568   procedure get-next-seq :
     1569     define input  parameter type-code like ub.code-range.range-type no-undo .
     1570     define output parameter next-seq  as   integer                  no-undo .
     1571     do
     1572     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1573     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
     1574     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
     1575     :
     1576       case type-code:
     1577         when 'bcgb':U then do:
     1578           assign
     1579             next-seq = next-value(s-bcgb-code, ub)
     1580           .
     1581         end.
     1582         when 'scgb':U then do:
     1583           assign
     1584             next-seq = next-value(s-scgb-code, ub)
     1585           .
     1586         end.
     1587         when 'sclc':U then do:
     1588           assign
     1589             next-seq = next-value(s-sclc-code, ub)
     1590           .
     1591         end.
     1592         when 'pglc':U then do:
     1593           assign
     1594             next-seq = next-value(s-pglc-code, ub)
     1595           .
     1596         end.
     1597         when 'dcgb':U then do:
     1598           assign
     1599             next-seq = next-value(s-dcgb-code, ub)
     1600           .
     1601         end.
     1602         when 'ctgb':U then do:
     1603           assign
     1604             next-seq = next-value(s-ctgb-code, ub)
     1605           .
     1606         end.
     1607         when 'drgb':U then do:
     1608           assign
     1609             next-seq = next-value(s-drgb-code, ub)
     1610           .
     1611         end.
     1612         when 'fmgb':U then do:
     1613           assign
     1614             next-seq = next-value(s-fmgb-code, ub)
     1615           .
     1616         end.
     1617         when 'pngb':U then do:
     1618           assign
     1619             next-seq = next-value(s-pngb-code, ub)
     1620           .
     1621         end.
     1622         when 'cagb':U then do:
     1623           assign
     1624             next-seq = next-value(s-cagb-code, ub)
     1625           .
     1626         end.
     1627         when 'fdgb':U then do:
     1628           assign
     1629             next-seq = next-value(s-fin-doc, ub)
     1630           .
     1631         end.
     1632       end case.
     1633     end.
     1634   end procedure.
     1635   procedure set-seq-cr :
     1636     define input parameter type-code like ub.code-range.range-type no-undo .
     1637     define input parameter set-val   like ub.code-range.first-code no-undo .
     1638     do
     1639     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1640     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
     1641     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
     1642     :
     1643       case type-code:
     1644         when 'bcgb':U then do:
     1645           assign
     1646             current-value(s-bcgb-code, ub) = set-val
     1647           .
     1648         end.
     1649         when 'scgb':U then do:
     1650           assign
     1651             current-value(s-scgb-code, ub) = set-val
     1652           .
     1653         end.
     1654         when 'sclc':U then do:
     1655           assign
     1656             current-value(s-sclc-code, ub) = set-val
     1657           .
     1658         end.
     1659         when 'pglc':U then do:
     1660           assign
     1661             current-value(s-pglc-code, ub) = set-val
     1662           .
     1663         end.
     1664         when 'dcgb':U then do:
     1665           assign
     1666             current-value(s-dcgb-code, ub) = set-val
     1667           .
     1668         end.
     1669         when 'ctgb':U then do:
     1670           assign
     1671             current-value(s-ctgb-code, ub) = set-val
     1672           .
     1673         end.
     1674         when 'drgb':U then do:
     1675           assign
     1676             current-value(s-drgb-code, ub) = set-val
     1677           .
     1678         end.
     1679         when 'fmgb':U then do:
     1680           assign
     1681             current-value(s-fmgb-code, ub) = set-val
     1682           .
     1683         end.
     1684         when 'pngb':U then do:
     1685           assign
     1686             current-value(s-pngb-code, ub) = set-val
     1687           .
     1688         end.
     1689         when 'cagb':U then do:
     1690           assign
     1691             current-value(s-cagb-code, ub) = set-val
     1692           .
     1693         end.
     1694         when 'fdgb':U then do:
     1695           assign
     1696             current-value(s-fin-doc, ub) = set-val
     1697           .
     1698         end.
     1699       end case.
     1700     end.
     1701   end procedure.
     1702   procedure new-bcod-gen-code-range :
     1703     do
     1704     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1705     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
     1706     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
     1707     :
     1708       define input parameter p-db-num  like ub.db.db-num             no-undo .
     1709       define input parameter type-code like ub.code-range.range-type no-undo .
     1710       define buffer buf_code-range      for ub.code-range .
     1711       define buffer last_code-range     for ub.code-range .
     1712       define buffer last-1_code-range   for ub.code-range .
     1713       define buffer last-2_code-range   for ub.code-range .
     1714       define buffer last-3_code-range   for ub.code-range .
     1715       define buffer buf_sys-ctrl        for ub.sys-ctrl .
     1716       define variable conf-par       as character no-undo .
     1717       define variable par-type       as character no-undo .
     1718       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
     1719       define variable v-cre-cdrg as logical   no-undo .
     1720       define variable v-cre-str  as character no-undo .
     1721       define variable v-cr1      as integer no-undo .
     1722       define variable v-cr2      as integer no-undo .
     1723       define variable v-cr3      as integer no-undo .
     1724       define variable v-cmax     as integer no-undo .
     1725       find first buf_sys-ctrl no-lock .
     1726       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
     1727         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
     1728                                       ,vss-workfile
     1729                                       ,vss-revision
     1730                                       ,vss-description
     1731                                       ,chr(10)
     1732                                       , p-db-num
     1733                                      ).
     1734       end.
     1735       run trg/getpcode.p ( input  type-code
     1736                      ,output cfg-param-code
     1737                     ).
     1738       for each buf_code-range
     1739         where buf_code-range.db-num     = -1
     1740           and buf_code-range.range-type = type-code
     1741           and buf_code-range.stts       = "f"
     1742       by buf_code-range.first-code
     1743       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1744       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
     1745       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
     1746       :
     1747         assign
     1748           buf_code-range.db-num = p-db-num
     1749         .
     1750         return .
     1751       end.
     1752       assign
     1753         v-cre-cdrg = TRUE
     1754       .
     1755       case type-code:
     1756         when 'sclc':U
     1757         or when 'scgb':U
     1758         or when 'pglc':U
     1759         then do:
     1760           find last last-1_code-range no-lock
     1761             where last-1_code-range.range-type = 'sclc':U
     1762             no-error .
     1763           if available last-1_code-range then do:
     1764             v-cr1 = last-1_code-range.last-code.
     1765           end.
     1766           find last last-2_code-range no-lock
     1767             where last-2_code-range.range-type = 'scgb':U
     1768             no-error .
     1769           if available last-2_code-range then do:
     1770             v-cr2 = last-2_code-range.last-code.
     1771             end.
     1772           find last last-3_code-range no-lock
     1773             where last-3_code-range.range-type = 'pglc':U
     1774             no-error .
     1775           if available last-3_code-range then do:
     1776             v-cr3 = last-3_code-range.last-code.
     1777           end.
     1778           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     1779           .
     1780           if v-cmax = v-cr1  then do:
     1781               find last last_code-range no-lock
     1782                 where recid( last_code-range ) = recid( last-1_code-range )
     1783                 .
     1784             end.
     1785           if v-cmax = v-cr2  then do:
     1786               find last last_code-range no-lock
     1787                 where recid( last_code-range ) = recid( last-2_code-range )
     1788                 .
     1789             end.
     1790           if v-cmax = v-cr3  then do:
     1791             find last last_code-range no-lock
     1792               where recid( last_code-range ) = recid( last-3_code-range )
     1793               .
     1794           end.
     1795           if last_code-range.last-code + 1 > 99999 then do:
     1796             assign
     1797               v-cre-cdrg = FALSE
     1798             .
     1799           end.
     1800         end.
     1801         when 'bcgb':U
     1802         or when 'sslc':U
     1803         or when 'ssgb':U
     1804         then do:
     1805           find last last-1_code-range no-lock
     1806             where last-1_code-range.range-type = 'sslc':U
     1807             no-error .
     1808           if available last-1_code-range then do:
     1809             v-cr1 = last-1_code-range.last-code.
     1810           end.
     1811           find last last-2_code-range no-lock
     1812             where last-2_code-range.range-type = 'bcgb':U
     1813             no-error .
     1814           if available last-2_code-range then do:
     1815             v-cr2 = last-2_code-range.last-code.
     1816             end.
     1817           find last last-3_code-range no-lock
     1818             where last-3_code-range.range-type = 'ssgb':U
     1819             no-error .
     1820           if available last-3_code-range then do:
     1821             v-cr3 = last-3_code-range.last-code.
     1822           end.
     1823           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     1824           .
     1825           if v-cmax = v-cr1  then do:
     1826               find last last_code-range no-lock
     1827                 where recid( last_code-range ) = recid( last-1_code-range )
     1828                 .
     1829             end.
     1830           if v-cmax = v-cr2  then do:
     1831               find last last_code-range no-lock
     1832                 where recid( last_code-range ) = recid( last-2_code-range )
     1833                 .
     1834             end.
     1835           if v-cmax = v-cr3  then do:
     1836             find last last_code-range no-lock
     1837               where recid( last_code-range ) = recid( last-3_code-range )
     1838               .
     1839           end.
     1840         end.
     1841         otherwise do:
     1842           find last last_code-range no-lock
     1843             where last_code-range.range-type = type-code
     1844             no-error .
     1845         end.
     1846       end case.
     1847       if not available last_code-range then do:
     1848         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
     1849                                       ,vss-workfile
     1850                                       ,vss-revision
     1851                                       ,vss-description
     1852                                       , chr(10)
     1853                                       , type-code
     1854                                      ) .
     1855       end.
     1856       define variable v-mes5 as character no-undo .
     1857       define variable v-param-type5 as character no-undo .
     1858       define variable v-value-character5 as INTEGER no-undo .
     1859       define variable v-value-date5 as date no-undo .
     1860       define variable v-value-decimal5 as decimal no-undo .
     1861       define variable v-value-integer5 AS integer no-undo .
     1862       define variable v-value-logical5 AS LOGICAL no-undo .
     1863       define variable v-tth5 as handle no-undo .
     1864       run adm/shattri.p (
     1865           input "get":U
     1866           ,input  'БД':U
     1867           ,input  p-db-num
     1868           ,input  'code-range':U
     1869           ,input  cfg-param-code
     1870           ,output v-value-character5
     1871           ,output v-value-date5
     1872           ,output v-value-decimal5
     1873           ,output v-value-integer5
     1874           ,output v-value-logical5
     1875           ,output v-param-type5
     1876           ,INPUT-OUTPUT table-handle v-tth5
     1877           ) no-error .
     1878       if error-status :error then do:
     1879         delete object v-tth5.
     1880         v-mes5 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
     1881                            , error-status:get-message(1)
     1882                            , chr(10)
     1883                            , return-value ).
     1884         undo, return error v-mes5.
     1885       end.
     1886       delete object v-tth5.
     1887       if v-cre-cdrg = TRUE then do:
     1888         create buf_code-range .
     1889         assign
     1890           buf_code-range.db-num     = p-db-num
     1891           buf_code-range.range-type = type-code
     1892           buf_code-range.stts       = "f"
     1893           buf_code-range.first-code = last_code-range.last-code + 1
     1894           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer5)
     1895           v-cre-str = "Свободный диапазон успешно создан"
     1896         .
     1897       end.
     1898       else do:
     1899         assign
     1900           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
     1901                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
     1902         .
     1903       end.
     1904     end.
     1905     return v-cre-str .
     1906   end procedure.
     1907   procedure gen-new-code-range-if-neces :
     1908     define input parameter v-db-num           like ub.db.db-num             no-undo .
     1909     define input parameter v-range-type       like ub.code-range.range-type no-undo .
     1910     define input parameter v-cur-code         as   integer                  no-undo .
     1911     define input parameter v-g#news           as   logical                  no-undo .
     1912     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
     1913     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
     1914     do
     1915     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1916     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
     1917     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
     1918     :
     1919       define variable l-code-range-exist as logical   no-undo init false .
     1920       define variable v-db-for-send      as character no-undo .
     1921       define buffer buf_code-range  for ub.code-range .
     1922       define buffer buf1_code-range for ub.code-range .
     1923       define buffer buf_db          for ub.db .
     1924       find first buf_code-range
     1925         where buf_code-range.range-type = v-range-type
     1926           and buf_code-range.last-code >= v-cur-code
     1927         use-index last-codei
     1928         no-error .
     1929       if
     1930       (
     1931          available buf_code-range
     1932          and
     1933         (buf_code-range.db-num = v-db-num
     1934           and
     1935         buf_code-range.first-code <= v-cur-code
     1936         )
     1937       or
     1938         (
     1939           v-range-type = 'drgb':U
     1940           AND
     1941           v-cur-code = 0
     1942         )
     1943      )
     1944      then do:
     1945         assign
     1946           l-code-range-exist = true
     1947         .
     1948         if v-g#news
     1949         and buf_code-range.stts = "f" then do:
     1950           assign
     1951             buf_code-range.stts = "u"
     1952           .
     1953         end.
     1954       end.
     1955       if not l-code-range-exist
     1956          and v-g#news-source-db <> 0
     1957       then do:
     1958         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
     1959                                       ,vss-workfile
     1960                                       ,vss-revision
     1961                                       ,vss-description
     1962                                       ,chr(10)
     1963                                       ,v-db-num
     1964                                       ,v-range-type
     1965                                       ,v-cur-code
     1966                                      ).
     1967       end.
     1968       if (not l-code-range-exist
     1969           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
     1970          )
     1971       and ( not can-find (first buf1_code-range no-lock
     1972                           where buf1_code-range.db-num = v-db-num
     1973                             and buf1_code-range.range-type = v-range-type
     1974                             and buf1_code-range.stts = "f"
     1975                          )
     1976           )
     1977       then do:
     1978         if v-g#db-num = 0 then do:
     1979           run new-bcod-gen-code-range in this-procedure
     1980             (input v-db-num,
     1981              input v-range-type
     1982             ) no-error .
     1983           if error-status :error then do:
     1984             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
     1985                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
     1986                                           ,v-db-num
     1987                                           ,v-range-type
     1988                                           ,v-cur-code
     1989                                           ,chr(10)
     1990                                           ,error-status:get-message(1)
     1991                                           ,return-value
     1992                                          ).
     1993           end.
     1994         end.
     1995         else do:
     1996           if v-range-type = 'sclc':U
     1997           or v-range-type = 'pglc':U
     1998           then do:
     1999             assign
     2000               v-db-for-send = "":U
     2001             .
     2002             if v-g#db-num = 0 then do:
     2003               for each buf_db no-lock
     2004                 where buf_db.db-num > 0
     2005                   and buf_db.db-num <> v-g#news-source-db
     2006               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2007               :
     2008                 assign
     2009                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
     2010                 .
     2011               end.
     2012               assign
     2013                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
     2014               .
     2015             end.
     2016             else do:
     2017               if not v-g#news then do:
     2018                 assign
     2019                   v-db-for-send = "0":U
     2020                 .
     2021               end.
     2022             end.
     2023             run nws/cr-route.p ( input 'send-cmd':U
     2024                           ,input ("command":U + chr(1) + "create":U + chr(1) +
     2025                                  "code-range":U + chr(1) +
     2026                                  (if v-range-type = 'sclc':U
     2027                                   then string( current-value(s-sclc-code, ub))
     2028                                   else string( current-value(s-pglc-code, ub))
     2029                                   ) + chr(1) +
     2030                                   v-range-type)
     2031                           ,input ?
     2032                           ,input v-db-for-send
     2033                           ) no-error .
     2034             if error-status :error then do:
     2035               undo, return error return-value.
     2036             end.
     2037           end.
     2038         end.
     2039       end.
     2040     end.
     2041   end procedure.
     2042   procedure cre-loc-sc-code-range :
     2043     define input parameter v-cur-code as integer no-undo .
     2044   define input parameter p-cdrg-type as character no-undo .
     2045     do
     2046     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2047     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
     2048     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
     2049     :
     2050       define buffer buf_code-range for ub.code-range .
     2051       find first buf_code-range
     2052            where buf_code-range.range-type = p-cdrg-type
     2053              and buf_code-range.first-code >= v-cur-code
     2054            no-error .
     2055       if not available buf_code-range then do:
     2056         run new-bcod-gen-code-range in this-procedure
     2057           ( input 0,
     2058             input p-cdrg-type
     2059           ) no-error .
     2060         if error-status :error then do:
     2061           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
     2062                                          + "Код &2&1&3 &4"
     2063                                         , chr(10)
     2064                                         , v-cur-code
     2065                                         , error-status:get-message(1)
     2066                                         , return-value
     2067                                        ) .
     2068         end.
     2069       end.
     2070     end.
     2071   end procedure.
     2072   procedure mark-used-if-need :
     2073   define input parameter p-cur-code as integer no-undo .
     2074   define input parameter p-range-type like ub.code-range.range-type no-undo .
     2075   define input parameter p-db-num like ub.code-range.db-num no-undo .
     2076     do
     2077     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2078     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
     2079     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
     2080     :
     2081       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
     2082       define buffer buf_code-range for ub.code-range .
     2083       assign
     2084       v-db-num = if p-range-type = 'sclc':U
     2085                  then 0
     2086                  else p-db-num
     2087       .
     2088   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2089   define buffer locK-batchprocess6 for ub.batchprocess.
     2090   run gbl/lock-prc.p
     2091       (input 'lscc':U
     2092       ,input 0
     2093       ,input 0
     2094       ,input 0
     2095       ,input ""
     2096       ,input ""
     2097       ,input ""
     2098       ,input (
     2099               ",,,Вкл/выкл лок. вес. кодов"
     2100              )
     2101       ,input true
     2102       ,buffer lock-batchprocess6
     2103       ) no-error .
     2104     if error-status :error then do:
     2105       message
     2106         vss-workfile vss-revision vss-description skip
     2107         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     2108         view-as alert-box error .
     2109       undo, return error .
     2110     end.
     2111       find first buf_code-range
     2112            where buf_code-range.range-type = p-range-type
     2113              and buf_code-range.first-code >= p-cur-code
     2114              and buf_code-range.last-code <= p-cur-code
     2115              and buf_code-range.db-num = v-db-num
     2116            no-error .
     2117       if not available buf_code-range then do:
     2118         message
     2119           vss-workfile vss-revision vss-description skip
     2120           "Ошибка при создании поиске диапазона" skip
     2121           "База данных" p-db-num skip
     2122           "Код" p-cur-code skip
     2123           "Тип" p-range-type
     2124           error-status :get-message(1) skip
     2125           return-value skip
     2126           view-as alert-box error .
     2127         undo, return error .
     2128       end.
     2129       if buf_code-range.stts = "f":U then do:
     2130         assign
     2131         buf_code-range.stts = "u":U
     2132         .
     2133       end.
     2134     end.
     2135   end procedure.
     2136   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2137   procedure cur-time :
     2138      define output parameter p-today as date      no-undo .
     2139      define output parameter p-time  as integer   no-undo .
     2140     do
     2141     on error undo, return error
     2142     :
     2143       define variable v-date1 as date      no-undo .
     2144       define variable v-date2 as date      no-undo .
     2145       define variable v-time  as integer   no-undo .
     2146       assign
     2147         v-date1 = today
     2148         v-time  = time
     2149         v-date2 = today
     2150       .
     2151       if v-date1 <> v-date2
     2152       then do:
     2153         assign
     2154           v-date1 = today
     2155           v-time  = v-time
     2156         .
     2157       end.
     2158       assign
     2159         p-today = v-date1
     2160         p-time  = v-time
     2161       .
     2162     end.
     2163   end.
     2164   function cur-time-date returns character
     2165   :
     2166     return string(today, '99/99/9999':U) .
     2167   end.
     2168   function cur-time-mjd returns decimal
     2169   :
     2170     define variable v-date as date      no-undo .
     2171     define variable v-time as integer   no-undo .
     2172     run cur-time in this-procedure
     2173       (output v-date
     2174       ,output v-time
     2175       ) .
     2176     return integer(v-date) - 2400002 + (v-time / 86400) .
     2177   end.
     2178   function cur-time-get-ending-index returns integer
     2179   (input p-number as integer
     2180   )
     2181   :
     2182     if p-number < 0
     2183     or p-number = ?
     2184     then do:
     2185       return 1 .
     2186     end.
     2187     define variable v-rest as integer   no-undo .
     2188     assign
     2189       p-number = p-number modulo 100
     2190     .
     2191     if p-number < 20
     2192     then do:
     2193       assign
     2194         v-rest = p-number
     2195       .
     2196     end.
     2197     else do:
     2198       assign
     2199         v-rest = p-number modulo 10
     2200       .
     2201     end.
     2202     case v-rest :
     2203       when 1
     2204       then do:
     2205         return 2 .
     2206       end.
     2207       when 2 or
     2208       when 3 or
     2209       when 4
     2210       then do:
     2211         return 3 .
     2212       end.
     2213       otherwise do:
     2214         return 1 .
     2215       end.
     2216     end case .
     2217   end.
     2218   procedure cur-time-mjd-to-date :
     2219      define input  parameter i-mjd-diff as decimal no-undo.
     2220      define output parameter o-Date     as date    no-undo.
     2221      define output parameter o-Time     as integer no-undo.
     2222      define variable v-day-number as integer   no-undo .
     2223      if    i-mjd-diff < 0
     2224         or i-mjd-diff = ?
     2225      then do:
     2226         return "?" .
     2227      end.
     2228      assign
     2229         v-day-number = truncate(i-mjd-diff,0).
     2230         o-Date = date(v-day-number + 2400002).
     2231         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     2232     .
     2233   end.
     2234   function cur-time-mjd-to-string returns character
     2235   (input p-mjd-diff as decimal
     2236   )
     2237   :
     2238     define variable v-day-number as integer   no-undo .
     2239     define variable v-seconds    as integer   no-undo .
     2240     define variable v-hour       as integer   no-undo .
     2241     define variable v-min        as integer   no-undo .
     2242     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     2243     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     2244     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     2245     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     2246     if p-mjd-diff < 0
     2247     or p-mjd-diff = ?
     2248     then do:
     2249       return "?" .
     2250     end.
     2251     assign
     2252       v-day-number = integer(truncate(p-mjd-diff,0))
     2253       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     2254     .
     2255     if v-seconds > 86400
     2256     then do:
     2257       assign
     2258         v-seconds = 86400 - 1
     2259       .
     2260     end.
     2261     if v-seconds < 0
     2262     then do:
     2263       assign
     2264         v-seconds = 0
     2265       .
     2266     end.
     2267     assign
     2268       v-hour = truncate(v-seconds / 3600, 0)
     2269     .
     2270     assign
     2271       v-seconds = v-seconds modulo 3600
     2272     .
     2273     assign
     2274       v-min = truncate(v-seconds / 60, 0)
     2275     .
     2276     assign
     2277       v-seconds = v-seconds modulo 60
     2278     .
     2279     return
     2280         (if v-day-number <> 0
     2281           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     2282           else ""
     2283         )
     2284       + (if v-day-number <> 0 or v-hour <> 0
     2285           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2286           else ""
     2287         )
     2288       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2289           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2290           else ""
     2291         )
     2292       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2293       .
     2294   end.
     2295   function cur-time-string returns character
     2296   :
     2297     define variable v-date as date      no-undo .
     2298     define variable v-time as integer   no-undo .
     2299     run cur-time in this-procedure
     2300       (output v-date
     2301       ,output v-time
     2302       ) .
     2303     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2304   end.
     2305   function cur-time-string-sec returns character
     2306   :
     2307     define variable v-date as date      no-undo .
     2308     define variable v-time as integer   no-undo .
     2309     run cur-time in this-procedure
     2310       (output v-date
     2311       ,output v-time
     2312       ) .
     2313     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2314   end.
     2315   function cur-time-custom  returns character
     2316   (input p-prefix as character
     2317   ,input p-date-format as character
     2318   ,input p-delimiter as character
     2319   ,input p-time-format as character
     2320   ,input p-suffix as character
     2321   )
     2322   :
     2323     define variable v-date as date      no-undo .
     2324     define variable v-time as integer   no-undo .
     2325     run cur-time in this-procedure
     2326       (output v-date
     2327       ,output v-time
     2328       ) .
     2329     return
     2330       p-prefix
     2331       + string(v-date, p-date-format)
     2332       + p-delimiter
     2333       + string(v-time, p-time-format)
     2334       + p-suffix
     2335       .
     2336   end.
     2337   function cur-time-print  returns character
     2338   :
     2339     define variable v-date as date      no-undo .
     2340     define variable v-time as integer   no-undo .
     2341     run cur-time in this-procedure
     2342       (output v-date
     2343       ,output v-time
     2344       ) .
     2345     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2346   end.
     2347   function cur-time-datetime returns datetime
     2348   :
     2349     define variable v-char as character no-undo .
     2350     define variable v-datetime as datetime no-undo .
     2351     v-char = cur-time-string().
     2352     v-datetime = datetime(v-char).
     2353     return  v-datetime.
     2354   end.
     2355   function cur-time-string-msec returns character
     2356   :
     2357     define variable v-date as datetime  no-undo .
     2358     v-date = now.
     2359     return string(v-date) .
     2360   end.
     2361   define variable vss-include-info8 as character format "X(65)" no-undo
     2362   initial "@(#)$Workfile$ $Revision$".
     2363   define temp-table temp_grplib_grp no-undo
     2364       field sel           as character
     2365       field nabor         as character
     2366       field full-name     as character
     2367       field print-code    as character
     2368       field sort-name     as character
     2369       field node-code     as integer
     2370       field upper-code    as integer
     2371       field calc-method   as character
     2372       field round-method  as character
     2373       field increase-pc   as decimal
     2374       field min-marg      as character
     2375       field max-marg      as character
     2376       field cli-type      as character
     2377       field cli-code      as integer
     2378       field notcorr      as character
     2379       field name          as character
     2380       field level         as integer
     2381       field mark          as character
     2382       index pi is primary unique sort-name
     2383       index fn full-name
     2384       index nc is unique node-code
     2385       index sl sel
     2386       index uc upper-code
     2387   .
     2388   define temp-table temp_grplib_found-grp no-undo
     2389       field full-name   as character
     2390       field sort-name   as character
     2391       field node-code   as integer
     2392       field level       as integer
     2393       field is-terminal as logical
     2394       index pi is primary unique sort-name
     2395       index fn full-name
     2396       index lv level
     2397       index it is-terminal
     2398   .
     2399   define temp-table temp_found-result-nodelist no-undo
     2400       field node-code     as recid
     2401       field processed     as logical
     2402       field sort-name     as character
     2403       field full-name     as character
     2404       index pi is primary unique node-code
     2405       index ps processed
     2406   .
     2407   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
     2408   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
     2409   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
     2410   procedure grplib-get-parameters :
     2411   define input parameter p-store-type     as character        no-undo.
     2412   define input parameter p-store-code     as integer          no-undo.
     2413   do
     2414   on error undo, return error
     2415   :
     2416       assign
     2417           v-grplib-not-fill-extra-info = no
     2418       .
     2419   end.
     2420   end procedure.
     2421   procedure grplib-get-sort-name :
     2422   do
     2423   on error undo, return error
     2424   :
     2425   define input parameter p-node-code  as integer      no-undo.
     2426   define output parameter p-sort-name as character    no-undo.
     2427       define variable v-upper-code    as integer           no-undo.
     2428       define buffer buf_gds-grp       for ub.gds-grp.
     2429       define buffer buf_upper_gds-grp for ub.gds-grp.
     2430       find first buf_gds-grp no-lock
     2431            where buf_gds-grp.node-code = p-node-code
     2432       no-error.
     2433       if not available buf_gds-grp
     2434       then do:
     2435           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2436       end.
     2437       assign
     2438           p-sort-name  = ""
     2439           v-upper-code = 1
     2440       .
     2441       do while buf_gds-grp.upper-code <> 0
     2442       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
     2443       :
     2444           assign
     2445               p-sort-name  = buf_gds-grp.node-name
     2446                            + (if p-sort-name <> "" then chr(2) else "")
     2447                            + p-sort-name
     2448               v-upper-code = buf_gds-grp.upper-code
     2449           .
     2450           find first buf_gds-grp no-lock
     2451                where buf_gds-grp.node-code = v-upper-code
     2452           no-error.
     2453           if not available buf_gds-grp
     2454           then do:
     2455               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
     2456                                   + string( v-upper-code )
     2457                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2458           end.
     2459       end.
     2460   end.
     2461   end procedure.
     2462   define variable vss-include-info9 as character format "X(65)" no-undo
     2463   initial "@(#)$Workfile$ $Revision$".
     2464   procedure grplib-get-full-name :
     2465      define input parameter p-node-code  as integer      no-undo.
     2466      define output parameter p-full-name as character    no-undo.
     2467      do
     2468   on error undo, return error
     2469   :
     2470       define variable v-upper-code    as integer           no-undo.
     2471       define buffer buf_gds-grp       for ub.gds-grp.
     2472       define buffer buf_upper_gds-grp for ub.gds-grp.
     2473       find first buf_gds-grp no-lock
     2474            where buf_gds-grp.node-code = p-node-code
     2475       no-error.
     2476       if not available buf_gds-grp
     2477       then do:
     2478           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2479       end.
     2480       assign
     2481           p-full-name  = ""
     2482           v-upper-code = 1
     2483       .
     2484       do while buf_gds-grp.upper-code <> 0
     2485       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     2486       :
     2487           assign
     2488               p-full-name  = buf_gds-grp.node-name
     2489                            + (if p-full-name <> "" then chr(47) else "")
     2490                            + p-full-name
     2491               v-upper-code = buf_gds-grp.upper-code
     2492           .
     2493           find first buf_gds-grp no-lock
     2494                where buf_gds-grp.node-code = v-upper-code
     2495           no-error.
     2496           if not available buf_gds-grp
     2497           then do:
     2498               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     2499                                   + string( v-upper-code )
     2500                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2501           end.
     2502       end.
     2503       assign
     2504       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2505       .
     2506   end.
     2507   end .
     2508   procedure grplib-get-node-from-full-name :
     2509   define input parameter p-full-name as character no-undo .
     2510   define output parameter p-node-code as integer no-undo .
     2511   define variable v-ii as integer no-undo .
     2512   define variable v-upper-code as integer no-undo .
     2513   define variable v-root-code as integer no-undo .
     2514   define variable v-entry as character no-undo .
     2515   define buffer buf_gds-grp       for ub.gds-grp.
     2516   do
     2517   on error undo, return error
     2518   :
     2519     find first buf_gds-grp no-lock
     2520         where buf_gds-grp.upper-code = 0
     2521     no-error .
     2522     if not available buf_gds-grp
     2523     then do:
     2524         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     2525     end.
     2526     else do:
     2527       assign
     2528       v-root-code = buf_gds-grp.node-code
     2529       .
     2530     end.
     2531     v-upper-code = v-root-code.
     2532     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2533       assign
     2534       v-entry = entry(v-ii, p-full-name, chr(47)).
     2535       if v-entry = '' then leave.
     2536       find first buf_gds-grp no-lock where
     2537                 buf_gds-grp.node-name = v-entry
     2538             and buf_gds-grp.upper-code = v-upper-code
     2539             no-error.
     2540       if not available buf_gds-grp then do:
     2541         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2542       end.
     2543       else do:
     2544         p-node-code = buf_gds-grp.node-code.
     2545         v-upper-code = buf_gds-grp.node-code.
     2546       end.
     2547     end.
     2548   end.
     2549   end .
     2550   procedure grplib-get-root-code :
     2551   do
     2552   on error undo, return error
     2553   :
     2554   define output parameter p-root-code as integer      no-undo.
     2555       define buffer buf_gds-grp       for ub.gds-grp.
     2556       find first buf_gds-grp no-lock
     2557           where buf_gds-grp.upper-code = 0
     2558       no-error .
     2559       if not available buf_gds-grp
     2560       then do:
     2561           undo, return error .
     2562       end.
     2563       else do:
     2564           assign
     2565               p-root-code = buf_gds-grp.node-code
     2566           .
     2567       end.
     2568   end.
     2569   end procedure.
     2570   procedure grplib-find-grp-by-full-name :
     2571   do
     2572   on error undo, return error
     2573   :
     2574   define input parameter p-search-name  as character    no-undo.
     2575   define input parameter p-fill-path    as logical      no-undo.
     2576   define output parameter p-found       as logical      no-undo.
     2577       define variable v-upper-code    as integer          no-undo.
     2578       define variable v-counter       as integer           no-undo.
     2579       define variable v-level         as integer           no-undo.
     2580       define variable v-full-name     as character         no-undo.
     2581       define variable v-sort-name     as character         no-undo.
     2582       define buffer buf_gds-grp       for ub.gds-grp.
     2583       assign
     2584           p-search-name = replace( p-search-name, chr(47), chr(2) )
     2585       .
     2586       run grplib-get-root-code ( output v-upper-code ) no-error .
     2587       if error-status :error
     2588       then do:
     2589           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
     2590       end.
     2591       assign
     2592           v-full-name  = ""
     2593           v-level      = num-entries( p-search-name, chr(2) )
     2594       .
     2595       for each temp_grplib_found-grp
     2596       :
     2597           delete temp_grplib_found-grp.
     2598       end.
     2599       start-name-analyze:
     2600       do v-counter = 1 to v-level
     2601       :
     2602           if v-counter < v-level
     2603           then do:
     2604               find first buf_gds-grp no-lock
     2605                    where buf_gds-grp.upper-code = v-upper-code
     2606                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     2607               no-error .
     2608               if not available buf_gds-grp
     2609               then do:
     2610                   assign
     2611                       v-full-name  = p-search-name
     2612                       v-sort-name  = p-search-name
     2613                   .
     2614                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     2615               end.
     2616               else do:
     2617                   assign
     2618                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
     2619                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
     2620                       v-upper-code = buf_gds-grp.node-code
     2621                   .
     2622                   if p-fill-path = yes
     2623                   then do:
     2624                       create temp_grplib_found-grp.
     2625                       assign
     2626                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
     2627                           temp_grplib_found-grp.sort-name = v-sort-name
     2628                           temp_grplib_found-grp.node-code = v-upper-code
     2629                           temp_grplib_found-grp.level     = v-counter
     2630                       .
     2631                   end.
     2632               end.
     2633           end.
     2634           else do:
     2635               for each buf_gds-grp no-lock
     2636                  where buf_gds-grp.upper-code = v-upper-code
     2637                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     2638               :
     2639                   assign
     2640                       p-found = yes
     2641                   .
     2642                   create temp_grplib_found-grp.
     2643                   assign
     2644                       temp_grplib_found-grp.full-name = v-full-name
     2645                                                           + (if v-full-name = "" then "" else chr(47) )
     2646                                                           + buf_gds-grp.node-name + chr(47)
     2647                       temp_grplib_found-grp.sort-name = v-sort-name
     2648                                                           + ( if v-sort-name = "" then "" else chr(2) )
     2649                                                           + buf_gds-grp.node-name
     2650                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
     2651                       temp_grplib_found-grp.level     = v-level
     2652                   .
     2653               end.
     2654               if p-found = no
     2655               then do:
     2656                   assign
     2657                       v-full-name  = p-search-name
     2658                       v-sort-name  = p-search-name
     2659                   .
     2660                   for each temp_grplib_found-grp
     2661                   :
     2662                       delete temp_grplib_found-grp.
     2663                   end.
     2664                   assign
     2665                       p-found = no
     2666                   .
     2667               end.
     2668           end.
     2669       end.
     2670   end.
     2671   end procedure.
     2672   procedure grplib-find-all-subgroup :
     2673   do
     2674   on error undo, return error
     2675   :
     2676   define input parameter p-start-node-code    as integer      no-undo.
     2677   define input parameter p-terminal-only      as logical      no-undo.
     2678       define variable v-start-full-name   as character     no-undo.
     2679       define variable v-start-sort-name   as character     no-undo.
     2680       define variable v-not-found         as logical       no-undo.
     2681       define variable v-is-terminal       as logical       no-undo.
     2682       define buffer buf_gds-grp           for ub.gds-grp.
     2683       create temp_found-result-nodelist.
     2684       assign
     2685           temp_found-result-nodelist.node-code = p-start-node-code
     2686           temp_found-result-nodelist.processed = no
     2687       .
     2688       run grplib-get-full-name in this-procedure (
     2689             input p-start-node-code
     2690           , output v-start-full-name
     2691       ).
     2692       run grplib-get-full-name in this-procedure (
     2693             input p-start-node-code
     2694           , output v-start-sort-name
     2695       ).
     2696       process-nodes:
     2697       do while yes
     2698       :
     2699           find first temp_found-result-nodelist
     2700                where temp_found-result-nodelist.node-code = p-start-node-code
     2701           .
     2702           assign
     2703               temp_found-result-nodelist.processed = yes
     2704           .
     2705           for each buf_gds-grp no-lock
     2706              where buf_gds-grp.upper-code = p-start-node-code
     2707           on error undo, return error
     2708           :
     2709               run grplib-is-terminal in this-procedure (
     2710                     input buf_gds-grp.node-code
     2711                   , output v-is-terminal
     2712               ).
     2713               if v-is-terminal = yes
     2714               then do:
     2715                   create temp_grplib_found-grp.
     2716                   assign
     2717                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     2718                                                           chr(47) + buf_gds-grp.node-name + chr(47)
     2719                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     2720                                                           chr(2) + buf_gds-grp.node-name + chr(2)
     2721                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     2722                       temp_grplib_found-grp.is-terminal = yes
     2723                   .
     2724               end.
     2725               else do:
     2726                   create temp_found-result-nodelist.
     2727                   assign
     2728                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
     2729                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     2730                                                              chr(47) + buf_gds-grp.node-name + chr(47)
     2731                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     2732                                                              chr(2) + buf_gds-grp.node-name + chr(2)
     2733                       temp_found-result-nodelist.processed = no
     2734                   .
     2735                   if p-terminal-only = no
     2736                   then do:
     2737                       create temp_grplib_found-grp.
     2738                       assign
     2739                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     2740                                                               chr(47) + buf_gds-grp.node-name + chr(47)
     2741                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     2742                                                               chr(2) + buf_gds-grp.node-name + chr(2)
     2743                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     2744                           temp_grplib_found-grp.is-terminal = no
     2745                       .
     2746                   end.
     2747               end.
     2748           end.
     2749           find first temp_found-result-nodelist
     2750                where temp_found-result-nodelist.processed = no
     2751           no-error.
     2752           if not available temp_found-result-nodelist
     2753           then do:
     2754               leave process-nodes.
     2755           end.
     2756           else do:
     2757               assign
     2758                   p-start-node-code = temp_found-result-nodelist.node-code
     2759                   v-start-full-name = temp_found-result-nodelist.full-name
     2760                   v-start-sort-name = temp_found-result-nodelist.sort-name
     2761               .
     2762           end.
     2763       end.
     2764   end.
     2765   end procedure.
     2766   procedure grplib-expand-name :
     2767   define input parameter p-start-name as character        no-undo.
     2768   define output parameter p-end-name  as character        no-undo.
     2769       define variable v-is-terminal   as logical      no-undo.
     2770       define variable v-found         as character    no-undo.
     2771       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     2772   do
     2773   for buf_temp_grplib_found-grp
     2774   on error undo, return error
     2775   :
     2776       run grplib-find-grp-by-full-name in this-procedure (
     2777             input p-start-name
     2778           , input no
     2779           , output v-found
     2780       ) no-error.
     2781       run grplib-get-max-substring in this-procedure (
     2782                   input length( p-start-name )
     2783                 , output p-end-name
     2784       ) no-error .
     2785       if error-status :error
     2786       then do:
     2787           assign
     2788               p-end-name = ""
     2789           .
     2790       end.
     2791       else do:
     2792           find first temp_grplib_found-grp
     2793               where temp_grplib_found-grp.full-name = p-end-name
     2794           no-error.
     2795           if available temp_grplib_found-grp
     2796           then do:
     2797               find first buf_temp_grplib_found-grp
     2798                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     2799                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     2800               no-error.
     2801               if not available buf_temp_grplib_found-grp
     2802               then do:
     2803                   run grplib-is-terminal in this-procedure (
     2804                       input temp_grplib_found-grp.node-code
     2805                       , output v-is-terminal
     2806                   ).
     2807               end.
     2808           end.
     2809       end.
     2810   end.
     2811   end procedure.
     2812   procedure grplib-get-max-substring :
     2813   do
     2814   on error undo, return error
     2815   :
     2816   define input parameter p-min-substring-length   as integer      no-undo.
     2817   define output parameter p-substring             as character    no-undo.
     2818           define variable v-char-counter  as integer           no-undo.
     2819           define variable v-current-char  as character         no-undo.
     2820           define variable v-names-counter  as integer           no-undo.
     2821           define variable v-base-string   as character         no-undo.
     2822           assign
     2823               v-char-counter  = p-min-substring-length
     2824           .
     2825           find first temp_grplib_found-grp no-error.
     2826           if not available temp_grplib_found-grp
     2827           then do:
     2828               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     2829           end.
     2830           else do:
     2831               assign
     2832                   v-base-string  = temp_grplib_found-grp.full-name
     2833                   v-char-counter = 0
     2834               .
     2835               counter-block:
     2836               do while yes
     2837               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     2838               :
     2839                   assign
     2840                       v-char-counter  = v-char-counter + 1
     2841                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     2842                       v-names-counter = 0
     2843                   .
     2844                   compare-block:
     2845                   for each temp_grplib_found-grp
     2846                   :
     2847                       assign
     2848                           v-names-counter = v-names-counter + 1
     2849                       .
     2850                       if v-names-counter = 1
     2851                       then do:
     2852                           next compare-block.
     2853                       end.
     2854                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     2855                       then do:
     2856                           leave counter-block.
     2857                       end.
     2858                   end.
     2859                   if v-names-counter = 1
     2860                   then do:
     2861                       assign
     2862                           p-substring = v-base-string
     2863                       .
     2864                       return.
     2865                   end.
     2866               end.
     2867               assign
     2868                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     2869               .
     2870           end.
     2871   end.
     2872   end procedure.
     2873   procedure grplib-is-terminal :
     2874   do
     2875   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     2876   :
     2877   define input parameter p-node-code      as integer      no-undo.
     2878   define output parameter p-is-terminal   as logical      no-undo.
     2879       define buffer buf_gds-grp       for ub.gds-grp.
     2880       find first buf_gds-grp no-lock
     2881           where buf_gds-grp.upper-code = p-node-code
     2882       no-error .
     2883       if not available buf_gds-grp
     2884       then do:
     2885           assign
     2886               p-is-terminal = yes
     2887           .
     2888       end.
     2889       else do:
     2890           assign
     2891               p-is-terminal = no
     2892           .
     2893       end.
     2894   end.
     2895   end procedure.
     2896   procedure grplib-have-goods :
     2897   do
     2898   on error undo, return error
     2899   :
     2900   define input parameter p-node-code      as integer      no-undo.
     2901   define output parameter p-have-goods   as logical      no-undo.
     2902       define buffer buf_goods         for ub.goods.
     2903       find first buf_goods no-lock
     2904            where buf_goods.grp-code = p-node-code
     2905       no-error .
     2906       if available buf_goods
     2907       then do:
     2908           assign
     2909               p-have-goods = yes
     2910           .
     2911       end.
     2912       else do:
     2913           assign
     2914               p-have-goods = no
     2915           .
     2916       end.
     2917   end.
     2918   end procedure.
     2919   procedure grplib-find-by-substring :
     2920   do
     2921   on error undo, return error
     2922   :
     2923   define input parameter p-start-code         as integer      no-undo.
     2924   define input parameter p-full-search-string as character    no-undo.
     2925   define output parameter p-found-code        as integer      no-undo.
     2926   define output parameter p-full-name         as character    no-undo.
     2927       define variable v-start-code     as integer           no-undo.
     2928       define variable v-found          as logical  init no  no-undo.
     2929       define buffer buf_gds-grp       for ub.gds-grp.
     2930       search-grp:
     2931       for each buf_gds-grp no-lock
     2932           where buf_gds-grp.node-code > p-start-code
     2933       :
     2934           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     2935           then do:
     2936               assign
     2937                   p-found-code = buf_gds-grp.node-code
     2938                   v-found      = yes
     2939               .
     2940               run grplib-get-full-name in this-procedure (
     2941                     input p-found-code
     2942                   , output p-full-name
     2943               ) no-error .
     2944               if error-status :error
     2945               then do:
     2946                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     2947               end.
     2948               leave search-grp.
     2949           end.
     2950       end.
     2951       if v-found = yes
     2952       then do:
     2953       end.
     2954       else do:
     2955           assign
     2956               p-full-name  = ""
     2957               p-found-code = 0
     2958           .
     2959       end.
     2960   end.
     2961   end procedure.
     2962   procedure grplib-analyze-grp-name :
     2963   do
     2964   on error undo, return error
     2965   :
     2966   define input parameter p-grp-name       as character            no-undo.
     2967   define input parameter p-upper-code     as integer              no-undo.
     2968   define output parameter p-error-message as character init ""    no-undo.
     2969       define variable v-char-list     as character    no-undo.
     2970       define variable v-char-counter  as integer      no-undo.
     2971       define variable v-full-name     as character    no-undo.
     2972       if p-grp-name = "" then do:
     2973           assign
     2974               p-error-message = "Название группы не может быть пустым.".
     2975           .
     2976       end.
     2977       else do:
     2978           assign
     2979               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     2980           .
     2981           do v-char-counter = 1 to num-entries( v-char-list )
     2982           :
     2983               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     2984               then do:
     2985                   assign
     2986                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     2987                   .
     2988                   return.
     2989               end.
     2990           end.
     2991           if p-upper-code > 0
     2992           then do:
     2993               run grplib-get-full-name in this-procedure (
     2994                     input p-upper-code
     2995                   , output v-full-name
     2996               ) no-error .
     2997               if error-status :error
     2998               then do:
     2999                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     3000               end.
     3001               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     3002               then do:
     3003                   assign
     3004                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     3005                   .
     3006               end.
     3007           end.
     3008       end.
     3009   end.
     3010   end procedure.
     3011   procedure grplib-get-lvl-num :
     3012   define input parameter p-node-code  as integer      no-undo.
     3013   define output parameter p-lvl-num   as integer      no-undo.
     3014       define variable v-full-name    as character    no-undo.
     3015   do
     3016   on error undo, return error
     3017   :
     3018       run grplib-get-full-name in this-procedure (
     3019             input p-node-code
     3020           , output v-full-name
     3021       ).
     3022       assign
     3023           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     3024       .
     3025       if p-lvl-num = -1
     3026       then do:
     3027           assign
     3028               p-lvl-num = 0
     3029           .
     3030       end.
     3031   end.
     3032   end procedure.
     3033   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3034   procedure doc-code:
     3035   define input  parameter parmode          as   character           no-undo.
     3036   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     3037   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     3038   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     3039   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     3040   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     3041   define variable vardb-remote     as   logical             no-undo.
     3042   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     3043   define variable v-delimiter as character no-undo .
     3044   do
     3045   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     3046   :
     3047   find first buf_sys-ctrl no-lock .
     3048   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     3049     CASE parmode:
     3050       when "main":u then do:
     3051         if vardb-remote then do:
     3052           assign
     3053             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     3054         end.
     3055         else do:
     3056           assign
     3057             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     3058         end.
     3059       end.
     3060       when "trio" then do:
     3061         assign
     3062           pardoc-code = replace (parroot-doc-code, "=", "*").
     3063       end.
     3064       otherwise do:
     3065         assign
     3066         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     3067         no-error
     3068         .
     3069         if error-status:error  then do:
     3070           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     3071                                         ,chr(10)
     3072                                         ,parmode
     3073                                         ).
     3074         end.
     3075         if num-entries(parmode) = 1
     3076         and parmode <> "chip":U
     3077         and parmode <> "chip_s":U
     3078         then do:
     3079           assign
     3080           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     3081         end.
     3082         else if (lookup("chip":U, parmode) > 0
     3083                  or
     3084                  lookup("chip_s":U, parmode) > 0) then do:
     3085           assign
     3086             vartemp-doc-code = parroot-doc-code.
     3087           do while true:
     3088             if index (vartemp-doc-code , ".") = 0 then
     3089               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     3090             else
     3091               vartemp-doc-code  =
     3092               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     3093               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     3094               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     3095             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     3096           end.
     3097           assign
     3098             pardoc-code = vartemp-doc-code.
     3099         end.
     3100       end.
     3101     end CASE.
     3102     if pardoc-code = '':U
     3103     or (parroot-doc-code <> '':U
     3104     and pardoc-code = parroot-doc-code) then do:
     3105       undo, return error substitute("Ошибка при генерации номера документа&1"
     3106                                     ,chr(10)).
     3107     end.
     3108   end.
     3109   end. // procedure/method
     3110   function get-doc-code-int64 returns int64
     3111     ( input p-doc-code as character ) :
     3112     define variable v-ind              as integer   no-undo .
     3113     define variable v-num-entries      as integer   no-undo .
     3114     define variable v-doc-code-int64   as int64     no-undo .
     3115     define variable v-canonic-doc-code as character no-undo .
     3116     assign
     3117       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     3118       v-canonic-doc-code = p-doc-code
     3119     .
     3120     do v-ind = 1 to v-num-entries
     3121     :
     3122       assign
     3123         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     3124       .
     3125     end.
     3126     assign
     3127       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     3128     .
     3129     return v-doc-code-int64 .
     3130   end. // function/method
