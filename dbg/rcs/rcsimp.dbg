     4127        SIZE 35.5 BY 1 NO-UNDO.
     4128   DEFINE VARIABLE fi-dir-imp AS CHARACTER FORMAT "X(256)":U
     4129        VIEW-AS FILL-IN
     4130        SIZE 36.88 BY 1 NO-UNDO.
     4131   DEFINE VARIABLE fi-log AS CHARACTER FORMAT "X(256)":U
