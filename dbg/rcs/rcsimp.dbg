      168   procedure xmlchar-test :
      169   define input parameter p-in-string          as character        no-undo.
      170   define output parameter p-out-string-enc    as character        no-undo.
      171   define output parameter p-out-string-dec    as character        no-undo.
      172   do
      173   on error undo, return error
      174   :
      175          run xmlchar-encode in this-procedure
      176       (
      177             input p-in-string
      178           , output p-out-string-enc
      179       ).
      180          run xmlchar-decode in this-procedure
      181       (
      182             input p-out-string-enc
      183           , output p-out-string-dec
      184       ).
      185   end.
      186   end .
      187   procedure xmlchar-encode :
      188   define input parameter p-in-string      as character        no-undo.
      189   define output parameter p-out-string    as character        no-undo.
      190       define variable v-position      as integer      no-undo.
      191       define variable v-current-char  as character    no-undo.
      192   do
      193   on error undo, return error
      194   :
      195       assign
      196           p-out-string = "":U
      197       .
      198       case p-in-string
      199       :
      200           when ?
      201           then do:
      202               assign
      203                   p-out-string = "?":U
      204               .
      205           end.
      206           when "?":U
      207           then do:
      208               assign
      209                   p-out-string = "&#63;":U
      210               .
      211           end.
      212           otherwise do:
      213               do v-position = 1 to length( p-in-string )
      214               :
      215                   assign
      216                       v-current-char = substring( p-in-string, v-position, 1 )
      217                   .
      218                   case v-current-char
      219                   :
      220                       when "&":U
      221                       then do:
      222                           assign
      223                               p-out-string = p-out-string + "&amp;":U
      224                           .
      225                       end.
      226                       when ">":U
      227                       then do:
      228                           assign
      229                               p-out-string = p-out-string + "&gt;":U
      230                           .
      231                       end.
      232                       when "<":U
      233                       then do:
      234                           assign
      235                               p-out-string = p-out-string + "&lt;":U
      236                           .
      237                       end.
      238                       when "'":U
      239                       then do:
      240                           assign
      241                               p-out-string = p-out-string + "&apos;":U
      242                           .
      243                       end.
      244                       when '"':U
      245                       then do:
      246                           assign
      247                               p-out-string = p-out-string + "&quot;":U
      248                           .
      249                       end.
      250                       when chr(1)
      251                       then do:
      252                           assign
      253                               p-out-string = p-out-string + "":U
      254                           .
      255                       end.
      256                       when chr(2)
      257                       then do:
      258                           assign
      259                               p-out-string = p-out-string + "":U
      260                           .
      261                       end.
      262                       when chr(3)
      263                       then do:
      264                           assign
      265                               p-out-string = p-out-string + "":U
      266                           .
      267                       end.
      268                       when chr(4)
      269                       then do:
      270                           assign
      271                               p-out-string = p-out-string + "":U
      272                           .
      273                       end.
      274                       when chr(5)
      275                       then do:
      276                           assign
      277                               p-out-string = p-out-string + "":U
      278                           .
      279                       end.
      280                       when chr(6)
      281                       then do:
      282                           assign
      283                               p-out-string = p-out-string + "":U
      284                           .
      285                       end.
      286                       when chr(7)
      287                       then do:
      288                           assign
      289                               p-out-string = p-out-string + "":U
      290                           .
      291                       end.
      292                       when chr(8)
      293                       then do:
      294                           assign
      295                               p-out-string = p-out-string + "":U
      296                           .
      297                       end.
      298                       when chr(9)
      299                       then do:
      300                           assign
      301                               p-out-string = p-out-string + "":U
      302                           .
      303                       end.
      304                       when chr(29)
      305                       then do:
      306                           assign
      307                               p-out-string = p-out-string + "":U
      308                           .
      309                       end.
      310                       when chr(10)
      311                       then do:
      312                           assign
      313                               p-out-string = p-out-string + "&#10;":U
      314                           .
      315                       end.
      316                       when chr(13)
      317                       then do:
      318                           assign
      319                               p-out-string = p-out-string + "&#13;":U
      320                           .
      321                       end.
      322                       otherwise do:
      323                           assign
      324                               p-out-string = p-out-string + v-current-char
      325                           .
      326                       end.
      327                   end case.
      328               end.
      329           end.
      330       end case.
      331   end.
      332   end .
      333   procedure xmlchar-encode-1c :
