     3217   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3218   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
     3219                                                       ,input p-range-type as character
     3220                                                       ,input p-code as integer):
     3221   define variable v-seq-val as integer no-undo .
     3222   define buffer buf_code-range for ub.code-range.
     3223   find first buf_code-range no-lock where
     3224             buf_code-range.db-num = p-db-num
     3225       and  buf_code-range.range-type = p-range-type
     3226       and  buf_code-range.stts = 'u'
     3227       and buf_code-range.first-code <= p-code
     3228       and buf_code-range.last-code >= p-code no-error .
     3229   if available buf_code-range then return yes.
     3230   CASE p-range-type:
     3231     when 'pngb':U then do:
     3232       v-seq-val = current-value(s-pngb-code, ub).
     3233     end.
     3234     when 'fmgb':U then do:
     3235       v-seq-val = current-value(s-fmgb-code, ub).
     3236     end.
     3237   END CASE.
     3238   if p-code <= v-seq-val then do:
     3239     find first buf_code-range no-lock where
     3240               buf_code-range.db-num = p-db-num
     3241         and  buf_code-range.range-type = p-range-type
     3242         and  buf_code-range.stts = 'a'
     3243         and buf_code-range.first-code <= p-code
     3244         no-error .
     3245    if available buf_code-range then return yes.
     3246   end.
     3247   find first buf_code-range no-lock where
     3248             buf_code-range.db-num = p-db-num
     3249       and  buf_code-range.range-type = p-range-type
     3250       and  buf_code-range.stts = 'f'
     3251       and buf_code-range.first-code <= p-code
     3252       and buf_code-range.last-code >= p-code
     3253       no-error .
     3254   if available buf_code-range then return yes.
     3255   return no.
     3256   END FUNCTION.
     3257   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
     3258                                                       ,input p-range-type as character
     3259                                                       ,input p-code as integer):
     3260   define variable v-seq-val as integer no-undo .
     3261   define buffer buf_code-range for ub.code-range.
     3262   CASE p-range-type:
     3263     when 'pngb':U then do:
     3264       v-seq-val = current-value(s-pngb-code, ub).
     3265     end.
     3266     when 'fmgb':U then do:
     3267       v-seq-val = current-value(s-fmgb-code, ub).
     3268     end.
     3269   END CASE.
     3270   if p-code <= v-seq-val then do:
     3271     find first buf_code-range no-lock where
     3272               buf_code-range.db-num = p-db-num
     3273         and  buf_code-range.range-type = p-range-type
     3274         and buf_code-range.first-code <= p-code
     3275         and buf_code-range.last-code >= p-code no-error .
     3276     if available buf_code-range then return yes.
     3277   end.
     3278   return no.
     3279   END FUNCTION.
     3280   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
     3281                                                       ,input p-db-num as integer
     3282                                                       ,input p-staff-code as integer
     3283                                                       ,input p-date as date
     3284                                                        ):
     3285   define buffer buf_staff for ub.staff.
     3286   if p-date = ? then do:
     3287     p-date = today .
     3288   end.
     3289   find first buf_staff no-lock where
     3290             buf_staff.role = p-role
     3291         and buf_staff.role-level = 'db':U
     3292         and buf_staff.db-num = p-db-num
     3293         and buf_staff.staff-code = p-staff-code
     3294         and buf_staff.date-end >= p-date use-index pi  no-error .
     3295   if available buf_staff then do:
     3296     return buf_staff.psn-code.
     3297   end.
     3298   return 0.
     3299   end FUNCTION.
     3300   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
     3301                                                             ,input p-db-num as integer
     3302                                                             ,input p-date as date
     3303                                                                 ):
     3304   define buffer buf_staff for ub.staff.
     3305   define buffer buf2_staff for ub.staff.
     3306   if p-date = ? then do:
     3307     p-date = today .
     3308   end.
     3309   for each  buf_staff no-lock where
     3310             buf_staff.role = p-role
     3311         and buf_staff.db-num = p-db-num,
     3312   first buf2_staff no-lock where
     3313         buf2_staff.role = p-role
     3314     and buf2_staff.role-level = 'db':U
     3315     and buf2_staff.staff-code = buf_staff.staff-code
     3316     and buf2_staff.date-start <= p-date
     3317     and buf2_staff.date-end >= p-date
     3318   by buf_staff.staff-code
     3319   by date-start descending:
     3320     return buf_staff.staff-code.
     3321   end.
     3322   end FUNCTION.
     3323   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
     3324                                                  ,input p-db-num as integer
     3325                                                  ,input p-psn-code as integer
     3326                                                  ,input p-date as date
     3327                                                  ,output p-c-password as character
     3328                                                        ):
     3329   define buffer buf_staff for ub.staff.
     3330   if p-date = ? then do:
     3331     p-date = today .
     3332   end.
     3333   find first buf_staff no-lock where
     3334             buf_staff.role = p-role
     3335         and buf_staff.role-level = 'db':U
     3336         and buf_staff.db-num = p-db-num
     3337        and buf_staff.date-end >= p-date
     3338        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
     3339   if available buf_staff
     3340   then do:
     3341     assign
     3342     p-c-password = buf_staff.password.
     3343     return buf_staff.staff-code.
     3344   end.
     3345   p-c-password = ''.
     3346   return 0.
     3347   end FUNCTION.
     3348   FUNCTION gbclcode-is-psn-role returns integer (
     3349                                                 input p-role as character
     3350                                                 ,input p-psn-code as integer
     3351                                                 ,input p-date as date
     3352                                                     ):
     3353   define buffer buf_staff for ub.staff.
     3354   if p-date = ? then do:
     3355     p-date = today .
     3356   end.
     3357   for each buf_staff no-lock where
     3358             buf_staff.psn-code = p-psn-code
     3359        and  buf_staff.role = p-role
     3360   by buf_staff.role-level
     3361   by buf_staff.date-start
     3362        :
     3363     if  buf_staff.date-start <= p-date and
     3364     buf_staff.date-end >= p-date  then do:
     3365       return buf_staff.staff-code.
     3366     end.
     3367   end.
     3368   return 0.
     3369   end FUNCTION.
     3370   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
     3371   define variable v-role-name as character no-undo .
     3372   assign
     3373   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     3374   no-error .
     3375   return v-role-name.
     3376   END.
     3377   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3378   FUNCTION gbclcode-get-position returns character ( input p-role as character
     3379                                                     ,input p-role-level as character
     3380                                                     ,input p-work-place as character
     3381                                                     ,input p-staff-code as integer
     3382                                                                ):
     3383   define variable v-role-name as character no-undo .
     3384   define variable v-role-level as character no-undo .
     3385   define variable v-staff-code as integer no-undo .
     3386   assign
     3387   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     3388   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
     3389   v-staff-code = p-staff-code
     3390   no-error .
     3391   return substitute("&1, &2, Код &3"
     3392                   ,v-role-name
     3393                   ,v-role-level
     3394                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
     3395   END.
     3396   FUNCTION gbclcode-get-work-place returns character (
     3397                                                   input p-role as character
     3398                                                  ,input p-role-level as character
     3399                                                  ,input p-db-num as integer
     3400                                                  ,input p-host-code as integer
     3401                                                  ,input p-obj-type as character
     3402                                                  ,input p-obj-code as integer
     3403                                                  ) :
     3404   define variable v-work-place as character no-undo .
     3405   define variable v-obj-type as character no-undo .
     3406     case p-role-level:
     3407       when 'db':U then do:
     3408         v-work-place = string(p-db-num, "99999").
     3409       end.
     3410       when 'firm':U then do:
     3411         v-work-place = string(p-host-code, "99999").
     3412       end.
     3413       when 'object':U then do:
     3414         assign
     3415         v-work-place = p-obj-type + string(p-obj-code, "999999999")
     3416         .
     3417       end.
     3418     END CASE.
     3419     return v-work-place.
     3420   END FUNCTION.
     3421   FUNCTION gbclcode-get-level-last-code returns integer (
     3422                                                           input p-role as character
     3423                                                         , input p-role-level as character
     3424                                                         , input p-work-place as character
     3425                                                         , input p-date-start as date
     3426                                                         ):
     3427   DEFINE VARIABLE v-today as date no-undo .
     3428   define buffer buf_staff for ub.staff.
     3429   if p-work-place = chr(63) then return ?.
     3430   if p-date-start = ? then do:
     3431     v-today = today .
     3432   end.
     3433   else do:
     3434     v-today = p-date-start.
     3435   end.
     3436   find last buf_staff no-lock where
     3437             buf_staff.role = p-role
     3438        and  buf_staff.role-level = p-role-level
     3439        and  buf_staff.work-place = p-work-place
     3440        and  buf_staff.date-start <= v-today + 1
     3441        and  buf_staff.date-end >= v-today + 1
     3442        use-index pi  no-error .
     3443   if available buf_staff
     3444   then return buf_staff.staff-code.
     3445   return 0.
     3446   end FUNCTION.
     3447   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3448   procedure prcreate-new-price-doc :
     3449   do
     3450   on error undo, return error return-value
     3451   :
     3452   define input  parameter p-curr-db-num  as integer   no-undo .
     3453   define input  parameter p-obj-type     like ub.price-doc.obj-type no-undo.
     3454   define input  parameter p-obj-code     like ub.price-doc.obj-code no-undo.
     3455   define input  parameter p-plt-id       as integer   no-undo .
     3456   define input  parameter p-plt-db-num   as integer   no-undo .
     3457   define input  parameter p-pdf-id       as integer   no-undo .
     3458   define input  parameter p-pdf-db-num   as integer   no-undo .
     3459   define output parameter p-price-doc-recid  as recid                no-undo.
     3460   define variable v-host-code         like ub.sysconf.host-code        no-undo.
     3461   define variable v-obj-current-date  like ub.price-doc.doc-date      no-undo.
     3462   define variable v-base-rate    like ub.price-doc-forming.base-rate   no-undo .
     3463   define variable v-base-scale   like ub.price-doc-forming.base-scale  no-undo .
     3464   define buffer buf_price-doc-forming for ub.price-doc-forming.
     3465   define buffer buf_price-doc         for ub.price-doc.
     3466   find first buf_price-doc-forming no-lock where
     3467              buf_price-doc-forming.pdf-db     = p-pdf-db-num and
     3468              buf_price-doc-forming.pdf-id     = p-pdf-id     and
     3469              buf_price-doc-forming.plt-db-num = p-plt-db-num and
     3470              buf_price-doc-forming.plt-id     = p-plt-id
     3471              no-error .
     3472   if not available buf_price-doc-forming and p-plt-id = ? then do:
     3473      run create_new_price-doc-forming
     3474           ( input p-obj-type ,
     3475             input p-obj-code ,
     3476             output p-pdf-db-num ,
     3477             output p-pdf-id ,
     3478             output p-plt-db-num ,
     3479             output p-plt-id
     3480             ).
     3481       find first buf_price-doc-forming no-lock where
     3482                 buf_price-doc-forming.pdf-db     = p-pdf-db-num and
     3483                 buf_price-doc-forming.pdf-id     = p-pdf-id     and
     3484                 buf_price-doc-forming.plt-db-num = p-plt-db-num and
     3485                 buf_price-doc-forming.plt-id     = p-plt-id
     3486                 no-error .
     3487   end.
     3488       create buf_price-doc .
     3489       run doc-code in this-procedure
     3490       (input  "main",
     3491        input  p-obj-type  ,
     3492        input  p-obj-code  ,
     3493        input  ?,
     3494        output buf_price-doc.doc-num) no-error.
     3495       if error-status:error then do:
     3496         message vss-workfile vss-revision vss-description skip
     3497                error-status :get-message(1)
     3498               "Ошибка при генерации номера документа." return-value view-as alert-box error.
     3499         return error.
     3500       end.
     3501   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3502   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3503     (input  p-obj-type
     3504     ,input  p-obj-code
     3505     ,output v-host-code
     3506     )  .
     3507       v-obj-current-date  = today .
     3508       if not (buf_price-doc-forming.base-rate = 0 or buf_price-doc-forming.base-rate = ?) then do:
     3509           v-base-rate   =  buf_price-doc-forming.base-rate  .
     3510           v-base-scale  =  buf_price-doc-forming.base-scale .
     3511       end.
     3512       else do:
     3513   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3514   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     3515     (input  v-host-code
     3516     ,input  v-obj-current-date
     3517     ,output v-base-rate
     3518     ,output v-base-scale
     3519     )  .
     3520       end.
     3521      assign
     3522       buf_price-doc.base-rate      = v-base-rate
     3523       buf_price-doc.base-scale     = v-base-scale
     3524       buf_price-doc.cr-db-num      = p-curr-db-num
     3525       buf_price-doc.doc-date       = v-obj-current-date
     3526       buf_price-doc.fact-num       = 0
     3527       buf_price-doc.host-code      = v-host-code
     3528       buf_price-doc.is-corr        = false
     3529       buf_price-doc.is-del         = false
     3530       buf_price-doc.obj-code       = p-obj-code
     3531       buf_price-doc.obj-type       = p-obj-type
     3532       buf_price-doc.out-code       = ""
     3533       buf_price-doc.pdf-db         = p-pdf-db-num
     3534       buf_price-doc.pdf-id         = p-pdf-id
     3535       buf_price-doc.plt-db-num     = p-plt-db-num
     3536       buf_price-doc.plt-id         = p-plt-id
     3537       buf_price-doc.PS             = "@ "
     3538       buf_price-doc.rest-base      = 0
     3539       buf_price-doc.rest-last      = 0
     3540       buf_price-doc.rest-qnty      = 0
     3541       buf_price-doc.rest-sale      = 0
     3542       buf_price-doc.sale-base      = 0
     3543       buf_price-doc.status_        = 'новый':U
     3544       .
     3545       buf_price-doc.doc-num-es     = entry(1, buf_price-doc-forming.des, chr(4)) no-error.
     3546       buf_price-doc.uid-es         = entry(2, buf_price-doc-forming.des, chr(4)) no-error.
     3547       buf_price-doc.doc-date       = date(entry(3, buf_price-doc-forming.des, chr(4))) no-error.
     3548       if buf_price-doc.uid-es = "_" then buf_price-doc.uid-es = "" .
     3549       assign
     3550           p-price-doc-recid = recid ( buf_price-doc )
     3551       .
     3552   end.
     3553   end procedure.
     3554   procedure prcreate-new-price-list :
     3555   do
     3556   on error undo, return error return-value
     3557   :
     3558   define input parameter p-price-doc-recid   as recid                    no-undo.
     3559   define input parameter p-gds-code          like ub.goods.gds-code         no-undo.
     3560   define input parameter p-price-sale        like ub.price-list.price-sale  no-undo.
     3561   define output parameter p-update           as logical                  no-undo.
     3562   define variable kk as integer no-undo .
     3563   define var v-b-code    like ub.bar-code.b-code     no-undo.
     3564   define variable p-hostcode as int no-undo .
     3565   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     3566   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     3567   define buffer buf_price-doc        for ub.price-doc.
     3568   define buffer buf_price-list       for ub.price-list.
     3569   define buffer buf_bar-code         for ub.bar-code.
     3570   define buffer buf_goods            for ub.goods.
     3571   define buffer buf_root_gds-prt     for ub.gds-prt.
     3572   define buffer buf_gds-prt          for ub.gds-prt.
     3573   find first buf_price-doc no-lock
     3574        where recid( buf_price-doc ) = p-price-doc-recid
     3575   .
     3576   find first buf_goods no-lock
     3577        where buf_goods.gds-code = p-gds-code
     3578   .
     3579   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3580     (input  p-gds-code
     3581     ,input  ?
     3582     ,output v-b-code
     3583     ) no-error .
     3584   if error-status :error
     3585   then do:
     3586       message
     3587           "Не найден основной бар-код"
     3588           skip "для товара "
     3589           skip string(buf_goods.artic)
     3590           skip buf_goods.gds-name
     3591       view-as alert-box
     3592       title "Ошибка при выполнении prcreate.i".
     3593       undo, return error .
     3594   end.
     3595   find first buf_bar-code no-lock
     3596        where buf_bar-code.b-code = v-b-code
     3597   no-error.
     3598   if error-status :error
     3599   then do:
     3600       message
     3601           "Не найдена запись bar-code"
     3602           skip "для товара "
     3603           skip string(buf_goods.artic)
     3604           skip buf_goods.gds-name
     3605           skip "С основным бар-кодом"
     3606           skip string(v-b-code)
     3607       view-as alert-box
     3608       title "Ошибка при выполнении prcreate.i".
     3609       undo, return error .
     3610   end.
     3611   find first buf_root_gds-prt no-lock
     3612        where buf_root_gds-prt.upper-code = buf_goods.prt-root
     3613   .
     3614   if buf_root_gds-prt.node-name <> '_Пустая шкала':U
     3615     and buf_bar-code.in-code <> ""
     3616   then do:
     3617       message
     3618           "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     3619           "Артикул:" buf_goods.artic "Код:" buf_goods.gds-code buf_goods.gds-name
     3620           view-as alert-box error.
     3621       undo, return error.
     3622   end.
     3623   find first buf_gds-prt no-lock
     3624        where buf_gds-prt.node-code = buf_bar-code.node-code
     3625   .
     3626   find first buf_price-list
     3627        where buf_price-list.doc-num = buf_price-doc.doc-num
     3628          and buf_price-list.b-code  = v-b-code
     3629   no-error.
     3630   if available buf_price-list
     3631   then do:
     3632       message "Строка с товаром арт." buf_price-list.artic " уже есть в данной переоценке."
     3633          skip "  Цена:   " buf_price-list.price-sale
     3634          skip "Цена будет изменена"
     3635       view-as alert-box warning.
     3636       assign
     3637           p-update = yes
     3638       .
     3639   end.
     3640   else do:
     3641   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3642   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3643     (input  buf_price-doc.obj-type
     3644     ,input  buf_price-doc.obj-code
     3645     ,output p-hostcode
     3646     ) no-error .
     3647   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3648   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3649     (input  buf_goods.gds-code
     3650     ,input  '1':U
     3651     ,input  ?
     3652     ,input  p-hostcode
     3653     ,input  buf_price-doc.obj-type
     3654     ,input  buf_price-doc.obj-code
     3655     ,output local_vat-pc
     3656     ) no-error .
     3657   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3658   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3659     (input  buf_goods.gds-code
     3660     ,input  '2':U
     3661     ,input  ?
     3662     ,input  p-hostcode
     3663     ,input  buf_price-doc.obj-type
     3664     ,input  buf_price-doc.obj-code
     3665     ,output local_slt-pc
     3666     ) no-error .
     3667       kk = kk + 1.
     3668   define variable v-main-bar-code as integer   no-undo .
     3669   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3670     (input  buf_goods.gds-code
     3671     ,input  ?
     3672     ,output v-main-bar-code
     3673     )  .
     3674       create buf_price-list.
     3675       assign
     3676           buf_price-list.line-num    = kk
     3677           buf_price-list.doc-num     = buf_price-doc.doc-num
     3678           buf_price-list.b-code      = buf_bar-code.b-code
     3679           buf_price-list.artic       = buf_goods.artic
     3680           buf_price-list.prod-type   = buf_goods.prod-type
     3681           buf_price-list.prod-code   = buf_goods.prod-code
     3682           buf_price-list.main-price  = (buf_bar-code.b-code = v-main-bar-code )
     3683           buf_price-list.calc-method = 'Отсутствует':U
     3684           buf_price-list.obj-type    = buf_price-doc.obj-type
     3685           buf_price-list.obj-code    = buf_price-doc.obj-code
     3686           buf_price-list.price-sale  = p-price-sale
     3687           buf_price-list.vat-pc      = local_vat-pc
     3688           buf_price-list.slt-pc      = local_slt-pc
     3689           p-update                   = no
     3690       .
     3691   end.
     3692   end.
     3693   end procedure.
