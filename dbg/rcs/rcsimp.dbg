     3876           for each old_price-list no-lock where
     3877                    old_price-list.doc-num    = v-cur-dn and
     3878                    old_price-list.artic      = buf_goods.artic and
     3879                    old_price-list.prod-type  = buf_goods.prod-type and
     3880                    old_price-list.prod-code  = buf_goods.prod-code and
     3881                    old_price-list.main-price = no,
     3882                   first buf_bar-code no-lock where
     3883                         buf_bar-code.b-code   = old_price-list.b-code and
     3884                         buf_bar-code.in-code  = "" and
     3885                         buf_bar-code.unit-cli = buf_goods.unit-base
     3886                         :
     3887                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     3888                          if error-status :error then next.
     3889                    run create-line-pdf-mpl-lib (
     3890                          input buf_price-doc-forming.plt-db-num
     3891                         ,input buf_price-doc-forming.plt-id
     3892                         ,input buf_price-doc-forming.pdf-db
     3893                         ,input buf_price-doc-forming.pdf-id
     3894                         ,input p-line-num
     3895                         ,input old_price-list.b-code
     3896                         ,input buf_goods.artic
     3897                         ,input buf_goods.prod-type
     3898                         ,input buf_goods.prod-code
     3899                         ,input ""
     3900                         ,input 0
     3901                         ,input old_price-list.price-sale
     3902                         ,input ""
     3903                         ,input 0
     3904                       ,input-output v-sec ) no-error .
     3905           end.
     3906       end.
     3907   end.
     3908   end.
     3909   end procedure.
     3910   procedure copy_new_price-doc-forming :
     3911   define input  parameter       p-recid      as recid no-undo .
     3912   define input-output parameter p-plt-db-num as integer   no-undo .
     3913   define input-output parameter p-plt-id     as integer   no-undo .
     3914   define output parameter       p-pdf-db-num as integer   no-undo .
     3915   define output parameter       p-pdf-id     as integer   no-undo .
     3916   define buffer buf_price-list-type        for ub.price-list-type  .
     3917   define buffer buf_price-doc-forming      for ub.price-doc-forming .
     3918   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr .
     3919   define buffer buf_price-doc-forming-gds  for ub.price-doc-forming-gds .
     3920   define buffer buf_pd-forming-gds-attr    for ub.price-doc-forming-gdsattr .
     3921   define variable v-host-code  as integer   no-undo .
     3922   define variable v-base-rate  as decimal   no-undo .
     3923   define variable v-base-scale as integer   no-undo .
     3924   define variable v-exch-rate  as decimal   no-undo .
     3925   define variable v-exch-scale as integer   no-undo .
     3926   define variable v-base as logical   no-undo .
     3927   define variable v-name as character no-undo .
     3928     do
     3929     on error undo, return error return-value
     3930     :
     3931   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3932   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     3933     (output v-base
     3934     )  .
     3935   find first buf_price-list-type no-lock where
     3936              buf_price-list-type.plt-db-num = p-plt-db-num and
     3937              buf_price-list-type.plt-id     = p-plt-id no-error .
     3938   if error-status :error then return error "Не найден ТПЛ".
     3939   if buf_price-list-type.stts <> 0 then return error "ТПЛ удален" .
     3940   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming )  = p-recid no-error .
     3941       if available buf_price-doc-forming then do :
     3942           assign
     3943             v-base-rate  = buf_price-doc-forming.base-rate
     3944             v-base-scale = buf_price-doc-forming.base-scale
     3945             v-name       =  substitute("Скопировано с ДНЦ &1 &2",  buf_price-doc-forming.pdf-id , trim(buf_price-doc-forming.name)  )
     3946           .
     3947       end.
     3948       else do:
     3949           assign
     3950             v-base-rate  = 1
     3951             v-base-scale = 1
     3952             v-name       = "Автосоздание"
     3953           .
     3954       end.
     3955      create ub.price-doc-forming.
     3956      assign
     3957         ub.price-doc-forming.plt-id       = p-plt-id
     3958         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     3959         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     3960         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     3961         ub.price-doc-forming.base-rate    = v-base-rate
     3962         ub.price-doc-forming.base-scale   = v-base-scale
     3963         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     3964         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     3965         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     3966         ub.price-doc-forming.stts         = 0
     3967         ub.price-doc-forming.sys-date     = today
     3968         ub.price-doc-forming.sys-time     = time
     3969         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     3970         ub.price-doc-forming.who          = v-cntxt-userid
     3971         ub.price-doc-forming.name         = v-name
     3972      .
     3973      assign
     3974       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     3975       p-pdf-id      = ub.price-doc-forming.pdf-id
     3976       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     3977       p-plt-id      = ub.price-doc-forming.plt-id
     3978      .
     3979     end.
     3980     if not available buf_price-doc-forming then return .
     3981   for each buf_price-doc-forming-attr no-lock where
     3982            buf_price-doc-forming-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     3983            buf_price-doc-forming-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     3984            buf_price-doc-forming-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     3985            buf_price-doc-forming-attr.plt-id      = buf_price-doc-forming.plt-id       :
     3986       create ub.price-doc-forming-attr.
     3987       buffer-copy buf_price-doc-forming-attr to ub.price-doc-forming-attr
     3988       assign
     3989         ub.price-doc-forming-attr.plt-db-num  = p-plt-db-num
     3990         ub.price-doc-forming-attr.plt-id      = p-plt-id
     3991         ub.price-doc-forming-attr.pdf-db     = p-pdf-db-num
     3992         ub.price-doc-forming-attr.pdf-id      = p-pdf-id
     3993         .
     3994   end.
     3995   for each buf_price-doc-forming-gds no-lock where
     3996            buf_price-doc-forming-gds.pdf-db      = buf_price-doc-forming.pdf-db       and
     3997            buf_price-doc-forming-gds.pdf-id      = buf_price-doc-forming.pdf-id       and
     3998            buf_price-doc-forming-gds.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     3999            buf_price-doc-forming-gds.plt-id      = buf_price-doc-forming.plt-id       :
     4000       create ub.price-doc-forming-gds.
     4001       buffer-copy buf_price-doc-forming-gds to ub.price-doc-forming-gds
     4002       assign
     4003         ub.price-doc-forming-gds.plt-db-num  = p-plt-db-num
     4004         ub.price-doc-forming-gds.plt-id      = p-plt-id
     4005         ub.price-doc-forming-gds.pdf-db      = p-pdf-db-num
     4006         ub.price-doc-forming-gds.pdf-id      = p-pdf-id
     4007       .
     4008   end.
     4009   for each buf_pd-forming-gds-attr no-lock where
     4010            buf_pd-forming-gds-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     4011            buf_pd-forming-gds-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     4012            buf_pd-forming-gds-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     4013            buf_pd-forming-gds-attr.plt-id      = buf_price-doc-forming.plt-id       :
     4014       create ub.price-doc-forming-gdsattr.
     4015       buffer-copy buf_pd-forming-gds-attr to ub.price-doc-forming-gdsattr
     4016       assign
     4017         ub.price-doc-forming-gdsattr.plt-db-num  = p-plt-db-num
     4018         ub.price-doc-forming-gdsattr.plt-id      = p-plt-id
     4019         ub.price-doc-forming-gdsattr.pdf-db      = p-pdf-db-num
     4020         ub.price-doc-forming-gdsattr.pdf-id      = p-pdf-id
     4021       .
     4022   end.
     4023   end procedure.
     4024   procedure proc-alt-shift-f2:
     4025     if not ibs.th.gbl.gbl-var:rcode
     4026   then
     4027     run gbl\inidebug.p .
     4028   end.
     4029   procedure proc-alt-shift-f3:
     4030     run gbl/prvssinf.p
     4031       ( input this-procedure
     4032       ) .
     4033   end.
     4034   define variable v-inform-launched as logical no-undo initial false .
     4035   procedure proc-alt-shift-f4:
     4036     define variable v-action as character no-undo .
     4037     if v-inform-launched = false then do:
     4038       assign
     4039         v-inform-launched = true
     4040       .
     4041       run gbl/d-inform.w
     4042         (  input self
     4043         ,  input this-procedure
     4044         , output v-action
     4045         ) no-error .
     4046       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     4047       assign
     4048         v-inform-launched = false
     4049       .
     4050     end.
     4051   end.
     4052   procedure proc-alt-f1:
     4053     run gbl/corrhelp.p
     4054       (input this-procedure
     4055       ) .
     4056   end .
     4057   on alt-shift-f2 anywhere do:
     4058     run proc-alt-shift-f2.
     4059   end.
     4060   on alt-shift-f3 anywhere do:
     4061     run proc-alt-shift-f3 in this-procedure .
     4062   end.
     4063   on alt-shift-f4 anywhere do:
     4064     run proc-alt-shift-f4 in this-procedure.
     4065   end.
     4066   on alt-f1 anywhere do:
     4067     run proc-alt-f1 in this-procedure .
     4068   end.
     4069   def var vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4070   procedure check-use-bar-code :
     4071     define input  parameter p-b-code    like ub.bar-code.b-code no-undo .
     4072     do
     4073     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info30, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4074     on stop   undo, return error substitute( "&1. stop", vss-include-info30 )
     4075     on endkey undo, return error substitute( "&1. endkey", vss-include-info30 )
     4076     :
     4077       define buffer buf_bar-code for ub.bar-code .
     4078       find first buf_bar-code no-lock
     4079         where buf_bar-code.b-code     = p-b-code
     4080         no-error .
     4081       if not available buf_bar-code then do:
     4082         return error substitute( "&1 (check-use-bar-code). Не найден бар-код &2", vss-include-info30, p-b-code ) .
     4083       end.
     4084       if buf_bar-code.stts = integer('99':U) then do:
     4085         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     4086                                 + "Выполняется удаление бар-кода"
     4087                                 ,vss-include-info30
     4088                                 ,p-b-code
     4089                                 ,chr(10)
     4090                               ) .
     4091       end.
     4092       if buf_bar-code.stts = integer('79':U) then do:
     4093         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     4094                                 + "Бар-код выключен"
     4095                                 ,vss-include-info30
     4096                                 ,p-b-code
     4097                                 ,chr(10)
     4098                               ) .
     4099       end.
     4100       return .
     4101     end.
     4102   end procedure.
     4103   define input  parameter dif-pdbc as logical no-undo initial no.
     4104   define input  parameter pbc-veto  as logical no-undo.
