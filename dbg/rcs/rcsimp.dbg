     7397                                   + chr(10) + "ID товара:    " + temp_rcs-retail1billitem.product_id
     7398                                   + chr(10) + "ID накладной: " + temp_rcs-retail1billitem.bill_id
     7399                   .
     7400               end.
     7401               else do:
