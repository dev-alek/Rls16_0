      581   end .
      582   procedure xmlchar-decode :
      583   define input parameter p-in-string      as character        no-undo.
      584   define output parameter p-out-string    as character        no-undo.
      585       define variable v-position      as integer      no-undo.
      586       define variable v-last-position as integer      no-undo.
      587       define variable v-temp-integer  as integer      no-undo.
      588       define variable v-current-char  as character    no-undo.
      589       define variable v-next-char     as character    no-undo.
      590       define variable v-success       as logical      no-undo.
      591   do
      592   on error undo, return error
      593   :
      594       assign
      595           p-out-string = "":U
      596           v-position   = 0
      597       .
      598       replace-cycle:
      599       do while yes
      600       on error undo, return error
      601       :
      602           assign
      603               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      604           .
      605           if v-last-position <= v-position
      606           then do:
      607               if v-position = 0
      608               then do:
      609                   assign
      610                       p-out-string = p-in-string
      611                   .
      612               end.
      613               else do:
      614                   assign
      615                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      616                   .
      617               end.
      618               leave replace-cycle.
      619           end.
      620           else do:
      621               assign
      622                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      623                   v-position      = v-last-position
      624                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      625               .
      626               if v-current-char = "#":U
      627               then do:
      628                   assign
      629                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      630                   .
      631                   if v-last-position > 0
      632                   then do:
      633                       run xmlchar-read-integer in this-procedure
      634                        (
      635                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      636                           , output v-temp-integer
      637                           , output v-success
      638                       ).
      639                       if v-success = yes
      640                       and v-temp-integer >= 1
      641                       and v-temp-integer <= 255
      642                       then do:
      643                           assign
      644                               p-out-string = p-out-string + chr( v-temp-integer )
      645                               v-position   = v-last-position + 1
      646                           .
      647                       end.
      648                       else do:
      649                           assign
      650                               p-out-string = p-out-string + "&":U
      651                               v-position   = v-position   + 1
      652                           .
      653                       end.
      654                   end.
      655                   else do:
      656                       assign
      657                           p-out-string = p-out-string + "&":U
      658                           v-position   = v-position   + 1
      659                       .
      660                   end.
      661               end.
      662               else do:
      663                   case substring( p-in-string, v-position + 1, 3 )
      664                   :
      665                       when "lt;":U
      666                       then do:
      667                           assign
      668                               p-out-string = p-out-string + "<":U
      669                               v-position   = v-position   + 3
      670                           .
      671                       end.
      672                       when "gt;":U
      673                       then do:
      674                           assign
      675                               p-out-string = p-out-string + ">":U
      676                               v-position   = v-position   + 3
      677                           .
      678                       end.
      679                       otherwise do:
      680                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      681                           then do:
      682                               assign
      683                                   p-out-string = p-out-string + "&":U
      684                                   v-position   = v-position   + 4
      685                               .
      686                           end.
      687                           else do:
      688                               case substring( p-in-string, v-position + 1, 5 )
      689                               :
      690                                   when "quot;":U
      691                                   then do:
      692                                       assign
      693                                           p-out-string = p-out-string + '"':U
      694                                           v-position   = v-position   + 5
      695                                       .
      696                                   end.
      697                                   when "apos;":U
      698                                   then do:
      699                                       assign
      700                                           p-out-string = p-out-string + "'":U
      701                                           v-position   = v-position   + 5
      702                                       .
      703                                   end.
      704                                   otherwise do:
      705                                       assign
      706                                           p-out-string = p-out-string + "&":U
      707                                       .
      708                                   end.
      709                               end case.
      710                           end.
      711                       end.
      712                   end case.
      713               end.
      714           end.
      715       end.
      716   end.
      717   end .
      718   procedure xmlchar-read-integer :
      719   define input parameter p-input-string      as character        no-undo.
      720   define output parameter p-output-integer   as integer          no-undo.
      721   define output parameter p-success       as logical          no-undo.
      722   do
      723   on error undo, return error
      724   :
      725       assign
      726           p-output-integer = integer( p-input-string )
      727       no-error.
      728       if error-status :error
      729       then do:
      730           assign
      731               p-success           = no
      732               p-output-integer    = 0
      733           .
      734       end.
      735       else do:
      736           assign
      737               p-success           = yes
      738           .
      739       end.
      740   end.
      741   end.
      742   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
      743                                             INPUT iFlagEmpty AS INTEGER).
      744     DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
      745     IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
      746       DO:
      747         IF iFlagEmpty = 0 THEN RETURN "".
      748         ELSE IF iFlagEmpty = 1                    THEN RETURN sParName + "=&#034;&#034;".
      749         ELSE IF iFlagEmpty = 2 AND sToPlace = "0" THEN RETURN sParName + "=&#034;0&#034;".
      750         ELSE IF iFlagEmpty = 3 AND sToPlace = ""  THEN RETURN sParName + "=&#034;&#034;".
      751         ELSE RETURN "".
      752       END.
      753     ELSE DO:
      754           run xmlchar-encode in this-procedure (
      755                 input sToPlace
      756               , output sToPlace
      757           ).
      758           ASSIGN
      759               sToPlace = sParName + '="' + sToPlace + '"'
      760           .
      761        RETURN sToPlace.
      762     END.
      763   END FUNCTION.
      764   PROCEDURE wp-XMLTagOpen:
      765     DEF INPUT PARAM iStmNum   AS INTEGER NO-UNDO.
      766     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
      767     DEF INPUT PARAM sTagName  AS CHAR NO-UNDO.
      768     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
      769       run xmlchar-encode in this-procedure (
      770             input sParValue
      771           , output sParValue
      772       ).
      773      if istmnum = 1
      774      then do:
      775           PUT STREAM stmXMLHead UNFORMATTED chr(10) + FILL(" ", 4 * iTagLevel) +
      776                           "<" + sTagName + (IF sParValue = "" OR sParValue = ? then "" ELSE " ") +
      777                           sParValue + ">".
      778      end.
      779      else do:
      780           PUT STREAM stmXMLBody UNFORMATTED chr(10) + FILL(" ", 4 * iTagLevel) +
      781                           "<" + sTagName + (IF sParValue = "" OR sParValue = ? then "" ELSE " ") +
      782                           sParValue + ">".
      783      end.
      784   END PROCEDURE.
      785   PROCEDURE wp-XMLTagPut:
      786     DEF INPUT PARAM iStmNum   AS INTEGER NO-UNDO.
      787     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
      788     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
      789     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
      790     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
      791      if istmnum = 1
      792      then do:
      793           IF  iFlagEmpty = 1
      794           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
      795           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
      796           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
      797           THEN DO:
      798               run xmlchar-encode in this-procedure (
      799                     input sParValue
      800                   , output sParValue
      801               ).
      802               PUT STREAM stmXMLHead UNFORMATTED chr(10) + FILL(" ", 4 * iTagLevel) +
      803                                   '<' + sTagName + '>' + sParValue + '</' + sTagName + '>'.
      804           END.
      805      end.
      806      else do:
      807           IF  iFlagEmpty = 1
      808           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
      809           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
      810           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
      811           THEN DO:
      812               run xmlchar-encode in this-procedure (
      813                     input sParValue
      814                   , output sParValue
      815               ).
      816               PUT STREAM stmXMLBody UNFORMATTED chr(10) + FILL(" ", 4 * iTagLevel) +
      817                                   '<' + sTagName + '>' + sParValue + '</' + sTagName + '>'.
      818           END.
      819      end.
      820   END PROCEDURE.
      821   PROCEDURE wp-XMLTagClose:
      822     DEF INPUT PARAM iStmNum   AS INTEGER NO-UNDO.
      823     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
      824     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
      825      if istmnum = 1
      826      then do:
      827           PUT STREAM stmXMLHead UNFORMATTED  chr(10) + FILL(" ", 4 * iTagLevel) + '</' + sTagName + '>'.
      828      end.
      829      else do:
      830           PUT STREAM stmXMLBody UNFORMATTED chr(10) + FILL(" ", 4 * iTagLevel) + '</' + sTagName + '>'.
      831      end.
      832   END PROCEDURE.
      833   PROCEDURE wp-XMLWriteLog:
      834     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
      835     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
      836     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
      837   OUTPUT STREAM stmXMLLog TO VALUE(sFileName) APPEND.
      838       PUT STREAM stmXMLLog UNFORMATTED chr(10).
      839       PUT STREAM stmXMLLog UNFORMATTED (IF (iLogLevel = 0 OR sToWrite = "&DLine"
      840                                         OR sToWrite = "&Line") THEN "" ELSE
      841                                         cur-time-string-sec() + " ").
      842       PUT STREAM stmXMLLog UNFORMATTED
      843               (IF sToWrite = "&Line" THEN FILL("-", 80)
      844                ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
      845                ELSE sToWrite).
      846   OUTPUT STREAM stmXMLLog CLOSE.
      847   END PROCEDURE.
      848   PROCEDURE wp-XMLWriteEDT:
      849     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
      850     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
      851     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
      852       if valid-handle ( hEDT )
      853       then do:
      854           hEDT :move-to-eof().
      855           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
      856                                           OR sToWrite = "&Line") THEN "" ELSE
      857                                           cur-time-string-sec() + " ").
      858           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
      859                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
      860                   ELSE FILL(" ", iLogLevel) + sToWrite).
      861           hEDT :insert-string(chr(10)).
      862       end.
      863   END PROCEDURE.
      864   PROCEDURE wp-XMLShowCNT:
      865     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
      866       if valid-handle( hCNT )
      867       then do:
      868           ASSIGN hCNT :VISIBLE = TRUE.
      869       end.
      870   END PROCEDURE.
      871   PROCEDURE wp-XMLHideCNT:
      872     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
      873       if valid-handle( hCNT )
      874       then do:
      875           ASSIGN hCNT :VISIBLE = FALSE.
      876       end.
      877   END PROCEDURE.
      878   PROCEDURE wp-XMLWriteCNT:
      879     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
      880     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
      881       if valid-handle( hCNT )
      882       then do:
      883           ASSIGN hCNT :SCREEN-VALUE = sCounter.
      884       end.
      885   END PROCEDURE.
      886   procedure rcs-xml-write-header:
      887   do
      888   on error undo, return error
      889   :
      890   define input parameter p-num-tables         as integer      no-undo.
      891   define input parameter p-xml-file-name-head as character    no-undo.
      892   define input parameter p-table-id-head      as character    no-undo.
      893   define input parameter p-xml-file-name-body as character    no-undo.
      894   define input parameter p-table-id-body      as character    no-undo.
      895       define variable v-reportnumber          as integer      no-undo.
      896       run get-next-reportnumber in this-procedure (
      897           output v-reportnumber
      898       ) no-error.
      899       if error-status :error
      900       then do:
      901           assign
      902               v-reportnumber = 0
      903           .
      904       end.
      905       output stream stmXMLHead to value( p-xml-file-name-head + ".xm1" ) convert target "1251".
      906           put stream stmXMLHead unformatted "<DESTINATION_ROID " + p-table-id-head + ">".
      907           run wp-xmltagopen( 1, 0, "mail Parameters","").
      908           run wp-xmltagput( 1, 1, "X-ReportType",    string( 1 ), 0).
      909           run wp-xmltagput( 1, 1, "X-IDChannel",     string( 3 ), 0).
      910           run wp-xmltagput( 1, 1, "X-ReportNumber",  string( v-reportnumber ), 0).
      911           run wp-xmltagclose( 1, 0, "mail Parameters").
      912           put stream stmXMLHead unformatted skip "<ROWSET>".
      913       output stream stmXMLHead close.
      914       if p-num-tables > 1
      915       then do:
      916           output stream stmXMLBody to value( p-xml-file-name-body + ".xm1" ) convert target "1251".
      917               put stream stmXMLBody unformatted "<DESTINATION_ROID " + p-table-id-body + ">".
      918               run wp-xmltagopen( 2, 0, "mail Parameters","").
      919               run wp-xmltagput( 2, 1, "X-ReportType",    string( 1 ), 0).
      920               run wp-xmltagput( 2, 1, "X-IDChannel",     string( 3 ), 0).
      921               run wp-xmltagput( 2, 1, "X-ReportNumber",  string( v-reportnumber ), 0).
      922               run wp-xmltagclose( 2, 0, "mail Parameters").
      923               put stream stmXMLBody unformatted skip "<ROWSET>".
      924           output stream stmXMLBody close.
      925       end.
      926   end.
      927   end procedure.
      928   procedure rcs-xml-write-footer:
      929   do
      930   on error undo, return error
      931   :
      932   define input parameter p-num-tables         as integer      no-undo.
      933   define input parameter p-xml-head-file-name as character    no-undo.
      934   define input parameter p-xml-body-file-name as character    no-undo.
      935       define variable v-error-num     as integer           no-undo.
      936       output stream stmXMLHead to value( p-xml-head-file-name + ".xm1" ) convert target "1251" append.
      937          put stream stmXMLHead unformatted skip "</ROWSET>" chr(10).
      938       output stream stmXMLHead close.
      939       if p-num-tables > 1
      940       then do:
      941           output stream stmXMLBody to value( p-xml-body-file-name + ".xm1" ) convert target "1251" append.
      942               put stream stmXMLBody unformatted skip "</ROWSET>" chr(10).
      943           output stream stmXMLBody close.
      944       end.
      945   end.
      946   end procedure.
      947   function format-decimal returns character ( input p-decimal as decimal ).
      948       if p-decimal = ?
      949       then do:
      950           return "?".
      951       end.
      952       else do:
      953           if abs( p-decimal ) < 1
      954           then do:
      955               return right-trim( string( p-decimal, "-9.9999999999" ), "0" ).
      956           end.
      957           else do:
      958               return string( p-decimal ).
      959           end.
      960       end.
      961   end function.
      962   procedure get-next-reportnumber :
      963   do
      964   on error undo, return error
      965   :
      966   define output parameter p-reportnumber as integer      no-undo.
      967       define buffer buf_usr-flt       for ubflt.usr-flt.
      968       find first buf_usr-flt exclusive-lock
      969            where buf_usr-flt.user-name  = 'все':U
      970              and buf_usr-flt.call-point = 'тек':U
      971       no-error .
      972       if not available buf_usr-flt
      973       then do:
      974           create buf_usr-flt.
      975           assign
      976               buf_usr-flt.user-name    = 'все':U
      977               buf_usr-flt.call-point   = 'тек':U
      978               buf_usr-flt.Naim = "1"
      979           .
      980       end.
      981       assign
      982           p-reportnumber   = integer( buf_usr-flt.Naim )
      983           buf_usr-flt.Naim = string( p-reportnumber + 1 )
      984       .
      985   end.
      986   end procedure.
      987   define variable vss-include-info3 as character format "X(65)" no-undo
      988   initial "@(#)$Workfile$ $Revision$".
      989   procedure get-shops-type-and-code :
      990   do
      991   on error undo, return error
      992   :
      993   define input parameter p-shops-id           as character    no-undo.
      994   define output parameter p-shops-obj-type    as character    no-undo.
      995   define output parameter p-shops-obj-code    as integer      no-undo.
      996       define buffer buf_rcs-shops     for rcs-shops.
      997       find first buf_rcs-shops no-lock
      998            where buf_rcs-shops.id = p-shops-id
      999       no-error.
     1000       if not available buf_rcs-shops
     1001       then do:
     1002           undo, return error "get-shops-id: Не найден объект."
     1003                   + chr(10) + "ID объекта: " + p-shops-id
     1004           .
     1005       end.
     1006       else do:
     1007           assign
     1008               p-shops-obj-type    = buf_rcs-shops.obj-type
     1009               p-shops-obj-code    = buf_rcs-shops.obj-code
     1010           .
     1011       end.
     1012   end.
     1013   end procedure.
     1014   procedure get-destination-id :
     1015   do
     1016   on error undo, return error
     1017   :
     1018   define input parameter p-destination-name   as character    no-undo.
     1019   define output parameter p-destination-id    as character    no-undo.
     1020       define buffer buf_rcs-destn     for rcs-destn.
     1021       find first buf_rcs-destn no-lock
     1022            where buf_rcs-destn.name = p-destination-name
     1023       no-error.
     1024       if not available buf_rcs-destn
     1025       then do:
     1026           assign
     1027               p-destination-id = ""
     1028           .
     1029       end.
     1030       else do:
     1031           assign
     1032               p-destination-id = buf_rcs-destn.destination_rowid
     1033           .
     1034       end.
     1035   end.
     1036   end procedure.
     1037       define variable v-counter           as integer           no-undo.
     1038       define variable v-log-file-name     as character         no-undo.
     1039       define variable v-destination-rowid as character         no-undo.
     1040       define variable v-good-counter      as integer           no-undo.
     1041       define variable v-product-id        as character         no-undo.
     1042       define variable v-have-prod-bc      as logical  init no  no-undo.
     1043       define buffer buf_rcs-shops             for rcs-shops.
     1044       define buffer buf_gds-obj               for gds-obj.
     1045       define buffer buf_goods                 for goods.
     1046       define buffer buf_units                 for units.
     1047       define buffer buf_rcs-retail1product    for rcs-retail1product.
     1048       define buffer buf_prod-bc               for prod-bc.
     1049       define buffer buf_bar-code              for bar-code.
     1050   do
     1051   for buf_rcs-shops
     1052     , buf_gds-obj
     1053     , buf_goods
     1054     , buf_units
     1055     , buf_rcs-retail1product
     1056     , buf_prod-bc
     1057     , buf_bar-code
     1058   on error undo, return error
     1059   :
     1060       ASSIGN v-log-file-name = p-xml-file-name + ".log".
     1061       run get-destination-id in this-procedure (
     1062             input "RETAIL1_TH_PRODUCT"
     1063           , output v-destination-rowid
     1064       ) no-error.
     1065       if error-status :error
     1066       or v-destination-rowid = ""
     1067       then do:
     1068           message
     1069             vss-workfile vss-revision vss-description
     1070             skip "Не удалось получить DESTINATION-ROWID для RETAIL1_BARCODE."
     1071             skip return-value
     1072             skip trim(error-status :get-message(1))
     1073                  trim(error-status :get-message(2))
     1074                  trim(error-status :get-message(3))
     1075                  trim(error-status :get-message(4))
     1076                  trim(error-status :get-message(5))
     1077           view-as alert-box error.
     1078           undo, return error .
     1079       end.
     1080       run rcs-xml-write-header in this-procedure (
     1081                 input 1
     1082               , input p-xml-file-name
     1083               , input v-destination-rowid
     1084               , input ""
     1085               , input ""
     1086       ) no-error .
     1087       if error-status :error
     1088       then do:
     1089           undo, return error "rcs-docs: Ошибка записи заголовка файла." + chr(10) + return-value.
     1090       end.
     1091       output stream stmXMLHead to value( p-xml-file-name + ".xm1") convert target "1251" append.
     1092       for each buf_units no-lock
     1093       :
     1094           for each buf_goods no-lock
     1095              where buf_goods.unit-base = buf_units.unit-name
     1096           :
     1097               assign
     1098                   v-good-counter = v-good-counter + 1
     1099                   v-have-prod-bc = no
     1100               .
     1101               find first buf_rcs-retail1product no-lock
     1102                    where buf_rcs-retail1product.gds-code = buf_goods.gds-code
     1103               no-error.
     1104               if not available buf_rcs-retail1product
     1105               then do:
     1106                   run write-to-log-editor in this-procedure ( p-ed, v-log-file-name, 1, "Товар с кодом " + string( buf_goods.gds-code ) + " не был импортирован." ).
     1107                   assign
     1108                       v-product-id = "0"
     1109                   .
     1110               end.
     1111               else do:
     1112                   assign
     1113                       v-product-id = buf_rcs-retail1product.id
     1114                   .
     1115               end.
     1116               for each buf_prod-bc no-lock
     1117                  where buf_prod-bc.b-code   = buf_goods.gds-code
     1118               :
     1119                   assign
     1120                       v-have-prod-bc = yes
     1121                   .
     1122                   run process-result in this-procedure (
     1123                         input v-product-id
     1124                       , input buf_goods.gds-code
     1125                       , input buf_prod-bc.b-str
     1126                       , input buf_goods.prod-code
     1127                       , input buf_goods.prod-type
     1128                       , input buf_goods.artic
     1129                       , input buf_goods.gds-name
     1130                   ) no-error.
     1131                   if error-status :error
     1132                   then do:
     1133                       message
     1134                         vss-workfile vss-revision vss-description
     1135                         skip "Ошибка при выводе бар-кодов для товара с ID " + v-product-id +  ", кодом " + string( buf_goods.gds-code )
     1136                         skip return-value
     1137                         skip trim(error-status :get-message(1))
     1138                              trim(error-status :get-message(2))
     1139                              trim(error-status :get-message(3))
     1140                       view-as alert-box error.
     1141                       undo, return error .
     1142                   end.
     1143                   if v-good-counter modulo 25 = 0
     1144                   then do:
     1145                       run wp-XMLWriteCnt( p-fi, "Единица измерения: " + buf_units.unit-name + ". Бар-код для товара с ID " + v-product-id +  "  " + string( v-good-counter ) ).
     1146                       process events.
     1147                   end.
     1148               end.
     1149               if v-have-prod-bc = no
     1150               then do:
     1151                   for each buf_bar-code no-lock
     1152                      where buf_bar-code.gds-code  = buf_goods.gds-code
     1153                   :
     1154                       run process-result in this-procedure (
     1155                             input v-product-id
     1156                           , input buf_goods.gds-code
     1157                           , input string( buf_bar-code.b-code )
     1158                           , input buf_goods.prod-code
     1159                           , input buf_goods.prod-type
     1160                           , input buf_goods.artic
     1161                           , input buf_goods.gds-name
     1162                       ) no-error.
     1163                       if error-status :error
     1164                       then do:
     1165                           message
     1166                           vss-workfile vss-revision vss-description
     1167                           skip "Ошибка при выводе основного бар-кода для товара с ID " + v-product-id +  ", кодом " + string( buf_goods.gds-code )
     1168                           skip return-value
     1169                           skip trim(error-status :get-message(1))
     1170                                trim(error-status :get-message(2))
     1171                                trim(error-status :get-message(3))
     1172                           view-as alert-box error.
     1173                           undo, return error .
     1174                       end.
     1175                       if v-good-counter modulo 25 = 0
     1176                       then do:
     1177                           run wp-XMLWriteCnt( p-fi, "Единица измерения: " + buf_units.unit-name + ". Бар-код для товара с ID " + v-product-id +  "  " + string( v-good-counter ) ).
     1178                           process events.
     1179                       end.
     1180                   end.
     1181               end.
     1182           end.
     1183       end.
     1184       output stream stmXMLHead close.
     1185       run rcs-xml-write-footer in this-procedure (
     1186                 input 1
     1187               , input p-xml-file-name
     1188               , input ""
     1189       ) no-error .
     1190       if error-status :error
     1191       then do:
     1192           undo, return error "rcs-docs: Ошибка окончания записи файла." + chr(10) + return-value.
     1193       end.
     1194   end.
     1195   procedure process-result :
     1196   do
     1197   on error undo, return error
     1198   :
     1199   define input parameter p-product-id as character    no-undo.
     1200   define input parameter p-gds-code   as integer      no-undo.
     1201   define input parameter p-barcode    as character    no-undo.
     1202   define input parameter p-prod-code  as integer      no-undo.
     1203   define input parameter p-prod-type  as character    no-undo.
     1204   define input parameter p-artic      as character    no-undo.
     1205   define input parameter p-gds-name   as character    no-undo.
     1206       run wp-xmltagopen( 1, 1, "ROW","").
     1207           run wp-xmltagput( 1, 2, "PRODUCT_ID"    , string( p-product-id ), 0 ).
     1208           run wp-xmltagput( 1, 2, "WEIGHT_CODE"   , string( p-barcode    ), 0 ).
     1209           run wp-xmltagput( 1, 2, "gdsCode"       , string( p-gds-code   ), 0 ).
     1210           run wp-xmltagput( 1, 2, "PRODUCER_CODE" , string( p-prod-code  ), 0 ).
     1211           run wp-xmltagput( 1, 2, "PRODUCER_TYPE" , string( p-prod-type  ), 0 ).
     1212           run wp-xmltagput( 1, 2, "ARTICUL"       , string( p-artic      ), 0 ).
     1213           run wp-xmltagput( 1, 2, "NAME"          , string( p-gds-name   ), 0 ).
     1214       run wp-xmltagclose( 1, 1, "ROW").
     1215   end.
     1216   end procedure.
     1217   PROCEDURE write-to-log-editor :
     1218   do
     1219   on error undo, return error
     1220   :
     1221     define input parameter hedt               as handle       no-undo.
     1222     define input parameter p-log-file-name    as character    no-undo.
     1223     define input parameter iloglevel          as integer      no-undo.
     1224     define input parameter stowrite           as character    no-undo.
     1225       if valid-handle ( hedt )
     1226       then do:
     1227           hedt :move-to-eof().
     1228           hedt :insert-string( if ( iloglevel = 0
     1229                                or stowrite = "&dline"
     1230                                or stowrite = "&line" )
     1231                                then ""
     1232                                else cur-time-string-sec() + " "
     1233                              ).
     1234           hedt :insert-string( if stowrite = "&line"
     1235                                then fill("-", 80 )
     1236                                else if stowrite = "&dline"
     1237                                then fill("=", 80)
     1238                                else fill(" ", iloglevel) + stowrite).
     1239           hedt :insert-string(chr(10)).
     1240       end.
     1241       output to p-log-file-name append.
     1242       put unformatted
     1243           skip chr(10) cur-time-string-sec() fill(" ", iloglevel) stowrite
     1244       .
     1245       output close.
     1246   end.
     1247   END PROCEDURE.
