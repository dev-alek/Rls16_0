        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter p-xml-file-name      as character        no-undo.
        4   define input parameter p-date               as date             no-undo.
        5   define input parameter p-range              as integer          no-undo.
        6   define input parameter p-obj-list           as character        no-undo.
        7   define input parameter p-ed                 as handle           no-undo.
        8   define input parameter p-fi                 as handle           no-undo.
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: rcs-bcod.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: rcs/rcs-bcod.p $":U .
       14   define variable vss-description as character no-undo init "Экспорт бар-кодов во внешнюю систему".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define variable vss-include-info0 as character format "X(65)" no-undo
       76   initial "@(#)$Workfile$ $Revision$".
       77   DEF STREAM stmXMLHead.
       78   DEF STREAM stmXMLBody.
       79   DEF STREAM stmXMLLog.
       80   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   procedure cur-time :
       82      define output parameter p-today as date      no-undo .
       83      define output parameter p-time  as integer   no-undo .
       84     do
       85     on error undo, return error
       86     :
       87       define variable v-date1 as date      no-undo .
       88       define variable v-date2 as date      no-undo .
       89       define variable v-time  as integer   no-undo .
       90       assign
       91         v-date1 = today
       92         v-time  = time
       93         v-date2 = today
       94       .
       95       if v-date1 <> v-date2
       96       then do:
       97         assign
       98           v-date1 = today
       99           v-time  = v-time
      100         .
      101       end.
      102       assign
      103         p-today = v-date1
      104         p-time  = v-time
      105       .
      106     end.
      107   end.
      108   function cur-time-date returns character
      109   :
      110     return string(today, '99/99/9999':U) .
      111   end.
      112   function cur-time-mjd returns decimal
      113   :
      114     define variable v-date as date      no-undo .
      115     define variable v-time as integer   no-undo .
      116     run cur-time in this-procedure
      117       (output v-date
      118       ,output v-time
      119       ) .
      120     return integer(v-date) - 2400002 + (v-time / 86400) .
      121   end.
      122   function cur-time-get-ending-index returns integer
      123   (input p-number as integer
      124   )
      125   :
      126     if p-number < 0
      127     or p-number = ?
      128     then do:
      129       return 1 .
      130     end.
      131     define variable v-rest as integer   no-undo .
      132     assign
      133       p-number = p-number modulo 100
      134     .
      135     if p-number < 20
      136     then do:
      137       assign
      138         v-rest = p-number
      139       .
      140     end.
      141     else do:
      142       assign
      143         v-rest = p-number modulo 10
      144       .
      145     end.
      146     case v-rest :
      147       when 1
      148       then do:
      149         return 2 .
      150       end.
      151       when 2 or
      152       when 3 or
      153       when 4
      154       then do:
      155         return 3 .
      156       end.
      157       otherwise do:
      158         return 1 .
      159       end.
      160     end case .
      161   end.
      162   procedure cur-time-mjd-to-date :
      163      define input  parameter i-mjd-diff as decimal no-undo.
      164      define output parameter o-Date     as date    no-undo.
      165      define output parameter o-Time     as integer no-undo.
      166      define variable v-day-number as integer   no-undo .
      167      if    i-mjd-diff < 0
      168         or i-mjd-diff = ?
      169      then do:
      170         return "?" .
      171      end.
      172      assign
      173         v-day-number = truncate(i-mjd-diff,0).
      174         o-Date = date(v-day-number + 2400002).
      175         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      176     .
      177   end.
      178   function cur-time-mjd-to-string returns character
      179   (input p-mjd-diff as decimal
      180   )
      181   :
      182     define variable v-day-number as integer   no-undo .
      183     define variable v-seconds    as integer   no-undo .
      184     define variable v-hour       as integer   no-undo .
      185     define variable v-min        as integer   no-undo .
      186     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      187     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      188     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      189     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      190     if p-mjd-diff < 0
      191     or p-mjd-diff = ?
      192     then do:
      193       return "?" .
      194     end.
      195     assign
      196       v-day-number = integer(truncate(p-mjd-diff,0))
      197       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      198     .
      199     if v-seconds > 86400
      200     then do:
      201       assign
      202         v-seconds = 86400 - 1
      203       .
      204     end.
      205     if v-seconds < 0
      206     then do:
      207       assign
      208         v-seconds = 0
      209       .
      210     end.
      211     assign
      212       v-hour = truncate(v-seconds / 3600, 0)
      213     .
      214     assign
      215       v-seconds = v-seconds modulo 3600
      216     .
      217     assign
      218       v-min = truncate(v-seconds / 60, 0)
      219     .
      220     assign
      221       v-seconds = v-seconds modulo 60
      222     .
      223     return
      224         (if v-day-number <> 0
      225           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      226           else ""
      227         )
      228       + (if v-day-number <> 0 or v-hour <> 0
      229           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      230           else ""
      231         )
      232       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      233           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      234           else ""
      235         )
      236       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      237       .
      238   end.
      239   function cur-time-string returns character
      240   :
      241     define variable v-date as date      no-undo .
      242     define variable v-time as integer   no-undo .
      243     run cur-time in this-procedure
      244       (output v-date
      245       ,output v-time
      246       ) .
      247     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      248   end.
      249   function cur-time-string-sec returns character
      250   :
      251     define variable v-date as date      no-undo .
      252     define variable v-time as integer   no-undo .
      253     run cur-time in this-procedure
      254       (output v-date
      255       ,output v-time
      256       ) .
      257     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      258   end.
      259   function cur-time-custom  returns character
      260   (input p-prefix as character
      261   ,input p-date-format as character
      262   ,input p-delimiter as character
      263   ,input p-time-format as character
      264   ,input p-suffix as character
      265   )
      266   :
      267     define variable v-date as date      no-undo .
      268     define variable v-time as integer   no-undo .
      269     run cur-time in this-procedure
      270       (output v-date
      271       ,output v-time
      272       ) .
      273     return
      274       p-prefix
      275       + string(v-date, p-date-format)
      276       + p-delimiter
      277       + string(v-time, p-time-format)
      278       + p-suffix
      279       .
      280   end.
      281   function cur-time-print  returns character
      282   :
      283     define variable v-date as date      no-undo .
      284     define variable v-time as integer   no-undo .
      285     run cur-time in this-procedure
      286       (output v-date
      287       ,output v-time
      288       ) .
      289     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      290   end.
      291   function cur-time-datetime returns datetime
      292   :
      293     define variable v-char as character no-undo .
      294     define variable v-datetime as datetime no-undo .
      295     v-char = cur-time-string().
      296     v-datetime = datetime(v-char).
      297     return  v-datetime.
      298   end.
      299   function cur-time-string-msec returns character
      300   :
      301     define variable v-date as datetime  no-undo .
      302     v-date = now.
      303     return string(v-date) .
      304   end.
      305   define variable vss-include-info2 as character format "X(65)" no-undo
      306   initial "@(#)$Workfile$ $Revision$".
      307   procedure xmlchar-test :
      308   define input parameter p-in-string          as character        no-undo.
      309   define output parameter p-out-string-enc    as character        no-undo.
      310   define output parameter p-out-string-dec    as character        no-undo.
      311   do
      312   on error undo, return error
      313   :
      314          run xmlchar-encode in this-procedure
      315       (
      316             input p-in-string
      317           , output p-out-string-enc
      318       ).
      319          run xmlchar-decode in this-procedure
      320       (
      321             input p-out-string-enc
      322           , output p-out-string-dec
      323       ).
      324   end.
      325   end .
      326   procedure xmlchar-encode :
      327   define input parameter p-in-string      as character        no-undo.
      328   define output parameter p-out-string    as character        no-undo.
      329       define variable v-position      as integer      no-undo.
      330       define variable v-current-char  as character    no-undo.
      331   do
      332   on error undo, return error
      333   :
      334       assign
      335           p-out-string = "":U
      336       .
      337       case p-in-string
      338       :
      339           when ?
      340           then do:
      341               assign
      342                   p-out-string = "?":U
      343               .
      344           end.
      345           when "?":U
      346           then do:
      347               assign
      348                   p-out-string = "&#63;":U
      349               .
      350           end.
      351           otherwise do:
      352               do v-position = 1 to length( p-in-string )
      353               :
      354                   assign
      355                       v-current-char = substring( p-in-string, v-position, 1 )
      356                   .
      357                   case v-current-char
      358                   :
      359                       when "&":U
      360                       then do:
      361                           assign
      362                               p-out-string = p-out-string + "&amp;":U
      363                           .
      364                       end.
      365                       when ">":U
      366                       then do:
      367                           assign
      368                               p-out-string = p-out-string + "&gt;":U
      369                           .
      370                       end.
      371                       when "<":U
      372                       then do:
      373                           assign
      374                               p-out-string = p-out-string + "&lt;":U
      375                           .
      376                       end.
      377                       when "'":U
      378                       then do:
      379                           assign
      380                               p-out-string = p-out-string + "&apos;":U
      381                           .
      382                       end.
      383                       when '"':U
      384                       then do:
      385                           assign
      386                               p-out-string = p-out-string + "&quot;":U
      387                           .
      388                       end.
      389                       when chr(1)
      390                       then do:
      391                           assign
      392                               p-out-string = p-out-string + "":U
      393                           .
      394                       end.
      395                       when chr(2)
      396                       then do:
      397                           assign
      398                               p-out-string = p-out-string + "":U
      399                           .
      400                       end.
      401                       when chr(3)
      402                       then do:
      403                           assign
      404                               p-out-string = p-out-string + "":U
      405                           .
      406                       end.
      407                       when chr(4)
      408                       then do:
      409                           assign
      410                               p-out-string = p-out-string + "":U
      411                           .
      412                       end.
      413                       when chr(5)
      414                       then do:
      415                           assign
      416                               p-out-string = p-out-string + "":U
      417                           .
      418                       end.
      419                       when chr(6)
      420                       then do:
      421                           assign
      422                               p-out-string = p-out-string + "":U
      423                           .
      424                       end.
      425                       when chr(7)
      426                       then do:
      427                           assign
      428                               p-out-string = p-out-string + "":U
      429                           .
      430                       end.
      431                       when chr(8)
      432                       then do:
      433                           assign
      434                               p-out-string = p-out-string + "":U
      435                           .
      436                       end.
      437                       when chr(9)
      438                       then do:
      439                           assign
      440                               p-out-string = p-out-string + "":U
      441                           .
      442                       end.
      443                       when chr(29)
      444                       then do:
      445                           assign
      446                               p-out-string = p-out-string + "":U
      447                           .
      448                       end.
      449                       when chr(10)
      450                       then do:
      451                           assign
      452                               p-out-string = p-out-string + "&#10;":U
      453                           .
      454                       end.
      455                       when chr(13)
      456                       then do:
      457                           assign
      458                               p-out-string = p-out-string + "&#13;":U
      459                           .
      460                       end.
      461                       otherwise do:
      462                           assign
      463                               p-out-string = p-out-string + v-current-char
      464                           .
      465                       end.
      466                   end case.
      467               end.
      468           end.
      469       end case.
      470   end.
      471   end .
      472   procedure xmlchar-encode-1c :
      473   define input parameter p-in-string      as character        no-undo.
      474   define output parameter p-out-string    as character        no-undo.
      475       define variable v-position      as integer      no-undo.
      476       define variable v-current-char  as character    no-undo.
      477   do
      478   on error undo, return error
      479   :
      480       assign
      481           p-out-string = "":U
      482       .
      483       case p-in-string
      484       :
      485           when ?
      486           then do:
      487               assign
