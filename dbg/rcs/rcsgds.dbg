        1   block-level on error undo, throw.
        2   define input parameter parparentproc        AS WIDGET-HANDLE NO-UNDO.
        3   define input parameter par-mode             as character no-undo .
        4   define input parameter par-copymode         as logical no-undo .
        5   define input parameter par-alt-bc-mode      as integer no-undo .
        6   define input parameter par-manual           as logical no-undo .
        7   define input parameter par-silence          as logical no-undo .
        8   define input parameter par-file             as logical no-undo .
        9   define input parameter par-single-record    as logical no-undo .
       10   define input parameter par-host-code        like ub.sysconf.host-code no-undo .
       11   define input parameter par-obj-type         like ub.clients.obj-type no-undo .
       12   define input parameter par-obj-code         like ub.clients.obj-code no-undo .
       13   define input parameter is-goods             as logical no-undo .
       14   define input parameter par-copy-rec         as recid no-undo.
       15   define input parameter par-artic            like ub.goods.artic no-undo .
       16   define input parameter par-prod-type        like ub.goods.prod-type no-undo .
       17   define input parameter par-prod-code        like ub.goods.prod-code no-undo .
       18   define input parameter par-node-code        like ub.gds-prt.node-code no-undo .
       19   define input parameter par-grp-code         like ub.gds-grp.node-code no-undo .
       20   define input parameter par-gds-name         like ub.goods.gds-name no-undo .
       21   define input parameter par-saved-name       like ub.goods.gds-name no-undo .
       22   define input parameter par-engl-name        like ub.goods.engl-name no-undo .
       23   define input parameter par-label-name       like ub.goods.label-name no-undo .
       24   define input parameter par-chk-name         like ub.goods.chk-name no-undo .
       25   define input parameter par-alpha1           like ub.goods.alpha1 no-undo .
       26   define input parameter par-unit-base        like ub.goods.unit-base no-undo .
       27   define input parameter par-unit-cli         like ub.goods.unit-cli no-undo .
       28   define input parameter par-max-rate         like ub.goods.max-rate no-undo .
       29   define input parameter par-min-rate         like ub.goods.min-rate no-undo .
       30   define input parameter par-cli-base-rate    like ub.goods.cli-base-rate no-undo .
       31   define input parameter par-qnty-cart        like ub.goods.qnty-cart no-undo .
       32   define input parameter par-ms-base          like ub.goods.ms-base no-undo .
       33   define input parameter par-wt-base          like ub.goods.wt-base no-undo .
       34   define input parameter par-ms-cart          like ub.goods.ms-cart no-undo .
       35   define input parameter par-wt-cart          like ub.goods.wt-cart no-undo .
       36   define input parameter par-calc-method      like ub.goods.calc-method no-undo .
       37   define input parameter par-increase-pc      like ub.goods.increase-pc no-undo .
       38   define input parameter par-NegRest          as logical no-undo .
       39   define input parameter par-obj-price-base   like ub.gds-obj.price-base no-undo .
       40   define input parameter par-obj-price-rubl   like ub.gds-obj.price-rubl no-undo .
       41   define input parameter par-okdp             like ub.goods.okdp no-undo .
       42   define input parameter par-destin           like ub.goods.destin no-undo .
       43   define input parameter par-attrib           like ub.goods.attrib  no-undo .
       44   define input parameter par-user-rule        like ub.goods.user-rule no-undo .
       45   define input parameter par-sert             like ub.goods.sert no-undo .
       46   define input parameter par-struct           like ub.goods.struct no-undo .
       47   define input parameter par-deadline         like ub.goods.deadline no-undo .
       48   define input parameter par-cond-keep-code   like ub.goods.cond-keep-code no-undo .
       49   define input parameter par-sort             like ub.goods.sort no-undo .
       50   define input parameter par-proof            like ub.goods.proof no-undo .
       51   define input parameter par-normal-wastage   like ub.goods.normal-wastage no-undo .
       52   define input parameter par-normal-waste     like ub.goods.normal-waste no-undo .
       53   define input parameter par-tnved            like ub.goods.tnved no-undo .
       54   define input parameter par-nationality      like ub.goods.nationality no-undo .
       55   define input parameter par-unit-cst         like ub.goods.unit-cst no-undo .
       56   define input parameter par-cst-base-rate    like ub.goods.cst-base-rate no-undo .
       57   define input parameter par-fbr-grp-code     like ub.goods.fbr-grp-code no-undo .
       58   define input parameter par-PS               like ub.goods.ps no-undo .
       59   define input parameter par-unq-artc         as logical no-undo .
       60   define input parameter par-is-jwlr          as logical no-undo .
       61   define input parameter par-is-bttl          as logical no-undo .
       62   define input parameter par-is-ptrl          as logical no-undo .
       63   define input parameter par-custvalue        as character no-undo .
       64   define input parameter par-dif-nam1         as logical no-undo .
       65   define input parameter par-dif-nam2         as logical no-undo .
       66   define input parameter par-ArtDis           as logical no-undo .
       67   define input parameter par-BarDis           as logical no-undo .
       68   define input-output parameter par-rec       as recid no-undo .
       69   define output parameter par-nbc             like ub.bar-code.b-code no-undo .
       70   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       71   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       72   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       73   define variable vss-workfile    as character no-undo init "$Workfile: rcsgds.p $":U .
       74   define variable vss-archive     as character no-undo init "$Archive: rcs/rcsgds.p $":U .
       75   define variable vss-description as character no-undo init "Создание или изменение карточки товара.".
       76   procedure vss-get-info :
       77     define output parameter p-vss-revision    like vss-revision    no-undo .
       78     define output parameter p-vss-author      like vss-author      no-undo .
       79     define output parameter p-vss-date        like vss-date        no-undo .
       80     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       81     define output parameter p-vss-archive     like vss-archive     no-undo .
       82     define output parameter p-vss-description like vss-description no-undo .
       83     assign
       84       p-vss-revision    = vss-revision
       85       p-vss-author      = vss-author
       86       p-vss-date        = vss-date
       87       p-vss-workfile    = vss-workfile
       88       p-vss-archive     = vss-archive
       89       p-vss-description = vss-description
       90     .
       91   end procedure.
       92   procedure vss-get-parameters :
       93     define output parameter p-vss-parameters as character no-undo .
       94   end procedure.
       95   define new global shared variable g#vssrevis-logger as handle    no-undo .
       96   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       97   define variable v-vssrevis-logger                   as handle    no-undo .
       98   procedure vss-logevent :
       99     define input  parameter p-extra-paramters as character no-undo .
      100     define variable v-vssrevis-parameters as character no-undo .
      101     do
      102     on error undo, return error return-value
      103     :
      104       if  valid-handle(v-vssrevis-logger)
      105       and v-vssrevis-logger :get-signature("logevent") <> ""
      106       then do:
      107         run vss-get-parameters in this-procedure
      108           (output v-vssrevis-parameters
      109           ).
      110         run logevent in v-vssrevis-logger
      111           (input vss-workfile
      112           ,input vss-revision
      113           ,input v-vssrevis-parameters
      114           ,input p-extra-paramters
      115           ).
      116       end.
      117     end.
      118   end procedure.
      119   assign
      120     v-vssrevis-logger = g#vssrevis-logger
      121   .
      122   if  valid-handle(v-vssrevis-logger)
      123   and v-vssrevis-logger :get-signature("logevent") <> ""
      124   then do:
      125     assign
      126       v-vssrevis-logevent = true
      127     .
      128     run vss-logevent in this-procedure (input vss-description) .
      129   end.
      130   define new global shared variable g#language as character no-undo .
      131   if g#language <> '' and g#language <> 'rus':U then do:
      132     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      133   end.
      134     define new shared temp-table  tt-tax no-undo
      135   field tax-code    like ub.tax.tax-code
      136   FIELD individual  like ub.tax.individual
      137   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
      138   field rate-code   like ub.tax-rate.rate-code
      139   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
      140   FIELD tax-type    like ub.tax.tax-type
      141   field rate-value  like ub.tax-rate-value.rate-value
      142   FIELD tax-rate-gds-rc  as recid
      143   FIELD to-cashdesk like ub.tax.to-cashdesk
      144   FIELD fact-date like ub.tax-rate-value.fact-date
      145   FIELD fact-order like ub.tax-rate-value.fact-order
      146   FIELD next-order like ub.tax-rate-value.fact-order
      147   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
      148   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
      149   FIELD corr-date like ub.tax-rate-gds.corr-date
      150   FIELD corr-time like ub.tax-rate-gds.corr-time
      151   index tax-code is unique primary tax-code fact-order descending rate-code.
      152   define new shared buffer goods for ub.goods.
      153   do
      154   on error undo, return error
      155   :
      156               if par-mode = 'ДОБАВЛЕНИЕ':U
      157               then do:
      158                   run ref/dtaxgdss.p (
      159                         input no
      160                       , input par-unit-base
      161                       , input par-node-code
      162                       , input ?
      163                       , input ?
      164                       , input par-host-code
      165                       , input par-obj-type
      166                       , input par-obj-code
      167                   ).
      168               end.
      169               else do:
      170                   for each tt-tax:
      171                       delete tt-tax.
      172                   end.
      173               end.
      174               run ref/goods01.p (
      175                     input parparentproc
      176                   , input par-mode
      177                   , input par-copymode
      178                   , input par-alt-bc-mode
      179                   , input par-manual
      180                   , input par-silence
      181                   , input yes
      182                   , input par-file
      183                   , input par-single-record
      184                   , input par-host-code
      185                   , input par-obj-type
      186                   , input par-obj-code
      187                   , input is-goods
      188                   , input par-copy-rec
      189                   , input 0
      190                   , input par-artic
      191                   , input par-prod-type
      192                   , input par-prod-code
      193                   , input par-node-code
      194                   , input par-grp-code
      195                   , input par-gds-name
      196                   , input par-saved-name
      197                   , input par-engl-name
      198                   , input par-label-name
      199                   , input par-chk-name
      200                   , input par-alpha1
      201                   , input par-unit-base
      202                   , input par-unit-cli
      203                   , input par-max-rate
      204                   , input par-min-rate
      205                   , input par-cli-base-rate
      206                   , input par-qnty-cart
      207                   , input par-ms-base
      208                   , input par-wt-base
      209                   , input par-ms-cart
      210                   , input par-wt-cart
      211                   , input par-calc-method
      212                   , input par-increase-pc
      213                   , input par-NegRest
      214                   , input par-obj-price-base
      215                   , input par-obj-price-rubl
      216                   , input par-okdp
      217                   , input par-destin
      218                   , input par-attrib
      219                   , input par-user-rule
      220                   , input par-sert
      221                   , input par-struct
      222                   , input par-deadline
      223                   , input par-cond-keep-code
      224                   , input par-sort
      225                   , input par-proof
      226                   , input par-normal-wastage
      227                   , input par-normal-waste
      228                   , input par-tnved
      229                   , input par-nationality
      230                   , input par-unit-cst
      231                   , input par-cst-base-rate
      232                   , input par-PS
      233                   , input par-fbr-grp-code
      234                   , input par-unq-artc
      235                   , input par-is-jwlr
      236                   , input par-is-bttl
      237                   , input par-is-ptrl
      238                   , input par-custvalue
      239                   , input par-dif-nam1
      240                   , input par-dif-nam2
      241                   , input par-ArtDis
      242                   , input (if par-BarDis then 1 else 0)
      243                   , input-output par-rec
      244                   , output par-nbc
      245               ) no-error .
      246               if error-status :error
      247               then do:
      248                   message
      249                            vss-workfile vss-revision vss-description
      250                       skip "Ошибка создания или изменения карточки товара."
      251                       skip return-value
      252                       skip trim(error-status :get-message(1))
      253                            trim(error-status :get-message(2))
      254                            trim(error-status :get-message(3))
      255                   view-as alert-box error.
      256                   undo, return error .
      257               end.
      258   end.
