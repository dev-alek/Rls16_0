      649                       then do:
      650                           assign
      651                               p-out-string = p-out-string + " ":U
      652                           .
      653                       end.
      654                       when chr(10)
      655                       then do:
      656                           assign
      657                               p-out-string = p-out-string + " ":U
      658                           .
      659                       end.
      660                       when chr(13)
      661                       then do:
      662                           assign
      663                               p-out-string = p-out-string + " ":U
      664                           .
      665                       end.
      666                       otherwise do:
      667                           assign
      668                               p-out-string = p-out-string + v-current-char
      669                           .
      670                       end.
      671                   end case.
      672               end.
      673           end.
      674       end case.
      675   end.
      676   end .
      677   procedure xmlchar-decode :
      678   define input parameter p-in-string      as character        no-undo.
      679   define output parameter p-out-string    as character        no-undo.
      680       define variable v-position      as integer      no-undo.
      681       define variable v-last-position as integer      no-undo.
      682       define variable v-temp-integer  as integer      no-undo.
      683       define variable v-current-char  as character    no-undo.
      684       define variable v-next-char     as character    no-undo.
      685       define variable v-success       as logical      no-undo.
      686   do
      687   on error undo, return error
      688   :
      689       assign
      690           p-out-string = "":U
      691           v-position   = 0
      692       .
      693       replace-cycle:
      694       do while yes
      695       on error undo, return error
      696       :
      697           assign
      698               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      699           .
      700           if v-last-position <= v-position
      701           then do:
      702               if v-position = 0
      703               then do:
      704                   assign
      705                       p-out-string = p-in-string
      706                   .
      707               end.
      708               else do:
      709                   assign
      710                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      711                   .
      712               end.
      713               leave replace-cycle.
      714           end.
      715           else do:
      716               assign
      717                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      718                   v-position      = v-last-position
      719                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      720               .
      721               if v-current-char = "#":U
      722               then do:
      723                   assign
      724                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      725                   .
      726                   if v-last-position > 0
      727                   then do:
      728                       run xmlchar-read-integer in this-procedure
      729                        (
      730                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      731                           , output v-temp-integer
      732                           , output v-success
      733                       ).
      734                       if v-success = yes
      735                       and v-temp-integer >= 1
      736                       and v-temp-integer <= 255
      737                       then do:
      738                           assign
      739                               p-out-string = p-out-string + chr( v-temp-integer )
      740                               v-position   = v-last-position + 1
      741                           .
      742                       end.
      743                       else do:
      744                           assign
      745                               p-out-string = p-out-string + "&":U
      746                               v-position   = v-position   + 1
      747                           .
      748                       end.
      749                   end.
      750                   else do:
      751                       assign
      752                           p-out-string = p-out-string + "&":U
      753                           v-position   = v-position   + 1
      754                       .
      755                   end.
      756               end.
      757               else do:
      758                   case substring( p-in-string, v-position + 1, 3 )
      759                   :
      760                       when "lt;":U
      761                       then do:
      762                           assign
      763                               p-out-string = p-out-string + "<":U
      764                               v-position   = v-position   + 3
      765                           .
      766                       end.
      767                       when "gt;":U
      768                       then do:
      769                           assign
      770                               p-out-string = p-out-string + ">":U
      771                               v-position   = v-position   + 3
      772                           .
      773                       end.
      774                       otherwise do:
      775                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      776                           then do:
      777                               assign
      778                                   p-out-string = p-out-string + "&":U
      779                                   v-position   = v-position   + 4
      780                               .
      781                           end.
      782                           else do:
      783                               case substring( p-in-string, v-position + 1, 5 )
      784                               :
      785                                   when "quot;":U
      786                                   then do:
      787                                       assign
      788                                           p-out-string = p-out-string + '"':U
      789                                           v-position   = v-position   + 5
      790                                       .
      791                                   end.
      792                                   when "apos;":U
      793                                   then do:
      794                                       assign
      795                                           p-out-string = p-out-string + "'":U
      796                                           v-position   = v-position   + 5
      797                                       .
      798                                   end.
      799                                   otherwise do:
      800                                       assign
      801                                           p-out-string = p-out-string + "&":U
      802                                       .
      803                                   end.
      804                               end case.
      805                           end.
      806                       end.
      807                   end case.
      808               end.
      809           end.
      810       end.
      811   end.
      812   end .
      813   procedure xmlchar-read-integer :
      814   define input parameter p-input-string      as character        no-undo.
      815   define output parameter p-output-integer   as integer          no-undo.
      816   define output parameter p-success       as logical          no-undo.
      817   do
      818   on error undo, return error
      819   :
      820       assign
      821           p-output-integer = integer( p-input-string )
      822       no-error.
      823       if error-status :error
      824       then do:
      825           assign
      826               p-success           = no
      827               p-output-integer    = 0
      828           .
      829       end.
      830       else do:
      831           assign
      832               p-success           = yes
      833           .
      834       end.
      835   end.
      836   end.
      837   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
      838                                             INPUT iFlagEmpty AS INTEGER).
      839     DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
      840     IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
      841       DO:
      842         IF iFlagEmpty = 0 THEN RETURN "".
      843         ELSE IF iFlagEmpty = 1                    THEN RETURN sParName + "=&#034;&#034;".
      844         ELSE IF iFlagEmpty = 2 AND sToPlace = "0" THEN RETURN sParName + "=&#034;0&#034;".
      845         ELSE IF iFlagEmpty = 3 AND sToPlace = ""  THEN RETURN sParName + "=&#034;&#034;".
      846         ELSE RETURN "".
      847       END.
      848     ELSE DO:
      849           run xmlchar-encode in this-procedure (
      850                 input sToPlace
      851               , output sToPlace
      852           ).
      853           ASSIGN
      854               sToPlace = sParName + '="' + sToPlace + '"'
      855           .
      856        RETURN sToPlace.
      857     END.
      858   END FUNCTION.
      859   PROCEDURE wp-XMLTagOpen:
      860     DEF INPUT PARAM iStmNum   AS INTEGER NO-UNDO.
      861     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
      862     DEF INPUT PARAM sTagName  AS CHAR NO-UNDO.
      863     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
      864       run xmlchar-encode in this-procedure (
      865             input sParValue
      866           , output sParValue
      867       ).
      868      if istmnum = 1
      869      then do:
      870           PUT STREAM stmXMLHead UNFORMATTED chr(10) + FILL(" ", 4 * iTagLevel) +
      871                           "<" + sTagName + (IF sParValue = "" OR sParValue = ? then "" ELSE " ") +
      872                           sParValue + ">".
      873      end.
      874      else do:
      875           PUT STREAM stmXMLBody UNFORMATTED chr(10) + FILL(" ", 4 * iTagLevel) +
      876                           "<" + sTagName + (IF sParValue = "" OR sParValue = ? then "" ELSE " ") +
      877                           sParValue + ">".
      878      end.
      879   END PROCEDURE.
      880   PROCEDURE wp-XMLTagPut:
      881     DEF INPUT PARAM iStmNum   AS INTEGER NO-UNDO.
      882     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
      883     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
      884     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
      885     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
      886      if istmnum = 1
      887      then do:
      888           IF  iFlagEmpty = 1
      889           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
      890           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
      891           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
      892           THEN DO:
      893               run xmlchar-encode in this-procedure (
      894                     input sParValue
      895                   , output sParValue
      896               ).
      897               PUT STREAM stmXMLHead UNFORMATTED chr(10) + FILL(" ", 4 * iTagLevel) +
      898                                   '<' + sTagName + '>' + sParValue + '</' + sTagName + '>'.
      899           END.
      900      end.
      901      else do:
      902           IF  iFlagEmpty = 1
      903           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
      904           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
      905           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
      906           THEN DO:
      907               run xmlchar-encode in this-procedure (
      908                     input sParValue
      909                   , output sParValue
      910               ).
      911               PUT STREAM stmXMLBody UNFORMATTED chr(10) + FILL(" ", 4 * iTagLevel) +
      912                                   '<' + sTagName + '>' + sParValue + '</' + sTagName + '>'.
      913           END.
      914      end.
      915   END PROCEDURE.
      916   PROCEDURE wp-XMLTagClose:
      917     DEF INPUT PARAM iStmNum   AS INTEGER NO-UNDO.
      918     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
      919     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
      920      if istmnum = 1
      921      then do:
      922           PUT STREAM stmXMLHead UNFORMATTED  chr(10) + FILL(" ", 4 * iTagLevel) + '</' + sTagName + '>'.
      923      end.
      924      else do:
      925           PUT STREAM stmXMLBody UNFORMATTED chr(10) + FILL(" ", 4 * iTagLevel) + '</' + sTagName + '>'.
      926      end.
      927   END PROCEDURE.
      928   PROCEDURE wp-XMLWriteLog:
      929     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
      930     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
      931     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
      932   OUTPUT STREAM stmXMLLog TO VALUE(sFileName) APPEND.
      933       PUT STREAM stmXMLLog UNFORMATTED chr(10).
      934       PUT STREAM stmXMLLog UNFORMATTED (IF (iLogLevel = 0 OR sToWrite = "&DLine"
      935                                         OR sToWrite = "&Line") THEN "" ELSE
      936                                         cur-time-string-sec() + " ").
      937       PUT STREAM stmXMLLog UNFORMATTED
      938               (IF sToWrite = "&Line" THEN FILL("-", 80)
      939                ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
      940                ELSE sToWrite).
      941   OUTPUT STREAM stmXMLLog CLOSE.
      942   END PROCEDURE.
      943   PROCEDURE wp-XMLWriteEDT:
      944     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
      945     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
      946     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
      947       if valid-handle ( hEDT )
      948       then do:
      949           hEDT :move-to-eof().
      950           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
      951                                           OR sToWrite = "&Line") THEN "" ELSE
      952                                           cur-time-string-sec() + " ").
      953           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
      954                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
      955                   ELSE FILL(" ", iLogLevel) + sToWrite).
      956           hEDT :insert-string(chr(10)).
      957       end.
      958   END PROCEDURE.
      959   PROCEDURE wp-XMLShowCNT:
      960     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
      961       if valid-handle( hCNT )
      962       then do:
      963           ASSIGN hCNT :VISIBLE = TRUE.
      964       end.
      965   END PROCEDURE.
      966   PROCEDURE wp-XMLHideCNT:
      967     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
      968       if valid-handle( hCNT )
      969       then do:
      970           ASSIGN hCNT :VISIBLE = FALSE.
      971       end.
      972   END PROCEDURE.
      973   PROCEDURE wp-XMLWriteCNT:
      974     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
      975     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
      976       if valid-handle( hCNT )
      977       then do:
      978           ASSIGN hCNT :SCREEN-VALUE = sCounter.
      979       end.
      980   END PROCEDURE.
      981   procedure rcs-xml-write-header:
      982   do
      983   on error undo, return error
      984   :
      985   define input parameter p-num-tables         as integer      no-undo.
      986   define input parameter p-xml-file-name-head as character    no-undo.
      987   define input parameter p-table-id-head      as character    no-undo.
      988   define input parameter p-xml-file-name-body as character    no-undo.
      989   define input parameter p-table-id-body      as character    no-undo.
      990       define variable v-reportnumber          as integer      no-undo.
      991       run get-next-reportnumber in this-procedure (
      992           output v-reportnumber
      993       ) no-error.
      994       if error-status :error
      995       then do:
      996           assign
      997               v-reportnumber = 0
      998           .
      999       end.
     1000       output stream stmXMLHead to value( p-xml-file-name-head + ".xm1" ) convert target "1251".
     1001           put stream stmXMLHead unformatted "<DESTINATION_ROID " + p-table-id-head + ">".
     1002           run wp-xmltagopen( 1, 0, "mail Parameters","").
     1003           run wp-xmltagput( 1, 1, "X-ReportType",    string( 1 ), 0).
     1004           run wp-xmltagput( 1, 1, "X-IDChannel",     string( 3 ), 0).
     1005           run wp-xmltagput( 1, 1, "X-ReportNumber",  string( v-reportnumber ), 0).
     1006           run wp-xmltagclose( 1, 0, "mail Parameters").
     1007           put stream stmXMLHead unformatted skip "<ROWSET>".
     1008       output stream stmXMLHead close.
     1009       if p-num-tables > 1
     1010       then do:
     1011           output stream stmXMLBody to value( p-xml-file-name-body + ".xm1" ) convert target "1251".
     1012               put stream stmXMLBody unformatted "<DESTINATION_ROID " + p-table-id-body + ">".
     1013               run wp-xmltagopen( 2, 0, "mail Parameters","").
     1014               run wp-xmltagput( 2, 1, "X-ReportType",    string( 1 ), 0).
     1015               run wp-xmltagput( 2, 1, "X-IDChannel",     string( 3 ), 0).
     1016               run wp-xmltagput( 2, 1, "X-ReportNumber",  string( v-reportnumber ), 0).
     1017               run wp-xmltagclose( 2, 0, "mail Parameters").
     1018               put stream stmXMLBody unformatted skip "<ROWSET>".
     1019           output stream stmXMLBody close.
     1020       end.
     1021   end.
     1022   end procedure.
     1023   procedure rcs-xml-write-footer:
     1024   do
     1025   on error undo, return error
     1026   :
     1027   define input parameter p-num-tables         as integer      no-undo.
     1028   define input parameter p-xml-head-file-name as character    no-undo.
     1029   define input parameter p-xml-body-file-name as character    no-undo.
     1030       define variable v-error-num     as integer           no-undo.
     1031       output stream stmXMLHead to value( p-xml-head-file-name + ".xm1" ) convert target "1251" append.
     1032          put stream stmXMLHead unformatted skip "</ROWSET>" chr(10).
     1033       output stream stmXMLHead close.
     1034       if p-num-tables > 1
     1035       then do:
     1036           output stream stmXMLBody to value( p-xml-body-file-name + ".xm1" ) convert target "1251" append.
     1037               put stream stmXMLBody unformatted skip "</ROWSET>" chr(10).
     1038           output stream stmXMLBody close.
     1039       end.
     1040   end.
     1041   end procedure.
     1042   function format-decimal returns character ( input p-decimal as decimal ).
     1043       if p-decimal = ?
     1044       then do:
     1045           return "?".
     1046       end.
     1047       else do:
     1048           if abs( p-decimal ) < 1
     1049           then do:
     1050               return right-trim( string( p-decimal, "-9.9999999999" ), "0" ).
     1051           end.
     1052           else do:
     1053               return string( p-decimal ).
     1054           end.
     1055       end.
     1056   end function.
     1057   procedure get-next-reportnumber :
     1058   do
     1059   on error undo, return error
     1060   :
     1061   define output parameter p-reportnumber as integer      no-undo.
     1062       define buffer buf_usr-flt       for ubflt.usr-flt.
     1063       find first buf_usr-flt exclusive-lock
     1064            where buf_usr-flt.user-name  = 'все':U
     1065              and buf_usr-flt.call-point = 'тек':U
     1066       no-error .
     1067       if not available buf_usr-flt
     1068       then do:
     1069           create buf_usr-flt.
     1070           assign
     1071               buf_usr-flt.user-name    = 'все':U
     1072               buf_usr-flt.call-point   = 'тек':U
     1073               buf_usr-flt.Naim = "1"
     1074           .
     1075       end.
     1076       assign
     1077           p-reportnumber   = integer( buf_usr-flt.Naim )
     1078           buf_usr-flt.Naim = string( p-reportnumber + 1 )
     1079       .
     1080   end.
     1081   end procedure.
     1082   define variable vss-include-info4 as character format "X(65)" no-undo
     1083   initial "@(#)$Workfile$ $Revision$".
     1084   procedure get-shops-type-and-code :
     1085   do
     1086   on error undo, return error
     1087   :
     1088   define input parameter p-shops-id           as character    no-undo.
     1089   define output parameter p-shops-obj-type    as character    no-undo.
     1090   define output parameter p-shops-obj-code    as integer      no-undo.
     1091       define buffer buf_rcs-shops     for rcs-shops.
     1092       find first buf_rcs-shops no-lock
     1093            where buf_rcs-shops.id = p-shops-id
     1094       no-error.
     1095       if not available buf_rcs-shops
     1096       then do:
     1097           undo, return error "get-shops-id: Не найден объект."
     1098                   + chr(10) + "ID объекта: " + p-shops-id
     1099           .
     1100       end.
     1101       else do:
     1102           assign
     1103               p-shops-obj-type    = buf_rcs-shops.obj-type
     1104               p-shops-obj-code    = buf_rcs-shops.obj-code
     1105           .
     1106       end.
     1107   end.
     1108   end procedure.
     1109   procedure get-destination-id :
     1110   do
     1111   on error undo, return error
     1112   :
     1113   define input parameter p-destination-name   as character    no-undo.
     1114   define output parameter p-destination-id    as character    no-undo.
     1115       define buffer buf_rcs-destn     for rcs-destn.
     1116       find first buf_rcs-destn no-lock
     1117            where buf_rcs-destn.name = p-destination-name
     1118       no-error.
     1119       if not available buf_rcs-destn
     1120       then do:
     1121           assign
     1122               p-destination-id = ""
     1123           .
     1124       end.
     1125       else do:
     1126           assign
     1127               p-destination-id = buf_rcs-destn.destination_rowid
     1128           .
     1129       end.
     1130   end.
     1131   end procedure.
     1132   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1133     define variable v-cntxt-db-num        as integer   no-undo .
     1134     define variable v-cntxt-userid        as character no-undo .
     1135     define variable v-cntxt-level         as character no-undo .
     1136     define variable v-cntxt-host-code-obj as integer   no-undo .
     1137     define variable v-cntxt-obj-type      as character no-undo .
     1138     define variable v-cntxt-obj-code      as integer   no-undo .
     1139     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1140     define variable v-cntxt-is-admin      as logical   no-undo .
     1141   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1142       define variable v-log-file-name             as character            no-undo.
     1143       define variable v-log-string                as character            no-undo.
     1144       define variable v-oper-num                  as integer              no-undo.
     1145       define variable v-fact-order-from           like stk-tot.fact-order no-undo.
     1146       define variable v-fact-order-to             like stk-tot.fact-order no-undo.
     1147       define variable v-docs-exists               as logical              no-undo.
     1148       define variable v-obj-counter               as integer              no-undo.
     1149       define variable v-counter                   as integer              no-undo.
     1150       define variable v-header-destination-rowid  as character            no-undo.
     1151       define variable v-body-destination-rowid    as character            no-undo.
     1152       define variable v-ext-doc-type-list         as character extent 54 init
     1153       [
     1154           "приход внешний",                                   'ie':U,             2,
     1155           "расход внешний",                                   'ee':U,             0,
     1156           "расход внешний возврат поставщику",                'ep':U,          3,
     1157           "расход внешний продажа через кассу",               'es':U,        0,
     1158           "возврат внешний",                                  're':U,         3,
     1159           "возврат внешний через кассу",                      'rs':U,    0,
     1160           "списание внешнее",                                 'we':U,             4,
     1161           "инвентаризация",                                   'vt':U,                   6,
     1162           "пересортица",                                      'vp':U,              6,
     1163           "коррекция учетных цен",                            'ap':U,        6,
     1164           "смена типа приобретения",                          'pc':U,        6,
     1165           "корретировка отрицательных партий",                'mp':U,      6,
     1166           "приход перемещение",                               'iv':U,             2,
     1167           "расход перемещение",                               'ev':U,             0,
     1168           "возврат перемещение",                              'rv':U,         3,
     1169           "списание производство",                            'wm':U,              4,
     1170           "приход производство",                              'im':U,              2,
     1171           "документ переоценки",                              'ot':U,              5
     1172       ]                                                           no-undo.
     1173       define variable v-today             as date         no-undo.
     1174       define variable v-time              as integer      no-undo.
     1175   do
     1176   on error undo, return error
     1177   :
     1178       run cur-time in this-procedure (
     1179             output v-today
     1180           , output v-time
     1181       ).
     1182   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1183     run mainmenu_getcntxt in p-mainmenu-handle
     1184       (output v-cntxt-db-num
     1185       ,output v-cntxt-userid
     1186       ,output v-cntxt-level
     1187       ,output v-cntxt-host-code-obj
     1188       ,output v-cntxt-obj-type
     1189       ,output v-cntxt-obj-code
     1190       ,output v-cntxt-db-num-obj
     1191       ,output v-cntxt-is-admin
     1192       ) .
     1193       RUN init-temphost.
     1194       assign
     1195           v-log-string = ", по всем фирмам"
     1196       .
     1197       case p-range:
     1198       when 2
     1199       then do:
     1200           for each temp-obj
     1201           where temp-obj.host-code <> v-cntxt-host-code-obj
     1202           :
     1203               delete temp-obj.
     1204           end.
     1205           assign
     1206               v-log-string = ", по фирме (код фирмы " + string( v-cntxt-host-code-obj ) + ")"
     1207           .
     1208       end.
     1209       when 3
     1210       then do:
     1211           for each temp-obj
     1212           :
     1213               delete temp-obj.
     1214           end.
     1215           do v-obj-counter = 1 to num-entries ( p-obj-list ) / 2
     1216           :
     1217               create temp-obj.
     1218               assign
     1219                   temp-obj.obj-type = entry( v-obj-counter * 2 - 1, p-obj-list )
     1220                   temp-obj.obj-code = integer( entry( v-obj-counter * 2, p-obj-list ) )
     1221               no-error .
     1222               if error-status :error
     1223               then do:
     1224                   message
     1225                   vss-workfile vss-revision vss-description
     1226                   skip "Ошибка чтения списка объектов"
     1227                   skip return-value
     1228                   skip trim(error-status :get-message(1))
     1229                       trim(error-status :get-message(2))
     1230                       trim(error-status :get-message(3))
     1231                   view-as alert-box error.
     1232                   undo, return error .
     1233               end.
     1234   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1235   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1236     (input  temp-obj.obj-type
     1237     ,input  temp-obj.obj-code
     1238     ,output temp-obj.host-code
     1239     ) no-error .
     1240               if error-status :error
     1241               then do:
     1242                   message
     1243                   vss-workfile vss-revision vss-description
     1244                   skip "Не найдена фирма для объекта" temp-obj.obj-type temp-obj.obj-code
     1245                   skip return-value
     1246                   skip trim(error-status :get-message(1))
     1247                       trim(error-status :get-message(2))
     1248                       trim(error-status :get-message(3))
     1249                   view-as alert-box error.
     1250                   undo, return error .
     1251               end.
     1252           end.
     1253           assign
     1254               v-log-string = ", по объектам: " + p-obj-list
     1255           .
     1256       end.
     1257       end case.
     1258       ASSIGN v-log-file-name = p-head-filename + ".log".
     1259       run get-destination-id in this-procedure (
     1260             input "DOC_HEAD"
     1261           , output v-header-destination-rowid
     1262       ) no-error.
     1263       if error-status :error
     1264       or v-header-destination-rowid = ""
     1265       then do:
     1266           message
     1267             vss-workfile vss-revision vss-description
     1268             skip "Не удалось получить DESTINATION-ROWID для DOC_HEAD."
     1269             skip return-value
     1270             skip trim(error-status :get-message(1))
     1271                  trim(error-status :get-message(2))
     1272                  trim(error-status :get-message(3))
     1273           view-as alert-box error.
     1274           undo, return error .
     1275       end.
     1276       run get-destination-id in this-procedure (
     1277             input "DOC_BODY"
     1278           , output v-body-destination-rowid
     1279       ) no-error.
     1280       if error-status :error
     1281       or v-body-destination-rowid = ""
     1282       then do:
     1283           message
     1284             vss-workfile vss-revision vss-description
     1285             skip "Не удалось получить DESTINATION-ROWID для DOC_BODY."
     1286             skip return-value
     1287             skip trim(error-status :get-message(1))
     1288                  trim(error-status :get-message(2))
     1289                  trim(error-status :get-message(3))
     1290           view-as alert-box error.
     1291           undo, return error .
     1292       end.
     1293       run rcs-xml-write-header in this-procedure (
     1294                 input 2
     1295               , input p-head-filename
     1296               , input v-header-destination-rowid
     1297               , input p-body-filename
     1298               , input v-body-destination-rowid
     1299       ) no-error .
     1300       if error-status :error
     1301       then do:
     1302           undo, return error "rcs-docs: Ошибка записи заголовка файла." + chr(10) + return-value.
     1303       end.
     1304       object-of-list:
     1305       for each temp-obj
     1306       :
     1307           run export-docs-by-object (   input temp-obj.host-code
     1308                                       , input temp-obj.obj-type
     1309                                       , input temp-obj.obj-code
     1310                                      ) no-error.
     1311           if error-status :error
     1312           then do:
     1313               message
     1314               vss-workfile vss-revision vss-description
     1315               skip "Ошибка экспорта документов по объекту"
     1316               skip "Тип объекта:" temp-obj.obj-type
     1317               skip "Код объекта:" temp-obj.obj-code
     1318               skip return-value
     1319               skip trim(error-status :get-message(1))
     1320                   trim(error-status :get-message(2))
     1321                   trim(error-status :get-message(3))
     1322                   trim(error-status :get-message(4))
     1323                   trim(error-status :get-message(5))
     1324               view-as alert-box error.
     1325               next object-of-list.
     1326           end.
     1327       end.
     1328       run rcs-xml-write-footer in this-procedure (
     1329                 input 2
     1330               , input p-head-filename
     1331               , input p-body-filename
     1332       ) no-error .
     1333       if error-status :error
     1334       then do:
     1335           undo, return error "rcs-docs: Ошибка окончания записи файла." + chr(10) + return-value.
     1336       end.
     1337   end.
     1338   procedure export-docs-by-object :
     1339   define input parameter p-host-code  as integer      no-undo.
     1340   define input parameter p-obj-type   as character    no-undo.
     1341   define input parameter p-obj-code   as integer      no-undo.
     1342       define variable v-archive-ok        as logical      no-undo.
     1343       define variable v-comment           as character    no-undo.
     1344   do
     1345   on error undo, return error
     1346   :
     1347       run wp-XMLWriteEDT( hEDT, 1, string( p-obj-type ) + " " + string( p-obj-code ) ).
     1348       run wp-XMLWriteEDT( hEDT, 4,  "Расчет архивов").
     1349       process events.
     1350       run bge/bge-ahz.p (
     1351             input p-mainmenu-handle
     1352           , input p-obj-type
     1353           , input p-obj-code
     1354           , input yes
     1355           , input no
     1356           , input no
     1357           , input v-today
     1358           , input v-today
     1359           , output v-archive-ok
     1360           , output v-comment
     1361       ) no-error.
     1362       if error-status :error
     1363       then do:
     1364           message
     1365           vss-workfile vss-revision vss-description
     1366           skip "Ошибка проверки архивов на объекте."
     1367           skip "Тип объекта:" p-obj-type
     1368           skip "Код объекта:" p-obj-code
     1369           skip return-value
     1370           skip trim(error-status :get-message(1))
     1371               trim(error-status :get-message(2))
     1372               trim(error-status :get-message(3))
     1373           view-as alert-box error.
     1374           undo, return error .
     1375       end.
     1376       run rep/get-fo.p (
     1377                       input  p-obj-type
     1378                     , input  p-obj-code
     1379                     , input  p-date-from
     1380                     , input  p-date-to
     1381                     , output v-fact-order-from
     1382                     , output v-fact-order-to
     1383                     , output v-docs-exists
     1384                    ) no-error .
     1385       if error-status :error
     1386       then do:
     1387           message
     1388             vss-workfile vss-revision vss-description
     1389             skip "Ошибка определения границ fact-order для поиска по архивам"
     1390             skip return-value
     1391             skip trim(error-status :get-message(1))
     1392                  trim(error-status :get-message(2))
     1393                  trim(error-status :get-message(3))
     1394                  trim(error-status :get-message(4))
     1395                  trim(error-status :get-message(5))
     1396           view-as alert-box error.
     1397           undo, return error .
     1398       end.
     1399       if v-docs-exists = no
     1400       then do:
     1401           run wp-XMLWriteEDT( hEDT, 4, "В заданном диапазоне дат нет закрытых документов").
     1402           process events.
     1403       end.
     1404       else do:
     1405           run wp-XMLShowCNT(hCNT).
     1406           do v-oper-num = 1 to 14:
     1407               run rcs/rcs-oper.p (
     1408                                 input p-host-code
     1409                               , input p-obj-type
     1410                               , input p-obj-code
     1411                               , input v-ext-doc-type-list [v-oper-num * 3 - 1]
     1412                               , input v-ext-doc-type-list [v-oper-num * 3 - 2]
     1413                               , input v-ext-doc-type-list [v-oper-num * 3]
     1414                               , input v-fact-order-from
     1415                               , input v-fact-order-to
     1416                               , input p-pay-code
     1417                               , input p-cst
     1418                               , input p-head-filename
     1419                               , input p-body-filename
     1420                               , input p-head-filename + ".log"
     1421                               , input hEDT
     1422                               , input hCNT
     1423                               ) no-error.
     1424               if error-status :error
     1425               then do:
     1426                   run wp-XMLWriteEDT( hEDT, 1, string(return-value)).
     1427               end.
     1428           end.
     1429           run wp-XMLHideCNT(hCNT).
     1430       end.
     1431   end.
     1432   end procedure.
