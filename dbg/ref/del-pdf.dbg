        1   block-level on error undo, throw.
        2   define input  parameter parParentproc as handle no-undo .
        3   define input  parameter p-id     as integer   no-undo .
        4   define input  parameter p-db-num as integer   no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: del-pdf.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: ref/del-pdf.p $":U .
       10   define variable vss-description as character no-undo init "Процедура удалить цены".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable v-ask as logical   no-undo .
       72   define buffer buf_price-doc-forming for ub.price-doc-forming  .
       73       for each buf_price-doc-forming exclusive-lock where
       74                buf_price-doc-forming.plt-id     = p-id     and
       75                buf_price-doc-forming.plt-db-num = p-db-num
       76                :
       77                buf_price-doc-forming.stts = integer('1':U) .
       78                release buf_price-doc-forming.
       79        end.
       80          for each  ub.price-doc-forming no-lock  where
       81                    ub.price-doc-forming.plt-db-num   = p-db-num  and
       82                    ub.price-doc-forming.plt-id       = p-id :
       83   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run a-nwspdf in g#library2
       85     (input  ub.price-doc-forming.plt-id
       86     ,input  ub.price-doc-forming.plt-db-num
       87     ,input  ub.price-doc-forming.pdf-id
       88     ,input  ub.price-doc-forming.pdf-db
       89     ,output v-ask
       90     )  .
       91             if v-ask then do:
       92               run str/diallog.w
       93                       ( input parparentproc
       94                       , input this-procedure
       95                       , input 'str/sendpdfr.p':U
       96                       , input ("D":U + chr(4) +
       97                               string(ub.price-doc-forming.plt-id) + chr(4)  +
       98                               string(ub.price-doc-forming.plt-db-num) + chr(4) +
       99                               string(ub.price-doc-forming.pdf-id) + chr(4)  +
      100                               string(ub.price-doc-forming.pdf-db)
      101                               )
      102                       , input yes
      103                       , input '':U
      104                       , input '') no-error .
      105                       if error-status :error then do:
      106                       message
      107                         vss-workfile vss-revision vss-description skip
      108                         error-status :get-message(1) skip
      109                         return-value skip
      110                         "str/sendpdfr.p"
      111                         view-as alert-box error
      112                       .
      113                       end.
      114             end.
      115       end.
      116   define buffer ch_price-list-type for ub.price-list-type .
      117   for each ch_price-list-type no-lock  where
      118            ch_price-list-type.plt-main-id     = p-id     and
      119            ch_price-list-type.plt-main-db-num = p-db-num :
      120           for each buf_price-doc-forming exclusive-lock where
      121                    buf_price-doc-forming.plt-id     = ch_price-list-type.plt-id     and
      122                    buf_price-doc-forming.plt-db-num = ch_price-list-type.plt-db-num
      123                    :
      124                    buf_price-doc-forming.stts = integer('1':U) .
      125                    release buf_price-doc-forming.
      126           end.
      127          for each  ub.price-doc-forming no-lock  where
      128                    ub.price-doc-forming.plt-db-num   = ch_price-list-type.plt-db-num  and
      129                    ub.price-doc-forming.plt-id       = ch_price-list-type.plt-id :
      130   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run a-nwspdf in g#library2
      132     (input  ub.price-doc-forming.plt-id
      133     ,input  ub.price-doc-forming.plt-db-num
      134     ,input  ub.price-doc-forming.pdf-id
      135     ,input  ub.price-doc-forming.pdf-db
      136     ,output v-ask
      137     )  .
      138             if v-ask then do:
      139               run str/diallog.w
      140                       ( input parparentproc
      141                       , input this-procedure
      142                       , input 'str/sendpdfr.p':U
      143                       , input ("D":U + chr(4) +
      144                               string(ub.price-doc-forming.plt-id) + chr(4)  +
      145                               string(ub.price-doc-forming.plt-db-num) + chr(4) +
      146                               string(ub.price-doc-forming.pdf-id) + chr(4)  +
      147                               string(ub.price-doc-forming.pdf-db)
      148                               )
      149                       , input yes
      150                       , input '':U
      151                       , input '') no-error .
      152                       if error-status :error then do:
      153                       message
      154                         vss-workfile vss-revision vss-description skip
      155                         error-status :get-message(1) skip
      156                         return-value skip
      157                         "str/sendpdfr.p"
      158                         view-as alert-box error
      159                       .
      160                       end.
      161             end.
      162             end.
      163   end.
