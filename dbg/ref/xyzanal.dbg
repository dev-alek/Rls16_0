     3031           no-error .
     3032           if error-status :error
     3033           or error-status :get-message(1) <> ""
     3034           then do:
     3035             undo move_block, retry move_block.
     3036           end.
     3037         end.
     3038       end.
     3039       if p-move-resize
     3040       then do:
     3041         run diasize_position-resize-button in this-procedure .
     3042       end.
     3043       if v-diasize-wndstore = true
     3044       then do:
     3045         if connected("ub") = true
     3046         then do:
     3047           define variable v-cntxt-db-num        as integer   no-undo .
     3048           define variable v-cntxt-userid        as character no-undo .
     3049           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3050                                             , OUTPUT v-cntxt-userid
     3051                                             ) .
     3052           run gbl/wndsizew.p
     3053             (input  v-cntxt-db-num
     3054             ,input  v-cntxt-userid
     3055             ,input  v-diasize-proc-name
     3056             ,input  'width':u
     3057             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3058             ) .
     3059         end.
     3060       end.
     3061     end.
     3062     assign
     3063       v-diasize-change-size = false
     3064     .
     3065   end procedure.
     3066   procedure diasize_set-width :
     3067     define input  parameter p-new-width  as decimal   no-undo .
     3068     define input  parameter p-move-resize as logical   no-undo .
     3069     do
     3070     on error undo, return error return-value
     3071     :
     3072       run diasize_change-width in this-procedure
     3073         (input  (p-new-width - frame Dialog-Frame :width)
     3074         ,input  p-move-resize
     3075         ) .
     3076     end.
     3077   end procedure.
     3078   procedure diasize_position-resize-button :
     3079     do with frame Dialog-Frame
     3080     :
     3081       hide v-diasize-resize-button .
     3082       assign
     3083         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3084                     - 1
     3085                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3086         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3087                     - 1
     3088                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3089       .
     3090       view v-diasize-resize-button .
     3091     end.
     3092   end procedure.
     3093   on alt-right anywhere
     3094   do:
     3095     run diasize_change-width in this-procedure
     3096       (input 1
     3097       ,input true
     3098       ) .
     3099     return no-apply .
     3100   end.
     3101   on alt-left anywhere
     3102   do:
     3103     run diasize_change-width in this-procedure
     3104       (input -1
     3105       ,input true
     3106       ) .
     3107     return no-apply .
     3108   end.
     3109   on alt-down anywhere
     3110   do:
     3111     run diasize_change-height in this-procedure
     3112       (input 1
     3113       ,input true
     3114       ) .
     3115     return no-apply .
     3116   end.
     3117   on alt-up anywhere
     3118   do:
     3119     run diasize_change-height in this-procedure
     3120       (input -1
     3121       ,input true
     3122       ) .
     3123     return no-apply .
     3124   end.
     3125   on alt-enter of frame Dialog-Frame
     3126   do:
     3127     run diasize_maximize in this-procedure
     3128       (input  ?
     3129       ).
     3130     return no-apply .
     3131   end.
     3132   procedure diasize_end-move :
     3133     do
     3134     on error undo, return error return-value
     3135     :
     3136       define variable v-row-delta as decimal   no-undo .
     3137       define variable v-col-delta as decimal   no-undo .
     3138       define variable v-new-row as decimal   no-undo .
     3139       define variable v-new-col as decimal   no-undo .
     3140       assign
     3141         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3142         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3143       .
     3144       assign
     3145         v-row-delta = v-new-row - frame Dialog-Frame :height
     3146         v-col-delta = v-new-col - frame Dialog-Frame :width
     3147       .
     3148       run diasize_change-height in this-procedure
     3149         (input v-row-delta
     3150         ,input true
     3151         ) .
     3152       run diasize_change-width in this-procedure
     3153         (input v-col-delta
     3154         ,input true
     3155         ) .
     3156     end.
     3157   end procedure.
     3158   procedure diasize_maximize :
     3159     define input  parameter p-action as logical   no-undo .
     3160     do
     3161     on error undo, return error return-value
     3162     :
     3163       if p-action = ?
     3164       then do:
     3165         if v-diasize-need-maximize = true
     3166         then do:
     3167           assign
     3168             p-action = true
     3169           .
     3170         end.
     3171         else do:
     3172           assign
     3173             p-action = false
     3174           .
     3175         end.
     3176       end.
     3177       if p-action = true
     3178       then do:
     3179         run diasize_change-height in this-procedure
     3180           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3181               - frame Dialog-Frame :height-chars
     3182           ,input true
     3183           ) .
     3184         run diasize_change-width in this-procedure
     3185           (input session :width-chars
     3186               - frame Dialog-Frame :width-chars
     3187           ,input true
     3188           ) .
     3189         assign
     3190           v-diasize-need-maximize = false
     3191         .
     3192       end.
     3193       else do:
     3194         run diasize_change-width in this-procedure
     3195           (input v-diasize-orig-frame-width
     3196               - frame Dialog-Frame :width-chars
     3197           ,input true
     3198           ) .
     3199         run diasize_change-height in this-procedure
     3200           (input v-diasize-orig-frame-height
     3201               - frame Dialog-Frame :height-chars
     3202           ,input true
     3203           ) .
     3204         assign
     3205           v-diasize-need-maximize = true
     3206         .
     3207       end.
     3208     end.
     3209   end procedure.
     3210   procedure diasize_restore-orig-size :
     3211     do
     3212     on error undo, return error return-value
     3213     :
     3214       assign
     3215         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3216         v-diasize-current-frame-height = frame Dialog-Frame :height
     3217       .
     3218       run diasize_set-height in this-procedure
     3219         (input  v-diasize-orig-frame-height
     3220         ,input  true
     3221         ) .
     3222       run diasize_set-width in this-procedure
     3223         (input  v-diasize-orig-frame-width
     3224         ,input  true
     3225         ) .
     3226     end.
     3227   end procedure.
     3228   procedure diasize_restore-current-size :
     3229     do
     3230     on error undo, return error return-value
     3231     :
     3232       run diasize_set-height in this-procedure
     3233         (input  v-diasize-current-frame-height
     3234         ,input  true
     3235         ) .
     3236       run diasize_set-width in this-procedure
     3237         (input  v-diasize-current-frame-width
     3238         ,input  true
     3239         ) .
     3240     end.
     3241   end procedure.
     3242   procedure diasize_set-browse-handle :
     3243     define input  parameter p-browse-handle as handle   no-undo .
     3244     define buffer buf_temp-browse-handle for temp-browse-handle .
     3245     do
     3246     on error undo, return error return-value
     3247     :
     3248       assign
     3249         v-diasize-browse-handle = p-browse-handle
     3250       .
     3251       for each buf_temp-browse-handle
     3252       on error undo, return error return-value
     3253       :
     3254         delete buf_temp-browse-handle .
     3255       end.
     3256     end.
     3257   end procedure.
     3258   procedure diasize_add_browse :
     3259     define input  parameter p-browse-type   as character no-undo .
     3260     define input  parameter p-browse-handle as handle    no-undo .
     3261     define buffer buf_temp-browse-handle for temp-browse-handle .
     3262     do
     3263     on error undo, return error return-value
     3264     :
     3265       assign
     3266         v-diasize-browse-number = v-diasize-browse-number + 1
     3267       .
     3268       create buf_temp-browse-handle .
     3269       assign
     3270         buf_temp-browse-handle.browse-type   = p-browse-type
     3271         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3272         buf_temp-browse-handle.browse-handle = p-browse-handle
     3273       .
     3274     end.
     3275   end procedure.
     3276   procedure diasize_init :
     3277     define variable v-default-value    as logical   no-undo .
     3278     define variable v-restore-saved    as logical   no-undo .
     3279     define variable v-resize-value-str as character no-undo .
     3280     do
     3281     on error undo, return error return-value
     3282     :
     3283       do with frame Dialog-Frame
     3284       :
     3285         assign
     3286           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3287           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3288           v-diasize-browse-handle     = browse BROWSE-1XYZ :handle
     3289         .
     3290         create button v-diasize-resize-button
     3291         assign
     3292           parent        = frame Dialog-Frame :first-child
     3293           label         = "s"
     3294           height-pixels = 16
     3295           width-pixels  = 16
     3296           visible       = true
     3297           sensitive     = true
     3298           movable       = true
     3299           triggers:
     3300             on end-move persistent run diasize_end-move in this-procedure .
     3301           end triggers.
     3302         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3303         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3304         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3305         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3306         assign
     3307           v-diasize-wndmax = false
     3308         .
     3309         if connected("ub") = true
     3310         then do:
     3311           define variable v-cntxt-db-num        as integer   no-undo .
     3312           define variable v-cntxt-userid        as character no-undo .
     3313           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3314                                             , OUTPUT v-cntxt-userid
     3315                                             ) .
     3316           run gbl/wndpar_r.p
     3317             (input  v-cntxt-db-num
     3318             ,input  v-cntxt-userid
     3319             ,input  'wndmax':U
     3320             ,output v-diasize-wndmax
     3321             ,output v-default-value
     3322             ) .
     3323         end.
     3324         assign
     3325           v-diasize-wndstore = false
     3326         .
     3327         if connected("ub") = true
     3328         then do:
     3329           run gbl/wndpar_r.p
     3330             (input  v-cntxt-db-num
     3331             ,input  v-cntxt-userid
     3332             ,input  'wndstore':U
     3333             ,output v-diasize-wndstore
     3334             ,output v-default-value
     3335             ) .
     3336         end.
     3337         assign
     3338           v-diasize-proc-name = entry(1, program-name(2), '.')
     3339         .
     3340         if v-diasize-wndstore = true
     3341         then do:
     3342           assign
     3343             v-restore-saved = false
     3344           .
     3345           if connected("ub") = true
     3346           then do:
     3347             run gbl/wndsizer.p
     3348               (input  v-cntxt-db-num
     3349               ,input  v-cntxt-userid
     3350               ,input  v-diasize-proc-name
     3351               ,input  'height':u
     3352               ,output v-resize-value-str
     3353               ) .
     3354             if v-resize-value-str <> '':U
     3355             then do:
     3356               run diasize_change-height in this-procedure
     3357                 (input  integer(v-resize-value-str)
     3358                 ,input  true
     3359                 ) .
     3360               assign
     3361                 v-restore-saved = true
     3362               .
     3363             end.
     3364           end.
     3365           if connected("ub") = true
     3366           then do:
     3367             run gbl/wndsizer.p
     3368               (input  v-cntxt-db-num
     3369               ,input  v-cntxt-userid
     3370               ,input  v-diasize-proc-name
     3371               ,input  'width':u
     3372               ,output v-resize-value-str
     3373               ) .
     3374             if v-resize-value-str <> '':U
     3375             then do:
     3376               run diasize_change-width in this-procedure
     3377                 (input  integer(v-resize-value-str)
     3378                 ,input  true
     3379                 ) .
     3380               assign
     3381                 v-restore-saved = true
     3382               .
     3383             end.
     3384           end.
     3385           if v-restore-saved <> true
     3386           then do:
     3387             if v-diasize-wndmax = true
     3388             then do:
     3389               run diasize_maximize in this-procedure
     3390                 (input  true
     3391                 ) .
     3392             end.
     3393           end.
     3394         end.
     3395         else do:
     3396           if v-diasize-wndmax = true
     3397           then do:
     3398             run diasize_maximize in this-procedure
     3399               (input  true
     3400               ) .
     3401           end.
     3402         end.
     3403       end.
     3404     end.
     3405   end procedure.
     3406   procedure diasize_need-full-display :
     3407     define output parameter p-need-full-display as logical   no-undo .
     3408     do
     3409     on error undo, return error return-value
     3410     :
     3411       assign
     3412         p-need-full-display = v-diasize-need-full-display
     3413       .
     3414       assign
     3415         v-diasize-need-full-display = false
     3416       .
     3417     end.
     3418   end procedure.
     3419   procedure get-context :
     3420      define output parameter p-db-num as integer          no-undo.
     3421      define output parameter p-user-id as character        no-undo.
     3422      define variable v-login               as character    no-undo.
     3423      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3424      define buffer buf_user-login  for ub.user-login .
     3425      do
     3426      on error undo, return error
     3427      :
     3428            FIND FIRST buf_sys-ctrl no-lock.
     3429            ASSIGN
     3430               v-login = USERID("ub")
     3431               p-db-num = buf_sys-ctrl.db-num
     3432            .
     3433            FIND FIRST buf_user-login
     3434                 WHERE buf_user-login.db-num = p-db-num
     3435                   AND buf_user-login.user-login = v-login
     3436                 no-lock
     3437                 no-error
     3438                 .
     3439            IF AVAILABLE buf_user-login
     3440            THEN DO:
     3441               assign
     3442                  p-user-id = buf_user-login.user-id
     3443               .
     3444            END.
     3445      end.
     3446   end procedure.
     3447       run diasize_init in this-procedure .
     3448   def var sort-labelBROWSE-1XYZ   as character no-undo .
     3449   def var sort-clmnBROWSE-1XYZ    as handle    no-undo .
     3450   def var cur-clmnBROWSE-1XYZ     as handle    no-undo .
     3451   def var cur-clmn-locBROWSE-1XYZ as integer   no-undo .
     3452   def var re-queryBROWSE-1XYZ     as logical   initial no no-undo .
     3453   on start-search, ctrl-o of BROWSE-1XYZ in frame Dialog-Frame do:
     3454      run sort-brBROWSE-1XYZ
     3455        (input (if available x-XYZ-analysis
     3456                then recid(x-XYZ-analysis)
     3457                else ?
     3458               )
     3459        ).
     3460   end.
     3461   PROCEDURE sort-brBROWSE-1XYZ :
     3462     define input parameter p-recid as recid no-undo .
     3463     if re-queryBROWSE-1XYZ = no then do:
     3464       assign
     3465          cur-clmnBROWSE-1XYZ = BROWSE-1XYZ:current-column in frame Dialog-Frame
     3466       .
     3467       if sort-clmnBROWSE-1XYZ <> ? then sort-clmnBROWSE-1XYZ:column-fgcolor = 0.
     3468       if cur-clmnBROWSE-1XYZ = sort-clmnBROWSE-1XYZ then do:
     3469         assign
     3470            sort-labelBROWSE-1XYZ = ""
     3471            sort-clmnBROWSE-1XYZ = ?
     3472         .
     3473        end.
     3474        else do:
     3475          assign
     3476            sort-labelBROWSE-1XYZ = cur-clmnBROWSE-1XYZ:label
     3477            sort-clmnBROWSE-1XYZ  = cur-clmnBROWSE-1XYZ
     3478            sort-clmnBROWSE-1XYZ:column-fgcolor = 4
     3479          .
     3480        end.
     3481      end.
     3482     assign
     3483       cur-clmn-locBROWSE-1XYZ = 1
     3484     .
     3485     def var column-handle as handle no-undo .
     3486     column-handle = BROWSE-1XYZ:first-column.
     3487     do while valid-handle(column-handle) :
     3488       if column-handle = cur-clmnBROWSE-1XYZ then do:
     3489         leave .
     3490       end.
     3491       column-handle = column-handle:NEXT-COLUMN.
     3492       assign
     3493         cur-clmn-locBROWSE-1XYZ = cur-clmn-locBROWSE-1XYZ + 1
     3494       .
     3495     end.
     3496     case sort-labelBROWSE-1XYZ:
     3497           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(x-xyz-analysis), &1&2&1)', chr(34), p-rid-list)     .     run OpenBr.   . END.
     3498           when 'Наименование'  then DO:    assign       sort-column-name = "x-XYZ-analysis.XYZ-name"     .     run OpenBr.   . END.
     3499           when 'Критерий!анализа'  then DO:    assign       sort-column-name = "x-criterion-analysis.cral-name"     .     run OpenBr.   . END.
     3500           when ' X%'  then DO:    assign       sort-column-name = "x-XYZ-analysis.XYZ-x"     .     run OpenBr.   . END.
     3501           when ' Y%'  then DO:    assign       sort-column-name = "x-XYZ-analysis.XYZ-y"     .     run OpenBr.   . END.
     3502           when 'Z%'  then DO:    assign       sort-column-name = "x-XYZ-analysis.XYZ-z"     .     run OpenBr.   . END.
     3503           when 'Строка!объектов'  then DO:    assign       sort-column-name = "x-XYZ-analysis.XYZ-string-obj"     .     run OpenBr.   . END.
     3504           when 'Строка!периодов'  then DO:    assign       sort-column-name = "x-XYZ-analysis.XYZ-string-period"     .     run OpenBr.   . END.
     3505           when 'Строка!документов'  then DO:    assign       sort-column-name = "x-XYZ-analysis.XYZ-string-doc"     .     run OpenBr.   . END.
     3506           when 'Дата!создания'  then DO:    assign       sort-column-name = "x-XYZ-analysis.XYZ-date-create"     .     run OpenBr.   . END.
     3507           when 'Время!созд'  then DO:    assign       sort-column-name = "STRING (x-XYZ-analysis.XYZ-time-create,'HH:MM')"     .     run OpenBr.   . END.
     3508           when 'БД'  then DO:    assign       sort-column-name = "x-XYZ-analysis.XYZ-db-num-create"     .     run OpenBr.   . END.
     3509           when 'Внутр!№'  then DO:    assign       sort-column-name = "x-XYZ-analysis.XYZ-id"     .     run OpenBr.   . END.
     3510       otherwise do:
     3511         assign
     3512           sort-column-name = ""
     3513         .
     3514         run OpenBr.
     3515           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBROWSE-1XYZ') then do:
     3516             run mv-brw-defaultBROWSE-1XYZ.
     3517           end.
     3518         if sort-labelBROWSE-1XYZ <> "" then do:
     3519           assign
     3520             cur-clmnBROWSE-1XYZ:column-fgcolor = 0
     3521           .
     3522         end.
     3523         assign
     3524           cur-clmn-locBROWSE-1XYZ = ?
     3525         .
     3526       end.
     3527     end case.
     3528       if cur-clmn-locBROWSE-1XYZ <> ? then do:
     3529         if can-do( this-procedure:internal-entries, 'ch-clmnBROWSE-1XYZ') then do:
     3530           run ch-clmnBROWSE-1XYZ in this-procedure (cur-clmn-locBROWSE-1XYZ).
     3531         end.
     3532       end.
     3533     if p-recid <> ? then do:
     3534       reposition BROWSE-1XYZ to recid p-recid no-error.
     3535       apply "value-changed" to BROWSE-1XYZ in frame Dialog-Frame.
     3536     end.
     3537     apply "entry" to BROWSE-1XYZ in frame Dialog-Frame.
     3538   END PROCEDURE.
     3539   procedure re-open-query-srt-clmnBROWSE-1XYZ:
     3540   if cur-clmnBROWSE-1XYZ = ? then do:
     3541      run OpenBr.
     3542   end.
     3543   else do:
     3544      assign re-queryBROWSE-1XYZ = yes.
     3545      run sort-brBROWSE-1XYZ
     3546        (input (if available x-XYZ-analysis
     3547                then recid(x-XYZ-analysis)
     3548                else ?
     3549               )
     3550        ).
     3551      assign re-queryBROWSE-1XYZ = no.
     3552   end.
     3553   end.
     3554   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3555   do:
     3556     BROWSE-1XYZ :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3557   end.
     3558   MAIN-BLOCK:
     3559   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3560      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3561   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3562   DEF VAR cur-clmn-numBROWSE-1XYZ as INT EXTENT 13 no-undo.
     3563   DEF VAR varmviBROWSE-1XYZ       as INT no-undo.
     3564   DEF VAR varmvjBROWSE-1XYZ       as INT no-undo.
     3565   DEF VAR varmvkBROWSE-1XYZ       as INT no-undo.
     3566   DEF VAR varmvlBROWSE-1XYZ       as INT no-undo.
     3567   DEF VAR move-elementBROWSE-1XYZ as INT no-undo.
     3568   def var jjBROWSE-1XYZ           as int no-undo.
     3569   do varmviBROWSE-1XYZ = 1 to EXTENT(cur-clmn-numBROWSE-1XYZ):
     3570     ASSIGN cur-clmn-numBROWSE-1XYZ[varmviBROWSE-1XYZ] = varmviBROWSE-1XYZ.
     3571   END.
     3572   RUN start-mv-clmnBROWSE-1XYZ.
     3573   PROCEDURE start-mv-clmnBROWSE-1XYZ:
     3574   def var old-session as logical no-undo.
     3575      old-session = SESSION:IMMEDIATE-DISPLAY.
     3576      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3577      SESSION:IMMEDIATE-DISPLAY = old-session.
     3578   END.
     3579   ON ctrl-cursor-right OF BROWSE BROWSE-1XYZ do:
     3580     RUN re-move-clmnBROWSE-1XYZ ( 3, 13).
     3581   END.
     3582   ON ctrl-cursor-left OF BROWSE BROWSE-1XYZ do:
     3583     RUN re-move-clmnBROWSE-1XYZ (13, 3).
     3584   END.
     3585   PROCEDURE re-move-clmnBROWSE-1XYZ:
     3586     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3587     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3588     DO varmviBROWSE-1XYZ = 1 TO EXTENT(cur-clmn-numBROWSE-1XYZ):
     3589       if cur-clmn-numBROWSE-1XYZ[varmviBROWSE-1XYZ] = source-column THEN cur-clmn-numBROWSE-1XYZ[varmviBROWSE-1XYZ] = -1.
     3590     END.
     3591     if BROWSE-1XYZ:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3592     if source-column > target-column THEN
     3593     DO varmvjBROWSE-1XYZ = source-column - 1 to target-column BY -1:
     3594       DO varmviBROWSE-1XYZ = 1 TO EXTENT(cur-clmn-numBROWSE-1XYZ):
     3595           if cur-clmn-numBROWSE-1XYZ[varmviBROWSE-1XYZ] = varmvjBROWSE-1XYZ THEN DO:
     3596             cur-clmn-numBROWSE-1XYZ[varmviBROWSE-1XYZ] = cur-clmn-numBROWSE-1XYZ[varmviBROWSE-1XYZ] + 1.
     3597           END.
     3598       END.
     3599     END.
     3600     ELSE
     3601     DO varmvjBROWSE-1XYZ = source-column + 1 to target-column:
     3602       DO varmviBROWSE-1XYZ = 1 TO EXTENT(cur-clmn-numBROWSE-1XYZ):
     3603         if cur-clmn-numBROWSE-1XYZ[varmviBROWSE-1XYZ] = varmvjBROWSE-1XYZ THEN DO:
     3604           cur-clmn-numBROWSE-1XYZ[varmviBROWSE-1XYZ] = cur-clmn-numBROWSE-1XYZ[varmviBROWSE-1XYZ] - 1.
     3605         END.
     3606       END.
     3607     END.
     3608     DO varmviBROWSE-1XYZ = 1 TO EXTENT(cur-clmn-numBROWSE-1XYZ):
     3609       if cur-clmn-numBROWSE-1XYZ[varmviBROWSE-1XYZ] = -1 THEN cur-clmn-numBROWSE-1XYZ[varmviBROWSE-1XYZ] = target-column.
     3610     END.
     3611   END PROCEDURE.
     3612   PROCEDURE ch-clmnBROWSE-1XYZ:
     3613     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3614     if cur-clmn-loc <= 3 then do:
     3615       return .
     3616     end.
     3617     DO varmviBROWSE-1XYZ = 1 TO EXTENT(cur-clmn-numBROWSE-1XYZ):
     3618       if cur-clmn-numBROWSE-1XYZ[varmviBROWSE-1XYZ] = cur-clmn-loc THEN move-elementBROWSE-1XYZ = varmviBROWSE-1XYZ.
     3619     END.
     3620     RUN re-move-clmnBROWSE-1XYZ (cur-clmn-loc, 3).
     3621   END PROCEDURE.
     3622   PROCEDURE mv-brw-defaultBROWSE-1XYZ:
     3623   def var old-session as logical no-undo.
     3624     old-session = SESSION:IMMEDIATE-DISPLAY.
     3625     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3626     do varmvlBROWSE-1XYZ = 3 to EXTENT(cur-clmn-numBROWSE-1XYZ):
     3627       RUN re-move-clmnBROWSE-1XYZ (cur-clmn-numBROWSE-1XYZ[varmvlBROWSE-1XYZ], varmvlBROWSE-1XYZ).
     3628     END.
     3629     RUN start-mv-clmnBROWSE-1XYZ.
     3630     SESSION:IMMEDIATE-DISPLAY = old-session.
     3631   END PROCEDURE.
     3632   .
     3633   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3634   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3635     (output v-db-num
     3636     )  .
     3637     x-XYZ-analysis.XYZ-des:READ-ONLY IN FRAME Dialog-Frame = TRUE.
     3638     x-XYZ-analysis.XYZ-name:READ-ONLY IN FRAME Dialog-Frame = TRUE.
     3639     x-XYZ-analysis.XYZ-name:READ-ONLY IN browse BROWSE-1XYZ  = TRUE.
     3640     run my_enable in this-procedure .
     3641     WAIT-FOR GO OF FRAME Dialog-Frame focus BROWSE-1XYZ.
     3642   END.
     3643   run disable_ui in this-procedure .
     3644   PROCEDURE disable_UI :
     3645     HIDE FRAME Dialog-Frame.
     3646   END PROCEDURE.
     3647   PROCEDURE enable_UI :
     3648     DISPLAY mark-num v-user-name
     3649         WITH FRAME Dialog-Frame.
     3650     IF AVAILABLE x-criterion-analysis THEN
     3651       DISPLAY x-criterion-analysis.cral-name
     3652         WITH FRAME Dialog-Frame.
     3653     IF AVAILABLE x-XYZ-analysis THEN
     3654       DISPLAY x-XYZ-analysis.xyz-des x-XYZ-analysis.xyz-name
     3655         WITH FRAME Dialog-Frame.
     3656     ENABLE b-quit B-mark B-sel B-add B-lookup B-print B-Help BROWSE-1XYZ
     3657            BROWSE-obj BROWSE-period BROWSE-type-doc x-XYZ-analysis.xyz-des
     3658            mark-num x-XYZ-analysis.xyz-name v-user-name
     3659         WITH FRAME Dialog-Frame.
     3660     VIEW FRAME Dialog-Frame.
     3661     OPEN QUERY BROWSE-1XYZ FOR EACH x-XYZ-analysis NO-LOCK,              EACH x-criterion-analysis OF x-XYZ-analysis NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-obj FOR EACH x-XYZ-analysis-obj       WHERE x-XYZ-analysis-obj.XYZ-id = x-XYZ-analysis.XYZ-id and x-XYZ-analysis-obj.db-num = x-XYZ-analysis.db-num NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-period FOR EACH x-XYZ-analysis-period       WHERE x-XYZ-analysis-period.XYZ-id = x-XYZ-analysis.XYZ-id and x-XYZ-analysis-period.db-num = x-XYZ-analysis.db-num NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-type-doc FOR EACH x-XYZ-analysis-doc       WHERE x-XYZ-analysis-doc.XYZ-id = x-XYZ-analysis.XYZ-id and x-XYZ-analysis-doc.db-num = x-XYZ-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     3662   END PROCEDURE.
     3663   PROCEDURE my_enable :
     3664      x-XYZ-analysis.XYZ-name:resizable in browse BROWSE-1XYZ = true .
     3665      x-criterion-analysis.cral-name:resizable in browse BROWSE-1XYZ = true .
     3666     ENABLE b-quit
     3667            B-mark      when LOOKUP("b-mark":U, p-bttn ) > 0
     3668            mark-num
     3669            B-sel       when LOOKUP("b-sel":U, p-bttn ) > 0
     3670            B-add       when LOOKUP("b-add":U, p-bttn ) > 0
     3671            B-del       when LOOKUP("b-del":U, p-bttn ) > 0
     3672            B-lookup
     3673            B-print
     3674            B-Help
     3675            BROWSE-1XYZ
     3676            BROWSE-obj
     3677            BROWSE-period
     3678            BROWSE-type-doc
     3679            x-XYZ-analysis.XYZ-des
     3680            x-XYZ-analysis.XYZ-name
     3681         WITH FRAME Dialog-Frame.
     3682     VIEW FRAME Dialog-Frame.
     3683     run openbr in this-procedure .
     3684   END PROCEDURE.
     3685   PROCEDURE OpenBR :
     3686   define variable p-open-query     as logical   no-undo init true .
     3687   def var l-query-was-opened as logical no-undo .
     3688   define variable doc-rec  as recid     no-undo .
     3689   define variable  p-find-next      as logical   no-undo .
     3690   define variable  p-find-condition as character no-undo .
     3691   def var sort-column-phrase as character no-undo .
     3692   case sort-column-name :
     3693     when "" then do:
     3694       assign
     3695         sort-column-phrase = ""
     3696       .
     3697     end.
     3698     otherwise do:
     3699       assign
     3700         sort-column-phrase = "by " + sort-column-name
     3701       .
     3702     end.
     3703   end case.
     3704   define variable title0 as character no-undo init "Список Ассортиментных матриц".
     3705   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3706   define variable  l-disable-where-27  as logical   no-undo .
     3707   define variable  l-filter-open-27    as logical   .
     3708   define variable  flt-rec-27       as recid     no-undo .
     3709   define variable  filter-name-27      as character no-undo .
     3710   define variable  where-phrase-27     as character no-undo .
     3711   define variable  sort-phrase-27      as character no-undo .
     3712   define variable  where-phrase-rus-27 as character no-undo .
     3713   define variable  sort-phrase-rus-27  as character no-undo .
     3714     run waitfram-show in this-procedure
     3715       (input "ЖДИТЕ ..."
     3716       ).
     3717   run gbl/flt-get.p
     3718     (input filter-point
     3719     ,output flt-rec-27
     3720     ,output filter-name-27
     3721     ,output where-phrase-27
     3722     ,output sort-phrase-27
     3723     ,output where-phrase-rus-27
     3724     ,output sort-phrase-rus-27
     3725     ).
     3726   if p-open-query then do:
     3727       run set-filter-name in this-procedure
     3728         (INPUT filter-name-27
     3729         ) no-error .
     3730     assign
     3731       l-filter-open-27 = false
     3732     .
     3733     if flt-rec-27 <> ?
     3734       or sort-column-phrase > ""
     3735     then do:
     3736       define variable  parameter-2-27 as character no-undo .
     3737       define variable  parameter-3-27 as character no-undo .
     3738       define variable  parameter-4-27 as character no-undo .
     3739       define variable  parameter-5-27 as character no-undo .
     3740       define variable  parameter-6-27 as character no-undo .
     3741       define variable  parameter-7-27 as character no-undo .
     3742         assign
     3743         parameter-3-27 =
     3744                                 "FOR EACH x-xyz-analysis"
     3745         parameter-4-27 =
     3746           (
     3747             if (" true   " + " " + where-phrase-27) <> ""
     3748             then " true   " + " " + where-phrase-27
     3749             else "true"
     3750           )
     3751         parameter-5-27 = (" " + "" + " " + ", EACH x-criterion-analysis OF x-XYZ-analysis")
     3752         parameter-6-27 = if sort-phrase-27 = ''
     3753                              then
     3754           (
     3755           " " + " " +
     3756             " " + sort-column-phrase +
     3757           " " + " "
     3758           )
     3759                              else
     3760           (
     3761           " " + " " +
     3762             " " + sort-column-phrase +
     3763           " " + sort-phrase-27
     3764           )
     3765         parameter-7-27 =
     3766           " indexed-reposition  "
     3767       .
     3768       do
     3769       on stop undo, leave
     3770       on error undo, leave
     3771       :
     3772         assign
     3773           l-disable-where-27 =
     3774             (" true   " + " " + where-phrase-27 = "")
     3775         .
     3776         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3777                             ,input query BROWSE-1xyz:handle
     3778                             ,input parameter-3-27
     3779                             ,input parameter-4-27
     3780                             ,input parameter-5-27
     3781                             ,input parameter-6-27
     3782                             ,input parameter-7-27
     3783                             )
     3784         .
     3785         assign
     3786           l-filter-open-27 = true
     3787         .
     3788       end.
     3789       if l-filter-open-27 = false then do:
     3790         message
     3791           "Ошибка при фильтрации / сортировке" skip
     3792           "Будут показаны записи без учета фильтра" skip
     3793           view-as alert-box .
     3794       end.
     3795       else do:
     3796           assign
     3797             l-query-was-opened = true
     3798           .
     3799       end.
     3800     end.
     3801     if l-filter-open-27 = false then do:
     3802       OPEN QUERY BROWSE-1XYZ FOR EACH x-XYZ-analysis
     3803         where  true
     3804       , EACH x-criterion-analysis OF x-XYZ-analysis
     3805         indexed-reposition
     3806     .
     3807         assign
     3808           l-query-was-opened = true
     3809         .
     3810     end.
     3811   end.
     3812   else do:
     3813     assign
     3814       doc-rec = recid( x-XYZ-analysis )
     3815     .
     3816     do
     3817     on stop undo, leave
     3818     on error undo, leave
     3819     :
     3820       if query BROWSE-1xyz:handle:get-buffer-handle(1) = (buffer x-xyz-analysis:handle) then do:
     3821         assign
     3822         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     3823         parameter-4-27 =
     3824           "where ":u + " true   " + " ":u + where-phrase-27 + " ":u + p-find-condition + " " + ""
     3825         parameter-5-27 = " "
     3826       .
     3827         run fltopend_fltfindd in this-procedure  (
     3828                             input this-procedure:handle
     3829                             ,input query BROWSE-1xyz:handle
     3830                             ,input rowid(x-XYZ-analysis)
     3831                             ,input logical(parameter-2-27)
     3832                             ,input no-lock
     3833                             ,input (buffer x-XYZ-analysis:handle)
     3834                             ,input parameter-4-27
     3835                             ,input parameter-5-27
     3836                             ) no-error.
     3837         .
     3838         assign
     3839           doc-rec = integer(return-value)
     3840           v-fltopend-rowid[1] = ?
     3841         .
     3842       end.
     3843       else do:
     3844         assign
     3845         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     3846         parameter-3-27 =  "FOR EACH x-xyz-analysis"
     3847         parameter-4-27 =
     3848           (
     3849             if (" true   " + " " + where-phrase-27) <> ""
     3850             then " true   " + " " + where-phrase-27
     3851             else "true"
     3852           )
     3853         parameter-5-27 = (" " + "" + " " + ", EACH x-criterion-analysis OF x-XYZ-analysis" + " " + p-find-condition)
     3854         parameter-6-27 = if sort-phrase-27 = ''
     3855                              then
     3856           (
     3857           " " + " " +
     3858             " " + sort-column-phrase +
     3859           " " + " "
     3860           )
     3861                              else
     3862           (
     3863           " " + " " +
     3864             " " + sort-column-phrase +
     3865           " " + sort-phrase-27
     3866           )
     3867         parameter-7-27 =
     3868           " indexed-reposition  "
     3869       .
     3870         run fltopend_fltfindq in this-procedure  (
     3871                             input this-procedure:handle
     3872                             ,input query BROWSE-1xyz:handle
     3873                             ,input logical(parameter-2-27)
     3874                             ,input no-lock
     3875                             ,input parameter-3-27
     3876                             ,input parameter-4-27
     3877                             ,input parameter-5-27
     3878                             ,input parameter-6-27
     3879                             ,input parameter-7-27
     3880                             ,output v-fltopend-rowid
     3881                             ) no-error.
     3882         .
     3883         doc-rec = ?.
     3884       end.
     3885       assign
     3886         l-query-was-opened = true
     3887       .
     3888     end.
     3889   end.
     3890     run waitfram-hide in this-procedure .
     3891   APPLY "ENTRY" TO BROWSE-1XYZ in frame Dialog-Frame.
     3892   APPLY "VALUE-CHANGED" TO BROWSE-1XYZ in frame Dialog-Frame.
     3893   END PROCEDURE.
     3894   PROCEDURE proc-add :
     3895   define output  parameter p-doc-rec as recid     no-undo .
     3896   run ref/xyzanali.w
     3897       ( input parparentproc ,
     3898         input  'ДОБАВЛЕНИЕ':U ,
     3899         input  ? ,
     3900         input v-db-num ,
     3901         input-output p-doc-rec ) .
     3902   END PROCEDURE.
     3903   PROCEDURE proc-b-del :
     3904   define variable loc-doc-rec as recid   no-undo.
     3905   define variable g#log       as logical no-undo .
     3906   define variable br-handle   as handle  no-undo.
     3907   if not available x-XYZ-analysis then return error.
     3908    find current x-XYZ-analysis exclusive-lock no-error .
     3909           if not available x-XYZ-analysis then do:
     3910             message vss-workfile vss-revision vss-description skip
     3911                       error-status :get-message(1)   skip
     3912                       "Ошибка при определении записи x-XYZ-analysis"
     3913                       view-as alert-box error .
     3914             return .
     3915           end.
     3916     delete x-XYZ-analysis .
     3917     br-handle = BROWSE-1XYZ:handle in frame Dialog-Frame .
     3918     if valid-handle (br-handle) then do:
     3919       g#log = br-handle:select-next-row().
     3920       if not g#log then g#log = br-handle:select-prev-row().
     3921       loc-doc-rec = RECID(x-XYZ-analysis) .
     3922     end.
     3923      run openbr in this-procedure .
     3924      apply "VALUE-CHANGED" to BROWSE-1XYZ in frame Dialog-Frame.
     3925      reposition BROWSE-1XYZ to recid loc-doc-rec no-error.
     3926   END PROCEDURE.
     3927   PROCEDURE proc-b-print :
     3928   def var date_string     as      char    no-undo.
     3929   def var Line                as      char    no-undo.
     3930   def var for-time as char.
     3931   define variable v-time  as character no-undo .
     3932              run get-report-num (
     3933               output p-report-id
     3934           ).
     3935       v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     3936       output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     3937       put stream OutStr-html unformatted
     3938                "<!DOCTYPE HTML>" skip
     3939                   ' <html>' skip
     3940                   '  <head>' skip
     3941                   '   <meta charset="utf-8">' skip
     3942                   '    <style type="text/css">' skip
     3943                   '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     3944                   '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     3945                   '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     3946                   '   </style>' skip
     3947                   '  </head>' skip
     3948               .
     3949       put stream OutStr-html unformatted
     3950           '<body>' skip
     3951           '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     3952           '<thead>' skip
     3953           '<TR class="set_columns">'skip
     3954               '<TD style="width: 150px;"></TD>'skip
     3955               '<TD style="width: 150px;"></TD>'skip
     3956               '<TD style="width: 50px;"></TD>'skip
     3957               '<TD style="width: 50px;"></TD>'skip
     3958               '<TD style="width: 50px;"></TD>'skip
     3959               '<TD style="width: 50px;"></TD>'skip
     3960               '<TD style="width: 70px;"></TD>'skip
     3961               '<TD style="width: 70px;"></TD>'skip
     3962               '<TD style="width: 50px;"></TD>'skip
     3963               '<TD style="width: 70px;"></TD>'skip
     3964               '<TD style="width: 50px;"></TD>'skip
     3965               '<TD style="width: 30px;"></TD>'skip
     3966               '<TD style="width: 50px;"></TD>'skip
     3967           '</TR>'skip
     3968           '<TR>'skip
     3969               '<TD colspan="13" STYLE="font-size: 14px;">Список XYZ-анализов</TD>'skip
     3970           '</TR>'skip
     3971           '<TR>'skip
     3972               '<TD colspan="13" STYLE="font-size: 14px;">Дата печати: ' + string(date_string,"99.99.9999") + '</TD>' skip
     3973           '</TR>'skip
     3974           '</thead>'skip
     3975       .
     3976        put stream OutStr-html unformatted
     3977           '<tbody>'
     3978           '<TR>'skip
     3979               '<TH style="text-align: center;">Наименование</TH>'skip
     3980               '<TH style="text-align: center;">Критерий анализа</TH>'skip
     3981               '<TH style="text-align: center;">X%</TH>'skip
     3982               '<TH style="text-align: center;">Y%</TH>'skip
     3983               '<TH style="text-align: center;">def X%</TH>'skip
     3984               '<TH style="text-align: center;">def Y%</TH>'skip
     3985               '<TH style="text-align: center;">Строка объектов</TH>'skip
     3986               '<TH style="text-align: center;">Строка периодов</TH>'skip
     3987               '<TH style="text-align: center;">Строка документов</TH>'skip
     3988               '<TH style="text-align: center;">Дата создания</TH>'skip
     3989               '<TH style="text-align: center;">Время создания</TH>'skip
     3990               '<TH style="text-align: center;">БД</TH>'skip
     3991               '<TH style="text-align: center;">Кто провел анализ</TH>'skip
     3992           '</TR>'skip
     3993           .
     3994        for each x-XYZ-analysis :
     3995   put stream OutStr-html unformatted
     3996                                 '<TR>'skip
     3997                                     '<TD style="text-align: center"> ' + string(x-XYZ-analysis.XYZ-name) + '</TD>'skip
     3998                                     '<TD style="text-align: center"> ' + string(x-criterion-analysis.cral-name) + '</TD>'skip
     3999                                     '<TD num="0" val="' + fnc-convert-dot-to-colon(x-XYZ-analysis.XYZ-x,"->>>>>>>>>>>9",0) + '" style="text-align: right"> ' + if x-XYZ-analysis.XYZ-x <> ? then fnc-convert-dot-to-colon(x-XYZ-analysis.XYZ-x,"->>>>>>>>>>>9",0) + '</TD>' else "" + '</td>' skip
     4000                                     '<TD num="0" val="' + fnc-convert-dot-to-colon(x-XYZ-analysis.XYZ-y,"->>>>>>>>>>>9",0) + '" style="text-align: right"> ' + if x-XYZ-analysis.XYZ-y <> ? then fnc-convert-dot-to-colon(x-XYZ-analysis.XYZ-y,"->>>>>>>>>>>9",0) + '</TD>' else "" + '</td>' skip
     4001                                     '<TD num="0" val="' + fnc-convert-dot-to-colon(x-XYZ-analysis.raxd-x,"->>>>>>>>>>>9",0) + '" style="text-align: right"> ' + if x-XYZ-analysis.raxd-x <> ? then fnc-convert-dot-to-colon(x-XYZ-analysis.raxd-x,"->>>>>>>>>>>9",0) + '</TD>' else "" + '</td>' skip
     4002                                     '<TD num="0" val="' + fnc-convert-dot-to-colon(x-XYZ-analysis.raxd-y,"->>>>>>>>>>>9",0) + '" style="text-align: right"> ' + if x-XYZ-analysis.raxd-y <> ? then fnc-convert-dot-to-colon(x-XYZ-analysis.raxd-y,"->>>>>>>>>>>9",0) + '</TD>' else "" + '</td>' skip
     4003                                     '<TD> ' + string(x-XYZ-analysis.XYZ-string-obj) + '</TD>'skip
     4004                                     '<TD> ' + string(x-XYZ-analysis.XYZ-string-period) + '</TD>'skip
     4005                                     '<TD> ' + string(x-XYZ-analysis.xyz-string-doc) + '</TD>'skip
     4006                                     '<TD> ' + string(x-XYZ-analysis.xyz-date-create,"99/99/99") + '</TD>'skip
     4007                                     '<TD> ' + STRING (x-XYZ-analysis.XYZ-time-create,'HH:MM') + '</TD>'skip
     4008                                     '<TD num="0" val="' + fnc-convert-dot-to-colon(x-XYZ-analysis.xyz-db-num-create,"->>>>>>>>>>>9",0) + '" style="text-align: right"> ' + if x-XYZ-analysis.db-num <> ? then fnc-convert-dot-to-colon(x-XYZ-analysis.db-num,"->>>>>>>>>>>9",0) + '</TD>' else "" + '</td>' skip
     4009                                     '<TD> ' + STRING (x-XYZ-analysis.xyz-who-create) + '</TD>'skip
     4010                                 '</TR>'skip
     4011                                 .
     4012         END.
     4013      put stream OutStr-html unformatted
     4014                                   '</tbody>' skip
     4015                                   '</table>' skip
     4016                                   '</body>' skip
     4017                                   '</html>' skip
     4018                                   .
     4019   output stream OutStr-html close.
     4020     run prn-lib-reportviewer-report-name in this-procedure (
     4021                                                             input parParentProc
     4022                                                             ,input v-file-name-rep-htm
     4023                                                             ).
     4024   END PROCEDURE.
     4025   FUNCTION f-name-doc RETURNS CHARACTER
     4026     ( BUFFER buf_XYZ-analysis-doc FOR  x-XYZ-analysis-doc   ) :
     4027       define variable v-ret as character no-undo .
     4028       run get-name-from-ext-type in this-procedure (buf_XYZ-analysis-doc.XYZd-ext-doc-type , no ,  output  v-ret ) .
     4029     RETURN v-ret.
     4030   END FUNCTION.
     4031   PROCEDURE get-report-num :
     4032   define output parameter p-report-num as integer no-undo .
     4033     do
     4034     on error undo, return error return-value
     4035     :
     4036       run gbl/getrpnum.p (output p-report-num).
     4037     end.
     4038   END PROCEDURE.
