     1430   PROCEDURE find-def-analysis-obj :
     1431   define input  parameter p-type     as character no-undo .
     1432   define input  parameter p-obj-type as character no-undo .
     1433   define input  parameter p-obj-code as integer   no-undo .
     1434   define output parameter p-abc-id   as integer   no-undo .
     1435   define output parameter p-db-num   as integer   no-undo .
     1436     do
     1437     on error undo, return error return-value
     1438     :
     1439     if p-type = "abc"  then do:
     1440         define buffer buf_abc-analysis-obj for ub.abc-analysis-obj  .
     1441         define buffer buf_abc-analysis     for ub.abc-analysis      .
     1442         find first buf_abc-analysis-obj no-lock where
     1443                   buf_abc-analysis-obj.obj-type = p-obj-type and
     1444                   buf_abc-analysis-obj.obj-code = p-obj-code and
     1445                   buf_abc-analysis-obj.is-def   = true use-index objdef no-error .
     1446                   if available buf_abc-analysis-obj then do:
     1447                       p-abc-id = buf_abc-analysis-obj.abc-id .
     1448                       p-db-num = buf_abc-analysis-obj.db-num .
     1449                   end.
     1450                   else do:
     1451                       p-abc-id = 0 .
     1452                       p-db-num = 0.
     1453                       return "На объекте нет анализа по умолчанию" .
     1454                   end.
     1455     end.
     1456     if p-type = "xyz"  then do:
     1457         define buffer buf_xyz-analysis-obj for ub.xyz-analysis-obj  .
     1458         define buffer buf_xyz-analysis     for ub.xyz-analysis      .
     1459         find first buf_xyz-analysis-obj no-lock where
     1460                   buf_xyz-analysis-obj.obj-type = p-obj-type and
     1461                   buf_xyz-analysis-obj.obj-code = p-obj-code and
     1462                   buf_xyz-analysis-obj.is-def   = true use-index objdef no-error .
     1463                   if available buf_xyz-analysis-obj then do:
     1464                       p-abc-id = buf_xyz-analysis-obj.xyz-id .
     1465                       p-db-num = buf_xyz-analysis-obj.db-num .
     1466                   end.
     1467                   else do:
     1468                       p-abc-id = 0 .
     1469                       p-db-num = 0 .
     1470                       return "На объекте нет анализа по умолчанию" .
     1471                   end.
     1472     end.
     1473     return .
     1474   end.
     1475   END PROCEDURE.
     1476   procedure save-def-analysis-obj :
     1477   define input  parameter p-type     as character no-undo .
     1478   define input  parameter p-db-num   as integer   no-undo .
     1479   define input  parameter p-abc-id   as integer   no-undo .
     1480   define output parameter v-log      as logical   no-undo .
     1481     do
     1482     on error undo, return error return-value
     1483     :
     1484     v-log = true .
     1485     if p-type = "abc"  then do:
     1486         define buffer buf_abc-analysis-obj for ub.abc-analysis-obj  .
     1487         define buffer buf_abc-obj          for ub.abc-analysis-obj  .
     1488         define buffer buf_abc-analysis     for ub.abc-analysis      .
     1489         for each buf_abc-obj no-lock where
     1490                  buf_abc-obj.abc-id = p-abc-id and
     1491                  buf_abc-obj.db-num = p-db-num :
     1492               define variable v-exist    as logical   no-undo init false .
     1493               define variable v-list-anal as character no-undo init ""    .
     1494               for each  buf_abc-analysis-obj no-lock where
     1495                         not (buf_abc-analysis-obj.abc-id = p-abc-id and
     1496                              buf_abc-analysis-obj.db-num = p-db-num) and
     1497                         buf_abc-analysis-obj.is-def   = true   and
     1498                         buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
     1499                         buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code
     1500                         :
     1501                   v-exist    = true .
     1502                   v-list-anal = string( buf_abc-analysis-obj.abc-id ) + "," .
     1503               end.
     1504               if v-exist then do:
     1505                   message "На объекте "
     1506                   buf_abc-obj.obj-type
     1507                   buf_abc-obj.obj-code
     1508                   skip
     1509                   "уже есть анализы по умолчанию , их внутренние номера :" skip
     1510                   v-list-anal                                              skip
     1511                   "Сделать по умолчанию анализ текущий " p-abc-id " ?"
     1512                   view-as alert-box question
     1513                   buttons yes-no update v-log .
     1514                   if v-log then do:
     1515                       for each  buf_abc-analysis-obj exclusive-lock where
     1516                                 buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
     1517                                 buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code :
     1518                         if ( buf_abc-analysis-obj.abc-id = p-abc-id and
     1519                              buf_abc-analysis-obj.db-num = p-db-num ) then
     1520                                 buf_abc-analysis-obj.is-def   = true .
     1521                         else buf_abc-analysis-obj.is-def   = false  .
     1522                       end.
     1523                   end.
     1524               end.
     1525               else do:
     1526                 for each  buf_abc-analysis-obj exclusive-lock where
     1527                           buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
     1528                           buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code and
     1529                           buf_abc-analysis-obj.abc-id = p-abc-id and
     1530                           buf_abc-analysis-obj.db-num = p-db-num
     1531                           :
     1532                     buf_abc-analysis-obj.is-def   = true .
     1533                 end.
     1534               end.
     1535         end.
     1536     end.
     1537     if p-type = "xyz"  then do:
     1538         define buffer buf_xyz-analysis-obj for ub.xyz-analysis-obj  .
     1539         define buffer buf_xyz-obj          for ub.xyz-analysis-obj  .
     1540         define buffer buf_xyz-analysis     for ub.xyz-analysis      .
     1541         for each buf_xyz-obj no-lock where
     1542                  buf_xyz-obj.xyz-id = p-abc-id and
     1543                  buf_xyz-obj.db-num = p-db-num :
     1544               v-exist = false .
     1545               v-list-anal = ""    .
     1546               for each  buf_xyz-analysis-obj no-lock where
     1547                         not (buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1548                              buf_xyz-analysis-obj.db-num = p-db-num) and
     1549                         buf_xyz-analysis-obj.is-def   = true   and
     1550                         buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1551                         buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code
     1552                         :
     1553                   v-exist    = true .
     1554                   v-list-anal = string( buf_xyz-analysis-obj.xyz-id ) + "," .
     1555               end.
     1556               if v-exist then do:
     1557                   message "На объекте "
     1558                   buf_xyz-obj.obj-type
     1559                   buf_xyz-obj.obj-code
     1560                   skip
     1561                   "уже есть анализы по умолчанию , их внутренние номера :" skip
     1562                   v-list-anal                                              skip
     1563                   "Сделать по умолчанию анализ текущий " p-abc-id " ?"
     1564                   view-as alert-box question
     1565                   buttons yes-no update v-log .
     1566                   if v-log then do:
     1567                       for each  buf_xyz-analysis-obj exclusive-lock where
     1568                                 buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1569                                 buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code :
     1570                         if ( buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1571                              buf_xyz-analysis-obj.db-num = p-db-num ) then
     1572                                 buf_xyz-analysis-obj.is-def   = true .
     1573                         else buf_xyz-analysis-obj.is-def   = false  .
     1574                       end.
     1575                   end.
     1576               end.
     1577               else do:
     1578                 for each  buf_xyz-analysis-obj exclusive-lock where
     1579                           buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1580                           buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code and
     1581                           buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1582                           buf_xyz-analysis-obj.db-num = p-db-num
     1583                           :
     1584                     buf_xyz-analysis-obj.is-def   = true .
     1585                 end.
     1586               end.
     1587         end.
     1588     end.
     1589   end.
     1590   end procedure.
     1591   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1592   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1593   procedure fltopend_fltopend :
     1594   define input parameter p-parent-handle as handle no-undo .
     1595   define input parameter p-qh as handle no-undo .
     1596   define input parameter p-flt-open-open-query  as character no-undo .
     1597   define input parameter p-where-cond as character no-undo .
     1598   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1599   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1600   define input parameter p-indexed-reposition as character no-undo .
     1601     do
     1602     on error undo, return error
     1603     :
     1604   define variable v-prepare-string as character no-undo .
     1605   define variable glog as logical no-undo .
     1606   assign
     1607   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1608                      p-where-cond + chr(32)  +
     1609                      p-use-indFIRST-query-tail + chr(32) +
     1610                      p-use-ind-sort-clmn-by + chr(32) +
     1611                      p-indexed-reposition
     1612   .
     1613   assign
     1614   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1615   if not glog
     1616   or error-status:error then do:
     1617     message error-status:get-message(1) view-as alert-box .
     1618     undo, return error .
     1619   end.
     1620   assign
     1621   glog = p-qh:query-open no-error .
     1622   if not glog
     1623   or error-status:error then do:
     1624     message error-status:get-message(1) view-as alert-box .
     1625     undo, return error .
     1626   end.
     1627     end.
     1628   end procedure.
     1629   procedure fltopend_fltfindd :
     1630   define input parameter p-parent-handle as handle no-undo .
     1631   define input parameter p-qh as handle no-undo .
     1632   define input parameter p-rowid as rowid no-undo .
     1633   define input parameter p-next as logical no-undo .
     1634   define input parameter p-lock as integer no-undo .
     1635   define input parameter p-bh as handle no-undo .
     1636   define input parameter p-where-cond as character no-undo .
     1637   define input parameter p-use-index-phrase as character no-undo .
     1638   define variable glog as logical no-undo .
     1639   define variable v-qh as handle no-undo .
     1640   define variable v-bh as handle no-undo .
     1641   define variable v-recid as recid no-undo .
     1642   define variable v-prepare-string as character no-undo .
     1643   do
     1644   on error undo, return error
     1645   on stop undo, return error
     1646   :
     1647     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1648     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1649     create query v-qh.
     1650     v-qh:set-buffers(v-bh).
     1651     v-prepare-string = substitute("for each &1 &2 &3"
     1652                                     ,v-bh:name
     1653                                     ,p-where-cond
     1654                                     ,p-use-index-phrase).
     1655     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1656     if not glog then do:
     1657       delete object v-qh.
     1658       delete object v-bh.
     1659       undo, return error .
     1660     end.
     1661     glog = v-qh:query-open no-error .
     1662     if not glog then do:
     1663       delete object v-qh.
     1664       delete object v-bh.
     1665       undo, return error .
     1666     end.
     1667     if p-next then do:
     1668       v-qh:reposition-to-rowid(p-rowid) no-error .
     1669       glog = v-qh:get-next( p-lock) no-error .
     1670       glog = v-qh:get-next( p-lock) no-error .
     1671       if not glog or v-qh:query-off-end = yes then do:
     1672         glog = v-qh:get-first( p-lock) no-error .
     1673       end.
     1674     end.
     1675     else do:
     1676       glog = v-qh:get-first( p-lock) no-error .
     1677     end.
     1678     v-recid = v-bh:recid no-error .
     1679     delete object v-qh.
     1680     delete object v-bh.
     1681     return string(v-recid) .
     1682   end.
     1683   end procedure.
     1684   procedure fltopend_fltfindq :
     1685   define input parameter p-parent-handle as handle no-undo .
     1686   define input parameter p-qh as handle no-undo .
     1687   define input parameter p-next as logical no-undo .
     1688   define input parameter p-lock as integer no-undo .
     1689   define input parameter p-flt-open-open-query  as character no-undo .
     1690   define input parameter p-where-cond as character no-undo .
     1691   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1692   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1693   define input parameter p-indexed-reposition as character no-undo .
     1694   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1695   define variable glog as logical no-undo .
     1696   define variable v-qh as handle no-undo .
     1697   define variable v-bh as handle no-undo extent 18.
     1698   define variable v-rowid as rowid no-undo extent 18.
     1699   define variable v-ii as integer no-undo .
     1700   define variable v-prepare-string as character no-undo .
     1701   do
     1702   on error undo, return error
     1703   on stop undo, return error
     1704   :
     1705     create query v-qh.
     1706     do v-ii = 1 to p-qh:num-buffers:
     1707       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1708       assign
     1709       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1710       no-error.
     1711       v-qh:add-buffer(v-bh[v-ii]).
     1712     end.
     1713     assign
     1714     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1715                       p-where-cond + chr(32)  +
     1716                       p-use-indFIRST-query-tail + chr(32) +
     1717                       p-use-ind-sort-clmn-by + chr(32) +
     1718                       p-indexed-reposition
     1719     .
     1720     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1721     if not glog then do:
     1722       delete object v-qh.
     1723       do v-ii = 1 to p-qh:num-buffers:
     1724         delete object v-bh[v-ii].
     1725       end.
     1726       undo, return error .
     1727     end.
     1728     glog = v-qh:query-open no-error .
     1729     if not glog then do:
     1730       delete object v-qh.
     1731       do v-ii = 1 to p-qh:num-buffers:
     1732         delete object v-bh[v-ii].
     1733       end.
     1734       undo, return error .
     1735     end.
     1736     if p-next then do:
     1737       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1738       glog = v-qh:get-next( p-lock) no-error .
     1739       glog = v-qh:get-next( p-lock) no-error .
     1740       if not glog or v-qh:query-off-end = yes then do:
     1741         glog = v-qh:get-first( p-lock) no-error .
     1742       end.
     1743     end.
     1744     else do:
     1745       glog = v-qh:get-first( p-lock) no-error .
     1746     end.
     1747     do v-ii = 1 to p-qh:num-buffers:
     1748       assign
     1749       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1750       no-error.
     1751     end.
     1752     delete object v-qh.
     1753     do v-ii = 1 to p-qh:num-buffers:
     1754       delete object v-bh[v-ii].
     1755     end.
     1756   end.
     1757   end procedure.
     1758   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1759   FUNCTION mark-string RETURNS CHARACTER
     1760     ( input p-recid as recid, input mark-list as character  ) :
     1761     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1762   END FUNCTION.
     1763   function fnc-convert-dot-to-colon returns character
     1764       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     1765   function fnc-convert-dot-to-colon returns character
     1766   (input p-data as decimal, input p-accur as character, input p-num as integer):
     1767       define variable result as character no-undo.
     1768       define variable v-str-result as character no-undo.
     1769       if p-data = ? then p-data = 0 .
     1770       p-data = round(p-data, p-num).
     1771       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1772       return v-str-result.
     1773   END FUNCTION.
     1774   define variable mark-str  AS CHARACTER NO-UNDO.
     1775   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
     1776   define variable filter-point as character no-undo init "Ассортиментная матрица" .
     1777   define variable filter-point0 as character no-undo init "Состав_ассортиментной_матрицы" .
     1778   define variable sort-column-name as character no-undo .
     1779   define variable v-db-num LIKE ub.db.db-num no-undo.
     1780   define variable v-type as character no-undo .
     1781   define variable p-mark as character no-undo .
     1782   define variable p-obj  as character no-undo .
     1783   define variable p-time-upd as character no-undo .
     1784   define variable p-time-cr  as character no-undo .
     1785   define variable p-status as character no-undo .
     1786   define variable  v-def as character no-undo .
     1787   define variable p-curr-obj-code as integer   no-undo .
     1788   define variable p-curr-obj-type as character no-undo .
     1789   define stream Out-Stream.
     1790   define stream OutStr-html.
     1791   define VARIABLE p-report-id              as character               no-undo .
     1792   define variable v-file-name-rep-htm as character no-undo .
     1793   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1794     run mainmenu_getcntxt in parparentproc
