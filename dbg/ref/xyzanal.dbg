     1807   .
     1808   FUNCTION f-name-doc RETURNS CHARACTER
     1809     ( BUFFER buf_XYZ-analysis-doc FOR  x-XYZ-analysis-doc   )  FORWARD.
     1810   DEFINE BUTTON B-add
     1811        LABEL "&Добавить"
     1812        SIZE 10 BY 1 TOOLTIP "Формирование нового анализа".
     1813   DEFINE BUTTON B-chg
     1814        LABEL "&Изменить"
     1815        SIZE 10 BY 1.
     1816   DEFINE BUTTON B-del
     1817        LABEL "&Удалить"
     1818        SIZE 10 BY 1.
     1819   DEFINE BUTTON B-Help
     1820        LABEL "Помо&щь"
     1821        SIZE 10 BY 1
     1822        BGCOLOR 8 .
     1823   DEFINE BUTTON B-lookup
     1824        LABEL "&Просмотр"
     1825        SIZE 10 BY 1 TOOLTIP "Просмотр результата анализа".
     1826   DEFINE BUTTON B-mark
     1827        LABEL "&*"
     1828        SIZE 3 BY 1.
     1829   DEFINE BUTTON B-print
     1830        LABEL "Пе&чать"
     1831        SIZE 10 BY 1.
     1832   DEFINE BUTTON b-quit AUTO-END-KEY
     1833        LABEL "&Выход"
     1834        SIZE 10 BY 1
     1835        BGCOLOR 8 .
     1836   DEFINE BUTTON B-sel AUTO-GO
     1837        LABEL "Вы&бор"
     1838        SIZE 10 BY 1.
     1839   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1840         VIEW-AS TEXT
     1841        SIZE 3 BY 1
     1842        FGCOLOR 4  NO-UNDO.
     1843   DEFINE VARIABLE v-user-name AS CHARACTER FORMAT "X(256)":U
     1844        LABEL "Создал"
     1845         VIEW-AS TEXT
     1846        SIZE 15 BY .67
     1847        FGCOLOR 4  NO-UNDO.
     1848   DEFINE new shared QUERY BROWSE-1XYZ FOR
     1849         x-XYZ-analysis,
     1850         x-criterion-analysis SCROLLING.
     1851   DEFINE QUERY BROWSE-obj FOR
     1852         x-XYZ-analysis-obj SCROLLING.
     1853   DEFINE QUERY BROWSE-period FOR
     1854         x-XYZ-analysis-period SCROLLING.
     1855   DEFINE QUERY BROWSE-type-doc FOR
     1856         x-XYZ-analysis-doc SCROLLING.
     1857   DEFINE BROWSE BROWSE-1XYZ
     1858     QUERY BROWSE-1XYZ NO-LOCK DISPLAY
     1859         mark-string(recid( x-XYZ-analysis), p-rid-list)  COLUMN-LABEL "*" FORMAT "X(1)":U
     1860         v-def   COLUMN-LABEL "d!e!f" FORMAT "x(1)":U WIDTH 1
     1861         x-XYZ-analysis.XYZ-name                         COLUMN-LABEL "Наименование" FORMAT "X(30)":U WIDTH 20
     1862         x-criterion-analysis.cral-name                  COLUMN-LABEL "Критерий!анализа" FORMAT "X(55)":U WIDTH 20
     1863         x-XYZ-analysis.XYZ-x                            COLUMN-LABEL "   X%  " FORMAT ">9.9":U WIDTH 7
     1864         x-XYZ-analysis.XYZ-z                            COLUMN-LABEL "   Z%  " FORMAT ">9.9":U WIDTH 7
     1865         x-XYZ-analysis.XYZ-string-obj                   COLUMN-LABEL "Строка!объектов" FORMAT "X(30)":U WIDTH 10
     1866         x-XYZ-analysis.XYZ-string-period                COLUMN-LABEL "Строка!периодов" FORMAT "X(30)":U WIDTH 10
     1867         x-XYZ-analysis.XYZ-string-doc                   COLUMN-LABEL "Строка!документов" FORMAT "X(30)":U WIDTH 10
     1868         x-XYZ-analysis.XYZ-date-create                  COLUMN-LABEL "Дата!создания" FORMAT "99/99/99":U
     1869         STRING (x-XYZ-analysis.XYZ-time-create,'HH:MM') COLUMN-LABEL "Время!созд" FORMAT "x(5)":U WIDTH 5
     1870         x-XYZ-analysis.XYZ-db-num-create                COLUMN-LABEL "БД" FORMAT ">>>>9":U
     1871         x-xyz-analysis.xyz-id                           COLUMN-LABEL "Вн.!№" FORMAT ">>>>>>>>>9":U
     1872     ENABLE
     1873         x-XYZ-analysis.XYZ-name
     1874       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 11 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
     1875   DEFINE BROWSE BROWSE-obj
     1876     QUERY BROWSE-obj NO-LOCK DISPLAY
     1877         x-XYZ-analysis-obj.obj-type FORMAT "X(3)":U
     1878         x-XYZ-analysis-obj.obj-code FORMAT ">>>>>>>>9":U
     1879       WITH NO-ROW-MARKERS SEPARATORS MULTIPLE SIZE 13 BY 6.75
     1880            TITLE "Объекты" FIT-LAST-COLUMN TOOLTIP "Объекты XYZ анализа".
     1881   DEFINE BROWSE BROWSE-period
     1882     QUERY BROWSE-period NO-LOCK DISPLAY
     1883         x-XYZ-analysis-period.XYZp-start COLUMN-LABEL "Начало" FORMAT "99/99/99":U
     1884         x-XYZ-analysis-period.XYZp-end COLUMN-LABEL "Конец" FORMAT "99/99/99":U
     1885       WITH NO-ROW-MARKERS SEPARATORS SIZE 20 BY 6.75
     1886            TITLE "Интервалы анализа" FIT-LAST-COLUMN TOOLTIP "Интервалы анализа".
     1887   DEFINE BROWSE BROWSE-type-doc
     1888     QUERY BROWSE-type-doc NO-LOCK DISPLAY
     1889         f-name-doc ( buffer x-XYZ-analysis-doc) COLUMN-LABEL "Тип документа" FORMAT "x(22)":U
     1890               WIDTH 22
     1891       WITH NO-ROW-MARKERS SEPARATORS SIZE 25 BY 6.75
     1892            TITLE "Типы документов" FIT-LAST-COLUMN TOOLTIP "Типы документов анализа".
     1893   DEFINE FRAME Dialog-Frame
     1894        b-quit AT ROW 1 COL 1
     1895        B-mark AT ROW 1 COL 14
     1896        B-sel AT ROW 1 COL 17
     1897        B-add AT ROW 1 COL 27
     1898        B-lookup AT ROW 1 COL 37
     1899        B-chg AT ROW 1 COL 57.5
     1900        B-del AT ROW 1 COL 67.5
     1901        B-print AT ROW 1 COL 77.5
     1902        B-Help AT ROW 1 COL 87.5
     1903        BROWSE-1XYZ AT ROW 3 COL 1
     1904        BROWSE-obj AT ROW 16.25 COL 2
     1905        BROWSE-period AT ROW 16.25 COL 15
     1906        BROWSE-type-doc AT ROW 16.25 COL 35
     1907        ub.x-XYZ-analysis.xyz-des AT ROW 16.25 COL 60.5 NO-LABEL
     1908             VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1909             SIZE 37.88 BY 6.79 TOOLTIP "Описание анализа"
     1910        mark-num AT ROW 1 COL 9 COLON-ALIGNED NO-LABEL
     1911        x-XYZ-analysis.xyz-name AT ROW 14.25 COL 2 NO-LABEL FORMAT "X(50)"
     1912              VIEW-AS TEXT
     1913             SIZE 72 BY .67 TOOLTIP "Наименование анализа"
     1914             FGCOLOR 4
     1915        v-user-name AT ROW 14.25 COL 80.13 COLON-ALIGNED WIDGET-ID 2
     1916        x-criterion-analysis.cral-name AT ROW 15.25 COL 1.5 NO-LABEL FORMAT "X(50)"
     1917              VIEW-AS TEXT
     1918             SIZE 96.5 BY .67 TOOLTIP "Критерий анализа"
     1919             FGCOLOR 4
     1920        SPACE(0.38) SKIP(7.12)
     1921       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1922            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1923            TITLE "Список XYZ-анализов".
     1924   ASSIGN
     1925          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1926          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1927   ASSIGN
     1928          B-chg:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1929   ASSIGN
     1930          B-del:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1931   ASSIGN
     1932          x-criterion-analysis.cral-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1933   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1934   DO:
