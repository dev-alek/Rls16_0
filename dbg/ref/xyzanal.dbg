        1   DEFINE NEW SHARED BUFFER x-criterion-analysis FOR ub.criterion-analysis.
        2   DEFINE NEW SHARED BUFFER x-XYZ-analysis FOR ub.XYZ-analysis.
        3   DEFINE BUFFER x-XYZ-analysis-doc FOR ub.XYZ-analysis-doc.
        4   DEFINE BUFFER x-XYZ-analysis-obj FOR ub.XYZ-analysis-obj.
        5   DEFINE BUFFER x-XYZ-analysis-period FOR ub.XYZ-analysis-period.
        6   define input  parameter parparentproc as widget-handle no-undo.
        7   define input  parameter p-bttn        as character no-undo .
        8   define output parameter p-rid-list    as character no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Список заголовков XYZ-анализа".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   procedure proc-alt-shift-f2:
       85     if not ibs.th.gbl.gbl-var:rcode
       86   then
       87     run gbl\inidebug.p .
       88   end.
       89   procedure proc-alt-shift-f3:
       90     run gbl/prvssinf.p
       91       ( input this-procedure
       92       ) .
       93   end.
       94   define variable v-inform-launched as logical no-undo initial false .
       95   procedure proc-alt-shift-f4:
       96     define variable v-action as character no-undo .
       97     if v-inform-launched = false then do:
       98       assign
       99         v-inform-launched = true
      100       .
      101       run gbl/d-inform.w
      102         (  input self
      103         ,  input this-procedure
      104         , output v-action
      105         ) no-error .
      106       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      107       assign
      108         v-inform-launched = false
      109       .
      110     end.
      111   end.
      112   procedure proc-alt-f1:
      113     run gbl/corrhelp.p
      114       (input this-procedure
      115       ) .
      116   end .
      117   on alt-shift-f2 anywhere do:
      118     run proc-alt-shift-f2.
      119   end.
      120   on alt-shift-f3 anywhere do:
      121     run proc-alt-shift-f3 in this-procedure .
      122   end.
      123   on alt-shift-f4 anywhere do:
      124     run proc-alt-shift-f4 in this-procedure.
      125   end.
      126   on alt-f1 anywhere do:
      127     run proc-alt-f1 in this-procedure .
      128   end.
      129   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      131   define new shared variable RepPathName        as character no-undo .
      132   define new shared variable PrintRubl          as logical   no-undo .
      133   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   define variable v-waitfram-action01         as character   no-undo .
      135   define variable v-waitfram-action02         as character   no-undo .
      136   define variable v-waitfram-action03         as character   no-undo .
      137   define variable mWaitFramTextBeg            as character   no-undo.
      138   define variable mWaitFramTextEnd            as character   no-undo.
      139   define variable mWaitFramView               as logical     no-undo.
      140   define variable mWaitProcEvent              as logical     no-undo init yes.
      141   define variable mWaitFramInterval           as integer     no-undo init 1 .
      142   define variable mWaitFramStop               as logical     no-undo.
      143   define variable mWaitFramStopUser           as logical     no-undo.
      144   define variable mWaitFramStopTimeOut        as logical     no-undo.
      145   define variable mWaitFramStartProc          as datetime-tz no-undo.
      146   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      147   define button B-WaitFramStop auto-end-key
      148        label "Стоп"
      149        size 10 by 1 tooltip "Остоновить процесс".
      150   define button B-viewProcInfo
      151        label "Информация"
      152        size 15 by 1 tooltip "Информация о процесс".
      153   define frame waitfram
      154     v-waitfram-action01 format "x(72)" no-label skip
      155     v-waitfram-action02 format "x(72)" no-label skip
      156     v-waitfram-action03 format "x(72)" no-label skip
      157     B-viewProcInfo
      158     B-WaitFramStop at row 4 col 30
      159     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      160     .
      161   define new global shared variable mBatchMode as logical no-undo init ?.
      162   define variable mFramBachModHandle as handle no-undo.
      163   mFramBachModHandle = frame waitfram:handle.
      164   define variable mFameOldVis as logical no-undo.
      165   define variable mVisCUrentVin as logical no-undo.
      166   if session:batch-mode
      167   then
      168      mBatchMode = yes.
      169   if mBatchMode = ? then do:
      170     mVisCUrentVin = current-window:visible.
      171     mFameOldVis = mFramBachModHandle:visible.
      172     mFramBachModHandle:visible  = yes.
      173     mBatchMode = mFramBachModHandle:visible ne yes.
      174     mFramBachModHandle:visible = mFameOldVis.
      175     current-window:visible = mVisCUrentVin.
      176   end.
      177    if  log-manager:logfile-name ne ?
      178     then DO:
      179         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      180         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      181         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      182     end.
      183   on choose of B-WaitFramStop in frame waitfram
      184   do:
      185     mWaitFramStop = yes.
      186     mWaitFramStopUser = yes.
      187   end.
      188   function waitfram-check-timeout returns logical():
      189      define variable vtime as int64 no-undo.
      190      if mWaitFramStopTimeOut
      191      then
      192         return yes.
      193      vtime = ( now - mWaitFramStartProc ) / 1000 .
      194      if     mWaitFramTimeOut ne ?
      195         and mWaitFramTimeOut ne 0
      196         and mWaitFramTimeOut lt vtime
      197      then do:
      198         mWaitFramStopTimeOut = yes.
      199      end.
      200      return mWaitFramStopTimeOut.
      201   end.
      202   procedure waitfram-hide :
      203     if not session:batch-mode
      204     then do
      205     on error undo, return error return-value
      206     :
      207       pause 0 before-hide .
      208       if not mBatchMode then
      209         hide frame waitfram .
      210     if     not mWaitFramView
      211        and mWaitProcEvent
      212     then
      213       process events .
      214     end.
      215   end procedure.
      216   procedure waitfram-show :
      217     define input  parameter p-message as character no-undo .
      218     define variable v-left-margin as integer   no-undo .
      219     if not session:batch-mode
      220     then do
      221     on error undo, return error return-value
      222     :
      223       if length(p-message) <= 70 then do:
      224         assign
      225           v-left-margin = integer((70 - length(p-message)) / 2)
      226         .
      227         assign
      228           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      229         .
      230         assign
      231           v-waitfram-action01 = " "
      232           v-waitfram-action02 = " "
      233                                    + fill(" ", v-left-margin)
      234                                    + p-message
      235           v-waitfram-action03 = " "
      236         .
      237       end.
      238       else do:
      239         define variable vRindex1 as integer no-undo.
      240         define variable vRindex2 as integer no-undo.
      241         vRindex1 = r-index(p-message," ",70).
      242         if vRindex1 = 0
      243         then
      244            vRindex1 = 70.
      245         if length(p-message)  <= vRindex1 + 70 then do:
      246           assign
      247             v-waitfram-action01 = " "
      248             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      249             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      250           .
      251         end.
      252         else do:
      253           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      254           if vRindex2 <= vRindex1
      255           then
      256              vRindex2 = vRindex1 + 70.
      257           assign
      258             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      259             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      260             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      261           .
      262         end.
      263       end.
      264       B-viewProcInfo:visible   in frame waitfram = no.
      265       B-viewProcInfo:sensitive in frame waitfram = no.
      266       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      267       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      268       if  (   mWaitFramView
      269          or  mWaitProcEvent)
      270          and not mBatchMode
      271       then
      272          display
      273             v-waitfram-action01 skip
      274             v-waitfram-action02 skip
      275             v-waitfram-action03 skip
      276          with frame waitfram .
      277       if     mWaitFramView
      278          then do:
      279             if     mWaitFramInterval ne ?
      280                and not mBatchMode
      281             then
      282                wait-for go of frame waitfram pause mWaitFramInterval.
      283          end.
      284          else
      285             if     mWaitProcEvent
      286                and not mBatchMode
      287             then
      288                process events .
      289     end.
      290   end procedure.
      291      procedure waitfram-show-this:
      292         define input  parameter iInterval as int64 no-undo.
      293         define variable vtime as int64 no-undo.
      294         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      295         mWaitFramInterval = iInterval.
      296         run waitfram-show (substitute("&1&2 &3&4" ,
      297                                       mWaitFramTextBeg ,
      298                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      299                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      300                                       mWaitFramTextEnd
      301                                      )
      302                           ).
      303      end.
      304      procedure WaitFramRunPause:
      305         define input  parameter iInterval as dec no-undo.
      306         define variable vStart  as datetime-tz no-undo.
      307         define variable vend    as datetime-tz no-undo.
      308         define variable vint as int64 no-undo.
      309         define variable vOk as logical no-undo.
      310         vStart = now.
      311         vend   = vStart.
      312         publish "WaitFramPause" (iInterval,output vOk).
      313         vend   =  now.
      314         vint = vend - vStart.
      315         vint = iInterval - vint / 1000.
      316         if     not mWaitFramStop
      317            and (   vint > 0
      318                 or (    not vOk
      319                     and iInterval eq ?
      320                     )
      321                 )
      322         then
      323            run waitfram-show-this (iInterval).
      324         vend   =  now.
      325         vint = vend - vStart.
      326         vint = iInterval - vint / 1000.
      327         if     not mWaitFramStop
      328            and vint > 0
      329         then do:
      330            run gbl/pause.p (vint * 1000).
      331         end.
      332         if iInterval ne ?
      333         then
      334            publish "WaitFramStop".
      335         waitfram-check-timeout().
      336      end.
      337      procedure WaitFramWaitFor:
      338         define input  parameter iInterval as dec no-undo.
      339         assign
      340            mWaitFramStartProc   = now
      341            mWaitFramStopUser    = no
      342            mWaitFramStopTimeOut = no
      343         .
      344         block-wait:
      345         do while not mWaitFramStop:
      346            run WaitFramRunPause (iInterval).
      347            if  waitfram-check-timeout()
      348            then do:
      349               leave block-wait.
      350            end.
      351         end.
      352         run waitfram-hide.
      353      end.
      354   procedure waitfram-join :
      355     define input  parameter p-line-1  as character no-undo .
      356     define input  parameter p-line-2  as character no-undo .
      357     define input  parameter p-line-3  as character no-undo .
      358     define output parameter p-message as character no-undo .
      359     do
      360     on error undo, return error return-value
      361     :
      362       assign
      363         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      364                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      365                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      366       .
      367     end.
      368   end procedure.
      369   function waitfram-join-function returns character
      370     (input p-line-1 as character
      371     ,input p-line-2 as character
      372     ,input p-line-3 as character
      373     ).
      374     define variable v-message as character no-undo .
      375     run waitfram-join in this-procedure
      376       (input  p-line-1
      377       ,input  p-line-2
      378       ,input  p-line-3
      379       ,output v-message
      380       ) .
      381     return v-message .
      382   end function .
      383   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      384   define  stream PrnLibStream.
      385   procedure prn-lib-prn-file :
      386     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      387     define input parameter p-DIsabledoptions as integer no-undo .
      388     define variable v-report-name as character no-undo .
      389     define variable v-user-action as character no-undo .
      390     define variable v-printed     as logical   no-undo .
      391     define variable v-exist       as logical   no-undo .
      392     do
      393       on error undo, return error
      394       :
      395       run prn-lib-get-report-name  in this-procedure (
      396         input parParentProc
      397         ,output v-report-name
      398         ).
      399   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      400   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      401     (input  v-report-name
      402     ,input  2
      403     ,output v-exist
      404     )  .
      405       if NOT v-exist then
      406       DO:
      407         Message
      408           "Нет заданий на печать ! "
      409           view-as alert-box .
      410         Return  .
      411       End.
      412       run gbl/prnfilen.w
      413         (input  ""
      414         ,input  p-DisabledOptions
      415         ,input  string(v-report-name )
      416         ,input  7
      417         ,output v-user-action
      418         ,output v-printed
      419         ) .
      420       if v-printed then
      421       do:
      422         return "YES" .
      423       end.
      424       else
      425       do:
      426         return "NO" .
      427       end.
      428     end.
      429   end procedure.
      430   procedure prn-lib-open-stream :
      431     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      432     define input parameter p-page-size    as integer no-undo .
      433     define input parameter p-is-stream    as logical no-undo .
      434     define input parameter p-append       as logical no-undo .
      435     define variable v-report-name as character no-undo .
      436     do
      437       on error undo, return error
      438       :
      439       run prn-lib-get-report-name  in this-procedure (
      440         input parParentProc
      441         ,output v-report-name
      442         ).
      443       if p-is-stream then
      444       do:
      445         if p-append then
      446         do:
      447           output stream PrnLibStream to value( v-report-name )
      448             page-size value(p-page-size) append .
      449         end.
      450         if not p-append then
      451         do:
      452           output stream PrnLibStream to value( v-report-name )
      453             page-size value(p-page-size) .
      454         end.
      455       end.
      456       if not p-is-stream then
      457       do:
      458         if p-append then
      459         do:
      460           output to value( v-report-name )
      461             page-size value(p-page-size) append .
      462         end.
      463         if not p-append then
      464         do:
      465           output to value( v-report-name )
      466             page-size value(p-page-size) .
      467         end.
      468       end.
      469     end.
      470   end procedure.
      471   procedure prn-lib-open-exp :
      472     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      473     define input parameter p-is-stream    as logical no-undo .
      474     define input parameter p-is-append    as logical no-undo .
      475     define output parameter p-ReportFileName as char init "report" no-undo.
      476     define output parameter p-process as logical no-undo .
      477     define variable glog as logical no-undo .
      478     do
      479       on error undo, return error
      480       :
      481       SYSTEM-DIALOG GET-FILE p-ReportFileName
      482         TITLE      "Укажите путь"
      483         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      484         ASK-OVERWRITE
      485         CREATE-TEST-FILE
      486         SAVE-AS
      487         USE-FILENAME
      488         DEFAULT-EXTENSION "txt"
      489         UPDATE glog
      490         .
      491       if not glog then  return.
      492       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      493       if p-is-stream then
      494       do:
      495         if p-is-append then
      496         do:
      497           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      498         end.
      499         else
      500         do:
      501           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      502         end.
      503       end.
      504       else
      505       do:
      506         if p-is-append then
      507         do:
      508           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      509         end.
      510         else
      511         do:
      512           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      513         end.
      514       end.
      515       p-process = yes.
      516     end.
      517   end procedure.
      518   procedure prn-lib-get-report-name :
      519     define input parameter parParentProc  as widget-handle no-undo.
      520     define output parameter p-report-name as character no-undo .
      521     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      522   end procedure.
      523   procedure prn-lib-reportviewer-report-name :
      524     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      525     define input parameter p-report-name-html as character no-undo .
      526     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      527   end procedure.
      528   procedure prn-lib-reportviewer :
      529     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      530     define input parameter p-report-name-html as character no-undo .
      531     define input parameter p-param        as character no-undo .
      532     define variable v-excel           as character no-undo init 'TRUE' .
      533     define variable v-value-character as character no-undo .
      534     define variable v-value-integer   as character no-undo .
      535     define variable v-value-date      as date      no-undo .
      536     define variable v-value-decimal   as decimal   no-undo .
      537     define variable rep-excel         as logical   no-undo .
      538     define variable excel-string      as character no-undo .
      539     define variable v-param-type      as character no-undo .
      540     define variable v-tth             as handle    no-undo .
      541     run adm/shattri.p (
      542       input "get":U
      543       ,input  ""
      544       ,input  0
      545       ,input  'report-glob':U
      546       ,input  'rep-excel':U
      547       ,output v-value-character
      548       ,output v-value-date
      549       ,output v-value-decimal
      550       ,output v-value-integer
      551       ,output rep-excel
      552       ,output v-param-type
      553       ,INPUT-OUTPUT table-handle v-tth
      554       )  .
      555     if rep-excel then v-excel = "TRUE" .
      556     else v-excel = "FALSE" .
      557     if p-param eq ""
      558     then
      559        p-param = "EXCEL:" + v-excel.
      560     else
      561        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      562     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      563   end procedure.
      564   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      565   procedure cur-time :
      566      define output parameter p-today as date      no-undo .
      567      define output parameter p-time  as integer   no-undo .
      568     do
      569     on error undo, return error
      570     :
      571       define variable v-date1 as date      no-undo .
      572       define variable v-date2 as date      no-undo .
      573       define variable v-time  as integer   no-undo .
      574       assign
      575         v-date1 = today
      576         v-time  = time
      577         v-date2 = today
      578       .
      579       if v-date1 <> v-date2
      580       then do:
      581         assign
      582           v-date1 = today
      583           v-time  = v-time
      584         .
      585       end.
      586       assign
      587         p-today = v-date1
      588         p-time  = v-time
      589       .
      590     end.
      591   end.
      592   function cur-time-date returns character
      593   :
      594     return string(today, '99/99/9999':U) .
      595   end.
      596   function cur-time-mjd returns decimal
      597   :
      598     define variable v-date as date      no-undo .
      599     define variable v-time as integer   no-undo .
      600     run cur-time in this-procedure
      601       (output v-date
      602       ,output v-time
      603       ) .
      604     return integer(v-date) - 2400002 + (v-time / 86400) .
      605   end.
      606   function cur-time-get-ending-index returns integer
      607   (input p-number as integer
      608   )
      609   :
      610     if p-number < 0
      611     or p-number = ?
      612     then do:
      613       return 1 .
      614     end.
      615     define variable v-rest as integer   no-undo .
      616     assign
      617       p-number = p-number modulo 100
      618     .
      619     if p-number < 20
      620     then do:
      621       assign
      622         v-rest = p-number
      623       .
      624     end.
      625     else do:
      626       assign
      627         v-rest = p-number modulo 10
      628       .
      629     end.
      630     case v-rest :
      631       when 1
      632       then do:
      633         return 2 .
      634       end.
      635       when 2 or
      636       when 3 or
      637       when 4
      638       then do:
      639         return 3 .
      640       end.
      641       otherwise do:
      642         return 1 .
      643       end.
      644     end case .
      645   end.
      646   procedure cur-time-mjd-to-date :
      647      define input  parameter i-mjd-diff as decimal no-undo.
      648      define output parameter o-Date     as date    no-undo.
      649      define output parameter o-Time     as integer no-undo.
      650      define variable v-day-number as integer   no-undo .
      651      if    i-mjd-diff < 0
      652         or i-mjd-diff = ?
      653      then do:
      654         return "?" .
      655      end.
      656      assign
      657         v-day-number = truncate(i-mjd-diff,0).
      658         o-Date = date(v-day-number + 2400002).
      659         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      660     .
      661   end.
      662   function cur-time-mjd-to-string returns character
      663   (input p-mjd-diff as decimal
      664   )
      665   :
      666     define variable v-day-number as integer   no-undo .
      667     define variable v-seconds    as integer   no-undo .
      668     define variable v-hour       as integer   no-undo .
      669     define variable v-min        as integer   no-undo .
      670     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      671     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      672     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      673     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      674     if p-mjd-diff < 0
      675     or p-mjd-diff = ?
      676     then do:
      677       return "?" .
      678     end.
      679     assign
      680       v-day-number = integer(truncate(p-mjd-diff,0))
      681       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      682     .
      683     if v-seconds > 86400
      684     then do:
      685       assign
      686         v-seconds = 86400 - 1
      687       .
      688     end.
      689     if v-seconds < 0
      690     then do:
      691       assign
      692         v-seconds = 0
      693       .
      694     end.
      695     assign
      696       v-hour = truncate(v-seconds / 3600, 0)
      697     .
      698     assign
      699       v-seconds = v-seconds modulo 3600
      700     .
      701     assign
      702       v-min = truncate(v-seconds / 60, 0)
      703     .
      704     assign
      705       v-seconds = v-seconds modulo 60
      706     .
      707     return
      708         (if v-day-number <> 0
      709           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      710           else ""
      711         )
      712       + (if v-day-number <> 0 or v-hour <> 0
      713           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      714           else ""
      715         )
      716       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      717           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      718           else ""
      719         )
      720       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      721       .
      722   end.
      723   function cur-time-string returns character
      724   :
      725     define variable v-date as date      no-undo .
      726     define variable v-time as integer   no-undo .
      727     run cur-time in this-procedure
      728       (output v-date
      729       ,output v-time
      730       ) .
      731     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      732   end.
      733   function cur-time-string-sec returns character
      734   :
      735     define variable v-date as date      no-undo .
      736     define variable v-time as integer   no-undo .
      737     run cur-time in this-procedure
      738       (output v-date
      739       ,output v-time
      740       ) .
      741     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      742   end.
      743   function cur-time-custom  returns character
      744   (input p-prefix as character
      745   ,input p-date-format as character
      746   ,input p-delimiter as character
      747   ,input p-time-format as character
      748   ,input p-suffix as character
      749   )
      750   :
      751     define variable v-date as date      no-undo .
      752     define variable v-time as integer   no-undo .
      753     run cur-time in this-procedure
      754       (output v-date
      755       ,output v-time
      756       ) .
      757     return
      758       p-prefix
      759       + string(v-date, p-date-format)
      760       + p-delimiter
      761       + string(v-time, p-time-format)
      762       + p-suffix
      763       .
      764   end.
      765   function cur-time-print  returns character
      766   :
      767     define variable v-date as date      no-undo .
      768     define variable v-time as integer   no-undo .
      769     run cur-time in this-procedure
      770       (output v-date
      771       ,output v-time
      772       ) .
      773     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      774   end.
      775   function cur-time-datetime returns datetime
      776   :
      777     define variable v-char as character no-undo .
      778     define variable v-datetime as datetime no-undo .
      779     v-char = cur-time-string().
      780     v-datetime = datetime(v-char).
      781     return  v-datetime.
      782   end.
      783   function cur-time-string-msec returns character
      784   :
      785     define variable v-date as datetime  no-undo .
      786     v-date = now.
      787     return string(v-date) .
      788   end.
      789   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
