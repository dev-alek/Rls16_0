     2065     v-str-recid17 = trim( string( recid( x-XYZ-analysis ) , "->>>>>>>>>>>9":U ) )
     2066     v-num-entry17 = lookup( v-str-recid17 , p-rid-list )
     2067   .
     2068   if v-num-entry17 > 0 then do:
     2069     assign
     2070       entry( v-num-entry17, p-rid-list ) = "":U
     2071       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2072     .
     2073   end.
     2074   else do:
     2075     assign
     2076       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid17
     2077     .
     2078   end.
     2079       loc#log = BROWSE-1XYZ:refresh() .
     2080       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     2081           loc#log = BROWSE-1XYZ:select-next-row ().
     2082           apply "VALUE-CHANGED" to BROWSE-1XYZ in frame Dialog-Frame.
     2083       end.
     2084       if num-entries( p-rid-list ) = 0
     2085       then
     2086           hide mark-num in frame Dialog-Frame.
     2087       else
     2088           disp num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
     2089     end.
     2090     apply "entry" to BROWSE-1XYZ in frame Dialog-Frame.
     2091   END.
