     2057   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     2058   DO:
     2059     define variable loc#log as logical no-undo .
     2060     if AVAILABLE x-XYZ-analysis  then do:
     2061   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2062   define variable v-str-recid17 as character no-undo .
