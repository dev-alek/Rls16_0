     2136   ON VALUE-CHANGED OF BROWSE-1XYZ IN FRAME Dialog-Frame
     2137   DO:
     2138       IF AVAILABLE x-XYZ-analysis THEN DO :
     2139   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2140   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     2141     (input  x-XYZ-analysis.XYZ-who-create
     2142     ,output v-user-name
     2143     )  .
     2144           DISPLAY x-XYZ-analysis.XYZ-des
     2145                   x-XYZ-analysis.XYZ-name
     2146                   x-criterion-analysis.cral-name
