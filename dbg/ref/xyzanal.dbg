     2150         OPEN QUERY BROWSE-obj FOR EACH x-XYZ-analysis-obj       WHERE x-XYZ-analysis-obj.XYZ-id = x-XYZ-analysis.XYZ-id and x-XYZ-analysis-obj.db-num = x-XYZ-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     2151         OPEN QUERY BROWSE-period FOR EACH x-XYZ-analysis-period       WHERE x-XYZ-analysis-period.XYZ-id = x-XYZ-analysis.XYZ-id and x-XYZ-analysis-period.db-num = x-XYZ-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     2152       END.
