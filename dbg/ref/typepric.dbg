     2885           then do:
     2886             assign
     2887               v-object-handle :col = v-object-handle :col + p-change-value
     2888               no-error .
     2889             if error-status :error
     2890             or error-status :get-message(1) <> ""
     2891             then do:
     2892               undo move_block, retry move_block .
     2893             end.
     2894           end.
     2895         end.
     2896         for each buf_temp-browse-handle
     2897           where buf_temp-browse-handle.browse-type = 'width':u
     2898         on error undo move_block, retry move_block
     2899         :
     2900           assign
     2901             buf_temp-browse-handle.browse-handle :width
     2902               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2903             no-error .
     2904           if error-status :error
     2905           or error-status :get-message(1) <> ""
     2906           then do:
     2907             undo move_block, retry move_block .
     2908           end.
     2909         end.
     2910         assign
     2911           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2912           no-error .
     2913         if error-status :error
     2914         or error-status :get-message(1) <> ""
     2915         then do:
     2916           undo move_block, retry move_block.
     2917         end.
     2918         assign
     2919           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2920         no-error .
     2921         if error-status :error
     2922         or error-status :get-message(1) <> ""
     2923         then do:
     2924           undo move_block, retry move_block.
     2925         end.
     2926         if frame Dialog-Frame :scrollable = true
     2927         then do:
     2928           assign
     2929             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2930           no-error .
     2931           if error-status :error
     2932           or error-status :get-message(1) <> ""
     2933           then do:
     2934             undo move_block, retry move_block.
     2935           end.
     2936         end.
     2937       end.
     2938       if p-move-resize
     2939       then do:
     2940         run diasize_position-resize-button in this-procedure .
     2941       end.
     2942       if v-diasize-wndstore = true
     2943       then do:
     2944         if connected("ub") = true
     2945         then do:
     2946           define variable v-cntxt-db-num        as integer   no-undo .
     2947           define variable v-cntxt-userid        as character no-undo .
     2948           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2949                                             , OUTPUT v-cntxt-userid
     2950                                             ) .
     2951           run gbl/wndsizew.p
     2952             (input  v-cntxt-db-num
     2953             ,input  v-cntxt-userid
     2954             ,input  v-diasize-proc-name
     2955             ,input  'width':u
     2956             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2957             ) .
     2958         end.
     2959       end.
     2960     end.
     2961     assign
     2962       v-diasize-change-size = false
     2963     .
     2964   end procedure.
     2965   procedure diasize_set-width :
     2966     define input  parameter p-new-width  as decimal   no-undo .
     2967     define input  parameter p-move-resize as logical   no-undo .
     2968     do
     2969     on error undo, return error return-value
     2970     :
     2971       run diasize_change-width in this-procedure
     2972         (input  (p-new-width - frame Dialog-Frame :width)
     2973         ,input  p-move-resize
     2974         ) .
     2975     end.
     2976   end procedure.
     2977   procedure diasize_position-resize-button :
     2978     do with frame Dialog-Frame
     2979     :
     2980       hide v-diasize-resize-button .
     2981       assign
     2982         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2983                     - 1
     2984                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2985         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2986                     - 1
     2987                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2988       .
     2989       view v-diasize-resize-button .
     2990     end.
     2991   end procedure.
     2992   on alt-right anywhere
     2993   do:
     2994     run diasize_change-width in this-procedure
     2995       (input 1
     2996       ,input true
     2997       ) .
     2998     return no-apply .
     2999   end.
     3000   on alt-left anywhere
     3001   do:
     3002     run diasize_change-width in this-procedure
     3003       (input -1
     3004       ,input true
     3005       ) .
     3006     return no-apply .
     3007   end.
     3008   on alt-down anywhere
     3009   do:
     3010     run diasize_change-height in this-procedure
     3011       (input 1
     3012       ,input true
     3013       ) .
     3014     return no-apply .
     3015   end.
     3016   on alt-up anywhere
     3017   do:
     3018     run diasize_change-height in this-procedure
     3019       (input -1
     3020       ,input true
     3021       ) .
     3022     return no-apply .
     3023   end.
     3024   on alt-enter of frame Dialog-Frame
     3025   do:
     3026     run diasize_maximize in this-procedure
     3027       (input  ?
     3028       ).
     3029     return no-apply .
     3030   end.
     3031   procedure diasize_end-move :
     3032     do
     3033     on error undo, return error return-value
     3034     :
     3035       define variable v-row-delta as decimal   no-undo .
     3036       define variable v-col-delta as decimal   no-undo .
     3037       define variable v-new-row as decimal   no-undo .
     3038       define variable v-new-col as decimal   no-undo .
     3039       assign
     3040         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3041         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3042       .
     3043       assign
     3044         v-row-delta = v-new-row - frame Dialog-Frame :height
     3045         v-col-delta = v-new-col - frame Dialog-Frame :width
     3046       .
     3047       run diasize_change-height in this-procedure
     3048         (input v-row-delta
     3049         ,input true
     3050         ) .
     3051       run diasize_change-width in this-procedure
     3052         (input v-col-delta
     3053         ,input true
     3054         ) .
     3055     end.
     3056   end procedure.
     3057   procedure diasize_maximize :
     3058     define input  parameter p-action as logical   no-undo .
     3059     do
     3060     on error undo, return error return-value
     3061     :
     3062       if p-action = ?
     3063       then do:
     3064         if v-diasize-need-maximize = true
     3065         then do:
     3066           assign
     3067             p-action = true
     3068           .
     3069         end.
     3070         else do:
     3071           assign
     3072             p-action = false
     3073           .
     3074         end.
     3075       end.
     3076       if p-action = true
     3077       then do:
     3078         run diasize_change-height in this-procedure
     3079           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3080               - frame Dialog-Frame :height-chars
     3081           ,input true
     3082           ) .
     3083         run diasize_change-width in this-procedure
     3084           (input session :width-chars
     3085               - frame Dialog-Frame :width-chars
     3086           ,input true
     3087           ) .
     3088         assign
     3089           v-diasize-need-maximize = false
     3090         .
     3091       end.
     3092       else do:
     3093         run diasize_change-width in this-procedure
     3094           (input v-diasize-orig-frame-width
     3095               - frame Dialog-Frame :width-chars
     3096           ,input true
     3097           ) .
     3098         run diasize_change-height in this-procedure
     3099           (input v-diasize-orig-frame-height
     3100               - frame Dialog-Frame :height-chars
     3101           ,input true
     3102           ) .
     3103         assign
     3104           v-diasize-need-maximize = true
     3105         .
     3106       end.
     3107     end.
     3108   end procedure.
     3109   procedure diasize_restore-orig-size :
     3110     do
     3111     on error undo, return error return-value
     3112     :
     3113       assign
     3114         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3115         v-diasize-current-frame-height = frame Dialog-Frame :height
     3116       .
     3117       run diasize_set-height in this-procedure
     3118         (input  v-diasize-orig-frame-height
     3119         ,input  true
     3120         ) .
     3121       run diasize_set-width in this-procedure
     3122         (input  v-diasize-orig-frame-width
     3123         ,input  true
     3124         ) .
     3125     end.
     3126   end procedure.
     3127   procedure diasize_restore-current-size :
     3128     do
     3129     on error undo, return error return-value
     3130     :
     3131       run diasize_set-height in this-procedure
     3132         (input  v-diasize-current-frame-height
     3133         ,input  true
     3134         ) .
     3135       run diasize_set-width in this-procedure
     3136         (input  v-diasize-current-frame-width
     3137         ,input  true
     3138         ) .
     3139     end.
     3140   end procedure.
     3141   procedure diasize_set-browse-handle :
     3142     define input  parameter p-browse-handle as handle   no-undo .
     3143     define buffer buf_temp-browse-handle for temp-browse-handle .
     3144     do
     3145     on error undo, return error return-value
     3146     :
     3147       assign
     3148         v-diasize-browse-handle = p-browse-handle
     3149       .
     3150       for each buf_temp-browse-handle
     3151       on error undo, return error return-value
     3152       :
     3153         delete buf_temp-browse-handle .
     3154       end.
     3155     end.
     3156   end procedure.
     3157   procedure diasize_add_browse :
     3158     define input  parameter p-browse-type   as character no-undo .
     3159     define input  parameter p-browse-handle as handle    no-undo .
     3160     define buffer buf_temp-browse-handle for temp-browse-handle .
     3161     do
     3162     on error undo, return error return-value
     3163     :
     3164       assign
     3165         v-diasize-browse-number = v-diasize-browse-number + 1
     3166       .
     3167       create buf_temp-browse-handle .
     3168       assign
     3169         buf_temp-browse-handle.browse-type   = p-browse-type
     3170         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3171         buf_temp-browse-handle.browse-handle = p-browse-handle
     3172       .
     3173     end.
     3174   end procedure.
     3175   procedure diasize_init :
     3176     define variable v-default-value    as logical   no-undo .
     3177     define variable v-restore-saved    as logical   no-undo .
     3178     define variable v-resize-value-str as character no-undo .
     3179     do
     3180     on error undo, return error return-value
     3181     :
     3182       do with frame Dialog-Frame
     3183       :
     3184         assign
     3185           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3186           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3187           v-diasize-browse-handle     = browse BROWSE-1grp :handle
     3188         .
     3189         create button v-diasize-resize-button
     3190         assign
     3191           parent        = frame Dialog-Frame :first-child
     3192           label         = "s"
     3193           height-pixels = 16
     3194           width-pixels  = 16
     3195           visible       = true
     3196           sensitive     = true
     3197           movable       = true
     3198           triggers:
     3199             on end-move persistent run diasize_end-move in this-procedure .
     3200           end triggers.
     3201         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3202         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3203         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3204         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3205         assign
     3206           v-diasize-wndmax = false
     3207         .
     3208         if connected("ub") = true
     3209         then do:
     3210           define variable v-cntxt-db-num        as integer   no-undo .
     3211           define variable v-cntxt-userid        as character no-undo .
     3212           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3213                                             , OUTPUT v-cntxt-userid
     3214                                             ) .
     3215           run gbl/wndpar_r.p
     3216             (input  v-cntxt-db-num
     3217             ,input  v-cntxt-userid
     3218             ,input  'wndmax':U
     3219             ,output v-diasize-wndmax
     3220             ,output v-default-value
     3221             ) .
     3222         end.
     3223         assign
     3224           v-diasize-wndstore = false
     3225         .
     3226         if connected("ub") = true
     3227         then do:
     3228           run gbl/wndpar_r.p
     3229             (input  v-cntxt-db-num
     3230             ,input  v-cntxt-userid
     3231             ,input  'wndstore':U
     3232             ,output v-diasize-wndstore
     3233             ,output v-default-value
     3234             ) .
     3235         end.
     3236         assign
     3237           v-diasize-proc-name = entry(1, program-name(2), '.')
     3238         .
     3239         if v-diasize-wndstore = true
     3240         then do:
     3241           assign
     3242             v-restore-saved = false
     3243           .
     3244           if connected("ub") = true
     3245           then do:
     3246             run gbl/wndsizer.p
     3247               (input  v-cntxt-db-num
     3248               ,input  v-cntxt-userid
     3249               ,input  v-diasize-proc-name
     3250               ,input  'height':u
     3251               ,output v-resize-value-str
     3252               ) .
     3253             if v-resize-value-str <> '':U
     3254             then do:
     3255               run diasize_change-height in this-procedure
     3256                 (input  integer(v-resize-value-str)
     3257                 ,input  true
     3258                 ) .
     3259               assign
     3260                 v-restore-saved = true
     3261               .
     3262             end.
     3263           end.
     3264           if connected("ub") = true
     3265           then do:
     3266             run gbl/wndsizer.p
     3267               (input  v-cntxt-db-num
     3268               ,input  v-cntxt-userid
     3269               ,input  v-diasize-proc-name
     3270               ,input  'width':u
     3271               ,output v-resize-value-str
     3272               ) .
     3273             if v-resize-value-str <> '':U
     3274             then do:
     3275               run diasize_change-width in this-procedure
     3276                 (input  integer(v-resize-value-str)
     3277                 ,input  true
     3278                 ) .
     3279               assign
     3280                 v-restore-saved = true
     3281               .
     3282             end.
     3283           end.
     3284           if v-restore-saved <> true
     3285           then do:
     3286             if v-diasize-wndmax = true
     3287             then do:
     3288               run diasize_maximize in this-procedure
     3289                 (input  true
     3290                 ) .
     3291             end.
     3292           end.
     3293         end.
     3294         else do:
     3295           if v-diasize-wndmax = true
     3296           then do:
     3297             run diasize_maximize in this-procedure
     3298               (input  true
     3299               ) .
     3300           end.
     3301         end.
     3302       end.
     3303     end.
     3304   end procedure.
     3305   procedure diasize_need-full-display :
     3306     define output parameter p-need-full-display as logical   no-undo .
     3307     do
     3308     on error undo, return error return-value
     3309     :
     3310       assign
     3311         p-need-full-display = v-diasize-need-full-display
     3312       .
     3313       assign
     3314         v-diasize-need-full-display = false
     3315       .
     3316     end.
     3317   end procedure.
     3318   procedure get-context :
     3319      define output parameter p-db-num as integer          no-undo.
     3320      define output parameter p-user-id as character        no-undo.
     3321      define variable v-login               as character    no-undo.
     3322      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3323      define buffer buf_user-login  for ub.user-login .
     3324      do
     3325      on error undo, return error
     3326      :
     3327            FIND FIRST buf_sys-ctrl no-lock.
     3328            ASSIGN
     3329               v-login = USERID("ub")
     3330               p-db-num = buf_sys-ctrl.db-num
     3331            .
     3332            FIND FIRST buf_user-login
     3333                 WHERE buf_user-login.db-num = p-db-num
     3334                   AND buf_user-login.user-login = v-login
     3335                 no-lock
     3336                 no-error
     3337                 .
     3338            IF AVAILABLE buf_user-login
     3339            THEN DO:
     3340               assign
     3341                  p-user-id = buf_user-login.user-id
     3342               .
     3343            END.
     3344      end.
     3345   end procedure.
     3346       run diasize_init in this-procedure .
     3347   MAIN-BLOCK:
     3348   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3349      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3350     v-name:resizable in browse BROWSE-1grp   = true .
     3351     buf_price-list-type.plt-id:read-only in browse BROWSE-1grp   = true .
     3352     run init-proc in this-procedure .
     3353     r-ban-discnt = 0 .
     3354     if LOOKUP ("mode=ban-discnt":U,    p-bttns) > 0 then do:
     3355        r-ban-discnt = integer(p-rec-list) no-error .
     3356        p-rec-list = "".
     3357     end.
     3358     if LOOKUP ("mode=gop-id":U,    p-bttns) > 0 then do:
     3359       find buf_grp-obj-price no-lock where recid (buf_grp-obj-price) = integer (p-rec-list) no-error .
     3360       if available buf_grp-obj-price then do:
     3361         assign
     3362           p-rec-list     = ""
     3363           r-obj          = 1
     3364           loc_gop_name   = buf_grp-obj-price.name
     3365           loc_gop-db-num = buf_grp-obj-price.gop-db-num
     3366           loc_gop-id     = buf_grp-obj-price.gop-id
     3367         .
     3368       end.
     3369       else return error "Ошибка поиска по группе объектов" .
     3370     end.
     3371     if LOOKUP ("mode=bgr-id":U,    p-bttns) > 0 then do:
     3372       find buf_buyer-group no-lock where recid (buf_buyer-group) = integer (p-rec-list) no-error .
     3373       if available buf_buyer-group then do:
     3374         assign
     3375           p-rec-list     = ""
     3376           r-buyer        = 1
     3377           loc_bgr_name   = buf_buyer-group.name
     3378           loc_bgr-db-num = buf_buyer-group.bgr-db-num
     3379           loc_bgr-id     = buf_buyer-group.bgr-id
     3380         .
     3381       end.
     3382       else return error "Ошибка поиска по группе покупателей" .
     3383     end.
     3384     if LOOKUP ("mode=tog-id":U,    p-bttns) > 0 then do:
     3385       find buf_turnover-group no-lock where recid (buf_turnover-group) = integer (p-rec-list) no-error .
     3386       if available buf_turnover-group then do:
     3387         assign
     3388           p-rec-list     = ""
     3389           r-tog          = 1
     3390           loc_tog_name   = buf_turnover-group.name
     3391           loc_tog-db-num = buf_turnover-group.tog-db-num
     3392           loc_tog-id     = buf_turnover-group.tog-id
     3393         .
     3394       end.
     3395       else return error "Ошибка поиска по группе оборотов покупателей" .
     3396     end.
     3397     if LOOKUP ("mode=plt-id":U,    p-bttns) > 0 then do:
     3398       r-plt = 1 .
     3399       loc_plt-recid      = p-rec-list  .
     3400       p-rec-list = ""  .
     3401     end.
     3402     if index (p-bttns , "title=":U ) > 0 then do:
     3403       define variable v-end-pos as integer   no-undo .
     3404       define variable v-start-pos as integer   no-undo .
     3405       define variable v-str-1 as character no-undo .
     3406       v-start-pos = index ( p-bttns ,"title=":U) + 6 .
     3407       v-end-pos = index ( p-bttns,"endtitle":U).
     3408       v-str-1 = SUBSTRING ( p-bttns, v-start-pos , v-end-pos -  v-start-pos) .
     3409       frame Dialog-Frame:TITLE = v-str-1 .
     3410     end.
     3411     if LOOKUP ("mode=twotpl":U,    p-bttns) > 0 then do:
     3412       r-plt = 1 .
     3413       loc_plt-recid      = p-rec-list  .
     3414     end.
     3415     if LOOKUP ("mode=all":U,    p-bttns) > 0 then do:
     3416       assign
     3417         r-status   = 0
     3418         r-main     = 2
     3419         r-avtop    = 2
     3420         r-obj      = 2
     3421         p-rec-list = ""
     3422       .
     3423     end.
     3424     RUN enable_UI.
     3425     disable
     3426     B-price-doc   when LOOKUP ("b-sel":U,    p-bttns) > 0
     3427     B-price-lists when LOOKUP ("b-sel":U,    p-bttns) > 0
     3428     B-sel         when LOOKUP ("b-sel":U,    p-bttns) = 0
     3429     B-add         when LOOKUP ("b-add":U,    p-bttns) = 0
     3430     B-add-m       when LOOKUP ("b-add":U,    p-bttns) = 0
     3431     B-chg         when LOOKUP ("b-chg":U,    p-bttns) = 0
     3432     B-del         when LOOKUP ("b-del":U,    p-bttns) = 0
     3433     B-del-pr      when LOOKUP ("b-del":U,    p-bttns) = 0
     3434     B-mark        when LOOKUP ("b-mark":U,   p-bttns) = 0
     3435     with frame Dialog-Frame .
     3436     define variable v-main-tpl              as logical   no-undo .
     3437     define variable v-use-grp-buy           as logical   no-undo .
     3438     define variable v-use-oborot-buy        as logical   no-undo .
     3439     define variable v-use-qnty-group        as logical   no-undo .
     3440     define variable v-use-sum-group         as logical   no-undo .
     3441     define variable v-use-add-code          as logical   no-undo .
     3442     define variable v-use-sys-date-time     as logical   no-undo .
     3443     define variable v-use-shift-date-num    as logical   no-undo .
     3444     define variable v-use-cassa             as logical   no-undo .
     3445     define variable v-use-val               as logical   no-undo .
     3446     define variable v-use-pay-type          as logical   no-undo .
     3447     define variable v-use-cash-pay          as logical   no-undo .
     3448     define variable v-use-child             as logical   no-undo .
     3449   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3450   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run glstmain in g#library
     3451     (output v-main-tpl
     3452     )  .
     3453   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3454   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run glstall in g#library
     3455   (  output v-use-grp-buy
     3456    , output v-use-oborot-buy
     3457    , output v-use-qnty-group
     3458    , output v-use-sum-group
     3459    , output v-use-add-code
     3460    , output v-use-sys-date-time
     3461    , output v-use-shift-date-num
     3462    , output v-use-cassa
     3463    , output v-use-val
     3464    , output v-use-pay-type
     3465    , output v-use-cash-pay
     3466    , output v-use-child
     3467           )  .
     3468     if v-use-child = false then do:
     3469       assign
     3470         buf_price-list-type.plt-main-id:visible in browse BROWSE-1grp = false .
     3471         buf_price-list-type.plt-main-db-num:visible in browse BROWSE-1grp = false .
     3472       .
     3473     end.
     3474     if v-main-tpl then hide  FILL-IN-buy FILL-IN-tog  B-add R-buyer R-tog B-del-pr in frame Dialog-Frame .
     3475     if v-use-grp-buy     = false then hide FILL-IN-buy R-buyer in frame Dialog-Frame .
     3476     if v-use-oborot-buy  = false then hide FILL-IN-tog R-tog   in frame Dialog-Frame .
     3477     run openbr in this-procedure .
     3478     WAIT-FOR GO OF FRAME Dialog-Frame FOCUS BROWSE-1grp.
     3479   END.
     3480   RUN disable_UI.
     3481   PROCEDURE disable_UI :
     3482     HIDE FRAME Dialog-Frame.
     3483   END PROCEDURE.
     3484   PROCEDURE enable_UI :
     3485     DISPLAY R-status R-obj R-buyer R-main R-avtop R-tog v-id FILL-IN-8 FILL-IN-2
     3486             FILL-IN-1 loc_gop_name FILL-IN-buy FILL-IN-7 loc_bgr_name FILL-IN-tog
     3487             loc_tog_name FILL-IN-6 v-user-name
     3488         WITH FRAME Dialog-Frame.
     3489     ENABLE B-Cancel B-mark B-sel B-add-M B-add B-lkp B-chg B-del B-print
     3490            B-history B-Help B-price-doc B-price-lists B-del-pr B-color R-status
     3491            R-obj R-buyer R-main R-avtop R-tog v-id BROWSE-1grp FILL-IN-8
     3492            FILL-IN-2 FILL-IN-1 loc_gop_name FILL-IN-buy FILL-IN-7 loc_bgr_name
     3493            FILL-IN-tog loc_tog_name FILL-IN-6 v-user-name
     3494         WITH FRAME Dialog-Frame.
     3495     VIEW FRAME Dialog-Frame.
     3496   END PROCEDURE.
     3497   PROCEDURE init-proc :
     3498   run uf-get in this-procedure(
     3499        input  'color-p':U
     3500       ,input  v-cntxt-userid
     3501       ,output v-uf-List_
     3502       ,output v-uf-Naim
     3503       ,output v-uf-print-graft
     3504       ,output v-uf-sort-gr
     3505       ,output v-uf-type-price
     3506       ,output v-uf-type-val
     3507   )  no-error.
     3508   if v-uf-List_ = "yes"  then is-color = true .
     3509   if is-color = true  then B-color:LOAD-IMAGE-UP("cmp/color.bmp") in frame Dialog-Frame  .
     3510   if is-color = false then B-color:LOAD-IMAGE-UP("cmp/nocol.bmp") in frame Dialog-Frame  .
     3511   run uf-get in this-procedure(
     3512        input  'tpl-mode-p':U
     3513       ,input  v-cntxt-userid
     3514       ,output v-uf-List_
     3515       ,output v-uf-Naim
     3516       ,output v-uf-print-graft
     3517       ,output v-uf-sort-gr
     3518       ,output v-uf-type-price
     3519       ,output v-uf-type-val
     3520       ) no-error.
     3521   if error-status :error then
     3522   assign
     3523     r-main   = 2
     3524     r-obj    = 3
     3525     r-avtop  = 2
     3526   .
     3527   else  do:
     3528     r-main   = int (entry (1,v-uf-List_,chr(4))) no-error . if r-main   = ? then  r-main   = 2 .
     3529     r-obj    = int (entry (2,v-uf-List_,chr(4))) no-error . if r-obj    = ? then  r-obj    = 3 .
     3530     r-avtop  = int (entry (3,v-uf-List_,chr(4))) no-error . if r-avtop  = ? then  r-avtop  = 2 .
     3531   end.
     3532   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3533   do:
     3534     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3535       (input  v-cntxt-db-num
     3536       ,input  v-cntxt-userid
     3537       ,input  0
     3538       ,input  'actn_documents_all':U
     3539       ,input  'object':U
     3540       ,input  0
     3541       ,input  '':U
     3542       ,input  0
     3543       ,input  0
     3544       ,input  0
     3545       ,input  0
     3546       ,input  false
     3547       ,output varlog
     3548       )  .
     3549   end.
     3550   if (r-obj = 2 or r-obj = 1) and varlog = false then r-obj = 3.
     3551   run metod-obj-in-gop (
     3552       v-cntxt-db-num ,
     3553       v-cntxt-obj-type ,
     3554       v-cntxt-obj-code ) .
     3555   run openbr in this-procedure .
     3556   END PROCEDURE.
     3557   PROCEDURE openbr :
     3558      run sort-proc in this-procedure .
     3559      apply "VALUE-CHANGED" to BROWSE-1grp IN FRAME Dialog-Frame .
     3560   END PROCEDURE.
     3561   PROCEDURE proc-code :
     3562   define input parameter par-next as logical no-undo.
     3563   define input parameter pardoc-code as INTEGER no-undo.
     3564   DEFINE VARIABLE doc-rec AS RECID NO-UNDO.
     3565     doc-rec = ? .
     3566     find first  buf_price-list-type no-lock where  buf_price-list-type.plt-id = pardoc-code no-error  .
     3567     if available buf_price-list-type then
     3568       doc-rec = recid(buf_price-list-type) .
     3569     reposition BROWSE-1grp to recid doc-rec no-error .
     3570     if not error-status :error then apply "VALUE-CHANGED" to BROWSE-1grp in frame Dialog-Frame.
     3571     else do:
     3572         message " Запись не найдена " view-as alert-box information .
     3573     end.
     3574   END PROCEDURE.
     3575   PROCEDURE recolor :
     3576   define input  parameter p-color_bg as integer   no-undo .
     3577   define input  parameter p-color_fg as integer   no-undo .
     3578     assign
     3579       buf_price-list-type.plt-id:bgcolor in browse BROWSE-1grp = p-color_bg
     3580       buf_price-list-type.main:bgcolor in browse BROWSE-1grp = p-color_bg
     3581       v-name:bgcolor in browse BROWSE-1grp = p-color_bg
     3582       v-a:bgcolor in browse BROWSE-1grp = p-color_bg
     3583     .
     3584     assign
     3585       buf_price-list-type.plt-id:fgcolor in browse BROWSE-1grp = p-color_fg
     3586       buf_price-list-type.main:fgcolor in browse BROWSE-1grp = p-color_fg
     3587       v-name:fgcolor in browse BROWSE-1grp = p-color_fg
     3588       v-a:fgcolor in browse BROWSE-1grp = p-color_fg
     3589     .
     3590   END PROCEDURE.
     3591   PROCEDURE sort-proc :
     3592   define variable column-handle as handle no-undo .
     3593   define variable v-type-sort as character no-undo .
     3594   column-handle = BROWSE-1grp:CURRENT-COLUMN  in frame Dialog-Frame no-error .
     3595   if not error-status :error  and valid-handle(column-handle) then do:
     3596       if column-handle:label = 'Прио!ритет' then do:
     3597         case column-handle:column-fgcolor:
     3598           when 0 or when ? then
     3599           assign
     3600             column-handle:column-fgcolor = 4
     3601             v-type-sort = "+"
     3602           .
     3603           when 4  then
     3604           assign
     3605             column-handle:column-fgcolor = 5
     3606             v-type-sort = "-"
     3607           .
     3608           when 5  then
     3609           assign
     3610             column-handle:column-fgcolor = 0
     3611             v-type-sort = "def"
     3612           .
     3613         end case.
     3614       end.
     3615   end.
     3616   else do:
     3617   assign
     3618     buf_price-list-type.priority:COLUMN-fgcolor in browse BROWSE-1grp   = 0
     3619     v-type-sort = "def"
     3620   .
     3621   end.
     3622   if R-obj = 3 then do:
     3623       case v-type-sort :
     3624       when "+" then do:
     3625       OPEN QUERY BROWSE-1grp
     3626         FOR EACH buf_price-list-type WHERE
     3627         ( r-ban-discnt = 0 OR buf_price-list-type.ban-discnt = r-ban-discnt ) AND
     3628         ( r-status = 2 OR buf_price-list-type.stts =  r-status ) AND
     3629         ( r-main  = 2 OR buf_price-list-type.main =  logical(r-main) ) AND
     3630         ( r-avtop = 2 OR buf_price-list-type.only-gbd =  r-avtop ) AND
     3631         ( R-buyer = 2 OR ( buf_price-list-type.bgr-id     = loc_bgr-id AND
     3632                            buf_price-list-type.bgr-db-num = loc_bgr-db-num )     ) AND
     3633         ( R-tog = 2 OR   ( buf_price-list-type.tog-id     = loc_tog-id AND
     3634                            buf_price-list-type.tog-db-num = loc_tog-db-num )     ) AND
     3635         ( R-plt = 2 OR  LOOKUP (string( RECID (buf_price-list-type)) , loc_plt-recid ) > 0 )
     3636         , each x_grp-obj-price where
     3637                x_grp-obj-price.gop-id        = buf_price-list-type.gop-id     and
     3638                x_grp-obj-price.gop-db-num    = buf_price-list-type.gop-db-num
     3639             BY buf_price-list-type.priority
     3640             BY buf_price-list-type.plt-main-id DESC
     3641             BY buf_price-list-type.plt-main-db-num DESC
     3642             BY buf_price-list-type.under-type-list
     3643             BY buf_price-list-type.sys-date DESC
     3644             BY buf_price-list-type.sys-time DESC .
     3645       end.
     3646       when "-" then do:
     3647       OPEN QUERY BROWSE-1grp
     3648         FOR EACH buf_price-list-type WHERE
     3649         ( r-ban-discnt = 0 OR buf_price-list-type.ban-discnt = r-ban-discnt ) AND
     3650         ( r-status = 2 OR buf_price-list-type.stts =  r-status ) AND
     3651         ( r-main = 2 OR buf_price-list-type.main =  logical(r-main) ) AND
     3652         ( r-avtop = 2 OR buf_price-list-type.only-gbd = r-avtop ) AND
     3653         ( R-buyer = 2 OR    ( buf_price-list-type.bgr-id     = loc_bgr-id AND
     3654                               buf_price-list-type.bgr-db-num = loc_bgr-db-num )     ) AND
     3655         ( R-tog = 2 OR    ( buf_price-list-type.tog-id     = loc_tog-id AND
     3656                             buf_price-list-type.tog-db-num = loc_tog-db-num )     ) AND
     3657         ( R-plt = 2 OR       LOOKUP (string( RECID (buf_price-list-type)) , loc_plt-recid ) > 0 )
     3658         , each x_grp-obj-price where
     3659                x_grp-obj-price.gop-id        = buf_price-list-type.gop-id     and
     3660                x_grp-obj-price.gop-db-num    = buf_price-list-type.gop-db-num
     3661             BY buf_price-list-type.priority DESC
     3662             BY buf_price-list-type.plt-main-id DESC
     3663             BY buf_price-list-type.plt-main-db-num DESC
     3664             BY buf_price-list-type.under-type-list
     3665             BY buf_price-list-type.sys-date DESC
     3666             BY buf_price-list-type.sys-time DESC .
     3667       end.
     3668       when "def" then do:
     3669       buf_price-list-type.priority:COLUMN-fgcolor in browse BROWSE-1grp   = 0.
     3670       OPEN QUERY BROWSE-1grp
     3671         FOR EACH buf_price-list-type WHERE
     3672         ( r-ban-discnt = 0 OR buf_price-list-type.ban-discnt = r-ban-discnt ) AND
     3673         ( r-status = 2 OR buf_price-list-type.stts      =  r-status ) AND
     3674         ( r-main = 2 OR  buf_price-list-type.main       =  logical(r-main) ) AND
     3675         ( r-avtop = 2 OR buf_price-list-type.only-gbd =  r-avtop ) AND
     3676         ( R-buyer = 2 OR ( buf_price-list-type.bgr-id   = loc_bgr-id AND
     3677                         buf_price-list-type.bgr-db-num = loc_bgr-db-num )     ) AND
     3678         ( R-tog = 2 OR   ( buf_price-list-type.tog-id   = loc_tog-id AND
     3679                         buf_price-list-type.tog-db-num = loc_tog-db-num )     ) AND
     3680         ( R-plt = 2 OR   LOOKUP (string( RECID (buf_price-list-type)) , loc_plt-recid ) > 0 )
     3681         , each x_grp-obj-price where
     3682                x_grp-obj-price.gop-id        = buf_price-list-type.gop-id     and
     3683                x_grp-obj-price.gop-db-num    = buf_price-list-type.gop-db-num
     3684             BY buf_price-list-type.plt-main-id DESC
     3685             BY buf_price-list-type.plt-main-db-num DESC
     3686             BY buf_price-list-type.under-type-list
     3687             BY buf_price-list-type.sys-date DESC
     3688             BY buf_price-list-type.sys-time DESC .
     3689       end.
     3690       end case .
     3691   end.
     3692   else do:
     3693   case v-type-sort :
     3694   when "+" then do:
     3695   OPEN QUERY BROWSE-1grp
     3696     FOR EACH buf_price-list-type WHERE
     3697     ( r-ban-discnt = 0 OR buf_price-list-type.ban-discnt = r-ban-discnt ) AND
     3698     ( r-status = 2 OR buf_price-list-type.stts =  r-status ) AND
     3699     ( r-main  = 2 OR buf_price-list-type.main =  logical(r-main) ) AND
     3700     ( r-avtop = 2 OR buf_price-list-type.only-gbd =  r-avtop ) AND
     3701     ( r-obj   = 2 OR ( buf_price-list-type.gop-id     = loc_gop-id AND
     3702                        buf_price-list-type.gop-db-num = loc_gop-db-num )     ) AND
     3703     ( R-buyer = 2 OR ( buf_price-list-type.bgr-id     = loc_bgr-id AND
     3704                        buf_price-list-type.bgr-db-num = loc_bgr-db-num )     ) AND
     3705     ( R-tog = 2 OR   ( buf_price-list-type.tog-id     = loc_tog-id AND
     3706                        buf_price-list-type.tog-db-num = loc_tog-db-num )     ) AND
     3707     ( R-plt = 2 OR  LOOKUP (string( RECID (buf_price-list-type)) , loc_plt-recid ) > 0 )
     3708     , FIRST x_grp-obj-price OUTER-JOIN
     3709          BY buf_price-list-type.priority
     3710          BY buf_price-list-type.plt-main-id DESC
     3711          BY buf_price-list-type.plt-main-db-num DESC
     3712          BY buf_price-list-type.under-type-list
     3713          BY buf_price-list-type.sys-date DESC
     3714          BY buf_price-list-type.sys-time DESC .
     3715   end.
     3716   when "-" then do:
     3717   OPEN QUERY BROWSE-1grp
     3718     FOR EACH buf_price-list-type WHERE
     3719     ( r-ban-discnt = 0 OR buf_price-list-type.ban-discnt = r-ban-discnt ) AND
     3720     ( r-status = 2 OR buf_price-list-type.stts =  r-status ) AND
     3721     ( r-main = 2 OR buf_price-list-type.main =  logical(r-main) ) AND
     3722     ( r-avtop = 2 OR buf_price-list-type.only-gbd = r-avtop ) AND
     3723     ( r-obj = 2 OR        ( buf_price-list-type.gop-id     = loc_gop-id AND
     3724                             buf_price-list-type.gop-db-num = loc_gop-db-num )     ) AND
     3725     ( R-buyer = 2 OR    ( buf_price-list-type.bgr-id     = loc_bgr-id AND
     3726                           buf_price-list-type.bgr-db-num = loc_bgr-db-num )     ) AND
     3727     ( R-tog = 2 OR    ( buf_price-list-type.tog-id     = loc_tog-id AND
     3728                         buf_price-list-type.tog-db-num = loc_tog-db-num )     ) AND
     3729      ( R-plt = 2 OR       LOOKUP (string( RECID (buf_price-list-type)) , loc_plt-recid ) > 0 )
     3730      , FIRST x_grp-obj-price OUTER-JOIN
     3731          BY buf_price-list-type.priority DESC
     3732          BY buf_price-list-type.plt-main-id DESC
     3733          BY buf_price-list-type.plt-main-db-num DESC
     3734          BY buf_price-list-type.under-type-list
     3735          BY buf_price-list-type.sys-date DESC
     3736          BY buf_price-list-type.sys-time DESC .
     3737   end.
     3738   when "def" then do:
     3739   buf_price-list-type.priority:COLUMN-fgcolor in browse BROWSE-1grp   = 0.
     3740   OPEN QUERY BROWSE-1grp
     3741     FOR EACH buf_price-list-type WHERE
     3742     ( r-ban-discnt = 0 OR buf_price-list-type.ban-discnt = r-ban-discnt ) AND
     3743     ( r-status = 2 OR buf_price-list-type.stts      =  r-status ) AND
     3744     ( r-main = 2 OR  buf_price-list-type.main       =  logical(r-main) ) AND
     3745     ( r-avtop = 2 OR buf_price-list-type.only-gbd =  r-avtop ) AND
     3746     ( r-obj = 2 OR   ( buf_price-list-type.gop-id   = loc_gop-id AND
     3747                      buf_price-list-type.gop-db-num = loc_gop-db-num )     ) AND
     3748     ( R-buyer = 2 OR ( buf_price-list-type.bgr-id   = loc_bgr-id AND
     3749                      buf_price-list-type.bgr-db-num = loc_bgr-db-num )     ) AND
     3750     ( R-tog = 2 OR   ( buf_price-list-type.tog-id   = loc_tog-id AND
     3751                      buf_price-list-type.tog-db-num = loc_tog-db-num )     ) AND
     3752     ( R-plt = 2 OR   LOOKUP (string( RECID (buf_price-list-type)) , loc_plt-recid ) > 0 )
     3753     , FIRST x_grp-obj-price OUTER-JOIN
     3754          BY buf_price-list-type.plt-main-id DESC
     3755          BY buf_price-list-type.plt-main-db-num DESC
     3756          BY buf_price-list-type.under-type-list
     3757          BY buf_price-list-type.sys-date DESC
     3758          BY buf_price-list-type.sys-time DESC .
     3759   end.
     3760   end case .
     3761   end.
     3762   END PROCEDURE.
