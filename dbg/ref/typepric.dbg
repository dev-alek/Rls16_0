        1   DEFINE NEW SHARED BUFFER buf_price-list-type FOR price-list-type.
        2   define input  parameter parParentProc as handle no-undo .
        3   define input  parameter p-bttns as character no-undo .
        4   define input-output parameter  p-rec-list as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Справочник Типов прайс-листов".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   define new global shared variable g#library  as handle no-undo .
      115   define new global shared variable g#library2 as handle no-undo .
      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117     define variable v-cntxt-db-num        as integer   no-undo .
      118     define variable v-cntxt-userid        as character no-undo .
      119     define variable v-cntxt-level         as character no-undo .
      120     define variable v-cntxt-host-code-obj as integer   no-undo .
      121     define variable v-cntxt-obj-type      as character no-undo .
      122     define variable v-cntxt-obj-code      as integer   no-undo .
      123     define variable v-cntxt-db-num-obj    as integer   no-undo .
      124     define variable v-cntxt-is-admin      as logical   no-undo .
      125   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126     run mainmenu_getcntxt in parparentproc
      127       (output v-cntxt-db-num
      128       ,output v-cntxt-userid
      129       ,output v-cntxt-level
      130       ,output v-cntxt-host-code-obj
      131       ,output v-cntxt-obj-type
      132       ,output v-cntxt-obj-code
      133       ,output v-cntxt-db-num-obj
      134       ,output v-cntxt-is-admin
      135       ) .
      136   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      137   define variable v-waitfram-action01         as character   no-undo .
      138   define variable v-waitfram-action02         as character   no-undo .
      139   define variable v-waitfram-action03         as character   no-undo .
      140   define variable mWaitFramTextBeg            as character   no-undo.
      141   define variable mWaitFramTextEnd            as character   no-undo.
      142   define variable mWaitFramView               as logical     no-undo.
      143   define variable mWaitProcEvent              as logical     no-undo init yes.
      144   define variable mWaitFramInterval           as integer     no-undo init 1 .
      145   define variable mWaitFramStop               as logical     no-undo.
      146   define variable mWaitFramStopUser           as logical     no-undo.
      147   define variable mWaitFramStopTimeOut        as logical     no-undo.
      148   define variable mWaitFramStartProc          as datetime-tz no-undo.
      149   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      150   define button B-WaitFramStop auto-end-key
      151        label "Стоп"
      152        size 10 by 1 tooltip "Остоновить процесс".
      153   define button B-viewProcInfo
      154        label "Информация"
      155        size 15 by 1 tooltip "Информация о процесс".
      156   define frame waitfram
      157     v-waitfram-action01 format "x(72)" no-label skip
      158     v-waitfram-action02 format "x(72)" no-label skip
      159     v-waitfram-action03 format "x(72)" no-label skip
      160     B-viewProcInfo
      161     B-WaitFramStop at row 4 col 30
      162     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      163     .
      164   define new global shared variable mBatchMode as logical no-undo init ?.
      165   define variable mFramBachModHandle as handle no-undo.
      166   mFramBachModHandle = frame waitfram:handle.
      167   define variable mFameOldVis as logical no-undo.
      168   define variable mVisCUrentVin as logical no-undo.
      169   if session:batch-mode
      170   then
      171      mBatchMode = yes.
      172   if mBatchMode = ? then do:
      173     mVisCUrentVin = current-window:visible.
      174     mFameOldVis = mFramBachModHandle:visible.
      175     mFramBachModHandle:visible  = yes.
      176     mBatchMode = mFramBachModHandle:visible ne yes.
      177     mFramBachModHandle:visible = mFameOldVis.
      178     current-window:visible = mVisCUrentVin.
      179   end.
      180    if  log-manager:logfile-name ne ?
      181     then DO:
      182         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      183         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      184         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      185     end.
      186   on choose of B-WaitFramStop in frame waitfram
      187   do:
      188     mWaitFramStop = yes.
      189     mWaitFramStopUser = yes.
      190   end.
      191   function waitfram-check-timeout returns logical():
      192      define variable vtime as int64 no-undo.
      193      if mWaitFramStopTimeOut
      194      then
      195         return yes.
      196      vtime = ( now - mWaitFramStartProc ) / 1000 .
      197      if     mWaitFramTimeOut ne ?
      198         and mWaitFramTimeOut ne 0
      199         and mWaitFramTimeOut lt vtime
      200      then do:
      201         mWaitFramStopTimeOut = yes.
      202      end.
      203      return mWaitFramStopTimeOut.
      204   end.
      205   procedure waitfram-hide :
      206     if not session:batch-mode
      207     then do
      208     on error undo, return error return-value
      209     :
      210       pause 0 before-hide .
      211       if not mBatchMode then
      212         hide frame waitfram .
      213     if     not mWaitFramView
      214        and mWaitProcEvent
      215     then
      216       process events .
      217     end.
      218   end procedure.
      219   procedure waitfram-show :
      220     define input  parameter p-message as character no-undo .
      221     define variable v-left-margin as integer   no-undo .
      222     if not session:batch-mode
      223     then do
      224     on error undo, return error return-value
      225     :
      226       if length(p-message) <= 70 then do:
      227         assign
      228           v-left-margin = integer((70 - length(p-message)) / 2)
      229         .
      230         assign
      231           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      232         .
      233         assign
      234           v-waitfram-action01 = " "
      235           v-waitfram-action02 = " "
      236                                    + fill(" ", v-left-margin)
      237                                    + p-message
      238           v-waitfram-action03 = " "
      239         .
      240       end.
      241       else do:
      242         define variable vRindex1 as integer no-undo.
      243         define variable vRindex2 as integer no-undo.
      244         vRindex1 = r-index(p-message," ",70).
      245         if vRindex1 = 0
      246         then
      247            vRindex1 = 70.
      248         if length(p-message)  <= vRindex1 + 70 then do:
      249           assign
      250             v-waitfram-action01 = " "
      251             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      252             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      253           .
      254         end.
      255         else do:
      256           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      257           if vRindex2 <= vRindex1
      258           then
      259              vRindex2 = vRindex1 + 70.
      260           assign
      261             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      262             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      263             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      264           .
      265         end.
      266       end.
      267       B-viewProcInfo:visible   in frame waitfram = no.
      268       B-viewProcInfo:sensitive in frame waitfram = no.
      269       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      270       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      271       if  (   mWaitFramView
      272          or  mWaitProcEvent)
      273          and not mBatchMode
      274       then
      275          display
      276             v-waitfram-action01 skip
      277             v-waitfram-action02 skip
      278             v-waitfram-action03 skip
      279          with frame waitfram .
      280       if     mWaitFramView
      281          then do:
      282             if     mWaitFramInterval ne ?
      283                and not mBatchMode
      284             then
      285                wait-for go of frame waitfram pause mWaitFramInterval.
      286          end.
      287          else
      288             if     mWaitProcEvent
      289                and not mBatchMode
      290             then
      291                process events .
      292     end.
      293   end procedure.
      294      procedure waitfram-show-this:
      295         define input  parameter iInterval as int64 no-undo.
      296         define variable vtime as int64 no-undo.
      297         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      298         mWaitFramInterval = iInterval.
      299         run waitfram-show (substitute("&1&2 &3&4" ,
      300                                       mWaitFramTextBeg ,
      301                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      302                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      303                                       mWaitFramTextEnd
      304                                      )
      305                           ).
      306      end.
      307      procedure WaitFramRunPause:
      308         define input  parameter iInterval as dec no-undo.
      309         define variable vStart  as datetime-tz no-undo.
      310         define variable vend    as datetime-tz no-undo.
      311         define variable vint as int64 no-undo.
      312         define variable vOk as logical no-undo.
      313         vStart = now.
      314         vend   = vStart.
      315         publish "WaitFramPause" (iInterval,output vOk).
      316         vend   =  now.
      317         vint = vend - vStart.
      318         vint = iInterval - vint / 1000.
      319         if     not mWaitFramStop
      320            and (   vint > 0
      321                 or (    not vOk
      322                     and iInterval eq ?
      323                     )
      324                 )
      325         then
      326            run waitfram-show-this (iInterval).
      327         vend   =  now.
      328         vint = vend - vStart.
      329         vint = iInterval - vint / 1000.
      330         if     not mWaitFramStop
      331            and vint > 0
      332         then do:
      333            run gbl/pause.p (vint * 1000).
      334         end.
      335         if iInterval ne ?
      336         then
      337            publish "WaitFramStop".
      338         waitfram-check-timeout().
      339      end.
      340      procedure WaitFramWaitFor:
      341         define input  parameter iInterval as dec no-undo.
      342         assign
      343            mWaitFramStartProc   = now
      344            mWaitFramStopUser    = no
      345            mWaitFramStopTimeOut = no
      346         .
      347         block-wait:
      348         do while not mWaitFramStop:
      349            run WaitFramRunPause (iInterval).
      350            if  waitfram-check-timeout()
      351            then do:
      352               leave block-wait.
      353            end.
      354         end.
      355         run waitfram-hide.
      356      end.
      357   procedure waitfram-join :
      358     define input  parameter p-line-1  as character no-undo .
      359     define input  parameter p-line-2  as character no-undo .
      360     define input  parameter p-line-3  as character no-undo .
      361     define output parameter p-message as character no-undo .
      362     do
      363     on error undo, return error return-value
      364     :
      365       assign
      366         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      367                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      368                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      369       .
      370     end.
      371   end procedure.
      372   function waitfram-join-function returns character
      373     (input p-line-1 as character
      374     ,input p-line-2 as character
      375     ,input p-line-3 as character
      376     ).
      377     define variable v-message as character no-undo .
      378     run waitfram-join in this-procedure
      379       (input  p-line-1
      380       ,input  p-line-2
      381       ,input  p-line-3
      382       ,output v-message
      383       ) .
      384     return v-message .
      385   end function .
