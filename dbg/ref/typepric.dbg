      509   procedure uf-get :
      510     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      511     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      512     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      513     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      514     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      515     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      516     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      517     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      518     do
      519     on error undo, return error
      520     :
      521       define buffer buf_usr-flt for ubflt.usr-flt .
      522       define variable v-use-List_     as logical   no-undo .
      523       define variable v-type-List_     as character no-undo .
      524       define variable v-format-List_   as character no-undo .
      525       define variable v-use-Naim      as logical   no-undo .
      526       define variable v-type-Naim      as character no-undo .
      527       define variable v-format-Naim    as character no-undo .
      528       define variable v-use-print-graft as logical   no-undo .
      529       define variable v-use-sort-gr     as logical   no-undo .
      530       define variable v-use-type-price  as logical   no-undo .
      531       define variable v-use-type-val    as logical   no-undo .
      532       define variable v-label          as character no-undo .
      533       define variable v-tooltip        as character no-undo .
      534       define variable v-user-can-edit  as logical   no-undo .
      535       define variable v-output-display as logical   no-undo .
      536       define variable v-other          as character no-undo .
      537       run uf-name in this-procedure
      538          (input  entry(1, p-code, chr(4))
      539         ,output v-use-List_
      540         ,output v-type-List_
      541         ,output v-format-List_
      542         ,output v-use-Naim
      543         ,output v-type-Naim
      544         ,output v-format-Naim
      545         ,output v-use-print-graft
      546         ,output v-use-sort-gr
      547         ,output v-use-type-price
      548         ,output v-use-type-val
      549         ,output v-label
      550         ,output v-tooltip
      551         ,output v-user-can-edit
      552         ,output v-output-display
      553         ,output v-other
      554         ) no-error .
      555       if error-status :error then do:
      556         undo, return error return-value .
      557       end.
      558       find first buf_usr-flt no-lock where
      559                  buf_usr-flt.Call-point     = p-code AND
      560                  buf_usr-flt.user-name       = p-user-name
      561         no-error .
      562       if avail buf_usr-flt then do:
      563         assign
      564         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      565         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      566         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      567         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      568         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      569         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      570         .
      571       end.
      572       else do:
      573         assign
      574         p-List_        = (if v-use-List_       then "":U                    else ?)
      575         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      576         p-print-graft  = (if v-use-print-graft then no                      else ?)
      577         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      578         p-type-price   = (if v-use-type-price  then no                      else ?)
      579         p-type-val     = (if v-use-List_       then no                      else ?)
      580         .
      581       end.
      582     end.
      583   end procedure.
      584   procedure uf-set :
      585     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      586     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      587     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      588     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      589     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      590     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      591     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      592     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      593     do
      594     on error undo, return error
      595     :
      596       define buffer buf_usr-flt for ubflt.usr-flt .
      597       define variable v-use-List_     as logical   no-undo .
      598       define variable v-type-List_     as character no-undo .
      599       define variable v-format-List_   as character no-undo .
      600       define variable v-use-Naim      as logical   no-undo .
      601       define variable v-type-Naim      as character no-undo .
      602       define variable v-format-Naim    as character no-undo .
      603       define variable v-use-print-graft as logical   no-undo .
      604       define variable v-use-sort-gr   as logical   no-undo .
      605       define variable v-use-type-price as logical   no-undo .
      606       define variable v-use-type-val  as logical   no-undo .
      607       define variable v-tooltip        as character no-undo .
      608       define variable v-label          as character no-undo .
      609       define variable v-user-can-edit  as logical   no-undo .
      610       define variable v-output-display as logical   no-undo .
      611       define variable v-other          as character no-undo .
      612       run uf-name in this-procedure
      613         (input  entry(1, p-code, chr(4))
      614         ,output v-use-List_
      615         ,output v-type-List_
      616         ,output v-format-List_
      617         ,output v-use-Naim
      618         ,output v-type-Naim
      619         ,output v-format-Naim
      620         ,output v-use-print-graft
      621         ,output v-use-sort-gr
      622         ,output v-use-type-price
      623         ,output v-use-type-val
      624         ,output v-label
      625         ,output v-tooltip
      626         ,output v-user-can-edit
      627         ,output v-output-display
      628         ,output v-other
      629         ) no-error .
      630       if error-status :error then do:
      631         undo, return error return-value .
      632       end.
      633       find first buf_usr-flt where
      634                  buf_usr-flt.Call-point     = p-code AND
      635                  buf_usr-flt.user-name       = p-user-name
      636         no-error .
      637       if not avail buf_usr-flt then do:
      638           create buf_usr-flt .
      639           assign
      640           buf_usr-flt.call-point = p-code
      641           buf_usr-flt.user-name  = p-user-name
      642           .
      643       end.
      644       if avail buf_usr-flt then do:
      645        assign
      646        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      647        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      648        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      649        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      650        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      651        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      652       .
      653       release buf_usr-flt.
      654       end.
      655       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      656     end.
      657   end procedure.
      658   DEFINE TEMP-TABLE TT_cassa NO-UNDO LIKE ub.price-list-type-cassa.
      659   DEFINE TEMP-TABLE TT_grp   NO-UNDO LIKE ub.price-list-type-gds-grp.
      660   DEFINE TEMP-TABLE TT_pay-type NO-UNDO LIKE ub.price-list-type-pay-type.
      661   DEFINE TEMP-TABLE TT_cash-pay NO-UNDO LIKE ub.price-list-type-cash-pay.
      662   PROCEDURE type-price-list-ADD :
      663   define input  parameter p-db-num                       as integer   no-undo .
      664   define input  parameter p-id                           as integer   no-undo .
      665   define input  parameter p-name                         as character no-undo .
      666   define input  parameter p-ban-discnt                   like   ub.price-list-type.ban-discnt          no-undo .
      667   define input  parameter p-calc-round-method            like   ub.price-list-type.calc-round-method    no-undo .
      668   define input  parameter p-calc-round-base              like   ub.price-list-type.calc-round-base      no-undo .
      669   define input  parameter p-calc-increase-pc             like   ub.price-list-type.calc-increase-pc     no-undo .
      670   define input  parameter p-calc-method                  like   ub.price-list-type.calc-method          no-undo .
      671   define input  parameter p-create-price-doc             like   ub.price-list-type.create-price-doc     no-undo .
      672   define input  parameter p-fix-cource-crc-base          like   ub.price-list-type.fix-cource-crc-base  no-undo .
      673   define input  parameter p-fix-cource-crc-doc           like   ub.price-list-type.fix-cource-crc-doc   no-undo .
      674   define input  parameter p-have-rs-qnty-group           like   ub.price-list-type.have-rs-qnty-group   no-undo .
      675   define input  parameter p-have-rs-sum-group            like   ub.price-list-type.have-rs-sum-group    no-undo .
      676   define input  parameter p-main                         like   ub.price-list-type.main                 no-undo .
      677   define input  parameter p-only-gbd                     like   ub.price-list-type.only-gbd             no-undo .
      678   define input  parameter p-plt-main-db-num              like   ub.price-list-type.plt-main-db-num      no-undo .
      679   define input  parameter p-plt-main-id                  like   ub.price-list-type.plt-main-id          no-undo .
      680   define input  parameter p-priority                     like   ub.price-list-type.priority             no-undo .
      681   define input  parameter p-rs-buyer                     like   ub.price-list-type.rs-buyer             no-undo .
      682   define input  parameter p-send-cassa                   like   ub.price-list-type.send-cassa           no-undo .
      683   define input  parameter p-under-hand-corr              like   ub.price-list-type.under-hand-corr      no-undo .
      684   define input  parameter p-under-round-method           like   ub.price-list-type.under-round-method         no-undo .
      685   define input  parameter p-under-perc                   like   ub.price-list-type.under-perc           no-undo .
      686   define input  parameter p-under-type-list              like   ub.price-list-type.under-type-list      no-undo .
      687   define input  parameter p-use-cassa                    like   ub.price-list-type.use-cassa            no-undo .
      688   define input  parameter p-use-gds-group                like   ub.price-list-type.use-gds-group        no-undo .
      689   define input  parameter p-use-obj                      like   ub.price-list-type.use-obj              no-undo .
      690   define input  parameter p-work-date                    like   ub.price-list-type.work-date            no-undo .
      691   define input  parameter p-bgr-db-num                   like   ub.price-list-type.bgr-db-num           no-undo .
      692   define input  parameter p-bgr-id                       like   ub.price-list-type.bgr-id               no-undo .
      693   define input  parameter p-curr-code                    like   ub.price-list-type.curr-code            no-undo .
      694   define input  parameter p-gop-db-num                   like   ub.price-list-type.gop-db-num           no-undo .
      695   define input  parameter p-gop-db-num-for-calc-turnover like   ub.price-list-type.gop-db-num-for-calc-turnover  no-undo .
      696   define input  parameter p-gop-id                       like   ub.price-list-type.gop-id                        no-undo .
      697   define input  parameter p-gop-id-for-calc-turnover     like   ub.price-list-type.gop-id-for-calc-turnover      no-undo .
      698   define input  parameter p-qgr-db-num                   like   ub.price-list-type.qgr-db-num                    no-undo .
      699   define input  parameter p-qgr-id                       like   ub.price-list-type.qgr-id                        no-undo .
      700   define input  parameter p-sgr-db-num                   like   ub.price-list-type.sgr-db-num                    no-undo .
      701   define input  parameter p-sgr-id                       like   ub.price-list-type.sgr-id                        no-undo .
      702   define input  parameter p-tog-db-num                   like   ub.price-list-type.tog-db-num                    no-undo .
      703   define input  parameter p-tog-id                       like   ub.price-list-type.tog-id                        no-undo .
      704   define input  parameter p-obj-turnover                 like   ub.price-list-type.obj-turnover                  no-undo .
      705   define input  parameter p-ttg-summa                    like   ub.price-list-type.ttg-summa                     no-undo .
      706   define input  parameter p-userid                       as character no-undo .
      707   define input  parameter p-db-num-usr                   as integer   no-undo .
      708   define input  parameter p-have-rs-turn-group           like   ub.price-list-type.have-rs-turn-group no-undo .
      709   define input  parameter p-have-tog-db-num              like   ub.price-list-type.have-tog-db-num    no-undo .
      710   define input  parameter p-have-tog-id                  like   ub.price-list-type.have-tog-id        no-undo .
      711   define input  parameter p-use-cash-pay                 like   ub.price-list-type.use-cash-pay no-undo .
      712   define input  parameter p-use-pay-type                 like   ub.price-list-type.use-pay-type no-undo .
      713   define output parameter p-recid                        as recid no-undo .
      714   define input  parameter table for tt_cassa .
      715   define input  parameter table for tt_grp   .
      716   define input  parameter table for tt_pay-type .
      717   define input  parameter table for tt_cash-pay .
      718   define variable v-text as character no-undo .
      719   define buffer buf_price-list-type for ub.price-list-type  .
      720     do
      721     on error undo, return error return-value
      722     :
      723   if p-plt-main-id                     = ? then p-plt-main-id = 0 .
      724   if p-bgr-id                          = ? then p-bgr-id                        = 0 .
      725   if p-gop-id                          = ? then p-gop-id                        = 0 .
      726   if p-gop-id-for-calc-turnover        = ? then p-gop-id-for-calc-turnover      = 0 .
      727   if p-qgr-db-num                      = ? then p-qgr-db-num                    = 0 .
      728   if p-qgr-id                          = ? then p-qgr-id                        = 0 .
      729   if p-sgr-db-num                      = ? then p-sgr-db-num                    = 0 .
      730   if p-sgr-id                          = ? then p-sgr-id                        = 0 .
      731   if p-tog-db-num                      = ? then p-tog-db-num                    = 0 .
      732   if p-tog-id                          = ? then p-tog-id                        = 0 .
      733   if p-gop-db-num                      = ? then p-gop-db-num                    = 0 .
      734   if p-gop-db-num-for-calc-turnover    = ? then p-gop-db-num-for-calc-turnover  = 0 .
      735   if p-have-tog-db-num                 = ? then p-have-tog-db-num  = 0 .
      736   if p-have-tog-id                     = ? then p-have-tog-id      = 0 .
      737   if p-gop-id = 0  then  p-use-obj = 1 .
      738   if p-gop-id-for-calc-turnover  = 0  then  p-obj-turnover = false  .
      739   if p-tog-id = 0   then  p-obj-turnover = false  .
      740   if p-tog-id = 0 and  p-bgr-id = 0   then  p-rs-buyer = 0.
      741   if p-name = ? or p-name = ""  then do:
      742     return error "Название типа прайс-листа не должно быть пустым!" .
      743   end.
      744   if logical(p-have-rs-qnty-group) = true and  ( p-qgr-id = 0 or p-qgr-id = ? ) then do:
      745     return error "Не задана количественная группа!" .
      746   end.
      747   if p-have-rs-sum-group = true and  ( p-sgr-id = 0 or p-sgr-id = ? ) then do:
      748     return error "Не задана суммовая группа!" .
      749   end.
      750   if logical(p-under-type-list) = true and  ( p-plt-main-id = 0 or p-plt-main-id = ? ) then do:
      751     return error "Не задан родительский прайс-лист !" .
      752   end.
      753   define buffer parent_price-list-type for ub.price-list-type  .
      754   if  logical(p-under-type-list) = true and p-main = true  then do:
      755       find first parent_price-list-type  no-lock where
      756                  parent_price-list-type.plt-id = p-plt-main-id  and
      757                  parent_price-list-type.plt-db-num =  p-plt-main-db-num no-error .
      758       if not available parent_price-list-type then  return error "Родительский прайс-лист не найден !" .
      759       if parent_price-list-type.stts <> integer('0':U) then  return error "Родительский прайс-лист удален !" .
      760       if parent_price-list-type.main = false  then  return error "Родительский прайс-лист должен быть ГЛАВНЫМ !" .
      761       if parent_price-list-type.under-type-list <> 0  then return error "Родительский прайс-лист не должен быть подчиненным !"  .
      762   end.
      763   if  logical(p-under-type-list) = true and p-main = false   then do:
      764       find first parent_price-list-type  no-lock where
      765                  parent_price-list-type.plt-id = p-plt-main-id  and
      766                  parent_price-list-type.plt-db-num =  p-plt-main-db-num no-error .
      767       if not available parent_price-list-type then  return error "Родительский прайс-лист не найден !" .
      768       if parent_price-list-type.stts <> integer('0':U) then  return error "Родительский прайс-лист удален !" .
      769       if parent_price-list-type.under-type-list <> 0  then return error "Родительский прайс-лист не должен быть подчиненным !"  .
      770   end.
      771   if logical(p-have-rs-qnty-group) = false  and not ( p-qgr-id = 0 or p-qgr-id = ? ) then do:
      772      p-qgr-id = 0.
      773      p-qgr-db-num = 0.
      774   end.
      775   if p-have-rs-sum-group = false  and  not( p-sgr-id = 0 or p-sgr-id = ? ) then do:
      776     p-sgr-id = 0.
      777     p-sgr-db-num = 0.
      778   end.
      779   if logical(p-have-rs-turn-group) = false  and not ( p-have-tog-id = 0 or p-have-tog-id = ? ) then do:
      780      p-have-tog-id = 0.
      781      p-have-tog-db-num = 0.
      782   end.
      783   if p-priority  = 0  and p-main = false  and p-under-type-list = 0 then do:
      784      return error "Не задан ПРИОРИТЕТ типа прайс-листа"   .
      785   end.
      786   if p-priority > 0 and p-main = false and p-under-type-list = 0 then do:
      787       if can-find (
      788             first buf_price-list-type no-lock where
      789                   buf_price-list-type.under-type-list = 0          and
      790                   buf_price-list-type.priority        = p-priority and
      791                   buf_price-list-type.main            = false      and
      792                   buf_price-list-type.stts            = integer('0':U)          and
      793               not
      794                 ( buf_price-list-type.plt-db-num = p-db-num and
      795                   buf_price-list-type.plt-id     = p-id )
      796                 ) then
      797       return error "Уже есть тип прайс-листа с приоритетом " + string ( p-priority ) .
      798   end.
      799   find first ub.price-list-type exclusive-lock where
      800              ub.price-list-type.plt-db-num   = p-db-num and
      801              ub.price-list-type.plt-id       = p-id
      802              no-error .
      803       if not available ub.price-list-type then do:
      804         if p-main = true and p-only-gbd = 1 then do:
      805           if can-find ( first buf_price-list-type no-lock where
      806                             buf_price-list-type.main = true and
      807                             buf_price-list-type.only-gbd = 1 and
      808                             buf_price-list-type.stts = integer('0':U) and
      809                             buf_price-list-type.gop-id = p-gop-id and
      810                             buf_price-list-type.gop-db-num = p-gop-db-num ) then  do:
      811               if p-gop-id = 0 or p-gop-id = ? then do:
      812                 v-text  = "для всех объектов" .
      813                 end.
      814                 else do:
      815                 v-text  = "для объектов из группы №"  + string(p-gop-id) + " БД:" + string(p-gop-db-num).
      816                 end.
      817               release ub.price-list-type no-error .
      818               return error "Уже существует ГЛАВНЫЙ ПРАЙС-ЛИСТ для автопереоценок " + v-text .
      819               end.
      820         end.
      821         create ub.price-list-type .
      822         assign
      823             ub.price-list-type.plt-db-num   = p-db-num
      824             ub.price-list-type.plt-id       = p-id
      825         .
      826       end.
      827          assign
      828             ub.price-list-type.plt-db-num                     = p-db-num
      829             ub.price-list-type.plt-id                         = p-id
      830             ub.price-list-type.name                           = p-name
      831             ub.price-list-type.ban-discnt                     = p-ban-discnt
      832             ub.price-list-type.calc-round-method              = p-calc-round-method
      833             ub.price-list-type.calc-round-base                = p-calc-round-base
      834             ub.price-list-type.calc-increase-pc               = p-calc-increase-pc
      835             ub.price-list-type.calc-method                    = p-calc-method
      836             ub.price-list-type.create-price-doc               = p-create-price-doc
      837             ub.price-list-type.fix-cource-crc-base            = p-fix-cource-crc-base
      838             ub.price-list-type.fix-cource-crc-doc             = p-fix-cource-crc-doc
      839             ub.price-list-type.have-rs-qnty-group             = p-have-rs-qnty-group
      840             ub.price-list-type.have-rs-sum-group              = p-have-rs-sum-group
      841             ub.price-list-type.main                           = p-main
      842             ub.price-list-type.only-gbd                       = p-only-gbd
      843             ub.price-list-type.plt-main-db-num                = if p-plt-main-id = 0 then p-db-num else p-plt-main-db-num
      844             ub.price-list-type.plt-main-id                    = if p-plt-main-id = 0 then p-id else p-plt-main-id
      845             ub.price-list-type.priority                       = p-priority
      846             ub.price-list-type.rs-buyer                       = p-rs-buyer
      847             ub.price-list-type.send-cassa                     = p-send-cassa
      848             ub.price-list-type.under-hand-corr                = p-under-hand-corr
      849             ub.price-list-type.under-round-method             = p-under-round-method
      850             ub.price-list-type.under-perc                     = p-under-perc
      851             ub.price-list-type.under-type-list                = p-under-type-list
      852             ub.price-list-type.use-cassa                      = p-use-cassa
      853             ub.price-list-type.use-gds-group                  = p-use-gds-group
      854             ub.price-list-type.use-obj                        = p-use-obj
      855             ub.price-list-type.work-date                      = p-work-date
      856             ub.price-list-type.bgr-db-num                     = p-bgr-db-num
      857             ub.price-list-type.bgr-id                         = p-bgr-id
      858             ub.price-list-type.curr-code                      = p-curr-code
      859             ub.price-list-type.gop-db-num                     = p-gop-db-num
      860             ub.price-list-type.gop-db-num-for-calc-turnover   = p-gop-db-num-for-calc-turnover
      861             ub.price-list-type.gop-id                         = p-gop-id
      862             ub.price-list-type.gop-id-for-calc-turnover       = p-gop-id-for-calc-turnover
      863             ub.price-list-type.qgr-db-num                     = p-qgr-db-num
      864             ub.price-list-type.qgr-id                         = p-qgr-id
      865             ub.price-list-type.sgr-db-num                     = p-sgr-db-num
      866             ub.price-list-type.sgr-id                         = p-sgr-id
      867             ub.price-list-type.tog-db-num                     = p-tog-db-num
      868             ub.price-list-type.tog-id                         = p-tog-id
      869             ub.price-list-type.obj-turnover                   = p-obj-turnover
      870             ub.price-list-type.ttg-summa                      = p-ttg-summa
      871             ub.price-list-type.have-rs-turn-group             =   p-have-rs-turn-group
      872             ub.price-list-type.have-tog-db-num                =   p-have-tog-db-num
      873             ub.price-list-type.have-tog-id                    =   p-have-tog-id
      874             ub.price-list-type.use-cash-pay                   =   p-use-cash-pay
      875             ub.price-list-type.use-pay-type                   =   p-use-pay-type
      876             ub.price-list-type.stts                           = integer('0':U)
      877             ub.price-list-type.sys-date                       = today
      878             ub.price-list-type.sys-time                       = time
      879             ub.price-list-type.sys-time-chr                   = string ( ub.price-list-type.sys-time,"hh:mm" )
      880             ub.price-list-type.who                            = p-userid
      881             ub.price-list-type.db-num-chg                     = p-db-num-usr
      882             p-recid = recid ( ub.price-list-type )
      883         .
      884     if p-use-cassa < 3 then do:
      885        for each tt_cassa : delete tt_cassa . end.
      886     end.
      887     if p-use-gds-group = 0  then do:
      888        for each tt_grp : delete tt_grp . end.
      889     end.
      890     for each ub.price-list-type-gds-grp exclusive-lock where
      891              ub.price-list-type-gds-grp.plt-db-num  = p-db-num and
      892              ub.price-list-type-gds-grp.plt-id      = p-id :
      893          if not can-find (first  tt_grp where tt_grp.node-code = ub.price-list-type-gds-grp.node-code ) then
      894          ub.price-list-type-gds-grp.stts   = integer('1':U) .
      895     end.
      896     for each tt_grp :
      897         find first  ub.price-list-type-gds-grp exclusive-lock where
      898                 ub.price-list-type-gds-grp.node-code  = tt_grp.node-code and
      899                 ub.price-list-type-gds-grp.plt-db-num  = p-db-num and
      900                 ub.price-list-type-gds-grp.plt-id      = p-id no-error .
      901         if not available ub.price-list-type-gds-grp then do:
      902                create ub.price-list-type-gds-grp.
      903                 assign
      904                   ub.price-list-type-gds-grp.node-code  = tt_grp.node-code
      905                   ub.price-list-type-gds-grp.plt-db-num     = p-db-num
      906                   ub.price-list-type-gds-grp.plt-id         = p-id
      907                   ub.price-list-type-gds-grp.stts       = integer('0':U)
      908                   ub.price-list-type-gds-grp.sys-date     = today
      909                   ub.price-list-type-gds-grp.sys-time     = time
      910                   ub.price-list-type-gds-grp.sys-time-chr = string ( ub.price-list-type-gds-grp.sys-time,"hh:mm" )
      911                   ub.price-list-type-gds-grp.who          = p-userid
      912                   ub.price-list-type-gds-grp.db-num-chg   = p-db-num-usr
      913                 .
      914                end.
      915         else do:
      916            assign
      917             ub.price-list-type-gds-grp.stts   = integer('0':U)
      918             ub.price-list-type-gds-grp.sys-date     = today
      919             ub.price-list-type-gds-grp.sys-time     = time
      920             ub.price-list-type-gds-grp.sys-time-chr = string ( ub.price-list-type-gds-grp.sys-time,"hh:mm" )
      921             ub.price-list-type-gds-grp.who          = p-userid
      922             ub.price-list-type-gds-grp.db-num-chg   = p-db-num-usr
      923            .
      924         end.
      925     end.
      926     for each ub.price-list-type-cassa exclusive-lock where
      927              ub.price-list-type-cassa.plt-db-num  = p-db-num and
      928              ub.price-list-type-cassa.plt-id      = p-id :
      929          if not can-find (first tt_cassa where
      930                                 tt_cassa.cash-num = ub.price-list-type-cassa.cash-num and
      931                                 tt_cassa.obj-code = ub.price-list-type-cassa.obj-code and
      932                                 tt_cassa.pos-type = ub.price-list-type-cassa.pos-type
      933                                 ) then
      934          ub.price-list-type-cassa.stts   = integer('1':U)  .
      935     end.
      936     for each tt_cassa :
      937         find first  ub.price-list-type-cassa exclusive-lock where
      938                     ub.price-list-type-cassa.cash-num = tt_cassa.cash-num and
      939                     ub.price-list-type-cassa.obj-code = tt_cassa.obj-code and
      940                     ub.price-list-type-cassa.pos-type = tt_cassa.pos-type and
      941                     ub.price-list-type-cassa.plt-db-num        = p-db-num and
      942                     ub.price-list-type-cassa.plt-id            = p-id     no-error .
      943         if not available ub.price-list-type-cassa then do :
      944                create ub.price-list-type-cassa.
      945                 assign
      946                   ub.price-list-type-cassa.cash-num     = tt_cassa.cash-num
      947                   ub.price-list-type-cassa.obj-code     = tt_cassa.obj-code
      948                   ub.price-list-type-cassa.pos-type     = tt_cassa.pos-type
      949                   ub.price-list-type-cassa.plt-db-num   = p-db-num
      950                   ub.price-list-type-cassa.plt-id       = p-id
      951                   ub.price-list-type-cassa.stts         = integer('0':U)
      952                   ub.price-list-type-cassa.sys-date     = today
      953                   ub.price-list-type-cassa.sys-time     = time
      954                   ub.price-list-type-cassa.sys-time-chr = string ( ub.price-list-type-cassa.sys-time,"hh:mm" )
      955                   ub.price-list-type-cassa.who          = p-userid
      956                   ub.price-list-type-cassa.db-num-chg   = p-db-num-usr
      957                   ub.price-list-type-cassa.db-num       = p-db-num-usr
      958                 .
      959                end.
      960         else do:
      961            assign
      962             ub.price-list-type-cassa.stts   = integer('0':U)
      963             ub.price-list-type-cassa.sys-date     = today
      964             ub.price-list-type-cassa.sys-time     = time
      965             ub.price-list-type-cassa.sys-time-chr = string ( ub.price-list-type-cassa.sys-time,"hh:mm" )
      966             ub.price-list-type-cassa.who          = p-userid
      967             ub.price-list-type-cassa.db-num-chg   = p-db-num-usr
      968            .
      969         end.
      970     end.
      971     for each ub.price-list-type-pay-type exclusive-lock where
      972              ub.price-list-type-pay-type.plt-db-num  = p-db-num and
      973              ub.price-list-type-pay-type.plt-id      = p-id :
      974          if not can-find (first tt_pay-type where
      975                                 tt_pay-type.pay-code = ub.price-list-type-pay-type.pay-code
      976                                 ) then
      977          ub.price-list-type-pay-type.stts   = integer('1':U)  .
      978     end.
      979     for each tt_pay-type :
      980         find first  ub.price-list-type-pay-type exclusive-lock where
      981                     ub.price-list-type-pay-type.pay-code = tt_pay-type.pay-code and
      982                     ub.price-list-type-pay-type.plt-db-num        = p-db-num and
      983                     ub.price-list-type-pay-type.plt-id            = p-id     no-error .
      984         if not available ub.price-list-type-pay-type then do :
      985                create ub.price-list-type-pay-type.
      986                 assign
      987                   ub.price-list-type-pay-type.pay-code     = tt_pay-type.pay-code
      988                   ub.price-list-type-pay-type.plt-db-num   = p-db-num
      989                   ub.price-list-type-pay-type.plt-id       = p-id
      990                   ub.price-list-type-pay-type.stts         = integer('0':U)
      991                   ub.price-list-type-pay-type.sys-date     = today
      992                   ub.price-list-type-pay-type.sys-time     = time
      993                   ub.price-list-type-pay-type.sys-time-chr = string ( ub.price-list-type-pay-type.sys-time,"hh:mm" )
      994                   ub.price-list-type-pay-type.who          = p-userid
      995                   ub.price-list-type-pay-type.db-num-chg   = p-db-num-usr
      996                   ub.price-list-type-pay-type.db-num       = p-db-num-usr
      997                 .
      998                end.
      999         else do:
     1000            assign
     1001             ub.price-list-type-pay-type.stts   = integer('0':U)
     1002             ub.price-list-type-pay-type.sys-date     = today
     1003             ub.price-list-type-pay-type.sys-time     = time
     1004             ub.price-list-type-pay-type.sys-time-chr = string ( ub.price-list-type-pay-type.sys-time,"hh:mm" )
     1005             ub.price-list-type-pay-type.who          = p-userid
     1006             ub.price-list-type-pay-type.db-num-chg   = p-db-num-usr
     1007            .
     1008         end.
     1009     end.
     1010     for each ub.price-list-type-cash-pay exclusive-lock where
     1011              ub.price-list-type-cash-pay.plt-db-num  = p-db-num and
     1012              ub.price-list-type-cash-pay.plt-id      = p-id :
     1013          if not can-find (first tt_cash-pay where
     1014                                 tt_cash-pay.cdpay-code = ub.price-list-type-cash-pay.cdpay-code and
     1015                                 tt_cash-pay.curr-code  = ub.price-list-type-cash-pay.curr-code
     1016                                 ) then
     1017          ub.price-list-type-cash-pay.stts   = 1 .
     1018     end.
     1019     for each tt_cash-pay :
     1020         find first  ub.price-list-type-cash-pay exclusive-lock where
     1021                     ub.price-list-type-cash-pay.cdpay-code = tt_cash-pay.cdpay-code and
     1022                     ub.price-list-type-cash-pay.curr-code  = tt_cash-pay.curr-code and
     1023                     ub.price-list-type-cash-pay.plt-db-num        = p-db-num and
     1024                     ub.price-list-type-cash-pay.plt-id            = p-id     no-error .
     1025         if not available ub.price-list-type-cash-pay then do :
     1026                create ub.price-list-type-cash-pay.
     1027                 assign
     1028                   ub.price-list-type-cash-pay.cdpay-code     = tt_cash-pay.cdpay-code
     1029                   ub.price-list-type-cash-pay.curr-code     = tt_cash-pay.curr-code
     1030                   ub.price-list-type-cash-pay.plt-db-num   = p-db-num
     1031                   ub.price-list-type-cash-pay.plt-id       = p-id
     1032                   ub.price-list-type-cash-pay.stts         = integer('0':U)
     1033                   ub.price-list-type-cash-pay.sys-date     = today
     1034                   ub.price-list-type-cash-pay.sys-time     = time
     1035                   ub.price-list-type-cash-pay.sys-time-chr = string ( ub.price-list-type-cash-pay.sys-time,"hh:mm" )
     1036                   ub.price-list-type-cash-pay.who          = p-userid
     1037                   ub.price-list-type-cash-pay.db-num-chg   = p-db-num-usr
     1038                   ub.price-list-type-cash-pay.db-num       = p-db-num-usr
     1039                 .
     1040                end.
     1041         else do:
     1042            assign
     1043             ub.price-list-type-cash-pay.stts   = integer('0':U)
     1044             ub.price-list-type-cash-pay.sys-date     = today
     1045             ub.price-list-type-cash-pay.sys-time     = time
     1046             ub.price-list-type-cash-pay.sys-time-chr = string ( ub.price-list-type-cash-pay.sys-time,"hh:mm" )
     1047             ub.price-list-type-cash-pay.who          = p-userid
     1048             ub.price-list-type-cash-pay.db-num-chg   = p-db-num-usr
     1049            .
     1050         end.
     1051     end.
     1052     end.
     1053   end procedure.
     1054   PROCEDURE type-price-list-delete :
     1055   define input  parameter p-db-num       as integer   no-undo .
     1056   define input  parameter p-id           as integer   no-undo .
     1057   define input  parameter p-db-num-usr   as integer   no-undo .
     1058   define input  parameter p-userid       as character no-undo .
     1059   define buffer child_price-list-type for ub.price-list-type  .
     1060     do
     1061     on error undo, return error return-value
     1062     :
     1063   find first ub.price-list-type exclusive-lock where
     1064           ub.price-list-type.plt-db-num   = p-db-num  and
     1065           ub.price-list-type.plt-id       = p-id
     1066           no-error .
     1067    if not available ub.price-list-type then  return error .
     1068    if ub.price-list-type.ban-discnt > 0 then do:
     1069    define buffer buf_dis-rule for ub.dis-rule  .
     1070    find first buf_dis-rule no-lock where
     1071               buf_dis-rule.templ-rl-root = ub.price-list-type.ban-discnt and
     1072               buf_dis-rule.charkey_one   = substitute("&1-&2", ub.price-list-type.plt-id, ub.price-list-type.plt-db-num)
     1073               no-error .
     1074        if available buf_dis-rule then do:
     1075           message  substitute
     1076             ( "Удалить этот тип нельзя, так как есть ссылка на ПРАВИЛО СКИДОК &1 &2" ,
     1077                ub.price-list-type.ban-discnt  ,
     1078                buf_dis-rule.des
     1079               ) view-as alert-box error .
     1080           return .
     1081        end.
     1082    end.
     1083    find first ub.price-doc-forming no-lock where
     1084               ub.price-doc-forming.plt-id = ub.price-list-type.plt-id and
     1085               ub.price-doc-forming.plt-db-num = ub.price-list-type.plt-db-num and
     1086               ub.price-doc-forming.stts = integer('0':U) no-error .
     1087    if available ub.price-doc-forming then do:
     1088           message "Удалить этот тип нельзя, так как есть незакрытые ДНЦ " ub.price-doc-forming.pdf-id "БД:" ub.price-doc-forming.pdf-db
     1089           view-as alert-box error .
     1090           return .
     1091    end.
     1092         assign
     1093           ub.price-list-type.db-num-chg    = p-db-num-usr
     1094           ub.price-list-type.stts          = integer('1':U)
     1095           ub.price-list-type.sys-date      = today
     1096           ub.price-list-type.sys-time      = time
     1097           ub.price-list-type.sys-time-chr  = string ( ub.price-list-type.sys-time,"hh:mm" )
     1098           ub.price-list-type.who           = p-userid
     1099         .
     1100         for each child_price-list-type exclusive-lock where
     1101                  child_price-list-type.plt-main-db-num = p-db-num  and
     1102                  child_price-list-type.plt-main-id     = p-id
     1103                  :
     1104               assign
     1105                 child_price-list-type.db-num-chg    = p-db-num-usr
     1106                 child_price-list-type.stts          = integer('1':U)
     1107                 child_price-list-type.sys-date      = today
     1108                 child_price-list-type.sys-time      = time
     1109                 child_price-list-type.sys-time-chr  = string ( child_price-list-type.sys-time , "hh:mm" )
     1110                 child_price-list-type.who           = p-userid
     1111               .
     1112         end.
     1113     end.
     1114   end procedure.
     1115   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1116   define temp-table x_obj-group no-undo like ub.clients  .
     1117   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
     1118   procedure metod-gop-obj :
     1119     do
     1120     on error undo, return error return-value
     1121     :
     1122   define input  parameter p-cntxt-db-num as integer   no-undo .
     1123   define input  parameter p-gop-id       as integer   no-undo .
     1124   define input  parameter p-gop-db-num   as integer   no-undo .
     1125   define buffer buf1_clients for ub.clients  .
     1126   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
     1127   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
     1128   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
     1129   for each  x_obj-group : delete x_obj-group. end.
     1130   if p-gop-id = 0 or p-gop-id = ?  then do:
     1131      if p-cntxt-db-num = 0  then do:
     1132           for each buf1_clients no-lock where
     1133                   (buf1_clients.obj-type = 'маг':U  or
     1134                    buf1_clients.obj-type = 'скл':U  )
     1135                   and
     1136                   buf1_clients.db-num >= 0  and
     1137                   buf1_clients.stts = 0
     1138                   :
     1139             create x_obj-group .
     1140             assign
     1141               x_obj-group.obj-code   = buf1_clients.obj-code
     1142               x_obj-group.obj-type   = buf1_clients.obj-type
     1143               x_obj-group.obj-name   = buf1_clients.obj-name
     1144               x_obj-group.db-num     = buf1_clients.db-num
     1145             .
     1146           end.
     1147      end.
     1148      else do:
     1149           for each buf1_clients no-lock where
     1150                   (buf1_clients.obj-type = 'маг':U  or
     1151                    buf1_clients.obj-type = 'скл':U  ) and
     1152                    buf1_clients.db-num = p-cntxt-db-num  and
     1153                    buf1_clients.stts = 0
     1154                   :
     1155             create x_obj-group .
     1156             assign
     1157               x_obj-group.obj-code   = buf1_clients.obj-code
     1158               x_obj-group.obj-type   = buf1_clients.obj-type
     1159               x_obj-group.obj-name   = buf1_clients.obj-name
     1160               x_obj-group.db-num     = buf1_clients.db-num
     1161             .
     1162           end.
     1163      end.
     1164   end.
     1165   else do:
     1166         for each buf_db-grp-obj-price  where
     1167                 buf_db-grp-obj-price.gop-id     = p-gop-id and
     1168                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
     1169                 buf_db-grp-obj-price.stts = 0  no-lock :
     1170           for each buf1_clients no-lock where
     1171                  (buf1_clients.obj-type = 'маг':U  or
     1172                   buf1_clients.obj-type = 'скл':U  ) and
     1173                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
     1174                   buf1_clients.stts = 0
     1175                   :
     1176             create x_obj-group .
     1177             assign
     1178               x_obj-group.obj-code   = buf1_clients.obj-code
     1179               x_obj-group.obj-type   = buf1_clients.obj-type
     1180               x_obj-group.obj-name   = buf1_clients.obj-name
     1181               x_obj-group.db-num     = buf1_clients.db-num
     1182             .
     1183           end.
     1184         end.
     1185       for each buf_host-grp-obj-price where
     1186               buf_host-grp-obj-price.gop-id     = p-gop-id and
     1187               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
     1188               buf_host-grp-obj-price.stts = 0
     1189               no-lock :
     1190         for each buf1_clients no-lock where
     1191                (buf1_clients.obj-type = 'маг':U  or
     1192                 buf1_clients.obj-type = 'скл':U  ) and
     1193                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
     1194                 buf1_clients.stts = 0
     1195                 :
     1196             find first x_obj-group no-lock  where
     1197                       x_obj-group.obj-code   = buf1_clients.obj-code and
     1198                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
     1199             if not available  x_obj-group then   create x_obj-group .
     1200             assign
     1201               x_obj-group.obj-code   = buf1_clients.obj-code
     1202               x_obj-group.obj-type   = buf1_clients.obj-type
     1203               x_obj-group.obj-name   = buf1_clients.obj-name
     1204               x_obj-group.db-num     = buf1_clients.db-num
     1205             .
     1206         end.
     1207       end.
     1208       for each buf_obj-grp-obj-price where
     1209               buf_obj-grp-obj-price.gop-id     = p-gop-id and
     1210               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
     1211               buf_obj-grp-obj-price.stts = 0
     1212               no-lock :
     1213         for each buf1_clients no-lock where
     1214                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
     1215                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
     1216                   buf1_clients.stts     = 0
     1217                   :
     1218             find first  x_obj-group no-lock  where
     1219                         x_obj-group.obj-code   = buf1_clients.obj-code and
     1220                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
     1221             if not available  x_obj-group then   create x_obj-group .
     1222             assign
     1223               x_obj-group.obj-code   = buf1_clients.obj-code
     1224               x_obj-group.obj-type   = buf1_clients.obj-type
     1225               x_obj-group.obj-name   = buf1_clients.obj-name
     1226               x_obj-group.db-num     = buf1_clients.db-num
     1227             .
     1228         end.
     1229       end.
     1230   end.
     1231   end.
     1232   end procedure.
     1233   procedure metod-obj-in-gop :
     1234   define input  parameter p-curr-db-num as integer   no-undo .
     1235   define input  parameter p-obj-type as character no-undo .
     1236   define input  parameter p-obj-code as integer   no-undo .
     1237   define buffer buf_grp-obj-price for ub.grp-obj-price  .
     1238     do
     1239     on error undo, return error return-value
     1240     :
     1241       empty temp-table x_grp-obj-price.
     1242       for each buf_grp-obj-price where
     1243                buf_grp-obj-price.stts = 0
     1244                no-lock :
     1245                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
     1246                  for each x_obj-group where
     1247                           x_obj-group.obj-type = p-obj-type and
     1248                           x_obj-group.obj-code = p-obj-code :
     1249                       create  x_grp-obj-price.
     1250                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
     1251                  end.
     1252       end.
     1253     end.
     1254   end procedure.
     1255   procedure metod-delobj-usr :
     1256   define input  parameter p-pdf-id  as integer   no-undo .
     1257   define input  parameter p-pdf-db  as integer   no-undo .
     1258   define input  parameter p-plt-id  as integer   no-undo .
     1259   define input  parameter p-plt-db-num as integer   no-undo .
     1260   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
     1261     do
     1262     on error undo, return error return-value
     1263     :
     1264   for each buf_price-doc-forming-attr no-lock  where
     1265            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
     1266            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
     1267            buf_price-doc-forming-attr.plt-id =     p-plt-id and
     1268            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
     1269            buf_price-doc-forming-attr.attr-code begins "obj" :
     1270      for each x_obj-group  where
     1271               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
     1272               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
     1273        delete x_obj-group.
     1274      end.
     1275   end.
     1276     if not can-find (first x_obj-group) then do:
     1277        return "nullobj" .
     1278     end.
     1279   end.
     1280   end procedure.
     1281   procedure metod-obj-pdf :
     1282   define input  parameter p-cntxt-db-num as integer   no-undo .
     1283   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
     1284   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
     1285   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
     1286   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
     1287   define buffer buf_price-list-type for ub.price-list-type  .
     1288   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     1289     do
     1290     on error undo, return error return-value
     1291     :
     1292    for each  x_obj-group : delete x_obj-group. end.
     1293    find first buf_price-list-type no-lock where
     1294               buf_price-list-type.plt-id = p-plt-id and
     1295               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
     1296   if error-status :error then return error return-value .
     1297    find first buf_price-doc-forming no-lock where
     1298               buf_price-doc-forming.plt-id     = p-plt-id and
     1299               buf_price-doc-forming.plt-db-num = p-plt-db-num and
     1300               buf_price-doc-forming.pdf-id     = p-pdf-id and
     1301               buf_price-doc-forming.pdf-db     = p-pdf-db-num
     1302               no-error .
     1303   if error-status :error then return error return-value .
     1304     run metod-gop-obj in this-procedure (
     1305         p-cntxt-db-num,
     1306         buf_price-list-type.gop-id ,
     1307         buf_price-list-type.gop-db-num
     1308         ) no-error .
     1309     run metod-delobj-usr in this-procedure (
     1310       buf_price-doc-forming.pdf-id ,
     1311       buf_price-doc-forming.pdf-db ,
     1312       buf_price-doc-forming.plt-id ,
     1313       buf_price-doc-forming.plt-db-num
     1314       ) no-error .
     1315     end.
     1316   end procedure.
     1317   define variable v-rec-list-cli as character no-undo .
     1318   define variable g-log  as logical   no-undo .
     1319   define variable v-name as character no-undo .
     1320   define variable v-a    as logical   no-undo .
     1321   define variable varlog as logical   no-undo .
     1322   define buffer ch_price-list-type for ub.price-list-type  .
     1323   define variable r-plt        as integer   no-undo init 2 .
     1324   define variable r-ban-discnt as integer   no-undo init 0.
     1325   define variable v-bg-color   as integer   no-undo .
     1326   define variable v-fg-color   as integer   no-undo .
     1327   function mark-string returns character
     1328     ( buffer loc-table for ub.price-list-type, input mark-list as character  ) :
     1329     return ( if lookup( string( recid( loc-table ) ), mark-list ) > 0 then "*" else "":U ).
     1330   end function.
     1331   function stts-string returns character
     1332     ( buffer loc-table for ub.price-list-type   ) :
     1333   return entry (lookup (string(loc-table.stts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) .
     1334   end function.
     1335   function activ-pr returns character
     1336     ( buffer loc-table for ub.price-list-type  ) :
     1337     define buffer b_price-all for ub.price-all  .
     1338     find first b_price-all no-lock where
     1339                b_price-all.plt-db-num = loc-table.plt-db-num and
     1340                b_price-all.plt-id     = loc-table.plt-id and
     1341                b_price-all.status_    = 'акт':U
     1342                no-error .
     1343     if available b_price-all then return "+".
     1344     else return "".
     1345   end function.
     1346   function name-pl returns character
     1347     ( buffer loc-table for ub.price-list-type  ) :
     1348     case loc-table.under-type-list :
     1349         when ? then do:
     1350           return ( loc-table.NAME ) .
     1351         end.
     1352         when 0 then do:
     1353           return ( loc-table.name ) .
     1354         end.
     1355         when 1 then do:
     1356           return (  "-> " + loc-table.name ) .
     1357         end.
     1358     end case.
     1359   end function.
     1360   define variable ref-rec as recid no-undo.
     1361   define variable loc_gop-id     as integer   no-undo .
     1362   define variable loc_tog-id     as integer   no-undo .
     1363   define variable loc_bgr-id     as integer   no-undo .
     1364   define variable loc_gop-db-num as integer   no-undo .
     1365   define variable loc_tog-db-num as integer   no-undo .
     1366   define variable loc_bgr-db-num as integer   no-undo .
     1367   define variable loc_plt-recid  as character no-undo .
     1368   define buffer buf_buyer-group    for ub.buyer-group  .
     1369   define buffer buf_turnover-group for ub.turnover-group  .
     1370   define buffer buf_grp-obj-price  for ub.grp-obj-price  .
     1371   define variable is-color as logical   no-undo .
     1372   DEFINE QUERY external_tables FOR buf_price-list-type.
     1373   DEFINE BUTTON B-add
     1374        LABEL "Добавить"
     1375        SIZE 10 BY 1 TOOLTIP "Добавить тип ПЛ"
     1376        BGCOLOR 8 .
     1377   DEFINE BUTTON B-add-M
     1378        IMAGE-UP FILE "cmp/add-gtpl.bmp":U
     1379        LABEL "Добавить ГТПЛ"
     1380        SIZE 20 BY 1 TOOLTIP "Добавить главный тип прайс-листа"
     1381        BGCOLOR 4 FGCOLOR 15 .
     1382   DEFINE BUTTON B-Cancel AUTO-END-KEY
     1383        LABEL "Выход"
     1384        SIZE 10 BY 1
     1385        BGCOLOR 8 .
     1386   DEFINE BUTTON B-chg
     1387        LABEL "Изменить"
     1388        SIZE 10 BY 1
     1389        BGCOLOR 8 .
     1390   DEFINE BUTTON B-color
     1391        IMAGE-UP FILE "cmp/color.bmp":U
     1392        IMAGE-DOWN FILE "cmp/color.bmp":U
     1393        IMAGE-INSENSITIVE FILE "cmp/color.bmp":U
     1394        LABEL ""
     1395        SIZE 3 BY 1 TOOLTIP "Цветовое выделение на экране".
     1396   DEFINE BUTTON B-del
     1397        LABEL "Удалить"
     1398        SIZE 10 BY 1 TOOLTIP "Удалить ТПЛ"
     1399        BGCOLOR 8 .
     1400   DEFINE BUTTON B-del-pr
     1401        LABEL "Удалить цены"
     1402        SIZE 15 BY 1
     1403        BGCOLOR 8 .
     1404   DEFINE BUTTON B-Help
     1405        LABEL "Помо&щь"
     1406        SIZE 3 BY 1
     1407        BGCOLOR 8 .
     1408   DEFINE BUTTON B-history
     1409        LABEL "История"
     1410        SIZE 3 BY 1 TOOLTIP "История изменения справочника"
     1411        BGCOLOR 8 .
     1412   DEFINE BUTTON B-lkp
     1413        LABEL "Просмотр"
     1414        SIZE 10 BY 1
     1415        BGCOLOR 8 .
     1416   DEFINE BUTTON B-mark
     1417        LABEL "*"
     1418        SIZE 3.25 BY 1 TOOLTIP "Отметить ТПЛ"
     1419        BGCOLOR 8 .
     1420   DEFINE BUTTON B-price-doc
     1421        LABEL "ДНЦ"
     1422        SIZE 13.5 BY 1 TOOLTIP "Документы назначения цены"
     1423        BGCOLOR 8 .
     1424   DEFINE BUTTON B-price-lists
     1425        LABEL "Переоценки"
     1426        SIZE 15 BY 1
     1427        BGCOLOR 8 .
     1428   DEFINE BUTTON B-print
     1429        LABEL "Печать"
     1430        SIZE 3 BY 1 TOOLTIP "Печать справочника"
     1431        BGCOLOR 8 .
     1432   DEFINE BUTTON B-sel AUTO-GO
     1433        LABEL "Выбор"
     1434        SIZE 10 BY 1
     1435        BGCOLOR 8 .
     1436   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Статус:"
     1437         VIEW-AS TEXT
     1438        SIZE 7.5 BY .67
     1439        FGCOLOR 4  NO-UNDO.
     1440   DEFINE VARIABLE FILL-IN-2 AS CHARACTER FORMAT "X(256)":U INITIAL "Объекты:"
     1441         VIEW-AS TEXT
     1442        SIZE 8.5 BY .67
     1443        FGCOLOR 4  NO-UNDO.
     1444   DEFINE VARIABLE FILL-IN-6 AS CHARACTER FORMAT "X(256)":U INITIAL "Поиск Код ТПЛ:"
     1445         VIEW-AS TEXT
     1446        SIZE 14.5 BY 1
     1447        FGCOLOR 4  NO-UNDO.
     1448   DEFINE VARIABLE FILL-IN-7 AS CHARACTER FORMAT "X(256)":U INITIAL "Тип:"
     1449         VIEW-AS TEXT
     1450        SIZE 4 BY .67
     1451        FGCOLOR 4  NO-UNDO.
     1452   DEFINE VARIABLE FILL-IN-8 AS CHARACTER FORMAT "X(256)":U INITIAL "Распространение"
     1453         VIEW-AS TEXT
     1454        SIZE 16 BY .67
     1455        FGCOLOR 1  NO-UNDO.
     1456   DEFINE VARIABLE FILL-IN-buy AS CHARACTER FORMAT "X(256)":U INITIAL "Покупатели:"
     1457         VIEW-AS TEXT
     1458        SIZE 11 BY .67
     1459        FGCOLOR 4  NO-UNDO.
     1460   DEFINE VARIABLE FILL-IN-tog AS CHARACTER FORMAT "X(256)":U INITIAL "Обороты:"
     1461         VIEW-AS TEXT
     1462        SIZE 8.5 BY .67
     1463        FGCOLOR 4  NO-UNDO.
     1464   DEFINE VARIABLE loc_bgr_name AS CHARACTER FORMAT "X(256)":U
     1465         VIEW-AS TEXT
     1466        SIZE 33 BY .67
     1467        FGCOLOR 1 FONT 4 NO-UNDO.
     1468   DEFINE VARIABLE loc_gop_name AS CHARACTER FORMAT "X(256)":U
     1469         VIEW-AS TEXT
     1470        SIZE 28.5 BY .67
     1471        FGCOLOR 1 FONT 4 NO-UNDO.
     1472   DEFINE VARIABLE loc_tog_name AS CHARACTER FORMAT "X(256)":U
     1473         VIEW-AS TEXT
     1474        SIZE 33 BY .67
     1475        FGCOLOR 1 FONT 4 NO-UNDO.
     1476   DEFINE VARIABLE v-id AS INTEGER FORMAT ">>>>>>>>>9":U INITIAL 0
     1477        VIEW-AS FILL-IN
     1478        SIZE 14 BY 1 TOOLTIP "Поиск по коду типа прайс-листа" NO-UNDO.
     1479   DEFINE VARIABLE v-user-name AS CHARACTER FORMAT "X(256)":U
     1480        LABEL "Опер"
     1481         VIEW-AS TEXT
     1482        SIZE 15 BY .67 TOOLTIP "Последний корректировал"
     1483        FGCOLOR 4  NO-UNDO.
     1484   DEFINE VARIABLE R-avtop AS INTEGER
     1485        VIEW-AS RADIO-SET HORIZONTAL
     1486        RADIO-BUTTONS
     1487             "Все", 2,
     1488   "Автопереоценки", 1,
     1489   "Ручные", 0
     1490        SIZE 33 BY .67 NO-UNDO.
     1491   DEFINE VARIABLE R-buyer AS INTEGER INITIAL 2
     1492        VIEW-AS RADIO-SET HORIZONTAL
     1493        RADIO-BUTTONS
     1494             "Все", 2,
     1495   "Группа", 1
     1496        SIZE 16 BY .67 TOOLTIP "Выбор по группам покупателей" NO-UNDO.
     1497   DEFINE VARIABLE R-main AS INTEGER
     1498        VIEW-AS RADIO-SET HORIZONTAL
     1499        RADIO-BUTTONS
     1500             "Все", 2,
     1501   "Главный", 1,
     1502   "Неглавный", 0
     1503        SIZE 29 BY .67 NO-UNDO.
     1504   DEFINE VARIABLE R-obj AS INTEGER INITIAL 2
     1505        VIEW-AS RADIO-SET HORIZONTAL
     1506        RADIO-BUTTONS
     1507             "Все", 2,
     1508   "Тек", 3,
     1509   "Группа", 1
     1510        SIZE 19.63 BY .67 TOOLTIP "Выбор по группам объектов" NO-UNDO.
     1511   DEFINE VARIABLE R-status AS INTEGER
     1512        VIEW-AS RADIO-SET HORIZONTAL
     1513        RADIO-BUTTONS
     1514             "Текущие", 0,
     1515   "Все", 2,
     1516   "Удаленные", 1
     1517        SIZE 30.5 BY .67 TOOLTIP "Условие отбора записей" NO-UNDO.
     1518   DEFINE VARIABLE R-tog AS INTEGER INITIAL 2
     1519        VIEW-AS RADIO-SET HORIZONTAL
     1520        RADIO-BUTTONS
     1521             "Все", 2,
     1522   "Группа", 1
     1523        SIZE 16 BY .67 TOOLTIP "Выбор по группам оборотов покупателей" NO-UNDO.
     1524   DEFINE QUERY BROWSE-1grp FOR
     1525                buf_price-list-type ,
     1526                x_grp-obj-price
     1527                SCROLLING.
     1528   DEFINE BROWSE BROWSE-1grp
     1529     QUERY BROWSE-1grp NO-LOCK DISPLAY
     1530         mark-string(buffer buf_price-list-type, p-rec-list) COLUMN-LABEL "*! " FORMAT "x(1)":U
     1531         stts-string(buffer buf_price-list-type) COLUMN-LABEL "Ста!тус" FORMAT "x(3)":U
     1532         buf_price-list-type.plt-id COLUMN-LABEL "Код! " FORMAT ">>>>>9":U
     1533         buf_price-list-type.main COLUMN-LABEL "Г! "  FORMAT "+/ ":U
     1534         logical(buf_price-list-type.only-gbd) @ v-a COLUMN-LABEL "А! " FORMAT "+/ ":U
     1535         name-pl(buffer buf_price-list-type) @ v-name COLUMN-LABEL "Название типа прайс-листа! " FORMAT "X(100)":U
     1536         WIDTH 36
     1537         activ-pr(buffer buf_price-list-type) COLUMN-LABEL "Есть!цены"            FORMAT "x(4)":U
     1538         buf_price-list-type.priority  COLUMN-LABEL 'Прио!ритет'  FORMAT ">>9":U
     1539         buf_price-list-type.sys-date     COLUMN-LABEL "Дата!изм"  FORMAT "99/99/99":U
     1540         buf_price-list-type.sys-time-chr COLUMN-LABEL "Время!изм" FORMAT "X(5)":U
     1541         buf_price-list-type.db-num-chg   COLUMN-LABEL "БД!изм"    FORMAT ">>>>9":U
     1542         buf_price-list-type.plt-db-num FORMAT ">>>>9":U
     1543         buf_price-list-type.plt-main-id  COLUMN-LABEL "Родитель!  " FORMAT ">>>>>9":U
     1544         buf_price-list-type.plt-main-db-num COLUMN-LABEL "БД!РПЛ"    FORMAT ">>>>9":U
     1545         buf_price-list-type.ban-discnt COLUMN-LABEL "Шаблон!скидки"  FORMAT ">>>>>9":U
     1546     ENABLE
     1547         buf_price-list-type.plt-id
     1548       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.63 BY 16 FIT-LAST-COLUMN.
     1549   DEFINE FRAME Dialog-Frame
     1550        B-Cancel AT ROW 1 COL 1
     1551        B-mark AT ROW 1 COL 11
     1552        B-sel AT ROW 1 COL 14.25
     1553        B-add-M AT ROW 1 COL 24.25
     1554        B-add AT ROW 1 COL 44.25
     1555        B-lkp AT ROW 1 COL 54.25
     1556        B-chg AT ROW 1 COL 64.25
     1557        B-del AT ROW 1 COL 74.25
     1558        B-print AT ROW 1 COL 91
     1559        B-history AT ROW 1 COL 94
     1560        B-Help AT ROW 1 COL 97
     1561        B-price-doc AT ROW 2 COL 1
     1562        B-price-lists AT ROW 2 COL 14.5
     1563        B-del-pr AT ROW 2 COL 29.5
     1564        B-color AT ROW 2 COL 97
     1565        R-status AT ROW 3.17 COL 9.5 NO-LABEL
     1566        R-obj AT ROW 3.17 COL 50.88 NO-LABEL
     1567        R-buyer AT ROW 3.83 COL 50.88 NO-LABEL
     1568        R-main AT ROW 3.88 COL 9.5 NO-LABEL
     1569        R-avtop AT ROW 4.54 COL 5.5 NO-LABEL WIDGET-ID 6
     1570        R-tog AT ROW 4.58 COL 50.88 NO-LABEL
     1571        v-id AT ROW 5.21 COL 14.13 COLON-ALIGNED NO-LABEL
     1572        BROWSE-1grp AT ROW 6.25 COL 1.5
     1573        FILL-IN-8 AT ROW 2.46 COL 49 COLON-ALIGNED NO-LABEL WIDGET-ID 4
     1574        FILL-IN-2 AT ROW 3.13 COL 42.13 NO-LABEL
     1575        FILL-IN-1 AT ROW 3.17 COL 1.88 NO-LABEL
     1576        loc_gop_name AT ROW 3.17 COL 69 COLON-ALIGNED NO-LABEL
     1577        FILL-IN-buy AT ROW 3.79 COL 39.13 NO-LABEL
     1578        FILL-IN-7 AT ROW 3.88 COL 4.88 NO-LABEL
     1579        loc_bgr_name AT ROW 3.92 COL 64.5 COLON-ALIGNED NO-LABEL
     1580        FILL-IN-tog AT ROW 4.54 COL 42 NO-LABEL
     1581        loc_tog_name AT ROW 4.63 COL 64.5 COLON-ALIGNED NO-LABEL
     1582        FILL-IN-6 AT ROW 5.13 COL 1.5 NO-LABEL
     1583        v-user-name AT ROW 22.33 COL 5.75 COLON-ALIGNED WIDGET-ID 2
     1584        SPACE(77.63) SKIP(0.13)
     1585       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1586            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1587            TITLE "Справочник Типов прайс-листов"
     1588            DEFAULT-BUTTON B-sel CANCEL-BUTTON B-Cancel.
     1589   ASSIGN
     1590          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1591          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1592   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1593   DO:
     1594     APPLY "END-ERROR":U TO SELF.
     1595   END.
     1596   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1597   DO:
     1598     define variable v-rec-id as recid no-undo .
     1599     run ref/tp-price.w ( input parparentproc , false ,  input 'ДОБАВЛЕНИЕ':U , input-output v-rec-id ) .
     1600     run openbr .
     1601     reposition BROWSE-1grp to recid v-rec-id no-error .
     1602   END.
     1603   ON CHOOSE OF B-add-M IN FRAME Dialog-Frame
     1604   DO:
     1605     define variable v-rec-id as recid no-undo .
     1606     run ref/tp-price.w ( input parparentproc, input TRUE ,  input 'ДОБАВЛЕНИЕ':U , input-output v-rec-id ) .
     1607     run openbr .
     1608     reposition BROWSE-1grp to recid v-rec-id no-error .
     1609   END.
     1610   ON CHOOSE OF B-Cancel IN FRAME Dialog-Frame
     1611   DO:
     1612     run uf-set in this-procedure(
     1613      input 'color-p':U
     1614     ,input v-cntxt-userid
     1615     ,input string(is-color)
     1616     ,input v-uf-Naim
     1617     ,input v-uf-print-graft
     1618     ,input v-uf-sort-gr
     1619     ,input v-uf-type-price
     1620     ,input v-uf-type-val
     1621     ) no-error    .
     1622     if error-status :error then .
     1623     run uf-set in this-procedure(
     1624      input 'tpl-mode-p':U
     1625     ,input v-cntxt-userid
     1626     ,input string(r-main) + chr(4) + string(r-obj) + chr(4) + string(r-avtop) + chr(4)
     1627     ,input v-uf-Naim
     1628     ,input v-uf-print-graft
     1629     ,input v-uf-sort-gr
     1630     ,input v-uf-type-price
     1631     ,input v-uf-type-val
     1632     ) no-error    .
     1633     if error-status :error then .
     1634   END.
     1635   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1636   DO:
     1637     if not available buf_price-list-type then return .
     1638     if buf_price-list-type.stts <> integer('0':U) then do:
     1639        message "Статус УДАЛЕН - изменять нельзя " view-as alert-box information .
     1640        return .
     1641     end.
     1642     if buf_price-list-type.plt-db-num <>  v-cntxt-db-num then do:
     1643        message "Нельзя изменять прайс-лист чужой БД!" view-as alert-box information .
     1644        return .
     1645     end.
     1646     define variable v-rec-id as recid no-undo .
     1647     v-rec-id = recid(buf_price-list-type) .
     1648     run ref/tp-price.w (input parparentproc, buf_price-list-type.main , input 'ИЗМЕНЕНИЕ':U , input-output v-rec-id) .
     1649     run openbr .
     1650     reposition BROWSE-1grp to recid v-rec-id no-error .
     1651   END.
     1652   ON CHOOSE OF B-color IN FRAME Dialog-Frame
     1653   DO:
     1654     if B-color:IMAGE  = "cmp/nocol.bmp" then
     1655     do:
     1656       B-color:LOAD-IMAGE-UP("cmp/color.bmp") in frame Dialog-Frame  .
     1657       is-color = true .
     1658       run openbr .
     1659     end.
     1660     else do:
     1661        B-color:LOAD-IMAGE-UP("cmp/nocol.bmp") in frame Dialog-Frame  .
     1662        is-color = false  .
     1663        run openbr .
     1664     end.
     1665   END.
     1666   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1667   DO:
     1668   if not available buf_price-list-type then return .
     1669   define variable g#log as logical   no-undo .
     1670      if buf_price-list-type.main then do:
     1671   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1672   do:
     1673     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1674       (input  v-cntxt-db-num
     1675       ,input  v-cntxt-userid
     1676       ,input  0
     1677       ,input  'actn_global-tpl-mpl_delete':U
     1678       ,input  'global':U
     1679       ,input  v-cntxt-host-code-obj
     1680       ,input  v-cntxt-obj-type
     1681       ,input  v-cntxt-obj-code
     1682       ,input  0
     1683       ,input  0
     1684       ,input  0
     1685       ,input  true
     1686       ,output g#log
     1687       )  .
     1688   end.
     1689      end.
     1690      else do:
     1691   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1692   do:
     1693     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1694       (input  v-cntxt-db-num
     1695       ,input  v-cntxt-userid
     1696       ,input  0
     1697       ,input  'actn_tpl-mpl_delete':U
     1698       ,input  'global':U
     1699       ,input  v-cntxt-host-code-obj
     1700       ,input  v-cntxt-obj-type
     1701       ,input  v-cntxt-obj-code
     1702       ,input  0
     1703       ,input  0
     1704       ,input  0
     1705       ,input  true
     1706       ,output g#log
     1707       )  .
     1708   end.
     1709      end.
     1710   if not g#log then return .
     1711     if buf_price-list-type.stts <> integer('0':U) then do:
     1712        message "Уже удален!" view-as alert-box information .
     1713        return .
     1714     end.
     1715     if buf_price-list-type.plt-db-num <>  v-cntxt-db-num then do:
     1716        message "Нельзя удалять прайс-лист чужой БД!" view-as alert-box information .
     1717        return .
     1718     end.
     1719     message "Удалять тип прайс-листов: " buf_price-list-type.name "?"
     1720             view-as alert-box question
     1721             buttons yes-no update g-ok as log.
     1722     if not g-ok then return .
     1723   run type-price-list-DELETE (
     1724         buf_price-list-type.plt-db-num ,
     1725         buf_price-list-type.plt-id     ,
     1726         v-cntxt-db-num                 ,
     1727         v-cntxt-userid                 )
     1728         no-error .
     1729    if error-status :error then return no-apply .
     1730    run openbr .
     1731   END.
     1732   ON CHOOSE OF B-del-pr IN FRAME Dialog-Frame
     1733   DO:
     1734      define variable g#log as logical   no-undo .
     1735   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1736   do:
     1737     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1738       (input  v-cntxt-db-num
     1739       ,input  v-cntxt-userid
     1740       ,input  0
     1741       ,input  'actn_mpl-price_delete':U
     1742       ,input  'global':U
     1743       ,input  v-cntxt-host-code-obj
     1744       ,input  v-cntxt-obj-type
     1745       ,input  v-cntxt-obj-code
     1746       ,input  0
     1747       ,input  0
     1748       ,input  0
     1749       ,input  true
     1750       ,output g#log
     1751       )  .
     1752   end.
     1753     if not g#log then return .
     1754     if not available buf_price-list-type then return .
     1755     if buf_price-list-type.main then do:
     1756        message "Удалять цены по главному типу прайс-листов нельзя !" view-as alert-box error .
     1757        return .
     1758     end.
     1759     if buf_price-list-type.plt-db-num <>  v-cntxt-db-num then do:
     1760        message "Нельзя удалять прайс-лист чужой БД!" view-as alert-box information .
     1761        return .
     1762     end.
     1763     message "Удалять цены по типу прайс-листов: " buf_price-list-type.name "?"
     1764             view-as alert-box question
     1765             buttons yes-no update g-ok as log.
     1766     if not g-ok then return .
     1767     run ref/del-pdf.p ( parparentproc , buf_price-list-type.plt-id, buf_price-list-type.plt-db-num ) .
     1768     g-log = browse-1grp:refresh() .
     1769   END.
     1770   ON CHOOSE OF B-history IN FRAME Dialog-Frame
     1771   DO:
     1772     if not available buf_price-list-type then return .
     1773     run ref/c-tp-pl.w (
     1774         parParentProc ,
     1775         buf_price-list-type.plt-id ,
     1776         buf_price-list-type.plt-db-num ) .
     1777   END.
     1778   ON CHOOSE OF B-lkp IN FRAME Dialog-Frame
     1779   DO:
     1780     if not available buf_price-list-type then return .
