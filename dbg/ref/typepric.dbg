     1787   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1788   DO:
     1789       if available buf_price-list-type then do:
     1790   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1791   define variable v-str-recid10 as character no-undo .
     1792   define variable v-num-entry10 as integer   no-undo .
