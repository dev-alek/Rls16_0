     2089   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2090   procedure minbtn-set :
     2091       do
     2092           on error undo, return error return-value
     2093           :
     2094           define variable ii              as integer       no-undo .
     2095           define variable fh              as widget-handle no-undo .
     2096           define variable hh              as widget-handle no-undo .
     2097           define variable v-h             as handle        extent 4 no-undo .
     2098           define variable v-name-button   as character     no-undo .
     2099           define variable v-help-old-x    as decimal       no-undo .
     2100           define variable v-help-old-y    as decimal       no-undo .
     2101           define variable v-help-old-size as decimal       no-undo .
     2102           define variable v-frame-width   as decimal       no-undo .
     2103           define variable jj              as integer       no-undo .
     2104           do
     2105               on error undo, return error
     2106               :
     2107               assign
     2108                   v-frame-width = frame Dialog-Frame:width - 0.3
     2109                   fh            = frame Dialog-Frame:first-child
     2110                   hh            = fh:first-child
     2111                   ii            = 1
     2112                   .
     2113               do while valid-handle(hh):
     2114                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2115                   do:
     2116                       case lc(hh:name) :
     2117                           when "b-help" then
     2118                               do:
     2119                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2120                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2121                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2122                                   hh:TOOLTIP = "Помощь" .
     2123                                   v-help-old-x = hh:column .
     2124                                   v-help-old-y = hh:row    .
     2125                                   v-help-old-size = hh:width .
     2126                                   hh:width-chars = 2.5 .
     2127                               end.
     2128                           when "b-print" then
     2129                               do:
     2130                                   hh:load-image("cmp/b-print.bmp":u) .
     2131                                   hh:TOOLTIP = "Печать" .
     2132                                   v-h[ii] = hh:handle .
     2133                                   ii = ii + 1 .
     2134                                   hh:width-chars = 3 .
     2135                               end.
     2136                           when "b-history" or
     2137                           when "b-hist" then
     2138                               do:
     2139                                   hh:load-image("cmp/b-hist.bmp":u) .
     2140                                   hh:TOOLTIP = "История" .
     2141                                   v-h[ii] = hh:handle .
     2142                                   ii = ii + 1 .
     2143                                   hh:width-chars = 3 .
     2144                               end.
     2145                           when "b-sch" then
     2146                               do:
     2147                                   hh:load-image("cmp/b-sch.bmp":u) .
     2148                                   hh:TOOLTIP = "Установка Фильтра" .
     2149                                   v-h[ii] = hh:handle .
     2150                                   ii = ii + 1 .
     2151                                   hh:width-chars = 3 .
     2152                               end.
     2153                           when "b-hist-user" then
     2154                               do:
     2155                                   hh:load-image("cmp/b-hist.bmp":u) .
     2156                                   hh:TOOLTIP = "История пользователя" .
     2157                                   ii = ii + 1 .
     2158                               end.
     2159                       end case.
     2160                   end.
     2161                   hh = hh:next-sibling.
     2162               end.
     2163               b-help:column = v-frame-width - b-help:width-chars.
     2164               jj = 0.
     2165               repeat ii = 4 to 1 by -1 :
     2166                   if valid-handle (v-h[ii] ) then
     2167                   do:
     2168                       jj  = jj + 1 .
     2169                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2170                       v-h[ii]:row    = v-help-old-y .
     2171                   end.
     2172               end.
     2173           end.
     2174       end.
     2175   end procedure.
     2176   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2177   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2178   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2179   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2180   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2181   define variable v-diasize-current-frame-height as decimal   no-undo .
     2182   define variable v-diasize-change-size          as logical   no-undo .
     2183   define variable v-diasize-resize-button        as handle    no-undo .
     2184   define variable v-diasize-wndmax               as logical   no-undo .
     2185   define variable v-diasize-wndstore             as logical   no-undo .
     2186   define variable v-diasize-proc-name            as character no-undo .
     2187   define variable v-diasize-browse-handle        as handle    no-undo .
     2188   define variable v-diasize-browse-number        as integer   no-undo .
     2189   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2190   define temp-table temp-diasize-handle no-undo
     2191     field handle-value  as handle
     2192     field save-position as decimal
     2193     index xpk is primary unique handle-value
     2194     .
     2195   define temp-table temp-browse-handle no-undo
     2196     field browse-type   as character
     2197     field browse-number as integer
     2198     field browse-handle as handle
     2199     field original-size as decimal
     2200     index xpk is primary unique browse-type browse-number
     2201     index xie browse-type browse-handle
     2202   .
     2203   procedure diasize_change-height :
     2204     define input  parameter p-change-value  as decimal   no-undo .
     2205     define input  parameter p-move-resize   as logical   no-undo .
     2206     define variable v-field-group-handle    as handle    no-undo .
     2207     define variable v-object-handle         as handle    no-undo .
     2208     define variable v-frame-height          as decimal   no-undo .
     2209     define variable v-frame-virtual-height  as decimal   no-undo .
     2210     define variable v-browse-height         as decimal   no-undo .
     2211     define variable v-window-height         as decimal   no-undo .
     2212     define variable v-window-virtual-height as decimal   no-undo .
     2213     define variable v-change-sign           as integer   no-undo .
     2214     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2215     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2216     if p-change-value > 0
     2217     then do:
     2218       if frame Dialog-Frame :height + p-change-value
     2219           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2220       then do:
     2221         assign
     2222           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2223                           - (frame Dialog-Frame :height-chars)
     2224         .
     2225         if p-change-value <= 0
     2226         then do:
     2227           run diasize_position-resize-button in this-procedure .
     2228           return .
     2229         end.
     2230       end.
     2231     end.
     2232     if p-change-value < 0
     2233     then do:
     2234       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2235       then do:
     2236         assign
     2237           p-change-value = v-diasize-orig-frame-height
     2238                          - (frame Dialog-Frame :height-chars)
     2239         .
     2240         if p-change-value >= 0
     2241         then do:
     2242           run diasize_position-resize-button in this-procedure .
     2243           return .
     2244         end.
     2245       end.
     2246     end.
     2247     if p-change-value >= 0
     2248     then do:
     2249       assign
     2250         v-change-sign = 1
     2251       .
     2252     end.
     2253     else do:
     2254       assign
     2255         v-change-sign = -1
     2256       .
     2257     end.
     2258     assign
     2259       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2260     .
     2261     if p-change-value = 0
     2262     then do:
     2263       run diasize_position-resize-button in this-procedure .
     2264       return .
     2265     end.
     2266     move_block:
     2267     do
     2268     on error undo move_block, retry move_block
     2269     :
     2270       if retry
     2271       then do:
