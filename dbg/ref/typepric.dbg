     2578   procedure diasize_set-height :
     2579     define input  parameter p-new-height  as decimal   no-undo .
     2580     define input  parameter p-move-resize as logical   no-undo .
     2581     do
     2582     on error undo, return error return-value
     2583     :
     2584       run diasize_change-height in this-procedure
     2585         (input  (p-new-height - frame Dialog-Frame :height)
     2586         ,input  p-move-resize
     2587         ) .
     2588     end.
     2589   end procedure.
     2590   procedure diasize_change-width :
     2591     define input  parameter p-change-value as decimal   no-undo .
     2592     define input  parameter p-move-resize  as logical   no-undo .
     2593     define variable v-field-group-handle   as handle    no-undo .
     2594     define variable v-object-handle        as handle    no-undo .
     2595     define variable v-frame-width          as decimal   no-undo .
     2596     define variable v-frame-virtual-width  as decimal   no-undo .
     2597     define variable v-browse-width         as decimal   no-undo .
     2598     define variable v-window-width         as decimal   no-undo .
     2599     define variable v-window-virtual-width as decimal   no-undo .
     2600     define variable v-change-sign          as integer   no-undo .
     2601     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2602     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2603     if p-change-value > 0
     2604     then do:
     2605       if frame Dialog-Frame :width + p-change-value >
     2606           session :width-chars
     2607       then do:
     2608         assign
     2609           p-change-value = session :width-chars - frame Dialog-Frame :width
     2610         .
     2611         if p-change-value <= 0
     2612         then do:
     2613           run diasize_position-resize-button in this-procedure .
     2614           return .
     2615         end.
     2616       end.
     2617     end.
     2618     if p-change-value < 0
     2619     then do:
     2620       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2621       then do:
     2622         assign
     2623           p-change-value = v-diasize-orig-frame-width
     2624                          - frame Dialog-Frame :width
     2625         .
     2626         if p-change-value >= 0
     2627         then do:
     2628           run diasize_position-resize-button in this-procedure .
     2629           return .
     2630         end.
     2631       end.
     2632     end.
     2633     if p-change-value >= 0
     2634     then do:
     2635       assign
     2636         v-change-sign = 1
     2637       .
     2638     end.
     2639     else do:
     2640       assign
     2641         v-change-sign = -1
     2642       .
     2643     end.
     2644     assign
     2645       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2646     .
     2647     if p-change-value = 0
     2648     then do:
     2649       run diasize_position-resize-button in this-procedure .
     2650       return .
     2651     end.
     2652     move_block:
