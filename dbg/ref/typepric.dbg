     1852   ON ROW-DISPLAY OF BROWSE-1grp IN FRAME Dialog-Frame
     1853   DO:
     1854     if LOOKUP ("mode=twotpl":U,    p-bttns) > 0 then do:
     1855       if mark-string(buffer buf_price-list-type, p-rec-list) = '*' then do:
     1856          buf_price-list-type.priority  :bgcolor in browse BROWSE-1grp   = RED_COLOR .
     1857       end.
     1858     end.
     1859     if is-color = false then return .
     1860     if buf_price-list-type.ban-discnt > 0 then do:
     1861        v-fg-color = 5  .
     1862     end.
     1863     else do:
     1864        v-fg-color = ?  .
     1865     end.
     1866     if buf_price-list-type.under-type-list = 1 then do:
     1867        run recolor in this-procedure (GRAY_COLOR , v-fg-color ) .
     1868     end.
     1869     else do:
     1870        if can-find (first ch_price-list-type no-lock where
     1871                           ch_price-list-type.under-type-list = 1 and
     1872                           ch_price-list-type.stts            = integer('0':U) and
     1873                           ch_price-list-type.plt-main-id     = buf_price-list-type.plt-id and
     1874                           ch_price-list-type.plt-main-db-num = buf_price-list-type.plt-db-num )
     1875           then do:
     1876             run recolor in this-procedure (DARK_GRAY_COLOR, v-fg-color ) .
     1877           end.
     1878           else do:
     1879             v-bg-color = ? .
     1880             if buf_price-list-type.qgr-id > 0 then do:
     1881                v-bg-color = 11 .
     1882             end.
     1883             if buf_price-list-type.sgr-id > 0 then do:
     1884                v-bg-color = 10 .
     1885             end.
     1886             if buf_price-list-type.have-tog-id > 0 then do:
     1887                v-bg-color = 14 .
     1888             end.
     1889             run recolor in this-procedure (v-bg-color , v-fg-color ) .
     1890           end.
     1891     end.
     1892   END.
