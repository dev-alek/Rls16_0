     1795     v-num-entry10 = lookup( v-str-recid10 , p-rec-list )
     1796   .
     1797   if v-num-entry10 > 0 then do:
     1798     assign
     1799       entry( v-num-entry10, p-rec-list ) = "":U
     1800       p-rec-list = trim( replace( p-rec-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1801     .
     1802   end.
     1803   else do:
     1804     assign
     1805       p-rec-list = p-rec-list + ( if p-rec-list = "":U then "":U else chr(44) ) + v-str-recid10
     1806     .
     1807   end.
     1808           g-log = browse-1grp:refresh() .
     1809         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1810             g-log = browse-1grp:select-next-row ().
