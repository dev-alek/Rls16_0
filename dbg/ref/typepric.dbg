      404   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      405   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      406   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      407   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      408   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      409   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
