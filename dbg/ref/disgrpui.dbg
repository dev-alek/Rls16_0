        1   DEFINE TEMP-TABLE temp-grpdisc NO-UNDO LIKE ub.dis-grp-rule
        2          field rule-label as character.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter p-mode as char no-undo.
        5   define input parameter p-classif-type like ub.dis-grp-rule.classif-type no-undo.
        6   define input parameter p-host-code like ub.dis-grp-rule.host-code no-undo .
        7   define input parameter p-obj-type like ub.dis-grp-rule.obj-type no-undo.
        8   define input parameter p-obj-code like ub.dis-grp-rule.obj-code no-undo.
        9   define input parameter p-node-code  like ub.dis-grp-rule.node-code no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Скидки на группу".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77     define variable v-cntxt-db-num        as integer   no-undo .
       78     define variable v-cntxt-userid        as character no-undo .
       79     define variable v-cntxt-level         as character no-undo .
       80     define variable v-cntxt-host-code-obj as integer   no-undo .
       81     define variable v-cntxt-obj-type      as character no-undo .
       82     define variable v-cntxt-obj-code      as integer   no-undo .
       83     define variable v-cntxt-db-num-obj    as integer   no-undo .
       84     define variable v-cntxt-is-admin      as logical   no-undo .
       85   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   define temp-table temp-drt-prop no-undo like ub.drt-prop.
       88   procedure disrules-fill-properties:
       89   define input  parameter p-templ-rl-root as integer   no-undo .
       90   define buffer buf_drt-prop for ub.drt-prop.
       91   define buffer buf_temp-drt-prop for temp-drt-prop.
       92   do
       93   on error undo, return error return-value
       94   :
       95     for each buf_temp-drt-prop:
       96       delete buf_temp-drt-prop.
       97     end.
       98     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
       99       create buf_temp-drt-prop.
      100       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      101     end.
      102   end.
      103   end procedure.
      104   ~
      105   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      106   procedure discfgru-check :
      107   define input parameter p-table-name as character no-undo .
      108   define input parameter p-templ-rl-root as integer no-undo .
      109   define input parameter p-time-templ-rl-root as integer no-undo .
      110   define input parameter p-pos-type as character no-undo .
      111   define output parameter p-disnct-role as character no-undo .
      112   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      113     do
      114     on error undo, return error return-value
      115     :
      116       find first buf_dis-cfg-rule no-lock where
      117               buf_dis-cfg-rule.table-name = p-table-name
      118           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      119           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
      120           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
      121       if not available buf_dis-cfg-rule
      122       or p-pos-type = "":U
      123       then do:
      124          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
      125                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      126                                  , p-templ-rl-root
      127                                  , (if p-time-templ-rl-root = ?
      128                                     then '':U
      129                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
      130                                     )
      131                                  ).
      132       end.
      133       assign
      134       p-disnct-role = buf_dis-cfg-rule.discnt-role
      135       .
      136     end.
      137   end procedure.
      138   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139   FUNCTION get-region RETURNS CHARACTER
      140     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      141     define variable par-region as character no-undo.
      142     if parhost-code = 0 and
      143          parobj-type = "":U and
      144          parobj-code = 0 then do:
      145          par-region = "Глобально".
      146          return par-region.
      147       end.
      148       if parobj-type = 'орг':U then do:
      149          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      150          return par-region.
      151       end.
      152       if parobj-type = 'регион':U
      153       then do:
      154          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      155          return par-region.
      156       end.
      157       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      158       return par-region.
      159   END FUNCTION.
      160   FUNCTION get-objregion RETURNS CHARACTER
      161     (  input parobj-type as character, input parobj-code as integer ) :
      162     define variable par-region as character no-undo.
      163     if  parobj-type = "":U and
      164         parobj-code = 0
      165     then do:
      166        par-region = "Глобально".
      167     end.
      168     else if parobj-type = 'орг':U
      169     then do:
      170        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      171     end.
      172     else if parobj-type = 'регион':U
      173     then do:
      174        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      175     end.
      176     else
      177        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      178     return par-region.
      179   END FUNCTION.
      180   procedure disgrpru-name :
      181   define buffer buf_dis-rule for ub.dis-rule.
      182   do
      183     on error undo, return error
      184     :
      185     define input  parameter p-templ-rl-root  as integer no-undo .
      186     define output parameter p-label          as character no-undo .
      187     find first buf_dis-rule no-lock where
      188               buf_dis-rule.rule-num = p-templ-rl-root no-error.
      189     if available buf_dis-rule then do:
      190       if buf_dis-rule.rule-num > 0 then
      191       p-label = buf_dis-rule.des.
      192     end.
      193     else do:
      194       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
      195     end.
      196   end.
      197   end procedure.
      198   function disgrpru-get-disc-label returns character ( input p-templ-rl-root as integer):
      199   define variable v-rule-label as character no-undo .
      200   run disgrpru-name in this-procedure ( input p-templ-rl-root
      201                                        ,output v-rule-label) no-error.
      202   return v-rule-label.
      203   end function.
      204   function disgrpru-get-disc-role-label returns character ( input p-discnt-role as character):
      205   define variable v-role-label as character no-undo .
      206   v-role-label =  entry (lookup (p-discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u).
      207   if v-role-label = '':u then do:
      208     v-role-label = entry (lookup (p-discnt-role, 'cli-grp-pcnt':u) + 1, ',' + '% скидка на группу клиентов':u).
      209   end.
      210   return v-role-label.
      211   end function.
      212   procedure disgrpru-write :
      213     do
      214     on error undo, return error
      215     :
      216       define input parameter p-classif-type   like ub.dis-grp-rule.classif-type no-undo .
      217       define input parameter p-node-code      like ub.dis-grp-rule.node-code  no-undo .
      218       define input parameter p-host-code      like ub.dis-grp-rule.host-code no-undo .
      219       define input parameter p-obj-type       like ub.dis-grp-rule.obj-type   no-undo .
      220       define input parameter p-obj-code       like ub.dis-grp-rule.obj-code   no-undo .
      221       define input parameter p-pos-type       like ub.dis-grp-rule.pos-type   no-undo .
      222       define input parameter p-discnt-role    like ub.dis-grp-rule.discnt-role no-undo .
      223       define input parameter p-templ-rl-root  like ub.dis-grp-rule.templ-rl-root  no-undo .
      224       define input parameter p-time-templ-rl-root  like ub.dis-grp-rule.time-templ-rl-root  no-undo .
      225       define input parameter p-rule-num       like ub.dis-grp-rule.rule-num    no-undo .
      226       define input parameter p-nonunique      like ub.dis-grp-rule.nonunique   no-undo .
      227       define buffer buf_dis-grp-rule for ub.dis-grp-rule .
      228       define buffer lock_dis-grp-rule for ub.dis-grp-rule .
      229       define buffer buf_dis-rule for ub.dis-rule.
      230       define variable v-label          as character no-undo .
      231       define variable v-discnt-role as character no-undo .
      232       define variable v-host-code as integer no-undo .
      233       run discfgru-check in this-procedure (
      234                                             input 'dis-grp-rule':U
      235                                            ,input p-templ-rl-root
      236                                            ,input p-time-templ-rl-root
      237                                            ,input p-pos-type
      238                                            ,output v-discnt-role
      239                                             ) no-error .
      240       if error-status :error then do:
      241         undo, return error return-value .
      242       end.
      243      if p-discnt-role = ? then do:
      244         p-discnt-role = v-discnt-role.
      245       end.
      246       if p-discnt-role <> v-discnt-role then do:
      247         undo, return error substitute("Группа с кодом &1 &2 место использ.&3 уже есть скидка типа &4&5не может быть по шаблону &6 и расписанию &7"
      248                                 ,p-node-code
      249                                 ,p-obj-type + string(p-obj-code)
      250                                 ,p-pos-type
      251                                 ,entry (lookup (p-discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u)
      252                                 ,chr(10)
      253                                 ,p-templ-rl-root
      254                                 ,p-rule-num).
      255       end.
      256       if p-pos-type = ? then do:
      257   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      258   define variable v-param-type5 as character no-undo .
      259   define variable v-value-date5 as date no-undo .
      260   define variable v-value-decimal5 as decimal no-undo .
      261   define variable v-value-integer5 as INTEGER no-undo .
      262   define variable v-value-logical5 AS LOGICAL no-undo .
      263   define variable v-tth5 as handle no-undo .
      264   run adm/shattri.p (
      265       input "get":U
      266       ,input  p-obj-type
      267       ,input  p-obj-code
      268       ,input  'cd-sending':U
      269       ,input  'dflt-cd':U
      270       ,output p-pos-type
      271       ,output v-value-date5
      272       ,output v-value-decimal5
      273       ,output v-value-integer5
      274       ,output v-value-logical5
      275       ,output v-param-type5
      276       ,INPUT-OUTPUT table-handle v-tth5
      277       )  .
      278   delete object v-tth5 no-error.
      279       end.
      280       find first buf_dis-rule no-lock where
      281                 buf_dis-rule.rule-num = p-rule-num no-error.
      282       if not available buf_Dis-rule then do:
      283         undo, return error substitute("Группа с кодом &1 &2 место использ.&3 уже есть скидка типа &4&5не найдено правило скидки &6"
      284                                 ,p-node-code
      285                                 ,p-obj-type + string(p-obj-code)
      286                                 ,p-pos-type
      287                                 ,entry (lookup (p-discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u)
      288                                 ,chr(10)
      289                                 ,p-rule-num).
      290       end.
      291       if buf_dis-rule.root <> yes then do:
      292         undo, return error substitute("Группа с кодом &1 &2 место использ.&3 уже есть скидка типа &4&5правило скидки &6 - некорневое"
      293                                 ,p-node-code
      294                                 ,p-obj-type + string(p-obj-code)
      295                                 ,p-pos-type
      296                                 ,entry (lookup (p-discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u)
      297                                 ,chr(10)
      298                                 ,p-rule-num).
      299       end.
      300       if not (p-obj-type = buf_dis-rule.obj-type
      301           and p-obj-code = buf_dis-rule.obj-code) then do:
      302         undo, return error (substitute("Группа с кодом &1 &2 место использ.&3 уже есть скидка типа &4&5правило скидки &6"
      303                                 ,p-node-code
      304                                 ,p-obj-type + string(p-obj-code)
      305                                 ,p-pos-type
      306                                 ,entry (lookup (p-discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u)
      307                                 ,chr(10)
      308                                 ,p-rule-num)
      309                             +
      310                             substitute("Правило скидки &1 определено для &1&2" +
      311                                        "а привязка к ДК для &3"
      312                                        ,get-region( buf_Dis-rule.host-code, buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
      313                                        ,chr(10)
      314                                        ,get-region( p-host-code, p-obj-type, p-obj-code)
      315                                        ))
      316                                 .
      317       end.
      318       find first buf_dis-grp-rule exclusive-lock where
      319                  buf_dis-grp-rule.classif-type  = p-classif-type
      320              AND buf_dis-grp-rule.node-code  = p-node-code
      321              AND buf_dis-grp-rule.host-code  = p-host-code
      322              AND buf_dis-grp-rule.obj-type  = p-obj-type
      323              AND buf_dis-grp-rule.obj-code  = p-obj-code
      324              AND buf_dis-grp-rule.pos-type  = p-pos-type
      325              AND buf_dis-grp-rule.discnt-role = p-discnt-role
      326              and buf_dis-grp-rule.nonunique = p-nonunique
      327              no-error .
      328       if not available buf_dis-grp-rule then do:
      329         create buf_dis-grp-rule .
      330         assign
      331         buf_dis-grp-rule.classif-type  = p-classif-type
      332         buf_dis-grp-rule.node-code  = p-node-code
      333         buf_dis-grp-rule.obj-type  = p-obj-type
      334         buf_dis-grp-rule.obj-code  = p-obj-code
      335         buf_dis-grp-rule.host-code  = p-host-code
      336         buf_dis-grp-rule.pos-type = p-pos-type
      337         buf_dis-grp-rule.discnt-role = v-discnt-role
      338         buf_dis-grp-rule.rule-num = p-rule-num
      339         buf_dis-grp-rule.nonunique = p-nonunique
      340         no-error
      341         .
      342       end.
      343       ASSIGN
      344       buf_dis-grp-rule.rule-num = p-rule-num
      345       buf_dis-grp-rule.rl-root = p-rule-num
      346       buf_dis-grp-rule.templ-rl-root = p-templ-rl-root
      347       buf_dis-grp-rule.time-templ-rl-root = p-time-templ-rl-root
      348       buf_dis-grp-rule.nonunique = p-nonunique
      349       no-error.
      350     end.
      351   end procedure.
      352   procedure disgrpru-delete :
      353   define input parameter p-classif-type   like ub.dis-grp-rule.classif-type no-undo .
      354   define input parameter p-node-code      like ub.dis-grp-rule.node-code  no-undo .
      355   define input parameter p-host-code      like ub.dis-grp-rule.host-code   no-undo .
      356   define input parameter p-obj-type       like ub.dis-grp-rule.obj-type   no-undo .
      357   define input parameter p-obj-code       like ub.dis-grp-rule.obj-code   no-undo .
      358   define input parameter p-pos-type       like ub.dis-grp-rule.pos-type   no-undo .
      359   define input parameter p-discnt-role    like ub.dis-grp-rule.discnt-role no-undo .
      360   define input parameter p-nonunique      like ub.dis-grp-rule.nonunique   no-undo .
      361   define output parameter p-deleted       as logical no-undo .
      362   define variable v-rule-label as character no-undo .
      363   define buffer buf_dis-grp-rule for ub.dis-grp-rule.
      364   do
      365   on error undo, return error
      366   :
      367   find first buf_dis-grp-rule exclusive-lock where
      368               buf_dis-grp-rule.classif-type  = p-classif-type
      369           AND buf_dis-grp-rule.node-code  = p-node-code
      370           AND buf_dis-grp-rule.obj-type  = p-obj-type
      371           AND buf_dis-grp-rule.host-code = p-host-code
      372           AND buf_dis-grp-rule.obj-code  = p-obj-code
      373           AND buf_dis-grp-rule.pos-type  = p-pos-type
      374           AND buf_dis-grp-rule.discnt-role = p-discnt-role
      375           and buf_dis-grp-rule.nonunique = p-nonunique
      376           no-error .
      377   if not available buf_dis-grp-rule then do:
      378     return '':U.
      379   end.
      380   delete buf_dis-grp-rule no-error.
      381   if error-status:error then do:
      382     run disgrpru-name in this-procedure
      383       (input  buf_dis-grp-rule.templ-rl-root
      384       ,output v-rule-label
      385       ) no-error .
      386     undo, return error substitute("Ошибка при удалении скидки по группе:&1" +
      387                                  "&2 (место использ. &3) на фирме &4 &5&6 для группы &7&1&8&1&9"
      388                                   ,chr(10)
      389                                   ,v-rule-label
      390                                   ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      391                                   ,p-host-code
      392                                   ,p-obj-type
      393                                   ,p-obj-code
      394                                   ,error-status:get-message(1)
      395                                   ,return-value ).
      396   end.
      397   p-deleted = yes.
      398   return '':U.
      399   end.
      400   end procedure.
      401   procedure disgrpru-edit :
      402   define input parameter p-mode as character no-undo .
      403   define input parameter p-classif-type like ub.dis-grp-rule.classif-type no-undo .
      404   define input parameter p-node-code   like ub.dis-grp-rule.node-code no-undo .
      405   define input parameter p-host-code like ub.dis-grp-rule.host-code no-undo .
      406   define input parameter p-obj-type like ub.dis-grp-rule.obj-type no-undo .
      407   define input parameter p-obj-code like ub.dis-grp-rule.obj-code no-undo .
      408   define input parameter p-pos-type like ub.dis-grp-rule.pos-type no-undo .
      409   define input parameter p-discnt-role    like ub.dis-grp-rule.discnt-role no-undo .
      410   define input parameter p-templ-rl-root like ub.dis-grp-rule.templ-rl-root no-undo .
      411   define input parameter p-time-templ-rl-root like ub.dis-grp-rule.time-templ-rl-root no-undo .
      412   define input parameter p-cfg-NONUNIQUE as character no-undo .
      413   define input parameter p-check as integer no-undo .
      414   define input-output parameter p-rule-num as integer no-undo .
      415   define input-output parameter p-NONUNIQUE like ub.dis-grp-rule.NONUNIQUE no-undo .
      416   define output parameter p-setted as logical no-undo .
      417   DEFINE VARIABLE v-value as character no-undo .
      418   define variable v-sts as integer no-undo .
      419   define variable v-rid-list as character no-undo .
      420   DEFINE VARIABLE v-rule-num as integer no-undo .
      421   define variable v-cd-dr-correct  as logical no-undo .
      422   define variable jj as integer no-undo .
      423   define variable conf-par as character no-undo .
      424   define variable conf-attr as character no-undo .
      425   define variable par-type as character no-undo .
      426   define variable dflt-cd as character no-undo .
      427   define variable v-cd-list as character no-undo .
      428   define variable v-is-time-rule as logical no-undo .
      429   define variable v-label as character no-undo .
      430   define variable v-nonunique as character no-undo .
      431   define variable v-mode as character no-undo .
      432   define variable v-time-templ-rl-root as integer   no-undo .
      433   define buffer buf_dis-rule for ub.dis-rule.
      434   define buffer buf_dis-time-rule for ub.dis-time-rule .
      435   define buffer term_dis-rule for ub.dis-rule.
      436   define buffer buf_dis-grp-rule for ub.dis-grp-rule.
      437   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      438   define buffer buf_temp-grpdisc for temp-grpdisc.
      439   assign
      440   v-rule-num = p-rule-num.
      441   v-sts = integer('0':U).
      442   if v-rule-num <> 0
      443   and v-rule-num <> ?
      444   then do:
      445     find first buf_dis-rule no-lock where
      446               buf_dis-rule.rule-num = v-rule-num no-error .
      447     if error-status:error then do:
      448       message
      449       "Ошибка при поиске правила с номером" v-rule-num
      450       view-as alert-box error .
      451       return .
      452     end.
      453     assign
      454     v-rid-list = string(recid(buf_dis-rule))
      455     .
      456   end.
      457     run disgrpru-name in this-procedure (
      458                                   input p-templ-rl-root
      459                                   ,output v-label) no-error.
      460   if p-pos-type = ?
      461   or p-pos-type = '':U then do:
      462   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      463   define variable v-param-type6 as character no-undo .
      464   define variable v-value-date6 as date no-undo .
      465   define variable v-value-decimal6 as decimal no-undo .
      466   define variable v-value-integer6 as INTEGER no-undo .
      467   define variable v-value-logical6 AS LOGICAL no-undo .
      468   define variable v-tth6 as handle no-undo .
      469   run adm/shattri.p (
      470       input "get":U
      471       ,input  p-obj-type
      472       ,input  p-obj-code
      473       ,input  'cd-sending':U
      474       ,input  'dflt-cd':U
      475       ,output dflt-cd
      476       ,output v-value-date6
      477       ,output v-value-decimal6
      478       ,output v-value-integer6
      479       ,output v-value-logical6
      480       ,output v-param-type6
      481       ,INPUT-OUTPUT table-handle v-tth6
      482       )  .
      483   delete object v-tth6 no-error.
      484   end.
      485   else do:
      486     dflt-cd = p-pos-type.
      487   end.
      488   v-mode =  ('dis-grp-rule':U + "=" + p-discnt-role).
      489   run ref/dis-ruls.w (
      490               input parparentproc
      491               ,input p-host-code
      492               ,input p-obj-type
      493               ,input p-obj-code
      494               ,input "b-add,b-sel":U
      495               ,input v-mode
      496               ,input p-templ-rl-root
      497               ,input p-time-templ-rl-root
      498               ,input 0
      499               ,input-output v-sts
      500               ,input-output v-rid-list ) no-error .
      501   do
      502   on error undo, return error return-value
      503   :
      504     if v-rid-list <> "":U then do:
      505       find first buf_dis-rule exclusive-lock where
      506                   recid(buf_dis-rule) = integer(v-rid-list) no-wait no-error .
      507       if not available buf_dis-rule
      508       then do:
      509         message
      510         "Ошибка при поиске правила с recid" v-rid-list
      511         view-as alert-box error .
      512         return .
      513       end.
      514       if buf_dis-rule.sts <> integer('0':U) then do:
      515         message
      516         "Правило скидки имеет статус" entry (lookup (string(buf_dis-rule.sts), '0,1,2,99,98':U), 'исп,не-исп,детализ,удаление,запр.удал':U) skip
      517         "Нельзя привязать к нему скидку на группу"
      518         view-as alert-box error .
      519         return .
      520       end.
      521       find first buf_dis-cfg-rule no-lock where
      522               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      523           and buf_dis-cfg-rule.time-templ-rl-root = (if buf_dis-rule.time-templ-rl-root = -1
      524                                                      then 0
      525                                                      else buf_dis-rule.time-templ-rl-root)
      526           and buf_dis-cfg-rule.pos-type = dflt-cd
      527           and buf_Dis-cfg-rule.table-name = 'dis-grp-rule':U
      528           and buf_dis-cfg-rule.self-nonunique = p-classif-type
      529           no-error.
      530       if available buf_dis-cfg-rule then do:
      531         assign
      532         v-cd-dr-correct = yes
      533         .
      534       end.
      535       else do:
      536          if buf_dis-rule.is-term = no then do:
      537            for each term_dis-rule no-lock where
      538               term_dis-rule.upper-rule-num = buf_dis-rule.rule-num:
      539              find first buf_dis-cfg-rule no-lock where
      540                     buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      541                 and buf_dis-cfg-rule.time-templ-rl-root = term_dis-rule.time-templ-rl-root
      542                 and buf_dis-cfg-rule.pos-type = dflt-cd
      543                 and buf_dis-cfg-rule.table-name = 'dis-gds-rule':U
      544                 no-error.
      545              if available buf_dis-cfg-rule
      546              and v-time-templ-rl-root = 0
      547              then do:
      548                 v-time-templ-rl-root = term_dis-rule.time-templ-rl-root.
      549                 v-cd-dr-correct = yes.
      550              end.
      551              if not available buf_dis-cfg-rule
      552              or v-time-templ-rl-root <> term_dis-rule.time-templ-rl-root then do:
      553                v-cd-dr-correct = no.
      554                leave.
      555              end.
      556            end.
      557          end.
      558       end.
      559       if not v-cd-dr-correct
      560       then do:
      561         message
      562         substitute("Правило скидки &1 неприменимо для касс &2.&3" +
      563                   "(АРМ АДМИНИСТРАТОР-Магазины(Фирмы)-Параметры-Общие опции коммуникации с кассами)"
      564                   ,buf_dis-rule.rule-num
      565                   ,dflt-cd
      566                   ,chr(10)
      567                   )
      568         view-as alert-box error .
      569         undo, return error .
      570       end.
      571       assign
      572       v-nonunique = if p-cfg-nonunique = '':U
      573                     then '':U
      574                     else string(buffer buf_Dis-rule:handle:buffer-field(p-cfg-nonunique):buffer-value).
      575       if p-check = 0
      576       or p-check = 2
      577       then do:
      578         find first buf_dis-grp-rule no-lock where
      579                     buf_dis-grp-rule.obj-type = p-obj-type
      580                 and buf_dis-grp-rule.obj-code = p-obj-code
      581                 and buf_dis-grp-rule.host-code = p-host-code
      582                 and buf_dis-grp-rule.node-code = p-node-code
      583                 and buf_dis-grp-rule.classif-type = p-classif-type
      584                 and buf_dis-grp-rule.pos-type = p-pos-type
      585                 and buf_dis-grp-rule.discnt-role = p-discnt-role
      586                 and buf_dis-grp-rule.nonunique = v-nonunique no-error .
      587         if available buf_dis-grp-rule
      588         and p-mode <> 'ИЗМЕНЕНИЕ':U
      589         then do:
      590           message
      591           "Скидка такого типа на данную группу уже существует"
      592           view-as alert-box error .
      593           return error.
      594         end.
      595       end.
      596       if p-check = 1
      597       or p-check = 2
      598       then do:
      599         find first buf_temp-grpdisc no-lock where
      600                     buf_temp-grpdisc.obj-type = p-obj-type
      601                 and buf_temp-grpdisc.obj-code = p-obj-code
      602                 and buf_temp-grpdisc.host-code = p-host-code
      603                 and buf_temp-grpdisc.node-code = p-node-code
      604                 and buf_temp-grpdisc.classif-type = p-classif-type
      605                 and buf_temp-grpdisc.pos-type = p-pos-type
      606                 and buf_temp-grpdisc.discnt-role = p-discnt-role
      607                 and buf_temp-grpdisc.nonunique = v-nonunique no-error .
      608         if available buf_temp-grpdisc
      609         and buf_temp-grpdisc.rule-num <> 0
      610         and p-mode <> 'ИЗМЕНЕНИЕ':U
      611         then do:
      612           message
      613         "Скидка такого типа на данную группу уже существует"
      614           view-as alert-box error .
      615           return error.
      616         end.
      617       end.
      618       if p-rule-num <> buf_dis-rule.rule-num then do:
      619         assign
      620         p-setted = yes
      621         p-rule-num = buf_dis-rule.rule-num
      622         p-nonunique = v-nonunique
      623         .
      624       end.
      625     end.
      626   end.
      627   end procedure.
      628   procedure proc-alt-shift-f2:
      629     if not ibs.th.gbl.gbl-var:rcode
      630   then
      631     run gbl\inidebug.p .
      632   end.
      633   procedure proc-alt-shift-f3:
      634     run gbl/prvssinf.p
      635       ( input this-procedure
      636       ) .
      637   end.
      638   define variable v-inform-launched as logical no-undo initial false .
      639   procedure proc-alt-shift-f4:
      640     define variable v-action as character no-undo .
      641     if v-inform-launched = false then do:
      642       assign
      643         v-inform-launched = true
      644       .
      645       run gbl/d-inform.w
      646         (  input self
      647         ,  input this-procedure
      648         , output v-action
      649         ) no-error .
      650       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      651       assign
      652         v-inform-launched = false
      653       .
      654     end.
      655   end.
      656   procedure proc-alt-f1:
      657     run gbl/corrhelp.p
      658       (input this-procedure
      659       ) .
      660   end .
      661   on alt-shift-f2 anywhere do:
      662     run proc-alt-shift-f2.
      663   end.
      664   on alt-shift-f3 anywhere do:
      665     run proc-alt-shift-f3 in this-procedure .
      666   end.
      667   on alt-shift-f4 anywhere do:
      668     run proc-alt-shift-f4 in this-procedure.
      669   end.
      670   on alt-f1 anywhere do:
      671     run proc-alt-f1 in this-procedure .
      672   end.
      673   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      674   procedure cli-grplib-get-full-name :
      675      define input parameter  p-node-code  as integer      no-undo.
      676      define output parameter p-full-name as character    no-undo.
      677   do
      678   on error undo, return error
      679   :
      680       define variable v-upper-code    as integer           no-undo.
      681       define buffer buf_cli-grp       for ub.cli-grp.
      682       define buffer buf_upper_cli-grp for ub.cli-grp.
      683       find first buf_cli-grp no-lock
      684            where buf_cli-grp.node-code = p-node-code
      685       no-error.
      686       if not available buf_cli-grp
      687       then do:
      688           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
      689       end.
      690       assign
      691           p-full-name  = ""
      692           v-upper-code = 1
      693       .
      694       do while buf_cli-grp.upper-code <> 0
      695       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      696       :
      697           assign
      698               p-full-name  = buf_cli-grp.node-name
      699                            + (if p-full-name <> "" then chr(47) else "")
      700                            + p-full-name
      701               v-upper-code = buf_cli-grp.upper-code
      702           .
      703           find first buf_cli-grp no-lock
      704                where buf_cli-grp.node-code = v-upper-code
      705           no-error.
      706           if not available buf_cli-grp
      707           then do:
      708               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
      709                                   + string( v-upper-code )
      710                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      711           end.
      712       end.
      713       assign
      714       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      715       .
      716   end.
      717   end .
      718   procedure cgrplib-get-node-from-full-name :
      719   define input parameter p-full-name as character no-undo .
      720   define output parameter p-node-code as integer no-undo .
      721   define variable v-ii as integer no-undo .
      722   define variable v-upper-code as integer no-undo .
      723   define variable v-root-code as integer no-undo .
      724   define variable v-entry as character no-undo .
      725   define buffer buf_cli-grp       for ub.cli-grp.
      726   do
      727   on error undo, return error
      728   :
      729     find first buf_cli-grp no-lock
      730         where buf_cli-grp.upper-code = 0
      731     no-error .
      732     if not available buf_cli-grp
      733     then do:
      734         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
      735     end.
      736     else do:
      737       assign
      738       v-root-code = buf_cli-grp.node-code
      739       .
      740     end.
      741     v-upper-code = v-root-code.
      742     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      743       assign
      744       v-entry = entry(v-ii, p-full-name, chr(47)).
      745       if v-entry = '' then leave.
      746       find first buf_cli-grp no-lock where
      747                 buf_cli-grp.node-name = v-entry
      748             and buf_cli-grp.upper-code = v-upper-code
      749             no-error.
      750       if not available buf_cli-grp then do:
      751         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      752       end.
      753       else do:
      754         p-node-code = buf_cli-grp.node-code.
      755         v-upper-code = buf_cli-grp.node-code.
      756       end.
      757     end.
      758   end.
      759   end .
      760   define variable updated as logical no-undo.
      761   DEFINE VARIABLE added  as logical no-undo .
      762   define variable add-option as char no-undo.
      763   define variable temp-doc-rec as recid no-undo.
      764   DEFINE VARIABLE dflt-cd AS CHARACTER NO-UNDO.
      765   define variable v-tab-order as character no-undo .
      766   define variable loc-glob as logical no-undo .
      767   define variable loc-firm as logical no-undo .
      768   define variable loc-object as logical no-undo .
      769   DEFINE MENU MENU-b-ins
      770          MENU-ITEM m_pos-type     LABEL "m_pos-type"
      771          MENU-ITEM m_no-pos       LABEL "По накладной"  .
      772   DEFINE BUTTON b-chg
      773        LABEL "&Изменить":L
      774        SIZE 10 BY 1 TOOLTIP "Изменить скидку на группу".
      775   DEFINE BUTTON b-del
      776        LABEL "&Удалить":L
      777        SIZE 10 BY 1 TOOLTIP "Удалить скидку на группу".
      778   DEFINE BUTTON b-help
      779        LABEL "Помо&щь":L
      780        SIZE 3 BY 1.
      781   DEFINE BUTTON b-ins
      782        LABEL "&Добавить":L
      783        SIZE 10 BY 1 TOOLTIP "Добавить скидку на группу".
      784   DEFINE BUTTON b-lkp
      785        LABEL "&Просмотр":L
      786        SIZE 10 BY 1 TOOLTIP "Просмотр скидки на группу".
      787   DEFINE BUTTON b-quit AUTO-GO
      788        LABEL "&Выход ":L
      789        SIZE 10 BY 1 TOOLTIP "Выход из режима".
      790   DEFINE VARIABLE cd-grp-code AS INTEGER FORMAT ">>>9":U INITIAL 0
      791        LABEL "Код группы"
      792         VIEW-AS TEXT
      793        SIZE 9.6 BY 1
      794        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      795   DEFINE VARIABLE v-grp-name AS CHARACTER FORMAT "X(256)":U
      796         VIEW-AS TEXT
      797        SIZE 55 BY 1
      798        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      799   DEFINE QUERY br-dis-grp FOR
      800         temp-grpdisc SCROLLING.
      801   DEFINE BROWSE br-dis-grp
      802     QUERY br-dis-grp DISPLAY
      803         temp-grpdisc.templ-rl-root COLUMN-LABEL "" FORMAT ">9":U
      804   disgrpru-get-disc-label(temp-grpdisc.templ-rl-root) COLUMN-LABEL "Тип скидки" FORMAT "X(50)":U
      805   get-region(temp-grpdisc.host-code, temp-grpdisc.obj-type, temp-grpdisc.obj-code) COLUMN-LABEL "Действует" FORMAT "X(12)":U
      806       WIDTH 13
      807   temp-grpdisc.rule-num COLUMN-LABEL "№ правила" FORMAT ">>>>>>>>9":U
      808   temp-grpdisc.rl-root COLUMN-LABEL "№ корн.!правила" FORMAT ">>>>>>>>9":U
      809   entry (lookup (temp-grpdisc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U) FORMAT "X(20)":U COLUMN-LABEL "Место использ."
      810       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 15.33.
      811   DEFINE FRAME Dialog-Frame
      812        b-quit AT ROW 1 COL 1
      813        b-ins AT ROW 1 COL 21
      814        b-lkp AT ROW 1 COL 31
      815        b-chg AT ROW 1 COL 41
      816        b-del AT ROW 1 COL 51
      817        b-help AT ROW 1 COL 95
      818        br-dis-grp AT ROW 4.47 COL 1
      819        v-grp-name AT ROW 2 COL 2.5 NO-LABEL
      820        cd-grp-code AT ROW 3.27 COL 33.5
      821        SPACE(43.90) SKIP(15.69)
      822       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      823            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      824            TITLE "Скидки на группу".
      825   ASSIGN
      826          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      827          FRAME Dialog-Frame:HIDDEN           = TRUE.
      828   ASSIGN
      829          b-ins:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-ins:HANDLE.
      830   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      831   DO:
      832     APPLY "END-ERROR":U TO SELF.
      833   END.
      834   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      835   DO:
      836     if not avail temp-grpdisc then return no-apply.
      837     run proc-add-chg in this-procedure ( input no, input temp-grpdisc.pos-type) no-error .
      838     if error-status:error then return no-apply.
      839     RUN init-proc in this-procedure .
      840   END.
      841   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      842   DO:
      843   define variable loc#log as logical no-undo.
      844   define variable v-rule-label as character no-undo .
      845   define variable v-deleted as logical no-undo .
      846     if not avail temp-grpdisc then return no-apply.
      847       run disgrpru-name in this-procedure
      848         (input  temp-grpdisc.templ-rl-root
      849         ,output v-rule-label
      850         ) no-error .
      851       if error-status :error then do:
      852         return no-apply .
      853       end.
      854     loc#log = no.
      855     message
      856     substitute("Вы уверены, что хотите удалить скидку &1 (место использ. &2)&7на фирме &3 &4&5 для группы &6?"
      857              ,v-rule-label
      858              ,entry (lookup (temp-grpdisc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      859              ,temp-grpdisc.host-code
      860              ,temp-grpdisc.obj-type
      861              ,temp-grpdisc.obj-code
      862              ,v-grp-name
      863              ,chr(10)
      864              )
      865             view-as alert-box QUESTIOn buttons YES-NO update loc#log.
      866     if NOT loc#log then return no-apply.
      867     run disgrpru-delete in this-procedure(
      868                                      input p-classif-type
      869                                     ,input p-node-code
      870                                     ,input temp-grpdisc.host-code
      871                                     ,input temp-grpdisc.obj-type
      872                                     ,input temp-grpdisc.obj-code
      873                                     ,input temp-grpdisc.pos-type
      874                                     ,input temp-grpdisc.discnt-role
      875                                     ,input temp-grpdisc.nonunique
      876                                     ,output v-deleted
      877                                     ) no-error .
      878     if error-status:error then do:
      879        return no-apply.
      880     end.
      881     delete temp-grpdisc.
      882     updated = yes.
      883     run init-proc in this-procedure .
      884   END.
      885   ON CHOOSE OF b-ins IN FRAME Dialog-Frame
      886   DO:
      887    if add-option = '':U then do:
      888          run gbl/pop-up.p ( input self:handle, input no) no-error.
      889     end.
      890     if add-option = '':U then return no-apply.
      891     run proc-add-chg in this-procedure ( input yes, input add-option ) no-error.
      892     if error-status:error then do:
      893       add-option = '':U.
      894       return no-apply.
      895     end.
      896     add-option = '':U.
      897   END.
      898   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      899   DO:
      900     IF not AVAILABLE temp-grpdisc then return no-apply.
      901     RUN proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
      902     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      903   END.
      904   ON MOUSE-SELECT-DBLCLICK OF br-dis-grp IN FRAME Dialog-Frame
      905   DO:
      906     IF not AVAILABLE temp-grpdisc then return no-apply.
      907     RUN proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
      908     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      909   END.
      910   ON RETURN OF br-dis-grp IN FRAME Dialog-Frame
      911   DO:
      912     IF not AVAILABLE temp-grpdisc then return no-apply.
      913     RUN proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
      914     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      915   END.
      916   ON VALUE-CHANGED OF br-dis-grp IN FRAME Dialog-Frame
      917   DO:
      918       IF v-cntxt-db-num > 0
      919     AND (temp-grpdisc.obj-type = 'орг':U
      920     OR temp-grpdisc.obj-type = '':U) THEN DO:
      921        DISABLE
      922        b-chg
      923        with FRAME Dialog-Frame.
      924     END.
      925     ELSE DO:
      926         enable
      927         b-chg WHEN (p-mode <> 'ПРОСМОТР':U)
      928         with FRAME Dialog-Frame.
      929     END.
      930   END.
      931   ON CHOOSE OF MENU-ITEM m_no-pos
      932   DO:
      933       add-option = '-':U.
      934     run proc-add-chg in this-procedure ( input yes, input add-option ) no-error.
      935     if error-status:error then do:
      936       add-option = '':U.
      937       return no-apply.
      938     end.
      939     add-option = '':U.
      940   END.
      941   ON CHOOSE OF MENU-ITEM m_pos-type
      942   DO:
      943       add-option = dflt-cd.
      944     run proc-add-chg in this-procedure ( input yes, input add-option ) no-error.
      945     if error-status:error then do:
      946       add-option = '':U.
      947       return no-apply.
      948     end.
      949     add-option = '':U.
      950   END.
      951   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      952   on help of frame Dialog-Frame
      953   do:
      954     run gbl/app_help.p
      955       (input this-procedure :file-name
      956       ,input ''
      957       ,input ?
      958       ) no-error.
      959     if error-status :error then do:
      960       message
      961         "Ошибка при вызове помощи"
      962         error-status :get-message(1)
      963         view-as alert-box .
      964     end.
      965   end.
      966   run minbtn-set in this-procedure .
      967   on choose of b-help in frame Dialog-Frame
      968   do:
      969     apply "help":u to frame Dialog-Frame .
      970   end.
      971   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      972   procedure minbtn-set :
      973       do
      974           on error undo, return error return-value
      975           :
      976           define variable ii              as integer       no-undo .
      977           define variable fh              as widget-handle no-undo .
      978           define variable hh              as widget-handle no-undo .
      979           define variable v-h             as handle        extent 4 no-undo .
      980           define variable v-name-button   as character     no-undo .
      981           define variable v-help-old-x    as decimal       no-undo .
      982           define variable v-help-old-y    as decimal       no-undo .
      983           define variable v-help-old-size as decimal       no-undo .
      984           define variable v-frame-width   as decimal       no-undo .
      985           define variable jj              as integer       no-undo .
      986           do
      987               on error undo, return error
      988               :
      989               assign
      990                   v-frame-width = frame Dialog-Frame:width - 0.3
      991                   fh            = frame Dialog-Frame:first-child
      992                   hh            = fh:first-child
      993                   ii            = 1
      994                   .
      995               do while valid-handle(hh):
      996                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      997                   do:
      998                       case lc(hh:name) :
      999                           when "b-help" then
     1000                               do:
     1001                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1002                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1003                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1004                                   hh:TOOLTIP = "Помощь" .
     1005                                   v-help-old-x = hh:column .
     1006                                   v-help-old-y = hh:row    .
     1007                                   v-help-old-size = hh:width .
     1008                                   hh:width-chars = 2.5 .
     1009                               end.
     1010                           when "b-print" then
     1011                               do:
     1012                                   hh:load-image("cmp/b-print.bmp":u) .
     1013                                   hh:TOOLTIP = "Печать" .
     1014                                   v-h[ii] = hh:handle .
     1015                                   ii = ii + 1 .
     1016                                   hh:width-chars = 3 .
     1017                               end.
     1018                           when "b-history" or
     1019                           when "b-hist" then
     1020                               do:
     1021                                   hh:load-image("cmp/b-hist.bmp":u) .
     1022                                   hh:TOOLTIP = "История" .
     1023                                   v-h[ii] = hh:handle .
     1024                                   ii = ii + 1 .
     1025                                   hh:width-chars = 3 .
     1026                               end.
     1027                           when "b-sch" then
     1028                               do:
     1029                                   hh:load-image("cmp/b-sch.bmp":u) .
     1030                                   hh:TOOLTIP = "Установка Фильтра" .
     1031                                   v-h[ii] = hh:handle .
     1032                                   ii = ii + 1 .
     1033                                   hh:width-chars = 3 .
     1034                               end.
     1035                           when "b-hist-user" then
     1036                               do:
     1037                                   hh:load-image("cmp/b-hist.bmp":u) .
     1038                                   hh:TOOLTIP = "История пользователя" .
     1039                                   ii = ii + 1 .
     1040                               end.
     1041                       end case.
     1042                   end.
     1043                   hh = hh:next-sibling.
     1044               end.
     1045               b-help:column = v-frame-width - b-help:width-chars.
     1046               jj = 0.
     1047               repeat ii = 4 to 1 by -1 :
     1048                   if valid-handle (v-h[ii] ) then
     1049                   do:
     1050                       jj  = jj + 1 .
     1051                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1052                       v-h[ii]:row    = v-help-old-y .
     1053                   end.
     1054               end.
     1055           end.
     1056       end.
     1057   end procedure.
     1058   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1059   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1060   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1061   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1062   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1063   define variable v-diasize-current-frame-height as decimal   no-undo .
     1064   define variable v-diasize-change-size          as logical   no-undo .
     1065   define variable v-diasize-resize-button        as handle    no-undo .
     1066   define variable v-diasize-wndmax               as logical   no-undo .
     1067   define variable v-diasize-wndstore             as logical   no-undo .
     1068   define variable v-diasize-proc-name            as character no-undo .
     1069   define variable v-diasize-browse-handle        as handle    no-undo .
     1070   define variable v-diasize-browse-number        as integer   no-undo .
     1071   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1072   define temp-table temp-diasize-handle no-undo
     1073     field handle-value  as handle
     1074     field save-position as decimal
     1075     index xpk is primary unique handle-value
     1076     .
     1077   define temp-table temp-browse-handle no-undo
     1078     field browse-type   as character
     1079     field browse-number as integer
     1080     field browse-handle as handle
     1081     field original-size as decimal
     1082     index xpk is primary unique browse-type browse-number
     1083     index xie browse-type browse-handle
     1084   .
     1085   procedure diasize_change-height :
     1086     define input  parameter p-change-value  as decimal   no-undo .
     1087     define input  parameter p-move-resize   as logical   no-undo .
     1088     define variable v-field-group-handle    as handle    no-undo .
     1089     define variable v-object-handle         as handle    no-undo .
     1090     define variable v-frame-height          as decimal   no-undo .
     1091     define variable v-frame-virtual-height  as decimal   no-undo .
     1092     define variable v-browse-height         as decimal   no-undo .
     1093     define variable v-window-height         as decimal   no-undo .
     1094     define variable v-window-virtual-height as decimal   no-undo .
     1095     define variable v-change-sign           as integer   no-undo .
     1096     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1097     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1098     if p-change-value > 0
     1099     then do:
     1100       if frame Dialog-Frame :height + p-change-value
     1101           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1102       then do:
     1103         assign
     1104           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1105                           - (frame Dialog-Frame :height-chars)
     1106         .
     1107         if p-change-value <= 0
     1108         then do:
     1109           run diasize_position-resize-button in this-procedure .
     1110           return .
     1111         end.
     1112       end.
     1113     end.
     1114     if p-change-value < 0
     1115     then do:
     1116       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1117       then do:
     1118         assign
     1119           p-change-value = v-diasize-orig-frame-height
     1120                          - (frame Dialog-Frame :height-chars)
     1121         .
     1122         if p-change-value >= 0
     1123         then do:
     1124           run diasize_position-resize-button in this-procedure .
     1125           return .
     1126         end.
     1127       end.
     1128     end.
     1129     if p-change-value >= 0
     1130     then do:
     1131       assign
     1132         v-change-sign = 1
     1133       .
     1134     end.
     1135     else do:
     1136       assign
     1137         v-change-sign = -1
     1138       .
     1139     end.
     1140     assign
     1141       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1142     .
     1143     if p-change-value = 0
     1144     then do:
     1145       run diasize_position-resize-button in this-procedure .
     1146       return .
     1147     end.
     1148     move_block:
     1149     do
     1150     on error undo move_block, retry move_block
     1151     :
     1152       if retry
     1153       then do:
     1154         do
     1155         on error undo move_block, leave move_block
     1156         :
     1157           if p-change-value > 0
     1158           then do:
     1159             for each buf_temp-diasize-handle
     1160             on error undo, next
     1161             :
     1162               assign
     1163                 v-object-handle = buf_temp-diasize-handle.handle-value
     1164               .
     1165               if v-object-handle <> v-diasize-resize-button
     1166               then do:
     1167                 assign
     1168                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1169                 .
     1170               end.
     1171             end.
     1172             assign
     1173               v-diasize-browse-handle :height = v-browse-height
     1174             .
     1175             for each buf_temp-browse-handle
     1176               where buf_temp-browse-handle.browse-type = 'height':u
     1177             on error undo, next
     1178             :
     1179               assign
     1180                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1181               .
     1182             end.
     1183             assign
     1184               frame Dialog-Frame :height = v-frame-height
     1185             .
     1186             if frame Dialog-Frame :scrollable = true
     1187             then do:
     1188               assign
     1189                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1190               .
     1191             end.
     1192             run diasize_position-resize-button in this-procedure .
     1193           end.
     1194           else do:
     1195             if frame Dialog-Frame :scrollable = true
     1196             then do:
     1197               assign
     1198                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1199               .
     1200             end.
     1201             assign
     1202               frame Dialog-Frame :height = v-frame-height
     1203             .
     1204             assign
     1205               v-diasize-browse-handle :height = v-browse-height
     1206             .
     1207             for each buf_temp-browse-handle
     1208               where buf_temp-browse-handle.browse-type = 'height':u
     1209             on error undo, next
     1210             :
     1211               assign
     1212                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1213               .
     1214             end.
     1215             for each buf_temp-diasize-handle
     1216             on error undo, next
     1217             :
     1218               assign
     1219                 v-object-handle = buf_temp-diasize-handle.handle-value
     1220               .
     1221               if v-object-handle <> v-diasize-resize-button
     1222               then do:
     1223                 assign
     1224                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1225                 .
     1226               end.
     1227             end.
     1228             run diasize_position-resize-button in this-procedure .
     1229           end.
     1230           assign
     1231             v-diasize-change-size = false
     1232           .
     1233           leave move_block .
     1234         end.
     1235       end.
     1236       assign
     1237         v-diasize-need-full-display = true
     1238       .
     1239       if v-diasize-change-size = false
     1240       then do:
     1241         assign
     1242           v-diasize-change-size = true
     1243         .
     1244       end.
     1245       else do:
     1246         return .
     1247       end.
     1248       assign
     1249         v-frame-height = frame Dialog-Frame :height
     1250         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1251         v-browse-height = v-diasize-browse-handle :height
     1252       .
     1253       for each buf_temp-browse-handle
     1254         where buf_temp-browse-handle.browse-type = 'height':u
     1255       :
     1256         assign
     1257           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1258         .
     1259       end.
     1260       for each buf_temp-diasize-handle
     1261       :
     1262         delete buf_temp-diasize-handle .
     1263       end.
     1264       assign
     1265         v-field-group-handle = frame Dialog-Frame :first-child
     1266       .
     1267       do while valid-handle(v-field-group-handle)
     1268       :
     1269         assign
     1270           v-object-handle = v-field-group-handle :first-child
     1271         .
     1272         do while valid-handle(v-object-handle)
     1273         :
     1274           if  v-object-handle <> v-diasize-browse-handle :handle
     1275           and can-query(v-object-handle, "row")
     1276           and can-query(v-object-handle, "height")
     1277           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1278           then do:
     1279             find first buf_temp-browse-handle
     1280               where buf_temp-browse-handle.browse-type   = 'height':u
     1281                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1282               no-error .
     1283             if available buf_temp-browse-handle
     1284             then do:
     1285             end.
     1286             else do:
     1287               create buf_temp-diasize-handle .
     1288               assign
     1289                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1290                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1291               .
     1292             end.
     1293           end.
     1294           assign
     1295             v-object-handle = v-object-handle :next-sibling
     1296           .
     1297         end.
     1298         assign
     1299           v-field-group-handle = v-field-group-handle :next-sibling
     1300         .
     1301       end.
     1302       do with frame Dialog-Frame
     1303       :
     1304         hide v-diasize-resize-button .
     1305         assign
     1306           v-diasize-resize-button :row    = 1
     1307           v-diasize-resize-button :column = 1
     1308         .
     1309       end.
     1310       if p-change-value > 0
     1311       then do:
     1312         if frame Dialog-Frame :scrollable = true
     1313         then do:
     1314           assign
     1315             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1316             no-error .
     1317           if error-status :error
     1318           or error-status :get-message(1) <> ""
     1319           then do:
     1320             undo move_block, retry move_block .
     1321           end.
     1322         end.
     1323         assign
     1324           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1325           no-error .
     1326         if error-status :error
     1327         or error-status :get-message(1) <> ""
     1328         then do:
     1329           undo move_block, retry move_block .
     1330         end.
     1331         assign
     1332           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1333           no-error .
     1334         if error-status :error
     1335         or error-status :get-message(1) <> ""
     1336         then do:
     1337           undo move_block, retry move_block .
     1338         end.
     1339         for each buf_temp-browse-handle
     1340           where buf_temp-browse-handle.browse-type = 'height':u
     1341         on error undo move_block, retry move_block
     1342         :
     1343           assign
     1344             buf_temp-browse-handle.browse-handle :height
     1345               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1346             no-error .
     1347           if error-status :error
     1348           or error-status :get-message(1) <> ""
     1349           then do:
     1350             undo move_block, retry move_block .
     1351           end.
     1352         end.
     1353         for each buf_temp-diasize-handle
     1354         on error undo move_block, retry move_block
     1355         :
     1356           assign
     1357             v-object-handle = buf_temp-diasize-handle.handle-value
     1358           .
     1359           if v-object-handle <> v-diasize-resize-button
     1360           then do:
     1361             assign
     1362               v-object-handle :row = v-object-handle :row + p-change-value
     1363               no-error .
     1364             if error-status :error
     1365             or error-status :get-message(1) <> ""
     1366             then do:
     1367               undo move_block, retry move_block .
     1368             end.
     1369           end.
     1370         end.
     1371       end.
     1372       else do:
     1373         for each buf_temp-diasize-handle
     1374         on error undo move_block, retry move_block
     1375         :
     1376           assign
     1377             v-object-handle = buf_temp-diasize-handle.handle-value
     1378           .
     1379           if v-object-handle <> v-diasize-resize-button
     1380           then do:
     1381             assign
     1382               v-object-handle :row = v-object-handle :row + p-change-value
     1383               no-error .
     1384             if error-status :error
     1385             or error-status :get-message(1) <> ""
     1386             then do:
     1387               undo move_block, retry move_block .
     1388             end.
     1389           end.
     1390         end.
     1391         assign
     1392           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1393           no-error .
     1394         if error-status :error
     1395         or error-status :get-message(1) <> ""
     1396         then do:
     1397           undo move_block, retry move_block .
     1398         end.
     1399         for each buf_temp-browse-handle
     1400           where buf_temp-browse-handle.browse-type = 'height':u
     1401         on error undo move_block, retry move_block
     1402         :
     1403           assign
     1404             buf_temp-browse-handle.browse-handle :height
     1405               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1406             no-error .
     1407           if error-status :error
     1408           or error-status :get-message(1) <> ""
     1409           then do:
     1410             undo move_block, retry move_block .
     1411           end.
     1412         end.
     1413         assign
     1414           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1415           no-error .
     1416         if error-status :error
     1417         or error-status :get-message(1) <> ""
     1418         then do:
     1419           undo move_block, retry move_block .
     1420         end.
     1421         if frame Dialog-Frame :scrollable = true
     1422         then do:
     1423           assign
     1424             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1425             no-error .
     1426           if error-status :error
     1427           or error-status :get-message(1) <> ""
     1428           then do:
     1429             undo move_block, retry move_block .
     1430           end.
     1431         end.
     1432       end.
     1433       if p-move-resize = true
     1434       then do:
     1435         run diasize_position-resize-button in this-procedure .
     1436       end.
     1437       if v-diasize-wndstore = true
     1438       then do:
     1439         if connected("ub") = true
     1440         then do:
     1441           define variable v-cntxt-db-num        as integer   no-undo .
     1442           define variable v-cntxt-userid        as character no-undo .
     1443           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1444                                             , OUTPUT v-cntxt-userid
     1445                                             ) .
     1446           run gbl/wndsizew.p
     1447             (input  v-cntxt-db-num
     1448             ,input  v-cntxt-userid
     1449             ,input  v-diasize-proc-name
     1450             ,input  'height':u
     1451             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1452             ) .
     1453         end.
     1454       end.
     1455     end.
     1456     assign
     1457       v-diasize-change-size = false
     1458     .
     1459   end procedure.
     1460   procedure diasize_set-height :
     1461     define input  parameter p-new-height  as decimal   no-undo .
     1462     define input  parameter p-move-resize as logical   no-undo .
     1463     do
     1464     on error undo, return error return-value
     1465     :
     1466       run diasize_change-height in this-procedure
     1467         (input  (p-new-height - frame Dialog-Frame :height)
     1468         ,input  p-move-resize
     1469         ) .
     1470     end.
     1471   end procedure.
     1472   procedure diasize_change-width :
     1473     define input  parameter p-change-value as decimal   no-undo .
     1474     define input  parameter p-move-resize  as logical   no-undo .
     1475     define variable v-field-group-handle   as handle    no-undo .
     1476     define variable v-object-handle        as handle    no-undo .
     1477     define variable v-frame-width          as decimal   no-undo .
     1478     define variable v-frame-virtual-width  as decimal   no-undo .
     1479     define variable v-browse-width         as decimal   no-undo .
     1480     define variable v-window-width         as decimal   no-undo .
     1481     define variable v-window-virtual-width as decimal   no-undo .
     1482     define variable v-change-sign          as integer   no-undo .
     1483     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1484     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1485     if p-change-value > 0
     1486     then do:
     1487       if frame Dialog-Frame :width + p-change-value >
     1488           session :width-chars
     1489       then do:
     1490         assign
     1491           p-change-value = session :width-chars - frame Dialog-Frame :width
     1492         .
     1493         if p-change-value <= 0
     1494         then do:
     1495           run diasize_position-resize-button in this-procedure .
     1496           return .
     1497         end.
     1498       end.
     1499     end.
     1500     if p-change-value < 0
     1501     then do:
     1502       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1503       then do:
     1504         assign
     1505           p-change-value = v-diasize-orig-frame-width
     1506                          - frame Dialog-Frame :width
     1507         .
     1508         if p-change-value >= 0
     1509         then do:
     1510           run diasize_position-resize-button in this-procedure .
     1511           return .
     1512         end.
     1513       end.
     1514     end.
     1515     if p-change-value >= 0
     1516     then do:
     1517       assign
     1518         v-change-sign = 1
     1519       .
     1520     end.
     1521     else do:
     1522       assign
     1523         v-change-sign = -1
     1524       .
     1525     end.
     1526     assign
     1527       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1528     .
     1529     if p-change-value = 0
     1530     then do:
     1531       run diasize_position-resize-button in this-procedure .
     1532       return .
     1533     end.
     1534     move_block:
     1535     do
     1536     on error undo move_block, leave move_block
     1537     :
     1538       if retry
     1539       then do:
     1540         do
     1541         on error undo move_block, leave move_block
     1542         :
     1543           if p-change-value > 0
     1544           then do:
     1545             for each buf_temp-diasize-handle
     1546             on error undo, next
     1547             :
     1548               assign
     1549                 v-object-handle = buf_temp-diasize-handle.handle-value
     1550               .
     1551               if v-object-handle <> v-diasize-resize-button
     1552               then do:
     1553                 assign
     1554                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1555                 .
     1556               end.
     1557             end.
     1558             assign
     1559               v-diasize-browse-handle :width = v-browse-width
     1560             .
     1561             for each buf_temp-browse-handle
     1562               where buf_temp-browse-handle.browse-type = 'width':u
     1563             on error undo, next
     1564             :
     1565               assign
     1566                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1567               .
     1568             end.
     1569             assign
     1570               frame Dialog-Frame :width = v-frame-width
     1571             .
     1572             if frame Dialog-Frame :scrollable = true
     1573             then do:
     1574               assign
     1575                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1576               .
     1577             end.
     1578             run diasize_position-resize-button in this-procedure .
     1579           end.
     1580           else do:
     1581             if frame Dialog-Frame :scrollable = true
     1582             then do:
     1583               assign
     1584                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1585               .
     1586             end.
     1587             assign
     1588               frame Dialog-Frame :width = v-frame-width
     1589             .
     1590             for each buf_temp-browse-handle
     1591               where buf_temp-browse-handle.browse-type = 'width':u
     1592             on error undo, next
     1593             :
     1594               assign
     1595                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1596               .
     1597             end.
     1598             assign
     1599               v-diasize-browse-handle :width = v-browse-width
     1600             .
     1601             for each buf_temp-diasize-handle
     1602             on error undo, next
     1603             :
     1604               assign
     1605                 v-object-handle = buf_temp-diasize-handle.handle-value
     1606               .
     1607               if v-object-handle <> v-diasize-resize-button
     1608               then do:
     1609                 assign
     1610                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1611                 .
     1612               end.
     1613             end.
     1614             run diasize_position-resize-button in this-procedure .
     1615           end.
     1616           assign
     1617             v-diasize-change-size = false
     1618           .
     1619           leave move_block .
     1620         end.
     1621       end.
     1622       assign
     1623         v-diasize-need-full-display = true
     1624       .
     1625       if v-diasize-change-size = false
     1626       then do:
     1627         assign
     1628           v-diasize-change-size = true
     1629         .
     1630       end.
     1631       else do:
     1632         return .
     1633       end.
     1634       assign
     1635         v-frame-width = frame Dialog-Frame :width
     1636         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1637         v-browse-width = v-diasize-browse-handle :width
     1638       .
     1639       for each buf_temp-browse-handle
     1640         where buf_temp-browse-handle.browse-type = 'width':u
     1641       :
     1642         assign
     1643           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1644         .
     1645       end.
     1646       for each buf_temp-diasize-handle
     1647       :
     1648         delete buf_temp-diasize-handle .
     1649       end.
     1650       assign
     1651         v-field-group-handle = frame Dialog-Frame :first-child
     1652       .
     1653       do while valid-handle(v-field-group-handle)
     1654       :
     1655         assign
     1656           v-object-handle = v-field-group-handle :first-child
     1657         .
     1658         do while valid-handle(v-object-handle)
     1659         :
     1660           if  v-object-handle <> v-diasize-browse-handle :handle
     1661           and v-object-handle <> v-diasize-resize-button
     1662           and can-query(v-object-handle, "row")
     1663           and can-query(v-object-handle, "height")
     1664           and ( v-object-handle :col + v-object-handle :width
     1665                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1666               )
     1667           then do:
     1668             find first buf_temp-browse-handle
     1669               where buf_temp-browse-handle.browse-type   = 'width':u
     1670                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1671               no-error .
     1672             if available buf_temp-browse-handle
     1673             then do:
     1674             end.
     1675             else do:
     1676               create buf_temp-diasize-handle .
     1677               assign
     1678                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1679                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1680               .
     1681             end.
     1682           end.
     1683           assign
     1684             v-object-handle = v-object-handle :next-sibling
     1685           .
     1686         end.
     1687         assign
     1688           v-field-group-handle = v-field-group-handle :next-sibling
     1689         .
     1690       end.
     1691       do with frame Dialog-Frame
     1692       :
     1693         hide v-diasize-resize-button .
     1694         v-diasize-resize-button :row = 1.
     1695         v-diasize-resize-button :column = 1.
     1696       end.
     1697       if p-change-value > 0
     1698       then do:
     1699         if frame Dialog-Frame :scrollable = true
     1700         then do:
     1701           assign
     1702             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1703             no-error .
     1704           if error-status :error
     1705           or error-status :get-message(1) <> ""
     1706           then do:
     1707             undo move_block, retry move_block.
     1708           end.
     1709         end.
     1710         assign
     1711           frame Dialog-Frame :width = v-frame-width + p-change-value
     1712           no-error .
     1713         if error-status :error
     1714         or error-status :get-message(1) <> ""
     1715         then do:
     1716           undo move_block, retry move_block.
     1717         end.
     1718         assign
     1719           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1720         no-error .
     1721         if error-status :error
     1722         or error-status :get-message(1) <> ""
     1723         then do:
     1724           undo move_block, retry move_block.
     1725         end.
     1726         for each buf_temp-browse-handle
     1727           where buf_temp-browse-handle.browse-type = 'width':u
     1728         on error undo move_block, retry move_block
     1729         :
     1730           assign
     1731             buf_temp-browse-handle.browse-handle :width
     1732               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1733             no-error .
     1734           if error-status :error
     1735           or error-status :get-message(1) <> ""
     1736           then do:
     1737             undo move_block, retry move_block .
     1738           end.
     1739         end.
     1740         for each buf_temp-diasize-handle
     1741         on error undo move_block, retry move_block
     1742         :
     1743           assign
     1744             v-object-handle = buf_temp-diasize-handle.handle-value
     1745           .
     1746           if v-object-handle <> v-diasize-resize-button
     1747           then do:
     1748             assign
     1749               v-object-handle :col = v-object-handle :col + p-change-value
     1750               no-error .
     1751             if error-status :error
     1752             or error-status :get-message(1) <> ""
     1753             then do:
     1754               undo move_block, retry move_block .
     1755             end.
     1756           end.
     1757         end.
     1758       end.
     1759       else do:
     1760         for each buf_temp-diasize-handle
     1761         on error undo move_block, retry move_block
     1762         :
     1763           assign
     1764             v-object-handle = buf_temp-diasize-handle.handle-value
     1765           .
     1766           if v-object-handle <> v-diasize-resize-button
     1767           then do:
     1768             assign
     1769               v-object-handle :col = v-object-handle :col + p-change-value
     1770               no-error .
     1771             if error-status :error
     1772             or error-status :get-message(1) <> ""
     1773             then do:
     1774               undo move_block, retry move_block .
     1775             end.
     1776           end.
     1777         end.
     1778         for each buf_temp-browse-handle
     1779           where buf_temp-browse-handle.browse-type = 'width':u
     1780         on error undo move_block, retry move_block
     1781         :
     1782           assign
     1783             buf_temp-browse-handle.browse-handle :width
     1784               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1785             no-error .
     1786           if error-status :error
     1787           or error-status :get-message(1) <> ""
     1788           then do:
     1789             undo move_block, retry move_block .
     1790           end.
     1791         end.
     1792         assign
     1793           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1794           no-error .
     1795         if error-status :error
     1796         or error-status :get-message(1) <> ""
     1797         then do:
     1798           undo move_block, retry move_block.
     1799         end.
     1800         assign
     1801           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1802         no-error .
     1803         if error-status :error
     1804         or error-status :get-message(1) <> ""
     1805         then do:
     1806           undo move_block, retry move_block.
     1807         end.
     1808         if frame Dialog-Frame :scrollable = true
     1809         then do:
     1810           assign
     1811             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1812           no-error .
     1813           if error-status :error
     1814           or error-status :get-message(1) <> ""
     1815           then do:
     1816             undo move_block, retry move_block.
     1817           end.
     1818         end.
     1819       end.
     1820       if p-move-resize
     1821       then do:
     1822         run diasize_position-resize-button in this-procedure .
     1823       end.
     1824       if v-diasize-wndstore = true
     1825       then do:
     1826         if connected("ub") = true
     1827         then do:
     1828           define variable v-cntxt-db-num        as integer   no-undo .
     1829           define variable v-cntxt-userid        as character no-undo .
     1830           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1831                                             , OUTPUT v-cntxt-userid
     1832                                             ) .
     1833           run gbl/wndsizew.p
     1834             (input  v-cntxt-db-num
     1835             ,input  v-cntxt-userid
     1836             ,input  v-diasize-proc-name
     1837             ,input  'width':u
     1838             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1839             ) .
     1840         end.
     1841       end.
     1842     end.
     1843     assign
     1844       v-diasize-change-size = false
     1845     .
     1846   end procedure.
     1847   procedure diasize_set-width :
     1848     define input  parameter p-new-width  as decimal   no-undo .
     1849     define input  parameter p-move-resize as logical   no-undo .
     1850     do
     1851     on error undo, return error return-value
     1852     :
     1853       run diasize_change-width in this-procedure
     1854         (input  (p-new-width - frame Dialog-Frame :width)
     1855         ,input  p-move-resize
     1856         ) .
     1857     end.
     1858   end procedure.
     1859   procedure diasize_position-resize-button :
     1860     do with frame Dialog-Frame
     1861     :
     1862       hide v-diasize-resize-button .
     1863       assign
     1864         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1865                     - 1
     1866                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1867         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1868                     - 1
     1869                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1870       .
     1871       view v-diasize-resize-button .
     1872     end.
     1873   end procedure.
     1874   on alt-right anywhere
     1875   do:
     1876     run diasize_change-width in this-procedure
     1877       (input 1
     1878       ,input true
     1879       ) .
     1880     return no-apply .
     1881   end.
     1882   on alt-left anywhere
     1883   do:
     1884     run diasize_change-width in this-procedure
     1885       (input -1
     1886       ,input true
     1887       ) .
     1888     return no-apply .
     1889   end.
     1890   on alt-down anywhere
     1891   do:
     1892     run diasize_change-height in this-procedure
     1893       (input 1
     1894       ,input true
     1895       ) .
     1896     return no-apply .
     1897   end.
     1898   on alt-up anywhere
     1899   do:
     1900     run diasize_change-height in this-procedure
     1901       (input -1
     1902       ,input true
     1903       ) .
     1904     return no-apply .
     1905   end.
     1906   on alt-enter of frame Dialog-Frame
     1907   do:
     1908     run diasize_maximize in this-procedure
     1909       (input  ?
     1910       ).
     1911     return no-apply .
     1912   end.
     1913   procedure diasize_end-move :
     1914     do
     1915     on error undo, return error return-value
     1916     :
     1917       define variable v-row-delta as decimal   no-undo .
     1918       define variable v-col-delta as decimal   no-undo .
     1919       define variable v-new-row as decimal   no-undo .
     1920       define variable v-new-col as decimal   no-undo .
     1921       assign
     1922         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1923         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1924       .
     1925       assign
     1926         v-row-delta = v-new-row - frame Dialog-Frame :height
     1927         v-col-delta = v-new-col - frame Dialog-Frame :width
     1928       .
     1929       run diasize_change-height in this-procedure
     1930         (input v-row-delta
     1931         ,input true
     1932         ) .
     1933       run diasize_change-width in this-procedure
     1934         (input v-col-delta
     1935         ,input true
     1936         ) .
     1937     end.
     1938   end procedure.
     1939   procedure diasize_maximize :
     1940     define input  parameter p-action as logical   no-undo .
     1941     do
     1942     on error undo, return error return-value
     1943     :
     1944       if p-action = ?
     1945       then do:
     1946         if v-diasize-need-maximize = true
     1947         then do:
     1948           assign
     1949             p-action = true
     1950           .
     1951         end.
     1952         else do:
     1953           assign
     1954             p-action = false
     1955           .
     1956         end.
     1957       end.
     1958       if p-action = true
     1959       then do:
     1960         run diasize_change-height in this-procedure
     1961           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1962               - frame Dialog-Frame :height-chars
     1963           ,input true
     1964           ) .
     1965         run diasize_change-width in this-procedure
     1966           (input session :width-chars
     1967               - frame Dialog-Frame :width-chars
     1968           ,input true
     1969           ) .
     1970         assign
     1971           v-diasize-need-maximize = false
     1972         .
     1973       end.
     1974       else do:
     1975         run diasize_change-width in this-procedure
     1976           (input v-diasize-orig-frame-width
     1977               - frame Dialog-Frame :width-chars
     1978           ,input true
     1979           ) .
     1980         run diasize_change-height in this-procedure
     1981           (input v-diasize-orig-frame-height
     1982               - frame Dialog-Frame :height-chars
     1983           ,input true
     1984           ) .
     1985         assign
     1986           v-diasize-need-maximize = true
     1987         .
     1988       end.
     1989     end.
     1990   end procedure.
     1991   procedure diasize_restore-orig-size :
     1992     do
     1993     on error undo, return error return-value
     1994     :
     1995       assign
     1996         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1997         v-diasize-current-frame-height = frame Dialog-Frame :height
     1998       .
     1999       run diasize_set-height in this-procedure
     2000         (input  v-diasize-orig-frame-height
     2001         ,input  true
     2002         ) .
     2003       run diasize_set-width in this-procedure
     2004         (input  v-diasize-orig-frame-width
     2005         ,input  true
     2006         ) .
     2007     end.
     2008   end procedure.
     2009   procedure diasize_restore-current-size :
     2010     do
     2011     on error undo, return error return-value
     2012     :
     2013       run diasize_set-height in this-procedure
     2014         (input  v-diasize-current-frame-height
     2015         ,input  true
     2016         ) .
     2017       run diasize_set-width in this-procedure
     2018         (input  v-diasize-current-frame-width
     2019         ,input  true
     2020         ) .
     2021     end.
     2022   end procedure.
     2023   procedure diasize_set-browse-handle :
     2024     define input  parameter p-browse-handle as handle   no-undo .
     2025     define buffer buf_temp-browse-handle for temp-browse-handle .
     2026     do
     2027     on error undo, return error return-value
     2028     :
     2029       assign
     2030         v-diasize-browse-handle = p-browse-handle
     2031       .
     2032       for each buf_temp-browse-handle
     2033       on error undo, return error return-value
     2034       :
     2035         delete buf_temp-browse-handle .
     2036       end.
     2037     end.
     2038   end procedure.
     2039   procedure diasize_add_browse :
     2040     define input  parameter p-browse-type   as character no-undo .
     2041     define input  parameter p-browse-handle as handle    no-undo .
     2042     define buffer buf_temp-browse-handle for temp-browse-handle .
     2043     do
     2044     on error undo, return error return-value
     2045     :
     2046       assign
     2047         v-diasize-browse-number = v-diasize-browse-number + 1
     2048       .
     2049       create buf_temp-browse-handle .
     2050       assign
     2051         buf_temp-browse-handle.browse-type   = p-browse-type
     2052         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2053         buf_temp-browse-handle.browse-handle = p-browse-handle
     2054       .
     2055     end.
     2056   end procedure.
     2057   procedure diasize_init :
     2058     define variable v-default-value    as logical   no-undo .
     2059     define variable v-restore-saved    as logical   no-undo .
     2060     define variable v-resize-value-str as character no-undo .
     2061     do
     2062     on error undo, return error return-value
     2063     :
     2064       do with frame Dialog-Frame
     2065       :
     2066         assign
     2067           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2068           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2069           v-diasize-browse-handle     = browse br-dis-grp :handle
     2070         .
     2071         create button v-diasize-resize-button
     2072         assign
     2073           parent        = frame Dialog-Frame :first-child
     2074           label         = "s"
     2075           height-pixels = 16
     2076           width-pixels  = 16
     2077           visible       = true
     2078           sensitive     = true
     2079           movable       = true
     2080           triggers:
     2081             on end-move persistent run diasize_end-move in this-procedure .
     2082           end triggers.
     2083         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2084         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2085         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2086         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2087         assign
     2088           v-diasize-wndmax = false
     2089         .
     2090         if connected("ub") = true
     2091         then do:
     2092           define variable v-cntxt-db-num        as integer   no-undo .
     2093           define variable v-cntxt-userid        as character no-undo .
     2094           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2095                                             , OUTPUT v-cntxt-userid
     2096                                             ) .
     2097           run gbl/wndpar_r.p
     2098             (input  v-cntxt-db-num
     2099             ,input  v-cntxt-userid
     2100             ,input  'wndmax':U
     2101             ,output v-diasize-wndmax
     2102             ,output v-default-value
     2103             ) .
     2104         end.
     2105         assign
     2106           v-diasize-wndstore = false
     2107         .
     2108         if connected("ub") = true
     2109         then do:
     2110           run gbl/wndpar_r.p
     2111             (input  v-cntxt-db-num
     2112             ,input  v-cntxt-userid
     2113             ,input  'wndstore':U
     2114             ,output v-diasize-wndstore
     2115             ,output v-default-value
     2116             ) .
     2117         end.
     2118         assign
     2119           v-diasize-proc-name = entry(1, program-name(2), '.')
     2120         .
     2121         if v-diasize-wndstore = true
     2122         then do:
     2123           assign
     2124             v-restore-saved = false
     2125           .
     2126           if connected("ub") = true
     2127           then do:
     2128             run gbl/wndsizer.p
     2129               (input  v-cntxt-db-num
     2130               ,input  v-cntxt-userid
     2131               ,input  v-diasize-proc-name
     2132               ,input  'height':u
     2133               ,output v-resize-value-str
     2134               ) .
     2135             if v-resize-value-str <> '':U
     2136             then do:
     2137               run diasize_change-height in this-procedure
     2138                 (input  integer(v-resize-value-str)
     2139                 ,input  true
     2140                 ) .
     2141               assign
     2142                 v-restore-saved = true
     2143               .
     2144             end.
     2145           end.
     2146           if connected("ub") = true
     2147           then do:
     2148             run gbl/wndsizer.p
     2149               (input  v-cntxt-db-num
     2150               ,input  v-cntxt-userid
     2151               ,input  v-diasize-proc-name
     2152               ,input  'width':u
     2153               ,output v-resize-value-str
     2154               ) .
     2155             if v-resize-value-str <> '':U
     2156             then do:
     2157               run diasize_change-width in this-procedure
     2158                 (input  integer(v-resize-value-str)
     2159                 ,input  true
     2160                 ) .
     2161               assign
     2162                 v-restore-saved = true
     2163               .
     2164             end.
     2165           end.
     2166           if v-restore-saved <> true
     2167           then do:
     2168             if v-diasize-wndmax = true
     2169             then do:
     2170               run diasize_maximize in this-procedure
     2171                 (input  true
     2172                 ) .
     2173             end.
     2174           end.
     2175         end.
     2176         else do:
     2177           if v-diasize-wndmax = true
     2178           then do:
     2179             run diasize_maximize in this-procedure
     2180               (input  true
     2181               ) .
     2182           end.
     2183         end.
     2184       end.
     2185     end.
     2186   end procedure.
     2187   procedure diasize_need-full-display :
     2188     define output parameter p-need-full-display as logical   no-undo .
     2189     do
     2190     on error undo, return error return-value
     2191     :
     2192       assign
     2193         p-need-full-display = v-diasize-need-full-display
     2194       .
     2195       assign
     2196         v-diasize-need-full-display = false
     2197       .
     2198     end.
     2199   end procedure.
     2200   procedure get-context :
     2201      define output parameter p-db-num as integer          no-undo.
     2202      define output parameter p-user-id as character        no-undo.
     2203      define variable v-login               as character    no-undo.
     2204      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2205      define buffer buf_user-login  for ub.user-login .
     2206      do
     2207      on error undo, return error
     2208      :
     2209            FIND FIRST buf_sys-ctrl no-lock.
     2210            ASSIGN
     2211               v-login = USERID("ub")
     2212               p-db-num = buf_sys-ctrl.db-num
     2213            .
     2214            FIND FIRST buf_user-login
     2215                 WHERE buf_user-login.db-num = p-db-num
     2216                   AND buf_user-login.user-login = v-login
     2217                 no-lock
     2218                 no-error
     2219                 .
     2220            IF AVAILABLE buf_user-login
     2221            THEN DO:
     2222               assign
     2223                  p-user-id = buf_user-login.user-id
     2224               .
     2225            END.
     2226      end.
     2227   end procedure.
     2228       run diasize_init in this-procedure .
     2229    frame Dialog-Frame:TITLE = frame Dialog-Frame:TITLE.
     2230   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2231   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2232   MAIN-BLOCK:
     2233   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2234      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2235   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2236     run mainmenu_getcntxt in parparentproc
     2237       (output v-cntxt-db-num
     2238       ,output v-cntxt-userid
     2239       ,output v-cntxt-level
     2240       ,output v-cntxt-host-code-obj
     2241       ,output v-cntxt-obj-type
     2242       ,output v-cntxt-obj-code
     2243       ,output v-cntxt-db-num-obj
     2244       ,output v-cntxt-is-admin
     2245       ) .
     2246     if v-cntxt-db-num = 0 then do:
     2247   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2248   do:
     2249     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2250       (input  v-cntxt-db-num
     2251       ,input  v-cntxt-userid
     2252       ,input  0
     2253       ,input  'actn_grp-discount_global_work':U
     2254       ,input  'global':U
     2255       ,input  0
     2256       ,input  '':U
     2257       ,input  0
     2258       ,input  0
     2259       ,input  0
     2260       ,input  0
     2261       ,input  false
     2262       ,output loc-glob
     2263       )  .
     2264   end.
     2265   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2266   do:
     2267     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2268       (input  v-cntxt-db-num
     2269       ,input  v-cntxt-userid
     2270       ,input  0
     2271       ,input  'actn_grp-discount_firm_work':U
     2272       ,input  'firm':U
     2273       ,input  p-host-code
     2274       ,input  '':U
     2275       ,input  0
     2276       ,input  0
     2277       ,input  0
     2278       ,input  0
     2279       ,input  false
     2280       ,output loc-firm
     2281       )  .
     2282   end.
     2283      end.
     2284   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2285   do:
     2286     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2287       (input  v-cntxt-db-num
     2288       ,input  v-cntxt-userid
     2289       ,input  0
     2290       ,input  'actn_grp-discount_object_work':U
     2291       ,input  'object':U
     2292       ,input  p-host-code
     2293       ,input  p-obj-type
     2294       ,input  p-obj-code
     2295       ,input  0
     2296       ,input  0
     2297       ,input  0
     2298       ,input  false
     2299       ,output loc-object
     2300       )  .
     2301   end.
     2302     if ((if v-cntxt-db-num = 0 and loc-glob then 1 else 0) +
     2303     (if v-cntxt-db-num = 0 and loc-firm then 1 else 0) +
     2304     (if loc-object then 1 else 0)) = 0 then do:
     2305       message
     2306       "У Вас отсутствуют права на назначение скидки на группу как по объекту, так и по фирме и глобально" skip
     2307       "либо Вы находитесь в БД, в которой их назначить невозможно"
     2308       view-as alert-box error .
     2309       undo, return.
     2310     end.
     2311     RUN MyEnable in this-procedure no-error.
     2312     if error-status:error then return error.
     2313     Run init-proc in this-procedure .
     2314     view frame Dialog-Frame .
     2315     WAIT-FOR GO OF FRAME Dialog-Frame.
     2316   END.
     2317   RUN disable_UI in this-procedure .
     2318   if updated then return 'ИЗМЕНЕНИЕ':U.
     2319   PROCEDURE disable_UI :
     2320     HIDE FRAME Dialog-Frame.
     2321   END PROCEDURE.
     2322   PROCEDURE enable_UI :
     2323     DISPLAY v-grp-name cd-grp-code
     2324         WITH FRAME Dialog-Frame.
     2325     ENABLE b-quit b-ins b-lkp b-chg b-del b-help v-grp-name cd-grp-code
     2326         WITH FRAME Dialog-Frame.
     2327     VIEW FRAME Dialog-Frame.
     2328     OPEN QUERY br-dis-grp FOR EACH temp-grpdisc NO-LOCK.
     2329   END PROCEDURE.
     2330   PROCEDURE init-proc :
     2331   define variable v-rule-label as character no-undo .
     2332   define buffer buf_sum-grp for ub.sum-grp.
     2333   define buffer buf_cli-grp for ub.cli-grp.
     2334   define buffer buf_dis-grp-rule for ub.dis-grp-rule.
     2335   for each temp-grpdisc:
     2336     if p-mode = 'ИЗМЕНЕНИЕ':U
     2337     and (temp-grpdisc.obj-type = p-obj-type
     2338       and
     2339       temp-grpdisc.obj-code = p-obj-code)
     2340     or (v-cntxt-db-num = 0
     2341       and temp-grpdisc.obj-type = '':U
     2342       and
     2343       temp-grpdisc.obj-code = 0)
     2344     or (v-cntxt-db-num = 0
     2345       and temp-grpdisc.obj-type = 'орг':U
     2346       and temp-grpdisc.obj-code = p-host-code)
     2347       then do:
     2348     end.
     2349     else do:
     2350       delete temp-grpdisc.
     2351     end.
     2352   end.
     2353   add-option = "".
     2354   CASE p-classif-type:
     2355     when 'sum-grp':U then do:
     2356       find first buf_sum-grp no-lock where
     2357                 buf_sum-grp.grp-code = p-node-code no-error .
     2358       Assign
     2359       cd-grp-code = buf_sum-grp.grp-code
     2360       .
     2361     end.
     2362     when 'cli-grp':U then do:
     2363       find first buf_cli-grp no-lock where
     2364                 buf_cli-grp.node-code = p-node-code no-error .
     2365       Assign
     2366       cd-grp-code = buf_cli-grp.node-code
     2367       .
     2368     end.
     2369   end case.
     2370   display
     2371   cd-grp-code
     2372   with frame Dialog-Frame  .
     2373   For each buf_dis-grp-rule where
     2374           buf_dis-grp-rule.classif-type  = p-classif-type
     2375       and  buf_dis-grp-rule.node-code  = p-node-code no-lock :
     2376     find first temp-grpdisc no-lock where
     2377               temp-grpdisc.classif-type =  buf_dis-grp-rule.classif-type
     2378           and temp-grpdisc.node-code =  buf_dis-grp-rule.node-code
     2379           and temp-grpdisc.host-code = buf_dis-grp-rule.host-code
     2380           AND temp-grpdisc.obj-type = buf_dis-grp-rule.obj-type
     2381           AND temp-grpdisc.obj-code = buf_dis-grp-rule.obj-code
     2382           AND temp-grpdisc.pos-type = buf_dis-grp-rule.pos-type
     2383           AND temp-grpdisc.discnt-role = buf_dis-grp-rule.discnt-role
     2384           AND temp-grpdisc.nonunique = buf_dis-grp-rule.nonunique no-error .
     2385     if not available temp-grpdisc then do:
     2386        create temp-grpdisc.
     2387        assign
     2388        temp-grpdisc.classif-type =  buf_dis-grp-rule.classif-type
     2389       temp-grpdisc.node-code =  buf_dis-grp-rule.node-code
     2390       temp-grpdisc.host-code = buf_dis-grp-rule.host-code
     2391       temp-grpdisc.obj-type = buf_dis-grp-rule.obj-type
     2392       temp-grpdisc.obj-code = buf_dis-grp-rule.obj-code
     2393       temp-grpdisc.pos-type = buf_dis-grp-rule.pos-type
     2394       temp-grpdisc.discnt-role = buf_dis-grp-rule.discnt-role
     2395       temp-grpdisc.nonunique = buf_dis-grp-rule.nonunique
     2396       .
     2397     end.
     2398     assign
     2399     temp-grpdisc.rule-num = buf_Dis-grp-rule.rule-num
     2400     temp-grpdisc.rl-root = buf_Dis-grp-rule.rl-root
     2401     temp-grpdisc.templ-rl-root = buf_Dis-grp-rule.templ-rl-root
     2402     temp-grpdisc.time-templ-rl-root = buf_Dis-grp-rule.time-templ-rl-root
     2403     .
     2404     run disgrpru-name ( input buf_dis-grp-rule.templ-rl-root
     2405                         ,output v-rule-label
     2406                           ).
     2407     assign
     2408     temp-grpdisc.rule-label = v-rule-label
     2409     .
     2410   End.
     2411   OPEN QUERY br-dis-grp FOR EACH temp-grpdisc NO-LOCK.
     2412   END PROCEDURE.
     2413   PROCEDURE MyEnable :
     2414   DEFINE BUFFER buf_sum-grp FOR ub.sum-grp.
     2415   DEFINE BUFFER buf_cli-grp FOR ub.cli-grp.
     2416   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     2417   DEFINE VARIABLE v-h AS WIDGET-HANDLE NO-UNDO.
     2418   v-h = br-dis-grp:FIRST-COLUMN IN FRAME Dialog-Frame.
     2419   DO while valid-handle(v-h) :
     2420     if v-h:LABEL = 'Тип скидки' then do:
     2421       v-h:RESIZABLE = YES.
     2422       leave.
     2423     end.
     2424     ELSE DO:
     2425       v-h = v-h:NEXT-COLUMN.
     2426     END.
     2427   END.
     2428   IF p-obj-type = 'маг':U THEN DO:
     2429   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2430   define variable v-param-type15 as character no-undo .
     2431   define variable v-value-date15 as date no-undo .
     2432   define variable v-value-decimal15 as decimal no-undo .
     2433   define variable v-value-integer15 as INTEGER no-undo .
     2434   define variable v-value-logical15 AS LOGICAL no-undo .
     2435   define variable v-tth15 as handle no-undo .
     2436   run adm/shattri.p (
     2437       input "get":U
     2438       ,input  p-obj-type
     2439       ,input  p-obj-code
     2440       ,input  'cd-sending':U
     2441       ,input  'dflt-cd':U
     2442       ,output dflt-cd
     2443       ,output v-value-date15
     2444       ,output v-value-decimal15
     2445       ,output v-value-integer15
     2446       ,output v-value-logical15
     2447       ,output v-param-type15
     2448       ,INPUT-OUTPUT table-handle v-tth15
     2449       )  .
     2450   delete object v-tth15 no-error.
     2451     for each buf_dis-cfg-rule no-lock where
     2452               buf_Dis-cfg-rule.table-name = 'dis-grp-rule':U
     2453           and buf_Dis-cfg-rule.self-nonunique = p-classif-type:
     2454       if buf_dis-cfg-rule.pos-type = dflt-cd then leave.
     2455     end.
     2456     if not available buf_dis-cfg-rule then do:
     2457        dflt-cd = '':U.
     2458     end.
     2459   END.
     2460   if p-obj-type = 'скл':U then do:
     2461     dflt-cd = '-':U.
     2462   end.
     2463   ASSIGN
     2464   b-ins:POPUP-MENU IN FRAME Dialog-Frame = MENU MENU-b-ins:HANDLE
     2465   b-ins:MENU-MOUSE = 1
     2466   MENU-ITEM m_pos-type:LABEL IN MENU menu-b-ins  = (if dflt-cd = '':U then "Нет скидок  для касс" else dflt-cd)
     2467   MENU-ITEM m_pos-type:sensitive IN MENU menu-b-ins  = ((dflt-cd <> '':U) and (dflt-cd <> '-':U))
     2468   .
     2469   assign
     2470   v-tab-order = "b-quit,b-ins,b-lkp,b-chg,b-del,b-help,br-dis-grp".
     2471   case p-classif-type:
     2472     when 'sum-grp':U then do:
     2473       FIND FIRST buf_sum-grp NO-LOCK WHERE
     2474                   buf_sum-grp.grp-code = p-node-code NO-ERROR.
     2475       IF AVAILABLE buf_sum-grp THEN DO:
     2476           ASSIGN
     2477           v-grp-name = buf_sum-grp.grp-name.
     2478       END.
     2479     end.
     2480     when 'cli-grp':U then do:
     2481       FIND FIRST buf_cli-grp NO-LOCK WHERE
     2482                   buf_cli-grp.node-code = p-node-code NO-ERROR.
     2483       IF AVAILABLE buf_cli-grp THEN DO:
     2484         RUN cli-grplib-get-full-name  IN THIS-PROCEDURE ( INPUT p-node-code, OUTPUT v-grp-name) NO-ERROR.
     2485       END.
     2486     end.
     2487   end case.
     2488   ASSIGN b-ins:MENU-MOUSE in frame Dialog-Frame  = 1.
     2489   DISPLAY
     2490   v-grp-name
     2491   WITH FRAME Dialog-Frame .
     2492   ENABLE
     2493   b-quit
     2494   b-del when p-mode = 'ИЗМЕНЕНИЕ':U
     2495   b-ins when p-mode = 'ИЗМЕНЕНИЕ':U
     2496   b-chg when p-mode = 'ИЗМЕНЕНИЕ':U
     2497   b-lkp
     2498   b-help br-dis-grp
     2499   WITH FRAME Dialog-Frame .
     2500   VIEW FRAME Dialog-Frame .
     2501   OPEN QUERY br-dis-grp FOR EACH temp-grpdisc NO-LOCK.
     2502   APPLY "ENTRY" to br-dis-grp.
     2503   END PROCEDURE.
     2504   PROCEDURE proc-add-chg :
     2505   define input parameter p-add as logical no-undo .
     2506   define input parameter p-pos-type as character no-undo .
     2507   define variable v-rule-label as character no-undo .
     2508   DEFINE VARIABLE v-rule-num as integer no-undo .
     2509   define variable v-setted as logical no-undo .
     2510   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2511   define variable v-templ-rl-root as integer no-undo .
     2512   define variable v-time-templ-rl-root as integer no-undo .
     2513   define variable v-cfg-nonunique as character no-undo .
     2514   define variable v-nonunique as character no-undo .
     2515   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     2516   define buffer buf_dis-grp-rule for ub.dis-grp-rule.
     2517   define buffer buf_temp-grpdisc for temp-grpdisc.
     2518   define variable v-discnt-role as character no-undo .
     2519   DEFINE VARIABLE v-deleted as logical no-undo .
     2520   define variable v-check as character no-undo .
     2521   define variable v-error-code as character no-undo .
     2522   define variable v-correct as logical no-undo .
     2523   define variable v-host-code like ub.sysconf.host-code no-undo .
     2524   define variable v-obj-type like ub.clients.obj-type no-undo .
     2525   define variable v-obj-code like ub.clients.obj-code no-undo .
     2526   define variable v-ask-labels as character no-undo .
     2527   define variable choice as integer no-undo .
     2528   define var loc#log as logical no-undo.
     2529   CASE p-add:
     2530     when yes then do:
     2531       run ref/dis-pos.w ( INPUT parparentproc
     2532                           ,INPUT "b-sel":U
     2533                           ,INPUT "cd-type-list"
     2534                           ,INPUT (if v-cntxt-db-num = 0 then 1 else 0)
     2535                           ,INPUT (if v-cntxt-db-num = 0 then 1 else 0)
     2536                           ,INPUT 1
     2537                           ,input 'dis-grp-rule':U
     2538                           ,input p-classif-type
     2539                           ,input ?
     2540                           ,INPUT p-pos-type
     2541                           ,input '':U
     2542                           ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2543      IF ERROR-STATUS:ERROR
     2544      OR v-rid-list = '':U THEN DO:
     2545         RETURN.
     2546      END.
     2547      FIND FIRST buf_dis-cfg-rule NO-LOCK where
     2548                recid(buf_dis-cfg-rule) = INTEGER(v-rid-list).
     2549       assign
     2550       v-templ-rl-root = buf_dis-cfg-rule.templ-rl-root
     2551       v-time-templ-rl-root = buf_dis-cfg-rule.time-templ-rl-root
     2552       V-cfg-NONUNIQUE = buf_dis-cfg-rule.nonunique
     2553       v-discnt-role = buf_dis-cfg-rule.discnt-role
     2554       .
     2555      assign
     2556       added = yes.
     2557       v-rule-num = 0.
     2558      if (buf_dis-cfg-rule.has-global +
     2559          buf_dis-cfg-rule.has-host +
     2560          buf_dis-cfg-rule.has-obj) > 1 then do:
     2561         define variable v-sel-vals as character no-undo .
     2562         define variable v-sel-labels as character no-undo .
     2563         define variable var-region as character no-undo .
     2564         assign
     2565         v-sel-vals = v-sel-vals +
     2566                       (if buf_dis-cfg-rule.has-global = 1
     2567                       then (fill(chr(32), 3)  + string(0) + chr(44))
     2568                       else "":U)
     2569         v-sel-labels = v-sel-labels +
     2570                       (if buf_dis-cfg-rule.has-global  = 1
     2571                       then ("Глобально" + chr(44))
     2572                       else "":U)
     2573         .
     2574         assign
     2575         v-sel-vals = v-sel-vals +
     2576                       (if buf_dis-cfg-rule.has-host = 1
     2577                       then ('орг':U  + string(v-cntxt-host-code-obj)  + chr(44))
     2578                       else "":U)
     2579         v-sel-labels = v-sel-labels +
     2580                       (if buf_dis-cfg-rule.has-host = 1
     2581                       then ("Фирма"  + string(v-cntxt-host-code-obj) + chr(44))
     2582                       else "":U)
     2583         .
     2584         assign
     2585         v-sel-vals = v-sel-vals +
     2586                       (if buf_dis-cfg-rule.has-obj = 1
     2587                       then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(44))
     2588                       else "":U)
     2589         v-sel-labels = v-sel-labels +
     2590                       (if buf_dis-cfg-rule.has-obj = 1
     2591                       then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(44))
     2592                       else "":U)
     2593         .
     2594         run gbl/d-list.w (
     2595                             input "b-sel":U
     2596                             ,input "Выберите область действия"
     2597                             ,input v-sel-vals
     2598                             ,input v-sel-labels
     2599                             ,input chr(44)
     2600                             ,input "":U
     2601                             ,output var-region) no-error.
     2602         if error-status:error then do:
     2603           return error.
     2604         end.
     2605         assign
     2606         v-obj-type = trim(substring(var-region, 1, 3))
     2607         v-obj-code = integer(substring(var-region, 4))
     2608         v-host-code = (IF v-obj-type = "" THEN 0 ELSE v-obj-code)
     2609         v-host-code = (if var-region begins 'орг':U
     2610                        then integer(substring(var-region, 4))
     2611                        else 0)
     2612         v-obj-code = (if v-obj-type = 'орг':U then 0 else v-obj-code)
     2613         v-obj-type = (if v-obj-type = 'орг':U then "" else v-obj-type)
     2614         .
     2615         if v-host-code = 0
     2616          and v-obj-type <> '':U then do:
     2617   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2618   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2619     (input  v-obj-type
     2620     ,input  v-obj-code
     2621     ,output v-host-code
     2622     )  .
     2623         end.
     2624       end.
     2625       else do:
     2626         if buf_dis-cfg-rule.has-obj = 1 then do:
     2627           assign
     2628           v-obj-type = p-obj-type
     2629           v-obj-code = p-obj-code
     2630           .
     2631   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2632   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2633     (input  p-obj-type
     2634     ,input  p-obj-code
     2635     ,output v-host-code
     2636     )  .
     2637         end.
     2638         if buf_dis-cfg-rule.has-host = 1 then do:
     2639   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2640   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2641     (input  p-obj-type
     2642     ,input  p-obj-code
     2643     ,output v-host-code
     2644     )  .
     2645           assign
     2646           v-obj-type = ""
     2647           v-obj-code = 0
     2648           .
     2649         end.
     2650         if buf_dis-cfg-rule.has-glob = 1 then do:
     2651           assign
     2652           v-host-code = 0
     2653           v-obj-type = '':U
     2654           v-obj-code = 0
     2655           .
     2656         end.
     2657       end.
     2658     end.
     2659     when no then do:
     2660       find first buf_dis-cfg-rule no-lock where
     2661                 buf_dis-cfg-rule.table-name = 'dis-grp-rule':U
     2662             and buf_dis-cfg-rule.discnt-role = temp-grpdisc.discnt-role
     2663             and buf_dis-cfg-rule.pos-type = temp-grpdisc.pos-type
     2664             and buf_dis-cfg-rule.self-nonunique = p-classif-type
     2665             no-error .
     2666       if available buf_dis-cfg-rule then do:
     2667         assign
     2668         v-nonunique = buf_dis-cfg-rule.nonunique.
     2669       end.
     2670       v-rule-num  = temp-grpdisc.rule-num.
     2671     end.
     2672   END CASE.
     2673   run disgrpru-edit in this-procedure (
     2674                                          input (if p-add then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U)
     2675                                         ,input p-classif-type
     2676                                         ,input p-node-code
     2677                                         ,input (if p-add then v-host-code else temp-grpdisc.host-code)
     2678                                         ,input (if p-add then v-obj-type  else temp-grpdisc.obj-type)
     2679                                         ,input (if p-add then v-obj-code  else temp-grpdisc.obj-code)
     2680                                         ,INPUT (if p-add then p-pos-type else temp-grpdisc.pos-type)
     2681                                         ,input (if p-add then v-discnt-role else temp-grpdisc.discnt-role)
     2682                                         ,input (if p-add then v-templ-rl-root else temp-grpdisc.templ-rl-root)
     2683                                         ,input (if p-add then v-time-templ-rl-root else temp-grpdisc.time-templ-rl-root)
     2684                                         ,input v-cfg-nonunique
     2685                                         ,input 1
     2686                                         ,input-output v-rule-num
     2687                                         ,input-output v-nonunique
     2688                                         ,output v-setted ) no-error.
     2689   if not v-setted then return error.
     2690   run disgrpru-write in this-procedure (
     2691                                           input p-classif-type
     2692                                           ,input p-node-code
     2693                                           ,input (if p-add then v-host-code else temp-grpdisc.host-code)
     2694                                           ,input (if p-add then v-obj-type else temp-grpdisc.obj-type)
     2695                                           ,input (if p-add then v-obj-code else temp-grpdisc.obj-code)
     2696                                           ,input (if p-add then add-option else temp-grpdisc.pos-type)
     2697                                           ,input (if p-add then v-discnt-role else temp-grpdisc.discnt-role)
     2698                                           ,input (if p-add then v-templ-rl-root else temp-grpdisc.templ-rl-root)
     2699                                           ,input (if p-add then v-time-templ-rl-root else temp-grpdisc.time-templ-rl-roo)
     2700                                           ,input v-rule-num
     2701                                           ,input v-nonunique
     2702                                         ) no-error .
     2703     IF NOT error-status:error then do:
     2704         assign
     2705         updated = yes
     2706         .
     2707     END.
     2708   Run init-proc in this-procedure .
     2709   find first buf_temp-grpdisc no-lock where
     2710             buf_temp-grpdisc.host-code =  (if p-add then v-host-code else temp-grpdisc.host-code)
     2711         AND buf_temp-grpdisc.obj-type = (if p-add then v-obj-type else temp-grpdisc.obj-type)
     2712         AND buf_temp-grpdisc.obj-code = (if p-add then v-obj-code else temp-grpdisc.obj-code)
     2713         AND buf_temp-grpdisc.pos-type = (if p-add then add-option else temp-grpdisc.pos-type)
     2714         AND buf_temp-grpdisc.pos-type = (if p-add then add-option else temp-grpdisc.pos-type)
     2715         AND buf_temp-grpdisc.discnt-role = (if p-add then v-discnt-role else temp-grpdisc.discnt-role)
     2716         AND buf_temp-grpdisc.nonunique = (if p-add then v-nonunique else temp-grpdisc.nonunique)
     2717         no-error.
     2718   add-option = "":U.
     2719   if avail buf_temp-grpdisc then
     2720   temp-doc-rec = recid(buf_temp-grpdisc).
     2721   else temp-doc-rec = ?.
     2722   reposition br-dis-grp to recid temp-doc-rec no-error.
     2723   if error-status:error then return no-apply.
     2724   END PROCEDURE.
     2725   PROCEDURE proc-b-lkp :
     2726   define variable disc-label as character no-undo .
     2727   run disgrpru-name in this-procedure (
     2728                                         input temp-grpdisc.templ-rl-root
     2729                                       , output disc-label
     2730                                   ) no-error.
     2731   IF ERROR-STATUS:ERROR THEN DO:
     2732       return error.
     2733   END.
     2734   run ref/show-dr.p ( input parparentproc
     2735                      ,input temp-grpdisc.rule-num) no-error.
     2736   END PROCEDURE.
