      417   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parfact-date    like ub.wth-line.fact-date    no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.fact-date  = parfact-date  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-cld no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                                                                             start_wth-line.wth-code   = parwth-code         and                                start_wth-line.fact-date  < parfact-date   and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-cld no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income - cur_wth-line.incass              parincome        = cur_wth-line.income                     parincome-cassa  = cur_wth-line.income-cassa               parincome-other  = cur_wth-line.income-other               parincass        = cur_wth-line.incass                     parincass-bank   = cur_wth-line.incass-bank                parincass-other  = cur_wth-line.incass-other.              parincass-cassa  = cur_wth-line.incass-cassa.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income     - start_wth-line.incass               parstock-end     = cur_wth-line.income       - cur_wth-line.incass                 parincome        = cur_wth-line.income       - start_wth-line.income               parincome-cassa  = cur_wth-line.income-cassa - start_wth-line.income-cassa         parincome-other  = cur_wth-line.income-other - start_wth-line.income-other         parincass        = cur_wth-line.incass       - start_wth-line.incass               parincass-bank   = cur_wth-line.incass-bank  - start_wth-line.incass-bank          parincass-other  = cur_wth-line.incass-other - start_wth-line.incass-other.        parincass-cassa  = cur_wth-line.incass-cassa - start_wth-line.incass-cassa.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income - start_wth-line.incass                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      418   end procedure.
      419   procedure wth-lib_full-inf-calend-date-place:
      420   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input parameter parw-p-code  like ub.wth-line.w-p-code  no-undo.                        define input parameter parfact-date like ub.wth-line.fact-date no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                        cur_wth-line.w-p-code   = parw-p-code and                                                               cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.fact-date  = parfact-date  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-cld-pl no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                start_wth-line.w-p-code = parw-p-code and                                                             start_wth-line.wth-code   = parwth-code         and                                start_wth-line.fact-date  < parfact-date   and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-cld-pl no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income-pl - cur_wth-line.incass-pl              parincome        = cur_wth-line.income-pl                     parincome-cassa  = cur_wth-line.income-cassa-pl               parincome-other  = cur_wth-line.income-other-pl               parincass        = cur_wth-line.incass-pl                     parincass-bank   = cur_wth-line.incass-bank-pl                parincass-other  = cur_wth-line.incass-other-pl.              parincass-cassa  = cur_wth-line.incass-cassa-pl.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income-pl     - start_wth-line.incass-pl               parstock-end     = cur_wth-line.income-pl       - cur_wth-line.incass-pl                 parincome        = cur_wth-line.income-pl       - start_wth-line.income-pl               parincome-cassa  = cur_wth-line.income-cassa-pl - start_wth-line.income-cassa-pl         parincome-other  = cur_wth-line.income-other-pl - start_wth-line.income-other-pl         parincass        = cur_wth-line.incass-pl       - start_wth-line.incass-pl               parincass-bank   = cur_wth-line.incass-bank-pl  - start_wth-line.incass-bank-pl          parincass-other  = cur_wth-line.incass-other-pl - start_wth-line.incass-other-pl.        parincass-cassa  = cur_wth-line.incass-cassa-pl - start_wth-line.incass-cassa-pl.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income-pl - start_wth-line.incass-pl                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      421   end procedure.
      422   FUNCTION get-curr RETURNS CHARACTER
      423     (buffer loc-wealth for ub.wealth ) :
      424   define buffer buf_currency for ub.currency.
      425   if loc-wealth.curr-code = ? or loc-wealth.is-money = no then
      426   return loc-wealth.unit-base.
      427   FIND FIRST buf_currency no-lock where
      428             buf_currency.curr-code = loc-wealth.curr-code No-ERROR.
      429   if avail buf_currency then
      430     RETURN buf_currency.curr-abbr.
      431   else return "".
      432   END FUNCTION.
      433   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      434   define variable c-point  as character no-undo .
      435   define variable tbl      as character no-undo .
      436   define variable join-tbl as character no-undo .
      437   define variable fld      as character no-undo .
      438   define variable lab      as character no-undo .
      439   define variable spr      as character no-undo .
      440   define variable dim      as character no-undo .
      441   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      442   procedure fltfield-clear :
      443     define output parameter loc-fld as character no-undo.
      444     define output parameter loc-lab as character no-undo .
      445     define output parameter loc-spr as character no-undo .
      446     define output parameter loc-dim as character no-undo .
      447     assign
      448       loc-fld = ""
      449       loc-lab = ""
      450       loc-spr = ""
      451       loc-dim = "0"
      452     .
      453   end procedure .
      454   procedure fltfield-add :
      455     define input        parameter par-fld as character no-undo.
      456     define input        parameter par-lab as character no-undo .
      457     define input        parameter par-spr as character no-undo .
      458     define input-output parameter loc-fld as character no-undo.
      459     define input-output parameter loc-lab as character no-undo .
      460     define input-output parameter loc-spr as character no-undo .
      461     define input-output parameter loc-dim as character no-undo .
      462     do
      463     on error undo, return error
      464     :
      465       assign
      466       loc-fld = if loc-dim = '0'
      467                 then par-fld
      468                 else (loc-fld + chr(44) + par-fld)
      469       loc-lab = if loc-dim = '0'
      470                 then par-lab
      471                 else (loc-lab + chr(44) + par-lab)
      472       loc-spr = if loc-dim = '0'
      473                 then par-spr
      474                 else (loc-spr + chr(44) + par-spr)
      475       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      476                 string(integer(if num-entries(loc-dim) > 1
      477                               then entry(2, loc-dim)
      478                               else entry(1, loc-dim)
      479                               ) + 1)
      480       no-error
      481       .
      482     end.
      483   end procedure.
      484   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      485   define variable v-waitfram-action01         as character   no-undo .
      486   define variable v-waitfram-action02         as character   no-undo .
      487   define variable v-waitfram-action03         as character   no-undo .
      488   define variable mWaitFramTextBeg            as character   no-undo.
      489   define variable mWaitFramTextEnd            as character   no-undo.
      490   define variable mWaitFramView               as logical     no-undo.
      491   define variable mWaitProcEvent              as logical     no-undo init yes.
      492   define variable mWaitFramInterval           as integer     no-undo init 1 .
      493   define variable mWaitFramStop               as logical     no-undo.
      494   define variable mWaitFramStopUser           as logical     no-undo.
      495   define variable mWaitFramStopTimeOut        as logical     no-undo.
      496   define variable mWaitFramStartProc          as datetime-tz no-undo.
      497   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      498   define button B-WaitFramStop auto-end-key
      499        label "Стоп"
      500        size 10 by 1 tooltip "Остоновить процесс".
      501   define button B-viewProcInfo
      502        label "Информация"
      503        size 15 by 1 tooltip "Информация о процесс".
      504   define frame waitfram
      505     v-waitfram-action01 format "x(72)" no-label skip
      506     v-waitfram-action02 format "x(72)" no-label skip
      507     v-waitfram-action03 format "x(72)" no-label skip
      508     B-viewProcInfo
      509     B-WaitFramStop at row 4 col 30
      510     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      511     .
      512   define new global shared variable mBatchMode as logical no-undo init ?.
      513   define variable mFramBachModHandle as handle no-undo.
      514   mFramBachModHandle = frame waitfram:handle.
      515   define variable mFameOldVis as logical no-undo.
      516   define variable mVisCUrentVin as logical no-undo.
      517   if session:batch-mode
      518   then
      519      mBatchMode = yes.
      520   if mBatchMode = ? then do:
      521     mVisCUrentVin = current-window:visible.
      522     mFameOldVis = mFramBachModHandle:visible.
      523     mFramBachModHandle:visible  = yes.
      524     mBatchMode = mFramBachModHandle:visible ne yes.
      525     mFramBachModHandle:visible = mFameOldVis.
      526     current-window:visible = mVisCUrentVin.
      527   end.
      528    if  log-manager:logfile-name ne ?
      529     then DO:
      530         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      531         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      532         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      533     end.
      534   on choose of B-WaitFramStop in frame waitfram
      535   do:
      536     mWaitFramStop = yes.
      537     mWaitFramStopUser = yes.
      538   end.
      539   function waitfram-check-timeout returns logical():
      540      define variable vtime as int64 no-undo.
      541      if mWaitFramStopTimeOut
      542      then
      543         return yes.
      544      vtime = ( now - mWaitFramStartProc ) / 1000 .
      545      if     mWaitFramTimeOut ne ?
      546         and mWaitFramTimeOut ne 0
      547         and mWaitFramTimeOut lt vtime
      548      then do:
      549         mWaitFramStopTimeOut = yes.
      550      end.
      551      return mWaitFramStopTimeOut.
      552   end.
      553   procedure waitfram-hide :
      554     if not session:batch-mode
      555     then do
      556     on error undo, return error return-value
      557     :
      558       pause 0 before-hide .
      559       if not mBatchMode then
      560         hide frame waitfram .
      561     if     not mWaitFramView
      562        and mWaitProcEvent
      563     then
      564       process events .
      565     end.
      566   end procedure.
      567   procedure waitfram-show :
      568     define input  parameter p-message as character no-undo .
      569     define variable v-left-margin as integer   no-undo .
      570     if not session:batch-mode
      571     then do
      572     on error undo, return error return-value
      573     :
      574       if length(p-message) <= 70 then do:
      575         assign
      576           v-left-margin = integer((70 - length(p-message)) / 2)
      577         .
      578         assign
      579           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      580         .
      581         assign
      582           v-waitfram-action01 = " "
      583           v-waitfram-action02 = " "
      584                                    + fill(" ", v-left-margin)
      585                                    + p-message
      586           v-waitfram-action03 = " "
      587         .
      588       end.
      589       else do:
      590         define variable vRindex1 as integer no-undo.
      591         define variable vRindex2 as integer no-undo.
      592         vRindex1 = r-index(p-message," ",70).
      593         if vRindex1 = 0
      594         then
      595            vRindex1 = 70.
      596         if length(p-message)  <= vRindex1 + 70 then do:
      597           assign
      598             v-waitfram-action01 = " "
      599             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      600             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      601           .
      602         end.
      603         else do:
      604           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      605           if vRindex2 <= vRindex1
      606           then
      607              vRindex2 = vRindex1 + 70.
      608           assign
      609             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      610             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      611             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      612           .
      613         end.
      614       end.
      615       B-viewProcInfo:visible   in frame waitfram = no.
      616       B-viewProcInfo:sensitive in frame waitfram = no.
      617       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      618       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      619       if  (   mWaitFramView
      620          or  mWaitProcEvent)
      621          and not mBatchMode
      622       then
      623          display
      624             v-waitfram-action01 skip
      625             v-waitfram-action02 skip
      626             v-waitfram-action03 skip
      627          with frame waitfram .
      628       if     mWaitFramView
      629          then do:
      630             if     mWaitFramInterval ne ?
      631                and not mBatchMode
      632             then
      633                wait-for go of frame waitfram pause mWaitFramInterval.
      634          end.
      635          else
      636             if     mWaitProcEvent
      637                and not mBatchMode
      638             then
      639                process events .
      640     end.
      641   end procedure.
      642      procedure waitfram-show-this:
      643         define input  parameter iInterval as int64 no-undo.
      644         define variable vtime as int64 no-undo.
      645         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      646         mWaitFramInterval = iInterval.
      647         run waitfram-show (substitute("&1&2 &3&4" ,
      648                                       mWaitFramTextBeg ,
      649                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      650                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      651                                       mWaitFramTextEnd
      652                                      )
      653                           ).
      654      end.
      655      procedure WaitFramRunPause:
      656         define input  parameter iInterval as dec no-undo.
      657         define variable vStart  as datetime-tz no-undo.
      658         define variable vend    as datetime-tz no-undo.
      659         define variable vint as int64 no-undo.
      660         define variable vOk as logical no-undo.
      661         vStart = now.
      662         vend   = vStart.
      663         publish "WaitFramPause" (iInterval,output vOk).
      664         vend   =  now.
      665         vint = vend - vStart.
      666         vint = iInterval - vint / 1000.
      667         if     not mWaitFramStop
      668            and (   vint > 0
      669                 or (    not vOk
      670                     and iInterval eq ?
      671                     )
      672                 )
      673         then
      674            run waitfram-show-this (iInterval).
      675         vend   =  now.
      676         vint = vend - vStart.
      677         vint = iInterval - vint / 1000.
      678         if     not mWaitFramStop
      679            and vint > 0
      680         then do:
      681            run gbl/pause.p (vint * 1000).
      682         end.
      683         if iInterval ne ?
      684         then
      685            publish "WaitFramStop".
      686         waitfram-check-timeout().
      687      end.
      688      procedure WaitFramWaitFor:
      689         define input  parameter iInterval as dec no-undo.
      690         assign
      691            mWaitFramStartProc   = now
      692            mWaitFramStopUser    = no
      693            mWaitFramStopTimeOut = no
      694         .
      695         block-wait:
      696         do while not mWaitFramStop:
      697            run WaitFramRunPause (iInterval).
      698            if  waitfram-check-timeout()
      699            then do:
      700               leave block-wait.
      701            end.
      702         end.
      703         run waitfram-hide.
      704      end.
      705   procedure waitfram-join :
      706     define input  parameter p-line-1  as character no-undo .
      707     define input  parameter p-line-2  as character no-undo .
      708     define input  parameter p-line-3  as character no-undo .
      709     define output parameter p-message as character no-undo .
      710     do
      711     on error undo, return error return-value
      712     :
      713       assign
      714         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      715                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      716                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      717       .
      718     end.
      719   end procedure.
      720   function waitfram-join-function returns character
      721     (input p-line-1 as character
      722     ,input p-line-2 as character
      723     ,input p-line-3 as character
      724     ).
      725     define variable v-message as character no-undo .
      726     run waitfram-join in this-procedure
      727       (input  p-line-1
      728       ,input  p-line-2
      729       ,input  p-line-3
      730       ,output v-message
      731       ) .
      732     return v-message .
      733   end function .
      734   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      735   FUNCTION mark-string RETURNS CHARACTER
      736     ( input p-recid as recid, input mark-list as character  ) :
      737     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      738   END FUNCTION.
      739   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      740   function usrfulnf returns character ( input p-user-id as character):
      741   define variable v-user-name as character no-undo .
      742   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      743   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      744     (input  p-user-id
      745     ,output v-user-name
      746     ) no-error .
      747   if error-status:error
      748   or v-user-name = ""
      749   then do:
