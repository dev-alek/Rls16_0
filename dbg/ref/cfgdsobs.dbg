      756   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      757   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      758   procedure fltopend_fltopend :
      759   define input parameter p-parent-handle as handle no-undo .
      760   define input parameter p-qh as handle no-undo .
      761   define input parameter p-flt-open-open-query  as character no-undo .
      762   define input parameter p-where-cond as character no-undo .
      763   define input parameter p-use-indFIRST-query-tail as character no-undo .
      764   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      765   define input parameter p-indexed-reposition as character no-undo .
      766     do
      767     on error undo, return error
      768     :
      769   define variable v-prepare-string as character no-undo .
      770   define variable glog as logical no-undo .
      771   assign
      772   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      773                      p-where-cond + chr(32)  +
      774                      p-use-indFIRST-query-tail + chr(32) +
      775                      p-use-ind-sort-clmn-by + chr(32) +
      776                      p-indexed-reposition
      777   .
      778   assign
      779   glog = p-qh:query-prepare(v-prepare-string) no-error .
      780   if not glog
      781   or error-status:error then do:
      782     message error-status:get-message(1) view-as alert-box .
      783     undo, return error .
      784   end.
      785   assign
      786   glog = p-qh:query-open no-error .
      787   if not glog
      788   or error-status:error then do:
      789     message error-status:get-message(1) view-as alert-box .
      790     undo, return error .
      791   end.
      792     end.
      793   end procedure.
      794   procedure fltopend_fltfindd :
      795   define input parameter p-parent-handle as handle no-undo .
      796   define input parameter p-qh as handle no-undo .
      797   define input parameter p-rowid as rowid no-undo .
      798   define input parameter p-next as logical no-undo .
      799   define input parameter p-lock as integer no-undo .
      800   define input parameter p-bh as handle no-undo .
      801   define input parameter p-where-cond as character no-undo .
      802   define input parameter p-use-index-phrase as character no-undo .
      803   define variable glog as logical no-undo .
      804   define variable v-qh as handle no-undo .
      805   define variable v-bh as handle no-undo .
      806   define variable v-recid as recid no-undo .
      807   define variable v-prepare-string as character no-undo .
      808   do
      809   on error undo, return error
      810   on stop undo, return error
      811   :
      812     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      813     create buffer v-bh for table p-bh buffer-name p-bh:name.
      814     create query v-qh.
      815     v-qh:set-buffers(v-bh).
      816     v-prepare-string = substitute("for each &1 &2 &3"
      817                                     ,v-bh:name
      818                                     ,p-where-cond
      819                                     ,p-use-index-phrase).
      820     glog = v-qh:query-prepare(v-prepare-string) no-error.
      821     if not glog then do:
      822       delete object v-qh.
      823       delete object v-bh.
      824       undo, return error .
      825     end.
      826     glog = v-qh:query-open no-error .
      827     if not glog then do:
      828       delete object v-qh.
      829       delete object v-bh.
      830       undo, return error .
      831     end.
      832     if p-next then do:
      833       v-qh:reposition-to-rowid(p-rowid) no-error .
      834       glog = v-qh:get-next( p-lock) no-error .
      835       glog = v-qh:get-next( p-lock) no-error .
      836       if not glog or v-qh:query-off-end = yes then do:
      837         glog = v-qh:get-first( p-lock) no-error .
      838       end.
      839     end.
      840     else do:
      841       glog = v-qh:get-first( p-lock) no-error .
      842     end.
      843     v-recid = v-bh:recid no-error .
      844     delete object v-qh.
      845     delete object v-bh.
      846     return string(v-recid) .
      847   end.
      848   end procedure.
      849   procedure fltopend_fltfindq :
      850   define input parameter p-parent-handle as handle no-undo .
      851   define input parameter p-qh as handle no-undo .
      852   define input parameter p-next as logical no-undo .
      853   define input parameter p-lock as integer no-undo .
      854   define input parameter p-flt-open-open-query  as character no-undo .
      855   define input parameter p-where-cond as character no-undo .
      856   define input parameter p-use-indFIRST-query-tail as character no-undo .
      857   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      858   define input parameter p-indexed-reposition as character no-undo .
      859   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      860   define variable glog as logical no-undo .
      861   define variable v-qh as handle no-undo .
      862   define variable v-bh as handle no-undo extent 18.
      863   define variable v-rowid as rowid no-undo extent 18.
      864   define variable v-ii as integer no-undo .
      865   define variable v-prepare-string as character no-undo .
      866   do
      867   on error undo, return error
      868   on stop undo, return error
      869   :
      870     create query v-qh.
      871     do v-ii = 1 to p-qh:num-buffers:
      872       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      873       assign
      874       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      875       no-error.
      876       v-qh:add-buffer(v-bh[v-ii]).
      877     end.
      878     assign
      879     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      880                       p-where-cond + chr(32)  +
      881                       p-use-indFIRST-query-tail + chr(32) +
      882                       p-use-ind-sort-clmn-by + chr(32) +
      883                       p-indexed-reposition
      884     .
      885     glog = v-qh:query-prepare( v-prepare-string) no-error .
      886     if not glog then do:
      887       delete object v-qh.
      888       do v-ii = 1 to p-qh:num-buffers:
      889         delete object v-bh[v-ii].
      890       end.
      891       undo, return error .
      892     end.
      893     glog = v-qh:query-open no-error .
      894     if not glog then do:
      895       delete object v-qh.
      896       do v-ii = 1 to p-qh:num-buffers:
      897         delete object v-bh[v-ii].
      898       end.
      899       undo, return error .
      900     end.
      901     if p-next then do:
      902       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      903       glog = v-qh:get-next( p-lock) no-error .
      904       glog = v-qh:get-next( p-lock) no-error .
      905       if not glog or v-qh:query-off-end = yes then do:
      906         glog = v-qh:get-first( p-lock) no-error .
      907       end.
      908     end.
      909     else do:
      910       glog = v-qh:get-first( p-lock) no-error .
      911     end.
      912     do v-ii = 1 to p-qh:num-buffers:
      913       assign
      914       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      915       no-error.
      916     end.
      917     delete object v-qh.
      918     do v-ii = 1 to p-qh:num-buffers:
      919       delete object v-bh[v-ii].
      920     end.
      921   end.
      922   end procedure.
      923   define variable v-rid-list as character no-undo .
      924   define variable log-res as log no-undo.
      925   define variable rr as recid no-undo.
      926   define variable jj as integer no-undo .
      927   define variable str as char no-undo.
      928   define variable conf-par as char no-undo.
      929   define variable par-type as char no-undo.
      930   define variable vartbl-name as char no-undo.
      931   define variable varact      as char no-undo.
      932   define variable filter-point0 as character no-undo init "cfgdsobs" .
      933   define variable filter-point as character no-undo init "cfgdsobs" .
      934   define variable filter-label0 as character no-undo init "Справочник_истории_АТРИБУТА_ТОВАРА_РЕСТОРАН" .
      935   define variable filter-label as character no-undo init "Справочник_истории_АТРИБУТА_ТОВАРА_РЕСТОРАН_" .
      936   define variable sort-column-name as character no-undo .
      937   define variable rep-rec as recid no-undo .
      938   define NEW SHARED buffer c-fbr-gds-obj for ub.c-fbr-gds-obj .
      939   define buffer X_fbr-gds-obj for ub.fbr-gds-obj.
      940   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      941   define  temp-table temp-changes no-undo
      942   field f_name as character
      943   field l_name as character
      944   field v_old as character
      945   field v_new as character
      946   field t_name as character
      947   field num_ as integer
      948   field uniq-key-rec as character
      949   field action as integer
      950   field fNotChange as logical
      951   index pi is unique primary
      952   num_
      953   t_name
      954   f_name
      955   index
      956   Chan
      957   fnotChange
      958   t_name
      959   f_name
      960   index imain uniq-key-rec
      961   .
      962   FUNCTION get-all-fields returns character (p-file-name as character ):
      963   define variable v-dop as character no-undo .
      964     find first _file no-lock where _file._file-name = p-file-name no-error .
      965     if not available _file then return "":U.
      966     for each _field no-lock where
      967              _field._file-recid = recid(_file) :
      968       assign
      969       v-dop = v-dop + _field._field-name + chr(44)
      970       .
      971     end.
      972     return trim(v-dop).
      973   END FUNCTION.
      974   PROCEDURE proc-full-temp-changes :
      975     define input  parameter p-hst-handle as handle    no-undo .
      976     define input  parameter p-main-table as character no-undo .
      977     define input  parameter p-field-list as character no-undo .
      978     define input  parameter p-label-form as character no-undo .
      979     define variable h-new-buf         as handle    no-undo .
      980     define variable h-main-buf        as handle    no-undo .
      981     define variable h-for-comp        as handle    no-undo .
      982     define variable v-inform          as character no-undo .
      983     define variable v-ind             as integer   no-undo .
      984     define variable v-idx-field-qnty  as integer   no-undo .
      985     define variable v-num-entries     as integer   no-undo .
      986     define variable fh                as handle    no-undo .
      987     define variable fh-main           as handle    no-undo .
      988     define variable fh-old            as handle    no-undo .
      989     define variable fh-new            as handle    no-undo .
      990     define variable v-field-name      as character no-undo .
      991     define variable v-field-lvl       as character no-undo .
      992     define variable v-field-form      as character no-undo .
      993     define variable v-search-exp      as character no-undo .
      994     define variable v-srch-main       as character no-undo .
      995     define variable v-word-link       as character no-undo .
      996     define variable v-av-chip-num     as logical   no-undo .
      997     define variable v-main-pi-fld-lst as character no-undo .
      998     define variable v-main-fld-lst    as character no-undo .
      999     define variable v-delim-list      as character no-undo .
     1000     define variable v-label           as character no-undo .
     1001     define variable v-old-value       as character no-undo case-sensitive.
     1002     define variable v-new-value       as character no-undo case-sensitive.
     1003     define variable v-chg-fields as character no-undo.
     1004     for each temp-changes:
     1005       delete temp-changes.
     1006     end.
     1007     if not p-hst-handle:available then do:
     1008       return .
     1009     end.
     1010     create buffer h-new-buf  for table p-hst-handle .
     1011     create buffer h-main-buf for table p-main-table .
     1012     assign
     1013       v-inform = h-main-buf:index-information(1)
     1014       v-ind    = 2
     1015     .
     1016     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1017     on error undo, return error
     1018     :
     1019       assign
     1020         v-inform = h-main-buf:index-information( v-ind )
     1021         v-ind    = v-ind + 1
     1022       .
     1023     end.
     1024     if v-inform = ?
     1025       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1026       or entry( 3, v-inform, ",":U ) <> "1":U
     1027     then do:
     1028       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1029     end.
     1030     assign
     1031       v-idx-field-qnty = num-entries( v-inform ) - 4
     1032     .
     1033     if v-idx-field-qnty < 2 then do:
     1034       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1035     end.
     1036     assign
     1037       v-srch-main   = "where":U
     1038       v-word-link   = "":U
     1039       v-av-chip-num = false
     1040       v-delim-list  = "":U
     1041     .
     1042     do v-ind = 1 to v-idx-field-qnty by 2
     1043     on error undo, return error
     1044     :
     1045       assign
     1046         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1047         fh                = p-hst-handle:buffer-field( v-field-name )
     1048         fh-main           = h-main-buf:buffer-field( v-field-name )
     1049         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1050         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1051       .
     1052       if fh:data-type ="character":U then do:
     1053         assign
     1054           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1055         .
     1056       end.
     1057       else do:
     1058         assign
     1059           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1060         .
     1061       end.
     1062       if v-delim-list = "":U then do:
     1063         assign
     1064           v-delim-list = ",":U
     1065         .
     1066       end.
     1067       if v-word-link = "":U then do:
     1068         assign
     1069           v-word-link = "and":U
     1070         .
     1071       end.
     1072     end.
     1073     assign
     1074       v-delim-list  = "":U
     1075     .
     1076     do v-ind = 1 to h-main-buf:num-fields
     1077     on error undo, return error
     1078     :
     1079       assign
     1080         fh-main      = h-main-buf:buffer-field( v-ind )
     1081         v-field-name = fh-main:name
     1082       .
     1083         assign
     1084           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1085         .
     1086         if v-delim-list = "":U then do:
     1087           assign
     1088             v-delim-list = ",":U
     1089           .
     1090         end.
     1091     end.
     1092     assign
     1093       v-inform = p-hst-handle:index-information(1)
     1094       v-ind    = 2
     1095     .
     1096     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1097     on error undo, return error
     1098     :
     1099       assign
     1100         v-inform = p-hst-handle:index-information( v-ind )
     1101         v-ind    = v-ind + 1
     1102       .
     1103     end.
     1104     if v-inform = ?
     1105       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1106       or entry( 3, v-inform, ",":U ) <> "1":U
     1107     then do:
     1108       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1109     end.
     1110     assign
     1111       v-idx-field-qnty = num-entries( v-inform ) - 4
     1112     .
     1113     if v-idx-field-qnty < 2 then do:
     1114       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1115     end.
     1116     assign
     1117       v-search-exp  = "where":U
     1118       v-word-link   = "":U
     1119       v-av-chip-num = false
     1120     .
     1121     do v-ind = 1 to v-idx-field-qnty by 2
     1122     on error undo, return error
     1123     :
     1124       assign
     1125         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1126         fh           = p-hst-handle:buffer-field( v-field-name )
     1127         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1128       .
     1129       if v-field-name = "chip-num":U then do:
     1130         assign
     1131           v-search-exp  = substitute( "&1 >", v-search-exp )
     1132           v-av-chip-num = true
     1133         .
     1134       end.
     1135       else do:
     1136         assign
     1137           v-search-exp = substitute( "&1 =", v-search-exp )
     1138         .
     1139       end.
     1140       if fh:data-type ="character":U then do:
     1141         assign
     1142           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1143         .
     1144       end.
     1145       else do:
     1146         assign
     1147           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1148         .
     1149       end.
     1150       if v-word-link = "":U then do:
     1151         assign
     1152           v-word-link = "and":U
     1153         .
     1154       end.
     1155     end.
     1156     if v-av-chip-num = false then do:
     1157       message
     1158         vss-workfile vss-revision vss-description skip
     1159         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1160         "Использование данной процедуры невозможно!" skip
     1161         view-as alert-box error .
     1162       return error .
     1163     end.
     1164     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1165     if not h-new-buf:available then do:
     1166       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1167       if not h-main-buf:available then do:
     1168         assign
     1169           h-for-comp = ?
     1170         .
     1171       end.
     1172       else do:
     1173         assign
     1174           h-for-comp = h-main-buf
     1175         .
     1176       end.
     1177     end.
     1178     else do:
     1179       assign
     1180         h-for-comp = h-new-buf
     1181       .
     1182     end.
     1183     assign
     1184       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1185     .
     1186     do v-ind = 1 to v-num-entries
     1187     on error undo, return error return-value
     1188     :
     1189       assign
     1190         v-field-name = entry( v-ind, v-main-fld-lst )
     1191         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1192         v-old-value  = fh-old:buffer-value()
     1193         v-label      = trim( fh-old:label )
     1194       .
     1195       if ( trim( p-field-list ) <> "":U
     1196            and lookup( v-field-name, p-field-list ) > 0
     1197          )
     1198          or trim( p-field-list ) = "":U
     1199       then do:
     1200         if h-for-comp <> ? then do:
     1201           assign
     1202             fh-new      = h-for-comp:buffer-field( v-field-name )
     1203             v-new-value = fh-new:buffer-value()
     1204           .
     1205         end.
     1206         else do:
     1207           assign
     1208             v-new-value = "":U
     1209           .
     1210         end.
     1211         if v-old-value <> v-new-value
     1212         then do:
     1213           create temp-changes.
     1214           assign
     1215             temp-changes.t_name = p-main-table
     1216             temp-changes.f_name = v-field-name
     1217             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1218             temp-changes.v_old  = trim( v-old-value )
     1219             temp-changes.v_new  = trim( v-new-value )
     1220             temp-changes.num_   = 0
     1221             temp-changes.fNotChange = v-old-value eq v-new-value
     1222           .
     1223         end.
     1224       end.
     1225     end.
     1226     assign
     1227       v-num-entries = num-entries( p-label-form, chr(8) )
     1228     .
     1229     do v-ind = 1 to v-num-entries
     1230     on error undo, return error return-value
     1231     :
     1232       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1233         assign
     1234           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1235           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1236           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1237         .
     1238         find first temp-changes
     1239           where temp-changes.f_name = v-field-name
     1240           no-error .
     1241         if available temp-changes then do:
     1242           if trim( v-field-lvl ) <> "":U then do:
     1243             assign
     1244               temp-changes.l_name = v-field-lvl
     1245             .
     1246           end.
     1247           if trim( v-field-form ) <> "":U then do:
     1248             assign
     1249               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1250             .
     1251             if h-for-comp <> ? then do:
     1252               assign
     1253                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1254               .
     1255             end.
     1256           end.
     1257         end.
     1258       end.
     1259       else do:
     1260         message
     1261           vss-workfile vss-revision vss-description skip
     1262           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1263           substitute( "список для поля '&1': '&2'"
     1264                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1265                       ,entry( v-ind, p-label-form, chr(8) )
     1266                     ) skip
     1267           substitute( "полный список: &2", p-label-form ) skip
     1268           view-as alert-box error .
     1269       end.
     1270     end.
     1271     delete object h-new-buf .
     1272     delete object h-main-buf .
     1273   END PROCEDURE.
     1274   DEFINE BUTTON B-Help
     1275        LABEL "Помо&щь"
     1276        SIZE 3 BY 1
     1277        BGCOLOR 8 .
     1278   DEFINE BUTTON B-mark
     1279        LABEL "&*"
     1280        SIZE 3 BY 1.
     1281   DEFINE BUTTON b-quit AUTO-END-KEY
     1282        LABEL "&Выход"
     1283        SIZE 10 BY 1
     1284        BGCOLOR 8 .
     1285   DEFINE BUTTON B-sch
     1286        LABEL "&Фильтр"
     1287        SIZE 3 BY 1.
     1288   DEFINE BUTTON b-sel AUTO-GO
     1289        LABEL "Вы&бор"
     1290        SIZE 10 BY 1.
     1291   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1292        VIEW-AS FILL-IN
     1293        SIZE 9 BY 1
     1294        FGCOLOR 4  NO-UNDO.
     1295   DEFINE QUERY BR-c-fbr-gds-obj FOR
     1296         X_c-fbr-gds-obj SCROLLING.
     1297   DEFINE QUERY BR-changes FOR
     1298         temp-changes SCROLLING.
     1299   DEFINE BROWSE BR-c-fbr-gds-obj
     1300     QUERY BR-c-fbr-gds-obj DISPLAY
     1301         mark-string( recid(X_c-fbr-gds-obj), v-rid-list ) COLUMN-LABEL "*" FORMAT "X(1)":U
     1302   X_c-fbr-gds-obj.corr-date COLUMN-LABEL "Дата корр." FORMAT "99/99/9999":U
     1303   usrfulnf(X_c-fbr-gds-obj.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1304   X_c-fbr-gds-obj.is-cd FORMAT "да/нет":U
     1305   string(X_c-fbr-gds-obj.corr-time, "hh:mm") COLUMN-LABEL "Время корр."
     1306   X_c-fbr-gds-obj.is-menu FORMAT "да/нет":U
     1307   X_c-fbr-gds-obj.is-modificator FORMAT "да/нет":U
     1308   X_c-fbr-gds-obj.is-null-price FORMAT "да/нет":U
     1309   X_c-fbr-gds-obj.is-season FORMAT "да/нет":U
     1310   X_c-fbr-gds-obj.is-semi-finished FORMAT "да/нет":U
     1311   X_c-fbr-gds-obj.fbr-obj-code FORMAT "99999":U
     1312   X_c-fbr-gds-obj.fbr-grp-code COLUMN-LABEL "Внутр код!группы меню" FORMAT "->,>>>,>>9":U
     1313   ENABLE
     1314   X_c-fbr-gds-obj.corr-date
     1315       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 12.33.
     1316   DEFINE BROWSE BR-changes
     1317     QUERY BR-changes DISPLAY
     1318         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1319   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1320   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1321       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6.
     1322   DEFINE FRAME Dialog-Frame
     1323        b-quit AT ROW 1 COL 1
     1324        B-mark AT ROW 1 COL 11
     1325        b-sel AT ROW 1 COL 14
     1326        B-sch AT ROW 1 COL 92
     1327        B-Help AT ROW 1 COL 95
     1328        mark-num AT ROW 1.92 COL 9 COLON-ALIGNED NO-LABEL
     1329        BR-c-fbr-gds-obj AT ROW 3.42 COL 1
     1330        BR-changes AT ROW 16.04 COL 1
     1331        SPACE(0.24) SKIP(0.00)
     1332       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1333            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1334            TITLE "Справочник касс"
     1335            CANCEL-BUTTON b-quit.
     1336   ASSIGN
     1337          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1338          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1339   ON GO OF FRAME Dialog-Frame
     1340   DO:
     1341     p-rid-list = v-rid-list.
     1342   END.
     1343   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1344   DO:
     1345     APPLY "END-ERROR":U TO SELF.
     1346   END.
     1347   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1348   DO:
     1349    define variable glog as logical no-undo .
     1350    if not available X_c-fbr-gds-obj then return no-apply.
     1351   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1352   define variable v-str-recid13 as character no-undo .
     1353   define variable v-num-entry13 as integer   no-undo .
     1354   assign
     1355     v-str-recid13 = trim( string( recid( X_c-fbr-gds-obj ) , "->>>>>>>>>>>9":U ) )
     1356     v-num-entry13 = lookup( v-str-recid13 , v-rid-list )
     1357   .
     1358   if v-num-entry13 > 0 then do:
     1359     assign
     1360       entry( v-num-entry13, v-rid-list ) = "":U
     1361       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1362     .
     1363   end.
     1364   else do:
     1365     assign
     1366       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid13
     1367     .
     1368   end.
     1369    glog = br-c-fbr-gds-obj :refresh( )  in frame Dialog-Frame.
     1370     if not can-do ("MOUSE-SELECT-DBLCLICK,Return", last-event:function) then do:
     1371       glog = br-c-fbr-gds-obj:select-next-row () in frame Dialog-Frame.
     1372       apply "value-changed" to br-c-fbr-gds-obj in frame Dialog-Frame.
     1373     end.
     1374     if num-entries (v-rid-list) = 0 then
     1375         hide mark-num in frame Dialog-Frame.
     1376     else
     1377     disp num-entries (v-rid-list) @ mark-num
     1378     with frame Dialog-Frame.
     1379     apply "entry" to br-c-fbr-gds-obj in frame Dialog-Frame.
     1380   END.
     1381   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1382   DO:
     1383     run proc-b-sch in this-procedure no-error.
     1384     if error-status:error then return no-apply.
     1385   END.
     1386   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1387   DO:
     1388       if ( available X_c-fbr-gds-obj ) AND ( v-rid-list = "" ) then
     1389           v-rid-list = string( recid( X_c-fbr-gds-obj ) ) .
     1390   END.
     1391   ON RETURN OF BR-c-fbr-gds-obj IN FRAME Dialog-Frame
     1392   DO:
     1393         apply "DEFAULT-ACTION":U to self.
     1394   END.
     1395   ON VALUE-CHANGED OF BR-c-fbr-gds-obj IN FRAME Dialog-Frame
     1396   DO:
     1397     run proc-view-changes in this-procedure no-error.
     1398   END.
     1399   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1400   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1401   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1402   on help of frame Dialog-Frame
     1403   do:
     1404     run gbl/app_help.p
     1405       (input this-procedure :file-name
     1406       ,input ''
     1407       ,input ?
     1408       ) no-error.
     1409     if error-status :error then do:
     1410       message
     1411         "Ошибка при вызове помощи"
     1412         error-status :get-message(1)
     1413         view-as alert-box .
     1414     end.
     1415   end.
     1416   run minbtn-set in this-procedure .
     1417   on choose of b-help in frame Dialog-Frame
     1418   do:
     1419     apply "help":u to frame Dialog-Frame .
     1420   end.
     1421   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1422   procedure minbtn-set :
     1423       do
     1424           on error undo, return error return-value
     1425           :
     1426           define variable ii              as integer       no-undo .
     1427           define variable fh              as widget-handle no-undo .
     1428           define variable hh              as widget-handle no-undo .
     1429           define variable v-h             as handle        extent 4 no-undo .
     1430           define variable v-name-button   as character     no-undo .
     1431           define variable v-help-old-x    as decimal       no-undo .
     1432           define variable v-help-old-y    as decimal       no-undo .
     1433           define variable v-help-old-size as decimal       no-undo .
     1434           define variable v-frame-width   as decimal       no-undo .
     1435           define variable jj              as integer       no-undo .
     1436           do
     1437               on error undo, return error
     1438               :
     1439               assign
     1440                   v-frame-width = frame Dialog-Frame:width - 0.3
     1441                   fh            = frame Dialog-Frame:first-child
     1442                   hh            = fh:first-child
     1443                   ii            = 1
     1444                   .
     1445               do while valid-handle(hh):
     1446                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1447                   do:
     1448                       case lc(hh:name) :
     1449                           when "b-help" then
     1450                               do:
     1451                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1452                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1453                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1454                                   hh:TOOLTIP = "Помощь" .
     1455                                   v-help-old-x = hh:column .
     1456                                   v-help-old-y = hh:row    .
     1457                                   v-help-old-size = hh:width .
     1458                                   hh:width-chars = 2.5 .
     1459                               end.
     1460                           when "b-print" then
     1461                               do:
     1462                                   hh:load-image("cmp/b-print.bmp":u) .
     1463                                   hh:TOOLTIP = "Печать" .
     1464                                   v-h[ii] = hh:handle .
     1465                                   ii = ii + 1 .
     1466                                   hh:width-chars = 3 .
     1467                               end.
     1468                           when "b-history" or
     1469                           when "b-hist" then
     1470                               do:
     1471                                   hh:load-image("cmp/b-hist.bmp":u) .
     1472                                   hh:TOOLTIP = "История" .
     1473                                   v-h[ii] = hh:handle .
     1474                                   ii = ii + 1 .
     1475                                   hh:width-chars = 3 .
     1476                               end.
     1477                           when "b-sch" then
     1478                               do:
     1479                                   hh:load-image("cmp/b-sch.bmp":u) .
     1480                                   hh:TOOLTIP = "Установка Фильтра" .
     1481                                   v-h[ii] = hh:handle .
     1482                                   ii = ii + 1 .
     1483                                   hh:width-chars = 3 .
     1484                               end.
     1485                           when "b-hist-user" then
     1486                               do:
     1487                                   hh:load-image("cmp/b-hist.bmp":u) .
     1488                                   hh:TOOLTIP = "История пользователя" .
     1489                                   ii = ii + 1 .
     1490                               end.
     1491                       end case.
     1492                   end.
     1493                   hh = hh:next-sibling.
     1494               end.
     1495               b-help:column = v-frame-width - b-help:width-chars.
     1496               jj = 0.
     1497               repeat ii = 4 to 1 by -1 :
     1498                   if valid-handle (v-h[ii] ) then
     1499                   do:
     1500                       jj  = jj + 1 .
     1501                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1502                       v-h[ii]:row    = v-help-old-y .
     1503                   end.
     1504               end.
     1505           end.
     1506       end.
     1507   end procedure.
     1508   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1509   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1510   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1511   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1512   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1513   define variable v-diasize-current-frame-height as decimal   no-undo .
     1514   define variable v-diasize-change-size          as logical   no-undo .
     1515   define variable v-diasize-resize-button        as handle    no-undo .
     1516   define variable v-diasize-wndmax               as logical   no-undo .
     1517   define variable v-diasize-wndstore             as logical   no-undo .
     1518   define variable v-diasize-proc-name            as character no-undo .
     1519   define variable v-diasize-browse-handle        as handle    no-undo .
     1520   define variable v-diasize-browse-number        as integer   no-undo .
     1521   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1522   define temp-table temp-diasize-handle no-undo
     1523     field handle-value  as handle
     1524     field save-position as decimal
     1525     index xpk is primary unique handle-value
     1526     .
     1527   define temp-table temp-browse-handle no-undo
     1528     field browse-type   as character
     1529     field browse-number as integer
     1530     field browse-handle as handle
     1531     field original-size as decimal
     1532     index xpk is primary unique browse-type browse-number
     1533     index xie browse-type browse-handle
     1534   .
     1535   procedure diasize_change-height :
     1536     define input  parameter p-change-value  as decimal   no-undo .
     1537     define input  parameter p-move-resize   as logical   no-undo .
     1538     define variable v-field-group-handle    as handle    no-undo .
     1539     define variable v-object-handle         as handle    no-undo .
     1540     define variable v-frame-height          as decimal   no-undo .
     1541     define variable v-frame-virtual-height  as decimal   no-undo .
     1542     define variable v-browse-height         as decimal   no-undo .
     1543     define variable v-window-height         as decimal   no-undo .
     1544     define variable v-window-virtual-height as decimal   no-undo .
     1545     define variable v-change-sign           as integer   no-undo .
     1546     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1547     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1548     if p-change-value > 0
     1549     then do:
     1550       if frame Dialog-Frame :height + p-change-value
     1551           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1552       then do:
     1553         assign
     1554           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1555                           - (frame Dialog-Frame :height-chars)
     1556         .
     1557         if p-change-value <= 0
     1558         then do:
     1559           run diasize_position-resize-button in this-procedure .
     1560           return .
     1561         end.
     1562       end.
     1563     end.
     1564     if p-change-value < 0
     1565     then do:
     1566       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1567       then do:
     1568         assign
     1569           p-change-value = v-diasize-orig-frame-height
     1570                          - (frame Dialog-Frame :height-chars)
     1571         .
     1572         if p-change-value >= 0
     1573         then do:
     1574           run diasize_position-resize-button in this-procedure .
     1575           return .
     1576         end.
     1577       end.
     1578     end.
     1579     if p-change-value >= 0
     1580     then do:
     1581       assign
     1582         v-change-sign = 1
     1583       .
     1584     end.
     1585     else do:
     1586       assign
     1587         v-change-sign = -1
     1588       .
     1589     end.
     1590     assign
     1591       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1592     .
     1593     if p-change-value = 0
     1594     then do:
     1595       run diasize_position-resize-button in this-procedure .
     1596       return .
     1597     end.
     1598     move_block:
     1599     do
     1600     on error undo move_block, retry move_block
     1601     :
     1602       if retry
     1603       then do:
     1604         do
     1605         on error undo move_block, leave move_block
     1606         :
     1607           if p-change-value > 0
     1608           then do:
     1609             for each buf_temp-diasize-handle
     1610             on error undo, next
     1611             :
     1612               assign
     1613                 v-object-handle = buf_temp-diasize-handle.handle-value
     1614               .
     1615               if v-object-handle <> v-diasize-resize-button
     1616               then do:
     1617                 assign
     1618                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1619                 .
     1620               end.
     1621             end.
     1622             assign
     1623               v-diasize-browse-handle :height = v-browse-height
     1624             .
     1625             for each buf_temp-browse-handle
     1626               where buf_temp-browse-handle.browse-type = 'height':u
     1627             on error undo, next
     1628             :
     1629               assign
     1630                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1631               .
     1632             end.
     1633             assign
     1634               frame Dialog-Frame :height = v-frame-height
     1635             .
     1636             if frame Dialog-Frame :scrollable = true
     1637             then do:
     1638               assign
     1639                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1640               .
     1641             end.
     1642             run diasize_position-resize-button in this-procedure .
     1643           end.
     1644           else do:
     1645             if frame Dialog-Frame :scrollable = true
     1646             then do:
     1647               assign
     1648                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1649               .
     1650             end.
     1651             assign
     1652               frame Dialog-Frame :height = v-frame-height
     1653             .
     1654             assign
     1655               v-diasize-browse-handle :height = v-browse-height
     1656             .
     1657             for each buf_temp-browse-handle
     1658               where buf_temp-browse-handle.browse-type = 'height':u
     1659             on error undo, next
     1660             :
     1661               assign
     1662                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1663               .
     1664             end.
     1665             for each buf_temp-diasize-handle
     1666             on error undo, next
     1667             :
     1668               assign
     1669                 v-object-handle = buf_temp-diasize-handle.handle-value
     1670               .
     1671               if v-object-handle <> v-diasize-resize-button
     1672               then do:
     1673                 assign
     1674                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1675                 .
     1676               end.
     1677             end.
     1678             run diasize_position-resize-button in this-procedure .
     1679           end.
     1680           assign
     1681             v-diasize-change-size = false
     1682           .
     1683           leave move_block .
     1684         end.
     1685       end.
     1686       assign
     1687         v-diasize-need-full-display = true
     1688       .
     1689       if v-diasize-change-size = false
     1690       then do:
     1691         assign
     1692           v-diasize-change-size = true
     1693         .
     1694       end.
     1695       else do:
     1696         return .
     1697       end.
     1698       assign
     1699         v-frame-height = frame Dialog-Frame :height
     1700         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1701         v-browse-height = v-diasize-browse-handle :height
     1702       .
     1703       for each buf_temp-browse-handle
     1704         where buf_temp-browse-handle.browse-type = 'height':u
     1705       :
     1706         assign
     1707           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1708         .
     1709       end.
     1710       for each buf_temp-diasize-handle
     1711       :
     1712         delete buf_temp-diasize-handle .
     1713       end.
     1714       assign
     1715         v-field-group-handle = frame Dialog-Frame :first-child
     1716       .
     1717       do while valid-handle(v-field-group-handle)
     1718       :
     1719         assign
     1720           v-object-handle = v-field-group-handle :first-child
     1721         .
     1722         do while valid-handle(v-object-handle)
     1723         :
     1724           if  v-object-handle <> v-diasize-browse-handle :handle
     1725           and can-query(v-object-handle, "row")
     1726           and can-query(v-object-handle, "height")
     1727           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1728           then do:
     1729             find first buf_temp-browse-handle
     1730               where buf_temp-browse-handle.browse-type   = 'height':u
     1731                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1732               no-error .
     1733             if available buf_temp-browse-handle
     1734             then do:
     1735             end.
     1736             else do:
     1737               create buf_temp-diasize-handle .
     1738               assign
     1739                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1740                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1741               .
     1742             end.
     1743           end.
     1744           assign
     1745             v-object-handle = v-object-handle :next-sibling
     1746           .
     1747         end.
     1748         assign
     1749           v-field-group-handle = v-field-group-handle :next-sibling
     1750         .
     1751       end.
     1752       do with frame Dialog-Frame
     1753       :
     1754         hide v-diasize-resize-button .
     1755         assign
     1756           v-diasize-resize-button :row    = 1
     1757           v-diasize-resize-button :column = 1
     1758         .
     1759       end.
     1760       if p-change-value > 0
     1761       then do:
     1762         if frame Dialog-Frame :scrollable = true
     1763         then do:
     1764           assign
     1765             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1766             no-error .
     1767           if error-status :error
     1768           or error-status :get-message(1) <> ""
     1769           then do:
     1770             undo move_block, retry move_block .
     1771           end.
     1772         end.
     1773         assign
     1774           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1775           no-error .
     1776         if error-status :error
     1777         or error-status :get-message(1) <> ""
     1778         then do:
     1779           undo move_block, retry move_block .
     1780         end.
     1781         assign
     1782           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1783           no-error .
     1784         if error-status :error
     1785         or error-status :get-message(1) <> ""
     1786         then do:
     1787           undo move_block, retry move_block .
     1788         end.
     1789         for each buf_temp-browse-handle
     1790           where buf_temp-browse-handle.browse-type = 'height':u
     1791         on error undo move_block, retry move_block
     1792         :
     1793           assign
     1794             buf_temp-browse-handle.browse-handle :height
     1795               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1796             no-error .
     1797           if error-status :error
     1798           or error-status :get-message(1) <> ""
     1799           then do:
     1800             undo move_block, retry move_block .
     1801           end.
     1802         end.
     1803         for each buf_temp-diasize-handle
     1804         on error undo move_block, retry move_block
     1805         :
     1806           assign
     1807             v-object-handle = buf_temp-diasize-handle.handle-value
     1808           .
     1809           if v-object-handle <> v-diasize-resize-button
     1810           then do:
     1811             assign
     1812               v-object-handle :row = v-object-handle :row + p-change-value
     1813               no-error .
     1814             if error-status :error
     1815             or error-status :get-message(1) <> ""
     1816             then do:
     1817               undo move_block, retry move_block .
     1818             end.
     1819           end.
     1820         end.
     1821       end.
     1822       else do:
     1823         for each buf_temp-diasize-handle
     1824         on error undo move_block, retry move_block
     1825         :
     1826           assign
     1827             v-object-handle = buf_temp-diasize-handle.handle-value
     1828           .
     1829           if v-object-handle <> v-diasize-resize-button
     1830           then do:
     1831             assign
     1832               v-object-handle :row = v-object-handle :row + p-change-value
     1833               no-error .
     1834             if error-status :error
     1835             or error-status :get-message(1) <> ""
     1836             then do:
     1837               undo move_block, retry move_block .
     1838             end.
     1839           end.
     1840         end.
     1841         assign
     1842           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1843           no-error .
     1844         if error-status :error
     1845         or error-status :get-message(1) <> ""
     1846         then do:
     1847           undo move_block, retry move_block .
     1848         end.
     1849         for each buf_temp-browse-handle
     1850           where buf_temp-browse-handle.browse-type = 'height':u
     1851         on error undo move_block, retry move_block
     1852         :
     1853           assign
     1854             buf_temp-browse-handle.browse-handle :height
     1855               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1856             no-error .
     1857           if error-status :error
     1858           or error-status :get-message(1) <> ""
     1859           then do:
     1860             undo move_block, retry move_block .
     1861           end.
     1862         end.
     1863         assign
     1864           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1865           no-error .
     1866         if error-status :error
     1867         or error-status :get-message(1) <> ""
     1868         then do:
     1869           undo move_block, retry move_block .
     1870         end.
     1871         if frame Dialog-Frame :scrollable = true
     1872         then do:
     1873           assign
     1874             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1875             no-error .
     1876           if error-status :error
     1877           or error-status :get-message(1) <> ""
     1878           then do:
     1879             undo move_block, retry move_block .
     1880           end.
     1881         end.
     1882       end.
     1883       if p-move-resize = true
     1884       then do:
     1885         run diasize_position-resize-button in this-procedure .
     1886       end.
     1887       if v-diasize-wndstore = true
     1888       then do:
     1889         if connected("ub") = true
     1890         then do:
     1891           define variable v-cntxt-db-num        as integer   no-undo .
     1892           define variable v-cntxt-userid        as character no-undo .
     1893           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1894                                             , OUTPUT v-cntxt-userid
     1895                                             ) .
     1896           run gbl/wndsizew.p
     1897             (input  v-cntxt-db-num
     1898             ,input  v-cntxt-userid
     1899             ,input  v-diasize-proc-name
     1900             ,input  'height':u
     1901             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1902             ) .
     1903         end.
     1904       end.
     1905     end.
     1906     assign
     1907       v-diasize-change-size = false
     1908     .
     1909   end procedure.
     1910   procedure diasize_set-height :
     1911     define input  parameter p-new-height  as decimal   no-undo .
     1912     define input  parameter p-move-resize as logical   no-undo .
     1913     do
     1914     on error undo, return error return-value
     1915     :
     1916       run diasize_change-height in this-procedure
     1917         (input  (p-new-height - frame Dialog-Frame :height)
     1918         ,input  p-move-resize
     1919         ) .
     1920     end.
     1921   end procedure.
     1922   procedure diasize_change-width :
     1923     define input  parameter p-change-value as decimal   no-undo .
     1924     define input  parameter p-move-resize  as logical   no-undo .
     1925     define variable v-field-group-handle   as handle    no-undo .
     1926     define variable v-object-handle        as handle    no-undo .
     1927     define variable v-frame-width          as decimal   no-undo .
     1928     define variable v-frame-virtual-width  as decimal   no-undo .
     1929     define variable v-browse-width         as decimal   no-undo .
     1930     define variable v-window-width         as decimal   no-undo .
     1931     define variable v-window-virtual-width as decimal   no-undo .
     1932     define variable v-change-sign          as integer   no-undo .
     1933     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1934     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1935     if p-change-value > 0
     1936     then do:
     1937       if frame Dialog-Frame :width + p-change-value >
     1938           session :width-chars
     1939       then do:
     1940         assign
     1941           p-change-value = session :width-chars - frame Dialog-Frame :width
     1942         .
     1943         if p-change-value <= 0
     1944         then do:
     1945           run diasize_position-resize-button in this-procedure .
     1946           return .
     1947         end.
     1948       end.
     1949     end.
     1950     if p-change-value < 0
     1951     then do:
     1952       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1953       then do:
     1954         assign
     1955           p-change-value = v-diasize-orig-frame-width
     1956                          - frame Dialog-Frame :width
     1957         .
     1958         if p-change-value >= 0
     1959         then do:
     1960           run diasize_position-resize-button in this-procedure .
     1961           return .
     1962         end.
     1963       end.
     1964     end.
     1965     if p-change-value >= 0
     1966     then do:
     1967       assign
     1968         v-change-sign = 1
     1969       .
     1970     end.
     1971     else do:
     1972       assign
     1973         v-change-sign = -1
     1974       .
     1975     end.
     1976     assign
     1977       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1978     .
     1979     if p-change-value = 0
     1980     then do:
     1981       run diasize_position-resize-button in this-procedure .
     1982       return .
     1983     end.
     1984     move_block:
     1985     do
     1986     on error undo move_block, leave move_block
     1987     :
     1988       if retry
     1989       then do:
     1990         do
     1991         on error undo move_block, leave move_block
     1992         :
     1993           if p-change-value > 0
     1994           then do:
     1995             for each buf_temp-diasize-handle
     1996             on error undo, next
     1997             :
     1998               assign
     1999                 v-object-handle = buf_temp-diasize-handle.handle-value
     2000               .
     2001               if v-object-handle <> v-diasize-resize-button
     2002               then do:
     2003                 assign
     2004                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2005                 .
     2006               end.
     2007             end.
     2008             assign
     2009               v-diasize-browse-handle :width = v-browse-width
     2010             .
     2011             for each buf_temp-browse-handle
     2012               where buf_temp-browse-handle.browse-type = 'width':u
     2013             on error undo, next
     2014             :
     2015               assign
     2016                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2017               .
     2018             end.
     2019             assign
     2020               frame Dialog-Frame :width = v-frame-width
     2021             .
     2022             if frame Dialog-Frame :scrollable = true
     2023             then do:
     2024               assign
     2025                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2026               .
     2027             end.
     2028             run diasize_position-resize-button in this-procedure .
     2029           end.
     2030           else do:
     2031             if frame Dialog-Frame :scrollable = true
     2032             then do:
     2033               assign
     2034                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2035               .
     2036             end.
     2037             assign
     2038               frame Dialog-Frame :width = v-frame-width
     2039             .
     2040             for each buf_temp-browse-handle
     2041               where buf_temp-browse-handle.browse-type = 'width':u
     2042             on error undo, next
     2043             :
     2044               assign
     2045                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2046               .
     2047             end.
     2048             assign
     2049               v-diasize-browse-handle :width = v-browse-width
     2050             .
     2051             for each buf_temp-diasize-handle
     2052             on error undo, next
     2053             :
     2054               assign
     2055                 v-object-handle = buf_temp-diasize-handle.handle-value
     2056               .
     2057               if v-object-handle <> v-diasize-resize-button
     2058               then do:
     2059                 assign
     2060                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2061                 .
     2062               end.
     2063             end.
     2064             run diasize_position-resize-button in this-procedure .
     2065           end.
     2066           assign
     2067             v-diasize-change-size = false
     2068           .
     2069           leave move_block .
     2070         end.
     2071       end.
     2072       assign
     2073         v-diasize-need-full-display = true
     2074       .
     2075       if v-diasize-change-size = false
     2076       then do:
     2077         assign
     2078           v-diasize-change-size = true
     2079         .
     2080       end.
     2081       else do:
     2082         return .
     2083       end.
     2084       assign
     2085         v-frame-width = frame Dialog-Frame :width
     2086         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2087         v-browse-width = v-diasize-browse-handle :width
     2088       .
     2089       for each buf_temp-browse-handle
     2090         where buf_temp-browse-handle.browse-type = 'width':u
     2091       :
     2092         assign
     2093           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2094         .
     2095       end.
     2096       for each buf_temp-diasize-handle
     2097       :
     2098         delete buf_temp-diasize-handle .
     2099       end.
     2100       assign
     2101         v-field-group-handle = frame Dialog-Frame :first-child
     2102       .
     2103       do while valid-handle(v-field-group-handle)
     2104       :
     2105         assign
     2106           v-object-handle = v-field-group-handle :first-child
     2107         .
     2108         do while valid-handle(v-object-handle)
     2109         :
     2110           if  v-object-handle <> v-diasize-browse-handle :handle
     2111           and v-object-handle <> v-diasize-resize-button
     2112           and can-query(v-object-handle, "row")
     2113           and can-query(v-object-handle, "height")
     2114           and ( v-object-handle :col + v-object-handle :width
     2115                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2116               )
     2117           then do:
     2118             find first buf_temp-browse-handle
     2119               where buf_temp-browse-handle.browse-type   = 'width':u
     2120                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2121               no-error .
     2122             if available buf_temp-browse-handle
     2123             then do:
     2124             end.
     2125             else do:
     2126               create buf_temp-diasize-handle .
     2127               assign
     2128                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2129                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2130               .
     2131             end.
     2132           end.
     2133           assign
     2134             v-object-handle = v-object-handle :next-sibling
     2135           .
     2136         end.
     2137         assign
     2138           v-field-group-handle = v-field-group-handle :next-sibling
     2139         .
     2140       end.
     2141       do with frame Dialog-Frame
     2142       :
     2143         hide v-diasize-resize-button .
     2144         v-diasize-resize-button :row = 1.
     2145         v-diasize-resize-button :column = 1.
     2146       end.
     2147       if p-change-value > 0
     2148       then do:
     2149         if frame Dialog-Frame :scrollable = true
     2150         then do:
     2151           assign
     2152             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2153             no-error .
     2154           if error-status :error
     2155           or error-status :get-message(1) <> ""
     2156           then do:
     2157             undo move_block, retry move_block.
     2158           end.
     2159         end.
     2160         assign
     2161           frame Dialog-Frame :width = v-frame-width + p-change-value
     2162           no-error .
     2163         if error-status :error
     2164         or error-status :get-message(1) <> ""
     2165         then do:
     2166           undo move_block, retry move_block.
     2167         end.
     2168         assign
     2169           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2170         no-error .
     2171         if error-status :error
     2172         or error-status :get-message(1) <> ""
     2173         then do:
     2174           undo move_block, retry move_block.
     2175         end.
     2176         for each buf_temp-browse-handle
     2177           where buf_temp-browse-handle.browse-type = 'width':u
     2178         on error undo move_block, retry move_block
     2179         :
     2180           assign
     2181             buf_temp-browse-handle.browse-handle :width
     2182               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2183             no-error .
     2184           if error-status :error
     2185           or error-status :get-message(1) <> ""
     2186           then do:
     2187             undo move_block, retry move_block .
     2188           end.
     2189         end.
     2190         for each buf_temp-diasize-handle
     2191         on error undo move_block, retry move_block
     2192         :
     2193           assign
     2194             v-object-handle = buf_temp-diasize-handle.handle-value
     2195           .
     2196           if v-object-handle <> v-diasize-resize-button
     2197           then do:
     2198             assign
     2199               v-object-handle :col = v-object-handle :col + p-change-value
     2200               no-error .
     2201             if error-status :error
     2202             or error-status :get-message(1) <> ""
     2203             then do:
     2204               undo move_block, retry move_block .
     2205             end.
     2206           end.
     2207         end.
     2208       end.
     2209       else do:
     2210         for each buf_temp-diasize-handle
     2211         on error undo move_block, retry move_block
     2212         :
     2213           assign
     2214             v-object-handle = buf_temp-diasize-handle.handle-value
     2215           .
     2216           if v-object-handle <> v-diasize-resize-button
     2217           then do:
     2218             assign
     2219               v-object-handle :col = v-object-handle :col + p-change-value
     2220               no-error .
     2221             if error-status :error
     2222             or error-status :get-message(1) <> ""
     2223             then do:
     2224               undo move_block, retry move_block .
     2225             end.
     2226           end.
     2227         end.
     2228         for each buf_temp-browse-handle
     2229           where buf_temp-browse-handle.browse-type = 'width':u
     2230         on error undo move_block, retry move_block
     2231         :
     2232           assign
     2233             buf_temp-browse-handle.browse-handle :width
     2234               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2235             no-error .
     2236           if error-status :error
     2237           or error-status :get-message(1) <> ""
     2238           then do:
     2239             undo move_block, retry move_block .
     2240           end.
     2241         end.
     2242         assign
     2243           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2244           no-error .
     2245         if error-status :error
     2246         or error-status :get-message(1) <> ""
     2247         then do:
     2248           undo move_block, retry move_block.
     2249         end.
     2250         assign
     2251           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2252         no-error .
     2253         if error-status :error
     2254         or error-status :get-message(1) <> ""
     2255         then do:
     2256           undo move_block, retry move_block.
     2257         end.
     2258         if frame Dialog-Frame :scrollable = true
     2259         then do:
     2260           assign
     2261             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2262           no-error .
     2263           if error-status :error
     2264           or error-status :get-message(1) <> ""
     2265           then do:
     2266             undo move_block, retry move_block.
     2267           end.
     2268         end.
     2269       end.
     2270       if p-move-resize
     2271       then do:
     2272         run diasize_position-resize-button in this-procedure .
     2273       end.
     2274       if v-diasize-wndstore = true
     2275       then do:
     2276         if connected("ub") = true
     2277         then do:
     2278           define variable v-cntxt-db-num        as integer   no-undo .
     2279           define variable v-cntxt-userid        as character no-undo .
     2280           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2281                                             , OUTPUT v-cntxt-userid
     2282                                             ) .
     2283           run gbl/wndsizew.p
     2284             (input  v-cntxt-db-num
     2285             ,input  v-cntxt-userid
     2286             ,input  v-diasize-proc-name
     2287             ,input  'width':u
     2288             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2289             ) .
     2290         end.
     2291       end.
     2292     end.
     2293     assign
     2294       v-diasize-change-size = false
     2295     .
     2296   end procedure.
     2297   procedure diasize_set-width :
     2298     define input  parameter p-new-width  as decimal   no-undo .
     2299     define input  parameter p-move-resize as logical   no-undo .
     2300     do
     2301     on error undo, return error return-value
     2302     :
     2303       run diasize_change-width in this-procedure
     2304         (input  (p-new-width - frame Dialog-Frame :width)
     2305         ,input  p-move-resize
     2306         ) .
     2307     end.
     2308   end procedure.
     2309   procedure diasize_position-resize-button :
     2310     do with frame Dialog-Frame
     2311     :
     2312       hide v-diasize-resize-button .
     2313       assign
     2314         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2315                     - 1
     2316                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2317         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2318                     - 1
     2319                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2320       .
     2321       view v-diasize-resize-button .
     2322     end.
     2323   end procedure.
     2324   on alt-right anywhere
     2325   do:
     2326     run diasize_change-width in this-procedure
     2327       (input 1
     2328       ,input true
     2329       ) .
     2330     return no-apply .
     2331   end.
     2332   on alt-left anywhere
     2333   do:
     2334     run diasize_change-width in this-procedure
     2335       (input -1
     2336       ,input true
     2337       ) .
     2338     return no-apply .
     2339   end.
     2340   on alt-down anywhere
     2341   do:
     2342     run diasize_change-height in this-procedure
     2343       (input 1
     2344       ,input true
     2345       ) .
     2346     return no-apply .
     2347   end.
     2348   on alt-up anywhere
     2349   do:
     2350     run diasize_change-height in this-procedure
     2351       (input -1
     2352       ,input true
     2353       ) .
     2354     return no-apply .
     2355   end.
     2356   on alt-enter of frame Dialog-Frame
     2357   do:
     2358     run diasize_maximize in this-procedure
     2359       (input  ?
     2360       ).
     2361     return no-apply .
     2362   end.
     2363   procedure diasize_end-move :
     2364     do
     2365     on error undo, return error return-value
     2366     :
     2367       define variable v-row-delta as decimal   no-undo .
     2368       define variable v-col-delta as decimal   no-undo .
     2369       define variable v-new-row as decimal   no-undo .
     2370       define variable v-new-col as decimal   no-undo .
     2371       assign
     2372         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2373         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2374       .
     2375       assign
     2376         v-row-delta = v-new-row - frame Dialog-Frame :height
     2377         v-col-delta = v-new-col - frame Dialog-Frame :width
     2378       .
     2379       run diasize_change-height in this-procedure
     2380         (input v-row-delta
     2381         ,input true
     2382         ) .
     2383       run diasize_change-width in this-procedure
     2384         (input v-col-delta
     2385         ,input true
     2386         ) .
     2387     end.
     2388   end procedure.
     2389   procedure diasize_maximize :
     2390     define input  parameter p-action as logical   no-undo .
     2391     do
     2392     on error undo, return error return-value
     2393     :
     2394       if p-action = ?
     2395       then do:
     2396         if v-diasize-need-maximize = true
     2397         then do:
     2398           assign
     2399             p-action = true
     2400           .
     2401         end.
     2402         else do:
     2403           assign
     2404             p-action = false
     2405           .
     2406         end.
     2407       end.
     2408       if p-action = true
     2409       then do:
     2410         run diasize_change-height in this-procedure
     2411           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2412               - frame Dialog-Frame :height-chars
     2413           ,input true
     2414           ) .
     2415         run diasize_change-width in this-procedure
     2416           (input session :width-chars
     2417               - frame Dialog-Frame :width-chars
     2418           ,input true
     2419           ) .
     2420         assign
     2421           v-diasize-need-maximize = false
     2422         .
     2423       end.
     2424       else do:
     2425         run diasize_change-width in this-procedure
     2426           (input v-diasize-orig-frame-width
     2427               - frame Dialog-Frame :width-chars
     2428           ,input true
     2429           ) .
     2430         run diasize_change-height in this-procedure
     2431           (input v-diasize-orig-frame-height
     2432               - frame Dialog-Frame :height-chars
     2433           ,input true
     2434           ) .
     2435         assign
     2436           v-diasize-need-maximize = true
     2437         .
     2438       end.
     2439     end.
     2440   end procedure.
     2441   procedure diasize_restore-orig-size :
     2442     do
     2443     on error undo, return error return-value
     2444     :
     2445       assign
     2446         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2447         v-diasize-current-frame-height = frame Dialog-Frame :height
     2448       .
     2449       run diasize_set-height in this-procedure
     2450         (input  v-diasize-orig-frame-height
     2451         ,input  true
     2452         ) .
     2453       run diasize_set-width in this-procedure
     2454         (input  v-diasize-orig-frame-width
     2455         ,input  true
     2456         ) .
     2457     end.
     2458   end procedure.
     2459   procedure diasize_restore-current-size :
     2460     do
     2461     on error undo, return error return-value
     2462     :
     2463       run diasize_set-height in this-procedure
     2464         (input  v-diasize-current-frame-height
     2465         ,input  true
     2466         ) .
     2467       run diasize_set-width in this-procedure
     2468         (input  v-diasize-current-frame-width
     2469         ,input  true
     2470         ) .
     2471     end.
     2472   end procedure.
     2473   procedure diasize_set-browse-handle :
     2474     define input  parameter p-browse-handle as handle   no-undo .
     2475     define buffer buf_temp-browse-handle for temp-browse-handle .
     2476     do
     2477     on error undo, return error return-value
     2478     :
     2479       assign
     2480         v-diasize-browse-handle = p-browse-handle
     2481       .
     2482       for each buf_temp-browse-handle
     2483       on error undo, return error return-value
     2484       :
     2485         delete buf_temp-browse-handle .
     2486       end.
     2487     end.
     2488   end procedure.
     2489   procedure diasize_add_browse :
     2490     define input  parameter p-browse-type   as character no-undo .
     2491     define input  parameter p-browse-handle as handle    no-undo .
     2492     define buffer buf_temp-browse-handle for temp-browse-handle .
     2493     do
     2494     on error undo, return error return-value
     2495     :
     2496       assign
     2497         v-diasize-browse-number = v-diasize-browse-number + 1
     2498       .
     2499       create buf_temp-browse-handle .
     2500       assign
     2501         buf_temp-browse-handle.browse-type   = p-browse-type
     2502         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2503         buf_temp-browse-handle.browse-handle = p-browse-handle
     2504       .
     2505     end.
     2506   end procedure.
     2507   procedure diasize_init :
     2508     define variable v-default-value    as logical   no-undo .
     2509     define variable v-restore-saved    as logical   no-undo .
     2510     define variable v-resize-value-str as character no-undo .
     2511     do
     2512     on error undo, return error return-value
     2513     :
     2514       do with frame Dialog-Frame
     2515       :
     2516         assign
     2517           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2518           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2519           v-diasize-browse-handle     = browse BR-c-fbr-gds-obj :handle
     2520         .
     2521         create button v-diasize-resize-button
     2522         assign
     2523           parent        = frame Dialog-Frame :first-child
     2524           label         = "s"
     2525           height-pixels = 16
     2526           width-pixels  = 16
     2527           visible       = true
     2528           sensitive     = true
     2529           movable       = true
     2530           triggers:
     2531             on end-move persistent run diasize_end-move in this-procedure .
     2532           end triggers.
     2533         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2534         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2535         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2536         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2537         assign
     2538           v-diasize-wndmax = false
     2539         .
     2540         if connected("ub") = true
     2541         then do:
     2542           define variable v-cntxt-db-num        as integer   no-undo .
     2543           define variable v-cntxt-userid        as character no-undo .
     2544           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2545                                             , OUTPUT v-cntxt-userid
     2546                                             ) .
     2547           run gbl/wndpar_r.p
     2548             (input  v-cntxt-db-num
     2549             ,input  v-cntxt-userid
     2550             ,input  'wndmax':U
     2551             ,output v-diasize-wndmax
     2552             ,output v-default-value
     2553             ) .
     2554         end.
     2555         assign
     2556           v-diasize-wndstore = false
     2557         .
     2558         if connected("ub") = true
     2559         then do:
     2560           run gbl/wndpar_r.p
     2561             (input  v-cntxt-db-num
     2562             ,input  v-cntxt-userid
     2563             ,input  'wndstore':U
     2564             ,output v-diasize-wndstore
     2565             ,output v-default-value
     2566             ) .
     2567         end.
     2568         assign
     2569           v-diasize-proc-name = entry(1, program-name(2), '.')
     2570         .
     2571         if v-diasize-wndstore = true
     2572         then do:
     2573           assign
     2574             v-restore-saved = false
     2575           .
     2576           if connected("ub") = true
     2577           then do:
     2578             run gbl/wndsizer.p
     2579               (input  v-cntxt-db-num
     2580               ,input  v-cntxt-userid
     2581               ,input  v-diasize-proc-name
     2582               ,input  'height':u
     2583               ,output v-resize-value-str
     2584               ) .
     2585             if v-resize-value-str <> '':U
     2586             then do:
     2587               run diasize_change-height in this-procedure
     2588                 (input  integer(v-resize-value-str)
     2589                 ,input  true
     2590                 ) .
     2591               assign
     2592                 v-restore-saved = true
     2593               .
     2594             end.
     2595           end.
     2596           if connected("ub") = true
     2597           then do:
     2598             run gbl/wndsizer.p
     2599               (input  v-cntxt-db-num
     2600               ,input  v-cntxt-userid
     2601               ,input  v-diasize-proc-name
     2602               ,input  'width':u
     2603               ,output v-resize-value-str
     2604               ) .
     2605             if v-resize-value-str <> '':U
     2606             then do:
     2607               run diasize_change-width in this-procedure
     2608                 (input  integer(v-resize-value-str)
     2609                 ,input  true
     2610                 ) .
     2611               assign
     2612                 v-restore-saved = true
     2613               .
     2614             end.
     2615           end.
     2616           if v-restore-saved <> true
     2617           then do:
     2618             if v-diasize-wndmax = true
     2619             then do:
     2620               run diasize_maximize in this-procedure
     2621                 (input  true
     2622                 ) .
     2623             end.
     2624           end.
     2625         end.
     2626         else do:
     2627           if v-diasize-wndmax = true
     2628           then do:
     2629             run diasize_maximize in this-procedure
     2630               (input  true
     2631               ) .
     2632           end.
     2633         end.
     2634       end.
     2635     end.
     2636   end procedure.
     2637   procedure diasize_need-full-display :
     2638     define output parameter p-need-full-display as logical   no-undo .
     2639     do
     2640     on error undo, return error return-value
     2641     :
     2642       assign
     2643         p-need-full-display = v-diasize-need-full-display
     2644       .
     2645       assign
     2646         v-diasize-need-full-display = false
     2647       .
     2648     end.
     2649   end procedure.
     2650   procedure get-context :
     2651      define output parameter p-db-num as integer          no-undo.
     2652      define output parameter p-user-id as character        no-undo.
     2653      define variable v-login               as character    no-undo.
     2654      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2655      define buffer buf_user-login  for ub.user-login .
     2656      do
     2657      on error undo, return error
     2658      :
     2659            FIND FIRST buf_sys-ctrl no-lock.
     2660            ASSIGN
     2661               v-login = USERID("ub")
     2662               p-db-num = buf_sys-ctrl.db-num
     2663            .
     2664            FIND FIRST buf_user-login
     2665                 WHERE buf_user-login.db-num = p-db-num
     2666                   AND buf_user-login.user-login = v-login
     2667                 no-lock
     2668                 no-error
     2669                 .
     2670            IF AVAILABLE buf_user-login
     2671            THEN DO:
     2672               assign
     2673                  p-user-id = buf_user-login.user-id
     2674               .
     2675            END.
     2676      end.
     2677   end procedure.
     2678   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2679   on f5 of frame Dialog-Frame anywhere
     2680   do:
     2681     rep-rec = recid(X_c-fbr-gds-obj). run OpenBr in this-procedure  ( input yes, input no, input '':U). reposition br-c-fbr-gds-obj to recid rep-rec no-error. rep-rec = ?.               APPLY 'ENTRY' to br-c-fbr-gds-obj. APPLY 'VALUE-CHANGED' to br-c-fbr-gds-obj.
     2682       apply "VALUE-CHANGED" to BR-c-fbr-gds-obj.
     2683   end.
     2684   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2685   do:
     2686     BR-c-fbr-gds-obj :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2687   end.
     2688   def var sort-labelBR-c-fbr-gds-obj   as character no-undo .
     2689   def var sort-clmnBR-c-fbr-gds-obj    as handle    no-undo .
     2690   def var cur-clmnBR-c-fbr-gds-obj     as handle    no-undo .
     2691   def var cur-clmn-locBR-c-fbr-gds-obj as integer   no-undo .
     2692   def var re-queryBR-c-fbr-gds-obj     as logical   initial no no-undo .
     2693   on start-search, ctrl-o of BR-c-fbr-gds-obj in frame Dialog-Frame do:
     2694      run sort-brBR-c-fbr-gds-obj
     2695        (input (if available X_c-fbr-gds-obj
     2696                then recid(X_c-fbr-gds-obj)
     2697                else ?
     2698               )
     2699        ).
     2700   end.
     2701   PROCEDURE sort-brBR-c-fbr-gds-obj :
     2702     define input parameter p-recid as recid no-undo .
     2703     if re-queryBR-c-fbr-gds-obj = no then do:
     2704       assign
     2705          cur-clmnBR-c-fbr-gds-obj = BR-c-fbr-gds-obj:current-column in frame Dialog-Frame
     2706       .
     2707       if sort-clmnBR-c-fbr-gds-obj <> ? then sort-clmnBR-c-fbr-gds-obj:column-fgcolor = 0.
     2708       if cur-clmnBR-c-fbr-gds-obj = sort-clmnBR-c-fbr-gds-obj then do:
     2709         assign
     2710            sort-labelBR-c-fbr-gds-obj = ""
     2711            sort-clmnBR-c-fbr-gds-obj = ?
     2712         .
     2713        end.
     2714        else do:
     2715          assign
     2716            sort-labelBR-c-fbr-gds-obj = cur-clmnBR-c-fbr-gds-obj:label
     2717            sort-clmnBR-c-fbr-gds-obj  = cur-clmnBR-c-fbr-gds-obj
     2718            sort-clmnBR-c-fbr-gds-obj:column-fgcolor = 4
     2719          .
     2720        end.
     2721      end.
     2722     assign
     2723       cur-clmn-locBR-c-fbr-gds-obj = 1
     2724     .
     2725     def var column-handle as handle no-undo .
     2726     column-handle = BR-c-fbr-gds-obj:first-column.
     2727     do while valid-handle(column-handle) :
     2728       if column-handle = cur-clmnBR-c-fbr-gds-obj then do:
     2729         leave .
     2730       end.
     2731       column-handle = column-handle:NEXT-COLUMN.
     2732       assign
     2733         cur-clmn-locBR-c-fbr-gds-obj = cur-clmn-locBR-c-fbr-gds-obj + 1
     2734       .
     2735     end.
     2736     case sort-labelBR-c-fbr-gds-obj:
     2737           when X_c-fbr-gds-obj.corr-date:label in browse BR-c-fbr-gds-obj then DO:    assign       sort-column-name = "X_c-fbr-gds-obj.corr-date"     .     run OpenBr in this-procedure  ( input yes, input no, input '':U).   . END.
     2738       otherwise do:
     2739         assign
     2740           sort-column-name = ""
     2741         .
     2742         run OpenBr in this-procedure  ( input yes, input no, input '':U).
     2743         if sort-labelBR-c-fbr-gds-obj <> "" then do:
     2744           assign
     2745             cur-clmnBR-c-fbr-gds-obj:column-fgcolor = 0
     2746           .
     2747         end.
     2748         assign
     2749           cur-clmn-locBR-c-fbr-gds-obj = ?
     2750         .
     2751       end.
     2752     end case.
     2753     if p-recid <> ? then do:
     2754       reposition BR-c-fbr-gds-obj to recid p-recid no-error.
     2755       apply "value-changed" to BR-c-fbr-gds-obj in frame Dialog-Frame.
     2756     end.
     2757     apply "entry" to BR-c-fbr-gds-obj in frame Dialog-Frame.
     2758   END PROCEDURE.
     2759   procedure re-open-query-srt-clmnBR-c-fbr-gds-obj:
     2760   if cur-clmnBR-c-fbr-gds-obj = ? then do:
     2761      run OpenBr in this-procedure  ( input yes, input no, input '':U).
     2762   end.
     2763   else do:
     2764      assign re-queryBR-c-fbr-gds-obj = yes.
     2765      run sort-brBR-c-fbr-gds-obj
     2766        (input (if available X_c-fbr-gds-obj
     2767                then recid(X_c-fbr-gds-obj)
     2768                else ?
     2769               )
     2770        ).
     2771      assign re-queryBR-c-fbr-gds-obj = no.
     2772   end.
     2773   end.
     2774   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2775   procedure set-filter-name :
     2776   define input parameter p-filter-name as character no-undo .
     2777     do with frame Dialog-Frame:
     2778       if p-filter-name > "" then do:
     2779         assign
     2780           frame Dialog-Frame:title
     2781             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2782         .
     2783         assign
     2784           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2785         .
     2786       end.
     2787       else do:
     2788         assign
     2789           b-sch :tooltip = ""
     2790         .
     2791       end.
     2792     end.
     2793   end procedure.
     2794   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2795   on INS of frame Dialog-Frame anywhere do:
     2796     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2797     return no-apply.
     2798   end.
     2799   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2800   on F2 of frame Dialog-Frame anywhere do:
     2801     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2802     return no-apply.
     2803   end.
     2804   MAIN-BLOCK:
     2805   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2806      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2807     CASE p-mode:
     2808      WHEN "one":U THEN DO:
     2809        find first X_fbr-gds-obj no-lock where
     2810                   X_fbr-gds-obj.obj-type = p-obj-type
     2811              AND  X_fbr-gds-obj.obj-code = p-obj-code
     2812              AND  X_fbr-gds-obj.gds-code = p-gds-code
     2813              no-error .
     2814        if not available X_fbr-gds-obj then do:
     2815           message
     2816           vss-workfile vss-revision vss-description skip
     2817           "Неверное значение параметров p-obj-type p-obj-code p-gds-code"
     2818           view-as alert-box ERROR.
     2819           return.
     2820        end.
     2821      END.
     2822      otherwise do:
     2823         message vss-workfile vss-revision vss-description skip
     2824         "Неверный вызов - p-mode" p-mode
     2825         view-as alert-box ERROR.
     2826         return.
     2827       end.
     2828     end case.
     2829     v-rid-list = p-rid-list.
     2830     RUN MyEnable in this-procedure .
     2831     HIDE mark-num in frame Dialog-Frame .
     2832     run OpenBR in this-procedure  ( input yes, input no, input '':U).
     2833     run diasize_add_browse in this-procedure
     2834       (input  'width':u
     2835       ,input  browse br-changes :handle
     2836       ) .
     2837     run diasize_init in this-procedure .
     2838     WAIT-FOR GO OF FRAME Dialog-Frame.
     2839   END.
     2840   RUN disable_UI.
     2841   PROCEDURE disable_UI :
     2842     HIDE FRAME Dialog-Frame.
     2843   END PROCEDURE.
     2844   PROCEDURE enable_UI :
     2845     DISPLAY mark-num
     2846         WITH FRAME Dialog-Frame.
     2847     ENABLE b-quit B-mark b-sel B-sch B-Help mark-num BR-c-fbr-gds-obj BR-changes
     2848         WITH FRAME Dialog-Frame.
     2849     VIEW FRAME Dialog-Frame.
     2850   END PROCEDURE.
     2851   PROCEDURE MyEnable :
     2852   assign
     2853   temp-changes.l_name:resizable in browse br-changes = true
     2854   temp-changes.v_old:resizable in browse br-changes = true
     2855   temp-changes.v_new:resizable in browse br-changes = true
     2856   temp-changes.l_name:width in browse br-changes = 30
     2857   temp-changes.v_old:width in browse br-changes = 40
     2858   temp-changes.v_new:width in browse br-changes = 40
     2859   X_c-fbr-gds-obj.corr-date:READ-ONLY IN BROWSE br-c-fbr-gds-obj = YES
     2860   .
     2861   DISPLAY
     2862   mark-num
     2863   br-changes
     2864   WITH FRAME Dialog-Frame.
     2865   ENABLE
     2866   B-quit
     2867   B-mark when lookup('b-mark':U, bttns) >0
     2868   B-sel when lookup('b-sel':U, bttns) >0
     2869   B-sch
     2870   B-Help
     2871   BR-c-fbr-gds-obj
     2872   br-changes
     2873   mark-num
     2874   WITH FRAME Dialog-Frame.
     2875   VIEW FRAME Dialog-Frame.
     2876   END PROCEDURE.
     2877   PROCEDURE OpenBr :
     2878   define input  parameter p-open-query     as logical   no-undo .
     2879   define input  parameter p-find-next      as logical   no-undo .
     2880   define input  parameter p-find-condition as character no-undo .
     2881   define variable l-query-was-opened as logical no-undo .
     2882   run waitfram-show in this-procedure ( input "Ждите...").
     2883   define variable sort-column-phrase as character no-undo .
     2884   case sort-column-name :
     2885     when "" then do:
     2886       assign
     2887         sort-column-phrase = ""
     2888       .
     2889     end.
     2890     otherwise do:
     2891       assign
     2892         sort-column-phrase = "by " + sort-column-name
     2893       .
     2894     end.
     2895   end case.
     2896   CASE p-mode:
     2897       when "one":U then do:
     2898           ASSIGN frame Dialog-Frame:TITLE = substitute("Справочник истории АТРИБУТА ТОВАРА РЕСТОРАН: объект &1&2 товар &3",
     2899                                                          p-obj-type, p-obj-code, p-gds-code)
     2900           filter-point = filter-point0 + p-mode
     2901           filter-label = substitute("&1", filter-label0)
     2902           .
     2903   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2904   define variable  l-disable-where-23  as logical   no-undo .
     2905   define variable  l-filter-open-23    as logical   .
     2906   define variable  flt-rec-23       as recid     no-undo .
     2907   define variable  filter-name-23      as character no-undo .
     2908   define variable  where-phrase-23     as character no-undo .
     2909   define variable  sort-phrase-23      as character no-undo .
     2910   define variable  where-phrase-rus-23 as character no-undo .
     2911   define variable  sort-phrase-rus-23  as character no-undo .
     2912     run waitfram-show in this-procedure
     2913       (input "ЖДИТЕ ..."
     2914       ).
     2915   run gbl/flt-get.p
     2916     (input filter-point
     2917     ,output flt-rec-23
     2918     ,output filter-name-23
     2919     ,output where-phrase-23
     2920     ,output sort-phrase-23
     2921     ,output where-phrase-rus-23
     2922     ,output sort-phrase-rus-23
     2923     ).
     2924       run set-filter-name in this-procedure
     2925         (INPUT filter-name-23
     2926         ) no-error .
     2927     assign
     2928       l-filter-open-23 = false
     2929     .
     2930     if flt-rec-23 <> ?
     2931       or sort-column-phrase > ""
     2932     then do:
     2933       define variable  parameter-2-23 as character no-undo .
     2934       define variable  parameter-3-23 as character no-undo .
     2935       define variable  parameter-4-23 as character no-undo .
     2936       define variable  parameter-5-23 as character no-undo .
     2937       define variable  parameter-6-23 as character no-undo .
     2938       define variable  parameter-7-23 as character no-undo .
     2939         assign
     2940         parameter-3-23 =
     2941                                 "FOR EACH X_c-fbr-gds-obj"
     2942         parameter-4-23 =
     2943           (
     2944             if (" X_c-fbr-gds-obj.obj-code = p-obj-code AND X_c-fbr-gds-obj.obj-type = p-obj-type AND                             X_c-fbr-gds-obj.gds-code = p-gds-code" + " " + where-phrase-23) <> ""
     2945             then  substitute('X_c-fbr-gds-obj.obj-code = &1 AND X_c-fbr-gds-obj.obj-type = &2&3&2 AND                             X_c-fbr-gds-obj.gds-code = &4', p-obj-code, chr(34), p-obj-type, p-gds-code )  + " " + where-phrase-23
     2946             else "true"
     2947           )
     2948         parameter-5-23 = (" " + "" + " " + "")
     2949         parameter-6-23 = if sort-phrase-23 = ''
     2950                              then
     2951           (
     2952           " " + "  " +
     2953             " " + sort-column-phrase +
     2954           " " + "  "
     2955           )
     2956                              else
     2957           (
     2958           " " + "  " +
     2959             " " + sort-column-phrase +
     2960           " " + sort-phrase-23
     2961           )
     2962         parameter-7-23 =
     2963           "   "
     2964       .
     2965       do
     2966       on stop undo, leave
     2967       on error undo, leave
     2968       :
     2969         assign
     2970           l-disable-where-23 =
     2971             (" X_c-fbr-gds-obj.obj-code = p-obj-code AND X_c-fbr-gds-obj.obj-type = p-obj-type AND                             X_c-fbr-gds-obj.gds-code = p-gds-code" + " " + where-phrase-23 = "")
     2972         .
     2973         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2974                             ,input query br-c-fbr-gds-obj:handle
     2975                             ,input parameter-3-23
     2976                             ,input parameter-4-23
     2977                             ,input parameter-5-23
     2978                             ,input parameter-6-23
     2979                             ,input parameter-7-23
     2980                             )
     2981         .
     2982         assign
     2983           l-filter-open-23 = true
     2984         .
     2985       end.
     2986       if l-filter-open-23 = false then do:
     2987         message
     2988           "Ошибка при фильтрации / сортировке" skip
     2989           "Будут показаны записи без учета фильтра" skip
     2990           view-as alert-box .
     2991       end.
     2992       else do:
     2993           assign
     2994             l-query-was-opened = true
     2995           .
     2996       end.
     2997     end.
     2998     if l-filter-open-23 = false then do:
     2999       OPEN QUERY br-c-fbr-gds-obj FOR EACH X_c-fbr-gds-obj no-lock
     3000         where  X_c-fbr-gds-obj.obj-code = p-obj-code AND X_c-fbr-gds-obj.obj-type = p-obj-type AND                             X_c-fbr-gds-obj.gds-code = p-gds-code
     3001     .
     3002         assign
     3003           l-query-was-opened = true
     3004         .
     3005     end.
     3006     run waitfram-hide in this-procedure .
     3007       end.
     3008   END CASE.
     3009   apply "entry" to br-c-fbr-gds-obj in frame Dialog-Frame.
     3010   if rep-rec <> ? then reposition br-c-fbr-gds-obj to recid rep-rec no-error.
     3011   if error-status:error then do:
     3012     reposition br-c-fbr-gds-obj to row 1 no-error.
     3013   end.
     3014   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3015   query br-c-fbr-gds-obj:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3016   run waitfram-hide in this-procedure .
     3017   run waitfram-hide in this-procedure .
     3018   APPLY "VALUE-CHANGED":U to br-c-fbr-gds-obj.
     3019   END PROCEDURE.
     3020   PROCEDURE proc-b-sch :
     3021   assign
     3022   tbl = 'c-fbr-gds-obj'
     3023   join-tbl = 'X_c-fbr-gds-obj'
     3024   fld = ""
     3025   lab = ""
     3026   spr = ""
     3027   dim = '0'
     3028   .
     3029   run fltfield-add in this-procedure('fbr-obj-code', 'Кухня', 'cli',
     3030   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3031   run fltfield-add in this-procedure('gds-code', 'Группа меню', 'fbr-gds-grp',
     3032   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3033   run fltfield-add in this-procedure('is-cd', 'Отсылать на кассу', '',
     3034   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3035   run fltfield-add in this-procedure('is-menu', 'Блюдо меню', '',
     3036   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3037   run fltfield-add in this-procedure('is-modificator', 'Модификатор блюда', '',
     3038   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3039   run fltfield-add in this-procedure('is-null-price', 'Без цены', '',
     3040   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3041   run fltfield-add in this-procedure('is-season', 'Использовать сезонные коэфф.', '',
     3042   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3043   run fltfield-add in this-procedure('is-semi-finished', 'Полуфабрикат', '',
     3044   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3045   run fltfield-add in this-procedure('corr-date', '', '',
     3046   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3047   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     3048   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3049   run fltfield-add in this-procedure('corr-user-db-num', '', '',
     3050   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3051   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     3052   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3053   DO on stop undo, leave:
     3054     run gbl/filter.w ( input parparentproc
     3055                       ,input filter-point + chr(4) + filter-label
     3056                       ,input tbl
     3057                       ,input join-tbl
     3058                       ,input fld
     3059                       ,input lab
     3060                       ,input spr
     3061                       ,input dim).
     3062     RUN OpenBr in this-procedure  ( input yes, input no, input '':U).
     3063   END .
     3064   END PROCEDURE.
     3065   PROCEDURE proc-view-changes :
     3066   for each temp-changes:
     3067       delete temp-changes.
     3068   END.
     3069   if not available X_c-fbr-gds-obj then do:
     3070     Open QUery br-changes for each temp-changes.
     3071     return.
     3072   end.
     3073   define variable v-label-param as character no-undo .
     3074   v-label-param =
     3075     "fbr-grp-code" + chr(4) + "Внутр. код группы меню" + chr(4) + "" + chr(8)
     3076    + "fbr-obj-code" + chr(4) + "Кухня" + chr(4) + "" + chr(8)
     3077    + "is-cd" + chr(4) + "Отсылать на кассу" + chr(4) + "" + chr(8)
     3078    + "is-menu" + chr(4) + "Блюдо меню" + chr(4) + "" + chr(8)
     3079    + "is-modificator" + chr(4) + "Модификатор блюда" + chr(4) + "" + chr(8)
     3080    + "is-null-price" + chr(4) + "Без цены" + chr(4) + "" + chr(8)
     3081    + "is-season" + chr(4) + "Использовать сезонный коэфф." + chr(4) + "" + chr(8)
     3082    + "is-semi-finished" + chr(4) + "Полуфабрикат" + chr(4) + ""  .
     3083    run proc-full-temp-changes in this-procedure (
     3084                                                input  buffer X_c-fbr-gds-obj:handle
     3085                                               ,input  'fbr-gds-obj':U
     3086                                               ,input  "fbr-grp-code,fbr-obj-code,is-cd,is-menu,is-modificator,is-null-price,is-season,is-semi-finished"
     3087                                               ,input  v-label-param).
     3088   Open QUery br-changes for each temp-changes.
     3089   END PROCEDURE.
