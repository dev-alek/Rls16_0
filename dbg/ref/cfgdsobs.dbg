        1   DEFINE BUFFER buf_cli FOR ub.clients.
        2   DEFINE BUFFER for-c-fbr-gds-obj FOR ub.c-fbr-gds-obj.
        3   DEFINE BUFFER X_c-fbr-gds-obj FOR ub.c-fbr-gds-obj.
        4   define input parameter parparentproc as widget-handle no-undo .
        5   DEFINE INPUT PARAMETER bttns  as character  no-undo .
        6   DEFINE INPUT PARAMETER p-mode as character no-undo.
        7   define input parameter p-obj-type like ub.fbr-gds-obj.obj-type no-undo .
        8   define input parameter p-obj-code like ub.fbr-gds-obj.obj-code no-undo .
        9   define input parameter p-gds-code like ub.fbr-gds-obj.gds-code no-undo .
       10   DEFINE OUTPUT PARAMETER  p-rid-list    as  char no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision$":u .
       12   define variable vss-author      as character no-undo init "$Author$":u .
       13   define variable vss-date        as character no-undo init "$Date$":u .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       15   define variable vss-archive     as character no-undo init "$Archive$":u .
       16   define variable vss-description as character no-undo init "Справочник истории АТРИБУТА ТОВАРА РЕСТОРАН" .
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   procedure cur-time :
      124      define output parameter p-today as date      no-undo .
      125      define output parameter p-time  as integer   no-undo .
      126     do
      127     on error undo, return error
      128     :
      129       define variable v-date1 as date      no-undo .
      130       define variable v-date2 as date      no-undo .
      131       define variable v-time  as integer   no-undo .
      132       assign
      133         v-date1 = today
      134         v-time  = time
      135         v-date2 = today
      136       .
      137       if v-date1 <> v-date2
      138       then do:
      139         assign
      140           v-date1 = today
      141           v-time  = v-time
      142         .
      143       end.
      144       assign
      145         p-today = v-date1
      146         p-time  = v-time
      147       .
      148     end.
      149   end.
      150   function cur-time-date returns character
      151   :
      152     return string(today, '99/99/9999':U) .
      153   end.
      154   function cur-time-mjd returns decimal
      155   :
      156     define variable v-date as date      no-undo .
      157     define variable v-time as integer   no-undo .
      158     run cur-time in this-procedure
      159       (output v-date
      160       ,output v-time
      161       ) .
      162     return integer(v-date) - 2400002 + (v-time / 86400) .
      163   end.
      164   function cur-time-get-ending-index returns integer
      165   (input p-number as integer
      166   )
      167   :
      168     if p-number < 0
      169     or p-number = ?
      170     then do:
      171       return 1 .
      172     end.
      173     define variable v-rest as integer   no-undo .
      174     assign
      175       p-number = p-number modulo 100
      176     .
      177     if p-number < 20
      178     then do:
      179       assign
      180         v-rest = p-number
      181       .
      182     end.
      183     else do:
      184       assign
      185         v-rest = p-number modulo 10
      186       .
      187     end.
      188     case v-rest :
      189       when 1
      190       then do:
      191         return 2 .
      192       end.
      193       when 2 or
      194       when 3 or
      195       when 4
      196       then do:
      197         return 3 .
      198       end.
      199       otherwise do:
      200         return 1 .
      201       end.
      202     end case .
      203   end.
      204   procedure cur-time-mjd-to-date :
      205      define input  parameter i-mjd-diff as decimal no-undo.
      206      define output parameter o-Date     as date    no-undo.
      207      define output parameter o-Time     as integer no-undo.
      208      define variable v-day-number as integer   no-undo .
      209      if    i-mjd-diff < 0
      210         or i-mjd-diff = ?
      211      then do:
      212         return "?" .
      213      end.
      214      assign
      215         v-day-number = truncate(i-mjd-diff,0).
      216         o-Date = date(v-day-number + 2400002).
      217         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      218     .
      219   end.
      220   function cur-time-mjd-to-string returns character
      221   (input p-mjd-diff as decimal
      222   )
      223   :
      224     define variable v-day-number as integer   no-undo .
      225     define variable v-seconds    as integer   no-undo .
      226     define variable v-hour       as integer   no-undo .
      227     define variable v-min        as integer   no-undo .
      228     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      229     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      230     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      231     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      232     if p-mjd-diff < 0
      233     or p-mjd-diff = ?
      234     then do:
      235       return "?" .
      236     end.
      237     assign
      238       v-day-number = integer(truncate(p-mjd-diff,0))
      239       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      240     .
      241     if v-seconds > 86400
      242     then do:
      243       assign
      244         v-seconds = 86400 - 1
      245       .
      246     end.
      247     if v-seconds < 0
      248     then do:
      249       assign
      250         v-seconds = 0
      251       .
      252     end.
      253     assign
      254       v-hour = truncate(v-seconds / 3600, 0)
      255     .
      256     assign
      257       v-seconds = v-seconds modulo 3600
      258     .
      259     assign
      260       v-min = truncate(v-seconds / 60, 0)
      261     .
      262     assign
      263       v-seconds = v-seconds modulo 60
      264     .
      265     return
      266         (if v-day-number <> 0
      267           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      268           else ""
      269         )
      270       + (if v-day-number <> 0 or v-hour <> 0
      271           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      272           else ""
      273         )
      274       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      275           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      276           else ""
      277         )
      278       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      279       .
      280   end.
      281   function cur-time-string returns character
      282   :
      283     define variable v-date as date      no-undo .
      284     define variable v-time as integer   no-undo .
      285     run cur-time in this-procedure
      286       (output v-date
      287       ,output v-time
      288       ) .
      289     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      290   end.
      291   function cur-time-string-sec returns character
      292   :
      293     define variable v-date as date      no-undo .
      294     define variable v-time as integer   no-undo .
      295     run cur-time in this-procedure
      296       (output v-date
      297       ,output v-time
      298       ) .
      299     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      300   end.
      301   function cur-time-custom  returns character
      302   (input p-prefix as character
      303   ,input p-date-format as character
      304   ,input p-delimiter as character
      305   ,input p-time-format as character
      306   ,input p-suffix as character
      307   )
      308   :
      309     define variable v-date as date      no-undo .
      310     define variable v-time as integer   no-undo .
      311     run cur-time in this-procedure
      312       (output v-date
      313       ,output v-time
      314       ) .
      315     return
      316       p-prefix
      317       + string(v-date, p-date-format)
      318       + p-delimiter
      319       + string(v-time, p-time-format)
      320       + p-suffix
      321       .
      322   end.
      323   function cur-time-print  returns character
      324   :
      325     define variable v-date as date      no-undo .
      326     define variable v-time as integer   no-undo .
      327     run cur-time in this-procedure
      328       (output v-date
      329       ,output v-time
      330       ) .
      331     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      332   end.
      333   function cur-time-datetime returns datetime
      334   :
      335     define variable v-char as character no-undo .
      336     define variable v-datetime as datetime no-undo .
      337     v-char = cur-time-string().
      338     v-datetime = datetime(v-char).
      339     return  v-datetime.
      340   end.
      341   function cur-time-string-msec returns character
      342   :
      343     define variable v-date as datetime  no-undo .
      344     v-date = now.
      345     return string(v-date) .
      346   end.
      347   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      348   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      349   define new shared variable RepPathName        as character no-undo .
      350   define new shared variable PrintRubl          as logical   no-undo .
      351   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      352   procedure wth-lib_cur-stock-place:
      353   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
      354   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
      355   define input  parameter parw-p-code like ub.wth-pobj.w-p-code  no-undo.
      356   define input  parameter parwth-code like ub.wth-pobj.wth-code  no-undo.
      357   define output parameter parstock    like ub.wth-pobj.income-pl no-undo.
      358   define buffer bf_wth-pobj for ub.wth-pobj.
      359   find first bf_wth-pobj where bf_wth-pobj.obj-type = parobj-type and
      360                                bf_wth-pobj.obj-code = parobj-code and
      361                                bf_wth-pobj.w-p-code = parw-p-code and
      362                                bf_wth-pobj.wth-code = parwth-code no-lock no-error.
      363   if available bf_wth-pobj then assign parstock = bf_wth-pobj.income-pl - bf_wth-pobj.incass-pl.
      364                            else assign parstock = 0.
      365   end procedure.
      366   procedure wth-lib_cur-stock-obj:
      367   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
      368   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
      369   define input  parameter parwth-code like ub.wth-obj.wth-code   no-undo.
      370   define output parameter parstock    like ub.wth-obj.income     no-undo.
      371   define buffer bf_wth-obj for ub.wth-obj.
      372   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
      373                               bf_wth-obj.obj-code = parobj-code and
      374                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
      375   if available bf_wth-obj then assign parstock = bf_wth-obj.income - bf_wth-obj.incass.
      376                           else assign parstock = 0.
      377   end.
      378   FUNCTION wth-lib_cur-stock-obj-func RETURNS DECIMAL (INPUT parobj-type AS CHARACTER,
      379                                                        INPUT parobj-code AS INTEGER,
      380                                                        INPUT parwth-code AS INTEGER):
      381   define buffer bf_wth-obj for ub.wth-obj.
      382   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
      383                               bf_wth-obj.obj-code = parobj-code and
      384                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
      385   if available bf_wth-obj then return (bf_wth-obj.income - bf_wth-obj.incass).
      386                           else return 0.00.
      387   end function.
      388   FUNCTION wth-lib_cur-stock-host-func RETURNS DECIMAL (INPUT parhost-code AS INTEGER,
      389                                                         INPUT parwth-code  AS INTEGER):
      390   define buffer bf_wth-obj for ub.wth-obj.
      391   define variable v-stock like ub.wth-obj.income no-undo.
      392   for each bf_wth-obj no-lock where bf_wth-obj.host-code = parhost-code and
      393                                     bf_wth-obj.wth-code = parwth-code :
      394     v-stock = v-stock +  bf_wth-obj.income - bf_wth-obj.incass.
      395   end.
      396   return v-stock.
      397   end function.
      398   procedure wth-lib_full-inf-shift:
      399   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parshift-date   like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num    like ub.shift-obj.shift-num   no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.shift-date = parshift-date and                        cur_wth-line.shift-num  = parshift-num  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-sdn no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                                                                             start_wth-line.wth-code   = parwth-code         and                                (start_wth-line.shift-date = parshift-date and                           start_wth-line.shift-num  < parshift-num  or                            start_wth-line.shift-date < parshift-date ) and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-sdn no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income - cur_wth-line.incass              parincome        = cur_wth-line.income                     parincome-cassa  = cur_wth-line.income-cassa               parincome-other  = cur_wth-line.income-other               parincass        = cur_wth-line.incass                     parincass-bank   = cur_wth-line.incass-bank                parincass-other  = cur_wth-line.incass-other.              parincass-cassa  = cur_wth-line.incass-cassa.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income     - start_wth-line.incass               parstock-end     = cur_wth-line.income       - cur_wth-line.incass                 parincome        = cur_wth-line.income       - start_wth-line.income               parincome-cassa  = cur_wth-line.income-cassa - start_wth-line.income-cassa         parincome-other  = cur_wth-line.income-other - start_wth-line.income-other         parincass        = cur_wth-line.incass       - start_wth-line.incass               parincass-bank   = cur_wth-line.incass-bank  - start_wth-line.incass-bank          parincass-other  = cur_wth-line.incass-other - start_wth-line.incass-other.        parincass-cassa  = cur_wth-line.incass-cassa - start_wth-line.incass-cassa.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income - start_wth-line.incass                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      400   end procedure.
      401   procedure wth-lib_full-inf-shift-inter:
      402   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parshift-date   like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num    like ub.shift-obj.shift-num   no-undo.                        define input  parameter parshift-date1  like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num1   like ub.shift-obj.shift-num   no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                     