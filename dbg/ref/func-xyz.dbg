       78   .
       79   define temp-table    x-analysis         no-undo  like ub.XYZ-analysis
       80   field r-goods as integer.
       81   define temp-table    x-analysis-period  no-undo  like ub.XYZ-analysis-period.
       82   define input         parameter table for    x-analysis.
       83   define input         parameter table for    x-analysis-period.
       84   define input-output  parameter table for    temp-oborot.
       85   define input-output  parameter table for    temp-xyz.
       86   define output        parameter table for    temp-goods.
       87   define variable vss-revision    as character no-undo init "$Revision: c5e125f9f735, 902, rls $":U .
       88   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       89   define variable vss-date        as character no-undo init "$Date: Tue Dec 06 17:15:45 2016 +0300 $":U .
       90   define variable vss-workfile    as character no-undo init "$Workfile: func-xyz.p $":U .
       91   define variable vss-archive     as character no-undo init "$Archive: ref/func-xyz.p $":U .
       92   define variable vss-description as character no-undo init "Проведение XYZ анализа".
       93   procedure vss-get-info :
       94     define output parameter p-vss-revision    like vss-revision    no-undo .
       95     define output parameter p-vss-author      like vss-author      no-undo .
       96     define output parameter p-vss-date        like vss-date        no-undo .
       97     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       98     define output parameter p-vss-archive     like vss-archive     no-undo .
       99     define output parameter p-vss-description like vss-description no-undo .
      100     assign
      101       p-vss-revision    = vss-revision
      102       p-vss-author      = vss-author
      103       p-vss-date        = vss-date
      104       p-vss-workfile    = vss-workfile
      105       p-vss-archive     = vss-archive
      106       p-vss-description = vss-description
      107     .
      108   end procedure.
      109   procedure vss-get-parameters :
      110     define output parameter p-vss-parameters as character no-undo .
      111   end procedure.
      112   define new global shared variable g#vssrevis-logger as handle    no-undo .
      113   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      114   define variable v-vssrevis-logger                   as handle    no-undo .
      115   procedure vss-logevent :
      116     define input  parameter p-extra-paramters as character no-undo .
      117     define variable v-vssrevis-parameters as character no-undo .
      118     do
      119     on error undo, return error return-value
      120     :
      121       if  valid-handle(v-vssrevis-logger)
      122       and v-vssrevis-logger :get-signature("logevent") <> ""
      123       then do:
      124         run vss-get-parameters in this-procedure
      125           (output v-vssrevis-parameters
      126           ).
      127         run logevent in v-vssrevis-logger
      128           (input vss-workfile
      129           ,input vss-revision
      130           ,input v-vssrevis-parameters
      131           ,input p-extra-paramters
      132           ).
      133       end.
      134     end.
      135   end procedure.
      136   assign
      137     v-vssrevis-logger = g#vssrevis-logger
      138   .
      139   if  valid-handle(v-vssrevis-logger)
      140   and v-vssrevis-logger :get-signature("logevent") <> ""
      141   then do:
      142     assign
      143       v-vssrevis-logevent = true
      144     .
      145     run vss-logevent in this-procedure (input vss-description) .
      146   end.
      147   define new global shared variable g#language as character no-undo .
      148   if g#language <> '' and g#language <> 'rus':U then do:
      149     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      150   end.
      151   define new global shared variable g#library  as handle no-undo .
      152   define new global shared variable g#library2 as handle no-undo .
      153   define   shared variable g#auto as logical no-undo.
      154   define   shared variable g#news as logical no-undo.
      155   define   shared variable g#oxml as logical no-undo.
      156   define   shared variable g#esys as logical no-undo.
      157   define   shared variable g#news-source-db as integer no-undo.
      158   define   shared variable g#esys-source-esys as integer no-undo.
      159   define   shared variable g#db-num as integer   no-undo .
      160   define   shared variable g#userid as character no-undo .
      161   define   shared variable g#passwd as character no-undo .
      162   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      163   procedure factord :
      164     define input  parameter p-fact-date            as date    no-undo .
      165     define input  parameter p-fact-time            as integer no-undo .
      166     define input  parameter p-fact-num             as integer no-undo .
      167     define input  parameter p-shift-date           as date    no-undo .
      168     define input  parameter p-shift-num            as integer no-undo .
      169     define input  parameter p-shift-on             as logical no-undo .
      170     define output parameter p-fact-order           as decimal no-undo .
      171     define output parameter p-shift-end-fact-order as decimal no-undo .
      172     define output parameter p-day-end-fact-order   as decimal no-undo .
      173     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      174     if p-fact-date = ?
      175     then do:
      176       return error "Не указана фактическая дата" .
      177     end.
      178     define variable v-fact-date-num as integer no-undo .
      179     assign
      180       v-fact-date-num = integer(p-fact-date)
      181     .
      182     if p-fact-num = ?
      183     or p-fact-num = 0
      184     then do:
      185       return error "Не задан p-fact-num " + string(p-fact-num) .
      186     end.
      187     if p-fact-num < 0
      188     then do:
      189       return error "Отрицательный fact-num " + string(p-fact-num) .
      190     end.
      191     if p-fact-num >= 100000000
      192     then do:
      193       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      194     end.
      195     if p-shift-on = true
      196     then do:
      197       if p-shift-date = ?
      198       then do:
      199         return error "Не задана дата смены" .
      200       end.
      201       if p-shift-num = ?
      202       or p-shift-num = 0
      203       then do:
      204         return error "Не задан номер смены" .
      205       end.
      206     end.
      207     else do:
      208       assign
      209         p-shift-date = p-fact-date
      210         p-shift-num  = 24
      211       .
      212     end.
      213     define variable v-shift-offset as integer no-undo .
      214     if p-shift-date = p-fact-date
      215     then do:
      216       assign
      217         v-shift-offset = 1
      218       .
      219     end.
      220     if p-shift-date < p-fact-date
      221     then do:
      222       assign
      223         v-shift-offset = 0
      224       .
      225     end.
      226     if p-shift-date > p-fact-date
      227     then do:
      228       message
      229         vss-workfile vss-revision vss-description skip
      230         "Неправильная дата закрытия смены" skip
      231         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      232         view-as alert-box error .
      233       undo, return error
      234         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      235           ,string(p-fact-date, '99/99/9999':U)
      236           ,string(p-shift-date, '99/99/9999':U)
      237           )
      238       .
      239     end.
      240     if p-shift-num < 1
      241     or p-shift-num > 24
      242     then do:
      243       message
      244         vss-workfile vss-revision vss-description skip
      245         "Неправильный номер смены" skip
      246         "p-shift-num" p-shift-num skip
      247         view-as alert-box error .
      248       undo, return error return-value .
      249     end.
      250     assign
      251       p-fact-order           = v-fact-date-num
      252                              + v-shift-offset * 0.5
      253                              + p-shift-num    * 0.02 - 0.01
      254                              + p-fact-num     * 0.0000000001
      255       p-shift-end-fact-order = v-fact-date-num
      256                              + v-shift-offset * 0.5
      257                              + p-shift-num    * 0.02
      258       p-day-end-fact-order   = v-fact-date-num
      259                              + 0.99
      260     .
      261     if p-fact-order           <= v-fact-date-num
      262     or p-shift-end-fact-order <= v-fact-date-num
      263     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      264     or p-shift-end-fact-order >= p-day-end-fact-order
      265     then do:
      266       message
      267         vss-workfile vss-revision vss-description skip
      268         "Внутренняя ошибка при генерации фактического номера" skip
      269         "p-fact-date"            p-fact-date            skip
      270         "p-fact-time"            p-fact-time            skip
      271         "p-fact-num"             p-fact-num             skip
      272         "p-shift-date"           p-shift-date           skip
      273         "p-shift-num"            p-shift-num            skip
      274         "p-shift-on"             p-shift-on             skip
      275         "p-shift-end-fact-order" p-shift-end-fact-order skip
      276         "p-day-end-fact-order"   p-day-end-fact-order   skip
      277         "v-fact-date-num"        v-fact-date-num        skip
      278         view-as alert-box error .
      279       undo, return error return-value .
      280     end.
      281   end procedure.
      282   procedure day-begin-fact-order :
      283     define input  parameter p-fact-date            as date    no-undo .
      284     define output parameter p-day-begin-fact-order as decimal no-undo .
      285     do
      286     on error undo, return error return-value
      287     :
      288       if p-fact-date = ?
      289       then do:
      290         assign
      291           p-day-begin-fact-order = 0
      292         .
      293       end.
      294       else do:
      295         assign
      296           p-day-begin-fact-order = integer(p-fact-date)
      297         .
      298       end.
      299     end.
      300   end procedure.
      301   procedure factord-max-fact-order :
      302     define output parameter p-max-fact-order as decimal   no-undo .
      303     do
      304     on error undo, return error return-value
      305     :
      306       run day-begin-fact-order in this-procedure
      307         (input  date(1, 1, 5000)
      308         ,output p-max-fact-order
      309         ) .
      310     end.
      311   end procedure.
      312   procedure factord-cut-archive :
      313     define input  parameter p-obj-type             as character no-undo .
      314     define input  parameter p-obj-code             as integer   no-undo .
      315     define input  parameter p-fact-date            as date      no-undo .
      316     define output parameter p-shift-on             as logical   no-undo .
      317     define output parameter p-shift-date           as date      no-undo .
      318     define output parameter p-shift-num            as integer   no-undo .
      319     define output parameter p-day-end-fact-order   as decimal   no-undo .
      320     define output parameter p-shift-end-fact-order as decimal   no-undo .
      321     define variable v-fact-order as decimal   no-undo .
      322     define buffer buf_shift-obj for ub.shift-obj .
      323     do
      324     on error undo, return error return-value
      325     :
      326   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      327   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      328     (input  p-obj-type
      329     ,input  p-obj-code
      330     ,input  'shift-on=request'
      331     ,output p-shift-on
      332     ) no-error .
      333       if error-status :error
      334       then do:
      335         message
      336           vss-workfile vss-revision vss-description skip
      337           "Ошибка при определении атрибута объекта" skip
      338           "Объект" p-obj-type p-obj-code skip
      339           error-status :get-message(1) skip
      340           return-value skip
      341           view-as alert-box error .
      342         undo, return error return-value .
      343       end.
      344       if p-shift-on = false
      345       then do:
      346         assign
      347           p-shift-date               = ?
      348           p-shift-num                = 0
      349         .
      350       end.
      351       else do:
      352         find first buf_shift-obj share-lock
      353           where buf_shift-obj.obj-type   = p-obj-type
      354             and buf_shift-obj.obj-code   = p-obj-code
      355             and buf_shift-obj.shift-date > p-fact-date
      356           use-index pi
      357           no-error .
      358         if not available buf_shift-obj
      359         or buf_shift-obj.status_ <> 'зкр':U
      360         then do:
      361           message
      362             vss-workfile vss-revision vss-description skip
      363             "Невозможно вычислить последнюю смену" skip
      364             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      365             "Объект" p-obj-type p-obj-code skip
      366             "Дата" p-fact-date skip
      367             view-as alert-box error .
      368           undo, return error return-value .
      369         end.
      370         find last buf_shift-obj share-lock
      371           where buf_shift-obj.obj-type = p-obj-type
      372             and buf_shift-obj.obj-code = p-obj-code
      373             and buf_shift-obj.shift-date <= p-fact-date
      374           use-index pi
      375           no-error .
      376         if available buf_shift-obj
      377         then do:
      378           if  buf_shift-obj.status_ = 'зкр':U
      379           then do:
      380             assign
      381               p-shift-date = buf_shift-obj.shift-date
      382               p-shift-num  = buf_shift-obj.shift-num
      383             .
      384           end.
      385           else do:
      386             message
      387               vss-workfile vss-revision vss-description skip
      388               "Невозможно вычислить последнюю смену" skip
      389               "Статус смены отличен от статуса" 'зкр':U skip
      390               "Объект" p-obj-type p-obj-code skip
      391               "Дата" p-fact-date skip
      392               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      393               view-as alert-box error .
      394             undo, return error return-value .
      395           end.
      396         end.
      397         else do:
      398           assign
      399             p-shift-date = p-fact-date - 1
      400             p-shift-num  = 1
      401           .
      402         end.
      403       end.
      404       run factord in this-procedure
      405         (input  p-fact-date
      406         ,input  1
      407         ,input  1
      408         ,input  p-shift-date
      409         ,input  p-shift-num
      410         ,input  p-shift-on
      411         ,output v-fact-order
      412         ,output p-shift-end-fact-order
      413         ,output p-day-end-fact-order
      414         ) no-error .
      415       if error-status :error
      416       then do:
      417         message
      418           vss-workfile vss-revision vss-description skip
      419           "Ошибка при вызове процедуры factord"
      420           error-status :get-message(1) skip
      421           return-value skip
      422           view-as alert-box error .
      423         undo, return error return-value .
      424       end.
      425     end.
      426   end procedure.
      427   procedure factord-lock-shift :
      428     define input  parameter p-obj-type  as character no-undo .
      429     define input  parameter p-obj-code  as integer   no-undo .
      430     define input  parameter p-fact-date as date      no-undo .
      431     define parameter buffer buf_shift-obj for ub.shift-obj .
      432     define variable v-shift-on      as logical   no-undo .
      433     define variable v-extra-message as character no-undo .
      434     define variable v-error as character no-undo .
      435     do
      436     on error undo, return error return-value
      437     :
      438   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      439   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      440     (input  p-obj-type
      441     ,input  p-obj-code
      442     ,input  'shift-on=request'
      443     ,output v-shift-on
      444     ) no-error .
      445       if error-status :error
      446       then do:
      447         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      448         undo, return error v-error .
      449       end.
      450       if v-shift-on = true
      451       then do:
      452         find first buf_shift-obj share-lock
      453           where buf_shift-obj.obj-type   = p-obj-type
      454             and buf_shift-obj.obj-code   = p-obj-code
      455             and buf_shift-obj.shift-date > p-fact-date
      456           use-index pi
      457           no-error .
      458         if not available buf_shift-obj
      459         or buf_shift-obj.status_ <> 'зкр':U
      460         then do:
      461           find last buf_shift-obj
      462             where buf_shift-obj.obj-type = p-obj-type
      463               and buf_shift-obj.obj-code = p-obj-code
      464               and buf_shift-obj.status_  = 'зкр':U
      465             use-index stts
      466             no-error .
      467           if available buf_shift-obj
      468           then do:
      469             assign
      470               v-extra-message =
      471                     substitute("Дата начала последеней закрытой смены на объекте &1"
      472                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      473                               )
      474             .
      475           end.
      476           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      477           undo, return error v-error .
      478         end.
      479       end.
      480     end.
      481   end procedure.
      482   procedure factord-end-day :
      483     define input  parameter p-fact-date            as date    no-undo .
      484     define output parameter p-day-end-fact-order   as decimal no-undo .
      485     do
      486     on error undo, return error return-value
      487     :
      488       if p-fact-date = ?
      489       then do:
      490         return error "Не указана фактическая дата" .
      491       end.
      492       assign
      493         p-day-end-fact-order = integer(p-fact-date) + 0.99
      494       .
      495     end.
      496   end procedure.
      497   procedure factord-to-date :
      498     define input  parameter p-fact-order as decimal no-undo .
      499     define output parameter p-fact-date  as date    no-undo .
      500     define variable v-ref-date  as date      no-undo .
      501     define variable v-ref-delta as integer   no-undo .
      502     do
      503     on error undo, return error return-value
      504     :
      505       if p-fact-order = ?
      506       or p-fact-order = 0
      507       then do:
      508         return error "Не указан fact-order" .
      509       end.
      510       assign
      511         v-ref-date  = date(1, 1, 2000)
      512       .
      513       assign
      514         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      515       .
      516       assign
      517         p-fact-date = v-ref-date + v-ref-delta
      518       .
      519     end.
      520   end procedure.
      521   procedure factord-to-fact-num :
      522     define input  parameter p-fact-order as decimal no-undo .
      523     define output parameter p-fact-num   as integer no-undo .
      524     define variable v-fact-order-trunc as decimal no-undo .
      525     do
      526     on error undo, return error return-value
      527     :
      528       if p-fact-order = ?
      529       or p-fact-order = 0
      530       then do:
      531         return error "Не указан fact-order" .
      532       end.
      533       assign
      534        v-fact-order-trunc = truncate(p-fact-order, 2)
      535       .
      536       assign
      537         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      538       .
      539     end.
      540   end procedure.
      541   procedure factord-to-shift-num :
      542     define input  parameter p-fact-order as decimal no-undo .
      543     define output parameter p-shift-num   as integer no-undo .
      544     define variable  p-shift-numd  as decimal   no-undo .
      545     define variable v-fact-order-trunc as decimal no-undo .
      546     do
      547     on error undo, return error return-value
      548     :
      549       if p-fact-order = ?
      550       or p-fact-order = 0
      551       then do:
      552         return error "Не указан fact-order" .
      553       end.
      554       assign
      555        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      556       .
      557       if v-fact-order-trunc < 0.5 then do:
      558         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      559       end.
      560       assign
      561         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      562         .
      563        assign
      564         p-shift-num = truncate (p-shift-numd , 0)
      565       .
      566     end.
      567   end procedure.
      568   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      569   define variable v-waitfram-action01         as character   no-undo .
      570   define variable v-waitfram-action02         as character   no-undo .
      571   define variable v-waitfram-action03         as character   no-undo .
      572   define variable mWaitFramTextBeg            as character   no-undo.
      573   define variable mWaitFramTextEnd            as character   no-undo.
      574   define variable mWaitFramView               as logical     no-undo.
      575   define variable mWaitProcEvent              as logical     no-undo init yes.
      576   define variable mWaitFramInterval           as integer     no-undo init 1 .
      577   define variable mWaitFramStop               as logical     no-undo.
      578   define variable mWaitFramStopUser           as logical     no-undo.
      579   define variable mWaitFramStopTimeOut        as logical     no-undo.
      580   define variable mWaitFramStartProc          as datetime-tz no-undo.
      581   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      582   define button B-WaitFramStop auto-end-key
      583        label "Стоп"
      584        size 10 by 1 tooltip "Остоновить процесс".
      585   define button B-viewProcInfo
      586        label "Информация"
      587        size 15 by 1 tooltip "Информация о процесс".
      588   define frame waitfram
      589     v-waitfram-action01 format "x(72)" no-label skip
      590     v-waitfram-action02 format "x(72)" no-label skip
      591     v-waitfram-action03 format "x(72)" no-label skip
      592     B-viewProcInfo
      593     B-WaitFramStop at row 4 col 30
      594     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      595     .
      596   define new global shared variable mBatchMode as logical no-undo init ?.
      597   define variable mFramBachModHandle as handle no-undo.
      598   mFramBachModHandle = frame waitfram:handle.
      599   define variable mFameOldVis as logical no-undo.
      600   define variable mVisCUrentVin as logical no-undo.
      601   if session:batch-mode
      602   then
      603      mBatchMode = yes.
      604   if mBatchMode = ? then do:
      605     mVisCUrentVin = current-window:visible.
      606     mFameOldVis = mFramBachModHandle:visible.
      607     mFramBachModHandle:visible  = yes.
      608     mBatchMode = mFramBachModHandle:visible ne yes.
      609     mFramBachModHandle:visible = mFameOldVis.
      610     current-window:visible = mVisCUrentVin.
      611   end.
      612    if  log-manager:logfile-name ne ?
      613     then DO:
      614         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      615         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      616         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      617     end.
      618   on choose of B-WaitFramStop in frame waitfram
      619   do:
      620     mWaitFramStop = yes.
      621     mWaitFramStopUser = yes.
      622   end.
      623   function waitfram-check-timeout returns logical():
      624      define variable vtime as int64 no-undo.
      625      if mWaitFramStopTimeOut
      626      then
      627         return yes.
      628      vtime = ( now - mWaitFramStartProc ) / 1000 .
      629      if     mWaitFramTimeOut ne ?
      630         and mWaitFramTimeOut ne 0
      631         and mWaitFramTimeOut lt vtime
      632      then do:
      633         mWaitFramStopTimeOut = yes.
      634      end.
      635      return mWaitFramStopTimeOut.
      636   end.
      637   procedure waitfram-hide :
      638     if not session:batch-mode
      639     then do
      640     on error undo, return error return-value
      641     :
      642       pause 0 before-hide .
      643       if not mBatchMode then
      644         hide frame waitfram .
      645     if     not mWaitFramView
      646        and mWaitProcEvent
      647     then
      648       process events .
      649     end.
      650   end procedure.
      651   procedure waitfram-show :
      652     define input  parameter p-message as character no-undo .
      653     define variable v-left-margin as integer   no-undo .
      654     if not session:batch-mode
      655     then do
      656     on error undo, return error return-value
      657     :
      658       if length(p-message) <= 70 then do:
      659         assign
      660           v-left-margin = integer((70 - length(p-message)) / 2)
      661         .
      662         assign
      663           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      664         .
      665         assign
      666           v-waitfram-action01 = " "
      667           v-waitfram-action02 = " "
      668                                    + fill(" ", v-left-margin)
      669                                    + p-message
      670           v-waitfram-action03 = " "
      671         .
      672       end.
      673       else do:
      674         define variable vRindex1 as integer no-undo.
      675         define variable vRindex2 as integer no-undo.
      676         vRindex1 = r-index(p-message," ",70).
      677         if vRindex1 = 0
      678         then
      679            vRindex1 = 70.
      680         if length(p-message)  <= vRindex1 + 70 then do:
      681           assign
      682             v-waitfram-action01 = " "
      683             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      684             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      685           .
      686         end.
      687         else do:
      688           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      689           if vRindex2 <= vRindex1
      690           then
      691              vRindex2 = vRindex1 + 70.
      692           assign
      693             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      694             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      695             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      696           .
      697         end.
      698       end.
      699       B-viewProcInfo:visible   in frame waitfram = no.
      700       B-viewProcInfo:sensitive in frame waitfram = no.
      701       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      702       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      703       if  (   mWaitFramView
      704          or  mWaitProcEvent)
      705          and not mBatchMode
      706       then
      707          display
      708             v-waitfram-action01 skip
      709             v-waitfram-action02 skip
      710             v-waitfram-action03 skip
      711          with frame waitfram .
      712       if     mWaitFramView
      713          then do:
      714             if     mWaitFramInterval ne ?
      715                and not mBatchMode
      716             then
      717                wait-for go of frame waitfram pause mWaitFramInterval.
      718          end.
      719          else
      720             if     mWaitProcEvent
      721                and not mBatchMode
      722             then
      723                process events .
      724     end.
      725   end procedure.
      726      procedure waitfram-show-this:
      727         define input  parameter iInterval as int64 no-undo.
      728         define variable vtime as int64 no-undo.
      729         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      730         mWaitFramInterval = iInterval.
      731         run waitfram-show (substitute("&1&2 &3&4" ,
      732                                       mWaitFramTextBeg ,
      733                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      734                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      735                                       mWaitFramTextEnd
      736                                      )
      737                           ).
      738      end.
      739      procedure WaitFramRunPause:
      740         define input  parameter iInterval as dec no-undo.
      741         define variable vStart  as datetime-tz no-undo.
      742         define variable vend    as datetime-tz no-undo.
      743         define variable vint as int64 no-undo.
      744         define variable vOk as logical no-undo.
      745         vStart = now.
      746         vend   = vStart.
      747         publish "WaitFramPause" (iInterval,output vOk).
      748         vend   =  now.
      749         vint = vend - vStart.
      750         vint = iInterval - vint / 1000.
      751         if     not mWaitFramStop
      752            and (   vint > 0
      753                 or (    not vOk
      754                     and iInterval eq ?
      755                     )
      756                 )
      757         then
      758            run waitfram-show-this (iInterval).
      759         vend   =  now.
      760         vint = vend - vStart.
      761         vint = iInterval - vint / 1000.
      762         if     not mWaitFramStop
      763            and vint > 0
      764         then do:
      765            run gbl/pause.p (vint * 1000).
      766         end.
      767         if iInterval ne ?
      768         then
      769            publish "WaitFramStop".
      770         waitfram-check-timeout().
      771      end.
      772      procedure WaitFramWaitFor:
      773         define input  parameter iInterval as dec no-undo.
      774         assign
      775            mWaitFramStartProc   = now
      776            mWaitFramStopUser    = no
      777            mWaitFramStopTimeOut = no
      778         .
      779         block-wait:
      780         do while not mWaitFramStop:
      781            run WaitFramRunPause (iInterval).
      782            if  waitfram-check-timeout()
      783            then do:
      784               leave block-wait.
      785            end.
      786         end.
      787         run waitfram-hide.
      788      end.
      789   procedure waitfram-join :
      790     define input  parameter p-line-1  as character no-undo .
      791     define input  parameter p-line-2  as character no-undo .
      792     define input  parameter p-line-3  as character no-undo .
      793     define output parameter p-message as character no-undo .
      794     do
      795     on error undo, return error return-value
      796     :
      797       assign
      798         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      799                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      800                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      801       .
      802     end.
      803   end procedure.
      804   function waitfram-join-function returns character
      805     (input p-line-1 as character
      806     ,input p-line-2 as character
      807     ,input p-line-3 as character
      808     ).
      809     define variable v-message as character no-undo .
      810     run waitfram-join in this-procedure
      811       (input  p-line-1
      812       ,input  p-line-2
      813       ,input  p-line-3
      814       ,output v-message
      815       ) .
      816     return v-message .
      817   end function .
      818   run waitfram-show ("Ранжирование товаров...").
      819   define variable v-all-sum    as decimal   no-undo .
      820   define variable v-all-period as integer   no-undo .
      821   v-all-sum    = 0 .
      822   v-all-period = 0 .
      823   for each x-analysis-period :
      824      v-all-period = v-all-period + 1.
      825   end.
      826   for each  temp-oborot USE-INDEX PI :
      827       v-all-sum = v-all-sum + temp-oborot.sum-crit .
      828       find first temp-goods where temp-goods.gds-code = temp-oborot.gds-code no-error .
      829       if not available temp-goods then DO:
      830          create temp-goods.
      831           assign
      832             temp-goods.gds-code          = temp-oborot.gds-code
      833             temp-goods.sum-crit          =  temp-oborot.sum-crit
      834             temp-goods.qnty              =  temp-oborot.qnty
      835             temp-goods.reserve-day       =  temp-oborot.reserve-day
      836             temp-goods.stock-qnty        =  temp-oborot.stock-qnty
      837             temp-goods.stock-price-acc   =  temp-oborot.price-cost
      838             temp-goods.stock-price-sale  =  temp-oborot.stock-qnty * temp-oborot.price-crc
      839             temp-goods.sum-acc           =  temp-oborot.sum-acc
      840             temp-goods.sum-cur           =  temp-oborot.sum-cur
      841             temp-goods.sum-doc           =  temp-oborot.sum-doc
      842             temp-goods.vat-acc           =  temp-oborot.vat-acc
      843             temp-goods.vat-cur           =  temp-oborot.vat-cur
      844             temp-goods.vat-doc           =  temp-oborot.vat-doc
      845             temp-goods.transport-acc     =  temp-oborot.transport-acc
      846             temp-goods.transport-cur     =  temp-oborot.transport-cur
      847             temp-goods.transport-doc     =  temp-oborot.transport-doc
      848             temp-goods.other-acc         =  temp-oborot.other-acc
      849             temp-goods.other-cur         =  temp-oborot.other-cur
      850             temp-goods.other-doc         =  temp-oborot.other-doc
      851             temp-goods.road-tax-acc      =  temp-oborot.road-tax-acc
      852             temp-goods.road-tax-cur      =  temp-oborot.road-tax-cur
      853             temp-goods.road-tax-doc      =  temp-oborot.road-tax-doc
      854             temp-goods.slt-acc           =  temp-oborot.slt-acc
      855             temp-goods.slt-cur           =  temp-oborot.slt-cur
      856             temp-goods.slt-doc           =  temp-oborot.slt-doc
      857             temp-goods.order-qnty        =  temp-oborot.order-qnty
      858         .
      859       END.
      860       ELSE
      861        assign
      862         temp-goods.gds-code          = temp-oborot.gds-code
      863         temp-goods.sum-crit          = temp-goods.sum-crit       + temp-oborot.sum-crit
      864         temp-goods.qnty              = temp-goods.qnty           + temp-oborot.qnty
      865         temp-goods.reserve-day       = temp-goods.reserve-day    + temp-oborot.reserve-day
      866         temp-goods.stock-qnty        = temp-goods.stock-qnty     + temp-oborot.stock-qnty
      867         temp-goods.stock-price-acc   = temp-goods.stock-price-acc  + ( temp-oborot.price-cost )
      868         temp-goods.stock-price-sale  = temp-goods.stock-price-sale + ( temp-oborot.stock-qnty * temp-oborot.price-crc )
      869         temp-goods.sum-acc           = temp-goods.sum-acc        + temp-oborot.sum-acc
      870         temp-goods.sum-cur           = temp-goods.sum-cur        + temp-oborot.sum-cur
      871         temp-goods.sum-doc           = temp-goods.sum-doc        + temp-oborot.sum-doc
      872         temp-goods.vat-acc           = temp-goods.vat-acc        + temp-oborot.vat-acc
      873         temp-goods.vat-cur           = temp-goods.vat-cur        + temp-oborot.vat-cur
      874         temp-goods.vat-doc           = temp-goods.vat-doc        + temp-oborot.vat-doc
      875         temp-goods.transport-acc     = temp-goods.transport-acc  + temp-oborot.transport-acc
      876         temp-goods.transport-cur     = temp-goods.transport-cur  + temp-oborot.transport-cur
      877         temp-goods.transport-doc     = temp-goods.transport-doc  + temp-oborot.transport-doc
      878         temp-goods.other-acc         = temp-goods.other-acc      + temp-oborot.other-acc
      879         temp-goods.other-cur         = temp-goods.other-cur      + temp-oborot.other-cur
      880         temp-goods.other-doc         = temp-goods.other-doc      + temp-oborot.other-doc
      881         temp-goods.road-tax-acc      = temp-goods.road-tax-acc   + temp-oborot.road-tax-acc
      882         temp-goods.road-tax-cur      = temp-goods.road-tax-cur   + temp-oborot.road-tax-cur
      883         temp-goods.road-tax-doc      = temp-goods.road-tax-doc   + temp-oborot.road-tax-doc
      884         temp-goods.slt-acc           = temp-goods.slt-acc        + temp-oborot.slt-acc
      885         temp-goods.slt-cur           = temp-goods.slt-cur        + temp-oborot.slt-cur
      886         temp-goods.slt-doc           = temp-goods.slt-doc        + temp-oborot.slt-doc
      887         temp-goods.order-qnty        = temp-goods.order-qnty     + temp-oborot.order-qnty
      888       .
      889   end.
      890   define variable v-kol-period as integer   no-undo .
      891   define variable v-sig as decimal   no-undo .
      892         for each  temp-goods :
      893           v-kol-period = 0 .
      894           v-sig = 0 .
      895           for each temp-xyz where
      896                 temp-xyz.gds-code = temp-goods.gds-code
      897                 :
      898                 v-kol-period = v-kol-period + 1 .
      899           end.
      900           temp-goods.kol-period   = v-kol-period .
      901           temp-goods.average-qnty = if v-kol-period = 0 then 0 else temp-goods.sum-crit / v-kol-period.
      902           for each temp-xyz where
      903                 temp-xyz.gds-code = temp-goods.gds-code
      904                 :
      905                 v-sig = v-sig + exp ((temp-xyz.sum-crit-p - temp-goods.average-qnty) , 2 ) .
      906           end.
      907             temp-goods.sigma   = v-sig / v-all-period .
      908             temp-goods.K_V     = if temp-goods.average-qnty = 0 then 0 else (exp ( temp-goods.sigma , 0.5 ) / temp-goods.average-qnty).
      909             temp-goods.crit-pr = temp-goods.K_V * 100 .
      910         end.
      911   find first x-analysis no-error .
      912   if error-status :error then
      913     message vss-workfile vss-revision vss-description skip
      914     error-status :get-message(1) view-as alert-box error .
      915   define variable v-A as decimal   no-undo .
      916   define variable v-B as decimal   no-undo .
      917   define variable first-A as logical   no-undo .
      918   define variable first-B as logical   no-undo .
      919   assign
      920   v-A = x-analysis.XYZ-x
      921   v-B = x-analysis.XYZ-z
      922   .
      923   define variable v-nak as decimal   no-undo .
      924   v-nak = 0.
      925   for each temp-goods  where
      926       temp-goods.sum-crit > 0
      927       break by temp-goods.crit-pr :
      928       v-nak = temp-goods.crit-pr .
      929       if v-nak < v-A   then do:
      930          temp-goods.crit = "X" .
      931       end.
      932       if v-nak >= v-A  and v-nak <= v-B then do:
      933             assign
      934               temp-goods.crit = "Y"
      935             .
      936       end.
      937       if v-nak > v-B  then do:
      938               assign
      939                 temp-goods.crit = "Z"
      940               .
      941       end.
      942   end.
      943   run waitfram-hide.
