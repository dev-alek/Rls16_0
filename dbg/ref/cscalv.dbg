      532               when 'tare-weight':U then do:     assign     p-hist = yes.   end.
      533         otherwise do:
      534           p-hist = no.
      535         end.
      536       end.
      537     end.
      538   end procedure.
      539   define variable v-chg-fields as character no-undo.
      540   define variable v-old-fields as character no-undo.
      541   define variable v-new-fields as character no-undo.
      542   define variable ii as integer no-undo.
      543   define variable v-mess as character no-undo .
      544   define buffer buf_c-scales for ub.c-scales.
      545   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      546   define SHARED temp-table temp-changes no-undo
      547   field f_name as character
      548   field l_name as character
      549   field v_old as character
      550   field v_new as character
      551   field t_name as character
      552   field num_ as integer
      553   field uniq-key-rec as character
      554   field action as integer
      555   field fNotChange as logical
      556   index pi is unique primary
      557   num_
      558   t_name
      559   f_name
      560   index
      561   Chan
      562   fnotChange
      563   t_name
      564   f_name
      565   index imain uniq-key-rec
      566   .
      567   FUNCTION get-all-fields returns character (p-file-name as character ):
      568   define variable v-dop as character no-undo .
      569     find first _file no-lock where _file._file-name = p-file-name no-error .
      570     if not available _file then return "":U.
      571     for each _field no-lock where
      572              _field._file-recid = recid(_file) :
      573       assign
      574       v-dop = v-dop + _field._field-name + chr(44)
      575       .
      576     end.
      577     return trim(v-dop).
      578   END FUNCTION.
      579   PROCEDURE proc-full-temp-changes :
      580     define input  parameter p-act-create as logical   no-undo .
      581     define input  parameter p-act-delete as logical   no-undo .
      582     define input  parameter p-hst-handle as handle    no-undo .
      583     define input  parameter p-main-table as character no-undo .
      584     define input  parameter p-field-list as character no-undo .
      585     define input  parameter p-label-form as character no-undo .
      586     define variable h-new-buf         as handle    no-undo .
      587     define variable h-main-buf        as handle    no-undo .
      588     define variable h-for-comp        as handle    no-undo .
      589     define variable v-inform          as character no-undo .
      590     define variable v-ind             as integer   no-undo .
      591     define variable v-idx-field-qnty  as integer   no-undo .
      592     define variable v-num-entries     as integer   no-undo .
      593     define variable fh                as handle    no-undo .
      594     define variable fh-main           as handle    no-undo .
      595     define variable fh-old            as handle    no-undo .
      596     define variable fh-new            as handle    no-undo .
      597     define variable v-field-name      as character no-undo .
      598     define variable v-field-lvl       as character no-undo .
      599     define variable v-field-form      as character no-undo .
      600     define variable v-search-exp      as character no-undo .
      601     define variable v-srch-main       as character no-undo .
      602     define variable v-word-link       as character no-undo .
      603     define variable v-av-chip-num     as logical   no-undo .
      604     define variable v-main-pi-fld-lst as character no-undo .
      605     define variable v-main-fld-lst    as character no-undo .
      606     define variable v-delim-list      as character no-undo .
      607     define variable v-label           as character no-undo .
      608     define variable v-old-value       as character no-undo case-sensitive.
      609     define variable v-new-value       as character no-undo case-sensitive.
      610     define variable v-chg-fields as character no-undo.
      611     for each temp-changes:
      612       delete temp-changes.
      613     end.
      614     if not p-hst-handle:available then do:
      615       return .
      616     end.
      617     create buffer h-new-buf  for table p-hst-handle .
      618     create buffer h-main-buf for table p-main-table .
      619     assign
      620       v-inform = h-main-buf:index-information(1)
      621       v-ind    = 2
      622     .
      623     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      624     on error undo, return error
      625     :
      626       assign
      627         v-inform = h-main-buf:index-information( v-ind )
      628         v-ind    = v-ind + 1
      629       .
      630     end.
      631     if v-inform = ?
      632       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      633       or entry( 3, v-inform, ",":U ) <> "1":U
      634     then do:
      635       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      636     end.
      637     assign
      638       v-idx-field-qnty = num-entries( v-inform ) - 4
      639     .
      640     if v-idx-field-qnty < 2 then do:
      641       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      642     end.
      643     assign
      644       v-srch-main   = "where":U
      645       v-word-link   = "":U
      646       v-av-chip-num = false
      647       v-delim-list  = "":U
      648     .
      649     do v-ind = 1 to v-idx-field-qnty by 2
      650     on error undo, return error
      651     :
      652       assign
      653         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      654         fh                = p-hst-handle:buffer-field( v-field-name )
      655         fh-main           = h-main-buf:buffer-field( v-field-name )
      656         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      657         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      658       .
      659       if fh:data-type ="character":U then do:
      660         assign
      661           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      662         .
      663       end.
      664       else do:
      665         assign
      666           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      667         .
      668       end.
      669       if v-delim-list = "":U then do:
      670         assign
      671           v-delim-list = ",":U
      672         .
      673       end.
      674       if v-word-link = "":U then do:
      675         assign
      676           v-word-link = "and":U
      677         .
      678       end.
      679     end.
      680     assign
      681       v-delim-list  = "":U
      682     .
      683     do v-ind = 1 to h-main-buf:num-fields
      684     on error undo, return error
      685     :
      686       assign
      687         fh-main      = h-main-buf:buffer-field( v-ind )
      688         v-field-name = fh-main:name
      689       .
      690         assign
      691           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      692         .
      693         if v-delim-list = "":U then do:
      694           assign
      695             v-delim-list = ",":U
      696           .
      697         end.
      698     end.
      699     assign
      700       v-inform = p-hst-handle:index-information(1)
      701       v-ind    = 2
      702     .
      703     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      704     on error undo, return error
      705     :
      706       assign
      707         v-inform = p-hst-handle:index-information( v-ind )
      708         v-ind    = v-ind + 1
      709       .
      710     end.
      711     if v-inform = ?
      712       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      713       or entry( 3, v-inform, ",":U ) <> "1":U
      714     then do:
      715       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      716     end.
      717     assign
      718       v-idx-field-qnty = num-entries( v-inform ) - 4
      719     .
      720     if v-idx-field-qnty < 2 then do:
      721       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      722     end.
      723     assign
      724       v-search-exp  = "where":U
      725       v-word-link   = "":U
      726       v-av-chip-num = false
      727     .
      728     do v-ind = 1 to v-idx-field-qnty by 2
      729     on error undo, return error
      730     :
      731       assign
      732         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      733         fh           = p-hst-handle:buffer-field( v-field-name )
      734         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      735       .
      736       if v-field-name = "chip-num":U then do:
      737         assign
      738           v-search-exp  = substitute( "&1 >", v-search-exp )
      739           v-av-chip-num = true
      740         .
      741       end.
      742       else do:
      743         assign
      744           v-search-exp = substitute( "&1 =", v-search-exp )
      745         .
      746       end.
      747       if fh:data-type ="character":U then do:
      748         assign
      749           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      750         .
      751       end.
      752       else do:
      753         assign
      754           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      755         .
      756       end.
      757       if v-word-link = "":U then do:
      758         assign
      759           v-word-link = "and":U
      760         .
      761       end.
      762     end.
      763     if v-av-chip-num = false then do:
      764       message
      765         vss-workfile vss-revision vss-description skip
      766         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      767         "Использование данной процедуры невозможно!" skip
      768         view-as alert-box error .
      769       return error .
      770     end.
      771     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      772     if not h-new-buf:available then do:
      773       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      774       if not h-main-buf:available then do:
      775         assign
      776           h-for-comp = ?
      777         .
      778       end.
      779       else do:
      780         assign
      781           h-for-comp = h-main-buf
      782         .
      783       end.
      784     end.
      785     else do:
      786       assign
      787         h-for-comp = h-new-buf
      788       .
      789     end.
      790     assign
      791       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      792     .
      793     do v-ind = 1 to v-num-entries
      794     on error undo, return error return-value
      795     :
      796       assign
      797         v-field-name = entry( v-ind, v-main-fld-lst )
      798         fh-old       = p-hst-handle:buffer-field( v-field-name )
      799         v-old-value  = fh-old:buffer-value()
      800         v-label      = trim( fh-old:label )
      801       .
      802       if ( trim( p-field-list ) <> "":U
      803            and lookup( v-field-name, p-field-list ) > 0
      804          )
      805          or trim( p-field-list ) = "":U
      806       then do:
      807         if h-for-comp <> ? then do:
      808           assign
      809             fh-new      = h-for-comp:buffer-field( v-field-name )
      810             v-new-value = fh-new:buffer-value()
      811           .
      812         end.
      813         else do:
      814           assign
      815             v-new-value = "":U
      816           .
      817         end.
      818           if p-act-create = true then do:
      819             assign
      820               v-old-value = "":U
      821             .
      822           end.
      823           if p-act-delete = true then do:
      824             assign
      825               v-new-value = "":U
      826             .
      827           end.
      828         if v-old-value <> v-new-value
      829         then do:
      830           create temp-changes.
      831           assign
      832             temp-changes.t_name = p-main-table
      833             temp-changes.f_name = v-field-name
      834             temp-changes.l_name = replace( v-label, "&":U, "":U )
      835             temp-changes.v_old  = trim( v-old-value )
      836             temp-changes.v_new  = trim( v-new-value )
      837             temp-changes.num_   = 0
      838             temp-changes.fNotChange = v-old-value eq v-new-value
      839           .
      840         end.
      841       end.
      842     end.
      843     assign
      844       v-num-entries = num-entries( p-label-form, chr(8) )
      845     .
      846     do v-ind = 1 to v-num-entries
      847     on error undo, return error return-value
      848     :
      849       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      850         assign
      851           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      852           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      853           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      854         .
      855         find first temp-changes
      856           where temp-changes.f_name = v-field-name
      857           no-error .
      858         if available temp-changes then do:
      859           if trim( v-field-lvl ) <> "":U then do:
      860             assign
      861               temp-changes.l_name = v-field-lvl
      862             .
      863           end.
      864           if trim( v-field-form ) <> "":U then do:
      865             assign
      866               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      867             .
      868             if h-for-comp <> ? then do:
      869               assign
      870                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      871               .
      872             end.
      873           end.
      874         end.
      875       end.
      876       else do:
      877         message
      878           vss-workfile vss-revision vss-description skip
      879           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      880           substitute( "список для поля '&1': '&2'"
      881                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      882                       ,entry( v-ind, p-label-form, chr(8) )
      883                     ) skip
      884           substitute( "полный список: &2", p-label-form ) skip
      885           view-as alert-box error .
      886       end.
      887     end.
      888     delete object h-new-buf .
      889     delete object h-main-buf .
      890   END PROCEDURE.
      891   if p-action = integer('99':U) then return.
      892   find first buf_c-scales no-lock where
      893             buf_c-scales.db-num   = p-db-num
      894         AND buf_c-scales.scales-num = p-scales-num
      895         AND buf_c-scales.chip-num = p-chip-num
      896         AND buf_c-scales.corr-user-db-num = p-corr-user-db-num   no-error .
      897   if not available buf_c-scales then do:
      898     return error .
      899   end.
      900   CASE p-subject:
      901     when 'scales':U or when "":U then do:
      902       run scales-proc in this-procedure(output p-description) no-error .
      903     end.
      904     when 'scales-attr':U then do:
      905       run scales-attr-proc in this-procedure(output p-description) no-error .
      906     end.
      907     when 'scales-grp':U then do:
      908       run scales-grp-proc in this-procedure(output p-description) no-error .
      909     end.
      910     when 'scales-gds':U then do:
      911       run scales-gds-proc in this-procedure(output p-description) no-error .
      912     end.
      913   END CASE.
      914   if error-status:error then do:
      915     return error .
      916   end.
      917   procedure scales-proc :
      918   define output parameter p-description as character no-undo .
      919   define buffer current_c-scales for ub.c-scales  .
      920     do
      921     on error undo, return error
      922     :
      923       find first current_c-scales no-lock where
      924                  current_c-scales.db-num   = p-db-num
      925              AND current_c-scales.scales-num = p-scales-num
      926              AND current_c-scales.corr-user-db-num = p-corr-user-db-num
      927              AND current_c-scales.chip-num = p-chip-num
      928              no-error .
      929       if not avail current_c-scales then do:
      930          v-mess = "Неверная ссылка на c-scales в таблице c-scales".
      931          run err-mess in this-procedure ( input-output v-mess ).
      932          return error (if p-silent then v-mess else '':U).
      933       end.
      934   define variable v-label-param as character no-undo .
      935   v-label-param =
      936     "address" + chr(4) + "Адрес" + chr(4) + "" + chr(8)
      937    + "master" + chr(4) + "Главные весы" + chr(4) + "" + chr(8)
      938    + "max-gds" + chr(4) + "Максимальная номенклатура" + chr(4) + "" + chr(8)
      939    + "max-plu" + chr(4) + "Макс. PLU в тек.момент" + chr(4) + "" + chr(8)
      940    + "unit-base" + chr(4) + "Ед.изм" + chr(4) + "" + chr(8)
      941    + "scales-type" + chr(4) + "Тип" + chr(4) + "" + chr(8)
      942    + "scales-name" + chr(4) + "Название" + chr(4) + "" + chr(8)
      943    + "scales-num" + chr(4) + "Номер весов" + chr(4) + "" + chr(8)
      944    + "db-num" + chr(4) + "БД" + chr(4) + "" + chr(8)
      945    + "remote" + chr(4) + "Удаленные" + chr(4) + "" + chr(8)
      946    + "to-send" + chr(4) + "Требуют обновления" + chr(4) + "" + chr(8)
      947    + "tot-gds" + chr(4) + "Кол-во PLU" + chr(4) + ""
      948      .
      949    run proc-full-temp-changes in this-procedure (
      950                                                input  (buf_c-scales.action = integer('1':U))
      951                                               ,input  (buf_c-scales.action = integer('99':U))
      952                                               ,input  buffer current_c-scales:handle
      953                                               ,input  'scales':U
      954                                               ,input  "address,master,max-gds,unit-base,scales-type,scales-name,scales-num,db-num,remote,to-send,tot-gds"
      955                                               ,input  v-label-param).
      956   end.
      957   end procedure.
      958   procedure scales-attr-proc :
      959   define output parameter p-description as character no-undo .
      960   define variable v-tooltip as character no-undo .
      961   define variable v-label as character no-undo .
      962   define buffer current_c-scales-attr for ub.c-scales-attr  .
      963     do
      964     on error undo, return error
      965     :
      966       find first current_c-scales-attr no-lock where
      967                  current_c-scales-attr.db-num   = p-db-num
      968              AND current_c-scales-attr.scales-num = p-scales-num
      969              AND current_c-scales-attr.corr-user-db-num = p-corr-user-db-num
      970              AND current_c-scales-attr.chip-num = p-chip-num
      971              AND current_c-scales-attr.attr-code  = buf_c-scales.attr-code
      972              no-error .
      973       if not avail current_c-scales-attr then do:
      974          v-mess = "Неверная ссылка на c-scales-attr в таблице c-scales".
      975          run err-mess in this-procedure ( input-output v-mess ).
      976          return error (if p-silent then v-mess else '':U).
      977       end.
      978       run scl-attr-tooltip in this-procedure (
      979                   input  current_c-scales-attr.attr-code
      980                   ,output v-tooltip
      981                   ,output v-label
      982                   ) no-error .
      983       assign
      984       p-description = "Атрибут" + chr(32) + v-label
      985       .
      986   define variable v-label-param as character no-undo .
      987   v-label-param =
      988     "attr-value" + chr(4) + "Значение атрибута" + chr(4) + "" + chr(8)
      989    + "scales-num" + chr(4) + "Номер весов" + chr(4) + "" + chr(8)
      990    + "db-num" + chr(4) + "БД" + chr(4) + ""  .
      991    run proc-full-temp-changes in this-procedure (
      992                                                input  (buf_c-scales.action = integer('1':U))
      993                                               ,input  (buf_c-scales.action = integer('99':U))
      994                                               ,input  buffer current_c-scales-attr:handle
      995                                               ,input  'scales-attr':U
      996                                               ,input  "attr-value,scales-num,db-num"
      997                                               ,input  v-label-param).
      998   end.
      999   end procedure.
     1000   procedure scales-grp-proc :
     1001   define output parameter p-description as character no-undo .
     1002   define buffer current_c-scales-grp for ub.c-scales-grp  .
     1003     do
     1004     on error undo, return error
     1005     :
     1006       find first current_c-scales-grp no-lock where
     1007                  current_c-scales-grp.db-num   = p-db-num
     1008              AND current_c-scales-grp.scales-num = p-scales-num
     1009              AND current_c-scales-grp.corr-user-db-num = p-corr-user-db-num
     1010              AND current_c-scales-grp.chip-num = p-chip-num
     1011              AND current_c-scales-grp.node-code  = buf_c-scales.node-code
     1012              no-error .
     1013       if not avail current_c-scales-grp then do:
     1014          v-mess = "Неверная ссылка на c-scales-grp в таблице c-scales".
     1015          run err-mess in this-procedure ( input-output v-mess ).
     1016          return error (if p-silent then v-mess else '':U).
     1017       end.
     1018   define variable v-label-param as character no-undo .
     1019   v-label-param =
     1020     "node-code" + chr(4) + "Код группы" + chr(4) + "" + chr(8)
     1021    + "scales-num" + chr(4) + "Номер весов" + chr(4) + "" + chr(8)
     1022    + "db-num" + chr(4) + "БД" + chr(4) + ""  .
     1023    run proc-full-temp-changes in this-procedure (
     1024                                                input  (buf_c-scales.action = integer('1':U))
     1025                                               ,input  (buf_c-scales.action = integer('99':U))
     1026                                               ,input  buffer current_c-scales-grp:handle
     1027                                               ,input  'scales-grp':U
     1028                                               ,input  "node-code,scales-num,db-num"
     1029                                               ,input  v-label-param).
     1030   end.
     1031   end procedure.
     1032   procedure scales-gds-proc :
     1033   define output parameter p-description as character no-undo .
     1034   define variable v-tooltip as character no-undo .
     1035   define variable v-label as character no-undo .
     1036   define variable v-is-created as logical no-undo .
     1037   define variable v-is-deleted as logical no-undo .
     1038   define variable v-field-name as character no-undo .
     1039   define variable v-field-function as character no-undo .
     1040   define variable jj as integer no-undo .
     1041   define variable v-field-label  as character no-undo .
     1042   define variable v-field-list as character no-undo .
     1043   define buffer current_scales-gds for ub.scales-gds  .
     1044   define buffer current_c-scales-gds for ub.c-scales-gds  .
     1045   define buffer new_c-scales-gds for ub.c-scales-gds  .
     1046     do
     1047     on error undo, return error
     1048     :
     1049       find first current_c-scales-gds no-lock where
     1050                  current_c-scales-gds.db-num   = p-db-num
     1051              AND current_c-scales-gds.scales-num = p-scales-num
     1052              AND current_c-scales-gds.corr-user-db-num = p-corr-user-db-num
     1053              AND current_c-scales-gds.chip-num = p-chip-num
     1054              AND current_c-scales-gds.PLU-code  = buf_c-scales.PLU-code
     1055              no-error .
     1056       if not avail current_c-scales-gds then do:
     1057          v-mess = "Неверная ссылка на c-scales-gds в таблице c-scales".
     1058          run err-mess in this-procedure ( input-output v-mess ).
     1059          return error (if p-silent then v-mess else '':U).
     1060       end.
     1061   define variable v-label-param as character no-undo .
     1062   v-label-param =
     1063     "b-code" + chr(4) + "Бар-код" + chr(4) + "" + chr(8)
     1064    + "db-num" + chr(4) + "Номер БД" + chr(4) + "" + chr(8)
     1065    + "deadline" + chr(4) + "Срок хранения" + chr(4) + "" + chr(8)
     1066    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
     1067    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
     1068    + "PLU-code" + chr(4) + "Код PLU" + chr(4) + "" + chr(8)
     1069    + "scales-num" + chr(4) + "Номер весов" + chr(4) + "" + chr(8)
     1070    + "to-del" + chr(4) + "Удаление с весов" + chr(4) + "" + chr(8)
     1071    + "to-send" + chr(4) + "Требует обновления" + chr(4) + "" + chr(8)
     1072    + "wt-cart" + chr(4) + "Вес упаковки" + chr(4) + ""  .
     1073    run proc-full-temp-changes in this-procedure (
     1074                                                input  (buf_c-scales.action = integer('1':U))
     1075                                               ,input  (buf_c-scales.action = integer('99':U))
     1076                                               ,input  buffer current_c-scales-gds:handle
     1077                                               ,input  'scales-gds':U
     1078                                               ,input  "b-code,db-num,deadline,obj-code,obj-type,PLU-code,scales-num,to-del,to-send,wt-cart"
     1079                                               ,input  v-label-param).
     1080   end.
     1081   end procedure.
     1082   PROCEDURE err-mess:
     1083     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
     1084     CASE p-silent:
     1085       when yes then do:
     1086         assign
     1087         p-mess = substitute("История весов  БД&1 весы №2: щепка &3 Предмет изменений &4&5&6"
     1088                           ,p-db-num
     1089                           ,p-scales-num
     1090                           ,p-chip-num
     1091                           ,p-subject
     1092                           ,chr(10)
     1093                           ,p-mess
     1094                           ).
     1095       end.
     1096       otherwise do:
     1097         message
     1098         p-mess
     1099         view-as alert-box error .
     1100       end.
     1101     end.
     1102   END PROCEDURE.
