        1   block-level on error undo, throw.
        2   define input parameter  p-db-num                like  ub.c-scales.db-num             no-undo .
        3   define input parameter  p-scales-num              like  ub.c-scales.scales-num           no-undo .
        4   define input parameter  p-attr-code             like  ub.c-scales.attr-code          no-undo .
        5   define input parameter  p-corr-user-db-num      like  ub.c-scales.corr-user-db-num   no-undo .
        6   define input parameter  p-chip-num              like  ub.c-scales.chip-num           no-undo .
        7   define input parameter  p-subject               like  ub.c-scales.subject            no-undo .
        8   define input parameter p-action   like ub.c-cli-hist.action no-undo .
        9   define input parameter p-silent  as logical no-undo .
       10   define output parameter p-description as character no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: cscalv.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: ref/cscalv.p $":U .
       16   define variable vss-description as character no-undo init "Заполнение временной таблицы для показа изменений по таблицам истории весов".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure cur-time :
       80      define output parameter p-today as date      no-undo .
       81      define output parameter p-time  as integer   no-undo .
       82     do
       83     on error undo, return error
       84     :
       85       define variable v-date1 as date      no-undo .
       86       define variable v-date2 as date      no-undo .
       87       define variable v-time  as integer   no-undo .
       88       assign
       89         v-date1 = today
       90         v-time  = time
       91         v-date2 = today
       92       .
       93       if v-date1 <> v-date2
       94       then do:
       95         assign
       96           v-date1 = today
       97           v-time  = v-time
       98         .
       99       end.
      100       assign
      101         p-today = v-date1
      102         p-time  = v-time
      103       .
      104     end.
      105   end.
      106   function cur-time-date returns character
      107   :
      108     return string(today, '99/99/9999':U) .
      109   end.
      110   function cur-time-mjd returns decimal
      111   :
      112     define variable v-date as date      no-undo .
      113     define variable v-time as integer   no-undo .
      114     run cur-time in this-procedure
      115       (output v-date
      116       ,output v-time
      117       ) .
      118     return integer(v-date) - 2400002 + (v-time / 86400) .
      119   end.
      120   function cur-time-get-ending-index returns integer
      121   (input p-number as integer
      122   )
      123   :
      124     if p-number < 0
      125     or p-number = ?
      126     then do:
      127       return 1 .
      128     end.
      129     define variable v-rest as integer   no-undo .
      130     assign
      131       p-number = p-number modulo 100
      132     .
      133     if p-number < 20
      134     then do:
      135       assign
      136         v-rest = p-number
      137       .
      138     end.
      139     else do:
      140       assign
      141         v-rest = p-number modulo 10
      142       .
      143     end.
      144     case v-rest :
      145       when 1
      146       then do:
      147         return 2 .
      148       end.
      149       when 2 or
      150       when 3 or
      151       when 4
      152       then do:
      153         return 3 .
      154       end.
      155       otherwise do:
      156         return 1 .
      157       end.
      158     end case .
      159   end.
      160   procedure cur-time-mjd-to-date :
      161      define input  parameter i-mjd-diff as decimal no-undo.
      162      define output parameter o-Date     as date    no-undo.
      163      define output parameter o-Time     as integer no-undo.
      164      define variable v-day-number as integer   no-undo .
      165      if    i-mjd-diff < 0
      166         or i-mjd-diff = ?
      167      then do:
      168         return "?" .
      169      end.
      170      assign
      171         v-day-number = truncate(i-mjd-diff,0).
      172         o-Date = date(v-day-number + 2400002).
      173         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      174     .
      175   end.
      176   function cur-time-mjd-to-string returns character
      177   (input p-mjd-diff as decimal
      178   )
      179   :
      180     define variable v-day-number as integer   no-undo .
      181     define variable v-seconds    as integer   no-undo .
      182     define variable v-hour       as integer   no-undo .
      183     define variable v-min        as integer   no-undo .
      184     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      185     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      186     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      187     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      188     if p-mjd-diff < 0
      189     or p-mjd-diff = ?
      190     then do:
      191       return "?" .
      192     end.
      193     assign
      194       v-day-number = integer(truncate(p-mjd-diff,0))
      195       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      196     .
      197     if v-seconds > 86400
      198     then do:
      199       assign
      200         v-seconds = 86400 - 1
      201       .
      202     end.
      203     if v-seconds < 0
      204     then do:
      205       assign
      206         v-seconds = 0
      207       .
      208     end.
      209     assign
      210       v-hour = truncate(v-seconds / 3600, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 3600
      214     .
      215     assign
      216       v-min = truncate(v-seconds / 60, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 60
      220     .
      221     return
      222         (if v-day-number <> 0
      223           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0
      227           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      231           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      232           else ""
      233         )
      234       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      235       .
      236   end.
      237   function cur-time-string returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      246   end.
      247   function cur-time-string-sec returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      256   end.
      257   function cur-time-custom  returns character
      258   (input p-prefix as character
      259   ,input p-date-format as character
      260   ,input p-delimiter as character
      261   ,input p-time-format as character
      262   ,input p-suffix as character
      263   )
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return
      272       p-prefix
      273       + string(v-date, p-date-format)
      274       + p-delimiter
      275       + string(v-time, p-time-format)
      276       + p-suffix
      277       .
      278   end.
      279   function cur-time-print  returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      288   end.
      289   function cur-time-datetime returns datetime
      290   :
      291     define variable v-char as character no-undo .
      292     define variable v-datetime as datetime no-undo .
      293     v-char = cur-time-string().
      294     v-datetime = datetime(v-char).
      295     return  v-datetime.
      296   end.
      297   function cur-time-string-msec returns character
      298   :
      299     define variable v-date as datetime  no-undo .
      300     v-date = now.
      301     return string(v-date) .
      302   end.
      303   procedure scl-attr-code :
      304     do
      305     on error undo, return error
      306     :
      307       define input  parameter p-code           as character no-undo .
      308       define output parameter p-type           as character no-undo .
      309       define output parameter p-format         as character no-undo .
      310       define output parameter p-label          as character no-undo .
      311       define output parameter p-user-can-edit  as logical   no-undo .
      312       define output parameter p-output-display as logical   no-undo .
      313       define output parameter p-other          as character no-undo .
      314       case p-code :
      315               when 'tare-weight':U then do:     assign     p-label = "Веса и коды тары"     p-type = 'C':U      p-format = "X(32)"     p-label = "Веса и коды тары"     p-user-can-edit  = yes     p-output-display = true     p-other = 'scl=TIGER,MIRA,TIGER2,TIGER-SPCT2/spr=scl-attr-tare-weight':u      .   end.
      316         otherwise do:
      317           undo, return error "неизвестный атрибут весов" + " " + p-code .
      318         end.
      319       end.
      320     end.
      321   end procedure.
      322   procedure scl-attr-tooltip :
      323     do
      324     on error undo, return error
      325     :
      326       define input  parameter p-code    as character no-undo .
      327       define output parameter p-tooltip as character no-undo .
      328       define output parameter p-label   as character no-undo .
      329       case p-code :
      330               when 'tare-weight':U then do:     assign     p-tooltip = "Веса и коды тары"     p-label = "Веса и коды тары" .   end.
      331         otherwise do:
      332           undo, return error "неизвестный атрибут весов" + " " + p-code .
      333         end.
      334       end.
      335     end.
      336   end procedure.
      337   procedure scl-attr-value :
      338     do
      339     on error undo, return error
      340     :
      341       define input  parameter p-db-num   like ub.scales-attr.db-num        no-undo .
      342       define input  parameter p-scales-num like ub.scales-attr.scales-num      no-undo .
      343       define input  parameter p-code     like ub.scales-attr.attr-code      no-undo .
      344       define output parameter p-value    like ub.scales-attr.attr-value    no-undo .
      345       define output parameter p-type     as character no-undo .
      346       define buffer buf_scales-attr for ub.scales-attr .
      347       define variable v-format         as character no-undo .
      348       define variable v-label          as character no-undo .
      349       define variable v-user-can-edit  as logical   no-undo .
      350       define variable v-output-display as logical   no-undo .
      351       define variable v-other          as character no-undo .
      352       run scl-attr-code in this-procedure
      353         (input  p-code
      354         ,output p-type
      355         ,output v-format
      356         ,output v-label
      357         ,output v-user-can-edit
      358         ,output v-output-display
      359         ,output v-other
      360         ) no-error .
      361       if error-status :error then do:
      362         undo, return error return-value .
      363       end.
      364       find first buf_scales-attr no-lock
      365         where buf_scales-attr.db-num    = p-db-num
      366           and buf_scales-attr.scales-num  = p-scales-num
      367           and buf_scales-attr.attr-code = p-code
      368         no-error .
      369       if avail buf_scales-attr then do:
      370         assign
      371           p-value =  buf_scales-attr.attr-value
      372         .
      373       end.
      374       else do:
      375         assign
      376           p-value = if p-type = 'L':U then "no":U else ""
      377         .
      378       end.
      379     end.
      380   end procedure.
      381   procedure scl-attr-write :
      382     do
      383     on error undo, return error
      384     :
      385       define input parameter p-db-num   like ub.scales-attr.db-num     no-undo .
      386       define input parameter p-scales-num like ub.scales-attr.scales-num   no-undo .
      387       define input parameter p-code     like ub.scales-attr.attr-code  no-undo .
      388       define input parameter p-value    like ub.scales-attr.attr-value no-undo .
      389       define buffer buf_scales-attr for ub.scales-attr .
      390       define variable v-type           as character no-undo .
      391       define variable v-format         as character no-undo .
      392       define variable v-label          as character no-undo .
      393       define variable v-user-can-edit  as logical   no-undo .
      394       define variable v-output-display as logical   no-undo .
      395       define variable v-other          as character no-undo .
      396       run scl-attr-code in this-procedure
      397         (input  p-code
      398         ,output v-type
      399         ,output v-format
      400         ,output v-label
      401         ,output v-user-can-edit
      402         ,output v-output-display
      403         ,output v-other
      404         ) no-error .
      405       if error-status :error then do:
      406         undo, return error return-value .
      407       end.
      408       find first buf_scales-attr exclusive-lock
      409         where buf_scales-attr.db-num  = p-db-num
      410           and buf_scales-attr.scales-num  = p-scales-num
      411           and buf_scales-attr.attr-code = p-code
      412         no-error .
      413       if not available buf_scales-attr then do:
      414         create buf_scales-attr .
      415         assign
      416           buf_scales-attr.db-num    = p-db-num
      417           buf_scales-attr.scales-num  = p-scales-num
      418           buf_scales-attr.attr-code = p-code
      419         .
      420       end.
      421       assign
      422         buf_scales-attr.attr-value = p-value
      423       .
      424       release buf_scales-attr no-error .
      425       if error-status:error then do:
      426         undo, return error return-value .
      427       end.
      428     end.
      429   end procedure.
      430   procedure scl-attr-exist :
      431     do
      432     on error undo, return error
      433     :
      434       define input parameter p-db-num   like ub.scales-attr.db-num     no-undo .
      435       define input parameter p-scales-num like ub.scales-attr.scales-num   no-undo .
      436       define input parameter p-code     like ub.scales-attr.attr-code  no-undo .
      437       define output parameter p-exist   as logical  no-undo .
      438       define buffer buf_scales-attr for ub.scales-attr .
      439       define variable v-type           as character no-undo .
      440       define variable v-format         as character no-undo .
      441       define variable v-label          as character no-undo .
      442       define variable v-user-can-edit  as logical   no-undo .
      443       define variable v-output-display as logical   no-undo .
      444       define variable v-other          as character no-undo .
      445       run scl-attr-code in this-procedure
      446         (input  p-code
      447         ,output v-type
      448         ,output v-format
      449         ,output v-label
      450         ,output v-user-can-edit
      451         ,output v-output-display
      452         ,output v-other
      453         ) no-error .
      454       if error-status :error then do:
      455         undo, return error return-value .
      456       end.
      457       find first buf_scales-attr exclusive-lock
      458         where buf_scales-attr.db-num  = p-db-num
      459           and buf_scales-attr.scales-num  = p-scales-num
      460           and buf_scales-attr.attr-code = p-code
      461         no-error .
      462       if  available buf_scales-attr then do:
      463         p-exist = yes.
      464       end.
      465     end.
      466   end procedure.
      467   procedure scl-attr-delete :
      468     do
      469     on error undo, return error
      470     :
      471       define input parameter p-db-num   like ub.scales-attr.db-num     no-undo .
      472       define input parameter p-scales-num like ub.scales-attr.scales-num   no-undo .
      473       define input parameter p-code     like ub.scales-attr.attr-code  no-undo .
      474       define output parameter p-deleted  as logical no-undo.
      475       define buffer buf_scales-attr for ub.scales-attr .
      476       define variable v-type           as character no-undo .
      477       define variable v-format         as character no-undo .
      478       define variable v-label          as character no-undo .
      479       define variable v-user-can-edit  as logical   no-undo .
      480       define variable v-output-display as logical   no-undo .
      481       define variable v-other          as character no-undo .
      482       run scl-attr-code in this-procedure
      483         (input  p-code
      484         ,output v-type
      485         ,output v-format
      486         ,output v-label
      487         ,output v-user-can-edit
      488         ,output v-output-display
      489         ,output v-other
      490         ) no-error .
      491       if error-status :error then do:
      492         undo, return error return-value .
      493       end.
      494       find first buf_scales-attr exclusive-lock
      495         where buf_scales-attr.db-num  = p-db-num
      496           and buf_scales-attr.scales-num  = p-scales-num
      497           and buf_scales-attr.attr-code = p-code
      498         no-error NO-WAIT.
      499       if not available buf_scales-attr then do:
      500         p-deleted = no.
      501       end.
      502       else do:
      503         delete buf_scales-attr no-error .
      504         if error-status:error then do:
      505           undo, return error return-value .
      506         end.
      507         p-deleted = yes.
      508       end.
      509     end.
      510   end procedure.
      511   procedure scl-attr-news :
      512     do
      513     on error undo, return error
      514     :
      515       define input  parameter p-code           as character no-undo .
      516       define output parameter p-news           as logical   no-undo .
      517       case p-code :
      518               when 'tare-weight':U then do:     assign     p-news = yes.   end.
      519         otherwise do:
      520           p-news = no.
      521         end.
      522       end.
      523     end.
      524   end procedure.
