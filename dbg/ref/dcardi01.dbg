     3593                                     , buf_dis-card-property.host-code
     3594                                     , (buf_dis-card-property.obj-type + string(buf_dis-card-property.obj-code))
     3595                                     , buf_dis-card-property.dt-code
     3596                                     , buf_dis-card-property.node-code
     3597                                     , chr(10)
     3598                                     ,error-status:get-message(1)
     3599                                     ,return-value
