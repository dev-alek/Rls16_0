     3624       if error-status:error then do:
     3625         assign
     3626         v-err-mess = substitute("Ошибка при сохранении статуса дисконтной карты &1, к которой перевыпускается карта&2&3&4&5"
     3627                                 ,source_dis-card.d-card
     3628                                 ,error-status:get-message(1)
     3629                                 , chr(10)
     3630                                 ,return-value
     3631                                 , chr(10)).
     3632         run err-mess in this-procedure ( input-output v-err-mess).
     3633         undo _main, return error v-err-mess.
     3634       end.
     3635       FIND FIRST dc-list WHERE
     3636                   dc-list.d-card = source_dis-card.d-card No-ERROR.
     3637       IF NOT avail dc-list then do:
     3638         create dc-list.
     3639         assign
     3640         dc-list.d-card = source_dis-card.d-card
     3641         .
     3642       end.
     3643       FIND FIRST dc-list WHERE
     3644                   dc-list.d-card = pard-card No-ERROR.
     3645       IF NOT avail dc-list then do:
     3646         create dc-list.
     3647         assign
     3648         dc-list.d-card = pard-card
     3649         .
     3650       end.
     3651       else do:
     3652         find first dcp-list where
     3653                   dcp-list.d-card = pard-card
     3654               AND dcp-list.host-code = ub.shop.host-code
     3655               AND dcp-list.obj-type  = 'маг':U
     3656               AND dcp-list.obj-code  = parissue-code no-error .
     3657         if available dcp-list
     3658         then delete dcp-list.
     3659       end.
     3660     end.
     3661   END.
     3662   define variable v-send-all as logical no-undo .
     3663   if not p-silent then do:
     3664     for each dc-list NO-LOCK:
     3665       if not can-find( first dcp-list where
     3666                   dcp-list.d-card = dc-list.d-card)  then do:
     3667         assign
     3668         v-send-all = yes.
     3669         leave.
     3670       end.
     3671     end.
     3672    if v-send-all
     3673    then do:
     3674      if valid-handle(p-log-handle) then do:
     3675        run get-title in p-log-handle (
     3676             output v-old-title
     3677                                     ).
     3678        run set-title in p-log-handle (
     3679             input 'Отправка информации по клиентским карта на кассы'
     3680                                    ).
     3681        run str/sendclia.p (
     3682                     input parparentproc
     3683                     ,input p-parent-handle
     3684                     ,input p-log-handle
     3685                     ,input(string(g#db-num) + chr(4) +  chr(4) + "no":U + chr(4) + "O":U)
     3686                     ) no-error .
     3687        run set-title in p-log-handle (
     3688             input v-old-title
     3689                                    ).
     3690      end.
     3691      else do:
     3692        run str/diallog.w (
     3693                       input parparentproc
     3694                     , input this-procedure
     3695                     , input 'str/sendclia.p':U
     3696                     , input(string(g#db-num) + chr(4) +  chr(4) + "no":U + chr(4) + "O":U)
     3697                     , input yes
     3698                     , input '':U
     3699                     , input 'Отправка информации по клиентским картам на кассу') no-error .
     3700      end.
     3701     end.
     3702   end.
     3703   RETURN '':u.
     3704   end.
     3705   procedure create-dis-card :
     3706   define input parameter pard-card like ub.dis-card.d-card no-undo .
     3707   define input parameter parcard-num like ub.dis-card.card-num.
     3708   define input parameter paremitent-host-code like ub.dis-card.emitent-host-code no-undo .
     3709   define input parameter parcli-type like ub.dis-card.cli-type no-undo .
     3710   define input parameter parcli-code like ub.dis-card.cli-code no-undo .
     3711   define input parameter par-status_ like ub.dis-card.status_ no-undo .
     3712   define input parameter parsourced-card like ub.dis-card.sourced-card no-undo .
     3713   define output parameter par-rid as recid no-undo .
     3714   define buffer buf_dis-card for ub.dis-card.
     3715     do
     3716     on error undo, return error
     3717     :
     3718       CREATE buf_dis-card.
     3719       assign
     3720       buf_dis-card.d-card = pard-card
     3721       buf_dis-card.card-num = varcard-num
     3722       buf_dis-card.emitent-host-code = paremitent-host-code
     3723       buf_dis-card.status_ = (if par-status_ = '':U or par-status_ = ?
     3724                               then 'тек':U
     3725                               else par-status_)
     3726       buf_dis-card.cli-type = parcli-type
     3727       buf_dis-card.cli-code = parcli-code
     3728       buf_dis-card.sourced-card = parsourced-card
     3729       buf_dis-card.main-card  = parmain-card
     3730       buf_dis-card.is-subsid  = paris-subsid
     3731       buf_dis-card.first-card = v-first-card
     3732       buf_dis-card.first-main-card = v-first-main-card
     3733       par-rid = recid( buf_dis-card )
     3734       .
     3735     end.
     3736   end procedure.
     3737   PROCEDURE err-mess:
     3738     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
     3739     CASE p-silent:
     3740       when yes then do:
     3741         assign
     3742         p-mess = substitute("Карта №&1: эмитент: &2 тип: &3: &4", pard-card, paremitent-host-code, par-type, p-mess)
     3743         .
     3744       end.
     3745       when no then do:
     3746         message
     3747         p-mess
     3748         view-as alert-box error .
     3749       end.
     3750     end.
     3751   END PROCEDURE.
