     3419         run discardh_write-dis-card-rul in p-hn-handle ( buffer buf_dis-card
     3420                                                   ,input buf_dis-card.type
     3421                                                   ,input buf_dis-card.emitent-host-code
     3422                                                   ,input (if par-mode = 'ДОБАВЛЕНИЕ':U
     3423                                                           then integer('1':U)
     3424                                                           else integer('2':U)
     3425                                                          )
     3426                                                   ).
