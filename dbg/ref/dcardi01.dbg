       59   end procedure.
       60   procedure vss-get-parameters :
       61     define output parameter p-vss-parameters as character no-undo .
       62   end procedure.
       63   define new global shared variable g#vssrevis-logger as handle    no-undo .
       64   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       65   define variable v-vssrevis-logger                   as handle    no-undo .
       66   procedure vss-logevent :
       67     define input  parameter p-extra-paramters as character no-undo .
       68     define variable v-vssrevis-parameters as character no-undo .
       69     do
       70     on error undo, return error return-value
       71     :
       72       if  valid-handle(v-vssrevis-logger)
       73       and v-vssrevis-logger :get-signature("logevent") <> ""
       74       then do:
       75         run vss-get-parameters in this-procedure
       76           (output v-vssrevis-parameters
       77           ).
       78         run logevent in v-vssrevis-logger
       79           (input vss-workfile
       80           ,input vss-revision
       81           ,input v-vssrevis-parameters
       82           ,input p-extra-paramters
       83           ).
       84       end.
       85     end.
       86   end procedure.
       87   assign
       88     v-vssrevis-logger = g#vssrevis-logger
       89   .
       90   if  valid-handle(v-vssrevis-logger)
       91   and v-vssrevis-logger :get-signature("logevent") <> ""
       92   then do:
       93     assign
       94       v-vssrevis-logevent = true
       95     .
       96     run vss-logevent in this-procedure (input vss-description) .
       97   end.
       98   define new global shared variable g#language as character no-undo .
       99   if g#language <> '' and g#language <> 'rus':U then do:
      100     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      101   end.
      102   define new global shared variable g#library  as handle no-undo .
      103   define new global shared variable g#library2 as handle no-undo .
      104   define   shared variable g#auto as logical no-undo.
      105   define   shared variable g#news as logical no-undo.
      106   define   shared variable g#oxml as logical no-undo.
      107   define   shared variable g#esys as logical no-undo.
      108   define   shared variable g#news-source-db as integer no-undo.
      109   define   shared variable g#esys-source-esys as integer no-undo.
      110   define   shared variable g#db-num as integer   no-undo .
      111   define   shared variable g#userid as character no-undo .
      112   define   shared variable g#passwd as character no-undo .
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   procedure cur-time :
      115      define output parameter p-today as date      no-undo .
      116      define output parameter p-time  as integer   no-undo .
      117     do
      118     on error undo, return error
      119     :
      120       define variable v-date1 as date      no-undo .
      121       define variable v-date2 as date      no-undo .
      122       define variable v-time  as integer   no-undo .
      123       assign
      124         v-date1 = today
      125         v-time  = time
      126         v-date2 = today
      127       .
      128       if v-date1 <> v-date2
      129       then do:
      130         assign
      131           v-date1 = today
      132           v-time  = v-time
      133         .
      134       end.
      135       assign
      136         p-today = v-date1
      137         p-time  = v-time
      138       .
      139     end.
      140   end.
      141   function cur-time-date returns character
      142   :
      143     return string(today, '99/99/9999':U) .
      144   end.
      145   function cur-time-mjd returns decimal
      146   :
      147     define variable v-date as date      no-undo .
      148     define variable v-time as integer   no-undo .
      149     run cur-time in this-procedure
      150       (output v-date
      151       ,output v-time
      152       ) .
      153     return integer(v-date) - 2400002 + (v-time / 86400) .
      154   end.
      155   function cur-time-get-ending-index returns integer
      156   (input p-number as integer
      157   )
      158   :
      159     if p-number < 0
      160     or p-number = ?
      161     then do:
      162       return 1 .
      163     end.
      164     define variable v-rest as integer   no-undo .
      165     assign
      166       p-number = p-number modulo 100
      167     .
      168     if p-number < 20
      169     then do:
      170       assign
      171         v-rest = p-number
      172       .
      173     end.
      174     else do:
      175       assign
      176         v-rest = p-number modulo 10
      177       .
      178     end.
      179     case v-rest :
      180       when 1
      181       then do:
      182         return 2 .
      183       end.
      184       when 2 or
      185       when 3 or
      186       when 4
      187       then do:
      188         return 3 .
      189       end.
      190       otherwise do:
      191         return 1 .
      192       end.
      193     end case .
      194   end.
      195   procedure cur-time-mjd-to-date :
      196      define input  parameter i-mjd-diff as decimal no-undo.
      197      define output parameter o-Date     as date    no-undo.
      198      define output parameter o-Time     as integer no-undo.
      199      define variable v-day-number as integer   no-undo .
      200      if    i-mjd-diff < 0
      201         or i-mjd-diff = ?
      202      then do:
      203         return "?" .
      204      end.
      205      assign
      206         v-day-number = truncate(i-mjd-diff,0).
      207         o-Date = date(v-day-number + 2400002).
      208         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      209     .
      210   end.
      211   function cur-time-mjd-to-string returns character
      212   (input p-mjd-diff as decimal
      213   )
      214   :
      215     define variable v-day-number as integer   no-undo .
      216     define variable v-seconds    as integer   no-undo .
      217     define variable v-hour       as integer   no-undo .
      218     define variable v-min        as integer   no-undo .
      219     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      220     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      221     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      222     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      223     if p-mjd-diff < 0
      224     or p-mjd-diff = ?
      225     then do:
      226       return "?" .
      227     end.
      228     assign
      229       v-day-number = integer(truncate(p-mjd-diff,0))
      230       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      231     .
      232     if v-seconds > 86400
      233     then do:
      234       assign
      235         v-seconds = 86400 - 1
      236       .
      237     end.
      238     if v-seconds < 0
      239     then do:
      240       assign
      241         v-seconds = 0
      242       .
      243     end.
      244     assign
      245       v-hour = truncate(v-seconds / 3600, 0)
      246     .
      247     assign
      248       v-seconds = v-seconds modulo 3600
      249     .
      250     assign
      251       v-min = truncate(v-seconds / 60, 0)
      252     .
      253     assign
      254       v-seconds = v-seconds modulo 60
      255     .
      256     return
      257         (if v-day-number <> 0
      258           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      259           else ""
      260         )
      261       + (if v-day-number <> 0 or v-hour <> 0
      262           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      263           else ""
      264         )
      265       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      266           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      267           else ""
      268         )
      269       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      270       .
      271   end.
      272   function cur-time-string returns character
      273   :
      274     define variable v-date as date      no-undo .
      275     define variable v-time as integer   no-undo .
      276     run cur-time in this-procedure
      277       (output v-date
      278       ,output v-time
      279       ) .
      280     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      281   end.
      282   function cur-time-string-sec returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      291   end.
      292   function cur-time-custom  returns character
      293   (input p-prefix as character
      294   ,input p-date-format as character
      295   ,input p-delimiter as character
      296   ,input p-time-format as character
      297   ,input p-suffix as character
      298   )
      299   :
      300     define variable v-date as date      no-undo .
      301     define variable v-time as integer   no-undo .
      302     run cur-time in this-procedure
      303       (output v-date
      304       ,output v-time
      305       ) .
      306     return
      307       p-prefix
      308       + string(v-date, p-date-format)
      309       + p-delimiter
      310       + string(v-time, p-time-format)
      311       + p-suffix
      312       .
      313   end.
      314   function cur-time-print  returns character
      315   :
      316     define variable v-date as date      no-undo .
      317     define variable v-time as integer   no-undo .
      318     run cur-time in this-procedure
      319       (output v-date
      320       ,output v-time
      321       ) .
      322     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      323   end.
      324   function cur-time-datetime returns datetime
      325   :
      326     define variable v-char as character no-undo .
      327     define variable v-datetime as datetime no-undo .
      328     v-char = cur-time-string().
      329     v-datetime = datetime(v-char).
      330     return  v-datetime.
      331   end.
      332   function cur-time-string-msec returns character
      333   :
      334     define variable v-date as datetime  no-undo .
      335     v-date = now.
      336     return string(v-date) .
      337   end.
      338   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      339   procedure discardh_write-dis-card-proc  :
      340   define parameter buffer buf_dis-card for ub.dis-card .
      341   define input parameter p-source-type like ub.c-dc-hist.source-type no-undo .
      342   define input parameter p-source-ref  like ub.c-dc-hist.source-ref no-undo .
      343   define variable v-date as date      no-undo.
      344   define variable v-time  as integer   no-undo.
      345   define buffer buf_c-dc-hist for ub.c-dc-hist.
      346   define buffer buf_c-dis-card for ub.c-dis-card.
      347     do
      348     on error undo, return error
      349     :
      350       if not available buf_dis-card then do:
      351         message
      352           vss-workfile vss-revision vss-description skip
      353           "Ошибка задания входных параметров" skip
      354           "Не определена ДК" skip
      355           view-as alert-box error .
      356         undo, return error .
      357       end.
      358       run cur-time in this-procedure(output v-date, output v-time).
      359       create buf_c-dis-card.
      360       buffer-copy buf_dis-card to buf_c-dis-card
      361       assign
      362       buf_c-dis-card.d-card             = buf_dis-card.d-card
      363       buf_c-dis-card.card-num           = buf_dis-card.card-num
      364       buf_c-dis-card.chip-num           = next-value (s-dc-chip, ub)
      365       buf_c-dis-card.corr-time          = v-time
      366       buf_c-dis-card.corr-user-db-num   = g#db-num
      367       buf_c-dis-card.corr-user-name     = (if g#news
      368                                            then (chr(4) +  'СПН':U)
      369                                            else (if g#esys
      370                                                  then (chr(4) +  'ВС':U)
      371                                                  else g#userid
      372                                                 )
      373                                            )
      374       buf_c-dis-card.corr-date          = v-date
      375       .
      376       create buf_c-dc-hist.
      377       buffer-copy buf_c-dis-card to buf_c-dc-hist
      378       assign
      379       buf_c-dc-hist.action =  integer('2':U)
      380       buf_c-dc-hist.subject = 'dis-card':U
      381       buf_c-dc-hist.host-code =  buf_dis-card.emitent-host-code
      382       buf_c-dc-hist.is-news = g#news
      383       buf_c-dc-hist.source-type = p-source-type
      384       buf_c-dc-hist.source-ref = p-source-ref
      385       .
      386       if not ( g#db-num > 0 )
      387       or (g#news
      388           and ( g#db-num > 0 )
      389           and buf_c-dis-card.corr-user-name = (chr(4) +  'СПН':U)
      390           )
      391       then do:
      392         run str/callnews.p
      393           (input 'c-dis-card':U
      394           ,input (buffer buf_c-dis-card:handle)
      395           ).
      396         run str/callnews.p
      397           (input 'c-dc-hist':U
      398           ,input (buffer buf_c-dc-hist:handle)
      399           ).
      400       end.
      401     end.
      402   end procedure.
      403   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      404   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      405   procedure check-mask-card :
      406   define input parameter p-mask like ub.dis-card.d-card no-undo .
      407   define input parameter p-silence as logical no-undo .
      408   define output parameter p-ok as logical no-undo .
      409   define output parameter p-descr as character no-undo .
      410   define variable v-dec as decimal no-undo.
      411     do
      412     on error undo, return error
      413     :
      414       if length(p-mask) > 19 then do:
      415         assign
      416         p-descr = substitute("Маска &1 имеет длину более 19 символов", p-mask)
      417         .
      418         if not p-silence then do:  message p-descr view-as alert-box error . end.
      419         return.
      420       end.
      421       assign
      422       v-dec = decimal(p-mask)
      423       no-error .
      424       if not error-status:error and round(v-dec, 0) = v-dec and v-dec >= 0 then do:
      425         assign
      426         p-descr = substitute("Маска &1 не может быть числом", p-mask)
      427         .
      428         if not p-silence then do:  message p-descr view-as alert-box error . end.
      429         return.
      430       end.
      431       if index(p-mask, "*":U) > 0
      432       and index(substring(p-mask, index(p-mask, "*") + 1), "*") > 0 then do:
      433         assign
      434         p-descr = substitute("Маска &1 не может содержать более одного символа *", p-mask)
      435         .
      436         if not p-silence then do:  message p-descr view-as alert-box error . end.
      437         return.
      438       end.
      439       if index(p-mask, "*":U) > 0
      440       and index(p-mask, "*":U) <>  Length(p-mask)
      441       then do:
      442         assign
      443         p-descr = substitute("Символ * в маска &1 может стоять только в конце", p-mask)
      444         .
      445         if not p-silence then do:  message p-descr view-as alert-box error . end.
      446         return.
      447       end.
      448       assign
      449       v-dec = decimal(replace(replace(p-mask, chr(63), "0":U), "*":U, "0":U))
      450       no-error .
      451       if not error-status:error
      452       and round(v-dec, 0) = v-dec and v-dec >= 0 then do:
      453         assign
      454         p-ok = yes.
      455         return.
      456       end.
      457       else do:
      458         assign
      459         p-descr = substitute("Маска &1 содержит недопустимые символы - разрешенные символы: 1,2,3,4,5,6,7,8,9,0, * и ?", p-mask)
      460         .
      461         if not p-silence then do:  message p-descr view-as alert-box error . end.
      462         return.
      463       end.
      464     end.
      465   end procedure.
      466   procedure check-cli-mask :
      467   define input parameter p-mask like ub.dis-card-mask.mask no-undo .
      468   define input parameter p-silence as logical no-undo .
      469   define input parameter p-addvalidchars as character no-undo .
      470   define input parameter p-mask-type as character no-undo .
      471   define input parameter p-cc-run as integer no-undo .
      472   define output parameter p-ok as logical no-undo .
      473   define output parameter p-descr as character no-undo .
      474   define variable v-dec as decimal no-undo.
      475   define variable v-dec-dop as character no-undo .
      476   define variable v-old-dop as character no-undo .
      477   define variable ii as integer no-undo .
      478     do
      479     on error undo, return error
      480     :
      481       if length(p-mask) > 19 then do:
      482         assign
      483         p-descr = substitute("Маска &1 имеет длину более 19 символов", p-mask)
      484         .
      485         if not p-silence then do:  message p-descr view-as alert-box error . end.
      486         return.
      487       end.
      488       assign
      489       v-dec = decimal(p-mask)
      490       no-error .
      491       if not error-status:error and round(v-dec, 0) = v-dec and v-dec >= 0 then do:
      492         assign
      493         p-descr = substitute("Маска &1 не может быть числом", p-mask)
      494         .
      495         if not p-silence then do:  message p-descr view-as alert-box error . end.
      496         return.
      497       end.
      498       if index(p-mask, "*":U) > 0
      499       and index(p-addvalidchars, "*") > 0
      500       and index(substring(p-mask, index(p-mask, "*") + 1), "*") > 0 then do:
      501         assign
      502         p-descr = substitute("Маска &1 не может содержать более одного символа *", p-mask)
      503         .
      504         if not p-silence then do:  message p-descr view-as alert-box error . end.
      505         return.
      506       end.
      507       if index(p-addvalidchars, "*") > 0
      508       and index(p-mask, "*":U) > 0
      509       and index(p-mask, "*":U) <>  Length(p-mask)
      510       then do:
      511         assign
      512         p-descr = substitute("Символ * в маске &1 может стоять только в конце", p-mask)
      513         .
      514         if not p-silence then do:  message p-descr view-as alert-box error . end.
      515         return.
      516       end.
      517       assign
      518       v-dec-dop = replace(replace(p-mask, chr(63), "0":U), "*":U, "0":U)
      519       .
      520       do ii = 1 to num-entries(p-addvalidchars):
      521         assign
      522         v-old-dop = v-dec-dop
      523         v-dec-dop = replace(v-dec-dop, entry(ii, p-addvalidchars), "0":U)
      524         .
      525         if p-mask-type = entry(ii, p-addvalidchars)
      526         and (entry(ii, p-addvalidchars) <> 'C':U or p-cc-run > 0)
      527         and v-dec-dop = v-old-dop then do:
      528           assign
      529           p-descr = substitute("Маска &1 должна содержать хотя бы один символ &2", p-mask, p-mask-type)
      530           .
      531           if not p-silence then do:  message p-descr view-as alert-box error . end.
      532           return.
      533         end.
      534       end.
      535       assign
      536       v-dec = decimal(v-dec-dop)
      537       no-error .
      538       if not error-status:error
      539       and round(v-dec, 0) = v-dec and v-dec >= 0 then do:
      540         assign
      541         p-ok = yes.
      542         return.
      543       end.
      544       else do:
      545         assign
      546         p-descr = substitute("Маска &1 содержит недопустимые символы - разрешенные символы: 1,2,3,4,5,6,7,8,9,0,?&2"
      547                             , p-mask
      548                             , (if p-addvalidchars = "":u then "":U else (chr(44) + p-addvalidchars))
      549                             )
      550         .
      551         if not p-silence then do:  message p-descr view-as alert-box error . end.
      552         return.
      553       end.
      554     end.
      555   end procedure.
