       24   define input parameter pardebet-card like  ub.dis-card.debet-card  no-undo .
       25   define input parameter parstaff-card like  ub.dis-card.staff-card  no-undo .
       26   define input parameter parissue-date like ub.dis-card.issue-date no-undo .
