       20   define input parameter parcategory like ub.dis-card.category no-undo .
       21   define input parameter pard-pcnt-method like ub.dis-card.d-pcnt-method no-undo .
       22   define input parameter parcredit-card like ub.dis-card.credit-card no-undo .
