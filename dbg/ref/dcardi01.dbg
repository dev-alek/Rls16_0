     3604         END.
     3605       END.
     3606   END.
     3607   if not parmask-card then do:
     3608     if (parsourced-card <> "":U and par-mode = 'ДОБАВЛЕНИЕ':U)
     3609     or (par-mode = 'ИЗМЕНЕНИЕ':U and parsourced-card <> old-sourced-card)
     3610     then do:
     3611       define variable v-sourced-status_ like ub.dis-card.status_ no-undo .
     3612       assign
     3613       v-sourced-status_ = 'удал':U.
     3614       run ref/dcardi02.p (  input parparentproc
     3615                       ,input recid(source_dis-card)
     3616                       ,input p-silent
     3617                       ,input v-has-right-to-restore
     3618                       ,input par-mode2
     3619                       ,input 'dis-card':U
     3620                       ,input pard-card
     3621                       ,input p-curr-obj-type
     3622                       ,input p-curr-obj-code
