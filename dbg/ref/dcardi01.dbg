     3478   define variable v-chip-num as integer no-undo .
     3479   define variable v-corr-date as date no-undo .
     3480   define variable v-corr-time as integer no-undo .
     3481   define variable v-updated as logical no-undo .
     3482   define variable v-updated-chr as character no-undo .
     3483     IF p-update-prop THEN DO:
     3484       FOR EACH tt0-dis-card-property
     3485       on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3486       on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     3487       on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     3488       :
     3489         assign
     3490         v-chip-num = 0
     3491         v-corr-date = ?
     3492         v-corr-time = ?
     3493         .
     3494         v-updated = no.
     3495         v-updated-chr = "".
     3496         find first buf_dis-card-property no-lock where
     3497                   buf_dis-card-property.d-card = pard-card
     3498              and  buf_dis-card-property.host-code = tt0-dis-card-property.host-code
     3499              and  buf_dis-card-property.obj-type = tt0-dis-card-property.obj-type
     3500              and  buf_dis-card-property.obj-code = tt0-dis-card-property.obj-code
     3501              and  buf_dis-card-property.dt-code = tt0-dis-card-property.dt-code
     3502              and  buf_dis-card-property.node-code = tt0-dis-card-property.node-code no-error.
     3503         if not available buf_Dis-card-property then do:
     3504           v-updated = yes.
     3505         end.
     3506         else do:
     3507           buffer-compare
     3508           tt0-dis-card-property
     3509           except card-num main-card first-main-card first-card
     3510           to buf_dis-card-property
     3511           save result in v-updated-chr.
     3512           v-updated = (v-updated-chr <> "").
     3513         end.
     3514         if v-updated then do:
     3515           run discprop-write in this-procedure (
     3516                                                 input PARd-card
     3517                                               ,input tt0-dis-card-property.host-code
     3518                                               ,input tt0-dis-card-property.obj-type
     3519                                               ,input tt0-dis-card-property.obj-code
     3520                                               ,input tt0-dis-card-property.dtm-code
     3521                                               ,input tt0-dis-card-property.node-code
     3522                                               ,input tt0-dis-card-property.dt-code
     3523                                               ,input tt0-dis-card-property.sum-id
     3524                                               ,input tt0-dis-card-property.property-value-character
     3525                                               ,input tt0-dis-card-property.property-value-date
     3526                                               ,input tt0-dis-card-property.property-value-decimal
     3527                                               ,input tt0-dis-card-property.property-value-integer
     3528                                               ,input tt0-dis-card-property.property-value-logical
     3529                                               ,input '':U
     3530                                               ,input '':U
     3531                                               ,input-output v-chip-num
     3532                                               ,input-output v-corr-date
     3533                                               ,input-output v-corr-time
     3534                                               )  no-error.
     3535           IF ERROR-STATUS:ERROR THEN DO:
     3536             assign
     3537             v-err-mess = substitute("Ошибка при сохранении свойства дисконтной карты &1 &2 &3 &4:&5:&6&7 &8"
     3538                                     , pard-card
     3539                                     , tt0-dis-card-property.host-code
     3540                                     , (tt0-dis-card-property.obj-type + string(tt0-dis-card-property.obj-code))
     3541                                     , tt0-dis-card-property.dtm-code
     3542                                     , tt0-dis-card-property.node-code
     3543                                     , chr(10)
     3544                                     ,error-status:get-message(1)
     3545                                     ,return-value).
     3546             run err-mess in this-procedure ( input-output v-err-mess).
     3547             undo _main, return error v-err-mess.
     3548           END.
     3549         end.
     3550       END.
     3551       FOR EACH buf_dis-card-property where buf_dis-card-property.d-card = pard-card
     3552       on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3553       on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     3554       on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     3555       :
     3556         if buf_dis-card-property.dtm-code = 0 then next.
     3557         FIND FIRST tt0-dis-card-property NO-LOCK WHERE
     3558             tt0-dis-card-property.d-card = pard-card
     3559         AND tt0-dis-card-property.host-code = buf_dis-card-property.host-code
     3560         AND tt0-dis-card-property.obj-type = buf_dis-card-property.obj-type
     3561         AND tt0-dis-card-property.obj-code = buf_dis-card-property.obj-code
