     3438     buf_dis-card.issue-date = parissue-date
     3439     buf_dis-card.valid-from = parvalid-from
     3440     buf_dis-card.valid-date = parvalid-date
     3441     buf_dis-card.debet-card = pardebet-card
     3442     buf_dis-card.staff-card = parstaff-card
     3443     buf_dis-card.cli-message = parcli-message
     3444     buf_dis-card.status_ =  (if buf_dis-card.status_ = 'неисп':U
