       37   DEFINE INPUT PARAMETER TABLE FOR tt0-dis-card-property.
       38   define variable vss-revision    as character no-undo init "$Revision: 560be6005277, 558, rls $":U .
       39   define variable vss-author      as character no-undo init "$Author: PGridchina $":U .
       40   define variable vss-date        as character no-undo init "$Date: Wed Mar 30 17:48:23 2016 +0400 $":U .
       41   define variable vss-workfile    as character no-undo init "$Workfile: dcardi01.p $":U .
       42   define variable vss-archive     as character no-undo init "$Archive: ref/dcardi01.p $":U .
       43   define variable vss-description as character no-undo init "Сохранение изменений в карточке дисконтной карты".
       44   procedure vss-get-info :
       45     define output parameter p-vss-revision    like vss-revision    no-undo .
       46     define output parameter p-vss-author      like vss-author      no-undo .
       47     define output parameter p-vss-date        like vss-date        no-undo .
