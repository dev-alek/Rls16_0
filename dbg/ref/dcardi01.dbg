      700   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      701   define variable v-disprop-menu-section-num as integer no-undo .
      702   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      703   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      704   procedure gen-key-rec :
      705     define input  parameter p-tbl-name    as character no-undo.
      706     define input  parameter p-bh_tbl-name as handle    no-undo.
      707     define output parameter p-key-rec     as character no-undo.
      708     do
      709     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      710     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      711     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      712     :
      713       define variable fh               as handle    no-undo .
      714       define variable v-ok             as logical   no-undo .
      715       define variable v-inform         as character no-undo .
      716       define variable v-ind            as integer   no-undo .
      717       define variable v-idx-field-qnty as integer   no-undo .
      718       if p-tbl-name = ?
      719         or p-tbl-name = "":U
      720       then do:
      721         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info10 ).
      722       end.
      723       if not p-bh_tbl-name:available then do:
      724         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info10, p-tbl-name ).
      725       end.
      726       assign
      727         p-key-rec = p-tbl-name
      728         v-inform  = p-bh_tbl-name:index-information(1)
      729         v-ind     = 2
      730       .
      731       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      732       on error undo, return error
      733       :
      734         assign
      735           v-inform = p-bh_tbl-name:index-information( v-ind )
      736           v-ind    = v-ind + 1
      737         .
      738       end.
      739       if v-inform = ?
      740         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      741         or entry( 3, v-inform, ",":U ) <> "1":U
      742       then do:
      743         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, p-tbl-name ).
      744       end.
      745       else do:
      746         assign
      747           v-idx-field-qnty = num-entries( v-inform ) - 4
      748         .
      749         if v-idx-field-qnty < 2 then do:
      750           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, p-tbl-name ).
      751         end.
      752         do v-ind = 1 to v-idx-field-qnty by 2
      753         on error undo, return error
      754         :
      755           assign
      756             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      757             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      758           .
      759         end.
      760       end.
      761       if p-key-rec = ? then do:
      762         assign
      763           p-key-rec = "":U
      764         .
      765         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info10, p-tbl-name ).
      766       end.
      767     end.
      768     return.
      769   end procedure.
      770   procedure gen-where-keyr-tab :
      771     define input  parameter i-tableSerach as character no-undo.
      772     define input  parameter i-tablekey   as character  no-undo.
      773     define input  parameter p-key-rec    as character  no-undo.
      774     define input  parameter p-key-handle as handle     no-undo .
      775     define input  parameter p-db-name    as character  no-undo .
      776     define input  parameter p-tt-handle  as handle     no-undo .
      777     define output parameter o-Where      as character  no-undo.
      778     do
      779     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      780     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      781     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      782     :
      783       define variable v-full-tbl-name  as character no-undo .
      784       define variable bh_tbl-name      as handle    no-undo .
      785       define variable fh_key           as handle    no-undo .
      786       define variable fh_search        as handle    no-undo .
      787       define variable v-field-num      as integer   no-undo .
      788       define variable v-count-fld      as integer   no-undo .
      789       define variable v-inform         as character no-undo .
      790       define variable v-ind            as integer   no-undo .
      791       define variable v-idx-field-qnty as integer   no-undo .
      792       define variable v-field-name     as character no-undo .
      793       define variable v-field-val      as character no-undo .
      794       define variable v-word-link      as character no-undo .
      795       define variable vTable           as character no-undo.
      796       define variable bh_tbl-key       as handle    no-undo .
      797       assign
      798         p-key-rec = trim( p-key-rec )
      799       .
      800       if p-key-handle <> ? then do:
      801         if not valid-handle(p-key-handle)
      802            or p-key-handle:type <> "buffer"
      803         then do:
      804           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info10 ).
      805         end.
      806         if num-entries( p-key-rec, chr(3) ) > 1
      807           or p-key-rec = ?
      808           or p-key-rec = "":U
      809         then do:
      810           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info10, p-key-rec ).
      811         end.
      812       end.
      813       else do:
      814         if p-key-rec = ?
      815           or p-key-rec = "":U
      816         then do:
      817           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info10 ).
      818         end.
      819       end.
      820       assign
      821         vTable = entry( 1 , p-key-rec, chr(3) )
      822       .
      823       if p-tt-handle <> ?
      824         and ( not valid-handle(p-tt-handle)
      825               or p-tt-handle:type <> "buffer"
      826             )
      827       then do:
      828         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info10, vTable, chr(10) ).
      829       end.
      830       if p-tt-handle = ? then do:
      831         assign
      832           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      833         .
      834         create buffer bh_tbl-name for table v-full-tbl-name .
      835       end.
      836       else do:
      837         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      838       end.
      839       assign
      840         v-inform = bh_tbl-name:index-information(1)
      841         v-ind    = 2
      842       .
      843       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      844       on error undo, return error
      845       :
      846         assign
      847           v-inform = bh_tbl-name:index-information( v-ind )
      848           v-ind    = v-ind + 1
      849         .
      850       end.
      851       if v-inform = ?
      852         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      853         or entry( 3, v-inform, ",":U ) <> "1":U
      854       then do:
      855         delete object bh_tbl-name no-error.
      856         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info10, vTable ).
      857       end.
      858       assign
      859         v-idx-field-qnty = num-entries( v-inform ) - 4
      860       .
      861       if v-idx-field-qnty < 2 then do:
      862         delete object bh_tbl-name no-error.
      863         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, vTable ).
      864       end.
      865       assign
      866         o-where     = "where":U
      867         v-word-link = "":U
      868         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      869         v-count-fld = 0
      870       .
      871       if i-tablekey ne "" and i-tablekey ne ?
      872       then do:
      873         assign
      874           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      875         .
      876         create buffer bh_tbl-key for table v-full-tbl-name .
      877       end.
      878       if i-tableSerach ne "" and i-tableSerach ne ?
      879       then do:
      880         delete object bh_tbl-name no-error.
      881         assign
      882           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      883         .
      884         create buffer bh_tbl-name for table v-full-tbl-name .
      885       end.
      886       block_where:
      887       do v-ind = 1 to v-idx-field-qnty by 2
      888       on error undo, return error
      889       :
      890         assign
      891           v-count-fld = v-count-fld + 1
      892         .
      893         if p-key-handle = ?
      894           and v-count-fld > v-field-num
      895         then do:
      896           leave block_where.
      897         end.
      898         define variable VfieldKeyTable as handle no-undo.
      899         assign
      900           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      901           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      902         .
      903         if     bh_tbl-key ne ?
      904         then do:
      905            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      906            if VfieldKeyTable eq ?
      907            then next block_where.
      908         end.
      909         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      910         then
      911            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      912         else
      913            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      914         if p-key-handle = ? then do:
      915           assign
      916             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      917           .
      918         end.
      919         else do:
      920           assign
      921             fh_key = p-key-handle:buffer-field( v-field-name )
      922           .
      923           if fh_key = ?
      924             or not valid-handle( fh_key )
      925           then do:
      926             delete object bh_tbl-name.
      927             if     bh_tbl-key ne ?
      928             then
      929                delete object bh_tbl-key.
      930             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info10, p-key-handle:name, v-field-name ).
      931           end.
      932           assign
      933             v-field-val = fh_key:buffer-value
      934           .
      935         end.
      936         if fh_search:data-type ="character":U then do:
      937           assign
      938             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      939             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      940             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      941             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      942             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      943             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      944             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      945             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      946             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      947             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      948             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      949             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      950             v-field-val = substitute( '"&1"', v-field-val )
      951           .
      952         end.
      953         assign
      954           o-where = substitute( "&1 &2", o-where, v-field-val )
      955         .
      956         if v-word-link = "":U then do:
      957           assign
      958             v-word-link = "and":U
      959           .
      960         end.
      961       end.
      962       delete object bh_tbl-name.
      963       if     bh_tbl-key ne ?
      964       then
      965          delete object bh_tbl-key.
      966       if p-key-handle = ?
      967         and v-count-fld <> v-field-num
      968       then do:
      969         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info10, vTable ).
      970       end.
      971     end.
      972   end procedure.
      973   procedure gen-hn-keyr-tab :
      974     define input  parameter i-tableSerach as character no-undo.
      975     define input  parameter i-tablekey   as character no-undo.
      976     define input  parameter p-key-rec    as character no-undo.
      977     define input  parameter p-key-handle as handle    no-undo .
      978     define input  parameter p-db-name    as character no-undo .
      979     define input  parameter p-tt-handle  as handle    no-undo .
      980     define input  parameter p-stts-lock  as integer   no-undo .
      981     define output parameter o-hn         as handle    no-undo.
      982     define variable v-full-tbl-name as character no-undo.
      983     define variable v-where         as character no-undo.
      984     define variable bh_tbl-name     as handle    no-undo.
      985     define variable vTable          as character no-undo.
      986     do
      987     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      988     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      989     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      990         run gen-where-keyr-tab(i-tableSerach,
      991                                i-tablekey,
      992                                p-key-rec,
      993                                p-key-handle,
      994                                p-db-name,
      995                                p-tt-handle,
      996                                output v-where).
      997         if i-tableSerach ne "" and i-tableSerach ne ?
      998         then do:
      999            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1000            create buffer bh_tbl-name for table v-full-tbl-name .
     1001         end.
     1002         else do:
     1003            if p-tt-handle = ? then do:
     1004               assign
     1005                  vTable = entry( 1 , p-key-rec, chr(3) )
     1006               .
     1007               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1008               create buffer bh_tbl-name for table v-full-tbl-name .
     1009            end.
     1010            else do:
     1011               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1012            end.
     1013         end.
     1014         if p-tt-handle = ? then do:
     1015            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1016         end.
     1017         else do:
     1018            bh_tbl-name:find-first( v-where ) no-error .
     1019         end.
     1020         o-hn = bh_tbl-name.
     1021      end.
     1022   end procedure.
     1023   procedure gen-hn-keyr :
     1024     define input  parameter p-key-rec    as character no-undo.
     1025     define input  parameter p-key-handle as handle    no-undo .
     1026     define input  parameter p-db-name    as character no-undo .
     1027     define input  parameter p-tt-handle  as handle    no-undo .
     1028     define input  parameter p-stts-lock  as integer   no-undo .
     1029     define output parameter o-hn         as handle    no-undo.
     1030     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1031   end.
     1032   procedure gen-row-keyr :
     1033     define input  parameter p-key-rec    as character no-undo.
     1034     define input  parameter p-key-handle as handle    no-undo .
     1035     define input  parameter p-db-name    as character no-undo .
     1036     define input  parameter p-tt-handle  as handle    no-undo .
     1037     define input  parameter p-stts-lock  as integer   no-undo .
     1038     define output parameter p-tbl-row    as rowid     no-undo.
     1039     define output parameter p-tbl-name   as character no-undo.
     1040     define variable vHn as handle no-undo.
     1041       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1042       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1043       p-tbl-name =  vHn:table.
     1044       delete object vHn no-error.
     1045     if p-tbl-row = ? then do:
     1046       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info10, p-tbl-name, p-key-rec ).
     1047     end.
     1048     else do:
     1049       return.
     1050     end.
     1051   end procedure.
     1052   procedure gen-key-fv :
     1053     define input  parameter p-key-rec    as character no-undo .
     1054     define output parameter p-field-list as character no-undo .
     1055     define output parameter p-value-list as character no-undo.
     1056     do
     1057     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1058     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1059     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1060     :
     1061       define variable v-full-tbl-name  as character no-undo .
     1062       define variable bh_tbl-name      as handle    no-undo .
     1063       define variable v-tbl-name       as character no-undo .
     1064       define variable v-field-num      as integer   no-undo .
     1065       define variable v-count-fld      as integer   no-undo .
     1066       define variable v-inform         as character no-undo .
     1067       define variable v-ind            as integer   no-undo .
     1068       define variable v-idx-field-qnty as integer   no-undo .
     1069       define variable v-delim-key      as character no-undo .
     1070       if p-key-rec = ?
     1071         or p-key-rec = "":U
     1072       then do:
     1073         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info10 ).
     1074       end.
     1075       assign
     1076         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1077         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1078       .
     1079       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1080       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info10 ).
     1081       assign
     1082         v-inform = bh_tbl-name:index-information(1)
     1083         v-ind    = 2
     1084       .
     1085       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1086       on error undo, return error
     1087       :
     1088         assign
     1089           v-inform = bh_tbl-name:index-information( v-ind )
     1090           v-ind    = v-ind + 1
     1091         .
     1092       end.
     1093       if v-inform = ?
     1094         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1095         or entry( 3, v-inform, ",":U ) <> "1":U
     1096       then do:
     1097         delete object bh_tbl-name no-error.
     1098         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, v-tbl-name ).
     1099       end.
     1100       assign
     1101         v-idx-field-qnty = num-entries( v-inform ) - 4
     1102       .
     1103       if v-idx-field-qnty < 2 then do:
     1104         delete object bh_tbl-name no-error.
     1105         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, v-tbl-name ).
     1106       end.
     1107       assign
     1108         p-field-list = "":U
     1109         p-value-list = "":U
     1110         v-delim-key  = "":U
     1111         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1112         v-count-fld  = 0
     1113       .
     1114       block_where:
     1115       do v-ind = 1 to v-idx-field-qnty by 2
     1116       on error undo, return error
     1117       :
     1118         assign
     1119           v-count-fld = v-count-fld + 1
     1120         .
     1121         if v-count-fld > v-field-num then do:
     1122           leave block_where.
     1123         end.
     1124         assign
     1125           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1126           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1127         .
     1128         if v-ind = 1 then do:
     1129           assign
     1130             v-delim-key = chr(3)
     1131           .
     1132         end.
     1133       end.
     1134       delete object bh_tbl-name.
     1135       if v-count-fld <> v-field-num then do:
     1136         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info10, v-tbl-name ).
     1137       end.
     1138     end.
     1139   end procedure.
     1140   procedure gen-key-field :
     1141     define input  parameter p-table      as character no-undo .
     1142     define output parameter p-field-list as character no-undo .
     1143     do
     1144     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1145     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1146     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1147     :
     1148       define variable v-full-tbl-name  as character no-undo .
     1149       define variable bh_tbl-name      as handle    no-undo .
     1150       define variable v-tbl-name       as character no-undo .
     1151       define variable v-field-num      as integer   no-undo .
     1152       define variable v-count-fld      as integer   no-undo .
     1153       define variable v-inform         as character no-undo .
     1154       define variable v-ind            as integer   no-undo .
     1155       define variable v-idx-field-qnty as integer   no-undo .
     1156       define variable v-delim-key      as character no-undo .
     1157       if p-table = ?
     1158         or p-table = "":U
     1159       then do:
     1160         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info10 ).
     1161       end.
     1162       assign
     1163         v-tbl-name      = p-table
     1164         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1165       .
     1166       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1167       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info10 ).
     1168       assign
     1169         v-inform = bh_tbl-name:index-information(1)
     1170         v-ind    = 2
     1171       .
     1172       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1173       on error undo, return error
     1174       :
     1175         assign
     1176           v-inform = bh_tbl-name:index-information( v-ind )
     1177           v-ind    = v-ind + 1
     1178         .
     1179       end.
     1180       if v-inform = ?
     1181         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1182         or entry( 3, v-inform, ",":U ) <> "1":U
     1183       then do:
     1184         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, v-tbl-name ).
     1185       end.
     1186       assign
     1187         v-idx-field-qnty = num-entries( v-inform ) - 4
     1188       .
     1189       if v-idx-field-qnty < 2 then do:
     1190         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, v-tbl-name ).
     1191       end.
     1192       assign
     1193         p-field-list = "":U
     1194         v-delim-key  = "":U
     1195         v-count-fld  = 0
     1196       .
     1197       block_where:
     1198       do v-ind = 1 to v-idx-field-qnty by 2
     1199       on error undo, return error
     1200       :
     1201         assign
     1202           v-count-fld = v-count-fld + 1
     1203         .
     1204         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1205         if v-ind = 1 then do:
     1206           assign
     1207             v-delim-key = chr(3)
     1208           .
     1209         end.
     1210       end.
     1211       delete object bh_tbl-name.
     1212     end.
     1213   end procedure.
     1214   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1215   define new global shared variable g#lib-nws as handle no-undo .
     1216   procedure disproph_write-dis-card-property-proc  :
     1217   define parameter buffer buf_dis-card-property for ub.dis-card-property .
     1218   define parameter buffer buf_dis-card for ub.dis-card.
     1219   define input parameter p-d-card      like ub.dis-card-property.d-card no-undo .
     1220   define input parameter p-dt-code      like ub.dis-card-property.dt-code no-undo .
     1221   define input parameter p-host-code   like ub.dis-card-property.host-code no-undo .
     1222   define input parameter p-obj-type    like ub.dis-card-property.obj-type no-undo .
     1223   define input parameter p-obj-code    like ub.dis-card-property.obj-code no-undo .
     1224   define input parameter p-dtm-code    like ub.dis-card-property.dtm-code no-undo .
     1225   define input parameter p-card-num    like ub.dis-card-property.card-num  no-undo .
     1226   define input parameter p-main-card   like ub.dis-card-property.main-card  no-undo .
     1227   define input parameter p-first-card  like ub.dis-card-property.first-card  no-undo .
     1228   define input parameter p-first-main-card  like ub.dis-card-property.first-main-card  no-undo .
     1229   define input parameter p-node-code   like ub.dis-card-property.node-code no-undo .
     1230   define input parameter p-action      as integer no-undo .
     1231   define input parameter p-source-type like ub.c-dc-hist.source-type no-undo .
     1232   define input parameter p-source-ref  like ub.c-dc-hist.source-ref no-undo .
     1233   define input-output parameter p-chip-num as integer no-undo .
     1234   define input-output parameter p-corr-date as date no-undo .
     1235   define input-output parameter p-corr-time as integer no-undo .
     1236   define variable v-date as date      no-undo.
     1237   define variable v-time  as integer   no-undo.
     1238   define variable v-uniq-key-rec as character no-undo .
     1239   define variable v-send as integer no-undo .
     1240   define buffer buf_c-dc-hist for ub.c-dc-hist.
     1241   define buffer buf_c-dis-card-property for ub.c-dis-card-property.
     1242     main-block:
     1243     do
     1244     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1245     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1246     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1247     :
     1248       if not available buf_dis-card-property and not p-action = integer('1':U) then do:
     1249         message
     1250           vss-workfile vss-revision vss-description skip
     1251           "Ошибка задания входных параметров" skip
     1252           "Не определена запись СВОЙСТВА ДК" skip
     1253           view-as alert-box error .
     1254         undo, return error .
     1255       end.
     1256     v-send = integer('0':U).
     1257     if not p-action = integer('1':U) then do:
     1258       if available buf_dis-card then do:
     1259         if g#news then do:
     1260   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1261   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
     1262     (input  g#db-num
     1263     ,input  'dis-card-property':U
     1264     ,input  0
     1265     ,input  '':U
     1266     ,input  0
     1267     ,input  buf_dis-card.type
     1268     ,input  '':U
     1269     ,input  '':U
     1270     ,input  buf_dis-card.emitent-host-code
     1271     ,input  (if buf_Dis-card-property.dt-code > 0 then 0 else -1)
     1272     ,input  0
     1273     ,input  'nws-to-hist'
     1274     ,output v-send
     1275     ) no-error .
     1276         end.
     1277         else do:
     1278   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1279   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
     1280     (input  g#db-num
     1281     ,input  'dis-card-property':U
     1282     ,input  0
     1283     ,input  '':U
     1284     ,input  0
     1285     ,input  buf_dis-card.type
     1286     ,input  '':U
     1287     ,input  '':U
     1288     ,input  buf_dis-card.emitent-host-code
     1289     ,input  (if buf_Dis-card-property.dt-code > 0 then 0 else -1)
     1290     ,input  0
     1291     ,input  'hist-from-prim'
     1292     ,output v-send
     1293     ) no-error .
     1294         end.
     1295       end.
     1296     end.
     1297     if v-send >= 0 then do:
     1298       run cur-time in this-procedure(output v-date, output v-time).
     1299       if p-action = integer('1':U) then do:
     1300         create buf_c-dis-card-property.
     1301         assign
     1302         buf_c-dis-card-property.d-card            = p-d-card
     1303         buf_c-dis-card-property.card-num          = p-card-num
     1304         buf_c-dis-card-property.host-code         = p-host-code
     1305         buf_c-dis-card-property.obj-type          = p-obj-type
     1306         buf_c-dis-card-property.obj-code          = p-obj-code
     1307         buf_c-dis-card-property.dt-code           = p-dt-code
     1308         buf_c-dis-card-property.node-code         = p-node-code
     1309         buf_c-dis-card-property.dtm-code         = p-dtm-code
     1310         buf_c-dis-card-property.main-card         = p-main-card
     1311         buf_c-dis-card-property.first-main-card   = p-first-main-card
     1312         buf_c-dis-card-property.first-card        = p-first-card
     1313         buf_c-dis-card-property.chip-num          = (if p-chip-num = 0
     1314                                                      then next-value (s-dc-chip, ub)
     1315                                                      else p-chip-num)
     1316         buf_c-dis-card-property.corr-time         = (if p-corr-time = ?
     1317                                                      then v-time
     1318                                                      else p-corr-time)
     1319         buf_c-dis-card-property.corr-user-db-num  = g#db-num
     1320         buf_c-dis-card-property.corr-user-name    = if g#news then (chr(4) +  'СПН':U) else g#userid
     1321         buf_c-dis-card-property.corr-date         = (if p-corr-date = ?
     1322                                                      then v-date
     1323                                                      else p-corr-date)
     1324         .
     1325       end.
     1326       else do:
     1327         create buf_c-dis-card-property.
     1328         buffer-copy buf_dis-card-property to buf_c-dis-card-property
     1329         assign
     1330         buf_c-dis-card-property.d-card             = buf_dis-card-property.d-card
     1331         buf_c-dis-card-property.card-num           = buf_dis-card-property.card-num
     1332         buf_c-dis-card-property.dt-code             = buf_dis-card-property.dt-code
     1333         buf_c-dis-card-property.main-card          = buf_dis-card-property.main-card
     1334         buf_c-dis-card-property.first-main-card    = buf_dis-card-property.first-main-card
     1335         buf_c-dis-card-property.first-card         = buf_dis-card-property.first-card
     1336         buf_c-dis-card-property.host-code          = buf_dis-card-property.host-code
     1337         buf_c-dis-card-property.obj-type          = p-obj-type
     1338         buf_c-dis-card-property.obj-code          = p-obj-code
     1339         buf_c-dis-card-property.node-code         = p-node-code
     1340         buf_c-dis-card-property.dtm-code         = p-dtm-code
     1341         buf_c-dis-card-property.chip-num           = (if p-chip-num = 0
     1342                                                       then next-value (s-dc-chip, ub)
     1343                                                       else p-chip-num)
     1344         buf_c-dis-card-property.corr-time          = (if p-corr-time = ?
     1345                                                       then v-time
     1346                                                       else p-corr-time)
     1347         buf_c-dis-card-property.corr-user-db-num   = g#db-num
     1348               buf_c-dis-card-property.corr-user-name    = (if g#news
     1349                                                      then (chr(4) +  'СПН':U)
     1350                                                      else (if g#esys
     1351                                                            then (chr(4) +  'ВС':U)
     1352                                                            else g#userid
     1353                                                            )
     1354                                                      )
     1355         buf_c-dis-card-property.corr-date          = (if p-corr-date = ?
     1356                                                       then v-date
     1357                                                       else p-corr-date)
     1358         .
     1359         run gen-key-rec in this-procedure (
     1360                                             input 'dis-card-property':U
     1361                                           ,input buffer buf_dis-card-property:handle
     1362                                           ,output v-uniq-key-rec).
     1363       end.
     1364       if p-chip-num = 0   then do:
     1365         create buf_c-dc-hist.
     1366         buffer-copy buf_c-dis-card-property to buf_c-dc-hist
     1367         assign
     1368         buf_c-dc-hist.action =  p-action
     1369         buf_c-dc-hist.subject = 'dis-card-property':U
     1370         buf_c-dc-hist.is-news = g#news
     1371         buf_c-dc-hist.source-type = p-source-type
     1372         buf_c-dc-hist.source-ref = p-source-ref
     1373         buf_c-dc-hist.uniq-key-rec = v-uniq-key-rec
     1374         .
     1375       end.
     1376       assign
     1377       p-chip-num = buf_c-dis-card-property.chip-num
     1378       p-corr-date = buf_c-dis-card-property.corr-date
     1379       p-corr-time = buf_c-dis-card-property.corr-time
     1380       .
     1381       run disproph_send-nws in this-procedure (
     1382                                                 buffer buf_c-dis-card-property
     1383                                                ,buffer buf_c-dc-hist
     1384                                                ,buffer buf_dis-card
     1385                                                 ).
     1386       end.
     1387     end.
     1388   end procedure.
     1389   procedure disproph_send-nws :
     1390   define parameter buffer buf_c-dis-card-property for ub.c-dis-card-property.
     1391   define parameter buffer buf_c-dc-hist for ub.c-dc-hist.
     1392   define parameter buffer buf_Dis-card for ub.dis-card.
     1393   define variable v-dh-hn as integer no-undo .
     1394   main-block:
     1395   do
     1396   on error undo, return error return-value
     1397   :
     1398     if g#news
     1399     and g#db-num > 0
     1400     and buf_c-dis-card-property.corr-user-db-num <> g#db-num
     1401     then return.
     1402     if g#db-num = 0
     1403     or (g#news
     1404         and g#db-num > 0
     1405         and buf_c-dis-card-property.corr-user-name = (chr(4) +  'СПН':U)
     1406         )
     1407     then do:
     1408       if not available buf_dis-card then do:
     1409         find first buf_dis-card no-lock where
     1410                   buf_Dis-card.d-card = buf_c-dis-card-property.d-card no-error.
     1411       end.
     1412       if not available buf_dis-card then do:
     1413         assign
     1414         v-dh-hn = integer('0':U).
     1415       end.
     1416       else do:
     1417   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1418   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
     1419     (input  g#db-num
     1420     ,input  'dis-card-property':U
     1421     ,input  0
     1422     ,input  '':U
     1423     ,input  0
     1424     ,input  buf_dis-card.type
     1425     ,input  '':U
     1426     ,input  '':U
     1427     ,input  buf_dis-card.emitent-host-code
     1428     ,input  (if buf_c-dis-card-property.dt-code > 0 then 0 else -1)
     1429     ,input  0
     1430     ,input  'hist-to-nws'
     1431     ,output v-dh-hn
     1432     ) no-error .
     1433       end.
     1434       if v-dh-hn >= 0 then do:
     1435         run str/callnews.p (
     1436           input 'c-dis-card-property':U
     1437           ,input (buffer buf_c-dis-card-property:handle)
     1438           ) no-error .
     1439         if error-status:error then do:
     1440           undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
     1441         end.
     1442         if available buf_c-dc-hist then do:
     1443           run str/callnews.p (
     1444             input 'c-dc-hist':U
     1445             ,input (buffer buf_c-dc-hist:handle)
     1446             ) no-error .
     1447           if error-status:error then do:
     1448             undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
     1449           end.
     1450         end.
     1451       end.
     1452     end.
     1453   end.
     1454   end procedure.
     1455   procedure discprop-node-code :
     1456   define input parameter p-dtm-code as integer no-undo .
     1457   define input parameter p-node-code as integer no-undo .
     1458   define output parameter p-data-type as character no-undo .
     1459   define output parameter p-format as character no-undo .
     1460   define output parameter p-label as character no-undo .
     1461   define output parameter p-range as integer no-undo .
     1462   define output parameter p-rw-option as character no-undo .
     1463   define buffer buf_prop-map for ub.prop-map.
     1464   define buffer buf_prop-head for ub.prop-head.
     1465   do
     1466   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1467   :
     1468   find first buf_prop-head no-lock where
     1469             buf_prop-head.dtm-code = p-dtm-code no-error .
     1470   if available buf_prop-head then do:
     1471     if p-node-code > 0 then do:
     1472       find first buf_prop-map no-lock where
     1473                 buf_prop-map.dtm-code = p-dtm-code
     1474             and buf_prop-map.node-code = p-node-code no-error .
     1475       if available buf_prop-map then do:
     1476         assign
     1477         p-data-type = buf_prop-map.node-value-type
     1478         p-format = buf_prop-map.node-format
     1479         p-label = buf_prop-map.node-label
     1480         p-rw-option = buf_prop-map.rw-option
     1481         .
     1482       end.
     1483     end.
     1484     if buf_prop-head.storage-place  = "":U
     1485     and buf_prop-head.storage-place-host  > "":U
     1486     and buf_prop-head.storage-place-obj  > "":U then do:
     1487       p-range =  12.
     1488     end.
     1489     if buf_prop-head.storage-place  > "":U
     1490     and buf_prop-head.storage-place-host  > "":U
     1491     and buf_prop-head.storage-place-obj  > "":U then do:
     1492       p-range =  3.
     1493     end.
     1494     if buf_prop-head.storage-place  > "":U
     1495     and buf_prop-head.storage-place-host  > "":U
     1496     and buf_prop-head.storage-place-obj  = "":U then do:
     1497       p-range =  2.
     1498     end.
     1499     if buf_prop-head.storage-place  = "":U
     1500     and buf_prop-head.storage-place-host  > "":U
     1501     and buf_prop-head.storage-place-obj  = "":U then do:
     1502       p-range =  1.
     1503     end.
     1504     if buf_prop-head.storage-place  > "":U
     1505     and buf_prop-head.storage-place-host  = "":U
     1506     and buf_prop-head.storage-place-obj  = "":U then do:
     1507       p-range =  0.
     1508     end.
     1509   end.
     1510   end.
     1511   end procedure.
     1512   procedure discprop-initial:
     1513   define input parameter p-dtm-code as integer no-undo .
     1514   define input parameter p-node-code as integer no-undo .
     1515   define output parameter p-init-value-character as character no-undo .
     1516   define output parameter p-init-value-date as date no-undo .
     1517   define output parameter p-init-value-decimal as decimal no-undo .
     1518   define output parameter p-init-value-integer as integer no-undo .
     1519   define output parameter p-init-value-logical as logical no-undo .
     1520   define buffer buf_prop-map for ub.prop-map.
     1521   find first buf_prop-map no-lock where
     1522             buf_prop-map.dtm-code = p-dtm-code
     1523         and buf_prop-map.node-code = p-node-code no-error.
     1524   if not available buf_prop-map then return error substitute("Не найдено свойство &1 для объекта &2"
     1525                                                               , p-node-code
     1526                                                               , p-dtm-code).
     1527   assign
     1528   p-init-value-character = buf_prop-map.init-value-character
     1529   p-init-value-date = buf_prop-map.init-value-date
     1530   p-init-value-decimal = buf_prop-map.init-value-decimal
     1531   p-init-value-integer = buf_prop-map.init-value-integer
     1532   p-init-value-logical = buf_prop-map.init-value-logical
     1533   .
     1534   end procedure.
     1535   Function discprop-usercanedit returns logical (  input p-dtm-code as integer, input p-db-num as integer):
     1536   define buffer buf_attr-prop for ub.attr-prop.
     1537   find first buf_attr-prop no-lock where
     1538             buf_attr-prop.table-name = 'dis-card-property':U
     1539         and buf_attr-prop.templ-rl-root = p-dtm-code
     1540         and buf_attr-prop.upper-prop-code = "UserCanEdit"
     1541         and buf_attr-prop.prop-code = (if p-db-num = 0 then 'DB0' else 'DBR':U) no-error.
     1542   if not available buf_attr-prop
     1543   or logical(buf_attr-prop.property-value) = no then do:
     1544     return no.
     1545   end.
     1546   return yes.
     1547   end function.
     1548   procedure discprop-edit :
     1549   define input parameter p-dtm-code-node-name as character no-undo .
     1550   define output parameter p-edit-menu-section-num as integer no-undo .
     1551   define buffer buf_attr-prop for ub.attr-prop.
     1552   do
     1553   on error undo, return error return-value
     1554   :
     1555     find first buf_attr-prop no-lock where
     1556             buf_attr-prop.table-name = 'dis-card-property':U
     1557        and  buf_attr-prop.templ-rl-root = integer(entry(1, p-dtm-code-node-name, chr(4)))
     1558        and  buf_attr-prop.upper-prop-code = "ManualEdit":U
     1559        and  buf_attr-prop.prop-code = "SectionNum":U no-error .
     1560     if available buf_attr-prop then do:
     1561       assign
     1562       p-edit-menu-section-num = integer(buf_attr-prop.property-value).
     1563     end.
     1564   end.
     1565   end procedure.
     1566   procedure discprop-node-name :
     1567   define input parameter p-dtm-code-node-name as character no-undo .
     1568   define output parameter p-tool-tip as character no-undo .
     1569   define output parameter p-node-label as character no-undo .
     1570   define buffer buf_prop-map for ub.prop-map.
     1571   define buffer buf_prop-head for ub.prop-head.
     1572   do
     1573   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1574   :
     1575     find first buf_prop-head no-lock where
     1576               buf_prop-head.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) )) no-error .
     1577     assign
     1578     p-tool-tip   = if available buf_prop-head
     1579                    then buf_prop-head.prop-des
     1580                    else entry(1, p-dtm-code-node-name, chr(4) )
     1581     p-node-label = (if available buf_prop-head
     1582                     then buf_prop-head.prop-label
     1583                     else '':U)
     1584     .
     1585     if entry(2, p-dtm-code-node-name, chr(4) ) <> "" then do:
     1586       find first buf_prop-map no-lock where
     1587                 buf_prop-map.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) ))
     1588           and  buf_prop-map.node-code = integer(entry(2, p-dtm-code-node-name, chr(4) )) no-error.
     1589       if available buf_prop-map then do:
     1590         assign
     1591         p-tool-tip   = buf_prop-map.node-description
     1592         p-node-label = (if available buf_prop-head
     1593                         then buf_prop-head.prop-label
     1594                         else '':U) + ":" + buf_prop-map.node-label
     1595         .
     1596       end.
     1597     end.
     1598   end.
     1599   end procedure.
     1600   procedure discprop-write :
     1601   define input parameter p-d-card          like ub.dis-card-property.d-card     no-undo .
     1602   define input parameter p-host-code       like ub.dis-card-property.host-code  no-undo .
     1603   define input parameter p-obj-type        like ub.dis-card-property.obj-type   no-undo .
     1604   define input parameter p-obj-code        like ub.dis-card-property.obj-code   no-undo .
     1605   define input parameter p-dtm-code        like ub.dis-card-property.dtm-code   no-undo .
     1606   define input parameter p-node-code       like ub.dis-card-property.node-code  no-undo .
     1607   define input parameter p-dt-code         like ub.dis-card-property.dt-code    no-undo .
     1608   define input parameter p-sum-id          like ub.dis-card-property.sum-id     no-undo .
     1609   define input parameter p-value-character like ub.dis-card-property.property-value-character no-undo .
     1610   define input parameter p-value-date      like ub.dis-card-property.property-value-date no-undo .
     1611   define input parameter p-value-decimal   like ub.dis-card-property.property-value-decimal no-undo .
     1612   define input parameter p-value-integer   like ub.dis-card-property.property-value-integer no-undo .
     1613   define input parameter p-value-logical   like ub.dis-card-property.property-value-logical no-undo .
     1614   define input parameter p-source-type     as character no-undo .
     1615   define input parameter p-source-ref      as character no-undo .
     1616   define input-output parameter p-chip-num as integer no-undo .
     1617   define input-output parameter p-corr-date as date no-undo .
     1618   define input-output parameter p-corr-time as integer no-undo .
     1619   do
     1620   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1621   :
     1622     define buffer buf_dis-card-property for ub.dis-card-property .
     1623     define buffer buf_dis-card for ub.dis-card.
     1624     define buffer buf_prop-ref for ub.prop-ref.
     1625     define variable v-data-type      as character no-undo .
     1626     define variable v-data-type-1    as character no-undo .
     1627     define variable v-format         as character no-undo .
     1628     define variable v-label          as character no-undo .
     1629     define variable v-range          as integer   no-undo .
     1630     define variable v-rw-option      as character no-undo .
     1631     run discprop-node-code in this-procedure
     1632       (
     1633        input  p-dtm-code
     1634       ,input  p-node-code
     1635       ,output v-data-type
     1636       ,output v-format
     1637       ,output v-label
     1638       ,output v-range
     1639       ,output v-rw-option
     1640       ) no-error .
     1641     if error-status :error then do:
     1642       undo, return error return-value .
     1643     end.
     1644     v-data-type-1 = entry(1, v-data-type).
     1645     if p-dt-code = ? then do:
     1646       find buf_prop-ref no-lock where
     1647           buf_prop-ref.dtm-code = p-dtm-code
     1648       and buf_prop-ref.sum-id = p-sum-id no-error.
     1649       if not available buf_prop-ref then do:
     1650         undo, return error substitute("Неопределен или неоднозначен ИТОГ/СРЕЗ для объекта-операнда &1 &2"
     1651                                       ,p-dtm-code
     1652                                       ,p-sum-id).
     1653       end.
     1654       assign
     1655       p-dt-code = buf_prop-ref.dt-code.
     1656     end.
     1657     if discprop-usercanedit ( input p-dtm-code, input g#db-num)  = no then do:
     1658       undo, return error "Нельзя редактировать свойство в данной БД".
     1659     end.
     1660     run discprop-check in this-procedure (
     1661                                             input v-range
     1662                                           ,input p-d-card
     1663                                           ,input p-host-code
     1664                                           ,input p-obj-type
     1665                                           ,input p-obj-code
     1666                                           ,input p-dtm-code
     1667                                           ,input p-node-code
     1668                                           ,input p-dt-code
     1669                                         ) no-error .
     1670     if error-status:error then undo,  return error return-value .
     1671     find first buf_dis-card-property exclusive-lock
     1672       where buf_dis-card-property.d-card    = p-d-card
     1673         and buf_dis-card-property.host-code = p-host-code
     1674         and buf_dis-card-property.obj-type  = p-obj-type
     1675         and buf_dis-card-property.obj-code  = p-obj-code
     1676         and buf_dis-card-property.dt-code = p-dt-code
     1677         and buf_dis-card-property.node-code = p-node-code
     1678       no-error .
     1679       find first buf_dis-card no-lock where
     1680                   buf_dis-card.d-card = p-d-card.
     1681     if not available buf_dis-card-property then do:
     1682       create buf_dis-card-property .
     1683       assign
     1684         buf_dis-card-property.d-card    = p-d-card
     1685         buf_dis-card-property.host-code = p-host-code
     1686         buf_dis-card-property.obj-type  = p-obj-type
     1687         buf_dis-card-property.obj-code  = p-obj-code
     1688         buf_dis-card-property.dt-code = p-dt-code
     1689         buf_dis-card-property.node-code = p-node-code
     1690         buf_dis-card-property.dtm-code = p-dtm-code
     1691         buf_dis-card-property.sum-id   = p-sum-id
     1692         buf_dis-card-property.card-num  = buf_dis-card.card-num
     1693         buf_dis-card-property.main-card  = buf_dis-card.main-card
     1694         buf_dis-card-property.first-card  = buf_dis-card.first-card
     1695         buf_dis-card-property.first-main-card  = buf_dis-card.first-main-card
     1696       .
     1697     end.
     1698     else do:
     1699       if (v-data-type-1 = 'character':U
     1700       and buf_dis-card-property.property-value-character = p-value-character)
     1701       or  (v-data-type-1 = 'date':U
     1702           and buf_dis-card-property.property-value-date = p-value-date)
     1703       or  (v-data-type-1 = 'decimal':U
     1704           and buf_dis-card-property.property-value-decimal = p-value-decimal)
     1705       or  (v-data-type-1 = 'integer':U
     1706           and buf_dis-card-property.property-value-integer = p-value-integer)
     1707       or  (v-data-type-1 = 'logical':U
     1708           and buf_dis-card-property.property-value-logical = p-value-logical)
     1709       then return.
     1710     end.
     1711     run disproph_write-dis-card-property-proc  in this-procedure (
     1712             buffer buf_dis-card-property
     1713             ,buffer Buf_dis-card
     1714             ,input p-d-card
     1715             ,input p-dt-code
     1716             ,input p-host-code
     1717             ,input p-obj-type
     1718             ,input p-obj-code
     1719             ,input p-dtm-code
     1720             ,input buf_dis-card.card-num
     1721             ,input buf_dis-card.main-card
     1722             ,input buf_dis-card.first-card
     1723             ,input buf_dis-card.first-main-card
     1724             ,input p-node-code
     1725             ,input (if new(buf_dis-card-property) then integer('1':U) else integer('2':U))
     1726             ,input p-source-type
     1727             ,input p-source-ref
     1728             ,input-output p-chip-num
     1729             ,input-output p-corr-date
     1730             ,input-output p-corr-time
     1731             ).
     1732     assign
     1733     buf_dis-card-property.property-value-character = (if v-data-type-1 = 'character':U
     1734                                                       then p-value-character
     1735                                                       else buf_dis-card-property.property-value-character)
     1736     buf_dis-card-property.property-value-date      = (if v-data-type-1 = 'date':U
     1737                                                       then p-value-date
     1738                                                       else buf_dis-card-property.property-value-date)
     1739     buf_dis-card-property.property-value-decimal   = (if v-data-type-1 = 'decimal':U
     1740                                                       then p-value-decimal
     1741                                                       else buf_dis-card-property.property-value-decimal)
     1742     buf_dis-card-property.property-value-integer   = (if v-data-type-1 = 'integer':U
     1743                                                       then p-value-integer
     1744                                                       else buf_dis-card-property.property-value-integer)
     1745     buf_dis-card-property.property-value-logical   = (if v-data-type-1 = 'logical':U
     1746                                                       then p-value-logical
     1747                                                       else buf_dis-card-property.property-value-logical)
     1748     buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U)
     1749     .
     1750     release buf_dis-card-property no-error .
     1751     if error-status:error then do:
     1752       return error return-value .
     1753     end.
     1754   end.
     1755   end procedure.
     1756   procedure discprop-delete :
     1757   define input parameter p-d-card    like ub.dis-card-property.d-card     no-undo .
     1758   define input parameter p-host-code like ub.dis-card-property.host-code  no-undo .
     1759   define input parameter p-obj-type  like ub.dis-card-property.obj-type   no-undo .
     1760   define input parameter p-obj-code  like ub.dis-card-property.obj-code   no-undo .
     1761   define input parameter p-dtm-code  like ub.dis-card-property.dtm-code   no-undo .
     1762   define input parameter p-node-code like ub.dis-card-property.node-code  no-undo .
     1763   define input parameter p-dt-code   like ub.dis-card-property.dt-code    no-undo .
     1764   define input parameter p-source-type as character no-undo .
     1765   define input parameter p-source-ref as character no-undo .
     1766   define output parameter p-deleted  as logical no-undo.
     1767   define input-output parameter p-chip-num as integer no-undo .
     1768   define input-output parameter p-corr-date as date no-undo .
     1769   define input-output parameter p-corr-time as integer no-undo .
     1770   do
     1771   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1772   :
     1773   define buffer buf_dis-card-property for ub.dis-card-property .
     1774   define buffer buf_dis-card for ub.dis-card.
     1775   define variable v-data-type      as character no-undo .
     1776   define variable v-format         as character no-undo .
     1777   define variable v-label          as character no-undo .
     1778   define variable v-range          as integer   no-undo .
     1779   define variable v-rw-option      as character   no-undo .
     1780     run discprop-node-code in this-procedure
     1781       (input  p-dtm-code
     1782       ,input  p-node-code
     1783       ,output v-data-type
     1784       ,output v-format
     1785       ,output v-label
     1786       ,output v-range
     1787       ,output v-rw-option
     1788       ) no-error .
     1789     if error-status :error then do:
     1790       undo, return error return-value .
     1791     end.
     1792     find first buf_dis-card-property exclusive-lock
     1793       where buf_dis-card-property.d-card    = p-d-card
     1794         and buf_dis-card-property.host-code = p-host-code
     1795         and buf_dis-card-property.obj-type  = p-obj-type
     1796         and buf_dis-card-property.obj-code  = p-obj-code
     1797         and buf_dis-card-property.dt-code = p-dt-code
     1798         and buf_dis-card-property.node-code = p-node-code
     1799       no-error NO-WAIT.
     1800     if not available buf_dis-card-property then do:
     1801       p-deleted = no.
     1802     end.
     1803     else do:
     1804       run disproph_write-dis-card-property-proc  in this-procedure (
     1805            buffer buf_dis-card-property
     1806           ,buffer buf_dis-card
     1807           ,input buf_dis-card-property.d-card
     1808           ,input buf_dis-card-property.dt-code
     1809           ,input buf_dis-card-property.host-code
     1810           ,input buf_dis-card-property.obj-type
     1811           ,input buf_dis-card-property.obj-code
     1812           ,input buf_dis-card-property.dtm-code
     1813           ,input buf_dis-card-property.card-num
     1814           ,input buf_dis-card-property.main-card
     1815           ,input buf_dis-card-property.first-card
     1816           ,input buf_dis-card-property.first-main-card
     1817           ,input buf_dis-card-property.node-code
     1818           ,input integer('99':U)
     1819           ,input p-source-type
     1820           ,input p-source-ref
     1821           ,input-output p-chip-num
     1822           ,input-output p-corr-date
     1823           ,input-output p-corr-time
     1824            ).
     1825       buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U).
     1826       delete buf_dis-card-property no-error .
     1827       if error-status:error then do:
     1828         return error return-value.
     1829       end.
     1830       p-deleted = yes.
     1831     end.
     1832   end.
     1833   end procedure.
     1834   procedure discprop-check :
     1835   define input parameter p-range  as integer no-undo .
     1836   define input parameter p-d-card like ub.dis-card-property.d-card no-undo .
     1837   define input parameter p-host-code like ub.dis-card-property.host-code no-undo .
     1838   define input parameter p-obj-type like ub.dis-card-property.obj-type no-undo .
     1839   define input parameter p-obj-code like ub.dis-card-property.obj-code no-undo .
     1840   define input parameter p-dtm-code like ub.dis-card-property.dtm-code no-undo .
     1841   define input parameter p-node-code like ub.dis-card-property.node-code no-undo .
     1842   define input parameter p-dt-code like ub.dis-card-property.dt-code no-undo .
     1843   define variable v-message as character no-undo .
     1844   define buffer buf_sysconf for ub.sysconf.
     1845   define buffer buf_clients for ub.clients.
     1846   define buffer buf_dis-card for ub.dis-card.
     1847   define buffer buf_attr-prop for ub.attr-prop.
     1848   do
     1849   on error undo, return error return-value
     1850   :
     1851     if p-host-code > 0 then do:
     1852       FIND FIRST buf_sysconf No-LOCK WHERE
     1853                 buf_sysconf.host-code = p-host-code No-ERROR.
     1854       IF NOT AVAIL buf_sysconf THEN DO:
     1855         v-message = substitute("Не найдена фирма &1", p-host-code).
     1856         RETURN ERROR v-message.
     1857       END.
     1858     end.
     1859     if p-obj-type <> "":U or
     1860         p-obj-code <> 0 then do:
     1861       find first buf_clients No-LOCK WHERE
     1862                 buf_clients.obj-type = p-obj-type AND
     1863                 buf_clients.obj-code = p-obj-code no-error .
     1864       if not available buf_clients then do:
     1865         v-message = substitute("Не найден объект &1&2", p-obj-type, p-obj-code).
     1866         RETURN ERROR v-message.
     1867       end.
     1868     end.
     1869     else if NOT (p-obj-type = "":U and p-obj-code = 0) then do:
     1870       v-message = substitute("Неверные значения параметров p-obj-type/p-obj-code и/или p-host-code: &1&2 &3"
     1871                               , p-obj-type
     1872                               , p-obj-code
     1873                               , p-host-code).
     1874       RETURN ERROR v-message.
     1875     end.
     1876     if p-d-card <> "":U then do:
     1877       find first buf_dis-card No-LOCK WHERE
     1878                   buf_dis-card.d-card = p-d-card No-ERROR.
     1879       if not avail buf_dis-card then do:
     1880         v-message =substitute("Не найдена ДК").
     1881         return error  v-message.
     1882       end.
     1883       if buf_dis-card.emitent-host-code <> 0
     1884       and p-host-code <> buf_dis-card.emitent-host-code then do:
     1885         v-message = substitute("Для фирменной карты свойство можно ввести только с привязкой к фирме-эмитенту").
     1886         return error v-message.
     1887       end.
     1888       if buf_dis-card.emitent-host-code = 0
     1889       and p-range = 1
     1890       and p-host-code <> 0 then do:
     1891         v-message = substitute("Для свойство с ОБЛАСТЬЮ ДЕЙСТВИЯ СОГЛАСНО КОДУ ЭМИТЕНТА&1" +
     1892                               "для ГЛОБАЛЬНОЙ карты можно ввести только ГЛОБАЛЬНОЕ свойство"
     1893                                 , chr(10)
     1894                               ).
     1895         return error v-message.
     1896       end.
     1897     end.
     1898   end.
     1899   end procedure.
     1900   DEFINE VARIABLE loc#log as logical no-undo .
     1901   DEFINE VARIABLE dd as decimal no-undo .
     1902   DEFINE VARIABLE VAR-ENTRY as character no-undo .
     1903   DEFINE VARIABLE varcard-num like ub.dis-card.card-num no-undo .
     1904   define variable v-ok as logical no-undo .
     1905   define variable v-descr as character no-undo .
     1906   define variable v-dop-d-card as character no-undo .
     1907   define variable ii as integer no-undo .
     1908   define variable old-sourced-card like ub.dis-card.sourced-card no-undo .
     1909   define variable v-curr-r-b as character no-undo .
     1910   define variable v-deleted as logical no-undo .
     1911   define variable v-type as character no-undo .
     1912   define variable v-can-issue as logical no-undo .
     1913   define variable v-can-edit as logical no-undo .
     1914   define variable v-err-mess as character no-undo .
     1915   define variable v-import as logical no-undo .
     1916   define variable v-rum as logical no-undo .
     1917   define variable v-old-title as character no-undo .
     1918   define variable v-has-right-to-restore as logical no-undo .
     1919   define variable v-first-card like ub.dis-card.first-card no-undo .
     1920   define variable v-first-main-card like ub.dis-card.first-main-card no-undo .
     1921   define variable v-overissue-num like ub.dis-card.overissue-num no-undo .
     1922   define buffer source_dis-card for ub.dis-card.
     1923   define buffer main_dis-card for ub.dis-card.
     1924   define buffer other_dis-card for ub.dis-card.
     1925   define buffer buf_clients for ub.clients.
     1926   define buffer buf_dis-host for ub.dis-host .
     1927   define buffer buf_dis-card for ub.dis-card.
     1928   define buffer buf_dis-card-type for ub.dis-card-type.
     1929   define buffer buf_dis-card-property for ub.dis-card-property.
     1930   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1931   procedure gen-b-code :
     1932     define input  parameter type-code like ub.code-range.range-type no-undo .
     1933     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
     1934     do
     1935     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1936     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
     1937     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
     1938     :
     1939       define buffer buf_thbj-attr     for ub.thbj-attr .
     1940       define buffer buf_sys-ctrl   for ub.sys-ctrl .
     1941       define buffer buf_code-range for ub.code-range .
     1942       define variable l-code         as   integer              no-undo .
     1943       define variable v-db-num       like ub.db.db-num         no-undo .
     1944       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
     1945       if type-code = 'sslc':U
     1946       or type-code = 'ssgb':U
     1947       then do:
     1948         message
     1949           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
     1950           "Обратитесь к администратору системы."
     1951           view-as alert-box error .
     1952         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
     1953       end.
     1954       run trg/getpcode.p ( input  type-code
     1955                      ,output cfg-param-code
     1956                     ).
     1957       run get-next-seq( input  type-code,
     1958                         output l-code
     1959                       ).
     1960       find first buf_sys-ctrl no-lock.
     1961       if type-code = 'sclc':U
     1962       or type-code = 'pglc':U
     1963       then do:
     1964         assign
     1965           v-db-num = 0
     1966         .
     1967       end.
     1968       else do:
     1969         assign
     1970           v-db-num = buf_sys-ctrl.db-num
     1971         .
     1972       end.
     1973       find first buf_code-range no-lock
     1974         where buf_code-range.db-num     = v-db-num
     1975           and buf_code-range.range-type = type-code
     1976           and buf_code-range.stts       = "a"
     1977         use-index stts
     1978         no-error .
     1979       if available buf_code-range
     1980          and l-code <= buf_code-range.last-code
     1981          and l-code >= buf_code-range.first-code then do:
     1982         assign
     1983           p-b-code = l-code
     1984         .
     1985       end.
     1986       else do:
     1987         if available buf_code-range
     1988            and l-code < buf_code-range.last-code then do:
     1989           message
     1990             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
     1991             "Обратитесь к администратору системы."
     1992             view-as alert-box error .
     1993           undo, return error "sequence":U .
     1994         end.
     1995         do transaction
     1996         on error undo, return error
     1997         :
     1998           find first buf_thbj-attr exclusive-lock
     1999             where buf_thbj-attr.upper-prop-code = 'code-range':U
     2000               and buf_thbj-attr.prop-code = cfg-param-code
     2001               and buf_thbj-attr.obj-type   = 'БД':U
     2002               and buf_thbj-attr.obj-code   = v-db-num
     2003             no-error .
     2004           if not available buf_thbj-attr then do:
     2005             find first buf_thbj-attr exclusive-lock
     2006               where buf_thbj-attr.upper-prop-code = 'code-range':U
     2007                 and buf_thbj-attr.prop-code = cfg-param-code
     2008                 and buf_thbj-attr.obj-type   = ''
     2009                 and buf_thbj-attr.obj-code   = 0
     2010               no-error .
     2011             if not available buf_thbj-attr then do:
     2012               if not locked buf_thbj-attr then do:
     2013                 message
     2014                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
     2015                   "Обратитесь к администратору системы."
     2016                   view-as alert-box error .
     2017               end.
     2018               undo, return error "config":U .
     2019             end.
     2020           end.
     2021           run get-next-seq( input type-code,
     2022                             output l-code
     2023                           ).
     2024           find first buf_code-range
     2025             where buf_code-range.db-num     = v-db-num
     2026               and buf_code-range.range-type = type-code
     2027               and buf_code-range.stts       = "a"
     2028             use-index stts
     2029             no-error .
     2030           if available buf_code-range
     2031           and l-code <= buf_code-range.last-code
     2032           and l-code >= buf_code-range.first-code
     2033           then do:
     2034             assign
     2035               p-b-code = l-code
     2036             .
     2037           end.
     2038           else do:
     2039             if available buf_code-range then do:
     2040               assign
     2041                 buf_code-range.stts = "u"
     2042               .
     2043             end.
     2044             find first buf_code-range
     2045               where buf_code-range.db-num     = v-db-num
     2046                 and buf_code-range.range-type = type-code
     2047                 and buf_code-range.stts       = "f"
     2048               use-index stts
     2049               no-error .
     2050             if not available buf_code-range then do:
     2051               message
     2052                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
     2053                 "Обратитесь к администратору системы"
     2054                 view-as alert-box error .
     2055               undo, return error "code-range":U .
     2056             end.
     2057             assign
     2058               buf_code-range.stts           = "a"
     2059             .
     2060             if buf_code-range.first-code = 1 then do:
     2061               run set-seq-cr( input type-code,
     2062                               input buf_code-range.first-code
     2063                             ).
     2064               assign
     2065                 p-b-code = 1
     2066               .
     2067             end.
     2068             else do:
     2069               run set-seq-cr( input type-code,
     2070                               input ( buf_code-range.first-code - 1 )
     2071                             ).
     2072               run get-next-seq( input type-code,
     2073                                 output p-b-code
     2074                               ).
     2075             end.
     2076           end.
     2077         end.
     2078       end.
     2079     end.
     2080   end procedure.
     2081   procedure get-next-seq :
     2082     define input  parameter type-code like ub.code-range.range-type no-undo .
     2083     define output parameter next-seq  as   integer                  no-undo .
     2084     do
     2085     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2086     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
     2087     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
     2088     :
     2089       case type-code:
     2090         when 'bcgb':U then do:
     2091           assign
     2092             next-seq = next-value(s-bcgb-code, ub)
     2093           .
     2094         end.
     2095         when 'scgb':U then do:
     2096           assign
     2097             next-seq = next-value(s-scgb-code, ub)
     2098           .
     2099         end.
     2100         when 'sclc':U then do:
     2101           assign
     2102             next-seq = next-value(s-sclc-code, ub)
     2103           .
     2104         end.
     2105         when 'pglc':U then do:
     2106           assign
     2107             next-seq = next-value(s-pglc-code, ub)
     2108           .
     2109         end.
     2110         when 'dcgb':U then do:
     2111           assign
     2112             next-seq = next-value(s-dcgb-code, ub)
     2113           .
     2114         end.
     2115         when 'ctgb':U then do:
     2116           assign
     2117             next-seq = next-value(s-ctgb-code, ub)
     2118           .
     2119         end.
     2120         when 'drgb':U then do:
     2121           assign
     2122             next-seq = next-value(s-drgb-code, ub)
     2123           .
     2124         end.
     2125         when 'fmgb':U then do:
     2126           assign
     2127             next-seq = next-value(s-fmgb-code, ub)
     2128           .
     2129         end.
     2130         when 'pngb':U then do:
     2131           assign
     2132             next-seq = next-value(s-pngb-code, ub)
     2133           .
     2134         end.
     2135         when 'cagb':U then do:
     2136           assign
     2137             next-seq = next-value(s-cagb-code, ub)
     2138           .
     2139         end.
     2140         when 'fdgb':U then do:
     2141           assign
     2142             next-seq = next-value(s-fin-doc, ub)
     2143           .
     2144         end.
     2145       end case.
     2146     end.
     2147   end procedure.
     2148   procedure set-seq-cr :
     2149     define input parameter type-code like ub.code-range.range-type no-undo .
     2150     define input parameter set-val   like ub.code-range.first-code no-undo .
     2151     do
     2152     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2153     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
     2154     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
     2155     :
     2156       case type-code:
     2157         when 'bcgb':U then do:
     2158           assign
     2159             current-value(s-bcgb-code, ub) = set-val
     2160           .
     2161         end.
     2162         when 'scgb':U then do:
     2163           assign
     2164             current-value(s-scgb-code, ub) = set-val
     2165           .
     2166         end.
     2167         when 'sclc':U then do:
     2168           assign
     2169             current-value(s-sclc-code, ub) = set-val
     2170           .
     2171         end.
     2172         when 'pglc':U then do:
     2173           assign
     2174             current-value(s-pglc-code, ub) = set-val
     2175           .
     2176         end.
     2177         when 'dcgb':U then do:
     2178           assign
     2179             current-value(s-dcgb-code, ub) = set-val
     2180           .
     2181         end.
     2182         when 'ctgb':U then do:
     2183           assign
     2184             current-value(s-ctgb-code, ub) = set-val
     2185           .
     2186         end.
     2187         when 'drgb':U then do:
     2188           assign
     2189             current-value(s-drgb-code, ub) = set-val
     2190           .
     2191         end.
     2192         when 'fmgb':U then do:
     2193           assign
     2194             current-value(s-fmgb-code, ub) = set-val
     2195           .
     2196         end.
     2197         when 'pngb':U then do:
     2198           assign
     2199             current-value(s-pngb-code, ub) = set-val
     2200           .
     2201         end.
     2202         when 'cagb':U then do:
     2203           assign
     2204             current-value(s-cagb-code, ub) = set-val
     2205           .
     2206         end.
     2207         when 'fdgb':U then do:
     2208           assign
     2209             current-value(s-fin-doc, ub) = set-val
     2210           .
     2211         end.
     2212       end case.
     2213     end.
     2214   end procedure.
     2215   procedure new-bcod-gen-code-range :
     2216     do
     2217     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2218     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
     2219     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
     2220     :
     2221       define input parameter p-db-num  like ub.db.db-num             no-undo .
     2222       define input parameter type-code like ub.code-range.range-type no-undo .
     2223       define buffer buf_code-range      for ub.code-range .
     2224       define buffer last_code-range     for ub.code-range .
     2225       define buffer last-1_code-range   for ub.code-range .
     2226       define buffer last-2_code-range   for ub.code-range .
     2227       define buffer last-3_code-range   for ub.code-range .
     2228       define buffer buf_sys-ctrl        for ub.sys-ctrl .
     2229       define variable conf-par       as character no-undo .
     2230       define variable par-type       as character no-undo .
     2231       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
     2232       define variable v-cre-cdrg as logical   no-undo .
     2233       define variable v-cre-str  as character no-undo .
     2234       define variable v-cr1      as integer no-undo .
     2235       define variable v-cr2      as integer no-undo .
     2236       define variable v-cr3      as integer no-undo .
     2237       define variable v-cmax     as integer no-undo .
     2238       find first buf_sys-ctrl no-lock .
     2239       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
     2240         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
     2241                                       ,vss-workfile
     2242                                       ,vss-revision
     2243                                       ,vss-description
     2244                                       ,chr(10)
     2245                                       , p-db-num
     2246                                      ).
     2247       end.
     2248       run trg/getpcode.p ( input  type-code
     2249                      ,output cfg-param-code
     2250                     ).
     2251       for each buf_code-range
     2252         where buf_code-range.db-num     = -1
     2253           and buf_code-range.range-type = type-code
     2254           and buf_code-range.stts       = "f"
     2255       by buf_code-range.first-code
     2256       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2257       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
     2258       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
     2259       :
     2260         assign
     2261           buf_code-range.db-num = p-db-num
     2262         .
     2263         return .
     2264       end.
     2265       assign
     2266         v-cre-cdrg = TRUE
     2267       .
     2268       case type-code:
     2269         when 'sclc':U
     2270         or when 'scgb':U
     2271         or when 'pglc':U
     2272         then do:
     2273           find last last-1_code-range no-lock
     2274             where last-1_code-range.range-type = 'sclc':U
     2275             no-error .
     2276           if available last-1_code-range then do:
     2277             v-cr1 = last-1_code-range.last-code.
     2278           end.
     2279           find last last-2_code-range no-lock
     2280             where last-2_code-range.range-type = 'scgb':U
     2281             no-error .
     2282           if available last-2_code-range then do:
     2283             v-cr2 = last-2_code-range.last-code.
     2284             end.
     2285           find last last-3_code-range no-lock
     2286             where last-3_code-range.range-type = 'pglc':U
     2287             no-error .
     2288           if available last-3_code-range then do:
     2289             v-cr3 = last-3_code-range.last-code.
     2290           end.
     2291           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     2292           .
     2293           if v-cmax = v-cr1  then do:
     2294               find last last_code-range no-lock
     2295                 where recid( last_code-range ) = recid( last-1_code-range )
     2296                 .
     2297             end.
     2298           if v-cmax = v-cr2  then do:
     2299               find last last_code-range no-lock
     2300                 where recid( last_code-range ) = recid( last-2_code-range )
     2301                 .
     2302             end.
     2303           if v-cmax = v-cr3  then do:
     2304             find last last_code-range no-lock
     2305               where recid( last_code-range ) = recid( last-3_code-range )
     2306               .
     2307           end.
     2308           if last_code-range.last-code + 1 > 99999 then do:
     2309             assign
     2310               v-cre-cdrg = FALSE
     2311             .
     2312           end.
     2313         end.
     2314         when 'bcgb':U
     2315         or when 'sslc':U
     2316         or when 'ssgb':U
     2317         then do:
     2318           find last last-1_code-range no-lock
     2319             where last-1_code-range.range-type = 'sslc':U
     2320             no-error .
     2321           if available last-1_code-range then do:
     2322             v-cr1 = last-1_code-range.last-code.
     2323           end.
     2324           find last last-2_code-range no-lock
     2325             where last-2_code-range.range-type = 'bcgb':U
     2326             no-error .
     2327           if available last-2_code-range then do:
     2328             v-cr2 = last-2_code-range.last-code.
     2329             end.
     2330           find last last-3_code-range no-lock
     2331             where last-3_code-range.range-type = 'ssgb':U
     2332             no-error .
     2333           if available last-3_code-range then do:
     2334             v-cr3 = last-3_code-range.last-code.
     2335           end.
     2336           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     2337           .
     2338           if v-cmax = v-cr1  then do:
     2339               find last last_code-range no-lock
     2340                 where recid( last_code-range ) = recid( last-1_code-range )
     2341                 .
     2342             end.
     2343           if v-cmax = v-cr2  then do:
     2344               find last last_code-range no-lock
     2345                 where recid( last_code-range ) = recid( last-2_code-range )
     2346                 .
     2347             end.
     2348           if v-cmax = v-cr3  then do:
     2349             find last last_code-range no-lock
     2350               where recid( last_code-range ) = recid( last-3_code-range )
     2351               .
     2352           end.
     2353         end.
     2354         otherwise do:
     2355           find last last_code-range no-lock
     2356             where last_code-range.range-type = type-code
     2357             no-error .
     2358         end.
     2359       end case.
     2360       if not available last_code-range then do:
     2361         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
     2362                                       ,vss-workfile
     2363                                       ,vss-revision
     2364                                       ,vss-description
     2365                                       , chr(10)
     2366                                       , type-code
     2367                                      ) .
     2368       end.
     2369       define variable v-mes15 as character no-undo .
     2370       define variable v-param-type15 as character no-undo .
     2371       define variable v-value-character15 as INTEGER no-undo .
     2372       define variable v-value-date15 as date no-undo .
     2373       define variable v-value-decimal15 as decimal no-undo .
     2374       define variable v-value-integer15 AS integer no-undo .
     2375       define variable v-value-logical15 AS LOGICAL no-undo .
     2376       define variable v-tth15 as handle no-undo .
     2377       run adm/shattri.p (
     2378           input "get":U
     2379           ,input  'БД':U
     2380           ,input  p-db-num
     2381           ,input  'code-range':U
     2382           ,input  cfg-param-code
     2383           ,output v-value-character15
     2384           ,output v-value-date15
     2385           ,output v-value-decimal15
     2386           ,output v-value-integer15
     2387           ,output v-value-logical15
     2388           ,output v-param-type15
     2389           ,INPUT-OUTPUT table-handle v-tth15
     2390           ) no-error .
     2391       if error-status :error then do:
     2392         delete object v-tth15.
     2393         v-mes15 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
     2394                            , error-status:get-message(1)
     2395                            , chr(10)
     2396                            , return-value ).
     2397         undo, return error v-mes15.
     2398       end.
     2399       delete object v-tth15.
     2400       if v-cre-cdrg = TRUE then do:
     2401         create buf_code-range .
     2402         assign
     2403           buf_code-range.db-num     = p-db-num
     2404           buf_code-range.range-type = type-code
     2405           buf_code-range.stts       = "f"
     2406           buf_code-range.first-code = last_code-range.last-code + 1
     2407           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer15)
     2408           v-cre-str = "Свободный диапазон успешно создан"
     2409         .
     2410       end.
     2411       else do:
     2412         assign
     2413           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
     2414                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
     2415         .
     2416       end.
     2417     end.
     2418     return v-cre-str .
     2419   end procedure.
     2420   procedure gen-new-code-range-if-neces :
     2421     define input parameter v-db-num           like ub.db.db-num             no-undo .
     2422     define input parameter v-range-type       like ub.code-range.range-type no-undo .
     2423     define input parameter v-cur-code         as   integer                  no-undo .
     2424     define input parameter v-g#news           as   logical                  no-undo .
     2425     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
     2426     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
     2427     do
     2428     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2429     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
     2430     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
     2431     :
     2432       define variable l-code-range-exist as logical   no-undo init false .
     2433       define variable v-db-for-send      as character no-undo .
     2434       define buffer buf_code-range  for ub.code-range .
     2435       define buffer buf1_code-range for ub.code-range .
     2436       define buffer buf_db          for ub.db .
     2437       find first buf_code-range
     2438         where buf_code-range.range-type = v-range-type
     2439           and buf_code-range.last-code >= v-cur-code
     2440         use-index last-codei
     2441         no-error .
     2442       if
     2443       (
     2444          available buf_code-range
     2445          and
     2446         (buf_code-range.db-num = v-db-num
     2447           and
     2448         buf_code-range.first-code <= v-cur-code
     2449         )
     2450       or
     2451         (
     2452           v-range-type = 'drgb':U
     2453           AND
     2454           v-cur-code = 0
     2455         )
     2456      )
     2457      then do:
     2458         assign
     2459           l-code-range-exist = true
     2460         .
     2461         if v-g#news
     2462         and buf_code-range.stts = "f" then do:
     2463           assign
     2464             buf_code-range.stts = "u"
     2465           .
     2466         end.
     2467       end.
     2468       if not l-code-range-exist
     2469          and v-g#news-source-db <> 0
     2470       then do:
     2471         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
     2472                                       ,vss-workfile
     2473                                       ,vss-revision
     2474                                       ,vss-description
     2475                                       ,chr(10)
     2476                                       ,v-db-num
     2477                                       ,v-range-type
     2478                                       ,v-cur-code
     2479                                      ).
     2480       end.
     2481       if (not l-code-range-exist
     2482           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
     2483          )
     2484       and ( not can-find (first buf1_code-range no-lock
     2485                           where buf1_code-range.db-num = v-db-num
     2486                             and buf1_code-range.range-type = v-range-type
     2487                             and buf1_code-range.stts = "f"
     2488                          )
     2489           )
     2490       then do:
     2491         if v-g#db-num = 0 then do:
     2492           run new-bcod-gen-code-range in this-procedure
     2493             (input v-db-num,
     2494              input v-range-type
     2495             ) no-error .
     2496           if error-status :error then do:
     2497             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
     2498                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
     2499                                           ,v-db-num
     2500                                           ,v-range-type
     2501                                           ,v-cur-code
     2502                                           ,chr(10)
     2503                                           ,error-status:get-message(1)
     2504                                           ,return-value
     2505                                          ).
     2506           end.
     2507         end.
     2508         else do:
     2509           if v-range-type = 'sclc':U
     2510           or v-range-type = 'pglc':U
     2511           then do:
     2512             assign
     2513               v-db-for-send = "":U
     2514             .
     2515             if v-g#db-num = 0 then do:
     2516               for each buf_db no-lock
     2517                 where buf_db.db-num > 0
     2518                   and buf_db.db-num <> v-g#news-source-db
     2519               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2520               :
     2521                 assign
     2522                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
     2523                 .
     2524               end.
     2525               assign
     2526                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
     2527               .
     2528             end.
     2529             else do:
     2530               if not v-g#news then do:
     2531                 assign
     2532                   v-db-for-send = "0":U
     2533                 .
     2534               end.
     2535             end.
     2536             run nws/cr-route.p ( input 'send-cmd':U
     2537                           ,input ("command":U + chr(1) + "create":U + chr(1) +
     2538                                  "code-range":U + chr(1) +
     2539                                  (if v-range-type = 'sclc':U
     2540                                   then string( current-value(s-sclc-code, ub))
     2541                                   else string( current-value(s-pglc-code, ub))
     2542                                   ) + chr(1) +
     2543                                   v-range-type)
     2544                           ,input ?
     2545                           ,input v-db-for-send
     2546                           ) no-error .
     2547             if error-status :error then do:
     2548               undo, return error return-value.
     2549             end.
     2550           end.
     2551         end.
     2552       end.
     2553     end.
     2554   end procedure.
     2555   procedure cre-loc-sc-code-range :
     2556     define input parameter v-cur-code as integer no-undo .
     2557   define input parameter p-cdrg-type as character no-undo .
     2558     do
     2559     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2560     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
     2561     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
     2562     :
     2563       define buffer buf_code-range for ub.code-range .
     2564       find first buf_code-range
     2565            where buf_code-range.range-type = p-cdrg-type
     2566              and buf_code-range.first-code >= v-cur-code
     2567            no-error .
     2568       if not available buf_code-range then do:
     2569         run new-bcod-gen-code-range in this-procedure
     2570           ( input 0,
     2571             input p-cdrg-type
     2572           ) no-error .
     2573         if error-status :error then do:
     2574           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
     2575                                          + "Код &2&1&3 &4"
     2576                                         , chr(10)
     2577                                         , v-cur-code
     2578                                         , error-status:get-message(1)
     2579                                         , return-value
     2580                                        ) .
     2581         end.
     2582       end.
     2583     end.
     2584   end procedure.
     2585   procedure mark-used-if-need :
     2586   define input parameter p-cur-code as integer no-undo .
     2587   define input parameter p-range-type like ub.code-range.range-type no-undo .
     2588   define input parameter p-db-num like ub.code-range.db-num no-undo .
     2589     do
     2590     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2591     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
     2592     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
     2593     :
     2594       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
     2595       define buffer buf_code-range for ub.code-range .
     2596       assign
     2597       v-db-num = if p-range-type = 'sclc':U
     2598                  then 0
     2599                  else p-db-num
     2600       .
     2601   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2602   define buffer locK-batchprocess16 for ub.batchprocess.
     2603   run gbl/lock-prc.p
     2604       (input 'lscc':U
     2605       ,input 0
     2606       ,input 0
     2607       ,input 0
     2608       ,input ""
     2609       ,input ""
     2610       ,input ""
     2611       ,input (
     2612               ",,,Вкл/выкл лок. вес. кодов"
     2613              )
     2614       ,input true
     2615       ,buffer lock-batchprocess16
     2616       ) no-error .
     2617     if error-status :error then do:
     2618       message
     2619         vss-workfile vss-revision vss-description skip
     2620         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     2621         view-as alert-box error .
     2622       undo, return error .
     2623     end.
     2624       find first buf_code-range
     2625            where buf_code-range.range-type = p-range-type
     2626              and buf_code-range.first-code >= p-cur-code
     2627              and buf_code-range.last-code <= p-cur-code
     2628              and buf_code-range.db-num = v-db-num
     2629            no-error .
     2630       if not available buf_code-range then do:
     2631         message
     2632           vss-workfile vss-revision vss-description skip
     2633           "Ошибка при создании поиске диапазона" skip
     2634           "База данных" p-db-num skip
     2635           "Код" p-cur-code skip
     2636           "Тип" p-range-type
     2637           error-status :get-message(1) skip
     2638           return-value skip
     2639           view-as alert-box error .
     2640         undo, return error .
     2641       end.
     2642       if buf_code-range.stts = "f":U then do:
     2643         assign
     2644         buf_code-range.stts = "u":U
     2645         .
     2646       end.
     2647     end.
     2648   end procedure.
     2649   if g#db-num > 0 then do:
     2650     message  vss-workfile vss-revision vss-description skip
     2651             "Вызов процедуры в УБД запрещен"
     2652     view-as alert-box ERROR.
     2653     return error '':u.
     2654   end.
     2655   if par-mode <> 'ДОБАВЛЕНИЕ':U
     2656   AND par-mode <> 'ИЗМЕНЕНИЕ':U
     2657   AND par-mode <> 'ДОБАВЛЕНИЕ-ИМПОРТ':U
     2658   then do:
     2659     message vss-workfile vss-revision vss-description skip
     2660             "Неверный параметр par-mode - " par-mode
     2661     view-as alert-box error .
     2662     return error '':u.
     2663   end.
     2664   if par-mode  = 'ДОБАВЛЕНИЕ-ИМПОРТ':U then do:
     2665     v-import = yes.
     2666     par-mode = 'ДОБАВЛЕНИЕ':U.
     2667   end.
     2668   if par-mode2 <> '':U then
     2669   assign
     2670   v-import = (par-mode2 = "import":U)
     2671   v-rum = (par-mode2 = "rum":U)
     2672   .
     2673   if num-entries(par-status_, chr(4)) > 1 then
     2674   assign
     2675   v-has-right-to-restore = logical(entry(2, par-status_, chr(4)))
     2676   par-status_ = entry(1, par-status_, chr(4) )
     2677   .
     2678   if par-type = "" then do:
     2679     assign
     2680     v-err-mess = substitute("Тип дисконтной карты не может быть пустым").
     2681     run err-mess in this-procedure ( input-output v-err-mess).
     2682     var-entry = "type":U.
     2683     return error (if p-silent = yes then v-err-mess else var-entry).
     2684   end.
     2685   if parcli-type <> 'чел':U
     2686   and parcli-type <> 'орг':U then do:
     2687     assign
     2688     v-err-mess =  substitute("Неверный тип клиента &1"
     2689                             , (if parcli-type= ? then chr(63) else parcli-type)
     2690                                 ).
     2691     run err-mess in this-procedure ( input-output v-err-mess).
     2692     var-entry = "cli-type":U.
     2693     return error (if p-silent = yes then v-err-mess else var-entry).
     2694   end.
     2695   find first buf_clients no-lock where
     2696             buf_clients.obj-type = parcli-type
     2697         AND buf_clients.obj-code = parcli-code no-error .
     2698   if not available buf_clients  then do:
     2699     assign
     2700     v-err-mess = substitute("Не найден клиент &1&2 для карты"
     2701                , (if parcli-type= ? then chr(63) else parcli-type)
     2702                , (if parcli-code= ? then chr(63) else string(parcli-code))).
     2703     run err-mess in this-procedure ( input-output v-err-mess).
     2704     var-entry = "cli-code":U.
     2705     return error (if p-silent = yes then v-err-mess else var-entry).
     2706   end.
     2707   FIND FIRST buf_dis-card-type share-LOCK WHERE
     2708              buf_dis-card-type.type = par-type AND
     2709              buf_dis-card-type.emitent-host-code = paremitent-host-code AND
     2710              buf_dis-card-type.host-code = 0 AND
     2711              buf_dis-card-type.obj-type = "":U AND
     2712              buf_dis-card-type.obj-code = 0 No-ERROR.
     2713   if not avail buf_dis-card-type then do:
     2714     assign
     2715     v-err-mess = substitute("Неверный тип дисконтной карты").
     2716     run err-mess in this-procedure ( input-output v-err-mess).
     2717     var-entry = "type":U.
     2718     return error (if p-silent = yes then v-err-mess else var-entry).
     2719   end.
     2720   if paremitent-host-code <> 0 and not can-find( first ub.sysconf No-LOCK WHERE
     2721                          ub.sysconf.host-code = paremitent-host-code) then do:
     2722     assign
     2723     v-err-mess = substitute("Нет фирмы-эмитента дисконтной карты").
     2724     run err-mess in this-procedure ( input-output v-err-mess).
     2725     var-entry = "host-code":U.
     2726     return error (if p-silent = yes then v-err-mess else var-entry).
     2727   end.
     2728   if pard-pcnt < 0 or parcash-d-pcnt < 0 then do:
     2729     if pard-pcnt < 0 then do:
     2730       assign
     2731       v-err-mess = substitute("Скидка по дисконтной карте &1 не может быть отрицательной", pard-pcnt).
     2732       run err-mess in this-procedure ( input-output v-err-mess).
     2733       var-entry = "d-pcnt":U.
     2734     end.
     2735     if parcash-d-pcnt < 0 then do:
     2736       assign
     2737       v-err-mess = substitute("Скидка по дисконтной карте &1 не может быть отрицательной", parcash-d-pcnt).
     2738       run err-mess in this-procedure ( input-output v-err-mess).
     2739       var-entry = "cash-d-pcnt":U.
     2740     end.
     2741     return error (if p-silent = yes then v-err-mess else var-entry).
     2742   end.
     2743   if pard-pcnt > 100 or parcash-d-pcnt > 100 then do:
     2744     if pard-pcnt > 100 then  do:
     2745       assign
     2746       v-err-mess = substitute("Скидка по дисконтной карте &1 не может быть больше 100%", pard-pcnt).
     2747       run err-mess in this-procedure ( input-output v-err-mess).
     2748       var-entry = "d-pcnt":U.
     2749     end.
     2750     if parcash-d-pcnt > 100 then do:
     2751       assign
     2752       v-err-mess = substitute("Скидка по дисконтной карте &1 не может быть больше 100%", parcash-d-pcnt).
     2753       run err-mess in this-procedure ( input-output v-err-mess).
     2754       var-entry = "cash-d-pcnt":U.
     2755     end.
     2756     return error (if p-silent = yes then v-err-mess else var-entry).
     2757   end.
     2758   if pard-pcnt > 50 or parcash-d-pcnt > 50 then do:
     2759     if not p-silent then do:
     2760       message "Вы уверены что скидка по дисконтной карте выше 50%?"
     2761       view-as alert-box QUESTION buttons YES-NO update loc#log.
     2762       if NOT loc#log  then do:
     2763         if pard-pcnt > 50 then do:
     2764           var-entry = "d-pcnt":U.
     2765         end.
     2766         else do:
     2767           var-entry = "cash-d-pcnt":U.
     2768         end.
     2769         return error (if p-silent = yes then v-err-mess else var-entry).
     2770       end.
     2771     end.
     2772   end.
     2773   if paremitent-host-code = 0 and parcredit-card then do:
     2774     assign
     2775     v-err-mess = substitute("Глобальная дисконтная карта не может быть кредитной").
     2776     run err-mess in this-procedure ( input-output v-err-mess).
     2777     var-entry = "credit-card":U.
     2778     return error (if p-silent = yes then v-err-mess else var-entry).
     2779   end.
     2780   if parcredit-card and parlim-kr <= 0 then do:
     2781     assign
     2782     v-err-mess  = substitute("Неверный лимит кредита &1, если дисконтная карта кредитная, лимит кредита должен быть положительным"
     2783                              ,parlim-kr).
     2784     run err-mess in this-procedure ( input-output v-err-mess).
     2785     var-entry = "lim-kr":U.
     2786     return error (if p-silent = yes then v-err-mess else var-entry).
     2787   end.
     2788   if parcredit-card and pardebet-card then do:
     2789     assign
     2790     v-err-mess = substitute("Карта не может быть одновременно и кредитной и дебетовой").
     2791     run err-mess in this-procedure ( input-output v-err-mess).
     2792     var-entry = "credit-card":U.
     2793     return error (if p-silent = yes then v-err-mess else var-entry).
     2794   end.
     2795   if parissue-code = 0 and not parmask-card then do:
     2796       assign
     2797       v-err-mess = substitute("Не указан код магазина, выдавшего карту").
     2798       run err-mess in this-procedure ( input-output v-err-mess).
     2799       var-entry = "issue-code":U.
     2800       return error (if p-silent = yes then v-err-mess else var-entry).
     2801   end.
     2802   if not parmask-card then do:
     2803     find first ub.shop no-lock where
     2804               ub.shop.obj-code = parissue-code NO-ERROR.
     2805     if not avail ub.shop or (paremitent-host-code <> 0 and ub.shop.host-code <> paremitent-host-code) then do:
     2806       assign
     2807       v-err-mess = substitute("Не найден магазин &1, выдавший карту, или он принадлежит другой фирме", parissue-code).
     2808       run err-mess in this-procedure ( input-output v-err-mess).
     2809       var-entry = "issue-code":U.
     2810       return error (if p-silent = yes then v-err-mess else var-entry).
     2811     end.
     2812     define buffer shop_clients for ub.clients.
     2813     find first shop_clients no-lock where
     2814              shop_clients.obj-type = 'маг':U
     2815          and shop_clients.obj-code = parissue-code .
     2816     if shop_clients.stts <> integer('0':U) then do:
     2817       if p-silent then do:
     2818         assign
     2819         v-err-mess = substitute("Магазин &1, выдавший карту, имеет статус 2&3" +
     2820                                 "Нельзя выдать карту от имени этого магазина!"
     2821                                 , parissue-code
     2822                                 , entry (lookup (string(shop_clients.stts), '0,1,50,99':U), 'тек,удал,блок,удаление':U)
     2823                                 , chr(10)
     2824                                 ).
     2825         run err-mess in this-procedure ( input-output v-err-mess).
     2826         var-entry = "issue-code":U.
     2827         return error (if p-silent = ? then v-err-mess else var-entry).
     2828       end.
     2829       else do:
     2830         assign
     2831         v-err-mess = substitute("Магазин &1, выдавший карту, имеет статус &2&3" +
     2832                                 "Вы уверены, что хотите выдать карту от имени этого магазина?"
     2833                                 , parissue-code
     2834                                 , entry (lookup (string(shop_clients.stts), '0,1,50,99':U), 'тек,удал,блок,удаление':U)
     2835                                 , chr(10)
     2836                                 ).
     2837         define variable glog as logical no-undo .
     2838         message
     2839         v-err-mess view-as alert-box warning buttons yes-no update glog.
     2840         if not glog then do:
     2841           var-entry = "":U.
     2842           return error var-entry.
     2843         end.
     2844       end.
     2845     end.
     2846   end.
     2847   if parissue-date = ? then do:
     2848     assign
     2849     v-err-mess = substitute("Не указана дата выдачи карты").
     2850     run err-mess in this-procedure ( input-output v-err-mess).
     2851     var-entry = "issue-date":U.
     2852     return error (if p-silent = yes then v-err-mess else var-entry).
     2853   end.
     2854   if parvalid-from = ? then do:
     2855     assign
     2856     v-err-mess = substitute("Не указана дата начала действия карты").
     2857     run err-mess in this-procedure ( input-output v-err-mess).
     2858     var-entry = "valid-from":U.
     2859     return error (if p-silent = yes then v-err-mess else var-entry).
     2860   end.
     2861   if parvalid-from < 01/01/2000
     2862   and buf_dis-card-type.card-media = integer('5':U)
     2863    then do:
     2864     assign
     2865     v-err-mess = substitute("Дата начала действия карты типа EasyFuel не может быть ранее 01/01/2000").
     2866     run err-mess in this-procedure ( input-output v-err-mess).
     2867     var-entry = "valid-from":U.
     2868     return error (if p-silent = yes then v-err-mess else var-entry).
     2869   end.
     2870   if parvalid-date = ?
     2871   and buf_dis-card-type.card-media = integer('5':U)
     2872   then do:
     2873     assign
     2874     v-err-mess = substitute("Не указана дата окончания действия карты").
     2875     run err-mess in this-procedure ( input-output v-err-mess).
     2876     var-entry = "valid-date":U.
     2877     return error (if p-silent = yes then v-err-mess else var-entry).
     2878   end.
     2879   if (parvalid-date - parvalid-from) > 4095
     2880   and buf_dis-card-type.card-media = integer('5':U)
     2881   then do:
     2882     assign
     2883     v-err-mess = substitute("Карта типа EasyFuel не может действовать больше 4095 дней &1" +
     2884                             "Еесли начало срока действия карты &2, то конец срока действия может быть не позже &3"
     2885                             , chr(10)
     2886                             ,string(parvalid-from, "99/99/9999")
     2887                             ,string(parvalid-from + 4095, "99/99/9999")
     2888                               ).
     2889     run err-mess in this-procedure ( input-output v-err-mess).
     2890     var-entry = "valid-date":U.
     2891     return error (if p-silent = yes then v-err-mess else var-entry).
     2892   end.
     2893   if parvalid-date < parissue-date then do:
     2894     assign
     2895     v-err-mess = substitute("Неверная дата окончания действия карты &1", parvalid-date).
     2896     run err-mess in this-procedure ( input-output v-err-mess).
     2897     var-entry = "valid-date":U.
     2898     return error (if p-silent = yes then v-err-mess else var-entry).
     2899   end.
     2900   if parvalid-date < parvalid-from then do:
     2901     assign
     2902     v-err-mess = substitute("Неверная дата окончания действия карты &1", parvalid-date).
     2903     run err-mess in this-procedure ( input-output v-err-mess).
     2904     var-entry = "valid-date":U.
     2905     return error (if p-silent = yes then v-err-mess else var-entry).
     2906   end.
     2907   if  trim(pard-card) = "" then do:
     2908     assign
     2909     v-err-mess = substitute("Не указан номер карты").
     2910     run err-mess in this-procedure ( input-output v-err-mess).
     2911     var-entry = "d-card":U.
     2912     return error (if p-silent = yes then v-err-mess else var-entry).
     2913   end.
     2914   if parmask-card then do:
     2915     run check-mask-card in this-procedure (
     2916                                             input pard-card
     2917                                           , input no
     2918                                           , output v-ok
     2919                                           , output v-descr) no-error .
     2920     if error-status:error then do:
     2921       assign
     2922       v-err-mess = substitute("Ошибка при проверке карты-маски: &1 &2", error-status:get-message(1), return-value ).
     2923       run err-mess in this-procedure ( input-output v-err-mess).
     2924       var-entry = "d-card":U.
     2925       return error (if p-silent = yes then v-err-mess else var-entry).
     2926     end.
     2927     if not v-ok then do:
     2928       var-entry = "d-card":U.
     2929       return error (if p-silent = yes then v-err-mess else var-entry).
     2930     end.
     2931   end.
     2932   else do:
     2933     if par-type = '@client':U then do:
     2934       if pard-card <> ('K':U + string(if parcli-type = 'орг':U then 1 else 0) + string(parcli-code, '999999999')) then do:
     2935           assign
     2936           v-err-mess = substitute("Для карты типа &1 возможно только уникальное значение номера карты клиента = &2"
     2937                                    ,'@client':U
     2938                                    ,('K':U + string(if parcli-type = 'орг':U then 1 else 0) + string(parcli-code, '999999999')) ).
     2939           run err-mess in this-procedure ( input-output v-err-mess).
     2940           var-entry = "d-card":U.
     2941           return error (if p-silent = yes then v-err-mess else var-entry).
     2942       end.
     2943     end.
     2944     else do:
     2945       if trim(pard-card) <> pard-card then do:
     2946         assign
     2947         v-err-mess = substitute("В номере карты присутствуют недопустиые символы").
     2948         run err-mess in this-procedure ( input-output v-err-mess).
     2949         var-entry = "d-card":U.
     2950         return error (if p-silent = ? then v-err-mess else var-entry).
     2951       end.
     2952       if buf_dis-card-type.card-media = integer('5':U) then do:
     2953         if length(pard-card) <> 8
     2954         or trim(pard-card, "1234567890ABCDEF") <> ""
     2955         or CAPS(pard-card) <> pard-card
     2956         or pard-card = "00000000"
     2957         then do:
     2958           assign
     2959           v-err-mess = substitute("Идентификатор карты EASYFUEL должен представлять 16-чное число&1" +
     2960                                   "и быть длиной 8 символов," +
     2961                                   "разрешены только цифры и ПРОПИСНЫЕ латинские A, B, C, D, E, F,&1" +
     2962                                   "идентификатор 00000000 не разрешен"
     2963                                   ,chr(10))
     2964           .
     2965           run err-mess in this-procedure ( input-output v-err-mess).
     2966           var-entry = "d-card":U.
     2967           return error (if p-silent = yes then v-err-mess else var-entry).
     2968         end.
     2969       end.
     2970       else do:
     2971         dd = decimal( pard-card ) no-error.
     2972         if ( error-status:error ) OR
     2973             index( pard-card , "." ) > 0 OR
     2974             index( pard-card , chr(44) ) > 0 OR
     2975             index( pard-card , "-" ) > 0 OR
     2976             index( pard-card , "+" ) > 0 then
     2977             do:
     2978             assign
     2979             v-err-mess = substitute("Возможно только цифровое значение номера дисконтной карты клиента").
     2980             run err-mess in this-procedure ( input-output v-err-mess).
     2981             var-entry = "d-card":U.
     2982             return error (if p-silent = yes then v-err-mess else var-entry).
     2983         end.
     2984         run ref/dcardi04.p (
     2985                         input pard-card
     2986                         ,input par-type
     2987                         ,input paremitent-host-code
     2988                         ,input parissue-code
     2989                         ,output v-can-issue              ) no-error .
     2990         if error-status:error then do:
     2991           assign
     2992           v-err-mess = substitute("Ошибка при проверке корректности № карты:&1&2 &4"
     2993                                     , chr(10)
     2994                                     , error-status:get-message(1)
     2995                                     , return-value
     2996                                       ).
     2997             run err-mess in this-procedure ( input-output v-err-mess).
     2998             var-entry = "d-card":U.
     2999             return error (if p-silent = yes then v-err-mess else var-entry).
     3000         end.
     3001         if not v-can-issue then do:
     3002           assign
     3003           v-err-mess = substitute("Некорректный номер карты:&1"
     3004                                     , return-value
     3005                                       ).
     3006           run err-mess in this-procedure ( input-output v-err-mess).
     3007           var-entry = "d-card":U.
     3008           return error (if p-silent = yes then v-err-mess else var-entry).
     3009         end.
     3010       end.
     3011     end.
     3012   end.
     3013   _main:
     3014   do for buf_dis-card,
     3015          source_dis-card,
     3016          main_dis-card
     3017   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3018   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     3019   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     3020   :
     3021   if par-mode = 'ДОБАВЛЕНИЕ':U then do:
     3022     if can-find( FIRST ub.dis-card No-LOCK where
     3023                       ub.dis-card.d-card = pard-card
     3024                          ) then do:
     3025       assign
     3026       v-err-mess = substitute("Уже есть глобальная дисконтная карта&1 с номером &2"
     3027                   , (if paremitent-host-code = 0
     3028                     then "":U
     3029                     else substitute(" на фирме &1", paremitent-host-code))
     3030                   , pard-card
     3031                   ).
     3032       run err-mess in this-procedure ( input-output v-err-mess).
     3033       var-entry = "d-card":U.
     3034       return error (if p-silent = yes then v-err-mess else var-entry).
     3035     end.
     3036     define variable v-param-type as character no-undo .
     3037     define variable v-value-character as character no-undo .
     3038     define variable v-value-date as date no-undo .
     3039     define variable v-value-decimal as decimal no-undo .
     3040     define variable v-value-integer as INTEGER no-undo .
     3041     define variable l-zeros AS LOGICAL no-undo .
     3042     define variable v-tth as handle no-undo .
     3043     run adm/shattri.p (
     3044         input "get":U
     3045         ,input  ''
     3046         ,input  0
     3047         ,input  'dc-ref':U
     3048         ,input  'l-zeros':U
     3049         ,output v-value-character
     3050         ,output v-value-date
     3051         ,output v-value-decimal
     3052         ,output v-value-integer
     3053         ,output l-zeros
     3054         ,output v-param-type
     3055         ,INPUT-OUTPUT table-handle v-tth
     3056         )  .
     3057     delete object v-tth no-error.
     3058     if not l-zeros then do:
     3059     assign
     3060     v-dop-d-card = left-trim(pard-card, "0") .
     3061     DO II = 1  to (19 - length(v-dop-d-card)) + 1:
     3062       if can-find(first ub.dis-card no-lock where
     3063                         ub.dis-card.d-card = v-dop-d-card
     3064                     and ub.dis-card.status_ <> 'удал':U
     3065                         )  then do:
     3066       assign
     3067         v-err-mess = substitute("Уже есть НЕУДАЛЕННАЯ дисконтная карта&1 с номером &2 - совпадает с &3 с точностью до лидирующих нулей"
     3068                   , (if paremitent-host-code = 0
     3069                     then "":U
     3070                     else substitute(" на фирме &1", paremitent-host-code))
     3071                     ,v-dop-d-card
     3072                     ,pard-card
     3073                     ).
     3074       run err-mess in this-procedure ( input-output v-err-mess).
     3075         var-entry = "d-card":U.
     3076         return error (if p-silent = yes then v-err-mess else var-entry).
     3077       end.
     3078       assign
     3079       v-dop-d-card = "0" + v-dop-d-card
     3080       .
     3081     end.
     3082     end.
     3083     assign
     3084     v-first-card = pard-card
     3085     v-first-main-card = pard-card
     3086     .
     3087     if parsourced-card <> "" then do:
     3088       find first source_dis-card exclusive-LOCK WHERE
     3089                 source_dis-card.d-card = parsourced-card  No-ERROR.
     3090       if not available source_dis-card
     3091       and not locked(source_dis-card)
     3092       then do:
     3093         assign
     3094         v-err-mess  = substitute("Не найдена карта, к которой перевыпускается текущая карта", parsourced-card).
     3095         run err-mess in this-procedure ( input-output v-err-mess).
     3096         var-entry = "sourced-card":U.
     3097         return error (if p-silent = yes then v-err-mess else var-entry).
     3098       end.
     3099       if source_dis-card.status_ = 'неисп':U
     3100       or source_dis-card.status_ = 'смкли':U then do:
     3101         v-err-mess = substitute("Карта к которой, перевыпускается текущая карта, - &1 имеет статус &2&3" +
     3102                                 "перевыпуск запрещен"
     3103                     , parsourced-card
     3104                     ,source_dis-card.status_
     3105                     ,chr(10)
     3106                     ).
     3107       end.
     3108       if source_dis-card.emitent-host-code <> paremitent-host-code then do:
     3109         assign
     3110         v-err-mess = substitute("Карта к которой, перевыпускается текущая карта, - &1 имеет другого эмитента &2"
     3111                     , parsourced-card
     3112                     ,source_dis-card.emitent-host-code).
     3113         run err-mess in this-procedure ( input-output v-err-mess).
     3114         var-entry = "sourced-card":U.
     3115         return error (if p-silent = yes then v-err-mess else var-entry) .
     3116       end.
     3117       if source_dis-card.is-subsid then do:
     3118         assign
     3119         v-err-mess = substitute("Карта к которой, перевыпускается текущая карта, - &1 является дополнительной&2" +
     3120                                 "перевыпуск запрещен"
     3121                     , parsourced-card
     3122                     ,chr(10)).
     3123         run err-mess in this-procedure ( input-output v-err-mess).
     3124         var-entry = "sourced-card":U.
     3125         return error (if p-silent = yes then v-err-mess else var-entry) .
     3126       end.
     3127       if NOT (source_dis-card.cli-type = parcli-type AND
     3128               source_dis-card.cli-code = parcli-code) then do:
     3129         assign
     3130         v-err-mess = substitute("Карта к которой, перевыпускается текущая карта, - &1 выдана другому клиенту &2&3"
     3131                     , parsourced-card
     3132                     , source_dis-card.cli-type
     3133                     , source_dis-card.cli-code).
     3134         run err-mess in this-procedure ( input-output v-err-mess).
     3135         return error v-err-mess.
     3136       end.
     3137       varcard-num = source_dis-card.card-num.
     3138       if varcard-num = 0 then do:
     3139         assign
     3140         v-err-mess = substitute("Неверный внутренний № (&1) у карты &2, к которой перевыпускается текущая карта"
     3141                     , varcard-num
     3142                     , parsourced-card
     3143                      ).
     3144         run err-mess in this-procedure ( input-output v-err-mess).
     3145         return error v-err-mess.
     3146       end.
     3147       for each other_dis-card no-lock where
     3148               other_dis-card.card-num = source_dis-card.card-num
     3149          AND  other_dis-card.sourced-card = parsourced-card:
     3150           LEAVE.
     3151       end.
     3152       if available other_dis-card
     3153       and
     3154       other_dis-card.d-card <> pard-card  then do:
     3155         assign
     3156         v-err-mess = substitute("К карте &1 уже перевыпущена другая карта - &2"
     3157                      , parsourced-card
     3158                      , other_dis-card.d-card).
     3159         run err-mess in this-procedure ( input-output v-err-mess).
     3160         var-entry = "sourced-card":U.
     3161         return error (if p-silent = yes then v-err-mess else var-entry).
     3162       end.
     3163       assign
     3164       v-first-main-card = source_dis-card.first-main-card
     3165       v-first-card = source_dis-card.first-card.
     3166       v-overissue-num = source_dis-card.overissue-num + 1.
     3167     end.
     3168     if paris-subsid <> no then do:
     3169       find first main_dis-card exclusive-LOCK WHERE
     3170                 main_dis-card.d-card = parmain-card  No-ERROR.
     3171       if not available main_dis-card
     3172       and not locked(main_dis-card)
     3173       then do:
     3174         assign
     3175         v-err-mess  = substitute("Не найдена ОСНОВНАЯ карта, к которой выпускается текущая ДОПОЛНИТЕЛЬНАЯ карта", parsourced-card).
     3176         run err-mess in this-procedure ( input-output v-err-mess).
     3177         var-entry = "main-card":U.
     3178         return error (if p-silent = yes then v-err-mess else var-entry).
     3179       end.
     3180       if main_dis-card.status_ = 'неисп':U
     3181       or main_dis-card.status_ = 'смкли':U then do:
     3182         v-err-mess = substitute("Основная карта, к которой перевыпускается текущая Дополнительная карта, - &1 имеет статус &2&3" +
     3183                                 "выпуск запрещен"
     3184                     , parmain-card
     3185                     ,main_dis-card.status_
     3186                     ,chr(10)
     3187                     ).
     3188       end.
     3189       if main_dis-card.is-subsid = yes
     3190       or main_dis-card.status_ = 'смкли':U then do:
     3191         v-err-mess = substitute("Основная карта к которой, перевыпускается текущая Дополнительная карта, - &1 сама является Дополнительной&2" +
     3192                                 "выпуск запрещен"
     3193                     , parmain-card
     3194                     ,chr(10)
     3195                     ).
     3196       end.
     3197       if main_dis-card.emitent-host-code <> paremitent-host-code then do:
     3198         assign
     3199         v-err-mess = substitute("ОСНОВНАЯ Карта к которой, выпускается текущая карта, - &1 имеет другого эмитента &2"
     3200                     , parmain-card
     3201                     ,main_dis-card.emitent-host-code).
     3202         run err-mess in this-procedure ( input-output v-err-mess).
     3203         var-entry = "main-card":U.
     3204         return error (if p-silent = yes then v-err-mess else var-entry) .
     3205       end.
     3206       assign
     3207       v-first-main-card = main_dis-card.first-main-card
     3208       v-first-card = main_dis-card.first-card
     3209       v-overissue-num = main_dis-card.overissue-num.
     3210     end.
     3211     if varcard-num = 0 then do:
     3212       run gen-b-code in this-procedure ( input 'dcgb':U, output varcard-num) no-error .
     3213       if error-status:error then do:
     3214         assign
     3215         v-err-mess = substitute("Ошибка при генерации внутреннего № ДК").
     3216         run err-mess in this-procedure ( input-output v-err-mess).
     3217         var-entry = "card-num":U.
     3218         return error (if p-silent = yes then v-err-mess else var-entry).
     3219       end.
     3220     end.
     3221     CREATE buf_dis-card.
     3222     assign
