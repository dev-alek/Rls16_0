        1   define input  parameter parParentProc  as widget-handle no-undo.
        2   define input  parameter bttns  as char   no-undo .
        3   define output parameter rid-list    as  char no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Справочник сезонов".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   procedure proc-alt-shift-f2:
       65     if not ibs.th.gbl.gbl-var:rcode
       66   then
       67     run gbl\inidebug.p .
       68   end.
       69   procedure proc-alt-shift-f3:
       70     run gbl/prvssinf.p
       71       ( input this-procedure
       72       ) .
       73   end.
       74   define variable v-inform-launched as logical no-undo initial false .
       75   procedure proc-alt-shift-f4:
       76     define variable v-action as character no-undo .
       77     if v-inform-launched = false then do:
       78       assign
       79         v-inform-launched = true
       80       .
       81       run gbl/d-inform.w
       82         (  input self
       83         ,  input this-procedure
       84         , output v-action
       85         ) no-error .
       86       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       87       assign
       88         v-inform-launched = false
       89       .
       90     end.
       91   end.
       92   procedure proc-alt-f1:
       93     run gbl/corrhelp.p
       94       (input this-procedure
       95       ) .
       96   end .
       97   on alt-shift-f2 anywhere do:
       98     run proc-alt-shift-f2.
       99   end.
      100   on alt-shift-f3 anywhere do:
      101     run proc-alt-shift-f3 in this-procedure .
      102   end.
      103   on alt-shift-f4 anywhere do:
      104     run proc-alt-shift-f4 in this-procedure.
      105   end.
      106   on alt-f1 anywhere do:
      107     run proc-alt-f1 in this-procedure .
      108   end.
      109   define new global shared variable g#language as character no-undo .
      110   if g#language <> '' and g#language <> 'rus':U then do:
      111     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      112   end.
      113   define new global shared variable g#library  as handle no-undo .
      114   define new global shared variable g#library2 as handle no-undo .
      115   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116     define variable v-cntxt-db-num        as integer   no-undo .
      117     define variable v-cntxt-userid        as character no-undo .
      118     define variable v-cntxt-level         as character no-undo .
      119     define variable v-cntxt-host-code-obj as integer   no-undo .
      120     define variable v-cntxt-obj-type      as character no-undo .
      121     define variable v-cntxt-obj-code      as integer   no-undo .
      122     define variable v-cntxt-db-num-obj    as integer   no-undo .
      123     define variable v-cntxt-is-admin      as logical   no-undo .
      124   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      126   define new shared variable RepPathName        as character no-undo .
      127   define new shared variable PrintRubl          as logical   no-undo .
      128   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129   procedure cur-time :
      130      define output parameter p-today as date      no-undo .
      131      define output parameter p-time  as integer   no-undo .
      132     do
      133     on error undo, return error
      134     :
      135       define variable v-date1 as date      no-undo .
      136       define variable v-date2 as date      no-undo .
      137       define variable v-time  as integer   no-undo .
      138       assign
      139         v-date1 = today
      140         v-time  = time
      141         v-date2 = today
      142       .
      143       if v-date1 <> v-date2
      144       then do:
      145         assign
      146           v-date1 = today
      147           v-time  = v-time
      148         .
      149       end.
      150       assign
      151         p-today = v-date1
      152         p-time  = v-time
      153       .
      154     end.
      155   end.
      156   function cur-time-date returns character
      157   :
      158     return string(today, '99/99/9999':U) .
      159   end.
      160   function cur-time-mjd returns decimal
      161   :
      162     define variable v-date as date      no-undo .
      163     define variable v-time as integer   no-undo .
      164     run cur-time in this-procedure
      165       (output v-date
      166       ,output v-time
      167       ) .
      168     return integer(v-date) - 2400002 + (v-time / 86400) .
      169   end.
      170   function cur-time-get-ending-index returns integer
      171   (input p-number as integer
      172   )
      173   :
      174     if p-number < 0
      175     or p-number = ?
      176     then do:
      177       return 1 .
      178     end.
      179     define variable v-rest as integer   no-undo .
      180     assign
      181       p-number = p-number modulo 100
      182     .
      183     if p-number < 20
      184     then do:
      185       assign
      186         v-rest = p-number
      187       .
      188     end.
      189     else do:
      190       assign
      191         v-rest = p-number modulo 10
      192       .
      193     end.
      194     case v-rest :
      195       when 1
      196       then do:
      197         return 2 .
      198       end.
      199       when 2 or
      200       when 3 or
      201       when 4
      202       then do:
      203         return 3 .
      204       end.
      205       otherwise do:
      206         return 1 .
      207       end.
      208     end case .
      209   end.
      210   procedure cur-time-mjd-to-date :
      211      define input  parameter i-mjd-diff as decimal no-undo.
      212      define output parameter o-Date     as date    no-undo.
      213      define output parameter o-Time     as integer no-undo.
      214      define variable v-day-number as integer   no-undo .
      215      if    i-mjd-diff < 0
      216         or i-mjd-diff = ?
      217      then do:
      218         return "?" .
      219      end.
      220      assign
      221         v-day-number = truncate(i-mjd-diff,0).
      222         o-Date = date(v-day-number + 2400002).
      223         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      224     .
      225   end.
      226   function cur-time-mjd-to-string returns character
      227   (input p-mjd-diff as decimal
      228   )
      229   :
      230     define variable v-day-number as integer   no-undo .
      231     define variable v-seconds    as integer   no-undo .
      232     define variable v-hour       as integer   no-undo .
      233     define variable v-min        as integer   no-undo .
      234     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      235     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      236     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      237     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      238     if p-mjd-diff < 0
      239     or p-mjd-diff = ?
      240     then do:
      241       return "?" .
      242     end.
      243     assign
      244       v-day-number = integer(truncate(p-mjd-diff,0))
      245       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      246     .
      247     if v-seconds > 86400
      248     then do:
      249       assign
      250         v-seconds = 86400 - 1
      251       .
      252     end.
      253     if v-seconds < 0
      254     then do:
      255       assign
      256         v-seconds = 0
      257       .
      258     end.
      259     assign
      260       v-hour = truncate(v-seconds / 3600, 0)
      261     .
      262     assign
      263       v-seconds = v-seconds modulo 3600
      264     .
      265     assign
      266       v-min = truncate(v-seconds / 60, 0)
      267     .
      268     assign
      269       v-seconds = v-seconds modulo 60
      270     .
      271     return
      272         (if v-day-number <> 0
      273           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      274           else ""
      275         )
      276       + (if v-day-number <> 0 or v-hour <> 0
      277           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      278           else ""
      279         )
      280       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      281           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      282           else ""
      283         )
      284       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      285       .
      286   end.
      287   function cur-time-string returns character
      288   :
      289     define variable v-date as date      no-undo .
      290     define variable v-time as integer   no-undo .
      291     run cur-time in this-procedure
      292       (output v-date
      293       ,output v-time
      294       ) .
      295     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      296   end.
      297   function cur-time-string-sec returns character
      298   :
      299     define variable v-date as date      no-undo .
      300     define variable v-time as integer   no-undo .
      301     run cur-time in this-procedure
      302       (output v-date
      303       ,output v-time
      304       ) .
      305     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      306   end.
      307   function cur-time-custom  returns character
      308   (input p-prefix as character
      309   ,input p-date-format as character
      310   ,input p-delimiter as character
      311   ,input p-time-format as character
      312   ,input p-suffix as character
      313   )
      314   :
      315     define variable v-date as date      no-undo .
      316     define variable v-time as integer   no-undo .
      317     run cur-time in this-procedure
      318       (output v-date
      319       ,output v-time
      320       ) .
      321     return
      322       p-prefix
      323       + string(v-date, p-date-format)
      324       + p-delimiter
      325       + string(v-time, p-time-format)
      326       + p-suffix
      327       .
      328   end.
      329   function cur-time-print  returns character
      330   :
      331     define variable v-date as date      no-undo .
      332     define variable v-time as integer   no-undo .
      333     run cur-time in this-procedure
      334       (output v-date
      335       ,output v-time
      336       ) .
      337     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      338   end.
      339   function cur-time-datetime returns datetime
      340   :
      341     define variable v-char as character no-undo .
      342     define variable v-datetime as datetime no-undo .
      343     v-char = cur-time-string().
      344     v-datetime = datetime(v-char).
      345     return  v-datetime.
      346   end.
      347   function cur-time-string-msec returns character
      348   :
      349     define variable v-date as datetime  no-undo .
      350     v-date = now.
      351     return string(v-date) .
      352   end.
      353   function diff-list returns character (
      354     input parfirst-list  as character,
      355     input parsecond-list as character,
      356     input pardelim       as character).
      357     if pardelim = ""
      358     or pardelim = ?
      359     then do:
      360       assign
      361         pardelim = ","
      362       .
      363     end.
      364     def var ind as integer no-undo .
      365     def var v-elem as character no-undo .
      366     def var v-result-list as character no-undo init "".
      367     def var v-num-parfirst-list as integer no-undo .
      368     assign
      369       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      370     .
      371     do ind = 1 to v-num-parfirst-list
      372     :
      373       assign
      374         v-elem = entry(ind, parfirst-list, pardelim)
      375       .
      376       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      377         assign
      378           v-result-list = v-result-list
      379                         + (if v-result-list > "" then pardelim else "")
      380                         + v-elem
      381         .
      382       end.
      383     end.
      384     return v-result-list .
      385   end function.
      386   function add-list returns character (
      387    input parfirst-list  as character,
      388    input parsecond-list as character,
      389    input pardelim       as character).
      390     if pardelim = ""
      391     or pardelim = ?
      392     then do:
      393       assign
      394         pardelim = ","
      395       .
      396     end.
      397     def var ind as integer no-undo .
      398     def var v-elem as character no-undo .
      399     def var v-result-list as character no-undo init "".
      400     def var v-num-parfirst-list as integer no-undo .
      401     assign
      402       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      403     .
      404     do ind = 1 to v-num-parfirst-list
      405     :
      406       assign
      407         v-elem = entry(ind, parfirst-list, pardelim)
      408       .
      409       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      410         assign
      411           v-result-list = v-result-list
      412                         + (if v-result-list > "" then pardelim else "")
      413                         + v-elem
      414         .
      415       end.
      416     end.
      417     def var v-num-parsecond-list as integer no-undo .
      418     assign
      419       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      420     .
      421     do ind = 1 to v-num-parsecond-list
      422     :
      423       assign
      424         v-elem = entry(ind, parsecond-list, pardelim)
      425       .
      426       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      427         assign
      428           v-result-list = v-result-list
      429                         + (if v-result-list > "" then pardelim else "")
      430                         + v-elem
      431         .
      432       end.
      433     end.
      434     return v-result-list .
      435   end function.
      436   function cross-list returns character (
      437    input parfirst-list  as character,
      438    input parsecond-list as character,
      439    input pardelim       as character).
      440     if pardelim = ""
      441     or pardelim = ?
      442     then do:
      443       assign
      444         pardelim = ","
      445       .
      446     end.
      447     def var ind as integer no-undo .
      448     def var v-elem as character no-undo .
      449     def var v-result-list as character no-undo init "".
      450     def var v-num-parfirst-list as integer no-undo .
      451     assign
      452       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      453     .
      454     do ind = 1 to v-num-parfirst-list
      455     :
      456       assign
      457         v-elem = entry(ind, parfirst-list, pardelim)
      458       .
      459       if lookup(v-elem, v-result-list, pardelim) = 0
      460       and lookup(v-elem, parsecond-list, pardelim) > 0
      461       then do:
      462         assign
      463           v-result-list = v-result-list
      464                         + (if v-result-list > "" then pardelim else "")
      465                         + v-elem
      466         .
      467       end.
      468     end.
      469     return v-result-list .
      470   end function.
      471   function radio-label returns character (
      472    input par-rs-value  as character,
      473    input par-rs-radio-buttons as character)
      474    .
      475    DEFINE variable v-result-label as character no-undo.
      476    assign
      477    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      478                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      479                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      480                             ), par-rs-radio-buttons
      481                           )
      482    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      483    .
      484   return v-result-label.
      485   end function.
      486   function m-radio-label returns character (
      487    input par-rs-value  as character,
      488    input par-rs-radio-buttons as character,
      489    input par-delim as character
      490    )
      491    .
      492    DEFINE variable v-result-label as character no-undo.
      493    assign
      494    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      495                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      496                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      497                             ), par-rs-radio-buttons, par-delim
      498                           )
      499    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      500    .
      501   return v-result-label.
      502   end function.
      503   FUNCTION mixlist returns character
      504   (
      505    input parfirst-list  as character
      506    ,input parsecond-list as character
      507    ,input pardelim       as character
      508    ,input pardelim-result as character ) :
      509     if pardelim = ""
      510     or pardelim = ?
      511     then do:
      512       assign
      513         pardelim = ","
      514       .
      515     end.
      516     def var ind as integer no-undo .
      517     def var v-elem1 as character no-undo .
      518     def var v-elem2 as character no-undo .
      519     def var v-result-list as character no-undo init "".
      520     do ind = 1 to num-entries(parfirst-list, pardelim)
      521     :
      522       assign
      523         v-elem1 = entry(ind, parfirst-list, pardelim)
      524         v-elem2 = entry(ind, parsecond-list, pardelim)
      525       .
      526         assign
      527           v-result-list = v-result-list
      528                         + (if v-result-list > "" then pardelim-result else "")
      529                         + v-elem1 + pardelim-result + v-elem2
      530         .
      531     end.
      532     return v-result-list .
      533   END FUNCTION.
      534   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      535   define variable v-waitfram-action01         as character   no-undo .
      536   define variable v-waitfram-action02         as character   no-undo .
      537   define variable v-waitfram-action03         as character   no-undo .
      538   define variable mWaitFramTextBeg            as character   no-undo.
      539   define variable mWaitFramTextEnd            as character   no-undo.
      540   define variable mWaitFramView               as logical     no-undo.
      541   define variable mWaitProcEvent              as logical     no-undo init yes.
      542   define variable mWaitFramInterval           as integer     no-undo init 1 .
      543   define variable mWaitFramStop               as logical     no-undo.
      544   define variable mWaitFramStopUser           as logical     no-undo.
      545   define variable mWaitFramStopTimeOut        as logical     no-undo.
      546   define variable mWaitFramStartProc          as datetime-tz no-undo.
