     1103   ON MOUSE-SELECT-DBLCLICK OF br-coll IN FRAME d-type-tmp
     1104   DO:
     1105       if lookup ( "b-sel", bttns ) > 0  then
     1106           do:
     1107               apply "choose" to b-sel in frame d-type-tmp .
     1108               return no-apply .
     1109           end.
     1110   END.
     1111   ON RETURN OF br-coll IN FRAME d-type-tmp
     1112   DO:
     1113       if Lookup( "b-sel",  bttns ) > 0 then
     1114           do:
     1115               apply "choose" to b-sel in frame d-type-tmp .
     1116               return no-apply .
     1117           end.
     1118       else
     1119           apply "DEFAULT-ACTION":U to self.
     1120   END.
     1121   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-type-tmp:PARENT eq ?
     1122   THEN FRAME d-type-tmp:PARENT = ACTIVE-WINDOW.
     1123   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1124   on help of frame d-type-tmp
     1125   do:
     1126     run gbl/app_help.p
     1127       (input this-procedure :file-name
     1128       ,input ''
     1129       ,input ?
     1130       ) no-error.
     1131     if error-status :error then do:
     1132       message
     1133         "Ошибка при вызове помощи"
     1134         error-status :get-message(1)
     1135         view-as alert-box .
     1136     end.
     1137   end.
     1138   run minbtn-set in this-procedure .
     1139   on choose of b-help in frame d-type-tmp
     1140   do:
     1141     apply "help":u to frame d-type-tmp .
     1142   end.
     1143   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1144   procedure minbtn-set :
     1145       do
     1146           on error undo, return error return-value
     1147           :
     1148           define variable ii              as integer       no-undo .
     1149           define variable fh              as widget-handle no-undo .
     1150           define variable hh              as widget-handle no-undo .
     1151           define variable v-h             as handle        extent 4 no-undo .
     1152           define variable v-name-button   as character     no-undo .
     1153           define variable v-help-old-x    as decimal       no-undo .
     1154           define variable v-help-old-y    as decimal       no-undo .
     1155           define variable v-help-old-size as decimal       no-undo .
     1156           define variable v-frame-width   as decimal       no-undo .
     1157           define variable jj              as integer       no-undo .
     1158           do
     1159               on error undo, return error
     1160               :
     1161               assign
     1162                   v-frame-width = frame d-type-tmp:width - 0.3
     1163                   fh            = frame d-type-tmp:first-child
     1164                   hh            = fh:first-child
     1165                   ii            = 1
     1166                   .
     1167               do while valid-handle(hh):
     1168                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1169                   do:
     1170                       case lc(hh:name) :
     1171                           when "b-help" then
     1172                               do:
     1173                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1174                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1175                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1176                                   hh:TOOLTIP = "Помощь" .
     1177                                   v-help-old-x = hh:column .
     1178                                   v-help-old-y = hh:row    .
     1179                                   v-help-old-size = hh:width .
     1180                                   hh:width-chars = 2.5 .
     1181                               end.
     1182                           when "b-print" then
     1183                               do:
     1184                                   hh:load-image("cmp/b-print.bmp":u) .
     1185                                   hh:TOOLTIP = "Печать" .
     1186                                   v-h[ii] = hh:handle .
     1187                                   ii = ii + 1 .
     1188                                   hh:width-chars = 3 .
     1189                               end.
     1190                           when "b-history" or
     1191                           when "b-hist" then
     1192                               do:
     1193                                   hh:load-image("cmp/b-hist.bmp":u) .
     1194                                   hh:TOOLTIP = "История" .
     1195                                   v-h[ii] = hh:handle .
     1196                                   ii = ii + 1 .
     1197                                   hh:width-chars = 3 .
     1198                               end.
     1199                           when "b-sch" then
     1200                               do:
     1201                                   hh:load-image("cmp/b-sch.bmp":u) .
     1202                                   hh:TOOLTIP = "Установка Фильтра" .
     1203                                   v-h[ii] = hh:handle .
     1204                                   ii = ii + 1 .
     1205                                   hh:width-chars = 3 .
     1206                               end.
     1207                           when "b-hist-user" then
     1208                               do:
     1209                                   hh:load-image("cmp/b-hist.bmp":u) .
     1210                                   hh:TOOLTIP = "История пользователя" .
     1211                                   ii = ii + 1 .
     1212                               end.
     1213                       end case.
     1214                   end.
     1215                   hh = hh:next-sibling.
     1216               end.
     1217               b-help:column = v-frame-width - b-help:width-chars.
     1218               jj = 0.
     1219               repeat ii = 4 to 1 by -1 :
     1220                   if valid-handle (v-h[ii] ) then
     1221                   do:
     1222                       jj  = jj + 1 .
     1223                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1224                       v-h[ii]:row    = v-help-old-y .
     1225                   end.
     1226               end.
     1227           end.
     1228       end.
     1229   end procedure.
     1230   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1231   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1232   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1233   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1234   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1235   define variable v-diasize-current-frame-height as decimal   no-undo .
     1236   define variable v-diasize-change-size          as logical   no-undo .
     1237   define variable v-diasize-resize-button        as handle    no-undo .
     1238   define variable v-diasize-wndmax               as logical   no-undo .
     1239   define variable v-diasize-wndstore             as logical   no-undo .
     1240   define variable v-diasize-proc-name            as character no-undo .
     1241   define variable v-diasize-browse-handle        as handle    no-undo .
     1242   define variable v-diasize-browse-number        as integer   no-undo .
     1243   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1244   define temp-table temp-diasize-handle no-undo
     1245     field handle-value  as handle
     1246     field save-position as decimal
     1247     index xpk is primary unique handle-value
     1248     .
     1249   define temp-table temp-browse-handle no-undo
     1250     field browse-type   as character
     1251     field browse-number as integer
     1252     field browse-handle as handle
     1253     field original-size as decimal
     1254     index xpk is primary unique browse-type browse-number
     1255     index xie browse-type browse-handle
     1256   .
     1257   procedure diasize_change-height :
     1258     define input  parameter p-change-value  as decimal   no-undo .
     1259     define input  parameter p-move-resize   as logical   no-undo .
     1260     define variable v-field-group-handle    as handle    no-undo .
     1261     define variable v-object-handle         as handle    no-undo .
     1262     define variable v-frame-height          as decimal   no-undo .
     1263     define variable v-frame-virtual-height  as decimal   no-undo .
     1264     define variable v-browse-height         as decimal   no-undo .
     1265     define variable v-window-height         as decimal   no-undo .
     1266     define variable v-window-virtual-height as decimal   no-undo .
     1267     define variable v-change-sign           as integer   no-undo .
     1268     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1269     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1270     if p-change-value > 0
     1271     then do:
     1272       if frame d-type-tmp :height + p-change-value
     1273           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1274       then do:
     1275         assign
     1276           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1277                           - (frame d-type-tmp :height-chars)
     1278         .
     1279         if p-change-value <= 0
     1280         then do:
     1281           run diasize_position-resize-button in this-procedure .
     1282           return .
     1283         end.
     1284       end.
     1285     end.
     1286     if p-change-value < 0
     1287     then do:
     1288       if frame d-type-tmp :height + p-change-value < v-diasize-orig-frame-height
     1289       then do:
     1290         assign
     1291           p-change-value = v-diasize-orig-frame-height
     1292                          - (frame d-type-tmp :height-chars)
     1293         .
     1294         if p-change-value >= 0
     1295         then do:
     1296           run diasize_position-resize-button in this-procedure .
     1297           return .
     1298         end.
     1299       end.
     1300     end.
     1301     if p-change-value >= 0
     1302     then do:
     1303       assign
     1304         v-change-sign = 1
     1305       .
     1306     end.
     1307     else do:
     1308       assign
     1309         v-change-sign = -1
     1310       .
     1311     end.
     1312     assign
     1313       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1314     .
     1315     if p-change-value = 0
     1316     then do:
     1317       run diasize_position-resize-button in this-procedure .
     1318       return .
     1319     end.
     1320     move_block:
     1321     do
     1322     on error undo move_block, retry move_block
     1323     :
     1324       if retry
     1325       then do:
     1326         do
     1327         on error undo move_block, leave move_block
     1328         :
     1329           if p-change-value > 0
     1330           then do:
     1331             for each buf_temp-diasize-handle
     1332             on error undo, next
     1333             :
     1334               assign
     1335                 v-object-handle = buf_temp-diasize-handle.handle-value
     1336               .
     1337               if v-object-handle <> v-diasize-resize-button
     1338               then do:
     1339                 assign
     1340                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1341                 .
     1342               end.
     1343             end.
     1344             assign
     1345               v-diasize-browse-handle :height = v-browse-height
     1346             .
     1347             for each buf_temp-browse-handle
     1348               where buf_temp-browse-handle.browse-type = 'height':u
     1349             on error undo, next
     1350             :
     1351               assign
     1352                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1353               .
     1354             end.
     1355             assign
     1356               frame d-type-tmp :height = v-frame-height
     1357             .
     1358             if frame d-type-tmp :scrollable = true
     1359             then do:
     1360               assign
     1361                 frame d-type-tmp :virtual-height = v-frame-virtual-height
     1362               .
     1363             end.
     1364             run diasize_position-resize-button in this-procedure .
     1365           end.
     1366           else do:
     1367             if frame d-type-tmp :scrollable = true
     1368             then do:
     1369               assign
     1370                 frame d-type-tmp :virtual-height = v-frame-virtual-height
     1371               .
     1372             end.
     1373             assign
     1374               frame d-type-tmp :height = v-frame-height
     1375             .
     1376             assign
     1377               v-diasize-browse-handle :height = v-browse-height
     1378             .
     1379             for each buf_temp-browse-handle
     1380               where buf_temp-browse-handle.browse-type = 'height':u
     1381             on error undo, next
     1382             :
     1383               assign
     1384                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1385               .
     1386             end.
     1387             for each buf_temp-diasize-handle
     1388             on error undo, next
     1389             :
     1390               assign
     1391                 v-object-handle = buf_temp-diasize-handle.handle-value
     1392               .
     1393               if v-object-handle <> v-diasize-resize-button
     1394               then do:
     1395                 assign
     1396                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1397                 .
     1398               end.
     1399             end.
     1400             run diasize_position-resize-button in this-procedure .
     1401           end.
     1402           assign
     1403             v-diasize-change-size = false
     1404           .
     1405           leave move_block .
     1406         end.
     1407       end.
     1408       assign
     1409         v-diasize-need-full-display = true
     1410       .
     1411       if v-diasize-change-size = false
     1412       then do:
     1413         assign
     1414           v-diasize-change-size = true
     1415         .
     1416       end.
     1417       else do:
     1418         return .
     1419       end.
     1420       assign
     1421         v-frame-height = frame d-type-tmp :height
     1422         v-frame-virtual-height = frame d-type-tmp :virtual-height
     1423         v-browse-height = v-diasize-browse-handle :height
     1424       .
     1425       for each buf_temp-browse-handle
     1426         where buf_temp-browse-handle.browse-type = 'height':u
     1427       :
     1428         assign
     1429           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1430         .
     1431       end.
     1432       for each buf_temp-diasize-handle
     1433       :
     1434         delete buf_temp-diasize-handle .
     1435       end.
     1436       assign
     1437         v-field-group-handle = frame d-type-tmp :first-child
     1438       .
     1439       do while valid-handle(v-field-group-handle)
     1440       :
     1441         assign
     1442           v-object-handle = v-field-group-handle :first-child
     1443         .
     1444         do while valid-handle(v-object-handle)
     1445         :
     1446           if  v-object-handle <> v-diasize-browse-handle :handle
     1447           and can-query(v-object-handle, "row")
     1448           and can-query(v-object-handle, "height")
     1449           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1450           then do:
     1451             find first buf_temp-browse-handle
     1452               where buf_temp-browse-handle.browse-type   = 'height':u
     1453                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1454               no-error .
     1455             if available buf_temp-browse-handle
     1456             then do:
     1457             end.
     1458             else do:
     1459               create buf_temp-diasize-handle .
     1460               assign
     1461                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1462                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1463               .
     1464             end.
     1465           end.
     1466           assign
     1467             v-object-handle = v-object-handle :next-sibling
     1468           .
     1469         end.
     1470         assign
     1471           v-field-group-handle = v-field-group-handle :next-sibling
     1472         .
     1473       end.
     1474       do with frame d-type-tmp
     1475       :
     1476         hide v-diasize-resize-button .
     1477         assign
     1478           v-diasize-resize-button :row    = 1
     1479           v-diasize-resize-button :column = 1
     1480         .
     1481       end.
     1482       if p-change-value > 0
     1483       then do:
     1484         if frame d-type-tmp :scrollable = true
     1485         then do:
     1486           assign
     1487             frame d-type-tmp :virtual-height = frame d-type-tmp :virtual-height + p-change-value
     1488             no-error .
     1489           if error-status :error
     1490           or error-status :get-message(1) <> ""
     1491           then do:
     1492             undo move_block, retry move_block .
     1493           end.
     1494         end.
     1495         assign
     1496           frame d-type-tmp :height = frame d-type-tmp :height + p-change-value
     1497           no-error .
     1498         if error-status :error
     1499         or error-status :get-message(1) <> ""
     1500         then do:
     1501           undo move_block, retry move_block .
     1502         end.
     1503         assign
     1504           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1505           no-error .
     1506         if error-status :error
     1507         or error-status :get-message(1) <> ""
     1508         then do:
     1509           undo move_block, retry move_block .
     1510         end.
     1511         for each buf_temp-browse-handle
     1512           where buf_temp-browse-handle.browse-type = 'height':u
     1513         on error undo move_block, retry move_block
     1514         :
     1515           assign
     1516             buf_temp-browse-handle.browse-handle :height
     1517               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1518             no-error .
     1519           if error-status :error
     1520           or error-status :get-message(1) <> ""
     1521           then do:
     1522             undo move_block, retry move_block .
     1523           end.
     1524         end.
     1525         for each buf_temp-diasize-handle
     1526         on error undo move_block, retry move_block
     1527         :
     1528           assign
     1529             v-object-handle = buf_temp-diasize-handle.handle-value
     1530           .
     1531           if v-object-handle <> v-diasize-resize-button
     1532           then do:
     1533             assign
     1534               v-object-handle :row = v-object-handle :row + p-change-value
     1535               no-error .
     1536             if error-status :error
     1537             or error-status :get-message(1) <> ""
     1538             then do:
     1539               undo move_block, retry move_block .
     1540             end.
     1541           end.
     1542         end.
     1543       end.
     1544       else do:
     1545         for each buf_temp-diasize-handle
     1546         on error undo move_block, retry move_block
     1547         :
     1548           assign
     1549             v-object-handle = buf_temp-diasize-handle.handle-value
     1550           .
     1551           if v-object-handle <> v-diasize-resize-button
     1552           then do:
     1553             assign
     1554               v-object-handle :row = v-object-handle :row + p-change-value
     1555               no-error .
     1556             if error-status :error
     1557             or error-status :get-message(1) <> ""
     1558             then do:
     1559               undo move_block, retry move_block .
     1560             end.
     1561           end.
     1562         end.
     1563         assign
     1564           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1565           no-error .
     1566         if error-status :error
     1567         or error-status :get-message(1) <> ""
     1568         then do:
     1569           undo move_block, retry move_block .
     1570         end.
     1571         for each buf_temp-browse-handle
     1572           where buf_temp-browse-handle.browse-type = 'height':u
     1573         on error undo move_block, retry move_block
     1574         :
     1575           assign
     1576             buf_temp-browse-handle.browse-handle :height
     1577               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1578             no-error .
     1579           if error-status :error
     1580           or error-status :get-message(1) <> ""
     1581           then do:
     1582             undo move_block, retry move_block .
     1583           end.
     1584         end.
     1585         assign
     1586           frame d-type-tmp :height = frame d-type-tmp :height + p-change-value
     1587           no-error .
     1588         if error-status :error
     1589         or error-status :get-message(1) <> ""
     1590         then do:
     1591           undo move_block, retry move_block .
     1592         end.
     1593         if frame d-type-tmp :scrollable = true
     1594         then do:
     1595           assign
     1596             frame d-type-tmp :virtual-height = frame d-type-tmp :virtual-height + p-change-value
     1597             no-error .
     1598           if error-status :error
     1599           or error-status :get-message(1) <> ""
     1600           then do:
     1601             undo move_block, retry move_block .
     1602           end.
     1603         end.
     1604       end.
     1605       if p-move-resize = true
     1606       then do:
     1607         run diasize_position-resize-button in this-procedure .
     1608       end.
     1609       if v-diasize-wndstore = true
     1610       then do:
     1611         if connected("ub") = true
     1612         then do:
     1613           define variable v-cntxt-db-num        as integer   no-undo .
     1614           define variable v-cntxt-userid        as character no-undo .
     1615           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1616                                             , OUTPUT v-cntxt-userid
     1617                                             ) .
     1618           run gbl/wndsizew.p
     1619             (input  v-cntxt-db-num
     1620             ,input  v-cntxt-userid
     1621             ,input  v-diasize-proc-name
     1622             ,input  'height':u
     1623             ,input  string(frame d-type-tmp :height - v-diasize-orig-frame-height)
     1624             ) .
     1625         end.
     1626       end.
     1627     end.
     1628     assign
     1629       v-diasize-change-size = false
     1630     .
     1631   end procedure.
     1632   procedure diasize_set-height :
     1633     define input  parameter p-new-height  as decimal   no-undo .
     1634     define input  parameter p-move-resize as logical   no-undo .
     1635     do
     1636     on error undo, return error return-value
     1637     :
     1638       run diasize_change-height in this-procedure
     1639         (input  (p-new-height - frame d-type-tmp :height)
     1640         ,input  p-move-resize
     1641         ) .
     1642     end.
     1643   end procedure.
     1644   procedure diasize_change-width :
     1645     define input  parameter p-change-value as decimal   no-undo .
     1646     define input  parameter p-move-resize  as logical   no-undo .
     1647     define variable v-field-group-handle   as handle    no-undo .
     1648     define variable v-object-handle        as handle    no-undo .
     1649     define variable v-frame-width          as decimal   no-undo .
     1650     define variable v-frame-virtual-width  as decimal   no-undo .
     1651     define variable v-browse-width         as decimal   no-undo .
     1652     define variable v-window-width         as decimal   no-undo .
     1653     define variable v-window-virtual-width as decimal   no-undo .
     1654     define variable v-change-sign          as integer   no-undo .
     1655     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1656     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1657     if p-change-value > 0
     1658     then do:
     1659       if frame d-type-tmp :width + p-change-value >
     1660           session :width-chars
     1661       then do:
     1662         assign
     1663           p-change-value = session :width-chars - frame d-type-tmp :width
     1664         .
     1665         if p-change-value <= 0
     1666         then do:
     1667           run diasize_position-resize-button in this-procedure .
     1668           return .
     1669         end.
     1670       end.
     1671     end.
     1672     if p-change-value < 0
     1673     then do:
     1674       if frame d-type-tmp :width + p-change-value < v-diasize-orig-frame-width
     1675       then do:
     1676         assign
     1677           p-change-value = v-diasize-orig-frame-width
     1678                          - frame d-type-tmp :width
     1679         .
     1680         if p-change-value >= 0
     1681         then do:
     1682           run diasize_position-resize-button in this-procedure .
     1683           return .
     1684         end.
     1685       end.
     1686     end.
     1687     if p-change-value >= 0
     1688     then do:
     1689       assign
     1690         v-change-sign = 1
     1691       .
     1692     end.
     1693     else do:
     1694       assign
     1695         v-change-sign = -1
     1696       .
     1697     end.
     1698     assign
     1699       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1700     .
     1701     if p-change-value = 0
     1702     then do:
     1703       run diasize_position-resize-button in this-procedure .
     1704       return .
     1705     end.
     1706     move_block:
     1707     do
     1708     on error undo move_block, leave move_block
     1709     :
     1710       if retry
     1711       then do:
     1712         do
     1713         on error undo move_block, leave move_block
     1714         :
     1715           if p-change-value > 0
     1716           then do:
     1717             for each buf_temp-diasize-handle
     1718             on error undo, next
     1719             :
     1720               assign
     1721                 v-object-handle = buf_temp-diasize-handle.handle-value
     1722               .
     1723               if v-object-handle <> v-diasize-resize-button
     1724               then do:
     1725                 assign
     1726                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1727                 .
     1728               end.
     1729             end.
     1730             assign
     1731               v-diasize-browse-handle :width = v-browse-width
     1732             .
     1733             for each buf_temp-browse-handle
     1734               where buf_temp-browse-handle.browse-type = 'width':u
     1735             on error undo, next
     1736             :
     1737               assign
     1738                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1739               .
     1740             end.
     1741             assign
     1742               frame d-type-tmp :width = v-frame-width
     1743             .
     1744             if frame d-type-tmp :scrollable = true
     1745             then do:
     1746               assign
     1747                 frame d-type-tmp :virtual-width = v-frame-virtual-width
     1748               .
     1749             end.
     1750             run diasize_position-resize-button in this-procedure .
     1751           end.
     1752           else do:
     1753             if frame d-type-tmp :scrollable = true
     1754             then do:
     1755               assign
     1756                 frame d-type-tmp :virtual-width = v-frame-virtual-width
     1757               .
     1758             end.
     1759             assign
     1760               frame d-type-tmp :width = v-frame-width
     1761             .
     1762             for each buf_temp-browse-handle
     1763               where buf_temp-browse-handle.browse-type = 'width':u
     1764             on error undo, next
     1765             :
     1766               assign
     1767                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1768               .
     1769             end.
     1770             assign
     1771               v-diasize-browse-handle :width = v-browse-width
     1772             .
     1773             for each buf_temp-diasize-handle
     1774             on error undo, next
     1775             :
     1776               assign
     1777                 v-object-handle = buf_temp-diasize-handle.handle-value
     1778               .
     1779               if v-object-handle <> v-diasize-resize-button
     1780               then do:
     1781                 assign
     1782                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1783                 .
     1784               end.
     1785             end.
     1786             run diasize_position-resize-button in this-procedure .
     1787           end.
     1788           assign
     1789             v-diasize-change-size = false
     1790           .
     1791           leave move_block .
     1792         end.
     1793       end.
     1794       assign
     1795         v-diasize-need-full-display = true
     1796       .
     1797       if v-diasize-change-size = false
     1798       then do:
     1799         assign
     1800           v-diasize-change-size = true
     1801         .
     1802       end.
     1803       else do:
     1804         return .
     1805       end.
     1806       assign
     1807         v-frame-width = frame d-type-tmp :width
     1808         v-frame-virtual-width = frame d-type-tmp :virtual-width
     1809         v-browse-width = v-diasize-browse-handle :width
     1810       .
     1811       for each buf_temp-browse-handle
     1812         where buf_temp-browse-handle.browse-type = 'width':u
     1813       :
     1814         assign
     1815           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1816         .
     1817       end.
     1818       for each buf_temp-diasize-handle
     1819       :
     1820         delete buf_temp-diasize-handle .
     1821       end.
     1822       assign
     1823         v-field-group-handle = frame d-type-tmp :first-child
     1824       .
     1825       do while valid-handle(v-field-group-handle)
     1826       :
     1827         assign
     1828           v-object-handle = v-field-group-handle :first-child
     1829         .
     1830         do while valid-handle(v-object-handle)
     1831         :
     1832           if  v-object-handle <> v-diasize-browse-handle :handle
     1833           and v-object-handle <> v-diasize-resize-button
     1834           and can-query(v-object-handle, "row")
     1835           and can-query(v-object-handle, "height")
     1836           and ( v-object-handle :col + v-object-handle :width
     1837                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1838               )
     1839           then do:
     1840             find first buf_temp-browse-handle
     1841               where buf_temp-browse-handle.browse-type   = 'width':u
     1842                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1843               no-error .
     1844             if available buf_temp-browse-handle
     1845             then do:
     1846             end.
     1847             else do:
     1848               create buf_temp-diasize-handle .
     1849               assign
     1850                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1851                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1852               .
     1853             end.
     1854           end.
     1855           assign
     1856             v-object-handle = v-object-handle :next-sibling
     1857           .
     1858         end.
     1859         assign
     1860           v-field-group-handle = v-field-group-handle :next-sibling
     1861         .
     1862       end.
     1863       do with frame d-type-tmp
     1864       :
     1865         hide v-diasize-resize-button .
     1866         v-diasize-resize-button :row = 1.
     1867         v-diasize-resize-button :column = 1.
     1868       end.
     1869       if p-change-value > 0
     1870       then do:
     1871         if frame d-type-tmp :scrollable = true
     1872         then do:
     1873           assign
     1874             frame d-type-tmp :virtual-width = frame d-type-tmp :virtual-width + p-change-value
     1875             no-error .
     1876           if error-status :error
     1877           or error-status :get-message(1) <> ""
     1878           then do:
     1879             undo move_block, retry move_block.
     1880           end.
     1881         end.
     1882         assign
     1883           frame d-type-tmp :width = v-frame-width + p-change-value
     1884           no-error .
     1885         if error-status :error
     1886         or error-status :get-message(1) <> ""
     1887         then do:
     1888           undo move_block, retry move_block.
     1889         end.
     1890         assign
     1891           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1892         no-error .
     1893         if error-status :error
     1894         or error-status :get-message(1) <> ""
     1895         then do:
     1896           undo move_block, retry move_block.
     1897         end.
     1898         for each buf_temp-browse-handle
     1899           where buf_temp-browse-handle.browse-type = 'width':u
     1900         on error undo move_block, retry move_block
     1901         :
     1902           assign
     1903             buf_temp-browse-handle.browse-handle :width
     1904               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1905             no-error .
     1906           if error-status :error
     1907           or error-status :get-message(1) <> ""
     1908           then do:
     1909             undo move_block, retry move_block .
     1910           end.
     1911         end.
     1912         for each buf_temp-diasize-handle
     1913         on error undo move_block, retry move_block
     1914         :
     1915           assign
     1916             v-object-handle = buf_temp-diasize-handle.handle-value
     1917           .
     1918           if v-object-handle <> v-diasize-resize-button
     1919           then do:
     1920             assign
     1921               v-object-handle :col = v-object-handle :col + p-change-value
     1922               no-error .
     1923             if error-status :error
     1924             or error-status :get-message(1) <> ""
     1925             then do:
     1926               undo move_block, retry move_block .
     1927             end.
     1928           end.
     1929         end.
     1930       end.
     1931       else do:
     1932         for each buf_temp-diasize-handle
     1933         on error undo move_block, retry move_block
     1934         :
     1935           assign
     1936             v-object-handle = buf_temp-diasize-handle.handle-value
     1937           .
     1938           if v-object-handle <> v-diasize-resize-button
     1939           then do:
     1940             assign
     1941               v-object-handle :col = v-object-handle :col + p-change-value
     1942               no-error .
     1943             if error-status :error
     1944             or error-status :get-message(1) <> ""
     1945             then do:
     1946               undo move_block, retry move_block .
     1947             end.
     1948           end.
     1949         end.
     1950         for each buf_temp-browse-handle
     1951           where buf_temp-browse-handle.browse-type = 'width':u
     1952         on error undo move_block, retry move_block
     1953         :
     1954           assign
     1955             buf_temp-browse-handle.browse-handle :width
     1956               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1957             no-error .
     1958           if error-status :error
     1959           or error-status :get-message(1) <> ""
     1960           then do:
     1961             undo move_block, retry move_block .
     1962           end.
     1963         end.
     1964         assign
     1965           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1966           no-error .
     1967         if error-status :error
     1968         or error-status :get-message(1) <> ""
     1969         then do:
     1970           undo move_block, retry move_block.
     1971         end.
     1972         assign
     1973           frame d-type-tmp :width = frame d-type-tmp :width + p-change-value
     1974         no-error .
     1975         if error-status :error
     1976         or error-status :get-message(1) <> ""
     1977         then do:
     1978           undo move_block, retry move_block.
     1979         end.
     1980         if frame d-type-tmp :scrollable = true
     1981         then do:
     1982           assign
     1983             frame d-type-tmp :virtual-width = frame d-type-tmp :virtual-width + p-change-value
     1984           no-error .
     1985           if error-status :error
     1986           or error-status :get-message(1) <> ""
     1987           then do:
     1988             undo move_block, retry move_block.
     1989           end.
     1990         end.
     1991       end.
     1992       if p-move-resize
     1993       then do:
     1994         run diasize_position-resize-button in this-procedure .
     1995       end.
     1996       if v-diasize-wndstore = true
     1997       then do:
     1998         if connected("ub") = true
     1999         then do:
     2000           define variable v-cntxt-db-num        as integer   no-undo .
     2001           define variable v-cntxt-userid        as character no-undo .
     2002           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2003                                             , OUTPUT v-cntxt-userid
     2004                                             ) .
     2005           run gbl/wndsizew.p
     2006             (input  v-cntxt-db-num
     2007             ,input  v-cntxt-userid
     2008             ,input  v-diasize-proc-name
     2009             ,input  'width':u
     2010             ,input  string(frame d-type-tmp :width - v-diasize-orig-frame-width)
     2011             ) .
     2012         end.
     2013       end.
     2014     end.
     2015     assign
     2016       v-diasize-change-size = false
     2017     .
     2018   end procedure.
     2019   procedure diasize_set-width :
     2020     define input  parameter p-new-width  as decimal   no-undo .
     2021     define input  parameter p-move-resize as logical   no-undo .
     2022     do
     2023     on error undo, return error return-value
     2024     :
     2025       run diasize_change-width in this-procedure
     2026         (input  (p-new-width - frame d-type-tmp :width)
     2027         ,input  p-move-resize
     2028         ) .
     2029     end.
     2030   end procedure.
     2031   procedure diasize_position-resize-button :
     2032     do with frame d-type-tmp
     2033     :
     2034       hide v-diasize-resize-button .
     2035       assign
     2036         v-diasize-resize-button :row = frame d-type-tmp :height - v-diasize-resize-button :height
     2037                     - 1
     2038                     - (frame d-type-tmp :border-bottom-pixels / session :pixels-per-row)
     2039         v-diasize-resize-button :col = frame d-type-tmp :width - v-diasize-resize-button :width
     2040                     - 1
     2041                     - (frame d-type-tmp :border-right-pixels / session :pixels-per-column)
     2042       .
     2043       view v-diasize-resize-button .
     2044     end.
     2045   end procedure.
     2046   on alt-right anywhere
     2047   do:
     2048     run diasize_change-width in this-procedure
     2049       (input 1
     2050       ,input true
     2051       ) .
     2052     return no-apply .
     2053   end.
     2054   on alt-left anywhere
     2055   do:
     2056     run diasize_change-width in this-procedure
     2057       (input -1
     2058       ,input true
     2059       ) .
     2060     return no-apply .
     2061   end.
     2062   on alt-down anywhere
     2063   do:
     2064     run diasize_change-height in this-procedure
     2065       (input 1
     2066       ,input true
     2067       ) .
     2068     return no-apply .
     2069   end.
     2070   on alt-up anywhere
     2071   do:
     2072     run diasize_change-height in this-procedure
     2073       (input -1
     2074       ,input true
     2075       ) .
     2076     return no-apply .
     2077   end.
     2078   on alt-enter of frame d-type-tmp
     2079   do:
     2080     run diasize_maximize in this-procedure
     2081       (input  ?
     2082       ).
     2083     return no-apply .
     2084   end.
     2085   procedure diasize_end-move :
     2086     do
     2087     on error undo, return error return-value
     2088     :
     2089       define variable v-row-delta as decimal   no-undo .
     2090       define variable v-col-delta as decimal   no-undo .
     2091       define variable v-new-row as decimal   no-undo .
     2092       define variable v-new-col as decimal   no-undo .
     2093       assign
     2094         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2095         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2096       .
     2097       assign
     2098         v-row-delta = v-new-row - frame d-type-tmp :height
     2099         v-col-delta = v-new-col - frame d-type-tmp :width
     2100       .
     2101       run diasize_change-height in this-procedure
     2102         (input v-row-delta
     2103         ,input true
     2104         ) .
     2105       run diasize_change-width in this-procedure
     2106         (input v-col-delta
     2107         ,input true
     2108         ) .
     2109     end.
     2110   end procedure.
     2111   procedure diasize_maximize :
     2112     define input  parameter p-action as logical   no-undo .
     2113     do
     2114     on error undo, return error return-value
     2115     :
     2116       if p-action = ?
     2117       then do:
     2118         if v-diasize-need-maximize = true
     2119         then do:
     2120           assign
     2121             p-action = true
     2122           .
     2123         end.
     2124         else do:
     2125           assign
     2126             p-action = false
     2127           .
     2128         end.
     2129       end.
     2130       if p-action = true
     2131       then do:
     2132         run diasize_change-height in this-procedure
     2133           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2134               - frame d-type-tmp :height-chars
     2135           ,input true
     2136           ) .
     2137         run diasize_change-width in this-procedure
     2138           (input session :width-chars
     2139               - frame d-type-tmp :width-chars
     2140           ,input true
     2141           ) .
     2142         assign
     2143           v-diasize-need-maximize = false
     2144         .
     2145       end.
     2146       else do:
     2147         run diasize_change-width in this-procedure
     2148           (input v-diasize-orig-frame-width
     2149               - frame d-type-tmp :width-chars
     2150           ,input true
     2151           ) .
     2152         run diasize_change-height in this-procedure
     2153           (input v-diasize-orig-frame-height
     2154               - frame d-type-tmp :height-chars
     2155           ,input true
     2156           ) .
     2157         assign
     2158           v-diasize-need-maximize = true
     2159         .
     2160       end.
     2161     end.
     2162   end procedure.
     2163   procedure diasize_restore-orig-size :
     2164     do
     2165     on error undo, return error return-value
     2166     :
     2167       assign
     2168         v-diasize-current-frame-width  = frame d-type-tmp :width
     2169         v-diasize-current-frame-height = frame d-type-tmp :height
     2170       .
     2171       run diasize_set-height in this-procedure
     2172         (input  v-diasize-orig-frame-height
     2173         ,input  true
     2174         ) .
     2175       run diasize_set-width in this-procedure
     2176         (input  v-diasize-orig-frame-width
     2177         ,input  true
     2178         ) .
     2179     end.
     2180   end procedure.
     2181   procedure diasize_restore-current-size :
     2182     do
     2183     on error undo, return error return-value
     2184     :
     2185       run diasize_set-height in this-procedure
     2186         (input  v-diasize-current-frame-height
     2187         ,input  true
     2188         ) .
     2189       run diasize_set-width in this-procedure
     2190         (input  v-diasize-current-frame-width
     2191         ,input  true
     2192         ) .
     2193     end.
     2194   end procedure.
     2195   procedure diasize_set-browse-handle :
     2196     define input  parameter p-browse-handle as handle   no-undo .
     2197     define buffer buf_temp-browse-handle for temp-browse-handle .
     2198     do
     2199     on error undo, return error return-value
     2200     :
     2201       assign
     2202         v-diasize-browse-handle = p-browse-handle
     2203       .
     2204       for each buf_temp-browse-handle
     2205       on error undo, return error return-value
     2206       :
     2207         delete buf_temp-browse-handle .
     2208       end.
     2209     end.
     2210   end procedure.
     2211   procedure diasize_add_browse :
     2212     define input  parameter p-browse-type   as character no-undo .
     2213     define input  parameter p-browse-handle as handle    no-undo .
     2214     define buffer buf_temp-browse-handle for temp-browse-handle .
     2215     do
     2216     on error undo, return error return-value
     2217     :
     2218       assign
     2219         v-diasize-browse-number = v-diasize-browse-number + 1
     2220       .
     2221       create buf_temp-browse-handle .
     2222       assign
     2223         buf_temp-browse-handle.browse-type   = p-browse-type
     2224         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2225         buf_temp-browse-handle.browse-handle = p-browse-handle
     2226       .
     2227     end.
     2228   end procedure.
     2229   procedure diasize_init :
     2230     define variable v-default-value    as logical   no-undo .
     2231     define variable v-restore-saved    as logical   no-undo .
     2232     define variable v-resize-value-str as character no-undo .
     2233     do
     2234     on error undo, return error return-value
     2235     :
     2236       do with frame d-type-tmp
     2237       :
     2238         assign
     2239           v-diasize-orig-frame-height = frame d-type-tmp :height
     2240           v-diasize-orig-frame-width  = frame d-type-tmp :width
     2241           v-diasize-browse-handle     = browse br-coll :handle
     2242         .
     2243         create button v-diasize-resize-button
     2244         assign
     2245           parent        = frame d-type-tmp :first-child
     2246           label         = "s"
     2247           height-pixels = 16
     2248           width-pixels  = 16
     2249           visible       = true
     2250           sensitive     = true
     2251           movable       = true
     2252           triggers:
     2253             on end-move persistent run diasize_end-move in this-procedure .
     2254           end triggers.
     2255         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2256         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2257         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2258         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2259         assign
     2260           v-diasize-wndmax = false
     2261         .
     2262         if connected("ub") = true
     2263         then do:
     2264           define variable v-cntxt-db-num        as integer   no-undo .
     2265           define variable v-cntxt-userid        as character no-undo .
     2266           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2267                                             , OUTPUT v-cntxt-userid
     2268                                             ) .
     2269           run gbl/wndpar_r.p
     2270             (input  v-cntxt-db-num
     2271             ,input  v-cntxt-userid
     2272             ,input  'wndmax':U
     2273             ,output v-diasize-wndmax
     2274             ,output v-default-value
     2275             ) .
     2276         end.
     2277         assign
     2278           v-diasize-wndstore = false
     2279         .
     2280         if connected("ub") = true
     2281         then do:
     2282           run gbl/wndpar_r.p
     2283             (input  v-cntxt-db-num
     2284             ,input  v-cntxt-userid
     2285             ,input  'wndstore':U
     2286             ,output v-diasize-wndstore
     2287             ,output v-default-value
     2288             ) .
     2289         end.
     2290         assign
     2291           v-diasize-proc-name = entry(1, program-name(2), '.')
     2292         .
     2293         if v-diasize-wndstore = true
     2294         then do:
     2295           assign
     2296             v-restore-saved = false
     2297           .
     2298           if connected("ub") = true
     2299           then do:
     2300             run gbl/wndsizer.p
     2301               (input  v-cntxt-db-num
     2302               ,input  v-cntxt-userid
     2303               ,input  v-diasize-proc-name
     2304               ,input  'height':u
     2305               ,output v-resize-value-str
     2306               ) .
     2307             if v-resize-value-str <> '':U
     2308             then do:
     2309               run diasize_change-height in this-procedure
     2310                 (input  integer(v-resize-value-str)
     2311                 ,input  true
     2312                 ) .
     2313               assign
     2314                 v-restore-saved = true
     2315               .
     2316             end.
     2317           end.
     2318           if connected("ub") = true
     2319           then do:
     2320             run gbl/wndsizer.p
     2321               (input  v-cntxt-db-num
     2322               ,input  v-cntxt-userid
     2323               ,input  v-diasize-proc-name
     2324               ,input  'width':u
     2325               ,output v-resize-value-str
     2326               ) .
     2327             if v-resize-value-str <> '':U
     2328             then do:
     2329               run diasize_change-width in this-procedure
     2330                 (input  integer(v-resize-value-str)
     2331                 ,input  true
     2332                 ) .
     2333               assign
     2334                 v-restore-saved = true
     2335               .
     2336             end.
     2337           end.
     2338           if v-restore-saved <> true
     2339           then do:
     2340             if v-diasize-wndmax = true
     2341             then do:
     2342               run diasize_maximize in this-procedure
     2343                 (input  true
     2344                 ) .
     2345             end.
     2346           end.
     2347         end.
     2348         else do:
     2349           if v-diasize-wndmax = true
     2350           then do:
     2351             run diasize_maximize in this-procedure
     2352               (input  true
     2353               ) .
     2354           end.
     2355         end.
     2356       end.
     2357     end.
     2358   end procedure.
     2359   procedure diasize_need-full-display :
     2360     define output parameter p-need-full-display as logical   no-undo .
     2361     do
     2362     on error undo, return error return-value
     2363     :
     2364       assign
     2365         p-need-full-display = v-diasize-need-full-display
     2366       .
     2367       assign
     2368         v-diasize-need-full-display = false
     2369       .
     2370     end.
     2371   end procedure.
     2372   procedure get-context :
     2373      define output parameter p-db-num as integer          no-undo.
     2374      define output parameter p-user-id as character        no-undo.
     2375      define variable v-login               as character    no-undo.
     2376      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2377      define buffer buf_user-login  for ub.user-login .
     2378      do
     2379      on error undo, return error
     2380      :
     2381            FIND FIRST buf_sys-ctrl no-lock.
     2382            ASSIGN
     2383               v-login = USERID("ub")
     2384               p-db-num = buf_sys-ctrl.db-num
     2385            .
     2386            FIND FIRST buf_user-login
     2387                 WHERE buf_user-login.db-num = p-db-num
     2388                   AND buf_user-login.user-login = v-login
     2389                 no-lock
     2390                 no-error
     2391                 .
     2392            IF AVAILABLE buf_user-login
     2393            THEN DO:
     2394               assign
     2395                  p-user-id = buf_user-login.user-id
     2396               .
     2397            END.
     2398      end.
     2399   end procedure.
     2400       run diasize_init in this-procedure .
     2401   ON WINDOW-CLOSE OF FRAME d-type-tmp APPLY "END-ERROR":U TO SELF.
     2402   MAIN-BLOCK:
     2403   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2404      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2405       run enable_ui.
     2406       APPLY "VALUE-CHANGED":U TO br-coll in frame d-type-tmp.
     2407       ub.season.sea-name:RESIZABLE in  browse br-coll   = true .
     2408       if num-entries (rid-list) = 0 then
     2409           hide mark-num in frame d-type-tmp.
     2410       else
     2411           disp
     2412           num-entries (rid-list) @ mark-num
     2413           with frame d-type-tmp.
     2414       WAIT-FOR GO OF FRAME d-type-tmp.
     2415   END.
     2416   run disable_ui.
     2417   PROCEDURE disable_UI :
     2418     HIDE FRAME d-type-tmp.
     2419   END PROCEDURE.
     2420   PROCEDURE enable_UI :
     2421       ENABLE
     2422           br-coll
     2423           b-exit
     2424           b-add WHEN  (lookup  ( "b-add" , bttns) > 0 )
     2425           b-sel WHEN  (lookup  ( "b-sel" , bttns) > 0 )
     2426           b-mark when (lookup  ( "b-mark", bttns) > 0 )
     2427           b-upd WHEN  (lookup  ( "b-add" , bttns) > 0 )
     2428           b-del WHEN  (lookup  ( "b-add" , bttns) > 0 )
     2429           b-print
     2430           b-hist
     2431           b-help
     2432           b-goods
     2433           WITH FRAME  d-type-tmp.
     2434       if available ub.season then
     2435           log-res  = br-coll:select-focused-row( ) in frame d-type-tmp.
     2436         OPEN QUERY br-coll FOR EACH ub.season       WHERE ub.season.sea-month-1 = 0  AND ub.season.sea-month-2 = 0 NO-LOCK.
     2437        END PROCEDURE.
     2438   FUNCTION mon-name RETURNS CHARACTER
     2439   (input n-mon as int) :
     2440   define variable name-mon as char no-undo.
     2441      run gbl/monthnam.p ( input n-mon, output name-mon ) .
     2442    RETURN name-mon.
     2443   END FUNCTION.
