     3024     index xie browse-type browse-handle
     3025   .
     3026   procedure diasize_change-height :
     3027     define input  parameter p-change-value  as decimal   no-undo .
     3028     define input  parameter p-move-resize   as logical   no-undo .
     3029     define variable v-field-group-handle    as handle    no-undo .
     3030     define variable v-object-handle         as handle    no-undo .
     3031     define variable v-frame-height          as decimal   no-undo .
     3032     define variable v-frame-virtual-height  as decimal   no-undo .
     3033     define variable v-browse-height         as decimal   no-undo .
     3034     define variable v-window-height         as decimal   no-undo .
     3035     define variable v-window-virtual-height as decimal   no-undo .
     3036     define variable v-change-sign           as integer   no-undo .
     3037     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3038     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3039     if p-change-value > 0
     3040     then do:
     3041       if frame Dialog-Frame :height + p-change-value
     3042           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3043       then do:
     3044         assign
     3045           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3046                           - (frame Dialog-Frame :height-chars)
     3047         .
     3048         if p-change-value <= 0
     3049         then do:
     3050           run diasize_position-resize-button in this-procedure .
     3051           return .
     3052         end.
     3053       end.
     3054     end.
     3055     if p-change-value < 0
     3056     then do:
     3057       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3058       then do:
     3059         assign
     3060           p-change-value = v-diasize-orig-frame-height
     3061                          - (frame Dialog-Frame :height-chars)
     3062         .
     3063         if p-change-value >= 0
     3064         then do:
     3065           run diasize_position-resize-button in this-procedure .
     3066           return .
     3067         end.
     3068       end.
     3069     end.
     3070     if p-change-value >= 0
     3071     then do:
     3072       assign
     3073         v-change-sign = 1
     3074       .
     3075     end.
     3076     else do:
     3077       assign
     3078         v-change-sign = -1
     3079       .
     3080     end.
     3081     assign
     3082       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3083     .
     3084     if p-change-value = 0
     3085     then do:
     3086       run diasize_position-resize-button in this-procedure .
     3087       return .
     3088     end.
     3089     move_block:
     3090     do
     3091     on error undo move_block, retry move_block
     3092     :
     3093       if retry
     3094       then do:
     3095         do
     3096         on error undo move_block, leave move_block
     3097         :
     3098           if p-change-value > 0
     3099           then do:
     3100             for each buf_temp-diasize-handle
     3101             on error undo, next
     3102             :
     3103               assign
     3104                 v-object-handle = buf_temp-diasize-handle.handle-value
     3105               .
     3106               if v-object-handle <> v-diasize-resize-button
     3107               then do:
     3108                 assign
     3109                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3110                 .
     3111               end.
     3112             end.
     3113             assign
     3114               v-diasize-browse-handle :height = v-browse-height
     3115             .
     3116             for each buf_temp-browse-handle
     3117               where buf_temp-browse-handle.browse-type = 'height':u
     3118             on error undo, next
     3119             :
     3120               assign
     3121                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3122               .
     3123             end.
     3124             assign
     3125               frame Dialog-Frame :height = v-frame-height
     3126             .
     3127             if frame Dialog-Frame :scrollable = true
     3128             then do:
     3129               assign
     3130                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3131               .
     3132             end.
     3133             run diasize_position-resize-button in this-procedure .
     3134           end.
     3135           else do:
     3136             if frame Dialog-Frame :scrollable = true
     3137             then do:
     3138               assign
     3139                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3140               .
     3141             end.
     3142             assign
     3143               frame Dialog-Frame :height = v-frame-height
     3144             .
     3145             assign
     3146               v-diasize-browse-handle :height = v-browse-height
     3147             .
     3148             for each buf_temp-browse-handle
     3149               where buf_temp-browse-handle.browse-type = 'height':u
     3150             on error undo, next
     3151             :
     3152               assign
     3153                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3154               .
     3155             end.
     3156             for each buf_temp-diasize-handle
     3157             on error undo, next
     3158             :
     3159               assign
     3160                 v-object-handle = buf_temp-diasize-handle.handle-value
     3161               .
     3162               if v-object-handle <> v-diasize-resize-button
     3163               then do:
     3164                 assign
     3165                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3166                 .
     3167               end.
     3168             end.
     3169             run diasize_position-resize-button in this-procedure .
     3170           end.
     3171           assign
     3172             v-diasize-change-size = false
     3173           .
     3174           leave move_block .
     3175         end.
     3176       end.
     3177       assign
     3178         v-diasize-need-full-display = true
     3179       .
     3180       if v-diasize-change-size = false
     3181       then do:
     3182         assign
     3183           v-diasize-change-size = true
     3184         .
     3185       end.
     3186       else do:
     3187         return .
     3188       end.
     3189       assign
     3190         v-frame-height = frame Dialog-Frame :height
     3191         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3192         v-browse-height = v-diasize-browse-handle :height
     3193       .
     3194       for each buf_temp-browse-handle
     3195         where buf_temp-browse-handle.browse-type = 'height':u
     3196       :
     3197         assign
     3198           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3199         .
     3200       end.
     3201       for each buf_temp-diasize-handle
     3202       :
     3203         delete buf_temp-diasize-handle .
     3204       end.
     3205       assign
     3206         v-field-group-handle = frame Dialog-Frame :first-child
     3207       .
     3208       do while valid-handle(v-field-group-handle)
     3209       :
     3210         assign
     3211           v-object-handle = v-field-group-handle :first-child
     3212         .
     3213         do while valid-handle(v-object-handle)
     3214         :
     3215           if  v-object-handle <> v-diasize-browse-handle :handle
     3216           and can-query(v-object-handle, "row")
     3217           and can-query(v-object-handle, "height")
     3218           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3219           then do:
     3220             find first buf_temp-browse-handle
     3221               where buf_temp-browse-handle.browse-type   = 'height':u
     3222                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3223               no-error .
     3224             if available buf_temp-browse-handle
     3225             then do:
     3226             end.
     3227             else do:
     3228               create buf_temp-diasize-handle .
     3229               assign
     3230                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3231                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3232               .
     3233             end.
     3234           end.
     3235           assign
     3236             v-object-handle = v-object-handle :next-sibling
     3237           .
     3238         end.
     3239         assign
     3240           v-field-group-handle = v-field-group-handle :next-sibling
     3241         .
     3242       end.
     3243       do with frame Dialog-Frame
     3244       :
     3245         hide v-diasize-resize-button .
     3246         assign
     3247           v-diasize-resize-button :row    = 1
     3248           v-diasize-resize-button :column = 1
     3249         .
     3250       end.
     3251       if p-change-value > 0
     3252       then do:
     3253         if frame Dialog-Frame :scrollable = true
     3254         then do:
     3255           assign
     3256             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3257             no-error .
     3258           if error-status :error
     3259           or error-status :get-message(1) <> ""
     3260           then do:
     3261             undo move_block, retry move_block .
     3262           end.
     3263         end.
     3264         assign
     3265           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3266           no-error .
     3267         if error-status :error
     3268         or error-status :get-message(1) <> ""
     3269         then do:
     3270           undo move_block, retry move_block .
     3271         end.
     3272         assign
     3273           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3274           no-error .
     3275         if error-status :error
     3276         or error-status :get-message(1) <> ""
     3277         then do:
     3278           undo move_block, retry move_block .
     3279         end.
     3280         for each buf_temp-browse-handle
     3281           where buf_temp-browse-handle.browse-type = 'height':u
     3282         on error undo move_block, retry move_block
     3283         :
     3284           assign
     3285             buf_temp-browse-handle.browse-handle :height
     3286               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3287             no-error .
     3288           if error-status :error
     3289           or error-status :get-message(1) <> ""
     3290           then do:
     3291             undo move_block, retry move_block .
     3292           end.
     3293         end.
     3294         for each buf_temp-diasize-handle
     3295         on error undo move_block, retry move_block
     3296         :
     3297           assign
     3298             v-object-handle = buf_temp-diasize-handle.handle-value
     3299           .
     3300           if v-object-handle <> v-diasize-resize-button
     3301           then do:
     3302             assign
     3303               v-object-handle :row = v-object-handle :row + p-change-value
     3304               no-error .
     3305             if error-status :error
     3306             or error-status :get-message(1) <> ""
     3307             then do:
     3308               undo move_block, retry move_block .
     3309             end.
     3310           end.
     3311         end.
     3312       end.
     3313       else do:
     3314         for each buf_temp-diasize-handle
     3315         on error undo move_block, retry move_block
     3316         :
     3317           assign
     3318             v-object-handle = buf_temp-diasize-handle.handle-value
     3319           .
     3320           if v-object-handle <> v-diasize-resize-button
     3321           then do:
     3322             assign
     3323               v-object-handle :row = v-object-handle :row + p-change-value
     3324               no-error .
     3325             if error-status :error
     3326             or error-status :get-message(1) <> ""
     3327             then do:
     3328               undo move_block, retry move_block .
     3329             end.
     3330           end.
     3331         end.
     3332         assign
     3333           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3334           no-error .
     3335         if error-status :error
     3336         or error-status :get-message(1) <> ""
     3337         then do:
     3338           undo move_block, retry move_block .
     3339         end.
     3340         for each buf_temp-browse-handle
     3341           where buf_temp-browse-handle.browse-type = 'height':u
     3342         on error undo move_block, retry move_block
     3343         :
     3344           assign
     3345             buf_temp-browse-handle.browse-handle :height
     3346               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3347             no-error .
     3348           if error-status :error
     3349           or error-status :get-message(1) <> ""
     3350           then do:
     3351             undo move_block, retry move_block .
     3352           end.
     3353         end.
     3354         assign
     3355           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3356           no-error .
     3357         if error-status :error
     3358         or error-status :get-message(1) <> ""
     3359         then do:
     3360           undo move_block, retry move_block .
     3361         end.
     3362         if frame Dialog-Frame :scrollable = true
     3363         then do:
     3364           assign
     3365             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3366             no-error .
     3367           if error-status :error
     3368           or error-status :get-message(1) <> ""
     3369           then do:
     3370             undo move_block, retry move_block .
     3371           end.
     3372         end.
     3373       end.
     3374       if p-move-resize = true
     3375       then do:
     3376         run diasize_position-resize-button in this-procedure .
     3377       end.
     3378       if v-diasize-wndstore = true
     3379       then do:
     3380         if connected("ub") = true
     3381         then do:
     3382           define variable v-cntxt-db-num        as integer   no-undo .
     3383           define variable v-cntxt-userid        as character no-undo .
     3384           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3385                                             , OUTPUT v-cntxt-userid
     3386                                             ) .
     3387           run gbl/wndsizew.p
     3388             (input  v-cntxt-db-num
     3389             ,input  v-cntxt-userid
     3390             ,input  v-diasize-proc-name
     3391             ,input  'height':u
     3392             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3393             ) .
     3394         end.
     3395       end.
     3396     end.
     3397     assign
     3398       v-diasize-change-size = false
     3399     .
     3400   end procedure.
     3401   procedure diasize_set-height :
     3402     define input  parameter p-new-height  as decimal   no-undo .
     3403     define input  parameter p-move-resize as logical   no-undo .
     3404     do
     3405     on error undo, return error return-value
     3406     :
     3407       run diasize_change-height in this-procedure
     3408         (input  (p-new-height - frame Dialog-Frame :height)
     3409         ,input  p-move-resize
     3410         ) .
     3411     end.
     3412   end procedure.
     3413   procedure diasize_change-width :
     3414     define input  parameter p-change-value as decimal   no-undo .
     3415     define input  parameter p-move-resize  as logical   no-undo .
     3416     define variable v-field-group-handle   as handle    no-undo .
     3417     define variable v-object-handle        as handle    no-undo .
     3418     define variable v-frame-width          as decimal   no-undo .
     3419     define variable v-frame-virtual-width  as decimal   no-undo .
     3420     define variable v-browse-width         as decimal   no-undo .
     3421     define variable v-window-width         as decimal   no-undo .
     3422     define variable v-window-virtual-width as decimal   no-undo .
     3423     define variable v-change-sign          as integer   no-undo .
     3424     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3425     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3426     if p-change-value > 0
     3427     then do:
     3428       if frame Dialog-Frame :width + p-change-value >
     3429           session :width-chars
     3430       then do:
     3431         assign
     3432           p-change-value = session :width-chars - frame Dialog-Frame :width
     3433         .
     3434         if p-change-value <= 0
     3435         then do:
     3436           run diasize_position-resize-button in this-procedure .
     3437           return .
     3438         end.
     3439       end.
     3440     end.
     3441     if p-change-value < 0
     3442     then do:
     3443       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3444       then do:
     3445         assign
     3446           p-change-value = v-diasize-orig-frame-width
     3447                          - frame Dialog-Frame :width
     3448         .
     3449         if p-change-value >= 0
     3450         then do:
     3451           run diasize_position-resize-button in this-procedure .
     3452           return .
     3453         end.
     3454       end.
     3455     end.
     3456     if p-change-value >= 0
     3457     then do:
     3458       assign
     3459         v-change-sign = 1
     3460       .
     3461     end.
     3462     else do:
     3463       assign
     3464         v-change-sign = -1
     3465       .
     3466     end.
     3467     assign
     3468       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3469     .
     3470     if p-change-value = 0
     3471     then do:
     3472       run diasize_position-resize-button in this-procedure .
     3473       return .
     3474     end.
     3475     move_block:
     3476     do
     3477     on error undo move_block, leave move_block
     3478     :
     3479       if retry
     3480       then do:
     3481         do
     3482         on error undo move_block, leave move_block
     3483         :
     3484           if p-change-value > 0
     3485           then do:
     3486             for each buf_temp-diasize-handle
     3487             on error undo, next
     3488             :
     3489               assign
     3490                 v-object-handle = buf_temp-diasize-handle.handle-value
     3491               .
     3492               if v-object-handle <> v-diasize-resize-button
     3493               then do:
     3494                 assign
     3495                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3496                 .
     3497               end.
     3498             end.
     3499             assign
     3500               v-diasize-browse-handle :width = v-browse-width
     3501             .
     3502             for each buf_temp-browse-handle
     3503               where buf_temp-browse-handle.browse-type = 'width':u
     3504             on error undo, next
     3505             :
     3506               assign
     3507                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3508               .
     3509             end.
     3510             assign
     3511               frame Dialog-Frame :width = v-frame-width
     3512             .
     3513             if frame Dialog-Frame :scrollable = true
     3514             then do:
     3515               assign
     3516                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3517               .
     3518             end.
     3519             run diasize_position-resize-button in this-procedure .
     3520           end.
     3521           else do:
     3522             if frame Dialog-Frame :scrollable = true
     3523             then do:
     3524               assign
     3525                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3526               .
     3527             end.
     3528             assign
     3529               frame Dialog-Frame :width = v-frame-width
     3530             .
     3531             for each buf_temp-browse-handle
     3532               where buf_temp-browse-handle.browse-type = 'width':u
     3533             on error undo, next
     3534             :
     3535               assign
     3536                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3537               .
     3538             end.
     3539             assign
     3540               v-diasize-browse-handle :width = v-browse-width
     3541             .
     3542             for each buf_temp-diasize-handle
     3543             on error undo, next
     3544             :
     3545               assign
     3546                 v-object-handle = buf_temp-diasize-handle.handle-value
     3547               .
     3548               if v-object-handle <> v-diasize-resize-button
     3549               then do:
     3550                 assign
     3551                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3552                 .
     3553               end.
     3554             end.
     3555             run diasize_position-resize-button in this-procedure .
     3556           end.
     3557           assign
     3558             v-diasize-change-size = false
     3559           .
     3560           leave move_block .
     3561         end.
     3562       end.
     3563       assign
     3564         v-diasize-need-full-display = true
     3565       .
     3566       if v-diasize-change-size = false
     3567       then do:
     3568         assign
     3569           v-diasize-change-size = true
     3570         .
     3571       end.
     3572       else do:
     3573         return .
     3574       end.
     3575       assign
     3576         v-frame-width = frame Dialog-Frame :width
     3577         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3578         v-browse-width = v-diasize-browse-handle :width
     3579       .
     3580       for each buf_temp-browse-handle
     3581         where buf_temp-browse-handle.browse-type = 'width':u
     3582       :
     3583         assign
     3584           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3585         .
     3586       end.
     3587       for each buf_temp-diasize-handle
     3588       :
     3589         delete buf_temp-diasize-handle .
     3590       end.
     3591       assign
     3592         v-field-group-handle = frame Dialog-Frame :first-child
     3593       .
     3594       do while valid-handle(v-field-group-handle)
     3595       :
     3596         assign
     3597           v-object-handle = v-field-group-handle :first-child
     3598         .
     3599         do while valid-handle(v-object-handle)
     3600         :
     3601           if  v-object-handle <> v-diasize-browse-handle :handle
     3602           and v-object-handle <> v-diasize-resize-button
     3603           and can-query(v-object-handle, "row")
     3604           and can-query(v-object-handle, "height")
     3605           and ( v-object-handle :col + v-object-handle :width
     3606                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3607               )
     3608           then do:
     3609             find first buf_temp-browse-handle
     3610               where buf_temp-browse-handle.browse-type   = 'width':u
     3611                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3612               no-error .
     3613             if available buf_temp-browse-handle
     3614             then do:
     3615             end.
     3616             else do:
     3617               create buf_temp-diasize-handle .
     3618               assign
     3619                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3620                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3621               .
     3622             end.
     3623           end.
     3624           assign
     3625             v-object-handle = v-object-handle :next-sibling
     3626           .
     3627         end.
     3628         assign
     3629           v-field-group-handle = v-field-group-handle :next-sibling
     3630         .
     3631       end.
     3632       do with frame Dialog-Frame
     3633       :
     3634         hide v-diasize-resize-button .
     3635         v-diasize-resize-button :row = 1.
     3636         v-diasize-resize-button :column = 1.
     3637       end.
     3638       if p-change-value > 0
     3639       then do:
     3640         if frame Dialog-Frame :scrollable = true
     3641         then do:
     3642           assign
     3643             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3644             no-error .
     3645           if error-status :error
     3646           or error-status :get-message(1) <> ""
     3647           then do:
     3648             undo move_block, retry move_block.
     3649           end.
     3650         end.
     3651         assign
     3652           frame Dialog-Frame :width = v-frame-width + p-change-value
     3653           no-error .
     3654         if error-status :error
     3655         or error-status :get-message(1) <> ""
     3656         then do:
     3657           undo move_block, retry move_block.
     3658         end.
     3659         assign
     3660           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3661         no-error .
     3662         if error-status :error
     3663         or error-status :get-message(1) <> ""
     3664         then do:
     3665           undo move_block, retry move_block.
     3666         end.
     3667         for each buf_temp-browse-handle
     3668           where buf_temp-browse-handle.browse-type = 'width':u
     3669         on error undo move_block, retry move_block
     3670         :
     3671           assign
     3672             buf_temp-browse-handle.browse-handle :width
     3673               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3674             no-error .
     3675           if error-status :error
     3676           or error-status :get-message(1) <> ""
     3677           then do:
     3678             undo move_block, retry move_block .
     3679           end.
     3680         end.
     3681         for each buf_temp-diasize-handle
     3682         on error undo move_block, retry move_block
     3683         :
     3684           assign
     3685             v-object-handle = buf_temp-diasize-handle.handle-value
     3686           .
     3687           if v-object-handle <> v-diasize-resize-button
     3688           then do:
     3689             assign
     3690               v-object-handle :col = v-object-handle :col + p-change-value
     3691               no-error .
     3692             if error-status :error
     3693             or error-status :get-message(1) <> ""
     3694             then do:
     3695               undo move_block, retry move_block .
     3696             end.
     3697           end.
     3698         end.
     3699       end.
     3700       else do:
     3701         for each buf_temp-diasize-handle
     3702         on error undo move_block, retry move_block
     3703         :
     3704           assign
     3705             v-object-handle = buf_temp-diasize-handle.handle-value
     3706           .
     3707           if v-object-handle <> v-diasize-resize-button
     3708           then do:
     3709             assign
     3710               v-object-handle :col = v-object-handle :col + p-change-value
     3711               no-error .
     3712             if error-status :error
     3713             or error-status :get-message(1) <> ""
     3714             then do:
     3715               undo move_block, retry move_block .
     3716             end.
     3717           end.
     3718         end.
     3719         for each buf_temp-browse-handle
     3720           where buf_temp-browse-handle.browse-type = 'width':u
     3721         on error undo move_block, retry move_block
     3722         :
     3723           assign
     3724             buf_temp-browse-handle.browse-handle :width
     3725               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3726             no-error .
     3727           if error-status :error
     3728           or error-status :get-message(1) <> ""
     3729           then do:
     3730             undo move_block, retry move_block .
     3731           end.
     3732         end.
     3733         assign
     3734           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3735           no-error .
     3736         if error-status :error
     3737         or error-status :get-message(1) <> ""
     3738         then do:
     3739           undo move_block, retry move_block.
     3740         end.
     3741         assign
     3742           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3743         no-error .
     3744         if error-status :error
     3745         or error-status :get-message(1) <> ""
     3746         then do:
     3747           undo move_block, retry move_block.
     3748         end.
     3749         if frame Dialog-Frame :scrollable = true
     3750         then do:
     3751           assign
     3752             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3753           no-error .
     3754           if error-status :error
     3755           or error-status :get-message(1) <> ""
     3756           then do:
     3757             undo move_block, retry move_block.
     3758           end.
     3759         end.
     3760       end.
     3761       if p-move-resize
     3762       then do:
     3763         run diasize_position-resize-button in this-procedure .
     3764       end.
     3765       if v-diasize-wndstore = true
     3766       then do:
     3767         if connected("ub") = true
     3768         then do:
     3769           define variable v-cntxt-db-num        as integer   no-undo .
     3770           define variable v-cntxt-userid        as character no-undo .
     3771           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3772                                             , OUTPUT v-cntxt-userid
     3773                                             ) .
     3774           run gbl/wndsizew.p
     3775             (input  v-cntxt-db-num
     3776             ,input  v-cntxt-userid
     3777             ,input  v-diasize-proc-name
     3778             ,input  'width':u
     3779             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3780             ) .
     3781         end.
     3782       end.
     3783     end.
     3784     assign
     3785       v-diasize-change-size = false
     3786     .
     3787   end procedure.
     3788   procedure diasize_set-width :
     3789     define input  parameter p-new-width  as decimal   no-undo .
     3790     define input  parameter p-move-resize as logical   no-undo .
     3791     do
     3792     on error undo, return error return-value
     3793     :
     3794       run diasize_change-width in this-procedure
     3795         (input  (p-new-width - frame Dialog-Frame :width)
     3796         ,input  p-move-resize
     3797         ) .
     3798     end.
     3799   end procedure.
     3800   procedure diasize_position-resize-button :
     3801     do with frame Dialog-Frame
     3802     :
     3803       hide v-diasize-resize-button .
     3804       assign
     3805         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3806                     - 1
     3807                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3808         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3809                     - 1
     3810                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3811       .
     3812       view v-diasize-resize-button .
     3813     end.
     3814   end procedure.
     3815   on alt-right anywhere
     3816   do:
     3817     run diasize_change-width in this-procedure
     3818       (input 1
     3819       ,input true
     3820       ) .
     3821     return no-apply .
     3822   end.
     3823   on alt-left anywhere
     3824   do:
     3825     run diasize_change-width in this-procedure
     3826       (input -1
     3827       ,input true
     3828       ) .
     3829     return no-apply .
     3830   end.
     3831   on alt-down anywhere
     3832   do:
     3833     run diasize_change-height in this-procedure
     3834       (input 1
     3835       ,input true
     3836       ) .
     3837     return no-apply .
     3838   end.
     3839   on alt-up anywhere
     3840   do:
     3841     run diasize_change-height in this-procedure
     3842       (input -1
     3843       ,input true
     3844       ) .
     3845     return no-apply .
     3846   end.
     3847   on alt-enter of frame Dialog-Frame
     3848   do:
     3849     run diasize_maximize in this-procedure
     3850       (input  ?
     3851       ).
     3852     return no-apply .
     3853   end.
     3854   procedure diasize_end-move :
     3855     do
     3856     on error undo, return error return-value
     3857     :
     3858       define variable v-row-delta as decimal   no-undo .
     3859       define variable v-col-delta as decimal   no-undo .
     3860       define variable v-new-row as decimal   no-undo .
     3861       define variable v-new-col as decimal   no-undo .
     3862       assign
     3863         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3864         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3865       .
     3866       assign
     3867         v-row-delta = v-new-row - frame Dialog-Frame :height
     3868         v-col-delta = v-new-col - frame Dialog-Frame :width
     3869       .
     3870       run diasize_change-height in this-procedure
     3871         (input v-row-delta
     3872         ,input true
     3873         ) .
     3874       run diasize_change-width in this-procedure
     3875         (input v-col-delta
     3876         ,input true
     3877         ) .
     3878     end.
     3879   end procedure.
     3880   procedure diasize_maximize :
     3881     define input  parameter p-action as logical   no-undo .
     3882     do
     3883     on error undo, return error return-value
     3884     :
     3885       if p-action = ?
     3886       then do:
     3887         if v-diasize-need-maximize = true
     3888         then do:
     3889           assign
     3890             p-action = true
     3891           .
     3892         end.
     3893         else do:
     3894           assign
     3895             p-action = false
     3896           .
     3897         end.
     3898       end.
     3899       if p-action = true
     3900       then do:
     3901         run diasize_change-height in this-procedure
     3902           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3903               - frame Dialog-Frame :height-chars
     3904           ,input true
     3905           ) .
     3906         run diasize_change-width in this-procedure
     3907           (input session :width-chars
     3908               - frame Dialog-Frame :width-chars
     3909           ,input true
     3910           ) .
     3911         assign
     3912           v-diasize-need-maximize = false
     3913         .
     3914       end.
     3915       else do:
     3916         run diasize_change-width in this-procedure
     3917           (input v-diasize-orig-frame-width
     3918               - frame Dialog-Frame :width-chars
     3919           ,input true
     3920           ) .
     3921         run diasize_change-height in this-procedure
     3922           (input v-diasize-orig-frame-height
     3923               - frame Dialog-Frame :height-chars
     3924           ,input true
     3925           ) .
     3926         assign
     3927           v-diasize-need-maximize = true
     3928         .
     3929       end.
     3930     end.
     3931   end procedure.
     3932   procedure diasize_restore-orig-size :
     3933     do
     3934     on error undo, return error return-value
     3935     :
     3936       assign
     3937         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3938         v-diasize-current-frame-height = frame Dialog-Frame :height
     3939       .
     3940       run diasize_set-height in this-procedure
     3941         (input  v-diasize-orig-frame-height
     3942         ,input  true
     3943         ) .
     3944       run diasize_set-width in this-procedure
     3945         (input  v-diasize-orig-frame-width
     3946         ,input  true
     3947         ) .
     3948     end.
     3949   end procedure.
     3950   procedure diasize_restore-current-size :
     3951     do
     3952     on error undo, return error return-value
     3953     :
     3954       run diasize_set-height in this-procedure
     3955         (input  v-diasize-current-frame-height
     3956         ,input  true
     3957         ) .
     3958       run diasize_set-width in this-procedure
     3959         (input  v-diasize-current-frame-width
     3960         ,input  true
     3961         ) .
     3962     end.
     3963   end procedure.
     3964   procedure diasize_set-browse-handle :
     3965     define input  parameter p-browse-handle as handle   no-undo .
     3966     define buffer buf_temp-browse-handle for temp-browse-handle .
     3967     do
     3968     on error undo, return error return-value
     3969     :
     3970       assign
     3971         v-diasize-browse-handle = p-browse-handle
     3972       .
     3973       for each buf_temp-browse-handle
     3974       on error undo, return error return-value
     3975       :
     3976         delete buf_temp-browse-handle .
     3977       end.
     3978     end.
     3979   end procedure.
     3980   procedure diasize_add_browse :
     3981     define input  parameter p-browse-type   as character no-undo .
     3982     define input  parameter p-browse-handle as handle    no-undo .
     3983     define buffer buf_temp-browse-handle for temp-browse-handle .
     3984     do
     3985     on error undo, return error return-value
     3986     :
     3987       assign
     3988         v-diasize-browse-number = v-diasize-browse-number + 1
     3989       .
     3990       create buf_temp-browse-handle .
     3991       assign
     3992         buf_temp-browse-handle.browse-type   = p-browse-type
     3993         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3994         buf_temp-browse-handle.browse-handle = p-browse-handle
     3995       .
     3996     end.
     3997   end procedure.
     3998   procedure diasize_init :
     3999     define variable v-default-value    as logical   no-undo .
     4000     define variable v-restore-saved    as logical   no-undo .
     4001     define variable v-resize-value-str as character no-undo .
     4002     do
     4003     on error undo, return error return-value
     4004     :
     4005       do with frame Dialog-Frame
     4006       :
     4007         assign
     4008           v-diasize-orig-frame-height = frame Dialog-Frame :height
     4009           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     4010           v-diasize-browse-handle     = browse BR-tt :handle
     4011         .
     4012         create button v-diasize-resize-button
     4013         assign
     4014           parent        = frame Dialog-Frame :first-child
     4015           label         = "s"
     4016           height-pixels = 16
     4017           width-pixels  = 16
     4018           visible       = true
     4019           sensitive     = true
     4020           movable       = true
     4021           triggers:
     4022             on end-move persistent run diasize_end-move in this-procedure .
     4023           end triggers.
     4024         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4025         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4026         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4027         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4028         assign
     4029           v-diasize-wndmax = false
     4030         .
     4031         if connected("ub") = true
     4032         then do:
     4033           define variable v-cntxt-db-num        as integer   no-undo .
     4034           define variable v-cntxt-userid        as character no-undo .
     4035           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4036                                             , OUTPUT v-cntxt-userid
     4037                                             ) .
     4038           run gbl/wndpar_r.p
     4039             (input  v-cntxt-db-num
     4040             ,input  v-cntxt-userid
     4041             ,input  'wndmax':U
     4042             ,output v-diasize-wndmax
     4043             ,output v-default-value
     4044             ) .
     4045         end.
     4046         assign
     4047           v-diasize-wndstore = false
     4048         .
     4049         if connected("ub") = true
     4050         then do:
     4051           run gbl/wndpar_r.p
     4052             (input  v-cntxt-db-num
     4053             ,input  v-cntxt-userid
     4054             ,input  'wndstore':U
     4055             ,output v-diasize-wndstore
     4056             ,output v-default-value
     4057             ) .
     4058         end.
     4059         assign
     4060           v-diasize-proc-name = entry(1, program-name(2), '.')
     4061         .
     4062         if v-diasize-wndstore = true
     4063         then do:
     4064           assign
     4065             v-restore-saved = false
     4066           .
     4067           if connected("ub") = true
     4068           then do:
     4069             run gbl/wndsizer.p
     4070               (input  v-cntxt-db-num
     4071               ,input  v-cntxt-userid
     4072               ,input  v-diasize-proc-name
     4073               ,input  'height':u
     4074               ,output v-resize-value-str
     4075               ) .
     4076             if v-resize-value-str <> '':U
     4077             then do:
     4078               run diasize_change-height in this-procedure
     4079                 (input  integer(v-resize-value-str)
     4080                 ,input  true
     4081                 ) .
     4082               assign
     4083                 v-restore-saved = true
     4084               .
     4085             end.
     4086           end.
     4087           if connected("ub") = true
     4088           then do:
     4089             run gbl/wndsizer.p
     4090               (input  v-cntxt-db-num
     4091               ,input  v-cntxt-userid
     4092               ,input  v-diasize-proc-name
     4093               ,input  'width':u
     4094               ,output v-resize-value-str
     4095               ) .
     4096             if v-resize-value-str <> '':U
     4097             then do:
     4098               run diasize_change-width in this-procedure
     4099                 (input  integer(v-resize-value-str)
     4100                 ,input  true
     4101                 ) .
     4102               assign
     4103                 v-restore-saved = true
     4104               .
     4105             end.
     4106           end.
     4107           if v-restore-saved <> true
     4108           then do:
     4109             if v-diasize-wndmax = true
     4110             then do:
     4111               run diasize_maximize in this-procedure
     4112                 (input  true
     4113                 ) .
     4114             end.
     4115           end.
     4116         end.
     4117         else do:
     4118           if v-diasize-wndmax = true
     4119           then do:
     4120             run diasize_maximize in this-procedure
     4121               (input  true
     4122               ) .
     4123           end.
     4124         end.
     4125       end.
     4126     end.
     4127   end procedure.
     4128   procedure diasize_need-full-display :
     4129     define output parameter p-need-full-display as logical   no-undo .
     4130     do
     4131     on error undo, return error return-value
     4132     :
     4133       assign
     4134         p-need-full-display = v-diasize-need-full-display
     4135       .
     4136       assign
     4137         v-diasize-need-full-display = false
     4138       .
     4139     end.
     4140   end procedure.
     4141   procedure get-context :
     4142      define output parameter p-db-num as integer          no-undo.
     4143      define output parameter p-user-id as character        no-undo.
     4144      define variable v-login               as character    no-undo.
     4145      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4146      define buffer buf_user-login  for ub.user-login .
     4147      do
     4148      on error undo, return error
     4149      :
     4150            FIND FIRST buf_sys-ctrl no-lock.
     4151            ASSIGN
     4152               v-login = USERID("ub")
     4153               p-db-num = buf_sys-ctrl.db-num
     4154            .
     4155            FIND FIRST buf_user-login
     4156                 WHERE buf_user-login.db-num = p-db-num
     4157                   AND buf_user-login.user-login = v-login
     4158                 no-lock
     4159                 no-error
     4160                 .
     4161            IF AVAILABLE buf_user-login
     4162            THEN DO:
     4163               assign
     4164                  p-user-id = buf_user-login.user-id
     4165               .
     4166            END.
     4167      end.
     4168   end procedure.
     4169       run diasize_init in this-procedure .
