     2149   ON VALUE-CHANGED OF l-ban-discnt IN FRAME Dialog-Frame
     2150   DO:
     2151     assign l-ban-discnt.
     2152     run tog-band .
     2153   END.
     2154   ON VALUE-CHANGED OF loc_calc-round-method IN FRAME Dialog-Frame
     2155   DO:
     2156     if lookup( input frame Dialog-Frame loc_calc-round-method, 'Произвольно,Вверх,Коэффициент,9-99окончание':U ) > 0 then do:
     2157        enable loc_calc-round-base with frame Dialog-Frame.
     2158     end.
     2159     ELSE hide loc_calc-round-base in frame Dialog-Frame.
     2160   END.
     2161   ON LEAVE OF loc_curr-code IN FRAME Dialog-Frame
     2162   DO:
     2163     assign loc_curr-code .
     2164   END.
     2165   ON VALUE-CHANGED OF loc_have-rs-qnty-group IN FRAME page-1
     2166   DO:
     2167     ASSIGN  loc_have-rs-qnty-group.
     2168     IF loc_have-rs-qnty-group = TRUE THEN DO:
     2169         assign
     2170           loc_have-rs-sum-group  = false
     2171           loc_have-rs-turn-group = false
     2172           loc_have-rs-qnty-group = true
     2173         .
     2174         display loc_have-rs-sum-group when loc_have-rs-sum-group:visible
     2175                 loc_have-rs-turn-group  when     loc_have-rs-turn-group:visible
     2176                 loc_have-rs-qnty-group  when     loc_have-rs-qnty-group:visible
     2177                 WITH FRAME  page-1  .
     2178         APPLY "CHOOSE":U TO r-qnty-grp.
     2179         ENABLE r-qnty-grp WITH FRAME  page-1  .
     2180     END.
     2181     ELSE DO:
     2182         ASSIGN loc_qgr-id = 0
     2183                loc_qgr-db-num = 0
     2184                loc_qg_name = ""
     2185             .
     2186         DISABLE r-qnty-grp WITH FRAME page-1 .
     2187         IF loc_have-rs-qnty-group:VISIBLE  THEN
     2188             DISPLAY
     2189                loc_qgr-id
     2190                loc_qgr-db-num
     2191                loc_qg_name
     2192             WITH FRAME page-1 .
     2193     END.
     2194   END.
     2195   ON VALUE-CHANGED OF loc_have-rs-sum-group IN FRAME page-1
     2196   DO:
     2197       ASSIGN  loc_have-rs-sum-group.
     2198     IF loc_have-rs-sum-group = TRUE THEN DO:
     2199         assign
     2200           loc_have-rs-sum-group  = true
     2201           loc_have-rs-turn-group = false
     2202           loc_have-rs-qnty-group = false
     2203         .
     2204         display loc_have-rs-sum-group when loc_have-rs-sum-group:visible
     2205                 loc_have-rs-turn-group  when     loc_have-rs-turn-group:visible
     2206                 loc_have-rs-qnty-group  when     loc_have-rs-qnty-group:visible
     2207                 WITH FRAME  page-1  .
     2208         APPLY "CHOOSE":U TO r-qnty-sgr.
     2209         ENABLE r-qnty-sgr WITH FRAME page-1 .
     2210     END.
     2211     ELSE DO:
     2212         ASSIGN loc_sgr-id = 0
     2213                loc_sgr-db-num = 0
     2214                loc_sg_name = ""
     2215             .
     2216         DISABLE r-qnty-sgr WITH FRAME page-1 .
     2217         IF loc_have-rs-sum-group:VISIBLE  THEN
     2218             DISPLAY
     2219                loc_sgr-id
     2220                loc_sgr-db-num
     2221                loc_sg_name
     2222             WITH FRAME page-1 .
     2223     END.
     2224   END.
     2225   ON VALUE-CHANGED OF loc_have-rs-turn-group IN FRAME page-1
     2226   DO:
     2227       ASSIGN  loc_have-rs-turn-group.
     2228     IF loc_have-rs-turn-group = TRUE THEN DO:
     2229         assign
     2230           loc_have-rs-sum-group  = false
     2231           loc_have-rs-qnty-group = false
     2232         .
     2233         display loc_have-rs-sum-group   when loc_have-rs-sum-group:visible
     2234                 loc_have-rs-turn-group  when loc_have-rs-turn-group:visible
     2235                 loc_have-rs-qnty-group  when loc_have-rs-qnty-group:visible
     2236                 WITH FRAME  page-1  .
     2237         APPLY "CHOOSE":U TO r-have-tog.
     2238         ENABLE r-have-tog WITH FRAME page-1 .
     2239     END.
     2240     ELSE DO:
     2241         ASSIGN loc_have-tog-id = 0
     2242                loc_have-tog-db-num = 0
     2243                loc_have-tog_name = ""
     2244             .
     2245         DISABLE r-qnty-sgr WITH FRAME page-1 .
     2246         IF loc_have-rs-sum-group:VISIBLE  THEN
     2247             DISPLAY
     2248                loc_have-tog-id
     2249                loc_have-tog-db-num
     2250                loc_have-tog_name
     2251             WITH FRAME page-1 .
     2252     END.
     2253   END.
     2254   ON LEAVE OF loc_name IN FRAME Dialog-Frame
     2255   DO:
     2256     ASSIGN loc_name .
     2257   END.
     2258   ON VALUE-CHANGED OF loc_obj-turnover IN FRAME page-2
     2259   DO:
     2260     ASSIGN  loc_obj-turnover  .
     2261     case  loc_obj-turnover  :
     2262       when yes then do:
     2263         if loc_obj-turnover:visible then
     2264         enable r-gop-calc with frame page-2 .
     2265         apply "choose" to r-gop-calc .
     2266       end.
     2267       when no then do:
     2268         disable r-gop-calc with frame page-2 .
     2269       end.
     2270     end case.
     2271   END.
     2272   ON VALUE-CHANGED OF loc_only-gbd IN FRAME Dialog-Frame
     2273   DO:
     2274     ASSIGN loc_only-gbd.
     2275     run runav.
     2276   END.
     2277   ON VALUE-CHANGED OF loc_rs-buyer IN FRAME page-2
     2278   DO:
     2279     ASSIGN loc_rs-buyer .
     2280     case loc_rs-buyer :
     2281     when 0 then do:
     2282        assign
     2283         loc_bgr-id = 0
     2284         loc_bgr-db-num = 0
     2285         loc_bgr_name = ""
     2286        .
     2287        disable r-gop-2 with frame page-2 .
     2288        assign
     2289         loc_tog-id = 0
     2290         loc_tog-db-num = 0
     2291         loc_tog_name = ""
     2292        .
     2293        disable r-qnty-tog  loc_obj-turnover  r-gop-calc with frame page-2 .
     2294        if loc_tog-id:visible   then display
     2295        loc_tog-id
     2296        loc_tog-db-num
     2297        loc_tog_name
     2298        with frame page-2 .
     2299        if loc_bgr-id:visible   then display
     2300        loc_bgr-id
     2301        loc_bgr-db-num
     2302        loc_bgr_name
     2303        with frame page-2 .
     2304     end.
     2305     when 1 then do:
     2306        APPLY "CHOOSE":U TO r-gop-2.
     2307        enable r-gop-2 with frame page-2 .
     2308        assign
     2309         loc_tog-id = 0
     2310         loc_tog-db-num = 0
     2311         loc_tog_name = ""
     2312        .
     2313        disable r-qnty-tog loc_obj-turnover  r-gop-calc with frame page-2 .
     2314        if loc_tog-id:visible   then display
     2315        loc_tog-id
     2316        loc_tog-db-num
     2317        loc_tog_name
     2318        with frame page-2 .
     2319     end.
     2320     when 2 then do:
     2321        APPLY "CHOOSE":U TO r-qnty-tog.
     2322        enable r-qnty-tog with frame page-2 .
     2323        assign
     2324         loc_bgr-id = 0
     2325         loc_bgr-db-num = 0
     2326         loc_bgr_name = ""
     2327        .
     2328        disable r-gop-2 with frame page-2 .
     2329        if loc_bgr-id:visible   then display
     2330        loc_bgr-id
     2331        loc_bgr-db-num
     2332        loc_bgr_name
     2333        with frame page-2 .
     2334        enable loc_obj-turnover  with frame page-2 .
     2335     end.
     2336     end case.
     2337   END.
     2338   ON VALUE-CHANGED OF loc_under-type-list IN FRAME Dialog-Frame
     2339   DO:
     2340     assign  loc_under-type-list.
     2341     if loc_under-type-list = true then do:
     2342         apply "choose":u to r-rod-price-type in frame Dialog-Frame .
     2343         enable r-rod-price-type
     2344                loc_under-hand-corr
     2345                with frame Dialog-Frame .
     2346         display
     2347             loc_plt-main-id
     2348             loc_plt-main-db-num
     2349             loc_rod-pt-name
     2350         with frame Dialog-Frame .
     2351     end.
     2352     else do:
     2353         assign loc_plt-main-id = 0
     2354                loc_plt-main-db-num = 0
     2355                loc_rod-pt-name = ""
     2356                loc_under-hand-corr = no
     2357         .
     2358         hide r-rod-price-type
     2359              loc_under-hand-corr
     2360              loc_plt-main-id
     2361              loc_plt-main-db-num
     2362              loc_rod-pt-name
     2363              in frame Dialog-Frame .
     2364     end.
     2365   END.
     2366   ON VALUE-CHANGED OF loc_use-cash-pay IN FRAME page-3
     2367   DO:
     2368   define variable p-rid-list   as character no-undo .
     2369   define variable ii           as integer   no-undo .
     2370   define variable v-name       as character no-undo .
     2371   define buffer   buf_cash-pay for ub.cash-pay  .
     2372   for each TT_price-list-type-cash-pay : delete TT_price-list-type-cash-pay . end.
     2373   v-spis-use-cash-pay = "".
     2374     ASSIGN loc_use-cash-pay.
     2375     IF loc_use-cash-pay = true  THEN DO:
     2376         DISPLAY v-spis-use-cash-pay WITH FRAME page-3.
     2377         ENABLE v-spis-use-cash-pay WITH FRAME page-3.
     2378         run ref/cashpays.w (
     2379              input parparentproc
     2380             ,input "b-sel,b-mark"
     2381             ,input 'все':U
     2382             ,input v-cntxt-host-code-obj
     2383             ,input v-cntxt-obj-type
     2384             ,input v-cntxt-obj-code
     2385             ,output p-rid-list ) .
     2386             if p-rid-list = "" or p-rid-list = ? then do:
     2387                loc_use-cash-pay = false .
     2388                display loc_use-cash-pay with frame page-3 .
     2389                return.
     2390             end.
     2391             v-nn = num-entries(p-rid-list) .
     2392             repeat ii = 1 to  v-nn :
     2393               find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer (entry( ii , p-rid-list )) no-error .
     2394               if available buf_cash-pay then do:
     2395                  create TT_price-list-type-cash-pay.
     2396                  assign
     2397                    TT_price-list-type-cash-pay.cdpay-code    = buf_cash-pay.cdpay-code
     2398                    TT_price-list-type-cash-pay.curr-code     = buf_cash-pay.curr-code
     2399                    TT_price-list-type-cash-pay.plt-db-num    = -1
     2400                    TT_price-list-type-cash-pay.plt-id        = -1
     2401                    v-spis-use-cash-pay = v-spis-use-cash-pay + buf_cash-pay.obj-name  + chr(10)
     2402                  .
     2403               end.
     2404             end.
     2405             DISPLAY v-spis-use-cash-pay WITH FRAME page-3.
     2406     END.
     2407     ELSE DO:
     2408         HIDE v-spis-use-cash-pay IN FRAME page-3.
     2409     END.
     2410   END.
     2411   ON VALUE-CHANGED OF loc_use-cassa IN FRAME page-2
     2412   DO:
     2413   define variable p-rid-list as character no-undo .
     2414   define variable ii         as integer   no-undo .
     2415   define buffer   buf_cash-desk for ub.cash-desk  .
     2416   for each TT_price-list-type-cassa : delete TT_price-list-type-cassa . end.
     2417   v-spis-kass = "".
     2418     ASSIGN loc_use-cassa.
     2419     IF loc_use-cassa = 3 THEN DO:
     2420         DISPLAY v-spis-kass WITH FRAME page-2.
     2421         ENABLE v-spis-kass WITH FRAME page-2.
     2422         run ref/cashlist.w (
     2423             parparentproc
     2424             ,"b-sel,b-mark"
     2425             ,'все':U
     2426             , v-cntxt-db-num
     2427             ,v-cntxt-host-code-obj
     2428             ,v-cntxt-obj-type
     2429             ,v-cntxt-obj-code
     2430             ,?
     2431             ,OUTPUT p-rid-list ) .
     2432             if p-rid-list = "" or p-rid-list = ? then do:
     2433                loc_use-cassa = 1.
     2434                display loc_use-cassa with frame page-2 .
     2435                return.
     2436             end.
     2437             v-nn = num-entries(p-rid-list).
     2438             repeat ii = 1 to  v-nn :
     2439               find first buf_cash-desk no-lock where  recid(buf_cash-desk) = integer (entry( ii , p-rid-list )) no-error .
     2440               if available buf_cash-desk then do:
     2441                  create TT_price-list-type-cassa.
     2442                  assign
     2443                    TT_price-list-type-cassa.cash-num     = buf_cash-desk.cash-num
     2444                    TT_price-list-type-cassa.db-num       = buf_cash-desk.db-num
     2445                    TT_price-list-type-cassa.obj-code     = buf_cash-desk.obj-code
     2446                    TT_price-list-type-cassa.plt-db-num   = -1
     2447                    TT_price-list-type-cassa.plt-id       = -1
     2448                    TT_price-list-type-cassa.pos-type     = buf_cash-desk.pos-type
     2449                  .
     2450                  v-spis-kass = v-spis-kass +
     2451                  "БД:"  + string(buf_cash-desk.db-num) +
     2452                  " маг" + string(buf_cash-desk.obj-code) +
     2453                  " №"   + string (buf_cash-desk.cash-num) +
     2454                  " "    +  buf_cash-desk.pos-type
     2455                   + chr(10) .
     2456               end.
     2457             end.
     2458             DISPLAY v-spis-kass WITH FRAME page-2.
     2459     END.
     2460     ELSE DO:
     2461         HIDE v-spis-kass IN FRAME page-2.
     2462     END.
     2463   END.
     2464   ON VALUE-CHANGED OF loc_use-gds-group IN FRAME page-3
     2465   DO:
     2466   define variable p-rid-list  as character no-undo .
     2467   define variable ii          as integer   no-undo .
     2468   define variable v-name      as character no-undo .
     2469   define buffer   buf_gds-grp for ub.gds-grp  .
     2470   for each TT_price-list-type-gds-grp : delete TT_price-list-type-gds-grp . end.
     2471   v-spis-group = "".
     2472     ASSIGN loc_use-gds-group.
     2473     IF loc_use-gds-group = true  THEN DO:
     2474         DISPLAY v-spis-group WITH FRAME page-3.
     2475         ENABLE v-spis-group WITH FRAME page-3.
     2476         run ref/gds-grp.w (
     2477             parparentproc
     2478             ,"b-sel,b-mark"
     2479             ,v-cntxt-obj-type
     2480             ,v-cntxt-obj-code
     2481             ,input-output p-rid-list ) .
     2482             if p-rid-list = "" or p-rid-list = ? then do:
     2483                loc_use-gds-group = false .
     2484                display loc_use-gds-group with frame page-3 .
     2485                return.
     2486             end.
     2487             v-nn = num-entries(p-rid-list) .
     2488             repeat ii = 1 to  v-nn :
     2489               find first buf_gds-grp no-lock where  recid(buf_gds-grp) = integer (entry( ii , p-rid-list )) no-error .
     2490               if available buf_gds-grp then do:
     2491                  create TT_price-list-type-gds-grp.
     2492                  assign
     2493                    TT_price-list-type-gds-grp.node-code    = buf_gds-grp.node-code
     2494                    TT_price-list-type-gds-grp.plt-db-num   = -1
     2495                    TT_price-list-type-gds-grp.plt-id       = -1
     2496                  .
     2497   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2498   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run grpgdsnm in g#library
     2499     (input  buf_gds-grp.node-code
     2500     ,output v-name
     2501     )  .
     2502                  v-spis-group = v-spis-group + v-name + chr(10) .
     2503               end.
     2504             end.
     2505             DISPLAY v-spis-group WITH FRAME page-3.
     2506     END.
     2507     ELSE DO:
     2508         HIDE v-spis-group IN FRAME page-3.
     2509     END.
     2510   END.
     2511   ON VALUE-CHANGED OF loc_use-obj IN FRAME page-2
     2512   DO:
     2513     define variable g#log as logical no-undo .
     2514     ASSIGN loc_use-obj .
     2515     if loc_use-obj = 1 then do:
     2516   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2517   do:
     2518     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2519       (input  v-cntxt-db-num
     2520       ,input  v-cntxt-userid
     2521       ,input  0
     2522       ,input  'actn_documents_all':U
     2523       ,input  'global':U
     2524       ,input  0
     2525       ,input  '':U
     2526       ,input  0
     2527       ,input  0
     2528       ,input  0
     2529       ,input  0
     2530       ,input  true
     2531       ,output g#log
     2532       )  .
     2533   end.
     2534       if not g#log then do:
     2535         if error-status :error then do:
     2536           loc_use-obj = 2.
     2537           display loc_use-obj with frame page-2.
     2538           return.
     2539         end.
     2540       end.
     2541     end.
     2542     case loc_use-obj :
     2543       when 1 then do:
     2544       disable r-gop with frame page-2 .
     2545       end.
     2546       when 2 then do:
     2547         if loc_use-obj:visible then
     2548         enable r-gop with frame page-2 .
     2549         apply "choose":u to r-gop in frame page-2 .
     2550       end.
     2551     end case.
     2552   END.
     2553   ON VALUE-CHANGED OF loc_use-pay-type IN FRAME page-3
     2554   DO:
     2555   define variable p-rid-list   as character no-undo .
     2556   define variable ii           as integer   no-undo .
     2557   define variable v-name       as character no-undo .
     2558   define buffer   buf_pay-type for ub.pay-type  .
     2559   for each TT_price-list-type-pay-type : delete TT_price-list-type-pay-type . end.
     2560   v-spis-type-pay = "" .
     2561     ASSIGN loc_use-pay-type .
     2562     IF loc_use-pay-type = true  THEN DO:
     2563         DISPLAY v-spis-type-pay WITH FRAME page-3.
     2564         ENABLE  v-spis-type-pay WITH FRAME page-3.
     2565         run ref/paytype.w (
     2566               parparentproc
     2567             , "b-sel,b-mark"
     2568             , output p-rid-list ) .
     2569             if p-rid-list = "" or p-rid-list = ? then do:
     2570                loc_use-pay-type = false .
     2571                display loc_use-pay-type with frame page-3 .
     2572                return.
     2573             end.
     2574             v-nn = num-entries(p-rid-list) .
     2575             repeat ii = 1 to v-nn :
     2576               find first buf_pay-type no-lock where  recid(buf_pay-type) = integer (entry( ii , p-rid-list )) no-error .
     2577               if available buf_pay-type then do:
     2578                  create TT_price-list-type-pay-type.
     2579                  assign
     2580                    TT_price-list-type-pay-type.pay-code     = buf_pay-type.obj-code
     2581                    TT_price-list-type-pay-type.plt-db-num   = -1
     2582                    TT_price-list-type-pay-type.plt-id       = -1
     2583                  .
     2584                    v-spis-type-pay = v-spis-type-pay + buf_pay-type.obj-name + chr(10) .
     2585               end.
     2586             end.
     2587             DISPLAY v-spis-type-pay WITH FRAME page-3.
     2588     END.
     2589     ELSE DO:
     2590         HIDE v-spis-type-pay IN FRAME page-3.
     2591     END.
     2592   END.
