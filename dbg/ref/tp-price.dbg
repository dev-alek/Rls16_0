     2825   ON CHOOSE OF r-rod-price-type IN FRAME Dialog-Frame
     2826   DO:
     2827   define variable ref-rec   as recid     no-undo .
     2828   define variable v-ref-rec as character no-undo .
     2829   define buffer buff_price-list-type for ub.price-list-type  .
     2830   run ref/typepric.w ( input  parparentproc , "b-sel" ,  input-output v-ref-rec ) .
     2831    ref-rec = integer (v-ref-rec) .
     2832   if ref-rec = ?  or ref-rec = 0  then return no-apply.
     2833   FIND buff_price-list-type where recid ( buff_price-list-type ) = ref-rec no-lock no-error .
     2834   if error-status :error then do:
     2835   return no-apply .
     2836   end.
     2837   define buffer parent_price-list-type for ub.price-list-type  .
     2838   if p-main-price = true  then do:
     2839       find first parent_price-list-type  no-lock where
     2840                  parent_price-list-type.plt-id     = buff_price-list-type.plt-id  and
     2841                  parent_price-list-type.plt-db-num = buff_price-list-type.plt-db-num no-error .
     2842       if not available parent_price-list-type then do:
     2843          message  "Родительский прайс-лист не найден !" view-as alert-box information .
     2844          return no-apply .
     2845       end.
     2846       if parent_price-list-type.stts <> integer('0':U) then do:
     2847          message  "Родительский прайс-лист удален !" view-as alert-box information  .
     2848          return no-apply .
     2849       end.
     2850       if parent_price-list-type.main = false  then do:
     2851        message  "Родительский прайс-лист должен быть ГЛАВНЫМ !" view-as alert-box information  .
     2852        return no-apply .
     2853        end.
     2854       if parent_price-list-type.under-type-list <> 0  then do:
     2855        message  "Родительский прайс-лист не должен быть подчиненным !" view-as alert-box information  .
     2856        return no-apply .
     2857        end.
     2858   end.
     2859   if p-main-price = false   then do:
     2860       find first parent_price-list-type  no-lock where
     2861                  parent_price-list-type.plt-id     = buff_price-list-type.plt-id  and
     2862                  parent_price-list-type.plt-db-num = buff_price-list-type.plt-db-num no-error .
     2863       if not available parent_price-list-type then  do:
     2864          message "Родительский прайс-лист не найден !" view-as alert-box information .
     2865          return no-apply .
     2866       end.
     2867       if parent_price-list-type.stts <> integer('0':U) then do:
     2868          message  "Родительский прайс-лист удален !"  view-as alert-box information .
     2869          return no-apply .
     2870       end.
     2871       if parent_price-list-type.under-type-list <> 0  then do:
     2872        message  "Родительский прайс-лист не должен быть подчиненным !" view-as alert-box information  .
     2873        return no-apply .
     2874        end.
     2875   end.
     2876   assign
     2877     loc_rod-pt-name     = buff_price-list-type.name
     2878     loc_plt-main-db-num = buff_price-list-type.plt-db-num
     2879     loc_plt-main-id     = buff_price-list-type.plt-id
     2880     loc_priority        = buff_price-list-type.priority
     2881   .
     2882   display
     2883    loc_rod-pt-name
     2884    loc_plt-main-db-num
     2885    loc_plt-main-id
     2886    loc_priority WHEN loc_priority <> 0
     2887    with frame Dialog-Frame .
     2888   run enable1 in this-procedure .
     2889   END.
     2890   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2891   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2892   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2893   on help of frame Dialog-Frame
     2894   do:
     2895     run gbl/app_help.p
     2896       (input this-procedure :file-name
     2897       ,input ''
     2898       ,input ?
     2899       ) no-error.
     2900     if error-status :error then do:
     2901       message
     2902         "Ошибка при вызове помощи"
     2903         error-status :get-message(1)
     2904         view-as alert-box .
     2905     end.
     2906   end.
     2907   run minbtn-set in this-procedure .
     2908   on choose of b-help in frame Dialog-Frame
     2909   do:
     2910     apply "help":u to frame Dialog-Frame .
     2911   end.
     2912   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2913   procedure minbtn-set :
     2914       do
     2915           on error undo, return error return-value
     2916           :
     2917           define variable ii              as integer       no-undo .
     2918           define variable fh              as widget-handle no-undo .
     2919           define variable hh              as widget-handle no-undo .
     2920           define variable v-h             as handle        extent 4 no-undo .
     2921           define variable v-name-button   as character     no-undo .
     2922           define variable v-help-old-x    as decimal       no-undo .
     2923           define variable v-help-old-y    as decimal       no-undo .
     2924           define variable v-help-old-size as decimal       no-undo .
     2925           define variable v-frame-width   as decimal       no-undo .
     2926           define variable jj              as integer       no-undo .
     2927           do
     2928               on error undo, return error
     2929               :
     2930               assign
     2931                   v-frame-width = frame Dialog-Frame:width - 0.3
     2932                   fh            = frame Dialog-Frame:first-child
     2933                   hh            = fh:first-child
     2934                   ii            = 1
     2935                   .
     2936               do while valid-handle(hh):
     2937                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2938                   do:
     2939                       case lc(hh:name) :
     2940                           when "b-help" then
     2941                               do:
     2942                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2943                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2944                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2945                                   hh:TOOLTIP = "Помощь" .
     2946                                   v-help-old-x = hh:column .
     2947                                   v-help-old-y = hh:row    .
     2948                                   v-help-old-size = hh:width .
     2949                                   hh:width-chars = 2.5 .
     2950                               end.
     2951                           when "b-print" then
     2952                               do:
     2953                                   hh:load-image("cmp/b-print.bmp":u) .
     2954                                   hh:TOOLTIP = "Печать" .
     2955                                   v-h[ii] = hh:handle .
     2956                                   ii = ii + 1 .
     2957                                   hh:width-chars = 3 .
     2958                               end.
     2959                           when "b-history" or
     2960                           when "b-hist" then
     2961                               do:
     2962                                   hh:load-image("cmp/b-hist.bmp":u) .
     2963                                   hh:TOOLTIP = "История" .
     2964                                   v-h[ii] = hh:handle .
     2965                                   ii = ii + 1 .
     2966                                   hh:width-chars = 3 .
     2967                               end.
     2968                           when "b-sch" then
     2969                               do:
     2970                                   hh:load-image("cmp/b-sch.bmp":u) .
     2971                                   hh:TOOLTIP = "Установка Фильтра" .
     2972                                   v-h[ii] = hh:handle .
     2973                                   ii = ii + 1 .
     2974                                   hh:width-chars = 3 .
     2975                               end.
     2976                           when "b-hist-user" then
     2977                               do:
     2978                                   hh:load-image("cmp/b-hist.bmp":u) .
     2979                                   hh:TOOLTIP = "История пользователя" .
     2980                                   ii = ii + 1 .
     2981                               end.
     2982                       end case.
     2983                   end.
     2984                   hh = hh:next-sibling.
     2985               end.
     2986               b-help:column = v-frame-width - b-help:width-chars.
     2987               jj = 0.
     2988               repeat ii = 4 to 1 by -1 :
     2989                   if valid-handle (v-h[ii] ) then
     2990                   do:
     2991                       jj  = jj + 1 .
     2992                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2993                       v-h[ii]:row    = v-help-old-y .
     2994                   end.
     2995               end.
     2996           end.
     2997       end.
     2998   end procedure.
     2999   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3000   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3001   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3002   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3003   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3004   define variable v-diasize-current-frame-height as decimal   no-undo .
     3005   define variable v-diasize-change-size          as logical   no-undo .
