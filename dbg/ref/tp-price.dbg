     4825   PROCEDURE disable_UI :
     4826     HIDE FRAME Dialog-Frame.
     4827     HIDE FRAME page-1.
     4828     HIDE FRAME page-2.
     4829     HIDE FRAME page-3.
     4830   END PROCEDURE.
     4831   PROCEDURE enable1 :
     4832     define variable g#log as logical no-undo.
     4833     OPEN QUERY Dialog-Frame FOR EACH ub.price-list-type SHARE-LOCK.
     4834     OPEN QUERY BR-tt FOR EACH temp-avto-price.
     4835     GET FIRST Dialog-Frame.
     4836     DISPLAY loc_name loc_priority loc_create-price-doc loc_fix-cource-crc-base
     4837             loc_send-cassa loc_fix-cource-crc-doc loc_calc-method
     4838             loc_calc-increase-pc loc_calc-round-method
     4839             loc_calc-round-base
     4840             loc_work-date
     4841             loc_only-gbd loc_plt-db-num loc_plt-id create-price-doc-FILL-IN
     4842             loc_curr-code loc_abbr-doc use-cassa-FILL-IN work-date-FILL-IN
     4843             label-button-1 label-button-2 label-button-3
     4844             loc_under-type-list
     4845         WITH FRAME Dialog-Frame.
     4846     ENABLE B-save RECT-1 B-Cancel B-Help loc_name loc_priority
     4847             r-cur loc_fix-cource-crc-base
     4848            loc_fix-cource-crc-doc loc_calc-method loc_calc-increase-pc
     4849            loc_calc-round-method
     4850            loc_work-date loc_only-gbd BUTTON-2
     4851            BUTTON-3 BUTTON-1 loc_plt-db-num loc_plt-id create-price-doc-FILL-IN
     4852            loc_curr-code  use-cassa-FILL-IN work-date-FILL-IN
     4853            label-button-1 label-button-2 label-button-3
     4854            loc_under-type-list
     4855         WITH FRAME Dialog-Frame.
     4856     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     4857   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4858   do:
     4859     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4860       (input  v-cntxt-db-num
     4861       ,input  v-cntxt-userid
     4862       ,input  0
     4863       ,input  'actn_documents_all':U
     4864       ,input  'global':U
     4865       ,input  0
     4866       ,input  '':U
     4867       ,input  0
     4868       ,input  0
     4869       ,input  0
     4870       ,input  0
     4871       ,input  false
     4872       ,output g#log
     4873       )  .
     4874   end.
     4875       if g#log then do:
     4876         loc_use-obj = 1.
     4877         disable r-gop with frame page-2 .
     4878       end.
     4879       else do:
     4880         loc_use-obj = 2.
     4881         enable r-gop with frame page-2 .
     4882       end.
     4883     end.
     4884     if p-main-price = false   then do:
     4885         enable
     4886          loc_send-cassa when p-mode = 'ДОБАВЛЕНИЕ':U
     4887          l-ban-discnt   when p-mode = 'ДОБАВЛЕНИЕ':U
     4888          r-ban-discnt   when p-mode = 'ДОБАВЛЕНИЕ':U
     4889          b-ban-discnt
     4890          with frame Dialog-Frame.
     4891         display
     4892          loc_ban-discnt
     4893          f-ban-discnt
     4894          with frame Dialog-Frame.
     4895     end.
     4896     run tog-band .
     4897     if loc_under-type-list then do:
     4898         display  loc_plt-main-id loc_plt-main-db-num loc_rod-pt-name loc_under-hand-corr  WITH FRAME Dialog-Frame.
     4899         enable   loc_under-hand-corr with frame Dialog-Frame.
     4900         HIDE v-3 IN FRAME page-3 .
     4901         HIDE v-3 loc_use-gds-group loc_use-pay-type v-spis-group v-spis-type-pay loc_use-cash-pay v-spis-use-cash-pay F-ogran IN FRAME page-3 .
     4902         HIDE v-1 IN FRAME page-1 .
     4903         HIDE v-1 loc_have-rs-qnty-group r-qnty-grp loc_have-rs-sum-group r-qnty-sgr loc_have-rs-turn-group r-have-tog loc_qgr-id loc_qgr-db-num loc_qg_name loc_sgr-id loc_sgr-db-num loc_sg_name loc_have-tog-db-num loc_have-tog_name loc_have-tog-id IN FRAME page-1 .
     4904         hide frame page-1  frame page-3  .
     4905         hide  button-1 label-button-1 in frame Dialog-Frame .
     4906         hide  button-3 label-button-3
     4907               loc_fix-cource-crc-base
     4908               loc_fix-cource-crc-doc
     4909               loc_ban-discnt
     4910               loc_only-gbd
     4911               loc_calc-method
     4912         in frame Dialog-Frame .
     4913         loc_calc-increase-pc:label = "% наценки от родителя" .
     4914         loc_calc-round-method:label = "Метод округления"     .
     4915         APPLY "CHOOSE":U TO BUTTON-2 .
     4916         disable  loc_under-type-list  with frame Dialog-Frame.
     4917     end.
     4918     if lookup( loc_calc-round-method, 'Произвольно,Вверх,Коэффициент,9-99окончание':U ) > 0 then do:
     4919       enable loc_calc-round-base with frame Dialog-Frame.
     4920     end.
     4921     else
     4922       hide loc_calc-round-base in frame Dialog-Frame.
     4923     DISPLAY v-1 loc_have-rs-qnty-group loc_have-rs-sum-group loc_qgr-id
     4924               loc_qgr-db-num loc_qg_name loc_sgr-id loc_sgr-db-num loc_sg_name
     4925               loc_have-tog-id
     4926               loc_have-tog-db-num
     4927               r-have-tog
     4928               loc_have-tog_name
     4929               loc_have-rs-turn-group
     4930         WITH FRAME page-1.
     4931     ENABLE v-1 loc_have-rs-qnty-group r-qnty-grp loc_have-rs-sum-group r-qnty-sgr
     4932            loc_qgr-id loc_qgr-db-num loc_qg_name loc_sgr-id loc_sgr-db-num
     4933            loc_sg_name  loc_have-rs-turn-group
     4934         WITH FRAME page-1.
     4935     run vis-bin .
     4936   END PROCEDURE.
     4937   PROCEDURE enable_UI :
     4938     OPEN QUERY Dialog-Frame FOR EACH ub.price-list-type SHARE-LOCK.
     4939     GET FIRST Dialog-Frame.
     4940     DISPLAY loc_priority loc_name loc_under-type-list loc_fix-cource-crc-base
     4941             loc_work-date loc_fix-cource-crc-doc l-ban-discnt loc_calc-method
     4942             loc_create-price-doc loc_calc-increase-pc loc_send-cassa loc_only-gbd
     4943             loc_calc-round-method loc_calc-round-base loc_plt-db-num loc_plt-id
     4944             v-max loc_curr-code loc_abbr-doc work-date-FILL-IN loc_ban-discnt
     4945             f-ban-discnt create-price-doc-FILL-IN use-cassa-FILL-IN label-button-1
     4946             label-button-2 label-button-3
     4947         WITH FRAME Dialog-Frame.
     4948     ENABLE B-save B-Cancel B-Help RECT-1 loc_priority loc_name r-cur
     4949            loc_under-type-list BUTTON-1 loc_fix-cource-crc-base loc_work-date
     4950            loc_fix-cource-crc-doc l-ban-discnt b-ban-discnt loc_calc-method
     4951            loc_calc-increase-pc loc_only-gbd loc_calc-round-method
     4952            loc_calc-round-base BUTTON-2 BUTTON-3 loc_plt-db-num loc_plt-id
     4953            loc_curr-code loc_abbr-doc work-date-FILL-IN loc_ban-discnt
     4954            f-ban-discnt create-price-doc-FILL-IN use-cassa-FILL-IN
     4955         WITH FRAME Dialog-Frame.
     4956     DISPLAY v-1 loc_have-rs-qnty-group loc_have-rs-sum-group
     4957             loc_have-rs-turn-group loc_qgr-id loc_qgr-db-num loc_qg_name
     4958             loc_sgr-id loc_sgr-db-num loc_sg_name loc_have-tog-db-num
     4959             loc_have-tog_name loc_have-tog-id
     4960         WITH FRAME page-1.
     4961     ENABLE v-1 loc_have-rs-qnty-group r-qnty-grp b-qnty-grp loc_have-rs-sum-group
     4962            r-qnty-sgr b-qnty-sgr loc_have-rs-turn-group r-have-tog b-have-tog
     4963            loc_qgr-id loc_qgr-db-num loc_qg_name loc_sgr-id loc_sgr-db-num
     4964            loc_sg_name loc_have-tog-db-num loc_have-tog_name loc_have-tog-id
     4965         WITH FRAME page-1.
     4966     DISPLAY r-use-obj-fill-in loc_gop-db-num f-ie-3 loc_tog-db-num r-obj-fill-in
     4967             loc_gop-db-num-for-calc-turnover
     4968         WITH FRAME page-2.
     4969     ENABLE b-gop BR-tt b-gop-2 r-qnty-tog b-qnty-tog b-gop-calc B-chga
     4970            r-use-obj-fill-in f-ie-3 loc_tog-db-num r-obj-fill-in
     4971         WITH FRAME page-2.
     4972     OPEN QUERY BR-tt FOR EACH temp-avto-price.
     4973     DISPLAY v-3
     4974         WITH FRAME page-3.
     4975     ENABLE v-3
     4976         WITH FRAME page-3.
     4977   END PROCEDURE.
     4978   PROCEDURE init-proc :
     4979   assign
     4980         loc_abbr-doc                          =    ""
     4981         loc_ban-discnt                        =    ub.price-list-type.ban-discnt
     4982         loc_bgr_name                          =    ""
     4983         loc_calc-round-method                 =    ub.price-list-type.calc-round-method
     4984         loc_calc-round-base                   =    ub.price-list-type.calc-round-base
     4985         loc_calc-increase-pc                  =    ub.price-list-type.calc-increase-pc
     4986         loc_calc-method                       =    ub.price-list-type.calc-method
     4987         loc_create-price-doc                  =    ub.price-list-type.create-price-doc
     4988         loc_fix-cource-crc-base               =    ub.price-list-type.fix-cource-crc-base
     4989         loc_fix-cource-crc-doc                =    ub.price-list-type.fix-cource-crc-doc
     4990         loc_gop_name-name                     =    ""
     4991         loc_gop_name-tnv                      =    ""
     4992         loc_have-rs-qnty-group                =    logical(ub.price-list-type.have-rs-qnty-group)
     4993         loc_have-rs-sum-group                 =    ub.price-list-type.have-rs-sum-group
     4994         loc_only-gbd                          =    logical(ub.price-list-type.only-gbd)
     4995         loc_plt-main-db-num                   =    ub.price-list-type.plt-main-db-num
     4996         loc_plt-main-id                       =    ub.price-list-type.plt-main-id
     4997         loc_priority                          =    ub.price-list-type.priority
     4998         loc_qg_name                           =    ""
     4999         loc_rod-pt-name                       =    ""
     5000         loc_rs-buyer                          =    ub.price-list-type.rs-buyer
     5001         loc_send-cassa                        =    ub.price-list-type.send-cassa
     5002         loc_sg_name                           =    ""
     5003         loc_tog_name                          =    ""
     5004         loc_under-hand-corr                   =    logical(ub.price-list-type.under-hand-corr)
     5005         loc_under-round-method                =    ub.price-list-type.under-round-method
     5006         loc_under-perc                        =    ub.price-list-type.under-perc
     5007         loc_under-type-list                   =    logical(ub.price-list-type.under-type-list)
     5008         loc_use-cassa                         =    ub.price-list-type.use-cassa
     5009         loc_use-gds-group                     =    logical(ub.price-list-type.use-gds-group)
     5010         loc_use-obj                           =    ub.price-list-type.use-obj
     5011         loc_work-date                         =    ub.price-list-type.work-date
     5012         loc_bgr-db-num                        =    ub.price-list-type.bgr-db-num
     5013         loc_bgr-id                            =    ub.price-list-type.bgr-id
     5014         loc_curr-code                         =    ub.price-list-type.curr-code
     5015         loc_gop-db-num                        =    ub.price-list-type.gop-db-num
     5016         loc_gop-db-num-for-calc-turnover      =    ub.price-list-type.gop-db-num-for-calc-turnover
     5017         loc_gop-id                            =    ub.price-list-type.gop-id
     5018         loc_gop-id-for-calc-turnover          =    ub.price-list-type.gop-id-for-calc-turnover
     5019         loc_name                              =    ub.price-list-type.name
     5020         loc_plt-db-num                        =    ub.price-list-type.plt-db-num
     5021         loc_plt-id                            =    ub.price-list-type.plt-id
     5022         loc_qgr-db-num                        =    ub.price-list-type.qgr-db-num
     5023         loc_qgr-id                            =    ub.price-list-type.qgr-id
     5024         loc_sgr-db-num                        =    ub.price-list-type.sgr-db-num
     5025         loc_sgr-id                            =    ub.price-list-type.sgr-id
     5026         loc_tog-db-num                        =    ub.price-list-type.tog-db-num
     5027         loc_tog-id                            =    ub.price-list-type.tog-id
     5028         loc_obj-turnover                      =    ub.price-list-type.obj-turnover
     5029         loc_have-rs-turn-group                =   logical( ub.price-list-type.have-rs-turn-group)
     5030         loc_have-tog-db-num                   =   ub.price-list-type.have-tog-db-num
     5031         loc_have-tog-id                       =   ub.price-list-type.have-tog-id
     5032         loc_use-cash-pay                      =   logical(ub.price-list-type.use-cash-pay )
     5033         loc_use-pay-type                      =   logical(ub.price-list-type.use-pay-type )
     5034         .
     5035   define buffer buf_dis-rule for ub.dis-rule  .
     5036     if loc_ban-discnt > 0 then do:
     5037       assign
     5038         l-ban-discnt = true
     5039       .
     5040       find first buf_dis-rule no-lock where
     5041                  buf_dis-rule.templ-rl-root =  loc_ban-discnt
     5042                  no-error .
     5043     if available buf_dis-rule then do:
     5044         assign
     5045           f-ban-discnt   = buf_dis-rule.des
     5046         .
     5047         end.
     5048         else do:
     5049           l-ban-discnt = false .
     5050         end.
     5051     end.
     5052     else do:
     5053       assign
     5054         l-ban-discnt = false
     5055       .
     5056     end.
     5057   run  tog-band.
     5058   define variable loc_exch-rate  as decimal   no-undo .
     5059   define variable loc_exch-scale as decimal   no-undo .
     5060   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5061   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     5062     (input  loc_curr-code
     5063     ,input  TODAY
     5064     ,output loc_exch-rate
     5065     ,output loc_exch-scale
     5066     ,output loc_abbr-doc
     5067     )  .
     5068   find ub.qnty-group no-lock where
     5069        ub.qnty-group.qgr-id     = loc_qgr-id     and
     5070        ub.qnty-group.qgr-db-num = loc_qgr-db-num no-error .
     5071   if available ub.qnty-group then  loc_qg_name    = ub.qnty-group.name  .
     5072   find ub.buyer-group no-lock where
     5073        ub.buyer-group.bgr-db-num = loc_bgr-db-num  and
     5074        ub.buyer-group.bgr-id     = loc_bgr-id      no-error .
     5075   if available ub.buyer-group then  loc_bgr_name   = ub.buyer-group.name  .
     5076   find ub.grp-obj-price no-lock where
     5077        ub.grp-obj-price.gop-db-num  = loc_gop-db-num     and
     5078        ub.grp-obj-price.gop-id      = loc_gop-id         no-error .
     5079   if available ub.grp-obj-price then loc_gop_name-name = ub.grp-obj-price.name  .
     5080   find ub.grp-obj-price no-lock where
     5081        ub.grp-obj-price.gop-db-num  = loc_gop-db-num-for-calc-turnover     and
     5082        ub.grp-obj-price.gop-id      = loc_gop-id-for-calc-turnover         no-error .
     5083   if available ub.grp-obj-price then loc_gop_name-tnv = ub.grp-obj-price.name  .
     5084   find ub.price-list-type no-lock where
     5085        ub.price-list-type.plt-db-num =  loc_plt-main-db-num  and
     5086        ub.price-list-type.plt-id     =  loc_plt-main-id      no-error .
     5087   if available ub.price-list-type then loc_rod-pt-name     = ub.price-list-type.name  .
     5088   find ub.sum-group no-lock where
     5089        ub.sum-group.sgr-db-num = loc_sgr-db-num and
     5090        ub.sum-group.sgr-id     = loc_sgr-id     no-error .
     5091   if available ub.sum-group then loc_sg_name    = ub.sum-group.name  .
     5092   find ub.turnover-group no-lock where
     5093        ub.turnover-group.tog-db-num = loc_tog-db-num and
     5094        ub.turnover-group.tog-id     = loc_tog-id     no-error .
     5095   if available ub.turnover-group then loc_tog_name    = ub.turnover-group.name  .
     5096   find ub.turnover-group no-lock where
     5097        ub.turnover-group.tog-db-num = loc_have-tog-db-num and
     5098        ub.turnover-group.tog-id     = loc_have-tog-id     no-error .
     5099   if available ub.turnover-group then loc_have-tog_name    = ub.turnover-group.name  .
     5100            run avtoinit
     5101                ( input   loc_plt-id
     5102                 ,input   loc_plt-db-num
     5103                 ,output  loc_ie-gen-marg
     5104                 ,output  loc_ie-gen-marg-parts
     5105                 ,output  loc_ie-objfirst
     5106                 ,output  loc_ie-objsecond
     5107                 ,output  loc_ie-pr-nakl
     5108                 ,output  loc_iv-gen-marg
     5109                 ,output  loc_iv-gen-marg-parts
     5110                 ,output  loc_iv-objfirst
     5111                 ,output  loc_iv-objsecond
     5112                 ,output  loc_iv-pr-nakl
     5113                 ,output  loc_im-gen-marg
     5114                 ,output  loc_im-gen-marg-parts
     5115                 ,output  loc_im-objfirst
     5116                 ,output  loc_im-objsecond
     5117                 ,output  loc_im-pr-nakl   ) .
     5118   run runav.
     5119   END PROCEDURE.
     5120   PROCEDURE init-spis-cash-pay :
     5121   define buffer buf_price-list-type-cash-pay for ub.price-list-type-cash-pay  .
     5122   define buffer buf_cash-pay for ub.cash-pay  .
     5123   define variable v-name as character no-undo .
     5124   for each TT_price-list-type-cash-pay : delete TT_price-list-type-cash-pay . end.
     5125   v-spis-use-cash-pay = "".
     5126      for each buf_price-list-type-cash-pay no-lock where
     5127               buf_price-list-type-cash-pay.stts       = 0 and
     5128               buf_price-list-type-cash-pay.plt-id     = ub.price-list-type.plt-id and
     5129               buf_price-list-type-cash-pay.plt-db-num = ub.price-list-type.plt-db-num
     5130               :
     5131               create TT_price-list-type-cash-pay.
     5132               BUFFER-COPY buf_price-list-type-cash-pay TO TT_price-list-type-cash-pay.
     5133               find first buf_cash-pay no-lock   where
     5134                    buf_cash-pay.cdpay-code  = TT_price-list-type-cash-pay.cdpay-code  and
     5135                    buf_cash-pay.curr-code   = TT_price-list-type-cash-pay.curr-code
     5136                    no-error .
     5137               if available  buf_cash-pay then .
     5138               v-spis-use-cash-pay  = v-spis-use-cash-pay +  buf_cash-pay.obj-name + v-name + chr(10) .
     5139       end.
     5140   END PROCEDURE.
     5141   PROCEDURE init-spis-gds-grp :
     5142   do
     5143   on error undo, return error return-value
     5144     :
     5145   define buffer buf_price-list-type-gds-grp for ub.price-list-type-gds-grp  .
     5146   define variable v-name as character no-undo .
     5147   for each TT_price-list-type-gds-grp : delete TT_price-list-type-gds-grp . end.
     5148   v-spis-group = "".
     5149       for each buf_price-list-type-gds-grp no-lock where
     5150               buf_price-list-type-gds-grp.stts       = 0 and
     5151               buf_price-list-type-gds-grp.plt-id     = ub.price-list-type.plt-id and
     5152               buf_price-list-type-gds-grp.plt-db-num = ub.price-list-type.plt-db-num
     5153               :
     5154               create TT_price-list-type-gds-grp.
     5155               BUFFER-COPY buf_price-list-type-gds-grp TO TT_price-list-type-gds-grp.
     5156   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5157   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run grpgdsnm in g#library
     5158     (input  buf_price-list-type-gds-grp.node-code
     5159     ,output v-name
     5160     )  .
     5161                v-spis-group = v-spis-group + v-name + chr(10) .
     5162       end.
     5163   end.
     5164   END PROCEDURE.
     5165   PROCEDURE init-spis-kass :
     5166   do
     5167   on error undo, return error return-value
     5168     :
     5169   define buffer buf_price-list-type-cassa for ub.price-list-type-cassa  .
     5170   for each TT_price-list-type-cassa : delete TT_price-list-type-cassa . end.
     5171   v-spis-kass = "".
     5172       for each buf_price-list-type-cassa no-lock where
     5173               buf_price-list-type-cassa.stts       = 0  and
     5174               buf_price-list-type-cassa.plt-id     = ub.price-list-type.plt-id and
     5175               buf_price-list-type-cassa.plt-db-num = ub.price-list-type.plt-db-num
     5176               :
     5177               create TT_price-list-type-cassa.
     5178               BUFFER-COPY buf_price-list-type-cassa TO TT_price-list-type-cassa.
     5179                 v-spis-kass = v-spis-kass +
     5180                 "БД:"  + string ( buf_price-list-type-cassa.db-num   ) +
     5181                 " маг" + string ( buf_price-list-type-cassa.obj-code ) +
     5182                 " №"   + string ( buf_price-list-type-cassa.cash-num ) +
     5183                 " "    +  buf_price-list-type-cassa.pos-type
     5184                 + chr(10) .
     5185       end.
     5186   end.
     5187   end procedure.
     5188   PROCEDURE init-spis-pay-type :
     5189   define buffer buf_price-list-type-pay-type for ub.price-list-type-pay-type  .
     5190   define buffer buf_pay-type for ub.pay-type  .
     5191   define variable v-name as character no-undo .
     5192   for each TT_price-list-type-pay-type : delete TT_price-list-type-pay-type . end.
     5193   v-spis-type-pay = "".
     5194      for each buf_price-list-type-pay-type no-lock where
     5195               buf_price-list-type-pay-type.stts       = 0 and
     5196               buf_price-list-type-pay-type.plt-id     = ub.price-list-type.plt-id and
     5197               buf_price-list-type-pay-type.plt-db-num = ub.price-list-type.plt-db-num
     5198               :
     5199               create TT_price-list-type-pay-type.
     5200               BUFFER-COPY buf_price-list-type-pay-type TO TT_price-list-type-pay-type.
     5201               find first buf_pay-type no-lock   where  buf_pay-type.obj-code  = TT_price-list-type-pay-type.pay-code no-error .
     5202               if available  buf_pay-type then .
     5203               v-spis-type-pay = v-spis-type-pay + buf_pay-type.obj-name + chr(10) .
     5204       end.
     5205   END PROCEDURE.
     5206   PROCEDURE make-tt :
     5207   define input parameter p-ie-gen-marg  as character no-undo .
     5208   define input parameter p-ie-gen-marg-parts  as character no-undo .
     5209   define input parameter p-ie-objfirst  as integer   no-undo .
     5210   define input parameter p-ie-objsecond as integer   no-undo .
     5211   define input parameter p-ie-pr-nakl   as logical   no-undo .
     5212   define input parameter p-iv-gen-marg  as character no-undo .
     5213   define input parameter p-iv-gen-marg-parts  as character no-undo .
     5214   define input parameter p-iv-objfirst  as integer   no-undo .
     5215   define input parameter p-iv-objsecond as integer   no-undo .
     5216   define input parameter p-iv-pr-nakl   as logical   no-undo .
     5217   define input parameter p-im-gen-marg  as character no-undo .
     5218   define input parameter p-im-gen-marg-parts  as character no-undo .
     5219   define input parameter p-im-objfirst  as integer   no-undo .
     5220   define input parameter p-im-objsecond as integer   no-undo .
     5221   define input parameter p-im-pr-nakl   as logical   no-undo .
     5222   empty temp-table temp-avto-price .
     5223   create temp-avto-price.
     5224   assign
     5225     temp-avto-price.nn             =  1
     5226     temp-avto-price.ext-doc-type   =  "Приход внешний"
     5227     temp-avto-price.gen-marg       =  p-ie-gen-marg
     5228     temp-avto-price.gen-marg-parts =  p-ie-gen-marg-parts
     5229     temp-avto-price.objfirst       =  p-ie-objfirst
     5230     temp-avto-price.objsecond      =  p-ie-objsecond
     5231     temp-avto-price.pr-nakl        =  p-ie-pr-nakl
     5232   .
     5233   create temp-avto-price.
     5234   assign
     5235     temp-avto-price.nn             =  2
     5236     temp-avto-price.ext-doc-type   =  "Внутр.перемещение"
     5237     temp-avto-price.gen-marg       =  p-iv-gen-marg
     5238     temp-avto-price.gen-marg-parts =  p-iv-gen-marg-parts
     5239     temp-avto-price.objfirst       =  p-iv-objfirst
     5240     temp-avto-price.objsecond      =  p-iv-objsecond
     5241     temp-avto-price.pr-nakl        =  p-iv-pr-nakl
     5242   .
     5243   create temp-avto-price.
     5244   assign
     5245     temp-avto-price.nn             =  3
     5246     temp-avto-price.ext-doc-type   =  "Производство"
     5247     temp-avto-price.gen-marg       =  p-im-gen-marg
     5248     temp-avto-price.gen-marg-parts =  p-im-gen-marg-parts
     5249     temp-avto-price.objfirst       =  p-im-objfirst
     5250     temp-avto-price.objsecond      =  p-im-objsecond
     5251     temp-avto-price.pr-nakl        =  p-im-pr-nakl
     5252   .
     5253   END PROCEDURE.
     5254   PROCEDURE mode_add-init :
     5255   disable r-rod-price-type    with frame Dialog-Frame  .
     5256   disable loc_under-hand-corr with frame Dialog-Frame  .
     5257   hide    r-rod-price-type
     5258           loc_under-hand-corr
     5259           loc_plt-main-id
     5260           in frame Dialog-Frame  .
     5261   disable r-qnty-grp          with frame page-1  .
     5262   disable r-qnty-sgr          with frame page-1  .
     5263   if loc_use-obj = 1 then do:
     5264     disable r-gop with frame page-2 .
     5265   end.
     5266   else do:
     5267     enable r-gop with frame page-2 .
     5268   end.
     5269   disable loc_obj-turnover    with frame page-2 .
     5270   disable r-gop-calc          with frame page-2 .
     5271   disable r-gop-2             with frame page-2 .
     5272   disable r-qnty-tog          with frame page-2 .
     5273   define variable loc_exch-rate  as decimal   no-undo .
     5274   define variable loc_exch-scale as decimal   no-undo .
     5275   if loc_curr-code:modified = false  then do:
     5276   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5277   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-curr in g#library
     5278     (input  v-cntxt-host-code-obj
     5279     ,output loc_curr-code
     5280     )  .
     5281   end.
     5282   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5283   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     5284     (input  loc_curr-code
     5285     ,input  today
     5286     ,output loc_exch-rate
     5287     ,output loc_exch-scale
     5288     ,output loc_abbr-doc
     5289     )  .
     5290     display loc_curr-code
     5291             loc_abbr-doc
     5292             with frame Dialog-Frame .
     5293   END PROCEDURE.
     5294   PROCEDURE my_enable :
     5295   define variable g-log as logical   no-undo .
     5296     if p-mode = 'ДОБАВЛЕНИЕ':U or  p-mode = 'ПРОСМОТР':U then do:
     5297        run all-mode.
     5298     end.
     5299     if p-mode = 'ПРОСМОТР':U then do:
     5300        run my_lookup in this-procedure .
     5301     end.
     5302     if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     5303     find ub.price-list-type no-lock where recid(ub.price-list-type) =  p-recid no-error .
     5304         disable
     5305           r-cur
     5306           loc_work-date
     5307           loc_fix-cource-crc-doc
     5308           with frame Dialog-Frame
     5309           .
     5310         disable
     5311           loc_under-type-list
     5312           r-rod-price-type
     5313           loc_under-hand-corr          WHEN loc_under-type-list = false
     5314           with frame Dialog-Frame
     5315           .
     5316          if  loc_under-type-list = false then do:
     5317               hide
     5318                 loc_plt-main-id
     5319                 r-rod-price-type
     5320                 loc_under-hand-corr
     5321                 in frame Dialog-Frame
     5322                 .
     5323          end.
     5324          else do:
     5325            HIDE v-3 IN FRAME page-3 .
     5326            HIDE v-3 loc_use-gds-group loc_use-pay-type v-spis-group v-spis-type-pay loc_use-cash-pay v-spis-use-cash-pay F-ogran IN FRAME page-3 .
     5327            HIDE v-1 IN FRAME page-1 .
     5328            HIDE v-1 loc_have-rs-qnty-group r-qnty-grp loc_have-rs-sum-group r-qnty-sgr loc_have-rs-turn-group r-have-tog loc_qgr-id loc_qgr-db-num loc_qg_name loc_sgr-id loc_sgr-db-num loc_sg_name loc_have-tog-db-num loc_have-tog_name loc_have-tog-id IN FRAME page-1 .
     5329            hide frame page-1  frame page-3  .
     5330            hide  button-1 label-button-1 in frame Dialog-Frame .
     5331            hide  button-3 label-button-3
     5332                  loc_fix-cource-crc-base
     5333                  loc_fix-cource-crc-doc
     5334                  loc_ban-discnt
     5335                  loc_only-gbd
     5336                  loc_calc-method
     5337            in frame Dialog-Frame .
     5338            loc_calc-increase-pc:label = "% наценки от родителя" .
     5339            loc_calc-round-method:label = "Метод округления"     .
     5340            APPLY "CHOOSE":U TO BUTTON-2 .
     5341          end.
     5342         disable
     5343           loc_have-rs-qnty-group
     5344           r-qnty-grp
     5345           loc_have-rs-sum-group
     5346           r-qnty-sgr
     5347           loc_have-rs-turn-group
     5348           r-have-tog
     5349           with frame page-1
     5350         .
     5351       if ub.price-list-type.rs-buyer = 2 then do:
     5352          disable r-gop-2 with frame page-2 .
     5353       end.
     5354       if ub.price-list-type.rs-buyer = 1 then do:
     5355          disable r-qnty-tog   loc_obj-turnover  r-gop-calc with frame page-2 .
     5356       end.
     5357       if ub.price-list-type.rs-buyer = 0 then do:
     5358          disable r-gop-2 r-qnty-tog   loc_obj-turnover  r-gop-calc with frame page-2.
     5359       end.
     5360       if ub.price-list-type.use-obj = 1 then do:
     5361          disable r-gop with frame page-2.
     5362       end.
     5363       if ub.price-list-type.obj-turnover = false   then do:
     5364          disable r-gop-calc with frame page-2 .
     5365       end.
     5366       run all-mode.
     5367     end.
     5368     if ( p-mode <> 'ДОБАВЛЕНИЕ':U and ub.price-list-type.main = true ) or ( p-mode = 'ДОБАВЛЕНИЕ':U and  p-main-price = true ) THEN DO:
     5369         HIDE v-1 IN FRAME page-1
     5370             v-1 loc_have-rs-qnty-group r-qnty-grp loc_have-rs-sum-group r-qnty-sgr loc_have-rs-turn-group r-have-tog loc_qgr-id loc_qgr-db-num loc_qg_name loc_sgr-id loc_sgr-db-num loc_sg_name loc_have-tog-db-num loc_have-tog_name loc_have-tog-id IN FRAME page-1
     5371             .
     5372         HIDE    v-2 IN FRAME page-2
     5373             loc_bgr_name
     5374             loc_bgr-db-num
     5375             loc_bgr-id
     5376             loc_tog-id
     5377             loc_gop_name-tnv
     5378             loc_gop-db-num-for-calc-turnover
     5379             loc_obj-turnover
     5380             loc_rs-buyer
     5381             loc_tog_name
     5382             loc_tog-db-num
     5383             loc_use-cassa
     5384             loc_use-cassa_FILL-IN
     5385             r-FILL-IN
     5386             r-obj-fill-in
     5387             r-gop-2
     5388             r-gop-calc
     5389             r-qnty-tog
     5390             v-spis-kass
     5391             .
     5392          HIDE   v-3 IN FRAME page-3
     5393          v-3 loc_use-gds-group loc_use-pay-type v-spis-group v-spis-type-pay loc_use-cash-pay v-spis-use-cash-pay F-ogran
     5394          IN FRAME page-3
     5395          .
     5396          HIDE
     5397             loc_fix-cource-crc-doc   in frame Dialog-Frame
     5398             loc_fix-cource-crc-base  in frame Dialog-Frame
     5399             r-cur
     5400             loc_priority
     5401             button-1
     5402             label-button-1
     5403             button-2
     5404             label-button-2
     5405             button-3
     5406             label-button-3
     5407             RECT-1
     5408             loc_under-type-list
     5409             in frame Dialog-Frame .
     5410             g-log = loc_work-date:disable(radio-label("3", loc_work-date:radio-buttons)).
     5411             g-log = loc_work-date:disable(radio-label("2", loc_work-date:radio-buttons)).
     5412     END.
     5413     run vis-bin .
     5414   END PROCEDURE.
     5415   PROCEDURE my_lookup :
     5416     disable  loc_have-rs-qnty-group loc_have-rs-sum-group loc_have-rs-turn-group loc_qgr-id loc_qgr-db-num loc_sgr-id loc_sgr-db-num loc_have-tog-db-num loc_have-tog-id  WITH FRAME page-1.
     5417     disable  loc_use-obj loc_rs-buyer loc_obj-turnover loc_use-cassa loc_gop-id loc_gop-db-num loc_bgr-id loc_bgr-db-num loc_tog-db-num loc_tog-id loc_gop-id-for-calc-turnover loc_gop-db-num-for-calc-turnover loc_use-obj r-gop v-2 loc_rs-buyer r-gop-2 r-qnty-tog loc_obj-turnover r-gop-calc loc_use-cassa v-spis-kass r-use-obj-fill-in loc_gop-id loc_gop-db-num loc_gop_name-name r-FILL-IN loc_bgr-id loc_bgr-db-num loc_bgr_name loc_tog-db-num loc_tog-id r-obj-fill-in loc_gop-id-for-calc-turnover loc_gop-db-num-for-calc-turnover loc_gop_name-tnv loc_use-cassa_FILL-IN loc_tog_name WITH FRAME page-2.
     5418     disable  loc_use-gds-group loc_use-pay-type loc_use-cash-pay  WITH FRAME page-3.
     5419     disable  loc_name loc_priority loc_create-price-doc loc_fix-cource-crc-base loc_send-cassa loc_fix-cource-crc-doc loc_calc-method loc_calc-increase-pc loc_calc-round-base loc_calc-round-method loc_ban-discnt loc_work-date loc_only-gbd loc_curr-code loc_under-hand-corr loc_under-type-list loc_plt-main-id loc_plt-main-db-num  WITH FRAME Dialog-Frame.
     5420     VIEW FRAME Dialog-Frame.
     5421     if p-main-price = true  then  VIEW FRAME page-2.
     5422     hide B-save in frame Dialog-Frame .
     5423     B-Cancel:label in frame Dialog-Frame  = "Выход" .
     5424     B-Cancel:column in frame Dialog-Frame  = 1 .
     5425   END PROCEDURE.
     5426   PROCEDURE noavtoper :
     5427   hide br-tt
     5428   in frame page-2
     5429   b-chga
     5430   in frame page-2
     5431   .
     5432   END PROCEDURE.
     5433   PROCEDURE runav :
     5434     IF  loc_only-gbd
     5435     THEN RUN avtoper .
     5436     ELSE RUN noavtoper .
     5437   END PROCEDURE.
     5438   PROCEDURE save-proc :
     5439   define buffer buf_cash-pay for ub.cash-pay  .
     5440   assign frame page-1 loc_have-rs-qnty-group loc_have-rs-sum-group loc_have-rs-turn-group loc_qgr-id loc_qgr-db-num loc_sgr-id loc_sgr-db-num loc_have-tog-db-num loc_have-tog-id no-error .
     5441   if error-status :error then do:
     5442      return error "page-1":U .
     5443   end.
     5444   if (loc_have-rs-sum-group   and loc_have-rs-turn-group )
     5445                               or
     5446      (loc_have-rs-qnty-group  and loc_have-rs-sum-group  )
     5447                               or
     5448      (loc_have-rs-qnty-group  and loc_have-rs-turn-group ) then do:
     5449      message "Неверно задана привязка " view-as alert-box error .
     5450      return error "Выбрать одну привязку!".
     5451      end.
     5452   ASSIGN FRAME PAGE-2 loc_use-obj loc_rs-buyer loc_obj-turnover loc_use-cassa loc_gop-id loc_gop-db-num loc_bgr-id loc_bgr-db-num loc_tog-db-num loc_tog-id loc_gop-id-for-calc-turnover loc_gop-db-num-for-calc-turnover no-error .
     5453   if error-status :error then do:
     5454      return error "page-2":U .
     5455   end.
     5456   ASSIGN FRAME PAGE-3 loc_use-gds-group loc_use-pay-type loc_use-cash-pay no-error .
     5457   if error-status :error then do:
     5458      return error "page-3":U .
     5459   end.
     5460   ASSIGN frame Dialog-Frame loc_name loc_priority loc_create-price-doc loc_fix-cource-crc-base loc_send-cassa loc_fix-cource-crc-doc loc_calc-method loc_calc-increase-pc loc_calc-round-base loc_calc-round-method loc_ban-discnt loc_work-date loc_only-gbd loc_curr-code loc_under-hand-corr loc_under-type-list loc_plt-main-id loc_plt-main-db-num.
     5461   define buffer ch_price-list-type for ub.price-list-type  .
     5462   define buffer pr_price-list-type for ub.price-list-type  .
     5463   find first pr_price-list-type no-lock where
     5464              pr_price-list-type.stts            = integer('0':U) and
     5465              pr_price-list-type.plt-main-id     = loc_plt-id     and
     5466              pr_price-list-type.plt-main-db-num = loc_plt-db-num no-error .
     5467     define variable v-is-mmr as character no-undo .
     5468     define variable par-type as character no-undo .
     5469     define variable v-cntxt-valid           as logical   no-undo .
     5470     define variable v-cntxt-menu-code       as integer   no-undo .
     5471     define variable v-cntxt-menu-group-code as integer   no-undo .
     5472     define variable v-cntxt-level           as character no-undo .
     5473     define variable v-cntxt-host-code-obj   as integer   no-undo .
     5474     define variable v-cntxt-obj-type        as character no-undo .
     5475     define variable v-cntxt-obj-code        as integer   no-undo .
     5476     define variable g#log                   as logical   no-undo .
     5477     if p-mode = 'ИЗМЕНЕНИЕ':U and loc_use-obj = 1 then do:
     5478   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5479   do:
     5480     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5481       (input  v-cntxt-db-num
     5482       ,input  v-cntxt-userid
     5483       ,input  0
     5484       ,input  'actn_documents_all':U
     5485       ,input  'global':U
     5486       ,input  0
     5487       ,input  '':U
     5488       ,input  0
     5489       ,input  0
     5490       ,input  0
     5491       ,input  0
     5492       ,input  false
     5493       ,output g#log
     5494       )  .
     5495   end.
     5496       if not g#log then do:
     5497           message "Функция назначения цен на все объекты для данного пользователя запрещена !  Выберите группу объектов ценообразования . "
     5498           view-as alert-box information .
     5499           return error .
     5500       end.
     5501     end.
     5502   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     5503     (input  'is-mmr':U
     5504     ,input  '':U
     5505     ,input  '':U
     5506     ,input  0
     5507     ,input  '':U
     5508     ,input  '':U
     5509     ,input  '':U
     5510     ,input  no
     5511     ,output v-is-mmr
     5512     ,output par-type
     5513     ) no-error .
     5514       if  error-status :error then v-is-mmr = 'no' .
     5515       if loc_use-obj = 1   and v-is-mmr = 'yes'   then do:
     5516         run gbl/cntxtget.p (
     5517              INPUT  v-cntxt-db-num
     5518            , INPUT  v-cntxt-userid
     5519            , OUTPUT v-cntxt-valid
     5520            , OUTPUT v-cntxt-menu-code
     5521            , OUTPUT v-cntxt-menu-group-code
     5522            , OUTPUT v-cntxt-level
     5523            , OUTPUT v-cntxt-host-code-obj
     5524            , OUTPUT v-cntxt-obj-type
     5525            , OUTPUT v-cntxt-obj-code
     5526         ).
     5527         if v-cntxt-menu-group-code = 5  then do :
     5528           message "Функция назначения цен на все объекты в Минимаркете запрещена !  Выберите группу объектов ценообразования . "
     5529           view-as alert-box information .
     5530           return error .
     5531         end.
     5532       end.
     5533   if p-main-price = true and loc_only-gbd = true
     5534   then do:
     5535       if loc_use-obj = 1    then do:
     5536           message "Главный прайс-лист не может быть по всем объектам ценообразования !" view-as alert-box information .
     5537           return error .
     5538       end.
     5539   define variable vv-obj-db-num as integer   no-undo .
     5540   define variable s-vv as character no-undo .
     5541   define variable i as integer   no-undo .
     5542   run metod-gop-obj in this-procedure ( v-cntxt-db-num , loc_gop-id , loc_gop-db-num) .
     5543   define variable locs-plt-id     as integer   no-undo .
     5544   define variable locs-plt-db-num as integer   no-undo .
     5545   define variable v-err           as logical   no-undo .
     5546   define variable v-n             as character no-undo .
     5547   define buffer old1_price-list-type for ub.price-list-type  .
     5548   define variable v-col-tp as integer   no-undo .
     5549   define variable v-ii-o   as integer   no-undo .
     5550   v-err = false .
     5551   v-ii-o = 0    .
     5552   for each x_obj-group where
     5553   :
     5554   v-ii-o = v-ii-o + 1   .
     5555   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5556   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplobjq in g#library2
     5557     (input  x_obj-group.obj-type
     5558     ,input  x_obj-group.obj-code
     5559     ,output locs-plt-id
     5560     ,output locs-plt-db-num
     5561     ,output v-col-tp
     5562     ) no-error .
     5563     if error-status :error then do:
     5564        v-err = true .
     5565        leave .
     5566     end.
     5567     if v-col-tp > 0 and not (
     5568         locs-plt-id     = loc_plt-id      and
     5569         locs-plt-db-num = loc_plt-db-num
     5570         ) then do:
     5571        find first old1_price-list-type no-lock where
     5572                   old1_price-list-type.plt-id     = locs-plt-id and
     5573                   old1_price-list-type.plt-db-num = locs-plt-db-num
     5574        no-error .
     5575        if error-status :error then do:
     5576          v-n = ''.
     5577        end.
     5578        else do:
     5579          v-n = old1_price-list-type.name .
     5580        end.
     5581        message substitute ( "Для объекта &1 &2 уже есть ГТПЛ для автопереоценок &3(&4) &5" , x_obj-group.obj-code , x_obj-group.obj-type , locs-plt-id , locs-plt-db-num , v-n ) view-as alert-box error  .
     5582        v-err = true .
     5583        leave .
     5584     end.
     5585   end.
     5586   if v-ii-o = 0  then do:
     5587      message "В выбранной группе нет ни одного объекта !"  view-as alert-box information .
     5588      return error .
     5589   end.
     5590     if error-status :error or v-err = true  then return error .
     5591     run avts.
     5592   end.
     5593   if p-main-price = true  then do:
     5594      if loc_send-cassa = 2 or loc_create-price-doc = 2 then do:
     5595         message substitute ( "По главному типу прайс-листов должны создаваться переоценки и цены уходить на кассу" ) view-as alert-box error  .
     5596         return error.
     5597      end.
     5598   end.
     5599   else do:
     5600      if loc_send-cassa = 1  and loc_ban-discnt = 0   then do:
     5601         message substitute ( "На кассу по неглавному ТПЛ можно отправлять только СКИДКИ!  (установите номер шаблона скидки или поле <<ОТПРАВЛЯТЬ НА КАССЫ>> установите нет)  " ) view-as alert-box error  .
     5602         return error.
     5603      end.
     5604      if loc_send-cassa = 2  and loc_ban-discnt > 0   then do:
     5605         message substitute ( "Если установлено правило скидки, то его надо отправлять на кассы ! " ) view-as alert-box error  .
     5606         return error.
     5607      end.
     5608   end.
     5609   if p-main-price = true and loc_under-type-list = true then do:
     5610      if loc_use-obj = 1    then do:
     5611         message "Подчиненный прайс-лист по ГПЛ не может быть по всем объектам ценообразования !" view-as alert-box information .
     5612         return error .
     5613      end.
     5614      else do:
     5615         if can-find ( first ch_price-list-type no-lock where
     5616                       ch_price-list-type.stts            = integer('0':U) and
     5617                       ch_price-list-type.plt-main-id     = loc_plt-main-id and
     5618                       ch_price-list-type.plt-main-db-num = loc_plt-main-db-num and
     5619                       ch_price-list-type.gop-id          = loc_gop-id and
     5620                       ch_price-list-type.gop-db-num      = loc_gop-db-num and
     5621                   not (ch_price-list-type.plt-id         = loc_plt-id and
     5622                        ch_price-list-type.plt-db-num     = loc_plt-db-num )
     5623                       )
     5624                       then do:
     5625                         message substitute ( "Уже есть прайс-лист с группой объектов № &1 БД &2" , loc_gop-id , loc_gop-db-num ) view-as alert-box information .
     5626                         return error.
     5627                       end.
     5628      end.
     5629   end.
     5630   if p-main-price = true and loc_under-type-list = false
     5631      and can-find ( first ch_price-list-type no-lock where
     5632                     ch_price-list-type.stts            = integer('0':U) and
     5633                     ch_price-list-type.plt-main-id     = loc_plt-id and
     5634                     ch_price-list-type.plt-main-db-num = loc_plt-db-num and
     5635                   not ( ch_price-list-type.plt-id      = loc_plt-id and
     5636                         ch_price-list-type.plt-db-num  = loc_plt-db-num )
     5637                     )
     5638      then do:
     5639         if loc_use-obj = 1    then do:
     5640             message "Родительский прайс-лист по ГПЛ не может быть по всем объектам ценообразования !" view-as alert-box information .
     5641             return error .
     5642         end.
     5643         else do:
     5644               if can-find ( first ch_price-list-type no-lock where
     5645                       ch_price-list-type.stts            = integer('0':U) and
     5646                       ch_price-list-type.plt-main-id     = loc_plt-id and
     5647                       ch_price-list-type.plt-main-db-num = loc_plt-db-num and
     5648                       ch_price-list-type.gop-id          = loc_gop-id and
     5649                       ch_price-list-type.gop-db-num      = loc_gop-db-num and
     5650                   not (ch_price-list-type.plt-id     = loc_plt-id and
     5651                        ch_price-list-type.plt-db-num = loc_plt-db-num )
     5652                       ) then do:
     5653                       message "Нельзя менять ГТПЛ, у которого есть подчиненные ТПЛ" view-as alert-box information .
     5654                       return error.
     5655                       end.
     5656         end.
     5657   end.
     5658   if p-main-price = false and loc_under-type-list = true then do:
     5659     if loc_use-obj = 1 and loc_rs-buyer = 0 then do:
     5660        message "В сочетании параметров <все объекты> и <все группы покупателей> нельзя создавать подчиненый прайс-лист, так как нет вариантов отличия "  view-as alert-box information .
     5661        return error.
     5662     end.
     5663   end.
     5664   if p-main-price = false and loc_under-type-list = false
     5665      and can-find ( first ch_price-list-type no-lock where
     5666                     ch_price-list-type.stts            = integer('0':U) and
     5667                     ch_price-list-type.plt-main-id     = loc_plt-id and
     5668                     ch_price-list-type.plt-main-db-num = loc_plt-db-num and
     5669               not (ch_price-list-type.plt-id     = loc_plt-id and
     5670                     ch_price-list-type.plt-db-num = loc_plt-db-num )
     5671                     )
     5672   then do:
     5673     if loc_use-obj = 1 and loc_rs-buyer = 0 then do:
     5674        message "В сочетании параметров <все объекты> и <все группы покупателей> нельзя создавать подчиненый прайс-лист, так как нет вариантов отличия "   view-as alert-box information .
     5675        return error.
     5676     end.
     5677   end.
     5678   if p-main-price = false  and loc_under-type-list = true then do:
     5679     find first ch_price-list-type no-lock where
     5680                   ch_price-list-type.stts            = integer('0':U) and
     5681                   ch_price-list-type.plt-main-id     = loc_plt-main-id and
     5682                   ch_price-list-type.plt-main-db-num = loc_plt-main-db-num and
     5683                   ch_price-list-type.gop-id          = loc_gop-id and
     5684                   ch_price-list-type.gop-db-num      = loc_gop-db-num  and
     5685                   ch_price-list-type.bgr-id          = loc_bgr-id and
     5686                   ch_price-list-type.bgr-db-num      = loc_bgr-db-num  and
     5687                   ch_price-list-type.tog-id          = loc_tog-id and
     5688                   ch_price-list-type.tog-db-num      = loc_tog-db-num  and
     5689                   not (ch_price-list-type.plt-id     = loc_plt-id and
     5690                        ch_price-list-type.plt-db-num = loc_plt-db-num )
     5691                    no-error .
     5692                   if available ch_price-list-type then do:
     5693                       message "Уже есть прайс-лист № " ch_price-list-type.plt-id "/" ch_price-list-type.plt-db-num skip
     5694                       "с таким же набором параметров :"  skip
     5695                       'Родительский прайс-лист:' loc_plt-main-id "/" loc_plt-main-db-num skip
     5696                       'группа объектов    :' loc_gop-id "/"  loc_gop-db-num skip
     5697                       'группа покупателей :' loc_bgr-id "/"  loc_bgr-db-num skip
     5698                       'группа оборотов    :' loc_tog-id "/"  loc_tog-db-num
     5699                       view-as alert-box information .
     5700                       return error.
     5701                   end.
     5702   end.
     5703   if p-main-price = false and loc_under-type-list = false
     5704      and can-find ( first ch_price-list-type no-lock where
     5705                     ch_price-list-type.stts            = integer('0':U) and
     5706                     ch_price-list-type.plt-main-id     = loc_plt-id and
     5707                     ch_price-list-type.plt-main-db-num = loc_plt-db-num )
     5708   then do:
     5709     if can-find ( first ch_price-list-type no-lock where
     5710                   ch_price-list-type.stts            = integer('0':U) and
     5711                   ch_price-list-type.plt-main-id     = loc_plt-id and
     5712                   ch_price-list-type.plt-main-db-num = loc_plt-db-num and
     5713                   ch_price-list-type.gop-id          = loc_gop-id and
     5714                   ch_price-list-type.gop-db-num      = loc_gop-db-num  and
     5715                   ch_price-list-type.bgr-id          = loc_bgr-id and
     5716                   ch_price-list-type.bgr-db-num      = loc_bgr-db-num  and
     5717                   ch_price-list-type.tog-id          = loc_tog-id and
     5718                   ch_price-list-type.tog-db-num      = loc_tog-db-num and
     5719                   not (ch_price-list-type.plt-id     = loc_plt-id and
     5720                        ch_price-list-type.plt-db-num = loc_plt-db-num )
     5721                   ) then do:
     5722                       message "Уже есть прайс-лист с таким же набором параметров" view-as alert-box information .
     5723                       return error.
     5724                   end.
     5725   end.
     5726   run avtosave in this-procedure
     5727     (  loc_plt-id
     5728     ,  loc_plt-db-num
     5729     ,  loc_ie-gen-marg
     5730     ,  loc_ie-gen-marg-parts
     5731     ,  loc_ie-objfirst
     5732     ,  loc_ie-objsecond
     5733     ,  loc_ie-pr-nakl
     5734     ,  loc_iv-gen-marg
     5735     ,  loc_iv-gen-marg-parts
     5736     ,  loc_iv-objfirst
     5737     ,  loc_iv-objsecond
     5738     ,  loc_iv-pr-nakl
     5739     ,  loc_im-gen-marg
     5740     ,  loc_im-gen-marg-parts
     5741     ,  loc_im-objfirst
     5742     ,  loc_im-objsecond
     5743     ,  loc_im-pr-nakl   ) .
     5744   define buffer buf2_price-list-type   for ub.price-list-type  .
     5745   define buffer buf2_price-doc-forming for ub.price-doc-forming  .
     5746   if p-mode <> 'ПРОСМОТР':U then do:
     5747   if loc_under-type-list = true and available pr_price-list-type then do:
     5748       assign
     5749           loc_calc-method         = pr_price-list-type.calc-method
     5750           loc_create-price-doc    = pr_price-list-type.create-price-doc
     5751           loc_fix-cource-crc-base = pr_price-list-type.fix-cource-crc-base
     5752           loc_fix-cource-crc-doc  = pr_price-list-type.fix-cource-crc-doc
     5753           loc_have-rs-qnty-group  = logical(pr_price-list-type.have-rs-qnty-group)
     5754           loc_have-rs-sum-group   = pr_price-list-type.have-rs-sum-group
     5755           loc_only-gbd            = logical(pr_price-list-type.only-gbd)
     5756           loc_priority            = pr_price-list-type.priority
     5757           loc_send-cassa          = pr_price-list-type.send-cassa
     5758           loc_use-cassa           = pr_price-list-type.use-cassa
     5759           loc_work-date           = pr_price-list-type.work-date
     5760           loc_curr-code           = pr_price-list-type.curr-code
     5761           loc_qgr-db-num          = pr_price-list-type.qgr-db-num
     5762           loc_qgr-id              = pr_price-list-type.qgr-id
     5763           loc_sgr-db-num          = pr_price-list-type.sgr-db-num
     5764           loc_sgr-id              = pr_price-list-type.sgr-id
     5765           loc_have-rs-turn-group  = logical(pr_price-list-type.have-rs-turn-group)
     5766           loc_have-tog-db-num     = pr_price-list-type.have-tog-db-num
     5767           loc_have-tog-id         = pr_price-list-type.have-tog-id
     5768           loc_use-cash-pay        = logical(pr_price-list-type.use-cash-pay)
     5769           loc_use-pay-type        = logical(pr_price-list-type.use-pay-type)
     5770           .
     5771   end.
     5772           if  p-mode = 'ИЗМЕНЕНИЕ':U and loc_priority > 0 and p-main-price = false  then do:
     5773               if can-find ( first buf2_price-list-type no-lock where
     5774                     buf2_price-list-type.main = false  and
     5775                     buf2_price-list-type.stts = integer('0':U)      and
     5776                     buf2_price-list-type.plt-db-num = loc_plt-db-num and
     5777                     buf2_price-list-type.plt-id     = loc_plt-id  and
     5778                     not (
     5779                         buf2_price-list-type.bgr-id     = loc_bgr-id and
     5780                         buf2_price-list-type.bgr-db-num = loc_bgr-db-num ))
     5781                     then do:
     5782                         find first buf2_price-doc-forming no-lock where
     5783                               buf2_price-doc-forming.plt-db-num = loc_plt-db-num and
     5784                               buf2_price-doc-forming.plt-id     = loc_plt-id     and
     5785                               buf2_price-doc-forming.stts       = integer('3':U)
     5786                               no-error .
     5787                               if available buf2_price-doc-forming then do:
     5788                                 message "Изменилась группа покупателей в  ТИПе ПРАЙС-ЛИСТА !" skip
     5789                                 "ДА - изменить группу покупателей у действующих цен "      skip
     5790                                 "НЕТ - изменить группу покупателей только у новых цен "           skip
     5791                                 view-as alert-box question
     5792                                 buttons yes-no
     5793                                 update v-ok_bgr as logical.
     5794                               end.
     5795                     end.
     5796           end.
     5797           if  p-mode = 'ИЗМЕНЕНИЕ':U and loc_priority > 0 and p-main-price = false  then do:
     5798               if can-find ( first buf2_price-list-type no-lock where
     5799                     buf2_price-list-type.priority <> loc_priority and
     5800                     buf2_price-list-type.main = false  and
     5801                     buf2_price-list-type.stts = integer('0':U)      and
     5802                     buf2_price-list-type.plt-db-num = loc_plt-db-num and
     5803                     buf2_price-list-type.plt-id     = loc_plt-id )
     5804                     then do:
     5805                         find first buf2_price-doc-forming no-lock where
     5806                               buf2_price-doc-forming.plt-db-num = loc_plt-db-num and
     5807                               buf2_price-doc-forming.plt-id     = loc_plt-id     and
     5808                               buf2_price-doc-forming.stts       = integer('3':U)
     5809                               no-error .
     5810                               if available buf2_price-doc-forming then do:
     5811                                 message "Изменился приоритет  ТИПА ПРАЙС-ЛИСТА !" skip
     5812                                 "ДА - изменить приоритет у действующих цен "      skip
     5813                                 "НЕТ - изменить приоритет у новых цен "           skip
     5814                                 view-as alert-box question
     5815                                 buttons yes-no
     5816                                 update v-ok as logical.
     5817                               end.
     5818                     end.
     5819           end.
     5820   if loc_use-cash-pay then do:
     5821    for each TT_price-list-type-cash-pay :
     5822         if TT_price-list-type-cash-pay.curr-code <> loc_curr-code then do:
     5823            find first buf_cash-pay no-lock where
     5824                       buf_cash-pay.curr-code  = TT_price-list-type-cash-pay.curr-code and
     5825                       buf_cash-pay.cdpay-code = TT_price-list-type-cash-pay.cdpay-code no-error .
     5826            if error-status :error then do:
     5827               message error-status :get-message(1) .
     5828               return error return-value .
     5829            end.
     5830            message 'Платеж' buf_cash-pay.obj-name
     5831            "Не соответствует валюте прайс-листа"
     5832            view-as alert-box error .
     5833            return error return-value .
     5834         end.
     5835    end.
     5836   end.
     5837   if loc_use-obj = 1 then do:
     5838      message "Прайс-лист задан по ВСЕМ объектам ценообразования !" skip
     5839        "Вы уверены ?"
     5840        view-as alert-box question
     5841        buttons yes-no
     5842        title "Внимание !!!"
     5843        update vv as log
     5844       .
     5845       if vv = false then return error return-value .
     5846   end.
     5847   else do:
     5848    find first ub.grp-obj-price where
     5849               ub.grp-obj-price.gop-db-num = loc_gop-db-num and
     5850               ub.grp-obj-price.gop-id     = loc_gop-id
     5851               no-lock no-error .
     5852     if not available  ub.grp-obj-price  then do:
     5853        message "Группа объектов не найдена "  view-as alert-box information .
     5854        return error.
     5855     end.
     5856     if ub.grp-obj-price.stts = 1  then do:
     5857           message "Группа объектов удалена" view-as alert-box error .
     5858           return error  .
     5859     end.
     5860   end.
     5861   if loc_have-rs-qnty-group then do:
     5862    find first ub.qnty-group where
     5863               ub.qnty-group.qgr-db-num = loc_qgr-db-num  and
     5864               ub.qnty-group.qgr-id     = loc_qgr-id
     5865               no-lock no-error .
     5866       if error-status :error then do:
     5867           message "Не найдена количественная группа" view-as alert-box error .
     5868           return error  .
     5869       end.
     5870       if ub.qnty-group.stts = 1 then do:
     5871           message "Количественная группа удалена" view-as alert-box error .
     5872           return error  .
     5873       end.
     5874   end.
     5875   else do:
     5876      assign
     5877       loc_qgr-id      = 0
     5878       loc_qgr-db-num  = 0
     5879      .
     5880   end.
     5881   if loc_have-rs-sum-group then do:
     5882    find first ub.sum-group where
     5883               ub.sum-group.sgr-db-num = loc_sgr-db-num  and
     5884               ub.sum-group.sgr-id     = loc_sgr-id
     5885               no-lock no-error .
     5886       if error-status :error then do:
     5887           message "Не найдена суммовая группа" view-as alert-box error .
     5888           return error  .
     5889       end.
     5890       if ub.sum-group.stts = 1 then do:
     5891           message "Суммовая группа удалена" view-as alert-box error .
     5892           return error  .
     5893       end.
     5894   end.
     5895   else do:
     5896      assign
     5897       loc_sgr-id      = 0
     5898       loc_sgr-db-num  = 0
     5899      .
     5900   end.
     5901   if loc_have-rs-turn-group then do:
     5902    find first ub.turnover-group where
     5903               ub.turnover-group.tog-db-num = loc_have-tog-db-num   and
     5904               ub.turnover-group.tog-id     = loc_have-tog-id
     5905               no-lock no-error .
     5906       if error-status :error then do:
     5907           message "Не найдена суммовая группа" view-as alert-box error .
     5908           return error  .
     5909       end.
     5910       if ub.turnover-group.stts = 1 then do:
     5911           message "Суммовая группа удалена" view-as alert-box error .
     5912           return error  .
     5913       end.
     5914   end.
     5915   else do:
     5916      assign
     5917       loc_have-tog-id      = 0
     5918       loc_have-tog-db-num  = 0
     5919      .
     5920   end.
     5921    run type-price-list-add (
     5922               ( if p-mode = 'ДОБАВЛЕНИЕ':U then  v-cntxt-db-num                        else loc_plt-db-num )
     5923             , ( if p-mode = 'ДОБАВЛЕНИЕ':U then  next-value (s-plt, ub) else loc_plt-id   )
     5924             , loc_name
     5925             , loc_ban-discnt
     5926             , loc_calc-round-method
     5927             , loc_calc-round-base
     5928             , loc_calc-increase-pc
     5929             , loc_calc-method
     5930             , loc_create-price-doc
     5931             , loc_fix-cource-crc-base
     5932             , loc_fix-cource-crc-doc
     5933             , integer (loc_have-rs-qnty-group)
     5934             , loc_have-rs-sum-group
     5935             , p-main-price
     5936             , integer (loc_only-gbd)
     5937             , loc_plt-main-db-num
     5938             , loc_plt-main-id
     5939             , loc_priority
     5940             , loc_rs-buyer
     5941             , loc_send-cassa
     5942             , integer (loc_under-hand-corr)
     5943             , loc_under-round-method
     5944             , loc_under-perc
     5945             , integer (loc_under-type-list)
     5946             , loc_use-cassa
     5947             , integer (loc_use-gds-group)
     5948             , loc_use-obj
     5949             , loc_work-date
     5950             , loc_bgr-db-num
     5951             , loc_bgr-id
     5952             , loc_curr-code
     5953             , loc_gop-db-num
     5954             , loc_gop-db-num-for-calc-turnover
     5955             , loc_gop-id
     5956             , loc_gop-id-for-calc-turnover
     5957             , loc_qgr-db-num
     5958             , loc_qgr-id
     5959             , loc_sgr-db-num
     5960             , loc_sgr-id
     5961             , loc_tog-db-num
     5962             , loc_tog-id
     5963             , loc_obj-turnover
     5964             , 0
     5965             , v-cntxt-userid
     5966             , v-cntxt-db-num
     5967             , integer (loc_have-rs-turn-group)
     5968             , loc_have-tog-db-num
     5969             , loc_have-tog-id
     5970             , integer (loc_use-cash-pay )
     5971             , integer (loc_use-pay-type )
     5972             , output  p-recid
     5973             , input table TT_price-list-type-cassa
     5974             , input table TT_price-list-type-gds-grp
     5975             , input table TT_price-list-type-pay-type
     5976             , input table TT_price-list-type-cash-pay
     5977             ) no-error .
     5978             if error-status :error then do:
     5979                 message
     5980                   error-status :get-message(1) skip
     5981                   return-value skip
     5982                   "Ошибка ввода"
     5983                   view-as alert-box error
     5984                 .
     5985                 return error.
     5986             end.
     5987           if v-ok or v-ok_bgr then do:
     5988           if not transaction then do:
     5989               run waitfram-show in this-procedure ("Изменение действующих цен...") .
     5990               for each ub.price-all exclusive-lock where
     5991                   ub.price-all.plt-db-num = loc_plt-db-num and
     5992                   ub.price-all.plt-id     = loc_plt-id
     5993                   :
     5994                   if ub.price-all.plt-priority <> loc_priority   and v-ok     then ub.price-all.plt-priority = loc_priority   .
     5995                   if ub.price-all.bgr-id       <> loc_bgr-id     and v-ok_bgr then ub.price-all.bgr-id       = loc_bgr-id     .
     5996                   if ub.price-all.bgr-db-num   <> loc_bgr-db-num and v-ok_bgr then ub.price-all.bgr-db-num   = loc_bgr-db-num .
     5997               end.
     5998               run waitfram-hide in this-procedure  .
     5999               end.
     6000               else do:
     6001                  message "Нельзя выполнить массовое обновление в одной транзакции. Воспользуйтесь утилитой смены значений ТПЛ !" view-as alert-box information .
     6002               end.
     6003           end.
     6004    end.
     6005   END PROCEDURE.
     6006   PROCEDURE tog-band :
     6007     if l-ban-discnt = true then do:
     6008        display
     6009        loc_ban-discnt
     6010        r-ban-discnt
     6011        f-ban-discnt
     6012        b-ban-discnt
     6013        l-ban-discnt
     6014        with frame Dialog-Frame .
     6015     end.
     6016     else do:
     6017       loc_ban-discnt = 0 .
     6018        display
     6019        loc_ban-discnt
     6020        r-ban-discnt
     6021        f-ban-discnt
     6022        b-ban-discnt
     6023        l-ban-discnt
     6024        with frame Dialog-Frame .
     6025     hide
     6026        loc_ban-discnt
     6027        r-ban-discnt
     6028        f-ban-discnt
     6029        b-ban-discnt
     6030        in frame Dialog-Frame .
     6031     end.
     6032   END PROCEDURE.
     6033   PROCEDURE vis-bin :
     6034   if loc_have-tog-id               = 0  then hide b-have-tog in frame page-1 loc_have-tog-db-num                . else do: enable   b-have-tog with frame page-1 . display loc_have-tog-db-num              with frame page-1 . end.
     6035   if loc_qgr-id                    = 0  then hide b-qnty-grp in frame page-1 loc_qgr-db-num                     . else do: enable   b-qnty-grp with frame page-1 . display loc_qgr-db-num                   with frame page-1 . end.
     6036   if loc_sgr-id                    = 0  then hide b-qnty-sgr in frame page-1 loc_sgr-db-num                     . else do: enable   b-qnty-sgr with frame page-1 . display loc_sgr-db-num                   with frame page-1 . end.
     6037   if loc_gop-id                    = 0  then hide b-gop      in frame page-2 loc_gop-db-num                     . else do: enable   b-gop      with frame page-2 . display loc_gop-db-num                   with frame page-2 . end.
     6038   if loc_bgr-id                    = 0  then hide b-gop-2    in frame page-2 loc_bgr-db-num                     . else do: enable   b-gop-2    with frame page-2 . display loc_bgr-db-num                   with frame page-2 . end.
     6039   if loc_gop-id-for-calc-turnover  = 0  then hide b-gop-calc in frame page-2 loc_gop-db-num-for-calc-turnover   . else do: enable   b-gop-calc with frame page-2 . display loc_gop-db-num-for-calc-turnover with frame page-2 . end.
     6040   if loc_tog-id                    = 0  then hide b-qnty-tog in frame page-2 loc_tog-db-num                     . else do: enable   b-qnty-tog with frame page-2 . display loc_tog-db-num                   with frame page-2 . end.
     6041   END PROCEDURE.
