     3011   define variable v-diasize-browse-number        as integer   no-undo .
     3012   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3013   define temp-table temp-diasize-handle no-undo
     3014     field handle-value  as handle
     3015     field save-position as decimal
     3016     index xpk is primary unique handle-value
     3017     .
     3018   define temp-table temp-browse-handle no-undo
     3019     field browse-type   as character
     3020     field browse-number as integer
