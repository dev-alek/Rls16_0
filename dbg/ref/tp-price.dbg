     1818        v-spis-kass AT ROW 7.5 COL 1.38 NO-LABEL
     1819        B-chga AT ROW 8 COL 87.5 WIDGET-ID 10
     1820        r-use-obj-fill-in AT ROW 1.08 COL 1 NO-LABEL
     1821        loc_gop-id AT ROW 1.08 COL 43.38 COLON-ALIGNED HELP
     1822             "" NO-LABEL FORMAT ">>>>>>>"
     1823        loc_gop-db-num AT ROW 1.08 COL 54.88 COLON-ALIGNED NO-LABEL
     1824        loc_gop_name-name AT ROW 1.08 COL 57.75 COLON-ALIGNED NO-LABEL
     1825        f-ie-3 AT ROW 2.42 COL 1.88 NO-LABEL
     1826        r-FILL-IN AT ROW 2.58 COL 1.13 NO-LABEL
     1827        loc_bgr-id AT ROW 3.42 COL 19.25 COLON-ALIGNED
     1828        loc_bgr-db-num AT ROW 3.5 COL 31.38 COLON-ALIGNED NO-LABEL
     1829        loc_bgr_name AT ROW 3.5 COL 34.5 COLON-ALIGNED NO-LABEL
     1830        loc_tog-db-num AT ROW 4.25 COL 31.38 COLON-ALIGNED NO-LABEL
     1831        loc_tog-id AT ROW 4.29 COL 19.25 COLON-ALIGNED HELP
     1832             ""
     1833             LABEL "Группа оборотов  ." FORMAT ">>>>>>>"
     1834        r-obj-fill-in AT ROW 5.29 COL 1 NO-LABEL
     1835        loc_gop-id-for-calc-turnover AT ROW 5.29 COL 43.5 COLON-ALIGNED HELP
     1836             "" NO-LABEL FORMAT ">>>>>>"
     1837        loc_gop-db-num-for-calc-turnover AT ROW 5.29 COL 55 COLON-ALIGNED NO-LABEL
     1838        loc_gop_name-tnv AT ROW 5.29 COL 57.88 COLON-ALIGNED NO-LABEL
     1839        loc_use-cassa_FILL-IN AT ROW 6.75 COL 1 NO-LABEL
     1840        loc_tog_name AT ROW 4.25 COL 34.5 COLON-ALIGNED NO-LABEL
     1841       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1842            SIDE-LABELS NO-UNDERLINE THREE-D
     1843            AT COL 3 ROW 12.21
     1844            SIZE 96.5 BY 10.79.
     1845   DEFINE FRAME page-1
     1846        v-1 AT ROW 1 COL 81.5 COLON-ALIGNED
     1847        loc_have-rs-qnty-group AT ROW 3.5 COL 1.5
     1848        r-qnty-grp AT ROW 3.5 COL 46.75
     1849        b-qnty-grp AT ROW 3.5 COL 49.75 WIDGET-ID 4
     1850        loc_have-rs-sum-group AT ROW 4.88 COL 1.25
     1851        r-qnty-sgr AT ROW 4.88 COL 46.5
     1852        b-qnty-sgr AT ROW 4.88 COL 49.5 WIDGET-ID 6
     1853        loc_have-rs-turn-group AT ROW 6.25 COL 1.5
     1854        r-have-tog AT ROW 6.25 COL 46.5
     1855        b-have-tog AT ROW 6.25 COL 49.5 WIDGET-ID 2
     1856        loc_qgr-id AT ROW 3.5 COL 38.25 COLON-ALIGNED NO-LABEL
     1857        loc_qgr-db-num AT ROW 3.5 COL 51.13 COLON-ALIGNED NO-LABEL
     1858        loc_qg_name AT ROW 3.5 COL 54.25 COLON-ALIGNED NO-LABEL
     1859        loc_sgr-id AT ROW 4.88 COL 38 COLON-ALIGNED HELP
     1860             "" NO-LABEL FORMAT ">>>>>>>"
     1861        loc_sgr-db-num AT ROW 4.88 COL 50.88 COLON-ALIGNED NO-LABEL
     1862        loc_sg_name AT ROW 4.88 COL 54.13 COLON-ALIGNED NO-LABEL
     1863        loc_have-tog-db-num AT ROW 6.25 COL 50.88 COLON-ALIGNED NO-LABEL
     1864        loc_have-tog_name AT ROW 6.25 COL 54.13 COLON-ALIGNED NO-LABEL
     1865        loc_have-tog-id AT ROW 6.29 COL 38 COLON-ALIGNED NO-LABEL
     1866       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1867            SIDE-LABELS NO-UNDERLINE THREE-D
     1868            AT COL 3 ROW 12.17
     1869            SIZE 96.5 BY 6.58.
     1870   DEFINE FRAME page-3
     1871        v-3 AT ROW 1.25 COL 92.5 COLON-ALIGNED
     1872        loc_use-gds-group AT ROW 2 COL 1.5
     1873        loc_use-pay-type AT ROW 2.25 COL 63.63
     1874        v-spis-group AT ROW 2.92 COL 1.5 NO-LABEL
     1875        v-spis-type-pay AT ROW 2.96 COL 63.5 NO-LABEL
     1876        loc_use-cash-pay AT ROW 8.04 COL 63
     1877        v-spis-use-cash-pay AT ROW 8.75 COL 63 NO-LABEL
     1878        F-ogran AT ROW 1.25 COL 1 NO-LABEL
     1879       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1880            SIDE-LABELS NO-UNDERLINE THREE-D
     1881            AT COL 3 ROW 12.21
     1882            SIZE 96.5 BY 10.79.
     1883   ASSIGN FRAME page-1:FRAME = FRAME Dialog-Frame:HANDLE
     1884          FRAME page-2:FRAME = FRAME Dialog-Frame:HANDLE
     1885          FRAME page-3:FRAME = FRAME Dialog-Frame:HANDLE.
     1886   ASSIGN
     1887          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1888          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1889   ASSIGN
     1890          BUTTON-1:AUTO-RESIZE IN FRAME Dialog-Frame      = TRUE.
     1891   ASSIGN
     1892          BUTTON-2:AUTO-RESIZE IN FRAME Dialog-Frame      = TRUE.
     1893   ASSIGN
     1894          BUTTON-3:AUTO-RESIZE IN FRAME Dialog-Frame      = TRUE.
     1895   ASSIGN
     1896          label-button-1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1897   ASSIGN
     1898          label-button-2:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1899   ASSIGN
     1900          label-button-3:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1901   ASSIGN
     1902          loc_ban-discnt:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1903   ASSIGN
     1904          v-max:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1905   ASSIGN
     1906          v-2:HIDDEN IN FRAME page-2           = TRUE.
     1907   ASSIGN
     1908          v-spis-kass:READ-ONLY IN FRAME page-2        = TRUE.
     1909   ASSIGN
     1910          v-spis-group:READ-ONLY IN FRAME page-3        = TRUE.
     1911   ASSIGN
     1912          v-spis-type-pay:READ-ONLY IN FRAME page-3        = TRUE.
     1913   ASSIGN
     1914          v-spis-use-cash-pay:READ-ONLY IN FRAME page-3        = TRUE.
     1915   ON GO OF FRAME Dialog-Frame
     1916   DO:
     1917       RUN save-proc no-error .
     1918       if error-status :error then do:
     1919          case return-value :
     1920             when "page-1" then do: APPLY "CHOOSE":U TO BUTTON-1 . return no-apply. end.
     1921             when "page-2" then do: APPLY "CHOOSE":U TO BUTTON-2 . return no-apply. end.
     1922             when "page-3" then do: APPLY "CHOOSE":U TO BUTTON-3 . return no-apply. end.
     1923             otherwise do: return no-apply . end.
     1924          end case.
     1925       end.
     1926   END.
     1927   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1928   DO:
     1929     APPLY "END-ERROR":U TO SELF.
     1930   END.
     1931   ON GO OF FRAME page-1
     1932   DO:
     1933     MESSAGE "go page-1" VIEW-AS ALERT-BOX.
     1934     ASSIGN FRAME PAGE-1 loc_have-rs-qnty-group loc_have-rs-sum-group loc_have-rs-turn-group loc_qgr-id loc_qgr-db-num loc_sgr-id loc_sgr-db-num loc_have-tog-db-num loc_have-tog-id .
     1935   END.
     1936   ON GO OF FRAME page-2
     1937   DO:
     1938     MESSAGE "go page-2" VIEW-AS ALERT-BOX.
     1939     ASSIGN FRAME PAGE-2 loc_use-obj loc_rs-buyer loc_obj-turnover loc_use-cassa loc_gop-id loc_gop-db-num loc_bgr-id loc_bgr-db-num loc_tog-db-num loc_tog-id loc_gop-id-for-calc-turnover loc_gop-db-num-for-calc-turnover .
     1940   END.
     1941   ON GO OF FRAME page-3
     1942   DO:
     1943     MESSAGE "go page-3" VIEW-AS ALERT-BOX.
     1944     ASSIGN FRAME PAGE-3 loc_use-gds-group loc_use-pay-type loc_use-cash-pay .
     1945   END.
     1946   ON CHOOSE OF b-ban-discnt IN FRAME Dialog-Frame
     1947   DO:
     1948   define variable v-sts as integer no-undo init -1.
     1949   define variable v-rid-list as character no-undo .
     1950   run ref/dis-ruls.w (
     1951                        input  parParentProc
     1952                       ,input  v-cntxt-host-code-obj
     1953                       ,input  v-cntxt-obj-type
     1954                       ,input  v-cntxt-obj-code
     1955                       ,input  "":U
     1956                       ,input  "upper-rule-num":U
     1957                       ,input  loc_ban-discnt
     1958                       ,input -1
     1959                       ,input 0
     1960                       ,input-output v-sts
     1961                       ,input-output v-rid-list ) no-error .
     1962   END.
     1963   ON CHOOSE OF B-chga IN FRAME page-2
     1964   DO:
     1965   if not available temp-avto-price then return .
     1966   case temp-avto-price.nn :
     1967       when 1 then do:
     1968       run ref/chavtp.w
     1969           ( input-output  loc_ie-gen-marg
     1970           , input-output  loc_ie-gen-marg-parts
     1971           , input-output  loc_ie-objfirst
     1972           , input-output  loc_ie-objsecond
     1973           , input-output  loc_ie-pr-nakl
     1974           , 'ie') .
     1975       end.
     1976       when 2 then do:
     1977       run ref/chavtp.w
     1978           ( input-output  loc_iv-gen-marg
     1979           , input-output  loc_iv-gen-marg-parts
     1980           , input-output  loc_iv-objfirst
     1981           , input-output  loc_iv-objsecond
     1982           , input-output  loc_iv-pr-nakl
     1983           , 'iv') .
     1984       end.
     1985       when 3 then do:
     1986       run ref/chavtp.w
     1987           ( input-output  loc_im-gen-marg
     1988           , input-output  loc_im-gen-marg-parts
     1989           , input-output  loc_im-objfirst
     1990           , input-output  loc_im-objsecond
     1991           , input-output  loc_im-pr-nakl
     1992           , 'im' ) .
     1993       end.
     1994   end case.
     1995   run make-tt (
     1996      loc_ie-gen-marg
     1997     ,loc_ie-gen-marg-parts
     1998     ,loc_ie-objfirst
     1999     ,loc_ie-objsecond
     2000     ,loc_ie-pr-nakl
     2001     ,loc_iv-gen-marg
     2002     ,loc_iv-gen-marg-parts
     2003     ,loc_iv-objfirst
     2004     ,loc_iv-objsecond
     2005     ,loc_iv-pr-nakl
     2006     ,loc_im-gen-marg
     2007     ,loc_im-gen-marg-parts
     2008     ,loc_im-objfirst
     2009     ,loc_im-objsecond
     2010     ,loc_im-pr-nakl
     2011     ).
     2012   OPEN QUERY BR-tt FOR EACH temp-avto-price.
     2013   END.
     2014   ON CHOOSE OF b-gop IN FRAME page-2
     2015   DO:
     2016    find first ub.grp-obj-price where
     2017               ub.grp-obj-price.gop-db-num = loc_gop-db-num and
     2018               ub.grp-obj-price.gop-id     = loc_gop-id
     2019               no-lock no-error .
     2020    if error-status :error then return .
     2021    v-t-recid  = string(recid ( ub.grp-obj-price ))  .
     2022    run ref/gr-objpr.w ( input parparentproc , input "" , input-output v-t-recid ) .
     2023   END.
     2024   ON CHOOSE OF b-gop-2 IN FRAME page-2
     2025   DO:
     2026     find first ub.buyer-group where
     2027               ub.buyer-group.bgr-db-num = loc_bgr-db-num and
     2028               ub.buyer-group.bgr-id     = loc_bgr-id
     2029               no-lock no-error .
     2030    if error-status :error then return .
     2031    v-t-recid  = string(recid ( ub.buyer-group ))  .
     2032    run ref/gr-bupr.w (input  parparentproc , "", input-output v-t-recid ).
     2033   END.
     2034   ON CHOOSE OF b-gop-calc IN FRAME page-2
     2035   DO:
     2036    find first ub.grp-obj-price where
     2037               ub.grp-obj-price.gop-db-num = loc_gop-db-num-for-calc-turnover and
     2038               ub.grp-obj-price.gop-id     = loc_gop-id-for-calc-turnover
     2039               no-lock no-error .
     2040    if error-status :error then return .
     2041    v-t-recid  = string(recid ( ub.grp-obj-price ))  .
     2042    run ref/gr-objpr.w ( input parparentproc , input "" , input-output v-t-recid ) .
     2043   END.
     2044   ON CHOOSE OF b-have-tog IN FRAME page-1
     2045   DO:
     2046    find first ub.turnover-group where
     2047               ub.turnover-group.tog-db-num = loc_have-tog-db-num   and
     2048               ub.turnover-group.tog-id     = loc_have-tog-id
     2049               no-lock no-error .
     2050    if error-status :error then return .
     2051    v-t-recid  = string(recid ( ub.turnover-group ))  .
     2052    run ref/gr-obupr.w (input  parparentproc ,"" , input-output v-t-recid ).
     2053   END.
     2054   ON CHOOSE OF b-qnty-grp IN FRAME page-1
     2055   DO:
     2056    find first ub.qnty-group where
     2057               ub.qnty-group.qgr-db-num = loc_qgr-db-num  and
     2058               ub.qnty-group.qgr-id     = loc_qgr-id
     2059               no-lock no-error .
     2060    if error-status :error then return .
     2061    v-t-recid  = string(recid ( ub.qnty-group ))  .
     2062    run ref/gr-qupr.w (input  parparentproc ,"" ,  input-output v-t-recid ).
     2063   END.
     2064   ON CHOOSE OF b-qnty-sgr IN FRAME page-1
     2065   DO:
     2066    find first ub.sum-group where
     2067               ub.sum-group.sgr-db-num = loc_sgr-db-num   and
     2068               ub.sum-group.sgr-id     = loc_sgr-id
     2069               no-lock no-error .
     2070    if error-status :error then return .
     2071    v-t-recid  = string(recid ( ub.sum-group ))  .
     2072   run ref/gr-supr.w (input  parparentproc , "" ,  input-output v-t-recid ).
     2073   END.
     2074   ON CHOOSE OF b-qnty-tog IN FRAME page-2
     2075   DO:
     2076    find first ub.turnover-group where
     2077               ub.turnover-group.tog-db-num = loc_tog-db-num  and
     2078               ub.turnover-group.tog-id     = loc_tog-id
     2079               no-lock no-error .
     2080    if error-status :error then return .
     2081    v-t-recid  = string(recid ( ub.turnover-group ))  .
     2082    run ref/gr-obupr.w (input  parparentproc ,"" , input-output v-t-recid ).
     2083   END.
     2084   ON CHOOSE OF BUTTON-1 IN FRAME Dialog-Frame
     2085   DO:
     2086     button-1:LOAD-IMAGE-Up("adeicon\ts-up":U)        in frame Dialog-Frame .
     2087     button-2:LOAD-IMAGE-Up("adeicon\ts-down":U)      in frame Dialog-Frame .
     2088     button-3:LOAD-IMAGE-Up("adeicon\ts-down":U)      in frame Dialog-Frame .
     2089     label-button-1:fgcolor in frame Dialog-Frame  = 1   .
