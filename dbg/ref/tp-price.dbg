     1792        f-ban-discnt AT ROW 7.13 COL 26.63 COLON-ALIGNED NO-LABEL WIDGET-ID 8
     1793        create-price-doc-FILL-IN AT ROW 8.04 COL 1.5 NO-LABEL
     1794        use-cassa-FILL-IN AT ROW 9.04 COL 2.38 COLON-ALIGNED NO-LABEL
     1795        label-button-1 AT ROW 11.25 COL 3 NO-LABEL
     1796        label-button-2 AT ROW 11.25 COL 15.25 COLON-ALIGNED NO-LABEL
     1797        label-button-3 AT ROW 11.25 COL 29.88 COLON-ALIGNED NO-LABEL
     1798        RECT-1 AT ROW 11.96 COL 1.5
     1799        SPACE(0.50) SKIP(0.00)
     1800       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1801            SIDE-LABELS THREE-D  SCROLLABLE
     1802            TITLE "<insert dialog title>".
     1803   DEFINE FRAME page-2
     1804        loc_use-obj AT ROW 1.08 COL 29.88 NO-LABEL
     1805        r-gop AT ROW 1.08 COL 51.38
     1806        b-gop AT ROW 1.08 COL 54 WIDGET-ID 6
     1807        v-2 AT ROW 2.08 COL 92.5 COLON-ALIGNED
     1808        BR-tt AT ROW 2.25 COL 1.38 WIDGET-ID 100
     1809        loc_rs-buyer AT ROW 2.67 COL 32.25 NO-LABEL
     1810        r-gop-2 AT ROW 3.33 COL 27.75
     1811        b-gop-2 AT ROW 3.38 COL 30.38 WIDGET-ID 2
     1812        r-qnty-tog AT ROW 4.25 COL 27.75
     1813        b-qnty-tog AT ROW 4.29 COL 30.38 WIDGET-ID 4
     1814        loc_obj-turnover AT ROW 5.29 COL 30.13 NO-LABEL
     1815        r-gop-calc AT ROW 5.29 COL 51.5
     1816        b-gop-calc AT ROW 5.29 COL 54.13 WIDGET-ID 8
