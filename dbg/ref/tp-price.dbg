     1743         temp-avto-price.ext-doc-type COLUMN-LABEL " ! !Тип прихода"     format "x(17)"
     1744    temp-avto-price.gen-marg     COLUMN-LABEL "!Тип!автопереоценки"  format "x(14)"
     1745    temp-avto-price.gen-marg-parts     COLUMN-LABEL "!Автопереоценка!по партиям"  format "x(14)"
     1746    if temp-avto-price.objfirst = 1 then "по группе объектов"  else "по тек. объекту"     COLUMN-LABEL "Автопереоценка!на новый товар!остаток 0 " format "x(18)"
     1747    if temp-avto-price.objsecond   = 1 then "по группе объектов"  else "по тек. объекту"  COLUMN-LABEL "Автопереоценка!на НЕ новый!товар "        format "x(18)"
     1748    string(temp-avto-price.pr-nakl,"да/нет")      COLUMN-LABEL "Задавать!продажную цену!в док.прихода"
     1749       WITH NO-ROW-MARKERS SEPARATORS SIZE 95.63 BY 5.75 FIT-LAST-COLUMN.
