     4259     ASSIGN
     4260         frame Dialog-Frame:TITLE = "Описание типа прайс-листа  -- " + caps(p-mode)
     4261         label-button-1 = "Привязка"
     4262         label-button-2 = "Распространение"
     4263         label-button-3 = "Ограничения"
     4264         v-spis-kass:READ-ONLY = TRUE
     4265         .
     4266     if p-main-price  then do:
     4267         frame Dialog-Frame:TITLE = "Описание ГЛАВНОГО типа прайс-листа  -- " + caps(p-mode) .
     4268     end.
     4269     SELECT MAX( ub.price-list-type.priority ) INTO v-max FROM ub.price-list-type WHERE ub.price-list-type.stts = integer('0':U).
     4270     display v-max with frame Dialog-Frame .
     4271     loc_calc-method:list-items in frame Dialog-Frame  = 'Товар,УчетнаяS,Учет-рзрвS,ПриходнаяS,Старая,Новая,Объект,Накладная,Переоценка,ДокФормЦены,Накл-безНДС,Учет-НДСS,Стар-безНДС,Единая,Отсутствует,Откат_цен,Не-считать,Производит,Произв-НДС,ПорогПр-НДС,ПорогПр+НДС,Спецификация':U.
     4272       define variable p-list as character no-undo .
     4273       run str/pr-listv.p
     4274           (input 'Товар,УчетнаяS,Учет-рзрвS,ПриходнаяS,Старая,Новая,Объект,Накладная,Переоценка,ДокФормЦены,Накл-безНДС,Учет-НДСS,Стар-безНДС,Единая,Отсутствует,Откат_цен,Не-считать,Производит,Произв-НДС,ПорогПр-НДС,ПорогПр+НДС,Спецификация':U  ,
     4275           input 'Не-считать':U,
     4276           output p-list
     4277           ) .
     4278       loc_calc-method:list-items in frame Dialog-Frame  = p-list .
     4279     loc_calc-round-method:list-items in frame Dialog-Frame = '9-окончание,9-99окончание,Без-дробных,Произвольно,Вверх,Коэффициент,Отключено':U .
     4280   define variable par-pr-incpc  as decimal   no-undo .
     4281   define variable par-pr-rndmt  as character no-undo .
     4282   define variable par-pr-rndbs  as decimal   no-undo .
     4283    if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     4284   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4285   empty temp-table thbjattr_thbj-attr.
     4286   run adm/shattri.p (
     4287      input "get":U
     4288     ,input v-cntxt-obj-type
     4289     ,input v-cntxt-obj-code
     4290     ,input 'overval':U
     4291     ,input  ""
     4292     ,output v-value-character
     4293     ,output v-value-date
     4294     ,output v-value-decimal
     4295     ,output v-value-integer
     4296     ,output v-value-logical
     4297     ,output par-type
     4298     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     4299     ) no-error .
     4300     for each thbjattr_thbj-attr :
     4301         if thbjattr_thbj-attr.prop-code = 'pr-incpc':U then par-pr-incpc = thbjattr_thbj-attr.property-value-decimal .
     4302         if thbjattr_thbj-attr.prop-code = 'pr-rndmt':U then par-pr-rndmt = thbjattr_thbj-attr.property-value-character .
     4303         if thbjattr_thbj-attr.prop-code = 'pr-rndbs':U then par-pr-rndbs = thbjattr_thbj-attr.property-value-decimal .
     4304     end.
     4305     assign
     4306       loc_calc-increase-pc  = par-pr-incpc
     4307       loc_calc-round-base   = par-pr-rndbs
     4308     .
     4309     case par-pr-rndmt:
     4310       when "pr-round-9end" then
     4311         loc_calc-round-method = '9-окончание':U.
     4312       when "pr-round-9-99end" then
     4313         loc_calc-round-method = '9-99окончание':U.
     4314       when "pr-round-integer" then
     4315         loc_calc-round-method = 'Без-дробных':U.
     4316       when "pr-round-select" then
     4317         loc_calc-round-method = 'Произвольно':U.
     4318       when "pr-round-up" then
     4319         loc_calc-round-method = 'Вверх':U.
     4320       when "pr-round-coef" then
     4321         loc_calc-round-method = 'Коэффициент':U.
     4322       when "pr-round-off" then
     4323         loc_calc-round-method = 'Отключено':U.
     4324       otherwise
     4325         loc_calc-round-method = 'Отключено':U.
     4326     end case.
     4327     if loc_calc-round-method = "" then do:
     4328       loc_calc-round-method = 'Отключено':U.
     4329     end.
     4330     if loc_calc-method = "" or loc_calc-method = ?  then do:
     4331        loc_calc-method = 'Отсутствует':U.
     4332     end.
     4333     if lookup( input frame Dialog-Frame loc_calc-round-method, 'Произвольно,Вверх,Коэффициент,9-99окончание':U ) > 0 then do:
     4334       enable loc_calc-round-base with frame Dialog-Frame.
     4335     end.
     4336     else
     4337       hide loc_calc-round-base in frame Dialog-Frame.
     4338     if p-main-price = true
     4339        then do:
     4340            assign
     4341               loc_create-price-doc = 1
     4342               loc_send-cassa = 1
     4343            .
     4344            run avtoinit
     4345                ( input   loc_plt-id
     4346                 ,input   loc_plt-db-num
     4347                 ,output  loc_ie-gen-marg
     4348                 ,output  loc_ie-gen-marg-parts
     4349                 ,output  loc_ie-objfirst
     4350                 ,output  loc_ie-objsecond
     4351                 ,output  loc_ie-pr-nakl
     4352                 ,output  loc_iv-gen-marg
     4353                 ,output  loc_iv-gen-marg-parts
     4354                 ,output  loc_iv-objfirst
     4355                 ,output  loc_iv-objsecond
     4356                 ,output  loc_iv-pr-nakl
     4357                 ,output  loc_im-gen-marg
     4358                 ,output  loc_im-gen-marg-parts
     4359                 ,output  loc_im-objfirst
     4360                 ,output  loc_im-objsecond
     4361                 ,output  loc_im-pr-nakl   ) .
     4362            end.
     4363         else do:
     4364            assign
     4365               loc_create-price-doc = 2
     4366               loc_send-cassa = 2
     4367            .
     4368         end.
     4369   end.
     4370     if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     4371        find ub.price-list-type no-lock where recid(ub.price-list-type) =  p-recid no-error .
     4372        if error-status :error then return .
     4373        if p-main-price = false  then do:
     4374             run init-spis-kass.
     4375             run init-spis-gds-grp.
     4376        end.
     4377        run init-spis-pay-type.
     4378        run init-spis-cash-pay.
     4379        run init-proc .
     4380     end.
     4381     run enable1 .
     4382     if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     4383       if ub.price-list-type.stts = integer('1':U) then do:
     4384         frame Dialog-Frame:TITLE = trim (frame Dialog-Frame:TITLE) + " -- УДАЛЕН !!!"    .
     4385       end.
     4386     end.
     4387     APPLY "CHOOSE":U TO BUTTON-1 .
     4388     assign
     4389       v-x-button-1 = BUTTON-1:row
     4390       v-x-button-2 = BUTTON-2:row
     4391       v-x-button-3 = BUTTON-3:row
     4392       v-y-button-1 = BUTTON-1:column
     4393       v-y-button-2 = BUTTON-2:column
     4394       v-y-button-3 = BUTTON-3:column
     4395       l-x-button-1 = label-BUTTON-1:row
     4396       l-x-button-2 = label-BUTTON-2:row
     4397       l-x-button-3 = label-BUTTON-3:row
     4398       l-y-button-1 = label-BUTTON-1:column
     4399       l-y-button-2 = label-BUTTON-2:column
     4400       l-y-button-3 = label-BUTTON-3:column
     4401     .
     4402      define buffer ch0_price-list-type for ub.price-list-type  .
     4403      define variable str-inf as character no-undo .
     4404      str-inf = "".
     4405      find first ch0_price-list-type no-lock where
     4406           ch0_price-list-type.stts            = integer('0':U) and
     4407           ch0_price-list-type.under-type-list = 1 and
     4408           ch0_price-list-type.plt-main-id     = loc_plt-id and
     4409           ch0_price-list-type.plt-main-db-num = loc_plt-db-num  no-error .
     4410           if available ch0_price-list-type then
     4411              str-inf = "  -- << РОДИТЕЛЬСКИЙ >> -- "  .
     4412       frame Dialog-Frame:TITLE = "Описание типа прайс-листа  "  + str-inf  + caps(p-mode).
     4413       if p-main-price  then do:
     4414           frame Dialog-Frame:TITLE = "Описание ГЛАВНОГО типа прайс-листа  -- " + str-inf  + caps(p-mode) .
     4415       end.
     4416       if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     4417         if ub.price-list-type.stts = integer('1':U)  then do:
     4418           frame Dialog-Frame:TITLE = trim (frame Dialog-Frame:TITLE) + " -- УДАЛЕН !!!"    .
     4419         end.
     4420       end.
     4421     run vis-bin.
     4422     if p-main-price = true   then do:
     4423     hide v-max in frame  Dialog-Frame .
     4424     hide b-gop-2 b-qnty-tog b-gop-calc in frame page-2.
     4425     enable b-gop with frame page-2 .
     4426     assign
     4427       v-x-button-3 = v-x-button-2
     4428       v-x-button-2 = v-x-button-1
     4429       v-y-button-3 = v-y-button-2
     4430       v-y-button-2 = v-y-button-1
     4431       l-x-button-3 = l-x-button-2
     4432       l-x-button-2 = l-x-button-1
     4433       l-y-button-3 = l-y-button-2
     4434       l-y-button-2 = l-y-button-1
     4435       BUTTON-2:row                  = v-x-button-2
     4436       BUTTON-3:row                  = v-x-button-3
     4437       BUTTON-2:column               = v-y-button-2
     4438       BUTTON-3:column               = v-y-button-3
     4439       label-BUTTON-2:row            = l-x-button-2
     4440       label-BUTTON-3:row            = l-x-button-3
     4441       label-BUTTON-2:column         = l-y-button-2
     4442       label-BUTTON-3:column         = l-y-button-3
     4443     .
     4444       APPLY "CHOOSE":U TO BUTTON-2 .
     4445       run runav in this-procedure .
     4446     end.
     4447     else do:
     4448       hide loc_only-gbd  in frame Dialog-Frame .
     4449       hide br-tt B-chga  In FRAME  page-2 .
     4450     end.
     4451     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     4452       run mode_add-init.
     4453     end.
     4454     WAIT-FOR GO OF FRAME Dialog-Frame  .
     4455   END.
     4456   RUN disable_UI.
     4457   PROCEDURE all-mode :
     4458   define buffer buf_global-state for ub.global-state  .
     4459   define variable g-log as logical   no-undo .
     4460       find last buf_global-state no-lock  no-error .
     4461       if error-status :error then do:
     4462          message "Не заданы глобальные настройки ценообразования !!!" view-as alert-box error .
     4463          return error return-value .
     4464       end.
     4465       if buf_global-state.pl-use-val = false then do:
     4466          hide
     4467          r-cur in frame Dialog-Frame
     4468          loc_fix-cource-crc-doc  in frame Dialog-Frame .
     4469       end.
     4470       if buf_global-state.pl-use-qnty-group = false then do:
     4471          hide
     4472          loc_have-rs-qnty-group in frame page-1
     4473          loc_qgr-id             in frame page-1
     4474          loc_qgr-db-num         in frame page-1
     4475          r-qnty-grp             in frame page-1
     4476          loc_qg_name            in frame page-1  .
     4477       end.
     4478       if buf_global-state.pl-use-sum-group = false then do:
     4479          hide
     4480          loc_have-rs-sum-group
     4481              loc_sgr-id
     4482              loc_sgr-db-num
     4483              r-qnty-sgr
     4484              loc_sg_name
     4485          in frame page-1 .
     4486       end.
     4487       if buf_global-state.pl-use-grp-buy  = false then do:
     4488          hide
     4489          loc_bgr-id in frame page-2
     4490          loc_bgr-db-num
     4491          r-gop-2
     4492          loc_bgr_name in frame page-2
     4493          .
     4494          g-log = loc_rs-buyer:disable ( radio-label(string(1), loc_rs-buyer:radio-buttons) ).
     4495       end.
     4496       if buf_global-state.pl-use-oborot-buy  = false then do:
     4497          hide
     4498           loc_tog-id
     4499           loc_tog-db-num
     4500           r-qnty-tog
     4501           loc_tog_name
     4502           r-obj-fill-in
     4503           loc_obj-turnover
     4504           loc_gop-id-for-calc-turnover
     4505           loc_gop-db-num-for-calc-turnover
     4506           r-gop-calc
     4507           loc_obj-turnover
     4508           in frame page-2 .
     4509          hide
     4510           loc_have-tog-id
     4511           loc_have-tog-db-num
     4512           r-have-tog
     4513           loc_have-tog_name
     4514           loc_have-rs-turn-group
     4515           in frame page-1 .
     4516           g-log = loc_rs-buyer:disable(radio-label("2", loc_rs-buyer:radio-buttons)).
     4517       end.
     4518       if buf_global-state.pl-use-oborot-buy  = false and buf_global-state.pl-use-grp-buy  = false then do:
     4519          hide r-FILL-IN loc_rs-buyer in frame page-2 .
     4520       end.
     4521       if buf_global-state.pl-use-sys-date-time  = false then do:
     4522          g-log = loc_work-date:disable(radio-label("3", loc_work-date:radio-buttons)).
     4523       end.
     4524       if buf_global-state.pl-use-shift-date-num  = false then do:
     4525          g-log = loc_work-date:disable(radio-label("2", loc_work-date:radio-buttons)).
     4526       end.
     4527       if buf_global-state.pl-use-cassa  = false then do:
     4528          hide
     4529          loc_use-cassa
     4530          loc_use-cassa_fill-in
     4531          v-spis-kass
     4532          in frame page-2 .
     4533       end.
     4534       if buf_global-state.pl-use-pay-type  = false then do:
     4535          hide
     4536          loc_use-pay-type in frame page-3
     4537          v-spis-type-pay
     4538          in frame page-3 .
     4539       end.
     4540       if buf_global-state.pl-use-cash-pay  = false then do:
     4541          hide
     4542          loc_use-cash-pay in frame page-3
     4543          v-spis-use-cash-pay
     4544          in frame page-3 .
     4545       end.
     4546       if buf_global-state.pl-use-child  = false then do:
     4547          hide
     4548             loc_under-type-list
     4549             loc_plt-main-id
     4550             loc_plt-main-db-num
     4551             r-rod-price-type
     4552             loc_rod-pt-name
     4553             loc_under-hand-corr
     4554          in frame Dialog-Frame .
     4555       end.
     4556   END PROCEDURE.
     4557   PROCEDURE avtoinit :
     4558   define input  parameter p-plt-id     as integer   no-undo .
     4559   define input  parameter p-plt-db-num as integer   no-undo .
     4560   define output parameter p-ie-gen-marg  as character no-undo .
     4561   define output parameter p-ie-gen-marg-parts  as character no-undo .
     4562   define output parameter p-ie-objfirst  as integer   no-undo .
     4563   define output parameter p-ie-objsecond as integer   no-undo .
     4564   define output parameter p-ie-pr-nakl   as logical   no-undo .
     4565   define output parameter p-iv-gen-marg  as character no-undo .
     4566   define output parameter p-iv-gen-marg-parts  as character no-undo .
     4567   define output parameter p-iv-objfirst  as integer   no-undo .
     4568   define output parameter p-iv-objsecond as integer   no-undo .
     4569   define output parameter p-iv-pr-nakl   as logical   no-undo .
     4570   define output parameter p-im-gen-marg  as character no-undo .
     4571   define output parameter p-im-gen-marg-parts  as character no-undo .
     4572   define output parameter p-im-objfirst  as integer   no-undo .
     4573   define output parameter p-im-objsecond as integer   no-undo .
     4574   define output parameter p-im-pr-nakl   as logical   no-undo .
     4575   define buffer buf_price-list-type-attr for ub.price-list-type-attr  .
     4576   assign
     4577   p-ie-gen-marg  = 'no-margin':U
     4578   p-ie-gen-marg-parts  = 'no-margin':U
     4579   p-ie-objfirst  = 0
     4580   p-ie-objsecond = 1
     4581   p-ie-pr-nakl   = false
     4582   p-iv-gen-marg  = 'no-margin':U
     4583   p-iv-gen-marg-parts  = 'no-margin':U
     4584   p-iv-objfirst  = 0
     4585   p-iv-objsecond = 1
     4586   p-iv-pr-nakl   =  false
     4587   p-im-gen-marg  = 'no-margin':U
     4588   p-im-gen-marg-parts  = 'no-margin':U
     4589   p-im-objfirst  = 0
     4590   p-im-objsecond = 1
     4591   p-im-pr-nakl   = false
     4592    .
     4593   for each  buf_price-list-type-attr no-lock where
     4594             buf_price-list-type-attr.plt-id     = p-plt-id and
     4595             buf_price-list-type-attr.plt-db-num = p-plt-db-num  :
     4596     if buf_price-list-type-attr.attr-code = 'ie-gen-marg':U  then p-ie-gen-marg   = buf_price-list-type-attr.attr-value.
     4597     if buf_price-list-type-attr.attr-code = 'ie-gen-marg-parts':U  then p-ie-gen-marg-parts   = buf_price-list-type-attr.attr-value.
     4598     if buf_price-list-type-attr.attr-code = 'ie-objfirst':U  then p-ie-objfirst   = int(buf_price-list-type-attr.attr-value).
     4599     if buf_price-list-type-attr.attr-code = 'ie-objsecond':U then p-ie-objsecond = int(buf_price-list-type-attr.attr-value).
     4600     if buf_price-list-type-attr.attr-code = 'ie-pr-nakl':U   then p-ie-pr-nakl   = if buf_price-list-type-attr.attr-value = 'yes' then true  else false .
     4601     if buf_price-list-type-attr.attr-code = 'iv-gen-marg':U  then p-iv-gen-marg   = buf_price-list-type-attr.attr-value.
     4602     if buf_price-list-type-attr.attr-code = 'iv-gen-marg-parts':U  then p-iv-gen-marg-parts   = buf_price-list-type-attr.attr-value.
     4603     if buf_price-list-type-attr.attr-code = 'iv-objfirst':U  then p-iv-objfirst   = int(buf_price-list-type-attr.attr-value).
     4604     if buf_price-list-type-attr.attr-code = 'iv-objsecond':U then p-iv-objsecond = int(buf_price-list-type-attr.attr-value).
     4605     if buf_price-list-type-attr.attr-code = 'iv-pr-nakl':U   then p-iv-pr-nakl   = if buf_price-list-type-attr.attr-value = 'yes' then true  else false .
     4606     if buf_price-list-type-attr.attr-code = 'im-gen-marg':U  then p-im-gen-marg   = buf_price-list-type-attr.attr-value.
     4607     if buf_price-list-type-attr.attr-code = 'im-gen-marg-parts':U  then p-im-gen-marg-parts   = buf_price-list-type-attr.attr-value.
     4608     if buf_price-list-type-attr.attr-code = 'im-objfirst':U  then p-im-objfirst   = int(buf_price-list-type-attr.attr-value).
     4609     if buf_price-list-type-attr.attr-code = 'im-objsecond':U then p-im-objsecond = int(buf_price-list-type-attr.attr-value).
     4610     if buf_price-list-type-attr.attr-code = 'im-pr-nakl':U   then p-im-pr-nakl   = if buf_price-list-type-attr.attr-value = 'yes' then true  else false .
     4611   end.
     4612   run make-tt (
     4613      p-ie-gen-marg
     4614     ,p-ie-gen-marg-parts
     4615     ,p-ie-objfirst
     4616     ,p-ie-objsecond
     4617     ,p-ie-pr-nakl
     4618     ,p-iv-gen-marg
     4619     ,p-iv-gen-marg-parts
     4620     ,p-iv-objfirst
     4621     ,p-iv-objsecond
     4622     ,p-iv-pr-nakl
     4623     ,p-im-gen-marg
     4624     ,p-im-gen-marg-parts
     4625     ,p-im-objfirst
     4626     ,p-im-objsecond
     4627     ,p-im-pr-nakl
     4628     ).
     4629   END PROCEDURE.
     4630   PROCEDURE avtoper :
