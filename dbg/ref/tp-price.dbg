        1   DEFINE TEMP-TABLE tt_price-list-type-cash-pay NO-UNDO LIKE ub.price-list-type-cash-pay.
        2   DEFINE TEMP-TABLE tt_price-list-type-cassa NO-UNDO LIKE ub.price-list-type-cassa.
        3   DEFINE TEMP-TABLE tt_price-list-type-gds-grp NO-UNDO LIKE ub.price-list-type-gds-grp.
        4   DEFINE TEMP-TABLE tt_price-list-type-pay-type NO-UNDO LIKE ub.price-list-type-pay-type.
        5   define input  parameter parparentproc as handle no-undo .
        6   define input  parameter p-main-price as logical   no-undo .
        7   define input  parameter p-mode as character no-undo .
        8   define input-output parameter p-recid as recid no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Карточка типа прайс-листа".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   procedure proc-alt-shift-f2:
       76     if not ibs.th.gbl.gbl-var:rcode
       77   then
       78     run gbl\inidebug.p .
       79   end.
       80   procedure proc-alt-shift-f3:
       81     run gbl/prvssinf.p
       82       ( input this-procedure
       83       ) .
       84   end.
       85   define variable v-inform-launched as logical no-undo initial false .
       86   procedure proc-alt-shift-f4:
       87     define variable v-action as character no-undo .
       88     if v-inform-launched = false then do:
       89       assign
       90         v-inform-launched = true
       91       .
       92       run gbl/d-inform.w
       93         (  input self
       94         ,  input this-procedure
       95         , output v-action
       96         ) no-error .
       97       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       98       assign
       99         v-inform-launched = false
      100       .
      101     end.
      102   end.
      103   procedure proc-alt-f1:
      104     run gbl/corrhelp.p
      105       (input this-procedure
      106       ) .
      107   end .
      108   on alt-shift-f2 anywhere do:
      109     run proc-alt-shift-f2.
      110   end.
      111   on alt-shift-f3 anywhere do:
      112     run proc-alt-shift-f3 in this-procedure .
      113   end.
      114   on alt-shift-f4 anywhere do:
      115     run proc-alt-shift-f4 in this-procedure.
      116   end.
      117   on alt-f1 anywhere do:
      118     run proc-alt-f1 in this-procedure .
      119   end.
      120   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121     define variable v-cntxt-db-num        as integer   no-undo .
      122     define variable v-cntxt-userid        as character no-undo .
      123     define variable v-cntxt-level         as character no-undo .
      124     define variable v-cntxt-host-code-obj as integer   no-undo .
      125     define variable v-cntxt-obj-type      as character no-undo .
      126     define variable v-cntxt-obj-code      as integer   no-undo .
      127     define variable v-cntxt-db-num-obj    as integer   no-undo .
      128     define variable v-cntxt-is-admin      as logical   no-undo .
      129   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130     run mainmenu_getcntxt in parparentproc
      131       (output v-cntxt-db-num
      132       ,output v-cntxt-userid
      133       ,output v-cntxt-level
      134       ,output v-cntxt-host-code-obj
      135       ,output v-cntxt-obj-type
      136       ,output v-cntxt-obj-code
      137       ,output v-cntxt-db-num-obj
      138       ,output v-cntxt-is-admin
      139       ) .
      140   DEFINE TEMP-TABLE TT_cassa NO-UNDO LIKE ub.price-list-type-cassa.
      141   DEFINE TEMP-TABLE TT_grp   NO-UNDO LIKE ub.price-list-type-gds-grp.
      142   DEFINE TEMP-TABLE TT_pay-type NO-UNDO LIKE ub.price-list-type-pay-type.
      143   DEFINE TEMP-TABLE TT_cash-pay NO-UNDO LIKE ub.price-list-type-cash-pay.
      144   PROCEDURE type-price-list-ADD :
      145   define input  parameter p-db-num                       as integer   no-undo .
      146   define input  parameter p-id                           as integer   no-undo .
      147   define input  parameter p-name                         as character no-undo .
      148   define input  parameter p-ban-discnt                   like   ub.price-list-type.ban-discnt          no-undo .
      149   define input  parameter p-calc-round-method            like   ub.price-list-type.calc-round-method    no-undo .
      150   define input  parameter p-calc-round-base              like   ub.price-list-type.calc-round-base      no-undo .
      151   define input  parameter p-calc-increase-pc             like   ub.price-list-type.calc-increase-pc     no-undo .
      152   define input  parameter p-calc-method                  like   ub.price-list-type.calc-method          no-undo .
      153   define input  parameter p-create-price-doc             like   ub.price-list-type.create-price-doc     no-undo .
      154   define input  parameter p-fix-cource-crc-base          like   ub.price-list-type.fix-cource-crc-base  no-undo .
      155   define input  parameter p-fix-cource-crc-doc           like   ub.price-list-type.fix-cource-crc-doc   no-undo .
      156   define input  parameter p-have-rs-qnty-group           like   ub.price-list-type.have-rs-qnty-group   no-undo .
      157   define input  parameter p-have-rs-sum-group            like   ub.price-list-type.have-rs-sum-group    no-undo .
      158   define input  parameter p-main                         like   ub.price-list-type.main                 no-undo .
      159   define input  parameter p-only-gbd                     like   ub.price-list-type.only-gbd             no-undo .
      160   define input  parameter p-plt-main-db-num              like   ub.price-list-type.plt-main-db-num      no-undo .
      161   define input  parameter p-plt-main-id                  like   ub.price-list-type.plt-main-id          no-undo .
      162   define input  parameter p-priority                     like   ub.price-list-type.priority             no-undo .
      163   define input  parameter p-rs-buyer                     like   ub.price-list-type.rs-buyer             no-undo .
      164   define input  parameter p-send-cassa                   like   ub.price-list-type.send-cassa           no-undo .
      165   define input  parameter p-under-hand-corr              like   ub.price-list-type.under-hand-corr      no-undo .
      166   define input  parameter p-under-round-method           like   ub.price-list-type.under-round-method         no-undo .
      167   define input  parameter p-under-perc                   like   ub.price-list-type.under-perc           no-undo .
      168   define input  parameter p-under-type-list              like   ub.price-list-type.under-type-list      no-undo .
      169   define input  parameter p-use-cassa                    like   ub.price-list-type.use-cassa            no-undo .
      170   define input  parameter p-use-gds-group                like   ub.price-list-type.use-gds-group        no-undo .
      171   define input  parameter p-use-obj                      like   ub.price-list-type.use-obj              no-undo .
      172   define input  parameter p-work-date                    like   ub.price-list-type.work-date            no-undo .
      173   define input  parameter p-bgr-db-num                   like   ub.price-list-type.bgr-db-num           no-undo .
      174   define input  parameter p-bgr-id                       like   ub.price-list-type.bgr-id               no-undo .
      175   define input  parameter p-curr-code                    like   ub.price-list-type.curr-code            no-undo .
      176   define input  parameter p-gop-db-num                   like   ub.price-list-type.gop-db-num           no-undo .
      177   define input  parameter p-gop-db-num-for-calc-turnover like   ub.price-list-type.gop-db-num-for-calc-turnover  no-undo .
      178   define input  parameter p-gop-id                       like   ub.price-list-type.gop-id                        no-undo .
      179   define input  parameter p-gop-id-for-calc-turnover     like   ub.price-list-type.gop-id-for-calc-turnover      no-undo .
      180   define input  parameter p-qgr-db-num                   like   ub.price-list-type.qgr-db-num                    no-undo .
      181   define input  parameter p-qgr-id                       like   ub.price-list-type.qgr-id                        no-undo .
      182   define input  parameter p-sgr-db-num                   like   ub.price-list-type.sgr-db-num                    no-undo .
      183   define input  parameter p-sgr-id                       like   ub.price-list-type.sgr-id                        no-undo .
      184   define input  parameter p-tog-db-num                   like   ub.price-list-type.tog-db-num                    no-undo .
      185   define input  parameter p-tog-id                       like   ub.price-list-type.tog-id                        no-undo .
      186   define input  parameter p-obj-turnover                 like   ub.price-list-type.obj-turnover                  no-undo .
      187   define input  parameter p-ttg-summa                    like   ub.price-list-type.ttg-summa                     no-undo .
      188   define input  parameter p-userid                       as character no-undo .
      189   define input  parameter p-db-num-usr                   as integer   no-undo .
      190   define input  parameter p-have-rs-turn-group           like   ub.price-list-type.have-rs-turn-group no-undo .
      191   define input  parameter p-have-tog-db-num              like   ub.price-list-type.have-tog-db-num    no-undo .
      192   define input  parameter p-have-tog-id                  like   ub.price-list-type.have-tog-id        no-undo .
      193   define input  parameter p-use-cash-pay                 like   ub.price-list-type.use-cash-pay no-undo .
      194   define input  parameter p-use-pay-type                 like   ub.price-list-type.use-pay-type no-undo .
      195   define output parameter p-recid                        as recid no-undo .
      196   define input  parameter table for tt_cassa .
      197   define input  parameter table for tt_grp   .
      198   define input  parameter table for tt_pay-type .
      199   define input  parameter table for tt_cash-pay .
      200   define variable v-text as character no-undo .
      201   define buffer buf_price-list-type for ub.price-list-type  .
      202     do
      203     on error undo, return error return-value
      204     :
      205   if p-plt-main-id                     = ? then p-plt-main-id = 0 .
      206   if p-bgr-id                          = ? then p-bgr-id                        = 0 .
      207   if p-gop-id                          = ? then p-gop-id                        = 0 .
      208   if p-gop-id-for-calc-turnover        = ? then p-gop-id-for-calc-turnover      = 0 .
      209   if p-qgr-db-num                      = ? then p-qgr-db-num                    = 0 .
      210   if p-qgr-id                          = ? then p-qgr-id                        = 0 .
      211   if p-sgr-db-num                      = ? then p-sgr-db-num                    = 0 .
      212   if p-sgr-id                          = ? then p-sgr-id                        = 0 .
      213   if p-tog-db-num                      = ? then p-tog-db-num                    = 0 .
      214   if p-tog-id                          = ? then p-tog-id                        = 0 .
      215   if p-gop-db-num                      = ? then p-gop-db-num                    = 0 .
      216   if p-gop-db-num-for-calc-turnover    = ? then p-gop-db-num-for-calc-turnover  = 0 .
      217   if p-have-tog-db-num                 = ? then p-have-tog-db-num  = 0 .
      218   if p-have-tog-id                     = ? then p-have-tog-id      = 0 .
      219   if p-gop-id = 0  then  p-use-obj = 1 .
      220   if p-gop-id-for-calc-turnover  = 0  then  p-obj-turnover = false  .
      221   if p-tog-id = 0   then  p-obj-turnover = false  .
      222   if p-tog-id = 0 and  p-bgr-id = 0   then  p-rs-buyer = 0.
      223   if p-name = ? or p-name = ""  then do:
      224     return error "Название типа прайс-листа не должно быть пустым!" .
      225   end.
      226   if logical(p-have-rs-qnty-group) = true and  ( p-qgr-id = 0 or p-qgr-id = ? ) then do:
      227     return error "Не задана количественная группа!" .
      228   end.
      229   if p-have-rs-sum-group = true and  ( p-sgr-id = 0 or p-sgr-id = ? ) then do:
      230     return error "Не задана суммовая группа!" .
      231   end.
      232   if logical(p-under-type-list) = true and  ( p-plt-main-id = 0 or p-plt-main-id = ? ) then do:
      233     return error "Не задан родительский прайс-лист !" .
      234   end.
      235   define buffer parent_price-list-type for ub.price-list-type  .
      236   if  logical(p-under-type-list) = true and p-main = true  then do:
      237       find first parent_price-list-type  no-lock where
      238                  parent_price-list-type.plt-id = p-plt-main-id  and
      239                  parent_price-list-type.plt-db-num =  p-plt-main-db-num no-error .
      240       if not available parent_price-list-type then  return error "Родительский прайс-лист не найден !" .
      241       if parent_price-list-type.stts <> integer('0':U) then  return error "Родительский прайс-лист удален !" .
      242       if parent_price-list-type.main = false  then  return error "Родительский прайс-лист должен быть ГЛАВНЫМ !" .
      243       if parent_price-list-type.under-type-list <> 0  then return error "Родительский прайс-лист не должен быть подчиненным !"  .
      244   end.
      245   if  logical(p-under-type-list) = true and p-main = false   then do:
      246       find first parent_price-list-type  no-lock where
      247                  parent_price-list-type.plt-id = p-plt-main-id  and
      248                  parent_price-list-type.plt-db-num =  p-plt-main-db-num no-error .
      249       if not available parent_price-list-type then  return error "Родительский прайс-лист не найден !" .
      250       if parent_price-list-type.stts <> integer('0':U) then  return error "Родительский прайс-лист удален !" .
      251       if parent_price-list-type.under-type-list <> 0  then return error "Родительский прайс-лист не должен быть подчиненным !"  .
      252   end.
      253   if logical(p-have-rs-qnty-group) = false  and not ( p-qgr-id = 0 or p-qgr-id = ? ) then do:
      254      p-qgr-id = 0.
      255      p-qgr-db-num = 0.
      256   end.
      257   if p-have-rs-sum-group = false  and  not( p-sgr-id = 0 or p-sgr-id = ? ) then do:
      258     p-sgr-id = 0.
      259     p-sgr-db-num = 0.
      260   end.
      261   if logical(p-have-rs-turn-group) = false  and not ( p-have-tog-id = 0 or p-have-tog-id = ? ) then do:
      262      p-have-tog-id = 0.
      263      p-have-tog-db-num = 0.
      264   end.
      265   if p-priority  = 0  and p-main = false  and p-under-type-list = 0 then do:
      266      return error "Не задан ПРИОРИТЕТ типа прайс-листа"   .
      267   end.
      268   if p-priority > 0 and p-main = false and p-under-type-list = 0 then do:
      269       if can-find (
      270             first buf_price-list-type no-lock where
      271                   buf_price-list-type.under-type-list = 0          and
      272                   buf_price-list-type.priority        = p-priority and
      273                   buf_price-list-type.main            = false      and
      274                   buf_price-list-type.stts            = integer('0':U)          and
      275               not
      276                 ( buf_price-list-type.plt-db-num = p-db-num and
      277                   buf_price-list-type.plt-id     = p-id )
      278                 ) then
      279       return error "Уже есть тип прайс-листа с приоритетом " + string ( p-priority ) .
      280   end.
      281   find first ub.price-list-type exclusive-lock where
      282              ub.price-list-type.plt-db-num   = p-db-num and
      283              ub.price-list-type.plt-id       = p-id
      284              no-error .
      285       if not available ub.price-list-type then do:
      286         if p-main = true and p-only-gbd = 1 then do:
      287           if can-find ( first buf_price-list-type no-lock where
      288                             buf_price-list-type.main = true and
      289                             buf_price-list-type.only-gbd = 1 and
      290                             buf_price-list-type.stts = integer('0':U) and
      291                             buf_price-list-type.gop-id = p-gop-id and
      292                             buf_price-list-type.gop-db-num = p-gop-db-num ) then  do:
      293               if p-gop-id = 0 or p-gop-id = ? then do:
      294                 v-text  = "для всех объектов" .
      295                 end.
      296                 else do:
      297                 v-text  = "для объектов из группы №"  + string(p-gop-id) + " БД:" + string(p-gop-db-num).
      298                 end.
      299               release ub.price-list-type no-error .
      300               return error "Уже существует ГЛАВНЫЙ ПРАЙС-ЛИСТ для автопереоценок " + v-text .
      301               end.
      302         end.
      303         create ub.price-list-type .
      304         assign
      305             ub.price-list-type.plt-db-num   = p-db-num
      306             ub.price-list-type.plt-id       = p-id
      307         .
      308       end.
      309          assign
      310             ub.price-list-type.plt-db-num                     = p-db-num
      311             ub.price-list-type.plt-id                         = p-id
      312             ub.price-list-type.name                           = p-name
      313             ub.price-list-type.ban-discnt                     = p-ban-discnt
      314             ub.price-list-type.calc-round-method              = p-calc-round-method
      315             ub.price-list-type.calc-round-base                = p-calc-round-base
      316             ub.price-list-type.calc-increase-pc               = p-calc-increase-pc
      317             ub.price-list-type.calc-method                    = p-calc-method
      318             ub.price-list-type.create-price-doc               = p-create-price-doc
      319             ub.price-list-type.fix-cource-crc-base            = p-fix-cource-crc-base
      320             ub.price-list-type.fix-cource-crc-doc             = p-fix-cource-crc-doc
      321             ub.price-list-type.have-rs-qnty-group             = p-have-rs-qnty-group
      322             ub.price-list-type.have-rs-sum-group              = p-have-rs-sum-group
      323             ub.price-list-type.main                           = p-main
      324             ub.price-list-type.only-gbd                       = p-only-gbd
      325             ub.price-list-type.plt-main-db-num                = if p-plt-main-id = 0 then p-db-num else p-plt-main-db-num
      326             ub.price-list-type.plt-main-id                    = if p-plt-main-id = 0 then p-id else p-plt-main-id
      327             ub.price-list-type.priority                       = p-priority
      328             ub.price-list-type.rs-buyer                       = p-rs-buyer
      329             ub.price-list-type.send-cassa                     = p-send-cassa
      330             ub.price-list-type.under-hand-corr                = p-under-hand-corr
      331             ub.price-list-type.under-round-method             = p-under-round-method
      332             ub.price-list-type.under-perc                     = p-under-perc
      333             ub.price-list-type.under-type-list                = p-under-type-list
      334             ub.price-list-type.use-cassa                      = p-use-cassa
      335             ub.price-list-type.use-gds-group                  = p-use-gds-group
      336             ub.price-list-type.use-obj                        = p-use-obj
      337             ub.price-list-type.work-date                      = p-work-date
      338             ub.price-list-type.bgr-db-num                     = p-bgr-db-num
      339             ub.price-list-type.bgr-id                         = p-bgr-id
      340             ub.price-list-type.curr-code                      = p-curr-code
      341             ub.price-list-type.gop-db-num                     = p-gop-db-num
      342             ub.price-list-type.gop-db-num-for-calc-turnover   = p-gop-db-num-for-calc-turnover
      343             ub.price-list-type.gop-id                         = p-gop-id
      344             ub.price-list-type.gop-id-for-calc-turnover       = p-gop-id-for-calc-turnover
      345             ub.price-list-type.qgr-db-num                     = p-qgr-db-num
      346             ub.price-list-type.qgr-id                         = p-qgr-id
      347             ub.price-list-type.sgr-db-num                     = p-sgr-db-num
      348             ub.price-list-type.sgr-id                         = p-sgr-id
      349             ub.price-list-type.tog-db-num                     = p-tog-db-num
      350             ub.price-list-type.tog-id                         = p-tog-id
      351             ub.price-list-type.obj-turnover                   = p-obj-turnover
      352             ub.price-list-type.ttg-summa                      = p-ttg-summa
      353             ub.price-list-type.have-rs-turn-group             =   p-have-rs-turn-group
      354             ub.price-list-type.have-tog-db-num                =   p-have-tog-db-num
      355             ub.price-list-type.have-tog-id                    =   p-have-tog-id
      356             ub.price-list-type.use-cash-pay                   =   p-use-cash-pay
      357             ub.price-list-type.use-pay-type                   =   p-use-pay-type
      358             ub.price-list-type.stts                           = integer('0':U)
      359             ub.price-list-type.sys-date                       = today
      360             ub.price-list-type.sys-time                       = time
      361             ub.price-list-type.sys-time-chr                   = string ( ub.price-list-type.sys-time,"hh:mm" )
      362             ub.price-list-type.who                            = p-userid
      363             ub.price-list-type.db-num-chg                     = p-db-num-usr
      364             p-recid = recid ( ub.price-list-type )
      365         .
      366     if p-use-cassa < 3 then do:
      367        for each tt_cassa : delete tt_cassa . end.
      368     end.
      369     if p-use-gds-group = 0  then do:
      370        for each tt_grp : delete tt_grp . end.
      371     end.
      372     for each ub.price-list-type-gds-grp exclusive-lock where
      373              ub.price-list-type-gds-grp.plt-db-num  = p-db-num and
      374              ub.price-list-type-gds-grp.plt-id      = p-id :
      375          if not can-find (first  tt_grp where tt_grp.node-code = ub.price-list-type-gds-grp.node-code ) then
      376          ub.price-list-type-gds-grp.stts   = integer('1':U) .
      377     end.
      378     for each tt_grp :
      379         find first  ub.price-list-type-gds-grp exclusive-lock where
      380                 ub.price-list-type-gds-grp.node-code  = tt_grp.node-code and
      381                 ub.price-list-type-gds-grp.plt-db-num  = p-db-num and
      382                 ub.price-list-type-gds-grp.plt-id      = p-id no-error .
      383         if not available ub.price-list-type-gds-grp then do:
      384                create ub.price-list-type-gds-grp.
      385                 assign
      386                   ub.price-list-type-gds-grp.node-code  = tt_grp.node-code
      387                   ub.price-list-type-gds-grp.plt-db-num     = p-db-num
      388                   ub.price-list-type-gds-grp.plt-id         = p-id
      389                   ub.price-list-type-gds-grp.stts       = integer('0':U)
      390                   ub.price-list-type-gds-grp.sys-date     = today
      391                   ub.price-list-type-gds-grp.sys-time     = time
      392                   ub.price-list-type-gds-grp.sys-time-chr = string ( ub.price-list-type-gds-grp.sys-time,"hh:mm" )
      393                   ub.price-list-type-gds-grp.who          = p-userid
      394                   ub.price-list-type-gds-grp.db-num-chg   = p-db-num-usr
      395                 .
      396                end.
      397         else do:
      398            assign
      399             ub.price-list-type-gds-grp.stts   = integer('0':U)
      400             ub.price-list-type-gds-grp.sys-date     = today
      401             ub.price-list-type-gds-grp.sys-time     = time
      402             ub.price-list-type-gds-grp.sys-time-chr = string ( ub.price-list-type-gds-grp.sys-time,"hh:mm" )
      403             ub.price-list-type-gds-grp.who          = p-userid
      404             ub.price-list-type-gds-grp.db-num-chg   = p-db-num-usr
      405            .
      406         end.
      407     end.
      408     for each ub.price-list-type-cassa exclusive-lock where
      409              ub.price-list-type-cassa.plt-db-num  = p-db-num and
      410              ub.price-list-type-cassa.plt-id      = p-id :
      411          if not can-find (first tt_cassa where
      412                                 tt_cassa.cash-num = ub.price-list-type-cassa.cash-num and
      413                                 tt_cassa.obj-code = ub.price-list-type-cassa.obj-code and
      414                                 tt_cassa.pos-type = ub.price-list-type-cassa.pos-type
      415                                 ) then
      416          ub.price-list-type-cassa.stts   = integer('1':U)  .
      417     end.
      418     for each tt_cassa :
      419         find first  ub.price-list-type-cassa exclusive-lock where
      420                     ub.price-list-type-cassa.cash-num = tt_cassa.cash-num and
      421                     ub.price-list-type-cassa.obj-code = tt_cassa.obj-code and
      422                     ub.price-list-type-cassa.pos-type = tt_cassa.pos-type and
      423                     ub.price-list-type-cassa.plt-db-num        = p-db-num and
      424                     ub.price-list-type-cassa.plt-id            = p-id     no-error .
      425         if not available ub.price-list-type-cassa then do :
      426                create ub.price-list-type-cassa.
      427                 assign
      428                   ub.price-list-type-cassa.cash-num     = tt_cassa.cash-num
      429                   ub.price-list-type-cassa.obj-code     = tt_cassa.obj-code
      430                   ub.price-list-type-cassa.pos-type     = tt_cassa.pos-type
      431                   ub.price-list-type-cassa.plt-db-num   = p-db-num
      432                   ub.price-list-type-cassa.plt-id       = p-id
      433                   ub.price-list-type-cassa.stts         = integer('0':U)
      434                   ub.price-list-type-cassa.sys-date     = today
      435                   ub.price-list-type-cassa.sys-time     = time
      436                   ub.price-list-type-cassa.sys-time-chr = string ( ub.price-list-type-cassa.sys-time,"hh:mm" )
      437                   ub.price-list-type-cassa.who          = p-userid
      438                   ub.price-list-type-cassa.db-num-chg   = p-db-num-usr
      439                   ub.price-list-type-cassa.db-num       = p-db-num-usr
      440                 .
      441                end.
      442         else do:
      443            assign
      444             ub.price-list-type-cassa.stts   = integer('0':U)
      445             ub.price-list-type-cassa.sys-date     = today
      446             ub.price-list-type-cassa.sys-time     = time
      447             ub.price-list-type-cassa.sys-time-chr = string ( ub.price-list-type-cassa.sys-time,"hh:mm" )
      448             ub.price-list-type-cassa.who          = p-userid
      449             ub.price-list-type-cassa.db-num-chg   = p-db-num-usr
      450            .
      451         end.
      452     end.
      453     for each ub.price-list-type-pay-type exclusive-lock where
      454              ub.price-list-type-pay-type.plt-db-num  = p-db-num and
      455              ub.price-list-type-pay-type.plt-id      = p-id :
      456          if not can-find (first tt_pay-type where
      457                                 tt_pay-type.pay-code = ub.price-list-type-pay-type.pay-code
      458                                 ) then
      459          ub.price-list-type-pay-type.stts   = integer('1':U)  .
      460     end.
      461     for each tt_pay-type :
      462         find first  ub.price-list-type-pay-type exclusive-lock where
      463                     ub.price-list-type-pay-type.pay-code = tt_pay-type.pay-code and
      464                     ub.price-list-type-pay-type.plt-db-num        = p-db-num and
      465                     ub.price-list-type-pay-type.plt-id            = p-id     no-error .
      466         if not available ub.price-list-type-pay-type then do :
      467                create ub.price-list-type-pay-type.
      468                 assign
      469                   ub.price-list-type-pay-type.pay-code     = tt_pay-type.pay-code
      470                   ub.price-list-type-pay-type.plt-db-num   = p-db-num
      471                   ub.price-list-type-pay-type.plt-id       = p-id
      472                   ub.price-list-type-pay-type.stts         = integer('0':U)
      473                   ub.price-list-type-pay-type.sys-date     = today
      474                   ub.price-list-type-pay-type.sys-time     = time
      475                   ub.price-list-type-pay-type.sys-time-chr = string ( ub.price-list-type-pay-type.sys-time,"hh:mm" )
      476                   ub.price-list-type-pay-type.who          = p-userid
      477                   ub.price-list-type-pay-type.db-num-chg   = p-db-num-usr
      478                   ub.price-list-type-pay-type.db-num       = p-db-num-usr
      479                 .
      480                end.
      481         else do:
      482            assign
      483             ub.price-list-type-pay-type.stts   = integer('0':U)
      484             ub.price-list-type-pay-type.sys-date     = today
      485             ub.price-list-type-pay-type.sys-time     = time
      486             ub.price-list-type-pay-type.sys-time-chr = string ( ub.price-list-type-pay-type.sys-time,"hh:mm" )
      487             ub.price-list-type-pay-type.who          = p-userid
      488             ub.price-list-type-pay-type.db-num-chg   = p-db-num-usr
      489            .
      490         end.
      491     end.
      492     for each ub.price-list-type-cash-pay exclusive-lock where
      493              ub.price-list-type-cash-pay.plt-db-num  = p-db-num and
      494              ub.price-list-type-cash-pay.plt-id      = p-id :
      495          if not can-find (first tt_cash-pay where
      496                                 tt_cash-pay.cdpay-code = ub.price-list-type-cash-pay.cdpay-code and
      497                                 tt_cash-pay.curr-code  = ub.price-list-type-cash-pay.curr-code
      498                                 ) then
      499          ub.price-list-type-cash-pay.stts   = 1 .
      500     end.
      501     for each tt_cash-pay :
      502         find first  ub.price-list-type-cash-pay exclusive-lock where
      503                     ub.price-list-type-cash-pay.cdpay-code = tt_cash-pay.cdpay-code and
      504                     ub.price-list-type-cash-pay.curr-code  = tt_cash-pay.curr-code and
      505                     ub.price-list-type-cash-pay.plt-db-num        = p-db-num and
      506                     ub.price-list-type-cash-pay.plt-id            = p-id     no-error .
      507         if not available ub.price-list-type-cash-pay then do :
      508                create ub.price-list-type-cash-pay.
      509                 assign
      510                   ub.price-list-type-cash-pay.cdpay-code     = tt_cash-pay.cdpay-code
      511                   ub.price-list-type-cash-pay.curr-code     = tt_cash-pay.curr-code
      512                   ub.price-list-type-cash-pay.plt-db-num   = p-db-num
      513                   ub.price-list-type-cash-pay.plt-id       = p-id
      514                   ub.price-list-type-cash-pay.stts         = integer('0':U)
      515                   ub.price-list-type-cash-pay.sys-date     = today
      516                   ub.price-list-type-cash-pay.sys-time     = time
      517                   ub.price-list-type-cash-pay.sys-time-chr = string ( ub.price-list-type-cash-pay.sys-time,"hh:mm" )
      518                   ub.price-list-type-cash-pay.who          = p-userid
      519                   ub.price-list-type-cash-pay.db-num-chg   = p-db-num-usr
      520                   ub.price-list-type-cash-pay.db-num       = p-db-num-usr
      521                 .
      522                end.
      523         else do:
      524            assign
      525             ub.price-list-type-cash-pay.stts   = integer('0':U)
      526             ub.price-list-type-cash-pay.sys-date     = today
      527             ub.price-list-type-cash-pay.sys-time     = time
      528             ub.price-list-type-cash-pay.sys-time-chr = string ( ub.price-list-type-cash-pay.sys-time,"hh:mm" )
      529             ub.price-list-type-cash-pay.who          = p-userid
      530             ub.price-list-type-cash-pay.db-num-chg   = p-db-num-usr
      531            .
      532         end.
      533     end.
      534     end.
      535   end procedure.
      536   PROCEDURE type-price-list-delete :
      537   define input  parameter p-db-num       as integer   no-undo .
      538   define input  parameter p-id           as integer   no-undo .
      539   define input  parameter p-db-num-usr   as integer   no-undo .
      540   define input  parameter p-userid       as character no-undo .
      541   define buffer child_price-list-type for ub.price-list-type  .
      542     do
      543     on error undo, return error return-value
      544     :
      545   find first ub.price-list-type exclusive-lock where
      546           ub.price-list-type.plt-db-num   = p-db-num  and
      547           ub.price-list-type.plt-id       = p-id
      548           no-error .
      549    if not available ub.price-list-type then  return error .
      550    if ub.price-list-type.ban-discnt > 0 then do:
      551    define buffer buf_dis-rule for ub.dis-rule  .
      552    find first buf_dis-rule no-lock where
      553               buf_dis-rule.templ-rl-root = ub.price-list-type.ban-discnt and
      554               buf_dis-rule.charkey_one   = substitute("&1-&2", ub.price-list-type.plt-id, ub.price-list-type.plt-db-num)
      555               no-error .
      556        if available buf_dis-rule then do:
      557           message  substitute
      558             ( "Удалить этот тип нельзя, так как есть ссылка на ПРАВИЛО СКИДОК &1 &2" ,
      559                ub.price-list-type.ban-discnt  ,
      560                buf_dis-rule.des
      561               ) view-as alert-box error .
      562           return .
      563        end.
      564    end.
      565    find first ub.price-doc-forming no-lock where
      566               ub.price-doc-forming.plt-id = ub.price-list-type.plt-id and
      567               ub.price-doc-forming.plt-db-num = ub.price-list-type.plt-db-num and
      568               ub.price-doc-forming.stts = integer('0':U) no-error .
      569    if available ub.price-doc-forming then do:
      570           message "Удалить этот тип нельзя, так как есть незакрытые ДНЦ " ub.price-doc-forming.pdf-id "БД:" ub.price-doc-forming.pdf-db
      571           view-as alert-box error .
      572           return .
      573    end.
      574         assign
      575           ub.price-list-type.db-num-chg    = p-db-num-usr
      576           ub.price-list-type.stts          = integer('1':U)
      577           ub.price-list-type.sys-date      = today
      578           ub.price-list-type.sys-time      = time
      579           ub.price-list-type.sys-time-chr  = string ( ub.price-list-type.sys-time,"hh:mm" )
      580           ub.price-list-type.who           = p-userid
      581         .
      582         for each child_price-list-type exclusive-lock where
      583                  child_price-list-type.plt-main-db-num = p-db-num  and
      584                  child_price-list-type.plt-main-id     = p-id
      585                  :
      586               assign
      587                 child_price-list-type.db-num-chg    = p-db-num-usr
      588                 child_price-list-type.stts          = integer('1':U)
      589                 child_price-list-type.sys-date      = today
      590                 child_price-list-type.sys-time      = time
      591                 child_price-list-type.sys-time-chr  = string ( child_price-list-type.sys-time , "hh:mm" )
      592                 child_price-list-type.who           = p-userid
      593               .
      594         end.
      595     end.
      596   end procedure.
      597   function diff-list returns character (
      598     input parfirst-list  as character,
      599     input parsecond-list as character,
      600     input pardelim       as character).
      601     if pardelim = ""
      602     or pardelim = ?
      603     then do:
      604       assign
      605         pardelim = ","
      606       .
      607     end.
      608     def var ind as integer no-undo .
      609     def var v-elem as character no-undo .
      610     def var v-result-list as character no-undo init "".
      611     def var v-num-parfirst-list as integer no-undo .
      612     assign
      613       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      614     .
      615     do ind = 1 to v-num-parfirst-list
      616     :
      617       assign
      618         v-elem = entry(ind, parfirst-list, pardelim)
      619       .
      620       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      621         assign
      622           v-result-list = v-result-list
      623                         + (if v-result-list > "" then pardelim else "")
      624                         + v-elem
      625         .
      626       end.
      627     end.
      628     return v-result-list .
      629   end function.
      630   function add-list returns character (
      631    input parfirst-list  as character,
      632    input parsecond-list as character,
      633    input pardelim       as character).
      634     if pardelim = ""
      635     or pardelim = ?
      636     then do:
      637       assign
      638         pardelim = ","
      639       .
      640     end.
      641     def var ind as integer no-undo .
      642     def var v-elem as character no-undo .
      643     def var v-result-list as character no-undo init "".
      644     def var v-num-parfirst-list as integer no-undo .
      645     assign
      646       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      647     .
      648     do ind = 1 to v-num-parfirst-list
      649     :
      650       assign
      651         v-elem = entry(ind, parfirst-list, pardelim)
      652       .
      653       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      654         assign
      655           v-result-list = v-result-list
      656                         + (if v-result-list > "" then pardelim else "")
      657                         + v-elem
      658         .
      659       end.
      660     end.
      661     def var v-num-parsecond-list as integer no-undo .
      662     assign
      663       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      664     .
      665     do ind = 1 to v-num-parsecond-list
      666     :
      667       assign
      668         v-elem = entry(ind, parsecond-list, pardelim)
      669       .
      670       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      671         assign
      672           v-result-list = v-result-list
      673                         + (if v-result-list > "" then pardelim else "")
      674                         + v-elem
      675         .
      676       end.
      677     end.
      678     return v-result-list .
      679   end function.
      680   function cross-list returns character (
      681    input parfirst-list  as character,
      682    input parsecond-list as character,
      683    input pardelim       as character).
      684     if pardelim = ""
      685     or pardelim = ?
      686     then do:
      687       assign
      688         pardelim = ","
      689       .
      690     end.
      691     def var ind as integer no-undo .
      692     def var v-elem as character no-undo .
      693     def var v-result-list as character no-undo init "".
      694     def var v-num-parfirst-list as integer no-undo .
      695     assign
      696       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      697     .
      698     do ind = 1 to v-num-parfirst-list
      699     :
      700       assign
      701         v-elem = entry(ind, parfirst-list, pardelim)
      702       .
      703       if lookup(v-elem, v-result-list, pardelim) = 0
      704       and lookup(v-elem, parsecond-list, pardelim) > 0
      705       then do:
      706         assign
      707           v-result-list = v-result-list
      708                         + (if v-result-list > "" then pardelim else "")
      709                         + v-elem
      710         .
      711       end.
      712     end.
      713     return v-result-list .
      714   end function.
      715   function radio-label returns character (
      716    input par-rs-value  as character,
      717    input par-rs-radio-buttons as character)
      718    .
      719    DEFINE variable v-result-label as character no-undo.
      720    assign
      721    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      722                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      723                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      724                             ), par-rs-radio-buttons
      725                           )
      726    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      727    .
      728   return v-result-label.
      729   end function.
      730   function m-radio-label returns character (
      731    input par-rs-value  as character,
      732    input par-rs-radio-buttons as character,
      733    input par-delim as character
      734    )
      735    .
      736    DEFINE variable v-result-label as character no-undo.
      737    assign
      738    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      739                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      740                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      741                             ), par-rs-radio-buttons, par-delim
      742                           )
      743    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      744    .
      745   return v-result-label.
      746   end function.
      747   FUNCTION mixlist returns character
      748   (
      749    input parfirst-list  as character
      750    ,input parsecond-list as character
      751    ,input pardelim       as character
      752    ,input pardelim-result as character ) :
      753     if pardelim = ""
      754     or pardelim = ?
      755     then do:
      756       assign
      757         pardelim = ","
      758       .
      759     end.
      760     def var ind as integer no-undo .
      761     def var v-elem1 as character no-undo .
      762     def var v-elem2 as character no-undo .
      763     def var v-result-list as character no-undo init "".
      764     do ind = 1 to num-entries(parfirst-list, pardelim)
      765     :
      766       assign
      767         v-elem1 = entry(ind, parfirst-list, pardelim)
      768         v-elem2 = entry(ind, parsecond-list, pardelim)
      769       .
      770         assign
      771           v-result-list = v-result-list
      772                         + (if v-result-list > "" then pardelim-result else "")
      773                         + v-elem1 + pardelim-result + v-elem2
      774         .
      775     end.
      776     return v-result-list .
      777   END FUNCTION.
      778   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      779   define temp-table x_obj-group no-undo like ub.clients  .
      780   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
      781   procedure metod-gop-obj :
      782     do
      783     on error undo, return error return-value
      784     :
      785   define input  parameter p-cntxt-db-num as integer   no-undo .
      786   define input  parameter p-gop-id       as integer   no-undo .
      787   define input  parameter p-gop-db-num   as integer   no-undo .
      788   define buffer buf1_clients for ub.clients  .
      789   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
      790   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
      791   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
      792   for each  x_obj-group : delete x_obj-group. end.
      793   if p-gop-id = 0 or p-gop-id = ?  then do:
      794      if p-cntxt-db-num = 0  then do:
      795           for each buf1_clients no-lock where
      796                   (buf1_clients.obj-type = 'маг':U  or
      797                    buf1_clients.obj-type = 'скл':U  )
      798                   and
      799                   buf1_clients.db-num >= 0  and
      800                   buf1_clients.stts = 0
      801                   :
      802             create x_obj-group .
      803             assign
      804               x_obj-group.obj-code   = buf1_clients.obj-code
      805               x_obj-group.obj-type   = buf1_clients.obj-type
      806               x_obj-group.obj-name   = buf1_clients.obj-name
      807               x_obj-group.db-num     = buf1_clients.db-num
      808             .
      809           end.
      810      end.
      811      else do:
      812           for each buf1_clients no-lock where
      813                   (buf1_clients.obj-type = 'маг':U  or
      814                    buf1_clients.obj-type = 'скл':U  ) and
      815                    buf1_clients.db-num = p-cntxt-db-num  and
      816                    buf1_clients.stts = 0
      817                   :
      818             create x_obj-group .
      819             assign
      820               x_obj-group.obj-code   = buf1_clients.obj-code
      821               x_obj-group.obj-type   = buf1_clients.obj-type
      822               x_obj-group.obj-name   = buf1_clients.obj-name
      823               x_obj-group.db-num     = buf1_clients.db-num
      824             .
      825           end.
      826      end.
      827   end.
      828   else do:
      829         for each buf_db-grp-obj-price  where
      830                 buf_db-grp-obj-price.gop-id     = p-gop-id and
      831                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
      832                 buf_db-grp-obj-price.stts = 0  no-lock :
      833           for each buf1_clients no-lock where
      834                  (buf1_clients.obj-type = 'маг':U  or
      835                   buf1_clients.obj-type = 'скл':U  ) and
      836                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
      837                   buf1_clients.stts = 0
      838                   :
      839             create x_obj-group .
      840             assign
      841               x_obj-group.obj-code   = buf1_clients.obj-code
      842               x_obj-group.obj-type   = buf1_clients.obj-type
      843               x_obj-group.obj-name   = buf1_clients.obj-name
      844               x_obj-group.db-num     = buf1_clients.db-num
      845             .
      846           end.
      847         end.
      848       for each buf_host-grp-obj-price where
      849               buf_host-grp-obj-price.gop-id     = p-gop-id and
      850               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
      851               buf_host-grp-obj-price.stts = 0
      852               no-lock :
      853         for each buf1_clients no-lock where
      854                (buf1_clients.obj-type = 'маг':U  or
      855                 buf1_clients.obj-type = 'скл':U  ) and
      856                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
      857                 buf1_clients.stts = 0
      858                 :
      859             find first x_obj-group no-lock  where
      860                       x_obj-group.obj-code   = buf1_clients.obj-code and
      861                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      862             if not available  x_obj-group then   create x_obj-group .
      863             assign
      864               x_obj-group.obj-code   = buf1_clients.obj-code
      865               x_obj-group.obj-type   = buf1_clients.obj-type
      866               x_obj-group.obj-name   = buf1_clients.obj-name
      867               x_obj-group.db-num     = buf1_clients.db-num
      868             .
      869         end.
      870       end.
      871       for each buf_obj-grp-obj-price where
      872               buf_obj-grp-obj-price.gop-id     = p-gop-id and
      873               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
      874               buf_obj-grp-obj-price.stts = 0
      875               no-lock :
      876         for each buf1_clients no-lock where
      877                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
      878                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
      879                   buf1_clients.stts     = 0
      880                   :
      881             find first  x_obj-group no-lock  where
      882                         x_obj-group.obj-code   = buf1_clients.obj-code and
      883                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      884             if not available  x_obj-group then   create x_obj-group .
      885             assign
      886               x_obj-group.obj-code   = buf1_clients.obj-code
      887               x_obj-group.obj-type   = buf1_clients.obj-type
      888               x_obj-group.obj-name   = buf1_clients.obj-name
      889               x_obj-group.db-num     = buf1_clients.db-num
      890             .
      891         end.
      892       end.
      893   end.
      894   end.
      895   end procedure.
      896   procedure metod-obj-in-gop :
      897   define input  parameter p-curr-db-num as integer   no-undo .
      898   define input  parameter p-obj-type as character no-undo .
      899   define input  parameter p-obj-code as integer   no-undo .
      900   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      901     do
      902     on error undo, return error return-value
      903     :
      904       empty temp-table x_grp-obj-price.
      905       for each buf_grp-obj-price where
      906                buf_grp-obj-price.stts = 0
      907                no-lock :
      908                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
      909                  for each x_obj-group where
      910                           x_obj-group.obj-type = p-obj-type and
      911                           x_obj-group.obj-code = p-obj-code :
      912                       create  x_grp-obj-price.
      913                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
      914                  end.
      915       end.
      916     end.
      917   end procedure.
      918   procedure metod-delobj-usr :
      919   define input  parameter p-pdf-id  as integer   no-undo .
      920   define input  parameter p-pdf-db  as integer   no-undo .
      921   define input  parameter p-plt-id  as integer   no-undo .
      922   define input  parameter p-plt-db-num as integer   no-undo .
      923   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      924     do
      925     on error undo, return error return-value
      926     :
      927   for each buf_price-doc-forming-attr no-lock  where
      928            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
      929            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
      930            buf_price-doc-forming-attr.plt-id =     p-plt-id and
      931            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
      932            buf_price-doc-forming-attr.attr-code begins "obj" :
      933      for each x_obj-group  where
      934               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
      935               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
      936        delete x_obj-group.
      937      end.
      938   end.
      939     if not can-find (first x_obj-group) then do:
      940        return "nullobj" .
      941     end.
      942   end.
      943   end procedure.
      944   procedure metod-obj-pdf :
      945   define input  parameter p-cntxt-db-num as integer   no-undo .
      946   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
      947   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
      948   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
      949   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
      950   define buffer buf_price-list-type for ub.price-list-type  .
      951   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      952     do
      953     on error undo, return error return-value
      954     :
      955    for each  x_obj-group : delete x_obj-group. end.
      956    find first buf_price-list-type no-lock where
      957               buf_price-list-type.plt-id = p-plt-id and
      958               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
      959   if error-status :error then return error return-value .
      960    find first buf_price-doc-forming no-lock where
      961               buf_price-doc-forming.plt-id     = p-plt-id and
      962               buf_price-doc-forming.plt-db-num = p-plt-db-num and
      963               buf_price-doc-forming.pdf-id     = p-pdf-id and
      964               buf_price-doc-forming.pdf-db     = p-pdf-db-num
      965               no-error .
      966   if error-status :error then return error return-value .
      967     run metod-gop-obj in this-procedure (
      968         p-cntxt-db-num,
      969         buf_price-list-type.gop-id ,
      970         buf_price-list-type.gop-db-num
      971         ) no-error .
      972     run metod-delobj-usr in this-procedure (
      973       buf_price-doc-forming.pdf-id ,
      974       buf_price-doc-forming.pdf-db ,
      975       buf_price-doc-forming.plt-id ,
      976       buf_price-doc-forming.plt-db-num
      977       ) no-error .
      978     end.
      979   end procedure.
      980   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      981   define variable v-waitfram-action01         as character   no-undo .
      982   define variable v-waitfram-action02         as character   no-undo .
      983   define variable v-waitfram-action03         as character   no-undo .
      984   define variable mWaitFramTextBeg            as character   no-undo.
      985   define variable mWaitFramTextEnd            as character   no-undo.
      986   define variable mWaitFramView               as logical     no-undo.
      987   define variable mWaitProcEvent              as logical     no-undo init yes.
      988   define variable mWaitFramInterval           as integer     no-undo init 1 .
      989   define variable mWaitFramStop               as logical     no-undo.
      990   define variable mWaitFramStopUser           as logical     no-undo.
      991   define variable mWaitFramStopTimeOut        as logical     no-undo.
      992   define variable mWaitFramStartProc          as datetime-tz no-undo.
      993   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      994   define button B-WaitFramStop auto-end-key
      995        label "Стоп"
      996        size 10 by 1 tooltip "Остоновить процесс".
      997   define button B-viewProcInfo
      998        label "Информация"
      999        size 15 by 1 tooltip "Информация о процесс".
     1000   define frame waitfram
     1001     v-waitfram-action01 format "x(72)" no-label skip
     1002     v-waitfram-action02 format "x(72)" no-label skip
     1003     v-waitfram-action03 format "x(72)" no-label skip
     1004     B-viewProcInfo
     1005     B-WaitFramStop at row 4 col 30
     1006     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1007     .
     1008   define new global shared variable mBatchMode as logical no-undo init ?.
     1009   define variable mFramBachModHandle as handle no-undo.
     1010   mFramBachModHandle = frame waitfram:handle.
     1011   define variable mFameOldVis as logical no-undo.
     1012   define variable mVisCUrentVin as logical no-undo.
     1013   if session:batch-mode
     1014   then
     1015      mBatchMode = yes.
     1016   if mBatchMode = ? then do:
     1017     mVisCUrentVin = current-window:visible.
     1018     mFameOldVis = mFramBachModHandle:visible.
     1019     mFramBachModHandle:visible  = yes.
     1020     mBatchMode = mFramBachModHandle:visible ne yes.
     1021     mFramBachModHandle:visible = mFameOldVis.
     1022     current-window:visible = mVisCUrentVin.
     1023   end.
     1024    if  log-manager:logfile-name ne ?
     1025     then DO:
     1026         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1027         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1028         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1029     end.
     1030   on choose of B-WaitFramStop in frame waitfram
     1031   do:
     1032     mWaitFramStop = yes.
     1033     mWaitFramStopUser = yes.
     1034   end.
     1035   function waitfram-check-timeout returns logical():
     1036      define variable vtime as int64 no-undo.
     1037      if mWaitFramStopTimeOut
     1038      then
     1039         return yes.
     1040      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1041      if     mWaitFramTimeOut ne ?
     1042         and mWaitFramTimeOut ne 0
     1043         and mWaitFramTimeOut lt vtime
     1044      then do:
     1045         mWaitFramStopTimeOut = yes.
     1046      end.
     1047      return mWaitFramStopTimeOut.
     1048   end.
     1049   procedure waitfram-hide :
     1050     if not session:batch-mode
     1051     then do
     1052     on error undo, return error return-value
     1053     :
     1054       pause 0 before-hide .
     1055       if not mBatchMode then
     1056         hide frame waitfram .
     1057     if     not mWaitFramView
     1058        and mWaitProcEvent
     1059     then
     1060       process events .
     1061     end.
     1062   end procedure.
     1063   procedure waitfram-show :
     1064     define input  parameter p-message as character no-undo .
     1065     define variable v-left-margin as integer   no-undo .
     1066     if not session:batch-mode
     1067     then do
     1068     on error undo, return error return-value
     1069     :
     1070       if length(p-message) <= 70 then do:
     1071         assign
     1072           v-left-margin = integer((70 - length(p-message)) / 2)
     1073         .
     1074         assign
     1075           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1076         .
     1077         assign
     1078           v-waitfram-action01 = " "
     1079           v-waitfram-action02 = " "
     1080                                    + fill(" ", v-left-margin)
     1081                                    + p-message
     1082           v-waitfram-action03 = " "
     1083         .
     1084       end.
     1085       else do:
     1086         define variable vRindex1 as integer no-undo.
     1087         define variable vRindex2 as integer no-undo.
     1088         vRindex1 = r-index(p-message," ",70).
     1089         if vRindex1 = 0
     1090         then
     1091            vRindex1 = 70.
     1092         if length(p-message)  <= vRindex1 + 70 then do:
     1093           assign
     1094             v-waitfram-action01 = " "
     1095             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1096             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1097           .
     1098         end.
     1099         else do:
     1100           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1101           if vRindex2 <= vRindex1
     1102           then
     1103              vRindex2 = vRindex1 + 70.
     1104           assign
     1105             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1106             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1107             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1108           .
     1109         end.
     1110       end.
     1111       B-viewProcInfo:visible   in frame waitfram = no.
     1112       B-viewProcInfo:sensitive in frame waitfram = no.
     1113       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1114       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1115       if  (   mWaitFramView
     1116          or  mWaitProcEvent)
     1117          and not mBatchMode
     1118       then
     1119          display
     1120             v-waitfram-action01 skip
     1121             v-waitfram-action02 skip
     1122             v-waitfram-action03 skip
     1123          with frame waitfram .
     1124       if     mWaitFramView
     1125          then do:
     1126             if     mWaitFramInterval ne ?
     1127                and not mBatchMode
     1128             then
     1129                wait-for go of frame waitfram pause mWaitFramInterval.
     1130          end.
     1131          else
     1132             if     mWaitProcEvent
     1133                and not mBatchMode
     1134             then
     1135                process events .
     1136     end.
     1137   end procedure.
     1138      procedure waitfram-show-this:
     1139         define input  parameter iInterval as int64 no-undo.
     1140         define variable vtime as int64 no-undo.
     1141         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1142         mWaitFramInterval = iInterval.
     1143         run waitfram-show (substitute("&1&2 &3&4" ,
     1144                                       mWaitFramTextBeg ,
     1145                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1146                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1147                                       mWaitFramTextEnd
     1148                                      )
     1149                           ).
     1150      end.
     1151      procedure WaitFramRunPause:
     1152         define input  parameter iInterval as dec no-undo.
     1153         define variable vStart  as datetime-tz no-undo.
     1154         define variable vend    as datetime-tz no-undo.
     1155         define variable vint as int64 no-undo.
     1156         define variable vOk as logical no-undo.
     1157         vStart = now.
     1158         vend   = vStart.
     1159         publish "WaitFramPause" (iInterval,output vOk).
     1160         vend   =  now.
     1161         vint = vend - vStart.
     1162         vint = iInterval - vint / 1000.
     1163         if     not mWaitFramStop
     1164            and (   vint > 0
     1165                 or (    not vOk
     1166                     and iInterval eq ?
     1167                     )
     1168                 )
     1169         then
     1170            run waitfram-show-this (iInterval).
     1171         vend   =  now.
     1172         vint = vend - vStart.
     1173         vint = iInterval - vint / 1000.
     1174         if     not mWaitFramStop
     1175            and vint > 0
     1176         then do:
     1177            run gbl/pause.p (vint * 1000).
     1178         end.
     1179         if iInterval ne ?
     1180         then
     1181            publish "WaitFramStop".
     1182         waitfram-check-timeout().
     1183      end.
     1184      procedure WaitFramWaitFor:
     1185         define input  parameter iInterval as dec no-undo.
     1186         assign
     1187            mWaitFramStartProc   = now
     1188            mWaitFramStopUser    = no
     1189            mWaitFramStopTimeOut = no
     1190         .
     1191         block-wait:
     1192         do while not mWaitFramStop:
     1193            run WaitFramRunPause (iInterval).
     1194            if  waitfram-check-timeout()
     1195            then do:
     1196               leave block-wait.
     1197            end.
     1198         end.
     1199         run waitfram-hide.
     1200      end.
     1201   procedure waitfram-join :
     1202     define input  parameter p-line-1  as character no-undo .
     1203     define input  parameter p-line-2  as character no-undo .
     1204     define input  parameter p-line-3  as character no-undo .
     1205     define output parameter p-message as character no-undo .
     1206     do
     1207     on error undo, return error return-value
     1208     :
     1209       assign
     1210         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1211                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1212                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1213       .
     1214     end.
     1215   end procedure.
     1216   function waitfram-join-function returns character
     1217     (input p-line-1 as character
     1218     ,input p-line-2 as character
     1219     ,input p-line-3 as character
     1220     ).
     1221     define variable v-message as character no-undo .
     1222     run waitfram-join in this-procedure
     1223       (input  p-line-1
     1224       ,input  p-line-2
     1225       ,input  p-line-3
     1226       ,output v-message
     1227       ) .
     1228     return v-message .
     1229   end function .
