     2840   procedure get-context :
     2841      define output parameter p-db-num as integer          no-undo.
     2842      define output parameter p-user-id as character        no-undo.
     2843      define variable v-login               as character    no-undo.
     2844      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2845      define buffer buf_user-login  for ub.user-login .
     2846      do
     2847      on error undo, return error
     2848      :
     2849            FIND FIRST buf_sys-ctrl no-lock.
     2850            ASSIGN
     2851               v-login = USERID("ub")
     2852               p-db-num = buf_sys-ctrl.db-num
     2853            .
     2854            FIND FIRST buf_user-login
     2855                 WHERE buf_user-login.db-num = p-db-num
     2856                   AND buf_user-login.user-login = v-login
     2857                 no-lock
     2858                 no-error
     2859                 .
     2860            IF AVAILABLE buf_user-login
     2861            THEN DO:
     2862               assign
     2863                  p-user-id = buf_user-login.user-id
     2864               .
     2865            END.
     2866      end.
     2867   end procedure.
