     3258   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3259   DEF VAR cur-clmn-numbr-c-sert as INT EXTENT 9 no-undo.
     3260   DEF VAR varmvibr-c-sert       as INT no-undo.
     3261   DEF VAR varmvjbr-c-sert       as INT no-undo.
     3262   DEF VAR varmvkbr-c-sert       as INT no-undo.
     3263   DEF VAR varmvlbr-c-sert       as INT no-undo.
     3264   DEF VAR move-elementbr-c-sert as INT no-undo.
     3265   def var jjbr-c-sert           as int no-undo.
     3266   do varmvibr-c-sert = 1 to EXTENT(cur-clmn-numbr-c-sert):
