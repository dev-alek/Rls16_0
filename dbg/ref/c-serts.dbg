      860   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      861   procedure fltopend_fltopend :
      862   define input parameter p-parent-handle as handle no-undo .
      863   define input parameter p-qh as handle no-undo .
      864   define input parameter p-flt-open-open-query  as character no-undo .
      865   define input parameter p-where-cond as character no-undo .
      866   define input parameter p-use-indFIRST-query-tail as character no-undo .
      867   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      868   define input parameter p-indexed-reposition as character no-undo .
      869     do
      870     on error undo, return error
      871     :
      872   define variable v-prepare-string as character no-undo .
      873   define variable glog as logical no-undo .
      874   assign
      875   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      876                      p-where-cond + chr(32)  +
      877                      p-use-indFIRST-query-tail + chr(32) +
      878                      p-use-ind-sort-clmn-by + chr(32) +
      879                      p-indexed-reposition
      880   .
      881   assign
      882   glog = p-qh:query-prepare(v-prepare-string) no-error .
      883   if not glog
      884   or error-status:error then do:
      885     message error-status:get-message(1) view-as alert-box .
      886     undo, return error .
      887   end.
      888   assign
      889   glog = p-qh:query-open no-error .
      890   if not glog
      891   or error-status:error then do:
      892     message error-status:get-message(1) view-as alert-box .
      893     undo, return error .
      894   end.
      895     end.
      896   end procedure.
      897   procedure fltopend_fltfindd :
      898   define input parameter p-parent-handle as handle no-undo .
      899   define input parameter p-qh as handle no-undo .
      900   define input parameter p-rowid as rowid no-undo .
      901   define input parameter p-next as logical no-undo .
      902   define input parameter p-lock as integer no-undo .
      903   define input parameter p-bh as handle no-undo .
      904   define input parameter p-where-cond as character no-undo .
      905   define input parameter p-use-index-phrase as character no-undo .
      906   define variable glog as logical no-undo .
      907   define variable v-qh as handle no-undo .
      908   define variable v-bh as handle no-undo .
      909   define variable v-recid as recid no-undo .
      910   define variable v-prepare-string as character no-undo .
      911   do
      912   on error undo, return error
      913   on stop undo, return error
      914   :
      915     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      916     create buffer v-bh for table p-bh buffer-name p-bh:name.
      917     create query v-qh.
      918     v-qh:set-buffers(v-bh).
      919     v-prepare-string = substitute("for each &1 &2 &3"
      920                                     ,v-bh:name
      921                                     ,p-where-cond
      922                                     ,p-use-index-phrase).
      923     glog = v-qh:query-prepare(v-prepare-string) no-error.
      924     if not glog then do:
      925       delete object v-qh.
      926       delete object v-bh.
      927       undo, return error .
      928     end.
      929     glog = v-qh:query-open no-error .
      930     if not glog then do:
      931       delete object v-qh.
      932       delete object v-bh.
      933       undo, return error .
      934     end.
      935     if p-next then do:
      936       v-qh:reposition-to-rowid(p-rowid) no-error .
      937       glog = v-qh:get-next( p-lock) no-error .
      938       glog = v-qh:get-next( p-lock) no-error .
      939       if not glog or v-qh:query-off-end = yes then do:
      940         glog = v-qh:get-first( p-lock) no-error .
      941       end.
      942     end.
      943     else do:
      944       glog = v-qh:get-first( p-lock) no-error .
      945     end.
      946     v-recid = v-bh:recid no-error .
      947     delete object v-qh.
      948     delete object v-bh.
      949     return string(v-recid) .
      950   end.
      951   end procedure.
      952   procedure fltopend_fltfindq :
      953   define input parameter p-parent-handle as handle no-undo .
      954   define input parameter p-qh as handle no-undo .
      955   define input parameter p-next as logical no-undo .
      956   define input parameter p-lock as integer no-undo .
      957   define input parameter p-flt-open-open-query  as character no-undo .
      958   define input parameter p-where-cond as character no-undo .
      959   define input parameter p-use-indFIRST-query-tail as character no-undo .
      960   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      961   define input parameter p-indexed-reposition as character no-undo .
      962   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      963   define variable glog as logical no-undo .
      964   define variable v-qh as handle no-undo .
      965   define variable v-bh as handle no-undo extent 18.
      966   define variable v-rowid as rowid no-undo extent 18.
      967   define variable v-ii as integer no-undo .
      968   define variable v-prepare-string as character no-undo .
      969   do
      970   on error undo, return error
      971   on stop undo, return error
      972   :
      973     create query v-qh.
      974     do v-ii = 1 to p-qh:num-buffers:
      975       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      976       assign
      977       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      978       no-error.
      979       v-qh:add-buffer(v-bh[v-ii]).
      980     end.
      981     assign
      982     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      983                       p-where-cond + chr(32)  +
      984                       p-use-indFIRST-query-tail + chr(32) +
      985                       p-use-ind-sort-clmn-by + chr(32) +
      986                       p-indexed-reposition
      987     .
      988     glog = v-qh:query-prepare( v-prepare-string) no-error .
      989     if not glog then do:
      990       delete object v-qh.
      991       do v-ii = 1 to p-qh:num-buffers:
      992         delete object v-bh[v-ii].
      993       end.
      994       undo, return error .
      995     end.
      996     glog = v-qh:query-open no-error .
      997     if not glog then do:
      998       delete object v-qh.
      999       do v-ii = 1 to p-qh:num-buffers:
     1000         delete object v-bh[v-ii].
     1001       end.
     1002       undo, return error .
     1003     end.
     1004     if p-next then do:
     1005       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1006       glog = v-qh:get-next( p-lock) no-error .
     1007       glog = v-qh:get-next( p-lock) no-error .
     1008       if not glog or v-qh:query-off-end = yes then do:
     1009         glog = v-qh:get-first( p-lock) no-error .
     1010       end.
     1011     end.
     1012     else do:
     1013       glog = v-qh:get-first( p-lock) no-error .
     1014     end.
     1015     do v-ii = 1 to p-qh:num-buffers:
     1016       assign
     1017       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1018       no-error.
     1019     end.
     1020     delete object v-qh.
     1021     do v-ii = 1 to p-qh:num-buffers:
     1022       delete object v-bh[v-ii].
     1023     end.
     1024   end.
     1025   end procedure.
