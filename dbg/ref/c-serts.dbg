     3269   RUN start-mv-clmnbr-c-sert.
     3270   PROCEDURE start-mv-clmnbr-c-sert:
     3271   def var old-session as logical no-undo.
     3272      old-session = SESSION:IMMEDIATE-DISPLAY.
     3273      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3274          IF  p-mode = 'все':U  THEN DO:
     3275      DO jjbr-c-sert = NUM-ENTRIES('9,1,2,3,4,5,6,7,8') TO 1 BY -1:
     3276        RUN re-move-clmnbr-c-sert ( cur-clmn-numbr-c-sert[INTEGER(ENTRY (jjbr-c-sert, '9,1,2,3,4,5,6,7,8'))] , 1).
     3277      END.
     3278          END.
     3279          IF  p-mode <> 'все':U  THEN DO:
     3280      DO jjbr-c-sert = NUM-ENTRIES('1,2,3,4,5,6,7,8,9') TO 1 BY -1:
     3281        RUN re-move-clmnbr-c-sert ( cur-clmn-numbr-c-sert[INTEGER(ENTRY (jjbr-c-sert, '1,2,3,4,5,6,7,8,9'))] , 1).
     3282      END.
     3283          END.
     3284      SESSION:IMMEDIATE-DISPLAY = old-session.
     3285   END.
     3286   ON ctrl-cursor-right OF BROWSE br-c-sert do:
     3287     RUN re-move-clmnbr-c-sert ( 1, 9).
     3288   END.
     3289   ON ctrl-cursor-left OF BROWSE br-c-sert do:
     3290     RUN re-move-clmnbr-c-sert (9, 1).
     3291   END.
     3292   PROCEDURE re-move-clmnbr-c-sert:
     3293     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3294     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3295     DO varmvibr-c-sert = 1 TO EXTENT(cur-clmn-numbr-c-sert):
     3296       if cur-clmn-numbr-c-sert[varmvibr-c-sert] = source-column THEN cur-clmn-numbr-c-sert[varmvibr-c-sert] = -1.
     3297     END.
     3298     if br-c-sert:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3299     if source-column > target-column THEN
     3300     DO varmvjbr-c-sert = source-column - 1 to target-column BY -1:
     3301       DO varmvibr-c-sert = 1 TO EXTENT(cur-clmn-numbr-c-sert):
     3302           if cur-clmn-numbr-c-sert[varmvibr-c-sert] = varmvjbr-c-sert THEN DO:
     3303             cur-clmn-numbr-c-sert[varmvibr-c-sert] = cur-clmn-numbr-c-sert[varmvibr-c-sert] + 1.
     3304           END.
     3305       END.
     3306     END.
     3307     ELSE
     3308     DO varmvjbr-c-sert = source-column + 1 to target-column:
     3309       DO varmvibr-c-sert = 1 TO EXTENT(cur-clmn-numbr-c-sert):
     3310         if cur-clmn-numbr-c-sert[varmvibr-c-sert] = varmvjbr-c-sert THEN DO:
     3311           cur-clmn-numbr-c-sert[varmvibr-c-sert] = cur-clmn-numbr-c-sert[varmvibr-c-sert] - 1.
     3312         END.
     3313       END.
     3314     END.
     3315     DO varmvibr-c-sert = 1 TO EXTENT(cur-clmn-numbr-c-sert):
     3316       if cur-clmn-numbr-c-sert[varmvibr-c-sert] = -1 THEN cur-clmn-numbr-c-sert[varmvibr-c-sert] = target-column.
     3317     END.
     3318   END PROCEDURE.
     3319   PROCEDURE ch-clmnbr-c-sert:
     3320     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3321     if cur-clmn-loc <= 1 then do:
     3322       return .
     3323     end.
     3324     DO varmvibr-c-sert = 1 TO EXTENT(cur-clmn-numbr-c-sert):
     3325       if cur-clmn-numbr-c-sert[varmvibr-c-sert] = cur-clmn-loc THEN move-elementbr-c-sert = varmvibr-c-sert.
     3326     END.
     3327     RUN re-move-clmnbr-c-sert (cur-clmn-loc, 1).
     3328   END PROCEDURE.
     3329   PROCEDURE mv-brw-defaultbr-c-sert:
     3330   def var old-session as logical no-undo.
     3331     old-session = SESSION:IMMEDIATE-DISPLAY.
     3332     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3333     do varmvlbr-c-sert = 1 to EXTENT(cur-clmn-numbr-c-sert):
     3334       RUN re-move-clmnbr-c-sert (cur-clmn-numbr-c-sert[varmvlbr-c-sert], varmvlbr-c-sert).
     3335     END.
     3336     RUN start-mv-clmnbr-c-sert.
     3337     SESSION:IMMEDIATE-DISPLAY = old-session.
     3338   END PROCEDURE.
     3339   .
     3340     run diasize_add_browse in this-procedure
     3341       (input  'width':u
     3342       ,input  browse br-changes :handle
     3343       ) .
     3344     run diasize_init in this-procedure .
     3345     WAIT-FOR GO OF FRAME Dialog-Frame.
     3346   END.
     3347   RUN disable_UI.
     3348   PROCEDURE disable_UI :
     3349     HIDE FRAME Dialog-Frame.
     3350   END PROCEDURE.
     3351   PROCEDURE enable_UI :
     3352     DISPLAY sch-corr-date sch-sert-code sch-corr-user-name mark-num
     3353         WITH FRAME Dialog-Frame.
     3354     ENABLE b-quit B-mark b-sel B-print B-sch B-Help B-lookup br-c-sert
     3355            sch-corr-date sch-sert-code sch-corr-user-name BR-changes mark-num
     3356         WITH FRAME Dialog-Frame.
     3357     VIEW FRAME Dialog-Frame.
     3358   END PROCEDURE.
     3359   PROCEDURE MyEnable :
     3360   assign
     3361   br-c-sert:num-locked-columns in frame Dialog-Frame = 1
     3362   X_c-sert.corr-date:read-only in browse br-c-sert = yes
     3363   br-changes:title = "":U
     3364   temp-changes.l_name:resizable in browse br-changes = true
     3365   temp-changes.v_old:resizable in browse br-changes = true
     3366   temp-changes.v_new:resizable in browse br-changes = true
     3367   temp-changes.l_name:width in browse br-changes = 30
     3368   temp-changes.v_old:width in browse br-changes = 40
     3369   temp-changes.v_new:width in browse br-changes = 40
     3370   .
     3371   VIEW frame Dialog-Frame .
     3372   DISPLAY
     3373   sch-corr-date
     3374   sch-sert-code
     3375   sch-corr-user-name
     3376   mark-num
     3377   WITH FRAME Dialog-Frame .
     3378   ENABLE
     3379   b-quit
     3380   B-mark when lookup("b-mark":U, bttns) > 0
     3381   b-sel when lookup("b-sel":U, bttns) > 0
     3382   B-lookup
     3383   B-sch
     3384   B-Print
     3385   B-Help
     3386   br-c-sert
     3387   sch-corr-date
     3388   sch-sert-code when p-mode = 'все':U
     3389   sch-corr-user-name
     3390   BR-changes mark-num
     3391   WITH FRAME Dialog-Frame .
     3392   VIEW FRAME Dialog-Frame .
     3393   hide b-lookup
     3394   sch-corr-user-name
     3395   in frame Dialog-Frame .
     3396   END PROCEDURE.
     3397   PROCEDURE OpenBr :
     3398   define input  parameter p-open-query     as logical   no-undo .
     3399   define input  parameter p-find-next      as logical   no-undo .
     3400   define input  parameter p-find-condition as character no-undo .
     3401   define variable l-query-was-opened as logical no-undo .
     3402   define variable v-title as character no-undo .
     3403   define variable title0 as character no-undo.
     3404   title0 = "История сертификатов" + chr(32).
     3405   run waitfram-show in this-procedure ("Ждите...").
     3406   define variable sort-column-phrase as character no-undo .
     3407   case sort-column-name :
     3408     when "" then do:
     3409       assign
     3410         sort-column-phrase = ""
     3411       .
     3412     end.
     3413     otherwise do:
     3414       assign
     3415         sort-column-phrase = "by " + sort-column-name
     3416       .
     3417     end.
     3418   end case.
     3419   define variable l-open-query as logical   no-undo .
     3420   CASE p-mode :
     3421     WHEN 'все':U        THEN DO:
     3422      assign
     3423       filter-point = filter-point0 + p-mode
     3424       filter-label = substitute("&1", filter-label0)
     3425       .
     3426   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3427   define variable  l-disable-where-26  as logical   no-undo .
     3428   define variable  l-filter-open-26    as logical   .
     3429   define variable  flt-rec-26       as recid     no-undo .
     3430   define variable  filter-name-26      as character no-undo .
     3431   define variable  where-phrase-26     as character no-undo .
     3432   define variable  sort-phrase-26      as character no-undo .
     3433   define variable  where-phrase-rus-26 as character no-undo .
     3434   define variable  sort-phrase-rus-26  as character no-undo .
     3435     run waitfram-show in this-procedure
     3436       (input "ЖДИТЕ ..."
     3437       ).
     3438   run gbl/flt-get.p
     3439     (input filter-point
     3440     ,output flt-rec-26
     3441     ,output filter-name-26
     3442     ,output where-phrase-26
     3443     ,output sort-phrase-26
     3444     ,output where-phrase-rus-26
     3445     ,output sort-phrase-rus-26
     3446     ).
     3447   if p-open-query then do:
     3448       run set-filter-name in this-procedure
     3449         (INPUT filter-name-26
     3450         ) no-error .
     3451     assign
     3452       l-filter-open-26 = false
     3453     .
     3454     if flt-rec-26 <> ?
     3455       or sort-column-phrase > ""
     3456     then do:
     3457       define variable  parameter-2-26 as character no-undo .
     3458       define variable  parameter-3-26 as character no-undo .
     3459       define variable  parameter-4-26 as character no-undo .
     3460       define variable  parameter-5-26 as character no-undo .
     3461       define variable  parameter-6-26 as character no-undo .
     3462       define variable  parameter-7-26 as character no-undo .
     3463         assign
     3464         parameter-3-26 =
     3465                                 "FOR EACH X_c-sert"
     3466         parameter-4-26 =
     3467           (
     3468             if (" TRUE " + " " + where-phrase-26) <> ""
     3469             then " TRUE " + " " + where-phrase-26
     3470             else "true"
     3471           )
     3472         parameter-5-26 = (" " + "" + " " + "")
     3473         parameter-6-26 = if sort-phrase-26 = ''
     3474                              then
     3475           (
     3476           " " + "  " +
     3477             " " + sort-column-phrase +
     3478           " " + "  "
     3479           )
     3480                              else
     3481           (
     3482           " " + "  " +
     3483             " " + sort-column-phrase +
     3484           " " + sort-phrase-26
     3485           )
     3486         parameter-7-26 =
     3487           " indexed-reposition  "
     3488       .
     3489       do
     3490       on stop undo, leave
     3491       on error undo, leave
     3492       :
     3493         assign
     3494           l-disable-where-26 =
     3495             (" TRUE " + " " + where-phrase-26 = "")
     3496         .
     3497         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3498                             ,input query br-c-sert:handle
     3499                             ,input parameter-3-26
     3500                             ,input parameter-4-26
     3501                             ,input parameter-5-26
     3502                             ,input parameter-6-26
     3503                             ,input parameter-7-26
     3504                             )
     3505         .
     3506         assign
     3507           l-filter-open-26 = true
     3508         .
     3509       end.
     3510       if l-filter-open-26 = false then do:
     3511         message
     3512           "Ошибка при фильтрации / сортировке" skip
     3513           "Будут показаны записи без учета фильтра" skip
     3514           view-as alert-box .
     3515       end.
     3516       else do:
     3517           assign
     3518             l-query-was-opened = true
     3519           .
     3520       end.
     3521     end.
     3522     if l-filter-open-26 = false then do:
     3523       OPEN QUERY br-c-sert FOR EACH X_c-sert
     3524         where  TRUE
     3525         indexed-reposition
     3526     .
     3527         assign
     3528           l-query-was-opened = true
     3529         .
     3530     end.
     3531   end.
     3532   else do:
     3533     assign
     3534       v-doc-rec = recid( X_c-sert )
     3535     .
     3536     do
     3537     on stop undo, leave
     3538     on error undo, leave
     3539     :
     3540       if query br-c-sert:handle:get-buffer-handle(1) = (buffer X_c-sert:handle) then do:
     3541         assign
     3542         parameter-2-26 = (if p-find-next then "true":u else "false":u )
     3543         parameter-4-26 =
     3544           "where ":u + " TRUE " + " ":u + where-phrase-26 + " ":u + p-find-condition + " " + ""
     3545         parameter-5-26 = "  "
     3546       .
     3547         run fltopend_fltfindd in this-procedure  (
     3548                             input this-procedure:handle
     3549                             ,input query br-c-sert:handle
     3550                             ,input rowid(X_c-sert)
     3551                             ,input logical(parameter-2-26)
     3552                             ,input no-lock
     3553                             ,input (buffer X_c-sert:handle)
     3554                             ,input parameter-4-26
     3555                             ,input parameter-5-26
     3556                             ) no-error.
     3557         .
     3558         assign
     3559           v-doc-rec = integer(return-value)
     3560           v-fltopend-rowid[1] = ?
     3561         .
     3562       end.
     3563       else do:
     3564         assign
     3565         parameter-2-26 = (if p-find-next then "true":u else "false":u )
     3566         parameter-3-26 =  "FOR EACH X_c-sert"
     3567         parameter-4-26 =
     3568           (
     3569             if (" TRUE " + " " + where-phrase-26) <> ""
     3570             then " TRUE " + " " + where-phrase-26
     3571             else "true"
     3572           )
     3573         parameter-5-26 = (" " + "" + " " + "" + " " + p-find-condition)
     3574         parameter-6-26 = if sort-phrase-26 = ''
     3575                              then
     3576           (
     3577           " " + "  " +
     3578             " " + sort-column-phrase +
     3579           " " + "  "
     3580           )
     3581                              else
     3582           (
     3583           " " + "  " +
     3584             " " + sort-column-phrase +
     3585           " " + sort-phrase-26
     3586           )
     3587         parameter-7-26 =
     3588           " indexed-reposition  "
     3589       .
     3590         run fltopend_fltfindq in this-procedure  (
     3591                             input this-procedure:handle
     3592                             ,input query br-c-sert:handle
     3593                             ,input logical(parameter-2-26)
     3594                             ,input no-lock
     3595                             ,input parameter-3-26
     3596                             ,input parameter-4-26
     3597                             ,input parameter-5-26
     3598                             ,input parameter-6-26
     3599                             ,input parameter-7-26
     3600                             ,output v-fltopend-rowid
     3601                             ) no-error.
     3602         .
     3603         v-doc-rec = ?.
     3604       end.
     3605       assign
     3606         l-query-was-opened = true
     3607       .
     3608     end.
     3609   end.
     3610     run waitfram-hide in this-procedure .
     3611     END.
     3612     when 'cli' then do:
     3613       assign
