     4603   PROCEDURE proc-b-print :
     4604   define variable date_string     as      char    no-undo.
     4605   define variable Line                as      char    no-undo.
     4606   define variable for-time as char.
     4607   define variable accum-count as integer.
     4608   define variable v-doc-rec as recid no-undo.
     4609   define variable v-prod as character no-undo .
     4610   define variable v-subject-chr as character no-undo .
     4611   define variable v-upd-time as character no-undo .
     4612   define variable v-obj as character no-undo .
     4613   define variable v-action-chr as character no-undo .
     4614   define variable v-for-usr-name as character no-undo .
     4615   DEFINE FRAME HistoryList
     4616   X_c-sert.sert-code COLUMn-LABEL "№ сертификата"
     4617   v-action-chr FORMAT "X(10)" COLUMN-LABEL "Действие"
     4618   v-subject-chr COLUMN-LABEL "Предмет изменений" FORMAT "X(20)"
     4619   X_c-sert.corr-date
     4620   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     4621   v-for-usr-name column-label "Изменил" format "(18)"
     4622   X_c-sert.corr-user-db-num
     4623   v-obj COLUMN-LABEL "Контрагент" FORMAT "X(8)"
     4624   HEADER  date_string AT 5 format "X(35)"
     4625   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     4626   Line format "X(192)" AT 1
     4627   with width 232 down stream-io use-text    .
     4628   Line = fill("-", 192).
     4629   date_string = cur-time-print() .
     4630   assign
     4631   v-doc-rec = recid( X_c-sert ).
     4632   DO WHILE available X_c-sert :
     4633         GET prev br-c-sert.
     4634   END.
     4635   run prn-lib-open-stream  in this-procedure (
     4636                                                input parparentProc
     4637                                               ,input 43
     4638                                               ,input yes
     4639                                               ,input no
     4640                                               ).
     4641   PUT  STREAM PrnLibStream
     4642   SPACE(25) ( frame Dialog-Frame:title )
     4643   format "x(90)" SKIP(1) .
     4644   FORM HEADER
     4645   Line format "X(177)" AT 1 SKIP
     4646   "Продолжение - на следующей странице" AT 30 SKIP
     4647   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4648   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4649   FORM with FRAME HistoryList  .
     4650   run waitfram-show in this-procedure ("Ждите...").
     4651     GET next br-c-sert.
     4652       DO WHILE available X_c-sert :
     4653         Display STREAM PrnLibStream
     4654         X_c-sert.sert-code
     4655         get-action(X_c-sert.action) @ v-action-chr
     4656         get-subject(X_c-sert.subject) @ v-subject-chr
     4657         X_c-sert.corr-date
     4658         string(X_c-sert.corr-time, "HH:MM:SS":U) @ v-upd-time
     4659         usrfulnf(X_c-sert.corr-user-name) @ v-for-usr-name
     4660         X_c-sert.corr-user-db-num
     4661         X_c-sert.cli-type + string(X_c-sert.cli-code) @ v-obj
     4662         with FRAME HistoryList .
     4663     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     4664     assign
     4665     accum-count = accum-count + 1
     4666     .
     4667     GET next br-c-sert.
     4668   END.
     4669   UNDERLINE  STREAM PrnLibStream
     4670   X_c-sert.sert-code
     4671   v-action-chr
     4672   v-subject-chr
     4673   X_c-sert.corr-date
     4674   v-upd-time
     4675   v-for-usr-name
     4676   X_c-sert.corr-user-db-num
     4677   v-obj
     4678   with FRAME HistoryList .
     4679   DISPLAY STREAM PrnLibStream
     4680   "ИТОГО"  @ X_c-sert.sert-code
     4681   string(accum-count)  @ v-action-chr
     4682   with frame HistoryList.
     4683   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4684   HIDE  STREAM PrnLibStream FRAME CheckList.
     4685   output  STREAM PrnLibStream CLOSE.
     4686   run waitfram-hide in this-procedure.
     4687   run prn-lib-prn-file in this-procedure (
     4688                                             input parparentproc
     4689                                             ,input 8
     4690                                             ).
     4691   reposition br-c-sert to recid v-doc-rec no-error.
     4692   apply "entry" to br-c-sert in frame Dialog-Frame.
     4693   END PROCEDURE.
     4694   PROCEDURE proc-b-sch :
     4695   assign
     4696     tbl = 'c-sert'
     4697     join-tbl = 'X_c-sert'
     4698     fld = ""
     4699     lab = ""
     4700     spr = ""
     4701     dim = '0'
     4702     .
     4703   run fltfield-add in this-procedure('cli-type*cli-code', 'Контрагент', '',
     4704   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4705   run fltfield-add in this-procedure('sert-code', '№ сертификата', '',
     4706   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4707   run fltfield-add in this-procedure('corr-date', '', '',
     4708   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4709   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     4710   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4711   run fltfield-add in this-procedure('corr-user-db-num', '', '',
     4712   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4713   run fltfield-add in this-procedure('corr-user-name', '', 'usr',
     4714   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4715   run fltfield-add in this-procedure('subject', 'Предмет изменения', 'sert-hist-subject',
     4716   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4717   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     4718   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4719   Filter-Block:
     4720   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4721       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4722       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4723     run gbl/filter.w ( INPUT parparentproc
     4724                       ,INPUT (filter-point + chr(4) + filter-label + chr(4) + 'yes':U)
     4725                       , INPUT tbl
     4726                       , INPUT join-tbl
     4727                       , INPUT fld
     4728                       , INPUT lab
     4729                       , INPUT spr
     4730                       , INPUT dim ).
     4731     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     4732   END.
     4733   END PROCEDURE.
     4734   PROCEDURE proc-br-c-sert :
     4735   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4736   if b-sel:sensitive in frame Dialog-Frame then dO:
     4737       if b-mark:sensitive then do:
