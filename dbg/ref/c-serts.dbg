     4749   PROCEDURE proc-find-corr-date :
     4750   define input parameter p-next as logical no-undo.
     4751   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     4752   define variable v-date-chr as character no-undo.
     4753   if p-date = ? then return .
     4754   display
     4755   0 @ sch-sert-code
     4756   "":U @ sch-corr-user-name
     4757   with frame Dialog-Frame.
     4758   assign
     4759   v-date-chr = string(day(p-date)) + chr(47) +
     4760                    string(month(p-date)) + chr(47) +
     4761                    string(year(p-date)).
     4762          run OpenBr in this-procedure
     4763           (input false
     4764           ,input true
     4765           ,input substitute("and X_c-sert.corr-date = &1 "
     4766             , v-date-chr)
     4767           ).
     4768         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     4769   END PROCEDURE.
