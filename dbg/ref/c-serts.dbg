     2798                 (input  integer(v-resize-value-str)
     2799                 ,input  true
     2800                 ) .
     2801               assign
     2802                 v-restore-saved = true
     2803               .
     2804             end.
     2805           end.
     2806           if v-restore-saved <> true
     2807           then do:
     2808             if v-diasize-wndmax = true
     2809             then do:
     2810               run diasize_maximize in this-procedure
     2811                 (input  true
     2812                 ) .
     2813             end.
     2814           end.
     2815         end.
     2816         else do:
     2817           if v-diasize-wndmax = true
     2818           then do:
     2819             run diasize_maximize in this-procedure
     2820               (input  true
     2821               ) .
     2822           end.
     2823         end.
     2824       end.
     2825     end.
     2826   end procedure.
     2827   procedure diasize_need-full-display :
