     1094     define variable v-field-lvl       as character no-undo .
     1095     define variable v-field-form      as character no-undo .
     1096     define variable v-search-exp      as character no-undo .
     1097     define variable v-srch-main       as character no-undo .
     1098     define variable v-word-link       as character no-undo .
     1099     define variable v-av-chip-num     as logical   no-undo .
     1100     define variable v-main-pi-fld-lst as character no-undo .
     1101     define variable v-main-fld-lst    as character no-undo .
     1102     define variable v-delim-list      as character no-undo .
     1103     define variable v-label           as character no-undo .
     1104     define variable v-old-value       as character no-undo case-sensitive.
     1105     define variable v-new-value       as character no-undo case-sensitive.
     1106     define variable v-chg-fields as character no-undo.
     1107     for each temp-changes:
     1108       delete temp-changes.
     1109     end.
     1110     if not p-hst-handle:available then do:
     1111       return .
     1112     end.
     1113     create buffer h-new-buf  for table p-hst-handle .
     1114     create buffer h-main-buf for table p-main-table .
     1115     assign
     1116       v-inform = h-main-buf:index-information(1)
     1117       v-ind    = 2
     1118     .
     1119     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1120     on error undo, return error
     1121     :
     1122       assign
     1123         v-inform = h-main-buf:index-information( v-ind )
     1124         v-ind    = v-ind + 1
     1125       .
     1126     end.
     1127     if v-inform = ?
     1128       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1129       or entry( 3, v-inform, ",":U ) <> "1":U
     1130     then do:
     1131       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1132     end.
     1133     assign
     1134       v-idx-field-qnty = num-entries( v-inform ) - 4
     1135     .
     1136     if v-idx-field-qnty < 2 then do:
     1137       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1138     end.
     1139     assign
     1140       v-srch-main   = "where":U
     1141       v-word-link   = "":U
     1142       v-av-chip-num = false
     1143       v-delim-list  = "":U
     1144     .
     1145     do v-ind = 1 to v-idx-field-qnty by 2
     1146     on error undo, return error
     1147     :
     1148       assign
     1149         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1150         fh                = p-hst-handle:buffer-field( v-field-name )
     1151         fh-main           = h-main-buf:buffer-field( v-field-name )
     1152         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1153         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1154       .
     1155       if fh:data-type ="character":U then do:
     1156         assign
     1157           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1158         .
     1159       end.
     1160       else do:
     1161         assign
     1162           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1163         .
     1164       end.
     1165       if v-delim-list = "":U then do:
     1166         assign
     1167           v-delim-list = ",":U
     1168         .
     1169       end.
     1170       if v-word-link = "":U then do:
     1171         assign
     1172           v-word-link = "and":U
     1173         .
     1174       end.
     1175     end.
     1176     assign
     1177       v-delim-list  = "":U
     1178     .
     1179     do v-ind = 1 to h-main-buf:num-fields
     1180     on error undo, return error
     1181     :
     1182       assign
     1183         fh-main      = h-main-buf:buffer-field( v-ind )
     1184         v-field-name = fh-main:name
     1185       .
     1186         assign
     1187           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1188         .
     1189         if v-delim-list = "":U then do:
     1190           assign
     1191             v-delim-list = ",":U
     1192           .
     1193         end.
     1194     end.
     1195     assign
     1196       v-inform = p-hst-handle:index-information(1)
     1197       v-ind    = 2
     1198     .
     1199     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1200     on error undo, return error
     1201     :
     1202       assign
     1203         v-inform = p-hst-handle:index-information( v-ind )
     1204         v-ind    = v-ind + 1
     1205       .
     1206     end.
     1207     if v-inform = ?
     1208       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1209       or entry( 3, v-inform, ",":U ) <> "1":U
     1210     then do:
     1211       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1212     end.
     1213     assign
     1214       v-idx-field-qnty = num-entries( v-inform ) - 4
     1215     .
     1216     if v-idx-field-qnty < 2 then do:
     1217       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1218     end.
     1219     assign
     1220       v-search-exp  = "where":U
     1221       v-word-link   = "":U
     1222       v-av-chip-num = false
     1223     .
     1224     do v-ind = 1 to v-idx-field-qnty by 2
     1225     on error undo, return error
     1226     :
     1227       assign
     1228         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1229         fh           = p-hst-handle:buffer-field( v-field-name )
     1230         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1231       .
     1232       if v-field-name = "chip-num":U then do:
     1233         assign
     1234           v-search-exp  = substitute( "&1 >", v-search-exp )
     1235           v-av-chip-num = true
     1236         .
     1237       end.
     1238       else do:
     1239         assign
     1240           v-search-exp = substitute( "&1 =", v-search-exp )
     1241         .
     1242       end.
     1243       if fh:data-type ="character":U then do:
     1244         assign
     1245           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1246         .
     1247       end.
     1248       else do:
     1249         assign
     1250           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1251         .
     1252       end.
     1253       if v-word-link = "":U then do:
     1254         assign
     1255           v-word-link = "and":U
     1256         .
     1257       end.
     1258     end.
     1259     if v-av-chip-num = false then do:
     1260       message
     1261         vss-workfile vss-revision vss-description skip
     1262         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1263         "Использование данной процедуры невозможно!" skip
     1264         view-as alert-box error .
     1265       return error .
     1266     end.
     1267     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1268     if not h-new-buf:available then do:
     1269       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1270       if not h-main-buf:available then do:
     1271         assign
     1272           h-for-comp = ?
     1273         .
     1274       end.
     1275       else do:
     1276         assign
     1277           h-for-comp = h-main-buf
     1278         .
     1279       end.
     1280     end.
     1281     else do:
     1282       assign
     1283         h-for-comp = h-new-buf
     1284       .
     1285     end.
     1286     assign
     1287       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1288     .
     1289     do v-ind = 1 to v-num-entries
     1290     on error undo, return error return-value
     1291     :
     1292       assign
     1293         v-field-name = entry( v-ind, v-main-fld-lst )
     1294         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1295         v-old-value  = fh-old:buffer-value()
     1296         v-label      = trim( fh-old:label )
     1297       .
     1298       if ( trim( p-field-list ) <> "":U
     1299            and lookup( v-field-name, p-field-list ) > 0
     1300          )
     1301          or trim( p-field-list ) = "":U
     1302       then do:
     1303         if h-for-comp <> ? then do:
     1304           assign
     1305             fh-new      = h-for-comp:buffer-field( v-field-name )
     1306             v-new-value = fh-new:buffer-value()
     1307           .
     1308         end.
     1309         else do:
     1310           assign
     1311             v-new-value = "":U
     1312           .
     1313         end.
     1314         if v-old-value <> v-new-value
     1315         then do:
     1316           create temp-changes.
     1317           assign
     1318             temp-changes.t_name = p-main-table
     1319             temp-changes.f_name = v-field-name
     1320             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1321             temp-changes.v_old  = trim( v-old-value )
     1322             temp-changes.v_new  = trim( v-new-value )
     1323             temp-changes.num_   = 0
     1324             temp-changes.fNotChange = v-old-value eq v-new-value
     1325           .
     1326         end.
     1327       end.
     1328     end.
     1329     assign
     1330       v-num-entries = num-entries( p-label-form, chr(8) )
     1331     .
     1332     do v-ind = 1 to v-num-entries
     1333     on error undo, return error return-value
     1334     :
     1335       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1336         assign
     1337           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1338           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1339           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1340         .
     1341         find first temp-changes
     1342           where temp-changes.f_name = v-field-name
     1343           no-error .
     1344         if available temp-changes then do:
     1345           if trim( v-field-lvl ) <> "":U then do:
     1346             assign
     1347               temp-changes.l_name = v-field-lvl
     1348             .
     1349           end.
     1350           if trim( v-field-form ) <> "":U then do:
     1351             assign
     1352               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1353             .
     1354             if h-for-comp <> ? then do:
     1355               assign
     1356                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1357               .
     1358             end.
     1359           end.
     1360         end.
     1361       end.
     1362       else do:
     1363         message
     1364           vss-workfile vss-revision vss-description skip
     1365           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1366           substitute( "список для поля '&1': '&2'"
     1367                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1368                       ,entry( v-ind, p-label-form, chr(8) )
     1369                     ) skip
     1370           substitute( "полный список: &2", p-label-form ) skip
     1371           view-as alert-box error .
     1372       end.
     1373     end.
     1374     delete object h-new-buf .
     1375     delete object h-main-buf .
     1376   END PROCEDURE.
     1377   FUNCTION get-action RETURNS CHARACTER
     1378     ( p-action as integer )  FORWARD.
     1379   FUNCTION get-subject RETURNS CHARACTER
     1380     ( p-subject as character )  FORWARD.
     1381   DEFINE BUTTON B-Help
     1382        LABEL "Помо&щь"
     1383        SIZE 3 BY 1
     1384        BGCOLOR 8 .
     1385   DEFINE BUTTON B-lookup
     1386        LABEL "&Просмотр"
     1387        SIZE 10 BY 1.
     1388   DEFINE BUTTON B-mark
     1389        LABEL "&*"
     1390        SIZE 3 BY 1.
     1391   DEFINE BUTTON B-print
     1392        LABEL "Пе&чать"
     1393        SIZE 3 BY 1.
     1394   DEFINE BUTTON b-quit AUTO-END-KEY
     1395        LABEL "&Выход"
     1396        SIZE 10 BY 1
     1397        BGCOLOR 8 .
     1398   DEFINE BUTTON B-sch
     1399        LABEL "&Фильтр"
     1400        SIZE 3 BY 1.
     1401   DEFINE BUTTON b-sel AUTO-GO
     1402        LABEL "Вы&бор"
     1403        SIZE 10 BY 1
     1404        BGCOLOR 8 .
     1405   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1406         VIEW-AS TEXT
     1407        SIZE 6 BY 1
     1408        FGCOLOR 4  NO-UNDO.
     1409   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1410        LABEL "Дате изменения"
     1411        VIEW-AS FILL-IN
     1412        SIZE 11 BY 1 NO-UNDO.
     1413   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1414        LABEL "пользователю"
     1415        VIEW-AS FILL-IN
     1416        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1417   DEFINE VARIABLE sch-sert-code AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1418        LABEL "№ сертификата"
     1419        VIEW-AS FILL-IN
     1420        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1421   DEFINE QUERY br-c-sert FOR
     1422         X_c-sert SCROLLING.
     1423   DEFINE QUERY BR-changes FOR
     1424         temp-changes SCROLLING.
     1425   DEFINE BROWSE br-c-sert
     1426     QUERY br-c-sert NO-LOCK DISPLAY
     1427         mark-string(recid(X_c-sert), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1428         X_c-sert.sert-code COLUMN-LABEL "№ сертиф." FORMAT "X(8)":U
     1429         X_c-sert.corr-date FORMAT "99/99/9999":U
     1430         string(X_c-sert.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1431         usrfulnf(X_c-sert.corr-user-name) FORMAT "X(18)":U
     1432         get-action(X_c-sert.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1433         X_c-sert.corr-user-db-num FORMAT ">>>>9":U
     1434         get-subject(X_c-sert.subject) COLUMN-LABEL "Предмет изменений" FORMAT "X(15)":U
     1435         X_c-sert.cli-type + string(X_c-sert.cli-code) COLUMN-LABEL "Контрагент" FORMAT "X(8)":U
     1436     ENABLE
     1437         X_c-sert.corr-date
     1438       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1439   DEFINE BROWSE BR-changes
     1440     QUERY BR-changes DISPLAY
     1441         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1442   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1443   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1444       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1445   DEFINE FRAME Dialog-Frame
     1446        b-quit AT ROW 1 COL 1
     1447        B-mark AT ROW 1 COL 11
     1448        b-sel AT ROW 1 COL 21
     1449        B-print AT ROW 1 COL 89
     1450        B-sch AT ROW 1 COL 92
     1451        B-Help AT ROW 1 COL 95
     1452        B-lookup AT ROW 1.04 COL 45
     1453        br-c-sert AT ROW 2 COL 1
     1454        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1455        sch-sert-code AT ROW 13.67 COL 56.13 COLON-ALIGNED
     1456        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1457        BR-changes AT ROW 14.79 COL 1
     1458        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1459        "ПОИСК ПО" VIEW-AS TEXT
     1460             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1461             FGCOLOR 4
     1462        SPACE(89.48) SKIP(7.41)
     1463       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1464            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1465            TITLE "Полная история по сертификатам"
     1466            CANCEL-BUTTON b-quit.
     1467   ASSIGN
     1468          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1469          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1470   ON GO OF FRAME Dialog-Frame
     1471   DO:
     1472     ASSIGN
     1473     p-rid-list = v-rid-list.
     1474   END.
     1475   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1476   DO:
     1477     APPLY "END-ERROR":U TO SELF.
     1478   END.
     1479   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1480   DO:
     1481     DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     1482     DEFINE BUFFER buf_c-pump FOR ub.c-pump.
     1483     DEFINE BUFFER buf_c-pl-gds-pump FOR ub.c-pl-gds-pump.
     1484     DEFINE BUFFER buf_c-pl-pump FOR ub.c-pl-pump.
     1485     DEFINE BUFFER buf_c-pl-pump-nozzle FOR ub.c-pl-pump-nozzle.
     1486     DEFINE BUFFER buf_c-pump-nozzle FOR ub.c-pl-pump-nozzle.
     1487       IF AVAILABLE X_c-sert THEN DO:
     1488       CASE X_c-sert.subject:
     1489       END CASE.
     1490     END.
     1491   END.
     1492   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1493   DO:
     1494   define variable loc#log as logical no-undo .
     1495     if available X_c-sert then do:
     1496   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1497   define variable v-str-recid14 as character no-undo .
     1498   define variable v-num-entry14 as integer   no-undo .
     1499   assign
     1500     v-str-recid14 = trim( string( recid( X_c-sert ) , "->>>>>>>>>>>9":U ) )
     1501     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1502   .
     1503   if v-num-entry14 > 0 then do:
     1504     assign
     1505       entry( v-num-entry14, v-rid-list ) = "":U
     1506       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1507     .
     1508   end.
     1509   else do:
     1510     assign
     1511       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1512     .
     1513   end.
     1514       loc#log = br-c-sert:refresh() .
     1515       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1516           loc#log = br-c-sert:select-next-row ().
     1517           apply "VALUE-CHANGED" to br-c-sert in frame Dialog-Frame.
     1518       end.
     1519       if num-entries( v-rid-list ) = 0
     1520       then
     1521           hide mark-num in frame Dialog-Frame.
     1522       else
     1523           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1524     end.
     1525     apply "entry" to br-c-sert in frame Dialog-Frame.
     1526   END.
     1527   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1528   DO:
     1529       run proc-b-print in this-procedure no-error.
     1530     if error-status:error then return no-apply.
     1531   END.
     1532   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1533   DO:
     1534       run proc-b-sch in this-procedure no-error.
     1535     if error-status:error then return no-apply.
     1536   END.
     1537   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1538   DO:
     1539     if ( available X_c-sert ) then do:
     1540       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1541       then
     1542       v-rid-list = string( recid( X_c-sert ) ) .
     1543     end.
     1544   END.
     1545   ON MOUSE-SELECT-DBLCLICK OF br-c-sert IN FRAME Dialog-Frame
     1546   DO:
     1547        run proc-br-c-sert in this-procedure no-error.
     1548     if error-status:error then return no-apply.
     1549   END.
     1550   ON RETURN OF br-c-sert IN FRAME Dialog-Frame
     1551   DO:
     1552       run proc-br-c-sert in this-procedure no-error.
     1553     if error-status:error then return no-apply.
     1554   END.
     1555   ON VALUE-CHANGED OF br-c-sert IN FRAME Dialog-Frame
     1556   DO:
     1557     run proc-view-changes in this-procedure no-error.
     1558   END.
     1559   ON CTRL-J OF sch-corr-date IN FRAME Dialog-Frame
     1560   DO:
     1561      run proc-find-corr-date in this-procedure(yes, input frame Dialog-Frame sch-corr-date) no-error.
     1562     if error-status:error then return no-apply.
     1563   END.
     1564   ON RETURN OF sch-corr-date IN FRAME Dialog-Frame
     1565   DO:
     1566     run proc-find-corr-date in this-procedure(no, input frame Dialog-Frame sch-corr-date) no-error.
     1567     if error-status:error then return no-apply.
     1568   END.
     1569   ON CTRL-J OF sch-corr-user-name IN FRAME Dialog-Frame
     1570   DO:
     1571     run proc-find-user in this-procedure(yes, input frame Dialog-Frame sch-corr-user-name) no-error.
     1572     if error-status:error then return no-apply.
     1573   END.
     1574   ON RETURN OF sch-corr-user-name IN FRAME Dialog-Frame
     1575   DO:
     1576     run proc-find-user in this-procedure(no, input frame Dialog-Frame sch-corr-user-name) no-error.
     1577     if error-status:error then return no-apply.
     1578   END.
     1579   ON CTRL-J OF sch-sert-code IN FRAME Dialog-Frame
     1580   DO:
     1581     run proc-find-sert-code in this-procedure(yes, input frame Dialog-Frame sch-sert-code) no-error.
     1582     if error-status:error then return no-apply.
     1583   END.
     1584   ON RETURN OF sch-sert-code IN FRAME Dialog-Frame
     1585   DO:
     1586     run proc-find-sert-code in this-procedure(no, input frame Dialog-Frame sch-sert-code) no-error.
     1587     if error-status:error then return no-apply.
     1588   END.
     1589   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1590   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1591   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1592   on help of frame Dialog-Frame
     1593   do:
     1594     run gbl/app_help.p
     1595       (input this-procedure :file-name
     1596       ,input ''
     1597       ,input ?
     1598       ) no-error.
     1599     if error-status :error then do:
     1600       message
     1601         "Ошибка при вызове помощи"
     1602         error-status :get-message(1)
     1603         view-as alert-box .
     1604     end.
     1605   end.
     1606   run minbtn-set in this-procedure .
     1607   on choose of b-help in frame Dialog-Frame
     1608   do:
     1609     apply "help":u to frame Dialog-Frame .
     1610   end.
     1611   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1612   procedure minbtn-set :
     1613       do
     1614           on error undo, return error return-value
     1615           :
     1616           define variable ii              as integer       no-undo .
     1617           define variable fh              as widget-handle no-undo .
     1618           define variable hh              as widget-handle no-undo .
     1619           define variable v-h             as handle        extent 4 no-undo .
     1620           define variable v-name-button   as character     no-undo .
     1621           define variable v-help-old-x    as decimal       no-undo .
     1622           define variable v-help-old-y    as decimal       no-undo .
     1623           define variable v-help-old-size as decimal       no-undo .
     1624           define variable v-frame-width   as decimal       no-undo .
     1625           define variable jj              as integer       no-undo .
     1626           do
     1627               on error undo, return error
     1628               :
     1629               assign
     1630                   v-frame-width = frame Dialog-Frame:width - 0.3
     1631                   fh            = frame Dialog-Frame:first-child
     1632                   hh            = fh:first-child
     1633                   ii            = 1
     1634                   .
     1635               do while valid-handle(hh):
     1636                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1637                   do:
     1638                       case lc(hh:name) :
     1639                           when "b-help" then
     1640                               do:
     1641                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1642                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1643                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1644                                   hh:TOOLTIP = "Помощь" .
     1645                                   v-help-old-x = hh:column .
     1646                                   v-help-old-y = hh:row    .
     1647                                   v-help-old-size = hh:width .
     1648                                   hh:width-chars = 2.5 .
     1649                               end.
     1650                           when "b-print" then
     1651                               do:
     1652                                   hh:load-image("cmp/b-print.bmp":u) .
     1653                                   hh:TOOLTIP = "Печать" .
     1654                                   v-h[ii] = hh:handle .
     1655                                   ii = ii + 1 .
     1656                                   hh:width-chars = 3 .
     1657                               end.
     1658                           when "b-history" or
     1659                           when "b-hist" then
     1660                               do:
     1661                                   hh:load-image("cmp/b-hist.bmp":u) .
     1662                                   hh:TOOLTIP = "История" .
     1663                                   v-h[ii] = hh:handle .
     1664                                   ii = ii + 1 .
     1665                                   hh:width-chars = 3 .
     1666                               end.
     1667                           when "b-sch" then
     1668                               do:
     1669                                   hh:load-image("cmp/b-sch.bmp":u) .
     1670                                   hh:TOOLTIP = "Установка Фильтра" .
     1671                                   v-h[ii] = hh:handle .
     1672                                   ii = ii + 1 .
     1673                                   hh:width-chars = 3 .
     1674                               end.
     1675                           when "b-hist-user" then
     1676                               do:
     1677                                   hh:load-image("cmp/b-hist.bmp":u) .
     1678                                   hh:TOOLTIP = "История пользователя" .
     1679                                   ii = ii + 1 .
     1680                               end.
     1681                       end case.
     1682                   end.
     1683                   hh = hh:next-sibling.
     1684               end.
     1685               b-help:column = v-frame-width - b-help:width-chars.
     1686               jj = 0.
     1687               repeat ii = 4 to 1 by -1 :
     1688                   if valid-handle (v-h[ii] ) then
     1689                   do:
     1690                       jj  = jj + 1 .
     1691                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1692                       v-h[ii]:row    = v-help-old-y .
     1693                   end.
     1694               end.
     1695           end.
     1696       end.
     1697   end procedure.
     1698   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1699   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1700   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1701   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1702   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1703   define variable v-diasize-current-frame-height as decimal   no-undo .
     1704   define variable v-diasize-change-size          as logical   no-undo .
     1705   define variable v-diasize-resize-button        as handle    no-undo .
     1706   define variable v-diasize-wndmax               as logical   no-undo .
     1707   define variable v-diasize-wndstore             as logical   no-undo .
     1708   define variable v-diasize-proc-name            as character no-undo .
     1709   define variable v-diasize-browse-handle        as handle    no-undo .
     1710   define variable v-diasize-browse-number        as integer   no-undo .
     1711   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1712   define temp-table temp-diasize-handle no-undo
     1713     field handle-value  as handle
     1714     field save-position as decimal
     1715     index xpk is primary unique handle-value
     1716     .
     1717   define temp-table temp-browse-handle no-undo
     1718     field browse-type   as character
     1719     field browse-number as integer
     1720     field browse-handle as handle
     1721     field original-size as decimal
     1722     index xpk is primary unique browse-type browse-number
     1723     index xie browse-type browse-handle
     1724   .
     1725   procedure diasize_change-height :
     1726     define input  parameter p-change-value  as decimal   no-undo .
     1727     define input  parameter p-move-resize   as logical   no-undo .
     1728     define variable v-field-group-handle    as handle    no-undo .
     1729     define variable v-object-handle         as handle    no-undo .
     1730     define variable v-frame-height          as decimal   no-undo .
     1731     define variable v-frame-virtual-height  as decimal   no-undo .
     1732     define variable v-browse-height         as decimal   no-undo .
     1733     define variable v-window-height         as decimal   no-undo .
     1734     define variable v-window-virtual-height as decimal   no-undo .
     1735     define variable v-change-sign           as integer   no-undo .
     1736     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1737     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1738     if p-change-value > 0
     1739     then do:
     1740       if frame Dialog-Frame :height + p-change-value
     1741           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1742       then do:
     1743         assign
     1744           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1745                           - (frame Dialog-Frame :height-chars)
     1746         .
     1747         if p-change-value <= 0
     1748         then do:
     1749           run diasize_position-resize-button in this-procedure .
     1750           return .
     1751         end.
     1752       end.
     1753     end.
     1754     if p-change-value < 0
     1755     then do:
     1756       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1757       then do:
     1758         assign
     1759           p-change-value = v-diasize-orig-frame-height
     1760                          - (frame Dialog-Frame :height-chars)
     1761         .
     1762         if p-change-value >= 0
     1763         then do:
     1764           run diasize_position-resize-button in this-procedure .
     1765           return .
     1766         end.
     1767       end.
     1768     end.
     1769     if p-change-value >= 0
     1770     then do:
     1771       assign
     1772         v-change-sign = 1
     1773       .
     1774     end.
     1775     else do:
     1776       assign
     1777         v-change-sign = -1
     1778       .
     1779     end.
     1780     assign
     1781       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1782     .
     1783     if p-change-value = 0
     1784     then do:
     1785       run diasize_position-resize-button in this-procedure .
     1786       return .
     1787     end.
     1788     move_block:
     1789     do
     1790     on error undo move_block, retry move_block
     1791     :
     1792       if retry
     1793       then do:
     1794         do
     1795         on error undo move_block, leave move_block
     1796         :
     1797           if p-change-value > 0
     1798           then do:
     1799             for each buf_temp-diasize-handle
     1800             on error undo, next
     1801             :
     1802               assign
     1803                 v-object-handle = buf_temp-diasize-handle.handle-value
     1804               .
     1805               if v-object-handle <> v-diasize-resize-button
     1806               then do:
     1807                 assign
     1808                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1809                 .
     1810               end.
     1811             end.
     1812             assign
     1813               v-diasize-browse-handle :height = v-browse-height
     1814             .
     1815             for each buf_temp-browse-handle
     1816               where buf_temp-browse-handle.browse-type = 'height':u
     1817             on error undo, next
     1818             :
     1819               assign
     1820                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1821               .
     1822             end.
     1823             assign
     1824               frame Dialog-Frame :height = v-frame-height
     1825             .
     1826             if frame Dialog-Frame :scrollable = true
     1827             then do:
     1828               assign
     1829                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1830               .
     1831             end.
     1832             run diasize_position-resize-button in this-procedure .
     1833           end.
     1834           else do:
     1835             if frame Dialog-Frame :scrollable = true
     1836             then do:
     1837               assign
     1838                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1839               .
     1840             end.
     1841             assign
     1842               frame Dialog-Frame :height = v-frame-height
     1843             .
     1844             assign
     1845               v-diasize-browse-handle :height = v-browse-height
     1846             .
     1847             for each buf_temp-browse-handle
     1848               where buf_temp-browse-handle.browse-type = 'height':u
     1849             on error undo, next
     1850             :
     1851               assign
     1852                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1853               .
     1854             end.
     1855             for each buf_temp-diasize-handle
     1856             on error undo, next
     1857             :
     1858               assign
     1859                 v-object-handle = buf_temp-diasize-handle.handle-value
     1860               .
     1861               if v-object-handle <> v-diasize-resize-button
     1862               then do:
     1863                 assign
     1864                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1865                 .
     1866               end.
     1867             end.
     1868             run diasize_position-resize-button in this-procedure .
     1869           end.
     1870           assign
     1871             v-diasize-change-size = false
     1872           .
     1873           leave move_block .
     1874         end.
     1875       end.
     1876       assign
     1877         v-diasize-need-full-display = true
     1878       .
     1879       if v-diasize-change-size = false
     1880       then do:
     1881         assign
     1882           v-diasize-change-size = true
     1883         .
     1884       end.
     1885       else do:
     1886         return .
     1887       end.
     1888       assign
     1889         v-frame-height = frame Dialog-Frame :height
     1890         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1891         v-browse-height = v-diasize-browse-handle :height
     1892       .
     1893       for each buf_temp-browse-handle
     1894         where buf_temp-browse-handle.browse-type = 'height':u
     1895       :
     1896         assign
     1897           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1898         .
     1899       end.
     1900       for each buf_temp-diasize-handle
     1901       :
     1902         delete buf_temp-diasize-handle .
     1903       end.
     1904       assign
     1905         v-field-group-handle = frame Dialog-Frame :first-child
     1906       .
     1907       do while valid-handle(v-field-group-handle)
     1908       :
     1909         assign
     1910           v-object-handle = v-field-group-handle :first-child
     1911         .
     1912         do while valid-handle(v-object-handle)
     1913         :
     1914           if  v-object-handle <> v-diasize-browse-handle :handle
     1915           and can-query(v-object-handle, "row")
     1916           and can-query(v-object-handle, "height")
     1917           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1918           then do:
     1919             find first buf_temp-browse-handle
     1920               where buf_temp-browse-handle.browse-type   = 'height':u
     1921                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1922               no-error .
     1923             if available buf_temp-browse-handle
     1924             then do:
     1925             end.
     1926             else do:
     1927               create buf_temp-diasize-handle .
     1928               assign
     1929                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1930                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1931               .
     1932             end.
     1933           end.
     1934           assign
     1935             v-object-handle = v-object-handle :next-sibling
     1936           .
     1937         end.
     1938         assign
     1939           v-field-group-handle = v-field-group-handle :next-sibling
     1940         .
     1941       end.
     1942       do with frame Dialog-Frame
     1943       :
     1944         hide v-diasize-resize-button .
     1945         assign
     1946           v-diasize-resize-button :row    = 1
     1947           v-diasize-resize-button :column = 1
     1948         .
     1949       end.
     1950       if p-change-value > 0
     1951       then do:
     1952         if frame Dialog-Frame :scrollable = true
     1953         then do:
     1954           assign
     1955             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1956             no-error .
     1957           if error-status :error
     1958           or error-status :get-message(1) <> ""
     1959           then do:
     1960             undo move_block, retry move_block .
     1961           end.
     1962         end.
     1963         assign
     1964           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1965           no-error .
     1966         if error-status :error
     1967         or error-status :get-message(1) <> ""
     1968         then do:
     1969           undo move_block, retry move_block .
     1970         end.
     1971         assign
     1972           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1973           no-error .
     1974         if error-status :error
     1975         or error-status :get-message(1) <> ""
     1976         then do:
     1977           undo move_block, retry move_block .
     1978         end.
     1979         for each buf_temp-browse-handle
     1980           where buf_temp-browse-handle.browse-type = 'height':u
     1981         on error undo move_block, retry move_block
     1982         :
     1983           assign
     1984             buf_temp-browse-handle.browse-handle :height
     1985               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1986             no-error .
     1987           if error-status :error
     1988           or error-status :get-message(1) <> ""
     1989           then do:
     1990             undo move_block, retry move_block .
     1991           end.
     1992         end.
     1993         for each buf_temp-diasize-handle
     1994         on error undo move_block, retry move_block
     1995         :
     1996           assign
     1997             v-object-handle = buf_temp-diasize-handle.handle-value
     1998           .
     1999           if v-object-handle <> v-diasize-resize-button
     2000           then do:
     2001             assign
     2002               v-object-handle :row = v-object-handle :row + p-change-value
     2003               no-error .
     2004             if error-status :error
     2005             or error-status :get-message(1) <> ""
     2006             then do:
     2007               undo move_block, retry move_block .
     2008             end.
     2009           end.
     2010         end.
     2011       end.
     2012       else do:
     2013         for each buf_temp-diasize-handle
     2014         on error undo move_block, retry move_block
     2015         :
     2016           assign
     2017             v-object-handle = buf_temp-diasize-handle.handle-value
     2018           .
     2019           if v-object-handle <> v-diasize-resize-button
     2020           then do:
     2021             assign
     2022               v-object-handle :row = v-object-handle :row + p-change-value
     2023               no-error .
     2024             if error-status :error
     2025             or error-status :get-message(1) <> ""
     2026             then do:
     2027               undo move_block, retry move_block .
     2028             end.
     2029           end.
     2030         end.
     2031         assign
     2032           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2033           no-error .
     2034         if error-status :error
     2035         or error-status :get-message(1) <> ""
     2036         then do:
     2037           undo move_block, retry move_block .
     2038         end.
     2039         for each buf_temp-browse-handle
     2040           where buf_temp-browse-handle.browse-type = 'height':u
     2041         on error undo move_block, retry move_block
     2042         :
     2043           assign
     2044             buf_temp-browse-handle.browse-handle :height
     2045               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2046             no-error .
     2047           if error-status :error
     2048           or error-status :get-message(1) <> ""
     2049           then do:
     2050             undo move_block, retry move_block .
     2051           end.
     2052         end.
     2053         assign
     2054           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2055           no-error .
     2056         if error-status :error
     2057         or error-status :get-message(1) <> ""
     2058         then do:
     2059           undo move_block, retry move_block .
     2060         end.
     2061         if frame Dialog-Frame :scrollable = true
     2062         then do:
     2063           assign
     2064             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2065             no-error .
     2066           if error-status :error
     2067           or error-status :get-message(1) <> ""
     2068           then do:
     2069             undo move_block, retry move_block .
     2070           end.
     2071         end.
     2072       end.
     2073       if p-move-resize = true
     2074       then do:
     2075         run diasize_position-resize-button in this-procedure .
     2076       end.
     2077       if v-diasize-wndstore = true
     2078       then do:
     2079         if connected("ub") = true
     2080         then do:
     2081           define variable v-cntxt-db-num        as integer   no-undo .
     2082           define variable v-cntxt-userid        as character no-undo .
     2083           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2084                                             , OUTPUT v-cntxt-userid
     2085                                             ) .
     2086           run gbl/wndsizew.p
     2087             (input  v-cntxt-db-num
     2088             ,input  v-cntxt-userid
     2089             ,input  v-diasize-proc-name
     2090             ,input  'height':u
     2091             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2092             ) .
     2093         end.
     2094       end.
     2095     end.
     2096     assign
     2097       v-diasize-change-size = false
     2098     .
     2099   end procedure.
     2100   procedure diasize_set-height :
     2101     define input  parameter p-new-height  as decimal   no-undo .
     2102     define input  parameter p-move-resize as logical   no-undo .
     2103     do
     2104     on error undo, return error return-value
     2105     :
     2106       run diasize_change-height in this-procedure
     2107         (input  (p-new-height - frame Dialog-Frame :height)
     2108         ,input  p-move-resize
     2109         ) .
     2110     end.
     2111   end procedure.
     2112   procedure diasize_change-width :
     2113     define input  parameter p-change-value as decimal   no-undo .
     2114     define input  parameter p-move-resize  as logical   no-undo .
     2115     define variable v-field-group-handle   as handle    no-undo .
     2116     define variable v-object-handle        as handle    no-undo .
     2117     define variable v-frame-width          as decimal   no-undo .
     2118     define variable v-frame-virtual-width  as decimal   no-undo .
     2119     define variable v-browse-width         as decimal   no-undo .
     2120     define variable v-window-width         as decimal   no-undo .
     2121     define variable v-window-virtual-width as decimal   no-undo .
     2122     define variable v-change-sign          as integer   no-undo .
     2123     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2124     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2125     if p-change-value > 0
     2126     then do:
     2127       if frame Dialog-Frame :width + p-change-value >
     2128           session :width-chars
     2129       then do:
     2130         assign
     2131           p-change-value = session :width-chars - frame Dialog-Frame :width
     2132         .
     2133         if p-change-value <= 0
     2134         then do:
     2135           run diasize_position-resize-button in this-procedure .
     2136           return .
     2137         end.
     2138       end.
     2139     end.
     2140     if p-change-value < 0
     2141     then do:
     2142       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2143       then do:
     2144         assign
     2145           p-change-value = v-diasize-orig-frame-width
     2146                          - frame Dialog-Frame :width
     2147         .
     2148         if p-change-value >= 0
     2149         then do:
     2150           run diasize_position-resize-button in this-procedure .
     2151           return .
     2152         end.
     2153       end.
     2154     end.
     2155     if p-change-value >= 0
     2156     then do:
     2157       assign
     2158         v-change-sign = 1
     2159       .
     2160     end.
     2161     else do:
     2162       assign
     2163         v-change-sign = -1
     2164       .
     2165     end.
     2166     assign
     2167       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2168     .
     2169     if p-change-value = 0
     2170     then do:
     2171       run diasize_position-resize-button in this-procedure .
     2172       return .
     2173     end.
     2174     move_block:
     2175     do
     2176     on error undo move_block, leave move_block
     2177     :
     2178       if retry
     2179       then do:
     2180         do
     2181         on error undo move_block, leave move_block
     2182         :
     2183           if p-change-value > 0
     2184           then do:
     2185             for each buf_temp-diasize-handle
     2186             on error undo, next
     2187             :
     2188               assign
     2189                 v-object-handle = buf_temp-diasize-handle.handle-value
     2190               .
     2191               if v-object-handle <> v-diasize-resize-button
     2192               then do:
     2193                 assign
     2194                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2195                 .
     2196               end.
     2197             end.
     2198             assign
     2199               v-diasize-browse-handle :width = v-browse-width
     2200             .
     2201             for each buf_temp-browse-handle
     2202               where buf_temp-browse-handle.browse-type = 'width':u
     2203             on error undo, next
     2204             :
     2205               assign
     2206                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2207               .
     2208             end.
     2209             assign
     2210               frame Dialog-Frame :width = v-frame-width
     2211             .
     2212             if frame Dialog-Frame :scrollable = true
     2213             then do:
     2214               assign
     2215                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2216               .
     2217             end.
     2218             run diasize_position-resize-button in this-procedure .
     2219           end.
     2220           else do:
     2221             if frame Dialog-Frame :scrollable = true
     2222             then do:
     2223               assign
     2224                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2225               .
     2226             end.
     2227             assign
     2228               frame Dialog-Frame :width = v-frame-width
     2229             .
     2230             for each buf_temp-browse-handle
     2231               where buf_temp-browse-handle.browse-type = 'width':u
     2232             on error undo, next
     2233             :
     2234               assign
     2235                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2236               .
     2237             end.
     2238             assign
     2239               v-diasize-browse-handle :width = v-browse-width
     2240             .
     2241             for each buf_temp-diasize-handle
     2242             on error undo, next
     2243             :
     2244               assign
     2245                 v-object-handle = buf_temp-diasize-handle.handle-value
     2246               .
     2247               if v-object-handle <> v-diasize-resize-button
     2248               then do:
     2249                 assign
     2250                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2251                 .
     2252               end.
     2253             end.
     2254             run diasize_position-resize-button in this-procedure .
     2255           end.
     2256           assign
     2257             v-diasize-change-size = false
     2258           .
     2259           leave move_block .
     2260         end.
     2261       end.
     2262       assign
     2263         v-diasize-need-full-display = true
     2264       .
     2265       if v-diasize-change-size = false
     2266       then do:
     2267         assign
     2268           v-diasize-change-size = true
     2269         .
     2270       end.
     2271       else do:
     2272         return .
     2273       end.
     2274       assign
     2275         v-frame-width = frame Dialog-Frame :width
     2276         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2277         v-browse-width = v-diasize-browse-handle :width
     2278       .
     2279       for each buf_temp-browse-handle
     2280         where buf_temp-browse-handle.browse-type = 'width':u
     2281       :
     2282         assign
     2283           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2284         .
     2285       end.
     2286       for each buf_temp-diasize-handle
     2287       :
     2288         delete buf_temp-diasize-handle .
     2289       end.
     2290       assign
     2291         v-field-group-handle = frame Dialog-Frame :first-child
     2292       .
     2293       do while valid-handle(v-field-group-handle)
     2294       :
     2295         assign
     2296           v-object-handle = v-field-group-handle :first-child
     2297         .
     2298         do while valid-handle(v-object-handle)
     2299         :
     2300           if  v-object-handle <> v-diasize-browse-handle :handle
     2301           and v-object-handle <> v-diasize-resize-button
     2302           and can-query(v-object-handle, "row")
     2303           and can-query(v-object-handle, "height")
     2304           and ( v-object-handle :col + v-object-handle :width
     2305                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2306               )
     2307           then do:
     2308             find first buf_temp-browse-handle
     2309               where buf_temp-browse-handle.browse-type   = 'width':u
     2310                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2311               no-error .
     2312             if available buf_temp-browse-handle
     2313             then do:
     2314             end.
     2315             else do:
     2316               create buf_temp-diasize-handle .
     2317               assign
     2318                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2319                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2320               .
     2321             end.
     2322           end.
     2323           assign
     2324             v-object-handle = v-object-handle :next-sibling
     2325           .
     2326         end.
     2327         assign
     2328           v-field-group-handle = v-field-group-handle :next-sibling
     2329         .
     2330       end.
     2331       do with frame Dialog-Frame
     2332       :
     2333         hide v-diasize-resize-button .
     2334         v-diasize-resize-button :row = 1.
     2335         v-diasize-resize-button :column = 1.
     2336       end.
     2337       if p-change-value > 0
     2338       then do:
     2339         if frame Dialog-Frame :scrollable = true
     2340         then do:
     2341           assign
     2342             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2343             no-error .
     2344           if error-status :error
     2345           or error-status :get-message(1) <> ""
     2346           then do:
     2347             undo move_block, retry move_block.
     2348           end.
     2349         end.
     2350         assign
     2351           frame Dialog-Frame :width = v-frame-width + p-change-value
     2352           no-error .
     2353         if error-status :error
     2354         or error-status :get-message(1) <> ""
     2355         then do:
     2356           undo move_block, retry move_block.
     2357         end.
     2358         assign
     2359           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2360         no-error .
     2361         if error-status :error
     2362         or error-status :get-message(1) <> ""
     2363         then do:
     2364           undo move_block, retry move_block.
     2365         end.
     2366         for each buf_temp-browse-handle
     2367           where buf_temp-browse-handle.browse-type = 'width':u
     2368         on error undo move_block, retry move_block
     2369         :
     2370           assign
     2371             buf_temp-browse-handle.browse-handle :width
     2372               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2373             no-error .
     2374           if error-status :error
     2375           or error-status :get-message(1) <> ""
     2376           then do:
     2377             undo move_block, retry move_block .
     2378           end.
     2379         end.
     2380         for each buf_temp-diasize-handle
     2381         on error undo move_block, retry move_block
     2382         :
     2383           assign
     2384             v-object-handle = buf_temp-diasize-handle.handle-value
     2385           .
     2386           if v-object-handle <> v-diasize-resize-button
     2387           then do:
     2388             assign
     2389               v-object-handle :col = v-object-handle :col + p-change-value
     2390               no-error .
     2391             if error-status :error
     2392             or error-status :get-message(1) <> ""
     2393             then do:
     2394               undo move_block, retry move_block .
     2395             end.
     2396           end.
     2397         end.
     2398       end.
     2399       else do:
     2400         for each buf_temp-diasize-handle
     2401         on error undo move_block, retry move_block
     2402         :
     2403           assign
     2404             v-object-handle = buf_temp-diasize-handle.handle-value
     2405           .
     2406           if v-object-handle <> v-diasize-resize-button
     2407           then do:
     2408             assign
     2409               v-object-handle :col = v-object-handle :col + p-change-value
     2410               no-error .
     2411             if error-status :error
     2412             or error-status :get-message(1) <> ""
     2413             then do:
     2414               undo move_block, retry move_block .
     2415             end.
     2416           end.
     2417         end.
     2418         for each buf_temp-browse-handle
     2419           where buf_temp-browse-handle.browse-type = 'width':u
     2420         on error undo move_block, retry move_block
     2421         :
     2422           assign
     2423             buf_temp-browse-handle.browse-handle :width
     2424               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2425             no-error .
     2426           if error-status :error
     2427           or error-status :get-message(1) <> ""
     2428           then do:
     2429             undo move_block, retry move_block .
     2430           end.
     2431         end.
     2432         assign
     2433           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2434           no-error .
     2435         if error-status :error
     2436         or error-status :get-message(1) <> ""
     2437         then do:
     2438           undo move_block, retry move_block.
     2439         end.
     2440         assign
     2441           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2442         no-error .
     2443         if error-status :error
     2444         or error-status :get-message(1) <> ""
     2445         then do:
     2446           undo move_block, retry move_block.
     2447         end.
     2448         if frame Dialog-Frame :scrollable = true
     2449         then do:
     2450           assign
     2451             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2452           no-error .
     2453           if error-status :error
     2454           or error-status :get-message(1) <> ""
     2455           then do:
     2456             undo move_block, retry move_block.
     2457           end.
     2458         end.
     2459       end.
     2460       if p-move-resize
     2461       then do:
     2462         run diasize_position-resize-button in this-procedure .
     2463       end.
     2464       if v-diasize-wndstore = true
     2465       then do:
     2466         if connected("ub") = true
     2467         then do:
     2468           define variable v-cntxt-db-num        as integer   no-undo .
     2469           define variable v-cntxt-userid        as character no-undo .
     2470           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2471                                             , OUTPUT v-cntxt-userid
     2472                                             ) .
     2473           run gbl/wndsizew.p
     2474             (input  v-cntxt-db-num
     2475             ,input  v-cntxt-userid
     2476             ,input  v-diasize-proc-name
     2477             ,input  'width':u
     2478             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2479             ) .
     2480         end.
     2481       end.
     2482     end.
     2483     assign
     2484       v-diasize-change-size = false
     2485     .
     2486   end procedure.
     2487   procedure diasize_set-width :
     2488     define input  parameter p-new-width  as decimal   no-undo .
     2489     define input  parameter p-move-resize as logical   no-undo .
     2490     do
     2491     on error undo, return error return-value
     2492     :
     2493       run diasize_change-width in this-procedure
     2494         (input  (p-new-width - frame Dialog-Frame :width)
     2495         ,input  p-move-resize
     2496         ) .
     2497     end.
     2498   end procedure.
     2499   procedure diasize_position-resize-button :
     2500     do with frame Dialog-Frame
     2501     :
     2502       hide v-diasize-resize-button .
     2503       assign
     2504         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2505                     - 1
     2506                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2507         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2508                     - 1
     2509                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2510       .
     2511       view v-diasize-resize-button .
     2512     end.
     2513   end procedure.
     2514   on alt-right anywhere
     2515   do:
     2516     run diasize_change-width in this-procedure
     2517       (input 1
     2518       ,input true
     2519       ) .
     2520     return no-apply .
     2521   end.
     2522   on alt-left anywhere
     2523   do:
     2524     run diasize_change-width in this-procedure
     2525       (input -1
     2526       ,input true
     2527       ) .
     2528     return no-apply .
     2529   end.
     2530   on alt-down anywhere
     2531   do:
     2532     run diasize_change-height in this-procedure
     2533       (input 1
     2534       ,input true
     2535       ) .
     2536     return no-apply .
     2537   end.
     2538   on alt-up anywhere
     2539   do:
     2540     run diasize_change-height in this-procedure
     2541       (input -1
     2542       ,input true
     2543       ) .
     2544     return no-apply .
     2545   end.
     2546   on alt-enter of frame Dialog-Frame
     2547   do:
     2548     run diasize_maximize in this-procedure
     2549       (input  ?
     2550       ).
     2551     return no-apply .
     2552   end.
     2553   procedure diasize_end-move :
     2554     do
     2555     on error undo, return error return-value
     2556     :
     2557       define variable v-row-delta as decimal   no-undo .
     2558       define variable v-col-delta as decimal   no-undo .
     2559       define variable v-new-row as decimal   no-undo .
     2560       define variable v-new-col as decimal   no-undo .
     2561       assign
     2562         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2563         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2564       .
     2565       assign
     2566         v-row-delta = v-new-row - frame Dialog-Frame :height
     2567         v-col-delta = v-new-col - frame Dialog-Frame :width
     2568       .
     2569       run diasize_change-height in this-procedure
     2570         (input v-row-delta
     2571         ,input true
     2572         ) .
     2573       run diasize_change-width in this-procedure
     2574         (input v-col-delta
     2575         ,input true
     2576         ) .
     2577     end.
     2578   end procedure.
     2579   procedure diasize_maximize :
     2580     define input  parameter p-action as logical   no-undo .
     2581     do
     2582     on error undo, return error return-value
     2583     :
     2584       if p-action = ?
     2585       then do:
     2586         if v-diasize-need-maximize = true
     2587         then do:
     2588           assign
     2589             p-action = true
     2590           .
     2591         end.
     2592         else do:
     2593           assign
     2594             p-action = false
     2595           .
     2596         end.
     2597       end.
     2598       if p-action = true
     2599       then do:
     2600         run diasize_change-height in this-procedure
     2601           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2602               - frame Dialog-Frame :height-chars
     2603           ,input true
     2604           ) .
     2605         run diasize_change-width in this-procedure
     2606           (input session :width-chars
     2607               - frame Dialog-Frame :width-chars
     2608           ,input true
     2609           ) .
     2610         assign
     2611           v-diasize-need-maximize = false
     2612         .
     2613       end.
     2614       else do:
     2615         run diasize_change-width in this-procedure
     2616           (input v-diasize-orig-frame-width
     2617               - frame Dialog-Frame :width-chars
     2618           ,input true
     2619           ) .
     2620         run diasize_change-height in this-procedure
     2621           (input v-diasize-orig-frame-height
     2622               - frame Dialog-Frame :height-chars
     2623           ,input true
     2624           ) .
     2625         assign
     2626           v-diasize-need-maximize = true
     2627         .
     2628       end.
     2629     end.
     2630   end procedure.
     2631   procedure diasize_restore-orig-size :
     2632     do
     2633     on error undo, return error return-value
     2634     :
     2635       assign
     2636         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2637         v-diasize-current-frame-height = frame Dialog-Frame :height
     2638       .
     2639       run diasize_set-height in this-procedure
     2640         (input  v-diasize-orig-frame-height
     2641         ,input  true
     2642         ) .
     2643       run diasize_set-width in this-procedure
     2644         (input  v-diasize-orig-frame-width
     2645         ,input  true
     2646         ) .
     2647     end.
     2648   end procedure.
     2649   procedure diasize_restore-current-size :
     2650     do
     2651     on error undo, return error return-value
     2652     :
     2653       run diasize_set-height in this-procedure
     2654         (input  v-diasize-current-frame-height
     2655         ,input  true
     2656         ) .
     2657       run diasize_set-width in this-procedure
     2658         (input  v-diasize-current-frame-width
     2659         ,input  true
     2660         ) .
     2661     end.
     2662   end procedure.
     2663   procedure diasize_set-browse-handle :
     2664     define input  parameter p-browse-handle as handle   no-undo .
     2665     define buffer buf_temp-browse-handle for temp-browse-handle .
     2666     do
     2667     on error undo, return error return-value
     2668     :
     2669       assign
     2670         v-diasize-browse-handle = p-browse-handle
     2671       .
     2672       for each buf_temp-browse-handle
     2673       on error undo, return error return-value
     2674       :
     2675         delete buf_temp-browse-handle .
     2676       end.
     2677     end.
     2678   end procedure.
     2679   procedure diasize_add_browse :
     2680     define input  parameter p-browse-type   as character no-undo .
     2681     define input  parameter p-browse-handle as handle    no-undo .
     2682     define buffer buf_temp-browse-handle for temp-browse-handle .
     2683     do
     2684     on error undo, return error return-value
     2685     :
     2686       assign
     2687         v-diasize-browse-number = v-diasize-browse-number + 1
     2688       .
     2689       create buf_temp-browse-handle .
     2690       assign
     2691         buf_temp-browse-handle.browse-type   = p-browse-type
     2692         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2693         buf_temp-browse-handle.browse-handle = p-browse-handle
     2694       .
     2695     end.
     2696   end procedure.
     2697   procedure diasize_init :
     2698     define variable v-default-value    as logical   no-undo .
     2699     define variable v-restore-saved    as logical   no-undo .
     2700     define variable v-resize-value-str as character no-undo .
     2701     do
     2702     on error undo, return error return-value
     2703     :
     2704       do with frame Dialog-Frame
     2705       :
     2706         assign
     2707           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2708           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2709           v-diasize-browse-handle     = browse br-c-sert :handle
     2710         .
     2711         create button v-diasize-resize-button
     2712         assign
     2713           parent        = frame Dialog-Frame :first-child
     2714           label         = "s"
     2715           height-pixels = 16
     2716           width-pixels  = 16
     2717           visible       = true
     2718           sensitive     = true
     2719           movable       = true
     2720           triggers:
     2721             on end-move persistent run diasize_end-move in this-procedure .
     2722           end triggers.
     2723         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2724         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2725         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2726         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2727         assign
     2728           v-diasize-wndmax = false
     2729         .
     2730         if connected("ub") = true
     2731         then do:
     2732           define variable v-cntxt-db-num        as integer   no-undo .
     2733           define variable v-cntxt-userid        as character no-undo .
     2734           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2735                                             , OUTPUT v-cntxt-userid
     2736                                             ) .
     2737           run gbl/wndpar_r.p
     2738             (input  v-cntxt-db-num
     2739             ,input  v-cntxt-userid
     2740             ,input  'wndmax':U
     2741             ,output v-diasize-wndmax
     2742             ,output v-default-value
     2743             ) .
     2744         end.
     2745         assign
     2746           v-diasize-wndstore = false
     2747         .
     2748         if connected("ub") = true
     2749         then do:
     2750           run gbl/wndpar_r.p
     2751             (input  v-cntxt-db-num
     2752             ,input  v-cntxt-userid
     2753             ,input  'wndstore':U
     2754             ,output v-diasize-wndstore
     2755             ,output v-default-value
     2756             ) .
     2757         end.
     2758         assign
     2759           v-diasize-proc-name = entry(1, program-name(2), '.')
     2760         .
     2761         if v-diasize-wndstore = true
     2762         then do:
     2763           assign
     2764             v-restore-saved = false
     2765           .
     2766           if connected("ub") = true
     2767           then do:
     2768             run gbl/wndsizer.p
