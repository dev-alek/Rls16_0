     4797   0 @ sch-sert-code
     4798   with frame Dialog-Frame.
     4799   p-user = chr(34) + p-user + chr(34).
     4800   run OpenBr in this-procedure
     4801       (input false
     4802       ,input p-next
     4803       ,input substitute("and X_c-sert.corr-user-name = &1 "
     4804         , p-user)
     4805       ).
     4806   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     4807   END PROCEDURE.
     4808   PROCEDURE proc-view-changes :
     4809   define variable v-description as character no-undo .
     4810   for each temp-changes:
     4811       delete temp-changes.
     4812   END.
     4813   if not available X_c-sert then do:
     4814     Open QUery br-changes for each temp-changes.
     4815     return.
     4816   end.
     4817   run ref/c-sertv.p (
     4818                      input X_c-sert.cli-type
     4819                     ,input X_c-sert.cli-code
     4820                     ,input X_c-sert.sert-code
     4821                     ,input X_c-sert.b-code
     4822                     ,input X_c-sert.chip-num
     4823                     ,input X_c-sert.corr-user-db-num
     4824                     ,input X_c-sert.subject
     4825                     ,input X_c-sert.action
     4826                     ,input no
     4827                     ,output v-description
     4828                  ) no-error .
     4829   Open QUery br-changes for each temp-changes.
     4830   assign
     4831   br-changes:title in frame Dialog-Frame = v-description
     4832   .
     4833   END PROCEDURE.
     4834   FUNCTION get-action RETURNS CHARACTER
     4835     ( p-action as integer ) :
     4836     define variable dops as character no-undo.
     4837   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     4838   RETURN dops.
     4839   END FUNCTION.
     4840   FUNCTION get-subject RETURNS CHARACTER
     4841     ( p-subject as character ) :
     4842     RETURN entry (lookup (p-subject, 'sert,sert-join':U), 'Сертификат,Сертификат на товар':U).
     4843   END FUNCTION.
