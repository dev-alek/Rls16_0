     3117   def var sort-labelbr-c-sert   as character no-undo .
     3118   def var sort-clmnbr-c-sert    as handle    no-undo .
     3119   def var cur-clmnbr-c-sert     as handle    no-undo .
     3120   def var cur-clmn-locbr-c-sert as integer   no-undo .
     3121   def var re-querybr-c-sert     as logical   initial no no-undo .
     3122   on start-search, ctrl-o of br-c-sert in frame Dialog-Frame do:
     3123      run sort-brbr-c-sert
     3124        (input (if available X_c-sert
     3125                then recid(X_c-sert)
     3126                else ?
     3127               )
     3128        ).
     3129   end.
     3130   PROCEDURE sort-brbr-c-sert :
     3131     define input parameter p-recid as recid no-undo .
     3132     if re-querybr-c-sert = no then do:
     3133       assign
     3134          cur-clmnbr-c-sert = br-c-sert:current-column in frame Dialog-Frame
     3135       .
     3136       if sort-clmnbr-c-sert <> ? then sort-clmnbr-c-sert:column-fgcolor = 0.
     3137       if cur-clmnbr-c-sert = sort-clmnbr-c-sert then do:
     3138         assign
     3139            sort-labelbr-c-sert = ""
     3140            sort-clmnbr-c-sert = ?
     3141         .
     3142        end.
     3143        else do:
     3144          assign
     3145            sort-labelbr-c-sert = cur-clmnbr-c-sert:label
     3146            sort-clmnbr-c-sert  = cur-clmnbr-c-sert
     3147            sort-clmnbr-c-sert:column-fgcolor = 4
     3148          .
     3149        end.
     3150      end.
     3151     assign
     3152       cur-clmn-locbr-c-sert = 1
     3153     .
     3154     def var column-handle as handle no-undo .
     3155     column-handle = br-c-sert:first-column.
     3156     do while valid-handle(column-handle) :
     3157       if column-handle = cur-clmnbr-c-sert then do:
     3158         leave .
     3159       end.
     3160       column-handle = column-handle:NEXT-COLUMN.
     3161       assign
     3162         cur-clmn-locbr-c-sert = cur-clmn-locbr-c-sert + 1
     3163       .
     3164     end.
     3165     case sort-labelbr-c-sert:
     3166           when X_c-sert.sert-code:label in browse br-c-sert then DO:    assign       sort-column-name = "X_c-sert.sert-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3167           when X_c-sert.corr-date:label in browse br-c-sert then DO:    assign       sort-column-name = "X_c-sert.corr-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3168           when X_c-sert.corr-user-db-num:label in browse br-c-sert then DO:    assign       sort-column-name = "X_c-sert.corr-user-db-num"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3169       otherwise do:
     3170         assign
     3171           sort-column-name = ""
     3172         .
     3173         run OpenBr in this-procedure ( input yes, input no, input '':U).
     3174           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-c-sert') then do:
     3175             run mv-brw-defaultbr-c-sert.
     3176           end.
     3177         if sort-labelbr-c-sert <> "" then do:
     3178           assign
     3179             cur-clmnbr-c-sert:column-fgcolor = 0
     3180           .
     3181         end.
     3182         assign
     3183           cur-clmn-locbr-c-sert = ?
     3184         .
     3185       end.
     3186     end case.
     3187       if cur-clmn-locbr-c-sert <> ? then do:
     3188         if can-do( this-procedure:internal-entries, 'ch-clmnbr-c-sert') then do:
     3189           run ch-clmnbr-c-sert in this-procedure (cur-clmn-locbr-c-sert).
     3190         end.
     3191       end.
     3192     if p-recid <> ? then do:
     3193       reposition br-c-sert to recid p-recid no-error.
     3194       apply "value-changed" to br-c-sert in frame Dialog-Frame.
     3195     end.
     3196     apply "entry" to br-c-sert in frame Dialog-Frame.
     3197   END PROCEDURE.
     3198   procedure re-open-query-srt-clmnbr-c-sert:
     3199   if cur-clmnbr-c-sert = ? then do:
     3200      run OpenBr in this-procedure ( input yes, input no, input '':U).
     3201   end.
     3202   else do:
     3203      assign re-querybr-c-sert = yes.
     3204      run sort-brbr-c-sert
     3205        (input (if available X_c-sert
     3206                then recid(X_c-sert)
     3207                else ?
     3208               )
     3209        ).
     3210      assign re-querybr-c-sert = no.
     3211   end.
     3212   end.
