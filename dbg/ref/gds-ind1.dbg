        1   block-level on error undo, throw.
        2   define temp-table tt0-gds-obj-prop-attr no-undo like  ub.gds-obj-prop-attr.
        3   define input-output parameter p-doc-rec  as recid no-undo.
        4   define input  parameter p-gds-code                   like  ub.gds-obj-prop.gds-code no-undo.
        5   define input  parameter p-obj-type                   like  ub.gds-obj-prop.obj-type no-undo.
        6   define input  parameter p-obj-code                   like  ub.gds-obj-prop.obj-code no-undo.
        7   define input  parameter p-gdop-igt                   like  ub.gds-obj-prop.gdop-igt no-undo.
        8   define input  parameter p-gdop-assort-min            like  ub.gds-obj-prop.gdop-assort-min  no-undo.
        9   define input  parameter p-gdop-min-stock             like  ub.gds-obj-prop.gdop-min-stock   no-undo.
       10   define input  parameter p-grop-level-always-presence like  ub.gds-obj-prop.grop-level-always-presence  no-undo.
       11   define input  parameter p-grop-max-stock             like  ub.gds-obj-prop.grop-max-stock              no-undo.
       12   define input  parameter p-grop-min-order             like  ub.gds-obj-prop.grop-min-order              no-undo.
       13   define input  parameter table for tt0-gds-obj-prop-attr  .
       14   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       15   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       16   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile: gds-ind1.p $":U .
       18   define variable vss-archive     as character no-undo init "$Archive: ref/gds-ind1.p $":U .
       19   define variable vss-description as character no-undo init "Сохранение изменений в gds-obj-prop".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
