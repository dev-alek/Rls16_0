      468   procedure gds-ind1 :
      469   main-block:
      470     do
      471   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      472   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      473   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      474     :
      475   define input-output parameter p-doc-rec  as recid no-undo.
      476   define input  parameter p-gds-code                   like  ub.gds-obj-prop.gds-code no-undo.
      477   define input  parameter p-obj-type                   like  ub.gds-obj-prop.obj-type no-undo.
      478   define input  parameter p-obj-code                   like  ub.gds-obj-prop.obj-code no-undo.
      479   define input  parameter p-gdop-igt                   like  ub.gds-obj-prop.gdop-igt no-undo.
      480   define input  parameter p-gdop-assort-min            like  ub.gds-obj-prop.gdop-assort-min  no-undo.
      481   define input  parameter p-gdop-min-stock             like  ub.gds-obj-prop.gdop-min-stock   no-undo.
      482   define input  parameter p-grop-level-always-presence like  ub.gds-obj-prop.grop-level-always-presence  no-undo.
      483   define input  parameter p-grop-max-stock             like  ub.gds-obj-prop.grop-max-stock              no-undo.
      484   define input  parameter p-grop-min-order             like  ub.gds-obj-prop.grop-min-order              no-undo.
      485   DEFINE INPUT  PARAMETER TABLE  FOR tt0-gds-obj-prop-attr.
      486   define buffer buf_tt0-gds-obj-prop-attr for tt0-gds-obj-prop-attr.
      487   define buffer bufs_gds-obj-prop for ub.gds-obj-prop.
      488   define variable v-db-num like ub.db.db-num no-undo .
      489   define variable v-db-num-obj like ub.db.db-num no-undo .
      490   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      491   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      492     (output v-db-num
      493     )  .
      494   define variable v-date as date no-undo .
      495   define variable v-time as integer no-undo .
      496   run cur-time in this-procedure(output v-date, output v-time).
      497     find first bufs_gds-obj-prop exclusive-lock where
      498               bufs_gds-obj-prop.gds-code          = p-gds-code   and
      499               bufs_gds-obj-prop.obj-type          = p-obj-type   and
      500               bufs_gds-obj-prop.obj-code          = p-obj-code  no-error .
      501       if not available bufs_gds-obj-prop then do:
      502           create bufs_gds-obj-prop.
      503           assign
      504               bufs_gds-obj-prop.gds-code           = p-gds-code
      505               bufs_gds-obj-prop.grop-date-update   = v-date
      506               bufs_gds-obj-prop.grop-time-update   = v-time
      507               bufs_gds-obj-prop.grop-db-num-update = v-db-num
      508               bufs_gds-obj-prop.obj-type           = p-obj-type
      509               bufs_gds-obj-prop.obj-code           = p-obj-code
      510           no-error .
      511           if error-status :error then message "Ошибка при создании записи" error-status :error error-status :get-message(1) .
      512       end.
      513   if  p-gdop-igt                     <> ? then    bufs_gds-obj-prop.gdop-igt                   = p-gdop-igt.
      514   if  p-gdop-assort-min              <> ? then    bufs_gds-obj-prop.gdop-assort-min            = p-gdop-assort-min.
      515   if  p-gdop-min-stock               <> ? then    bufs_gds-obj-prop.gdop-min-stock             = p-gdop-min-stock  .
      516   if  p-grop-level-always-presence   <> ? then    bufs_gds-obj-prop.grop-level-always-presence = p-grop-level-always-presence.
      517   if  p-grop-max-stock               <> ? then    bufs_gds-obj-prop.grop-max-stock             = p-grop-max-stock           .
      518   if  p-grop-min-order               <> ? then    bufs_gds-obj-prop.grop-min-order             = p-grop-min-order           .
      519         p-doc-rec = recid(bufs_gds-obj-prop)    .
      520   for each buf_tt0-gds-obj-prop-attr
      521   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      522   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      523   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      524   :
      525     if buf_tt0-gds-obj-prop-attr.attr-value <> ?
      526     and lookup(buf_tt0-gds-obj-prop-attr.attr-code, 'CorrIztDel':u) = 0
      527     then do:
      528       run gdspoatr-write in this-procedure (
      529                                               input p-gds-code
      530                                               ,input p-obj-type
      531                                               ,input p-obj-code
      532                                               ,input buf_tt0-gds-obj-prop-attr.attr-code
      533                                               ,input buf_tt0-gds-obj-prop-attr.attr-value
      534                                               ).
      535     end.
      536   end.
      537   end.
      538   end procedure.
      539   _MAIN:
      540   DO ON ERROR UNDO, RETURN ERROR
      541   ON STOP UNDO, RETURN ERROR:
      542       run gds-ind1
      543           (input-output p-doc-rec
      544           ,p-gds-code
      545           ,p-obj-type
      546           ,p-obj-code
      547           ,p-gdop-igt
      548           ,p-gdop-assort-min
      549           ,p-gdop-min-stock
      550           ,p-grop-level-always-presence
      551           ,p-grop-max-stock
      552           ,p-grop-min-order
      553           ,input table tt0-gds-obj-prop-attr
      554           ) no-error .
      555           if error-status :error then
      556           message vss-workfile vss-revision vss-description skip
      557                   return-value skip
      558                   error-status :get-message(1)
      559                   view-as alert-box error
      560           .
      561   end.
