        1   define input parameter is-full as logical.
        2   define output parameter parrid as recid initial ? no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Просмотр справочника кодов ТНВЭД СНГ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   DEFINE  SHARED TEMP-TABLE TT-tnved NO-UNDO
       69   FIELD tnved  AS CHAR FORMAT "X(10)"  LABEL 'Код ТНВЭД':U
       70   FIELD f-name AS CHAR FORMAT "X(255)" LABEL 'Полное наименование':U
       71   INDEX tnved IS UNIQUE PRIMARY  tnved.
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
      117   DEFINE BUTTON b-exit AUTO-GO
      118        LABEL "&Выход ":L
      119        SIZE 9 BY 1.
      120   DEFINE BUTTON b-sel AUTO-GO
      121        LABEL "Вы&бор ":L
      122        SIZE 9 BY 1.
      123   DEFINE BUTTON b-help
      124        LABEL "Помо&щь":L
      125        SIZE 9 BY 1.
      126   DEFINE QUERY br-tnved FOR TT-tnved SCROLLING.
      127   DEFINE VARIABLE varEmptyString AS CHAR INITIAL "______ " NO-UNDO.
      128   DEFINE VARIABLE loc-tnv AS CHAR FORMAT "X(9)" NO-UNDO.
      129   DEFINE BROWSE br-tnved QUERY br-tnved NO-LOCK DISPLAY
      130   SUBSTRING(varEmptyString, 1, 10 - LENGTH(TT-tnved.tnved)) +
      131   TT-tnved.tnved @ TT-tnved.tnved TT-tnved.f-name FORMAT 'X(255)'
      132   WITH SIZE 96 BY 19 separators.
      133   DEFINE FRAME frame-tnved
      134   b-exit  AT ROW 1 COL 1
      135   b-sel   AT ROW 1 COL 11
      136   b-help  AT ROW 1 COL 21
      137   br-tnved AT ROW 2 COL 1
      138   loc-tnv NO-LABEL AT ROW 21.5 COL 1
      139   WITH KEEP-TAB-ORDER VIEW-AS DIALOG-BOX SIDE-LABELS THREE-D SCROLLABLE
      140   SIZE 98 BY 23 TITLE "СПРАВОЧНИК ТНВЭД".
      141   ASSIGN FRAME frame-tnved:SCROLLABLE       = FALSE.
      142   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      143   on F1 of frame frame-tnved anywhere do:
      144     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame frame-tnved. END.
      145     return no-apply.
      146   end.
      147   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      148   on F2 of frame frame-tnved anywhere do:
      149     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame frame-tnved. END.
      150     return no-apply.
      151   end.
      152   on choose of b-sel in frame frame-tnved do:
      153      if not available TT-tnved then do:   message "Неправильно выбран код ТНВЭД.".   return no-apply. end.
      154      parrid = recid (TT-tnved).
      155   end.
      156   on choose of b-exit in frame frame-tnved do:
      157      parrid = ?.
      158   end.
      159   ON MOUSE-SELECT-DBLCLICK, return of browse br-tnved DO:
      160      APPLY "choose" to b-sel in FRAME frame-tnved.
      161      RETURN NO-APPLY.
      162   END.
      163   on any-printable of browse br-tnved do:
      164    find first TT-tnved where TT-tnved.tnved begins (loc-tnv + last-event:label) no-lock no-error.
      165    if available TT-tnved then do:
      166       loc-tnv = loc-tnv + last-event:label.
      167       disp loc-tnv with frame frame-tnved.
      168       reposition br-tnved to recid RECID(TT-tnved) no-error.
      169     end.
      170   end.
      171   on backspace of browse br-tnved do:
      172       loc-tnv = substr (loc-tnv, 1, length (loc-tnv) - 1).
      173       find first TT-tnved where TT-tnved.tnved begins loc-tnv no-lock.
      174       disp loc-tnv with frame frame-tnved.
      175       if available TT-tnved then reposition br-tnved to recid RECID(TT-tnved) no-error.
      176   end.
      177   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME frame-tnved:PARENT eq ?
      178   THEN FRAME frame-tnved:PARENT = ACTIVE-WINDOW.
      179   ON WINDOW-CLOSE OF FRAME frame-tnved APPLY "END-ERROR":U TO SELF.
      180   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      181   on help of frame frame-tnved
      182   do:
      183     run gbl/app_help.p
      184       (input this-procedure :file-name
      185       ,input ''
      186       ,input ?
      187       ) no-error.
      188     if error-status :error then do:
      189       message
      190         "Ошибка при вызове помощи"
      191         error-status :get-message(1)
      192         view-as alert-box .
      193     end.
      194   end.
      195   run minbtn-set in this-procedure .
      196   on choose of b-help in frame frame-tnved
      197   do:
      198     apply "help":u to frame frame-tnved .
      199   end.
      200   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      201   procedure minbtn-set :
      202       do
      203           on error undo, return error return-value
      204           :
      205           define variable ii              as integer       no-undo .
      206           define variable fh              as widget-handle no-undo .
      207           define variable hh              as widget-handle no-undo .
      208           define variable v-h             as handle        extent 4 no-undo .
      209           define variable v-name-button   as character     no-undo .
      210           define variable v-help-old-x    as decimal       no-undo .
      211           define variable v-help-old-y    as decimal       no-undo .
      212           define variable v-help-old-size as decimal       no-undo .
      213           define variable v-frame-width   as decimal       no-undo .
      214           define variable jj              as integer       no-undo .
      215           do
      216               on error undo, return error
      217               :
      218               assign
      219                   v-frame-width = frame frame-tnved:width - 0.3
      220                   fh            = frame frame-tnved:first-child
      221                   hh            = fh:first-child
      222                   ii            = 1
      223                   .
      224               do while valid-handle(hh):
      225                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      226                   do:
      227                       case lc(hh:name) :
      228                           when "b-help" then
      229                               do:
      230                                   hh:load-image-up("cmp/b-help.bmp":u) .
      231                                   hh:load-image-down("cmp/b-help.bmp":u) .
      232                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      233                                   hh:TOOLTIP = "Помощь" .
      234                                   v-help-old-x = hh:column .
      235                                   v-help-old-y = hh:row    .
      236                                   v-help-old-size = hh:width .
      237                                   hh:width-chars = 2.5 .
      238                               end.
      239                           when "b-print" then
      240                               do:
      241                                   hh:load-image("cmp/b-print.bmp":u) .
      242                                   hh:TOOLTIP = "Печать" .
      243                                   v-h[ii] = hh:handle .
      244                                   ii = ii + 1 .
      245                                   hh:width-chars = 3 .
      246                               end.
      247                           when "b-history" or
      248                           when "b-hist" then
      249                               do:
      250                                   hh:load-image("cmp/b-hist.bmp":u) .
      251                                   hh:TOOLTIP = "История" .
      252                                   v-h[ii] = hh:handle .
      253                                   ii = ii + 1 .
      254                                   hh:width-chars = 3 .
      255                               end.
      256                           when "b-sch" then
      257                               do:
      258                                   hh:load-image("cmp/b-sch.bmp":u) .
      259                                   hh:TOOLTIP = "Установка Фильтра" .
      260                                   v-h[ii] = hh:handle .
      261                                   ii = ii + 1 .
      262                                   hh:width-chars = 3 .
      263                               end.
      264                           when "b-hist-user" then
      265                               do:
      266                                   hh:load-image("cmp/b-hist.bmp":u) .
      267                                   hh:TOOLTIP = "История пользователя" .
      268                                   ii = ii + 1 .
      269                               end.
      270                       end case.
      271                   end.
      272                   hh = hh:next-sibling.
      273               end.
      274               b-help:column = v-frame-width - b-help:width-chars.
      275               jj = 0.
      276               repeat ii = 4 to 1 by -1 :
      277                   if valid-handle (v-h[ii] ) then
      278                   do:
      279                       jj  = jj + 1 .
      280                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      281                       v-h[ii]:row    = v-help-old-y .
      282                   end.
      283               end.
      284           end.
      285       end.
      286   end procedure.
      287   run ui-on in this-procedure .
      288   wait-for go of frame frame-tnved focus br-tnved.
      289   run disable_ui in this-procedure .
      290   PROCEDURE disable_UI :
      291     DISABLE ALL WITH FRAME frame-tnved.
      292     HIDE FRAME frame-tnved.
      293   END PROCEDURE.
      294   PROCEDURE UI-on :
      295      OPEN QUERY br-tnved   FOR EACH TT-tnved    WHERE NOT is-full OR LENGTH(TRIM(TT-tnved.tnved)) = 10   NO-LOCK.
      296      ENABLE ALL WITH FRAME frame-tnved.
      297      DISABLE loc-tnv WITH FRAME frame-tnved.
      298   END PROCEDURE.
