        1   DEFINE TEMP-TABLE tt-tax NO-UNDO LIKE ub.tax.
        2   DEFINE TEMP-TABLE tt-tax-units NO-UNDO LIKE ub.tax-units
        3          field is-found as logical column-label ""
        4          index pi is unique primary tax-code type.
        5   def input parameter ref-mode as char no-undo.
        6   def input-output param rid as recid init ? no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision$":u .
        8   define variable vss-author      as character no-undo init "$Author$":u .
        9   define variable vss-date        as character no-undo init "$Date$":u .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       11   define variable vss-archive     as character no-undo init "$Archive$":u .
       12   define variable vss-description as character no-undo init "Карточка вида налога" .
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118   FUNCTION get-description RETURNS CHARACTER
      119     ( input partype as character )  FORWARD.
      120   DEFINE BUTTON B-exit AUTO-GO
      121        LABEL "&Ввод "
      122        SIZE 10 BY 1
      123        BGCOLOR 8 .
      124   DEFINE BUTTON B-Help
      125        LABEL "Помо&щь"
      126        SIZE 10 BY 1
      127        BGCOLOR 8 .
      128   DEFINE BUTTON B-mark
      129        LABEL "&*"
      130        SIZE 3 BY 1.
      131   DEFINE BUTTON B-quit AUTO-END-KEY
      132        LABEL "&Отмена"
      133        SIZE 10 BY 1
      134        BGCOLOR 8 .
      135   DEFINE VARIABLE TaxType AS CHARACTER FORMAT "X(256)":U
      136        LABEL "Тип налога"
      137        VIEW-AS COMBO-BOX INNER-LINES 5
      138        LIST-ITEMS "Item 1"
      139        SIZE 19.5 BY 1 NO-UNDO.
      140   DEFINE QUERY BR-tt-tax-units FOR
      141         tt-tax-units SCROLLING.
      142   DEFINE QUERY D-add-tax FOR
      143         tt-tax SCROLLING.
      144   DEFINE BROWSE BR-tt-tax-units
      145     QUERY BR-tt-tax-units DISPLAY
      146         is-found FORMAT "+/"
      147         tt-tax-units.type COLUMN-LABEL "" FORMAT "X(3)"
      148         get-description(tt-tax-units.type) COLUMN-LABEL "Тип товара" FORMAT "X(12)"
      149       WITH NO-ROW-MARKERS SEPARATORS SIZE 21.13 BY 10.13
      150            TITLE "Налог определен для:".
      151   DEFINE FRAME D-add-tax
      152        B-exit AT ROW 1 COL 1
      153        B-quit AT ROW 1 COL 11
      154        B-Help AT ROW 1 COL 41
      155        B-mark AT ROW 1.83 COL 54.75
      156        tt-tax.tax-code AT ROW 3.04 COL 14.63 COLON-ALIGNED
      157             LABEL "Код"
      158             VIEW-AS FILL-IN
      159             SIZE 6 BY 1
      160        BR-tt-tax-units AT ROW 3.04 COL 54.5
      161        TaxType AT ROW 4.42 COL 14.63 COLON-ALIGNED
      162        tt-tax.tax-name AT ROW 6.42 COL 14.63 COLON-ALIGNED
      163             LABEL "Название"
      164             VIEW-AS FILL-IN
      165             SIZE 33.5 BY 1
      166        tt-tax.to-cashdesk AT ROW 8.08 COL 16.63
      167             VIEW-AS TOGGLE-BOX
      168             SIZE 25.38 BY .96
      169        tt-tax.individual AT ROW 9.83 COL 16.63
      170             VIEW-AS TOGGLE-BOX
      171             SIZE 25.38 BY 1
      172        SPACE(56.86) SKIP(3.41)
      173       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      174            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      175            TITLE "Вид налога"
      176            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit.
      177   ASSIGN
      178          FRAME D-add-tax:SCROLLABLE       = FALSE
      179          FRAME D-add-tax:HIDDEN           = TRUE.
      180   ON GO OF FRAME D-add-tax
      181   DO:
      182       find first tt-tax  no-error.
      183       if not avail tt-tax then create tt-tax.
      184          assign
      185          TaxType
      186          tt-tax.individual
      187          tt-tax.tax-code
      188          tt-tax.tax-name
      189          tt-tax.to-cashdesk
      190          .
      191       run ref/taxesi01.p (input-output rid,
      192                      input ref-mode,
      193                      tt-tax.tax-code,
      194                       tt-tax.tax-name,
      195                       taxtype,
      196                       tt-tax.individual,
      197                       tt-tax.to-cashdesk,
      198                      input table tt-tax-units) no-error.
      199     if error-status:error then do:
      200           if return-value = "":U then return no-apply.
      201       case return-value:
      202               when "tax-name":U then do:
      203                   APPLY "ENTRY" to tt-tax.tax-name.
      204               end.
      205               when "tax-code":U then do:
      206                    APPLY "ENTRY" to tt-tax.tax-code.
      207               end.
      208               when "individual":U then do:
      209                    APPLY "ENTRY" to tt-tax.individual.
      210               end.
      211           end.
      212     end.
      213   END.
      214   ON WINDOW-CLOSE OF FRAME D-add-tax
      215   DO:
      216     rid = ?.
      217     APPLY "END-ERROR":U TO SELF.
      218   END.
      219   ON CHOOSE OF B-mark IN FRAME D-add-tax
      220   DO:
      221     if not avail tt-tax-units then return no-apply.
      222       run proc-b-mark(tt-tax.tax-code, tt-tax-units.type) no-error.
      223       if error-status:error then return no-apply.
      224       OPEN QUERY br-tt-tax-units for each tt-tax-units No-LOCK.
      225   END.
      226   ON CHOOSE OF B-quit IN FRAME D-add-tax
      227   DO:
      228     rid = ?.
      229   END.
      230   ON MOUSE-SELECT-DBLCLICK OF BR-tt-tax-units IN FRAME D-add-tax
      231   DO:
      232     if tt-tax.tax-code <= 4 then return no-apply.
      233     APPLY "CHOOSE" to b-mark.
      234     return no-apply.
      235   END.
      236   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME D-add-tax:PARENT eq ?
      237   THEN FRAME D-add-tax:PARENT = ACTIVE-WINDOW.
      238   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      239   on help of frame D-add-tax
      240   do:
      241     run gbl/app_help.p
      242       (input this-procedure :file-name
      243       ,input ''
      244       ,input ?
      245       ) no-error.
      246     if error-status :error then do:
      247       message
      248         "Ошибка при вызове помощи"
      249         error-status :get-message(1)
      250         view-as alert-box .
      251     end.
      252   end.
      253   run minbtn-set in this-procedure .
      254   on choose of b-help in frame D-add-tax
      255   do:
      256     apply "help":u to frame D-add-tax .
      257   end.
      258   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      259   procedure minbtn-set :
      260       do
      261           on error undo, return error return-value
      262           :
      263           define variable ii              as integer       no-undo .
      264           define variable fh              as widget-handle no-undo .
      265           define variable hh              as widget-handle no-undo .
      266           define variable v-h             as handle        extent 4 no-undo .
      267           define variable v-name-button   as character     no-undo .
      268           define variable v-help-old-x    as decimal       no-undo .
      269           define variable v-help-old-y    as decimal       no-undo .
      270           define variable v-help-old-size as decimal       no-undo .
      271           define variable v-frame-width   as decimal       no-undo .
      272           define variable jj              as integer       no-undo .
      273           do
      274               on error undo, return error
      275               :
      276               assign
      277                   v-frame-width = frame D-add-tax:width - 0.3
      278                   fh            = frame D-add-tax:first-child
      279                   hh            = fh:first-child
      280                   ii            = 1
      281                   .
      282               do while valid-handle(hh):
      283                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      284                   do:
      285                       case lc(hh:name) :
      286                           when "b-help" then
      287                               do:
      288                                   hh:load-image-up("cmp/b-help.bmp":u) .
      289                                   hh:load-image-down("cmp/b-help.bmp":u) .
      290                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      291                                   hh:TOOLTIP = "Помощь" .
      292                                   v-help-old-x = hh:column .
      293                                   v-help-old-y = hh:row    .
      294                                   v-help-old-size = hh:width .
      295                                   hh:width-chars = 2.5 .
      296                               end.
      297                           when "b-print" then
      298                               do:
      299                                   hh:load-image("cmp/b-print.bmp":u) .
      300                                   hh:TOOLTIP = "Печать" .
      301                                   v-h[ii] = hh:handle .
      302                                   ii = ii + 1 .
      303                                   hh:width-chars = 3 .
      304                               end.
      305                           when "b-history" or
      306                           when "b-hist" then
      307                               do:
      308                                   hh:load-image("cmp/b-hist.bmp":u) .
      309                                   hh:TOOLTIP = "История" .
      310                                   v-h[ii] = hh:handle .
      311                                   ii = ii + 1 .
      312                                   hh:width-chars = 3 .
      313                               end.
      314                           when "b-sch" then
      315                               do:
      316                                   hh:load-image("cmp/b-sch.bmp":u) .
      317                                   hh:TOOLTIP = "Установка Фильтра" .
      318                                   v-h[ii] = hh:handle .
      319                                   ii = ii + 1 .
      320                                   hh:width-chars = 3 .
      321                               end.
      322                           when "b-hist-user" then
      323                               do:
      324                                   hh:load-image("cmp/b-hist.bmp":u) .
      325                                   hh:TOOLTIP = "История пользователя" .
      326                                   ii = ii + 1 .
      327                               end.
      328                       end case.
      329                   end.
      330                   hh = hh:next-sibling.
      331               end.
      332               b-help:column = v-frame-width - b-help:width-chars.
      333               jj = 0.
      334               repeat ii = 4 to 1 by -1 :
      335                   if valid-handle (v-h[ii] ) then
      336                   do:
      337                       jj  = jj + 1 .
      338                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      339                       v-h[ii]:row    = v-help-old-y .
      340                   end.
      341               end.
      342           end.
      343       end.
      344   end procedure.
      345   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      346   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      347   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      348   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      349   define variable v-diasize-current-frame-width  as decimal   no-undo .
      350   define variable v-diasize-current-frame-height as decimal   no-undo .
      351   define variable v-diasize-change-size          as logical   no-undo .
      352   define variable v-diasize-resize-button        as handle    no-undo .
      353   define variable v-diasize-wndmax               as logical   no-undo .
      354   define variable v-diasize-wndstore             as logical   no-undo .
      355   define variable v-diasize-proc-name            as character no-undo .
      356   define variable v-diasize-browse-handle        as handle    no-undo .
      357   define variable v-diasize-browse-number        as integer   no-undo .
      358   define variable v-diasize-need-full-display    as logical   no-undo init false .
      359   define temp-table temp-diasize-handle no-undo
      360     field handle-value  as handle
      361     field save-position as decimal
      362     index xpk is primary unique handle-value
      363     .
      364   define temp-table temp-browse-handle no-undo
      365     field browse-type   as character
      366     field browse-number as integer
      367     field browse-handle as handle
      368     field original-size as decimal
      369     index xpk is primary unique browse-type browse-number
      370     index xie browse-type browse-handle
      371   .
      372   procedure diasize_change-height :
      373     define input  parameter p-change-value  as decimal   no-undo .
      374     define input  parameter p-move-resize   as logical   no-undo .
      375     define variable v-field-group-handle    as handle    no-undo .
      376     define variable v-object-handle         as handle    no-undo .
      377     define variable v-frame-height          as decimal   no-undo .
      378     define variable v-frame-virtual-height  as decimal   no-undo .
      379     define variable v-browse-height         as decimal   no-undo .
      380     define variable v-window-height         as decimal   no-undo .
      381     define variable v-window-virtual-height as decimal   no-undo .
      382     define variable v-change-sign           as integer   no-undo .
      383     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      384     define buffer buf_temp-browse-handle  for temp-browse-handle .
      385     if p-change-value > 0
      386     then do:
      387       if frame D-add-tax :height + p-change-value
      388           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      389       then do:
      390         assign
      391           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      392                           - (frame D-add-tax :height-chars)
      393         .
      394         if p-change-value <= 0
      395         then do:
      396           run diasize_position-resize-button in this-procedure .
      397           return .
      398         end.
      399       end.
      400     end.
      401     if p-change-value < 0
      402     then do:
      403       if frame D-add-tax :height + p-change-value < v-diasize-orig-frame-height
      404       then do:
      405         assign
      406           p-change-value = v-diasize-orig-frame-height
      407                          - (frame D-add-tax :height-chars)
      408         .
      409         if p-change-value >= 0
      410         then do:
      411           run diasize_position-resize-button in this-procedure .
      412           return .
      413         end.
      414       end.
      415     end.
      416     if p-change-value >= 0
      417     then do:
      418       assign
      419         v-change-sign = 1
      420       .
      421     end.
      422     else do:
      423       assign
      424         v-change-sign = -1
      425       .
      426     end.
      427     assign
      428       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      429     .
      430     if p-change-value = 0
      431     then do:
      432       run diasize_position-resize-button in this-procedure .
      433       return .
      434     end.
      435     move_block:
      436     do
      437     on error undo move_block, retry move_block
      438     :
      439       if retry
      440       then do:
      441         do
      442         on error undo move_block, leave move_block
      443         :
      444           if p-change-value > 0
      445           then do:
      446             for each buf_temp-diasize-handle
      447             on error undo, next
      448             :
      449               assign
      450                 v-object-handle = buf_temp-diasize-handle.handle-value
      451               .
      452               if v-object-handle <> v-diasize-resize-button
      453               then do:
      454                 assign
      455                   v-object-handle :row = buf_temp-diasize-handle.save-position
      456                 .
      457               end.
      458             end.
      459             assign
      460               v-diasize-browse-handle :height = v-browse-height
      461             .
      462             for each buf_temp-browse-handle
      463               where buf_temp-browse-handle.browse-type = 'height':u
      464             on error undo, next
      465             :
      466               assign
      467                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      468               .
      469             end.
      470             assign
      471               frame D-add-tax :height = v-frame-height
      472             .
      473             if frame D-add-tax :scrollable = true
      474             then do:
      475               assign
      476                 frame D-add-tax :virtual-height = v-frame-virtual-height
      477               .
      478             end.
      479             run diasize_position-resize-button in this-procedure .
      480           end.
      481           else do:
      482             if frame D-add-tax :scrollable = true
      483             then do:
      484               assign
      485                 frame D-add-tax :virtual-height = v-frame-virtual-height
      486               .
      487             end.
      488             assign
      489               frame D-add-tax :height = v-frame-height
      490             .
      491             assign
      492               v-diasize-browse-handle :height = v-browse-height
      493             .
      494             for each buf_temp-browse-handle
      495               where buf_temp-browse-handle.browse-type = 'height':u
      496             on error undo, next
      497             :
      498               assign
      499                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      500               .
      501             end.
      502             for each buf_temp-diasize-handle
      503             on error undo, next
      504             :
      505               assign
      506                 v-object-handle = buf_temp-diasize-handle.handle-value
      507               .
      508               if v-object-handle <> v-diasize-resize-button
      509               then do:
      510                 assign
      511                   v-object-handle :row = buf_temp-diasize-handle.save-position
      512                 .
      513               end.
      514             end.
      515             run diasize_position-resize-button in this-procedure .
      516           end.
      517           assign
      518             v-diasize-change-size = false
      519           .
      520           leave move_block .
      521         end.
      522       end.
      523       assign
      524         v-diasize-need-full-display = true
      525       .
      526       if v-diasize-change-size = false
      527       then do:
      528         assign
      529           v-diasize-change-size = true
      530         .
      531       end.
      532       else do:
      533         return .
      534       end.
      535       assign
      536         v-frame-height = frame D-add-tax :height
      537         v-frame-virtual-height = frame D-add-tax :virtual-height
      538         v-browse-height = v-diasize-browse-handle :height
      539       .
      540       for each buf_temp-browse-handle
      541         where buf_temp-browse-handle.browse-type = 'height':u
      542       :
      543         assign
      544           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      545         .
      546       end.
      547       for each buf_temp-diasize-handle
      548       :
      549         delete buf_temp-diasize-handle .
      550       end.
      551       assign
      552         v-field-group-handle = frame D-add-tax :first-child
      553       .
      554       do while valid-handle(v-field-group-handle)
      555       :
      556         assign
      557           v-object-handle = v-field-group-handle :first-child
      558         .
      559         do while valid-handle(v-object-handle)
      560         :
      561           if  v-object-handle <> v-diasize-browse-handle :handle
      562           and can-query(v-object-handle, "row")
      563           and can-query(v-object-handle, "height")
      564           and ( v-object-handle :row > v-diasize-browse-handle :row )
      565           then do:
      566             find first buf_temp-browse-handle
      567               where buf_temp-browse-handle.browse-type   = 'height':u
      568                 and buf_temp-browse-handle.browse-handle = v-object-handle
      569               no-error .
      570             if available buf_temp-browse-handle
      571             then do:
      572             end.
      573             else do:
      574               create buf_temp-diasize-handle .
      575               assign
      576                 buf_temp-diasize-handle.handle-value  = v-object-handle
      577                 buf_temp-diasize-handle.save-position = v-object-handle :row
      578               .
      579             end.
      580           end.
      581           assign
      582             v-object-handle = v-object-handle :next-sibling
      583           .
      584         end.
      585         assign
      586           v-field-group-handle = v-field-group-handle :next-sibling
      587         .
      588       end.
      589       do with frame D-add-tax
      590       :
      591         hide v-diasize-resize-button .
      592         assign
      593           v-diasize-resize-button :row    = 1
      594           v-diasize-resize-button :column = 1
      595         .
      596       end.
      597       if p-change-value > 0
      598       then do:
      599         if frame D-add-tax :scrollable = true
      600         then do:
      601           assign
      602             frame D-add-tax :virtual-height = frame D-add-tax :virtual-height + p-change-value
      603             no-error .
      604           if error-status :error
      605           or error-status :get-message(1) <> ""
      606           then do:
      607             undo move_block, retry move_block .
      608           end.
      609         end.
      610         assign
      611           frame D-add-tax :height = frame D-add-tax :height + p-change-value
      612           no-error .
      613         if error-status :error
      614         or error-status :get-message(1) <> ""
      615         then do:
      616           undo move_block, retry move_block .
      617         end.
      618         assign
      619           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      620           no-error .
      621         if error-status :error
      622         or error-status :get-message(1) <> ""
      623         then do:
      624           undo move_block, retry move_block .
      625         end.
      626         for each buf_temp-browse-handle
      627           where buf_temp-browse-handle.browse-type = 'height':u
      628         on error undo move_block, retry move_block
      629         :
      630           assign
      631             buf_temp-browse-handle.browse-handle :height
      632               = buf_temp-browse-handle.browse-handle :height + p-change-value
      633             no-error .
      634           if error-status :error
      635           or error-status :get-message(1) <> ""
      636           then do:
      637             undo move_block, retry move_block .
      638           end.
      639         end.
      640         for each buf_temp-diasize-handle
      641         on error undo move_block, retry move_block
      642         :
      643           assign
      644             v-object-handle = buf_temp-diasize-handle.handle-value
      645           .
      646           if v-object-handle <> v-diasize-resize-button
      647           then do:
      648             assign
      649               v-object-handle :row = v-object-handle :row + p-change-value
      650               no-error .
      651             if error-status :error
      652             or error-status :get-message(1) <> ""
      653             then do:
      654               undo move_block, retry move_block .
      655             end.
      656           end.
      657         end.
      658       end.
      659       else do:
      660         for each buf_temp-diasize-handle
      661         on error undo move_block, retry move_block
      662         :
      663           assign
      664             v-object-handle = buf_temp-diasize-handle.handle-value
      665           .
      666           if v-object-handle <> v-diasize-resize-button
      667           then do:
      668             assign
      669               v-object-handle :row = v-object-handle :row + p-change-value
      670               no-error .
      671             if error-status :error
      672             or error-status :get-message(1) <> ""
      673             then do:
      674               undo move_block, retry move_block .
      675             end.
      676           end.
      677         end.
      678         assign
      679           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      680           no-error .
      681         if error-status :error
      682         or error-status :get-message(1) <> ""
      683         then do:
      684           undo move_block, retry move_block .
      685         end.
      686         for each buf_temp-browse-handle
      687           where buf_temp-browse-handle.browse-type = 'height':u
      688         on error undo move_block, retry move_block
      689         :
      690           assign
      691             buf_temp-browse-handle.browse-handle :height
      692               = buf_temp-browse-handle.browse-handle :height + p-change-value
      693             no-error .
      694           if error-status :error
      695           or error-status :get-message(1) <> ""
      696           then do:
      697             undo move_block, retry move_block .
      698           end.
      699         end.
      700         assign
      701           frame D-add-tax :height = frame D-add-tax :height + p-change-value
      702           no-error .
      703         if error-status :error
      704         or error-status :get-message(1) <> ""
      705         then do:
      706           undo move_block, retry move_block .
      707         end.
      708         if frame D-add-tax :scrollable = true
      709         then do:
      710           assign
      711             frame D-add-tax :virtual-height = frame D-add-tax :virtual-height + p-change-value
      712             no-error .
      713           if error-status :error
      714           or error-status :get-message(1) <> ""
      715           then do:
      716             undo move_block, retry move_block .
      717           end.
      718         end.
      719       end.
      720       if p-move-resize = true
      721       then do:
      722         run diasize_position-resize-button in this-procedure .
      723       end.
      724       if v-diasize-wndstore = true
      725       then do:
      726         if connected("ub") = true
      727         then do:
      728           define variable v-cntxt-db-num        as integer   no-undo .
      729           define variable v-cntxt-userid        as character no-undo .
      730           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      731                                             , OUTPUT v-cntxt-userid
      732                                             ) .
      733           run gbl/wndsizew.p
      734             (input  v-cntxt-db-num
      735             ,input  v-cntxt-userid
      736             ,input  v-diasize-proc-name
      737             ,input  'height':u
      738             ,input  string(frame D-add-tax :height - v-diasize-orig-frame-height)
      739             ) .
      740         end.
      741       end.
      742     end.
      743     assign
      744       v-diasize-change-size = false
      745     .
      746   end procedure.
      747   procedure diasize_set-height :
      748     define input  parameter p-new-height  as decimal   no-undo .
      749     define input  parameter p-move-resize as logical   no-undo .
      750     do
      751     on error undo, return error return-value
      752     :
      753       run diasize_change-height in this-procedure
      754         (input  (p-new-height - frame D-add-tax :height)
      755         ,input  p-move-resize
      756         ) .
      757     end.
      758   end procedure.
      759   procedure diasize_change-width :
      760     define input  parameter p-change-value as decimal   no-undo .
      761     define input  parameter p-move-resize  as logical   no-undo .
      762     define variable v-field-group-handle   as handle    no-undo .
      763     define variable v-object-handle        as handle    no-undo .
      764     define variable v-frame-width          as decimal   no-undo .
      765     define variable v-frame-virtual-width  as decimal   no-undo .
      766     define variable v-browse-width         as decimal   no-undo .
      767     define variable v-window-width         as decimal   no-undo .
      768     define variable v-window-virtual-width as decimal   no-undo .
      769     define variable v-change-sign          as integer   no-undo .
      770     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      771     define buffer buf_temp-browse-handle  for temp-browse-handle .
      772     if p-change-value > 0
      773     then do:
      774       if frame D-add-tax :width + p-change-value >
      775           session :width-chars
      776       then do:
      777         assign
      778           p-change-value = session :width-chars - frame D-add-tax :width
      779         .
      780         if p-change-value <= 0
      781         then do:
      782           run diasize_position-resize-button in this-procedure .
      783           return .
      784         end.
      785       end.
      786     end.
      787     if p-change-value < 0
      788     then do:
      789       if frame D-add-tax :width + p-change-value < v-diasize-orig-frame-width
      790       then do:
      791         assign
      792           p-change-value = v-diasize-orig-frame-width
      793                          - frame D-add-tax :width
      794         .
      795         if p-change-value >= 0
      796         then do:
      797           run diasize_position-resize-button in this-procedure .
      798           return .
      799         end.
      800       end.
      801     end.
      802     if p-change-value >= 0
      803     then do:
      804       assign
      805         v-change-sign = 1
      806       .
      807     end.
      808     else do:
      809       assign
      810         v-change-sign = -1
      811       .
      812     end.
      813     assign
      814       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      815     .
      816     if p-change-value = 0
      817     then do:
      818       run diasize_position-resize-button in this-procedure .
      819       return .
      820     end.
      821     move_block:
      822     do
      823     on error undo move_block, leave move_block
      824     :
      825       if retry
      826       then do:
      827         do
      828         on error undo move_block, leave move_block
      829         :
      830           if p-change-value > 0
      831           then do:
      832             for each buf_temp-diasize-handle
      833             on error undo, next
      834             :
      835               assign
      836                 v-object-handle = buf_temp-diasize-handle.handle-value
      837               .
      838               if v-object-handle <> v-diasize-resize-button
      839               then do:
      840                 assign
      841                   v-object-handle :col = buf_temp-diasize-handle.save-position
      842                 .
      843               end.
      844             end.
      845             assign
      846               v-diasize-browse-handle :width = v-browse-width
      847             .
      848             for each buf_temp-browse-handle
      849               where buf_temp-browse-handle.browse-type = 'width':u
      850             on error undo, next
      851             :
      852               assign
      853                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      854               .
      855             end.
      856             assign
      857               frame D-add-tax :width = v-frame-width
      858             .
      859             if frame D-add-tax :scrollable = true
      860             then do:
      861               assign
      862                 frame D-add-tax :virtual-width = v-frame-virtual-width
      863               .
      864             end.
      865             run diasize_position-resize-button in this-procedure .
      866           end.
      867           else do:
      868             if frame D-add-tax :scrollable = true
      869             then do:
      870               assign
      871                 frame D-add-tax :virtual-width = v-frame-virtual-width
      872               .
      873             end.
      874             assign
      875               frame D-add-tax :width = v-frame-width
      876             .
      877             for each buf_temp-browse-handle
      878               where buf_temp-browse-handle.browse-type = 'width':u
      879             on error undo, next
      880             :
      881               assign
      882                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      883               .
      884             end.
      885             assign
      886               v-diasize-browse-handle :width = v-browse-width
      887             .
      888             for each buf_temp-diasize-handle
      889             on error undo, next
      890             :
      891               assign
      892                 v-object-handle = buf_temp-diasize-handle.handle-value
      893               .
      894               if v-object-handle <> v-diasize-resize-button
      895               then do:
      896                 assign
      897                   v-object-handle :col = buf_temp-diasize-handle.save-position
      898                 .
      899               end.
      900             end.
      901             run diasize_position-resize-button in this-procedure .
      902           end.
      903           assign
      904             v-diasize-change-size = false
      905           .
      906           leave move_block .
      907         end.
      908       end.
      909       assign
      910         v-diasize-need-full-display = true
      911       .
      912       if v-diasize-change-size = false
      913       then do:
      914         assign
      915           v-diasize-change-size = true
      916         .
      917       end.
      918       else do:
      919         return .
      920       end.
      921       assign
      922         v-frame-width = frame D-add-tax :width
      923         v-frame-virtual-width = frame D-add-tax :virtual-width
      924         v-browse-width = v-diasize-browse-handle :width
      925       .
      926       for each buf_temp-browse-handle
      927         where buf_temp-browse-handle.browse-type = 'width':u
      928       :
      929         assign
      930           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      931         .
      932       end.
      933       for each buf_temp-diasize-handle
      934       :
      935         delete buf_temp-diasize-handle .
      936       end.
      937       assign
      938         v-field-group-handle = frame D-add-tax :first-child
      939       .
      940       do while valid-handle(v-field-group-handle)
      941       :
      942         assign
      943           v-object-handle = v-field-group-handle :first-child
      944         .
      945         do while valid-handle(v-object-handle)
      946         :
      947           if  v-object-handle <> v-diasize-browse-handle :handle
      948           and v-object-handle <> v-diasize-resize-button
      949           and can-query(v-object-handle, "row")
      950           and can-query(v-object-handle, "height")
      951           and ( v-object-handle :col + v-object-handle :width
      952                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      953               )
      954           then do:
      955             find first buf_temp-browse-handle
      956               where buf_temp-browse-handle.browse-type   = 'width':u
      957                 and buf_temp-browse-handle.browse-handle = v-object-handle
      958               no-error .
      959             if available buf_temp-browse-handle
      960             then do:
      961             end.
      962             else do:
      963               create buf_temp-diasize-handle .
      964               assign
      965                 buf_temp-diasize-handle.handle-value  = v-object-handle
      966                 buf_temp-diasize-handle.save-position = v-object-handle :col
      967               .
      968             end.
      969           end.
      970           assign
      971             v-object-handle = v-object-handle :next-sibling
      972           .
      973         end.
      974         assign
      975           v-field-group-handle = v-field-group-handle :next-sibling
      976         .
      977       end.
      978       do with frame D-add-tax
      979       :
      980         hide v-diasize-resize-button .
      981         v-diasize-resize-button :row = 1.
      982         v-diasize-resize-button :column = 1.
      983       end.
      984       if p-change-value > 0
      985       then do:
      986         if frame D-add-tax :scrollable = true
      987         then do:
      988           assign
      989             frame D-add-tax :virtual-width = frame D-add-tax :virtual-width + p-change-value
      990             no-error .
      991           if error-status :error
      992           or error-status :get-message(1) <> ""
      993           then do:
      994             undo move_block, retry move_block.
      995           end.
      996         end.
      997         assign
      998           frame D-add-tax :width = v-frame-width + p-change-value
      999           no-error .
     1000         if error-status :error
     1001         or error-status :get-message(1) <> ""
     1002         then do:
     1003           undo move_block, retry move_block.
     1004         end.
     1005         assign
     1006           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1007         no-error .
     1008         if error-status :error
     1009         or error-status :get-message(1) <> ""
     1010         then do:
     1011           undo move_block, retry move_block.
     1012         end.
     1013         for each buf_temp-browse-handle
     1014           where buf_temp-browse-handle.browse-type = 'width':u
     1015         on error undo move_block, retry move_block
     1016         :
     1017           assign
     1018             buf_temp-browse-handle.browse-handle :width
     1019               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1020             no-error .
     1021           if error-status :error
     1022           or error-status :get-message(1) <> ""
     1023           then do:
     1024             undo move_block, retry move_block .
     1025           end.
     1026         end.
     1027         for each buf_temp-diasize-handle
     1028         on error undo move_block, retry move_block
     1029         :
     1030           assign
     1031             v-object-handle = buf_temp-diasize-handle.handle-value
     1032           .
     1033           if v-object-handle <> v-diasize-resize-button
     1034           then do:
     1035             assign
     1036               v-object-handle :col = v-object-handle :col + p-change-value
     1037               no-error .
     1038             if error-status :error
     1039             or error-status :get-message(1) <> ""
     1040             then do:
     1041               undo move_block, retry move_block .
     1042             end.
     1043           end.
     1044         end.
     1045       end.
     1046       else do:
     1047         for each buf_temp-diasize-handle
     1048         on error undo move_block, retry move_block
     1049         :
     1050           assign
     1051             v-object-handle = buf_temp-diasize-handle.handle-value
     1052           .
     1053           if v-object-handle <> v-diasize-resize-button
     1054           then do:
     1055             assign
     1056               v-object-handle :col = v-object-handle :col + p-change-value
     1057               no-error .
     1058             if error-status :error
     1059             or error-status :get-message(1) <> ""
     1060             then do:
     1061               undo move_block, retry move_block .
     1062             end.
     1063           end.
     1064         end.
     1065         for each buf_temp-browse-handle
     1066           where buf_temp-browse-handle.browse-type = 'width':u
     1067         on error undo move_block, retry move_block
     1068         :
     1069           assign
     1070             buf_temp-browse-handle.browse-handle :width
     1071               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1072             no-error .
     1073           if error-status :error
     1074           or error-status :get-message(1) <> ""
     1075           then do:
     1076             undo move_block, retry move_block .
     1077           end.
     1078         end.
     1079         assign
     1080           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1081           no-error .
     1082         if error-status :error
     1083         or error-status :get-message(1) <> ""
     1084         then do:
     1085           undo move_block, retry move_block.
     1086         end.
     1087         assign
     1088           frame D-add-tax :width = frame D-add-tax :width + p-change-value
     1089         no-error .
     1090         if error-status :error
     1091         or error-status :get-message(1) <> ""
     1092         then do:
     1093           undo move_block, retry move_block.
     1094         end.
     1095         if frame D-add-tax :scrollable = true
     1096         then do:
     1097           assign
     1098             frame D-add-tax :virtual-width = frame D-add-tax :virtual-width + p-change-value
     1099           no-error .
     1100           if error-status :error
     1101           or error-status :get-message(1) <> ""
     1102           then do:
     1103             undo move_block, retry move_block.
     1104           end.
     1105         end.
     1106       end.
     1107       if p-move-resize
     1108       then do:
     1109         run diasize_position-resize-button in this-procedure .
     1110       end.
     1111       if v-diasize-wndstore = true
     1112       then do:
     1113         if connected("ub") = true
     1114         then do:
     1115           define variable v-cntxt-db-num        as integer   no-undo .
     1116           define variable v-cntxt-userid        as character no-undo .
     1117           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1118                                             , OUTPUT v-cntxt-userid
     1119                                             ) .
     1120           run gbl/wndsizew.p
     1121             (input  v-cntxt-db-num
     1122             ,input  v-cntxt-userid
     1123             ,input  v-diasize-proc-name
     1124             ,input  'width':u
     1125             ,input  string(frame D-add-tax :width - v-diasize-orig-frame-width)
     1126             ) .
     1127         end.
     1128       end.
     1129     end.
     1130     assign
     1131       v-diasize-change-size = false
     1132     .
     1133   end procedure.
     1134   procedure diasize_set-width :
     1135     define input  parameter p-new-width  as decimal   no-undo .
     1136     define input  parameter p-move-resize as logical   no-undo .
     1137     do
     1138     on error undo, return error return-value
     1139     :
     1140       run diasize_change-width in this-procedure
     1141         (input  (p-new-width - frame D-add-tax :width)
     1142         ,input  p-move-resize
     1143         ) .
     1144     end.
     1145   end procedure.
     1146   procedure diasize_position-resize-button :
     1147     do with frame D-add-tax
     1148     :
     1149       hide v-diasize-resize-button .
     1150       assign
     1151         v-diasize-resize-button :row = frame D-add-tax :height - v-diasize-resize-button :height
     1152                     - 1
     1153                     - (frame D-add-tax :border-bottom-pixels / session :pixels-per-row)
     1154         v-diasize-resize-button :col = frame D-add-tax :width - v-diasize-resize-button :width
     1155                     - 1
     1156                     - (frame D-add-tax :border-right-pixels / session :pixels-per-column)
     1157       .
     1158       view v-diasize-resize-button .
     1159     end.
     1160   end procedure.
     1161   on alt-right anywhere
     1162   do:
     1163     run diasize_change-width in this-procedure
     1164       (input 1
     1165       ,input true
     1166       ) .
     1167     return no-apply .
     1168   end.
     1169   on alt-left anywhere
     1170   do:
     1171     run diasize_change-width in this-procedure
     1172       (input -1
     1173       ,input true
     1174       ) .
     1175     return no-apply .
     1176   end.
     1177   on alt-down anywhere
     1178   do:
     1179     run diasize_change-height in this-procedure
     1180       (input 1
     1181       ,input true
     1182       ) .
     1183     return no-apply .
     1184   end.
     1185   on alt-up anywhere
     1186   do:
     1187     run diasize_change-height in this-procedure
     1188       (input -1
     1189       ,input true
     1190       ) .
     1191     return no-apply .
     1192   end.
     1193   on alt-enter of frame D-add-tax
     1194   do:
     1195     run diasize_maximize in this-procedure
     1196       (input  ?
     1197       ).
     1198     return no-apply .
     1199   end.
     1200   procedure diasize_end-move :
     1201     do
     1202     on error undo, return error return-value
     1203     :
     1204       define variable v-row-delta as decimal   no-undo .
     1205       define variable v-col-delta as decimal   no-undo .
     1206       define variable v-new-row as decimal   no-undo .
     1207       define variable v-new-col as decimal   no-undo .
     1208       assign
     1209         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1210         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1211       .
     1212       assign
     1213         v-row-delta = v-new-row - frame D-add-tax :height
     1214         v-col-delta = v-new-col - frame D-add-tax :width
     1215       .
     1216       run diasize_change-height in this-procedure
     1217         (input v-row-delta
     1218         ,input true
     1219         ) .
     1220       run diasize_change-width in this-procedure
     1221         (input v-col-delta
     1222         ,input true
     1223         ) .
     1224     end.
     1225   end procedure.
     1226   procedure diasize_maximize :
     1227     define input  parameter p-action as logical   no-undo .
     1228     do
     1229     on error undo, return error return-value
     1230     :
     1231       if p-action = ?
     1232       then do:
     1233         if v-diasize-need-maximize = true
     1234         then do:
     1235           assign
     1236             p-action = true
     1237           .
     1238         end.
     1239         else do:
     1240           assign
     1241             p-action = false
     1242           .
     1243         end.
     1244       end.
     1245       if p-action = true
     1246       then do:
     1247         run diasize_change-height in this-procedure
     1248           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1249               - frame D-add-tax :height-chars
     1250           ,input true
     1251           ) .
     1252         run diasize_change-width in this-procedure
     1253           (input session :width-chars
     1254               - frame D-add-tax :width-chars
     1255           ,input true
     1256           ) .
     1257         assign
     1258           v-diasize-need-maximize = false
     1259         .
     1260       end.
     1261       else do:
     1262         run diasize_change-width in this-procedure
     1263           (input v-diasize-orig-frame-width
     1264               - frame D-add-tax :width-chars
     1265           ,input true
     1266           ) .
     1267         run diasize_change-height in this-procedure
     1268           (input v-diasize-orig-frame-height
     1269               - frame D-add-tax :height-chars
     1270           ,input true
     1271           ) .
     1272         assign
     1273           v-diasize-need-maximize = true
     1274         .
     1275       end.
     1276     end.
     1277   end procedure.
     1278   procedure diasize_restore-orig-size :
     1279     do
     1280     on error undo, return error return-value
     1281     :
     1282       assign
     1283         v-diasize-current-frame-width  = frame D-add-tax :width
     1284         v-diasize-current-frame-height = frame D-add-tax :height
     1285       .
     1286       run diasize_set-height in this-procedure
     1287         (input  v-diasize-orig-frame-height
     1288         ,input  true
     1289         ) .
     1290       run diasize_set-width in this-procedure
     1291         (input  v-diasize-orig-frame-width
     1292         ,input  true
     1293         ) .
     1294     end.
     1295   end procedure.
     1296   procedure diasize_restore-current-size :
     1297     do
     1298     on error undo, return error return-value
     1299     :
     1300       run diasize_set-height in this-procedure
     1301         (input  v-diasize-current-frame-height
     1302         ,input  true
     1303         ) .
     1304       run diasize_set-width in this-procedure
     1305         (input  v-diasize-current-frame-width
     1306         ,input  true
     1307         ) .
     1308     end.
     1309   end procedure.
     1310   procedure diasize_set-browse-handle :
     1311     define input  parameter p-browse-handle as handle   no-undo .
     1312     define buffer buf_temp-browse-handle for temp-browse-handle .
     1313     do
     1314     on error undo, return error return-value
     1315     :
     1316       assign
     1317         v-diasize-browse-handle = p-browse-handle
     1318       .
     1319       for each buf_temp-browse-handle
     1320       on error undo, return error return-value
     1321       :
     1322         delete buf_temp-browse-handle .
     1323       end.
     1324     end.
     1325   end procedure.
     1326   procedure diasize_add_browse :
     1327     define input  parameter p-browse-type   as character no-undo .
     1328     define input  parameter p-browse-handle as handle    no-undo .
     1329     define buffer buf_temp-browse-handle for temp-browse-handle .
     1330     do
     1331     on error undo, return error return-value
     1332     :
     1333       assign
     1334         v-diasize-browse-number = v-diasize-browse-number + 1
     1335       .
     1336       create buf_temp-browse-handle .
     1337       assign
     1338         buf_temp-browse-handle.browse-type   = p-browse-type
     1339         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1340         buf_temp-browse-handle.browse-handle = p-browse-handle
     1341       .
     1342     end.
     1343   end procedure.
     1344   procedure diasize_init :
     1345     define variable v-default-value    as logical   no-undo .
     1346     define variable v-restore-saved    as logical   no-undo .
     1347     define variable v-resize-value-str as character no-undo .
     1348     do
     1349     on error undo, return error return-value
     1350     :
     1351       do with frame D-add-tax
     1352       :
     1353         assign
     1354           v-diasize-orig-frame-height = frame D-add-tax :height
     1355           v-diasize-orig-frame-width  = frame D-add-tax :width
     1356           v-diasize-browse-handle     = browse BR-tt-tax-units :handle
     1357         .
     1358         create button v-diasize-resize-button
     1359         assign
     1360           parent        = frame D-add-tax :first-child
     1361           label         = "s"
     1362           height-pixels = 16
     1363           width-pixels  = 16
     1364           visible       = true
     1365           sensitive     = true
     1366           movable       = true
     1367           triggers:
     1368             on end-move persistent run diasize_end-move in this-procedure .
     1369           end triggers.
     1370         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1371         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1372         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1373         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1374         assign
     1375           v-diasize-wndmax = false
     1376         .
     1377         if connected("ub") = true
     1378         then do:
     1379           define variable v-cntxt-db-num        as integer   no-undo .
     1380           define variable v-cntxt-userid        as character no-undo .
     1381           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1382                                             , OUTPUT v-cntxt-userid
     1383                                             ) .
     1384           run gbl/wndpar_r.p
     1385             (input  v-cntxt-db-num
     1386             ,input  v-cntxt-userid
     1387             ,input  'wndmax':U
     1388             ,output v-diasize-wndmax
     1389             ,output v-default-value
     1390             ) .
     1391         end.
     1392         assign
     1393           v-diasize-wndstore = false
     1394         .
     1395         if connected("ub") = true
     1396         then do:
     1397           run gbl/wndpar_r.p
     1398             (input  v-cntxt-db-num
     1399             ,input  v-cntxt-userid
     1400             ,input  'wndstore':U
     1401             ,output v-diasize-wndstore
     1402             ,output v-default-value
     1403             ) .
     1404         end.
     1405         assign
     1406           v-diasize-proc-name = entry(1, program-name(2), '.')
     1407         .
     1408         if v-diasize-wndstore = true
     1409         then do:
     1410           assign
     1411             v-restore-saved = false
     1412           .
     1413           if connected("ub") = true
     1414           then do:
     1415             run gbl/wndsizer.p
     1416               (input  v-cntxt-db-num
     1417               ,input  v-cntxt-userid
     1418               ,input  v-diasize-proc-name
     1419               ,input  'height':u
     1420               ,output v-resize-value-str
     1421               ) .
     1422             if v-resize-value-str <> '':U
     1423             then do:
     1424               run diasize_change-height in this-procedure
     1425                 (input  integer(v-resize-value-str)
     1426                 ,input  true
     1427                 ) .
     1428               assign
     1429                 v-restore-saved = true
     1430               .
     1431             end.
     1432           end.
     1433           if connected("ub") = true
     1434           then do:
     1435             run gbl/wndsizer.p
     1436               (input  v-cntxt-db-num
     1437               ,input  v-cntxt-userid
     1438               ,input  v-diasize-proc-name
     1439               ,input  'width':u
     1440               ,output v-resize-value-str
     1441               ) .
     1442             if v-resize-value-str <> '':U
     1443             then do:
     1444               run diasize_change-width in this-procedure
     1445                 (input  integer(v-resize-value-str)
     1446                 ,input  true
     1447                 ) .
     1448               assign
     1449                 v-restore-saved = true
     1450               .
     1451             end.
     1452           end.
     1453           if v-restore-saved <> true
     1454           then do:
     1455             if v-diasize-wndmax = true
     1456             then do:
     1457               run diasize_maximize in this-procedure
     1458                 (input  true
     1459                 ) .
     1460             end.
     1461           end.
     1462         end.
     1463         else do:
     1464           if v-diasize-wndmax = true
     1465           then do:
     1466             run diasize_maximize in this-procedure
     1467               (input  true
     1468               ) .
     1469           end.
     1470         end.
     1471       end.
     1472     end.
     1473   end procedure.
     1474   procedure diasize_need-full-display :
     1475     define output parameter p-need-full-display as logical   no-undo .
     1476     do
     1477     on error undo, return error return-value
     1478     :
     1479       assign
     1480         p-need-full-display = v-diasize-need-full-display
     1481       .
     1482       assign
     1483         v-diasize-need-full-display = false
     1484       .
     1485     end.
     1486   end procedure.
     1487   procedure get-context :
     1488      define output parameter p-db-num as integer          no-undo.
     1489      define output parameter p-user-id as character        no-undo.
     1490      define variable v-login               as character    no-undo.
     1491      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1492      define buffer buf_user-login  for ub.user-login .
     1493      do
     1494      on error undo, return error
     1495      :
     1496            FIND FIRST buf_sys-ctrl no-lock.
     1497            ASSIGN
     1498               v-login = USERID("ub")
     1499               p-db-num = buf_sys-ctrl.db-num
     1500            .
     1501            FIND FIRST buf_user-login
     1502                 WHERE buf_user-login.db-num = p-db-num
     1503                   AND buf_user-login.user-login = v-login
     1504                 no-lock
     1505                 no-error
     1506                 .
     1507            IF AVAILABLE buf_user-login
     1508            THEN DO:
     1509               assign
     1510                  p-user-id = buf_user-login.user-id
     1511               .
     1512            END.
     1513      end.
     1514   end procedure.
     1515       run diasize_init in this-procedure .
     1516   MAIN-BLOCK:
     1517   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1518      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1519     if ref-mode <> 'ИЗМЕНЕНИЕ':U and ref-mode <> 'ДОБАВЛЕНИЕ':U then do:
     1520           message vss-workfile vss-revision vss-description skip
     1521                       "Неверный параметр вызова ref-mode"
     1522           view-as alert-box ERROR.
     1523           return error.
     1524       end.
     1525     TaxType:INNER-LINES = num-entries ('процентный,абсолютный':U) .
     1526     TaxType:list-items = 'процентный,абсолютный':U .
     1527     TaxType:screen-value = entry (1, 'процентный,абсолютный':U) .
     1528     for each tt-tax:
     1529           delete tt-tax.
     1530       end.
     1531     if ref-mode = 'ИЗМЕНЕНИЕ':U then do:
     1532       find first ub.tax EXCLUSIVE-LOCK where recid(ub.tax) = rid NO-WAIT NO-ERROR.
     1533       if locked ub.tax then do:
     1534         message vss-workfile vss-revision vss-description skip
     1535                 "Запись налога занята"
     1536         view-as alert-box error .
     1537         return error.
     1538       end.
     1539       if not avail tax then do:
     1540         message vss-workfile vss-revision vss-description skip
     1541                 "Запись налога не найдена"
     1542         view-as alert-box error .
     1543         return error.
     1544       end.
     1545       create tt-tax.
     1546       buffer-copy tax to tt-tax.
     1547      end.
     1548     RUN MyEnable.
     1549     WAIT-FOR GO OF FRAME D-add-tax.
     1550   END.
     1551   RUN disable_UI.
     1552   PROCEDURE disable_UI :
     1553     HIDE FRAME D-add-tax.
     1554   END PROCEDURE.
     1555   PROCEDURE enable_UI :
     1556     OPEN QUERY D-add-tax FOR EACH tt-tax SHARE-LOCK.
     1557     GET FIRST D-add-tax.
     1558     DISPLAY TaxType
     1559         WITH FRAME D-add-tax.
     1560     IF AVAILABLE tt-tax THEN
     1561       DISPLAY tt-tax.tax-code tt-tax.tax-name tt-tax.to-cashdesk tt-tax.individual
     1562         WITH FRAME D-add-tax.
     1563     ENABLE B-exit B-quit B-Help B-mark BR-tt-tax-units tt-tax.tax-name
     1564            tt-tax.to-cashdesk tt-tax.individual
     1565         WITH FRAME D-add-tax.
     1566     VIEW FRAME D-add-tax.
     1567     OPEN QUERY BR-tt-tax-units FOR EACH tt-tax-units WHERE tt-tax-units.tax-code = ub.tax.tax-code NO-LOCK.
     1568   END PROCEDURE.
     1569   PROCEDURE fill-tt :
     1570   define variable ii as integer  no-undo.
     1571   for each tt-tax-units:
     1572   delete tt-tax-units.
     1573   end.
     1574   do ii = 1 to num-entries('шту,дро,сер,вес,топ,сте':U):
     1575       FIND FIRST ub.tax-units No-LOCK WHERE
     1576                             ub.tax-units.tax-code = tt-tax.tax-code AND
     1577                             ub.tax-units.type = entry(ii, 'шту,дро,сер,вес,топ,сте':U) No-ERROR.
     1578       create tt-tax-units.
     1579       assign
     1580       tt-tax-units.tax-code = tt-tax.tax-code
     1581       tt-tax-units.type = entry(ii, 'шту,дро,сер,вес,топ,сте':U)
     1582       tt-tax-units.is-found = avail ub.tax-units
     1583       .
     1584   end.
     1585   END PROCEDURE.
     1586   PROCEDURE MyEnable :
     1587     DISPLAY TaxType
     1588         WITH FRAME D-add-tax.
     1589     IF AVAILABLE tt-tax THEN
     1590       DISPLAY tt-tax.tax-code tt-tax.tax-name tt-tax.to-cashdesk
     1591         WITH FRAME D-add-tax.
     1592     ENABLE
     1593     B-exit
     1594     B-quit
     1595       B-Help
     1596       tt-tax.tax-name when ref-mode = 'ДОБАВЛЕНИЕ':U or tt-tax.tax-code > 4
     1597       tt-tax.to-cashdesk
     1598       tt-tax.individual when ref-mode = 'ДОБАВЛЕНИЕ':U or tt-tax.tax-code > 4
     1599       b-mark when ref-mode = 'ДОБАВЛЕНИЕ':U or tt-tax.tax-code > 4
     1600         WITH FRAME D-add-tax.
     1601     VIEW FRAME D-add-tax.
     1602     ENABLE
     1603         tt-tax.tax-code when ref-mode = 'ДОБАВЛЕНИЕ':U
     1604         BR-tt-tax-units
     1605         TaxType when ref-mode = 'ДОБАВЛЕНИЕ':U
     1606         WITH FRAME D-add-tax.
     1607     IF ref-mode = 'ИЗМЕНЕНИЕ':U then do:
     1608         FRAME D-add-tax:title = "Изменение вида налога".
     1609         DISPLAY
     1610         tt-tax.tax-code
     1611         tt-tax.tax-name
     1612         tt-tax.to-cashdesk
     1613         tt-tax.individual
     1614         WITH frame D-add-tax.
     1615         TaxType:screen-value = entry (lookup (tt-tax.tax-type, '%,abs':U), 'процентный,абсолютный':U) .
     1616         DISABLE
     1617         tt-tax.individual
     1618         WITH FRAME D-add-tax.
     1619     END.
     1620     RUN fill-tt.
     1621     OPEN QUERY BR-tt-tax-units for each tt-tax-units.
     1622   END PROCEDURE.
     1623   PROCEDURE proc-b-mark :
     1624   DEFINE INPUT PARAMETER partax-code like ub.tax-units.tax-code no-undo.
     1625   DEFINE INPUT PARAMETER partype like ub.tax-units.type no-undo.
     1626   define buffer b_tt-tax-units for tt-tax-units.
     1627   FIND FIRST b_tt-tax-units where
     1628                     b_tt-tax-units.type = partype AND
     1629                     b_tt-tax-units.tax-code = partax-code No-ERROR.
     1630   if avail b_tt-tax-units then dO:
     1631       assign
     1632       b_tt-tax-units.is-found = not b_tt-tax-units.is-found.
     1633   end.
     1634   END PROCEDURE.
     1635   FUNCTION get-description RETURNS CHARACTER
     1636     ( input partype as character ) :
     1637     RETURN entry(LOOKUP(partype, 'шту,дро,сер,вес,топ,2ед,прп,доп,сте':U), 'штучный,дробный,серийный,весовой,топливо,2едизма,прпарт,дополнительный,стеклопосуда':U).
     1638   END FUNCTION.
