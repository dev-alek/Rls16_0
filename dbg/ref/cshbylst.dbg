      208   procedure userobjs_append :
      209      define input  parameter p-obj-type as character no-undo .
      210      define input  parameter p-obj-code as integer   no-undo .
      211     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      212     do
      213     on error undo, return error return-value
      214     :
      215       find first buf_userobjs_temp-user-obj
      216         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      217           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      218         no-error .
      219       if not available buf_userobjs_temp-user-obj
      220       then do:
      221         create buf_userobjs_temp-user-obj .
      222         assign
      223           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      224           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      225         .
      226       end.
      227     end.
      228   end.
      229   procedure userobjs_object-exist :
