      361   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   define NEW SHARED temp-table temp-disc no-undo
      363   field rule-num as integer
      364   field host-code as integer
      365   field obj-type as character
      366   field obj-code as integer
      367   field templ-rl-root as integer
      368   field time-templ-rl-root as integer
      369   field discnt-role as character
      370   field nonunique as character
      371   field cfg-nonunique as character
      372   field pos-type as character
      373   field action as logical
      374   field label_ as character
      375   index pi is  unique primary
      376   pos-type discnt-role nonunique host-code obj-type obj-code action ASCENDING
      377   index action
      378   action
      379   index ipos
      380   pos-type discnt-role
      381   .
      382   procedure temp-dsc-value :
      383   define input  parameter p-pos-type  as character  no-undo .
      384   define input  parameter p-templ-rl-root as integer  no-undo .
      385   define input  parameter p-time-templ-rl-root as integer no-undo .
      386   define input  parameter p-discnt-role  as character  no-undo .
      387   define input  parameter p-cfg-nonunique as character no-undo .
      388   define input  parameter p-host-code as integer no-undo .
      389   define input  parameter p-obj-type  as character no-undo .
      390   define input  parameter p-obj-code as integer no-undo .
      391   define input  parameter p-0mode as character no-undo .
      392   define input  parameter p-mode      as character no-undo .
      393   define input  parameter p-rec as recid no-undo .
      394   define output parameter p-rule-num    as integer no-undo .
      395   define output parameter p-nonunique   as character no-undo .
      396   define buffer buf_temp-disc for temp-disc .
      397   define variable v-discnt-role as character no-undo .
      398   define variable v-rule-num as integer no-undo .
      399   define variable v-nonunique as character no-undo .
      400   define variable v-templ-rl-root as integer no-undo .
      401   define variable v-time-templ-rl-root as integer no-undo .
      402   define variable v-setted         as logical   no-undo .
      403   define variable choice as integer no-undo .
      404   do
      405   on error undo, return error
      406   :
      407     case 'dis-cp-rule':U:
      408       when 'dis-gds-rule':U
      409       then do:
      410         run discfgru-check  in this-procedure (
      411                                                  input 'dis-gds-rule':U
      412                                                 ,input p-templ-rl-root
      413                                                 ,input p-time-templ-rl-root
      414                                                 ,input p-pos-type
      415                                                 ,output v-discnt-role) no-error.
      416       end.
      417       when 'dis-dc-rule':U then do:
      418         run discfgru-check  in this-procedure (
      419                                                  input 'dis-dc-rule':U
      420                                                 ,input p-templ-rl-root
      421                                                 ,input p-time-templ-rl-root
      422                                                 ,input p-pos-type
      423                                                 ,output v-discnt-role) no-error.
      424       end.
      425       when 'dis-cp-rule':U then do:
      426         run discfgru-check  in this-procedure (
      427                                                  input 'dis-cp-rule':U
      428                                                 ,input p-templ-rl-root
      429                                                 ,input p-time-templ-rl-root
      430                                                 ,input p-pos-type
      431                                                 ,output v-discnt-role) no-error.
      432       end.
      433       otherwise do:
      434         undo, return error .
      435       end.
      436     end case.
      437     if error-status :error
      438     then do:
      439       undo, return error return-value .
      440     end.
      441     if p-mode = "change":U
      442     then do:
      443       if p-rec <> ? then do:
      444         find first buf_temp-disc no-lock where
      445               recid(buf_temp-disc) = p-rec
      446           no-error .
      447       end.
      448       else do:
      449         find first buf_temp-disc no-lock where
      450                   buf_temp-disc.pos-type = p-pos-type
      451               and buf_temp-disc.discnt-role = p-discnt-role
      452               and buf_temp-disc.nonunique  = p-nonunique
      453               and buf_temp-disc.host-code = p-host-code
      454               and buf_temp-disc.obj-type = p-obj-type
      455               and buf_temp-disc.obj-code = p-obj-code
      456           no-error .
      457       end.
      458       if avail buf_temp-disc then do:
      459         assign
      460         v-rule-num =  buf_temp-disc.rule-num
      461         v-nonunique = buf_temp-disc.nonunique
      462         v-templ-rl-root = buf_temp-disc.templ-rl-root
      463         v-time-templ-rl-root = buf_temp-disc.time-templ-rl-root
      464         .
      465       end.
      466     end.
      467     CASE 'dis-cp-rule':U:
      468       when 'dis-cp-rule':U then do:
      469         if p-0mode = 'удаление':U then do:
      470           run gbl/d-askw.w (   input "Вопрос"
      471                               ,input "Вы хотите удалить скидки"
      472                               ,input "|"
      473                               ,input "Конкретная|Все ТАКИЕ|Отмена"
      474                               ,input "по одному КОНКРЕТНОМУ правилу|СКИДКИ НА ПЛАТЕЖ ЭТОГО ТИПА ПО ЭТОМУ ШАБЛОНУ|Ничего не делать"
      475                               ,input 1
      476                               ,input 3
      477                               ,output choice).
      478       end.
      479       else do:
      480         choice = 1.
      481       end.
      482       if choice = 3
      483       then do:
      484         undo, return "not-set".
      485       end.
      486       if choice = 2 then do:
      487          v-rule-num = ?.
      488          v-setted = yes.
      489        end.
      490        else do:
      491         run discpru-edit in this-procedure (
      492                                          input 'ИЗМЕНЕНИЕ':U
      493                                         ,input 0
      494                                         ,input 0
      495                                         ,input p-host-code
      496                                         ,input p-obj-type
      497                                         ,input p-obj-code
      498                                         ,INPUT p-pos-type
      499                                         ,input p-discnt-role
      500                                         ,input p-templ-rl-root
      501                                         ,input p-time-templ-rl-root
      502                                         ,input p-cfg-nonunique
      503                                         ,input 1
      504                                         ,input-output v-rule-num
      505                                         ,input-output v-nonunique
      506                                         ,output v-setted ) no-error.
      507           if error-status :error then do:
      508           undo, return error substitute("Ошибка при получения значения скидки по платежу:&1" +
      509                                         "место использ. &2 тип скидки &3"
      510                                         , chr(10)
      511                                         , p-pos-type
      512                                         , entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u)).
      513           end.
      514         end.
      515       end.
      516     END CASE.
      517     if v-setted = no then do:
      518       return "not-set":U.
      519     end.
      520     p-rule-num = v-rule-num.
      521     p-nonunique = v-nonunique.
      522   end.
      523   end procedure.
      524   procedure temp-dsc-write :
      525     do
      526     on error undo, return error
      527     :
      528       define input parameter p-add      as logical no-undo .
      529       define input parameter p-pos-type as character  no-undo .
      530       define input parameter p-templ-rl-root as integer  no-undo .
      531       define input parameter p-time-templ-rl-root as integer  no-undo .
      532       define input parameter p-discnt-role as character  no-undo .
      533       define input parameter p-cfg-nonunique as character no-undo .
      534       define input parameter p-host-code as integer no-undo .
      535       define input parameter p-obj-type as character no-undo .
      536       define input parameter p-obj-code as integer no-undo .
      537       define input parameter p-rule-num  as integer no-undo .
      538       define input parameter p-action   like temp-disc.action no-undo .
      539       define input-output parameter p-rec as recid no-undo .
      540       define buffer buf_temp-disc for temp-disc .
      541       define variable v-discnt-role as character no-undo .
      542       define variable varhost-code like ub.clients.host-code no-undo.
      543       define variable varobj-type like ub.clients.obj-type no-undo.
      544       define variable varobj-code like ub.clients.obj-code no-undo.
      545       define variable choice as integer no-undo .
      546       define var loc#log as logical no-undo.
      547       define variable loc-action as logical no-undo.
      548       define variable v-nonunique as character no-undo .
      549       define buffer buf_dis-rule for ub.dis-rule.
      550       case 'dis-cp-rule':U:
      551         when 'dis-gds-rule':U
      552         then do:
      553           run discfgru-check  in this-procedure (
      554                                                   input 'dis-gds-rule':U
      555                                                  ,input p-templ-rl-root
      556                                                  ,input p-time-templ-rl-root
      557                                                  ,input p-pos-type
      558                                                  ,output v-discnt-role) no-error.
      559         end.
      560         when 'dis-dc-rule':U
      561         then do:
      562           run discfgru-check  in this-procedure (
      563                                                   input 'dis-dc-rule':U
      564                                                  ,input p-templ-rl-root
      565                                                  ,input p-time-templ-rl-root
      566                                                  ,input p-pos-type
      567                                                  ,output v-discnt-role) no-error.
      568         end.
      569         when 'dis-cp-rule':U
      570         then do:
      571           run discfgru-check  in this-procedure (
      572                                                   input 'dis-cp-rule':U
      573                                                  ,input p-templ-rl-root
      574                                                  ,input p-time-templ-rl-root
      575                                                  ,input p-pos-type
      576                                                  ,output v-discnt-role) no-error.
      577         end.
      578         otherwise do:
      579           undo, return error .
      580         end.
      581       END CASE.
      582       if error-status :error then do:
      583         undo, return error return-value .
      584       end.
      585       if p-cfg-nonunique <> '':U
      586       and p-rule-num <> 0
      587       and p-rule-num <> ?
      588       then do:
      589         find first buf_dis-rule no-lock where
      590                 buf_dis-rule.rule-num = p-rule-num no-error.
      591         if not available buf_dis-rule then do:
      592           undo, return error substitute("Не найдено правило скидок &1", p-rule-num).
      593         end.
      594         assign
      595         v-nonunique = (if p-cfg-nonunique = '':U
      596                       then '':U
      597                       else (if p-cfg-nonunique begins "@"
      598                             then left-trim(p-cfg-nonunique, "@")
      599                             else string(buffer buf_Dis-rule:handle:buffer-field(p-cfg-nonunique):buffer-value)
      600                             ))
      601         .
      602       end.
      603       if p-rec <> ? then do:
      604         find first buf_temp-disc exclusive-lock where
      605                   recid(buf_temp-disc) = p-rec no-error .
      606       end.
      607       else do:
      608         find first buf_temp-disc exclusive-lock where
      609                   buf_temp-disc.pos-type = p-pos-type
      610                 and buf_temp-disc.discnt-role = p-discnt-role
      611                 and buf_temp-disc.host-code = p-host-code
      612                 and buf_temp-disc.obj-type = p-obj-type
      613                 and buf_temp-disc.obj-code = p-obj-code
      614                 and buf_temp-disc.nonunique = v-nonunique
      615                 no-error .
      616       end.
      617       if not available buf_temp-disc then do:
      618         create buf_temp-disc .
      619         assign
      620         buf_temp-disc.host-code = p-host-code
      621         buf_temp-disc.obj-type = p-obj-type
      622         buf_temp-disc.obj-code = p-obj-code
      623         buf_temp-disc.rule-num = p-rule-num
      624         buf_temp-disc.action = p-action
      625         buf_temp-disc.pos-type = p-pos-type
      626         buf_temp-disc.discnt-role = p-discnt-role
      627         buf_temp-disc.cfg-nonunique = p-cfg-nonunique
      628         buf_temp-disc.rule-num = p-rule-num
      629         buf_temp-disc.nonunique = v-nonunique
      630         buf_temp-disc.time-templ-rl-root = p-time-templ-rl-root
      631         buf_temp-disc.templ-rl-root = p-templ-rl-root
      632         p-rec = recid(buf_temp-disc)
      633         no-error
      634         .
      635       end.
      636       ELSE do:
      637         if p-add then do:
      638            message
      639            substitute("Такая скидка уже добавлена&1"
      640                       ,chr(10)
      641                   )
      642            view-as alert-box error .
      643           undo, return error "not-set" .
      644         end.
      645         ASSIGN
      646         buf_temp-disc.rule-num = p-rule-num
      647         buf_temp-disc.nonunique = v-nonunique
      648         buf_temp-disc.time-templ-rl-root = p-time-templ-rl-root
      649         buf_temp-disc.templ-rl-root = p-templ-rl-root
      650         p-rec = recid(buf_temp-disc)
      651         no-error.
      652       end.
      653     end.
      654   end procedure.
      655   procedure temp-dsc-exist :
      656   define input parameter p-pos-type as character  no-undo .
      657   define input parameter p-templ-rl-root as integer  no-undo .
      658   define input parameter p-time-templ-rl-root as integer no-undo .
      659   define input parameter p-discnt-role as character  no-undo .
      660   define input parameter p-nonunique as character no-undo .
      661   define input parameter p-host-code as integer no-undo .
      662   define input parameter p-obj-type as character no-undo .
      663   define input parameter p-obj-code as integer no-undo .
      664   define output parameter p-exist    as logical no-undo .
      665   define output parameter p-action as logical no-undo .
      666   define variable v-discnt-role as character no-undo .
      667   define buffer buf_temp-disc for temp-disc .
      668     do
      669     on error undo, return error
      670     :
      671       case 'dis-cp-rule':U:
      672         when 'dis-gds-rule':U then do:
      673           run discfgru-check  in this-procedure (
      674                                                   input 'dis-gds-rule':U
      675                                                  ,input p-templ-rl-root
      676                                                  ,input p-time-templ-rl-root
      677                                                  ,input p-pos-type
      678                                                  ,output v-discnt-role) no-error.
      679         end.
      680         when 'dis-dc-rule':U then do:
      681           run discfgru-check  in this-procedure (
      682                                                   input 'dis-dc-rule':U
      683                                                  ,input p-templ-rl-root
      684                                                  ,input p-time-templ-rl-root
      685                                                  ,input p-pos-type
      686                                                  ,output v-discnt-role) no-error.
      687         end.
      688         otherwise do:
      689           undo, return error .
      690         end.
      691       end case.
      692       if error-status :error
      693       then do:
      694         undo, return error return-value .
      695       end.
      696       find first buf_temp-disc no-lock where
      697                  buf_temp-disc.pos-type = p-pos-type
      698               and buf_temp-disc.discnt-role = p-discnt-role
      699               and buf_temp-disc.host-code = p-host-code
      700               and buf_temp-disc.obj-type = p-obj-type
      701               and buf_temp-disc.obj-code = p-obj-code
      702               and buf_temp-disc.nonunique = p-nonunique no-error .
      703       if available buf_temp-disc then do:
      704         P-EXIST = YES.
      705         p-action = buf_temp-disc.action.
      706       end.
      707     end.
      708   end procedure.
      709   procedure temp-dsc-delete :
      710   define input parameter p-pos-type as character  no-undo .
      711   define input parameter p-discnt-role as character no-undo .
      712   define input parameter p-nonunique as character no-undo .
      713   define input parameter p-host-code  as integer no-undo .
      714   define input parameter p-obj-type as character no-undo .
      715   define input parameter p-obj-code as integer no-undo .
      716   define input parameter p-action as logical no-undo .
      717   define output parameter p-deleted  as logical no-undo .
      718   define buffer buf_temp-disc for temp-disc .
      719     do
      720     on error undo, return error :
      721       case 'dis-cp-rule':U:
      722         when 'dis-gds-rule':U
      723         then do:
      724           error-status:error = no.
      725         end.
      726         when 'dis-dc-rule':U
      727         then do:
      728           error-status:error = no.
      729         end.
      730         when 'dis-cp-rule':U
      731         then do:
      732           error-status:error = no.
      733         end.
      734         otherwise do:
      735           undo, return error .
      736         end.
      737       END CASE.
      738       if error-status :error then do:
      739         undo, return error return-value .
      740       end.
      741       find first buf_temp-disc exclusive-lock where
      742                  buf_temp-disc.pos-type = p-pos-type
      743              and buf_temp-disc.discnt-role = p-discnt-role
      744              and buf_temp-disc.host-code = p-host-code
      745              and buf_temp-disc.obj-type = p-obj-type
      746              and buf_temp-disc.obj-code = p-obj-code
      747              and buf_temp-disc.nonunique = p-nonunique
      748              and buf_temp-disc.action = p-action
      749              no-error .
      750       if not available buf_temp-disc then do:
      751         P-DELETED = NO.
      752       end.
      753       ELSE DO:
      754          delete buf_temp-disc.
      755          P-DELETED = YES.
      756       END.
      757     end.
      758   end procedure.
      759   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      760   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      761   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      762   procedure disrules-fill-properties:
      763   define input  parameter p-templ-rl-root as integer   no-undo .
      764   define buffer buf_drt-prop for ub.drt-prop.
      765   define buffer buf_temp-drt-prop for temp-drt-prop.
      766   do
      767   on error undo, return error return-value
      768   :
      769     for each buf_temp-drt-prop:
      770       delete buf_temp-drt-prop.
      771     end.
      772     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      773       create buf_temp-drt-prop.
      774       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      775     end.
      776   end.
      777   end procedure.
      778   ~
      779   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      780   procedure discfgru-check :
      781   define input parameter p-table-name as character no-undo .
      782   define input parameter p-templ-rl-root as integer no-undo .
      783   define input parameter p-time-templ-rl-root as integer no-undo .
      784   define input parameter p-pos-type as character no-undo .
      785   define output parameter p-disnct-role as character no-undo .
      786   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      787     do
      788     on error undo, return error return-value
      789     :
      790       find first buf_dis-cfg-rule no-lock where
      791               buf_dis-cfg-rule.table-name = p-table-name
      792           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      793           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
      794           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
      795       if not available buf_dis-cfg-rule
      796       or p-pos-type = "":U
      797       then do:
      798          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
      799                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      800                                  , p-templ-rl-root
      801                                  , (if p-time-templ-rl-root = ?
      802                                     then '':U
      803                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
      804                                     )
      805                                  ).
      806       end.
      807       assign
      808       p-disnct-role = buf_dis-cfg-rule.discnt-role
      809       .
      810     end.
      811   end procedure.
      812   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      813   FUNCTION get-region RETURNS CHARACTER
      814     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      815     define variable par-region as character no-undo.
      816     if parhost-code = 0 and
      817          parobj-type = "":U and
      818          parobj-code = 0 then do:
      819          par-region = "Глобально".
      820          return par-region.
      821       end.
      822       if parobj-type = 'орг':U then do:
      823          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      824          return par-region.
      825       end.
      826       if parobj-type = 'регион':U
      827       then do:
      828          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      829          return par-region.
      830       end.
      831       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      832       return par-region.
      833   END FUNCTION.
      834   FUNCTION get-objregion RETURNS CHARACTER
      835     (  input parobj-type as character, input parobj-code as integer ) :
      836     define variable par-region as character no-undo.
      837     if  parobj-type = "":U and
      838         parobj-code = 0
      839     then do:
      840        par-region = "Глобально".
      841     end.
      842     else if parobj-type = 'орг':U
      843     then do:
      844        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      845     end.
      846     else if parobj-type = 'регион':U
      847     then do:
      848        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      849     end.
      850     else
      851        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      852     return par-region.
      853   END FUNCTION.
      854   procedure discpru-name :
      855   define buffer buf_dis-rule for ub.dis-rule.
      856   do
      857     on error undo, return error
      858     :
      859     define input  parameter p-templ-rl-root  as integer no-undo .
      860     define output parameter p-label          as character no-undo .
      861     find first buf_dis-rule no-lock where
      862               buf_dis-rule.rule-num = p-templ-rl-root no-error.
      863     if available buf_dis-rule then do:
      864       if buf_dis-rule.rule-num > 0 then
      865       p-label = buf_dis-rule.des.
      866     end.
      867     else do:
      868       p-label = substitute("Неизвестный шаблон правила скидки &1", p-templ-rl-root).
      869     end.
      870   end.
      871   end procedure.
      872   function discpru-get-disc-label returns character ( input p-templ-rl-root as integer):
      873   define variable v-rule-label as character no-undo .
      874   run discpru-name in this-procedure ( input p-templ-rl-root
      875                                        ,output v-rule-label) no-error.
      876   return v-rule-label.
      877   end function.
      878   function discpru-get-disc-role-label returns character ( input p-discnt-role as character):
      879   define variable v-rule-label as character no-undo .
      880   return entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u).
      881   end function.
      882   procedure discpru-write :
      883     do
      884     on error undo, return error
      885     :
      886       define input parameter p-cdpay-code     like ub.dis-cp-rule.cdpay-code  no-undo .
      887       define input parameter p-curr-code      like ub.dis-cp-rule.curr-code  no-undo .
      888       define input parameter p-host-code      like ub.dis-cp-rule.host-code   no-undo .
      889       define input parameter p-obj-type       like ub.dis-cp-rule.obj-type   no-undo .
      890       define input parameter p-obj-code       like ub.dis-cp-rule.obj-code   no-undo .
      891       define input parameter p-pos-type       like ub.dis-cp-rule.pos-type   no-undo .
      892       define input parameter p-discnt-role    like ub.dis-cp-rule.discnt-role no-undo .
      893       define input parameter p-templ-rl-root  like ub.dis-cp-rule.templ-rl-root  no-undo .
      894       define input parameter p-time-templ-rl-root  like ub.dis-cp-rule.time-templ-rl-root  no-undo .
      895       define input parameter p-rule-num       like ub.dis-cp-rule.rule-num    no-undo .
      896       define input parameter p-nonunique      like ub.dis-cp-rule.nonunique   no-undo .
      897       define buffer buf_dis-rule for ub.dis-rule.
      898       define buffer buf_dis-cp-rule for ub.dis-cp-rule .
      899       define buffer lock_dis-cp-rule for ub.dis-cp-rule .
      900       define variable v-label          as character no-undo .
      901       define variable v-discnt-role as character no-undo .
      902       run discfgru-check in this-procedure (
      903                                             input 'dis-cp-rule':U
      904                                            ,input p-templ-rl-root
      905                                            ,input p-time-templ-rl-root
      906                                            ,input p-pos-type
      907                                            ,output v-discnt-role
      908                                             ) no-error .
      909       if error-status :error then do:
      910         undo, return error return-value .
      911       end.
      912       if p-discnt-role = ? then do:
      913         p-discnt-role = v-discnt-role.
      914       end.
      915       if p-discnt-role <> v-discnt-role then do:
      916         undo, return error substitute("Тип платежа &1 код валюты &2 фирма &3 &4 место использ. &5 скидка типа &6&7не может быть по шаблону &8 и расписанию &9"
      917                                 ,p-cdpay-code
      918                                 ,p-curr-code
      919                                 ,p-host-code
      920                                 ,(p-obj-type + string(p-obj-code))
      921                                 ,p-pos-type
      922                                 ,entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u)
      923                                 ,chr(10)
      924                                 ,p-templ-rl-root
      925                                 ,p-rule-num).
      926       end.
      927       if p-pos-type = ? then do:
      928   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      929   define variable v-param-type8 as character no-undo .
      930   define variable v-value-date8 as date no-undo .
      931   define variable v-value-decimal8 as decimal no-undo .
      932   define variable v-value-integer8 as INTEGER no-undo .
      933   define variable v-value-logical8 AS LOGICAL no-undo .
      934   define variable v-tth8 as handle no-undo .
      935   run adm/shattri.p (
      936       input "get":U
      937       ,input  p-obj-type
      938       ,input  p-obj-code
      939       ,input  'cd-sending':U
      940       ,input  'dflt-cd':U
      941       ,output p-pos-type
      942       ,output v-value-date8
      943       ,output v-value-decimal8
      944       ,output v-value-integer8
      945       ,output v-value-logical8
      946       ,output v-param-type8
      947       ,INPUT-OUTPUT table-handle v-tth8
      948       )  .
      949   delete object v-tth8 no-error.
      950       end.
      951       find first buf_dis-rule no-lock where
      952                 buf_dis-rule.rule-num = p-rule-num no-error.
      953       if not available buf_Dis-rule then do:
      954         undo, return error substitute("Тип платежа &1 код валюты &2 фирма &3 &4 место использ. &5 скидка типа &6&7не найдено правило скидки &8"
      955                                 ,p-cdpay-code
      956                                 ,p-curr-code
      957                                 ,p-host-code
      958                                 ,(p-obj-type + string(p-obj-code))
      959                                 ,p-pos-type
      960                                 ,entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u)
      961                                 ,chr(10)
      962                                 ,p-rule-num).
      963       end.
      964       if buf_dis-rule.root <> yes then do:
      965         undo, return error substitute("Тип платежа &1 код валюты &2 фирма &3 &4 место использ. &5 скидка типа &6&7правило скидки &8 - некорневое"
      966                                 ,p-cdpay-code
      967                                 ,p-curr-code
      968                                 ,p-host-code
      969                                 ,(p-obj-type + string(p-obj-code))
      970                                 ,p-pos-type
      971                                 ,entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u)
      972                                 ,chr(10)
      973                                 ,p-rule-num).
      974       end.
      975       if not (p-obj-type = buf_dis-rule.obj-type
      976           and p-obj-code = buf_dis-rule.obj-code) then do:
      977         undo, return error (substitute("Тип платежа &1 код валюты &2 фирма &3 &4 место использ. &5 скидка типа &6&7правило скидки &8"
      978                                 ,p-cdpay-code
      979                                 ,p-curr-code
      980                                 ,p-host-code
      981                                 ,(p-obj-type + string(p-obj-code))
      982                                 ,p-pos-type
      983                                 ,entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u)
      984                                 ,chr(10)
      985                                 ,p-rule-num)
      986                             +
      987                             substitute("Правило скидки &1 определено для &1&2" +
      988                                        "а привязка к ДК для &3"
      989                                        ,get-region( buf_Dis-rule.host-code, buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
      990                                        ,chr(10)
      991                                        ,get-region( p-host-code, p-obj-type, p-obj-code)
      992                                        ))
      993                                 .
      994       end.
      995       find first buf_dis-cp-rule exclusive-lock where
      996                  buf_dis-cp-rule.cdpay-code  = p-cdpay-code
      997              AND buf_dis-cp-rule.curr-code  = p-curr-code
      998              AND buf_dis-cp-rule.obj-type  = p-obj-type
      999              AND buf_dis-cp-rule.host-code = p-host-code
     1000              AND buf_dis-cp-rule.obj-code  = p-obj-code
     1001              AND buf_dis-cp-rule.pos-type  = p-pos-type
     1002              AND buf_dis-cp-rule.discnt-role = p-discnt-role
     1003              and buf_dis-cp-rule.nonunique = p-nonunique
     1004              no-error .
     1005       if not available buf_dis-cp-rule then do:
     1006         create buf_dis-cp-rule .
     1007         assign
     1008         buf_dis-cp-rule.cdpay-code  = p-cdpay-code
     1009         buf_dis-cp-rule.curr-code  = p-curr-code
     1010         buf_dis-cp-rule.host-code  = p-host-code
     1011         buf_dis-cp-rule.obj-type  = p-obj-type
     1012         buf_dis-cp-rule.obj-code  = p-obj-code
     1013         buf_dis-cp-rule.pos-type = p-pos-type
     1014         buf_dis-cp-rule.discnt-role = v-discnt-role
     1015         buf_dis-cp-rule.rule-num = p-rule-num
     1016         buf_dis-cp-rule.nonunique = p-nonunique
     1017         no-error
     1018         .
     1019       end.
     1020       ASSIGN
     1021       buf_dis-cp-rule.rule-num = p-rule-num
     1022       buf_dis-cp-rule.rl-root = buf_Dis-rule.rl-root
     1023       buf_dis-cp-rule.templ-rl-root = p-templ-rl-root
     1024       buf_dis-cp-rule.time-templ-rl-root = p-time-templ-rl-root
     1025       buf_dis-cp-rule.nonunique = p-nonunique
     1026       no-error.
     1027     end.
     1028   end procedure.
     1029   procedure discpru-delete :
     1030   define input parameter p-cdpay-code     like ub.dis-cp-rule.cdpay-code  no-undo .
     1031   define input parameter p-curr-code      like ub.dis-cp-rule.curr-code  no-undo .
     1032   define input parameter p-host-code      like ub.dis-cp-rule.host-code   no-undo .
     1033   define input parameter p-obj-type       like ub.dis-cp-rule.obj-type   no-undo .
     1034   define input parameter p-obj-code       like ub.dis-cp-rule.obj-code   no-undo .
     1035   define input parameter p-pos-type       like ub.dis-cp-rule.pos-type   no-undo .
     1036   define input parameter p-discnt-role    like ub.dis-cp-rule.discnt-role no-undo .
     1037   define input parameter p-nonunique      like ub.dis-cp-rule.nonunique   no-undo .
     1038   define output parameter p-deleted       as logical no-undo .
     1039   define variable v-rule-label as character no-undo .
     1040   define buffer buf_dis-cp-rule for ub.dis-cp-rule.
     1041   do
     1042   on error undo, return error
     1043   :
     1044   find first buf_dis-cp-rule exclusive-lock where
     1045               buf_dis-cp-rule.cdpay-code  = p-cdpay-code
     1046           AND buf_dis-cp-rule.curr-code  = p-curr-code
     1047           AND buf_dis-cp-rule.obj-type  = p-obj-type
     1048           AND buf_dis-cp-rule.host-code = p-host-code
     1049           AND buf_dis-cp-rule.obj-code  = p-obj-code
     1050           AND buf_dis-cp-rule.pos-type  = p-pos-type
     1051           AND buf_dis-cp-rule.discnt-role = p-discnt-role
     1052           and buf_dis-cp-rule.nonunique = p-nonunique
     1053           no-error .
     1054   if not available buf_dis-cp-rule then do:
     1055     return '':U.
     1056   end.
     1057   delete buf_dis-cp-rule no-error.
     1058   if error-status:error then do:
     1059     run discpru-name in this-procedure
     1060       (input  buf_dis-cp-rule.templ-rl-root
     1061       ,output v-rule-label
     1062       ) no-error .
     1063     undo, return error substitute("Ошибка при удалении скидки по типу касс. платежа:&1" +
     1064                                  "скидка &2 (POS &3) на фирме &4 &5&6 для платежа&1&7&1&8"
     1065                                   ,chr(10)
     1066                                   ,v-rule-label
     1067                                   ,p-pos-type
     1068                                   ,p-host-code
     1069                                   ,p-obj-type
     1070                                   ,p-obj-code
     1071                                   ,error-status:get-message(1)
     1072                                   ,return-value ).
     1073   end.
     1074   p-deleted = yes.
     1075   return '':U.
     1076   end.
     1077   end procedure.
     1078   procedure discpru-edit :
     1079   define input parameter p-mode as character no-undo .
     1080   define input parameter p-cdpay-code   like ub.dis-cp-rule.cdpay-code no-undo .
     1081   define input parameter p-curr-code   like ub.dis-cp-rule.curr-code no-undo .
     1082   define input parameter p-host-code like ub.dis-cp-rule.host-code no-undo .
     1083   define input parameter p-obj-type like ub.dis-cp-rule.obj-type no-undo .
     1084   define input parameter p-obj-code like ub.dis-cp-rule.obj-code no-undo .
     1085   define input parameter p-pos-type like ub.dis-cp-rule.pos-type no-undo .
     1086   define input parameter p-discnt-role    like ub.dis-cp-rule.discnt-role no-undo .
     1087   define input parameter p-templ-rl-root like ub.dis-cp-rule.templ-rl-root no-undo .
     1088   define input parameter p-time-templ-rl-root like ub.dis-cp-rule.time-templ-rl-root no-undo .
     1089   define input parameter p-cfg-NONUNIQUE as character no-undo .
     1090   define input parameter p-check as integer no-undo .
     1091   define input-output parameter p-rule-num as integer no-undo .
     1092   define input-output parameter p-nonunique as character no-undo .
     1093   define output parameter p-setted as logical no-undo .
     1094   DEFINE VARIABLE v-value as character no-undo .
     1095   define variable v-sts as integer no-undo .
     1096   define variable v-rid-list as character no-undo .
     1097   DEFINE VARIABLE v-rule-num as integer no-undo .
     1098   define variable v-cd-dr-correct  as logical no-undo .
     1099   define variable jj as integer no-undo .
     1100   define variable conf-par as character no-undo .
     1101   define variable conf-attr as character no-undo .
     1102   define variable par-type as character no-undo .
     1103   define variable dflt-cd as character no-undo .
     1104   define variable v-cd-list as character no-undo .
     1105   define variable v-is-time-rule as logical no-undo .
     1106   define variable v-label as character no-undo .
     1107   define variable v-nonunique as character no-undo .
     1108   define variable v-mode as character no-undo .
     1109   define buffer buf_dis-rule for ub.dis-rule.
     1110   define buffer buf_dis-time-rule for ub.dis-time-rule .
     1111   define buffer term_dis-rule for ub.dis-rule.
     1112   define buffer buf_dis-cp-rule for ub.dis-cp-rule.
     1113   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1114   define buffer buf_temp-cpdisc for temp-cpdisc.
     1115   assign
     1116   v-rule-num = p-rule-num.
     1117   v-sts = integer('0':U).
     1118   if v-rule-num <> 0
     1119   and v-rule-num <> ?
     1120   then do:
     1121     find first buf_dis-rule no-lock where
     1122               buf_dis-rule.rule-num = v-rule-num no-error .
     1123     if error-status:error then do:
     1124       message
     1125       "Ошибка при поиске правила с номером" v-rule-num
     1126       view-as alert-box error .
     1127       return .
     1128     end.
     1129     assign
     1130     v-rid-list = string(recid(buf_dis-rule))
     1131     .
     1132   end.
     1133     run discpru-name in this-procedure (
     1134                                   input p-templ-rl-root
     1135                                   ,output v-label) no-error.
     1136   if p-pos-type = ?
     1137   or p-pos-type = '':U then do:
     1138   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1139   define variable v-param-type9 as character no-undo .
     1140   define variable v-value-date9 as date no-undo .
     1141   define variable v-value-decimal9 as decimal no-undo .
     1142   define variable v-value-integer9 as INTEGER no-undo .
     1143   define variable v-value-logical9 AS LOGICAL no-undo .
     1144   define variable v-tth9 as handle no-undo .
     1145   run adm/shattri.p (
     1146       input "get":U
     1147       ,input  p-obj-type
     1148       ,input  p-obj-code
     1149       ,input  'cd-sending':U
     1150       ,input  'dflt-cd':U
     1151       ,output dflt-cd
     1152       ,output v-value-date9
     1153       ,output v-value-decimal9
     1154       ,output v-value-integer9
     1155       ,output v-value-logical9
     1156       ,output v-param-type9
     1157       ,INPUT-OUTPUT table-handle v-tth9
     1158       )  .
     1159   delete object v-tth9 no-error.
     1160   end.
     1161   else do:
     1162     dflt-cd = p-pos-type.
     1163   end.
     1164   v-mode =  'dis-cp-rule':U + "=" + p-discnt-role + "=" + (if p-host-code = 0
     1165                                                                then "global"
     1166                                                                else (if p-obj-type = ''
     1167                                                                     then "host"
     1168                                                                     else "object")
     1169                                                                ) .
     1170   run ref/dis-ruls.w (
     1171               input parparentproc
     1172               ,input p-host-code
     1173               ,input p-obj-type
     1174               ,input p-obj-code
     1175               ,input "b-add,b-sel":U
     1176               ,input "upper-rule-num-object":u
     1177               ,input p-templ-rl-root
     1178               ,input p-time-templ-rl-root
     1179               ,input 0
     1180               ,input-output v-sts
     1181               ,input-output v-rid-list ) no-error .
     1182   do
     1183   on error undo, return error return-value
     1184   :
     1185     if v-rid-list <> "":U then do:
     1186       find first buf_dis-rule exclusive-lock where
     1187                   recid(buf_dis-rule) = integer(v-rid-list) no-wait no-error .
     1188       if not available buf_dis-rule
     1189       then do:
     1190         message
     1191         "Ошибка при поиске правила с recid" v-rid-list
     1192         view-as alert-box error .
     1193         return .
     1194       end.
     1195       if buf_dis-rule.sts <> integer('0':U) then do:
     1196         message
     1197         "Правило скидки имеет статус" entry (lookup (string(buf_dis-rule.sts), '0,1,2,99,98':U), 'исп,не-исп,детализ,удаление,запр.удал':U) skip
     1198         "Нельзя привязать к нему скидку на платеж"
     1199         view-as alert-box error .
     1200         return .
     1201       end.
     1202       find first buf_dis-cfg-rule no-lock where
     1203               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
     1204           and buf_dis-cfg-rule.time-templ-rl-root = (if buf_dis-rule.time-templ-rl-root = -1
     1205                                                      then 0
     1206                                                      else buf_dis-rule.time-templ-rl-root)
     1207           and buf_dis-cfg-rule.table-name = 'dis-cp-rule':U
     1208           and buf_dis-cfg-rule.pos-type = dflt-cd no-error.
     1209       if available buf_dis-cfg-rule then do:
     1210         assign
     1211         v-cd-dr-correct = yes
     1212         .
     1213       end.
     1214       if not v-cd-dr-correct
     1215       then do:
     1216         message
     1217         substitute("Правило скидки &1 неприменимо для касс &2.&3" +
     1218                   "(АРМ АДМИНИСТРАТОР-Магазины(Фирмы)-Параметры-Общие опции коммуникации с кассами)"
     1219                   ,buf_dis-rule.rule-num
     1220                   ,dflt-cd
     1221                   ,chr(10)
     1222                   )
     1223         view-as alert-box error .
     1224         undo, return error .
     1225       end.
     1226      assign
     1227       v-nonunique = if p-cfg-nonunique = '':U
     1228                     then '':U
     1229                     else string(buffer buf_Dis-rule:handle:buffer-field(p-cfg-nonunique):buffer-value).
     1230       if p-check = 0
     1231       or p-check = 2
     1232       then do:
     1233         find first buf_dis-cp-rule no-lock where
     1234                    buf_dis-cp-rule.host-code = p-host-code
     1235                 and buf_dis-cp-rule.obj-type = p-obj-type
     1236                 and buf_dis-cp-rule.obj-code = p-obj-code
     1237                 and buf_dis-cp-rule.curr-code = p-curr-code
     1238                 and buf_dis-cp-rule.cdpay-code = p-cdpay-code
     1239                 and buf_dis-cp-rule.pos-type = p-pos-type
     1240                 and buf_dis-cp-rule.discnt-role = p-discnt-role
     1241                 and buf_dis-cp-rule.nonunique = v-nonunique no-error .
     1242         if available buf_dis-cp-rule
     1243         and p-mode <> 'ИЗМЕНЕНИЕ':U
     1244         then do:
     1245           message
     1246           "Скидка такого типа на данный тип платежа уже существует"
     1247           view-as alert-box error .
     1248           return error.
     1249         end.
     1250       end.
     1251       if p-check = 1
     1252       or p-check = 2
     1253       then do:
     1254         find first buf_temp-cpdisc no-lock where
     1255                    buf_temp-cpdisc.host-code = p-host-code
     1256                 and buf_temp-cpdisc.obj-type = p-obj-type
     1257                 and buf_temp-cpdisc.obj-code = p-obj-code
     1258                 and buf_temp-cpdisc.cdpay-code = p-cdpay-code
     1259                 and buf_temp-cpdisc.curr-code = p-curr-code
     1260                 and buf_temp-cpdisc.pos-type = p-pos-type
     1261                 and buf_temp-cpdisc.discnt-role = p-discnt-role
     1262                 and buf_temp-cpdisc.nonunique = v-nonunique no-error .
     1263         if available buf_temp-cpdisc
     1264         and buf_temp-cpdisc.rule-num <> 0
     1265         and p-mode <> 'ИЗМЕНЕНИЕ':U
     1266         then do:
     1267           message
     1268         "Скидка такого типа на данный тип платежа уже существует"
     1269           view-as alert-box error .
     1270           return error.
     1271         end.
     1272       end.
     1273       if p-rule-num <> buf_dis-rule.rule-num then do:
     1274         assign
     1275         p-setted = yes
     1276         p-rule-num = buf_dis-rule.rule-num
     1277         p-nonunique = v-nonunique
     1278         .
     1279       end.
     1280     end.
     1281   end.
     1282   end procedure.
     1283   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1284   procedure gen-b-code :
     1285     define input  parameter type-code like ub.code-range.range-type no-undo .
     1286     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
     1287     do
     1288     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1289     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
     1290     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
     1291     :
     1292       define buffer buf_thbj-attr     for ub.thbj-attr .
     1293       define buffer buf_sys-ctrl   for ub.sys-ctrl .
     1294       define buffer buf_code-range for ub.code-range .
     1295       define variable l-code         as   integer              no-undo .
     1296       define variable v-db-num       like ub.db.db-num         no-undo .
     1297       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
     1298       if type-code = 'sslc':U
     1299       or type-code = 'ssgb':U
     1300       then do:
     1301         message
     1302           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
     1303           "Обратитесь к администратору системы."
     1304           view-as alert-box error .
     1305         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
     1306       end.
     1307       run trg/getpcode.p ( input  type-code
     1308                      ,output cfg-param-code
     1309                     ).
     1310       run get-next-seq( input  type-code,
     1311                         output l-code
     1312                       ).
     1313       find first buf_sys-ctrl no-lock.
     1314       if type-code = 'sclc':U
     1315       or type-code = 'pglc':U
     1316       then do:
     1317         assign
     1318           v-db-num = 0
     1319         .
     1320       end.
     1321       else do:
     1322         assign
     1323           v-db-num = buf_sys-ctrl.db-num
     1324         .
     1325       end.
     1326       find first buf_code-range no-lock
     1327         where buf_code-range.db-num     = v-db-num
     1328           and buf_code-range.range-type = type-code
     1329           and buf_code-range.stts       = "a"
     1330         use-index stts
     1331         no-error .
     1332       if available buf_code-range
     1333          and l-code <= buf_code-range.last-code
     1334          and l-code >= buf_code-range.first-code then do:
     1335         assign
     1336           p-b-code = l-code
     1337         .
     1338       end.
     1339       else do:
     1340         if available buf_code-range
     1341            and l-code < buf_code-range.last-code then do:
     1342           message
     1343             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
     1344             "Обратитесь к администратору системы."
     1345             view-as alert-box error .
     1346           undo, return error "sequence":U .
     1347         end.
     1348         do transaction
     1349         on error undo, return error
     1350         :
     1351           find first buf_thbj-attr exclusive-lock
     1352             where buf_thbj-attr.upper-prop-code = 'code-range':U
     1353               and buf_thbj-attr.prop-code = cfg-param-code
     1354               and buf_thbj-attr.obj-type   = 'БД':U
     1355               and buf_thbj-attr.obj-code   = v-db-num
     1356             no-error .
     1357           if not available buf_thbj-attr then do:
     1358             find first buf_thbj-attr exclusive-lock
     1359               where buf_thbj-attr.upper-prop-code = 'code-range':U
     1360                 and buf_thbj-attr.prop-code = cfg-param-code
     1361                 and buf_thbj-attr.obj-type   = ''
     1362                 and buf_thbj-attr.obj-code   = 0
     1363               no-error .
     1364             if not available buf_thbj-attr then do:
     1365               if not locked buf_thbj-attr then do:
     1366                 message
     1367                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
     1368                   "Обратитесь к администратору системы."
     1369                   view-as alert-box error .
     1370               end.
     1371               undo, return error "config":U .
     1372             end.
     1373           end.
     1374           run get-next-seq( input type-code,
     1375                             output l-code
     1376                           ).
     1377           find first buf_code-range
     1378             where buf_code-range.db-num     = v-db-num
     1379               and buf_code-range.range-type = type-code
     1380               and buf_code-range.stts       = "a"
     1381             use-index stts
     1382             no-error .
     1383           if available buf_code-range
     1384           and l-code <= buf_code-range.last-code
     1385           and l-code >= buf_code-range.first-code
     1386           then do:
     1387             assign
     1388               p-b-code = l-code
     1389             .
     1390           end.
     1391           else do:
     1392             if available buf_code-range then do:
     1393               assign
     1394                 buf_code-range.stts = "u"
     1395               .
     1396             end.
     1397             find first buf_code-range
     1398               where buf_code-range.db-num     = v-db-num
     1399                 and buf_code-range.range-type = type-code
     1400                 and buf_code-range.stts       = "f"
     1401               use-index stts
     1402               no-error .
     1403             if not available buf_code-range then do:
     1404               message
     1405                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
     1406                 "Обратитесь к администратору системы"
     1407                 view-as alert-box error .
     1408               undo, return error "code-range":U .
     1409             end.
     1410             assign
     1411               buf_code-range.stts           = "a"
     1412             .
     1413             if buf_code-range.first-code = 1 then do:
     1414               run set-seq-cr( input type-code,
     1415                               input buf_code-range.first-code
     1416                             ).
     1417               assign
     1418                 p-b-code = 1
     1419               .
     1420             end.
     1421             else do:
     1422               run set-seq-cr( input type-code,
     1423                               input ( buf_code-range.first-code - 1 )
     1424                             ).
     1425               run get-next-seq( input type-code,
     1426                                 output p-b-code
     1427                               ).
     1428             end.
     1429           end.
     1430         end.
     1431       end.
     1432     end.
     1433   end procedure.
     1434   procedure get-next-seq :
     1435     define input  parameter type-code like ub.code-range.range-type no-undo .
     1436     define output parameter next-seq  as   integer                  no-undo .
     1437     do
     1438     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1439     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
     1440     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
     1441     :
     1442       case type-code:
     1443         when 'bcgb':U then do:
     1444           assign
     1445             next-seq = next-value(s-bcgb-code, ub)
     1446           .
     1447         end.
     1448         when 'scgb':U then do:
     1449           assign
     1450             next-seq = next-value(s-scgb-code, ub)
     1451           .
     1452         end.
     1453         when 'sclc':U then do:
     1454           assign
     1455             next-seq = next-value(s-sclc-code, ub)
     1456           .
     1457         end.
     1458         when 'pglc':U then do:
     1459           assign
     1460             next-seq = next-value(s-pglc-code, ub)
     1461           .
     1462         end.
     1463         when 'dcgb':U then do:
     1464           assign
     1465             next-seq = next-value(s-dcgb-code, ub)
     1466           .
     1467         end.
     1468         when 'ctgb':U then do:
     1469           assign
     1470             next-seq = next-value(s-ctgb-code, ub)
     1471           .
     1472         end.
     1473         when 'drgb':U then do:
     1474           assign
     1475             next-seq = next-value(s-drgb-code, ub)
     1476           .
     1477         end.
     1478         when 'fmgb':U then do:
     1479           assign
     1480             next-seq = next-value(s-fmgb-code, ub)
     1481           .
     1482         end.
     1483         when 'pngb':U then do:
     1484           assign
     1485             next-seq = next-value(s-pngb-code, ub)
     1486           .
     1487         end.
     1488         when 'cagb':U then do:
     1489           assign
     1490             next-seq = next-value(s-cagb-code, ub)
     1491           .
     1492         end.
     1493         when 'fdgb':U then do:
     1494           assign
     1495             next-seq = next-value(s-fin-doc, ub)
     1496           .
     1497         end.
     1498       end case.
     1499     end.
     1500   end procedure.
     1501   procedure set-seq-cr :
     1502     define input parameter type-code like ub.code-range.range-type no-undo .
     1503     define input parameter set-val   like ub.code-range.first-code no-undo .
     1504     do
     1505     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1506     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
     1507     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
     1508     :
     1509       case type-code:
     1510         when 'bcgb':U then do:
     1511           assign
     1512             current-value(s-bcgb-code, ub) = set-val
     1513           .
     1514         end.
     1515         when 'scgb':U then do:
     1516           assign
     1517             current-value(s-scgb-code, ub) = set-val
     1518           .
     1519         end.
     1520         when 'sclc':U then do:
     1521           assign
     1522             current-value(s-sclc-code, ub) = set-val
     1523           .
     1524         end.
     1525         when 'pglc':U then do:
     1526           assign
     1527             current-value(s-pglc-code, ub) = set-val
     1528           .
     1529         end.
     1530         when 'dcgb':U then do:
     1531           assign
     1532             current-value(s-dcgb-code, ub) = set-val
     1533           .
     1534         end.
     1535         when 'ctgb':U then do:
     1536           assign
     1537             current-value(s-ctgb-code, ub) = set-val
     1538           .
     1539         end.
     1540         when 'drgb':U then do:
     1541           assign
     1542             current-value(s-drgb-code, ub) = set-val
     1543           .
     1544         end.
     1545         when 'fmgb':U then do:
     1546           assign
     1547             current-value(s-fmgb-code, ub) = set-val
     1548           .
     1549         end.
     1550         when 'pngb':U then do:
     1551           assign
     1552             current-value(s-pngb-code, ub) = set-val
     1553           .
     1554         end.
     1555         when 'cagb':U then do:
     1556           assign
     1557             current-value(s-cagb-code, ub) = set-val
     1558           .
     1559         end.
     1560         when 'fdgb':U then do:
     1561           assign
     1562             current-value(s-fin-doc, ub) = set-val
     1563           .
     1564         end.
     1565       end case.
     1566     end.
     1567   end procedure.
     1568   procedure new-bcod-gen-code-range :
     1569     do
     1570     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1571     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
     1572     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
     1573     :
     1574       define input parameter p-db-num  like ub.db.db-num             no-undo .
     1575       define input parameter type-code like ub.code-range.range-type no-undo .
     1576       define buffer buf_code-range      for ub.code-range .
     1577       define buffer last_code-range     for ub.code-range .
     1578       define buffer last-1_code-range   for ub.code-range .
     1579       define buffer last-2_code-range   for ub.code-range .
     1580       define buffer last-3_code-range   for ub.code-range .
     1581       define buffer buf_sys-ctrl        for ub.sys-ctrl .
     1582       define variable conf-par       as character no-undo .
     1583       define variable par-type       as character no-undo .
     1584       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
     1585       define variable v-cre-cdrg as logical   no-undo .
     1586       define variable v-cre-str  as character no-undo .
     1587       define variable v-cr1      as integer no-undo .
     1588       define variable v-cr2      as integer no-undo .
     1589       define variable v-cr3      as integer no-undo .
     1590       define variable v-cmax     as integer no-undo .
     1591       find first buf_sys-ctrl no-lock .
     1592       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
     1593         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
     1594                                       ,vss-workfile
     1595                                       ,vss-revision
     1596                                       ,vss-description
     1597                                       ,chr(10)
     1598                                       , p-db-num
     1599                                      ).
     1600       end.
     1601       run trg/getpcode.p ( input  type-code
     1602                      ,output cfg-param-code
     1603                     ).
     1604       for each buf_code-range
     1605         where buf_code-range.db-num     = -1
     1606           and buf_code-range.range-type = type-code
     1607           and buf_code-range.stts       = "f"
     1608       by buf_code-range.first-code
     1609       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1610       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
     1611       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
     1612       :
     1613         assign
     1614           buf_code-range.db-num = p-db-num
     1615         .
     1616         return .
     1617       end.
     1618       assign
     1619         v-cre-cdrg = TRUE
     1620       .
     1621       case type-code:
     1622         when 'sclc':U
     1623         or when 'scgb':U
     1624         or when 'pglc':U
     1625         then do:
     1626           find last last-1_code-range no-lock
     1627             where last-1_code-range.range-type = 'sclc':U
     1628             no-error .
     1629           if available last-1_code-range then do:
     1630             v-cr1 = last-1_code-range.last-code.
     1631           end.
     1632           find last last-2_code-range no-lock
     1633             where last-2_code-range.range-type = 'scgb':U
     1634             no-error .
     1635           if available last-2_code-range then do:
     1636             v-cr2 = last-2_code-range.last-code.
     1637             end.
     1638           find last last-3_code-range no-lock
     1639             where last-3_code-range.range-type = 'pglc':U
     1640             no-error .
     1641           if available last-3_code-range then do:
     1642             v-cr3 = last-3_code-range.last-code.
     1643           end.
     1644           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     1645           .
     1646           if v-cmax = v-cr1  then do:
     1647               find last last_code-range no-lock
     1648                 where recid( last_code-range ) = recid( last-1_code-range )
     1649                 .
     1650             end.
     1651           if v-cmax = v-cr2  then do:
     1652               find last last_code-range no-lock
     1653                 where recid( last_code-range ) = recid( last-2_code-range )
     1654                 .
     1655             end.
     1656           if v-cmax = v-cr3  then do:
     1657             find last last_code-range no-lock
     1658               where recid( last_code-range ) = recid( last-3_code-range )
     1659               .
     1660           end.
     1661           if last_code-range.last-code + 1 > 99999 then do:
     1662             assign
     1663               v-cre-cdrg = FALSE
     1664             .
     1665           end.
     1666         end.
     1667         when 'bcgb':U
     1668         or when 'sslc':U
     1669         or when 'ssgb':U
     1670         then do:
     1671           find last last-1_code-range no-lock
     1672             where last-1_code-range.range-type = 'sslc':U
     1673             no-error .
     1674           if available last-1_code-range then do:
     1675             v-cr1 = last-1_code-range.last-code.
     1676           end.
     1677           find last last-2_code-range no-lock
     1678             where last-2_code-range.range-type = 'bcgb':U
     1679             no-error .
     1680           if available last-2_code-range then do:
     1681             v-cr2 = last-2_code-range.last-code.
     1682             end.
     1683           find last last-3_code-range no-lock
     1684             where last-3_code-range.range-type = 'ssgb':U
     1685             no-error .
     1686           if available last-3_code-range then do:
     1687             v-cr3 = last-3_code-range.last-code.
     1688           end.
     1689           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     1690           .
     1691           if v-cmax = v-cr1  then do:
     1692               find last last_code-range no-lock
     1693                 where recid( last_code-range ) = recid( last-1_code-range )
     1694                 .
     1695             end.
     1696           if v-cmax = v-cr2  then do:
     1697               find last last_code-range no-lock
     1698                 where recid( last_code-range ) = recid( last-2_code-range )
     1699                 .
     1700             end.
     1701           if v-cmax = v-cr3  then do:
     1702             find last last_code-range no-lock
     1703               where recid( last_code-range ) = recid( last-3_code-range )
     1704               .
     1705           end.
     1706         end.
     1707         otherwise do:
     1708           find last last_code-range no-lock
     1709             where last_code-range.range-type = type-code
     1710             no-error .
     1711         end.
     1712       end case.
     1713       if not available last_code-range then do:
     1714         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
     1715                                       ,vss-workfile
     1716                                       ,vss-revision
     1717                                       ,vss-description
     1718                                       , chr(10)
     1719                                       , type-code
     1720                                      ) .
     1721       end.
     1722       define variable v-mes10 as character no-undo .
     1723       define variable v-param-type10 as character no-undo .
     1724       define variable v-value-character10 as INTEGER no-undo .
     1725       define variable v-value-date10 as date no-undo .
     1726       define variable v-value-decimal10 as decimal no-undo .
     1727       define variable v-value-integer10 AS integer no-undo .
     1728       define variable v-value-logical10 AS LOGICAL no-undo .
     1729       define variable v-tth10 as handle no-undo .
     1730       run adm/shattri.p (
     1731           input "get":U
     1732           ,input  'БД':U
     1733           ,input  p-db-num
     1734           ,input  'code-range':U
     1735           ,input  cfg-param-code
     1736           ,output v-value-character10
     1737           ,output v-value-date10
     1738           ,output v-value-decimal10
     1739           ,output v-value-integer10
     1740           ,output v-value-logical10
     1741           ,output v-param-type10
     1742           ,INPUT-OUTPUT table-handle v-tth10
     1743           ) no-error .
     1744       if error-status :error then do:
     1745         delete object v-tth10.
     1746         v-mes10 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
     1747                            , error-status:get-message(1)
     1748                            , chr(10)
     1749                            , return-value ).
     1750         undo, return error v-mes10.
     1751       end.
     1752       delete object v-tth10.
     1753       if v-cre-cdrg = TRUE then do:
     1754         create buf_code-range .
     1755         assign
     1756           buf_code-range.db-num     = p-db-num
     1757           buf_code-range.range-type = type-code
     1758           buf_code-range.stts       = "f"
     1759           buf_code-range.first-code = last_code-range.last-code + 1
     1760           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer10)
     1761           v-cre-str = "Свободный диапазон успешно создан"
     1762         .
     1763       end.
     1764       else do:
     1765         assign
     1766           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
     1767                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
     1768         .
     1769       end.
     1770     end.
     1771     return v-cre-str .
     1772   end procedure.
     1773   procedure gen-new-code-range-if-neces :
     1774     define input parameter v-db-num           like ub.db.db-num             no-undo .
     1775     define input parameter v-range-type       like ub.code-range.range-type no-undo .
     1776     define input parameter v-cur-code         as   integer                  no-undo .
     1777     define input parameter v-g#news           as   logical                  no-undo .
     1778     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
     1779     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
     1780     do
     1781     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1782     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
     1783     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
     1784     :
     1785       define variable l-code-range-exist as logical   no-undo init false .
     1786       define variable v-db-for-send      as character no-undo .
     1787       define buffer buf_code-range  for ub.code-range .
     1788       define buffer buf1_code-range for ub.code-range .
     1789       define buffer buf_db          for ub.db .
     1790       find first buf_code-range
     1791         where buf_code-range.range-type = v-range-type
     1792           and buf_code-range.last-code >= v-cur-code
     1793         use-index last-codei
     1794         no-error .
     1795       if
     1796       (
     1797          available buf_code-range
     1798          and
     1799         (buf_code-range.db-num = v-db-num
     1800           and
     1801         buf_code-range.first-code <= v-cur-code
     1802         )
     1803       or
     1804         (
     1805           v-range-type = 'drgb':U
     1806           AND
     1807           v-cur-code = 0
     1808         )
     1809      )
     1810      then do:
     1811         assign
     1812           l-code-range-exist = true
     1813         .
     1814         if v-g#news
     1815         and buf_code-range.stts = "f" then do:
     1816           assign
     1817             buf_code-range.stts = "u"
     1818           .
     1819         end.
     1820       end.
     1821       if not l-code-range-exist
     1822          and v-g#news-source-db <> 0
     1823       then do:
     1824         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
     1825                                       ,vss-workfile
     1826                                       ,vss-revision
     1827                                       ,vss-description
     1828                                       ,chr(10)
     1829                                       ,v-db-num
     1830                                       ,v-range-type
     1831                                       ,v-cur-code
     1832                                      ).
     1833       end.
     1834       if (not l-code-range-exist
     1835           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
     1836          )
     1837       and ( not can-find (first buf1_code-range no-lock
     1838                           where buf1_code-range.db-num = v-db-num
     1839                             and buf1_code-range.range-type = v-range-type
     1840                             and buf1_code-range.stts = "f"
     1841                          )
     1842           )
     1843       then do:
     1844         if v-g#db-num = 0 then do:
     1845           run new-bcod-gen-code-range in this-procedure
     1846             (input v-db-num,
     1847              input v-range-type
     1848             ) no-error .
     1849           if error-status :error then do:
     1850             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
     1851                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
     1852                                           ,v-db-num
     1853                                           ,v-range-type
     1854                                           ,v-cur-code
     1855                                           ,chr(10)
     1856                                           ,error-status:get-message(1)
     1857                                           ,return-value
     1858                                          ).
     1859           end.
     1860         end.
     1861         else do:
     1862           if v-range-type = 'sclc':U
     1863           or v-range-type = 'pglc':U
     1864           then do:
     1865             assign
     1866               v-db-for-send = "":U
     1867             .
     1868             if v-g#db-num = 0 then do:
     1869               for each buf_db no-lock
     1870                 where buf_db.db-num > 0
     1871                   and buf_db.db-num <> v-g#news-source-db
     1872               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1873               :
     1874                 assign
     1875                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
     1876                 .
     1877               end.
     1878               assign
     1879                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
     1880               .
     1881             end.
     1882             else do:
     1883               if not v-g#news then do:
     1884                 assign
     1885                   v-db-for-send = "0":U
     1886                 .
     1887               end.
     1888             end.
     1889             run nws/cr-route.p ( input 'send-cmd':U
     1890                           ,input ("command":U + chr(1) + "create":U + chr(1) +
     1891                                  "code-range":U + chr(1) +
     1892                                  (if v-range-type = 'sclc':U
     1893                                   then string( current-value(s-sclc-code, ub))
     1894                                   else string( current-value(s-pglc-code, ub))
     1895                                   ) + chr(1) +
     1896                                   v-range-type)
     1897                           ,input ?
     1898                           ,input v-db-for-send
     1899                           ) no-error .
     1900             if error-status :error then do:
     1901               undo, return error return-value.
     1902             end.
     1903           end.
     1904         end.
     1905       end.
     1906     end.
     1907   end procedure.
     1908   procedure cre-loc-sc-code-range :
     1909     define input parameter v-cur-code as integer no-undo .
     1910   define input parameter p-cdrg-type as character no-undo .
     1911     do
     1912     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1913     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
     1914     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
     1915     :
     1916       define buffer buf_code-range for ub.code-range .
     1917       find first buf_code-range
     1918            where buf_code-range.range-type = p-cdrg-type
     1919              and buf_code-range.first-code >= v-cur-code
     1920            no-error .
     1921       if not available buf_code-range then do:
     1922         run new-bcod-gen-code-range in this-procedure
     1923           ( input 0,
     1924             input p-cdrg-type
     1925           ) no-error .
     1926         if error-status :error then do:
     1927           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
     1928                                          + "Код &2&1&3 &4"
     1929                                         , chr(10)
     1930                                         , v-cur-code
     1931                                         , error-status:get-message(1)
     1932                                         , return-value
     1933                                        ) .
     1934         end.
     1935       end.
     1936     end.
     1937   end procedure.
     1938   procedure mark-used-if-need :
     1939   define input parameter p-cur-code as integer no-undo .
     1940   define input parameter p-range-type like ub.code-range.range-type no-undo .
     1941   define input parameter p-db-num like ub.code-range.db-num no-undo .
     1942     do
     1943     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1944     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
     1945     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
     1946     :
     1947       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
     1948       define buffer buf_code-range for ub.code-range .
     1949       assign
     1950       v-db-num = if p-range-type = 'sclc':U
     1951                  then 0
     1952                  else p-db-num
     1953       .
     1954   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1955   define buffer locK-batchprocess11 for ub.batchprocess.
     1956   run gbl/lock-prc.p
     1957       (input 'lscc':U
     1958       ,input 0
     1959       ,input 0
     1960       ,input 0
     1961       ,input ""
     1962       ,input ""
     1963       ,input ""
     1964       ,input (
     1965               ",,,Вкл/выкл лок. вес. кодов"
     1966              )
     1967       ,input true
     1968       ,buffer lock-batchprocess11
     1969       ) no-error .
     1970     if error-status :error then do:
     1971       message
     1972         vss-workfile vss-revision vss-description skip
     1973         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     1974         view-as alert-box error .
     1975       undo, return error .
     1976     end.
     1977       find first buf_code-range
     1978            where buf_code-range.range-type = p-range-type
     1979              and buf_code-range.first-code >= p-cur-code
     1980              and buf_code-range.last-code <= p-cur-code
     1981              and buf_code-range.db-num = v-db-num
     1982            no-error .
     1983       if not available buf_code-range then do:
     1984         message
     1985           vss-workfile vss-revision vss-description skip
     1986           "Ошибка при создании поиске диапазона" skip
     1987           "База данных" p-db-num skip
     1988           "Код" p-cur-code skip
     1989           "Тип" p-range-type
     1990           error-status :get-message(1) skip
     1991           return-value skip
     1992           view-as alert-box error .
     1993         undo, return error .
     1994       end.
     1995       if buf_code-range.stts = "f":U then do:
     1996         assign
     1997         buf_code-range.stts = "u":U
     1998         .
     1999       end.
     2000     end.
     2001   end procedure.
     2002   define   shared variable g#auto as logical no-undo.
