      123   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124   FUNCTION CIntBinS RETURNS CHARACTER(input vl_int as integer):
      125   def var vl_bin as char no-undo init "".
      126   if vl_int < 0 OR vl_int = ? then return ?.
      127   do while vl_int > 0:
      128     assign
      129     vl_bin = (if vl_int modulo 2 = 0
      130                 then "0":U
      131                 else "1":U) + vl_bin
      132     vl_int = truncate(vl_int / 2,0).
      133   end.
      134   return fill( "0":U, 32 - length(vl_bin)) + vl_bin .
      135   END FUNCTION.
      136   FUNCTION BinMask RETURNS LOGICAL(input vl_int as integer,
      137                                    input vl_binm as character):
      138   DEFINE VARIABLE vl_bin as character no-undo.
      139   DEFINE VARIABLE ii as integer no-undo.
      140   DEFINE VARIABLE ii-len as integer no-undo.
      141   DEFINE VARIABLE ii-lenm as integer no-undo.
      142   DEFINE VARIABLE mchar as character no-undo.
      143   DEFINE VARIABLE ichar as character no-undo.
      144   if vl_binm = ? then return ?.
      145   vl_bin = CIntBinS(vl_int).
      146   if vl_bin = ? then return ?.
      147   assign
      148   vl_binm = LEFT-TRIM(vl_binm, "X":U)
      149   ii-lenm = LENGTH(vl_binm)
      150   ii-len = LENGTH(vl_bin) - ii-lenm
      151   .
      152   if II-LENM > 32 THEN RETURN ?.
      153   DO II = 1 to II-LENm:
      154     assign
      155     mchar = SUBSTR(vl_binm, ii, 1)
      156     ichar = SUBSTR(vl_bin, ii + ii-len, 1)
      157     .
      158     IF not (MCHAR = "0":u or MCHAR = "1":u or MCHAR = "X":u) then return ?.
      159     IF ichar <> mchar AND mchar <> "X":U then return no.
      160   END.
      161   return yes.
      162   END FUNCTION.
      163   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      164     define variable v-cntxt-db-num        as integer   no-undo .
