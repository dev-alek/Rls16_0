     2264     if error-status:error then do:
     2265       add-option = '':U.
     2266       return no-apply.
     2267     end.
     2268     add-option = '':U.
     2269   END.
     2270   ON CHOOSE OF MENU-ITEM m_no-pos-2
     2271   DO:
     2272      add-option = '-':U.
     2273     run proc-b-add-2 in this-procedure ( input add-option ) no-error.
     2274     if error-status:error then do:
     2275       add-option = '':U.
     2276       return no-apply.
     2277     end.
     2278     add-option = '':U.
     2279   END.
     2280   ON CHOOSE OF MENU-ITEM m_pos-type
     2281   DO:
     2282      add-option = dflt-cd.
     2283     run proc-b-add in this-procedure ( input add-option ) no-error.
     2284     if error-status:error then do:
     2285       add-option = '':U.
     2286       return no-apply.
     2287     end.
     2288     add-option = '':U.
     2289   END.
     2290   ON CHOOSE OF MENU-ITEM m_pos-type-2
     2291   DO:
     2292      add-option = dflt-cd.
     2293     run proc-b-add-2 in this-procedure ( input add-option ) no-error.
     2294     if error-status:error then do:
     2295       add-option = '':U.
     2296       return no-apply.
     2297     end.
     2298     add-option = '':U.
     2299   END.
     2300   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2301   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2302   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2303   on help of frame Dialog-Frame
     2304   do:
     2305     run gbl/app_help.p
     2306       (input this-procedure :file-name
     2307       ,input ''
     2308       ,input ?
     2309       ) no-error.
     2310     if error-status :error then do:
     2311       message
     2312         "Ошибка при вызове помощи"
     2313         error-status :get-message(1)
     2314         view-as alert-box .
     2315     end.
     2316   end.
     2317   run minbtn-set in this-procedure .
     2318   on choose of b-help in frame Dialog-Frame
     2319   do:
     2320     apply "help":u to frame Dialog-Frame .
     2321   end.
     2322   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2323   procedure minbtn-set :
     2324       do
     2325           on error undo, return error return-value
     2326           :
     2327           define variable ii              as integer       no-undo .
     2328           define variable fh              as widget-handle no-undo .
     2329           define variable hh              as widget-handle no-undo .
     2330           define variable v-h             as handle        extent 4 no-undo .
     2331           define variable v-name-button   as character     no-undo .
     2332           define variable v-help-old-x    as decimal       no-undo .
     2333           define variable v-help-old-y    as decimal       no-undo .
     2334           define variable v-help-old-size as decimal       no-undo .
     2335           define variable v-frame-width   as decimal       no-undo .
     2336           define variable jj              as integer       no-undo .
     2337           do
     2338               on error undo, return error
     2339               :
     2340               assign
     2341                   v-frame-width = frame Dialog-Frame:width - 0.3
     2342                   fh            = frame Dialog-Frame:first-child
     2343                   hh            = fh:first-child
     2344                   ii            = 1
     2345                   .
     2346               do while valid-handle(hh):
     2347                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2348                   do:
     2349                       case lc(hh:name) :
     2350                           when "b-help" then
     2351                               do:
     2352                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2353                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2354                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2355                                   hh:TOOLTIP = "Помощь" .
     2356                                   v-help-old-x = hh:column .
     2357                                   v-help-old-y = hh:row    .
     2358                                   v-help-old-size = hh:width .
     2359                                   hh:width-chars = 2.5 .
     2360                               end.
     2361                           when "b-print" then
     2362                               do:
     2363                                   hh:load-image("cmp/b-print.bmp":u) .
     2364                                   hh:TOOLTIP = "Печать" .
     2365                                   v-h[ii] = hh:handle .
     2366                                   ii = ii + 1 .
     2367                                   hh:width-chars = 3 .
     2368                               end.
     2369                           when "b-history" or
     2370                           when "b-hist" then
     2371                               do:
     2372                                   hh:load-image("cmp/b-hist.bmp":u) .
     2373                                   hh:TOOLTIP = "История" .
     2374                                   v-h[ii] = hh:handle .
     2375                                   ii = ii + 1 .
     2376                                   hh:width-chars = 3 .
     2377                               end.
     2378                           when "b-sch" then
     2379                               do:
     2380                                   hh:load-image("cmp/b-sch.bmp":u) .
     2381                                   hh:TOOLTIP = "Установка Фильтра" .
     2382                                   v-h[ii] = hh:handle .
     2383                                   ii = ii + 1 .
     2384                                   hh:width-chars = 3 .
     2385                               end.
     2386                           when "b-hist-user" then
     2387                               do:
     2388                                   hh:load-image("cmp/b-hist.bmp":u) .
     2389                                   hh:TOOLTIP = "История пользователя" .
     2390                                   ii = ii + 1 .
     2391                               end.
     2392                       end case.
     2393                   end.
     2394                   hh = hh:next-sibling.
     2395               end.
     2396               b-help:column = v-frame-width - b-help:width-chars.
     2397               jj = 0.
     2398               repeat ii = 4 to 1 by -1 :
     2399                   if valid-handle (v-h[ii] ) then
     2400                   do:
     2401                       jj  = jj + 1 .
     2402                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2403                       v-h[ii]:row    = v-help-old-y .
     2404                   end.
     2405               end.
     2406           end.
     2407       end.
     2408   end procedure.
     2409   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2410   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2411   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2412   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2413   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2414   define variable v-diasize-current-frame-height as decimal   no-undo .
     2415   define variable v-diasize-change-size          as logical   no-undo .
     2416   define variable v-diasize-resize-button        as handle    no-undo .
     2417   define variable v-diasize-wndmax               as logical   no-undo .
     2418   define variable v-diasize-wndstore             as logical   no-undo .
     2419   define variable v-diasize-proc-name            as character no-undo .
     2420   define variable v-diasize-browse-handle        as handle    no-undo .
     2421   define variable v-diasize-browse-number        as integer   no-undo .
     2422   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2423   define temp-table temp-diasize-handle no-undo
     2424     field handle-value  as handle
     2425     field save-position as decimal
     2426     index xpk is primary unique handle-value
     2427     .
     2428   define temp-table temp-browse-handle no-undo
     2429     field browse-type   as character
     2430     field browse-number as integer
     2431     field browse-handle as handle
     2432     field original-size as decimal
     2433     index xpk is primary unique browse-type browse-number
     2434     index xie browse-type browse-handle
     2435   .
     2436   procedure diasize_change-height :
     2437     define input  parameter p-change-value  as decimal   no-undo .
     2438     define input  parameter p-move-resize   as logical   no-undo .
     2439     define variable v-field-group-handle    as handle    no-undo .
     2440     define variable v-object-handle         as handle    no-undo .
     2441     define variable v-frame-height          as decimal   no-undo .
     2442     define variable v-frame-virtual-height  as decimal   no-undo .
     2443     define variable v-browse-height         as decimal   no-undo .
     2444     define variable v-window-height         as decimal   no-undo .
     2445     define variable v-window-virtual-height as decimal   no-undo .
     2446     define variable v-change-sign           as integer   no-undo .
     2447     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2448     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2449     if p-change-value > 0
     2450     then do:
     2451       if frame Dialog-Frame :height + p-change-value
     2452           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2453       then do:
     2454         assign
     2455           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2456                           - (frame Dialog-Frame :height-chars)
     2457         .
     2458         if p-change-value <= 0
     2459         then do:
     2460           run diasize_position-resize-button in this-procedure .
     2461           return .
     2462         end.
     2463       end.
     2464     end.
     2465     if p-change-value < 0
     2466     then do:
     2467       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2468       then do:
     2469         assign
     2470           p-change-value = v-diasize-orig-frame-height
     2471                          - (frame Dialog-Frame :height-chars)
     2472         .
     2473         if p-change-value >= 0
     2474         then do:
     2475           run diasize_position-resize-button in this-procedure .
     2476           return .
     2477         end.
     2478       end.
     2479     end.
     2480     if p-change-value >= 0
     2481     then do:
     2482       assign
     2483         v-change-sign = 1
     2484       .
     2485     end.
     2486     else do:
     2487       assign
     2488         v-change-sign = -1
     2489       .
     2490     end.
     2491     assign
     2492       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2493     .
     2494     if p-change-value = 0
     2495     then do:
     2496       run diasize_position-resize-button in this-procedure .
     2497       return .
     2498     end.
     2499     move_block:
     2500     do
     2501     on error undo move_block, retry move_block
     2502     :
     2503       if retry
     2504       then do:
     2505         do
     2506         on error undo move_block, leave move_block
     2507         :
     2508           if p-change-value > 0
     2509           then do:
     2510             for each buf_temp-diasize-handle
     2511             on error undo, next
     2512             :
     2513               assign
     2514                 v-object-handle = buf_temp-diasize-handle.handle-value
     2515               .
     2516               if v-object-handle <> v-diasize-resize-button
     2517               then do:
     2518                 assign
     2519                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2520                 .
     2521               end.
     2522             end.
     2523             assign
     2524               v-diasize-browse-handle :height = v-browse-height
     2525             .
     2526             for each buf_temp-browse-handle
     2527               where buf_temp-browse-handle.browse-type = 'height':u
     2528             on error undo, next
     2529             :
     2530               assign
     2531                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2532               .
     2533             end.
     2534             assign
     2535               frame Dialog-Frame :height = v-frame-height
     2536             .
     2537             if frame Dialog-Frame :scrollable = true
     2538             then do:
     2539               assign
     2540                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2541               .
     2542             end.
     2543             run diasize_position-resize-button in this-procedure .
     2544           end.
     2545           else do:
     2546             if frame Dialog-Frame :scrollable = true
     2547             then do:
     2548               assign
     2549                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2550               .
     2551             end.
     2552             assign
     2553               frame Dialog-Frame :height = v-frame-height
     2554             .
     2555             assign
     2556               v-diasize-browse-handle :height = v-browse-height
     2557             .
     2558             for each buf_temp-browse-handle
     2559               where buf_temp-browse-handle.browse-type = 'height':u
     2560             on error undo, next
     2561             :
     2562               assign
     2563                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2564               .
     2565             end.
     2566             for each buf_temp-diasize-handle
     2567             on error undo, next
     2568             :
     2569               assign
     2570                 v-object-handle = buf_temp-diasize-handle.handle-value
     2571               .
     2572               if v-object-handle <> v-diasize-resize-button
     2573               then do:
     2574                 assign
     2575                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2576                 .
     2577               end.
     2578             end.
     2579             run diasize_position-resize-button in this-procedure .
     2580           end.
     2581           assign
     2582             v-diasize-change-size = false
     2583           .
     2584           leave move_block .
     2585         end.
     2586       end.
     2587       assign
     2588         v-diasize-need-full-display = true
     2589       .
     2590       if v-diasize-change-size = false
     2591       then do:
     2592         assign
     2593           v-diasize-change-size = true
     2594         .
     2595       end.
     2596       else do:
     2597         return .
     2598       end.
     2599       assign
     2600         v-frame-height = frame Dialog-Frame :height
     2601         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2602         v-browse-height = v-diasize-browse-handle :height
     2603       .
     2604       for each buf_temp-browse-handle
     2605         where buf_temp-browse-handle.browse-type = 'height':u
     2606       :
     2607         assign
     2608           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2609         .
     2610       end.
     2611       for each buf_temp-diasize-handle
     2612       :
     2613         delete buf_temp-diasize-handle .
     2614       end.
     2615       assign
     2616         v-field-group-handle = frame Dialog-Frame :first-child
     2617       .
     2618       do while valid-handle(v-field-group-handle)
     2619       :
     2620         assign
     2621           v-object-handle = v-field-group-handle :first-child
     2622         .
     2623         do while valid-handle(v-object-handle)
     2624         :
     2625           if  v-object-handle <> v-diasize-browse-handle :handle
     2626           and can-query(v-object-handle, "row")
     2627           and can-query(v-object-handle, "height")
     2628           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2629           then do:
     2630             find first buf_temp-browse-handle
     2631               where buf_temp-browse-handle.browse-type   = 'height':u
     2632                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2633               no-error .
     2634             if available buf_temp-browse-handle
     2635             then do:
     2636             end.
     2637             else do:
     2638               create buf_temp-diasize-handle .
     2639               assign
     2640                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2641                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2642               .
     2643             end.
     2644           end.
     2645           assign
     2646             v-object-handle = v-object-handle :next-sibling
     2647           .
     2648         end.
     2649         assign
     2650           v-field-group-handle = v-field-group-handle :next-sibling
     2651         .
     2652       end.
     2653       do with frame Dialog-Frame
     2654       :
     2655         hide v-diasize-resize-button .
     2656         assign
     2657           v-diasize-resize-button :row    = 1
     2658           v-diasize-resize-button :column = 1
     2659         .
     2660       end.
     2661       if p-change-value > 0
     2662       then do:
     2663         if frame Dialog-Frame :scrollable = true
     2664         then do:
     2665           assign
     2666             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2667             no-error .
     2668           if error-status :error
     2669           or error-status :get-message(1) <> ""
     2670           then do:
     2671             undo move_block, retry move_block .
     2672           end.
     2673         end.
     2674         assign
     2675           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2676           no-error .
     2677         if error-status :error
     2678         or error-status :get-message(1) <> ""
     2679         then do:
     2680           undo move_block, retry move_block .
     2681         end.
     2682         assign
     2683           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2684           no-error .
     2685         if error-status :error
     2686         or error-status :get-message(1) <> ""
     2687         then do:
     2688           undo move_block, retry move_block .
     2689         end.
     2690         for each buf_temp-browse-handle
     2691           where buf_temp-browse-handle.browse-type = 'height':u
     2692         on error undo move_block, retry move_block
     2693         :
     2694           assign
     2695             buf_temp-browse-handle.browse-handle :height
     2696               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2697             no-error .
     2698           if error-status :error
     2699           or error-status :get-message(1) <> ""
     2700           then do:
     2701             undo move_block, retry move_block .
     2702           end.
     2703         end.
     2704         for each buf_temp-diasize-handle
     2705         on error undo move_block, retry move_block
     2706         :
     2707           assign
     2708             v-object-handle = buf_temp-diasize-handle.handle-value
     2709           .
     2710           if v-object-handle <> v-diasize-resize-button
     2711           then do:
     2712             assign
     2713               v-object-handle :row = v-object-handle :row + p-change-value
     2714               no-error .
     2715             if error-status :error
     2716             or error-status :get-message(1) <> ""
     2717             then do:
     2718               undo move_block, retry move_block .
     2719             end.
     2720           end.
     2721         end.
     2722       end.
     2723       else do:
     2724         for each buf_temp-diasize-handle
     2725         on error undo move_block, retry move_block
     2726         :
     2727           assign
     2728             v-object-handle = buf_temp-diasize-handle.handle-value
     2729           .
     2730           if v-object-handle <> v-diasize-resize-button
     2731           then do:
     2732             assign
     2733               v-object-handle :row = v-object-handle :row + p-change-value
     2734               no-error .
     2735             if error-status :error
     2736             or error-status :get-message(1) <> ""
     2737             then do:
     2738               undo move_block, retry move_block .
     2739             end.
     2740           end.
     2741         end.
     2742         assign
     2743           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2744           no-error .
     2745         if error-status :error
     2746         or error-status :get-message(1) <> ""
     2747         then do:
     2748           undo move_block, retry move_block .
     2749         end.
     2750         for each buf_temp-browse-handle
     2751           where buf_temp-browse-handle.browse-type = 'height':u
     2752         on error undo move_block, retry move_block
     2753         :
     2754           assign
     2755             buf_temp-browse-handle.browse-handle :height
     2756               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2757             no-error .
     2758           if error-status :error
     2759           or error-status :get-message(1) <> ""
     2760           then do:
     2761             undo move_block, retry move_block .
     2762           end.
     2763         end.
     2764         assign
     2765           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2766           no-error .
     2767         if error-status :error
     2768         or error-status :get-message(1) <> ""
     2769         then do:
     2770           undo move_block, retry move_block .
     2771         end.
     2772         if frame Dialog-Frame :scrollable = true
     2773         then do:
     2774           assign
     2775             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2776             no-error .
     2777           if error-status :error
     2778           or error-status :get-message(1) <> ""
     2779           then do:
     2780             undo move_block, retry move_block .
     2781           end.
     2782         end.
     2783       end.
     2784       if p-move-resize = true
     2785       then do:
     2786         run diasize_position-resize-button in this-procedure .
     2787       end.
     2788       if v-diasize-wndstore = true
     2789       then do:
     2790         if connected("ub") = true
     2791         then do:
     2792           define variable v-cntxt-db-num        as integer   no-undo .
     2793           define variable v-cntxt-userid        as character no-undo .
     2794           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2795                                             , OUTPUT v-cntxt-userid
     2796                                             ) .
     2797           run gbl/wndsizew.p
     2798             (input  v-cntxt-db-num
     2799             ,input  v-cntxt-userid
     2800             ,input  v-diasize-proc-name
     2801             ,input  'height':u
     2802             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2803             ) .
     2804         end.
     2805       end.
     2806     end.
     2807     assign
     2808       v-diasize-change-size = false
     2809     .
     2810   end procedure.
     2811   procedure diasize_set-height :
     2812     define input  parameter p-new-height  as decimal   no-undo .
     2813     define input  parameter p-move-resize as logical   no-undo .
     2814     do
     2815     on error undo, return error return-value
     2816     :
     2817       run diasize_change-height in this-procedure
     2818         (input  (p-new-height - frame Dialog-Frame :height)
     2819         ,input  p-move-resize
     2820         ) .
     2821     end.
     2822   end procedure.
     2823   procedure diasize_change-width :
     2824     define input  parameter p-change-value as decimal   no-undo .
     2825     define input  parameter p-move-resize  as logical   no-undo .
     2826     define variable v-field-group-handle   as handle    no-undo .
     2827     define variable v-object-handle        as handle    no-undo .
     2828     define variable v-frame-width          as decimal   no-undo .
     2829     define variable v-frame-virtual-width  as decimal   no-undo .
     2830     define variable v-browse-width         as decimal   no-undo .
     2831     define variable v-window-width         as decimal   no-undo .
     2832     define variable v-window-virtual-width as decimal   no-undo .
     2833     define variable v-change-sign          as integer   no-undo .
     2834     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2835     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2836     if p-change-value > 0
     2837     then do:
     2838       if frame Dialog-Frame :width + p-change-value >
     2839           session :width-chars
     2840       then do:
     2841         assign
     2842           p-change-value = session :width-chars - frame Dialog-Frame :width
     2843         .
     2844         if p-change-value <= 0
     2845         then do:
     2846           run diasize_position-resize-button in this-procedure .
     2847           return .
     2848         end.
     2849       end.
     2850     end.
     2851     if p-change-value < 0
     2852     then do:
     2853       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2854       then do:
     2855         assign
     2856           p-change-value = v-diasize-orig-frame-width
     2857                          - frame Dialog-Frame :width
     2858         .
     2859         if p-change-value >= 0
     2860         then do:
     2861           run diasize_position-resize-button in this-procedure .
     2862           return .
     2863         end.
     2864       end.
     2865     end.
     2866     if p-change-value >= 0
     2867     then do:
     2868       assign
     2869         v-change-sign = 1
     2870       .
     2871     end.
     2872     else do:
     2873       assign
     2874         v-change-sign = -1
     2875       .
     2876     end.
     2877     assign
     2878       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2879     .
     2880     if p-change-value = 0
     2881     then do:
     2882       run diasize_position-resize-button in this-procedure .
     2883       return .
     2884     end.
     2885     move_block:
     2886     do
     2887     on error undo move_block, leave move_block
     2888     :
     2889       if retry
     2890       then do:
     2891         do
     2892         on error undo move_block, leave move_block
     2893         :
     2894           if p-change-value > 0
     2895           then do:
     2896             for each buf_temp-diasize-handle
     2897             on error undo, next
     2898             :
     2899               assign
     2900                 v-object-handle = buf_temp-diasize-handle.handle-value
     2901               .
     2902               if v-object-handle <> v-diasize-resize-button
     2903               then do:
     2904                 assign
     2905                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2906                 .
     2907               end.
     2908             end.
     2909             assign
     2910               v-diasize-browse-handle :width = v-browse-width
     2911             .
     2912             for each buf_temp-browse-handle
     2913               where buf_temp-browse-handle.browse-type = 'width':u
     2914             on error undo, next
     2915             :
     2916               assign
     2917                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2918               .
     2919             end.
     2920             assign
     2921               frame Dialog-Frame :width = v-frame-width
     2922             .
     2923             if frame Dialog-Frame :scrollable = true
     2924             then do:
     2925               assign
     2926                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2927               .
     2928             end.
     2929             run diasize_position-resize-button in this-procedure .
     2930           end.
     2931           else do:
     2932             if frame Dialog-Frame :scrollable = true
     2933             then do:
     2934               assign
     2935                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2936               .
     2937             end.
     2938             assign
     2939               frame Dialog-Frame :width = v-frame-width
     2940             .
     2941             for each buf_temp-browse-handle
     2942               where buf_temp-browse-handle.browse-type = 'width':u
     2943             on error undo, next
     2944             :
     2945               assign
     2946                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2947               .
     2948             end.
     2949             assign
     2950               v-diasize-browse-handle :width = v-browse-width
     2951             .
     2952             for each buf_temp-diasize-handle
     2953             on error undo, next
     2954             :
     2955               assign
     2956                 v-object-handle = buf_temp-diasize-handle.handle-value
     2957               .
     2958               if v-object-handle <> v-diasize-resize-button
     2959               then do:
     2960                 assign
     2961                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2962                 .
     2963               end.
     2964             end.
     2965             run diasize_position-resize-button in this-procedure .
     2966           end.
     2967           assign
     2968             v-diasize-change-size = false
     2969           .
     2970           leave move_block .
     2971         end.
     2972       end.
     2973       assign
     2974         v-diasize-need-full-display = true
     2975       .
     2976       if v-diasize-change-size = false
     2977       then do:
     2978         assign
     2979           v-diasize-change-size = true
     2980         .
     2981       end.
     2982       else do:
     2983         return .
     2984       end.
     2985       assign
     2986         v-frame-width = frame Dialog-Frame :width
     2987         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2988         v-browse-width = v-diasize-browse-handle :width
     2989       .
     2990       for each buf_temp-browse-handle
     2991         where buf_temp-browse-handle.browse-type = 'width':u
     2992       :
     2993         assign
     2994           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2995         .
     2996       end.
     2997       for each buf_temp-diasize-handle
     2998       :
     2999         delete buf_temp-diasize-handle .
     3000       end.
     3001       assign
     3002         v-field-group-handle = frame Dialog-Frame :first-child
     3003       .
     3004       do while valid-handle(v-field-group-handle)
     3005       :
     3006         assign
     3007           v-object-handle = v-field-group-handle :first-child
     3008         .
     3009         do while valid-handle(v-object-handle)
     3010         :
     3011           if  v-object-handle <> v-diasize-browse-handle :handle
     3012           and v-object-handle <> v-diasize-resize-button
     3013           and can-query(v-object-handle, "row")
     3014           and can-query(v-object-handle, "height")
     3015           and ( v-object-handle :col + v-object-handle :width
     3016                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3017               )
     3018           then do:
     3019             find first buf_temp-browse-handle
     3020               where buf_temp-browse-handle.browse-type   = 'width':u
     3021                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3022               no-error .
     3023             if available buf_temp-browse-handle
     3024             then do:
     3025             end.
     3026             else do:
     3027               create buf_temp-diasize-handle .
     3028               assign
     3029                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3030                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3031               .
     3032             end.
     3033           end.
     3034           assign
     3035             v-object-handle = v-object-handle :next-sibling
     3036           .
     3037         end.
     3038         assign
     3039           v-field-group-handle = v-field-group-handle :next-sibling
     3040         .
     3041       end.
     3042       do with frame Dialog-Frame
     3043       :
     3044         hide v-diasize-resize-button .
     3045         v-diasize-resize-button :row = 1.
     3046         v-diasize-resize-button :column = 1.
     3047       end.
     3048       if p-change-value > 0
     3049       then do:
     3050         if frame Dialog-Frame :scrollable = true
     3051         then do:
     3052           assign
     3053             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3054             no-error .
     3055           if error-status :error
     3056           or error-status :get-message(1) <> ""
     3057           then do:
     3058             undo move_block, retry move_block.
     3059           end.
     3060         end.
     3061         assign
     3062           frame Dialog-Frame :width = v-frame-width + p-change-value
     3063           no-error .
     3064         if error-status :error
     3065         or error-status :get-message(1) <> ""
     3066         then do:
     3067           undo move_block, retry move_block.
     3068         end.
     3069         assign
     3070           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3071         no-error .
     3072         if error-status :error
     3073         or error-status :get-message(1) <> ""
     3074         then do:
     3075           undo move_block, retry move_block.
     3076         end.
     3077         for each buf_temp-browse-handle
     3078           where buf_temp-browse-handle.browse-type = 'width':u
     3079         on error undo move_block, retry move_block
     3080         :
     3081           assign
     3082             buf_temp-browse-handle.browse-handle :width
     3083               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3084             no-error .
     3085           if error-status :error
     3086           or error-status :get-message(1) <> ""
     3087           then do:
     3088             undo move_block, retry move_block .
     3089           end.
     3090         end.
     3091         for each buf_temp-diasize-handle
     3092         on error undo move_block, retry move_block
     3093         :
     3094           assign
     3095             v-object-handle = buf_temp-diasize-handle.handle-value
     3096           .
     3097           if v-object-handle <> v-diasize-resize-button
     3098           then do:
     3099             assign
     3100               v-object-handle :col = v-object-handle :col + p-change-value
     3101               no-error .
     3102             if error-status :error
     3103             or error-status :get-message(1) <> ""
     3104             then do:
     3105               undo move_block, retry move_block .
     3106             end.
     3107           end.
     3108         end.
     3109       end.
     3110       else do:
     3111         for each buf_temp-diasize-handle
     3112         on error undo move_block, retry move_block
     3113         :
     3114           assign
     3115             v-object-handle = buf_temp-diasize-handle.handle-value
     3116           .
     3117           if v-object-handle <> v-diasize-resize-button
     3118           then do:
     3119             assign
     3120               v-object-handle :col = v-object-handle :col + p-change-value
     3121               no-error .
     3122             if error-status :error
     3123             or error-status :get-message(1) <> ""
     3124             then do:
     3125               undo move_block, retry move_block .
     3126             end.
     3127           end.
     3128         end.
     3129         for each buf_temp-browse-handle
     3130           where buf_temp-browse-handle.browse-type = 'width':u
     3131         on error undo move_block, retry move_block
     3132         :
     3133           assign
     3134             buf_temp-browse-handle.browse-handle :width
     3135               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3136             no-error .
     3137           if error-status :error
     3138           or error-status :get-message(1) <> ""
     3139           then do:
     3140             undo move_block, retry move_block .
     3141           end.
     3142         end.
     3143         assign
     3144           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3145           no-error .
     3146         if error-status :error
     3147         or error-status :get-message(1) <> ""
     3148         then do:
     3149           undo move_block, retry move_block.
     3150         end.
     3151         assign
     3152           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3153         no-error .
     3154         if error-status :error
     3155         or error-status :get-message(1) <> ""
     3156         then do:
     3157           undo move_block, retry move_block.
     3158         end.
     3159         if frame Dialog-Frame :scrollable = true
     3160         then do:
     3161           assign
     3162             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3163           no-error .
     3164           if error-status :error
     3165           or error-status :get-message(1) <> ""
     3166           then do:
     3167             undo move_block, retry move_block.
     3168           end.
     3169         end.
     3170       end.
     3171       if p-move-resize
     3172       then do:
     3173         run diasize_position-resize-button in this-procedure .
     3174       end.
     3175       if v-diasize-wndstore = true
     3176       then do:
     3177         if connected("ub") = true
     3178         then do:
     3179           define variable v-cntxt-db-num        as integer   no-undo .
     3180           define variable v-cntxt-userid        as character no-undo .
     3181           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3182                                             , OUTPUT v-cntxt-userid
     3183                                             ) .
     3184           run gbl/wndsizew.p
     3185             (input  v-cntxt-db-num
     3186             ,input  v-cntxt-userid
     3187             ,input  v-diasize-proc-name
     3188             ,input  'width':u
     3189             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3190             ) .
     3191         end.
     3192       end.
     3193     end.
     3194     assign
     3195       v-diasize-change-size = false
     3196     .
     3197   end procedure.
     3198   procedure diasize_set-width :
     3199     define input  parameter p-new-width  as decimal   no-undo .
     3200     define input  parameter p-move-resize as logical   no-undo .
     3201     do
     3202     on error undo, return error return-value
     3203     :
     3204       run diasize_change-width in this-procedure
     3205         (input  (p-new-width - frame Dialog-Frame :width)
     3206         ,input  p-move-resize
     3207         ) .
     3208     end.
     3209   end procedure.
     3210   procedure diasize_position-resize-button :
     3211     do with frame Dialog-Frame
     3212     :
     3213       hide v-diasize-resize-button .
     3214       assign
     3215         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3216                     - 1
     3217                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3218         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3219                     - 1
     3220                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3221       .
     3222       view v-diasize-resize-button .
     3223     end.
     3224   end procedure.
     3225   on alt-right anywhere
     3226   do:
     3227     run diasize_change-width in this-procedure
     3228       (input 1
     3229       ,input true
     3230       ) .
     3231     return no-apply .
     3232   end.
     3233   on alt-left anywhere
     3234   do:
     3235     run diasize_change-width in this-procedure
     3236       (input -1
     3237       ,input true
     3238       ) .
     3239     return no-apply .
     3240   end.
     3241   on alt-down anywhere
     3242   do:
     3243     run diasize_change-height in this-procedure
     3244       (input 1
     3245       ,input true
     3246       ) .
     3247     return no-apply .
     3248   end.
     3249   on alt-up anywhere
     3250   do:
     3251     run diasize_change-height in this-procedure
     3252       (input -1
     3253       ,input true
     3254       ) .
     3255     return no-apply .
     3256   end.
     3257   on alt-enter of frame Dialog-Frame
     3258   do:
     3259     run diasize_maximize in this-procedure
     3260       (input  ?
     3261       ).
     3262     return no-apply .
     3263   end.
     3264   procedure diasize_end-move :
     3265     do
     3266     on error undo, return error return-value
     3267     :
     3268       define variable v-row-delta as decimal   no-undo .
     3269       define variable v-col-delta as decimal   no-undo .
     3270       define variable v-new-row as decimal   no-undo .
     3271       define variable v-new-col as decimal   no-undo .
     3272       assign
     3273         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3274         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3275       .
     3276       assign
     3277         v-row-delta = v-new-row - frame Dialog-Frame :height
     3278         v-col-delta = v-new-col - frame Dialog-Frame :width
     3279       .
     3280       run diasize_change-height in this-procedure
     3281         (input v-row-delta
     3282         ,input true
     3283         ) .
     3284       run diasize_change-width in this-procedure
     3285         (input v-col-delta
     3286         ,input true
     3287         ) .
     3288     end.
     3289   end procedure.
     3290   procedure diasize_maximize :
     3291     define input  parameter p-action as logical   no-undo .
     3292     do
     3293     on error undo, return error return-value
     3294     :
     3295       if p-action = ?
     3296       then do:
     3297         if v-diasize-need-maximize = true
     3298         then do:
     3299           assign
     3300             p-action = true
     3301           .
     3302         end.
     3303         else do:
     3304           assign
     3305             p-action = false
     3306           .
     3307         end.
     3308       end.
     3309       if p-action = true
     3310       then do:
     3311         run diasize_change-height in this-procedure
     3312           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3313               - frame Dialog-Frame :height-chars
     3314           ,input true
     3315           ) .
     3316         run diasize_change-width in this-procedure
     3317           (input session :width-chars
     3318               - frame Dialog-Frame :width-chars
     3319           ,input true
     3320           ) .
     3321         assign
     3322           v-diasize-need-maximize = false
     3323         .
     3324       end.
     3325       else do:
     3326         run diasize_change-width in this-procedure
     3327           (input v-diasize-orig-frame-width
     3328               - frame Dialog-Frame :width-chars
     3329           ,input true
     3330           ) .
     3331         run diasize_change-height in this-procedure
     3332           (input v-diasize-orig-frame-height
     3333               - frame Dialog-Frame :height-chars
     3334           ,input true
     3335           ) .
     3336         assign
     3337           v-diasize-need-maximize = true
     3338         .
     3339       end.
     3340     end.
     3341   end procedure.
     3342   procedure diasize_restore-orig-size :
     3343     do
     3344     on error undo, return error return-value
     3345     :
     3346       assign
     3347         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3348         v-diasize-current-frame-height = frame Dialog-Frame :height
     3349       .
     3350       run diasize_set-height in this-procedure
     3351         (input  v-diasize-orig-frame-height
     3352         ,input  true
     3353         ) .
     3354       run diasize_set-width in this-procedure
     3355         (input  v-diasize-orig-frame-width
     3356         ,input  true
     3357         ) .
     3358     end.
     3359   end procedure.
     3360   procedure diasize_restore-current-size :
     3361     do
     3362     on error undo, return error return-value
     3363     :
     3364       run diasize_set-height in this-procedure
     3365         (input  v-diasize-current-frame-height
     3366         ,input  true
     3367         ) .
     3368       run diasize_set-width in this-procedure
     3369         (input  v-diasize-current-frame-width
     3370         ,input  true
     3371         ) .
     3372     end.
     3373   end procedure.
     3374   procedure diasize_set-browse-handle :
     3375     define input  parameter p-browse-handle as handle   no-undo .
     3376     define buffer buf_temp-browse-handle for temp-browse-handle .
     3377     do
     3378     on error undo, return error return-value
     3379     :
     3380       assign
     3381         v-diasize-browse-handle = p-browse-handle
     3382       .
     3383       for each buf_temp-browse-handle
     3384       on error undo, return error return-value
     3385       :
     3386         delete buf_temp-browse-handle .
     3387       end.
     3388     end.
     3389   end procedure.
     3390   procedure diasize_add_browse :
     3391     define input  parameter p-browse-type   as character no-undo .
     3392     define input  parameter p-browse-handle as handle    no-undo .
     3393     define buffer buf_temp-browse-handle for temp-browse-handle .
     3394     do
     3395     on error undo, return error return-value
     3396     :
     3397       assign
     3398         v-diasize-browse-number = v-diasize-browse-number + 1
     3399       .
     3400       create buf_temp-browse-handle .
     3401       assign
     3402         buf_temp-browse-handle.browse-type   = p-browse-type
     3403         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3404         buf_temp-browse-handle.browse-handle = p-browse-handle
     3405       .
     3406     end.
     3407   end procedure.
     3408   procedure diasize_init :
     3409     define variable v-default-value    as logical   no-undo .
     3410     define variable v-restore-saved    as logical   no-undo .
     3411     define variable v-resize-value-str as character no-undo .
     3412     do
     3413     on error undo, return error return-value
     3414     :
     3415       do with frame Dialog-Frame
     3416       :
     3417         assign
     3418           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3419           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3420           v-diasize-browse-handle     = browse BR-add :handle
     3421         .
     3422         create button v-diasize-resize-button
     3423         assign
     3424           parent        = frame Dialog-Frame :first-child
     3425           label         = "s"
     3426           height-pixels = 16
     3427           width-pixels  = 16
     3428           visible       = true
     3429           sensitive     = true
     3430           movable       = true
     3431           triggers:
     3432             on end-move persistent run diasize_end-move in this-procedure .
     3433           end triggers.
     3434         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3435         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3436         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3437         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3438         assign
     3439           v-diasize-wndmax = false
     3440         .
     3441         if connected("ub") = true
     3442         then do:
     3443           define variable v-cntxt-db-num        as integer   no-undo .
     3444           define variable v-cntxt-userid        as character no-undo .
     3445           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3446                                             , OUTPUT v-cntxt-userid
     3447                                             ) .
     3448           run gbl/wndpar_r.p
     3449             (input  v-cntxt-db-num
     3450             ,input  v-cntxt-userid
     3451             ,input  'wndmax':U
     3452             ,output v-diasize-wndmax
     3453             ,output v-default-value
     3454             ) .
     3455         end.
     3456         assign
     3457           v-diasize-wndstore = false
     3458         .
     3459         if connected("ub") = true
     3460         then do:
     3461           run gbl/wndpar_r.p
     3462             (input  v-cntxt-db-num
     3463             ,input  v-cntxt-userid
     3464             ,input  'wndstore':U
     3465             ,output v-diasize-wndstore
     3466             ,output v-default-value
     3467             ) .
     3468         end.
     3469         assign
     3470           v-diasize-proc-name = entry(1, program-name(2), '.')
     3471         .
     3472         if v-diasize-wndstore = true
     3473         then do:
     3474           assign
     3475             v-restore-saved = false
     3476           .
     3477           if connected("ub") = true
     3478           then do:
     3479             run gbl/wndsizer.p
     3480               (input  v-cntxt-db-num
     3481               ,input  v-cntxt-userid
     3482               ,input  v-diasize-proc-name
     3483               ,input  'height':u
     3484               ,output v-resize-value-str
     3485               ) .
     3486             if v-resize-value-str <> '':U
     3487             then do:
     3488               run diasize_change-height in this-procedure
     3489                 (input  integer(v-resize-value-str)
     3490                 ,input  true
     3491                 ) .
     3492               assign
     3493                 v-restore-saved = true
     3494               .
     3495             end.
     3496           end.
     3497           if connected("ub") = true
     3498           then do:
     3499             run gbl/wndsizer.p
     3500               (input  v-cntxt-db-num
     3501               ,input  v-cntxt-userid
     3502               ,input  v-diasize-proc-name
     3503               ,input  'width':u
     3504               ,output v-resize-value-str
     3505               ) .
     3506             if v-resize-value-str <> '':U
     3507             then do:
     3508               run diasize_change-width in this-procedure
     3509                 (input  integer(v-resize-value-str)
     3510                 ,input  true
     3511                 ) .
     3512               assign
     3513                 v-restore-saved = true
     3514               .
     3515             end.
     3516           end.
     3517           if v-restore-saved <> true
     3518           then do:
     3519             if v-diasize-wndmax = true
     3520             then do:
     3521               run diasize_maximize in this-procedure
     3522                 (input  true
     3523                 ) .
     3524             end.
     3525           end.
     3526         end.
     3527         else do:
     3528           if v-diasize-wndmax = true
     3529           then do:
     3530             run diasize_maximize in this-procedure
     3531               (input  true
     3532               ) .
     3533           end.
     3534         end.
     3535       end.
     3536     end.
     3537   end procedure.
     3538   procedure diasize_need-full-display :
     3539     define output parameter p-need-full-display as logical   no-undo .
     3540     do
     3541     on error undo, return error return-value
     3542     :
     3543       assign
     3544         p-need-full-display = v-diasize-need-full-display
     3545       .
     3546       assign
     3547         v-diasize-need-full-display = false
     3548       .
     3549     end.
     3550   end procedure.
     3551   procedure get-context :
     3552      define output parameter p-db-num as integer          no-undo.
     3553      define output parameter p-user-id as character        no-undo.
     3554      define variable v-login               as character    no-undo.
     3555      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3556      define buffer buf_user-login  for ub.user-login .
     3557      do
     3558      on error undo, return error
     3559      :
     3560            FIND FIRST buf_sys-ctrl no-lock.
     3561            ASSIGN
     3562               v-login = USERID("ub")
     3563               p-db-num = buf_sys-ctrl.db-num
     3564            .
     3565            FIND FIRST buf_user-login
     3566                 WHERE buf_user-login.db-num = p-db-num
     3567                   AND buf_user-login.user-login = v-login
     3568                 no-lock
     3569                 no-error
     3570                 .
     3571            IF AVAILABLE buf_user-login
     3572            THEN DO:
     3573               assign
     3574                  p-user-id = buf_user-login.user-id
     3575               .
     3576            END.
     3577      end.
     3578   end procedure.
     3579       run diasize_init in this-procedure .
     3580   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3581   ON RETURN ANYWHERE
     3582   DO:
     3583   define variable ii as integer no-undo .
     3584   define variable fh as widget-handle no-undo .
     3585   define variable hh as widget-handle no-undo .
     3586   define variable v-next-widget-name as character no-undo .
     3587     if v-tab-order <> '' then do:
     3588       assign
     3589       ii = lookup(self:name, v-tab-order).
     3590       if ii = num-entries(v-tab-order) then do:
     3591           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     3592           return no-apply.
     3593       end.
     3594       if self:type <> "BUTTON" and
     3595         self:type <> "EDITOR"  then do:
     3596         run proc-move-forward in this-procedure .
     3597         return no-apply.
     3598       end.
     3599       if self:type = "BUTTON" then do:
     3600         APPLY "CHOOSE" to self.
     3601       end.
     3602       if self:type = "TOGGLE-BOX" then
     3603       self:BGCOLOR = ?.
     3604       assign
     3605       ii = ii + 1
     3606       v-next-widget-name = entry(ii, v-tab-order)
     3607       no-error .
     3608       if error-status:error then do:
     3609         assign
     3610         ii = 1
     3611         v-next-widget-name = entry( ii, v-tab-order)
     3612         .
     3613       end.
     3614       assign
     3615       fh = frame Dialog-Frame:first-child
     3616       hh = fh:first-child
     3617       .
     3618       do while valid-handle(hh):
     3619         if hh:name = v-next-widget-name then do:
     3620           if hh:sensitive  = yes
     3621           AND hh:visible = yes then do:
     3622             if hh:type = "TOGGLE-BOX":U then do:
     3623               assign
     3624               hh:BGcolor = 1
     3625               .
     3626             end.
     3627             APPLY "ENTRY" to hh.
     3628             return no-apply.
     3629           end.
     3630           else do:
     3631             APPLY "TAB" to hh.
     3632             return no-apply.
     3633           end.
     3634         end.
     3635         hh = hh:next-sibling.
     3636       end.
     3637     end.
     3638   END.
     3639   procedure proc-move-forward :
     3640   define variable ii as integer no-undo .
     3641   define variable fh as widget-handle no-undo .
     3642   define variable hh as widget-handle no-undo .
     3643   define variable v-next-widget-name as character no-undo .
     3644   do
     3645   on error undo, return error
     3646   :
     3647     if v-tab-order <> '' then do:
     3648       if self:type = "TOGGLE-BOX" then
     3649       self:BGCOLOR = ?.
     3650       assign
     3651       ii = lookup(self:name, v-tab-order).
     3652       assign
     3653       ii = ii + 1
     3654       v-next-widget-name = entry(ii, v-tab-order)
     3655       no-error .
     3656       if error-status:error then do:
     3657         assign
     3658         ii = 1
     3659         v-next-widget-name = entry( ii, v-tab-order)
     3660         .
     3661       end.
     3662       assign
     3663       fh = frame Dialog-Frame:first-child
     3664       hh = fh:first-child
     3665       .
     3666       do while valid-handle(hh):
     3667         if hh:name = v-next-widget-name then do:
     3668           if hh:sensitive  = yes
     3669           AND hh:visible = yes then do:
     3670             if hh:type = "TOGGLE-BOX":U then do:
     3671               assign
     3672               hh:BGcolor = 1
     3673               .
     3674             end.
     3675             APPLY "ENTRY" to hh.
     3676             return.
     3677           end.
     3678           else do:
     3679             assign
     3680             ii = ii + 1
     3681             v-next-widget-name = entry(ii, v-tab-order)
     3682             no-error .
     3683             if error-status:error then do:
     3684               assign
     3685               ii = 1
     3686               v-next-widget-name = entry( ii, v-tab-order)
     3687               .
     3688             end.
     3689           end.
     3690         end.
     3691         hh = hh:next-sibling.
     3692       end.
     3693     end.
     3694   end.
     3695   end procedure.
     3696   MAIN-BLOCK:
     3697   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3698      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3699   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3700     run mainmenu_getcntxt in parparentproc
     3701       (output v-cntxt-db-num
     3702       ,output v-cntxt-userid
     3703       ,output v-cntxt-level
     3704       ,output v-cntxt-host-code-obj
     3705       ,output v-cntxt-obj-type
     3706       ,output v-cntxt-obj-code
     3707       ,output v-cntxt-db-num-obj
     3708       ,output v-cntxt-is-admin
     3709       ) .
     3710     if lookup(par-subject, 'dis-cp-rule':U) = 0 then do:
     3711       message
     3712       vss-workfile vss-revision vss-description skip
     3713       "Неверное значение параметра par-subject" par-subject
     3714       view-as alert-box error.
     3715       return error.
     3716     end.
     3717     CASE par-subject:
     3718       when 'dis-cp-rule':U
     3719       then do:
     3720         if v-cntxt-db-num = 0 then do:
     3721   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3722   do:
     3723     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3724       (input  v-cntxt-db-num
     3725       ,input  v-cntxt-userid
     3726       ,input  0
     3727       ,input  'actn_cp-discount_global_work':U
     3728       ,input  'global':U
     3729       ,input  0
     3730       ,input  '':U
     3731       ,input  0
     3732       ,input  0
     3733       ,input  0
     3734       ,input  0
     3735       ,input  false
     3736       ,output loc-glob
     3737       )  .
     3738   end.
     3739   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3740   do:
     3741     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3742       (input  v-cntxt-db-num
     3743       ,input  v-cntxt-userid
     3744       ,input  0
     3745       ,input  'actn_cp-discount_firm_work':U
     3746       ,input  'firm':U
     3747       ,input  v-cntxt-host-code-obj
     3748       ,input  '':U
     3749       ,input  0
     3750       ,input  0
     3751       ,input  0
     3752       ,input  0
     3753       ,input  false
     3754       ,output loc-firm
     3755       )  .
     3756   end.
     3757         end.
     3758   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3759   do:
     3760     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3761       (input  v-cntxt-db-num
     3762       ,input  v-cntxt-userid
     3763       ,input  0
     3764       ,input  'actn_cp-discount_object_work':U
     3765       ,input  'object':U
     3766       ,input  v-cntxt-host-code-obj
     3767       ,input  v-cntxt-obj-type
     3768       ,input  v-cntxt-obj-code
     3769       ,input  0
     3770       ,input  0
     3771       ,input  0
     3772       ,input  false
     3773       ,output loc-object
     3774       )  .
     3775   end.
     3776         if ((if v-cntxt-db-num = 0 and loc-glob then 1 else 0) +
     3777         (if v-cntxt-db-num = 0 and loc-firm then 1 else 0) +
     3778         (if loc-object then 1 else 0)) = 0 then do:
     3779           message
     3780           "У Вас отсутствуют права на назначение скидки на тип платежа как по объекту, так и по фирме и глобально" skip
     3781           "либо Вы находитесь в БД, в которой их назначить невозможно"
     3782           view-as alert-box error .
     3783           undo, return.
     3784         end.
     3785       end.
     3786     END CASE.
     3787     find first X_clients-obj no-lock where
     3788                 X_clients-obj.obj-type = parobj-type AND
     3789                 X_clients-obj.obj-code = parobj-code no-error .
     3790     if not avail X_clients-obj then do:
     3791       message vss-workfile vss-revision vss-description skip
     3792       "Неверное значение параметра parobj-type и/или parobj-code" parobj-type parobj-code
     3793       view-as alert-box error.
     3794       return error.
     3795     end.
     3796     RUN enable_UI in this-procedure .
     3797     RUN MYenable in this-procedure .
     3798     WAIT-FOR GO OF FRAME Dialog-Frame.
     3799   END.
     3800   RUN disable_UI in this-procedure .
     3801   PROCEDURE choose-to-add :
     3802   define input parameter p-attr-code as character no-undo .
     3803   assign
     3804   add-option = p-attr-code
     3805   .
     3806    APPLY "CHOOSE" to b-add in frame Dialog-Frame .
     3807   END PROCEDURE.
     3808   PROCEDURE choose-to-delete :
     3809   define input parameter p-attr-code as character no-undo .
     3810   assign
     3811   add-option = p-attr-code
     3812   .
     3813   APPLY "CHOOSE" to b-add-2 in frame Dialog-Frame .
     3814   END PROCEDURE.
     3815   PROCEDURE disable_UI :
     3816     HIDE FRAME Dialog-Frame.
     3817   END PROCEDURE.
     3818   PROCEDURE enable_UI :
     3819     ENABLE B-exit b-quit B-obj B-list B-Help b-add B-chg B-del BR-add b-add-2
     3820            B-chg-2 B-del-2 BR-del
     3821         WITH FRAME Dialog-Frame.
     3822     VIEW FRAME Dialog-Frame.
     3823     OPEN QUERY BR-add FOR EACH temp-disc where temp-disc.action = yes NO-LOCK.    OPEN QUERY BR-del FOR EACH del_temp-disc where del_temp-disc.action = no NO-LOCK.
     3824   END PROCEDURE.
     3825   PROCEDURE init-proc :
     3826   assign
     3827   add-option = ""
     3828   add-obj-type = "":U
     3829   add-obj-code = 0
     3830   .
     3831   OPEN QUERY BR-add FOR EACH temp-disc where temp-disc.action = yes NO-LOCK.    OPEN QUERY BR-del FOR EACH del_temp-disc where del_temp-disc.action = no NO-LOCK.
     3832   END PROCEDURE.
     3833   PROCEDURE MyEnable :
     3834   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     3835   DEFINE VARIABLE ch AS WIDGET-HANDLE NO-UNDO.
     3836   ch = br-add:FIRST-COLUMN IN FRAME Dialog-Frame.
     3837   DO ii = 1 TO br-add:NUM-COLUMNS IN FRAME Dialog-Frame:
     3838       ASSIGN
     3839       ch:RESIZABLE = YES.
     3840       ch = ch:NEXT-COLUMN.
     3841   END.
     3842   assign
     3843   b-add:MENU-MOUSE in frame Dialog-Frame = 1
     3844   b-add-2:MENU-MOUSE in frame Dialog-Frame = 1
     3845   .
     3846   RUN proc-title IN THIS-PROCEDURE.
     3847   END PROCEDURE.
     3848   PROCEDURE proc-b-add :
     3849   define input parameter p-pos-type as character no-undo.
     3850   define variable v-deleted       as logical   no-undo .
     3851   define variable v-rid           as character no-undo .
     3852   define variable v-rec           as recid     no-undo .
     3853   define variable v-cfg-nonunique as character no-undo .
     3854   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     3855   define buffer buf_temp-disc    for temp-disc.
     3856   do
     3857   on error undo, return error :
     3858     run ref/dis-pos.w ( input parparentproc
     3859                        ,input "b-sel":U
     3860                        ,input "cd-type-list"
     3861                        ,input (if v-cntxt-db-num = 0 and loc-glob then 1 else 0)
     3862                        ,input (if v-cntxt-db-num = 0 and loc-firm then 1 else 0)
     3863                        ,input 1
     3864                        ,input 'dis-cp-rule':U
     3865                        ,input '':U
     3866                        ,input ?
     3867                        ,input p-pos-type
     3868                        ,input '':U
     3869                        ,input-output v-rid ) no-error.
     3870     IF ERROR-STATUS:ERROR
     3871     OR v-rid = '':U THEN DO:
     3872       RETURN.
     3873     END.
     3874     find first buf_dis-cfg-rule where recid(buf_dis-cfg-rule) = int(v-rid) no-lock no-error.
     3875     if not avail buf_dis-cfg-rule then do:
     3876         RETURN.
     3877     end.
     3878     v-cfg-nonunique = substitute("@&1", buf_dis-cfg-rule.nonunique).
     3879     run temp-dsc-write in this-procedure (
     3880                                            input yes
     3881                                           ,input buf_dis-cfg-rule.pos-type
     3882                                           ,input buf_dis-cfg-rule.templ-rl-root
     3883                                           ,input buf_dis-cfg-rule.time-templ-rl-root
     3884                                           ,input buf_dis-cfg-rule.discnt-role
     3885                                           ,input v-cfg-nonunique
     3886                                           ,input p-host-code
     3887                                           ,input parobj-type
     3888                                           ,input parobj-code
     3889                                           ,input 0
     3890                                           ,input yes
     3891                                           ,input-output v-rec
     3892                                     ) no-error .
     3893     IF ERROR-STATUS:ERROR THEN DO:
     3894       if not return-value = "not-set" then do:
     3895         message "Ошибка при определении названия и типа скидки на платеж!"         skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     3896       end.
     3897       undo,  return error.
     3898     END.
     3899     updated = yes.
     3900     find first buf_temp-disc no-lock where
     3901               recid(buf_temp-disc) = v-rec no-error.
     3902     if avail buf_temp-disc then
     3903     temp-doc-rec = recid(buf_temp-disc).
     3904     else temp-doc-rec = ?.
     3905     Run init-proc in this-procedure no-error.
     3906     if error-status:error then do:
     3907       undo, return error.
     3908     end.
     3909     REPOSITION br-add to recid temp-doc-rec no-error.
     3910     run proc-b-chg in this-procedure ( input "":U) no-error.
     3911     if error-status:error then do:
     3912         run temp-dsc-delete in this-procedure (
     3913                                                  input buf_dis-cfg-rule.pos-type
     3914                                                 ,input buf_dis-cfg-rule.discnt-role
     3915                                                 ,input v-cfg-nonunique
     3916                                                 ,input p-host-code
     3917                                                 ,input parobj-type
     3918                                                 ,input parobj-code
     3919                                                 ,input yes
     3920                                                 ,output v-deleted
     3921                                                 ) no-error .
     3922       Run init-proc in this-procedure no-error.
     3923       undo, return error.
     3924     end.
     3925     APPLY "ENTRY" to br-add in frame Dialog-Frame.
     3926   end.
     3927   END PROCEDURE.
     3928   PROCEDURE proc-b-add-2 :
     3929   define input parameter p-pos-type as character no-undo.
     3930   DEFINE VARIABLE v-deleted as logical no-undo .
     3931   define variable loc#log as logical no-undo.
     3932   define variable loc-action as logical no-undo.
     3933   define variable v-rid as character no-undo .
     3934   define variable v-rule-num as integer no-undo .
     3935   define variable v-cfg-nonunique as character no-undo .
     3936   define variable v-nonunique as character no-undo .
     3937   define variable v-rec as recid no-undo .
     3938   define buffer buf_temp-disc for temp-disc.
     3939   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     3940   define buffer buf_dis-cp-rule for ub.dis-cp-rule.
     3941   CASE par-subject :
     3942     WHEN 'dis-cp-rule':U THEN DO:
     3943       run ref/dis-pos.w ( INPUT parparentproc
     3944                           ,INPUT "b-sel":U
     3945                           ,INPUT "cd-type-list"
     3946                           ,INPUT (if v-cntxt-db-num = 0 then 1 else 0)
     3947                           ,INPUT (if v-cntxt-db-num = 0 then 1 else 0)
     3948                           ,INPUT 1
     3949                           ,input 'dis-cp-rule':U
     3950                           ,input '':U
     3951                           ,input ?
     3952                           ,INPUT p-pos-type
     3953                           ,input '':U
     3954                           ,INPUT-OUTPUT v-rid) NO-ERROR.
     3955       IF ERROR-STATUS:ERROR
     3956       OR v-rid = '':U THEN DO:
     3957         RETURN.
     3958       END.
     3959       find first buf_dis-cfg-rule where recid(buf_dis-cfg-rule) = int(v-rid) no-lock no-error.
     3960       if not avail buf_dis-cfg-rule then do:
     3961           RETURN.
     3962       end.
     3963       v-cfg-nonunique = substitute("@&1", buf_dis-cfg-rule.nonunique).
     3964       run temp-dsc-write in this-procedure (
     3965                                               input yes
     3966                                              ,input buf_dis-cfg-rule.pos-type
     3967                                              ,input buf_dis-cfg-rule.templ-rl-root
     3968                                              ,input buf_dis-cfg-rule.time-templ-rl-root
     3969                                              ,input buf_dis-cfg-rule.discnt-role
     3970                                              ,input v-cfg-nonunique
     3971                                              ,input p-host-code
     3972                                              ,input parobj-type
     3973                                              ,input parobj-code
     3974                                              ,input v-rule-num
     3975                                              ,input no
     3976                                              ,input-output v-rec )  no-error .
     3977        IF ERROR-STATUS:ERROR THEN DO:
     3978         if not return-value = "not-set" then do:
     3979           message "Ошибка при определении названия и типа скидки на платеж!"         skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     3980           return error .
     3981         end .
     3982       END .
     3983       define buffer bb_temp-disc for temp-disc .
     3984       find first bb_temp-disc no-error .
     3985     END .
     3986   END CASE .
     3987   updated = yes .
     3988   find first buf_temp-disc no-lock where
     3989             recid(buf_temp-disc) = v-rec no-error .
     3990   if avail buf_temp-disc then
     3991     temp-doc-rec = recid(buf_temp-disc) .
     3992     else temp-doc-rec = ? .
     3993   Run init-proc in this-procedure .
     3994   reposition BR-del to recid temp-doc-rec no-error .
     3995   if error-status:error then return error .
     3996   run proc-b-chg-2 in this-procedure ( input "":U) no-error .
     3997   if error-status:error then do:
     3998       run temp-dsc-delete in this-procedure (
     3999                                                input buf_dis-cfg-rule.pos-type
     4000                                               ,input buf_dis-cfg-rule.discnt-role
     4001                                               ,input v-cfg-nonunique
     4002                                               ,input p-host-code
     4003                                               ,input parobj-type
     4004                                               ,input parobj-code
     4005                                               ,input no
     4006                                               ,output v-deleted
     4007                                               ) no-error .
     4008     Run init-proc in this-procedure no-error .
     4009     undo, return error .
     4010   end .
     4011   APPLY "ENTRY" to br-del in frame Dialog-Frame .
     4012   END PROCEDURE .
     4013   PROCEDURE proc-b-chg :
     4014   define input parameter p-mode as character no-undo .
     4015   define variable v-rule-num as integer no-undo .
     4016   define variable v-nonunique as character no-undo .
     4017   define variable v-rec as recid no-undo .
     4018   if not avail temp-disc then return error .
     4019     RUN temp-dsc-VALUE IN THIS-PROCEDURE (
     4020                                          input temp-disc.pos-type
     4021                                         ,input temp-disc.templ-rl-root
     4022                                         ,input temp-disc.time-templ-rl-root
     4023                                         ,input temp-disc.discnt-role
     4024                                         ,input temp-disc.nonunique
     4025                                         ,input temp-disc.host-code
     4026                                         ,input temp-disc.obj-type
     4027                                         ,input temp-disc.obj-code
     4028                                         ,input 'ДОБАВЛЕНИЕ':U
     4029                                         ,input p-mode
     4030                                         ,input recid(temp-disc)
     4031                                         ,OUTPUT v-rule-num
     4032                                         ,output v-nonunique
     4033                                         ) NO-ERROR .
     4034     IF ERROR-STATUS:ERROR THEN DO:
     4035       if return-value <> "not-set":U then do:
     4036         message "Ошибка при определении значения скидки на платеж!"         skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     4037         RETURN error .
     4038       end .
     4039     END .
     4040     if return-value = "not-set":U
     4041     and p-mode <> "change":U then do:
     4042       delete temp-disc.
     4043       glog = br-add:refresh() in frame Dialog-Frame no-error .
     4044       return .
     4045     end .
     4046     v-rec = recid(temp-disc) .
     4047     run temp-dsc-write (
     4048                          input no
     4049                         ,input temp-disc.pos-type
     4050                         ,input temp-disc.templ-rl-root
     4051                         ,input temp-disc.time-templ-rl-root
     4052                         ,input temp-disc.discnt-role
     4053                         ,input temp-disc.nonunique
     4054                         ,input temp-disc.host-code
     4055                         ,input temp-disc.obj-type
     4056                         ,input temp-disc.obj-code
     4057                         ,input v-rule-num
     4058                         ,input temp-disc.action
     4059                         ,input-output v-rec
     4060                         ) no-error .
     4061     IF not error-status:error then do:
     4062       assign
     4063       updated = yes
     4064       .
     4065     END .
     4066     glog = br-add:refresh() in frame Dialog-Frame no-error .
     4067     APPLY "ENTRY" to br-add.
     4068   END PROCEDURE .
     4069   PROCEDURE proc-b-chg-2 :
     4070   define input parameter p-mode as character no-undo .
     4071   define variable v-rule-num as integer no-undo .
     4072   define variable v-nonunique as character no-undo .
     4073   define variable v-rec as recid no-undo .
     4074   if not avail del_temp-disc then return error .
     4075     RUN temp-dsc-VALUE IN THIS-PROCEDURE (
     4076                                          input del_temp-disc.pos-type
     4077                                         ,input del_temp-disc.templ-rl-root
     4078                                         ,input del_temp-disc.time-templ-rl-root
     4079                                         ,input del_temp-disc.discnt-role
     4080                                         ,input del_temp-disc.nonunique
     4081                                         ,input del_temp-disc.host-code
     4082                                         ,input del_temp-disc.obj-type
     4083                                         ,input del_temp-disc.obj-code
     4084                                         ,input 'удаление':U
     4085                                         ,input p-mode
     4086                                         ,input recid(del_temp-disc)
     4087                                         ,OUTPUT v-rule-num
     4088                                         ,output v-nonunique
     4089                                         ) NO-ERROR .
     4090     IF ERROR-STATUS:ERROR THEN DO:
     4091       if return-value <> "not-set":U then do:
     4092         message "Ошибка при определении значения скидки на платеж!"         skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     4093         RETURN error .
     4094       end .
     4095     END .
     4096     if return-value = "not-set":U
     4097     and p-mode <> "change":U then do:
     4098       delete del_temp-disc .
     4099       glog = br-del:refresh() in frame Dialog-Frame no-error .
     4100       return .
     4101     end .
     4102     v-rec = recid(del_temp-disc) .
     4103     run temp-dsc-write (
     4104                          input no
     4105                         ,input del_temp-disc.pos-type
     4106                         ,input del_temp-disc.templ-rl-root
     4107                         ,input del_temp-disc.time-templ-rl-root
     4108                         ,input del_temp-disc.discnt-role
     4109                         ,input del_temp-disc.nonunique
     4110                         ,input del_temp-disc.host-code
     4111                         ,input del_temp-disc.obj-type
     4112                         ,input del_temp-disc.obj-code
     4113                         ,input v-rule-num
     4114                         ,input del_temp-disc.action
     4115                         ,input-output v-rec
     4116                         ) no-error .
     4117     IF not error-status:error then do:
     4118       assign
     4119       updated = yes
     4120       .
     4121     END .
     4122     glog = br-del:refresh() in frame Dialog-Frame no-error .
     4123     APPLY "ENTRY" to br-del.
     4124   END PROCEDURE .
     4125   PROCEDURE proc-b-exit :
     4126   define variable loc#log      as logical no-undo .
     4127   define variable v-not-all-ok as logical no-undo .
     4128   define variable v-des           like ub.dis-rule.des .
     4129   define variable v-templ-rl-root like ub.dis-rule.templ-rl-root .
     4130   define variable p-parent-handle  as widget-handle no-undo .
     4131   define variable v-view-log       as logical       no-undo .
     4132   define variable v-host-code      like temp-disc.host-code .
     4133   define buffer buf_temp-disc              for temp-disc.
     4134   define buffer buf_dis-rule               for ub.dis-rule.
     4135   define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     4136   if not can-find(first temp-disc) then do:
     4137       message "Вы не определили список скидок для изменения (добавления, удаления)"
     4138       view-as alert-box .
     4139       return no-apply .
     4140   end .
     4141   if v-rid-list = ''
     4142   then do:
     4143       message "Вы не определили список платежей"
     4144       view-as alert-box .
     4145       return no-apply .
     4146   end .
     4147   if not can-find(first buf_userobjs_temp-user-obj) then do:
     4148       message "Вы не определили список объектов, скидки" skip
     4149               "будут применены только к текущему объекту." skip
     4150               "Продолжить?"
     4151       view-as alert-box question buttons yes-no update loc#log .
     4152       if not loc#log then do:
     4153         return no-apply .
     4154       end .
     4155   end .
     4156   for each buf_userobjs_temp-user-obj exclusive-lock:
     4157   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4158   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4159     (input  buf_userobjs_temp-user-obj.obj-type
     4160     ,input  buf_userobjs_temp-user-obj.obj-code
     4161     ,output v-host-code
     4162     )  .
     4163       if not p-host-code = v-host-code then do:
     4164           message "Вы выбрали " buf_userobjs_temp-user-obj.obj-type buf_userobjs_temp-user-obj.obj-code " не принадлежащий текущей фирме" skip
     4165                   buf_userobjs_temp-user-obj.obj-type buf_userobjs_temp-user-obj.obj-code " будет исключен из списка объектов." skip
     4166                   "Продолжить?"
     4167           view-as alert-box question buttons yes-no update loc#log .
     4168           if not loc#log then do:
     4169               return no-apply .
     4170           end .
     4171           else do:
     4172               delete buf_userobjs_temp-user-obj .
     4173           end.
     4174       end.
     4175   end.
     4176   message
     4177   "Вы уверены, что Вы хотите провести изменение (добавление, удаление) скидок платежей на объекте" SKIP
     4178   "по всему определенному Вами списку?"
     4179   view-as alert-box QUESTION buttons YES-NO update loc#log .
     4180   if loc#log then do:
     4181    run save-temp-disc in this-procedure no-error.
     4182    _main:
     4183    DO
     4184    on error undo, return no-apply
     4185    :
     4186       run make-full-temp-disc in this-procedure no-error.
     4187       CASE par-subject:
     4188       when 'dis-cp-rule':U then do:
     4189           run str/diallog.w (
     4190                   input parparentproc
     4191                 , input this-procedure
     4192                 , input "ref/csh-lst.p":U
     4193                 , input v-rid-list
     4194                 , input v-auto-go
     4195                 , input "&Стоп":U
     4196                 , input "Изменение скидок платежей по списку"
     4197           ) no-error .
     4198           if error-status:error then do:
     4199               undo _main, return error .
     4200           end.
     4201       end .
     4202       END CASE .
     4203     END.
     4204     run rest-temp-disc in this-procedure no-error.
     4205   end .
     4206   END PROCEDURE .
     4207   PROCEDURE proc-title :
     4208   IF parobj-type = 'маг':U THEN DO:
     4209   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4210   define variable v-param-type21 as character no-undo .
     4211   define variable v-value-date21 as date no-undo .
     4212   define variable v-value-decimal21 as decimal no-undo .
     4213   define variable v-value-integer21 as INTEGER no-undo .
     4214   define variable v-value-logical21 AS LOGICAL no-undo .
     4215   define variable v-tth21 as handle no-undo .
     4216   run adm/shattri.p (
     4217       input "get":U
     4218       ,input  parobj-type
     4219       ,input  parobj-code
     4220       ,input  'cd-sending':U
     4221       ,input  'dflt-cd':U
     4222       ,output dflt-cd
     4223       ,output v-value-date21
     4224       ,output v-value-decimal21
     4225       ,output v-value-integer21
     4226       ,output v-value-logical21
     4227       ,output v-param-type21
     4228       ,INPUT-OUTPUT table-handle v-tth21
     4229       )  .
     4230   delete object v-tth21 no-error.
     4231   END .
     4232   if parobj-type = 'скл':U then do:
     4233     dflt-cd = '-':U .
     4234   end .
     4235   ASSIGN
     4236   MENU-ITEM m_pos-type:LABEL IN MENU menu-b-add  = dflt-cd
     4237   MENU-ITEM m_pos-type:sensitive IN MENU menu-b-add  = ((dflt-cd <> '':U) and (dflt-cd <> '-':U))
     4238   MENU-ITEM m_pos-type-2:LABEL IN MENU menu-b-add-2  = dflt-cd
     4239   MENU-ITEM m_pos-type-2:sensitive IN MENU menu-b-add-2  = ((dflt-cd <> '':U) and (dflt-cd <> '-':U))
     4240   .
     4241   frame Dialog-Frame:title = substitute("Изменение скидок на платежи, &1 &2"
     4242                                             ,parobj-type
     4243                                             ,parobj-code) .
     4244   assign
     4245   v-tab-order = "b-exit,b-quit,b-list,b-help,b-obj,b-add,b-add-2" .
     4246   APPLY "ENTRY" TO b-add IN FRAME Dialog-Frame .
     4247   END PROCEDURE .
     4248   PROCEDURE proc-b-obj :
     4249   define variable v-user-select as logical   no-undo .
     4250   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4251   run userobjs_select-many in this-procedure
     4252     (input  parparentproc
     4253     ,input  v-cntxt-db-num
     4254     ,input  v-cntxt-userid
     4255     ,input  p-host-code
     4256     ,input  parobj-type
     4257     ,input  parobj-code
     4258     ,output v-user-select
     4259     )  .
     4260   define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     4261   find first buf_userobjs_temp-user-obj no-lock no-error.
     4262   if not avail buf_userobjs_temp-user-obj
     4263   then do:
     4264     message
     4265     "Объект не выбран"
     4266     view-as alert-box information .
     4267     undo, return error return-value .
     4268   end.
     4269   END PROCEDURE .
     4270   PROCEDURE cb_set-cp-list :
     4271     define output parameter p-rid-list as character no-undo.
     4272     assign
     4273       p-rid-list = v-rid-list
     4274     .
     4275   END PROCEDURE .
     4276   PROCEDURE rest-temp-disc :
     4277     define buffer buf_temp-disc              for temp-disc.
     4278     define buffer buf_old-temp-disc          for old-temp-disc.
     4279     for each temp-disc exclusive-lock :
     4280        delete temp-disc.
     4281     end.
     4282     for each buf_old-temp-disc no-lock :
     4283        create buf_temp-disc.
     4284        buffer-copy buf_old-temp-disc to buf_temp-disc.
     4285     end.
     4286     glog = br-del:refresh() in frame Dialog-Frame no-error .
     4287     glog = br-add:refresh() in frame Dialog-Frame no-error .
     4288   END PROCEDURE .
     4289   PROCEDURE save-temp-disc :
     4290     define buffer buf_temp-disc              for temp-disc.
     4291     define buffer buf_old-temp-disc          for old-temp-disc.
     4292     for each old-temp-disc exclusive-lock :
     4293         delete old-temp-disc.
     4294     end.
     4295     for each buf_temp-disc no-lock :
     4296         create buf_old-temp-disc.
     4297         buffer-copy buf_temp-disc to buf_old-temp-disc.
     4298     end.
     4299   END PROCEDURE .
     4300   PROCEDURE make-full-temp-disc :
     4301     define buffer buf_temp-disc              for temp-disc.
     4302     define buffer buf_dis-rule               for ub.dis-rule.
     4303     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     4304     define variable v-des           like ub.dis-rule.des .
     4305     define variable v-templ-rl-root like ub.dis-rule.templ-rl-root .
     4306     define variable v-discnt-value  like ub.dis-rule.discnt-value .
     4307     define variable v-discnt-type   like ub.dis-rule.discnt-type .
     4308     _userobjs_temp-user-obj:
     4309     for each buf_userobjs_temp-user-obj no-lock :
     4310         if buf_userobjs_temp-user-obj.obj-type = parobj-type and
     4311            buf_userobjs_temp-user-obj.obj-code = parobj-code then do:
     4312              next _userobjs_temp-user-obj .
     4313         end.
     4314         _temp-disc:
     4315         for each temp-disc exclusive-lock
     4316         where temp-disc.obj-type = parobj-type
     4317           and temp-disc.obj-code = parobj-code :
     4318             find first buf_temp-disc no-lock
     4319             where buf_temp-disc.obj-type           = buf_userobjs_temp-user-obj.obj-type
     4320               and buf_temp-disc.obj-code           = buf_userobjs_temp-user-obj.obj-code
     4321               and buf_temp-disc.templ-rl-root      = temp-disc.templ-rl-root
     4322               and buf_temp-disc.time-templ-rl-root = temp-disc.time-templ-rl-root
     4323               and buf_temp-disc.discnt-role        = temp-disc.discnt-role
     4324               and buf_temp-disc.nonunique          = temp-disc.nonunique
     4325               and buf_temp-disc.cfg-nonunique      = temp-disc.cfg-nonunique
     4326               and buf_temp-disc.pos-type           = temp-disc.pos-type
     4327               and buf_temp-disc.action             = temp-disc.action
     4328             no-error.
     4329             if avail buf_temp-disc then do:
     4330                 next _temp-disc.
     4331             end.
     4332             create buf_temp-disc.
     4333             buffer-copy temp-disc
     4334             except obj-type obj-code
     4335             to buf_temp-disc
     4336             assign
     4337               buf_temp-disc.obj-type = buf_userobjs_temp-user-obj.obj-type
     4338               buf_temp-disc.obj-code = buf_userobjs_temp-user-obj.obj-code
     4339             .
     4340             if not ( temp-disc.rule-num = ? or temp-disc.rule-num = 0 ) then do:
     4341                 find first buf_dis-rule no-lock
     4342                 where buf_dis-rule.rule-num = temp-disc.rule-num no-error.
     4343                 if avail buf_dis-rule then do:
     4344                     assign
     4345                       v-des           = buf_dis-rule.des
     4346                       v-templ-rl-root = buf_dis-rule.templ-rl-root
     4347                       v-discnt-value  = buf_dis-rule.discnt-value
     4348                       v-discnt-type   = buf_dis-rule.discnt-type
     4349                     .
     4350                     find first buf_dis-rule no-lock
     4351                     where buf_dis-rule.des           = v-des
     4352                       and buf_dis-rule.host-code     = temp-disc.host-code
     4353                       and buf_dis-rule.obj-type      = buf_userobjs_temp-user-obj.obj-type
     4354                       and buf_dis-rule.obj-code      = buf_userobjs_temp-user-obj.obj-code
     4355                       and buf_dis-rule.templ-rl-root = v-templ-rl-root
     4356                       and buf_dis-rule.discnt-value  = v-discnt-value
     4357                       and buf_dis-rule.discnt-type   = v-discnt-type
     4358                       and buf_dis-rule.root          = yes no-error.
     4359                     if avail buf_dis-rule then do:
     4360                         assign
     4361                           buf_temp-disc.rule-num = buf_dis-rule.rule-num
     4362                         .
     4363                     end.
     4364                     else do:
     4365                         run copy-rule in this-procedure (
     4366                               input  temp-disc.rule-num
     4367                              ,input  buf_userobjs_temp-user-obj.obj-type
     4368                              ,input  buf_userobjs_temp-user-obj.obj-code
     4369                              ,output buf_temp-disc.rule-num
     4370                              ,input-output buf_temp-disc.label_
     4371                         ) no-error.
     4372                     end.
     4373                 end.
     4374             end.
     4375         end.
     4376     end.
     4377   END PROCEDURE .
     4378   PROCEDURE copy-rule :
     4379     define input  param p-rule-num as integer   no-undo .
     4380     define input  param p-obj-type as character no-undo .
     4381     define input  param p-obj-code as integer   no-undo .
     4382     define output param p-new-rnum as integer   no-undo init ? .
     4383     define input-output param p-err-msg as character no-undo .
     4384     define variable v-cd-type as character no-undo .
     4385     define buffer src_dis-rule for ub.dis-rule .
     4386     define buffer trg_dis-rule for ub.dis-rule .
     4387     run check-possible-copy in this-procedure (
     4388            input  p-rule-num
     4389           ,input  p-obj-type
     4390           ,input  p-obj-code
     4391           ,output p-new-rnum
     4392     ) no-error.
     4393     if error-status :error then do:
     4394         if not p-err-msg = '' then p-err-msg = p-err-msg + ', ' .
     4395         p-err-msg = error-status:get-message(1) .
     4396         return .
     4397     end.
     4398   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4399   define variable v-param-type23 as character no-undo .
     4400   define variable v-value-date23 as date no-undo .
     4401   define variable v-value-decimal23 as decimal no-undo .
     4402   define variable v-value-integer23 as INTEGER no-undo .
     4403   define variable v-value-logical23 AS LOGICAL no-undo .
     4404   define variable v-tth23 as handle no-undo .
     4405   run adm/shattri.p (
     4406       input "get":U
     4407       ,input  p-obj-type
     4408       ,input  p-obj-code
     4409       ,input  'cd-sending':U
     4410       ,input  'dflt-cd':U
     4411       ,output v-cd-type
     4412       ,output v-value-date23
     4413       ,output v-value-decimal23
     4414       ,output v-value-integer23
     4415       ,output v-value-logical23
     4416       ,output v-param-type23
     4417       ,INPUT-OUTPUT table-handle v-tth23
     4418       )  .
     4419   delete object v-tth23 no-error.
     4420     _lmain:
     4421     DO
     4422     on error undo, return
     4423     :
     4424         find first src_dis-rule no-lock
     4425         where src_dis-rule.rule-num = p-rule-num no-error .
     4426         if error-status:error then do:
     4427             if not p-err-msg = '' then p-err-msg = p-err-msg + ', ' .
     4428             p-err-msg = error-status:get-message(1) .
     4429             undo _lmain, return error .
     4430         end.
     4431         create trg_dis-rule no-error.
     4432         if error-status:error then do:
     4433             if not p-err-msg = '' then p-err-msg = p-err-msg + ', ' .
     4434             p-err-msg = error-status:get-message(1) .
     4435             undo _lmain, return error .
     4436         end.
     4437         buffer-copy src_dis-rule
     4438         except rule-num rl-root obj-type obj-code
     4439         to trg_dis-rule
     4440         assign
     4441           trg_dis-rule.rule-num = p-new-rnum
     4442           trg_dis-rule.rl-root  = p-new-rnum
     4443           trg_dis-rule.obj-type = p-obj-type
     4444           trg_dis-rule.obj-code = p-obj-code
     4445         no-error.
     4446         if error-status:error then do:
     4447             if not p-err-msg = '' then p-err-msg = p-err-msg + ', ' .
     4448             p-err-msg = error-status:get-message(1) .
     4449             undo _lmain, return error .
     4450         end.
     4451     END.
     4452   END PROCEDURE .
     4453   PROCEDURE check-possible-copy :
     4454     define input  param p-rule-num as integer   no-undo .
     4455     define input  param p-obj-type as character no-undo .
     4456     define input  param p-obj-code as integer   no-undo .
     4457     define output param p-new-rnum as integer   no-undo init ?.
     4458     define variable v-err-msg as character no-undo init ''.
     4459     define variable v-cd-type as character no-undo .
     4460     define buffer buf_dis-rule     for ub.dis-rule .
     4461     define buffer buf_dis-cfg-rule for ub.dis-cfg-rule .
     4462     find first buf_dis-rule no-lock
     4463     where buf_dis-rule.rule-num = p-rule-num no-error .
     4464     if not avail buf_dis-rule then do:
     4465         v-err-msg = substitute("Не найдено правило &1", p-rule-num ) .
     4466         return error v-err-msg .
     4467     end.
     4468     if not (buf_dis-rule.sts = int('0':U)) then do:
     4469         v-err-msg = substitute("Нельзя копировать правило в статусе &1", '0':U) .
     4470         return error v-err-msg .
     4471     end.
     4472     if buf_dis-rule.obj-type = ''
     4473     or not (buf_dis-rule.obj-type = 'маг':U or
     4474             buf_dis-rule.obj-type = 'скл':U) then do:
     4475         v-err-msg = substitute("Нельзя копировать правило, которое действует &1", get-region( p-host-code, parobj-type, parobj-code )) .
     4476         return error v-err-msg .
     4477     end.
     4478   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4479   define variable v-param-type24 as character no-undo .
     4480   define variable v-value-date24 as date no-undo .
     4481   define variable v-value-decimal24 as decimal no-undo .
     4482   define variable v-value-integer24 as INTEGER no-undo .
     4483   define variable v-value-logical24 AS LOGICAL no-undo .
     4484   define variable v-tth24 as handle no-undo .
     4485   run adm/shattri.p (
     4486       input "get":U
     4487       ,input  p-obj-type
     4488       ,input  p-obj-code
     4489       ,input  'cd-sending':U
     4490       ,input  'dflt-cd':U
     4491       ,output v-cd-type
     4492       ,output v-value-date24
     4493       ,output v-value-decimal24
     4494       ,output v-value-integer24
     4495       ,output v-value-logical24
     4496       ,output v-param-type24
     4497       ,INPUT-OUTPUT table-handle v-tth24
     4498       )  .
     4499   delete object v-tth24 no-error.
     4500     find first buf_dis-cfg-rule no-lock
     4501     where buf_dis-cfg-rule.table-name    = 'dis-cp-rule':U
     4502       and buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
     4503       and buf_dis-cfg-rule.pos-type      = v-cd-type no-error .
     4504     if not avail buf_dis-cfg-rule then do:
     4505         v-err-msg = substitute("Не найдено правило скидки с шаблоном &1 POS &2 для &3&4"
     4506                               , buf_dis-rule.templ-rl-root
     4507                               , v-cd-type
     4508                               , p-obj-type
     4509                               , p-obj-code ) .
     4510         return error v-err-msg .
     4511     end.
     4512     if not (v-cd-type = 'bo':U or v-cd-type = '-':U) then do:
     4513         if p-obj-type = 'скл':U then do:
     4514             v-err-msg = substitute("Нельзя скопировать правила скидки на объект &1&2"
     4515                                   , p-obj-type
     4516                                   , p-obj-code ) .
     4517             return error v-err-msg .
     4518         end.
     4519     end.
     4520     run gen-b-code in this-procedure ( input 'drgb':U, output p-new-rnum) no-error .
     4521     if error-status:error then do:
     4522         v-err-msg = substitute("Не удалось расчитать новый номер правила скидки &1 (gen-b-code) на &2&3&4&5&4&6" ~
     4523                               , p-rule-num
     4524                               , p-obj-type
     4525                               , p-obj-code
     4526                               , chr(10)
     4527                               , error-status:get-message(1)
     4528                               , return-value ) .
     4529         assign
     4530           p-new-rnum = ?
     4531         .
     4532         return error v-err-msg .
     4533     end.
     4534   END PROCEDURE .
