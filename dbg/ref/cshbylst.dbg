     2237     RUN proc-b-obj IN THIS-PROCEDURE NO-ERROR.
     2238     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2239   END.
     2240   ON CHOOSE OF MENU-ITEM m_bo
     2241   DO:
     2242     add-option = 'bo':U.
     2243     run proc-b-add in this-procedure ( input add-option ) no-error.
     2244     if error-status:error then do:
     2245       add-option = '':U.
     2246       return no-apply.
     2247     end.
     2248     add-option = '':U.
     2249   END.
     2250   ON CHOOSE OF MENU-ITEM m_bo-2
     2251   DO:
     2252       add-option = 'bo':U.
     2253     run proc-b-add-2 in this-procedure ( input add-option ) no-error.
     2254     if error-status:error then do:
     2255       add-option = '':U.
     2256       return no-apply.
     2257     end.
     2258     add-option = '':U.
     2259   END.
     2260   ON CHOOSE OF MENU-ITEM m_no-pos
     2261   DO:
