      190   procedure userobjs_object-count :
      191     define output parameter p-total-count as integer   no-undo .
      192     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      193     do
      194     on error undo, return error return-value
      195     :
      196       assign
      197         p-total-count = 0
      198       .
      199       for each buf_userobjs_temp-user-obj
      200       on error undo, return error return-value
