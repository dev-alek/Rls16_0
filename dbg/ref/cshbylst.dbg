        9   define input parameter p-host-code like ub.dis-cp-rule.host-code no-undo.
       10   define input parameter parobj-type like ub.clients.obj-type no-undo.
       11   define input parameter parobj-code like ub.clients.obj-code no-undo.
       12   define variable vss-revision    as character no-undo init "$Revision$":U .
