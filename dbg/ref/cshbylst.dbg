      231     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      232     do
      233     on error undo, return error return-value
      234     :
      235       find first buf_userobjs_temp-user-obj
      236         no-error .
      237       if not available buf_userobjs_temp-user-obj
      238       then do:
      239         assign
      240           p-object-exist = false
      241         .
      242       end.
      243       else do:
      244         assign
      245           p-object-exist = true
      246         .
      247       end.
      248     end.
      249   end.
      250   procedure userobjs_transfer :
      251     define input  parameter p-callback-handle as handle no-undo .
      252     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      253     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      254     do
      255     on error undo, return error return-value
      256     :
      257       if valid-handle(p-callback-handle) <> true
      258       then do:
      259         message
      260           vss-workfile vss-revision vss-description skip
      261           "Ошибка задания входных параметров" skip
      262           "Неизвестный указатель на процедуру" skip
      263           view-as alert-box error .
      264         undo, return error return-value .
      265       end.
      266       if p-callback-handle :get-signature("userobjs_append") = ""
      267       then do:
      268         message
      269           vss-workfile vss-revision vss-description skip
      270           "Ошибка задания входных параметров" skip
      271           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      272                     ,p-callback-handle :file-name
      273                     ) skip
      274           view-as alert-box error .
      275         undo, return error return-value .
      276       end.
      277       for each buf_userobjs_temp-user-obj
      278       on error undo, return error return-value
      279       :
      280         run userobjs_append in p-callback-handle
      281           (input  buf_userobjs_temp-user-obj.obj-type
      282           ,input  buf_userobjs_temp-user-obj.obj-code
      283           ) .
      284       end.
      285     end.
      286   end procedure.
