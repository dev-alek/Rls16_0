     2094         del_temp-disc.rule-num                         COLUMN-LABEL "Код правила"     FORMAT ">>>>>>>>9"
     2095         get-objregion(del_temp-disc.obj-type, del_temp-disc.obj-code) COLUMN-LABEL "Действует" FORMAT "X(12)"
     2096       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 8
     2097            TITLE "Будут удалены скидки".
     2098   DEFINE FRAME Dialog-Frame
     2099        B-exit AT ROW 1 COL 1
     2100        b-quit AT ROW 1 COL 11
     2101        B-obj AT ROW 1 COL 26.5
     2102        B-list AT ROW 1 COL 47.5
     2103        B-Help AT ROW 1 COL 92
     2104        b-add AT ROW 2.5 COL 1
     2105        B-chg AT ROW 2.5 COL 11
     2106        B-del AT ROW 2.5 COL 21
     2107        BR-add AT ROW 3.5 COL 1
     2108        b-add-2 AT ROW 12.75 COL 1
     2109        B-chg-2 AT ROW 12.75 COL 11 WIDGET-ID 2
     2110        B-del-2 AT ROW 12.75 COL 21
     2111        BR-del AT ROW 14 COL 1
     2112        SPACE(0.00) SKIP(0.33)
     2113       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2114            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2115            TITLE "<insert dialog title>"
     2116            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     2117   ASSIGN
     2118          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2119          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2120   ASSIGN
     2121          b-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-add:HANDLE.
     2122   ASSIGN
     2123          b-add-2:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-add-2:HANDLE.
     2124   ON WINDOW-CLOSE OF FRAME Dialog-Frame
