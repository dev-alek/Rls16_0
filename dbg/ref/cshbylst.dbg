     2078         entry (lookup (temp-disc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U) column-label "Место!использ."  format "X(10)"
     2079   discpru-get-disc-role-label (temp-disc.discnt-role) column-label "Тип скидки" FORMAT "X(255)":U WIDTH 35
     2080   temp-disc.templ-rl-root FORMAT ">>>>>>>>9":U COLUMN-LABEL "Код!шаблона"
     2081   temp-disc.time-templ-rl-root FORMAT ">>>>>>>>9":U COLUMN-LABEL "Код!типа!распис"
     2082   discpru-get-disc-label( INPUT temp-disc.templ-rl-root) FORMAT "X(255)":U WIDTH 45
     2083   temp-disc.rule-num COLUMN-LABEL "Код правила" FORMAT ">>>>>>>>9"
     2084   get-objregion(temp-disc.obj-type, temp-disc.obj-code) COLUMN-LABEL "Действует" FORMAT "X(12)"
     2085       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 8
     2086            TITLE "Будут добавлены/изменены скидки".
     2087   DEFINE BROWSE BR-del
     2088     QUERY BR-del DISPLAY
     2089         entry (lookup (del_temp-disc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)                               column-label "Место!использ."  format "X(10)"
     2090         discpru-get-disc-role-label ( DEL_temp-disc.discnt-role) column-label "Тип скидки"      FORMAT "X(255)":U WIDTH 35
     2091         del_temp-disc.templ-rl-root                    COLUMN-LABEL "Код!шаблона"     FORMAT ">>>>>>>>9":U
     2092         del_temp-disc.time-templ-rl-root               COLUMN-LABEL "Код!типа!распис" FORMAT ">>>>>>>>9":U
