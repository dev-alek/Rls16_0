     2128   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     2129   DO:
     2130     if add-option = '':U then do:
     2131         run gbl/pop-up.p ( input self:handle, input no) no-error.
     2132     end.
     2133     if add-option = '':U then return no-apply.
     2134     run proc-b-add in this-procedure ( input add-option) no-error .
     2135     if error-status:error then do:
     2136       add-option = '':U.
     2137       return no-apply.
     2138     end.
     2139     add-option = '':U.
     2140   END.
     2141   ON CHOOSE OF b-add-2 IN FRAME Dialog-Frame
     2142   DO:
     2143     if add-option = '':U then do:
     2144         run gbl/pop-up.p ( input self:handle, input no) no-error.
     2145     end.
     2146     if add-option = '':U then return no-apply.
     2147     run proc-b-add-2 in this-procedure ( input add-option) no-error .
     2148     if error-status:error then do:
     2149       add-option = '':U.
     2150       return no-apply.
     2151     end.
     2152     add-option = '':U.
     2153   END.
     2154   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
