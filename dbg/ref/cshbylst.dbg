     2157     if error-status:error then return no-apply.
     2158   END.
     2159   ON CHOOSE OF B-chg-2 IN FRAME Dialog-Frame
     2160   DO:
     2161     run proc-b-chg-2 in this-procedure ( input "change":U) no-error.
     2162     if error-status:error then return no-apply.
     2163   END.
     2164   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     2165   DO:
     2166     define variable loc#log as logical no-undo.
     2167     if not avail temp-disc then return no-apply.
     2168     loc#log = no.
     2169     message
     2170        "Вы уверены, что хотите удалить скидку" skip
     2171        "из списка скидок подлежащих установке/изменению?" skip
     2172     view-as alert-box QUESTIOn buttons YES-NO update loc#log.
     2173     if NOT loc#log then return no-apply.
     2174     run temp-dsc-delete in this-procedure (
     2175                                                input temp-disc.pos-type
     2176                                               ,input temp-disc.discnt-role
     2177                                               ,input temp-disc.nonunique
     2178                                               ,input temp-disc.host-code
     2179                                               ,input temp-disc.obj-type
     2180                                               ,input temp-disc.obj-code
     2181                                               ,input temp-disc.action
     2182                                               ,output loc#log) no-error .
     2183       if error-status:error or not loc#log then do:
     2184           return no-apply.
     2185       end.
     2186        updated = yes.
     2187       run init-proc in this-procedure .
     2188       APPLY "ENTRY" to br-add.
     2189   END.
     2190   ON CHOOSE OF B-del-2 IN FRAME Dialog-Frame
     2191   DO:
     2192     define variable loc#log as logical no-undo.
     2193     if not avail del_temp-disc then return no-apply.
     2194     loc#log = no.
     2195     message
     2196        "Вы уверены, что хотите удалить скидку" skip
     2197        "из списка скидок, подлежащих удалению?" skip
     2198     view-as alert-box QUESTIOn buttons YES-NO update loc#log.
     2199     if NOT loc#log then return no-apply.
     2200     run temp-dsc-delete in this-procedure (
     2201                                                input del_temp-disc.pos-type
     2202                                               ,input del_temp-disc.discnt-role
     2203                                               ,input del_temp-disc.nonunique
     2204                                               ,input del_temp-disc.host-code
     2205                                               ,input del_temp-disc.obj-type
     2206                                               ,input del_temp-disc.obj-code
     2207                                               ,input del_temp-disc.action
     2208                                               ,output loc#log) no-error .
     2209       if error-status:error or not loc#log then do:
     2210           return no-apply.
     2211       end.
     2212       updated = yes.
     2213       run init-proc in this-procedure .
     2214       APPLY "ENTRY" to br-del.
     2215   END.
     2216   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     2217   DO:
     2218     RUN proc-b-exit IN THIS-PROCEDURE NO-ERROR.
     2219     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2220   END.
     2221   ON CHOOSE OF B-list IN FRAME Dialog-Frame
     2222   DO:
     2223         run ref/cashpays.w (
     2224             parparentproc
     2225             ,"b-sel,b-mark"
     2226             ,'все':U
     2227             ,p-host-code
     2228             ,parobj-type
     2229             ,parobj-code
     2230             ,output v-rid-list ) .
