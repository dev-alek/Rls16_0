        1   define input        parameter parparentproc as   widget-handle      no-undo .
        2   define input        parameter p-mode        as character            no-undo .
        3   define input        parameter bc            like ub.bar-code.b-code no-undo .
        4   define input        parameter par-shbl      like ub.prod-bc.b-str   no-undo .
        5   define input        parameter par-EAN       as   logical            no-undo .
        6   define input        parameter p-cdrg-type   as character no-undo .
        7   define input-output parameter rid           as   recid              no-undo .
        8   define variable vss-revision    as character no-undo initial "$Revision$":U .
        9   define variable vss-author      as character no-undo initial "$Author$":U .
       10   define variable vss-date        as character no-undo initial "$Date$":U .
       11   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       12   define variable vss-archive     as character no-undo initial "$Archive$":U .
       13   define variable vss-description as character no-undo initial "Форма работы с дополнительным бар-кодом":U .
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   procedure proc-alt-shift-f2:
       84     if not ibs.th.gbl.gbl-var:rcode
       85   then
       86     run gbl\inidebug.p .
       87   end.
       88   procedure proc-alt-shift-f3:
       89     run gbl/prvssinf.p
       90       ( input this-procedure
       91       ) .
       92   end.
       93   define variable v-inform-launched as logical no-undo initial false .
       94   procedure proc-alt-shift-f4:
       95     define variable v-action as character no-undo .
       96     if v-inform-launched = false then do:
       97       assign
       98         v-inform-launched = true
       99       .
      100       run gbl/d-inform.w
      101         (  input self
      102         ,  input this-procedure
      103         , output v-action
      104         ) no-error .
      105       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      106       assign
      107         v-inform-launched = false
      108       .
      109     end.
      110   end.
      111   procedure proc-alt-f1:
      112     run gbl/corrhelp.p
      113       (input this-procedure
      114       ) .
      115   end .
      116   on alt-shift-f2 anywhere do:
      117     run proc-alt-shift-f2.
      118   end.
      119   on alt-shift-f3 anywhere do:
      120     run proc-alt-shift-f3 in this-procedure .
      121   end.
      122   on alt-shift-f4 anywhere do:
      123     run proc-alt-shift-f4 in this-procedure.
      124   end.
      125   on alt-f1 anywhere do:
      126     run proc-alt-f1 in this-procedure .
      127   end.
      128   define variable dops        as character no-undo format "X(250)":U.
      129   define variable dopst       as character no-undo format "X(1)":U.
      130   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   define variable send-ref as logical no-undo.
      132   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      133     (input  'send-ref'
      134     ,input  0
      135     ,input  ''
      136     ,input  0
      137     ,input  ''
      138     ,input  ''
      139     ,input  ''
      140     ,input  no
      141     ,output dops
      142     ,output dopst
      143     ) no-error .
      144     send-ref = (IF error-status:error or dops <> "yes" then no else yes).
      145   DEFINE BUTTON b-exit AUTO-GO
      146        LABEL "&Ввод"
      147        SIZE 10 BY 1
      148        BGCOLOR 8 .
      149   DEFINE BUTTON b-help
      150        LABEL "Помо&щь"
      151        SIZE 10 BY 1
      152        BGCOLOR 8 .
      153   DEFINE BUTTON b-quit AUTO-END-KEY
      154        LABEL "&Отмена"
      155        SIZE 10 BY 1
      156        BGCOLOR 8 .
      157   DEFINE VARIABLE t-EAN AS LOGICAL INITIAL no
      158        LABEL "Только EAN"
      159        VIEW-AS TOGGLE-BOX
      160        SIZE 13 BY .83 NO-UNDO.
      161   DEFINE VARIABLE t-NEdeMark AS LOGICAL INITIAL no
      162        LABEL "Требуется  маркировка"
      163        VIEW-AS TOGGLE-BOX
      164        SIZE 24 BY .83 NO-UNDO.
      165   DEFINE QUERY d-bc-form FOR
      166         ub.bar-code,
      167         ub.prod-bc,
      168         ub.units,
      169         ub.goods SCROLLING.
      170   DEFINE FRAME d-bc-form
      171        b-exit AT ROW 1 COL 1
      172        b-quit AT ROW 1 COL 11
      173        b-help AT ROW 1 COL 21
      174        t-EAN AT ROW 2.5 COL 17
      175        t-NEdeMark AT ROW 2.5 COL 31
      176        ub.prod-bc.b-str AT ROW 3.67 COL 15 COLON-ALIGNED FORMAT "X(40)"
      177             VIEW-AS FILL-IN
      178             SIZE 41.5 BY 1
      179             FGCOLOR 4
      180        ub.bar-code.unit-cli AT ROW 4.96 COL 15 COLON-ALIGNED
      181             LABEL "Ед.изм."
      182             VIEW-AS FILL-IN
      183             SIZE 5.5 BY 1
      184        ub.units.long-name AT ROW 5 COL 22 COLON-ALIGNED NO-LABEL
      185             VIEW-AS FILL-IN
      186             SIZE 34.63 BY 1
      187             FGCOLOR 4
      188        ub.goods.unit-base AT ROW 6.25 COL 15.13 COLON-ALIGNED
      189             LABEL "Осн. ед. изм."
      190             VIEW-AS FILL-IN
      191             SIZE 5.25 BY 1
      192        ub.bar-code.cli-base-rate AT ROW 6.33 COL 35.13 COLON-ALIGNED FORMAT ">,>>9.9999999999"
      193             VIEW-AS FILL-IN
      194             SIZE 21.63 BY 1
      195        SPACE(3.49) SKIP(0.58)
      196       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      197            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      198            TITLE ""
      199            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      200   ASSIGN
      201          FRAME d-bc-form:SCROLLABLE       = FALSE
      202          FRAME d-bc-form:HIDDEN           = TRUE.
      203   ON GO OF FRAME d-bc-form
      204   DO:
      205     run create-bar-code in this-procedure no-error .
      206     if error-status :error
      207     then do:
      208       return no-apply .
      209     end.
      210   END.
      211   ON WINDOW-CLOSE OF FRAME d-bc-form
      212   DO:
      213     APPLY "END-ERROR":U TO SELF.
      214   END.
      215   ON RETURN OF ub.prod-bc.b-str IN FRAME d-bc-form
      216   DO:
      217     apply "entry" to ub.bar-code.unit-cli in frame d-bc-form.
      218     return no-apply.
      219   END.
      220   ON leave OF prod-bc.b-str IN FRAME d-bc-form
      221   DO:
      222       define variable VTXT as char no-undo.
      223       define variable vGtin as int64 no-undo.
      224       if p-cdrg-type  eq 'GTIN':U
      225       then do:
      226           vTXt = prod-bc.b-str:screen-value.
      227         if    length(vtxt) > 14
      228         then do:
      229            if    (length(vtxt) eq 14 + 7 + 4 + 4
      230                or length(vtxt) eq 14 + 7 + 4 )
      231            then
      232               prod-bc.b-str:screen-value = substring(vtxt,1,14).
      233            else if vtxt begins "01"
      234            then
      235               prod-bc.b-str:screen-value = substring(vtxt,3,14).
      236            else do:
      237            end.
      238         end.
      239      end.
      240   END.
      241   IF VALID-HANDLE (ACTIVE-WINDOW) AND FRAME d-bc-form:PARENT eq ?
      242   THEN FRAME d-bc-form:PARENT = ACTIVE-WINDOW.
      243   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      244   on help of frame d-bc-form
      245   do:
      246     run gbl/app_help.p
      247       (input this-procedure :file-name
      248       ,input ''
      249       ,input ?
      250       ) no-error.
      251     if error-status :error then do:
      252       message
      253         "Ошибка при вызове помощи"
      254         error-status :get-message(1)
      255         view-as alert-box .
      256     end.
      257   end.
      258   run minbtn-set in this-procedure .
      259   on choose of b-help in frame d-bc-form
      260   do:
      261     apply "help":u to frame d-bc-form .
      262   end.
      263   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      264   procedure minbtn-set :
      265       do
      266           on error undo, return error return-value
      267           :
      268           define variable ii              as integer       no-undo .
      269           define variable fh              as widget-handle no-undo .
      270           define variable hh              as widget-handle no-undo .
      271           define variable v-h             as handle        extent 4 no-undo .
      272           define variable v-name-button   as character     no-undo .
      273           define variable v-help-old-x    as decimal       no-undo .
      274           define variable v-help-old-y    as decimal       no-undo .
      275           define variable v-help-old-size as decimal       no-undo .
      276           define variable v-frame-width   as decimal       no-undo .
      277           define variable jj              as integer       no-undo .
      278           do
      279               on error undo, return error
      280               :
      281               assign
      282                   v-frame-width = frame d-bc-form:width - 0.3
      283                   fh            = frame d-bc-form:first-child
      284                   hh            = fh:first-child
      285                   ii            = 1
      286                   .
      287               do while valid-handle(hh):
      288                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      289                   do:
      290                       case lc(hh:name) :
      291                           when "b-help" then
      292                               do:
      293                                   hh:load-image-up("cmp/b-help.bmp":u) .
      294                                   hh:load-image-down("cmp/b-help.bmp":u) .
      295                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      296                                   hh:TOOLTIP = "Помощь" .
      297                                   v-help-old-x = hh:column .
      298                                   v-help-old-y = hh:row    .
      299                                   v-help-old-size = hh:width .
      300                                   hh:width-chars = 2.5 .
      301                               end.
      302                           when "b-print" then
      303                               do:
      304                                   hh:load-image("cmp/b-print.bmp":u) .
      305                                   hh:TOOLTIP = "Печать" .
      306                                   v-h[ii] = hh:handle .
      307                                   ii = ii + 1 .
      308                                   hh:width-chars = 3 .
      309                               end.
      310                           when "b-history" or
      311                           when "b-hist" then
      312                               do:
      313                                   hh:load-image("cmp/b-hist.bmp":u) .
      314                                   hh:TOOLTIP = "История" .
      315                                   v-h[ii] = hh:handle .
      316                                   ii = ii + 1 .
      317                                   hh:width-chars = 3 .
      318                               end.
      319                           when "b-sch" then
      320                               do:
      321                                   hh:load-image("cmp/b-sch.bmp":u) .
      322                                   hh:TOOLTIP = "Установка Фильтра" .
      323                                   v-h[ii] = hh:handle .
      324                                   ii = ii + 1 .
      325                                   hh:width-chars = 3 .
      326                               end.
      327                           when "b-hist-user" then
      328                               do:
      329                                   hh:load-image("cmp/b-hist.bmp":u) .
      330                                   hh:TOOLTIP = "История пользователя" .
      331                                   ii = ii + 1 .
      332                               end.
      333                       end case.
      334                   end.
      335                   hh = hh:next-sibling.
      336               end.
      337               b-help:column = v-frame-width - b-help:width-chars.
      338               jj = 0.
      339               repeat ii = 4 to 1 by -1 :
      340                   if valid-handle (v-h[ii] ) then
      341                   do:
      342                       jj  = jj + 1 .
      343                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      344                       v-h[ii]:row    = v-help-old-y .
      345                   end.
      346               end.
      347           end.
      348       end.
      349   end procedure.
      350   MAIN-BLOCK:
      351   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      352      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      353      VIEW FRAME d-bc-form.
      354      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
      355     find ub.bar-code no-lock
      356       where ub.bar-code.b-code = bc
      357       .
      358     if ub.bar-code.stts_ = integer('99':U)
      359     or ub.bar-code.stts_ = integer('79':U)
      360     then do:
      361       message
      362       substitute("Собственный бар-код &1 заблокирован для удаления или логически удален", ub.bar-code.b-code) skip
      363       "Редактирование/добавление невозможно"
      364       view-as alert-box error .
      365       undo main-block, return error .
      366     end.
      367     find ub.goods no-lock
      368       where ub.goods.gds-code = ub.bar-code.gds-code
      369       .
      370     find ub.units no-lock
      371       where ub.units.unit-name = ub.bar-code.unit-cli
      372       .
      373     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      374     find first ub.prod-bc no-lock
      375       where ub.prod-bc.b-code = bc and ub.prod-bc.b-str = par-shbl
      376       .
      377     end.
      378     assign
      379       t-EAN = p-cdrg-type ne 'GTIN':U
      380       t-NEDEMark = no
      381     .
      382     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      383        t-NEdeMark = no .
      384     end.
      385     else do:
      386        display ub.prod-bc.b-str with frame d-bc-form .
      387         find first buf_prod-bc-attr exclusive-lock where buf_prod-bc-attr.b-str = ub.prod-bc.b-str and
      388            buf_prod-bc-attr.b-code = ub.prod-bc.b-code and buf_prod-bc-attr.attr-code = 'mark':U no-error .
      389         if available (buf_prod-bc-attr) then t-NEdeMark = logical(buf_prod-bc-attr.attr-value).
      390         else t-NEdeMark = no .
      391     end.
      392     display
      393       ub.bar-code.unit-cli
      394       t-EAN when p-cdrg-type ne 'GTIN':U
      395       t-NEDEMark when p-cdrg-type ne 'GTIN':U
      396       ub.bar-code.cli-base-rate
      397       ub.units.long-name
      398       ub.goods.unit-base
      399       with frame d-bc-form.
      400      if p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      401     enable
      402       ub.prod-bc.b-str
      403       t-EAN when p-cdrg-type ne 'GTIN':U
      404       t-NEDEMark when p-cdrg-type ne 'GTIN':U
      405       b-exit
      406       b-help
      407       b-quit
      408       with frame d-bc-form .
      409     end.
      410     else do:
      411     enable
      412       t-NEDEMark when p-cdrg-type ne 'GTIN':U
      413       b-exit
      414       b-help
      415       b-quit
      416       with frame d-bc-form .
      417     end.
      418     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      419     if par-EAN = no
      420     then do:
      421       assign
      422         t-ean = no
      423       .
      424       display
      425         t-EAN when p-cdrg-type ne 'GTIN':U
      426         with frame d-bc-form .
      427     end.
      428     end.
      429     if p-cdrg-type eq 'GTIN':U
      430     then assign
      431        t-EAN:visible = no
      432        t-NEDEMark:visible = no.
      433     else do:
      434        if p-mode = 'ДОБАВЛЕНИЕ':U then
      435        do:
      436           define buffer buf_prod-bc  for prod-bc.
      437           define buffer buf_gtin_bar for bar-code.
      438           for each buf_gtin_bar where buf_gtin_bar.gds-code  = ub.goods.gds-code
      439              and can-find (first buf_prod-bc
      440              where buf_prod-bc.b-code =  buf_gtin_bar.b-code
      441              and buf_prod-bc.bc-on-type = 'GTIN':U )
      442              no-lock:
      443              t-NEdeMark = yes.
      444           end.
      445           t-NEdeMark:visible = yes.
      446           disp t-NEdeMark with frame d-bc-form .
      447        end.
      448     end.
      449     if par-shbl <> ""
      450     then do:
      451       display
      452         par-shbl @ ub.prod-bc.b-str
      453         with frame d-bc-form .
      454     end.
      455     assign
      456       rid = ?
      457     .
      458     assign frame d-bc-form :title = "ДОПОЛНИТЕЛЬНЫЙ " + (if p-cdrg-type eq 'GTIN':U then 'GTIN':U + "                " else "бар-код                ") + p-mode.
      459     wait-for go of frame d-bc-form  focus ub.prod-bc.b-str.
      460   END.
      461   RUN disable_UI.
      462   PROCEDURE create-bar-code :
      463      define variable v-b-str as character no-undo .
      464      define buffer buf_prod-bc for ub.prod-bc.
      465      define variable v-send as logical no-undo .
      466      v-b-str = input frame d-bc-form ub.prod-bc.b-str.
      467      ASSIGN frame d-bc-form t-NEdeMark.
      468      rid = ?.
      469      if p-mode = 'ДОБАВЛЕНИЕ':U then
      470      do:
      471         run trg/prod-bc2.p (
      472            input  parparentproc
      473            ,input no
      474            ,input no
      475            ,input no
      476            ,input send-ref
      477            ,input p-cdrg-type
      478            ,input (if logical(t-EAN:screen-value) then "EAN" else "")
      479            ,buffer goods
      480            ,input bar-code.b-code
      481            ,input logical(t-NEDEMark:screen-value)
      482            ,input-output v-b-str
      483            ,output rid
      484            ) no-error.
      485         if error-status :error
      486            or rid = ? then
      487         do:
      488            apply "entry" to ub.prod-bc.b-str in frame d-bc-form.
      489            undo, return error return-value .
      490         end.
      491         else
      492         do:
      493            find first buf_prod-bc no-lock
      494               where recid(buf_prod-bc) = rid.
      495            if  buf_prod-bc.bc-on
      496               and send-ref
      497               then
      498            do:
      499               run str/diallog.w
      500                  (input parparentproc
      501                  ,input this-procedure
      502                  ,input 'str/s-prodbc.p':U
      503                  ,input string(rid) + chr(4) + "U":U
      504                  ,input yes
      505                  ,input '':U
      506                  ,input "Пересылка ДопБК на кассы"
      507                  ) .
      508            end.
      509         end.
      510      end.
      511      else
      512      do:
      513         if t-NEdeMark
      514            then
      515         do:
      516            find first buf_prod-bc-attr exclusive-lock where buf_prod-bc-attr.b-str = ub.prod-bc.b-str and
      517               buf_prod-bc-attr.b-code = ub.prod-bc.b-code and buf_prod-bc-attr.attr-code = 'mark':U no-error .
      518            if available (buf_prod-bc-attr) then
      519            do:
      520               if logical (buf_prod-bc-attr.attr-value) <> t-NEdeMark then v-send = true .
      521               buf_prod-bc-attr.attr-value = "yes" .
      522            end.
      523            else
      524            do:
      525               create buf_prod-bc-attr.
      526               assign
      527                  buf_prod-bc-attr.b-str      = ub.prod-bc.b-str
      528                  buf_prod-bc-attr.b-code     = ub.prod-bc.b-code
      529                  buf_prod-bc-attr.attr-code  = 'mark':U
      530                  buf_prod-bc-attr.attr-value = "yes"
      531                  .
      532               v-send = true .
      533            end.
      534         end.
      535         else
      536         do:
      537            find first buf_prod-bc-attr exclusive-lock where buf_prod-bc-attr.b-str = ub.prod-bc.b-str and
      538               buf_prod-bc-attr.b-code = ub.prod-bc.b-code and buf_prod-bc-attr.attr-code = 'mark':U no-error .
      539            if available (buf_prod-bc-attr) then
      540            do:
      541               delete buf_prod-bc-attr .
      542               v-send = true .
      543            end.
      544         end.
      545         if v-send then
      546         do:
      547            rid = recid(ub.prod-bc) .
      548            find first buf_prod-bc no-lock
      549               where recid(buf_prod-bc) = rid.
      550            if  buf_prod-bc.bc-on
      551               and send-ref
      552               then
      553            do:
      554               run str/diallog.w
      555                  (input parparentproc
      556                  ,input this-procedure
      557                  ,input 'str/s-prodbc.p':U
      558                  ,input string(rid) + chr(4) + "U":U
      559                  ,input yes
      560                  ,input '':U
      561                  ,input "Пересылка ДопБК на кассы"
      562                  ) .
      563            end.
      564         end.
      565      end.
      566   END PROCEDURE.
      567   PROCEDURE disable_UI :
      568     HIDE FRAME d-bc-form.
      569   END PROCEDURE.
