        1   block-level on error undo, throw.
        2   define parameter buffer buf_dis-time-rule for ub.dis-time-rule .
        3   define input parameter p-sts-mode as logical no-undo .
        4   define input parameter p-silent                       as logical no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: dis-tim3.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: ref/dis-tim3.p $":U .
       10   define variable vss-description as character no-undo init "Физическое удаление РАСПИСАНИЯ".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   procedure dtr-code :
       82     do
       83     on error undo, return error
       84     :
       85       define input  parameter  p-templ-rl-root     like ub.dis-time-rule.templ-rl-root     no-undo .
       86       define output parameter  p-des               like ub.dis-time-rule.des               no-undo .
       87       define output parameter  p-upper-time-rule-num    like ub.dis-time-rule.upper-time-rule-num    no-undo .
       88       define output parameter  p-value-type        like ub.dis-time-rule.value-type        no-undo .
       89       define output parameter  p-level-1 as character no-undo .
       90       define output parameter  p-level-2 as character no-undo .
       91       define output parameter  p-output-display as logical   no-undo .
       92       define output parameter  p-tree           as char  no-undo .
       93       define output parameter  p-other          as character no-undo .
       94       define variable v-templ-rl-root like ub.dis-time-rule.templ-rl-root no-undo .
       95       define buffer buf_dis-time-rule for ub.dis-time-rule .
       96       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
       97       if p-templ-rl-root < 50000 then
       98       v-templ-rl-root = (p-templ-rl-root + 50000).
       99       else v-templ-rl-root = p-templ-rl-root.
      100       find first buf_dis-time-rule no-lock where
      101                 buf_dis-time-rule.time-rule-num = v-templ-rl-root no-error .
      102       if not available buf_dis-time-rule then do:
      103         undo, return error substitute("неизвестный тип расписания &1", p-templ-rl-root) .
      104       end.
      105       find first buf_dis-cfg-rule no-lock where
      106               buf_dis-cfg-rule.templ-rl-root = 0
      107           and buf_dis-cfg-rule.time-templ-rl-root = p-templ-rl-root
      108           and buf_dis-cfg-rule.pos-type = '':U
      109           and buf_dis-cfg-rule.table-name = '':U
      110           and buf_dis-cfg-rule.discnt-role = '':U
      111           and buf_dis-cfg-rule.self-nonunique = '':U
      112               no-error.
      113       if not available buf_Dis-cfg-rule then do:
      114           undo, return error substitute("неизвестный тип расписания &1", p-templ-rl-root ).
      115       end.
      116       assign
      117       p-des = buf_dis-time-rule.des
      118       p-upper-time-rule-num = (buf_dis-time-rule.upper-time-rule-num - 50000)
      119       p-value-type = buf_dis-time-rule.value-type
      120       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      121       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      122                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      123                    else '')
      124       p-output-display = (buf_dis-time-rule.sts = integer('0':U))
      125       p-tree = buf_dis-time-rule.uniq-field
      126       p-other = buf_dis-time-rule.other-inf
      127       .
      128     end.
      129   end procedure.
      130   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   define variable v-waitfram-action01         as character   no-undo .
      132   define variable v-waitfram-action02         as character   no-undo .
      133   define variable v-waitfram-action03         as character   no-undo .
      134   define variable mWaitFramTextBeg            as character   no-undo.
      135   define variable mWaitFramTextEnd            as character   no-undo.
      136   define variable mWaitFramView               as logical     no-undo.
      137   define variable mWaitProcEvent              as logical     no-undo init yes.
      138   define variable mWaitFramInterval           as integer     no-undo init 1 .
      139   define variable mWaitFramStop               as logical     no-undo.
      140   define variable mWaitFramStopUser           as logical     no-undo.
      141   define variable mWaitFramStopTimeOut        as logical     no-undo.
      142   define variable mWaitFramStartProc          as datetime-tz no-undo.
      143   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      144   define button B-WaitFramStop auto-end-key
      145        label "Стоп"
      146        size 10 by 1 tooltip "Остоновить процесс".
      147   define button B-viewProcInfo
      148        label "Информация"
      149        size 15 by 1 tooltip "Информация о процесс".
      150   define frame waitfram
      151     v-waitfram-action01 format "x(72)" no-label skip
      152     v-waitfram-action02 format "x(72)" no-label skip
      153     v-waitfram-action03 format "x(72)" no-label skip
      154     B-viewProcInfo
      155     B-WaitFramStop at row 4 col 30
      156     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      157     .
      158   define new global shared variable mBatchMode as logical no-undo init ?.
      159   define variable mFramBachModHandle as handle no-undo.
      160   mFramBachModHandle = frame waitfram:handle.
      161   define variable mFameOldVis as logical no-undo.
      162   define variable mVisCUrentVin as logical no-undo.
      163   if session:batch-mode
      164   then
      165      mBatchMode = yes.
      166   if mBatchMode = ? then do:
      167     mVisCUrentVin = current-window:visible.
      168     mFameOldVis = mFramBachModHandle:visible.
      169     mFramBachModHandle:visible  = yes.
      170     mBatchMode = mFramBachModHandle:visible ne yes.
      171     mFramBachModHandle:visible = mFameOldVis.
      172     current-window:visible = mVisCUrentVin.
      173   end.
      174    if  log-manager:logfile-name ne ?
      175     then DO:
      176         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      177         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      178         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      179     end.
      180   on choose of B-WaitFramStop in frame waitfram
      181   do:
      182     mWaitFramStop = yes.
      183     mWaitFramStopUser = yes.
      184   end.
      185   function waitfram-check-timeout returns logical():
      186      define variable vtime as int64 no-undo.
      187      if mWaitFramStopTimeOut
      188      then
      189         return yes.
      190      vtime = ( now - mWaitFramStartProc ) / 1000 .
      191      if     mWaitFramTimeOut ne ?
      192         and mWaitFramTimeOut ne 0
      193         and mWaitFramTimeOut lt vtime
      194      then do:
      195         mWaitFramStopTimeOut = yes.
      196      end.
      197      return mWaitFramStopTimeOut.
      198   end.
      199   procedure waitfram-hide :
      200     if not session:batch-mode
      201     then do
      202     on error undo, return error return-value
      203     :
      204       pause 0 before-hide .
      205       if not mBatchMode then
      206         hide frame waitfram .
      207     if     not mWaitFramView
      208        and mWaitProcEvent
      209     then
      210       process events .
      211     end.
      212   end procedure.
      213   procedure waitfram-show :
      214     define input  parameter p-message as character no-undo .
      215     define variable v-left-margin as integer   no-undo .
      216     if not session:batch-mode
      217     then do
      218     on error undo, return error return-value
      219     :
      220       if length(p-message) <= 70 then do:
      221         assign
      222           v-left-margin = integer((70 - length(p-message)) / 2)
      223         .
      224         assign
      225           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      226         .
      227         assign
      228           v-waitfram-action01 = " "
      229           v-waitfram-action02 = " "
      230                                    + fill(" ", v-left-margin)
      231                                    + p-message
      232           v-waitfram-action03 = " "
      233         .
      234       end.
      235       else do:
      236         define variable vRindex1 as integer no-undo.
      237         define variable vRindex2 as integer no-undo.
      238         vRindex1 = r-index(p-message," ",70).
      239         if vRindex1 = 0
      240         then
      241            vRindex1 = 70.
      242         if length(p-message)  <= vRindex1 + 70 then do:
      243           assign
      244             v-waitfram-action01 = " "
      245             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      246             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      247           .
      248         end.
      249         else do:
      250           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      251           if vRindex2 <= vRindex1
      252           then
      253              vRindex2 = vRindex1 + 70.
      254           assign
      255             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      256             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      257             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      258           .
      259         end.
      260       end.
      261       B-viewProcInfo:visible   in frame waitfram = no.
      262       B-viewProcInfo:sensitive in frame waitfram = no.
      263       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      264       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      265       if  (   mWaitFramView
      266          or  mWaitProcEvent)
      267          and not mBatchMode
      268       then
      269          display
      270             v-waitfram-action01 skip
      271             v-waitfram-action02 skip
      272             v-waitfram-action03 skip
      273          with frame waitfram .
      274       if     mWaitFramView
      275          then do:
      276             if     mWaitFramInterval ne ?
      277                and not mBatchMode
      278             then
      279                wait-for go of frame waitfram pause mWaitFramInterval.
      280          end.
      281          else
      282             if     mWaitProcEvent
      283                and not mBatchMode
      284             then
      285                process events .
      286     end.
      287   end procedure.
      288      procedure waitfram-show-this:
      289         define input  parameter iInterval as int64 no-undo.
      290         define variable vtime as int64 no-undo.
      291         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      292         mWaitFramInterval = iInterval.
      293         run waitfram-show (substitute("&1&2 &3&4" ,
      294                                       mWaitFramTextBeg ,
      295                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      296                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      297                                       mWaitFramTextEnd
      298                                      )
      299                           ).
      300      end.
      301      procedure WaitFramRunPause:
      302         define input  parameter iInterval as dec no-undo.
      303         define variable vStart  as datetime-tz no-undo.
      304         define variable vend    as datetime-tz no-undo.
      305         define variable vint as int64 no-undo.
      306         define variable vOk as logical no-undo.
      307         vStart = now.
      308         vend   = vStart.
      309         publish "WaitFramPause" (iInterval,output vOk).
      310         vend   =  now.
      311         vint = vend - vStart.
      312         vint = iInterval - vint / 1000.
      313         if     not mWaitFramStop
      314            and (   vint > 0
      315                 or (    not vOk
      316                     and iInterval eq ?
      317                     )
      318                 )
      319         then
      320            run waitfram-show-this (iInterval).
      321         vend   =  now.
      322         vint = vend - vStart.
      323         vint = iInterval - vint / 1000.
      324         if     not mWaitFramStop
      325            and vint > 0
      326         then do:
      327            run gbl/pause.p (vint * 1000).
      328         end.
      329         if iInterval ne ?
      330         then
      331            publish "WaitFramStop".
      332         waitfram-check-timeout().
      333      end.
      334      procedure WaitFramWaitFor:
      335         define input  parameter iInterval as dec no-undo.
      336         assign
      337            mWaitFramStartProc   = now
      338            mWaitFramStopUser    = no
      339            mWaitFramStopTimeOut = no
      340         .
      341         block-wait:
      342         do while not mWaitFramStop:
      343            run WaitFramRunPause (iInterval).
      344            if  waitfram-check-timeout()
      345            then do:
      346               leave block-wait.
      347            end.
      348         end.
      349         run waitfram-hide.
      350      end.
      351   procedure waitfram-join :
      352     define input  parameter p-line-1  as character no-undo .
      353     define input  parameter p-line-2  as character no-undo .
      354     define input  parameter p-line-3  as character no-undo .
      355     define output parameter p-message as character no-undo .
      356     do
      357     on error undo, return error return-value
      358     :
      359       assign
      360         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      361                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      362                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      363       .
      364     end.
      365   end procedure.
      366   function waitfram-join-function returns character
      367     (input p-line-1 as character
      368     ,input p-line-2 as character
      369     ,input p-line-3 as character
      370     ).
      371     define variable v-message as character no-undo .
      372     run waitfram-join in this-procedure
      373       (input  p-line-1
      374       ,input  p-line-2
      375       ,input  p-line-3
      376       ,output v-message
      377       ) .
      378     return v-message .
      379   end function .
      380   define variable  v-des               like ub.dis-time-rule.des               no-undo .
      381   define variable v-upper-time-rule-num    like ub.dis-time-rule.upper-time-rule-num    no-undo .
      382   define variable v-value-type        like ub.dis-time-rule.value-type        no-undo .
      383   define variable vt-level-1 as character no-undo .
      384   define variable vt-level-2 as character no-undo .
      385   define variable v-output-display    as logical   no-undo .
      386   define variable v-tree              as character no-undo .
      387   define variable v-other             as character no-undo .
      388   define variable v-entry             as character no-undo .
      389   define variable ii as integer no-undo .
      390   define variable v-found as logical no-undo .
      391   define variable v-db-num like ub.db.db-num  no-undo .
      392   define variable v-ret-mess as character no-undo .
      393   define buffer buf_db for ub.db.
      394   define buffer buf_dis-rule for ub.dis-rule.
      395   define buffer buf2_dis-time-rule for ub.dis-time-rule.
      396   do
      397   on error undo, return error
      398   :
      399     if not p-sts-mode and buf_dis-time-rule.time-rule-num <= 99999
      400     then do:
      401       run err-mess(substitute("Нельзя удалять запись ШАБЛОНОВ РАСПИСАНИЙ"), output v-ret-mess).
      402       undo, return error (if p-silent then v-ret-mess else "time-rule-num":U).
      403     end.
      404     if buf_dis-time-rule.upper-time-rule-num > 99999 then do:
      405       run err-mess(substitute("Нельзя удалять или выключать детализированную запись РАСИСАНИЯ"), output v-ret-mess).
      406       undo, return error (if p-silent then v-ret-mess else "rule-num":U).
      407     end.
      408     if g#db-num <> 0
      409     then do:
      410       run err-mess(substitute("Нельзя удалять или выключать запись РАСПИСАНИЯ в УБД:&1" +
      411                               "номер текущей БД &2"
      412                               , chr(10)
      413                               , g#db-num), output v-ret-mess).
      414       undo, return error (if p-silent then v-ret-mess else "host-code":U).
      415     end.
      416     run dtr-code  in this-procedure (
      417         input  buf_dis-time-rule.templ-rl-root
      418         ,output v-des
      419         ,output v-upper-time-rule-num
      420         ,output v-value-type
      421         ,output vt-level-1
      422         ,output vt-level-2
      423         ,output v-output-display
      424         ,output v-tree
      425         ,output v-other
      426                                   ) no-error .
      427     if error-status:error then do:
      428         run err-mess(substitute("Неверный номер шаблона для распиисания: &1, &2", buf_dis-time-rule.templ-rl-root, return-value), output v-ret-mess ).
      429         undo, return error (if p-silent then v-ret-mess else "rule-num":U).
      430     end.
      431     if not p-sts-mode then do:
      432       find first buf_db no-lock where
      433                 buf_db.db-num > 0 no-error.
      434       if available buf_db then do:
      435         run err-mess(substitute("Нельзя удалять глобальную запись ПРАВИЛА СКИДКИ или запись по фирме в системе с УБД"), output v-ret-mess).
      436         undo, return error (if p-silent then v-ret-mess else "":U).
      437       end.
      438     end.
      439     if p-sts-mode then return.
      440     run waitfram-show in this-procedure ("Ждите .. Проводится проверка возможности удаления правила" ).
      441       _dis-rule:
      442     for each buf_dis-rule no-lock where
      443             buf_dis-rule.time-rule-num = buf_dis-time-rule.time-rule-num:
      444       assign
      445       v-found = yes
      446       .
      447       leave _dis-rule.
      448     end.
      449     if v-found then do:
      450       run waitfram-hide in this-procedure .
      451       run err-mess(substitute("Нельзя удалять запись РАСПИСАНИЯ: &1" +
      452                               "с ней связано ПРАВИЛО СКИДОК №&2 &3"
      453                               , chr(10)
      454                               , buf_dis-rule.rule-num
      455                               , buf_dis-rule.des
      456                              )
      457                               , output v-ret-mess).
      458       undo, return error (if p-silent then v-ret-mess else "":U).
      459     end.
      460     run waitfram-hide in this-procedure .
      461     for each buf2_dis-time-rule where
      462             buf2_dis-time-rule.upper-time-rule-num = buf_dis-time-rule.time-rule-num
      463     on error undo, return error :
      464       delete buf2_dis-time-rule no-error .
      465       if error-status:error then do:
      466         run err-mess(substitute("Ошибка при удалении РАСПИСАНИЯ №&1: &2 &3", buf2_dis-time-rule.time-rule-num, error-status:get-message(1), return-value  ), output v-ret-mess).
      467         undo, return error (if p-silent then v-ret-mess else "":U).
      468       end.
      469     end.
      470     delete buf_dis-time-rule no-error.
      471     if error-status:error then do:
      472       run err-mess(substitute("Ошибка при удалении РАСПИСАНИЯ: &1 &2", error-status:get-message(1), return-value), output v-ret-mess).
      473       undo, return error (if p-silent then v-ret-mess else "":U).
      474     end.
      475   end.
      476   PROCEDURE err-mess:
      477     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
      478     define output parameter p-ret-mess as character no-undo .
      479     CASE p-silent:
      480       when yes then do:
      481         p-ret-mess = substitute("РАСПИСАНИЕ№&1:&2&3", buf_dis-time-rule.time-rule-num, chr(10), p-mess).
      482       end.
      483       otherwise do:
      484         message
      485         p-mess
      486         view-as alert-box error .
      487       end.
      488     end.
      489   END PROCEDURE.
