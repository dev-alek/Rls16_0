      765     if varoutvprbcl = "base":u then do:
      766       assign
      767         varcurclprice-base = out-vatp_gds-dtlcl.cur-base
      768         varcurclprice-rubl = out-vatp_gds-dtlcl.cur-base * ((out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl) / (out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base)).
      769     end.
      770     else do:
      771       assign
      772         varcurclprice-base = out-vatp_gds-dtlcl.cur-base / ((out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl) / (out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base))
      773         varcurclprice-rubl = out-vatp_gds-dtlcl.cur-base.
      774     end.
