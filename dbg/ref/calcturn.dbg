      716   end.
      717   assign
      718     varprice-base-conscl = varprice-base-conscl / varcons-qntycl
      719     varprice-rubl-conscl = varprice-rubl-conscl / varcons-qntycl.
      720   if varprice-base-conscl = ? then do:
