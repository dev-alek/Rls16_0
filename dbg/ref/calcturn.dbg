      727   end.
      728   assign
      729     varsum-base-factovpcl     = 0
      730     varslt-base-factovpcl     = 0
      731     varvat-base-factovpcl     = 0
      732     varvatcons-base-factovpcl = 0
      733     vardsc-base-factovpcl     = 0
      734     varsum-base-docovpcl      = 0
      735     varslt-base-docovpcl      = 0
      736     varvat-base-docovpcl      = 0
      737     varvatcons-base-docovpcl  = 0
      738     vardsc-base-docovpcl      = 0
      739     varsum-rubl-factovpcl     = 0
      740     varslt-rubl-factovpcl     = 0
      741     varvat-rubl-factovpcl     = 0
      742     varvatcons-rubl-factovpcl = 0
      743     vardsc-rubl-factovpcl     = 0
      744     varsum-rubl-docovpcl      = 0
      745     varslt-rubl-docovpcl      = 0
      746     varvat-rubl-docovpcl      = 0
      747     varvatcons-rubl-docovpcl  = 0
      748     vardsc-rubl-docovpcl      = 0.
      749   assign
      750     varis-one-gds-dtlcl = no.
      751   find first out-vatp_gds-dtlcl where out-vatp_gds-dtlcl.doc-code  = pardoc-code  and
      752                                        out-vatp_gds-dtlcl.artic     = parartic     and
      753                                        out-vatp_gds-dtlcl.prod-type = parprod-type and
      754                                        out-vatp_gds-dtlcl.prod-code = parprod-code no-lock no-error.
      755   if available out-vatp_gds-dtlcl then do:
      756     find first buf_out-vatp_gds-dtlcl where buf_out-vatp_gds-dtlcl.doc-code  =  pardoc-code                and
      757                                              buf_out-vatp_gds-dtlcl.artic     =  parartic                   and
      758                                              buf_out-vatp_gds-dtlcl.prod-type =  parprod-type               and
      759                                              buf_out-vatp_gds-dtlcl.prod-code =  parprod-code               and
      760                                              recid(buf_out-vatp_gds-dtlcl)    <> recid(out-vatp_gds-dtlcl) no-lock no-error.
      761     if not available buf_out-vatp_gds-dtlcl then do:
      762       assign
      763         varis-one-gds-dtlcl = yes.
