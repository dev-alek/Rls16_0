     2094   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2095   define variable v-waitfram-action01         as character   no-undo .
     2096   define variable v-waitfram-action02         as character   no-undo .
     2097   define variable v-waitfram-action03         as character   no-undo .
     2098   define variable mWaitFramTextBeg            as character   no-undo.
     2099   define variable mWaitFramTextEnd            as character   no-undo.
     2100   define variable mWaitFramView               as logical     no-undo.
     2101   define variable mWaitProcEvent              as logical     no-undo init yes.
     2102   define variable mWaitFramInterval           as integer     no-undo init 1 .
     2103   define variable mWaitFramStop               as logical     no-undo.
     2104   define variable mWaitFramStopUser           as logical     no-undo.
     2105   define variable mWaitFramStopTimeOut        as logical     no-undo.
     2106   define variable mWaitFramStartProc          as datetime-tz no-undo.
     2107   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     2108   define button B-WaitFramStop auto-end-key
     2109        label "Стоп"
     2110        size 10 by 1 tooltip "Остоновить процесс".
     2111   define button B-viewProcInfo
     2112        label "Информация"
     2113        size 15 by 1 tooltip "Информация о процесс".
     2114   define frame waitfram
     2115     v-waitfram-action01 format "x(72)" no-label skip
     2116     v-waitfram-action02 format "x(72)" no-label skip
     2117     v-waitfram-action03 format "x(72)" no-label skip
     2118     B-viewProcInfo
     2119     B-WaitFramStop at row 4 col 30
     2120     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2121     .
     2122   define new global shared variable mBatchMode as logical no-undo init ?.
     2123   define variable mFramBachModHandle as handle no-undo.
     2124   mFramBachModHandle = frame waitfram:handle.
     2125   define variable mFameOldVis as logical no-undo.
     2126   define variable mVisCUrentVin as logical no-undo.
     2127   if session:batch-mode
     2128   then
     2129      mBatchMode = yes.
     2130   if mBatchMode = ? then do:
     2131     mVisCUrentVin = current-window:visible.
     2132     mFameOldVis = mFramBachModHandle:visible.
     2133     mFramBachModHandle:visible  = yes.
     2134     mBatchMode = mFramBachModHandle:visible ne yes.
     2135     mFramBachModHandle:visible = mFameOldVis.
     2136     current-window:visible = mVisCUrentVin.
     2137   end.
     2138    if  log-manager:logfile-name ne ?
     2139     then DO:
     2140         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2141         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2142         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     2143     end.
     2144   on choose of B-WaitFramStop in frame waitfram
     2145   do:
     2146     mWaitFramStop = yes.
     2147     mWaitFramStopUser = yes.
     2148   end.
     2149   function waitfram-check-timeout returns logical():
     2150      define variable vtime as int64 no-undo.
     2151      if mWaitFramStopTimeOut
     2152      then
     2153         return yes.
     2154      vtime = ( now - mWaitFramStartProc ) / 1000 .
     2155      if     mWaitFramTimeOut ne ?
     2156         and mWaitFramTimeOut ne 0
     2157         and mWaitFramTimeOut lt vtime
     2158      then do:
     2159         mWaitFramStopTimeOut = yes.
     2160      end.
     2161      return mWaitFramStopTimeOut.
     2162   end.
     2163   procedure waitfram-hide :
     2164     if not session:batch-mode
     2165     then do
     2166     on error undo, return error return-value
     2167     :
     2168       pause 0 before-hide .
     2169       if not mBatchMode then
     2170         hide frame waitfram .
     2171     if     not mWaitFramView
     2172        and mWaitProcEvent
     2173     then
     2174       process events .
     2175     end.
     2176   end procedure.
     2177   procedure waitfram-show :
     2178     define input  parameter p-message as character no-undo .
     2179     define variable v-left-margin as integer   no-undo .
     2180     if not session:batch-mode
     2181     then do
     2182     on error undo, return error return-value
     2183     :
     2184       if length(p-message) <= 70 then do:
     2185         assign
     2186           v-left-margin = integer((70 - length(p-message)) / 2)
     2187         .
     2188         assign
     2189           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     2190         .
     2191         assign
     2192           v-waitfram-action01 = " "
     2193           v-waitfram-action02 = " "
     2194                                    + fill(" ", v-left-margin)
     2195                                    + p-message
     2196           v-waitfram-action03 = " "
     2197         .
     2198       end.
     2199       else do:
     2200         define variable vRindex1 as integer no-undo.
     2201         define variable vRindex2 as integer no-undo.
     2202         vRindex1 = r-index(p-message," ",70).
     2203         if vRindex1 = 0
     2204         then
     2205            vRindex1 = 70.
     2206         if length(p-message)  <= vRindex1 + 70 then do:
     2207           assign
     2208             v-waitfram-action01 = " "
     2209             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     2210             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     2211           .
     2212         end.
     2213         else do:
     2214           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     2215           if vRindex2 <= vRindex1
     2216           then
     2217              vRindex2 = vRindex1 + 70.
     2218           assign
     2219             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     2220             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     2221             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     2222           .
     2223         end.
     2224       end.
     2225       B-viewProcInfo:visible   in frame waitfram = no.
     2226       B-viewProcInfo:sensitive in frame waitfram = no.
     2227       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2228       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2229       if  (   mWaitFramView
     2230          or  mWaitProcEvent)
     2231          and not mBatchMode
     2232       then
     2233          display
     2234             v-waitfram-action01 skip
     2235             v-waitfram-action02 skip
     2236             v-waitfram-action03 skip
     2237          with frame waitfram .
     2238       if     mWaitFramView
     2239          then do:
     2240             if     mWaitFramInterval ne ?
     2241                and not mBatchMode
     2242             then
     2243                wait-for go of frame waitfram pause mWaitFramInterval.
     2244          end.
     2245          else
     2246             if     mWaitProcEvent
     2247                and not mBatchMode
     2248             then
     2249                process events .
     2250     end.
     2251   end procedure.
     2252      procedure waitfram-show-this:
     2253         define input  parameter iInterval as int64 no-undo.
     2254         define variable vtime as int64 no-undo.
     2255         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2256         mWaitFramInterval = iInterval.
     2257         run waitfram-show (substitute("&1&2 &3&4" ,
     2258                                       mWaitFramTextBeg ,
     2259                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2260                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2261                                       mWaitFramTextEnd
     2262                                      )
     2263                           ).
     2264      end.
     2265      procedure WaitFramRunPause:
     2266         define input  parameter iInterval as dec no-undo.
     2267         define variable vStart  as datetime-tz no-undo.
     2268         define variable vend    as datetime-tz no-undo.
     2269         define variable vint as int64 no-undo.
     2270         define variable vOk as logical no-undo.
     2271         vStart = now.
     2272         vend   = vStart.
     2273         publish "WaitFramPause" (iInterval,output vOk).
     2274         vend   =  now.
     2275         vint = vend - vStart.
     2276         vint = iInterval - vint / 1000.
     2277         if     not mWaitFramStop
     2278            and (   vint > 0
     2279                 or (    not vOk
     2280                     and iInterval eq ?
     2281                     )
     2282                 )
     2283         then
     2284            run waitfram-show-this (iInterval).
     2285         vend   =  now.
     2286         vint = vend - vStart.
     2287         vint = iInterval - vint / 1000.
     2288         if     not mWaitFramStop
     2289            and vint > 0
     2290         then do:
     2291            run gbl/pause.p (vint * 1000).
     2292         end.
     2293         if iInterval ne ?
     2294         then
     2295            publish "WaitFramStop".
     2296         waitfram-check-timeout().
     2297      end.
     2298      procedure WaitFramWaitFor:
     2299         define input  parameter iInterval as dec no-undo.
     2300         assign
     2301            mWaitFramStartProc   = now
     2302            mWaitFramStopUser    = no
     2303            mWaitFramStopTimeOut = no
     2304         .
     2305         block-wait:
     2306         do while not mWaitFramStop:
     2307            run WaitFramRunPause (iInterval).
     2308            if  waitfram-check-timeout()
     2309            then do:
     2310               leave block-wait.
     2311            end.
     2312         end.
     2313         run waitfram-hide.
     2314      end.
     2315   procedure waitfram-join :
     2316     define input  parameter p-line-1  as character no-undo .
     2317     define input  parameter p-line-2  as character no-undo .
     2318     define input  parameter p-line-3  as character no-undo .
     2319     define output parameter p-message as character no-undo .
     2320     do
     2321     on error undo, return error return-value
     2322     :
     2323       assign
     2324         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2325                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2326                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2327       .
     2328     end.
     2329   end procedure.
     2330   function waitfram-join-function returns character
     2331     (input p-line-1 as character
     2332     ,input p-line-2 as character
     2333     ,input p-line-3 as character
     2334     ).
     2335     define variable v-message as character no-undo .
     2336     run waitfram-join in this-procedure
     2337       (input  p-line-1
     2338       ,input  p-line-2
     2339       ,input  p-line-3
     2340       ,output v-message
     2341       ) .
     2342     return v-message .
     2343   end function .
     2344   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2345   def
     2346   new shared
     2347   temp-table  obj-list no-undo
     2348     field obj-type like ub.clients.obj-type
     2349     field obj-code like ub.clients.obj-code
     2350     field obj-name like ub.clients.obj-name
     2351     field obj-id   as integer
     2352     field db-num   as integer
     2353     index pi is primary unique obj-id
     2354     index ie1 obj-type obj-code
     2355     index ie2 obj-name
     2356   .
     2357   procedure create_obj-list :
     2358      define input parameter p-obj-type like ub.clients.obj-type no-undo .
     2359      define input parameter p-obj-code like ub.clients.obj-code no-undo .
     2360      do
     2361      on error undo, return error return-value
     2362      :
     2363         define buffer cli-obj for ub.clients .
     2364         define variable p-var as integer no-undo .
     2365         define buffer buf_obj-list for obj-list .
     2366         find last buf_obj-list  use-index pi no-error .
     2367         if available buf_obj-list
     2368         then
     2369            p-var = buf_obj-list.obj-id + 1.
     2370         else
     2371            p-var = 1.
     2372         find first cli-obj where
     2373                   cli-obj.obj-type = p-obj-type
     2374               and cli-obj.obj-code = p-obj-code
     2375         no-lock no-error.
     2376         if available cli-obj
     2377         then do:
     2378            create buf_obj-list.
     2379            assign
     2380               buf_obj-list.obj-id   = p-var
     2381               buf_obj-list.obj-code = cli-obj.obj-code
     2382               buf_obj-list.obj-type = cli-obj.obj-type
     2383               buf_obj-list.obj-name = cli-obj.obj-name
     2384               buf_obj-list.db-num   = cli-obj.db-num
     2385            .
     2386         end.
     2387      end.
     2388   end.
     2389   run waitfram-show ( "Ждите..." ) .
     2390   define buffer buf_trn-doc for ub.trn-doc  .
     2391   define buffer buf_clients for ub.clients  .
     2392     define variable v-use-grp-buy           as logical   no-undo .
     2393     define variable v-use-oborot-buy        as logical   no-undo .
     2394     define variable v-use-qnty-group        as logical   no-undo .
     2395     define variable v-use-sum-group         as logical   no-undo .
     2396     define variable v-use-add-code          as logical   no-undo .
     2397     define variable v-use-sys-date-time     as logical   no-undo .
     2398     define variable v-use-shift-date-num    as logical   no-undo .
     2399     define variable v-use-cassa             as logical   no-undo .
     2400     define variable v-use-val               as logical   no-undo .
     2401     define variable v-use-pay-type          as logical   no-undo .
     2402     define variable v-use-cash-pay          as logical   no-undo .
     2403     define variable v-use-child as logical   no-undo .
     2404   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2405   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run glstall in g#library
     2406   (  output v-use-grp-buy
     2407    , output v-use-oborot-buy
     2408    , output v-use-qnty-group
     2409    , output v-use-sum-group
     2410    , output v-use-add-code
     2411    , output v-use-sys-date-time
     2412    , output v-use-shift-date-num
     2413    , output v-use-cassa
     2414    , output v-use-val
     2415    , output v-use-pay-type
     2416    , output v-use-cash-pay
     2417    , output v-use-child
     2418           )  .
     2419   if not ( v-use-grp-buy or v-use-oborot-buy )  then return .
     2420   find buf_clients no-lock where
     2421        buf_clients.obj-code = p-cli-code and
     2422        buf_clients.obj-type = p-cli-type no-error .
     2423   if not buf_clients.turnover-buyer then return .
     2424   define buffer obj_clients for ub.clients  .
     2425   define buffer buf_chk-doc for ub.chk-doc  .
     2426   define buffer buf_sysconf for ub.sysconf  .
     2427   for each buf_sysconf no-lock :
     2428       for each buf_trn-doc no-lock  where
     2429                buf_trn-doc.status_   = 'факт':U and
     2430                buf_trn-doc.host-code = buf_sysconf.host-code and
     2431                buf_trn-doc.cli-type  = buf_clients.obj-type and
     2432                buf_trn-doc.cli-code  = buf_clients.obj-code
     2433                :
     2434                run waitfram-show ( buf_trn-doc.doc-code  ) .
     2435                run case-type.
     2436       end.
     2437     end.
     2438   run waitfram-show ( "Подсчет нарастающего итога..."  ) .
     2439   define variable   v-sum-acc-base       as decimal   no-undo init 0 .
     2440   define variable   v-sum-acc-rubl       as decimal   no-undo init 0 .
     2441   define variable   v-sum-doc-base       as decimal   no-undo init 0 .
     2442   define variable   v-sum-doc-rubl       as decimal   no-undo init 0 .
     2443   define variable   v-sum-slt-acc-base   as decimal   no-undo init 0 .
     2444   define variable   v-sum-slt-acc-rubl   as decimal   no-undo init 0 .
     2445   define variable   v-sum-slt-doc-base   as decimal   no-undo init 0 .
     2446   define variable   v-sum-slt-doc-rubl   as decimal   no-undo init 0 .
     2447   define variable   v-sum-vat-acc-base   as decimal   no-undo init 0 .
     2448   define variable   v-sum-vat-acc-rubl   as decimal   no-undo init 0 .
     2449   define variable   v-sum-vat-doc-base   as decimal   no-undo init 0 .
     2450   define variable   v-sum-vat-doc-rubl   as decimal   no-undo init 0 .
     2451   define variable   v-sum-qnty-doc       as decimal   no-undo init 0 .
     2452   define variable   v-sum-qnty-check     as decimal   no-undo init 0 .
     2453   for each obj-list :
     2454       assign
     2455       v-sum-acc-base      = 0
     2456       v-sum-acc-rubl      = 0
     2457       v-sum-doc-base      = 0
     2458       v-sum-doc-rubl      = 0
     2459       v-sum-slt-acc-base  = 0
     2460       v-sum-slt-acc-rubl  = 0
     2461       v-sum-slt-doc-base  = 0
     2462       v-sum-slt-doc-rubl  = 0
     2463       v-sum-vat-acc-base  = 0
     2464       v-sum-vat-acc-rubl  = 0
     2465       v-sum-vat-doc-base  = 0
     2466       v-sum-vat-doc-rubl  = 0
     2467       v-sum-qnty-doc      = 0
     2468       v-sum-qnty-check    = 0
     2469       .
     2470       for each ub.turnover-buyer exclusive-lock where
     2471               ub.turnover-buyer.cli-type  = buf_clients.obj-type and
     2472               ub.turnover-buyer.cli-code  = buf_clients.obj-code and
     2473               ub.turnover-buyer.obj-type  = obj-list.obj-type and
     2474               ub.turnover-buyer.obj-code  = obj-list.obj-code
     2475               by ub.turnover-buyer.fact-order
     2476               :
     2477         assign
     2478           v-sum-acc-base     =  v-sum-acc-base     +  ub.turnover-buyer.sum-acc-base
     2479           v-sum-acc-rubl     =  v-sum-acc-rubl     +  ub.turnover-buyer.sum-acc-rubl
     2480           v-sum-doc-base     =  v-sum-doc-base     +  ub.turnover-buyer.sum-doc-base
     2481           v-sum-doc-rubl     =  v-sum-doc-rubl     +  ub.turnover-buyer.sum-doc-rubl
     2482           v-sum-slt-acc-base =  v-sum-slt-acc-base +  ub.turnover-buyer.sum-slt-acc-base
     2483           v-sum-slt-acc-rubl =  v-sum-slt-acc-rubl +  ub.turnover-buyer.sum-slt-acc-rubl
     2484           v-sum-slt-doc-base =  v-sum-slt-doc-base +  ub.turnover-buyer.sum-slt-doc-base
     2485           v-sum-slt-doc-rubl =  v-sum-slt-doc-rubl +  ub.turnover-buyer.sum-slt-doc-rubl
     2486           v-sum-vat-acc-base =  v-sum-vat-acc-base +  ub.turnover-buyer.sum-vat-acc-base
     2487           v-sum-vat-acc-rubl =  v-sum-vat-acc-rubl +  ub.turnover-buyer.sum-vat-acc-rubl
     2488           v-sum-vat-doc-base =  v-sum-vat-doc-base +  ub.turnover-buyer.sum-vat-doc-base
     2489           v-sum-vat-doc-rubl =  v-sum-vat-doc-rubl +  ub.turnover-buyer.sum-vat-doc-rubl
     2490           .
     2491           if ub.turnover-buyer.doc-code   <> "" then v-sum-qnty-doc = v-sum-qnty-doc + 1.
     2492           if ub.turnover-buyer.inkas-code <> "" then v-sum-qnty-check = v-sum-qnty-check + 1.
     2493         assign
     2494           ub.turnover-buyer.sum-acc-base-itog      = v-sum-acc-base
     2495           ub.turnover-buyer.sum-acc-rubl-itog      = v-sum-acc-rubl
     2496           ub.turnover-buyer.sum-doc-base-itog      = v-sum-doc-base
     2497           ub.turnover-buyer.sum-doc-rubl-itog      = v-sum-doc-rubl
     2498           ub.turnover-buyer.sum-slt-acc-base-itog  = v-sum-slt-acc-base
     2499           ub.turnover-buyer.sum-slt-acc-rubl-itog  = v-sum-slt-acc-rubl
     2500           ub.turnover-buyer.sum-slt-doc-base-itog  = v-sum-slt-doc-base
     2501           ub.turnover-buyer.sum-slt-doc-rubl-itog  = v-sum-slt-doc-rubl
     2502           ub.turnover-buyer.sum-vat-acc-base-itog  = v-sum-vat-acc-base
     2503           ub.turnover-buyer.sum-vat-acc-rubl-itog  = v-sum-vat-acc-rubl
     2504           ub.turnover-buyer.sum-vat-doc-base-itog  = v-sum-vat-doc-base
     2505           ub.turnover-buyer.sum-vat-doc-rubl-itog  = v-sum-vat-doc-rubl
     2506           ub.turnover-buyer.qnty-doc-itog          = v-sum-qnty-doc
     2507           ub.turnover-buyer.qnty-check-itog        = v-sum-qnty-check
     2508           .
     2509       end.
     2510         find first ub.turnover-buyer-main exclusive-lock where
     2511                     ub.turnover-buyer-main.cli-code     = buf_clients.obj-code and
     2512                     ub.turnover-buyer-main.cli-type     = buf_clients.obj-type and
     2513                     ub.turnover-buyer-main.obj-code     = obj-list.obj-code    and
     2514                     ub.turnover-buyer-main.obj-type     = obj-list.obj-type    no-error .
     2515         if not available ub.turnover-buyer-main then create ub.turnover-buyer-main .
     2516         assign
     2517         ub.turnover-buyer-main.cli-code     = buf_clients.obj-code
     2518         ub.turnover-buyer-main.cli-type     = buf_clients.obj-type
     2519         ub.turnover-buyer-main.obj-code     = obj-list.obj-code
     2520         ub.turnover-buyer-main.obj-type     = obj-list.obj-type
     2521         ub.turnover-buyer-main.des          = ""
     2522         ub.turnover-buyer-main.sum-acc-base-itog     =  v-sum-acc-base
     2523         ub.turnover-buyer-main.sum-acc-rubl-itog     =  v-sum-acc-rubl
     2524         ub.turnover-buyer-main.sum-doc-base-itog     =  v-sum-doc-base
     2525         ub.turnover-buyer-main.sum-doc-rubl-itog     =  v-sum-doc-rubl
     2526         ub.turnover-buyer-main.qnty-doc-itog   = v-sum-qnty-doc
     2527         ub.turnover-buyer-main.qnty-check-itog = v-sum-qnty-check
     2528         .
     2529   end.
     2530     for each buf_sysconf no-lock :
     2531     for each obj_clients no-lock where
     2532              obj_clients.host-code = buf_sysconf.host-code
     2533              :
     2534       run waitfram-show ( "По чекам  по фирмы " + string (obj_clients.host-code)  ) .
     2535       for each buf_trn-doc no-lock  where
     2536                buf_trn-doc.status_      = 'факт':U   and
     2537                buf_trn-doc.ext-doc-type = 'es':U and
     2538                buf_trn-doc.doc-type = 'рас':U and
     2539                buf_trn-doc.internal = false      and
     2540                buf_trn-doc.obj-type = obj_clients.obj-type and
     2541                buf_trn-doc.obj-code = obj_clients.obj-code ,
     2542                each buf_chk-doc no-lock where
     2543                     buf_chk-doc.out-code  = buf_trn-doc.doc-code and
     2544                     buf_chk-doc.cli-type  = buf_clients.obj-type and
     2545                     buf_chk-doc.cli-code  = buf_clients.obj-code
     2546                     :
     2547                     run ref/calctur4.p ( buf_chk-doc.doc-code ) .
     2548       end.
     2549     end.
     2550   end.
     2551   run waitfram-hide .
     2552   procedure case-type :
     2553     do
     2554     on error undo, return error return-value
     2555     :
     2556   define variable   v-sum-acc-base       as decimal   no-undo init 0 .
     2557   define variable   v-sum-acc-rubl       as decimal   no-undo init 0 .
     2558   define variable   v-sum-doc-base       as decimal   no-undo init 0 .
     2559   define variable   v-sum-doc-rubl       as decimal   no-undo init 0 .
     2560   define variable   v-sum-slt-acc-base   as decimal   no-undo init 0 .
     2561   define variable   v-sum-slt-acc-rubl   as decimal   no-undo init 0 .
     2562   define variable   v-sum-slt-doc-base   as decimal   no-undo init 0 .
     2563   define variable   v-sum-slt-doc-rubl   as decimal   no-undo init 0 .
     2564   define variable   v-sum-vat-acc-base   as decimal   no-undo init 0 .
     2565   define variable   v-sum-vat-acc-rubl   as decimal   no-undo init 0 .
     2566   define variable   v-sum-vat-doc-base   as decimal   no-undo init 0 .
     2567   define variable   v-sum-vat-doc-rubl   as decimal   no-undo init 0 .
     2568   define variable   v-acc-base       as decimal   no-undo init 0 .
     2569   define variable   v-acc-rubl       as decimal   no-undo init 0 .
     2570   define variable   v-doc-base       as decimal   no-undo init 0 .
     2571   define variable   v-doc-rubl       as decimal   no-undo init 0 .
     2572   define variable   v-slt-acc-base   as decimal   no-undo init 0 .
     2573   define variable   v-slt-acc-rubl   as decimal   no-undo init 0 .
     2574   define variable   v-slt-doc-base   as decimal   no-undo init 0 .
     2575   define variable   v-slt-doc-rubl   as decimal   no-undo init 0 .
     2576   define variable   v-vat-acc-base   as decimal   no-undo init 0 .
     2577   define variable   v-vat-acc-rubl   as decimal   no-undo init 0 .
     2578   define variable   v-vat-doc-base   as decimal   no-undo init 0 .
     2579   define variable   v-vat-doc-rubl   as decimal   no-undo init 0 .
     2580   define variable v-sign as integer   no-undo .
     2581   define buffer buf_goods for ub.goods  .
     2582   define buffer buf_doc-line for ub.doc-line  .
     2583    for each buf_doc-line no-lock
     2584       where buf_doc-line.doc-code = buf_trn-doc.doc-code  :
     2585       run clcprtsl_calc-line in this-procedure ( input recid( buf_doc-line ) ).
     2586       find first tt-allsum-line
     2587            where tt-allsum-line.sum-type = 'основная_сумма':U
     2588       no-error.
     2589       if not available tt-allsum-line then next.
     2590           assign
     2591             v-acc-base      = tt-allsum-line.sum-dsc-base-acc
     2592             v-acc-rubl      = tt-allsum-line.sum-dsc-rubl-acc
     2593             v-doc-base      = tt-allsum-line.sum-dsc-base-doc
     2594             v-doc-rubl      = tt-allsum-line.sum-dsc-rubl-doc
     2595             v-slt-acc-base  = tt-allsum-line.slt-base-acc
     2596             v-slt-acc-rubl  = tt-allsum-line.slt-rubl-acc
     2597             v-slt-doc-base  = tt-allsum-line.slt-base-doc
     2598             v-slt-doc-rubl  = tt-allsum-line.slt-rubl-doc
     2599             v-vat-acc-base  = tt-allsum-line.vat-base-acc
     2600             v-vat-acc-rubl  = tt-allsum-line.vat-rubl-acc
     2601             v-vat-doc-base  = tt-allsum-line.vat-base-doc
     2602             v-vat-doc-rubl  = tt-allsum-line.vat-rubl-doc
     2603          .
     2604       assign
     2605       v-sum-acc-base     =  v-sum-acc-base     +  v-acc-base
     2606       v-sum-acc-rubl     =  v-sum-acc-rubl     +  v-acc-rubl
     2607       v-sum-doc-base     =  v-sum-doc-base     +  v-doc-base
     2608       v-sum-doc-rubl     =  v-sum-doc-rubl     +  v-doc-rubl
     2609       v-sum-slt-acc-base =  v-sum-slt-acc-base +  v-slt-acc-base
     2610       v-sum-slt-acc-rubl =  v-sum-slt-acc-rubl +  v-slt-acc-rubl
     2611       v-sum-slt-doc-base =  v-sum-slt-doc-base +  v-slt-doc-base
     2612       v-sum-slt-doc-rubl =  v-sum-slt-doc-rubl +  v-slt-doc-rubl
     2613       v-sum-vat-acc-base =  v-sum-vat-acc-base +  v-vat-acc-base
     2614       v-sum-vat-acc-rubl =  v-sum-vat-acc-rubl +  v-vat-acc-rubl
     2615       v-sum-vat-doc-base =  v-sum-vat-doc-base +  v-vat-doc-base
     2616       v-sum-vat-doc-rubl =  v-sum-vat-doc-rubl +  v-vat-doc-rubl
     2617       .
     2618      if buf_clients.turnover-buyer-gds then do :
     2619         find first buf_goods no-lock where
     2620                    buf_goods.artic = buf_doc-line.artic         and
     2621                    buf_goods.prod-type = buf_doc-line.prod-type and
     2622                    buf_goods.prod-code = buf_doc-line.prod-code no-error  .
     2623     if  buf_trn-doc.ext-doc-type =  'ee':U or
     2624         buf_trn-doc.ext-doc-type =  're':U
     2625     then do:
     2626         if buf_trn-doc.ext-doc-type =  're':U then v-sign = (-1) .
     2627           else v-sign = 1 .
     2628         create ub.turnover-buyer-gds .
     2629         assign
     2630         ub.turnover-buyer-gds.gds-code     = buf_goods.gds-code
     2631         ub.turnover-buyer-gds.cli-code     = buf_trn-doc.cli-code
     2632         ub.turnover-buyer-gds.cli-type     = buf_trn-doc.cli-type
     2633         ub.turnover-buyer-gds.d-card       = ""
     2634         ub.turnover-buyer-gds.des          = ""
     2635         ub.turnover-buyer-gds.doc-code     = buf_trn-doc.doc-code
     2636         ub.turnover-buyer-gds.ext-doc-type = buf_trn-doc.ext-doc-type
     2637         ub.turnover-buyer-gds.fact-date    = buf_trn-doc.fact-date
     2638         ub.turnover-buyer-gds.fact-order   = buf_trn-doc.fact-order
     2639         ub.turnover-buyer-gds.inkas-code   = ""
     2640         ub.turnover-buyer-gds.obj-code     = buf_trn-doc.obj-code
     2641         ub.turnover-buyer-gds.obj-type     = buf_trn-doc.obj-type
     2642         ub.turnover-buyer-gds.shift-date       = buf_trn-doc.shift-date
     2643         ub.turnover-buyer-gds.shift-num        = buf_trn-doc.shift-num
     2644         ub.turnover-buyer-gds.shift-name       = buf_trn-doc.shift-name
     2645         ub.turnover-buyer-gds.sum-acc-base     =  v-acc-base
     2646         ub.turnover-buyer-gds.sum-acc-rubl     =  v-acc-rubl
     2647         ub.turnover-buyer-gds.sum-doc-base     =  v-doc-base
     2648         ub.turnover-buyer-gds.sum-doc-rubl     =  v-doc-rubl
     2649         ub.turnover-buyer-gds.sum-slt-acc-base = v-sign * v-slt-acc-base
     2650         ub.turnover-buyer-gds.sum-slt-acc-rubl = v-sign * v-slt-acc-rubl
     2651         ub.turnover-buyer-gds.sum-slt-doc-base = v-sign * v-slt-doc-base
     2652         ub.turnover-buyer-gds.sum-slt-doc-rubl = v-sign * v-slt-doc-rubl
     2653         ub.turnover-buyer-gds.sum-vat-acc-base = v-sign * v-vat-acc-base
     2654         ub.turnover-buyer-gds.sum-vat-acc-rubl = v-sign * v-vat-acc-rubl
     2655         ub.turnover-buyer-gds.sum-vat-doc-base = v-sign * v-vat-doc-base
     2656         ub.turnover-buyer-gds.sum-vat-doc-rubl = v-sign * v-vat-doc-rubl
     2657         ub.turnover-buyer-gds.sum-type         = ""
     2658         ub.turnover-buyer-gds.sys-date         = today
     2659         ub.turnover-buyer-gds.sys-time         = time
     2660         ub.turnover-buyer-gds.sys-time-char    = string(ub.turnover-buyer-gds.sys-time,"hh:mm")
     2661         ub.turnover-buyer-gds.type             = 0
     2662         .
     2663         end.
     2664      end.
     2665    end.
     2666     case buf_trn-doc.ext-doc-type :
     2667         when 'ee':U  then do:
     2668           run create_tbl (
     2669               v-sum-acc-base     ,
     2670               v-sum-acc-rubl     ,
     2671               v-sum-doc-base     ,
     2672               v-sum-doc-rubl     ,
     2673               v-sum-slt-acc-base ,
     2674               v-sum-slt-acc-rubl ,
     2675               v-sum-slt-doc-base ,
     2676               v-sum-slt-doc-rubl ,
     2677               v-sum-vat-acc-base ,
     2678               v-sum-vat-acc-rubl ,
     2679               v-sum-vat-doc-base ,
     2680               v-sum-vat-doc-rubl  ).
     2681         end.
     2682         when 're':U  then do:
     2683           run create_tbl (
     2684               (-1) * v-sum-acc-base     ,
     2685               (-1) * v-sum-acc-rubl     ,
     2686               (-1) * v-sum-doc-base     ,
     2687               (-1) * v-sum-doc-rubl     ,
     2688               (-1) * v-sum-slt-acc-base ,
     2689               (-1) * v-sum-slt-acc-rubl ,
     2690               (-1) * v-sum-slt-doc-base ,
     2691               (-1) * v-sum-slt-doc-rubl ,
     2692               (-1) * v-sum-vat-acc-base ,
     2693               (-1) * v-sum-vat-acc-rubl ,
     2694               (-1) * v-sum-vat-doc-base ,
     2695               (-1) * v-sum-vat-doc-rubl  ).
     2696         end.
     2697     end case.
     2698     end.
     2699   end procedure.
     2700   procedure create_tbl  :
     2701     do
     2702     on error undo, return error return-value
     2703     :
     2704   define input  parameter v-sum-acc-base       as decimal   no-undo .
     2705   define input  parameter v-sum-acc-rubl       as decimal   no-undo .
     2706   define input  parameter v-sum-doc-base       as decimal   no-undo .
     2707   define input  parameter v-sum-doc-rubl       as decimal   no-undo .
     2708   define input  parameter v-sum-slt-acc-base   as decimal   no-undo .
     2709   define input  parameter v-sum-slt-acc-rubl   as decimal   no-undo .
     2710   define input  parameter v-sum-slt-doc-base   as decimal   no-undo .
     2711   define input  parameter v-sum-slt-doc-rubl   as decimal   no-undo .
     2712   define input  parameter v-sum-vat-acc-base   as decimal   no-undo .
     2713   define input  parameter v-sum-vat-acc-rubl   as decimal   no-undo .
     2714   define input  parameter v-sum-vat-doc-base   as decimal   no-undo .
     2715   define input  parameter v-sum-vat-doc-rubl   as decimal   no-undo .
     2716       create ub.turnover-buyer .
     2717       assign
     2718         ub.turnover-buyer.cli-code     = buf_trn-doc.cli-code
     2719         ub.turnover-buyer.cli-type     = buf_trn-doc.cli-type
     2720         ub.turnover-buyer.d-card       = ""
     2721         ub.turnover-buyer.des          = ""
     2722         ub.turnover-buyer.doc-code     = buf_trn-doc.doc-code
     2723         ub.turnover-buyer.ext-doc-type = buf_trn-doc.ext-doc-type
     2724         ub.turnover-buyer.fact-date    = buf_trn-doc.fact-date
     2725         ub.turnover-buyer.fact-order   = buf_trn-doc.fact-order
     2726         ub.turnover-buyer.inkas-code   = ""
     2727         ub.turnover-buyer.obj-code     = buf_trn-doc.obj-code
     2728         ub.turnover-buyer.obj-type     = buf_trn-doc.obj-type
     2729         ub.turnover-buyer.qnty-check       = 0
     2730         ub.turnover-buyer.qnty-doc-itog    = 1
     2731         ub.turnover-buyer.shift-date       = buf_trn-doc.shift-date
     2732         ub.turnover-buyer.shift-num        = buf_trn-doc.shift-num
     2733         ub.turnover-buyer.shift-name       = buf_trn-doc.shift-name
     2734         ub.turnover-buyer.sum-acc-base     =  v-sum-acc-base
     2735         ub.turnover-buyer.sum-acc-rubl     =  v-sum-acc-rubl
     2736         ub.turnover-buyer.sum-doc-base     =  v-sum-doc-base
     2737         ub.turnover-buyer.sum-doc-rubl     =  v-sum-doc-rubl
     2738         ub.turnover-buyer.sum-slt-acc-base =  v-sum-slt-acc-base
     2739         ub.turnover-buyer.sum-slt-acc-rubl =  v-sum-slt-acc-rubl
     2740         ub.turnover-buyer.sum-slt-doc-base =  v-sum-slt-doc-base
     2741         ub.turnover-buyer.sum-slt-doc-rubl =  v-sum-slt-doc-rubl
     2742         ub.turnover-buyer.sum-vat-acc-base =  v-sum-vat-acc-base
     2743         ub.turnover-buyer.sum-vat-acc-rubl =  v-sum-vat-acc-rubl
     2744         ub.turnover-buyer.sum-vat-doc-base =  v-sum-vat-doc-base
     2745         ub.turnover-buyer.sum-vat-doc-rubl =  v-sum-vat-doc-rubl
     2746         ub.turnover-buyer.sum-type         = ""
     2747         ub.turnover-buyer.sys-date         = today
     2748         ub.turnover-buyer.sys-time         = time
     2749         ub.turnover-buyer.sys-time-char    = string(ub.turnover-buyer.sys-time,"hh:mm")
     2750         ub.turnover-buyer.type             = 0
     2751       .
     2752     if not can-find (first obj-list where
     2753                     obj-list.obj-type = buf_trn-doc.obj-type and
     2754                     obj-list.obj-code = buf_trn-doc.obj-code   ) then
     2755      run create_obj-list ( buf_trn-doc.obj-type , buf_trn-doc.obj-code ).
     2756     end.
     2757   end procedure.
