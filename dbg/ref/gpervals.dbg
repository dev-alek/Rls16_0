      981     if error-status:error then return no-apply.
      982   END.
      983   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
      984   DO:
      985     define variable loc-doc-rec as recid no-undo .
      986   define variable v-rid-list as character no-undo.
