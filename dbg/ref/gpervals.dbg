      973     if error-status:error then do:                           find first pos_group-period-validity no-lock where                                   recid(pos_group-period-validity) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ГРУППЫ СРОКОВ ГОДНОСТИ" skip                            string(if avail pos_group-period-validity                                     then  substitute("Вн код группы сроков годности: &1"                                                     , pos_group-period-validity.gr-per-val-code)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
      974   end.
      975   apply "entry" to br-gperval in frame Dialog-Frame.
      976   apply "value-changed" to br-gperval in frame Dialog-Frame.
      977   END.
      978   ON CHOOSE OF B-del IN FRAME Dialog-Frame
