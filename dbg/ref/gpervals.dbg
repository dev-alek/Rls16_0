     2544       return error .
     2545     end.
     2546    if LOOKUP(p-mode, 'все':U,
     2547                   chr(4)) = 0
     2548        then dO:
     2549       message
     2550       vss-workfile vss-revision vss-description skip
     2551       "Неверное значение параметров вызова p-mode"
     2552       p-mode
     2553       view-as alert-box ERROR.
     2554       return error .
     2555    end.
     2556    v-rid-list = p-rid-list.
     2557   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2558   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2559     (output v-db-num
     2560     )  .
     2561     RUN MyEnable in this-procedure .
     2562     RUn OpenBR in this-procedure .
     2563     HIDE mark-num in frame Dialog-Frame .
     2564     if v-doc-rec <> ? then
     2565     REPOSITION br-gperval to recid v-doc-rec No-ERROR.
     2566   WAIT-FOR GO OF FRAME Dialog-Frame.
     2567   END.
     2568   RUN disable_UI.
     2569   PROCEDURE disable_UI :
     2570     HIDE FRAME Dialog-Frame.
     2571   END PROCEDURE.
     2572   PROCEDURE enable_UI :
     2573     DISPLAY RS-sts mark-num
     2574         WITH FRAME Dialog-Frame.
     2575     ENABLE b-quit B-mark B-sel B-add b-lkp B-chg B-del B-print B-hist B-Help
     2576            B-var-deliv-gr-per-val RS-sts BR-gperval mark-num
     2577         WITH FRAME Dialog-Frame.
     2578     VIEW FRAME Dialog-Frame.
     2579     OPEN QUERY BR-gperval FOR EACH X_group-period-validity NO-LOCK INDEXED-REPOSITION.
     2580   END PROCEDURE.
     2581   PROCEDURE MyENable :
     2582   ASSIGN
     2583   rs-sts:RADIO-BUTTONS IN FRAME Dialog-Frame
     2584                          = "Текущие&+" + chr(44) +  '0':U + chr(44) +
     2585                          "Все&!" + chr(44) + 'все':U + chr(44) +
     2586                           "Удаленные&-" + chr(44) + '1':U
     2587   rs-sts = (IF p-sts = ? THEN 'все':U ELSE string(p-sts))
     2588   .
     2589   DISPLAY mark-num
     2590   WITH FRAME Dialog-Frame.
     2591   ENABLE
     2592   b-quit
     2593   B-mark when LOOKUP("b-mark":U, bttns) > 0
     2594   B-sel when LOOKUP("b-sel":U, bttns) > 0
     2595   B-add when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     2596   b-lkp
     2597   B-chg when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     2598   B-del when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     2599   B-print
     2600   B-Help
     2601   B-hist
     2602   rs-sts
     2603   BR-gperval mark-num
     2604   B-var-deliv-gr-per-val
     2605   with FRAME Dialog-Frame.
     2606   VIEW FRAME Dialog-Frame.
     2607   END PROCEDURE.
     2608   PROCEDURE OpenBr :
     2609   define variable title0 as character no-undo init "Список групп сроков годности".
     2610   IF p-sts = ? THEN DO:
     2611       OPEN QUERY BR-gperval
     2612       FOR EACH X_group-period-validity NO-LOCK
     2613       INDEXED-REPOSITION.
     2614   END.
     2615   ELSE DO:
     2616       frame Dialog-Frame:TITLE = title0 + chr(32) + entry (lookup (STRING(p-sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U).
     2617       OPEN QUERY BR-gperval
     2618       FOR EACH X_group-period-validity NO-LOCK where
     2619       X_group-period-validity.sts = p-sts
     2620       INDEXED-REPOSITION.
     2621   END.
     2622   APPLY "VALUE-CHANGED" TO br-gperval in frame Dialog-Frame.
     2623   APPLY "ENTRY" TO br-gperval.
     2624   END PROCEDURE.
     2625   PROCEDURE proc-b-del :
     2626   define variable loc#log as logical no-undo.
     2627   define variable v-sts like ub.group-period-validity.sts no-undo .
     2628   DEFINE VARIABLE loc-doc-rec AS RECID NO-UNDO.
     2629   if not available X_group-period-validity then return error.
     2630   do
     2631   on error undo, return error
     2632   on stop undo, return error
     2633   :
     2634   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2635   do:
     2636     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2637       (input  v-cntxt-db-num
     2638       ,input  v-cntxt-userid
     2639       ,input  0
     2640       ,input  'actn_delivery-storage_work':U
     2641       ,input  'global':U
     2642       ,input  0
     2643       ,input  '':U
     2644       ,input  0
     2645       ,input  0
     2646       ,input  0
     2647       ,input  0
     2648       ,input  true
     2649       ,output loc#log
     2650       )  .
     2651   end.
     2652   if not loc#log then return error.
     2653     assign
     2654     v-sts = ?
     2655     loc-doc-rec = recid(X_group-period-validity)
     2656     .
     2657     run ref/gperval2.p (
     2658                     input recid(X_group-period-validity)
     2659                     ,input-output v-sts
     2660                    ) no-error .
     2661     if error-status:error then undo, return error.
     2662     RUN OpenBr in this-procedure .
     2663     REPOSITION br-gperval to recid loc-doc-rec No-error.
     2664     if error-status:error then do:                           find first pos_group-period-validity no-lock where                                   recid(pos_group-period-validity) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ГРУППЫ СРОКОВ ГОДНОСТИ" skip                            string(if avail pos_group-period-validity                                     then  substitute("Вн код группы сроков годности: &1"                                                     , pos_group-period-validity.gr-per-val-code)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     2665     if available X_group-period-validity then do:
     2666       loc#log = br-gperval:select-focused-row( ) IN FRAME Dialog-Frame.
     2667     end.
     2668     apply "ENTRY" to br-gperval.
     2669   end.
     2670   END PROCEDURE.
     2671   PROCEDURE proc-b-print :
     2672   define variable v-doc-rec as recid no-undo .
     2673   define variable accum-count as integer.
     2674   define variable date_string     as      char    no-undo.
     2675   define variable Line            as      char    no-undo.
     2676   DEFINE VARIABLE v-sts-chr AS CHARACTER NO-UNDO.
     2677   DEFINE FRAME group-period-validity-list
     2678   X_group-period-validity.gr-per-val-name
     2679   v-sts-chr FORMAT "X(8)" COLUMN-LABEL "Статус"
     2680   X_group-period-validity.des FORMAT "X(100)"
     2681   X_group-period-validity.gr-per-from
     2682   X_group-period-validity.gr-per-to
     2683   X_group-period-validity.gr-per-val-code COLUMN-LABEL "Вн.код!группы"
     2684   HEADER  date_string AT 5 format "X(35)"
     2685    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     2686   Line format "X(195)" AT 1
     2687   with width 232 down stream-io use-text    .
     2688   Line = fill("-", 195).
     2689   date_string = cur-time-print() .
     2690   run prn-lib-open-stream  in this-procedure (
     2691                                                input parParentProc
     2692                                               ,input 43
     2693                                               ,input yes
     2694                                               ,input no
     2695                                               ).
     2696   PUT  STREAM PrnLibStream
     2697   SPACE(25) ( frame Dialog-Frame:title )
     2698   format "x(90)" SKIP(1) .
     2699   FORM HEADER
     2700   Line format "X(195)" AT 1 SKIP
     2701   "Продолжение - на следующей странице" AT 30 SKIP
     2702   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2703   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     2704   FORM with FRAME group-period-validity-list  .
     2705   run waitfram-show in this-procedure ( input "Ждите...").
     2706   v-doc-rec = recid(X_group-period-validity).
     2707   DO WHILE available X_group-period-validity :
     2708     GET prev br-gperval.
     2709   END.
     2710   GET next br-gperval.
     2711   DO WHILE available X_group-period-validity :
     2712     Display STREAM PrnLibStream
     2713      X_group-period-validity.gr-per-val-name
     2714     entry (lookup (STRING(p-sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) @ v-sts-chr
     2715     X_group-period-validity.des
     2716     X_group-period-validity.gr-per-from
     2717     X_group-period-validity.gr-per-to
     2718     X_group-period-validity.gr-per-val-code
     2719   with FRAME group-period-validity-list .
     2720     DOWN STREAM PrnLibStream 1
     2721     with FRAME group-period-validity-list  .
     2722     assign
     2723     accum-count = accum-count + 1
     2724     .
     2725     GET next br-gperval.
     2726   END.
     2727   UNDERLINE  STREAM PrnLibStream
     2728   X_group-period-validity.gr-per-val-name
     2729   v-sts-chr
     2730   X_group-period-validity.des
     2731   X_group-period-validity.gr-per-from
     2732   X_group-period-validity.gr-per-to
     2733   X_group-period-validity.gr-per-val-code
     2734   with FRAME group-period-validity-list .
