     2755       end.
     2756       else do:
     2757           apply "choose" to b-sel in frame Dialog-Frame.
     2758       end.
     2759   end.
     2760   else do:
     2761       if b-lkp:sensitive then
     2762       apply "choose" to b-lkp in frame Dialog-Frame.
     2763   end.
     2764   END PROCEDURE.
