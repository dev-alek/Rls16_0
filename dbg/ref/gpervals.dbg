     2521   MAIN-BLOCK:
     2522   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2523      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2524   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2525     run mainmenu_getcntxt in parparentproc
     2526       (output v-cntxt-db-num
