     2362   procedure get-context :
     2363      define output parameter p-db-num as integer          no-undo.
     2364      define output parameter p-user-id as character        no-undo.
     2365      define variable v-login               as character    no-undo.
     2366      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2367      define buffer buf_user-login  for ub.user-login .
     2368      do
     2369      on error undo, return error
     2370      :
     2371            FIND FIRST buf_sys-ctrl no-lock.
     2372            ASSIGN
     2373               v-login = USERID("ub")
     2374               p-db-num = buf_sys-ctrl.db-num
     2375            .
     2376            FIND FIRST buf_user-login
     2377                 WHERE buf_user-login.db-num = p-db-num
     2378                   AND buf_user-login.user-login = v-login
     2379                 no-lock
     2380                 no-error
     2381                 .
     2382            IF AVAILABLE buf_user-login
     2383            THEN DO:
     2384               assign
     2385                  p-user-id = buf_user-login.user-id
     2386               .
     2387            END.
     2388      end.
     2389   end procedure.
     2390       run diasize_init in this-procedure .
     2391   def var sort-labelBR-gperval   as character no-undo .
     2392   def var sort-clmnBR-gperval    as handle    no-undo .
     2393   def var cur-clmnBR-gperval     as handle    no-undo .
     2394   def var cur-clmn-locBR-gperval as integer   no-undo .
     2395   def var re-queryBR-gperval     as logical   initial no no-undo .
     2396   on start-search, ctrl-o of BR-gperval in frame Dialog-Frame do:
     2397      run sort-brBR-gperval
     2398        (input (if available X_group-period-validity
     2399                then recid(X_group-period-validity)
     2400                else ?
     2401               )
     2402        ).
     2403   end.
     2404   PROCEDURE sort-brBR-gperval :
     2405     define input parameter p-recid as recid no-undo .
     2406     if re-queryBR-gperval = no then do:
     2407       assign
     2408          cur-clmnBR-gperval = BR-gperval:current-column in frame Dialog-Frame
     2409       .
     2410       if sort-clmnBR-gperval <> ? then sort-clmnBR-gperval:column-fgcolor = 0.
     2411       if cur-clmnBR-gperval = sort-clmnBR-gperval then do:
     2412         assign
     2413            sort-labelBR-gperval = ""
     2414            sort-clmnBR-gperval = ?
     2415         .
     2416        end.
     2417        else do:
     2418          assign
     2419            sort-labelBR-gperval = cur-clmnBR-gperval:label
     2420            sort-clmnBR-gperval  = cur-clmnBR-gperval
     2421            sort-clmnBR-gperval:column-fgcolor = 4
     2422          .
     2423        end.
     2424      end.
     2425     assign
     2426       cur-clmn-locBR-gperval = 1
     2427     .
     2428     def var column-handle as handle no-undo .
     2429     column-handle = BR-gperval:first-column.
     2430     do while valid-handle(column-handle) :
     2431       if column-handle = cur-clmnBR-gperval then do:
     2432         leave .
     2433       end.
     2434       column-handle = column-handle:NEXT-COLUMN.
     2435       assign
     2436         cur-clmn-locBR-gperval = cur-clmn-locBR-gperval + 1
     2437       .
     2438     end.
     2439     case sort-labelBR-gperval:
     2440           when X_group-period-validity.gr-per-val-code:label in browse BR-gperval then DO:   assign     sort-column-name = "X_group-period-validity.gr-per-val-code"   .   run OpenBr in this-procedure .   . END.
     2441       otherwise do:
     2442         assign
     2443           sort-column-name = ""
     2444         .
     2445         run OpenBr in this-procedure .
     2446         if sort-labelBR-gperval <> "" then do:
     2447           assign
     2448             cur-clmnBR-gperval:column-fgcolor = 0
     2449           .
     2450         end.
     2451         assign
     2452           cur-clmn-locBR-gperval = ?
     2453         .
     2454       end.
     2455     end case.
     2456     if p-recid <> ? then do:
     2457       reposition BR-gperval to recid p-recid no-error.
     2458       apply "value-changed" to BR-gperval in frame Dialog-Frame.
     2459     end.
     2460     apply "entry" to BR-gperval in frame Dialog-Frame.
     2461   END PROCEDURE.
     2462   procedure re-open-query-srt-clmnBR-gperval:
     2463   if cur-clmnBR-gperval = ? then do:
     2464      run OpenBr in this-procedure .
     2465   end.
     2466   else do:
     2467      assign re-queryBR-gperval = yes.
     2468      run sort-brBR-gperval
     2469        (input (if available X_group-period-validity
     2470                then recid(X_group-period-validity)
     2471                else ?
     2472               )
     2473        ).
     2474      assign re-queryBR-gperval = no.
     2475   end.
     2476   end.
     2477   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2478   do:
