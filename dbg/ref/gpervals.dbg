      849     QUERY BR-gperval NO-LOCK DISPLAY
      850         mark-string(recid(X_group-period-validity), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
      851         X_group-period-validity.gr-per-val-name FORMAT "X(50)":U
      852         entry (lookup (STRING(X_group-period-validity.sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) COLUMN-LABEL "Статус"
      853         X_group-period-validity.gr-per-from FORMAT "999":U
      854         X_group-period-validity.gr-per-to FORMAT "999":U
      855         X_group-period-validity.des FORMAT "X(255)":U
      856         X_group-period-validity.gr-per-val-code FORMAT ">>9":U
      857       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 16.27.
