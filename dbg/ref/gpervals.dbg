     1011   loc-doc-rec = recid(X_group-period-validity).
     1012   run ref/gpervali.w
     1013                 (
     1014                    input parParentProc
     1015                   ,input p-curr-obj-type
     1016                   ,input p-curr-obj-code
     1017                   ,input 'ПРОСМОТР':U
     1018                   ,input X_group-period-validity.gr-per-val-code
