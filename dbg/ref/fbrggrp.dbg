     3574   ON LEAVE OF fi-kitchen-code IN FRAME Dlg-grp
     3575   DO:
     3576       define variable v-is-invalid    as logical        no-undo.
     3577       if chkleave (
     3578            input last-event :widget-enter
     3579          , input "b-cancel,b-help,b-stop-cycle":u
     3580           )
     3581       then do:
     3582           run check-object in this-procedure (
     3583                 input fi-kitchen-type :screen-value
     3584               , input integer( fi-kitchen-code :screen-value )
     3585               , output v-is-invalid
     3586           ).
     3587           if v-is-invalid = yes
     3588           then do:
     3589               message
     3590                   "Неверно выбран объект."
     3591               view-as alert-box error.
     3592               undo, return no-apply.
     3593           end.
     3594       end.
     3595   END.
     3596   ON RETURN OF fi-kitchen-code IN FRAME Dlg-grp
     3597   DO:
     3598       run get-obj-type in this-procedure (
     3599             input integer( fi-kitchen-code :screen-value )
     3600           , output fi-kitchen-type
     3601       ) no-error.
     3602       if error-status :error
     3603       then do:
     3604           message
     3605                    vss-workfile vss-revision vss-description
     3606               skip "Ошибка при определении типа объекта."
     3607               skip return-value
     3608               skip trim(error-status :get-message(1))
     3609                    trim(error-status :get-message(2))
     3610                    trim(error-status :get-message(3))
     3611           view-as alert-box error.
     3612           undo, return no-apply .
     3613       end.
     3614       if fi-kitchen-type = ?
     3615       then do:
     3616           message
     3617               "Объект не найден"
     3618               skip "или не определен тип объекта"
     3619           view-as alert-box error.
     3620           undo, return no-apply.
     3621       end.
     3622       else do:
     3623           display
     3624               fi-kitchen-type
     3625           with frame Dlg-grp .
     3626       end.
     3627       assign
     3628           fi-kitchen-code
     3629       .
     3630       assign
     3631           p-store-type = fi-kitchen-type
     3632           p-store-code = fi-kitchen-code
     3633       .
     3634       run ui-on in this-procedure.
     3635       apply "entry":U to br-list in frame Dlg-grp .
     3636       return no-apply.
     3637   END.
     3638   ON CTRL-D OF fi-search IN FRAME Dlg-grp
     3639   DO:
     3640       define variable v-new-name as character no-undo.
     3641       run fbrglib-expand-name in this-procedure (
     3642             input p-store-type
     3643           , input p-store-code
     3644           , input fi-search :screen-value
     3645           , output v-new-name
     3646       ) no-error.
     3647       if error-status :error
     3648       then do:
     3649           message return-value.
     3650           undo, return no-apply.
     3651       end.
     3652       if v-new-name = ""
     3653       then do:
     3654           message
     3655               "Не найдена группа с полным именем, начинающимся на"
     3656               skip "'" + fi-search :screen-value + "'"
     3657           view-as alert-box information.
     3658           assign
     3659               v-new-name = fi-search :screen-value
     3660           .
     3661       end.
     3662       assign
     3663           fi-search :screen-value  = right-trim( v-new-name, chr(47) )
     3664           fi-search :cursor-offset = length( v-new-name ) + 1
     3665       .
     3666   END.
     3667   ON CTRL-S OF fi-search IN FRAME Dlg-grp
     3668   DO:
     3669       define variable v-new-name as character no-undo.
     3670       define variable v-new-code as integer   no-undo.
     3671       if v-full-search-next = no
     3672       then do:
     3673           assign
     3674               v-full-search-string     = fi-search :screen-value
     3675               v-full-search-next       = yes
     3676               v-full-search-start-code = 0
     3677           .
     3678       end.
     3679   if session :set-wait-state( "compiler" ) then.
     3680       run fbrglib-find-by-substring in this-procedure (
     3681             input p-store-type
     3682           , input p-store-code
     3683           , input v-full-search-start-code
     3684           , input v-full-search-string
     3685           , output v-new-code
     3686           , output v-new-name
     3687       ) no-error.
     3688       if error-status :error
     3689       then do:
     3690   if session :set-wait-state( "" ) then.
     3691           message return-value.
     3692           undo, return no-apply.
     3693       end.
     3694   if session :set-wait-state( "" ) then.
     3695       if v-new-code = 0
     3696       then do:
     3697           message
     3698               skip "Не найдена строка '" v-full-search-string "' в имени группы."
     3699           view-as alert-box information
     3700           title "Поиск завершен".
     3701           assign
     3702               v-new-name               = fi-search :screen-value
     3703               v-full-search-string     = ""
     3704               v-full-search-next       = no
     3705               v-full-search-start-code = 0
     3706           .
     3707       end.
     3708       else do:
     3709           assign
     3710               v-full-search-start-code = v-new-code
     3711           .
     3712       end.
     3713       assign
     3714           fi-search :screen-value  = right-trim( v-new-name, chr(47) )
     3715           fi-search :cursor-offset = length( v-new-name ) + 1
     3716       .
     3717   END.
     3718   ON LEAVE OF fi-search IN FRAME Dlg-grp
     3719   DO:
     3720       if fi-search :screen-value <> v-full-search-string
     3721       then do:
     3722           assign
     3723               v-full-search-string     = ""
     3724               v-full-search-next       = no
     3725               v-full-search-start-code = 0
     3726           .
     3727       end.
     3728   END.
     3729   ON RETURN OF fi-search IN FRAME Dlg-grp
     3730   DO:
     3731       if fi-search :screen-value = ""
     3732       or fi-search :screen-value = ?
     3733       then do:
     3734           return no-apply.
     3735       end.
     3736       run find-grp-in-browse in this-procedure ( INPUT p-store-type
     3737                                                 ,INPUT p-store-code
     3738                                                 ,input fi-search :screen-value
     3739                                             ) no-error.
     3740       if error-status :error
     3741       then do:
     3742           message
     3743             skip "Группа не найдена."
     3744             skip return-value
     3745             skip trim(error-status :get-message(1))
     3746                  trim(error-status :get-message(2))
     3747                  trim(error-status :get-message(3))
     3748                  trim(error-status :get-message(4))
     3749                  trim(error-status :get-message(5))
     3750           view-as alert-box warning.
     3751           undo, return no-apply.
     3752       end.
     3753       apply "ENTRY" to b-search in frame Dlg-grp.
     3754       return no-apply.
     3755   END.
     3756   ON CTRL-D OF fi-search-0 IN FRAME Dlg-grp
     3757   DO:
     3758       define variable v-new-name as character no-undo.
     3759       run fbrglib-expand-name in this-procedure (
     3760             input "":U
     3761           , input 0
     3762           , input fi-search-0 :screen-value
     3763           , output v-new-name
     3764       ) no-error.
     3765       if error-status :error
     3766       then do:
     3767           message return-value.
     3768           undo, return no-apply.
     3769       end.
     3770       if v-new-name = ""
     3771       then do:
     3772           message
     3773               "Не найдена группа с полным именем, начинающимся на"
     3774               skip "'" + fi-search-0 :screen-value + "'"
     3775           view-as alert-box information.
     3776           assign
     3777               v-new-name = fi-search-0 :screen-value
     3778           .
     3779       end.
     3780       assign
     3781           fi-search-0 :screen-value  = right-trim( v-new-name, chr(47) )
     3782           fi-search-0 :cursor-offset = length( v-new-name ) + 1
     3783       .
     3784   END.
     3785   ON CTRL-S OF fi-search-0 IN FRAME Dlg-grp
     3786   DO:
     3787       define variable v-new-name as character no-undo.
     3788       define variable v-new-code as integer   no-undo.
     3789       if v-full-search-next-0 = no
     3790       then do:
     3791           assign
     3792               v-full-search-string-0     = fi-search-0 :screen-value
     3793               v-full-search-next-0       = yes
     3794               v-full-search-start-code-0 = 0
     3795           .
     3796       end.
     3797   if session :set-wait-state( "compiler" ) then.
     3798       run fbrglib-find-by-substring in this-procedure (
     3799             input "":U
     3800           , input 0
     3801           , input v-full-search-start-code-0
     3802           , input v-full-search-string-0
     3803           , output v-new-code
     3804           , output v-new-name
     3805       ) no-error.
     3806       if error-status :error
     3807       then do:
     3808   if session :set-wait-state( "" ) then.
     3809           message return-value.
     3810           undo, return no-apply.
     3811       end.
     3812   if session :set-wait-state( "" ) then.
     3813       if v-new-code = 0
     3814       then do:
     3815           message
     3816               skip "Не найдена строка '" v-full-search-string-0 "' в имени группы."
     3817           view-as alert-box information
     3818           title "Поиск завершен".
     3819           assign
     3820               v-new-name               = fi-search-0 :screen-value
     3821               v-full-search-string-0     = ""
     3822               v-full-search-next-0       = no
     3823               v-full-search-start-code-0 = 0
     3824           .
     3825       end.
     3826       else do:
     3827           assign
     3828               v-full-search-start-code-0 = v-new-code
     3829           .
     3830       end.
     3831       assign
     3832           fi-search-0 :screen-value  = right-trim( v-new-name, chr(47) )
     3833           fi-search-0 :cursor-offset = length( v-new-name ) + 1
     3834       .
     3835   END.
     3836   ON LEAVE OF fi-search-0 IN FRAME Dlg-grp
     3837   DO:
     3838       if fi-search-0 :screen-value <> v-full-search-string-0
     3839       then do:
     3840           assign
     3841               v-full-search-string-0     = ""
     3842               v-full-search-next-0       = no
     3843               v-full-search-start-code-0 = 0
     3844           .
     3845       end.
     3846   END.
     3847   ON RETURN OF fi-search-0 IN FRAME Dlg-grp
     3848   DO:
     3849       if fi-search-0 :screen-value = ""
     3850       or fi-search-0 :screen-value = ?
     3851       then do:
     3852           return no-apply.
     3853       end.
     3854       run find-grp-in-browse in this-procedure (
     3855                                                  INPUT "":U
     3856                                                 ,INPUT 0
     3857                                                 ,input fi-search :screen-value
     3858                                               ) no-error.
     3859       if error-status :error
     3860       then do:
     3861           message
     3862             skip "Группа не найдена."
     3863             skip return-value
     3864             skip trim(error-status :get-message(1))
     3865                  trim(error-status :get-message(2))
     3866                  trim(error-status :get-message(3))
     3867                  trim(error-status :get-message(4))
     3868                  trim(error-status :get-message(5))
     3869           view-as alert-box warning.
     3870           undo, return no-apply.
     3871       end.
     3872       apply "ENTRY" to b-search-0 in frame Dlg-grp.
     3873       return no-apply.
     3874   END.
