     2441   ON CHOOSE OF b-exit IN FRAME Dlg-grp
     2442   DO:
     2443       define variable v-fbr-gds-grp-recid     as recid             no-undo.
     2444       if p-button-list = "buttons-for-objcopy"
     2445       then do:
     2446           assign
     2447               fi-kitchen-type
     2448               fi-kitchen-code
     2449           .
     2450           assign
     2451               p-recid-list = fi-kitchen-type + ",":U + string( fi-kitchen-code )
     2452           .
     2453       end.
     2454       else do:
     2455           run get-current-recid in this-procedure (
     2456               input (if v-rubr-mode = 1 then buf0_temp_fbrglib_grp.node-code else temp_fbrglib_grp.node-code)
     2457               , output v-fbr-gds-grp-recid
     2458           ) no-error .
     2459           if error-status :error
     2460           then do:
     2461               message
     2462               vss-workfile vss-revision vss-description
     2463               skip "Не найдена группа для восстановления"
     2464               skip "предыдущего состояния справочника групп."
     2465               skip return-value
     2466               skip trim(error-status :get-message(1))
     2467                   trim(error-status :get-message(2))
     2468                   trim(error-status :get-message(3))
     2469               view-as alert-box error.
     2470               undo, return no-apply .
     2471           end.
     2472           run gbl/markqwa.p (
     2473               input b-mark:visible
     2474               , input p-recid-list
     2475           ) no-error.
     2476           if error-status:error then return no-apply.
     2477           assign
     2478               fbr-gds-grp-row  = v-fbr-gds-grp-recid
     2479               p-recid-list = ""
     2480           .
     2481           assign
     2482           v-uf-list_ = (if v-uf-list_ = "":U then (chr(4)) else v-uf-list_)
     2483           entry((v-rubr-mode + 1), v-uf-List_,  chr(4)) = (if fbr-gds-grp-row = ?
     2484                                                               then chr(63)
     2485                                                               else string(fbr-gds-grp-row))
     2486           .
     2487           run uf-set in this-procedure(
     2488               input  'fbr-gds-grp-p':U
     2489               ,input v-cntxt-userid
     2490               ,input v-uf-List_
     2491               ,input v-uf-Naim
     2492               ,input v-uf-print-graft
     2493               ,input v-uf-sort-gr
     2494               ,input v-uf-type-price
     2495               ,input v-uf-type-val
     2496           )  no-error .
     2497       end.
     2498       apply "GO" TO FRAME Dlg-grp .
     2499   END.
     2500   ON CHOOSE OF b-expand IN FRAME Dlg-grp
     2501   DO:
