     2828   ON CHOOSE OF b-goods IN FRAME Dlg-grp
     2829   DO:
     2830       define variable v-cancel    as logical        no-undo.
     2831       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2832       if available temp_fbrglib_grp
     2833       then do:
     2834           run ref/fbrggrpg.w (
     2835                 input parparentproc
     2836               , input p-store-type
     2837               , input p-store-code
     2838               , input temp_fbrglib_grp.node-code
     2839               , output v-cancel
     2840           ) no-error.
     2841           if error-status :error
     2842           then do:
     2843               message
     2844                        vss-workfile vss-revision vss-description
     2845                   skip "Ошибка привязки товаров к группе блюд."
     2846                   skip return-value
     2847                   skip trim(error-status :get-message(1))
     2848                        trim(error-status :get-message(2))
     2849                        trim(error-status :get-message(3))
     2850               view-as alert-box error.
     2851               undo, return no-apply .
     2852           end.
     2853           if v-cancel = yes
     2854           then do:
     2855               undo, return no-apply .
     2856           end.
     2857           run get-first-char in this-procedure (
     2858                 input p-store-type
     2859               , input p-store-code
     2860               , input temp_fbrglib_grp.node-code
     2861               , output temp_fbrglib_grp.mark
     2862           ) no-error.
     2863           if error-status :error
     2864           then do:
     2865               message
     2866                        vss-workfile vss-revision vss-description
     2867                   skip "Ошибка вычисления первого символа для отображения группы"
     2868                   skip return-value
     2869                   skip trim(error-status :get-message(1))
     2870                        trim(error-status :get-message(2))
     2871                        trim(error-status :get-message(3))
     2872               view-as alert-box error.
     2873               undo, return no-apply .
     2874           end.
     2875           find first buf_fbr-gds-grp no-lock
     2876                where buf_fbr-gds-grp.obj-type     = p-store-type
     2877                  and buf_fbr-gds-grp.obj-code     = p-store-code
     2878                  and buf_fbr-gds-grp.node-code    = temp_fbrglib_grp.node-code
     2879           .
     2880           assign
     2881               temp_fbrglib_grp.name = fill( " ", 4 * temp_fbrglib_grp.level )
     2882                                               + temp_fbrglib_grp.mark
     2883                                               + " "
     2884                                               + buf_fbr-gds-grp.node-name
     2885           .
     2886           br-list :refresh().
     2887       end.
     2888   END.
