     2526                                                     , INPUT p-store-code
     2527                                                     , INPUT temp_fbrglib_grp.mark
     2528                                                     , INPUT temp_fbrglib_grp.node-code) no-error .
     2529       if error-status :error
     2530       then do:
     2531           message
     2532             vss-workfile vss-revision vss-description
     2533             skip "Ошибка операции с деревом групп."
     2534             skip return-value
     2535             skip trim(error-status :get-message(1))
     2536                  trim(error-status :get-message(2))
     2537                  trim(error-status :get-message(3))
     2538                  trim(error-status :get-message(4))
