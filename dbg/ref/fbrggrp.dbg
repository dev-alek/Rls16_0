     3947   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dlg-grp:PARENT eq ?
     3948   THEN FRAME Dlg-grp:PARENT = ACTIVE-WINDOW.
     3949   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3950   on help of frame Dlg-grp
     3951   do:
     3952     run gbl/app_help.p
     3953       (input this-procedure :file-name
     3954       ,input ''
     3955       ,input ?
     3956       ) no-error.
     3957     if error-status :error then do:
     3958       message
     3959         "Ошибка при вызове помощи"
     3960         error-status :get-message(1)
     3961         view-as alert-box .
     3962     end.
     3963   end.
     3964   run minbtn-set in this-procedure .
     3965   on choose of b-help in frame Dlg-grp
     3966   do:
     3967     apply "help":u to frame Dlg-grp .
     3968   end.
     3969   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3970   procedure minbtn-set :
     3971       do
     3972           on error undo, return error return-value
     3973           :
     3974           define variable ii              as integer       no-undo .
     3975           define variable fh              as widget-handle no-undo .
     3976           define variable hh              as widget-handle no-undo .
     3977           define variable v-h             as handle        extent 4 no-undo .
     3978           define variable v-name-button   as character     no-undo .
     3979           define variable v-help-old-x    as decimal       no-undo .
     3980           define variable v-help-old-y    as decimal       no-undo .
     3981           define variable v-help-old-size as decimal       no-undo .
     3982           define variable v-frame-width   as decimal       no-undo .
     3983           define variable jj              as integer       no-undo .
     3984           do
     3985               on error undo, return error
     3986               :
     3987               assign
     3988                   v-frame-width = frame Dlg-grp:width - 0.3
     3989                   fh            = frame Dlg-grp:first-child
     3990                   hh            = fh:first-child
     3991                   ii            = 1
     3992                   .
     3993               do while valid-handle(hh):
     3994                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3995                   do:
     3996                       case lc(hh:name) :
     3997                           when "b-help" then
     3998                               do:
     3999                                   hh:load-image-up("cmp/b-help.bmp":u) .
     4000                                   hh:load-image-down("cmp/b-help.bmp":u) .
     4001                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     4002                                   hh:TOOLTIP = "Помощь" .
     4003                                   v-help-old-x = hh:column .
     4004                                   v-help-old-y = hh:row    .
     4005                                   v-help-old-size = hh:width .
     4006                                   hh:width-chars = 2.5 .
     4007                               end.
     4008                           when "b-print" then
     4009                               do:
     4010                                   hh:load-image("cmp/b-print.bmp":u) .
     4011                                   hh:TOOLTIP = "Печать" .
     4012                                   v-h[ii] = hh:handle .
     4013                                   ii = ii + 1 .
     4014                                   hh:width-chars = 3 .
     4015                               end.
     4016                           when "b-history" or
     4017                           when "b-hist" then
     4018                               do:
     4019                                   hh:load-image("cmp/b-hist.bmp":u) .
     4020                                   hh:TOOLTIP = "История" .
     4021                                   v-h[ii] = hh:handle .
     4022                                   ii = ii + 1 .
     4023                                   hh:width-chars = 3 .
     4024                               end.
     4025                           when "b-sch" then
     4026                               do:
     4027                                   hh:load-image("cmp/b-sch.bmp":u) .
     4028                                   hh:TOOLTIP = "Установка Фильтра" .
     4029                                   v-h[ii] = hh:handle .
     4030                                   ii = ii + 1 .
     4031                                   hh:width-chars = 3 .
     4032                               end.
     4033                           when "b-hist-user" then
     4034                               do:
     4035                                   hh:load-image("cmp/b-hist.bmp":u) .
     4036                                   hh:TOOLTIP = "История пользователя" .
     4037                                   ii = ii + 1 .
     4038                               end.
     4039                       end case.
     4040                   end.
     4041                   hh = hh:next-sibling.
     4042               end.
     4043               b-help:column = v-frame-width - b-help:width-chars.
     4044               jj = 0.
     4045               repeat ii = 4 to 1 by -1 :
     4046                   if valid-handle (v-h[ii] ) then
     4047                   do:
     4048                       jj  = jj + 1 .
     4049                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     4050                       v-h[ii]:row    = v-help-old-y .
     4051                   end.
     4052               end.
     4053           end.
     4054       end.
     4055   end procedure.
     4056   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     4057   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     4058   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     4059   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     4060   define variable v-diasize-current-frame-width  as decimal   no-undo .
     4061   define variable v-diasize-current-frame-height as decimal   no-undo .
     4062   define variable v-diasize-change-size          as logical   no-undo .
     4063   define variable v-diasize-resize-button        as handle    no-undo .
     4064   define variable v-diasize-wndmax               as logical   no-undo .
     4065   define variable v-diasize-wndstore             as logical   no-undo .
     4066   define variable v-diasize-proc-name            as character no-undo .
     4067   define variable v-diasize-browse-handle        as handle    no-undo .
     4068   define variable v-diasize-browse-number        as integer   no-undo .
     4069   define variable v-diasize-need-full-display    as logical   no-undo init false .
     4070   define temp-table temp-diasize-handle no-undo
     4071     field handle-value  as handle
     4072     field save-position as decimal
     4073     index xpk is primary unique handle-value
     4074     .
     4075   define temp-table temp-browse-handle no-undo
     4076     field browse-type   as character
     4077     field browse-number as integer
     4078     field browse-handle as handle
     4079     field original-size as decimal
     4080     index xpk is primary unique browse-type browse-number
     4081     index xie browse-type browse-handle
     4082   .
     4083   procedure diasize_change-height :
     4084     define input  parameter p-change-value  as decimal   no-undo .
     4085     define input  parameter p-move-resize   as logical   no-undo .
     4086     define variable v-field-group-handle    as handle    no-undo .
     4087     define variable v-object-handle         as handle    no-undo .
     4088     define variable v-frame-height          as decimal   no-undo .
     4089     define variable v-frame-virtual-height  as decimal   no-undo .
     4090     define variable v-browse-height         as decimal   no-undo .
     4091     define variable v-window-height         as decimal   no-undo .
     4092     define variable v-window-virtual-height as decimal   no-undo .
     4093     define variable v-change-sign           as integer   no-undo .
     4094     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4095     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4096     if p-change-value > 0
     4097     then do:
     4098       if frame Dlg-grp :height + p-change-value
     4099           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     4100       then do:
     4101         assign
     4102           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     4103                           - (frame Dlg-grp :height-chars)
     4104         .
     4105         if p-change-value <= 0
     4106         then do:
     4107           run diasize_position-resize-button in this-procedure .
     4108           return .
     4109         end.
     4110       end.
     4111     end.
     4112     if p-change-value < 0
     4113     then do:
     4114       if frame Dlg-grp :height + p-change-value < v-diasize-orig-frame-height
     4115       then do:
     4116         assign
     4117           p-change-value = v-diasize-orig-frame-height
     4118                          - (frame Dlg-grp :height-chars)
     4119         .
     4120         if p-change-value >= 0
     4121         then do:
     4122           run diasize_position-resize-button in this-procedure .
     4123           return .
     4124         end.
     4125       end.
     4126     end.
     4127     if p-change-value >= 0
     4128     then do:
     4129       assign
     4130         v-change-sign = 1
     4131       .
     4132     end.
     4133     else do:
     4134       assign
     4135         v-change-sign = -1
     4136       .
     4137     end.
     4138     assign
     4139       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4140     .
     4141     if p-change-value = 0
     4142     then do:
     4143       run diasize_position-resize-button in this-procedure .
     4144       return .
     4145     end.
     4146     move_block:
     4147     do
     4148     on error undo move_block, retry move_block
     4149     :
     4150       if retry
     4151       then do:
     4152         do
     4153         on error undo move_block, leave move_block
     4154         :
     4155           if p-change-value > 0
     4156           then do:
     4157             for each buf_temp-diasize-handle
     4158             on error undo, next
     4159             :
     4160               assign
     4161                 v-object-handle = buf_temp-diasize-handle.handle-value
     4162               .
     4163               if v-object-handle <> v-diasize-resize-button
     4164               then do:
     4165                 assign
     4166                   v-object-handle :row = buf_temp-diasize-handle.save-position
     4167                 .
     4168               end.
     4169             end.
     4170             assign
     4171               v-diasize-browse-handle :height = v-browse-height
     4172             .
     4173             for each buf_temp-browse-handle
     4174               where buf_temp-browse-handle.browse-type = 'height':u
     4175             on error undo, next
     4176             :
     4177               assign
     4178                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     4179               .
     4180             end.
     4181             assign
     4182               frame Dlg-grp :height = v-frame-height
     4183             .
     4184             if frame Dlg-grp :scrollable = true
     4185             then do:
     4186               assign
     4187                 frame Dlg-grp :virtual-height = v-frame-virtual-height
     4188               .
     4189             end.
     4190             run diasize_position-resize-button in this-procedure .
     4191           end.
     4192           else do:
     4193             if frame Dlg-grp :scrollable = true
     4194             then do:
     4195               assign
     4196                 frame Dlg-grp :virtual-height = v-frame-virtual-height
     4197               .
     4198             end.
     4199             assign
     4200               frame Dlg-grp :height = v-frame-height
     4201             .
     4202             assign
     4203               v-diasize-browse-handle :height = v-browse-height
     4204             .
     4205             for each buf_temp-browse-handle
     4206               where buf_temp-browse-handle.browse-type = 'height':u
     4207             on error undo, next
     4208             :
     4209               assign
     4210                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     4211               .
     4212             end.
     4213             for each buf_temp-diasize-handle
     4214             on error undo, next
     4215             :
     4216               assign
     4217                 v-object-handle = buf_temp-diasize-handle.handle-value
     4218               .
     4219               if v-object-handle <> v-diasize-resize-button
     4220               then do:
     4221                 assign
     4222                   v-object-handle :row = buf_temp-diasize-handle.save-position
     4223                 .
     4224               end.
     4225             end.
     4226             run diasize_position-resize-button in this-procedure .
     4227           end.
     4228           assign
     4229             v-diasize-change-size = false
     4230           .
     4231           leave move_block .
     4232         end.
     4233       end.
     4234       assign
     4235         v-diasize-need-full-display = true
     4236       .
     4237       if v-diasize-change-size = false
     4238       then do:
     4239         assign
     4240           v-diasize-change-size = true
     4241         .
     4242       end.
     4243       else do:
     4244         return .
     4245       end.
     4246       assign
     4247         v-frame-height = frame Dlg-grp :height
     4248         v-frame-virtual-height = frame Dlg-grp :virtual-height
     4249         v-browse-height = v-diasize-browse-handle :height
     4250       .
     4251       for each buf_temp-browse-handle
     4252         where buf_temp-browse-handle.browse-type = 'height':u
     4253       :
     4254         assign
     4255           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     4256         .
     4257       end.
     4258       for each buf_temp-diasize-handle
     4259       :
     4260         delete buf_temp-diasize-handle .
     4261       end.
     4262       assign
     4263         v-field-group-handle = frame Dlg-grp :first-child
     4264       .
     4265       do while valid-handle(v-field-group-handle)
     4266       :
     4267         assign
     4268           v-object-handle = v-field-group-handle :first-child
     4269         .
     4270         do while valid-handle(v-object-handle)
     4271         :
     4272           if  v-object-handle <> v-diasize-browse-handle :handle
     4273           and can-query(v-object-handle, "row")
     4274           and can-query(v-object-handle, "height")
     4275           and ( v-object-handle :row > v-diasize-browse-handle :row )
     4276           then do:
     4277             find first buf_temp-browse-handle
     4278               where buf_temp-browse-handle.browse-type   = 'height':u
     4279                 and buf_temp-browse-handle.browse-handle = v-object-handle
     4280               no-error .
     4281             if available buf_temp-browse-handle
     4282             then do:
     4283             end.
     4284             else do:
     4285               create buf_temp-diasize-handle .
     4286               assign
     4287                 buf_temp-diasize-handle.handle-value  = v-object-handle
     4288                 buf_temp-diasize-handle.save-position = v-object-handle :row
     4289               .
     4290             end.
     4291           end.
     4292           assign
     4293             v-object-handle = v-object-handle :next-sibling
     4294           .
     4295         end.
     4296         assign
     4297           v-field-group-handle = v-field-group-handle :next-sibling
     4298         .
     4299       end.
     4300       do with frame Dlg-grp
     4301       :
     4302         hide v-diasize-resize-button .
     4303         assign
     4304           v-diasize-resize-button :row    = 1
     4305           v-diasize-resize-button :column = 1
     4306         .
     4307       end.
     4308       if p-change-value > 0
     4309       then do:
     4310         if frame Dlg-grp :scrollable = true
     4311         then do:
     4312           assign
     4313             frame Dlg-grp :virtual-height = frame Dlg-grp :virtual-height + p-change-value
     4314             no-error .
     4315           if error-status :error
     4316           or error-status :get-message(1) <> ""
     4317           then do:
     4318             undo move_block, retry move_block .
     4319           end.
     4320         end.
     4321         assign
     4322           frame Dlg-grp :height = frame Dlg-grp :height + p-change-value
     4323           no-error .
     4324         if error-status :error
     4325         or error-status :get-message(1) <> ""
     4326         then do:
     4327           undo move_block, retry move_block .
     4328         end.
     4329         assign
     4330           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     4331           no-error .
     4332         if error-status :error
     4333         or error-status :get-message(1) <> ""
     4334         then do:
     4335           undo move_block, retry move_block .
     4336         end.
     4337         for each buf_temp-browse-handle
     4338           where buf_temp-browse-handle.browse-type = 'height':u
     4339         on error undo move_block, retry move_block
     4340         :
     4341           assign
     4342             buf_temp-browse-handle.browse-handle :height
     4343               = buf_temp-browse-handle.browse-handle :height + p-change-value
     4344             no-error .
     4345           if error-status :error
     4346           or error-status :get-message(1) <> ""
     4347           then do:
     4348             undo move_block, retry move_block .
     4349           end.
     4350         end.
     4351         for each buf_temp-diasize-handle
     4352         on error undo move_block, retry move_block
     4353         :
     4354           assign
     4355             v-object-handle = buf_temp-diasize-handle.handle-value
     4356           .
     4357           if v-object-handle <> v-diasize-resize-button
     4358           then do:
     4359             assign
     4360               v-object-handle :row = v-object-handle :row + p-change-value
     4361               no-error .
     4362             if error-status :error
     4363             or error-status :get-message(1) <> ""
     4364             then do:
     4365               undo move_block, retry move_block .
     4366             end.
     4367           end.
     4368         end.
     4369       end.
     4370       else do:
     4371         for each buf_temp-diasize-handle
     4372         on error undo move_block, retry move_block
     4373         :
     4374           assign
     4375             v-object-handle = buf_temp-diasize-handle.handle-value
     4376           .
     4377           if v-object-handle <> v-diasize-resize-button
     4378           then do:
     4379             assign
     4380               v-object-handle :row = v-object-handle :row + p-change-value
     4381               no-error .
     4382             if error-status :error
     4383             or error-status :get-message(1) <> ""
     4384             then do:
     4385               undo move_block, retry move_block .
     4386             end.
     4387           end.
     4388         end.
     4389         assign
     4390           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     4391           no-error .
     4392         if error-status :error
     4393         or error-status :get-message(1) <> ""
     4394         then do:
     4395           undo move_block, retry move_block .
     4396         end.
     4397         for each buf_temp-browse-handle
     4398           where buf_temp-browse-handle.browse-type = 'height':u
     4399         on error undo move_block, retry move_block
     4400         :
     4401           assign
     4402             buf_temp-browse-handle.browse-handle :height
     4403               = buf_temp-browse-handle.browse-handle :height + p-change-value
     4404             no-error .
     4405           if error-status :error
     4406           or error-status :get-message(1) <> ""
     4407           then do:
     4408             undo move_block, retry move_block .
     4409           end.
     4410         end.
     4411         assign
     4412           frame Dlg-grp :height = frame Dlg-grp :height + p-change-value
     4413           no-error .
     4414         if error-status :error
     4415         or error-status :get-message(1) <> ""
     4416         then do:
     4417           undo move_block, retry move_block .
     4418         end.
     4419         if frame Dlg-grp :scrollable = true
     4420         then do:
     4421           assign
     4422             frame Dlg-grp :virtual-height = frame Dlg-grp :virtual-height + p-change-value
     4423             no-error .
     4424           if error-status :error
     4425           or error-status :get-message(1) <> ""
     4426           then do:
     4427             undo move_block, retry move_block .
     4428           end.
     4429         end.
     4430       end.
     4431       if p-move-resize = true
     4432       then do:
     4433         run diasize_position-resize-button in this-procedure .
     4434       end.
     4435       if v-diasize-wndstore = true
     4436       then do:
     4437         if connected("ub") = true
     4438         then do:
     4439           define variable v-cntxt-db-num        as integer   no-undo .
     4440           define variable v-cntxt-userid        as character no-undo .
     4441           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4442                                             , OUTPUT v-cntxt-userid
     4443                                             ) .
     4444           run gbl/wndsizew.p
     4445             (input  v-cntxt-db-num
     4446             ,input  v-cntxt-userid
     4447             ,input  v-diasize-proc-name
     4448             ,input  'height':u
     4449             ,input  string(frame Dlg-grp :height - v-diasize-orig-frame-height)
     4450             ) .
     4451         end.
     4452       end.
     4453     end.
     4454     assign
     4455       v-diasize-change-size = false
     4456     .
     4457   end procedure.
     4458   procedure diasize_set-height :
     4459     define input  parameter p-new-height  as decimal   no-undo .
     4460     define input  parameter p-move-resize as logical   no-undo .
     4461     do
     4462     on error undo, return error return-value
     4463     :
     4464       run diasize_change-height in this-procedure
     4465         (input  (p-new-height - frame Dlg-grp :height)
     4466         ,input  p-move-resize
     4467         ) .
     4468     end.
     4469   end procedure.
     4470   procedure diasize_change-width :
     4471     define input  parameter p-change-value as decimal   no-undo .
     4472     define input  parameter p-move-resize  as logical   no-undo .
     4473     define variable v-field-group-handle   as handle    no-undo .
     4474     define variable v-object-handle        as handle    no-undo .
     4475     define variable v-frame-width          as decimal   no-undo .
     4476     define variable v-frame-virtual-width  as decimal   no-undo .
     4477     define variable v-browse-width         as decimal   no-undo .
     4478     define variable v-window-width         as decimal   no-undo .
     4479     define variable v-window-virtual-width as decimal   no-undo .
     4480     define variable v-change-sign          as integer   no-undo .
     4481     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4482     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4483     if p-change-value > 0
     4484     then do:
     4485       if frame Dlg-grp :width + p-change-value >
     4486           session :width-chars
     4487       then do:
     4488         assign
     4489           p-change-value = session :width-chars - frame Dlg-grp :width
     4490         .
     4491         if p-change-value <= 0
     4492         then do:
     4493           run diasize_position-resize-button in this-procedure .
     4494           return .
     4495         end.
     4496       end.
     4497     end.
     4498     if p-change-value < 0
     4499     then do:
     4500       if frame Dlg-grp :width + p-change-value < v-diasize-orig-frame-width
     4501       then do:
     4502         assign
     4503           p-change-value = v-diasize-orig-frame-width
     4504                          - frame Dlg-grp :width
     4505         .
     4506         if p-change-value >= 0
     4507         then do:
     4508           run diasize_position-resize-button in this-procedure .
     4509           return .
     4510         end.
     4511       end.
     4512     end.
     4513     if p-change-value >= 0
     4514     then do:
     4515       assign
     4516         v-change-sign = 1
     4517       .
     4518     end.
     4519     else do:
     4520       assign
     4521         v-change-sign = -1
     4522       .
     4523     end.
     4524     assign
     4525       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4526     .
     4527     if p-change-value = 0
     4528     then do:
     4529       run diasize_position-resize-button in this-procedure .
     4530       return .
     4531     end.
     4532     move_block:
     4533     do
     4534     on error undo move_block, leave move_block
     4535     :
     4536       if retry
     4537       then do:
     4538         do
     4539         on error undo move_block, leave move_block
     4540         :
     4541           if p-change-value > 0
     4542           then do:
     4543             for each buf_temp-diasize-handle
     4544             on error undo, next
     4545             :
     4546               assign
     4547                 v-object-handle = buf_temp-diasize-handle.handle-value
     4548               .
     4549               if v-object-handle <> v-diasize-resize-button
     4550               then do:
     4551                 assign
     4552                   v-object-handle :col = buf_temp-diasize-handle.save-position
     4553                 .
     4554               end.
     4555             end.
     4556             assign
     4557               v-diasize-browse-handle :width = v-browse-width
     4558             .
     4559             for each buf_temp-browse-handle
     4560               where buf_temp-browse-handle.browse-type = 'width':u
     4561             on error undo, next
     4562             :
     4563               assign
     4564                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     4565               .
     4566             end.
     4567             assign
     4568               frame Dlg-grp :width = v-frame-width
     4569             .
     4570             if frame Dlg-grp :scrollable = true
     4571             then do:
     4572               assign
     4573                 frame Dlg-grp :virtual-width = v-frame-virtual-width
     4574               .
     4575             end.
     4576             run diasize_position-resize-button in this-procedure .
     4577           end.
     4578           else do:
     4579             if frame Dlg-grp :scrollable = true
     4580             then do:
     4581               assign
     4582                 frame Dlg-grp :virtual-width = v-frame-virtual-width
     4583               .
     4584             end.
     4585             assign
     4586               frame Dlg-grp :width = v-frame-width
     4587             .
     4588             for each buf_temp-browse-handle
     4589               where buf_temp-browse-handle.browse-type = 'width':u
     4590             on error undo, next
     4591             :
     4592               assign
     4593                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     4594               .
     4595             end.
     4596             assign
     4597               v-diasize-browse-handle :width = v-browse-width
     4598             .
     4599             for each buf_temp-diasize-handle
     4600             on error undo, next
     4601             :
     4602               assign
     4603                 v-object-handle = buf_temp-diasize-handle.handle-value
     4604               .
     4605               if v-object-handle <> v-diasize-resize-button
     4606               then do:
     4607                 assign
     4608                   v-object-handle :col = buf_temp-diasize-handle.save-position
     4609                 .
     4610               end.
     4611             end.
     4612             run diasize_position-resize-button in this-procedure .
     4613           end.
     4614           assign
     4615             v-diasize-change-size = false
     4616           .
     4617           leave move_block .
     4618         end.
     4619       end.
     4620       assign
     4621         v-diasize-need-full-display = true
     4622       .
     4623       if v-diasize-change-size = false
     4624       then do:
     4625         assign
     4626           v-diasize-change-size = true
     4627         .
     4628       end.
     4629       else do:
     4630         return .
     4631       end.
     4632       assign
     4633         v-frame-width = frame Dlg-grp :width
     4634         v-frame-virtual-width = frame Dlg-grp :virtual-width
     4635         v-browse-width = v-diasize-browse-handle :width
     4636       .
     4637       for each buf_temp-browse-handle
     4638         where buf_temp-browse-handle.browse-type = 'width':u
     4639       :
     4640         assign
     4641           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     4642         .
     4643       end.
     4644       for each buf_temp-diasize-handle
     4645       :
     4646         delete buf_temp-diasize-handle .
     4647       end.
     4648       assign
     4649         v-field-group-handle = frame Dlg-grp :first-child
     4650       .
     4651       do while valid-handle(v-field-group-handle)
     4652       :
     4653         assign
     4654           v-object-handle = v-field-group-handle :first-child
     4655         .
     4656         do while valid-handle(v-object-handle)
     4657         :
     4658           if  v-object-handle <> v-diasize-browse-handle :handle
     4659           and v-object-handle <> v-diasize-resize-button
     4660           and can-query(v-object-handle, "row")
     4661           and can-query(v-object-handle, "height")
     4662           and ( v-object-handle :col + v-object-handle :width
     4663                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     4664               )
     4665           then do:
     4666             find first buf_temp-browse-handle
     4667               where buf_temp-browse-handle.browse-type   = 'width':u
     4668                 and buf_temp-browse-handle.browse-handle = v-object-handle
     4669               no-error .
     4670             if available buf_temp-browse-handle
     4671             then do:
     4672             end.
     4673             else do:
     4674               create buf_temp-diasize-handle .
     4675               assign
     4676                 buf_temp-diasize-handle.handle-value  = v-object-handle
     4677                 buf_temp-diasize-handle.save-position = v-object-handle :col
     4678               .
     4679             end.
     4680           end.
     4681           assign
     4682             v-object-handle = v-object-handle :next-sibling
     4683           .
     4684         end.
     4685         assign
     4686           v-field-group-handle = v-field-group-handle :next-sibling
     4687         .
     4688       end.
     4689       do with frame Dlg-grp
     4690       :
     4691         hide v-diasize-resize-button .
     4692         v-diasize-resize-button :row = 1.
     4693         v-diasize-resize-button :column = 1.
     4694       end.
     4695       if p-change-value > 0
     4696       then do:
     4697         if frame Dlg-grp :scrollable = true
     4698         then do:
     4699           assign
     4700             frame Dlg-grp :virtual-width = frame Dlg-grp :virtual-width + p-change-value
     4701             no-error .
     4702           if error-status :error
     4703           or error-status :get-message(1) <> ""
     4704           then do:
     4705             undo move_block, retry move_block.
     4706           end.
     4707         end.
     4708         assign
     4709           frame Dlg-grp :width = v-frame-width + p-change-value
     4710           no-error .
     4711         if error-status :error
     4712         or error-status :get-message(1) <> ""
     4713         then do:
     4714           undo move_block, retry move_block.
     4715         end.
     4716         assign
     4717           v-diasize-browse-handle :width = v-browse-width + p-change-value
     4718         no-error .
     4719         if error-status :error
     4720         or error-status :get-message(1) <> ""
     4721         then do:
     4722           undo move_block, retry move_block.
     4723         end.
     4724         for each buf_temp-browse-handle
     4725           where buf_temp-browse-handle.browse-type = 'width':u
     4726         on error undo move_block, retry move_block
     4727         :
     4728           assign
     4729             buf_temp-browse-handle.browse-handle :width
     4730               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4731             no-error .
     4732           if error-status :error
     4733           or error-status :get-message(1) <> ""
     4734           then do:
     4735             undo move_block, retry move_block .
     4736           end.
     4737         end.
     4738         for each buf_temp-diasize-handle
     4739         on error undo move_block, retry move_block
     4740         :
     4741           assign
     4742             v-object-handle = buf_temp-diasize-handle.handle-value
     4743           .
     4744           if v-object-handle <> v-diasize-resize-button
     4745           then do:
     4746             assign
     4747               v-object-handle :col = v-object-handle :col + p-change-value
     4748               no-error .
     4749             if error-status :error
     4750             or error-status :get-message(1) <> ""
     4751             then do:
     4752               undo move_block, retry move_block .
     4753             end.
     4754           end.
     4755         end.
     4756       end.
     4757       else do:
     4758         for each buf_temp-diasize-handle
     4759         on error undo move_block, retry move_block
     4760         :
     4761           assign
     4762             v-object-handle = buf_temp-diasize-handle.handle-value
     4763           .
     4764           if v-object-handle <> v-diasize-resize-button
     4765           then do:
     4766             assign
     4767               v-object-handle :col = v-object-handle :col + p-change-value
     4768               no-error .
     4769             if error-status :error
     4770             or error-status :get-message(1) <> ""
     4771             then do:
     4772               undo move_block, retry move_block .
     4773             end.
     4774           end.
     4775         end.
     4776         for each buf_temp-browse-handle
     4777           where buf_temp-browse-handle.browse-type = 'width':u
     4778         on error undo move_block, retry move_block
     4779         :
     4780           assign
     4781             buf_temp-browse-handle.browse-handle :width
     4782               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4783             no-error .
     4784           if error-status :error
     4785           or error-status :get-message(1) <> ""
     4786           then do:
     4787             undo move_block, retry move_block .
     4788           end.
     4789         end.
     4790         assign
     4791           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     4792           no-error .
     4793         if error-status :error
     4794         or error-status :get-message(1) <> ""
     4795         then do:
     4796           undo move_block, retry move_block.
     4797         end.
     4798         assign
     4799           frame Dlg-grp :width = frame Dlg-grp :width + p-change-value
     4800         no-error .
     4801         if error-status :error
     4802         or error-status :get-message(1) <> ""
     4803         then do:
     4804           undo move_block, retry move_block.
     4805         end.
     4806         if frame Dlg-grp :scrollable = true
     4807         then do:
     4808           assign
     4809             frame Dlg-grp :virtual-width = frame Dlg-grp :virtual-width + p-change-value
     4810           no-error .
     4811           if error-status :error
     4812           or error-status :get-message(1) <> ""
     4813           then do:
     4814             undo move_block, retry move_block.
     4815           end.
     4816         end.
     4817       end.
     4818       if p-move-resize
     4819       then do:
     4820         run diasize_position-resize-button in this-procedure .
     4821       end.
     4822       if v-diasize-wndstore = true
     4823       then do:
     4824         if connected("ub") = true
     4825         then do:
     4826           define variable v-cntxt-db-num        as integer   no-undo .
     4827           define variable v-cntxt-userid        as character no-undo .
     4828           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4829                                             , OUTPUT v-cntxt-userid
     4830                                             ) .
     4831           run gbl/wndsizew.p
     4832             (input  v-cntxt-db-num
     4833             ,input  v-cntxt-userid
     4834             ,input  v-diasize-proc-name
     4835             ,input  'width':u
     4836             ,input  string(frame Dlg-grp :width - v-diasize-orig-frame-width)
     4837             ) .
     4838         end.
     4839       end.
     4840     end.
     4841     assign
     4842       v-diasize-change-size = false
     4843     .
     4844   end procedure.
     4845   procedure diasize_set-width :
     4846     define input  parameter p-new-width  as decimal   no-undo .
     4847     define input  parameter p-move-resize as logical   no-undo .
     4848     do
     4849     on error undo, return error return-value
     4850     :
     4851       run diasize_change-width in this-procedure
     4852         (input  (p-new-width - frame Dlg-grp :width)
     4853         ,input  p-move-resize
     4854         ) .
     4855     end.
     4856   end procedure.
     4857   procedure diasize_position-resize-button :
     4858     do with frame Dlg-grp
     4859     :
     4860       hide v-diasize-resize-button .
     4861       assign
     4862         v-diasize-resize-button :row = frame Dlg-grp :height - v-diasize-resize-button :height
     4863                     - 1
     4864                     - (frame Dlg-grp :border-bottom-pixels / session :pixels-per-row)
     4865         v-diasize-resize-button :col = frame Dlg-grp :width - v-diasize-resize-button :width
     4866                     - 1
     4867                     - (frame Dlg-grp :border-right-pixels / session :pixels-per-column)
     4868       .
     4869       view v-diasize-resize-button .
     4870     end.
     4871   end procedure.
     4872   on alt-right anywhere
     4873   do:
     4874     run diasize_change-width in this-procedure
     4875       (input 1
     4876       ,input true
     4877       ) .
     4878     return no-apply .
     4879   end.
     4880   on alt-left anywhere
     4881   do:
     4882     run diasize_change-width in this-procedure
     4883       (input -1
     4884       ,input true
     4885       ) .
     4886     return no-apply .
     4887   end.
     4888   on alt-down anywhere
     4889   do:
     4890     run diasize_change-height in this-procedure
     4891       (input 1
     4892       ,input true
     4893       ) .
     4894     return no-apply .
     4895   end.
     4896   on alt-up anywhere
     4897   do:
     4898     run diasize_change-height in this-procedure
     4899       (input -1
     4900       ,input true
     4901       ) .
     4902     return no-apply .
     4903   end.
     4904   on alt-enter of frame Dlg-grp
     4905   do:
     4906     run diasize_maximize in this-procedure
     4907       (input  ?
     4908       ).
     4909     return no-apply .
     4910   end.
     4911   procedure diasize_end-move :
     4912     do
     4913     on error undo, return error return-value
     4914     :
     4915       define variable v-row-delta as decimal   no-undo .
     4916       define variable v-col-delta as decimal   no-undo .
     4917       define variable v-new-row as decimal   no-undo .
     4918       define variable v-new-col as decimal   no-undo .
     4919       assign
     4920         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     4921         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     4922       .
     4923       assign
     4924         v-row-delta = v-new-row - frame Dlg-grp :height
     4925         v-col-delta = v-new-col - frame Dlg-grp :width
     4926       .
     4927       run diasize_change-height in this-procedure
     4928         (input v-row-delta
     4929         ,input true
     4930         ) .
     4931       run diasize_change-width in this-procedure
     4932         (input v-col-delta
     4933         ,input true
     4934         ) .
     4935     end.
     4936   end procedure.
     4937   procedure diasize_maximize :
     4938     define input  parameter p-action as logical   no-undo .
     4939     do
     4940     on error undo, return error return-value
     4941     :
     4942       if p-action = ?
     4943       then do:
     4944         if v-diasize-need-maximize = true
     4945         then do:
     4946           assign
     4947             p-action = true
     4948           .
     4949         end.
     4950         else do:
     4951           assign
     4952             p-action = false
     4953           .
     4954         end.
     4955       end.
     4956       if p-action = true
     4957       then do:
     4958         run diasize_change-height in this-procedure
     4959           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     4960               - frame Dlg-grp :height-chars
     4961           ,input true
     4962           ) .
     4963         run diasize_change-width in this-procedure
     4964           (input session :width-chars
     4965               - frame Dlg-grp :width-chars
     4966           ,input true
     4967           ) .
     4968         assign
     4969           v-diasize-need-maximize = false
     4970         .
     4971       end.
     4972       else do:
     4973         run diasize_change-width in this-procedure
     4974           (input v-diasize-orig-frame-width
     4975               - frame Dlg-grp :width-chars
     4976           ,input true
     4977           ) .
     4978         run diasize_change-height in this-procedure
     4979           (input v-diasize-orig-frame-height
     4980               - frame Dlg-grp :height-chars
     4981           ,input true
     4982           ) .
     4983         assign
     4984           v-diasize-need-maximize = true
     4985         .
     4986       end.
     4987     end.
     4988   end procedure.
     4989   procedure diasize_restore-orig-size :
     4990     do
     4991     on error undo, return error return-value
     4992     :
     4993       assign
     4994         v-diasize-current-frame-width  = frame Dlg-grp :width
     4995         v-diasize-current-frame-height = frame Dlg-grp :height
     4996       .
     4997       run diasize_set-height in this-procedure
     4998         (input  v-diasize-orig-frame-height
     4999         ,input  true
     5000         ) .
     5001       run diasize_set-width in this-procedure
     5002         (input  v-diasize-orig-frame-width
     5003         ,input  true
     5004         ) .
     5005     end.
     5006   end procedure.
     5007   procedure diasize_restore-current-size :
     5008     do
     5009     on error undo, return error return-value
     5010     :
     5011       run diasize_set-height in this-procedure
     5012         (input  v-diasize-current-frame-height
     5013         ,input  true
     5014         ) .
     5015       run diasize_set-width in this-procedure
     5016         (input  v-diasize-current-frame-width
     5017         ,input  true
     5018         ) .
     5019     end.
     5020   end procedure.
     5021   procedure diasize_set-browse-handle :
     5022     define input  parameter p-browse-handle as handle   no-undo .
     5023     define buffer buf_temp-browse-handle for temp-browse-handle .
     5024     do
     5025     on error undo, return error return-value
     5026     :
     5027       assign
     5028         v-diasize-browse-handle = p-browse-handle
     5029       .
     5030       for each buf_temp-browse-handle
     5031       on error undo, return error return-value
     5032       :
     5033         delete buf_temp-browse-handle .
     5034       end.
     5035     end.
     5036   end procedure.
     5037   procedure diasize_add_browse :
     5038     define input  parameter p-browse-type   as character no-undo .
     5039     define input  parameter p-browse-handle as handle    no-undo .
     5040     define buffer buf_temp-browse-handle for temp-browse-handle .
     5041     do
     5042     on error undo, return error return-value
     5043     :
     5044       assign
     5045         v-diasize-browse-number = v-diasize-browse-number + 1
     5046       .
     5047       create buf_temp-browse-handle .
     5048       assign
     5049         buf_temp-browse-handle.browse-type   = p-browse-type
     5050         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     5051         buf_temp-browse-handle.browse-handle = p-browse-handle
     5052       .
     5053     end.
     5054   end procedure.
     5055   procedure diasize_init :
     5056     define variable v-default-value    as logical   no-undo .
     5057     define variable v-restore-saved    as logical   no-undo .
     5058     define variable v-resize-value-str as character no-undo .
     5059     do
     5060     on error undo, return error return-value
     5061     :
     5062       do with frame Dlg-grp
     5063       :
     5064         assign
     5065           v-diasize-orig-frame-height = frame Dlg-grp :height
     5066           v-diasize-orig-frame-width  = frame Dlg-grp :width
     5067           v-diasize-browse-handle     = browse br-global :handle
     5068         .
     5069         create button v-diasize-resize-button
     5070         assign
     5071           parent        = frame Dlg-grp :first-child
     5072           label         = "s"
     5073           height-pixels = 16
     5074           width-pixels  = 16
     5075           visible       = true
     5076           sensitive     = true
     5077           movable       = true
     5078           triggers:
     5079             on end-move persistent run diasize_end-move in this-procedure .
     5080           end triggers.
     5081         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     5082         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     5083         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     5084         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     5085         assign
     5086           v-diasize-wndmax = false
     5087         .
     5088         if connected("ub") = true
     5089         then do:
     5090           define variable v-cntxt-db-num        as integer   no-undo .
     5091           define variable v-cntxt-userid        as character no-undo .
     5092           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5093                                             , OUTPUT v-cntxt-userid
     5094                                             ) .
     5095           run gbl/wndpar_r.p
     5096             (input  v-cntxt-db-num
     5097             ,input  v-cntxt-userid
     5098             ,input  'wndmax':U
     5099             ,output v-diasize-wndmax
     5100             ,output v-default-value
     5101             ) .
     5102         end.
     5103         assign
     5104           v-diasize-wndstore = false
     5105         .
     5106         if connected("ub") = true
     5107         then do:
     5108           run gbl/wndpar_r.p
     5109             (input  v-cntxt-db-num
     5110             ,input  v-cntxt-userid
     5111             ,input  'wndstore':U
     5112             ,output v-diasize-wndstore
     5113             ,output v-default-value
     5114             ) .
     5115         end.
     5116         assign
     5117           v-diasize-proc-name = entry(1, program-name(2), '.')
     5118         .
     5119         if v-diasize-wndstore = true
     5120         then do:
     5121           assign
     5122             v-restore-saved = false
     5123           .
     5124           if connected("ub") = true
     5125           then do:
     5126             run gbl/wndsizer.p
     5127               (input  v-cntxt-db-num
     5128               ,input  v-cntxt-userid
     5129               ,input  v-diasize-proc-name
     5130               ,input  'height':u
     5131               ,output v-resize-value-str
     5132               ) .
     5133             if v-resize-value-str <> '':U
     5134             then do:
     5135               run diasize_change-height in this-procedure
     5136                 (input  integer(v-resize-value-str)
     5137                 ,input  true
     5138                 ) .
     5139               assign
     5140                 v-restore-saved = true
     5141               .
     5142             end.
     5143           end.
     5144           if connected("ub") = true
     5145           then do:
     5146             run gbl/wndsizer.p
     5147               (input  v-cntxt-db-num
     5148               ,input  v-cntxt-userid
     5149               ,input  v-diasize-proc-name
     5150               ,input  'width':u
     5151               ,output v-resize-value-str
     5152               ) .
     5153             if v-resize-value-str <> '':U
     5154             then do:
     5155               run diasize_change-width in this-procedure
     5156                 (input  integer(v-resize-value-str)
     5157                 ,input  true
     5158                 ) .
     5159               assign
     5160                 v-restore-saved = true
     5161               .
     5162             end.
     5163           end.
     5164           if v-restore-saved <> true
     5165           then do:
     5166             if v-diasize-wndmax = true
     5167             then do:
     5168               run diasize_maximize in this-procedure
     5169                 (input  true
     5170                 ) .
     5171             end.
     5172           end.
     5173         end.
     5174         else do:
     5175           if v-diasize-wndmax = true
     5176           then do:
     5177             run diasize_maximize in this-procedure
     5178               (input  true
     5179               ) .
     5180           end.
     5181         end.
     5182       end.
     5183     end.
     5184   end procedure.
     5185   procedure diasize_need-full-display :
     5186     define output parameter p-need-full-display as logical   no-undo .
     5187     do
     5188     on error undo, return error return-value
     5189     :
     5190       assign
     5191         p-need-full-display = v-diasize-need-full-display
     5192       .
     5193       assign
     5194         v-diasize-need-full-display = false
     5195       .
     5196     end.
     5197   end procedure.
     5198   procedure get-context :
     5199      define output parameter p-db-num as integer          no-undo.
     5200      define output parameter p-user-id as character        no-undo.
     5201      define variable v-login               as character    no-undo.
     5202      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     5203      define buffer buf_user-login  for ub.user-login .
     5204      do
     5205      on error undo, return error
     5206      :
     5207            FIND FIRST buf_sys-ctrl no-lock.
     5208            ASSIGN
     5209               v-login = USERID("ub")
     5210               p-db-num = buf_sys-ctrl.db-num
     5211            .
     5212            FIND FIRST buf_user-login
     5213                 WHERE buf_user-login.db-num = p-db-num
     5214                   AND buf_user-login.user-login = v-login
     5215                 no-lock
     5216                 no-error
     5217                 .
     5218            IF AVAILABLE buf_user-login
     5219            THEN DO:
     5220               assign
     5221                  p-user-id = buf_user-login.user-id
     5222               .
     5223            END.
     5224      end.
     5225   end procedure.
     5226       run diasize_init in this-procedure .
     5227   MAIN-BLOCK:
     5228   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     5229      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     5230   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5231     run mainmenu_getcntxt in parparentproc
     5232       (output v-cntxt-db-num
     5233       ,output v-cntxt-userid
     5234       ,output v-cntxt-level
     5235       ,output v-cntxt-host-code-obj
     5236       ,output v-cntxt-obj-type
     5237       ,output v-cntxt-obj-code
     5238       ,output v-cntxt-db-num-obj
     5239       ,output v-cntxt-is-admin
     5240       ) .
     5241     assign
     5242     v-b-expand-col            =  b-expand:COL IN FRAME Dlg-grp             - 50
     5243     v-b-expand-all-col        =  b-expand-all:COL IN FRAME Dlg-grp         - 50
     5244     v-b-find-by-full-name-col =  b-find-by-full-name:COL IN FRAME Dlg-grp  - 50
     5245     v-b-find-by-substring-col =  b-find-by-substring:COL IN FRAME Dlg-grp  - 50
     5246     v-b-search-col            =  b-search:COL IN FRAME Dlg-grp             - 50
     5247     v-fi-search-col           =  fi-search:COL IN FRAME Dlg-grp            - 50
     5248     .
     5249       run get-report-num in parparentproc (
     5250           output g#report-num
     5251       ).
     5252       run get-quest-print in parparentproc (
     5253           output g#quest-print
     5254       ).
     5255     IF lookup("buttons-for-rubr-only", P-BUTTON-LIST) > 0  THEN do:
     5256       assign
     5257       v-rubr-mode = 1.
     5258       run RUBR-on in this-procedure no-error .
     5259     end.
     5260     ELSE
     5261     run UI-on in this-procedure no-error .
     5262     if error-status :error
     5263     then do:
     5264         message
     5265           vss-workfile vss-revision vss-description
     5266           skip "Ошибка при загрузке дерева групп."
     5267           skip return-value
     5268           skip trim(error-status :get-message(1))
     5269                trim(error-status :get-message(2))
     5270                trim(error-status :get-message(3))
     5271                trim(error-status :get-message(4))
     5272                trim(error-status :get-message(5))
     5273         view-as alert-box error.
     5274         undo, return error .
     5275     end.
     5276     apply "entry" to br-list.
     5277     WAIT-FOR GO OF FRAME Dlg-grp.
     5278   END.
     5279   RUN disable_UI.
     5280   PROCEDURE add-grp :
     5281   do
     5282   on error undo, return error
     5283   :
     5284   define input parameter p-node-code  as integer      no-undo.
     5285       define variable v-focused-row       as integer  no-undo.
     5286       define variable v-repositioned-row  as integer  no-undo.
     5287       define variable v-node-code    as integer        no-undo.
     5288       define variable v-have-rights       as logical       no-undo.
     5289       define variable v-have-goods        as logical  no-undo.
     5290       define variable v-cancel            as logical        no-undo.
     5291       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     5292       define buffer buf_temp_fbrglib_grp   for temp_fbrglib_grp.
     5293       run check-rights-for-change-grp in this-procedure (
     5294           output v-have-rights
     5295       ) no-error.
     5296       if error-status :error
     5297       or v-have-rights = no
     5298       then do:
     5299           message
     5300             vss-workfile vss-revision vss-description
     5301             skip "Нет прав на изменение справочника групп блюд."
     5302             skip "Добавление группы невозможно."
     5303             skip return-value
     5304             skip trim(error-status :get-message(1))
     5305                  trim(error-status :get-message(2))
     5306                  trim(error-status :get-message(3))
     5307           view-as alert-box error.
     5308           undo, return error .
     5309       end.
     5310       assign
     5311           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     5312           v-repositioned-row = current-result-row( "br-list" )
     5313       .
     5314       run fbrglib-have-goods in this-procedure (
     5315             input p-store-type
     5316           , input p-store-code
     5317           , input p-node-code
     5318           , output v-have-goods
     5319       ) no-error .
     5320       if error-status :error
     5321       then do:
     5322           message
     5323                    vss-workfile vss-revision vss-description
     5324               skip "Ошибка определения наличия товаров в группе."
     5325               skip return-value
     5326               skip trim(error-status :get-message(1))
     5327                    trim(error-status :get-message(2))
     5328                    trim(error-status :get-message(3))
     5329           view-as alert-box error.
     5330           undo, return error .
     5331       end.
     5332       if v-have-goods = yes
     5333       then do:
     5334           message "В данной группе есть товары. Добавить в нее подгруппу,"
     5335                   "включающую эти товары ?"
     5336           view-as alert-box question
     5337           buttons OK-Cancel
     5338           update v-yesno as logical.
     5339           if v-yesno = no
     5340           then do:
     5341               return.
     5342           end.
     5343       end.
     5344       find first buf_temp_fbrglib_grp
     5345            where buf_temp_fbrglib_grp.node-code = p-node-code
     5346               AND buf_temp_fbrglib_grp.obj-type = p-store-type
     5347               AND buf_temp_fbrglib_grp.obj-code = p-store-code
     5348       .
     5349       if buf_temp_fbrglib_grp.mark = "»"
     5350       then do:
     5351           run expand-item in this-procedure ( INPUT p-store-type, p-store-code, input p-node-code, input no ) no-error.
     5352           if error-status :error
     5353           then do:
     5354               undo, return error "add-grp: Не удается раскрыть группу.".
     5355           end.
     5356       end.
     5357       run fbrglib-add-grp in this-procedure (
     5358             input p-store-type
     5359           , input p-store-code
     5360           , input p-node-code
     5361           , INPUT YES
     5362           , INPUT "":U
     5363           , INPUT 0
     5364           , INPUT 0
     5365           , output v-node-code
     5366           , output v-cancel
     5367       ).
     5368       if v-cancel = yes
     5369       then do:
     5370           undo, return.
     5371       end.
     5372       find first buf_fbr-gds-grp no-lock
     5373            where buf_fbr-gds-grp.obj-type  = p-store-type
     5374              and buf_fbr-gds-grp.obj-code  = p-store-code
     5375              and buf_fbr-gds-grp.node-code = v-node-code
     5376       .
     5377       run create-new-line in this-procedure (
     5378             input p-store-type
     5379           , input p-store-code
     5380           , input buf_fbr-gds-grp.node-code
     5381           , input buf_fbr-gds-grp.upper-code
     5382           , input buf_temp_fbrglib_grp.level + 1
     5383           , input buf_fbr-gds-grp.node-name
     5384           , input buf_fbr-gds-grp.out-code
     5385           , input buf_fbr-gds-grp.global-code
     5386       ) no-error .
     5387       if error-status :error
     5388       then do:
     5389           undo, return error "add-grp: Ошибка добавления строки в список групп.".
     5390       end.
     5391       if buf_temp_fbrglib_grp.level > 0
     5392       then do:
     5393           assign
     5394               buf_temp_fbrglib_grp.mark = "«"
     5395               buf_temp_fbrglib_grp.name = substring( buf_temp_fbrglib_grp.name, 1, buf_temp_fbrglib_grp.level * 4 )
     5396                                   + "«"
     5397                                   + substring( buf_temp_fbrglib_grp.name, buf_temp_fbrglib_grp.level * 4 + 2 )
     5398           .
     5399       end.
     5400       OPEN QUERY br-list FOR EACH temp_fbrglib_grp NO-LOCK where     temp_fbrglib_grp.obj-type = p-store-type  AND temp_fbrglib_grp.obj-code = p-store-code     by temp_fbrglib_grp.sort-name.
     5401       br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     5402       reposition br-list to row v-repositioned-row.
     5403   end.
     5404   END PROCEDURE.
     5405   PROCEDURE add-grp-branch-cycle :
     5406   define input parameter p-node-code         as integer      no-undo.
     5407   define input parameter p-global-node-code  as integer      no-undo.
     5408   define input parameter p-node-name         as character    no-undo.
     5409   define input parameter p-out-code          as INTEGER      no-undo.
     5410   define input parameter p-global-code       as INTEGER      no-undo.
     5411   define input parameter p-level             as INTEGER      no-undo.
     5412   DEFINE VARIABLE v-node-code AS INTEGER NO-UNDO.
     5413   DEFINE VARIABLE v-cancel    AS logical NO-UNDO.
     5414   DEFINE BUFFER bf0_fbr-gds-grp for ub.fbr-gds-grp.
     5415   DEFINE BUFFER buf_fbr-gds-grp for ub.fbr-gds-grp.
     5416   run fbrglib-add-grp in this-procedure (
     5417             input p-store-type
     5418           , input p-store-code
     5419           , input p-node-code
     5420           , INPUT no
     5421           , INPUT p-node-name
     5422           , INPUT p-out-code
     5423           , INPUT p-global-code
     5424           , output v-node-code
     5425           , output v-cancel
     5426       ).
     5427       find first buf_fbr-gds-grp no-lock
     5428            where buf_fbr-gds-grp.obj-type  = p-store-type
     5429              and buf_fbr-gds-grp.obj-code  = p-store-code
     5430              and buf_fbr-gds-grp.node-code = v-node-code
     5431       .
     5432       run create-new-line in this-procedure (
     5433         input p-store-type
     5434       , input p-store-code
     5435       , input v-node-code
     5436       , input buf_fbr-gds-grp.upper-code
     5437       , input p-level
     5438       , input buf_fbr-gds-grp.node-name
     5439       , input buf_fbr-gds-grp.out-code
     5440       , input buf_fbr-gds-grp.global-code
     5441       ) no-error .
     5442       if error-status :error
     5443       then do:
     5444           undo, return error "add-grpbrach-cycle: Ошибка добавления строки в список групп.".
     5445       end.
     5446   FOR EACH bf0_fbr-gds-grp NO-LOCK WHERE
     5447           bf0_fbr-gds-grp.obj-type = "":U
     5448       AND bf0_fbr-gds-grp.obj-code = 0
     5449       AND bf0_fbr-gds-grp.upper-code = p-global-node-code:
     5450     RUN add-grp-branch-cycle IN THIS-PROCEDURE(
     5451                                                INPUT v-node-code
     5452                                               ,INPUT bf0_fbr-gds-grp.node-code
     5453                                               ,INPUT bf0_fbr-gds-grp.node-name
     5454                                               ,INPUT bf0_fbr-gds-grp.out-code
     5455                                               ,INPUT bf0_fbr-gds-grp.global-code
     5456                                               ,INPUT p-level + 1
     5457                                               ).
     5458   END.
     5459   END PROCEDURE.
     5460   PROCEDURE b-mark-press :
     5461   do
     5462   on error undo, return error
     5463   :
     5464   define input parameter p-obj-type   as character    no-undo.
     5465   define input parameter p-obj-code   as integer      no-undo.
     5466   define input parameter p-node-code as integer      no-undo.
     5467       define variable v-focused-row       as integer              no-undo.
     5468       define variable v-repositioned-row  as integer              no-undo.
     5469       define buffer buf_temp_fbrglib_grp       for temp_fbrglib_grp.
     5470       define buffer buf_upper_temp_fbrglib_grp for temp_fbrglib_grp.
     5471       find first buf_temp_fbrglib_grp
     5472            where buf_temp_fbrglib_grp.node-code = p-node-code
     5473              AND buf_temp_fbrglib_grp.obj-type = p-obj-type
     5474           AND buf_temp_fbrglib_grp.obj-code = p-obj-code
     5475       no-error .
     5476       if not available buf_temp_fbrglib_grp
     5477       then do:
     5478           undo, return error "b-mark-press: Ошибка поиска группы".
     5479       end.
     5480       assign
     5481           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     5482           v-repositioned-row = current-result-row( "br-list" )
     5483       .
     5484       if buf_temp_fbrglib_grp.sel = "*"
     5485       or p-node-code = v-fbrggrp-root-code
     5486       then do:
     5487           assign
     5488               buf_temp_fbrglib_grp.sel = ""
     5489           .
     5490       end.
     5491       else do:
     5492           assign
     5493               buf_temp_fbrglib_grp.sel = "*"
     5494           .
     5495           for each buf_upper_temp_fbrglib_grp
     5496               where buf_upper_temp_fbrglib_grp.level < buf_temp_fbrglib_grp.level
     5497                   AND buf_temp_fbrglib_grp.obj-type = p-obj-type
     5498                   AND buf_temp_fbrglib_grp.obj-code = p-obj-code
     5499                 and buf_upper_temp_fbrglib_grp.full-name = substring( buf_temp_fbrglib_grp.full-name, 1
     5500                                                           , length( buf_upper_temp_fbrglib_grp.full-name ) )
     5501           :
     5502               assign
     5503                   buf_upper_temp_fbrglib_grp.sel = ""
     5504               .
     5505           end.
     5506           for each buf_upper_temp_fbrglib_grp
     5507               where buf_upper_temp_fbrglib_grp.node-code <> buf_temp_fbrglib_grp.node-code
     5508                   AND buf_temp_fbrglib_grp.obj-type = p-obj-type
     5509                   AND buf_temp_fbrglib_grp.obj-code = p-obj-code
     5510                 and buf_upper_temp_fbrglib_grp.full-name begins buf_temp_fbrglib_grp.full-name + chr(47)
     5511           :
     5512               assign
     5513                   buf_upper_temp_fbrglib_grp.sel = ""
     5514               .
     5515           end.
     5516       end.
     5517       OPEN QUERY br-list FOR EACH temp_fbrglib_grp NO-LOCK where     temp_fbrglib_grp.obj-type = p-store-type  AND temp_fbrglib_grp.obj-code = p-store-code     by temp_fbrglib_grp.sort-name.
     5518       if v-focused-row > br-list :height - 2
     5519       then do:
     5520           assign
     5521               v-repositioned-row  = v-repositioned-row + 1
     5522           .
     5523       end.
     5524       else do:
     5525           assign
     5526               v-focused-row       = v-focused-row + 1
     5527               v-repositioned-row  = v-repositioned-row + 1
     5528           .
     5529       end.
     5530       br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     5531       reposition br-list to row v-repositioned-row.
     5532   end.
     5533   END PROCEDURE.
     5534   PROCEDURE change-grp :
     5535   do
     5536   on error undo, return error
     5537   :
     5538   define input parameter p-node-code  as integer      no-undo.
     5539       define variable v-fbr-gds-grp-recid     as recid        no-undo.
     5540       define variable v-focused-row           as integer      no-undo.
     5541       define variable v-repositioned-row      as integer      no-undo.
     5542       define variable v-have-rights           as logical      no-undo.
     5543       define variable v-old-full-name         as character    no-undo.
     5544       define variable v-base                  as decimal      no-undo.
     5545       define variable v-node-name             as character    no-undo.
     5546       define variable v-out-code              as integer        no-undo.
     5547       define variable v-cancel                as logical      no-undo.
     5548       define buffer buf_fbr-gds-grp               for ub.fbr-gds-grp.
     5549       define buffer buf_temp_fbrglib_grp       for temp_fbrglib_grp.
     5550       define buffer buf_child_temp_fbrglib_grp for temp_fbrglib_grp.
     5551       if p-node-code = v-fbrggrp-root-code
     5552       then do:
     5553           message
     5554           "Корневую группу изменить невозможно."
     5555           view-as alert-box warning.
     5556           undo, return .
     5557       end.
     5558       run check-rights-for-change-grp in this-procedure (
     5559           output v-have-rights
     5560       ) no-error.
     5561       if error-status :error
     5562       or v-have-rights = no
     5563       then do:
     5564           message
     5565             vss-workfile vss-revision vss-description
     5566             skip "Нет прав на изменение справочника групп блюд."
     5567             skip "Удаление группы невозможно."
     5568             skip return-value
     5569             skip trim(error-status :get-message(1))
     5570                  trim(error-status :get-message(2))
     5571                  trim(error-status :get-message(3))
     5572           view-as alert-box error.
     5573           undo, return error .
     5574       end.
     5575       assign
     5576           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     5577           v-repositioned-row = current-result-row( "br-list" )
     5578       .
     5579       do transaction
     5580       on error undo, return error
     5581       :
     5582           find first buf_fbr-gds-grp exclusive-lock
     5583                where buf_fbr-gds-grp.obj-type  = p-store-type
     5584                  and buf_fbr-gds-grp.obj-code  = p-store-code
     5585                  and buf_fbr-gds-grp.node-code = p-node-code
     5586           .
     5587           run ref/fbrggrpd.w (
     5588                 input parparentproc
     5589               , input 'ИЗМЕНЕНИЕ':U
     5590               , input p-store-type
     5591               , input p-store-code
     5592               , input buf_fbr-gds-grp.node-code
     5593               , input buf_fbr-gds-grp.upper-code
     5594               , input buf_fbr-gds-grp.node-name
     5595               , input buf_fbr-gds-grp.out-code
     5596               , output v-node-name
     5597               , output v-out-code
     5598               , output v-cancel
     5599           ).
     5600           if v-cancel = yes
     5601           then do:
     5602               undo, return.
     5603           end.
     5604           assign
     5605               buf_fbr-gds-grp.node-name   = v-node-name
     5606               buf_fbr-gds-grp.out-code    = v-out-code
     5607           .
     5608       end.
     5609       find first buf_temp_fbrglib_grp
     5610            where buf_temp_fbrglib_grp.node-code = p-node-code
     5611             AND buf_temp_fbrglib_grp.obj-type  = p-store-type
     5612             AND buf_temp_fbrglib_grp.obj-code  = p-store-code
     5613       no-error.
     5614       if not available buf_temp_fbrglib_grp
     5615       then do:
     5616           undo, return error "change-grp: Ошибка поиска группы в списке.".
     5617       end.
     5618       find first buf_fbr-gds-grp no-lock
     5619            where buf_fbr-gds-grp.obj-type  = p-store-type
     5620              and buf_fbr-gds-grp.obj-code  = p-store-code
     5621              and buf_fbr-gds-grp.node-code = p-node-code
     5622       no-error.
     5623       if error-status :error
     5624       then do:
     5625           undo, return error "change-grp: Неверный выбор группы.".
     5626       end.
     5627       if buf_temp_fbrglib_grp.level > 0
     5628       then do:
     5629           assign
     5630               buf_temp_fbrglib_grp.name    = substring( buf_temp_fbrglib_grp.name
     5631                                                       , 1
     5632                                                       , buf_temp_fbrglib_grp.level * 4 + 2 )
     5633                                               + buf_fbr-gds-grp.node-name
     5634           .
     5635       end.
     5636       else do:
     5637           assign
     5638               buf_temp_fbrglib_grp.name       = buf_fbr-gds-grp.node-name
     5639           .
     5640       end.
     5641       assign
     5642           v-old-full-name                 = buf_temp_fbrglib_grp.full-name
     5643           buf_temp_fbrglib_grp.out-code   = buf_fbr-gds-grp.out-code
     5644       .
     5645       run fbrglib-get-full-name in this-procedure (
     5646             input p-store-type
     5647           , input p-store-code
     5648           , input p-node-code
     5649           , output buf_temp_fbrglib_grp.full-name
     5650       ) no-error .
     5651       if error-status :error
     5652       then do:
     5653           undo, return error "Ошибка вычисления полного имени группы в списке".
     5654       end.
     5655       run fbrglib-get-sort-name in this-procedure (
     5656             input p-store-type
     5657           , input p-store-code
     5658           , input p-node-code
     5659           , output buf_temp_fbrglib_grp.sort-name
     5660       ) no-error .
     5661       if error-status :error
     5662       then do:
     5663           undo, return error "Ошибка вычисления полного имени группы в списке".
     5664       end.
     5665       if buf_temp_fbrglib_grp.level <> 0
     5666       then do:
     5667           assign
     5668               fi-search :screen-value = right-trim( buf_temp_fbrglib_grp.full-name, chr(47) )
     5669           .
     5670       end.
     5671       for each buf_child_temp_fbrglib_grp
     5672          where buf_child_temp_fbrglib_grp.full-name begins v-old-full-name
     5673            and buf_child_temp_fbrglib_grp.full-name <> v-old-full-name
     5674            and buf_child_temp_fbrglib_grp.level <> buf_temp_fbrglib_grp.level
     5675       :
     5676           run fbrglib-get-full-name in this-procedure (
     5677                 input p-store-type
     5678               , input p-store-code
     5679               , input buf_child_temp_fbrglib_grp.node-code
     5680               , output buf_child_temp_fbrglib_grp.full-name
     5681           ) no-error .
     5682           if error-status :error
     5683           then do:
     5684               undo, return error "Ошибка вычисления полного имени группы в списке".
     5685           end.
     5686           run fbrglib-get-sort-name in this-procedure (
     5687                 input p-store-type
     5688               , input p-store-code
     5689               , input buf_child_temp_fbrglib_grp.node-code
     5690               , output buf_child_temp_fbrglib_grp.sort-name
     5691           ) no-error .
     5692           if error-status :error
     5693           then do:
     5694               undo, return error "Ошибка вычисления полного имени группы в списке".
     5695           end.
     5696       end.
     5697       OPEN QUERY br-list FOR EACH temp_fbrglib_grp NO-LOCK where     temp_fbrglib_grp.obj-type = p-store-type  AND temp_fbrglib_grp.obj-code = p-store-code     by temp_fbrglib_grp.sort-name.
     5698       br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     5699       reposition br-list to row v-repositioned-row.
     5700   end.
     5701   END PROCEDURE.
     5702   PROCEDURE check-object :
     5703   do
     5704   on error undo, return error
     5705   :
     5706   define input parameter p-obj-type       as character    no-undo.
     5707   define input parameter p-obj-code       as integer      no-undo.
     5708   define output parameter p-is-invalid    as logical      no-undo.
     5709       define buffer buf_clients       for ub.clients.
     5710       find first buf_clients no-lock
     5711            where buf_clients.obj-type = p-obj-type
     5712              and buf_clients.obj-code = p-obj-code
     5713       no-error.
     5714       if not available buf_clients
     5715       then do:
     5716           assign
     5717               p-is-invalid = yes
     5718           .
     5719       end.
     5720       else do:
     5721           assign
     5722               p-is-invalid = no
     5723           .
     5724       end.
     5725   end.
     5726   END PROCEDURE.
     5727   PROCEDURE check-rights-for-change-grp :
     5728   do
     5729   on error undo, return error
     5730   :
     5731   define output parameter p-have-rights   as logical      no-undo.
     5732   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5733   do:
     5734     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5735       (input  v-cntxt-db-num
     5736       ,input  v-cntxt-userid
     5737       ,input  0
     5738       ,input  'actn_res-reference_update':U
     5739       ,input  'firm':U
     5740       ,input  v-cntxt-host-code-obj
     5741       ,input  '':U
     5742       ,input  0
     5743       ,input  0
     5744       ,input  0
     5745       ,input  0
     5746       ,input  no
     5747       ,output p-have-rights
     5748       )  .
     5749   end.
     5750   end.
     5751   END PROCEDURE.
     5752   PROCEDURE collapse-all-on-first-level :
     5753   define input parameter p-obj-type   as character    no-undo.
     5754   define input parameter p-obj-code   as integer      no-undo.
     5755   do
     5756   on error undo, return error
     5757   :
     5758       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     5759       define buffer buf_temp_fbrglib_grp       for temp_fbrglib_grp.
     5760       for each buf_temp_fbrglib_grp no-lock
     5761          where buf_temp_fbrglib_grp.obj-type = p-obj-type
     5762           AND buf_temp_fbrglib_grp.obj-code = p-obj-code
     5763           AND buf_temp_fbrglib_grp.upper-code = v-fbrggrp-root-code
     5764       :
     5765           run collapse-item in this-procedure (
     5766                 INPUT p-obj-type
     5767               , INPUT p-obj-code
     5768               , input buf_temp_fbrglib_grp.node-code
     5769               , input no
     5770           ) no-error .
     5771           if error-status :error
     5772           then do:
     5773               undo, return error "Не удалось закрыть подуровни группы "
     5774                                   + chr(10) + "'" + buf_temp_fbrglib_grp.full-name + "'"
     5775                                   + chr(10) + return-value.
     5776           end.
     5777       end.
     5778       IF p-obj-type = "":U  AND p-obj-code = 0 THEN DO:
     5779           OPEN QUERY br-global FOR EACH buf0_temp_fbrglib_grp NO-LOCK  WHERE   buf0_temp_fbrglib_grp.obj-type = "":U AND buf0_temp_fbrglib_grp.obj-code = 0 by buf0_temp_fbrglib_grp.sort-name.
     5780       END.
     5781       ELSE DO:
     5782           OPEN QUERY br-list FOR EACH temp_fbrglib_grp NO-LOCK where     temp_fbrglib_grp.obj-type = p-store-type  AND temp_fbrglib_grp.obj-code = p-store-code     by temp_fbrglib_grp.sort-name.
     5783       END.
     5784   end.
     5785   END PROCEDURE.
     5786   PROCEDURE collapse-item :
     5787   do
     5788   on error undo, return error
     5789   :
     5790   define input parameter p-obj-type   as character    no-undo.
     5791   define input parameter p-obj-code   as integer      no-undo.
     5792   define input parameter p-node-code as integer      no-undo.
     5793   define input parameter p-refresh    as logical      no-undo.
     5794       define variable v-focused-row       as integer              no-undo.
     5795       define variable v-repositioned-row  as integer              no-undo.
     5796       define buffer buf_del_temp_fbrglib_grp   for temp_fbrglib_grp.
     5797       define buffer buf_temp_fbrglib_grp       for temp_fbrglib_grp.
     5798       find first buf_temp_fbrglib_grp
     5799            where buf_temp_fbrglib_grp.obj-type   = p-obj-type
     5800              and buf_temp_fbrglib_grp.obj-code   = p-obj-code
     5801              AND buf_temp_fbrglib_grp.node-code = p-node-code
     5802       no-error.
     5803       if error-status :error
     5804       then do:
     5805           undo, return error substitute("collapse-item: Неверно передан код группы. Нет группы с кодом &1, объект &2&3"
     5806                                        ,p-node-code
     5807                                        ,p-obj-type
     5808                                        ,p-obj-code
     5809                                        ).
     5810       end.
     5811       IF p-obj-type = "":U AND p-obj-code = 0 THEN DO:
     5812           assign
     5813               v-focused-row      = br-global :focused-row in frame Dlg-grp.
     5814               v-repositioned-row = current-result-row( "br-global" )
     5815           .
     5816       END.
     5817       ELSE DO:
     5818           assign
     5819               v-focused-row      = br-list :focused-row in frame Dlg-grp.
     5820               v-repositioned-row = current-result-row( "br-list" )
     5821           .
     5822       END.
     5823       for each buf_del_temp_fbrglib_grp
     5824          where buf_del_temp_fbrglib_grp.full-name begins buf_temp_fbrglib_grp.full-name
     5825            and buf_del_temp_fbrglib_grp.full-name <> buf_temp_fbrglib_grp.full-name
     5826            and buf_del_temp_fbrglib_grp.level     <> buf_temp_fbrglib_grp.level
     5827            and buf_del_temp_fbrglib_grp.obj-type   = p-obj-type
     5828             and buf_del_temp_fbrglib_grp.obj-code   = p-obj-code
     5829       :
     5830           delete buf_del_temp_fbrglib_grp.
     5831       end.
     5832       assign
     5833           buf_temp_fbrglib_grp.mark = "»"
     5834           buf_temp_fbrglib_grp.name = replace( buf_temp_fbrglib_grp.name
     5835                                           , "«"
     5836                                           , "»"
     5837                                           )
     5838       .
     5839       if p-refresh = yes
     5840       then do:
     5841         IF p-obj-type = "":U and p-obj-code = 0 THEN DO:
     5842              OPEN QUERY br-global FOR EACH buf0_temp_fbrglib_grp NO-LOCK  WHERE   buf0_temp_fbrglib_grp.obj-type = "":U AND buf0_temp_fbrglib_grp.obj-code = 0 by buf0_temp_fbrglib_grp.sort-name.
     5843             br-global :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     5844             reposition br-global to row v-repositioned-row.
     5845         END.
     5846         ELSE DO:
     5847              OPEN QUERY br-list FOR EACH temp_fbrglib_grp NO-LOCK where     temp_fbrglib_grp.obj-type = p-store-type  AND temp_fbrglib_grp.obj-code = p-store-code     by temp_fbrglib_grp.sort-name.
     5848             br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     5849             reposition br-list to row v-repositioned-row.
     5850        END.
     5851       end.
     5852   end.
     5853   END PROCEDURE.
     5854   PROCEDURE copy-from-global-grp :
     5855   do
     5856   on error undo, return error
     5857   :
     5858   define input parameter p-node-code  as integer      no-undo.
     5859   define input parameter p-global-node-code  as integer      no-undo.
     5860   define input parameter p-global-code  as integer      no-undo.
     5861       define variable v-focused-row       as integer  no-undo.
     5862       define variable v-repositioned-row  as integer  no-undo.
     5863       define variable v-node-code    as integer        no-undo.
     5864       define variable v-have-rights       as logical       no-undo.
     5865       define variable v-have-goods        as logical  no-undo.
     5866       define variable v-cancel            as logical        no-undo.
     5867       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     5868       define buffer bf0_fbr-gds-grp           for ub.fbr-gds-grp.
     5869       define buffer buf_temp_fbrglib_grp   for temp_fbrglib_grp.
     5870       run check-rights-for-change-grp in this-procedure (
     5871           output v-have-rights
     5872       ) no-error.
     5873       if error-status :error
     5874       or v-have-rights = no
     5875       then do:
     5876           message
     5877             vss-workfile vss-revision vss-description
     5878             skip "Нет прав на изменение справочника групп блюд."
     5879             skip "Добавление групп(ы) невозможно."
     5880             skip return-value
     5881             skip trim(error-status :get-message(1))
     5882                  trim(error-status :get-message(2))
     5883                  trim(error-status :get-message(3))
     5884           view-as alert-box error.
     5885           undo, return error .
     5886       end.
     5887       assign
     5888           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     5889           v-repositioned-row = current-result-row( "br-list" )
     5890       .
     5891       run fbrglib-have-goods in this-procedure (
     5892             input p-store-type
     5893           , input p-store-code
     5894           , input p-node-code
     5895           , output v-have-goods
     5896       ) no-error .
     5897       if error-status :error
     5898       then do:
     5899           message
     5900                    vss-workfile vss-revision vss-description
     5901               skip "Ошибка определения наличия товаров в группе."
     5902               skip return-value
     5903               skip trim(error-status :get-message(1))
     5904                    trim(error-status :get-message(2))
     5905                    trim(error-status :get-message(3))
     5906           view-as alert-box error.
     5907           undo, return error .
     5908       end.
     5909       if v-have-goods = yes
     5910       then do:
     5911           message "В данной группе есть товары. Добавить в нее подгруппу,"
     5912                   "включающую эти товары ?"
     5913           view-as alert-box question
     5914           buttons OK-Cancel
     5915           update v-yesno as logical.
     5916           if v-yesno = no
     5917           then do:
     5918               return.
     5919           end.
     5920       end.
     5921       find first bf0_fbr-gds-grp
     5922            where bf0_fbr-gds-grp.node-code = p-global-node-code
     5923               AND bf0_fbr-gds-grp.obj-type = "":U
     5924               AND bf0_fbr-gds-grp.obj-code = 0
     5925       .
     5926       find first buf_temp_fbrglib_grp
     5927            where buf_temp_fbrglib_grp.node-code = p-node-code
     5928               AND buf_temp_fbrglib_grp.obj-type = p-store-type
     5929               AND buf_temp_fbrglib_grp.obj-code = p-store-code
     5930       .
     5931       if buf_temp_fbrglib_grp.mark = "»"
     5932       then do:
     5933           run expand-item in this-procedure ( INPUT p-store-type, p-store-code, input p-node-code, input no ) no-error.
     5934           if error-status :error
     5935           then do:
     5936               undo, return error "copy-from-global-grp: Не удается раскрыть группу.".
     5937           end.
     5938       end.
     5939       RUN add-grp-branch-cycle in this-procedure (
     5940             input p-node-code
     5941           , INPUT p-global-node-code
     5942           , INPUT bf0_fbr-gds-grp.node-name
     5943           , INPUT bf0_fbr-gds-grp.out-code
     5944           , INPUT p-global-code
     5945           , INPUT (buf_temp_fbrglib_grp.level + 1)
     5946       ).
     5947      if buf_temp_fbrglib_grp.level > 0
     5948       then do:
     5949           assign
     5950               buf_temp_fbrglib_grp.mark = "«"
     5951               buf_temp_fbrglib_grp.name = substring( buf_temp_fbrglib_grp.name, 1, buf_temp_fbrglib_grp.level * 4 )
     5952                                   + "«"
     5953                                   + substring( buf_temp_fbrglib_grp.name, buf_temp_fbrglib_grp.level * 4 + 2 )
     5954           .
     5955       end.
     5956       OPEN QUERY br-list FOR EACH temp_fbrglib_grp NO-LOCK where     temp_fbrglib_grp.obj-type = p-store-type  AND temp_fbrglib_grp.obj-code = p-store-code     by temp_fbrglib_grp.sort-name.
     5957       br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     5958       reposition br-list to row v-repositioned-row.
     5959   end.
     5960   END PROCEDURE.
     5961   PROCEDURE copy-group-list-from-obj :
     5962   define input parameter p-from-obj-type  as character    no-undo.
     5963   define input parameter p-from-obj-code  as integer      no-undo.
     5964   define input parameter p-to-obj-type    as character    no-undo.
     5965   define input parameter p-to-obj-code    as integer      no-undo.
     5966       define variable v-fbr-gds-obj-recid     as recid        no-undo.
     5967       define variable v-grp-counter    as integer        no-undo.
     5968       define buffer buf_from_fbr-gds-grp  for ub.fbr-gds-grp.
     5969       define buffer buf_to_fbr-gds-grp    for ub.fbr-gds-grp.
     5970       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     5971       define buffer buf_from_fbr-gds-obj  for ub.fbr-gds-obj.
     5972       define buffer buf_to_fbr-gds-obj    for ub.fbr-gds-obj.
     5973   do
     5974   for buf_from_fbr-gds-grp
     5975     , buf_to_fbr-gds-grp
     5976     , buf_fbr-gds-grp
     5977     , buf_from_fbr-gds-obj
     5978     , buf_to_fbr-gds-obj
     5979   on error undo, return error
     5980   :
     5981       find first buf_to_fbr-gds-grp no-lock
     5982            where buf_to_fbr-gds-grp.obj-type = p-to-obj-type
     5983              and buf_to_fbr-gds-grp.obj-code = p-to-obj-code
     5984       no-error.
     5985       if available buf_to_fbr-gds-grp
     5986       then do:
     5987           message
     5988                    "На объекте, куда надо копировать группы,"
     5989               skip "уже есть группы блюд."
     5990               skip(1)
     5991               skip "Копирование невозможно."
     5992           view-as alert-box error.
     5993           undo, return error .
     5994       end.
     5995       for each buf_from_fbr-gds-grp no-lock
     5996          where buf_from_fbr-gds-grp.obj-type = p-from-obj-type
     5997            and buf_from_fbr-gds-grp.obj-code = p-from-obj-code
     5998       on error undo, return error
     5999       :
     6000           create buf_to_fbr-gds-grp.
     6001           buffer-copy
     6002               buf_from_fbr-gds-grp
     6003               except
     6004                   buf_from_fbr-gds-grp.obj-type
     6005                   buf_from_fbr-gds-grp.obj-code
     6006                   buf_from_fbr-gds-grp.node-code
     6007               to buf_to_fbr-gds-grp
     6008           .
     6009           assign
     6010               buf_to_fbr-gds-grp.obj-type     = p-to-obj-type
     6011               buf_to_fbr-gds-grp.obj-code     = p-to-obj-code
     6012               buf_to_fbr-gds-grp.node-code    = buf_from_fbr-gds-grp.node-code
     6013           .
     6014           for each buf_from_fbr-gds-obj no-lock
     6015              where buf_from_fbr-gds-obj.obj-type      = p-from-obj-type
     6016                and buf_from_fbr-gds-obj.obj-code      = p-from-obj-code
     6017                and buf_from_fbr-gds-obj.fbr-grp-code  = buf_from_fbr-gds-grp.node-code
     6018           on error undo, return error
     6019           :
     6020               find first buf_to_fbr-gds-obj exclusive-lock
     6021                    where buf_to_fbr-gds-obj.obj-type = p-to-obj-type
     6022                      and buf_to_fbr-gds-obj.obj-code = p-to-obj-code
     6023                      and buf_to_fbr-gds-obj.gds-code = buf_from_fbr-gds-obj.gds-code
     6024               no-error.
     6025               if not available buf_to_fbr-gds-obj
     6026               then do:
     6027                   run ref/fgdsobj1.p (
     6028                         input-output v-fbr-gds-obj-recid
     6029                       , input 'ДОБАВЛЕНИЕ':U
     6030                       , input no
     6031                       , input buf_from_fbr-gds-obj.gds-code
     6032                       , input p-to-obj-type
     6033                       , input p-to-obj-code
     6034                       , input buf_to_fbr-gds-grp.node-code
     6035                       , input ""
     6036                       , input 0
     6037                       , input no
     6038                       , input no
     6039                       , input no
     6040                       , input no
     6041                       , input no
     6042                       , input no
     6043                  ) no-error.
     6044                  if error-status :error
     6045                  then do:
     6046                      message
     6047                            vss-workfile vss-revision vss-description
     6048                       skip "Ошибка при создании записи товара производства на объекте."
     6049                       skip return-value
     6050                       skip trim(error-status :get-message(1))
     6051                            trim(error-status :get-message(2))
     6052                            trim(error-status :get-message(3))
     6053                      view-as alert-box error.
     6054                      undo, return error .
     6055                  end.
     6056               end.
     6057               else do:
     6058                   assign
     6059                       v-fbr-gds-obj-recid = recid( buf_to_fbr-gds-obj )
     6060                   .
     6061                   run ref/fgdsobj1.p (
     6062                         input-output v-fbr-gds-obj-recid
     6063                       , input 'ИЗМЕНЕНИЕ':U
     6064                       , input no
     6065                       , input buf_to_fbr-gds-obj.gds-code
     6066                       , input buf_to_fbr-gds-obj.obj-type
     6067                       , input buf_to_fbr-gds-obj.obj-code
     6068                       , input buf_from_fbr-gds-grp.node-code
     6069                       , input buf_to_fbr-gds-obj.obj-type
     6070                       , input buf_to_fbr-gds-obj.obj-code
     6071                       , input buf_to_fbr-gds-obj.is-cd
     6072                       , input buf_to_fbr-gds-obj.is-menu
     6073                       , input buf_to_fbr-gds-obj.is-modificator
     6074                       , input buf_to_fbr-gds-obj.is-null-price
     6075                       , input buf_to_fbr-gds-obj.is-season
     6076                       , input buf_to_fbr-gds-obj.is-semi-finished
     6077                  ) no-error.
     6078                  if error-status :error
     6079                  then do:
     6080                      message
     6081                            vss-workfile vss-revision vss-description
     6082                       skip "Ошибка при изменении записи товара производства на объекте."
     6083                       skip return-value
     6084                       skip trim(error-status :get-message(1))
     6085                            trim(error-status :get-message(2))
     6086                            trim(error-status :get-message(3))
     6087                      view-as alert-box error.
     6088                      undo, return error .
     6089                  end.
     6090               end.
     6091           end.
     6092       end.
     6093   end.
     6094   END PROCEDURE.
     6095   PROCEDURE create-new-line :
     6096   do
     6097   on error undo, return error
     6098   :
     6099   define input parameter p-obj-type       as character    no-undo.
     6100   define input parameter p-obj-code       as integer      no-undo.
     6101   define input parameter p-node-code      as integer      no-undo.
     6102   define input parameter p-upper-code     as integer      no-undo.
     6103   define input parameter p-level          as integer      no-undo.
     6104   define input parameter p-node-name      as character    no-undo.
     6105   define input parameter p-out-code       as integer      no-undo.
     6106   define input parameter p-global-code    as integer      no-undo.
     6107   define variable v-full-name         as character         no-undo.
     6108   define variable v-sort-name         as character         no-undo.
     6109   define variable v-margins-range     as integer           no-undo.
     6110   define variable v-margins-exists    as logical           no-undo.
     6111   define variable v-increase-range    as integer          no-undo.
     6112   define variable v-increase-exists   as logical          no-undo.
     6113   define variable v-min-marg          as decimal           no-undo.
     6114   define variable v-max-marg          as decimal           no-undo.
     6115   define variable v-increase-pc       as decimal           no-undo.
     6116   define variable v-round-method      as character         no-undo .
     6117   define variable v-base              as decimal           no-undo .
     6118   define variable v-rmethod-range     as integer           no-undo.
     6119   define variable v-rmethod-exists    as logical           no-undo.
     6120   define buffer buf_temp_fbrglib_grp       for temp_fbrglib_grp.
     6121       run fbrglib-get-full-name in this-procedure (
     6122                 input p-obj-type
     6123               , input p-obj-code
     6124               , input p-node-code
     6125               , output v-full-name
     6126       ) no-error .
     6127       if error-status :error
     6128       then do:
     6129           undo, return error "create-new-line: Ошибка вычисления полного имени группы." .
     6130       end.
     6131       run fbrglib-get-sort-name in this-procedure (
     6132                 input p-obj-type
     6133               , input p-obj-code
     6134               , input p-node-code
     6135               , output v-sort-name
     6136       ) no-error .
     6137       if error-status :error
     6138       then do:
     6139           undo, return error "create-new-line: Ошибка вычисления полного имени группы." .
     6140       end.
     6141       create buf_temp_fbrglib_grp.
     6142       assign
     6143           buf_temp_fbrglib_grp.node-code   = p-node-code
     6144           buf_temp_fbrglib_grp.upper-code  = p-upper-code
     6145           buf_temp_fbrglib_grp.level       = p-level
     6146           buf_temp_fbrglib_grp.out-code    = p-out-code
     6147           buf_temp_fbrglib_grp.full-name   = v-full-name
     6148           buf_temp_fbrglib_grp.sort-name   = v-sort-name
     6149           buf_temp_fbrglib_grp.obj-type    = p-obj-type
     6150           buf_temp_fbrglib_grp.obj-code    = p-obj-code
     6151           buf_temp_fbrglib_grp.global-code = p-global-code
     6152       .
     6153       run get-first-char in this-procedure (
     6154             input p-obj-type
     6155           , input p-obj-code
     6156           , input p-node-code
     6157           , output buf_temp_fbrglib_grp.mark
     6158       ) no-error.
     6159       if error-status :error
     6160       then do:
     6161           undo, return error "create-new-line: Ошибка вычисления первого символа для отображения группы." .
     6162       end.
     6163       assign
     6164           buf_temp_fbrglib_grp.name = fill( " ", 4 * p-level )
     6165                                           + buf_temp_fbrglib_grp.mark
     6166                                           + " "
     6167                                           + p-node-name
     6168       .
     6169   end.
     6170   END PROCEDURE.
     6171   PROCEDURE delete-grp :
     6172   do
     6173   on error undo, return error
     6174   :
     6175   define input parameter p-node-code  as integer      no-undo.
     6176   define input parameter p-refresh    as logical      no-undo.
     6177       define variable v-focused-row       as integer  no-undo.
     6178       define variable v-repositioned-row  as integer  no-undo.
     6179       define variable v-upper-code        as integer  no-undo.
     6180       define variable v-have-rights       as logical  no-undo.
     6181       define variable v-deleted           as logical        no-undo.
     6182       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     6183       define buffer buf_temp_fbrglib_grp      for temp_fbrglib_grp.
     6184       if p-node-code = v-fbrggrp-root-code
     6185       then do:
     6186           message
     6187           "Корневую группу удалить невозможно."
     6188           view-as alert-box warning.
     6189           undo, return .
     6190       end.
     6191       run check-rights-for-change-grp in this-procedure (
     6192           output v-have-rights
     6193       ) no-error.
     6194       if error-status :error
     6195       or v-have-rights = no
     6196       then do:
     6197           message
     6198             vss-workfile vss-revision vss-description
     6199             skip "Нет прав на изменение справочника групп блюд."
     6200             skip "Удаление группы невозможно."
     6201             skip return-value
     6202             skip trim(error-status :get-message(1))
     6203                  trim(error-status :get-message(2))
     6204                  trim(error-status :get-message(3))
     6205           view-as alert-box error.
     6206           undo, return .
     6207       end.
     6208       assign
     6209           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     6210           v-repositioned-row = current-result-row( "br-list" )
     6211       .
     6212       find first buf_temp_fbrglib_grp
     6213            where buf_temp_fbrglib_grp.node-code = p-node-code
     6214           AND buf_temp_fbrglib_grp.obj-type = p-store-type
     6215           AND buf_temp_fbrglib_grp.obj-code = p-store-code
     6216       no-error .
     6217       if error-status :error
     6218       then do:
     6219           undo, return error "Неверно выбрана группа." .
     6220       end.
     6221       assign
     6222           v-upper-code = buf_temp_fbrglib_grp.upper-code
     6223       .
     6224       run fbrglib-delete-grp in this-procedure (
     6225             input p-store-type
     6226           , input p-store-code
     6227           , input p-node-code
     6228           , output v-deleted
     6229       ) no-error .
     6230       if error-status:error then do:
     6231         message
     6232         "Ошибка при удалении группы блюд"
     6233         error-status:get-message(1) skip
     6234         return-value
     6235         view-as alert-box error .
     6236         undo, return error .
     6237       end.
     6238       if p-refresh = yes
     6239       then do:
     6240           if v-upper-code = 1
     6241           then do:
     6242               find first buf_fbr-gds-grp no-lock
     6243                    where buf_fbr-gds-grp.node-code = 1
     6244               no-error.
     6245               if not available buf_fbr-gds-grp
     6246               then do:
     6247                   undo, return error "delete-grp: Не найдена корневая группа в БД".
     6248               end.
     6249           end.
     6250           else do:
     6251               find first buf_fbr-gds-grp no-lock
     6252                    where buf_fbr-gds-grp.obj-type  = p-store-type
     6253                      and buf_fbr-gds-grp.obj-code  = p-store-code
     6254                      and buf_fbr-gds-grp.node-code = v-upper-code
     6255               no-error.
     6256               if not available buf_fbr-gds-grp
     6257               then do:
     6258                   undo, return error "delete-grp: Не найдена группа в БД".
     6259               end.
     6260           end.
     6261           assign
     6262               p-recid-list     = string( recid( buf_fbr-gds-grp ) )
     6263               fbr-gds-grp-row  = recid( buf_fbr-gds-grp )
     6264           .
     6265           assign
     6266           entry(v-rubr-mode + 1, v-uf-List_,  chr(4)) = if fbr-gds-grp-row = ?
     6267                                                               then chr(63)
     6268                                                               else string(fbr-gds-grp-row)
     6269           .
     6270           run uf-set in this-procedure (
     6271                input  'fbr-gds-grp-p':U
     6272               ,input  v-cntxt-userid
     6273               ,input v-uf-List_
     6274               ,input v-uf-Naim
     6275               ,input v-uf-print-graft
     6276               ,input v-uf-sort-gr
     6277               ,input v-uf-type-price
     6278               ,input v-uf-type-val
     6279           )  no-error .
     6280           run UI-on in this-procedure no-error .
     6281           if error-status :error
     6282           then do:
     6283               undo, return error "delete-grp: Ошибка при загрузке дерева групп.".
     6284           end.
     6285       end.
     6286   end.
     6287   END PROCEDURE.
     6288   PROCEDURE disable_UI :
     6289     HIDE FRAME Dlg-grp.
     6290   END PROCEDURE.
     6291   PROCEDURE enable_UI :
     6292     DISPLAY fi-kitchen-type fi-kitchen-code fi-search-0 fi-search
     6293         WITH FRAME Dlg-grp.
     6294     ENABLE b-exit RECT-rubr b-mark b-sel b-add b-chg b-del b-move b-goods b-print
     6295            b-help B-global b-copy fi-kitchen-code bt-sel-kitchen B-hist
     6296            b-expand-0 b-expand-all-0 fi-search-0 b-find-by-full-name-0
     6297            b-find-by-substring-0 b-search-0 b-expand b-expand-all fi-search
     6298            b-find-by-full-name b-find-by-substring b-search B-copy0 B-link
     6299            br-global br-list
     6300         WITH FRAME Dlg-grp.
     6301     VIEW FRAME Dlg-grp.
     6302     OPEN QUERY br-global FOR EACH buf0_temp_fbrglib_grp NO-LOCK  WHERE   buf0_temp_fbrglib_grp.obj-type = "":U AND buf0_temp_fbrglib_grp.obj-code = 0 by buf0_temp_fbrglib_grp.sort-name.    OPEN QUERY br-list FOR EACH temp_fbrglib_grp NO-LOCK where     temp_fbrglib_grp.obj-type = p-store-type  AND temp_fbrglib_grp.obj-code = p-store-code     by temp_fbrglib_grp.sort-name.
     6303   END PROCEDURE.
     6304   PROCEDURE expand-all-from-current :
     6305   do
     6306   on error undo, return error
     6307   :
     6308   define input parameter p-obj-type   as character    no-undo.
     6309   define input parameter p-obj-code   as integer      no-undo.
     6310   define input parameter p-node-code as integer      no-undo.
     6311       define variable v-full-name     as character         no-undo.
     6312       define variable v-focused-row       as integer              no-undo.
     6313       define variable v-repositioned-row  as integer              no-undo.
     6314       define buffer buf_temp_fbrglib_grp       for temp_fbrglib_grp.
     6315       assign
     6316           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     6317           v-repositioned-row = current-result-row( "br-list" )
     6318       .
     6319       run fbrglib-get-full-name in this-procedure (
     6320                 input p-obj-type
     6321               , input p-obj-code
     6322               , input p-node-code
     6323               , output v-full-name
     6324       ) no-error .
     6325       if error-status :error
     6326       then do:
     6327           undo, return error "expand-all-from-current: Ошибка вычисления полного имени группы".
     6328       end.
     6329       for each buf_temp_fbrglib_grp
     6330          where buf_temp_fbrglib_grp.full-name begins v-full-name
     6331           AND buf_temp_fbrglib_grp.obj-type = p-obj-type
     6332           AND buf_temp_fbrglib_grp.obj-code = p-obj-code
     6333       :
     6334           run expand-item in this-procedure (INPUT p-obj-type, INPUT p-obj-code,  input buf_temp_fbrglib_grp.node-code, input no ) no-error .
     6335           if error-status :error
     6336           then do:
     6337               undo, return error "expand-all-from-current: Не удалось раскрыть подуровни группы.".
     6338           end.
     6339       end.
     6340       IF p-obj-type = "":U AND p-obj-code = 0 THEN DO:
     6341           OPEN QUERY br-global FOR EACH buf0_temp_fbrglib_grp NO-LOCK  WHERE   buf0_temp_fbrglib_grp.obj-type = "":U AND buf0_temp_fbrglib_grp.obj-code = 0 by buf0_temp_fbrglib_grp.sort-name.
     6342           br-global :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp .
     6343           reposition br-global to row v-repositioned-row no-error .
     6344       END.
     6345       ELSE DO:
     6346         OPEN QUERY br-list FOR EACH temp_fbrglib_grp NO-LOCK where     temp_fbrglib_grp.obj-type = p-store-type  AND temp_fbrglib_grp.obj-code = p-store-code     by temp_fbrglib_grp.sort-name.
     6347         br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     6348        reposition br-list to row v-repositioned-row no-error .
     6349       END.
     6350   end.
     6351   END PROCEDURE.
     6352   PROCEDURE expand-item :
     6353   do
     6354   on error undo, return error
     6355   :
     6356   define input parameter p-obj-type   as character    no-undo.
     6357   define input parameter p-obj-code   as integer      no-undo.
     6358   define input parameter p-node-code  as integer      no-undo.
     6359   define input parameter p-refresh    as logical      no-undo.
     6360       define variable v-focused-row       as integer              no-undo.
     6361       define variable v-repositioned-row  as integer              no-undo.
     6362       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     6363       define buffer buf_temp_fbrglib_grp   for temp_fbrglib_grp.
     6364       IF p-obj-type = "":U AND p-obj-code = 0 THEN DO:
     6365           assign
     6366               v-focused-row      = br-global :focused-row in frame Dlg-grp.
     6367               v-repositioned-row = current-result-row( "br-global" )
     6368           .
     6369       END.
     6370       ELSE DO:
     6371           assign
     6372               v-focused-row      = br-list :focused-row in frame Dlg-grp.
     6373               v-repositioned-row = current-result-row( "br-list" )
     6374           .
     6375       END.
     6376       find first buf_temp_fbrglib_grp
     6377            where buf_temp_fbrglib_grp.obj-type = p-obj-type
     6378           AND buf_temp_fbrglib_grp.obj-code = p-obj-code
     6379           AND buf_temp_fbrglib_grp.node-code = p-node-code
     6380       no-error .
     6381       if not available buf_temp_fbrglib_grp
     6382       then do:
     6383           undo, return error "expand-item: Неверно задан код группы.".
     6384       end.
     6385       if buf_temp_fbrglib_grp.mark <> "»"
     6386       then do:
     6387       end.
     6388       else do:
     6389           for each buf_fbr-gds-grp no-lock
     6390              where buf_fbr-gds-grp.obj-type   = p-obj-type
     6391                and buf_fbr-gds-grp.obj-code   = p-obj-code
     6392                and buf_fbr-gds-grp.upper-code = p-node-code
     6393           on error undo, return error
     6394           :
     6395               run create-new-line in this-procedure (
     6396                     input p-obj-type
     6397                   , input p-obj-code
     6398                   , input buf_fbr-gds-grp.node-code
     6399                   , input buf_fbr-gds-grp.upper-code
     6400                   , input buf_temp_fbrglib_grp.level + 1
     6401                   , input buf_fbr-gds-grp.node-name
     6402                   , input buf_fbr-gds-grp.out-code
     6403                   , input buf_fbr-gds-grp.global-code
     6404               ) no-error .
     6405               if error-status :error
     6406               then do:
     6407                   message
     6408                   vss-workfile vss-revision vss-description
     6409                   skip "expand-item: Ошибка добавления строки в список групп."
     6410                   skip return-value
     6411                   skip trim(error-status :get-message(1))
     6412                       trim(error-status :get-message(2))
     6413                       trim(error-status :get-message(3))
     6414                       trim(error-status :get-message(4))
     6415                       trim(error-status :get-message(5))
     6416                   view-as alert-box error.
     6417                   undo, return error .
     6418               end.
     6419           end.
     6420           assign
     6421               buf_temp_fbrglib_grp.mark = "«"
     6422               buf_temp_fbrglib_grp.name = replace( buf_temp_fbrglib_grp.name
     6423                                               , "»"
     6424                                               , "«"
     6425                                               )
     6426           .
     6427           if p-refresh = yes
     6428           then do:
     6429              IF p-obj-type = "":U AND p-obj-code = 0 THEN DO:
     6430               OPEN QUERY br-global FOR EACH buf0_temp_fbrglib_grp NO-LOCK  WHERE   buf0_temp_fbrglib_grp.obj-type = "":U AND buf0_temp_fbrglib_grp.obj-code = 0 by buf0_temp_fbrglib_grp.sort-name.
     6431               if v-focused-row > br-global :height - 2
     6432               then do:
     6433                   assign
     6434                       v-focused-row       = br-global :height - 2
     6435                   .
     6436               end.
     6437               br-global :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     6438               reposition br-global to row v-repositioned-row.
     6439              END.
     6440              ELSE DO:
     6441               OPEN QUERY br-list FOR EACH temp_fbrglib_grp NO-LOCK where     temp_fbrglib_grp.obj-type = p-store-type  AND temp_fbrglib_grp.obj-code = p-store-code     by temp_fbrglib_grp.sort-name.
     6442               if v-focused-row > br-list :height - 2
     6443               then do:
     6444                   assign
     6445                       v-focused-row       = br-list :height - 2
     6446                   .
     6447               end.
     6448               br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     6449               reposition br-list to row v-repositioned-row.
     6450              END.
     6451           end.
     6452       end.
     6453   end.
     6454   END PROCEDURE.
     6455   PROCEDURE expand-or-collapse-item :
     6456   define input parameter p-obj-type   as character    no-undo.
     6457   define input parameter p-obj-code   as integer      no-undo.
     6458   DEFINE INPUT PARAMETER p-grp-mark LIKE temp_fbrglib_grp.mark NO-UNDO.
     6459   DEFINE INPUT PARAMETER p-node-code LIKE temp_fbrglib_grp.node-code NO-UNDO.
     6460   do
     6461   on error undo, return error
     6462   :
     6463       case p-grp-mark
     6464       :
     6465       when "»"
     6466       then do:
     6467           run expand-item in this-procedure ( INPUT p-obj-type, INPUT p-obj-code, input p-node-code, input yes ) no-error .
     6468           if error-status :error
     6469           then do:
     6470               undo, return error "Не удалось раскрыть подуровни группы.".
     6471           end.
     6472       end.
     6473       when "«"
     6474       then do:
     6475           run collapse-item in this-procedure (INPUT p-obj-type, INPUT p-obj-code, input p-node-code, input yes ) no-error .
     6476           if error-status :error
     6477           then do:
     6478               undo, return error "Не удалось закрыть подуровни группы.".
     6479           end.
     6480       end.
     6481       end case.
     6482   end.
     6483   END PROCEDURE.
     6484   PROCEDURE expand-tree-for-grp :
     6485   do
     6486   on error undo, return error
     6487   :
     6488   define input parameter p-obj-type               as character        no-undo.
     6489   define input parameter p-obj-code               as integer          no-undo.
     6490   define input parameter p-node-code              as integer          no-undo.
     6491   define output parameter p-focused-row           as integer          no-undo.
     6492   define output parameter p-reposition-row        as integer          no-undo.
     6493   define output parameter p-reposition-to-recid   as logical init no  no-undo.
     6494   define variable v-full-name             as character        no-undo.
     6495   define buffer buf_temp_fbrglib_grp       for temp_fbrglib_grp.
     6496       run fbrglib-get-full-name in this-procedure (
     6497             input p-obj-type
     6498           , input p-obj-code
     6499           , input p-node-code
     6500           , output v-full-name ) no-error .
     6501       if error-status :error
     6502       then do:
     6503       end.
     6504       else do:
     6505           run fbrglib-find-grp-by-full-name in this-procedure (
     6506                 input p-obj-type
     6507               , input p-obj-code
     6508               , input right-trim( v-full-name, chr(47) )
     6509               , input yes
     6510           ) no-error .
     6511           if error-status :error
     6512           then do:
     6513           end.
     6514           else do:
     6515               process-initial-grp:
     6516               for each temp_fbrglib_found-grp
     6517               where temp_fbrglib_found-grp.obj-type = p-obj-type
     6518               AND temp_fbrglib_found-grp.obj-code = p-obj-code
     6519               break
     6520               by temp_fbrglib_found-grp.obj-type
     6521               by temp_fbrglib_found-grp.obj-code
     6522               by temp_fbrglib_found-grp.level
     6523               on error undo, leave process-initial-grp :
     6524                   if last ( temp_fbrglib_found-grp.level )
     6525                   then do:
     6526                       assign
     6527                           p-focused-row       = integer( if v-rubr-mode = 0
     6528                                                          then ((br-list :height in frame Dlg-grp / 2 ) + 1)
     6529                                                          else ((br-global :height in frame Dlg-grp / 2 ) + 1))
     6530                       .
     6531                       find first buf_temp_fbrglib_grp
     6532                            where buf_temp_fbrglib_grp.node-code = temp_fbrglib_found-grp.node-code
     6533                             AND buf_temp_fbrglib_grp.obj-type  = temp_fbrglib_found-grp.obj-type
     6534                             AND buf_temp_fbrglib_grp.obj-code  = temp_fbrglib_found-grp.obj-code
     6535                       no-error .
     6536                       if error-status :error
     6537                       then do:
     6538                           leave process-initial-grp.
     6539                       end.
     6540                       assign
     6541                           p-reposition-row = recid( buf_temp_fbrglib_grp )
     6542                           p-reposition-to-recid = yes
     6543                       .
     6544                       leave process-initial-grp.
     6545                   end.
     6546                   else do:
     6547                       run expand-item in this-procedure ( input temp_fbrglib_found-grp.obj-type, input temp_fbrglib_found-grp.obj-code,  input temp_fbrglib_found-grp.node-code, input no ) no-error .
     6548                       if error-status :error
     6549                       then do:
     6550                           leave process-initial-grp.
     6551                       end.
     6552                       find first buf_temp_fbrglib_grp
     6553                               where buf_temp_fbrglib_grp.node-code = temp_fbrglib_found-grp.node-code
     6554                                 AND buf_temp_fbrglib_grp.obj-type  = temp_fbrglib_found-grp.obj-type
     6555                                 AND buf_temp_fbrglib_grp.obj-code  = temp_fbrglib_found-grp.obj-code
     6556                       no-error .
     6557                       if error-status :error
     6558                       then do:
     6559                           leave process-initial-grp.
     6560                       end.
     6561                       assign
     6562                           p-reposition-row = recid( buf_temp_fbrglib_grp )
     6563                           p-reposition-to-recid = yes
     6564                       .
     6565                   end.
     6566               end.
     6567           end.
     6568       end.
     6569   end.
     6570   END PROCEDURE.
     6571   PROCEDURE fill-marg :
     6572   do
     6573   on error undo, return error
     6574   :
     6575   define input parameter p-node-code as integer      no-undo.
     6576       define variable v-focused-row       as integer  no-undo.
     6577       define variable v-repositioned-row  as integer  no-undo.
     6578       define variable v-margins-range     as integer  no-undo.
     6579       define variable v-margins-exists    as logical  no-undo.
     6580       define variable v-increase-range     as integer  no-undo.
     6581       define variable v-increase-exists    as logical  no-undo.
     6582       define variable v-min-marg          as decimal  no-undo.
     6583       define variable v-max-marg          as decimal  no-undo.
     6584       define variable v-increase-pc          as decimal  no-undo.
     6585       define variable v-round-method      as character   no-undo .
     6586       define variable v-base              as decimal     no-undo .
     6587       define variable v-rmethod-range     as integer     no-undo.
     6588       define variable v-rmethod-exists    as logical     no-undo.
     6589       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     6590       define buffer buf_temp_fbrglib_grp   for temp_fbrglib_grp.
     6591       assign
     6592           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     6593           v-repositioned-row = current-result-row( "br-list" )
     6594       .
     6595       run ref/pr-marg.w (
     6596             input parparentproc
     6597           , input p-node-code
     6598       ) no-error.
     6599       if error-status :error
     6600       then do:
     6601           undo, return error "fill-marg: Ошибка при установке диапазона торговых наценок." + chr(10) + return-value.
     6602       end.
     6603       find first buf_temp_fbrglib_grp
     6604            where buf_temp_fbrglib_grp.node-code = p-node-code
     6605            AND buf_temp_fbrglib_grp.obj-type  = p-store-type
     6606            AND buf_temp_fbrglib_grp.obj-code  = p-store-code
     6607       no-error .
     6608       if error-status :error
     6609       then do:
     6610           undo, return error "fill-marg: Неверно задан код группы.".
     6611       end.
     6612       OPEN QUERY br-list FOR EACH temp_fbrglib_grp NO-LOCK where     temp_fbrglib_grp.obj-type = p-store-type  AND temp_fbrglib_grp.obj-code = p-store-code     by temp_fbrglib_grp.sort-name.
     6613       br-list :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dlg-grp.
     6614       reposition br-list to row v-repositioned-row.
     6615   end.
     6616   END PROCEDURE.
     6617   PROCEDURE fill-output-parameters-on-exit :
     6618   do
     6619   on error undo, return error
     6620   :
     6621   define input parameter p-obj-type as character no-undo .
     6622   define input parameter p-obj-code as integer no-undo .
     6623   define input parameter p-node-code as integer      no-undo.
     6624       define variable v-selected      as logical  init no  no-undo.
     6625       define variable v-is-terminal   as logical           no-undo.
     6626       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     6627       define buffer buf_temp_fbrglib_grp   for temp_fbrglib_grp.
     6628       run fbrglib-is-terminal in this-procedure (
     6629             input p-obj-type
     6630           , input p-obj-code
     6631           , input p-node-code
     6632           , output v-is-terminal
     6633       ) no-error.
     6634       if error-status :error
     6635       then do:
     6636           message
     6637                    vss-workfile vss-revision vss-description
     6638               skip "fill-output-parameters-on-exit: Не удается определить, корневая группа или терминальная."
     6639               skip return-value
     6640               skip trim(error-status :get-message(1))
     6641                    trim(error-status :get-message(2))
     6642                    trim(error-status :get-message(3))
     6643           view-as alert-box error.
     6644           undo, return error .
     6645       end.
     6646       if lookup ( 'терм':U, p-button-list ) <> 0
     6647       and v-is-terminal = no
     6648       then do:
     6649           message "Требуется выбрать группу блюд, в которой нет других групп.".
     6650           apply "entry" to br-list in frame Dlg-grp.
     6651           return no-apply.
     6652       end.
     6653       assign
     6654           p-recid-list = ""
     6655       .
     6656       for each buf_temp_fbrglib_grp
     6657          where buf_temp_fbrglib_grp.sel = "*"
     6658             AND buf_temp_fbrglib_grp.obj-type =  p-obj-type
     6659             AND buf_temp_fbrglib_grp.obj-code = p-obj-code
     6660       :
     6661           if buf_temp_fbrglib_grp.node-code = v-fbrggrp-root-code
     6662           then do:
     6663               find first buf_fbr-gds-grp no-lock
     6664                    where buf_fbr-gds-grp.obj-type  = ""
     6665                      and buf_fbr-gds-grp.obj-code  = 0
     6666                      and buf_fbr-gds-grp.node-code = v-fbrggrp-root-code
     6667               no-error .
     6668               if error-status :error
     6669               then do:
     6670                   undo, return error "fill-output-parameters-on-exit: Не найдена корневая запись групп блюд'".
     6671               end.
     6672           end.
     6673           else do:
     6674               find first buf_fbr-gds-grp no-lock
     6675                    where buf_fbr-gds-grp.obj-type  = p-obj-type
     6676                      and buf_fbr-gds-grp.obj-code  = p-obj-code
     6677                      and buf_fbr-gds-grp.node-code = buf_temp_fbrglib_grp.node-code
     6678               no-error .
     6679               if error-status :error
     6680               then do:
     6681                   undo, return error "fill-output-parameters-on-exit: Не найдена запись выбранной группы '"
     6682                                       + "'" + buf_temp_fbrglib_grp.full-name + "'".
     6683               end.
     6684           end.
     6685           assign
     6686               p-recid-list = p-recid-list + ( if p-recid-list = "" then "" else "," ) + string( recid( buf_fbr-gds-grp ) )
     6687               v-selected   = yes
     6688           .
     6689       end.
     6690       if v-selected = no
     6691       then do:
     6692           if p-node-code = v-fbrggrp-root-code
     6693           then do:
     6694               find first buf_fbr-gds-grp no-lock
     6695                    where buf_fbr-gds-grp.obj-type  = ""
     6696                      and buf_fbr-gds-grp.obj-code  = 0
     6697                      and buf_fbr-gds-grp.node-code = v-fbrggrp-root-code
     6698               no-error .
     6699           end.
     6700           else do:
     6701               find first buf_fbr-gds-grp no-lock
     6702                    where buf_fbr-gds-grp.obj-type  = p-obj-type
     6703                      and buf_fbr-gds-grp.obj-code  = p-obj-code
     6704                      and buf_fbr-gds-grp.node-code = p-node-code
     6705               no-error .
     6706           end.
     6707           if not available buf_fbr-gds-grp
     6708           then do:
     6709               find first buf_temp_fbrglib_grp
     6710                    where buf_temp_fbrglib_grp.node-code = p-node-code
     6711                     AND buf_temp_fbrglib_grp.obj-type  = p-obj-type
     6712                     AND buf_temp_fbrglib_grp.obj-code  = p-obj-code
     6713               no-error .
     6714               if not available buf_temp_fbrglib_grp
     6715               then do:
     6716                   undo, return error "fill-output-parameters-on-exit: Неверно выбрана группа с кодом "
     6717                                       + string( p-node-code ).
     6718               end.
     6719               undo, return error "fill-output-parameters-on-exit: Не найдена запись выбранной группы '"
     6720                               + buf_temp_fbrglib_grp.full-name + "'".
     6721           end.
     6722           assign
     6723               p-recid-list = string( recid( buf_fbr-gds-grp ) )
     6724           .
     6725       end.
     6726       assign
     6727           fbr-gds-grp-row      = integer( entry( 1, p-recid-list ) )
     6728       .
     6729   assign
     6730   entry(v-rubr-mode + 1, v-uf-List_,  chr(4)) =  if fbr-gds-grp-row = ?
     6731                                                        then chr(63)
     6732                                                        else string( fbr-gds-grp-row )
     6733   .
     6734   run uf-set in this-procedure(
     6735         input 'fbr-gds-grp-p':U
     6736       , input v-cntxt-userid
     6737       , input v-uf-List_
     6738       , input v-uf-Naim
     6739       , input v-uf-print-graft
     6740       , input v-uf-sort-gr
     6741       , input v-uf-type-price
     6742       , input v-uf-type-val
     6743   )  no-error .
     6744   end.
     6745   END PROCEDURE.
     6746   PROCEDURE find-grp-in-browse :
     6747   do
     6748   on error undo, return error
     6749   :
     6750   define input parameter p-obj-type   as character    no-undo.
     6751   define input parameter p-obj-code   as integer      no-undo.
     6752   define input parameter p-search-grp-full-name   as character    no-undo.
     6753       define variable v-focused-row       as integer              no-undo.
     6754       define variable v-repositioned-row  as integer              no-undo.
     6755       define variable v-counter           as integer              no-undo.
     6756       define variable v-level             as integer              no-undo.
     6757       define buffer buf_temp_fbrglib_grp       for temp_fbrglib_grp.
     6758       define buffer bf_temp_fbrglib_grp       for temp_fbrglib_grp.
     6759       DEFINE BUFFER bf_temp_fbrglib_found-grp FOR temp_fbrglib_found-grp.
     6760       IF p-obj-type = "":U AND p-obj-code = 0 THEN DO:
     6761           assign
     6762           v-focused-row      = br-global :focused-row in frame Dlg-grp.
     6763           v-repositioned-row = current-result-row( "br-global" )
     6764       .
     6765       END.
     6766       ELSE DO:
     6767           assign
     6768           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     6769           v-repositioned-row = current-result-row( "br-list" )
     6770       .
     6771       END.
     6772       assign
     6773       v-level = num-entries( right-trim(p-search-grp-full-name, chr(47) ) , chr(47))
     6774       .
     6775       if v-found-grp-num  <> 0
     6776       then do:
     6777           assign
     6778               v-counter = 0
     6779           .
     6780           find first bf_temp_fbrglib_found-grp
     6781               where  bf_temp_fbrglib_found-grp.obj-type = p-obj-type
     6782               AND bf_temp_fbrglib_found-grp.obj-code = p-obj-code
     6783               AND bf_temp_fbrglib_found-grp.level = v-level
     6784           no-error .
     6785           if not available bf_temp_fbrglib_found-grp
     6786           then do:
     6787               undo, return error "Не найдено ни одной группы уровня " + string( v-level ).
     6788           end.
     6789           do v-counter = 1 to v-found-grp-num
     6790           :
     6791               find next bf_temp_fbrglib_found-grp
     6792                   where bf_temp_fbrglib_found-grp.obj-type = p-obj-type
     6793               AND bf_temp_fbrglib_found-grp.obj-code = p-obj-code
     6794               AND bf_temp_fbrglib_found-grp.level = v-level
     6795               no-error .
     6796               if not available bf_temp_fbrglib_found-grp
     6797               then do:
     6798                   undo, return error "Не найдена следующая группа уровня " + string( v-level ).
     6799               end.
     6800           end.
     6801           find first buf_temp_fbrglib_grp
     6802                   where buf_temp_fbrglib_grp.node-code = bf_temp_fbrglib_found-grp.node-code
     6803                     AND buf_temp_fbrglib_grp.obj-type  = p-obj-type
     6804                     AND buf_temp_fbrglib_grp.obj-code  = p-obj-code
     6805           no-error .
     6806           if not available buf_temp_fbrglib_grp
     6807           then do:
     6808               undo, return error "Найденной группы нет в списке групп".
     6809           end.
     6810           IF p-obj-type = "":U AND p-obj-code = 0 THEN DO:
     6811               OPEN QUERY br-global FOR EACH buf0_temp_fbrglib_grp NO-LOCK  WHERE   buf0_temp_fbrglib_grp.obj-type = "":U AND buf0_temp_fbrglib_grp.obj-code = 0 by buf0_temp_fbrglib_grp.sort-name.
     6812               br-global :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     6813           reposition br-global to recid recid( buf_temp_fbrglib_grp ).
     6814           END.
     6815           ELSE DO:
     6816               OPEN QUERY br-list FOR EACH temp_fbrglib_grp NO-LOCK where     temp_fbrglib_grp.obj-type = p-store-type  AND temp_fbrglib_grp.obj-code = p-store-code     by temp_fbrglib_grp.sort-name.
     6817              br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     6818              reposition br-list to recid recid( buf_temp_fbrglib_grp ).
     6819           END.
     6820       end.
     6821       else do:
     6822           run fbrglib-find-grp-by-full-name (
     6823                 input p-obj-type
     6824               , input p-obj-code
     6825               , input (IF p-obj-type = "":U AND p-obj-code = 0
     6826                        THEN fi-search-0 :screen-value in frame Dlg-grp
     6827                         ELSE fi-search :screen-value in frame Dlg-grp)
     6828               , input yes
     6829           ) no-error.
     6830           if error-status :error
     6831           then do:
     6832               undo, return error "Не удалось найти группу '" +
     6833                   (IF p-obj-type = "":U AND p-obj-code = 0
     6834                    THEN fi-search-0 :screen-value in frame Dlg-grp
     6835                       ELSE fi-search :screen-value in frame Dlg-grp) + "'".
     6836           end.
     6837           found-group:
     6838           for each bf_temp_fbrglib_found-grp no-lock
     6839               WHEre bf_temp_fbrglib_found-grp.obj-type = p-obj-type
     6840               AND bf_temp_fbrglib_found-grp.obj-code = p-obj-code
     6841           by bf_temp_fbrglib_found-grp.level
     6842           :
     6843               if bf_temp_fbrglib_found-grp.level = v-level
     6844               then do:
     6845                   leave.
     6846               end.
     6847               run expand-item in this-procedure ( INPUT p-obj-type, INPUT p-obj-code, input bf_temp_fbrglib_found-grp.node-code, input no ).
     6848           end.
     6849           find first bf_temp_fbrglib_found-grp
     6850               WHEre bf_temp_fbrglib_found-grp.obj-type = p-obj-type
     6851               AND bf_temp_fbrglib_found-grp.obj-code = p-obj-code
     6852              AND bf_temp_fbrglib_found-grp.level = v-level
     6853           no-error .
     6854           if not available bf_temp_fbrglib_found-grp
     6855           then do:
     6856               undo, return error "Нет последней найденной группы для уровня " + string( v-level ).
     6857           end.
     6858           find first buf_temp_fbrglib_grp
     6859               WHEre buf_temp_fbrglib_grp.obj-type = p-obj-type
     6860               AND buf_temp_fbrglib_grp.obj-code = p-obj-code
     6861                AND buf_temp_fbrglib_grp.node-code = bf_temp_fbrglib_found-grp.node-code
     6862           no-error .
     6863           if not available buf_temp_fbrglib_grp
     6864           then do:
     6865               undo, return error "Найденной группы нет в списке групп".
     6866           end.
     6867           IF p-obj-type = "":U AND p-obj-code = 0  THEN DO:
     6868               OPEN QUERY br-global FOR EACH buf0_temp_fbrglib_grp NO-LOCK  WHERE   buf0_temp_fbrglib_grp.obj-type = "":U AND buf0_temp_fbrglib_grp.obj-code = 0 by buf0_temp_fbrglib_grp.sort-name.
     6869               br-global :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     6870               reposition br-global to recid recid( buf_temp_fbrglib_grp ).
     6871           END.
     6872           ELSE DO:
     6873               OPEN QUERY br-list FOR EACH temp_fbrglib_grp NO-LOCK where     temp_fbrglib_grp.obj-type = p-store-type  AND temp_fbrglib_grp.obj-code = p-store-code     by temp_fbrglib_grp.sort-name.
     6874               br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     6875               reposition br-list to recid recid( buf_temp_fbrglib_grp ).
     6876           END.
     6877       end.
     6878       find next bf_temp_fbrglib_found-grp
     6879           WHEre bf_temp_fbrglib_found-grp.obj-type = p-obj-type
     6880            AND bf_temp_fbrglib_found-grp.obj-code = p-obj-code
     6881            AND bf_temp_fbrglib_found-grp.level = v-level
     6882       no-error .
     6883       IF p-obj-type = "":U AND p-obj-code = 0  THEN DO:
     6884           if available bf_temp_fbrglib_found-grp
     6885           then do:
     6886                  assign
     6887                   v-found-grp-num-0  = v-found-grp-num + 1
     6888                   b-search-0 :label = "Далее"
     6889               .
     6890           end.
     6891           else do:
     6892               assign
     6893                   v-found-grp-num-0  = 0
     6894                   b-search-0 :label = "Поиск"
     6895               .
     6896           end.
     6897       END.
     6898       ELSE DO:
     6899           if available bf_temp_fbrglib_found-grp
     6900           then do:
     6901                  assign
     6902                   v-found-grp-num  = v-found-grp-num + 1
     6903                   b-search :label = "Далее"
     6904               .
     6905           end.
     6906           else do:
     6907               assign
     6908                   v-found-grp-num  = 0
     6909                   b-search :label = "Поиск"
     6910               .
     6911           end.
     6912       END.
     6913   end.
     6914   END PROCEDURE.
     6915   PROCEDURE get-current-recid :
     6916   do
     6917   on error undo, return error
     6918   :
     6919   define input parameter p-node-code as integer      no-undo.
     6920   define output parameter p-fbr-gds-grp-recid as recid   no-undo.
     6921       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     6922       find first buf_fbr-gds-grp no-lock
     6923            where buf_fbr-gds-grp.node-code = p-node-code
     6924       no-error .
     6925       if not available buf_fbr-gds-grp
     6926       then do:
     6927           undo, return error "get-current-recid: Не найдена группа." .
     6928       end.
     6929       assign
     6930           p-fbr-gds-grp-recid = recid( buf_fbr-gds-grp )
     6931       .
     6932   end.
     6933   END PROCEDURE.
     6934   PROCEDURE get-first-char :
     6935   do
     6936   on error undo, return error
     6937   :
     6938   define input parameter p-obj-type   as character    no-undo.
     6939   define input parameter p-obj-code   as integer      no-undo.
     6940   define input parameter p-node-code  as integer      no-undo.
     6941   define output parameter p-prefix    as character    no-undo.
     6942   define variable v-name          as character    no-undo.
     6943   define variable v-is-terminal   as logical      no-undo.
     6944   define variable v-have-goods    as logical      no-undo.
     6945   define buffer buf_fbr-gds-grp               for ub.fbr-gds-grp.
     6946   define buffer buf_temp_fbrglib_grp       for temp_fbrglib_grp.
     6947   run fbrglib-is-terminal in this-procedure (
     6948         input p-obj-type
     6949       , input p-obj-code
     6950       , input p-node-code
     6951       , output v-is-terminal
     6952   ) no-error .
     6953   if error-status :error
     6954   then do:
     6955       undo, return error "get-first-char: Ошибка при определении типа группы (терм/корн).".
     6956   end.
     6957   if v-is-terminal = yes
     6958   then do:
     6959       run fbrglib-have-goods in this-procedure (
     6960             input p-obj-type
     6961           , input p-obj-code
     6962           , input p-node-code
     6963           , output v-have-goods
     6964       ) no-error .
     6965       if error-status :error
     6966       then do:
     6967           undo, return error "get-first-char: Ошибка определения наличия товаров в группе." + chr(10) + return-value.
     6968       end.
     6969       if v-have-goods = yes
     6970       then do:
     6971           assign
     6972               p-prefix = "•"
     6973           .
     6974       end.
     6975       else do:
     6976           assign
     6977               p-prefix = " "
     6978           .
     6979       end.
     6980   end.
     6981   else do:
     6982       find first buf_temp_fbrglib_grp no-lock
     6983            where buf_temp_fbrglib_grp.upper-code = p-node-code
     6984            AND buf_temp_fbrglib_grp.obj-type  = p-obj-type
     6985            AND buf_temp_fbrglib_grp.obj-code  = p-obj-code
     6986       no-error.
     6987       if available buf_temp_fbrglib_grp
     6988       then do:
     6989           assign
     6990               p-prefix = "«"
     6991           .
     6992       end.
     6993       else do:
     6994           assign
     6995               p-prefix = "»"
     6996           .
     6997       end.
     6998   end.
     6999   end.
     7000   END PROCEDURE.
     7001   PROCEDURE get-obj-type :
     7002   do
     7003   on error undo, return error
     7004   :
     7005   define input parameter p-obj-code   as integer      no-undo.
     7006   define output parameter p-obj-type  as character    no-undo.
     7007       define buffer buf_shop_clients      for ub.clients.
     7008       define buffer buf_stock_clients     for ub.clients.
     7009       find first buf_shop_clients no-lock
     7010            where buf_shop_clients.obj-type = 'маг':U
     7011              and buf_shop_clients.obj-code = p-obj-code
     7012       no-error.
     7013       find first buf_stock_clients no-lock
     7014            where buf_stock_clients.obj-type = 'скл':U
     7015              and buf_stock_clients.obj-code = p-obj-code
     7016       no-error.
     7017       if available buf_shop_clients
     7018       then do:
     7019           if available buf_stock_clients
     7020           then do:
     7021               run str/fbrplnds.w (
     7022                     input "Выберите тип объекта:"
     7023                   , output p-obj-type
     7024               ) no-error.
     7025               if error-status :error
     7026               then do:
     7027                   message
     7028                            vss-workfile vss-revision vss-description
     7029                       skip "Ошибка определения типа объекта."
     7030                       skip return-value
     7031                       skip trim(error-status :get-message(1))
     7032                            trim(error-status :get-message(2))
     7033                            trim(error-status :get-message(3))
     7034                   view-as alert-box error.
     7035                   assign
     7036                       p-obj-type = ?
     7037                   .
     7038                   undo, return error .
     7039               end.
     7040           end.
     7041           else do:
     7042               assign
     7043                   p-obj-type = buf_shop_clients.obj-type
     7044               .
     7045           end.
     7046       end.
     7047       else do:
     7048           if available buf_stock_clients
     7049           then do:
     7050               assign
     7051                   p-obj-type = buf_stock_clients.obj-type
     7052               .
     7053           end.
     7054           else do:
     7055               assign
     7056                   p-obj-type = ?
     7057               .
     7058           end.
     7059       end.
     7060   end.
     7061   END PROCEDURE.
     7062   PROCEDURE get-row-amount :
     7063   do
     7064   on error undo, return error
     7065   :
     7066   define INPUT  parameter p-obj-type as character      no-undo.
     7067   define INPUT  parameter p-obj-code as integer      no-undo.
     7068   define output parameter p-row-amount as integer      no-undo.
     7069       define buffer buf_temp_fbrglib_grp       for temp_fbrglib_grp.
     7070       for each buf_temp_fbrglib_grp WHERE
     7071              buf_temp_fbrglib_grp.obj-type = p-obj-type
     7072          AND buf_temp_fbrglib_grp.obj-code = p-obj-code
     7073       :
     7074           assign
     7075               p-row-amount = p-row-amount + 1
     7076           .
     7077       end.
     7078   end.
     7079   END PROCEDURE.
     7080   PROCEDURE link-grp :
     7081   do
     7082   on error undo, return error
     7083   :
     7084   define input parameter p-node-code  as integer      no-undo.
     7085   define input parameter p-global-node-code  as integer      no-undo.
     7086       define variable v-fbr-gds-grp-recid     as recid        no-undo.
     7087       define variable v-focused-row           as integer      no-undo.
     7088       define variable v-repositioned-row      as integer      no-undo.
     7089       define variable v-have-rights           as logical      no-undo.
     7090       define variable v-base                  as decimal      no-undo.
     7091       define variable v-node-name             as character    no-undo.
     7092       define variable v-out-code              as integer        no-undo.
     7093       define variable v-cancel                as logical      no-undo.
     7094       define buffer buf_fbr-gds-grp               for ub.fbr-gds-grp.
     7095       define buffer bf0_fbr-gds-grp               for ub.fbr-gds-grp.
     7096       define buffer buf_temp_fbrglib_grp       for temp_fbrglib_grp.
     7097       define buffer buf_child_temp_fbrglib_grp for temp_fbrglib_grp.
     7098       define buffer bf_fbr-gds-grp        for ub.fbr-gds-grp.
     7099       if p-node-code = v-fbrggrp-root-code
     7100       then do:
     7101           message
     7102           "Корневую группу изменить невозможно."
     7103           view-as alert-box warning.
     7104           undo, return .
     7105       end.
     7106       run check-rights-for-change-grp in this-procedure (
     7107           output v-have-rights
     7108       ) no-error.
     7109       if error-status :error
     7110       or v-have-rights = no
     7111       then do:
     7112           message
     7113             vss-workfile vss-revision vss-description
     7114             skip "Нет прав на изменение справочника групп блюд."
     7115             skip "Изменение группы невозможно."
     7116             skip return-value
     7117             skip trim(error-status :get-message(1))
     7118                  trim(error-status :get-message(2))
     7119                  trim(error-status :get-message(3))
     7120           view-as alert-box error.
     7121           undo, return error .
     7122       end.
     7123       assign
     7124           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     7125           v-repositioned-row = current-result-row( "br-list" )
     7126       .
     7127       do transaction
     7128       on error undo, return error
     7129       :
     7130           find first buf_fbr-gds-grp exclusive-lock
     7131                where buf_fbr-gds-grp.obj-type  = p-store-type
     7132                  and buf_fbr-gds-grp.obj-code  = p-store-code
     7133                  and buf_fbr-gds-grp.node-code = p-node-code
     7134           .
     7135           find first bf0_fbr-gds-grp NO-LOCK
     7136                where bf0_fbr-gds-grp.obj-type  = "":U
     7137                  and bf0_fbr-gds-grp.obj-code  = 0
     7138                  and bf0_fbr-gds-grp.node-code = p-global-node-code
     7139           .
     7140           find first bf_fbr-gds-grp no-lock
     7141               where bf_fbr-gds-grp.obj-type   = p-store-type
     7142                 and bf_fbr-gds-grp.obj-code   = p-store-code
     7143                 and bf_fbr-gds-grp.out-code   = bf0_fbr-gds-grp.out-code
     7144           no-error.
     7145           assign
     7146           buf_fbr-gds-grp.global-code   = bf0_fbr-gds-grp.global-code
     7147           buf_fbr-gds-grp.out-code      = (if available bf_fbr-gds-grp then 0 else bf0_fbr-gds-grp.out-code)
     7148   .
     7149       end.
     7150       find first buf_temp_fbrglib_grp
     7151            where buf_temp_fbrglib_grp.node-code = p-node-code
     7152       no-error.
     7153       if not available buf_temp_fbrglib_grp
     7154       then do:
     7155           undo, return error "change-grp: Ошибка поиска группы в списке.".
     7156       end.
     7157       find first buf_fbr-gds-grp no-lock
     7158            where buf_fbr-gds-grp.obj-type  = p-store-type
     7159              and buf_fbr-gds-grp.obj-code  = p-store-code
     7160              and buf_fbr-gds-grp.node-code = p-node-code
     7161       no-error.
     7162       if error-status :error
     7163       then do:
     7164           undo, return error "change-grp: Неверный выбор группы.".
     7165       end.
     7166       assign
     7167       buf_temp_fbrglib_grp.global-code   = buf_fbr-gds-grp.global-code
     7168       buf_temp_fbrglib_grp.out-code   = buf_fbr-gds-grp.out-code
     7169       .
     7170       OPEN QUERY br-list FOR EACH temp_fbrglib_grp NO-LOCK where     temp_fbrglib_grp.obj-type = p-store-type  AND temp_fbrglib_grp.obj-code = p-store-code     by temp_fbrglib_grp.sort-name.
     7171       br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     7172       reposition br-list to row v-repositioned-row.
     7173   end.
     7174   END PROCEDURE.
     7175   PROCEDURE move-item :
     7176   do
     7177   on error undo, return error
     7178   :
     7179   define input parameter p-obj-type   as character    no-undo.
     7180   define input parameter p-obj-code   as integer      no-undo.
     7181   define input parameter p-node-code  as integer      no-undo.
     7182   define input parameter p-upper-code as integer      no-undo.
     7183       define variable v-node-full-name    as character    no-undo.
     7184       define variable v-upper-full-name   as character    no-undo.
     7185       define variable v-focused-row       as integer      no-undo.
     7186       define variable v-repositioned-row  as integer      no-undo.
     7187       define variable v-have-goods        as logical      no-undo.
     7188       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     7189       define buffer buf_upper_fbr-gds-grp     for ub.fbr-gds-grp.
     7190       define buffer buf_temp_fbrglib_grp   for temp_fbrglib_grp.
     7191   if session :set-wait-state( "compiler" ) then.
     7192       run fbrglib-have-goods in this-procedure (
     7193             input p-obj-type
     7194           , input p-obj-code
     7195           , input p-upper-code
     7196           , output v-have-goods
     7197       ) no-error .
     7198       if error-status :error
     7199       then do:
     7200           undo, return error "move-item: Ошибка определения наличия товаров в группе." + chr(10) + return-value.
     7201       end.
     7202       if v-have-goods = yes
     7203       then do:
     7204               message
     7205                   "В эту группу переместить нельзя, т.к. в одной группе"
     7206                   skip "не могут быть одновременно подгруппы и товары.".
     7207               apply "entry" to br-list in frame Dlg-grp.
     7208               return no-apply.
     7209       end.
     7210       run fbrglib-get-full-name in this-procedure (
     7211                 input p-obj-type
     7212               , input p-obj-code
     7213               , input p-node-code
     7214               , output v-node-full-name
     7215       ) no-error .
     7216       if error-status :error
     7217       then do:
     7218           undo, return error "move-item: Ошибка вычисления полного имени перемещаемой группы".
     7219       end.
     7220       run fbrglib-get-full-name in this-procedure (
     7221                 input p-obj-type
     7222               , input p-obj-code
     7223               , input p-upper-code
     7224               , output v-upper-full-name
     7225       ) no-error .
     7226       if error-status :error
     7227       then do:
     7228           undo, return error "move-item: Ошибка вычисления полного имени группы".
     7229       end.
     7230       if v-upper-full-name begins v-node-full-name
     7231       then do:
     7232           message
     7233               "Группу нельзя переместить в ее собственную подгруппу."
     7234           view-as alert-box.
     7235           undo, return.
     7236       end.
     7237       do transaction
     7238       on error undo, return error "move-item: Ошибка перемещения группы.".
     7239           find first buf_fbr-gds-grp exclusive-lock
     7240                where buf_fbr-gds-grp.obj-type     = p-obj-type
     7241                  and buf_fbr-gds-grp.obj-code     = p-obj-code
     7242                  and buf_fbr-gds-grp.node-code    = p-node-code
     7243           no-error .
     7244           if not available buf_fbr-gds-grp
     7245           then do:
     7246               undo, return error "move-item: Не найдена группа для перемещения.".
     7247           end.
     7248           assign
     7249               buf_fbr-gds-grp.upper-code = p-upper-code
     7250           .
     7251       end.
     7252       assign
     7253           p-recid-list = string( recid( buf_fbr-gds-grp ) )
     7254           fbr-gds-grp-row  = recid( buf_fbr-gds-grp )
     7255       .
     7256       run UI-on in this-procedure no-error .
     7257       if error-status :error
     7258       then do:
     7259           undo, return error "move-item: Ошибка при загрузке дерева групп." + chr(10) + return-value.
     7260       end.
     7261   end.
     7262   END PROCEDURE.
     7263   PROCEDURE print-browse :
     7264   define input parameter p-obj-type as character no-undo .
     7265   define input parameter p-obj-code as integer no-undo .
     7266   define variable Line as character no-undo.
     7267   define variable date_string as character no-undo.
     7268   define buffer buf_temp_fbrglib_grp for temp_fbrglib_grp.
     7269   DEFINE FRAME brFrame
     7270   buf_temp_fbrglib_grp.global-code   format ">>>>9"      COLUMN-LABEL "Руб-р"
     7271   buf_temp_fbrglib_grp.name          format "X(71)"      column-label "Наименование группы"
     7272   buf_temp_fbrglib_grp.out-code      format ">>>>9"      COLUMN-LABEL "Код на!кассе"
     7273   HEADER  date_string AT 5 format "X(35)"
     7274   string( "Страница " ) format "X(9)" AT 85 PAGE-NUMBER(PrnLibStream) AT 95 FORMAT ">>9" SKIP
     7275   Line format "X(150)" AT 1
     7276   with width 232 down stream-io use-text    .
     7277   Line = fill("-", 150).
     7278   date_string = cur-time-print() .
     7279   run prn-lib-open-stream  in this-procedure (
     7280                                                input parParentProc
     7281                                               ,input 43
     7282                                               ,input yes
     7283                                               ,input no
     7284                                               ).
     7285   PUT  STREAM PrnLibStream
     7286   SPACE(25) ( if p-obj-type = "":U and p-obj-code = 0
     7287               then br-global:title in frame Dlg-grp
     7288               else br-list:title  )
     7289   format "x(90)" SKIP(1) .
     7290   FORM HEADER
     7291   Line format "X(150)" AT 1 SKIP
     7292   "Продолжение - на следующей странице" AT 30 SKIP
     7293   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     7294   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     7295   FORM with FRAME BrFrame  .
     7296   run waitfram-show in this-procedure ("Ждите...").
     7297   FOR EACH buf_temp_fbrglib_grp where
     7298           buf_temp_fbrglib_grp.obj-type = p-obj-type
     7299       and buf_temp_fbrglib_grp.obj-code = p-obj-code :
     7300     DISPLAY stream PrnLibStream
     7301     buf_temp_fbrglib_grp.global-code
     7302     buf_temp_fbrglib_grp.name
     7303     buf_temp_fbrglib_grp.out-code
     7304     with frame BrFrame.
     7305     DOwn stream PrnLibStream
     7306     with frame BrFrame.
     7307   END.
     7308   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     7309   HIDE  STREAM PrnLibStream FRAME BrFrame.
     7310   output  STREAM PrnLibStream CLOSE.
     7311   run waitfram-hide in this-procedure .
     7312   run prn-lib-prn-file in this-procedure (
     7313                                             input parParentProc
     7314                                             ,input 8
     7315                                             ).
     7316   END PROCEDURE.
     7317   PROCEDURE print-grp :
     7318   do
     7319   on error undo, return error
     7320   :
     7321   define input parameter p-obj-type   as character    no-undo.
     7322   define input parameter p-obj-code   as integer      no-undo.
     7323   define input parameter p-node-code  as integer      no-undo.
     7324       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     7325       if print-option = "":U
     7326       then do:
     7327           run gbl/pop-up.p (
     7328               input b-print:handle in frame Dlg-grp
     7329               , input no
     7330           ) no-error.
     7331           if error-status:error
     7332           then do:
     7333               assign
     7334                   print-option = "":U
     7335               .
     7336               return no-apply.
     7337           end.
     7338       end.
     7339       if p-node-code = 1
     7340       then do:
     7341           find first buf_fbr-gds-grp no-lock
     7342                where buf_fbr-gds-grp.obj-type  = ""
     7343                  and buf_fbr-gds-grp.obj-code  = 0
     7344                  and buf_fbr-gds-grp.node-code = p-node-code
     7345           no-error.
     7346           if not available buf_fbr-gds-grp
     7347           then do:
     7348               undo, return error "Ошибка определения корневой группы.".
     7349           end.
     7350       end.
     7351       else do:
     7352           find first buf_fbr-gds-grp no-lock
     7353                where buf_fbr-gds-grp.obj-type  = p-obj-type
     7354                  and buf_fbr-gds-grp.obj-code  = p-obj-code
     7355                  and buf_fbr-gds-grp.node-code = p-node-code
     7356           no-error.
     7357           if not available buf_fbr-gds-grp
     7358           then do:
     7359               undo, return error "Неверно выбрана группа.".
     7360           end.
     7361       end.
     7362       CASE print-option:
     7363         when "browse":U then do:
     7364           run print-browse in this-procedure (p-store-type, p-store-code)
     7365           no-error.
     7366         end.
     7367         when "browse-global":U then do:
     7368           run print-browse in this-procedure ("":U, 0)
     7369           no-error.
     7370         end.
     7371         otherwise do:
     7372           run rep/r-gdsggr.p (
     7373                 input parparentproc
     7374               , input p-obj-type
     7375               , input p-obj-code
     7376               , input recid( buf_fbr-gds-grp )
     7377               , input print-option
     7378           ) no-error .
     7379         end.
     7380       END CASE.
     7381       if error-status :error
     7382       then do:
     7383           assign
     7384               print-option = "":U
     7385           .
     7386           undo, return error "Ошибка печати групп блюд.".
     7387       end.
     7388       apply "entry" to br-list in frame Dlg-grp.
     7389   end.
     7390   END PROCEDURE.
     7391   PROCEDURE proc-b-rubr :
     7392   DEFINE INPUT PARAMETER p-rubr AS LOGICAL NO-UNDO.
     7393   define buffer buf_clients for ub.clients.
     7394   find first buf_clients no-lock
     7395        where buf_clients.obj-type = p-store-type
     7396          and buf_clients.obj-code = p-store-code
     7397   .
     7398   CASE p-rubr:
     7399       WHEN YES THEN DO:
     7400           ASSIGN
     7401          br-list:WIDTH IN FRAME Dlg-grp = 56
     7402          b-expand:COL IN FRAME Dlg-grp            = v-b-expand-COL + 50
     7403          b-expand-all:COL IN FRAME Dlg-grp        = v-b-expand-all-COL + 50
     7404          b-find-by-full-name:COL IN FRAME Dlg-grp = v-b-find-by-full-name-COL + 50
     7405          b-find-by-substring:COL IN FRAME Dlg-grp = v-b-find-by-substring-COL + 50
     7406          br-list:COL IN FRAME Dlg-grp             = 44
     7407          b-search:COL IN FRAME Dlg-grp            = v-b-search-COL + 50
     7408          fi-search:COL IN FRAME Dlg-grp           = v-fi-search-COL + 50
     7409          .
     7410          DISPLAY
     7411          b-copy0
     7412          b-link
     7413          b-expand-0
     7414          b-expand-all-0
     7415          b-find-by-full-name-0
     7416          b-find-by-substring-0
     7417          br-global
     7418          b-search-0
     7419          fi-search-0
     7420          RECT-rubr
     7421          WITH FRAME Dlg-grp.
     7422          if v-cntxt-db-num <> buf_clients.db-num then do:
     7423           DISABLE
     7424           b-copy0
     7425           b-link
     7426           with frame Dlg-grp .
     7427          end.
     7428          else do:
     7429           ENABLE
     7430           b-copy0
     7431           b-link
     7432           with frame Dlg-grp .
     7433          end.
     7434          APPLY "ENTRY" to br-global.
     7435       END.
     7436       WHEN NO THEN DO:
     7437           HIDE
     7438           b-copy0
     7439           b-link
     7440           b-expand-0
     7441           b-expand-all-0
     7442           b-find-by-full-name-0
     7443           b-find-by-substring-0
     7444           br-global
     7445           b-search-0
     7446           fi-search-0
     7447           RECT-rubr
     7448           IN  FRAME Dlg-grp.
     7449           ASSIGN
     7450          b-expand:COL IN FRAME Dlg-grp            = v-b-expand-COL
     7451          b-expand-all:COL IN FRAME Dlg-grp        = v-b-expand-all-COL
     7452          b-find-by-full-name:COL IN FRAME Dlg-grp = v-b-find-by-full-name-COL
     7453          b-find-by-substring:COL IN FRAME Dlg-grp = v-b-find-by-substring-COL
     7454          br-list:COL IN FRAME Dlg-grp = 1
     7455          b-search:COL IN FRAME Dlg-grp = v-b-search-COL
     7456          fi-search:COL IN FRAME Dlg-grp = v-fi-search-COL
     7457          br-list:WIDTH = 98
     7458          .
     7459          APPLY "ENTRY" to br-list.
     7460       END.
     7461   END CASE.
     7462   END PROCEDURE.
     7463   PROCEDURE rubr-on :
     7464   do
     7465   on error undo, return error
     7466   :
     7467   define variable v-reposition-row        as integer          no-undo.
     7468   define variable v-focused-row           as integer          no-undo.
     7469   define variable v-reposition-to-recid   as logical init no  no-undo.
     7470   define variable v-enable-change-grp     as logical          no-undo.
     7471   define variable v-margins-range         as integer          no-undo.
     7472   define variable v-margins-exists        as logical          no-undo.
     7473   define variable v-increase-range         as integer          no-undo.
     7474   define variable v-increase-exists        as logical          no-undo.
     7475   define variable v-min-marg              as decimal          no-undo.
     7476   define variable v-max-marg              as decimal          no-undo.
     7477   define variable v-increase-pc              as decimal          no-undo.
     7478   define variable v-have-goods            as logical          no-undo.
     7479   define variable v-round-method      as character   no-undo .
     7480   define variable v-base                  as decimal no-undo .
     7481   define variable v-rmethod-range     as integer     no-undo.
     7482   define variable v-rmethod-exists    as logical     no-undo.
     7483   define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     7484   define buffer buf_temp_fbrglib_grp   for temp_fbrglib_grp.
     7485   run fbrglib-get-root-code in this-procedure ( output v-fbrggrp-root-code ) no-error.
     7486   if error-status :error
     7487   then do:
     7488       undo, return error "Не найден корневой узел." + chr(10) + return-value.
     7489   end.
     7490   run uf-get in this-procedure(
     7491        input  'fbr-gds-grp-p':U
     7492       ,input  v-cntxt-userid
     7493       ,output v-uf-List_
     7494       ,output v-uf-Naim
     7495       ,output v-uf-print-graft
     7496       ,output v-uf-sort-gr
     7497       ,output v-uf-type-price
     7498       ,output v-uf-type-val
     7499   )  no-error .
     7500   if not error-status:error then
     7501   assign
     7502   v-uf-List_ = if num-entries(v-uf-list_, chr(4)) = 1
     7503                 then (v-uf-list_ + chr(4) + chr(63))
     7504                 else v-uf-list_
     7505   fbr-gds-grp-row =  if (num-entries(v-uf-List_, chr(4)) < 2) or (entry(2, v-uf-List_, chr(4)) =  chr(63))
     7506                      then ?
     7507                      else integer(entry(2, v-uf-LIst_, chr(4)))
     7508   .
     7509   else do:
     7510     assign
     7511     v-uf-List_ = if num-entries(v-uf-list_, chr(4)) = 1
     7512                   then (v-uf-list_ + chr(4) + chr(63))
     7513                   else v-uf-list_
     7514     fbr-gds-grp-row =  if (num-entries(v-uf-List_, chr(4)) < 2) or (entry(2, v-uf-List_, chr(4)) =  chr(63))
     7515                       then ?
     7516                       else integer(entry(2, v-uf-LIst_, chr(4)))
     7517     .
     7518   end.
     7519   assign
     7520       p-recid-list = (if p-recid-list = "":U then string( fbr-gds-grp-row ) else p-recid-list)
     7521   .
     7522   find first buf_fbr-gds-grp no-lock
     7523        where buf_fbr-gds-grp.node-code = v-fbrggrp-root-code
     7524   no-error .
     7525   if error-status :error
     7526   then do:
     7527       message
     7528         vss-workfile vss-revision vss-description
     7529         skip "Не найдена запись корневого узла."
     7530         skip return-value
     7531         skip trim(error-status :get-message(1))
     7532              trim(error-status :get-message(2))
     7533              trim(error-status :get-message(3))
     7534              trim(error-status :get-message(4))
     7535              trim(error-status :get-message(5))
     7536       view-as alert-box error.
     7537       undo, return error .
     7538   end.
     7539   for each buf_temp_fbrglib_grp
     7540   :
     7541       delete buf_temp_fbrglib_grp.
     7542   end.
     7543   create buf_temp_fbrglib_grp.
     7544   assign
     7545       buf_temp_fbrglib_grp.node-code   = buf_fbr-gds-grp.node-code
     7546       buf_temp_fbrglib_grp.upper-code  = buf_fbr-gds-grp.upper-code
     7547       buf_temp_fbrglib_grp.level       = 0
     7548       buf_temp_fbrglib_grp.mark        = ( if v-have-goods = yes then "•" else " " )
     7549       buf_temp_fbrglib_grp.full-name   = chr(4)
     7550       buf_temp_fbrglib_grp.sort-name   = chr(4)
     7551       buf_temp_fbrglib_grp.name        = buf_fbr-gds-grp.node-name
     7552       buf_temp_fbrglib_grp.out-code    = buf_fbr-gds-grp.out-code
     7553   .
     7554   for each buf_fbr-gds-grp no-lock
     7555       where buf_fbr-gds-grp.obj-type   = "":U
     7556         and buf_fbr-gds-grp.obj-code   = 0
     7557         and buf_fbr-gds-grp.upper-code = v-fbrggrp-root-code
     7558    :
     7559        run create-new-line in this-procedure (
     7560              input buf_fbr-gds-grp.obj-type
     7561            , input buf_fbr-gds-grp.obj-code
     7562            , input buf_fbr-gds-grp.node-code
     7563            , input buf_fbr-gds-grp.upper-code
     7564            , input 1
     7565            , input buf_fbr-gds-grp.node-name
     7566            , input buf_fbr-gds-grp.out-code
     7567            , input buf_fbr-gds-grp.global-code
     7568        ) no-error .
     7569        if error-status :error
     7570        then do:
     7571            message
     7572              vss-workfile vss-revision vss-description
     7573              skip "rubr-on: Ошибка добавления строки в список групп."
     7574              skip return-value
     7575              skip trim(error-status :get-message(1))
     7576                   trim(error-status :get-message(2))
     7577                   trim(error-status :get-message(3))
     7578                   trim(error-status :get-message(4))
     7579                   trim(error-status :get-message(5))
     7580            view-as alert-box error.
     7581            undo, return error .
     7582        end.
     7583    end.
     7584   if p-recid-list <> "" and p-recid-list <> ?
     7585   then do:
     7586       assign
     7587           v-reposition-row = 1
     7588           v-focused-row    = 1
     7589       .
     7590       find first buf_fbr-gds-grp no-lock
     7591            where recid( buf_fbr-gds-grp ) = integer( entry( num-entries( p-recid-list ), p-recid-list ) )
     7592       no-error .
     7593       if not available buf_fbr-gds-grp
     7594       then do:
     7595       end.
     7596       else do:
     7597           run expand-tree-for-grp in this-procedure (
     7598                 input buf_fbr-gds-grp.obj-type
     7599               , input buf_fbr-gds-grp.obj-code
     7600               , input buf_fbr-gds-grp.node-code
     7601               , output v-focused-row
     7602               , output v-reposition-row
     7603               , output v-reposition-to-recid
     7604           ) no-error .
     7605           if error-status :error
     7606           then do:
     7607               undo, return error "rubr-on: Не удалось раскрыть дерево групп." + chr(10) + return-value.
     7608           end.
     7609       end.
     7610   end.
     7611   ASSIGN
     7612   b-print:MENU-MOUSE in frame Dlg-grp =  1
     7613   br-global:width = 98
     7614   .
     7615   DISPLAY fi-search-0
     7616   WITH FRAME Dlg-grp .
     7617   ENABLE
     7618   b-exit
     7619   b-sel WHEN LOOKUP("b-sel", p-button-list) > 0
     7620   b-help
     7621   b-expand-0
     7622   b-expand-all-0
     7623   fi-search-0
     7624   b-find-by-full-name-0
     7625   b-find-by-substring-0
     7626   b-search-0
     7627   br-global
     7628   WITH FRAME Dlg-grp .
     7629   VIEW FRAME Dlg-grp .
     7630   hide
     7631   fi-kitchen-type
     7632   fi-kitchen-code
     7633   b-mark
     7634   b-add b-chg b-del b-move b-goods b-print
     7635   B-global b-copy fi-kitchen-code bt-sel-kitchen
     7636   b-expand b-expand-all fi-search b-find-by-full-name
     7637   b-find-by-substring b-search B-copy0 B-link
     7638   br-list RECT-rubr
     7639   in FRAME Dlg-grp .
     7640   OPEN QUERY br-global FOR EACH buf0_temp_fbrglib_grp NO-LOCK  WHERE   buf0_temp_fbrglib_grp.obj-type = "":U AND buf0_temp_fbrglib_grp.obj-code = 0 by buf0_temp_fbrglib_grp.sort-name.
     7641   br-global :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dlg-grp.
     7642   if v-reposition-to-recid = no
     7643   then do:
     7644       reposition br-global to row v-reposition-row no-error .
     7645   end.
     7646   else do:
     7647       reposition br-global to recid v-reposition-row no-error .
     7648   end.
     7649   end.
     7650   END PROCEDURE.
     7651   PROCEDURE select-and-move-item :
     7652   do
     7653   on error undo, return error
     7654   :
     7655   define input parameter p-node-code as integer      no-undo.
     7656       define variable v-upper-code        as integer           no-undo.
     7657       define variable v-upper-recid-list  as character         no-undo.
     7658       define variable v-yesno             as logical           no-undo.
     7659       define variable v-node-full-name    as character         no-undo.
     7660       define variable v-upper-full-name   as character         no-undo.
     7661       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     7662       if p-node-code = v-fbrggrp-root-code
     7663       then do:
     7664           message
     7665           "Корневую группу переместить невозможно."
     7666           view-as alert-box warning.
     7667           undo, return .
     7668       end.
     7669       find first buf_fbr-gds-grp no-lock
     7670            where buf_fbr-gds-grp.obj-type  = p-store-type
     7671              and buf_fbr-gds-grp.obj-code  = p-store-code
     7672              and buf_fbr-gds-grp.node-code = p-node-code
     7673       no-error .
     7674       if error-status :error
     7675       then do:
     7676           undo, return error "select-and-move-item: Группа не найдена в базе данных.".
     7677       end.
     7678       assign
     7679           v-upper-recid-list = string( recid( buf_fbr-gds-grp ) )
     7680       .
     7681       run ref/fbrggrp.w (
     7682             input parparentproc
     7683           , input p-store-type
     7684           , input p-store-code
     7685           , input "buttons-for-move"
     7686           , input-output v-upper-recid-list
     7687       ) no-error .
     7688       if error-status :error
     7689       then do:
     7690           message
     7691             vss-workfile vss-revision vss-description
     7692             skip "Ошибка выбора группы для перемещения."
     7693             skip return-value
     7694             skip trim(error-status :get-message(1))
     7695                  trim(error-status :get-message(2))
     7696                  trim(error-status :get-message(3))
     7697           view-as alert-box error.
     7698           undo, return no-apply .
     7699       end.
     7700       find first buf_fbr-gds-grp no-lock
     7701            where recid( buf_fbr-gds-grp ) = integer( entry( 1, v-upper-recid-list ) )
     7702       no-error .
     7703       if error-status :error
     7704       then do:
     7705           undo, return error "Группа не найдена.".
     7706       end.
     7707       run fbrglib-get-full-name in this-procedure (
     7708             input p-store-type
     7709           , input p-store-code
     7710           , input p-node-code
     7711           , output v-node-full-name
     7712       ) no-error .
     7713       if error-status :error
     7714       then do:
     7715           undo, return error "Ошибка вычисления полного имени перемещаемой группы.".
     7716       end.
     7717       run fbrglib-get-full-name in this-procedure (
     7718             input buf_fbr-gds-grp.obj-type
     7719           , input buf_fbr-gds-grp.obj-code
     7720           , input buf_fbr-gds-grp.node-code
     7721           , output v-upper-full-name
     7722       ) no-error .
     7723       if error-status :error
     7724       then do:
     7725           undo, return error "Ошибка вычисления полного имени новой группы".
     7726       end.
     7727       message
     7728           "Переместить группу"
     7729           skip "    '" + v-node-full-name + "'"
     7730           skip "в группу"
     7731           skip "    '" + ( if buf_fbr-gds-grp.node-code = v-fbrggrp-root-code then "Блюда" else v-upper-full-name ) + "'"
     7732       view-as alert-box question
     7733       buttons yes-no
     7734       title "Перемещение группы"
     7735       update v-yesno.
     7736       if v-yesno = no
     7737       then do:
     7738       end.
     7739       else do:
     7740           run move-item in this-procedure (
     7741                 input p-store-type
     7742               , input p-store-code
     7743               , input p-node-code
     7744               , input buf_fbr-gds-grp.node-code
     7745           ) no-error.
     7746           if error-status :error
     7747           then do:
     7748               message
     7749               vss-workfile vss-revision vss-description
     7750               skip "Ошибка перемещения группы."
     7751               skip return-value
     7752               skip trim(error-status :get-message(1))
     7753                   trim(error-status :get-message(2))
     7754                   trim(error-status :get-message(3))
     7755                   trim(error-status :get-message(4))
     7756                   trim(error-status :get-message(5))
     7757               view-as alert-box error.
     7758               undo, return no-apply .
     7759           end.
     7760       end.
     7761   end.
     7762   END PROCEDURE.
     7763   PROCEDURE select-kitchen :
     7764   define input parameter p-old-obj-type   as character    no-undo.
     7765   define input parameter p-old-obj-code   as integer      no-undo.
     7766   define output parameter p-new-obj-type   as character    no-undo.
     7767   define output parameter p-new-obj-code   as integer      no-undo.
     7768       define variable v-types as character no-undo .
     7769       define variable v-old-cli-recid    as recid      no-undo.
     7770       define variable v-new-cli-recid    as recid      no-undo.
     7771       define buffer buf_clients       for ub.clients.
     7772   do
     7773   on error undo, return error
     7774   :
     7775       assign
     7776           v-types = 'маг':U
     7777       .
     7778       find first buf_clients no-lock
     7779            where buf_clients.obj-type = p-old-obj-type
     7780              and buf_clients.obj-code = p-old-obj-code
     7781       no-error.
     7782       if available buf_clients
     7783       then do:
     7784           assign
     7785               v-old-cli-recid = recid( buf_clients )
     7786           .
     7787       end.
     7788       else do:
     7789           assign
     7790               v-old-cli-recid = ?
     7791           .
     7792       end.
     7793       run ref/cli-all.w (
     7794             input parparentproc
     7795           , input "b-sel"
     7796           , input v-types
     7797           , input ?
     7798           , input ?
     7799           , input v-old-cli-recid
     7800           , input ?
     7801           , input ?
     7802           , output v-new-cli-recid
     7803       ) .
     7804       find first buf_clients no-lock
     7805            where recid( buf_clients ) = v-new-cli-recid
     7806       no-error.
     7807       if available buf_clients
     7808       then do:
     7809           assign
     7810               p-new-obj-type = buf_clients.obj-type
     7811               p-new-obj-code = buf_clients.obj-code
     7812           .
     7813       end.
     7814       else do:
     7815           assign
     7816               p-new-obj-type = ""
     7817               p-new-obj-code = 0
     7818           .
     7819       end.
     7820   end.
     7821   END PROCEDURE.
     7822   PROCEDURE UI-on :
     7823   do
     7824   on error undo, return error
     7825   :
     7826   define variable v-reposition-row        as integer          no-undo.
     7827   define variable v-focused-row           as integer          no-undo.
     7828   define variable v-reposition-to-recid   as logical init no  no-undo.
     7829   define variable v-enable-change-grp     as logical          no-undo.
     7830   define variable v-margins-range         as integer          no-undo.
     7831   define variable v-margins-exists        as logical          no-undo.
     7832   define variable v-increase-range         as integer          no-undo.
     7833   define variable v-increase-exists        as logical          no-undo.
     7834   define variable v-min-marg              as decimal          no-undo.
     7835   define variable v-max-marg              as decimal          no-undo.
     7836   define variable v-increase-pc              as decimal          no-undo.
     7837   define variable v-have-goods            as logical          no-undo.
     7838   define variable v-round-method      as character   no-undo .
     7839   define variable v-base                  as decimal no-undo .
     7840   define variable v-rmethod-range     as integer     no-undo.
     7841   define variable v-rmethod-exists    as logical     no-undo.
     7842   define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     7843   define buffer buf_temp_fbrglib_grp   for temp_fbrglib_grp.
     7844   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7845   do:
     7846     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     7847       (input  v-cntxt-db-num
     7848       ,input  v-cntxt-userid
     7849       ,input  0
     7850       ,input  'actn_res-reference_update':U
     7851       ,input  'firm':U
     7852       ,input  v-cntxt-host-code-obj
     7853       ,input  '':U
     7854       ,input  0
     7855       ,input  0
     7856       ,input  0
     7857       ,input  0
     7858       ,input  no
     7859       ,output v-enable-change-grp
     7860       )  .
     7861   end.
     7862   run fbrglib-get-root-code in this-procedure ( output v-fbrggrp-root-code ) no-error.
     7863   if error-status :error
     7864   then do:
     7865       undo, return error "Не найден корневой узел." + chr(10) + return-value.
     7866   end.
     7867   run uf-get in this-procedure(
     7868        input  'fbr-gds-grp-p':U
     7869       ,input  v-cntxt-userid
     7870       ,output v-uf-List_
     7871       ,output v-uf-Naim
     7872       ,output v-uf-print-graft
     7873       ,output v-uf-sort-gr
     7874       ,output v-uf-type-price
     7875       ,output v-uf-type-val
     7876   )  no-error .
     7877   if not error-status:error then
     7878   assign
     7879   fbr-gds-grp-row =  if entry(1, v-uf-List_, chr(4)) =  chr(63)
     7880                      then ?
     7881                      else integer(entry(1, v-uf-LIst_, chr(4)))
     7882   .
     7883   assign
     7884       p-recid-list = (if p-recid-list = "":U then string( fbr-gds-grp-row ) else p-recid-list)
     7885   .
     7886   find first buf_fbr-gds-grp no-lock
     7887        where buf_fbr-gds-grp.node-code = v-fbrggrp-root-code
     7888   no-error .
     7889   if error-status :error
     7890   then do:
     7891       message
     7892         vss-workfile vss-revision vss-description
     7893         skip "Не найдена запись корневого узла."
     7894         skip return-value
     7895         skip trim(error-status :get-message(1))
     7896              trim(error-status :get-message(2))
     7897              trim(error-status :get-message(3))
     7898              trim(error-status :get-message(4))
     7899              trim(error-status :get-message(5))
     7900       view-as alert-box error.
     7901       undo, return error .
     7902   end.
     7903   run fbrglib-have-goods in this-procedure (
     7904         input buf_fbr-gds-grp.obj-type
     7905       , input buf_fbr-gds-grp.obj-code
     7906       , input buf_fbr-gds-grp.node-code
     7907       , output v-have-goods
     7908   ) no-error .
     7909   if error-status :error
     7910   then do:
     7911       undo, return error "UI-on: Ошибка определения наличия товаров в группе." + chr(10) + return-value.
     7912   end.
     7913   for each buf_temp_fbrglib_grp
     7914   :
     7915       delete buf_temp_fbrglib_grp.
     7916   end.
     7917   create buf_temp_fbrglib_grp.
     7918   assign
     7919       buf_temp_fbrglib_grp.node-code   = buf_fbr-gds-grp.node-code
     7920       buf_temp_fbrglib_grp.upper-code  = buf_fbr-gds-grp.upper-code
     7921       buf_temp_fbrglib_grp.level       = 0
     7922       buf_temp_fbrglib_grp.mark        = ( if v-have-goods = yes then "•" else " " )
     7923       buf_temp_fbrglib_grp.full-name   = chr(4)
     7924       buf_temp_fbrglib_grp.sort-name   = chr(4)
     7925       buf_temp_fbrglib_grp.name        = buf_fbr-gds-grp.node-name
     7926       buf_temp_fbrglib_grp.out-code    = buf_fbr-gds-grp.out-code
     7927   .
     7928   create buf_temp_fbrglib_grp.
     7929   assign
     7930       buf_temp_fbrglib_grp.node-code   = buf_fbr-gds-grp.node-code
     7931       buf_temp_fbrglib_grp.upper-code  = buf_fbr-gds-grp.upper-code
     7932       buf_temp_fbrglib_grp.level       = 0
     7933       buf_temp_fbrglib_grp.mark        = ( if v-have-goods = yes then "•" else " " )
     7934       buf_temp_fbrglib_grp.full-name   = chr(4)
     7935       buf_temp_fbrglib_grp.sort-name   = chr(4)
     7936       buf_temp_fbrglib_grp.name        = buf_fbr-gds-grp.node-name
     7937       buf_temp_fbrglib_grp.out-code    = buf_fbr-gds-grp.out-code
     7938       buf_temp_fbrglib_grp.obj-type    = p-store-type
     7939       buf_temp_fbrglib_grp.obj-code    = p-store-code
     7940   .
     7941   for each buf_fbr-gds-grp no-lock
     7942       where buf_fbr-gds-grp.obj-type   = "":U
     7943         and buf_fbr-gds-grp.obj-code   = 0
     7944         and buf_fbr-gds-grp.upper-code = v-fbrggrp-root-code
     7945    :
     7946        run create-new-line in this-procedure (
     7947              input buf_fbr-gds-grp.obj-type
     7948            , input buf_fbr-gds-grp.obj-code
     7949            , input buf_fbr-gds-grp.node-code
     7950            , input buf_fbr-gds-grp.upper-code
     7951            , input 1
     7952            , input buf_fbr-gds-grp.node-name
     7953            , input buf_fbr-gds-grp.out-code
     7954            , input buf_fbr-gds-grp.global-code
     7955        ) no-error .
     7956        if error-status :error
     7957        then do:
     7958            message
     7959              vss-workfile vss-revision vss-description
     7960              skip "UI-on: Ошибка добавления строки в список групп."
     7961              skip return-value
     7962              skip trim(error-status :get-message(1))
     7963                   trim(error-status :get-message(2))
     7964                   trim(error-status :get-message(3))
     7965                   trim(error-status :get-message(4))
     7966                   trim(error-status :get-message(5))
     7967            view-as alert-box error.
     7968            undo, return error .
     7969        end.
     7970    end.
     7971   for each buf_fbr-gds-grp no-lock
     7972      where buf_fbr-gds-grp.obj-type   = p-store-type
     7973        and buf_fbr-gds-grp.obj-code   = p-store-code
     7974        and buf_fbr-gds-grp.upper-code = v-fbrggrp-root-code
     7975   :
     7976       run create-new-line in this-procedure (
     7977             input buf_fbr-gds-grp.obj-type
     7978           , input buf_fbr-gds-grp.obj-code
     7979           , input buf_fbr-gds-grp.node-code
     7980           , input buf_fbr-gds-grp.upper-code
     7981           , input 1
     7982           , input buf_fbr-gds-grp.node-name
     7983           , input buf_fbr-gds-grp.out-code
     7984           , input buf_fbr-gds-grp.global-code
     7985       ) no-error .
     7986       if error-status :error
     7987       then do:
     7988           message
     7989             vss-workfile vss-revision vss-description
     7990             skip "UI-on: Ошибка добавления строки в список групп."
     7991             skip return-value
     7992             skip trim(error-status :get-message(1))
     7993                  trim(error-status :get-message(2))
     7994                  trim(error-status :get-message(3))
     7995                  trim(error-status :get-message(4))
     7996                  trim(error-status :get-message(5))
     7997           view-as alert-box error.
     7998           undo, return error .
     7999       end.
     8000   end.
     8001   if p-recid-list <> "" and p-recid-list <> ?
     8002   then do:
     8003       assign
     8004           v-reposition-row = 1
     8005           v-focused-row    = 1
     8006       .
     8007       find first buf_fbr-gds-grp no-lock
     8008            where recid( buf_fbr-gds-grp ) = integer( entry( num-entries( p-recid-list ), p-recid-list ) )
     8009       no-error .
     8010       if not available buf_fbr-gds-grp
     8011       then do:
     8012       end.
     8013       else do:
     8014           run expand-tree-for-grp in this-procedure (
     8015                 input buf_fbr-gds-grp.obj-type
     8016               , input buf_fbr-gds-grp.obj-code
     8017               , input buf_fbr-gds-grp.node-code
     8018               , output v-focused-row
     8019               , output v-reposition-row
     8020               , output v-reposition-to-recid
     8021           ) no-error .
     8022           if error-status :error
     8023           then do:
     8024               undo, return error "UI-on: Не удалось раскрыть дерево групп." + chr(10) + return-value.
     8025           end.
     8026       end.
     8027   end.
     8028   ASSIGN
     8029   b-print:MENU-MOUSE in frame Dlg-grp =  1.
     8030   run enable_UI.
     8031   define variable v-current-db-num    as integer        no-undo.
     8032   define buffer buf_clients       for ub.clients.
     8033   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8034   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     8035     (output v-current-db-num
     8036     )  .
     8037   find first buf_clients no-lock
     8038        where buf_clients.obj-type = p-store-type
     8039          and buf_clients.obj-code = p-store-code
     8040   .
     8041   assign
     8042       fi-kitchen-type :label = ""
     8043   .
     8044   hide
     8045           b-sel
     8046           b-mark
     8047           b-add
     8048           b-chg
     8049           b-del
     8050           b-move
     8051           b-goods
     8052           b-copy
     8053           fi-kitchen-type
     8054           fi-kitchen-code
     8055           bt-sel-kitchen
     8056   in frame Dlg-grp .
     8057   if v-current-db-num = buf_clients.db-num
     8058   then do:
     8059       case p-button-list
     8060       :
     8061           when "buttons-for-move"
     8062           then do:
     8063               disable
     8064                   b-exit    with frame Dlg-grp
     8065               .
     8066               view
     8067                   b-sel    in frame Dlg-grp
     8068               .
     8069           end.
     8070           when "buttons-for-objcopy"
     8071           then do:
     8072               assign
     8073                   fi-kitchen-type :label = "Объект"
     8074               .
     8075               view
     8076                   fi-kitchen-type
     8077                   fi-kitchen-code
     8078                   bt-sel-kitchen
     8079               in frame Dlg-grp .
     8080               hide
     8081                   b-expand
     8082                   b-expand-all
     8083                   fi-search
     8084                   b-find-by-full-name
     8085                   b-find-by-substring
     8086                   b-search
     8087               in frame Dlg-grp .
     8088               if fi-kitchen-type <> ""
     8089               and fi-kitchen-code <> 0
     8090               then do:
     8091                   assign
     8092                       frame Dlg-grp :title = substitute( "Группы блюд объекта &1 &2", fi-kitchen-type, fi-kitchen-code )
     8093                   .
     8094               end.
     8095           end.
     8096           when "buttons-for-admin"
     8097           then do:
     8098               view
     8099                   b-add
     8100                   b-chg
     8101                   b-del
     8102                   b-move
     8103                   b-goods
     8104                   b-copy
     8105               in frame Dlg-grp.
     8106               if v-enable-change-grp = no
     8107               then do:
     8108                   disable
     8109                       b-add
     8110                       b-chg
     8111                       b-del
     8112                       b-move
     8113                       b-goods
     8114                       b-copy
     8115                   with frame Dlg-grp.
     8116               end.
     8117           end.
     8118           when 'терм':U + ",b-sel"
     8119           or when "b-sel"
     8120           then do:
     8121               view
     8122                   b-sel    in frame Dlg-grp
     8123               .
     8124           end.
     8125           when "b-sel,b-mark"
     8126           then do:
     8127               view
     8128                   b-sel    in frame Dlg-grp
     8129                   b-mark in frame Dlg-grp
     8130               .
     8131           end.
     8132       end case.
     8133   end.
     8134   else do:
     8135       view
     8136           b-goods
     8137       in frame Dlg-grp.
     8138   end.
     8139   RUN proc-b-rubr IN THIS-PROCEDURE (v-rubr).
     8140   br-global :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dlg-grp.
     8141   br-list :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dlg-grp.
     8142   if v-reposition-to-recid = no
     8143   then do:
     8144       reposition br-list to row v-reposition-row no-error .
     8145   end.
     8146   else do:
     8147       reposition br-list to recid v-reposition-row no-error .
     8148   end.
     8149   end.
     8150   END PROCEDURE.
