     2512                   trim(error-status :get-message(2))
     2513                   trim(error-status :get-message(3))
     2514                   trim(error-status :get-message(4))
     2515                   trim(error-status :get-message(5))
     2516               view-as alert-box error.
     2517               undo, return no-apply .
     2518           end.
     2519       end.
