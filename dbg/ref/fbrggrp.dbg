     2569       run expand-or-collapse-item in this-procedure ( INPUT "":U
     2570                                                     , INPUT 0
     2571                                                     , INPUT buf0_temp_fbrglib_grp.mark
     2572                                                     , INPUT buf0_temp_fbrglib_grp.node-code) no-error .
