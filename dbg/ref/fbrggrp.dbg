     2159       WITH NO-ROW-MARKERS SEPARATORS SIZE 56 BY 16.67
     2160            TITLE "Группы блюд для объекта".
     2161   DEFINE FRAME Dlg-grp
     2162        b-exit AT ROW 1 COL 1
     2163        b-mark AT ROW 1 COL 11
     2164        b-sel AT ROW 1 COL 14
     2165        b-add AT ROW 1 COL 24
     2166        b-chg AT ROW 1 COL 34
     2167        b-del AT ROW 1 COL 44
     2168        b-move AT ROW 1 COL 54
     2169        b-goods AT ROW 1 COL 64
     2170        b-print AT ROW 1 COL 79.38
     2171        b-help AT ROW 1 COL 89.38
     2172        B-global AT ROW 2 COL 12
     2173        b-copy AT ROW 2 COL 24
     2174        fi-kitchen-type AT ROW 2 COL 35.38 COLON-ALIGNED
     2175        fi-kitchen-code AT ROW 2 COL 40.75 COLON-ALIGNED NO-LABEL
     2176        bt-sel-kitchen AT ROW 2 COL 50.13
     2177        B-hist AT ROW 2 COL 79.38
     2178        b-expand-0 AT ROW 3 COL 1
     2179        b-expand-all-0 AT ROW 3 COL 4.5
     2180        fi-search-0 AT ROW 3 COL 12 NO-LABEL
     2181        b-find-by-full-name-0 AT ROW 3 COL 34.38
     2182        b-find-by-substring-0 AT ROW 3 COL 37.38
     2183        b-search-0 AT ROW 3 COL 40.38
     2184        b-expand AT ROW 3 COL 51
     2185        b-expand-all AT ROW 3 COL 54.5
     2186        fi-search AT ROW 3 COL 62 NO-LABEL
     2187        b-find-by-full-name AT ROW 3 COL 84
     2188        b-find-by-substring AT ROW 3 COL 87
     2189        b-search AT ROW 3 COL 90
     2190        B-copy0 AT ROW 4.25 COL 33.5
     2191        B-link AT ROW 4.25 COL 44
     2192        br-global AT ROW 5.25 COL 1
     2193        br-list AT ROW 5.25 COL 44
     2194        RECT-rubr AT ROW 2 COL 11
     2195        SPACE(77.00) SKIP(19.12)
     2196       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2197            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2198            TITLE "Группы блюд".
     2199   ASSIGN
     2200          FRAME Dlg-grp:SCROLLABLE       = FALSE
     2201          FRAME Dlg-grp:HIDDEN           = TRUE.
     2202   ASSIGN
     2203          B-copy0:HIDDEN IN FRAME Dlg-grp           = TRUE.
     2204   ASSIGN
     2205          b-expand-0:HIDDEN IN FRAME Dlg-grp           = TRUE.
     2206   ASSIGN
     2207          b-expand-all-0:HIDDEN IN FRAME Dlg-grp           = TRUE.
     2208   ASSIGN
     2209          b-find-by-full-name-0:HIDDEN IN FRAME Dlg-grp           = TRUE.
     2210   ASSIGN
     2211          b-find-by-substring-0:HIDDEN IN FRAME Dlg-grp           = TRUE.
     2212   ASSIGN
     2213          B-link:HIDDEN IN FRAME Dlg-grp           = TRUE.
     2214   ASSIGN
     2215          b-print:POPUP-MENU IN FRAME Dlg-grp       = MENU MENU-b-print:HANDLE.
     2216   ASSIGN
     2217          b-search-0:HIDDEN IN FRAME Dlg-grp           = TRUE.
     2218   ASSIGN
     2219          br-global:SEPARATOR-FGCOLOR IN FRAME Dlg-grp      = 1.
     2220   ASSIGN
     2221          fi-search-0:HIDDEN IN FRAME Dlg-grp           = TRUE.
     2222   ON ENDKEY OF FRAME Dlg-grp
     2223   DO:
     2224       run gbl/markqwa.p (
     2225             input b-mark:visible
     2226           , input p-recid-list
     2227       ) no-error.
     2228       if error-status:error then return no-apply.
     2229   END.
     2230   ON WINDOW-CLOSE OF FRAME Dlg-grp
     2231   DO:
     2232     apply "end-error":U to self.
     2233   END.
     2234   ON CHOOSE OF b-add IN FRAME Dlg-grp
     2235   DO:
     2236       run add-grp in this-procedure (
     2237           input temp_fbrglib_grp.node-code
     2238       ) no-error .
     2239       if error-status :error
     2240       then do:
     2241           message
     2242           vss-workfile vss-revision vss-description
     2243           skip "Ошибка добавления группы блюд."
     2244           skip return-value
     2245           skip trim(error-status :get-message(1))
     2246           trim(error-status :get-message(2))
     2247           trim(error-status :get-message(3))
     2248           view-as alert-box error.
     2249           undo, return no-apply.
     2250       end.
     2251   END.
     2252   ON CHOOSE OF b-chg IN FRAME Dlg-grp
     2253   DO:
     2254       run change-grp in this-procedure (
     2255           input temp_fbrglib_grp.node-code
     2256       ) no-error .
     2257       if error-status :error
     2258       then do:
     2259           message
     2260           vss-workfile vss-revision vss-description
     2261           skip "Ошибка изменения группы блюд."
     2262           skip return-value
     2263           skip trim(error-status :get-message(1))
     2264           trim(error-status :get-message(2))
     2265           trim(error-status :get-message(3))
     2266           view-as alert-box error.
     2267           undo, return no-apply .
     2268       end.
     2269   END.
     2270   ON CHOOSE OF b-copy IN FRAME Dlg-grp
     2271   DO:
     2272       define variable v-recid-list    as character      no-undo.
     2273       define variable v-is-invalid    as logical        no-undo.
     2274       define variable v-from-obj-type as character      no-undo.
     2275       define variable v-from-obj-code as integer        no-undo.
     2276       define variable v-yesno         as logical        no-undo.
     2277       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2278       find first buf_fbr-gds-grp no-lock
     2279            where buf_fbr-gds-grp.obj-type = p-store-type
     2280              and buf_fbr-gds-grp.obj-code = p-store-code
     2281       no-error.
     2282       if available buf_fbr-gds-grp
     2283       then do:
     2284           message
     2285               "Список групп блюд не пуст."
     2286               skip(1)
     2287               skip "Копировать группы с другого объекта"
     2288               skip "можно только полностью."
     2289               skip "Для этого список групп блюд текущего объекта"
     2290               skip "должен быть очищен."
     2291           view-as alert-box error
     2292           title "Копирование групп блюд".
     2293           undo, return no-apply.
     2294       end.
     2295       assign
     2296           v-recid-list = ""
     2297       .
     2298       run ref/fbrggrp.w (
     2299             input parparentproc
     2300           , input p-store-type
     2301           , input p-store-code
     2302           , input "buttons-for-objcopy"
     2303           , input-output v-recid-list
     2304       ) no-error .
     2305       if error-status :error
     2306       then do:
     2307           message
     2308             vss-workfile vss-revision vss-description
     2309             skip "Ошибка выбора объекта для копирования групп блюд."
     2310             skip return-value
     2311             skip trim(error-status :get-message(1))
     2312                  trim(error-status :get-message(2))
     2313                  trim(error-status :get-message(3))
     2314           view-as alert-box error.
     2315           undo, return no-apply.
     2316       end.
     2317       if num-entries( v-recid-list ) = 2
     2318       then do:
     2319           assign
     2320               v-from-obj-type = entry( 1, v-recid-list )
     2321               v-from-obj-code = integer( entry( 2, v-recid-list ) )
     2322           .
     2323           if  v-from-obj-type = p-store-type
     2324           and v-from-obj-code = p-store-code
     2325           then do:
     2326               message
     2327                   "Для копирования выбран текущий объект."
     2328                   skip(1)
     2329                   skip "Копирование групп блюд невозможно."
     2330               view-as alert-box error.
     2331               undo, return no-apply.
     2332           end.
     2333           run check-object in this-procedure (
     2334                 input v-from-obj-type
     2335               , input v-from-obj-code
     2336               , output v-is-invalid
     2337           ).
     2338           if v-is-invalid = yes
     2339           or ( v-from-obj-type = p-store-type
     2340            and v-from-obj-code = p-store-code )
     2341           then do:
     2342               message
     2343                   "Неверно выбран объект для копирования групп блюд."
     2344               view-as alert-box error.
     2345               undo, return no-apply.
     2346           end.
     2347           message
     2348               "Выбран объект для копирования групп блюд."
     2349               skip "Структура групп блюд и привязки"
     2350               skip "товаров к группам блюд будут"
     2351               skip "скопированы с выбранного объекта."
     2352               skip(1)
     2353               skip "Выбранный объект:" v-from-obj-type v-from-obj-code
     2354               skip "Текущий объект:" p-store-type p-store-code
     2355               skip(1)
     2356               skip "Копировать группы блюд?"
     2357           view-as alert-box question
     2358           buttons yes-no
     2359           title "Копирование групп блюд"
     2360           update v-yesno
     2361           .
     2362           if v-yesno = no
     2363           then do:
     2364               message
     2365                   "Копирование групп блюд прервано."
     2366               view-as alert-box information.
     2367               undo, return no-apply.
     2368           end.
     2369           run copy-group-list-from-obj in this-procedure (
     2370                 input v-from-obj-type
     2371               , input v-from-obj-code
     2372               , input p-store-type
     2373               , input p-store-code
     2374           ) no-error.
     2375           if error-status :error
     2376           then do:
     2377               message
     2378                        vss-workfile vss-revision vss-description
     2379                   skip "Ошибка копирования групп блюд с другого объекта."
     2380                   skip return-value
     2381                   skip trim(error-status :get-message(1))
     2382                        trim(error-status :get-message(2))
     2383                        trim(error-status :get-message(3))
     2384               view-as alert-box error.
     2385               undo, return no-apply .
     2386           end.
     2387           run UI-on in this-procedure no-error .
     2388       end.
     2389       else do:
     2390           message
     2391                    vss-workfile vss-revision vss-description
     2392               skip "Ошибка передачи параметров для копирования групп."
     2393               skip return-value
     2394               skip trim(error-status :get-message(1))
     2395                    trim(error-status :get-message(2))
     2396                    trim(error-status :get-message(3))
     2397           view-as alert-box error.
     2398           undo, return no-apply .
     2399       end.
     2400   END.
     2401   ON CHOOSE OF B-copy0 IN FRAME Dlg-grp
     2402   DO:
     2403     run copy-from-global-grp in this-procedure (
     2404           input temp_fbrglib_grp.node-code
     2405           ,input buf0_temp_fbrglib_grp.node-code
     2406           ,input buf0_temp_fbrglib_grp.global-code
     2407       ) no-error .
