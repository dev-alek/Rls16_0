     2634   ON CHOOSE OF b-find-by-full-name IN FRAME Dlg-grp
     2635   DO:
     2636       define variable v-new-name as character no-undo.
     2637       run fbrglib-expand-name in this-procedure (
     2638             input p-store-type
     2639           , input p-store-code
     2640           , input fi-search :screen-value
     2641           , output v-new-name
     2642       ) no-error.
     2643       if error-status :error
     2644       then do:
     2645           message return-value.
     2646           undo, return no-apply.
     2647       end.
     2648       if v-new-name = ""
     2649       then do:
     2650           message
     2651               "Не найдена группа с полным именем, начинающимся на"
     2652               skip "'" + fi-search :screen-value + "'"
     2653           view-as alert-box information.
     2654           assign
     2655               v-new-name = fi-search :screen-value
     2656           .
     2657       end.
     2658       assign
     2659           fi-search :screen-value  = right-trim( v-new-name, chr(47) )
     2660           fi-search :cursor-offset = length( v-new-name ) + 1
     2661       .
     2662   END.
     2663   ON LEAVE OF b-find-by-full-name IN FRAME Dlg-grp
     2664   DO:
