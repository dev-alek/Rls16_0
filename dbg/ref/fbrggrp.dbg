        1   define input parameter parparentproc        as widget-handle    no-undo.
        2   define input parameter p-store-type         as character    no-undo.
        3   define input parameter p-store-code         as integer      no-undo.
        4   define input parameter p-button-list        as character    no-undo.
        5   define input-output parameter p-recid-list  as character    no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Управление деревом групп блюд".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define variable vss-include-info0 as character format "X(65)" no-undo
       73   initial "@(#)$Workfile$ $Revision$".
       74   define temp-table temp_fbrglib_grp no-undo
       75       field sel           as character
       76       field full-name     as character
       77       field out-code      as integer
       78       field sort-name     as character
       79       field node-code     as integer
       80       field upper-code    as integer
       81       field name          as character
       82       field level         as integer
       83       field mark          as character
       84       field obj-type      as character
       85       field obj-code      as integer
       86       field global-code   as integer
       87       index pi is primary unique obj-type obj-code sort-name
       88       index fn obj-type obj-code full-name
       89       index nc is unique obj-type obj-code node-code
       90       index sl obj-type obj-code sel
       91       index uc obj-type obj-code upper-code
       92   .
       93   define temp-table temp_fbrglib_found-grp no-undo
       94       field full-name   as character
       95       field sort-name   as character
       96       field node-code   as integer
       97       field level       as integer
       98       field is-terminal as logical
       99       field obj-type      as character
      100       field obj-code      as integer
      101       index pi is primary unique obj-type obj-code sort-name
      102       index fn obj-type obj-code full-name
      103       index lv obj-type obj-code level
      104       index it obj-type obj-code is-terminal
      105   .
      106   define temp-table temp_found-result-nodelist no-undo
      107       field node-code     as integer
      108       field processed     as logical
      109       field sort-name     as character
      110       field full-name     as character
      111       index pi is primary unique node-code
      112       index ps processed
      113   .
      114   procedure fbrglib-get-sort-name :
      115   do
      116   on error undo, return error
      117   :
      118   define input parameter p-obj-type   as character    no-undo.
      119   define input parameter p-obj-code   as integer      no-undo.
      120   define input parameter p-node-code  as integer      no-undo.
      121   define output parameter p-sort-name as character    no-undo.
      122       define variable v-upper-code    as integer           no-undo.
      123       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      124       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
      125       find first buf_fbr-gds-grp no-lock
      126            where buf_fbr-gds-grp.obj-type  = p-obj-type
      127              and buf_fbr-gds-grp.obj-code  = p-obj-code
      128              and buf_fbr-gds-grp.node-code = p-node-code
      129       no-error.
      130       if not available buf_fbr-gds-grp
      131       then do:
      132           undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      133       end.
      134       assign
      135           p-sort-name  = ""
      136           v-upper-code = 1
      137       .
      138       do while true
      139       on error undo, return error "fbrglib-get-sort-name: Ошибка составления полного имени группы"
      140       :
      141           assign
      142               p-sort-name  = buf_fbr-gds-grp.node-name
      143                            + (if p-sort-name <> "" then chr(2) else "")
      144                            + p-sort-name
      145               v-upper-code = buf_fbr-gds-grp.upper-code
      146           .
      147           if buf_fbr-gds-grp.upper-code = 1
      148           then do:
      149               leave.
      150           end.
      151           find first buf_fbr-gds-grp no-lock
      152                where buf_fbr-gds-grp.obj-type  = p-obj-type
      153                  and buf_fbr-gds-grp.obj-code  = p-obj-code
      154                  and buf_fbr-gds-grp.node-code = v-upper-code
      155           no-error.
      156           if not available buf_fbr-gds-grp
      157           then do:
      158               undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом "
      159                                   + string( v-upper-code )
      160                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      161           end.
      162       end.
      163   end.
      164   end procedure.
      165   procedure fbrglib-get-full-name :
      166   do
      167   on error undo, return error
      168   :
      169   define input parameter p-obj-type   as character    no-undo.
      170   define input parameter p-obj-code   as integer      no-undo.
      171   define input parameter p-node-code  as integer      no-undo.
      172   define output parameter p-full-name as character    no-undo.
      173       define variable v-upper-code    as integer           no-undo.
      174       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      175       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
      176       if p-node-code = 1
      177       then do:
      178           assign
      179               p-full-name = ""
      180           .
      181       end.
      182       else do:
      183           find first buf_fbr-gds-grp no-lock
      184                where buf_fbr-gds-grp.obj-type  = p-obj-type
      185                  and buf_fbr-gds-grp.obj-code  = p-obj-code
      186                  and buf_fbr-gds-grp.node-code = p-node-code
      187           no-error.
      188           if not available buf_fbr-gds-grp
      189           then do:
      190               undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      191           end.
      192           assign
      193               p-full-name  = ""
      194               v-upper-code = 1
      195           .
      196           do while true
      197           on error undo, return error "fbrglib-get-full-name: Ошибка составления полного имени группы"
      198           :
      199               assign
      200                   p-full-name  = buf_fbr-gds-grp.node-name
      201                               + (if p-full-name <> "" then chr(47) else "")
      202                               + p-full-name
      203                   v-upper-code = buf_fbr-gds-grp.upper-code
      204               .
      205               if buf_fbr-gds-grp.upper-code = 1
      206               then do:
      207                   leave.
      208               end.
      209               find first buf_fbr-gds-grp no-lock
      210                    where buf_fbr-gds-grp.obj-type  = p-obj-type
      211                      and buf_fbr-gds-grp.obj-code  = p-obj-code
      212                      and buf_fbr-gds-grp.node-code = v-upper-code
      213               no-error.
      214               if not available buf_fbr-gds-grp
      215               then do:
      216                   undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом "
      217                                       + string( v-upper-code )
      218                                       + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      219               end.
      220           end.
      221           assign
      222               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      223           .
      224       end.
      225   end.
      226   end procedure.
      227   procedure fbrglib-get-root-code :
      228   do
      229   on error undo, return error
      230   :
      231   define output parameter p-root-code as integer      no-undo.
      232       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      233       find first buf_fbr-gds-grp no-lock
      234            where buf_fbr-gds-grp.upper-code = 0
      235       no-error .
      236       if not available buf_fbr-gds-grp
      237       then do:
      238           undo, return error .
      239       end.
      240       else do:
      241           assign
      242               p-root-code = buf_fbr-gds-grp.node-code
      243           .
      244       end.
      245   end.
      246   end procedure.
      247   procedure fbrglib-find-grp-by-full-name :
      248   do
      249   on error undo, return error
      250   :
      251   define input parameter p-obj-type     as character    no-undo.
      252   define input parameter p-obj-code     as integer      no-undo.
      253   define input parameter p-search-name  as character    no-undo.
      254   define input parameter p-fill-path    as logical      no-undo.
      255       define variable v-upper-code    as integer          no-undo.
      256       define variable v-not-found     as logical init yes no-undo.
      257       define variable v-counter       as integer           no-undo.
      258       define variable v-level         as integer           no-undo.
      259       define variable v-full-name     as character         no-undo.
      260       define variable v-sort-name     as character         no-undo.
      261       define variable v-node-name     as character      no-undo.
      262       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      263       assign
      264           p-search-name = replace( p-search-name, chr(47), chr(2) )
      265       .
      266       run fbrglib-get-root-code ( output v-upper-code ) no-error .
      267       if error-status :error
      268       then do:
      269           undo, return error "fbrglib-find-grp-by-full-name: Ошибка при поиске корневого узла".
      270       end.
      271       assign
      272           v-full-name  = ""
      273           v-level      = num-entries( p-search-name, chr(2) )
      274       .
      275       for each temp_fbrglib_found-grp
      276       :
      277           delete temp_fbrglib_found-grp.
      278       end.
      279       start-name-analyze:
      280       do v-counter = 1 to v-level
      281       :
      282           if v-counter < v-level
      283           then do:
      284               assign
      285                   v-node-name = entry( v-counter, p-search-name, chr(2) )
      286               .
      287               find first buf_fbr-gds-grp no-lock
      288                    where buf_fbr-gds-grp.obj-type   = p-obj-type
      289                      and buf_fbr-gds-grp.obj-code   = p-obj-code
      290                      and buf_fbr-gds-grp.upper-code = v-upper-code
      291                      and buf_fbr-gds-grp.node-name  = v-node-name
      292               no-error .
      293               if not available buf_fbr-gds-grp
      294               then do:
      295                   assign
      296                       v-full-name  = p-search-name
      297                       v-sort-name  = p-search-name
      298                   .
      299                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(47) ).
      300               end.
      301               else do:
      302                   assign
      303                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_fbr-gds-grp.node-name
      304                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_fbr-gds-grp.node-name
      305                       v-upper-code = buf_fbr-gds-grp.node-code
      306                   .
      307                   if p-fill-path = yes
      308                   then do:
      309                       create temp_fbrglib_found-grp.
      310                       assign
      311                           temp_fbrglib_found-grp.full-name = v-full-name + chr(47)
      312                           temp_fbrglib_found-grp.sort-name = v-sort-name
      313                           temp_fbrglib_found-grp.node-code = v-upper-code
      314                           temp_fbrglib_found-grp.level     = v-counter
      315                           temp_fbrglib_found-grp.obj-type  = p-obj-type
      316                           temp_fbrglib_found-grp.obj-code  = p-obj-code
      317                       .
      318                   end.
      319               end.
      320           end.
      321           else do:
      322               for each buf_fbr-gds-grp no-lock
      323                  where buf_fbr-gds-grp.obj-type   = p-obj-type
      324                    and buf_fbr-gds-grp.obj-code   = p-obj-code
      325                    and buf_fbr-gds-grp.upper-code = v-upper-code
      326                    and buf_fbr-gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      327               :
      328                   assign
      329                       v-not-found = no
      330                   .
      331                   create temp_fbrglib_found-grp.
      332                   assign
      333                       temp_fbrglib_found-grp.full-name = v-full-name
      334                                                           + (if v-full-name = "" then "" else chr(47) )
      335                                                           + buf_fbr-gds-grp.node-name + chr(47)
      336                       temp_fbrglib_found-grp.sort-name = v-sort-name
      337                                                           + ( if v-sort-name = "" then "" else chr(2) )
      338                                                           + buf_fbr-gds-grp.node-name
      339                       temp_fbrglib_found-grp.node-code = buf_fbr-gds-grp.node-code
      340                       temp_fbrglib_found-grp.level     = v-level
      341                       temp_fbrglib_found-grp.obj-type  = p-obj-type
      342                       temp_fbrglib_found-grp.obj-code  = p-obj-code
      343                   .
      344               end.
      345               if v-not-found = yes
      346               then do:
      347                   assign
      348                       v-full-name  = p-search-name
      349                       v-sort-name  = p-search-name
      350                   .
      351                   for each temp_fbrglib_found-grp
      352                   :
      353                       delete temp_fbrglib_found-grp.
      354                   end.
      355                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      356               end.
      357           end.
      358       end.
      359   end.
      360   end procedure.
      361   procedure fbrglib-find-all-subgroup :
      362   do
      363   on error undo, return error
      364   :
      365   define input parameter p-start-obj-type     as character    no-undo.
      366   define input parameter p-start-obj-code     as integer      no-undo.
      367   define input parameter p-start-node-code    as integer      no-undo.
      368   define input parameter p-terminal-only      as logical      no-undo.
      369       define variable v-start-full-name   as character     no-undo.
      370       define variable v-start-sort-name   as character     no-undo.
      371       define variable v-not-found         as logical       no-undo.
      372       define variable v-is-terminal       as logical       no-undo.
      373       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
      374       create temp_found-result-nodelist.
      375       assign
      376           temp_found-result-nodelist.node-code = p-start-node-code
      377           temp_found-result-nodelist.processed = no
      378       .
      379       run fbrglib-get-full-name in this-procedure (
      380             input p-start-obj-type
      381           , input p-start-obj-code
      382           , input p-start-node-code
      383           , output v-start-full-name
      384       ).
      385       run fbrglib-get-full-name in this-procedure (
      386             input p-start-obj-type
      387           , input p-start-obj-code
      388           , input p-start-node-code
      389           , output v-start-sort-name
      390       ).
      391       process-nodes:
      392       do while yes
      393       :
      394           find first temp_found-result-nodelist
      395                where temp_found-result-nodelist.node-code = p-start-node-code
      396           .
      397           assign
      398               temp_found-result-nodelist.processed = yes
      399           .
      400           for each buf_fbr-gds-grp no-lock
      401              where buf_fbr-gds-grp.obj-type   = p-start-obj-type
      402                and buf_fbr-gds-grp.obj-code   = p-start-obj-code
      403                and buf_fbr-gds-grp.upper-code = p-start-node-code
      404           on error undo, return error
      405           :
      406               run fbrglib-is-terminal in this-procedure (
      407                     input buf_fbr-gds-grp.obj-type
      408                   , input buf_fbr-gds-grp.obj-code
      409                   , input buf_fbr-gds-grp.node-code
      410                   , output v-is-terminal
      411               ).
      412               if v-is-terminal = yes
      413               then do:
      414                   create temp_fbrglib_found-grp.
      415                   assign
      416                       temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      417                                                           chr(47) + buf_fbr-gds-grp.node-name + chr(47)
      418                       temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      419                                                           chr(2) + buf_fbr-gds-grp.node-name + chr(2)
      420                       temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
      421                       temp_fbrglib_found-grp.is-terminal = yes
      422                       temp_fbrglib_found-grp.obj-type  = p-start-obj-type
      423                       temp_fbrglib_found-grp.obj-code  = p-start-obj-code
      424                   .
      425               end.
      426               else do:
      427                   create temp_found-result-nodelist.
      428                   assign
      429                       temp_found-result-nodelist.node-code = buf_fbr-gds-grp.node-code
      430                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      431                                                              chr(47) + buf_fbr-gds-grp.node-name + chr(47)
      432                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      433                                                              chr(2) + buf_fbr-gds-grp.node-name + chr(2)
      434                       temp_found-result-nodelist.processed = no
      435                   .
      436                   if p-terminal-only = no
      437                   then do:
      438                       create temp_fbrglib_found-grp.
      439                       assign
      440                           temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      441                                                               chr(47) + buf_fbr-gds-grp.node-name + chr(47)
      442                           temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      443                                                               chr(2) + buf_fbr-gds-grp.node-name + chr(2)
      444                           temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
      445                           temp_fbrglib_found-grp.is-terminal = no
      446                           temp_fbrglib_found-grp.obj-type  = p-start-obj-type
      447                           temp_fbrglib_found-grp.obj-code  = p-start-obj-code
      448                       .
      449                   end.
      450               end.
      451           end.
      452           find first temp_found-result-nodelist
      453                where temp_found-result-nodelist.processed = no
      454           no-error.
      455           if not available temp_found-result-nodelist
      456           then do:
      457               leave process-nodes.
      458           end.
      459           else do:
      460               assign
      461                   p-start-node-code = temp_found-result-nodelist.node-code
      462                   v-start-full-name = temp_found-result-nodelist.full-name
      463                   v-start-sort-name = temp_found-result-nodelist.sort-name
      464               .
      465           end.
      466       end.
      467   end.
      468   end procedure.
      469   procedure fbrglib-expand-name :
      470   do
      471   on error undo, return error
      472   :
      473   define input parameter p-obj-type   as character    no-undo.
      474   define input parameter p-obj-code   as integer      no-undo.
      475   define input parameter p-start-name as character    no-undo.
      476   define output parameter p-end-name  as character    no-undo.
      477       define variable v-is-terminal     as logical           no-undo.
      478       define buffer buf_temp_fbrglib_found-grp     for temp_fbrglib_found-grp.
      479       run fbrglib-find-grp-by-full-name in this-procedure (
      480             input p-obj-type
      481           , input p-obj-code
      482           , input p-start-name
      483           , input no
      484       ) no-error.
      485       run fbrglib-get-max-substring in this-procedure (
      486              input p-obj-type
      487           ,  input p-obj-code
      488           ,  input length( p-start-name )
      489           , output p-end-name
      490       ) no-error .
      491       if error-status :error
      492       then do:
      493           assign
      494               p-end-name = ""
      495           .
      496       end.
      497       else do:
      498           find first temp_fbrglib_found-grp
      499                where temp_fbrglib_found-grp.full-name = p-end-name
      500                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
      501                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      502                        no-error.
      503           if available temp_fbrglib_found-grp
      504           then do:
      505               find first buf_temp_fbrglib_found-grp
      506                    where buf_temp_fbrglib_found-grp.full-name begins p-end-name
      507                      and recid( buf_temp_fbrglib_found-grp ) <> recid( temp_fbrglib_found-grp )
      508                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
      509                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      510               no-error.
      511               if not available buf_temp_fbrglib_found-grp
      512               then do:
      513                   run fbrglib-is-terminal in this-procedure (
      514                         input p-obj-type
      515                       , input p-obj-code
      516                       , input temp_fbrglib_found-grp.node-code
      517                       , output v-is-terminal
      518                   ).
      519               end.
      520           end.
      521       end.
      522   end.
      523   end procedure.
      524   procedure fbrglib-get-max-substring :
      525   do
      526   on error undo, return error
      527   :
      528   define input parameter p-obj-type as character no-undo .
      529   define input parameter p-obj-code as integer no-undo .
      530   define input parameter p-min-substring-length   as integer      no-undo.
      531   define output parameter p-substring             as character    no-undo.
      532           define variable v-char-counter  as integer           no-undo.
      533           define variable v-current-char  as character         no-undo.
      534           define variable v-names-counter  as integer           no-undo.
      535           define variable v-base-string   as character         no-undo.
      536           assign
      537               v-char-counter  = p-min-substring-length
      538           .
      539           find first temp_fbrglib_found-grp  where
      540                      temp_fbrglib_found-grp.obj-type  = p-obj-type
      541                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      542           no-error.
      543           if not available temp_fbrglib_found-grp
      544           then do:
      545               undo, return error "fbrglib-get-max-substring: Нет строк для вычисления общей подстроки".
      546           end.
      547           else do:
      548               assign
      549                   v-base-string = temp_fbrglib_found-grp.full-name
      550               .
      551               counter-block:
      552               do while yes
      553               on error undo, return error "fbrglib-get-max-substring: Ошибка вычисления продолжения имени группы."
      554               :
      555                   assign
      556                       v-char-counter  = v-char-counter + 1
      557                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      558                       v-names-counter = 0
      559                   .
      560                   compare-block:
      561                   for each temp_fbrglib_found-grp
      562                   where temp_fbrglib_found-grp.obj-type  = p-obj-type
      563                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      564                   :
      565                       assign
      566                           v-names-counter = v-names-counter + 1
      567                       .
      568                       if v-names-counter = 1
      569                       then do:
      570                           next compare-block.
      571                       end.
      572                       if substring( temp_fbrglib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      573                       then do:
      574                           leave counter-block.
      575                       end.
      576                   end.
      577                   if v-names-counter = 1
      578                   then do:
      579                       assign
      580                           p-substring = v-base-string
      581                       .
      582                       return.
      583                   end.
      584               end.
      585               assign
      586                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      587               .
      588           end.
      589   end.
      590   end procedure.
      591   procedure fbrglib-is-terminal :
      592   do
      593   on error undo, return error "Ошибка процедуры fbrglib-is-terminal"
      594   :
      595   define input parameter p-obj-type       as character    no-undo.
      596   define input parameter p-obj-code       as integer      no-undo.
      597   define input parameter p-node-code      as integer      no-undo.
      598   define output parameter p-is-terminal   as logical      no-undo.
      599       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      600       find first buf_fbr-gds-grp no-lock
      601            where buf_fbr-gds-grp.obj-type   = p-obj-type
      602              and buf_fbr-gds-grp.obj-code   = p-obj-code
      603              and buf_fbr-gds-grp.upper-code = p-node-code
      604       no-error .
      605       if not available buf_fbr-gds-grp
      606       then do:
      607           assign
      608               p-is-terminal = yes
      609           .
      610       end.
      611       else do:
      612           assign
      613               p-is-terminal = no
      614           .
      615       end.
      616   end.
      617   end procedure.
      618   procedure fbrglib-have-goods :
      619   do
      620   on error undo, return error
      621   :
      622   define input parameter p-obj-type           as character    no-undo.
      623   define input parameter p-obj-code           as integer      no-undo.
      624   define input parameter p-node-code          as integer      no-undo.
      625   define output parameter p-have-fbr-gds-obj  as logical      no-undo.
      626       define buffer buf_fbr-gds-obj         for ub.fbr-gds-obj.
      627       find first buf_fbr-gds-obj no-lock
      628            where buf_fbr-gds-obj.obj-type     = p-obj-type
      629              and buf_fbr-gds-obj.obj-code     = p-obj-code
      630              and buf_fbr-gds-obj.fbr-grp-code = p-node-code
      631       no-error .
      632       if available buf_fbr-gds-obj
      633       then do:
      634           assign
      635               p-have-fbr-gds-obj = yes
      636           .
      637       end.
      638       else do:
      639           assign
      640               p-have-fbr-gds-obj = no
      641           .
      642       end.
      643   end.
      644   end procedure.
      645   procedure fbrglib-find-by-substring :
      646   do
      647   on error undo, return error
      648   :
      649   define input parameter p-start-obj-type     as character    no-undo.
      650   define input parameter p-start-obj-code     as integer      no-undo.
      651   define input parameter p-start-code         as integer      no-undo.
      652   define input parameter p-full-search-string as character    no-undo.
      653   define output parameter p-found-code        as integer      no-undo.
      654   define output parameter p-full-name         as character    no-undo.
      655       define variable v-start-code     as integer           no-undo.
      656       define variable v-found          as logical  init no  no-undo.
      657       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      658       search-grp:
      659       for each buf_fbr-gds-grp no-lock
      660           where buf_fbr-gds-grp.obj-type  = p-start-obj-type
      661             and buf_fbr-gds-grp.obj-code  = p-start-obj-code
      662             and buf_fbr-gds-grp.node-code > p-start-code
      663       :
      664           if index( buf_fbr-gds-grp.node-name, p-full-search-string ) <> 0
      665           then do:
      666               assign
      667                   p-found-code = buf_fbr-gds-grp.node-code
      668                   v-found      = yes
      669               .
      670               run fbrglib-get-full-name in this-procedure (
      671                     input p-start-obj-type
      672                   , input p-start-obj-code
      673                   , input p-found-code
      674                   , output p-full-name
      675               ) no-error .
      676               if error-status :error
      677               then do:
      678                   undo, return error "fbrglib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
      679               end.
      680               leave search-grp.
      681           end.
      682       end.
      683       if v-found = yes
      684       then do:
      685       end.
      686       else do:
      687           assign
      688               p-full-name  = ""
      689               p-found-code = 0
      690           .
      691       end.
      692   end.
      693   end procedure.
      694   procedure fbrglib-analyze-grp-name :
      695   do
      696   on error undo, return error
      697   :
      698   define input parameter p-grp-name       as character            no-undo.
      699   define input parameter p-obj-type       as character            no-undo.
      700   define input parameter p-obj-code       as integer              no-undo.
      701   define input parameter p-upper-code     as integer              no-undo.
      702   define output parameter p-error-message as character init ""    no-undo.
      703       define variable v-char-list     as character    no-undo.
      704       define variable v-char-counter  as integer      no-undo.
      705       define variable v-full-name     as character    no-undo.
      706       if p-grp-name = "" then do:
      707           assign
      708               p-error-message = "Название группы не может быть пустым.".
      709           .
      710       end.
      711       else do:
      712           assign
      713               v-char-list = "47,92,58,63,34,60,62,171,187,183"
      714           .
      715           do v-char-counter = 1 to num-entries( v-char-list )
      716           :
      717               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
      718               then do:
      719                   assign
      720                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
      721                   .
      722                   return.
      723               end.
      724           end.
      725           run fbrglib-get-full-name in this-procedure (
      726                 input p-obj-type
      727               , input p-obj-code
      728               , input p-upper-code
      729               , output v-full-name
      730           ) no-error .
      731           if error-status :error
      732           then do:
      733               undo, return error "fbrglib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
      734           end.
      735           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
      736           then do:
      737               assign
      738                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
      739               .
      740           end.
      741       end.
      742   end.
      743   end procedure.
      744   procedure fbrglib-delete-grp :
      745   do
      746   on error undo, return error
      747   :
      748   define input parameter p-obj-type   as character    no-undo.
      749   define input parameter p-obj-code   as integer      no-undo.
      750   define input parameter p-node-code  as integer      no-undo.
      751   define output parameter p-deleted   as logical      no-undo.
      752       define variable v-have-goods    as logical        no-undo.
      753       define variable v-yesno         as logical        no-undo.
      754       define variable v-upper-code    as integer        no-undo.
      755       define variable v-root-code     as integer        no-undo.
      756       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
      757       define buffer buf_fbr-gds-obj           for ub.fbr-gds-obj.
      758       define buffer buf_second_fbr-gds-grp    for ub.fbr-gds-grp.
      759       run fbrglib-get-root-code in this-procedure (
      760           output v-root-code
      761       ) no-error.
      762       if error-status :error
      763       then do:
      764           undo, return error "Не найден корневой узел." + chr(10) + return-value.
      765       end.
      766       if p-node-code = v-root-code
      767       then do:
      768           message
      769               "Корневую группу удалить невозможно."
      770           view-as alert-box error.
      771           assign
      772               p-deleted = no
      773           .
      774           undo, return.
      775       end.
      776       find first buf_fbr-gds-grp no-lock
      777            where buf_fbr-gds-grp.obj-type     = p-obj-type
      778              and buf_fbr-gds-grp.obj-code     = p-obj-code
      779              and buf_fbr-gds-grp.upper-code   = p-node-code
      780       no-error.
      781       if available buf_fbr-gds-grp
      782       then do:
      783           message
      784               "Не терминальную группу удалить невозможно."
      785           view-as alert-box error.
      786           assign
      787               p-deleted = no
      788           .
      789           undo, return.
      790       end.
      791       find first buf_fbr-gds-grp no-lock
      792            where buf_fbr-gds-grp.obj-type     = p-obj-type
      793              and buf_fbr-gds-grp.obj-code     = p-obj-code
      794              and buf_fbr-gds-grp.node-code    = p-node-code
      795       .
      796       assign
      797           v-upper-code = buf_fbr-gds-grp.upper-code
      798       .
      799       run fbrglib-have-goods in this-procedure (
      800             input p-obj-type
      801           , input p-obj-code
      802           , input p-node-code
      803           , output v-have-goods
      804       ).
      805       if v-have-goods = yes
      806       then do:
      807           find first buf_second_fbr-gds-grp no-lock
      808                where buf_second_fbr-gds-grp.obj-type      = buf_fbr-gds-grp.obj-type
      809                  and buf_second_fbr-gds-grp.obj-code      = buf_fbr-gds-grp.obj-code
      810                  and buf_second_fbr-gds-grp.upper-code    = buf_fbr-gds-grp.upper-code
      811                  and recid( buf_second_fbr-gds-grp )      <> recid( buf_fbr-gds-grp )
      812           no-error.
      813           if available buf_second_fbr-gds-grp
      814           then do:
      815               message
      816                   "В группе есть товары,"
      817                   skip "которые нельзя перенести в родительскую группу,"
      818                   skip "потому что у родительской группы есть еще одна подгруппа."
      819                   skip(1)
      820                   skip "Перенесите товары в другую группу"
      821                   skip "или удалите все остальные подгруппы родительской группы."
      822               view-as alert-box error.
      823               assign
      824                   p-deleted = no
      825               .
      826               undo, return.
      827           end.
      828           message
      829               "В группе есть товары."
      830               skip "После удаления группы"
      831               skip "все ее товары будут привязаны"
      832               skip "к ее родительской группе."
      833               skip(1)
      834               skip "Удалить группу?"
      835           view-as alert-box warning
      836           buttons yes-no
      837           title "Удаление группы"
      838           update v-yesno
      839           .
      840           if v-yesno = yes
      841           then do:
      842               do transaction
      843               on error undo, return error
      844               :
      845                   for each buf_fbr-gds-obj exclusive-lock
      846                      where buf_fbr-gds-obj.obj-type     = p-obj-type
      847                        and buf_fbr-gds-obj.obj-code     = p-obj-code
      848                        and buf_fbr-gds-obj.fbr-grp-code = p-node-code
      849                   on error undo, return error
      850                   :
      851                       assign
      852                           buf_fbr-gds-obj.fbr-grp-code = v-upper-code
      853                       .
      854                   end.
      855               end.
      856               do transaction
      857               on error undo, return error
      858               :
      859                   find current buf_fbr-gds-grp exclusive-lock .
      860                   delete buf_fbr-gds-grp no-error .
      861                   if error-status:error then do:
      862                     undo, return error return-value .
      863                   end.
      864               end.
      865           end.
      866       end.
      867       else do:
      868           message
      869               "Имя группы: " buf_fbr-gds-grp.node-name
      870               "Код группы: " buf_fbr-gds-grp.node-code
      871               skip(1)
      872               skip "Удалить группу?"
      873           view-as alert-box warning
      874           buttons yes-no
      875           title "Удаление группы"
      876           update v-yesno
      877           .
      878           if v-yesno = yes
      879           then do:
      880               do transaction
      881               on error undo, return error
      882               :
      883                   find current buf_fbr-gds-grp exclusive-lock .
      884                   delete buf_fbr-gds-grp no-error.
      885                   if error-status:error then do:
      886                     undo, return error return-value .
      887                   end.
      888               end.
      889           end.
      890       end.
      891   end.
      892   end procedure.
      893   procedure fbrglib-add-grp :
      894   do
      895   on error undo, return error
      896   :
      897   define input parameter p-obj-type       as character    no-undo.
      898   define input parameter p-obj-code       as integer      no-undo.
      899   define input parameter p-node-code      as integer      no-undo.
      900   define input parameter p-interface      as logical      no-undo.
      901   define input parameter p-node-name      as character    no-undo.
      902   define input parameter p-out-code       as integer      no-undo.
      903   define input parameter p-global-code    as integer      no-undo.
      904   define output parameter p-new-node-code as integer      no-undo.
      905   define output parameter p-cancel        as logical      no-undo.
      906       define variable v-have-goods    as logical  no-undo.
      907       define variable v-host-code     as integer        no-undo.
      908       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      909       define buffer bf_fbr-gds-grp        for ub.fbr-gds-grp.
      910       define buffer buf_fbr-gds-obj       for ub.fbr-gds-obj.
      911       run fbrglib-have-goods in this-procedure (
      912             input p-obj-type
      913           , input p-obj-code
      914           , input p-node-code
      915           , output v-have-goods
      916       ) no-error .
      917       if error-status :error
      918       then do:
      919           message
      920                    vss-workfile vss-revision vss-description
      921               skip "Ошибка определения наличия товаров в группе."
      922               skip return-value
      923               skip trim(error-status :get-message(1))
      924                    trim(error-status :get-message(2))
      925                    trim(error-status :get-message(3))
      926           view-as alert-box error.
      927           undo, return error .
      928       end.
      929   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      930   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      931     (input  p-obj-type
      932     ,input  p-obj-code
      933     ,output v-host-code
      934     )  .
      935       find first buf_fbr-gds-grp no-lock where
      936                 buf_fbr-gds-grp.upper-code = p-node-code
      937             AND buf_fbr-gds-grp.obj-type   = p-obj-type
      938             AND buf_fbr-gds-grp.obj-code   = p-obj-code
      939             AND buf_fbr-gds-grp.node-name  = p-node-name no-error .
      940       if available buf_fbr-gds-grp then do:
      941           if p-node-code <> 1 then do:
      942             find first buf_fbr-gds-grp no-lock where
      943                       buf_fbr-gds-grp.node-code = p-node-code
      944                   AND buf_fbr-gds-grp.obj-type   = p-obj-type
      945                   AND buf_fbr-gds-grp.obj-code   = p-obj-code  .
      946           end.
      947                   message
      948           "Для объекта" p-obj-type p-obj-code
      949           "уже есть группа блюд" p-node-name "в подгруппе" (if p-node-code = 1 then "БЛЮДА" else buf_Fbr-gds-grp.node-name)
      950           view-as alert-box error .
      951           undo, return error .
      952       end.
      953       do transaction
      954       on error undo, return error
      955       :
      956           create buf_fbr-gds-grp.
      957           assign
      958               buf_fbr-gds-grp.node-code   = next-value( s-gds-grp, ub )
      959               p-new-node-code             = buf_fbr-gds-grp.node-code
      960               buf_fbr-gds-grp.upper-code  = p-node-code
      961               buf_fbr-gds-grp.host-code   = v-host-code
      962               buf_fbr-gds-grp.obj-type    = p-obj-type
      963               buf_fbr-gds-grp.obj-code    = p-obj-code
      964               buf_fbr-gds-grp.node-name    = ""
      965               buf_fbr-gds-grp.out-code    = 0
      966           .
      967           if p-interface then do:
      968             run ref/fbrggrpd.w (
      969                   input parparentproc
      970                 , input 'ИЗМЕНЕНИЕ':U
      971                 , input p-obj-type
      972                 , input p-obj-code
      973                 , input buf_fbr-gds-grp.node-code
      974                 , input buf_fbr-gds-grp.upper-code
      975                 , input buf_fbr-gds-grp.node-name
      976                 , input buf_fbr-gds-grp.out-code
      977                 , output buf_fbr-gds-grp.node-name
      978                 , output buf_fbr-gds-grp.out-code
      979                 , output p-cancel
      980             ).
      981             if p-cancel = yes
      982             then do:
      983                 delete buf_fbr-gds-grp.
      984                 undo, return.
      985             end.
      986           end.
      987           else do:
      988             find first bf_fbr-gds-grp no-lock
      989                 where bf_fbr-gds-grp.obj-type   = p-obj-type
      990                   and bf_fbr-gds-grp.obj-code   = p-obj-code
      991                   and bf_fbr-gds-grp.out-code   = p-out-code
      992             no-error.
      993             assign
      994             buf_fbr-gds-grp.node-name    = p-node-name
      995             buf_fbr-gds-grp.global-code  = p-global-code
      996             buf_fbr-gds-grp.out-code     = (if available bf_fbr-gds-grp then 0 else p-out-code)
      997             .
      998           end.
      999           if v-have-goods = yes
     1000           then do:
     1001               for each buf_fbr-gds-obj exclusive-lock
     1002                  where buf_fbr-gds-obj.obj-type      = p-obj-type
     1003                    and buf_fbr-gds-obj.obj-code      = p-obj-code
     1004                    and buf_fbr-gds-obj.fbr-grp-code  = p-node-code
     1005               on error undo, return error
     1006               :
     1007                   assign
     1008                       buf_fbr-gds-obj.fbr-grp-code = p-new-node-code
     1009                   .
     1010               end.
     1011           end.
     1012       end.
     1013   end.
     1014   end procedure.
     1015   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1016   procedure cur-time :
     1017      define output parameter p-today as date      no-undo .
     1018      define output parameter p-time  as integer   no-undo .
     1019     do
     1020     on error undo, return error
     1021     :
     1022       define variable v-date1 as date      no-undo .
     1023       define variable v-date2 as date      no-undo .
     1024       define variable v-time  as integer   no-undo .
     1025       assign
     1026         v-date1 = today
     1027         v-time  = time
     1028         v-date2 = today
     1029       .
     1030       if v-date1 <> v-date2
     1031       then do:
     1032         assign
     1033           v-date1 = today
     1034           v-time  = v-time
     1035         .
     1036       end.
     1037       assign
     1038         p-today = v-date1
     1039         p-time  = v-time
     1040       .
     1041     end.
     1042   end.
     1043   function cur-time-date returns character
     1044   :
     1045     return string(today, '99/99/9999':U) .
     1046   end.
     1047   function cur-time-mjd returns decimal
     1048   :
     1049     define variable v-date as date      no-undo .
     1050     define variable v-time as integer   no-undo .
     1051     run cur-time in this-procedure
     1052       (output v-date
     1053       ,output v-time
     1054       ) .
     1055     return integer(v-date) - 2400002 + (v-time / 86400) .
     1056   end.
     1057   function cur-time-get-ending-index returns integer
     1058   (input p-number as integer
     1059   )
     1060   :
     1061     if p-number < 0
     1062     or p-number = ?
     1063     then do:
     1064       return 1 .
     1065     end.
     1066     define variable v-rest as integer   no-undo .
     1067     assign
     1068       p-number = p-number modulo 100
     1069     .
     1070     if p-number < 20
     1071     then do:
     1072       assign
     1073         v-rest = p-number
     1074       .
     1075     end.
     1076     else do:
     1077       assign
     1078         v-rest = p-number modulo 10
     1079       .
     1080     end.
     1081     case v-rest :
     1082       when 1
     1083       then do:
     1084         return 2 .
     1085       end.
     1086       when 2 or
     1087       when 3 or
     1088       when 4
     1089       then do:
     1090         return 3 .
     1091       end.
     1092       otherwise do:
     1093         return 1 .
     1094       end.
     1095     end case .
     1096   end.
     1097   procedure cur-time-mjd-to-date :
     1098      define input  parameter i-mjd-diff as decimal no-undo.
     1099      define output parameter o-Date     as date    no-undo.
     1100      define output parameter o-Time     as integer no-undo.
     1101      define variable v-day-number as integer   no-undo .
     1102      if    i-mjd-diff < 0
     1103         or i-mjd-diff = ?
     1104      then do:
     1105         return "?" .
     1106      end.
     1107      assign
     1108         v-day-number = truncate(i-mjd-diff,0).
     1109         o-Date = date(v-day-number + 2400002).
     1110         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1111     .
     1112   end.
     1113   function cur-time-mjd-to-string returns character
     1114   (input p-mjd-diff as decimal
     1115   )
     1116   :
     1117     define variable v-day-number as integer   no-undo .
     1118     define variable v-seconds    as integer   no-undo .
     1119     define variable v-hour       as integer   no-undo .
     1120     define variable v-min        as integer   no-undo .
     1121     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1122     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1123     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1124     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1125     if p-mjd-diff < 0
     1126     or p-mjd-diff = ?
     1127     then do:
     1128       return "?" .
     1129     end.
     1130     assign
     1131       v-day-number = integer(truncate(p-mjd-diff,0))
     1132       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1133     .
     1134     if v-seconds > 86400
     1135     then do:
     1136       assign
     1137         v-seconds = 86400 - 1
     1138       .
     1139     end.
     1140     if v-seconds < 0
     1141     then do:
     1142       assign
     1143         v-seconds = 0
     1144       .
     1145     end.
     1146     assign
     1147       v-hour = truncate(v-seconds / 3600, 0)
     1148     .
     1149     assign
     1150       v-seconds = v-seconds modulo 3600
     1151     .
     1152     assign
     1153       v-min = truncate(v-seconds / 60, 0)
     1154     .
     1155     assign
     1156       v-seconds = v-seconds modulo 60
     1157     .
     1158     return
     1159         (if v-day-number <> 0
     1160           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1161           else ""
     1162         )
     1163       + (if v-day-number <> 0 or v-hour <> 0
     1164           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1165           else ""
     1166         )
     1167       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1168           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1169           else ""
     1170         )
     1171       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1172       .
     1173   end.
     1174   function cur-time-string returns character
     1175   :
     1176     define variable v-date as date      no-undo .
     1177     define variable v-time as integer   no-undo .
     1178     run cur-time in this-procedure
     1179       (output v-date
     1180       ,output v-time
     1181       ) .
     1182     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1183   end.
     1184   function cur-time-string-sec returns character
     1185   :
     1186     define variable v-date as date      no-undo .
     1187     define variable v-time as integer   no-undo .
     1188     run cur-time in this-procedure
     1189       (output v-date
     1190       ,output v-time
     1191       ) .
     1192     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1193   end.
     1194   function cur-time-custom  returns character
     1195   (input p-prefix as character
     1196   ,input p-date-format as character
     1197   ,input p-delimiter as character
     1198   ,input p-time-format as character
     1199   ,input p-suffix as character
     1200   )
     1201   :
     1202     define variable v-date as date      no-undo .
     1203     define variable v-time as integer   no-undo .
     1204     run cur-time in this-procedure
     1205       (output v-date
     1206       ,output v-time
     1207       ) .
     1208     return
     1209       p-prefix
     1210       + string(v-date, p-date-format)
     1211       + p-delimiter
     1212       + string(v-time, p-time-format)
     1213       + p-suffix
     1214       .
     1215   end.
     1216   function cur-time-print  returns character
     1217   :
     1218     define variable v-date as date      no-undo .
     1219     define variable v-time as integer   no-undo .
     1220     run cur-time in this-procedure
     1221       (output v-date
     1222       ,output v-time
     1223       ) .
     1224     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1225   end.
     1226   function cur-time-datetime returns datetime
     1227   :
     1228     define variable v-char as character no-undo .
     1229     define variable v-datetime as datetime no-undo .
     1230     v-char = cur-time-string().
     1231     v-datetime = datetime(v-char).
     1232     return  v-datetime.
     1233   end.
     1234   function cur-time-string-msec returns character
     1235   :
     1236     define variable v-date as datetime  no-undo .
     1237     v-date = now.
     1238     return string(v-date) .
     1239   end.
     1240   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1241   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
     1242   define new shared variable RepPathName        as character no-undo .
     1243   define new shared variable PrintRubl          as logical   no-undo .
     1244   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1245   define  stream PrnLibStream.
     1246   procedure prn-lib-prn-file :
     1247     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1248     define input parameter p-DIsabledoptions as integer no-undo .
     1249     define variable v-report-name as character no-undo .
     1250     define variable v-user-action as character no-undo .
     1251     define variable v-printed     as logical   no-undo .
     1252     define variable v-exist       as logical   no-undo .
     1253     do
     1254       on error undo, return error
     1255       :
     1256       run prn-lib-get-report-name  in this-procedure (
     1257         input parParentProc
     1258         ,output v-report-name
     1259         ).
     1260   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1261   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1262     (input  v-report-name
     1263     ,input  2
     1264     ,output v-exist
     1265     )  .
     1266       if NOT v-exist then
     1267       DO:
     1268         Message
     1269           "Нет заданий на печать ! "
     1270           view-as alert-box .
     1271         Return  .
     1272       End.
     1273       run gbl/prnfilen.w
     1274         (input  ""
     1275         ,input  p-DisabledOptions
     1276         ,input  string(v-report-name )
     1277         ,input  7
     1278         ,output v-user-action
     1279         ,output v-printed
     1280         ) .
     1281       if v-printed then
     1282       do:
     1283         return "YES" .
     1284       end.
     1285       else
     1286       do:
     1287         return "NO" .
     1288       end.
     1289     end.
     1290   end procedure.
     1291   procedure prn-lib-open-stream :
     1292     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1293     define input parameter p-page-size    as integer no-undo .
     1294     define input parameter p-is-stream    as logical no-undo .
     1295     define input parameter p-append       as logical no-undo .
     1296     define variable v-report-name as character no-undo .
     1297     do
     1298       on error undo, return error
     1299       :
     1300       run prn-lib-get-report-name  in this-procedure (
     1301         input parParentProc
     1302         ,output v-report-name
     1303         ).
     1304       if p-is-stream then
     1305       do:
     1306         if p-append then
     1307         do:
     1308           output stream PrnLibStream to value( v-report-name )
     1309             page-size value(p-page-size) append .
     1310         end.
     1311         if not p-append then
     1312         do:
     1313           output stream PrnLibStream to value( v-report-name )
     1314             page-size value(p-page-size) .
     1315         end.
     1316       end.
     1317       if not p-is-stream then
     1318       do:
     1319         if p-append then
     1320         do:
     1321           output to value( v-report-name )
     1322             page-size value(p-page-size) append .
     1323         end.
     1324         if not p-append then
     1325         do:
     1326           output to value( v-report-name )
     1327             page-size value(p-page-size) .
     1328         end.
     1329       end.
     1330     end.
     1331   end procedure.
     1332   procedure prn-lib-open-exp :
     1333     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1334     define input parameter p-is-stream    as logical no-undo .
     1335     define input parameter p-is-append    as logical no-undo .
     1336     define output parameter p-ReportFileName as char init "report" no-undo.
     1337     define output parameter p-process as logical no-undo .
     1338     define variable glog as logical no-undo .
     1339     do
     1340       on error undo, return error
     1341       :
     1342       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1343         TITLE      "Укажите путь"
     1344         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1345         ASK-OVERWRITE
     1346         CREATE-TEST-FILE
     1347         SAVE-AS
     1348         USE-FILENAME
     1349         DEFAULT-EXTENSION "txt"
     1350         UPDATE glog
     1351         .
     1352       if not glog then  return.
     1353       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1354       if p-is-stream then
     1355       do:
     1356         if p-is-append then
     1357         do:
     1358           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1359         end.
     1360         else
     1361         do:
     1362           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1363         end.
     1364       end.
     1365       else
     1366       do:
     1367         if p-is-append then
     1368         do:
     1369           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1370         end.
     1371         else
     1372         do:
     1373           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1374         end.
     1375       end.
     1376       p-process = yes.
     1377     end.
     1378   end procedure.
     1379   procedure prn-lib-get-report-name :
     1380     define input parameter parParentProc  as widget-handle no-undo.
     1381     define output parameter p-report-name as character no-undo .
     1382     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1383   end procedure.
     1384   procedure prn-lib-reportviewer-report-name :
     1385     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1386     define input parameter p-report-name-html as character no-undo .
     1387     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1388   end procedure.
     1389   procedure prn-lib-reportviewer :
     1390     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1391     define input parameter p-report-name-html as character no-undo .
     1392     define input parameter p-param        as character no-undo .
     1393     define variable v-excel           as character no-undo init 'TRUE' .
     1394     define variable v-value-character as character no-undo .
     1395     define variable v-value-integer   as character no-undo .
     1396     define variable v-value-date      as date      no-undo .
     1397     define variable v-value-decimal   as decimal   no-undo .
     1398     define variable rep-excel         as logical   no-undo .
     1399     define variable excel-string      as character no-undo .
     1400     define variable v-param-type      as character no-undo .
     1401     define variable v-tth             as handle    no-undo .
     1402     run adm/shattri.p (
     1403       input "get":U
     1404       ,input  ""
     1405       ,input  0
     1406       ,input  'report-glob':U
     1407       ,input  'rep-excel':U
     1408       ,output v-value-character
     1409       ,output v-value-date
     1410       ,output v-value-decimal
     1411       ,output v-value-integer
     1412       ,output rep-excel
     1413       ,output v-param-type
     1414       ,INPUT-OUTPUT table-handle v-tth
     1415       )  .
     1416     if rep-excel then v-excel = "TRUE" .
     1417     else v-excel = "FALSE" .
     1418     if p-param eq ""
     1419     then
     1420        p-param = "EXCEL:" + v-excel.
     1421     else
     1422        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1423     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1424   end procedure.
     1425   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1426   define variable v-waitfram-action01         as character   no-undo .
     1427   define variable v-waitfram-action02         as character   no-undo .
     1428   define variable v-waitfram-action03         as character   no-undo .
     1429   define variable mWaitFramTextBeg            as character   no-undo.
     1430   define variable mWaitFramTextEnd            as character   no-undo.
     1431   define variable mWaitFramView               as logical     no-undo.
     1432   define variable mWaitProcEvent              as logical     no-undo init yes.
     1433   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1434   define variable mWaitFramStop               as logical     no-undo.
     1435   define variable mWaitFramStopUser           as logical     no-undo.
     1436   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1437   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1438   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1439   define button B-WaitFramStop auto-end-key
     1440        label "Стоп"
     1441        size 10 by 1 tooltip "Остоновить процесс".
     1442   define button B-viewProcInfo
     1443        label "Информация"
     1444        size 15 by 1 tooltip "Информация о процесс".
     1445   define frame waitfram
     1446     v-waitfram-action01 format "x(72)" no-label skip
     1447     v-waitfram-action02 format "x(72)" no-label skip
     1448     v-waitfram-action03 format "x(72)" no-label skip
     1449     B-viewProcInfo
     1450     B-WaitFramStop at row 4 col 30
     1451     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1452     .
     1453   define new global shared variable mBatchMode as logical no-undo init ?.
     1454   define variable mFramBachModHandle as handle no-undo.
     1455   mFramBachModHandle = frame waitfram:handle.
     1456   define variable mFameOldVis as logical no-undo.
     1457   define variable mVisCUrentVin as logical no-undo.
     1458   if session:batch-mode
     1459   then
     1460      mBatchMode = yes.
     1461   if mBatchMode = ? then do:
     1462     mVisCUrentVin = current-window:visible.
     1463     mFameOldVis = mFramBachModHandle:visible.
     1464     mFramBachModHandle:visible  = yes.
     1465     mBatchMode = mFramBachModHandle:visible ne yes.
     1466     mFramBachModHandle:visible = mFameOldVis.
     1467     current-window:visible = mVisCUrentVin.
     1468   end.
     1469    if  log-manager:logfile-name ne ?
     1470     then DO:
     1471         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1472         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1473         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1474     end.
     1475   on choose of B-WaitFramStop in frame waitfram
     1476   do:
     1477     mWaitFramStop = yes.
     1478     mWaitFramStopUser = yes.
     1479   end.
     1480   function waitfram-check-timeout returns logical():
     1481      define variable vtime as int64 no-undo.
     1482      if mWaitFramStopTimeOut
     1483      then
     1484         return yes.
     1485      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1486      if     mWaitFramTimeOut ne ?
     1487         and mWaitFramTimeOut ne 0
     1488         and mWaitFramTimeOut lt vtime
     1489      then do:
     1490         mWaitFramStopTimeOut = yes.
     1491      end.
     1492      return mWaitFramStopTimeOut.
     1493   end.
     1494   procedure waitfram-hide :
     1495     if not session:batch-mode
     1496     then do
     1497     on error undo, return error return-value
     1498     :
     1499       pause 0 before-hide .
     1500       if not mBatchMode then
     1501         hide frame waitfram .
     1502     if     not mWaitFramView
     1503        and mWaitProcEvent
     1504     then
     1505       process events .
     1506     end.
     1507   end procedure.
     1508   procedure waitfram-show :
     1509     define input  parameter p-message as character no-undo .
     1510     define variable v-left-margin as integer   no-undo .
     1511     if not session:batch-mode
     1512     then do
     1513     on error undo, return error return-value
     1514     :
     1515       if length(p-message) <= 70 then do:
     1516         assign
     1517           v-left-margin = integer((70 - length(p-message)) / 2)
     1518         .
     1519         assign
     1520           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1521         .
     1522         assign
     1523           v-waitfram-action01 = " "
     1524           v-waitfram-action02 = " "
     1525                                    + fill(" ", v-left-margin)
     1526                                    + p-message
     1527           v-waitfram-action03 = " "
     1528         .
     1529       end.
     1530       else do:
     1531         define variable vRindex1 as integer no-undo.
     1532         define variable vRindex2 as integer no-undo.
     1533         vRindex1 = r-index(p-message," ",70).
     1534         if vRindex1 = 0
     1535         then
     1536            vRindex1 = 70.
     1537         if length(p-message)  <= vRindex1 + 70 then do:
     1538           assign
     1539             v-waitfram-action01 = " "
     1540             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1541             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1542           .
     1543         end.
     1544         else do:
     1545           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1546           if vRindex2 <= vRindex1
     1547           then
     1548              vRindex2 = vRindex1 + 70.
     1549           assign
     1550             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1551             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1552             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1553           .
     1554         end.
     1555       end.
     1556       B-viewProcInfo:visible   in frame waitfram = no.
     1557       B-viewProcInfo:sensitive in frame waitfram = no.
     1558       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1559       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1560       if  (   mWaitFramView
     1561          or  mWaitProcEvent)
     1562          and not mBatchMode
     1563       then
     1564          display
     1565             v-waitfram-action01 skip
     1566             v-waitfram-action02 skip
     1567             v-waitfram-action03 skip
     1568          with frame waitfram .
     1569       if     mWaitFramView
     1570          then do:
     1571             if     mWaitFramInterval ne ?
     1572                and not mBatchMode
     1573             then
     1574                wait-for go of frame waitfram pause mWaitFramInterval.
     1575          end.
     1576          else
     1577             if     mWaitProcEvent
     1578                and not mBatchMode
     1579             then
     1580                process events .
     1581     end.
     1582   end procedure.
     1583      procedure waitfram-show-this:
     1584         define input  parameter iInterval as int64 no-undo.
     1585         define variable vtime as int64 no-undo.
     1586         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1587         mWaitFramInterval = iInterval.
     1588         run waitfram-show (substitute("&1&2 &3&4" ,
     1589                                       mWaitFramTextBeg ,
     1590                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1591                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1592                                       mWaitFramTextEnd
     1593                                      )
     1594                           ).
     1595      end.
     1596      procedure WaitFramRunPause:
     1597         define input  parameter iInterval as dec no-undo.
     1598         define variable vStart  as datetime-tz no-undo.
     1599         define variable vend    as datetime-tz no-undo.
     1600         define variable vint as int64 no-undo.
     1601         define variable vOk as logical no-undo.
     1602         vStart = now.
     1603         vend   = vStart.
     1604         publish "WaitFramPause" (iInterval,output vOk).
     1605         vend   =  now.
     1606         vint = vend - vStart.
     1607         vint = iInterval - vint / 1000.
     1608         if     not mWaitFramStop
     1609            and (   vint > 0
     1610                 or (    not vOk
     1611                     and iInterval eq ?
     1612                     )
     1613                 )
     1614         then
     1615            run waitfram-show-this (iInterval).
     1616         vend   =  now.
     1617         vint = vend - vStart.
     1618         vint = iInterval - vint / 1000.
     1619         if     not mWaitFramStop
     1620            and vint > 0
     1621         then do:
     1622            run gbl/pause.p (vint * 1000).
     1623         end.
     1624         if iInterval ne ?
     1625         then
     1626            publish "WaitFramStop".
     1627         waitfram-check-timeout().
     1628      end.
     1629      procedure WaitFramWaitFor:
     1630         define input  parameter iInterval as dec no-undo.
     1631         assign
     1632            mWaitFramStartProc   = now
     1633            mWaitFramStopUser    = no
     1634            mWaitFramStopTimeOut = no
     1635         .
     1636         block-wait:
     1637         do while not mWaitFramStop:
     1638            run WaitFramRunPause (iInterval).
     1639            if  waitfram-check-timeout()
     1640            then do:
     1641               leave block-wait.
     1642            end.
     1643         end.
     1644         run waitfram-hide.
     1645      end.
     1646   procedure waitfram-join :
     1647     define input  parameter p-line-1  as character no-undo .
     1648     define input  parameter p-line-2  as character no-undo .
     1649     define input  parameter p-line-3  as character no-undo .
     1650     define output parameter p-message as character no-undo .
     1651     do
     1652     on error undo, return error return-value
     1653     :
     1654       assign
     1655         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1656                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1657                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1658       .
     1659     end.
     1660   end procedure.
     1661   function waitfram-join-function returns character
     1662     (input p-line-1 as character
     1663     ,input p-line-2 as character
     1664     ,input p-line-3 as character
     1665     ).
     1666     define variable v-message as character no-undo .
     1667     run waitfram-join in this-procedure
     1668       (input  p-line-1
     1669       ,input  p-line-2
     1670       ,input  p-line-3
     1671       ,output v-message
     1672       ) .
     1673     return v-message .
     1674   end function .
     1675   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
