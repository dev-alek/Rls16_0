     1770               when 'chkdocfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Чек - доп поля"     p-tooltip = "Чек - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1771               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1772                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1773               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1774         otherwise do:
     1775           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
     1776         end.
     1777       end CASE.
     1778     end.
     1779   end procedure.
     1780   procedure uf-get :
     1781     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1782     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1783     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1784     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1785     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1786     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1787     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1788     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1789     do
     1790     on error undo, return error
     1791     :
     1792       define buffer buf_usr-flt for ubflt.usr-flt .
     1793       define variable v-use-List_     as logical   no-undo .
     1794       define variable v-type-List_     as character no-undo .
     1795       define variable v-format-List_   as character no-undo .
     1796       define variable v-use-Naim      as logical   no-undo .
     1797       define variable v-type-Naim      as character no-undo .
     1798       define variable v-format-Naim    as character no-undo .
     1799       define variable v-use-print-graft as logical   no-undo .
     1800       define variable v-use-sort-gr     as logical   no-undo .
     1801       define variable v-use-type-price  as logical   no-undo .
     1802       define variable v-use-type-val    as logical   no-undo .
     1803       define variable v-label          as character no-undo .
     1804       define variable v-tooltip        as character no-undo .
     1805       define variable v-user-can-edit  as logical   no-undo .
     1806       define variable v-output-display as logical   no-undo .
     1807       define variable v-other          as character no-undo .
     1808       run uf-name in this-procedure
     1809          (input  entry(1, p-code, chr(4))
     1810         ,output v-use-List_
     1811         ,output v-type-List_
     1812         ,output v-format-List_
     1813         ,output v-use-Naim
     1814         ,output v-type-Naim
     1815         ,output v-format-Naim
     1816         ,output v-use-print-graft
     1817         ,output v-use-sort-gr
     1818         ,output v-use-type-price
     1819         ,output v-use-type-val
     1820         ,output v-label
     1821         ,output v-tooltip
     1822         ,output v-user-can-edit
     1823         ,output v-output-display
     1824         ,output v-other
     1825         ) no-error .
     1826       if error-status :error then do:
     1827         undo, return error return-value .
     1828       end.
     1829       find first buf_usr-flt no-lock where
     1830                  buf_usr-flt.Call-point     = p-code AND
     1831                  buf_usr-flt.user-name       = p-user-name
     1832         no-error .
     1833       if avail buf_usr-flt then do:
     1834         assign
     1835         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1836         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1837         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1838         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1839         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1840         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1841         .
     1842       end.
     1843       else do:
     1844         assign
     1845         p-List_        = (if v-use-List_       then "":U                    else ?)
     1846         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1847         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1848         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1849         p-type-price   = (if v-use-type-price  then no                      else ?)
     1850         p-type-val     = (if v-use-List_       then no                      else ?)
     1851         .
     1852       end.
     1853     end.
     1854   end procedure.
     1855   procedure uf-set :
     1856     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1857     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1858     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1859     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1860     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1861     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1862     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1863     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1864     do
     1865     on error undo, return error
     1866     :
     1867       define buffer buf_usr-flt for ubflt.usr-flt .
     1868       define variable v-use-List_     as logical   no-undo .
     1869       define variable v-type-List_     as character no-undo .
     1870       define variable v-format-List_   as character no-undo .
     1871       define variable v-use-Naim      as logical   no-undo .
     1872       define variable v-type-Naim      as character no-undo .
     1873       define variable v-format-Naim    as character no-undo .
     1874       define variable v-use-print-graft as logical   no-undo .
     1875       define variable v-use-sort-gr   as logical   no-undo .
     1876       define variable v-use-type-price as logical   no-undo .
     1877       define variable v-use-type-val  as logical   no-undo .
     1878       define variable v-tooltip        as character no-undo .
     1879       define variable v-label          as character no-undo .
     1880       define variable v-user-can-edit  as logical   no-undo .
     1881       define variable v-output-display as logical   no-undo .
     1882       define variable v-other          as character no-undo .
     1883       run uf-name in this-procedure
     1884         (input  entry(1, p-code, chr(4))
     1885         ,output v-use-List_
     1886         ,output v-type-List_
     1887         ,output v-format-List_
     1888         ,output v-use-Naim
     1889         ,output v-type-Naim
     1890         ,output v-format-Naim
     1891         ,output v-use-print-graft
     1892         ,output v-use-sort-gr
     1893         ,output v-use-type-price
     1894         ,output v-use-type-val
     1895         ,output v-label
     1896         ,output v-tooltip
     1897         ,output v-user-can-edit
     1898         ,output v-output-display
     1899         ,output v-other
     1900         ) no-error .
     1901       if error-status :error then do:
     1902         undo, return error return-value .
     1903       end.
     1904       find first buf_usr-flt where
     1905                  buf_usr-flt.Call-point     = p-code AND
     1906                  buf_usr-flt.user-name       = p-user-name
     1907         no-error .
     1908       if not avail buf_usr-flt then do:
     1909           create buf_usr-flt .
     1910           assign
     1911           buf_usr-flt.call-point = p-code
     1912           buf_usr-flt.user-name  = p-user-name
     1913           .
     1914       end.
     1915       if avail buf_usr-flt then do:
     1916        assign
     1917        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1918        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1919        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1920        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1921        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1922        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1923       .
     1924       release buf_usr-flt.
     1925       end.
     1926       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1927     end.
     1928   end procedure.
     1929   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1930   function chkleave returns logical
     1931   (input p-widget-enter as handle
     1932   ,input p-button-list  as character
     1933   ).
     1934     if  valid-handle(p-widget-enter)
     1935     and can-query(p-widget-enter, "name":u)
     1936     and lookup(p-widget-enter :name, p-button-list) > 0
     1937     then do:
     1938       return false .
     1939     end.
     1940     return true .
     1941   end function.
     1942   procedure proc-alt-shift-f2:
     1943     if not ibs.th.gbl.gbl-var:rcode
     1944   then
     1945     run gbl\inidebug.p .
     1946   end.
     1947   procedure proc-alt-shift-f3:
     1948     run gbl/prvssinf.p
     1949       ( input this-procedure
     1950       ) .
     1951   end.
     1952   define variable v-inform-launched as logical no-undo initial false .
     1953   procedure proc-alt-shift-f4:
     1954     define variable v-action as character no-undo .
     1955     if v-inform-launched = false then do:
     1956       assign
     1957         v-inform-launched = true
     1958       .
     1959       run gbl/d-inform.w
     1960         (  input self
     1961         ,  input this-procedure
     1962         , output v-action
     1963         ) no-error .
     1964       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1965       assign
     1966         v-inform-launched = false
     1967       .
     1968     end.
     1969   end.
     1970   procedure proc-alt-f1:
     1971     run gbl/corrhelp.p
     1972       (input this-procedure
     1973       ) .
     1974   end .
     1975   on alt-shift-f2 anywhere do:
     1976     run proc-alt-shift-f2.
     1977   end.
     1978   on alt-shift-f3 anywhere do:
     1979     run proc-alt-shift-f3 in this-procedure .
     1980   end.
     1981   on alt-shift-f4 anywhere do:
     1982     run proc-alt-shift-f4 in this-procedure.
     1983   end.
     1984   on alt-f1 anywhere do:
     1985     run proc-alt-f1 in this-procedure .
     1986   end.
