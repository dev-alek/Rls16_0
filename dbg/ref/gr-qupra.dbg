        1   define input  parameter parparentproc as handle no-undo .
        2   define input  parameter p-mode as character no-undo .
        3   define input-output parameter p-recid as recid no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Добавление новой количественной группы".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116     define variable v-cntxt-db-num        as integer   no-undo .
      117     define variable v-cntxt-userid        as character no-undo .
      118     define variable v-cntxt-level         as character no-undo .
      119     define variable v-cntxt-host-code-obj as integer   no-undo .
      120     define variable v-cntxt-obj-type      as character no-undo .
      121     define variable v-cntxt-obj-code      as integer   no-undo .
      122     define variable v-cntxt-db-num-obj    as integer   no-undo .
      123     define variable v-cntxt-is-admin      as logical   no-undo .
      124   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125     run mainmenu_getcntxt in parparentproc
      126       (output v-cntxt-db-num
      127       ,output v-cntxt-userid
      128       ,output v-cntxt-level
      129       ,output v-cntxt-host-code-obj
      130       ,output v-cntxt-obj-type
      131       ,output v-cntxt-obj-code
      132       ,output v-cntxt-db-num-obj
      133       ,output v-cntxt-is-admin
      134       ) .
      135   DEFINE BUTTON B-Cancel AUTO-END-KEY
      136        LABEL "Отмена"
      137        SIZE 10 BY 1
      138        BGCOLOR 8 .
      139   DEFINE BUTTON B-Help
      140        LABEL "Помо&щь"
      141        SIZE 10 BY 1
      142        BGCOLOR 8 .
      143   DEFINE BUTTON B-save AUTO-GO
      144        LABEL "Ввод"
      145        SIZE 10 BY 1
      146        BGCOLOR 8 .
      147   DEFINE VARIABLE v-name LIKE ub.qnty-group.name
      148        LABEL "Название количественной группы"
      149        VIEW-AS FILL-IN
      150        SIZE 50.5 BY 1 NO-UNDO.
      151   DEFINE FRAME Dialog-Frame
      152        B-save AT ROW 1 COL 1
      153        B-Cancel AT ROW 1 COL 11
      154        B-Help AT ROW 1 COL 77
      155        v-name AT ROW 3.5 COL 36 COLON-ALIGNED HELP
      156             ""
      157             LABEL "Название количественной группы" FORMAT "X(80)"
      158        SPACE(2.99) SKIP(2.49)
      159       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      160            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      161            TITLE "Добавление количественной группы для ценообразования"
      162            DEFAULT-BUTTON B-save CANCEL-BUTTON B-Cancel.
      163   ASSIGN
      164          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      165          FRAME Dialog-Frame:HIDDEN           = TRUE.
      166   ON GO OF FRAME Dialog-Frame
      167   DO:
      168     RUN save-proc.
      169   END.
      170   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      171   DO:
      172     APPLY "END-ERROR":U TO SELF.
      173   END.
      174   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      175   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      176   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      177   on help of frame Dialog-Frame
      178   do:
      179     run gbl/app_help.p
      180       (input this-procedure :file-name
      181       ,input ''
      182       ,input ?
      183       ) no-error.
      184     if error-status :error then do:
      185       message
      186         "Ошибка при вызове помощи"
      187         error-status :get-message(1)
      188         view-as alert-box .
      189     end.
      190   end.
      191   run minbtn-set in this-procedure .
      192   on choose of b-help in frame Dialog-Frame
      193   do:
      194     apply "help":u to frame Dialog-Frame .
      195   end.
      196   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      197   procedure minbtn-set :
      198       do
      199           on error undo, return error return-value
      200           :
      201           define variable ii              as integer       no-undo .
      202           define variable fh              as widget-handle no-undo .
      203           define variable hh              as widget-handle no-undo .
      204           define variable v-h             as handle        extent 4 no-undo .
      205           define variable v-name-button   as character     no-undo .
      206           define variable v-help-old-x    as decimal       no-undo .
      207           define variable v-help-old-y    as decimal       no-undo .
      208           define variable v-help-old-size as decimal       no-undo .
      209           define variable v-frame-width   as decimal       no-undo .
      210           define variable jj              as integer       no-undo .
      211           do
      212               on error undo, return error
      213               :
      214               assign
      215                   v-frame-width = frame Dialog-Frame:width - 0.3
      216                   fh            = frame Dialog-Frame:first-child
      217                   hh            = fh:first-child
      218                   ii            = 1
      219                   .
      220               do while valid-handle(hh):
      221                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      222                   do:
      223                       case lc(hh:name) :
      224                           when "b-help" then
      225                               do:
      226                                   hh:load-image-up("cmp/b-help.bmp":u) .
      227                                   hh:load-image-down("cmp/b-help.bmp":u) .
      228                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      229                                   hh:TOOLTIP = "Помощь" .
      230                                   v-help-old-x = hh:column .
      231                                   v-help-old-y = hh:row    .
      232                                   v-help-old-size = hh:width .
      233                                   hh:width-chars = 2.5 .
      234                               end.
      235                           when "b-print" then
      236                               do:
      237                                   hh:load-image("cmp/b-print.bmp":u) .
      238                                   hh:TOOLTIP = "Печать" .
      239                                   v-h[ii] = hh:handle .
      240                                   ii = ii + 1 .
      241                                   hh:width-chars = 3 .
      242                               end.
      243                           when "b-history" or
      244                           when "b-hist" then
      245                               do:
      246                                   hh:load-image("cmp/b-hist.bmp":u) .
      247                                   hh:TOOLTIP = "История" .
      248                                   v-h[ii] = hh:handle .
      249                                   ii = ii + 1 .
      250                                   hh:width-chars = 3 .
      251                               end.
      252                           when "b-sch" then
      253                               do:
      254                                   hh:load-image("cmp/b-sch.bmp":u) .
      255                                   hh:TOOLTIP = "Установка Фильтра" .
      256                                   v-h[ii] = hh:handle .
      257                                   ii = ii + 1 .
      258                                   hh:width-chars = 3 .
      259                               end.
      260                           when "b-hist-user" then
      261                               do:
      262                                   hh:load-image("cmp/b-hist.bmp":u) .
      263                                   hh:TOOLTIP = "История пользователя" .
      264                                   ii = ii + 1 .
      265                               end.
      266                       end case.
      267                   end.
      268                   hh = hh:next-sibling.
      269               end.
      270               b-help:column = v-frame-width - b-help:width-chars.
      271               jj = 0.
      272               repeat ii = 4 to 1 by -1 :
      273                   if valid-handle (v-h[ii] ) then
      274                   do:
      275                       jj  = jj + 1 .
      276                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      277                       v-h[ii]:row    = v-help-old-y .
      278                   end.
      279               end.
      280           end.
      281       end.
      282   end procedure.
      283   MAIN-BLOCK:
      284   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      285      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      286     RUN init-proc in this-procedure .
      287     RUN enable_UI in this-procedure .
      288     WAIT-FOR GO OF FRAME Dialog-Frame FOCUS v-name.
      289   END.
      290   RUN disable_UI.
      291   PROCEDURE disable_UI :
      292     HIDE FRAME Dialog-Frame.
      293   END PROCEDURE.
      294   PROCEDURE enable_UI :
      295     DISPLAY v-name
      296         WITH FRAME Dialog-Frame.
      297     ENABLE B-Cancel B-save B-Help v-name
      298         WITH FRAME Dialog-Frame.
      299     VIEW FRAME Dialog-Frame.
      300   END PROCEDURE.
      301   PROCEDURE save-proc :
      302   ASSIGN frame Dialog-Frame
      303           v-name
      304           .
      305   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      306   create ub.qnty-group.
      307   assign
      308     ub.qnty-group.qgr-db-num   = v-cntxt-db-num
      309     ub.qnty-group.qgr-id       = next-value ( s-qgr , ub )
      310     ub.qnty-group.db-num-chg   = v-cntxt-db-num
      311     ub.qnty-group.stts         = 0
      312     ub.qnty-group.sys-date     = today
      313     ub.qnty-group.sys-time     = time
      314     ub.qnty-group.sys-time-chr = string(ub.qnty-group.sys-time,"hh:mm")
      315     ub.qnty-group.who          = v-cntxt-userid
      316     ub.qnty-group.name       = v-name
      317   .
      318   end.
      319   else do:
      320   assign
      321     ub.qnty-group.db-num-chg   = v-cntxt-db-num
      322     ub.qnty-group.sys-date     = today
      323     ub.qnty-group.sys-time     = time
      324     ub.qnty-group.sys-time-chr = string(ub.qnty-group.sys-time,"hh:mm")
      325     ub.qnty-group.who          = v-cntxt-userid
      326     ub.qnty-group.name       = v-name
      327   .
      328   end.
      329     p-recid = recid(ub.qnty-group).
      330   END PROCEDURE.
      331   PROCEDURE init-proc :
      332   if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      333       find first  ub.qnty-group exclusive-lock where recid(ub.qnty-group) = p-recid no-error .
      334       if error-status :error then do:
      335           message
      336             vss-workfile vss-revision vss-description skip
      337             error-status :get-message(1) skip
      338             return-value skip
      339             ""
      340             view-as alert-box error
      341           .
      342           return .
      343       end.
      344       assign
      345         v-name     =     ub.qnty-group.name
      346         .
      347       display v-name
      348           with frame Dialog-Frame .
      349     end.
      350   END PROCEDURE.
