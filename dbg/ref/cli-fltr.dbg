        1    define  temp-table temp-list-buyer no-undo ~
        2   field obj-type as character ~
        3   field obj-code as integer   ~
        4   index pi is primary unique  ~
        5   obj-type ~
        6   obj-code.
        7   define input parameter ParParentProc as handle NO-UNDO.
        8   DEFINE input-output parameter IOP-SupGds  AS LOGICAL NO-UNDO.
        9   DEFINE input-output parameter IOP-SupCons AS LOGICAL NO-UNDO.
       10   DEFINE input-output parameter IOP-SupServ AS LOGICAL NO-UNDO.
       11   DEFINE input-output parameter IOP-BuyGds  AS LOGICAL NO-UNDO.
       12   DEFINE input-output parameter IOP-BuyCons AS LOGICAL NO-UNDO.
       13   DEFINE input-output parameter IOP-BuyServ AS LOGICAL NO-UNDO.
       14   DEFINE input-output parameter IOP-WLim-kr AS LOGICAL NO-UNDO.
       15   DEFINE input-output parameter IOP-GRP     AS LOGICAL NO-UNDO.
       16   DEFINE input-output parameter IOP-TURN    AS LOGICAL NO-UNDO.
       17   DEFINE input-output parameter p-sum-1     as character no-undo .
       18   DEFINE input-output parameter p-sum-2     as character no-undo .
       19   DEFINE input-output parameter p-gr-name   as character no-undo .
       20   define input-output parameter p-grp-buyer-id     as integer   no-undo .
       21   define input-output parameter p-grp-buyer-db-num as integer   no-undo .
       22   define input-output parameter table for temp-list-buyer .
       23   define variable vss-revision    as character no-undo init "$Revision$":U .
       24   define variable vss-author      as character no-undo init "$Author$":U .
       25   define variable vss-date        as character no-undo init "$Date$":U .
       26   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       27   define variable vss-archive     as character no-undo init "$Archive$":U .
       28   define variable vss-description as character no-undo init "Задание условий выборки клиентов".
       29   procedure vss-get-info :
       30     define output parameter p-vss-revision    like vss-revision    no-undo .
       31     define output parameter p-vss-author      like vss-author      no-undo .
       32     define output parameter p-vss-date        like vss-date        no-undo .
       33     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       34     define output parameter p-vss-archive     like vss-archive     no-undo .
       35     define output parameter p-vss-description like vss-description no-undo .
       36     assign
       37       p-vss-revision    = vss-revision
       38       p-vss-author      = vss-author
       39       p-vss-date        = vss-date
       40       p-vss-workfile    = vss-workfile
       41       p-vss-archive     = vss-archive
       42       p-vss-description = vss-description
       43     .
       44   end procedure.
       45   procedure vss-get-parameters :
       46     define output parameter p-vss-parameters as character no-undo .
       47   end procedure.
       48   define new global shared variable g#vssrevis-logger as handle    no-undo .
       49   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       50   define variable v-vssrevis-logger                   as handle    no-undo .
       51   procedure vss-logevent :
       52     define input  parameter p-extra-paramters as character no-undo .
       53     define variable v-vssrevis-parameters as character no-undo .
       54     do
       55     on error undo, return error return-value
       56     :
       57       if  valid-handle(v-vssrevis-logger)
       58       and v-vssrevis-logger :get-signature("logevent") <> ""
       59       then do:
       60         run vss-get-parameters in this-procedure
       61           (output v-vssrevis-parameters
       62           ).
       63         run logevent in v-vssrevis-logger
       64           (input vss-workfile
       65           ,input vss-revision
       66           ,input v-vssrevis-parameters
       67           ,input p-extra-paramters
       68           ).
       69       end.
       70     end.
       71   end procedure.
       72   assign
       73     v-vssrevis-logger = g#vssrevis-logger
       74   .
       75   if  valid-handle(v-vssrevis-logger)
       76   and v-vssrevis-logger :get-signature("logevent") <> ""
       77   then do:
       78     assign
       79       v-vssrevis-logevent = true
       80     .
       81     run vss-logevent in this-procedure (input vss-description) .
       82   end.
       83   define new global shared variable g#language as character no-undo .
       84   if g#language <> '' and g#language <> 'rus':U then do:
       85     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       86   end.
       87   procedure proc-alt-shift-f2:
       88     if not ibs.th.gbl.gbl-var:rcode
       89   then
       90     run gbl\inidebug.p .
       91   end.
       92   procedure proc-alt-shift-f3:
       93     run gbl/prvssinf.p
       94       ( input this-procedure
       95       ) .
       96   end.
       97   define variable v-inform-launched as logical no-undo initial false .
       98   procedure proc-alt-shift-f4:
       99     define variable v-action as character no-undo .
      100     if v-inform-launched = false then do:
      101       assign
      102         v-inform-launched = true
      103       .
      104       run gbl/d-inform.w
      105         (  input self
      106         ,  input this-procedure
      107         , output v-action
      108         ) no-error .
      109       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      110       assign
      111         v-inform-launched = false
      112       .
      113     end.
      114   end.
      115   procedure proc-alt-f1:
      116     run gbl/corrhelp.p
      117       (input this-procedure
      118       ) .
      119   end .
      120   on alt-shift-f2 anywhere do:
      121     run proc-alt-shift-f2.
      122   end.
      123   on alt-shift-f3 anywhere do:
      124     run proc-alt-shift-f3 in this-procedure .
      125   end.
      126   on alt-shift-f4 anywhere do:
      127     run proc-alt-shift-f4 in this-procedure.
      128   end.
      129   on alt-f1 anywhere do:
      130     run proc-alt-f1 in this-procedure .
      131   end.
      132   define variable log-res            as logical no-undo .
      133   DEFINE BUTTON b-help
      134        LABEL "&Помощь":L
      135        SIZE 3 BY 1
      136        BGCOLOR 8 .
      137   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      138        LABEL "&Отмена":L
      139        SIZE 10 BY 1
      140        BGCOLOR 8 .
      141   DEFINE BUTTON Btn_OK AUTO-GO
      142        LABEL "&Ввод ":L
      143        SIZE 10 BY 1
      144        BGCOLOR 8 .
      145   DEFINE VARIABLE v-grp-buyer AS CHARACTER FORMAT "X(256)":U
      146         VIEW-AS TEXT
      147        SIZE 39 BY .67
      148        FGCOLOR 1  NO-UNDO.
      149   DEFINE VARIABLE v-sum-1 AS CHARACTER FORMAT "X(256)":U
      150         VIEW-AS TEXT
      151        SIZE 17.5 BY .67
      152        FGCOLOR 1  NO-UNDO.
      153   DEFINE VARIABLE v-sum-2 AS CHARACTER FORMAT "X(256)":U
      154         VIEW-AS TEXT
      155        SIZE 21.5 BY .67
      156        FGCOLOR 1  NO-UNDO.
      157   DEFINE RECTANGLE RECT-21
      158        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      159        SIZE 70 BY 5.5.
      160   DEFINE RECTANGLE RECT-23
      161        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      162        SIZE 70 BY 2.77.
      163   DEFINE RECTANGLE RECT-9
      164        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      165        SIZE 70 BY 2.7
      166        BGCOLOR 8 FGCOLOR 0 .
      167   DEFINE VARIABLE BuyCons AS LOGICAL INITIAL yes
      168        LABEL "Товары - на консигнацию"
      169        VIEW-AS TOGGLE-BOX
      170        SIZE 26.5 BY 1 NO-UNDO.
      171   DEFINE VARIABLE BuyGds AS LOGICAL INITIAL yes
      172        LABEL "Товары - выкуп"
      173        VIEW-AS TOGGLE-BOX
      174        SIZE 17.9 BY 1 NO-UNDO.
      175   DEFINE VARIABLE BuyServ AS LOGICAL INITIAL yes
      176        LABEL "Услуги"
      177        VIEW-AS TOGGLE-BOX
      178        SIZE 10 BY 1
      179        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
      180   DEFINE VARIABLE SupCons AS LOGICAL INITIAL yes
      181        LABEL "Товары - на консигнацию"
      182        VIEW-AS TOGGLE-BOX
      183        SIZE 24.5 BY .8 NO-UNDO.
      184   DEFINE VARIABLE SupGds AS LOGICAL INITIAL yes
      185        LABEL "Товары - выкуп"
      186        VIEW-AS TOGGLE-BOX
      187        SIZE 16.5 BY .8 NO-UNDO.
      188   DEFINE VARIABLE SupServ AS LOGICAL INITIAL yes
      189        LABEL "Услуги"
      190        VIEW-AS TOGGLE-BOX
      191        SIZE 9.6 BY .8 NO-UNDO.
      192   DEFINE VARIABLE T-grp AS LOGICAL INITIAL no
      193        LABEL "По группе покупателей"
      194        VIEW-AS TOGGLE-BOX
      195        SIZE 25 BY .67 NO-UNDO.
      196   DEFINE VARIABLE T-oborot AS LOGICAL INITIAL no
      197        LABEL "По обороту покупателя"
      198        VIEW-AS TOGGLE-BOX
      199        SIZE 25 BY .67 NO-UNDO.
      200   DEFINE VARIABLE WLim-kr AS LOGICAL INITIAL no
      201        LABEL "Ненулевой лимит кредита"
      202        VIEW-AS TOGGLE-BOX
      203        SIZE 26.5 BY 1
      204        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
      205   DEFINE FRAME DLGOKCAN
      206        Btn_OK AT ROW 1 COL 1
      207        Btn_Cancel AT ROW 1 COL 11
      208        b-help AT ROW 1 COL 61
      209        SupGds AT ROW 4.7 COL 4.8
      210        SupCons AT ROW 4.7 COL 22.5
      211        SupServ AT ROW 4.7 COL 49.3
      212        BuyGds AT ROW 7.77 COL 5
      213        BuyCons AT ROW 8.93 COL 5
      214        BuyServ AT ROW 10.07 COL 5
      215        WLim-kr AT ROW 10.07 COL 35.8
      216        T-oborot AT ROW 13 COL 5
      217        T-grp AT ROW 14.27 COL 5
      218        v-sum-1 AT ROW 13 COL 28.5 COLON-ALIGNED NO-LABEL
      219        v-sum-2 AT ROW 13 COL 47 COLON-ALIGNED NO-LABEL
      220        v-grp-buyer AT ROW 14.27 COL 29 COLON-ALIGNED NO-LABEL
      221        "Поставщики :" VIEW-AS TEXT
      222             SIZE 12.8 BY 1 AT ROW 3.77 COL 27.4
      223             BGCOLOR 8 FGCOLOR 4
      224        "Условия объединяются по ~"Или~"" VIEW-AS TEXT
      225             SIZE 32.3 BY 1 AT ROW 2.27 COL 20.4
      226             FGCOLOR 1
      227        "Покупатели :" VIEW-AS TEXT
      228             SIZE 13.5 BY 1 AT ROW 6.27 COL 27.4
      229             BGCOLOR 8 FGCOLOR 4
      230        "Условия объединяются по ~"И~"" VIEW-AS TEXT
      231             SIZE 30 BY .67 AT ROW 11.77 COL 21.9
      232             FGCOLOR 1
      233        RECT-9 AT ROW 3.27 COL 1
      234        RECT-21 AT ROW 6 COL 1
      235        RECT-23 AT ROW 12.77 COL 1
      236        SPACE(0.74) SKIP(3.16)
      237       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      238            SIDE-LABELS THREE-D  SCROLLABLE
      239            BGCOLOR 8 FGCOLOR 0
      240            TITLE BGCOLOR 8 FGCOLOR 1 "Фильтры":L
      241            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.
      242   ASSIGN
      243          FRAME DLGOKCAN:SCROLLABLE       = FALSE
      244          FRAME DLGOKCAN:PRIVATE-DATA     =
      245                   "DLGCLOSE".
      246   ASSIGN
      247          SupServ:HIDDEN IN FRAME DLGOKCAN           = TRUE.
      248   ON CHOOSE OF Btn_Cancel IN FRAME DLGOKCAN
      249   DO:
      250       return "NO" .
      251   END.
      252   ON CHOOSE OF Btn_OK IN FRAME DLGOKCAN
      253   DO:
      254       if IOP-WLim-kr <> ? then
      255           do:
      256               assign WLim-kr .
      257               IOP-WLim-kr = WLim-kr .
      258           end.
      259       if IOP-SupGds <> ? then
      260           do:
      261               assign SupGds .
      262               IOP-SupGds = SupGds .
      263           end.
      264       if IOP-SupCons <> ? then
      265           do:
      266               assign SupCons .
      267               IOP-SupCons = SupCons .
      268           end.
      269       if IOP-BuyGds <> ? then
      270           do:
      271               assign BuyGds .
      272               IOP-BuyGds = BuyGds .
      273           end.
      274       if IOP-BuyCons <> ? then
      275           do:
      276               assign BuyCons .
      277               IOP-BuyCons = BuyCons .
      278           end.
      279       if IOP-BuyServ <> ? then
      280           do:
      281               assign BuyServ .
      282               IOP-BuyServ = BuyServ .
      283           end.
      284       assign
      285         frame DLGOKCAN t-grp  T-oborot
      286         IOP-GRP   =  t-grp
      287         IOP-TURN  =  T-oborot
      288         p-sum-1   =  v-sum-1
      289         p-sum-2   =  v-sum-2
      290         p-gr-name =  v-grp-buyer
      291       .
      292       Run remake-tt.
      293       return "OK" .
      294   END.
      295   ON VALUE-CHANGED OF BuyCons IN FRAME DLGOKCAN
      296   DO:
      297       assign BuyCons .
      298   END.
      299   ON VALUE-CHANGED OF BuyGds IN FRAME DLGOKCAN
      300   DO:
      301       assign BuyGds .
      302   END.
      303   ON VALUE-CHANGED OF BuyServ IN FRAME DLGOKCAN
      304   DO:
      305       assign BuyServ .
      306   END.
      307   ON VALUE-CHANGED OF SupCons IN FRAME DLGOKCAN
      308   DO:
      309       assign SupCons .
      310   END.
      311   ON VALUE-CHANGED OF SupGds IN FRAME DLGOKCAN
      312   DO:
      313       assign SupGds .
      314   END.
      315   ON VALUE-CHANGED OF SupServ IN FRAME DLGOKCAN
      316   DO:
      317       assign SupServ .
      318   END.
      319   ON VALUE-CHANGED OF T-grp IN FRAME DLGOKCAN
      320   DO:
      321   define variable p-recids as character no-undo .
      322   define buffer buf_buyer-group for ub.buyer-group  .
      323   p-grp-buyer-id     = ? .
      324   p-grp-buyer-db-num = ? .
      325     ASSIGN t-grp .
      326     v-grp-buyer = "" .
      327     if t-grp = true then do:
      328         run ref/gr-bupr.w ( ParParentProc, "b-sel" , input-output p-recids ) .
      329         find first buf_buyer-group no-lock where recid (buf_buyer-group) = integer(p-recids) no-error .
      330         if error-status :error then do:
      331           t-grp = false .
      332           DISPLAY v-grp-buyer t-grp with FRAME DLGOKCAN.
      333           return no-apply.
      334         end.
      335         v-grp-buyer        = buf_buyer-group.name .
      336         p-grp-buyer-id     = buf_buyer-group.bgr-id .
      337         p-grp-buyer-db-num = buf_buyer-group.bgr-db-num .
      338     end.
      339     DISPLAY v-grp-buyer  t-grp  with FRAME DLGOKCAN.
      340   END.
      341   ON VALUE-CHANGED OF T-oborot IN FRAME DLGOKCAN
      342   DO:
      343   define variable vs-sum-1 as decimal   no-undo .
      344   define variable vs-sum-2 as decimal   no-undo .
      345     ASSIGN t-oborot.
      346     v-sum-1 = "" .
      347     v-sum-2 = "" .
      348     IF t-oborot = false  THEN do:
      349        for each temp-list-buyer : delete temp-list-buyer. end.
      350     end.
      351     IF t-oborot = true  THEN
      352     run str/two-sum.w (
      353         input ('sums-calc'),
      354         input-OUTPUT vs-sum-1 ,
      355         input-OUTPUT vs-sum-2,
      356         OUTPUT TABLE temp-list-buyer ).
      357   IF t-oborot THEN do:
      358      v-sum-1 = "c " + string( vs-sum-1 ) .
      359   if vs-sum-2 <> ? then  v-sum-2 = "по " + string( vs-sum-2 ) .
      360                     else v-sum-2 = " ..."  .
      361   end.
      362   else do:
      363     v-sum-1 = "" .
      364     v-sum-2 = "" .
      365   end.
      366   DISPLAY  v-sum-1
      367           v-sum-2 with FRAME DLGOKCAN.
      368   END.
      369   ON VALUE-CHANGED OF WLim-kr IN FRAME DLGOKCAN
      370   DO:
      371       assign    WLim-kr .
      372   END.
      373   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DLGOKCAN:PARENT eq ?
      374   THEN FRAME DLGOKCAN:PARENT = ACTIVE-WINDOW.
      375   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   on help of frame DLGOKCAN
      377   do:
      378     run gbl/app_help.p
      379       (input this-procedure :file-name
      380       ,input ''
      381       ,input ?
      382       ) no-error.
      383     if error-status :error then do:
      384       message
      385         "Ошибка при вызове помощи"
      386         error-status :get-message(1)
      387         view-as alert-box .
      388     end.
      389   end.
      390   run minbtn-set in this-procedure .
      391   on choose of b-help in frame DLGOKCAN
      392   do:
      393     apply "help":u to frame DLGOKCAN .
      394   end.
      395   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      396   procedure minbtn-set :
      397       do
      398           on error undo, return error return-value
      399           :
      400           define variable ii              as integer       no-undo .
      401           define variable fh              as widget-handle no-undo .
      402           define variable hh              as widget-handle no-undo .
      403           define variable v-h             as handle        extent 4 no-undo .
      404           define variable v-name-button   as character     no-undo .
      405           define variable v-help-old-x    as decimal       no-undo .
      406           define variable v-help-old-y    as decimal       no-undo .
      407           define variable v-help-old-size as decimal       no-undo .
      408           define variable v-frame-width   as decimal       no-undo .
      409           define variable jj              as integer       no-undo .
      410           do
      411               on error undo, return error
      412               :
      413               assign
      414                   v-frame-width = frame DLGOKCAN:width - 0.3
      415                   fh            = frame DLGOKCAN:first-child
      416                   hh            = fh:first-child
      417                   ii            = 1
      418                   .
      419               do while valid-handle(hh):
      420                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      421                   do:
      422                       case lc(hh:name) :
      423                           when "b-help" then
      424                               do:
      425                                   hh:load-image-up("cmp/b-help.bmp":u) .
      426                                   hh:load-image-down("cmp/b-help.bmp":u) .
      427                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      428                                   hh:TOOLTIP = "Помощь" .
      429                                   v-help-old-x = hh:column .
      430                                   v-help-old-y = hh:row    .
      431                                   v-help-old-size = hh:width .
      432                                   hh:width-chars = 2.5 .
      433                               end.
      434                           when "b-print" then
      435                               do:
      436                                   hh:load-image("cmp/b-print.bmp":u) .
      437                                   hh:TOOLTIP = "Печать" .
      438                                   v-h[ii] = hh:handle .
      439                                   ii = ii + 1 .
      440                                   hh:width-chars = 3 .
      441                               end.
      442                           when "b-history" or
      443                           when "b-hist" then
      444                               do:
      445                                   hh:load-image("cmp/b-hist.bmp":u) .
      446                                   hh:TOOLTIP = "История" .
      447                                   v-h[ii] = hh:handle .
      448                                   ii = ii + 1 .
      449                                   hh:width-chars = 3 .
      450                               end.
      451                           when "b-sch" then
      452                               do:
      453                                   hh:load-image("cmp/b-sch.bmp":u) .
      454                                   hh:TOOLTIP = "Установка Фильтра" .
      455                                   v-h[ii] = hh:handle .
      456                                   ii = ii + 1 .
      457                                   hh:width-chars = 3 .
      458                               end.
      459                           when "b-hist-user" then
      460                               do:
      461                                   hh:load-image("cmp/b-hist.bmp":u) .
      462                                   hh:TOOLTIP = "История пользователя" .
      463                                   ii = ii + 1 .
      464                               end.
      465                       end case.
      466                   end.
      467                   hh = hh:next-sibling.
      468               end.
      469               b-help:column = v-frame-width - b-help:width-chars.
      470               jj = 0.
      471               repeat ii = 4 to 1 by -1 :
      472                   if valid-handle (v-h[ii] ) then
      473                   do:
      474                       jj  = jj + 1 .
      475                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      476                       v-h[ii]:row    = v-help-old-y .
      477                   end.
      478               end.
      479           end.
      480       end.
      481   end procedure.
      482   ON WINDOW-CLOSE OF FRAME DLGOKCAN APPLY "END-ERROR":U TO SELF.
      483       assign
      484           SupGds = IOP-SupGds
      485           SupCons = ( if IOP-SupCons <> ? then IOP-SupCons else FALSE )
      486           SupServ = ( if IOP-SupServ <> ? then IOP-SupServ else FALSE )
      487           BuyGds = IOP-BuyGds
      488           BuyCons = ( if IOP-BuyCons <> ? then IOP-BuyCons else FALSE )
      489           BuyServ = ( if IOP-BuyServ <> ? then IOP-BuyServ else FALSE )
      490           WLim-kr = ( if IOP-WLim-kr <> ? then IOP-WLim-kr else FALSE )
      491           T-grp   = ( if IOP-GRP <> ? then IOP-GRP else FALSE )
      492           T-oborot   = ( if  IOP-TURN  <> ? then  IOP-TURN  else FALSE )
      493           .
      494   if T-oborot = true then do:
      495                     assign
      496                       v-sum-1 =  p-sum-1
      497                       v-sum-2 =  p-sum-2
      498                     .
      499       display v-sum-1  v-sum-2  with frame DLGOKCAN .
      500   end.
      501   if T-grp = true then do:
      502                     assign
      503                       v-grp-buyer =  p-gr-name
      504                     .
      505       display v-grp-buyer  with frame DLGOKCAN .
      506   end.
      507   MAIN-BLOCK:
      508   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      509      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      510       RUN enable_UI.
      511       WAIT-FOR GO OF FRAME DLGOKCAN.
      512   END.
      513   RUN disable_UI.
      514   PROCEDURE disable_UI :
      515     HIDE FRAME DLGOKCAN.
      516   END PROCEDURE.
      517   PROCEDURE enable_UI :
      518     DISPLAY SupGds SupCons BuyGds BuyCons BuyServ WLim-kr T-oborot T-grp
      519             v-sum-1 v-sum-2 v-grp-buyer
      520         WITH FRAME DLGOKCAN.
      521     ENABLE Btn_OK RECT-9 RECT-21 Btn_Cancel b-help SupGds SupCons BuyGds
      522            BuyCons BuyServ WLim-kr T-oborot T-grp v-sum-1 v-sum-2 v-grp-buyer
      523         WITH FRAME DLGOKCAN.
      524   END PROCEDURE.
      525   PROCEDURE remake-tt :
      526   define buffer buf_buyer-in-buyer-group for ub.buyer-in-buyer-group  .
      527   if iop-turn = true and iop-grp = true then do:
      528       for each temp-list-buyer :
      529           find first buf_buyer-in-buyer-group no-lock where
      530                     buf_buyer-in-buyer-group.stts       = 0      and
      531                     buf_buyer-in-buyer-group.bbg-obj-type = temp-list-buyer.obj-type and
      532                     buf_buyer-in-buyer-group.bbg-obj-code = temp-list-buyer.obj-code and
      533                     buf_buyer-in-buyer-group.bgr-id       = p-grp-buyer-id      and
      534                     buf_buyer-in-buyer-group.bgr-db-num   = p-grp-buyer-db-num
      535                     no-error .
      536           if not available buf_buyer-in-buyer-group then delete temp-list-buyer .
      537       end.
      538   end.
      539   if iop-turn = false and iop-grp = true then do:
      540       for each temp-list-buyer : delete temp-list-buyer. end.
      541       for each  buf_buyer-in-buyer-group no-lock where
      542                 buf_buyer-in-buyer-group.stts       = 0      and
      543                 buf_buyer-in-buyer-group.bgr-id     = p-grp-buyer-id      and
      544                 buf_buyer-in-buyer-group.bgr-db-num = p-grp-buyer-db-num  :
      545           create temp-list-buyer .
      546             assign
      547               temp-list-buyer.obj-type = buf_buyer-in-buyer-group.bbg-obj-type
      548               temp-list-buyer.obj-code = buf_buyer-in-buyer-group.bbg-obj-code
      549             .
      550       end.
      551   end.
      552   END PROCEDURE.
