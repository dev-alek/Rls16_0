     3105   PROCEDURE MyEnable :
     3106     assign
     3107     br-gds-hist:num-locked-columns in frame Dialog-Frame = 1
     3108     X_c-gds-hist.corr-date:read-only in browse br-gds-hist = yes
     3109     br-changes:title = "":U
