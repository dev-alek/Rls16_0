      819     define variable v-value-integer   as character no-undo .
      820     define variable v-value-date      as date      no-undo .
      821     define variable v-value-decimal   as decimal   no-undo .
      822     define variable rep-excel         as logical   no-undo .
      823     define variable excel-string      as character no-undo .
      824     define variable v-param-type      as character no-undo .
      825     define variable v-tth             as handle    no-undo .
      826     run adm/shattri.p (
      827       input "get":U
      828       ,input  ""
      829       ,input  0
      830       ,input  'report-glob':U
      831       ,input  'rep-excel':U
      832       ,output v-value-character
