     3136   PROCEDURE OpenBr :
     3137   define input  parameter p-open-query     as logical   no-undo .
     3138   define input  parameter p-find-next      as logical   no-undo .
     3139   define input  parameter p-find-condition as character no-undo .
     3140   define input  parameter p-db-num like ub.c-gds-hist.corr-user-db-num no-undo .
     3141   define variable l-query-was-opened as logical no-undo .
     3142   define variable title0 as character no-undo.
     3143   title0 = "Список полной истории товара" + chr(32).
     3144   define variable sort-column-phrase as character no-undo .
     3145   run waitfram-show in this-procedure ( input "Ждите" ).
     3146   case sort-column-name :
     3147     when "" then do:
     3148       assign
     3149         sort-column-phrase = ""
     3150       .
     3151     end.
     3152     otherwise do:
     3153       assign
     3154         sort-column-phrase = "by " + sort-column-name
     3155       .
     3156     end.
     3157   end case.
     3158   define variable l-open-query as logical   no-undo .
     3159   CASE p-db-num:
     3160     when ? then do:
     3161       CASE p-mode :
     3162         WHEN "one":u THEN DO:
     3163           assign
     3164           filter-point = filter-point0 + p-mode
     3165           frame Dialog-Frame:TITLE = title0 + substitute(" Бар-код &1 Товар с кодом &2: &3 &4 &5&6",
     3166                                                                             p-b-code, p-gds-code, v-gds-name, v-artic, v-prod-type, v-prod-code )
     3167           filter-label = substitute("&1 Один бар-код", filter-label0)
     3168                                                                             .
     3169   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3170   define variable  l-disable-where-23  as logical   no-undo .
     3171   define variable  l-filter-open-23    as logical   .
     3172   define variable  flt-rec-23       as recid     no-undo .
     3173   define variable  filter-name-23      as character no-undo .
     3174   define variable  where-phrase-23     as character no-undo .
     3175   define variable  sort-phrase-23      as character no-undo .
     3176   define variable  where-phrase-rus-23 as character no-undo .
     3177   define variable  sort-phrase-rus-23  as character no-undo .
     3178     run waitfram-show in this-procedure
     3179       (input "ЖДИТЕ ..."
     3180       ).
     3181   run gbl/flt-get.p
     3182     (input filter-point
     3183     ,output flt-rec-23
     3184     ,output filter-name-23
     3185     ,output where-phrase-23
     3186     ,output sort-phrase-23
     3187     ,output where-phrase-rus-23
     3188     ,output sort-phrase-rus-23
     3189     ).
     3190   if p-open-query then do:
     3191     assign
     3192       l-filter-open-23 = false
     3193     .
     3194     if flt-rec-23 <> ?
     3195       or sort-column-phrase > ""
     3196     then do:
     3197       define variable  parameter-2-23 as character no-undo .
     3198       define variable  parameter-3-23 as character no-undo .
     3199       define variable  parameter-4-23 as character no-undo .
     3200       define variable  parameter-5-23 as character no-undo .
     3201       define variable  parameter-6-23 as character no-undo .
     3202       define variable  parameter-7-23 as character no-undo .
     3203         assign
     3204         parameter-3-23 =
     3205                                 "FOR EACH X_c-bar-code"
     3206         parameter-4-23 =
     3207           (
     3208             if ("  X_c-bar-code.b-code = p-b-code  " + " " + where-phrase-23) <> ""
     3209             then   substitute('X_c-bar-code.b-code = &1', p-b-code )  + " " + where-phrase-23
     3210             else "true"
     3211           )
     3212         parameter-5-23 = (" " + "" + " " + ", first X_c-gds-hist no-lock WHERE X_c-gds-hist.gds-code = X_c-bar-code.gds-code   AND X_c-gds-hist.chip-num = X_c-bar-code.chip-num   AND X_c-gds-hist.corr-user-db-num = X_c-bar-code.corr-user-db-num")
     3213         parameter-6-23 = if sort-phrase-23 = ''
     3214                              then
     3215           (
     3216           " " + "  " +
     3217             " " + sort-column-phrase +
     3218           " " + "  "
     3219           )
     3220                              else
     3221           (
     3222           " " + "  " +
     3223             " " + sort-column-phrase +
     3224           " " + sort-phrase-23
     3225           )
     3226         parameter-7-23 =
     3227           "   "
     3228       .
     3229       do
     3230       on stop undo, leave
     3231       on error undo, leave
