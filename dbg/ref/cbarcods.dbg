      715   procedure prn-lib-open-stream :
      716     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      717     define input parameter p-page-size    as integer no-undo .
      718     define input parameter p-is-stream    as logical no-undo .
      719     define input parameter p-append       as logical no-undo .
      720     define variable v-report-name as character no-undo .
      721     do
      722       on error undo, return error
      723       :
      724       run prn-lib-get-report-name  in this-procedure (
      725         input parParentProc
      726         ,output v-report-name
      727         ).
      728       if p-is-stream then
      729       do:
      730         if p-append then
      731         do:
      732           output stream PrnLibStream to value( v-report-name )
      733             page-size value(p-page-size) append .
      734         end.
      735         if not p-append then
      736         do:
      737           output stream PrnLibStream to value( v-report-name )
      738             page-size value(p-page-size) .
      739         end.
      740       end.
      741       if not p-is-stream then
      742       do:
      743         if p-append then
      744         do:
      745           output to value( v-report-name )
      746             page-size value(p-page-size) append .
      747         end.
      748         if not p-append then
      749         do:
      750           output to value( v-report-name )
      751             page-size value(p-page-size) .
      752         end.
      753       end.
      754     end.
      755   end procedure.
      756   procedure prn-lib-open-exp :
      757     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      758     define input parameter p-is-stream    as logical no-undo .
      759     define input parameter p-is-append    as logical no-undo .
      760     define output parameter p-ReportFileName as char init "report" no-undo.
      761     define output parameter p-process as logical no-undo .
      762     define variable glog as logical no-undo .
      763     do
      764       on error undo, return error
      765       :
      766       SYSTEM-DIALOG GET-FILE p-ReportFileName
      767         TITLE      "Укажите путь"
      768         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      769         ASK-OVERWRITE
      770         CREATE-TEST-FILE
      771         SAVE-AS
      772         USE-FILENAME
      773         DEFAULT-EXTENSION "txt"
      774         UPDATE glog
      775         .
      776       if not glog then  return.
      777       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      778       if p-is-stream then
      779       do:
      780         if p-is-append then
      781         do:
      782           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      783         end.
      784         else
      785         do:
      786           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      787         end.
      788       end.
      789       else
      790       do:
      791         if p-is-append then
      792         do:
      793           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      794         end.
      795         else
      796         do:
      797           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      798         end.
      799       end.
      800       p-process = yes.
      801     end.
      802   end procedure.
