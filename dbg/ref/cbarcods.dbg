     3558   PROCEDURE proc-b-print :
     3559   define variable date_string     as      char    no-undo.
     3560   define variable Line                as      char    no-undo.
     3561   define variable for-time as char.
     3562   define variable accum-count as integer.
     3563   define variable v-doc-rec as recid no-undo.
     3564   define variable v-prod as character no-undo .
     3565   define variable v-subject-chr as character no-undo .
     3566   define variable v-upd-time as character no-undo .
     3567   define variable v-obj as character no-undo .
     3568   define variable v-action-chr as character no-undo .
     3569   define variable v-source-type as character no-undo .
     3570   DEFINE VARIABLE v-for-user-name AS CHARACTER NO-UNDO.
     3571   DEFINE FRAME HistoryList
     3572   v-action-chr FORMAT "X(10)" COLUMN-LABEL "Действие"
     3573   v-subject-chr COLUMN-LABEL "Предмет изменений" FORMAT "X(20)"
     3574   X_c-gds-hist.is-news COLUMn-LABEL "СПН" FORMAT "+/ "
     3575   v-source-type COLUMn-LABEL "Источн.!измен"
     3576   X_c-gds-hist.source-ref COLUMn-LABEL "№"
     3577   X_c-gds-hist.corr-date
     3578   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     3579   v-for-user-name COLUMN-LABEL "Изменил" FORMAT "X(18)"
     3580   X_c-gds-hist.corr-user-db-num
     3581   HEADER  date_string AT 5 format "X(35)"
     3582   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     3583   Line format "X(195)" AT 1
     3584   with width 232 down stream-io use-text    .
     3585   Line = fill("-", 195).
     3586   date_string = cur-time-print() .
     3587   assign
     3588   v-doc-rec = recid( X_c-gds-hist ).
     3589   DO WHILE available X_c-gds-hist :
     3590         GET prev br-gds-hist.
     3591   END.
     3592   run prn-lib-open-stream  in this-procedure (
     3593                                                input parparentProc
     3594                                               ,input 43
     3595                                               ,input yes
     3596                                               ,input no
     3597                                               ).
     3598   PUT  STREAM PrnLibStream
     3599   SPACE(25) ( frame Dialog-Frame:title )
     3600   format "x(90)" SKIP(1) .
     3601   FORM HEADER
     3602   Line format "X(180)" AT 1 SKIP
     3603   "Продолжение - на следующей странице" AT 30 SKIP
     3604   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3605   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3606   FORM with FRAME HistoryList  .
     3607   run waitfram-show in this-procedure ( input "Ждите...").
     3608     GET next br-gds-hist.
     3609       DO WHILE available X_c-gds-hist :
     3610         Display STREAM PrnLibStream
     3611         get-action(X_c-gds-hist.action) @ v-action-chr
     3612         get-subject(X_c-gds-hist.subject) @ v-subject-chr
     3613         X_c-gds-hist.is-news
     3614         get-source-type(X_c-gds-hist.source-type) @ v-source-type
     3615         X_c-gds-hist.source-ref
     3616         X_c-gds-hist.corr-date
     3617         string(X_c-gds-hist.corr-time, "HH:MM:SS":U) @ v-upd-time
     3618         usrfulnf(X_c-gds-hist.corr-user-name) @ v-for-user-name
     3619         X_c-gds-hist.corr-user-db-num
     3620         with FRAME HistoryList .
     3621     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     3622     assign
     3623     accum-count = accum-count + 1
     3624     .
     3625     GET next br-gds-hist.
     3626   END.
     3627   UNDERLINE  STREAM PrnLibStream
     3628   v-action-chr
     3629   v-subject-chr
     3630   X_c-gds-hist.is-news
     3631   v-source-type
     3632   X_c-gds-hist.source-ref
     3633   X_c-gds-hist.corr-date
     3634   v-upd-time
     3635   v-for-user-name
     3636   X_c-gds-hist.corr-user-db-num
     3637   with FRAME HistoryList .
     3638   DISPLAY STREAM PrnLibStream
     3639   ("ИТОГО" + chr(32) + string(accum-count))   @ v-action-chr
     3640    with frame HistoryList.
     3641   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3642   HIDE  STREAM PrnLibStream FRAME CheckList.
     3643   output  STREAM PrnLibStream CLOSE.
     3644   run waitfram-hide in this-procedure.
     3645   run prn-lib-prn-file in this-procedure (
     3646                                             input parparentproc
     3647                                             ,input 8
     3648                                             ).
     3649   reposition br-gds-hist to recid v-doc-rec no-error.
     3650   apply "entry" to br-gds-hist in frame Dialog-Frame.
     3651   END PROCEDURE.
     3652   PROCEDURE proc-br-gds-hist :
     3653   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3654   if b-sel:sensitive in frame Dialog-Frame then dO:
     3655       if b-mark:sensitive then do:
     3656           apply "choose" to b-mark in frame Dialog-Frame.
     3657       end.
     3658       else do:
     3659           apply "choose" to b-sel in frame Dialog-Frame.
     3660       end.
     3661   end.
     3662   else do:
     3663       if b-lookup:sensitive then
     3664       apply "choose" to b-lookup in frame Dialog-Frame.
     3665   end.
     3666   END PROCEDURE.
     3667   PROCEDURE proc-view-changes :
     3668   define variable v-description as character no-undo .
     3669   for each temp-changes:
     3670       delete temp-changes.
     3671   END.
     3672   if not available X_c-gds-hist then do:
     3673     Open QUery br-changes for each temp-changes.
     3674     return.
     3675   end.
     3676   run ref/cgdshisv.p (
     3677                      input X_c-gds-hist.gds-code
     3678                     ,input X_c-gds-hist.chip-num
     3679                     ,input X_c-gds-hist.corr-user-db-num
     3680                     ,input X_c-gds-hist.host-code
     3681                     ,input X_c-gds-hist.obj-type
     3682                     ,input X_c-gds-hist.obj-code
     3683                     ,input X_c-gds-hist.subject
     3684                     ,input X_c-gds-hist.action
     3685                     ,input no
     3686                     ,input "":U
     3687                     ,output v-description
     3688                  ) no-error .
     3689   Open QUery br-changes for each temp-changes.
     3690   assign
     3691   br-changes:title in frame Dialog-Frame = v-description
     3692   .
     3693   END PROCEDURE.
     3694   FUNCTION get-action RETURNS CHARACTER
     3695     ( p-action as integer ) :
     3696     define variable dops as character no-undo.
     3697   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     3698   RETURN dops.
     3699   END FUNCTION.
     3700   FUNCTION get-good RETURNS CHARACTER
     3701     ( p-gds-code as integer, output p-artic as character, output p-prod-type as character, output p-prod-code as integer ) :
     3702   define buffer buf_goods for ub.goods.
     3703   find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error.
     3704   if not available buf_goods then do:
     3705       return "!!! Неизвестный товар!!!".
     3706   end.
     3707   assign
     3708   p-artic =  buf_goods.artic
     3709   p-prod-type =  buf_goods.prod-type
     3710   p-prod-code =  buf_goods.prod-code
     3711   .
     3712     RETURN buf_goods.gds-name.
     3713   END FUNCTION.
     3714   FUNCTION get-source-type RETURNS CHARACTER
     3715     ( p-source-type as character ) :
     3716   define variable v-dop as character no-undo .
     3717   assign
     3718   v-dop =  entry (lookup (p-source-type, ',db,esys,trn-doc,payment,fin-doc,import,recalc,wth-doc,ren-gdsc,upgrade,grp-chg,stop-list,dis-card':U), ',БД,ВС,Документ,Платеж,Фин.док.,Импорт,Пересчет,Документ МЦ,Коллизия,Апгрейд,Изм.группы,Стоплист,ДК':U) no-error
     3719   .
     3720     RETURN v-dop .
     3721   END FUNCTION.
     3722   FUNCTION get-subject RETURNS CHARACTER
     3723     ( p-subject as character ) :
     3724     RETURN entry (lookup (p-subject, 'goods,goods-attr,gds-host-attr,gds-obj-attr,fbr-gds-obj,s-coeff,bar-code,bar-code-attr,bar-code-obj-attr,prod-bc,varianty-delivery-gds-obj,gds-season,tax-rate-gds,assortment-matrix-goods,gds-obj-prop,pl-gds,pl-gds-pump,sert-join,pl-gds-attr,dis-gds-rule,ext-artic,ext-classif,recipe,recipe-gds,gds-obj,gds-obj-prop-attr':U), 'Товар,Атр-т товара,Атр-т тов. на фирме,Атр-т тов. на объекте,Атрибут РЕСТОРАНа,Сезонный коэфф,Бар-код,Атрибуты бар-кодов,Атрибуты бар-кода на объекте,ДопБК,Варианты доставки,Сезон товара,Ставки налогов,Содержимое ассортиментных матр,Индикаторы,Товар на складском месте,Товар на ТРК,Сертификат на товар,АттрТовара на скл.месте,Скидка Товара на объ.,Внешний артикул товара,Внешний классификатор,Рецепт,Товар рецепта,Товар на объекте,Атр-т тов. для заказов':U).
     3725   END FUNCTION.
