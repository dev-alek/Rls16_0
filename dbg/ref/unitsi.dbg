        1   DEFINE BUFFER locked_units FOR ub.units.
        2   DEFINE TEMP-TABLE tt-units NO-UNDO LIKE ub.units.
        3   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        4   define input parameter p-mode as character no-undo.
        5   define input parameter p-unit-name like ub.units.unit-name no-undo.
        6   define input-output parameter p-rid as recid init ? no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "карточка единицы измерения".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118   define variable v-db-num like ub.db.db-num no-undo .
      119   DEFINE BUTTON B-exit AUTO-GO
      120        LABEL "&Ввод"
      121        SIZE 10 BY 1
      122        BGCOLOR 8 .
      123   DEFINE BUTTON B-Help
      124        LABEL "Помо&щь"
      125        SIZE 10 BY 1
      126        BGCOLOR 8 .
      127   DEFINE BUTTON B-hist
      128        LABEL "Ис&тория"
      129        SIZE 10 BY 1.
      130   DEFINE BUTTON b-quit AUTO-END-KEY
      131        LABEL "&Отмена"
      132        SIZE 10 BY 1
      133        BGCOLOR 8 .
      134   DEFINE VARIABLE UnitType AS CHARACTER FORMAT "X(256)":U
      135        LABEL "Тип"
      136        VIEW-AS COMBO-BOX INNER-LINES 1
      137        DROP-DOWN-LIST
      138        SIZE 25.75 BY 1 NO-UNDO.
      139   DEFINE VARIABLE UnitType-2 AS CHARACTER FORMAT "X(256)":U
      140        LABEL "Тип2"
      141        VIEW-AS COMBO-BOX INNER-LINES 1
      142        DROP-DOWN-LIST
      143        SIZE 25.75 BY 1 NO-UNDO.
      144   DEFINE QUERY Dialog-Frame FOR
      145         tt-units SCROLLING.
      146   DEFINE FRAME Dialog-Frame
      147        B-exit AT ROW 1 COL 1
      148        b-quit AT ROW 1 COL 11
      149        B-hist AT ROW 1 COL 41
      150        B-Help AT ROW 1 COL 54.88
      151        tt-units.long-name AT ROW 2.42 COL 20 COLON-ALIGNED
      152             LABEL "Полное наименование"
      153             VIEW-AS FILL-IN
      154             SIZE 41 BY 1
      155        tt-units.unit-name AT ROW 3.75 COL 20 COLON-ALIGNED
      156             LABEL "Аббревиатура"
      157             VIEW-AS FILL-IN
      158             SIZE 8 BY 1
      159        UnitType AT ROW 3.75 COL 35.25 COLON-ALIGNED
      160        tt-units.OKEI AT ROW 5.33 COL 20 COLON-ALIGNED
      161             LABEL "ОКЕИ" format "9999"
      162             VIEW-AS FILL-IN
      163             SIZE 5.5 BY 1
      164        UnitType-2 AT ROW 5.33 COL 35.25 COLON-ALIGNED
      165        SPACE(6.12) SKIP(1.17)
      166       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      167            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      168            TITLE "Единица измерения"
      169            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      170   ASSIGN
      171          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      172          FRAME Dialog-Frame:HIDDEN           = TRUE.
      173   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      174   DO:
      175     APPLY "END-ERROR":U TO SELF.
      176   END.
      177   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      178   DO:
      179     run proc-save in this-procedure no-error.
      180     if error-status:error then return no-apply.
      181   END.
      182   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
      183   DO:
      184     DEFINE VARIABLE v-rid-list AS CHARACTER NO-undo.
      185         run ref/c-units.w (
      186                        INPUT parparentproc
      187                       ,INPUT '':U
      188                       ,INPUT 'one':U
      189                       ,INPUT tt-units.unit-name
      190                       ,INPUT-OUTPUT v-rid-list) NO-ERROR.
      191   END.
      192   ON VALUE-CHANGED OF UnitType IN FRAME Dialog-Frame
      193   DO:
      194       RUn RereadUnittype2(UnitType:screen-value).
      195   END.
      196   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      197   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      198   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      199   on help of frame Dialog-Frame
      200   do:
      201     run gbl/app_help.p
      202       (input this-procedure :file-name
      203       ,input ''
      204       ,input ?
      205       ) no-error.
      206     if error-status :error then do:
      207       message
      208         "Ошибка при вызове помощи"
      209         error-status :get-message(1)
      210         view-as alert-box .
      211     end.
      212   end.
      213   run minbtn-set in this-procedure .
      214   on choose of b-help in frame Dialog-Frame
      215   do:
      216     apply "help":u to frame Dialog-Frame .
      217   end.
      218   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      219   procedure minbtn-set :
      220       do
      221           on error undo, return error return-value
      222           :
      223           define variable ii              as integer       no-undo .
      224           define variable fh              as widget-handle no-undo .
      225           define variable hh              as widget-handle no-undo .
      226           define variable v-h             as handle        extent 4 no-undo .
      227           define variable v-name-button   as character     no-undo .
      228           define variable v-help-old-x    as decimal       no-undo .
      229           define variable v-help-old-y    as decimal       no-undo .
      230           define variable v-help-old-size as decimal       no-undo .
      231           define variable v-frame-width   as decimal       no-undo .
      232           define variable jj              as integer       no-undo .
      233           do
      234               on error undo, return error
      235               :
      236               assign
      237                   v-frame-width = frame Dialog-Frame:width - 0.3
      238                   fh            = frame Dialog-Frame:first-child
      239                   hh            = fh:first-child
      240                   ii            = 1
      241                   .
      242               do while valid-handle(hh):
      243                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      244                   do:
      245                       case lc(hh:name) :
      246                           when "b-help" then
      247                               do:
      248                                   hh:load-image-up("cmp/b-help.bmp":u) .
      249                                   hh:load-image-down("cmp/b-help.bmp":u) .
      250                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      251                                   hh:TOOLTIP = "Помощь" .
      252                                   v-help-old-x = hh:column .
      253                                   v-help-old-y = hh:row    .
      254                                   v-help-old-size = hh:width .
      255                                   hh:width-chars = 2.5 .
      256                               end.
      257                           when "b-print" then
      258                               do:
      259                                   hh:load-image("cmp/b-print.bmp":u) .
      260                                   hh:TOOLTIP = "Печать" .
      261                                   v-h[ii] = hh:handle .
      262                                   ii = ii + 1 .
      263                                   hh:width-chars = 3 .
      264                               end.
      265                           when "b-history" or
      266                           when "b-hist" then
      267                               do:
      268                                   hh:load-image("cmp/b-hist.bmp":u) .
      269                                   hh:TOOLTIP = "История" .
      270                                   v-h[ii] = hh:handle .
      271                                   ii = ii + 1 .
      272                                   hh:width-chars = 3 .
      273                               end.
      274                           when "b-sch" then
      275                               do:
      276                                   hh:load-image("cmp/b-sch.bmp":u) .
      277                                   hh:TOOLTIP = "Установка Фильтра" .
      278                                   v-h[ii] = hh:handle .
      279                                   ii = ii + 1 .
      280                                   hh:width-chars = 3 .
      281                               end.
      282                           when "b-hist-user" then
      283                               do:
      284                                   hh:load-image("cmp/b-hist.bmp":u) .
      285                                   hh:TOOLTIP = "История пользователя" .
      286                                   ii = ii + 1 .
      287                               end.
      288                       end case.
      289                   end.
      290                   hh = hh:next-sibling.
      291               end.
      292               b-help:column = v-frame-width - b-help:width-chars.
      293               jj = 0.
      294               repeat ii = 4 to 1 by -1 :
      295                   if valid-handle (v-h[ii] ) then
      296                   do:
      297                       jj  = jj + 1 .
      298                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      299                       v-h[ii]:row    = v-help-old-y .
      300                   end.
      301               end.
      302           end.
      303       end.
      304   end procedure.
      305   MAIN-BLOCK:
      306   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      307      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      308    if p-mode  <> 'ДОБАВЛЕНИЕ':U
      309    and p-mode <> 'ИЗМЕНЕНИЕ':U
      310    and p-mode <> 'ПРОСМОТР':U
      311    then do:
      312       message
      313       vss-workfile vss-revision vss-description skip
      314       "Неверное значение параметров вызова p-mode"  p-mode
      315       view-as alert-box ERROR.
      316       undo, return error.
      317    end.
      318   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      319   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      320     (output v-db-num
      321     )  .
      322    if p-mode <> 'ПРОСМОТР':U then do:
      323       if v-db-num <> 0
      324       then do:
      325         message
      326         vss-workfile vss-revision vss-description skip
      327         "Неверное значение параметров вызова p-mode - нельзя изменять/добавлять записи ЕД.ИЗМ в УБД"
      328         view-as alert-box ERROR.
      329         undo, return error.
      330       end.
      331     end.
      332     for each tt-units:
      333           delete tt-units.
      334       end.
      335     if p-mode = 'ИЗМЕНЕНИЕ':U
      336     or p-mode = 'ПРОСМОТР':U then do:
      337       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      338         find first locked_units EXclusive-lock where
      339                      recid(locked_units) = p-rid no-wait no-error.
      340         if locked locked_units then do:
      341           message
      342           vss-workfile vss-revision vss-description skip
      343            "Запись ЕД.ИЗМ. занята"
      344           view-as alert-box error .
      345           undo, return error.
      346         end.
      347       end.
      348       else do:
      349         find first locked_units no-lock where
      350                          recid(locked_units) = p-rid no-error .
      351         if not avail locked_units then do:
      352           find first locked_units where
      353                     locKed_units.unit-name = p-unit-name no-error .
      354         end.
      355       end.
      356       if not available locked_units then do:
      357         message
      358         vss-workfile vss-revision vss-description skip
      359         "Не найдена запись ЕД.ИЗМ."
      360         view-as alert-box error .
      361         undo, return error.
      362       end.
      363       create tt-units.
      364       buffer-copy locked_units to tt-units.
      365     end.
      366     else do:
      367       create tt-units.
      368     end.
      369     RUN MYenable.
      370     WAIT-FOR GO OF FRAME Dialog-Frame.
      371   END.
      372   session:data-entry-return = no .
      373   RUN disable_UI.
      374   PROCEDURE disable_UI :
      375     HIDE FRAME Dialog-Frame.
      376   END PROCEDURE.
      377   PROCEDURE enable_UI :
      378     OPEN QUERY Dialog-Frame FOR EACH tt-units SHARE-LOCK.
      379     GET FIRST Dialog-Frame.
      380     DISPLAY UnitType UnitType-2
      381         WITH FRAME Dialog-Frame.
      382     IF AVAILABLE tt-units THEN
      383       DISPLAY tt-units.long-name tt-units.unit-name tt-units.OKEI
      384         WITH FRAME Dialog-Frame.
      385     ENABLE B-exit b-quit B-hist B-Help tt-units.long-name tt-units.unit-name
      386            UnitType tt-units.OKEI UnitType-2
      387         WITH FRAME Dialog-Frame.
      388     VIEW FRAME Dialog-Frame.
      389   END PROCEDURE.
      390   PROCEDURE MyEnable :
      391   session:data-entry-return = yes .
      392   UnitType:list-items in frame Dialog-Frame
      393                                            = 'штучный':U + chr(44) +
      394                         'дробный':U + chr(44) +
      395                         'весовой':U + chr(44) +
      396                         'серийный':U + chr(44) +
      397                         'топливо':U + chr(44) +
      398                         'стеклопосуда':U
      399                         .
      400   UnitType:INNER-LINES = num-entries (Unittype:list-items) .
      401   UnitType:screen-value = entry (1, 'штучный,дробный,серийный,весовой,топливо,2едизма,прпарт,дополнительный,стеклопосуда':U) .
      402   UnitType-2:INNER-LINES = num-entries ('штучный,дробный':U + chr(44) + '2ед':U + chr(44) + 'доп':U) .
      403   UnitType-2:list-items = 'штучный,дробный':U + chr(44) + '2едизма':U + chr(44) + 'дополнительный':U.
      404    DISPLAY
      405    UnitType
      406    UnitType-2
      407    WITH FRAME Dialog-Frame.
      408   IF AVAILABLE tt-units THEN
      409       DISPLAY tt-units.long-name tt-units.unit-name tt-units.OKEI
      410         WITH FRAME Dialog-Frame.
      411     if p-mode = 'ПРОСМОТР':U then do:
      412       assign
      413       b-exit:label = "&Выход".
      414     end.
      415     ENABLE
      416     B-exit when p-mode <> 'ПРОСМОТР':U
      417     b-quit
      418     B-Help
      419     b-hist WHEN p-mode <> 'ДОБАВЛЕНИЕ':U
      420     tt-units.long-name when p-mode <> 'ПРОСМОТР':U
      421     tt-units.unit-name when p-mode = 'ДОБАВЛЕНИЕ':U
      422     UnitType when p-mode <> 'ПРОСМОТР':U
      423     UnitType-2 when p-mode = 'ИЗМЕНЕНИЕ':U and num-entries(tt-units.type) > 1
      424     tt-units.OKEI
      425     WITH FRAME Dialog-Frame.
      426     VIEW FRAME Dialog-Frame.
      427     IF p-mode = 'ИЗМЕНЕНИЕ':U then do:
      428         RUn RereadUnittype2(entry (lookup (ENTRY(1,tt-units.type), 'шту,дро,сер,вес,топ,2ед,прп,доп,сте':U), 'штучный,дробный,серийный,весовой,топливо,2едизма,прпарт,дополнительный,стеклопосуда':U)).
      429         FRAME Dialog-Frame:title = "Изменение единицы измерения".
      430         DISPLAY
      431         tt-units.long-name
      432         tt-units.OKEI
      433         tt-units.unit-name
      434         WITH frame Dialog-Frame.
      435         UnitType:screen-value = entry (lookup (ENTRY(1,tt-units.type), 'шту,дро,сер,вес,топ,2ед,прп,доп,сте':U), 'штучный,дробный,серийный,весовой,топливо,2едизма,прпарт,дополнительный,стеклопосуда':U) .
      436         if num-entries(tt-units.type) > 1 then
      437         UnitType-2:screen-value = entry (lookup (ENTRY(2, tt-units.type), 'шту,дро,сер,вес,топ,2ед,прп,доп,сте':U), 'штучный,дробный,серийный,весовой,топливо,2едизма,прпарт,дополнительный,стеклопосуда':U).
      438     end.
      439     else RUn RereadUnittype2(entry (1, 'штучный,дробный,серийный,весовой,топливо,2едизма,прпарт,дополнительный,стеклопосуда':U)).
      440     if p-mode = 'ПРОСМОТР':U then do:
      441       hide
      442       b-exit in frame Dialog-Frame .
      443     end.
      444   END PROCEDURE.
      445   PROCEDURE proc-save :
      446   assign
      447   frame Dialog-Frame
      448   tt-units.long-name
      449   tt-units.unit-name
      450   UNITTYPE
      451   UNITTYPE-2
      452   tt-units.type = substring (UnitType, 1, 3) +
      453                       (IF UnitType-2:sensitive AND trim(Unittype-2) <> ""
      454                       then (chr(44) + substring (UnitType-2, 1, 3))
      455                       else "")
      456   tt-units.OKEI
      457   .
      458   run ref/units01.p (
      459    input-output p-rid
      460   ,input p-mode
      461   ,input tt-units.OKEI
      462   ,input tt-units.long-name
      463   ,input tt-units.type
      464   ,input tt-units.unit-name
      465   ) no-error.
      466   if error-status:error then do:
      467   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      468   define variable fh as widget-handle no-undo .
      469   define variable hh as widget-handle no-undo .
      470   define variable rv as character no-undo .
      471   assign
      472   rv = entry(1, return-value , chr(4)).
      473   if rv <> "":U then do:
      474     assign
      475     fh = frame Dialog-Frame:first-child
      476     hh = fh:first-child
      477     .
      478     do while valid-handle(hh):
      479       if hh:name = rv then do:
      480         APPLY "ENTRY" to hh.
      481         undo ,
      482         return error.
      483       end.
      484       hh = hh:next-sibling.
      485     end.
      486   end.
      487     undo, return error.
      488   end.
      489   END PROCEDURE.
      490   PROCEDURE RereadUnittype2 :
      491   DEFINE INPUT PARAMETER unittype1 as char no-undo.
      492       CASE unittype1:
      493         WHEN 'топливо':U then do:
      494             unittype-2:list-items in frame Dialog-Frame = 'штучный,дробный':U.
      495             enable
      496             UnitType-2
      497             WITH FRAME Dialog-Frame .
      498             UnitType-2:screen-value = ENTRY(1, unittype-2:list-items).
      499         end.
      500         WHEN 'дробный':U then do:
      501             unittype-2:list-items = chr(44) + '2едизма':U.
      502             enable
      503             UnitType-2
      504             WITH FRAME Dialog-Frame.
      505             UnitType-2:screen-value = ENTRY(1, unittype-2:list-items).
      506         end.
      507         WHEN '2едизма':U then do:
      508             unittype-2:list-items = 'дробный':U.
      509             enable
      510             UnitType-2
      511             WITH FRAME Dialog-Frame.
      512             UnitType-2:screen-value = ENTRY(1, unittype-2:list-items).
      513         end.
      514         WHEN 'штучный':U then do:
      515             unittype-2:list-items = chr(44) + 'дополнительный':U.
      516             enable
      517             UnitType-2
      518             WITH FRAME Dialog-Frame.
      519             UnitType-2:screen-value = ENTRY(1, unittype-2:list-items).
      520         end.
      521         WHEN 'стеклопосуда':U then do:
      522             unittype-2:list-items = 'штучный':U.
      523             enable
      524             UnitType-2
      525             WITH FRAME Dialog-Frame.
      526             UnitType-2:screen-value = ENTRY(1, unittype-2:list-items).
      527         end.
      528         otherwise do:
      529             UnitType-2:screen-value = ENTRY(1, unittype-2:list-items).
      530             disable
      531             UnitType-2
      532             WITH FRAME Dialog-Frame.
      533         end.
      534       END CASE.
      535   END PROCEDURE.
