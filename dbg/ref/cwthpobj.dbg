     1092   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input parameter parw-p-code   like ub.wth-line.w-p-code     no-undo.                        define input parameter parshift-date like ub.shift-obj.shift-date  no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                        cur_wth-line.w-p-code   = parw-p-code and                                                               cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.shift-date = parshift-date   and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-sd-pl no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                start_wth-line.w-p-code = parw-p-code and                                                             start_wth-line.wth-code   = parwth-code         and                                start_wth-line.shift-date < parshift-date and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-sd-pl no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income-pl - cur_wth-line.incass-pl              parincome        = cur_wth-line.income-pl                     parincome-cassa  = cur_wth-line.income-cassa-pl               parincome-other  = cur_wth-line.income-other-pl               parincass        = cur_wth-line.incass-pl                     parincass-bank   = cur_wth-line.incass-bank-pl                parincass-other  = cur_wth-line.incass-other-pl.              parincass-cassa  = cur_wth-line.incass-cassa-pl.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income-pl     - start_wth-line.incass-pl               parstock-end     = cur_wth-line.income-pl       - cur_wth-line.incass-pl                 parincome        = cur_wth-line.income-pl       - start_wth-line.income-pl               parincome-cassa  = cur_wth-line.income-cassa-pl - start_wth-line.income-cassa-pl         parincome-other  = cur_wth-line.income-other-pl - start_wth-line.income-other-pl         parincass        = cur_wth-line.incass-pl       - start_wth-line.incass-pl               parincass-bank   = cur_wth-line.incass-bank-pl  - start_wth-line.incass-bank-pl          parincass-other  = cur_wth-line.incass-other-pl - start_wth-line.incass-other-pl.        parincass-cassa  = cur_wth-line.incass-cassa-pl - start_wth-line.incass-cassa-pl.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income-pl - start_wth-line.incass-pl                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
     1093   end procedure.
     1094   procedure wth-lib_full-inf-calend-date:
     1095   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parfact-date    like ub.wth-line.fact-date    no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.fact-date  = parfact-date  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-cld no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                                                                             start_wth-line.wth-code   = parwth-code         and                                start_wth-line.fact-date  < parfact-date   and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-cld no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income - cur_wth-line.incass              parincome        = cur_wth-line.income                     parincome-cassa  = cur_wth-line.income-cassa               parincome-other  = cur_wth-line.income-other               parincass        = cur_wth-line.incass                     parincass-bank   = cur_wth-line.incass-bank                parincass-other  = cur_wth-line.incass-other.              parincass-cassa  = cur_wth-line.incass-cassa.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income     - start_wth-line.incass               parstock-end     = cur_wth-line.income       - cur_wth-line.incass                 parincome        = cur_wth-line.income       - start_wth-line.income               parincome-cassa  = cur_wth-line.income-cassa - start_wth-line.income-cassa         parincome-other  = cur_wth-line.income-other - start_wth-line.income-other         parincass        = cur_wth-line.incass       - start_wth-line.incass               parincass-bank   = cur_wth-line.incass-bank  - start_wth-line.incass-bank          parincass-other  = cur_wth-line.incass-other - start_wth-line.incass-other.        parincass-cassa  = cur_wth-line.incass-cassa - start_wth-line.incass-cassa.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income - start_wth-line.incass                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
     1096   end procedure.
     1097   procedure wth-lib_full-inf-calend-date-place:
     1098   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input parameter parw-p-code  like ub.wth-line.w-p-code  no-undo.                        define input parameter parfact-date like ub.wth-line.fact-date no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                        cur_wth-line.w-p-code   = parw-p-code and                                                               cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.fact-date  = parfact-date  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-cld-pl no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                start_wth-line.w-p-code = parw-p-code and                                                             start_wth-line.wth-code   = parwth-code         and                                start_wth-line.fact-date  < parfact-date   and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-cld-pl no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income-pl - cur_wth-line.incass-pl              parincome        = cur_wth-line.income-pl                     parincome-cassa  = cur_wth-line.income-cassa-pl               parincome-other  = cur_wth-line.income-other-pl               parincass        = cur_wth-line.incass-pl                     parincass-bank   = cur_wth-line.incass-bank-pl                parincass-other  = cur_wth-line.incass-other-pl.              parincass-cassa  = cur_wth-line.incass-cassa-pl.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income-pl     - start_wth-line.incass-pl               parstock-end     = cur_wth-line.income-pl       - cur_wth-line.incass-pl                 parincome        = cur_wth-line.income-pl       - start_wth-line.income-pl               parincome-cassa  = cur_wth-line.income-cassa-pl - start_wth-line.income-cassa-pl         parincome-other  = cur_wth-line.income-other-pl - start_wth-line.income-other-pl         parincass        = cur_wth-line.incass-pl       - start_wth-line.incass-pl               parincass-bank   = cur_wth-line.incass-bank-pl  - start_wth-line.incass-bank-pl          parincass-other  = cur_wth-line.incass-other-pl - start_wth-line.incass-other-pl.        parincass-cassa  = cur_wth-line.incass-cassa-pl - start_wth-line.incass-cassa-pl.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income-pl - start_wth-line.incass-pl                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
     1099   end procedure.
     1100   FUNCTION get-curr RETURNS CHARACTER
     1101     (buffer loc-wealth for ub.wealth ) :
     1102   define buffer buf_currency for ub.currency.
     1103   if loc-wealth.curr-code = ? or loc-wealth.is-money = no then
     1104   return loc-wealth.unit-base.
     1105   FIND FIRST buf_currency no-lock where
     1106             buf_currency.curr-code = loc-wealth.curr-code No-ERROR.
     1107   if avail buf_currency then
     1108     RETURN buf_currency.curr-abbr.
     1109   else return "".
     1110   END FUNCTION.
     1111   define variable filter-label as character no-undo init "История остатков МЦ на МХ" .
     1112   define variable filter-label0 as character no-undo init "История остатков МЦ на МХ" .
     1113   define variable filter-point0 as character no-undo init "cwthpobj" .
     1114   define variable filter-point as character no-undo init "cwthpobj" .
     1115   define variable sort-column-name as character no-undo .
     1116   define variable print-option as character no-undo.
     1117   DEFINE VARIABLE v-db-num like ub.db.db-num no-undo .
     1118   define variable v-doc-rec as recid no-undo .
     1119   define variable v-find as logical no-undo.
     1120   define variable v-wth-name like ub.wealth.wth-name no-undo.
     1121   define variable v-w-p-name like ub.wth-place.w-p-name no-undo.
     1122   define variable v-start-date-chr as character no-undo .
     1123   define variable v-end-date-chr as character no-undo .
     1124   define variable v-host-code like ub.sysconf.host-code no-undo .
     1125   define variable v-rid-list as character no-undo .
     1126   define variable dops as character no-undo format "X(250)".
     1127   define variable dopst as character no-undo format "X(1)".
     1128   define buffer X_curr_sysconf for ub.sysconf.
     1129   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1130   define  temp-table temp-changes no-undo
     1131   field f_name as character
     1132   field l_name as character
     1133   field v_old as character
     1134   field v_new as character
     1135   field t_name as character
     1136   field num_ as integer
     1137   field uniq-key-rec as character
     1138   field action as integer
     1139   field fNotChange as logical
     1140   index pi is unique primary
     1141   num_
     1142   t_name
     1143   f_name
     1144   index
     1145   Chan
     1146   fnotChange
     1147   t_name
     1148   f_name
     1149   index imain uniq-key-rec
     1150   .
     1151   FUNCTION get-all-fields returns character (p-file-name as character ):
     1152   define variable v-dop as character no-undo .
     1153     find first _file no-lock where _file._file-name = p-file-name no-error .
     1154     if not available _file then return "":U.
     1155     for each _field no-lock where
     1156              _field._file-recid = recid(_file) :
     1157       assign
     1158       v-dop = v-dop + _field._field-name + chr(44)
     1159       .
     1160     end.
     1161     return trim(v-dop).
     1162   END FUNCTION.
     1163   PROCEDURE proc-full-temp-changes :
     1164     define input  parameter p-hst-handle as handle    no-undo .
     1165     define input  parameter p-main-table as character no-undo .
     1166     define input  parameter p-field-list as character no-undo .
     1167     define input  parameter p-label-form as character no-undo .
     1168     define variable h-new-buf         as handle    no-undo .
     1169     define variable h-main-buf        as handle    no-undo .
     1170     define variable h-for-comp        as handle    no-undo .
     1171     define variable v-inform          as character no-undo .
     1172     define variable v-ind             as integer   no-undo .
     1173     define variable v-idx-field-qnty  as integer   no-undo .
     1174     define variable v-num-entries     as integer   no-undo .
     1175     define variable fh                as handle    no-undo .
     1176     define variable fh-main           as handle    no-undo .
     1177     define variable fh-old            as handle    no-undo .
     1178     define variable fh-new            as handle    no-undo .
     1179     define variable v-field-name      as character no-undo .
     1180     define variable v-field-lvl       as character no-undo .
     1181     define variable v-field-form      as character no-undo .
     1182     define variable v-search-exp      as character no-undo .
     1183     define variable v-srch-main       as character no-undo .
     1184     define variable v-word-link       as character no-undo .
     1185     define variable v-av-chip-num     as logical   no-undo .
     1186     define variable v-main-pi-fld-lst as character no-undo .
     1187     define variable v-main-fld-lst    as character no-undo .
     1188     define variable v-delim-list      as character no-undo .
     1189     define variable v-label           as character no-undo .
     1190     define variable v-old-value       as character no-undo case-sensitive.
     1191     define variable v-new-value       as character no-undo case-sensitive.
     1192     define variable v-chg-fields as character no-undo.
     1193     for each temp-changes:
     1194       delete temp-changes.
     1195     end.
     1196     if not p-hst-handle:available then do:
     1197       return .
     1198     end.
     1199     create buffer h-new-buf  for table p-hst-handle .
     1200     create buffer h-main-buf for table p-main-table .
     1201     assign
     1202       v-inform = h-main-buf:index-information(1)
     1203       v-ind    = 2
     1204     .
     1205     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1206     on error undo, return error
     1207     :
     1208       assign
     1209         v-inform = h-main-buf:index-information( v-ind )
     1210         v-ind    = v-ind + 1
     1211       .
     1212     end.
     1213     if v-inform = ?
     1214       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1215       or entry( 3, v-inform, ",":U ) <> "1":U
     1216     then do:
     1217       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1218     end.
     1219     assign
     1220       v-idx-field-qnty = num-entries( v-inform ) - 4
     1221     .
     1222     if v-idx-field-qnty < 2 then do:
     1223       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1224     end.
     1225     assign
     1226       v-srch-main   = "where":U
     1227       v-word-link   = "":U
     1228       v-av-chip-num = false
     1229       v-delim-list  = "":U
     1230     .
     1231     do v-ind = 1 to v-idx-field-qnty by 2
     1232     on error undo, return error
     1233     :
     1234       assign
     1235         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1236         fh                = p-hst-handle:buffer-field( v-field-name )
     1237         fh-main           = h-main-buf:buffer-field( v-field-name )
     1238         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1239         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1240       .
     1241       if fh:data-type ="character":U then do:
     1242         assign
     1243           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1244         .
     1245       end.
     1246       else do:
     1247         assign
     1248           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1249         .
     1250       end.
     1251       if v-delim-list = "":U then do:
     1252         assign
     1253           v-delim-list = ",":U
     1254         .
     1255       end.
     1256       if v-word-link = "":U then do:
     1257         assign
     1258           v-word-link = "and":U
     1259         .
     1260       end.
     1261     end.
     1262     assign
     1263       v-delim-list  = "":U
     1264     .
     1265     do v-ind = 1 to h-main-buf:num-fields
     1266     on error undo, return error
     1267     :
     1268       assign
     1269         fh-main      = h-main-buf:buffer-field( v-ind )
     1270         v-field-name = fh-main:name
     1271       .
     1272         assign
     1273           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1274         .
     1275         if v-delim-list = "":U then do:
     1276           assign
     1277             v-delim-list = ",":U
     1278           .
     1279         end.
     1280     end.
     1281     assign
     1282       v-inform = p-hst-handle:index-information(1)
     1283       v-ind    = 2
     1284     .
     1285     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1286     on error undo, return error
     1287     :
     1288       assign
     1289         v-inform = p-hst-handle:index-information( v-ind )
     1290         v-ind    = v-ind + 1
     1291       .
     1292     end.
     1293     if v-inform = ?
     1294       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1295       or entry( 3, v-inform, ",":U ) <> "1":U
     1296     then do:
     1297       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1298     end.
     1299     assign
     1300       v-idx-field-qnty = num-entries( v-inform ) - 4
     1301     .
     1302     if v-idx-field-qnty < 2 then do:
     1303       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1304     end.
     1305     assign
     1306       v-search-exp  = "where":U
     1307       v-word-link   = "":U
     1308       v-av-chip-num = false
     1309     .
     1310     do v-ind = 1 to v-idx-field-qnty by 2
     1311     on error undo, return error
     1312     :
     1313       assign
     1314         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1315         fh           = p-hst-handle:buffer-field( v-field-name )
     1316         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1317       .
     1318       if v-field-name = "chip-num":U then do:
     1319         assign
     1320           v-search-exp  = substitute( "&1 >", v-search-exp )
     1321           v-av-chip-num = true
     1322         .
     1323       end.
     1324       else do:
     1325         assign
     1326           v-search-exp = substitute( "&1 =", v-search-exp )
     1327         .
     1328       end.
     1329       if fh:data-type ="character":U then do:
     1330         assign
     1331           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1332         .
     1333       end.
     1334       else do:
     1335         assign
     1336           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1337         .
     1338       end.
     1339       if v-word-link = "":U then do:
     1340         assign
     1341           v-word-link = "and":U
     1342         .
     1343       end.
     1344     end.
     1345     if v-av-chip-num = false then do:
     1346       message
     1347         vss-workfile vss-revision vss-description skip
     1348         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1349         "Использование данной процедуры невозможно!" skip
     1350         view-as alert-box error .
     1351       return error .
     1352     end.
     1353     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1354     if not h-new-buf:available then do:
     1355       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1356       if not h-main-buf:available then do:
     1357         assign
     1358           h-for-comp = ?
     1359         .
     1360       end.
     1361       else do:
     1362         assign
     1363           h-for-comp = h-main-buf
     1364         .
     1365       end.
     1366     end.
     1367     else do:
     1368       assign
     1369         h-for-comp = h-new-buf
     1370       .
     1371     end.
     1372     assign
     1373       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1374     .
     1375     do v-ind = 1 to v-num-entries
     1376     on error undo, return error return-value
     1377     :
     1378       assign
     1379         v-field-name = entry( v-ind, v-main-fld-lst )
     1380         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1381         v-old-value  = fh-old:buffer-value()
     1382         v-label      = trim( fh-old:label )
     1383       .
     1384       if ( trim( p-field-list ) <> "":U
     1385            and lookup( v-field-name, p-field-list ) > 0
     1386          )
     1387          or trim( p-field-list ) = "":U
     1388       then do:
     1389         if h-for-comp <> ? then do:
     1390           assign
     1391             fh-new      = h-for-comp:buffer-field( v-field-name )
     1392             v-new-value = fh-new:buffer-value()
     1393           .
     1394         end.
     1395         else do:
     1396           assign
     1397             v-new-value = "":U
     1398           .
     1399         end.
     1400         if v-old-value <> v-new-value
     1401         then do:
     1402           create temp-changes.
     1403           assign
     1404             temp-changes.t_name = p-main-table
     1405             temp-changes.f_name = v-field-name
     1406             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1407             temp-changes.v_old  = trim( v-old-value )
     1408             temp-changes.v_new  = trim( v-new-value )
     1409             temp-changes.num_   = 0
     1410             temp-changes.fNotChange = v-old-value eq v-new-value
     1411           .
     1412         end.
     1413       end.
     1414     end.
     1415     assign
     1416       v-num-entries = num-entries( p-label-form, chr(8) )
     1417     .
     1418     do v-ind = 1 to v-num-entries
     1419     on error undo, return error return-value
     1420     :
     1421       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1422         assign
     1423           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1424           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1425           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1426         .
     1427         find first temp-changes
     1428           where temp-changes.f_name = v-field-name
     1429           no-error .
     1430         if available temp-changes then do:
     1431           if trim( v-field-lvl ) <> "":U then do:
     1432             assign
     1433               temp-changes.l_name = v-field-lvl
     1434             .
     1435           end.
     1436           if trim( v-field-form ) <> "":U then do:
     1437             assign
     1438               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1439             .
     1440             if h-for-comp <> ? then do:
     1441               assign
     1442                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1443               .
     1444             end.
     1445           end.
     1446         end.
     1447       end.
     1448       else do:
     1449         message
     1450           vss-workfile vss-revision vss-description skip
     1451           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1452           substitute( "список для поля '&1': '&2'"
     1453                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1454                       ,entry( v-ind, p-label-form, chr(8) )
     1455                     ) skip
     1456           substitute( "полный список: &2", p-label-form ) skip
     1457           view-as alert-box error .
     1458       end.
     1459     end.
     1460     delete object h-new-buf .
     1461     delete object h-main-buf .
     1462   END PROCEDURE.
     1463   FUNCTION get-action RETURNS CHARACTER
     1464     ( p-action as character )  FORWARD.
     1465   FUNCTION get-source-type RETURNS CHARACTER
     1466     ( p-source-type as character )  FORWARD.
     1467   FUNCTION get-wealth RETURNS CHARACTER
     1468     ( p-wth-code as integer )  FORWARD.
     1469   FUNCTION get-wp RETURNS CHARACTER
     1470     ( p-obj-type as character, p-obj-code as integer, p-w-p-code as integer )  FORWARD.
     1471   DEFINE BUTTON B-Help
     1472        LABEL "Помо&щь"
     1473        SIZE 3 BY 1
     1474        BGCOLOR 8 .
     1475   DEFINE BUTTON B-lookup
     1476        LABEL "&Документ"
     1477        SIZE 10 BY 1.
     1478   DEFINE BUTTON B-mark
     1479        LABEL "&*"
     1480        SIZE 3 BY 1.
     1481   DEFINE BUTTON B-print
     1482        LABEL "Пе&чать"
     1483        SIZE 3 BY 1.
     1484   DEFINE BUTTON b-quit AUTO-END-KEY
     1485        LABEL "&Выход"
     1486        SIZE 10 BY 1
     1487        BGCOLOR 8 .
     1488   DEFINE BUTTON B-sch
     1489        LABEL "&Фильтр"
     1490        SIZE 3 BY 1.
     1491   DEFINE BUTTON b-sel AUTO-GO
     1492        LABEL "Вы&бор"
     1493        SIZE 10 BY 1
     1494        BGCOLOR 8 .
     1495   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1496         VIEW-AS TEXT
     1497        SIZE 6 BY 1
     1498        FGCOLOR 4  NO-UNDO.
     1499   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1500        LABEL "Дате изм."
     1501        VIEW-AS FILL-IN
     1502        SIZE 11 BY 1 NO-UNDO.
     1503   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1504        LABEL "пользователю"
     1505        VIEW-AS FILL-IN
     1506        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1507   DEFINE VARIABLE sch-source-ref AS CHARACTER FORMAT "X(9)":U
     1508        LABEL "док-ту"
     1509        VIEW-AS FILL-IN
     1510        SIZE 13 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1511   DEFINE VARIABLE sch-w-p-code AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1512        LABEL "коду МХ"
     1513        VIEW-AS FILL-IN
     1514        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1515   DEFINE QUERY BR-changes FOR
     1516         temp-changes SCROLLING.
     1517   DEFINE QUERY br-cwthobj FOR
     1518         X_c-wth-pobj SCROLLING.
     1519   DEFINE BROWSE BR-changes
     1520     QUERY BR-changes DISPLAY
     1521         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1522   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1523   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1524       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1525   DEFINE BROWSE br-cwthobj
     1526     QUERY br-cwthobj NO-LOCK DISPLAY
     1527         mark-string(recid(X_c-wth-pobj), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1528         X_c-wth-pobj.wth-code COLUMN-LABEL "Код МЦ" FORMAT ">>>>>>>>9":U
     1529         X_c-wth-pobj.w-p-code COLUMN-LABEL "Код Мх МЦ" FORMAT ">>>>>>>>9":U
     1530         X_c-wth-pobj.corr-date FORMAT "99/99/9999":U
     1531         usrfulnf(X_c-wth-pobj.corr-user-name) FORMAT "X(18)":U
     1532         string(X_c-wth-pobj.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1533         X_c-wth-pobj.corr-user-db-num FORMAT ">>>>9":U
     1534         X_c-wth-pobj.source-ref FORMAT "X(14)":U
     1535         get-action(X_c-wth-pobj.action-type) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1536         get-source-type(X_c-wth-pobj.source-type) COLUMN-LABEL "Источн.!измен."
     1537         if v-find and p-mode <> 'place' then get-wealth(X_c-wth-pobj.wth-code) else "":U COLUMN-LABEL "Назв. МЦ" FORMAT "X(25)":U
     1538         if v-find then get-wp(X_c-wth-pobj.obj-type, X_c-wth-pobj.obj-code, X_c-wth-pobj.w-p-code) else "":U COLUMN-LABEL "Назв. МХ" FORMAT "x(25)":U
     1539         X_c-wth-pobj.obj-type + string(X_c-wth-pobj.obj-code) COLUMN-LABEL "Объект" FORMAT "X(8)":U
     1540     ENABLE
     1541         X_c-wth-pobj.corr-date
     1542       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1543   DEFINE FRAME Dialog-Frame
     1544        b-quit AT ROW 1 COL 1
     1545        B-mark AT ROW 1 COL 11
     1546        b-sel AT ROW 1 COL 21
     1547        B-print AT ROW 1 COL 89
     1548        B-sch AT ROW 1 COL 92
     1549        B-Help AT ROW 1 COL 95
     1550        B-lookup AT ROW 1.04 COL 45
     1551        br-cwthobj AT ROW 2 COL 1
     1552        sch-corr-date AT ROW 13.63 COL 64.5 COLON-ALIGNED
     1553        sch-w-p-code AT ROW 13.67 COL 45 COLON-ALIGNED
     1554        sch-source-ref AT ROW 13.67 COL 84 COLON-ALIGNED
     1555        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1556        BR-changes AT ROW 14.79 COL 1
     1557        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1558        "ПОИСК ПО" VIEW-AS TEXT
     1559             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1560             FGCOLOR 4
     1561        SPACE(89.48) SKIP(7.44)
     1562       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1563            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1564            TITLE "История остатков МЦ на МХ"
     1565            CANCEL-BUTTON b-quit.
     1566   ASSIGN
     1567          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1568          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1569   ON GO OF FRAME Dialog-Frame
     1570   DO:
     1571     p-rid-list = v-rid-list.
     1572   END.
     1573   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1574   DO:
     1575     APPLY "END-ERROR":U TO SELF.
     1576   END.
     1577   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1578   DO:
     1579   define buffer buf_wth-doc for ub.wth-doc.
     1580   define buffer buf_C-wth-doc for ub.C-wth-doc.
     1581   if not available X_c-wth-pobj then return no-apply.
     1582   IF X_c-wth-pobj.source-type = 'wth-doc':U then do:
     1583     find first buf_wth-doc no-lock where
     1584           buf_wth-doc.doc-code =  X_c-wth-pobj.source-ref no-error.
     1585     if not available buf_wth-doc then do:
     1586       for each buf_C-wth-doc no-lock where
     1587             buf_c-wth-doc.doc-code =  X_c-wth-pobj.source-ref
     1588         AND buf_c-wth-doc.is-del =  yes :
     1589         run str/wthcdlkp.p (
     1590                         input parparentproc
     1591                        ,input recid(buf_C-wth-doc)
     1592                        ) no-error .
     1593         leave.
     1594       end.
     1595       if not available buf_c-wth-doc then do:
     1596         message
     1597         substitute("Не найден документ с № &1", X_c-wth-pobj.source-ref)
     1598         view-as alert-box error .
     1599         return no-apply.
     1600       end.
     1601     END.
     1602     else do:
     1603       run str/wthd-lkp.p (
     1604                       input parparentproc
     1605                     ,input recid(buf_wth-doc)) no-error .
     1606     end.
     1607   end.
     1608   END.
     1609   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1610   DO:
     1611   define variable loc#log as logical no-undo .
     1612     if available X_c-wth-pobj then do:
     1613   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1614   define variable v-str-recid15 as character no-undo .
     1615   define variable v-num-entry15 as integer   no-undo .
     1616   assign
     1617     v-str-recid15 = trim( string( recid( X_c-wth-pobj ) , "->>>>>>>>>>>9":U ) )
     1618     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     1619   .
     1620   if v-num-entry15 > 0 then do:
     1621     assign
     1622       entry( v-num-entry15, v-rid-list ) = "":U
     1623       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1624     .
     1625   end.
     1626   else do:
     1627     assign
     1628       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1629     .
     1630   end.
     1631       loc#log = br-cwthobj:refresh() .
     1632       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1633           loc#log = br-cwthobj:select-next-row ().
     1634           apply "VALUE-CHANGED" to br-cwthobj in frame Dialog-Frame.
     1635       end.
     1636       if num-entries( v-rid-list ) = 0
     1637       then
     1638           hide mark-num in frame Dialog-Frame.
     1639       else
     1640           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1641     end.
     1642     apply "entry" to br-cwthobj in frame Dialog-Frame.
     1643   END.
     1644   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1645   DO:
     1646       run proc-b-print in this-procedure no-error.
     1647     if error-status:error then return no-apply.
     1648   END.
     1649   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1650   DO:
     1651       run proc-b-sch in this-procedure no-error.
     1652     if error-status:error then return no-apply.
     1653   END.
     1654   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1655   DO:
     1656     if ( available X_c-wth-pobj ) then do:
     1657       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1658       then
     1659       v-rid-list = string( recid( X_c-wth-pobj ) ) .
     1660     end.
     1661   END.
     1662   ON MOUSE-SELECT-DBLCLICK OF br-cwthobj IN FRAME Dialog-Frame
     1663   DO:
     1664        run proc-br-cwthobj in this-procedure no-error.
     1665     if error-status:error then return no-apply.
     1666   END.
     1667   ON RETURN OF br-cwthobj IN FRAME Dialog-Frame
     1668   DO:
     1669       run proc-br-cwthobj in this-procedure no-error.
     1670     if error-status:error then return no-apply.
     1671   END.
     1672   ON VALUE-CHANGED OF br-cwthobj IN FRAME Dialog-Frame
     1673   DO:
     1674     run proc-view-changes in this-procedure no-error.
     1675   END.
     1676   ON CTRL-J OF sch-corr-date IN FRAME Dialog-Frame
     1677   DO:
     1678      run proc-find-corr-date in this-procedure(yes, input frame Dialog-Frame sch-corr-date) no-error.
     1679     if error-status:error then return no-apply.
     1680   END.
     1681   ON RETURN OF sch-corr-date IN FRAME Dialog-Frame
     1682   DO:
     1683     run proc-find-corr-date in this-procedure(no, input frame Dialog-Frame sch-corr-date) no-error.
     1684     if error-status:error then return no-apply.
     1685   END.
     1686   ON CTRL-J OF sch-corr-user-name IN FRAME Dialog-Frame
     1687   DO:
     1688     run proc-find-user in this-procedure(yes, input frame Dialog-Frame sch-corr-user-name) no-error.
     1689     if error-status:error then return no-apply.
     1690   END.
     1691   ON RETURN OF sch-corr-user-name IN FRAME Dialog-Frame
     1692   DO:
     1693     run proc-find-user in this-procedure(no, input frame Dialog-Frame sch-corr-user-name) no-error.
     1694     if error-status:error then return no-apply.
     1695   END.
     1696   ON CTRL-J OF sch-source-ref IN FRAME Dialog-Frame
     1697   DO:
     1698     run proc-find-source-ref in this-procedure(yes, input frame Dialog-Frame sch-source-ref) no-error.
     1699     if error-status:error then return no-apply.
     1700   END.
     1701   ON RETURN OF sch-source-ref IN FRAME Dialog-Frame
     1702   DO:
     1703     run proc-find-source-ref in this-procedure(no, input frame Dialog-Frame sch-source-ref) no-error.
     1704     if error-status:error then return no-apply.
     1705   END.
     1706   ON CTRL-J OF sch-w-p-code IN FRAME Dialog-Frame
     1707   DO:
     1708     run proc-find-w-p-code in this-procedure(yes, input frame Dialog-Frame sch-w-p-code) no-error.
     1709     if error-status:error then return no-apply.
     1710   END.
     1711   ON RETURN OF sch-w-p-code IN FRAME Dialog-Frame
     1712   DO:
     1713     run proc-find-w-p-code in this-procedure(no, input frame Dialog-Frame sch-w-p-code) no-error.
     1714     if error-status:error then return no-apply.
     1715   END.
     1716   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1717   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1718   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1719   on help of frame Dialog-Frame
     1720   do:
     1721     run gbl/app_help.p
     1722       (input this-procedure :file-name
     1723       ,input ''
     1724       ,input ?
     1725       ) no-error.
     1726     if error-status :error then do:
     1727       message
     1728         "Ошибка при вызове помощи"
     1729         error-status :get-message(1)
     1730         view-as alert-box .
     1731     end.
     1732   end.
     1733   run minbtn-set in this-procedure .
     1734   on choose of b-help in frame Dialog-Frame
     1735   do:
     1736     apply "help":u to frame Dialog-Frame .
     1737   end.
     1738   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1739   procedure minbtn-set :
     1740       do
     1741           on error undo, return error return-value
     1742           :
     1743           define variable ii              as integer       no-undo .
     1744           define variable fh              as widget-handle no-undo .
     1745           define variable hh              as widget-handle no-undo .
     1746           define variable v-h             as handle        extent 4 no-undo .
     1747           define variable v-name-button   as character     no-undo .
     1748           define variable v-help-old-x    as decimal       no-undo .
     1749           define variable v-help-old-y    as decimal       no-undo .
     1750           define variable v-help-old-size as decimal       no-undo .
     1751           define variable v-frame-width   as decimal       no-undo .
     1752           define variable jj              as integer       no-undo .
     1753           do
     1754               on error undo, return error
     1755               :
     1756               assign
     1757                   v-frame-width = frame Dialog-Frame:width - 0.3
     1758                   fh            = frame Dialog-Frame:first-child
     1759                   hh            = fh:first-child
     1760                   ii            = 1
     1761                   .
     1762               do while valid-handle(hh):
     1763                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1764                   do:
     1765                       case lc(hh:name) :
     1766                           when "b-help" then
     1767                               do:
     1768                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1769                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1770                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1771                                   hh:TOOLTIP = "Помощь" .
     1772                                   v-help-old-x = hh:column .
     1773                                   v-help-old-y = hh:row    .
     1774                                   v-help-old-size = hh:width .
     1775                                   hh:width-chars = 2.5 .
     1776                               end.
     1777                           when "b-print" then
     1778                               do:
     1779                                   hh:load-image("cmp/b-print.bmp":u) .
     1780                                   hh:TOOLTIP = "Печать" .
     1781                                   v-h[ii] = hh:handle .
     1782                                   ii = ii + 1 .
     1783                                   hh:width-chars = 3 .
     1784                               end.
     1785                           when "b-history" or
     1786                           when "b-hist" then
     1787                               do:
     1788                                   hh:load-image("cmp/b-hist.bmp":u) .
     1789                                   hh:TOOLTIP = "История" .
     1790                                   v-h[ii] = hh:handle .
     1791                                   ii = ii + 1 .
     1792                                   hh:width-chars = 3 .
     1793                               end.
     1794                           when "b-sch" then
     1795                               do:
     1796                                   hh:load-image("cmp/b-sch.bmp":u) .
     1797                                   hh:TOOLTIP = "Установка Фильтра" .
     1798                                   v-h[ii] = hh:handle .
     1799                                   ii = ii + 1 .
     1800                                   hh:width-chars = 3 .
     1801                               end.
     1802                           when "b-hist-user" then
     1803                               do:
     1804                                   hh:load-image("cmp/b-hist.bmp":u) .
     1805                                   hh:TOOLTIP = "История пользователя" .
     1806                                   ii = ii + 1 .
     1807                               end.
     1808                       end case.
     1809                   end.
     1810                   hh = hh:next-sibling.
     1811               end.
     1812               b-help:column = v-frame-width - b-help:width-chars.
     1813               jj = 0.
     1814               repeat ii = 4 to 1 by -1 :
     1815                   if valid-handle (v-h[ii] ) then
     1816                   do:
     1817                       jj  = jj + 1 .
     1818                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1819                       v-h[ii]:row    = v-help-old-y .
     1820                   end.
     1821               end.
     1822           end.
     1823       end.
     1824   end procedure.
     1825   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1826   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1827   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1828   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1829   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1830   define variable v-diasize-current-frame-height as decimal   no-undo .
     1831   define variable v-diasize-change-size          as logical   no-undo .
     1832   define variable v-diasize-resize-button        as handle    no-undo .
     1833   define variable v-diasize-wndmax               as logical   no-undo .
     1834   define variable v-diasize-wndstore             as logical   no-undo .
     1835   define variable v-diasize-proc-name            as character no-undo .
     1836   define variable v-diasize-browse-handle        as handle    no-undo .
     1837   define variable v-diasize-browse-number        as integer   no-undo .
     1838   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1839   define temp-table temp-diasize-handle no-undo
     1840     field handle-value  as handle
     1841     field save-position as decimal
     1842     index xpk is primary unique handle-value
     1843     .
     1844   define temp-table temp-browse-handle no-undo
     1845     field browse-type   as character
     1846     field browse-number as integer
     1847     field browse-handle as handle
     1848     field original-size as decimal
     1849     index xpk is primary unique browse-type browse-number
     1850     index xie browse-type browse-handle
     1851   .
     1852   procedure diasize_change-height :
     1853     define input  parameter p-change-value  as decimal   no-undo .
     1854     define input  parameter p-move-resize   as logical   no-undo .
     1855     define variable v-field-group-handle    as handle    no-undo .
     1856     define variable v-object-handle         as handle    no-undo .
     1857     define variable v-frame-height          as decimal   no-undo .
     1858     define variable v-frame-virtual-height  as decimal   no-undo .
     1859     define variable v-browse-height         as decimal   no-undo .
     1860     define variable v-window-height         as decimal   no-undo .
     1861     define variable v-window-virtual-height as decimal   no-undo .
     1862     define variable v-change-sign           as integer   no-undo .
     1863     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1864     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1865     if p-change-value > 0
     1866     then do:
     1867       if frame Dialog-Frame :height + p-change-value
     1868           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1869       then do:
     1870         assign
     1871           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1872                           - (frame Dialog-Frame :height-chars)
     1873         .
     1874         if p-change-value <= 0
     1875         then do:
     1876           run diasize_position-resize-button in this-procedure .
     1877           return .
     1878         end.
     1879       end.
     1880     end.
     1881     if p-change-value < 0
     1882     then do:
     1883       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1884       then do:
     1885         assign
     1886           p-change-value = v-diasize-orig-frame-height
     1887                          - (frame Dialog-Frame :height-chars)
     1888         .
     1889         if p-change-value >= 0
     1890         then do:
     1891           run diasize_position-resize-button in this-procedure .
     1892           return .
     1893         end.
     1894       end.
     1895     end.
     1896     if p-change-value >= 0
     1897     then do:
     1898       assign
     1899         v-change-sign = 1
     1900       .
     1901     end.
     1902     else do:
     1903       assign
     1904         v-change-sign = -1
     1905       .
     1906     end.
     1907     assign
     1908       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1909     .
     1910     if p-change-value = 0
     1911     then do:
     1912       run diasize_position-resize-button in this-procedure .
     1913       return .
     1914     end.
     1915     move_block:
     1916     do
     1917     on error undo move_block, retry move_block
     1918     :
     1919       if retry
     1920       then do:
     1921         do
     1922         on error undo move_block, leave move_block
     1923         :
     1924           if p-change-value > 0
     1925           then do:
     1926             for each buf_temp-diasize-handle
     1927             on error undo, next
     1928             :
     1929               assign
     1930                 v-object-handle = buf_temp-diasize-handle.handle-value
     1931               .
     1932               if v-object-handle <> v-diasize-resize-button
     1933               then do:
     1934                 assign
     1935                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1936                 .
     1937               end.
     1938             end.
     1939             assign
     1940               v-diasize-browse-handle :height = v-browse-height
     1941             .
     1942             for each buf_temp-browse-handle
     1943               where buf_temp-browse-handle.browse-type = 'height':u
     1944             on error undo, next
     1945             :
     1946               assign
     1947                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1948               .
     1949             end.
     1950             assign
     1951               frame Dialog-Frame :height = v-frame-height
     1952             .
     1953             if frame Dialog-Frame :scrollable = true
     1954             then do:
     1955               assign
     1956                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1957               .
     1958             end.
     1959             run diasize_position-resize-button in this-procedure .
     1960           end.
     1961           else do:
     1962             if frame Dialog-Frame :scrollable = true
     1963             then do:
     1964               assign
     1965                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1966               .
     1967             end.
     1968             assign
     1969               frame Dialog-Frame :height = v-frame-height
     1970             .
     1971             assign
     1972               v-diasize-browse-handle :height = v-browse-height
     1973             .
     1974             for each buf_temp-browse-handle
     1975               where buf_temp-browse-handle.browse-type = 'height':u
     1976             on error undo, next
     1977             :
     1978               assign
     1979                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1980               .
     1981             end.
     1982             for each buf_temp-diasize-handle
     1983             on error undo, next
     1984             :
     1985               assign
     1986                 v-object-handle = buf_temp-diasize-handle.handle-value
     1987               .
     1988               if v-object-handle <> v-diasize-resize-button
     1989               then do:
     1990                 assign
     1991                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1992                 .
     1993               end.
     1994             end.
     1995             run diasize_position-resize-button in this-procedure .
     1996           end.
     1997           assign
     1998             v-diasize-change-size = false
     1999           .
     2000           leave move_block .
     2001         end.
     2002       end.
     2003       assign
     2004         v-diasize-need-full-display = true
     2005       .
     2006       if v-diasize-change-size = false
     2007       then do:
     2008         assign
     2009           v-diasize-change-size = true
     2010         .
     2011       end.
     2012       else do:
     2013         return .
     2014       end.
     2015       assign
     2016         v-frame-height = frame Dialog-Frame :height
     2017         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2018         v-browse-height = v-diasize-browse-handle :height
     2019       .
     2020       for each buf_temp-browse-handle
     2021         where buf_temp-browse-handle.browse-type = 'height':u
     2022       :
     2023         assign
     2024           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2025         .
     2026       end.
     2027       for each buf_temp-diasize-handle
     2028       :
     2029         delete buf_temp-diasize-handle .
     2030       end.
     2031       assign
     2032         v-field-group-handle = frame Dialog-Frame :first-child
     2033       .
     2034       do while valid-handle(v-field-group-handle)
     2035       :
     2036         assign
     2037           v-object-handle = v-field-group-handle :first-child
     2038         .
     2039         do while valid-handle(v-object-handle)
     2040         :
     2041           if  v-object-handle <> v-diasize-browse-handle :handle
     2042           and can-query(v-object-handle, "row")
     2043           and can-query(v-object-handle, "height")
     2044           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2045           then do:
     2046             find first buf_temp-browse-handle
     2047               where buf_temp-browse-handle.browse-type   = 'height':u
     2048                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2049               no-error .
     2050             if available buf_temp-browse-handle
     2051             then do:
     2052             end.
     2053             else do:
     2054               create buf_temp-diasize-handle .
     2055               assign
     2056                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2057                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2058               .
     2059             end.
     2060           end.
     2061           assign
     2062             v-object-handle = v-object-handle :next-sibling
     2063           .
     2064         end.
     2065         assign
     2066           v-field-group-handle = v-field-group-handle :next-sibling
     2067         .
     2068       end.
     2069       do with frame Dialog-Frame
     2070       :
     2071         hide v-diasize-resize-button .
     2072         assign
     2073           v-diasize-resize-button :row    = 1
     2074           v-diasize-resize-button :column = 1
     2075         .
     2076       end.
     2077       if p-change-value > 0
     2078       then do:
     2079         if frame Dialog-Frame :scrollable = true
     2080         then do:
     2081           assign
     2082             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2083             no-error .
     2084           if error-status :error
     2085           or error-status :get-message(1) <> ""
     2086           then do:
     2087             undo move_block, retry move_block .
     2088           end.
     2089         end.
     2090         assign
     2091           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2092           no-error .
     2093         if error-status :error
     2094         or error-status :get-message(1) <> ""
     2095         then do:
     2096           undo move_block, retry move_block .
     2097         end.
     2098         assign
     2099           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2100           no-error .
     2101         if error-status :error
     2102         or error-status :get-message(1) <> ""
     2103         then do:
     2104           undo move_block, retry move_block .
     2105         end.
     2106         for each buf_temp-browse-handle
     2107           where buf_temp-browse-handle.browse-type = 'height':u
     2108         on error undo move_block, retry move_block
     2109         :
     2110           assign
     2111             buf_temp-browse-handle.browse-handle :height
     2112               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2113             no-error .
     2114           if error-status :error
     2115           or error-status :get-message(1) <> ""
     2116           then do:
     2117             undo move_block, retry move_block .
     2118           end.
     2119         end.
     2120         for each buf_temp-diasize-handle
     2121         on error undo move_block, retry move_block
     2122         :
     2123           assign
     2124             v-object-handle = buf_temp-diasize-handle.handle-value
     2125           .
     2126           if v-object-handle <> v-diasize-resize-button
     2127           then do:
     2128             assign
     2129               v-object-handle :row = v-object-handle :row + p-change-value
     2130               no-error .
     2131             if error-status :error
     2132             or error-status :get-message(1) <> ""
     2133             then do:
     2134               undo move_block, retry move_block .
     2135             end.
     2136           end.
     2137         end.
     2138       end.
     2139       else do:
     2140         for each buf_temp-diasize-handle
     2141         on error undo move_block, retry move_block
     2142         :
     2143           assign
     2144             v-object-handle = buf_temp-diasize-handle.handle-value
     2145           .
     2146           if v-object-handle <> v-diasize-resize-button
     2147           then do:
     2148             assign
     2149               v-object-handle :row = v-object-handle :row + p-change-value
     2150               no-error .
     2151             if error-status :error
     2152             or error-status :get-message(1) <> ""
     2153             then do:
     2154               undo move_block, retry move_block .
     2155             end.
     2156           end.
     2157         end.
     2158         assign
     2159           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2160           no-error .
     2161         if error-status :error
     2162         or error-status :get-message(1) <> ""
     2163         then do:
     2164           undo move_block, retry move_block .
     2165         end.
     2166         for each buf_temp-browse-handle
     2167           where buf_temp-browse-handle.browse-type = 'height':u
     2168         on error undo move_block, retry move_block
     2169         :
     2170           assign
     2171             buf_temp-browse-handle.browse-handle :height
     2172               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2173             no-error .
     2174           if error-status :error
     2175           or error-status :get-message(1) <> ""
     2176           then do:
     2177             undo move_block, retry move_block .
     2178           end.
     2179         end.
     2180         assign
     2181           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2182           no-error .
     2183         if error-status :error
     2184         or error-status :get-message(1) <> ""
     2185         then do:
     2186           undo move_block, retry move_block .
     2187         end.
     2188         if frame Dialog-Frame :scrollable = true
     2189         then do:
     2190           assign
     2191             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2192             no-error .
     2193           if error-status :error
     2194           or error-status :get-message(1) <> ""
     2195           then do:
     2196             undo move_block, retry move_block .
     2197           end.
     2198         end.
     2199       end.
     2200       if p-move-resize = true
     2201       then do:
     2202         run diasize_position-resize-button in this-procedure .
     2203       end.
     2204       if v-diasize-wndstore = true
     2205       then do:
     2206         if connected("ub") = true
     2207         then do:
     2208           define variable v-cntxt-db-num        as integer   no-undo .
     2209           define variable v-cntxt-userid        as character no-undo .
     2210           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2211                                             , OUTPUT v-cntxt-userid
     2212                                             ) .
     2213           run gbl/wndsizew.p
     2214             (input  v-cntxt-db-num
     2215             ,input  v-cntxt-userid
     2216             ,input  v-diasize-proc-name
     2217             ,input  'height':u
     2218             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2219             ) .
     2220         end.
     2221       end.
     2222     end.
     2223     assign
     2224       v-diasize-change-size = false
     2225     .
     2226   end procedure.
     2227   procedure diasize_set-height :
     2228     define input  parameter p-new-height  as decimal   no-undo .
     2229     define input  parameter p-move-resize as logical   no-undo .
     2230     do
     2231     on error undo, return error return-value
     2232     :
     2233       run diasize_change-height in this-procedure
     2234         (input  (p-new-height - frame Dialog-Frame :height)
     2235         ,input  p-move-resize
     2236         ) .
     2237     end.
     2238   end procedure.
     2239   procedure diasize_change-width :
     2240     define input  parameter p-change-value as decimal   no-undo .
     2241     define input  parameter p-move-resize  as logical   no-undo .
     2242     define variable v-field-group-handle   as handle    no-undo .
     2243     define variable v-object-handle        as handle    no-undo .
     2244     define variable v-frame-width          as decimal   no-undo .
     2245     define variable v-frame-virtual-width  as decimal   no-undo .
     2246     define variable v-browse-width         as decimal   no-undo .
     2247     define variable v-window-width         as decimal   no-undo .
     2248     define variable v-window-virtual-width as decimal   no-undo .
     2249     define variable v-change-sign          as integer   no-undo .
     2250     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2251     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2252     if p-change-value > 0
     2253     then do:
     2254       if frame Dialog-Frame :width + p-change-value >
     2255           session :width-chars
     2256       then do:
     2257         assign
     2258           p-change-value = session :width-chars - frame Dialog-Frame :width
     2259         .
     2260         if p-change-value <= 0
     2261         then do:
     2262           run diasize_position-resize-button in this-procedure .
     2263           return .
     2264         end.
     2265       end.
     2266     end.
     2267     if p-change-value < 0
     2268     then do:
     2269       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2270       then do:
     2271         assign
     2272           p-change-value = v-diasize-orig-frame-width
     2273                          - frame Dialog-Frame :width
     2274         .
     2275         if p-change-value >= 0
     2276         then do:
     2277           run diasize_position-resize-button in this-procedure .
     2278           return .
     2279         end.
     2280       end.
     2281     end.
     2282     if p-change-value >= 0
     2283     then do:
     2284       assign
     2285         v-change-sign = 1
     2286       .
     2287     end.
     2288     else do:
     2289       assign
     2290         v-change-sign = -1
     2291       .
     2292     end.
     2293     assign
     2294       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2295     .
     2296     if p-change-value = 0
     2297     then do:
     2298       run diasize_position-resize-button in this-procedure .
     2299       return .
     2300     end.
     2301     move_block:
     2302     do
     2303     on error undo move_block, leave move_block
     2304     :
     2305       if retry
     2306       then do:
     2307         do
     2308         on error undo move_block, leave move_block
     2309         :
     2310           if p-change-value > 0
     2311           then do:
     2312             for each buf_temp-diasize-handle
     2313             on error undo, next
     2314             :
     2315               assign
     2316                 v-object-handle = buf_temp-diasize-handle.handle-value
     2317               .
     2318               if v-object-handle <> v-diasize-resize-button
     2319               then do:
     2320                 assign
     2321                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2322                 .
     2323               end.
     2324             end.
     2325             assign
     2326               v-diasize-browse-handle :width = v-browse-width
     2327             .
     2328             for each buf_temp-browse-handle
     2329               where buf_temp-browse-handle.browse-type = 'width':u
     2330             on error undo, next
     2331             :
     2332               assign
     2333                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2334               .
     2335             end.
     2336             assign
     2337               frame Dialog-Frame :width = v-frame-width
     2338             .
     2339             if frame Dialog-Frame :scrollable = true
     2340             then do:
     2341               assign
     2342                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2343               .
     2344             end.
     2345             run diasize_position-resize-button in this-procedure .
     2346           end.
     2347           else do:
     2348             if frame Dialog-Frame :scrollable = true
     2349             then do:
     2350               assign
     2351                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2352               .
     2353             end.
     2354             assign
     2355               frame Dialog-Frame :width = v-frame-width
     2356             .
     2357             for each buf_temp-browse-handle
     2358               where buf_temp-browse-handle.browse-type = 'width':u
     2359             on error undo, next
     2360             :
     2361               assign
     2362                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2363               .
     2364             end.
     2365             assign
     2366               v-diasize-browse-handle :width = v-browse-width
     2367             .
     2368             for each buf_temp-diasize-handle
     2369             on error undo, next
     2370             :
     2371               assign
     2372                 v-object-handle = buf_temp-diasize-handle.handle-value
     2373               .
     2374               if v-object-handle <> v-diasize-resize-button
     2375               then do:
     2376                 assign
     2377                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2378                 .
     2379               end.
     2380             end.
     2381             run diasize_position-resize-button in this-procedure .
     2382           end.
     2383           assign
     2384             v-diasize-change-size = false
     2385           .
     2386           leave move_block .
     2387         end.
     2388       end.
     2389       assign
     2390         v-diasize-need-full-display = true
     2391       .
     2392       if v-diasize-change-size = false
     2393       then do:
     2394         assign
     2395           v-diasize-change-size = true
     2396         .
     2397       end.
     2398       else do:
     2399         return .
     2400       end.
     2401       assign
     2402         v-frame-width = frame Dialog-Frame :width
     2403         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2404         v-browse-width = v-diasize-browse-handle :width
     2405       .
     2406       for each buf_temp-browse-handle
     2407         where buf_temp-browse-handle.browse-type = 'width':u
     2408       :
     2409         assign
     2410           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2411         .
     2412       end.
     2413       for each buf_temp-diasize-handle
     2414       :
     2415         delete buf_temp-diasize-handle .
     2416       end.
     2417       assign
     2418         v-field-group-handle = frame Dialog-Frame :first-child
     2419       .
     2420       do while valid-handle(v-field-group-handle)
     2421       :
     2422         assign
     2423           v-object-handle = v-field-group-handle :first-child
     2424         .
     2425         do while valid-handle(v-object-handle)
     2426         :
     2427           if  v-object-handle <> v-diasize-browse-handle :handle
     2428           and v-object-handle <> v-diasize-resize-button
     2429           and can-query(v-object-handle, "row")
     2430           and can-query(v-object-handle, "height")
     2431           and ( v-object-handle :col + v-object-handle :width
     2432                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2433               )
     2434           then do:
     2435             find first buf_temp-browse-handle
     2436               where buf_temp-browse-handle.browse-type   = 'width':u
     2437                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2438               no-error .
     2439             if available buf_temp-browse-handle
     2440             then do:
     2441             end.
     2442             else do:
     2443               create buf_temp-diasize-handle .
     2444               assign
     2445                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2446                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2447               .
     2448             end.
     2449           end.
     2450           assign
     2451             v-object-handle = v-object-handle :next-sibling
     2452           .
     2453         end.
     2454         assign
     2455           v-field-group-handle = v-field-group-handle :next-sibling
     2456         .
     2457       end.
     2458       do with frame Dialog-Frame
     2459       :
     2460         hide v-diasize-resize-button .
     2461         v-diasize-resize-button :row = 1.
     2462         v-diasize-resize-button :column = 1.
     2463       end.
     2464       if p-change-value > 0
     2465       then do:
     2466         if frame Dialog-Frame :scrollable = true
     2467         then do:
     2468           assign
     2469             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2470             no-error .
     2471           if error-status :error
     2472           or error-status :get-message(1) <> ""
     2473           then do:
     2474             undo move_block, retry move_block.
     2475           end.
     2476         end.
     2477         assign
     2478           frame Dialog-Frame :width = v-frame-width + p-change-value
     2479           no-error .
     2480         if error-status :error
     2481         or error-status :get-message(1) <> ""
     2482         then do:
     2483           undo move_block, retry move_block.
     2484         end.
     2485         assign
     2486           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2487         no-error .
     2488         if error-status :error
     2489         or error-status :get-message(1) <> ""
     2490         then do:
     2491           undo move_block, retry move_block.
     2492         end.
     2493         for each buf_temp-browse-handle
     2494           where buf_temp-browse-handle.browse-type = 'width':u
     2495         on error undo move_block, retry move_block
     2496         :
     2497           assign
     2498             buf_temp-browse-handle.browse-handle :width
     2499               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2500             no-error .
     2501           if error-status :error
     2502           or error-status :get-message(1) <> ""
     2503           then do:
     2504             undo move_block, retry move_block .
     2505           end.
     2506         end.
     2507         for each buf_temp-diasize-handle
     2508         on error undo move_block, retry move_block
     2509         :
     2510           assign
     2511             v-object-handle = buf_temp-diasize-handle.handle-value
     2512           .
     2513           if v-object-handle <> v-diasize-resize-button
     2514           then do:
     2515             assign
     2516               v-object-handle :col = v-object-handle :col + p-change-value
     2517               no-error .
     2518             if error-status :error
     2519             or error-status :get-message(1) <> ""
     2520             then do:
     2521               undo move_block, retry move_block .
     2522             end.
     2523           end.
     2524         end.
     2525       end.
     2526       else do:
     2527         for each buf_temp-diasize-handle
     2528         on error undo move_block, retry move_block
     2529         :
     2530           assign
     2531             v-object-handle = buf_temp-diasize-handle.handle-value
     2532           .
     2533           if v-object-handle <> v-diasize-resize-button
     2534           then do:
     2535             assign
     2536               v-object-handle :col = v-object-handle :col + p-change-value
     2537               no-error .
     2538             if error-status :error
     2539             or error-status :get-message(1) <> ""
     2540             then do:
     2541               undo move_block, retry move_block .
     2542             end.
     2543           end.
     2544         end.
     2545         for each buf_temp-browse-handle
     2546           where buf_temp-browse-handle.browse-type = 'width':u
     2547         on error undo move_block, retry move_block
     2548         :
     2549           assign
     2550             buf_temp-browse-handle.browse-handle :width
     2551               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2552             no-error .
     2553           if error-status :error
     2554           or error-status :get-message(1) <> ""
     2555           then do:
     2556             undo move_block, retry move_block .
     2557           end.
     2558         end.
     2559         assign
     2560           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2561           no-error .
     2562         if error-status :error
     2563         or error-status :get-message(1) <> ""
     2564         then do:
     2565           undo move_block, retry move_block.
     2566         end.
     2567         assign
     2568           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2569         no-error .
     2570         if error-status :error
     2571         or error-status :get-message(1) <> ""
     2572         then do:
     2573           undo move_block, retry move_block.
     2574         end.
     2575         if frame Dialog-Frame :scrollable = true
     2576         then do:
     2577           assign
     2578             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2579           no-error .
     2580           if error-status :error
     2581           or error-status :get-message(1) <> ""
     2582           then do:
     2583             undo move_block, retry move_block.
     2584           end.
     2585         end.
     2586       end.
     2587       if p-move-resize
     2588       then do:
     2589         run diasize_position-resize-button in this-procedure .
     2590       end.
     2591       if v-diasize-wndstore = true
     2592       then do:
     2593         if connected("ub") = true
     2594         then do:
     2595           define variable v-cntxt-db-num        as integer   no-undo .
     2596           define variable v-cntxt-userid        as character no-undo .
     2597           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2598                                             , OUTPUT v-cntxt-userid
     2599                                             ) .
     2600           run gbl/wndsizew.p
     2601             (input  v-cntxt-db-num
     2602             ,input  v-cntxt-userid
     2603             ,input  v-diasize-proc-name
     2604             ,input  'width':u
     2605             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2606             ) .
     2607         end.
     2608       end.
     2609     end.
     2610     assign
     2611       v-diasize-change-size = false
     2612     .
     2613   end procedure.
     2614   procedure diasize_set-width :
     2615     define input  parameter p-new-width  as decimal   no-undo .
     2616     define input  parameter p-move-resize as logical   no-undo .
     2617     do
     2618     on error undo, return error return-value
     2619     :
     2620       run diasize_change-width in this-procedure
     2621         (input  (p-new-width - frame Dialog-Frame :width)
     2622         ,input  p-move-resize
     2623         ) .
     2624     end.
     2625   end procedure.
     2626   procedure diasize_position-resize-button :
     2627     do with frame Dialog-Frame
     2628     :
     2629       hide v-diasize-resize-button .
     2630       assign
     2631         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2632                     - 1
     2633                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2634         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2635                     - 1
     2636                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2637       .
     2638       view v-diasize-resize-button .
     2639     end.
     2640   end procedure.
     2641   on alt-right anywhere
     2642   do:
     2643     run diasize_change-width in this-procedure
     2644       (input 1
     2645       ,input true
     2646       ) .
     2647     return no-apply .
     2648   end.
     2649   on alt-left anywhere
     2650   do:
     2651     run diasize_change-width in this-procedure
     2652       (input -1
     2653       ,input true
     2654       ) .
     2655     return no-apply .
     2656   end.
     2657   on alt-down anywhere
     2658   do:
     2659     run diasize_change-height in this-procedure
     2660       (input 1
     2661       ,input true
     2662       ) .
     2663     return no-apply .
     2664   end.
     2665   on alt-up anywhere
     2666   do:
     2667     run diasize_change-height in this-procedure
     2668       (input -1
     2669       ,input true
     2670       ) .
     2671     return no-apply .
     2672   end.
     2673   on alt-enter of frame Dialog-Frame
     2674   do:
     2675     run diasize_maximize in this-procedure
     2676       (input  ?
     2677       ).
     2678     return no-apply .
     2679   end.
     2680   procedure diasize_end-move :
     2681     do
     2682     on error undo, return error return-value
     2683     :
     2684       define variable v-row-delta as decimal   no-undo .
     2685       define variable v-col-delta as decimal   no-undo .
     2686       define variable v-new-row as decimal   no-undo .
     2687       define variable v-new-col as decimal   no-undo .
     2688       assign
     2689         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2690         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2691       .
     2692       assign
     2693         v-row-delta = v-new-row - frame Dialog-Frame :height
     2694         v-col-delta = v-new-col - frame Dialog-Frame :width
     2695       .
     2696       run diasize_change-height in this-procedure
     2697         (input v-row-delta
     2698         ,input true
     2699         ) .
     2700       run diasize_change-width in this-procedure
     2701         (input v-col-delta
     2702         ,input true
     2703         ) .
     2704     end.
     2705   end procedure.
     2706   procedure diasize_maximize :
     2707     define input  parameter p-action as logical   no-undo .
     2708     do
     2709     on error undo, return error return-value
     2710     :
     2711       if p-action = ?
     2712       then do:
     2713         if v-diasize-need-maximize = true
     2714         then do:
     2715           assign
     2716             p-action = true
     2717           .
     2718         end.
     2719         else do:
     2720           assign
     2721             p-action = false
     2722           .
     2723         end.
     2724       end.
     2725       if p-action = true
     2726       then do:
     2727         run diasize_change-height in this-procedure
     2728           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2729               - frame Dialog-Frame :height-chars
     2730           ,input true
     2731           ) .
     2732         run diasize_change-width in this-procedure
     2733           (input session :width-chars
     2734               - frame Dialog-Frame :width-chars
     2735           ,input true
     2736           ) .
     2737         assign
     2738           v-diasize-need-maximize = false
     2739         .
     2740       end.
     2741       else do:
     2742         run diasize_change-width in this-procedure
     2743           (input v-diasize-orig-frame-width
     2744               - frame Dialog-Frame :width-chars
     2745           ,input true
     2746           ) .
     2747         run diasize_change-height in this-procedure
     2748           (input v-diasize-orig-frame-height
     2749               - frame Dialog-Frame :height-chars
     2750           ,input true
     2751           ) .
     2752         assign
     2753           v-diasize-need-maximize = true
     2754         .
     2755       end.
     2756     end.
     2757   end procedure.
     2758   procedure diasize_restore-orig-size :
     2759     do
     2760     on error undo, return error return-value
     2761     :
     2762       assign
     2763         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2764         v-diasize-current-frame-height = frame Dialog-Frame :height
     2765       .
     2766       run diasize_set-height in this-procedure
     2767         (input  v-diasize-orig-frame-height
     2768         ,input  true
     2769         ) .
     2770       run diasize_set-width in this-procedure
     2771         (input  v-diasize-orig-frame-width
     2772         ,input  true
     2773         ) .
     2774     end.
     2775   end procedure.
     2776   procedure diasize_restore-current-size :
     2777     do
     2778     on error undo, return error return-value
     2779     :
     2780       run diasize_set-height in this-procedure
     2781         (input  v-diasize-current-frame-height
     2782         ,input  true
     2783         ) .
     2784       run diasize_set-width in this-procedure
     2785         (input  v-diasize-current-frame-width
     2786         ,input  true
     2787         ) .
     2788     end.
     2789   end procedure.
     2790   procedure diasize_set-browse-handle :
     2791     define input  parameter p-browse-handle as handle   no-undo .
     2792     define buffer buf_temp-browse-handle for temp-browse-handle .
     2793     do
     2794     on error undo, return error return-value
     2795     :
     2796       assign
     2797         v-diasize-browse-handle = p-browse-handle
     2798       .
     2799       for each buf_temp-browse-handle
     2800       on error undo, return error return-value
     2801       :
     2802         delete buf_temp-browse-handle .
     2803       end.
     2804     end.
     2805   end procedure.
     2806   procedure diasize_add_browse :
     2807     define input  parameter p-browse-type   as character no-undo .
     2808     define input  parameter p-browse-handle as handle    no-undo .
     2809     define buffer buf_temp-browse-handle for temp-browse-handle .
     2810     do
     2811     on error undo, return error return-value
     2812     :
     2813       assign
     2814         v-diasize-browse-number = v-diasize-browse-number + 1
     2815       .
     2816       create buf_temp-browse-handle .
     2817       assign
     2818         buf_temp-browse-handle.browse-type   = p-browse-type
     2819         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2820         buf_temp-browse-handle.browse-handle = p-browse-handle
     2821       .
     2822     end.
     2823   end procedure.
     2824   procedure diasize_init :
     2825     define variable v-default-value    as logical   no-undo .
     2826     define variable v-restore-saved    as logical   no-undo .
     2827     define variable v-resize-value-str as character no-undo .
     2828     do
     2829     on error undo, return error return-value
     2830     :
     2831       do with frame Dialog-Frame
     2832       :
     2833         assign
     2834           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2835           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2836           v-diasize-browse-handle     = browse br-cwthobj :handle
     2837         .
     2838         create button v-diasize-resize-button
     2839         assign
     2840           parent        = frame Dialog-Frame :first-child
     2841           label         = "s"
     2842           height-pixels = 16
     2843           width-pixels  = 16
     2844           visible       = true
     2845           sensitive     = true
     2846           movable       = true
     2847           triggers:
     2848             on end-move persistent run diasize_end-move in this-procedure .
     2849           end triggers.
     2850         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2851         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2852         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2853         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2854         assign
     2855           v-diasize-wndmax = false
     2856         .
     2857         if connected("ub") = true
     2858         then do:
     2859           define variable v-cntxt-db-num        as integer   no-undo .
     2860           define variable v-cntxt-userid        as character no-undo .
     2861           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2862                                             , OUTPUT v-cntxt-userid
     2863                                             ) .
     2864           run gbl/wndpar_r.p
     2865             (input  v-cntxt-db-num
     2866             ,input  v-cntxt-userid
     2867             ,input  'wndmax':U
     2868             ,output v-diasize-wndmax
     2869             ,output v-default-value
     2870             ) .
     2871         end.
     2872         assign
     2873           v-diasize-wndstore = false
     2874         .
     2875         if connected("ub") = true
     2876         then do:
     2877           run gbl/wndpar_r.p
     2878             (input  v-cntxt-db-num
     2879             ,input  v-cntxt-userid
     2880             ,input  'wndstore':U
     2881             ,output v-diasize-wndstore
     2882             ,output v-default-value
     2883             ) .
     2884         end.
     2885         assign
     2886           v-diasize-proc-name = entry(1, program-name(2), '.')
     2887         .
     2888         if v-diasize-wndstore = true
     2889         then do:
     2890           assign
     2891             v-restore-saved = false
     2892           .
     2893           if connected("ub") = true
     2894           then do:
     2895             run gbl/wndsizer.p
     2896               (input  v-cntxt-db-num
     2897               ,input  v-cntxt-userid
     2898               ,input  v-diasize-proc-name
     2899               ,input  'height':u
     2900               ,output v-resize-value-str
     2901               ) .
     2902             if v-resize-value-str <> '':U
     2903             then do:
     2904               run diasize_change-height in this-procedure
     2905                 (input  integer(v-resize-value-str)
     2906                 ,input  true
     2907                 ) .
     2908               assign
     2909                 v-restore-saved = true
     2910               .
     2911             end.
     2912           end.
     2913           if connected("ub") = true
     2914           then do:
     2915             run gbl/wndsizer.p
     2916               (input  v-cntxt-db-num
     2917               ,input  v-cntxt-userid
     2918               ,input  v-diasize-proc-name
     2919               ,input  'width':u
     2920               ,output v-resize-value-str
     2921               ) .
     2922             if v-resize-value-str <> '':U
     2923             then do:
     2924               run diasize_change-width in this-procedure
     2925                 (input  integer(v-resize-value-str)
     2926                 ,input  true
     2927                 ) .
     2928               assign
     2929                 v-restore-saved = true
     2930               .
     2931             end.
     2932           end.
     2933           if v-restore-saved <> true
     2934           then do:
     2935             if v-diasize-wndmax = true
     2936             then do:
     2937               run diasize_maximize in this-procedure
     2938                 (input  true
     2939                 ) .
     2940             end.
     2941           end.
     2942         end.
     2943         else do:
     2944           if v-diasize-wndmax = true
     2945           then do:
     2946             run diasize_maximize in this-procedure
     2947               (input  true
     2948               ) .
     2949           end.
     2950         end.
     2951       end.
     2952     end.
     2953   end procedure.
     2954   procedure diasize_need-full-display :
     2955     define output parameter p-need-full-display as logical   no-undo .
     2956     do
     2957     on error undo, return error return-value
     2958     :
     2959       assign
     2960         p-need-full-display = v-diasize-need-full-display
     2961       .
     2962       assign
     2963         v-diasize-need-full-display = false
     2964       .
     2965     end.
     2966   end procedure.
     2967   procedure get-context :
     2968      define output parameter p-db-num as integer          no-undo.
     2969      define output parameter p-user-id as character        no-undo.
     2970      define variable v-login               as character    no-undo.
     2971      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2972      define buffer buf_user-login  for ub.user-login .
     2973      do
     2974      on error undo, return error
     2975      :
     2976            FIND FIRST buf_sys-ctrl no-lock.
     2977            ASSIGN
     2978               v-login = USERID("ub")
     2979               p-db-num = buf_sys-ctrl.db-num
     2980            .
     2981            FIND FIRST buf_user-login
     2982                 WHERE buf_user-login.db-num = p-db-num
     2983                   AND buf_user-login.user-login = v-login
     2984                 no-lock
     2985                 no-error
     2986                 .
     2987            IF AVAILABLE buf_user-login
     2988            THEN DO:
     2989               assign
     2990                  p-user-id = buf_user-login.user-id
     2991               .
     2992            END.
     2993      end.
     2994   end procedure.
     2995   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2996   on f5 of frame Dialog-Frame anywhere
     2997   do:
