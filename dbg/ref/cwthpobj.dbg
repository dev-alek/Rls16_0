     3244   def var sort-labelbr-cwthobj   as character no-undo .
     3245   def var sort-clmnbr-cwthobj    as handle    no-undo .
     3246   def var cur-clmnbr-cwthobj     as handle    no-undo .
     3247   def var cur-clmn-locbr-cwthobj as integer   no-undo .
     3248   def var re-querybr-cwthobj     as logical   initial no no-undo .
     3249   on start-search, ctrl-o of br-cwthobj in frame Dialog-Frame do:
     3250      run sort-brbr-cwthobj
     3251        (input (if available X_c-wth-pobj
     3252                then recid(X_c-wth-pobj)
     3253                else ?
     3254               )
     3255        ).
     3256   end.
     3257   PROCEDURE sort-brbr-cwthobj :
     3258     define input parameter p-recid as recid no-undo .
     3259     if re-querybr-cwthobj = no then do:
     3260       assign
     3261          cur-clmnbr-cwthobj = br-cwthobj:current-column in frame Dialog-Frame
     3262       .
     3263       if sort-clmnbr-cwthobj <> ? then sort-clmnbr-cwthobj:column-fgcolor = 0.
     3264       if cur-clmnbr-cwthobj = sort-clmnbr-cwthobj then do:
     3265         assign
     3266            sort-labelbr-cwthobj = ""
     3267            sort-clmnbr-cwthobj = ?
     3268         .
     3269        end.
     3270        else do:
     3271          assign
     3272            sort-labelbr-cwthobj = cur-clmnbr-cwthobj:label
     3273            sort-clmnbr-cwthobj  = cur-clmnbr-cwthobj
     3274            sort-clmnbr-cwthobj:column-fgcolor = 4
     3275          .
     3276        end.
     3277      end.
     3278     assign
     3279       cur-clmn-locbr-cwthobj = 1
     3280     .
     3281     def var column-handle as handle no-undo .
     3282     column-handle = br-cwthobj:first-column.
     3283     do while valid-handle(column-handle) :
     3284       if column-handle = cur-clmnbr-cwthobj then do:
     3285         leave .
     3286       end.
     3287       column-handle = column-handle:NEXT-COLUMN.
     3288       assign
     3289         cur-clmn-locbr-cwthobj = cur-clmn-locbr-cwthobj + 1
     3290       .
     3291     end.
     3292     case sort-labelbr-cwthobj:
     3293           when X_c-wth-pobj.wth-code:label in browse br-cwthobj then DO:    assign       sort-column-name = "X_c-wth-pobj.wth-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3294           when X_c-wth-pobj.corr-date:label in browse br-cwthobj then DO:    assign       sort-column-name = "X_c-wth-pobj.corr-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3295           when X_c-wth-pobj.corr-user-db-num:label in browse br-cwthobj then DO:    assign       sort-column-name = "X_c-wth-pobj.corr-user-db-num"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3296       otherwise do:
     3297         assign
     3298           sort-column-name = ""
     3299         .
     3300         run OpenBr in this-procedure ( input yes, input no, input '':U).
     3301           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-cwthobj') then do:
     3302             run mv-brw-defaultbr-cwthobj.
     3303           end.
     3304         if sort-labelbr-cwthobj <> "" then do:
     3305           assign
     3306             cur-clmnbr-cwthobj:column-fgcolor = 0
     3307           .
     3308         end.
     3309         assign
     3310           cur-clmn-locbr-cwthobj = ?
     3311         .
     3312       end.
     3313     end case.
     3314       if cur-clmn-locbr-cwthobj <> ? then do:
     3315         if can-do( this-procedure:internal-entries, 'ch-clmnbr-cwthobj') then do:
     3316           run ch-clmnbr-cwthobj in this-procedure (cur-clmn-locbr-cwthobj).
     3317         end.
     3318       end.
     3319     if p-recid <> ? then do:
     3320       reposition br-cwthobj to recid p-recid no-error.
     3321       apply "value-changed" to br-cwthobj in frame Dialog-Frame.
     3322     end.
     3323     apply "entry" to br-cwthobj in frame Dialog-Frame.
     3324   END PROCEDURE.
     3325   procedure re-open-query-srt-clmnbr-cwthobj:
     3326   if cur-clmnbr-cwthobj = ? then do:
     3327      run OpenBr in this-procedure ( input yes, input no, input '':U).
     3328   end.
     3329   else do:
     3330      assign re-querybr-cwthobj = yes.
     3331      run sort-brbr-cwthobj
     3332        (input (if available X_c-wth-pobj
     3333                then recid(X_c-wth-pobj)
     3334                else ?
     3335               )
     3336        ).
     3337      assign re-querybr-cwthobj = no.
     3338   end.
     3339   end.
     3340   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3341   do:
     3342     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3343   end.
     3344   MAIN-BLOCK:
     3345   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3346      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3347      if p-mode <> 'все':U
     3348    and p-mode <> "one":U
     3349    and p-mode <> 'объект':U
     3350    and p-mode <> 'place':U
     3351     then dO:
     3352       message
     3353       vss-workfile vss-revision vss-description skip
     3354       "Неверное значение параметров вызова p-mode"
     3355       p-mode
     3356       view-as alert-box ERROR.
     3357       return.
     3358    end.
     3359    if p-mode = 'объект':U
     3360    then do:
     3361     find first X_clients no-lock where
     3362                   X_clients.obj-type = p-obj-type
     3363               and X_clients.obj-code = p-obj-code no-error.
     3364       if not available X_clients then do:
     3365           message
     3366           vss-workfile vss-revision vss-description skip
     3367           "Неверное значение параметра вызова p-obj-type/p-obj-code"
     3368           p-obj-type p-obj-code
     3369           view-as alert-box ERROR.
     3370           return.
     3371       end.
     3372   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3373   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3374     (input  p-obj-type
     3375     ,input  p-obj-code
     3376     ,output v-host-code
     3377     )  .
     3378    end.
     3379    if p-mode = 'place'
     3380    or p-mode = 'one' then do:
     3381     find first X_wth-place no-lock where
     3382                X_wth-place.obj-type = p-obj-type
     3383            AND  X_wth-place.obj-code = p-obj-code
     3384            AND  X_wth-place.w-p-code = p-w-p-code no-error.
     3385       if not available X_wth-place then do:
     3386           message
     3387           vss-workfile vss-revision vss-description skip
     3388           "Неверное значение параметра вызова p-w-p-code" p-w-p-code
     3389           view-as alert-box ERROR.
     3390           return.
     3391       end.
     3392    end.
     3393    if p-mode = "one":U
     3394     then do:
     3395     find first X_wealth no-lock where
     3396               X_wealth.wth-code = p-wth-code no-error.
     3397       if not available X_wealth then do:
     3398           message
     3399           vss-workfile vss-revision vss-description skip
     3400           "Неверное значение параметра вызова p-wth-code" p-wth-code
     3401           view-as alert-box ERROR.
     3402           return.
     3403       end.
     3404     end.
     3405     v-rid-list = p-rid-list.
     3406     if v-rid-list <> "" then do:
     3407         FIND FIRST find_c-wth-pobj No-LOCK where
     3408                    recid(find_c-wth-pobj) = integer(entry(1, v-rid-list)) No-ERROR.
     3409         if not avail find_c-wth-pobj then do:
     3410           message
     3411           vss-workfile vss-revision vss-description skip
     3412           "Неверное значение параметра вызова v-rid-list" v-rid-list
     3413           view-as alert-box error .
     3414           return error.
     3415         end.
     3416         v-doc-rec = integer(entry(1, v-rid-list)).
     3417       end.
     3418   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3419   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3420     (output v-db-num
     3421     )  .
     3422     if p-mode <> 'все':U then do:
     3423       assign
     3424       v-find = yes.
     3425     end.
     3426     else do:
     3427       if p-mode = 'place' then do:
     3428         assign
     3429         v-w-p-name = get-wp(p-obj-type, p-obj-code, p-w-p-code)
     3430         .
     3431       end.
     3432       else do:
     3433         assign
     3434         v-wth-name = get-wealth(p-wth-code)
     3435         .
