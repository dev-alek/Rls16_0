        1   DEFINE BUFFER find_c-wth-pobj FOR ub.c-wth-pobj.
        2   DEFINE BUFFER X_c-wth-pobj FOR ub.c-wth-pobj.
        3   DEFINE BUFFER X_clients FOR ub.clients.
        4   DEFINE BUFFER X_curr-sysconf FOR ub.sysconf.
        5   DEFINE BUFFER X_sysconf FOR ub.sysconf.
        6   DEFINE BUFFER X_wealth FOR ub.wealth.
        7   DEFINE BUFFER X_wth-place FOR ub.wth-place.
        8   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        9   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo.
       10   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo.
       11   define input parameter bttns  as char   no-undo .
       12   define input parameter p-mode  as char   no-undo .
       13   define input parameter p-obj-type like ub.c-wth-pobj.obj-type no-undo.
       14   define input parameter p-obj-code like ub.c-wth-pobj.obj-code no-undo.
       15   define input parameter p-w-p-code  like ub.c-wth-pobj.w-p-code no-undo .
       16   define input parameter p-wth-code  like ub.c-wth-pobj.wth-code no-undo .
       17   define input-output param p-rid-list    as  char no-undo .
       18   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       19   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       20   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       21   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       22   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       23   define variable vss-description AS CHAR NO-UNDO INIT "Список истории остатков МЦ на МХ":U.
       24   procedure vss-get-info :
       25     define output parameter p-vss-revision    like vss-revision    no-undo .
       26     define output parameter p-vss-author      like vss-author      no-undo .
       27     define output parameter p-vss-date        like vss-date        no-undo .
       28     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       29     define output parameter p-vss-archive     like vss-archive     no-undo .
       30     define output parameter p-vss-description like vss-description no-undo .
       31     assign
       32       p-vss-revision    = vss-revision
       33       p-vss-author      = vss-author
       34       p-vss-date        = vss-date
       35       p-vss-workfile    = vss-workfile
       36       p-vss-archive     = vss-archive
       37       p-vss-description = vss-description
       38     .
       39   end procedure.
       40   procedure vss-get-parameters :
       41     define output parameter p-vss-parameters as character no-undo .
       42   end procedure.
       43   define new global shared variable g#vssrevis-logger as handle    no-undo .
       44   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       45   define variable v-vssrevis-logger                   as handle    no-undo .
       46   procedure vss-logevent :
       47     define input  parameter p-extra-paramters as character no-undo .
       48     define variable v-vssrevis-parameters as character no-undo .
       49     do
       50     on error undo, return error return-value
       51     :
       52       if  valid-handle(v-vssrevis-logger)
       53       and v-vssrevis-logger :get-signature("logevent") <> ""
       54       then do:
       55         run vss-get-parameters in this-procedure
       56           (output v-vssrevis-parameters
       57           ).
       58         run logevent in v-vssrevis-logger
       59           (input vss-workfile
       60           ,input vss-revision
       61           ,input v-vssrevis-parameters
       62           ,input p-extra-paramters
       63           ).
       64       end.
       65     end.
       66   end procedure.
       67   assign
       68     v-vssrevis-logger = g#vssrevis-logger
       69   .
       70   if  valid-handle(v-vssrevis-logger)
       71   and v-vssrevis-logger :get-signature("logevent") <> ""
       72   then do:
       73     assign
       74       v-vssrevis-logevent = true
       75     .
       76     run vss-logevent in this-procedure (input vss-description) .
       77   end.
       78   define new global shared variable g#language as character no-undo .
       79   if g#language <> '' and g#language <> 'rus':U then do:
       80     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       81   end.
       82   define new global shared variable g#library  as handle no-undo .
       83   define new global shared variable g#library2 as handle no-undo .
       84   procedure proc-alt-shift-f2:
       85     if not ibs.th.gbl.gbl-var:rcode
       86   then
       87     run gbl\inidebug.p .
       88   end.
       89   procedure proc-alt-shift-f3:
       90     run gbl/prvssinf.p
       91       ( input this-procedure
       92       ) .
       93   end.
       94   define variable v-inform-launched as logical no-undo initial false .
       95   procedure proc-alt-shift-f4:
       96     define variable v-action as character no-undo .
       97     if v-inform-launched = false then do:
       98       assign
       99         v-inform-launched = true
      100       .
      101       run gbl/d-inform.w
      102         (  input self
      103         ,  input this-procedure
      104         , output v-action
      105         ) no-error .
      106       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      107       assign
      108         v-inform-launched = false
      109       .
      110     end.
      111   end.
      112   procedure proc-alt-f1:
      113     run gbl/corrhelp.p
      114       (input this-procedure
      115       ) .
      116   end .
