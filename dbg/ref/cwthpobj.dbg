     4403   PROCEDURE proc-b-print :
     4404   define variable date_string     as      char    no-undo.
     4405   define variable Line                as      char    no-undo.
     4406   define variable for-time as char.
     4407   define variable accum-count as integer.
     4408   define variable v-doc-rec as recid no-undo.
     4409   define variable v-prod as character no-undo .
     4410   define variable v-upd-time as character no-undo .
     4411   define variable v-obj as character no-undo .
     4412   define variable v-action-chr as character no-undo .
     4413   define variable v-source-type as character no-undo .
     4414   DEFINE VARIABLE v-for-user-name AS CHARACTER NO-UNDO.
     4415   DEFINE FRAME HistoryList
     4416   X_c-wth-pobj.wth-code COLUMN-LABEL "Код МЦ"
     4417   X_c-wth-pobj.w-p-code COLUMN-LABEL "Код МХ МЦ"
     4418   v-action-chr FORMAT "X(10)" COLUMn-LABEL "Действие"
     4419   v-wth-name COLUMN-LABEL "Назв. МЦ" FORMAT "X(20)"
     4420   v-w-p-name COLUMN-LABEL "Назв. МХ МЦ" FORMAT "X(20)"
     4421   v-source-type COLUMn-LABEL "Источн.!измен"
     4422   X_c-wth-pobj.source-ref COLUMn-LABEL "№"
     4423   X_c-wth-pobj.corr-date
     4424   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     4425   v-for-user-name COLUMN-LABEL "Изменил" FORMAT "X(18)"
     4426   X_c-wth-pobj.corr-user-db-num
     4427   v-obj COLUMN-LABEL "Объект" FORMAT "X(8)"
     4428   HEADER  date_string AT 5 format "X(35)"
     4429   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     4430   Line format "X(195)" AT 1
     4431   with width 232 down stream-io use-text    .
     4432   Line = fill("-", 195).
     4433   date_string = cur-time-print() .
     4434   assign
     4435   v-doc-rec = recid( X_c-wth-pobj ).
     4436   DO WHILE available X_c-wth-pobj :
     4437         GET prev br-cwthobj.
     4438   END.
     4439   run prn-lib-open-stream  in this-procedure (
     4440                                                input parparentProc
     4441                                               ,input 43
     4442                                               ,input yes
     4443                                               ,input no
     4444                                               ).
     4445   PUT  STREAM PrnLibStream
     4446   SPACE(25) ( frame Dialog-Frame:title )
     4447   format "x(90)" SKIP(1) .
     4448   FORM HEADER
     4449   Line format "X(180)" AT 1 SKIP
     4450   "Продолжение - на следующей странице" AT 30 SKIP
     4451   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4452   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4453   FORM with FRAME HistoryList  .
     4454   run waitfram-show in this-procedure ("Ждите...").
     4455     GET next br-cwthobj.
     4456       DO WHILE available X_c-wth-pobj :
     4457         Display STREAM PrnLibStream
     4458         X_c-wth-pobj.wth-code
     4459         X_c-wth-pobj.w-p-code
     4460         get-action(X_c-wth-pobj.action-type) @ v-action-chr
     4461         (if v-find and p-mode <> 'place':U then get-wealth(X_c-wth-pobj.wth-code) else "":U )
     4462         @ v-wth-name
     4463         (if v-find then get-wp(X_c-wth-pobj.obj-type, X_c-wth-pobj.obj-code, X_c-wth-pobj.w-p-code) else "":U )
     4464         @ v-w-p-name
     4465         get-source-type(X_c-wth-pobj.source-type) @ v-source-type
     4466         X_c-wth-pobj.source-ref
     4467         X_c-wth-pobj.corr-date
     4468         string(X_c-wth-pobj.corr-time, "HH:MM:SS":U) @ v-upd-time
     4469         usrfulnf(X_c-wth-pobj.corr-user-name) @ v-for-user-name
     4470         X_c-wth-pobj.corr-user-db-num
     4471         X_c-wth-pobj.obj-type + string(X_c-wth-pobj.obj-code) @ v-obj
     4472         with FRAME HistoryList .
     4473     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     4474     assign
     4475     accum-count = accum-count + 1
     4476     .
     4477     GET next br-cwthobj.
     4478   END.
     4479   UNDERLINE  STREAM PrnLibStream
     4480   X_c-wth-pobj.wth-code
     4481   X_c-wth-pobj.w-p-code
     4482   v-action-chr
     4483   v-wth-name
     4484   v-w-p-name
     4485   v-source-type
     4486   X_c-wth-pobj.source-ref
     4487   X_c-wth-pobj.corr-date
     4488   v-upd-time
     4489   v-for-user-name
     4490   X_c-wth-pobj.corr-user-db-num
     4491   v-obj
     4492   with FRAME HistoryList .
     4493   DISPLAY STREAM PrnLibStream
     4494   "ИТОГО"  @ X_c-wth-pobj.wth-code
     4495   string(accum-count)  @ v-action-chr
     4496   with frame HistoryList.
     4497   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4498   HIDE  STREAM PrnLibStream FRAME CheckList.
     4499   output  STREAM PrnLibStream CLOSE.
     4500   run waitfram-hide in this-procedure.
     4501   run prn-lib-prn-file in this-procedure (
     4502                                             input parparentproc
     4503                                             ,input 8
     4504                                             ).
     4505   reposition br-cwthobj to recid v-doc-rec no-error.
     4506   apply "entry" to br-cwthobj in frame Dialog-Frame.
     4507   END PROCEDURE.
     4508   PROCEDURE proc-b-sch :
     4509   assign
     4510     tbl = 'c-wth-pobj'
     4511     join-tbl = 'X_c-wth-pobj'
     4512     fld = ""
     4513     lab = ""
     4514     spr = ""
     4515     dim = '0'
     4516     .
     4517   run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', '',
     4518   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4519   run fltfield-add in this-procedure('wth-code', 'Код МЦ', '',
     4520   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4521   run fltfield-add in this-procedure('w-p-code', 'Код МХ МЦ', '',
     4522   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4523   run fltfield-add in this-procedure('corr-date', '', '',
     4524   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4525   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     4526   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4527   run fltfield-add in this-procedure('corr-user-db-num', '', '',
     4528   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4529   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     4530   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4531   run fltfield-add in this-procedure('action-type', 'Действие', 'hist-action',
     4532   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4533   run fltfield-add in this-procedure('source-type', 'Источник_измен-я', 'hist-source-type',
     4534   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4535   run fltfield-add in this-procedure('source-ref', '', '',
     4536   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4537   Filter-Block:
     4538   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4539       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4540       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4541     run gbl/filter.w ( INPUT parparentproc
     4542                       ,INPUT (filter-point + chr(4) + filter-label + chr(4) + 'yes':U)
     4543                       ,INPUT tbl
     4544                       ,INPUT join-tbl
     4545                       ,INPUT fld
     4546                       ,INPUT lab
     4547                       ,INPUT spr
     4548                       ,INPUT dim ).
     4549     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     4550   END.
     4551   END PROCEDURE.
     4552   PROCEDURE proc-br-cwthobj :
     4553   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4554   if b-sel:sensitive in frame Dialog-Frame then dO:
     4555       if b-mark:sensitive then do:
     4556           apply "choose" to b-mark in frame Dialog-Frame.
     4557       end.
     4558       else do:
     4559           apply "choose" to b-sel in frame Dialog-Frame.
     4560       end.
     4561   end.
     4562   else do:
     4563       if b-lookup:sensitive then
     4564       apply "choose" to b-lookup in frame Dialog-Frame.
     4565   end.
     4566   END PROCEDURE.
     4567   PROCEDURE proc-find-corr-date :
     4568   define input parameter p-next as logical no-undo.
     4569   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     4570   define variable v-date-chr as character no-undo.
     4571   if p-date = ? then return .
     4572   display
     4573   0 @ sch-w-p-code
     4574   "":U @ sch-corr-user-name
     4575   '':U sch-source-ref
     4576   with frame Dialog-Frame.
     4577   assign
     4578   v-date-chr = string(day(p-date)) + chr(47) +
     4579                    string(month(p-date)) + chr(47) +
     4580                    string(year(p-date)).
     4581          run OpenBr in this-procedure
     4582           (input false
     4583           ,input true
     4584           ,input substitute("and X_c-wth-pobj.corr-date = &1 "
     4585             , v-date-chr)
     4586           ).
     4587         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     4588   END PROCEDURE.
     4589   PROCEDURE proc-find-source-ref :
     4590   define input parameter p-next as logical no-undo.
     4591   define input parameter p-user like ub.c-wth-obj.corr-user-name no-undo.
     4592   assign
     4593   sch-corr-date = ?
     4594   .
     4595   display
     4596   sch-corr-date
     4597   0 @ sch-w-p-code
     4598   '':U @ sch-corr-user-name
     4599   with frame Dialog-Frame.
     4600   p-user = chr(34) + p-user + chr(34).
     4601   run OpenBr in this-procedure
     4602       (input false
     4603       ,input p-next
     4604       ,input substitute("and X_c-wth-obj.soruce-type = 'wth-doc' and X_c-wth-obj.source-ref = &1 "
     4605         , p-user)
     4606       ).
     4607   apply "entry":u to sch-source-ref in frame Dialog-Frame .
     4608   END PROCEDURE.
     4609   PROCEDURE proc-find-user :
     4610   define input parameter p-next as logical no-undo.
     4611   define input parameter p-user like ub.c-wth-pobj.corr-user-name no-undo.
     4612   assign
     4613   sch-corr-date = ?.
     4614   display
     4615   sch-corr-date
     4616   0 @ sch-w-p-code
     4617   '':U sch-source-ref
     4618   with frame Dialog-Frame.
     4619   p-user = chr(34) + p-user + chr(34).
     4620   run OpenBr in this-procedure
     4621       (input false
     4622       ,input p-next
     4623       ,input substitute("and X_c-wth-pobj.corr-user-name = &1 "
     4624         , p-user)
     4625       ).
     4626   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     4627   END PROCEDURE.
     4628   PROCEDURE proc-find-w-p-code :
     4629   define input parameter p-next as logical no-undo.
     4630   define input parameter p-w-p-code like ub.c-wth-pobj.w-p-code no-undo.
     4631   define variable v-w-p-code as character no-undo.
     4632   assign
     4633   sch-corr-date = ?.
     4634   display
     4635   "":U @ sch-corr-user-name
     4636   sch-corr-date
     4637   '':U sch-source-ref
     4638   with frame Dialog-Frame.
     4639   assign
     4640   v-w-p-code = string(p-w-p-code).
     4641   run OpenBr in this-procedure
     4642       (input false
     4643       ,input p-next
     4644       ,input substitute("and X_c-wth-pobj.w-p-code = &1 "
     4645         , v-w-p-code)
     4646       ).
     4647   apply "entry":u to sch-w-p-code in frame Dialog-Frame .
     4648   END PROCEDURE.
     4649   PROCEDURE proc-view-changes :
     4650   for each temp-changes:
     4651       delete temp-changes.
     4652   END.
     4653   if not available X_c-wth-pobj then do:
     4654     Open QUery br-changes for each temp-changes.
     4655     return.
     4656   end.
     4657   define variable v-label-param as character no-undo .
     4658   v-label-param =
     4659     "host-code" + chr(4) + "Код фирмы" + chr(4) + "" + chr(8)
     4660    + "incass-pl" + chr(4) + "Инкассировано" + chr(4) + "" + chr(8)
     4661    + "incass-bank-pl" + chr(4) + "Инкассировано в банк" + chr(4) + "" + chr(8)
     4662    + "incass-cassa-pl" + chr(4) + "Возврат по кассе" + chr(4) + "" + chr(8)
     4663    + "incass-other-pl" + chr(4) + "Прочие инкассации" + chr(4) + "" + chr(8)
     4664    + "income-pl" + chr(4) + "Получено" + chr(4) + "" + chr(8)
     4665    + "income-cassa-pl" + chr(4) + "Выручка" + chr(4) + "" + chr(8)
     4666    + "income-other-pl" + chr(4) + "Прочие поступления" + chr(4) + "" + chr(8)
     4667    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
     4668    + "obj-type" + chr(4) + "Тип Объекта" + chr(4) + "" + chr(8)
     4669    + "wth-code" + chr(4) + "Код МЦ" + chr(4) + "" + chr(8)
     4670    + "w-p-code" + chr(4) + "Кoд МХ" + chr(4) + ""  .
     4671    run proc-full-temp-changes in this-procedure (
     4672                                                input  buffer X_c-wth-pobj:handle
     4673                                               ,input  'wth-pobj':U
     4674                                               ,input  "host-code,incass-pl,incass-bank-pl,incass-cassa-pl,incass-other-pl,income-pl,income-cassa-pl,income-other-pl,obj-code,obj-type,wth-code,w-p-code"
     4675                                               ,input  v-label-param).
     4676   define variable c-stock-1 as decimal no-undo.
     4677   define variable c-stock-2 as decimal no-undo.
     4678   define buffer buf_c-wth-pobj for ub.c-wth-pobj.
     4679   RUN c-wth-lib_cur-stock-place (
     4680                                buffer X_c-wth-pobj
     4681                               ,output c-stock-1) no-error.
     4682   find first buf_c-wth-pobj no-lock where
     4683             buf_c-wth-pobj.obj-type =  X_c-wth-pobj.obj-type
     4684         and buf_c-wth-pobj.obj-code =  X_c-wth-pobj.obj-code
     4685         and buf_c-wth-pobj.w-p-code =  X_c-wth-pobj.w-p-code
     4686         and buf_c-wth-pobj.wth-code =  X_c-wth-pobj.wth-code
     4687         and buf_c-wth-pobj.corr-user-db-num =  X_c-wth-pobj.corr-user-db-num
     4688         and buf_c-wth-pobj.chip-num > X_c-wth-pobj.chip-num no-error.
     4689   if available buf_c-wth-pobj then do:
     4690     RUN c-wth-lib_cur-stock-place (
     4691                                 buffer buf_c-wth-pobj
     4692                                 ,output c-stock-2) no-error.
     4693   end.
     4694   else do:
     4695     RUN wth-lib_cur-stock-place (
     4696                                 input X_c-wth-pobj.obj-type
     4697                                 ,input X_c-wth-pobj.obj-code
     4698                                 ,input X_c-wth-pobj.w-p-code
     4699                                 ,input X_c-wth-pobj.wth-code
     4700                                 ,output c-stock-2) no-error.
     4701   end.
     4702   create temp-changes.
     4703   assign
     4704   temp-changes.t_name = 'c-wth-pobj':U
     4705   temp-changes.f_name = ""
     4706   temp-changes.l_name = "Остаток"
     4707   temp-changes.v_old  = string(c-stock-1)
     4708   temp-changes.v_new  = string(c-stock-2)
     4709   temp-changes.num_   = 0
     4710   .
     4711   release temp-changes.
     4712   Open QUery br-changes for each temp-changes.
     4713   END PROCEDURE.
     4714   FUNCTION get-action RETURNS CHARACTER
     4715     ( p-action as character ) :
     4716   define variable dops as character no-undo.
     4717   CASE p-action:
     4718      when 'close':U then do:
     4719         return "Закр.на факт".
     4720      end.
     4721      when 'delete':U then do:
     4722         return "Удаление".
     4723      end.
     4724   END CASE.
     4725   RETURN dops.
     4726   END FUNCTION.
     4727   FUNCTION get-source-type RETURNS CHARACTER
     4728     ( p-source-type as character ) :
     4729   define variable v-dop as character no-undo .
     4730   assign
     4731   v-dop =  entry (lookup (p-source-type, ',db,esys,trn-doc,payment,fin-doc,import,recalc,wth-doc,ren-gdsc,upgrade,grp-chg,stop-list,dis-card':U), ',БД,ВС,Документ,Платеж,Фин.док.,Импорт,Пересчет,Документ МЦ,Коллизия,Апгрейд,Изм.группы,Стоплист,ДК':U) no-error
     4732   .
     4733     RETURN v-dop .
     4734   END FUNCTION.
     4735   FUNCTION get-wealth RETURNS CHARACTER
     4736     ( p-wth-code as integer ) :
     4737   define buffer buf_wealth for ub.wealth.
     4738   find first buf_wealth no-lock where
     4739        buf_wealth.wth-code = p-wth-code no-error.
     4740   if not available buf_wealth then do:
     4741       return "!!! Неизвестная МЦ!!!".
     4742   end.
     4743     RETURN buf_wealth.wth-name.
     4744   END FUNCTION.
     4745   FUNCTION get-wp RETURNS CHARACTER
     4746     ( p-obj-type as character, p-obj-code as integer, p-w-p-code as integer ) :
     4747   define buffer buf_wth-place for ub.wth-place.
     4748   find first buf_wth-place no-lock where
     4749        buf_wth-place.obj-type = p-obj-type
     4750       AND buf_wth-place.obj-code = p-obj-code
     4751      AND buf_wth-place.w-p-code = p-w-p-code no-error.
     4752   if not available buf_wth-place then do:
     4753       return "!!! Неизвестное МХ!!!".
     4754   end.
     4755     RETURN buf_wth-place.w-p-name.
     4756   END FUNCTION.
