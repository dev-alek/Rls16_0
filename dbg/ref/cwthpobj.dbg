      862   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      863   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      864   procedure fltopend_fltopend :
      865   define input parameter p-parent-handle as handle no-undo .
      866   define input parameter p-qh as handle no-undo .
      867   define input parameter p-flt-open-open-query  as character no-undo .
      868   define input parameter p-where-cond as character no-undo .
      869   define input parameter p-use-indFIRST-query-tail as character no-undo .
      870   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      871   define input parameter p-indexed-reposition as character no-undo .
      872     do
      873     on error undo, return error
      874     :
      875   define variable v-prepare-string as character no-undo .
      876   define variable glog as logical no-undo .
      877   assign
      878   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      879                      p-where-cond + chr(32)  +
      880                      p-use-indFIRST-query-tail + chr(32) +
      881                      p-use-ind-sort-clmn-by + chr(32) +
      882                      p-indexed-reposition
      883   .
      884   assign
      885   glog = p-qh:query-prepare(v-prepare-string) no-error .
      886   if not glog
      887   or error-status:error then do:
      888     message error-status:get-message(1) view-as alert-box .
      889     undo, return error .
      890   end.
      891   assign
      892   glog = p-qh:query-open no-error .
      893   if not glog
      894   or error-status:error then do:
      895     message error-status:get-message(1) view-as alert-box .
      896     undo, return error .
      897   end.
      898     end.
      899   end procedure.
      900   procedure fltopend_fltfindd :
      901   define input parameter p-parent-handle as handle no-undo .
      902   define input parameter p-qh as handle no-undo .
      903   define input parameter p-rowid as rowid no-undo .
      904   define input parameter p-next as logical no-undo .
      905   define input parameter p-lock as integer no-undo .
      906   define input parameter p-bh as handle no-undo .
      907   define input parameter p-where-cond as character no-undo .
      908   define input parameter p-use-index-phrase as character no-undo .
      909   define variable glog as logical no-undo .
      910   define variable v-qh as handle no-undo .
      911   define variable v-bh as handle no-undo .
      912   define variable v-recid as recid no-undo .
      913   define variable v-prepare-string as character no-undo .
      914   do
      915   on error undo, return error
      916   on stop undo, return error
      917   :
      918     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      919     create buffer v-bh for table p-bh buffer-name p-bh:name.
      920     create query v-qh.
      921     v-qh:set-buffers(v-bh).
      922     v-prepare-string = substitute("for each &1 &2 &3"
      923                                     ,v-bh:name
      924                                     ,p-where-cond
      925                                     ,p-use-index-phrase).
      926     glog = v-qh:query-prepare(v-prepare-string) no-error.
      927     if not glog then do:
      928       delete object v-qh.
      929       delete object v-bh.
      930       undo, return error .
      931     end.
      932     glog = v-qh:query-open no-error .
      933     if not glog then do:
      934       delete object v-qh.
      935       delete object v-bh.
      936       undo, return error .
      937     end.
      938     if p-next then do:
      939       v-qh:reposition-to-rowid(p-rowid) no-error .
      940       glog = v-qh:get-next( p-lock) no-error .
      941       glog = v-qh:get-next( p-lock) no-error .
      942       if not glog or v-qh:query-off-end = yes then do:
      943         glog = v-qh:get-first( p-lock) no-error .
      944       end.
      945     end.
      946     else do:
      947       glog = v-qh:get-first( p-lock) no-error .
      948     end.
      949     v-recid = v-bh:recid no-error .
      950     delete object v-qh.
      951     delete object v-bh.
      952     return string(v-recid) .
      953   end.
      954   end procedure.
      955   procedure fltopend_fltfindq :
      956   define input parameter p-parent-handle as handle no-undo .
      957   define input parameter p-qh as handle no-undo .
      958   define input parameter p-next as logical no-undo .
      959   define input parameter p-lock as integer no-undo .
      960   define input parameter p-flt-open-open-query  as character no-undo .
      961   define input parameter p-where-cond as character no-undo .
      962   define input parameter p-use-indFIRST-query-tail as character no-undo .
      963   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      964   define input parameter p-indexed-reposition as character no-undo .
      965   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      966   define variable glog as logical no-undo .
      967   define variable v-qh as handle no-undo .
      968   define variable v-bh as handle no-undo extent 18.
      969   define variable v-rowid as rowid no-undo extent 18.
      970   define variable v-ii as integer no-undo .
      971   define variable v-prepare-string as character no-undo .
      972   do
      973   on error undo, return error
      974   on stop undo, return error
      975   :
      976     create query v-qh.
      977     do v-ii = 1 to p-qh:num-buffers:
      978       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      979       assign
      980       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      981       no-error.
      982       v-qh:add-buffer(v-bh[v-ii]).
      983     end.
      984     assign
      985     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      986                       p-where-cond + chr(32)  +
      987                       p-use-indFIRST-query-tail + chr(32) +
      988                       p-use-ind-sort-clmn-by + chr(32) +
      989                       p-indexed-reposition
      990     .
      991     glog = v-qh:query-prepare( v-prepare-string) no-error .
      992     if not glog then do:
      993       delete object v-qh.
      994       do v-ii = 1 to p-qh:num-buffers:
      995         delete object v-bh[v-ii].
      996       end.
      997       undo, return error .
      998     end.
      999     glog = v-qh:query-open no-error .
     1000     if not glog then do:
     1001       delete object v-qh.
     1002       do v-ii = 1 to p-qh:num-buffers:
     1003         delete object v-bh[v-ii].
     1004       end.
     1005       undo, return error .
     1006     end.
     1007     if p-next then do:
     1008       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1009       glog = v-qh:get-next( p-lock) no-error .
     1010       glog = v-qh:get-next( p-lock) no-error .
     1011       if not glog or v-qh:query-off-end = yes then do:
     1012         glog = v-qh:get-first( p-lock) no-error .
     1013       end.
     1014     end.
     1015     else do:
     1016       glog = v-qh:get-first( p-lock) no-error .
     1017     end.
     1018     do v-ii = 1 to p-qh:num-buffers:
     1019       assign
     1020       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1021       no-error.
     1022     end.
     1023     delete object v-qh.
     1024     do v-ii = 1 to p-qh:num-buffers:
     1025       delete object v-bh[v-ii].
     1026     end.
     1027   end.
     1028   end procedure.
     1029   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1030   procedure wth-lib_cur-stock-place:
     1031   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
     1032   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
     1033   define input  parameter parw-p-code like ub.wth-pobj.w-p-code  no-undo.
     1034   define input  parameter parwth-code like ub.wth-pobj.wth-code  no-undo.
     1035   define output parameter parstock    like ub.wth-pobj.income-pl no-undo.
     1036   define buffer bf_wth-pobj for ub.wth-pobj.
     1037   find first bf_wth-pobj where bf_wth-pobj.obj-type = parobj-type and
     1038                                bf_wth-pobj.obj-code = parobj-code and
     1039                                bf_wth-pobj.w-p-code = parw-p-code and
     1040                                bf_wth-pobj.wth-code = parwth-code no-lock no-error.
     1041   if available bf_wth-pobj then assign parstock = bf_wth-pobj.income-pl - bf_wth-pobj.incass-pl.
     1042                            else assign parstock = 0.
     1043   end procedure.
     1044   procedure wth-lib_cur-stock-obj:
     1045   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
     1046   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
     1047   define input  parameter parwth-code like ub.wth-obj.wth-code   no-undo.
     1048   define output parameter parstock    like ub.wth-obj.income     no-undo.
     1049   define buffer bf_wth-obj for ub.wth-obj.
     1050   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
     1051                               bf_wth-obj.obj-code = parobj-code and
     1052                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
     1053   if available bf_wth-obj then assign parstock = bf_wth-obj.income - bf_wth-obj.incass.
     1054                           else assign parstock = 0.
     1055   end.
     1056   FUNCTION wth-lib_cur-stock-obj-func RETURNS DECIMAL (INPUT parobj-type AS CHARACTER,
     1057                                                        INPUT parobj-code AS INTEGER,
     1058                                                        INPUT parwth-code AS INTEGER):
     1059   define buffer bf_wth-obj for ub.wth-obj.
     1060   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
     1061                               bf_wth-obj.obj-code = parobj-code and
     1062                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
     1063   if available bf_wth-obj then return (bf_wth-obj.income - bf_wth-obj.incass).
     1064                           else return 0.00.
     1065   end function.
     1066   FUNCTION wth-lib_cur-stock-host-func RETURNS DECIMAL (INPUT parhost-code AS INTEGER,
     1067                                                         INPUT parwth-code  AS INTEGER):
     1068   define buffer bf_wth-obj for ub.wth-obj.
     1069   define variable v-stock like ub.wth-obj.income no-undo.
     1070   for each bf_wth-obj no-lock where bf_wth-obj.host-code = parhost-code and
     1071                                     bf_wth-obj.wth-code = parwth-code :
     1072     v-stock = v-stock +  bf_wth-obj.income - bf_wth-obj.incass.
     1073   end.
     1074   return v-stock.
     1075   end function.
