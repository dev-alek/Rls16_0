        1   DEFINE BUFFER locked_group-period-validity FOR ub.group-period-validity.
        2   DEFINE TEMP-TABLE tt-group-period-validity NO-UNDO LIKE ub.group-period-validity.
        3   DEFINE BUFFER X_curr_clients FOR ub.clients.
        4   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        5   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo.
        6   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo.
        7   define input parameter p-mode as character no-undo.
        8   DEFINE INPUT PARAMETER p-gr-per-val-code LIKE ub.group-period-validity.gr-per-val-code NO-UNDO.
        9   define input-output parameter p-doc-rec as recid no-undo.
       10   def var vss-revision    as character no-undo init "$Revision$":U .
       11   def var vss-author      as character no-undo init "$Author$":U .
       12   def var vss-date        as character no-undo init "$Date$":U .
       13   def var vss-workfile    as character no-undo init "$Workfile$":U .
       14   def var vss-archive     as character no-undo init "$Archive$":U .
       15   def var vss-description as character no-undo init "Карточка редактирования группы сроков годности".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   procedure proc-alt-shift-f2:
       75     if not ibs.th.gbl.gbl-var:rcode
       76   then
       77     run gbl\inidebug.p .
       78   end.
       79   procedure proc-alt-shift-f3:
       80     run gbl/prvssinf.p
       81       ( input this-procedure
       82       ) .
       83   end.
       84   define variable v-inform-launched as logical no-undo initial false .
       85   procedure proc-alt-shift-f4:
       86     define variable v-action as character no-undo .
       87     if v-inform-launched = false then do:
       88       assign
       89         v-inform-launched = true
       90       .
       91       run gbl/d-inform.w
       92         (  input self
       93         ,  input this-procedure
       94         , output v-action
       95         ) no-error .
       96       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       97       assign
       98         v-inform-launched = false
       99       .
      100     end.
      101   end.
      102   procedure proc-alt-f1:
      103     run gbl/corrhelp.p
      104       (input this-procedure
      105       ) .
      106   end .
      107   on alt-shift-f2 anywhere do:
      108     run proc-alt-shift-f2.
      109   end.
      110   on alt-shift-f3 anywhere do:
      111     run proc-alt-shift-f3 in this-procedure .
      112   end.
      113   on alt-shift-f4 anywhere do:
      114     run proc-alt-shift-f4 in this-procedure.
      115   end.
      116   on alt-f1 anywhere do:
      117     run proc-alt-f1 in this-procedure .
      118   end.
      119   define new global shared variable g#library  as handle no-undo .
      120   define new global shared variable g#library2 as handle no-undo .
      121   define variable v-tab-order as character no-undo.
      122   define variable v-db-num LIKE ub.db.db-num no-undo.
      123   define variable v-last-code like ub.group-period-validity.gr-per-val-code no-undo.
      124   DEFINE BUTTON B-exit AUTO-GO
      125        LABEL "&Ввод"
      126        SIZE 10 BY 1
      127        BGCOLOR 8 .
      128   DEFINE BUTTON B-Help
      129        LABEL "Помо&щь"
      130        SIZE 10 BY 1
      131        BGCOLOR 8 .
      132   DEFINE BUTTON B-Hist
      133        LABEL "Ис&тория"
      134        SIZE 10 BY 1
      135        BGCOLOR 8 .
      136   DEFINE BUTTON b-quit AUTO-END-KEY
      137        LABEL "&Отмена"
      138        SIZE 10 BY 1
      139        BGCOLOR 8 .
      140   DEFINE QUERY Dialog-Frame FOR
      141         tt-group-period-validity SCROLLING.
      142   DEFINE FRAME Dialog-Frame
      143        B-exit AT ROW 1 COL 1
      144        b-quit AT ROW 1 COL 11
      145        B-Hist AT ROW 1 COL 51
      146        B-Help AT ROW 1 COL 61
      147        tt-group-period-validity.gr-per-val-code AT ROW 3 COL 34 COLON-ALIGNED
      148             LABEL "Внутр.код группы сроков хранения"
      149             VIEW-AS FILL-IN
      150             SIZE 11 BY 1
      151        tt-group-period-validity.gr-per-val-name AT ROW 4.25 COL 34 COLON-ALIGNED
      152             LABEL "Название группы сроков хранения"
      153             VIEW-AS FILL-IN
      154             SIZE 63 BY 1
      155        tt-group-period-validity.gr-per-from AT ROW 5.5 COL 34 COLON-ALIGNED
      156             LABEL "С"
      157             VIEW-AS FILL-IN
      158             SIZE 8.5 BY 1
      159        tt-group-period-validity.gr-per-to AT ROW 6.75 COL 34 COLON-ALIGNED
      160             LABEL "По"
      161             VIEW-AS FILL-IN
      162             SIZE 9 BY 1
      163        tt-group-period-validity.des AT ROW 10 COL 1 NO-LABEL
      164             VIEW-AS EDITOR SCROLLBAR-VERTICAL
      165             SIZE 98 BY 3.75
      166        "Описание" VIEW-AS TEXT
      167             SIZE 16 BY 1 AT ROW 8.75 COL 1.5
      168        "Количество дней хранения" VIEW-AS TEXT
      169             SIZE 27 BY 1 AT ROW 5.75 COL 2
      170        SPACE(70.24) SKIP(7.49)
      171       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      172            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      173            TITLE "Группа сроков годности"
      174            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      175   ASSIGN
      176          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      177          FRAME Dialog-Frame:HIDDEN           = TRUE.
      178   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      179   DO:
      180     APPLY "END-ERROR":U TO SELF.
      181   END.
      182   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      183   DO:
      184       run proc-save in this-procedure no-error.
      185     if error-status:error then return no-apply.
      186   END.
      187   ON CHOOSE OF B-Hist IN FRAME Dialog-Frame
      188   DO:
      189     define variable v-rid-list as character no-undo.
      190       run ref/gcprvals.w
      191                   (
      192                    input parParentProc
      193                   ,INPUT p-curr-obj-type
      194                   ,INPUT p-curr-obj-code
      195                   ,input "":U
      196                   ,input "one":U
      197                   ,input locked_group-period-validity.gr-per-val-code
      198                   ,input-output v-rid-list
      199                                 )
      200    .
      201   END.
      202   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      203   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      204   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      205   on help of frame Dialog-Frame
      206   do:
      207     run gbl/app_help.p
      208       (input this-procedure :file-name
      209       ,input ''
      210       ,input ?
      211       ) no-error.
      212     if error-status :error then do:
      213       message
      214         "Ошибка при вызове помощи"
      215         error-status :get-message(1)
      216         view-as alert-box .
      217     end.
      218   end.
      219   run minbtn-set in this-procedure .
      220   on choose of b-help in frame Dialog-Frame
      221   do:
      222     apply "help":u to frame Dialog-Frame .
      223   end.
      224   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      225   procedure minbtn-set :
      226       do
      227           on error undo, return error return-value
      228           :
      229           define variable ii              as integer       no-undo .
      230           define variable fh              as widget-handle no-undo .
      231           define variable hh              as widget-handle no-undo .
      232           define variable v-h             as handle        extent 4 no-undo .
      233           define variable v-name-button   as character     no-undo .
      234           define variable v-help-old-x    as decimal       no-undo .
      235           define variable v-help-old-y    as decimal       no-undo .
      236           define variable v-help-old-size as decimal       no-undo .
      237           define variable v-frame-width   as decimal       no-undo .
      238           define variable jj              as integer       no-undo .
      239           do
      240               on error undo, return error
      241               :
      242               assign
      243                   v-frame-width = frame Dialog-Frame:width - 0.3
      244                   fh            = frame Dialog-Frame:first-child
      245                   hh            = fh:first-child
      246                   ii            = 1
      247                   .
      248               do while valid-handle(hh):
      249                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      250                   do:
      251                       case lc(hh:name) :
      252                           when "b-help" then
      253                               do:
      254                                   hh:load-image-up("cmp/b-help.bmp":u) .
      255                                   hh:load-image-down("cmp/b-help.bmp":u) .
      256                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      257                                   hh:TOOLTIP = "Помощь" .
      258                                   v-help-old-x = hh:column .
      259                                   v-help-old-y = hh:row    .
      260                                   v-help-old-size = hh:width .
      261                                   hh:width-chars = 2.5 .
      262                               end.
      263                           when "b-print" then
      264                               do:
      265                                   hh:load-image("cmp/b-print.bmp":u) .
      266                                   hh:TOOLTIP = "Печать" .
      267                                   v-h[ii] = hh:handle .
      268                                   ii = ii + 1 .
      269                                   hh:width-chars = 3 .
      270                               end.
      271                           when "b-history" or
      272                           when "b-hist" then
      273                               do:
      274                                   hh:load-image("cmp/b-hist.bmp":u) .
      275                                   hh:TOOLTIP = "История" .
      276                                   v-h[ii] = hh:handle .
      277                                   ii = ii + 1 .
      278                                   hh:width-chars = 3 .
      279                               end.
      280                           when "b-sch" then
      281                               do:
      282                                   hh:load-image("cmp/b-sch.bmp":u) .
      283                                   hh:TOOLTIP = "Установка Фильтра" .
      284                                   v-h[ii] = hh:handle .
      285                                   ii = ii + 1 .
      286                                   hh:width-chars = 3 .
      287                               end.
      288                           when "b-hist-user" then
      289                               do:
      290                                   hh:load-image("cmp/b-hist.bmp":u) .
      291                                   hh:TOOLTIP = "История пользователя" .
      292                                   ii = ii + 1 .
      293                               end.
      294                       end case.
      295                   end.
      296                   hh = hh:next-sibling.
      297               end.
      298               b-help:column = v-frame-width - b-help:width-chars.
      299               jj = 0.
      300               repeat ii = 4 to 1 by -1 :
      301                   if valid-handle (v-h[ii] ) then
      302                   do:
      303                       jj  = jj + 1 .
      304                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      305                       v-h[ii]:row    = v-help-old-y .
      306                   end.
      307               end.
      308           end.
      309       end.
      310   end procedure.
      311   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      312   ON TAB ANYWHERE
      313   DO:
      314   define variable ii as integer no-undo .
      315   define variable fh as widget-handle no-undo .
      316   define variable hh as widget-handle no-undo .
      317   define variable v-next-widget-name as character no-undo .
      318   if v-tab-order <> '' then do:
      319     if self:type = "TOGGLE-BOX" then
      320     self:BGCOLOR = ?.
      321     assign
      322     ii = lookup(self:name, v-tab-order).
      323     assign
      324     ii = ii + 1
      325     v-next-widget-name = entry(ii, v-tab-order)
      326     no-error .
      327     if error-status:error then do:
      328       assign
      329       ii = 1
      330       v-next-widget-name = entry( ii, v-tab-order)
      331       .
      332     end.
      333     assign
      334     fh = frame Dialog-Frame:first-child
      335     hh = fh:first-child
      336     .
      337     do while valid-handle(hh):
      338       if hh:name = v-next-widget-name then do:
      339         if hh:sensitive  = yes
      340         AND hh:visible = yes then do:
      341           APPLY "ENTRY" to hh.
      342           return no-apply.
      343         end.
      344         else do:
      345           APPLY "TAB" to hh.
      346           return no-apply.
      347         end.
      348       end.
      349       hh = hh:next-sibling.
      350     end.
      351   end.
      352   END.
      353   ON BACK-TAB ANYWHERE
      354   DO:
      355   define variable ii as integer no-undo .
      356   define variable fh as widget-handle no-undo .
      357   define variable hh as widget-handle no-undo .
      358   define variable v-next-widget-name as character no-undo .
      359   if v-tab-order <> '' then do:
      360     assign
      361     ii = lookup(self:name, v-tab-order).
      362     .
      363     assign
      364     ii = (if ii = 1
      365           then  num-entries(v-tab-order)
      366           else ii - 1
      367           )
      368     v-next-widget-name = entry(ii, v-tab-order)
      369     .
      370     assign
      371     fh = frame Dialog-Frame:first-child
      372     hh = fh:first-child
      373     .
      374     do while valid-handle(hh):
      375       if hh:name = v-next-widget-name then do:
      376         if hh:sensitive  = yes
      377         AND hh:visible = yes then do:
      378           APPLY "ENTRY" to hh.
      379           return no-apply.
      380         end.
      381         else do:
      382         APPLY "BACK-TAB" to hh.
      383         return no-apply.
      384         end.
      385       end.
      386       hh = hh:next-sibling.
      387     end.
      388     end.
      389   END.
      390   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      391   ON RETURN ANYWHERE
      392   DO:
      393   define variable ii as integer no-undo .
      394   define variable fh as widget-handle no-undo .
      395   define variable hh as widget-handle no-undo .
      396   define variable v-next-widget-name as character no-undo .
      397     if v-tab-order <> '' then do:
      398       assign
      399       ii = lookup(self:name, v-tab-order).
      400       if ii = num-entries(v-tab-order) then do:
      401           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
      402           return no-apply.
      403       end.
      404       if self:type <> "BUTTON" and
      405         self:type <> "EDITOR"  then do:
      406         run proc-move-forward in this-procedure .
      407         return no-apply.
      408       end.
      409       if self:type = "BUTTON" then do:
      410         APPLY "CHOOSE" to self.
      411       end.
      412       if self:type = "TOGGLE-BOX" then
      413       self:BGCOLOR = ?.
      414       assign
      415       ii = ii + 1
      416       v-next-widget-name = entry(ii, v-tab-order)
      417       no-error .
      418       if error-status:error then do:
      419         assign
      420         ii = 1
      421         v-next-widget-name = entry( ii, v-tab-order)
      422         .
      423       end.
      424       assign
      425       fh = frame Dialog-Frame:first-child
      426       hh = fh:first-child
      427       .
      428       do while valid-handle(hh):
      429         if hh:name = v-next-widget-name then do:
      430           if hh:sensitive  = yes
      431           AND hh:visible = yes then do:
      432             if hh:type = "TOGGLE-BOX":U then do:
      433               assign
      434               hh:BGcolor = 1
      435               .
      436             end.
      437             APPLY "ENTRY" to hh.
      438             return no-apply.
      439           end.
      440           else do:
      441             APPLY "TAB" to hh.
      442             return no-apply.
      443           end.
      444         end.
      445         hh = hh:next-sibling.
      446       end.
      447     end.
      448   END.
      449   procedure proc-move-forward :
      450   define variable ii as integer no-undo .
      451   define variable fh as widget-handle no-undo .
      452   define variable hh as widget-handle no-undo .
      453   define variable v-next-widget-name as character no-undo .
      454   do
      455   on error undo, return error
      456   :
      457     if v-tab-order <> '' then do:
      458       if self:type = "TOGGLE-BOX" then
      459       self:BGCOLOR = ?.
      460       assign
      461       ii = lookup(self:name, v-tab-order).
      462       assign
      463       ii = ii + 1
      464       v-next-widget-name = entry(ii, v-tab-order)
      465       no-error .
      466       if error-status:error then do:
      467         assign
      468         ii = 1
      469         v-next-widget-name = entry( ii, v-tab-order)
      470         .
      471       end.
      472       assign
      473       fh = frame Dialog-Frame:first-child
      474       hh = fh:first-child
      475       .
      476       do while valid-handle(hh):
      477         if hh:name = v-next-widget-name then do:
      478           if hh:sensitive  = yes
      479           AND hh:visible = yes then do:
      480             if hh:type = "TOGGLE-BOX":U then do:
      481               assign
      482               hh:BGcolor = 1
      483               .
      484             end.
      485             APPLY "ENTRY" to hh.
      486             return.
      487           end.
      488           else do:
      489             assign
      490             ii = ii + 1
      491             v-next-widget-name = entry(ii, v-tab-order)
      492             no-error .
      493             if error-status:error then do:
      494               assign
      495               ii = 1
      496               v-next-widget-name = entry( ii, v-tab-order)
      497               .
      498             end.
      499           end.
      500         end.
      501         hh = hh:next-sibling.
      502       end.
      503     end.
      504   end.
      505   end procedure.
      506   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      507   on ' ' of tt-group-period-validity.gr-per-from in frame Dialog-Frame
      508   do:
      509     if (can-query (self, "sensitive")
      510        and
      511        self :sensitive = true
      512        )
      513     or (can-query (self, "read-only")
      514        and
      515        self :read-only = false
      516        )
      517     then do:
      518       assign
      519         self :screen-value = ?
      520       .
      521     end.
      522     return no-apply.
      523   end.
      524   on delete-character of tt-group-period-validity.gr-per-from in frame Dialog-Frame
      525   do:
      526     if (can-query (self, "sensitive")
      527        and
      528        self :sensitive = true
      529        )
      530     or (can-query (self, "read-only")
      531        and
      532        self :read-only = false
      533        )
      534     then do:
      535       assign
      536         self :screen-value = ?
      537       .
      538     end.
      539     return no-apply.
      540   end.
      541   on ctrl-d of tt-group-period-validity.gr-per-from in frame Dialog-Frame
      542   do:
      543     define variable v-curr-sv-date as date no-undo .
      544     if (can-query (self, "sensitive")
      545        and
      546        self :sensitive = true
      547        )
      548     or (can-query (self, "read-only")
      549        and
      550        self :read-only = false
      551        )
      552     then do:
      553       if self :handle <> focus :handle
      554       then do:
      555         apply "entry":u to self .
      556       end.
      557       run gbl/getcurdt.p
      558         (output v-curr-sv-date
      559         ) .
      560       assign
      561         self :screen-value = string(v-curr-sv-date) .
      562       .
      563     end.
      564     return no-apply.
      565   end.
      566   on ctrl-b of tt-group-period-validity.gr-per-from in frame Dialog-Frame
      567   do:
      568     if (can-query (self, "sensitive")
      569        and
      570        self :sensitive = true
      571        )
      572     or (can-query (self, "read-only")
      573        and
      574        self :read-only = false
      575        )
      576     then do:
      577       if self :handle <> focus :handle
      578       then do:
      579         apply "entry":u to self .
      580       end.
      581       define variable v-curr-sv-date as date no-undo .
      582       define variable v-new-sv-date  as date no-undo .
      583       assign
      584         v-curr-sv-date = date(self :screen-value) no-error
      585       .
      586       if v-curr-sv-date = ?
      587       then do:
      588         run gbl/getcurdt.p
      589           (output v-curr-sv-date
      590           ) .
      591       end.
      592       if v-curr-sv-date <> ?
      593       then do:
      594         assign
      595           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      596         .
      597         assign
      598           self :screen-value = string(v-new-sv-date) .
      599         .
