      952   MAIN-BLOCK:
      953   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      954      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      955    if p-mode  <> 'ДОБАВЛЕНИЕ':U
      956    and p-mode <> 'ИЗМЕНЕНИЕ':U
      957    and p-mode <> 'ПРОСМОТР':U
      958    then do:
      959       message
      960       vss-workfile vss-revision vss-description skip
      961       "Неверное значение параметров вызова p-mode"  p-mode
      962       view-as alert-box ERROR.
      963       undo, return error.
      964    end.
      965      find first X_curr_clients no-lock where
      966               X_curr_clients.obj-type = p-curr-obj-type
      967          AND X_curr_clients.obj-code = p-curr-obj-code no-error.
      968     if not available X_curr_clients then do:
      969       message
      970       vss-workfile vss-revision vss-description skip
      971       "Неверное значение параметра вызова p-curr-obj-type p-curr-obj-code"
      972       p-curr-obj-type p-curr-obj-code
      973       view-as alert-box ERROR.
      974       return error .
      975     end.
      976   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      977   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      978     (output v-db-num
      979     )  .
      980   IF v-db-num <> 0
      981   AND (p-mode = 'ДОБАВЛЕНИЕ':U
      982        OR p-mode = 'ИЗМЕНЕНИЕ':U ) THEN DO:
      983         message
      984       vss-workfile vss-revision vss-description skip
      985       "Неверное значение параметра вызова p-mode" p-mode skip
      986       "Нельзя редактировать запись ГРУППЫ СРОКОВ ГОДНОСТИ в УБД"
      987       view-as alert-box ERROR.
      988       return error .
      989   END.
      990     for each tt-group-period-validity:
      991       delete tt-group-period-validity.
      992     end.
      993     if p-mode = 'ИЗМЕНЕНИЕ':U
      994     or p-mode = 'ПРОСМОТР':U then do:
      995       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      996         find first locked_group-period-validity EXclusive-lock where
      997                      recid(locked_group-period-validity) = p-doc-rec no-wait no-error.
      998         if locked locked_group-period-validity then do:
      999           message
     1000           vss-workfile vss-revision vss-description skip
     1001            "Запись ГРУППЫ СРОКОВ ГОДНОСТИ занята"
     1002           view-as alert-box error .
     1003           undo, return error.
     1004         end.
     1005       end.
     1006       else do:
     1007         find first locked_group-period-validity no-lock where
     1008                          recid(locked_group-period-validity) = p-doc-rec no-error .
     1009         if not avail locked_group-period-validity then do:
     1010           find first locked_group-period-validity no-lock where
     1011                      locked_group-period-validity.gr-per-val-code = p-gr-per-val-code no-error .
     1012         end.
     1013       end.
     1014       if not available locked_group-period-validity then do:
     1015         message
     1016         vss-workfile vss-revision vss-description skip
     1017         "Не найдена запись ГРУППЫ СРОКОВ ГОДНОСТИ"
     1018         view-as alert-box error .
     1019         undo, return error.
     1020       end.
     1021       create tt-group-period-validity.
     1022       buffer-copy locked_group-period-validity to tt-group-period-validity.
     1023      end.
     1024      else do:
     1025             create tt-group-period-validity.
     1026             assign
     1027            tt-group-period-validity.gr-per-val-code = v-last-code + 1
     1028            .
     1029      end.
     1030     RUN Myenable.
     1031     WAIT-FOR GO OF FRAME Dialog-Frame.
     1032   END.
     1033   RUN disable_UI.
     1034   PROCEDURE disable_UI :
     1035     HIDE FRAME Dialog-Frame.
     1036   END PROCEDURE.
     1037   PROCEDURE enable_UI :
     1038     OPEN QUERY Dialog-Frame FOR EACH tt-group-period-validity SHARE-LOCK.
     1039     GET FIRST Dialog-Frame.
     1040     IF AVAILABLE tt-group-period-validity THEN
     1041       DISPLAY tt-group-period-validity.gr-per-val-code
     1042             tt-group-period-validity.gr-per-val-name
     1043             tt-group-period-validity.gr-per-from
     1044             tt-group-period-validity.gr-per-to tt-group-period-validity.des
     1045         WITH FRAME Dialog-Frame.
     1046     ENABLE B-exit b-quit B-Hist B-Help tt-group-period-validity.gr-per-val-code
     1047            tt-group-period-validity.gr-per-val-name
     1048            tt-group-period-validity.gr-per-from
     1049            tt-group-period-validity.gr-per-to tt-group-period-validity.des
     1050         WITH FRAME Dialog-Frame.
     1051     VIEW FRAME Dialog-Frame.
     1052   END PROCEDURE.
     1053   PROCEDURE MyENable :
     1054   case p-mode:
     1055     when 'ДОБАВЛЕНИЕ':U then do:
     1056       display
     1057       ? @ tt-group-period-validity.gr-per-val-code
     1058       WITH FRAME Dialog-Frame.
     1059     end.
     1060     otherwise do:
     1061       IF AVAILABLE tt-group-period-validity THEN
     1062       DISPLAY
     1063       tt-group-period-validity.gr-per-val-code
     1064       tt-group-period-validity.gr-per-val-name
     1065       tt-group-period-validity.gr-per-from
     1066       tt-group-period-validity.gr-per-to tt-group-period-validity.des
     1067       WITH FRAME Dialog-Frame.
     1068     end.
     1069   END CASE.
     1070   if p-mode = 'ПРОСМОТР':U then do:
     1071   assign
     1072   b-quit:label = "&Выход"
     1073   .
     1074   hide
     1075   b-exit in frame Dialog-Frame.
     1076   end.
     1077   ENABLE
     1078   B-exit when p-mode <> 'ПРОСМОТР':U
     1079   b-quit
     1080   B-Hist when p-mode <> 'ДОБАВЛЕНИЕ':U
     1081   B-Help
     1082   tt-group-period-validity.gr-per-val-name when p-mode <> 'ПРОСМОТР':U
     1083   tt-group-period-validity.gr-per-from      when p-mode <> 'ПРОСМОТР':U
     1084   tt-group-period-validity.gr-per-to when p-mode <> 'ПРОСМОТР':U
     1085   tt-group-period-validity.des when p-mode <> 'ПРОСМОТР':U
     1086   WITH FRAME Dialog-Frame.
     1087   VIEW FRAME Dialog-Frame.
     1088   END PROCEDURE.
     1089   PROCEDURE Proc-save :
     1090   if p-mode = 'ПРОСМОТР':U then do:
     1091       return error.
     1092   end.
     1093   if not available tt-group-period-validity then do:
     1094       create tt-group-period-validity.
     1095   end.
     1096   assign
     1097   tt-group-period-validity.gr-per-val-code frame Dialog-Frame
     1098   tt-group-period-validity.gr-per-val-name
     1099   tt-group-period-validity.gr-per-to
     1100   tt-group-period-validity.des = tt-group-period-validity.des:SCREEN-VALUE
     1101   tt-group-period-validity.gr-per-from
     1102   .
     1103    run ref/gperval1.p (
     1104   input-output p-doc-rec
     1105   ,input p-mode
     1106   ,input tt-group-period-validity.gr-per-val-code
     1107   ,input tt-group-period-validity.gr-per-val-name
     1108   ,input tt-group-period-validity.des
     1109   ,input tt-group-period-validity.gr-per-from
     1110   ,input tt-group-period-validity.gr-per-to
     1111   )
     1112   no-error.
     1113   END PROCEDURE.
