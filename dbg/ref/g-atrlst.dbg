     1215       END CASE.
     1216       if error-status :error then do:
     1217         undo, return error return-value .
     1218       end.
     1219       find first buf_temp-attr exclusive-lock where
     1220                  buf_temp-attr.attr-code = p-code
     1221               and buf_temp-attr.host-code = p-host-code
     1222               and buf_temp-attr.obj-type = p-obj-type
     1223               and buf_temp-attr.obj-code = p-obj-code no-error .
     1224       if not available buf_temp-attr then do:
     1225         P-DELETED = NO.
     1226       end.
     1227       ELSE DO:
     1228          delete buf_temp-attr.
     1229          P-DELETED = YES.
     1230       END.
     1231     end.
     1232   end procedure.
     1233   define variable v-no-ask as logical no-undo .
     1234   define variable v-view-log as logical no-undo .
     1235   define variable log-file-name                as character      no-undo init "g-atrlst.txt".
     1236   define variable v-stop                       as logical        no-undo .
     1237   define variable v-choice as integer no-undo .
     1238   DEFINE VARIABLE num-rec as integer no-undo .
     1239   DEFINE VARIABLE num-rec-ok as integer no-undo .
     1240   define variable v-mes as character no-undo .
     1241   define variable v-ok as logical no-undo .
     1242   assign
     1243   parhost-code = integer(entry(1, p-parameter, chr(4)))
     1244   parobj-type  = entry(2, p-parameter, chr(4))
     1245   parobj-code = integer(entry(3, p-parameter, chr(4)))
     1246   pardelete-ok = logical(entry(4, p-parameter, chr(4)))
     1247   no-error
     1248   .
     1249   if error-status:error then do:
     1250    run write-log-and-file in p-log-handle (
     1251           input 1
     1252         , input log-file-name
     1253         , input 1
     1254         , input substitute("Ошибка входных параметров &1:&2&3&4"
     1255                            , p-parameter
     1256                            , chr(10)
     1257                            , error-status:get-message(1)
     1258                            , return-value
     1259                            )).
     1260     assign
     1261     v-view-log = yes.
     1262   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1263   if v-view-log
     1264   and not g#news
     1265   and not g#auto
     1266   then do:
     1267     message
     1268     '!!!При изменении глобальных атрибутов товара по списку товаров произошли ошибки!!!'  skip
     1269     "!!!Внимательно прочитайте Log-file!!"
     1270     view-as alert-box error .
     1271        define variable v-user-action7   as character no-undo .
     1272     define variable v-printed7       as logical   no-undo .
     1273     run gbl/prnfilen.w
     1274       (input  ('!!!При изменении глобальных атрибутов товара по списку товаров произошли ошибки!!!')
     1275       ,input  0
     1276       ,input  (string("./":U) + 'g-atrlst.txt')
     1277       ,input  7
     1278       ,output v-user-action7
     1279       ,output v-printed7
     1280       ) .
     1281   end.
     1282   if v-view-log = true
     1283   and (g#news
     1284   or g#auto)
     1285   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     1286   then do:
     1287      run cb_set-view-log in p-parent-handle ( input yes).
     1288   end.
     1289   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     1290     OS-DELETE value(string("./":U) + 'g-atrlst.txt').
     1291   end.
     1292     return .
     1293   end.
     1294   run write-log  in p-log-handle(
     1295                                    input 0
     1296                                  , "&DLine").
     1297   run write-log-and-file in p-log-handle (
     1298         input 1
     1299       , input log-file-name
     1300       , input 1
     1301       , input substitute("Изменение глобальных атрибутов товара по списку товаров")).
     1302   _gds-list:
     1303   for each gds-list
     1304     ON ERROR undo, NEXT:
     1305       num-rec = num-rec + 1.
     1306       v-ok = false.
     1307       run check-actg in this-procedure (
     1308                                          input gds-list.grp-code
     1309                                         ,input gds-list.gds-code
     1310                                         ,input parobj-code
     1311                                         ,input parobj-type
     1312                                         ,output v-ok )  no-error .
     1313       if v-ok = true then do :
     1314         run do-changes in this-procedure (
     1315                                           input gds-list.gds-code
     1316                                           ) no-error .
     1317       end.
     1318       if error-status:error then do:
     1319         run write-log-and-file in p-log-handle (
     1320                   input 1
     1321                 , input log-file-name
     1322                 , input 1
     1323                 , input return-value
     1324                                             ).
     1325         assign
     1326         v-view-log = yes.
     1327         if v-no-ask  then do:
     1328           run gbl/d-askw.w (
     1329                         input "Изменение глобальных атрибутов товара  по списку товаров"
     1330                         ,input substitute("Товар с кодом &1 - не удалось провести изменение атрибутов товара на объекте"
     1331                                         , gds-list.gds-code
     1332                                         )
     1333                         ,input "|"
     1334                         ,input ("Продолжить|" +
     1335                               "Продолжить и больше не запрашивать подтверждения на продолжение|" +
     1336                               "Прекратить")
     1337                         ,input "||"
     1338                         ,input 1
     1339                         ,input 3
     1340                         ,output v-choice).
     1341           if v-choice = 3 then do:
     1342             leave.
     1343           end.
     1344           if v-choice = 2 then do:
     1345             assign
     1346             v-no-ask = yes.
     1347           end.
     1348         end.
     1349       end.
     1350       else do:
     1351         num-rec-ok = num-rec-ok + 1.
     1352         if pardelete-ok then delete gds-list.
     1353       end.
     1354       run show-counter in p-log-handle .
     1355       run write-counter in p-log-handle (substitute("Обработано &1 из них успешно &2"
     1356                                                   , num-rec
     1357                                                   , num-rec-ok
     1358                                                   )) no-error.
     1359       run get-stop-state in p-log-handle (
     1360           output v-stop
     1361       ).
     1362       if v-stop then do:
     1363         leave _gds-list.
     1364       end.
     1365   END.
     1366   run write-log-and-file in p-log-handle (
     1367         input 1
     1368       , input log-file-name
     1369       , input 1
     1370       , input substitute("Пакетное изменение глобальных атрибутов по списку товаров завершено: из &1 товаров списка успешно изменено &2", num-rec, num-rec-ok )).
     1371   .
     1372   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1373   if v-view-log
     1374   and not g#news
     1375   and not g#auto
     1376   then do:
     1377     message
     1378     '!!!При изменении атрибутов товара на объекте по списку товаров произошли ошибки!!!'  skip
     1379     "!!!Внимательно прочитайте Log-file!!"
     1380     view-as alert-box error .
     1381        define variable v-user-action9   as character no-undo .
     1382     define variable v-printed9       as logical   no-undo .
     1383     run gbl/prnfilen.w
     1384       (input  ('!!!При изменении атрибутов товара на объекте по списку товаров произошли ошибки!!!')
     1385       ,input  0
     1386       ,input  (string("./":U) + 'g-atrlst.txt')
     1387       ,input  7
     1388       ,output v-user-action9
     1389       ,output v-printed9
     1390       ) .
     1391   end.
     1392   if v-view-log = true
     1393   and (g#news
     1394   or g#auto)
     1395   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     1396   then do:
     1397      run cb_set-view-log in p-parent-handle ( input yes).
     1398   end.
     1399   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     1400     OS-DELETE value(string("./":U) + 'g-atrlst.txt').
     1401   end.
     1402   procedure do-changes :
     1403   define input parameter pargds-code like ub.goods.gds-code no-undo .
     1404   DEFINE VARIABLE loc#log as logical no-undo .
     1405   DEFINE VARIABLE var-deleted as logical no-undo .
     1406   define variable v-check as character no-undo .
     1407   define variable v-correct as logical no-undo .
     1408   define variable v-error-code as character no-undo .
     1409   define variable jj as integer no-undo .
     1410       _main:
     1411     do
     1412     on error undo, return error
     1413     :
     1414       _temp-attr:
     1415       for each temp-attr no-lock
     1416           on error undo _main, return error:
     1417         do jj = 1 to num-entries(temp-attr.other-inf, chr(47)):
     1418           if entry(1, entry(jj, temp-attr.other-inf, chr(47)), "=":U) = "check-ext":U then do:
     1419             assign
     1420             v-check = string(entry(2, entry(jj, temp-attr.other-inf, chr(47)), "=":U))
     1421             .
     1422           end.
     1423         end.
     1424         if v-check <> "":U then do:
     1425           assign
     1426           v-correct = no
     1427           v-error-code = "":U.
     1428           run value(v-check)(
     1429                             input pargds-code
     1430                             ,input attr-value
     1431                             ,input (if temp-attr.action = yes then 'ИЗМЕНЕНИЕ':U else 'удаление':U)
     1432                             ,output v-correct
     1433                             ,output v-error-code) no-error.
     1434           if error-status:error
     1435           or not v-correct  then do:
     1436             assign v-mes = substitute("товар с кодом &1: ошибка при проверке корректности задаваемого значения глобального атрибута товара &2&3:&4 &4&3"  +                    "Обратитесь к администратору системы"                     , gds-list.gds-code                    , temp-attr.attr-value                    , chr(10)                        , error-status:get-message(1)                    , return-value ).
     1437             undo _main, return error v-mes.
     1438           end.
     1439         end.
     1440         CASE temp-attr.action:
     1441           when yes then do:
     1442             run gds-attr-write in this-procedure(
     1443                                                   input pargds-code,
     1444                                                   input temp-attr.attr-code,
     1445                                                   input temp-attr.attr-value
     1446                                                       )  no-error.
     1447              if error-status:error  then do:
     1448                assign v-mes = substitute("товар с кодом &1: ошибка при записи глобального атрибута товара &2&3:&4 &5&3"  +                    "Обратитесь к администратору системы"                     , gds-list.gds-code                    , temp-attr.attr-value                    , chr(10)                        , error-status:get-message(1)                    , return-value ).
     1449                undo _main, return error v-mes.
     1450              end.
     1451           end.
     1452           when no then do:
     1453             var-deleted = no.
     1454             run gds-attr-delete in this-procedure(
     1455                                                   input pargds-code,
     1456                                                   input temp-attr.attr-code,
     1457                                                   output var-deleted
     1458                                                       )  no-error.
     1459              if error-status:error  then do:
     1460                assign v-mes = substitute("товар с кодом &1: ошибка при удалении глобального атрибута товара &2&3:&4 &5&3"  +                    "Обратитесь к администратору системы"                     , gds-list.gds-code                    , temp-attr.attr-value                    , chr(10)                        , error-status:get-message(1)                    , return-value ).
     1461                undo _main, return error v-mes.
     1462              end.
     1463            end.
     1464         END CASE.
     1465       end.
     1466     end.
     1467   end procedure.
     1468   procedure check-actg :
     1469   define input parameter p-grp-code as integer no-undo.
     1470   define input parameter p-gds-code as integer no-undo.
     1471   define input parameter p-obj-code as integer no-undo.
     1472   define input parameter p-obj-type as character no-undo.
     1473   define output parameter p-ok as logical no-undo.
     1474   define variable glog as logical no-undo.
     1475   do
     1476   on error undo, return error
     1477   :
     1478   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1479     run mainmenu_getcntxt in parparentproc
     1480       (output v-cntxt-db-num
     1481       ,output v-cntxt-userid
     1482       ,output v-cntxt-level
     1483       ,output v-cntxt-host-code-obj
     1484       ,output v-cntxt-obj-type
     1485       ,output v-cntxt-obj-code
     1486       ,output v-cntxt-db-num-obj
     1487       ,output v-cntxt-is-admin
     1488       ) .
     1489   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1490   do:
     1491     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1492       (input  v-cntxt-db-num
     1493       ,input  v-cntxt-userid
     1494       ,input  0
     1495       ,input  'actn_reference_update':U
     1496       ,input  'global':U
     1497       ,input  0
     1498       ,input  '':U
     1499       ,input  0
     1500       ,input  0
     1501       ,input  p-grp-code
     1502       ,input  0
     1503       ,input  false
     1504       ,output glog
     1505       )  .
     1506   end.
     1507       if glog then do:
     1508         assign
     1509           p-ok = true.
     1510       end.
     1511       else do :
     1512         find first gds-grp no-lock
     1513              where gds-grp.node-code = p-grp-code no-error.
     1514         v-mes = substitute("товар с кодом &1, &2&3: У вас отсутствует глобальное право на изменение товара в привязке к группе товаров &4"
     1515                      , p-gds-code
     1516                      , p-obj-type
     1517                      , p-obj-code
     1518                      , (string(gds-grp.node-code) + " " + gds-grp.node-name)
     1519                       ).
     1520         undo,return error v-mes.
     1521       end.
     1522   end.
     1523   end procedure.
