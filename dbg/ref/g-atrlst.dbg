     1181             ,output v-format
     1182             ,output v-label
     1183             ,output v-user-can-edit
     1184             ,output v-output-display
     1185             ,output v-other
     1186             ) no-error .
     1187         end.
     1188         when 'clients-attr':U
     1189         then do:
     1190           run clntattr-code in this-procedure
     1191             (input  p-code
     1192             ,output v-type
     1193             ,output v-format
     1194             ,output v-label
     1195             ,output v-user-can-edit
     1196             ,output v-output-display
     1197             ,output v-other
     1198             ) no-error .
     1199         end.
     1200         when 'goods-attr':U
