      713   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      714   FUNCTION CIntBinS RETURNS CHARACTER(input vl_int as integer):
      715   def var vl_bin as char no-undo init "".
      716   if vl_int < 0 OR vl_int = ? then return ?.
      717   do while vl_int > 0:
      718     assign
      719     vl_bin = (if vl_int modulo 2 = 0
      720                 then "0":U
      721                 else "1":U) + vl_bin
      722     vl_int = truncate(vl_int / 2,0).
      723   end.
      724   return fill( "0":U, 32 - length(vl_bin)) + vl_bin .
      725   END FUNCTION.
      726   FUNCTION BinMask RETURNS LOGICAL(input vl_int as integer,
      727                                    input vl_binm as character):
      728   DEFINE VARIABLE vl_bin as character no-undo.
      729   DEFINE VARIABLE ii as integer no-undo.
      730   DEFINE VARIABLE ii-len as integer no-undo.
      731   DEFINE VARIABLE ii-lenm as integer no-undo.
      732   DEFINE VARIABLE mchar as character no-undo.
      733   DEFINE VARIABLE ichar as character no-undo.
      734   if vl_binm = ? then return ?.
      735   vl_bin = CIntBinS(vl_int).
      736   if vl_bin = ? then return ?.
      737   assign
      738   vl_binm = LEFT-TRIM(vl_binm, "X":U)
      739   ii-lenm = LENGTH(vl_binm)
      740   ii-len = LENGTH(vl_bin) - ii-lenm
      741   .
      742   if II-LENM > 32 THEN RETURN ?.
      743   DO II = 1 to II-LENm:
      744     assign
      745     mchar = SUBSTR(vl_binm, ii, 1)
      746     ichar = SUBSTR(vl_bin, ii + ii-len, 1)
      747     .
      748     IF not (MCHAR = "0":u or MCHAR = "1":u or MCHAR = "X":u) then return ?.
      749     IF ichar <> mchar AND mchar <> "X":U then return no.
      750   END.
      751   return yes.
      752   END FUNCTION.
      753   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      754   define SHARED temp-table temp-attr no-undo
      755   field attr-code like ub.gds-obj-attr.attr-code
      756   field attr-value like ub.gds-obj-attr.attr-value
      757   field host-code as integer
      758   field obj-type as character
      759   field obj-code as integer
      760   field user-can-edit as log
      761   field code as char
      762   field action as logical
      763   field other-inf as character
      764   index pi is  unique primary
      765   attr-code host-code obj-type obj-code ASCENDING
      766   index action
      767   action
      768   .
      769   procedure tempattr-value :
      770    do
      771     on error undo, return error
      772     :
      773       define input  parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
      774       define input  parameter p-host-code as integer no-undo .
      775       define input  parameter p-obj-type as character no-undo .
      776       define input  parameter p-obj-code as integer no-undo .
      777       define input  parameter p-mode      as character no-undo .
      778       define output parameter p-value    like ub.gds-obj-attr.attr-value no-undo .
      779       define output parameter p-type     as character no-undo .
      780       define buffer buf_temp-attr for temp-attr .
      781       define variable v-format         as character no-undo .
      782       define variable v-label          as character no-undo .
      783       define variable v-user-can-edit  as logical   no-undo .
      784       define variable v-output-display as logical   no-undo .
      785       define variable v-other          as character no-undo .
      786       define variable v-range          as integer   no-undo .
      787       define variable jj               as integer   no-undo .
      788       define variable v-spr            as logical   no-undo .
      789       define variable v-spr-name       as character no-undo .
      790       define variable v-spr-param      as character no-undo .
      791       define variable v-setted         as logical   no-undo .
      792       case var-object:
      793         when 'gds-obj-attr':U
      794         then do:
      795           run gdsoattr-name in this-procedure
      796             (input  p-code
      797             ,output p-type
      798             ,output v-format
      799             ,output v-label
      800             ,output v-user-can-edit
      801             ,output v-output-display
      802             ,output v-other
      803             ) no-error .
      804         end.
      805         when 'gds-host-attr':U
      806         then do:
      807           run gdshattr-name in this-procedure
      808             (input  p-code
      809             ,output p-type
      810             ,output v-format
      811             ,output v-label
      812             ,output v-user-can-edit
      813             ,output v-output-display
      814             ,output v-other
      815             ) no-error .
      816         end.
      817         when 'clients-attr':U
      818         then do:
      819           run clntattr-code in this-procedure
      820             (input  p-code
      821             ,output p-type
      822             ,output v-format
      823             ,output v-label
      824             ,output v-user-can-edit
      825             ,output v-output-display
      826             ,output v-other
      827             ) no-error .
      828         end.
      829         when 'goods-attr':U
      830         then do:
      831           run gds-attr-name in this-procedure
      832             (input  p-code
      833             ,output p-type
      834             ,output v-format
      835             ,output v-label
      836             ,output v-user-can-edit
      837             ,output v-output-display
      838             ,output v-other
      839             ) no-error .
      840         end.
      841         otherwise do:
      842           undo, return error .
      843         end.
      844       end case.
      845       if error-status :error
      846       then do:
      847         undo, return error return-value .
      848       end.
      849       if v-user-can-edit
      850       then do:
      851         do jj = 1 to num-entries(v-other, chr(47)):
      852           if entry(1, entry(jj, v-other, chr(47)), "=":U) = "spr":U then do:
      853             assign
      854             v-spr-name = entry(2, entry(jj, v-other, chr(47)), "=":U)
      855             .
      856           end.
      857           if entry(1, entry(jj, v-other, chr(47)), "=":U) = "spr-param":U then do:
      858             assign
      859             v-spr-param = entry(2, entry(jj, v-other, chr(47)), "=":U)
      860             .
      861           end.
      862        end.
      863         if v-spr-name <> "":U then do:
      864           if p-mode = "change":U
      865           then do:
      866             find first buf_temp-attr no-lock where
      867                       buf_temp-attr.attr-code = p-code
      868                   and buf_temp-attr.host-code = p-host-code
      869                   and buf_temp-attr.obj-type = p-obj-type
      870                   and buf_temp-attr.obj-code = p-obj-code
      871               no-error .
      872             if avail buf_temp-attr then do:
      873               assign
      874                 p-value =  buf_temp-attr.attr-value
      875               .
      876             end.
      877             else do:
      878               assign
      879                 p-value = if p-type = 'L':U then "no":U else ""
      880               .
      881             end.
      882           end.
      883           CASE var-object:
      884             when 'gds-obj-attr':U then do:
      885               if v-spr-param = "":U then do:
      886                 run value (
      887                             v-spr-name)
      888                             in this-procedure (
      889                                                   input 0
      890                                                 ,input parobj-type
      891                                                 ,input parobj-code
      892                                                 ,input-output p-value
      893                                                 ,output v-setted) no-error .
      894               end.
      895               else do:
      896                 run value (
      897                             v-spr-name)
      898                             in this-procedure (
      899                                                   input 0
      900                                                 ,input parobj-type
      901                                                 ,input parobj-code
      902                                                 ,input v-spr-param
      903                                                 ,input-output p-value
      904                                                 ,output v-setted) no-error .
      905               end.
      906               if error-status :error then do:
      907                 undo, return error "Неизвестный справочник для получения значения атрибут товара на объекте" + " " + p-code .
      908               end.
      909             end.
      910             when 'clients-attr':U then do:
      911             if v-spr-param = "":U then do:
      912               run   value ( v-spr-name ) in this-procedure
      913                   (  input 0
      914                     ,input parobj-type
      915                     ,input parobj-code
      916                     ,input-output p-value
      917                     ,output v-setted )
      918                     no-error .
      919             end.
      920             end.
      921             END CASE.
      922           if v-setted = no then do:
      923             return "not-set":U.
      924           end.
      925           assign
      926           v-spr = yes
      927           .
      928         end.
      929       end.
      930       if not v-spr then do:
      931         find first buf_temp-attr no-lock where
      932                   buf_temp-attr.attr-code = p-code
      933               and buf_temp-attr.host-code = p-host-code
      934               and buf_temp-attr.obj-type = p-obj-type
      935               and buf_temp-attr.obj-code = p-obj-code
      936           no-error .
      937         if avail buf_temp-attr then do:
      938           assign
      939             p-value =  buf_temp-attr.attr-value
      940           .
      941         end.
      942         else do:
      943           assign
      944             p-value = if p-type = 'L':U then "no":U else ""
      945           .
      946         end.
      947       end.
      948     end.
      949   end procedure.
      950   procedure tempattr-write :
      951     do
      952     on error undo, return error
      953     :
      954       define input parameter p-add      as logical no-undo .
      955       define input parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
      956       define input parameter p-host-code as integer no-undo .
      957       define input parameter p-obj-type as character no-undo .
      958       define input parameter p-obj-code as integer no-undo .
      959       define input parameter p-value    like ub.gds-obj-attr.attr-value no-undo .
      960       define input parameter p-action   like temp-attr.action no-undo .
      961       define buffer buf_temp-attr for temp-attr .
      962       define variable v-type           as character no-undo .
      963       define variable v-format         as character no-undo .
      964       define variable v-label          as character no-undo .
      965       define variable v-user-can-edit  as logical   no-undo .
      966       define variable v-output-display as logical   no-undo .
      967       define variable v-other          as character no-undo .
      968       define variable v-range          as integer   no-undo .
      969       define variable var-region  as character no-undo.
      970       DEFINE VARIABLE v-sel-vals as character no-undo .
      971       DEFINE VARIABLE v-sel-labels as character no-undo .
      972       define variable varhost-code like ub.sysconf.host-code no-undo.
      973       define variable varobj-type like ub.clients.obj-type no-undo.
      974       define variable varobj-code like ub.clients.obj-code no-undo.
      975       define variable choice as integer no-undo .
      976       case var-object:
      977         when 'gds-obj-attr':U
      978         then do:
      979           run gdsoattr-name in this-procedure
      980             (input  p-code
      981             ,output v-type
      982             ,output v-format
      983             ,output v-label
      984             ,output v-user-can-edit
      985             ,output v-output-display
      986             ,output v-other
      987             ) no-error .
      988         end.
      989         when 'gds-host-attr':U
      990         then do:
      991           run gdshattr-name in this-procedure
      992             (input  p-code
      993             ,output v-type
      994             ,output v-format
      995             ,output v-label
      996             ,output v-user-can-edit
      997             ,output v-output-display
      998             ,output v-other
      999             ) no-error .
     1000         end.
     1001         when 'clients-attr':U
     1002         then do:
     1003           run clntattr-code in this-procedure
     1004             (input  p-code
     1005             ,output v-type
     1006             ,output v-format
     1007             ,output v-label
     1008             ,output v-user-can-edit
     1009             ,output v-output-display
     1010             ,output v-other
     1011             ) no-error .
     1012         end.
     1013         when 'goods-attr':U
     1014         then do:
     1015           run gds-attr-name in this-procedure
     1016             (input  p-code
     1017             ,output v-type
     1018             ,output v-format
     1019             ,output v-label
     1020             ,output v-user-can-edit
     1021             ,output v-output-display
     1022             ,output v-other
     1023             ) no-error .
     1024         end.
     1025         otherwise do:
     1026           undo, return error .
     1027         end.
     1028       END CASE.
     1029       if error-status :error then do:
     1030         undo, return error return-value .
     1031       end.
     1032       if not v-user-can-edit then do:
     1033         message
     1034         "Запрещено редактировать атрибут" v-label
     1035         view-as alert-box error .
     1036         undo, return error.
     1037       end.
     1038       find first buf_temp-attr exclusive-lock where
     1039                  buf_temp-attr.attr-code = p-code
     1040               and buf_temp-attr.host-code = p-host-code
     1041               and buf_temp-attr.obj-type = p-obj-type
     1042               and buf_temp-attr.obj-code = p-obj-code no-error .
     1043       if not available buf_temp-attr then do:
     1044         create buf_temp-attr .
     1045         assign
     1046           buf_temp-attr.attr-code = p-code
     1047           buf_temp-attr.host-code = p-host-code
     1048           buf_temp-attr.obj-type = p-obj-type
     1049           buf_temp-attr.obj-code = p-obj-code
     1050           buf_temp-attr.attr-value = p-value
     1051           buf_temp-attr.action = p-action
     1052           buf_temp-attr.code = v-label
     1053           buf_temp-attr.other-inf = v-other
     1054           no-error
     1055         .
     1056       end.
     1057       ELSE
     1058       ASSIGN
     1059       buf_temp-attr.attr-value = p-value no-error.
     1060     end.
     1061   end procedure.
     1062   procedure tempattr-exist :
     1063     do
     1064     on error undo, return error
     1065     :
     1066       define input parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
     1067       define input parameter p-host-code as integer no-undo .
     1068       define input parameter p-obj-type as character no-undo .
     1069       define input parameter p-obj-code as integer no-undo .
     1070       define output parameter p-exist    as logical no-undo .
     1071       define output parameter p-action as logical no-undo .
     1072       define buffer buf_temp-attr for temp-attr .
     1073       define variable v-type           as character no-undo .
     1074       define variable v-format         as character no-undo .
     1075       define variable v-label          as character no-undo .
     1076       define variable v-user-can-edit  as logical   no-undo .
     1077       define variable v-output-display as logical   no-undo .
     1078       define variable v-other          as character no-undo .
     1079       define variable v-range          as integer   no-undo .
     1080       case var-object:
     1081         when 'gds-obj-attr':U then do:
     1082           run gdsoattr-name in this-procedure
     1083             (input  p-code
     1084             ,output v-type
     1085             ,output v-format
     1086             ,output v-label
     1087             ,output v-user-can-edit
     1088             ,output v-output-display
     1089             ,output v-other
