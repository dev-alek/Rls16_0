     1097             ,output v-format
     1098             ,output v-label
     1099             ,output v-user-can-edit
     1100             ,output v-output-display
     1101             ,output v-other
     1102             ) no-error .
     1103         end.
     1104         when 'clients-attr':U
     1105         then do:
     1106           run clntattr-code in this-procedure
     1107             (input  p-code
     1108             ,output v-type
     1109             ,output v-format
     1110             ,output v-label
     1111             ,output v-user-can-edit
     1112             ,output v-output-display
     1113             ,output v-other
     1114             ) no-error .
     1115         end.
     1116         when 'goods-attr':U then do:
     1117           run gds-attr-name in this-procedure
     1118             (input  p-code
     1119             ,output v-type
     1120             ,output v-format
     1121             ,output v-label
     1122             ,output v-user-can-edit
     1123             ,output v-output-display
     1124             ,output v-other
     1125             ) no-error .
     1126         end.
     1127         otherwise do:
     1128           undo, return error .
     1129         end.
     1130       end case.
     1131       if error-status :error
     1132       then do:
     1133         undo, return error return-value .
     1134       end.
     1135       find first buf_temp-attr no-lock where
     1136                  buf_temp-attr.attr-code = p-code
     1137               and buf_temp-attr.host-code = p-host-code
     1138               and buf_temp-attr.obj-type = p-obj-type
     1139               and buf_temp-attr.obj-code = p-obj-code no-error .
     1140       if available buf_temp-attr then do:
     1141         P-EXIST = YES.
     1142         p-action = buf_temp-attr.action.
     1143       end.
     1144     end.
     1145   end procedure.
     1146   procedure tempattr-delete :
     1147     do
     1148     on error undo, return error
     1149     :
     1150       define input parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
     1151       define input parameter p-host-code as integer no-undo .
     1152       define input parameter p-obj-type as character no-undo .
     1153       define input parameter p-obj-code as integer no-undo .
     1154       define output parameter p-deleted  as logical no-undo .
     1155       define buffer buf_temp-attr for temp-attr .
     1156       define variable v-type           as character no-undo .
     1157       define variable v-format         as character no-undo .
     1158       define variable v-label          as character no-undo .
     1159       define variable v-user-can-edit  as logical   no-undo .
     1160       define variable v-output-display as logical   no-undo .
