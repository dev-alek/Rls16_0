      347   define  stream PrnLibStream.
      348   procedure prn-lib-prn-file :
      349     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      350     define input parameter p-DIsabledoptions as integer no-undo .
      351     define variable v-report-name as character no-undo .
      352     define variable v-user-action as character no-undo .
      353     define variable v-printed     as logical   no-undo .
      354     define variable v-exist       as logical   no-undo .
      355     do
      356       on error undo, return error
      357       :
      358       run prn-lib-get-report-name  in this-procedure (
      359         input parParentProc
      360         ,output v-report-name
      361         ).
      362   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      363   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      364     (input  v-report-name
      365     ,input  2
      366     ,output v-exist
      367     )  .
      368       if NOT v-exist then
      369       DO:
      370         Message
      371           "Нет заданий на печать ! "
      372           view-as alert-box .
      373         Return  .
      374       End.
      375       run gbl/prnfilen.w
      376         (input  ""
      377         ,input  p-DisabledOptions
      378         ,input  string(v-report-name )
      379         ,input  7
      380         ,output v-user-action
      381         ,output v-printed
      382         ) .
      383       if v-printed then
      384       do:
      385         return "YES" .
      386       end.
      387       else
      388       do:
      389         return "NO" .
      390       end.
      391     end.
      392   end procedure.
      393   procedure prn-lib-open-stream :
      394     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      395     define input parameter p-page-size    as integer no-undo .
      396     define input parameter p-is-stream    as logical no-undo .
      397     define input parameter p-append       as logical no-undo .
      398     define variable v-report-name as character no-undo .
      399     do
      400       on error undo, return error
      401       :
      402       run prn-lib-get-report-name  in this-procedure (
      403         input parParentProc
      404         ,output v-report-name
      405         ).
      406       if p-is-stream then
      407       do:
      408         if p-append then
      409         do:
      410           output stream PrnLibStream to value( v-report-name )
      411             page-size value(p-page-size) append .
      412         end.
      413         if not p-append then
      414         do:
      415           output stream PrnLibStream to value( v-report-name )
      416             page-size value(p-page-size) .
      417         end.
      418       end.
      419       if not p-is-stream then
      420       do:
      421         if p-append then
      422         do:
      423           output to value( v-report-name )
      424             page-size value(p-page-size) append .
      425         end.
      426         if not p-append then
      427         do:
      428           output to value( v-report-name )
      429             page-size value(p-page-size) .
      430         end.
      431       end.
      432     end.
      433   end procedure.
      434   procedure prn-lib-open-exp :
      435     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      436     define input parameter p-is-stream    as logical no-undo .
      437     define input parameter p-is-append    as logical no-undo .
      438     define output parameter p-ReportFileName as char init "report" no-undo.
      439     define output parameter p-process as logical no-undo .
      440     define variable glog as logical no-undo .
      441     do
      442       on error undo, return error
      443       :
      444       SYSTEM-DIALOG GET-FILE p-ReportFileName
      445         TITLE      "Укажите путь"
      446         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      447         ASK-OVERWRITE
      448         CREATE-TEST-FILE
      449         SAVE-AS
      450         USE-FILENAME
      451         DEFAULT-EXTENSION "txt"
      452         UPDATE glog
      453         .
      454       if not glog then  return.
      455       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      456       if p-is-stream then
      457       do:
      458         if p-is-append then
      459         do:
      460           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      461         end.
      462         else
      463         do:
      464           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      465         end.
      466       end.
      467       else
      468       do:
      469         if p-is-append then
      470         do:
      471           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      472         end.
      473         else
      474         do:
      475           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      476         end.
      477       end.
      478       p-process = yes.
      479     end.
      480   end procedure.
      481   procedure prn-lib-get-report-name :
      482     define input parameter parParentProc  as widget-handle no-undo.
      483     define output parameter p-report-name as character no-undo .
      484     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      485   end procedure.
      486   procedure prn-lib-reportviewer-report-name :
      487     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      488     define input parameter p-report-name-html as character no-undo .
      489     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      490   end procedure.
      491   procedure prn-lib-reportviewer :
      492     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      493     define input parameter p-report-name-html as character no-undo .
      494     define input parameter p-param        as character no-undo .
      495     define variable v-excel           as character no-undo init 'TRUE' .
      496     define variable v-value-character as character no-undo .
      497     define variable v-value-integer   as character no-undo .
      498     define variable v-value-date      as date      no-undo .
      499     define variable v-value-decimal   as decimal   no-undo .
      500     define variable rep-excel         as logical   no-undo .
      501     define variable excel-string      as character no-undo .
      502     define variable v-param-type      as character no-undo .
      503     define variable v-tth             as handle    no-undo .
      504     run adm/shattri.p (
      505       input "get":U
      506       ,input  ""
      507       ,input  0
      508       ,input  'report-glob':U
      509       ,input  'rep-excel':U
      510       ,output v-value-character
      511       ,output v-value-date
      512       ,output v-value-decimal
      513       ,output v-value-integer
      514       ,output rep-excel
      515       ,output v-param-type
      516       ,INPUT-OUTPUT table-handle v-tth
      517       )  .
      518     if rep-excel then v-excel = "TRUE" .
      519     else v-excel = "FALSE" .
      520     if p-param eq ""
      521     then
      522        p-param = "EXCEL:" + v-excel.
      523     else
      524        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      525     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      526   end procedure.
