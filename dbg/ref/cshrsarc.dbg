      800         del_cshr-month.obj-code COLUMN-LABEL "Маг-н" FORMAT "99999":U
      801         del_cshr-month.month_ COLUMN-LABEL "Ме!сяц" FORMAT "99":U
      802         del_cshr-month.year_ FORMAT "9999":U
      803         del_cshr-month.out-count COLUMN-LABEL "Продажа!(строк)" FORMAT "->>>>>>>":U
      804         del_cshr-month.out-qnty FORMAT "->>,>>>,>>>.<<<":U
      805         del_cshr-month.out-sum FORMAT "->>,>>>,>>>,>>>.<<":U
      806         del_cshr-month.ret-count COLUMN-LABEL "Возврат!(строк)" FORMAT "->>>>>>>":U
      807         del_cshr-month.ret-qnty FORMAT "->>,>>>,>>>.<<<":U
      808         del_cshr-month.ret-sum FORMAT "->>,>>>,>>>,>>>.<<":U
      809       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 8.33
