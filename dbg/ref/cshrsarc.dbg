     1413   procedure diasize_change-width :
     1414     define input  parameter p-change-value as decimal   no-undo .
     1415     define input  parameter p-move-resize  as logical   no-undo .
     1416     define variable v-field-group-handle   as handle    no-undo .
     1417     define variable v-object-handle        as handle    no-undo .
