     1423     define variable v-change-sign          as integer   no-undo .
     1424     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1425     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1426     if p-change-value > 0
     1427     then do:
     1428       if frame Dialog-Frame :width + p-change-value >
     1429           session :width-chars
     1430       then do:
     1431         assign
     1432           p-change-value = session :width-chars - frame Dialog-Frame :width
     1433         .
     1434         if p-change-value <= 0
     1435         then do:
     1436           run diasize_position-resize-button in this-procedure .
     1437           return .
     1438         end.
     1439       end.
     1440     end.
     1441     if p-change-value < 0
     1442     then do:
     1443       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1444       then do:
     1445         assign
     1446           p-change-value = v-diasize-orig-frame-width
     1447                          - frame Dialog-Frame :width
     1448         .
     1449         if p-change-value >= 0
     1450         then do:
     1451           run diasize_position-resize-button in this-procedure .
     1452           return .
     1453         end.
     1454       end.
     1455     end.
     1456     if p-change-value >= 0
     1457     then do:
     1458       assign
     1459         v-change-sign = 1
     1460       .
     1461     end.
     1462     else do:
     1463       assign
     1464         v-change-sign = -1
     1465       .
     1466     end.
     1467     assign
     1468       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1469     .
     1470     if p-change-value = 0
     1471     then do:
     1472       run diasize_position-resize-button in this-procedure .
     1473       return .
     1474     end.
