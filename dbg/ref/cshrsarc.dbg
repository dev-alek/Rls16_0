        1   DEFINE BUFFER del_cshr-month FOR ub.cshr-month.
        2   DEFINE BUFFER sum_cshr-month FOR ub.cshr-month.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter p-cashier-code like ub.cshr-month.cshr-code no-undo.
        5   define input parameter p-psn-code like ub.cshr-month.cshr-code no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Архивы по кассирам".
       12   procedure vss-get-info :
