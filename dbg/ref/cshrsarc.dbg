      912   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      913   procedure minbtn-set :
      914       do
      915           on error undo, return error return-value
      916           :
      917           define variable ii              as integer       no-undo .
      918           define variable fh              as widget-handle no-undo .
      919           define variable hh              as widget-handle no-undo .
      920           define variable v-h             as handle        extent 4 no-undo .
      921           define variable v-name-button   as character     no-undo .
      922           define variable v-help-old-x    as decimal       no-undo .
      923           define variable v-help-old-y    as decimal       no-undo .
      924           define variable v-help-old-size as decimal       no-undo .
      925           define variable v-frame-width   as decimal       no-undo .
      926           define variable jj              as integer       no-undo .
      927           do
      928               on error undo, return error
      929               :
      930               assign
      931                   v-frame-width = frame Dialog-Frame:width - 0.3
      932                   fh            = frame Dialog-Frame:first-child
      933                   hh            = fh:first-child
      934                   ii            = 1
      935                   .
      936               do while valid-handle(hh):
      937                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      938                   do:
      939                       case lc(hh:name) :
      940                           when "b-help" then
      941                               do:
      942                                   hh:load-image-up("cmp/b-help.bmp":u) .
      943                                   hh:load-image-down("cmp/b-help.bmp":u) .
      944                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      945                                   hh:TOOLTIP = "Помощь" .
      946                                   v-help-old-x = hh:column .
      947                                   v-help-old-y = hh:row    .
      948                                   v-help-old-size = hh:width .
      949                                   hh:width-chars = 2.5 .
      950                               end.
      951                           when "b-print" then
      952                               do:
      953                                   hh:load-image("cmp/b-print.bmp":u) .
      954                                   hh:TOOLTIP = "Печать" .
      955                                   v-h[ii] = hh:handle .
      956                                   ii = ii + 1 .
      957                                   hh:width-chars = 3 .
      958                               end.
      959                           when "b-history" or
      960                           when "b-hist" then
      961                               do:
      962                                   hh:load-image("cmp/b-hist.bmp":u) .
      963                                   hh:TOOLTIP = "История" .
      964                                   v-h[ii] = hh:handle .
      965                                   ii = ii + 1 .
      966                                   hh:width-chars = 3 .
      967                               end.
      968                           when "b-sch" then
      969                               do:
      970                                   hh:load-image("cmp/b-sch.bmp":u) .
      971                                   hh:TOOLTIP = "Установка Фильтра" .
      972                                   v-h[ii] = hh:handle .
      973                                   ii = ii + 1 .
      974                                   hh:width-chars = 3 .
      975                               end.
      976                           when "b-hist-user" then
      977                               do:
      978                                   hh:load-image("cmp/b-hist.bmp":u) .
      979                                   hh:TOOLTIP = "История пользователя" .
      980                                   ii = ii + 1 .
      981                               end.
      982                       end case.
      983                   end.
      984                   hh = hh:next-sibling.
      985               end.
      986               b-help:column = v-frame-width - b-help:width-chars.
      987               jj = 0.
      988               repeat ii = 4 to 1 by -1 :
      989                   if valid-handle (v-h[ii] ) then
      990                   do:
      991                       jj  = jj + 1 .
      992                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      993                       v-h[ii]:row    = v-help-old-y .
      994                   end.
      995               end.
      996           end.
      997       end.
      998   end procedure.
      999   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1000   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1001   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1002   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1003   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1004   define variable v-diasize-current-frame-height as decimal   no-undo .
     1005   define variable v-diasize-change-size          as logical   no-undo .
     1006   define variable v-diasize-resize-button        as handle    no-undo .
     1007   define variable v-diasize-wndmax               as logical   no-undo .
     1008   define variable v-diasize-wndstore             as logical   no-undo .
     1009   define variable v-diasize-proc-name            as character no-undo .
     1010   define variable v-diasize-browse-handle        as handle    no-undo .
     1011   define variable v-diasize-browse-number        as integer   no-undo .
     1012   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1013   define temp-table temp-diasize-handle no-undo
     1014     field handle-value  as handle
     1015     field save-position as decimal
     1016     index xpk is primary unique handle-value
     1017     .
     1018   define temp-table temp-browse-handle no-undo
     1019     field browse-type   as character
     1020     field browse-number as integer
     1021     field browse-handle as handle
     1022     field original-size as decimal
     1023     index xpk is primary unique browse-type browse-number
     1024     index xie browse-type browse-handle
     1025   .
     1026   procedure diasize_change-height :
     1027     define input  parameter p-change-value  as decimal   no-undo .
     1028     define input  parameter p-move-resize   as logical   no-undo .
     1029     define variable v-field-group-handle    as handle    no-undo .
     1030     define variable v-object-handle         as handle    no-undo .
     1031     define variable v-frame-height          as decimal   no-undo .
     1032     define variable v-frame-virtual-height  as decimal   no-undo .
     1033     define variable v-browse-height         as decimal   no-undo .
     1034     define variable v-window-height         as decimal   no-undo .
     1035     define variable v-window-virtual-height as decimal   no-undo .
     1036     define variable v-change-sign           as integer   no-undo .
     1037     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1038     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1039     if p-change-value > 0
     1040     then do:
     1041       if frame Dialog-Frame :height + p-change-value
     1042           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1043       then do:
     1044         assign
     1045           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1046                           - (frame Dialog-Frame :height-chars)
     1047         .
     1048         if p-change-value <= 0
     1049         then do:
     1050           run diasize_position-resize-button in this-procedure .
     1051           return .
     1052         end.
     1053       end.
     1054     end.
     1055     if p-change-value < 0
     1056     then do:
     1057       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1058       then do:
     1059         assign
     1060           p-change-value = v-diasize-orig-frame-height
     1061                          - (frame Dialog-Frame :height-chars)
     1062         .
     1063         if p-change-value >= 0
     1064         then do:
     1065           run diasize_position-resize-button in this-procedure .
     1066           return .
     1067         end.
     1068       end.
     1069     end.
     1070     if p-change-value >= 0
     1071     then do:
     1072       assign
     1073         v-change-sign = 1
     1074       .
     1075     end.
     1076     else do:
     1077       assign
     1078         v-change-sign = -1
     1079       .
     1080     end.
     1081     assign
     1082       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1083     .
     1084     if p-change-value = 0
     1085     then do:
     1086       run diasize_position-resize-button in this-procedure .
     1087       return .
     1088     end.
     1089     move_block:
     1090     do
     1091     on error undo move_block, retry move_block
     1092     :
     1093       if retry
     1094       then do:
     1095         do
     1096         on error undo move_block, leave move_block
     1097         :
     1098           if p-change-value > 0
     1099           then do:
     1100             for each buf_temp-diasize-handle
     1101             on error undo, next
     1102             :
     1103               assign
