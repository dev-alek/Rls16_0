      811            TITLE BGCOLOR 15 FGCOLOR 0 "Отмененные/аннулированные строки чеков".
      812   DEFINE BROWSE BR-cshr-sum
      813     QUERY BR-cshr-sum SHARE-LOCK NO-WAIT DISPLAY
      814         sum_cshr-month.cashier-psn-code COLUMN-LABEL "Код!физ.лица" FORMAT ">>>>>>>>9":U
      815         sum_cshr-month.obj-code COLUMN-LABEL "Маг-н" FORMAT "99999":U
      816         sum_cshr-month.month_ COLUMN-LABEL "Ме!сяц" FORMAT "99":U
      817         sum_cshr-month.year_ FORMAT "9999":U
      818         sum_cshr-month.out-totchk + sum_cshr-month.ret-totchk COLUMN-LABEL "Всего!чеков" FORMAT ">>>>>>>":U
      819         sum_cshr-month.out-totchk COLUMN-LABEL "Чеков!продаж" FORMAT ">>>>>>>":U
      820         sum_cshr-month.out-totsum + sum_cshr-month.ret-totsum COLUMN-LABEL "Выручка" FORMAT "->>,>>>,>>>,>>9.99":U
      821         sum_cshr-month.out-totsum FORMAT "->>,>>>,>>>,>>9.99":U
      822         sum_cshr-month.ret-totchk COLUMN-LABEL "Чеков!возвратов" FORMAT ">>>>>>>":U
      823         sum_cshr-month.ret-totsum FORMAT "->>,>>>,>>>,>>>.<<":U
      824       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 8.33
      825            BGCOLOR 15 FGCOLOR 0
      826            TITLE BGCOLOR 15 FGCOLOR 0 "Итоги продаж/возвратов".
      827   DEFINE FRAME Dialog-Frame
      828        Btn_Cancel AT ROW 1 COL 1
      829        b-print AT ROW 1 COL 51
      830        b-help AT ROW 1 COL 61
      831        BR-cshr-del AT ROW 2.46 COL 1
      832        BR-cshr-sum AT ROW 11.17 COL 1
