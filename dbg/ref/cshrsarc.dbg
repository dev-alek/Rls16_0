     1718         end.
     1719         for each buf_temp-browse-handle
     1720           where buf_temp-browse-handle.browse-type = 'width':u
     1721         on error undo move_block, retry move_block
     1722         :
     1723           assign
     1724             buf_temp-browse-handle.browse-handle :width
     1725               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1726             no-error .
     1727           if error-status :error
     1728           or error-status :get-message(1) <> ""
     1729           then do:
     1730             undo move_block, retry move_block .
     1731           end.
     1732         end.
     1733         assign
     1734           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1735           no-error .
     1736         if error-status :error
     1737         or error-status :get-message(1) <> ""
     1738         then do:
     1739           undo move_block, retry move_block.
     1740         end.
     1741         assign
     1742           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1743         no-error .
     1744         if error-status :error
     1745         or error-status :get-message(1) <> ""
     1746         then do:
     1747           undo move_block, retry move_block.
     1748         end.
     1749         if frame Dialog-Frame :scrollable = true
     1750         then do:
     1751           assign
     1752             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1753           no-error .
     1754           if error-status :error
     1755           or error-status :get-message(1) <> ""
     1756           then do:
     1757             undo move_block, retry move_block.
     1758           end.
     1759         end.
     1760       end.
     1761       if p-move-resize
     1762       then do:
     1763         run diasize_position-resize-button in this-procedure .
     1764       end.
     1765       if v-diasize-wndstore = true
     1766       then do:
     1767         if connected("ub") = true
     1768         then do:
     1769           define variable v-cntxt-db-num        as integer   no-undo .
     1770           define variable v-cntxt-userid        as character no-undo .
     1771           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1772                                             , OUTPUT v-cntxt-userid
     1773                                             ) .
     1774           run gbl/wndsizew.p
     1775             (input  v-cntxt-db-num
     1776             ,input  v-cntxt-userid
     1777             ,input  v-diasize-proc-name
     1778             ,input  'width':u
     1779             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1780             ) .
     1781         end.
     1782       end.
     1783     end.
     1784     assign
     1785       v-diasize-change-size = false
     1786     .
     1787   end procedure.
     1788   procedure diasize_set-width :
     1789     define input  parameter p-new-width  as decimal   no-undo .
     1790     define input  parameter p-move-resize as logical   no-undo .
     1791     do
     1792     on error undo, return error return-value
     1793     :
     1794       run diasize_change-width in this-procedure
     1795         (input  (p-new-width - frame Dialog-Frame :width)
     1796         ,input  p-move-resize
     1797         ) .
     1798     end.
     1799   end procedure.
     1800   procedure diasize_position-resize-button :
     1801     do with frame Dialog-Frame
     1802     :
     1803       hide v-diasize-resize-button .
     1804       assign
     1805         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1806                     - 1
     1807                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1808         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1809                     - 1
     1810                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1811       .
     1812       view v-diasize-resize-button .
     1813     end.
     1814   end procedure.
     1815   on alt-right anywhere
     1816   do:
     1817     run diasize_change-width in this-procedure
     1818       (input 1
     1819       ,input true
     1820       ) .
     1821     return no-apply .
     1822   end.
     1823   on alt-left anywhere
     1824   do:
     1825     run diasize_change-width in this-procedure
     1826       (input -1
     1827       ,input true
     1828       ) .
     1829     return no-apply .
     1830   end.
     1831   on alt-down anywhere
     1832   do:
     1833     run diasize_change-height in this-procedure
     1834       (input 1
     1835       ,input true
     1836       ) .
     1837     return no-apply .
     1838   end.
     1839   on alt-up anywhere
     1840   do:
     1841     run diasize_change-height in this-procedure
     1842       (input -1
     1843       ,input true
     1844       ) .
     1845     return no-apply .
     1846   end.
     1847   on alt-enter of frame Dialog-Frame
     1848   do:
     1849     run diasize_maximize in this-procedure
     1850       (input  ?
     1851       ).
     1852     return no-apply .
     1853   end.
     1854   procedure diasize_end-move :
     1855     do
     1856     on error undo, return error return-value
     1857     :
     1858       define variable v-row-delta as decimal   no-undo .
     1859       define variable v-col-delta as decimal   no-undo .
     1860       define variable v-new-row as decimal   no-undo .
     1861       define variable v-new-col as decimal   no-undo .
     1862       assign
     1863         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1864         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1865       .
     1866       assign
     1867         v-row-delta = v-new-row - frame Dialog-Frame :height
     1868         v-col-delta = v-new-col - frame Dialog-Frame :width
     1869       .
     1870       run diasize_change-height in this-procedure
     1871         (input v-row-delta
     1872         ,input true
     1873         ) .
     1874       run diasize_change-width in this-procedure
     1875         (input v-col-delta
     1876         ,input true
     1877         ) .
     1878     end.
     1879   end procedure.
     1880   procedure diasize_maximize :
     1881     define input  parameter p-action as logical   no-undo .
     1882     do
     1883     on error undo, return error return-value
     1884     :
     1885       if p-action = ?
     1886       then do:
     1887         if v-diasize-need-maximize = true
     1888         then do:
     1889           assign
     1890             p-action = true
     1891           .
     1892         end.
     1893         else do:
     1894           assign
     1895             p-action = false
     1896           .
     1897         end.
     1898       end.
     1899       if p-action = true
     1900       then do:
     1901         run diasize_change-height in this-procedure
     1902           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1903               - frame Dialog-Frame :height-chars
     1904           ,input true
     1905           ) .
     1906         run diasize_change-width in this-procedure
     1907           (input session :width-chars
     1908               - frame Dialog-Frame :width-chars
     1909           ,input true
     1910           ) .
     1911         assign
     1912           v-diasize-need-maximize = false
     1913         .
     1914       end.
     1915       else do:
     1916         run diasize_change-width in this-procedure
     1917           (input v-diasize-orig-frame-width
     1918               - frame Dialog-Frame :width-chars
     1919           ,input true
     1920           ) .
     1921         run diasize_change-height in this-procedure
     1922           (input v-diasize-orig-frame-height
     1923               - frame Dialog-Frame :height-chars
     1924           ,input true
     1925           ) .
     1926         assign
     1927           v-diasize-need-maximize = true
     1928         .
     1929       end.
     1930     end.
     1931   end procedure.
     1932   procedure diasize_restore-orig-size :
     1933     do
     1934     on error undo, return error return-value
     1935     :
     1936       assign
     1937         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1938         v-diasize-current-frame-height = frame Dialog-Frame :height
     1939       .
     1940       run diasize_set-height in this-procedure
     1941         (input  v-diasize-orig-frame-height
     1942         ,input  true
     1943         ) .
     1944       run diasize_set-width in this-procedure
     1945         (input  v-diasize-orig-frame-width
     1946         ,input  true
     1947         ) .
     1948     end.
     1949   end procedure.
     1950   procedure diasize_restore-current-size :
     1951     do
     1952     on error undo, return error return-value
     1953     :
     1954       run diasize_set-height in this-procedure
     1955         (input  v-diasize-current-frame-height
     1956         ,input  true
     1957         ) .
     1958       run diasize_set-width in this-procedure
     1959         (input  v-diasize-current-frame-width
     1960         ,input  true
     1961         ) .
     1962     end.
     1963   end procedure.
     1964   procedure diasize_set-browse-handle :
     1965     define input  parameter p-browse-handle as handle   no-undo .
     1966     define buffer buf_temp-browse-handle for temp-browse-handle .
     1967     do
     1968     on error undo, return error return-value
     1969     :
     1970       assign
     1971         v-diasize-browse-handle = p-browse-handle
     1972       .
     1973       for each buf_temp-browse-handle
     1974       on error undo, return error return-value
     1975       :
     1976         delete buf_temp-browse-handle .
     1977       end.
     1978     end.
     1979   end procedure.
     1980   procedure diasize_add_browse :
     1981     define input  parameter p-browse-type   as character no-undo .
     1982     define input  parameter p-browse-handle as handle    no-undo .
     1983     define buffer buf_temp-browse-handle for temp-browse-handle .
     1984     do
     1985     on error undo, return error return-value
     1986     :
     1987       assign
     1988         v-diasize-browse-number = v-diasize-browse-number + 1
     1989       .
     1990       create buf_temp-browse-handle .
     1991       assign
     1992         buf_temp-browse-handle.browse-type   = p-browse-type
     1993         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1994         buf_temp-browse-handle.browse-handle = p-browse-handle
     1995       .
     1996     end.
     1997   end procedure.
     1998   procedure diasize_init :
     1999     define variable v-default-value    as logical   no-undo .
     2000     define variable v-restore-saved    as logical   no-undo .
     2001     define variable v-resize-value-str as character no-undo .
     2002     do
     2003     on error undo, return error return-value
     2004     :
     2005       do with frame Dialog-Frame
     2006       :
     2007         assign
     2008           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2009           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2010           v-diasize-browse-handle     = browse br-cshr-sum :handle
     2011         .
     2012         create button v-diasize-resize-button
     2013         assign
     2014           parent        = frame Dialog-Frame :first-child
     2015           label         = "s"
     2016           height-pixels = 16
     2017           width-pixels  = 16
     2018           visible       = true
     2019           sensitive     = true
     2020           movable       = true
     2021           triggers:
     2022             on end-move persistent run diasize_end-move in this-procedure .
     2023           end triggers.
     2024         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2025         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2026         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2027         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2028         assign
     2029           v-diasize-wndmax = false
     2030         .
     2031         if connected("ub") = true
     2032         then do:
     2033           define variable v-cntxt-db-num        as integer   no-undo .
     2034           define variable v-cntxt-userid        as character no-undo .
     2035           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2036                                             , OUTPUT v-cntxt-userid
     2037                                             ) .
     2038           run gbl/wndpar_r.p
     2039             (input  v-cntxt-db-num
     2040             ,input  v-cntxt-userid
     2041             ,input  'wndmax':U
     2042             ,output v-diasize-wndmax
     2043             ,output v-default-value
     2044             ) .
     2045         end.
     2046         assign
     2047           v-diasize-wndstore = false
     2048         .
     2049         if connected("ub") = true
     2050         then do:
     2051           run gbl/wndpar_r.p
     2052             (input  v-cntxt-db-num
     2053             ,input  v-cntxt-userid
     2054             ,input  'wndstore':U
     2055             ,output v-diasize-wndstore
     2056             ,output v-default-value
     2057             ) .
     2058         end.
     2059         assign
     2060           v-diasize-proc-name = entry(1, program-name(2), '.')
     2061         .
     2062         if v-diasize-wndstore = true
     2063         then do:
     2064           assign
     2065             v-restore-saved = false
     2066           .
     2067           if connected("ub") = true
     2068           then do:
     2069             run gbl/wndsizer.p
     2070               (input  v-cntxt-db-num
     2071               ,input  v-cntxt-userid
     2072               ,input  v-diasize-proc-name
     2073               ,input  'height':u
     2074               ,output v-resize-value-str
     2075               ) .
     2076             if v-resize-value-str <> '':U
     2077             then do:
     2078               run diasize_change-height in this-procedure
     2079                 (input  integer(v-resize-value-str)
     2080                 ,input  true
     2081                 ) .
     2082               assign
     2083                 v-restore-saved = true
     2084               .
     2085             end.
     2086           end.
     2087           if connected("ub") = true
     2088           then do:
     2089             run gbl/wndsizer.p
     2090               (input  v-cntxt-db-num
     2091               ,input  v-cntxt-userid
     2092               ,input  v-diasize-proc-name
     2093               ,input  'width':u
     2094               ,output v-resize-value-str
     2095               ) .
     2096             if v-resize-value-str <> '':U
     2097             then do:
     2098               run diasize_change-width in this-procedure
     2099                 (input  integer(v-resize-value-str)
     2100                 ,input  true
     2101                 ) .
     2102               assign
     2103                 v-restore-saved = true
     2104               .
     2105             end.
     2106           end.
     2107           if v-restore-saved <> true
     2108           then do:
     2109             if v-diasize-wndmax = true
     2110             then do:
     2111               run diasize_maximize in this-procedure
     2112                 (input  true
     2113                 ) .
     2114             end.
     2115           end.
     2116         end.
     2117         else do:
     2118           if v-diasize-wndmax = true
     2119           then do:
     2120             run diasize_maximize in this-procedure
     2121               (input  true
     2122               ) .
     2123           end.
     2124         end.
     2125       end.
     2126     end.
     2127   end procedure.
     2128   procedure diasize_need-full-display :
     2129     define output parameter p-need-full-display as logical   no-undo .
     2130     do
     2131     on error undo, return error return-value
     2132     :
     2133       assign
     2134         p-need-full-display = v-diasize-need-full-display
     2135       .
     2136       assign
     2137         v-diasize-need-full-display = false
     2138       .
     2139     end.
     2140   end procedure.
     2141   procedure get-context :
     2142      define output parameter p-db-num as integer          no-undo.
     2143      define output parameter p-user-id as character        no-undo.
     2144      define variable v-login               as character    no-undo.
     2145      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2146      define buffer buf_user-login  for ub.user-login .
     2147      do
     2148      on error undo, return error
     2149      :
     2150            FIND FIRST buf_sys-ctrl no-lock.
     2151            ASSIGN
     2152               v-login = USERID("ub")
     2153               p-db-num = buf_sys-ctrl.db-num
     2154            .
     2155            FIND FIRST buf_user-login
     2156                 WHERE buf_user-login.db-num = p-db-num
     2157                   AND buf_user-login.user-login = v-login
     2158                 no-lock
     2159                 no-error
     2160                 .
     2161            IF AVAILABLE buf_user-login
     2162            THEN DO:
     2163               assign
     2164                  p-user-id = buf_user-login.user-id
     2165               .
     2166            END.
     2167      end.
     2168   end procedure.
     2169   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2170   do:
     2171     BR-cshr-del :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2172   end.
     2173   MAIN-BLOCK:
     2174   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2175      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2176       FIND FIRST ub.person WHERE ub.person.psn-code = p-psn-code NO-LOCK .
     2177       FIND ub.clients WHERE ub.clients.obj-type = 'чел':U AND
     2178                                          ub.clients.obj-code = ub.person.psn-code NO-LOCK .
     2179       FRAME Dialog-Frame:title = substitute("Архивы по кассиру ( код &1 )   &2"
     2180                                             , p-cashier-code
     2181                                             , clients.obj-name).
     2182       RUN MYenable in this-procedure .
     2183       apply "entry" to BR-cshr-sum in FRAME Dialog-Frame.
     2184       run diasize_add_browse in this-procedure
     2185           (input  'width':u
     2186           ,input  browse br-cshr-del:handle
     2187           ) .
     2188         run diasize_init in this-procedure .
     2189       WAIT-FOR GO OF FRAME Dialog-Frame.
     2190   END.
     2191   RUN disable_UI.
     2192   PROCEDURE disable_UI :
     2193     HIDE FRAME Dialog-Frame.
     2194   END PROCEDURE.
     2195   PROCEDURE enable_UI :
     2196     ENABLE Btn_Cancel b-print b-help BR-cshr-del BR-cshr-sum
     2197         WITH FRAME Dialog-Frame.
     2198     VIEW FRAME Dialog-Frame.
     2199     OPEN QUERY BR-cshr-del FOR EACH del_cshr-month       WHERE del_cshr-month.cshr-code = p-cashier-code AND ( del_cshr-month.cashier-psn-code = p-psn-code or del_cshr-month.cashier-psn-code = 0)  AND ( del_cshr-month.out-count <> 0  OR del_cshr-month.ret-count <> 0 )  SHARE-LOCK INDEXED-REPOSITION.    OPEN QUERY BR-cshr-sum FOR EACH sum_cshr-month       WHERE sum_cshr-month.cshr-code = p-cashier-code and ( sum_cshr-month.cashier-psn-code = p-psn-code or sum_cshr-month.cashier-psn-code = 0) SHARE-LOCK INDEXED-REPOSITION.
     2200   END PROCEDURE.
     2201   PROCEDURE MyEnable :
     2202   assign
     2203   b-print:MENU-MOUSE in frame Dialog-Frame = 1
     2204   .
     2205   ENABLE
     2206   b-print
     2207   Btn_Cancel
     2208   b-help
     2209   BR-cshr-sum
     2210   BR-cshr-del
     2211   WITH FRAME Dialog-Frame .
     2212   VIEW FRAME Dialog-Frame .
     2213   OPEN QUERY BR-cshr-del FOR EACH del_cshr-month       WHERE del_cshr-month.cshr-code = p-cashier-code AND ( del_cshr-month.cashier-psn-code = p-psn-code or del_cshr-month.cashier-psn-code = 0)  AND ( del_cshr-month.out-count <> 0  OR del_cshr-month.ret-count <> 0 )  SHARE-LOCK INDEXED-REPOSITION.    OPEN QUERY BR-cshr-sum FOR EACH sum_cshr-month       WHERE sum_cshr-month.cshr-code = p-cashier-code and ( sum_cshr-month.cashier-psn-code = p-psn-code or sum_cshr-month.cashier-psn-code = 0) SHARE-LOCK INDEXED-REPOSITION.
     2214   END PROCEDURE.
     2215   PROCEDURE proc-b-print :
     2216   DEFINE INPUT-output  PARAMETER p-print-option as character no-undo.
     2217   define variable v-doc-rec as recid no-undo.
     2218   DEFINE VARIABLE date_string  as character no-undo.
     2219   DEFINE VARIABLE Line as character no-undo .
     2220   DEFINE VARIABLE for-all-totchk  like ub.cshr-month.out-totchk no-undo .
     2221   DEFINE VARIABLE for-all-totsum  like ub.cshr-month.out-totsum no-undo .
     2222   DEFINE VARIABLE accum-out-count like ub.cshr-month.out-count no-undo.
     2223   DEFINE VARIABLE accum-out-qnty like ub.cshr-month.out-qnty no-undo .
     2224   DEFINE VARIABLE accum-out-sum like ub.cshr-month.out-sum no-undo .
     2225   DEFINE VARIABLE accum-ret-count  like ub.cshr-month.ret-count no-undo .
     2226   DEFINE VARIABLE accum-ret-qnty like ub.cshr-month.ret-qnty no-undo .
     2227   DEFINE VARIABLE accum-ret-sum  like ub.cshr-month.ret-sum no-undo .
     2228   DEFINE VARIABLE accum-all-totchk like ub.cshr-month.out-totchk no-undo .
     2229   DEFINE VARIABLE accum-out-totchk like ub.cshr-month.out-totchk no-undo .
     2230   DEFINE VARIABLE accum-all-totsum like ub.cshr-month.out-totsum no-undo .
     2231   DEFINE VARIABLE accum-out-totsum like ub.cshr-month.out-totsum no-undo .
     2232   DEFINE VARIABLE accum-ret-totchk like ub.cshr-month.ret-totchk no-undo .
     2233   DEFINE VARIABLE accum-ret-totsum like ub.cshr-month.ret-totsum no-undo .
     2234   define variable v-header-base-curr as character no-undo .
     2235   define variable v-curr-r-b as character no-undo .
     2236   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2237   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2238     (output v-curr-r-b
     2239     )  .
     2240   if v-curr-r-b = 'base':U then do:
     2241     assign
     2242     v-header-base-curr = string( "( Баз.Вал. )" )
     2243     .
     2244   end.
     2245   DEFINE FRAME del-List
     2246   del_cshr-month.cashier-psn-code COLUMN-LABEL "Код!физ.лица"
     2247   del_cshr-month.obj-code COLUMN-LABEL "Маг-н"
     2248   del_cshr-month.month_ COLUMN-LABEL "Ме!сяц"
     2249   del_cshr-month.year_
     2250   del_cshr-month.out-count COLUMN-LABEL "Продажа!(строк)" FORMAT "->>>>>>9"
     2251   del_cshr-month.out-qnty FORMAT "->>,>>>,>>9.999"
     2252   del_cshr-month.out-sum FORMAT "->>,>>>,>>>,>>9.99"
     2253   del_cshr-month.ret-count COLUMN-LABEL "Возврат!(строк)" FORMAT "->>>>>>9"
     2254   del_cshr-month.ret-qnty FORMAT "->>,>>>,>>9.999"
     2255   del_cshr-month.ret-sum FORMAT "->>,>>>,>>>,>>9.99"
     2256   HEADER  date_string AT 5 format "X(35)"
     2257   v-header-base-curr       format "X(20)"
     2258   string( "Страница " ) format "X(9)" AT 90 PAGE-NUMBER(PrnLibStream) AT 100 FORMAT ">>9" SKIP
     2259   Line format "X(114)" AT 1
     2260   with width 232 down stream-io use-text    .
     2261   DEFINE FRAME sum-List
     2262   sum_cshr-month.cashier-psn-code COLUMN-LABEL "Код!физ.лица"
     2263   sum_cshr-month.obj-code COLUMN-LABEL "Маг-н"
     2264   sum_cshr-month.month_ COLUMN-LABEL "Ме!сяц"
     2265   sum_cshr-month.year_
     2266   for-all-totchk   COLUMN-LABEL "Всего!чеков" FORMAT ">>>>>>9"
     2267   sum_cshr-month.out-totchk COLUMN-LABEL "Чеков!продаж" FORMAT ">>>>>>9"
     2268   for-all-totsum  COLUMN-LABEL "Выручка" FORMAT "->>,>>>,>>>,>>9.99"
     2269   sum_cshr-month.out-totsum FORMAT "->>,>>>,>>>,>>9.99"
     2270   sum_cshr-month.ret-totchk COLUMN-LABEL "Чеков!возвратов" FORMAT ">>>>>>9"
     2271   sum_cshr-month.ret-totsum FORMAT "->>,>>>,>>>,>>9.99"
     2272   HEADER  date_string AT 5 format "X(35)"
     2273   v-header-base-curr       format "X(20)"
     2274   string( "Страница " ) format "X(9)" AT 90 PAGE-NUMBER(PrnLibStream) AT 100 FORMAT ">>9" SKIP
     2275   Line format "X(105)" AT 1
     2276   with width 232 down stream-io use-text    .
     2277   date_string = cur-time-print() .
     2278   case p-print-option:
     2279     when "cshr-del":U then do:
     2280         assign
     2281         v-doc-rec = recid(del_cshr-month)
     2282         .
     2283       DO WHILE available del_cshr-month :
     2284             GET prev BR-cshr-del.
     2285       END.
     2286       Line = fill("-", 114).
     2287       run prn-lib-open-stream  in this-procedure (
     2288                                                   input parParentProc
     2289                                                   ,input 62
     2290                                                   ,input yes
     2291                                                   ,input no
     2292                                                   ).
     2293       PUT  STREAM PrnLibStream
     2294       SPACE(25) ( frame Dialog-Frame:title ) format "x(90)" skip
     2295       space(25) br-cshr-del:title  format "x(90)" SKIP(1) .
     2296       FORM HEADER
     2297       Line format "X(114)" AT 1 SKIP
     2298       "Продолжение - на следующей странице" AT 30 SKIP
     2299       with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2300       VIEW  STREAM PrnLibStream FRAME BottomFrame .
     2301       FORM with FRAME Del-List  .
     2302       run waitfram-show in this-procedure ("Ждите...").
     2303       GET next br-cshr-del.
     2304       DO WHILE available del_cshr-month :
     2305         Display STREAM PrnLibStream
     2306         del_cshr-month.cashier-psn-code
     2307         del_cshr-month.obj-code
     2308         del_cshr-month.month_
     2309         del_cshr-month.year_
     2310         del_cshr-month.out-count
     2311         del_cshr-month.out-qnty
     2312         del_cshr-month.out-sum
     2313         del_cshr-month.ret-count
     2314         del_cshr-month.ret-qnty
     2315         del_cshr-month.ret-sum
     2316         with FRAME Del-List .
     2317         DOWN STREAM PrnLibStream 1 with FRAME Del-List  .
     2318         assign
     2319         accum-out-count = accum-out-count + del_cshr-month.out-count
     2320         accum-out-qnty = accum-out-qnty + del_cshr-month.out-qnty
     2321         accum-out-sum = accum-out-sum + del_cshr-month.out-sum
     2322         accum-ret-count  = accum-ret-sum + del_cshr-month.ret-count
     2323         accum-ret-qnty = accum-ret-qnty + del_cshr-month.ret-qnty
     2324         accum-ret-sum = accum-ret-sum + del_cshr-month.ret-sum
     2325         .
     2326         GET next br-cshr-del.
     2327       END.
     2328       UNDERLINE  STREAM PrnLibStream
     2329       del_cshr-month.cashier-psn-code
     2330       del_cshr-month.obj-code
     2331       del_cshr-month.month_
     2332       del_cshr-month.year_
     2333       del_cshr-month.out-count
     2334       del_cshr-month.out-qnty
     2335       del_cshr-month.out-sum
     2336       del_cshr-month.ret-count
     2337       del_cshr-month.ret-qnty
     2338       del_cshr-month.ret-sum
     2339       with FRAME Del-List .
     2340       DISPLAY STREAM PrnLibStream
     2341       "ИТОГО" @ del_cshr-month.obj-code
     2342       accum-out-count @ del_cshr-month.out-count
     2343       accum-out-qnty @  del_cshr-month.out-qnty
     2344       accum-out-sum @   del_cshr-month.out-sum
     2345       accum-ret-count @  del_cshr-month.ret-count
     2346       accum-ret-qnty  @ del_cshr-month.ret-qnty
     2347       accum-ret-sum @ del_cshr-month.ret-sum
     2348       with frame Del-List.
     2349       HIDE  STREAM PrnLibStream FRAME BottomFrame .
     2350       HIDE  STREAM PrnLibStream FRAME CheckList.
     2351       output  STREAM PrnLibStream CLOSE.
     2352       run waitfram-hide in this-procedure .
     2353       run prn-lib-prn-file in this-procedure (
     2354                                                 input parParentProc
     2355                                                 ,input 0
     2356                                                 ).
     2357       reposition br-cshr-del to recid v-doc-rec no-error.
     2358       apply "entry" to br-cshr-del in frame Dialog-Frame.
     2359     end.
     2360     when "cshr-sum":U then do:
     2361         assign
     2362         v-doc-rec = recid(sum_cshr-month)
     2363         .
     2364       DO WHILE available sum_cshr-month :
     2365             GET prev BR-cshr-sum.
     2366       END.
     2367       Line = fill("-", 105).
     2368       run prn-lib-open-stream  in this-procedure (
     2369                                                   input parParentProc
     2370                                                   ,input 62
     2371                                                   ,input yes
     2372                                                   ,input no
     2373                                                   ).
     2374       PUT  STREAM PrnLibStream
     2375       SPACE(25) ( frame Dialog-Frame:title ) format "x(90)"  skip
     2376       space(25) br-cshr-sum:title  format "x(90)"
     2377       SKIP(1) .
     2378       FORM HEADER
     2379       Line format "X(105)" AT 1 SKIP
     2380       "Продолжение - на следующей странице" AT 30 SKIP
     2381       with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2382       VIEW  STREAM PrnLibStream FRAME BottomFrame .
     2383       FORM with FRAME SUm-List  .
     2384       run waitfram-show in this-procedure ("Ждите...").
     2385       GET next br-cshr-sum.
     2386       DO WHILE available sum_cshr-month :
     2387         Display STREAM PrnLibStream
     2388         sum_cshr-month.cashier-psn-code
     2389         sum_cshr-month.obj-code
     2390         sum_cshr-month.month_
     2391         sum_cshr-month.year_
     2392         (sum_cshr-month.out-totchk + sum_cshr-month.ret-totchk) @  for-all-totchk
     2393         sum_cshr-month.out-totchk
     2394         (sum_cshr-month.out-totsum + sum_cshr-month.ret-totsum ) @ for-all-totsum
     2395         sum_cshr-month.out-totsum
     2396         sum_cshr-month.ret-totchk
     2397         sum_cshr-month.ret-totsum
     2398         with FRAME sum-List .
     2399         DOWN STREAM PrnLibStream 1 with FRAME sum-List  .
     2400         assign
     2401         accum-all-totchk = accum-all-totchk + sum_cshr-month.out-totchk + sum_cshr-month.ret-totchk
     2402         accum-out-totchk = accum-out-totchk + sum_cshr-month.out-totchk
     2403         accum-all-totsum = accum-all-totsum + sum_cshr-month.out-totsum + sum_cshr-month.ret-totsum
     2404         accum-out-totsum = accum-out-totsum + sum_cshr-month.out-totsum
     2405         accum-ret-totchk = accum-ret-totchk + sum_cshr-month.ret-totchk
     2406         accum-ret-totsum = accum-ret-totsum + sum_cshr-month.ret-totsum
     2407         .
     2408         GET next br-cshr-sum.
     2409       END.
     2410       UNDERLINE  STREAM PrnLibStream
     2411       sum_cshr-month.cashier-psn-code
     2412       sum_cshr-month.obj-code
     2413       sum_cshr-month.month_
     2414       sum_cshr-month.year_
     2415       for-all-totchk
     2416       sum_cshr-month.out-totchk
     2417       for-all-totsum
     2418       sum_cshr-month.out-totsum
     2419       sum_cshr-month.ret-totchk
     2420       sum_cshr-month.ret-totsum
     2421       with FRAME sum-List .
     2422       DISPLAY STREAM PrnLibStream
     2423       "ИТОГО" @ sum_cshr-month.obj-code
     2424       accum-all-totchk @ for-all-totchk
     2425       accum-out-totchk @ sum_cshr-month.out-totchk
     2426       accum-all-totsum @ for-all-totsum
     2427       accum-out-totsum @ sum_cshr-month.out-totsum
     2428       accum-ret-totchk @ sum_cshr-month.ret-totchk
     2429       accum-ret-totsum @ sum_cshr-month.ret-totsum
     2430       with frame sum-List.
     2431       HIDE  STREAM PrnLibStream FRAME BottomFrame .
     2432       HIDE  STREAM PrnLibStream FRAME CheckList.
     2433       output  STREAM PrnLibStream CLOSE.
     2434       run waitfram-hide in this-procedure .
     2435       run prn-lib-prn-file in this-procedure (
     2436                                                 input parParentProc
     2437                                                 ,input 0
     2438                                                 ).
     2439       reposition br-cshr-sum to recid v-doc-rec no-error.
     2440       apply "entry" to br-cshr-sum in frame Dialog-Frame.
     2441     end.
     2442   END CASE.
     2443   assign
     2444   p-print-option = ""
     2445   .
     2446   END PROCEDURE.
