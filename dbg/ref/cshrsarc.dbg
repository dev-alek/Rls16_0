      890   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      891   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      892   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      893   on help of frame Dialog-Frame
      894   do:
      895     run gbl/app_help.p
      896       (input this-procedure :file-name
      897       ,input ''
      898       ,input ?
      899       ) no-error.
      900     if error-status :error then do:
      901       message
      902         "Ошибка при вызове помощи"
      903         error-status :get-message(1)
      904         view-as alert-box .
      905     end.
      906   end.
      907   run minbtn-set in this-procedure .
      908   on choose of b-help in frame Dialog-Frame
      909   do:
      910     apply "help":u to frame Dialog-Frame .
