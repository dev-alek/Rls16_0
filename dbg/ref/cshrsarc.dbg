      554     .
      555   define new global shared variable mBatchMode as logical no-undo init ?.
      556   define variable mFramBachModHandle as handle no-undo.
      557   mFramBachModHandle = frame waitfram:handle.
      558   define variable mFameOldVis as logical no-undo.
      559   define variable mVisCUrentVin as logical no-undo.
      560   if session:batch-mode
      561   then
      562      mBatchMode = yes.
      563   if mBatchMode = ? then do:
      564     mVisCUrentVin = current-window:visible.
      565     mFameOldVis = mFramBachModHandle:visible.
      566     mFramBachModHandle:visible  = yes.
      567     mBatchMode = mFramBachModHandle:visible ne yes.
      568     mFramBachModHandle:visible = mFameOldVis.
      569     current-window:visible = mVisCUrentVin.
      570   end.
      571    if  log-manager:logfile-name ne ?
      572     then DO:
      573         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      574         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      575         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      576     end.
      577   on choose of B-WaitFramStop in frame waitfram
      578   do:
      579     mWaitFramStop = yes.
      580     mWaitFramStopUser = yes.
      581   end.
      582   function waitfram-check-timeout returns logical():
      583      define variable vtime as int64 no-undo.
      584      if mWaitFramStopTimeOut
      585      then
      586         return yes.
      587      vtime = ( now - mWaitFramStartProc ) / 1000 .
      588      if     mWaitFramTimeOut ne ?
      589         and mWaitFramTimeOut ne 0
      590         and mWaitFramTimeOut lt vtime
      591      then do:
      592         mWaitFramStopTimeOut = yes.
      593      end.
      594      return mWaitFramStopTimeOut.
      595   end.
      596   procedure waitfram-hide :
      597     if not session:batch-mode
      598     then do
      599     on error undo, return error return-value
      600     :
      601       pause 0 before-hide .
      602       if not mBatchMode then
      603         hide frame waitfram .
      604     if     not mWaitFramView
      605        and mWaitProcEvent
      606     then
      607       process events .
      608     end.
      609   end procedure.
      610   procedure waitfram-show :
      611     define input  parameter p-message as character no-undo .
      612     define variable v-left-margin as integer   no-undo .
      613     if not session:batch-mode
      614     then do
      615     on error undo, return error return-value
      616     :
      617       if length(p-message) <= 70 then do:
      618         assign
      619           v-left-margin = integer((70 - length(p-message)) / 2)
      620         .
      621         assign
      622           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      623         .
      624         assign
      625           v-waitfram-action01 = " "
      626           v-waitfram-action02 = " "
      627                                    + fill(" ", v-left-margin)
      628                                    + p-message
      629           v-waitfram-action03 = " "
      630         .
      631       end.
      632       else do:
      633         define variable vRindex1 as integer no-undo.
      634         define variable vRindex2 as integer no-undo.
      635         vRindex1 = r-index(p-message," ",70).
      636         if vRindex1 = 0
      637         then
      638            vRindex1 = 70.
      639         if length(p-message)  <= vRindex1 + 70 then do:
      640           assign
      641             v-waitfram-action01 = " "
      642             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      643             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      644           .
      645         end.
      646         else do:
      647           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      648           if vRindex2 <= vRindex1
      649           then
      650              vRindex2 = vRindex1 + 70.
      651           assign
      652             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      653             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      654             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      655           .
      656         end.
      657       end.
      658       B-viewProcInfo:visible   in frame waitfram = no.
      659       B-viewProcInfo:sensitive in frame waitfram = no.
      660       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      661       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      662       if  (   mWaitFramView
      663          or  mWaitProcEvent)
      664          and not mBatchMode
      665       then
      666          display
      667             v-waitfram-action01 skip
      668             v-waitfram-action02 skip
      669             v-waitfram-action03 skip
      670          with frame waitfram .
      671       if     mWaitFramView
      672          then do:
      673             if     mWaitFramInterval ne ?
      674                and not mBatchMode
      675             then
      676                wait-for go of frame waitfram pause mWaitFramInterval.
      677          end.
      678          else
      679             if     mWaitProcEvent
      680                and not mBatchMode
      681             then
      682                process events .
      683     end.
      684   end procedure.
      685      procedure waitfram-show-this:
      686         define input  parameter iInterval as int64 no-undo.
      687         define variable vtime as int64 no-undo.
      688         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      689         mWaitFramInterval = iInterval.
      690         run waitfram-show (substitute("&1&2 &3&4" ,
      691                                       mWaitFramTextBeg ,
      692                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      693                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      694                                       mWaitFramTextEnd
      695                                      )
      696                           ).
      697      end.
      698      procedure WaitFramRunPause:
      699         define input  parameter iInterval as dec no-undo.
      700         define variable vStart  as datetime-tz no-undo.
      701         define variable vend    as datetime-tz no-undo.
      702         define variable vint as int64 no-undo.
      703         define variable vOk as logical no-undo.
      704         vStart = now.
      705         vend   = vStart.
      706         publish "WaitFramPause" (iInterval,output vOk).
      707         vend   =  now.
      708         vint = vend - vStart.
      709         vint = iInterval - vint / 1000.
      710         if     not mWaitFramStop
      711            and (   vint > 0
      712                 or (    not vOk
      713                     and iInterval eq ?
      714                     )
      715                 )
      716         then
      717            run waitfram-show-this (iInterval).
      718         vend   =  now.
      719         vint = vend - vStart.
      720         vint = iInterval - vint / 1000.
      721         if     not mWaitFramStop
      722            and vint > 0
      723         then do:
      724            run gbl/pause.p (vint * 1000).
      725         end.
      726         if iInterval ne ?
      727         then
      728            publish "WaitFramStop".
      729         waitfram-check-timeout().
      730      end.
      731      procedure WaitFramWaitFor:
      732         define input  parameter iInterval as dec no-undo.
      733         assign
      734            mWaitFramStartProc   = now
      735            mWaitFramStopUser    = no
      736            mWaitFramStopTimeOut = no
      737         .
      738         block-wait:
      739         do while not mWaitFramStop:
      740            run WaitFramRunPause (iInterval).
      741            if  waitfram-check-timeout()
      742            then do:
      743               leave block-wait.
      744            end.
      745         end.
      746         run waitfram-hide.
      747      end.
      748   procedure waitfram-join :
      749     define input  parameter p-line-1  as character no-undo .
      750     define input  parameter p-line-2  as character no-undo .
      751     define input  parameter p-line-3  as character no-undo .
      752     define output parameter p-message as character no-undo .
      753     do
      754     on error undo, return error return-value
      755     :
      756       assign
      757         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      758                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      759                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      760       .
      761     end.
      762   end procedure.
      763   function waitfram-join-function returns character
      764     (input p-line-1 as character
      765     ,input p-line-2 as character
      766     ,input p-line-3 as character
      767     ).
      768     define variable v-message as character no-undo .
      769     run waitfram-join in this-procedure
      770       (input  p-line-1
      771       ,input  p-line-2
      772       ,input  p-line-3
      773       ,output v-message
      774       ) .
      775     return v-message .
      776   end function .
      777   define variable print-option as character no-undo.
      778   DEFINE MENU MENU-b-print
