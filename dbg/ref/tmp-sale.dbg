     1173           then do:
     1174             find first buf_temp-browse-handle
     1175               where buf_temp-browse-handle.browse-type   = 'height':u
     1176                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1177               no-error .
     1178             if available buf_temp-browse-handle
     1179             then do:
     1180             end.
     1181             else do:
     1182               create buf_temp-diasize-handle .
     1183               assign
     1184                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1185                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1186               .
     1187             end.
     1188           end.
     1189           assign
     1190             v-object-handle = v-object-handle :next-sibling
     1191           .
     1192         end.
     1193         assign
     1194           v-field-group-handle = v-field-group-handle :next-sibling
     1195         .
     1196       end.
     1197       do with frame d-type-tmp
     1198       :
     1199         hide v-diasize-resize-button .
     1200         assign
     1201           v-diasize-resize-button :row    = 1
     1202           v-diasize-resize-button :column = 1
     1203         .
     1204       end.
     1205       if p-change-value > 0
     1206       then do:
     1207         if frame d-type-tmp :scrollable = true
     1208         then do:
     1209           assign
     1210             frame d-type-tmp :virtual-height = frame d-type-tmp :virtual-height + p-change-value
     1211             no-error .
     1212           if error-status :error
     1213           or error-status :get-message(1) <> ""
     1214           then do:
     1215             undo move_block, retry move_block .
     1216           end.
     1217         end.
     1218         assign
     1219           frame d-type-tmp :height = frame d-type-tmp :height + p-change-value
     1220           no-error .
     1221         if error-status :error
     1222         or error-status :get-message(1) <> ""
     1223         then do:
     1224           undo move_block, retry move_block .
     1225         end.
     1226         assign
     1227           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1228           no-error .
