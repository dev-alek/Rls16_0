     1349       end.
     1350     end.
     1351     assign
     1352       v-diasize-change-size = false
     1353     .
     1354   end procedure.
     1355   procedure diasize_set-height :
     1356     define input  parameter p-new-height  as decimal   no-undo .
     1357     define input  parameter p-move-resize as logical   no-undo .
     1358     do
     1359     on error undo, return error return-value
     1360     :
     1361       run diasize_change-height in this-procedure
     1362         (input  (p-new-height - frame d-type-tmp :height)
     1363         ,input  p-move-resize
     1364         ) .
     1365     end.
     1366   end procedure.
     1367   procedure diasize_change-width :
     1368     define input  parameter p-change-value as decimal   no-undo .
     1369     define input  parameter p-move-resize  as logical   no-undo .
     1370     define variable v-field-group-handle   as handle    no-undo .
     1371     define variable v-object-handle        as handle    no-undo .
     1372     define variable v-frame-width          as decimal   no-undo .
     1373     define variable v-frame-virtual-width  as decimal   no-undo .
     1374     define variable v-browse-width         as decimal   no-undo .
     1375     define variable v-window-width         as decimal   no-undo .
     1376     define variable v-window-virtual-width as decimal   no-undo .
     1377     define variable v-change-sign          as integer   no-undo .
     1378     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1379     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1380     if p-change-value > 0
     1381     then do:
     1382       if frame d-type-tmp :width + p-change-value >
     1383           session :width-chars
     1384       then do:
     1385         assign
     1386           p-change-value = session :width-chars - frame d-type-tmp :width
     1387         .
     1388         if p-change-value <= 0
     1389         then do:
     1390           run diasize_position-resize-button in this-procedure .
     1391           return .
     1392         end.
     1393       end.
     1394     end.
     1395     if p-change-value < 0
     1396     then do:
     1397       if frame d-type-tmp :width + p-change-value < v-diasize-orig-frame-width
     1398       then do:
     1399         assign
     1400           p-change-value = v-diasize-orig-frame-width
     1401                          - frame d-type-tmp :width
     1402         .
     1403         if p-change-value >= 0
     1404         then do:
     1405           run diasize_position-resize-button in this-procedure .
     1406           return .
     1407         end.
     1408       end.
     1409     end.
     1410     if p-change-value >= 0
     1411     then do:
     1412       assign
     1413         v-change-sign = 1
     1414       .
     1415     end.
     1416     else do:
     1417       assign
     1418         v-change-sign = -1
     1419       .
     1420     end.
     1421     assign
     1422       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1423     .
     1424     if p-change-value = 0
     1425     then do:
     1426       run diasize_position-resize-button in this-procedure .
     1427       return .
     1428     end.
     1429     move_block:
     1430     do
     1431     on error undo move_block, leave move_block
     1432     :
     1433       if retry
     1434       then do:
     1435         do
     1436         on error undo move_block, leave move_block
     1437         :
     1438           if p-change-value > 0
     1439           then do:
     1440             for each buf_temp-diasize-handle
     1441             on error undo, next
     1442             :
     1443               assign
     1444                 v-object-handle = buf_temp-diasize-handle.handle-value
     1445               .
     1446               if v-object-handle <> v-diasize-resize-button
     1447               then do:
     1448                 assign
     1449                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1450                 .
     1451               end.
     1452             end.
