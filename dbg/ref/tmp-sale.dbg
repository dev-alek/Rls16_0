     1559           and ( v-object-handle :col + v-object-handle :width
     1560                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1561               )
     1562           then do:
     1563             find first buf_temp-browse-handle
     1564               where buf_temp-browse-handle.browse-type   = 'width':u
     1565                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1566               no-error .
     1567             if available buf_temp-browse-handle
     1568             then do:
     1569             end.
     1570             else do:
     1571               create buf_temp-diasize-handle .
     1572               assign
     1573                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1574                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1575               .
     1576             end.
     1577           end.
     1578           assign
     1579             v-object-handle = v-object-handle :next-sibling
     1580           .
     1581         end.
     1582         assign
     1583           v-field-group-handle = v-field-group-handle :next-sibling
     1584         .
     1585       end.
     1586       do with frame d-type-tmp
     1587       :
     1588         hide v-diasize-resize-button .
     1589         v-diasize-resize-button :row = 1.
     1590         v-diasize-resize-button :column = 1.
     1591       end.
     1592       if p-change-value > 0
     1593       then do:
     1594         if frame d-type-tmp :scrollable = true
