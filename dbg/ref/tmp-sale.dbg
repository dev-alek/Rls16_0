     1716       then do:
     1717         run diasize_position-resize-button in this-procedure .
     1718       end.
     1719       if v-diasize-wndstore = true
     1720       then do:
     1721         if connected("ub") = true
     1722         then do:
     1723           define variable v-cntxt-db-num        as integer   no-undo .
     1724           define variable v-cntxt-userid        as character no-undo .
     1725           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1726                                             , OUTPUT v-cntxt-userid
     1727                                             ) .
     1728           run gbl/wndsizew.p
     1729             (input  v-cntxt-db-num
     1730             ,input  v-cntxt-userid
     1731             ,input  v-diasize-proc-name
     1732             ,input  'width':u
     1733             ,input  string(frame d-type-tmp :width - v-diasize-orig-frame-width)
     1734             ) .
     1735         end.
     1736       end.
     1737     end.
     1738     assign
     1739       v-diasize-change-size = false
     1740     .
     1741   end procedure.
     1742   procedure diasize_set-width :
     1743     define input  parameter p-new-width  as decimal   no-undo .
     1744     define input  parameter p-move-resize as logical   no-undo .
     1745     do
     1746     on error undo, return error return-value
     1747     :
     1748       run diasize_change-width in this-procedure
     1749         (input  (p-new-width - frame d-type-tmp :width)
     1750         ,input  p-move-resize
     1751         ) .
     1752     end.
     1753   end procedure.
     1754   procedure diasize_position-resize-button :
     1755     do with frame d-type-tmp
     1756     :
     1757       hide v-diasize-resize-button .
     1758       assign
     1759         v-diasize-resize-button :row = frame d-type-tmp :height - v-diasize-resize-button :height
     1760                     - 1
     1761                     - (frame d-type-tmp :border-bottom-pixels / session :pixels-per-row)
     1762         v-diasize-resize-button :col = frame d-type-tmp :width - v-diasize-resize-button :width
     1763                     - 1
     1764                     - (frame d-type-tmp :border-right-pixels / session :pixels-per-column)
     1765       .
     1766       view v-diasize-resize-button .
     1767     end.
     1768   end procedure.
     1769   on alt-right anywhere
     1770   do:
     1771     run diasize_change-width in this-procedure
     1772       (input 1
     1773       ,input true
     1774       ) .
     1775     return no-apply .
     1776   end.
     1777   on alt-left anywhere
     1778   do:
     1779     run diasize_change-width in this-procedure
     1780       (input -1
     1781       ,input true
     1782       ) .
     1783     return no-apply .
     1784   end.
     1785   on alt-down anywhere
     1786   do:
     1787     run diasize_change-height in this-procedure
     1788       (input 1
     1789       ,input true
     1790       ) .
     1791     return no-apply .
     1792   end.
     1793   on alt-up anywhere
     1794   do:
     1795     run diasize_change-height in this-procedure
     1796       (input -1
     1797       ,input true
     1798       ) .
     1799     return no-apply .
     1800   end.
     1801   on alt-enter of frame d-type-tmp
     1802   do:
     1803     run diasize_maximize in this-procedure
     1804       (input  ?
     1805       ).
     1806     return no-apply .
     1807   end.
     1808   procedure diasize_end-move :
     1809     do
     1810     on error undo, return error return-value
     1811     :
     1812       define variable v-row-delta as decimal   no-undo .
     1813       define variable v-col-delta as decimal   no-undo .
     1814       define variable v-new-row as decimal   no-undo .
     1815       define variable v-new-col as decimal   no-undo .
     1816       assign
     1817         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1818         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1819       .
     1820       assign
     1821         v-row-delta = v-new-row - frame d-type-tmp :height
     1822         v-col-delta = v-new-col - frame d-type-tmp :width
     1823       .
     1824       run diasize_change-height in this-procedure
     1825         (input v-row-delta
     1826         ,input true
     1827         ) .
     1828       run diasize_change-width in this-procedure
     1829         (input v-col-delta
     1830         ,input true
     1831         ) .
     1832     end.
     1833   end procedure.
     1834   procedure diasize_maximize :
     1835     define input  parameter p-action as logical   no-undo .
     1836     do
     1837     on error undo, return error return-value
     1838     :
     1839       if p-action = ?
     1840       then do:
     1841         if v-diasize-need-maximize = true
     1842         then do:
     1843           assign
     1844             p-action = true
     1845           .
     1846         end.
     1847         else do:
     1848           assign
     1849             p-action = false
     1850           .
     1851         end.
     1852       end.
     1853       if p-action = true
     1854       then do:
     1855         run diasize_change-height in this-procedure
     1856           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1857               - frame d-type-tmp :height-chars
     1858           ,input true
     1859           ) .
     1860         run diasize_change-width in this-procedure
     1861           (input session :width-chars
     1862               - frame d-type-tmp :width-chars
     1863           ,input true
     1864           ) .
     1865         assign
     1866           v-diasize-need-maximize = false
     1867         .
     1868       end.
     1869       else do:
     1870         run diasize_change-width in this-procedure
     1871           (input v-diasize-orig-frame-width
     1872               - frame d-type-tmp :width-chars
     1873           ,input true
     1874           ) .
     1875         run diasize_change-height in this-procedure
     1876           (input v-diasize-orig-frame-height
     1877               - frame d-type-tmp :height-chars
     1878           ,input true
     1879           ) .
     1880         assign
     1881           v-diasize-need-maximize = true
     1882         .
     1883       end.
     1884     end.
     1885   end procedure.
     1886   procedure diasize_restore-orig-size :
     1887     do
     1888     on error undo, return error return-value
     1889     :
     1890       assign
     1891         v-diasize-current-frame-width  = frame d-type-tmp :width
     1892         v-diasize-current-frame-height = frame d-type-tmp :height
     1893       .
     1894       run diasize_set-height in this-procedure
     1895         (input  v-diasize-orig-frame-height
     1896         ,input  true
     1897         ) .
     1898       run diasize_set-width in this-procedure
     1899         (input  v-diasize-orig-frame-width
     1900         ,input  true
     1901         ) .
     1902     end.
     1903   end procedure.
     1904   procedure diasize_restore-current-size :
     1905     do
     1906     on error undo, return error return-value
     1907     :
     1908       run diasize_set-height in this-procedure
     1909         (input  v-diasize-current-frame-height
     1910         ,input  true
     1911         ) .
     1912       run diasize_set-width in this-procedure
     1913         (input  v-diasize-current-frame-width
     1914         ,input  true
     1915         ) .
     1916     end.
     1917   end procedure.
     1918   procedure diasize_set-browse-handle :
     1919     define input  parameter p-browse-handle as handle   no-undo .
     1920     define buffer buf_temp-browse-handle for temp-browse-handle .
     1921     do
     1922     on error undo, return error return-value
     1923     :
     1924       assign
     1925         v-diasize-browse-handle = p-browse-handle
     1926       .
     1927       for each buf_temp-browse-handle
     1928       on error undo, return error return-value
     1929       :
     1930         delete buf_temp-browse-handle .
     1931       end.
     1932     end.
     1933   end procedure.
     1934   procedure diasize_add_browse :
     1935     define input  parameter p-browse-type   as character no-undo .
     1936     define input  parameter p-browse-handle as handle    no-undo .
     1937     define buffer buf_temp-browse-handle for temp-browse-handle .
     1938     do
     1939     on error undo, return error return-value
     1940     :
     1941       assign
     1942         v-diasize-browse-number = v-diasize-browse-number + 1
     1943       .
     1944       create buf_temp-browse-handle .
     1945       assign
     1946         buf_temp-browse-handle.browse-type   = p-browse-type
     1947         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1948         buf_temp-browse-handle.browse-handle = p-browse-handle
     1949       .
     1950     end.
     1951   end procedure.
     1952   procedure diasize_init :
     1953     define variable v-default-value    as logical   no-undo .
     1954     define variable v-restore-saved    as logical   no-undo .
     1955     define variable v-resize-value-str as character no-undo .
     1956     do
     1957     on error undo, return error return-value
     1958     :
     1959       do with frame d-type-tmp
     1960       :
     1961         assign
     1962           v-diasize-orig-frame-height = frame d-type-tmp :height
     1963           v-diasize-orig-frame-width  = frame d-type-tmp :width
     1964           v-diasize-browse-handle     = browse br-tmp-sale :handle
     1965         .
     1966         create button v-diasize-resize-button
     1967         assign
     1968           parent        = frame d-type-tmp :first-child
     1969           label         = "s"
     1970           height-pixels = 16
     1971           width-pixels  = 16
     1972           visible       = true
     1973           sensitive     = true
     1974           movable       = true
     1975           triggers:
     1976             on end-move persistent run diasize_end-move in this-procedure .
     1977           end triggers.
     1978         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1979         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1980         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1981         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1982         assign
     1983           v-diasize-wndmax = false
     1984         .
     1985         if connected("ub") = true
     1986         then do:
     1987           define variable v-cntxt-db-num        as integer   no-undo .
     1988           define variable v-cntxt-userid        as character no-undo .
     1989           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1990                                             , OUTPUT v-cntxt-userid
     1991                                             ) .
     1992           run gbl/wndpar_r.p
     1993             (input  v-cntxt-db-num
     1994             ,input  v-cntxt-userid
     1995             ,input  'wndmax':U
     1996             ,output v-diasize-wndmax
     1997             ,output v-default-value
     1998             ) .
     1999         end.
     2000         assign
     2001           v-diasize-wndstore = false
     2002         .
     2003         if connected("ub") = true
     2004         then do:
     2005           run gbl/wndpar_r.p
     2006             (input  v-cntxt-db-num
     2007             ,input  v-cntxt-userid
     2008             ,input  'wndstore':U
     2009             ,output v-diasize-wndstore
     2010             ,output v-default-value
     2011             ) .
     2012         end.
     2013         assign
     2014           v-diasize-proc-name = entry(1, program-name(2), '.')
     2015         .
     2016         if v-diasize-wndstore = true
     2017         then do:
     2018           assign
     2019             v-restore-saved = false
     2020           .
     2021           if connected("ub") = true
     2022           then do:
     2023             run gbl/wndsizer.p
     2024               (input  v-cntxt-db-num
     2025               ,input  v-cntxt-userid
     2026               ,input  v-diasize-proc-name
     2027               ,input  'height':u
     2028               ,output v-resize-value-str
     2029               ) .
     2030             if v-resize-value-str <> '':U
     2031             then do:
     2032               run diasize_change-height in this-procedure
     2033                 (input  integer(v-resize-value-str)
     2034                 ,input  true
     2035                 ) .
     2036               assign
     2037                 v-restore-saved = true
     2038               .
     2039             end.
     2040           end.
     2041           if connected("ub") = true
     2042           then do:
     2043             run gbl/wndsizer.p
     2044               (input  v-cntxt-db-num
     2045               ,input  v-cntxt-userid
     2046               ,input  v-diasize-proc-name
     2047               ,input  'width':u
     2048               ,output v-resize-value-str
     2049               ) .
     2050             if v-resize-value-str <> '':U
     2051             then do:
     2052               run diasize_change-width in this-procedure
     2053                 (input  integer(v-resize-value-str)
     2054                 ,input  true
     2055                 ) .
     2056               assign
     2057                 v-restore-saved = true
     2058               .
     2059             end.
     2060           end.
     2061           if v-restore-saved <> true
     2062           then do:
     2063             if v-diasize-wndmax = true
     2064             then do:
     2065               run diasize_maximize in this-procedure
     2066                 (input  true
     2067                 ) .
     2068             end.
     2069           end.
     2070         end.
     2071         else do:
     2072           if v-diasize-wndmax = true
     2073           then do:
     2074             run diasize_maximize in this-procedure
     2075               (input  true
     2076               ) .
     2077           end.
     2078         end.
     2079       end.
     2080     end.
     2081   end procedure.
     2082   procedure diasize_need-full-display :
     2083     define output parameter p-need-full-display as logical   no-undo .
     2084     do
     2085     on error undo, return error return-value
     2086     :
     2087       assign
     2088         p-need-full-display = v-diasize-need-full-display
     2089       .
     2090       assign
     2091         v-diasize-need-full-display = false
     2092       .
     2093     end.
     2094   end procedure.
     2095   procedure get-context :
     2096      define output parameter p-db-num as integer          no-undo.
     2097      define output parameter p-user-id as character        no-undo.
     2098      define variable v-login               as character    no-undo.
     2099      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2100      define buffer buf_user-login  for ub.user-login .
     2101      do
     2102      on error undo, return error
     2103      :
     2104            FIND FIRST buf_sys-ctrl no-lock.
     2105            ASSIGN
     2106               v-login = USERID("ub")
     2107               p-db-num = buf_sys-ctrl.db-num
     2108            .
     2109            FIND FIRST buf_user-login
     2110                 WHERE buf_user-login.db-num = p-db-num
     2111                   AND buf_user-login.user-login = v-login
     2112                 no-lock
     2113                 no-error
     2114                 .
     2115            IF AVAILABLE buf_user-login
     2116            THEN DO:
     2117               assign
     2118                  p-user-id = buf_user-login.user-id
     2119               .
     2120            END.
     2121      end.
     2122   end procedure.
     2123       run diasize_init in this-procedure .
     2124   ON WINDOW-CLOSE OF FRAME d-type-tmp APPLY "END-ERROR":U TO SELF.
     2125   MAIN-BLOCK:
     2126   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2127      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2128       run enable_ui.
     2129       if num-entries (rid-list) = 0 then
     2130           hide mark-num in frame d-type-tmp.
     2131       else
     2132           disp
     2133           num-entries (rid-list) @ mark-num
     2134           with frame d-type-tmp.
     2135       WAIT-FOR GO OF FRAME d-type-tmp.
     2136   END.
     2137   run disable_ui.
     2138   PROCEDURE disable_UI :
     2139     HIDE FRAME d-type-tmp.
     2140   END PROCEDURE.
     2141   PROCEDURE enable_UI :
     2142       ENABLE
     2143        br-tmp-sale
     2144           b-exit
     2145           b-add WHEN  (lookup  ( "b-add" , bttns) > 0 )
     2146           b-sel WHEN  (lookup  ( "b-sel" , bttns) > 0 )
     2147           b-mark when (lookup  ( "b-mark", bttns) > 0 )
     2148           b-chg WHEN  (lookup  ( "b-add" , bttns) > 0 )
     2149           b-print
     2150           b-help
     2151           b-goods
     2152           WITH FRAME  d-type-tmp.
     2153       if available ub.tmp-sale then
     2154           log-res  = br-tmp-sale:select-focused-row( ) in frame d-type-tmp.
     2155        OPEN QUERY br-tmp-sale FOR EACH ub.tmp-sale NO-LOCK     BY ub.tmp-sale.tmp-code INDEXED-REPOSITION.
     2156   END PROCEDURE.
