        1   define input  parameter parParentProc  as widget-handle no-undo.
        2   define input     param bttns  as char   no-undo .
        3   define output    param rid-list    as  char no-undo .
        4   def var log-res as log no-undo.
        5   def var rr as recid no-undo.
        6   def var vss-revision    as character no-undo init "$Revision$":U .
        7   def var vss-author      as character no-undo init "$Author$":U .
        8   def var vss-date        as character no-undo init "$Date$":U .
        9   def var vss-workfile    as character no-undo init "$Workfile$":U .
       10   def var vss-archive     as character no-undo init "$Archive$":U .
       11   def var vss-description as character no-undo init "Справочник типов темпов продаж".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       74   define new shared variable RepPathName        as character no-undo .
       75   define new shared variable PrintRubl          as logical   no-undo .
       76   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77   procedure cur-time :
       78      define output parameter p-today as date      no-undo .
       79      define output parameter p-time  as integer   no-undo .
       80     do
       81     on error undo, return error
       82     :
       83       define variable v-date1 as date      no-undo .
       84       define variable v-date2 as date      no-undo .
       85       define variable v-time  as integer   no-undo .
       86       assign
       87         v-date1 = today
       88         v-time  = time
       89         v-date2 = today
       90       .
       91       if v-date1 <> v-date2
       92       then do:
       93         assign
       94           v-date1 = today
       95           v-time  = v-time
       96         .
       97       end.
       98       assign
       99         p-today = v-date1
      100         p-time  = v-time
      101       .
      102     end.
      103   end.
      104   function cur-time-date returns character
      105   :
      106     return string(today, '99/99/9999':U) .
      107   end.
      108   function cur-time-mjd returns decimal
      109   :
      110     define variable v-date as date      no-undo .
      111     define variable v-time as integer   no-undo .
      112     run cur-time in this-procedure
      113       (output v-date
      114       ,output v-time
      115       ) .
      116     return integer(v-date) - 2400002 + (v-time / 86400) .
      117   end.
      118   function cur-time-get-ending-index returns integer
      119   (input p-number as integer
      120   )
      121   :
      122     if p-number < 0
      123     or p-number = ?
      124     then do:
      125       return 1 .
      126     end.
      127     define variable v-rest as integer   no-undo .
      128     assign
      129       p-number = p-number modulo 100
      130     .
      131     if p-number < 20
      132     then do:
      133       assign
      134         v-rest = p-number
      135       .
      136     end.
      137     else do:
      138       assign
      139         v-rest = p-number modulo 10
      140       .
      141     end.
      142     case v-rest :
      143       when 1
      144       then do:
      145         return 2 .
      146       end.
      147       when 2 or
      148       when 3 or
      149       when 4
      150       then do:
      151         return 3 .
      152       end.
      153       otherwise do:
      154         return 1 .
      155       end.
      156     end case .
      157   end.
      158   procedure cur-time-mjd-to-date :
      159      define input  parameter i-mjd-diff as decimal no-undo.
      160      define output parameter o-Date     as date    no-undo.
      161      define output parameter o-Time     as integer no-undo.
      162      define variable v-day-number as integer   no-undo .
      163      if    i-mjd-diff < 0
      164         or i-mjd-diff = ?
      165      then do:
      166         return "?" .
      167      end.
      168      assign
      169         v-day-number = truncate(i-mjd-diff,0).
      170         o-Date = date(v-day-number + 2400002).
      171         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      172     .
      173   end.
      174   function cur-time-mjd-to-string returns character
      175   (input p-mjd-diff as decimal
      176   )
      177   :
      178     define variable v-day-number as integer   no-undo .
      179     define variable v-seconds    as integer   no-undo .
      180     define variable v-hour       as integer   no-undo .
      181     define variable v-min        as integer   no-undo .
      182     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      183     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      184     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      185     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      186     if p-mjd-diff < 0
      187     or p-mjd-diff = ?
      188     then do:
      189       return "?" .
      190     end.
      191     assign
      192       v-day-number = integer(truncate(p-mjd-diff,0))
      193       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      194     .
      195     if v-seconds > 86400
      196     then do:
      197       assign
      198         v-seconds = 86400 - 1
      199       .
      200     end.
      201     if v-seconds < 0
      202     then do:
      203       assign
      204         v-seconds = 0
      205       .
      206     end.
      207     assign
      208       v-hour = truncate(v-seconds / 3600, 0)
      209     .
      210     assign
      211       v-seconds = v-seconds modulo 3600
      212     .
      213     assign
      214       v-min = truncate(v-seconds / 60, 0)
      215     .
      216     assign
      217       v-seconds = v-seconds modulo 60
      218     .
      219     return
      220         (if v-day-number <> 0
      221           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      222           else ""
      223         )
      224       + (if v-day-number <> 0 or v-hour <> 0
      225           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      226           else ""
      227         )
      228       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      229           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      230           else ""
      231         )
      232       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      233       .
      234   end.
      235   function cur-time-string returns character
      236   :
      237     define variable v-date as date      no-undo .
      238     define variable v-time as integer   no-undo .
      239     run cur-time in this-procedure
      240       (output v-date
      241       ,output v-time
      242       ) .
      243     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      244   end.
      245   function cur-time-string-sec returns character
      246   :
      247     define variable v-date as date      no-undo .
      248     define variable v-time as integer   no-undo .
      249     run cur-time in this-procedure
      250       (output v-date
      251       ,output v-time
      252       ) .
      253     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      254   end.
      255   function cur-time-custom  returns character
      256   (input p-prefix as character
      257   ,input p-date-format as character
      258   ,input p-delimiter as character
      259   ,input p-time-format as character
      260   ,input p-suffix as character
      261   )
      262   :
      263     define variable v-date as date      no-undo .
      264     define variable v-time as integer   no-undo .
      265     run cur-time in this-procedure
      266       (output v-date
      267       ,output v-time
      268       ) .
      269     return
      270       p-prefix
      271       + string(v-date, p-date-format)
      272       + p-delimiter
      273       + string(v-time, p-time-format)
      274       + p-suffix
      275       .
      276   end.
      277   function cur-time-print  returns character
      278   :
      279     define variable v-date as date      no-undo .
      280     define variable v-time as integer   no-undo .
      281     run cur-time in this-procedure
      282       (output v-date
      283       ,output v-time
      284       ) .
      285     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      286   end.
      287   function cur-time-datetime returns datetime
      288   :
      289     define variable v-char as character no-undo .
      290     define variable v-datetime as datetime no-undo .
      291     v-char = cur-time-string().
      292     v-datetime = datetime(v-char).
      293     return  v-datetime.
      294   end.
      295   function cur-time-string-msec returns character
      296   :
      297     define variable v-date as datetime  no-undo .
      298     v-date = now.
      299     return string(v-date) .
      300   end.
      301   procedure proc-alt-shift-f2:
      302     if not ibs.th.gbl.gbl-var:rcode
      303   then
      304     run gbl\inidebug.p .
      305   end.
      306   procedure proc-alt-shift-f3:
      307     run gbl/prvssinf.p
      308       ( input this-procedure
      309       ) .
      310   end.
      311   define variable v-inform-launched as logical no-undo initial false .
      312   procedure proc-alt-shift-f4:
      313     define variable v-action as character no-undo .
      314     if v-inform-launched = false then do:
      315       assign
      316         v-inform-launched = true
      317       .
      318       run gbl/d-inform.w
      319         (  input self
      320         ,  input this-procedure
      321         , output v-action
      322         ) no-error .
      323       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      324       assign
      325         v-inform-launched = false
      326       .
      327     end.
      328   end.
      329   procedure proc-alt-f1:
      330     run gbl/corrhelp.p
      331       (input this-procedure
      332       ) .
      333   end .
      334   on alt-shift-f2 anywhere do:
      335     run proc-alt-shift-f2.
      336   end.
      337   on alt-shift-f3 anywhere do:
      338     run proc-alt-shift-f3 in this-procedure .
      339   end.
      340   on alt-shift-f4 anywhere do:
      341     run proc-alt-shift-f4 in this-procedure.
      342   end.
      343   on alt-f1 anywhere do:
      344     run proc-alt-f1 in this-procedure .
      345   end.
      346   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      347     define variable v-cntxt-db-num        as integer   no-undo .
      348     define variable v-cntxt-userid        as character no-undo .
      349     define variable v-cntxt-level         as character no-undo .
      350     define variable v-cntxt-host-code-obj as integer   no-undo .
      351     define variable v-cntxt-obj-type      as character no-undo .
      352     define variable v-cntxt-obj-code      as integer   no-undo .
      353     define variable v-cntxt-db-num-obj    as integer   no-undo .
      354     define variable v-cntxt-is-admin      as logical   no-undo .
      355   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      356   define variable v-waitfram-action01         as character   no-undo .
      357   define variable v-waitfram-action02         as character   no-undo .
      358   define variable v-waitfram-action03         as character   no-undo .
      359   define variable mWaitFramTextBeg            as character   no-undo.
      360   define variable mWaitFramTextEnd            as character   no-undo.
      361   define variable mWaitFramView               as logical     no-undo.
      362   define variable mWaitProcEvent              as logical     no-undo init yes.
      363   define variable mWaitFramInterval           as integer     no-undo init 1 .
      364   define variable mWaitFramStop               as logical     no-undo.
      365   define variable mWaitFramStopUser           as logical     no-undo.
      366   define variable mWaitFramStopTimeOut        as logical     no-undo.
      367   define variable mWaitFramStartProc          as datetime-tz no-undo.
      368   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      369   define button B-WaitFramStop auto-end-key
      370        label "Стоп"
      371        size 10 by 1 tooltip "Остоновить процесс".
      372   define button B-viewProcInfo
      373        label "Информация"
      374        size 15 by 1 tooltip "Информация о процесс".
      375   define frame waitfram
      376     v-waitfram-action01 format "x(72)" no-label skip
      377     v-waitfram-action02 format "x(72)" no-label skip
      378     v-waitfram-action03 format "x(72)" no-label skip
      379     B-viewProcInfo
      380     B-WaitFramStop at row 4 col 30
      381     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      382     .
      383   define new global shared variable mBatchMode as logical no-undo init ?.
      384   define variable mFramBachModHandle as handle no-undo.
      385   mFramBachModHandle = frame waitfram:handle.
      386   define variable mFameOldVis as logical no-undo.
      387   define variable mVisCUrentVin as logical no-undo.
      388   if session:batch-mode
      389   then
      390      mBatchMode = yes.
      391   if mBatchMode = ? then do:
      392     mVisCUrentVin = current-window:visible.
      393     mFameOldVis = mFramBachModHandle:visible.
      394     mFramBachModHandle:visible  = yes.
      395     mBatchMode = mFramBachModHandle:visible ne yes.
      396     mFramBachModHandle:visible = mFameOldVis.
      397     current-window:visible = mVisCUrentVin.
      398   end.
      399    if  log-manager:logfile-name ne ?
      400     then DO:
      401         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      402         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      403         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      404     end.
      405   on choose of B-WaitFramStop in frame waitfram
      406   do:
      407     mWaitFramStop = yes.
      408     mWaitFramStopUser = yes.
      409   end.
      410   function waitfram-check-timeout returns logical():
      411      define variable vtime as int64 no-undo.
      412      if mWaitFramStopTimeOut
      413      then
      414         return yes.
      415      vtime = ( now - mWaitFramStartProc ) / 1000 .
      416      if     mWaitFramTimeOut ne ?
      417         and mWaitFramTimeOut ne 0
      418         and mWaitFramTimeOut lt vtime
      419      then do:
      420         mWaitFramStopTimeOut = yes.
      421      end.
      422      return mWaitFramStopTimeOut.
      423   end.
      424   procedure waitfram-hide :
      425     if not session:batch-mode
      426     then do
      427     on error undo, return error return-value
      428     :
      429       pause 0 before-hide .
      430       if not mBatchMode then
      431         hide frame waitfram .
      432     if     not mWaitFramView
      433        and mWaitProcEvent
      434     then
      435       process events .
      436     end.
      437   end procedure.
      438   procedure waitfram-show :
      439     define input  parameter p-message as character no-undo .
      440     define variable v-left-margin as integer   no-undo .
      441     if not session:batch-mode
      442     then do
      443     on error undo, return error return-value
      444     :
      445       if length(p-message) <= 70 then do:
      446         assign
      447           v-left-margin = integer((70 - length(p-message)) / 2)
      448         .
      449         assign
      450           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      451         .
      452         assign
      453           v-waitfram-action01 = " "
      454           v-waitfram-action02 = " "
      455                                    + fill(" ", v-left-margin)
      456                                    + p-message
      457           v-waitfram-action03 = " "
      458         .
      459       end.
      460       else do:
      461         define variable vRindex1 as integer no-undo.
      462         define variable vRindex2 as integer no-undo.
      463         vRindex1 = r-index(p-message," ",70).
      464         if vRindex1 = 0
      465         then
      466            vRindex1 = 70.
      467         if length(p-message)  <= vRindex1 + 70 then do:
      468           assign
      469             v-waitfram-action01 = " "
      470             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      471             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      472           .
      473         end.
      474         else do:
      475           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      476           if vRindex2 <= vRindex1
      477           then
      478              vRindex2 = vRindex1 + 70.
      479           assign
      480             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      481             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      482             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      483           .
      484         end.
      485       end.
      486       B-viewProcInfo:visible   in frame waitfram = no.
      487       B-viewProcInfo:sensitive in frame waitfram = no.
      488       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      489       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      490       if  (   mWaitFramView
      491          or  mWaitProcEvent)
      492          and not mBatchMode
      493       then
      494          display
      495             v-waitfram-action01 skip
      496             v-waitfram-action02 skip
      497             v-waitfram-action03 skip
      498          with frame waitfram .
      499       if     mWaitFramView
      500          then do:
      501             if     mWaitFramInterval ne ?
      502                and not mBatchMode
      503             then
      504                wait-for go of frame waitfram pause mWaitFramInterval.
      505          end.
      506          else
      507             if     mWaitProcEvent
      508                and not mBatchMode
      509             then
      510                process events .
      511     end.
      512   end procedure.
      513      procedure waitfram-show-this:
      514         define input  parameter iInterval as int64 no-undo.
      515         define variable vtime as int64 no-undo.
      516         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      517         mWaitFramInterval = iInterval.
      518         run waitfram-show (substitute("&1&2 &3&4" ,
      519                                       mWaitFramTextBeg ,
      520                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      521                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      522                                       mWaitFramTextEnd
      523                                      )
      524                           ).
      525      end.
      526      procedure WaitFramRunPause:
      527         define input  parameter iInterval as dec no-undo.
      528         define variable vStart  as datetime-tz no-undo.
      529         define variable vend    as datetime-tz no-undo.
      530         define variable vint as int64 no-undo.
      531         define variable vOk as logical no-undo.
      532         vStart = now.
      533         vend   = vStart.
      534         publish "WaitFramPause" (iInterval,output vOk).
      535         vend   =  now.
      536         vint = vend - vStart.
      537         vint = iInterval - vint / 1000.
      538         if     not mWaitFramStop
      539            and (   vint > 0
      540                 or (    not vOk
      541                     and iInterval eq ?
      542                     )
      543                 )
      544         then
      545            run waitfram-show-this (iInterval).
      546         vend   =  now.
      547         vint = vend - vStart.
      548         vint = iInterval - vint / 1000.
      549         if     not mWaitFramStop
      550            and vint > 0
      551         then do:
      552            run gbl/pause.p (vint * 1000).
      553         end.
      554         if iInterval ne ?
      555         then
      556            publish "WaitFramStop".
      557         waitfram-check-timeout().
      558      end.
      559      procedure WaitFramWaitFor:
      560         define input  parameter iInterval as dec no-undo.
      561         assign
      562            mWaitFramStartProc   = now
      563            mWaitFramStopUser    = no
      564            mWaitFramStopTimeOut = no
      565         .
      566         block-wait:
      567         do while not mWaitFramStop:
      568            run WaitFramRunPause (iInterval).
      569            if  waitfram-check-timeout()
      570            then do:
      571               leave block-wait.
      572            end.
      573         end.
      574         run waitfram-hide.
      575      end.
      576   procedure waitfram-join :
      577     define input  parameter p-line-1  as character no-undo .
      578     define input  parameter p-line-2  as character no-undo .
      579     define input  parameter p-line-3  as character no-undo .
      580     define output parameter p-message as character no-undo .
      581     do
      582     on error undo, return error return-value
      583     :
      584       assign
      585         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      586                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      587                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      588       .
      589     end.
      590   end procedure.
      591   function waitfram-join-function returns character
      592     (input p-line-1 as character
      593     ,input p-line-2 as character
      594     ,input p-line-3 as character
      595     ).
      596     define variable v-message as character no-undo .
      597     run waitfram-join in this-procedure
      598       (input  p-line-1
      599       ,input  p-line-2
      600       ,input  p-line-3
      601       ,output v-message
      602       ) .
      603     return v-message .
      604   end function .
      605   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      606     run mainmenu_getcntxt in parparentproc
      607       (output v-cntxt-db-num
      608       ,output v-cntxt-userid
      609       ,output v-cntxt-level
      610       ,output v-cntxt-host-code-obj
      611       ,output v-cntxt-obj-type
      612       ,output v-cntxt-obj-code
      613       ,output v-cntxt-db-num-obj
      614       ,output v-cntxt-is-admin
      615       ) .
