      618   define variable g#log as logical   no-undo .
      619   def stream ListStream .
      620   DEFINE BUTTON b-add
      621        LABEL "&Добавить":L
      622        SIZE 10 BY 1.
      623   DEFINE BUTTON b-chg
      624        LABEL "&Изменить":L
      625        SIZE 10 BY 1.
      626   DEFINE BUTTON b-exit AUTO-GO
      627        LABEL "&Выход ":L
      628        SIZE 10 BY 1.
      629   DEFINE BUTTON b-goods
      630        LABEL "Товары":L
      631        SIZE 10 BY 1.
      632   DEFINE BUTTON b-help
      633        LABEL "Помо&щь":L
      634        SIZE 10 BY 1.
      635   DEFINE BUTTON B-mark
      636        LABEL "&*"
      637        SIZE 3 BY 1.
      638   DEFINE BUTTON b-print
      639        LABEL "Пе&чать":L
      640        SIZE 10 BY 1.
      641   DEFINE BUTTON b-sel AUTO-GO
      642        LABEL "Вы&бор ":L
      643        SIZE 10 BY 1.
      644   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
      645         VIEW-AS TEXT
      646        SIZE 9 BY .67
      647        FGCOLOR 4  NO-UNDO.
      648   DEFINE QUERY br-tmp-sale FOR
      649         ub.tmp-sale SCROLLING.
      650   DEFINE BROWSE br-tmp-sale
      651     QUERY br-tmp-sale NO-LOCK DISPLAY
      652         (IF ( CAN-DO (rid-list, string( recid( ub.tmp-sale ) ) ) ) THEN ("*") ELSE (" ")) COLUMN-LABEL "*" FORMAT "X(1)":U
      653         ub.tmp-sale.tmp-code FORMAT "X(12)":U WIDTH 14.88
      654         ub.tmp-sale.desc_ FORMAT "X(80)":U
      655       WITH SEPARATORS SIZE 83.25 BY 18.75
      656            BGCOLOR 15 FGCOLOR 0 .
      657   DEFINE FRAME d-type-tmp
      658        b-exit AT ROW 1 COL 1
      659        b-sel AT ROW 1 COL 11
      660        B-mark AT ROW 1 COL 23
      661        b-add AT ROW 1 COL 34
      662        b-chg AT ROW 1 COL 44
      663        b-print AT ROW 1 COL 54
      664        b-goods AT ROW 1 COL 64
      665        b-help AT ROW 1 COL 74
      666        br-tmp-sale AT ROW 3.04 COL 1.13
      667        mark-num AT ROW 2.17 COL 74.75 NO-LABEL
      668        SPACE(0.87) SKIP(19.15)
      669       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      670            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      671            TITLE "ТЕМПЫ ПРОДАЖ":L.
      672   ASSIGN
      673          FRAME d-type-tmp:SCROLLABLE       = FALSE.
      674   ASSIGN
      675          br-tmp-sale:NUM-LOCKED-COLUMNS IN FRAME d-type-tmp     = 3.
      676   ON CHOOSE OF b-add IN FRAME d-type-tmp
      677   DO:
      678       run ref/tmpsalei.w
      679         ( 'ДОБАВЛЕНИЕ':U, input-output rr ).
      680       if rr <> ? then
      681           do:
      682               OPEN QUERY br-tmp-sale FOR EACH ub.tmp-sale NO-LOCK     BY ub.tmp-sale.tmp-code INDEXED-REPOSITION.
      683               reposition br-tmp-sale to recid rr.
      684               log-res  = br-tmp-sale:select-focused-row( ).
      685               apply "ENTRY":U to br-tmp-sale.
      686               apply "home"  to br-tmp-sale.
      687           end.
      688   END.
      689   ON CHOOSE OF b-chg IN FRAME d-type-tmp
      690   DO:
      691       if not available ub.tmp-sale THEN
      692           return no-apply.
      693       rr = recid( ub.tmp-sale ).
      694       run ref/tmpsalei.w
      695       ( 'ИЗМЕНЕНИЕ':U, input-output rr ).
      696       OPEN QUERY br-tmp-sale FOR EACH ub.tmp-sale NO-LOCK     BY ub.tmp-sale.tmp-code INDEXED-REPOSITION.
      697       reposition br-tmp-sale to recid rr .
      698   END.
      699   ON CHOOSE OF b-exit IN FRAME d-type-tmp
      700   DO:
      701     rid-list = "" .
      702   END.
      703   ON CHOOSE OF b-goods IN FRAME d-type-tmp
      704   DO:
      705         if not available ub.tmp-sale THEN
      706           return no-apply.
      707       run ref/tmpgdsl.w
      708           ( parParentProc ,  input ub.tmp-sale.tmp-code, input ub.tmp-sale.desc_ ).
      709   END.
      710   ON CHOOSE OF B-mark IN FRAME d-type-tmp
      711   DO:
      712   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      713   define variable v-str-recid6 as character no-undo .
      714   define variable v-num-entry6 as integer   no-undo .
      715   assign
      716     v-str-recid6 = trim( string( recid( ub.tmp-sale ) , "->>>>>>>>>>>9":U ) )
      717     v-num-entry6 = lookup( v-str-recid6 , rid-list )
      718   .
      719   if v-num-entry6 > 0 then do:
      720     assign
      721       entry( v-num-entry6, rid-list ) = "":U
      722       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      723     .
      724   end.
      725   else do:
      726     assign
      727       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid6
      728     .
      729   end.
      730      g#log = br-tmp-sale  :refresh( ) in frame d-type-tmp.
      731       if not can-do ("MOUSE-SELECT-DBLCLICK,Return", last-event:function) then do:
      732               g#log = br-tmp-sale:select-next-row () in frame d-type-tmp.
      733               apply "iteration-changed" to br-tmp-sale in frame d-type-tmp.
      734       end.
      735       if num-entries (rid-list) = 0 then
      736           hide mark-num in frame d-type-tmp.
      737       else
      738       disp num-entries (rid-list) @ mark-num
      739       with frame d-type-tmp.
      740       apply "entry" to br-tmp-sale in frame d-type-tmp.
      741   END.
      742   ON CHOOSE OF b-print IN FRAME d-type-tmp
      743   DO:
      744       def var sym1 as char init ":"   no-undo.
      745       def var sym2 as char init ":"   no-undo.
      746       def var sym3 as char init ":"   no-undo.
      747       def var Line                    as char         no-undo.
      748       def var ii      as integer   no-undo.
      749       def var StartRecid      as integer   no-undo.
      750       DEFINE FRAME List
      751           sym1 column-label ":" format "x(1)"
      752           ub.tmp-sale.tmp-code column-label 'код':U format "9999"
      753           sym2 column-label ":" format "x(1)"
      754           ub.tmp-sale.desc_ column-label "Наименование" format "x(80)"
      755           sym3 column-label ":" format "x(1)"
      756           HEADER
      757                   cur-time-print () format "X(35)" at 5
      758                   string( "Страница " + string( PAGE-NUMBER( ListStream ) , ">>9") )
      759                       AT 86 format "X(15)" SKIP
      760               Line format "x(110)" AT 1
      761           with width 160 down use-text stream-io no-box .
      762       if num-results( "br-tmp-sale" ) = 0 then
      763           do:
      764               message "Список  П У С Т !" skip view-as alert-box information .
      765               return no-apply .
      766           end.
      767       Line = fill( "-" , 140 ) .
      768       StartRecid = recid( ub.tmp-sale ) .
      769       DO WHILE available ub.tmp-sale :
      770           GET prev br-tmp-sale NO-LOCK .
      771       END.
      772       GET next br-tmp-sale NO-LOCK .
      773       ii = 1 .
      774   output stream ListStream to value( string( session:temp-directory +
      775                                        "rpt" + string( g#report-num ) ) )
      776                                        page-size 62 .
      777       FORM HEADER
      778                   Line format "X(130)" SKIP
      779                   "Продолжение - на следующей странице" AT 30 SKIP
      780                   with FRAME CliBottomFrame width 160 PAGE-BOTTOM NO-LABELS no-box.
      781       VIEW stream ListStream FRAME CliBottomFrame .
      782       PUT stream ListStream space(20)
      783           "С П И С О К  Т Е М П О В   П Р О Д А Ж" format "X(100)" SKIP(2) .
      784       FORM with frame List .
      785       DO WHILE available ub.tmp-sale :
      786           DISPLAY stream ListStream
      787                           sym1 ub.tmp-sale.tmp-code
      788                           sym2 ub.tmp-sale.desc_
      789                           sym3    with frame List .
      790           DOWN stream ListStream 1 with frame List .
      791           ii =  ii + 1 .
      792           if ( ( ii modulo 10 ) = 0 ) AND ( ii >= 10 ) then
      793               run waitfram-show in this-procedure
      794                  ( "Просмотрено строк : " + string( ii ) ) .
      795           GET next br-tmp-sale .
      796       END.
      797       PUT stream ListStream Line format "X(110)" SKIP.
      798       HIDE stream ListStream FRAME CliBottomFrame .
      799       output stream ListStream close .
      800       define variable v-user-action as character no-undo .
      801       define variable v-printed as logical   no-undo .
      802       define variable DisabledOptions as integer   no-undo .
      803       DisabledOptions = 0 .
      804       run gbl/prnfilen.w
      805         (input  ""
      806         ,input  DisabledOptions
      807         ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
      808         ,input  7
      809         ,output v-user-action
      810         ,output v-printed
      811         ) .
      812       reposition br-tmp-sale to recid StartRecid NO-ERROR .
      813       run waitfram-hide in this-procedure .
      814   END.
      815   ON CHOOSE OF b-sel IN FRAME d-type-tmp
      816   DO:
      817       if ( available ub.tmp-sale ) AND ( rid-list = "" ) then
      818           rid-list = string( recid( ub.tmp-sale ) ) .
      819   END.
      820   ON DEFAULT-ACTION OF br-tmp-sale IN FRAME d-type-tmp
      821   DO:
      822     case yes:
      823         when  b-chg:sensitive THEN apply "CHOOSE":U to b-chg.
      824     end case.
      825   END.
      826   ON MOUSE-SELECT-DBLCLICK OF br-tmp-sale IN FRAME d-type-tmp
      827   DO:
      828       if lookup ( "b-sel", bttns ) > 0  then
      829           do:
      830               apply "choose" to b-sel in frame d-type-tmp .
      831               return no-apply .
      832           end.
      833   END.
      834   ON RETURN OF br-tmp-sale IN FRAME d-type-tmp
      835   DO:
      836       if Lookup( "b-sel",  bttns ) > 0 then
      837           do:
      838               apply "choose" to b-sel in frame d-type-tmp .
      839               return no-apply .
      840           end.
      841       else
      842           apply "DEFAULT-ACTION":U to self.
      843   END.
      844   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-type-tmp:PARENT eq ?
      845   THEN FRAME d-type-tmp:PARENT = ACTIVE-WINDOW.
      846   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      847   on help of frame d-type-tmp
      848   do:
      849     run gbl/app_help.p
      850       (input this-procedure :file-name
      851       ,input ''
      852       ,input ?
      853       ) no-error.
      854     if error-status :error then do:
      855       message
      856         "Ошибка при вызове помощи"
      857         error-status :get-message(1)
      858         view-as alert-box .
      859     end.
      860   end.
      861   run minbtn-set in this-procedure .
      862   on choose of b-help in frame d-type-tmp
      863   do:
      864     apply "help":u to frame d-type-tmp .
      865   end.
      866   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      867   procedure minbtn-set :
      868       do
      869           on error undo, return error return-value
      870           :
      871           define variable ii              as integer       no-undo .
      872           define variable fh              as widget-handle no-undo .
      873           define variable hh              as widget-handle no-undo .
      874           define variable v-h             as handle        extent 4 no-undo .
      875           define variable v-name-button   as character     no-undo .
      876           define variable v-help-old-x    as decimal       no-undo .
      877           define variable v-help-old-y    as decimal       no-undo .
      878           define variable v-help-old-size as decimal       no-undo .
      879           define variable v-frame-width   as decimal       no-undo .
      880           define variable jj              as integer       no-undo .
      881           do
      882               on error undo, return error
      883               :
      884               assign
      885                   v-frame-width = frame d-type-tmp:width - 0.3
      886                   fh            = frame d-type-tmp:first-child
      887                   hh            = fh:first-child
      888                   ii            = 1
      889                   .
      890               do while valid-handle(hh):
      891                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      892                   do:
      893                       case lc(hh:name) :
      894                           when "b-help" then
      895                               do:
      896                                   hh:load-image-up("cmp/b-help.bmp":u) .
      897                                   hh:load-image-down("cmp/b-help.bmp":u) .
      898                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      899                                   hh:TOOLTIP = "Помощь" .
      900                                   v-help-old-x = hh:column .
      901                                   v-help-old-y = hh:row    .
      902                                   v-help-old-size = hh:width .
      903                                   hh:width-chars = 2.5 .
      904                               end.
      905                           when "b-print" then
      906                               do:
      907                                   hh:load-image("cmp/b-print.bmp":u) .
      908                                   hh:TOOLTIP = "Печать" .
      909                                   v-h[ii] = hh:handle .
      910                                   ii = ii + 1 .
      911                                   hh:width-chars = 3 .
      912                               end.
      913                           when "b-history" or
      914                           when "b-hist" then
      915                               do:
      916                                   hh:load-image("cmp/b-hist.bmp":u) .
      917                                   hh:TOOLTIP = "История" .
      918                                   v-h[ii] = hh:handle .
      919                                   ii = ii + 1 .
      920                                   hh:width-chars = 3 .
      921                               end.
      922                           when "b-sch" then
      923                               do:
      924                                   hh:load-image("cmp/b-sch.bmp":u) .
      925                                   hh:TOOLTIP = "Установка Фильтра" .
      926                                   v-h[ii] = hh:handle .
      927                                   ii = ii + 1 .
      928                                   hh:width-chars = 3 .
      929                               end.
      930                           when "b-hist-user" then
      931                               do:
      932                                   hh:load-image("cmp/b-hist.bmp":u) .
      933                                   hh:TOOLTIP = "История пользователя" .
      934                                   ii = ii + 1 .
      935                               end.
      936                       end case.
      937                   end.
      938                   hh = hh:next-sibling.
      939               end.
      940               b-help:column = v-frame-width - b-help:width-chars.
      941               jj = 0.
      942               repeat ii = 4 to 1 by -1 :
      943                   if valid-handle (v-h[ii] ) then
      944                   do:
      945                       jj  = jj + 1 .
      946                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      947                       v-h[ii]:row    = v-help-old-y .
      948                   end.
      949               end.
      950           end.
      951       end.
      952   end procedure.
      953   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      954   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      955   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      956   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      957   define variable v-diasize-current-frame-width  as decimal   no-undo .
      958   define variable v-diasize-current-frame-height as decimal   no-undo .
      959   define variable v-diasize-change-size          as logical   no-undo .
      960   define variable v-diasize-resize-button        as handle    no-undo .
      961   define variable v-diasize-wndmax               as logical   no-undo .
      962   define variable v-diasize-wndstore             as logical   no-undo .
      963   define variable v-diasize-proc-name            as character no-undo .
      964   define variable v-diasize-browse-handle        as handle    no-undo .
      965   define variable v-diasize-browse-number        as integer   no-undo .
      966   define variable v-diasize-need-full-display    as logical   no-undo init false .
      967   define temp-table temp-diasize-handle no-undo
      968     field handle-value  as handle
      969     field save-position as decimal
      970     index xpk is primary unique handle-value
      971     .
      972   define temp-table temp-browse-handle no-undo
      973     field browse-type   as character
      974     field browse-number as integer
      975     field browse-handle as handle
      976     field original-size as decimal
      977     index xpk is primary unique browse-type browse-number
      978     index xie browse-type browse-handle
      979   .
      980   procedure diasize_change-height :
      981     define input  parameter p-change-value  as decimal   no-undo .
      982     define input  parameter p-move-resize   as logical   no-undo .
      983     define variable v-field-group-handle    as handle    no-undo .
      984     define variable v-object-handle         as handle    no-undo .
      985     define variable v-frame-height          as decimal   no-undo .
      986     define variable v-frame-virtual-height  as decimal   no-undo .
      987     define variable v-browse-height         as decimal   no-undo .
      988     define variable v-window-height         as decimal   no-undo .
      989     define variable v-window-virtual-height as decimal   no-undo .
      990     define variable v-change-sign           as integer   no-undo .
      991     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      992     define buffer buf_temp-browse-handle  for temp-browse-handle .
      993     if p-change-value > 0
      994     then do:
      995       if frame d-type-tmp :height + p-change-value
      996           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      997       then do:
      998         assign
      999           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1000                           - (frame d-type-tmp :height-chars)
     1001         .
     1002         if p-change-value <= 0
     1003         then do:
     1004           run diasize_position-resize-button in this-procedure .
     1005           return .
     1006         end.
     1007       end.
     1008     end.
     1009     if p-change-value < 0
     1010     then do:
     1011       if frame d-type-tmp :height + p-change-value < v-diasize-orig-frame-height
     1012       then do:
     1013         assign
     1014           p-change-value = v-diasize-orig-frame-height
     1015                          - (frame d-type-tmp :height-chars)
     1016         .
     1017         if p-change-value >= 0
     1018         then do:
     1019           run diasize_position-resize-button in this-procedure .
     1020           return .
     1021         end.
     1022       end.
     1023     end.
     1024     if p-change-value >= 0
     1025     then do:
     1026       assign
     1027         v-change-sign = 1
     1028       .
     1029     end.
     1030     else do:
     1031       assign
     1032         v-change-sign = -1
     1033       .
     1034     end.
     1035     assign
     1036       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1037     .
     1038     if p-change-value = 0
     1039     then do:
     1040       run diasize_position-resize-button in this-procedure .
     1041       return .
     1042     end.
     1043     move_block:
     1044     do
     1045     on error undo move_block, retry move_block
     1046     :
     1047       if retry
     1048       then do:
     1049         do
     1050         on error undo move_block, leave move_block
     1051         :
     1052           if p-change-value > 0
     1053           then do:
     1054             for each buf_temp-diasize-handle
     1055             on error undo, next
     1056             :
     1057               assign
     1058                 v-object-handle = buf_temp-diasize-handle.handle-value
     1059               .
     1060               if v-object-handle <> v-diasize-resize-button
     1061               then do:
     1062                 assign
     1063                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1064                 .
     1065               end.
     1066             end.
     1067             assign
     1068               v-diasize-browse-handle :height = v-browse-height
     1069             .
     1070             for each buf_temp-browse-handle
     1071               where buf_temp-browse-handle.browse-type = 'height':u
     1072             on error undo, next
     1073             :
     1074               assign
     1075                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1076               .
     1077             end.
     1078             assign
     1079               frame d-type-tmp :height = v-frame-height
     1080             .
     1081             if frame d-type-tmp :scrollable = true
     1082             then do:
     1083               assign
     1084                 frame d-type-tmp :virtual-height = v-frame-virtual-height
     1085               .
     1086             end.
     1087             run diasize_position-resize-button in this-procedure .
     1088           end.
     1089           else do:
     1090             if frame d-type-tmp :scrollable = true
     1091             then do:
     1092               assign
     1093                 frame d-type-tmp :virtual-height = v-frame-virtual-height
     1094               .
     1095             end.
     1096             assign
     1097               frame d-type-tmp :height = v-frame-height
     1098             .
     1099             assign
     1100               v-diasize-browse-handle :height = v-browse-height
     1101             .
     1102             for each buf_temp-browse-handle
     1103               where buf_temp-browse-handle.browse-type = 'height':u
     1104             on error undo, next
     1105             :
     1106               assign
     1107                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1108               .
     1109             end.
     1110             for each buf_temp-diasize-handle
     1111             on error undo, next
     1112             :
     1113               assign
     1114                 v-object-handle = buf_temp-diasize-handle.handle-value
     1115               .
