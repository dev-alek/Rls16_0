     1230         or error-status :get-message(1) <> ""
     1231         then do:
     1232           undo move_block, retry move_block .
     1233         end.
     1234         for each buf_temp-browse-handle
     1235           where buf_temp-browse-handle.browse-type = 'height':u
     1236         on error undo move_block, retry move_block
     1237         :
     1238           assign
     1239             buf_temp-browse-handle.browse-handle :height
     1240               = buf_temp-browse-handle.browse-handle :height + p-change-value
