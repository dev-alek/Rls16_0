        1   DEFINE TEMP-TABLE Temp-hattr NO-UNDO LIKE ub.cash-desk-attr
        2          field user-can-edit as log
        3          field code as character
        4          field value_ as character
        5          field to-send as logical
        6          iNDEX pi is unique primary
        7          db-num
        8          obj-code
        9          pos-type
