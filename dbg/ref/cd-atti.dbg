      725   procedure proc-alt-shift-f2:
      726     if not ibs.th.gbl.gbl-var:rcode
      727   then
      728     run gbl\inidebug.p .
      729   end.
      730   procedure proc-alt-shift-f3:
      731     run gbl/prvssinf.p
      732       ( input this-procedure
      733       ) .
      734   end.
      735   define variable v-inform-launched as logical no-undo initial false .
      736   procedure proc-alt-shift-f4:
      737     define variable v-action as character no-undo .
      738     if v-inform-launched = false then do:
      739       assign
      740         v-inform-launched = true
      741       .
      742       run gbl/d-inform.w
      743         (  input self
      744         ,  input this-procedure
      745         , output v-action
      746         ) no-error .
      747       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      748       assign
      749         v-inform-launched = false
      750       .
      751     end.
      752   end.
      753   procedure proc-alt-f1:
      754     run gbl/corrhelp.p
      755       (input this-procedure
      756       ) .
      757   end .
      758   on alt-shift-f2 anywhere do:
      759     run proc-alt-shift-f2.
      760   end.
      761   on alt-shift-f3 anywhere do:
      762     run proc-alt-shift-f3 in this-procedure .
      763   end.
      764   on alt-shift-f4 anywhere do:
      765     run proc-alt-shift-f4 in this-procedure.
      766   end.
      767   on alt-f1 anywhere do:
      768     run proc-alt-f1 in this-procedure .
      769   end.
      770   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      771     define variable v-cntxt-db-num        as integer   no-undo .
      772     define variable v-cntxt-userid        as character no-undo .
      773     define variable v-cntxt-level         as character no-undo .
      774     define variable v-cntxt-host-code-obj as integer   no-undo .
      775     define variable v-cntxt-obj-type      as character no-undo .
      776     define variable v-cntxt-obj-code      as integer   no-undo .
      777     define variable v-cntxt-db-num-obj    as integer   no-undo .
      778     define variable v-cntxt-is-admin      as logical   no-undo .
      779   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      780   define temp-table tt-attr-property  no-undo
      781   field upper-attr-code as character
      782   field attr-code as character
      783   field table-name as character
      784   field edit-menu-section-num as integer
      785   field attr-label as character
      786   field menu-item-handle as widget-handle
      787   field user-can-edit as logical
      788   field menu-name as character
      789   field parent-handle as handle
      790   index pi is unique primary
      791   table-name
      792   menu-name
      793   upper-attr-code
      794   attr-code
      795   index i-section
      796   edit-menu-section-num
      797   .
      798   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      799   procedure attr-pop-create-items :
      800   define input parameter p-table-name as character no-undo .
      801   define input parameter p-get-section-num-proc-name as character no-undo .
      802   define input parameter p-get-attr-label-proc-name as character no-undo .
      803   define input parameter p-attr-choose-proc-name as character no-undo .
      804   define input parameter p-menu-handle as widget-handle no-undo .
      805   define input parameter p-upper-attr-code as character no-undo .
      806   define input parameter p-attr-list as character no-undo .
      807   define variable ii as integer no-undo .
      808   define variable V-CREATED as logical no-undo .
      809   define variable v-tool-tip as character no-undo .
      810   define variable v-dop as character no-undo .
      811   define variable v-attr-item as character no-undo .
      812   define buffer buf_tt-attr-property for tt-attr-property.
      813     do
      814     on error undo, return error return-value
      815     :
      816        do ii = 1 to num-entries (p-attr-list):
      817          v-attr-item = entry(ii, p-attr-list) .
      818          find first tt-attr-property where
      819                    tt-attr-property.table-name = p-table-name
      820                and tt-attr-property.attr-code = v-attr-item
      821                and tt-attr-property.upper-attr-code = p-upper-attr-code
      822                and tt-attr-property.menu-name = p-menu-handle:name  no-error .
      823          if not available tt-attr-property then do:
      824            create tt-attr-property.
      825            assign
      826            tt-attr-property.table-name = p-table-name
      827            tt-attr-property.attr-code = v-attr-item
      828            tt-attr-property.upper-attr-code = p-upper-attr-code
      829            tt-attr-property.menu-name = p-menu-handle:name
      830            .
      831            run value ( p-get-section-num-proc-name) (
      832                                                      input p-upper-attr-code,
      833                                                      input tt-attr-property.attr-code
      834                                                     ,output tt-attr-property.edit-menu-section-num ) no-error .
      835            run value ( p-get-attr-label-proc-name ) (
      836                                           input p-upper-attr-code,
      837                                           input tt-attr-property.attr-code
      838                                          ,output v-tool-tip
      839                                          ,output tt-attr-property.attr-label
      840                                         ) no-error .
      841            release tt-attr-property.
      842          end.
      843        end.
      844        for each tt-attr-property where tt-attr-property.menu-name = p-menu-handle:name
      845        break
      846        by  tt-attr-property.edit-menu-section-num
      847        by  tt-attr-property.attr-label
      848        :
      849          if tt-attr-property.edit-menu-section-num > 0
      850          then do:
      851             if not valid-handle(tt-attr-property.menu-item-handle) then do:
      852               if num-entries(tt-attr-property.attr-code, chr(4)) > 1
      853               and entry(2, tt-attr-property.attr-code, chr(4)) <> '':U
      854               then do:
      855                 find first buf_tt-attr-property where
      856                           buf_tt-attr-property.table-name = p-table-name
      857                       and buf_tt-attr-property.menu-name = p-menu-handle:name
      858                       and buf_tt-attr-property.upper-attr-code = p-upper-attr-code
      859                       and buf_tt-attr-property.attr-code = entry(1, tt-attr-property.attr-code, chr(4)) no-error .
      860                 if not available buf_tt-attr-property then do:
      861                   create buf_tt-attr-property.
      862                   assign
      863                   buf_tt-attr-property.table-name = p-table-name
      864                   buf_tt-attr-property.attr-code = entry(1, tt-attr-property.attr-code, chr(4))
      865                   buf_tt-attr-property.upper-attr-code = p-upper-attr-code
      866                   buf_tt-attr-property.menu-name = p-menu-handle:name
      867                   .
      868                   create sub-menu buf_tt-attr-property.menu-item-handle
      869                   assign
      870                   name = entry(1, tt-attr-property.attr-code, chr(4))  + chr(4)  + p-menu-handle:name
      871                   parent = p-menu-handle.
      872                 end.
      873                 create menu-item tt-attr-property.menu-item-handle
      874                 assign
      875                 label = tt-attr-property.attr-label
      876                 name = tt-attr-property.attr-code  + chr(4)  + p-menu-handle:name
      877                 parent = buf_tt-attr-property.menu-item-handle
      878                 triggers:
      879                   on choose
      880                     persistent run value(p-attr-choose-proc-name + "-2") (
      881                                                                           input tt-attr-property.upper-attr-code,
      882                                                                            input  entry(1, tt-attr-property.attr-code, chr(4) )
      883                                                                           ,input entry(2, tt-attr-property.attr-code, chr(4) )
      884                                                                             ) .
      885                 end triggers.
      886                 assign
      887                 v-created = yes.
      888               end.
      889               else do:
      890                 create menu-item tt-attr-property.menu-item-handle
      891                 assign
      892                 label = tt-attr-property.attr-label
      893                 name = entry(1, tt-attr-property.attr-code, chr(4)) + chr(4)  + p-menu-handle:name
      894                 parent = p-menu-handle
      895                 triggers:
      896                   on choose
      897                     persistent run value(p-attr-choose-proc-name) (
      898                                                                     input tt-attr-property.upper-attr-code,
      899                                                                    input  entry(1, tt-attr-property.attr-code, chr(4) )) .
      900                 end triggers.
      901                 assign
      902                 v-created = yes.
      903               end.
      904             end.
      905             if last-of(tt-attr-property.edit-menu-section-num)
      906               then do:
      907               find first buf_tt-attr-property where
      908                         buf_tt-attr-property.table-name = p-table-name
      909                    and  buf_tt-attr-property.attr-code = substitute("&1&2&3"
      910                                                            , p-table-name
      911                                                            , tt-attr-property.edit-menu-section-num
      912                                                            , p-menu-handle:name
      913                                                            )
      914                     and buf_tt-attr-property.menu-name = p-menu-handle:name  no-error .
      915               if not available buf_tt-attr-property then do:
      916                 create buf_tt-attr-property.
      917                 assign
      918                 buf_tt-attr-property.table-name = p-table-name
      919                 buf_tt-attr-property.edit-menu-section-num =  - 1
      920                 buf_tt-attr-property.menu-name = p-menu-handle:name
      921                 buf_tt-attr-property.upper-attr-code = ''
      922                 buf_tt-attr-property.attr-code = substitute("&1&2&3"
      923                                                             , p-table-name
      924                                                             , tt-attr-property.edit-menu-section-num
      925                                                             , p-menu-handle:name
      926                                                             )
      927                 .
      928                 create menu-item buf_tt-attr-property.menu-item-handle
      929                 assign
      930                 subtype = "rule"
      931                 parent = p-menu-handle
      932                 .
      933               end.
      934             end.
      935          end.
      936        end.
      937        if not v-created then do:
      938           run attr-pop-clean-up in this-procedure ( input p-table-name).
      939        end.
      940     end.
      941   end procedure.
      942   procedure attr-pop-clean-up :
      943   define input parameter p-table-name as character no-undo .
      944     for each tt-attr-property where
      945             tt-attr-property.table-name = p-table-name
      946       and tt-attr-property.edit-menu-section-num > 0:
      947       if valid-handle ( tt-attr-property.menu-item-handle) then do:
      948         delete widget tt-attr-property.menu-item-handle.
      949       end.
      950       delete tt-attr-property.
      951     end.
      952     for each tt-attr-property where
      953              tt-attr-property.table-name = p-table-name
      954          and tt-attr-property.edit-menu-section-num =  - 1:
      955       if valid-handle ( tt-attr-property.menu-item-handle) then do:
      956         delete widget tt-attr-property.menu-item-handle.
      957       end.
      958       delete tt-attr-property.
      959     end.
      960   end procedure.
      961   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      962   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      963   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      964   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      965   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      966   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      967   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      968   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      969   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      970   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      971   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      972   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      973   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      974   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      975   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      976   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      977   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      978   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      979   define variable updated as logical no-undo.
      980   DEFINE VARIABLE added  as logical no-undo .
      981   define variable add-option as character no-undo.
      982   define variable add-option-section as character no-undo.
      983   define variable send-option as char no-undo.
      984   define variable temp-doc-rec as recid no-undo.
      985   define variable v-view-col as logical no-undo extent 6.
      986   define buffer buf_cash-desk for ub.cash-desk.
      987   DEFINE VARIABLE v-ch_ AS WIDGET-HANDLE NO-UNDO EXTENT 5.
      988   define variable v-glog as logical no-undo .
      989   define variable v-cash-desk-host-code as integer no-undo .
      990   DEFINE MENU MENU-b-ins .
      991   DEFINE MENU POPUP-MENU-B-send
      992          MENU-ITEM m_current      LABEL "Выделенный"
      993          MENU-ITEM m_all          LABEL "Все"           .
      994   DEFINE VARIABLE CtrlFrame AS WIDGET-HANDLE NO-UNDO.
      995   DEFINE VARIABLE chCtrlFrame AS COMPONENT-HANDLE NO-UNDO.
      996   DEFINE BUTTON b-chg
      997        LABEL "&Изменить":L
      998        SIZE 10 BY 1 TOOLTIP "Изменить атрибут/параметр кассы".
      999   DEFINE BUTTON b-del
     1000        LABEL "&Удалить":L
     1001        SIZE 10 BY 1 TOOLTIP "Удалить  атрибут/параметр кассы".
     1002   DEFINE BUTTON b-help
     1003        LABEL "Помо&щь":L
     1004        SIZE 3 BY 1.
     1005   DEFINE BUTTON b-ins
     1006        LABEL "&Добавить":L
     1007        SIZE 10 BY 1 TOOLTIP "Добавить атрибут/параметр кассы".
     1008   DEFINE BUTTON b-lkp
     1009        LABEL "&Просмотр"
     1010        SIZE 10 BY 1.
     1011   DEFINE BUTTON b-quit AUTO-GO
     1012        LABEL "&Выход ":L
     1013        SIZE 10 BY 1 TOOLTIP "Выход из режима".
     1014   DEFINE BUTTON B-send
     1015        LABEL "&Послать"
     1016        SIZE 10 BY 1.
     1017   DEFINE VARIABLE cd-cash-num AS INTEGER FORMAT ">>>9":U INITIAL 0
     1018        LABEL "№"
     1019         VIEW-AS TEXT
     1020        SIZE 6 BY 1
     1021        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1022   DEFINE VARIABLE cd-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1023        LABEL "БД"
     1024         VIEW-AS TEXT
     1025        SIZE 9.6 BY 1
     1026        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1027   DEFINE VARIABLE cd-obj-code AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1028        LABEL "маг"
     1029         VIEW-AS TEXT
     1030        SIZE 6 BY 1
     1031        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1032   DEFINE VARIABLE cd-pos-type AS CHARACTER FORMAT "X(10)":U
     1033        LABEL "Тип"
     1034         VIEW-AS TEXT
     1035        SIZE 16 BY 1
     1036        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1037   DEFINE QUERY br-attrs FOR
     1038         Temp-hattr SCROLLING.
     1039   DEFINE BROWSE br-attrs
     1040     QUERY br-attrs DISPLAY
     1041         Temp-hattr.attr-code COLUMN-LABEL "Атрибут/Параметр" FORMAT "X(255)":U
     1042               WIDTH 30
     1043         Temp-hattr.attr-value-character COLUMN-LABEL "Значение!(строковое)"  FORMAT "X(255)":U
     1044               WIDTH 35
     1045         Temp-hattr.attr-value-date COLUMN-LABEL "Значение!(Дата)" FORMAT "99/99/9999":U
     1046         Temp-hattr.attr-value-decimal COLUMN-LABEL "Значение!(Десятичное)" FORMAT "->>>,>>>,>>9.99":U
     1047               WIDTH 16
     1048         Temp-hattr.attr-value-integer COLUMN-LABEL "Значение!(Целое)" FORMAT "->>>,>>>,>>9":U
     1049         Temp-hattr.attr-value-logical COLUMN-LABEL "Значение!(Логическое)" FORMAT "+/-":U
     1050         to-send COLUMN-LABEL "Подлежит!пересылке" FORMAT "+/-":U
     1051       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 18.97
     1052            FONT 4.
     1053   DEFINE FRAME Dialog-Frame
     1054        b-quit AT ROW 1 COL 1
     1055        b-ins AT ROW 1 COL 21
     1056        b-chg AT ROW 1 COL 31
     1057        b-lkp AT ROW 1 COL 41
     1058        b-del AT ROW 1 COL 51
     1059        B-send AT ROW 1 COL 61
     1060        b-help AT ROW 1.03 COL 95
     1061        br-attrs AT ROW 4.47 COL 1
     1062        cd-db-num AT ROW 3.3 COL 1
     1063        cd-obj-code AT ROW 3.3 COL 15
     1064        cd-pos-type AT ROW 3.3 COL 33.8
     1065        cd-cash-num AT ROW 3.3 COL 58.8
     1066        SPACE(31.49) SKIP(19.14)
     1067       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1068            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1069            TITLE "Атрибуты и/или Параметры кассы".
     1070   ASSIGN
     1071          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1072          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1073   ASSIGN
     1074          B-send:POPUP-MENU IN FRAME Dialog-Frame       = MENU POPUP-MENU-B-send:HANDLE.
     1075   CREATE CONTROL-FRAME CtrlFrame ASSIGN
     1076          FRAME           = FRAME Dialog-Frame:HANDLE
     1077          ROW             = 1.53
     1078          COLUMN          = 81.5
     1079          HEIGHT          = 1.6
     1080          WIDTH           = 5.5
     1081          WIDGET-ID       = 2
     1082          HIDDEN          = yes
     1083          SENSITIVE       = yes.
     1084         CtrlFrame:MOVE-AFTER(b-help:HANDLE IN FRAME Dialog-Frame).
     1085   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1086   DO:
     1087     APPLY "END-ERROR":U TO SELF.
     1088   END.
     1089   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1090   DO:
     1091     if not avail temp-hattr then return no-apply.
     1092     run proc-add-chg in this-procedure ( input no ) no-error.
     1093     if error-status:error then return no-apply.
     1094     run init-proc in this-procedure .
     1095   END.
     1096   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1097   DO:
     1098   define variable loc#log as logical no-undo.
     1099   define variable attr-type as character no-undo .
     1100   define variable attr-format as character no-undo .
     1101   define variable attr-label as character no-undo .
     1102   define variable attr-user-can-edit as logical no-undo .
     1103   define variable attr-output-display as logical no-undo .
     1104   define variable attr-other as char no-undo .
     1105   define variable v-prop-list as character no-undo .
     1106   define variable glog as logical no-undo .
     1107   DEFINE VARIABLE v-check AS CHARACTER NO-UNDO.
     1108   define variable v-correct as logical no-undo .
     1109   define variable v-error-code as character no-undo .
     1110   DEFINE VARIABLE jj AS INTEGER NO-UNDO.
     1111     if not avail temp-hattr then return no-apply.
     1112       if not p-glog and Temp-hattr.code = "last-check-params" then
     1113       return no-apply .
     1114       if not v-glog and Temp-hattr.code <> "last-check-params" then return no-apply .
     1115     run cd-attr-code in this-procedure (
     1116                                          input  temp-hattr.upper-attr-code
     1117                                         ,input  temp-hattr.code
     1118                                         ,output attr-type
     1119                                         ,output attr-format
     1120                                         ,output attr-label
     1121                                         ,output attr-user-can-edit
     1122                                         ,output attr-output-display
     1123                                         ,output attr-other
     1124                                         ,output v-prop-list
     1125                                         ) .
     1126     if not attr-user-can-edit then do:
     1127       message
     1128       "Атрибут/Параметр нельзя удалить вручную"
     1129       view-as alert-box error .
     1130       return no-apply.
     1131     end.
     1132        do jj = 1 to num-entries(attr-other, chr(47)):
     1133       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "check":U then do:
     1134         assign
     1135         v-check = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     1136         .
     1137       end.
     1138     end.
     1139     if v-check <> "":U then do:
     1140       run value(v-check) (
     1141                          input p-db-num
     1142                         ,input p-obj-code
     1143                         ,input p-pos-type
     1144                         ,INPUT p-cash-num
     1145                         ,input temp-hattr.upper-attr-code
     1146                         ,input temp-hattr.code
     1147                         ,input "0":U
     1148                         ,input 'удаление':U
     1149                         ,output v-correct
     1150                         ,output v-error-code) no-error.
     1151       if error-status:error then do:
     1152         message
     1153         "Ошибка при проверке корректности удаления атрибута/параметра" skip
     1154         error-status:get-message(1) skip
     1155         view-as alert-box error .
     1156         undo, return no-apply .
     1157       end.
     1158       if not v-correct then do:
     1159         message
     1160         "Удаление атрибута/параметра некорректно" skip
     1161         return-value
     1162         view-as alert-box error .
     1163         undo, return no-apply .
     1164       end.
     1165     end.
     1166     glog = no.
     1167     message
     1168     "Вы уверены, что хотите удалить атрибут/параметр " temp-hattr.attr-code skip
     1169     " для кассы"
     1170     view-as alert-box QUESTIOn buttons YES-NO update glog.
     1171     if NOT glog then return no-apply.
     1172       run cd-attr-delete in this-procedure (
     1173                                             input p-db-num
     1174                                           ,input p-obj-code
     1175                                           ,input p-pos-type
     1176                                           ,input p-cash-num
     1177                                           ,input temp-hattr.upper-attr-code
     1178                                           ,input temp-hattr.code
     1179                                           ,output loc#log) no-error .
     1180       if error-status:error or not loc#log then do:
     1181          message "Ошибка при удалении атрибута/параметра кассы!"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     1182          return no-apply.
     1183       end.
     1184       delete temp-hattr.
     1185       updated = yes.
     1186       run init-proc in this-procedure .
     1187   END.
     1188   ON CHOOSE OF b-ins IN FRAME Dialog-Frame
     1189   DO:
     1190   define variable attr-type as character no-undo .
     1191   define variable attr-format as character no-undo .
     1192   define variable attr-label as character no-undo .
     1193   define variable attr-user-can-edit as logical no-undo .
     1194   define variable attr-output-display as logical no-undo .
     1195   define variable attr-other as char no-undo .
     1196   define variable loc#log as logical no-undo.
     1197   define buffer buf_temp-hattr for temp-hattr.
     1198   if add-option = "" then do:
     1199     run gbl/pop-up.p ( input self:handle, input no) no-error.
     1200   end.
     1201   if add-option = "":U then return no-apply.
     1202   run proc-add-chg in this-procedure ( input yes) no-error .
     1203   if error-status:error then do:
     1204     add-option = "":U.
     1205     add-option-section = ''.
     1206     return no-apply.
     1207   end.
     1208   run init-proc in this-procedure .
     1209   find first buf_temp-hattr no-lock where
     1210                           buf_temp-hattr.code = add-option no-error.
     1211   add-option = "":U.
     1212   add-option-section = ''.
     1213   if avail buf_temp-hattr then
     1214       temp-doc-rec = recid(buf_temp-hattr).
     1215       else temp-doc-rec = ?.
     1216   reposition br-attrs to recid temp-doc-rec no-error.
     1217   if error-status:error then return no-apply.
     1218   END.
     1219   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1220   DO:
     1221       if not avail temp-hattr then return no-apply.
     1222     run proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
     1223     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1224   END.
     1225   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1226   DO:
     1227   END.
     1228   ON CHOOSE OF B-send IN FRAME Dialog-Frame
     1229   DO:
     1230     if send-option = "" then do:
     1231       run gbl/pop-up.p ( input self:handle, input no) no-error.
     1232     end.
     1233     if send-option = "":U then return no-apply.
     1234     if send-option = 'все':U then send-option = '':U.
     1235     run proc-b-send in this-procedure ( input '', input send-option ) no-error .
     1236     if error-status:error then do:
     1237       send-option = "":U.
     1238       return no-apply.
     1239     end.
     1240   END.
     1241   PROCEDURE CtrlFrame.PSTimer.Tick .
     1242   IF p-ref-mode <> "oper"
     1243   OR p-mode <> 'ПРОСМОТР':U
     1244   THEN RETURN.
     1245   RUN init-proc IN THIS-PROCEDURE NO-ERROR.
     1246   END PROCEDURE.
     1247   ON CHOOSE OF MENU-ITEM m_all
     1248   DO:
     1249     send-option = 'все':U.
     1250     apply "CHOOSE" to b-send in frame Dialog-Frame.
     1251   END.
     1252   ON CHOOSE OF MENU-ITEM m_current
     1253   DO:
     1254     IF NOT AVAILABLE temp-hattr THEN RETURN NO-APPLY.
     1255     send-option = temp-hattr.CODE.
     1256     apply "CHOOSE" to b-send in frame Dialog-Frame.
     1257   END.
     1258   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1259   on help of frame Dialog-Frame
     1260   do:
     1261     run gbl/app_help.p
     1262       (input this-procedure :file-name
     1263       ,input ''
     1264       ,input ?
     1265       ) no-error.
     1266     if error-status :error then do:
     1267       message
     1268         "Ошибка при вызове помощи"
     1269         error-status :get-message(1)
     1270         view-as alert-box .
     1271     end.
     1272   end.
     1273   run minbtn-set in this-procedure .
     1274   on choose of b-help in frame Dialog-Frame
     1275   do:
     1276     apply "help":u to frame Dialog-Frame .
     1277   end.
     1278   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1279   procedure minbtn-set :
     1280       do
     1281           on error undo, return error return-value
     1282           :
     1283           define variable ii              as integer       no-undo .
     1284           define variable fh              as widget-handle no-undo .
     1285           define variable hh              as widget-handle no-undo .
     1286           define variable v-h             as handle        extent 4 no-undo .
     1287           define variable v-name-button   as character     no-undo .
     1288           define variable v-help-old-x    as decimal       no-undo .
     1289           define variable v-help-old-y    as decimal       no-undo .
     1290           define variable v-help-old-size as decimal       no-undo .
     1291           define variable v-frame-width   as decimal       no-undo .
     1292           define variable jj              as integer       no-undo .
     1293           do
     1294               on error undo, return error
     1295               :
     1296               assign
     1297                   v-frame-width = frame Dialog-Frame:width - 0.3
     1298                   fh            = frame Dialog-Frame:first-child
     1299                   hh            = fh:first-child
     1300                   ii            = 1
     1301                   .
     1302               do while valid-handle(hh):
     1303                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1304                   do:
     1305                       case lc(hh:name) :
     1306                           when "b-help" then
     1307                               do:
     1308                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1309                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1310                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1311                                   hh:TOOLTIP = "Помощь" .
     1312                                   v-help-old-x = hh:column .
     1313                                   v-help-old-y = hh:row    .
     1314                                   v-help-old-size = hh:width .
     1315                                   hh:width-chars = 2.5 .
     1316                               end.
     1317                           when "b-print" then
     1318                               do:
     1319                                   hh:load-image("cmp/b-print.bmp":u) .
     1320                                   hh:TOOLTIP = "Печать" .
     1321                                   v-h[ii] = hh:handle .
     1322                                   ii = ii + 1 .
     1323                                   hh:width-chars = 3 .
     1324                               end.
     1325                           when "b-history" or
     1326                           when "b-hist" then
     1327                               do:
     1328                                   hh:load-image("cmp/b-hist.bmp":u) .
     1329                                   hh:TOOLTIP = "История" .
     1330                                   v-h[ii] = hh:handle .
     1331                                   ii = ii + 1 .
     1332                                   hh:width-chars = 3 .
     1333                               end.
     1334                           when "b-sch" then
     1335                               do:
     1336                                   hh:load-image("cmp/b-sch.bmp":u) .
     1337                                   hh:TOOLTIP = "Установка Фильтра" .
     1338                                   v-h[ii] = hh:handle .
     1339                                   ii = ii + 1 .
     1340                                   hh:width-chars = 3 .
     1341                               end.
     1342                           when "b-hist-user" then
     1343                               do:
     1344                                   hh:load-image("cmp/b-hist.bmp":u) .
     1345                                   hh:TOOLTIP = "История пользователя" .
     1346                                   ii = ii + 1 .
     1347                               end.
     1348                       end case.
     1349                   end.
     1350                   hh = hh:next-sibling.
     1351               end.
     1352               b-help:column = v-frame-width - b-help:width-chars.
     1353               jj = 0.
     1354               repeat ii = 4 to 1 by -1 :
     1355                   if valid-handle (v-h[ii] ) then
     1356                   do:
     1357                       jj  = jj + 1 .
     1358                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1359                       v-h[ii]:row    = v-help-old-y .
     1360                   end.
     1361               end.
     1362           end.
     1363       end.
     1364   end procedure.
     1365   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1366   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1367   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1368   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1369   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1370   define variable v-diasize-current-frame-height as decimal   no-undo .
     1371   define variable v-diasize-change-size          as logical   no-undo .
     1372   define variable v-diasize-resize-button        as handle    no-undo .
     1373   define variable v-diasize-wndmax               as logical   no-undo .
     1374   define variable v-diasize-wndstore             as logical   no-undo .
     1375   define variable v-diasize-proc-name            as character no-undo .
     1376   define variable v-diasize-browse-handle        as handle    no-undo .
     1377   define variable v-diasize-browse-number        as integer   no-undo .
     1378   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1379   define temp-table temp-diasize-handle no-undo
     1380     field handle-value  as handle
     1381     field save-position as decimal
     1382     index xpk is primary unique handle-value
     1383     .
     1384   define temp-table temp-browse-handle no-undo
     1385     field browse-type   as character
     1386     field browse-number as integer
     1387     field browse-handle as handle
     1388     field original-size as decimal
     1389     index xpk is primary unique browse-type browse-number
     1390     index xie browse-type browse-handle
     1391   .
     1392   procedure diasize_change-height :
     1393     define input  parameter p-change-value  as decimal   no-undo .
     1394     define input  parameter p-move-resize   as logical   no-undo .
     1395     define variable v-field-group-handle    as handle    no-undo .
     1396     define variable v-object-handle         as handle    no-undo .
     1397     define variable v-frame-height          as decimal   no-undo .
     1398     define variable v-frame-virtual-height  as decimal   no-undo .
     1399     define variable v-browse-height         as decimal   no-undo .
     1400     define variable v-window-height         as decimal   no-undo .
     1401     define variable v-window-virtual-height as decimal   no-undo .
     1402     define variable v-change-sign           as integer   no-undo .
     1403     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1404     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1405     if p-change-value > 0
     1406     then do:
     1407       if frame Dialog-Frame :height + p-change-value
     1408           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1409       then do:
     1410         assign
     1411           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1412                           - (frame Dialog-Frame :height-chars)
     1413         .
     1414         if p-change-value <= 0
     1415         then do:
     1416           run diasize_position-resize-button in this-procedure .
     1417           return .
     1418         end.
     1419       end.
     1420     end.
     1421     if p-change-value < 0
     1422     then do:
     1423       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1424       then do:
     1425         assign
     1426           p-change-value = v-diasize-orig-frame-height
     1427                          - (frame Dialog-Frame :height-chars)
     1428         .
     1429         if p-change-value >= 0
     1430         then do:
     1431           run diasize_position-resize-button in this-procedure .
     1432           return .
     1433         end.
     1434       end.
     1435     end.
     1436     if p-change-value >= 0
     1437     then do:
     1438       assign
     1439         v-change-sign = 1
     1440       .
     1441     end.
     1442     else do:
     1443       assign
     1444         v-change-sign = -1
     1445       .
     1446     end.
     1447     assign
     1448       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1449     .
     1450     if p-change-value = 0
     1451     then do:
     1452       run diasize_position-resize-button in this-procedure .
     1453       return .
     1454     end.
     1455     move_block:
     1456     do
     1457     on error undo move_block, retry move_block
     1458     :
     1459       if retry
     1460       then do:
     1461         do
     1462         on error undo move_block, leave move_block
     1463         :
     1464           if p-change-value > 0
     1465           then do:
     1466             for each buf_temp-diasize-handle
     1467             on error undo, next
     1468             :
     1469               assign
     1470                 v-object-handle = buf_temp-diasize-handle.handle-value
     1471               .
     1472               if v-object-handle <> v-diasize-resize-button
     1473               then do:
     1474                 assign
     1475                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1476                 .
     1477               end.
     1478             end.
     1479             assign
     1480               v-diasize-browse-handle :height = v-browse-height
     1481             .
     1482             for each buf_temp-browse-handle
     1483               where buf_temp-browse-handle.browse-type = 'height':u
     1484             on error undo, next
     1485             :
     1486               assign
     1487                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1488               .
     1489             end.
     1490             assign
     1491               frame Dialog-Frame :height = v-frame-height
     1492             .
     1493             if frame Dialog-Frame :scrollable = true
     1494             then do:
     1495               assign
     1496                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1497               .
     1498             end.
     1499             run diasize_position-resize-button in this-procedure .
     1500           end.
     1501           else do:
     1502             if frame Dialog-Frame :scrollable = true
     1503             then do:
     1504               assign
     1505                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1506               .
     1507             end.
     1508             assign
     1509               frame Dialog-Frame :height = v-frame-height
     1510             .
     1511             assign
     1512               v-diasize-browse-handle :height = v-browse-height
     1513             .
     1514             for each buf_temp-browse-handle
     1515               where buf_temp-browse-handle.browse-type = 'height':u
     1516             on error undo, next
     1517             :
     1518               assign
     1519                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1520               .
     1521             end.
     1522             for each buf_temp-diasize-handle
     1523             on error undo, next
     1524             :
     1525               assign
     1526                 v-object-handle = buf_temp-diasize-handle.handle-value
     1527               .
     1528               if v-object-handle <> v-diasize-resize-button
     1529               then do:
     1530                 assign
     1531                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1532                 .
     1533               end.
     1534             end.
     1535             run diasize_position-resize-button in this-procedure .
     1536           end.
     1537           assign
     1538             v-diasize-change-size = false
     1539           .
     1540           leave move_block .
     1541         end.
     1542       end.
     1543       assign
     1544         v-diasize-need-full-display = true
     1545       .
     1546       if v-diasize-change-size = false
     1547       then do:
     1548         assign
     1549           v-diasize-change-size = true
     1550         .
     1551       end.
     1552       else do:
     1553         return .
     1554       end.
     1555       assign
     1556         v-frame-height = frame Dialog-Frame :height
     1557         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1558         v-browse-height = v-diasize-browse-handle :height
     1559       .
     1560       for each buf_temp-browse-handle
     1561         where buf_temp-browse-handle.browse-type = 'height':u
     1562       :
     1563         assign
     1564           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1565         .
     1566       end.
     1567       for each buf_temp-diasize-handle
     1568       :
     1569         delete buf_temp-diasize-handle .
     1570       end.
     1571       assign
     1572         v-field-group-handle = frame Dialog-Frame :first-child
     1573       .
     1574       do while valid-handle(v-field-group-handle)
     1575       :
     1576         assign
     1577           v-object-handle = v-field-group-handle :first-child
     1578         .
     1579         do while valid-handle(v-object-handle)
     1580         :
     1581           if  v-object-handle <> v-diasize-browse-handle :handle
     1582           and can-query(v-object-handle, "row")
     1583           and can-query(v-object-handle, "height")
     1584           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1585           then do:
     1586             find first buf_temp-browse-handle
     1587               where buf_temp-browse-handle.browse-type   = 'height':u
     1588                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1589               no-error .
     1590             if available buf_temp-browse-handle
     1591             then do:
     1592             end.
     1593             else do:
     1594               create buf_temp-diasize-handle .
     1595               assign
     1596                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1597                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1598               .
     1599             end.
     1600           end.
     1601           assign
     1602             v-object-handle = v-object-handle :next-sibling
     1603           .
     1604         end.
     1605         assign
     1606           v-field-group-handle = v-field-group-handle :next-sibling
     1607         .
     1608       end.
     1609       do with frame Dialog-Frame
     1610       :
     1611         hide v-diasize-resize-button .
     1612         assign
     1613           v-diasize-resize-button :row    = 1
     1614           v-diasize-resize-button :column = 1
     1615         .
     1616       end.
     1617       if p-change-value > 0
     1618       then do:
     1619         if frame Dialog-Frame :scrollable = true
     1620         then do:
     1621           assign
     1622             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1623             no-error .
     1624           if error-status :error
     1625           or error-status :get-message(1) <> ""
     1626           then do:
     1627             undo move_block, retry move_block .
     1628           end.
     1629         end.
     1630         assign
     1631           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1632           no-error .
     1633         if error-status :error
     1634         or error-status :get-message(1) <> ""
     1635         then do:
     1636           undo move_block, retry move_block .
     1637         end.
     1638         assign
     1639           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1640           no-error .
     1641         if error-status :error
     1642         or error-status :get-message(1) <> ""
     1643         then do:
     1644           undo move_block, retry move_block .
     1645         end.
     1646         for each buf_temp-browse-handle
     1647           where buf_temp-browse-handle.browse-type = 'height':u
     1648         on error undo move_block, retry move_block
     1649         :
     1650           assign
     1651             buf_temp-browse-handle.browse-handle :height
     1652               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1653             no-error .
     1654           if error-status :error
     1655           or error-status :get-message(1) <> ""
     1656           then do:
     1657             undo move_block, retry move_block .
     1658           end.
     1659         end.
     1660         for each buf_temp-diasize-handle
     1661         on error undo move_block, retry move_block
     1662         :
     1663           assign
     1664             v-object-handle = buf_temp-diasize-handle.handle-value
     1665           .
     1666           if v-object-handle <> v-diasize-resize-button
     1667           then do:
     1668             assign
     1669               v-object-handle :row = v-object-handle :row + p-change-value
     1670               no-error .
     1671             if error-status :error
     1672             or error-status :get-message(1) <> ""
     1673             then do:
     1674               undo move_block, retry move_block .
     1675             end.
     1676           end.
     1677         end.
     1678       end.
     1679       else do:
     1680         for each buf_temp-diasize-handle
     1681         on error undo move_block, retry move_block
     1682         :
     1683           assign
     1684             v-object-handle = buf_temp-diasize-handle.handle-value
     1685           .
     1686           if v-object-handle <> v-diasize-resize-button
     1687           then do:
     1688             assign
     1689               v-object-handle :row = v-object-handle :row + p-change-value
     1690               no-error .
     1691             if error-status :error
     1692             or error-status :get-message(1) <> ""
     1693             then do:
     1694               undo move_block, retry move_block .
     1695             end.
     1696           end.
     1697         end.
     1698         assign
     1699           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1700           no-error .
     1701         if error-status :error
     1702         or error-status :get-message(1) <> ""
     1703         then do:
     1704           undo move_block, retry move_block .
     1705         end.
     1706         for each buf_temp-browse-handle
     1707           where buf_temp-browse-handle.browse-type = 'height':u
     1708         on error undo move_block, retry move_block
     1709         :
     1710           assign
     1711             buf_temp-browse-handle.browse-handle :height
     1712               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1713             no-error .
     1714           if error-status :error
     1715           or error-status :get-message(1) <> ""
     1716           then do:
     1717             undo move_block, retry move_block .
     1718           end.
     1719         end.
     1720         assign
     1721           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1722           no-error .
     1723         if error-status :error
     1724         or error-status :get-message(1) <> ""
     1725         then do:
     1726           undo move_block, retry move_block .
     1727         end.
     1728         if frame Dialog-Frame :scrollable = true
     1729         then do:
     1730           assign
     1731             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1732             no-error .
     1733           if error-status :error
     1734           or error-status :get-message(1) <> ""
     1735           then do:
     1736             undo move_block, retry move_block .
     1737           end.
     1738         end.
     1739       end.
     1740       if p-move-resize = true
     1741       then do:
     1742         run diasize_position-resize-button in this-procedure .
     1743       end.
     1744       if v-diasize-wndstore = true
     1745       then do:
     1746         if connected("ub") = true
     1747         then do:
     1748           define variable v-cntxt-db-num        as integer   no-undo .
     1749           define variable v-cntxt-userid        as character no-undo .
     1750           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1751                                             , OUTPUT v-cntxt-userid
     1752                                             ) .
     1753           run gbl/wndsizew.p
     1754             (input  v-cntxt-db-num
     1755             ,input  v-cntxt-userid
     1756             ,input  v-diasize-proc-name
     1757             ,input  'height':u
     1758             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1759             ) .
     1760         end.
     1761       end.
     1762     end.
     1763     assign
     1764       v-diasize-change-size = false
     1765     .
     1766   end procedure.
     1767   procedure diasize_set-height :
     1768     define input  parameter p-new-height  as decimal   no-undo .
     1769     define input  parameter p-move-resize as logical   no-undo .
     1770     do
     1771     on error undo, return error return-value
     1772     :
     1773       run diasize_change-height in this-procedure
     1774         (input  (p-new-height - frame Dialog-Frame :height)
     1775         ,input  p-move-resize
     1776         ) .
     1777     end.
     1778   end procedure.
     1779   procedure diasize_change-width :
     1780     define input  parameter p-change-value as decimal   no-undo .
     1781     define input  parameter p-move-resize  as logical   no-undo .
     1782     define variable v-field-group-handle   as handle    no-undo .
     1783     define variable v-object-handle        as handle    no-undo .
     1784     define variable v-frame-width          as decimal   no-undo .
     1785     define variable v-frame-virtual-width  as decimal   no-undo .
     1786     define variable v-browse-width         as decimal   no-undo .
     1787     define variable v-window-width         as decimal   no-undo .
     1788     define variable v-window-virtual-width as decimal   no-undo .
     1789     define variable v-change-sign          as integer   no-undo .
     1790     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1791     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1792     if p-change-value > 0
     1793     then do:
     1794       if frame Dialog-Frame :width + p-change-value >
     1795           session :width-chars
     1796       then do:
     1797         assign
     1798           p-change-value = session :width-chars - frame Dialog-Frame :width
     1799         .
     1800         if p-change-value <= 0
     1801         then do:
     1802           run diasize_position-resize-button in this-procedure .
     1803           return .
     1804         end.
     1805       end.
     1806     end.
     1807     if p-change-value < 0
     1808     then do:
     1809       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1810       then do:
     1811         assign
     1812           p-change-value = v-diasize-orig-frame-width
     1813                          - frame Dialog-Frame :width
     1814         .
     1815         if p-change-value >= 0
     1816         then do:
     1817           run diasize_position-resize-button in this-procedure .
     1818           return .
     1819         end.
     1820       end.
     1821     end.
     1822     if p-change-value >= 0
     1823     then do:
     1824       assign
     1825         v-change-sign = 1
     1826       .
     1827     end.
     1828     else do:
     1829       assign
     1830         v-change-sign = -1
     1831       .
     1832     end.
     1833     assign
     1834       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1835     .
     1836     if p-change-value = 0
     1837     then do:
     1838       run diasize_position-resize-button in this-procedure .
     1839       return .
     1840     end.
     1841     move_block:
     1842     do
     1843     on error undo move_block, leave move_block
     1844     :
     1845       if retry
     1846       then do:
     1847         do
     1848         on error undo move_block, leave move_block
     1849         :
     1850           if p-change-value > 0
     1851           then do:
     1852             for each buf_temp-diasize-handle
     1853             on error undo, next
     1854             :
     1855               assign
     1856                 v-object-handle = buf_temp-diasize-handle.handle-value
     1857               .
     1858               if v-object-handle <> v-diasize-resize-button
     1859               then do:
     1860                 assign
     1861                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1862                 .
     1863               end.
     1864             end.
     1865             assign
     1866               v-diasize-browse-handle :width = v-browse-width
     1867             .
     1868             for each buf_temp-browse-handle
     1869               where buf_temp-browse-handle.browse-type = 'width':u
     1870             on error undo, next
     1871             :
     1872               assign
     1873                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1874               .
     1875             end.
     1876             assign
     1877               frame Dialog-Frame :width = v-frame-width
     1878             .
     1879             if frame Dialog-Frame :scrollable = true
     1880             then do:
     1881               assign
     1882                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1883               .
     1884             end.
     1885             run diasize_position-resize-button in this-procedure .
     1886           end.
     1887           else do:
     1888             if frame Dialog-Frame :scrollable = true
     1889             then do:
     1890               assign
     1891                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1892               .
     1893             end.
     1894             assign
     1895               frame Dialog-Frame :width = v-frame-width
     1896             .
     1897             for each buf_temp-browse-handle
     1898               where buf_temp-browse-handle.browse-type = 'width':u
     1899             on error undo, next
     1900             :
     1901               assign
     1902                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1903               .
     1904             end.
     1905             assign
     1906               v-diasize-browse-handle :width = v-browse-width
     1907             .
     1908             for each buf_temp-diasize-handle
     1909             on error undo, next
     1910             :
     1911               assign
     1912                 v-object-handle = buf_temp-diasize-handle.handle-value
     1913               .
     1914               if v-object-handle <> v-diasize-resize-button
     1915               then do:
     1916                 assign
     1917                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1918                 .
     1919               end.
     1920             end.
     1921             run diasize_position-resize-button in this-procedure .
     1922           end.
     1923           assign
     1924             v-diasize-change-size = false
     1925           .
     1926           leave move_block .
     1927         end.
     1928       end.
     1929       assign
     1930         v-diasize-need-full-display = true
     1931       .
     1932       if v-diasize-change-size = false
     1933       then do:
     1934         assign
     1935           v-diasize-change-size = true
     1936         .
     1937       end.
     1938       else do:
     1939         return .
     1940       end.
     1941       assign
     1942         v-frame-width = frame Dialog-Frame :width
     1943         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1944         v-browse-width = v-diasize-browse-handle :width
     1945       .
     1946       for each buf_temp-browse-handle
     1947         where buf_temp-browse-handle.browse-type = 'width':u
     1948       :
     1949         assign
     1950           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1951         .
     1952       end.
     1953       for each buf_temp-diasize-handle
     1954       :
     1955         delete buf_temp-diasize-handle .
     1956       end.
     1957       assign
     1958         v-field-group-handle = frame Dialog-Frame :first-child
     1959       .
     1960       do while valid-handle(v-field-group-handle)
     1961       :
     1962         assign
     1963           v-object-handle = v-field-group-handle :first-child
     1964         .
     1965         do while valid-handle(v-object-handle)
     1966         :
     1967           if  v-object-handle <> v-diasize-browse-handle :handle
     1968           and v-object-handle <> v-diasize-resize-button
     1969           and can-query(v-object-handle, "row")
     1970           and can-query(v-object-handle, "height")
     1971           and ( v-object-handle :col + v-object-handle :width
     1972                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1973               )
     1974           then do:
     1975             find first buf_temp-browse-handle
     1976               where buf_temp-browse-handle.browse-type   = 'width':u
     1977                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1978               no-error .
     1979             if available buf_temp-browse-handle
     1980             then do:
     1981             end.
     1982             else do:
     1983               create buf_temp-diasize-handle .
     1984               assign
     1985                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1986                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1987               .
     1988             end.
     1989           end.
     1990           assign
     1991             v-object-handle = v-object-handle :next-sibling
     1992           .
     1993         end.
     1994         assign
     1995           v-field-group-handle = v-field-group-handle :next-sibling
     1996         .
     1997       end.
     1998       do with frame Dialog-Frame
     1999       :
     2000         hide v-diasize-resize-button .
     2001         v-diasize-resize-button :row = 1.
     2002         v-diasize-resize-button :column = 1.
     2003       end.
     2004       if p-change-value > 0
     2005       then do:
     2006         if frame Dialog-Frame :scrollable = true
     2007         then do:
     2008           assign
     2009             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2010             no-error .
     2011           if error-status :error
     2012           or error-status :get-message(1) <> ""
     2013           then do:
     2014             undo move_block, retry move_block.
     2015           end.
     2016         end.
     2017         assign
     2018           frame Dialog-Frame :width = v-frame-width + p-change-value
     2019           no-error .
     2020         if error-status :error
     2021         or error-status :get-message(1) <> ""
     2022         then do:
     2023           undo move_block, retry move_block.
     2024         end.
     2025         assign
     2026           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2027         no-error .
     2028         if error-status :error
     2029         or error-status :get-message(1) <> ""
     2030         then do:
     2031           undo move_block, retry move_block.
     2032         end.
     2033         for each buf_temp-browse-handle
     2034           where buf_temp-browse-handle.browse-type = 'width':u
     2035         on error undo move_block, retry move_block
     2036         :
     2037           assign
     2038             buf_temp-browse-handle.browse-handle :width
     2039               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2040             no-error .
     2041           if error-status :error
     2042           or error-status :get-message(1) <> ""
     2043           then do:
     2044             undo move_block, retry move_block .
     2045           end.
     2046         end.
     2047         for each buf_temp-diasize-handle
     2048         on error undo move_block, retry move_block
     2049         :
     2050           assign
     2051             v-object-handle = buf_temp-diasize-handle.handle-value
     2052           .
     2053           if v-object-handle <> v-diasize-resize-button
     2054           then do:
     2055             assign
     2056               v-object-handle :col = v-object-handle :col + p-change-value
     2057               no-error .
     2058             if error-status :error
     2059             or error-status :get-message(1) <> ""
     2060             then do:
     2061               undo move_block, retry move_block .
     2062             end.
     2063           end.
     2064         end.
     2065       end.
     2066       else do:
     2067         for each buf_temp-diasize-handle
     2068         on error undo move_block, retry move_block
     2069         :
     2070           assign
     2071             v-object-handle = buf_temp-diasize-handle.handle-value
     2072           .
     2073           if v-object-handle <> v-diasize-resize-button
     2074           then do:
     2075             assign
     2076               v-object-handle :col = v-object-handle :col + p-change-value
     2077               no-error .
     2078             if error-status :error
     2079             or error-status :get-message(1) <> ""
     2080             then do:
     2081               undo move_block, retry move_block .
     2082             end.
     2083           end.
     2084         end.
     2085         for each buf_temp-browse-handle
     2086           where buf_temp-browse-handle.browse-type = 'width':u
     2087         on error undo move_block, retry move_block
     2088         :
     2089           assign
     2090             buf_temp-browse-handle.browse-handle :width
     2091               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2092             no-error .
     2093           if error-status :error
     2094           or error-status :get-message(1) <> ""
     2095           then do:
     2096             undo move_block, retry move_block .
     2097           end.
     2098         end.
     2099         assign
     2100           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2101           no-error .
     2102         if error-status :error
     2103         or error-status :get-message(1) <> ""
     2104         then do:
     2105           undo move_block, retry move_block.
     2106         end.
     2107         assign
     2108           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2109         no-error .
     2110         if error-status :error
     2111         or error-status :get-message(1) <> ""
     2112         then do:
     2113           undo move_block, retry move_block.
     2114         end.
     2115         if frame Dialog-Frame :scrollable = true
     2116         then do:
     2117           assign
     2118             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2119           no-error .
     2120           if error-status :error
     2121           or error-status :get-message(1) <> ""
     2122           then do:
     2123             undo move_block, retry move_block.
     2124           end.
     2125         end.
     2126       end.
     2127       if p-move-resize
     2128       then do:
     2129         run diasize_position-resize-button in this-procedure .
     2130       end.
     2131       if v-diasize-wndstore = true
     2132       then do:
     2133         if connected("ub") = true
     2134         then do:
     2135           define variable v-cntxt-db-num        as integer   no-undo .
     2136           define variable v-cntxt-userid        as character no-undo .
     2137           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2138                                             , OUTPUT v-cntxt-userid
     2139                                             ) .
     2140           run gbl/wndsizew.p
     2141             (input  v-cntxt-db-num
     2142             ,input  v-cntxt-userid
     2143             ,input  v-diasize-proc-name
     2144             ,input  'width':u
     2145             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2146             ) .
     2147         end.
     2148       end.
     2149     end.
     2150     assign
     2151       v-diasize-change-size = false
     2152     .
     2153   end procedure.
     2154   procedure diasize_set-width :
     2155     define input  parameter p-new-width  as decimal   no-undo .
     2156     define input  parameter p-move-resize as logical   no-undo .
     2157     do
     2158     on error undo, return error return-value
     2159     :
     2160       run diasize_change-width in this-procedure
     2161         (input  (p-new-width - frame Dialog-Frame :width)
     2162         ,input  p-move-resize
     2163         ) .
     2164     end.
     2165   end procedure.
     2166   procedure diasize_position-resize-button :
     2167     do with frame Dialog-Frame
     2168     :
     2169       hide v-diasize-resize-button .
     2170       assign
     2171         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2172                     - 1
     2173                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2174         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2175                     - 1
     2176                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2177       .
     2178       view v-diasize-resize-button .
     2179     end.
     2180   end procedure.
     2181   on alt-right anywhere
     2182   do:
     2183     run diasize_change-width in this-procedure
     2184       (input 1
     2185       ,input true
     2186       ) .
     2187     return no-apply .
     2188   end.
     2189   on alt-left anywhere
     2190   do:
     2191     run diasize_change-width in this-procedure
     2192       (input -1
     2193       ,input true
     2194       ) .
     2195     return no-apply .
     2196   end.
     2197   on alt-down anywhere
     2198   do:
     2199     run diasize_change-height in this-procedure
     2200       (input 1
     2201       ,input true
     2202       ) .
     2203     return no-apply .
     2204   end.
     2205   on alt-up anywhere
     2206   do:
     2207     run diasize_change-height in this-procedure
     2208       (input -1
     2209       ,input true
     2210       ) .
     2211     return no-apply .
     2212   end.
     2213   on alt-enter of frame Dialog-Frame
     2214   do:
     2215     run diasize_maximize in this-procedure
     2216       (input  ?
     2217       ).
     2218     return no-apply .
     2219   end.
     2220   procedure diasize_end-move :
     2221     do
     2222     on error undo, return error return-value
     2223     :
     2224       define variable v-row-delta as decimal   no-undo .
     2225       define variable v-col-delta as decimal   no-undo .
     2226       define variable v-new-row as decimal   no-undo .
     2227       define variable v-new-col as decimal   no-undo .
     2228       assign
     2229         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2230         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2231       .
     2232       assign
     2233         v-row-delta = v-new-row - frame Dialog-Frame :height
     2234         v-col-delta = v-new-col - frame Dialog-Frame :width
     2235       .
     2236       run diasize_change-height in this-procedure
     2237         (input v-row-delta
     2238         ,input true
     2239         ) .
     2240       run diasize_change-width in this-procedure
     2241         (input v-col-delta
     2242         ,input true
     2243         ) .
     2244     end.
     2245   end procedure.
     2246   procedure diasize_maximize :
     2247     define input  parameter p-action as logical   no-undo .
     2248     do
     2249     on error undo, return error return-value
     2250     :
     2251       if p-action = ?
     2252       then do:
     2253         if v-diasize-need-maximize = true
     2254         then do:
     2255           assign
     2256             p-action = true
     2257           .
     2258         end.
     2259         else do:
     2260           assign
     2261             p-action = false
     2262           .
     2263         end.
     2264       end.
     2265       if p-action = true
     2266       then do:
     2267         run diasize_change-height in this-procedure
     2268           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2269               - frame Dialog-Frame :height-chars
     2270           ,input true
     2271           ) .
     2272         run diasize_change-width in this-procedure
     2273           (input session :width-chars
     2274               - frame Dialog-Frame :width-chars
     2275           ,input true
     2276           ) .
     2277         assign
     2278           v-diasize-need-maximize = false
     2279         .
     2280       end.
     2281       else do:
     2282         run diasize_change-width in this-procedure
     2283           (input v-diasize-orig-frame-width
     2284               - frame Dialog-Frame :width-chars
     2285           ,input true
     2286           ) .
     2287         run diasize_change-height in this-procedure
     2288           (input v-diasize-orig-frame-height
     2289               - frame Dialog-Frame :height-chars
     2290           ,input true
     2291           ) .
     2292         assign
     2293           v-diasize-need-maximize = true
     2294         .
     2295       end.
     2296     end.
     2297   end procedure.
     2298   procedure diasize_restore-orig-size :
     2299     do
     2300     on error undo, return error return-value
     2301     :
     2302       assign
     2303         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2304         v-diasize-current-frame-height = frame Dialog-Frame :height
     2305       .
     2306       run diasize_set-height in this-procedure
     2307         (input  v-diasize-orig-frame-height
     2308         ,input  true
     2309         ) .
     2310       run diasize_set-width in this-procedure
     2311         (input  v-diasize-orig-frame-width
     2312         ,input  true
     2313         ) .
     2314     end.
     2315   end procedure.
     2316   procedure diasize_restore-current-size :
     2317     do
     2318     on error undo, return error return-value
     2319     :
     2320       run diasize_set-height in this-procedure
     2321         (input  v-diasize-current-frame-height
     2322         ,input  true
     2323         ) .
     2324       run diasize_set-width in this-procedure
     2325         (input  v-diasize-current-frame-width
     2326         ,input  true
     2327         ) .
     2328     end.
     2329   end procedure.
     2330   procedure diasize_set-browse-handle :
     2331     define input  parameter p-browse-handle as handle   no-undo .
     2332     define buffer buf_temp-browse-handle for temp-browse-handle .
     2333     do
     2334     on error undo, return error return-value
     2335     :
     2336       assign
     2337         v-diasize-browse-handle = p-browse-handle
     2338       .
     2339       for each buf_temp-browse-handle
     2340       on error undo, return error return-value
     2341       :
     2342         delete buf_temp-browse-handle .
     2343       end.
     2344     end.
     2345   end procedure.
     2346   procedure diasize_add_browse :
     2347     define input  parameter p-browse-type   as character no-undo .
     2348     define input  parameter p-browse-handle as handle    no-undo .
     2349     define buffer buf_temp-browse-handle for temp-browse-handle .
     2350     do
     2351     on error undo, return error return-value
     2352     :
     2353       assign
     2354         v-diasize-browse-number = v-diasize-browse-number + 1
     2355       .
     2356       create buf_temp-browse-handle .
     2357       assign
     2358         buf_temp-browse-handle.browse-type   = p-browse-type
     2359         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2360         buf_temp-browse-handle.browse-handle = p-browse-handle
     2361       .
     2362     end.
     2363   end procedure.
     2364   procedure diasize_init :
     2365     define variable v-default-value    as logical   no-undo .
     2366     define variable v-restore-saved    as logical   no-undo .
     2367     define variable v-resize-value-str as character no-undo .
     2368     do
     2369     on error undo, return error return-value
     2370     :
     2371       do with frame Dialog-Frame
     2372       :
     2373         assign
     2374           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2375           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2376           v-diasize-browse-handle     = browse br-attrs :handle
     2377         .
     2378         create button v-diasize-resize-button
     2379         assign
     2380           parent        = frame Dialog-Frame :first-child
     2381           label         = "s"
     2382           height-pixels = 16
     2383           width-pixels  = 16
     2384           visible       = true
     2385           sensitive     = true
     2386           movable       = true
     2387           triggers:
     2388             on end-move persistent run diasize_end-move in this-procedure .
     2389           end triggers.
     2390         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2391         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2392         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2393         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2394         assign
     2395           v-diasize-wndmax = false
     2396         .
     2397         if connected("ub") = true
     2398         then do:
     2399           define variable v-cntxt-db-num        as integer   no-undo .
     2400           define variable v-cntxt-userid        as character no-undo .
     2401           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2402                                             , OUTPUT v-cntxt-userid
     2403                                             ) .
     2404           run gbl/wndpar_r.p
     2405             (input  v-cntxt-db-num
     2406             ,input  v-cntxt-userid
     2407             ,input  'wndmax':U
     2408             ,output v-diasize-wndmax
     2409             ,output v-default-value
     2410             ) .
     2411         end.
     2412         assign
     2413           v-diasize-wndstore = false
     2414         .
     2415         if connected("ub") = true
     2416         then do:
     2417           run gbl/wndpar_r.p
     2418             (input  v-cntxt-db-num
     2419             ,input  v-cntxt-userid
     2420             ,input  'wndstore':U
     2421             ,output v-diasize-wndstore
     2422             ,output v-default-value
     2423             ) .
     2424         end.
     2425         assign
     2426           v-diasize-proc-name = entry(1, program-name(2), '.')
     2427         .
     2428         if v-diasize-wndstore = true
     2429         then do:
     2430           assign
     2431             v-restore-saved = false
     2432           .
     2433           if connected("ub") = true
     2434           then do:
     2435             run gbl/wndsizer.p
     2436               (input  v-cntxt-db-num
     2437               ,input  v-cntxt-userid
     2438               ,input  v-diasize-proc-name
     2439               ,input  'height':u
     2440               ,output v-resize-value-str
     2441               ) .
     2442             if v-resize-value-str <> '':U
     2443             then do:
     2444               run diasize_change-height in this-procedure
     2445                 (input  integer(v-resize-value-str)
     2446                 ,input  true
     2447                 ) .
     2448               assign
     2449                 v-restore-saved = true
     2450               .
     2451             end.
     2452           end.
     2453           if connected("ub") = true
     2454           then do:
     2455             run gbl/wndsizer.p
     2456               (input  v-cntxt-db-num
     2457               ,input  v-cntxt-userid
     2458               ,input  v-diasize-proc-name
     2459               ,input  'width':u
     2460               ,output v-resize-value-str
     2461               ) .
     2462             if v-resize-value-str <> '':U
     2463             then do:
     2464               run diasize_change-width in this-procedure
     2465                 (input  integer(v-resize-value-str)
     2466                 ,input  true
     2467                 ) .
     2468               assign
     2469                 v-restore-saved = true
     2470               .
     2471             end.
     2472           end.
     2473           if v-restore-saved <> true
     2474           then do:
     2475             if v-diasize-wndmax = true
     2476             then do:
     2477               run diasize_maximize in this-procedure
     2478                 (input  true
     2479                 ) .
     2480             end.
     2481           end.
     2482         end.
     2483         else do:
     2484           if v-diasize-wndmax = true
     2485           then do:
     2486             run diasize_maximize in this-procedure
     2487               (input  true
     2488               ) .
     2489           end.
     2490         end.
     2491       end.
     2492     end.
     2493   end procedure.
     2494   procedure diasize_need-full-display :
     2495     define output parameter p-need-full-display as logical   no-undo .
     2496     do
     2497     on error undo, return error return-value
     2498     :
     2499       assign
     2500         p-need-full-display = v-diasize-need-full-display
     2501       .
     2502       assign
     2503         v-diasize-need-full-display = false
     2504       .
     2505     end.
     2506   end procedure.
     2507   procedure get-context :
     2508      define output parameter p-db-num as integer          no-undo.
     2509      define output parameter p-user-id as character        no-undo.
     2510      define variable v-login               as character    no-undo.
     2511      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2512      define buffer buf_user-login  for ub.user-login .
     2513      do
     2514      on error undo, return error
     2515      :
     2516            FIND FIRST buf_sys-ctrl no-lock.
     2517            ASSIGN
     2518               v-login = USERID("ub")
     2519               p-db-num = buf_sys-ctrl.db-num
     2520            .
     2521            FIND FIRST buf_user-login
     2522                 WHERE buf_user-login.db-num = p-db-num
     2523                   AND buf_user-login.user-login = v-login
     2524                 no-lock
     2525                 no-error
     2526                 .
     2527            IF AVAILABLE buf_user-login
     2528            THEN DO:
     2529               assign
     2530                  p-user-id = buf_user-login.user-id
     2531               .
     2532            END.
     2533      end.
     2534   end procedure.
     2535       run diasize_init in this-procedure .
     2536    frame Dialog-Frame:TITLE = frame Dialog-Frame:TITLE.
     2537   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2538   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2539   ON ROW-DISPLAY OF br-attrs IN frame Dialog-Frame
     2540   DO:
     2541     IF AVAIL temp-hattr THEN DO:
     2542       RUN set-row-color IN THIS-PROCEDURE ( INPUT temp-hattr.attr-value-type).
     2543     END.
     2544   END.
     2545   MAIN-BLOCK:
     2546   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2547      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2548   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2549     run mainmenu_getcntxt in parparentproc
     2550       (output v-cntxt-db-num
     2551       ,output v-cntxt-userid
     2552       ,output v-cntxt-level
     2553       ,output v-cntxt-host-code-obj
     2554       ,output v-cntxt-obj-type
     2555       ,output v-cntxt-obj-code
     2556       ,output v-cntxt-db-num-obj
     2557       ,output v-cntxt-is-admin
     2558       ) .
     2559     find first buf_Cash-desk where
     2560               buf_cash-desk.obj-code =  p-obj-code
     2561           and buf_cash-desk.db-num =  p-db-num
     2562           AND buf_cash-desk.pos-type = p-pos-type
     2563           AND buf_cash-desk.cash-num = p-cash-num
     2564               no-lock no-error .
     2565   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2566     run MyEnable in this-procedure no-error.
     2567     if error-status:error then do:
     2568       message p-mode skip error-status:error error-status:get-message(1)
     2569       view-as alert-box .
     2570       return error.
     2571     end.
     2572     if return-value = "return" then do:
     2573       run attr-pop-clean-up in this-procedure ( input 'cash-desk-attr':U ).
     2574       run disable_UI in this-procedure .
     2575       return.
     2576     end.
     2577     run init-proc in this-procedure .
     2578     view frame Dialog-Frame .
     2579     WAIT-FOR GO OF FRAME Dialog-Frame.
     2580   END.
     2581   run disable_UI in this-procedure .
     2582   run attr-pop-clean-up in this-procedure ( input 'cash-desk-attr':U ).
     2583   if updated then return 'ИЗМЕНЕНИЕ':U.
     2584   PROCEDURE choose-to-edit :
     2585   define input parameter p-upper-attr-code as character no-undo .
     2586   define input parameter p-attr-code as character no-undo .
     2587   assign
     2588   add-option = p-attr-code
     2589   add-option-section = p-upper-attr-code
     2590   .
     2591   APPLY "CHOOSE" to b-ins in frame Dialog-Frame .
     2592   END PROCEDURE.
     2593   PROCEDURE control_load :
     2594   DEFINE VARIABLE UIB_S    AS LOGICAL    NO-UNDO.
     2595   DEFINE VARIABLE OCXFile  AS CHARACTER  NO-UNDO.
     2596   OCXFile = SEARCH( "exe\wrx\ref\cd-atti.wrx":U ).
     2597   IF OCXFile = ? THEN
     2598     OCXFile = SEARCH(SUBSTRING(THIS-PROCEDURE:FILE-NAME, 1,
     2599                        R-INDEX(THIS-PROCEDURE:FILE-NAME, ".":U), "CHARACTER":U) + "wrx":U).
     2600   IF OCXFile <> ? THEN
     2601   DO:
     2602     ASSIGN
     2603       chCtrlFrame = CtrlFrame:COM-HANDLE
     2604       UIB_S = chCtrlFrame:LoadControls( OCXFile, "CtrlFrame":U)
     2605       CtrlFrame:NAME = "CtrlFrame":U
     2606     .
     2607   END.
     2608   ELSE MESSAGE "exe\wrx\ref\cd-atti.wrx":U SKIP(1)
     2609                "The binary control file could not be found. The controls cannot be loaded."
     2610                VIEW-AS ALERT-BOX TITLE "Controls Not Loaded".
     2611   END PROCEDURE.
     2612   PROCEDURE disable_UI :
     2613     HIDE FRAME Dialog-Frame.
     2614   END PROCEDURE.
     2615   PROCEDURE enable_UI :
     2616     RUN control_load.
     2617     DISPLAY cd-db-num cd-obj-code cd-pos-type cd-cash-num
     2618         WITH FRAME Dialog-Frame.
     2619     ENABLE b-quit b-ins b-chg b-lkp b-del B-send b-help cd-db-num cd-obj-code
     2620            cd-pos-type cd-cash-num
     2621         WITH FRAME Dialog-Frame.
     2622     VIEW FRAME Dialog-Frame.
     2623     OPEN QUERY br-attrs FOR EACH Temp-hattr NO-LOCK.
     2624   END PROCEDURE.
     2625   PROCEDURE init-proc :
     2626   define variable  attr-type as character no-undo .
     2627   define variable  attr-format as character no-undo .
     2628   define variable  attr-label as character no-undo .
     2629   define variable  attr-character as character no-undo .
     2630   define variable  attr-date as date no-undo .
     2631   define variable  attr-decimal as decimal no-undo .
     2632   define variable  attr-integer as integer no-undo .
     2633   define variable  attr-logical as logical no-undo .
     2634   define variable  attr-user-can-edit as logical no-undo .
     2635   define variable  attr-output-display as logical no-undo .
     2636   define variable  attr-other as char no-undo .
     2637   define variable v-prop-list as character no-undo .
     2638   define variable attr-from-gbd as logical no-undo .
     2639   define variable attr-from-ubd as logical no-undo .
     2640   define variable attr-news as logical no-undo .
     2641   define variable v-one-send-param as logical no-undo .
     2642   define variable v-all-send-param as logical no-undo .
     2643   define variable v-compl-root as logical no-undo .
     2644   define variable jj as integer no-undo .
     2645   define buffer buf_cash-desk-attr for ub.cash-desk-attr.
     2646   for each  Temp-hattr share-lock:
     2647     delete Temp-hattr.
     2648   end.
     2649   add-option = "".
     2650   add-option-section = "".
     2651   Assign
     2652   cd-db-num = buf_cash-desk.db-num
     2653   cd-obj-code = buf_cash-desk.obj-code
     2654   cd-pos-type = buf_cash-desk.pos-type
     2655   cd-cash-num = buf_cash-desk.cash-num
     2656   v-view-col[1] = no
     2657   v-view-col[2] = no
     2658   v-view-col[3] = no
     2659   v-view-col[4] = no
     2660   v-view-col[5] = no
     2661   v-view-col[6] = no
     2662   .
     2663   display
     2664   cd-db-num
     2665   cd-obj-code
     2666   cd-pos-type
     2667   cd-cash-num
     2668   with frame Dialog-Frame  .
     2669   _cash-desk-attr:
     2670   For each buf_cash-desk-attr where
     2671           buf_cash-desk-attr.obj-code = p-obj-code
     2672     and  buf_cash-desk-attr.db-num  = p-db-num
     2673     and  buf_cash-desk-attr.pos-type  = p-pos-type
     2674     and  buf_cash-desk-attr.cash-num  = p-cash-num
     2675           no-lock :
     2676     if buf_cash-desk-attr.upper-attr-code = '' then do:
     2677       if p-ref-mode = "oper" then do:
     2678         if not (buf_Cash-desk-attr.attr-code begins buf_Cash-desk-attr.pos-type + "_operative") then next.
     2679       end.
     2680       else do:
     2681         if (buf_Cash-desk-attr.attr-code begins buf_Cash-desk-attr.pos-type + "_operative") then next.
     2682       end.
     2683     end.
     2684     else do:
     2685       if p-ref-mode = "oper" then do:
     2686         if not (buf_Cash-desk-attr.upper-attr-code begins buf_Cash-desk-attr.pos-type + "_operative") then next.
     2687       end.
     2688       else do:
     2689         if (buf_Cash-desk-attr.upper-attr-code begins buf_Cash-desk-attr.pos-type + "_operative") then next.
     2690       end.
     2691     end.
     2692     v-compl-root = no.
     2693     run cd-attr-code in this-procedure (
     2694                                             input buf_cash-desk-attr.upper-attr-code
     2695                                           , input buf_cash-desk-attr.attr-code
     2696                                           , output attr-type
     2697                                           , output attr-format
     2698                                           , output attr-label
     2699                                           , output attr-user-can-edit
     2700                                           , output attr-output-display
     2701                                           , output attr-other
     2702                                           , output v-prop-list
     2703                                           ).
     2704     if index( attr-other,  "compl-root=") > 0
     2705     and num-entries(buf_cash-desk-attr.attr-code , chr(4)) > 1 then do:
     2706       do jj = 1 to num-entries(attr-other, chr(47)):
     2707         if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "compl-root":U then do:
     2708           assign
     2709           v-compl-root = logical(entry(lookup(entry(1, buf_cash-desk-attr.attr-code, chr(4)),v-prop-list), entry(2, entry(jj, attr-other, chr(47)), "=":U)))
     2710           .
     2711         end.
     2712         if v-compl-root  then next _cash-desk-attr.
     2713       end.
     2714     end.
     2715     if p-mode <> 'ПРОСМОТР':U
     2716     then do:
     2717       run cd-attr-news in this-procedure (
     2718                                           input buf_cash-desk-attr.upper-attr-code
     2719                                         , input buf_cash-desk-attr.attr-code
     2720                                         , output attr-news
     2721                                         , output attr-from-gbd
     2722                                         , output attr-from-ubd).
     2723       if v-cntxt-db-num = 0
     2724       and buf_cash-desk.db-num <> v-cntxt-db-num
     2725       and attr-from-gbd <> yes
     2726       then  attr-user-can-edit = no.
     2727       if buf_cash-desk.db-num = v-cntxt-db-num
     2728       and attr-from-ubd <> yes and v-cntxt-db-num <> 0
     2729       then
     2730       assign
     2731       attr-user-can-edit = no.
     2732     end.
     2733     if attr-output-display = true then DO:
     2734       run cd-attr-value in this-procedure (
     2735                                               input buf_cash-desk-attr.db-num
     2736                                             ,input buf_cash-desk-attr.obj-code
     2737                                             ,input buf_cash-desk-attr.pos-type
     2738                                             ,input buf_cash-desk-attr.cash-num
     2739                                             ,input buf_cash-desk-attr.upper-attr-code
     2740                                             ,input buf_cash-desk-attr.attr-code
     2741                                             ,output attr-character
     2742                                             ,output attr-date
     2743                                             ,output attr-decimal
     2744                                             ,output attr-integer
     2745                                             ,output attr-logical
     2746                                             ,output attr-type ) .
     2747       create Temp-hattr.
     2748       assign
     2749       temp-hattr.obj-code = buf_cash-desk-attr.obj-code
     2750       temp-hattr.pos-type = buf_cash-desk-attr.pos-type
     2751       temp-hattr.cash-num = buf_cash-desk-attr.cash-num
     2752       temp-hattr.db-num = buf_cash-desk-attr.db-num
     2753       Temp-hattr.upper-attr-code = buf_cash-desk-attr.upper-attr-code
     2754       Temp-hattr.attr-code = attr-label
     2755       Temp-hattr.attr-value-character = attr-character
     2756       Temp-hattr.attr-value-date = attr-date
     2757       Temp-hattr.attr-value-decimal = attr-decimal
     2758       Temp-hattr.attr-value-integer = attr-integer
     2759       Temp-hattr.attr-value-logical = attr-logical
     2760       Temp-hattr.attr-value-type = attr-type
     2761       Temp-hattr.user-can-edit = attr-user-can-edit
     2762       Temp-hattr.code = buf_cash-desk-attr.attr-code
     2763       .
     2764       case attr-type:
     2765         when 'character':U then do:
     2766           assign
     2767           v-view-col[1] = yes.
     2768         end.
     2769         when 'date':U then do:
     2770           assign
     2771           v-view-col[2] = yes.
     2772         end.
     2773         when 'decimal':U then do:
     2774           assign
     2775           v-view-col[3] = yes.
     2776         end.
     2777         when 'integer':U then do:
     2778           assign
     2779           v-view-col[4] = yes.
     2780         end.
     2781         when 'logical':U then do:
     2782           assign
     2783           v-view-col[5] = yes.
     2784         end.
     2785       end case.
     2786       case Temp-hattr.code:
     2787          when 'USE_FFD_VERSION':U then do:
     2788             case Temp-hattr.attr-value-character :
     2789                when "0" then Temp-hattr.attr-value-character = "авт" .
     2790                when "2" then Temp-hattr.attr-value-character = "1.05" .
     2791                when "3" then Temp-hattr.attr-value-character = "1.1" .
     2792                when "4" then Temp-hattr.attr-value-character = "1.2" .
     2793                otherwise Temp-hattr.attr-value-character = " " .
     2794             end case .
     2795          end.
     2796          when 'KKT_FFD_VERSION':U then do:
     2797             case Temp-hattr.attr-value-character :
     2798                when "0" then Temp-hattr.attr-value-character = "авт" .
     2799                when "2" then Temp-hattr.attr-value-character = "1.05" .
     2800                when "3" then Temp-hattr.attr-value-character = "1.1" .
     2801                when "4" then Temp-hattr.attr-value-character = "1.2" .
     2802                otherwise Temp-hattr.attr-value-character = " " .
     2803             end case .
     2804          end.
     2805          when 'KKT_SCHEMA':U then do:
     2806             case Temp-hattr.attr-value-character :
     2807                when "0" then Temp-hattr.attr-value-character = "с ожиданием ответа" .
     2808                when "1" then Temp-hattr.attr-value-character = "без ожидания ответа" .
     2809                otherwise Temp-hattr.attr-value-character = " " .
     2810             end case .
     2811          end.
     2812       end case .
     2813       run cd-attr-send-param in this-procedure ( input Temp-hattr.upper-attr-code
     2814                                                 ,input Temp-hattr.code
     2815                                                 ,output Temp-hattr.to-send).
     2816       v-all-send-param = Temp-hattr.to-send or v-all-send-param.
     2817       assign
     2818       v-view-col[6] = v-all-send-param.
     2819     End.
     2820   End.
     2821   RUN view-hide-columns IN THIS-PROCEDURE (INPUT NO).
     2822   b-send:sensitive in frame Dialog-Frame = v-all-send-param.
     2823   OPEN QUERY br-attrs FOR EACH Temp-hattr NO-LOCK.
     2824   END PROCEDURE.
     2825   PROCEDURE MyEnable :
     2826   define variable attr-type as character no-undo .
     2827   define variable attr-format as character no-undo .
     2828   define variable attr-label as character no-undo .
     2829   define variable attr-value as character no-undo .
     2830   define variable attr-user-can-edit as logical no-undo .
     2831   define variable attr-output-display as logical no-undo .
     2832   define variable attr-other as char no-undo .
     2833   define variable v-prop-list as character no-undo .
     2834   define variable attr-from-gbd as logical no-undo .
     2835   define variable attr-from-ubd as logical no-undo .
     2836   define variable attr-news as logical no-undo .
     2837   define variable ii as integer no-undo .
     2838   define variable jj as integer no-undo .
     2839   define variable v-jj as integer no-undo .
     2840   define variable v-auto as character no-undo .
     2841   DEFINE variable v-ch0 AS HANDLE NO-UNDO.
     2842   define variable v-found as logical no-undo .
     2843   RUN control_load IN THIS-PROCEDURE .
     2844   ASSIGN
     2845   B-send:POPUP-MENU IN FRAME Dialog-Frame = MENU POPUP-MENU-B-send:HANDLE
     2846   temp-hattr.attr-value-character:resizable IN BROWSE br-attrs = YES
     2847   b-ins:POPUP-MENU IN FRAME Dialog-Frame = MENU MENU-b-ins:HANDLE
     2848   temp-hattr.attr-code:resizable in browse br-attrs = yes
     2849   b-ins:MENU-MOUSE = 1
     2850   chCtrlFrame:PSTimer:ENABLED  = (p-pos-type = 'IBS-TH':U
     2851                                  OR
     2852                                  p-pos-type = 'IBS-TH-MOB':U
     2853                                  )
     2854                                  AND
     2855                                  p-mode = 'ПРОСМОТР':U
     2856   chCtrlFrame:PSTimer:INTERVAL = IF NOT (p-pos-type = 'IBS-TH':U
     2857                                  OR
     2858                                  p-pos-type = 'IBS-TH-MOB':U
     2859                                  )
     2860                                  AND
     2861                                  p-mode = 'ПРОСМОТР':U THEN 0
     2862                                   ELSE 3000
     2863   .
     2864   ASSIGN
     2865   v-ch0 = br-attrs:FIRST-COLUMN IN FRAME Dialog-Frame.
     2866   REPEAT WHILE valid-handle(v-ch0):
     2867      IF v-ch0:LABEL = "Значение!(строковое)" THEN
     2868      v-ch_[1] = v-ch0.
     2869      IF v-ch0:LABEL = "Значение!(Дата)" THEN
     2870      v-ch_[2] = v-ch0.
     2871      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN
     2872      v-ch_[3] = v-ch0.
     2873      IF v-ch0:LABEL = "Значение!(Целое)" THEN
     2874      v-ch_[4] = v-ch0.
     2875      IF v-ch0:LABEL = "Значение!(Логическое)" THEN
     2876      v-ch_[5] = v-ch0.
     2877      v-ch0 = v-ch0:NEXT-COLUMN.
     2878   END.
     2879   do v-jj = 1 to num-entries ('MAGIA-XML_operative,IBM-XML_operative,IBM-XML_general,MARIA_operative,MARIA_general,INFOKIOSK_operative,NCR-GM_general,NCR-AS-R_general,IBS-TH_devices,IBS-TH_fisreg,IBS-TH_rec-print,IBS-TH_main,IBS-TH_interface,IBS-TH-MOB_main,IBS-TH-MOB_rec-print,AUTOTANK_operative':u):
     2880     if not entry(v-jj, 'MAGIA-XML_operative,IBM-XML_operative,IBM-XML_general,MARIA_operative,MARIA_general,INFOKIOSK_operative,NCR-GM_general,NCR-AS-R_general,IBS-TH_devices,IBS-TH_fisreg,IBS-TH_rec-print,IBS-TH_main,IBS-TH_interface,IBS-TH-MOB_main,IBS-TH-MOB_rec-print,AUTOTANK_operative':u) begins p-pos-type then next.
     2881     if p-ref-mode = "oper" then do:
     2882       if not entry(v-jj, 'MAGIA-XML_operative,IBM-XML_operative,IBM-XML_general,MARIA_operative,MARIA_general,INFOKIOSK_operative,NCR-GM_general,NCR-AS-R_general,IBS-TH_devices,IBS-TH_fisreg,IBS-TH_rec-print,IBS-TH_main,IBS-TH_interface,IBS-TH-MOB_main,IBS-TH-MOB_rec-print,AUTOTANK_operative':u) begins (p-pos-type + "_operative") then next.
     2883     end.
     2884     else do:
     2885       if entry(v-jj, 'MAGIA-XML_operative,IBM-XML_operative,IBM-XML_general,MARIA_operative,MARIA_general,INFOKIOSK_operative,NCR-GM_general,NCR-AS-R_general,IBS-TH_devices,IBS-TH_fisreg,IBS-TH_rec-print,IBS-TH_main,IBS-TH_interface,IBS-TH-MOB_main,IBS-TH-MOB_rec-print,AUTOTANK_operative':u) begins (p-pos-type + "_operative") then next.
     2886     end.
     2887     v-found = yes.
     2888     if p-mode <> 'ПРОСМОТР':U then do:
     2889       v-prop-list = ''.
     2890       run cd-attr-code in this-procedure (
     2891                                           input  entry(v-jj, 'MAGIA-XML_operative,IBM-XML_operative,IBM-XML_general,MARIA_operative,MARIA_general,INFOKIOSK_operative,NCR-GM_general,NCR-AS-R_general,IBS-TH_devices,IBS-TH_fisreg,IBS-TH_rec-print,IBS-TH_main,IBS-TH_interface,IBS-TH-MOB_main,IBS-TH-MOB_rec-print,AUTOTANK_operative':u)
     2892                                           ,input  ''
     2893                                           ,output attr-type
     2894                                           ,output attr-format
     2895                                           ,output attr-label
     2896                                           ,output attr-user-can-edit
     2897                                           ,output attr-output-display
     2898                                           ,output attr-other
     2899                                           ,output v-prop-list
     2900                                           )  .
     2901       run attr-pop-create-items in this-procedure  (
     2902                                                     input 'cash-desk-attr':U
     2903                                                     ,input 'cd-attr-manual-edit'
     2904                                                     ,input 'cd-attr-tooltip'
     2905                                                     ,input 'choose-to-edit'
     2906                                                     ,input menu menu-b-ins:handle
     2907                                                     ,input entry(v-jj, 'MAGIA-XML_operative,IBM-XML_operative,IBM-XML_general,MARIA_operative,MARIA_general,INFOKIOSK_operative,NCR-GM_general,NCR-AS-R_general,IBS-TH_devices,IBS-TH_fisreg,IBS-TH_rec-print,IBS-TH_main,IBS-TH_interface,IBS-TH-MOB_main,IBS-TH-MOB_rec-print,AUTOTANK_operative':u)
     2908                                                     ,input v-prop-list
     2909                                                   ).
     2910     end.
     2911   end.
     2912   if not v-found then do:
     2913     if p-ref-mode = "oper" then do:
     2914       message
     2915       "Для данного типа кассы не найдено оперативных данных для изменения/просмотра"
     2916         view-as alert-box warning.
     2917     end.
     2918     else do:
     2919       message
     2920       "Для данного типа кассы не найдено настроек для изменения/просмотра"
     2921         view-as alert-box warning.
     2922     end.
     2923       return "return".
     2924   end.
     2925   if p-mode <> 'ПРОСМОТР':U then do:
     2926     for each tt-attr-property where
     2927               tt-attr-property.table-name = 'cash-desk-attr':U:
     2928       v-prop-list = ''.
     2929       run cd-attr-code in this-procedure (
     2930                                            input  tt-attr-property.upper-attr-code
     2931                                           ,input  tt-attr-property.attr-code
     2932                                           ,output attr-type
     2933                                           ,output attr-format
     2934                                           ,output attr-label
     2935                                           ,output attr-user-can-edit
     2936                                           ,output attr-output-display
     2937                                           ,output attr-other
     2938                                           ,output v-prop-list
     2939                                           ) .
     2940       v-auto = '':U.
     2941       do jj = 1 to num-entries(attr-other, chr(47)):
     2942         if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "auto":U then do:
     2943           assign
     2944           v-auto = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     2945           .
     2946         end.
     2947       end.
     2948       if valid-handle (tt-attr-property.menu-item-handle) then do:
     2949         assign
     2950         tt-attr-property.menu-item-handle:sensitive = (v-auto = '':U
     2951                                                           or
     2952                                                           lookup(string(buf_cash-desk.auto),  v-auto) > 0)
     2953         .
     2954         run cd-attr-news in this-procedure (
     2955                                              input  tt-attr-property.upper-attr-code
     2956                                             ,input  tt-attr-property.attr-code
     2957                                             ,output attr-news
     2958                                             ,output attr-from-gbd
     2959                                             ,output attr-from-ubd).
     2960         if v-cntxt-db-num = 0
     2961         and buf_cash-desk.db-num <> v-cntxt-db-num
     2962         and attr-from-gbd <> yes  then do:
     2963           tt-attr-property.menu-item-handle:sensitive = no.
     2964         end.
     2965         if buf_cash-desk.db-num = v-cntxt-db-num
     2966         and attr-from-ubd <> yes and v-cntxt-db-num <> 0 then do:
     2967           tt-attr-property.menu-item-handle:sensitive = no.
     2968         end.
     2969         release tt-attr-property.
     2970       end.
     2971    end.
     2972   end.
     2973   if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     2974     v-found = no.
     2975     for each  tt-attr-property where
     2976              tt-attr-property.table-name = 'cash-desk-attr':U:
     2977       if tt-attr-property.menu-item-handle:sensitive = yes then do:
     2978         v-found = yes.
     2979         leave.
     2980       end.
     2981     end.
     2982     if not v-found then do:
     2983       if p-ref-mode = "oper" then do:
     2984         message
     2985         "Для данного типа кассы не найдено оперативных данных, которые разрешено менять из данной БД"
     2986         view-as alert-box warning.
     2987       end.
     2988       else do:
     2989         message
     2990         "Для данного типа кассы не найдено настроек, которые разрешено менять из данной БД"
     2991         view-as alert-box warning.
     2992       end.
     2993       return "return".
     2994     end.
     2995   end.
     2996   ENABLE
     2997   b-quit
     2998   b-lkp
     2999   b-del when p-mode = 'ИЗМЕНЕНИЕ':U
     3000   b-ins when p-mode = 'ИЗМЕНЕНИЕ':U
     3001   b-chg when p-mode = 'ИЗМЕНЕНИЕ':U
     3002   b-help br-attrs
     3003   WITH FRAME Dialog-Frame .
     3004   VIEW FRAME Dialog-Frame .
     3005   OPEN QUERY br-attrs FOR EACH Temp-hattr NO-LOCK.
     3006   ASSIGN
     3007   b-ins:MENU-MOUSE = 1
     3008   b-send:MENU-MOUSE = 1
     3009   .
     3010   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3011   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3012     (input  'маг':U
     3013     ,input  p-obj-code
     3014     ,output v-cash-desk-host-code
     3015     )  .
     3016   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3017   do:
     3018     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3019       (input  v-cntxt-db-num
     3020       ,input  v-cntxt-userid
     3021       ,input  0
     3022       ,input  'actn_cashdesk-reference_input-deletion-updating':U
     3023       ,input  'object':U
     3024       ,input  v-cash-desk-host-code
     3025       ,input  'маг':U
     3026       ,input  p-obj-code
     3027       ,input  0
     3028       ,input  0
     3029       ,input  0
     3030       ,input  false
     3031       ,output v-glog
     3032       )  .
     3033   end.
     3034   END PROCEDURE.
     3035   PROCEDURE proc-add-chg :
     3036   define input parameter p-add as logical no-undo .
     3037   define variable attr-type as character no-undo .
     3038   define variable attr-format as character no-undo .
     3039   define variable attr-label as character no-undo .
     3040   define variable attr-user-can-edit as logical no-undo .
     3041   define variable attr-output-display as logical no-undo .
     3042   define variable attr-other as char no-undo .
     3043   define variable attr-character as character no-undo .
     3044   define variable attr-date as date no-undo .
     3045   define variable attr-decimal as decimal no-undo .
     3046   define variable attr-integer as integer no-undo .
     3047   define variable attr-logical as logical no-undo .
     3048   define variable v-prop-list as character no-undo .
     3049   define variable v-attr-value as character no-undo .
     3050   define variable v-init as character no-undo .
     3051   define variable jj as integer no-undo.
     3052   DEFINE VARIABLE v-spr as character no-undo .
     3053   DEFINE VARIABLE v-sprlevel as character no-undo .
     3054   DEFINE VARIABLE v-setted as logical no-undo .
     3055   DEFINE VARIABLE v-deleted as logical no-undo .
     3056   define variable v-check as character no-undo .
     3057   define variable v-error-code as character no-undo .
     3058   define variable v-correct as logical no-undo .
     3059   define variable glog  as logical no-undo .
     3060   define variable loc#log as logical no-undo.
     3061   case p-add:
     3062     when yes then do:
     3063       if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     3064       if not p-glog and add-option = "last-check-params" then
     3065       return no-apply .
     3066       if not v-glog and add-option <> "last-check-params" then return no-apply .
     3067         run temp-cd-attr-exist in this-procedure (
     3068                                                      input p-db-num
     3069                                                     ,input p-obj-code
     3070                                                     ,input p-pos-type
     3071                                                     ,input p-cash-num
     3072                                                     ,input add-option-section
     3073                                                     ,input add-option
     3074                                                     ,output loc#log)  no-error.
     3075         if error-status:error then return error.
     3076         if loc#log then do:
     3077           message
     3078           "Данный атрибут/параметр уже существует"
     3079           view-as alert-box error .
     3080           return error.
     3081         end.
     3082       end.
     3083       run cd-attr-code in this-procedure (
     3084                                              input  add-option-section
     3085                                             ,input  add-option
     3086                                             ,output attr-type
     3087                                             ,output attr-format
     3088                                             ,output attr-label
     3089                                             ,output attr-user-can-edit
     3090                                             ,output attr-output-display
     3091                                             ,output attr-other
     3092                                             ,output v-prop-list
     3093                                             ) no-error .
     3094       if error-status :error then do:
     3095         return error .
     3096       end.
     3097       assign
     3098       added = yes.
     3099       do jj = 1 to num-entries(attr-other, chr(47)):
     3100         if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "init":U then do:
     3101           assign
     3102           v-init = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     3103           .
     3104         end.
     3105       end.
     3106       if  v-init <> "":U then do:
     3107           run  value(v-init)
     3108                       in this-procedure (
     3109                                            input p-db-num
     3110                                           ,input p-obj-code
     3111                                           ,input p-pos-type
     3112                                           ,input p-cash-num
     3113                                           ,output attr-character
     3114                                           ,output attr-date
     3115                                           ,output attr-decimal
     3116                                           ,output attr-integer
     3117                                           ,output attr-logical
     3118                                           ) no-error .
     3119             if error-status:error then do:
     3120                 assign
     3121                 attr-character = "":U
     3122                 .
     3123             end.
     3124       end.
     3125       CASE attr-type:
     3126         when 'L':U then do:
     3127           assign
     3128           v-attr-value = "yes":U
     3129           .
     3130         end.
     3131         when 'I':U or when 'D':U then do:
     3132           assign
     3133           v-attr-value = if v-init <> "":U
     3134                         then attr-character
     3135                         else string(0)
     3136           .
     3137         end.
     3138         when 'T':U then do:
     3139           assign
     3140           v-attr-value = ?
     3141           .
     3142         end.
     3143         when 'C':U then do:
     3144           assign
     3145           v-attr-value = if v-init <> "":U
     3146                         then attr-character
     3147                         else "":U
     3148           .
     3149         end.
     3150       END CASE.
     3151       assign
     3152       attr-character = v-attr-value
     3153       .
     3154     end.
     3155     when no then do:
     3156       if not p-glog and TEMP-hattr.code = "last-check-params" then
     3157       return no-apply .
     3158       if not v-glog and TEMP-hattr.code <> "last-check-params" then return no-apply .
     3159       run cd-attr-code in this-procedure (
     3160                                              input TEMP-hattr.upper-attr-code
     3161                                             ,input TEMP-hattr.code
     3162                                             ,output attr-type
     3163                                             ,output attr-format
     3164                                             ,output attr-label
     3165                                             ,output attr-user-can-edit
     3166                                             ,output attr-output-display
     3167                                             ,output attr-other
     3168                                             ,output v-prop-list
     3169                                             ) no-error.
     3170       IF ERROR-STATUS:ERROR
     3171       THEN DO:
     3172           message "Ошибка при определении названия и типа атрибута/параметра кассы!"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     3173           return error.
     3174       END.
     3175       if temp-hattr.user-can-edit = no then do:
     3176         message
     3177         "Нельзя менять атрибут/параметр!"
     3178         view-as alert-box error .
     3179         undo, return error .
     3180       end.
     3181       RUN cd-ATTR-VALUE IN THIS-PROCEDURE (
     3182                                             INPUT p-db-num
     3183                                            ,INPUT p-obj-code
     3184                                            ,INPUT p-pos-type
     3185                                            ,input p-cash-num
     3186                                            ,input TEMP-hattr.upper-attr-code
     3187                                            ,input TEMP-hattr.code
     3188                                            ,OUTPUT ATTR-character
     3189                                            ,output attr-date
     3190                                            ,output attr-decimal
     3191                                            ,output attr-integer
     3192                                            ,output attr-logical
     3193                                            ,OUTPUT attr-type) NO-ERROR.
     3194       IF ERROR-STATUS:ERROR THEN DO:
     3195           message "Ошибка при определении значения атрибута/параметра кассы!"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     3196           return error.
     3197       END.
     3198     end.
     3199   END CASE.
     3200   IF attr-user-can-edit Then DO:
     3201     do jj = 1 to num-entries(attr-other, chr(47)):
     3202       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "sprlevel":U then do:
     3203         assign
     3204         v-sprlevel = entry(2, entry(jj, attr-other, chr(47)), "=":U)
     3205         .
     3206       end.
     3207       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "spr":U then do:
     3208         if v-sprlevel = "cd" then do:
     3209           assign
     3210           v-spr = entry(2, entry(jj, attr-other, chr(47)), "=":U)
     3211           .
     3212         end.
     3213         else do:
     3214           assign
     3215           v-spr = string(entry(lookup(if p-add then add-option else temp-hattr.code, v-prop-list ),  entry(2, entry(jj, attr-other, chr(47)), "=":U)))
     3216           .
     3217         end.
     3218       end.
     3219       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "check":U then do:
     3220         assign
     3221         v-check = string(entry(lookup(if p-add then add-option else temp-hattr.code, v-prop-list ),  entry(2, entry(jj, attr-other, chr(47)), "=":U)))
     3222         .
     3223       end.
     3224     end.
     3225     if v-spr = "":U then do:
     3226       define variable v-ok as logical no-undo .
     3227        case attr-type:
     3228         when 'character':U then do:
     3229           run gbl/d-character.w (
     3230                input ?
     3231               ,input (
     3232               'title=':u + "Изменение атрибута/параметра кассы" + '\':u
     3233             + 'text1=':u + attr-label + '\':u
     3234             + 'format=' + (if attr-type = 'L':U then "yes/no" else attr-format) + '\':u
     3235             + 'fillin_row=4\':u
     3236             + 'fillin_col=4\':u
     3237             + 'fillin_width=20\':u
     3238             + 'fillin_height=1\':u
     3239             + 'max-chars=70\':u
     3240             + 'readonly=' + (if p-mode <> 'ИЗМЕНЕНИЕ':U then 'yes':u else 'no':u) + '\':u  )
     3241             , input-output attr-character
     3242             , output v-ok
     3243                   ).
     3244         end.
     3245         when 'date':U then do:
     3246           run gbl/d-inpday.w
     3247             (input ?
     3248             ,input substitute("Изменение атрибута/параметра кассы &1", attr-label)
     3249             ,input ""
     3250             ,input-output attr-date
     3251             ,output v-ok
     3252             ) NO-ERROR.
     3253         end.
     3254         when 'decimal':U then do:
     3255           run gbl/d-decimal.w (
     3256                 input ?
     3257                 ,input (
     3258                 'title=':u + "Изменение атрибута/параметра кассы" + '\':u
     3259               + 'text1=':u + attr-label + '\':u
     3260               + 'format=' + attr-format + '\':u
     3261               + 'fillin_row=3\':u
     3262               + 'fillin_col=4\':u
     3263               + 'fillin_width=20\':u
     3264               + 'fillin_height=1\':u
     3265               + 'max-chars=70\':u
     3266               + 'readonly=' + (if p-mode <> 'ИЗМЕНЕНИЕ':U then 'yes':u else 'no':u) + '\':u  )
     3267               , input-output attr-decimal
     3268               , output v-ok
     3269                   ).
     3270         end.
     3271         when 'integer':U then do:
     3272           run gbl/d-integer.w (
     3273                 input ?
     3274                 ,input (
     3275                 'title=':u + "Изменение атрибута/параметра кассы" + '\':u
     3276               + 'text1=':u + attr-label + '\':u
     3277               + 'format=' + attr-format + '\':u
     3278               + 'fillin_row=3\':u
     3279               + 'fillin_col=4\':u
     3280               + 'fillin_width=20\':u
     3281               + 'fillin_height=1\':u
     3282               + 'max-chars=70\':u
     3283               + 'readonly=' + (if p-mode <> 'ИЗМЕНЕНИЕ':U then 'yes':u else 'no':u) + '\':u  )
     3284               , input-output attr-integer
     3285               , output v-ok
     3286                   ).
     3287         end.
     3288         when 'logical':U then do:
     3289           run gbl/d-logical.w (
     3290              input ?
     3291             ,input  (
     3292             'title=':u + "Изменение атрибута/параметра кассы" + '\':u
     3293             + 'text1=':u + attr-label + '\':u
     3294             + 'format=' + "yes/no"  + '\':u
     3295             + 'fillin_row=2\':u
     3296             + 'fillin_col=4\':u
     3297             + 'fillin_width=20\':u
     3298             + 'fillin_height=1\':u
     3299             + 'max-chars=70\':u
     3300             + 'readonly=' + (if p-mode <> 'ИЗМЕНЕНИЕ':U then 'yes':u else 'no':u) + '\':u)
     3301             , input-output attr-logical
     3302             , output v-ok
     3303                   ).
     3304         end.
     3305       end case.
     3306       if not v-ok then return error.
     3307       run cd-attr-write in this-procedure (
     3308                                             input p-db-num
     3309                                             ,input p-obj-code
     3310                                             ,input p-pos-type
     3311                                             ,input p-cash-num
     3312                                             ,input (if p-add then add-option-section else temp-hattr.upper-attr-code)
     3313                                             ,input (if p-add then add-option else temp-hattr.code)
     3314                                             ,input attr-character
     3315                                             ,input attr-date
     3316                                             ,input attr-decimal
     3317                                             ,input attr-integer
     3318                                             ,input attr-logical
     3319                                           ) no-error .
     3320       IF NOT error-status:error then do:
     3321           assign
     3322           updated = yes
     3323           .
     3324       END.
     3325       else do:
     3326           message "Ошибка при изменении значения атрибута/параметра кассы!"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     3327       end.
     3328     END.
     3329     ELSE DO:
     3330       if v-sprlevel = '' then do:
     3331         run  value(v-spr) in this-procedure (
     3332                                          input parparentproc
     3333                                         ,input p-db-num
     3334                                         ,input p-obj-code
     3335                                         ,input p-pos-type
     3336                                         ,INPUT p-cash-num
     3337                                         ,input-output attr-character
     3338                                         ,input-output attr-date
     3339                                         ,input-output attr-decimal
     3340                                         ,input-output attr-integer
     3341                                         ,input-output attr-logical
     3342                                         ,output v-setted) no-error .
     3343       end.
     3344       if v-sprlevel = 'cd' then do:
     3345         run  value(v-spr) (
     3346                                          input parparentproc
     3347                                         ,input 'ИЗМЕНЕНИЕ':U
     3348                                         ,input p-db-num
     3349                                         ,input p-obj-code
     3350                                         ,input p-pos-type
     3351                                         ,INPUT p-cash-num
     3352                                         ,input (if p-add then add-option-section else temp-hattr.upper-attr-code)
     3353                                         ,input (if p-add then add-option else temp-hattr.code)
     3354                                         ,output v-setted) no-error .
     3355       end.
     3356       if not v-setted then return error.
     3357     end.
     3358     if v-check <> "":U then do:
     3359       run value(v-check) (
     3360                          input p-db-num
     3361                         ,input p-obj-code
     3362                         ,input p-pos-type
     3363                         ,input p-cash-num
     3364                         ,input (if p-add = yes then add-option-section else temp-hattr.upper-attr-code)
     3365                         ,input (if p-add = yes then add-option else temp-hattr.code)
     3366                         ,input attr-character
     3367                         ,input attr-date
     3368                         ,input attr-decimal
     3369                         ,input attr-integer
     3370                         ,input attr-logical
     3371                         ,input (if p-add then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U)
     3372                         ,output v-correct
     3373                         ,output v-error-code) no-error.
     3374       if error-status:error then do:
     3375         message
     3376         "Ошибка при проверке корректности задаваемого значения атрибута/параметра" skip
     3377         error-status:get-message(1) skip
     3378         view-as alert-box error .
     3379         undo, return error .
     3380       end.
     3381       if not v-correct then do:
     3382         message
     3383         "Задаваемое значение атрибута/параметра некорректно" skip
     3384         return-value
     3385         view-as alert-box error .
     3386         undo, return error .
     3387       end.
     3388     end.
     3389     run cd-attr-write in this-procedure (
     3390                                           input p-db-num
     3391                                           ,input p-obj-code
     3392                                           ,input p-pos-type
     3393                                           ,input p-cash-num
     3394                                           ,input (if p-add then add-option-section else temp-hattr.upper-attr-code)
     3395                                           ,input (if p-add then add-option else temp-hattr.code)
     3396                                           ,input attr-character
     3397                                           ,input attr-date
     3398                                           ,input attr-decimal
     3399                                           ,input attr-integer
     3400                                           ,input attr-logical
     3401                                         ) no-error .
     3402     IF NOT error-status:error then do:
     3403       assign
     3404       updated = yes
     3405       .
     3406     END.
     3407     else do:
     3408       message "Ошибка при изменении значения атрибута/параметра кассы!"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     3409     end.
     3410   End.
     3411   Else message "Изменение атрибута/параметра невозможно !" view-as alert-box error.
     3412   END PROCEDURE.
     3413   PROCEDURE proc-b-lkp :
     3414   define variable attr-type as character no-undo .
     3415   define variable attr-format as character no-undo .
     3416   define variable attr-label as character no-undo .
     3417   define variable attr-user-can-edit as logical no-undo .
     3418   define variable attr-output-display as logical no-undo .
     3419   define variable attr-other as char no-undo .
     3420   define variable attr-value as char no-undo .
     3421   define variable v-prop-list as character no-undo .
     3422   define variable v-run-name as character no-undo .
     3423   define variable v-sprlevel as character no-undo .
     3424   define variable v-setted as logical no-undo .
     3425   define variable jj as integer no-undo .
     3426     run cd-attr-code in this-procedure (
     3427                          input temp-hattr.upper-attr-code
     3428                         ,input temp-hattr.code
     3429                         ,output attr-type
     3430                         ,output attr-format
     3431                         ,output attr-label
     3432                         ,output attr-user-can-edit
     3433                         ,output attr-output-display
     3434                         ,output attr-other
     3435                         ,output v-prop-list
     3436                         ) NO-ERROR.
     3437   IF ERROR-STATUS:ERROR THEN DO:
     3438       return error.
     3439   END.
     3440   do jj = 1 to num-entries(attr-other, chr(47)):
     3441     if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "sprlevel":U then do:
     3442       assign
     3443       v-sprlevel = entry(2, entry(jj, attr-other, chr(47)), "=":U)
     3444       .
     3445     end.
     3446     if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "display":U then do:
     3447       if v-sprlevel = "cd" then do:
     3448         assign
     3449         v-run-name = entry(2, entry(jj, attr-other, chr(47)), "=":U)
     3450         .
     3451       end.
     3452       else do:
     3453         assign
     3454         v-run-name = string(entry(lookup(entry(1, temp-hattr.code, chr(4)), v-prop-list ),  entry(2, entry(jj, attr-other, chr(47)), "=":U)))
     3455         .
     3456       end.
     3457     end.
     3458   end.
     3459   if v-sprlevel = 'cd' then do:
     3460     run  value(v-run-name) (
     3461                                       input parparentproc
     3462                                     ,input 'ПРОСМОТР':U
     3463                                     ,input p-db-num
     3464                                     ,input p-obj-code
     3465                                     ,input p-pos-type
     3466                                     ,INPUT p-cash-num
     3467                                     ,input temp-hattr.upper-attr-code
     3468                                     ,input temp-hattr.code
     3469                                     ,output v-setted) no-error .
     3470   end.
     3471   else do:
     3472     run value(v-run-name) in this-procedure(
     3473                                            input parparentproc
     3474                                           ,input temp-hattr.db-num
     3475                                           ,input temp-hattr.obj-code
     3476                                           ,input temp-hattr.pos-type
     3477                                           ,input temp-hattr.cash-num
     3478                                           ,input temp-hattr.upper-attr-code
     3479                                           ,input temp-hattr.code
     3480                                           ,input temp-hattr.attr-value-character
     3481                                           ,input temp-hattr.attr-value-date
     3482                                           ,input temp-hattr.attr-value-decimal
     3483                                           ,input temp-hattr.attr-value-integer
     3484                                           ,input temp-hattr.attr-value-logical
     3485                                             )
     3486                                             no-error .
     3487   end.
     3488   if error-status:error then undo, return error .
     3489   return .
     3490   END PROCEDURE.
     3491   PROCEDURE proc-b-send :
     3492   define input parameter p-section as character no-undo .
     3493   DEFINE INPUT PARAMETER p-what-send AS CHARACTER NO-UNDO.
     3494   define variable v-parameter as character no-undo .
     3495   define variable v-one-send-param as logical no-undo .
     3496   if v-parameter <> '':U then do:
     3497     run cd-attr-send-param in this-procedure ( input Temp-hattr.upper-attr-code
     3498                                               ,input Temp-hattr.code
     3499                                               ,output v-one-send-param) no-error .
     3500     if not v-one-send-param then do:
     3501       message
     3502       "Данный атрибут/параметр пересылке не подлежит"
     3503       view-as alert-box WARNING.
     3504       return error.
     3505     end.
     3506   end.
     3507   assign
     3508   v-parameter =  string(buf_cash-desk.db-num) + chr(4) +
     3509               string(buf_cash-desk.obj-code) + chr(4) +
     3510               buf_cash-desk.pos-type + chr(4) +
     3511               string(buf_cash-desk.cash-num) + chr(4) +
     3512               'U' + chr(4) + p-what-send + chr(4) + p-section.
     3513   if buf_cash-desk.db-num = v-cntxt-db-num then do:
     3514     run str/diallog.w ( INPUT parparentproc
     3515                   , INPUT this-procedure
     3516                   , INPUT 'str/send-par.p':U
     3517                   , input v-parameter
     3518                   , no
     3519                   , ''
     3520                   , 'Отправка параметров касс').
     3521   end.
     3522   else do:
     3523       run nws/cr-route.p (
     3524                      input 'send-cmd':U
     3525                     ,input "command" + chr(1) + "run-file" + chr(1) + "str/send-par.p" + chr(1) + v-parameter
     3526                     ,input ?
     3527                     ,input string(buf_cash-desk.db-num)
     3528                     ) no-error .
     3529       if error-status:error then do:
     3530         message
     3531         substitute("Ошибка при отсылке параметра на кассу через СПН&1"  +
     3532                    "&2&1&3&1"
     3533                    , error-status:get-message(1)
     3534                    , return-value )
     3535         view-as alert-box error .
     3536       end.
     3537       else do:
     3538          message
     3539          "Команда на отсылку параметра на кассу успешно отправлена через СПН"
     3540          view-as alert-box.
     3541       end.
     3542   end.
     3543   END PROCEDURE.
     3544   PROCEDURE set-row-color :
     3545   DEFINE INPUT PARAMETER p-data-type AS CHARACTER NO-UNDO.
     3546   ASSIGN
     3547   v-ch_[1]:FGCOLOR = GREY_COLOR
     3548   v-ch_[1]:BGCOLOR = GREY_Color
     3549   v-ch_[1]:PFCOLOR = GREY_Color
     3550   v-ch_[2]:FGCOLOR = GREY_COLOR
     3551   v-ch_[2]:BGCOLOR = GREY_Color
     3552   v-ch_[2]:PFCOLOR = GREY_Color
     3553   v-ch_[3]:FGCOLOR = GREY_COLOR
     3554   v-ch_[3]:BGCOLOR = GREY_Color
     3555   v-ch_[3]:PFCOLOR = GREY_Color
     3556   v-ch_[4]:FGCOLOR = GREY_COLOR
     3557   v-ch_[4]:BGCOLOR = GREY_Color
     3558   v-ch_[4]:PFCOLOR = GREY_Color
     3559   v-ch_[5]:FGCOLOR = GREY_COLOR
     3560   v-ch_[5]:BGCOLOR = GREY_Color
     3561   v-ch_[5]:PFCOLOR = GREY_Color
     3562   .
     3563   CASE entry(1, p-data-type):
     3564        WHEN 'character':U THEN DO:
     3565         ASSIGN
     3566         v-ch_[1]:FGCOLOR = BLACK_COLOR
     3567         v-ch_[1]:BGCOLOR = WHITE_Color.
     3568       END.
     3569       WHEN 'decimal':U THEN DO:
     3570         ASSIGN
     3571         v-ch_[3]:FGCOLOR = BLACK_COLOR
     3572         v-ch_[3]:BGCOLOR = WHITE_Color.
     3573       END.
     3574       WHEN 'integer':U THEN DO:
     3575         ASSIGN
     3576         v-ch_[4]:FGCOLOR = BLACK_COLOR
     3577         v-ch_[4]:BGCOLOR = WHITE_Color.
     3578       END.
     3579       WHEN 'date':U THEN DO:
     3580         ASSIGN
     3581         v-ch_[2]:FGCOLOR = BLACK_COLOR
     3582         v-ch_[2]:BGCOLOR = WHITE_Color.
     3583        END.
     3584        WHEN 'logical':U THEN DO:
     3585          ASSIGN
     3586          v-ch_[5]:FGCOLOR = BLACK_COLOR
     3587          v-ch_[5]:BGCOLOR = WHITE_Color.
     3588        END.
     3589   END CASE.
     3590   END PROCEDURE.
     3591   PROCEDURE temp-cd-attr-exist :
     3592   do
     3593     on error undo, return error
     3594     :
     3595       define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     3596       define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     3597       define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     3598       define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     3599       define input parameter p-ucode    like ub.cash-desk-attr.upper-attr-code  no-undo .
     3600       define input parameter p-code     like ub.cash-desk-attr.attr-code  no-undo .
     3601       define output parameter p-exist   as logical  no-undo .
     3602       define buffer buf_temp-hattr for temp-hattr .
     3603       define variable v-type           as character no-undo .
     3604       define variable v-format         as character no-undo .
     3605       define variable v-label          as character no-undo .
     3606       define variable v-user-can-edit  as logical   no-undo .
     3607       define variable v-output-display as logical   no-undo .
     3608       define variable v-other          as character no-undo .
     3609       define variable v-prop-list      as character no-undo .
     3610       run cd-attr-code in this-procedure (
     3611                                            input  p-ucode
     3612                                           ,input  p-code
     3613                                           ,output v-type
     3614                                           ,output v-format
     3615                                           ,output v-label
     3616                                           ,output v-user-can-edit
     3617                                           ,output v-output-display
     3618                                           ,output v-other
     3619                                           ,output v-prop-list
     3620                                           ) no-error .
     3621       if error-status :error then do:
     3622         undo, return error return-value .
     3623       end.
     3624       find first buf_temp-hattr exclusive-lock
     3625         where buf_temp-hattr.db-num  = p-db-num
     3626           and buf_temp-hattr.obj-code  = p-obj-code
     3627           and buf_temp-hattr.pos-type  = p-pos-type
     3628           and buf_temp-hattr.cash-num  = p-cash-num
     3629           and buf_temp-hattr.code = p-code
     3630           and buf_temp-hattr.upper-attr-code = p-ucode
     3631         no-error .
     3632       if  available buf_temp-hattr then do:
     3633         p-exist = yes.
     3634       end.
     3635     end.
     3636   END PROCEDURE.
     3637   PROCEDURE view-hide-columns :
     3638   DEFINE INPUT PARAMETER p-find AS LOGICAL NO-UNDO.
     3639   IF p-find THEN DO:
     3640      v-view-col[1] = CAN-FIND(temp-hattr WHERE temp-hattr.attr-value-type = 'character':U).
     3641      v-view-col[2] = CAN-FIND(temp-hattr WHERE temp-hattr.attr-value-type = 'date':U).
     3642      v-view-col[3] = CAN-FIND(temp-hattr WHERE temp-hattr.attr-value-type = 'decimal':U).
     3643      v-view-col[4] = CAN-FIND(temp-hattr WHERE temp-hattr.attr-value-type = 'integer':U).
     3644      v-view-col[5] = CAN-FIND(temp-hattr WHERE temp-hattr.attr-value-type = 'logical':U).
     3645   END.
     3646   assign
     3647   temp-hattr.attr-value-character:visible in browse br-attrs = v-view-col[1]
     3648   temp-hattr.attr-value-date:visible in browse br-attrs = v-view-col[2]
     3649   temp-hattr.attr-value-decimal:visible in browse br-attrs = v-view-col[3]
     3650   temp-hattr.attr-value-integer:visible in browse br-attrs = v-view-col[4]
     3651   temp-hattr.attr-value-logical:visible in browse br-attrs = v-view-col[5]
     3652   temp-hattr.to-send:visible in browse br-attrs = v-view-col[6]
     3653   .
     3654   END PROCEDURE.
