       41   define input parameter parparentproc as widget-handle no-undo.
       42   define input parameter p-mode as char no-undo.
       43   define input parameter p-ref-mode as character no-undo .
       44   define input parameter p-db-num like ub.cash-desk-attr.db-num no-undo.
       45   define input parameter p-obj-code like ub.cash-desk-attr.obj-code no-undo.
       46   define input parameter p-pos-type like ub.cash-desk-attr.pos-type no-undo .
       47   define input parameter p-cash-num like ub.cash-desk-attr.cash-num no-undo .
       48   define input parameter p-glog   as LOGICAL no-undo .
       49   define variable vss-revision    as character no-undo init "$Revision$":U .
       50   define variable vss-author      as character no-undo init "$Author$":U .
       51   define variable vss-date        as character no-undo init "$Date$":U .
       52   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       53   define variable vss-archive     as character no-undo init "$Archive$":U .
       54   define variable vss-description as character no-undo init "Атрибуты и/или параметры кассы".
       55   procedure vss-get-info :
       56     define output parameter p-vss-revision    like vss-revision    no-undo .
       57     define output parameter p-vss-author      like vss-author      no-undo .
       58     define output parameter p-vss-date        like vss-date        no-undo .
       59     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       60     define output parameter p-vss-archive     like vss-archive     no-undo .
       61     define output parameter p-vss-description like vss-description no-undo .
       62     assign
       63       p-vss-revision    = vss-revision
       64       p-vss-author      = vss-author
       65       p-vss-date        = vss-date
       66       p-vss-workfile    = vss-workfile
       67       p-vss-archive     = vss-archive
       68       p-vss-description = vss-description
       69     .
       70   end procedure.
       71   procedure vss-get-parameters :
       72     define output parameter p-vss-parameters as character no-undo .
       73   end procedure.
       74   define new global shared variable g#vssrevis-logger as handle    no-undo .
       75   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       76   define variable v-vssrevis-logger                   as handle    no-undo .
       77   procedure vss-logevent :
       78     define input  parameter p-extra-paramters as character no-undo .
       79     define variable v-vssrevis-parameters as character no-undo .
       80     do
       81     on error undo, return error return-value
       82     :
       83       if  valid-handle(v-vssrevis-logger)
       84       and v-vssrevis-logger :get-signature("logevent") <> ""
       85       then do:
       86         run vss-get-parameters in this-procedure
       87           (output v-vssrevis-parameters
       88           ).
       89         run logevent in v-vssrevis-logger
       90           (input vss-workfile
       91           ,input vss-revision
       92           ,input v-vssrevis-parameters
       93           ,input p-extra-paramters
       94           ).
       95       end.
       96     end.
       97   end procedure.
       98   assign
       99     v-vssrevis-logger = g#vssrevis-logger
      100   .
      101   if  valid-handle(v-vssrevis-logger)
      102   and v-vssrevis-logger :get-signature("logevent") <> ""
      103   then do:
      104     assign
      105       v-vssrevis-logevent = true
      106     .
      107     run vss-logevent in this-procedure (input vss-description) .
      108   end.
