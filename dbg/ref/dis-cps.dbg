      408   procedure fltfield-clear :
      409     define output parameter loc-fld as character no-undo.
      410     define output parameter loc-lab as character no-undo .
      411     define output parameter loc-spr as character no-undo .
      412     define output parameter loc-dim as character no-undo .
      413     assign
      414       loc-fld = ""
      415       loc-lab = ""
      416       loc-spr = ""
      417       loc-dim = "0"
      418     .
      419   end procedure .
      420   procedure fltfield-add :
      421     define input        parameter par-fld as character no-undo.
      422     define input        parameter par-lab as character no-undo .
      423     define input        parameter par-spr as character no-undo .
      424     define input-output parameter loc-fld as character no-undo.
      425     define input-output parameter loc-lab as character no-undo .
      426     define input-output parameter loc-spr as character no-undo .
      427     define input-output parameter loc-dim as character no-undo .
      428     do
      429     on error undo, return error
      430     :
      431       assign
      432       loc-fld = if loc-dim = '0'
      433                 then par-fld
      434                 else (loc-fld + chr(44) + par-fld)
      435       loc-lab = if loc-dim = '0'
      436                 then par-lab
      437                 else (loc-lab + chr(44) + par-lab)
      438       loc-spr = if loc-dim = '0'
      439                 then par-spr
      440                 else (loc-spr + chr(44) + par-spr)
      441       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      442                 string(integer(if num-entries(loc-dim) > 1
      443                               then entry(2, loc-dim)
      444                               else entry(1, loc-dim)
      445                               ) + 1)
      446       no-error
      447       .
      448     end.
      449   end procedure.
      450   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      451   define  stream PrnLibStream.
      452   procedure prn-lib-prn-file :
      453     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      454     define input parameter p-DIsabledoptions as integer no-undo .
      455     define variable v-report-name as character no-undo .
      456     define variable v-user-action as character no-undo .
      457     define variable v-printed     as logical   no-undo .
      458     define variable v-exist       as logical   no-undo .
      459     do
      460       on error undo, return error
      461       :
      462       run prn-lib-get-report-name  in this-procedure (
      463         input parParentProc
      464         ,output v-report-name
      465         ).
      466   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      467   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      468     (input  v-report-name
      469     ,input  2
      470     ,output v-exist
      471     )  .
      472       if NOT v-exist then
      473       DO:
      474         Message
      475           "Нет заданий на печать ! "
      476           view-as alert-box .
      477         Return  .
      478       End.
      479       run gbl/prnfilen.w
      480         (input  ""
      481         ,input  p-DisabledOptions
      482         ,input  string(v-report-name )
      483         ,input  7
      484         ,output v-user-action
      485         ,output v-printed
      486         ) .
      487       if v-printed then
      488       do:
      489         return "YES" .
      490       end.
      491       else
      492       do:
      493         return "NO" .
      494       end.
      495     end.
      496   end procedure.
      497   procedure prn-lib-open-stream :
      498     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      499     define input parameter p-page-size    as integer no-undo .
      500     define input parameter p-is-stream    as logical no-undo .
      501     define input parameter p-append       as logical no-undo .
      502     define variable v-report-name as character no-undo .
      503     do
      504       on error undo, return error
      505       :
      506       run prn-lib-get-report-name  in this-procedure (
      507         input parParentProc
      508         ,output v-report-name
      509         ).
      510       if p-is-stream then
      511       do:
      512         if p-append then
      513         do:
      514           output stream PrnLibStream to value( v-report-name )
      515             page-size value(p-page-size) append .
      516         end.
      517         if not p-append then
      518         do:
      519           output stream PrnLibStream to value( v-report-name )
      520             page-size value(p-page-size) .
      521         end.
      522       end.
      523       if not p-is-stream then
      524       do:
      525         if p-append then
      526         do:
      527           output to value( v-report-name )
      528             page-size value(p-page-size) append .
      529         end.
      530         if not p-append then
      531         do:
      532           output to value( v-report-name )
      533             page-size value(p-page-size) .
      534         end.
      535       end.
      536     end.
      537   end procedure.
      538   procedure prn-lib-open-exp :
      539     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      540     define input parameter p-is-stream    as logical no-undo .
      541     define input parameter p-is-append    as logical no-undo .
      542     define output parameter p-ReportFileName as char init "report" no-undo.
      543     define output parameter p-process as logical no-undo .
      544     define variable glog as logical no-undo .
      545     do
      546       on error undo, return error
      547       :
      548       SYSTEM-DIALOG GET-FILE p-ReportFileName
      549         TITLE      "Укажите путь"
      550         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      551         ASK-OVERWRITE
      552         CREATE-TEST-FILE
      553         SAVE-AS
      554         USE-FILENAME
      555         DEFAULT-EXTENSION "txt"
      556         UPDATE glog
      557         .
      558       if not glog then  return.
      559       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      560       if p-is-stream then
      561       do:
      562         if p-is-append then
      563         do:
      564           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      565         end.
      566         else
      567         do:
      568           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      569         end.
      570       end.
      571       else
      572       do:
      573         if p-is-append then
      574         do:
      575           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      576         end.
      577         else
      578         do:
      579           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      580         end.
      581       end.
      582       p-process = yes.
      583     end.
      584   end procedure.
      585   procedure prn-lib-get-report-name :
      586     define input parameter parParentProc  as widget-handle no-undo.
      587     define output parameter p-report-name as character no-undo .
      588     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      589   end procedure.
      590   procedure prn-lib-reportviewer-report-name :
      591     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      592     define input parameter p-report-name-html as character no-undo .
      593     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      594   end procedure.
      595   procedure prn-lib-reportviewer :
      596     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      597     define input parameter p-report-name-html as character no-undo .
      598     define input parameter p-param        as character no-undo .
      599     define variable v-excel           as character no-undo init 'TRUE' .
      600     define variable v-value-character as character no-undo .
      601     define variable v-value-integer   as character no-undo .
      602     define variable v-value-date      as date      no-undo .
      603     define variable v-value-decimal   as decimal   no-undo .
      604     define variable rep-excel         as logical   no-undo .
      605     define variable excel-string      as character no-undo .
      606     define variable v-param-type      as character no-undo .
      607     define variable v-tth             as handle    no-undo .
      608     run adm/shattri.p (
      609       input "get":U
      610       ,input  ""
      611       ,input  0
      612       ,input  'report-glob':U
      613       ,input  'rep-excel':U
      614       ,output v-value-character
      615       ,output v-value-date
      616       ,output v-value-decimal
      617       ,output v-value-integer
      618       ,output rep-excel
      619       ,output v-param-type
      620       ,INPUT-OUTPUT table-handle v-tth
      621       )  .
      622     if rep-excel then v-excel = "TRUE" .
      623     else v-excel = "FALSE" .
      624     if p-param eq ""
      625     then
      626        p-param = "EXCEL:" + v-excel.
      627     else
      628        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      629     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      630   end procedure.
      631   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      632   FUNCTION mark-string RETURNS CHARACTER
      633     ( input p-recid as recid, input mark-list as character  ) :
      634     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      635   END FUNCTION.
      636   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      637   procedure cur-time :
      638      define output parameter p-today as date      no-undo .
      639      define output parameter p-time  as integer   no-undo .
      640     do
      641     on error undo, return error
      642     :
      643       define variable v-date1 as date      no-undo .
      644       define variable v-date2 as date      no-undo .
      645       define variable v-time  as integer   no-undo .
      646       assign
      647         v-date1 = today
      648         v-time  = time
      649         v-date2 = today
      650       .
      651       if v-date1 <> v-date2
      652       then do:
      653         assign
      654           v-date1 = today
      655           v-time  = v-time
      656         .
      657       end.
      658       assign
      659         p-today = v-date1
      660         p-time  = v-time
      661       .
      662     end.
      663   end.
      664   function cur-time-date returns character
      665   :
      666     return string(today, '99/99/9999':U) .
      667   end.
      668   function cur-time-mjd returns decimal
      669   :
      670     define variable v-date as date      no-undo .
      671     define variable v-time as integer   no-undo .
      672     run cur-time in this-procedure
      673       (output v-date
      674       ,output v-time
      675       ) .
      676     return integer(v-date) - 2400002 + (v-time / 86400) .
      677   end.
      678   function cur-time-get-ending-index returns integer
      679   (input p-number as integer
      680   )
      681   :
      682     if p-number < 0
      683     or p-number = ?
      684     then do:
      685       return 1 .
      686     end.
      687     define variable v-rest as integer   no-undo .
      688     assign
      689       p-number = p-number modulo 100
      690     .
      691     if p-number < 20
      692     then do:
      693       assign
      694         v-rest = p-number
      695       .
      696     end.
      697     else do:
      698       assign
      699         v-rest = p-number modulo 10
      700       .
      701     end.
      702     case v-rest :
      703       when 1
      704       then do:
      705         return 2 .
      706       end.
      707       when 2 or
      708       when 3 or
      709       when 4
      710       then do:
      711         return 3 .
      712       end.
      713       otherwise do:
      714         return 1 .
      715       end.
      716     end case .
      717   end.
      718   procedure cur-time-mjd-to-date :
      719      define input  parameter i-mjd-diff as decimal no-undo.
      720      define output parameter o-Date     as date    no-undo.
      721      define output parameter o-Time     as integer no-undo.
      722      define variable v-day-number as integer   no-undo .
      723      if    i-mjd-diff < 0
      724         or i-mjd-diff = ?
      725      then do:
      726         return "?" .
      727      end.
      728      assign
      729         v-day-number = truncate(i-mjd-diff,0).
      730         o-Date = date(v-day-number + 2400002).
      731         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      732     .
      733   end.
      734   function cur-time-mjd-to-string returns character
      735   (input p-mjd-diff as decimal
      736   )
      737   :
      738     define variable v-day-number as integer   no-undo .
      739     define variable v-seconds    as integer   no-undo .
      740     define variable v-hour       as integer   no-undo .
      741     define variable v-min        as integer   no-undo .
      742     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      743     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      744     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      745     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      746     if p-mjd-diff < 0
      747     or p-mjd-diff = ?
      748     then do:
      749       return "?" .
      750     end.
      751     assign
      752       v-day-number = integer(truncate(p-mjd-diff,0))
      753       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      754     .
      755     if v-seconds > 86400
      756     then do:
      757       assign
      758         v-seconds = 86400 - 1
      759       .
      760     end.
      761     if v-seconds < 0
      762     then do:
      763       assign
      764         v-seconds = 0
      765       .
      766     end.
      767     assign
      768       v-hour = truncate(v-seconds / 3600, 0)
      769     .
      770     assign
      771       v-seconds = v-seconds modulo 3600
      772     .
      773     assign
      774       v-min = truncate(v-seconds / 60, 0)
      775     .
      776     assign
      777       v-seconds = v-seconds modulo 60
      778     .
      779     return
      780         (if v-day-number <> 0
      781           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      782           else ""
      783         )
      784       + (if v-day-number <> 0 or v-hour <> 0
      785           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      786           else ""
      787         )
      788       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      789           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      790           else ""
      791         )
      792       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      793       .
      794   end.
      795   function cur-time-string returns character
      796   :
      797     define variable v-date as date      no-undo .
      798     define variable v-time as integer   no-undo .
      799     run cur-time in this-procedure
      800       (output v-date
      801       ,output v-time
      802       ) .
      803     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      804   end.
      805   function cur-time-string-sec returns character
      806   :
      807     define variable v-date as date      no-undo .
      808     define variable v-time as integer   no-undo .
      809     run cur-time in this-procedure
      810       (output v-date
      811       ,output v-time
      812       ) .
      813     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      814   end.
      815   function cur-time-custom  returns character
      816   (input p-prefix as character
      817   ,input p-date-format as character
      818   ,input p-delimiter as character
      819   ,input p-time-format as character
      820   ,input p-suffix as character
      821   )
      822   :
      823     define variable v-date as date      no-undo .
      824     define variable v-time as integer   no-undo .
      825     run cur-time in this-procedure
      826       (output v-date
      827       ,output v-time
      828       ) .
      829     return
      830       p-prefix
      831       + string(v-date, p-date-format)
      832       + p-delimiter
      833       + string(v-time, p-time-format)
      834       + p-suffix
      835       .
      836   end.
      837   function cur-time-print  returns character
      838   :
      839     define variable v-date as date      no-undo .
      840     define variable v-time as integer   no-undo .
      841     run cur-time in this-procedure
      842       (output v-date
      843       ,output v-time
      844       ) .
      845     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      846   end.
      847   function cur-time-datetime returns datetime
      848   :
      849     define variable v-char as character no-undo .
      850     define variable v-datetime as datetime no-undo .
      851     v-char = cur-time-string().
      852     v-datetime = datetime(v-char).
      853     return  v-datetime.
      854   end.
      855   function cur-time-string-msec returns character
      856   :
      857     define variable v-date as datetime  no-undo .
      858     v-date = now.
      859     return string(v-date) .
      860   end.
      861   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      862   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      863   procedure fltopend_fltopend :
      864   define input parameter p-parent-handle as handle no-undo .
      865   define input parameter p-qh as handle no-undo .
      866   define input parameter p-flt-open-open-query  as character no-undo .
      867   define input parameter p-where-cond as character no-undo .
      868   define input parameter p-use-indFIRST-query-tail as character no-undo .
      869   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      870   define input parameter p-indexed-reposition as character no-undo .
      871     do
      872     on error undo, return error
      873     :
      874   define variable v-prepare-string as character no-undo .
      875   define variable glog as logical no-undo .
      876   assign
      877   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      878                      p-where-cond + chr(32)  +
      879                      p-use-indFIRST-query-tail + chr(32) +
      880                      p-use-ind-sort-clmn-by + chr(32) +
      881                      p-indexed-reposition
      882   .
      883   assign
      884   glog = p-qh:query-prepare(v-prepare-string) no-error .
      885   if not glog
      886   or error-status:error then do:
      887     message error-status:get-message(1) view-as alert-box .
      888     undo, return error .
      889   end.
      890   assign
      891   glog = p-qh:query-open no-error .
      892   if not glog
      893   or error-status:error then do:
      894     message error-status:get-message(1) view-as alert-box .
      895     undo, return error .
      896   end.
      897     end.
      898   end procedure.
      899   procedure fltopend_fltfindd :
      900   define input parameter p-parent-handle as handle no-undo .
      901   define input parameter p-qh as handle no-undo .
      902   define input parameter p-rowid as rowid no-undo .
      903   define input parameter p-next as logical no-undo .
      904   define input parameter p-lock as integer no-undo .
      905   define input parameter p-bh as handle no-undo .
      906   define input parameter p-where-cond as character no-undo .
      907   define input parameter p-use-index-phrase as character no-undo .
      908   define variable glog as logical no-undo .
      909   define variable v-qh as handle no-undo .
      910   define variable v-bh as handle no-undo .
      911   define variable v-recid as recid no-undo .
      912   define variable v-prepare-string as character no-undo .
      913   do
      914   on error undo, return error
      915   on stop undo, return error
      916   :
      917     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      918     create buffer v-bh for table p-bh buffer-name p-bh:name.
      919     create query v-qh.
      920     v-qh:set-buffers(v-bh).
      921     v-prepare-string = substitute("for each &1 &2 &3"
      922                                     ,v-bh:name
      923                                     ,p-where-cond
      924                                     ,p-use-index-phrase).
      925     glog = v-qh:query-prepare(v-prepare-string) no-error.
      926     if not glog then do:
      927       delete object v-qh.
      928       delete object v-bh.
      929       undo, return error .
      930     end.
      931     glog = v-qh:query-open no-error .
      932     if not glog then do:
      933       delete object v-qh.
      934       delete object v-bh.
      935       undo, return error .
      936     end.
      937     if p-next then do:
      938       v-qh:reposition-to-rowid(p-rowid) no-error .
      939       glog = v-qh:get-next( p-lock) no-error .
      940       glog = v-qh:get-next( p-lock) no-error .
      941       if not glog or v-qh:query-off-end = yes then do:
      942         glog = v-qh:get-first( p-lock) no-error .
      943       end.
      944     end.
      945     else do:
      946       glog = v-qh:get-first( p-lock) no-error .
      947     end.
      948     v-recid = v-bh:recid no-error .
      949     delete object v-qh.
      950     delete object v-bh.
      951     return string(v-recid) .
      952   end.
      953   end procedure.
      954   procedure fltopend_fltfindq :
      955   define input parameter p-parent-handle as handle no-undo .
      956   define input parameter p-qh as handle no-undo .
      957   define input parameter p-next as logical no-undo .
      958   define input parameter p-lock as integer no-undo .
      959   define input parameter p-flt-open-open-query  as character no-undo .
      960   define input parameter p-where-cond as character no-undo .
      961   define input parameter p-use-indFIRST-query-tail as character no-undo .
      962   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      963   define input parameter p-indexed-reposition as character no-undo .
      964   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      965   define variable glog as logical no-undo .
      966   define variable v-qh as handle no-undo .
      967   define variable v-bh as handle no-undo extent 18.
      968   define variable v-rowid as rowid no-undo extent 18.
      969   define variable v-ii as integer no-undo .
      970   define variable v-prepare-string as character no-undo .
      971   do
      972   on error undo, return error
      973   on stop undo, return error
      974   :
      975     create query v-qh.
      976     do v-ii = 1 to p-qh:num-buffers:
      977       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      978       assign
      979       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      980       no-error.
      981       v-qh:add-buffer(v-bh[v-ii]).
      982     end.
      983     assign
      984     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      985                       p-where-cond + chr(32)  +
      986                       p-use-indFIRST-query-tail + chr(32) +
      987                       p-use-ind-sort-clmn-by + chr(32) +
      988                       p-indexed-reposition
      989     .
      990     glog = v-qh:query-prepare( v-prepare-string) no-error .
      991     if not glog then do:
      992       delete object v-qh.
      993       do v-ii = 1 to p-qh:num-buffers:
      994         delete object v-bh[v-ii].
      995       end.
      996       undo, return error .
      997     end.
      998     glog = v-qh:query-open no-error .
      999     if not glog then do:
     1000       delete object v-qh.
     1001       do v-ii = 1 to p-qh:num-buffers:
     1002         delete object v-bh[v-ii].
     1003       end.
     1004       undo, return error .
     1005     end.
     1006     if p-next then do:
     1007       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1008       glog = v-qh:get-next( p-lock) no-error .
     1009       glog = v-qh:get-next( p-lock) no-error .
     1010       if not glog or v-qh:query-off-end = yes then do:
     1011         glog = v-qh:get-first( p-lock) no-error .
     1012       end.
     1013     end.
     1014     else do:
     1015       glog = v-qh:get-first( p-lock) no-error .
     1016     end.
     1017     do v-ii = 1 to p-qh:num-buffers:
     1018       assign
     1019       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1020       no-error.
     1021     end.
     1022     delete object v-qh.
     1023     do v-ii = 1 to p-qh:num-buffers:
     1024       delete object v-bh[v-ii].
     1025     end.
     1026   end.
     1027   end procedure.
