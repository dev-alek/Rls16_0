     1080   entry (lookup (X_dis-cp-rule.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U) COLUMN-LABEL 'Место использ.' FORMAT "X(20)"
     1081   X_dis-cp-rule.obj-type COLUMN-LABEL 'Тип объ' FORMAT "X(3)"
     1082   X_dis-cp-rule.obj-code COLUMN-LABEL 'Код объ' FORMAT ">>>>9"
     1083   entry (lookup (X_dis-cp-rule.discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u) COLUMN-LABEL 'Тип скидки' FORMAT "X(70)" width 40
     1084   X_dis-cp-rule.rule-num COLUMN-LABEL '№ правила' FORMAT ">>>>>>>>9"
     1085   X_dis-cp-rule.rl-root COLUMN-LABEL '№ корн.!правила' FORMAT ">>>>>>>>9"
     1086       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 20 FIT-LAST-COLUMN.
     1087   DEFINE FRAME Dialog-Frame
     1088        b-quit AT ROW 1 COL 1
     1089        B-mark AT ROW 1 COL 11 WIDGET-ID 4
     1090        B-sel AT ROW 1 COL 21 WIDGET-ID 10
     1091        B-type AT ROW 1 COL 41 WIDGET-ID 14
     1092        b-dis-rule AT ROW 1 COL 51 WIDGET-ID 16
     1093        B-sch AT ROW 1 COL 86 WIDGET-ID 8
     1094        B-print AT ROW 1 COL 89 WIDGET-ID 6
     1095        b-history AT ROW 1 COL 92 WIDGET-ID 2
     1096        B-Help AT ROW 1 COL 95
     1097        BR-dis-cp-rule AT ROW 3 COL 1 WIDGET-ID 100
     1098        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL WIDGET-ID 12
     1099        SPACE(78.69) SKIP(21.22)
     1100       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1101            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1102            TITLE "Скидки на типы кассовых платежей"
     1103            CANCEL-BUTTON b-quit.
     1104   ASSIGN
     1105          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1106          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1107   ON GO OF FRAME Dialog-Frame
     1108   DO:
     1109     p-rid-list = v-rid-list.
     1110   END.
     1111   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1112   DO:
     1113     APPLY "END-ERROR":U TO SELF.
     1114   END.
     1115   ON CHOOSE OF b-dis-rule IN FRAME Dialog-Frame
     1116   DO:
     1117     IF NOT AVAILABLE X_dis-cp-rule THEN RETURN NO-APPLY.
     1118     run ref/show-dr.p ( INPUT parparentproc
     1119                        ,INPUT X_dis-cp-rule.rule-num) NO-ERROR.
     1120     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1121   END.
     1122   ON CHOOSE OF b-history IN FRAME Dialog-Frame
     1123   DO:
     1124   define variable v-rid-list as character no-undo .
     1125   if not available X_dis-cp-rule then return no-apply.
     1126     run ref/ccashpay.w (
     1127                         input parparentproc
     1128                       , INPUT "":U
     1129                       , INPUT "one-subject":U
     1130                       , OUTPUT v-rid-list
     1131                       , INPUT X_dis-cp-rule.cdpay-code
     1132                       , INPUT X_dis-cp-rule.curr-code
     1133                       , input 'dis-cp-rule':U
     1134                       ) no-error .
     1135     APPLY "ENTRY" to br-dis-cp-rule.
     1136   END.
     1137   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1138   DO:
     1139     RUN proc-b-mark IN THIS-PROCEDURE NO-ERROR.
     1140     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1141   END.
     1142   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1143   DO:
     1144     run proc-b-print in this-procedure no-error.
     1145     if error-status:error then do:
     1146       return no-apply.
     1147     end.
     1148     APPLY "ENTRY" to br-dis-cp-rule.
     1149   END.
     1150   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1151   DO:
     1152     RUN proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1153     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1154   END.
     1155   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1156   DO:
     1157       if ( available X_dis-cp-rule ) then do:
     1158       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1159       then
     1160       v-rid-list = string( recid( X_dis-cp-rule ) ) .
     1161     end.
     1162   END.
     1163   ON CHOOSE OF B-type IN FRAME Dialog-Frame
     1164   DO:
     1165   DEFINE VARIABLE v-ref-rec AS RECID NO-UNDO.
     1166   define buffer buf_cash-pay for ub.cash-pay.
     1167     IF NOT AVAILABLE X_cash-pay THEN RETURN NO-APPLY.
     1168     FIND FIRST buf_cash-pay No-LOCK WHERE
     1169               buf_cash-pay.curr-code = X_cash-pay.curr-code
     1170           and buf_cash-pay.cdpay-code = X_cash-pay.cdpay-code  no-error .
     1171   if error-status:error then  return no-apply.
     1172   v-ref-rec = recid( buf_cash-pay ) .
     1173       run ref/cashpayi.w (
     1174                      input parparentproc
     1175                     ,input 'ПРОСМОТР':U
     1176                     , input v-cntxt-host-code-obj
     1177                     , input v-cntxt-obj-type
     1178                     , input v-cntxt-obj-code
     1179                     , input-output v-ref-rec ).
     1180   apply "entry" to br-dis-cp-rule in frame Dialog-Frame.
     1181   END.
     1182   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1183   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1184   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1185   on help of frame Dialog-Frame
     1186   do:
     1187     run gbl/app_help.p
     1188       (input this-procedure :file-name
     1189       ,input ''
     1190       ,input ?
     1191       ) no-error.
     1192     if error-status :error then do:
     1193       message
     1194         "Ошибка при вызове помощи"
     1195         error-status :get-message(1)
     1196         view-as alert-box .
     1197     end.
     1198   end.
     1199   run minbtn-set in this-procedure .
     1200   on choose of b-help in frame Dialog-Frame
     1201   do:
     1202     apply "help":u to frame Dialog-Frame .
     1203   end.
     1204   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1205   procedure minbtn-set :
     1206       do
     1207           on error undo, return error return-value
     1208           :
     1209           define variable ii              as integer       no-undo .
     1210           define variable fh              as widget-handle no-undo .
     1211           define variable hh              as widget-handle no-undo .
     1212           define variable v-h             as handle        extent 4 no-undo .
     1213           define variable v-name-button   as character     no-undo .
     1214           define variable v-help-old-x    as decimal       no-undo .
     1215           define variable v-help-old-y    as decimal       no-undo .
     1216           define variable v-help-old-size as decimal       no-undo .
     1217           define variable v-frame-width   as decimal       no-undo .
     1218           define variable jj              as integer       no-undo .
     1219           do
     1220               on error undo, return error
     1221               :
     1222               assign
     1223                   v-frame-width = frame Dialog-Frame:width - 0.3
     1224                   fh            = frame Dialog-Frame:first-child
     1225                   hh            = fh:first-child
     1226                   ii            = 1
     1227                   .
     1228               do while valid-handle(hh):
     1229                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1230                   do:
     1231                       case lc(hh:name) :
     1232                           when "b-help" then
     1233                               do:
     1234                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1235                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1236                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1237                                   hh:TOOLTIP = "Помощь" .
     1238                                   v-help-old-x = hh:column .
     1239                                   v-help-old-y = hh:row    .
     1240                                   v-help-old-size = hh:width .
     1241                                   hh:width-chars = 2.5 .
     1242                               end.
     1243                           when "b-print" then
     1244                               do:
     1245                                   hh:load-image("cmp/b-print.bmp":u) .
     1246                                   hh:TOOLTIP = "Печать" .
     1247                                   v-h[ii] = hh:handle .
     1248                                   ii = ii + 1 .
     1249                                   hh:width-chars = 3 .
     1250                               end.
     1251                           when "b-history" or
     1252                           when "b-hist" then
     1253                               do:
     1254                                   hh:load-image("cmp/b-hist.bmp":u) .
     1255                                   hh:TOOLTIP = "История" .
     1256                                   v-h[ii] = hh:handle .
     1257                                   ii = ii + 1 .
     1258                                   hh:width-chars = 3 .
     1259                               end.
     1260                           when "b-sch" then
     1261                               do:
     1262                                   hh:load-image("cmp/b-sch.bmp":u) .
     1263                                   hh:TOOLTIP = "Установка Фильтра" .
     1264                                   v-h[ii] = hh:handle .
     1265                                   ii = ii + 1 .
     1266                                   hh:width-chars = 3 .
     1267                               end.
     1268                           when "b-hist-user" then
     1269                               do:
     1270                                   hh:load-image("cmp/b-hist.bmp":u) .
     1271                                   hh:TOOLTIP = "История пользователя" .
     1272                                   ii = ii + 1 .
     1273                               end.
     1274                       end case.
     1275                   end.
     1276                   hh = hh:next-sibling.
     1277               end.
     1278               b-help:column = v-frame-width - b-help:width-chars.
     1279               jj = 0.
     1280               repeat ii = 4 to 1 by -1 :
     1281                   if valid-handle (v-h[ii] ) then
     1282                   do:
     1283                       jj  = jj + 1 .
     1284                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1285                       v-h[ii]:row    = v-help-old-y .
     1286                   end.
     1287               end.
     1288           end.
     1289       end.
     1290   end procedure.
     1291   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1292   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1293   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1294   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1295   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1296   define variable v-diasize-current-frame-height as decimal   no-undo .
     1297   define variable v-diasize-change-size          as logical   no-undo .
     1298   define variable v-diasize-resize-button        as handle    no-undo .
     1299   define variable v-diasize-wndmax               as logical   no-undo .
     1300   define variable v-diasize-wndstore             as logical   no-undo .
     1301   define variable v-diasize-proc-name            as character no-undo .
     1302   define variable v-diasize-browse-handle        as handle    no-undo .
     1303   define variable v-diasize-browse-number        as integer   no-undo .
     1304   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1305   define temp-table temp-diasize-handle no-undo
     1306     field handle-value  as handle
     1307     field save-position as decimal
     1308     index xpk is primary unique handle-value
     1309     .
     1310   define temp-table temp-browse-handle no-undo
     1311     field browse-type   as character
     1312     field browse-number as integer
     1313     field browse-handle as handle
     1314     field original-size as decimal
     1315     index xpk is primary unique browse-type browse-number
     1316     index xie browse-type browse-handle
     1317   .
     1318   procedure diasize_change-height :
     1319     define input  parameter p-change-value  as decimal   no-undo .
     1320     define input  parameter p-move-resize   as logical   no-undo .
     1321     define variable v-field-group-handle    as handle    no-undo .
     1322     define variable v-object-handle         as handle    no-undo .
     1323     define variable v-frame-height          as decimal   no-undo .
     1324     define variable v-frame-virtual-height  as decimal   no-undo .
     1325     define variable v-browse-height         as decimal   no-undo .
     1326     define variable v-window-height         as decimal   no-undo .
     1327     define variable v-window-virtual-height as decimal   no-undo .
     1328     define variable v-change-sign           as integer   no-undo .
     1329     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1330     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1331     if p-change-value > 0
     1332     then do:
     1333       if frame Dialog-Frame :height + p-change-value
     1334           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1335       then do:
     1336         assign
     1337           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1338                           - (frame Dialog-Frame :height-chars)
     1339         .
     1340         if p-change-value <= 0
     1341         then do:
     1342           run diasize_position-resize-button in this-procedure .
     1343           return .
     1344         end.
     1345       end.
     1346     end.
     1347     if p-change-value < 0
     1348     then do:
     1349       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1350       then do:
     1351         assign
     1352           p-change-value = v-diasize-orig-frame-height
     1353                          - (frame Dialog-Frame :height-chars)
     1354         .
     1355         if p-change-value >= 0
     1356         then do:
     1357           run diasize_position-resize-button in this-procedure .
     1358           return .
     1359         end.
     1360       end.
     1361     end.
     1362     if p-change-value >= 0
     1363     then do:
     1364       assign
     1365         v-change-sign = 1
     1366       .
     1367     end.
     1368     else do:
     1369       assign
     1370         v-change-sign = -1
     1371       .
     1372     end.
     1373     assign
     1374       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1375     .
     1376     if p-change-value = 0
     1377     then do:
     1378       run diasize_position-resize-button in this-procedure .
     1379       return .
     1380     end.
     1381     move_block:
     1382     do
     1383     on error undo move_block, retry move_block
     1384     :
     1385       if retry
     1386       then do:
     1387         do
     1388         on error undo move_block, leave move_block
     1389         :
     1390           if p-change-value > 0
     1391           then do:
     1392             for each buf_temp-diasize-handle
     1393             on error undo, next
     1394             :
     1395               assign
     1396                 v-object-handle = buf_temp-diasize-handle.handle-value
     1397               .
     1398               if v-object-handle <> v-diasize-resize-button
     1399               then do:
     1400                 assign
     1401                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1402                 .
     1403               end.
     1404             end.
     1405             assign
     1406               v-diasize-browse-handle :height = v-browse-height
     1407             .
     1408             for each buf_temp-browse-handle
     1409               where buf_temp-browse-handle.browse-type = 'height':u
     1410             on error undo, next
     1411             :
     1412               assign
     1413                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1414               .
     1415             end.
     1416             assign
     1417               frame Dialog-Frame :height = v-frame-height
     1418             .
     1419             if frame Dialog-Frame :scrollable = true
     1420             then do:
     1421               assign
     1422                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1423               .
     1424             end.
     1425             run diasize_position-resize-button in this-procedure .
     1426           end.
     1427           else do:
     1428             if frame Dialog-Frame :scrollable = true
     1429             then do:
     1430               assign
     1431                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1432               .
     1433             end.
     1434             assign
     1435               frame Dialog-Frame :height = v-frame-height
     1436             .
     1437             assign
     1438               v-diasize-browse-handle :height = v-browse-height
     1439             .
     1440             for each buf_temp-browse-handle
     1441               where buf_temp-browse-handle.browse-type = 'height':u
     1442             on error undo, next
     1443             :
     1444               assign
     1445                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1446               .
     1447             end.
     1448             for each buf_temp-diasize-handle
     1449             on error undo, next
     1450             :
     1451               assign
     1452                 v-object-handle = buf_temp-diasize-handle.handle-value
     1453               .
     1454               if v-object-handle <> v-diasize-resize-button
     1455               then do:
     1456                 assign
     1457                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1458                 .
     1459               end.
     1460             end.
     1461             run diasize_position-resize-button in this-procedure .
     1462           end.
     1463           assign
     1464             v-diasize-change-size = false
     1465           .
     1466           leave move_block .
     1467         end.
     1468       end.
     1469       assign
     1470         v-diasize-need-full-display = true
     1471       .
     1472       if v-diasize-change-size = false
     1473       then do:
     1474         assign
     1475           v-diasize-change-size = true
     1476         .
     1477       end.
     1478       else do:
     1479         return .
     1480       end.
     1481       assign
     1482         v-frame-height = frame Dialog-Frame :height
     1483         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1484         v-browse-height = v-diasize-browse-handle :height
     1485       .
     1486       for each buf_temp-browse-handle
     1487         where buf_temp-browse-handle.browse-type = 'height':u
     1488       :
     1489         assign
     1490           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1491         .
     1492       end.
     1493       for each buf_temp-diasize-handle
     1494       :
     1495         delete buf_temp-diasize-handle .
     1496       end.
     1497       assign
     1498         v-field-group-handle = frame Dialog-Frame :first-child
     1499       .
     1500       do while valid-handle(v-field-group-handle)
     1501       :
     1502         assign
     1503           v-object-handle = v-field-group-handle :first-child
     1504         .
     1505         do while valid-handle(v-object-handle)
     1506         :
     1507           if  v-object-handle <> v-diasize-browse-handle :handle
     1508           and can-query(v-object-handle, "row")
     1509           and can-query(v-object-handle, "height")
     1510           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1511           then do:
     1512             find first buf_temp-browse-handle
     1513               where buf_temp-browse-handle.browse-type   = 'height':u
     1514                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1515               no-error .
     1516             if available buf_temp-browse-handle
     1517             then do:
     1518             end.
     1519             else do:
     1520               create buf_temp-diasize-handle .
     1521               assign
     1522                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1523                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1524               .
     1525             end.
     1526           end.
     1527           assign
     1528             v-object-handle = v-object-handle :next-sibling
     1529           .
     1530         end.
     1531         assign
     1532           v-field-group-handle = v-field-group-handle :next-sibling
     1533         .
     1534       end.
     1535       do with frame Dialog-Frame
     1536       :
     1537         hide v-diasize-resize-button .
     1538         assign
     1539           v-diasize-resize-button :row    = 1
     1540           v-diasize-resize-button :column = 1
     1541         .
     1542       end.
     1543       if p-change-value > 0
     1544       then do:
     1545         if frame Dialog-Frame :scrollable = true
     1546         then do:
     1547           assign
     1548             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1549             no-error .
     1550           if error-status :error
     1551           or error-status :get-message(1) <> ""
     1552           then do:
     1553             undo move_block, retry move_block .
     1554           end.
     1555         end.
     1556         assign
     1557           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1558           no-error .
     1559         if error-status :error
     1560         or error-status :get-message(1) <> ""
     1561         then do:
     1562           undo move_block, retry move_block .
     1563         end.
     1564         assign
     1565           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1566           no-error .
     1567         if error-status :error
     1568         or error-status :get-message(1) <> ""
     1569         then do:
     1570           undo move_block, retry move_block .
     1571         end.
     1572         for each buf_temp-browse-handle
     1573           where buf_temp-browse-handle.browse-type = 'height':u
     1574         on error undo move_block, retry move_block
     1575         :
     1576           assign
     1577             buf_temp-browse-handle.browse-handle :height
     1578               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1579             no-error .
     1580           if error-status :error
     1581           or error-status :get-message(1) <> ""
     1582           then do:
     1583             undo move_block, retry move_block .
     1584           end.
     1585         end.
     1586         for each buf_temp-diasize-handle
     1587         on error undo move_block, retry move_block
     1588         :
     1589           assign
     1590             v-object-handle = buf_temp-diasize-handle.handle-value
     1591           .
     1592           if v-object-handle <> v-diasize-resize-button
     1593           then do:
     1594             assign
     1595               v-object-handle :row = v-object-handle :row + p-change-value
     1596               no-error .
     1597             if error-status :error
     1598             or error-status :get-message(1) <> ""
     1599             then do:
     1600               undo move_block, retry move_block .
     1601             end.
     1602           end.
     1603         end.
     1604       end.
     1605       else do:
     1606         for each buf_temp-diasize-handle
     1607         on error undo move_block, retry move_block
     1608         :
     1609           assign
     1610             v-object-handle = buf_temp-diasize-handle.handle-value
     1611           .
     1612           if v-object-handle <> v-diasize-resize-button
     1613           then do:
     1614             assign
     1615               v-object-handle :row = v-object-handle :row + p-change-value
     1616               no-error .
     1617             if error-status :error
     1618             or error-status :get-message(1) <> ""
     1619             then do:
     1620               undo move_block, retry move_block .
     1621             end.
     1622           end.
     1623         end.
     1624         assign
     1625           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1626           no-error .
     1627         if error-status :error
     1628         or error-status :get-message(1) <> ""
     1629         then do:
     1630           undo move_block, retry move_block .
     1631         end.
     1632         for each buf_temp-browse-handle
     1633           where buf_temp-browse-handle.browse-type = 'height':u
     1634         on error undo move_block, retry move_block
     1635         :
     1636           assign
     1637             buf_temp-browse-handle.browse-handle :height
     1638               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1639             no-error .
     1640           if error-status :error
     1641           or error-status :get-message(1) <> ""
     1642           then do:
     1643             undo move_block, retry move_block .
     1644           end.
     1645         end.
     1646         assign
     1647           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1648           no-error .
     1649         if error-status :error
     1650         or error-status :get-message(1) <> ""
     1651         then do:
     1652           undo move_block, retry move_block .
     1653         end.
     1654         if frame Dialog-Frame :scrollable = true
     1655         then do:
     1656           assign
     1657             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1658             no-error .
     1659           if error-status :error
     1660           or error-status :get-message(1) <> ""
     1661           then do:
     1662             undo move_block, retry move_block .
     1663           end.
     1664         end.
     1665       end.
     1666       if p-move-resize = true
     1667       then do:
     1668         run diasize_position-resize-button in this-procedure .
     1669       end.
     1670       if v-diasize-wndstore = true
     1671       then do:
     1672         if connected("ub") = true
     1673         then do:
     1674           define variable v-cntxt-db-num        as integer   no-undo .
     1675           define variable v-cntxt-userid        as character no-undo .
     1676           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1677                                             , OUTPUT v-cntxt-userid
     1678                                             ) .
     1679           run gbl/wndsizew.p
     1680             (input  v-cntxt-db-num
     1681             ,input  v-cntxt-userid
     1682             ,input  v-diasize-proc-name
     1683             ,input  'height':u
     1684             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1685             ) .
     1686         end.
     1687       end.
     1688     end.
     1689     assign
     1690       v-diasize-change-size = false
     1691     .
     1692   end procedure.
     1693   procedure diasize_set-height :
     1694     define input  parameter p-new-height  as decimal   no-undo .
     1695     define input  parameter p-move-resize as logical   no-undo .
     1696     do
     1697     on error undo, return error return-value
     1698     :
     1699       run diasize_change-height in this-procedure
     1700         (input  (p-new-height - frame Dialog-Frame :height)
     1701         ,input  p-move-resize
     1702         ) .
     1703     end.
     1704   end procedure.
     1705   procedure diasize_change-width :
     1706     define input  parameter p-change-value as decimal   no-undo .
     1707     define input  parameter p-move-resize  as logical   no-undo .
     1708     define variable v-field-group-handle   as handle    no-undo .
     1709     define variable v-object-handle        as handle    no-undo .
     1710     define variable v-frame-width          as decimal   no-undo .
     1711     define variable v-frame-virtual-width  as decimal   no-undo .
     1712     define variable v-browse-width         as decimal   no-undo .
     1713     define variable v-window-width         as decimal   no-undo .
     1714     define variable v-window-virtual-width as decimal   no-undo .
     1715     define variable v-change-sign          as integer   no-undo .
     1716     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1717     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1718     if p-change-value > 0
     1719     then do:
     1720       if frame Dialog-Frame :width + p-change-value >
     1721           session :width-chars
     1722       then do:
     1723         assign
     1724           p-change-value = session :width-chars - frame Dialog-Frame :width
     1725         .
     1726         if p-change-value <= 0
     1727         then do:
     1728           run diasize_position-resize-button in this-procedure .
     1729           return .
     1730         end.
     1731       end.
     1732     end.
     1733     if p-change-value < 0
     1734     then do:
     1735       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1736       then do:
     1737         assign
     1738           p-change-value = v-diasize-orig-frame-width
     1739                          - frame Dialog-Frame :width
     1740         .
     1741         if p-change-value >= 0
     1742         then do:
     1743           run diasize_position-resize-button in this-procedure .
     1744           return .
     1745         end.
     1746       end.
     1747     end.
     1748     if p-change-value >= 0
     1749     then do:
     1750       assign
     1751         v-change-sign = 1
     1752       .
     1753     end.
     1754     else do:
     1755       assign
     1756         v-change-sign = -1
     1757       .
     1758     end.
     1759     assign
     1760       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1761     .
     1762     if p-change-value = 0
     1763     then do:
     1764       run diasize_position-resize-button in this-procedure .
     1765       return .
     1766     end.
     1767     move_block:
     1768     do
     1769     on error undo move_block, leave move_block
     1770     :
     1771       if retry
     1772       then do:
     1773         do
     1774         on error undo move_block, leave move_block
     1775         :
     1776           if p-change-value > 0
     1777           then do:
     1778             for each buf_temp-diasize-handle
     1779             on error undo, next
     1780             :
     1781               assign
     1782                 v-object-handle = buf_temp-diasize-handle.handle-value
     1783               .
     1784               if v-object-handle <> v-diasize-resize-button
     1785               then do:
     1786                 assign
     1787                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1788                 .
     1789               end.
     1790             end.
     1791             assign
     1792               v-diasize-browse-handle :width = v-browse-width
     1793             .
     1794             for each buf_temp-browse-handle
     1795               where buf_temp-browse-handle.browse-type = 'width':u
     1796             on error undo, next
     1797             :
     1798               assign
     1799                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1800               .
     1801             end.
     1802             assign
     1803               frame Dialog-Frame :width = v-frame-width
     1804             .
     1805             if frame Dialog-Frame :scrollable = true
     1806             then do:
     1807               assign
     1808                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1809               .
     1810             end.
     1811             run diasize_position-resize-button in this-procedure .
     1812           end.
     1813           else do:
     1814             if frame Dialog-Frame :scrollable = true
     1815             then do:
     1816               assign
     1817                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1818               .
     1819             end.
     1820             assign
     1821               frame Dialog-Frame :width = v-frame-width
     1822             .
     1823             for each buf_temp-browse-handle
     1824               where buf_temp-browse-handle.browse-type = 'width':u
     1825             on error undo, next
     1826             :
     1827               assign
     1828                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1829               .
     1830             end.
     1831             assign
     1832               v-diasize-browse-handle :width = v-browse-width
     1833             .
     1834             for each buf_temp-diasize-handle
     1835             on error undo, next
     1836             :
     1837               assign
     1838                 v-object-handle = buf_temp-diasize-handle.handle-value
     1839               .
     1840               if v-object-handle <> v-diasize-resize-button
     1841               then do:
     1842                 assign
     1843                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1844                 .
     1845               end.
     1846             end.
     1847             run diasize_position-resize-button in this-procedure .
     1848           end.
     1849           assign
     1850             v-diasize-change-size = false
     1851           .
     1852           leave move_block .
     1853         end.
     1854       end.
     1855       assign
     1856         v-diasize-need-full-display = true
     1857       .
     1858       if v-diasize-change-size = false
     1859       then do:
     1860         assign
     1861           v-diasize-change-size = true
     1862         .
     1863       end.
     1864       else do:
     1865         return .
     1866       end.
     1867       assign
     1868         v-frame-width = frame Dialog-Frame :width
     1869         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1870         v-browse-width = v-diasize-browse-handle :width
     1871       .
     1872       for each buf_temp-browse-handle
     1873         where buf_temp-browse-handle.browse-type = 'width':u
     1874       :
     1875         assign
     1876           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1877         .
     1878       end.
     1879       for each buf_temp-diasize-handle
     1880       :
     1881         delete buf_temp-diasize-handle .
     1882       end.
     1883       assign
     1884         v-field-group-handle = frame Dialog-Frame :first-child
     1885       .
     1886       do while valid-handle(v-field-group-handle)
     1887       :
     1888         assign
     1889           v-object-handle = v-field-group-handle :first-child
     1890         .
     1891         do while valid-handle(v-object-handle)
     1892         :
     1893           if  v-object-handle <> v-diasize-browse-handle :handle
     1894           and v-object-handle <> v-diasize-resize-button
     1895           and can-query(v-object-handle, "row")
     1896           and can-query(v-object-handle, "height")
     1897           and ( v-object-handle :col + v-object-handle :width
     1898                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1899               )
     1900           then do:
     1901             find first buf_temp-browse-handle
     1902               where buf_temp-browse-handle.browse-type   = 'width':u
     1903                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1904               no-error .
     1905             if available buf_temp-browse-handle
     1906             then do:
     1907             end.
     1908             else do:
     1909               create buf_temp-diasize-handle .
     1910               assign
     1911                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1912                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1913               .
     1914             end.
     1915           end.
     1916           assign
     1917             v-object-handle = v-object-handle :next-sibling
     1918           .
     1919         end.
     1920         assign
     1921           v-field-group-handle = v-field-group-handle :next-sibling
     1922         .
     1923       end.
     1924       do with frame Dialog-Frame
     1925       :
     1926         hide v-diasize-resize-button .
     1927         v-diasize-resize-button :row = 1.
     1928         v-diasize-resize-button :column = 1.
     1929       end.
     1930       if p-change-value > 0
     1931       then do:
     1932         if frame Dialog-Frame :scrollable = true
     1933         then do:
     1934           assign
     1935             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1936             no-error .
     1937           if error-status :error
     1938           or error-status :get-message(1) <> ""
     1939           then do:
     1940             undo move_block, retry move_block.
     1941           end.
     1942         end.
     1943         assign
     1944           frame Dialog-Frame :width = v-frame-width + p-change-value
     1945           no-error .
     1946         if error-status :error
     1947         or error-status :get-message(1) <> ""
     1948         then do:
     1949           undo move_block, retry move_block.
     1950         end.
     1951         assign
     1952           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1953         no-error .
     1954         if error-status :error
     1955         or error-status :get-message(1) <> ""
     1956         then do:
     1957           undo move_block, retry move_block.
     1958         end.
     1959         for each buf_temp-browse-handle
     1960           where buf_temp-browse-handle.browse-type = 'width':u
     1961         on error undo move_block, retry move_block
     1962         :
     1963           assign
     1964             buf_temp-browse-handle.browse-handle :width
     1965               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1966             no-error .
     1967           if error-status :error
     1968           or error-status :get-message(1) <> ""
     1969           then do:
     1970             undo move_block, retry move_block .
     1971           end.
     1972         end.
     1973         for each buf_temp-diasize-handle
     1974         on error undo move_block, retry move_block
     1975         :
     1976           assign
     1977             v-object-handle = buf_temp-diasize-handle.handle-value
     1978           .
     1979           if v-object-handle <> v-diasize-resize-button
     1980           then do:
     1981             assign
     1982               v-object-handle :col = v-object-handle :col + p-change-value
     1983               no-error .
     1984             if error-status :error
     1985             or error-status :get-message(1) <> ""
     1986             then do:
     1987               undo move_block, retry move_block .
     1988             end.
     1989           end.
     1990         end.
     1991       end.
     1992       else do:
     1993         for each buf_temp-diasize-handle
     1994         on error undo move_block, retry move_block
     1995         :
     1996           assign
     1997             v-object-handle = buf_temp-diasize-handle.handle-value
     1998           .
     1999           if v-object-handle <> v-diasize-resize-button
     2000           then do:
     2001             assign
     2002               v-object-handle :col = v-object-handle :col + p-change-value
     2003               no-error .
     2004             if error-status :error
     2005             or error-status :get-message(1) <> ""
     2006             then do:
     2007               undo move_block, retry move_block .
     2008             end.
     2009           end.
     2010         end.
     2011         for each buf_temp-browse-handle
     2012           where buf_temp-browse-handle.browse-type = 'width':u
     2013         on error undo move_block, retry move_block
     2014         :
     2015           assign
     2016             buf_temp-browse-handle.browse-handle :width
     2017               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2018             no-error .
     2019           if error-status :error
     2020           or error-status :get-message(1) <> ""
     2021           then do:
     2022             undo move_block, retry move_block .
     2023           end.
     2024         end.
     2025         assign
     2026           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2027           no-error .
     2028         if error-status :error
     2029         or error-status :get-message(1) <> ""
     2030         then do:
     2031           undo move_block, retry move_block.
     2032         end.
     2033         assign
     2034           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2035         no-error .
     2036         if error-status :error
     2037         or error-status :get-message(1) <> ""
     2038         then do:
     2039           undo move_block, retry move_block.
     2040         end.
     2041         if frame Dialog-Frame :scrollable = true
     2042         then do:
     2043           assign
     2044             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2045           no-error .
     2046           if error-status :error
     2047           or error-status :get-message(1) <> ""
     2048           then do:
     2049             undo move_block, retry move_block.
     2050           end.
     2051         end.
     2052       end.
     2053       if p-move-resize
     2054       then do:
     2055         run diasize_position-resize-button in this-procedure .
     2056       end.
     2057       if v-diasize-wndstore = true
     2058       then do:
     2059         if connected("ub") = true
     2060         then do:
     2061           define variable v-cntxt-db-num        as integer   no-undo .
     2062           define variable v-cntxt-userid        as character no-undo .
     2063           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2064                                             , OUTPUT v-cntxt-userid
     2065                                             ) .
     2066           run gbl/wndsizew.p
     2067             (input  v-cntxt-db-num
     2068             ,input  v-cntxt-userid
     2069             ,input  v-diasize-proc-name
     2070             ,input  'width':u
     2071             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2072             ) .
     2073         end.
     2074       end.
     2075     end.
     2076     assign
     2077       v-diasize-change-size = false
     2078     .
     2079   end procedure.
     2080   procedure diasize_set-width :
     2081     define input  parameter p-new-width  as decimal   no-undo .
     2082     define input  parameter p-move-resize as logical   no-undo .
     2083     do
     2084     on error undo, return error return-value
     2085     :
     2086       run diasize_change-width in this-procedure
     2087         (input  (p-new-width - frame Dialog-Frame :width)
     2088         ,input  p-move-resize
     2089         ) .
     2090     end.
     2091   end procedure.
     2092   procedure diasize_position-resize-button :
     2093     do with frame Dialog-Frame
     2094     :
     2095       hide v-diasize-resize-button .
     2096       assign
     2097         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2098                     - 1
     2099                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2100         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2101                     - 1
     2102                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2103       .
     2104       view v-diasize-resize-button .
     2105     end.
     2106   end procedure.
     2107   on alt-right anywhere
     2108   do:
     2109     run diasize_change-width in this-procedure
     2110       (input 1
     2111       ,input true
     2112       ) .
     2113     return no-apply .
     2114   end.
     2115   on alt-left anywhere
     2116   do:
     2117     run diasize_change-width in this-procedure
     2118       (input -1
     2119       ,input true
     2120       ) .
     2121     return no-apply .
     2122   end.
     2123   on alt-down anywhere
     2124   do:
     2125     run diasize_change-height in this-procedure
     2126       (input 1
     2127       ,input true
     2128       ) .
     2129     return no-apply .
     2130   end.
     2131   on alt-up anywhere
     2132   do:
     2133     run diasize_change-height in this-procedure
     2134       (input -1
     2135       ,input true
     2136       ) .
     2137     return no-apply .
     2138   end.
     2139   on alt-enter of frame Dialog-Frame
     2140   do:
     2141     run diasize_maximize in this-procedure
     2142       (input  ?
     2143       ).
     2144     return no-apply .
     2145   end.
     2146   procedure diasize_end-move :
     2147     do
     2148     on error undo, return error return-value
     2149     :
     2150       define variable v-row-delta as decimal   no-undo .
     2151       define variable v-col-delta as decimal   no-undo .
     2152       define variable v-new-row as decimal   no-undo .
     2153       define variable v-new-col as decimal   no-undo .
     2154       assign
     2155         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2156         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2157       .
     2158       assign
     2159         v-row-delta = v-new-row - frame Dialog-Frame :height
     2160         v-col-delta = v-new-col - frame Dialog-Frame :width
     2161       .
     2162       run diasize_change-height in this-procedure
     2163         (input v-row-delta
     2164         ,input true
     2165         ) .
     2166       run diasize_change-width in this-procedure
     2167         (input v-col-delta
     2168         ,input true
     2169         ) .
     2170     end.
     2171   end procedure.
     2172   procedure diasize_maximize :
     2173     define input  parameter p-action as logical   no-undo .
     2174     do
     2175     on error undo, return error return-value
     2176     :
     2177       if p-action = ?
     2178       then do:
     2179         if v-diasize-need-maximize = true
     2180         then do:
     2181           assign
     2182             p-action = true
     2183           .
     2184         end.
     2185         else do:
     2186           assign
     2187             p-action = false
     2188           .
     2189         end.
     2190       end.
     2191       if p-action = true
     2192       then do:
     2193         run diasize_change-height in this-procedure
     2194           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2195               - frame Dialog-Frame :height-chars
     2196           ,input true
     2197           ) .
     2198         run diasize_change-width in this-procedure
     2199           (input session :width-chars
     2200               - frame Dialog-Frame :width-chars
     2201           ,input true
     2202           ) .
     2203         assign
     2204           v-diasize-need-maximize = false
     2205         .
     2206       end.
     2207       else do:
     2208         run diasize_change-width in this-procedure
     2209           (input v-diasize-orig-frame-width
     2210               - frame Dialog-Frame :width-chars
     2211           ,input true
     2212           ) .
     2213         run diasize_change-height in this-procedure
     2214           (input v-diasize-orig-frame-height
     2215               - frame Dialog-Frame :height-chars
     2216           ,input true
     2217           ) .
     2218         assign
     2219           v-diasize-need-maximize = true
     2220         .
     2221       end.
     2222     end.
     2223   end procedure.
     2224   procedure diasize_restore-orig-size :
     2225     do
     2226     on error undo, return error return-value
     2227     :
     2228       assign
     2229         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2230         v-diasize-current-frame-height = frame Dialog-Frame :height
     2231       .
     2232       run diasize_set-height in this-procedure
     2233         (input  v-diasize-orig-frame-height
     2234         ,input  true
     2235         ) .
     2236       run diasize_set-width in this-procedure
     2237         (input  v-diasize-orig-frame-width
     2238         ,input  true
     2239         ) .
     2240     end.
     2241   end procedure.
     2242   procedure diasize_restore-current-size :
     2243     do
     2244     on error undo, return error return-value
     2245     :
     2246       run diasize_set-height in this-procedure
     2247         (input  v-diasize-current-frame-height
     2248         ,input  true
     2249         ) .
     2250       run diasize_set-width in this-procedure
     2251         (input  v-diasize-current-frame-width
     2252         ,input  true
     2253         ) .
     2254     end.
     2255   end procedure.
     2256   procedure diasize_set-browse-handle :
     2257     define input  parameter p-browse-handle as handle   no-undo .
     2258     define buffer buf_temp-browse-handle for temp-browse-handle .
     2259     do
     2260     on error undo, return error return-value
     2261     :
     2262       assign
     2263         v-diasize-browse-handle = p-browse-handle
     2264       .
     2265       for each buf_temp-browse-handle
     2266       on error undo, return error return-value
     2267       :
     2268         delete buf_temp-browse-handle .
     2269       end.
     2270     end.
     2271   end procedure.
     2272   procedure diasize_add_browse :
     2273     define input  parameter p-browse-type   as character no-undo .
     2274     define input  parameter p-browse-handle as handle    no-undo .
     2275     define buffer buf_temp-browse-handle for temp-browse-handle .
     2276     do
     2277     on error undo, return error return-value
     2278     :
     2279       assign
     2280         v-diasize-browse-number = v-diasize-browse-number + 1
     2281       .
     2282       create buf_temp-browse-handle .
     2283       assign
     2284         buf_temp-browse-handle.browse-type   = p-browse-type
     2285         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2286         buf_temp-browse-handle.browse-handle = p-browse-handle
     2287       .
     2288     end.
     2289   end procedure.
     2290   procedure diasize_init :
     2291     define variable v-default-value    as logical   no-undo .
     2292     define variable v-restore-saved    as logical   no-undo .
     2293     define variable v-resize-value-str as character no-undo .
     2294     do
     2295     on error undo, return error return-value
     2296     :
     2297       do with frame Dialog-Frame
     2298       :
     2299         assign
     2300           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2301           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2302           v-diasize-browse-handle     = browse br-dis-cp-rule :handle
     2303         .
     2304         create button v-diasize-resize-button
     2305         assign
     2306           parent        = frame Dialog-Frame :first-child
     2307           label         = "s"
     2308           height-pixels = 16
     2309           width-pixels  = 16
     2310           visible       = true
     2311           sensitive     = true
     2312           movable       = true
     2313           triggers:
     2314             on end-move persistent run diasize_end-move in this-procedure .
     2315           end triggers.
     2316         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2317         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2318         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2319         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2320         assign
     2321           v-diasize-wndmax = false
     2322         .
     2323         if connected("ub") = true
     2324         then do:
     2325           define variable v-cntxt-db-num        as integer   no-undo .
     2326           define variable v-cntxt-userid        as character no-undo .
     2327           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2328                                             , OUTPUT v-cntxt-userid
     2329                                             ) .
     2330           run gbl/wndpar_r.p
     2331             (input  v-cntxt-db-num
     2332             ,input  v-cntxt-userid
     2333             ,input  'wndmax':U
     2334             ,output v-diasize-wndmax
     2335             ,output v-default-value
     2336             ) .
     2337         end.
     2338         assign
     2339           v-diasize-wndstore = false
     2340         .
     2341         if connected("ub") = true
     2342         then do:
     2343           run gbl/wndpar_r.p
     2344             (input  v-cntxt-db-num
     2345             ,input  v-cntxt-userid
     2346             ,input  'wndstore':U
     2347             ,output v-diasize-wndstore
     2348             ,output v-default-value
     2349             ) .
     2350         end.
     2351         assign
     2352           v-diasize-proc-name = entry(1, program-name(2), '.')
     2353         .
     2354         if v-diasize-wndstore = true
     2355         then do:
     2356           assign
     2357             v-restore-saved = false
     2358           .
     2359           if connected("ub") = true
     2360           then do:
     2361             run gbl/wndsizer.p
     2362               (input  v-cntxt-db-num
     2363               ,input  v-cntxt-userid
     2364               ,input  v-diasize-proc-name
     2365               ,input  'height':u
     2366               ,output v-resize-value-str
     2367               ) .
     2368             if v-resize-value-str <> '':U
     2369             then do:
     2370               run diasize_change-height in this-procedure
     2371                 (input  integer(v-resize-value-str)
     2372                 ,input  true
     2373                 ) .
     2374               assign
     2375                 v-restore-saved = true
     2376               .
     2377             end.
     2378           end.
     2379           if connected("ub") = true
     2380           then do:
     2381             run gbl/wndsizer.p
     2382               (input  v-cntxt-db-num
     2383               ,input  v-cntxt-userid
     2384               ,input  v-diasize-proc-name
     2385               ,input  'width':u
     2386               ,output v-resize-value-str
     2387               ) .
     2388             if v-resize-value-str <> '':U
     2389             then do:
     2390               run diasize_change-width in this-procedure
     2391                 (input  integer(v-resize-value-str)
     2392                 ,input  true
     2393                 ) .
     2394               assign
     2395                 v-restore-saved = true
     2396               .
     2397             end.
     2398           end.
     2399           if v-restore-saved <> true
     2400           then do:
     2401             if v-diasize-wndmax = true
     2402             then do:
     2403               run diasize_maximize in this-procedure
     2404                 (input  true
     2405                 ) .
     2406             end.
     2407           end.
     2408         end.
     2409         else do:
     2410           if v-diasize-wndmax = true
     2411           then do:
     2412             run diasize_maximize in this-procedure
     2413               (input  true
     2414               ) .
     2415           end.
     2416         end.
     2417       end.
     2418     end.
     2419   end procedure.
     2420   procedure diasize_need-full-display :
     2421     define output parameter p-need-full-display as logical   no-undo .
     2422     do
     2423     on error undo, return error return-value
     2424     :
     2425       assign
     2426         p-need-full-display = v-diasize-need-full-display
     2427       .
     2428       assign
     2429         v-diasize-need-full-display = false
     2430       .
     2431     end.
     2432   end procedure.
     2433   procedure get-context :
     2434      define output parameter p-db-num as integer          no-undo.
     2435      define output parameter p-user-id as character        no-undo.
     2436      define variable v-login               as character    no-undo.
     2437      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2438      define buffer buf_user-login  for ub.user-login .
     2439      do
     2440      on error undo, return error
     2441      :
     2442            FIND FIRST buf_sys-ctrl no-lock.
     2443            ASSIGN
     2444               v-login = USERID("ub")
     2445               p-db-num = buf_sys-ctrl.db-num
     2446            .
     2447            FIND FIRST buf_user-login
     2448                 WHERE buf_user-login.db-num = p-db-num
     2449                   AND buf_user-login.user-login = v-login
     2450                 no-lock
     2451                 no-error
     2452                 .
     2453            IF AVAILABLE buf_user-login
     2454            THEN DO:
     2455               assign
     2456                  p-user-id = buf_user-login.user-id
     2457               .
     2458            END.
     2459      end.
     2460   end procedure.
     2461   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2462   on f5 of frame Dialog-Frame anywhere
     2463   do:
     2464      v-doc-rec = recid(X_dis-cp-rule).  Run OpenBR in this-procedure ( input yes, input no, input '':U).  REPOSITION br-dis-cp-rule to recid v-doc-rec No-ERROR.               apply 'value-changed' to br-dis-cp-rule.
     2465       apply "VALUE-CHANGED" to BR-dis-cp-rule.
     2466   end.
     2467   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2468   on F9 of frame Dialog-Frame anywhere do:
     2469     if not available ub.goods then
     2470       return no-apply.
     2471     gds-rec = recid (ub.goods).
     2472     run ref/gds-form.w ( input parparentproc
     2473                         ,input 'ПРОСМОТР':U
     2474                         ,input ?
     2475                         ,input ?
     2476                         ,input ?
     2477                         ,input-output gds-rec).
     2478     apply "entry" to br-dis-cp-rule in frame Dialog-Frame.
     2479     return no-apply.
     2480   end.
     2481   on SHIFT-F9 of frame Dialog-Frame anywhere do:
     2482     if not available X_cash-pay then
     2483       return no-apply.
     2484     gds-rec = recid (X_cash-pay).
     2485     run ref/gds-form.w ( input parparentproc
     2486                         ,input 'ПРОСМОТР':U
     2487                         ,input ?
     2488                         ,input ?
     2489                         ,input ?
     2490                         ,input-output gds-rec).
     2491     apply "entry" to br-dis-cp-rule in frame Dialog-Frame.
     2492     return no-apply.
     2493   end.
     2494   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2495   procedure set-filter-name :
     2496   define input parameter p-filter-name as character no-undo .
     2497     do with frame Dialog-Frame:
     2498       if p-filter-name > "" then do:
     2499         assign
     2500           frame Dialog-Frame:title
     2501             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2502         .
     2503         assign
     2504           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2505         .
     2506       end.
     2507       else do:
     2508         assign
     2509           b-sch :tooltip = ""
     2510         .
     2511       end.
     2512     end.
     2513   end procedure.
     2514   def var sort-labelbr-dis-cp-rule   as character no-undo .
     2515   def var sort-clmnbr-dis-cp-rule    as handle    no-undo .
     2516   def var cur-clmnbr-dis-cp-rule     as handle    no-undo .
     2517   def var cur-clmn-locbr-dis-cp-rule as integer   no-undo .
     2518   def var re-querybr-dis-cp-rule     as logical   initial no no-undo .
     2519   on start-search, ctrl-o of br-dis-cp-rule in frame Dialog-Frame do:
     2520      run sort-brbr-dis-cp-rule
     2521        (input (if available X_dis-cp-rule
     2522                then recid(X_dis-cp-rule)
     2523                else ?
     2524               )
     2525        ).
     2526   end.
     2527   PROCEDURE sort-brbr-dis-cp-rule :
     2528     define input parameter p-recid as recid no-undo .
     2529     if re-querybr-dis-cp-rule = no then do:
     2530       assign
     2531          cur-clmnbr-dis-cp-rule = br-dis-cp-rule:current-column in frame Dialog-Frame
     2532       .
     2533       if sort-clmnbr-dis-cp-rule <> ? then sort-clmnbr-dis-cp-rule:column-fgcolor = 0.
     2534       if cur-clmnbr-dis-cp-rule = sort-clmnbr-dis-cp-rule then do:
     2535         assign
     2536            sort-labelbr-dis-cp-rule = ""
     2537            sort-clmnbr-dis-cp-rule = ?
     2538         .
     2539        end.
     2540        else do:
     2541          assign
     2542            sort-labelbr-dis-cp-rule = cur-clmnbr-dis-cp-rule:label
     2543            sort-clmnbr-dis-cp-rule  = cur-clmnbr-dis-cp-rule
     2544            sort-clmnbr-dis-cp-rule:column-fgcolor = 4
     2545          .
     2546        end.
     2547      end.
     2548     assign
     2549       cur-clmn-locbr-dis-cp-rule = 1
     2550     .
     2551     def var column-handle as handle no-undo .
     2552     column-handle = br-dis-cp-rule:first-column.
     2553     do while valid-handle(column-handle) :
     2554       if column-handle = cur-clmnbr-dis-cp-rule then do:
     2555         leave .
     2556       end.
     2557       column-handle = column-handle:NEXT-COLUMN.
     2558       assign
     2559         cur-clmn-locbr-dis-cp-rule = cur-clmn-locbr-dis-cp-rule + 1
     2560       .
     2561     end.
     2562     case sort-labelbr-dis-cp-rule:
     2563           when '*'  then DO:   assign     sort-column-name = "mark-string(recid(X_dis-cp-rule), v-rid-list)"   .   run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2564           when 'Код платежа'  then DO:   assign     sort-column-name = "X_cash-pay.cdpay-code"   .   run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2565           when 'Код валюты'  then DO:   assign     sort-column-name = "X_cash-pay.curr-code"   .   run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2566           when 'Тип правила'  then DO:   assign     sort-column-name = "X_dis-cp-rule.templ-rl-root"   .   run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2567           when 'Место использ.'  then DO:   assign     sort-column-name = "entry (lookup (X_dis-cp-rule.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)"   .   run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2568           when 'Тип объ'  then DO:   assign     sort-column-name = "X_dis-cp-rule.obj-type"   .   run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2569           when 'Код объ'  then DO:   assign     sort-column-name = "X_dis-cp-rule.obj-code"   .   run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2570           when 'Тип скидки'  then DO:   assign     sort-column-name = "entry (lookup (X_dis-cp-rule.discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u)"   .   run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2571           when '№ правила'  then DO:   assign     sort-column-name = "X_dis-cp-rule.rule-num"   .   run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2572           when '№ корн.!правила'  then DO:   assign     sort-column-name = "X_dis-cp-rule.rl-root"   .   run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2573       otherwise do:
     2574         assign
     2575           sort-column-name = ""
     2576         .
     2577         run OpenBr in this-procedure ( input yes, input no, input no).
     2578         if sort-labelbr-dis-cp-rule <> "" then do:
     2579           assign
     2580             cur-clmnbr-dis-cp-rule:column-fgcolor = 0
     2581           .
     2582         end.
     2583         assign
     2584           cur-clmn-locbr-dis-cp-rule = ?
     2585         .
     2586       end.
     2587     end case.
     2588     if p-recid <> ? then do:
     2589       reposition br-dis-cp-rule to recid p-recid no-error.
     2590       apply "value-changed" to br-dis-cp-rule in frame Dialog-Frame.
     2591     end.
     2592     apply "entry" to br-dis-cp-rule in frame Dialog-Frame.
     2593   END PROCEDURE.
     2594   procedure re-open-query-srt-clmnbr-dis-cp-rule:
     2595   if cur-clmnbr-dis-cp-rule = ? then do:
     2596      run OpenBr in this-procedure ( input yes, input no, input no).
     2597   end.
     2598   else do:
     2599      assign re-querybr-dis-cp-rule = yes.
     2600      run sort-brbr-dis-cp-rule
     2601        (input (if available X_dis-cp-rule
     2602                then recid(X_dis-cp-rule)
     2603                else ?
     2604               )
     2605        ).
     2606      assign re-querybr-dis-cp-rule = no.
     2607   end.
     2608   end.
     2609   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2610   do:
     2611     BR-dis-cp-rule :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2612   end.
     2613   MAIN-BLOCK:
     2614   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2615      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2616   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2617     run mainmenu_getcntxt in parparentproc
     2618       (output v-cntxt-db-num
     2619       ,output v-cntxt-userid
     2620       ,output v-cntxt-level
     2621       ,output v-cntxt-host-code-obj
     2622       ,output v-cntxt-obj-type
     2623       ,output v-cntxt-obj-code
     2624       ,output v-cntxt-db-num-obj
     2625       ,output v-cntxt-is-admin
     2626       ) .
     2627     IF lookup(p-list-mode, ('все':U + chr(4) +
     2628                             "pos" + chr(4) +
     2629                             "templ-rl-root" + chr(4) +
     2630                             "discnt-role" + chr(4) +
     2631                             'объект':U + chr(4) +
     2632                             ('объект':U + chr(44) + "pos-type":U) + chr(4) +
     2633                             ('объект':U + chr(44) + "templ-rl-root":U) + chr(4) +
     2634                             ('объект':U + chr(44) + "discnt-role":U) + chr(4) +
     2635                             "rule-num":U + chr(4) +
     2636                             "rl-root") , chr(4)) = 0
     2637     THEN DO:
     2638        MESSAGE
     2639        vss-workfile vss-revision vss-description skip
     2640        "Неверный параметр вызова p-list-mode " p-list-mode
     2641        VIEW-AS ALERT-BOX ERROR.
     2642        UNDO, RETURN ERROR.
     2643     END.
     2644     IF lookup('объект':U , p-list-mode) > 0 THEN DO:
     2645       IF p-curr-obj-type <> 'скл':U
     2646       AND p-curr-obj-type <> 'маг':U THEN DO:
     2647           MESSAGE
     2648           vss-workfile vss-revision vss-description skip
     2649           "Неверный параметр вызова p-curr-obj-type " p-curr-obj-type
     2650           VIEW-AS ALERT-BOX ERROR.
     2651           UNDO, RETURN ERROR.
     2652       END.
     2653       FIND FIRST X_clients-obj NO-LOCK WHERE
     2654                 X_clients-obj.obj-type = p-curr-obj-type
     2655            AND  X_clients-obj.obj-code = p-curr-obj-code NO-ERROR.
     2656       IF NOT AVAILABLE X_clients-obj THEN DO:
     2657           MESSAGE
     2658           vss-workfile vss-revision vss-description skip
     2659           "Неверные параметры вызова p-curr-obj-type p-curr-obj-code" p-curr-obj-type p-curr-obj-code
     2660           VIEW-AS ALERT-BOX ERROR.
     2661           UNDO, RETURN ERROR.
     2662       END.
     2663     end.
     2664     IF LOOKUP( "templ-rl-root", p-list-mode) > 0 THEN DO:
     2665         FIND FIRST PAR_dis-rule NO-LOCK WHERE
     2666                   par_dis-rule.rule-num = p-templ-rl-root no-error.
     2667         IF NOT AVAILABLE par_Dis-rule THEN DO:
     2668             MESSAGE
     2669             vss-workfile vss-revision vss-description skip
     2670             "Неверный параметр вызова p-templ-rl-root" p-templ-rl-root
     2671             VIEW-AS ALERT-BOX ERROR.
     2672             UNDO, RETURN ERROR.
     2673         END.
     2674     END.
     2675     IF LOOKUP( "pos-type", p-list-mode) > 0
     2676     AND lookup(p-pos-type, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA':U) = 0  THEN DO:
     2677         MESSAGE
     2678         vss-workfile vss-revision vss-description skip
     2679         "Неверный параметр вызова p-pos-type" p-pos-type
     2680         VIEW-AS ALERT-BOX ERROR.
     2681         UNDO, RETURN ERROR.
     2682     END.
     2683     IF LOOKUP( "discnt-role", p-list-mode) > 0 THEN DO:
     2684       FIND FIRST par_dis-cfg-rule NO-LOCK WHERE
     2685                 par_dis-cfg-rule.discnt-role = p-discnt-role
     2686             AND par_dis-cfg-rule.TABLE-name = 'dis-cp-rule':U NO-ERROR.
     2687       IF NOT AVAILABLE par_dis-cfg-rule  THEN DO:
     2688         MESSAGE
     2689         vss-workfile vss-revision vss-description skip
     2690         "Неверный параметр вызова p-discnt-role" p-discnt-role
     2691         VIEW-AS ALERT-BOX ERROR.
     2692         UNDO, RETURN ERROR.
     2693       END.
     2694     END.
     2695     v-rid-list = p-rid-list.
     2696     RUN Myenable IN THIS-PROCEDURE NO-ERROR.
     2697     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2698     WAIT-FOR GO OF FRAME Dialog-Frame.
     2699   END.
     2700   RUN disable_UI.
     2701   PROCEDURE disable_UI :
     2702     HIDE FRAME Dialog-Frame.
     2703   END PROCEDURE.
     2704   PROCEDURE enable_UI :
     2705     DISPLAY mark-num
     2706         WITH FRAME Dialog-Frame.
     2707     ENABLE b-quit B-mark B-sel B-type b-dis-rule B-sch B-print b-history B-Help
     2708            BR-dis-cp-rule mark-num
     2709         WITH FRAME Dialog-Frame.
     2710     VIEW FRAME Dialog-Frame.
     2711     OPEN QUERY BR-dis-cp-rule FOR EACH X_dis-cp-rule NO-LOCK ,            FIRST X_cash-pay NO-LOCK WHERE           X_cash-pay.curr-code = X_dis-cp-rule.curr-code        AND X_cash-pay.cdpay-code = X_dis-cp-rule.cdpay-code INDEXED-REPOSITION.
     2712   END PROCEDURE.
     2713   PROCEDURE MyEnable :
     2714   define variable v-h as handle no-undo .
     2715   define variable v-ii as integer no-undo .
     2716   v-h = BR-dis-cp-rule:FIRST-COLUMN IN FRAME Dialog-Frame.
     2717   DO while valid-handle(v-h)
     2718   and  v-ii < br-dis-cp-rule:num-COLUMNs IN FRAME Dialog-Frame:
     2719     v-ii = v-ii + 1.
     2720     if v-h:LABEL = 'Место использ.'
     2721     or v-h:LABEL = 'Тип скидки'
     2722     then do:
     2723       v-h:RESIZABLE = YES.
     2724     end.
     2725     ELSE DO:
     2726       v-h = v-h:NEXT-COLUMN.
     2727     END.
     2728   END.
     2729   DISPLAY
     2730   mark-num
     2731   WITH FRAME Dialog-Frame.
     2732   ENABLE
     2733   b-quit
     2734   B-mark WHEN LOOKUP("b-mark", bttn) > 0
     2735   B-sel WHEN LOOKUP("b-mark", bttn) > 0
     2736   b-type
     2737   b-dis-rule
     2738   B-sch
     2739   B-print
     2740   b-history
     2741   B-Help
     2742   BR-dis-cp-rule
     2743   WITH FRAME Dialog-Frame.
     2744   VIEW FRAME Dialog-Frame.
     2745   RUn Openbr in this-procedure ( input yes, input no, input '':U).
     2746   END PROCEDURE.
     2747   PROCEDURE OpenBr :
     2748   define input  parameter p-open-query     as logical   no-undo .
     2749   define input  parameter p-find-next      as logical   no-undo .
     2750   define input  parameter p-find-condition as character no-undo .
     2751   define variable l-query-was-opened as logical no-undo .
     2752   define variable title0 as character no-undo init "Скидки на типы кассовых платежей".
     2753   define variable p-host-code like ub.sysconf.host-code no-undo .
     2754   run waitfram-show in this-procedure ( input "Ждите...").
     2755   define variable sort-column-phrase as character no-undo .
     2756   case sort-column-name :
     2757     when "" then do:
     2758       assign
     2759         sort-column-phrase = ""
     2760       .
     2761     end.
     2762     otherwise do:
     2763       assign
     2764         sort-column-phrase = "by " + sort-column-name
     2765       .
     2766     end.
     2767   end case.
     2768   if not( p-curr-obj-type = "":U and p-curr-obj-code = 0 ) then do:
     2769   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2770   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2771     (input  p-curr-obj-type
     2772     ,input  p-curr-obj-code
     2773     ,output p-host-code
     2774     )  .
     2775   end.
     2776   define variable l-open-query as logical   no-undo .
     2777   filter-point = filter-point0 + p-list-mode.
     2778   CASE p-list-mode :
     2779     WHEN 'все':U        THEN DO:
     2780       ASSIGN
     2781       frame Dialog-Frame:TITLE =
     2782                                     substitute("&1"
     2783                                     , title0
     2784                                     )
     2785      filter-label = substitute("&1", filter-label0)
     2786                                     .
     2787   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2788   define variable  l-disable-where-21  as logical   no-undo .
