     2794   define variable  where-phrase-rus-21 as character no-undo .
     2795   define variable  sort-phrase-rus-21  as character no-undo .
     2796     run waitfram-show in this-procedure
     2797       (input "ЖДИТЕ ..."
     2798       ).
     2799   run gbl/flt-get.p
     2800     (input filter-point
     2801     ,output flt-rec-21
     2802     ,output filter-name-21
     2803     ,output where-phrase-21
     2804     ,output sort-phrase-21
     2805     ,output where-phrase-rus-21
     2806     ,output sort-phrase-rus-21
     2807     ).
     2808   if p-open-query then do:
     2809       run set-filter-name in this-procedure
     2810         (INPUT filter-name-21
     2811         ) no-error .
     2812     assign
     2813       l-filter-open-21 = false
     2814     .
     2815     if flt-rec-21 <> ?
     2816       or sort-column-phrase > ""
     2817     then do:
     2818       define variable  parameter-2-21 as character no-undo .
     2819       define variable  parameter-3-21 as character no-undo .
     2820       define variable  parameter-4-21 as character no-undo .
     2821       define variable  parameter-5-21 as character no-undo .
     2822       define variable  parameter-6-21 as character no-undo .
     2823       define variable  parameter-7-21 as character no-undo .
     2824         assign
     2825         parameter-3-21 =
     2826                                 "FOR EACH X_dis-cp-rule"
     2827         parameter-4-21 =
     2828           (
     2829             if (" TRUE " + " " + where-phrase-21) <> ""
     2830             then " TRUE " + " " + where-phrase-21
     2831             else "true"
     2832           )
     2833         parameter-5-21 = (" " + "" + " " + ", FIRST X_cash-pay no-lock where X_cash-pay.curr-code = X_dis-cp-rule.curr-code and                                                                      X_cash-pay.cdpay-code = X_dis-cp-rule.cdpay-code")
     2834         parameter-6-21 = if sort-phrase-21 = ''
