     2838             " " + sort-column-phrase +
     2839           " " + "  "
     2840           )
     2841                              else
     2842           (
     2843           " " + "  " +
     2844             " " + sort-column-phrase +
     2845           " " + sort-phrase-21
     2846           )
     2847         parameter-7-21 =
     2848           " indexed-reposition  "
     2849       .
     2850       do
     2851       on stop undo, leave
     2852       on error undo, leave
     2853       :
     2854         assign
     2855           l-disable-where-21 =
     2856             (" TRUE " + " " + where-phrase-21 = "")
     2857         .
