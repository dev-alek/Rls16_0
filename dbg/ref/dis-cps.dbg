     4729                             ,input parameter-7-39
     4730                             ,output v-fltopend-rowid
     4731                             ) no-error.
     4732         .
     4733         v-doc-rec = ?.
     4734       end.
     4735       assign
     4736         l-query-was-opened = true
     4737       .
     4738     end.
     4739   end.
     4740     run waitfram-hide in this-procedure .
     4741     END.
     4742   END CASE.
     4743   if not p-open-query then
     4744   REPOSITION br-dis-cp-rule to recid v-doc-rec No-ERROR.
     4745   if not p-open-query and v-fltopend-rowid[1] <> ? then
     4746   query br-dis-cp-rule:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     4747   if error-status:error then do:
     4748     REPOSITION br-dis-cp-rule to row 1 No-ERROR.
     4749   end.
     4750   run waitfram-hide in this-procedure.
     4751   APPLY "VALUE-CHANGED" TO br-dis-cp-rule in frame Dialog-Frame.
     4752   APPLY "ENTRY" TO br-dis-cp-rule.
     4753   END PROCEDURE.
     4754   PROCEDURE proc-b-mark :
     4755   define variable loc#log as logical no-undo .
     4756   if available X_dis-cp-rule then do:
     4757   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4758   define variable v-str-recid41 as character no-undo .
     4759   define variable v-num-entry41 as integer   no-undo .
     4760   assign
     4761     v-str-recid41 = trim( string( recid( X_dis-cp-rule ) , "->>>>>>>>>>>9":U ) )
     4762     v-num-entry41 = lookup( v-str-recid41 , v-rid-list )
     4763   .
     4764   if v-num-entry41 > 0 then do:
     4765     assign
     4766       entry( v-num-entry41, v-rid-list ) = "":U
     4767       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     4768     .
     4769   end.
     4770   else do:
     4771     assign
     4772       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid41
     4773     .
     4774   end.
     4775     loc#log = br-dis-cp-rule:refresh() IN FRAME Dialog-Frame .
     4776     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     4777         loc#log = br-dis-cp-rule:select-next-row ().
     4778         apply "VALUE-CHANGED" to br-dis-cp-rule in frame Dialog-Frame.
     4779     end.
     4780     if num-entries( v-rid-list ) = 0
     4781     then
     4782         hide mark-num in frame Dialog-Frame.
     4783     else
     4784         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     4785   end.
     4786   apply "entry" to br-dis-cp-rule in frame Dialog-Frame.
     4787   END PROCEDURE.
     4788   PROCEDURE proc-b-print :
     4789   define variable Line                as char         no-undo.
     4790   define variable v-rec as recid no-undo .
     4791   define variable ii as integer no-undo .
     4792   define variable v-mark as character no-undo .
     4793   define variable v-d-name as character no-undo .
     4794   define variable v-pos-type as character no-undo .
     4795   Line = fill( "-" , 140 ) .
     4796   define frame list
     4797   v-mark COLUMN-LABEL '*' FORMAT "X(1)"
     4798   X_cash-pay.cdpay-code COLUMN-LABEL 'Код платежа' FORMAT ">>>>9"
     4799   X_cash-pay.curr-code COLUMN-LABEL 'Код валюты'
     4800   X_dis-cp-rule.templ-rl-root COLUMN-LABEL 'Тип правила' FORMAT ">>>>>>>>9"
     4801   v-pos-type COLUMN-LABEL 'Место использ.' FORMAT "X(20)"
     4802   X_dis-cp-rule.obj-type COLUMN-LABEL 'Тип объ' FORMAT "X(3)"
     4803   X_dis-cp-rule.obj-code COLUMN-LABEL 'Код объ' FORMAT ">>>>>>>>9"
     4804   v-d-name COLUMN-LABEL 'Тип скидки' FORMAT "X(20)"
     4805   X_dis-cp-rule.rule-num COLUMN-LABEL '№ правила' FORMAT ">>>>>>>>9"
     4806   X_dis-cp-rule.rl-root COLUMN-LABEL '№ корн.!правила' FORMAT ">>>>>>>>9"
     4807   HEADER
     4808   cur-time-print() AT 5 format "X(35)"
     4809   string( "Страница " + string( PAGE-NUMBER( PrnLibStream ) , ">>9") )
     4810   AT 86 format "X(15)" SKIP
     4811   Line format "x(130)" AT 1
     4812   with width 235 down use-text stream-io no-box .
     4813   v-rec = recid(X_dis-cp-rule).
     4814   DO WHILE available X_dis-cp-rule :
     4815     GET prev br-dis-cp-rule NO-LOCK .
     4816   END.
     4817   GET next br-dis-cp-rule NO-LOCK .
     4818   run prn-lib-open-stream  in this-procedure (
     4819                                                input parParentProc
     4820                                               ,input 43
     4821                                               ,input yes
     4822                                               ,input no
     4823                                               ).
     4824   FORM HEADER
     4825   Line format "X(130)" SKIP
     4826   "Продолжение - на следующей странице" AT 30 SKIP
     4827   with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS no-box.
     4828   VIEW stream PrnLibStream FRAME CliBottomFrame .
     4829   PUT stream PrnLibStream space(30)
     4830   frame Dialog-Frame:title format "X(100)" SKIP(2) .
     4831   FORM with frame List .
     4832   DO WHILE available X_dis-cp-rule :
     4833     DISPLAY stream PrnLibStream
     4834     mark-string(recid(X_dis-cp-rule), v-rid-list) @ v-mark
     4835     X_cash-pay.cdpay-code
     4836     X_cash-pay.curr-code
     4837     X_dis-cp-rule.templ-rl-root
     4838     entry (lookup (X_dis-cp-rule.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U) @ v-pos-type
     4839     X_dis-cp-rule.obj-type
     4840     X_dis-cp-rule.obj-code
     4841     entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u) @ v-d-name
     4842     X_dis-cp-rule.rule-num
     4843     X_dis-cp-rule.rl-root
     4844     with frame List .
     4845     DOWN stream PrnLibStream 1 with frame List .
     4846     ii =  ii + 1 .
     4847     if ( ( ii modulo 10 ) = 0 ) AND ( ii >= 10 ) then
     4848     run waitfram-show in this-procedure ( input ("Просмотрено строк : " + string( ii )) ) .
     4849     GET next br-dis-cp-rule .
     4850   END.
     4851   run waitfram-hide in this-procedure .
     4852   PUT stream PrnLibStream Line format "X(130)" SKIP.
     4853   HIDE stream PrnLibStream FRAME BottomFrame .
     4854   output stream PrnLibStream close .
     4855   run prn-lib-prn-file in this-procedure (
     4856                                             input parParentProc
     4857                                             ,input 0
     4858                                             ).
     4859   reposition br-dis-cp-rule to recid v-rec no-error.
     4860   if error-status:error then do:
     4861     reposition br-dis-cp-rule to row 1 no-error.
     4862   end.
     4863   APPLy "ENTRY" to br-dis-cp-rule.
     4864   END PROCEDURE.
     4865   PROCEDURE proc-b-sch :
     4866   assign
     4867     tbl = 'dis-cp-rule'
     4868     join-tbl = 'X_dis-cp-rule'
     4869     fld = ""
     4870     lab = ""
     4871     spr = ""
     4872     dim = '0'
     4873     .
     4874     run fltfield-add in this-procedure('templ-rl-root', 'Номер типа(шаблона) правила', '',
     4875     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4876     run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', 'cli',
     4877     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4878     run fltfield-add in this-procedure('rule-num', '№ правила', '',
     4879     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4880     run fltfield-add in this-procedure('rl-root', '№ корн.правила', '',
     4881     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4882     run fltfield-add in this-procedure('pos-type', 'Место использ.', 'cd-types-discnt',
     4883     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4884     run fltfield-add in this-procedure('discnt-role', 'Тип скидки', '',
     4885     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4886     run fltfield-add in this-procedure('cdpay-code', 'Код платежа', '',
     4887     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4888     run fltfield-add in this-procedure('curr-code', 'Код валюты', '',
     4889     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4890   Filter-Block:
     4891   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4892       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4893       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4894     run gbl/filter.w ( INPUT parparentproc
     4895                        ,INPUT filter-point + chr(4) + filter-label
     4896                        ,INPUT tbl
     4897                        ,INPUT join-tbl
     4898                        ,INPUT fld
     4899                        ,INPUT lab
     4900                        ,INPUT spr
     4901                        ,INPUT dim ).
     4902     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     4903   END.
     4904   END PROCEDURE.
