        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-node-code like ub.gds-prt.node-code no-undo .
        4   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   def var vss-author      as character no-undo init "$Author: expertek $":U .
        6   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   def var vss-workfile    as character no-undo init "$Workfile: gdsprtpv.p $":U .
        8   def var vss-archive     as character no-undo init "$Archive: ref/gdsprtpv.p $":U .
        9   def var vss-description as character no-undo init "Печать шкалы".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   DEFINE VARIABLE line as character no-undo .
       65   DEFINE VARIABLE date_string as character no-undo .
       66   DEFINE VARIABLE v-found as logical no-undo .
       67   define variable v-node-code like ub.gds-prt.node-code no-undo.
       68   define variable v-lvl-num like ub.gds-prt.lvl-num no-undo.
       69   DEFINE VARIABLE lvl as character no-undo extent 10.
       70   DEFINE VARIABLE lvl-name as character no-undo extent 10.
       71   DEFINE VARIABLE v-current-page as integer no-undo .
       72   DEFINE VARIABLE v-first-page as logical no-undo init yes.
       73   define buffer buf_gds-prt for ub.gds-prt .
       74   define buffer upper_gds-prt for ub.gds-prt .
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define new global shared variable g#library  as handle no-undo .
       80   define new global shared variable g#library2 as handle no-undo .
       81   define   shared variable g#auto as logical no-undo.
       82   define   shared variable g#news as logical no-undo.
       83   define   shared variable g#oxml as logical no-undo.
       84   define   shared variable g#esys as logical no-undo.
       85   define   shared variable g#news-source-db as integer no-undo.
       86   define   shared variable g#esys-source-esys as integer no-undo.
       87   define   shared variable g#db-num as integer   no-undo .
       88   define   shared variable g#userid as character no-undo .
       89   define   shared variable g#passwd as character no-undo .
       90   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   procedure cur-time :
       92      define output parameter p-today as date      no-undo .
       93      define output parameter p-time  as integer   no-undo .
       94     do
       95     on error undo, return error
       96     :
       97       define variable v-date1 as date      no-undo .
       98       define variable v-date2 as date      no-undo .
       99       define variable v-time  as integer   no-undo .
      100       assign
      101         v-date1 = today
      102         v-time  = time
      103         v-date2 = today
      104       .
      105       if v-date1 <> v-date2
      106       then do:
      107         assign
      108           v-date1 = today
      109           v-time  = v-time
      110         .
      111       end.
      112       assign
      113         p-today = v-date1
      114         p-time  = v-time
      115       .
      116     end.
      117   end.
      118   function cur-time-date returns character
      119   :
      120     return string(today, '99/99/9999':U) .
      121   end.
      122   function cur-time-mjd returns decimal
      123   :
      124     define variable v-date as date      no-undo .
      125     define variable v-time as integer   no-undo .
      126     run cur-time in this-procedure
      127       (output v-date
      128       ,output v-time
      129       ) .
      130     return integer(v-date) - 2400002 + (v-time / 86400) .
      131   end.
      132   function cur-time-get-ending-index returns integer
      133   (input p-number as integer
      134   )
      135   :
      136     if p-number < 0
      137     or p-number = ?
      138     then do:
      139       return 1 .
      140     end.
      141     define variable v-rest as integer   no-undo .
      142     assign
      143       p-number = p-number modulo 100
      144     .
      145     if p-number < 20
      146     then do:
      147       assign
      148         v-rest = p-number
      149       .
      150     end.
      151     else do:
      152       assign
      153         v-rest = p-number modulo 10
      154       .
      155     end.
      156     case v-rest :
      157       when 1
      158       then do:
      159         return 2 .
      160       end.
      161       when 2 or
      162       when 3 or
      163       when 4
      164       then do:
      165         return 3 .
      166       end.
      167       otherwise do:
      168         return 1 .
      169       end.
      170     end case .
      171   end.
      172   procedure cur-time-mjd-to-date :
      173      define input  parameter i-mjd-diff as decimal no-undo.
      174      define output parameter o-Date     as date    no-undo.
      175      define output parameter o-Time     as integer no-undo.
      176      define variable v-day-number as integer   no-undo .
      177      if    i-mjd-diff < 0
      178         or i-mjd-diff = ?
      179      then do:
      180         return "?" .
      181      end.
      182      assign
      183         v-day-number = truncate(i-mjd-diff,0).
      184         o-Date = date(v-day-number + 2400002).
      185         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      186     .
      187   end.
      188   function cur-time-mjd-to-string returns character
      189   (input p-mjd-diff as decimal
      190   )
      191   :
      192     define variable v-day-number as integer   no-undo .
      193     define variable v-seconds    as integer   no-undo .
      194     define variable v-hour       as integer   no-undo .
      195     define variable v-min        as integer   no-undo .
      196     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      197     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      198     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      199     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      200     if p-mjd-diff < 0
      201     or p-mjd-diff = ?
      202     then do:
      203       return "?" .
      204     end.
      205     assign
      206       v-day-number = integer(truncate(p-mjd-diff,0))
      207       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      208     .
      209     if v-seconds > 86400
      210     then do:
      211       assign
      212         v-seconds = 86400 - 1
      213       .
      214     end.
      215     if v-seconds < 0
      216     then do:
      217       assign
      218         v-seconds = 0
      219       .
      220     end.
      221     assign
      222       v-hour = truncate(v-seconds / 3600, 0)
      223     .
      224     assign
      225       v-seconds = v-seconds modulo 3600
      226     .
      227     assign
      228       v-min = truncate(v-seconds / 60, 0)
      229     .
      230     assign
      231       v-seconds = v-seconds modulo 60
      232     .
      233     return
      234         (if v-day-number <> 0
      235           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      236           else ""
      237         )
      238       + (if v-day-number <> 0 or v-hour <> 0
      239           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      240           else ""
      241         )
      242       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      243           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      244           else ""
      245         )
      246       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      247       .
      248   end.
      249   function cur-time-string returns character
      250   :
      251     define variable v-date as date      no-undo .
      252     define variable v-time as integer   no-undo .
      253     run cur-time in this-procedure
      254       (output v-date
      255       ,output v-time
      256       ) .
      257     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      258   end.
      259   function cur-time-string-sec returns character
      260   :
      261     define variable v-date as date      no-undo .
      262     define variable v-time as integer   no-undo .
      263     run cur-time in this-procedure
      264       (output v-date
      265       ,output v-time
      266       ) .
      267     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      268   end.
      269   function cur-time-custom  returns character
      270   (input p-prefix as character
      271   ,input p-date-format as character
      272   ,input p-delimiter as character
      273   ,input p-time-format as character
      274   ,input p-suffix as character
      275   )
      276   :
      277     define variable v-date as date      no-undo .
      278     define variable v-time as integer   no-undo .
      279     run cur-time in this-procedure
      280       (output v-date
      281       ,output v-time
      282       ) .
      283     return
      284       p-prefix
      285       + string(v-date, p-date-format)
      286       + p-delimiter
      287       + string(v-time, p-time-format)
      288       + p-suffix
      289       .
      290   end.
      291   function cur-time-print  returns character
      292   :
      293     define variable v-date as date      no-undo .
      294     define variable v-time as integer   no-undo .
      295     run cur-time in this-procedure
      296       (output v-date
      297       ,output v-time
      298       ) .
      299     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      300   end.
      301   function cur-time-datetime returns datetime
      302   :
      303     define variable v-char as character no-undo .
      304     define variable v-datetime as datetime no-undo .
      305     v-char = cur-time-string().
      306     v-datetime = datetime(v-char).
      307     return  v-datetime.
      308   end.
      309   function cur-time-string-msec returns character
      310   :
      311     define variable v-date as datetime  no-undo .
      312     v-date = now.
      313     return string(v-date) .
      314   end.
      315   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      316   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      317   define new shared variable RepPathName        as character no-undo .
      318   define new shared variable PrintRubl          as logical   no-undo .
      319   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      320   define  stream PrnLibStream.
      321   procedure prn-lib-prn-file :
      322     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      323     define input parameter p-DIsabledoptions as integer no-undo .
      324     define variable v-report-name as character no-undo .
      325     define variable v-user-action as character no-undo .
      326     define variable v-printed     as logical   no-undo .
      327     define variable v-exist       as logical   no-undo .
      328     do
      329       on error undo, return error
      330       :
      331       run prn-lib-get-report-name  in this-procedure (
      332         input parParentProc
      333         ,output v-report-name
      334         ).
      335   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      336   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      337     (input  v-report-name
      338     ,input  2
      339     ,output v-exist
      340     )  .
      341       if NOT v-exist then
      342       DO:
      343         Message
      344           "Нет заданий на печать ! "
      345           view-as alert-box .
      346         Return  .
      347       End.
      348       run gbl/prnfilen.w
      349         (input  ""
      350         ,input  p-DisabledOptions
      351         ,input  string(v-report-name )
      352         ,input  7
      353         ,output v-user-action
      354         ,output v-printed
      355         ) .
      356       if v-printed then
      357       do:
      358         return "YES" .
      359       end.
      360       else
      361       do:
      362         return "NO" .
      363       end.
      364     end.
      365   end procedure.
      366   procedure prn-lib-open-stream :
      367     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      368     define input parameter p-page-size    as integer no-undo .
      369     define input parameter p-is-stream    as logical no-undo .
      370     define input parameter p-append       as logical no-undo .
      371     define variable v-report-name as character no-undo .
      372     do
      373       on error undo, return error
      374       :
      375       run prn-lib-get-report-name  in this-procedure (
      376         input parParentProc
      377         ,output v-report-name
      378         ).
      379       if p-is-stream then
      380       do:
      381         if p-append then
      382         do:
      383           output stream PrnLibStream to value( v-report-name )
      384             page-size value(p-page-size) append .
      385         end.
      386         if not p-append then
      387         do:
      388           output stream PrnLibStream to value( v-report-name )
      389             page-size value(p-page-size) .
      390         end.
      391       end.
      392       if not p-is-stream then
      393       do:
      394         if p-append then
      395         do:
      396           output to value( v-report-name )
      397             page-size value(p-page-size) append .
      398         end.
      399         if not p-append then
      400         do:
      401           output to value( v-report-name )
      402             page-size value(p-page-size) .
      403         end.
      404       end.
      405     end.
      406   end procedure.
      407   procedure prn-lib-open-exp :
      408     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      409     define input parameter p-is-stream    as logical no-undo .
      410     define input parameter p-is-append    as logical no-undo .
      411     define output parameter p-ReportFileName as char init "report" no-undo.
      412     define output parameter p-process as logical no-undo .
      413     define variable glog as logical no-undo .
      414     do
      415       on error undo, return error
      416       :
      417       SYSTEM-DIALOG GET-FILE p-ReportFileName
      418         TITLE      "Укажите путь"
      419         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      420         ASK-OVERWRITE
      421         CREATE-TEST-FILE
      422         SAVE-AS
      423         USE-FILENAME
      424         DEFAULT-EXTENSION "txt"
      425         UPDATE glog
      426         .
      427       if not glog then  return.
      428       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      429       if p-is-stream then
      430       do:
      431         if p-is-append then
      432         do:
      433           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      434         end.
      435         else
      436         do:
      437           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      438         end.
      439       end.
      440       else
      441       do:
      442         if p-is-append then
      443         do:
      444           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      445         end.
      446         else
      447         do:
      448           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      449         end.
      450       end.
      451       p-process = yes.
      452     end.
      453   end procedure.
      454   procedure prn-lib-get-report-name :
      455     define input parameter parParentProc  as widget-handle no-undo.
      456     define output parameter p-report-name as character no-undo .
      457     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      458   end procedure.
      459   procedure prn-lib-reportviewer-report-name :
      460     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      461     define input parameter p-report-name-html as character no-undo .
      462     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      463   end procedure.
      464   procedure prn-lib-reportviewer :
      465     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      466     define input parameter p-report-name-html as character no-undo .
      467     define input parameter p-param        as character no-undo .
      468     define variable v-excel           as character no-undo init 'TRUE' .
      469     define variable v-value-character as character no-undo .
      470     define variable v-value-integer   as character no-undo .
      471     define variable v-value-date      as date      no-undo .
      472     define variable v-value-decimal   as decimal   no-undo .
      473     define variable rep-excel         as logical   no-undo .
      474     define variable excel-string      as character no-undo .
      475     define variable v-param-type      as character no-undo .
      476     define variable v-tth             as handle    no-undo .
      477     run adm/shattri.p (
      478       input "get":U
      479       ,input  ""
      480       ,input  0
      481       ,input  'report-glob':U
      482       ,input  'rep-excel':U
      483       ,output v-value-character
      484       ,output v-value-date
      485       ,output v-value-decimal
      486       ,output v-value-integer
      487       ,output rep-excel
      488       ,output v-param-type
      489       ,INPUT-OUTPUT table-handle v-tth
      490       )  .
      491     if rep-excel then v-excel = "TRUE" .
      492     else v-excel = "FALSE" .
      493     if p-param eq ""
      494     then
      495        p-param = "EXCEL:" + v-excel.
      496     else
      497        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      498     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      499   end procedure.
      500   define temp-table tt-level no-undo
      501   FIELD level like ub.lvl-name.level
      502   FIELD lvl-name like ub.lvl-name.lvl-name
      503   index pi is primary unique
      504   level
      505   .
      506   define temp-table tt-prt no-undo
      507   FIELD node-code like ub.gds-prt.node-code
      508   FIELD node-name like ub.gds-prt.node-name
      509   FIELD level like ub.lvl-name.level
      510   FIELD line-num as integer
      511   index pi is PRIMARY UNIQUE
      512   level
      513   node-code
      514   index line is unique
      515   line-num level
      516   .
      517   DEFINE FRAME PRT-FRAME
      518   lvl[1]  column-label "Уровень 1" FORMAT "x(18)"       space(1)
      519   lvl[2]  column-label "Уровень 2" FORMAT "x(18)"       space(1)
      520   lvl[3]  column-label "Уровень 3" FORMAT "x(18)"       space(1)
      521   lvl[4]  column-label "Уровень 4" FORMAT "x(18)"       space(1)
      522   lvl[5]  column-label "Уровень 5" FORMAT "x(18)"       space(1)
      523   lvl[6]  column-label "Уровень 6" FORMAT "x(18)"       space(1)
      524   lvl[7]  column-label "Уровень 7" FORMAT "x(18)"       space(1)
      525   lvl[8]  column-label "Уровень 8" FORMAT "x(18)"       space(1)
      526   lvl[9]  column-label "Уровень 9" FORMAT "x(18)"       space(1)
      527   lvl[10]  column-label "Уровень 10" FORMAT "x(18)"       space(1)
      528   HEADER  date_string AT 5 format "X(35)"
      529   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
      530   Line format "X(198)" AT 1
      531   with width 232 down stream-io use-text NO-BOX.
      532   find first buf_gds-prt no-lock where
      533              buf_gds-prt.node-code = p-node-code no-error.
      534   if not available buf_gds-prt then do:
      535     message
      536     vss-workfile vss-revision vss-description skip
      537     "Не найден узел шкалы" skip
      538     "node-code" p-node-code
      539     view-as alert-box error .
      540     return error.
      541   end.
      542   if can-find(first upper_gds-prt no-lock where
      543                     upper_gds-prt.node-code = buf_gds-prt.upper-code) then do:
      544     message
      545     vss-workfile vss-revision vss-description skip
      546     "Узел шкалы не корневой"
      547     "node-code" p-node-code "upper-code" buf_gds-prt.upper-code
      548     view-as alert-box error .
      549     return error.
      550   end.
      551   do
      552   on error undo, return error
      553   :
      554     for each tt-level:
      555       delete tt-level.
      556     end.
      557     for each tt-prt:
      558       delete tt-prt.
      559     END.
      560     assign
      561     v-node-code = buf_gds-prt.node-code
      562     v-lvl-num = 1
      563     v-found = yes
      564     .
      565     do while v-found = yes:
      566       assign
      567       v-found = yes
      568       .
      569       run create-level in this-procedure (
      570                                            input-output v-node-code
      571                                           ,input buf_gds-prt.upper-code
      572                                           ,input-output v-lvl-num
      573                                           ,output v-found
      574                                                           ) no-error.
      575       if error-status:error then  LEAVE.
      576     END.
      577     run prn-lib-open-stream  in this-procedure (
      578                                                 input parParentProc
      579                                                 ,input 43
      580                                                 ,input yes
      581                                                 ,input no
      582                                                 ).
      583     Line = fill("-", 198).
      584     date_string = cur-time-print() .
      585     FOR EACH tt-level no-lock:
      586       assign
      587       lvl-name[tt-level.level + 1] = substr(tt-level.lvl-name, 1, 18)
      588       .
      589     END.
      590     FORM HEADER
      591     Line format "X(198)" AT 1 SKIP
      592     "Продолжение - на следующей странице" AT 30 SKIP
      593     with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
      594     VIEW  STREAM PrnLibStream FRAME BottomFrame .
      595     FORM with FRAME PRT-FRAME.
      596     FOR EACH tt-prt No-LOCK
      597     BREAK
      598     by tt-prt.line-num
      599     by tt-prt.level:
      600       if first-of(tt-prt.line-num) then do:
      601         assign
      602         lvl[1] = "":U
      603         lvl[2] = "":U
      604         lvl[3] = "":U
      605         lvl[4] = "":U
      606         lvl[5] = "":U
      607         lvl[6] = "":U
      608         lvl[7] = "":U
      609         lvl[8] = "":U
      610         lvl[9] = "":U
      611         lvl[10] = "":U
      612         .
      613         DOWN stream PrnLibStream
      614         with FRAME PRT-FRAME.
      615       end.
      616       assign
      617       lvl[tt-prt.level + 1] = tt-prt.node-name
      618       .
      619       if LAST-of(tt-prt.line-num) then do:
      620         if v-first-page = yes then do:
      621           PUT STREAM PrnLibStream UNFORMATTED
      622           "Шкала:" chr(32) buf_gds-prt.node-name
      623           skip.
      624           PUT stream PrnLibStream unformatted
      625           skip(2).
      626           DISPLAY STREAM PrnLibStream
      627           lvl-name[1] @   lvl[1]
      628           lvl-name[2] @   lvl[2]
      629           lvl-name[3] @   lvl[3]
      630           lvl-name[4] @   lvl[4]
      631           lvl-name[5] @   lvl[5]
      632           lvl-name[6] @   lvl[6]
      633           lvl-name[7] @   lvl[7]
      634           lvl-name[8] @   lvl[8]
      635           lvl-name[9]  @  lvl[9]
      636           lvl-name[10] @  lvl[10]
      637           with frame prt-frame.
      638           assign
      639           v-first-page = no
      640           v-current-page = page-number(PrnLibStream)
      641           .
      642           DOWN stream PrnLibStream
      643           with frame prt-frame.
      644           underline stream PrnLibStream
      645           lvl[1]
      646           lvl[2]
      647           lvl[3]
      648           lvl[4]
      649           lvl[5]
      650           lvl[6]
      651           lvl[7]
      652           lvl[8]
      653           lvl[9]
      654           lvl[10]
      655           with frame prt-frame.
      656           DOWN stream PrnLibStream
      657           with frame prt-frame.
      658         end.
      659         display stream PrnLibStream
      660         lvl[1]
      661         lvl[2]
      662         lvl[3]
      663         lvl[4]
      664         lvl[5]
      665         lvl[6]
      666         lvl[7]
      667         lvl[8]
      668         lvl[9]
      669         lvl[10]
      670         with frame prt-frame.
      671       END.
      672     END.
      673     HIDE  STREAM PrnLibStream FRAME BottomFrame .
      674     output  STREAM PrnLibStream CLOSE.
      675     run prn-lib-prn-file in this-procedure (
      676                                               input parParentProc
      677                                               ,input 8
      678                                               ).
      679   end.
      680   procedure create-level :
      681   define input-output parameter p-node-code like ub.gds-prt.node-code no-undo.
      682   define input parameter p-upper-code like ub.gds-prt.upper-code no-undo .
      683   define input-output  parameter p-lvl-num like ub.gds-prt.lvl-num no-undo.
      684   DEFINE output parameter p-found as logical no-undo.
      685   DEFINE VARIABLE v-line-num as integer no-undo .
      686   define buffer bf_gds-prt for ub.gds-prt.
      687   define buffer bf_lvl-name for ub.lvl-name.
      688     do
      689     on error undo, return error
      690     :
      691     if can-find(first bf_gds-prt no-lock where
      692                         bf_gds-prt.upper-code = p-node-code) then do:
      693         find first bf_lvl-name no-lock where
      694                    bf_lvl-name.level = p-lvl-num - 1 and
      695                    bf_lvl-name.upper-code = p-upper-code no-error .
      696         find first tt-level where
      697                    tt-level.level = p-lvl-num - 1  no-error .
      698         if not available tt-level then do:
      699           create tt-level.
      700           assign
      701           tt-level.level = p-lvl-num - 1
      702           tt-level.lvl-name = if available bf_lvl-name then bf_lvl-name.lvl-name else "":U
      703           .
      704         end.
      705         for each bf_gds-prt no-lock where
      706                     bf_gds-prt.upper-code = p-node-code:
      707           assign
      708           v-line-num = v-line-num + 1
      709           .
      710           find first tt-prt where
      711                      tt-prt.node-code = bf_gds-prt.node-code no-error .
      712           if not available tt-prt then do:
      713             create tt-prt.
      714             assign
      715             tt-prt.node-code = bf_gds-prt.node-code
      716             tt-prt.level = p-lvl-num - 1
      717             .
      718           end.
      719           assign
      720           tt-prt.node-name = substr(bf_gds-prt.node-name, 1, 10)
      721           tt-prt.line-num = v-line-num
      722           .
      723         end.
      724         assign
      725         p-lvl-num = p-lvl-num + 1
      726         .
      727         find first bf_gds-prt no-lock where
      728                     bf_gds-prt.upper-code = p-node-code.
      729           assign
      730           p-node-code = bf_gds-prt.node-code
      731           p-found = yes
      732           .
      733     end.
      734     else do:
      735         assign
      736         p-found = no
      737         .
      738     end.
      739       end.
      740   end procedure.
