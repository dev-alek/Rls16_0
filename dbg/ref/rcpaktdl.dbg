        1   define input parameter p-in-qnty            as decimal          no-undo.
        2   define input parameter p-in-brutto-qnty     as decimal          no-undo.
        3   define output parameter p-out-qnty          as decimal          no-undo.
        4   define output parameter p-out-brutto-qnty   as decimal          no-undo.
        5   define output parameter p-ok                as logical          no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Изменение строки акта проработки.".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
      117   DEFINE BUTTON b-cancel AUTO-END-KEY DEFAULT
      118        LABEL "&Отмена"
      119        SIZE 10 BY 1
      120        BGCOLOR 8 .
      121   DEFINE BUTTON b-exit AUTO-GO
      122        LABEL "В&вод"
      123        SIZE 10 BY 1
      124        BGCOLOR 8 .
      125   DEFINE BUTTON b-help
      126        LABEL "Помощ&ь"
      127        SIZE 10 BY 1
      128        BGCOLOR 8 .
      129   DEFINE VARIABLE fi-brutto-qnty AS DECIMAL FORMAT "->,>>>,>>9.999":U INITIAL 0
      130        LABEL "Брутто"
      131        VIEW-AS FILL-IN
      132        SIZE 21 BY 1 NO-UNDO.
      133   DEFINE VARIABLE fi-qnty AS DECIMAL FORMAT "->,>>>,>>9.999":U INITIAL 0
      134        LABEL "Нетто"
      135        VIEW-AS FILL-IN
      136        SIZE 21 BY 1 NO-UNDO.
      137   DEFINE FRAME Dialog-Frame
      138        b-exit AT ROW 1.25 COL 2
      139        b-cancel AT ROW 1.25 COL 12
      140        b-help AT ROW 1.25 COL 28
      141        fi-qnty AT ROW 3.25 COL 6.5
      142        fi-brutto-qnty AT ROW 4.75 COL 5.5
      143        SPACE(5.37) SKIP(0.87)
      144       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      145            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      146            TITLE "Редактирование строки"
      147            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-cancel.
      148   ASSIGN
      149          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      150          FRAME Dialog-Frame:HIDDEN           = TRUE.
      151   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      152   DO:
      153     APPLY "END-ERROR":U TO SELF.
      154   END.
      155   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
      156   DO:
      157       assign
      158           p-ok = no
      159       .
      160   END.
      161   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      162   DO:
      163       define variable v-is-available     as logical      no-undo.
      164       define variable v-reason           as character    no-undo.
      165       define variable v-focus-handle     as handle       no-undo.
      166       assign
      167           fi-qnty
      168           fi-brutto-qnty
      169       .
      170       assign
      171           p-ok                = yes
      172           p-out-qnty          = fi-qnty
      173           p-out-brutto-qnty   = fi-brutto-qnty
      174       .
      175   END.
      176   ON LEAVE OF fi-brutto-qnty IN FRAME Dialog-Frame
      177   DO:
      178       if decimal( fi-brutto-qnty :screen-value ) < decimal( fi-qnty :screen-value )
      179       then do:
      180           message
      181               "Вес брутто не может быть"
      182               skip "меньше веса нетто."
      183               skip (1)
      184               skip "Введите правильное значение"
      185               skip "веса нетто."
      186           view-as alert-box warning.
      187           undo, return no-apply.
      188       end.
      189   END.
      190   ON LEAVE OF fi-qnty IN FRAME Dialog-Frame
      191   DO:
      192       if decimal( fi-brutto-qnty :screen-value ) < decimal( fi-qnty :screen-value )
      193       then do:
      194           assign
      195               fi-brutto-qnty :screen-value = fi-qnty :screen-value
      196           .
      197       end.
      198   END.
      199   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      200   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      201   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      202   on help of frame Dialog-Frame
      203   do:
      204     run gbl/app_help.p
      205       (input this-procedure :file-name
      206       ,input ''
      207       ,input ?
      208       ) no-error.
      209     if error-status :error then do:
      210       message
      211         "Ошибка при вызове помощи"
      212         error-status :get-message(1)
      213         view-as alert-box .
      214     end.
      215   end.
      216   run minbtn-set in this-procedure .
      217   on choose of b-help in frame Dialog-Frame
      218   do:
      219     apply "help":u to frame Dialog-Frame .
      220   end.
      221   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      222   procedure minbtn-set :
      223       do
      224           on error undo, return error return-value
      225           :
      226           define variable ii              as integer       no-undo .
      227           define variable fh              as widget-handle no-undo .
      228           define variable hh              as widget-handle no-undo .
      229           define variable v-h             as handle        extent 4 no-undo .
      230           define variable v-name-button   as character     no-undo .
      231           define variable v-help-old-x    as decimal       no-undo .
      232           define variable v-help-old-y    as decimal       no-undo .
      233           define variable v-help-old-size as decimal       no-undo .
      234           define variable v-frame-width   as decimal       no-undo .
      235           define variable jj              as integer       no-undo .
      236           do
      237               on error undo, return error
      238               :
      239               assign
      240                   v-frame-width = frame Dialog-Frame:width - 0.3
      241                   fh            = frame Dialog-Frame:first-child
      242                   hh            = fh:first-child
      243                   ii            = 1
      244                   .
      245               do while valid-handle(hh):
      246                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      247                   do:
      248                       case lc(hh:name) :
      249                           when "b-help" then
      250                               do:
      251                                   hh:load-image-up("cmp/b-help.bmp":u) .
      252                                   hh:load-image-down("cmp/b-help.bmp":u) .
      253                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      254                                   hh:TOOLTIP = "Помощь" .
      255                                   v-help-old-x = hh:column .
      256                                   v-help-old-y = hh:row    .
      257                                   v-help-old-size = hh:width .
      258                                   hh:width-chars = 2.5 .
      259                               end.
      260                           when "b-print" then
      261                               do:
      262                                   hh:load-image("cmp/b-print.bmp":u) .
      263                                   hh:TOOLTIP = "Печать" .
      264                                   v-h[ii] = hh:handle .
      265                                   ii = ii + 1 .
      266                                   hh:width-chars = 3 .
      267                               end.
      268                           when "b-history" or
      269                           when "b-hist" then
      270                               do:
      271                                   hh:load-image("cmp/b-hist.bmp":u) .
      272                                   hh:TOOLTIP = "История" .
      273                                   v-h[ii] = hh:handle .
      274                                   ii = ii + 1 .
      275                                   hh:width-chars = 3 .
      276                               end.
      277                           when "b-sch" then
      278                               do:
      279                                   hh:load-image("cmp/b-sch.bmp":u) .
      280                                   hh:TOOLTIP = "Установка Фильтра" .
      281                                   v-h[ii] = hh:handle .
      282                                   ii = ii + 1 .
      283                                   hh:width-chars = 3 .
      284                               end.
      285                           when "b-hist-user" then
      286                               do:
      287                                   hh:load-image("cmp/b-hist.bmp":u) .
      288                                   hh:TOOLTIP = "История пользователя" .
      289                                   ii = ii + 1 .
      290                               end.
      291                       end case.
      292                   end.
      293                   hh = hh:next-sibling.
      294               end.
      295               b-help:column = v-frame-width - b-help:width-chars.
      296               jj = 0.
      297               repeat ii = 4 to 1 by -1 :
      298                   if valid-handle (v-h[ii] ) then
      299                   do:
      300                       jj  = jj + 1 .
      301                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      302                       v-h[ii]:row    = v-help-old-y .
      303                   end.
      304               end.
      305           end.
      306       end.
      307   end procedure.
      308   MAIN-BLOCK:
      309   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      310      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      311      run init-fields in this-procedure.
      312     RUN enable_UI.
      313     apply "entry" to fi-qnty .
      314     WAIT-FOR GO OF FRAME Dialog-Frame.
      315   END.
      316   RUN disable_UI.
      317   PROCEDURE disable_UI :
      318     HIDE FRAME Dialog-Frame.
      319   END PROCEDURE.
      320   PROCEDURE enable_UI :
      321     DISPLAY fi-qnty fi-brutto-qnty
      322         WITH FRAME Dialog-Frame.
      323     ENABLE b-exit b-cancel b-help fi-qnty fi-brutto-qnty
      324         WITH FRAME Dialog-Frame.
      325     VIEW FRAME Dialog-Frame.
      326   END PROCEDURE.
      327   PROCEDURE init-fields :
      328   do
      329   on error undo, return error
      330   :
      331       assign
      332           fi-qnty         = p-in-qnty
      333           fi-brutto-qnty  = p-in-brutto-qnty
      334       .
      335   end.
      336   END PROCEDURE.
