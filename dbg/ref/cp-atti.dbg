     2003           and can-query(v-object-handle, "row")
     2004           and can-query(v-object-handle, "height")
     2005           and ( v-object-handle :col + v-object-handle :width
     2006                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2007               )
     2008           then do:
     2009             find first buf_temp-browse-handle
     2010               where buf_temp-browse-handle.browse-type   = 'width':u
     2011                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2012               no-error .
     2013             if available buf_temp-browse-handle
     2014             then do:
     2015             end.
     2016             else do:
     2017               create buf_temp-diasize-handle .
     2018               assign
     2019                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2020                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2021               .
     2022             end.
     2023           end.
     2024           assign
     2025             v-object-handle = v-object-handle :next-sibling
     2026           .
     2027         end.
     2028         assign
     2029           v-field-group-handle = v-field-group-handle :next-sibling
     2030         .
     2031       end.
     2032       do with frame Dialog-Frame
     2033       :
     2034         hide v-diasize-resize-button .
     2035         v-diasize-resize-button :row = 1.
     2036         v-diasize-resize-button :column = 1.
     2037       end.
     2038       if p-change-value > 0
     2039       then do:
     2040         if frame Dialog-Frame :scrollable = true
     2041         then do:
     2042           assign
     2043             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2044             no-error .
     2045           if error-status :error
     2046           or error-status :get-message(1) <> ""
     2047           then do:
     2048             undo move_block, retry move_block.
     2049           end.
     2050         end.
     2051         assign
     2052           frame Dialog-Frame :width = v-frame-width + p-change-value
     2053           no-error .
     2054         if error-status :error
     2055         or error-status :get-message(1) <> ""
     2056         then do:
     2057           undo move_block, retry move_block.
     2058         end.
     2059         assign
     2060           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2061         no-error .
     2062         if error-status :error
     2063         or error-status :get-message(1) <> ""
     2064         then do:
     2065           undo move_block, retry move_block.
     2066         end.
     2067         for each buf_temp-browse-handle
     2068           where buf_temp-browse-handle.browse-type = 'width':u
     2069         on error undo move_block, retry move_block
     2070         :
     2071           assign
     2072             buf_temp-browse-handle.browse-handle :width
     2073               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2074             no-error .
     2075           if error-status :error
     2076           or error-status :get-message(1) <> ""
     2077           then do:
     2078             undo move_block, retry move_block .
     2079           end.
     2080         end.
     2081         for each buf_temp-diasize-handle
     2082         on error undo move_block, retry move_block
     2083         :
     2084           assign
     2085             v-object-handle = buf_temp-diasize-handle.handle-value
     2086           .
     2087           if v-object-handle <> v-diasize-resize-button
     2088           then do:
     2089             assign
     2090               v-object-handle :col = v-object-handle :col + p-change-value
     2091               no-error .
     2092             if error-status :error
     2093             or error-status :get-message(1) <> ""
     2094             then do:
     2095               undo move_block, retry move_block .
     2096             end.
     2097           end.
     2098         end.
     2099       end.
     2100       else do:
     2101         for each buf_temp-diasize-handle
     2102         on error undo move_block, retry move_block
     2103         :
     2104           assign
     2105             v-object-handle = buf_temp-diasize-handle.handle-value
     2106           .
     2107           if v-object-handle <> v-diasize-resize-button
     2108           then do:
     2109             assign
     2110               v-object-handle :col = v-object-handle :col + p-change-value
     2111               no-error .
     2112             if error-status :error
     2113             or error-status :get-message(1) <> ""
     2114             then do:
     2115               undo move_block, retry move_block .
     2116             end.
     2117           end.
     2118         end.
     2119         for each buf_temp-browse-handle
     2120           where buf_temp-browse-handle.browse-type = 'width':u
     2121         on error undo move_block, retry move_block
     2122         :
     2123           assign
     2124             buf_temp-browse-handle.browse-handle :width
     2125               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2126             no-error .
     2127           if error-status :error
     2128           or error-status :get-message(1) <> ""
     2129           then do:
     2130             undo move_block, retry move_block .
     2131           end.
     2132         end.
     2133         assign
     2134           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2135           no-error .
     2136         if error-status :error
     2137         or error-status :get-message(1) <> ""
     2138         then do:
     2139           undo move_block, retry move_block.
     2140         end.
     2141         assign
     2142           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2143         no-error .
     2144         if error-status :error
     2145         or error-status :get-message(1) <> ""
     2146         then do:
     2147           undo move_block, retry move_block.
     2148         end.
     2149         if frame Dialog-Frame :scrollable = true
     2150         then do:
     2151           assign
     2152             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2153           no-error .
     2154           if error-status :error
     2155           or error-status :get-message(1) <> ""
     2156           then do:
     2157             undo move_block, retry move_block.
     2158           end.
     2159         end.
     2160       end.
     2161       if p-move-resize
     2162       then do:
     2163         run diasize_position-resize-button in this-procedure .
     2164       end.
     2165       if v-diasize-wndstore = true
     2166       then do:
     2167         if connected("ub") = true
     2168         then do:
     2169           define variable v-cntxt-db-num        as integer   no-undo .
     2170           define variable v-cntxt-userid        as character no-undo .
     2171           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2172                                             , OUTPUT v-cntxt-userid
     2173                                             ) .
     2174           run gbl/wndsizew.p
     2175             (input  v-cntxt-db-num
     2176             ,input  v-cntxt-userid
     2177             ,input  v-diasize-proc-name
     2178             ,input  'width':u
     2179             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2180             ) .
     2181         end.
     2182       end.
     2183     end.
     2184     assign
     2185       v-diasize-change-size = false
     2186     .
     2187   end procedure.
     2188   procedure diasize_set-width :
     2189     define input  parameter p-new-width  as decimal   no-undo .
     2190     define input  parameter p-move-resize as logical   no-undo .
     2191     do
     2192     on error undo, return error return-value
     2193     :
     2194       run diasize_change-width in this-procedure
     2195         (input  (p-new-width - frame Dialog-Frame :width)
     2196         ,input  p-move-resize
     2197         ) .
     2198     end.
     2199   end procedure.
     2200   procedure diasize_position-resize-button :
     2201     do with frame Dialog-Frame
     2202     :
     2203       hide v-diasize-resize-button .
     2204       assign
     2205         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2206                     - 1
     2207                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2208         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2209                     - 1
     2210                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2211       .
     2212       view v-diasize-resize-button .
     2213     end.
     2214   end procedure.
     2215   on alt-right anywhere
     2216   do:
     2217     run diasize_change-width in this-procedure
     2218       (input 1
     2219       ,input true
     2220       ) .
     2221     return no-apply .
     2222   end.
     2223   on alt-left anywhere
     2224   do:
     2225     run diasize_change-width in this-procedure
     2226       (input -1
     2227       ,input true
     2228       ) .
     2229     return no-apply .
     2230   end.
     2231   on alt-down anywhere
     2232   do:
     2233     run diasize_change-height in this-procedure
     2234       (input 1
     2235       ,input true
     2236       ) .
     2237     return no-apply .
     2238   end.
     2239   on alt-up anywhere
     2240   do:
     2241     run diasize_change-height in this-procedure
     2242       (input -1
     2243       ,input true
     2244       ) .
     2245     return no-apply .
     2246   end.
     2247   on alt-enter of frame Dialog-Frame
     2248   do:
     2249     run diasize_maximize in this-procedure
     2250       (input  ?
     2251       ).
     2252     return no-apply .
     2253   end.
     2254   procedure diasize_end-move :
     2255     do
     2256     on error undo, return error return-value
     2257     :
     2258       define variable v-row-delta as decimal   no-undo .
     2259       define variable v-col-delta as decimal   no-undo .
     2260       define variable v-new-row as decimal   no-undo .
     2261       define variable v-new-col as decimal   no-undo .
     2262       assign
     2263         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2264         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2265       .
     2266       assign
     2267         v-row-delta = v-new-row - frame Dialog-Frame :height
     2268         v-col-delta = v-new-col - frame Dialog-Frame :width
     2269       .
     2270       run diasize_change-height in this-procedure
     2271         (input v-row-delta
     2272         ,input true
     2273         ) .
     2274       run diasize_change-width in this-procedure
     2275         (input v-col-delta
     2276         ,input true
     2277         ) .
     2278     end.
     2279   end procedure.
     2280   procedure diasize_maximize :
     2281     define input  parameter p-action as logical   no-undo .
     2282     do
     2283     on error undo, return error return-value
     2284     :
     2285       if p-action = ?
     2286       then do:
     2287         if v-diasize-need-maximize = true
     2288         then do:
     2289           assign
     2290             p-action = true
     2291           .
     2292         end.
     2293         else do:
     2294           assign
     2295             p-action = false
     2296           .
     2297         end.
     2298       end.
     2299       if p-action = true
     2300       then do:
     2301         run diasize_change-height in this-procedure
     2302           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2303               - frame Dialog-Frame :height-chars
     2304           ,input true
     2305           ) .
     2306         run diasize_change-width in this-procedure
     2307           (input session :width-chars
     2308               - frame Dialog-Frame :width-chars
     2309           ,input true
     2310           ) .
     2311         assign
     2312           v-diasize-need-maximize = false
     2313         .
     2314       end.
     2315       else do:
     2316         run diasize_change-width in this-procedure
     2317           (input v-diasize-orig-frame-width
     2318               - frame Dialog-Frame :width-chars
     2319           ,input true
     2320           ) .
     2321         run diasize_change-height in this-procedure
     2322           (input v-diasize-orig-frame-height
     2323               - frame Dialog-Frame :height-chars
     2324           ,input true
     2325           ) .
     2326         assign
     2327           v-diasize-need-maximize = true
     2328         .
     2329       end.
     2330     end.
     2331   end procedure.
     2332   procedure diasize_restore-orig-size :
     2333     do
     2334     on error undo, return error return-value
     2335     :
     2336       assign
     2337         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2338         v-diasize-current-frame-height = frame Dialog-Frame :height
     2339       .
     2340       run diasize_set-height in this-procedure
     2341         (input  v-diasize-orig-frame-height
     2342         ,input  true
     2343         ) .
     2344       run diasize_set-width in this-procedure
     2345         (input  v-diasize-orig-frame-width
     2346         ,input  true
     2347         ) .
     2348     end.
     2349   end procedure.
     2350   procedure diasize_restore-current-size :
     2351     do
     2352     on error undo, return error return-value
     2353     :
     2354       run diasize_set-height in this-procedure
     2355         (input  v-diasize-current-frame-height
     2356         ,input  true
     2357         ) .
     2358       run diasize_set-width in this-procedure
     2359         (input  v-diasize-current-frame-width
     2360         ,input  true
     2361         ) .
     2362     end.
     2363   end procedure.
     2364   procedure diasize_set-browse-handle :
     2365     define input  parameter p-browse-handle as handle   no-undo .
     2366     define buffer buf_temp-browse-handle for temp-browse-handle .
     2367     do
     2368     on error undo, return error return-value
     2369     :
     2370       assign
     2371         v-diasize-browse-handle = p-browse-handle
     2372       .
     2373       for each buf_temp-browse-handle
     2374       on error undo, return error return-value
     2375       :
     2376         delete buf_temp-browse-handle .
     2377       end.
     2378     end.
     2379   end procedure.
     2380   procedure diasize_add_browse :
     2381     define input  parameter p-browse-type   as character no-undo .
     2382     define input  parameter p-browse-handle as handle    no-undo .
     2383     define buffer buf_temp-browse-handle for temp-browse-handle .
     2384     do
     2385     on error undo, return error return-value
     2386     :
     2387       assign
     2388         v-diasize-browse-number = v-diasize-browse-number + 1
     2389       .
     2390       create buf_temp-browse-handle .
     2391       assign
     2392         buf_temp-browse-handle.browse-type   = p-browse-type
     2393         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2394         buf_temp-browse-handle.browse-handle = p-browse-handle
     2395       .
     2396     end.
     2397   end procedure.
     2398   procedure diasize_init :
     2399     define variable v-default-value    as logical   no-undo .
     2400     define variable v-restore-saved    as logical   no-undo .
     2401     define variable v-resize-value-str as character no-undo .
     2402     do
     2403     on error undo, return error return-value
     2404     :
     2405       do with frame Dialog-Frame
     2406       :
     2407         assign
     2408           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2409           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2410           v-diasize-browse-handle     = browse BROWSE-2 :handle
     2411         .
     2412         create button v-diasize-resize-button
     2413         assign
     2414           parent        = frame Dialog-Frame :first-child
     2415           label         = "s"
     2416           height-pixels = 16
     2417           width-pixels  = 16
     2418           visible       = true
     2419           sensitive     = true
     2420           movable       = true
     2421           triggers:
     2422             on end-move persistent run diasize_end-move in this-procedure .
     2423           end triggers.
     2424         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2425         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2426         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2427         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2428         assign
     2429           v-diasize-wndmax = false
     2430         .
     2431         if connected("ub") = true
     2432         then do:
     2433           define variable v-cntxt-db-num        as integer   no-undo .
     2434           define variable v-cntxt-userid        as character no-undo .
     2435           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2436                                             , OUTPUT v-cntxt-userid
     2437                                             ) .
     2438           run gbl/wndpar_r.p
     2439             (input  v-cntxt-db-num
     2440             ,input  v-cntxt-userid
     2441             ,input  'wndmax':U
     2442             ,output v-diasize-wndmax
     2443             ,output v-default-value
     2444             ) .
     2445         end.
     2446         assign
     2447           v-diasize-wndstore = false
     2448         .
     2449         if connected("ub") = true
     2450         then do:
     2451           run gbl/wndpar_r.p
     2452             (input  v-cntxt-db-num
     2453             ,input  v-cntxt-userid
     2454             ,input  'wndstore':U
     2455             ,output v-diasize-wndstore
     2456             ,output v-default-value
     2457             ) .
     2458         end.
     2459         assign
     2460           v-diasize-proc-name = entry(1, program-name(2), '.')
     2461         .
     2462         if v-diasize-wndstore = true
     2463         then do:
     2464           assign
     2465             v-restore-saved = false
     2466           .
     2467           if connected("ub") = true
     2468           then do:
     2469             run gbl/wndsizer.p
     2470               (input  v-cntxt-db-num
     2471               ,input  v-cntxt-userid
     2472               ,input  v-diasize-proc-name
     2473               ,input  'height':u
     2474               ,output v-resize-value-str
     2475               ) .
     2476             if v-resize-value-str <> '':U
     2477             then do:
     2478               run diasize_change-height in this-procedure
     2479                 (input  integer(v-resize-value-str)
     2480                 ,input  true
     2481                 ) .
     2482               assign
     2483                 v-restore-saved = true
     2484               .
     2485             end.
     2486           end.
     2487           if connected("ub") = true
     2488           then do:
     2489             run gbl/wndsizer.p
     2490               (input  v-cntxt-db-num
     2491               ,input  v-cntxt-userid
     2492               ,input  v-diasize-proc-name
     2493               ,input  'width':u
     2494               ,output v-resize-value-str
     2495               ) .
     2496             if v-resize-value-str <> '':U
     2497             then do:
     2498               run diasize_change-width in this-procedure
     2499                 (input  integer(v-resize-value-str)
     2500                 ,input  true
     2501                 ) .
     2502               assign
     2503                 v-restore-saved = true
     2504               .
     2505             end.
     2506           end.
     2507           if v-restore-saved <> true
     2508           then do:
     2509             if v-diasize-wndmax = true
     2510             then do:
     2511               run diasize_maximize in this-procedure
     2512                 (input  true
     2513                 ) .
     2514             end.
     2515           end.
     2516         end.
     2517         else do:
     2518           if v-diasize-wndmax = true
     2519           then do:
     2520             run diasize_maximize in this-procedure
     2521               (input  true
     2522               ) .
     2523           end.
     2524         end.
     2525       end.
     2526     end.
     2527   end procedure.
     2528   procedure diasize_need-full-display :
     2529     define output parameter p-need-full-display as logical   no-undo .
     2530     do
     2531     on error undo, return error return-value
     2532     :
     2533       assign
     2534         p-need-full-display = v-diasize-need-full-display
     2535       .
     2536       assign
     2537         v-diasize-need-full-display = false
     2538       .
     2539     end.
     2540   end procedure.
     2541   procedure get-context :
     2542      define output parameter p-db-num as integer          no-undo.
     2543      define output parameter p-user-id as character        no-undo.
     2544      define variable v-login               as character    no-undo.
     2545      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2546      define buffer buf_user-login  for ub.user-login .
     2547      do
     2548      on error undo, return error
     2549      :
     2550            FIND FIRST buf_sys-ctrl no-lock.
     2551            ASSIGN
     2552               v-login = USERID("ub")
     2553               p-db-num = buf_sys-ctrl.db-num
     2554            .
     2555            FIND FIRST buf_user-login
     2556                 WHERE buf_user-login.db-num = p-db-num
     2557                   AND buf_user-login.user-login = v-login
     2558                 no-lock
     2559                 no-error
     2560                 .
     2561            IF AVAILABLE buf_user-login
     2562            THEN DO:
     2563               assign
     2564                  p-user-id = buf_user-login.user-id
     2565               .
     2566            END.
     2567      end.
     2568   end procedure.
     2569       run diasize_init in this-procedure .
     2570    frame Dialog-Frame:TITLE = frame Dialog-Frame:TITLE.
     2571   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2572   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2573   MAIN-BLOCK:
     2574   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2575      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2576   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2577     run mainmenu_getcntxt in parparentproc
     2578       (output v-cntxt-db-num
     2579       ,output v-cntxt-userid
     2580       ,output v-cntxt-level
     2581       ,output v-cntxt-host-code-obj
     2582       ,output v-cntxt-obj-type
     2583       ,output v-cntxt-obj-code
     2584       ,output v-cntxt-db-num-obj
     2585       ,output v-cntxt-is-admin
     2586       ) .
     2587   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2588     RUN MyEnable in this-procedure no-error.
     2589     if error-status:error then return error.
     2590     Run init-proc in this-procedure .
     2591     view frame Dialog-Frame .
     2592     WAIT-FOR GO OF FRAME Dialog-Frame.
     2593   END.
     2594   RUN disable_UI in this-procedure .
     2595   run attr-pop-clean-up in this-procedure ( input 'cash-pay-attr':U ).
     2596   if updated then return 'ИЗМЕНЕНИЕ':U.
     2597   PROCEDURE choose-to-edit :
     2598   define input parameter p-attr-code as character no-undo .
     2599   assign
     2600   add-option = p-attr-code
     2601   .
     2602   APPLY "CHOOSE" to b-ins in frame Dialog-Frame .
     2603   END PROCEDURE.
     2604   PROCEDURE disable_UI :
     2605     HIDE FRAME Dialog-Frame.
     2606   END PROCEDURE.
     2607   PROCEDURE enable_UI :
     2608     DISPLAY v-obj-name cd-cdpay-code cd-curr-code
     2609         WITH FRAME Dialog-Frame.
     2610     ENABLE b-quit b-ins b-lkp b-chg b-del b-help v-obj-name cd-cdpay-code
     2611            cd-curr-code
     2612         WITH FRAME Dialog-Frame.
     2613     VIEW FRAME Dialog-Frame.
     2614     OPEN QUERY BROWSE-2 FOR EACH Temp-hattr NO-LOCK.
     2615   END PROCEDURE.
     2616   PROCEDURE init-proc :
     2617   define var  attr-type as character no-undo .
     2618   define var  attr-format as character no-undo .
     2619   define var  attr-label as character no-undo .
     2620   define var  attr-value as character no-undo .
     2621   define var  attr-range as integer no-undo .
     2622   define var  attr-user-can-edit as logical no-undo .
     2623   define var  attr-output-display as logical no-undo .
     2624   define var  attr-other as char no-undo .
     2625   define buffer buf_cash-pay for ub.cash-pay.
     2626   define buffer buf_cash-pay-attr for ub.cash-pay-attr.
     2627   for each  Temp-hattr share-lock: delete Temp-hattr. end.
     2628   add-option = "".
     2629   find first buf_cash-pay where buf_cash-pay.cdpay-code =  p-cdpay-code
     2630                      AND buf_cash-pay.curr-code = p-curr-code
     2631                           no-lock no-error .
     2632   Assign
     2633       cd-cdpay-code = buf_cash-pay.cdpay-code
     2634       cd-curr-code = buf_cash-pay.curr-code
     2635       .
     2636   display cd-cdpay-code cd-curr-code
     2637     with frame Dialog-Frame  .
     2638      For each buf_cash-pay-attr where
     2639               buf_cash-pay-attr.cdpay-code  = p-cdpay-code
     2640          and  buf_cash-pay-attr.curr-code  = p-curr-code
     2641               no-lock :
     2642             run cp-attr-code in this-procedure (
     2643                                                 input buf_cash-pay-attr.attr-code
     2644                                                 ,output attr-type
     2645                                                 ,output attr-format
     2646                                                 ,output attr-label
     2647                                                 ,output attr-range
     2648                                                 ,output attr-user-can-edit
     2649                                                 ,output attr-output-display
     2650                                                 ,output attr-other ).
     2651             if attr-output-display = true then DO:
     2652                 run cp-attr-value in this-procedure (
     2653                                                     input buf_cash-pay-attr.cdpay-code
     2654                                                     ,input buf_cash-pay-attr.curr-code
     2655                                                     ,input buf_cash-pay-attr.host-code
     2656                                                     ,input buf_cash-pay-attr.obj-type
     2657                                                     ,input buf_cash-pay-attr.obj-code
     2658                                                     ,input buf_cash-pay-attr.attr-code
     2659                                                     ,output attr-value
     2660                                                     ,output attr-type ).
     2661                 create Temp-hattr.
     2662                 assign
     2663                 Temp-hattr.attr-code = attr-label
     2664                 Temp-hattr.value_ = buf_cash-pay-attr.attr-value
     2665                 Temp-hattr.attr-value = (if attr-type = 'L':U
     2666                                         then string(attr-value = "yes":U, attr-format)
     2667                                         else attr-value)
     2668                 Temp-hattr.user-can-edit = attr-user-can-edit
     2669                 Temp-hattr.code = buf_cash-pay-attr.attr-code
     2670                 temp-hattr.host-code = buf_cash-pay-attr.host-code
     2671                 temp-hattr.obj-type = buf_cash-pay-attr.obj-type
     2672                 temp-hattr.obj-code = buf_cash-pay-attr.obj-code
     2673                 .
     2674         End.
     2675       End.
     2676       OPEN QUERY BROWSE-2 FOR EACH Temp-hattr NO-LOCK.
     2677   END PROCEDURE.
     2678   PROCEDURE MyEnable :
     2679   define var  attr-type as character no-undo .
     2680   define var  attr-format as character no-undo .
     2681   define var  attr-label as character no-undo .
     2682   define var  attr-value as character no-undo .
     2683   define variable attr-range as integer no-undo .
     2684   define var  attr-user-can-edit as logical no-undo .
     2685   define var  attr-output-display as logical no-undo .
     2686   define var  attr-other as char no-undo .
     2687   define variable v-version as decimal no-undo .
     2688   define variable ii as integer no-undo .
     2689   define variable jj as integer no-undo .
     2690   define variable v-cd as character no-undo .
     2691   define variable v-cd-list as character no-undo .
     2692   DEFINE BUFFER buf_Cash-pay FOR ub.cash-pay.
     2693   ASSIGN
     2694   b-ins:POPUP-MENU IN FRAME Dialog-Frame  = MENU MENU-b-ins:HANDLE
     2695   b-ins:MENU-MOUSE = 1
     2696   Temp-hattr.attr-value:width in browse browse-2 = 45
     2697   Temp-hattr.attr-value:resizable in browse browse-2 = yes
     2698   .
     2699   if p-mode <> 'ПРОСМОТР':U then do:
     2700     run attr-pop-create-items in this-procedure  (
     2701                                                    input 'cash-pay-attr':U
     2702                                                   ,input 'cp-attr-manual-edit'
     2703                                                   ,input 'cp-attr-tooltip'
     2704                                                   ,input 'choose-to-edit'
     2705                                                   ,input menu menu-b-ins:handle
     2706                                                   ,input 'paycard-export-prefix,grp-code,is-use,dop-doc,paycard-all-prefix,paycard-edit-prefix,form_km3,bal_malina,max_proc_sum,mask_card_kup':u
     2707                                                 ).
     2708   end.
     2709   FIND FIRST buf_Cash-pay NO-LOCK WHERE
     2710               buf_Cash-pay.cdpay-code = p-cdpay-code
     2711         AND   buf_Cash-pay.curr-code = p-curr-code NO-ERROR.
     2712   IF AVAILABLE buf_cash-pay THEN DO:
     2713       ASSIGN
     2714       v-obj-name = buf_cash-pay.obj-name.
     2715   END.
     2716   ASSIGN b-ins:MENU-MOUSE in frame Dialog-Frame  = 1.
     2717   DISPLAY
     2718   v-obj-name
     2719   WITH FRAME Dialog-Frame .
     2720   ENABLE
     2721   b-quit
     2722   b-del when p-mode = 'ИЗМЕНЕНИЕ':U
     2723   b-ins when p-mode = 'ИЗМЕНЕНИЕ':U
     2724   b-chg when p-mode = 'ИЗМЕНЕНИЕ':U
     2725   b-lkp
     2726   b-help BROWSE-2
     2727   WITH FRAME Dialog-Frame .
     2728   VIEW FRAME Dialog-Frame .
     2729   OPEN QUERY BROWSE-2 FOR EACH Temp-hattr NO-LOCK.
     2730   END PROCEDURE.
     2731   PROCEDURE proc-add-chg :
     2732   define input parameter p-add as logical no-undo .
     2733   define variable attr-type as character no-undo .
     2734   define variable attr-format as character no-undo .
     2735   define variable attr-label as character no-undo .
     2736   define variable attr-range as integer no-undo .
     2737   define variable attr-user-can-edit as logical no-undo .
     2738   define variable attr-output-display as logical no-undo .
     2739   define variable attr-other as char no-undo .
     2740   define variable attr-value as character no-undo .
     2741   define variable v-attr-value as character no-undo .
     2742   define variable v-init as character no-undo .
     2743   define variable jj as integer no-undo.
     2744   DEFINE VARIABLE v-spr as character no-undo .
     2745   define variable v-spr-param as character no-undo .
     2746   DEFINE VARIABLE v-setted as logical no-undo .
     2747   DEFINE VARIABLE v-deleted as logical no-undo .
     2748   define variable v-check as character no-undo .
     2749   define variable v-error-code as character no-undo .
     2750   define variable v-correct as logical no-undo .
     2751   define variable v-host-code like ub.sysconf.host-code no-undo .
     2752   define variable v-obj-type like ub.clients.obj-type no-undo .
     2753   define variable v-obj-code like ub.clients.obj-code no-undo .
     2754   define variable v-ask-labels as character no-undo .
     2755   define variable choice as integer no-undo .
     2756   define var loc#log as logical no-undo.
     2757   case p-add:
     2758     when yes then do:
     2759       run cp-attr-code in this-procedure (
     2760                                             input  add-option
     2761                                             ,output attr-type
     2762                                             ,output attr-format
     2763                                             ,output attr-label
     2764                                             ,output attr-range
     2765                                             ,output attr-user-can-edit
     2766                                             ,output attr-output-display
     2767                                             ,output attr-other
     2768                                             ) no-error .
     2769       if error-status :error then do:
     2770         return error .
     2771       end.
     2772       assign
     2773       added = yes.
     2774       CASE attr-range:
     2775         when integer('0':U) then do:
     2776           assign
     2777           v-ask-labels = "Глобально"
     2778           v-host-code = 0
     2779           v-obj-type = '':U
     2780           v-obj-code = 0
     2781           .
     2782         end.
     2783         when integer('1':U) then do:
     2784           assign
     2785           v-ask-labels = substitute("Глобально|Фирма &1", p-host-code)
     2786           v-host-code = 0
     2787           v-obj-type = '':U
     2788           v-obj-code = 0
     2789           .
     2790         end.
     2791         when integer('2':U) then do:
     2792           assign
     2793           v-ask-labels = substitute("&1&2", p-obj-type, p-obj-code)
     2794           v-host-code = p-host-code
     2795           v-obj-type = p-obj-type
     2796           v-obj-code = p-obj-code
     2797           .
     2798         end.
     2799         when integer('4':U) then do:
     2800           assign
     2801           v-ask-labels = substitute("Глобально|Фирма &1|&2&3", p-host-code, p-obj-type, p-obj-code)
     2802           v-host-code = 0
     2803           v-obj-type = '':U
     2804           v-obj-code = 0
     2805           .
     2806         end.
     2807       END CASE.
     2808       if num-entries(v-ask-labels, "|") > 1 then do:
     2809         run gbl/d-askw.w (
     2810                             input "Область действия атрибута"
     2811                             ,input "Выберите область действия атрибута"
     2812                             ,input "|"
     2813                             ,input (v-ask-labels + "|Отменить")
     2814                             ,input fill("|", num-entries(v-ask-labels, "|"))
     2815                             ,input 1
     2816                             ,input num-entries(v-ask-labels, "|") + 1
     2817                             ,output choice).
     2818         if choice = num-entries(v-ask-labels, "|") + 1 then do:
     2819           undo, return error .
     2820         end.
     2821       end.
     2822       CASE choice:
     2823         when 1 then do:
     2824         end.
     2825         when 2 then do:
     2826           if v-host-code <> 0
     2827           then do:
     2828             assign
     2829             v-obj-type  = p-obj-type
     2830             v-obj-code  = p-obj-code
     2831             .
     2832           end.
     2833           if num-entries(v-ask-labels, "|") = 3    then do:
     2834             assign
     2835             v-host-code = p-host-code
     2836             .
     2837           end.
     2838         end.
     2839         when 3 then do:
     2840           assign
     2841           v-host-code = p-host-code
     2842           v-obj-type  = p-obj-type
     2843           v-obj-code  = p-obj-code
     2844           .
     2845         end.
     2846       END CASE.
     2847       if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     2848         run temp-cp-attr-exist in this-procedure (
     2849                                                   input p-cdpay-code
     2850                                                   ,input p-curr-code
     2851                                                   ,input v-host-code
     2852                                                   ,input v-obj-type
     2853                                                   ,input v-obj-code
     2854                                                   ,input add-option
     2855                                                   ,output loc#log)  no-error.
     2856         if error-status:error then return error.
     2857         if loc#log then do:
     2858           message
     2859           "Данный атрибут уже существует"
     2860           view-as alert-box error .
     2861           return error.
     2862         end.
     2863       end.
     2864       do jj = 1 to num-entries(attr-other, chr(47)):
     2865         if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "init":U then do:
     2866           assign
     2867           v-init = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     2868           .
     2869         end.
     2870       end.
     2871       if  v-init <> "":U then do:
     2872           run  value(v-init)
     2873                       in this-procedure (
     2874                                             input p-cdpay-code
     2875                                           , input p-curr-code
     2876                                           , input v-host-code
     2877                                           , input v-obj-type
     2878                                           , input v-obj-code
     2879                                           , output attr-value) no-error .
     2880             if error-status:error then do:
     2881                 assign
     2882                 attr-value = "":U
     2883                 .
     2884             end.
     2885       end.
     2886       CASE attr-type:
     2887         when 'L':U then do:
     2888           assign
     2889           v-attr-value = "yes":U
     2890           .
     2891         end.
     2892         when 'I':U or when 'D':U then do:
     2893           assign
     2894           v-attr-value = if v-init <> "":U
     2895                         then attr-value
     2896                         else string(0)
     2897           .
     2898         end.
     2899         when 'T':U then do:
     2900           assign
     2901           v-attr-value = ?
     2902           .
     2903         end.
     2904         when 'C':U then do:
     2905           assign
     2906           v-attr-value = if v-init <> "":U
     2907                         then attr-value
     2908                         else "":U
     2909           .
     2910         end.
     2911       END CASE.
     2912       assign
     2913       attr-value = v-attr-value
     2914       .
     2915     end.
     2916     when no then do:
     2917       run cp-attr-code in this-procedure (
     2918                                             input TEMP-hattr.code
     2919                                             ,output attr-type
     2920                                             ,output attr-format
     2921                                             ,output attr-label
     2922                                             ,output attr-range
     2923                                             ,output attr-user-can-edit
     2924                                             ,output attr-output-display
     2925                                             ,output attr-other) no-error.
     2926       IF ERROR-STATUS:ERROR THEN DO:
     2927           message "Ошибка при определении названия и типа атрибута типа кассового платежа!"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     2928           return error.
     2929       END.
     2930       RUN cp-attr-VALUE IN THIS-PROCEDURE (
     2931                                            INPUT p-cdpay-code
     2932                                            ,INPUT p-curr-code
     2933                                            ,input TEMP-hattr.host-code
     2934                                            ,input TEMP-hattr.obj-type
     2935                                            ,input TEMP-hattr.obj-code
     2936                                            ,input TEMP-hattr.code
     2937                                            ,OUTPUT ATTR-VALUE
     2938                                            ,OUTPUT attr-type) NO-ERROR.
     2939       IF ERROR-STATUS:ERROR THEN DO:
     2940           message "Ошибка при определении значения атрибута типа кассового платежа!"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     2941           return error.
     2942       END.
     2943     end.
     2944   END CASE.
     2945   IF attr-user-can-edit Then DO:
     2946     do jj = 1 to num-entries(attr-other, chr(47)):
     2947       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "spr":U then do:
     2948         assign
     2949         v-spr = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     2950         .
     2951       end.
     2952       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "spr-param":U then do:
     2953         assign
     2954         v-spr-param = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     2955         .
     2956       end.
     2957       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "check":U then do:
     2958         assign
     2959         v-check = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     2960         .
     2961       end.
     2962     end.
     2963     if v-spr = "":U then do:
     2964       run gbl/d-prompt.w (
     2965         'title=':u + "Изменение атрибута типа кассового платежа" + '\':u
     2966       + 'text1=':u + attr-label + '\':u
     2967       + 'format=' + (if attr-type = 'L':U then "yes/no" else attr-format) + '\':u
     2968       + 'type=' + attr-type + '\':u
     2969       + 'fillin_row=2\':u
     2970       + 'fillin_col=4\':u
     2971       + 'fillin_width=20\':u
     2972       + 'fillin_height=1\':u
     2973       + 'max-chars=70\':u
     2974       + 'readonly=' + (if p-mode <> 'ИЗМЕНЕНИЕ':U then 'yes':u else 'no':u) + '\':u
     2975       , input-output attr-value
     2976           ).
     2977       if return-value = 'false':u then return error.
     2978     END.
     2979     ELSE DO:
     2980       if v-spr-param = "":U then do:
     2981         run  value(v-spr)
     2982                     in this-procedure (
     2983                                          input p-cdpay-code
     2984                                         ,input p-curr-code
     2985                                         ,input (if p-add then v-host-code else temp-hattr.host-code)
     2986                                         ,input (if p-add then v-obj-type else temp-hattr.obj-type)
     2987                                         ,input (if p-add then v-obj-code else temp-hattr.obj-code)
     2988                                         ,input-output attr-value
     2989                                         ,output v-setted) no-error .
     2990       end.
     2991       else do:
     2992         run  value( v-spr )  in this-procedure (
     2993                                                 input p-cdpay-code
     2994                                                 ,input p-curr-code
     2995                                                 ,input (if p-add then v-host-code else temp-hattr.host-code)
     2996                                                 ,input (if p-add then v-obj-type else temp-hattr.obj-type)
     2997                                                 ,input (if p-add then v-obj-code else temp-hattr.obj-code)
     2998                                                 ,input v-spr-param
     2999                                                 ,input-output attr-value
     3000                                                 ,output v-setted) no-error .
     3001       end.
     3002       if not v-setted then return error.
     3003     end.
     3004     if v-check <> "":U then do:
     3005       run value(v-check) in this-procedure (
     3006                                             input p-cdpay-code
     3007                                             ,input p-curr-code
     3008                                             ,input (if p-add = yes then add-option else temp-hattr.attr-code)
     3009                                             ,input attr-value
     3010                                             ,input (if p-add then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U)
     3011                                             ,output v-correct
     3012                                             ,output v-error-code) no-error.
     3013       if error-status:error then do:
     3014         message
     3015         "Ошибка при проверке корректности задаваемого значения атрибута" skip
     3016         error-status:get-message(1) skip
     3017         view-as alert-box error .
     3018         undo, return error .
     3019       end.
     3020       if not v-correct then do:
     3021         message
     3022         "Задание атрибута некорректно" skip
     3023         v-error-code
     3024         view-as alert-box error .
     3025         undo, return error .
     3026       end.
     3027     end.
     3028     run cp-attr-write in this-procedure (
     3029                                           input p-cdpay-code
     3030                                           ,input p-curr-code
     3031                                           ,input (if p-add then v-host-code else temp-hattr.host-code)
     3032                                           ,input (if p-add then v-obj-type else temp-hattr.obj-type)
     3033                                           ,input (if p-add then v-obj-code else temp-hattr.obj-code)
     3034                                           ,input (if p-add then add-option else temp-hattr.code)
     3035                                           ,input attr-value
     3036                                         ) no-error .
     3037     IF NOT error-status:error then do:
     3038         assign
     3039         updated = yes
     3040         .
     3041     END.
     3042     else do:
     3043         message "Ошибка при изменении значения атрибута типа кассового платежа!"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     3044     end.
     3045   End.
     3046   Else message "Изменение атрибута невозможно !" view-as alert-box error.
     3047   END PROCEDURE.
     3048   PROCEDURE proc-b-lkp :
     3049   define variable attr-type as character no-undo .
     3050   define variable attr-format as character no-undo .
     3051   define variable attr-label as character no-undo .
     3052   define variable attr-user-can-edit as logical no-undo .
     3053   define variable attr-output-display as logical no-undo .
     3054   define variable attr-other as char no-undo .
     3055   define variable attr-value as char no-undo .
     3056   define variable attr-range as integer no-undo .
     3057   define variable v-run-name as character no-undo .
     3058   define variable jj as integer no-undo .
     3059     run cp-attr-code in this-procedure (
     3060                          input temp-hattr.code
     3061                         ,output attr-type
     3062                         ,output attr-format
     3063                         ,output attr-label
     3064                         ,output attr-range
     3065                         ,output attr-user-can-edit
     3066                         ,output attr-output-display
     3067                         ,output attr-other ) NO-ERROR.
     3068   IF ERROR-STATUS:ERROR THEN DO:
     3069       return error.
     3070   END.
     3071   do jj = 1 to num-entries(attr-other, chr(47)):
     3072     if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "display" then do:
     3073       v-run-name = entry(2, entry(jj, attr-other, chr(47)), "=":U).
     3074       run value(v-run-name) in this-procedure (
     3075                                                input p-cdpay-code
     3076                                               ,INPUT p-curr-code
     3077                                               ,input temp-hattr.code
     3078                                               ,input temp-hattr.attr-value
     3079                                               ,input p-host-code
     3080                                               ,input p-obj-type
     3081                                               ,input p-obj-code
     3082                                                )
     3083                                                no-error .
     3084       if error-status:error then undo, return error .
     3085       return .
     3086     end.
     3087   END.
     3088   message
     3089   "Расширенный просмотр ДАННОГО атрибута НЕ ПРЕДУСМОТРЕН!"
     3090   view-as alert-box Warning.
     3091   BELL.
     3092   END PROCEDURE.
     3093   PROCEDURE temp-cp-attr-exist :
     3094     do
     3095     on error undo, return error
     3096     :
     3097       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     3098       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     3099       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     3100       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     3101       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     3102       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     3103       define output parameter p-exist   as logical  no-undo .
     3104       define buffer buf_temp-hattr for temp-hattr .
     3105       define variable v-type           as character no-undo .
     3106       define variable v-format         as character no-undo .
     3107       define variable v-label          as character no-undo .
     3108       define variable v-range          as integer   no-undo .
     3109       define variable v-user-can-edit  as logical   no-undo .
     3110       define variable v-output-display as logical   no-undo .
     3111       define variable v-other          as character no-undo .
     3112       define variable v-version        as decimal   no-undo .
     3113       run cp-attr-code in this-procedure (
     3114                                           input  p-code
     3115                                           ,output v-type
     3116                                           ,output v-format
     3117                                           ,output v-label
     3118                                           ,output v-range
     3119                                           ,output v-user-can-edit
     3120                                           ,output v-output-display
     3121                                           ,output v-other
     3122                                           ) no-error .
     3123       if error-status :error then do:
     3124         undo, return error return-value .
     3125       end.
     3126       find first buf_temp-hattr exclusive-lock
     3127         where buf_temp-hattr.cdpay-code = p-cdpay-code
     3128           and buf_temp-hattr.curr-code  = p-curr-code
     3129           and buf_temp-hattr.host-code  = p-host-code
     3130           and buf_temp-hattr.obj-type   = (if v-version = 14.0 then '':U else p-obj-type)
     3131           and (v-version = 14.0 or buf_temp-hattr.obj-code   = p-obj-code)
     3132           and buf_temp-hattr.attr-code = p-code
     3133         no-error .
     3134       if  available buf_temp-hattr then do:
     3135         p-exist = yes.
     3136       end.
     3137     end.
     3138   END PROCEDURE.
