     1962       end.
     1963       assign
     1964         v-diasize-need-full-display = true
     1965       .
     1966       if v-diasize-change-size = false
     1967       then do:
     1968         assign
     1969           v-diasize-change-size = true
     1970         .
     1971       end.
     1972       else do:
     1973         return .
     1974       end.
     1975       assign
     1976         v-frame-width = frame Dialog-Frame :width
     1977         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1978         v-browse-width = v-diasize-browse-handle :width
     1979       .
     1980       for each buf_temp-browse-handle
     1981         where buf_temp-browse-handle.browse-type = 'width':u
     1982       :
     1983         assign
