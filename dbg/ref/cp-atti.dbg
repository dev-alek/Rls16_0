     1929               frame Dialog-Frame :width = v-frame-width
     1930             .
     1931             for each buf_temp-browse-handle
     1932               where buf_temp-browse-handle.browse-type = 'width':u
     1933             on error undo, next
     1934             :
     1935               assign
     1936                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1937               .
     1938             end.
     1939             assign
