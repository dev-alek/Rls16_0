        1   DEFINE TEMP-TABLE Temp-hattr NO-UNDO LIKE ub.cash-pay-attr
        2          field user-can-edit as log
        3          field code as character
        4          field value_ as character.
        5   define input parameter parparentproc as widget-handle no-undo .
        6   define input parameter p-mode as char no-undo.
        7   define input parameter p-cdpay-code like ub.cash-pay-attr.cdpay-code no-undo.
        8   define input parameter p-curr-code  like ub.cash-pay-attr.curr-code no-undo .
        9   define input parameter p-host-code like ub.cash-pay-attr.host-code no-undo.
       10   define input parameter p-obj-type like ub.cash-pay-attr.obj-type no-undo.
       11   define input parameter p-obj-code like ub.cash-pay-attr.obj-code no-undo.
       12   define variable vss-revision    as character no-undo init "$Revision$":U .
       13   define variable vss-author      as character no-undo init "$Author$":U .
       14   define variable vss-date        as character no-undo init "$Date$":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       16   define variable vss-archive     as character no-undo init "$Archive$":U .
       17   define variable vss-description as character no-undo init "Атрибуты типа кассового платежа".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79     define variable v-cntxt-db-num        as integer   no-undo .
       80     define variable v-cntxt-userid        as character no-undo .
       81     define variable v-cntxt-level         as character no-undo .
       82     define variable v-cntxt-host-code-obj as integer   no-undo .
       83     define variable v-cntxt-obj-type      as character no-undo .
       84     define variable v-cntxt-obj-code      as integer   no-undo .
       85     define variable v-cntxt-db-num-obj    as integer   no-undo .
       86     define variable v-cntxt-is-admin      as logical   no-undo .
       87   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   procedure cur-time :
       90      define output parameter p-today as date      no-undo .
       91      define output parameter p-time  as integer   no-undo .
       92     do
       93     on error undo, return error
       94     :
       95       define variable v-date1 as date      no-undo .
       96       define variable v-date2 as date      no-undo .
       97       define variable v-time  as integer   no-undo .
       98       assign
       99         v-date1 = today
      100         v-time  = time
      101         v-date2 = today
      102       .
      103       if v-date1 <> v-date2
      104       then do:
      105         assign
      106           v-date1 = today
      107           v-time  = v-time
      108         .
      109       end.
      110       assign
      111         p-today = v-date1
      112         p-time  = v-time
      113       .
      114     end.
      115   end.
      116   function cur-time-date returns character
      117   :
      118     return string(today, '99/99/9999':U) .
      119   end.
      120   function cur-time-mjd returns decimal
      121   :
      122     define variable v-date as date      no-undo .
      123     define variable v-time as integer   no-undo .
      124     run cur-time in this-procedure
      125       (output v-date
      126       ,output v-time
      127       ) .
      128     return integer(v-date) - 2400002 + (v-time / 86400) .
      129   end.
      130   function cur-time-get-ending-index returns integer
      131   (input p-number as integer
      132   )
      133   :
      134     if p-number < 0
      135     or p-number = ?
      136     then do:
      137       return 1 .
      138     end.
      139     define variable v-rest as integer   no-undo .
      140     assign
      141       p-number = p-number modulo 100
      142     .
      143     if p-number < 20
      144     then do:
      145       assign
      146         v-rest = p-number
      147       .
      148     end.
      149     else do:
      150       assign
      151         v-rest = p-number modulo 10
      152       .
      153     end.
      154     case v-rest :
      155       when 1
      156       then do:
      157         return 2 .
      158       end.
      159       when 2 or
      160       when 3 or
      161       when 4
      162       then do:
      163         return 3 .
      164       end.
      165       otherwise do:
      166         return 1 .
      167       end.
      168     end case .
      169   end.
      170   procedure cur-time-mjd-to-date :
      171      define input  parameter i-mjd-diff as decimal no-undo.
      172      define output parameter o-Date     as date    no-undo.
      173      define output parameter o-Time     as integer no-undo.
      174      define variable v-day-number as integer   no-undo .
      175      if    i-mjd-diff < 0
      176         or i-mjd-diff = ?
      177      then do:
      178         return "?" .
      179      end.
      180      assign
      181         v-day-number = truncate(i-mjd-diff,0).
      182         o-Date = date(v-day-number + 2400002).
      183         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      184     .
      185   end.
      186   function cur-time-mjd-to-string returns character
      187   (input p-mjd-diff as decimal
      188   )
      189   :
      190     define variable v-day-number as integer   no-undo .
      191     define variable v-seconds    as integer   no-undo .
      192     define variable v-hour       as integer   no-undo .
      193     define variable v-min        as integer   no-undo .
      194     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      195     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      196     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      197     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      198     if p-mjd-diff < 0
      199     or p-mjd-diff = ?
      200     then do:
      201       return "?" .
      202     end.
      203     assign
      204       v-day-number = integer(truncate(p-mjd-diff,0))
      205       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      206     .
      207     if v-seconds > 86400
      208     then do:
      209       assign
      210         v-seconds = 86400 - 1
      211       .
      212     end.
      213     if v-seconds < 0
      214     then do:
      215       assign
      216         v-seconds = 0
      217       .
      218     end.
      219     assign
      220       v-hour = truncate(v-seconds / 3600, 0)
      221     .
      222     assign
      223       v-seconds = v-seconds modulo 3600
      224     .
      225     assign
      226       v-min = truncate(v-seconds / 60, 0)
      227     .
      228     assign
      229       v-seconds = v-seconds modulo 60
      230     .
      231     return
      232         (if v-day-number <> 0
      233           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      234           else ""
      235         )
      236       + (if v-day-number <> 0 or v-hour <> 0
      237           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      238           else ""
      239         )
      240       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      241           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      242           else ""
      243         )
      244       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      245       .
      246   end.
      247   function cur-time-string returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      256   end.
      257   function cur-time-string-sec returns character
      258   :
      259     define variable v-date as date      no-undo .
      260     define variable v-time as integer   no-undo .
      261     run cur-time in this-procedure
      262       (output v-date
      263       ,output v-time
      264       ) .
      265     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      266   end.
      267   function cur-time-custom  returns character
      268   (input p-prefix as character
      269   ,input p-date-format as character
      270   ,input p-delimiter as character
      271   ,input p-time-format as character
      272   ,input p-suffix as character
      273   )
      274   :
      275     define variable v-date as date      no-undo .
      276     define variable v-time as integer   no-undo .
      277     run cur-time in this-procedure
      278       (output v-date
      279       ,output v-time
      280       ) .
      281     return
      282       p-prefix
      283       + string(v-date, p-date-format)
      284       + p-delimiter
      285       + string(v-time, p-time-format)
      286       + p-suffix
      287       .
      288   end.
      289   function cur-time-print  returns character
      290   :
      291     define variable v-date as date      no-undo .
      292     define variable v-time as integer   no-undo .
      293     run cur-time in this-procedure
      294       (output v-date
      295       ,output v-time
      296       ) .
      297     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      298   end.
      299   function cur-time-datetime returns datetime
      300   :
      301     define variable v-char as character no-undo .
      302     define variable v-datetime as datetime no-undo .
      303     v-char = cur-time-string().
      304     v-datetime = datetime(v-char).
      305     return  v-datetime.
      306   end.
      307   function cur-time-string-msec returns character
      308   :
      309     define variable v-date as datetime  no-undo .
      310     v-date = now.
      311     return string(v-date) .
      312   end.
      313   procedure cp-attr-code :
      314     do
      315     on error undo, return error
      316     :
      317       define input  parameter p-code           as character no-undo .
      318       define output parameter p-type           as character no-undo .
      319       define output parameter p-format         as character no-undo .
      320       define output parameter p-label          as character no-undo .
      321       define output parameter p-range          as integer   no-undo .
      322       define output parameter p-user-can-edit  as logical   no-undo .
      323       define output parameter p-output-display as logical   no-undo .
      324       define output parameter p-other          as character no-undo .
      325       case p-code :
      326               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      327               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
      328               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
      329               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
      330               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      331               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      332               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      333               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      334               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      335               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      336         otherwise do:
      337           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
      338         end.
      339       end.
      340     end.
      341   end procedure.
      342   procedure cp-attr-tooltip :
      343     do
      344     on error undo, return error
      345     :
      346       define input  parameter p-code    as character no-undo .
      347       define output parameter p-tooltip as character no-undo .
      348       define output parameter p-label   as character no-undo .
      349       case p-code :
      350               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
      351               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
      352               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
      353               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
      354               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
      355               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
      356               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
      357               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
      358               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
      359               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
      360         otherwise do:
      361           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
      362         end.
      363       end.
      364     end.
      365   end procedure.
      366   procedure cp-attr-value :
      367     do
      368     on error undo, return error
      369     :
      370       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      371       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      372       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      373       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      374       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      375       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
      376       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
      377       define output parameter p-type        as character no-undo .
      378       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      379       define variable v-format         as character no-undo .
      380       define variable v-label          as character no-undo .
      381       define variable v-range          as integer   no-undo .
      382       define variable v-user-can-edit  as logical   no-undo .
      383       define variable v-output-display as logical   no-undo .
      384       define variable v-other          as character no-undo .
      385       run cp-attr-code in this-procedure
      386         (input  p-code
      387         ,output p-type
      388         ,output v-format
      389         ,output v-label
      390         ,output v-range
      391         ,output v-user-can-edit
      392         ,output v-output-display
      393         ,output v-other
      394         ) no-error .
      395       if error-status :error then do:
      396         undo, return error return-value .
      397       end.
      398       find first buf_cash-pay-attr no-lock
      399         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      400           and buf_cash-pay-attr.curr-code  = p-curr-code
      401           and buf_cash-pay-attr.host-code  = p-host-code
      402           and buf_cash-pay-attr.obj-type   = p-obj-type
      403           and buf_cash-pay-attr.obj-code   = p-obj-code
      404           and buf_cash-pay-attr.attr-code  = p-code
      405         no-error .
      406       if avail buf_cash-pay-attr then do:
      407         assign
      408           p-value =  buf_cash-pay-attr.attr-value
      409         .
      410       end.
      411       else do:
      412         assign
      413           p-value = if p-type = 'L':U then "no":U else ""
      414         .
      415       end.
      416     end.
      417   end procedure.
      418   procedure cp-attr-write :
      419     do
      420     on error undo, return error
      421     :
      422       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      423       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      424       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      425       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      426       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      427       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      428       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
      429       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      430       define buffer last_cash-pay-attr for ub.cash-pay-attr .
      431       define variable v-type           as character no-undo .
      432       define variable v-format         as character no-undo .
      433       define variable v-label          as character no-undo .
      434       define variable v-range          as integer   no-undo .
      435       define variable v-user-can-edit  as logical   no-undo .
      436       define variable v-output-display as logical   no-undo .
      437       define variable v-other          as character no-undo .
      438       run cp-attr-code in this-procedure
      439         (input  p-code
      440         ,output v-type
      441         ,output v-format
      442         ,output v-label
      443         ,output v-range
      444         ,output v-user-can-edit
      445         ,output v-output-display
      446         ,output v-other
      447         ) no-error .
      448       if error-status :error then do:
      449         undo, return error return-value .
      450       end.
      451       find first buf_cash-pay-attr exclusive-lock
      452         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      453           and buf_cash-pay-attr.curr-code  = p-curr-code
      454           and buf_cash-pay-attr.host-code  = p-host-code
      455           and buf_cash-pay-attr.obj-type   = p-obj-type
      456           and buf_cash-pay-attr.obj-code   = p-obj-code
      457           and buf_cash-pay-attr.attr-code = p-code
      458         no-error .
      459       if not available buf_cash-pay-attr then do:
      460         create buf_cash-pay-attr .
      461         assign
      462         buf_cash-pay-attr.cdpay-code = p-cdpay-code
      463         buf_cash-pay-attr.curr-code  = p-curr-code
      464         buf_cash-pay-attr.host-code  = p-host-code
      465         buf_cash-pay-attr.obj-type   = p-obj-type
      466         buf_cash-pay-attr.obj-code   = p-obj-code
      467         buf_cash-pay-attr.attr-code = p-code
      468         .
      469       end.
      470       assign
      471         buf_cash-pay-attr.attr-value = p-value
      472       .
      473       release buf_cash-pay-attr no-error .
      474       if error-status:error then do:
      475         undo, return error return-value .
      476       end.
      477     end.
      478   end procedure.
      479   procedure cp-attr-exist :
      480     do
      481     on error undo, return error
      482     :
      483       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      484       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      485       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      486       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      487       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      488       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      489       define output parameter p-exist   as logical  no-undo .
      490       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      491       define variable v-type           as character no-undo .
      492       define variable v-format         as character no-undo .
      493       define variable v-label          as character no-undo .
      494       define variable v-range          as integer   no-undo .
      495       define variable v-user-can-edit  as logical   no-undo .
      496       define variable v-output-display as logical   no-undo .
      497       define variable v-other          as character no-undo .
      498       run cp-attr-code in this-procedure
      499         (input  p-code
      500         ,output v-type
      501         ,output v-format
      502         ,output v-label
      503         ,output v-range
      504         ,output v-user-can-edit
      505         ,output v-output-display
      506         ,output v-other
      507         ) no-error .
      508       if error-status :error then do:
      509         undo, return error return-value .
      510       end.
      511       find first buf_cash-pay-attr exclusive-lock
      512         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      513           and buf_cash-pay-attr.curr-code  = p-curr-code
      514           and buf_cash-pay-attr.host-code  = p-host-code
      515           and buf_cash-pay-attr.obj-type   = p-obj-type
      516           and buf_cash-pay-attr.obj-code   = p-obj-code
      517           and buf_cash-pay-attr.attr-code = p-code
      518         no-error .
      519       if  available buf_cash-pay-attr then do:
      520         p-exist = yes.
      521       end.
      522     end.
      523   end procedure.
      524   procedure cp-attr-delete :
      525     do
      526     on error undo, return error
      527     :
      528       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      529       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      530       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      531       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      532       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      533       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      534       define output parameter p-deleted  as logical no-undo.
      535       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      536       define variable v-type           as character no-undo .
      537       define variable v-format         as character no-undo .
      538       define variable v-label          as character no-undo .
      539       define variable v-range          as integer   no-undo .
      540       define variable v-user-can-edit  as logical   no-undo .
      541       define variable v-output-display as logical   no-undo .
      542       define variable v-other          as character no-undo .
      543       run cp-attr-code in this-procedure
      544         (input  p-code
      545         ,output v-type
      546         ,output v-format
      547         ,output v-label
      548         ,output v-range
      549         ,output v-user-can-edit
      550         ,output v-output-display
      551         ,output v-other
      552         ) no-error .
      553       if error-status :error then do:
      554         undo, return error return-value .
      555       end.
      556       find first buf_cash-pay-attr exclusive-lock
      557         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      558           and buf_cash-pay-attr.curr-code  = p-curr-code
      559           and buf_cash-pay-attr.host-code  = p-host-code
      560           and buf_cash-pay-attr.obj-type   = p-obj-type
      561           and buf_cash-pay-attr.obj-code   = p-obj-code
      562           and buf_cash-pay-attr.attr-code = p-code
      563         no-error NO-WAIT.
      564       if not available buf_cash-pay-attr then do:
      565         p-deleted = no.
      566       end.
      567       else do:
      568         delete buf_cash-pay-attr no-error .
      569         if error-status:error then do:
      570           undo, return error return-value .
      571         end.
      572         p-deleted = yes.
      573       end.
      574     end.
      575   end procedure.
      576   procedure cp-attr-news :
      577     do
      578     on error undo, return error
      579     :
      580       define input  parameter p-code           as character no-undo .
      581       define output parameter p-news           as logical   no-undo .
      582       case p-code :
      583               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
      584               when 'grp-code':U then do:     assign     p-news = true.   end.
      585               when 'is-use':U then do:     assign     p-news = true.   end.
      586               when 'dop-doc':U then do:     assign     p-news = true.   end.
      587               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
      588               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
      589               when 'form_km3':U then do:     assign     p-news = false.   end.
      590               when 'bal_malina':U then do:     assign     p-news = false.   end.
      591               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
      592               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
      593         otherwise do:
      594           p-news = no.
      595         end.
      596       end.
      597     end.
      598   end procedure.
