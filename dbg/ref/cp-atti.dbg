      619   procedure paycard-prefix :
      620   define input parameter p-cdpay-code like ub.cash-pay-attr.cdpay-code no-undo .
      621   define input parameter p-curr-code like ub.cash-pay-attr.curr-code no-undo .
      622   define input parameter p-host-code like ub.cash-pay-attr.host-code no-undo .
      623   define input parameter p-obj-type like ub.cash-pay-attr.obj-type no-undo .
      624   define input parameter p-obj-code like ub.cash-pay-attr.obj-code no-undo .
      625   define input-output parameter p-value as character no-undo .
      626   define output parameter p-setted as logical no-undo .
      627   DEFINE VARIABLE v-value as character no-undo .
      628   define variable v-codes as character no-undo .
      629   define variable v-labels as character no-undo .
      630   define variable v-ok as logical no-undo .
      631     do
      632     on error undo, return error
      633     :
      634       assign
      635       v-value = p-value
      636       .
      637       run ref/cpa-pcep.w (
      638                      input parparentproc
      639                     ,input p-cdpay-code
      640                     ,input p-curr-code
      641                     ,input p-host-code
      642                     ,input p-obj-type
      643                     ,input p-obj-code
      644                     ,input-output v-value
      645                     ,output v-ok
      646                      ) no-error .
      647       if
      648       v-ok and
      649       p-value <> v-value and v-value <> ? and not error-status:error then do:
      650         assign
      651         p-setted = yes
      652         p-value = v-value
      653         .
      654       end.
      655     end.
      656   end procedure.
      657   procedure is-use :
      658   define input parameter p-cdpay-code like ub.cash-pay-attr.cdpay-code no-undo .
      659   define input parameter p-curr-code like ub.cash-pay-attr.curr-code no-undo .
      660   define input parameter p-host-code like ub.cash-pay-attr.host-code no-undo .
      661   define input parameter p-obj-type like ub.cash-pay-attr.obj-type no-undo .
      662   define input parameter p-obj-code like ub.cash-pay-attr.obj-code no-undo .
      663   define input-output parameter p-value as character no-undo .
      664   define output parameter p-setted as logical no-undo .
      665   DEFINE VARIABLE v-value as character no-undo .
      666   define variable v-codes as character no-undo .
      667   define variable v-labels as character no-undo .
      668   define variable v-ok as logical no-undo .
      669     do
      670     on error undo, return error
      671     :
      672       assign
      673       v-value = p-value
      674       .
      675       if p-obj-type = 'скл':U then do:
      676         message
      677         substitute("Нельзя задать атрибут для объекта типа &1", p-obj-type)
      678         view-as alert-box error .
      679         return error.
      680       end.
      681       run ref/cpa-isus.w (
      682                      input parparentproc
      683                     ,input p-cdpay-code
      684                     ,input p-curr-code
      685                     ,input p-host-code
      686                     ,input p-obj-type
      687                     ,input p-obj-code
      688                     ,input-output v-value
      689                     ,output v-ok
      690                      ) no-error .
      691       if
      692       v-ok and
      693       p-value <> v-value and v-value <> ? and not error-status:error then do:
      694         assign
      695         p-setted = yes
      696         p-value = v-value
      697         .
      698       end.
      699     end.
      700   end procedure.
      701   procedure grp-code :
