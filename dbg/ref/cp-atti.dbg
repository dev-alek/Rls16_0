      816   procedure proc-alt-shift-f2:
      817     if not ibs.th.gbl.gbl-var:rcode
      818   then
      819     run gbl\inidebug.p .
      820   end.
      821   procedure proc-alt-shift-f3:
      822     run gbl/prvssinf.p
      823       ( input this-procedure
      824       ) .
      825   end.
      826   define variable v-inform-launched as logical no-undo initial false .
      827   procedure proc-alt-shift-f4:
      828     define variable v-action as character no-undo .
      829     if v-inform-launched = false then do:
      830       assign
      831         v-inform-launched = true
      832       .
      833       run gbl/d-inform.w
      834         (  input self
      835         ,  input this-procedure
      836         , output v-action
      837         ) no-error .
      838       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      839       assign
      840         v-inform-launched = false
      841       .
      842     end.
      843   end.
      844   procedure proc-alt-f1:
      845     run gbl/corrhelp.p
      846       (input this-procedure
      847       ) .
      848   end .
      849   on alt-shift-f2 anywhere do:
      850     run proc-alt-shift-f2.
      851   end.
      852   on alt-shift-f3 anywhere do:
      853     run proc-alt-shift-f3 in this-procedure .
      854   end.
      855   on alt-shift-f4 anywhere do:
      856     run proc-alt-shift-f4 in this-procedure.
      857   end.
      858   on alt-f1 anywhere do:
      859     run proc-alt-f1 in this-procedure .
      860   end.
      861   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      862   FUNCTION get-region RETURNS CHARACTER
      863     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      864     define variable par-region as character no-undo.
      865     if parhost-code = 0 and
      866          parobj-type = "":U and
      867          parobj-code = 0 then do:
      868          par-region = "Глобально".
      869          return par-region.
      870       end.
      871       if parobj-type = 'орг':U then do:
      872          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      873          return par-region.
      874       end.
      875       if parobj-type = 'регион':U
      876       then do:
      877          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      878          return par-region.
      879       end.
      880       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      881       return par-region.
      882   END FUNCTION.
      883   FUNCTION get-objregion RETURNS CHARACTER
      884     (  input parobj-type as character, input parobj-code as integer ) :
      885     define variable par-region as character no-undo.
      886     if  parobj-type = "":U and
      887         parobj-code = 0
      888     then do:
      889        par-region = "Глобально".
      890     end.
      891     else if parobj-type = 'орг':U
      892     then do:
      893        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      894     end.
      895     else if parobj-type = 'регион':U
      896     then do:
      897        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      898     end.
      899     else
      900        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      901     return par-region.
      902   END FUNCTION.
      903   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      904   define temp-table tt-attr-property  no-undo
      905   field upper-attr-code as character
      906   field attr-code as character
      907   field table-name as character
      908   field edit-menu-section-num as integer
      909   field attr-label as character
      910   field menu-item-handle as widget-handle
      911   field user-can-edit as logical
      912   field menu-name as character
      913   field parent-handle as handle
      914   index pi is unique primary
      915   table-name
      916   menu-name
      917   upper-attr-code
      918   attr-code
      919   index i-section
      920   edit-menu-section-num
      921   .
      922   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      923   procedure attr-pop-create-items :
      924   define input parameter p-table-name as character no-undo .
      925   define input parameter p-get-section-num-proc-name as character no-undo .
      926   define input parameter p-get-attr-label-proc-name as character no-undo .
      927   define input parameter p-attr-choose-proc-name as character no-undo .
      928   define input parameter p-menu-handle as widget-handle no-undo .
      929   define input parameter p-attr-list as character no-undo .
      930   define variable ii as integer no-undo .
      931   define variable V-CREATED as logical no-undo .
      932   define variable v-tool-tip as character no-undo .
      933   define variable v-dop as character no-undo .
      934   define variable v-attr-item as character no-undo .
      935   define variable p-upper-attr-code as character no-undo .
      936   define buffer buf_tt-attr-property for tt-attr-property.
      937     do
      938     on error undo, return error return-value
      939     :
      940        do ii = 1 to num-entries (p-attr-list):
      941          v-attr-item = entry(ii, p-attr-list) .
      942          find first tt-attr-property where
      943                    tt-attr-property.table-name = p-table-name
      944                and tt-attr-property.attr-code = v-attr-item
      945                and tt-attr-property.upper-attr-code = p-upper-attr-code
      946                and tt-attr-property.menu-name = p-menu-handle:name  no-error .
      947          if not available tt-attr-property then do:
      948            create tt-attr-property.
      949            assign
      950            tt-attr-property.table-name = p-table-name
      951            tt-attr-property.attr-code = v-attr-item
      952            tt-attr-property.upper-attr-code = p-upper-attr-code
      953            tt-attr-property.menu-name = p-menu-handle:name
      954            .
      955            run value ( p-get-section-num-proc-name) (
      956                                                      input tt-attr-property.attr-code
      957                                                     ,output tt-attr-property.edit-menu-section-num ) no-error .
      958            run value ( p-get-attr-label-proc-name ) (
      959                                           input tt-attr-property.attr-code
      960                                          ,output v-tool-tip
      961                                          ,output tt-attr-property.attr-label
      962                                         ) no-error .
      963            release tt-attr-property.
      964          end.
      965        end.
      966        for each tt-attr-property where tt-attr-property.menu-name = p-menu-handle:name
      967        break
      968        by  tt-attr-property.edit-menu-section-num
      969        by  tt-attr-property.attr-label
      970        :
      971          if tt-attr-property.edit-menu-section-num > 0
      972          then do:
      973             if not valid-handle(tt-attr-property.menu-item-handle) then do:
      974               if num-entries(tt-attr-property.attr-code, chr(4)) > 1
      975               and entry(2, tt-attr-property.attr-code, chr(4)) <> '':U
      976               then do:
      977                 find first buf_tt-attr-property where
      978                           buf_tt-attr-property.table-name = p-table-name
      979                       and buf_tt-attr-property.menu-name = p-menu-handle:name
      980                       and buf_tt-attr-property.upper-attr-code = p-upper-attr-code
      981                       and buf_tt-attr-property.attr-code = entry(1, tt-attr-property.attr-code, chr(4)) no-error .
      982                 if not available buf_tt-attr-property then do:
      983                   create buf_tt-attr-property.
      984                   assign
      985                   buf_tt-attr-property.table-name = p-table-name
      986                   buf_tt-attr-property.attr-code = entry(1, tt-attr-property.attr-code, chr(4))
      987                   buf_tt-attr-property.upper-attr-code = p-upper-attr-code
      988                   buf_tt-attr-property.menu-name = p-menu-handle:name
      989                   .
      990                   create sub-menu buf_tt-attr-property.menu-item-handle
      991                   assign
      992                   name = entry(1, tt-attr-property.attr-code, chr(4))  + chr(4)  + p-menu-handle:name
      993                   parent = p-menu-handle.
      994                 end.
      995                 create menu-item tt-attr-property.menu-item-handle
      996                 assign
      997                 label = tt-attr-property.attr-label
      998                 name = tt-attr-property.attr-code  + chr(4)  + p-menu-handle:name
      999                 parent = buf_tt-attr-property.menu-item-handle
     1000                 triggers:
     1001                   on choose
     1002                     persistent run value(p-attr-choose-proc-name + "-2") (
     1003                                                                            input  entry(1, tt-attr-property.attr-code, chr(4) )
     1004                                                                           ,input entry(2, tt-attr-property.attr-code, chr(4) )
     1005                                                                             ) .
     1006                 end triggers.
     1007                 assign
     1008                 v-created = yes.
     1009               end.
     1010               else do:
     1011                 create menu-item tt-attr-property.menu-item-handle
     1012                 assign
     1013                 label = tt-attr-property.attr-label
     1014                 name = entry(1, tt-attr-property.attr-code, chr(4)) + chr(4)  + p-menu-handle:name
     1015                 parent = p-menu-handle
     1016                 triggers:
     1017                   on choose
     1018                     persistent run value(p-attr-choose-proc-name) (
     1019                                                                    input  entry(1, tt-attr-property.attr-code, chr(4) )) .
     1020                 end triggers.
     1021                 assign
     1022                 v-created = yes.
     1023               end.
     1024             end.
     1025             if last-of(tt-attr-property.edit-menu-section-num)
     1026               then do:
     1027               find first buf_tt-attr-property where
     1028                         buf_tt-attr-property.table-name = p-table-name
     1029                    and  buf_tt-attr-property.attr-code = substitute("&1&2&3"
     1030                                                            , p-table-name
     1031                                                            , tt-attr-property.edit-menu-section-num
     1032                                                            , p-menu-handle:name
     1033                                                            )
     1034                     and buf_tt-attr-property.menu-name = p-menu-handle:name  no-error .
     1035               if not available buf_tt-attr-property then do:
     1036                 create buf_tt-attr-property.
     1037                 assign
     1038                 buf_tt-attr-property.table-name = p-table-name
     1039                 buf_tt-attr-property.edit-menu-section-num =  - 1
     1040                 buf_tt-attr-property.menu-name = p-menu-handle:name
     1041                 buf_tt-attr-property.upper-attr-code = ''
     1042                 buf_tt-attr-property.attr-code = substitute("&1&2&3"
     1043                                                             , p-table-name
     1044                                                             , tt-attr-property.edit-menu-section-num
     1045                                                             , p-menu-handle:name
     1046                                                             )
     1047                 .
     1048                 create menu-item buf_tt-attr-property.menu-item-handle
     1049                 assign
     1050                 subtype = "rule"
     1051                 parent = p-menu-handle
     1052                 .
     1053               end.
     1054             end.
     1055          end.
     1056        end.
     1057        if not v-created then do:
     1058           run attr-pop-clean-up in this-procedure ( input p-table-name).
     1059        end.
     1060     end.
     1061   end procedure.
     1062   procedure attr-pop-clean-up :
     1063   define input parameter p-table-name as character no-undo .
     1064     for each tt-attr-property where
     1065             tt-attr-property.table-name = p-table-name
     1066       and tt-attr-property.edit-menu-section-num > 0:
     1067       if valid-handle ( tt-attr-property.menu-item-handle) then do:
     1068         delete widget tt-attr-property.menu-item-handle.
     1069       end.
     1070       delete tt-attr-property.
     1071     end.
     1072     for each tt-attr-property where
     1073              tt-attr-property.table-name = p-table-name
     1074          and tt-attr-property.edit-menu-section-num =  - 1:
     1075       if valid-handle ( tt-attr-property.menu-item-handle) then do:
     1076         delete widget tt-attr-property.menu-item-handle.
     1077       end.
     1078       delete tt-attr-property.
     1079     end.
     1080   end procedure.
     1081   define variable updated as logical no-undo.
     1082   DEFINE VARIABLE added  as logical no-undo .
     1083   define variable add-option as char no-undo.
     1084   define variable temp-doc-rec as recid no-undo.
     1085   DEFINE MENU MENU-b-ins .
     1086   DEFINE BUTTON b-chg
     1087        LABEL "&Изменить":L
     1088        SIZE 10 BY 1 TOOLTIP "Изменить атрибут типа кассового платежа".
     1089   DEFINE BUTTON b-del
     1090        LABEL "&Удалить":L
     1091        SIZE 10 BY 1 TOOLTIP "Удалить  атрибут типа кассового платежа".
     1092   DEFINE BUTTON b-help
     1093        LABEL "Помо&щь":L
     1094        SIZE 10 BY 1.
     1095   DEFINE BUTTON b-ins
     1096        LABEL "&Добавить":L
     1097        SIZE 10 BY 1 TOOLTIP "Добавить атрибут типа кассового платежа".
     1098   DEFINE BUTTON b-lkp
     1099        LABEL "&Просмотр":L
     1100        SIZE 10 BY 1 TOOLTIP "Просмотр атрибута типа кассового платежа".
     1101   DEFINE BUTTON b-quit AUTO-GO
     1102        LABEL "&Выход ":L
     1103        SIZE 10 BY 1 TOOLTIP "Выход из режима".
     1104   DEFINE VARIABLE cd-cdpay-code AS INTEGER FORMAT ">>>9":U INITIAL 0
     1105        LABEL "Код типа платежа"
     1106         VIEW-AS TEXT
     1107        SIZE 9.63 BY 1
     1108        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1109   DEFINE VARIABLE cd-curr-code AS INTEGER FORMAT ">>9":U INITIAL 0
     1110        LABEL "Код валюты"
     1111         VIEW-AS TEXT
     1112        SIZE 6 BY 1
     1113        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1114   DEFINE VARIABLE v-obj-name AS CHARACTER FORMAT "X(256)":U
     1115         VIEW-AS TEXT
     1116        SIZE 55 BY 1
     1117        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1118   DEFINE QUERY BROWSE-2 FOR
     1119         Temp-hattr SCROLLING.
     1120   DEFINE BROWSE BROWSE-2
     1121     QUERY BROWSE-2 DISPLAY
     1122         Temp-hattr.attr-code COLUMN-LABEL "Атрибут" FORMAT "X(50)":U
     1123         get-region(temp-hattr.host-code, temp-hattr.obj-type, temp-hattr.obj-code) COLUMN-LABEL "Действует" FORMAT "X(12)":U
     1124               WIDTH 13
     1125         Temp-hattr.attr-value COLUMN-LABEL "Значение" FORMAT "X(45)":U
     1126       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 15.33.
     1127   DEFINE FRAME Dialog-Frame
     1128        b-quit AT ROW 1 COL 1
     1129        b-ins AT ROW 1 COL 21
     1130        b-lkp AT ROW 1 COL 31
     1131        b-chg AT ROW 1 COL 41
     1132        b-del AT ROW 1 COL 51
     1133        b-help AT ROW 1 COL 71
     1134        BROWSE-2 AT ROW 4.46 COL 1
     1135        v-obj-name AT ROW 2 COL 2.5 NO-LABEL
     1136        cd-cdpay-code AT ROW 3.25 COL 2.5
     1137        cd-curr-code AT ROW 3.25 COL 33.5
     1138        SPACE(48.24) SKIP(15.70)
     1139       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1140            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1141            TITLE "Атрибуты типа кассового платежа".
     1142   ASSIGN
     1143          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1144          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1145   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1146   DO:
     1147     APPLY "END-ERROR":U TO SELF.
     1148   END.
     1149   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1150   DO:
     1151     if not avail temp-hattr then return no-apply.
     1152     run proc-add-chg in this-procedure ( input no ) no-error.
     1153     if error-status:error then return no-apply.
     1154     RUN init-proc in this-procedure .
     1155   END.
     1156   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1157   DO:
     1158   define variable loc#log as logical no-undo.
     1159   define variable attr-type as character no-undo .
     1160   define variable attr-format as character no-undo .
     1161   define variable attr-label as character no-undo .
     1162   define variable attr-range as integer no-undo .
     1163   define variable attr-user-can-edit as logical no-undo .
     1164   define variable attr-output-display as logical no-undo .
     1165   define variable attr-other as char no-undo .
     1166   define variable glog as logical no-undo .
     1167   DEFINE VARIABLE v-check AS CHARACTER NO-UNDO.
     1168   define variable v-correct as logical no-undo .
     1169   define variable v-error-code as character no-undo .
     1170   DEFINE VARIABLE jj AS INTEGER NO-UNDO.
     1171     if not avail temp-hattr then return no-apply.
     1172     run cp-attr-code (
     1173       input  temp-hattr.code
     1174       ,output attr-type
     1175       ,output attr-format
     1176       ,output attr-label
     1177       ,output attr-range
     1178       ,output attr-user-can-edit
     1179       ,output attr-output-display
     1180       ,output attr-other
     1181       ) .
     1182     if not attr-user-can-edit then do:
     1183       message
     1184       "Атрибут нельзя удалить вручную"
     1185       view-as alert-box error .
     1186       return no-apply.
     1187     end.
     1188        do jj = 1 to num-entries(attr-other, chr(47)):
     1189       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "check":U then do:
     1190         assign
     1191         v-check = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     1192         .
     1193       end.
     1194     end.
     1195     if v-check <> "":U then do:
     1196       run value(v-check) (
     1197                          input p-cdpay-code
     1198                         ,input p-curr-code
     1199                         ,input temp-hattr.code
     1200                         ,input "0":U
     1201                         ,input 'удаление':U
     1202                         ,output v-correct
     1203                         ,output v-error-code) no-error.
     1204       if error-status:error then do:
     1205         message
     1206         "Ошибка при проверке корректности удаления атрибута" skip
     1207         error-status:get-message(1) skip
     1208         view-as alert-box error .
     1209         undo, return no-apply .
     1210       end.
     1211       if not v-correct then do:
     1212         message
     1213         "Удаление атрибута некорректно" skip
     1214         v-error-code
     1215         view-as alert-box error .
     1216         undo, return no-apply .
     1217       end.
     1218     end.
     1219     glog = no.
     1220     message
     1221     "Вы уверены, что хотите удалить атрибут " temp-hattr.attr-code skip
     1222     " для типа кассового платежа"
     1223     view-as alert-box QUESTIOn buttons YES-NO update glog.
     1224     if NOT glog then return no-apply.
     1225       run cp-attr-delete in this-procedure(
     1226                                       input p-cdpay-code
     1227                                       ,input p-curr-code
     1228                                       ,input temp-hattr.host-code
     1229                                       ,input temp-hattr.obj-type
     1230                                       ,input temp-hattr.obj-code
     1231                                       ,input temp-hattr.code
     1232                                       ,output loc#log) no-error .
     1233       if error-status:error or not loc#log then do:
     1234          message "Ошибка при удалении атрибута типа кассового платежа!"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     1235          return no-apply.
     1236       end.
     1237       delete temp-hattr.
     1238       updated = yes.
     1239       run init-proc in this-procedure .
     1240   END.
     1241   ON CHOOSE OF b-ins IN FRAME Dialog-Frame
     1242   DO:
     1243   define variable attr-type as character no-undo .
     1244   define variable attr-format as character no-undo .
     1245   define variable attr-label as character no-undo .
     1246   define variable attr-range as integer no-undo .
     1247   define variable attr-user-can-edit as logical no-undo .
     1248   define variable attr-output-display as logical no-undo .
     1249   define variable attr-other as char no-undo .
     1250   define variable loc#log as logical no-undo.
     1251   define buffer buf_temp-hattr for temp-hattr.
     1252   if add-option = "" then do:
     1253     run gbl/pop-up.p ( input self:handle, input no) no-error.
     1254   end.
     1255   if add-option = "":U then return no-apply.
     1256   run proc-add-chg in this-procedure ( input yes) no-error .
     1257   if error-status:error then do:
     1258     add-option = "":U.
     1259     return no-apply.
     1260   end.
     1261   Run init-proc in this-procedure .
     1262   find first buf_temp-hattr no-lock where
     1263                           buf_temp-hattr.code = add-option no-error.
     1264   add-option = "":U.
     1265   if avail buf_temp-hattr then
     1266       temp-doc-rec = recid(buf_temp-hattr).
     1267       else temp-doc-rec = ?.
     1268   reposition BROWSE-2 to recid temp-doc-rec no-error.
     1269   if error-status:error then return no-apply.
     1270   END.
     1271   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1272   DO:
     1273     IF not AVAILABLE temp-hattr then return no-apply.
     1274     RUN proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
     1275     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1276   END.
     1277   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1278   DO:
     1279   END.
     1280   ON MOUSE-SELECT-DBLCLICK OF BROWSE-2 IN FRAME Dialog-Frame
     1281   DO:
     1282     IF not AVAILABLE temp-hattr then return no-apply.
     1283     RUN proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
     1284     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1285   END.
     1286   ON RETURN OF BROWSE-2 IN FRAME Dialog-Frame
     1287   DO:
     1288     IF not AVAILABLE temp-hattr then return no-apply.
     1289     RUN proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
     1290     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1291   END.
     1292   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1293   on help of frame Dialog-Frame
     1294   do:
     1295     run gbl/app_help.p
     1296       (input this-procedure :file-name
     1297       ,input ''
     1298       ,input ?
     1299       ) no-error.
     1300     if error-status :error then do:
     1301       message
     1302         "Ошибка при вызове помощи"
     1303         error-status :get-message(1)
     1304         view-as alert-box .
     1305     end.
     1306   end.
     1307   run minbtn-set in this-procedure .
     1308   on choose of b-help in frame Dialog-Frame
     1309   do:
     1310     apply "help":u to frame Dialog-Frame .
     1311   end.
     1312   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1313   procedure minbtn-set :
     1314       do
     1315           on error undo, return error return-value
     1316           :
     1317           define variable ii              as integer       no-undo .
     1318           define variable fh              as widget-handle no-undo .
     1319           define variable hh              as widget-handle no-undo .
     1320           define variable v-h             as handle        extent 4 no-undo .
     1321           define variable v-name-button   as character     no-undo .
     1322           define variable v-help-old-x    as decimal       no-undo .
     1323           define variable v-help-old-y    as decimal       no-undo .
     1324           define variable v-help-old-size as decimal       no-undo .
     1325           define variable v-frame-width   as decimal       no-undo .
     1326           define variable jj              as integer       no-undo .
     1327           do
     1328               on error undo, return error
     1329               :
     1330               assign
     1331                   v-frame-width = frame Dialog-Frame:width - 0.3
     1332                   fh            = frame Dialog-Frame:first-child
     1333                   hh            = fh:first-child
     1334                   ii            = 1
     1335                   .
     1336               do while valid-handle(hh):
     1337                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1338                   do:
     1339                       case lc(hh:name) :
     1340                           when "b-help" then
     1341                               do:
     1342                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1343                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1344                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1345                                   hh:TOOLTIP = "Помощь" .
     1346                                   v-help-old-x = hh:column .
     1347                                   v-help-old-y = hh:row    .
     1348                                   v-help-old-size = hh:width .
     1349                                   hh:width-chars = 2.5 .
     1350                               end.
     1351                           when "b-print" then
     1352                               do:
     1353                                   hh:load-image("cmp/b-print.bmp":u) .
     1354                                   hh:TOOLTIP = "Печать" .
     1355                                   v-h[ii] = hh:handle .
     1356                                   ii = ii + 1 .
     1357                                   hh:width-chars = 3 .
     1358                               end.
     1359                           when "b-history" or
     1360                           when "b-hist" then
     1361                               do:
     1362                                   hh:load-image("cmp/b-hist.bmp":u) .
     1363                                   hh:TOOLTIP = "История" .
     1364                                   v-h[ii] = hh:handle .
     1365                                   ii = ii + 1 .
     1366                                   hh:width-chars = 3 .
     1367                               end.
     1368                           when "b-sch" then
     1369                               do:
     1370                                   hh:load-image("cmp/b-sch.bmp":u) .
     1371                                   hh:TOOLTIP = "Установка Фильтра" .
     1372                                   v-h[ii] = hh:handle .
     1373                                   ii = ii + 1 .
     1374                                   hh:width-chars = 3 .
     1375                               end.
     1376                           when "b-hist-user" then
     1377                               do:
     1378                                   hh:load-image("cmp/b-hist.bmp":u) .
     1379                                   hh:TOOLTIP = "История пользователя" .
     1380                                   ii = ii + 1 .
     1381                               end.
     1382                       end case.
     1383                   end.
     1384                   hh = hh:next-sibling.
     1385               end.
     1386               b-help:column = v-frame-width - b-help:width-chars.
     1387               jj = 0.
     1388               repeat ii = 4 to 1 by -1 :
     1389                   if valid-handle (v-h[ii] ) then
     1390                   do:
     1391                       jj  = jj + 1 .
     1392                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1393                       v-h[ii]:row    = v-help-old-y .
     1394                   end.
     1395               end.
     1396           end.
     1397       end.
     1398   end procedure.
     1399   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1400   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1401   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1402   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1403   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1404   define variable v-diasize-current-frame-height as decimal   no-undo .
     1405   define variable v-diasize-change-size          as logical   no-undo .
     1406   define variable v-diasize-resize-button        as handle    no-undo .
     1407   define variable v-diasize-wndmax               as logical   no-undo .
     1408   define variable v-diasize-wndstore             as logical   no-undo .
     1409   define variable v-diasize-proc-name            as character no-undo .
     1410   define variable v-diasize-browse-handle        as handle    no-undo .
     1411   define variable v-diasize-browse-number        as integer   no-undo .
     1412   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1413   define temp-table temp-diasize-handle no-undo
     1414     field handle-value  as handle
     1415     field save-position as decimal
     1416     index xpk is primary unique handle-value
     1417     .
     1418   define temp-table temp-browse-handle no-undo
     1419     field browse-type   as character
     1420     field browse-number as integer
     1421     field browse-handle as handle
     1422     field original-size as decimal
     1423     index xpk is primary unique browse-type browse-number
     1424     index xie browse-type browse-handle
     1425   .
     1426   procedure diasize_change-height :
     1427     define input  parameter p-change-value  as decimal   no-undo .
     1428     define input  parameter p-move-resize   as logical   no-undo .
     1429     define variable v-field-group-handle    as handle    no-undo .
     1430     define variable v-object-handle         as handle    no-undo .
     1431     define variable v-frame-height          as decimal   no-undo .
     1432     define variable v-frame-virtual-height  as decimal   no-undo .
     1433     define variable v-browse-height         as decimal   no-undo .
     1434     define variable v-window-height         as decimal   no-undo .
     1435     define variable v-window-virtual-height as decimal   no-undo .
     1436     define variable v-change-sign           as integer   no-undo .
     1437     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1438     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1439     if p-change-value > 0
     1440     then do:
     1441       if frame Dialog-Frame :height + p-change-value
     1442           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1443       then do:
     1444         assign
     1445           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1446                           - (frame Dialog-Frame :height-chars)
     1447         .
     1448         if p-change-value <= 0
     1449         then do:
     1450           run diasize_position-resize-button in this-procedure .
     1451           return .
     1452         end.
     1453       end.
     1454     end.
     1455     if p-change-value < 0
     1456     then do:
     1457       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1458       then do:
     1459         assign
     1460           p-change-value = v-diasize-orig-frame-height
     1461                          - (frame Dialog-Frame :height-chars)
     1462         .
     1463         if p-change-value >= 0
     1464         then do:
     1465           run diasize_position-resize-button in this-procedure .
     1466           return .
     1467         end.
     1468       end.
     1469     end.
     1470     if p-change-value >= 0
     1471     then do:
     1472       assign
     1473         v-change-sign = 1
     1474       .
     1475     end.
     1476     else do:
     1477       assign
     1478         v-change-sign = -1
     1479       .
     1480     end.
     1481     assign
     1482       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1483     .
     1484     if p-change-value = 0
     1485     then do:
     1486       run diasize_position-resize-button in this-procedure .
     1487       return .
     1488     end.
     1489     move_block:
     1490     do
     1491     on error undo move_block, retry move_block
     1492     :
     1493       if retry
     1494       then do:
     1495         do
     1496         on error undo move_block, leave move_block
     1497         :
     1498           if p-change-value > 0
     1499           then do:
     1500             for each buf_temp-diasize-handle
     1501             on error undo, next
     1502             :
     1503               assign
     1504                 v-object-handle = buf_temp-diasize-handle.handle-value
     1505               .
     1506               if v-object-handle <> v-diasize-resize-button
     1507               then do:
     1508                 assign
     1509                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1510                 .
     1511               end.
     1512             end.
     1513             assign
     1514               v-diasize-browse-handle :height = v-browse-height
     1515             .
     1516             for each buf_temp-browse-handle
     1517               where buf_temp-browse-handle.browse-type = 'height':u
     1518             on error undo, next
     1519             :
     1520               assign
     1521                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1522               .
     1523             end.
     1524             assign
     1525               frame Dialog-Frame :height = v-frame-height
     1526             .
     1527             if frame Dialog-Frame :scrollable = true
     1528             then do:
     1529               assign
     1530                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1531               .
     1532             end.
     1533             run diasize_position-resize-button in this-procedure .
     1534           end.
     1535           else do:
     1536             if frame Dialog-Frame :scrollable = true
     1537             then do:
     1538               assign
     1539                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1540               .
     1541             end.
     1542             assign
     1543               frame Dialog-Frame :height = v-frame-height
     1544             .
     1545             assign
     1546               v-diasize-browse-handle :height = v-browse-height
     1547             .
     1548             for each buf_temp-browse-handle
     1549               where buf_temp-browse-handle.browse-type = 'height':u
     1550             on error undo, next
     1551             :
     1552               assign
     1553                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1554               .
     1555             end.
     1556             for each buf_temp-diasize-handle
     1557             on error undo, next
     1558             :
     1559               assign
     1560                 v-object-handle = buf_temp-diasize-handle.handle-value
     1561               .
     1562               if v-object-handle <> v-diasize-resize-button
     1563               then do:
     1564                 assign
     1565                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1566                 .
     1567               end.
     1568             end.
     1569             run diasize_position-resize-button in this-procedure .
     1570           end.
     1571           assign
     1572             v-diasize-change-size = false
     1573           .
     1574           leave move_block .
     1575         end.
     1576       end.
     1577       assign
     1578         v-diasize-need-full-display = true
     1579       .
     1580       if v-diasize-change-size = false
     1581       then do:
     1582         assign
     1583           v-diasize-change-size = true
     1584         .
     1585       end.
     1586       else do:
     1587         return .
     1588       end.
     1589       assign
     1590         v-frame-height = frame Dialog-Frame :height
     1591         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1592         v-browse-height = v-diasize-browse-handle :height
     1593       .
     1594       for each buf_temp-browse-handle
     1595         where buf_temp-browse-handle.browse-type = 'height':u
     1596       :
     1597         assign
     1598           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1599         .
     1600       end.
     1601       for each buf_temp-diasize-handle
     1602       :
     1603         delete buf_temp-diasize-handle .
     1604       end.
     1605       assign
     1606         v-field-group-handle = frame Dialog-Frame :first-child
     1607       .
     1608       do while valid-handle(v-field-group-handle)
     1609       :
     1610         assign
     1611           v-object-handle = v-field-group-handle :first-child
     1612         .
     1613         do while valid-handle(v-object-handle)
     1614         :
     1615           if  v-object-handle <> v-diasize-browse-handle :handle
     1616           and can-query(v-object-handle, "row")
     1617           and can-query(v-object-handle, "height")
     1618           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1619           then do:
     1620             find first buf_temp-browse-handle
     1621               where buf_temp-browse-handle.browse-type   = 'height':u
     1622                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1623               no-error .
     1624             if available buf_temp-browse-handle
     1625             then do:
     1626             end.
     1627             else do:
     1628               create buf_temp-diasize-handle .
     1629               assign
     1630                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1631                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1632               .
     1633             end.
     1634           end.
     1635           assign
     1636             v-object-handle = v-object-handle :next-sibling
     1637           .
     1638         end.
     1639         assign
     1640           v-field-group-handle = v-field-group-handle :next-sibling
     1641         .
     1642       end.
     1643       do with frame Dialog-Frame
     1644       :
     1645         hide v-diasize-resize-button .
     1646         assign
     1647           v-diasize-resize-button :row    = 1
     1648           v-diasize-resize-button :column = 1
     1649         .
     1650       end.
     1651       if p-change-value > 0
     1652       then do:
     1653         if frame Dialog-Frame :scrollable = true
     1654         then do:
     1655           assign
     1656             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1657             no-error .
     1658           if error-status :error
     1659           or error-status :get-message(1) <> ""
     1660           then do:
     1661             undo move_block, retry move_block .
     1662           end.
     1663         end.
     1664         assign
     1665           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1666           no-error .
     1667         if error-status :error
     1668         or error-status :get-message(1) <> ""
     1669         then do:
     1670           undo move_block, retry move_block .
     1671         end.
     1672         assign
     1673           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1674           no-error .
     1675         if error-status :error
     1676         or error-status :get-message(1) <> ""
     1677         then do:
     1678           undo move_block, retry move_block .
     1679         end.
     1680         for each buf_temp-browse-handle
     1681           where buf_temp-browse-handle.browse-type = 'height':u
     1682         on error undo move_block, retry move_block
     1683         :
     1684           assign
     1685             buf_temp-browse-handle.browse-handle :height
     1686               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1687             no-error .
     1688           if error-status :error
     1689           or error-status :get-message(1) <> ""
     1690           then do:
     1691             undo move_block, retry move_block .
     1692           end.
     1693         end.
     1694         for each buf_temp-diasize-handle
     1695         on error undo move_block, retry move_block
     1696         :
     1697           assign
     1698             v-object-handle = buf_temp-diasize-handle.handle-value
     1699           .
     1700           if v-object-handle <> v-diasize-resize-button
     1701           then do:
     1702             assign
     1703               v-object-handle :row = v-object-handle :row + p-change-value
     1704               no-error .
     1705             if error-status :error
     1706             or error-status :get-message(1) <> ""
     1707             then do:
     1708               undo move_block, retry move_block .
     1709             end.
     1710           end.
     1711         end.
     1712       end.
     1713       else do:
     1714         for each buf_temp-diasize-handle
     1715         on error undo move_block, retry move_block
     1716         :
     1717           assign
     1718             v-object-handle = buf_temp-diasize-handle.handle-value
     1719           .
     1720           if v-object-handle <> v-diasize-resize-button
     1721           then do:
     1722             assign
     1723               v-object-handle :row = v-object-handle :row + p-change-value
     1724               no-error .
     1725             if error-status :error
     1726             or error-status :get-message(1) <> ""
     1727             then do:
     1728               undo move_block, retry move_block .
     1729             end.
     1730           end.
     1731         end.
     1732         assign
     1733           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1734           no-error .
     1735         if error-status :error
     1736         or error-status :get-message(1) <> ""
     1737         then do:
     1738           undo move_block, retry move_block .
     1739         end.
     1740         for each buf_temp-browse-handle
     1741           where buf_temp-browse-handle.browse-type = 'height':u
     1742         on error undo move_block, retry move_block
     1743         :
     1744           assign
     1745             buf_temp-browse-handle.browse-handle :height
     1746               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1747             no-error .
     1748           if error-status :error
     1749           or error-status :get-message(1) <> ""
     1750           then do:
     1751             undo move_block, retry move_block .
     1752           end.
     1753         end.
     1754         assign
     1755           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1756           no-error .
     1757         if error-status :error
     1758         or error-status :get-message(1) <> ""
     1759         then do:
     1760           undo move_block, retry move_block .
     1761         end.
     1762         if frame Dialog-Frame :scrollable = true
     1763         then do:
     1764           assign
     1765             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1766             no-error .
     1767           if error-status :error
     1768           or error-status :get-message(1) <> ""
     1769           then do:
     1770             undo move_block, retry move_block .
     1771           end.
     1772         end.
     1773       end.
     1774       if p-move-resize = true
     1775       then do:
     1776         run diasize_position-resize-button in this-procedure .
     1777       end.
     1778       if v-diasize-wndstore = true
     1779       then do:
     1780         if connected("ub") = true
     1781         then do:
     1782           define variable v-cntxt-db-num        as integer   no-undo .
     1783           define variable v-cntxt-userid        as character no-undo .
     1784           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1785                                             , OUTPUT v-cntxt-userid
     1786                                             ) .
     1787           run gbl/wndsizew.p
     1788             (input  v-cntxt-db-num
     1789             ,input  v-cntxt-userid
     1790             ,input  v-diasize-proc-name
     1791             ,input  'height':u
     1792             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1793             ) .
     1794         end.
     1795       end.
     1796     end.
     1797     assign
     1798       v-diasize-change-size = false
     1799     .
     1800   end procedure.
     1801   procedure diasize_set-height :
     1802     define input  parameter p-new-height  as decimal   no-undo .
     1803     define input  parameter p-move-resize as logical   no-undo .
     1804     do
     1805     on error undo, return error return-value
     1806     :
     1807       run diasize_change-height in this-procedure
     1808         (input  (p-new-height - frame Dialog-Frame :height)
     1809         ,input  p-move-resize
     1810         ) .
     1811     end.
     1812   end procedure.
     1813   procedure diasize_change-width :
     1814     define input  parameter p-change-value as decimal   no-undo .
     1815     define input  parameter p-move-resize  as logical   no-undo .
     1816     define variable v-field-group-handle   as handle    no-undo .
     1817     define variable v-object-handle        as handle    no-undo .
     1818     define variable v-frame-width          as decimal   no-undo .
     1819     define variable v-frame-virtual-width  as decimal   no-undo .
     1820     define variable v-browse-width         as decimal   no-undo .
     1821     define variable v-window-width         as decimal   no-undo .
     1822     define variable v-window-virtual-width as decimal   no-undo .
     1823     define variable v-change-sign          as integer   no-undo .
     1824     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1825     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1826     if p-change-value > 0
     1827     then do:
     1828       if frame Dialog-Frame :width + p-change-value >
     1829           session :width-chars
     1830       then do:
     1831         assign
     1832           p-change-value = session :width-chars - frame Dialog-Frame :width
     1833         .
     1834         if p-change-value <= 0
     1835         then do:
     1836           run diasize_position-resize-button in this-procedure .
     1837           return .
     1838         end.
     1839       end.
     1840     end.
     1841     if p-change-value < 0
     1842     then do:
     1843       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1844       then do:
     1845         assign
     1846           p-change-value = v-diasize-orig-frame-width
     1847                          - frame Dialog-Frame :width
     1848         .
     1849         if p-change-value >= 0
     1850         then do:
     1851           run diasize_position-resize-button in this-procedure .
     1852           return .
     1853         end.
     1854       end.
     1855     end.
     1856     if p-change-value >= 0
     1857     then do:
     1858       assign
     1859         v-change-sign = 1
     1860       .
     1861     end.
     1862     else do:
     1863       assign
     1864         v-change-sign = -1
     1865       .
     1866     end.
     1867     assign
     1868       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1869     .
     1870     if p-change-value = 0
     1871     then do:
     1872       run diasize_position-resize-button in this-procedure .
     1873       return .
     1874     end.
     1875     move_block:
     1876     do
     1877     on error undo move_block, leave move_block
     1878     :
     1879       if retry
     1880       then do:
     1881         do
     1882         on error undo move_block, leave move_block
     1883         :
     1884           if p-change-value > 0
     1885           then do:
     1886             for each buf_temp-diasize-handle
     1887             on error undo, next
     1888             :
     1889               assign
     1890                 v-object-handle = buf_temp-diasize-handle.handle-value
     1891               .
     1892               if v-object-handle <> v-diasize-resize-button
     1893               then do:
     1894                 assign
     1895                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1896                 .
     1897               end.
