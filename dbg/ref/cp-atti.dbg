      739   procedure cp-attr-manual-edit :
      740   do on error undo, return error return-value
      741     :
      742     define input  parameter p-code           as character no-undo .
      743     define output parameter p-section-num    as integer no-undo .
      744       case p-code :
      745               when 'paycard-export-prefix':U then do:     assign     p-section-num = 1.   end.
      746               when 'grp-code':U then do:     assign     p-section-num = 1.   end.
      747               when 'is-use':U then do:     assign     p-section-num = 1.   end.
      748               when 'dop-doc':U then do:     assign     p-section-num = 1.   end.
      749               when 'paycard-all-prefix':U then do:     assign     p-section-num = 1.   end.
      750               when 'form_km3':U then do:     assign     p-section-num = 1.   end.
      751               when 'bal_malina':U then do:     assign     p-section-num = 1.   end.
      752               when 'max_proc_sum':U then do:     assign     p-section-num = 1.   end.
      753               when 'mask_card_kup':U then do:     assign     p-section-num = 1.   end.
      754         otherwise do:
      755           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
      756         end.
      757       end.
      758     end.
      759   end procedure.
