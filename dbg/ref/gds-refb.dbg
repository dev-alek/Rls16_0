        1   block-level on error undo, throw.
        2   define input  parameter p-open-query     as logical   no-undo .
        3   define input  parameter p-find-next      as logical   no-undo .
        4   define input  parameter p-find-condition as character no-undo .
        5   define input  parameter a-n-c       as character no-undo .
        6   define input  parameter NameContext as character no-undo .
        7   define input  parameter rs-sort     as character no-undo .
        8   define input  parameter g-cond      as character no-undo .
        9   define input  parameter g-list      as character no-undo .
       10   define input  parameter g-stat      as character no-undo .
       11   define input  parameter g-grp       like ub.goods.grp-name no-undo.
       12   define input  parameter pobj-type   like ub.clients.obj-type no-undo.
       13   define input  parameter pobj-code   like ub.clients.obj-code no-undo.
       14   define parameter buffer g-producer for ub.clients.
       15   define parameter buffer cur-obj for ub.clients.
       16   define output parameter for-title as character no-undo .
       17   define input  parameter filter-point as character no-undo .
       18   define input  parameter filter-point0 as character no-undo .
       19   define input  parameter sort-column-name as character no-undo .
       20   define output parameter p-filter-name   as character  no-undo .
       21   define input-output parameter v-doc-rec as recid no-undo .
       22   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       23   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       24   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       25   define variable vss-workfile    as character no-undo init "$Workfile: gds-refb.p $":U .
       26   define variable vss-archive     as character no-undo init "$Archive: ref/gds-refb.p $":U .
       27   define variable vss-description as character no-undo init "Открытие запроса в справочнике товаров".
       28   procedure vss-get-info :
       29     define output parameter p-vss-revision    like vss-revision    no-undo .
       30     define output parameter p-vss-author      like vss-author      no-undo .
       31     define output parameter p-vss-date        like vss-date        no-undo .
       32     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       33     define output parameter p-vss-archive     like vss-archive     no-undo .
       34     define output parameter p-vss-description like vss-description no-undo .
       35     assign
       36       p-vss-revision    = vss-revision
       37       p-vss-author      = vss-author
       38       p-vss-date        = vss-date
       39       p-vss-workfile    = vss-workfile
       40       p-vss-archive     = vss-archive
       41       p-vss-description = vss-description
       42     .
       43   end procedure.
       44   procedure vss-get-parameters :
       45     define output parameter p-vss-parameters as character no-undo .
       46       assign
       47         p-vss-parameters = substitute('&1|&2':u,substitute('&1|&2|&3|&4|&5':u,a-n-c,NameContext,rs-sort,g-cond,g-list),substitute('&1|&2|&3|&4':u,g-stat,g-grp,pobj-type,pobj-code))
       48       .
       49   end procedure.
       50   define new global shared variable g#vssrevis-logger as handle    no-undo .
       51   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       52   define variable v-vssrevis-logger                   as handle    no-undo .
       53   procedure vss-logevent :
       54     define input  parameter p-extra-paramters as character no-undo .
       55     define variable v-vssrevis-parameters as character no-undo .
       56     do
       57     on error undo, return error return-value
       58     :
       59       if  valid-handle(v-vssrevis-logger)
       60       and v-vssrevis-logger :get-signature("logevent") <> ""
       61       then do:
       62         run vss-get-parameters in this-procedure
       63           (output v-vssrevis-parameters
       64           ).
       65         run logevent in v-vssrevis-logger
       66           (input vss-workfile
       67           ,input vss-revision
       68           ,input v-vssrevis-parameters
       69           ,input p-extra-paramters
       70           ).
       71       end.
       72     end.
       73   end procedure.
       74   assign
       75     v-vssrevis-logger = g#vssrevis-logger
       76   .
       77   if  valid-handle(v-vssrevis-logger)
       78   and v-vssrevis-logger :get-signature("logevent") <> ""
       79   then do:
       80     assign
       81       v-vssrevis-logevent = true
       82     .
       83     run vss-logevent in this-procedure (input vss-description) .
       84   end.
       85   define new global shared variable g#language as character no-undo .
       86   if g#language <> '' and g#language <> 'rus':U then do:
       87     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       88   end.
       89   DEFINE SHARED buffer gob-doc FOR ub.gds-obj.
       90   DEFINE SHARED buffer goo-doc FOR ub.goods.
       91   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   define variable v-fltopend-rowid as rowid extent 18 no-undo .
       94   procedure fltopend_fltopend :
       95   define input parameter p-parent-handle as handle no-undo .
       96   define input parameter p-qh as handle no-undo .
       97   define input parameter p-flt-open-open-query  as character no-undo .
       98   define input parameter p-where-cond as character no-undo .
       99   define input parameter p-use-indFIRST-query-tail as character no-undo .
      100   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      101   define input parameter p-indexed-reposition as character no-undo .
      102     do
      103     on error undo, return error
      104     :
      105   define variable v-prepare-string as character no-undo .
      106   define variable glog as logical no-undo .
      107   assign
      108   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      109                      p-where-cond + chr(32)  +
      110                      p-use-indFIRST-query-tail + chr(32) +
      111                      p-use-ind-sort-clmn-by + chr(32) +
      112                      p-indexed-reposition
      113   .
      114   assign
      115   glog = p-qh:query-prepare(v-prepare-string) no-error .
      116   if not glog
      117   or error-status:error then do:
      118     message error-status:get-message(1) view-as alert-box .
      119     undo, return error .
      120   end.
      121   assign
      122   glog = p-qh:query-open no-error .
      123   if not glog
      124   or error-status:error then do:
      125     message error-status:get-message(1) view-as alert-box .
      126     undo, return error .
      127   end.
      128     end.
      129   end procedure.
      130   procedure fltopend_fltfindd :
      131   define input parameter p-parent-handle as handle no-undo .
      132   define input parameter p-qh as handle no-undo .
      133   define input parameter p-rowid as rowid no-undo .
      134   define input parameter p-next as logical no-undo .
      135   define input parameter p-lock as integer no-undo .
      136   define input parameter p-bh as handle no-undo .
      137   define input parameter p-where-cond as character no-undo .
      138   define input parameter p-use-index-phrase as character no-undo .
      139   define variable glog as logical no-undo .
      140   define variable v-qh as handle no-undo .
      141   define variable v-bh as handle no-undo .
      142   define variable v-recid as recid no-undo .
      143   define variable v-prepare-string as character no-undo .
      144   do
      145   on error undo, return error
      146   on stop undo, return error
      147   :
      148     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      149     create buffer v-bh for table p-bh buffer-name p-bh:name.
      150     create query v-qh.
      151     v-qh:set-buffers(v-bh).
      152     v-prepare-string = substitute("for each &1 &2 &3"
      153                                     ,v-bh:name
      154                                     ,p-where-cond
      155                                     ,p-use-index-phrase).
      156     glog = v-qh:query-prepare(v-prepare-string) no-error.
      157     if not glog then do:
      158       delete object v-qh.
      159       delete object v-bh.
      160       undo, return error .
      161     end.
      162     glog = v-qh:query-open no-error .
      163     if not glog then do:
      164       delete object v-qh.
      165       delete object v-bh.
      166       undo, return error .
      167     end.
      168     if p-next then do:
      169       v-qh:reposition-to-rowid(p-rowid) no-error .
      170       glog = v-qh:get-next( p-lock) no-error .
      171       glog = v-qh:get-next( p-lock) no-error .
      172       if not glog or v-qh:query-off-end = yes then do:
      173         glog = v-qh:get-first( p-lock) no-error .
      174       end.
      175     end.
      176     else do:
      177       glog = v-qh:get-first( p-lock) no-error .
      178     end.
      179     v-recid = v-bh:recid no-error .
      180     delete object v-qh.
      181     delete object v-bh.
      182     return string(v-recid) .
      183   end.
      184   end procedure.
      185   procedure fltopend_fltfindq :
      186   define input parameter p-parent-handle as handle no-undo .
      187   define input parameter p-qh as handle no-undo .
      188   define input parameter p-next as logical no-undo .
      189   define input parameter p-lock as integer no-undo .
      190   define input parameter p-flt-open-open-query  as character no-undo .
      191   define input parameter p-where-cond as character no-undo .
      192   define input parameter p-use-indFIRST-query-tail as character no-undo .
      193   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      194   define input parameter p-indexed-reposition as character no-undo .
      195   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      196   define variable glog as logical no-undo .
      197   define variable v-qh as handle no-undo .
      198   define variable v-bh as handle no-undo extent 18.
      199   define variable v-rowid as rowid no-undo extent 18.
      200   define variable v-ii as integer no-undo .
      201   define variable v-prepare-string as character no-undo .
      202   do
      203   on error undo, return error
      204   on stop undo, return error
      205   :
      206     create query v-qh.
      207     do v-ii = 1 to p-qh:num-buffers:
      208       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      209       assign
      210       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      211       no-error.
      212       v-qh:add-buffer(v-bh[v-ii]).
      213     end.
      214     assign
      215     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      216                       p-where-cond + chr(32)  +
      217                       p-use-indFIRST-query-tail + chr(32) +
      218                       p-use-ind-sort-clmn-by + chr(32) +
      219                       p-indexed-reposition
      220     .
      221     glog = v-qh:query-prepare( v-prepare-string) no-error .
      222     if not glog then do:
      223       delete object v-qh.
      224       do v-ii = 1 to p-qh:num-buffers:
      225         delete object v-bh[v-ii].
      226       end.
      227       undo, return error .
      228     end.
      229     glog = v-qh:query-open no-error .
      230     if not glog then do:
      231       delete object v-qh.
      232       do v-ii = 1 to p-qh:num-buffers:
      233         delete object v-bh[v-ii].
      234       end.
      235       undo, return error .
      236     end.
      237     if p-next then do:
      238       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      239       glog = v-qh:get-next( p-lock) no-error .
      240       glog = v-qh:get-next( p-lock) no-error .
      241       if not glog or v-qh:query-off-end = yes then do:
      242         glog = v-qh:get-first( p-lock) no-error .
      243       end.
      244     end.
      245     else do:
      246       glog = v-qh:get-first( p-lock) no-error .
      247     end.
      248     do v-ii = 1 to p-qh:num-buffers:
      249       assign
      250       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      251       no-error.
      252     end.
      253     delete object v-qh.
      254     do v-ii = 1 to p-qh:num-buffers:
      255       delete object v-bh[v-ii].
      256     end.
      257   end.
      258   end procedure.
      259   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      260   define variable v-waitfram-action01         as character   no-undo .
      261   define variable v-waitfram-action02         as character   no-undo .
      262   define variable v-waitfram-action03         as character   no-undo .
      263   define variable mWaitFramTextBeg            as character   no-undo.
      264   define variable mWaitFramTextEnd            as character   no-undo.
      265   define variable mWaitFramView               as logical     no-undo.
      266   define variable mWaitProcEvent              as logical     no-undo init yes.
      267   define variable mWaitFramInterval           as integer     no-undo init 1 .
      268   define variable mWaitFramStop               as logical     no-undo.
      269   define variable mWaitFramStopUser           as logical     no-undo.
      270   define variable mWaitFramStopTimeOut        as logical     no-undo.
      271   define variable mWaitFramStartProc          as datetime-tz no-undo.
      272   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      273   define button B-WaitFramStop auto-end-key
      274        label "Стоп"
      275        size 10 by 1 tooltip "Остоновить процесс".
      276   define button B-viewProcInfo
      277        label "Информация"
      278        size 15 by 1 tooltip "Информация о процесс".
      279   define frame waitfram
      280     v-waitfram-action01 format "x(72)" no-label skip
      281     v-waitfram-action02 format "x(72)" no-label skip
      282     v-waitfram-action03 format "x(72)" no-label skip
      283     B-viewProcInfo
      284     B-WaitFramStop at row 4 col 30
      285     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      286     .
      287   define new global shared variable mBatchMode as logical no-undo init ?.
      288   define variable mFramBachModHandle as handle no-undo.
      289   mFramBachModHandle = frame waitfram:handle.
      290   define variable mFameOldVis as logical no-undo.
      291   define variable mVisCUrentVin as logical no-undo.
      292   if session:batch-mode
      293   then
      294      mBatchMode = yes.
      295   if mBatchMode = ? then do:
      296     mVisCUrentVin = current-window:visible.
      297     mFameOldVis = mFramBachModHandle:visible.
      298     mFramBachModHandle:visible  = yes.
      299     mBatchMode = mFramBachModHandle:visible ne yes.
      300     mFramBachModHandle:visible = mFameOldVis.
      301     current-window:visible = mVisCUrentVin.
      302   end.
      303    if  log-manager:logfile-name ne ?
      304     then DO:
      305         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      306         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      307         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      308     end.
      309   on choose of B-WaitFramStop in frame waitfram
      310   do:
      311     mWaitFramStop = yes.
      312     mWaitFramStopUser = yes.
      313   end.
      314   function waitfram-check-timeout returns logical():
      315      define variable vtime as int64 no-undo.
      316      if mWaitFramStopTimeOut
      317      then
      318         return yes.
      319      vtime = ( now - mWaitFramStartProc ) / 1000 .
      320      if     mWaitFramTimeOut ne ?
      321         and mWaitFramTimeOut ne 0
      322         and mWaitFramTimeOut lt vtime
      323      then do:
      324         mWaitFramStopTimeOut = yes.
      325      end.
      326      return mWaitFramStopTimeOut.
      327   end.
      328   procedure waitfram-hide :
      329     if not session:batch-mode
      330     then do
      331     on error undo, return error return-value
      332     :
      333       pause 0 before-hide .
      334       if not mBatchMode then
      335         hide frame waitfram .
      336     end.
      337   end procedure.
      338   procedure waitfram-show :
      339     define input  parameter p-message as character no-undo .
      340     define variable v-left-margin as integer   no-undo .
      341     if not session:batch-mode
      342     then do
      343     on error undo, return error return-value
      344     :
      345       if length(p-message) <= 70 then do:
      346         assign
      347           v-left-margin = integer((70 - length(p-message)) / 2)
      348         .
      349         assign
      350           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      351         .
      352         assign
      353           v-waitfram-action01 = " "
      354           v-waitfram-action02 = " "
      355                                    + fill(" ", v-left-margin)
      356                                    + p-message
      357           v-waitfram-action03 = " "
      358         .
      359       end.
      360       else do:
      361         define variable vRindex1 as integer no-undo.
      362         define variable vRindex2 as integer no-undo.
      363         vRindex1 = r-index(p-message," ",70).
      364         if vRindex1 = 0
      365         then
      366            vRindex1 = 70.
      367         if length(p-message)  <= vRindex1 + 70 then do:
      368           assign
      369             v-waitfram-action01 = " "
      370             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      371             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      372           .
      373         end.
      374         else do:
      375           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      376           if vRindex2 <= vRindex1
      377           then
      378              vRindex2 = vRindex1 + 70.
      379           assign
      380             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      381             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      382             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      383           .
      384         end.
      385       end.
      386       B-viewProcInfo:visible   in frame waitfram = no.
      387       B-viewProcInfo:sensitive in frame waitfram = no.
      388       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      389       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      390       if  (   mWaitFramView
      391          or  mWaitProcEvent)
      392          and not mBatchMode
      393       then
      394          display
      395             v-waitfram-action01 skip
      396             v-waitfram-action02 skip
      397             v-waitfram-action03 skip
      398          with frame waitfram .
      399     end.
      400   end procedure.
      401      procedure waitfram-show-this:
      402         define input  parameter iInterval as int64 no-undo.
      403         define variable vtime as int64 no-undo.
      404         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      405         mWaitFramInterval = iInterval.
      406         run waitfram-show (substitute("&1&2 &3&4" ,
      407                                       mWaitFramTextBeg ,
      408                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      409                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      410                                       mWaitFramTextEnd
      411                                      )
      412                           ).
      413      end.
      414      procedure WaitFramRunPause:
      415         define input  parameter iInterval as dec no-undo.
      416         define variable vStart  as datetime-tz no-undo.
      417         define variable vend    as datetime-tz no-undo.
      418         define variable vint as int64 no-undo.
      419         define variable vOk as logical no-undo.
      420         vStart = now.
      421         vend   = vStart.
      422         publish "WaitFramPause" (iInterval,output vOk).
      423         vend   =  now.
      424         vint = vend - vStart.
      425         vint = iInterval - vint / 1000.
      426         if     not mWaitFramStop
      427            and (   vint > 0
      428                 or (    not vOk
      429                     and iInterval eq ?
      430                     )
      431                 )
      432         then
      433            run waitfram-show-this (iInterval).
      434         vend   =  now.
      435         vint = vend - vStart.
      436         vint = iInterval - vint / 1000.
      437         if     not mWaitFramStop
      438            and vint > 0
      439         then do:
      440            run gbl/pause.p (vint * 1000).
      441         end.
      442         if iInterval ne ?
      443         then
      444            publish "WaitFramStop".
      445         waitfram-check-timeout().
      446      end.
      447      procedure WaitFramWaitFor:
      448         define input  parameter iInterval as dec no-undo.
      449         assign
      450            mWaitFramStartProc   = now
      451            mWaitFramStopUser    = no
      452            mWaitFramStopTimeOut = no
      453         .
      454         block-wait:
      455         do while not mWaitFramStop:
      456            run WaitFramRunPause (iInterval).
      457            if  waitfram-check-timeout()
      458            then do:
      459               leave block-wait.
      460            end.
      461         end.
      462         run waitfram-hide.
      463      end.
      464   procedure waitfram-join :
      465     define input  parameter p-line-1  as character no-undo .
      466     define input  parameter p-line-2  as character no-undo .
      467     define input  parameter p-line-3  as character no-undo .
      468     define output parameter p-message as character no-undo .
      469     do
      470     on error undo, return error return-value
      471     :
      472       assign
      473         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      474                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      475                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      476       .
      477     end.
      478   end procedure.
      479   function waitfram-join-function returns character
      480     (input p-line-1 as character
      481     ,input p-line-2 as character
      482     ,input p-line-3 as character
      483     ).
      484     define variable v-message as character no-undo .
      485     run waitfram-join in this-procedure
      486       (input  p-line-1
      487       ,input  p-line-2
      488       ,input  p-line-3
      489       ,output v-message
      490       ) .
      491     return v-message .
      492   end function .
      493   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      494   define new global shared variable g#attr-lib  as handle no-undo .
      495   define variable v-attr-lib-variable as handle no-undo .
      496   procedure gds-attr-name :
      497     define input  parameter p-code           as character no-undo .
      498     define output parameter p-type           as character no-undo .
      499     define output parameter p-format         as character no-undo .
      500     define output parameter p-label          as character no-undo .
      501     define output parameter p-user-can-edit  as logical   no-undo .
      502     define output parameter p-output-display as logical   no-undo .
      503     define output parameter p-other          as character no-undo .
      504     do
