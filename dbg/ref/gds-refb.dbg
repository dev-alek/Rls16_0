     1077   PROCEDURE Set-filter-name :
     1078   define input parameter v-filter-name as character no-undo .
     1079     assign
     1080     p-filter-name = v-filter-name
     1081     .
     1082   END PROCEDURE.
     1083   DEFINE SHARED QUERY br-gds FOR gob-doc  SCROLLING.
     1084   define variable l-open-query as logical   no-undo .
     1085   case sort-column-name :
     1086     when "" then do:
     1087       assign
     1088         sort-column-phrase = ""
     1089       .
     1090     end.
     1091     otherwise do:
     1092       assign
     1093         sort-column-phrase = "by " + sort-column-name
     1094       .
     1095     end.
     1096   end case.
     1097   define variable v-list-unit-name as character no-undo.
     1098   define variable v-list-gds-code-lgas as character no-undo.
     1099   define variable v-attr-type as character no-undo.
     1100   define variable v-attr-value as character no-undo.
     1101   CASE g-list :
     1102     when "ptrl" then do:
     1103       if a-n-c <> "context" OR NameContext = "" then do:
     1104         for-title = "ВСЕ товары".
     1105       for each ub.units no-lock where lookup( 'топ':U, ub.units.type) > 0:
     1106         v-list-unit-name = v-list-unit-name + ub.units.unit-name + chr(4).
     1107       end.
     1108       for each ub.goods no-lock where lookup (ub.goods.unit-base, v-list-unit-name, chr(4)) > 0:
     1109         run gds-attr-value in this-procedure
     1110           (  input ub.goods.gds-code
     1111             ,input 'fuel-type':U
     1112             ,output v-attr-value
     1113             ,output v-attr-type
     1114            ) .
     1115         if v-attr-value = "lgas" then
     1116         do:
     1117           v-list-gds-code-lgas = v-list-gds-code-lgas + string (ub.goods.gds-code) + chr(4).
     1118         end.
     1119       end.
     1120       v-list-unit-name = right-trim(v-list-unit-name,chr(4)).
     1121       v-list-gds-code-lgas = right-trim(v-list-gds-code-lgas,chr(4)).
     1122   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1123   define variable  l-disable-where-6  as logical   no-undo .
     1124   define variable  l-filter-open-6    as logical   .
     1125   define variable  flt-rec-6       as recid     no-undo .
     1126   define variable  filter-name-6      as character no-undo .
     1127   define variable  where-phrase-6     as character no-undo .
     1128   define variable  sort-phrase-6      as character no-undo .
     1129   define variable  where-phrase-rus-6 as character no-undo .
     1130   define variable  sort-phrase-rus-6  as character no-undo .
     1131     run waitfram-show in this-procedure
     1132       (input "ЖДИТЕ ..."
     1133       ).
     1134   run gbl/flt-get.p
     1135     (input filter-point
     1136     ,output flt-rec-6
     1137     ,output filter-name-6
     1138     ,output where-phrase-6
     1139     ,output sort-phrase-6
     1140     ,output where-phrase-rus-6
     1141     ,output sort-phrase-rus-6
     1142     ).
     1143   if p-open-query then do:
     1144       run set-filter-name in this-procedure
     1145         (INPUT filter-name-6
     1146         ) no-error .
     1147     assign
     1148       l-filter-open-6 = false
     1149     .
     1150     if flt-rec-6 <> ?
     1151     then do:
     1152       define variable  parameter-2-6 as character no-undo .
     1153       define variable  parameter-3-6 as character no-undo .
     1154       define variable  parameter-4-6 as character no-undo .
     1155       define variable  parameter-5-6 as character no-undo .
     1156       define variable  parameter-6-6 as character no-undo .
     1157       define variable  parameter-7-6 as character no-undo .
     1158         assign
     1159         parameter-3-6 =
     1160                                 "FOR EACH gob-doc no-lock"
     1161         parameter-4-6 =
     1162           (
     1163             if (" goo-doc.stts = 0 and lookup (goo-doc.unit-base, v-list-unit-name, chr(4)) > 0 and not lookup (string(goo-doc.gds-code),v-list-gds-code-lgas, chr(4)) > 0" + " " + where-phrase-6) <> ""
     1164             then " goo-doc.stts = 0 and lookup (goo-doc.unit-base, v-list-unit-name, chr(4)) > 0 and not lookup (string(goo-doc.gds-code),v-list-gds-code-lgas, chr(4)) > 0" + " " + where-phrase-6
     1165             else "true"
     1166           )
     1167         parameter-5-6 = (" " + "" + " " + "")
     1168         parameter-6-6 = if sort-phrase-6 = ''
     1169                              then
     1170           (
     1171           " " + "  " +
     1172           " " + " by goo-doc.artic                       BY GOO-DOC.PROD-TYPE                       BY goo-doc.prod-code "
     1173           )
     1174                              else
     1175           (
     1176           " " + "  " +
     1177           " " + sort-phrase-6
     1178           )
     1179         parameter-7-6 =
     1180           " indexed-reposition  "
     1181       .
     1182       do
     1183       on stop undo, leave
     1184       on error undo, leave
     1185       :
     1186         assign
     1187           l-disable-where-6 =
     1188             (" goo-doc.stts = 0 and lookup (goo-doc.unit-base, v-list-unit-name, chr(4)) > 0 and not lookup (string(goo-doc.gds-code),v-list-gds-code-lgas, chr(4)) > 0" + " " + where-phrase-6 = "")
     1189         .
     1190         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     1191                             ,input query br-gds:handle
     1192                             ,input parameter-3-6
     1193                             ,input parameter-4-6
     1194                             ,input parameter-5-6
     1195                             ,input parameter-6-6
     1196                             ,input parameter-7-6
     1197                             )
     1198         .
     1199         assign
     1200           l-filter-open-6 = true
     1201         .
     1202       end.
     1203       if l-filter-open-6 = false then do:
     1204         message
     1205           "Ошибка при фильтрации / сортировке" skip
     1206           "Будут показаны записи без учета фильтра" skip
     1207           view-as alert-box .
     1208       end.
     1209       else do:
     1210           assign
     1211             l-query-was-opened = true
     1212           .
     1213       end.
     1214     end.
     1215     if l-filter-open-6 = false then do:
     1216       OPEN QUERY br-gds FOR EACH gob-doc no-lock
     1217         where  goo-doc.stts = 0 and lookup (goo-doc.unit-base, v-list-unit-name, chr(4)) > 0 and not lookup (string(goo-doc.gds-code),v-list-gds-code-lgas, chr(4)) > 0
     1218          by goo-doc.artic                       BY GOO-DOC.PROD-TYPE                       BY goo-doc.prod-code
     1219         indexed-reposition
     1220     .
     1221         assign
     1222           l-query-was-opened = true
     1223         .
     1224     end.
     1225   end.
     1226   else do:
     1227     assign
     1228       v-doc-rec = recid( gob-doc )
     1229     .
     1230     do
     1231     on stop undo, leave
     1232     on error undo, leave
     1233     :
     1234       if query br-gds:handle:get-buffer-handle(1) = (buffer gob-doc:handle) then do:
     1235         assign
     1236         parameter-2-6 = (if p-find-next then "true":u else "false":u )
     1237         parameter-4-6 =
     1238           "where ":u + " goo-doc.stts = 0 and lookup (goo-doc.unit-base, v-list-unit-name, chr(4)) > 0 and not lookup (string(goo-doc.gds-code),v-list-gds-code-lgas, chr(4)) > 0" + " ":u + where-phrase-6 + " ":u + p-find-condition + " " + ""
     1239         parameter-5-6 = "  "
     1240       .
     1241         run fltopend_fltfindd in this-procedure  (
     1242                             input this-procedure:handle
     1243                             ,input query br-gds:handle
     1244                             ,input rowid(gob-doc)
     1245                             ,input logical(parameter-2-6)
     1246                             ,input no-lock
     1247                             ,input (buffer gob-doc:handle)
     1248                             ,input parameter-4-6
     1249                             ,input parameter-5-6
     1250                             ) no-error.
     1251         .
     1252         assign
     1253           v-doc-rec = integer(return-value)
     1254           v-fltopend-rowid[1] = ?
     1255         .
     1256       end.
     1257       else do:
     1258         assign
     1259         parameter-2-6 = (if p-find-next then "true":u else "false":u )
     1260         parameter-3-6 =  "FOR EACH gob-doc no-lock"
     1261         parameter-4-6 =
     1262           (
     1263             if (" goo-doc.stts = 0 and lookup (goo-doc.unit-base, v-list-unit-name, chr(4)) > 0 and not lookup (string(goo-doc.gds-code),v-list-gds-code-lgas, chr(4)) > 0" + " " + where-phrase-6) <> ""
     1264             then " goo-doc.stts = 0 and lookup (goo-doc.unit-base, v-list-unit-name, chr(4)) > 0 and not lookup (string(goo-doc.gds-code),v-list-gds-code-lgas, chr(4)) > 0" + " " + where-phrase-6
     1265             else "true"
     1266           )
     1267         parameter-5-6 = (" " + "" + " " + "" + " " + p-find-condition)
     1268         parameter-6-6 = if sort-phrase-6 = ''
     1269                              then
     1270           (
     1271           " " + "  " +
     1272           " " + " by goo-doc.artic                       BY GOO-DOC.PROD-TYPE                       BY goo-doc.prod-code "
     1273           )
     1274                              else
     1275           (
     1276           " " + "  " +
     1277           " " + sort-phrase-6
     1278           )
     1279         parameter-7-6 =
     1280           " indexed-reposition  "
     1281       .
     1282         run fltopend_fltfindq in this-procedure  (
     1283                             input this-procedure:handle
     1284                             ,input query br-gds:handle
     1285                             ,input logical(parameter-2-6)
     1286                             ,input no-lock
     1287                             ,input parameter-3-6
     1288                             ,input parameter-4-6
     1289                             ,input parameter-5-6
     1290                             ,input parameter-6-6
     1291                             ,input parameter-7-6
     1292                             ,output v-fltopend-rowid
     1293                             ) no-error.
     1294         .
     1295         v-doc-rec = ?.
     1296       end.
     1297       assign
     1298         l-query-was-opened = true
     1299       .
     1300     end.
     1301   end.
     1302     run waitfram-hide in this-procedure .
     1303       end.
     1304     end.
     1305     when "lgas" then do:
     1306       if a-n-c <> "context" OR NameContext = "" then do:
     1307         for-title = "ВСЕ товары".
     1308       for each ub.units no-lock where lookup( 'топ':U, ub.units.type) > 0:
     1309         v-list-unit-name = v-list-unit-name + ub.units.unit-name + chr(4).
     1310       end.
     1311       for each ub.goods no-lock where lookup (ub.goods.unit-base, v-list-unit-name, chr(4)) > 0:
     1312         run gds-attr-value in this-procedure
     1313           (  input ub.goods.gds-code
     1314             ,input 'fuel-type':U
     1315             ,output v-attr-value
     1316             ,output v-attr-type
     1317            ) .
     1318         if v-attr-value = "lgas" then
