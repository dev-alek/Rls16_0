    15398     if l-filter-open-156 = false then do:
    15399       OPEN QUERY br-gds FOR EACH gob-doc no-lock
    15400         where  gob-doc.grp-name begins g-grp and gob-doc.obj-type = pobj-type and gob-doc.obj-code = pobj-code                     and gob-doc.free-qnty <> 0 and gob-doc.stts <> 0
    15401          by gob-doc.free-qnty                     by gob-doc.artic
    15402         indexed-reposition
    15403     .
    15404         assign
    15405           l-query-was-opened = true
    15406         .
    15407     end.
    15408   end.
    15409   else do:
    15410     assign
    15411       v-doc-rec = recid( gob-doc )
    15412     .
    15413     do
    15414     on stop undo, leave
    15415     on error undo, leave
    15416     :
    15417       if query br-gds:handle:get-buffer-handle(1) = (buffer gob-doc:handle) then do:
    15418         assign
    15419         parameter-2-156 = (if p-find-next then "true":u else "false":u )
    15420         parameter-4-156 =
    15421           "where ":u +  substitute('gob-doc.grp-name begins &1&2&1  and gob-doc.obj-type = &1&3&1 and gob-doc.obj-code = &4                     and gob-doc.free-qnty <> 0 and gob-doc.stts <> 0 '                       , chr(34),                   g-grp, pobj-type, pobj-code) + " ":u + where-phrase-156 + " ":u + p-find-condition + " " + ""
    15422         parameter-5-156 = "  "
    15423       .
    15424         run fltopend_fltfindd in this-procedure  (
    15425                             input this-procedure:handle
    15426                             ,input query br-gds:handle
    15427                             ,input rowid(gob-doc)
    15428                             ,input logical(parameter-2-156)
    15429                             ,input no-lock
    15430                             ,input (buffer gob-doc:handle)
    15431                             ,input parameter-4-156
    15432                             ,input parameter-5-156
    15433                             ) no-error.
    15434         .
    15435         assign
    15436           v-doc-rec = integer(return-value)
    15437           v-fltopend-rowid[1] = ?
    15438         .
    15439       end.
    15440       else do:
    15441         assign
    15442         parameter-2-156 = (if p-find-next then "true":u else "false":u )
    15443         parameter-3-156 =  "FOR EACH gob-doc no-lock"
    15444         parameter-4-156 =
    15445           (
    15446             if (" gob-doc.grp-name begins g-grp and gob-doc.obj-type = pobj-type and gob-doc.obj-code = pobj-code                     and gob-doc.free-qnty <> 0 and gob-doc.stts <> 0 " + " " + where-phrase-156) <> ""
    15447             then  substitute('gob-doc.grp-name begins &1&2&1  and gob-doc.obj-type = &1&3&1 and gob-doc.obj-code = &4                     and gob-doc.free-qnty <> 0 and gob-doc.stts <> 0 '                       , chr(34),                   g-grp, pobj-type, pobj-code) + " " + where-phrase-156
    15448             else "true"
    15449           )
    15450         parameter-5-156 = (" " + "" + " " + "" + " " + p-find-condition)
    15451         parameter-6-156 = if sort-phrase-156 = ''
    15452                              then
    15453           (
    15454           " " + "  " +
    15455           " " + " by gob-doc.free-qnty                     by gob-doc.artic                     "
    15456           )
    15457                              else
    15458           (
    15459           " " + "  " +
    15460           " " + sort-phrase-156
    15461           )
    15462         parameter-7-156 =
    15463           " indexed-reposition  "
    15464       .
    15465         run fltopend_fltfindq in this-procedure  (
    15466                             input this-procedure:handle
    15467                             ,input query br-gds:handle
    15468                             ,input logical(parameter-2-156)
    15469                             ,input no-lock
    15470                             ,input parameter-3-156
    15471                             ,input parameter-4-156
    15472                             ,input parameter-5-156
    15473                             ,input parameter-6-156
    15474                             ,input parameter-7-156
    15475                             ,output v-fltopend-rowid
    15476                             ) no-error.
    15477         .
    15478         v-doc-rec = ?.
    15479       end.
    15480       assign
    15481         l-query-was-opened = true
    15482       .
    15483     end.
    15484   end.
    15485     run waitfram-hide in this-procedure .
    15486   END PROCEDURE.
