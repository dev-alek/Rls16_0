     1081        B-sch AT ROW 1 COL 11
     1082        B-Help AT ROW 1 COL 81.5
     1083        BR-docs AT ROW 2.21 COL 1.25
     1084        BR-changes AT ROW 12.5 COL 1
     1085        SPACE(0.00) SKIP(0.01)
     1086       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1087            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1088            TITLE "История Группы объектов для ценообразования"
     1089            CANCEL-BUTTON B-Cancel.
     1090   ASSIGN
     1091          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1092          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1093   ASSIGN
     1094          BR-docs:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1.
     1095   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1096   DO:
     1097     APPLY "END-ERROR":U TO SELF.
     1098   END.
     1099   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1100   DO:
     1101     run proc-b-sch in this-procedure no-error.
     1102     if not available buf_c-grp-obj-price then run OpenBr (yes, no, '':U).
     1103   END.
     1104   ON VALUE-CHANGED OF BR-docs IN FRAME Dialog-Frame
     1105   DO:
     1106   if available buf_c-grp-obj-price then do:
     1107     run proc-view-changes in this-procedure no-error.
     1108   end.
     1109   END.
     1110   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1111   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1112   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1113   on help of frame Dialog-Frame
     1114   do:
     1115     run gbl/app_help.p
     1116       (input this-procedure :file-name
     1117       ,input ''
     1118       ,input ?
     1119       ) no-error.
     1120     if error-status :error then do:
     1121       message
     1122         "Ошибка при вызове помощи"
     1123         error-status :get-message(1)
     1124         view-as alert-box .
     1125     end.
     1126   end.
     1127   run minbtn-set in this-procedure .
     1128   on choose of b-help in frame Dialog-Frame
     1129   do:
     1130     apply "help":u to frame Dialog-Frame .
     1131   end.
     1132   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1133   procedure minbtn-set :
     1134       do
     1135           on error undo, return error return-value
     1136           :
     1137           define variable ii              as integer       no-undo .
     1138           define variable fh              as widget-handle no-undo .
     1139           define variable hh              as widget-handle no-undo .
     1140           define variable v-h             as handle        extent 4 no-undo .
     1141           define variable v-name-button   as character     no-undo .
     1142           define variable v-help-old-x    as decimal       no-undo .
     1143           define variable v-help-old-y    as decimal       no-undo .
     1144           define variable v-help-old-size as decimal       no-undo .
     1145           define variable v-frame-width   as decimal       no-undo .
     1146           define variable jj              as integer       no-undo .
     1147           do
     1148               on error undo, return error
     1149               :
     1150               assign
     1151                   v-frame-width = frame Dialog-Frame:width - 0.3
     1152                   fh            = frame Dialog-Frame:first-child
     1153                   hh            = fh:first-child
     1154                   ii            = 1
     1155                   .
     1156               do while valid-handle(hh):
     1157                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1158                   do:
     1159                       case lc(hh:name) :
     1160                           when "b-help" then
     1161                               do:
     1162                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1163                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1164                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1165                                   hh:TOOLTIP = "Помощь" .
     1166                                   v-help-old-x = hh:column .
     1167                                   v-help-old-y = hh:row    .
     1168                                   v-help-old-size = hh:width .
     1169                                   hh:width-chars = 2.5 .
     1170                               end.
     1171                           when "b-print" then
     1172                               do:
     1173                                   hh:load-image("cmp/b-print.bmp":u) .
     1174                                   hh:TOOLTIP = "Печать" .
     1175                                   v-h[ii] = hh:handle .
     1176                                   ii = ii + 1 .
     1177                                   hh:width-chars = 3 .
     1178                               end.
     1179                           when "b-history" or
     1180                           when "b-hist" then
     1181                               do:
     1182                                   hh:load-image("cmp/b-hist.bmp":u) .
     1183                                   hh:TOOLTIP = "История" .
     1184                                   v-h[ii] = hh:handle .
     1185                                   ii = ii + 1 .
     1186                                   hh:width-chars = 3 .
     1187                               end.
     1188                           when "b-sch" then
     1189                               do:
     1190                                   hh:load-image("cmp/b-sch.bmp":u) .
     1191                                   hh:TOOLTIP = "Установка Фильтра" .
     1192                                   v-h[ii] = hh:handle .
     1193                                   ii = ii + 1 .
     1194                                   hh:width-chars = 3 .
     1195                               end.
     1196                           when "b-hist-user" then
     1197                               do:
     1198                                   hh:load-image("cmp/b-hist.bmp":u) .
     1199                                   hh:TOOLTIP = "История пользователя" .
     1200                                   ii = ii + 1 .
     1201                               end.
     1202                       end case.
     1203                   end.
     1204                   hh = hh:next-sibling.
     1205               end.
     1206               b-help:column = v-frame-width - b-help:width-chars.
     1207               jj = 0.
     1208               repeat ii = 4 to 1 by -1 :
     1209                   if valid-handle (v-h[ii] ) then
     1210                   do:
     1211                       jj  = jj + 1 .
     1212                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1213                       v-h[ii]:row    = v-help-old-y .
     1214                   end.
     1215               end.
     1216           end.
     1217       end.
     1218   end procedure.
     1219   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1220   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1221   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1222   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1223   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1224   define variable v-diasize-current-frame-height as decimal   no-undo .
     1225   define variable v-diasize-change-size          as logical   no-undo .
     1226   define variable v-diasize-resize-button        as handle    no-undo .
     1227   define variable v-diasize-wndmax               as logical   no-undo .
     1228   define variable v-diasize-wndstore             as logical   no-undo .
     1229   define variable v-diasize-proc-name            as character no-undo .
     1230   define variable v-diasize-browse-handle        as handle    no-undo .
     1231   define variable v-diasize-browse-number        as integer   no-undo .
     1232   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1233   define temp-table temp-diasize-handle no-undo
     1234     field handle-value  as handle
     1235     field save-position as decimal
     1236     index xpk is primary unique handle-value
     1237     .
     1238   define temp-table temp-browse-handle no-undo
     1239     field browse-type   as character
     1240     field browse-number as integer
     1241     field browse-handle as handle
     1242     field original-size as decimal
     1243     index xpk is primary unique browse-type browse-number
     1244     index xie browse-type browse-handle
     1245   .
     1246   procedure diasize_change-height :
     1247     define input  parameter p-change-value  as decimal   no-undo .
     1248     define input  parameter p-move-resize   as logical   no-undo .
     1249     define variable v-field-group-handle    as handle    no-undo .
     1250     define variable v-object-handle         as handle    no-undo .
     1251     define variable v-frame-height          as decimal   no-undo .
     1252     define variable v-frame-virtual-height  as decimal   no-undo .
     1253     define variable v-browse-height         as decimal   no-undo .
     1254     define variable v-window-height         as decimal   no-undo .
     1255     define variable v-window-virtual-height as decimal   no-undo .
     1256     define variable v-change-sign           as integer   no-undo .
     1257     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1258     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1259     if p-change-value > 0
     1260     then do:
     1261       if frame Dialog-Frame :height + p-change-value
     1262           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1263       then do:
     1264         assign
     1265           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1266                           - (frame Dialog-Frame :height-chars)
     1267         .
     1268         if p-change-value <= 0
     1269         then do:
     1270           run diasize_position-resize-button in this-procedure .
     1271           return .
     1272         end.
     1273       end.
     1274     end.
     1275     if p-change-value < 0
     1276     then do:
     1277       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1278       then do:
     1279         assign
     1280           p-change-value = v-diasize-orig-frame-height
     1281                          - (frame Dialog-Frame :height-chars)
     1282         .
     1283         if p-change-value >= 0
     1284         then do:
     1285           run diasize_position-resize-button in this-procedure .
     1286           return .
     1287         end.
     1288       end.
     1289     end.
     1290     if p-change-value >= 0
     1291     then do:
     1292       assign
     1293         v-change-sign = 1
     1294       .
     1295     end.
     1296     else do:
     1297       assign
     1298         v-change-sign = -1
     1299       .
     1300     end.
     1301     assign
     1302       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1303     .
     1304     if p-change-value = 0
     1305     then do:
     1306       run diasize_position-resize-button in this-procedure .
     1307       return .
     1308     end.
     1309     move_block:
     1310     do
     1311     on error undo move_block, retry move_block
     1312     :
     1313       if retry
     1314       then do:
     1315         do
     1316         on error undo move_block, leave move_block
     1317         :
     1318           if p-change-value > 0
     1319           then do:
     1320             for each buf_temp-diasize-handle
     1321             on error undo, next
     1322             :
     1323               assign
     1324                 v-object-handle = buf_temp-diasize-handle.handle-value
     1325               .
     1326               if v-object-handle <> v-diasize-resize-button
     1327               then do:
     1328                 assign
     1329                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1330                 .
     1331               end.
     1332             end.
     1333             assign
     1334               v-diasize-browse-handle :height = v-browse-height
     1335             .
     1336             for each buf_temp-browse-handle
     1337               where buf_temp-browse-handle.browse-type = 'height':u
     1338             on error undo, next
     1339             :
     1340               assign
     1341                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1342               .
     1343             end.
     1344             assign
     1345               frame Dialog-Frame :height = v-frame-height
     1346             .
     1347             if frame Dialog-Frame :scrollable = true
     1348             then do:
     1349               assign
     1350                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1351               .
     1352             end.
     1353             run diasize_position-resize-button in this-procedure .
     1354           end.
     1355           else do:
     1356             if frame Dialog-Frame :scrollable = true
     1357             then do:
     1358               assign
     1359                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1360               .
     1361             end.
     1362             assign
     1363               frame Dialog-Frame :height = v-frame-height
     1364             .
     1365             assign
     1366               v-diasize-browse-handle :height = v-browse-height
     1367             .
     1368             for each buf_temp-browse-handle
     1369               where buf_temp-browse-handle.browse-type = 'height':u
     1370             on error undo, next
     1371             :
     1372               assign
     1373                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1374               .
     1375             end.
     1376             for each buf_temp-diasize-handle
     1377             on error undo, next
     1378             :
     1379               assign
     1380                 v-object-handle = buf_temp-diasize-handle.handle-value
     1381               .
     1382               if v-object-handle <> v-diasize-resize-button
     1383               then do:
     1384                 assign
     1385                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1386                 .
     1387               end.
     1388             end.
     1389             run diasize_position-resize-button in this-procedure .
     1390           end.
     1391           assign
     1392             v-diasize-change-size = false
     1393           .
     1394           leave move_block .
     1395         end.
     1396       end.
     1397       assign
     1398         v-diasize-need-full-display = true
     1399       .
     1400       if v-diasize-change-size = false
     1401       then do:
     1402         assign
     1403           v-diasize-change-size = true
     1404         .
     1405       end.
     1406       else do:
     1407         return .
     1408       end.
     1409       assign
     1410         v-frame-height = frame Dialog-Frame :height
     1411         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1412         v-browse-height = v-diasize-browse-handle :height
     1413       .
     1414       for each buf_temp-browse-handle
     1415         where buf_temp-browse-handle.browse-type = 'height':u
     1416       :
     1417         assign
     1418           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1419         .
     1420       end.
     1421       for each buf_temp-diasize-handle
     1422       :
     1423         delete buf_temp-diasize-handle .
     1424       end.
     1425       assign
     1426         v-field-group-handle = frame Dialog-Frame :first-child
     1427       .
     1428       do while valid-handle(v-field-group-handle)
     1429       :
     1430         assign
     1431           v-object-handle = v-field-group-handle :first-child
     1432         .
     1433         do while valid-handle(v-object-handle)
     1434         :
     1435           if  v-object-handle <> v-diasize-browse-handle :handle
     1436           and can-query(v-object-handle, "row")
     1437           and can-query(v-object-handle, "height")
     1438           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1439           then do:
     1440             find first buf_temp-browse-handle
     1441               where buf_temp-browse-handle.browse-type   = 'height':u
     1442                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1443               no-error .
     1444             if available buf_temp-browse-handle
     1445             then do:
     1446             end.
     1447             else do:
     1448               create buf_temp-diasize-handle .
     1449               assign
     1450                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1451                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1452               .
     1453             end.
     1454           end.
     1455           assign
     1456             v-object-handle = v-object-handle :next-sibling
     1457           .
     1458         end.
     1459         assign
     1460           v-field-group-handle = v-field-group-handle :next-sibling
     1461         .
     1462       end.
     1463       do with frame Dialog-Frame
     1464       :
     1465         hide v-diasize-resize-button .
     1466         assign
     1467           v-diasize-resize-button :row    = 1
     1468           v-diasize-resize-button :column = 1
     1469         .
     1470       end.
     1471       if p-change-value > 0
     1472       then do:
     1473         if frame Dialog-Frame :scrollable = true
     1474         then do:
     1475           assign
     1476             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1477             no-error .
     1478           if error-status :error
     1479           or error-status :get-message(1) <> ""
     1480           then do:
     1481             undo move_block, retry move_block .
     1482           end.
     1483         end.
     1484         assign
     1485           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1486           no-error .
     1487         if error-status :error
     1488         or error-status :get-message(1) <> ""
     1489         then do:
     1490           undo move_block, retry move_block .
     1491         end.
     1492         assign
     1493           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1494           no-error .
     1495         if error-status :error
     1496         or error-status :get-message(1) <> ""
     1497         then do:
     1498           undo move_block, retry move_block .
     1499         end.
     1500         for each buf_temp-browse-handle
     1501           where buf_temp-browse-handle.browse-type = 'height':u
     1502         on error undo move_block, retry move_block
     1503         :
     1504           assign
     1505             buf_temp-browse-handle.browse-handle :height
     1506               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1507             no-error .
     1508           if error-status :error
     1509           or error-status :get-message(1) <> ""
     1510           then do:
     1511             undo move_block, retry move_block .
     1512           end.
     1513         end.
     1514         for each buf_temp-diasize-handle
     1515         on error undo move_block, retry move_block
     1516         :
     1517           assign
     1518             v-object-handle = buf_temp-diasize-handle.handle-value
     1519           .
     1520           if v-object-handle <> v-diasize-resize-button
     1521           then do:
     1522             assign
     1523               v-object-handle :row = v-object-handle :row + p-change-value
     1524               no-error .
     1525             if error-status :error
     1526             or error-status :get-message(1) <> ""
     1527             then do:
     1528               undo move_block, retry move_block .
     1529             end.
     1530           end.
     1531         end.
     1532       end.
     1533       else do:
     1534         for each buf_temp-diasize-handle
     1535         on error undo move_block, retry move_block
     1536         :
     1537           assign
     1538             v-object-handle = buf_temp-diasize-handle.handle-value
     1539           .
     1540           if v-object-handle <> v-diasize-resize-button
     1541           then do:
     1542             assign
     1543               v-object-handle :row = v-object-handle :row + p-change-value
     1544               no-error .
     1545             if error-status :error
     1546             or error-status :get-message(1) <> ""
     1547             then do:
     1548               undo move_block, retry move_block .
     1549             end.
     1550           end.
     1551         end.
     1552         assign
     1553           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1554           no-error .
     1555         if error-status :error
     1556         or error-status :get-message(1) <> ""
     1557         then do:
     1558           undo move_block, retry move_block .
     1559         end.
     1560         for each buf_temp-browse-handle
     1561           where buf_temp-browse-handle.browse-type = 'height':u
     1562         on error undo move_block, retry move_block
     1563         :
     1564           assign
     1565             buf_temp-browse-handle.browse-handle :height
     1566               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1567             no-error .
     1568           if error-status :error
     1569           or error-status :get-message(1) <> ""
     1570           then do:
     1571             undo move_block, retry move_block .
     1572           end.
     1573         end.
     1574         assign
     1575           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1576           no-error .
     1577         if error-status :error
     1578         or error-status :get-message(1) <> ""
     1579         then do:
     1580           undo move_block, retry move_block .
     1581         end.
     1582         if frame Dialog-Frame :scrollable = true
     1583         then do:
     1584           assign
     1585             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1586             no-error .
     1587           if error-status :error
     1588           or error-status :get-message(1) <> ""
     1589           then do:
     1590             undo move_block, retry move_block .
     1591           end.
     1592         end.
     1593       end.
     1594       if p-move-resize = true
     1595       then do:
     1596         run diasize_position-resize-button in this-procedure .
     1597       end.
     1598       if v-diasize-wndstore = true
     1599       then do:
     1600         if connected("ub") = true
     1601         then do:
     1602           define variable v-cntxt-db-num        as integer   no-undo .
     1603           define variable v-cntxt-userid        as character no-undo .
     1604           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1605                                             , OUTPUT v-cntxt-userid
     1606                                             ) .
     1607           run gbl/wndsizew.p
     1608             (input  v-cntxt-db-num
     1609             ,input  v-cntxt-userid
     1610             ,input  v-diasize-proc-name
     1611             ,input  'height':u
     1612             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1613             ) .
     1614         end.
     1615       end.
     1616     end.
     1617     assign
     1618       v-diasize-change-size = false
     1619     .
     1620   end procedure.
     1621   procedure diasize_set-height :
     1622     define input  parameter p-new-height  as decimal   no-undo .
     1623     define input  parameter p-move-resize as logical   no-undo .
     1624     do
     1625     on error undo, return error return-value
     1626     :
     1627       run diasize_change-height in this-procedure
     1628         (input  (p-new-height - frame Dialog-Frame :height)
     1629         ,input  p-move-resize
     1630         ) .
     1631     end.
     1632   end procedure.
     1633   procedure diasize_change-width :
     1634     define input  parameter p-change-value as decimal   no-undo .
     1635     define input  parameter p-move-resize  as logical   no-undo .
     1636     define variable v-field-group-handle   as handle    no-undo .
     1637     define variable v-object-handle        as handle    no-undo .
     1638     define variable v-frame-width          as decimal   no-undo .
     1639     define variable v-frame-virtual-width  as decimal   no-undo .
     1640     define variable v-browse-width         as decimal   no-undo .
     1641     define variable v-window-width         as decimal   no-undo .
     1642     define variable v-window-virtual-width as decimal   no-undo .
     1643     define variable v-change-sign          as integer   no-undo .
     1644     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1645     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1646     if p-change-value > 0
     1647     then do:
     1648       if frame Dialog-Frame :width + p-change-value >
     1649           session :width-chars
     1650       then do:
     1651         assign
     1652           p-change-value = session :width-chars - frame Dialog-Frame :width
     1653         .
     1654         if p-change-value <= 0
     1655         then do:
     1656           run diasize_position-resize-button in this-procedure .
     1657           return .
     1658         end.
     1659       end.
     1660     end.
     1661     if p-change-value < 0
     1662     then do:
     1663       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1664       then do:
     1665         assign
     1666           p-change-value = v-diasize-orig-frame-width
     1667                          - frame Dialog-Frame :width
     1668         .
     1669         if p-change-value >= 0
     1670         then do:
     1671           run diasize_position-resize-button in this-procedure .
     1672           return .
     1673         end.
     1674       end.
     1675     end.
     1676     if p-change-value >= 0
     1677     then do:
     1678       assign
     1679         v-change-sign = 1
     1680       .
     1681     end.
     1682     else do:
     1683       assign
     1684         v-change-sign = -1
     1685       .
     1686     end.
     1687     assign
     1688       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1689     .
     1690     if p-change-value = 0
     1691     then do:
     1692       run diasize_position-resize-button in this-procedure .
     1693       return .
     1694     end.
     1695     move_block:
     1696     do
     1697     on error undo move_block, leave move_block
     1698     :
     1699       if retry
     1700       then do:
     1701         do
     1702         on error undo move_block, leave move_block
     1703         :
     1704           if p-change-value > 0
     1705           then do:
     1706             for each buf_temp-diasize-handle
     1707             on error undo, next
     1708             :
     1709               assign
     1710                 v-object-handle = buf_temp-diasize-handle.handle-value
     1711               .
     1712               if v-object-handle <> v-diasize-resize-button
     1713               then do:
     1714                 assign
     1715                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1716                 .
     1717               end.
     1718             end.
     1719             assign
     1720               v-diasize-browse-handle :width = v-browse-width
     1721             .
     1722             for each buf_temp-browse-handle
     1723               where buf_temp-browse-handle.browse-type = 'width':u
     1724             on error undo, next
     1725             :
     1726               assign
     1727                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1728               .
     1729             end.
     1730             assign
     1731               frame Dialog-Frame :width = v-frame-width
     1732             .
     1733             if frame Dialog-Frame :scrollable = true
     1734             then do:
     1735               assign
     1736                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1737               .
     1738             end.
     1739             run diasize_position-resize-button in this-procedure .
     1740           end.
     1741           else do:
     1742             if frame Dialog-Frame :scrollable = true
     1743             then do:
     1744               assign
     1745                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1746               .
     1747             end.
     1748             assign
     1749               frame Dialog-Frame :width = v-frame-width
     1750             .
     1751             for each buf_temp-browse-handle
     1752               where buf_temp-browse-handle.browse-type = 'width':u
     1753             on error undo, next
     1754             :
     1755               assign
     1756                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1757               .
     1758             end.
     1759             assign
     1760               v-diasize-browse-handle :width = v-browse-width
     1761             .
     1762             for each buf_temp-diasize-handle
     1763             on error undo, next
     1764             :
     1765               assign
     1766                 v-object-handle = buf_temp-diasize-handle.handle-value
     1767               .
     1768               if v-object-handle <> v-diasize-resize-button
     1769               then do:
     1770                 assign
     1771                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1772                 .
     1773               end.
     1774             end.
     1775             run diasize_position-resize-button in this-procedure .
     1776           end.
     1777           assign
     1778             v-diasize-change-size = false
     1779           .
     1780           leave move_block .
     1781         end.
     1782       end.
     1783       assign
     1784         v-diasize-need-full-display = true
     1785       .
     1786       if v-diasize-change-size = false
     1787       then do:
     1788         assign
     1789           v-diasize-change-size = true
     1790         .
     1791       end.
     1792       else do:
     1793         return .
     1794       end.
     1795       assign
     1796         v-frame-width = frame Dialog-Frame :width
     1797         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1798         v-browse-width = v-diasize-browse-handle :width
     1799       .
     1800       for each buf_temp-browse-handle
     1801         where buf_temp-browse-handle.browse-type = 'width':u
     1802       :
     1803         assign
     1804           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1805         .
     1806       end.
     1807       for each buf_temp-diasize-handle
     1808       :
     1809         delete buf_temp-diasize-handle .
     1810       end.
     1811       assign
     1812         v-field-group-handle = frame Dialog-Frame :first-child
     1813       .
     1814       do while valid-handle(v-field-group-handle)
     1815       :
     1816         assign
     1817           v-object-handle = v-field-group-handle :first-child
     1818         .
     1819         do while valid-handle(v-object-handle)
     1820         :
     1821           if  v-object-handle <> v-diasize-browse-handle :handle
     1822           and v-object-handle <> v-diasize-resize-button
     1823           and can-query(v-object-handle, "row")
     1824           and can-query(v-object-handle, "height")
     1825           and ( v-object-handle :col + v-object-handle :width
     1826                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1827               )
     1828           then do:
     1829             find first buf_temp-browse-handle
     1830               where buf_temp-browse-handle.browse-type   = 'width':u
     1831                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1832               no-error .
     1833             if available buf_temp-browse-handle
     1834             then do:
     1835             end.
     1836             else do:
     1837               create buf_temp-diasize-handle .
     1838               assign
     1839                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1840                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1841               .
     1842             end.
     1843           end.
     1844           assign
     1845             v-object-handle = v-object-handle :next-sibling
     1846           .
     1847         end.
     1848         assign
     1849           v-field-group-handle = v-field-group-handle :next-sibling
     1850         .
     1851       end.
     1852       do with frame Dialog-Frame
     1853       :
     1854         hide v-diasize-resize-button .
     1855         v-diasize-resize-button :row = 1.
     1856         v-diasize-resize-button :column = 1.
     1857       end.
     1858       if p-change-value > 0
     1859       then do:
     1860         if frame Dialog-Frame :scrollable = true
     1861         then do:
     1862           assign
     1863             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1864             no-error .
     1865           if error-status :error
     1866           or error-status :get-message(1) <> ""
     1867           then do:
     1868             undo move_block, retry move_block.
     1869           end.
     1870         end.
     1871         assign
     1872           frame Dialog-Frame :width = v-frame-width + p-change-value
     1873           no-error .
     1874         if error-status :error
     1875         or error-status :get-message(1) <> ""
     1876         then do:
     1877           undo move_block, retry move_block.
     1878         end.
     1879         assign
     1880           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1881         no-error .
     1882         if error-status :error
     1883         or error-status :get-message(1) <> ""
     1884         then do:
     1885           undo move_block, retry move_block.
     1886         end.
     1887         for each buf_temp-browse-handle
     1888           where buf_temp-browse-handle.browse-type = 'width':u
     1889         on error undo move_block, retry move_block
     1890         :
     1891           assign
     1892             buf_temp-browse-handle.browse-handle :width
     1893               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1894             no-error .
     1895           if error-status :error
     1896           or error-status :get-message(1) <> ""
     1897           then do:
     1898             undo move_block, retry move_block .
     1899           end.
     1900         end.
     1901         for each buf_temp-diasize-handle
     1902         on error undo move_block, retry move_block
     1903         :
     1904           assign
     1905             v-object-handle = buf_temp-diasize-handle.handle-value
     1906           .
     1907           if v-object-handle <> v-diasize-resize-button
     1908           then do:
     1909             assign
     1910               v-object-handle :col = v-object-handle :col + p-change-value
     1911               no-error .
     1912             if error-status :error
     1913             or error-status :get-message(1) <> ""
     1914             then do:
     1915               undo move_block, retry move_block .
     1916             end.
     1917           end.
     1918         end.
     1919       end.
     1920       else do:
     1921         for each buf_temp-diasize-handle
     1922         on error undo move_block, retry move_block
     1923         :
     1924           assign
     1925             v-object-handle = buf_temp-diasize-handle.handle-value
     1926           .
     1927           if v-object-handle <> v-diasize-resize-button
     1928           then do:
     1929             assign
     1930               v-object-handle :col = v-object-handle :col + p-change-value
     1931               no-error .
     1932             if error-status :error
     1933             or error-status :get-message(1) <> ""
     1934             then do:
     1935               undo move_block, retry move_block .
     1936             end.
     1937           end.
     1938         end.
     1939         for each buf_temp-browse-handle
     1940           where buf_temp-browse-handle.browse-type = 'width':u
     1941         on error undo move_block, retry move_block
     1942         :
     1943           assign
     1944             buf_temp-browse-handle.browse-handle :width
     1945               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1946             no-error .
     1947           if error-status :error
     1948           or error-status :get-message(1) <> ""
     1949           then do:
     1950             undo move_block, retry move_block .
     1951           end.
     1952         end.
     1953         assign
     1954           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1955           no-error .
     1956         if error-status :error
     1957         or error-status :get-message(1) <> ""
     1958         then do:
     1959           undo move_block, retry move_block.
     1960         end.
     1961         assign
     1962           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1963         no-error .
     1964         if error-status :error
     1965         or error-status :get-message(1) <> ""
     1966         then do:
     1967           undo move_block, retry move_block.
     1968         end.
     1969         if frame Dialog-Frame :scrollable = true
     1970         then do:
     1971           assign
     1972             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1973           no-error .
     1974           if error-status :error
     1975           or error-status :get-message(1) <> ""
     1976           then do:
     1977             undo move_block, retry move_block.
     1978           end.
     1979         end.
     1980       end.
     1981       if p-move-resize
     1982       then do:
     1983         run diasize_position-resize-button in this-procedure .
     1984       end.
     1985       if v-diasize-wndstore = true
     1986       then do:
     1987         if connected("ub") = true
     1988         then do:
     1989           define variable v-cntxt-db-num        as integer   no-undo .
     1990           define variable v-cntxt-userid        as character no-undo .
     1991           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1992                                             , OUTPUT v-cntxt-userid
     1993                                             ) .
     1994           run gbl/wndsizew.p
     1995             (input  v-cntxt-db-num
     1996             ,input  v-cntxt-userid
     1997             ,input  v-diasize-proc-name
     1998             ,input  'width':u
     1999             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2000             ) .
     2001         end.
     2002       end.
     2003     end.
     2004     assign
     2005       v-diasize-change-size = false
     2006     .
     2007   end procedure.
     2008   procedure diasize_set-width :
     2009     define input  parameter p-new-width  as decimal   no-undo .
     2010     define input  parameter p-move-resize as logical   no-undo .
     2011     do
     2012     on error undo, return error return-value
     2013     :
     2014       run diasize_change-width in this-procedure
     2015         (input  (p-new-width - frame Dialog-Frame :width)
     2016         ,input  p-move-resize
     2017         ) .
     2018     end.
     2019   end procedure.
     2020   procedure diasize_position-resize-button :
     2021     do with frame Dialog-Frame
     2022     :
     2023       hide v-diasize-resize-button .
     2024       assign
     2025         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2026                     - 1
     2027                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2028         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2029                     - 1
     2030                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2031       .
     2032       view v-diasize-resize-button .
     2033     end.
     2034   end procedure.
     2035   on alt-right anywhere
     2036   do:
     2037     run diasize_change-width in this-procedure
     2038       (input 1
     2039       ,input true
     2040       ) .
     2041     return no-apply .
     2042   end.
     2043   on alt-left anywhere
     2044   do:
     2045     run diasize_change-width in this-procedure
     2046       (input -1
     2047       ,input true
     2048       ) .
     2049     return no-apply .
     2050   end.
     2051   on alt-down anywhere
     2052   do:
     2053     run diasize_change-height in this-procedure
     2054       (input 1
     2055       ,input true
     2056       ) .
     2057     return no-apply .
     2058   end.
     2059   on alt-up anywhere
     2060   do:
     2061     run diasize_change-height in this-procedure
     2062       (input -1
     2063       ,input true
     2064       ) .
     2065     return no-apply .
     2066   end.
     2067   on alt-enter of frame Dialog-Frame
     2068   do:
     2069     run diasize_maximize in this-procedure
     2070       (input  ?
     2071       ).
     2072     return no-apply .
     2073   end.
     2074   procedure diasize_end-move :
     2075     do
     2076     on error undo, return error return-value
     2077     :
     2078       define variable v-row-delta as decimal   no-undo .
     2079       define variable v-col-delta as decimal   no-undo .
     2080       define variable v-new-row as decimal   no-undo .
     2081       define variable v-new-col as decimal   no-undo .
     2082       assign
     2083         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2084         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2085       .
     2086       assign
     2087         v-row-delta = v-new-row - frame Dialog-Frame :height
     2088         v-col-delta = v-new-col - frame Dialog-Frame :width
     2089       .
     2090       run diasize_change-height in this-procedure
     2091         (input v-row-delta
     2092         ,input true
     2093         ) .
     2094       run diasize_change-width in this-procedure
     2095         (input v-col-delta
     2096         ,input true
     2097         ) .
     2098     end.
     2099   end procedure.
     2100   procedure diasize_maximize :
     2101     define input  parameter p-action as logical   no-undo .
     2102     do
     2103     on error undo, return error return-value
     2104     :
     2105       if p-action = ?
     2106       then do:
     2107         if v-diasize-need-maximize = true
     2108         then do:
     2109           assign
     2110             p-action = true
     2111           .
     2112         end.
     2113         else do:
     2114           assign
     2115             p-action = false
     2116           .
     2117         end.
     2118       end.
     2119       if p-action = true
     2120       then do:
     2121         run diasize_change-height in this-procedure
     2122           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2123               - frame Dialog-Frame :height-chars
     2124           ,input true
     2125           ) .
     2126         run diasize_change-width in this-procedure
     2127           (input session :width-chars
     2128               - frame Dialog-Frame :width-chars
     2129           ,input true
     2130           ) .
     2131         assign
     2132           v-diasize-need-maximize = false
     2133         .
     2134       end.
     2135       else do:
     2136         run diasize_change-width in this-procedure
     2137           (input v-diasize-orig-frame-width
     2138               - frame Dialog-Frame :width-chars
     2139           ,input true
     2140           ) .
     2141         run diasize_change-height in this-procedure
     2142           (input v-diasize-orig-frame-height
     2143               - frame Dialog-Frame :height-chars
     2144           ,input true
     2145           ) .
     2146         assign
     2147           v-diasize-need-maximize = true
     2148         .
     2149       end.
     2150     end.
     2151   end procedure.
     2152   procedure diasize_restore-orig-size :
     2153     do
     2154     on error undo, return error return-value
     2155     :
     2156       assign
     2157         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2158         v-diasize-current-frame-height = frame Dialog-Frame :height
     2159       .
     2160       run diasize_set-height in this-procedure
     2161         (input  v-diasize-orig-frame-height
     2162         ,input  true
     2163         ) .
     2164       run diasize_set-width in this-procedure
     2165         (input  v-diasize-orig-frame-width
     2166         ,input  true
     2167         ) .
     2168     end.
     2169   end procedure.
     2170   procedure diasize_restore-current-size :
     2171     do
     2172     on error undo, return error return-value
     2173     :
     2174       run diasize_set-height in this-procedure
     2175         (input  v-diasize-current-frame-height
     2176         ,input  true
     2177         ) .
     2178       run diasize_set-width in this-procedure
     2179         (input  v-diasize-current-frame-width
     2180         ,input  true
     2181         ) .
     2182     end.
     2183   end procedure.
     2184   procedure diasize_set-browse-handle :
     2185     define input  parameter p-browse-handle as handle   no-undo .
     2186     define buffer buf_temp-browse-handle for temp-browse-handle .
     2187     do
     2188     on error undo, return error return-value
     2189     :
     2190       assign
     2191         v-diasize-browse-handle = p-browse-handle
     2192       .
     2193       for each buf_temp-browse-handle
     2194       on error undo, return error return-value
     2195       :
     2196         delete buf_temp-browse-handle .
     2197       end.
     2198     end.
     2199   end procedure.
     2200   procedure diasize_add_browse :
     2201     define input  parameter p-browse-type   as character no-undo .
     2202     define input  parameter p-browse-handle as handle    no-undo .
     2203     define buffer buf_temp-browse-handle for temp-browse-handle .
     2204     do
     2205     on error undo, return error return-value
     2206     :
     2207       assign
     2208         v-diasize-browse-number = v-diasize-browse-number + 1
     2209       .
     2210       create buf_temp-browse-handle .
     2211       assign
     2212         buf_temp-browse-handle.browse-type   = p-browse-type
     2213         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2214         buf_temp-browse-handle.browse-handle = p-browse-handle
     2215       .
     2216     end.
     2217   end procedure.
     2218   procedure diasize_init :
     2219     define variable v-default-value    as logical   no-undo .
     2220     define variable v-restore-saved    as logical   no-undo .
     2221     define variable v-resize-value-str as character no-undo .
     2222     do
     2223     on error undo, return error return-value
     2224     :
     2225       do with frame Dialog-Frame
     2226       :
     2227         assign
     2228           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2229           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2230           v-diasize-browse-handle     = browse BR-changes :handle
     2231         .
     2232         create button v-diasize-resize-button
     2233         assign
     2234           parent        = frame Dialog-Frame :first-child
     2235           label         = "s"
     2236           height-pixels = 16
     2237           width-pixels  = 16
     2238           visible       = true
     2239           sensitive     = true
     2240           movable       = true
     2241           triggers:
     2242             on end-move persistent run diasize_end-move in this-procedure .
     2243           end triggers.
     2244         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2245         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2246         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2247         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2248         assign
     2249           v-diasize-wndmax = false
     2250         .
     2251         if connected("ub") = true
     2252         then do:
     2253           define variable v-cntxt-db-num        as integer   no-undo .
     2254           define variable v-cntxt-userid        as character no-undo .
     2255           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2256                                             , OUTPUT v-cntxt-userid
     2257                                             ) .
     2258           run gbl/wndpar_r.p
     2259             (input  v-cntxt-db-num
     2260             ,input  v-cntxt-userid
     2261             ,input  'wndmax':U
     2262             ,output v-diasize-wndmax
     2263             ,output v-default-value
     2264             ) .
     2265         end.
     2266         assign
     2267           v-diasize-wndstore = false
     2268         .
     2269         if connected("ub") = true
     2270         then do:
     2271           run gbl/wndpar_r.p
     2272             (input  v-cntxt-db-num
     2273             ,input  v-cntxt-userid
     2274             ,input  'wndstore':U
     2275             ,output v-diasize-wndstore
     2276             ,output v-default-value
     2277             ) .
     2278         end.
     2279         assign
     2280           v-diasize-proc-name = entry(1, program-name(2), '.')
     2281         .
     2282         if v-diasize-wndstore = true
     2283         then do:
     2284           assign
     2285             v-restore-saved = false
     2286           .
     2287           if connected("ub") = true
     2288           then do:
     2289             run gbl/wndsizer.p
     2290               (input  v-cntxt-db-num
     2291               ,input  v-cntxt-userid
     2292               ,input  v-diasize-proc-name
     2293               ,input  'height':u
     2294               ,output v-resize-value-str
     2295               ) .
     2296             if v-resize-value-str <> '':U
     2297             then do:
     2298               run diasize_change-height in this-procedure
     2299                 (input  integer(v-resize-value-str)
     2300                 ,input  true
     2301                 ) .
     2302               assign
     2303                 v-restore-saved = true
     2304               .
     2305             end.
     2306           end.
     2307           if connected("ub") = true
     2308           then do:
     2309             run gbl/wndsizer.p
     2310               (input  v-cntxt-db-num
     2311               ,input  v-cntxt-userid
     2312               ,input  v-diasize-proc-name
     2313               ,input  'width':u
     2314               ,output v-resize-value-str
     2315               ) .
     2316             if v-resize-value-str <> '':U
     2317             then do:
     2318               run diasize_change-width in this-procedure
     2319                 (input  integer(v-resize-value-str)
     2320                 ,input  true
     2321                 ) .
     2322               assign
     2323                 v-restore-saved = true
     2324               .
     2325             end.
     2326           end.
     2327           if v-restore-saved <> true
     2328           then do:
     2329             if v-diasize-wndmax = true
     2330             then do:
     2331               run diasize_maximize in this-procedure
     2332                 (input  true
     2333                 ) .
     2334             end.
     2335           end.
     2336         end.
     2337         else do:
     2338           if v-diasize-wndmax = true
     2339           then do:
     2340             run diasize_maximize in this-procedure
     2341               (input  true
     2342               ) .
     2343           end.
     2344         end.
     2345       end.
     2346     end.
     2347   end procedure.
     2348   procedure diasize_need-full-display :
     2349     define output parameter p-need-full-display as logical   no-undo .
     2350     do
     2351     on error undo, return error return-value
     2352     :
     2353       assign
     2354         p-need-full-display = v-diasize-need-full-display
     2355       .
     2356       assign
     2357         v-diasize-need-full-display = false
     2358       .
     2359     end.
     2360   end procedure.
     2361   procedure get-context :
     2362      define output parameter p-db-num as integer          no-undo.
     2363      define output parameter p-user-id as character        no-undo.
     2364      define variable v-login               as character    no-undo.
     2365      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2366      define buffer buf_user-login  for ub.user-login .
     2367      do
     2368      on error undo, return error
     2369      :
     2370            FIND FIRST buf_sys-ctrl no-lock.
     2371            ASSIGN
     2372               v-login = USERID("ub")
     2373               p-db-num = buf_sys-ctrl.db-num
     2374            .
     2375            FIND FIRST buf_user-login
     2376                 WHERE buf_user-login.db-num = p-db-num
     2377                   AND buf_user-login.user-login = v-login
     2378                 no-lock
     2379                 no-error
     2380                 .
     2381            IF AVAILABLE buf_user-login
     2382            THEN DO:
     2383               assign
     2384                  p-user-id = buf_user-login.user-id
     2385               .
     2386            END.
     2387      end.
     2388   end procedure.
     2389       run diasize_init in this-procedure .
     2390   MAIN-BLOCK:
     2391   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2392      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2393   define variable p-file-label as character no-undo .
     2394     p-file-label =  "История Группы объектов для ценообразования".
     2395   temp-changes.l_name:RESIZABLE in browse BR-changes = true .
     2396   temp-changes.v_old:RESIZABLE  in browse BR-changes = true .
     2397   temp-changes.v_new:RESIZABLE  in browse BR-changes = true .
     2398   define buffer buf_clients for  ub.clients .
     2399     RUN my-enable_UI.
     2400     RUn OpenBR(yes, no, '':U).
     2401     apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     2402     wait-for go of frame Dialog-Frame.
     2403   END.
     2404   RUN disable_UI.
     2405   PROCEDURE disable_UI :
     2406     HIDE FRAME Dialog-Frame.
     2407   END PROCEDURE.
     2408   PROCEDURE enable_UI :
     2409     ENABLE B-Cancel B-Help BR-docs BR-changes
     2410         WITH FRAME Dialog-Frame.
     2411     VIEW FRAME Dialog-Frame.
     2412     OPEN QUERY BR-docs FOR EACH buf_c-grp-obj-price no-lock.
     2413   END PROCEDURE.
     2414   PROCEDURE my-enable_UI :
     2415     ENABLE B-Cancel
     2416            B-sch
     2417            B-Help
     2418            BR-docs
     2419            BR-changes
     2420         WITH FRAME Dialog-Frame.
     2421     VIEW FRAME Dialog-Frame.
     2422   END PROCEDURE.
     2423   PROCEDURE OpenBr :
     2424   define input  parameter p-open-query     as logical   no-undo .
     2425   define input  parameter p-find-next      as logical   no-undo .
     2426   define input  parameter p-find-condition as character no-undo .
     2427   def var l-query-was-opened as logical no-undo .
     2428   define variable title0 as character no-undo.
     2429   title0 = caps(p-file-label) + chr(32).
     2430   def var sort-column-phrase as character no-undo .
     2431   case sort-column-name :
     2432     when "" then do:
     2433       assign
     2434         sort-column-phrase = ""
     2435       .
     2436     end.
     2437     otherwise do:
     2438       assign
     2439         sort-column-phrase = "by " + sort-column-name
     2440       .
     2441     end.
     2442   end case.
     2443   define variable l-open-query as logical   no-undo .
     2444          filter-point = filter-point0 .
     2445          ASSIGN frame Dialog-Frame:TITLE = title0 .
     2446   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2447   define variable  l-disable-where-15  as logical   no-undo .
     2448   define variable  l-filter-open-15    as logical   .
     2449   define variable  flt-rec-15       as recid     no-undo .
     2450   define variable  filter-name-15      as character no-undo .
     2451   define variable  where-phrase-15     as character no-undo .
     2452   define variable  sort-phrase-15      as character no-undo .
     2453   define variable  where-phrase-rus-15 as character no-undo .
     2454   define variable  sort-phrase-rus-15  as character no-undo .
     2455   run gbl/flt-get.p
     2456     (input filter-point
     2457     ,output flt-rec-15
     2458     ,output filter-name-15
     2459     ,output where-phrase-15
     2460     ,output sort-phrase-15
     2461     ,output where-phrase-rus-15
     2462     ,output sort-phrase-rus-15
     2463     ).
     2464   if p-open-query then do:
     2465       run set-filter-name in this-procedure
     2466         (INPUT filter-name-15
     2467         ) no-error .
     2468     assign
     2469       l-filter-open-15 = false
     2470     .
     2471     if flt-rec-15 <> ?
     2472       or sort-column-phrase > ""
     2473     then do:
     2474       define variable  parameter-2-15 as character no-undo .
     2475       define variable  parameter-3-15 as character no-undo .
     2476       define variable  parameter-4-15 as character no-undo .
     2477       define variable  parameter-5-15 as character no-undo .
     2478       define variable  parameter-6-15 as character no-undo .
     2479       define variable  parameter-7-15 as character no-undo .
     2480         assign
     2481         parameter-3-15 =
     2482                                 "FOR EACH buf_c-grp-obj-price"
     2483         parameter-4-15 =
     2484           (
     2485             if (" buf_c-grp-obj-price.gop-id = par-gop-id and buf_c-grp-obj-price.gop-db-num = par-gop-db-num " + " " + where-phrase-15) <> ""
     2486             then  substitute( ' buf_c-grp-obj-price.gop-id = &1 and buf_c-grp-obj-price.gop-db-num = &2 ' , par-gop-id , par-gop-db-num )  + " " + where-phrase-15
     2487             else "true"
     2488           )
     2489         parameter-5-15 = (" " + "" + " " + "")
     2490         parameter-6-15 = if sort-phrase-15 = ''
     2491                              then
     2492           (
     2493           " " + "  " +
     2494             " " + sort-column-phrase +
     2495           " " + "  "
     2496           )
     2497                              else
     2498           (
     2499           " " + "  " +
     2500             " " + sort-column-phrase +
     2501           " " + sort-phrase-15
     2502           )
     2503         parameter-7-15 =
     2504           " indexed-reposition  "
     2505       .
     2506       do
     2507       on stop undo, leave
     2508       on error undo, leave
     2509       :
     2510         assign
     2511           l-disable-where-15 =
     2512             (" buf_c-grp-obj-price.gop-id = par-gop-id and buf_c-grp-obj-price.gop-db-num = par-gop-db-num " + " " + where-phrase-15 = "")
     2513         .
     2514         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2515                             ,input query br-docs:handle
     2516                             ,input parameter-3-15
     2517                             ,input parameter-4-15
     2518                             ,input parameter-5-15
     2519                             ,input parameter-6-15
     2520                             ,input parameter-7-15
     2521                             )
     2522         .
     2523         assign
     2524           l-filter-open-15 = true
     2525         .
     2526       end.
     2527       if l-filter-open-15 = false then do:
     2528         message
     2529           "Ошибка при фильтрации / сортировке" skip
     2530           "Будут показаны записи без учета фильтра" skip
     2531           view-as alert-box .
     2532       end.
     2533       else do:
     2534           assign
     2535             l-query-was-opened = true
     2536           .
     2537       end.
     2538     end.
     2539     if l-filter-open-15 = false then do:
     2540       OPEN QUERY br-docs FOR EACH buf_c-grp-obj-price
     2541         where  buf_c-grp-obj-price.gop-id = par-gop-id and buf_c-grp-obj-price.gop-db-num = par-gop-db-num
     2542         indexed-reposition
     2543     .
     2544         assign
     2545           l-query-was-opened = true
     2546         .
     2547     end.
     2548   end.
     2549   else do:
     2550     assign
     2551       doc-rec = recid( buf_c-grp-obj-price )
     2552     .
     2553     do
     2554     on stop undo, leave
     2555     on error undo, leave
     2556     :
     2557       if query br-docs:handle:get-buffer-handle(1) = (buffer buf_c-grp-obj-price:handle) then do:
     2558         assign
     2559         parameter-2-15 = (if p-find-next then "true":u else "false":u )
     2560         parameter-4-15 =
     2561           "where ":u +  substitute( ' buf_c-grp-obj-price.gop-id = &1 and buf_c-grp-obj-price.gop-db-num = &2 ' , par-gop-id , par-gop-db-num )  + " ":u + where-phrase-15 + " ":u + p-find-condition + " " + ""
     2562         parameter-5-15 = "  "
     2563       .
     2564         run fltopend_fltfindd in this-procedure  (
     2565                             input this-procedure:handle
     2566                             ,input query br-docs:handle
     2567                             ,input rowid(buf_c-grp-obj-price)
     2568                             ,input logical(parameter-2-15)
     2569                             ,input no-lock
     2570                             ,input (buffer buf_c-grp-obj-price:handle)
     2571                             ,input parameter-4-15
     2572                             ,input parameter-5-15
     2573                             ) no-error.
     2574         .
     2575         assign
     2576           doc-rec = integer(return-value)
     2577           v-fltopend-rowid[1] = ?
     2578         .
     2579       end.
     2580       else do:
     2581         assign
     2582         parameter-2-15 = (if p-find-next then "true":u else "false":u )
     2583         parameter-3-15 =  "FOR EACH buf_c-grp-obj-price"
     2584         parameter-4-15 =
     2585           (
     2586             if (" buf_c-grp-obj-price.gop-id = par-gop-id and buf_c-grp-obj-price.gop-db-num = par-gop-db-num " + " " + where-phrase-15) <> ""
     2587             then  substitute( ' buf_c-grp-obj-price.gop-id = &1 and buf_c-grp-obj-price.gop-db-num = &2 ' , par-gop-id , par-gop-db-num )  + " " + where-phrase-15
     2588             else "true"
     2589           )
     2590         parameter-5-15 = (" " + "" + " " + "" + " " + p-find-condition)
     2591         parameter-6-15 = if sort-phrase-15 = ''
     2592                              then
     2593           (
     2594           " " + "  " +
     2595             " " + sort-column-phrase +
     2596           " " + "  "
     2597           )
     2598                              else
     2599           (
     2600           " " + "  " +
     2601             " " + sort-column-phrase +
     2602           " " + sort-phrase-15
     2603           )
     2604         parameter-7-15 =
     2605           " indexed-reposition  "
     2606       .
     2607         run fltopend_fltfindq in this-procedure  (
     2608                             input this-procedure:handle
     2609                             ,input query br-docs:handle
     2610                             ,input logical(parameter-2-15)
     2611                             ,input no-lock
     2612                             ,input parameter-3-15
     2613                             ,input parameter-4-15
     2614                             ,input parameter-5-15
     2615                             ,input parameter-6-15
     2616                             ,input parameter-7-15
     2617                             ,output v-fltopend-rowid
     2618                             ) no-error.
     2619         .
     2620         doc-rec = ?.
     2621       end.
     2622       assign
     2623         l-query-was-opened = true
     2624       .
     2625     end.
     2626   end.
     2627   if not p-open-query then
     2628   REPOSITION br-docs to recid doc-rec No-ERROR.
     2629   APPLY "VALUE-CHANGED" TO br-docs in frame Dialog-Frame.
     2630   APPLY "ENTRY" TO br-docs.
     2631   END PROCEDURE.
     2632   PROCEDURE proc-b-sch :
     2633   assign
     2634     tbl      = 'c-grp-obj-price'
     2635     join-tbl = 'buf_c-grp-obj-price'
     2636     fld = ""
     2637     lab = ""
     2638     spr = ""
     2639     dim = '0'
     2640     .
     2641   run fltfield-add in this-procedure('gop-id', 'Внутр.№', '',
     2642   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2643   Filter-Block:
     2644   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     2645       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     2646       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     2647     run gbl/filter.w ( INPUT parparentproc, INPUT filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     2648     run openbr (yes, no, '':u).
     2649   END.
     2650   END PROCEDURE.
     2651   PROCEDURE proc-find-code :
     2652   define input parameter par-next as logical no-undo.
     2653   define input parameter pargop-id as char no-undo.
     2654   END PROCEDURE.
     2655   PROCEDURE proc-view-changes :
     2656   define buffer old_c-grp-obj-price   for ub.c-grp-obj-price.
     2657   define buffer current_grp-obj-price for ub.grp-obj-price.
     2658   define variable v-chg-fields as character no-undo.
     2659   define variable v-old-fields as character no-undo.
     2660   define variable v-new-fields as character no-undo.
     2661   define variable ii as integer no-undo.
     2662   for each temp-changes:
     2663       delete temp-changes.
     2664   END.
     2665   if not available buf_c-grp-obj-price then do:
     2666     open query br-changes for each temp-changes.
     2667     return.
     2668   end.
     2669   find first old_c-grp-obj-price no-lock where
     2670              old_c-grp-obj-price.gop-id      = buf_c-grp-obj-price.gop-id and
     2671              old_c-grp-obj-price.gop-db-num  = buf_c-grp-obj-price.gop-db-num and
     2672              old_c-grp-obj-price.chip-num  <   buf_c-grp-obj-price.chip-num no-error.
     2673   if not available old_c-grp-obj-price then do:
     2674           find first current_grp-obj-price no-lock where
     2675                      current_grp-obj-price.gop-id      = buf_c-grp-obj-price.gop-id and
     2676                      current_grp-obj-price.gop-db-num  = buf_c-grp-obj-price.gop-db-num
     2677                      no-error.
     2678           if not available current_grp-obj-price then do:
     2679               return error.
     2680           end.
     2681           buffer-compare current_grp-obj-price  to buf_c-grp-obj-price
     2682           save result in v-chg-fields.
     2683   end.
     2684   else do:
     2685       buffer-compare old_c-grp-obj-price except chip-num corr-date corr-time corr-user-name corr-user-db-num to buf_c-grp-obj-price
     2686       save result in v-chg-fields.
     2687   end.
     2688   if num-entries(v-chg-fields) > 0 then do:
     2689   do ii = 1 to num-entries(v-chg-fields):
     2690   CASE entry(ii, v-chg-fields):
     2691    when "db-num-chg":U then do:     create temp-changes.       assign         temp-changes.f_name = "db-num-chg":U         temp-changes.l_name = "БД изм."         temp-changes.v_new  = string(buf_c-grp-obj-price.db-num-chg)         temp-changes.v_old  = (if available old_c-grp-obj-price                                  then string(old_c-grp-obj-price.db-num-chg)                                  else "Создание шапки" )         .   end.
     2692    when "name-group":U then do:     create temp-changes.       assign         temp-changes.f_name = "name-group":U         temp-changes.l_name = "Наименование"         temp-changes.v_new  = string(buf_c-grp-obj-price.name-group)         temp-changes.v_old  = (if available old_c-grp-obj-price                                  then string(old_c-grp-obj-price.name-group)                                  else "Создание шапки" )         .   end.
     2693    when "gop-db-num":U then do:     create temp-changes.       assign         temp-changes.f_name = "gop-db-num":U         temp-changes.l_name = "ДБ ТПЛ"         temp-changes.v_new  = string(buf_c-grp-obj-price.gop-db-num)         temp-changes.v_old  = (if available old_c-grp-obj-price                                  then string(old_c-grp-obj-price.gop-db-num)                                  else "Создание шапки" )         .   end.
     2694    when "gop-id":U then do:     create temp-changes.       assign         temp-changes.f_name = "gop-id":U         temp-changes.l_name = "№ группы"         temp-changes.v_new  = string(buf_c-grp-obj-price.gop-id)         temp-changes.v_old  = (if available old_c-grp-obj-price                                  then string(old_c-grp-obj-price.gop-id)                                  else "Создание шапки" )         .   end.
     2695    when "stts":U then do:     create temp-changes.       assign         temp-changes.f_name = "stts":U         temp-changes.l_name = "Статус"         temp-changes.v_new  = string(buf_c-grp-obj-price.stts)         temp-changes.v_old  = (if available old_c-grp-obj-price                                  then string(old_c-grp-obj-price.stts)                                  else "Создание шапки" )         .   end.
     2696    when "sys-date":U then do:     create temp-changes.       assign         temp-changes.f_name = "sys-date":U         temp-changes.l_name = "Дата"         temp-changes.v_new  = string(buf_c-grp-obj-price.sys-date)         temp-changes.v_old  = (if available old_c-grp-obj-price                                  then string(old_c-grp-obj-price.sys-date)                                  else "Создание шапки" )         .   end.
     2697    when "sys-time-chr":U then do:     create temp-changes.       assign         temp-changes.f_name = "sys-time-chr":U         temp-changes.l_name = "Время"         temp-changes.v_new  = string(buf_c-grp-obj-price.sys-time-chr)         temp-changes.v_old  = (if available old_c-grp-obj-price                                  then string(old_c-grp-obj-price.sys-time-chr)                                  else "Создание шапки" )         .   end.
     2698    when "sys-time":U then do:     create temp-changes.       assign         temp-changes.f_name = "sys-time":U         temp-changes.l_name = "Время (int)"         temp-changes.v_new  = string(buf_c-grp-obj-price.sys-time)         temp-changes.v_old  = (if available old_c-grp-obj-price                                  then string(old_c-grp-obj-price.sys-time)                                  else "Создание шапки" )         .   end.
     2699    when "who":U then do:     create temp-changes.       assign         temp-changes.f_name = "who":U         temp-changes.l_name = "Кто"         temp-changes.v_new  = string(buf_c-grp-obj-price.who)         temp-changes.v_old  = (if available old_c-grp-obj-price                                  then string(old_c-grp-obj-price.who)                                  else "Создание шапки" )         .   end.
     2700   END CASE.
     2701   end.
     2702   end.
     2703   define buffer old_c-db-grp-obj-price for ub.c-db-grp-obj-price  .
     2704   for each ub.c-db-grp-obj-price where
     2705            ub.c-db-grp-obj-price.gop-id      = buf_c-grp-obj-price.gop-id     and
     2706            ub.c-db-grp-obj-price.gop-db-num  = buf_c-grp-obj-price.gop-db-num and
     2707            ub.c-db-grp-obj-price.chip-num    = buf_c-grp-obj-price.chip-num
     2708            :
     2709        find first old_c-db-grp-obj-price no-lock where
     2710            old_c-db-grp-obj-price.gop-id      = ub.c-db-grp-obj-price.gop-id    and
     2711            old_c-db-grp-obj-price.gop-db-num  = ub.c-db-grp-obj-price.gop-db-num and
