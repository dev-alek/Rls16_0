       63   define input parameter par-gop-db-num as integer   no-undo .
       64   define variable  p-doc-type   as character no-undo .
       65   define variable  p-status_    as character no-undo .
       66   define variable  p-char       as character no-undo .
       67   define variable g-log        as logical no-undo .
       68   define variable doc-rec      as recid no-undo .
       69   define variable g#report-num as integer no-undo .
       70   define variable p-base-code as integer no-undo .
       71   define variable t-s         as character no-undo .
       72   define variable p-sts       as integer no-undo .
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
