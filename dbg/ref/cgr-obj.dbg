     2809   PROCEDURE set-filter-name :
     2810   define input parameter p-filter-name as character no-undo .
     2811     do with frame Dialog-Frame:
     2812       if p-filter-name > "" then do:
     2813         assign
     2814           frame Dialog-Frame:title
     2815             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2816         .
     2817         assign
     2818           b-sch :TOOLTIP = "Установлен фильтр " + p-filter-name
     2819         .
     2820       end.
     2821       else do:
     2822         assign
     2823           b-sch :TOOLTIP = ""
     2824         .
     2825       end.
     2826     end.
     2827   END PROCEDURE.
