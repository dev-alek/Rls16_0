      127       field price0-rubl       like ub.parts.price-rubl
      128       field price-base        like ub.parts.price-base
      129       field price-rubl        like ub.parts.price-rubl
      130       field obj-type          like ub.parts.obj-type
      131       field obj-code          like ub.parts.obj-code
      132       field part-code         like ub.parts.part-code
      133       field in-qnty           like ub.parts.fact-qnty
      134       field in-sum-cli        like ub.parts.price-cli
      135       field in-nds0-rubl      like ub.parts.price-rubl
      136       field in-nds0-base      like ub.parts.price-base
      137       field in-sum0-rubl      like ub.parts.price-rubl
      138       field in-sum0-base      like ub.parts.price-base
      139       field in-nds-rubl       like ub.parts.price-rubl
      140       field in-nds-base       like ub.parts.price-base
      141       field in-sum-rubl       like ub.parts.price-rubl
      142       field in-sum-base       like ub.parts.price-base
      143       field out-qnty          like ub.parts.fact-qnty
      144       field out-sum-cli       like ub.parts.price-cli
      145       field out-nds0-rubl     like ub.parts.price-rubl
      146       field out-nds0-base     like ub.parts.price-base
      147       field out-sum0-rubl     like ub.parts.price-rubl
      148       field out-sum0-base     like ub.parts.price-base
      149       field out-nds-rubl      like ub.parts.price-rubl
      150       field out-nds-base      like ub.parts.price-base
      151       field out-sum-rubl      like ub.parts.price-rubl
      152       field out-sum-base      like ub.parts.price-base
      153       field free-qnty         like ub.parts.fact-qnty
      154       field free-sum-cli      like ub.parts.price-cli
      155       field free-nds0-rubl    like ub.parts.price-rubl
      156       field free-nds0-base    like ub.parts.price-base
      157       field free-sum0-rubl    like ub.parts.price-rubl
      158       field free-sum0-base    like ub.parts.price-base
      159       field free-nds-rubl     like ub.parts.price-rubl
      160       field free-nds-base     like ub.parts.price-base
      161       field free-sum-rubl     like ub.parts.price-rubl
      162       field free-sum-base     like ub.parts.price-base
      163       field p-in-qnty         like ub.parts.fact-qnty
      164       field p-in-sum-cli      like ub.parts.price-cli
      165       field p-in-nds0-rubl    like ub.parts.price-rubl
      166       field p-in-nds0-base    like ub.parts.price-base
      167       field p-in-sum0-rubl    like ub.parts.price-rubl
      168       field p-in-sum0-base    like ub.parts.price-base
      169       field p-in-nds-rubl     like ub.parts.price-rubl
      170       field p-in-nds-base     like ub.parts.price-base
      171       field p-in-sum-rubl     like ub.parts.price-rubl
      172       field p-in-sum-base     like ub.parts.price-base
      173       field qnty-sale         as integer
      174       field fs-date           as date
      175       field ls-date           as date
      176       field num-doc           as character
      177       index f-date is primary fact-date ascending
      178       .
      179   define new shared buffer suppl-parts for sup-parts.
      180   define new shared buffer supplier    for ub.clients.
      181   define new shared buffer b-parts     for ub.parts.
      182   FIND first supplier WHERE recid(supplier) = p-rec NO-LOCK.
      183   run rep/vs-parts.w (
      184                       input parparentproc
      185                      ,input p-curr-obj-type
      186                      ,input p-curr-obj-code
      187                      ,input p-from-date
      188                      ,input p-to-date
      189                      ,input p-gds-art
      190                      ,input p-num-doc) no-error .
