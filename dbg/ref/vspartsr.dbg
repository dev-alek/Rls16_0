        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        4   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        5   define input parameter p-from-date as date no-undo .
        6   define input parameter p-to-date as date no-undo .
        7   define input parameter p-gds-art as character no-undo.
        8   define input parameter p-num-doc as character no-undo.
        9   define input parameter p-rec   as recid no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       12   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: vspartsr.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: ref/vspartsr.p $":U .
       15   define variable vss-description as character no-undo init "Запуск отчета vs-parts".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new shared temp-table sup-gds no-undo
       75       field artic          like ub.goods.artic
       76       field prod-type      like ub.clients.obj-type
       77       field prod-code      like ub.clients.obj-code
       78       field gds-name       like ub.goods.gds-name
       79       field unit-base      like ub.goods.unit-base
       80       field s-pay-type     as character
       81       field in-qnty        like ub.parts.fact-qnty
       82       field in-nds0-rubl   like ub.parts.price-rubl
       83       field in-nds0-base   like ub.parts.price-base
       84       field in-sum0-rubl   like ub.parts.price-rubl
       85       field in-sum0-base   like ub.parts.price-base
       86       field in-nds-rubl    like ub.parts.price-rubl
       87       field in-nds-base    like ub.parts.price-base
       88       field in-sum-rubl    like ub.parts.price-rubl
       89       field in-sum-base    like ub.parts.price-base
       90       field out-qnty       like ub.parts.fact-qnty
       91       field out-nds0-rubl  like ub.parts.price-rubl
       92       field out-nds0-base  like ub.parts.price-base
       93       field out-sum0-rubl  like ub.parts.price-rubl
       94       field out-sum0-base  like ub.parts.price-base
       95       field out-nds-rubl   like ub.parts.price-rubl
       96       field out-nds-base   like ub.parts.price-base
       97       field out-sum-rubl   like ub.parts.price-rubl
       98       field out-sum-base   like ub.parts.price-base
       99       field free-qnty      like ub.parts.fact-qnty
      100       field free-nds0-rubl like ub.parts.price-rubl
      101       field free-nds0-base like ub.parts.price-base
      102       field free-sum0-rubl like ub.parts.price-rubl
      103       field free-sum0-base like ub.parts.price-base
      104       field free-nds-rubl  like ub.parts.price-rubl
      105       field free-nds-base  like ub.parts.price-base
      106       field free-sum-rubl  like ub.parts.price-rubl
      107       field free-sum-base  like ub.parts.price-base
      108       field price-sale     as decimal
      109       field qnty-sale      as integer
      110       field fs-date        as date
      111       field ls-date        as date
      112       index art is primary artic prod-type prod-code s-pay-type ascending
      113       .
      114   define new shared buffer suppl-gds for sup-gds.
      115   define new shared temp-table sup-parts no-undo
      116       field artic             like ub.goods.artic
      117       field prod-type         like ub.clients.obj-type
      118       field prod-code         like ub.clients.obj-code
      119       field gds-code          like ub.goods.gds-code
      120       field gds-name          like ub.goods.gds-name
      121       field doc-type          like ub.parts.doc-type
