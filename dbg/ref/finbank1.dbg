        1   block-level on error undo, throw.
        2   define input-output parameter p-doc-rec as recid no-undo.
        3   define input parameter p-mode            as character no-undo .
        4   define input parameter p-silent                       as logical no-undo .
        5   define input parameter p-verify          as character no-undo .
        6   define input parameter p-log-file                     as character no-undo .
        7   define input parameter p-host-code       like ub.fin-bank.host-code no-undo .
        8   define input parameter p-code-bank       like ub.fin-bank.code-bank no-undo .
        9   define input parameter p-addres          like ub.fin-bank.addres    no-undo .
       10   define input parameter p-bank-city       like ub.fin-bank.bank-city no-undo .
       11   define input parameter p-addres1         like ub.fin-bank.addres1   no-undo .
       12   define input parameter p-bank-name       like ub.fin-bank.bank-name no-undo .
       13   define input parameter p-bik             like ub.fin-bank.bik       no-undo .
       14   define input parameter p-cor-acc         like ub.fin-bank.cor-acc   no-undo .
       15   define input parameter p-qr-rule         as integer                 no-undo .
       16   define input parameter p-resive-debit    as character               no-undo .
       17   define input parameter p-resive-kredit   as character               no-undo .
       18   define input parameter p-e-mail          like ub.fin-bank.e-mail    no-undo .
       19   define input parameter p-fax             like ub.fin-bank.fax       no-undo .
       20   define input parameter p-inn             like ub.fin-bank.inn       no-undo .
       21   define input parameter p-kpp             like ub.fin-bank.kpp       no-undo .
       22   define input parameter p-licenz          like ub.fin-bank.licenz    no-undo .
       23   define input parameter p-okato           like ub.fin-bank.okato     no-undo .
       24   define input parameter p-okonx           like ub.fin-bank.okonx     no-undo .
       25   define input parameter p-okpo            like ub.fin-bank.okpo      no-undo .
       26   define input parameter p-otdel           like ub.fin-bank.otdel     no-undo .
       27   define input parameter p-phone           like ub.fin-bank.phone     no-undo .
       28   define input parameter p-PS              like ub.fin-bank.PS        no-undo .
       29   define input parameter p-rkc             like ub.fin-bank.rkc       no-undo .
       30   define input parameter p-short-name      like ub.fin-bank.short-name no-undo .
       31   define input parameter p-cl-bank         like ub.fin-bank.cl-bank   no-undo .
       32   define variable vss-revision    as character no-undo init "$Revision: b104425dd357, 2760, rls $":U .
       33   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       34   define variable vss-date        as character no-undo init "$Date: Сб фев 20 15:59:21 2021 +0300 $":U .
       35   define variable vss-workfile    as character no-undo init "$Workfile: finbank1.p $":U .
       36   define variable vss-archive     as character no-undo init "$Archive: ref/finbank1.p $":U .
       37   define variable vss-description as character no-undo init "Сохранение изменений в карточке банка".
       38   procedure vss-get-info :
       39     define output parameter p-vss-revision    like vss-revision    no-undo .
       40     define output parameter p-vss-author      like vss-author      no-undo .
       41     define output parameter p-vss-date        like vss-date        no-undo .
       42     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       43     define output parameter p-vss-archive     like vss-archive     no-undo .
       44     define output parameter p-vss-description like vss-description no-undo .
       45     assign
       46       p-vss-revision    = vss-revision
       47       p-vss-author      = vss-author
       48       p-vss-date        = vss-date
       49       p-vss-workfile    = vss-workfile
       50       p-vss-archive     = vss-archive
       51       p-vss-description = vss-description
       52     .
       53   end procedure.
       54   procedure vss-get-parameters :
       55     define output parameter p-vss-parameters as character no-undo .
       56   end procedure.
       57   define new global shared variable g#vssrevis-logger as handle    no-undo .
       58   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       59   define variable v-vssrevis-logger                   as handle    no-undo .
       60   procedure vss-logevent :
       61     define input  parameter p-extra-paramters as character no-undo .
       62     define variable v-vssrevis-parameters as character no-undo .
       63     do
       64     on error undo, return error return-value
       65     :
       66       if  valid-handle(v-vssrevis-logger)
       67       and v-vssrevis-logger :get-signature("logevent") <> ""
       68       then do:
       69         run vss-get-parameters in this-procedure
       70           (output v-vssrevis-parameters
       71           ).
       72         run logevent in v-vssrevis-logger
       73           (input vss-workfile
       74           ,input vss-revision
       75           ,input v-vssrevis-parameters
       76           ,input p-extra-paramters
       77           ).
       78       end.
       79     end.
       80   end procedure.
       81   assign
       82     v-vssrevis-logger = g#vssrevis-logger
       83   .
       84   if  valid-handle(v-vssrevis-logger)
       85   and v-vssrevis-logger :get-signature("logevent") <> ""
       86   then do:
       87     assign
       88       v-vssrevis-logevent = true
       89     .
       90     run vss-logevent in this-procedure (input vss-description) .
       91   end.
       92   define new global shared variable g#language as character no-undo .
       93   if g#language <> '' and g#language <> 'rus':U then do:
       94     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       95   end.
       96   define new global shared variable g#library  as handle no-undo .
       97   define new global shared variable g#library2 as handle no-undo .
       98   define   shared variable g#auto as logical no-undo.
       99   define   shared variable g#news as logical no-undo.
      100   define   shared variable g#oxml as logical no-undo.
      101   define   shared variable g#esys as logical no-undo.
      102   define   shared variable g#news-source-db as integer no-undo.
      103   define   shared variable g#esys-source-esys as integer no-undo.
      104   define   shared variable g#db-num as integer   no-undo .
      105   define   shared variable g#userid as character no-undo .
      106   define   shared variable g#passwd as character no-undo .
      107   define variable v-db-num like ub.db.db-num no-undo .
      108   define variable v-correct-inn as logical no-undo .
      109   define variable v-correct-acc as logical no-undo .
      110   define variable v-correct-bik as logical no-undo .
      111   define variable v-mess        as character no-undo .
      112   define variable v-import as logical no-undo .
      113   define buffer buf_sysconf  for ub.sysconf.
      114   define buffer buf_fin-bank for ub.fin-bank.
      115   define buffer buf_fin-schet for ub.fin-schet .
      116   define variable v-value as character no-undo.
      117   define variable v-ttype as character no-undo.
      118   if p-mode <> 'ДОБАВЛЕНИЕ':U
      119   AND p-mode <> 'ИЗМЕНЕНИЕ':U
      120   and p-mode <> 'ДОБАВЛЕНИЕ-ИМПОРТ':U
      121   then do:
      122     message
      123     vss-workfile vss-revision vss-description skip
      124     "Неверный параметр p-mode" p-mode
      125     view-as alert-box error .
      126     return error '':u.
      127   end.
      128   if p-mode = 'ДОБАВЛЕНИЕ-ИМПОРТ':U then do:
      129     v-import = yes.
      130     p-mode = 'ДОБАВЛЕНИЕ':U.
      131   end.
      132   run gbl/conf-rd.p ("is-erpRN", "", "", 0, "", "", "", no, output v-value, output v-ttype) no-error.
      133   if v-value = "no"  then do:
      134   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      136     (output v-db-num
      137     )  .
      138   find first buf_sysconf no-lock where
      139                   buf_sysconf.host-code = p-host-code.
      140   if not avail buf_sysconf then dO:
      141     v-mess = substitute("Не найдена фирма с кодом &1", p-host-code).
      142     run err-mess in this-procedure ( input-output v-mess).
      143     return error (if p-silent then v-mess else "host-code":U).
      144   end.
      145   if v-db-num <> buf_sysconf.firm-db-num
      146   then do:
      147     v-mess =  substitute("Нельзя изменять запись БАНК в БД,&1отличной от главной БД фирмы: Номер текущей БД &2" +
      148                          "Номер главной БД фирмы &3"
      149                          , chr(10)
      150                          , v-db-num
      151                          , buf_sysconf.firm-db-num).
      152     run err-mess in this-procedure ( input-output v-mess ).
      153     undo, return error (if p-silent then v-mess else "host-code":U).
      154   end.
      155   end.
      156   if
      157   can-find(first buf_fin-bank no-lock where
      158                     buf_fin-bank.host-code = p-host-code
      159                 AND buf_fin-bank.bik       = p-bik
      160                 AND (p-mode = 'ДОБАВЛЕНИЕ':U OR p-doc-rec <> recid(buf_fin-bank))
      161                 AND p-cor-acc = buf_fin-bank.cor-acc
      162                 ) then do:
      163     v-mess = substitute("Уже есть банк с таким БИК и корсчетом для фирмы &1: БИК &2 коррсчет &3", p-host-code, p-bik, p-cor-acc) .
      164     run err-mess in this-procedure ( input-output v-mess).
      165     return error (if p-silent then v-mess else "bik":U).
      166   end.
      167   if p-bank-name = "":U then do:
      168     v-mess = "Имя банка не может быть пустым".
      169     run err-mess in this-procedure ( input-output v-mess).
      170     return error (if p-silent then v-mess else "bank-name":U).
      171   end.
      172   if p-bank-city = '':U then do:
      173     v-mess = "ГОРОД для банка не может быть пустым".
      174     run err-mess in this-procedure ( input-output v-mess).
      175     return error (if p-silent then v-mess else "bank-city":U).
      176   end.
      177   if p-inn <> "":U then do:
      178     run gbl/keyinn.p (p-inn, 'орг':U, 0, no , output v-correct-inn) no-error .
      179     if error-status:error or not v-correct-inn then do:
      180       v-mess = substitute("Неверный ИНН &1: &2", p-inn, return-value).
      181       run err-mess in this-procedure ( input-output v-mess).
      182       return error (if p-silent then v-mess else "inn":U).
      183     end.
      184   end.
      185   if lookup("bik" , p-verify) > 0 then do:
      186   run check-bik in this-procedure (p-bik, output v-correct-bik) no-error.
      187   if error-status:error
      188   or not v-correct-bik then do:
      189     v-mess = substitute("Неверный БИК &1: &2", p-bik, return-value).
      190     run err-mess in this-procedure ( input-output v-mess).
      191     return error (if p-silent then v-mess else "bik":U).
      192   end.
      193   end.
      194   define variable v-nocoracc as character no-undo .
      195   define variable v-conf-type as character no-undo .
      196   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      197     (input  'nocoracc'
      198     ,input  0
      199     ,input  '':U
      200     ,input  0
      201     ,input  '':U
      202     ,input  '':U
      203     ,input  '':U
      204     ,input  NO
      205     ,output v-nocoracc
      206     ,output v-conf-type
      207     ) NO-ERROR .
      208   IF ERROR-STATUS:ERROR OR v-conf-type <> 'L':U THEN v-nocoracc = "no".
      209   run check-cor-acc in this-procedure ( input p-cor-acc
      210                                       , input p-bik
      211                                       , output v-correct-acc) no-error.
      212   if error-status:error or not v-correct-acc then do:
      213     if v-nocoracc = "no" then do:
      214       v-mess = substitute("Неверный корсчет банка &1: &2", p-cor-acc, return-value).
      215       run err-mess in this-procedure ( input-output v-mess).
      216       return error (if p-silent then v-mess else "cor-acc":U).
      217     end.
      218   end.
      219   if p-cl-bank <> '':U then do:
      220     IF LOOKUP(P-CL-BANK, '1s':U) = 0 THEN DO:
      221       v-mess = substitute("Неверный тип системы КЛИЕНТ-БАНК: &1", p-cl-bank).
      222       run err-mess in this-procedure ( input-output v-mess).
      223       return error (if p-silent then v-mess else "cl-bank":U).
      224     END.
      225   END.
      226   _MAIN:
      227   DO ON ERROR UNDO, RETURN ERROR
      228   ON STOP UNDO, RETURN ERROR:
      229     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      230       create ub.fin-bank.
      231       assign
      232       ub.fin-bank.host-code = p-host-code
      233       ub.fin-bank.code-bank = (if v-import then p-code-bank else next-value(s-fin-bank, ub))
      234       p-doc-rec = recid(ub.fin-bank)
      235       .
      236     end.
      237     else do:
      238       FIND FIRST ub.fin-bank where
      239                 recid(ub.fin-bank) = p-doc-rec No-ERROR.
      240       if not available ub.fin-bank then do:
      241         message
      242         vss-workfile vss-revision vss-description skip
      243         "Не найдена запись банк - p-doc-rec" p-doc-rec
      244         view-as alert-box error .
      245         undo, return error '':u.
      246       end.
      247       if ub.fin-bank.host-code <> p-host-code
      248       OR ub.fin-bank.code-bank <> p-code-bank then do:
      249         message
      250         vss-workfile vss-revision vss-description skip
      251         "Для уже имеющейся записи нельзя изменить"
      252         "код фирмы и код банка" skip
      253         view-as alert-box ERROR.
      254         undo, return error '':U.
      255       end.
      256       if ub.fin-bank.cor-acc <> p-cor-acc then do:
      257         for each buf_fin-schet no-lock where
      258                    buf_fin-schet.host-code = p-host-code
      259                AND buf_fin-schet.code-bank = p-code-bank:
      260           if buf_fin-schet.c-schet <> p-cor-acc
      261           and buf_fin-schet.status_ = 'тек':U then do:
      262             message
      263             vss-workfile vss-revision vss-description skip
      264             "Для уже имеющейся записи нельзя изменить"
      265             "коррсчет банка, если имеются записи банковских счетов для этогов банка в статусе" 'тек':U skip
      266             view-as alert-box ERROR.
      267             undo, return error '':U.
      268           end.
      269         end.
      270       end.
      271     end.
      272     assign
      273     ub.fin-bank.addres     = p-addres
      274     ub.fin-bank.addres1    = p-addres1
      275     ub.fin-bank.bik        = trim(p-bik)
      276     ub.fin-bank.bank-name  = p-bank-name
      277     ub.fin-bank.bank-city  = p-bank-city
      278     ub.fin-bank.cl-bank    = p-cl-bank
      279     ub.fin-bank.cor-acc    = trim(p-cor-acc)
      280     ub.fin-bank.e-mail     = p-e-mail
      281     ub.fin-bank.fax        = p-fax
      282     ub.fin-bank.inn        = p-inn
      283     ub.fin-bank.kpp        = p-kpp
      284     ub.fin-bank.licenz     = p-licenz
      285     ub.fin-bank.okato      = p-okato
      286     ub.fin-bank.okonx      = p-okonx
      287     ub.fin-bank.okpo       = p-okpo
      288     ub.fin-bank.otdel      = p-otdel
      289     ub.fin-bank.phone      = p-phone
      290     ub.fin-bank.PS         = p-PS
      291     ub.fin-bank.rkc        = p-rkc
      292     ub.fin-bank.short-name = p-short-name
      293     ub.fin-bank.status_    =  (if p-mode = 'ДОБАВЛЕНИЕ':U
      294                                then 'тек':U
      295                                else ub.fin-bank.status_)
      296     .
      297   if p-qr-rule <> ? then do:
      298     find first ub.fin-bank-attr exclusive-lock where ub.fin-bank-attr.code-bank = ub.fin-bank.code-bank
      299       and ub.fin-bank-attr.host-code = p-host-code and ub.fin-bank-attr.attr-code = "collect-qrcode":U no-error .
      300     if not available (ub.fin-bank-attr) then
      301     do:
      302       create ub.fin-bank-attr .
      303       assign
      304         ub.fin-bank-attr.code-bank = ub.fin-bank.code-bank
      305         ub.fin-bank-attr.host-code = p-host-code
      306         ub.fin-bank-attr.attr-code = "collect-qrcode":U
      307         .
      308     end.
      309     ub.fin-bank-attr.attr-value = string (p-qr-rule) .
      310    end.
      311    if p-resive-debit <> ? then do:
      312     find first ub.fin-bank-attr exclusive-lock where ub.fin-bank-attr.code-bank = ub.fin-bank.code-bank
      313       and ub.fin-bank-attr.host-code = p-host-code and ub.fin-bank-attr.attr-code = "collect-debt":U no-error .
      314     if not available (ub.fin-bank-attr) then
      315     do:
      316       create ub.fin-bank-attr .
      317       assign
      318         ub.fin-bank-attr.code-bank = ub.fin-bank.code-bank
      319         ub.fin-bank-attr.host-code = p-host-code
      320         ub.fin-bank-attr.attr-code = "collect-debt":U
      321         .
      322     end.
      323     ub.fin-bank-attr.attr-value = string (p-resive-debit) .
      324   end.
      325   if p-resive-kredit <> ? then do:
      326     find first ub.fin-bank-attr exclusive-lock where ub.fin-bank-attr.code-bank = ub.fin-bank.code-bank
      327       and ub.fin-bank-attr.host-code = p-host-code and ub.fin-bank-attr.attr-code = "collect-credit":U no-error .
      328     if not available (ub.fin-bank-attr) then
      329     do:
      330       create ub.fin-bank-attr .
      331       assign
      332         ub.fin-bank-attr.code-bank = ub.fin-bank.code-bank
      333         ub.fin-bank-attr.host-code = p-host-code
      334         ub.fin-bank-attr.attr-code = "collect-credit":U
      335         .
      336     end.
      337     ub.fin-bank-attr.attr-value = string (p-resive-kredit) .
      338   end.
      339     release ub.fin-bank no-error.
      340     if error-status:error then do:
      341        v-mess = substitute("Ошибка при сохранении записи БАНК: &1: &2"
      342                    , ERROR-STATUS:GET-message(1)
      343                    , return-value
      344                    ).
      345        run err-mess in this-procedure ( input-output v-mess).
      346       undo, return error (if p-silent then v-mess else "":U).
      347    end.
      348   end.
      349   procedure check-cor-acc :
      350   define input parameter p-cor-acc like ub.fin-bank.cor-acc no-undo .
      351   define input parameter p-bik like ub.fin-bank.bik no-undo .
      352   define output parameter p-correct-acc as logical no-undo .
      353   define variable ii as integer no-undo .
      354   define variable v-dopi as integer no-undo .
      355     do
      356     on error undo, return error
      357     :
      358       if "руб" = "тг."
      359       or "руб" = "грн"
      360       or "руб" = "дрм"
      361       or "руб" = "lei"
      362       then do:
      363           p-correct-acc = true .
      364           return.
      365       end.
      366       assign
      367       p-cor-acc = trim(p-cor-acc).
      368       if substring(p-bik, 7, 3) = '000'
      369       or substring(p-bik, 7, 3) = '001'
      370       or substring(p-bik, 7, 3) = '002' then do:
      371         if p-cor-acc <> '':U then do:
      372            if substring(p-bik, 7, 3) = '000' then
      373            return error substitute("7-9 разряд БИК=000 -> банк является расчетно-кассовым центром&1"+
      374                                   "или другим подразделением в составе&1" +
      375                                   "территориального учреждения Банка России,&1" +
      376                                   "наделенным функциями расчетно-кассового (кассового) центра&1" +
      377                                   "для него № корр. счета НЕ УКАЗЫВАЕТСЯ"
      378                                   , chr(10)
      379                                   ).
      380            if substring(p-bik, 7, 3) = '001' then
      381            return error substitute("7-9 разряд БИК=001 -> банк является Головным расчетно-кассовым центром&1"+
      382                                    "или другим подразделением в составе&1" +
      383                                    "территориального учреждения Банка России,&1" +
      384                                   "наделенным функциями расчетно-кассового (кассового) центра&1" +
      385                                   "для него № корр. счета НЕ УКАЗЫВАЕТСЯ"
      386                                   , chr(10)
      387                                   ).
      388            if substring(p-bik, 7, 3) = '002' then
      389            return error substitute("7-9 разряд БИК=002 -> банк является подразделением расчетной сети БАНКА РОССИИ&1" +
      390                                    "или структурным подразделением банка России&1" +
      391                                   "для него № корр. счета НЕ УКАЗЫВАЕТСЯ"
      392                                   , chr(10)
      393                                   ).
      394         End.
      395         p-correct-acc = yes.
      396         return.
      397       end.
      398       if p-cor-acc = "":U then do:
      399         return "Корсчет банка не может быть пустым".
      400       end.
      401       if length(p-cor-acc) <> 20 then do:
      402         return "Неверная длина корсчета банка - должно быть 20".
      403       end.
      404       do ii = 1 to 20:
      405         assign
      406         v-dopi = integer(substr(p-cor-acc, ii, 1))
      407         no-error .
      408         if error-status:error
      409         and not (ii = 6  and lookup(substr(p-cor-acc, ii, 1), "A,B,C,E,H,K,M,P,T,X":U) = 0)
      410         then do:
      411           return "Неверные символы в корсчете банка - должно быть цифры везде, кроме 6-го разряда".
      412         end.
      413       end.
      414       if substr(p-cor-acc, 18, 3) <> substr(p-bik, 7, 3) then do:
      415         return "Несоответствие номера корсчета и БИК - три последние цифры БИК и три  последние цифры корсчета должны совпадать".
      416       end.
      417       assign
      418       p-correct-acc = yes
      419       .
      420     end.
      421   end procedure.
      422   procedure check-bik :
      423   define input parameter p-bik like ub.fin-bank.bik no-undo .
      424   define output parameter p-correct-acc as logical no-undo .
      425   define variable ii as integer no-undo .
      426   define variable v-dopi as integer no-undo .
      427     do
      428     on error undo, return error
      429     :
      430       if  "руб" = "грн"
      431       then do:
      432           p-correct-acc = true .
      433           return.
      434       end.
      435       if "руб" = "тг."
      436       then do:
      437         if length(p-bik) <> 8 then do:
      438           return "BIC должен состоять из 8 символов".
      439         end.
      440         if substring(p-bik, 5, 2) <> "KZ" then do:
      441           return "5-6 символ BIC должен быть равен KZ".
      442         end.
      443           p-correct-acc = true .
      444           return.
      445       end.
      446       assign
      447       p-bik = trim(p-bik).
      448       if p-bik = "":U then do:
      449         return "БИК банка не может быть пустым".
      450       end.
      451       if length(p-bik) <> 9 then do:
      452         return "Неверная длина БИК - должно быть 9".
      453       end.
      454       do ii = 1 to 9:
      455         assign
      456         v-dopi = integer(substr(p-bik, ii, 1))
      457         no-error .
      458         if error-status:error
      459         then do:
      460           return "Неверные символы в корсчете банка - должно быть цифры".
      461         end.
      462       end.
      463       assign
      464       p-correct-acc = yes
      465       .
      466     end.
      467   end procedure.
      468   PROCEDURE err-mess:
      469     DEFINE INPUT-output  PARAMETER p-mess as character No-UNDO.
      470     CASE p-silent:
      471       when yes then do:
      472         p-mess = substitute("Банк &1: фирма: &2&3&4"
      473                             , p-code-bank
      474                             , p-host-code
      475                             ,chr(10)
      476                             ,p-mess
      477                             ).
      478       end.
      479       otherwise do:
      480         message
      481         p-mess
      482         view-as alert-box error .
      483       end.
      484     end.
      485   END PROCEDURE.
