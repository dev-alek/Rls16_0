     1270   DEFINE QUERY BR-cash-pay-list FOR
     1271         temp-cash-pay-list SCROLLING.
     1272   DEFINE QUERY BR-pay-names FOR
     1273         temp-pay-names SCROLLING.
     1274   DEFINE BROWSE BR-cash-pay-list
     1275     QUERY BR-cash-pay-list DISPLAY
     1276         temp-cash-pay-list.cdpay-code COLUMN-LABEL "Код TH"
     1277   temp-cash-pay-list.curr-code COLUMN-LABEL "Код вал"
     1278   getcp-name (INPUT temp-cash-pay-list.cdpay-code, INPUT temp-cash-pay-list.curr-code) COLUMN-LABEL "Название типа касс.платежа TH" FORMAT "X(40)"
     1279   temp-cash-pay-list.frpay-code COLUMN-LABEL "Код ФР"
     1280    get-frpay-name( INPUT temp-cash-pay-list.frpay-code) @ v-frpay-name COLUMN-LABEL "Наим. кода оплаты на ФР" FORMAT "X(40)"
     1281   ENABLE
     1282   temp-cash-pay-list.frpay-code
     1283       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 12
     1284            TITLE "Типы кассовых платежей<->коды оплаты ФР" ROW-HEIGHT-CHARS .5 FIT-LAST-COLUMN.
     1285   DEFINE BROWSE BR-pay-names
     1286     QUERY BR-pay-names DISPLAY
     1287         temp-pay-names.frpay-code COLUMN-LABEL  "Код в ФР"   FORMAT "9"
     1288   temp-pay-names.frpay-name COLUMN-LABEL  "Наименование" FORMAT "X(40)"
     1289   ENABLE
