     1738   ON VALUE-CHANGED OF f-com-port IN FRAME Dialog-Frame
     1739   DO:
     1740     assign f-com-port.
     1741   END.
     1742   ON LEAVE OF f-customer-display-adv1 IN FRAME Dialog-Frame
     1743   DO:
     1744     ASSIGN
     1745     f-customer-display-adv1
     1746     f-customer-display-adv = f-customer-display-adv1 + chr(4) + f-customer-display-adv2
     1747     f-customer-display-adv:SCREEN-VALUE in frame Dialog-Frame = f-customer-display-adv
     1748     .
     1749   END.
     1750   ON LEAVE OF f-customer-display-adv2 IN FRAME Dialog-Frame
     1751   DO:
     1752     ASSIGN
     1753     f-customer-display-adv2
     1754     f-customer-display-adv = f-customer-display-adv1 + chr(4)  + f-customer-display-adv2
     1755     f-customer-display-adv:SCREEN-VALUE in frame Dialog-Frame = f-customer-display-adv
     1756     .
     1757   END.
     1758   ON LEAVE OF f-rmethod-coeff IN FRAME Dialog-Frame
     1759   DO:
     1760   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1761   if lookup(self :type
     1762            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1763            ) = 0
     1764   then do:
     1765     message
     1766       "$Workfile$"
     1767       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1768       "Интерфейсный элемент" self :name  skip
     1769       "Тип" self :type  skip
     1770       "Процедура" this-procedure :file-name skip
     1771       view-as alert-box .
     1772   end.
     1773   else do:
     1774     apply "entry":u to self  .
     1775     if focus :handle <> self :handle  then do:
     1776       return no-apply .
     1777     end.
     1778   end.
     1779     IF rs-rmethod-type = "NO-COINS" THEN DO:
     1780       ASSIGN
     1781       f-rmethod-coeff
     1782       v-rmethod-coeff = f-rmethod-coeff
     1783       v-rmethod-coeff:screen-value = string(v-rmethod-coeff)
     1784       .
     1785     END.
     1786   END.
     1787   ON VALUE-CHANGED OF RS-cash-drawer-plug-type IN FRAME Dialog-Frame
     1788   DO:
     1789     ASSIGN
     1790     rs-cash-drawer-plug-type.
     1791     CASE rs-cash-drawer-plug-type:
     1792       WHEN 1 THEN DO:
     1793          DISPLAY
     1794          f-cash-drawer-plug-port
     1795          WITH FRAME Dialog-Frame.
     1796       END.
     1797       WHEN 0 THEN DO:
     1798           hide
     1799           f-cash-drawer-plug-port
     1800           IN FRAME Dialog-Frame.
     1801       END.
     1802     END CASE.
     1803   END.
     1804   ON VALUE-CHANGED OF rs-rmethod-coeff IN FRAME Dialog-Frame
     1805   DO:
     1806   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1807   if lookup(self :type
     1808            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1809            ) = 0
     1810   then do:
     1811     message
     1812       "$Workfile$"
     1813       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1814       "Интерфейсный элемент" self :name  skip
     1815       "Тип" self :type  skip
     1816       "Процедура" this-procedure :file-name skip
     1817       view-as alert-box .
     1818   end.
     1819   else do:
     1820     apply "entry":u to self  .
     1821     if focus :handle <> self :handle  then do:
     1822       return no-apply .
     1823     end.
     1824   end.
     1825       IF rs-rmethod-type = "MROUND" THEN DO:
     1826       ASSIGN
     1827       rs-rmethod-coeff
     1828       v-rmethod-coeff = rs-rmethod-coeff
     1829       v-rmethod-coeff:screen-value = string(v-rmethod-coeff)
     1830       .
     1831     END.
     1832   END.
     1833   ON VALUE-CHANGED OF rs-rmethod-type IN FRAME Dialog-Frame
     1834   DO:
     1835    ASSIGN
     1836    rs-rmethod-type
     1837    .
     1838    disable
     1839    f-rmethod-coeff
     1840    with frame Dialog-Frame .
     1841    DISPLAY
     1842    l-rmethod
     1843    WITH FRAME Dialog-Frame.
     1844    CASE rs-rmethod-type:
     1845      WHEN "MROUND" THEN DO:
     1846        ASSIGN
     1847        rs-rmethod-coeff:VISIBLE IN FRAME Dialog-Frame = YES
     1848        f-rmethod-coeff:VISIBLE IN FRAME Dialog-Frame = NO.
     1849        .
     1850      END.
     1851      WHEN "NO-COINS" THEN DO:
     1852          ASSIGN
     1853          rs-rmethod-coeff:VISIBLE IN FRAME Dialog-Frame = NO
     1854          f-rmethod-coeff:VISIBLE IN FRAME Dialog-Frame = YES
     1855          f-rmethod-coeff:sensitive IN FRAME Dialog-Frame = (p-mode <> 'ПРОСМОТР':U)
     1856          .
     1857      END.
     1858   END CASE.
     1859   END.
     1860   ON VALUE-CHANGED OF t-cash-drawer-plug IN FRAME Dialog-Frame
     1861   DO:
     1862     ASSIGN
     1863     t-cash-drawer-plug.
     1864     CASE t-cash-drawer-plug:
     1865       WHEN no THEN DO:
     1866         IF p-mode <> 'ПРОСМОТР':U THEN DO:
     1867           ASSIGN
     1868           t-cash-drawer-open = NO
     1869           rs-cash-drawer-plug-type = 0
     1870           f-cash-drawer-plug-imp = 1
     1871           f-cash-drawer-plug-port = 0
     1872           rs-cash-drawer-level = 1
     1873           f-cash-drawer-limit = 1000000.00
     1874           .
     1875           DISPLAY
     1876           rs-cash-drawer-plug-type
     1877           f-cash-drawer-plug-port
     1878           f-cash-drawer-plug-imp
     1879           t-cash-drawer-open
     1880           f-cash-drawer-limit
     1881           WITH FRAME Dialog-Frame.
     1882           disable
     1883           f-cash-drawer-plug-imp
     1884           f-cash-drawer-plug-port
     1885           RS-cash-drawer-level
     1886           rs-cash-drawer-plug-type
     1887           t-cash-drawer-open
     1888           f-cash-drawer-limit
     1889           with FRAME Dialog-Frame.
     1890         END.
     1891       END.
     1892       WHEN YES THEN DO:
     1893           IF p-mode <> 'ПРОСМОТР':U THEN DO:
     1894             enable
     1895             f-cash-drawer-plug-imp
     1896             f-cash-drawer-plug-port
     1897             RS-cash-drawer-level
     1898             t-cash-drawer-open
     1899             f-cash-drawer-limit
     1900             WITH FRAME Dialog-Frame.
     1901           END.
     1902           ASSIGN
     1903           RS-cash-drawer-level:VISIBLE IN FRAME Dialog-Frame = NO
     1904           t-cash-drawer-open:VISIBLE IN FRAME Dialog-Frame = YES
     1905           .
     1906       END.
     1907     END CASE.
     1908     APPLY "VALUE-CHANGED" TO rs-cash-drawer-plug-type.
     1909   END.
     1910   ON VALUE-CHANGED OF t-customer-display-plug IN FRAME Dialog-Frame
     1911   DO:
     1912     ASSIGN
     1913     t-customer-display-plug.
     1914     CASE t-customer-display-plug:
     1915       WHEN no THEN DO:
     1916         IF p-mode <> 'ПРОСМОТР':U THEN DO:
     1917           ASSIGN
     1918           cb-customer-display-type = ''
     1919           f-customer-display-port = ''
     1920           f-customer-display-adv1 = fill('_', 20)
     1921           f-customer-display-adv2 = fill('_', 20)
     1922           .
     1923           DISPLAY
     1924           cb-customer-display-type
     1925           f-customer-display-port
     1926           f-customer-display-adv1
     1927           f-customer-display-adv2
     1928           WITH FRAME Dialog-Frame.
     1929           disable
     1930           f-customer-display-port
     1931           CB-customer-display-type
     1932           f-customer-display-adv1
     1933           f-customer-display-adv2
     1934           with FRAME Dialog-Frame.
     1935         END.
     1936       END.
     1937       WHEN YES THEN DO:
     1938           IF p-mode <> 'ПРОСМОТР':U THEN DO:
     1939             enable
     1940             cb-customer-display-type
     1941             f-customer-display-adv1
     1942             f-customer-display-adv2
     1943             WITH FRAME Dialog-Frame.
     1944           END.
     1945           ASSIGN
     1946           CB-customer-display-type:VISIBLE IN FRAME Dialog-Frame = yes
     1947           f-customer-display-port:VISIBLE IN FRAME Dialog-Frame = yes
     1948           f-customer-display-adv1:VISIBLE IN FRAME Dialog-Frame = yes
     1949           f-customer-display-adv2:VISIBLE IN FRAME Dialog-Frame = yes
     1950           .
     1951       END.
     1952     END CASE.
     1953   END.
     1954   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1955   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1956   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1957   on help of frame Dialog-Frame
     1958   do:
     1959     run gbl/app_help.p
     1960       (input this-procedure :file-name
     1961       ,input ''
     1962       ,input ?
     1963       ) no-error.
     1964     if error-status :error then do:
     1965       message
     1966         "Ошибка при вызове помощи"
     1967         error-status :get-message(1)
     1968         view-as alert-box .
     1969     end.
     1970   end.
     1971   run minbtn-set in this-procedure .
     1972   on choose of b-help in frame Dialog-Frame
     1973   do:
     1974     apply "help":u to frame Dialog-Frame .
     1975   end.
     1976   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1977   procedure minbtn-set :
     1978       do
     1979           on error undo, return error return-value
     1980           :
     1981           define variable ii              as integer       no-undo .
     1982           define variable fh              as widget-handle no-undo .
     1983           define variable hh              as widget-handle no-undo .
     1984           define variable v-h             as handle        extent 4 no-undo .
     1985           define variable v-name-button   as character     no-undo .
     1986           define variable v-help-old-x    as decimal       no-undo .
     1987           define variable v-help-old-y    as decimal       no-undo .
     1988           define variable v-help-old-size as decimal       no-undo .
     1989           define variable v-frame-width   as decimal       no-undo .
     1990           define variable jj              as integer       no-undo .
     1991           do
     1992               on error undo, return error
     1993               :
     1994               assign
     1995                   v-frame-width = frame Dialog-Frame:width - 0.3
     1996                   fh            = frame Dialog-Frame:first-child
     1997                   hh            = fh:first-child
     1998                   ii            = 1
     1999                   .
     2000               do while valid-handle(hh):
     2001                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2002                   do:
     2003                       case lc(hh:name) :
     2004                           when "b-help" then
     2005                               do:
     2006                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2007                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2008                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2009                                   hh:TOOLTIP = "Помощь" .
     2010                                   v-help-old-x = hh:column .
     2011                                   v-help-old-y = hh:row    .
     2012                                   v-help-old-size = hh:width .
     2013                                   hh:width-chars = 2.5 .
     2014                               end.
     2015                           when "b-print" then
     2016                               do:
     2017                                   hh:load-image("cmp/b-print.bmp":u) .
     2018                                   hh:TOOLTIP = "Печать" .
     2019                                   v-h[ii] = hh:handle .
     2020                                   ii = ii + 1 .
     2021                                   hh:width-chars = 3 .
     2022                               end.
     2023                           when "b-history" or
     2024                           when "b-hist" then
     2025                               do:
     2026                                   hh:load-image("cmp/b-hist.bmp":u) .
     2027                                   hh:TOOLTIP = "История" .
     2028                                   v-h[ii] = hh:handle .
     2029                                   ii = ii + 1 .
     2030                                   hh:width-chars = 3 .
     2031                               end.
     2032                           when "b-sch" then
     2033                               do:
     2034                                   hh:load-image("cmp/b-sch.bmp":u) .
     2035                                   hh:TOOLTIP = "Установка Фильтра" .
     2036                                   v-h[ii] = hh:handle .
     2037                                   ii = ii + 1 .
     2038                                   hh:width-chars = 3 .
     2039                               end.
     2040                           when "b-hist-user" then
     2041                               do:
     2042                                   hh:load-image("cmp/b-hist.bmp":u) .
     2043                                   hh:TOOLTIP = "История пользователя" .
     2044                                   ii = ii + 1 .
     2045                               end.
     2046                       end case.
     2047                   end.
     2048                   hh = hh:next-sibling.
     2049               end.
     2050               b-help:column = v-frame-width - b-help:width-chars.
     2051               jj = 0.
     2052               repeat ii = 4 to 1 by -1 :
     2053                   if valid-handle (v-h[ii] ) then
     2054                   do:
     2055                       jj  = jj + 1 .
     2056                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2057                       v-h[ii]:row    = v-help-old-y .
     2058                   end.
     2059               end.
     2060           end.
     2061       end.
     2062   end procedure.
     2063   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2064   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2065   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2066   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2067   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2068   define variable v-diasize-current-frame-height as decimal   no-undo .
     2069   define variable v-diasize-change-size          as logical   no-undo .
     2070   define variable v-diasize-resize-button        as handle    no-undo .
     2071   define variable v-diasize-wndmax               as logical   no-undo .
     2072   define variable v-diasize-wndstore             as logical   no-undo .
     2073   define variable v-diasize-proc-name            as character no-undo .
     2074   define variable v-diasize-browse-handle        as handle    no-undo .
     2075   define variable v-diasize-browse-number        as integer   no-undo .
     2076   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2077   define temp-table temp-diasize-handle no-undo
     2078     field handle-value  as handle
     2079     field save-position as decimal
     2080     index xpk is primary unique handle-value
     2081     .
     2082   define temp-table temp-browse-handle no-undo
     2083     field browse-type   as character
     2084     field browse-number as integer
     2085     field browse-handle as handle
     2086     field original-size as decimal
     2087     index xpk is primary unique browse-type browse-number
     2088     index xie browse-type browse-handle
     2089   .
     2090   procedure diasize_change-height :
     2091     define input  parameter p-change-value  as decimal   no-undo .
     2092     define input  parameter p-move-resize   as logical   no-undo .
     2093     define variable v-field-group-handle    as handle    no-undo .
     2094     define variable v-object-handle         as handle    no-undo .
     2095     define variable v-frame-height          as decimal   no-undo .
     2096     define variable v-frame-virtual-height  as decimal   no-undo .
     2097     define variable v-browse-height         as decimal   no-undo .
     2098     define variable v-window-height         as decimal   no-undo .
     2099     define variable v-window-virtual-height as decimal   no-undo .
     2100     define variable v-change-sign           as integer   no-undo .
     2101     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2102     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2103     if p-change-value > 0
     2104     then do:
     2105       if frame Dialog-Frame :height + p-change-value
     2106           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2107       then do:
     2108         assign
     2109           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2110                           - (frame Dialog-Frame :height-chars)
     2111         .
     2112         if p-change-value <= 0
     2113         then do:
     2114           run diasize_position-resize-button in this-procedure .
     2115           return .
     2116         end.
     2117       end.
     2118     end.
     2119     if p-change-value < 0
     2120     then do:
     2121       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2122       then do:
     2123         assign
     2124           p-change-value = v-diasize-orig-frame-height
     2125                          - (frame Dialog-Frame :height-chars)
     2126         .
     2127         if p-change-value >= 0
     2128         then do:
     2129           run diasize_position-resize-button in this-procedure .
     2130           return .
     2131         end.
     2132       end.
     2133     end.
     2134     if p-change-value >= 0
     2135     then do:
     2136       assign
     2137         v-change-sign = 1
     2138       .
     2139     end.
     2140     else do:
     2141       assign
     2142         v-change-sign = -1
     2143       .
     2144     end.
     2145     assign
     2146       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2147     .
     2148     if p-change-value = 0
     2149     then do:
     2150       run diasize_position-resize-button in this-procedure .
     2151       return .
     2152     end.
     2153     move_block:
     2154     do
     2155     on error undo move_block, retry move_block
     2156     :
     2157       if retry
     2158       then do:
     2159         do
     2160         on error undo move_block, leave move_block
     2161         :
     2162           if p-change-value > 0
     2163           then do:
     2164             for each buf_temp-diasize-handle
     2165             on error undo, next
     2166             :
     2167               assign
     2168                 v-object-handle = buf_temp-diasize-handle.handle-value
     2169               .
     2170               if v-object-handle <> v-diasize-resize-button
     2171               then do:
     2172                 assign
     2173                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2174                 .
     2175               end.
     2176             end.
     2177             assign
     2178               v-diasize-browse-handle :height = v-browse-height
     2179             .
     2180             for each buf_temp-browse-handle
     2181               where buf_temp-browse-handle.browse-type = 'height':u
     2182             on error undo, next
     2183             :
     2184               assign
     2185                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2186               .
     2187             end.
     2188             assign
     2189               frame Dialog-Frame :height = v-frame-height
     2190             .
     2191             if frame Dialog-Frame :scrollable = true
     2192             then do:
     2193               assign
     2194                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2195               .
     2196             end.
     2197             run diasize_position-resize-button in this-procedure .
     2198           end.
     2199           else do:
     2200             if frame Dialog-Frame :scrollable = true
     2201             then do:
     2202               assign
     2203                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2204               .
     2205             end.
     2206             assign
     2207               frame Dialog-Frame :height = v-frame-height
     2208             .
     2209             assign
     2210               v-diasize-browse-handle :height = v-browse-height
     2211             .
     2212             for each buf_temp-browse-handle
     2213               where buf_temp-browse-handle.browse-type = 'height':u
     2214             on error undo, next
     2215             :
     2216               assign
     2217                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2218               .
     2219             end.
     2220             for each buf_temp-diasize-handle
     2221             on error undo, next
     2222             :
     2223               assign
     2224                 v-object-handle = buf_temp-diasize-handle.handle-value
     2225               .
     2226               if v-object-handle <> v-diasize-resize-button
     2227               then do:
     2228                 assign
     2229                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2230                 .
     2231               end.
     2232             end.
     2233             run diasize_position-resize-button in this-procedure .
     2234           end.
     2235           assign
     2236             v-diasize-change-size = false
     2237           .
     2238           leave move_block .
     2239         end.
     2240       end.
     2241       assign
     2242         v-diasize-need-full-display = true
     2243       .
     2244       if v-diasize-change-size = false
     2245       then do:
     2246         assign
     2247           v-diasize-change-size = true
     2248         .
     2249       end.
     2250       else do:
     2251         return .
     2252       end.
     2253       assign
     2254         v-frame-height = frame Dialog-Frame :height
     2255         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2256         v-browse-height = v-diasize-browse-handle :height
     2257       .
     2258       for each buf_temp-browse-handle
     2259         where buf_temp-browse-handle.browse-type = 'height':u
     2260       :
     2261         assign
     2262           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2263         .
     2264       end.
     2265       for each buf_temp-diasize-handle
     2266       :
     2267         delete buf_temp-diasize-handle .
     2268       end.
     2269       assign
     2270         v-field-group-handle = frame Dialog-Frame :first-child
     2271       .
     2272       do while valid-handle(v-field-group-handle)
     2273       :
     2274         assign
     2275           v-object-handle = v-field-group-handle :first-child
     2276         .
     2277         do while valid-handle(v-object-handle)
     2278         :
     2279           if  v-object-handle <> v-diasize-browse-handle :handle
     2280           and can-query(v-object-handle, "row")
     2281           and can-query(v-object-handle, "height")
     2282           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2283           then do:
     2284             find first buf_temp-browse-handle
     2285               where buf_temp-browse-handle.browse-type   = 'height':u
     2286                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2287               no-error .
     2288             if available buf_temp-browse-handle
     2289             then do:
     2290             end.
     2291             else do:
     2292               create buf_temp-diasize-handle .
     2293               assign
     2294                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2295                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2296               .
     2297             end.
     2298           end.
     2299           assign
     2300             v-object-handle = v-object-handle :next-sibling
     2301           .
     2302         end.
     2303         assign
     2304           v-field-group-handle = v-field-group-handle :next-sibling
     2305         .
     2306       end.
     2307       do with frame Dialog-Frame
     2308       :
     2309         hide v-diasize-resize-button .
     2310         assign
     2311           v-diasize-resize-button :row    = 1
     2312           v-diasize-resize-button :column = 1
     2313         .
     2314       end.
     2315       if p-change-value > 0
     2316       then do:
     2317         if frame Dialog-Frame :scrollable = true
     2318         then do:
     2319           assign
     2320             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2321             no-error .
     2322           if error-status :error
     2323           or error-status :get-message(1) <> ""
     2324           then do:
     2325             undo move_block, retry move_block .
     2326           end.
     2327         end.
     2328         assign
     2329           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2330           no-error .
     2331         if error-status :error
     2332         or error-status :get-message(1) <> ""
     2333         then do:
     2334           undo move_block, retry move_block .
     2335         end.
     2336         assign
     2337           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2338           no-error .
     2339         if error-status :error
     2340         or error-status :get-message(1) <> ""
     2341         then do:
     2342           undo move_block, retry move_block .
     2343         end.
     2344         for each buf_temp-browse-handle
     2345           where buf_temp-browse-handle.browse-type = 'height':u
     2346         on error undo move_block, retry move_block
     2347         :
     2348           assign
     2349             buf_temp-browse-handle.browse-handle :height
     2350               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2351             no-error .
     2352           if error-status :error
     2353           or error-status :get-message(1) <> ""
     2354           then do:
     2355             undo move_block, retry move_block .
     2356           end.
     2357         end.
     2358         for each buf_temp-diasize-handle
     2359         on error undo move_block, retry move_block
     2360         :
     2361           assign
     2362             v-object-handle = buf_temp-diasize-handle.handle-value
     2363           .
     2364           if v-object-handle <> v-diasize-resize-button
     2365           then do:
     2366             assign
     2367               v-object-handle :row = v-object-handle :row + p-change-value
     2368               no-error .
     2369             if error-status :error
     2370             or error-status :get-message(1) <> ""
     2371             then do:
     2372               undo move_block, retry move_block .
     2373             end.
     2374           end.
     2375         end.
     2376       end.
     2377       else do:
     2378         for each buf_temp-diasize-handle
     2379         on error undo move_block, retry move_block
     2380         :
     2381           assign
     2382             v-object-handle = buf_temp-diasize-handle.handle-value
     2383           .
     2384           if v-object-handle <> v-diasize-resize-button
     2385           then do:
     2386             assign
     2387               v-object-handle :row = v-object-handle :row + p-change-value
     2388               no-error .
     2389             if error-status :error
     2390             or error-status :get-message(1) <> ""
     2391             then do:
     2392               undo move_block, retry move_block .
     2393             end.
     2394           end.
     2395         end.
     2396         assign
     2397           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2398           no-error .
     2399         if error-status :error
     2400         or error-status :get-message(1) <> ""
     2401         then do:
     2402           undo move_block, retry move_block .
     2403         end.
     2404         for each buf_temp-browse-handle
     2405           where buf_temp-browse-handle.browse-type = 'height':u
     2406         on error undo move_block, retry move_block
     2407         :
     2408           assign
     2409             buf_temp-browse-handle.browse-handle :height
     2410               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2411             no-error .
     2412           if error-status :error
     2413           or error-status :get-message(1) <> ""
     2414           then do:
     2415             undo move_block, retry move_block .
     2416           end.
     2417         end.
     2418         assign
     2419           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2420           no-error .
     2421         if error-status :error
     2422         or error-status :get-message(1) <> ""
     2423         then do:
     2424           undo move_block, retry move_block .
     2425         end.
     2426         if frame Dialog-Frame :scrollable = true
     2427         then do:
     2428           assign
     2429             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2430             no-error .
     2431           if error-status :error
     2432           or error-status :get-message(1) <> ""
     2433           then do:
     2434             undo move_block, retry move_block .
     2435           end.
     2436         end.
     2437       end.
     2438       if p-move-resize = true
     2439       then do:
     2440         run diasize_position-resize-button in this-procedure .
     2441       end.
     2442       if v-diasize-wndstore = true
     2443       then do:
     2444         if connected("ub") = true
     2445         then do:
     2446           define variable v-cntxt-db-num        as integer   no-undo .
     2447           define variable v-cntxt-userid        as character no-undo .
     2448           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2449                                             , OUTPUT v-cntxt-userid
     2450                                             ) .
     2451           run gbl/wndsizew.p
     2452             (input  v-cntxt-db-num
     2453             ,input  v-cntxt-userid
     2454             ,input  v-diasize-proc-name
     2455             ,input  'height':u
     2456             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2457             ) .
     2458         end.
     2459       end.
     2460     end.
     2461     assign
     2462       v-diasize-change-size = false
     2463     .
     2464   end procedure.
     2465   procedure diasize_set-height :
     2466     define input  parameter p-new-height  as decimal   no-undo .
     2467     define input  parameter p-move-resize as logical   no-undo .
     2468     do
     2469     on error undo, return error return-value
     2470     :
     2471       run diasize_change-height in this-procedure
     2472         (input  (p-new-height - frame Dialog-Frame :height)
     2473         ,input  p-move-resize
     2474         ) .
     2475     end.
     2476   end procedure.
     2477   procedure diasize_change-width :
     2478     define input  parameter p-change-value as decimal   no-undo .
     2479     define input  parameter p-move-resize  as logical   no-undo .
     2480     define variable v-field-group-handle   as handle    no-undo .
     2481     define variable v-object-handle        as handle    no-undo .
     2482     define variable v-frame-width          as decimal   no-undo .
     2483     define variable v-frame-virtual-width  as decimal   no-undo .
     2484     define variable v-browse-width         as decimal   no-undo .
     2485     define variable v-window-width         as decimal   no-undo .
     2486     define variable v-window-virtual-width as decimal   no-undo .
     2487     define variable v-change-sign          as integer   no-undo .
     2488     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2489     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2490     if p-change-value > 0
     2491     then do:
     2492       if frame Dialog-Frame :width + p-change-value >
     2493           session :width-chars
     2494       then do:
     2495         assign
     2496           p-change-value = session :width-chars - frame Dialog-Frame :width
     2497         .
     2498         if p-change-value <= 0
     2499         then do:
     2500           run diasize_position-resize-button in this-procedure .
     2501           return .
     2502         end.
     2503       end.
     2504     end.
     2505     if p-change-value < 0
     2506     then do:
     2507       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2508       then do:
     2509         assign
     2510           p-change-value = v-diasize-orig-frame-width
     2511                          - frame Dialog-Frame :width
     2512         .
     2513         if p-change-value >= 0
     2514         then do:
     2515           run diasize_position-resize-button in this-procedure .
     2516           return .
     2517         end.
     2518       end.
     2519     end.
     2520     if p-change-value >= 0
     2521     then do:
     2522       assign
     2523         v-change-sign = 1
     2524       .
     2525     end.
     2526     else do:
     2527       assign
     2528         v-change-sign = -1
     2529       .
     2530     end.
     2531     assign
     2532       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2533     .
     2534     if p-change-value = 0
     2535     then do:
     2536       run diasize_position-resize-button in this-procedure .
     2537       return .
     2538     end.
     2539     move_block:
     2540     do
     2541     on error undo move_block, leave move_block
     2542     :
     2543       if retry
     2544       then do:
     2545         do
     2546         on error undo move_block, leave move_block
     2547         :
     2548           if p-change-value > 0
     2549           then do:
     2550             for each buf_temp-diasize-handle
     2551             on error undo, next
     2552             :
     2553               assign
     2554                 v-object-handle = buf_temp-diasize-handle.handle-value
     2555               .
     2556               if v-object-handle <> v-diasize-resize-button
     2557               then do:
     2558                 assign
     2559                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2560                 .
     2561               end.
     2562             end.
     2563             assign
     2564               v-diasize-browse-handle :width = v-browse-width
     2565             .
     2566             for each buf_temp-browse-handle
     2567               where buf_temp-browse-handle.browse-type = 'width':u
     2568             on error undo, next
     2569             :
     2570               assign
     2571                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2572               .
     2573             end.
     2574             assign
     2575               frame Dialog-Frame :width = v-frame-width
     2576             .
     2577             if frame Dialog-Frame :scrollable = true
     2578             then do:
     2579               assign
     2580                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2581               .
     2582             end.
     2583             run diasize_position-resize-button in this-procedure .
     2584           end.
     2585           else do:
     2586             if frame Dialog-Frame :scrollable = true
     2587             then do:
     2588               assign
     2589                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2590               .
     2591             end.
     2592             assign
     2593               frame Dialog-Frame :width = v-frame-width
     2594             .
     2595             for each buf_temp-browse-handle
     2596               where buf_temp-browse-handle.browse-type = 'width':u
     2597             on error undo, next
     2598             :
     2599               assign
     2600                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2601               .
     2602             end.
     2603             assign
     2604               v-diasize-browse-handle :width = v-browse-width
     2605             .
     2606             for each buf_temp-diasize-handle
     2607             on error undo, next
     2608             :
     2609               assign
     2610                 v-object-handle = buf_temp-diasize-handle.handle-value
     2611               .
     2612               if v-object-handle <> v-diasize-resize-button
     2613               then do:
     2614                 assign
     2615                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2616                 .
     2617               end.
     2618             end.
     2619             run diasize_position-resize-button in this-procedure .
     2620           end.
     2621           assign
     2622             v-diasize-change-size = false
     2623           .
     2624           leave move_block .
     2625         end.
     2626       end.
     2627       assign
     2628         v-diasize-need-full-display = true
     2629       .
     2630       if v-diasize-change-size = false
     2631       then do:
     2632         assign
     2633           v-diasize-change-size = true
     2634         .
     2635       end.
     2636       else do:
     2637         return .
     2638       end.
     2639       assign
     2640         v-frame-width = frame Dialog-Frame :width
     2641         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2642         v-browse-width = v-diasize-browse-handle :width
     2643       .
     2644       for each buf_temp-browse-handle
     2645         where buf_temp-browse-handle.browse-type = 'width':u
     2646       :
     2647         assign
     2648           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2649         .
     2650       end.
     2651       for each buf_temp-diasize-handle
     2652       :
     2653         delete buf_temp-diasize-handle .
     2654       end.
     2655       assign
     2656         v-field-group-handle = frame Dialog-Frame :first-child
     2657       .
     2658       do while valid-handle(v-field-group-handle)
     2659       :
     2660         assign
     2661           v-object-handle = v-field-group-handle :first-child
     2662         .
     2663         do while valid-handle(v-object-handle)
     2664         :
     2665           if  v-object-handle <> v-diasize-browse-handle :handle
     2666           and v-object-handle <> v-diasize-resize-button
     2667           and can-query(v-object-handle, "row")
     2668           and can-query(v-object-handle, "height")
     2669           and ( v-object-handle :col + v-object-handle :width
     2670                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2671               )
     2672           then do:
     2673             find first buf_temp-browse-handle
     2674               where buf_temp-browse-handle.browse-type   = 'width':u
     2675                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2676               no-error .
     2677             if available buf_temp-browse-handle
     2678             then do:
     2679             end.
     2680             else do:
     2681               create buf_temp-diasize-handle .
     2682               assign
     2683                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2684                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2685               .
     2686             end.
     2687           end.
     2688           assign
     2689             v-object-handle = v-object-handle :next-sibling
     2690           .
     2691         end.
     2692         assign
     2693           v-field-group-handle = v-field-group-handle :next-sibling
     2694         .
     2695       end.
     2696       do with frame Dialog-Frame
     2697       :
     2698         hide v-diasize-resize-button .
     2699         v-diasize-resize-button :row = 1.
     2700         v-diasize-resize-button :column = 1.
     2701       end.
     2702       if p-change-value > 0
     2703       then do:
     2704         if frame Dialog-Frame :scrollable = true
     2705         then do:
     2706           assign
     2707             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2708             no-error .
     2709           if error-status :error
     2710           or error-status :get-message(1) <> ""
     2711           then do:
     2712             undo move_block, retry move_block.
     2713           end.
     2714         end.
     2715         assign
     2716           frame Dialog-Frame :width = v-frame-width + p-change-value
     2717           no-error .
     2718         if error-status :error
     2719         or error-status :get-message(1) <> ""
     2720         then do:
     2721           undo move_block, retry move_block.
     2722         end.
     2723         assign
     2724           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2725         no-error .
     2726         if error-status :error
     2727         or error-status :get-message(1) <> ""
     2728         then do:
     2729           undo move_block, retry move_block.
     2730         end.
     2731         for each buf_temp-browse-handle
     2732           where buf_temp-browse-handle.browse-type = 'width':u
     2733         on error undo move_block, retry move_block
     2734         :
     2735           assign
     2736             buf_temp-browse-handle.browse-handle :width
     2737               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2738             no-error .
     2739           if error-status :error
     2740           or error-status :get-message(1) <> ""
     2741           then do:
     2742             undo move_block, retry move_block .
     2743           end.
     2744         end.
     2745         for each buf_temp-diasize-handle
     2746         on error undo move_block, retry move_block
     2747         :
     2748           assign
     2749             v-object-handle = buf_temp-diasize-handle.handle-value
     2750           .
     2751           if v-object-handle <> v-diasize-resize-button
     2752           then do:
     2753             assign
     2754               v-object-handle :col = v-object-handle :col + p-change-value
     2755               no-error .
     2756             if error-status :error
     2757             or error-status :get-message(1) <> ""
     2758             then do:
     2759               undo move_block, retry move_block .
     2760             end.
     2761           end.
     2762         end.
     2763       end.
     2764       else do:
     2765         for each buf_temp-diasize-handle
     2766         on error undo move_block, retry move_block
     2767         :
     2768           assign
     2769             v-object-handle = buf_temp-diasize-handle.handle-value
     2770           .
     2771           if v-object-handle <> v-diasize-resize-button
     2772           then do:
     2773             assign
     2774               v-object-handle :col = v-object-handle :col + p-change-value
     2775               no-error .
     2776             if error-status :error
     2777             or error-status :get-message(1) <> ""
     2778             then do:
     2779               undo move_block, retry move_block .
     2780             end.
     2781           end.
     2782         end.
     2783         for each buf_temp-browse-handle
     2784           where buf_temp-browse-handle.browse-type = 'width':u
     2785         on error undo move_block, retry move_block
     2786         :
     2787           assign
     2788             buf_temp-browse-handle.browse-handle :width
     2789               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2790             no-error .
     2791           if error-status :error
     2792           or error-status :get-message(1) <> ""
     2793           then do:
     2794             undo move_block, retry move_block .
     2795           end.
     2796         end.
     2797         assign
     2798           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2799           no-error .
     2800         if error-status :error
     2801         or error-status :get-message(1) <> ""
     2802         then do:
     2803           undo move_block, retry move_block.
     2804         end.
     2805         assign
     2806           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2807         no-error .
     2808         if error-status :error
     2809         or error-status :get-message(1) <> ""
     2810         then do:
     2811           undo move_block, retry move_block.
     2812         end.
     2813         if frame Dialog-Frame :scrollable = true
     2814         then do:
     2815           assign
     2816             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2817           no-error .
     2818           if error-status :error
     2819           or error-status :get-message(1) <> ""
     2820           then do:
     2821             undo move_block, retry move_block.
     2822           end.
     2823         end.
     2824       end.
     2825       if p-move-resize
     2826       then do:
     2827         run diasize_position-resize-button in this-procedure .
     2828       end.
     2829       if v-diasize-wndstore = true
     2830       then do:
     2831         if connected("ub") = true
     2832         then do:
     2833           define variable v-cntxt-db-num        as integer   no-undo .
     2834           define variable v-cntxt-userid        as character no-undo .
     2835           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2836                                             , OUTPUT v-cntxt-userid
     2837                                             ) .
     2838           run gbl/wndsizew.p
     2839             (input  v-cntxt-db-num
     2840             ,input  v-cntxt-userid
     2841             ,input  v-diasize-proc-name
     2842             ,input  'width':u
     2843             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2844             ) .
     2845         end.
     2846       end.
     2847     end.
     2848     assign
     2849       v-diasize-change-size = false
     2850     .
     2851   end procedure.
     2852   procedure diasize_set-width :
     2853     define input  parameter p-new-width  as decimal   no-undo .
     2854     define input  parameter p-move-resize as logical   no-undo .
     2855     do
     2856     on error undo, return error return-value
     2857     :
     2858       run diasize_change-width in this-procedure
     2859         (input  (p-new-width - frame Dialog-Frame :width)
     2860         ,input  p-move-resize
     2861         ) .
     2862     end.
     2863   end procedure.
     2864   procedure diasize_position-resize-button :
     2865     do with frame Dialog-Frame
     2866     :
     2867       hide v-diasize-resize-button .
     2868       assign
     2869         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2870                     - 1
     2871                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2872         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2873                     - 1
     2874                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2875       .
     2876       view v-diasize-resize-button .
     2877     end.
     2878   end procedure.
     2879   on alt-right anywhere
     2880   do:
     2881     run diasize_change-width in this-procedure
     2882       (input 1
     2883       ,input true
     2884       ) .
     2885     return no-apply .
     2886   end.
     2887   on alt-left anywhere
     2888   do:
     2889     run diasize_change-width in this-procedure
     2890       (input -1
     2891       ,input true
     2892       ) .
     2893     return no-apply .
     2894   end.
     2895   on alt-down anywhere
     2896   do:
     2897     run diasize_change-height in this-procedure
     2898       (input 1
     2899       ,input true
     2900       ) .
     2901     return no-apply .
     2902   end.
     2903   on alt-up anywhere
     2904   do:
     2905     run diasize_change-height in this-procedure
     2906       (input -1
     2907       ,input true
     2908       ) .
     2909     return no-apply .
     2910   end.
     2911   on alt-enter of frame Dialog-Frame
     2912   do:
     2913     run diasize_maximize in this-procedure
     2914       (input  ?
     2915       ).
     2916     return no-apply .
     2917   end.
     2918   procedure diasize_end-move :
     2919     do
     2920     on error undo, return error return-value
     2921     :
     2922       define variable v-row-delta as decimal   no-undo .
     2923       define variable v-col-delta as decimal   no-undo .
     2924       define variable v-new-row as decimal   no-undo .
     2925       define variable v-new-col as decimal   no-undo .
     2926       assign
     2927         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2928         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2929       .
     2930       assign
     2931         v-row-delta = v-new-row - frame Dialog-Frame :height
     2932         v-col-delta = v-new-col - frame Dialog-Frame :width
     2933       .
     2934       run diasize_change-height in this-procedure
     2935         (input v-row-delta
     2936         ,input true
     2937         ) .
     2938       run diasize_change-width in this-procedure
     2939         (input v-col-delta
     2940         ,input true
     2941         ) .
     2942     end.
     2943   end procedure.
     2944   procedure diasize_maximize :
     2945     define input  parameter p-action as logical   no-undo .
     2946     do
     2947     on error undo, return error return-value
     2948     :
     2949       if p-action = ?
     2950       then do:
     2951         if v-diasize-need-maximize = true
     2952         then do:
     2953           assign
     2954             p-action = true
     2955           .
     2956         end.
     2957         else do:
     2958           assign
     2959             p-action = false
     2960           .
     2961         end.
     2962       end.
     2963       if p-action = true
     2964       then do:
     2965         run diasize_change-height in this-procedure
     2966           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2967               - frame Dialog-Frame :height-chars
     2968           ,input true
     2969           ) .
     2970         run diasize_change-width in this-procedure
     2971           (input session :width-chars
     2972               - frame Dialog-Frame :width-chars
     2973           ,input true
     2974           ) .
     2975         assign
     2976           v-diasize-need-maximize = false
     2977         .
     2978       end.
     2979       else do:
     2980         run diasize_change-width in this-procedure
     2981           (input v-diasize-orig-frame-width
     2982               - frame Dialog-Frame :width-chars
     2983           ,input true
     2984           ) .
     2985         run diasize_change-height in this-procedure
     2986           (input v-diasize-orig-frame-height
     2987               - frame Dialog-Frame :height-chars
     2988           ,input true
     2989           ) .
     2990         assign
     2991           v-diasize-need-maximize = true
     2992         .
     2993       end.
     2994     end.
     2995   end procedure.
     2996   procedure diasize_restore-orig-size :
     2997     do
     2998     on error undo, return error return-value
     2999     :
     3000       assign
     3001         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3002         v-diasize-current-frame-height = frame Dialog-Frame :height
     3003       .
     3004       run diasize_set-height in this-procedure
     3005         (input  v-diasize-orig-frame-height
     3006         ,input  true
     3007         ) .
     3008       run diasize_set-width in this-procedure
     3009         (input  v-diasize-orig-frame-width
     3010         ,input  true
     3011         ) .
     3012     end.
     3013   end procedure.
     3014   procedure diasize_restore-current-size :
     3015     do
     3016     on error undo, return error return-value
     3017     :
     3018       run diasize_set-height in this-procedure
     3019         (input  v-diasize-current-frame-height
     3020         ,input  true
     3021         ) .
     3022       run diasize_set-width in this-procedure
     3023         (input  v-diasize-current-frame-width
     3024         ,input  true
     3025         ) .
     3026     end.
     3027   end procedure.
     3028   procedure diasize_set-browse-handle :
     3029     define input  parameter p-browse-handle as handle   no-undo .
     3030     define buffer buf_temp-browse-handle for temp-browse-handle .
     3031     do
     3032     on error undo, return error return-value
     3033     :
     3034       assign
     3035         v-diasize-browse-handle = p-browse-handle
     3036       .
     3037       for each buf_temp-browse-handle
     3038       on error undo, return error return-value
     3039       :
     3040         delete buf_temp-browse-handle .
     3041       end.
     3042     end.
     3043   end procedure.
     3044   procedure diasize_add_browse :
     3045     define input  parameter p-browse-type   as character no-undo .
     3046     define input  parameter p-browse-handle as handle    no-undo .
     3047     define buffer buf_temp-browse-handle for temp-browse-handle .
     3048     do
     3049     on error undo, return error return-value
     3050     :
     3051       assign
     3052         v-diasize-browse-number = v-diasize-browse-number + 1
     3053       .
     3054       create buf_temp-browse-handle .
     3055       assign
     3056         buf_temp-browse-handle.browse-type   = p-browse-type
     3057         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3058         buf_temp-browse-handle.browse-handle = p-browse-handle
     3059       .
     3060     end.
     3061   end procedure.
     3062   procedure diasize_init :
     3063     define variable v-default-value    as logical   no-undo .
     3064     define variable v-restore-saved    as logical   no-undo .
     3065     define variable v-resize-value-str as character no-undo .
     3066     do
     3067     on error undo, return error return-value
     3068     :
     3069       do with frame Dialog-Frame
     3070       :
     3071         assign
     3072           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3073           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3074           v-diasize-browse-handle     = browse BR-cash-pay-list :handle
     3075         .
     3076         create button v-diasize-resize-button
     3077         assign
     3078           parent        = frame Dialog-Frame :first-child
     3079           label         = "s"
     3080           height-pixels = 16
     3081           width-pixels  = 16
     3082           visible       = true
     3083           sensitive     = true
     3084           movable       = true
     3085           triggers:
     3086             on end-move persistent run diasize_end-move in this-procedure .
     3087           end triggers.
     3088         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3089         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3090         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3091         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3092         assign
     3093           v-diasize-wndmax = false
     3094         .
     3095         if connected("ub") = true
     3096         then do:
     3097           define variable v-cntxt-db-num        as integer   no-undo .
     3098           define variable v-cntxt-userid        as character no-undo .
     3099           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3100                                             , OUTPUT v-cntxt-userid
     3101                                             ) .
     3102           run gbl/wndpar_r.p
     3103             (input  v-cntxt-db-num
     3104             ,input  v-cntxt-userid
     3105             ,input  'wndmax':U
     3106             ,output v-diasize-wndmax
     3107             ,output v-default-value
     3108             ) .
     3109         end.
     3110         assign
     3111           v-diasize-wndstore = false
     3112         .
     3113         if connected("ub") = true
     3114         then do:
     3115           run gbl/wndpar_r.p
     3116             (input  v-cntxt-db-num
     3117             ,input  v-cntxt-userid
     3118             ,input  'wndstore':U
     3119             ,output v-diasize-wndstore
     3120             ,output v-default-value
     3121             ) .
     3122         end.
     3123         assign
     3124           v-diasize-proc-name = entry(1, program-name(2), '.')
     3125         .
     3126         if v-diasize-wndstore = true
     3127         then do:
     3128           assign
     3129             v-restore-saved = false
     3130           .
     3131           if connected("ub") = true
     3132           then do:
     3133             run gbl/wndsizer.p
     3134               (input  v-cntxt-db-num
     3135               ,input  v-cntxt-userid
     3136               ,input  v-diasize-proc-name
     3137               ,input  'height':u
     3138               ,output v-resize-value-str
     3139               ) .
     3140             if v-resize-value-str <> '':U
     3141             then do:
     3142               run diasize_change-height in this-procedure
     3143                 (input  integer(v-resize-value-str)
     3144                 ,input  true
     3145                 ) .
     3146               assign
     3147                 v-restore-saved = true
     3148               .
     3149             end.
     3150           end.
     3151           if connected("ub") = true
     3152           then do:
     3153             run gbl/wndsizer.p
     3154               (input  v-cntxt-db-num
     3155               ,input  v-cntxt-userid
     3156               ,input  v-diasize-proc-name
     3157               ,input  'width':u
     3158               ,output v-resize-value-str
     3159               ) .
     3160             if v-resize-value-str <> '':U
     3161             then do:
     3162               run diasize_change-width in this-procedure
     3163                 (input  integer(v-resize-value-str)
     3164                 ,input  true
     3165                 ) .
     3166               assign
     3167                 v-restore-saved = true
     3168               .
     3169             end.
     3170           end.
     3171           if v-restore-saved <> true
     3172           then do:
     3173             if v-diasize-wndmax = true
     3174             then do:
     3175               run diasize_maximize in this-procedure
     3176                 (input  true
     3177                 ) .
     3178             end.
     3179           end.
     3180         end.
     3181         else do:
     3182           if v-diasize-wndmax = true
     3183           then do:
     3184             run diasize_maximize in this-procedure
     3185               (input  true
     3186               ) .
     3187           end.
     3188         end.
     3189       end.
     3190     end.
     3191   end procedure.
     3192   procedure diasize_need-full-display :
     3193     define output parameter p-need-full-display as logical   no-undo .
     3194     do
     3195     on error undo, return error return-value
     3196     :
