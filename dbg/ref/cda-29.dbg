     3533     hide
     3534     frame Dialog-Frame.
     3535     FIND FIRST locked_cash-desk no-LOCK WHERE
     3536             locked_cash-desk.db-num = p-db-num
     3537       AND   locked_cash-desk.obj-code = p-obj-code
     3538       AND   locked_cash-desk.pos-type = p-pos-type
     3539       AND   locked_cash-desk.cash-num = p-cash-num
     3540       NO-ERROR.
     3541     if not available locked_cash-desk then do:
     3542       message
     3543       substitute("Нет POS &1 на БД &2 &3&4 №&5"
     3544                  , p-pos-type
     3545                  , p-db-num
     3546                  , 'маг':U
     3547                  , p-obj-code
     3548                  , p-cash-num)
     3549       view-as alert-box error.
     3550       undo, return error .
     3551     end.
     3552     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     3553       FIND FIRST locked_cash-desk-attr EXCLUSIVE-LOCK WHERE
     3554                 locked_cash-desk-attr.db-num = p-db-num
     3555           AND   locked_cash-desk-attr.obj-code = p-obj-code
     3556           AND   locked_cash-desk-attr.pos-type = p-pos-type
     3557           AND   locked_cash-desk-attr.cash-num = p-cash-num
     3558           AND   locked_cash-desk-attr.upper-attr-code = ''
     3559           AND   locked_cash-desk-attr.attr-code = ''
     3560           NO-WAIT NO-ERROR.
     3561       if not available locked_cash-desk-attr
     3562       and not locked locked_cash-desk-attr then do:
     3563         create locked_cash-desk-attr.
     3564         assign
     3565         locked_cash-desk-attr.db-num = p-db-num
     3566         locked_cash-desk-attr.obj-code = p-obj-code
     3567         locked_cash-desk-attr.pos-type = p-pos-type
     3568         locked_cash-desk-attr.cash-num = p-cash-num
     3569         locked_cash-desk-attr.upper-attr-code = ''
     3570         locked_cash-desk-attr.attr-code = ''
     3571         .
     3572        end.
     3573        if locked locked_cash-desk-attr then do:
     3574           FIND FIRST locked_cash-desk-attr EXCLUSIVE-LOCK WHERE
     3575                     locked_cash-desk-attr.db-num = p-db-num
     3576               AND   locked_cash-desk-attr.obj-code = p-obj-code
     3577               AND   locked_cash-desk-attr.pos-type = p-pos-type
     3578               AND   locked_cash-desk-attr.cash-num = p-cash-num
     3579               AND   locked_cash-desk-attr.upper-attr-code = ''
     3580               AND   locked_cash-desk-attr.attr-code = ''
     3581                NO-ERROR.
     3582         end.
     3583     END.
     3584     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     3585     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     3586     RUN Myenable.
     3587     WAIT-FOR GO OF FRAME Dialog-Frame.
     3588   END.
     3589   RUN disable_UI.
     3590   PROCEDURE disable_UI :
     3591     HIDE FRAME Dialog-Frame.
