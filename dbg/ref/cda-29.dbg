      765   DEFINE TEMP-TABLE temp-pay-names
      766   FIELD frpay-code AS INTEGER
      767   FIELD frpay-name AS CHARACTER
      768   INDEX pi IS UNIQUE PRIMARY frpay-code.
      769   define variable p-obj-type as character no-undo init 'маг':U.
      770   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      771   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO EXTENT 5.
      772   DEFINE VARIABLE v-labels AS CHARACTER NO-UNDO EXTENT 5.
      773   DEFINE VARIABLE v-current-tab-order AS CHARACTER NO-UNDO .
      774   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
      775   DEFINE VARIABLE v-host-code AS INTEGER NO-UNDO.
      776   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      777   define variable v-tth as handle no-undo .
      778   define variable v-tth_ as handle NO-UNDO .
      779   define variable v-tth_main as handle NO-UNDO .
      780   define variable v-tth_devices as handle NO-UNDO .
      781   define variable v-tth_fisreg as handle NO-UNDO .
      782   define variable v-tth_rec-print as handle NO-UNDO .
      783   define variable v-tth_interface as handle NO-UNDO .
      784   DEFINE VARIABLE v-frpay-name AS CHARACTER NO-UNDO.
      785   assign
      786   v-tth = buffer thbjattr_thbj-attr:table-handle
      787   v-tth_ = buffer thbjattr___thbj-attr:table-handle
