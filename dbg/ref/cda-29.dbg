     3611            RS-cash-drawer-level f-advert-text1 rs-log-level BR-pay-names
     3612            t-salesman-mandatory RS-cash-drawer-plug-type CB-screen-type
     3613            f-advert-text2 t-cutter f-cash-drawer-plug-port t-manual-discnt
     3614            f-cash-drawer-plug-imp f-advert-text3 b-screen-layout-id f-com-port
     3615            t-clear-cash-counter f-cash-drawer-limit t-qnty-change
     3616            t-cash-drawer-open f-cliche-lines1 f-cliche-lines2 b-add-cash-pay
     3617            b-del-cash-pay BR-cash-pay-list t-customer-display-plug
     3618            f-cliche-lines3 CB-customer-display-type f-cliche-lines4
     3619            f-cliche-lines5 f-customer-display-port f-cliche-lines6
     3620            f-customer-display-adv1 t-print-good-code f-customer-display-adv2
     3621            f-max-netto CB-keyboard-type rs-rmethod-type b-keyboard-layout-id
     3622            b-curr f-nalc rs-rmethod-coeff CB-cashless-system
     3623            t-rcpt-ord-slip-print t-card-reader-plug b-interface
     3624            t-rcpt-ord-alt-print CB-cctv-system f-cctv-system-address B-devices
     3625            b-rec-print B-main b-fisreg f-main F-devices f-fisreg f-rec-print
     3626            f-interface l-cash-drawer-level l-cash-drawer-plug-type for-curr-name
     3627         WITH FRAME Dialog-Frame.
     3628     VIEW FRAME Dialog-Frame.
     3629     OPEN QUERY BR-cash-pay-list FOR EACH temp-cash-pay-list.    OPEN QUERY BR-pay-names FOR EACH temp-pay-names.
     3630   END PROCEDURE.
     3631   PROCEDURE fill-widgets :
     3632   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     3633   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     3634   define variable v-param-type as character no-undo .
     3635   define variable v-param-value as character no-undo .
     3636   define variable v-value-character as character no-undo .
     3637   define variable v-value-date as date no-undo .
     3638   define variable v-value-decimal as decimal no-undo .
     3639   define variable v-value-integer as INTEGER no-undo .
     3640   define variable v-value-logical AS LOGICAL no-undo .
     3641   DEFINE VARIABLE v-dop1 AS CHARACTER NO-UNDO.
     3642   DEFINE VARIABLE v-fr-code AS integer NO-UNDO.
     3643   DEFINE VARIABLE v-cp-list AS character NO-UNDO.
     3644   DEFINE VARIABLE v-name AS character NO-UNDO.
     3645   DEFINE VARIABLE v-ii AS integer NO-UNDO.
     3646   DEFINE VARIABLE v-jj AS integer NO-UNDO.
     3647   define buffer buf_cash-desk-attr for ub.cash-desk-attr.
     3648   DEFINE BUFFER buf_currency FOR ub.currency.
     3649   FOR EACH thbjattr_thbj-attr:
     3650     delete thbjattr_thbj-attr.
     3651   end.
     3652   FOR EACH temp-thbj-attr:
     3653     delete temp-thbj-attr.
     3654   end.
     3655   run adm/shattri.p (
     3656                 input "init":U
     3657               , input p-obj-type
     3658               , input p-obj-code
     3659               , input 'cd-type-IBS-TH':U
     3660               , input "":U
     3661               , output v-value-character
     3662               , output v-value-date
     3663               , output v-value-decimal
     3664               , output v-value-integer
     3665               , output v-value-logical
     3666               , output v-param-type
     3667               , INPUT-OUTPUT TABLE-handle v-tth
     3668               ) no-error .
     3669   if error-status:error
     3670   and not available locked_cash-desk then do:
     3671     message
     3672     "Не удалось получить начальные значения настроек" skip
     3673     error-status:get-message(1) return-value
     3674     view-as alert-box error .
     3675     undo, return error .
     3676   end.
     3677   for each buf_Cash-desk-attr no-lock where
     3678           buf_cash-desk-attr.db-num = p-db-num
     3679        and buf_cash-desk-attr.obj-code = p-obj-code
     3680        and buf_cash-desk-attr.pos-type = p-pos-type
     3681        and buf_cash-desk-attr.cash-num = p-cash-num
     3682        :
     3683     find first thbjattr_thbj-attr where
     3684               thbjattr_thbj-attr.obj-type = 'маг':U
     3685           and thbjattr_thbj-attr.obj-code = p-obj-code
     3686           and thbjattr_thbj-attr.upper-prop-code  = buf_cash-desk-attr.upper-attr-code
     3687           and thbjattr_thbj-attr.prop-code  = buf_cash-desk-attr.attr-code no-error.
     3688     if not available thbjattr_thbj-attr then do:
     3689       create thbjattr_thbj-attr.
     3690       assign
     3691       thbjattr_thbj-attr.obj-type = 'маг':U
     3692       thbjattr_thbj-attr.obj-code = p-obj-code
     3693       thbjattr_thbj-attr.upper-prop-code  = buf_cash-desk-attr.upper-attr-code
     3694       thbjattr_thbj-attr.prop-code  = buf_cash-desk-attr.attr-code
     3695       .
     3696     end.
     3697     assign
     3698     thbjattr_thbj-attr.property-value-character  = buf_cash-desk-attr.attr-value-character
     3699     thbjattr_thbj-attr.property-value-date  = buf_cash-desk-attr.attr-value-date
     3700     thbjattr_thbj-attr.property-value-decimal  = buf_cash-desk-attr.attr-value-decimal
     3701     thbjattr_thbj-attr.property-value-integer  = buf_cash-desk-attr.attr-value-integer
     3702     thbjattr_thbj-attr.property-value-logical  = buf_cash-desk-attr.attr-value-logical
     3703     thbjattr_thbj-attr.prop-value-type  = buf_cash-desk-attr.attr-value-type
     3704     .
     3705   end.
     3706   FOR EACH thbjattr_thbj-attr:
     3707     ASSIGN
     3708     v-entry = thbjattr_thbj-attr.prop-code.
     3709     CASE thbjattr_thbj-attr.upper-prop-code :
     3710       WHEN 'IBS-TH_main':U THEN DO:
     3711         CASE v-entry:
     3712           WHEN 'cash-shift':U THEN DO:
     3713             ASSIGN
     3714             t-cash-shift = logical(thbjattr_thbj-attr.property-value-integer)
     3715             t-cash-shift:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3716             .
     3717           END.
     3718          WHEN 'nalc':U THEN DO:
     3719             ASSIGN
     3720             f-nalc = thbjattr_thbj-attr.property-value-integer
     3721             f-nalc:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3722             .
     3723             FIND FIRST buf_currency NO-LOCK WHERE
     3724                       buf_currency.curr-code = f-nalc NO-ERROR.
     3725             IF AVAILABLE buf_currency THEN DO:
     3726                 ASSIGN
     3727                 for-curr-name = buf_currency.curr-abbr.
     3728             END.
     3729           END.
     3730          WHEN 'salesman-mandatory':U THEN DO:
     3731             ASSIGN
     3732             t-salesman-mandatory = logical(thbjattr_thbj-attr.property-value-integer)
     3733             t-salesman-mandatory:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3734             .
     3735           END.
     3736           WHEN 'manual-discnt':U THEN DO:
     3737             ASSIGN
     3738             t-manual-discnt = logical(thbjattr_thbj-attr.property-value-integer)
     3739             t-manual-discnt:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3740             .
     3741           END.
     3742           WHEN 'log-level':U THEN DO:
     3743             ASSIGN
     3744             rs-log-level = thbjattr_thbj-attr.property-value-integer
     3745             rs-log-level:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3746             .
     3747           END.
     3748           WHEN 'clear-cash-counter':U THEN DO:
     3749             ASSIGN
     3750             t-clear-cash-counter = logical(thbjattr_thbj-attr.property-value-integer)
     3751             t-clear-cash-counter:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3752             .
     3753           END.
     3754           WHEN 'qnty-change':U THEN DO:
     3755             ASSIGN
     3756             t-qnty-change = logical(thbjattr_thbj-attr.property-value-integer)
     3757             t-qnty-change:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3758             .
     3759           END.
     3760        END CASE.
     3761      END.
     3762      WHEN 'IBS-TH_devices':U THEN DO:
     3763        CASE v-entry:
     3764          WHEN 'cash-drawer-plug':U THEN DO:
     3765            ASSIGN
     3766            t-cash-drawer-plug = logical(thbjattr_thbj-attr.property-value-integer)
     3767            t-cash-drawer-plug:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3768            .
     3769          END.
     3770          WHEN 'cash-drawer-plug-type':U THEN DO:
     3771            ASSIGN
     3772            rs-cash-drawer-plug-type = thbjattr_thbj-attr.property-value-integer
     3773            rs-cash-drawer-plug-type:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3774              .
     3775          END.
     3776          WHEN 'cash-drawer-plug-port':U THEN DO:
     3777            ASSIGN
     3778            f-cash-drawer-plug-port = thbjattr_thbj-attr.property-value-integer
     3779            f-cash-drawer-plug-port:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3780            .
     3781          END.
     3782          WHEN 'cash-drawer-plug-imp':U THEN DO:
     3783            ASSIGN
     3784            f-cash-drawer-plug-imp = thbjattr_thbj-attr.property-value-integer
     3785            f-cash-drawer-plug-imp:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3786            .
     3787          END.
     3788          WHEN 'cash-drawer-open':U THEN DO:
     3789           ASSIGN
     3790           t-cash-drawer-open = logical(thbjattr_thbj-attr.property-value-integer)
     3791           t-cash-drawer-open:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3792           .
     3793          END.
     3794          WHEN 'cash-drawer-limit':U THEN DO:
     3795            ASSIGN
     3796            f-cash-drawer-limit = thbjattr_thbj-attr.property-value-decimal
     3797            f-cash-drawer-limit:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3798            .
     3799          END.
     3800          WHEN 'card-reader-plug':U THEN DO:
     3801            ASSIGN
     3802            t-card-reader-plug = logical(thbjattr_thbj-attr.property-value-integer)
     3803            t-card-reader-plug:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3804            .
     3805          END.
     3806          WHEN 'customer-display-plug':U THEN DO:
     3807            ASSIGN
     3808            t-customer-display-plug = logical(thbjattr_thbj-attr.property-value-integer)
     3809            t-customer-display-plug:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3810            .
     3811          END.
     3812           WHEN 'customer-display-adv':U THEN DO:
     3813             ASSIGN
     3814             f-customer-display-adv = thbjattr_thbj-attr.property-value-character
     3815             f-customer-display-adv1 = entry(1, thbjattr_thbj-attr.property-value-character, chr(4))
     3816             f-customer-display-adv2 = entry(2, thbjattr_thbj-attr.property-value-character, chr(4))
     3817             NO-ERROR
     3818             .
     3819             f-customer-display-adv:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr)).
     3820           END.
     3821          WHEN 'keyboard-type':U THEN DO:
     3822            ASSIGN
     3823            cb-keyboard-type = thbjattr_thbj-attr.property-value-character
     3824            cb-keyboard-type:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3825            .
     3826          END.
     3827          WHEN 'keyboard-layout-id':U THEN DO:
     3828            ASSIGN
     3829            f-keyboard-layout-id = thbjattr_thbj-attr.property-value-character
     3830            f-keyboard-layout-id:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3831            .
     3832          end.
     3833          WHEN 'cashless-system':U THEN DO:
     3834            ASSIGN
     3835            cb-cashless-system = thbjattr_thbj-attr.property-value-character
     3836            cb-cashless-system:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3837            .
     3838          end.
     3839          WHEN 'customer-display-type':U THEN DO:
     3840            ASSIGN
     3841            cb-customer-display-type = thbjattr_thbj-attr.property-value-character
     3842            cb-customer-display-type:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3843            .
     3844          END.
     3845          WHEN 'customer-display-port':U THEN DO:
     3846            ASSIGN
     3847            f-customer-display-port = thbjattr_thbj-attr.property-value-character
     3848            f-customer-display-port:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3849            .
     3850          END.
     3851         WHEN 'cctv-system':U THEN DO:
     3852            ASSIGN
     3853            cb-cctv-system = thbjattr_thbj-attr.property-value-character
     3854            cb-cctv-system:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3855            .
     3856          END.
     3857          WHEN 'cctv-system-address':U THEN DO:
     3858            ASSIGN
     3859            f-cctv-system-address = thbjattr_thbj-attr.property-value-character
     3860            f-cctv-system-address:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3861            .
     3862          END.
     3863         END CASE.
     3864       END.
     3865       WHEN 'IBS-TH_fisreg':U THEN DO:
     3866         CASE v-entry:
     3867           WHEN 'cash-drawer-level':U THEN DO:
     3868            ASSIGN
     3869            rs-cash-drawer-level = thbjattr_thbj-attr.property-value-integer
     3870            rs-cash-drawer-level:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3871              .
     3872           END.
     3873            WHEN 'cash-pay-list':U THEN DO:
     3874             run get-cash-pay-list in this-procedure ( input thbjattr_thbj-attr.property-value-character).
     3875            END.
     3876            WHEN 'pay-names':U THEN DO:
     3877              run get-pay-names in this-procedure ( input thbjattr_thbj-attr.property-value-character).
     3878            end.
     3879             WHEN 'cutter':U THEN DO:
     3880               ASSIGN
     3881               t-cutter = logical(thbjattr_thbj-attr.property-value-integer)
     3882               t-cutter:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3883               .
     3884             END.
     3885             WHEN 'com-port':U THEN DO:
     3886               ASSIGN
     3887               f-com-port = thbjattr_thbj-attr.property-value-character
     3888               f-com-port:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3889               .
     3890             END.
     3891         END case.
     3892       END.
     3893       WHEN 'IBS-TH_rec-print':U THEN DO:
     3894         CASE v-entry:
     3895           WHEN 'max-netto':U THEN DO:
     3896             ASSIGN
     3897             f-max-netto = thbjattr_thbj-attr.property-value-decimal
     3898             f-max-netto:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3899             .
     3900           END.
     3901           WHEN 'advert-text':U THEN DO:
     3902            ASSIGN
     3903            f-advert-text = thbjattr_thbj-attr.property-value-character
     3904            f-advert-text:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3905            f-advert-text1 = ENTRY(1, f-advert-text, chr(4))
     3906            f-advert-text2 = ENTRY(2, f-advert-text, chr(4))
     3907            f-advert-text3 = ENTRY(3, f-advert-text, chr(4))
     3908            .
     3909           END.
     3910           WHEN 'cliche-lines':U THEN DO:
     3911             ASSIGN
     3912             f-cliche-lines = thbjattr_thbj-attr.property-value-character
     3913             f-cliche-lines:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3914             f-cliche-lines1 = ENTRY(1, f-cliche-lines, chr(4))
     3915             f-cliche-lines2 = ENTRY(2, f-cliche-lines, chr(4))
     3916             f-cliche-lines3 = ENTRY(3, f-cliche-lines, chr(4))
     3917             f-cliche-lines4 = ENTRY(4, f-cliche-lines, chr(4))
     3918             f-cliche-lines5 = ENTRY(5, f-cliche-lines, chr(4))
     3919             f-cliche-lines6 = ENTRY(6, f-cliche-lines, chr(4))
     3920             .
     3921           END.
     3922           WHEN 'print-good-code':U THEN DO:
     3923                ASSIGN
     3924                t-print-good-code = logical(thbjattr_thbj-attr.property-value-integer)
     3925                t-print-good-code:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3926                .
     3927           END.
     3928           when 'rmethod-type':U then do:
     3929            ASSIGN
     3930            rs-rmethod-type = thbjattr_thbj-attr.property-value-character
     3931            rs-rmethod-type:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3932            .
     3933           end.
     3934           when 'rmethod-coeff':U then do:
     3935            ASSIGN
     3936            v-rmethod-coeff = thbjattr_thbj-attr.property-value-decimal
     3937            v-rmethod-coeff:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3938            .
     3939          end.
     3940          when 'rcpt-ord-slip-print':U then do:
     3941            ASSIGN
     3942            t-rcpt-ord-slip-print = logical(thbjattr_thbj-attr.property-value-integer)
     3943            t-rcpt-ord-slip-print:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3944            .
     3945          end.
     3946          when 'rcpt-ord-alt-print':U then do:
     3947            ASSIGN
     3948            t-rcpt-ord-alt-print = logical(thbjattr_thbj-attr.property-value-integer)
     3949            t-rcpt-ord-alt-print:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3950            .
     3951          end.
     3952         END CASE.
     3953       END.
     3954       when 'IBS-TH_interface':U then do:
     3955         case v-entry:
     3956          WHEN 'screen-type':U THEN DO:
     3957            ASSIGN
     3958            cb-screen-type = thbjattr_thbj-attr.property-value-character
     3959            cb-screen-type:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3960            .
     3961          END.
     3962          WHEN 'screen-layout-id':U THEN DO:
     3963            ASSIGN
     3964            f-screen-layout-id = thbjattr_thbj-attr.property-value-character
     3965            f-screen-layout-id:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     3966            .
     3967          end.
     3968         END CASE.
     3969       end.
     3970     END CASE.
     3971     create temp-thbj-attr.
     3972     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     3973   END.
     3974   if rs-rmethod-type = "MROUND" then do:
     3975     ASSIGN
     3976     rs-rmethod-coeff = v-rmethod-coeff
     3977     f-rmethod-coeff = 0
     3978     .
     3979   end.
     3980   else do:
     3981     assign
     3982     f-rmethod-coeff = v-rmethod-coeff
     3983     rs-rmethod-coeff = 2
     3984     .
     3985   end.
     3986   END PROCEDURE.
     3987   PROCEDURE MyEnable :
     3988   DEFINE VARIABLE v-h AS HANDLE NO-UNDO.
     3989   DEFINE VARIABLE v-h1 AS HANDLE NO-UNDO.
     3990   DEFINE VARIABLE v-ii AS integer NO-UNDO.
     3991   DEFINE VARIABLE v-jj AS integer NO-UNDO.
     3992   define variable v-list-items as character no-undo .
     3993   define variable wh as widget-handle no-undo .
     3994   define variable fh as widget-handle no-undo .
     3995   DEFINE BUFFER buf_layout FOR ub.layout.
     3996   v-list-items = chr(44).
     3997   do v-ii = 1 to num-entries('IBM-VFD,Shtrih-M_v_A1.40,Posiflex-pd2800-320':U):
     3998     v-list-items = v-list-items + chr(44) +
     3999                    entry(v-ii, 'IBM VFD,Штрих-М v.A1.40,Posiflex-pd2800-320':U) + chr(44) + entry(v-ii, 'IBM-VFD,Shtrih-M_v_A1.40,Posiflex-pd2800-320':U)
     4000     .
     4001   end.
     4002   assign
     4003   cb-customer-display-type:list-item-pairs in frame Dialog-Frame = v-list-items
     4004   .
     4005   v-list-items = ''.
     4006   do v-ii = 1 to num-entries('0,1,2,3':U):
     4007     v-list-items = v-list-items + (if v-ii = 1 then '' else chr(44)) +
     4008                    entry(v-ii, 'Нет логирования,Низкий,Средний,Высокий':U) + chr(44) + entry(v-ii, '0,1,2,3':U)
     4009     .
     4010   end.
     4011   assign
     4012   rs-log-level:radio-buttons in frame Dialog-Frame = v-list-items
     4013   .
     4014   v-list-items = ''.
     4015   assign
     4016   cb-keyboard-type:list-items in frame Dialog-Frame  = chr(44) + 'IBM-50':U.
     4017   cb-screen-type:list-items in frame Dialog-Frame  =  'Screen,TouchScreen':U.
     4018   v-list-items = chr(44).
     4019   do v-ii = 1 to  num-entries('sberbank':U):
     4020     assign
     4021     v-list-items = v-list-items + chr(44) + entry (lookup (entry(v-ii, 'sberbank':U), 'sberbank':U) + 1, ',' + 'Сбербанк':U) + chr(44) + entry(v-ii, 'sberbank':U).
     4022   end.
     4023   assign
     4024   cb-cashless-system:list-item-pairs in frame Dialog-Frame =  v-list-items
     4025   .
     4026   v-list-items = chr(44).
     4027   do v-ii = 1 to  num-entries('Intellect,Prizma':U):
     4028     assign
     4029     v-list-items = v-list-items + chr(44) + entry (lookup (entry(v-ii, 'Intellect,Prizma':U), 'Intellect,Prizma':U) + 1, ',' + 'Интеллект,Призма':U) + chr(44) + entry(v-ii, 'Intellect,Prizma':U).
     4030   end.
     4031   assign
     4032   cb-cctv-system:list-item-pairs in frame Dialog-Frame =  v-list-items
     4033   .
     4034   assign
     4035   rs-rmethod-type:radio-buttons in frame Dialog-Frame = "Отсечение до n-знака после зап." + chr(44) + "MROUND" + chr(44) +
     4036                                                           "Нет номиналов меньше чем" + chr(44) + "NO-COINS"
     4037   .
     4038   rs-rmethod-coeff:radio-buttons in frame Dialog-Frame = "Сотни" + chr(44) +  "-2" + chr(44) +
     4039                                                           "Десятки" + chr(44) + "-1"  + chr(44) +
     4040                                                           "Рубли" + chr(44) + "0" + chr(44)  +
     4041                                                           "Десятки копеек" + chr(44) + "1"  + chr(44) +
     4042                                                           "копейки" + chr(44) + "2".
     4043   ASSIGN
     4044   FRAME Dialog-Frame:TITLE = substitute("&1 &2&3"
     4045                                          ,FRAME Dialog-Frame:TITLE
     4046                                          ,(if p-obj-type = ""
     4047                                            then ""
     4048                                            else 'маг':U)
     4049                                          ,(IF p-obj-type = "" THEN "" ELSE string(p-obj-code)))
     4050   v-tab-order[1] = "t-cash-shift,t-salesman-mandatory,t-manual-discnt,t-clear-cash-counter,t-qnty-change,b-curr,rs-log-level"
     4051   v-labels[1] = 'f-nalc,for-curr-name,l-log-level'
     4052   v-tab-order[2] = "t-cash-drawer-plug,rs-cash-drawer-plug-type,f-cash-drawer-plug-port,f-cash-drawer-plug-imp,f-cash-drawer-limit,t-cash-drawer-open," +
     4053                    "t-customer-display-plug,cb-customer-display-type,f-customer-display-port,f-customer-display-adv1,f-customer-display-adv2," +
     4054                    "cb-keyboard-type,b-keyboard-layout-id,cb-cashless-system,t-card-reader-plug,cb-cctv-system,f-cctv-system-address"
     4055   v-labels[2] = 'l-cash-drawer-plug-type,f-keyboard-layout-id,f-keyboard-layout-name'
     4056   v-tab-order[3] = "rs-cash-drawer-level,br-cash-pay-list,b-add-cash-pay,b-del-cash-pay,br-pay-names,t-cutter,f-com-port"
     4057   v-labels[3] = "l-cash-drawer-level"
     4058   v-tab-order[4] = "f-advert-text1,f-advert-text2,f-advert-text3," +
     4059                     "f-cliche-lines1,f-cliche-lines2,f-cliche-lines3,f-cliche-lines4," +
     4060                     "t-print-good-code,f-max-netto,rs-rmethod-type,rs-rmethod-coeff,f-rmethod-coeff,t-rcpt-ord-slip-print,t-rcpt-ord-alt-print"
     4061   v-labels[4] = "l-rmethod"
     4062   v-tab-order[5] = "cb-screen-type,b-screen-layout-id"
     4063   v-labels[5] = "f-screen-layout-id,f-screen-layout-name"
     4064   .
     4065   v-h = FRAME Dialog-Frame:FIRST-CHILD.
     4066   DO WHILE valid-handle(v-h).
     4067     IF v-h:TYPE = "field-group"  THEN DO:
     4068        v-h1 = v-h:FIRST-CHILD.
     4069        DO WHILE valid-handle(v-h1).
     4070         RUN tempwidg_create-record IN THIS-PROCEDURE ( INPUT v-h1).
     4071         ASSIGN
     4072         v-h1 = v-h1:NEXT-sibling.
     4073       END.
     4074     END.
     4075     v-h = v-h:NEXT-SIBLING.
     4076   END.
     4077   DO v-ii = 1 TO 5:
     4078     IF v-tab-order[v-ii] > '' THEN do:
     4079       DO v-jj = 1 TO NUM-ENTRIES(v-tab-order[v-ii]):
     4080        FIND FIRST temp-widget WHERE
     4081                   temp-widget.name_ = ENTRY(v-jj,v-tab-order[v-ii]) NO-ERROR.
     4082        IF AVAILABLE temp-widget THEN DO:
     4083            temp-widget.section_ = STRING(v-ii).
     4084        END.
     4085       END.
     4086     END.
     4087     IF v-labels[v-ii] > '' THEN do:
     4088       DO v-jj = 1 TO NUM-ENTRIES(v-labels[v-ii]):
     4089        FIND FIRST temp-widget WHERE
     4090                   temp-widget.name_ = ENTRY(v-jj,v-labels[v-ii]) NO-ERROR.
     4091        IF AVAILABLE temp-widget THEN DO:
     4092           temp-widget.section_ = STRING(v-ii).
     4093         END.
     4094       END.
     4095     END.
     4096   END.
     4097   RUN tempwidg_write-character IN THIS-PROCEDURE ( INPUT "f-cliche-lines1", f-cliche-lines1).
     4098   RUN tempwidg_write-character IN THIS-PROCEDURE ( INPUT "f-cliche-lines2", f-cliche-lines2).
     4099   RUN tempwidg_write-character IN THIS-PROCEDURE ( INPUT "f-cliche-lines3", f-cliche-lines3).
     4100   RUN tempwidg_write-character IN THIS-PROCEDURE ( INPUT "f-cliche-lines4", f-cliche-lines4).
     4101   RUN tempwidg_write-character IN THIS-PROCEDURE ( INPUT "f-advert-text1", f-advert-text1).
     4102   RUN tempwidg_write-character IN THIS-PROCEDURE ( INPUT "f-advert-text2", f-advert-text2).
     4103   RUN tempwidg_write-character IN THIS-PROCEDURE ( INPUT "f-advert-text3", f-advert-text3).
     4104   RUN tempwidg_write-character IN THIS-PROCEDURE ( INPUT "f-customer-display-adv1", f-customer-display-adv1).
     4105   RUN tempwidg_write-character IN THIS-PROCEDURE ( INPUT "f-customer-display-adv2", f-customer-display-adv2).
     4106   RUN tempwidg_write-character IN THIS-PROCEDURE ( INPUT "f-rmethod-coeff", f-rmethod-coeff).
     4107   FIND FIRST buf_layout NO-LOCK WHERE
     4108             buf_layout.layout-id = f-keyboard-layout-id NO-ERROR.
     4109   IF AVAILABLE buf_layout THEN DO:
     4110       ASSIGN
     4111       f-keyboard-layout-name = buf_layout.layout-name.
     4112   END.
     4113   ELSE DO:
     4114       ASSIGN
     4115       f-keyboard-layout-name = ?.
     4116   END.
     4117   FIND FIRST buf_layout NO-LOCK WHERE
     4118             buf_layout.layout-id = f-screen-layout-id NO-ERROR.
     4119   IF AVAILABLE buf_layout THEN DO:
     4120       ASSIGN
     4121       f-screen-layout-name = buf_layout.layout-name.
     4122   END.
     4123   ELSE DO:
     4124       ASSIGN
     4125       f-screen-layout-name = ?.
     4126   END.
     4127   DISPLAY
     4128   f-main
     4129   f-devices
     4130   f-fisreg
     4131   f-rec-print
     4132   f-interface
     4133   for-curr-name
     4134   l-cash-drawer-plug-type
     4135   l-cash-drawer-level
     4136   f-keyboard-layout-name
     4137   f-screen-layout-name
     4138   l-log-level
     4139   t-clear-cash-counter
     4140   t-qnty-change
     4141   WITH FRAME Dialog-Frame.
     4142   assign
     4143   fh = frame Dialog-Frame:first-child
     4144   wh = fh:first-child
     4145   .
     4146   do while valid-handle(wh):
     4147   if wh:private-data begins "recid=" then do:
     4148     find first thbjattr_thbj-attr where
     4149               recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     4150     IF wh:DATA-TYPE = 'logical':U
     4151     AND thbjattr_thbj-attr.prop-value-type = 'integer':U THEN DO:
     4152        wh:screen-value = string(IF thbjattr_thbj-attr.property-value-integer = 1 THEN YES ELSE NO).
     4153     END.
     4154     ELSE DO:
     4155       assign
     4156       wh:screen-value = string(buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value).
     4157     END.
     4158   end.
     4159   ELSE DO:
     4160      FIND FIRST temp-widget NO-LOCK WHERE
     4161                temp-widget.NAME_ = wh:NAME NO-ERROR.
     4162      IF AVAILABLE temp-widget THEN DO:
     4163         CASE temp-widget.DATA-TYPE_:
     4164           WHEN 'character':U THEN DO:
     4165               ASSIGN
     4166               wh:SCREEN-VALUE = temp-widget.CHARACTER_.
     4167           END.
     4168         END CASE.
     4169      END.
     4170   END.
     4171   wh = wh:next-sibling.
     4172   end.
     4173   ENABLE
     4174   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
