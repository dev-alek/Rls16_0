     4402   PROCEDURE proc-save :
     4403   define variable v-value-character as character no-undo .
     4404   define variable v-value-date as date no-undo .
     4405   define variable v-value-decimal as decimal no-undo .
     4406   define variable v-value-integer as INTEGER no-undo .
     4407   define variable v-value-logical AS LOGICAL no-undo .
     4408   define variable v-param-type as character no-undo .
     4409   define variable wh as widget-handle no-undo .
     4410   define variable fh as widget-handle no-undo .
     4411   define variable v-same as logical no-undo .
     4412   define variable v-loc-same as logical no-undo .
     4413   define variable v-cash-pay-list as character no-undo .
     4414   define variable v-pay-names as character no-undo .
     4415   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     4416   run  set-cash-pay-list in this-procedure ( output v-cash-pay-list) no-error.
     4417   if error-status:error then do:
     4418     message
     4419     error-status:get-message(1)  skip
     4420     return-value
     4421     view-as alert-box error .
     4422     undo, return error .
     4423   end.
     4424   run set-pay-names in this-procedure ( output v-pay-names) no-error.
     4425   if error-status:error then do:
     4426     message
     4427     error-status:get-message(1)  skip
     4428     return-value
     4429     view-as alert-box error .
     4430     undo, return error .
     4431   end.
     4432   assign
     4433   fh = frame Dialog-Frame:first-child
     4434   wh = fh:first-child
     4435   .
     4436     main-block:
     4437     do transaction:
     4438     do while valid-handle(wh):
     4439       if wh:private-data begins "recid=" then do:
     4440         find first thbjattr_thbj-attr where
     4441                   recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     4442         IF wh:DATA-TYPE = 'logical':U
     4443         AND thbjattr_thbj-attr.prop-value-type = 'integer':U THEN DO:
     4444           assign
     4445           thbjattr_thbj-attr.property-value-integer = (IF wh:INPUT-VALUE = YES THEN 1 ELSE 0).
     4446         END.
     4447         ELSE DO:
     4448           assign
     4449           buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     4450         END.
     4451       end.
     4452       wh = wh:next-sibling.
     4453     end.
     4454     find first thbjattr_thbj-attr where
     4455               thbjattr_thbj-attr.upper-prop-code = 'IBS-TH_fisreg':U
     4456           and thbjattr_thbj-attr.prop-code = 'cash-pay-list':U
     4457           and thbjattr_thbj-attr.obj-type = p-obj-type
     4458           and thbjattr_thbj-attr.obj-code = p-obj-code  .
     4459     assign
     4460     thbjattr_thbj-attr.property-value-character = v-cash-pay-list.
     4461     find first thbjattr_thbj-attr where
     4462               thbjattr_thbj-attr.upper-prop-code = 'IBS-TH_fisreg':U
     4463           and thbjattr_thbj-attr.prop-code = 'pay-names':U
     4464           and thbjattr_thbj-attr.obj-type = p-obj-type
     4465           and thbjattr_thbj-attr.obj-code = p-obj-code  .
     4466     assign
     4467     thbjattr_thbj-attr.property-value-character = v-pay-names.
     4468     for each thbjattr_thbj-attr
     4469     break by thbjattr_thbj-attr.upper-prop-code
     4470     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4471     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     4472     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     4473     :
     4474       if first-of(thbjattr_thbj-attr.upper-prop-code) then do:
     4475         empty temp-table thbjattr___thbj-attr.
     4476       end.
     4477       create thbjattr___thbj-attr.
     4478       buffer-copy
     4479       thbjattr_thbj-attr
     4480       to
     4481       thbjattr___thbj-attr.
     4482       if last-of(thbjattr_thbj-attr.upper-prop-code) then do:
     4483         empty temp-table thbjattr___thbj-attr.
     4484       end.
     4485     end.
     4486     v-same = yes.
     4487     for each thbjattr_thbj-attr,
     4488         first temp-thbj-attr where
     4489               temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     4490           and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     4491           and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     4492           and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code
     4493     break
     4494     by thbjattr_thbj-attr.upper-prop-code :
     4495       buffer-compare
     4496       thbjattr_thbj-attr
     4497       to temp-thbj-attr
     4498       save result in v-loc-same.
     4499       if v-loc-same = no then do:
     4500         if  thbjattr_thbj-attr.upper-prop-code <> 'cd-type-IBS-TH':U
     4501         then do:
     4502           run update-cda in this-procedure ( buffer thbjattr_thbj-attr).
     4503         end.
     4504       end.
     4505     end.
     4506   end.
     4507   v-same = no.
     4508   END PROCEDURE.
     4509   PROCEDURE update-cda :
     4510   DEFINE PARAMETER BUFFER buf_thbjattr_thbj-attr FOR thbjattr_thbj-attr.
     4511   define buffer buf_cash-desk-attr for ub.cash-desk-attr.
     4512   find first   buf_cash-desk-attr share-lock where
     4513         buf_cash-desk-attr.db-num = locked_Cash-desk.db-num
     4514     and buf_cash-desk-attr.obj-code = locked_Cash-desk.obj-code
     4515     and buf_cash-desk-attr.pos-type = locked_Cash-desk.pos-type
     4516     and buf_cash-desk-attr.cash-num = locked_cash-desk.cash-num
     4517     and buf_cash-desk-attr.upper-attr-code = buf_thbjattr_thbj-attr.upper-prop-code
     4518   and buf_cash-desk-attr.attr-code = buf_thbjattr_thbj-attr.prop-code
     4519   no-error.
     4520   if not available buf_Cash-desk-attr then do:
     4521     create buf_cash-desk-attr.
     4522     assign
     4523     buf_cash-desk-attr.db-num = locked_Cash-desk.db-num
     4524     buf_cash-desk-attr.obj-code = locked_Cash-desk.obj-code
     4525     buf_cash-desk-attr.pos-type = locked_Cash-desk.pos-type
     4526     buf_cash-desk-attr.cash-num = locked_cash-desk.cash-num
     4527     buf_cash-desk-attr.upper-attr-code = buf_thbjattr_thbj-attr.upper-prop-code
     4528     buf_cash-desk-attr.attr-code = buf_thbjattr_thbj-attr.prop-code
     4529     .
     4530   end.
     4531   assign
     4532   buf_cash-desk-attr.attr-value-character = buf_thbjattr_thbj-attr.property-value-character
     4533   buf_cash-desk-attr.attr-value-date = buf_thbjattr_thbj-attr.property-value-date
     4534   buf_cash-desk-attr.attr-value-decimal = buf_thbjattr_thbj-attr.property-value-decimal
     4535   buf_cash-desk-attr.attr-value-integer = buf_thbjattr_thbj-attr.property-value-integer
     4536   buf_cash-desk-attr.attr-value-logical = buf_thbjattr_thbj-attr.property-value-logical
     4537   buf_cash-desk-attr.attr-value-type = buf_thbjattr_thbj-attr.prop-value-type
     4538   .
     4539   END PROCEDURE.
     4540   FUNCTION get-frpay-name RETURNS CHARACTER
     4541     ( INPUT p-frpay-code AS INTEGER ) :
     4542   DEFINE BUFFER buf_temp-pay-names FOR temp-pay-names.
     4543   FIND first buf_temp-pay-names WHERE
     4544           buf_temp-pay-names.frpay-code = p-frpay-code NO-ERROR.
     4545   IF NOT AVAILABLE buf_temp-pay-names THEN RETURN "".
     4546   RETURN buf_temp-pay-names.frpay-name.
     4547   END FUNCTION.
     4548   FUNCTION getcp-name RETURNS CHARACTER
     4549     ( INPUT p-cdpay-code AS INTEGER , INPUT p-curr-code AS INTEGER) :
     4550   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     4551   FIND first buf_cash-pay NO-LOCK  WHERE
     4552           buf_cash-pay.cdpay-code = p-cdpay-code
     4553       AND buf_Cash-pay.curr-code = p-curr-code NO-ERROR.
     4554   IF NOT AVAILABLE buf_cash-pay THEN RETURN "!!!НЕИЗВЕСТНЫЙ ТИП КАСС.ПЛАТЕЖА".
     4555   RETURN buf_cash-pay.obj-name.
     4556   END FUNCTION.
