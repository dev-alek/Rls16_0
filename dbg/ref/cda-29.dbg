      789   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      790   procedure get-cash-pay-list :
      791   define input parameter p-cp-list as character no-undo .
      792   define variable v-ii as integer no-undo .
      793   define variable v-jj as integer no-undo .
      794   define variable v-dop1 as character no-undo .
      795   define variable v-fr-code as integer no-undo .
      796   define variable v-cp-list as character no-undo .
      797   define buffer buf_temp-cash-pay-list for temp-cash-pay-list.
      798   do
      799   on error undo, return error
      800   :
      801     DO v-ii = 1 TO num-entries(p-cp-list, chr(4)):
      802       v-dop1 = ENTRY(v-ii, p-cp-list, chr(4)).
      803       ASSIGN
      804       v-fr-code = INTEGER(ENTRY(1, v-dop1, "="))
      805       v-cp-list = ENTRY(2, v-dop1, "=")
      806       NO-ERROR.
      807       IF v-fr-code >= 2
      808       AND v-fr-code <= 4 THEN DO:
      809         DO v-jj = 1 TO num-entries(v-cp-list, ";"):
      810           FIND FIRST buf_temp-cash-pay-list WHERE
      811                     buf_temp-cash-pay-list.cdpay-code = integer(ENTRY(1, ENTRY(v-jj, v-cp-list, ";"), chr(58)))
      812               AND buf_temp-cash-pay-list.curr-code = integer(ENTRY(2, ENTRY(v-jj, v-cp-list, ";"), chr(58))) NO-ERROR.
      813           IF NOT AVAILABLE buf_temp-cash-pay-list THEN DO:
      814             CREATE buf_temp-cash-pay-list.
      815             ASSIGN
      816             buf_temp-cash-pay-list.cdpay-code = integer(ENTRY(1, ENTRY(v-jj, v-cp-list, ";"), chr(58)))
      817             buf_temp-cash-pay-list.curr-code = integer(ENTRY(2, ENTRY(v-jj, v-cp-list, ";"), chr(58)))
      818             buf_temp-cash-pay-list.frpay-code = v-fr-code
      819             .
      820           END.
      821         end.
      822       end.
      823     end.
      824   END.
      825   end procedure.
      826   procedure get-pay-names :
      827   define input parameter p-pay-names-list as character no-undo .
      828   define variable v-ii as integer no-undo .
      829   define variable v-fr-code as integer no-undo .
      830   define variable v-name as character no-undo .
      831   define buffer buf_temp-pay-names for temp-pay-names.
      832   do
      833   on error undo, return error
      834   :
      835     DO v-ii = 1 TO num-entries(p-pay-names-list, chr(4)):
      836       ASSIGN
      837       v-fr-code = v-ii + 1
      838       v-name = ENTRY(v-ii, p-pay-names-list, chr(4))
      839       NO-ERROR.
      840       IF v-fr-code >= 2
      841       AND v-fr-code <= 4 THEN DO:
      842         FIND FIRST buf_temp-pay-names WHERE
      843                   buf_temp-pay-names.frpay-code = v-fr-code NO-ERROR.
      844         IF NOT AVAILABLE buf_temp-pay-names THEN DO:
      845           CREATE buf_temp-pay-names.
      846           ASSIGN
      847           buf_temp-pay-names.frpay-code = v-fr-code
      848           buf_temp-pay-names.frpay-name = v-name
      849           .
      850         END.
      851       END.
      852     END.
      853   end.
      854   end procedure.
      855   procedure set-cash-pay-list :
      856   define output parameter p-cash-pay-list as character no-undo .
      857   define buffer buf_temp-cash-pay-list for temp-cash-pay-list.
      858   do
      859   on error undo, return error
      860   :
      861     FOR EACH buf_temp-cash-pay-list
      862     BREAK BY
      863     buf_temp-cash-pay-list.frpay-code:
      864       IF not(buf_temp-cash-pay-list.frpay-code  >= 2
      865            AND
      866            buf_temp-cash-pay-list.frpay-code  <= 4) THEN DO:
      867       undo, return error  substitute("Неверно заполнено соответствие для типа кассового платежа TH с кодом &1 и валютой &2"
      868                  , buf_temp-cash-pay-list.cdpay-code
      869                  , buf_temp-cash-pay-list.curr-code).
      870       END.
      871       IF FIRST-OF(buf_temp-cash-pay-list.frpay-code) THEN DO:
      872         ASSIGN
      873         p-cash-pay-list = substitute("&1&2&3="
      874                                     ,p-cash-pay-list
      875                                     ,chr(4)
      876                                       ,buf_temp-cash-pay-list.frpay-code) .
      877       END.
      878       ASSIGN
      879       p-cash-pay-list = substitute("&1&2:&3;"
      880                                   ,p-cash-pay-list
      881                                     ,buf_temp-cash-pay-list.cdpay-code
      882                                     ,buf_temp-cash-pay-list.curr-code
      883                                     ) .
      884       IF last-OF(buf_temp-cash-pay-list.frpay-code) THEN DO:
      885         ASSIGN
      886         p-cash-pay-list = right-trim(p-cash-pay-list, ";").
      887       END.
      888     END.
      889     assign
      890     p-cash-pay-list = LEFT-TRIM(p-cash-pay-list, chr(4))
      891     p-cash-pay-list = right-TRIM(p-cash-pay-list, ";")
      892     .
      893   end.
      894   end procedure.
      895   procedure set-pay-names :
      896   define output parameter p-pay-names as character no-undo .
      897   define buffer buf_temp-pay-names for temp-pay-names.
      898   do
      899   on error undo, return error
      900   :
      901     FOR EACH buf_temp-pay-names
      902     BY buf_temp-pay-names.frpay-code
      903         :
      904       IF buf_temp-pay-names.frpay-code >= 2
      905       OR buf_temp-pay-names.frpay-code <= 2
      906       THEN
      907       ASSIGN
      908       p-pay-names = substitute("&1&2&3"
      909                                     ,p-pay-names
      910                                     ,chr(4)
      911                                     ,buf_temp-pay-names.frpay-name) .
      912     END.
      913     ASSIGN
      914     p-pay-names = left-trim(p-pay-names, chr(4))
      915     .
      916   end.
      917   end procedure.
