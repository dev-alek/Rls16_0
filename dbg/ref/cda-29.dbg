      679   DEFINE TEMP-TABLE temp-widget
      680   FIELD NAME_ AS CHARACTER
      681   FIELD LENGTH_ AS DECIMAL
      682   FIELD index_ AS INTEGER
      683   FIELD HANDLE_ AS HANDLE
      684   FIELD format_ AS CHARACTER
      685   FIELD width_ AS DECIMAL
      686   field section_ as character
      687   field visible_ as integer
      688   field column_ as decimal
      689   field row_ as decimal
      690   field data-type_ as character
      691   field character_ as character
      692   field date_ as date
      693   field decimal_ as decimal
      694   field integer_ as decimal
      695   field logical_ as logical
      696   INDEX pi IS UNIQUE PRIMARY
      697   NAME_
      698   INDEX iindex
      699   INDEX_
      700   index isection
      701   section_
      702   .
      703   procedure tempwidg_create-record :
      704   define input parameter p-handle as widget-handle no-undo .
      705   define buffer buf_temp-widget for temp-widget.
      706   do
      707   on error undo, return error
      708   :
      709     find first buf_temp-widget where
      710               buf_temp-widget.name = p-handle:name no-error.
      711     if not available buf_temp-widget then do:
      712       create buf_temp-widget.
      713       assign
      714       buf_temp-widget.name = p-handle:name
      715       buf_temp-widget.index_ = v-tempwidg-index + 1
      716       buf_temp-widget.handle_ = p-handle
      717       v-tempwidg-index = v-tempwidg-index + 1
      718       .
      719     end.
      720   end.
      721   end procedure.
      722   procedure tempwidg_write-character :
      723   define input parameter p-name as character no-undo .
      724   define input parameter p-character as character no-undo .
      725   define buffer buf_temp-widget for temp-widget.
      726   do
      727   on error undo, return error
      728   :
      729     find first buf_temp-widget where
      730               buf_temp-widget.name = p-name no-error.
      731     if available buf_temp-widget then do:
      732       assign
      733       buf_temp-widget.character_ = p-character
      734       buf_temp-widget.data-type_ = 'character':U
      735       .
      736     end.
      737   end.
      738   end procedure.
