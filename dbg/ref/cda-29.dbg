     3205   procedure get-context :
     3206      define output parameter p-db-num as integer          no-undo.
     3207      define output parameter p-user-id as character        no-undo.
     3208      define variable v-login               as character    no-undo.
     3209      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3210      define buffer buf_user-login  for ub.user-login .
     3211      do
     3212      on error undo, return error
     3213      :
     3214            FIND FIRST buf_sys-ctrl no-lock.
     3215            ASSIGN
     3216               v-login = USERID("ub")
     3217               p-db-num = buf_sys-ctrl.db-num
     3218            .
     3219            FIND FIRST buf_user-login
     3220                 WHERE buf_user-login.db-num = p-db-num
     3221                   AND buf_user-login.user-login = v-login
     3222                 no-lock
     3223                 no-error
     3224                 .
     3225            IF AVAILABLE buf_user-login
     3226            THEN DO:
     3227               assign
     3228                  p-user-id = buf_user-login.user-id
     3229               .
     3230            END.
     3231      end.
     3232   end procedure.
     3233       run diasize_init in this-procedure .
     3234   ON LEAVE OF temp-cash-pay-list.frpay-code IN BROWSE br-cash-pay-list do:
     3235   define variable old-frpay-code    AS integer no-undo .
     3236   if not avail temp-cash-pay-list then return no-apply.
     3237   ASSIGN
     3238   OLD-frpay-code = temp-cash-pay-list.frpay-code
     3239   .
     3240   IF NOT (INTEGER(temp-cash-pay-list.frpay-code) >= 2
     3241           OR
     3242           INTEGER(temp-cash-pay-list.frpay-code) <= 4
     3243           )
     3244           THEN DO:
     3245     MESSAGE
     3246     "Неверный код вида оплаты ФР"
     3247     VIEW-AS ALERT-BOX ERROR.
     3248     ASSIGN
     3249     temp-cash-pay-list.frpay-code = old-frpay-code
     3250     .
     3251     DISPLAY
     3252     temp-cash-pay-list.frpay-code
     3253     with BROWSE br-cash-pay-list.
     3254     RETURN NO-APPLY.
     3255   END.
     3256   ASSIGN
     3257   temp-cash-pay-list.frpay-code = INTEGER(temp-cash-pay-list.frpay-code:SCREEN-VALUE IN BROWSE br-cash-pay-list)
     3258   .
