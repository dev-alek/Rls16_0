     3598             f-advert-text3 f-com-port t-clear-cash-counter f-cash-drawer-limit
     3599             t-qnty-change t-cash-drawer-open f-cliche-lines1 f-cliche-lines2
     3600             t-customer-display-plug f-cliche-lines3 CB-customer-display-type
     3601             f-cliche-lines4 f-cliche-lines5 f-customer-display-port
     3602             f-cliche-lines6 f-customer-display-adv1 t-print-good-code
     3603             f-customer-display-adv2 f-max-netto l-rmethod CB-keyboard-type
     3604             rs-rmethod-type f-keyboard-layout-id f-nalc rs-rmethod-coeff
     3605             CB-cashless-system t-rcpt-ord-slip-print t-card-reader-plug
     3606             t-rcpt-ord-alt-print CB-cctv-system f-cctv-system-address f-main
     3607             F-devices f-fisreg f-rec-print f-interface l-log-level
     3608             f-screen-layout-name for-curr-name f-keyboard-layout-name
