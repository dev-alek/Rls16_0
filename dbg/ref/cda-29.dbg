     4210   br-pay-names
     4211   t-print-good-code WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     4212   f-advert-text1 WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     4213   f-advert-text2 WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     4214   f-advert-text3 WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     4215   f-cliche-lines1 WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     4216   f-cliche-lines2 WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     4217   f-cliche-lines3 WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     4218   f-cliche-lines4 WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     4219   b-add-cash-pay  WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     4220   b-del-cash-pay WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     4221   WITH FRAME Dialog-Frame.
     4222   VIEW FRAME Dialog-Frame.
     4223   IF p-mode = 'ПРОСМОТР':U THEN DO:
     4224       HIDE
     4225       b-exit
     4226       IN FRAME Dialog-Frame.
     4227       ASSIGN
     4228       b-quit:LABEL = "&Выход"
     4229       b-quit:COLUMN = 1
     4230       temp-cash-pay-list.frpay-code:read-only IN BROWSE br-cash-pay-list = YES
     4231       .
     4232   END.
     4233   HIDE
     4234   f-cliche-lines5
     4235   f-cliche-lines6
     4236   IN FRAME Dialog-Frame.
     4237   OPEN QUERY br-cash-pay-list FOR EACH temp-cash-pay-list.
     4238   OPEN QUERY br-pay-names FOR EACH temp-pay-names.
     4239   APPLY "CHOOSE" TO b-main.
     4240   END PROCEDURE.
     4241   PROCEDURE proc-init-devices :
     4242   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     4243   DO on error undo, return error return-value:
     4244    b-devices:LOAD-IMAGE-UP("adeicon\ts-up110":U)           in frame Dialog-Frame .
     4245    f-devices:fgcolor = 1   .
     4246    b-main:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     4247    b-fisreg:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     4248    b-rec-print:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     4249    b-interface:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     4250    ASSIGN
     4251    f-main:fgcolor = ?
     4252    f-fisreg:fgcolor = ?
     4253    f-rec-print:fgcolor = ?
     4254    f-interface:fgcolor = ?
     4255    .
     4256    FOR EACH temp-widget WHERE
     4257           temp-widget.SECTION_ = "2":
     4258      ASSIGN
     4259       temp-widget.HANDLE_:VISIBLE = YES.
     4260   END.
     4261   FOR EACH temp-widget WHERE
     4262           temp-widget.SECTION_ <> "2"
     4263       AND temp-widget.SECTION_ <> "":
     4264      ASSIGN
     4265       temp-widget.HANDLE_:VISIBLE = no.
     4266    END.
     4267    .
     4268    v-current-tab-order = v-tab-order[2].
     4269    APPLY "VALUE-CHANGED" TO t-cash-drawer-plug.
     4270    APPLY "VALUE-CHANGED" TO t-customer-display-plug.
     4271    APPLY "VALUE-CHANGED" TO cb-cctv-system.
     4272   end.
