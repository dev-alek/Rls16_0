     4198   b-keyboard-layout-id WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     4199   cb-cashless-system WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     4200   cb-cctv-system WHEN p-mode = 'ИЗМЕНЕНИЕ':U
