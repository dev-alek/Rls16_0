     3279       ) .
     3280   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3281   ON TAB ANYWHERE
     3282   DO:
     3283   define variable ii as integer no-undo .
     3284   define variable fh as widget-handle no-undo .
     3285   define variable hh as widget-handle no-undo .
     3286   define variable v-next-widget-name as character no-undo .
     3287   if v-current-tab-order <> '' then do:
     3288     if self:type = "TOGGLE-BOX" then
     3289     self:BGCOLOR = ?.
     3290     assign
     3291     ii = lookup(self:name, v-current-tab-order).
     3292     assign
     3293     ii = ii + 1
     3294     v-next-widget-name = entry(ii, v-current-tab-order)
     3295     no-error .
     3296     if error-status:error then do:
     3297       assign
     3298       ii = 1
     3299       v-next-widget-name = entry( ii, v-current-tab-order)
     3300       .
     3301     end.
     3302     assign
     3303     fh = frame Dialog-Frame:first-child
     3304     hh = fh:first-child
     3305     .
     3306     do while valid-handle(hh):
     3307       if hh:name = v-next-widget-name then do:
     3308         if hh:sensitive  = yes
     3309         AND hh:visible = yes then do:
     3310           if hh:type = "TOGGLE-BOX":U then do:
     3311             assign
     3312             hh:BGcolor = 1
     3313             .
     3314           end.
     3315           APPLY "ENTRY" to hh.
     3316           return no-apply.
     3317         end.
     3318         else do:
     3319           APPLY "TAB" to hh.
     3320           return no-apply.
     3321         end.
     3322       end.
     3323       hh = hh:next-sibling.
     3324     end.
     3325   end.
     3326   END.
     3327   ON BACK-TAB ANYWHERE
     3328   DO:
     3329   define variable ii as integer no-undo .
     3330   define variable fh as widget-handle no-undo .
     3331   define variable hh as widget-handle no-undo .
     3332   define variable v-next-widget-name as character no-undo .
     3333   if v-current-tab-order <> '' then do:
     3334     assign
     3335     ii = lookup(self:name, v-current-tab-order).
     3336     .
     3337     assign
     3338     ii = (if ii = 1
     3339           then  num-entries(v-current-tab-order)
     3340           else ii - 1
     3341           )
     3342     v-next-widget-name = entry(ii, v-current-tab-order)
     3343     .
     3344     assign
     3345     fh = frame Dialog-Frame:first-child
     3346     hh = fh:first-child
     3347     .
     3348     do while valid-handle(hh):
     3349       if hh:name = v-next-widget-name then do:
     3350         if hh:sensitive  = yes
     3351         AND hh:visible = yes then do:
     3352           if hh:type = "TOGGLE-BOX":U then do:
     3353             assign
     3354             hh:BGcolor = 1
     3355             .
     3356           end.
     3357           APPLY "ENTRY" to hh.
     3358           return no-apply.
     3359         end.
     3360         else do:
     3361         APPLY "BACK-TAB" to hh.
     3362         return no-apply.
     3363         end.
     3364       end.
     3365       hh = hh:next-sibling.
     3366     end.
     3367     end.
     3368   END.
     3369   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3370   ON RETURN ANYWHERE
     3371   DO:
     3372   define variable ii as integer no-undo .
     3373   define variable fh as widget-handle no-undo .
     3374   define variable hh as widget-handle no-undo .
     3375   define variable v-next-widget-name as character no-undo .
     3376     if v-current-tab-order <> '' then do:
     3377       assign
     3378       ii = lookup(self:name, v-current-tab-order).
     3379       if ii = num-entries(v-current-tab-order) then do:
     3380           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     3381           return no-apply.
     3382       end.
     3383       if self:type <> "BUTTON" and
     3384         self:type <> "EDITOR"  then do:
     3385         run proc-move-forward in this-procedure .
     3386         return no-apply.
     3387       end.
     3388       if self:type = "BUTTON" then do:
     3389         APPLY "CHOOSE" to self.
     3390       end.
     3391       if self:type = "TOGGLE-BOX" then
     3392       self:BGCOLOR = ?.
     3393       assign
     3394       ii = ii + 1
     3395       v-next-widget-name = entry(ii, v-current-tab-order)
     3396       no-error .
     3397       if error-status:error then do:
     3398         assign
     3399         ii = 1
     3400         v-next-widget-name = entry( ii, v-current-tab-order)
     3401         .
     3402       end.
     3403       assign
     3404       fh = frame Dialog-Frame:first-child
     3405       hh = fh:first-child
     3406       .
     3407       do while valid-handle(hh):
     3408         if hh:name = v-next-widget-name then do:
     3409           if hh:sensitive  = yes
     3410           AND hh:visible = yes then do:
     3411             if hh:type = "TOGGLE-BOX":U then do:
     3412               assign
     3413               hh:BGcolor = 1
     3414               .
     3415             end.
     3416             APPLY "ENTRY" to hh.
     3417             return no-apply.
     3418           end.
     3419           else do:
     3420             APPLY "TAB" to hh.
     3421             return no-apply.
     3422           end.
     3423         end.
     3424         hh = hh:next-sibling.
     3425       end.
     3426     end.
     3427   END.
     3428   procedure proc-move-forward :
     3429   define variable ii as integer no-undo .
     3430   define variable fh as widget-handle no-undo .
     3431   define variable hh as widget-handle no-undo .
     3432   define variable v-next-widget-name as character no-undo .
     3433   do
     3434   on error undo, return error
     3435   :
     3436     if v-current-tab-order <> '' then do:
     3437       if self:type = "TOGGLE-BOX" then
     3438       self:BGCOLOR = ?.
     3439       assign
     3440       ii = lookup(self:name, v-current-tab-order).
     3441       assign
     3442       ii = ii + 1
     3443       v-next-widget-name = entry(ii, v-current-tab-order)
     3444       no-error .
     3445       if error-status:error then do:
     3446         assign
     3447         ii = 1
     3448         v-next-widget-name = entry( ii, v-current-tab-order)
     3449         .
     3450       end.
     3451       assign
     3452       fh = frame Dialog-Frame:first-child
     3453       hh = fh:first-child
     3454       .
     3455       do while valid-handle(hh):
     3456         if hh:name = v-next-widget-name then do:
     3457           if hh:sensitive  = yes
     3458           AND hh:visible = yes then do:
     3459             if hh:type = "TOGGLE-BOX":U then do:
     3460               assign
     3461               hh:BGcolor = 1
     3462               .
     3463             end.
     3464             APPLY "ENTRY" to hh.
     3465             return.
     3466           end.
     3467           else do:
     3468             assign
     3469             ii = ii + 1
     3470             v-next-widget-name = entry(ii, v-current-tab-order)
     3471             no-error .
     3472             if error-status:error then do:
     3473               assign
     3474               ii = 1
     3475               v-next-widget-name = entry( ii, v-current-tab-order)
     3476               .
     3477             end.
     3478           end.
     3479         end.
     3480         hh = hh:next-sibling.
     3481       end.
     3482     end.
     3483   end.
     3484   end procedure.
     3485     IF p-mode <> 'ПРОСМОТР':U
     3486     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     3487         MESSAGE
     3488         vss-workfile vss-revision vss-description skip
     3489         "Неверное значение параметра p-mode" p-mode
     3490         VIEW-AS ALERT-BOX ERROR.
     3491         UNDO, RETURN ERROR.
     3492     END.
     3493     IF p-obj-type <> 'маг':U
     3494     THEN DO:
     3495         MESSAGE
     3496         vss-workfile vss-revision vss-description skip
     3497         "Неверное значение параметра p-obj-type" p-obj-type
     3498         VIEW-AS ALERT-BOX ERROR.
     3499         UNDO, RETURN ERROR.
     3500     END.
     3501     if p-obj-type = 'маг':U then do:
     3502       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     3503       IF NOT AVAILABLE X_shop THEN DO:
     3504           MESSAGE
     3505           vss-workfile vss-revision vss-description skip
     3506           "Неверное значение параметра p-obj-code" p-obj-code
     3507           VIEW-AS ALERT-BOX ERROR.
     3508           UNDO, RETURN ERROR.
     3509       END.
     3510   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3511   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3512     (input  'маг':U
     3513     ,input  p-obj-code
     3514     ,output v-db-num
     3515     )  .
     3516       IF v-db-num <> v-cntxt-db-num
     3517       AND v-cntxt-db-num <> 0
     3518       and p-mode <> 'ПРОСМОТР':U
     3519       THEN DO:
     3520           MESSAGE
     3521           "Нельзя менять параметры кассы в чужой БД" skip
     3522           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     3523           VIEW-AS ALERT-BOX ERROR.
     3524           UNDO, RETURN ERROR.
     3525       END.
     3526   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3527   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3528     (input  p-obj-type
     3529     ,input  p-obj-code
     3530     ,output v-host-code
     3531     )  .
