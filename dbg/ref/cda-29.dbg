     1371        f-screen-layout-name AT ROW 6 COL 55 COLON-ALIGNED NO-LABEL WIDGET-ID 170
     1372        for-curr-name AT ROW 17 COL 49 COLON-ALIGNED NO-LABEL WIDGET-ID 136
     1373        f-keyboard-layout-name AT ROW 17 COL 55 COLON-ALIGNED NO-LABEL WIDGET-ID 164
     1374        SPACE(13.39) SKIP(4.28)
     1375       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1376            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1377            TITLE "Настройки по умолчанию и опции работы POS IBS TH"
     1378            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1379   ASSIGN
     1380          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1381          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1382   ASSIGN
     1383          f-advert-text:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1384   ASSIGN
     1385          f-cliche-lines:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1386   ASSIGN
     1387          f-customer-display-adv:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1388   ASSIGN
     1389          f-rmethod-coeff:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1390   ASSIGN
     1391          v-rmethod-coeff:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1392   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1393   DO:
     1394     APPLY "END-ERROR":U TO SELF.
     1395   END.
     1396   ON CHOOSE OF b-add-cash-pay IN FRAME Dialog-Frame
     1397   DO:
     1398   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1399   DEFINE VARIABLE v-rid AS recid NO-UNDO.
     1400   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     1401   DEFINE BUFFER buf_temp-cash-pay-list FOR temp-cash-pay-list.
     1402     run ref/cashpays.w (
     1403                  input parparentproc
     1404                 ,input  "b-sel":U
     1405                 ,input 'все':U
     1406                 ,input (if p-obj-type = "" then 0 else v-host-code)
     1407                 ,input (if p-obj-type = '' then '':U else p-obj-type)
     1408                 ,input (if p-obj-type = '' then 0 else p-obj-code)
     1409                 ,OUTPUT v-rid-list) NO-ERROR.
     1410   IF ERROR-STATUS:ERROR OR v-rid-list = "":U  THEN RETURN no-apply.
     1411   FIND FIRST buf_cash-pay NO-LOCK WHERE
     1412           RECID(buf_cash-pay) = INTEGER(ENTRY(1, v-rid-list)) NO-ERROR.
     1413   IF NOT AVAILABLE buf_cash-pay  THEN RETURN NO-APPLY.
     1414   if buf_cash-pay.cdpay-code = 1 then do:
     1415     message
     1416     "Для платежа типа НАЛИЧНЫЕ (тип касс. платежа = 1) соответствие с типами оплат ФР определять НЕ НАДО!"
     1417     view-as alert-box error .
     1418     undo, return no-apply.
     1419   end.
     1420   FIND FIRST buf_temp-cash-pay-list WHERE
     1421               buf_temp-cash-pay-list.cdpay-code = buf_cash-pay.cdpay-code
     1422       AND     buf_temp-cash-pay-list.curr-code = buf_cash-pay.curr-code NO-ERROR.
     1423   IF AVAILABLE buf_temp-cash-pay-list THEN DO:
     1424       MESSAGE
     1425       SUBSTITUTE("Вы уже добавили соответствие между типом кассового платежа в IBS TH с кодом &1 и валютой &2"
     1426                 , buf_cash-pay.cdpay-code
     1427                 , buf_cash-pay.curr-code)
     1428       VIEW-AS ALERT-BOX ERROR.
     1429       RETURN NO-APPLY.
     1430   END.
     1431   CREATE buf_temp-cash-pay-list.
     1432   ASSIGN
     1433   buf_temp-cash-pay-list.cdpay-code = buf_cash-pay.cdpay-code
     1434   buf_temp-cash-pay-list.curr-code = buf_cash-pay.curr-code
     1435   buf_temp-cash-pay-list.frpay-code = 0
     1436   .
     1437   v-rid = RECID(buf_temp-cash-pay-list).
     1438   OPEN QUERY br-cash-pay-list FOR EACH temp-cash-pay-list.
     1439   REPOSITION br-cash-pay-list TO RECID v-rid NO-ERROR.
     1440   APPLY "ENTRY" TO br-cash-pay-list.
     1441   END.
     1442   ON CHOOSE OF b-curr IN FRAME Dialog-Frame
     1443   DO:
     1444       define variable rr as recid no-undo.
     1445       DEFINE BUFFER buf_currency FOR ub.currency.
     1446       rr = ? .
     1447       run ref/currency.w (
     1448                       input parparentproc
     1449                     , input "b-sel"
     1450                     , input-output rr ).
     1451       if rr <> ? then do:
     1452         FIND FIRST buf_currency WHERE
     1453                   recid( buf_currency ) = rr NO-LOCK .
     1454         DISPLAY
     1455         buf_currency.curr-code @ f-nalc
     1456         buf_currency.curr-abbr @ for-curr-name
     1457         with frame Dialog-Frame .
     1458       end.
     1459   END.
     1460   ON CHOOSE OF b-del-cash-pay IN FRAME Dialog-Frame
     1461   DO:
     1462   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     1463   MESSAGE
     1464   "Вы действительно хотите удалить это соответствие?"
     1465    VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     1466    IF NOT glog  THEN RETURN NO-APPLY.
     1467     IF NOT AVAILABLE temp-cash-pay-list THEN RETURN NO-APPLY.
     1468     DELETE temp-cash-pay-list.
     1469     OPEN QUERY br-cash-pay-list FOR EACH temp-cash-pay-list.
     1470     REPOSITION br-cash-pay-list TO ROW 1.
     1471   END.
     1472   ON CHOOSE OF B-devices IN FRAME Dialog-Frame
     1473   DO:
     1474   run proc-init-devices in this-procedure .
     1475   END.
     1476   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1477   DO:
     1478     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     1479     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1480     p-setted = yes.
     1481   END.
     1482   ON CHOOSE OF b-fisreg IN FRAME Dialog-Frame
     1483   DO:
     1484   run proc-init-fisreg in this-procedure .
     1485   END.
     1486   ON CHOOSE OF b-interface IN FRAME Dialog-Frame
     1487   DO:
     1488   run proc-init-interface in this-procedure .
     1489   END.
     1490   ON CHOOSE OF b-keyboard-layout-id IN FRAME Dialog-Frame
     1491   DO:
     1492       DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1493     DEFINE BUFFER buf_layout FOR ub.layout.
     1494     IF f-keyboard-layout-id <> '' THEN DO:
     1495         FIND FIRST buf_layout NO-LOCK WHERE
     1496                   buf_layout.layout-id = f-keyboard-layout-id NO-ERROR.
     1497     END.
     1498         run adm/layoutss.w (
     1499                              INPUT parparentproc
     1500                            ,input "b-sel"
     1501                            ,INPUT "layout-type"
     1502                             ,INPUT 'th-pos-keyboard':U
     1503                             ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     1504       IF v-rid-list <> ''
     1505       AND v-rid-list <> STRING(RECID(buf_layout)) THEN DO:
     1506         FIND FIRST buf_layout NO-LOCK WHERE
     1507                   recid(buf_layout) = INTEGER(v-rid-list) NO-ERROR.
     1508         IF NOT AVAILABLE buf_layout THEN DO:
     1509             ASSIGN
     1510             f-keyboard-layout-id = ''
     1511             f-keyboard-layout-name = ?
     1512             .
     1513         END.
     1514         ELSE DO:
     1515             ASSIGN
     1516             f-keyboard-layout-id = buf_layout.layout-id
     1517             f-keyboard-layout-name = buf_layout.layout-name
     1518             .
     1519         END.
     1520         DISPLAY
     1521         f-keyboard-layout-id
     1522         f-keyboard-layout-name
     1523         WITH FRAME Dialog-Frame.
     1524       END.
     1525   END.
     1526   ON CHOOSE OF B-main IN FRAME Dialog-Frame
     1527   DO:
     1528      run proc-init-main in this-procedure .
     1529   END.
     1530   ON CHOOSE OF b-rec-print IN FRAME Dialog-Frame
     1531   DO:
     1532   run proc-init-rec-print in this-procedure .
     1533   END.
     1534   ON CHOOSE OF b-screen-layout-id IN FRAME Dialog-Frame
     1535   DO:
     1536     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1537     DEFINE BUFFER buf_layout FOR ub.layout.
     1538     IF f-screen-layout-id <> '' THEN DO:
     1539         FIND FIRST buf_layout NO-LOCK WHERE
     1540                   buf_layout.layout-id = f-screen-layout-id NO-ERROR.
     1541     END.
     1542         run adm/layoutss.w (
     1543                              INPUT parparentproc
     1544                            ,input "b-sel"
     1545                            ,INPUT "layout-type"
     1546                             ,INPUT 'th-pos-screen':U
     1547                             ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     1548       IF v-rid-list <> ''
     1549       AND v-rid-list <> STRING(RECID(buf_layout)) THEN DO:
     1550         FIND FIRST buf_layout NO-LOCK WHERE
     1551                   recid(buf_layout) = INTEGER(v-rid-list) NO-ERROR.
     1552         IF NOT AVAILABLE buf_layout THEN DO:
     1553             ASSIGN
     1554             f-screen-layout-id = ''
     1555             f-screen-layout-name = ?
     1556             .
     1557         END.
     1558         ELSE DO:
     1559             ASSIGN
     1560             f-screen-layout-id = buf_layout.layout-id
     1561             f-screen-layout-name = buf_layout.layout-name
     1562             .
     1563         END.
     1564         DISPLAY
     1565         f-screen-layout-id
     1566         f-screen-layout-name
     1567         WITH FRAME Dialog-Frame.
     1568     END.
     1569   END.
     1570   ON VALUE-CHANGED OF CB-cashless-system IN FRAME Dialog-Frame
     1571   DO:
     1572     ASSIGN
     1573     cb-cashless-system.
     1574   END.
     1575   ON VALUE-CHANGED OF CB-cctv-system IN FRAME Dialog-Frame
     1576   DO:
     1577     ASSIGN
     1578     cb-cctv-system.
     1579     case cb-cctv-system:
     1580       when '' then do:
     1581         f-cctv-system-address = ''.
     1582         display
     1583         f-cctv-system-address
     1584         with frame Dialog-Frame .
     1585         disable
     1586         f-cctv-system-address
     1587         with frame Dialog-Frame .
     1588       end.
     1589       otherwise do:
     1590         if p-mode <> 'ПРОСМОТР':U then do:
     1591           enable
     1592           f-cctv-system-address
     1593           with frame Dialog-Frame .
     1594         end.
     1595       end.
     1596     end case.
     1597   END.
     1598   ON VALUE-CHANGED OF CB-keyboard-type IN FRAME Dialog-Frame
     1599   DO:
     1600     ASSIGN
     1601     cb-keyboard-type.
     1602     CASE cb-keyboard-type:
     1603         WHEN '' THEN DO:
     1604           ASSIGN
     1605           f-keyboard-layout-id = ''
     1606           f-keyboard-layout-name = ''
     1607           .
     1608           DISPLAY
     1609           f-keyboard-layout-id
     1610           f-keyboard-layout-name
     1611           WITH FRAME Dialog-Frame.
     1612           DISABLE
     1613           b-keyboard-layout-id
     1614           WITH FRAME Dialog-Frame.
     1615         END.
     1616         OTHERWISE DO:
     1617             Enable
     1618             b-keyboard-layout-id
     1619             WITH FRAME Dialog-Frame.
     1620            APPLY "CHOOSE" TO b-keyboard-layout-id .
     1621         END.
     1622     END CASE.
     1623   END.
     1624   ON VALUE-CHANGED OF CB-screen-type IN FRAME Dialog-Frame
     1625   DO:
     1626       ASSIGN
     1627     cb-screen-type.
     1628     APPLY "CHOOSE" TO b-screen-layout-id .
     1629   END.
     1630   ON LEAVE OF f-advert-text1 IN FRAME Dialog-Frame
