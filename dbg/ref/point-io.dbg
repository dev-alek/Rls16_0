      601   define new shared variable PrintRubl          as logical   no-undo .
      602   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      603   define  stream PrnLibStream.
      604   procedure prn-lib-prn-file :
      605     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      606     define input parameter p-DIsabledoptions as integer no-undo .
      607     define variable v-report-name as character no-undo .
      608     define variable v-user-action as character no-undo .
      609     define variable v-printed     as logical   no-undo .
      610     define variable v-exist       as logical   no-undo .
      611     do
      612       on error undo, return error
      613       :
      614       run prn-lib-get-report-name  in this-procedure (
      615         input parParentProc
      616         ,output v-report-name
      617         ).
      618   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      619   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      620     (input  v-report-name
      621     ,input  2
      622     ,output v-exist
      623     )  .
      624       if NOT v-exist then
      625       DO:
      626         Message
      627           "Нет заданий на печать ! "
      628           view-as alert-box .
      629         Return  .
      630       End.
      631       run gbl/prnfilen.w
      632         (input  ""
      633         ,input  p-DisabledOptions
      634         ,input  string(v-report-name )
      635         ,input  7
      636         ,output v-user-action
      637         ,output v-printed
      638         ) .
      639       if v-printed then
      640       do:
      641         return "YES" .
      642       end.
      643       else
      644       do:
      645         return "NO" .
      646       end.
      647     end.
      648   end procedure.
      649   procedure prn-lib-open-stream :
      650     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      651     define input parameter p-page-size    as integer no-undo .
      652     define input parameter p-is-stream    as logical no-undo .
      653     define input parameter p-append       as logical no-undo .
      654     define variable v-report-name as character no-undo .
      655     do
      656       on error undo, return error
      657       :
      658       run prn-lib-get-report-name  in this-procedure (
      659         input parParentProc
      660         ,output v-report-name
      661         ).
      662       if p-is-stream then
      663       do:
      664         if p-append then
      665         do:
      666           output stream PrnLibStream to value( v-report-name )
      667             page-size value(p-page-size) append .
      668         end.
      669         if not p-append then
      670         do:
      671           output stream PrnLibStream to value( v-report-name )
      672             page-size value(p-page-size) .
      673         end.
      674       end.
      675       if not p-is-stream then
      676       do:
      677         if p-append then
      678         do:
      679           output to value( v-report-name )
      680             page-size value(p-page-size) append .
      681         end.
      682         if not p-append then
      683         do:
      684           output to value( v-report-name )
      685             page-size value(p-page-size) .
      686         end.
      687       end.
      688     end.
      689   end procedure.
      690   procedure prn-lib-open-exp :
      691     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      692     define input parameter p-is-stream    as logical no-undo .
      693     define input parameter p-is-append    as logical no-undo .
      694     define output parameter p-ReportFileName as char init "report" no-undo.
      695     define output parameter p-process as logical no-undo .
      696     define variable glog as logical no-undo .
      697     do
      698       on error undo, return error
      699       :
      700       SYSTEM-DIALOG GET-FILE p-ReportFileName
      701         TITLE      "Укажите путь"
      702         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      703         ASK-OVERWRITE
      704         CREATE-TEST-FILE
      705         SAVE-AS
      706         USE-FILENAME
      707         DEFAULT-EXTENSION "txt"
      708         UPDATE glog
      709         .
      710       if not glog then  return.
      711       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      712       if p-is-stream then
      713       do:
      714         if p-is-append then
      715         do:
      716           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      717         end.
      718         else
      719         do:
      720           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      721         end.
      722       end.
      723       else
      724       do:
      725         if p-is-append then
      726         do:
      727           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      728         end.
      729         else
      730         do:
      731           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      732         end.
      733       end.
      734       p-process = yes.
      735     end.
      736   end procedure.
      737   procedure prn-lib-get-report-name :
      738     define input parameter parParentProc  as widget-handle no-undo.
      739     define output parameter p-report-name as character no-undo .
      740     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      741   end procedure.
      742   procedure prn-lib-reportviewer-report-name :
      743     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      744     define input parameter p-report-name-html as character no-undo .
      745     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      746   end procedure.
      747   procedure prn-lib-reportviewer :
      748     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      749     define input parameter p-report-name-html as character no-undo .
      750     define input parameter p-param        as character no-undo .
      751     define variable v-excel           as character no-undo init 'TRUE' .
      752     define variable v-value-character as character no-undo .
      753     define variable v-value-integer   as character no-undo .
      754     define variable v-value-date      as date      no-undo .
      755     define variable v-value-decimal   as decimal   no-undo .
      756     define variable rep-excel         as logical   no-undo .
      757     define variable excel-string      as character no-undo .
      758     define variable v-param-type      as character no-undo .
      759     define variable v-tth             as handle    no-undo .
      760     run adm/shattri.p (
      761       input "get":U
      762       ,input  ""
      763       ,input  0
      764       ,input  'report-glob':U
      765       ,input  'rep-excel':U
      766       ,output v-value-character
      767       ,output v-value-date
      768       ,output v-value-decimal
      769       ,output v-value-integer
      770       ,output rep-excel
      771       ,output v-param-type
      772       ,INPUT-OUTPUT table-handle v-tth
      773       )  .
      774     if rep-excel then v-excel = "TRUE" .
      775     else v-excel = "FALSE" .
      776     if p-param eq ""
      777     then
      778        p-param = "EXCEL:" + v-excel.
      779     else
      780        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      781     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      782   end procedure.
      783   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      784   procedure cur-time :
      785      define output parameter p-today as date      no-undo .
      786      define output parameter p-time  as integer   no-undo .
      787     do
      788     on error undo, return error
      789     :
      790       define variable v-date1 as date      no-undo .
      791       define variable v-date2 as date      no-undo .
      792       define variable v-time  as integer   no-undo .
      793       assign
      794         v-date1 = today
      795         v-time  = time
      796         v-date2 = today
      797       .
      798       if v-date1 <> v-date2
      799       then do:
      800         assign
      801           v-date1 = today
      802           v-time  = v-time
      803         .
      804       end.
      805       assign
      806         p-today = v-date1
      807         p-time  = v-time
      808       .
      809     end.
      810   end.
      811   function cur-time-date returns character
      812   :
      813     return string(today, '99/99/9999':U) .
      814   end.
      815   function cur-time-mjd returns decimal
      816   :
      817     define variable v-date as date      no-undo .
      818     define variable v-time as integer   no-undo .
      819     run cur-time in this-procedure
      820       (output v-date
      821       ,output v-time
      822       ) .
      823     return integer(v-date) - 2400002 + (v-time / 86400) .
      824   end.
      825   function cur-time-get-ending-index returns integer
      826   (input p-number as integer
      827   )
      828   :
      829     if p-number < 0
      830     or p-number = ?
      831     then do:
      832       return 1 .
      833     end.
      834     define variable v-rest as integer   no-undo .
      835     assign
      836       p-number = p-number modulo 100
      837     .
      838     if p-number < 20
      839     then do:
      840       assign
      841         v-rest = p-number
      842       .
      843     end.
      844     else do:
      845       assign
      846         v-rest = p-number modulo 10
      847       .
      848     end.
      849     case v-rest :
      850       when 1
      851       then do:
      852         return 2 .
      853       end.
      854       when 2 or
      855       when 3 or
      856       when 4
      857       then do:
      858         return 3 .
      859       end.
      860       otherwise do:
      861         return 1 .
      862       end.
      863     end case .
      864   end.
      865   procedure cur-time-mjd-to-date :
      866      define input  parameter i-mjd-diff as decimal no-undo.
      867      define output parameter o-Date     as date    no-undo.
      868      define output parameter o-Time     as integer no-undo.
      869      define variable v-day-number as integer   no-undo .
      870      if    i-mjd-diff < 0
      871         or i-mjd-diff = ?
      872      then do:
      873         return "?" .
      874      end.
      875      assign
      876         v-day-number = truncate(i-mjd-diff,0).
      877         o-Date = date(v-day-number + 2400002).
      878         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      879     .
      880   end.
      881   function cur-time-mjd-to-string returns character
      882   (input p-mjd-diff as decimal
      883   )
      884   :
      885     define variable v-day-number as integer   no-undo .
      886     define variable v-seconds    as integer   no-undo .
      887     define variable v-hour       as integer   no-undo .
      888     define variable v-min        as integer   no-undo .
      889     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      890     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      891     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      892     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      893     if p-mjd-diff < 0
      894     or p-mjd-diff = ?
      895     then do:
      896       return "?" .
      897     end.
      898     assign
      899       v-day-number = integer(truncate(p-mjd-diff,0))
      900       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      901     .
      902     if v-seconds > 86400
      903     then do:
      904       assign
      905         v-seconds = 86400 - 1
      906       .
      907     end.
      908     if v-seconds < 0
      909     then do:
      910       assign
      911         v-seconds = 0
      912       .
      913     end.
      914     assign
      915       v-hour = truncate(v-seconds / 3600, 0)
      916     .
      917     assign
      918       v-seconds = v-seconds modulo 3600
      919     .
      920     assign
      921       v-min = truncate(v-seconds / 60, 0)
      922     .
      923     assign
      924       v-seconds = v-seconds modulo 60
      925     .
      926     return
      927         (if v-day-number <> 0
      928           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      929           else ""
      930         )
      931       + (if v-day-number <> 0 or v-hour <> 0
      932           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      933           else ""
      934         )
      935       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      936           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      937           else ""
      938         )
      939       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      940       .
      941   end.
      942   function cur-time-string returns character
      943   :
      944     define variable v-date as date      no-undo .
      945     define variable v-time as integer   no-undo .
      946     run cur-time in this-procedure
      947       (output v-date
      948       ,output v-time
      949       ) .
      950     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      951   end.
      952   function cur-time-string-sec returns character
      953   :
      954     define variable v-date as date      no-undo .
      955     define variable v-time as integer   no-undo .
      956     run cur-time in this-procedure
      957       (output v-date
      958       ,output v-time
      959       ) .
      960     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      961   end.
      962   function cur-time-custom  returns character
      963   (input p-prefix as character
      964   ,input p-date-format as character
      965   ,input p-delimiter as character
      966   ,input p-time-format as character
      967   ,input p-suffix as character
      968   )
      969   :
      970     define variable v-date as date      no-undo .
      971     define variable v-time as integer   no-undo .
      972     run cur-time in this-procedure
      973       (output v-date
      974       ,output v-time
      975       ) .
      976     return
      977       p-prefix
      978       + string(v-date, p-date-format)
      979       + p-delimiter
      980       + string(v-time, p-time-format)
      981       + p-suffix
      982       .
      983   end.
      984   function cur-time-print  returns character
      985   :
      986     define variable v-date as date      no-undo .
      987     define variable v-time as integer   no-undo .
      988     run cur-time in this-procedure
      989       (output v-date
      990       ,output v-time
      991       ) .
      992     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      993   end.
      994   function cur-time-datetime returns datetime
      995   :
      996     define variable v-char as character no-undo .
      997     define variable v-datetime as datetime no-undo .
      998     v-char = cur-time-string().
      999     v-datetime = datetime(v-char).
     1000     return  v-datetime.
     1001   end.
     1002   function cur-time-string-msec returns character
     1003   :
     1004     define variable v-date as datetime  no-undo .
     1005     v-date = now.
     1006     return string(v-date) .
     1007   end.
