      121   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122   define variable c-point  as character no-undo .
      123   define variable tbl      as character no-undo .
      124   define variable join-tbl as character no-undo .
      125   define variable fld      as character no-undo .
      126   define variable lab      as character no-undo .
      127   define variable spr      as character no-undo .
      128   define variable dim      as character no-undo .
      129   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   procedure fltfield-clear :
      131     define output parameter loc-fld as character no-undo.
      132     define output parameter loc-lab as character no-undo .
      133     define output parameter loc-spr as character no-undo .
      134     define output parameter loc-dim as character no-undo .
      135     assign
      136       loc-fld = ""
      137       loc-lab = ""
      138       loc-spr = ""
      139       loc-dim = "0"
      140     .
      141   end procedure .
      142   procedure fltfield-add :
      143     define input        parameter par-fld as character no-undo.
      144     define input        parameter par-lab as character no-undo .
      145     define input        parameter par-spr as character no-undo .
      146     define input-output parameter loc-fld as character no-undo.
      147     define input-output parameter loc-lab as character no-undo .
      148     define input-output parameter loc-spr as character no-undo .
      149     define input-output parameter loc-dim as character no-undo .
      150     do
      151     on error undo, return error
      152     :
      153       assign
      154       loc-fld = if loc-dim = '0'
      155                 then par-fld
      156                 else (loc-fld + chr(44) + par-fld)
      157       loc-lab = if loc-dim = '0'
      158                 then par-lab
      159                 else (loc-lab + chr(44) + par-lab)
      160       loc-spr = if loc-dim = '0'
      161                 then par-spr
      162                 else (loc-spr + chr(44) + par-spr)
      163       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      164                 string(integer(if num-entries(loc-dim) > 1
      165                               then entry(2, loc-dim)
      166                               else entry(1, loc-dim)
      167                               ) + 1)
      168       no-error
      169       .
      170     end.
      171   end procedure.
      172   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      173   define variable v-waitfram-action01         as character   no-undo .
      174   define variable v-waitfram-action02         as character   no-undo .
      175   define variable v-waitfram-action03         as character   no-undo .
      176   define variable mWaitFramTextBeg            as character   no-undo.
      177   define variable mWaitFramTextEnd            as character   no-undo.
      178   define variable mWaitFramView               as logical     no-undo.
      179   define variable mWaitProcEvent              as logical     no-undo init yes.
      180   define variable mWaitFramInterval           as integer     no-undo init 1 .
      181   define variable mWaitFramStop               as logical     no-undo.
      182   define variable mWaitFramStopUser           as logical     no-undo.
      183   define variable mWaitFramStopTimeOut        as logical     no-undo.
      184   define variable mWaitFramStartProc          as datetime-tz no-undo.
      185   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      186   define button B-WaitFramStop auto-end-key
      187        label "Стоп"
      188        size 10 by 1 tooltip "Остоновить процесс".
      189   define button B-viewProcInfo
      190        label "Информация"
      191        size 15 by 1 tooltip "Информация о процесс".
      192   define frame waitfram
      193     v-waitfram-action01 format "x(72)" no-label skip
      194     v-waitfram-action02 format "x(72)" no-label skip
      195     v-waitfram-action03 format "x(72)" no-label skip
      196     B-viewProcInfo
      197     B-WaitFramStop at row 4 col 30
      198     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      199     .
      200   define new global shared variable mBatchMode as logical no-undo init ?.
      201   define variable mFramBachModHandle as handle no-undo.
      202   mFramBachModHandle = frame waitfram:handle.
      203   define variable mFameOldVis as logical no-undo.
      204   define variable mVisCUrentVin as logical no-undo.
      205   if session:batch-mode
      206   then
      207      mBatchMode = yes.
      208   if mBatchMode = ? then do:
      209     mVisCUrentVin = current-window:visible.
      210     mFameOldVis = mFramBachModHandle:visible.
      211     mFramBachModHandle:visible  = yes.
      212     mBatchMode = mFramBachModHandle:visible ne yes.
      213     mFramBachModHandle:visible = mFameOldVis.
      214     current-window:visible = mVisCUrentVin.
      215   end.
      216    if  log-manager:logfile-name ne ?
      217     then DO:
      218         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      219         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      220         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      221     end.
      222   on choose of B-WaitFramStop in frame waitfram
      223   do:
      224     mWaitFramStop = yes.
      225     mWaitFramStopUser = yes.
      226   end.
      227   function waitfram-check-timeout returns logical():
      228      define variable vtime as int64 no-undo.
      229      if mWaitFramStopTimeOut
      230      then
      231         return yes.
      232      vtime = ( now - mWaitFramStartProc ) / 1000 .
      233      if     mWaitFramTimeOut ne ?
      234         and mWaitFramTimeOut ne 0
      235         and mWaitFramTimeOut lt vtime
      236      then do:
      237         mWaitFramStopTimeOut = yes.
      238      end.
      239      return mWaitFramStopTimeOut.
      240   end.
      241   procedure waitfram-hide :
      242     if not session:batch-mode
      243     then do
      244     on error undo, return error return-value
      245     :
      246       pause 0 before-hide .
      247       if not mBatchMode then
      248         hide frame waitfram .
      249     if     not mWaitFramView
      250        and mWaitProcEvent
      251     then
      252       process events .
      253     end.
      254   end procedure.
      255   procedure waitfram-show :
      256     define input  parameter p-message as character no-undo .
      257     define variable v-left-margin as integer   no-undo .
      258     if not session:batch-mode
      259     then do
      260     on error undo, return error return-value
      261     :
      262       if length(p-message) <= 70 then do:
      263         assign
      264           v-left-margin = integer((70 - length(p-message)) / 2)
      265         .
      266         assign
      267           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      268         .
      269         assign
      270           v-waitfram-action01 = " "
      271           v-waitfram-action02 = " "
      272                                    + fill(" ", v-left-margin)
      273                                    + p-message
      274           v-waitfram-action03 = " "
      275         .
      276       end.
      277       else do:
      278         define variable vRindex1 as integer no-undo.
      279         define variable vRindex2 as integer no-undo.
      280         vRindex1 = r-index(p-message," ",70).
      281         if vRindex1 = 0
      282         then
      283            vRindex1 = 70.
      284         if length(p-message)  <= vRindex1 + 70 then do:
      285           assign
      286             v-waitfram-action01 = " "
      287             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      288             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      289           .
      290         end.
      291         else do:
      292           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      293           if vRindex2 <= vRindex1
      294           then
      295              vRindex2 = vRindex1 + 70.
      296           assign
      297             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      298             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      299             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      300           .
      301         end.
      302       end.
      303       B-viewProcInfo:visible   in frame waitfram = no.
      304       B-viewProcInfo:sensitive in frame waitfram = no.
      305       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      306       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      307       if  (   mWaitFramView
      308          or  mWaitProcEvent)
      309          and not mBatchMode
      310       then
      311          display
      312             v-waitfram-action01 skip
      313             v-waitfram-action02 skip
      314             v-waitfram-action03 skip
      315          with frame waitfram .
      316       if     mWaitFramView
      317          then do:
      318             if     mWaitFramInterval ne ?
      319                and not mBatchMode
      320             then
      321                wait-for go of frame waitfram pause mWaitFramInterval.
      322          end.
      323          else
      324             if     mWaitProcEvent
      325                and not mBatchMode
      326             then
      327                process events .
      328     end.
      329   end procedure.
      330      procedure waitfram-show-this:
      331         define input  parameter iInterval as int64 no-undo.
      332         define variable vtime as int64 no-undo.
      333         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      334         mWaitFramInterval = iInterval.
      335         run waitfram-show (substitute("&1&2 &3&4" ,
      336                                       mWaitFramTextBeg ,
      337                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      338                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      339                                       mWaitFramTextEnd
      340                                      )
      341                           ).
      342      end.
      343      procedure WaitFramRunPause:
      344         define input  parameter iInterval as dec no-undo.
      345         define variable vStart  as datetime-tz no-undo.
      346         define variable vend    as datetime-tz no-undo.
      347         define variable vint as int64 no-undo.
      348         define variable vOk as logical no-undo.
      349         vStart = now.
      350         vend   = vStart.
      351         publish "WaitFramPause" (iInterval,output vOk).
      352         vend   =  now.
      353         vint = vend - vStart.
      354         vint = iInterval - vint / 1000.
      355         if     not mWaitFramStop
      356            and (   vint > 0
      357                 or (    not vOk
      358                     and iInterval eq ?
      359                     )
      360                 )
      361         then
      362            run waitfram-show-this (iInterval).
      363         vend   =  now.
      364         vint = vend - vStart.
      365         vint = iInterval - vint / 1000.
      366         if     not mWaitFramStop
      367            and vint > 0
      368         then do:
      369            run gbl/pause.p (vint * 1000).
      370         end.
      371         if iInterval ne ?
      372         then
      373            publish "WaitFramStop".
      374         waitfram-check-timeout().
      375      end.
      376      procedure WaitFramWaitFor:
      377         define input  parameter iInterval as dec no-undo.
      378         assign
      379            mWaitFramStartProc   = now
      380            mWaitFramStopUser    = no
      381            mWaitFramStopTimeOut = no
      382         .
      383         block-wait:
      384         do while not mWaitFramStop:
      385            run WaitFramRunPause (iInterval).
      386            if  waitfram-check-timeout()
      387            then do:
      388               leave block-wait.
      389            end.
      390         end.
      391         run waitfram-hide.
      392      end.
      393   procedure waitfram-join :
      394     define input  parameter p-line-1  as character no-undo .
      395     define input  parameter p-line-2  as character no-undo .
      396     define input  parameter p-line-3  as character no-undo .
      397     define output parameter p-message as character no-undo .
      398     do
      399     on error undo, return error return-value
      400     :
      401       assign
      402         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      403                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      404                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      405       .
      406     end.
      407   end procedure.
      408   function waitfram-join-function returns character
      409     (input p-line-1 as character
      410     ,input p-line-2 as character
      411     ,input p-line-3 as character
      412     ).
      413     define variable v-message as character no-undo .
      414     run waitfram-join in this-procedure
      415       (input  p-line-1
      416       ,input  p-line-2
      417       ,input  p-line-3
      418       ,output v-message
      419       ) .
      420     return v-message .
      421   end function .
      422   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      423     define variable v-cntxt-db-num        as integer   no-undo .
      424     define variable v-cntxt-userid        as character no-undo .
      425     define variable v-cntxt-level         as character no-undo .
      426     define variable v-cntxt-host-code-obj as integer   no-undo .
      427     define variable v-cntxt-obj-type      as character no-undo .
      428     define variable v-cntxt-obj-code      as integer   no-undo .
      429     define variable v-cntxt-db-num-obj    as integer   no-undo .
      430     define variable v-cntxt-is-admin      as logical   no-undo .
      431   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      432   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      433   procedure fltopend_fltopend :
      434   define input parameter p-parent-handle as handle no-undo .
      435   define input parameter p-qh as handle no-undo .
      436   define input parameter p-flt-open-open-query  as character no-undo .
      437   define input parameter p-where-cond as character no-undo .
      438   define input parameter p-use-indFIRST-query-tail as character no-undo .
      439   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      440   define input parameter p-indexed-reposition as character no-undo .
      441     do
      442     on error undo, return error
      443     :
      444   define variable v-prepare-string as character no-undo .
      445   define variable glog as logical no-undo .
      446   assign
      447   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      448                      p-where-cond + chr(32)  +
      449                      p-use-indFIRST-query-tail + chr(32) +
      450                      p-use-ind-sort-clmn-by + chr(32) +
      451                      p-indexed-reposition
      452   .
      453   assign
      454   glog = p-qh:query-prepare(v-prepare-string) no-error .
      455   if not glog
      456   or error-status:error then do:
      457     message error-status:get-message(1) view-as alert-box .
      458     undo, return error .
      459   end.
      460   assign
      461   glog = p-qh:query-open no-error .
      462   if not glog
      463   or error-status:error then do:
      464     message error-status:get-message(1) view-as alert-box .
      465     undo, return error .
      466   end.
      467     end.
      468   end procedure.
      469   procedure fltopend_fltfindd :
      470   define input parameter p-parent-handle as handle no-undo .
      471   define input parameter p-qh as handle no-undo .
      472   define input parameter p-rowid as rowid no-undo .
      473   define input parameter p-next as logical no-undo .
      474   define input parameter p-lock as integer no-undo .
      475   define input parameter p-bh as handle no-undo .
      476   define input parameter p-where-cond as character no-undo .
      477   define input parameter p-use-index-phrase as character no-undo .
      478   define variable glog as logical no-undo .
      479   define variable v-qh as handle no-undo .
      480   define variable v-bh as handle no-undo .
      481   define variable v-recid as recid no-undo .
      482   define variable v-prepare-string as character no-undo .
      483   do
      484   on error undo, return error
      485   on stop undo, return error
      486   :
      487     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      488     create buffer v-bh for table p-bh buffer-name p-bh:name.
      489     create query v-qh.
      490     v-qh:set-buffers(v-bh).
      491     v-prepare-string = substitute("for each &1 &2 &3"
      492                                     ,v-bh:name
      493                                     ,p-where-cond
      494                                     ,p-use-index-phrase).
      495     glog = v-qh:query-prepare(v-prepare-string) no-error.
      496     if not glog then do:
      497       delete object v-qh.
      498       delete object v-bh.
      499       undo, return error .
      500     end.
      501     glog = v-qh:query-open no-error .
      502     if not glog then do:
      503       delete object v-qh.
      504       delete object v-bh.
      505       undo, return error .
      506     end.
      507     if p-next then do:
      508       v-qh:reposition-to-rowid(p-rowid) no-error .
      509       glog = v-qh:get-next( p-lock) no-error .
      510       glog = v-qh:get-next( p-lock) no-error .
      511       if not glog or v-qh:query-off-end = yes then do:
      512         glog = v-qh:get-first( p-lock) no-error .
      513       end.
      514     end.
      515     else do:
      516       glog = v-qh:get-first( p-lock) no-error .
      517     end.
      518     v-recid = v-bh:recid no-error .
      519     delete object v-qh.
      520     delete object v-bh.
      521     return string(v-recid) .
      522   end.
      523   end procedure.
      524   procedure fltopend_fltfindq :
      525   define input parameter p-parent-handle as handle no-undo .
      526   define input parameter p-qh as handle no-undo .
      527   define input parameter p-next as logical no-undo .
      528   define input parameter p-lock as integer no-undo .
      529   define input parameter p-flt-open-open-query  as character no-undo .
      530   define input parameter p-where-cond as character no-undo .
      531   define input parameter p-use-indFIRST-query-tail as character no-undo .
      532   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      533   define input parameter p-indexed-reposition as character no-undo .
      534   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      535   define variable glog as logical no-undo .
      536   define variable v-qh as handle no-undo .
      537   define variable v-bh as handle no-undo extent 18.
      538   define variable v-rowid as rowid no-undo extent 18.
      539   define variable v-ii as integer no-undo .
      540   define variable v-prepare-string as character no-undo .
      541   do
      542   on error undo, return error
      543   on stop undo, return error
      544   :
      545     create query v-qh.
      546     do v-ii = 1 to p-qh:num-buffers:
      547       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      548       assign
      549       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      550       no-error.
      551       v-qh:add-buffer(v-bh[v-ii]).
      552     end.
      553     assign
      554     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      555                       p-where-cond + chr(32)  +
      556                       p-use-indFIRST-query-tail + chr(32) +
      557                       p-use-ind-sort-clmn-by + chr(32) +
      558                       p-indexed-reposition
      559     .
      560     glog = v-qh:query-prepare( v-prepare-string) no-error .
      561     if not glog then do:
      562       delete object v-qh.
      563       do v-ii = 1 to p-qh:num-buffers:
      564         delete object v-bh[v-ii].
      565       end.
      566       undo, return error .
      567     end.
      568     glog = v-qh:query-open no-error .
      569     if not glog then do:
      570       delete object v-qh.
      571       do v-ii = 1 to p-qh:num-buffers:
      572         delete object v-bh[v-ii].
      573       end.
      574       undo, return error .
      575     end.
      576     if p-next then do:
      577       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      578       glog = v-qh:get-next( p-lock) no-error .
      579       glog = v-qh:get-next( p-lock) no-error .
      580       if not glog or v-qh:query-off-end = yes then do:
      581         glog = v-qh:get-first( p-lock) no-error .
      582       end.
      583     end.
      584     else do:
      585       glog = v-qh:get-first( p-lock) no-error .
      586     end.
      587     do v-ii = 1 to p-qh:num-buffers:
      588       assign
      589       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      590       no-error.
      591     end.
      592     delete object v-qh.
      593     do v-ii = 1 to p-qh:num-buffers:
      594       delete object v-bh[v-ii].
      595     end.
      596   end.
      597   end procedure.
      598   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      599   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
