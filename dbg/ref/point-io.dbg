     2900     if rid-list <> "":U then assign v-doc-rec = integer(entry(1, rid-list)).
     2901     case p-type :
     2902       when 'all'         then assign RADIO-type = 3 .
     2903       when 'доставки':U  then assign RADIO-type = 2 .
     2904       when 'отгрузки':U then assign RADIO-type = 1 .
     2905     end.
     2906     if p-mode = 'объект':U then assign RADIO-db = 1 .
     2907     else                           assign RADIO-db = 2 .
