     1276   ON CHOOSE OF B-mark IN FRAME d-pl-list
     1277   DO:
     1278     if available X_point-io then do:
     1279   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1280   define variable v-str-recid14 as character no-undo .
     1281   define variable v-num-entry14 as integer   no-undo .
     1282   assign
     1283     v-str-recid14 = trim( string( recid( X_point-io ) , "->>>>>>>>>>>9":U ) )
     1284     v-num-entry14 = lookup( v-str-recid14 , rid-list )
     1285   .
     1286   if v-num-entry14 > 0 then do:
     1287     assign
     1288       entry( v-num-entry14, rid-list ) = "":U
     1289       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1290     .
     1291   end.
     1292   else do:
     1293     assign
     1294       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1295     .
     1296   end.
     1297       br-pl:refresh().
     1298       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1299         glog = br-pl:select-next-row ().
     1300         apply "iteration-changed" to br-pl in frame d-pl-list.
     1301       end.
     1302       if num-entries( rid-list ) = 0 then hide mark-num in frame d-pl-list.
     1303       else                                disp num-entries( rid-list ) @ mark-num with frame d-pl-list.
     1304     end.
     1305     apply "entry" to br-pl in frame d-pl-list.
     1306   END.
