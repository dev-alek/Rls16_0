     1364   ON VALUE-CHANGED OF RADIO-cli IN FRAME d-pl-list
     1365   DO:
     1366    define variable  v-rid-list as character no-undo .
     1367    define buffer buf_clients for ub.clients.
     1368     assign RADIO-cli .
     1369     if RADIO-cli = 1 then do:
     1370       assign
     1371         v-cli-type = ''
     1372         v-cli-code = 0
     1373       .
     1374     end.
     1375     else do:
     1376       run ref/cli-all.w ( input parParentProc
     1377                          ,input "b-sel"
     1378                          ,input 'все':U
     1379                          ,input 'все':U
     1380                          ,input 'текущие':U
     1381                          ,input ?
     1382                          ,input ",,,,,,NO,,":u
     1383                          ,input "without-obj":U
     1384                          ,output v-rid-list ) .
     1385       if v-rid-list <> "" then do:
     1386         find first buf_clients no-lock where
     1387                RECID(buf_clients) = int (v-rid-list) no-error.
     1388         assign
     1389         v-cli-type = buf_clients.obj-type
     1390         v-cli-code = buf_clients.obj-code
     1391         .
     1392       end.
     1393       else  assign RADIO-cli = 1 .
     1394     end.
     1395     display RADIO-cli    with frame d-pl-list.
     1396     RUN OpenBr in this-procedure ( input yes, input no, input no).
     1397     apply "entry" to br-pl .
     1398   END.
     1399   ON VALUE-CHANGED OF RADIO-DB IN FRAME d-pl-list
     1400   DO:
     1401     assign RADIO-DB .
     1402     if RADIO-DB = 1 then do:
     1403       assign p-mode = 'объект':U .
     1404       if lookup("b-add", bttns) > 0 then do:
     1405          ENABLE
     1406          b-add
     1407          b-chg
     1408          b-del
     1409          with frame d-pl-list.
     1410       end.
     1411     end.
     1412     else do:
     1413       assign p-mode = 'все':U .
     1414       DISABLE
     1415       b-add
     1416       b-chg
     1417       b-del
     1418       with frame d-pl-list.
     1419     end.
     1420     RUN OpenBr in this-procedure ( input yes, input no, input no).
     1421     apply "entry" to br-pl .
     1422   END.
     1423   ON VALUE-CHANGED OF RADIO-type IN FRAME d-pl-list
     1424   DO:
     1425     assign RADIO-type .
     1426     case RADIO-type :
     1427       when 3 then assign p-type = 'all' .
     1428       when 2 then assign p-type = 'доставки':U .
     1429       when 1 then assign p-type = 'отгрузки':U .
     1430     end.
     1431     RUN OpenBr in this-procedure ( input yes, input no, input no).
     1432     apply "entry" to br-pl .
     1433   END.
     1434   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-pl-list:PARENT eq ?
     1435   THEN FRAME d-pl-list:PARENT = ACTIVE-WINDOW.
     1436   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1437   on help of frame d-pl-list
     1438   do:
     1439     run gbl/app_help.p
     1440       (input this-procedure :file-name
     1441       ,input ''
     1442       ,input ?
     1443       ) no-error.
     1444     if error-status :error then do:
     1445       message
     1446         "Ошибка при вызове помощи"
     1447         error-status :get-message(1)
     1448         view-as alert-box .
     1449     end.
     1450   end.
     1451   run minbtn-set in this-procedure .
     1452   on choose of b-help in frame d-pl-list
     1453   do:
     1454     apply "help":u to frame d-pl-list .
     1455   end.
     1456   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1457   procedure minbtn-set :
     1458       do
     1459           on error undo, return error return-value
     1460           :
     1461           define variable ii              as integer       no-undo .
     1462           define variable fh              as widget-handle no-undo .
     1463           define variable hh              as widget-handle no-undo .
     1464           define variable v-h             as handle        extent 4 no-undo .
     1465           define variable v-name-button   as character     no-undo .
     1466           define variable v-help-old-x    as decimal       no-undo .
     1467           define variable v-help-old-y    as decimal       no-undo .
     1468           define variable v-help-old-size as decimal       no-undo .
     1469           define variable v-frame-width   as decimal       no-undo .
     1470           define variable jj              as integer       no-undo .
     1471           do
     1472               on error undo, return error
     1473               :
     1474               assign
     1475                   v-frame-width = frame d-pl-list:width - 0.3
     1476                   fh            = frame d-pl-list:first-child
     1477                   hh            = fh:first-child
     1478                   ii            = 1
     1479                   .
     1480               do while valid-handle(hh):
     1481                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1482                   do:
     1483                       case lc(hh:name) :
     1484                           when "b-help" then
     1485                               do:
     1486                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1487                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1488                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1489                                   hh:TOOLTIP = "Помощь" .
     1490                                   v-help-old-x = hh:column .
     1491                                   v-help-old-y = hh:row    .
     1492                                   v-help-old-size = hh:width .
     1493                                   hh:width-chars = 2.5 .
     1494                               end.
     1495                           when "b-print" then
     1496                               do:
     1497                                   hh:load-image("cmp/b-print.bmp":u) .
     1498                                   hh:TOOLTIP = "Печать" .
     1499                                   v-h[ii] = hh:handle .
     1500                                   ii = ii + 1 .
     1501                                   hh:width-chars = 3 .
     1502                               end.
     1503                           when "b-history" or
     1504                           when "b-hist" then
     1505                               do:
     1506                                   hh:load-image("cmp/b-hist.bmp":u) .
     1507                                   hh:TOOLTIP = "История" .
     1508                                   v-h[ii] = hh:handle .
     1509                                   ii = ii + 1 .
     1510                                   hh:width-chars = 3 .
     1511                               end.
     1512                           when "b-sch" then
     1513                               do:
     1514                                   hh:load-image("cmp/b-sch.bmp":u) .
     1515                                   hh:TOOLTIP = "Установка Фильтра" .
     1516                                   v-h[ii] = hh:handle .
     1517                                   ii = ii + 1 .
     1518                                   hh:width-chars = 3 .
     1519                               end.
     1520                           when "b-hist-user" then
     1521                               do:
     1522                                   hh:load-image("cmp/b-hist.bmp":u) .
     1523                                   hh:TOOLTIP = "История пользователя" .
     1524                                   ii = ii + 1 .
     1525                               end.
     1526                       end case.
     1527                   end.
     1528                   hh = hh:next-sibling.
     1529               end.
     1530               b-help:column = v-frame-width - b-help:width-chars.
     1531               jj = 0.
     1532               repeat ii = 4 to 1 by -1 :
     1533                   if valid-handle (v-h[ii] ) then
     1534                   do:
     1535                       jj  = jj + 1 .
     1536                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1537                       v-h[ii]:row    = v-help-old-y .
     1538                   end.
     1539               end.
     1540           end.
     1541       end.
     1542   end procedure.
     1543   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1544   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1545   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1546   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1547   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1548   define variable v-diasize-current-frame-height as decimal   no-undo .
     1549   define variable v-diasize-change-size          as logical   no-undo .
     1550   define variable v-diasize-resize-button        as handle    no-undo .
     1551   define variable v-diasize-wndmax               as logical   no-undo .
     1552   define variable v-diasize-wndstore             as logical   no-undo .
     1553   define variable v-diasize-proc-name            as character no-undo .
     1554   define variable v-diasize-browse-handle        as handle    no-undo .
     1555   define variable v-diasize-browse-number        as integer   no-undo .
     1556   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1557   define temp-table temp-diasize-handle no-undo
     1558     field handle-value  as handle
     1559     field save-position as decimal
     1560     index xpk is primary unique handle-value
     1561     .
     1562   define temp-table temp-browse-handle no-undo
