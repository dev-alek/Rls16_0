     1568     index xie browse-type browse-handle
     1569   .
     1570   procedure diasize_change-height :
     1571     define input  parameter p-change-value  as decimal   no-undo .
     1572     define input  parameter p-move-resize   as logical   no-undo .
     1573     define variable v-field-group-handle    as handle    no-undo .
     1574     define variable v-object-handle         as handle    no-undo .
     1575     define variable v-frame-height          as decimal   no-undo .
     1576     define variable v-frame-virtual-height  as decimal   no-undo .
     1577     define variable v-browse-height         as decimal   no-undo .
     1578     define variable v-window-height         as decimal   no-undo .
     1579     define variable v-window-virtual-height as decimal   no-undo .
     1580     define variable v-change-sign           as integer   no-undo .
     1581     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1582     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1583     if p-change-value > 0
     1584     then do:
     1585       if frame d-pl-list :height + p-change-value
     1586           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1587       then do:
     1588         assign
     1589           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1590                           - (frame d-pl-list :height-chars)
     1591         .
     1592         if p-change-value <= 0
     1593         then do:
     1594           run diasize_position-resize-button in this-procedure .
     1595           return .
     1596         end.
     1597       end.
     1598     end.
     1599     if p-change-value < 0
     1600     then do:
     1601       if frame d-pl-list :height + p-change-value < v-diasize-orig-frame-height
     1602       then do:
     1603         assign
     1604           p-change-value = v-diasize-orig-frame-height
     1605                          - (frame d-pl-list :height-chars)
     1606         .
     1607         if p-change-value >= 0
     1608         then do:
     1609           run diasize_position-resize-button in this-procedure .
     1610           return .
     1611         end.
     1612       end.
     1613     end.
     1614     if p-change-value >= 0
     1615     then do:
     1616       assign
     1617         v-change-sign = 1
     1618       .
     1619     end.
     1620     else do:
     1621       assign
     1622         v-change-sign = -1
     1623       .
     1624     end.
     1625     assign
     1626       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1627     .
     1628     if p-change-value = 0
     1629     then do:
     1630       run diasize_position-resize-button in this-procedure .
     1631       return .
     1632     end.
     1633     move_block:
     1634     do
     1635     on error undo move_block, retry move_block
     1636     :
     1637       if retry
     1638       then do:
     1639         do
     1640         on error undo move_block, leave move_block
     1641         :
     1642           if p-change-value > 0
     1643           then do:
     1644             for each buf_temp-diasize-handle
     1645             on error undo, next
     1646             :
     1647               assign
     1648                 v-object-handle = buf_temp-diasize-handle.handle-value
     1649               .
     1650               if v-object-handle <> v-diasize-resize-button
     1651               then do:
     1652                 assign
     1653                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1654                 .
     1655               end.
     1656             end.
     1657             assign
     1658               v-diasize-browse-handle :height = v-browse-height
     1659             .
     1660             for each buf_temp-browse-handle
     1661               where buf_temp-browse-handle.browse-type = 'height':u
     1662             on error undo, next
     1663             :
     1664               assign
     1665                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1666               .
     1667             end.
     1668             assign
     1669               frame d-pl-list :height = v-frame-height
     1670             .
     1671             if frame d-pl-list :scrollable = true
     1672             then do:
     1673               assign
     1674                 frame d-pl-list :virtual-height = v-frame-virtual-height
     1675               .
     1676             end.
     1677             run diasize_position-resize-button in this-procedure .
     1678           end.
     1679           else do:
     1680             if frame d-pl-list :scrollable = true
     1681             then do:
     1682               assign
     1683                 frame d-pl-list :virtual-height = v-frame-virtual-height
     1684               .
     1685             end.
     1686             assign
     1687               frame d-pl-list :height = v-frame-height
     1688             .
     1689             assign
     1690               v-diasize-browse-handle :height = v-browse-height
     1691             .
     1692             for each buf_temp-browse-handle
     1693               where buf_temp-browse-handle.browse-type = 'height':u
     1694             on error undo, next
     1695             :
     1696               assign
     1697                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1698               .
     1699             end.
     1700             for each buf_temp-diasize-handle
     1701             on error undo, next
     1702             :
     1703               assign
     1704                 v-object-handle = buf_temp-diasize-handle.handle-value
     1705               .
     1706               if v-object-handle <> v-diasize-resize-button
     1707               then do:
     1708                 assign
     1709                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1710                 .
     1711               end.
     1712             end.
     1713             run diasize_position-resize-button in this-procedure .
     1714           end.
     1715           assign
     1716             v-diasize-change-size = false
     1717           .
     1718           leave move_block .
     1719         end.
     1720       end.
     1721       assign
     1722         v-diasize-need-full-display = true
     1723       .
     1724       if v-diasize-change-size = false
     1725       then do:
     1726         assign
     1727           v-diasize-change-size = true
     1728         .
     1729       end.
     1730       else do:
     1731         return .
     1732       end.
     1733       assign
     1734         v-frame-height = frame d-pl-list :height
     1735         v-frame-virtual-height = frame d-pl-list :virtual-height
     1736         v-browse-height = v-diasize-browse-handle :height
     1737       .
     1738       for each buf_temp-browse-handle
     1739         where buf_temp-browse-handle.browse-type = 'height':u
     1740       :
     1741         assign
     1742           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1743         .
     1744       end.
     1745       for each buf_temp-diasize-handle
     1746       :
     1747         delete buf_temp-diasize-handle .
     1748       end.
     1749       assign
     1750         v-field-group-handle = frame d-pl-list :first-child
     1751       .
     1752       do while valid-handle(v-field-group-handle)
     1753       :
     1754         assign
     1755           v-object-handle = v-field-group-handle :first-child
     1756         .
     1757         do while valid-handle(v-object-handle)
     1758         :
     1759           if  v-object-handle <> v-diasize-browse-handle :handle
     1760           and can-query(v-object-handle, "row")
     1761           and can-query(v-object-handle, "height")
     1762           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1763           then do:
     1764             find first buf_temp-browse-handle
     1765               where buf_temp-browse-handle.browse-type   = 'height':u
     1766                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1767               no-error .
     1768             if available buf_temp-browse-handle
     1769             then do:
     1770             end.
     1771             else do:
     1772               create buf_temp-diasize-handle .
     1773               assign
     1774                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1775                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1776               .
     1777             end.
     1778           end.
     1779           assign
     1780             v-object-handle = v-object-handle :next-sibling
     1781           .
     1782         end.
     1783         assign
     1784           v-field-group-handle = v-field-group-handle :next-sibling
     1785         .
     1786       end.
     1787       do with frame d-pl-list
     1788       :
     1789         hide v-diasize-resize-button .
     1790         assign
     1791           v-diasize-resize-button :row    = 1
     1792           v-diasize-resize-button :column = 1
     1793         .
     1794       end.
     1795       if p-change-value > 0
     1796       then do:
     1797         if frame d-pl-list :scrollable = true
     1798         then do:
     1799           assign
     1800             frame d-pl-list :virtual-height = frame d-pl-list :virtual-height + p-change-value
     1801             no-error .
     1802           if error-status :error
     1803           or error-status :get-message(1) <> ""
     1804           then do:
     1805             undo move_block, retry move_block .
     1806           end.
     1807         end.
     1808         assign
     1809           frame d-pl-list :height = frame d-pl-list :height + p-change-value
     1810           no-error .
     1811         if error-status :error
     1812         or error-status :get-message(1) <> ""
     1813         then do:
     1814           undo move_block, retry move_block .
     1815         end.
     1816         assign
     1817           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1818           no-error .
     1819         if error-status :error
     1820         or error-status :get-message(1) <> ""
     1821         then do:
     1822           undo move_block, retry move_block .
     1823         end.
     1824         for each buf_temp-browse-handle
     1825           where buf_temp-browse-handle.browse-type = 'height':u
     1826         on error undo move_block, retry move_block
     1827         :
     1828           assign
     1829             buf_temp-browse-handle.browse-handle :height
     1830               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1831             no-error .
     1832           if error-status :error
     1833           or error-status :get-message(1) <> ""
     1834           then do:
     1835             undo move_block, retry move_block .
     1836           end.
     1837         end.
     1838         for each buf_temp-diasize-handle
     1839         on error undo move_block, retry move_block
     1840         :
     1841           assign
     1842             v-object-handle = buf_temp-diasize-handle.handle-value
     1843           .
     1844           if v-object-handle <> v-diasize-resize-button
     1845           then do:
     1846             assign
     1847               v-object-handle :row = v-object-handle :row + p-change-value
     1848               no-error .
     1849             if error-status :error
     1850             or error-status :get-message(1) <> ""
     1851             then do:
     1852               undo move_block, retry move_block .
     1853             end.
     1854           end.
     1855         end.
     1856       end.
     1857       else do:
     1858         for each buf_temp-diasize-handle
     1859         on error undo move_block, retry move_block
     1860         :
     1861           assign
     1862             v-object-handle = buf_temp-diasize-handle.handle-value
     1863           .
     1864           if v-object-handle <> v-diasize-resize-button
     1865           then do:
     1866             assign
     1867               v-object-handle :row = v-object-handle :row + p-change-value
     1868               no-error .
     1869             if error-status :error
     1870             or error-status :get-message(1) <> ""
     1871             then do:
     1872               undo move_block, retry move_block .
     1873             end.
     1874           end.
     1875         end.
     1876         assign
     1877           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1878           no-error .
     1879         if error-status :error
     1880         or error-status :get-message(1) <> ""
     1881         then do:
     1882           undo move_block, retry move_block .
     1883         end.
     1884         for each buf_temp-browse-handle
     1885           where buf_temp-browse-handle.browse-type = 'height':u
     1886         on error undo move_block, retry move_block
     1887         :
     1888           assign
     1889             buf_temp-browse-handle.browse-handle :height
     1890               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1891             no-error .
     1892           if error-status :error
     1893           or error-status :get-message(1) <> ""
     1894           then do:
     1895             undo move_block, retry move_block .
     1896           end.
     1897         end.
     1898         assign
     1899           frame d-pl-list :height = frame d-pl-list :height + p-change-value
     1900           no-error .
     1901         if error-status :error
     1902         or error-status :get-message(1) <> ""
     1903         then do:
     1904           undo move_block, retry move_block .
     1905         end.
     1906         if frame d-pl-list :scrollable = true
     1907         then do:
     1908           assign
     1909             frame d-pl-list :virtual-height = frame d-pl-list :virtual-height + p-change-value
     1910             no-error .
     1911           if error-status :error
     1912           or error-status :get-message(1) <> ""
     1913           then do:
     1914             undo move_block, retry move_block .
     1915           end.
     1916         end.
     1917       end.
     1918       if p-move-resize = true
     1919       then do:
     1920         run diasize_position-resize-button in this-procedure .
     1921       end.
     1922       if v-diasize-wndstore = true
     1923       then do:
     1924         if connected("ub") = true
     1925         then do:
     1926           define variable v-cntxt-db-num        as integer   no-undo .
     1927           define variable v-cntxt-userid        as character no-undo .
     1928           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1929                                             , OUTPUT v-cntxt-userid
     1930                                             ) .
     1931           run gbl/wndsizew.p
     1932             (input  v-cntxt-db-num
     1933             ,input  v-cntxt-userid
     1934             ,input  v-diasize-proc-name
     1935             ,input  'height':u
     1936             ,input  string(frame d-pl-list :height - v-diasize-orig-frame-height)
     1937             ) .
     1938         end.
     1939       end.
     1940     end.
     1941     assign
     1942       v-diasize-change-size = false
     1943     .
     1944   end procedure.
     1945   procedure diasize_set-height :
     1946     define input  parameter p-new-height  as decimal   no-undo .
     1947     define input  parameter p-move-resize as logical   no-undo .
     1948     do
     1949     on error undo, return error return-value
     1950     :
     1951       run diasize_change-height in this-procedure
     1952         (input  (p-new-height - frame d-pl-list :height)
     1953         ,input  p-move-resize
     1954         ) .
     1955     end.
     1956   end procedure.
     1957   procedure diasize_change-width :
     1958     define input  parameter p-change-value as decimal   no-undo .
     1959     define input  parameter p-move-resize  as logical   no-undo .
     1960     define variable v-field-group-handle   as handle    no-undo .
     1961     define variable v-object-handle        as handle    no-undo .
     1962     define variable v-frame-width          as decimal   no-undo .
     1963     define variable v-frame-virtual-width  as decimal   no-undo .
     1964     define variable v-browse-width         as decimal   no-undo .
     1965     define variable v-window-width         as decimal   no-undo .
     1966     define variable v-window-virtual-width as decimal   no-undo .
     1967     define variable v-change-sign          as integer   no-undo .
     1968     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1969     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1970     if p-change-value > 0
     1971     then do:
     1972       if frame d-pl-list :width + p-change-value >
     1973           session :width-chars
     1974       then do:
     1975         assign
     1976           p-change-value = session :width-chars - frame d-pl-list :width
     1977         .
     1978         if p-change-value <= 0
     1979         then do:
     1980           run diasize_position-resize-button in this-procedure .
     1981           return .
     1982         end.
     1983       end.
     1984     end.
     1985     if p-change-value < 0
     1986     then do:
     1987       if frame d-pl-list :width + p-change-value < v-diasize-orig-frame-width
     1988       then do:
     1989         assign
     1990           p-change-value = v-diasize-orig-frame-width
     1991                          - frame d-pl-list :width
     1992         .
     1993         if p-change-value >= 0
     1994         then do:
     1995           run diasize_position-resize-button in this-procedure .
     1996           return .
     1997         end.
     1998       end.
     1999     end.
     2000     if p-change-value >= 0
     2001     then do:
     2002       assign
     2003         v-change-sign = 1
     2004       .
     2005     end.
     2006     else do:
     2007       assign
     2008         v-change-sign = -1
     2009       .
     2010     end.
     2011     assign
     2012       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2013     .
     2014     if p-change-value = 0
     2015     then do:
     2016       run diasize_position-resize-button in this-procedure .
     2017       return .
     2018     end.
     2019     move_block:
     2020     do
     2021     on error undo move_block, leave move_block
     2022     :
     2023       if retry
