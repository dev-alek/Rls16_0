     2920     RUN enable_UI.
     2921     RUN OpenBR in this-procedure ( input yes, input no, input no).
     2922   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2923   DEF VAR cur-clmn-numbr-pl as INT EXTENT 6 no-undo.
     2924   DEF VAR varmvibr-pl       as INT no-undo.
     2925   DEF VAR varmvjbr-pl       as INT no-undo.
     2926   DEF VAR varmvkbr-pl       as INT no-undo.
     2927   DEF VAR varmvlbr-pl       as INT no-undo.
     2928   DEF VAR move-elementbr-pl as INT no-undo.
     2929   def var jjbr-pl           as int no-undo.
     2930   do varmvibr-pl = 1 to EXTENT(cur-clmn-numbr-pl):
     2931     ASSIGN cur-clmn-numbr-pl[varmvibr-pl] = varmvibr-pl.
     2932   END.
     2933   RUN start-mv-clmnbr-pl.
     2934   PROCEDURE start-mv-clmnbr-pl:
     2935   def var old-session as logical no-undo.
     2936      old-session = SESSION:IMMEDIATE-DISPLAY.
     2937      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2938          IF  p-mode = 'объект':U  THEN DO:
     2939      DO jjbr-pl = NUM-ENTRIES('1,2,3,4,5,6') TO 1 BY -1:
     2940        RUN re-move-clmnbr-pl ( cur-clmn-numbr-pl[INTEGER(ENTRY (jjbr-pl, '1,2,3,4,5,6'))] , 2).
     2941      END.
     2942          END.
     2943          IF  p-mode = 'все':U  THEN DO:
     2944      DO jjbr-pl = NUM-ENTRIES('1,2,5,6,3,4') TO 1 BY -1:
     2945        RUN re-move-clmnbr-pl ( cur-clmn-numbr-pl[INTEGER(ENTRY (jjbr-pl, '1,2,5,6,3,4'))] , 2).
     2946      END.
     2947          END.
     2948      SESSION:IMMEDIATE-DISPLAY = old-session.
     2949   END.
     2950   ON ctrl-cursor-right OF BROWSE br-pl do:
     2951     RUN re-move-clmnbr-pl ( 2, 6).
     2952   END.
     2953   ON ctrl-cursor-left OF BROWSE br-pl do:
     2954     RUN re-move-clmnbr-pl (6, 2).
     2955   END.
     2956   PROCEDURE re-move-clmnbr-pl:
     2957     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2958     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2959     DO varmvibr-pl = 1 TO EXTENT(cur-clmn-numbr-pl):
     2960       if cur-clmn-numbr-pl[varmvibr-pl] = source-column THEN cur-clmn-numbr-pl[varmvibr-pl] = -1.
     2961     END.
     2962     if br-pl:MOVE-COLUMN(source-column, target-column) IN FRAME d-pl-list then.
     2963     if source-column > target-column THEN
     2964     DO varmvjbr-pl = source-column - 1 to target-column BY -1:
     2965       DO varmvibr-pl = 1 TO EXTENT(cur-clmn-numbr-pl):
     2966           if cur-clmn-numbr-pl[varmvibr-pl] = varmvjbr-pl THEN DO:
     2967             cur-clmn-numbr-pl[varmvibr-pl] = cur-clmn-numbr-pl[varmvibr-pl] + 1.
     2968           END.
     2969       END.
     2970     END.
     2971     ELSE
     2972     DO varmvjbr-pl = source-column + 1 to target-column:
     2973       DO varmvibr-pl = 1 TO EXTENT(cur-clmn-numbr-pl):
     2974         if cur-clmn-numbr-pl[varmvibr-pl] = varmvjbr-pl THEN DO:
     2975           cur-clmn-numbr-pl[varmvibr-pl] = cur-clmn-numbr-pl[varmvibr-pl] - 1.
     2976         END.
     2977       END.
     2978     END.
     2979     DO varmvibr-pl = 1 TO EXTENT(cur-clmn-numbr-pl):
     2980       if cur-clmn-numbr-pl[varmvibr-pl] = -1 THEN cur-clmn-numbr-pl[varmvibr-pl] = target-column.
     2981     END.
     2982   END PROCEDURE.
     2983   PROCEDURE ch-clmnbr-pl:
     2984     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2985     if cur-clmn-loc <= 2 then do:
     2986       return .
     2987     end.
     2988     DO varmvibr-pl = 1 TO EXTENT(cur-clmn-numbr-pl):
     2989       if cur-clmn-numbr-pl[varmvibr-pl] = cur-clmn-loc THEN move-elementbr-pl = varmvibr-pl.
     2990     END.
     2991     RUN re-move-clmnbr-pl (cur-clmn-loc, 2).
     2992   END PROCEDURE.
     2993   PROCEDURE mv-brw-defaultbr-pl:
     2994   def var old-session as logical no-undo.
     2995     old-session = SESSION:IMMEDIATE-DISPLAY.
     2996     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2997     do varmvlbr-pl = 2 to EXTENT(cur-clmn-numbr-pl):
     2998       RUN re-move-clmnbr-pl (cur-clmn-numbr-pl[varmvlbr-pl], varmvlbr-pl).
     2999     END.
     3000     RUN start-mv-clmnbr-pl.
     3001     SESSION:IMMEDIATE-DISPLAY = old-session.
     3002   END PROCEDURE.
