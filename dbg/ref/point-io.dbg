     3099             then  substitute(' X_point-io.cli-type = &4&1&4 AND X_point-io.cli-code  = &2 AND X_point-io.db-num  = &3 ', p-cli-type, p-cli-code, p-db-num, chr(34))  + " " + where-phrase-33
