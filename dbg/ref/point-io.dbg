     2154               where buf_temp-browse-handle.browse-type   = 'width':u
     2155                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2156               no-error .
     2157             if available buf_temp-browse-handle
     2158             then do:
     2159             end.
     2160             else do:
     2161               create buf_temp-diasize-handle .
     2162               assign
     2163                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2164                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2165               .
     2166             end.
     2167           end.
     2168           assign
     2169             v-object-handle = v-object-handle :next-sibling
     2170           .
     2171         end.
     2172         assign
     2173           v-field-group-handle = v-field-group-handle :next-sibling
     2174         .
     2175       end.
     2176       do with frame d-pl-list
     2177       :
     2178         hide v-diasize-resize-button .
     2179         v-diasize-resize-button :row = 1.
     2180         v-diasize-resize-button :column = 1.
     2181       end.
     2182       if p-change-value > 0
     2183       then do:
     2184         if frame d-pl-list :scrollable = true
     2185         then do:
     2186           assign
     2187             frame d-pl-list :virtual-width = frame d-pl-list :virtual-width + p-change-value
     2188             no-error .
     2189           if error-status :error
     2190           or error-status :get-message(1) <> ""
     2191           then do:
     2192             undo move_block, retry move_block.
     2193           end.
     2194         end.
     2195         assign
     2196           frame d-pl-list :width = v-frame-width + p-change-value
     2197           no-error .
     2198         if error-status :error
     2199         or error-status :get-message(1) <> ""
     2200         then do:
     2201           undo move_block, retry move_block.
     2202         end.
     2203         assign
     2204           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2205         no-error .
     2206         if error-status :error
     2207         or error-status :get-message(1) <> ""
     2208         then do:
     2209           undo move_block, retry move_block.
     2210         end.
     2211         for each buf_temp-browse-handle
     2212           where buf_temp-browse-handle.browse-type = 'width':u
     2213         on error undo move_block, retry move_block
     2214         :
     2215           assign
     2216             buf_temp-browse-handle.browse-handle :width
     2217               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2218             no-error .
     2219           if error-status :error
     2220           or error-status :get-message(1) <> ""
     2221           then do:
     2222             undo move_block, retry move_block .
     2223           end.
     2224         end.
     2225         for each buf_temp-diasize-handle
     2226         on error undo move_block, retry move_block
     2227         :
     2228           assign
     2229             v-object-handle = buf_temp-diasize-handle.handle-value
     2230           .
     2231           if v-object-handle <> v-diasize-resize-button
     2232           then do:
     2233             assign
     2234               v-object-handle :col = v-object-handle :col + p-change-value
     2235               no-error .
     2236             if error-status :error
     2237             or error-status :get-message(1) <> ""
     2238             then do:
     2239               undo move_block, retry move_block .
     2240             end.
     2241           end.
     2242         end.
     2243       end.
     2244       else do:
     2245         for each buf_temp-diasize-handle
     2246         on error undo move_block, retry move_block
     2247         :
     2248           assign
     2249             v-object-handle = buf_temp-diasize-handle.handle-value
     2250           .
     2251           if v-object-handle <> v-diasize-resize-button
     2252           then do:
     2253             assign
     2254               v-object-handle :col = v-object-handle :col + p-change-value
     2255               no-error .
     2256             if error-status :error
     2257             or error-status :get-message(1) <> ""
     2258             then do:
     2259               undo move_block, retry move_block .
     2260             end.
     2261           end.
     2262         end.
     2263         for each buf_temp-browse-handle
     2264           where buf_temp-browse-handle.browse-type = 'width':u
     2265         on error undo move_block, retry move_block
     2266         :
     2267           assign
     2268             buf_temp-browse-handle.browse-handle :width
     2269               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2270             no-error .
     2271           if error-status :error
     2272           or error-status :get-message(1) <> ""
     2273           then do:
     2274             undo move_block, retry move_block .
     2275           end.
     2276         end.
     2277         assign
     2278           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2279           no-error .
     2280         if error-status :error
     2281         or error-status :get-message(1) <> ""
     2282         then do:
     2283           undo move_block, retry move_block.
     2284         end.
     2285         assign
     2286           frame d-pl-list :width = frame d-pl-list :width + p-change-value
     2287         no-error .
     2288         if error-status :error
     2289         or error-status :get-message(1) <> ""
     2290         then do:
     2291           undo move_block, retry move_block.
     2292         end.
     2293         if frame d-pl-list :scrollable = true
     2294         then do:
     2295           assign
     2296             frame d-pl-list :virtual-width = frame d-pl-list :virtual-width + p-change-value
     2297           no-error .
     2298           if error-status :error
     2299           or error-status :get-message(1) <> ""
     2300           then do:
     2301             undo move_block, retry move_block.
     2302           end.
     2303         end.
     2304       end.
     2305       if p-move-resize
     2306       then do:
     2307         run diasize_position-resize-button in this-procedure .
     2308       end.
     2309       if v-diasize-wndstore = true
     2310       then do:
     2311         if connected("ub") = true
     2312         then do:
     2313           define variable v-cntxt-db-num        as integer   no-undo .
     2314           define variable v-cntxt-userid        as character no-undo .
     2315           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2316                                             , OUTPUT v-cntxt-userid
     2317                                             ) .
     2318           run gbl/wndsizew.p
     2319             (input  v-cntxt-db-num
     2320             ,input  v-cntxt-userid
     2321             ,input  v-diasize-proc-name
     2322             ,input  'width':u
     2323             ,input  string(frame d-pl-list :width - v-diasize-orig-frame-width)
     2324             ) .
     2325         end.
     2326       end.
     2327     end.
     2328     assign
     2329       v-diasize-change-size = false
     2330     .
     2331   end procedure.
     2332   procedure diasize_set-width :
     2333     define input  parameter p-new-width  as decimal   no-undo .
     2334     define input  parameter p-move-resize as logical   no-undo .
     2335     do
     2336     on error undo, return error return-value
     2337     :
     2338       run diasize_change-width in this-procedure
     2339         (input  (p-new-width - frame d-pl-list :width)
     2340         ,input  p-move-resize
     2341         ) .
     2342     end.
     2343   end procedure.
     2344   procedure diasize_position-resize-button :
     2345     do with frame d-pl-list
     2346     :
     2347       hide v-diasize-resize-button .
     2348       assign
     2349         v-diasize-resize-button :row = frame d-pl-list :height - v-diasize-resize-button :height
     2350                     - 1
     2351                     - (frame d-pl-list :border-bottom-pixels / session :pixels-per-row)
     2352         v-diasize-resize-button :col = frame d-pl-list :width - v-diasize-resize-button :width
     2353                     - 1
     2354                     - (frame d-pl-list :border-right-pixels / session :pixels-per-column)
     2355       .
     2356       view v-diasize-resize-button .
     2357     end.
     2358   end procedure.
     2359   on alt-right anywhere
     2360   do:
     2361     run diasize_change-width in this-procedure
     2362       (input 1
     2363       ,input true
     2364       ) .
     2365     return no-apply .
     2366   end.
     2367   on alt-left anywhere
     2368   do:
     2369     run diasize_change-width in this-procedure
     2370       (input -1
     2371       ,input true
     2372       ) .
     2373     return no-apply .
     2374   end.
     2375   on alt-down anywhere
     2376   do:
     2377     run diasize_change-height in this-procedure
     2378       (input 1
     2379       ,input true
     2380       ) .
     2381     return no-apply .
     2382   end.
     2383   on alt-up anywhere
     2384   do:
     2385     run diasize_change-height in this-procedure
     2386       (input -1
     2387       ,input true
     2388       ) .
     2389     return no-apply .
     2390   end.
     2391   on alt-enter of frame d-pl-list
     2392   do:
     2393     run diasize_maximize in this-procedure
     2394       (input  ?
     2395       ).
     2396     return no-apply .
     2397   end.
     2398   procedure diasize_end-move :
     2399     do
     2400     on error undo, return error return-value
     2401     :
     2402       define variable v-row-delta as decimal   no-undo .
     2403       define variable v-col-delta as decimal   no-undo .
     2404       define variable v-new-row as decimal   no-undo .
     2405       define variable v-new-col as decimal   no-undo .
     2406       assign
     2407         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2408         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2409       .
     2410       assign
     2411         v-row-delta = v-new-row - frame d-pl-list :height
     2412         v-col-delta = v-new-col - frame d-pl-list :width
     2413       .
     2414       run diasize_change-height in this-procedure
     2415         (input v-row-delta
     2416         ,input true
     2417         ) .
     2418       run diasize_change-width in this-procedure
     2419         (input v-col-delta
     2420         ,input true
     2421         ) .
     2422     end.
     2423   end procedure.
     2424   procedure diasize_maximize :
     2425     define input  parameter p-action as logical   no-undo .
     2426     do
     2427     on error undo, return error return-value
     2428     :
     2429       if p-action = ?
     2430       then do:
     2431         if v-diasize-need-maximize = true
     2432         then do:
     2433           assign
     2434             p-action = true
     2435           .
     2436         end.
     2437         else do:
     2438           assign
     2439             p-action = false
     2440           .
     2441         end.
     2442       end.
     2443       if p-action = true
     2444       then do:
     2445         run diasize_change-height in this-procedure
     2446           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2447               - frame d-pl-list :height-chars
     2448           ,input true
     2449           ) .
     2450         run diasize_change-width in this-procedure
     2451           (input session :width-chars
     2452               - frame d-pl-list :width-chars
     2453           ,input true
     2454           ) .
     2455         assign
     2456           v-diasize-need-maximize = false
     2457         .
     2458       end.
     2459       else do:
     2460         run diasize_change-width in this-procedure
     2461           (input v-diasize-orig-frame-width
     2462               - frame d-pl-list :width-chars
     2463           ,input true
     2464           ) .
     2465         run diasize_change-height in this-procedure
     2466           (input v-diasize-orig-frame-height
     2467               - frame d-pl-list :height-chars
     2468           ,input true
     2469           ) .
     2470         assign
     2471           v-diasize-need-maximize = true
     2472         .
     2473       end.
     2474     end.
     2475   end procedure.
     2476   procedure diasize_restore-orig-size :
     2477     do
     2478     on error undo, return error return-value
     2479     :
     2480       assign
     2481         v-diasize-current-frame-width  = frame d-pl-list :width
     2482         v-diasize-current-frame-height = frame d-pl-list :height
     2483       .
     2484       run diasize_set-height in this-procedure
     2485         (input  v-diasize-orig-frame-height
     2486         ,input  true
     2487         ) .
     2488       run diasize_set-width in this-procedure
     2489         (input  v-diasize-orig-frame-width
     2490         ,input  true
     2491         ) .
     2492     end.
     2493   end procedure.
     2494   procedure diasize_restore-current-size :
     2495     do
     2496     on error undo, return error return-value
     2497     :
     2498       run diasize_set-height in this-procedure
     2499         (input  v-diasize-current-frame-height
     2500         ,input  true
     2501         ) .
     2502       run diasize_set-width in this-procedure
     2503         (input  v-diasize-current-frame-width
     2504         ,input  true
     2505         ) .
     2506     end.
     2507   end procedure.
     2508   procedure diasize_set-browse-handle :
     2509     define input  parameter p-browse-handle as handle   no-undo .
     2510     define buffer buf_temp-browse-handle for temp-browse-handle .
     2511     do
     2512     on error undo, return error return-value
     2513     :
     2514       assign
     2515         v-diasize-browse-handle = p-browse-handle
     2516       .
     2517       for each buf_temp-browse-handle
     2518       on error undo, return error return-value
     2519       :
     2520         delete buf_temp-browse-handle .
     2521       end.
     2522     end.
     2523   end procedure.
     2524   procedure diasize_add_browse :
     2525     define input  parameter p-browse-type   as character no-undo .
     2526     define input  parameter p-browse-handle as handle    no-undo .
     2527     define buffer buf_temp-browse-handle for temp-browse-handle .
     2528     do
     2529     on error undo, return error return-value
     2530     :
     2531       assign
     2532         v-diasize-browse-number = v-diasize-browse-number + 1
     2533       .
     2534       create buf_temp-browse-handle .
     2535       assign
     2536         buf_temp-browse-handle.browse-type   = p-browse-type
     2537         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2538         buf_temp-browse-handle.browse-handle = p-browse-handle
     2539       .
     2540     end.
     2541   end procedure.
     2542   procedure diasize_init :
     2543     define variable v-default-value    as logical   no-undo .
     2544     define variable v-restore-saved    as logical   no-undo .
     2545     define variable v-resize-value-str as character no-undo .
     2546     do
     2547     on error undo, return error return-value
     2548     :
     2549       do with frame d-pl-list
     2550       :
     2551         assign
     2552           v-diasize-orig-frame-height = frame d-pl-list :height
     2553           v-diasize-orig-frame-width  = frame d-pl-list :width
     2554           v-diasize-browse-handle     = browse br-pl :handle
     2555         .
     2556         create button v-diasize-resize-button
     2557         assign
     2558           parent        = frame d-pl-list :first-child
     2559           label         = "s"
     2560           height-pixels = 16
     2561           width-pixels  = 16
     2562           visible       = true
     2563           sensitive     = true
     2564           movable       = true
     2565           triggers:
     2566             on end-move persistent run diasize_end-move in this-procedure .
     2567           end triggers.
     2568         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2569         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2570         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2571         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2572         assign
     2573           v-diasize-wndmax = false
     2574         .
     2575         if connected("ub") = true
     2576         then do:
     2577           define variable v-cntxt-db-num        as integer   no-undo .
     2578           define variable v-cntxt-userid        as character no-undo .
     2579           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2580                                             , OUTPUT v-cntxt-userid
     2581                                             ) .
     2582           run gbl/wndpar_r.p
     2583             (input  v-cntxt-db-num
     2584             ,input  v-cntxt-userid
     2585             ,input  'wndmax':U
     2586             ,output v-diasize-wndmax
     2587             ,output v-default-value
     2588             ) .
     2589         end.
     2590         assign
     2591           v-diasize-wndstore = false
     2592         .
     2593         if connected("ub") = true
     2594         then do:
     2595           run gbl/wndpar_r.p
     2596             (input  v-cntxt-db-num
     2597             ,input  v-cntxt-userid
     2598             ,input  'wndstore':U
     2599             ,output v-diasize-wndstore
     2600             ,output v-default-value
     2601             ) .
     2602         end.
     2603         assign
     2604           v-diasize-proc-name = entry(1, program-name(2), '.')
     2605         .
     2606         if v-diasize-wndstore = true
     2607         then do:
     2608           assign
     2609             v-restore-saved = false
     2610           .
     2611           if connected("ub") = true
     2612           then do:
     2613             run gbl/wndsizer.p
     2614               (input  v-cntxt-db-num
     2615               ,input  v-cntxt-userid
     2616               ,input  v-diasize-proc-name
     2617               ,input  'height':u
     2618               ,output v-resize-value-str
     2619               ) .
     2620             if v-resize-value-str <> '':U
     2621             then do:
     2622               run diasize_change-height in this-procedure
     2623                 (input  integer(v-resize-value-str)
     2624                 ,input  true
     2625                 ) .
     2626               assign
     2627                 v-restore-saved = true
     2628               .
     2629             end.
     2630           end.
     2631           if connected("ub") = true
     2632           then do:
     2633             run gbl/wndsizer.p
     2634               (input  v-cntxt-db-num
     2635               ,input  v-cntxt-userid
     2636               ,input  v-diasize-proc-name
     2637               ,input  'width':u
     2638               ,output v-resize-value-str
     2639               ) .
     2640             if v-resize-value-str <> '':U
     2641             then do:
     2642               run diasize_change-width in this-procedure
     2643                 (input  integer(v-resize-value-str)
     2644                 ,input  true
     2645                 ) .
     2646               assign
     2647                 v-restore-saved = true
     2648               .
     2649             end.
     2650           end.
     2651           if v-restore-saved <> true
     2652           then do:
     2653             if v-diasize-wndmax = true
     2654             then do:
     2655               run diasize_maximize in this-procedure
     2656                 (input  true
     2657                 ) .
     2658             end.
     2659           end.
     2660         end.
     2661         else do:
     2662           if v-diasize-wndmax = true
     2663           then do:
     2664             run diasize_maximize in this-procedure
     2665               (input  true
     2666               ) .
     2667           end.
     2668         end.
     2669       end.
     2670     end.
     2671   end procedure.
     2672   procedure diasize_need-full-display :
     2673     define output parameter p-need-full-display as logical   no-undo .
     2674     do
     2675     on error undo, return error return-value
     2676     :
     2677       assign
     2678         p-need-full-display = v-diasize-need-full-display
     2679       .
     2680       assign
     2681         v-diasize-need-full-display = false
     2682       .
     2683     end.
     2684   end procedure.
     2685   procedure get-context :
     2686      define output parameter p-db-num as integer          no-undo.
     2687      define output parameter p-user-id as character        no-undo.
     2688      define variable v-login               as character    no-undo.
     2689      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2690      define buffer buf_user-login  for ub.user-login .
     2691      do
     2692      on error undo, return error
     2693      :
     2694            FIND FIRST buf_sys-ctrl no-lock.
     2695            ASSIGN
     2696               v-login = USERID("ub")
     2697               p-db-num = buf_sys-ctrl.db-num
     2698            .
     2699            FIND FIRST buf_user-login
     2700                 WHERE buf_user-login.db-num = p-db-num
     2701                   AND buf_user-login.user-login = v-login
     2702                 no-lock
     2703                 no-error
     2704                 .
     2705            IF AVAILABLE buf_user-login
     2706            THEN DO:
     2707               assign
     2708                  p-user-id = buf_user-login.user-id
     2709               .
     2710            END.
     2711      end.
     2712   end procedure.
     2713       run diasize_init in this-procedure .
     2714   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2715   procedure set-filter-name :
     2716   define input parameter p-filter-name as character no-undo .
     2717     do with frame d-pl-list:
     2718       if p-filter-name > "" then do:
     2719         assign
     2720           frame d-pl-list:title
     2721             = frame d-pl-list:title + "   ФИЛЬТР: " + p-filter-name.
     2722         .
     2723         assign
     2724           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2725         .
     2726       end.
     2727       else do:
     2728         assign
     2729           b-sch :tooltip = ""
     2730         .
     2731       end.
     2732     end.
     2733   end procedure.
     2734   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2735   on f5 of frame d-pl-list anywhere
     2736   do:
     2737     v-doc-rec = recid(X_point-io). run openbr in this-procedure ( input yes, input no, input no). reposition br-pl to recid(v-doc-rec). v-doc-rec = ? .
     2738       apply "VALUE-CHANGED" to br-pl.
     2739   end.
     2740   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2741   do:
     2742     br-pl :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2743   end.
     2744   def var sort-labelbr-pl   as character no-undo .
     2745   def var sort-clmnbr-pl    as handle    no-undo .
     2746   def var cur-clmnbr-pl     as handle    no-undo .
     2747   def var cur-clmn-locbr-pl as integer   no-undo .
     2748   def var re-querybr-pl     as logical   initial no no-undo .
     2749   on start-search, ctrl-o of br-pl in frame d-pl-list do:
     2750      run sort-brbr-pl
     2751        (input (if available X_point-io
     2752                then recid(X_point-io)
     2753                else ?
     2754               )
     2755        ).
     2756   end.
     2757   PROCEDURE sort-brbr-pl :
     2758     define input parameter p-recid as recid no-undo .
     2759     if re-querybr-pl = no then do:
     2760       assign
     2761          cur-clmnbr-pl = br-pl:current-column in frame d-pl-list
     2762       .
     2763       if sort-clmnbr-pl <> ? then sort-clmnbr-pl:column-fgcolor = 0.
     2764       if cur-clmnbr-pl = sort-clmnbr-pl then do:
     2765         assign
     2766            sort-labelbr-pl = ""
     2767            sort-clmnbr-pl = ?
     2768         .
     2769        end.
     2770        else do:
     2771          assign
     2772            sort-labelbr-pl = cur-clmnbr-pl:label
     2773            sort-clmnbr-pl  = cur-clmnbr-pl
     2774            sort-clmnbr-pl:column-fgcolor = 4
     2775          .
     2776        end.
     2777      end.
     2778     assign
     2779       cur-clmn-locbr-pl = 1
     2780     .
     2781     def var column-handle as handle no-undo .
     2782     column-handle = br-pl:first-column.
     2783     do while valid-handle(column-handle) :
     2784       if column-handle = cur-clmnbr-pl then do:
     2785         leave .
     2786       end.
     2787       column-handle = column-handle:NEXT-COLUMN.
     2788       assign
     2789         cur-clmn-locbr-pl = cur-clmn-locbr-pl + 1
     2790       .
     2791     end.
     2792     case sort-labelbr-pl:
     2793           when X_point-io.point-type:label in browse br-pl then DO:    assign       sort-column-name = "X_point-io.point-type"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2794           when X_point-io.point-code:label in browse br-pl then DO:    assign       sort-column-name = "X_point-io.point-code"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2795           when X_point-io.point-name:label in browse br-pl then DO:    assign       sort-column-name = "X_point-io.point-name"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2796           when X_point-io.status_:label in browse br-pl then DO:    assign       sort-column-name = "X_point-io.status_"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2797       otherwise do:
     2798         assign
     2799           sort-column-name = ""
     2800         .
     2801         run OpenBr in this-procedure ( input yes, input no, input no).
     2802           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-pl') then do:
     2803             run mv-brw-defaultbr-pl.
     2804           end.
     2805         if sort-labelbr-pl <> "" then do:
