     3803                             ,input QUERY br-pl:handle
     3804                             ,input parameter-3-45
     3805                             ,input parameter-4-45
     3806                             ,input parameter-5-45
     3807                             ,input parameter-6-45
     3808                             ,input parameter-7-45
     3809                             )
     3810         .
     3811         assign
     3812           l-filter-open-45 = true
     3813         .
     3814       end.
     3815       if l-filter-open-45 = false then do:
     3816         message
     3817           "Ошибка при фильтрации / сортировке" skip
     3818           "Будут показаны записи без учета фильтра" skip
     3819           view-as alert-box .
     3820       end.
     3821       else do:
     3822           assign
     3823             l-query-was-opened = true
     3824           .
     3825       end.
     3826     end.
     3827     if l-filter-open-45 = false then do:
     3828       OPEN QUERY br-pl FOR EACH X_point-io
     3829         where  X_point-io.point-type = p-type and X_point-io.db-num = p-db-num
     3830         indexed-reposition
     3831     .
     3832         assign
     3833           l-query-was-opened = true
     3834         .
     3835     end.
     3836     run waitfram-hide in this-procedure .
     3837       end.
     3838       else do:
     3839   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3840   define variable  l-disable-where-47  as logical   no-undo .
     3841   define variable  l-filter-open-47    as logical   .
     3842   define variable  flt-rec-47       as recid     no-undo .
     3843   define variable  filter-name-47      as character no-undo .
     3844   define variable  where-phrase-47     as character no-undo .
     3845   define variable  sort-phrase-47      as character no-undo .
     3846   define variable  where-phrase-rus-47 as character no-undo .
     3847   define variable  sort-phrase-rus-47  as character no-undo .
     3848     run waitfram-show in this-procedure
     3849       (input "ЖДИТЕ ..."
     3850       ).
     3851   run gbl/flt-get.p
     3852     (input filter-point
     3853     ,output flt-rec-47
     3854     ,output filter-name-47
     3855     ,output where-phrase-47
     3856     ,output sort-phrase-47
     3857     ,output where-phrase-rus-47
     3858     ,output sort-phrase-rus-47
     3859     ).
     3860       run set-filter-name in this-procedure
     3861         (INPUT filter-name-47
     3862         ) no-error .
     3863     assign
     3864       l-filter-open-47 = false
     3865     .
     3866     if flt-rec-47 <> ?
     3867       or sort-column-phrase > ""
     3868     then do:
     3869       define variable  parameter-2-47 as character no-undo .
     3870       define variable  parameter-3-47 as character no-undo .
     3871       define variable  parameter-4-47 as character no-undo .
     3872       define variable  parameter-5-47 as character no-undo .
     3873       define variable  parameter-6-47 as character no-undo .
     3874       define variable  parameter-7-47 as character no-undo .
     3875         assign
     3876         parameter-3-47 =
     3877                                 "FOR EACH X_point-io"
     3878         parameter-4-47 =
     3879           (
     3880             if (" X_point-io.point-type = p-type " + " " + where-phrase-47) <> ""
     3881             then  substitute(' X_point-io.point-type = &2&1&2 ', p-type, chr(34))  + " " + where-phrase-47
     3882             else "true"
     3883           )
     3884         parameter-5-47 = (" " + "" + " " + "")
     3885         parameter-6-47 = if sort-phrase-47 = ''
     3886                              then
     3887           (
     3888           " " + "  " +
     3889             " " + sort-column-phrase +
     3890           " " + "  "
     3891           )
     3892                              else
     3893           (
     3894           " " + "  " +
     3895             " " + sort-column-phrase +
     3896           " " + sort-phrase-47
     3897           )
     3898         parameter-7-47 =
     3899           " indexed-reposition  "
     3900       .
     3901       do
     3902       on stop undo, leave
     3903       on error undo, leave
     3904       :
     3905         assign
     3906           l-disable-where-47 =
     3907             (" X_point-io.point-type = p-type " + " " + where-phrase-47 = "")
     3908         .
     3909         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3910                             ,input QUERY br-pl:handle
     3911                             ,input parameter-3-47
     3912                             ,input parameter-4-47
     3913                             ,input parameter-5-47
     3914                             ,input parameter-6-47
     3915                             ,input parameter-7-47
     3916                             )
     3917         .
     3918         assign
     3919           l-filter-open-47 = true
     3920         .
     3921       end.
     3922       if l-filter-open-47 = false then do:
     3923         message
     3924           "Ошибка при фильтрации / сортировке" skip
     3925           "Будут показаны записи без учета фильтра" skip
     3926           view-as alert-box .
     3927       end.
     3928       else do:
     3929           assign
     3930             l-query-was-opened = true
     3931           .
     3932       end.
     3933     end.
     3934     if l-filter-open-47 = false then do:
     3935       OPEN QUERY br-pl FOR EACH X_point-io
     3936         where  X_point-io.point-type = p-type
     3937         indexed-reposition
     3938     .
     3939         assign
     3940           l-query-was-opened = true
     3941         .
     3942     end.
     3943     run waitfram-hide in this-procedure .
     3944       end.
     3945     end.
     3946   end.
     3947   if v-doc-rec <> ? then reposition br-pl to recid v-doc-rec no-error.
     3948   apply "entry" to br-pl in frame d-pl-list.
     3949   if avail X_point-io then APPLY "VALUE-CHANGED":U to br-pl.
     3950   run waitfram-hide in this-procedure .
     3951   apply "value-changed" to br-pl in frame d-pl-list.
     3952   END PROCEDURE.
     3953   PROCEDURE proc-b-print :
     3954   define variable v-doc-rec as recid no-undo .
     3955   define variable accum-count as integer.
     3956   define variable date_string     as      char    no-undo.
     3957   define variable Line            as      char    no-undo.
     3958   DEFINE VARIABLE v-cli-type AS CHARACTER NO-UNDO.
     3959   DEFINE FRAME point-io-list
     3960   X_point-io.point-type FORMAT "X(8)":U
     3961   X_point-io.db-num FORMAT ">>>>9":U
     3962   X_point-io.point-code FORMAT "9999999":U
     3963   v-cli-type column-label "Контрагент" format "X(12)"
     3964   X_point-io.point-name FORMAT "X(40)":U
     3965   X_point-io.status_ FORMAT "X(8)":U
     3966   HEADER  date_string AT 5 format "X(35)"
     3967    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     3968   Line format "X(195)" AT 1
     3969   with width 232 down stream-io use-text    .
     3970   Line = fill("-", 195).
     3971   date_string = cur-time-print() .
     3972   run prn-lib-open-stream  in this-procedure (
     3973                                                input parParentProc
     3974                                               ,input 43
     3975                                               ,input yes
     3976                                               ,input no
     3977                                               ).
     3978   PUT  STREAM PrnLibStream
     3979   SPACE(25) ( frame d-pl-list:title )
     3980   format "x(90)" SKIP(1) .
     3981   FORM HEADER
     3982   Line format "X(195)" AT 1 SKIP
     3983   "Продолжение - на следующей странице" AT 30 SKIP
     3984   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3985   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3986   FORM with FRAME point-io-list  .
     3987   run waitfram-show in this-procedure ("Ждите...").
     3988   v-doc-rec = recid(X_point-io).
     3989   DO WHILE available X_point-io :
     3990     GET prev br-pl.
     3991   END.
     3992   GET next br-pl.
     3993   DO WHILE available X_point-io :
     3994     Display STREAM PrnLibStream
     3995     X_point-io.point-type
     3996     X_point-io.db-num
     3997     X_point-io.point-code
     3998     X_point-io.cli-type + STRING(X_point-io.cli-code) @ v-cli-type
     3999     X_point-io.point-name
     4000     X_point-io.status_
     4001     with FRAME point-io-list .
     4002     DOWN STREAM PrnLibStream 1
     4003     with FRAME point-io-list  .
     4004     assign
     4005     accum-count = accum-count + 1
     4006     .
     4007     GET next br-pl.
     4008   END.
     4009   UNDERLINE  STREAM PrnLibStream
     4010   X_point-io.point-type
     4011   X_point-io.db-num
     4012   X_point-io.point-code
     4013   v-cli-type
     4014   X_point-io.point-name
     4015   X_point-io.status_
     4016   with FRAME point-io-list .
     4017   DISPLAY STREAM PrnLibStream
     4018   "ИТОГО" @ X_point-io.point-name
     4019   accum-count @ X_point-io.point-code
     4020   with frame point-io-list.
     4021   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4022   HIDE  STREAM PrnLibStream FRAME point-io-List.
     4023   output  STREAM PrnLibStream CLOSE.
     4024   REPOSITION br-pl to recid v-doc-rec no-error.
     4025   APPLY "entry" to br-pl.
     4026   run waitfram-hide in this-procedure .
     4027   run prn-lib-prn-file in this-procedure (
     4028                                             input parParentProc
     4029                                             ,input 8
     4030                                             ).
     4031   END PROCEDURE.
