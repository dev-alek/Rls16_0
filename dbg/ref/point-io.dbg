     2114         .
     2115       end.
     2116       else do:
     2117         return .
     2118       end.
     2119       assign
     2120         v-frame-width = frame d-pl-list :width
     2121         v-frame-virtual-width = frame d-pl-list :virtual-width
     2122         v-browse-width = v-diasize-browse-handle :width
     2123       .
