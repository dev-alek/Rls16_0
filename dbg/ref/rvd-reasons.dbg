        1   define variable vss-revision    as character no-undo init "$Revision$":u .
        2   define variable vss-author      as character no-undo init "$Author$":u .
        3   define variable vss-date        as character no-undo init "$Date$":u .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        5   define variable vss-archive     as character no-undo init "$Archive$":u .
        6   define variable vss-description as character no-undo init "Выбор причины установки РВД" .
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      111   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      112     define variable v-cntxt-db-num        as integer   no-undo .
      113     define variable v-cntxt-userid        as character no-undo .
      114     define variable v-cntxt-level         as character no-undo .
      115     define variable v-cntxt-host-code-obj as integer   no-undo .
      116     define variable v-cntxt-obj-type      as character no-undo .
      117     define variable v-cntxt-obj-code      as integer   no-undo .
      118     define variable v-cntxt-db-num-obj    as integer   no-undo .
      119     define variable v-cntxt-is-admin      as logical   no-undo .
      120   define input parameter parparentproc as widget-handle no-undo .
      121   define input parameter p-type as integer no-undo .
      122   define output parameter p-rvd-reason as character no-undo .
      123   define output parameter p-ITSM-num as character no-undo .
      124   define output parameter p-oper-fio as character no-undo .
      125   define buffer buf_ext-classif for ub.ext-classif .
      126   define buffer buf_user-account for ub.user-account .
      127   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      128        LABEL "Отмена"
      129        SIZE 15 BY 1
      130        BGCOLOR 8 .
      131   DEFINE BUTTON Btn_OK AUTO-GO
      132        LABEL "Ввод"
      133        SIZE 15 BY 1
      134        BGCOLOR 8 .
      135   DEFINE VARIABLE f-ITSM-num AS CHARACTER FORMAT "X(256)":U
      136        LABEL "Номер заявки в ITSM"
      137        VIEW-AS FILL-IN
      138        SIZE 50 BY 1 NO-UNDO.
      139   DEFINE VARIABLE f-oper-fio AS CHARACTER FORMAT "X(256)":U
      140        LABEL "ФИО инициатора заявки"
      141        VIEW-AS FILL-IN
      142        SIZE 50 BY 1 NO-UNDO.
      143   DEFINE VARIABLE f-inv-fio AS CHARACTER FORMAT "X(256)":U
      144        LABEL "ФИО сотрудника инвентаризационной комиссии"
      145        VIEW-AS FILL-IN
      146        SIZE 29 BY 1 NO-UNDO.
      147   DEFINE VARIABLE f-rvd-reason AS character FORMAT "X(64)":U INITIAL ""
      148        LABEL "Основание/причина разрешения РВД"
      149        VIEW-AS FILL-IN
      150        SIZE 15 BY 1 NO-UNDO.
      151   DEFINE VARIABLE v-reason-name AS CHARACTER FORMAT "X(256)":U
      152       VIEW-AS FILL-IN
      153       SIZE 20 BY 1 NO-UNDO.
      154   DEFINE BUTTON r-select-rvd-reason
      155        IMAGE-UP FILE "btn-down-arrow":U
      156        IMAGE-DOWN FILE "btn-down-arrow":U
      157        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      158        LABEL "r-sr-izm"
      159        SIZE 3 BY .88.
      160   DEFINE FRAME Dialog-Frame
      161        Btn_OK AT ROW 1.2 COL 2
      162        Btn_Cancel AT ROW 1.2 COL 17
      163        f-rvd-reason AT ROW 3 COL 41 COLON-ALIGNED WIDGET-ID 2
      164        v-reason-name at row 3 col 60 no-label
      165        r-select-rvd-reason at row 3 col 80
      166        f-ITSM-num AT ROW 4.5 COL 25 COLON-ALIGNED WIDGET-ID 4
      167        f-oper-fio AT ROW 6 COL 25 COLON-ALIGNED WIDGET-ID 6
      168        f-inv-fio AT ROW 6 COL 4 WIDGET-ID 6
      169        SPACE(2) SKIP(1)
      170       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      171            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      172            TITLE "Причины установки РВД"
      173            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
      174   ASSIGN
      175          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      176          FRAME Dialog-Frame:HIDDEN           = TRUE.
      177   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      178   DO:
      179     p-rvd-reason = ? .
      180     APPLY "END-ERROR":U TO SELF.
      181   END.
      182   ON choose of Btn_Cancel in FRAME Dialog-Frame
      183   DO:
      184     p-rvd-reason = ? .
      185   END.
      186   on F2 of frame Dialog-Frame anywhere do:
      187    return no-apply.
      188   end.
      189   ON choose of Btn_OK in FRAME Dialog-Frame
      190   DO:
      191     assign
      192       f-rvd-reason
      193       f-ITSM-num
      194       f-oper-fio
      195       f-inv-fio
      196     .
      197     if f-rvd-reason = "" or f-rvd-reason = ?
      198     then do :
      199       message 'Не заполнено поле "Основание/причина разрешения РВД". Все поля формы обязательны для заполнения. Для отказа установки разрешения РВД необходимо нажать "Отмена"'
      200       view-as alert-box .
      201       return no-apply .
      202     end .
      203     find first buf_ext-classif no-lock where buf_ext-classif.CharKey_One = f-rvd-reason
      204                                          and buf_ext-classif.classif-subject = 'rvd-reason':U
      205                                          and buf_ext-classif.classif-name = 'rvd-reason':U
      206                                          no-error .
      207     if not available buf_ext-classif
      208     then do :
      209       v-reason-name:screen-value = "" .
      210       message "Не заполнено основание для перехода на РВД" view-as alert-box .
      211       return no-apply .
      212     end .
      213     if trim(f-ITSM-num) = ""
      214     then do :
      215       if f-ITSM-num:label = "Номер приказа"
      216       then do :
      217         message 'Не заполнено поле "Номер приказа". Все поля формы обязательны для заполнения. Для отказа установки разрешения РВД необходимо нажать "Отмена"'
      218         view-as alert-box .
      219       end .
      220       else do :
      221         message 'Не заполнено поле "Номер заявки в ITSM". Все поля формы обязательны для заполнения. Для отказа установки разрешения РВД необходимо нажать "Отмена"'
      222         view-as alert-box .
      223       end .
      224       return no-apply .
      225     end .
      226     if f-oper-fio:visible
      227     and trim(f-oper-fio) = ""
      228     then do :
      229       message 'Не заполнено поле "ФИО инициатора заявки". Все поля формы обязательны для заполнения. Для отказа установки разрешения РВД необходимо нажать "Отмена"'
      230       view-as alert-box .
      231       return no-apply .
      232     end .
      233     if f-inv-fio:visible
      234     and trim(f-inv-fio) = ""
      235     then do :
      236       message 'Не заполнено поле "ФИО сотрудника инвентаризационной комиссии". Все поля формы обязательны для заполнения. Для отказа установки разрешения РВД необходимо нажать "Отмена"'
      237       view-as alert-box .
      238       return no-apply .
      239     end .
      240     assign
      241       p-rvd-reason  = f-rvd-reason
      242       p-ITSM-num    = f-ITSM-num
      243       p-oper-fio    = f-oper-fio
      244     .
      245     if f-inv-fio:visible then p-oper-fio = f-inv-fio .
      246   END.
      247   on leave OF f-rvd-reason IN FRAME Dialog-Frame
      248   DO:
      249     find first buf_ext-classif no-lock where buf_ext-classif.CharKey_One = f-rvd-reason:screen-value
      250                                          and buf_ext-classif.classif-subject = 'rvd-reason':U
      251                                          and buf_ext-classif.classif-name = 'rvd-reason':U
      252                                          no-error .
      253     if not available buf_ext-classif
      254     then do :
      255       v-reason-name:screen-value = "" .
      256     end .
      257     else do :
      258       if buf_ext-classif.Key#_Two <> 0
      259       then do :
      260         message "Выбранное основание для перехода на РВД предназначено НЕ для РГС!" view-as alert-box .
      261         f-rvd-reason:screen-value = "0" .
      262       end .
      263       else
      264       if buf_ext-classif.nonuniq = 1
      265       then do :
      266         message "Выбранное основание для перехода на РВД удалено!" view-as alert-box .
      267         f-rvd-reason:screen-value = "0" .
      268       end .
      269       else
      270         v-reason-name:screen-value = buf_ext-classif.CharKey_Two .
      271     end .
      272   END.
      273   on choose of r-select-rvd-reason IN FRAME Dialog-Frame
      274   do:
      275     define variable v-rec as character no-undo .
      276     run ref/rvd-reason.w (input parparentproc,
      277                           input "b-sel",
      278                           input 'текущие':U,
      279                           input p-type,
      280                           output v-rec ) .
      281     find first buf_ext-classif no-lock where recid(buf_ext-classif) = integer(v-rec) no-error .
      282     if not available buf_ext-classif
      283     then do :
      284       message "Не заполнено основание для перехода на РВД" view-as alert-box .
      285       return no-apply .
      286     end .
      287     v-reason-name:screen-value = buf_ext-classif.CharKey_Two .
      288     f-rvd-reason:screen-value = buf_ext-classif.CharKey_One .
      289   end .
      290   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      291   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      292   MAIN-BLOCK:
      293   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      294      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      295   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      296     run mainmenu_getcntxt in parparentproc
      297       (output v-cntxt-db-num
      298       ,output v-cntxt-userid
      299       ,output v-cntxt-level
      300       ,output v-cntxt-host-code-obj
      301       ,output v-cntxt-obj-type
      302       ,output v-cntxt-obj-code
      303       ,output v-cntxt-db-num-obj
      304       ,output v-cntxt-is-admin
      305       ) .
      306     f-inv-fio:visible = false .
      307     RUN enable_UI.
      308     if p-type = -1
      309     then do :
      310       p-type = 0 .
      311       f-ITSM-num:label = "Номер приказа" .
      312       hide f-oper-fio in FRAME Dialog-Frame.
      313       for first buf_user-account no-lock where buf_user-account.user-id = v-cntxt-userid :
      314         f-inv-fio = buf_user-account.last-name + " " + buf_user-account.first-name + " " + buf_user-account.second-name .
      315       end .
      316       DISPLAY f-ITSM-num f-inv-fio
      317         WITH FRAME Dialog-Frame.
      318       ENABLE f-inv-fio
      319         WITH FRAME Dialog-Frame.
      320     end .
      321     WAIT-FOR GO OF FRAME Dialog-Frame.
      322   END.
      323   RUN disable_UI.
      324   PROCEDURE disable_UI :
      325     HIDE FRAME Dialog-Frame.
      326   END PROCEDURE.
      327   PROCEDURE enable_UI :
      328     DISPLAY f-rvd-reason f-ITSM-num f-oper-fio r-select-rvd-reason
      329         WITH FRAME Dialog-Frame.
      330     ENABLE Btn_OK Btn_Cancel f-rvd-reason f-ITSM-num f-oper-fio r-select-rvd-reason
      331         WITH FRAME Dialog-Frame.
      332     VIEW FRAME Dialog-Frame.
      333   END PROCEDURE.
