     1497           or
     1498           ub.fin-doc.naznach-plat        <> p-naznach-plat
     1499           or
     1500           ub.fin-doc.ocher-pl            <> p-ocher-pl
     1501           or
     1502           ub.fin-doc.payer-bank-name     <> p-payer-bank-name
     1503           or
     1504           ub.fin-doc.payer-bank-city     <> p-payer-bank-city
     1505           or
     1506           ub.fin-doc.payer-bik           <> p-payer-bik
     1507           or
