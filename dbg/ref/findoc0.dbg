      411   procedure fd-attr-code :
      412     do
      413     on error undo, return error
      414     :
      415       define input  parameter p-code           as character no-undo .
      416       define output parameter p-type           as character no-undo .
      417       define output parameter p-format         as character no-undo .
      418       define output parameter p-label          as character no-undo .
      419       define output parameter p-user-can-edit  as logical   no-undo .
      420       define output parameter p-output-display as logical   no-undo .
      421       define output parameter p-other          as character no-undo .
      422       case p-code :
      423               when 'shift-date':U then do:     assign     p-label = "Дата смены"     p-type = 'T':U      p-format = "99/99/9999"     p-label = "Дата смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      424               when 'shift-num':U then do:     assign     p-label = "П.смены"     p-type = 'I':U      p-format = "99"     p-label = "П.смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      425               when 'shift-name':U then do:     assign     p-label = "№ смены"     p-type = 'C':U      p-format = "X(2)"     p-label = "№ смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      426               when 'barcode':U then do:     assign     p-label = "Штрих-код"     p-type = 'C':U      p-format = "X(20)"     p-label = "Штрих-код"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      427               when 'lockid':U then do:     assign     p-label = "ID блокировки чека"     p-type = 'C':U      p-format = "X(2)"     p-label = "ID блокировки чека"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      428               when 'cover_sheet':U then do:     assign     p-label = "Разбиение по номиналам"     p-type = 'C':U      p-format = "X(4000)"     p-label = "Разбиение по номиналам"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      429               when 'pre-vedom':U then do:     assign     p-label = "Атрибут для препроводительной ведомости"     p-type = 'C':U      p-format = "X(256)"     p-label = "Атрибут для препроводительной ведомости"     p-user-can-edit  = false     p-output-display = false     p-other = '':u      .   end.
      430               when 'contr-kb':U then do:     assign     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-type = 'I':U      p-format = ">>>9"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      431         otherwise do:
      432           undo, return error "неизвестный атрибут платежа" + " " + p-code .
      433         end.
      434       end.
      435     end.
      436   end procedure.
      437   procedure fd-attr-tooltip :
      438     do
      439     on error undo, return error
      440     :
      441       define input  parameter p-code    as character no-undo .
      442       define output parameter p-tooltip as character no-undo .
      443       define output parameter p-label   as character no-undo .
      444       case p-code :
      445               when 'shift-date':U then do:     assign     p-tooltip = "Дата смены"     p-label = "Дата смены" .   end.
      446               when 'shift-num':U then do:     assign     p-tooltip = "П.смены"     p-label = "П.смены" .   end.
      447               when 'shift-name':U then do:     assign     p-tooltip = "№ смены"     p-label = "№ смены" .   end.
      448               when 'barcode':U then do:     assign     p-tooltip = "Штрих-код"     p-label = "Штрих-код" .   end.
      449               when 'lockid':U then do:     assign     p-tooltip = "ID блокировки чека"     p-label = "ID блокировки чека" .   end.
      450               when 'cover_sheet':U then do:     assign     p-tooltip = "Разбиение по номиналам"     p-label = "Разбиение по номиналам" .   end.
      451               when 'pre-vedom':U then do:     assign     p-tooltip = "Атрибут для препроводительной ведомости"     p-label = "Атрибут для препроводительной ведомости" .   end.
      452               when 'contr-kb':U then do:     assign     p-tooltip = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами" .   end.
      453         otherwise do:
      454           undo, return error "неизвестный атрибут платежа" + " " + p-code .
      455         end.
      456       end.
      457     end.
      458   end procedure.
      459   procedure fin-doc-attr-write :
      460    do
      461    on error undo, return error return-value
      462    :
      463   define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      464   define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      465   define input parameter p-attr-code     like ub.fin-doc-attr.attr-code  no-undo .
      466   define input parameter p-attr-value    like ub.fin-doc-attr.attr-value no-undo .
      467   define variable  v-format         as character no-undo .
      468   define variable  v-label          as character no-undo .
      469   define variable  v-user-can-edit  as logical   no-undo .
      470   define variable  v-output-display as logical   no-undo .
      471   define variable  v-other          as character no-undo .
      472   define variable  v-type           as character no-undo .
      473   define buffer buf_fin-doc-attr for ub.fin-doc-attr.
      474   run fd-attr-code in this-procedure
      475                                     (input  p-attr-code
      476                                     ,output v-type
      477                                     ,output v-format
      478                                     ,output v-label
      479                                     ,output v-user-can-edit
      480                                     ,output v-output-display
      481                                     ,output v-other
      482                                     ) no-error .
      483   if error-status :error then do:
      484     undo, return error return-value .
      485   end.
      486   find first buf_fin-doc-attr  exclusive-lock  where
      487             buf_fin-doc-attr.attr-code    = p-attr-code
      488         AND buf_fin-doc-attr.host-code    = p-host-code
      489         AND buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code  no-error .
      490     if not available  buf_fin-doc-attr then do:
      491         create buf_fin-doc-attr.
      492         assign
      493         buf_fin-doc-attr.attr-code    = p-attr-code
      494         buf_fin-doc-attr.attr-value   = p-attr-value
      495         buf_fin-doc-attr.host-code    = p-host-code
      496         buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code
      497         .
      498     end.
      499     else do:
      500          assign
      501          buf_fin-doc-attr.attr-value = p-attr-value.
      502     end.
      503    end.
      504   end procedure.
      505   procedure fd-attr-exist :
      506     do
      507     on error undo, return error
      508     :
      509       define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      510       define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      511       define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
      512       define output parameter p-exist   as logical  no-undo .
      513       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
      514       define variable  v-type           as character no-undo .
      515       define variable  v-format         as character no-undo .
      516       define variable  v-label          as character no-undo .
      517       define variable  v-user-can-edit  as logical   no-undo .
      518       define variable  v-output-display as logical   no-undo .
      519       define variable  v-other          as character no-undo .
      520       run fd-attr-code in this-procedure
      521         (input  p-code
      522         ,output v-type
      523         ,output v-format
      524         ,output v-label
      525         ,output v-user-can-edit
      526         ,output v-output-display
      527         ,output v-other
      528         ) no-error .
      529       if error-status :error then do:
      530         undo, return error return-value .
      531       end.
      532       find first buf_fin-doc-attr exclusive-lock
      533         where buf_fin-doc-attr.host-code  = p-host-code
      534           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
      535           and buf_fin-doc-attr.attr-code = p-code
      536         no-error .
      537       if  available buf_fin-doc-attr then do:
      538         p-exist = yes.
      539       end.
      540     end.
      541   end procedure.
      542   procedure fd-attr-delete :
      543     do
      544     on error undo, return error
      545     :
      546     define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      547     define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      548     define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
      549     define output parameter p-deleted  as logical no-undo.
      550       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
      551       define variable  v-type           as character no-undo .
      552       define variable  v-format         as character no-undo .
      553       define variable  v-label          as character no-undo .
      554       define variable  v-user-can-edit  as logical   no-undo .
      555       define variable  v-output-display as logical   no-undo .
      556       define variable  v-other          as character no-undo .
      557       run fd-attr-code in this-procedure
      558         (input  p-code
      559         ,output v-type
      560         ,output v-format
      561         ,output v-label
      562         ,output v-user-can-edit
      563         ,output v-output-display
      564         ,output v-other
      565         ) no-error .
      566       if error-status :error then do:
      567         undo, return error return-value .
      568       end.
      569       find first buf_fin-doc-attr exclusive-lock
      570         where buf_fin-doc-attr.host-code  = p-host-code
      571           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
      572           and buf_fin-doc-attr.attr-code = p-code
      573         no-error NO-WAIT.
      574       if not available buf_fin-doc-attr then do:
      575         p-deleted = no.
      576       end.
      577       else do:
      578         delete buf_fin-doc-attr no-error .
      579         if error-status:error then do:
      580           undo, return error return-value .
      581         end.
      582         p-deleted = yes.
      583       end.
      584     end.
      585   end procedure.
      586   procedure fin-doc-attr-value :
      587    do
      588    on error undo, return error return-value
      589    :
      590   define input  parameter p-host-code    like ub.fin-doc-attr.host-code    no-undo .
      591   define input  parameter p-fin-doc-code like ub.fin-doc-attr.fin-doc-code     no-undo .
      592   define input  parameter p-attr-code    like ub.fin-doc-attr.attr-code    no-undo .
      593   define output parameter p-attr-value   like ub.fin-doc-attr.attr-value   no-undo .
      594   define variable  v-format         as character no-undo .
      595   define variable  v-label          as character no-undo .
      596   define variable  v-user-can-edit  as logical   no-undo .
      597   define variable  v-output-display as logical   no-undo .
      598   define variable  v-other          as character no-undo .
      599   define variable  v-type           as character no-undo .
      600   define buffer buf_fin-doc-attr for ub.fin-doc-attr.
      601   run fd-attr-code in this-procedure
      602     (input  p-attr-code
      603     ,output v-type
      604     ,output v-format
      605     ,output v-label
      606     ,output v-user-can-edit
      607     ,output v-output-display
      608     ,output v-other
      609     ) no-error .
      610   if error-status :error then do:
      611     undo, return error return-value .
      612   end.
      613   find first buf_fin-doc-attr no-lock where
      614             buf_fin-doc-attr.attr-code    = p-attr-code
      615         AND buf_fin-doc-attr.host-code     = p-host-code
      616         AND buf_fin-doc-attr.fin-doc-code = p-fin-doc-code      no-error .
      617     if available  buf_fin-doc-attr then do:
      618       assign
      619       p-attr-value = buf_fin-doc-attr.attr-value
      620       .
      621     end.
      622     else do:
      623       p-attr-value = ? .
      624     end.
      625    end.
      626   end procedure.
      627   procedure fd-attr-news :
      628     do
      629     on error undo, return error
      630     :
      631       define input  parameter p-code           as character no-undo .
      632       define output parameter p-news           as logical   no-undo .
      633       case p-code :
      634               when 'shift-date':U then do:     assign     p-news = no.   end.
      635               when 'shift-num':U then do:     assign     p-news = no.   end.
      636               when 'shift-name':U then do:     assign     p-news = no.   end.
      637               when 'barcode':U then do:     assign     p-news = no.   end.
      638               when 'lockid':U then do:     assign     p-news = no.   end.
      639               when 'cover_sheet':U then do:     assign     p-news = no.   end.
      640               when 'pre-vedom':U then do:     assign     p-news = no.   end.
      641         otherwise do:
      642           undo, return error "неизвестный атрибут платежа " + " " + p-code .
      643         end.
      644       end.
      645     end.
      646   end procedure.
      647   procedure c-fin-doc-attr-write :
      648    do
      649    on error undo, return error return-value
      650    :
      651   define input parameter p-host-code     like ub.c-fin-doc-attr.host-code  no-undo .
      652   define input parameter p-fin-doc-code  like ub.c-fin-doc-attr.fin-doc-code   no-undo .
      653   define input parameter p-corr-user-db-num  like ub.c-fin-doc-attr.corr-user-db-num   no-undo .
      654   define input parameter p-chip-num      like ub.c-fin-doc-attr.chip-num   no-undo .
      655   define input parameter p-attr-code     like ub.c-fin-doc-attr.attr-code  no-undo .
      656   define input parameter p-attr-value    like ub.c-fin-doc-attr.attr-value no-undo .
      657   define variable  v-format         as character no-undo .
      658   define variable  v-label          as character no-undo .
      659   define variable  v-user-can-edit  as logical   no-undo .
      660   define variable  v-output-display as logical   no-undo .
      661   define variable  v-other          as character no-undo .
      662   define variable  v-type           as character no-undo .
      663   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
      664   run fd-attr-code in this-procedure
      665                                     (input  p-attr-code
      666                                     ,output v-type
      667                                     ,output v-format
      668                                     ,output v-label
      669                                     ,output v-user-can-edit
      670                                     ,output v-output-display
      671                                     ,output v-other
      672                                     ) no-error .
      673   if error-status :error then do:
      674     undo, return error return-value .
      675   end.
      676   find first buf_c-fin-doc-attr  exclusive-lock  where
      677             buf_c-fin-doc-attr.attr-code    = p-attr-code
      678         AND buf_c-fin-doc-attr.host-code    = p-host-code
      679         AND buf_c-fin-doc-attr.fin-doc-code     = p-fin-doc-code
      680         AND buf_c-fin-doc-attr.corr-user-db-num = p-corr-user-db-num
      681         AND buf_c-fin-doc-attr.chip-num         = p-chip-num      no-error .
      682     if not available  buf_c-fin-doc-attr then do:
      683         create buf_c-fin-doc-attr.
      684         assign
      685         buf_c-fin-doc-attr.attr-code    = p-attr-code
