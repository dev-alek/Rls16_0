     1514           ub.fin-doc.payer-kpp           <> p-payer-kpp
     1515           or
     1516           ub.fin-doc.payer-name          <> p-payer-name
     1517           or
     1518           ub.fin-doc.payer-okpo          <> p-payer-okpo
     1519           or
     1520           ub.fin-doc.payer-passport   <> p-payer-passport
     1521           or
     1522           ub.fin-doc.payer-r-schet       <> p-payer-r-schet
     1523           or
     1524           ub.fin-doc.receiver-bank-name  <> p-receiver-bank-name
     1525           or
     1526           ub.fin-doc.receiver-bank-city  <> p-receiver-bank-city
     1527           or
     1528           ub.fin-doc.receiver-bik        <> p-receiver-bik
     1529           or
     1530           ub.fin-doc.receiver-c-schet    <> p-receiver-c-schet
     1531           or
     1532           ub.fin-doc.receiver-code-schet <> p-receiver-code-schet
     1533           or
     1534           ub.fin-doc.receiver-inn        <> p-receiver-inn
     1535           or
     1536           ub.fin-doc.receiver-kpp        <> p-receiver-kpp
     1537           or
     1538           ub.fin-doc.receiver-name       <> p-receiver-name
     1539           or
     1540           ub.fin-doc.receiver-okpo       <> p-receiver-okpo
     1541           or
     1542           ub.fin-doc.receiver-passport   <> p-receiver-passport
     1543           or
     1544           ub.fin-doc.receiver-r-schet    <> p-receiver-r-schet
     1545           or
     1546           ub.fin-doc.payer-sign1         <> p-payer-sign1
     1547           or
     1548           ub.fin-doc.payer-sign2         <> p-payer-sign2
     1549           or
     1550           ub.fin-doc.payer-sign3         <> p-payer-sign3
     1551           or
     1552           ub.fin-doc.receiver-sign1         <> p-receiver-sign1
     1553           or
     1554           ub.fin-doc.receiver-sign2         <> p-receiver-sign2
     1555           or
     1556           ub.fin-doc.receiver-sign3         <> p-receiver-sign3
     1557           or
     1558           ub.fin-doc.srok-pl             <> p-srok-pl
     1559           or
     1560           ub.fin-doc.stat-pl             <> p-stat-pl
     1561           or
     1562           ub.fin-doc.str-podr-code       <> p-str-podr-code
     1563           or
     1564           ub.fin-doc.str-podr-type       <> p-str-podr-type
     1565           or
     1566           ub.fin-doc.str-podr-name       <> p-str-podr-name
     1567           or
     1568           ub.fin-doc.sum-base            <> p-sum-base
     1569           or
     1570           ub.fin-doc.sum-doc             <> p-sum-doc
     1571           or
     1572           ub.fin-doc.sum-rubl            <> p-sum-rubl
     1573           or
     1574           ub.fin-doc.vid-opl             <> p-vid-opl
     1575           or
     1576           ub.fin-doc.vid-plat            <> p-vid-plat
     1577           or
     1578           not (ub.fin-doc.obj-type       = p-obj-type
     1579                and
     1580                ub.fin-doc.obj-code       = p-obj-code
     1581                and
     1582                (ub.fin-doc.shift-flag = integer('1':U)
     1583                 or
     1584                 not v-flag-shift
     1585                )
     1586                )
     1587           then do:
     1588             run err-mess in this-procedure (substitute("Для ПЛАТЕЖА в статусе не &1&2" +
     1589                                     "можно менять только примечания, коды аналитического учета, объект(для несменных платежей) и НОМЕР&2"
     1590                                     ,'новый':U
     1591                                     , chr(10))
     1592                           , output v-ret-mess).
     1593             undo, return error (if p-silent = no then  '':U  else v-ret-mess).
     1594           end.
     1595         end.
     1596         if
     1597         ub.fin-doc.sum-doc             <> p-sum-doc
     1598         or
     1599         ub.fin-doc.curr-code           <> p-curr-code
     1600         or
     1601         ub.fin-doc.payer-type          <> p-payer-type
     1602         or
     1603         ub.fin-doc.payer-code          <> p-payer-code
     1604         or
     1605         ub.fin-doc.receiver-code       <> p-receiver-code
     1606         or
     1607         ub.fin-doc.receiver-type       <> p-receiver-type
     1608         then do:
     1609           if v-author = '':U then do:
     1610             run err-mess in this-procedure (substitute("Для ПЛАТЕЖА в статусе не &1&2" +
     1611                                     "можно менять только примечания, коды аналитического учета, объект и НОМЕР&2"
     1612                                     ,'новый':U
     1613                                     , chr(10))
     1614                           , output v-ret-mess).
     1615             undo, return error (if p-silent = no then  '':U  else v-ret-mess).
     1616           end.
     1617           if v-author <> '' then do:
     1618             run err-mess in this-procedure (substitute("Для ПЛАТЕЖА в статусе не &1&2" +
     1619                                     "НЕЛЬЗЯ менять сумму платежа, валюту платежа, ПЛАТЕЛЬЩИКА и ПОЛУЧАТЕЛЯ&2"
     1620                                     ,'новый':U
     1621                                     , chr(10))
     1622                           , output v-ret-mess).
     1623             undo, return error (if p-silent = no then  '':U  else v-ret-mess).
     1624           end.
     1625         end.
     1626       end.
     1627     end.
     1628     assign
     1629     ub.fin-doc.an-uchet-code       = p-an-uchet-code
     1630     ub.fin-doc.an-uchet-value      = (if p-an-uchet-code <> 0 then p-an-uchet-value else "":U)
     1631     ub.fin-doc.base-rate           = p-base-rate
     1632     ub.fin-doc.base-scale          = p-base-scale
     1633     ub.fin-doc.cel-nazn-code       = p-cel-nazn-code
     1634     ub.fin-doc.cel-nazn-value      = (if p-cel-nazn-code <> 0 then p-cel-nazn-value else "":U)
     1635     ub.fin-doc.contract-code       = p-contract-code
     1636     ub.fin-doc.contract-curr       = p-contract-curr
     1637     ub.fin-doc.contract-rate       = p-contract-rate
     1638     ub.fin-doc.contract-scale      = p-contract-scale
     1639     ub.fin-doc.cor-acc             = p-cor-acc
     1640     ub.fin-doc.cor-acc-value       = (if p-cor-acc <> 0 then p-cor-acc-value else "":U)
     1641     ub.fin-doc.cor-acc1            = p-cor-acc1
     1642     ub.fin-doc.cor-acc1-value      = (if p-cor-acc1 <> 0 then p-cor-acc1-value else "":U)
     1643     ub.fin-doc.curr-code           = p-curr-code
     1644     ub.fin-doc.doc-date            = p-doc-date
     1645     ub.fin-doc.enclosure           = p-enclosure
     1646     ub.fin-doc.exch-rate           = p-exch-rate
     1647     ub.fin-doc.exch-scale          = p-exch-scale
     1648     ub.fin-doc.f104                = p-f104
     1649     ub.fin-doc.f105                = p-f105
     1650     ub.fin-doc.f106                = p-f106
     1651     ub.fin-doc.f107                = p-f107
     1652     ub.fin-doc.f108                = p-f108
     1653     ub.fin-doc.f109                = p-f109
     1654     ub.fin-doc.f110                = p-f110
     1655     ub.fin-doc.f22                 = p-f22
     1656     ub.fin-doc.f23                 = p-f23
     1657     ub.fin-doc.fin-doc-type        = p-fin-doc-type
     1658     ub.fin-doc.fin-ext-doc-type    = p-fin-ext-doc-type
     1659     ub.fin-doc.in-doc-code         = p-in-doc-code
     1660     ub.fin-doc.in-host-code        = p-in-host-code
     1661     ub.fin-doc.including           = p-including
     1662     ub.fin-doc.nazn-pl             = p-nazn-pl
     1663     ub.fin-doc.naznach-plat        = p-naznach-plat
     1664     ub.fin-doc.obj-type            = p-obj-type
     1665     ub.fin-doc.obj-code            = p-obj-code
     1666     ub.fin-doc.ocher-pl            = p-ocher-pl
     1667     ub.fin-doc.out-doc-code        = p-out-doc-code
     1668     ub.fin-doc.out-host-code       = p-out-host-code
     1669     ub.fin-doc.payer-bank-name     = p-payer-bank-name
     1670     ub.fin-doc.payer-bank-city     = p-payer-bank-city
     1671     ub.fin-doc.payer-bik           = p-payer-bik
     1672     ub.fin-doc.payer-c-schet       = p-payer-c-schet
     1673     ub.fin-doc.payer-code          = p-payer-code
     1674     ub.fin-doc.payer-code-schet    = p-payer-code-schet
     1675     ub.fin-doc.payer-inn           = p-payer-inn
     1676     ub.fin-doc.payer-kpp           = p-payer-kpp
     1677     ub.fin-doc.payer-name          = p-payer-name
     1678     ub.fin-doc.payer-okpo          = p-payer-okpo
     1679     ub.fin-doc.payer-dop1          = p-payer-dop1
     1680     ub.fin-doc.payer-dop2          = p-payer-dop2
     1681     ub.fin-doc.payer-passport      = p-payer-passport
     1682     ub.fin-doc.payer-r-schet       = p-payer-r-schet
     1683     ub.fin-doc.payer-type          = p-payer-type
     1684     ub.fin-doc.prn-doc-code        = p-prn-doc-code
     1685     ub.fin-doc.PS                  = p-PS
     1686     ub.fin-doc.receiver-bank-name  = p-receiver-bank-name
     1687     ub.fin-doc.receiver-bank-city  = p-receiver-bank-city
     1688     ub.fin-doc.receiver-bik        = p-receiver-bik
     1689     ub.fin-doc.receiver-c-schet    = p-receiver-c-schet
     1690     ub.fin-doc.receiver-code       = p-receiver-code
     1691     ub.fin-doc.receiver-code-schet = p-receiver-code-schet
     1692     ub.fin-doc.receiver-inn        = p-receiver-inn
     1693     ub.fin-doc.receiver-kpp        = p-receiver-kpp
     1694     ub.fin-doc.receiver-name       = p-receiver-name
     1695     ub.fin-doc.receiver-okpo       = p-receiver-okpo
     1696     ub.fin-doc.receiver-dop1       = p-receiver-dop1
     1697     ub.fin-doc.receiver-dop2       = p-receiver-dop2
     1698     ub.fin-doc.receiver-passport   = p-receiver-passport
     1699     ub.fin-doc.receiver-r-schet    = p-receiver-r-schet
     1700     ub.fin-doc.receiver-type       = p-receiver-type
     1701     ub.fin-doc.payer-sign1         = p-payer-sign1
     1702     ub.fin-doc.payer-sign2         = p-payer-sign2
     1703     ub.fin-doc.payer-sign3         = p-payer-sign3
     1704     ub.fin-doc.receiver-sign1      = p-receiver-sign1
     1705     ub.fin-doc.receiver-sign2      = p-receiver-sign2
     1706     ub.fin-doc.receiver-sign3      = p-receiver-sign3
     1707     ub.fin-doc.srok-pl             = p-srok-pl
     1708     ub.fin-doc.stat-pl             = p-stat-pl
     1709     ub.fin-doc.str-podr-code       = p-str-podr-code
     1710     ub.fin-doc.str-podr-type       = p-str-podr-type
     1711     ub.fin-doc.str-podr-name       = p-str-podr-name
     1712     ub.fin-doc.sum-base            = p-sum-base
     1713     ub.fin-doc.sum-doc             = p-sum-doc
     1714     ub.fin-doc.sum-rubl            = p-sum-rubl
     1715     ub.fin-doc.sum-contr           = p-sum-contr
     1716     ub.fin-doc.trn-doc-code        = v-cash-book-place
     1717     ub.fin-doc.vid-opl             = p-vid-opl
     1718     ub.fin-doc.vid-plat            = p-vid-plat
     1719     ub.fin-doc.user-db-num-doc     = g#db-num
     1720     ub.fin-doc.user-name-doc       = g#userid
     1721     ub.fin-doc.CashBookId          = p-cashbookid
     1722     ub.fin-doc.doc-author          = (if v-author = '':U
     1723                                       and p-doc-author <> 'manual':U
     1724                                       then ub.fin-doc.doc-author
     1725                                       else p-doc-author
     1726                                       )
     1727     ub.fin-doc.shift-flag =  (if l-shift-on
     1728                                     and lookup(ub.fin-doc.fin-ext-doc-type, 'пко,рко':U) > 0
     1729                                     and (ub.fin-doc.doc-author = 'manual':U or ub.fin-doc.doc-author = 'auto':U)
     1730                                     then integer('1':U)
     1731                                     else 0)
     1732     ub.fin-doc.shift-date  = p-shift-date
     1733     ub.fin-doc.shift-num   = p-shift-num
     1734     ub.fin-doc.shift-name  = p-shift-name
     1735     .
     1736     if ub.fin-doc.con-stat > 0 then do:
     1737       if ub.fin-doc.con-stat = 1 then do:
     1738         if ub.fin-doc.sum-contr <= ub.fin-doc.con-sum-contr then assign ub.fin-doc.con-stat = 2 .
     1739       end.
     1740       else do:
     1741         if ub.fin-doc.sum-contr > ub.fin-doc.con-sum-contr then assign ub.fin-doc.con-stat = 1 .
     1742       end.
     1743     end.
     1744     if available buf_contract then do:
     1745       if (buf_contract.gen-factur = 3 or
     1746           buf_contract.gen-factur = 13 or
     1747           buf_contract.gen-factur = 103 or
     1748           buf_contract.gen-factur = 113) then
     1749         assign  ub.fin-doc.need-factur = 1 .
     1750     end.
     1751     release ub.fin-doc no-error.
     1752     if error-status:error then do:
     1753      run err-mess in this-procedure (substitute("Ошибка при сохранении записи ПЛАТЕЖА &1: &2", ERROR-STATUS:GET-message(1), return-value ), output v-ret-mess).
     1754       undo, return error (if p-silent = no then  "":U  else v-ret-mess).
     1755     end.
     1756     if not (p-mode = 'ИЗМЕНЕНИЕ':U
     1757            and
     1758            v-author <> '') then do:
     1759       for each ub.fin-doc-tax where
     1760               ub.fin-doc-tax.host-code = p-host-code
     1761           AND ub.fin-doc-tax.fin-doc-code = p-fin-doc-code:
     1762         find first tt0-fin-doc-tax no-lock where
     1763                   tt0-fin-doc-tax.host-code = p-host-code
     1764               AND tt0-fin-doc-tax.fin-doc-code = p-fin-doc-code
     1765               AND tt0-fin-doc-tax.line-num = ub.fin-doc-tax.line-num no-error .
     1766         if not available tt0-fin-doc-tax then do:
     1767           delete ub.fin-doc-tax.
     1768         end.
     1769       end.
     1770     for each tt0-fin-doc-tax :
     1771         find first ub.fin-doc-tax where
     1772                   ub.fin-doc-tax.host-code = p-host-code
     1773               AND ub.fin-doc-tax.fin-doc-code = p-fin-doc-code
     1774               AND ub.fin-doc-tax.line-num   = tt0-fin-doc-tax.line-num
     1775               no-error .
     1776         if not available ub.fin-doc-tax then do:
     1777           create ub.fin-doc-tax.
     1778           assign
     1779           ub.fin-doc-tax.host-code = p-host-code
     1780           ub.fin-doc-tax.fin-doc-code = p-fin-doc-code
     1781           ub.fin-doc-tax.line-num = tt0-fin-doc-tax.line-num
     1782           .
     1783         end.
     1784         buffer-copy tt0-fin-doc-tax except host-code fin-doc-code line-num
     1785         to ub.fin-doc-tax.
     1786         run recalc-tax in this-procedure (buffer ub.fin-doc-tax
     1787                                         , p-curr-code
     1788                                         , p-contract-curr
     1789                                         , p-base-rate
     1790                                         , p-base-scale
     1791                                         , p-exch-rate
     1792                                         , p-exch-scale
     1793                                         , p-contract-rate
     1794                                         , p-contract-scale
     1795                                         ).
     1796       end.
     1797       for each tt0-fin-doc-attr :
     1798         find first ub.fin-doc-attr where
     1799                   ub.fin-doc-attr.host-code = p-host-code
     1800               AND ub.fin-doc-attr.fin-doc-code = p-fin-doc-code
     1801               AND ub.fin-doc-attr.attr-code   = tt0-fin-doc-attr.attr-code
     1802               no-error .
     1803         if not available ub.fin-doc-attr then do:
     1804           create ub.fin-doc-attr.
     1805         end.
     1806         buffer-copy tt0-fin-doc-attr to ub.fin-doc-attr.
     1807       end.
     1808       define variable v-cmp as logical no-undo .
     1809       if  p-save-payment then do:
     1810         for each ub.payment where
     1811                 ub.payment.host-code = p-host-code
     1812             AND ub.payment.source-type = 'платеж':U
     1813             and ub.payment.source-ref = string(p-fin-doc-code)
     1814       on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1815       on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1816       on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1817       :
     1818           find first tt0-payment no-lock where
     1819                     tt0-payment.host-code = p-host-code
     1820                 AND tt0-payment.source-type = ub.payment.source-type
     1821                 AND tt0-payment.source-ref = ub.payment.source-ref
     1822                 and tt0-payment.d-card = ub.payment.d-card  no-error .
     1823           if not available tt0-payment then do:
     1824             delete ub.payment no-error.
     1825             if error-status:error then do:
     1826               run err-mess in this-procedure (substitute("Ошибка при удалении привязки платежа к ДК &4&1&2&1&3"
     1827                                       ,chr(10)
     1828                                       , error-status:get-message(1)
     1829                                       , return-value
     1830                                       , tt0-payment.d-card
     1831                                       )
     1832                             , output v-ret-mess).
     1833               undo, return error (if p-silent = no then  '':U  else v-ret-mess).
     1834             end.
     1835           end.
     1836         end.
     1837         for each tt0-payment
     1838         on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1839         on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1840         on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1841         :
     1842           v-cmp = yes.
     1843           find first ub.payment where
     1844                     ub.payment.host-code = p-host-code
     1845                 AND ub.payment.source-type = 'платеж':U
     1846                 AND ub.payment.source-ref = string(p-fin-doc-code)
     1847                 and ub.payment.d-card = tt0-payment.d-card
     1848                 no-error .
     1849           if not available ub.payment then do:
     1850             if v-pmnt-code = '':U then do:
     1851               find first buf0_payment no-lock where buf0_payment.host-code = p-host-code
     1852                   AND buf0_payment.source-type = 'платеж':U
     1853                   AND buf0_payment.source-ref = string(p-fin-doc-code) no-error.
     1854             if available buf0_payment then do:
     1855               assign
     1856               v-pmnt-code = entry(1, buf0_payment.pmnt-code, "_").
     1857             end.
     1858             end.
     1859             assign
     1860             v-full-pmnt-code  = substitute("&1_&2", v-pmnt-code, entry(2, tt0-payment.pmnt-code, "_"))
     1861             tt0-payment.pmnt-code = v-full-pmnt-code
     1862             .
     1863             v-cmp = no.
     1864           end.
     1865           else do:
     1866             buffer-compare tt0-payment
     1867             except pmnt-code to ub.payment
     1868             case-sensitive
     1869             save result in v-cmp.
     1870           end.
     1871           if not v-cmp then do:
     1872             run ref/payment1.p (
     1873                                   input (if available ub.payment then 'ИЗМЕНЕНИЕ':U else 'ДОБАВЛЕНИЕ':U)
     1874                                 ,input p-silent
     1875                                 ,input-output tt0-payment.pmnt-code
     1876                                 ,input tt0-payment.cli-type
     1877                                 ,input tt0-payment.cli-code
     1878                                 ,input p-payer-type
     1879                                 ,input p-payer-code
     1880                                 ,input tt0-payment.host-code
     1881                                 ,input tt0-payment.tot-cli
     1882                                 ,input (tt0-payment.tot-cli * p-exch-rate / p-exch-scale) /  (p-base-rate / p-base-scale)
     1883                                 ,input (tt0-payment.tot-cli * p-exch-rate / p-exch-scale)
     1884                                 ,input p-doc-date
     1885                                 ,input p-curr-code
     1886                                 ,input tt0-payment.exch-rate
     1887                                 ,input tt0-payment.exch-scale
     1888                                 ,input tt0-payment.base-rate
     1889                                 ,input tt0-payment.base-scale
     1890                                 ,input p-pay-date
     1891                                 ,input ?
     1892                                 ,input tt0-payment.source-type
     1893                                 ,input tt0-payment.source-ref
     1894                                 ,input tt0-payment.d-card
     1895                                 ,input tt0-payment.pay-code
     1896                                 ,input 'ожид':U
     1897                                 ,input tt0-payment.PS
     1898                                 ,INPUT g#userid
     1899                                 ,INPUT '':U
     1900                                 ) no-error .
     1901             if error-status:error then do:
     1902               run err-mess in this-procedure (substitute("Ошибка при создании привязки платежа к ДК &4&1&2&1&3"
     1903                                       ,chr(10)
     1904                                       , error-status:get-message(1)
     1905                                       , return-value
     1906                                       , tt0-payment.d-card
     1907                                       )
     1908                             , output v-ret-mess).
     1909               undo, return error (if p-silent = no then  '':U  else v-ret-mess).
     1910             end.
     1911           end.
     1912         end.
     1913       end.
     1914     end.
     1915   end.
     1916   PROCEDURE err-mess:
     1917     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
     1918     define output parameter p-ret-mess as character no-undo .
     1919     assign
     1920     p-ret-mess =  substitute("ПЛАТЕЖ &1: фирма: &2 N: &3,&4 вн. № &5&4&6"
     1921                               , p-fin-doc-type
     1922                               , p-host-code
     1923                               , p-prn-doc-code
     1924                               , chr(10)
     1925                               , p-fin-doc-code
     1926                               , p-mess
     1927                               ).
     1928     CASE p-silent:
     1929       when yes then do:
     1930         p-ret-mess = substitute("ПЛАТЕЖ &1: фирма: &2 N: &3 Вн № &4&5&6"
     1931                                 , p-fin-doc-type
     1932                                 , p-host-code
     1933                                 , p-prn-doc-code
     1934                                 , p-fin-doc-code
     1935                                 , chr(10)
     1936                                 , p-mess
     1937                                 ).
     1938       end.
     1939       when no then do:
     1940         message
     1941         p-mess
     1942         view-as alert-box error .
     1943       end.
     1944     end.
     1945   END PROCEDURE.
     1946   procedure recalc-tax :
     1947   define parameter buffer buf_fin-doc-tax for ub.fin-doc-tax.
     1948   define input parameter p-curr-code like ub.fin-doc.curr-code no-undo .
     1949   define input parameter p-contract-curr like ub.fin-doc.contract-curr no-undo .
     1950   define input parameter p-base-rate like ub.fin-doc.base-rate no-undo .
     1951   define input parameter p-base-scale like ub.fin-doc.base-scale no-undo .
     1952   define input parameter p-exch-rate like ub.fin-doc.exch-rate no-undo .
     1953   define input parameter p-exch-scale like ub.fin-doc.exch-scale no-undo .
     1954   define input parameter p-contract-rate like ub.fin-doc.contract-rate no-undo .
     1955   define input parameter p-contract-scale like ub.fin-doc.contract-scale no-undo .
     1956     do
     1957     on error undo, return error
     1958     :
     1959       CASE p-curr-code:
     1960         when 0 then do:
     1961           assign
     1962           buf_fin-doc-tax.sum-line-rubl = buf_fin-doc-tax.sum-line-doc
     1963           buf_fin-doc-tax.sum-line-base = buf_fin-doc-tax.sum-line-doc / p-base-rate * p-base-scale
     1964           buf_fin-doc-tax.sum-slt-line-rubl = buf_fin-doc-tax.sum-slt-line-doc
     1965           buf_fin-doc-tax.sum-slt-line-base = buf_fin-doc-tax.sum-slt-line-doc / p-base-rate * p-base-scale
     1966           buf_fin-doc-tax.sum-vat-line-rubl = buf_fin-doc-tax.sum-vat-line-doc
     1967           buf_fin-doc-tax.sum-vat-line-base = buf_fin-doc-tax.sum-vat-line-doc / p-base-rate * p-base-scale
     1968           .
     1969         end.
     1970         when v-base-code then do:
     1971           assign
     1972           buf_fin-doc-tax.sum-line-base = buf_fin-doc-tax.sum-line-doc
     1973           buf_fin-doc-tax.sum-line-rubl = buf_fin-doc-tax.sum-line-doc * p-base-rate / p-base-scale
     1974           buf_fin-doc-tax.sum-slt-line-base = buf_fin-doc-tax.sum-slt-line-doc
     1975           buf_fin-doc-tax.sum-slt-line-rubl = buf_fin-doc-tax.sum-slt-line-doc * p-base-rate / p-base-scale
     1976           buf_fin-doc-tax.sum-vat-line-base = buf_fin-doc-tax.sum-vat-line-doc
     1977           buf_fin-doc-tax.sum-vat-line-rubl = buf_fin-doc-tax.sum-vat-line-doc * p-base-rate / p-base-scale
     1978           .
     1979         end.
     1980         otherwise do:
     1981           assign
     1982           buf_fin-doc-tax.sum-line-rubl = buf_fin-doc-tax.sum-line-doc * p-exch-rate / p-exch-scale
     1983           buf_fin-doc-tax.sum-line-base = buf_fin-doc-tax.sum-line-doc * (p-exch-rate / p-exch-scale)  /
     1984           p-base-rate * p-base-scale
     1985           buf_fin-doc-tax.sum-slt-line-rubl = buf_fin-doc-tax.sum-slt-line-doc * p-exch-rate / p-exch-scale
     1986           buf_fin-doc-tax.sum-slt-line-base = buf_fin-doc-tax.sum-slt-line-doc * (p-exch-rate / p-exch-scale)  /
     1987           p-base-rate * p-base-scale
     1988           buf_fin-doc-tax.sum-vat-line-rubl = buf_fin-doc-tax.sum-vat-line-doc * p-exch-rate / p-exch-scale
     1989           buf_fin-doc-tax.sum-vat-line-base = buf_fin-doc-tax.sum-vat-line-doc * (p-exch-rate / p-exch-scale)  /
     1990           p-base-rate * p-base-scale
     1991           .
     1992         end.
     1993       END CASE.
     1994       CASE p-contract-curr:
     1995         when p-curr-code then do:
     1996           assign
     1997           buf_fin-doc-tax.sum-line-contr = buf_fin-doc-tax.sum-line-doc
     1998           buf_fin-doc-tax.sum-slt-line-contr = buf_fin-doc-tax.sum-slt-line-doc
     1999           buf_fin-doc-tax.sum-vat-line-contr = buf_fin-doc-tax.sum-vat-line-doc
     2000           .
     2001         end.
     2002         when 0 then do:
     2003           assign
     2004           buf_fin-doc-tax.sum-line-contr = buf_fin-doc-tax.sum-line-rubl
     2005           buf_fin-doc-tax.sum-slt-line-contr = buf_fin-doc-tax.sum-slt-line-rubl
     2006           buf_fin-doc-tax.sum-vat-line-contr = buf_fin-doc-tax.sum-vat-line-rubl
     2007           .
     2008         end.
     2009         when v-base-code then do:
     2010           assign
     2011           buf_fin-doc-tax.sum-line-contr = buf_fin-doc-tax.sum-line-base
     2012           buf_fin-doc-tax.sum-slt-line-contr = buf_fin-doc-tax.sum-slt-line-base
     2013           buf_fin-doc-tax.sum-vat-line-contr = buf_fin-doc-tax.sum-vat-line-base
     2014           .
     2015         end.
     2016         otherwise do:
     2017           assign
     2018           buf_fin-doc-tax.sum-line-contr = buf_fin-doc-tax.sum-line-rubl / ( p-contract-rate / p-contract-scale)
     2019           buf_fin-doc-tax.sum-slt-line-contr = buf_fin-doc-tax.sum-slt-line-rubl / ( p-contract-rate / p-contract-scale)
     2020           buf_fin-doc-tax.sum-vat-line-contr = buf_fin-doc-tax.sum-vat-line-rubl / ( p-contract-rate / p-contract-scale )
     2021           .
     2022         end.
     2023       END CASE.
     2024     end.
     2025   end procedure.
