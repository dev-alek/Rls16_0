     1398     undo, return error (if p-silent = no then  "fin-ext-doc-type":U  else v-ret-mess).
     1399   end.
     1400   _MAIN:
     1401   DO ON ERROR UNDO, RETURN ERROR
     1402   ON STOP UNDO, RETURN ERROR:
     1403     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1404       create ub.fin-doc.
     1405       assign
     1406       ub.fin-doc.host-code = p-host-code
     1407       ub.fin-doc.fin-doc-code = p-fin-doc-code
     1408       ub.fin-doc.status_ = 'новый':U
     1409       p-doc-rec = recid(ub.fin-doc)
     1410       .
     1411           assign
     1412           v-cash-book-place = buf_clients-obj.obj-type + string(buf_clients-obj.obj-code, "99999")
     1413           .
     1414     end.
     1415     else do:
     1416       FIND FIRST ub.fin-doc where
     1417                 recid(ub.fin-doc) = p-doc-rec No-ERROR.
     1418       if not available ub.fin-doc then do:
     1419         run err-mess in this-procedure (substitute("Не найдена запись ПЛАТЕЖА - p-doc-rec &1", p-doc-rec), output v-ret-mess).
     1420         undo, return error (if p-silent = no then  '':u  else v-ret-mess).
     1421       end.
     1422       if ub.fin-doc.host-code <> p-host-code
     1423       OR ub.fin-doc.fin-doc-code <> p-fin-doc-code
     1424       OR ub.fin-doc.fin-doc-type <> p-fin-doc-type
     1425       then do:
     1426         run err-mess in this-procedure (substitute("Для уже имеющейся записи нельзя изменить&1" +
     1427                                  "код фирмы, внутренний код платежа, тип платежа&1"
     1428                                  , chr(10)), output v-ret-mess).
     1429         undo, return error (if p-silent = no then  '':U  else v-ret-mess).
     1430       end.
     1431       v-cash-book-place = ub.fin-doc.trn-doc-code.
     1432       if not (ub.fin-doc.obj-type = p-obj-type
     1433              and
     1434              ub.fin-doc.obj-code = p-obj-code
     1435              )
     1436       and ub.fin-doc.user-db-num-doc = g#db-num
     1437       then do:
     1438   if (valid-handle(g#lib-farh) <> true) then do:   run str/lib-farh.p persistent no-error .   if error-status :error or (valid-handle(g#lib-farh) <> true) then do:     message       "Error starting lib-farh.p" skip       g#lib-farh skip       g#lib-farh :type skip       g#lib-farh :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-farh_fautoobj in g#lib-farh
     1439   (input p-host-code
     1440   ,input p-fin-doc-code
     1441   ,output v-is-auto-obj
     1442   )
     1443   .
     1444         if not v-is-auto-obj then do:
     1445           assign
     1446           v-cash-book-place = p-obj-type + string(p-obj-code, "99999")
     1447           .
     1448         end.
     1449         else do:
     1450           assign v-cash-book-place = "".
     1451         end.
     1452       end.
     1453       if ub.fin-doc.status_ <> 'новый':U
     1454       then do:
     1455         if  v-author = ''
     1456         then do:
     1457           if
     1458           ub.fin-doc.base-rate           <> p-base-rate
     1459           or
     1460           ub.fin-doc.base-scale          <> p-base-scale
     1461           or
     1462           ub.fin-doc.contract-curr       <> p-contract-curr
     1463           or
     1464           ub.fin-doc.contract-rate       <> p-contract-rate
