     1133       undo, return error (if p-silent = no then  "cor-acc":U  else v-ret-mess).
     1134     end.
     1135     if buf_fin-code-cor-acc.status_ <> integer('0':U) then do:
     1136       run err-mess in this-procedure (substitute("Недопустимый статус корр счета: фирма &1 внутр. код счета &2 значение &3", p-host-code, p-cor-acc, p-cor-acc-value), output v-ret-mess ).
     1137       undo, return error (if p-silent = no then  "an-uchet-value":U  else v-ret-mess).
     1138     end.
     1139   end.
     1140   if p-cor-acc1 <> 0 then do:
     1141     find first buf_fin-code-cor-acc no-lock where
     1142               buf_fin-code-cor-acc.host-code = p-host-code
     1143           AND buf_fin-code-cor-acc.fin-code = p-cor-acc1 no-error .
     1144     if not available buf_fin-code-cor-acc then do:
     1145       run err-mess in this-procedure (substitute("Не найден корреспондирующий счет2: фирма &1 внутр. код счета &2", p-host-code, p-cor-acc1), output v-ret-mess ).
     1146       undo, return error (if p-silent = no then  "cor-acc1":U  else v-ret-mess).
     1147     end.
     1148     if buf_fin-code-cor-acc.status_ <> integer('0':U) then do:
     1149       run err-mess in this-procedure (substitute("Недопустимый статус корр счета2: фирма &1 внутр. код счета &2 значение &3", p-host-code, p-cor-acc1, p-cor-acc1-value), output v-ret-mess ).
     1150       undo, return error (if p-silent = no then  "cor-acc1-value":U else v-ret-mess).
     1151     end.
     1152   end.
     1153   if p-AN-UCHET-CODE <> 0 then do:
     1154     find first buf_fin-code-AN-UCHET no-lock where
     1155               buf_fin-code-an-uchet.host-code = p-host-code
     1156           AND buf_fin-code-an-uchet.fin-code = p-an-uchet-code no-error .
     1157     if not available buf_fin-code-an-uchet then do:
     1158       run err-mess in this-procedure (substitute("Не найден счет аналитического учета: фирма &1 внутр. код счета &2", p-host-code, p-an-uchet-code), output v-ret-mess ).
     1159       undo, return error (if p-silent = no then  "an-uchet-code":U  else v-ret-mess).
     1160     end.
     1161     if buf_fin-code-an-uchet.code-value <> p-an-uchet-value then do:
     1162       run err-mess in this-procedure (substitute("Не соответствуют друг другу внутр код счета ан. учета и его значение: фирма &1 внутр. код счета &2 значение &3", p-host-code, p-an-uchet-code, p-an-uchet-value), output v-ret-mess ).
     1163       undo, return error (if p-silent = no then  "an-uchet-value":U  else v-ret-mess).
     1164     end.
     1165     if buf_fin-code-an-uchet.status_ <> integer('0':U) then do:
     1166       run err-mess in this-procedure (substitute("Недопустимый статус кода ан. учета: фирма &1 внутр. код счета &2 значение &3", p-host-code, p-an-uchet-code, p-an-uchet-value), output v-ret-mess ).
     1167       undo, return error (if p-silent = no then  "an-uchet-value":U else v-ret-mess).
     1168     end.
     1169   end.
     1170   if p-cel-nazn-code <> 0 then do:
     1171     find first buf_fin-code-cel-nazn no-lock where
     1172               buf_fin-code-cel-nazn.host-code = p-host-code
     1173           AND buf_fin-code-cel-nazn.fin-code = p-cel-nazn-code no-error .
     1174     if not available buf_fin-code-cel-nazn then do:
     1175       run err-mess in this-procedure (substitute("Не найден счет целевого назначения: фирма &1 внутр. код счета &2", p-host-code, p-cel-nazn-code), output v-ret-mess ).
     1176       undo, return error (if p-silent = no then  "cel-nazn":U  else v-ret-mess).
     1177     end.
     1178     if buf_fin-code-cel-nazn.code-value <> p-cel-nazn-value then do:
     1179       run err-mess in this-procedure (substitute("Не соответствуют друг другу внутр код счета цел. назн. и его значение: фирма &1 внутр. код счета &2 значение &3", p-host-code, p-cel-nazn-code, p-cel-nazn-value), output v-ret-mess ).
     1180       undo, return error (if p-silent = no then  "cel-nazn-value":U  else v-ret-mess).
     1181     end.
     1182     if buf_fin-code-cel-nazn.status_ <> integer('0':U) then do:
     1183       run err-mess in this-procedure (substitute("Недопустимый статус кода целевого назначения: фирма &1 внутр. код счета &2 значение &3", p-host-code, p-cel-nazn-code, p-cel-nazn-value), output v-ret-mess ).
     1184       undo, return error (if p-silent = no then  "an-uchet-value":U else v-ret-mess).
     1185     end.
     1186   end.
     1187   if p-sum-doc = 0 then do:
     1188     if p-fin-doc-type = 'апр':U
     1189     or p-fin-doc-type = 'апп':U then do:
     1190       for each buf_fin-connect no-lock where
     1191               buf_fin-connect.host-code = p-host-code
     1192           AND buf_fin-connect.fin-doc-code = p-fin-doc-code:
     1193         assign
     1194         accum-rubl = accum-rubl   + buf_fin-connect.sum-rubl
     1195         accum-base = accum-base   + buf_fin-connect.sum-base
     1196         accum-doc  = accum-doc    + buf_fin-connect.sum-doc
     1197         accum-contr = accum-contr + buf_fin-connect.sum-contr
     1198         .
     1199       end.
     1200       if accum-rubl <> 0
     1201       OR accum-base <> 0
     1202       OR accum-doc <> 0
     1203       OR accum-contr <> 0 then do:
     1204         run err-mess in this-procedure ("Сумма по документу равна 0", output v-ret-mess ).
     1205       end.
     1206     end.
     1207     else do:
     1208       run err-mess in this-procedure ("Сумма по документу равна 0", output v-ret-mess ).
     1209       undo, return error (if p-silent = no then  "sum-doc":U else v-ret-mess).
     1210     end.
     1211   end.
     1212   if round(p-sum-contr,2) < round(p-con-sum-contr,2) then do:
     1213     run err-mess in this-procedure ("Сумма по документу (вал.дог.) " + string(p-sum-contr) + " не может быть меньше суммы (вал.дог.) " + string(p-con-sum-contr) + " имеющихcя связей с ФО", output v-ret-mess ).
     1214     undo, return error (if p-silent = no then  "sum-doc":U  else v-ret-mess).
     1215   end.
     1216   if l-shift-on
     1217   and lookup(p-fin-ext-doc-type, 'пко,рко':U) > 0
     1218   and (p-doc-author = 'manual':U or p-doc-author = 'auto':U)
     1219   then do:
     1220     v-flag-shift = yes.
     1221     define variable v-fin-doc-shift-name-check as character no-undo .
     1222    if p-shift-date = ?
     1223    or p-shift-num < 1
     1224    or p-shift-num > 24
     1225    then do:
     1226       run err-mess in this-procedure ( substitute("Неверная сменная дата &1 или порядок смены &2"
     1227                                        ,p-shift-date
     1228                                        ,p-shift-num), output v-ret-mess).
     1229       undo, return error (if p-silent = no then  "sum-doc":U  else v-ret-mess).
     1230    end.
     1231    define variable v-dop as character no-undo .
     1232   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_shiftnam in g#lib-trn3
     1233     (
     1234        input p-obj-type
     1235     ,  input p-obj-code
     1236     ,  input p-shift-date
     1237     ,  input p-shift-num
     1238     , output v-fin-doc-shift-name-check
     1239     , output v-dop
     1240     )        no-error .
     1241     if error-status:error then do:
     1242       run err-mess in this-procedure (substitute( "Ошибка при проверке сменной даты&1&2&1&3"
     1243                                         ,chr(10), error-status :get-message (1), return-value  )
     1244                                         , output v-ret-mess ).
     1245       undo, return error (if p-silent = no then  "shift-date":U  else v-ret-mess).
     1246     end.
     1247   end.
     1248   if not (p-mode = 'ИЗМЕНЕНИЕ':U
     1249          and
     1250          v-author <> '') then do:
     1251     for each tt0-fin-doc-tax no-lock where
     1252             tt0-fin-doc-tax.host-code = p-host-code
     1253         AND tt0-fin-doc-tax.fin-doc-code = p-fin-doc-code:
     1254       assign
     1255       v-acc = v-acc + tt0-fin-doc-tax.sum-line-doc
     1256       .
     1257     end.
     1258     if abs(v-acc - p-sum-doc) > 0.01 then do:
     1259       run err-mess in this-procedure ("Сумма по документу " + string(p-sum-doc) + " не равна сумме строк по исчислению налогов " +  string(v-acc), output v-ret-mess ).
     1260       undo, return error (if p-silent = no then  "sum-doc":U  else v-ret-mess).
     1261     end.
     1262   end.
     1263   if not (p-mode = 'ИЗМЕНЕНИЕ':U
     1264          and
     1265          v-author <> '')
     1266   and p-save-payment
     1267          then do:
     1268     v-acc = 0.
     1269     for each tt0-payment no-lock where
     1270             tt0-payment.host-code = p-host-code
     1271         AND tt0-payment.source-type = 'платеж':U
     1272         AND tt0-payment.source-ref = string(p-fin-doc-code):
     1273       if not (tt0-payment.payer-type = p-payer-type
     1274               and
     1275               tt0-payment.payer-code = p-payer-code) then do:
     1276       run err-mess in this-procedure ( substitute("Привязка к ДК сделана для &1&2,&3" +
     1277                                                   "а ПЛАТЕЛЬЩИК для платежа  &4&5"
     1278                                                   , tt0-payment.payer-type
     1279                                                   , tt0-payment.payer-code
     1280                                                   , chr(10)
     1281                                                   , p-payer-type
     1282                                                   , p-payer-code
     1283                                                   )
     1284                                             , output v-ret-mess ).
     1285       undo, return error (if p-silent = no then  "sum-doc":U  else v-ret-mess).
     1286       end.
     1287       assign
     1288       v-acc = v-acc + tt0-payment.tot-cli
     1289       .
     1290       v-found = yes.
     1291     end.
     1292     if v-found = yes
     1293     and not (p-fin-ext-doc-type = 'пко':U
