     1119       run err-mess in this-procedure (substitute("Не найден договор: фирма &1 код договора &2", p-host-code, p-contract-code), output v-ret-mess ).
     1120       undo, return error (if p-silent = no then  "contract-code":U  else v-ret-mess).
     1121     end.
     1122     if p-contract-curr <> buf_contract.curr-code then do:
     1123       run err-mess in this-procedure (substitute("Неверная валюта договора : фирма &1 код договора &2 - в договоре &3, а в платеже &4", p-host-code, p-contract-code, buf_contract.curr-code, p-contract-curr), output v-ret-mess ).
     1124       undo, return error (if p-silent = no then  "contract-curr":U  else v-ret-mess).
     1125     end.
     1126   end.
     1127   if p-cor-acc <> 0 then do:
     1128     find first buf_fin-code-cor-acc no-lock where
     1129               buf_fin-code-cor-acc.host-code = p-host-code
     1130           AND buf_fin-code-cor-acc.fin-code = p-cor-acc no-error .
