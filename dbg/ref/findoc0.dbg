      871   define new global shared variable g#lib-trn  as handle no-undo .
      872   define new global shared variable g#lib-trn2 as handle no-undo .
      873   define new global shared variable g#lib-trn3 as handle no-undo .
      874   define new global shared variable g#lib-trn4 as handle no-undo .
      875   if entry(1, p-mode, chr(4)) <> 'ДОБАВЛЕНИЕ':U
      876   and entry(1, p-mode, chr(4)) <> 'ИЗМЕНЕНИЕ':U then do:
      877     message
      878     vss-workfile vss-revision vss-description skip
      879     "Неверный параметр p-mode" p-mode
      880     view-as alert-box error .
      881     undo, return error '':u.
      882   end.
      883   assign
      884   v-author = (if num-entries(p-mode, chr(4)) > 1
      885              then entry(2, p-mode, chr(4))
      886              else '':U)
      887   p-mode = entry(1, p-mode, chr(4))
      888   .
      889   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      890   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      891     (output v-db-num
      892     )  .
      893   find first buf_sysconf no-lock where
      894                   buf_sysconf.host-code = p-host-code.
      895   if not avail buf_sysconf then do:
      896     run err-mess in this-procedure ( substitute("Не найдена фирма с кодом &1", string(p-host-code)), output v-ret-mess).
      897     undo, return error (if p-silent = no then "host-code":U else v-ret-mess).
      898   end.
      899   if p-obj-type <> "":U
      900   or p-obj-code <> 0 then do:
      901     find first buf_clients-obj no-lock where
      902               buf_clients-obj.obj-type = p-obj-type
      903           AND buf_clients-obj.obj-code = p-obj-code no-error .
      904     if not available buf_clients-obj
      905     or (p-obj-type <> 'маг':U and p-obj-type <> 'скл':U)
      906     then do:
      907       run err-mess in this-procedure ( substitute("Не найден объект &1&2", p-obj-type, p-obj-code), output v-ret-mess).
      908       undo, return error (if p-silent = no then "obj-code":U else v-ret-mess).
      909     end.
      910     if buf_clients-obj.host-code <> p-host-code then do:
      911       run err-mess in this-procedure ( substitute("Объект &1&2 принадлежит фирме &3, а платеж принадлежит фирме &4"
      912                                , p-obj-type, p-obj-code, buf_clients-obj.host-code , p-host-code), output v-ret-mess).
      913       undo, return error (if p-silent = no then "obj-code":U else v-ret-mess).
      914     end.
      915   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      916   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      917     (input  buf_clients-obj.obj-type
      918     ,input  buf_clients-obj.obj-code
      919     ,output v-obj-db-num
      920     )  .
      921   end.
      922   assign
      923   v-cash-book-place = p-trn-doc-code.
      924   if not (p-obj-type = '' and p-obj-code = 0)
      925   and v-obj-db-num = g#db-num then do:
      926     define variable l-shift-on as logical no-undo .
      927   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      928   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      929     (input  p-obj-type
      930     ,input  p-obj-code
      931     ,input  'shift-on=request'
      932     ,output l-shift-on
      933     )  .
      934   end.
      935   assign
      936   v-base-code = buf_sysconf.base-code
      937   .
      938   if p-prn-doc-code <> "":U and p-prn-doc-code <> "тех_":U
      939   then do:
      940     assign
      941     v-year-start-date = date(1, 1, year(p-doc-date))
      942     v-year-end-date = date(12, 31, year(p-doc-date))
      943     .
      944     IF can-find(first buf_fin-doc no-lock where
      945                       buf_fin-doc.host-code = p-host-code
      946                   AND buf_fin-doc.prn-doc-code = p-prn-doc-code
      947                   AND buf_fin-doc.fin-doc-type = p-fin-doc-type
      948                   AND (buf_fin-doc.doc-date >= v-year-start-date
      949                        and
      950                        buf_fin-doc.doc-date <= v-year-end-date)
      951                   AND (p-mode = 'ДОБАВЛЕНИЕ':U OR p-doc-rec <> recid(buf_fin-doc))
      952                   AND (p-fin-doc-type <> 'ппп':U
      953                        OR (buf_fin-doc.payer-type = p-payer-type AND buf_fin-doc.payer-code = p-payer-code)
      954                       )
      955                   ) then do:
      956       if p-fin-doc-type = 'ппп':U then do:
      957         run err-mess in this-procedure ( substitute("Уже есть ПЛАТЕЖ с номером &1 для фирмы &2 от плательщика &3&4 за &5 год"
      958                                 , p-prn-doc-code
      959                                 , p-host-code
      960                                 , p-payer-type
      961                                 , p-payer-code
      962                                 , year(p-doc-date)), output v-ret-mess).
      963       end.
      964       else do:
      965         run err-mess in this-procedure ( substitute("Уже есть ПЛАТЕЖ с номером &1 для фирмы &2 за &3 год", p-prn-doc-code, p-host-code, year(p-doc-date)), output v-ret-mess).
      966       end.
      967       undo, return error (if p-silent = no then "prn-doc-code":U else v-ret-mess).
      968     end.
      969   end.
      970   if p-doc-date = ? then do:
      971     run err-mess in this-procedure ( "Неверная дата составления ПЛАТЕЖА", output v-ret-mess).
      972     undo, return error (if p-silent = no then "doc-date":U else v-ret-mess).
      973   end.
      974   if p-curr-code <> 0 then do:
      975     find first buf_currency no-lock where
      976               buf_currency.curr-code = p-curr-code no-error.
      977     if not available buf_currency then do:
      978       run err-mess in this-procedure ( substitute("Не надена валюта с кодом &1", p-curr-code), output v-ret-mess).
      979       undo, return error (if p-silent = no then "curr-code":U else v-ret-mess) .
      980     end.
      981   end.
      982   if p-contract-curr <> 0 then do:
      983     find first buf_currency no-lock where
      984               buf_currency.curr-code = p-contract-curr no-error.
      985     if not available buf_currency then do:
      986       run err-mess in this-procedure ( substitute("Не надена валюта контракта с кодом &1", p-contract-curr), output v-ret-mess).
      987       undo, return error (if p-silent = no then "contract-curr":U else v-ret-mess).
      988     end.
      989   end.
      990   if p-receiver-name = "":U then do:
      991     run err-mess in this-procedure ( "Имя ПОЛУЧАТЕЛЯ не может быть пустым", output v-ret-mess).
      992     undo, return error (if p-silent = no then "receiver-name":U else v-ret-mess).
      993   end.
      994   if p-receiver-inn <> "":U then do:
      995     run gbl/keyinn.p ( input p-receiver-inn
      996                       ,input p-receiver-type
      997                       ,input p-receiver-code
      998                       ,input ?
      999                       ,output v-correct-inn) no-error .
     1000     if error-status:error or not v-correct-inn then do:
     1001       run err-mess in this-procedure ( substitute("Неверный ИНН ПОЛУЧАТЕЛЯ &1 &2", p-receiver-inn, return-value), output v-ret-mess).
     1002       undo, return error (if p-silent = no then "receiver-inn":U else v-ret-mess).
     1003     end.
     1004   end.
     1005   if p-payer-inn <> "":U then do:
     1006     run gbl/keyinn.p ( input p-payer-inn
     1007                       ,input p-payer-type
     1008                       ,input p-payer-code
     1009                       ,input ?
     1010                       ,output v-correct-inn) no-error .
     1011     if error-status:error or not v-correct-inn then do:
     1012       run err-mess in this-procedure (substitute("Неверный ИНН ПЛАТЕЛЬЩИКА &1 &2",  p-payer-inn, return-value), output v-ret-mess).
     1013       undo, return error (if p-silent = no then "payer-inn":U else v-ret-mess).
     1014     end.
     1015   end.
     1016   if p-fin-doc-type = 'пко':U or
     1017      p-fin-doc-type = 'ппп':U or
     1018      p-fin-doc-type = 'апп':U
     1019      then do:
     1020     if p-receiver-code <> p-host-code then do:
     1021       run err-mess in this-procedure (substitute("Неверные ПОЛУЧАТЕЛЬ &1 &2: ПОЛУЧАТЕЛЬ для платежа &3 должен быть &4&5"
     1022                                , p-receiver-type
     1023                                , p-receiver-code
     1024                                , p-fin-doc-type
     1025                                , 'орг':U
     1026                                , p-host-code) , output v-ret-mess).
     1027       undo, return error (if p-silent = no then "receiver-code":U else v-ret-mess).
     1028     end.
     1029   end.
     1030   find first buf_clients no-lock where
     1031               buf_clients.obj-type = p-receiver-type
     1032           AND buf_clients.obj-code = p-receiver-code no-error .
     1033   if not available buf_clients then do:
     1034     run err-mess in this-procedure (substitute("Не найден ПОЛУЧАТЕЛЬ &1 &2", p-receiver-type, p-receiver-code) , output v-ret-mess).
     1035     undo, return error (if p-silent = no then "receiver-code":U else v-ret-mess).
     1036   end.
     1037   if p-receiver-code-schet <> 0 then do:
     1038     find first buf_fin-schet no-lock where
     1039               buf_fin-schet.host-code = p-host-code
     1040           AND buf_fin-schet.code-schet = p-receiver-code-schet no-error.
     1041     if not available buf_fin-schet then do:
     1042       run err-mess in this-procedure (substitute("Не найден СЧЕТ ПОЛУЧАТЕЛЯ &1&2: фирма &3 код счета &4", p-receiver-type, p-receiver-code, p-host-code, p-receiver-code-schet) , output v-ret-mess).
     1043       undo, return error (if p-silent = no then "receiver-code-schet":U else v-ret-mess).
     1044     end.
     1045     if buf_fin-schet.curr-code <> p-curr-code then do:
     1046       run err-mess in this-procedure (substitute("Валюта СЧЕТА ПОЛУЧАТЕЛЯ &1&2: фирма &3 код счета &4 валюта &5 - не совпадает с валютой ПЛАТЕЖА &6",
     1047       p-receiver-type, p-receiver-code,
     1048       p-host-code, p-payer-code-schet, buf_fin-schet.curr-code, p-curr-code) , output v-ret-mess).
     1049       undo, return error (if p-silent = no then "receiver-code-schet":U else v-ret-mess).
     1050     end.
     1051     if not (buf_fin-schet.cli-type = p-receiver-type
     1052             and
     1053             buf_fin-schet.cli-code = p-receiver-code) then do:
     1054       run err-mess in this-procedure (substitute("СЧЕТ ПОЛУЧАТЕЛЯ принадлежит &1&2 - не совпадает с ПОЛУЧАТЕЛЕМ &3&4"
     1055                                                  ,buf_fin-schet.cli-type
     1056                                                  ,buf_fin-schet.cli-code
     1057                                                  ,p-receiver-type
     1058                                                  ,p-receiver-code) , output v-ret-mess).
     1059       undo, return error (if p-silent = no then  "receiver-code-schet":U else v-ret-mess).
     1060     end.
     1061   end.
     1062   if p-fin-doc-type = 'рко':U
     1063   or p-fin-doc-type = 'рпп':U
     1064   or p-fin-doc-type = 'апр':U
     1065      then do:
     1066     if p-payer-code <> p-host-code then do:
     1067       run err-mess in this-procedure (substitute("Неверный ПЛАТЕЛЬЩИК &1 &2: ПЛАТЕЛЬЩИК для платежа &3 должен быть &4&5"
     1068                                , p-payer-type
     1069                                , p-payer-code
     1070                                , p-fin-doc-type
     1071                                , 'орг':U
     1072                                , p-host-code) , output v-ret-mess).
     1073       undo, return error (if p-silent = no then "payer-code":U else v-ret-mess).
     1074     end.
     1075   end.
     1076   find first buf_clients no-lock where
     1077               buf_clients.obj-type = p-payer-type
     1078           AND buf_clients.obj-code = p-payer-code no-error .
     1079   if not available buf_clients then do:
     1080     run err-mess in this-procedure (substitute("Не найден ПЛАТЕЛЬЩИК &1 &2", p-payer-type, p-payer-code), output v-ret-mess).
     1081     undo, return error (if p-silent = no then "payer-code":U else v-ret-mess).
     1082   end.
     1083   if p-payer-code-schet <> 0 then do:
     1084     find first buf_fin-schet no-lock where
     1085               buf_fin-schet.host-code = p-host-code
     1086           AND buf_fin-schet.code-schet = p-payer-code-schet no-error.
     1087     if not available buf_fin-schet then do:
     1088       run err-mess in this-procedure (substitute("Не найден СЧЕТ ПЛАТЕЛЬЩИКА &1&2: фирма &3 код счета &4", p-payer-type, p-payer-code, p-host-code, p-payer-code-schet) , output v-ret-mess).
     1089       undo, return error (if p-silent = no then "payer-code-schet":U else v-ret-mess).
     1090     end.
     1091     if buf_fin-schet.curr-code <> p-curr-code then do:
     1092       run err-mess in this-procedure (substitute("Валюта СЧЕТА ПЛАТЕЛЬЩИКА &1&2: фирма &3 код счета &4 валюта &5 - не совпадает с валютой ПЛАТЕЖА &6",
     1093       p-payer-type, p-payer-code,
     1094       p-host-code, p-payer-code-schet, buf_fin-schet.curr-code, p-curr-code) , output v-ret-mess).
     1095       undo, return error (if p-silent = no then  "payer-code-schet":U else v-ret-mess).
     1096     end.
     1097     if not (buf_fin-schet.cli-type = p-payer-type
     1098             and
     1099             buf_fin-schet.cli-code = p-payer-code) then do:
     1100       run err-mess in this-procedure (substitute("СЧЕТ ПЛАТЕЛЬЩИКА принадлежит &1&2 - не совпадает с ПЛАТЕЛЬЩИКОМ &3&4"
     1101                                                  ,buf_fin-schet.cli-type
     1102                                                  ,buf_fin-schet.cli-code
     1103                                                  ,p-payer-type
     1104                                                  ,p-payer-code) , output v-ret-mess).
     1105       undo, return error (if p-silent = no then  "payer-code-schet":U else v-ret-mess).
     1106     end.
     1107   end.
     1108   if p-payer-type = p-receiver-type
     1109   and p-payer-code = p-receiver-code then do:
     1110       run err-mess in this-procedure (substitute("ПЛАТЕЛЬЩИК и ПОЛУЧАТЕЛЬ - не могут быть одной и той же организацией/физ.лицом (&1&2)"
     1111                                                  ,p-payer-type
     1112                                                  ,p-payer-code) , output v-ret-mess).
     1113       undo, return error (if p-silent = no then  "payer-code":U else v-ret-mess).
     1114   end.
     1115   if p-contract-code <> 0 then do:
     1116     find first buf_contract no-lock where
     1117               buf_contract.contract-code = p-contract-code no-error .
