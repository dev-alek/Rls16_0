      688         buf_c-fin-doc-attr.fin-doc-code     = p-fin-doc-code
      689         .
      690     end.
      691     else do:
      692           buf_c-fin-doc-attr.attr-value   = p-attr-value .
      693     end.
      694    end.
      695   end procedure.
