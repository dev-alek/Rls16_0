        1   define input parameter         p-def as character no-undo.
        2   define input-output parameter  rr    as recid no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Корректировка названия темпа продаж   ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   define buffer tmp-sale-1 for ub.tmp-sale .
      115   define variable v-new    as integer no-undo   .
      116   define variable v-max    as integer no-undo   .
      117   DEFINE BUTTON B-Cancel AUTO-END-KEY
      118        LABEL "&Отмена"
      119        SIZE 10 BY 1
      120        BGCOLOR 8 .
      121   DEFINE BUTTON B-Help
      122        LABEL "&Помощь"
      123        SIZE 10 BY 1
      124        BGCOLOR 8 .
      125   DEFINE BUTTON B-OK AUTO-GO
      126        LABEL "&Ввод"
      127        SIZE 10 BY 1
      128        BGCOLOR 8 .
      129   DEFINE VARIABLE loc-name AS CHARACTER
      130        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      131        SIZE 63.38 BY 4
      132        BGCOLOR 15  NO-UNDO.
      133   DEFINE VARIABLE loc-code AS CHARACTER FORMAT "X(15)":U
      134        LABEL "Код"
      135         VIEW-AS TEXT
      136        SIZE 15 BY .67
      137        FGCOLOR 1  NO-UNDO.
      138   DEFINE FRAME Dialog-Frame
      139        B-OK AT ROW 1 COL 1
      140        B-Cancel AT ROW 1 COL 11
      141        B-Help AT ROW 1 COL 55.13
      142        loc-name AT ROW 4.75 COL 1.25 NO-LABEL
      143        loc-code AT ROW 2.63 COL 6 COLON-ALIGNED
      144        SPACE(43.13) SKIP(8.98)
      145       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      146            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      147            TITLE "<insert dialog title>".
      148   ASSIGN
      149          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      150          FRAME Dialog-Frame:HIDDEN           = TRUE.
      151   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      152   DO:
      153     APPLY "END-ERROR":U TO SELF.
      154   END.
      155   ON CHOOSE OF B-OK IN FRAME Dialog-Frame
      156   DO:
      157     Assign frame Dialog-Frame
      158     loc-code  loc-name.
      159       if loc-name = "" then do:
      160         message "Введите название для списка темпов продаж ! " view-as  alert-box  error.
      161         apply "entry"  to loc-name .
      162         return no-apply.
      163         end.
      164       if p-def = 'ДОБАВЛЕНИЕ':U then create ub.tmp-sale.
      165       if p-def = 'ДОБАВЛЕНИЕ':U or p-def = 'ИЗМЕНЕНИЕ':U  then
      166           assign
      167             ub.tmp-sale.tmp-code = loc-code
      168             ub.tmp-sale.desc_ = loc-name
      169             rr = recid ( ub.tmp-sale )
      170             .
      171        else rr = ? .
      172   END.
      173   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      174   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      175   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      176   on help of frame Dialog-Frame
      177   do:
      178     run gbl/app_help.p
      179       (input this-procedure :file-name
      180       ,input ''
      181       ,input ?
      182       ) no-error.
      183     if error-status :error then do:
      184       message
      185         "Ошибка при вызове помощи"
      186         error-status :get-message(1)
      187         view-as alert-box .
      188     end.
      189   end.
      190   run minbtn-set in this-procedure .
      191   on choose of b-help in frame Dialog-Frame
      192   do:
      193     apply "help":u to frame Dialog-Frame .
      194   end.
      195   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      196   procedure minbtn-set :
      197       do
      198           on error undo, return error return-value
      199           :
      200           define variable ii              as integer       no-undo .
      201           define variable fh              as widget-handle no-undo .
      202           define variable hh              as widget-handle no-undo .
      203           define variable v-h             as handle        extent 4 no-undo .
      204           define variable v-name-button   as character     no-undo .
      205           define variable v-help-old-x    as decimal       no-undo .
      206           define variable v-help-old-y    as decimal       no-undo .
      207           define variable v-help-old-size as decimal       no-undo .
      208           define variable v-frame-width   as decimal       no-undo .
      209           define variable jj              as integer       no-undo .
      210           do
      211               on error undo, return error
      212               :
      213               assign
      214                   v-frame-width = frame Dialog-Frame:width - 0.3
      215                   fh            = frame Dialog-Frame:first-child
      216                   hh            = fh:first-child
      217                   ii            = 1
      218                   .
      219               do while valid-handle(hh):
      220                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      221                   do:
      222                       case lc(hh:name) :
      223                           when "b-help" then
      224                               do:
      225                                   hh:load-image-up("cmp/b-help.bmp":u) .
      226                                   hh:load-image-down("cmp/b-help.bmp":u) .
      227                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      228                                   hh:TOOLTIP = "Помощь" .
      229                                   v-help-old-x = hh:column .
      230                                   v-help-old-y = hh:row    .
      231                                   v-help-old-size = hh:width .
      232                                   hh:width-chars = 2.5 .
      233                               end.
      234                           when "b-print" then
      235                               do:
      236                                   hh:load-image("cmp/b-print.bmp":u) .
      237                                   hh:TOOLTIP = "Печать" .
      238                                   v-h[ii] = hh:handle .
      239                                   ii = ii + 1 .
      240                                   hh:width-chars = 3 .
      241                               end.
      242                           when "b-history" or
      243                           when "b-hist" then
      244                               do:
      245                                   hh:load-image("cmp/b-hist.bmp":u) .
      246                                   hh:TOOLTIP = "История" .
      247                                   v-h[ii] = hh:handle .
      248                                   ii = ii + 1 .
      249                                   hh:width-chars = 3 .
      250                               end.
      251                           when "b-sch" then
      252                               do:
      253                                   hh:load-image("cmp/b-sch.bmp":u) .
      254                                   hh:TOOLTIP = "Установка Фильтра" .
      255                                   v-h[ii] = hh:handle .
      256                                   ii = ii + 1 .
      257                                   hh:width-chars = 3 .
      258                               end.
      259                           when "b-hist-user" then
      260                               do:
      261                                   hh:load-image("cmp/b-hist.bmp":u) .
      262                                   hh:TOOLTIP = "История пользователя" .
      263                                   ii = ii + 1 .
      264                               end.
      265                       end case.
      266                   end.
      267                   hh = hh:next-sibling.
      268               end.
      269               b-help:column = v-frame-width - b-help:width-chars.
      270               jj = 0.
      271               repeat ii = 4 to 1 by -1 :
      272                   if valid-handle (v-h[ii] ) then
      273                   do:
      274                       jj  = jj + 1 .
      275                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      276                       v-h[ii]:row    = v-help-old-y .
      277                   end.
      278               end.
      279           end.
      280       end.
      281   end procedure.
      282   assign frame Dialog-Frame:title = "Темп продаж - " + p-def.
      283   MAIN-BLOCK:
      284   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      285      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      286     run local-init no-error .
      287         if error-status :error then return error.
      288     run enable_ui.
      289     WAIT-FOR GO OF FRAME Dialog-Frame.
      290   END.
      291   RUN disable_UI.
      292   PROCEDURE disable_UI :
      293     HIDE FRAME Dialog-Frame.
      294   END PROCEDURE.
      295   PROCEDURE enable_UI :
      296     DISPLAY loc-name loc-code
      297         WITH FRAME Dialog-Frame.
      298     ENABLE B-OK B-Cancel B-Help loc-name loc-code
      299         WITH FRAME Dialog-Frame.
      300     VIEW FRAME Dialog-Frame.
      301   END PROCEDURE.
      302   PROCEDURE local-init :
      303   if Lookup(p-def, 'ДОБАВЛЕНИЕ':U + "," + 'ПРОСМОТР':U + "," +  'ИЗМЕНЕНИЕ':U)  = 0 then return error.
      304     if p-def = 'ИЗМЕНЕНИЕ':U then do:
      305        find first ub.tmp-sale where recid(ub.tmp-sale) = rr  exclusive-lock  no-error .
      306        if error-status :error then return error.
      307     end.
      308     if p-def = 'ПРОСМОТР':U then do:
      309        find first ub.tmp-sale where recid(ub.tmp-sale) = rr  no-lock  no-error .
      310        if error-status :error then return error.
      311     end.
      312       if available ub.tmp-sale then do:
      313       assign
      314         loc-code    = ub.tmp-sale.tmp-code
      315         loc-name    = ub.tmp-sale.desc_
      316         .
      317       end.
      318       else do:
      319       if p-def = 'ДОБАВЛЕНИЕ':U then do:
      320              for each tmp-sale-1 no-lock :
      321                 v-new = integer ( entry ( 1 , tmp-sale-1.tmp-code)) .
      322                 if v-new  > v-max then v-max = v-new .
      323              end.
      324              loc-code = string ( ( v-max + 1) , "9999999999" ) .
      325          end.
      326       end.
      327   END PROCEDURE.
