      911   procedure make-tt :
      912     do
      913     on error undo, return error return-value
      914     :
      915   define buffer buf_gds-obj for ub.gds-obj.
      916   define variable v-sum-crit      as decimal   no-undo .
      917   define variable v-sum-qnty      as decimal   no-undo .
      918   define variable v-price-crc     as decimal   no-undo .
      919   define variable v-reserve-day   as decimal   no-undo .
      920   define variable v-stock-qnty    as decimal   no-undo .
      921   define variable v-sum-acc       as decimal   no-undo .
      922   define variable v-sum-cur       as decimal   no-undo .
      923   define variable v-sum-doc       as decimal   no-undo .
      924   define variable v-vat-acc       as decimal   no-undo .
      925   define variable v-vat-cur       as decimal   no-undo .
      926   define variable v-vat-doc       as decimal   no-undo .
      927   define variable v-transport-acc as decimal   no-undo .
      928   define variable v-transport-cur as decimal   no-undo .
      929   define variable v-transport-doc as decimal   no-undo .
      930   define variable v-other-acc     as decimal   no-undo .
      931   define variable v-other-cur     as decimal   no-undo .
      932   define variable v-other-doc     as decimal   no-undo .
      933   define variable v-road-tax-acc  as decimal   no-undo .
      934   define variable v-road-tax-cur  as decimal   no-undo .
      935   define variable v-road-tax-doc  as decimal   no-undo .
      936   define variable v-slt-acc       as decimal   no-undo .
      937   define variable v-slt-cur       as decimal   no-undo .
      938   define variable v-slt-doc       as decimal   no-undo .
      939   run waitfram-show ("Формирование таблицы оборотов...").
      940       for each x-analysis-obj :
      941         run waitfram-show ("Формирование таблицы оборотов...По объекту " + x-analysis-obj.obj-type + " " + string(x-analysis-obj.obj-code)).
      942           for each buf_gds-obj no-lock where
      943               buf_gds-obj.obj-type = x-analysis-obj.obj-type and
      944               buf_gds-obj.obj-code = x-analysis-obj.obj-code
      945               :
      946                 if x-analysis.r-goods = 2 then do:
      947                      if not can-find( first gds-list where buf_gds-obj.gds-code = gds-list.gds-code) then next .
      948                   end.
      949               run def-sum (
      950                  input  x-analysis-obj.obj-type
      951                 ,input  x-analysis-obj.obj-code
      952                 ,input  buf_gds-obj.gds-code
      953                 ,output v-sum-crit
      954                 ,output v-sum-qnty
      955                 ,output v-price-crc
      956                 ,output v-reserve-day
      957                 ,output v-stock-qnty
      958                 ,output v-sum-acc
      959                 ,output v-sum-cur
      960                 ,output v-sum-doc
      961                 ,output v-vat-acc
      962                 ,output v-vat-cur
      963                 ,output v-vat-doc
      964                 ,output v-transport-acc
      965                 ,output v-transport-cur
      966                 ,output v-transport-doc
      967                 ,output v-other-acc
      968                 ,output v-other-cur
      969                 ,output v-other-doc
      970                 ,output v-road-tax-acc
      971                 ,output v-road-tax-cur
      972                 ,output v-road-tax-doc
      973                 ,output v-slt-acc
      974                 ,output v-slt-cur
      975                 ,output v-slt-doc ) .
      976                 if v-sum-crit <> 0 then do:
      977                 find first  temp-oborot where
      978                     temp-oborot.obj-type = buf_gds-obj.obj-type and
      979                     temp-oborot.obj-code = buf_gds-obj.obj-code and
      980                     temp-oborot.gds-code = buf_gds-obj.gds-code
      981                     no-error .
      982                     if not available temp-oborot then do:
      983                       create temp-oborot.
      984                     end.
      985                     assign
      986                         temp-oborot.obj-type      = buf_gds-obj.obj-type
      987                         temp-oborot.obj-code      = buf_gds-obj.obj-code
      988                         temp-oborot.gds-code      = buf_gds-obj.gds-code
      989                         temp-oborot.sum-crit      = v-sum-crit
      990                         temp-oborot.qnty          = v-sum-qnty
      991                         temp-oborot.price-crc     = buf_gds-obj.price-sale
      992                         temp-oborot.reserve-day   = v-reserve-day
      993                         temp-oborot.stock-qnty    = buf_gds-obj.fact-qnty
      994                         temp-oborot.sum-acc       = v-sum-acc
      995                         temp-oborot.sum-cur       = v-sum-cur
      996                         temp-oborot.sum-doc       = v-sum-doc
      997                         temp-oborot.vat-acc       = v-vat-acc
      998                         temp-oborot.vat-cur       = v-vat-cur
      999                         temp-oborot.vat-doc       = v-vat-doc
     1000                         temp-oborot.transport-acc = v-transport-acc
     1001                         temp-oborot.transport-cur = v-transport-cur
     1002                         temp-oborot.transport-doc = v-transport-doc
     1003                         temp-oborot.other-acc     = v-other-acc
     1004                         temp-oborot.other-cur     = v-other-cur
     1005                         temp-oborot.other-doc     = v-other-doc
     1006                         temp-oborot.road-tax-acc  = v-road-tax-acc
     1007                         temp-oborot.road-tax-cur  = v-road-tax-cur
     1008                         temp-oborot.road-tax-doc  = v-road-tax-doc
     1009                         temp-oborot.slt-acc       = v-slt-acc
     1010                         temp-oborot.slt-cur       = v-slt-cur
     1011                         temp-oborot.slt-doc       = v-slt-doc
     1012                     .
     1013                   if lookup(string(x-analysis.cral-id) ,"5,6,7,9,11,13,15") = 0 then
     1014                             temp-oborot.price-cost    = buf_gds-obj.fact-rubl .
     1015                        else temp-oborot.price-cost    = buf_gds-obj.fact-base .
     1016                     run def-order (
     1017                          input  buf_gds-obj.obj-type
     1018                         ,input  buf_gds-obj.obj-code
     1019                         ,input  buf_gds-obj.artic
     1020                         ,input  buf_gds-obj.prod-type
     1021                         ,input  buf_gds-obj.prod-code
     1022                         ,output temp-oborot.order-qnty  ) .
     1023                 end.
     1024           end.
     1025       end.
     1026     end.
     1027   end procedure.
     1028   procedure def-sum :
     1029   do
     1030   on error undo, return error return-value
     1031   :
     1032   define input  parameter p-obj-type as character no-undo .
     1033   define input  parameter p-obj-code as integer   no-undo .
     1034   define input  parameter p-gds-code as integer   no-undo .
     1035   define output parameter v-sum-crit       as decimal   no-undo .
     1036   define output parameter v-sum-qnty       as decimal   no-undo .
     1037   define output parameter v-price-crc      as decimal   no-undo .
     1038   define output parameter v-reserve-day    as decimal   no-undo .
     1039   define output parameter v-stock-qnty     as decimal   no-undo .
     1040   define output parameter v-sum-acc        as decimal   no-undo .
     1041   define output parameter v-sum-cur        as decimal   no-undo .
     1042   define output parameter v-sum-doc        as decimal   no-undo .
     1043   define output parameter v-vat-acc        as decimal   no-undo .
     1044   define output parameter v-vat-cur        as decimal   no-undo .
     1045   define output parameter v-vat-doc        as decimal   no-undo .
     1046   define output parameter v-transport-acc  as decimal   no-undo .
     1047   define output parameter v-transport-cur  as decimal   no-undo .
     1048   define output parameter v-transport-doc  as decimal   no-undo .
     1049   define output parameter v-other-acc      as decimal   no-undo .
     1050   define output parameter v-other-cur      as decimal   no-undo .
     1051   define output parameter v-other-doc      as decimal   no-undo .
     1052   define output parameter v-road-tax-acc   as decimal   no-undo .
     1053   define output parameter v-road-tax-cur   as decimal   no-undo .
     1054   define output parameter v-road-tax-doc   as decimal   no-undo .
     1055   define output parameter v-slt-acc        as decimal   no-undo .
     1056   define output parameter v-slt-cur        as decimal   no-undo .
     1057   define output parameter v-slt-doc        as decimal   no-undo .
     1058   define variable  p-date-1 as date   no-undo .
     1059   define variable  p-date-2 as date   no-undo .
     1060   define variable v-fact-order-1 as decimal   no-undo .
     1061   define variable v-fact-order-2 as decimal   no-undo .
     1062   define variable v-sum          as decimal   no-undo .
     1063   define buffer buf_aht-ot-line for ub.aht-ot-line.
     1064   find first x-analysis no-error .
     1065   if error-status :error then message error-status :get-message(1) "7770" view-as alert-box information .
     1066   for each tt-aht-ot-line : delete tt-aht-ot-line . end.
     1067   define variable v-p as integer   no-undo init 0.
     1068       for each x-analysis-period :
     1069         assign
     1070           v-p = v-p + 1
     1071           p-date-1 = x-analysis-period.xyzp-start
     1072           p-date-2 = x-analysis-period.xyzp-end
     1073         .
     1074         run day-begin-fact-order (input p-date-1 , output  v-fact-order-1).
     1075         run factord-end-day (input p-date-2 , output  v-fact-order-2).
     1076         for each x-analysis-doc :
     1077           repeat i = 1 to 5 :
     1078               for each buf_aht-ot-line no-lock where
     1079                       buf_aht-ot-line.ext-doc-type = x-analysis-doc.xyzd-ext-doc-type and
     1080                       buf_aht-ot-line.gds-code     = p-gds-code                       and
     1081                       buf_aht-ot-line.obj-code     = p-obj-code                       and
     1082                       buf_aht-ot-line.obj-type     = p-obj-type                       and
     1083                       buf_aht-ot-line.sum-type     = v-i[i]                           and
     1084                       buf_aht-ot-line.fact-order   >= v-fact-order-1                  and
     1085                       buf_aht-ot-line.fact-order   <= v-fact-order-2
     1086               :
     1087                   create tt-aht-ot-line.
     1088                   buffer-copy buf_aht-ot-line to tt-aht-ot-line .
     1089                   assign
     1090                     tt-aht-ot-line.num-per = v-p .
     1091                   .
     1092                   if buf_aht-ot-line.sum-type = 'b':U then do:
     1093                      tt-aht-ot-line.fact-qnty  = 0 .
     1094                   end.
     1095               end.
     1096           end.
     1097         end.
     1098       end.
     1099   assign
     1100     v-sum-crit        = 0
     1101     v-sum-qnty        = 0
     1102     v-price-crc       = 0
     1103     v-reserve-day     = 0
     1104     v-stock-qnty      = 0
     1105     v-sum-acc         = 0
     1106     v-sum-cur         = 0
     1107     v-sum-doc         = 0
     1108     v-vat-acc         = 0
     1109     v-vat-cur         = 0
     1110     v-vat-doc         = 0
     1111     v-transport-acc   = 0
     1112     v-transport-cur   = 0
     1113     v-transport-doc   = 0
     1114     v-other-acc       = 0
     1115     v-other-cur       = 0
     1116     v-other-doc       = 0
     1117     v-road-tax-acc    = 0
     1118     v-road-tax-cur    = 0
     1119     v-road-tax-doc    = 0
     1120     v-slt-acc         = 0
     1121     v-slt-cur         = 0
     1122     v-slt-doc         = 0
     1123   .
     1124   for each tt-aht-ot-line :
     1125       v-sum-qnty          = v-sum-qnty         + tt-aht-ot-line.fact-qnty .
     1126       if lookup(string(x-analysis.cral-id) ,"5,6,7,9,11,13,15") = 0 then
     1127       assign
     1128         v-sum-acc         = v-sum-acc         + tt-aht-ot-line.cost-sum-rubl
     1129         v-sum-cur         = v-sum-cur         + tt-aht-ot-line.crsa-sum-rubl
     1130         v-sum-doc         = v-sum-doc         + tt-aht-ot-line.sale-sum-rubl
     1131         v-vat-acc         = v-vat-acc         + tt-aht-ot-line.cost-vat-rubl
     1132         v-vat-cur         = v-vat-cur         + tt-aht-ot-line.crsa-vat-rubl
     1133         v-vat-doc         = v-vat-doc         + tt-aht-ot-line.sale-vat-rubl
     1134         v-transport-acc   = v-transport-acc   + tt-aht-ot-line.cost-transport-rubl
     1135         v-transport-cur   = v-transport-cur   + tt-aht-ot-line.crsa-transport-rubl
     1136         v-transport-doc   = v-transport-doc   + tt-aht-ot-line.sale-transport-rubl
     1137         v-other-acc       = v-other-acc       + tt-aht-ot-line.cost-other-rubl
     1138         v-other-cur       = v-other-cur       + tt-aht-ot-line.crsa-other-rubl
     1139         v-other-doc       = v-other-doc       + tt-aht-ot-line.sale-other-rubl
     1140         v-road-tax-acc    = v-road-tax-acc    + tt-aht-ot-line.cost-road-tax-rubl
     1141         v-road-tax-cur    = v-road-tax-cur    + tt-aht-ot-line.crsa-road-tax-rubl
     1142         v-road-tax-doc    = v-road-tax-doc    + tt-aht-ot-line.sale-road-tax-rubl
     1143         v-slt-acc         = v-slt-acc         + tt-aht-ot-line.cost-slt-rubl
     1144         v-slt-cur         = v-slt-cur         + tt-aht-ot-line.crsa-slt-rubl
     1145         v-slt-doc         = v-slt-doc         + tt-aht-ot-line.sale-slt-rubl
     1146       .
     1147       else
     1148       assign
     1149         v-sum-acc         = v-sum-acc         + tt-aht-ot-line.cost-sum-base
     1150         v-sum-cur         = v-sum-cur         + tt-aht-ot-line.crsa-sum-base
     1151         v-sum-doc         = v-sum-doc         + tt-aht-ot-line.sale-sum-base
     1152         v-vat-acc         = v-vat-acc         + tt-aht-ot-line.cost-vat-base
     1153         v-vat-cur         = v-vat-cur         + tt-aht-ot-line.crsa-vat-base
     1154         v-vat-doc         = v-vat-doc         + tt-aht-ot-line.sale-vat-base
     1155         v-transport-acc   = v-transport-acc   + tt-aht-ot-line.cost-transport-base
     1156         v-transport-cur   = v-transport-cur   + tt-aht-ot-line.crsa-transport-base
     1157         v-transport-doc   = v-transport-doc   + tt-aht-ot-line.sale-transport-base
     1158         v-other-acc       = v-other-acc       + tt-aht-ot-line.cost-other-base
     1159         v-other-cur       = v-other-cur       + tt-aht-ot-line.crsa-other-base
     1160         v-other-doc       = v-other-doc       + tt-aht-ot-line.sale-other-base
     1161         v-road-tax-acc    = v-road-tax-acc    + tt-aht-ot-line.cost-road-tax-base
     1162         v-road-tax-cur    = v-road-tax-cur    + tt-aht-ot-line.crsa-road-tax-base
     1163         v-road-tax-doc    = v-road-tax-doc    + tt-aht-ot-line.sale-road-tax-base
     1164         v-slt-acc         = v-slt-acc         + tt-aht-ot-line.cost-slt-base
     1165         v-slt-cur         = v-slt-cur         + tt-aht-ot-line.crsa-slt-base
     1166         v-slt-doc         = v-slt-doc         + tt-aht-ot-line.sale-slt-base
     1167       .
     1168         case x-analysis.cral-id :
     1169           when 1
     1170           then do:
     1171               run calc-qnty (output v-sum).
     1172           end.
     1173           when 2
     1174           then do:
     1175               run calc-str-oborot ( "rubl" , "cost" , "with-vat" , output v-sum).
     1176           end.
     1177           when 3
     1178           then do:
     1179               run calc-str-oborot ( "rubl" , "sale" , "with-vat" , output v-sum).
     1180           end.
     1181           when 4
     1182           then do:
     1183               run calc-str-oborot ( "rubl" , "crsa" , "with-vat" , output v-sum).
     1184           end.
     1185           when 5
     1186           then do:
     1187             run calc-str-oborot ( "base" , "cost" , "with-vat" , output v-sum).
     1188           end.
     1189           when 6
     1190           then do:
     1191               run calc-str-oborot ( "base" , "sale" , "with-vat" , output v-sum).
     1192           end.
     1193           when 7
     1194           then do:
     1195               run calc-str-oborot ( "base" , "crsa" , "with-vat" , output v-sum).
     1196           end.
     1197           when 8
     1198           then do:
     1199             run calc-str-prib ( "rubl" , "sale" , "cost" , "without-vat" , output v-sum).
     1200           end.
     1201           when 9
     1202           then do:
     1203               run calc-str-prib ( "base" , "sale" , "cost" , "without-vat" , output v-sum).
     1204           end.
     1205           when 10
     1206           then do:
     1207                 run calc-str-prib ( "rubl" , "sale" , "cost" , "with-vat" , output v-sum).
     1208           end.
     1209           when 11
     1210           then do:
     1211                 run calc-str-prib ( "base" , "sale" , "cost" , "with-vat" , output v-sum).
     1212           end.
     1213           when 12
     1214           then do:
     1215                 run calc-str-prib ( "rubl" , "crsa" , "cost" , "without-vat" , output v-sum).
     1216           end.
     1217           when 13
     1218           then do:
     1219                 run calc-str-prib ( "base" , "crsa" , "cost" , "without-vat" , output v-sum).
     1220           end.
     1221           when 14
     1222           then do:
     1223                 run calc-str-prib ( "rubl" , "crsa" , "cost" , "with-vat" , output v-sum).
     1224           end.
     1225           when 15
     1226           then do:
     1227                   run calc-str-prib ( "base" , "crsa" , "cost" , "with-vat" , output v-sum).
     1228           end.
     1229         end case.
     1230        v-sum-crit = v-sum-crit + v-sum .
     1231     find first temp-xyz where
     1232                temp-xyz.gds-code = p-gds-code and
     1233                temp-xyz.num-per  = tt-aht-ot-line.num-per no-error .
     1234          if not available  temp-xyz  then do:
     1235             create temp-xyz.
     1236             assign
     1237               temp-xyz.gds-code   = p-gds-code
     1238               temp-xyz.num-per    = tt-aht-ot-line.num-per
     1239               temp-xyz.sum-crit-p = (-1) * v-sum
     1240             .
     1241          end.
     1242          else
     1243             assign
     1244               temp-xyz.sum-crit-p = temp-xyz.sum-crit-p - v-sum
     1245             .
     1246   end.
     1247   assign
     1248     v-sum-crit      = (-1) * v-sum-crit
     1249     v-sum-qnty      = (-1) * v-sum-qnty
     1250     v-sum-acc       = (-1) * v-sum-acc
     1251     v-sum-cur       = (-1) * v-sum-cur
     1252     v-sum-doc       = (-1) * v-sum-doc
     1253     v-vat-acc       = (-1) * v-vat-acc
     1254     v-vat-cur       = (-1) * v-vat-cur
     1255     v-vat-doc       = (-1) * v-vat-doc
     1256     v-transport-acc = (-1) * v-transport-acc
     1257     v-transport-cur = (-1) * v-transport-cur
     1258     v-transport-doc = (-1) * v-transport-doc
     1259     v-other-acc     = (-1) * v-other-acc
     1260     v-other-cur     = (-1) * v-other-cur
     1261     v-other-doc     = (-1) * v-other-doc
     1262     v-road-tax-acc  = (-1) * v-road-tax-acc
     1263     v-road-tax-cur  = (-1) * v-road-tax-cur
     1264     v-road-tax-doc  = (-1) * v-road-tax-doc
     1265     v-slt-acc       = (-1) * v-slt-acc
     1266     v-slt-cur       = (-1) * v-slt-cur
     1267     v-slt-doc       = (-1) * v-slt-doc
     1268   .
     1269   end.
     1270   end procedure.
     1271   procedure calc-str-oborot :
     1272     do
     1273     on error undo, return error return-value
     1274     :
     1275   define input  parameter p-val as character no-undo .
     1276   define input  parameter p-sum-type as character no-undo .
     1277   define input  parameter p-vat as character no-undo .
     1278   define output parameter p-sum as decimal   no-undo .
     1279     case p-val :
     1280        when "rubl" then do:
     1281               case p-sum-type :
     1282                 when "crsa" then do:
     1283                       p-sum = tt-aht-ot-line.crsa-sum-rubl.
     1284                 end.
     1285                 when "cost" then do:
     1286                       p-sum = tt-aht-ot-line.cost-sum-rubl.
     1287                 end.
     1288                 when "sale" then do:
     1289                       p-sum = tt-aht-ot-line.sale-sum-rubl.
     1290                 end.
     1291               end case.
     1292        end.
     1293        when "base" then do:
     1294               case p-sum-type :
     1295                 when "crsa" then do:
     1296                       p-sum = tt-aht-ot-line.crsa-sum-base.
     1297                 end.
     1298                 when "cost" then do:
     1299                       p-sum = tt-aht-ot-line.cost-sum-base.
     1300                 end.
     1301                 when "sale" then do:
     1302                       p-sum = tt-aht-ot-line.sale-sum-base.
     1303                 end.
     1304               end case.
     1305        end.
     1306     end case.
     1307     end.
     1308   end procedure.
     1309   procedure calc-str-prib :
     1310     do
     1311     on error undo, return error return-value
     1312     :
     1313   define input  parameter p-val as character no-undo .
     1314   define input  parameter p-sum-type1 as character no-undo .
     1315   define input  parameter p-sum-type2 as character no-undo .
     1316   define input  parameter p-vat as character no-undo .
     1317   define output parameter p-sum as decimal   no-undo .
     1318         if p-vat = "with-vat" then do:
     1319           case p-val :
     1320             when "rubl" then do:
     1321                     case p-sum-type1 :
     1322                       when "crsa" then do:
     1323                             p-sum = tt-aht-ot-line.crsa-sum-rubl - tt-aht-ot-line.cost-sum-rubl.
     1324                       end.
     1325                       when "sale" then do:
     1326                             p-sum = tt-aht-ot-line.sale-sum-rubl - tt-aht-ot-line.cost-sum-rubl.
     1327                       end.
     1328                     end case.
     1329             end.
     1330             when "base" then do:
     1331                     case p-sum-type1 :
     1332                       when "crsa" then do:
     1333                             p-sum = tt-aht-ot-line.crsa-sum-base - tt-aht-ot-line.cost-sum-base.
     1334                       end.
     1335                       when "sale" then do:
     1336                             p-sum = tt-aht-ot-line.sale-sum-base - tt-aht-ot-line.cost-sum-base.
     1337                       end.
     1338                     end case.
     1339             end.
     1340           end case.
     1341         end.
     1342         else do:
     1343           case p-val :
     1344             when "rubl" then do:
     1345                     case p-sum-type1 :
     1346                       when "crsa" then do:
     1347                             p-sum = (tt-aht-ot-line.crsa-sum-rubl - tt-aht-ot-line.crsa-vat-rubl - tt-aht-ot-line.crsa-slt-rubl ) -
     1348                                     (tt-aht-ot-line.cost-sum-rubl - tt-aht-ot-line.cost-vat-rubl - tt-aht-ot-line.cost-slt-rubl ) .
     1349                       end.
     1350                       when "sale" then do:
     1351                             p-sum = ( tt-aht-ot-line.sale-sum-rubl - tt-aht-ot-line.sale-vat-rubl - tt-aht-ot-line.sale-slt-rubl ) -
     1352                                     ( tt-aht-ot-line.cost-sum-rubl - tt-aht-ot-line.cost-vat-rubl - tt-aht-ot-line.cost-slt-rubl ).
     1353                       end.
     1354                     end case.
     1355             end.
     1356             when "base" then do:
     1357                     case p-sum-type1 :
     1358                       when "crsa" then do:
     1359                             p-sum = (tt-aht-ot-line.crsa-sum-base - tt-aht-ot-line.crsa-vat-base - tt-aht-ot-line.crsa-slt-base ) -
     1360                                     (tt-aht-ot-line.cost-sum-base - tt-aht-ot-line.cost-vat-base - tt-aht-ot-line.cost-slt-base ) .
     1361                       end.
     1362                       when "sale" then do:
     1363                             p-sum = ( tt-aht-ot-line.sale-sum-base - tt-aht-ot-line.sale-vat-base - tt-aht-ot-line.sale-slt-base ) -
     1364                                     ( tt-aht-ot-line.cost-sum-base - tt-aht-ot-line.cost-vat-base - tt-aht-ot-line.cost-slt-base ).
     1365                       end.
     1366                     end case.
     1367             end.
     1368           end case.
     1369         end.
     1370     end.
     1371   end procedure.
     1372   procedure calc-qnty :
     1373   do
     1374   on error undo, return error return-value
     1375   :
     1376   define output parameter p-sum as decimal   no-undo .
     1377     p-sum = tt-aht-ot-line.fact-qnty.
     1378   end.
     1379   end procedure.
     1380   procedure ver-aht :
     1381     do
     1382     on error undo, return error return-value
     1383     :
     1384   define output parameter v-total-archive-ok as logical   no-undo  .
     1385   define variable  v-archive-ok  as logical   no-undo .
     1386   define variable  v-comment    as character no-undo .
     1387   define variable  v-can-print  as logical   no-undo .
     1388   for each x-analysis-period break by x-analysis-period.xyzp-start desc :
     1389    v-date-1 = x-analysis-period.xyzp-start.
     1390   end.
     1391   for each x-analysis-period break by x-analysis-period.xyzp-end  :
     1392    v-date-2 = x-analysis-period.xyzp-end.
     1393   end.
     1394   for each x-analysis-period break by x-analysis-period.xyzp-start desc :
     1395    v-day = v-day + ( x-analysis-period.xyzp-end -  x-analysis-period.xyzp-start + 1) .
     1396   end.
     1397   if v-day = 0 or v-day = ? then v-day = 1.
     1398   v-total-archive-ok =  true .
     1399       for each x-analysis-obj :
     1400         run rep/chk-ahz.p
     1401           (input        x-analysis-obj.obj-type
     1402           ,input        x-analysis-obj.obj-code
     1403           ,input        false
     1404           ,input        false
     1405           ,input        false
     1406           ,input        true
     1407           ,input        true
     1408           ,input        v-cntxt-db-num
     1409           ,input        v-cntxt-userid
     1410           ,input-output v-date-1
     1411           ,input-output v-date-2
     1412           ,output       v-archive-ok
     1413           ,output       v-comment
     1414           ,output       v-can-print
     1415           ) .
     1416         if v-archive-ok = false  then
     1417         do:
     1418               if v-can-print = false
     1419               then do:
     1420                 message
     1421                   "ВНИМАНИЕ !!!" skip
     1422                   "Анализ не может быть сформирован!" skip
     1423                   "На запрошенную дату нет архивов или они сжаты" skip
     1424                   v-date-1 v-date-2 skip
     1425                   v-comment skip
     1426                   view-as alert-box information .
     1427                   return error return-value .
     1428               end.
     1429               else do:
     1430                 assign
     1431                   v-total-archive-ok = false
     1432                 .
     1433                 leave .
     1434               end.
     1435         end.
     1436       end.
     1437       if v-total-archive-ok = false
     1438       then do:
     1439         define variable v-period-description as character no-undo .
     1440           assign
     1441             v-period-description = substitute("с начала дня &1 по конец дня &2"
     1442                                              ,string(v-date-1, '99/99/9999':u)
     1443                                              ,string(v-date-2,   '99/99/9999':u)
     1444                                              )
     1445           .
     1446         message
     1447           "ВНИМАНИЕ!" skip
     1448           v-comment skip
     1449           "" skip
     1450           "Данные по выбранному периоду" v-period-description "могут быть неполными или некорректными." skip
     1451           "Продолжить формирование анализа?" skip
     1452           view-as alert-box question buttons yes-no update choice as logical  .
     1453             if choice = false
     1454             then do:
     1455               assign
     1456                 v-archive-ok = false
     1457               .
     1458               return.
     1459             end.
     1460             else do:
     1461               assign
     1462                 v-total-archive-ok = true
     1463               .
     1464             end.
     1465       end.
     1466     end.
     1467   end procedure.
     1468   procedure def-order :
     1469     do
     1470     on error undo, return error return-value
     1471     :
     1472   define input  parameter p-obj-type  as character no-undo .
     1473   define input  parameter p-obj-code  as integer   no-undo .
     1474   define input  parameter p-artic     as char   no-undo .
     1475   define input  parameter p-prod-type as character no-undo .
     1476   define input  parameter p-prod-code as integer   no-undo .
     1477   define output parameter v-qnty       as decimal   no-undo .
     1478   define buffer buf-ord-line for ub.ord-line.
     1479   define buffer buf-ord-doc  for ub.ord-doc.
     1480         for each buf-ord-line no-lock where
     1481                 buf-ord-line.artic          =   p-artic     and
     1482                 buf-ord-line.prod-type      =   p-prod-type and
     1483                 buf-ord-line.prod-code      =   p-prod-code  ,
     1484             first buf-ord-doc no-lock where
     1485                   buf-ord-doc.doc-code      =   buf-ord-line.doc-code and
     1486                   buf-ord-doc.obj-type      =   p-obj-type  and
     1487                   buf-ord-doc.obj-code      =   p-obj-code  and
     1488                   buf-ord-doc.status_       <>  'факт':U     and
     1489                   buf-ord-doc.status_       <>  'новый':U  and
     1490                   buf-ord-doc.doc-date      <=   v-date-2   and
     1491                   buf-ord-doc.doc-date      >=   v-date-1
     1492                   :
     1493             for each x-analysis-period :
     1494               if buf-ord-doc.doc-date >= x-analysis-period.xyzp-start and
     1495                  buf-ord-doc.doc-date <= x-analysis-period.xyzp-end
     1496                   then do:
     1497                     v-qnty =  v-qnty + buf-ord-line.qnty .
     1498                   end.
     1499             end.
     1500         end.
     1501     end.
     1502   end procedure.
     1503   procedure save-table-xyz :
     1504     do
     1505     on error undo, return error return-value
     1506     :
     1507   define variable v-all-sum as decimal   no-undo .
     1508   define variable v-all-qnty as decimal   no-undo .
     1509   define variable v-a-sum  as decimal   no-undo .
     1510   define variable v-a-qnty as decimal   no-undo .
     1511   define variable v-b-sum  as decimal   no-undo .
     1512   define variable v-b-qnty as decimal   no-undo .
     1513   define variable v-c-sum  as decimal   no-undo .
     1514   define variable v-c-qnty as decimal   no-undo .
     1515   run waitfram-show ("Сохранение результатов анализа по объектам в БД...").
     1516   for each temp-oborot ,
     1517       first temp-goods where
     1518             temp-goods.gds-code = temp-oborot.gds-code and
     1519             temp-goods.sum-crit > 0
     1520           :
     1521           create ub.xyz-analysis-gds-obj.
     1522           assign
     1523             ub.xyz-analysis-gds-obj.xyz-id                  =  p-id
     1524             ub.xyz-analysis-gds-obj.db-num                  =  p-db-num
     1525             ub.xyz-analysis-gds-obj.gds-code                =  temp-oborot.gds-code
     1526             ub.xyz-analysis-gds-obj.obj-code                =  temp-oborot.obj-code
     1527             ub.xyz-analysis-gds-obj.obj-type                =  temp-oborot.obj-type
     1528             ub.xyz-analysis-gds-obj.xyog-other-acc          =  temp-oborot.other-acc
     1529             ub.xyz-analysis-gds-obj.xyog-other-cur          =  temp-oborot.other-cur
     1530             ub.xyz-analysis-gds-obj.xyog-other-doc          =  temp-oborot.other-doc
     1531             ub.xyz-analysis-gds-obj.xyog-qnty               =  temp-oborot.qnty
     1532             ub.xyz-analysis-gds-obj.xyog-price-crc          =  temp-oborot.price-crc
     1533             ub.xyz-analysis-gds-obj.xyog-reserve-day        =  temp-oborot.reserve-day
     1534             ub.xyz-analysis-gds-obj.xyog-road-tax-acc       =  temp-oborot.road-tax-acc
     1535             ub.xyz-analysis-gds-obj.xyog-road-tax-cur       =  temp-oborot.road-tax-cur
     1536             ub.xyz-analysis-gds-obj.xyog-road-tax-doc       =  temp-oborot.road-tax-doc
     1537             ub.xyz-analysis-gds-obj.xyog-slt-acc            =  temp-oborot.slt-acc
     1538             ub.xyz-analysis-gds-obj.xyog-slt-cur            =  temp-oborot.slt-cur
     1539             ub.xyz-analysis-gds-obj.xyog-slt-doc            =  temp-oborot.slt-doc
     1540             ub.xyz-analysis-gds-obj.xyog-stock-qnty         =  temp-oborot.stock-qnty
     1541             ub.xyz-analysis-gds-obj.xyog-sum-acc            =  temp-oborot.sum-acc
     1542             ub.xyz-analysis-gds-obj.xyog-sum-cur            =  temp-oborot.sum-cur
     1543             ub.xyz-analysis-gds-obj.xyog-sum-doc            =  temp-oborot.sum-doc
     1544             ub.xyz-analysis-gds-obj.xyog-transport-acc      =  temp-oborot.transport-acc
     1545             ub.xyz-analysis-gds-obj.xyog-transport-cur      =  temp-oborot.transport-cur
     1546             ub.xyz-analysis-gds-obj.xyog-transport-doc      =  temp-oborot.transport-doc
     1547             ub.xyz-analysis-gds-obj.xyog-vat-acc            =  temp-oborot.vat-acc
     1548             ub.xyz-analysis-gds-obj.xyog-vat-cur            =  temp-oborot.vat-cur
     1549             ub.xyz-analysis-gds-obj.xyog-vat-doc            =  temp-oborot.vat-doc
     1550             ub.xyz-analysis-gds-obj.xyog-temp-sale-goods    =  temp-oborot.qnty / v-day
     1551           .
     1552   end.
     1553   run waitfram-show ("Сохранение результатов анализа по товарам в БД...") .
     1554   for each temp-goods where temp-goods.sum-crit > 0 :
     1555       v-all-sum  = v-all-sum  + temp-goods.sum-crit .
     1556       v-all-qnty = v-all-qnty + 1.
     1557       case temp-goods.crit :
     1558          when "X"
     1559          then do:
     1560               v-a-sum  = v-a-sum  + temp-goods.sum-crit .
     1561               v-a-qnty = v-a-qnty + 1.
     1562          end.
     1563          when "Y"
     1564          then do:
     1565               v-b-sum  = v-b-sum  + temp-goods.sum-crit .
     1566               v-b-qnty = v-b-qnty + 1.
     1567          end.
     1568          when "Z"
     1569          then do:
     1570               v-c-sum  = v-c-sum  + temp-goods.sum-crit .
     1571               v-c-qnty = v-c-qnty + 1.
     1572          end.
     1573       end case.
     1574       create ub.xyz-analysis-goods.
     1575       assign
     1576         ub.xyz-analysis-goods.xyz-id                  = p-id
     1577         ub.xyz-analysis-goods.db-num                  = p-db-num
     1578         ub.xyz-analysis-goods.gds-code                = temp-goods.gds-code
     1579         ub.xyz-analysis-goods.xyzg-xyz                = temp-goods.crit
     1580         ub.xyz-analysis-goods.xyzg-order-qnty         = temp-goods.order-qnty
     1581         ub.xyz-analysis-goods.xyzg-other-acc          = temp-goods.other-acc
     1582         ub.xyz-analysis-goods.xyzg-other-cur          = temp-goods.other-cur
     1583         ub.xyz-analysis-goods.xyzg-other-doc          = temp-goods.other-doc
     1584         ub.xyz-analysis-goods.xyzg-prcnt-for-estimate = temp-goods.crit-pr
     1585         ub.xyz-analysis-goods.xyzg-qnty               = temp-goods.qnty
     1586         ub.xyz-analysis-goods.xyzg-road-tax-acc       = temp-goods.road-tax-acc
     1587         ub.xyz-analysis-goods.xyzg-road-tax-cur       = temp-goods.road-tax-cur
     1588         ub.xyz-analysis-goods.xyzg-road-tax-doc       = temp-goods.road-tax-doc
     1589         ub.xyz-analysis-goods.xyzg-slt-acc            = temp-goods.slt-acc
     1590         ub.xyz-analysis-goods.xyzg-slt-cur            = temp-goods.slt-cur
     1591         ub.xyz-analysis-goods.xyzg-slt-doc            = temp-goods.slt-doc
     1592         ub.xyz-analysis-goods.xyzg-stock-qnty         = temp-goods.stock-qnty
     1593         ub.xyz-analysis-goods.xyzg-stock-price-acc    = temp-goods.stock-price-acc
     1594         ub.xyz-analysis-goods.xyzg-stock-price-sale   = temp-goods.stock-price-sale
     1595         ub.xyz-analysis-goods.xyzg-sum-acc            = temp-goods.sum-acc
     1596         ub.xyz-analysis-goods.xyzg-sum-cur            = temp-goods.sum-cur
     1597         ub.xyz-analysis-goods.xyzg-sum-doc            = temp-goods.sum-doc
     1598         ub.xyz-analysis-goods.xyzg-sum-for-estimate   = temp-goods.sum-crit
     1599         ub.xyz-analysis-goods.xyzg-temp-sale-goods    = temp-goods.qnty / v-day
     1600         ub.xyz-analysis-goods.xyzg-transport-acc      = temp-goods.transport-acc
     1601         ub.xyz-analysis-goods.xyzg-transport-cur      = temp-goods.transport-cur
     1602         ub.xyz-analysis-goods.xyzg-transport-doc      = temp-goods.transport-doc
     1603         ub.xyz-analysis-goods.xyzg-vat-acc            = temp-goods.vat-acc
     1604         ub.xyz-analysis-goods.xyzg-vat-cur            = temp-goods.vat-cur
     1605         ub.xyz-analysis-goods.xyzg-vat-doc            = temp-goods.vat-doc
     1606         ub.xyz-analysis-goods.kol-period              = temp-goods.kol-period
     1607         ub.xyz-analysis-goods.average-qnty            = temp-goods.average-qnty
     1608         ub.xyz-analysis-goods.sigma                   = temp-goods.sigma
     1609         .
     1610   end.
     1611   find current x-analysis  no-error .
     1612   assign
     1613   x-analysis.xyz-x-prc-qnty   = v-a-qnty * 100 / v-all-qnty
     1614   x-analysis.xyz-x-qnty       = v-a-qnty
     1615   x-analysis.xyz-x-sum-prc    = v-a-sum * 100 / v-all-sum
     1616   x-analysis.xyz-x-sum        = v-a-sum
     1617   x-analysis.xyz-y-prc-qnty   = v-b-qnty * 100 / v-all-qnty
     1618   x-analysis.xyz-y-qnty       = v-b-qnty
     1619   x-analysis.xyz-y-sum-prc    = v-b-sum * 100 / v-all-sum
     1620   x-analysis.xyz-y-sum        = v-b-sum
     1621   x-analysis.xyz-z-prc-qnty   = v-c-qnty * 100 / v-all-qnty
     1622   x-analysis.xyz-z-qnty       = v-c-qnty
     1623   x-analysis.xyz-z-sum-prc    = v-c-sum * 100 / v-all-sum
     1624   x-analysis.xyz-z-sum        = v-c-sum
     1625   .
     1626   define variable v-doc-rec as recid no-undo .
     1627   define buffer buf_xyz-analysis for ub.xyz-analysis.
     1628   find first buf_xyz-analysis no-lock where
     1629               buf_xyz-analysis.xyz-id                 = p-id and
     1630               buf_xyz-analysis.db-num                 = p-db-num no-error .
     1631    v-doc-rec = recid(buf_xyz-analysis) .
     1632    run ref/xyzanal1.p (
     1633                   input-output v-doc-rec
     1634                   ,'ИЗМЕНЕНИЕ':U
     1635                   ,buf_XYZ-analysis.XYZ-id
     1636                   ,buf_XYZ-analysis.db-num
     1637                   ,buf_XYZ-analysis.cral-id
     1638                   ,buf_XYZ-analysis.XYZ-name
     1639                   ,buf_XYZ-analysis.XYZ-des
     1640                   ,buf_XYZ-analysis.raxd-x
     1641                   ,buf_XYZ-analysis.raxd-y
     1642                   ,buf_XYZ-analysis.raxd-z
     1643                   ,buf_XYZ-analysis.XYZ-x
     1644                   ,buf_XYZ-analysis.XYZ-y
     1645                   ,buf_XYZ-analysis.XYZ-z
     1646                   ,x-analysis.xyz-x-prc-qnty
     1647                   ,x-analysis.xyz-x-qnty
     1648                   ,x-analysis.xyz-x-sum-prc
     1649                   ,x-analysis.xyz-x-sum
     1650                   ,x-analysis.xyz-y-prc-qnty
     1651                   ,x-analysis.xyz-y-qnty
     1652                   ,x-analysis.xyz-y-sum-prc
     1653                   ,x-analysis.xyz-y-sum
     1654                   ,x-analysis.xyz-z-prc-qnty
     1655                   ,x-analysis.xyz-z-qnty
     1656                   ,x-analysis.xyz-z-sum-prc
     1657                   ,x-analysis.xyz-z-sum
     1658                   ,x-analysis.r-goods
     1659                   ,table x-analysis-doc
     1660                   ,table x-analysis-obj
     1661                   ,table x-analysis-period
     1662                   ) no-error .
     1663   if error-status :error then message
     1664   return-value
     1665   error-status :get-message(1)
     1666   222
     1667   .
     1668   run waitfram-hide in this-procedure .
     1669     end.
     1670   end procedure.
