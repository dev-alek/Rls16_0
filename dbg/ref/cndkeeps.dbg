        1   DEFINE BUFFER X_condition-keeping FOR ub.condition-keeping.
        2   DEFINE BUFFER X_curr_clients FOR ub.clients.
        3   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        4   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo.
        5   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo.
        6   define input parameter bttns  as char   no-undo .
        7   define input parameter p-mode  as char   no-undo .
        8   define input-output parameter p-sts like ub.condition-keeping.sts no-undo .
        9   define input-output param p-rid-list    as  char no-undo .
       10   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       11   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       12   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       13   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       14   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       15   define variable vss-description AS CHAR NO-UNDO INIT "Список УСЛОВИЙ ХРАНЕНИЯ":U.
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   procedure proc-alt-shift-f2:
       86     if not ibs.th.gbl.gbl-var:rcode
       87   then
       88     run gbl\inidebug.p .
       89   end.
       90   procedure proc-alt-shift-f3:
       91     run gbl/prvssinf.p
       92       ( input this-procedure
       93       ) .
       94   end.
       95   define variable v-inform-launched as logical no-undo initial false .
       96   procedure proc-alt-shift-f4:
       97     define variable v-action as character no-undo .
       98     if v-inform-launched = false then do:
       99       assign
      100         v-inform-launched = true
      101       .
      102       run gbl/d-inform.w
      103         (  input self
      104         ,  input this-procedure
      105         , output v-action
      106         ) no-error .
      107       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      108       assign
      109         v-inform-launched = false
      110       .
      111     end.
      112   end.
      113   procedure proc-alt-f1:
      114     run gbl/corrhelp.p
      115       (input this-procedure
      116       ) .
      117   end .
      118   on alt-shift-f2 anywhere do:
      119     run proc-alt-shift-f2.
      120   end.
      121   on alt-shift-f3 anywhere do:
      122     run proc-alt-shift-f3 in this-procedure .
      123   end.
      124   on alt-shift-f4 anywhere do:
      125     run proc-alt-shift-f4 in this-procedure.
      126   end.
      127   on alt-f1 anywhere do:
      128     run proc-alt-f1 in this-procedure .
      129   end.
      130   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      132   define new shared variable RepPathName        as character no-undo .
      133   define new shared variable PrintRubl          as logical   no-undo .
      134   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135   define variable v-waitfram-action01         as character   no-undo .
      136   define variable v-waitfram-action02         as character   no-undo .
      137   define variable v-waitfram-action03         as character   no-undo .
      138   define variable mWaitFramTextBeg            as character   no-undo.
      139   define variable mWaitFramTextEnd            as character   no-undo.
      140   define variable mWaitFramView               as logical     no-undo.
      141   define variable mWaitProcEvent              as logical     no-undo init yes.
      142   define variable mWaitFramInterval           as integer     no-undo init 1 .
      143   define variable mWaitFramStop               as logical     no-undo.
      144   define variable mWaitFramStopUser           as logical     no-undo.
      145   define variable mWaitFramStopTimeOut        as logical     no-undo.
      146   define variable mWaitFramStartProc          as datetime-tz no-undo.
      147   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      148   define button B-WaitFramStop auto-end-key
      149        label "Стоп"
      150        size 10 by 1 tooltip "Остоновить процесс".
      151   define button B-viewProcInfo
      152        label "Информация"
      153        size 15 by 1 tooltip "Информация о процесс".
      154   define frame waitfram
      155     v-waitfram-action01 format "x(72)" no-label skip
      156     v-waitfram-action02 format "x(72)" no-label skip
      157     v-waitfram-action03 format "x(72)" no-label skip
      158     B-viewProcInfo
      159     B-WaitFramStop at row 4 col 30
      160     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      161     .
      162   define new global shared variable mBatchMode as logical no-undo init ?.
      163   define variable mFramBachModHandle as handle no-undo.
      164   mFramBachModHandle = frame waitfram:handle.
      165   define variable mFameOldVis as logical no-undo.
      166   define variable mVisCUrentVin as logical no-undo.
      167   if session:batch-mode
      168   then
      169      mBatchMode = yes.
      170   if mBatchMode = ? then do:
      171     mVisCUrentVin = current-window:visible.
      172     mFameOldVis = mFramBachModHandle:visible.
      173     mFramBachModHandle:visible  = yes.
      174     mBatchMode = mFramBachModHandle:visible ne yes.
      175     mFramBachModHandle:visible = mFameOldVis.
      176     current-window:visible = mVisCUrentVin.
      177   end.
      178    if  log-manager:logfile-name ne ?
      179     then DO:
      180         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      181         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      182         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      183     end.
      184   on choose of B-WaitFramStop in frame waitfram
      185   do:
      186     mWaitFramStop = yes.
      187     mWaitFramStopUser = yes.
      188   end.
      189   function waitfram-check-timeout returns logical():
      190      define variable vtime as int64 no-undo.
      191      if mWaitFramStopTimeOut
      192      then
      193         return yes.
      194      vtime = ( now - mWaitFramStartProc ) / 1000 .
      195      if     mWaitFramTimeOut ne ?
      196         and mWaitFramTimeOut ne 0
      197         and mWaitFramTimeOut lt vtime
      198      then do:
      199         mWaitFramStopTimeOut = yes.
      200      end.
      201      return mWaitFramStopTimeOut.
      202   end.
      203   procedure waitfram-hide :
      204     if not session:batch-mode
      205     then do
      206     on error undo, return error return-value
      207     :
      208       pause 0 before-hide .
      209       if not mBatchMode then
      210         hide frame waitfram .
      211     if     not mWaitFramView
      212        and mWaitProcEvent
      213     then
      214       process events .
      215     end.
      216   end procedure.
      217   procedure waitfram-show :
      218     define input  parameter p-message as character no-undo .
      219     define variable v-left-margin as integer   no-undo .
      220     if not session:batch-mode
      221     then do
      222     on error undo, return error return-value
      223     :
      224       if length(p-message) <= 70 then do:
      225         assign
      226           v-left-margin = integer((70 - length(p-message)) / 2)
      227         .
      228         assign
      229           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      230         .
      231         assign
      232           v-waitfram-action01 = " "
      233           v-waitfram-action02 = " "
      234                                    + fill(" ", v-left-margin)
      235                                    + p-message
      236           v-waitfram-action03 = " "
      237         .
      238       end.
      239       else do:
      240         define variable vRindex1 as integer no-undo.
      241         define variable vRindex2 as integer no-undo.
      242         vRindex1 = r-index(p-message," ",70).
      243         if vRindex1 = 0
      244         then
      245            vRindex1 = 70.
      246         if length(p-message)  <= vRindex1 + 70 then do:
      247           assign
      248             v-waitfram-action01 = " "
      249             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      250             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      251           .
      252         end.
      253         else do:
      254           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      255           if vRindex2 <= vRindex1
      256           then
      257              vRindex2 = vRindex1 + 70.
      258           assign
      259             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      260             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      261             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      262           .
      263         end.
      264       end.
      265       B-viewProcInfo:visible   in frame waitfram = no.
      266       B-viewProcInfo:sensitive in frame waitfram = no.
      267       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      268       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      269       if  (   mWaitFramView
      270          or  mWaitProcEvent)
      271          and not mBatchMode
      272       then
      273          display
      274             v-waitfram-action01 skip
      275             v-waitfram-action02 skip
      276             v-waitfram-action03 skip
      277          with frame waitfram .
      278       if     mWaitFramView
      279          then do:
      280             if     mWaitFramInterval ne ?
      281                and not mBatchMode
      282             then
      283                wait-for go of frame waitfram pause mWaitFramInterval.
      284          end.
      285          else
      286             if     mWaitProcEvent
      287                and not mBatchMode
      288             then
      289                process events .
      290     end.
      291   end procedure.
      292      procedure waitfram-show-this:
      293         define input  parameter iInterval as int64 no-undo.
      294         define variable vtime as int64 no-undo.
      295         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      296         mWaitFramInterval = iInterval.
      297         run waitfram-show (substitute("&1&2 &3&4" ,
      298                                       mWaitFramTextBeg ,
      299                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      300                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      301                                       mWaitFramTextEnd
      302                                      )
      303                           ).
      304      end.
      305      procedure WaitFramRunPause:
      306         define input  parameter iInterval as dec no-undo.
      307         define variable vStart  as datetime-tz no-undo.
      308         define variable vend    as datetime-tz no-undo.
      309         define variable vint as int64 no-undo.
      310         define variable vOk as logical no-undo.
      311         vStart = now.
      312         vend   = vStart.
      313         publish "WaitFramPause" (iInterval,output vOk).
      314         vend   =  now.
      315         vint = vend - vStart.
      316         vint = iInterval - vint / 1000.
      317         if     not mWaitFramStop
      318            and (   vint > 0
      319                 or (    not vOk
      320                     and iInterval eq ?
      321                     )
      322                 )
      323         then
      324            run waitfram-show-this (iInterval).
      325         vend   =  now.
      326         vint = vend - vStart.
      327         vint = iInterval - vint / 1000.
      328         if     not mWaitFramStop
      329            and vint > 0
      330         then do:
      331            run gbl/pause.p (vint * 1000).
      332         end.
      333         if iInterval ne ?
      334         then
      335            publish "WaitFramStop".
      336         waitfram-check-timeout().
      337      end.
      338      procedure WaitFramWaitFor:
      339         define input  parameter iInterval as dec no-undo.
      340         assign
      341            mWaitFramStartProc   = now
      342            mWaitFramStopUser    = no
      343            mWaitFramStopTimeOut = no
      344         .
      345         block-wait:
      346         do while not mWaitFramStop:
      347            run WaitFramRunPause (iInterval).
      348            if  waitfram-check-timeout()
      349            then do:
      350               leave block-wait.
      351            end.
      352         end.
      353         run waitfram-hide.
      354      end.
      355   procedure waitfram-join :
      356     define input  parameter p-line-1  as character no-undo .
      357     define input  parameter p-line-2  as character no-undo .
      358     define input  parameter p-line-3  as character no-undo .
      359     define output parameter p-message as character no-undo .
      360     do
      361     on error undo, return error return-value
      362     :
      363       assign
      364         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      365                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      366                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      367       .
      368     end.
      369   end procedure.
      370   function waitfram-join-function returns character
      371     (input p-line-1 as character
      372     ,input p-line-2 as character
      373     ,input p-line-3 as character
      374     ).
      375     define variable v-message as character no-undo .
      376     run waitfram-join in this-procedure
      377       (input  p-line-1
      378       ,input  p-line-2
      379       ,input  p-line-3
      380       ,output v-message
      381       ) .
      382     return v-message .
      383   end function .
      384   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      385   define  stream PrnLibStream.
      386   procedure prn-lib-prn-file :
      387     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      388     define input parameter p-DIsabledoptions as integer no-undo .
      389     define variable v-report-name as character no-undo .
      390     define variable v-user-action as character no-undo .
      391     define variable v-printed     as logical   no-undo .
      392     define variable v-exist       as logical   no-undo .
      393     do
      394       on error undo, return error
      395       :
      396       run prn-lib-get-report-name  in this-procedure (
      397         input parParentProc
      398         ,output v-report-name
      399         ).
      400   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      401   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      402     (input  v-report-name
      403     ,input  2
      404     ,output v-exist
      405     )  .
      406       if NOT v-exist then
      407       DO:
      408         Message
      409           "Нет заданий на печать ! "
      410           view-as alert-box .
      411         Return  .
      412       End.
      413       run gbl/prnfilen.w
      414         (input  ""
      415         ,input  p-DisabledOptions
      416         ,input  string(v-report-name )
      417         ,input  7
      418         ,output v-user-action
      419         ,output v-printed
      420         ) .
      421       if v-printed then
      422       do:
      423         return "YES" .
      424       end.
      425       else
      426       do:
      427         return "NO" .
      428       end.
      429     end.
      430   end procedure.
      431   procedure prn-lib-open-stream :
      432     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      433     define input parameter p-page-size    as integer no-undo .
      434     define input parameter p-is-stream    as logical no-undo .
      435     define input parameter p-append       as logical no-undo .
      436     define variable v-report-name as character no-undo .
      437     do
      438       on error undo, return error
      439       :
      440       run prn-lib-get-report-name  in this-procedure (
      441         input parParentProc
      442         ,output v-report-name
      443         ).
      444       if p-is-stream then
      445       do:
      446         if p-append then
      447         do:
      448           output stream PrnLibStream to value( v-report-name )
      449             page-size value(p-page-size) append .
      450         end.
      451         if not p-append then
      452         do:
      453           output stream PrnLibStream to value( v-report-name )
      454             page-size value(p-page-size) .
      455         end.
      456       end.
      457       if not p-is-stream then
      458       do:
      459         if p-append then
      460         do:
      461           output to value( v-report-name )
      462             page-size value(p-page-size) append .
      463         end.
      464         if not p-append then
      465         do:
      466           output to value( v-report-name )
      467             page-size value(p-page-size) .
      468         end.
      469       end.
      470     end.
      471   end procedure.
      472   procedure prn-lib-open-exp :
      473     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      474     define input parameter p-is-stream    as logical no-undo .
      475     define input parameter p-is-append    as logical no-undo .
      476     define output parameter p-ReportFileName as char init "report" no-undo.
      477     define output parameter p-process as logical no-undo .
      478     define variable glog as logical no-undo .
      479     do
      480       on error undo, return error
      481       :
      482       SYSTEM-DIALOG GET-FILE p-ReportFileName
      483         TITLE      "Укажите путь"
      484         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      485         ASK-OVERWRITE
      486         CREATE-TEST-FILE
      487         SAVE-AS
      488         USE-FILENAME
      489         DEFAULT-EXTENSION "txt"
      490         UPDATE glog
      491         .
      492       if not glog then  return.
      493       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      494       if p-is-stream then
      495       do:
      496         if p-is-append then
      497         do:
      498           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      499         end.
      500         else
      501         do:
      502           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      503         end.
      504       end.
      505       else
      506       do:
      507         if p-is-append then
      508         do:
      509           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      510         end.
      511         else
      512         do:
      513           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      514         end.
      515       end.
      516       p-process = yes.
      517     end.
      518   end procedure.
      519   procedure prn-lib-get-report-name :
      520     define input parameter parParentProc  as widget-handle no-undo.
      521     define output parameter p-report-name as character no-undo .
      522     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      523   end procedure.
      524   procedure prn-lib-reportviewer-report-name :
      525     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      526     define input parameter p-report-name-html as character no-undo .
      527     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      528   end procedure.
      529   procedure prn-lib-reportviewer :
      530     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      531     define input parameter p-report-name-html as character no-undo .
      532     define input parameter p-param        as character no-undo .
      533     define variable v-excel           as character no-undo init 'TRUE' .
      534     define variable v-value-character as character no-undo .
      535     define variable v-value-integer   as character no-undo .
      536     define variable v-value-date      as date      no-undo .
      537     define variable v-value-decimal   as decimal   no-undo .
      538     define variable rep-excel         as logical   no-undo .
      539     define variable excel-string      as character no-undo .
      540     define variable v-param-type      as character no-undo .
      541     define variable v-tth             as handle    no-undo .
      542     run adm/shattri.p (
      543       input "get":U
      544       ,input  ""
      545       ,input  0
      546       ,input  'report-glob':U
      547       ,input  'rep-excel':U
      548       ,output v-value-character
      549       ,output v-value-date
      550       ,output v-value-decimal
      551       ,output v-value-integer
      552       ,output rep-excel
      553       ,output v-param-type
      554       ,INPUT-OUTPUT table-handle v-tth
      555       )  .
      556     if rep-excel then v-excel = "TRUE" .
      557     else v-excel = "FALSE" .
      558     if p-param eq ""
      559     then
      560        p-param = "EXCEL:" + v-excel.
      561     else
      562        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      563     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      564   end procedure.
      565   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      566   procedure cur-time :
      567      define output parameter p-today as date      no-undo .
      568      define output parameter p-time  as integer   no-undo .
      569     do
      570     on error undo, return error
      571     :
      572       define variable v-date1 as date      no-undo .
      573       define variable v-date2 as date      no-undo .
      574       define variable v-time  as integer   no-undo .
      575       assign
      576         v-date1 = today
      577         v-time  = time
      578         v-date2 = today
      579       .
      580       if v-date1 <> v-date2
      581       then do:
      582         assign
      583           v-date1 = today
      584           v-time  = v-time
      585         .
      586       end.
      587       assign
      588         p-today = v-date1
      589         p-time  = v-time
      590       .
      591     end.
      592   end.
      593   function cur-time-date returns character
      594   :
      595     return string(today, '99/99/9999':U) .
      596   end.
      597   function cur-time-mjd returns decimal
      598   :
      599     define variable v-date as date      no-undo .
      600     define variable v-time as integer   no-undo .
      601     run cur-time in this-procedure
      602       (output v-date
      603       ,output v-time
      604       ) .
      605     return integer(v-date) - 2400002 + (v-time / 86400) .
      606   end.
      607   function cur-time-get-ending-index returns integer
      608   (input p-number as integer
      609   )
      610   :
      611     if p-number < 0
      612     or p-number = ?
      613     then do:
      614       return 1 .
      615     end.
      616     define variable v-rest as integer   no-undo .
      617     assign
      618       p-number = p-number modulo 100
      619     .
      620     if p-number < 20
      621     then do:
      622       assign
      623         v-rest = p-number
      624       .
      625     end.
      626     else do:
      627       assign
      628         v-rest = p-number modulo 10
      629       .
      630     end.
      631     case v-rest :
      632       when 1
      633       then do:
      634         return 2 .
      635       end.
      636       when 2 or
      637       when 3 or
      638       when 4
      639       then do:
      640         return 3 .
      641       end.
      642       otherwise do:
      643         return 1 .
      644       end.
      645     end case .
      646   end.
      647   procedure cur-time-mjd-to-date :
      648      define input  parameter i-mjd-diff as decimal no-undo.
      649      define output parameter o-Date     as date    no-undo.
      650      define output parameter o-Time     as integer no-undo.
      651      define variable v-day-number as integer   no-undo .
      652      if    i-mjd-diff < 0
      653         or i-mjd-diff = ?
      654      then do:
      655         return "?" .
      656      end.
      657      assign
      658         v-day-number = truncate(i-mjd-diff,0).
      659         o-Date = date(v-day-number + 2400002).
      660         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      661     .
      662   end.
      663   function cur-time-mjd-to-string returns character
      664   (input p-mjd-diff as decimal
      665   )
      666   :
      667     define variable v-day-number as integer   no-undo .
      668     define variable v-seconds    as integer   no-undo .
      669     define variable v-hour       as integer   no-undo .
      670     define variable v-min        as integer   no-undo .
      671     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      672     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      673     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      674     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      675     if p-mjd-diff < 0
      676     or p-mjd-diff = ?
      677     then do:
      678       return "?" .
      679     end.
      680     assign
      681       v-day-number = integer(truncate(p-mjd-diff,0))
      682       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      683     .
      684     if v-seconds > 86400
      685     then do:
      686       assign
      687         v-seconds = 86400 - 1
      688       .
      689     end.
      690     if v-seconds < 0
      691     then do:
      692       assign
      693         v-seconds = 0
      694       .
      695     end.
      696     assign
      697       v-hour = truncate(v-seconds / 3600, 0)
      698     .
      699     assign
      700       v-seconds = v-seconds modulo 3600
      701     .
      702     assign
      703       v-min = truncate(v-seconds / 60, 0)
      704     .
      705     assign
      706       v-seconds = v-seconds modulo 60
      707     .
      708     return
      709         (if v-day-number <> 0
      710           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      711           else ""
      712         )
      713       + (if v-day-number <> 0 or v-hour <> 0
      714           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      715           else ""
      716         )
      717       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      718           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      719           else ""
      720         )
      721       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      722       .
      723   end.
      724   function cur-time-string returns character
      725   :
      726     define variable v-date as date      no-undo .
      727     define variable v-time as integer   no-undo .
      728     run cur-time in this-procedure
      729       (output v-date
      730       ,output v-time
      731       ) .
      732     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      733   end.
      734   function cur-time-string-sec returns character
      735   :
      736     define variable v-date as date      no-undo .
      737     define variable v-time as integer   no-undo .
      738     run cur-time in this-procedure
      739       (output v-date
      740       ,output v-time
      741       ) .
      742     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      743   end.
      744   function cur-time-custom  returns character
      745   (input p-prefix as character
      746   ,input p-date-format as character
      747   ,input p-delimiter as character
      748   ,input p-time-format as character
      749   ,input p-suffix as character
      750   )
      751   :
      752     define variable v-date as date      no-undo .
      753     define variable v-time as integer   no-undo .
      754     run cur-time in this-procedure
      755       (output v-date
      756       ,output v-time
      757       ) .
      758     return
      759       p-prefix
      760       + string(v-date, p-date-format)
      761       + p-delimiter
      762       + string(v-time, p-time-format)
      763       + p-suffix
      764       .
      765   end.
      766   function cur-time-print  returns character
      767   :
      768     define variable v-date as date      no-undo .
      769     define variable v-time as integer   no-undo .
      770     run cur-time in this-procedure
      771       (output v-date
      772       ,output v-time
      773       ) .
      774     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      775   end.
      776   function cur-time-datetime returns datetime
      777   :
      778     define variable v-char as character no-undo .
      779     define variable v-datetime as datetime no-undo .
      780     v-char = cur-time-string().
      781     v-datetime = datetime(v-char).
      782     return  v-datetime.
      783   end.
      784   function cur-time-string-msec returns character
      785   :
      786     define variable v-date as datetime  no-undo .
      787     v-date = now.
      788     return string(v-date) .
      789   end.
      790   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      791     define variable v-cntxt-db-num        as integer   no-undo .
      792     define variable v-cntxt-userid        as character no-undo .
      793     define variable v-cntxt-level         as character no-undo .
      794     define variable v-cntxt-host-code-obj as integer   no-undo .
      795     define variable v-cntxt-obj-type      as character no-undo .
      796     define variable v-cntxt-obj-code      as integer   no-undo .
      797     define variable v-cntxt-db-num-obj    as integer   no-undo .
      798     define variable v-cntxt-is-admin      as logical   no-undo .
      799   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      800   FUNCTION mark-string RETURNS CHARACTER
      801     ( input p-recid as recid, input mark-list as character  ) :
      802     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      803   END FUNCTION.
      804   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      805   define variable sort-column-name as character no-undo .
      806   define variable v-db-num LIKE ub.db.db-num no-undo.
      807   define variable v-rid-list as character no-undo .
      808   define buffer pos_condition-keeping for ub.condition-keeping.
      809   DEFINE BUTTON B-add
      810        LABEL "&Добавить"
      811        SIZE 10 BY 1.
      812   DEFINE BUTTON B-chg
      813        LABEL "&Изменить"
      814        SIZE 10 BY 1.
      815   DEFINE BUTTON B-del
      816        LABEL "&Удалить"
      817        SIZE 10 BY 1.
      818   DEFINE BUTTON B-Help
      819        LABEL "Помо&щь"
      820        SIZE 3 BY 1
      821        BGCOLOR 8 .
      822   DEFINE BUTTON B-hist
      823        LABEL "Ис&тория"
      824        SIZE 3 BY 1.
      825   DEFINE BUTTON B-lookup
      826        LABEL "&Просмотр"
      827        SIZE 10 BY 1.
      828   DEFINE BUTTON B-mark
      829        LABEL "&*"
      830        SIZE 3 BY 1.
      831   DEFINE BUTTON B-print
      832        LABEL "Пе&чать"
      833        SIZE 3 BY 1.
      834   DEFINE BUTTON b-quit AUTO-END-KEY
      835        LABEL "&Выход"
      836        SIZE 10 BY 1
      837        BGCOLOR 8 .
      838   DEFINE BUTTON B-sel AUTO-GO
      839        LABEL "Вы&бор"
      840        SIZE 10 BY 1.
      841   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
      842         VIEW-AS TEXT
      843        SIZE 6 BY 1
      844        FGCOLOR 4  NO-UNDO.
      845   DEFINE VARIABLE RS-sts AS CHARACTER
      846        VIEW-AS RADIO-SET HORIZONTAL
      847        RADIO-BUTTONS
      848             "Item 1", "1",
      849   "Item 2", "2",
      850   "Item 3", "3"
      851        SIZE 33.5 BY 1 NO-UNDO.
      852   DEFINE QUERY br-condkeep FOR
      853         X_condition-keeping SCROLLING.
      854   DEFINE BROWSE br-condkeep
      855     QUERY br-condkeep NO-LOCK DISPLAY
      856         mark-string(recid(X_condition-keeping), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
      857         X_condition-keeping.cond-keep-name FORMAT "X(50)":U
      858         X_condition-keeping.des FORMAT "X(255)":U
      859         entry (lookup (STRING(X_condition-keeping.sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) COLUMN-LABEL "Статус"
      860         X_condition-keeping.t-mode-from FORMAT "->>9.99":U
      861         X_condition-keeping.t-mode-to FORMAT "->>9.99":U
      862         X_condition-keeping.h-mode-from FORMAT ">>9.99":U
      863         X_condition-keeping.h-mode-to FORMAT ">>9.99":U
      864         X_condition-keeping.cond-keep-code FORMAT ">>9":U
      865       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 18.
      866   DEFINE FRAME Dialog-Frame
      867        b-quit AT ROW 1 COL 1
      868        B-mark AT ROW 1 COL 11
      869        B-sel AT ROW 1 COL 21
      870        B-add AT ROW 1 COL 31
      871        B-lookup AT ROW 1 COL 41
      872        B-chg AT ROW 1 COL 51
      873        B-del AT ROW 1 COL 61
      874        B-print AT ROW 1 COL 89
      875        B-hist AT ROW 1 COL 92
      876        B-Help AT ROW 1 COL 95
      877        RS-sts AT ROW 2.5 COL 3.5 NO-LABEL
      878        br-condkeep AT ROW 4 COL 1
      879        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
      880        SPACE(78.62) SKIP(20.03)
      881       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      882            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      883            TITLE "Условия хранения"
      884            CANCEL-BUTTON b-quit.
      885   ASSIGN
      886          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      887          FRAME Dialog-Frame:HIDDEN           = TRUE.
      888   ON GO OF FRAME Dialog-Frame
      889   DO:
