      895                              input b-mark:sensitive
      896                             , input v-rid-list) no-error.
      897     if error-status:error then return no-apply.
      898     APPLY "END-ERROR":U TO SELF.
      899   END.
      900   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      901   DO:
      902   define variable loc#log as logical no-undo.
      903   define variable loc-doc-rec as recid no-undo .
      904   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      905   do:
      906     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      907       (input  v-cntxt-db-num
      908       ,input  v-cntxt-userid
      909       ,input  0
      910       ,input  'actn_delivery-storage_work':U
      911       ,input  'global':U
      912       ,input  0
      913       ,input  '':U
      914       ,input  0
      915       ,input  0
      916       ,input  0
      917       ,input  0
      918       ,input  true
      919       ,output loc#log
      920       )  .
      921   end.
      922   if not loc#log then return no-apply.
      923   run ref/cndkeepi.w
      924                 (
      925                    input parParentProc
      926                   ,input p-curr-obj-type
      927                   ,input p-curr-obj-code
      928                   ,input 'ДОБАВЛЕНИЕ':U
      929                   ,input 0
      930                   ,input-output loc-doc-rec
      931                               ) no-error
      932   .
      933   if loc-doc-rec <> ? THEN DO:
      934       RUn OpenBR in this-procedure .
      935       reposition br-condkeep to recid loc-doc-rec no-error.
      936       if error-status:error then do:                           find first pos_condition-keeping no-lock where                                   recid(pos_condition-keeping) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи УСЛОВИЙ ХРАНЕНИЯ" skip                            string(if avail pos_condition-keeping                                     then  substitute("Вн код условий хранения: &1"                                                     , pos_condition-keeping.cond-keep-code)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
      937   END.
      938   apply "entry" to br-condkeep in frame Dialog-Frame.
      939   apply "value-changed" to br-condkeep in frame Dialog-Frame.
      940   END.
      941   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
      942   DO:
      943     DEFINE variable loc#log as logical no-undo.
      944   define variable loc-doc-rec as recid no-undo .
      945   if not available X_condition-keeping then return no-apply.
      946   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      947   do:
      948     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      949       (input  v-cntxt-db-num
      950       ,input  v-cntxt-userid
      951       ,input  0
      952       ,input  'actn_delivery-storage_work':U
      953       ,input  'global':U
      954       ,input  0
      955       ,input  '':U
      956       ,input  0
      957       ,input  0
      958       ,input  0
      959       ,input  0
      960       ,input  true
      961       ,output loc#log
      962       )  .
      963   end.
      964   if not loc#log then return no-apply.
      965   assign
      966   loc-doc-rec = recid(X_condition-keeping).
      967   run ref/cndkeepi.w
      968                 (
      969                    input parParentProc
      970                   ,input p-curr-obj-type
      971                   ,input p-curr-obj-code
      972                   ,input 'ИЗМЕНЕНИЕ':U
      973                   ,input X_condition-keeping.cond-keep-code
      974                   ,input-output loc-doc-rec
      975                               ) no-error
      976   .
      977   if loc-doc-rec <> ? then do:
      978     RUn OpenBR in this-procedure .
      979     reposition br-condkeep to recid loc-doc-rec no-error.
      980     if error-status:error then do:                           find first pos_condition-keeping no-lock where                                   recid(pos_condition-keeping) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи УСЛОВИЙ ХРАНЕНИЯ" skip                            string(if avail pos_condition-keeping                                     then  substitute("Вн код условий хранения: &1"                                                     , pos_condition-keeping.cond-keep-code)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
      981   end.
      982   apply "entry" to br-condkeep in frame Dialog-Frame.
      983   apply "value-changed" to br-condkeep in frame Dialog-Frame.
      984   END.
      985   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      986   DO:
      987       run proc-b-del in this-procedure no-error.
      988     if error-status:error then return no-apply.
      989   END.
      990   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
      991   DO:
      992     define variable loc-doc-rec as recid no-undo .
      993   define variable v-rid-list as character no-undo.
      994     if NOT available X_condition-keeping then return no-apply.
      995     loc-doc-rec = recid (X_condition-keeping).
      996     .
      997     run ref/ccnkeeps.w
      998                   (
      999                    input parParentProc
     1000                   ,input p-curr-obj-type
     1001                   ,input p-curr-obj-code
     1002                   ,input "":U
     1003                   ,input "one":U
     1004                   ,input X_condition-keeping.cond-keep-code
     1005                   ,input-output v-rid-list
     1006                                 )
     1007   .
     1008     reposition br-condkeep to recid loc-doc-rec no-error.
     1009     apply "entry" to br-condkeep in frame Dialog-Frame.
     1010     apply "value-changed" to br-condkeep in frame Dialog-Frame.
     1011   END.
     1012   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1013   DO:
     1014     DEFINE variable loc#log as logical no-undo.
     1015   define variable loc-doc-rec as recid no-undo .
     1016   if not available X_condition-keeping then return no-apply.
     1017   assign
     1018   loc-doc-rec = recid(X_condition-keeping).
     1019   run ref/cndkeepi.w
     1020                 (
     1021                    input parParentProc
     1022                   ,input p-curr-obj-type
     1023                   ,input p-curr-obj-code
     1024                   ,input 'ПРОСМОТР':U
     1025                   ,input X_condition-keeping.cond-keep-code
     1026                   ,input-output loc-doc-rec
     1027                               )
     1028   .
     1029   apply "entry" to br-condkeep in frame Dialog-Frame.
     1030   END.
     1031   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1032   DO:
     1033     define variable loc#log as logical no-undo .
     1034     if available X_condition-keeping then do:
     1035   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1036   define variable v-str-recid10 as character no-undo .
     1037   define variable v-num-entry10 as integer   no-undo .
     1038   assign
     1039     v-str-recid10 = trim( string( recid( X_condition-keeping ) , "->>>>>>>>>>>9":U ) )
     1040     v-num-entry10 = lookup( v-str-recid10 , v-rid-list )
     1041   .
     1042   if v-num-entry10 > 0 then do:
     1043     assign
     1044       entry( v-num-entry10, v-rid-list ) = "":U
     1045       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1046     .
     1047   end.
     1048   else do:
     1049     assign
     1050       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid10
     1051     .
     1052   end.
     1053       loc#log = br-condkeep:refresh() .
     1054       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1055           loc#log = br-condkeep:select-next-row ().
     1056           apply "VALUE-CHANGED" to br-condkeep in frame Dialog-Frame.
     1057       end.
     1058       if num-entries( v-rid-list ) = 0
     1059       then
     1060           hide mark-num in frame Dialog-Frame.
     1061       else
     1062           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1063     end.
     1064     apply "entry" to br-condkeep in frame Dialog-Frame.
     1065   END.
     1066   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1067   DO:
     1068     run proc-b-print in this-procedure no-error.
     1069     if error-status:error then do:
     1070       return no-apply.
     1071     end.
     1072     APPLY "ENTRY" to br-condkeep.
     1073   END.
     1074   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1075   DO:
     1076       if ( available X_condition-keeping ) then do:
     1077       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1078       then
     1079       v-rid-list = string( recid( X_condition-keeping ) ) .
     1080     end.
     1081   END.
     1082   ON RETURN OF br-condkeep IN FRAME Dialog-Frame
     1083   or MOUSE-SELECT-DBLCLICK OF br-condkeep IN FRAME Dialog-Frame
     1084       DO:
     1085       run proc-br-condkeep no-error.
     1086     if error-status:error then return no-apply.
     1087   END.
     1088   ON VALUE-CHANGED OF RS-sts IN FRAME Dialog-Frame
     1089   DO:
     1090     ASSIGN
     1091     rs-sts
     1092     p-sts = (IF rs-sts = 'все':U THEN ? ELSE INTEGER(rs-sts))
     1093     .
     1094     RUN openbr IN THIS-PROCEDURE NO-ERROR.
     1095     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1096   END.
     1097   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1098   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1099   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1100   on help of frame Dialog-Frame
     1101   do:
     1102     run gbl/app_help.p
     1103       (input this-procedure :file-name
     1104       ,input ''
     1105       ,input ?
     1106       ) no-error.
     1107     if error-status :error then do:
     1108       message
     1109         "Ошибка при вызове помощи"
     1110         error-status :get-message(1)
     1111         view-as alert-box .
     1112     end.
     1113   end.
     1114   run minbtn-set in this-procedure .
     1115   on choose of b-help in frame Dialog-Frame
     1116   do:
     1117     apply "help":u to frame Dialog-Frame .
     1118   end.
     1119   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1120   procedure minbtn-set :
     1121       do
     1122           on error undo, return error return-value
     1123           :
     1124           define variable ii              as integer       no-undo .
     1125           define variable fh              as widget-handle no-undo .
     1126           define variable hh              as widget-handle no-undo .
     1127           define variable v-h             as handle        extent 4 no-undo .
     1128           define variable v-name-button   as character     no-undo .
     1129           define variable v-help-old-x    as decimal       no-undo .
     1130           define variable v-help-old-y    as decimal       no-undo .
     1131           define variable v-help-old-size as decimal       no-undo .
     1132           define variable v-frame-width   as decimal       no-undo .
     1133           define variable jj              as integer       no-undo .
     1134           do
     1135               on error undo, return error
     1136               :
     1137               assign
     1138                   v-frame-width = frame Dialog-Frame:width - 0.3
     1139                   fh            = frame Dialog-Frame:first-child
     1140                   hh            = fh:first-child
     1141                   ii            = 1
     1142                   .
     1143               do while valid-handle(hh):
     1144                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1145                   do:
     1146                       case lc(hh:name) :
     1147                           when "b-help" then
     1148                               do:
     1149                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1150                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1151                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1152                                   hh:TOOLTIP = "Помощь" .
     1153                                   v-help-old-x = hh:column .
     1154                                   v-help-old-y = hh:row    .
     1155                                   v-help-old-size = hh:width .
     1156                                   hh:width-chars = 2.5 .
     1157                               end.
     1158                           when "b-print" then
     1159                               do:
     1160                                   hh:load-image("cmp/b-print.bmp":u) .
     1161                                   hh:TOOLTIP = "Печать" .
     1162                                   v-h[ii] = hh:handle .
     1163                                   ii = ii + 1 .
     1164                                   hh:width-chars = 3 .
     1165                               end.
     1166                           when "b-history" or
     1167                           when "b-hist" then
     1168                               do:
     1169                                   hh:load-image("cmp/b-hist.bmp":u) .
     1170                                   hh:TOOLTIP = "История" .
     1171                                   v-h[ii] = hh:handle .
     1172                                   ii = ii + 1 .
     1173                                   hh:width-chars = 3 .
     1174                               end.
     1175                           when "b-sch" then
     1176                               do:
     1177                                   hh:load-image("cmp/b-sch.bmp":u) .
     1178                                   hh:TOOLTIP = "Установка Фильтра" .
     1179                                   v-h[ii] = hh:handle .
     1180                                   ii = ii + 1 .
     1181                                   hh:width-chars = 3 .
     1182                               end.
     1183                           when "b-hist-user" then
     1184                               do:
     1185                                   hh:load-image("cmp/b-hist.bmp":u) .
     1186                                   hh:TOOLTIP = "История пользователя" .
     1187                                   ii = ii + 1 .
     1188                               end.
     1189                       end case.
     1190                   end.
     1191                   hh = hh:next-sibling.
     1192               end.
     1193               b-help:column = v-frame-width - b-help:width-chars.
     1194               jj = 0.
     1195               repeat ii = 4 to 1 by -1 :
     1196                   if valid-handle (v-h[ii] ) then
     1197                   do:
     1198                       jj  = jj + 1 .
     1199                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1200                       v-h[ii]:row    = v-help-old-y .
     1201                   end.
     1202               end.
     1203           end.
     1204       end.
     1205   end procedure.
     1206   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1207   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1208   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1209   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1210   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1211   define variable v-diasize-current-frame-height as decimal   no-undo .
     1212   define variable v-diasize-change-size          as logical   no-undo .
     1213   define variable v-diasize-resize-button        as handle    no-undo .
     1214   define variable v-diasize-wndmax               as logical   no-undo .
     1215   define variable v-diasize-wndstore             as logical   no-undo .
     1216   define variable v-diasize-proc-name            as character no-undo .
     1217   define variable v-diasize-browse-handle        as handle    no-undo .
     1218   define variable v-diasize-browse-number        as integer   no-undo .
     1219   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1220   define temp-table temp-diasize-handle no-undo
     1221     field handle-value  as handle
     1222     field save-position as decimal
     1223     index xpk is primary unique handle-value
     1224     .
     1225   define temp-table temp-browse-handle no-undo
     1226     field browse-type   as character
     1227     field browse-number as integer
     1228     field browse-handle as handle
     1229     field original-size as decimal
     1230     index xpk is primary unique browse-type browse-number
     1231     index xie browse-type browse-handle
     1232   .
     1233   procedure diasize_change-height :
     1234     define input  parameter p-change-value  as decimal   no-undo .
     1235     define input  parameter p-move-resize   as logical   no-undo .
     1236     define variable v-field-group-handle    as handle    no-undo .
     1237     define variable v-object-handle         as handle    no-undo .
     1238     define variable v-frame-height          as decimal   no-undo .
     1239     define variable v-frame-virtual-height  as decimal   no-undo .
     1240     define variable v-browse-height         as decimal   no-undo .
     1241     define variable v-window-height         as decimal   no-undo .
     1242     define variable v-window-virtual-height as decimal   no-undo .
     1243     define variable v-change-sign           as integer   no-undo .
     1244     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1245     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1246     if p-change-value > 0
     1247     then do:
     1248       if frame Dialog-Frame :height + p-change-value
     1249           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1250       then do:
     1251         assign
     1252           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1253                           - (frame Dialog-Frame :height-chars)
     1254         .
     1255         if p-change-value <= 0
     1256         then do:
     1257           run diasize_position-resize-button in this-procedure .
     1258           return .
     1259         end.
     1260       end.
     1261     end.
     1262     if p-change-value < 0
     1263     then do:
     1264       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1265       then do:
     1266         assign
     1267           p-change-value = v-diasize-orig-frame-height
     1268                          - (frame Dialog-Frame :height-chars)
     1269         .
     1270         if p-change-value >= 0
     1271         then do:
     1272           run diasize_position-resize-button in this-procedure .
     1273           return .
     1274         end.
     1275       end.
     1276     end.
     1277     if p-change-value >= 0
     1278     then do:
     1279       assign
     1280         v-change-sign = 1
     1281       .
     1282     end.
     1283     else do:
     1284       assign
     1285         v-change-sign = -1
     1286       .
     1287     end.
     1288     assign
     1289       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1290     .
     1291     if p-change-value = 0
     1292     then do:
     1293       run diasize_position-resize-button in this-procedure .
     1294       return .
     1295     end.
     1296     move_block:
     1297     do
     1298     on error undo move_block, retry move_block
     1299     :
     1300       if retry
     1301       then do:
     1302         do
     1303         on error undo move_block, leave move_block
     1304         :
     1305           if p-change-value > 0
     1306           then do:
     1307             for each buf_temp-diasize-handle
     1308             on error undo, next
     1309             :
     1310               assign
     1311                 v-object-handle = buf_temp-diasize-handle.handle-value
     1312               .
     1313               if v-object-handle <> v-diasize-resize-button
     1314               then do:
     1315                 assign
     1316                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1317                 .
     1318               end.
     1319             end.
     1320             assign
     1321               v-diasize-browse-handle :height = v-browse-height
     1322             .
     1323             for each buf_temp-browse-handle
     1324               where buf_temp-browse-handle.browse-type = 'height':u
     1325             on error undo, next
     1326             :
     1327               assign
     1328                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1329               .
     1330             end.
     1331             assign
     1332               frame Dialog-Frame :height = v-frame-height
     1333             .
     1334             if frame Dialog-Frame :scrollable = true
     1335             then do:
     1336               assign
     1337                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1338               .
     1339             end.
     1340             run diasize_position-resize-button in this-procedure .
     1341           end.
     1342           else do:
     1343             if frame Dialog-Frame :scrollable = true
     1344             then do:
     1345               assign
     1346                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1347               .
     1348             end.
     1349             assign
     1350               frame Dialog-Frame :height = v-frame-height
     1351             .
     1352             assign
     1353               v-diasize-browse-handle :height = v-browse-height
     1354             .
     1355             for each buf_temp-browse-handle
     1356               where buf_temp-browse-handle.browse-type = 'height':u
     1357             on error undo, next
     1358             :
     1359               assign
     1360                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1361               .
     1362             end.
     1363             for each buf_temp-diasize-handle
     1364             on error undo, next
     1365             :
     1366               assign
     1367                 v-object-handle = buf_temp-diasize-handle.handle-value
     1368               .
     1369               if v-object-handle <> v-diasize-resize-button
     1370               then do:
     1371                 assign
     1372                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1373                 .
     1374               end.
     1375             end.
     1376             run diasize_position-resize-button in this-procedure .
     1377           end.
     1378           assign
     1379             v-diasize-change-size = false
     1380           .
     1381           leave move_block .
     1382         end.
     1383       end.
     1384       assign
     1385         v-diasize-need-full-display = true
     1386       .
     1387       if v-diasize-change-size = false
     1388       then do:
     1389         assign
     1390           v-diasize-change-size = true
     1391         .
     1392       end.
     1393       else do:
     1394         return .
     1395       end.
     1396       assign
     1397         v-frame-height = frame Dialog-Frame :height
     1398         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1399         v-browse-height = v-diasize-browse-handle :height
     1400       .
     1401       for each buf_temp-browse-handle
     1402         where buf_temp-browse-handle.browse-type = 'height':u
     1403       :
     1404         assign
     1405           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1406         .
     1407       end.
     1408       for each buf_temp-diasize-handle
     1409       :
     1410         delete buf_temp-diasize-handle .
     1411       end.
     1412       assign
     1413         v-field-group-handle = frame Dialog-Frame :first-child
     1414       .
     1415       do while valid-handle(v-field-group-handle)
     1416       :
     1417         assign
     1418           v-object-handle = v-field-group-handle :first-child
     1419         .
     1420         do while valid-handle(v-object-handle)
     1421         :
     1422           if  v-object-handle <> v-diasize-browse-handle :handle
     1423           and can-query(v-object-handle, "row")
     1424           and can-query(v-object-handle, "height")
     1425           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1426           then do:
     1427             find first buf_temp-browse-handle
     1428               where buf_temp-browse-handle.browse-type   = 'height':u
     1429                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1430               no-error .
     1431             if available buf_temp-browse-handle
     1432             then do:
     1433             end.
     1434             else do:
     1435               create buf_temp-diasize-handle .
     1436               assign
     1437                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1438                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1439               .
     1440             end.
     1441           end.
     1442           assign
     1443             v-object-handle = v-object-handle :next-sibling
     1444           .
     1445         end.
     1446         assign
     1447           v-field-group-handle = v-field-group-handle :next-sibling
     1448         .
     1449       end.
     1450       do with frame Dialog-Frame
     1451       :
     1452         hide v-diasize-resize-button .
     1453         assign
     1454           v-diasize-resize-button :row    = 1
     1455           v-diasize-resize-button :column = 1
     1456         .
     1457       end.
     1458       if p-change-value > 0
     1459       then do:
     1460         if frame Dialog-Frame :scrollable = true
     1461         then do:
     1462           assign
     1463             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1464             no-error .
     1465           if error-status :error
     1466           or error-status :get-message(1) <> ""
     1467           then do:
     1468             undo move_block, retry move_block .
     1469           end.
     1470         end.
     1471         assign
     1472           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1473           no-error .
     1474         if error-status :error
     1475         or error-status :get-message(1) <> ""
     1476         then do:
     1477           undo move_block, retry move_block .
     1478         end.
     1479         assign
     1480           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1481           no-error .
     1482         if error-status :error
     1483         or error-status :get-message(1) <> ""
     1484         then do:
     1485           undo move_block, retry move_block .
     1486         end.
     1487         for each buf_temp-browse-handle
     1488           where buf_temp-browse-handle.browse-type = 'height':u
     1489         on error undo move_block, retry move_block
     1490         :
     1491           assign
     1492             buf_temp-browse-handle.browse-handle :height
     1493               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1494             no-error .
     1495           if error-status :error
     1496           or error-status :get-message(1) <> ""
     1497           then do:
     1498             undo move_block, retry move_block .
     1499           end.
     1500         end.
     1501         for each buf_temp-diasize-handle
     1502         on error undo move_block, retry move_block
     1503         :
     1504           assign
     1505             v-object-handle = buf_temp-diasize-handle.handle-value
     1506           .
     1507           if v-object-handle <> v-diasize-resize-button
     1508           then do:
     1509             assign
     1510               v-object-handle :row = v-object-handle :row + p-change-value
     1511               no-error .
     1512             if error-status :error
     1513             or error-status :get-message(1) <> ""
     1514             then do:
     1515               undo move_block, retry move_block .
     1516             end.
     1517           end.
     1518         end.
     1519       end.
     1520       else do:
     1521         for each buf_temp-diasize-handle
     1522         on error undo move_block, retry move_block
     1523         :
     1524           assign
     1525             v-object-handle = buf_temp-diasize-handle.handle-value
     1526           .
     1527           if v-object-handle <> v-diasize-resize-button
     1528           then do:
     1529             assign
     1530               v-object-handle :row = v-object-handle :row + p-change-value
     1531               no-error .
     1532             if error-status :error
     1533             or error-status :get-message(1) <> ""
     1534             then do:
     1535               undo move_block, retry move_block .
     1536             end.
     1537           end.
     1538         end.
     1539         assign
     1540           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1541           no-error .
     1542         if error-status :error
     1543         or error-status :get-message(1) <> ""
     1544         then do:
     1545           undo move_block, retry move_block .
     1546         end.
     1547         for each buf_temp-browse-handle
     1548           where buf_temp-browse-handle.browse-type = 'height':u
     1549         on error undo move_block, retry move_block
     1550         :
     1551           assign
     1552             buf_temp-browse-handle.browse-handle :height
     1553               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1554             no-error .
     1555           if error-status :error
     1556           or error-status :get-message(1) <> ""
     1557           then do:
     1558             undo move_block, retry move_block .
     1559           end.
     1560         end.
     1561         assign
     1562           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1563           no-error .
     1564         if error-status :error
     1565         or error-status :get-message(1) <> ""
     1566         then do:
     1567           undo move_block, retry move_block .
     1568         end.
     1569         if frame Dialog-Frame :scrollable = true
     1570         then do:
     1571           assign
     1572             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1573             no-error .
     1574           if error-status :error
     1575           or error-status :get-message(1) <> ""
     1576           then do:
     1577             undo move_block, retry move_block .
     1578           end.
     1579         end.
     1580       end.
     1581       if p-move-resize = true
     1582       then do:
     1583         run diasize_position-resize-button in this-procedure .
     1584       end.
     1585       if v-diasize-wndstore = true
     1586       then do:
     1587         if connected("ub") = true
     1588         then do:
     1589           define variable v-cntxt-db-num        as integer   no-undo .
     1590           define variable v-cntxt-userid        as character no-undo .
     1591           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1592                                             , OUTPUT v-cntxt-userid
     1593                                             ) .
     1594           run gbl/wndsizew.p
     1595             (input  v-cntxt-db-num
     1596             ,input  v-cntxt-userid
     1597             ,input  v-diasize-proc-name
     1598             ,input  'height':u
     1599             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1600             ) .
     1601         end.
     1602       end.
     1603     end.
     1604     assign
     1605       v-diasize-change-size = false
     1606     .
     1607   end procedure.
     1608   procedure diasize_set-height :
     1609     define input  parameter p-new-height  as decimal   no-undo .
     1610     define input  parameter p-move-resize as logical   no-undo .
     1611     do
     1612     on error undo, return error return-value
     1613     :
     1614       run diasize_change-height in this-procedure
     1615         (input  (p-new-height - frame Dialog-Frame :height)
     1616         ,input  p-move-resize
     1617         ) .
     1618     end.
     1619   end procedure.
     1620   procedure diasize_change-width :
     1621     define input  parameter p-change-value as decimal   no-undo .
     1622     define input  parameter p-move-resize  as logical   no-undo .
     1623     define variable v-field-group-handle   as handle    no-undo .
     1624     define variable v-object-handle        as handle    no-undo .
     1625     define variable v-frame-width          as decimal   no-undo .
     1626     define variable v-frame-virtual-width  as decimal   no-undo .
     1627     define variable v-browse-width         as decimal   no-undo .
     1628     define variable v-window-width         as decimal   no-undo .
     1629     define variable v-window-virtual-width as decimal   no-undo .
     1630     define variable v-change-sign          as integer   no-undo .
     1631     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1632     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1633     if p-change-value > 0
     1634     then do:
     1635       if frame Dialog-Frame :width + p-change-value >
     1636           session :width-chars
     1637       then do:
     1638         assign
     1639           p-change-value = session :width-chars - frame Dialog-Frame :width
     1640         .
     1641         if p-change-value <= 0
     1642         then do:
     1643           run diasize_position-resize-button in this-procedure .
     1644           return .
     1645         end.
     1646       end.
     1647     end.
     1648     if p-change-value < 0
     1649     then do:
     1650       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1651       then do:
     1652         assign
     1653           p-change-value = v-diasize-orig-frame-width
     1654                          - frame Dialog-Frame :width
     1655         .
     1656         if p-change-value >= 0
     1657         then do:
     1658           run diasize_position-resize-button in this-procedure .
     1659           return .
     1660         end.
     1661       end.
     1662     end.
     1663     if p-change-value >= 0
     1664     then do:
     1665       assign
     1666         v-change-sign = 1
     1667       .
     1668     end.
     1669     else do:
     1670       assign
     1671         v-change-sign = -1
     1672       .
     1673     end.
     1674     assign
     1675       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1676     .
     1677     if p-change-value = 0
     1678     then do:
     1679       run diasize_position-resize-button in this-procedure .
     1680       return .
     1681     end.
     1682     move_block:
     1683     do
     1684     on error undo move_block, leave move_block
     1685     :
     1686       if retry
     1687       then do:
     1688         do
     1689         on error undo move_block, leave move_block
     1690         :
     1691           if p-change-value > 0
     1692           then do:
     1693             for each buf_temp-diasize-handle
     1694             on error undo, next
     1695             :
     1696               assign
     1697                 v-object-handle = buf_temp-diasize-handle.handle-value
     1698               .
     1699               if v-object-handle <> v-diasize-resize-button
     1700               then do:
     1701                 assign
     1702                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1703                 .
     1704               end.
     1705             end.
     1706             assign
     1707               v-diasize-browse-handle :width = v-browse-width
     1708             .
     1709             for each buf_temp-browse-handle
     1710               where buf_temp-browse-handle.browse-type = 'width':u
     1711             on error undo, next
     1712             :
     1713               assign
     1714                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1715               .
     1716             end.
     1717             assign
     1718               frame Dialog-Frame :width = v-frame-width
     1719             .
     1720             if frame Dialog-Frame :scrollable = true
     1721             then do:
     1722               assign
     1723                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1724               .
     1725             end.
     1726             run diasize_position-resize-button in this-procedure .
     1727           end.
     1728           else do:
     1729             if frame Dialog-Frame :scrollable = true
     1730             then do:
     1731               assign
     1732                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1733               .
     1734             end.
     1735             assign
     1736               frame Dialog-Frame :width = v-frame-width
     1737             .
     1738             for each buf_temp-browse-handle
     1739               where buf_temp-browse-handle.browse-type = 'width':u
     1740             on error undo, next
     1741             :
     1742               assign
     1743                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1744               .
     1745             end.
     1746             assign
     1747               v-diasize-browse-handle :width = v-browse-width
     1748             .
     1749             for each buf_temp-diasize-handle
     1750             on error undo, next
     1751             :
     1752               assign
     1753                 v-object-handle = buf_temp-diasize-handle.handle-value
     1754               .
     1755               if v-object-handle <> v-diasize-resize-button
     1756               then do:
     1757                 assign
     1758                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1759                 .
     1760               end.
     1761             end.
     1762             run diasize_position-resize-button in this-procedure .
     1763           end.
     1764           assign
     1765             v-diasize-change-size = false
     1766           .
     1767           leave move_block .
     1768         end.
     1769       end.
     1770       assign
     1771         v-diasize-need-full-display = true
     1772       .
     1773       if v-diasize-change-size = false
     1774       then do:
     1775         assign
     1776           v-diasize-change-size = true
     1777         .
     1778       end.
     1779       else do:
     1780         return .
     1781       end.
     1782       assign
     1783         v-frame-width = frame Dialog-Frame :width
     1784         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1785         v-browse-width = v-diasize-browse-handle :width
     1786       .
     1787       for each buf_temp-browse-handle
     1788         where buf_temp-browse-handle.browse-type = 'width':u
     1789       :
     1790         assign
     1791           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1792         .
     1793       end.
     1794       for each buf_temp-diasize-handle
     1795       :
     1796         delete buf_temp-diasize-handle .
     1797       end.
     1798       assign
     1799         v-field-group-handle = frame Dialog-Frame :first-child
     1800       .
     1801       do while valid-handle(v-field-group-handle)
     1802       :
     1803         assign
     1804           v-object-handle = v-field-group-handle :first-child
     1805         .
     1806         do while valid-handle(v-object-handle)
     1807         :
     1808           if  v-object-handle <> v-diasize-browse-handle :handle
     1809           and v-object-handle <> v-diasize-resize-button
     1810           and can-query(v-object-handle, "row")
     1811           and can-query(v-object-handle, "height")
     1812           and ( v-object-handle :col + v-object-handle :width
     1813                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1814               )
     1815           then do:
     1816             find first buf_temp-browse-handle
     1817               where buf_temp-browse-handle.browse-type   = 'width':u
     1818                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1819               no-error .
     1820             if available buf_temp-browse-handle
     1821             then do:
     1822             end.
     1823             else do:
     1824               create buf_temp-diasize-handle .
     1825               assign
     1826                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1827                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1828               .
     1829             end.
     1830           end.
     1831           assign
     1832             v-object-handle = v-object-handle :next-sibling
     1833           .
     1834         end.
     1835         assign
     1836           v-field-group-handle = v-field-group-handle :next-sibling
     1837         .
     1838       end.
     1839       do with frame Dialog-Frame
     1840       :
     1841         hide v-diasize-resize-button .
     1842         v-diasize-resize-button :row = 1.
     1843         v-diasize-resize-button :column = 1.
     1844       end.
     1845       if p-change-value > 0
     1846       then do:
     1847         if frame Dialog-Frame :scrollable = true
     1848         then do:
     1849           assign
     1850             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1851             no-error .
     1852           if error-status :error
     1853           or error-status :get-message(1) <> ""
     1854           then do:
     1855             undo move_block, retry move_block.
     1856           end.
     1857         end.
     1858         assign
     1859           frame Dialog-Frame :width = v-frame-width + p-change-value
     1860           no-error .
     1861         if error-status :error
     1862         or error-status :get-message(1) <> ""
     1863         then do:
     1864           undo move_block, retry move_block.
     1865         end.
     1866         assign
     1867           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1868         no-error .
     1869         if error-status :error
     1870         or error-status :get-message(1) <> ""
     1871         then do:
     1872           undo move_block, retry move_block.
     1873         end.
     1874         for each buf_temp-browse-handle
     1875           where buf_temp-browse-handle.browse-type = 'width':u
     1876         on error undo move_block, retry move_block
     1877         :
     1878           assign
     1879             buf_temp-browse-handle.browse-handle :width
     1880               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1881             no-error .
     1882           if error-status :error
     1883           or error-status :get-message(1) <> ""
     1884           then do:
     1885             undo move_block, retry move_block .
     1886           end.
     1887         end.
     1888         for each buf_temp-diasize-handle
     1889         on error undo move_block, retry move_block
     1890         :
     1891           assign
     1892             v-object-handle = buf_temp-diasize-handle.handle-value
     1893           .
     1894           if v-object-handle <> v-diasize-resize-button
     1895           then do:
     1896             assign
     1897               v-object-handle :col = v-object-handle :col + p-change-value
     1898               no-error .
     1899             if error-status :error
     1900             or error-status :get-message(1) <> ""
     1901             then do:
     1902               undo move_block, retry move_block .
     1903             end.
     1904           end.
     1905         end.
     1906       end.
     1907       else do:
     1908         for each buf_temp-diasize-handle
     1909         on error undo move_block, retry move_block
     1910         :
     1911           assign
     1912             v-object-handle = buf_temp-diasize-handle.handle-value
     1913           .
     1914           if v-object-handle <> v-diasize-resize-button
     1915           then do:
     1916             assign
     1917               v-object-handle :col = v-object-handle :col + p-change-value
     1918               no-error .
     1919             if error-status :error
     1920             or error-status :get-message(1) <> ""
     1921             then do:
     1922               undo move_block, retry move_block .
     1923             end.
     1924           end.
     1925         end.
     1926         for each buf_temp-browse-handle
     1927           where buf_temp-browse-handle.browse-type = 'width':u
     1928         on error undo move_block, retry move_block
     1929         :
     1930           assign
     1931             buf_temp-browse-handle.browse-handle :width
     1932               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1933             no-error .
     1934           if error-status :error
     1935           or error-status :get-message(1) <> ""
     1936           then do:
     1937             undo move_block, retry move_block .
     1938           end.
     1939         end.
     1940         assign
     1941           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1942           no-error .
     1943         if error-status :error
     1944         or error-status :get-message(1) <> ""
     1945         then do:
     1946           undo move_block, retry move_block.
     1947         end.
     1948         assign
     1949           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1950         no-error .
     1951         if error-status :error
     1952         or error-status :get-message(1) <> ""
     1953         then do:
     1954           undo move_block, retry move_block.
     1955         end.
     1956         if frame Dialog-Frame :scrollable = true
     1957         then do:
     1958           assign
     1959             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1960           no-error .
     1961           if error-status :error
     1962           or error-status :get-message(1) <> ""
     1963           then do:
     1964             undo move_block, retry move_block.
     1965           end.
     1966         end.
     1967       end.
     1968       if p-move-resize
     1969       then do:
     1970         run diasize_position-resize-button in this-procedure .
     1971       end.
     1972       if v-diasize-wndstore = true
     1973       then do:
     1974         if connected("ub") = true
     1975         then do:
     1976           define variable v-cntxt-db-num        as integer   no-undo .
     1977           define variable v-cntxt-userid        as character no-undo .
     1978           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1979                                             , OUTPUT v-cntxt-userid
     1980                                             ) .
     1981           run gbl/wndsizew.p
     1982             (input  v-cntxt-db-num
     1983             ,input  v-cntxt-userid
     1984             ,input  v-diasize-proc-name
     1985             ,input  'width':u
     1986             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1987             ) .
     1988         end.
     1989       end.
     1990     end.
     1991     assign
     1992       v-diasize-change-size = false
     1993     .
     1994   end procedure.
     1995   procedure diasize_set-width :
     1996     define input  parameter p-new-width  as decimal   no-undo .
     1997     define input  parameter p-move-resize as logical   no-undo .
     1998     do
     1999     on error undo, return error return-value
     2000     :
     2001       run diasize_change-width in this-procedure
     2002         (input  (p-new-width - frame Dialog-Frame :width)
     2003         ,input  p-move-resize
     2004         ) .
     2005     end.
     2006   end procedure.
     2007   procedure diasize_position-resize-button :
     2008     do with frame Dialog-Frame
     2009     :
     2010       hide v-diasize-resize-button .
     2011       assign
     2012         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2013                     - 1
     2014                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2015         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2016                     - 1
     2017                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2018       .
     2019       view v-diasize-resize-button .
     2020     end.
     2021   end procedure.
     2022   on alt-right anywhere
     2023   do:
     2024     run diasize_change-width in this-procedure
     2025       (input 1
     2026       ,input true
     2027       ) .
     2028     return no-apply .
     2029   end.
     2030   on alt-left anywhere
     2031   do:
     2032     run diasize_change-width in this-procedure
     2033       (input -1
     2034       ,input true
     2035       ) .
     2036     return no-apply .
     2037   end.
     2038   on alt-down anywhere
     2039   do:
     2040     run diasize_change-height in this-procedure
     2041       (input 1
     2042       ,input true
     2043       ) .
     2044     return no-apply .
     2045   end.
     2046   on alt-up anywhere
     2047   do:
     2048     run diasize_change-height in this-procedure
     2049       (input -1
     2050       ,input true
     2051       ) .
     2052     return no-apply .
     2053   end.
     2054   on alt-enter of frame Dialog-Frame
     2055   do:
     2056     run diasize_maximize in this-procedure
     2057       (input  ?
     2058       ).
     2059     return no-apply .
     2060   end.
     2061   procedure diasize_end-move :
     2062     do
     2063     on error undo, return error return-value
     2064     :
     2065       define variable v-row-delta as decimal   no-undo .
     2066       define variable v-col-delta as decimal   no-undo .
     2067       define variable v-new-row as decimal   no-undo .
     2068       define variable v-new-col as decimal   no-undo .
     2069       assign
     2070         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2071         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2072       .
     2073       assign
     2074         v-row-delta = v-new-row - frame Dialog-Frame :height
     2075         v-col-delta = v-new-col - frame Dialog-Frame :width
     2076       .
     2077       run diasize_change-height in this-procedure
     2078         (input v-row-delta
     2079         ,input true
     2080         ) .
     2081       run diasize_change-width in this-procedure
     2082         (input v-col-delta
     2083         ,input true
     2084         ) .
     2085     end.
     2086   end procedure.
     2087   procedure diasize_maximize :
     2088     define input  parameter p-action as logical   no-undo .
     2089     do
     2090     on error undo, return error return-value
     2091     :
     2092       if p-action = ?
     2093       then do:
     2094         if v-diasize-need-maximize = true
     2095         then do:
     2096           assign
     2097             p-action = true
     2098           .
     2099         end.
     2100         else do:
     2101           assign
     2102             p-action = false
     2103           .
     2104         end.
     2105       end.
     2106       if p-action = true
     2107       then do:
     2108         run diasize_change-height in this-procedure
     2109           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2110               - frame Dialog-Frame :height-chars
     2111           ,input true
     2112           ) .
     2113         run diasize_change-width in this-procedure
     2114           (input session :width-chars
     2115               - frame Dialog-Frame :width-chars
     2116           ,input true
     2117           ) .
     2118         assign
     2119           v-diasize-need-maximize = false
     2120         .
     2121       end.
     2122       else do:
     2123         run diasize_change-width in this-procedure
     2124           (input v-diasize-orig-frame-width
     2125               - frame Dialog-Frame :width-chars
     2126           ,input true
     2127           ) .
     2128         run diasize_change-height in this-procedure
     2129           (input v-diasize-orig-frame-height
     2130               - frame Dialog-Frame :height-chars
     2131           ,input true
     2132           ) .
     2133         assign
     2134           v-diasize-need-maximize = true
     2135         .
     2136       end.
     2137     end.
     2138   end procedure.
     2139   procedure diasize_restore-orig-size :
     2140     do
     2141     on error undo, return error return-value
     2142     :
     2143       assign
     2144         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2145         v-diasize-current-frame-height = frame Dialog-Frame :height
     2146       .
     2147       run diasize_set-height in this-procedure
     2148         (input  v-diasize-orig-frame-height
     2149         ,input  true
     2150         ) .
     2151       run diasize_set-width in this-procedure
     2152         (input  v-diasize-orig-frame-width
     2153         ,input  true
     2154         ) .
     2155     end.
     2156   end procedure.
     2157   procedure diasize_restore-current-size :
     2158     do
     2159     on error undo, return error return-value
     2160     :
     2161       run diasize_set-height in this-procedure
     2162         (input  v-diasize-current-frame-height
     2163         ,input  true
     2164         ) .
     2165       run diasize_set-width in this-procedure
     2166         (input  v-diasize-current-frame-width
     2167         ,input  true
     2168         ) .
     2169     end.
     2170   end procedure.
     2171   procedure diasize_set-browse-handle :
     2172     define input  parameter p-browse-handle as handle   no-undo .
     2173     define buffer buf_temp-browse-handle for temp-browse-handle .
     2174     do
     2175     on error undo, return error return-value
     2176     :
     2177       assign
     2178         v-diasize-browse-handle = p-browse-handle
     2179       .
     2180       for each buf_temp-browse-handle
     2181       on error undo, return error return-value
     2182       :
     2183         delete buf_temp-browse-handle .
     2184       end.
     2185     end.
     2186   end procedure.
     2187   procedure diasize_add_browse :
     2188     define input  parameter p-browse-type   as character no-undo .
     2189     define input  parameter p-browse-handle as handle    no-undo .
     2190     define buffer buf_temp-browse-handle for temp-browse-handle .
     2191     do
     2192     on error undo, return error return-value
     2193     :
     2194       assign
     2195         v-diasize-browse-number = v-diasize-browse-number + 1
     2196       .
     2197       create buf_temp-browse-handle .
     2198       assign
     2199         buf_temp-browse-handle.browse-type   = p-browse-type
     2200         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2201         buf_temp-browse-handle.browse-handle = p-browse-handle
     2202       .
     2203     end.
     2204   end procedure.
     2205   procedure diasize_init :
     2206     define variable v-default-value    as logical   no-undo .
     2207     define variable v-restore-saved    as logical   no-undo .
     2208     define variable v-resize-value-str as character no-undo .
     2209     do
     2210     on error undo, return error return-value
     2211     :
     2212       do with frame Dialog-Frame
     2213       :
     2214         assign
     2215           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2216           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2217           v-diasize-browse-handle     = browse br-condkeep :handle
     2218         .
     2219         create button v-diasize-resize-button
     2220         assign
     2221           parent        = frame Dialog-Frame :first-child
     2222           label         = "s"
     2223           height-pixels = 16
     2224           width-pixels  = 16
     2225           visible       = true
     2226           sensitive     = true
     2227           movable       = true
     2228           triggers:
     2229             on end-move persistent run diasize_end-move in this-procedure .
     2230           end triggers.
     2231         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2232         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2233         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2234         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2235         assign
     2236           v-diasize-wndmax = false
     2237         .
     2238         if connected("ub") = true
     2239         then do:
     2240           define variable v-cntxt-db-num        as integer   no-undo .
     2241           define variable v-cntxt-userid        as character no-undo .
     2242           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2243                                             , OUTPUT v-cntxt-userid
     2244                                             ) .
     2245           run gbl/wndpar_r.p
     2246             (input  v-cntxt-db-num
     2247             ,input  v-cntxt-userid
     2248             ,input  'wndmax':U
     2249             ,output v-diasize-wndmax
     2250             ,output v-default-value
     2251             ) .
     2252         end.
     2253         assign
     2254           v-diasize-wndstore = false
     2255         .
     2256         if connected("ub") = true
     2257         then do:
     2258           run gbl/wndpar_r.p
     2259             (input  v-cntxt-db-num
     2260             ,input  v-cntxt-userid
     2261             ,input  'wndstore':U
     2262             ,output v-diasize-wndstore
     2263             ,output v-default-value
     2264             ) .
     2265         end.
     2266         assign
     2267           v-diasize-proc-name = entry(1, program-name(2), '.')
     2268         .
     2269         if v-diasize-wndstore = true
     2270         then do:
     2271           assign
     2272             v-restore-saved = false
     2273           .
     2274           if connected("ub") = true
     2275           then do:
     2276             run gbl/wndsizer.p
     2277               (input  v-cntxt-db-num
     2278               ,input  v-cntxt-userid
     2279               ,input  v-diasize-proc-name
     2280               ,input  'height':u
     2281               ,output v-resize-value-str
     2282               ) .
     2283             if v-resize-value-str <> '':U
     2284             then do:
     2285               run diasize_change-height in this-procedure
     2286                 (input  integer(v-resize-value-str)
     2287                 ,input  true
     2288                 ) .
     2289               assign
     2290                 v-restore-saved = true
     2291               .
     2292             end.
     2293           end.
     2294           if connected("ub") = true
     2295           then do:
     2296             run gbl/wndsizer.p
     2297               (input  v-cntxt-db-num
     2298               ,input  v-cntxt-userid
     2299               ,input  v-diasize-proc-name
     2300               ,input  'width':u
     2301               ,output v-resize-value-str
     2302               ) .
     2303             if v-resize-value-str <> '':U
     2304             then do:
     2305               run diasize_change-width in this-procedure
     2306                 (input  integer(v-resize-value-str)
     2307                 ,input  true
     2308                 ) .
     2309               assign
     2310                 v-restore-saved = true
     2311               .
     2312             end.
     2313           end.
     2314           if v-restore-saved <> true
     2315           then do:
     2316             if v-diasize-wndmax = true
     2317             then do:
     2318               run diasize_maximize in this-procedure
     2319                 (input  true
     2320                 ) .
     2321             end.
     2322           end.
     2323         end.
     2324         else do:
     2325           if v-diasize-wndmax = true
     2326           then do:
     2327             run diasize_maximize in this-procedure
     2328               (input  true
     2329               ) .
     2330           end.
     2331         end.
     2332       end.
     2333     end.
     2334   end procedure.
     2335   procedure diasize_need-full-display :
     2336     define output parameter p-need-full-display as logical   no-undo .
     2337     do
     2338     on error undo, return error return-value
     2339     :
     2340       assign
     2341         p-need-full-display = v-diasize-need-full-display
     2342       .
     2343       assign
     2344         v-diasize-need-full-display = false
     2345       .
     2346     end.
     2347   end procedure.
     2348   procedure get-context :
     2349      define output parameter p-db-num as integer          no-undo.
     2350      define output parameter p-user-id as character        no-undo.
     2351      define variable v-login               as character    no-undo.
     2352      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2353      define buffer buf_user-login  for ub.user-login .
     2354      do
     2355      on error undo, return error
     2356      :
     2357            FIND FIRST buf_sys-ctrl no-lock.
     2358            ASSIGN
     2359               v-login = USERID("ub")
     2360               p-db-num = buf_sys-ctrl.db-num
     2361            .
     2362            FIND FIRST buf_user-login
     2363                 WHERE buf_user-login.db-num = p-db-num
     2364                   AND buf_user-login.user-login = v-login
     2365                 no-lock
     2366                 no-error
     2367                 .
     2368            IF AVAILABLE buf_user-login
     2369            THEN DO:
     2370               assign
     2371                  p-user-id = buf_user-login.user-id
     2372               .
     2373            END.
     2374      end.
     2375   end procedure.
     2376       run diasize_init in this-procedure .
     2377   def var sort-labelbr-condkeep   as character no-undo .
     2378   def var sort-clmnbr-condkeep    as handle    no-undo .
     2379   def var cur-clmnbr-condkeep     as handle    no-undo .
     2380   def var cur-clmn-locbr-condkeep as integer   no-undo .
     2381   def var re-querybr-condkeep     as logical   initial no no-undo .
     2382   on start-search, ctrl-o of br-condkeep in frame Dialog-Frame do:
     2383      run sort-brbr-condkeep
     2384        (input (if available X_condition-keeping
     2385                then recid(X_condition-keeping)
     2386                else ?
     2387               )
     2388        ).
     2389   end.
     2390   PROCEDURE sort-brbr-condkeep :
     2391     define input parameter p-recid as recid no-undo .
     2392     if re-querybr-condkeep = no then do:
     2393       assign
     2394          cur-clmnbr-condkeep = br-condkeep:current-column in frame Dialog-Frame
     2395       .
     2396       if sort-clmnbr-condkeep <> ? then sort-clmnbr-condkeep:column-fgcolor = 0.
     2397       if cur-clmnbr-condkeep = sort-clmnbr-condkeep then do:
     2398         assign
     2399            sort-labelbr-condkeep = ""
     2400            sort-clmnbr-condkeep = ?
     2401         .
     2402        end.
     2403        else do:
     2404          assign
     2405            sort-labelbr-condkeep = cur-clmnbr-condkeep:label
     2406            sort-clmnbr-condkeep  = cur-clmnbr-condkeep
     2407            sort-clmnbr-condkeep:column-fgcolor = 4
     2408          .
     2409        end.
     2410      end.
     2411     assign
     2412       cur-clmn-locbr-condkeep = 1
     2413     .
     2414     def var column-handle as handle no-undo .
     2415     column-handle = br-condkeep:first-column.
     2416     do while valid-handle(column-handle) :
     2417       if column-handle = cur-clmnbr-condkeep then do:
     2418         leave .
     2419       end.
     2420       column-handle = column-handle:NEXT-COLUMN.
     2421       assign
     2422         cur-clmn-locbr-condkeep = cur-clmn-locbr-condkeep + 1
     2423       .
     2424     end.
     2425     case sort-labelbr-condkeep:
     2426           when X_condition-keeping.cond-keep-code:label in browse br-condkeep then DO:   assign     sort-column-name = "X_condition-keeping.cond-keep-code"   .   run OpenBr.   . END.
     2427       otherwise do:
     2428         assign
     2429           sort-column-name = ""
     2430         .
     2431         run OpenBr.
     2432           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-condkeep') then do:
     2433             run mv-brw-defaultbr-condkeep.
     2434           end.
     2435         if sort-labelbr-condkeep <> "" then do:
     2436           assign
     2437             cur-clmnbr-condkeep:column-fgcolor = 0
     2438           .
     2439         end.
     2440         assign
     2441           cur-clmn-locbr-condkeep = ?
     2442         .
     2443       end.
     2444     end case.
     2445       if cur-clmn-locbr-condkeep <> ? then do:
     2446         if can-do( this-procedure:internal-entries, 'ch-clmnbr-condkeep') then do:
     2447           run ch-clmnbr-condkeep in this-procedure (cur-clmn-locbr-condkeep).
     2448         end.
     2449       end.
     2450     if p-recid <> ? then do:
     2451       reposition br-condkeep to recid p-recid no-error.
     2452       apply "value-changed" to br-condkeep in frame Dialog-Frame.
     2453     end.
     2454     apply "entry" to br-condkeep in frame Dialog-Frame.
     2455   END PROCEDURE.
     2456   procedure re-open-query-srt-clmnbr-condkeep:
     2457   if cur-clmnbr-condkeep = ? then do:
     2458      run OpenBr.
     2459   end.
     2460   else do:
     2461      assign re-querybr-condkeep = yes.
     2462      run sort-brbr-condkeep
     2463        (input (if available X_condition-keeping
     2464                then recid(X_condition-keeping)
     2465                else ?
     2466               )
     2467        ).
     2468      assign re-querybr-condkeep = no.
     2469   end.
     2470   end.
     2471   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2472   do:
     2473     br-condkeep :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2474   end.
     2475   MAIN-BLOCK:
     2476   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2477      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2478   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2479     run mainmenu_getcntxt in parparentproc
     2480       (output v-cntxt-db-num
     2481       ,output v-cntxt-userid
     2482       ,output v-cntxt-level
     2483       ,output v-cntxt-host-code-obj
     2484       ,output v-cntxt-obj-type
     2485       ,output v-cntxt-obj-code
     2486       ,output v-cntxt-db-num-obj
     2487       ,output v-cntxt-is-admin
     2488       ) .
     2489     find first X_curr_clients no-lock where
     2490               X_curr_clients.obj-type = p-curr-obj-type
     2491          AND X_curr_clients.obj-code = p-curr-obj-code no-error.
     2492     if not available X_curr_clients then do:
     2493       message
     2494       vss-workfile vss-revision vss-description skip
     2495       "Неверное значение параметра вызова p-curr-obj-type p-curr-obj-code"
     2496       p-curr-obj-type p-curr-obj-code
     2497       view-as alert-box ERROR.
     2498       return error .
     2499     end.
     2500    if LOOKUP(p-mode, 'все':U,
     2501                   chr(4)) = 0
     2502        then dO:
     2503       message
     2504       vss-workfile vss-revision vss-description skip
     2505       "Неверное значение параметров вызова p-mode"
     2506       p-mode
     2507       view-as alert-box ERROR.
     2508       return error .
     2509    end.
     2510    v-rid-list = p-rid-list.
     2511   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2512   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2513     (output v-db-num
     2514     )  .
     2515     RUN MyEnable.
     2516     RUn OpenBR.
     2517     HIDE mark-num in frame Dialog-Frame .
     2518     if v-doc-rec <> ? then
     2519     REPOSITION br-condkeep to recid v-doc-rec No-ERROR.
     2520   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2521   DEF VAR cur-clmn-numbr-condkeep as INT EXTENT 9 no-undo.
     2522   DEF VAR varmvibr-condkeep       as INT no-undo.
     2523   DEF VAR varmvjbr-condkeep       as INT no-undo.
     2524   DEF VAR varmvkbr-condkeep       as INT no-undo.
     2525   DEF VAR varmvlbr-condkeep       as INT no-undo.
     2526   DEF VAR move-elementbr-condkeep as INT no-undo.
     2527   def var jjbr-condkeep           as int no-undo.
     2528   do varmvibr-condkeep = 1 to EXTENT(cur-clmn-numbr-condkeep):
     2529     ASSIGN cur-clmn-numbr-condkeep[varmvibr-condkeep] = varmvibr-condkeep.
     2530   END.
     2531   RUN start-mv-clmnbr-condkeep.
     2532   PROCEDURE start-mv-clmnbr-condkeep:
     2533   def var old-session as logical no-undo.
     2534      old-session = SESSION:IMMEDIATE-DISPLAY.
     2535      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2536          IF  p-mode = 'все':U  THEN DO:
     2537      DO jjbr-condkeep = NUM-ENTRIES('1,2,3,4,5,6,7,8,9') TO 1 BY -1:
     2538        RUN re-move-clmnbr-condkeep ( cur-clmn-numbr-condkeep[INTEGER(ENTRY (jjbr-condkeep, '1,2,3,4,5,6,7,8,9'))] , 1).
     2539      END.
     2540          END.
     2541      SESSION:IMMEDIATE-DISPLAY = old-session.
     2542   END.
     2543   ON ctrl-cursor-right OF BROWSE br-condkeep do:
     2544     RUN re-move-clmnbr-condkeep ( 1, 9).
     2545   END.
     2546   ON ctrl-cursor-left OF BROWSE br-condkeep do:
     2547     RUN re-move-clmnbr-condkeep (9, 1).
     2548   END.
     2549   PROCEDURE re-move-clmnbr-condkeep:
     2550     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2551     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2552     DO varmvibr-condkeep = 1 TO EXTENT(cur-clmn-numbr-condkeep):
     2553       if cur-clmn-numbr-condkeep[varmvibr-condkeep] = source-column THEN cur-clmn-numbr-condkeep[varmvibr-condkeep] = -1.
     2554     END.
     2555     if br-condkeep:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2556     if source-column > target-column THEN
     2557     DO varmvjbr-condkeep = source-column - 1 to target-column BY -1:
     2558       DO varmvibr-condkeep = 1 TO EXTENT(cur-clmn-numbr-condkeep):
     2559           if cur-clmn-numbr-condkeep[varmvibr-condkeep] = varmvjbr-condkeep THEN DO:
     2560             cur-clmn-numbr-condkeep[varmvibr-condkeep] = cur-clmn-numbr-condkeep[varmvibr-condkeep] + 1.
     2561           END.
     2562       END.
     2563     END.
     2564     ELSE
     2565     DO varmvjbr-condkeep = source-column + 1 to target-column:
     2566       DO varmvibr-condkeep = 1 TO EXTENT(cur-clmn-numbr-condkeep):
     2567         if cur-clmn-numbr-condkeep[varmvibr-condkeep] = varmvjbr-condkeep THEN DO:
     2568           cur-clmn-numbr-condkeep[varmvibr-condkeep] = cur-clmn-numbr-condkeep[varmvibr-condkeep] - 1.
     2569         END.
     2570       END.
     2571     END.
     2572     DO varmvibr-condkeep = 1 TO EXTENT(cur-clmn-numbr-condkeep):
     2573       if cur-clmn-numbr-condkeep[varmvibr-condkeep] = -1 THEN cur-clmn-numbr-condkeep[varmvibr-condkeep] = target-column.
     2574     END.
     2575   END PROCEDURE.
     2576   PROCEDURE ch-clmnbr-condkeep:
     2577     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2578     if cur-clmn-loc <= 1 then do:
     2579       return .
     2580     end.
     2581     DO varmvibr-condkeep = 1 TO EXTENT(cur-clmn-numbr-condkeep):
     2582       if cur-clmn-numbr-condkeep[varmvibr-condkeep] = cur-clmn-loc THEN move-elementbr-condkeep = varmvibr-condkeep.
     2583     END.
     2584     RUN re-move-clmnbr-condkeep (cur-clmn-loc, 1).
     2585   END PROCEDURE.
     2586   PROCEDURE mv-brw-defaultbr-condkeep:
     2587   def var old-session as logical no-undo.
     2588     old-session = SESSION:IMMEDIATE-DISPLAY.
     2589     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2590     do varmvlbr-condkeep = 1 to EXTENT(cur-clmn-numbr-condkeep):
     2591       RUN re-move-clmnbr-condkeep (cur-clmn-numbr-condkeep[varmvlbr-condkeep], varmvlbr-condkeep).
     2592     END.
     2593     RUN start-mv-clmnbr-condkeep.
     2594     SESSION:IMMEDIATE-DISPLAY = old-session.
     2595   END PROCEDURE.
     2596   .
     2597   WAIT-FOR GO OF FRAME Dialog-Frame.
     2598   END.
     2599   RUN disable_UI.
     2600   PROCEDURE disable_UI :
     2601     HIDE FRAME Dialog-Frame.
     2602   END PROCEDURE.
     2603   PROCEDURE enable_UI :
     2604     DISPLAY RS-sts mark-num
     2605         WITH FRAME Dialog-Frame.
     2606     ENABLE b-quit B-mark B-sel B-add B-lookup B-chg B-del B-print B-hist B-Help
     2607            RS-sts br-condkeep mark-num
     2608         WITH FRAME Dialog-Frame.
     2609     VIEW FRAME Dialog-Frame.
     2610     OPEN QUERY br-condkeep FOR EACH X_condition-keeping NO-LOCK INDEXED-REPOSITION.
     2611   END PROCEDURE.
     2612   PROCEDURE MyEnable :
     2613   ASSIGN
     2614   rs-sts:RADIO-BUTTONS IN FRAME Dialog-Frame
     2615                          = "Текущие&+" + chr(44) +  '0':U + chr(44) +
     2616                          "Все&!" + chr(44) + 'все':U + chr(44) +
     2617                           "Удаленные&-" + chr(44) + '1':U
     2618   rs-sts = (IF p-sts = ? THEN 'все':U ELSE string(p-sts))
     2619   .
     2620   DISPLAY mark-num
     2621   WITH FRAME Dialog-Frame.
     2622   ENABLE
     2623   b-quit
     2624   B-mark when LOOKUP("b-mark":U, bttns) > 0
     2625   B-sel when LOOKUP("b-sel":U, bttns) > 0
     2626   B-add when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     2627   B-lookup
     2628   B-chg when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     2629   B-del when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     2630   B-print
     2631   B-Help
     2632   B-hist
     2633   br-condkeep
     2634   mark-num
     2635   RS-sts
     2636   with FRAME Dialog-Frame.
     2637   VIEW FRAME Dialog-Frame.
     2638   END PROCEDURE.
     2639   PROCEDURE OpenBr :
     2640   define variable title0 as character no-undo init "Список условий хранения".
     2641   IF p-sts = ? THEN DO:
     2642       frame Dialog-Frame:TITLE = title0 + chr(32) + "все".
     2643       OPEN QUERY br-condkeep
     2644       FOR EACH X_condition-keeping NO-LOCK
     2645       INDEXED-REPOSITION.
     2646   END.
     2647   ELSE DO:
     2648           frame Dialog-Frame:TITLE = title0 + chr(32) + entry (lookup (STRING(p-sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U).
     2649       OPEN QUERY br-condkeep
     2650       FOR EACH X_condition-keeping NO-LOCK where
     2651       X_condition-keeping.sts = p-sts
     2652       INDEXED-REPOSITION.
     2653   END.
     2654   APPLY "VALUE-CHANGED" TO br-condkeep in frame Dialog-Frame.
     2655   APPLY "ENTRY" TO br-condkeep.
     2656   END PROCEDURE.
     2657   PROCEDURE proc-b-del :
     2658   define variable loc#log as logical no-undo.
     2659   define variable v-sts like ub.condition-keeping.sts no-undo .
     2660   DEFINE VARIABLE loc-doc-rec AS RECID NO-UNDO.
     2661   if not available X_condition-keeping then return error.
     2662   do
     2663   on error undo, return error
     2664   on stop undo, return error
     2665   :
     2666   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2667   do:
     2668     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2669       (input  v-cntxt-db-num
     2670       ,input  v-cntxt-userid
     2671       ,input  0
     2672       ,input  'actn_delivery-storage_work':U
     2673       ,input  'global':U
     2674       ,input  0
     2675       ,input  '':U
     2676       ,input  0
     2677       ,input  0
     2678       ,input  0
     2679       ,input  0
     2680       ,input  true
     2681       ,output loc#log
     2682       )  .
     2683   end.
     2684   if not loc#log then return error.
     2685     assign
     2686     v-sts = ?
     2687     loc-doc-rec = RECID(X_condition-keeping)
     2688     .
     2689     run ref/cndkeep2.p (
     2690                     input recid(X_condition-keeping)
     2691                     ,input-output v-sts
     2692                    ) no-error .
     2693     if error-status:error then undo, return error.
     2694     RUN OpenBr.
     2695     REPOSITION br-condkeep to recid loc-doc-rec No-error.
     2696     if error-status:error then do:                           find first pos_condition-keeping no-lock where                                   recid(pos_condition-keeping) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи УСЛОВИЙ ХРАНЕНИЯ" skip                            string(if avail pos_condition-keeping                                     then  substitute("Вн код условий хранения: &1"                                                     , pos_condition-keeping.cond-keep-code)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     2697     if available X_condition-keeping then do:
     2698       loc#log = br-condkeep:select-focused-row( ) IN FRAME Dialog-Frame.
     2699     end.
     2700     apply "ENTRY" to br-condkeep.
     2701   end.
     2702   END PROCEDURE.
     2703   PROCEDURE proc-b-print :
     2704   define variable v-doc-rec as recid no-undo .
     2705   define variable accum-count as integer.
     2706   define variable date_string     as      char    no-undo.
     2707   define variable Line            as      char    no-undo.
     2708   DEFINE VARIABLE v-sts-chr AS CHARACTER NO-UNDO.
     2709   DEFINE FRAME condition-keeping-list
     2710   X_condition-keeping.cond-keep-name
     2711   v-sts-chr FORMAT "X(8)" COLUMN-LABEL "Статус"
     2712   X_condition-keeping.t-mode-from column-label "Темп-ра!от(град C)"
     2713   X_condition-keeping.t-mode-to   column-label "Темп-ра!до(град C)"
     2714   X_condition-keeping.h-mode-from column-label "Влажность!от (%)"
     2715   X_condition-keeping.h-mode-to   column-label "Влажность!до (%)"
     2716   X_condition-keeping.des FORMAT "X(100)"
     2717   X_condition-keeping.cond-keep-code COLUMN-LABEL "Вн.код!группы"
     2718   HEADER  date_string AT 5 format "X(35)"
     2719    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     2720   Line format "X(195)" AT 1
     2721   with width 232 down stream-io use-text    .
     2722   Line = fill("-", 195).
     2723   date_string = cur-time-print() .
     2724   run prn-lib-open-stream  in this-procedure (
     2725                                                input parParentProc
     2726                                               ,input 43
     2727                                               ,input yes
     2728                                               ,input no
     2729                                               ).
     2730   PUT  STREAM PrnLibStream
     2731   SPACE(25) ( frame Dialog-Frame:title )
     2732   format "x(90)" SKIP(1) .
     2733   FORM HEADER
     2734   Line format "X(195)" AT 1 SKIP
     2735   "Продолжение - на следующей странице" AT 30 SKIP
     2736   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2737   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     2738   FORM with FRAME condition-keeping-list  .
     2739   run waitfram-show in this-procedure ("Ждите...").
     2740   v-doc-rec = recid(X_condition-keeping).
     2741   DO WHILE available X_condition-keeping :
     2742     GET prev br-condkeep.
     2743   END.
     2744   GET next br-condkeep.
     2745   DO WHILE available X_condition-keeping :
     2746     Display STREAM PrnLibStream
     2747      X_condition-keeping.cond-keep-name
     2748     entry (lookup (STRING(X_condition-keeping.sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) @ v-sts-chr
     2749     X_condition-keeping.des
     2750     X_condition-keeping.t-mode-from
     2751     X_condition-keeping.t-mode-to
     2752     X_condition-keeping.h-mode-from
     2753     X_condition-keeping.h-mode-to
     2754     X_condition-keeping.cond-keep-code
     2755   with FRAME condition-keeping-list .
     2756     DOWN STREAM PrnLibStream 1
     2757     with FRAME condition-keeping-list  .
     2758     assign
     2759     accum-count = accum-count + 1
     2760     .
     2761     GET next br-condkeep.
     2762   END.
     2763   UNDERLINE  STREAM PrnLibStream
     2764   X_condition-keeping.cond-keep-name
     2765   v-sts-chr
     2766   X_condition-keeping.des
     2767   X_condition-keeping.t-mode-from
     2768   X_condition-keeping.t-mode-to
     2769   X_condition-keeping.h-mode-from
     2770   X_condition-keeping.h-mode-to
     2771   X_condition-keeping.cond-keep-code
     2772   with FRAME condition-keeping-list .
     2773   DISPLAY STREAM PrnLibStream
     2774   "ИТОГО" @ X_condition-keeping.cond-keep-name
     2775   accum-count @ v-sts-chr
     2776   with frame condition-keeping-list.
     2777   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     2778   HIDE  STREAM PrnLibStream FRAME condition-keeping-List.
     2779   output  STREAM PrnLibStream CLOSE.
     2780   REPOSITION br-condkeep to recid v-doc-rec no-error.
     2781   APPLY "entry" to br-condkeep.
     2782   run waitfram-hide in this-procedure .
     2783   run prn-lib-prn-file in this-procedure (
     2784                                             input parParentProc
     2785                                             ,input 8
     2786                                             ).
     2787   END PROCEDURE.
     2788   PROCEDURE proc-br-condkeep :
     2789   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2790   if b-sel:sensitive in frame Dialog-Frame then dO:
     2791       if b-mark:sensitive then do:
     2792           apply "choose" to b-mark in frame Dialog-Frame.
     2793       end.
     2794       else do:
     2795           apply "choose" to b-sel in frame Dialog-Frame.
     2796       end.
     2797   end.
     2798   else do:
     2799       if b-lookup:sensitive then
     2800       apply "choose" to b-lookup in frame Dialog-Frame.
     2801   end.
     2802   END PROCEDURE.
