     2814   PROCEDURE set-filter-name :
     2815   define input parameter p-filter-name as character no-undo .
     2816     do with frame Dialog-Frame:
     2817       if p-filter-name > "" then do:
     2818         assign
     2819           frame Dialog-Frame:title
     2820             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2821         .
     2822         assign
     2823           b-sch :TOOLTIP = "Установлен фильтр " + p-filter-name
     2824         .
     2825       end.
     2826       else do:
     2827         assign
     2828           b-sch :TOOLTIP = ""
     2829         .
     2830       end.
     2831     end.
     2832   END PROCEDURE.
