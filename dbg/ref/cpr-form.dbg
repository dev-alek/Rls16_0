     1088       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1089            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1090            TITLE "История ДНЦ"
     1091            CANCEL-BUTTON B-Cancel.
     1092   ASSIGN
     1093          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1094          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1095   ASSIGN
     1096          BR-docs:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1
     1097          BR-docs:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1098   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1099   DO:
     1100     APPLY "END-ERROR":U TO SELF.
     1101   END.
     1102   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1103   DO:
     1104     run proc-b-sch in this-procedure no-error.
     1105     if not available buf_c-price-doc-forming then run OpenBr (yes, no, '':U).
     1106   END.
     1107   ON VALUE-CHANGED OF BR-docs IN FRAME Dialog-Frame
     1108   DO:
     1109   if available buf_c-price-doc-forming then do:
     1110     run proc-view-changes in this-procedure no-error.
     1111   end.
     1112   END.
     1113   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1114   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1115   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1116   on help of frame Dialog-Frame
     1117   do:
     1118     run gbl/app_help.p
     1119       (input this-procedure :file-name
     1120       ,input ''
     1121       ,input ?
     1122       ) no-error.
     1123     if error-status :error then do:
     1124       message
     1125         "Ошибка при вызове помощи"
     1126         error-status :get-message(1)
     1127         view-as alert-box .
     1128     end.
     1129   end.
     1130   run minbtn-set in this-procedure .
     1131   on choose of b-help in frame Dialog-Frame
     1132   do:
     1133     apply "help":u to frame Dialog-Frame .
     1134   end.
     1135   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1136   procedure minbtn-set :
     1137       do
     1138           on error undo, return error return-value
     1139           :
     1140           define variable ii              as integer       no-undo .
     1141           define variable fh              as widget-handle no-undo .
     1142           define variable hh              as widget-handle no-undo .
     1143           define variable v-h             as handle        extent 4 no-undo .
     1144           define variable v-name-button   as character     no-undo .
     1145           define variable v-help-old-x    as decimal       no-undo .
     1146           define variable v-help-old-y    as decimal       no-undo .
     1147           define variable v-help-old-size as decimal       no-undo .
     1148           define variable v-frame-width   as decimal       no-undo .
     1149           define variable jj              as integer       no-undo .
     1150           do
     1151               on error undo, return error
     1152               :
     1153               assign
     1154                   v-frame-width = frame Dialog-Frame:width - 0.3
     1155                   fh            = frame Dialog-Frame:first-child
     1156                   hh            = fh:first-child
     1157                   ii            = 1
     1158                   .
     1159               do while valid-handle(hh):
     1160                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1161                   do:
     1162                       case lc(hh:name) :
     1163                           when "b-help" then
     1164                               do:
     1165                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1166                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1167                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1168                                   hh:TOOLTIP = "Помощь" .
     1169                                   v-help-old-x = hh:column .
     1170                                   v-help-old-y = hh:row    .
     1171                                   v-help-old-size = hh:width .
     1172                                   hh:width-chars = 2.5 .
     1173                               end.
     1174                           when "b-print" then
     1175                               do:
     1176                                   hh:load-image("cmp/b-print.bmp":u) .
     1177                                   hh:TOOLTIP = "Печать" .
     1178                                   v-h[ii] = hh:handle .
     1179                                   ii = ii + 1 .
     1180                                   hh:width-chars = 3 .
     1181                               end.
     1182                           when "b-history" or
     1183                           when "b-hist" then
     1184                               do:
     1185                                   hh:load-image("cmp/b-hist.bmp":u) .
     1186                                   hh:TOOLTIP = "История" .
     1187                                   v-h[ii] = hh:handle .
     1188                                   ii = ii + 1 .
     1189                                   hh:width-chars = 3 .
     1190                               end.
     1191                           when "b-sch" then
     1192                               do:
     1193                                   hh:load-image("cmp/b-sch.bmp":u) .
     1194                                   hh:TOOLTIP = "Установка Фильтра" .
     1195                                   v-h[ii] = hh:handle .
     1196                                   ii = ii + 1 .
     1197                                   hh:width-chars = 3 .
     1198                               end.
     1199                           when "b-hist-user" then
     1200                               do:
     1201                                   hh:load-image("cmp/b-hist.bmp":u) .
     1202                                   hh:TOOLTIP = "История пользователя" .
     1203                                   ii = ii + 1 .
     1204                               end.
     1205                       end case.
     1206                   end.
     1207                   hh = hh:next-sibling.
     1208               end.
     1209               b-help:column = v-frame-width - b-help:width-chars.
     1210               jj = 0.
     1211               repeat ii = 4 to 1 by -1 :
     1212                   if valid-handle (v-h[ii] ) then
     1213                   do:
     1214                       jj  = jj + 1 .
     1215                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1216                       v-h[ii]:row    = v-help-old-y .
     1217                   end.
     1218               end.
     1219           end.
     1220       end.
     1221   end procedure.
     1222   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1223   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1224   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1225   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1226   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1227   define variable v-diasize-current-frame-height as decimal   no-undo .
     1228   define variable v-diasize-change-size          as logical   no-undo .
     1229   define variable v-diasize-resize-button        as handle    no-undo .
     1230   define variable v-diasize-wndmax               as logical   no-undo .
     1231   define variable v-diasize-wndstore             as logical   no-undo .
     1232   define variable v-diasize-proc-name            as character no-undo .
     1233   define variable v-diasize-browse-handle        as handle    no-undo .
     1234   define variable v-diasize-browse-number        as integer   no-undo .
     1235   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1236   define temp-table temp-diasize-handle no-undo
     1237     field handle-value  as handle
     1238     field save-position as decimal
     1239     index xpk is primary unique handle-value
     1240     .
     1241   define temp-table temp-browse-handle no-undo
     1242     field browse-type   as character
     1243     field browse-number as integer
     1244     field browse-handle as handle
     1245     field original-size as decimal
     1246     index xpk is primary unique browse-type browse-number
     1247     index xie browse-type browse-handle
     1248   .
     1249   procedure diasize_change-height :
     1250     define input  parameter p-change-value  as decimal   no-undo .
     1251     define input  parameter p-move-resize   as logical   no-undo .
     1252     define variable v-field-group-handle    as handle    no-undo .
     1253     define variable v-object-handle         as handle    no-undo .
     1254     define variable v-frame-height          as decimal   no-undo .
     1255     define variable v-frame-virtual-height  as decimal   no-undo .
     1256     define variable v-browse-height         as decimal   no-undo .
     1257     define variable v-window-height         as decimal   no-undo .
     1258     define variable v-window-virtual-height as decimal   no-undo .
     1259     define variable v-change-sign           as integer   no-undo .
     1260     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1261     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1262     if p-change-value > 0
     1263     then do:
     1264       if frame Dialog-Frame :height + p-change-value
     1265           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1266       then do:
     1267         assign
     1268           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1269                           - (frame Dialog-Frame :height-chars)
     1270         .
     1271         if p-change-value <= 0
     1272         then do:
     1273           run diasize_position-resize-button in this-procedure .
     1274           return .
     1275         end.
     1276       end.
     1277     end.
     1278     if p-change-value < 0
     1279     then do:
     1280       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1281       then do:
     1282         assign
     1283           p-change-value = v-diasize-orig-frame-height
     1284                          - (frame Dialog-Frame :height-chars)
     1285         .
     1286         if p-change-value >= 0
     1287         then do:
     1288           run diasize_position-resize-button in this-procedure .
     1289           return .
     1290         end.
     1291       end.
     1292     end.
     1293     if p-change-value >= 0
     1294     then do:
     1295       assign
     1296         v-change-sign = 1
     1297       .
     1298     end.
     1299     else do:
     1300       assign
     1301         v-change-sign = -1
     1302       .
     1303     end.
     1304     assign
     1305       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1306     .
     1307     if p-change-value = 0
     1308     then do:
     1309       run diasize_position-resize-button in this-procedure .
     1310       return .
     1311     end.
     1312     move_block:
     1313     do
     1314     on error undo move_block, retry move_block
     1315     :
     1316       if retry
     1317       then do:
     1318         do
     1319         on error undo move_block, leave move_block
     1320         :
     1321           if p-change-value > 0
     1322           then do:
     1323             for each buf_temp-diasize-handle
     1324             on error undo, next
     1325             :
     1326               assign
     1327                 v-object-handle = buf_temp-diasize-handle.handle-value
     1328               .
     1329               if v-object-handle <> v-diasize-resize-button
     1330               then do:
     1331                 assign
     1332                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1333                 .
     1334               end.
     1335             end.
     1336             assign
     1337               v-diasize-browse-handle :height = v-browse-height
     1338             .
     1339             for each buf_temp-browse-handle
     1340               where buf_temp-browse-handle.browse-type = 'height':u
     1341             on error undo, next
     1342             :
     1343               assign
     1344                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1345               .
     1346             end.
     1347             assign
     1348               frame Dialog-Frame :height = v-frame-height
     1349             .
     1350             if frame Dialog-Frame :scrollable = true
     1351             then do:
     1352               assign
     1353                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1354               .
     1355             end.
     1356             run diasize_position-resize-button in this-procedure .
     1357           end.
     1358           else do:
     1359             if frame Dialog-Frame :scrollable = true
     1360             then do:
     1361               assign
     1362                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1363               .
     1364             end.
     1365             assign
     1366               frame Dialog-Frame :height = v-frame-height
     1367             .
     1368             assign
     1369               v-diasize-browse-handle :height = v-browse-height
     1370             .
     1371             for each buf_temp-browse-handle
     1372               where buf_temp-browse-handle.browse-type = 'height':u
     1373             on error undo, next
     1374             :
     1375               assign
     1376                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1377               .
     1378             end.
     1379             for each buf_temp-diasize-handle
     1380             on error undo, next
     1381             :
     1382               assign
     1383                 v-object-handle = buf_temp-diasize-handle.handle-value
     1384               .
     1385               if v-object-handle <> v-diasize-resize-button
     1386               then do:
     1387                 assign
     1388                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1389                 .
     1390               end.
     1391             end.
     1392             run diasize_position-resize-button in this-procedure .
     1393           end.
     1394           assign
     1395             v-diasize-change-size = false
     1396           .
     1397           leave move_block .
     1398         end.
     1399       end.
     1400       assign
     1401         v-diasize-need-full-display = true
     1402       .
     1403       if v-diasize-change-size = false
     1404       then do:
     1405         assign
     1406           v-diasize-change-size = true
     1407         .
     1408       end.
     1409       else do:
     1410         return .
     1411       end.
     1412       assign
     1413         v-frame-height = frame Dialog-Frame :height
     1414         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1415         v-browse-height = v-diasize-browse-handle :height
     1416       .
     1417       for each buf_temp-browse-handle
     1418         where buf_temp-browse-handle.browse-type = 'height':u
     1419       :
     1420         assign
     1421           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1422         .
     1423       end.
     1424       for each buf_temp-diasize-handle
     1425       :
     1426         delete buf_temp-diasize-handle .
     1427       end.
     1428       assign
     1429         v-field-group-handle = frame Dialog-Frame :first-child
     1430       .
     1431       do while valid-handle(v-field-group-handle)
     1432       :
     1433         assign
     1434           v-object-handle = v-field-group-handle :first-child
     1435         .
     1436         do while valid-handle(v-object-handle)
     1437         :
     1438           if  v-object-handle <> v-diasize-browse-handle :handle
     1439           and can-query(v-object-handle, "row")
     1440           and can-query(v-object-handle, "height")
     1441           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1442           then do:
     1443             find first buf_temp-browse-handle
     1444               where buf_temp-browse-handle.browse-type   = 'height':u
     1445                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1446               no-error .
     1447             if available buf_temp-browse-handle
     1448             then do:
     1449             end.
     1450             else do:
     1451               create buf_temp-diasize-handle .
     1452               assign
     1453                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1454                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1455               .
     1456             end.
     1457           end.
     1458           assign
     1459             v-object-handle = v-object-handle :next-sibling
     1460           .
     1461         end.
     1462         assign
     1463           v-field-group-handle = v-field-group-handle :next-sibling
     1464         .
     1465       end.
     1466       do with frame Dialog-Frame
     1467       :
     1468         hide v-diasize-resize-button .
     1469         assign
     1470           v-diasize-resize-button :row    = 1
     1471           v-diasize-resize-button :column = 1
     1472         .
     1473       end.
     1474       if p-change-value > 0
     1475       then do:
     1476         if frame Dialog-Frame :scrollable = true
     1477         then do:
     1478           assign
     1479             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1480             no-error .
     1481           if error-status :error
     1482           or error-status :get-message(1) <> ""
     1483           then do:
     1484             undo move_block, retry move_block .
     1485           end.
     1486         end.
     1487         assign
     1488           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1489           no-error .
     1490         if error-status :error
     1491         or error-status :get-message(1) <> ""
     1492         then do:
     1493           undo move_block, retry move_block .
     1494         end.
     1495         assign
     1496           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1497           no-error .
     1498         if error-status :error
     1499         or error-status :get-message(1) <> ""
     1500         then do:
     1501           undo move_block, retry move_block .
     1502         end.
     1503         for each buf_temp-browse-handle
     1504           where buf_temp-browse-handle.browse-type = 'height':u
     1505         on error undo move_block, retry move_block
     1506         :
     1507           assign
     1508             buf_temp-browse-handle.browse-handle :height
     1509               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1510             no-error .
     1511           if error-status :error
     1512           or error-status :get-message(1) <> ""
     1513           then do:
     1514             undo move_block, retry move_block .
     1515           end.
     1516         end.
     1517         for each buf_temp-diasize-handle
     1518         on error undo move_block, retry move_block
     1519         :
     1520           assign
     1521             v-object-handle = buf_temp-diasize-handle.handle-value
     1522           .
     1523           if v-object-handle <> v-diasize-resize-button
     1524           then do:
     1525             assign
     1526               v-object-handle :row = v-object-handle :row + p-change-value
     1527               no-error .
     1528             if error-status :error
     1529             or error-status :get-message(1) <> ""
     1530             then do:
     1531               undo move_block, retry move_block .
     1532             end.
     1533           end.
     1534         end.
     1535       end.
     1536       else do:
     1537         for each buf_temp-diasize-handle
     1538         on error undo move_block, retry move_block
     1539         :
     1540           assign
     1541             v-object-handle = buf_temp-diasize-handle.handle-value
     1542           .
     1543           if v-object-handle <> v-diasize-resize-button
     1544           then do:
     1545             assign
     1546               v-object-handle :row = v-object-handle :row + p-change-value
     1547               no-error .
     1548             if error-status :error
     1549             or error-status :get-message(1) <> ""
     1550             then do:
     1551               undo move_block, retry move_block .
     1552             end.
     1553           end.
     1554         end.
     1555         assign
     1556           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1557           no-error .
     1558         if error-status :error
     1559         or error-status :get-message(1) <> ""
     1560         then do:
     1561           undo move_block, retry move_block .
     1562         end.
     1563         for each buf_temp-browse-handle
     1564           where buf_temp-browse-handle.browse-type = 'height':u
     1565         on error undo move_block, retry move_block
     1566         :
     1567           assign
     1568             buf_temp-browse-handle.browse-handle :height
     1569               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1570             no-error .
     1571           if error-status :error
     1572           or error-status :get-message(1) <> ""
     1573           then do:
     1574             undo move_block, retry move_block .
     1575           end.
     1576         end.
     1577         assign
     1578           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1579           no-error .
     1580         if error-status :error
     1581         or error-status :get-message(1) <> ""
     1582         then do:
     1583           undo move_block, retry move_block .
     1584         end.
     1585         if frame Dialog-Frame :scrollable = true
     1586         then do:
     1587           assign
     1588             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1589             no-error .
     1590           if error-status :error
     1591           or error-status :get-message(1) <> ""
     1592           then do:
     1593             undo move_block, retry move_block .
     1594           end.
     1595         end.
     1596       end.
     1597       if p-move-resize = true
     1598       then do:
     1599         run diasize_position-resize-button in this-procedure .
     1600       end.
     1601       if v-diasize-wndstore = true
     1602       then do:
     1603         if connected("ub") = true
     1604         then do:
     1605           define variable v-cntxt-db-num        as integer   no-undo .
     1606           define variable v-cntxt-userid        as character no-undo .
     1607           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1608                                             , OUTPUT v-cntxt-userid
     1609                                             ) .
     1610           run gbl/wndsizew.p
     1611             (input  v-cntxt-db-num
     1612             ,input  v-cntxt-userid
     1613             ,input  v-diasize-proc-name
     1614             ,input  'height':u
     1615             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1616             ) .
     1617         end.
     1618       end.
     1619     end.
     1620     assign
     1621       v-diasize-change-size = false
     1622     .
     1623   end procedure.
     1624   procedure diasize_set-height :
     1625     define input  parameter p-new-height  as decimal   no-undo .
     1626     define input  parameter p-move-resize as logical   no-undo .
     1627     do
     1628     on error undo, return error return-value
     1629     :
     1630       run diasize_change-height in this-procedure
     1631         (input  (p-new-height - frame Dialog-Frame :height)
     1632         ,input  p-move-resize
     1633         ) .
     1634     end.
     1635   end procedure.
     1636   procedure diasize_change-width :
     1637     define input  parameter p-change-value as decimal   no-undo .
     1638     define input  parameter p-move-resize  as logical   no-undo .
     1639     define variable v-field-group-handle   as handle    no-undo .
     1640     define variable v-object-handle        as handle    no-undo .
     1641     define variable v-frame-width          as decimal   no-undo .
     1642     define variable v-frame-virtual-width  as decimal   no-undo .
     1643     define variable v-browse-width         as decimal   no-undo .
     1644     define variable v-window-width         as decimal   no-undo .
     1645     define variable v-window-virtual-width as decimal   no-undo .
     1646     define variable v-change-sign          as integer   no-undo .
     1647     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1648     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1649     if p-change-value > 0
     1650     then do:
     1651       if frame Dialog-Frame :width + p-change-value >
     1652           session :width-chars
     1653       then do:
     1654         assign
     1655           p-change-value = session :width-chars - frame Dialog-Frame :width
     1656         .
     1657         if p-change-value <= 0
     1658         then do:
     1659           run diasize_position-resize-button in this-procedure .
     1660           return .
     1661         end.
     1662       end.
     1663     end.
     1664     if p-change-value < 0
     1665     then do:
     1666       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1667       then do:
     1668         assign
     1669           p-change-value = v-diasize-orig-frame-width
     1670                          - frame Dialog-Frame :width
     1671         .
     1672         if p-change-value >= 0
     1673         then do:
     1674           run diasize_position-resize-button in this-procedure .
     1675           return .
     1676         end.
     1677       end.
     1678     end.
     1679     if p-change-value >= 0
     1680     then do:
     1681       assign
     1682         v-change-sign = 1
     1683       .
     1684     end.
     1685     else do:
     1686       assign
     1687         v-change-sign = -1
     1688       .
     1689     end.
     1690     assign
     1691       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1692     .
     1693     if p-change-value = 0
     1694     then do:
     1695       run diasize_position-resize-button in this-procedure .
     1696       return .
     1697     end.
     1698     move_block:
     1699     do
     1700     on error undo move_block, leave move_block
     1701     :
     1702       if retry
     1703       then do:
     1704         do
     1705         on error undo move_block, leave move_block
     1706         :
     1707           if p-change-value > 0
     1708           then do:
     1709             for each buf_temp-diasize-handle
     1710             on error undo, next
     1711             :
     1712               assign
     1713                 v-object-handle = buf_temp-diasize-handle.handle-value
     1714               .
     1715               if v-object-handle <> v-diasize-resize-button
     1716               then do:
     1717                 assign
     1718                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1719                 .
     1720               end.
     1721             end.
     1722             assign
     1723               v-diasize-browse-handle :width = v-browse-width
     1724             .
     1725             for each buf_temp-browse-handle
     1726               where buf_temp-browse-handle.browse-type = 'width':u
     1727             on error undo, next
     1728             :
     1729               assign
     1730                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1731               .
     1732             end.
     1733             assign
     1734               frame Dialog-Frame :width = v-frame-width
     1735             .
     1736             if frame Dialog-Frame :scrollable = true
     1737             then do:
     1738               assign
     1739                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1740               .
     1741             end.
     1742             run diasize_position-resize-button in this-procedure .
     1743           end.
     1744           else do:
     1745             if frame Dialog-Frame :scrollable = true
     1746             then do:
     1747               assign
     1748                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1749               .
     1750             end.
     1751             assign
     1752               frame Dialog-Frame :width = v-frame-width
     1753             .
     1754             for each buf_temp-browse-handle
     1755               where buf_temp-browse-handle.browse-type = 'width':u
     1756             on error undo, next
     1757             :
     1758               assign
     1759                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1760               .
     1761             end.
     1762             assign
     1763               v-diasize-browse-handle :width = v-browse-width
     1764             .
     1765             for each buf_temp-diasize-handle
     1766             on error undo, next
     1767             :
     1768               assign
     1769                 v-object-handle = buf_temp-diasize-handle.handle-value
     1770               .
     1771               if v-object-handle <> v-diasize-resize-button
     1772               then do:
     1773                 assign
     1774                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1775                 .
     1776               end.
     1777             end.
     1778             run diasize_position-resize-button in this-procedure .
     1779           end.
     1780           assign
     1781             v-diasize-change-size = false
     1782           .
     1783           leave move_block .
     1784         end.
     1785       end.
     1786       assign
     1787         v-diasize-need-full-display = true
     1788       .
     1789       if v-diasize-change-size = false
     1790       then do:
     1791         assign
     1792           v-diasize-change-size = true
     1793         .
     1794       end.
     1795       else do:
     1796         return .
     1797       end.
     1798       assign
     1799         v-frame-width = frame Dialog-Frame :width
     1800         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1801         v-browse-width = v-diasize-browse-handle :width
     1802       .
     1803       for each buf_temp-browse-handle
     1804         where buf_temp-browse-handle.browse-type = 'width':u
     1805       :
     1806         assign
     1807           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1808         .
     1809       end.
     1810       for each buf_temp-diasize-handle
     1811       :
     1812         delete buf_temp-diasize-handle .
     1813       end.
     1814       assign
     1815         v-field-group-handle = frame Dialog-Frame :first-child
     1816       .
     1817       do while valid-handle(v-field-group-handle)
     1818       :
     1819         assign
     1820           v-object-handle = v-field-group-handle :first-child
     1821         .
     1822         do while valid-handle(v-object-handle)
     1823         :
     1824           if  v-object-handle <> v-diasize-browse-handle :handle
     1825           and v-object-handle <> v-diasize-resize-button
     1826           and can-query(v-object-handle, "row")
     1827           and can-query(v-object-handle, "height")
     1828           and ( v-object-handle :col + v-object-handle :width
     1829                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1830               )
     1831           then do:
     1832             find first buf_temp-browse-handle
     1833               where buf_temp-browse-handle.browse-type   = 'width':u
     1834                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1835               no-error .
     1836             if available buf_temp-browse-handle
     1837             then do:
     1838             end.
     1839             else do:
     1840               create buf_temp-diasize-handle .
     1841               assign
     1842                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1843                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1844               .
     1845             end.
     1846           end.
     1847           assign
     1848             v-object-handle = v-object-handle :next-sibling
     1849           .
     1850         end.
     1851         assign
     1852           v-field-group-handle = v-field-group-handle :next-sibling
     1853         .
     1854       end.
     1855       do with frame Dialog-Frame
     1856       :
     1857         hide v-diasize-resize-button .
     1858         v-diasize-resize-button :row = 1.
     1859         v-diasize-resize-button :column = 1.
     1860       end.
     1861       if p-change-value > 0
     1862       then do:
     1863         if frame Dialog-Frame :scrollable = true
     1864         then do:
     1865           assign
     1866             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1867             no-error .
     1868           if error-status :error
     1869           or error-status :get-message(1) <> ""
     1870           then do:
     1871             undo move_block, retry move_block.
     1872           end.
     1873         end.
     1874         assign
     1875           frame Dialog-Frame :width = v-frame-width + p-change-value
     1876           no-error .
     1877         if error-status :error
     1878         or error-status :get-message(1) <> ""
     1879         then do:
     1880           undo move_block, retry move_block.
     1881         end.
     1882         assign
     1883           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1884         no-error .
     1885         if error-status :error
     1886         or error-status :get-message(1) <> ""
     1887         then do:
     1888           undo move_block, retry move_block.
     1889         end.
     1890         for each buf_temp-browse-handle
     1891           where buf_temp-browse-handle.browse-type = 'width':u
     1892         on error undo move_block, retry move_block
     1893         :
     1894           assign
     1895             buf_temp-browse-handle.browse-handle :width
     1896               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1897             no-error .
     1898           if error-status :error
     1899           or error-status :get-message(1) <> ""
     1900           then do:
     1901             undo move_block, retry move_block .
     1902           end.
     1903         end.
     1904         for each buf_temp-diasize-handle
     1905         on error undo move_block, retry move_block
     1906         :
     1907           assign
     1908             v-object-handle = buf_temp-diasize-handle.handle-value
     1909           .
     1910           if v-object-handle <> v-diasize-resize-button
     1911           then do:
     1912             assign
     1913               v-object-handle :col = v-object-handle :col + p-change-value
     1914               no-error .
     1915             if error-status :error
     1916             or error-status :get-message(1) <> ""
     1917             then do:
     1918               undo move_block, retry move_block .
     1919             end.
     1920           end.
     1921         end.
     1922       end.
     1923       else do:
     1924         for each buf_temp-diasize-handle
     1925         on error undo move_block, retry move_block
     1926         :
     1927           assign
     1928             v-object-handle = buf_temp-diasize-handle.handle-value
     1929           .
     1930           if v-object-handle <> v-diasize-resize-button
     1931           then do:
     1932             assign
     1933               v-object-handle :col = v-object-handle :col + p-change-value
     1934               no-error .
     1935             if error-status :error
     1936             or error-status :get-message(1) <> ""
     1937             then do:
     1938               undo move_block, retry move_block .
     1939             end.
     1940           end.
     1941         end.
     1942         for each buf_temp-browse-handle
     1943           where buf_temp-browse-handle.browse-type = 'width':u
     1944         on error undo move_block, retry move_block
     1945         :
     1946           assign
     1947             buf_temp-browse-handle.browse-handle :width
     1948               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1949             no-error .
     1950           if error-status :error
     1951           or error-status :get-message(1) <> ""
     1952           then do:
     1953             undo move_block, retry move_block .
     1954           end.
     1955         end.
     1956         assign
     1957           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1958           no-error .
     1959         if error-status :error
     1960         or error-status :get-message(1) <> ""
     1961         then do:
     1962           undo move_block, retry move_block.
     1963         end.
     1964         assign
     1965           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1966         no-error .
     1967         if error-status :error
     1968         or error-status :get-message(1) <> ""
     1969         then do:
     1970           undo move_block, retry move_block.
     1971         end.
     1972         if frame Dialog-Frame :scrollable = true
     1973         then do:
     1974           assign
     1975             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1976           no-error .
     1977           if error-status :error
     1978           or error-status :get-message(1) <> ""
     1979           then do:
     1980             undo move_block, retry move_block.
     1981           end.
     1982         end.
     1983       end.
     1984       if p-move-resize
     1985       then do:
     1986         run diasize_position-resize-button in this-procedure .
     1987       end.
     1988       if v-diasize-wndstore = true
     1989       then do:
     1990         if connected("ub") = true
     1991         then do:
     1992           define variable v-cntxt-db-num        as integer   no-undo .
     1993           define variable v-cntxt-userid        as character no-undo .
     1994           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1995                                             , OUTPUT v-cntxt-userid
     1996                                             ) .
     1997           run gbl/wndsizew.p
     1998             (input  v-cntxt-db-num
     1999             ,input  v-cntxt-userid
     2000             ,input  v-diasize-proc-name
     2001             ,input  'width':u
     2002             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2003             ) .
     2004         end.
     2005       end.
     2006     end.
     2007     assign
     2008       v-diasize-change-size = false
     2009     .
     2010   end procedure.
     2011   procedure diasize_set-width :
     2012     define input  parameter p-new-width  as decimal   no-undo .
     2013     define input  parameter p-move-resize as logical   no-undo .
     2014     do
     2015     on error undo, return error return-value
     2016     :
     2017       run diasize_change-width in this-procedure
     2018         (input  (p-new-width - frame Dialog-Frame :width)
     2019         ,input  p-move-resize
     2020         ) .
     2021     end.
     2022   end procedure.
     2023   procedure diasize_position-resize-button :
     2024     do with frame Dialog-Frame
     2025     :
     2026       hide v-diasize-resize-button .
     2027       assign
     2028         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2029                     - 1
     2030                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2031         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2032                     - 1
     2033                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2034       .
     2035       view v-diasize-resize-button .
     2036     end.
     2037   end procedure.
     2038   on alt-right anywhere
     2039   do:
     2040     run diasize_change-width in this-procedure
     2041       (input 1
     2042       ,input true
     2043       ) .
     2044     return no-apply .
     2045   end.
     2046   on alt-left anywhere
     2047   do:
     2048     run diasize_change-width in this-procedure
     2049       (input -1
     2050       ,input true
     2051       ) .
     2052     return no-apply .
     2053   end.
     2054   on alt-down anywhere
     2055   do:
     2056     run diasize_change-height in this-procedure
     2057       (input 1
     2058       ,input true
     2059       ) .
     2060     return no-apply .
     2061   end.
     2062   on alt-up anywhere
     2063   do:
     2064     run diasize_change-height in this-procedure
     2065       (input -1
     2066       ,input true
     2067       ) .
     2068     return no-apply .
     2069   end.
     2070   on alt-enter of frame Dialog-Frame
     2071   do:
     2072     run diasize_maximize in this-procedure
     2073       (input  ?
     2074       ).
     2075     return no-apply .
     2076   end.
     2077   procedure diasize_end-move :
     2078     do
     2079     on error undo, return error return-value
     2080     :
     2081       define variable v-row-delta as decimal   no-undo .
     2082       define variable v-col-delta as decimal   no-undo .
     2083       define variable v-new-row as decimal   no-undo .
     2084       define variable v-new-col as decimal   no-undo .
     2085       assign
     2086         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2087         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2088       .
     2089       assign
     2090         v-row-delta = v-new-row - frame Dialog-Frame :height
     2091         v-col-delta = v-new-col - frame Dialog-Frame :width
     2092       .
     2093       run diasize_change-height in this-procedure
     2094         (input v-row-delta
     2095         ,input true
     2096         ) .
     2097       run diasize_change-width in this-procedure
     2098         (input v-col-delta
     2099         ,input true
     2100         ) .
     2101     end.
     2102   end procedure.
     2103   procedure diasize_maximize :
     2104     define input  parameter p-action as logical   no-undo .
     2105     do
     2106     on error undo, return error return-value
     2107     :
     2108       if p-action = ?
     2109       then do:
     2110         if v-diasize-need-maximize = true
     2111         then do:
     2112           assign
     2113             p-action = true
     2114           .
     2115         end.
     2116         else do:
     2117           assign
     2118             p-action = false
     2119           .
     2120         end.
     2121       end.
     2122       if p-action = true
     2123       then do:
     2124         run diasize_change-height in this-procedure
     2125           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2126               - frame Dialog-Frame :height-chars
     2127           ,input true
     2128           ) .
     2129         run diasize_change-width in this-procedure
     2130           (input session :width-chars
     2131               - frame Dialog-Frame :width-chars
     2132           ,input true
     2133           ) .
     2134         assign
     2135           v-diasize-need-maximize = false
     2136         .
     2137       end.
     2138       else do:
     2139         run diasize_change-width in this-procedure
     2140           (input v-diasize-orig-frame-width
     2141               - frame Dialog-Frame :width-chars
     2142           ,input true
     2143           ) .
     2144         run diasize_change-height in this-procedure
     2145           (input v-diasize-orig-frame-height
     2146               - frame Dialog-Frame :height-chars
     2147           ,input true
     2148           ) .
     2149         assign
     2150           v-diasize-need-maximize = true
     2151         .
     2152       end.
     2153     end.
     2154   end procedure.
     2155   procedure diasize_restore-orig-size :
     2156     do
     2157     on error undo, return error return-value
     2158     :
     2159       assign
     2160         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2161         v-diasize-current-frame-height = frame Dialog-Frame :height
     2162       .
     2163       run diasize_set-height in this-procedure
     2164         (input  v-diasize-orig-frame-height
     2165         ,input  true
     2166         ) .
     2167       run diasize_set-width in this-procedure
     2168         (input  v-diasize-orig-frame-width
     2169         ,input  true
     2170         ) .
     2171     end.
     2172   end procedure.
     2173   procedure diasize_restore-current-size :
     2174     do
     2175     on error undo, return error return-value
     2176     :
     2177       run diasize_set-height in this-procedure
     2178         (input  v-diasize-current-frame-height
     2179         ,input  true
     2180         ) .
     2181       run diasize_set-width in this-procedure
     2182         (input  v-diasize-current-frame-width
     2183         ,input  true
     2184         ) .
     2185     end.
     2186   end procedure.
     2187   procedure diasize_set-browse-handle :
     2188     define input  parameter p-browse-handle as handle   no-undo .
     2189     define buffer buf_temp-browse-handle for temp-browse-handle .
     2190     do
     2191     on error undo, return error return-value
     2192     :
     2193       assign
     2194         v-diasize-browse-handle = p-browse-handle
     2195       .
     2196       for each buf_temp-browse-handle
     2197       on error undo, return error return-value
     2198       :
     2199         delete buf_temp-browse-handle .
     2200       end.
     2201     end.
     2202   end procedure.
     2203   procedure diasize_add_browse :
     2204     define input  parameter p-browse-type   as character no-undo .
     2205     define input  parameter p-browse-handle as handle    no-undo .
     2206     define buffer buf_temp-browse-handle for temp-browse-handle .
     2207     do
     2208     on error undo, return error return-value
     2209     :
     2210       assign
     2211         v-diasize-browse-number = v-diasize-browse-number + 1
     2212       .
     2213       create buf_temp-browse-handle .
     2214       assign
     2215         buf_temp-browse-handle.browse-type   = p-browse-type
     2216         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2217         buf_temp-browse-handle.browse-handle = p-browse-handle
     2218       .
     2219     end.
     2220   end procedure.
     2221   procedure diasize_init :
     2222     define variable v-default-value    as logical   no-undo .
     2223     define variable v-restore-saved    as logical   no-undo .
     2224     define variable v-resize-value-str as character no-undo .
     2225     do
     2226     on error undo, return error return-value
     2227     :
     2228       do with frame Dialog-Frame
     2229       :
     2230         assign
     2231           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2232           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2233           v-diasize-browse-handle     = browse BR-changes :handle
     2234         .
     2235         create button v-diasize-resize-button
     2236         assign
     2237           parent        = frame Dialog-Frame :first-child
     2238           label         = "s"
     2239           height-pixels = 16
     2240           width-pixels  = 16
     2241           visible       = true
     2242           sensitive     = true
     2243           movable       = true
     2244           triggers:
     2245             on end-move persistent run diasize_end-move in this-procedure .
     2246           end triggers.
     2247         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2248         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2249         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2250         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2251         assign
     2252           v-diasize-wndmax = false
     2253         .
     2254         if connected("ub") = true
     2255         then do:
     2256           define variable v-cntxt-db-num        as integer   no-undo .
     2257           define variable v-cntxt-userid        as character no-undo .
     2258           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2259                                             , OUTPUT v-cntxt-userid
     2260                                             ) .
     2261           run gbl/wndpar_r.p
     2262             (input  v-cntxt-db-num
     2263             ,input  v-cntxt-userid
     2264             ,input  'wndmax':U
     2265             ,output v-diasize-wndmax
     2266             ,output v-default-value
     2267             ) .
     2268         end.
     2269         assign
     2270           v-diasize-wndstore = false
     2271         .
     2272         if connected("ub") = true
     2273         then do:
     2274           run gbl/wndpar_r.p
     2275             (input  v-cntxt-db-num
     2276             ,input  v-cntxt-userid
     2277             ,input  'wndstore':U
     2278             ,output v-diasize-wndstore
     2279             ,output v-default-value
     2280             ) .
     2281         end.
     2282         assign
     2283           v-diasize-proc-name = entry(1, program-name(2), '.')
     2284         .
     2285         if v-diasize-wndstore = true
     2286         then do:
     2287           assign
     2288             v-restore-saved = false
     2289           .
     2290           if connected("ub") = true
     2291           then do:
     2292             run gbl/wndsizer.p
     2293               (input  v-cntxt-db-num
     2294               ,input  v-cntxt-userid
     2295               ,input  v-diasize-proc-name
     2296               ,input  'height':u
     2297               ,output v-resize-value-str
     2298               ) .
     2299             if v-resize-value-str <> '':U
     2300             then do:
     2301               run diasize_change-height in this-procedure
     2302                 (input  integer(v-resize-value-str)
     2303                 ,input  true
     2304                 ) .
     2305               assign
     2306                 v-restore-saved = true
     2307               .
     2308             end.
     2309           end.
     2310           if connected("ub") = true
     2311           then do:
     2312             run gbl/wndsizer.p
     2313               (input  v-cntxt-db-num
     2314               ,input  v-cntxt-userid
     2315               ,input  v-diasize-proc-name
     2316               ,input  'width':u
     2317               ,output v-resize-value-str
     2318               ) .
     2319             if v-resize-value-str <> '':U
     2320             then do:
     2321               run diasize_change-width in this-procedure
     2322                 (input  integer(v-resize-value-str)
     2323                 ,input  true
     2324                 ) .
     2325               assign
     2326                 v-restore-saved = true
     2327               .
     2328             end.
     2329           end.
     2330           if v-restore-saved <> true
     2331           then do:
     2332             if v-diasize-wndmax = true
     2333             then do:
     2334               run diasize_maximize in this-procedure
     2335                 (input  true
     2336                 ) .
     2337             end.
     2338           end.
     2339         end.
     2340         else do:
     2341           if v-diasize-wndmax = true
     2342           then do:
     2343             run diasize_maximize in this-procedure
     2344               (input  true
     2345               ) .
     2346           end.
     2347         end.
     2348       end.
     2349     end.
     2350   end procedure.
     2351   procedure diasize_need-full-display :
     2352     define output parameter p-need-full-display as logical   no-undo .
     2353     do
     2354     on error undo, return error return-value
     2355     :
     2356       assign
     2357         p-need-full-display = v-diasize-need-full-display
     2358       .
     2359       assign
     2360         v-diasize-need-full-display = false
     2361       .
     2362     end.
     2363   end procedure.
     2364   procedure get-context :
     2365      define output parameter p-db-num as integer          no-undo.
     2366      define output parameter p-user-id as character        no-undo.
     2367      define variable v-login               as character    no-undo.
     2368      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2369      define buffer buf_user-login  for ub.user-login .
     2370      do
     2371      on error undo, return error
     2372      :
     2373            FIND FIRST buf_sys-ctrl no-lock.
     2374            ASSIGN
     2375               v-login = USERID("ub")
     2376               p-db-num = buf_sys-ctrl.db-num
     2377            .
     2378            FIND FIRST buf_user-login
     2379                 WHERE buf_user-login.db-num = p-db-num
     2380                   AND buf_user-login.user-login = v-login
     2381                 no-lock
     2382                 no-error
     2383                 .
     2384            IF AVAILABLE buf_user-login
     2385            THEN DO:
     2386               assign
     2387                  p-user-id = buf_user-login.user-id
     2388               .
     2389            END.
     2390      end.
     2391   end procedure.
     2392       run diasize_init in this-procedure .
     2393   MAIN-BLOCK:
     2394   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2395      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2396   define variable p-file-label as character no-undo .
     2397     p-file-label =  "История ДНЦ".
     2398   temp-changes.l_name:RESIZABLE in browse BR-changes = true .
     2399   temp-changes.v_old:RESIZABLE  in browse BR-changes = true .
     2400   temp-changes.v_new:RESIZABLE  in browse BR-changes = true .
     2401   define buffer buf_clients for  ub.clients .
     2402     run my-enable_ui.
     2403     run openbr (yes, no, '':u).
     2404     apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     2405     wait-for go of frame Dialog-Frame.
     2406   END.
     2407   run disable_ui.
     2408   PROCEDURE disable_UI :
     2409     HIDE FRAME Dialog-Frame.
     2410   END PROCEDURE.
     2411   PROCEDURE enable_UI :
     2412     ENABLE B-Cancel B-Help BR-docs BR-changes
     2413         WITH FRAME Dialog-Frame.
     2414     VIEW FRAME Dialog-Frame.
     2415     OPEN QUERY BR-docs FOR EACH buf_c-price-doc-forming no-lock.
     2416   END PROCEDURE.
     2417   PROCEDURE my-enable_UI :
     2418   ENABLE B-Cancel
     2419            B-sch
     2420            B-Help
     2421            BR-docs
     2422            BR-changes
     2423         WITH FRAME Dialog-Frame.
     2424     VIEW FRAME Dialog-Frame.
     2425   END PROCEDURE.
     2426   PROCEDURE OpenBr :
     2427   define input  parameter p-open-query     as logical   no-undo .
     2428   define input  parameter p-find-next      as logical   no-undo .
     2429   define input  parameter p-find-condition as character no-undo .
     2430   def var l-query-was-opened as logical no-undo .
     2431   define variable title0 as character no-undo.
     2432   title0 = caps(p-file-label) + chr(32).
     2433   def var sort-column-phrase as character no-undo .
     2434   case sort-column-name :
     2435     when "" then do:
     2436       assign
     2437         sort-column-phrase = ""
     2438       .
     2439     end.
     2440     otherwise do:
     2441       assign
     2442         sort-column-phrase = "by " + sort-column-name
     2443       .
     2444     end.
     2445   end case.
     2446   define variable l-open-query as logical   no-undo .
     2447          filter-point = filter-point0 .
     2448    ASSIGN frame Dialog-Frame:TITLE = title0 .
     2449   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2450   define variable  l-disable-where-15  as logical   no-undo .
     2451   define variable  l-filter-open-15    as logical   .
     2452   define variable  flt-rec-15       as recid     no-undo .
     2453   define variable  filter-name-15      as character no-undo .
     2454   define variable  where-phrase-15     as character no-undo .
     2455   define variable  sort-phrase-15      as character no-undo .
     2456   define variable  where-phrase-rus-15 as character no-undo .
     2457   define variable  sort-phrase-rus-15  as character no-undo .
     2458   run gbl/flt-get.p
     2459     (input filter-point
     2460     ,output flt-rec-15
     2461     ,output filter-name-15
     2462     ,output where-phrase-15
     2463     ,output sort-phrase-15
     2464     ,output where-phrase-rus-15
     2465     ,output sort-phrase-rus-15
     2466     ).
     2467   if p-open-query then do:
     2468       run set-filter-name in this-procedure
     2469         (INPUT filter-name-15
     2470         ) no-error .
     2471     assign
     2472       l-filter-open-15 = false
     2473     .
     2474     if flt-rec-15 <> ?
     2475       or sort-column-phrase > ""
     2476     then do:
     2477       define variable  parameter-2-15 as character no-undo .
     2478       define variable  parameter-3-15 as character no-undo .
     2479       define variable  parameter-4-15 as character no-undo .
     2480       define variable  parameter-5-15 as character no-undo .
     2481       define variable  parameter-6-15 as character no-undo .
     2482       define variable  parameter-7-15 as character no-undo .
     2483         assign
     2484         parameter-3-15 =
     2485                                 "FOR EACH buf_c-price-doc-forming"
     2486         parameter-4-15 =
     2487           (
     2488             if (" buf_c-price-doc-forming.plt-id = par-plt-id and buf_c-price-doc-forming.pdf-id =  par-pdf-id and buf_c-price-doc-forming.plt-db-num = par-plt-db-num and buf_c-price-doc-forming.pdf-db = par-pdf-db " + " " + where-phrase-15) <> ""
     2489             then  substitute( ' buf_c-price-doc-forming.plt-id = &1 and buf_c-price-doc-forming.pdf-id =  &2 and buf_c-price-doc-forming.plt-db-num = &3 and buf_c-price-doc-forming.pdf-db = &4 ', par-plt-id , par-pdf-id , par-plt-db-num ,par-pdf-db )   + " " + where-phrase-15
     2490             else "true"
     2491           )
     2492         parameter-5-15 = (" " + "" + " " + "")
     2493         parameter-6-15 = if sort-phrase-15 = ''
     2494                              then
     2495           (
     2496           " " + "  " +
     2497             " " + sort-column-phrase +
     2498           " " + "  "
     2499           )
     2500                              else
     2501           (
     2502           " " + "  " +
     2503             " " + sort-column-phrase +
     2504           " " + sort-phrase-15
     2505           )
     2506         parameter-7-15 =
     2507           " indexed-reposition  "
     2508       .
     2509       do
     2510       on stop undo, leave
     2511       on error undo, leave
     2512       :
     2513         assign
     2514           l-disable-where-15 =
     2515             (" buf_c-price-doc-forming.plt-id = par-plt-id and buf_c-price-doc-forming.pdf-id =  par-pdf-id and buf_c-price-doc-forming.plt-db-num = par-plt-db-num and buf_c-price-doc-forming.pdf-db = par-pdf-db " + " " + where-phrase-15 = "")
     2516         .
     2517         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2518                             ,input query br-docs:handle
     2519                             ,input parameter-3-15
     2520                             ,input parameter-4-15
     2521                             ,input parameter-5-15
     2522                             ,input parameter-6-15
     2523                             ,input parameter-7-15
     2524                             )
     2525         .
     2526         assign
     2527           l-filter-open-15 = true
     2528         .
     2529       end.
     2530       if l-filter-open-15 = false then do:
     2531         message
     2532           "Ошибка при фильтрации / сортировке" skip
     2533           "Будут показаны записи без учета фильтра" skip
     2534           view-as alert-box .
     2535       end.
     2536       else do:
     2537           assign
     2538             l-query-was-opened = true
     2539           .
     2540       end.
     2541     end.
     2542     if l-filter-open-15 = false then do:
     2543       OPEN QUERY br-docs FOR EACH buf_c-price-doc-forming
     2544         where  buf_c-price-doc-forming.plt-id = par-plt-id and buf_c-price-doc-forming.pdf-id =  par-pdf-id and buf_c-price-doc-forming.plt-db-num = par-plt-db-num and buf_c-price-doc-forming.pdf-db = par-pdf-db
     2545         indexed-reposition
     2546     .
     2547         assign
     2548           l-query-was-opened = true
     2549         .
     2550     end.
     2551   end.
     2552   else do:
     2553     assign
     2554       doc-rec = recid( buf_c-price-doc-forming )
     2555     .
     2556     do
     2557     on stop undo, leave
     2558     on error undo, leave
     2559     :
     2560       if query br-docs:handle:get-buffer-handle(1) = (buffer buf_c-price-doc-forming:handle) then do:
     2561         assign
     2562         parameter-2-15 = (if p-find-next then "true":u else "false":u )
     2563         parameter-4-15 =
     2564           "where ":u +  substitute( ' buf_c-price-doc-forming.plt-id = &1 and buf_c-price-doc-forming.pdf-id =  &2 and buf_c-price-doc-forming.plt-db-num = &3 and buf_c-price-doc-forming.pdf-db = &4 ', par-plt-id , par-pdf-id , par-plt-db-num ,par-pdf-db )   + " ":u + where-phrase-15 + " ":u + p-find-condition + " " + ""
     2565         parameter-5-15 = "  "
     2566       .
     2567         run fltopend_fltfindd in this-procedure  (
     2568                             input this-procedure:handle
     2569                             ,input query br-docs:handle
     2570                             ,input rowid(buf_c-price-doc-forming)
     2571                             ,input logical(parameter-2-15)
     2572                             ,input no-lock
     2573                             ,input (buffer buf_c-price-doc-forming:handle)
     2574                             ,input parameter-4-15
     2575                             ,input parameter-5-15
     2576                             ) no-error.
     2577         .
     2578         assign
     2579           doc-rec = integer(return-value)
     2580           v-fltopend-rowid[1] = ?
     2581         .
     2582       end.
     2583       else do:
     2584         assign
     2585         parameter-2-15 = (if p-find-next then "true":u else "false":u )
     2586         parameter-3-15 =  "FOR EACH buf_c-price-doc-forming"
     2587         parameter-4-15 =
     2588           (
     2589             if (" buf_c-price-doc-forming.plt-id = par-plt-id and buf_c-price-doc-forming.pdf-id =  par-pdf-id and buf_c-price-doc-forming.plt-db-num = par-plt-db-num and buf_c-price-doc-forming.pdf-db = par-pdf-db " + " " + where-phrase-15) <> ""
     2590             then  substitute( ' buf_c-price-doc-forming.plt-id = &1 and buf_c-price-doc-forming.pdf-id =  &2 and buf_c-price-doc-forming.plt-db-num = &3 and buf_c-price-doc-forming.pdf-db = &4 ', par-plt-id , par-pdf-id , par-plt-db-num ,par-pdf-db )   + " " + where-phrase-15
     2591             else "true"
     2592           )
     2593         parameter-5-15 = (" " + "" + " " + "" + " " + p-find-condition)
     2594         parameter-6-15 = if sort-phrase-15 = ''
     2595                              then
     2596           (
     2597           " " + "  " +
     2598             " " + sort-column-phrase +
     2599           " " + "  "
     2600           )
     2601                              else
     2602           (
     2603           " " + "  " +
     2604             " " + sort-column-phrase +
     2605           " " + sort-phrase-15
     2606           )
     2607         parameter-7-15 =
     2608           " indexed-reposition  "
     2609       .
     2610         run fltopend_fltfindq in this-procedure  (
     2611                             input this-procedure:handle
     2612                             ,input query br-docs:handle
     2613                             ,input logical(parameter-2-15)
     2614                             ,input no-lock
     2615                             ,input parameter-3-15
     2616                             ,input parameter-4-15
     2617                             ,input parameter-5-15
     2618                             ,input parameter-6-15
     2619                             ,input parameter-7-15
     2620                             ,output v-fltopend-rowid
     2621                             ) no-error.
     2622         .
     2623         doc-rec = ?.
     2624       end.
     2625       assign
     2626         l-query-was-opened = true
     2627       .
     2628     end.
     2629   end.
     2630   if not p-open-query then
     2631   REPOSITION br-docs to recid doc-rec No-ERROR.
     2632   APPLY "VALUE-CHANGED" TO br-docs in frame Dialog-Frame.
     2633   APPLY "ENTRY" TO br-docs.
     2634   END PROCEDURE.
     2635   PROCEDURE proc-b-sch :
     2636   assign
     2637     tbl = 'c-price-doc-forming'
     2638     join-tbl = 'buf_c-price-doc-forming'
     2639     fld = ""
     2640     lab = ""
     2641     spr = ""
     2642     dim = '0'
     2643     .
     2644   run fltfield-add in this-procedure('plt-id', 'Внутр.№', '',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2645   run fltfield-add in this-procedure('who', '', 'usr', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2646   run fltfield-add in this-procedure('corr-user-name', '', 'usr', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2647   Filter-Block:
     2648   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     2649       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     2650       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     2651     run gbl/filter.w ( INPUT parparentproc, INPUT filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     2652     run openbr (yes, no, '':u).
     2653   END.
     2654   END PROCEDURE.
     2655   PROCEDURE proc-find-code :
     2656   define input parameter par-next as logical no-undo.
     2657   define input parameter parplt-id as char no-undo.
     2658   END PROCEDURE.
     2659   PROCEDURE proc-view-changes :
     2660   define buffer old_c-price-doc-forming   for ub.c-price-doc-forming.
     2661   define buffer current_price-doc-forming for ub.price-doc-forming.
     2662   define variable v-chg-fields as character no-undo.
     2663   define variable v-old-fields as character no-undo.
     2664   define variable v-new-fields as character no-undo.
     2665   define variable ii as integer no-undo.
     2666   for each temp-changes:
     2667       delete temp-changes.
     2668   END.
     2669   if not available buf_c-price-doc-forming then do:
     2670     open query br-changes for each temp-changes.
     2671     return.
     2672   end.
     2673   find first old_c-price-doc-forming no-lock where
     2674              old_c-price-doc-forming.plt-id      = buf_c-price-doc-forming.plt-id and
     2675              old_c-price-doc-forming.plt-db-num  = buf_c-price-doc-forming.plt-db-num and
     2676              old_c-price-doc-forming.pdf-id      = buf_c-price-doc-forming.pdf-id and
     2677              old_c-price-doc-forming.pdf-db      = buf_c-price-doc-forming.pdf-db and
     2678              old_c-price-doc-forming.chip-num  <   buf_c-price-doc-forming.chip-num no-error.
     2679   if not available old_c-price-doc-forming then do:
     2680           find first current_price-doc-forming no-lock where
     2681                      current_price-doc-forming.plt-id      = buf_c-price-doc-forming.plt-id and
     2682                      current_price-doc-forming.plt-db-num  = buf_c-price-doc-forming.plt-db-num and
     2683                      current_price-doc-forming.pdf-id      = buf_c-price-doc-forming.pdf-id and
     2684                      current_price-doc-forming.pdf-db      = buf_c-price-doc-forming.pdf-db
     2685                      no-error.
     2686           if not available current_price-doc-forming then do:
     2687               return error.
     2688           end.
     2689           buffer-compare current_price-doc-forming  to buf_c-price-doc-forming
     2690           save result in v-chg-fields.
     2691   end.
     2692   else do:
     2693       buffer-compare old_c-price-doc-forming except chip-num corr-date corr-time corr-user-name corr-user-db-num to buf_c-price-doc-forming
     2694       save result in v-chg-fields.
     2695   end.
     2696   if num-entries(v-chg-fields) > 0 then do:
     2697   do ii = 1 to num-entries(v-chg-fields):
     2698   CASE entry(ii, v-chg-fields):
     2699   when "base-rate":U then do:     create temp-changes.       assign         temp-changes.f_name = "base-rate":U         temp-changes.l_name = "баз.вал."         temp-changes.v_new  = string(buf_c-price-doc-forming.base-rate)         temp-changes.v_old  = (if available old_c-price-doc-forming                                  then string(old_c-price-doc-forming.base-rate)                                  else "Создание шапки" )         .   end.
     2700   when "base-scale":U then do:     create temp-changes.       assign         temp-changes.f_name = "base-scale":U         temp-changes.l_name = "баз.вал."         temp-changes.v_new  = string(buf_c-price-doc-forming.base-scale)         temp-changes.v_old  = (if available old_c-price-doc-forming                                  then string(old_c-price-doc-forming.base-scale)                                  else "Создание шапки" )         .   end.
     2701    when "db-num-chg":U then do:     create temp-changes.       assign         temp-changes.f_name = "db-num-chg":U         temp-changes.l_name = "БД изм."         temp-changes.v_new  = string(buf_c-price-doc-forming.db-num-chg)         temp-changes.v_old  = (if available old_c-price-doc-forming                                  then string(old_c-price-doc-forming.db-num-chg)                                  else "Создание шапки" )         .   end.
     2702    when "des":U then do:     create temp-changes.       assign         temp-changes.f_name = "des":U         temp-changes.l_name = "Описание"         temp-changes.v_new  = string(buf_c-price-doc-forming.des)         temp-changes.v_old  = (if available old_c-price-doc-forming                                  then string(old_c-price-doc-forming.des)                                  else "Создание шапки" )         .   end.
     2703    when "end-date":U then do:     create temp-changes.       assign         temp-changes.f_name = "end-date":U         temp-changes.l_name = "Дата окончания"         temp-changes.v_new  = string(buf_c-price-doc-forming.end-date)         temp-changes.v_old  = (if available old_c-price-doc-forming                                  then string(old_c-price-doc-forming.end-date)                                  else "Создание шапки" )         .   end.
     2704    when "end-shift-date":U then do:     create temp-changes.       assign         temp-changes.f_name = "end-shift-date":U         temp-changes.l_name = "Дата смены окончания"         temp-changes.v_new  = string(buf_c-price-doc-forming.end-shift-date)         temp-changes.v_old  = (if available old_c-price-doc-forming                                  then string(old_c-price-doc-forming.end-shift-date)                                  else "Создание шапки" )         .   end.
     2705    when "end-shift-name":U then do:     create temp-changes.       assign         temp-changes.f_name = "end-shift-name":U         temp-changes.l_name = "№ смены окончания"         temp-changes.v_new  = string(buf_c-price-doc-forming.end-shift-name)         temp-changes.v_old  = (if available old_c-price-doc-forming                                  then string(old_c-price-doc-forming.end-shift-name)                                  else "Создание шапки" )         .   end.
     2706    when "end-shift-num":U then do:     create temp-changes.       assign         temp-changes.f_name = "end-shift-num":U         temp-changes.l_name = "Порядок смены окончания"         temp-changes.v_new  = string(buf_c-price-doc-forming.end-shift-num)         temp-changes.v_old  = (if available old_c-price-doc-forming                                  then string(old_c-price-doc-forming.end-shift-num)                                  else "Создание шапки" )         .   end.
