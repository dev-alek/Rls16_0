     2732   define buffer old_c-price-doc-forming-gds for ub.c-price-doc-forming-gds  .
     2733   for each ub.c-price-doc-forming-gds where
     2734            ub.c-price-doc-forming-gds.plt-id      = buf_c-price-doc-forming.plt-id     and
     2735            ub.c-price-doc-forming-gds.plt-db-num  = buf_c-price-doc-forming.plt-db-num and
     2736            ub.c-price-doc-forming-gds.pdf-id      = buf_c-price-doc-forming.pdf-id     and
     2737            ub.c-price-doc-forming-gds.pdf-db      = buf_c-price-doc-forming.pdf-db     and
     2738            ub.c-price-doc-forming-gds.chip-num    = buf_c-price-doc-forming.chip-num
     2739            :
     2740             v-chg-fields = ''.
     2741        find first old_c-price-doc-forming-gds no-lock where
     2742            old_c-price-doc-forming-gds.plt-id      = ub.c-price-doc-forming-gds.plt-id    and
     2743            old_c-price-doc-forming-gds.plt-db-num  = ub.c-price-doc-forming-gds.plt-db-num and
     2744            old_c-price-doc-forming-gds.pdf-id      = ub.c-price-doc-forming-gds.pdf-id    and
     2745            old_c-price-doc-forming-gds.pdf-db      = ub.c-price-doc-forming-gds.pdf-db    and
     2746            old_c-price-doc-forming-gds.artic       = ub.c-price-doc-forming-gds.artic     and
     2747            old_c-price-doc-forming-gds.prod-type   = ub.c-price-doc-forming-gds.prod-type and
     2748            old_c-price-doc-forming-gds.prod-code   = ub.c-price-doc-forming-gds.prod-code and
     2749            old_c-price-doc-forming-gds.chip-num    < ub.c-price-doc-forming-gds.chip-num
     2750            use-index pi no-error .
     2751            if available old_c-price-doc-forming-gds then do:
     2752               buffer-compare old_c-price-doc-forming-gds except chip-num corr-date corr-time corr-user-name corr-user-db-num  to ub.c-price-doc-forming-gds
     2753               save result in v-chg-fields.
     2754            end.
     2755     IF num-entries(v-chg-fields) = 0 THEN DO:
     2756       create temp-changes.
     2757         assign
     2758           temp-changes.f_name ="line" + string(ub.c-price-doc-forming-gds.line-num ) + "ADD":U
     2759           temp-changes.l_name ="Доб.строки-" + string(ub.c-price-doc-forming-gds.line-num )
     2760           temp-changes.v_new = string(ub.c-price-doc-forming-gds.b-code)
     2761           temp-changes.v_old = ""
     2762         .
     2763     END.
     2764      do ii = 1 to num-entries(v-chg-fields):
     2765     CASE entry(ii, v-chg-fields):
     2766   when "artic":U then do:     create temp-changes.       assign         temp-changes.f_name ="line" + string(ub.c-price-doc-forming-gds.line-num ) + "artic":U         temp-changes.l_name ="Изм.строки-" + string(ub.c-price-doc-forming-gds.line-num ) + " " + "Артикул"         temp-changes.v_new = string(ub.c-price-doc-forming-gds.artic)         temp-changes.v_old =  (if available old_c-price-doc-forming-gds                                  then string(old_c-price-doc-forming-gds.artic)                                  else "" )       .   end.
