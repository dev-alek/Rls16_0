      127   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      129   define new shared variable RepPathName        as character no-undo .
      130   define new shared variable PrintRubl          as logical   no-undo .
      131   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      132   define variable v-waitfram-action01         as character   no-undo .
      133   define variable v-waitfram-action02         as character   no-undo .
      134   define variable v-waitfram-action03         as character   no-undo .
      135   define variable mWaitFramTextBeg            as character   no-undo.
      136   define variable mWaitFramTextEnd            as character   no-undo.
      137   define variable mWaitFramView               as logical     no-undo.
      138   define variable mWaitProcEvent              as logical     no-undo init yes.
      139   define variable mWaitFramInterval           as integer     no-undo init 1 .
      140   define variable mWaitFramStop               as logical     no-undo.
      141   define variable mWaitFramStopUser           as logical     no-undo.
      142   define variable mWaitFramStopTimeOut        as logical     no-undo.
      143   define variable mWaitFramStartProc          as datetime-tz no-undo.
      144   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      145   define button B-WaitFramStop auto-end-key
      146        label "Стоп"
      147        size 10 by 1 tooltip "Остоновить процесс".
      148   define button B-viewProcInfo
      149        label "Информация"
      150        size 15 by 1 tooltip "Информация о процесс".
      151   define frame waitfram
      152     v-waitfram-action01 format "x(72)" no-label skip
      153     v-waitfram-action02 format "x(72)" no-label skip
      154     v-waitfram-action03 format "x(72)" no-label skip
      155     B-viewProcInfo
      156     B-WaitFramStop at row 4 col 30
      157     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      158     .
      159   define new global shared variable mBatchMode as logical no-undo init ?.
      160   define variable mFramBachModHandle as handle no-undo.
      161   mFramBachModHandle = frame waitfram:handle.
      162   define variable mFameOldVis as logical no-undo.
      163   define variable mVisCUrentVin as logical no-undo.
      164   if session:batch-mode
      165   then
      166      mBatchMode = yes.
      167   if mBatchMode = ? then do:
      168     mVisCUrentVin = current-window:visible.
      169     mFameOldVis = mFramBachModHandle:visible.
      170     mFramBachModHandle:visible  = yes.
      171     mBatchMode = mFramBachModHandle:visible ne yes.
      172     mFramBachModHandle:visible = mFameOldVis.
      173     current-window:visible = mVisCUrentVin.
      174   end.
      175    if  log-manager:logfile-name ne ?
      176     then DO:
      177         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      178         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      179         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      180     end.
      181   on choose of B-WaitFramStop in frame waitfram
      182   do:
      183     mWaitFramStop = yes.
      184     mWaitFramStopUser = yes.
      185   end.
      186   function waitfram-check-timeout returns logical():
      187      define variable vtime as int64 no-undo.
      188      if mWaitFramStopTimeOut
      189      then
      190         return yes.
      191      vtime = ( now - mWaitFramStartProc ) / 1000 .
      192      if     mWaitFramTimeOut ne ?
      193         and mWaitFramTimeOut ne 0
      194         and mWaitFramTimeOut lt vtime
      195      then do:
      196         mWaitFramStopTimeOut = yes.
      197      end.
      198      return mWaitFramStopTimeOut.
      199   end.
      200   procedure waitfram-hide :
      201     if not session:batch-mode
      202     then do
      203     on error undo, return error return-value
      204     :
      205       pause 0 before-hide .
      206       if not mBatchMode then
      207         hide frame waitfram .
      208     if     not mWaitFramView
      209        and mWaitProcEvent
      210     then
      211       process events .
      212     end.
      213   end procedure.
      214   procedure waitfram-show :
      215     define input  parameter p-message as character no-undo .
      216     define variable v-left-margin as integer   no-undo .
      217     if not session:batch-mode
      218     then do
      219     on error undo, return error return-value
      220     :
      221       if length(p-message) <= 70 then do:
      222         assign
      223           v-left-margin = integer((70 - length(p-message)) / 2)
      224         .
      225         assign
      226           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      227         .
      228         assign
      229           v-waitfram-action01 = " "
      230           v-waitfram-action02 = " "
      231                                    + fill(" ", v-left-margin)
      232                                    + p-message
      233           v-waitfram-action03 = " "
      234         .
      235       end.
      236       else do:
      237         define variable vRindex1 as integer no-undo.
      238         define variable vRindex2 as integer no-undo.
      239         vRindex1 = r-index(p-message," ",70).
      240         if vRindex1 = 0
      241         then
      242            vRindex1 = 70.
      243         if length(p-message)  <= vRindex1 + 70 then do:
      244           assign
      245             v-waitfram-action01 = " "
      246             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      247             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      248           .
      249         end.
      250         else do:
      251           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      252           if vRindex2 <= vRindex1
      253           then
      254              vRindex2 = vRindex1 + 70.
      255           assign
      256             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      257             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      258             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      259           .
      260         end.
      261       end.
      262       B-viewProcInfo:visible   in frame waitfram = no.
      263       B-viewProcInfo:sensitive in frame waitfram = no.
      264       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      265       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      266       if  (   mWaitFramView
      267          or  mWaitProcEvent)
      268          and not mBatchMode
      269       then
      270          display
      271             v-waitfram-action01 skip
      272             v-waitfram-action02 skip
      273             v-waitfram-action03 skip
      274          with frame waitfram .
      275       if     mWaitFramView
      276          then do:
      277             if     mWaitFramInterval ne ?
      278                and not mBatchMode
      279             then
      280                wait-for go of frame waitfram pause mWaitFramInterval.
      281          end.
      282          else
      283             if     mWaitProcEvent
      284                and not mBatchMode
      285             then
      286                process events .
      287     end.
      288   end procedure.
      289      procedure waitfram-show-this:
      290         define input  parameter iInterval as int64 no-undo.
      291         define variable vtime as int64 no-undo.
      292         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      293         mWaitFramInterval = iInterval.
      294         run waitfram-show (substitute("&1&2 &3&4" ,
      295                                       mWaitFramTextBeg ,
      296                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      297                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      298                                       mWaitFramTextEnd
      299                                      )
      300                           ).
      301      end.
      302      procedure WaitFramRunPause:
      303         define input  parameter iInterval as dec no-undo.
      304         define variable vStart  as datetime-tz no-undo.
      305         define variable vend    as datetime-tz no-undo.
      306         define variable vint as int64 no-undo.
      307         define variable vOk as logical no-undo.
      308         vStart = now.
      309         vend   = vStart.
      310         publish "WaitFramPause" (iInterval,output vOk).
      311         vend   =  now.
      312         vint = vend - vStart.
      313         vint = iInterval - vint / 1000.
      314         if     not mWaitFramStop
      315            and (   vint > 0
      316                 or (    not vOk
      317                     and iInterval eq ?
      318                     )
      319                 )
      320         then
      321            run waitfram-show-this (iInterval).
      322         vend   =  now.
      323         vint = vend - vStart.
      324         vint = iInterval - vint / 1000.
      325         if     not mWaitFramStop
      326            and vint > 0
      327         then do:
      328            run gbl/pause.p (vint * 1000).
      329         end.
      330         if iInterval ne ?
      331         then
      332            publish "WaitFramStop".
      333         waitfram-check-timeout().
      334      end.
      335      procedure WaitFramWaitFor:
      336         define input  parameter iInterval as dec no-undo.
      337         assign
      338            mWaitFramStartProc   = now
      339            mWaitFramStopUser    = no
      340            mWaitFramStopTimeOut = no
      341         .
      342         block-wait:
      343         do while not mWaitFramStop:
      344            run WaitFramRunPause (iInterval).
      345            if  waitfram-check-timeout()
      346            then do:
      347               leave block-wait.
      348            end.
      349         end.
      350         run waitfram-hide.
      351      end.
      352   procedure waitfram-join :
      353     define input  parameter p-line-1  as character no-undo .
      354     define input  parameter p-line-2  as character no-undo .
      355     define input  parameter p-line-3  as character no-undo .
      356     define output parameter p-message as character no-undo .
      357     do
      358     on error undo, return error return-value
      359     :
      360       assign
      361         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      362                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      363                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      364       .
      365     end.
      366   end procedure.
      367   function waitfram-join-function returns character
      368     (input p-line-1 as character
      369     ,input p-line-2 as character
      370     ,input p-line-3 as character
      371     ).
      372     define variable v-message as character no-undo .
      373     run waitfram-join in this-procedure
      374       (input  p-line-1
      375       ,input  p-line-2
      376       ,input  p-line-3
      377       ,output v-message
      378       ) .
      379     return v-message .
      380   end function .
      381   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      382   define  stream PrnLibStream.
      383   procedure prn-lib-prn-file :
      384     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      385     define input parameter p-DIsabledoptions as integer no-undo .
      386     define variable v-report-name as character no-undo .
      387     define variable v-user-action as character no-undo .
      388     define variable v-printed     as logical   no-undo .
      389     define variable v-exist       as logical   no-undo .
      390     do
      391       on error undo, return error
      392       :
      393       run prn-lib-get-report-name  in this-procedure (
      394         input parParentProc
      395         ,output v-report-name
      396         ).
      397   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      398   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      399     (input  v-report-name
      400     ,input  2
      401     ,output v-exist
      402     )  .
      403       if NOT v-exist then
      404       DO:
      405         Message
      406           "Нет заданий на печать ! "
      407           view-as alert-box .
      408         Return  .
      409       End.
      410       run gbl/prnfilen.w
      411         (input  ""
      412         ,input  p-DisabledOptions
      413         ,input  string(v-report-name )
      414         ,input  7
      415         ,output v-user-action
      416         ,output v-printed
      417         ) .
      418       if v-printed then
      419       do:
      420         return "YES" .
      421       end.
      422       else
      423       do:
      424         return "NO" .
      425       end.
      426     end.
