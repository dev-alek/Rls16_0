     2400   procedure diasize_add_browse :
     2401     define input  parameter p-browse-type   as character no-undo .
     2402     define input  parameter p-browse-handle as handle    no-undo .
     2403     define buffer buf_temp-browse-handle for temp-browse-handle .
     2404     do
     2405     on error undo, return error return-value
     2406     :
     2407       assign
     2408         v-diasize-browse-number = v-diasize-browse-number + 1
     2409       .
     2410       create buf_temp-browse-handle .
