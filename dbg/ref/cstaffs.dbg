      428   procedure prn-lib-open-stream :
      429     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      430     define input parameter p-page-size    as integer no-undo .
      431     define input parameter p-is-stream    as logical no-undo .
      432     define input parameter p-append       as logical no-undo .
      433     define variable v-report-name as character no-undo .
      434     do
      435       on error undo, return error
      436       :
      437       run prn-lib-get-report-name  in this-procedure (
      438         input parParentProc
      439         ,output v-report-name
      440         ).
      441       if p-is-stream then
      442       do:
      443         if p-append then
      444         do:
      445           output stream PrnLibStream to value( v-report-name )
      446             page-size value(p-page-size) append .
      447         end.
      448         if not p-append then
      449         do:
      450           output stream PrnLibStream to value( v-report-name )
      451             page-size value(p-page-size) .
      452         end.
      453       end.
      454       if not p-is-stream then
      455       do:
      456         if p-append then
      457         do:
      458           output to value( v-report-name )
      459             page-size value(p-page-size) append .
      460         end.
      461         if not p-append then
      462         do:
      463           output to value( v-report-name )
      464             page-size value(p-page-size) .
      465         end.
      466       end.
      467     end.
      468   end procedure.
      469   procedure prn-lib-open-exp :
      470     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      471     define input parameter p-is-stream    as logical no-undo .
      472     define input parameter p-is-append    as logical no-undo .
      473     define output parameter p-ReportFileName as char init "report" no-undo.
      474     define output parameter p-process as logical no-undo .
      475     define variable glog as logical no-undo .
      476     do
      477       on error undo, return error
      478       :
      479       SYSTEM-DIALOG GET-FILE p-ReportFileName
      480         TITLE      "Укажите путь"
      481         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      482         ASK-OVERWRITE
      483         CREATE-TEST-FILE
      484         SAVE-AS
      485         USE-FILENAME
      486         DEFAULT-EXTENSION "txt"
      487         UPDATE glog
      488         .
      489       if not glog then  return.
      490       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      491       if p-is-stream then
      492       do:
      493         if p-is-append then
      494         do:
      495           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      496         end.
      497         else
      498         do:
      499           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      500         end.
      501       end.
      502       else
      503       do:
      504         if p-is-append then
      505         do:
      506           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      507         end.
      508         else
      509         do:
      510           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      511         end.
      512       end.
      513       p-process = yes.
      514     end.
      515   end procedure.
      516   procedure prn-lib-get-report-name :
      517     define input parameter parParentProc  as widget-handle no-undo.
      518     define output parameter p-report-name as character no-undo .
      519     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      520   end procedure.
      521   procedure prn-lib-reportviewer-report-name :
      522     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      523     define input parameter p-report-name-html as character no-undo .
      524     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      525   end procedure.
      526   procedure prn-lib-reportviewer :
      527     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      528     define input parameter p-report-name-html as character no-undo .
      529     define input parameter p-param        as character no-undo .
      530     define variable v-excel           as character no-undo init 'TRUE' .
      531     define variable v-value-character as character no-undo .
      532     define variable v-value-integer   as character no-undo .
      533     define variable v-value-date      as date      no-undo .
      534     define variable v-value-decimal   as decimal   no-undo .
      535     define variable rep-excel         as logical   no-undo .
      536     define variable excel-string      as character no-undo .
      537     define variable v-param-type      as character no-undo .
      538     define variable v-tth             as handle    no-undo .
      539     run adm/shattri.p (
      540       input "get":U
      541       ,input  ""
      542       ,input  0
      543       ,input  'report-glob':U
      544       ,input  'rep-excel':U
      545       ,output v-value-character
      546       ,output v-value-date
      547       ,output v-value-decimal
      548       ,output v-value-integer
      549       ,output rep-excel
      550       ,output v-param-type
      551       ,INPUT-OUTPUT table-handle v-tth
      552       )  .
      553     if rep-excel then v-excel = "TRUE" .
      554     else v-excel = "FALSE" .
      555     if p-param eq ""
      556     then
      557        p-param = "EXCEL:" + v-excel.
      558     else
      559        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      560     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      561   end procedure.
      562   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      563   procedure cur-time :
      564      define output parameter p-today as date      no-undo .
      565      define output parameter p-time  as integer   no-undo .
      566     do
      567     on error undo, return error
      568     :
      569       define variable v-date1 as date      no-undo .
      570       define variable v-date2 as date      no-undo .
      571       define variable v-time  as integer   no-undo .
      572       assign
      573         v-date1 = today
      574         v-time  = time
      575         v-date2 = today
      576       .
      577       if v-date1 <> v-date2
      578       then do:
      579         assign
      580           v-date1 = today
      581           v-time  = v-time
      582         .
      583       end.
      584       assign
      585         p-today = v-date1
      586         p-time  = v-time
      587       .
      588     end.
      589   end.
      590   function cur-time-date returns character
      591   :
      592     return string(today, '99/99/9999':U) .
      593   end.
      594   function cur-time-mjd returns decimal
      595   :
      596     define variable v-date as date      no-undo .
      597     define variable v-time as integer   no-undo .
      598     run cur-time in this-procedure
      599       (output v-date
      600       ,output v-time
      601       ) .
      602     return integer(v-date) - 2400002 + (v-time / 86400) .
      603   end.
      604   function cur-time-get-ending-index returns integer
      605   (input p-number as integer
      606   )
      607   :
      608     if p-number < 0
      609     or p-number = ?
      610     then do:
      611       return 1 .
      612     end.
      613     define variable v-rest as integer   no-undo .
      614     assign
      615       p-number = p-number modulo 100
      616     .
      617     if p-number < 20
      618     then do:
      619       assign
      620         v-rest = p-number
      621       .
      622     end.
      623     else do:
      624       assign
      625         v-rest = p-number modulo 10
      626       .
      627     end.
      628     case v-rest :
      629       when 1
      630       then do:
      631         return 2 .
      632       end.
      633       when 2 or
      634       when 3 or
      635       when 4
      636       then do:
      637         return 3 .
      638       end.
      639       otherwise do:
      640         return 1 .
      641       end.
      642     end case .
      643   end.
      644   procedure cur-time-mjd-to-date :
      645      define input  parameter i-mjd-diff as decimal no-undo.
      646      define output parameter o-Date     as date    no-undo.
      647      define output parameter o-Time     as integer no-undo.
      648      define variable v-day-number as integer   no-undo .
      649      if    i-mjd-diff < 0
      650         or i-mjd-diff = ?
      651      then do:
      652         return "?" .
      653      end.
      654      assign
      655         v-day-number = truncate(i-mjd-diff,0).
      656         o-Date = date(v-day-number + 2400002).
      657         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      658     .
      659   end.
      660   function cur-time-mjd-to-string returns character
      661   (input p-mjd-diff as decimal
      662   )
      663   :
      664     define variable v-day-number as integer   no-undo .
      665     define variable v-seconds    as integer   no-undo .
      666     define variable v-hour       as integer   no-undo .
      667     define variable v-min        as integer   no-undo .
      668     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      669     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      670     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      671     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      672     if p-mjd-diff < 0
      673     or p-mjd-diff = ?
      674     then do:
      675       return "?" .
      676     end.
      677     assign
      678       v-day-number = integer(truncate(p-mjd-diff,0))
      679       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      680     .
      681     if v-seconds > 86400
      682     then do:
      683       assign
      684         v-seconds = 86400 - 1
      685       .
      686     end.
      687     if v-seconds < 0
      688     then do:
      689       assign
      690         v-seconds = 0
      691       .
      692     end.
      693     assign
      694       v-hour = truncate(v-seconds / 3600, 0)
      695     .
      696     assign
      697       v-seconds = v-seconds modulo 3600
      698     .
      699     assign
      700       v-min = truncate(v-seconds / 60, 0)
      701     .
      702     assign
      703       v-seconds = v-seconds modulo 60
      704     .
      705     return
      706         (if v-day-number <> 0
      707           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      708           else ""
      709         )
      710       + (if v-day-number <> 0 or v-hour <> 0
      711           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      712           else ""
      713         )
      714       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      715           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      716           else ""
      717         )
      718       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      719       .
      720   end.
      721   function cur-time-string returns character
      722   :
      723     define variable v-date as date      no-undo .
      724     define variable v-time as integer   no-undo .
      725     run cur-time in this-procedure
      726       (output v-date
      727       ,output v-time
      728       ) .
      729     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      730   end.
      731   function cur-time-string-sec returns character
      732   :
      733     define variable v-date as date      no-undo .
      734     define variable v-time as integer   no-undo .
      735     run cur-time in this-procedure
      736       (output v-date
      737       ,output v-time
      738       ) .
      739     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      740   end.
      741   function cur-time-custom  returns character
      742   (input p-prefix as character
      743   ,input p-date-format as character
      744   ,input p-delimiter as character
      745   ,input p-time-format as character
      746   ,input p-suffix as character
      747   )
      748   :
      749     define variable v-date as date      no-undo .
      750     define variable v-time as integer   no-undo .
      751     run cur-time in this-procedure
      752       (output v-date
      753       ,output v-time
      754       ) .
      755     return
      756       p-prefix
      757       + string(v-date, p-date-format)
      758       + p-delimiter
      759       + string(v-time, p-time-format)
      760       + p-suffix
      761       .
      762   end.
      763   function cur-time-print  returns character
      764   :
      765     define variable v-date as date      no-undo .
      766     define variable v-time as integer   no-undo .
      767     run cur-time in this-procedure
      768       (output v-date
      769       ,output v-time
      770       ) .
      771     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      772   end.
      773   function cur-time-datetime returns datetime
      774   :
      775     define variable v-char as character no-undo .
      776     define variable v-datetime as datetime no-undo .
      777     v-char = cur-time-string().
      778     v-datetime = datetime(v-char).
      779     return  v-datetime.
      780   end.
      781   function cur-time-string-msec returns character
      782   :
      783     define variable v-date as datetime  no-undo .
      784     v-date = now.
      785     return string(v-date) .
      786   end.
      787   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      788   FUNCTION gbclcode-get-position returns character ( input p-role as character
      789                                                     ,input p-role-level as character
      790                                                     ,input p-work-place as character
      791                                                     ,input p-staff-code as integer
      792                                                                ):
      793   define variable v-role-name as character no-undo .
      794   define variable v-role-level as character no-undo .
      795   define variable v-staff-code as integer no-undo .
      796   assign
      797   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      798   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      799   v-staff-code = p-staff-code
      800   no-error .
      801   return substitute("&1, &2, Код &3"
      802                   ,v-role-name
      803                   ,v-role-level
      804                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      805   END.
      806   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      807   FUNCTION mark-string RETURNS CHARACTER
      808     ( input p-recid as recid, input mark-list as character  ) :
      809     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      810   END FUNCTION.
      811   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      812   function usrfulnf returns character ( input p-user-id as character):
      813   define variable v-user-name as character no-undo .
      814   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      815   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      816     (input  p-user-id
      817     ,output v-user-name
      818     ) no-error .
      819   if error-status:error
      820   or v-user-name = ""
      821   then do:
      822     return p-user-id.
      823   end.
      824   else do:
      825     return v-user-name.
      826   end.
      827   end function.
      828   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      829   define variable sort-column-name as character no-undo .
      830   define variable v-db-num LIKE ub.db.db-num no-undo.
      831   define variable v-rid-list as character no-undo .
      832   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      833   define   temp-table temp-changes no-undo
      834   field f_name as character
      835   field l_name as character
      836   field v_old as character
      837   field v_new as character
      838   field t_name as character
      839   field num_ as integer
      840   field uniq-key-rec as character
      841   field action as integer
      842   field fNotChange as logical
      843   index pi is unique primary
      844   num_
      845   t_name
      846   f_name
      847   index
      848   Chan
      849   fnotChange
      850   t_name
      851   f_name
      852   index imain uniq-key-rec
      853   .
      854   FUNCTION get-all-fields returns character (p-file-name as character ):
      855   define variable v-dop as character no-undo .
      856     find first _file no-lock where _file._file-name = p-file-name no-error .
      857     if not available _file then return "":U.
      858     for each _field no-lock where
      859              _field._file-recid = recid(_file) :
      860       assign
      861       v-dop = v-dop + _field._field-name + chr(44)
      862       .
      863     end.
      864     return trim(v-dop).
      865   END FUNCTION.
      866   PROCEDURE proc-full-temp-changes :
      867     define input  parameter p-act-create as logical   no-undo .
      868     define input  parameter p-act-delete as logical   no-undo .
      869     define input  parameter p-hst-handle as handle    no-undo .
      870     define input  parameter p-main-table as character no-undo .
      871     define input  parameter p-field-list as character no-undo .
      872     define input  parameter p-label-form as character no-undo .
      873     define variable h-new-buf         as handle    no-undo .
      874     define variable h-main-buf        as handle    no-undo .
      875     define variable h-for-comp        as handle    no-undo .
      876     define variable v-inform          as character no-undo .
      877     define variable v-ind             as integer   no-undo .
      878     define variable v-idx-field-qnty  as integer   no-undo .
      879     define variable v-num-entries     as integer   no-undo .
      880     define variable fh                as handle    no-undo .
      881     define variable fh-main           as handle    no-undo .
      882     define variable fh-old            as handle    no-undo .
      883     define variable fh-new            as handle    no-undo .
      884     define variable v-field-name      as character no-undo .
      885     define variable v-field-lvl       as character no-undo .
      886     define variable v-field-form      as character no-undo .
      887     define variable v-search-exp      as character no-undo .
      888     define variable v-srch-main       as character no-undo .
      889     define variable v-word-link       as character no-undo .
      890     define variable v-av-chip-num     as logical   no-undo .
      891     define variable v-main-pi-fld-lst as character no-undo .
      892     define variable v-main-fld-lst    as character no-undo .
      893     define variable v-delim-list      as character no-undo .
      894     define variable v-label           as character no-undo .
      895     define variable v-old-value       as character no-undo case-sensitive.
      896     define variable v-new-value       as character no-undo case-sensitive.
      897     define variable v-chg-fields as character no-undo.
      898     for each temp-changes:
      899       delete temp-changes.
      900     end.
      901     if not p-hst-handle:available then do:
      902       return .
      903     end.
      904     create buffer h-new-buf  for table p-hst-handle .
      905     create buffer h-main-buf for table p-main-table .
      906     assign
      907       v-inform = h-main-buf:index-information(1)
      908       v-ind    = 2
      909     .
      910     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      911     on error undo, return error
      912     :
      913       assign
      914         v-inform = h-main-buf:index-information( v-ind )
      915         v-ind    = v-ind + 1
      916       .
      917     end.
      918     if v-inform = ?
      919       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      920       or entry( 3, v-inform, ",":U ) <> "1":U
      921     then do:
      922       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      923     end.
      924     assign
      925       v-idx-field-qnty = num-entries( v-inform ) - 4
      926     .
      927     if v-idx-field-qnty < 2 then do:
      928       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      929     end.
      930     assign
      931       v-srch-main   = "where":U
      932       v-word-link   = "":U
      933       v-av-chip-num = false
      934       v-delim-list  = "":U
      935     .
      936     do v-ind = 1 to v-idx-field-qnty by 2
      937     on error undo, return error
      938     :
      939       assign
      940         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      941         fh                = p-hst-handle:buffer-field( v-field-name )
      942         fh-main           = h-main-buf:buffer-field( v-field-name )
      943         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      944         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      945       .
      946       if fh:data-type ="character":U then do:
      947         assign
      948           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      949         .
      950       end.
      951       else do:
      952         assign
      953           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      954         .
      955       end.
      956       if v-delim-list = "":U then do:
      957         assign
      958           v-delim-list = ",":U
      959         .
      960       end.
      961       if v-word-link = "":U then do:
      962         assign
      963           v-word-link = "and":U
      964         .
      965       end.
      966     end.
      967     assign
      968       v-delim-list  = "":U
      969     .
      970     do v-ind = 1 to h-main-buf:num-fields
      971     on error undo, return error
      972     :
      973       assign
      974         fh-main      = h-main-buf:buffer-field( v-ind )
      975         v-field-name = fh-main:name
      976       .
      977         assign
      978           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      979         .
      980         if v-delim-list = "":U then do:
      981           assign
      982             v-delim-list = ",":U
      983           .
      984         end.
      985     end.
      986     assign
      987       v-inform = p-hst-handle:index-information(1)
      988       v-ind    = 2
      989     .
      990     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      991     on error undo, return error
      992     :
      993       assign
      994         v-inform = p-hst-handle:index-information( v-ind )
      995         v-ind    = v-ind + 1
      996       .
      997     end.
      998     if v-inform = ?
      999       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1000       or entry( 3, v-inform, ",":U ) <> "1":U
     1001     then do:
     1002       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1003     end.
     1004     assign
     1005       v-idx-field-qnty = num-entries( v-inform ) - 4
     1006     .
     1007     if v-idx-field-qnty < 2 then do:
     1008       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1009     end.
     1010     assign
     1011       v-search-exp  = "where":U
     1012       v-word-link   = "":U
     1013       v-av-chip-num = false
     1014     .
     1015     do v-ind = 1 to v-idx-field-qnty by 2
     1016     on error undo, return error
     1017     :
     1018       assign
     1019         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1020         fh           = p-hst-handle:buffer-field( v-field-name )
     1021         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1022       .
     1023       if v-field-name = "chip-num":U then do:
     1024         assign
     1025           v-search-exp  = substitute( "&1 >", v-search-exp )
     1026           v-av-chip-num = true
     1027         .
     1028       end.
     1029       else do:
     1030         assign
     1031           v-search-exp = substitute( "&1 =", v-search-exp )
     1032         .
     1033       end.
     1034       if fh:data-type ="character":U then do:
     1035         assign
     1036           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1037         .
     1038       end.
     1039       else do:
     1040         assign
     1041           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1042         .
     1043       end.
     1044       if v-word-link = "":U then do:
     1045         assign
     1046           v-word-link = "and":U
     1047         .
     1048       end.
     1049     end.
     1050     if v-av-chip-num = false then do:
     1051       message
     1052         vss-workfile vss-revision vss-description skip
     1053         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1054         "Использование данной процедуры невозможно!" skip
     1055         view-as alert-box error .
     1056       return error .
     1057     end.
     1058     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1059     if not h-new-buf:available then do:
     1060       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1061       if not h-main-buf:available then do:
     1062         assign
     1063           h-for-comp = ?
     1064         .
     1065       end.
     1066       else do:
     1067         assign
     1068           h-for-comp = h-main-buf
     1069         .
     1070       end.
     1071     end.
     1072     else do:
     1073       assign
     1074         h-for-comp = h-new-buf
     1075       .
     1076     end.
     1077     assign
     1078       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1079     .
     1080     do v-ind = 1 to v-num-entries
     1081     on error undo, return error return-value
     1082     :
     1083       assign
     1084         v-field-name = entry( v-ind, v-main-fld-lst )
     1085         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1086         v-old-value  = fh-old:buffer-value()
     1087         v-label      = trim( fh-old:label )
     1088       .
     1089       if ( trim( p-field-list ) <> "":U
     1090            and lookup( v-field-name, p-field-list ) > 0
     1091          )
     1092          or trim( p-field-list ) = "":U
     1093       then do:
     1094         if h-for-comp <> ? then do:
     1095           assign
     1096             fh-new      = h-for-comp:buffer-field( v-field-name )
     1097             v-new-value = fh-new:buffer-value()
     1098           .
     1099         end.
     1100         else do:
     1101           assign
     1102             v-new-value = "":U
     1103           .
     1104         end.
     1105           if p-act-create = true then do:
     1106             assign
     1107               v-old-value = "":U
     1108             .
     1109           end.
     1110           if p-act-delete = true then do:
     1111             assign
     1112               v-new-value = "":U
     1113             .
     1114           end.
     1115         if v-old-value <> v-new-value
     1116         then do:
     1117           create temp-changes.
     1118           assign
     1119             temp-changes.t_name = p-main-table
     1120             temp-changes.f_name = v-field-name
     1121             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1122             temp-changes.v_old  = trim( v-old-value )
     1123             temp-changes.v_new  = trim( v-new-value )
     1124             temp-changes.num_   = 0
     1125             temp-changes.fNotChange = v-old-value eq v-new-value
     1126           .
     1127         end.
     1128       end.
     1129     end.
     1130     assign
     1131       v-num-entries = num-entries( p-label-form, chr(8) )
     1132     .
     1133     do v-ind = 1 to v-num-entries
     1134     on error undo, return error return-value
     1135     :
     1136       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1137         assign
     1138           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1139           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1140           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1141         .
     1142         find first temp-changes
     1143           where temp-changes.f_name = v-field-name
     1144           no-error .
     1145         if available temp-changes then do:
     1146           if trim( v-field-lvl ) <> "":U then do:
     1147             assign
     1148               temp-changes.l_name = v-field-lvl
     1149             .
     1150           end.
     1151           if trim( v-field-form ) <> "":U then do:
     1152             assign
     1153               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1154             .
     1155             if h-for-comp <> ? then do:
     1156               assign
     1157                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1158               .
     1159             end.
     1160           end.
     1161         end.
     1162       end.
     1163       else do:
     1164         message
     1165           vss-workfile vss-revision vss-description skip
     1166           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1167           substitute( "список для поля '&1': '&2'"
     1168                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1169                       ,entry( v-ind, p-label-form, chr(8) )
     1170                     ) skip
     1171           substitute( "полный список: &2", p-label-form ) skip
     1172           view-as alert-box error .
     1173       end.
     1174     end.
     1175     delete object h-new-buf .
     1176     delete object h-main-buf .
     1177   END PROCEDURE.
     1178   FUNCTION get-action RETURNS CHARACTER
     1179     ( INPUT p-action AS integer )  FORWARD.
     1180   FUNCTION get-action-from-c-cli RETURNS CHARACTER
     1181     ( INPUT p-psn-code AS INTEGER, INPUT p-corr-user-db-num AS INTEGER, INPUT p-chip-num AS INTEGER )  FORWARD.
     1182   DEFINE BUTTON B-Help
     1183        LABEL "Помо&щь"
     1184        SIZE 3 BY 1
     1185        BGCOLOR 8 .
     1186   DEFINE BUTTON B-lookup
     1187        LABEL "&Просмотр"
     1188        SIZE 10 BY 1.
     1189   DEFINE BUTTON B-mark
     1190        LABEL "&*"
     1191        SIZE 3 BY 1.
     1192   DEFINE BUTTON b-quit AUTO-END-KEY
     1193        LABEL "&Выход"
     1194        SIZE 10 BY 1
     1195        BGCOLOR 8 .
     1196   DEFINE BUTTON B-sel AUTO-GO
     1197        LABEL "Вы&бор"
     1198        SIZE 10 BY 1.
     1199   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1200         VIEW-AS TEXT
     1201        SIZE 6 BY 1
     1202        FGCOLOR 4  NO-UNDO.
     1203   DEFINE QUERY BR-changes FOR
     1204         temp-changes SCROLLING.
     1205   DEFINE QUERY br-cstaff FOR
     1206         X_c-staff SCROLLING.
     1207   DEFINE BROWSE BR-changes
     1208     QUERY BR-changes DISPLAY
     1209         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1210   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1211   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1212       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.04.
     1213   DEFINE BROWSE br-cstaff
     1214     QUERY br-cstaff NO-LOCK DISPLAY
     1215         mark-string(recid(X_c-staff), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1216   usrfulnf(X_c-staff.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1217   X_c-staff.corr-date COLUMN-LABEL "Дата!измен" FORMAT "99/99/9999":U
     1218   string(X_c-staff.corr-time, "HH:MM") COLUMN-LABEL "Время!измен" FORMAT "X(5)":U
     1219   gbclcode-get-position ( input X_c-staff.role
     1220                           ,input X_c-staff.role-level
     1221                           ,input X_c-staff.work-place
     1222                            ,input X_c-staff.staff-code )
     1223   COLUMN-LABEL "Работает" FORMAT "X(34)":U WIDTH 34
     1224   get-action-from-c-cli(X_c-staff.psn-code, X_c-staff.corr-user-db-num, X_c-staff.chip-num) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1225   X_c-staff.psn-code COLUMN-LABEL "Код физ.лица" FORMAT ">>>>>>>>9"
     1226   X_c-staff.date-start FORMAT "99/99/9999":U COLUMN-LABEL "Работает с"
     1227       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.25.
     1228   DEFINE FRAME Dialog-Frame
     1229        b-quit AT ROW 1 COL 1
     1230        B-mark AT ROW 1 COL 11
     1231        B-sel AT ROW 1 COL 21
     1232        B-lookup AT ROW 1 COL 61
     1233        B-Help AT ROW 1 COL 95
     1234        br-cstaff AT ROW 3 COL 1
     1235        BR-changes AT ROW 13 COL 1
     1236        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1237        SPACE(78.62) SKIP(20.04)
     1238       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1239            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1240            TITLE "История персонала"
     1241            CANCEL-BUTTON b-quit.
     1242   ASSIGN
     1243          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1244          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1245   ASSIGN
     1246          B-lookup:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1247   ASSIGN
     1248          br-cstaff:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1249   ON GO OF FRAME Dialog-Frame
     1250   DO:
     1251     p-rid-list = v-rid-list.
     1252   END.
     1253   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1254   DO:
     1255     APPLY "END-ERROR":U TO SELF.
     1256   END.
     1257   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1258   DO:
     1259     define variable loc#log as logical no-undo .
     1260     if available X_c-staff then do:
     1261   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1262   define variable v-str-recid11 as character no-undo .
     1263   define variable v-num-entry11 as integer   no-undo .
     1264   assign
     1265     v-str-recid11 = trim( string( recid( X_c-staff ) , "->>>>>>>>>>>9":U ) )
     1266     v-num-entry11 = lookup( v-str-recid11 , v-rid-list )
     1267   .
     1268   if v-num-entry11 > 0 then do:
     1269     assign
     1270       entry( v-num-entry11, v-rid-list ) = "":U
     1271       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1272     .
     1273   end.
     1274   else do:
     1275     assign
     1276       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid11
     1277     .
     1278   end.
     1279       loc#log = br-cstaff:refresh() .
     1280       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1281           loc#log = br-cstaff:select-next-row ().
     1282           apply "VALUE-CHANGED" to br-cstaff in frame Dialog-Frame.
     1283       end.
     1284       if num-entries( v-rid-list ) = 0
     1285       then
     1286           hide mark-num in frame Dialog-Frame.
     1287       else
     1288           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1289     end.
     1290     apply "entry" to br-cstaff in frame Dialog-Frame.
     1291   END.
     1292   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1293   DO:
     1294       if ( available X_c-staff ) then do:
     1295       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1296       then
     1297       v-rid-list = string( recid( X_c-staff ) ) .
     1298     end.
     1299   END.
     1300   ON RETURN OF br-cstaff IN FRAME Dialog-Frame
     1301   or MOUSE-SELECT-DBLCLICK OF br-cstaff IN FRAME Dialog-Frame
     1302       DO:
     1303       run proc-br-cstaff no-error.
     1304     if error-status:error then return no-apply.
     1305   END.
     1306   ON VALUE-CHANGED OF br-cstaff IN FRAME Dialog-Frame
     1307   DO:
     1308     run proc-view-changes in this-procedure no-error.
     1309   END.
     1310   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1311   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1312   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1313   on help of frame Dialog-Frame
     1314   do:
     1315     run gbl/app_help.p
     1316       (input this-procedure :file-name
     1317       ,input ''
     1318       ,input ?
     1319       ) no-error.
     1320     if error-status :error then do:
     1321       message
     1322         "Ошибка при вызове помощи"
     1323         error-status :get-message(1)
     1324         view-as alert-box .
     1325     end.
     1326   end.
     1327   run minbtn-set in this-procedure .
     1328   on choose of b-help in frame Dialog-Frame
     1329   do:
     1330     apply "help":u to frame Dialog-Frame .
     1331   end.
     1332   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1333   procedure minbtn-set :
     1334       do
     1335           on error undo, return error return-value
     1336           :
     1337           define variable ii              as integer       no-undo .
     1338           define variable fh              as widget-handle no-undo .
     1339           define variable hh              as widget-handle no-undo .
     1340           define variable v-h             as handle        extent 4 no-undo .
     1341           define variable v-name-button   as character     no-undo .
     1342           define variable v-help-old-x    as decimal       no-undo .
     1343           define variable v-help-old-y    as decimal       no-undo .
     1344           define variable v-help-old-size as decimal       no-undo .
     1345           define variable v-frame-width   as decimal       no-undo .
     1346           define variable jj              as integer       no-undo .
     1347           do
     1348               on error undo, return error
     1349               :
     1350               assign
     1351                   v-frame-width = frame Dialog-Frame:width - 0.3
     1352                   fh            = frame Dialog-Frame:first-child
     1353                   hh            = fh:first-child
     1354                   ii            = 1
     1355                   .
     1356               do while valid-handle(hh):
     1357                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1358                   do:
     1359                       case lc(hh:name) :
     1360                           when "b-help" then
     1361                               do:
     1362                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1363                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1364                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1365                                   hh:TOOLTIP = "Помощь" .
     1366                                   v-help-old-x = hh:column .
     1367                                   v-help-old-y = hh:row    .
     1368                                   v-help-old-size = hh:width .
     1369                                   hh:width-chars = 2.5 .
     1370                               end.
     1371                           when "b-print" then
     1372                               do:
     1373                                   hh:load-image("cmp/b-print.bmp":u) .
     1374                                   hh:TOOLTIP = "Печать" .
     1375                                   v-h[ii] = hh:handle .
     1376                                   ii = ii + 1 .
     1377                                   hh:width-chars = 3 .
     1378                               end.
     1379                           when "b-history" or
     1380                           when "b-hist" then
     1381                               do:
     1382                                   hh:load-image("cmp/b-hist.bmp":u) .
     1383                                   hh:TOOLTIP = "История" .
     1384                                   v-h[ii] = hh:handle .
     1385                                   ii = ii + 1 .
     1386                                   hh:width-chars = 3 .
     1387                               end.
     1388                           when "b-sch" then
     1389                               do:
     1390                                   hh:load-image("cmp/b-sch.bmp":u) .
     1391                                   hh:TOOLTIP = "Установка Фильтра" .
     1392                                   v-h[ii] = hh:handle .
     1393                                   ii = ii + 1 .
     1394                                   hh:width-chars = 3 .
     1395                               end.
     1396                           when "b-hist-user" then
     1397                               do:
     1398                                   hh:load-image("cmp/b-hist.bmp":u) .
     1399                                   hh:TOOLTIP = "История пользователя" .
     1400                                   ii = ii + 1 .
     1401                               end.
     1402                       end case.
     1403                   end.
     1404                   hh = hh:next-sibling.
     1405               end.
     1406               b-help:column = v-frame-width - b-help:width-chars.
     1407               jj = 0.
     1408               repeat ii = 4 to 1 by -1 :
     1409                   if valid-handle (v-h[ii] ) then
     1410                   do:
     1411                       jj  = jj + 1 .
     1412                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1413                       v-h[ii]:row    = v-help-old-y .
     1414                   end.
     1415               end.
     1416           end.
     1417       end.
     1418   end procedure.
     1419   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1420   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1421   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1422   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1423   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1424   define variable v-diasize-current-frame-height as decimal   no-undo .
     1425   define variable v-diasize-change-size          as logical   no-undo .
     1426   define variable v-diasize-resize-button        as handle    no-undo .
     1427   define variable v-diasize-wndmax               as logical   no-undo .
     1428   define variable v-diasize-wndstore             as logical   no-undo .
     1429   define variable v-diasize-proc-name            as character no-undo .
     1430   define variable v-diasize-browse-handle        as handle    no-undo .
     1431   define variable v-diasize-browse-number        as integer   no-undo .
     1432   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1433   define temp-table temp-diasize-handle no-undo
     1434     field handle-value  as handle
     1435     field save-position as decimal
     1436     index xpk is primary unique handle-value
     1437     .
     1438   define temp-table temp-browse-handle no-undo
     1439     field browse-type   as character
     1440     field browse-number as integer
     1441     field browse-handle as handle
     1442     field original-size as decimal
     1443     index xpk is primary unique browse-type browse-number
     1444     index xie browse-type browse-handle
     1445   .
     1446   procedure diasize_change-height :
     1447     define input  parameter p-change-value  as decimal   no-undo .
     1448     define input  parameter p-move-resize   as logical   no-undo .
     1449     define variable v-field-group-handle    as handle    no-undo .
     1450     define variable v-object-handle         as handle    no-undo .
     1451     define variable v-frame-height          as decimal   no-undo .
     1452     define variable v-frame-virtual-height  as decimal   no-undo .
     1453     define variable v-browse-height         as decimal   no-undo .
     1454     define variable v-window-height         as decimal   no-undo .
     1455     define variable v-window-virtual-height as decimal   no-undo .
     1456     define variable v-change-sign           as integer   no-undo .
     1457     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1458     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1459     if p-change-value > 0
     1460     then do:
     1461       if frame Dialog-Frame :height + p-change-value
     1462           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1463       then do:
     1464         assign
     1465           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1466                           - (frame Dialog-Frame :height-chars)
     1467         .
     1468         if p-change-value <= 0
     1469         then do:
     1470           run diasize_position-resize-button in this-procedure .
     1471           return .
     1472         end.
     1473       end.
     1474     end.
     1475     if p-change-value < 0
     1476     then do:
     1477       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1478       then do:
     1479         assign
     1480           p-change-value = v-diasize-orig-frame-height
     1481                          - (frame Dialog-Frame :height-chars)
     1482         .
     1483         if p-change-value >= 0
     1484         then do:
     1485           run diasize_position-resize-button in this-procedure .
     1486           return .
     1487         end.
     1488       end.
     1489     end.
     1490     if p-change-value >= 0
     1491     then do:
     1492       assign
     1493         v-change-sign = 1
     1494       .
     1495     end.
     1496     else do:
     1497       assign
     1498         v-change-sign = -1
     1499       .
     1500     end.
     1501     assign
     1502       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1503     .
     1504     if p-change-value = 0
     1505     then do:
     1506       run diasize_position-resize-button in this-procedure .
     1507       return .
     1508     end.
     1509     move_block:
     1510     do
     1511     on error undo move_block, retry move_block
     1512     :
     1513       if retry
     1514       then do:
     1515         do
     1516         on error undo move_block, leave move_block
     1517         :
     1518           if p-change-value > 0
     1519           then do:
     1520             for each buf_temp-diasize-handle
     1521             on error undo, next
     1522             :
     1523               assign
     1524                 v-object-handle = buf_temp-diasize-handle.handle-value
     1525               .
     1526               if v-object-handle <> v-diasize-resize-button
     1527               then do:
     1528                 assign
     1529                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1530                 .
     1531               end.
     1532             end.
     1533             assign
     1534               v-diasize-browse-handle :height = v-browse-height
     1535             .
     1536             for each buf_temp-browse-handle
     1537               where buf_temp-browse-handle.browse-type = 'height':u
     1538             on error undo, next
     1539             :
     1540               assign
     1541                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1542               .
     1543             end.
     1544             assign
     1545               frame Dialog-Frame :height = v-frame-height
     1546             .
     1547             if frame Dialog-Frame :scrollable = true
     1548             then do:
     1549               assign
     1550                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1551               .
     1552             end.
     1553             run diasize_position-resize-button in this-procedure .
     1554           end.
     1555           else do:
     1556             if frame Dialog-Frame :scrollable = true
     1557             then do:
     1558               assign
     1559                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1560               .
     1561             end.
     1562             assign
     1563               frame Dialog-Frame :height = v-frame-height
     1564             .
     1565             assign
     1566               v-diasize-browse-handle :height = v-browse-height
     1567             .
     1568             for each buf_temp-browse-handle
     1569               where buf_temp-browse-handle.browse-type = 'height':u
     1570             on error undo, next
     1571             :
     1572               assign
     1573                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1574               .
     1575             end.
     1576             for each buf_temp-diasize-handle
     1577             on error undo, next
     1578             :
     1579               assign
     1580                 v-object-handle = buf_temp-diasize-handle.handle-value
     1581               .
     1582               if v-object-handle <> v-diasize-resize-button
     1583               then do:
     1584                 assign
     1585                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1586                 .
     1587               end.
     1588             end.
     1589             run diasize_position-resize-button in this-procedure .
     1590           end.
     1591           assign
     1592             v-diasize-change-size = false
     1593           .
     1594           leave move_block .
     1595         end.
     1596       end.
     1597       assign
     1598         v-diasize-need-full-display = true
     1599       .
     1600       if v-diasize-change-size = false
     1601       then do:
     1602         assign
     1603           v-diasize-change-size = true
     1604         .
     1605       end.
     1606       else do:
     1607         return .
     1608       end.
     1609       assign
     1610         v-frame-height = frame Dialog-Frame :height
     1611         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1612         v-browse-height = v-diasize-browse-handle :height
     1613       .
     1614       for each buf_temp-browse-handle
     1615         where buf_temp-browse-handle.browse-type = 'height':u
     1616       :
     1617         assign
     1618           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1619         .
     1620       end.
     1621       for each buf_temp-diasize-handle
     1622       :
     1623         delete buf_temp-diasize-handle .
     1624       end.
     1625       assign
     1626         v-field-group-handle = frame Dialog-Frame :first-child
     1627       .
     1628       do while valid-handle(v-field-group-handle)
     1629       :
     1630         assign
     1631           v-object-handle = v-field-group-handle :first-child
     1632         .
     1633         do while valid-handle(v-object-handle)
     1634         :
     1635           if  v-object-handle <> v-diasize-browse-handle :handle
     1636           and can-query(v-object-handle, "row")
     1637           and can-query(v-object-handle, "height")
     1638           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1639           then do:
     1640             find first buf_temp-browse-handle
     1641               where buf_temp-browse-handle.browse-type   = 'height':u
     1642                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1643               no-error .
     1644             if available buf_temp-browse-handle
     1645             then do:
     1646             end.
     1647             else do:
     1648               create buf_temp-diasize-handle .
     1649               assign
     1650                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1651                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1652               .
     1653             end.
     1654           end.
     1655           assign
     1656             v-object-handle = v-object-handle :next-sibling
     1657           .
     1658         end.
     1659         assign
     1660           v-field-group-handle = v-field-group-handle :next-sibling
     1661         .
     1662       end.
     1663       do with frame Dialog-Frame
     1664       :
     1665         hide v-diasize-resize-button .
     1666         assign
     1667           v-diasize-resize-button :row    = 1
     1668           v-diasize-resize-button :column = 1
     1669         .
     1670       end.
     1671       if p-change-value > 0
     1672       then do:
     1673         if frame Dialog-Frame :scrollable = true
     1674         then do:
     1675           assign
     1676             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1677             no-error .
     1678           if error-status :error
     1679           or error-status :get-message(1) <> ""
     1680           then do:
     1681             undo move_block, retry move_block .
     1682           end.
     1683         end.
     1684         assign
     1685           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1686           no-error .
     1687         if error-status :error
     1688         or error-status :get-message(1) <> ""
     1689         then do:
     1690           undo move_block, retry move_block .
     1691         end.
     1692         assign
     1693           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1694           no-error .
     1695         if error-status :error
     1696         or error-status :get-message(1) <> ""
     1697         then do:
     1698           undo move_block, retry move_block .
     1699         end.
     1700         for each buf_temp-browse-handle
     1701           where buf_temp-browse-handle.browse-type = 'height':u
     1702         on error undo move_block, retry move_block
     1703         :
     1704           assign
     1705             buf_temp-browse-handle.browse-handle :height
     1706               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1707             no-error .
     1708           if error-status :error
     1709           or error-status :get-message(1) <> ""
     1710           then do:
     1711             undo move_block, retry move_block .
     1712           end.
     1713         end.
     1714         for each buf_temp-diasize-handle
     1715         on error undo move_block, retry move_block
     1716         :
     1717           assign
     1718             v-object-handle = buf_temp-diasize-handle.handle-value
     1719           .
     1720           if v-object-handle <> v-diasize-resize-button
     1721           then do:
     1722             assign
     1723               v-object-handle :row = v-object-handle :row + p-change-value
     1724               no-error .
     1725             if error-status :error
     1726             or error-status :get-message(1) <> ""
     1727             then do:
     1728               undo move_block, retry move_block .
     1729             end.
     1730           end.
     1731         end.
     1732       end.
     1733       else do:
     1734         for each buf_temp-diasize-handle
     1735         on error undo move_block, retry move_block
     1736         :
     1737           assign
     1738             v-object-handle = buf_temp-diasize-handle.handle-value
     1739           .
     1740           if v-object-handle <> v-diasize-resize-button
     1741           then do:
     1742             assign
     1743               v-object-handle :row = v-object-handle :row + p-change-value
     1744               no-error .
     1745             if error-status :error
     1746             or error-status :get-message(1) <> ""
     1747             then do:
     1748               undo move_block, retry move_block .
     1749             end.
     1750           end.
     1751         end.
     1752         assign
     1753           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1754           no-error .
     1755         if error-status :error
     1756         or error-status :get-message(1) <> ""
     1757         then do:
     1758           undo move_block, retry move_block .
     1759         end.
     1760         for each buf_temp-browse-handle
     1761           where buf_temp-browse-handle.browse-type = 'height':u
     1762         on error undo move_block, retry move_block
     1763         :
     1764           assign
     1765             buf_temp-browse-handle.browse-handle :height
     1766               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1767             no-error .
     1768           if error-status :error
     1769           or error-status :get-message(1) <> ""
     1770           then do:
     1771             undo move_block, retry move_block .
     1772           end.
     1773         end.
     1774         assign
     1775           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1776           no-error .
     1777         if error-status :error
     1778         or error-status :get-message(1) <> ""
     1779         then do:
     1780           undo move_block, retry move_block .
     1781         end.
     1782         if frame Dialog-Frame :scrollable = true
     1783         then do:
     1784           assign
     1785             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1786             no-error .
     1787           if error-status :error
     1788           or error-status :get-message(1) <> ""
     1789           then do:
     1790             undo move_block, retry move_block .
     1791           end.
     1792         end.
     1793       end.
     1794       if p-move-resize = true
     1795       then do:
     1796         run diasize_position-resize-button in this-procedure .
     1797       end.
     1798       if v-diasize-wndstore = true
     1799       then do:
     1800         if connected("ub") = true
     1801         then do:
     1802           define variable v-cntxt-db-num        as integer   no-undo .
     1803           define variable v-cntxt-userid        as character no-undo .
     1804           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1805                                             , OUTPUT v-cntxt-userid
     1806                                             ) .
     1807           run gbl/wndsizew.p
     1808             (input  v-cntxt-db-num
     1809             ,input  v-cntxt-userid
     1810             ,input  v-diasize-proc-name
     1811             ,input  'height':u
     1812             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1813             ) .
     1814         end.
     1815       end.
     1816     end.
     1817     assign
     1818       v-diasize-change-size = false
     1819     .
     1820   end procedure.
     1821   procedure diasize_set-height :
     1822     define input  parameter p-new-height  as decimal   no-undo .
     1823     define input  parameter p-move-resize as logical   no-undo .
     1824     do
     1825     on error undo, return error return-value
     1826     :
     1827       run diasize_change-height in this-procedure
     1828         (input  (p-new-height - frame Dialog-Frame :height)
     1829         ,input  p-move-resize
     1830         ) .
     1831     end.
     1832   end procedure.
     1833   procedure diasize_change-width :
     1834     define input  parameter p-change-value as decimal   no-undo .
     1835     define input  parameter p-move-resize  as logical   no-undo .
     1836     define variable v-field-group-handle   as handle    no-undo .
     1837     define variable v-object-handle        as handle    no-undo .
     1838     define variable v-frame-width          as decimal   no-undo .
     1839     define variable v-frame-virtual-width  as decimal   no-undo .
     1840     define variable v-browse-width         as decimal   no-undo .
     1841     define variable v-window-width         as decimal   no-undo .
     1842     define variable v-window-virtual-width as decimal   no-undo .
     1843     define variable v-change-sign          as integer   no-undo .
     1844     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1845     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1846     if p-change-value > 0
     1847     then do:
     1848       if frame Dialog-Frame :width + p-change-value >
     1849           session :width-chars
     1850       then do:
     1851         assign
     1852           p-change-value = session :width-chars - frame Dialog-Frame :width
     1853         .
     1854         if p-change-value <= 0
     1855         then do:
     1856           run diasize_position-resize-button in this-procedure .
     1857           return .
     1858         end.
     1859       end.
     1860     end.
     1861     if p-change-value < 0
     1862     then do:
     1863       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1864       then do:
     1865         assign
     1866           p-change-value = v-diasize-orig-frame-width
     1867                          - frame Dialog-Frame :width
     1868         .
     1869         if p-change-value >= 0
     1870         then do:
     1871           run diasize_position-resize-button in this-procedure .
     1872           return .
     1873         end.
     1874       end.
     1875     end.
     1876     if p-change-value >= 0
     1877     then do:
     1878       assign
     1879         v-change-sign = 1
     1880       .
     1881     end.
     1882     else do:
     1883       assign
     1884         v-change-sign = -1
     1885       .
     1886     end.
     1887     assign
     1888       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1889     .
     1890     if p-change-value = 0
     1891     then do:
     1892       run diasize_position-resize-button in this-procedure .
     1893       return .
     1894     end.
     1895     move_block:
     1896     do
     1897     on error undo move_block, leave move_block
     1898     :
     1899       if retry
     1900       then do:
     1901         do
     1902         on error undo move_block, leave move_block
     1903         :
     1904           if p-change-value > 0
     1905           then do:
     1906             for each buf_temp-diasize-handle
     1907             on error undo, next
     1908             :
     1909               assign
     1910                 v-object-handle = buf_temp-diasize-handle.handle-value
     1911               .
     1912               if v-object-handle <> v-diasize-resize-button
     1913               then do:
     1914                 assign
     1915                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1916                 .
     1917               end.
     1918             end.
     1919             assign
     1920               v-diasize-browse-handle :width = v-browse-width
     1921             .
     1922             for each buf_temp-browse-handle
     1923               where buf_temp-browse-handle.browse-type = 'width':u
     1924             on error undo, next
     1925             :
     1926               assign
     1927                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1928               .
     1929             end.
     1930             assign
     1931               frame Dialog-Frame :width = v-frame-width
     1932             .
     1933             if frame Dialog-Frame :scrollable = true
     1934             then do:
     1935               assign
     1936                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1937               .
     1938             end.
     1939             run diasize_position-resize-button in this-procedure .
     1940           end.
     1941           else do:
     1942             if frame Dialog-Frame :scrollable = true
     1943             then do:
     1944               assign
     1945                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1946               .
     1947             end.
     1948             assign
     1949               frame Dialog-Frame :width = v-frame-width
     1950             .
     1951             for each buf_temp-browse-handle
     1952               where buf_temp-browse-handle.browse-type = 'width':u
     1953             on error undo, next
     1954             :
     1955               assign
     1956                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1957               .
     1958             end.
     1959             assign
     1960               v-diasize-browse-handle :width = v-browse-width
     1961             .
     1962             for each buf_temp-diasize-handle
     1963             on error undo, next
     1964             :
     1965               assign
     1966                 v-object-handle = buf_temp-diasize-handle.handle-value
     1967               .
     1968               if v-object-handle <> v-diasize-resize-button
     1969               then do:
     1970                 assign
     1971                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1972                 .
     1973               end.
     1974             end.
     1975             run diasize_position-resize-button in this-procedure .
     1976           end.
     1977           assign
     1978             v-diasize-change-size = false
     1979           .
     1980           leave move_block .
     1981         end.
     1982       end.
     1983       assign
     1984         v-diasize-need-full-display = true
     1985       .
     1986       if v-diasize-change-size = false
     1987       then do:
     1988         assign
     1989           v-diasize-change-size = true
     1990         .
     1991       end.
     1992       else do:
     1993         return .
     1994       end.
     1995       assign
     1996         v-frame-width = frame Dialog-Frame :width
     1997         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1998         v-browse-width = v-diasize-browse-handle :width
     1999       .
     2000       for each buf_temp-browse-handle
     2001         where buf_temp-browse-handle.browse-type = 'width':u
     2002       :
     2003         assign
     2004           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2005         .
     2006       end.
     2007       for each buf_temp-diasize-handle
     2008       :
     2009         delete buf_temp-diasize-handle .
     2010       end.
     2011       assign
     2012         v-field-group-handle = frame Dialog-Frame :first-child
     2013       .
     2014       do while valid-handle(v-field-group-handle)
     2015       :
     2016         assign
     2017           v-object-handle = v-field-group-handle :first-child
     2018         .
     2019         do while valid-handle(v-object-handle)
     2020         :
     2021           if  v-object-handle <> v-diasize-browse-handle :handle
     2022           and v-object-handle <> v-diasize-resize-button
     2023           and can-query(v-object-handle, "row")
     2024           and can-query(v-object-handle, "height")
     2025           and ( v-object-handle :col + v-object-handle :width
     2026                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2027               )
     2028           then do:
     2029             find first buf_temp-browse-handle
     2030               where buf_temp-browse-handle.browse-type   = 'width':u
     2031                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2032               no-error .
     2033             if available buf_temp-browse-handle
     2034             then do:
     2035             end.
     2036             else do:
     2037               create buf_temp-diasize-handle .
     2038               assign
     2039                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2040                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2041               .
     2042             end.
     2043           end.
     2044           assign
     2045             v-object-handle = v-object-handle :next-sibling
     2046           .
     2047         end.
     2048         assign
     2049           v-field-group-handle = v-field-group-handle :next-sibling
     2050         .
     2051       end.
     2052       do with frame Dialog-Frame
     2053       :
     2054         hide v-diasize-resize-button .
     2055         v-diasize-resize-button :row = 1.
     2056         v-diasize-resize-button :column = 1.
     2057       end.
     2058       if p-change-value > 0
     2059       then do:
     2060         if frame Dialog-Frame :scrollable = true
     2061         then do:
     2062           assign
     2063             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2064             no-error .
     2065           if error-status :error
     2066           or error-status :get-message(1) <> ""
     2067           then do:
     2068             undo move_block, retry move_block.
     2069           end.
     2070         end.
     2071         assign
     2072           frame Dialog-Frame :width = v-frame-width + p-change-value
     2073           no-error .
     2074         if error-status :error
     2075         or error-status :get-message(1) <> ""
     2076         then do:
     2077           undo move_block, retry move_block.
     2078         end.
     2079         assign
     2080           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2081         no-error .
     2082         if error-status :error
     2083         or error-status :get-message(1) <> ""
     2084         then do:
     2085           undo move_block, retry move_block.
     2086         end.
     2087         for each buf_temp-browse-handle
     2088           where buf_temp-browse-handle.browse-type = 'width':u
     2089         on error undo move_block, retry move_block
     2090         :
     2091           assign
     2092             buf_temp-browse-handle.browse-handle :width
     2093               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2094             no-error .
     2095           if error-status :error
     2096           or error-status :get-message(1) <> ""
     2097           then do:
     2098             undo move_block, retry move_block .
     2099           end.
     2100         end.
     2101         for each buf_temp-diasize-handle
     2102         on error undo move_block, retry move_block
     2103         :
     2104           assign
     2105             v-object-handle = buf_temp-diasize-handle.handle-value
     2106           .
     2107           if v-object-handle <> v-diasize-resize-button
     2108           then do:
     2109             assign
     2110               v-object-handle :col = v-object-handle :col + p-change-value
     2111               no-error .
     2112             if error-status :error
     2113             or error-status :get-message(1) <> ""
     2114             then do:
     2115               undo move_block, retry move_block .
     2116             end.
     2117           end.
     2118         end.
     2119       end.
     2120       else do:
     2121         for each buf_temp-diasize-handle
     2122         on error undo move_block, retry move_block
     2123         :
     2124           assign
     2125             v-object-handle = buf_temp-diasize-handle.handle-value
     2126           .
     2127           if v-object-handle <> v-diasize-resize-button
     2128           then do:
     2129             assign
     2130               v-object-handle :col = v-object-handle :col + p-change-value
     2131               no-error .
     2132             if error-status :error
     2133             or error-status :get-message(1) <> ""
     2134             then do:
     2135               undo move_block, retry move_block .
     2136             end.
     2137           end.
     2138         end.
     2139         for each buf_temp-browse-handle
     2140           where buf_temp-browse-handle.browse-type = 'width':u
     2141         on error undo move_block, retry move_block
     2142         :
     2143           assign
     2144             buf_temp-browse-handle.browse-handle :width
     2145               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2146             no-error .
     2147           if error-status :error
     2148           or error-status :get-message(1) <> ""
     2149           then do:
     2150             undo move_block, retry move_block .
     2151           end.
     2152         end.
     2153         assign
     2154           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2155           no-error .
     2156         if error-status :error
     2157         or error-status :get-message(1) <> ""
     2158         then do:
     2159           undo move_block, retry move_block.
     2160         end.
     2161         assign
     2162           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2163         no-error .
     2164         if error-status :error
     2165         or error-status :get-message(1) <> ""
     2166         then do:
     2167           undo move_block, retry move_block.
     2168         end.
     2169         if frame Dialog-Frame :scrollable = true
     2170         then do:
     2171           assign
     2172             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2173           no-error .
     2174           if error-status :error
     2175           or error-status :get-message(1) <> ""
     2176           then do:
     2177             undo move_block, retry move_block.
     2178           end.
     2179         end.
     2180       end.
     2181       if p-move-resize
     2182       then do:
     2183         run diasize_position-resize-button in this-procedure .
     2184       end.
     2185       if v-diasize-wndstore = true
     2186       then do:
     2187         if connected("ub") = true
     2188         then do:
     2189           define variable v-cntxt-db-num        as integer   no-undo .
     2190           define variable v-cntxt-userid        as character no-undo .
     2191           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2192                                             , OUTPUT v-cntxt-userid
     2193                                             ) .
     2194           run gbl/wndsizew.p
     2195             (input  v-cntxt-db-num
     2196             ,input  v-cntxt-userid
     2197             ,input  v-diasize-proc-name
     2198             ,input  'width':u
     2199             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2200             ) .
     2201         end.
     2202       end.
     2203     end.
     2204     assign
     2205       v-diasize-change-size = false
     2206     .
     2207   end procedure.
     2208   procedure diasize_set-width :
     2209     define input  parameter p-new-width  as decimal   no-undo .
     2210     define input  parameter p-move-resize as logical   no-undo .
     2211     do
     2212     on error undo, return error return-value
     2213     :
     2214       run diasize_change-width in this-procedure
     2215         (input  (p-new-width - frame Dialog-Frame :width)
     2216         ,input  p-move-resize
     2217         ) .
     2218     end.
     2219   end procedure.
     2220   procedure diasize_position-resize-button :
     2221     do with frame Dialog-Frame
     2222     :
     2223       hide v-diasize-resize-button .
     2224       assign
     2225         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2226                     - 1
     2227                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2228         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2229                     - 1
     2230                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2231       .
     2232       view v-diasize-resize-button .
     2233     end.
     2234   end procedure.
     2235   on alt-right anywhere
     2236   do:
     2237     run diasize_change-width in this-procedure
     2238       (input 1
     2239       ,input true
     2240       ) .
     2241     return no-apply .
     2242   end.
     2243   on alt-left anywhere
     2244   do:
     2245     run diasize_change-width in this-procedure
     2246       (input -1
     2247       ,input true
     2248       ) .
     2249     return no-apply .
     2250   end.
     2251   on alt-down anywhere
     2252   do:
     2253     run diasize_change-height in this-procedure
     2254       (input 1
     2255       ,input true
     2256       ) .
     2257     return no-apply .
     2258   end.
     2259   on alt-up anywhere
     2260   do:
     2261     run diasize_change-height in this-procedure
     2262       (input -1
     2263       ,input true
     2264       ) .
     2265     return no-apply .
     2266   end.
     2267   on alt-enter of frame Dialog-Frame
     2268   do:
     2269     run diasize_maximize in this-procedure
     2270       (input  ?
     2271       ).
     2272     return no-apply .
     2273   end.
     2274   procedure diasize_end-move :
     2275     do
     2276     on error undo, return error return-value
     2277     :
     2278       define variable v-row-delta as decimal   no-undo .
     2279       define variable v-col-delta as decimal   no-undo .
     2280       define variable v-new-row as decimal   no-undo .
     2281       define variable v-new-col as decimal   no-undo .
     2282       assign
     2283         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2284         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2285       .
     2286       assign
     2287         v-row-delta = v-new-row - frame Dialog-Frame :height
     2288         v-col-delta = v-new-col - frame Dialog-Frame :width
     2289       .
     2290       run diasize_change-height in this-procedure
     2291         (input v-row-delta
     2292         ,input true
     2293         ) .
     2294       run diasize_change-width in this-procedure
     2295         (input v-col-delta
     2296         ,input true
     2297         ) .
     2298     end.
     2299   end procedure.
     2300   procedure diasize_maximize :
     2301     define input  parameter p-action as logical   no-undo .
     2302     do
     2303     on error undo, return error return-value
     2304     :
     2305       if p-action = ?
     2306       then do:
     2307         if v-diasize-need-maximize = true
     2308         then do:
     2309           assign
     2310             p-action = true
     2311           .
     2312         end.
     2313         else do:
     2314           assign
     2315             p-action = false
     2316           .
     2317         end.
     2318       end.
     2319       if p-action = true
     2320       then do:
     2321         run diasize_change-height in this-procedure
     2322           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2323               - frame Dialog-Frame :height-chars
     2324           ,input true
     2325           ) .
     2326         run diasize_change-width in this-procedure
     2327           (input session :width-chars
     2328               - frame Dialog-Frame :width-chars
     2329           ,input true
     2330           ) .
     2331         assign
     2332           v-diasize-need-maximize = false
     2333         .
     2334       end.
     2335       else do:
     2336         run diasize_change-width in this-procedure
     2337           (input v-diasize-orig-frame-width
     2338               - frame Dialog-Frame :width-chars
     2339           ,input true
     2340           ) .
     2341         run diasize_change-height in this-procedure
     2342           (input v-diasize-orig-frame-height
     2343               - frame Dialog-Frame :height-chars
     2344           ,input true
     2345           ) .
     2346         assign
     2347           v-diasize-need-maximize = true
     2348         .
     2349       end.
     2350     end.
     2351   end procedure.
     2352   procedure diasize_restore-orig-size :
     2353     do
     2354     on error undo, return error return-value
     2355     :
     2356       assign
     2357         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2358         v-diasize-current-frame-height = frame Dialog-Frame :height
     2359       .
     2360       run diasize_set-height in this-procedure
     2361         (input  v-diasize-orig-frame-height
     2362         ,input  true
     2363         ) .
     2364       run diasize_set-width in this-procedure
     2365         (input  v-diasize-orig-frame-width
     2366         ,input  true
     2367         ) .
     2368     end.
     2369   end procedure.
     2370   procedure diasize_restore-current-size :
     2371     do
     2372     on error undo, return error return-value
     2373     :
     2374       run diasize_set-height in this-procedure
     2375         (input  v-diasize-current-frame-height
     2376         ,input  true
     2377         ) .
     2378       run diasize_set-width in this-procedure
     2379         (input  v-diasize-current-frame-width
     2380         ,input  true
     2381         ) .
     2382     end.
     2383   end procedure.
     2384   procedure diasize_set-browse-handle :
     2385     define input  parameter p-browse-handle as handle   no-undo .
     2386     define buffer buf_temp-browse-handle for temp-browse-handle .
     2387     do
