     2418   procedure diasize_init :
     2419     define variable v-default-value    as logical   no-undo .
     2420     define variable v-restore-saved    as logical   no-undo .
     2421     define variable v-resize-value-str as character no-undo .
     2422     do
     2423     on error undo, return error return-value
     2424     :
     2425       do with frame Dialog-Frame
     2426       :
     2427         assign
     2428           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2429           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2430           v-diasize-browse-handle     = browse br-cstaff :handle
     2431         .
     2432         create button v-diasize-resize-button
     2433         assign
     2434           parent        = frame Dialog-Frame :first-child
     2435           label         = "s"
     2436           height-pixels = 16
     2437           width-pixels  = 16
     2438           visible       = true
     2439           sensitive     = true
     2440           movable       = true
     2441           triggers:
     2442             on end-move persistent run diasize_end-move in this-procedure .
     2443           end triggers.
     2444         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2445         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2446         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2447         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2448         assign
     2449           v-diasize-wndmax = false
     2450         .
     2451         if connected("ub") = true
     2452         then do:
     2453           define variable v-cntxt-db-num        as integer   no-undo .
     2454           define variable v-cntxt-userid        as character no-undo .
     2455           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2456                                             , OUTPUT v-cntxt-userid
     2457                                             ) .
     2458           run gbl/wndpar_r.p
     2459             (input  v-cntxt-db-num
     2460             ,input  v-cntxt-userid
     2461             ,input  'wndmax':U
     2462             ,output v-diasize-wndmax
     2463             ,output v-default-value
     2464             ) .
     2465         end.
     2466         assign
     2467           v-diasize-wndstore = false
     2468         .
     2469         if connected("ub") = true
     2470         then do:
     2471           run gbl/wndpar_r.p
     2472             (input  v-cntxt-db-num
     2473             ,input  v-cntxt-userid
     2474             ,input  'wndstore':U
     2475             ,output v-diasize-wndstore
     2476             ,output v-default-value
     2477             ) .
     2478         end.
     2479         assign
     2480           v-diasize-proc-name = entry(1, program-name(2), '.')
     2481         .
     2482         if v-diasize-wndstore = true
     2483         then do:
     2484           assign
     2485             v-restore-saved = false
     2486           .
     2487           if connected("ub") = true
     2488           then do:
     2489             run gbl/wndsizer.p
     2490               (input  v-cntxt-db-num
     2491               ,input  v-cntxt-userid
     2492               ,input  v-diasize-proc-name
     2493               ,input  'height':u
     2494               ,output v-resize-value-str
     2495               ) .
     2496             if v-resize-value-str <> '':U
     2497             then do:
     2498               run diasize_change-height in this-procedure
     2499                 (input  integer(v-resize-value-str)
     2500                 ,input  true
     2501                 ) .
     2502               assign
     2503                 v-restore-saved = true
     2504               .
     2505             end.
     2506           end.
     2507           if connected("ub") = true
     2508           then do:
     2509             run gbl/wndsizer.p
     2510               (input  v-cntxt-db-num
     2511               ,input  v-cntxt-userid
     2512               ,input  v-diasize-proc-name
     2513               ,input  'width':u
     2514               ,output v-resize-value-str
     2515               ) .
     2516             if v-resize-value-str <> '':U
     2517             then do:
     2518               run diasize_change-width in this-procedure
     2519                 (input  integer(v-resize-value-str)
     2520                 ,input  true
     2521                 ) .
     2522               assign
     2523                 v-restore-saved = true
     2524               .
     2525             end.
     2526           end.
     2527           if v-restore-saved <> true
     2528           then do:
     2529             if v-diasize-wndmax = true
     2530             then do:
     2531               run diasize_maximize in this-procedure
     2532                 (input  true
     2533                 ) .
     2534             end.
     2535           end.
     2536         end.
     2537         else do:
     2538           if v-diasize-wndmax = true
     2539           then do:
     2540             run diasize_maximize in this-procedure
     2541               (input  true
     2542               ) .
     2543           end.
     2544         end.
     2545       end.
     2546     end.
     2547   end procedure.
     2548   procedure diasize_need-full-display :
     2549     define output parameter p-need-full-display as logical   no-undo .
     2550     do
     2551     on error undo, return error return-value
     2552     :
     2553       assign
     2554         p-need-full-display = v-diasize-need-full-display
     2555       .
     2556       assign
     2557         v-diasize-need-full-display = false
     2558       .
     2559     end.
     2560   end procedure.
     2561   procedure get-context :
     2562      define output parameter p-db-num as integer          no-undo.
     2563      define output parameter p-user-id as character        no-undo.
     2564      define variable v-login               as character    no-undo.
     2565      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2566      define buffer buf_user-login  for ub.user-login .
     2567      do
     2568      on error undo, return error
     2569      :
     2570            FIND FIRST buf_sys-ctrl no-lock.
     2571            ASSIGN
     2572               v-login = USERID("ub")
     2573               p-db-num = buf_sys-ctrl.db-num
     2574            .
     2575            FIND FIRST buf_user-login
     2576                 WHERE buf_user-login.db-num = p-db-num
     2577                   AND buf_user-login.user-login = v-login
     2578                 no-lock
     2579                 no-error
     2580                 .
     2581            IF AVAILABLE buf_user-login
     2582            THEN DO:
     2583               assign
     2584                  p-user-id = buf_user-login.user-id
     2585               .
     2586            END.
     2587      end.
     2588   end procedure.
     2589   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2590   on f5 of frame Dialog-Frame anywhere
     2591   do:
     2592     v-doc-rec = recid(X_c-staff). run OpenBr in this-procedure. reposition br-cstaff to recid v-doc-rec no-error. v-doc-rec = ?.              apply 'value-changed' to br-cstaff.
     2593       apply "VALUE-CHANGED" to BR-changes.
     2594   end.
     2595   def var sort-labelbr-cstaff   as character no-undo .
     2596   def var sort-clmnbr-cstaff    as handle    no-undo .
     2597   def var cur-clmnbr-cstaff     as handle    no-undo .
     2598   def var cur-clmn-locbr-cstaff as integer   no-undo .
     2599   def var re-querybr-cstaff     as logical   initial no no-undo .
     2600   on start-search, ctrl-o of br-cstaff in frame Dialog-Frame do:
     2601      run sort-brbr-cstaff
     2602        (input (if available temp-changes
     2603                then recid(temp-changes)
     2604                else ?
     2605               )
     2606        ).
     2607   end.
     2608   PROCEDURE sort-brbr-cstaff :
     2609     define input parameter p-recid as recid no-undo .
     2610     if re-querybr-cstaff = no then do:
     2611       assign
     2612          cur-clmnbr-cstaff = br-cstaff:current-column in frame Dialog-Frame
     2613       .
     2614       if sort-clmnbr-cstaff <> ? then sort-clmnbr-cstaff:column-fgcolor = 0.
     2615       if cur-clmnbr-cstaff = sort-clmnbr-cstaff then do:
     2616         assign
     2617            sort-labelbr-cstaff = ""
     2618            sort-clmnbr-cstaff = ?
     2619         .
     2620        end.
     2621        else do:
     2622          assign
     2623            sort-labelbr-cstaff = cur-clmnbr-cstaff:label
     2624            sort-clmnbr-cstaff  = cur-clmnbr-cstaff
     2625            sort-clmnbr-cstaff:column-fgcolor = 4
     2626          .
     2627        end.
     2628      end.
     2629     assign
     2630       cur-clmn-locbr-cstaff = 1
     2631     .
     2632     def var column-handle as handle no-undo .
     2633     column-handle = br-cstaff:first-column.
     2634     do while valid-handle(column-handle) :
     2635       if column-handle = cur-clmnbr-cstaff then do:
     2636         leave .
     2637       end.
     2638       column-handle = column-handle:NEXT-COLUMN.
     2639       assign
     2640         cur-clmn-locbr-cstaff = cur-clmn-locbr-cstaff + 1
     2641       .
     2642     end.
     2643     case sort-labelbr-cstaff:
     2644           when X_c-staff.corr-date:label in browse br-cstaff then DO:   assign     sort-column-name = "X_c-staff.corr-date"   .   run OpenBr.   . END.
     2645       otherwise do:
     2646         assign
     2647           sort-column-name = ""
     2648         .
     2649         run OpenBr.
     2650           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-cstaff') then do:
     2651             run mv-brw-defaultbr-cstaff.
     2652           end.
     2653         if sort-labelbr-cstaff <> "" then do:
     2654           assign
     2655             cur-clmnbr-cstaff:column-fgcolor = 0
     2656           .
     2657         end.
     2658         assign
     2659           cur-clmn-locbr-cstaff = ?
     2660         .
     2661       end.
     2662     end case.
     2663       if cur-clmn-locbr-cstaff <> ? then do:
     2664         if can-do( this-procedure:internal-entries, 'ch-clmnbr-cstaff') then do:
     2665           run ch-clmnbr-cstaff in this-procedure (cur-clmn-locbr-cstaff).
     2666         end.
     2667       end.
     2668     if p-recid <> ? then do:
     2669       reposition br-cstaff to recid p-recid no-error.
     2670       apply "value-changed" to br-cstaff in frame Dialog-Frame.
     2671     end.
     2672     apply "entry" to br-cstaff in frame Dialog-Frame.
     2673   END PROCEDURE.
     2674   procedure re-open-query-srt-clmnbr-cstaff:
     2675   if cur-clmnbr-cstaff = ? then do:
     2676      run OpenBr.
     2677   end.
     2678   else do:
     2679      assign re-querybr-cstaff = yes.
     2680      run sort-brbr-cstaff
     2681        (input (if available temp-changes
     2682                then recid(temp-changes)
     2683                else ?
     2684               )
     2685        ).
     2686      assign re-querybr-cstaff = no.
     2687   end.
     2688   end.
     2689   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2690   do:
     2691     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2692   end.
     2693   MAIN-BLOCK:
     2694   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2695      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2696     find first X_curr_clients no-lock where
     2697               X_curr_clients.obj-type = p-curr-obj-type
     2698          AND X_curr_clients.obj-code = p-curr-obj-code no-error.
     2699    if LOOKUP(p-mode, 'one':U,
     2700                   chr(4)) = 0
     2701        then dO:
     2702       message
     2703       vss-workfile vss-revision vss-description skip
     2704       "Неверное значение параметров вызова p-mode"
     2705       p-mode
     2706       view-as alert-box ERROR.
     2707       return error .
     2708    end.
     2709    if p-mode = "one":U then do:
     2710     find first X_staff no-lock where
     2711                   X_staff.role = p-role no-error.
     2712       if not available X_staff then do:
     2713           message
     2714           vss-workfile vss-revision vss-description skip
     2715           "Неверное значение параметра вызова p-role"
     2716           p-role
     2717           view-as alert-box ERROR.
     2718           return.
     2719       end.
     2720     end.
     2721     v-rid-list = p-rid-list.
     2722   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2723   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2724     (output v-db-num
     2725     )  .
     2726     RUN MyEnable.
     2727     RUn OpenBR.
     2728     HIDE mark-num in frame Dialog-Frame .
     2729     if v-doc-rec <> ? then
     2730     REPOSITION br-cstaff to recid v-doc-rec No-ERROR.
     2731   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2732   DEF VAR cur-clmn-numbr-cstaff as INT EXTENT 6 no-undo.
     2733   DEF VAR varmvibr-cstaff       as INT no-undo.
     2734   DEF VAR varmvjbr-cstaff       as INT no-undo.
     2735   DEF VAR varmvkbr-cstaff       as INT no-undo.
     2736   DEF VAR varmvlbr-cstaff       as INT no-undo.
     2737   DEF VAR move-elementbr-cstaff as INT no-undo.
     2738   def var jjbr-cstaff           as int no-undo.
     2739   do varmvibr-cstaff = 1 to EXTENT(cur-clmn-numbr-cstaff):
     2740     ASSIGN cur-clmn-numbr-cstaff[varmvibr-cstaff] = varmvibr-cstaff.
     2741   END.
     2742   RUN start-mv-clmnbr-cstaff.
     2743   PROCEDURE start-mv-clmnbr-cstaff:
     2744   def var old-session as logical no-undo.
     2745      old-session = SESSION:IMMEDIATE-DISPLAY.
     2746      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2747          IF  p-mode = 'one'  THEN DO:
     2748      DO jjbr-cstaff = NUM-ENTRIES('1,2,3,4,5,6') TO 1 BY -1:
     2749        RUN re-move-clmnbr-cstaff ( cur-clmn-numbr-cstaff[INTEGER(ENTRY (jjbr-cstaff, '1,2,3,4,5,6'))] , 1).
     2750      END.
     2751          END.
     2752      SESSION:IMMEDIATE-DISPLAY = old-session.
     2753   END.
     2754   ON ctrl-cursor-right OF BROWSE br-cstaff do:
     2755     RUN re-move-clmnbr-cstaff ( 1, 6).
     2756   END.
     2757   ON ctrl-cursor-left OF BROWSE br-cstaff do:
     2758     RUN re-move-clmnbr-cstaff (6, 1).
     2759   END.
     2760   PROCEDURE re-move-clmnbr-cstaff:
     2761     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2762     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2763     DO varmvibr-cstaff = 1 TO EXTENT(cur-clmn-numbr-cstaff):
     2764       if cur-clmn-numbr-cstaff[varmvibr-cstaff] = source-column THEN cur-clmn-numbr-cstaff[varmvibr-cstaff] = -1.
     2765     END.
     2766     if br-cstaff:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2767     if source-column > target-column THEN
     2768     DO varmvjbr-cstaff = source-column - 1 to target-column BY -1:
     2769       DO varmvibr-cstaff = 1 TO EXTENT(cur-clmn-numbr-cstaff):
     2770           if cur-clmn-numbr-cstaff[varmvibr-cstaff] = varmvjbr-cstaff THEN DO:
     2771             cur-clmn-numbr-cstaff[varmvibr-cstaff] = cur-clmn-numbr-cstaff[varmvibr-cstaff] + 1.
     2772           END.
     2773       END.
     2774     END.
     2775     ELSE
     2776     DO varmvjbr-cstaff = source-column + 1 to target-column:
     2777       DO varmvibr-cstaff = 1 TO EXTENT(cur-clmn-numbr-cstaff):
     2778         if cur-clmn-numbr-cstaff[varmvibr-cstaff] = varmvjbr-cstaff THEN DO:
     2779           cur-clmn-numbr-cstaff[varmvibr-cstaff] = cur-clmn-numbr-cstaff[varmvibr-cstaff] - 1.
     2780         END.
     2781       END.
     2782     END.
     2783     DO varmvibr-cstaff = 1 TO EXTENT(cur-clmn-numbr-cstaff):
     2784       if cur-clmn-numbr-cstaff[varmvibr-cstaff] = -1 THEN cur-clmn-numbr-cstaff[varmvibr-cstaff] = target-column.
     2785     END.
     2786   END PROCEDURE.
     2787   PROCEDURE ch-clmnbr-cstaff:
     2788     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2789     if cur-clmn-loc <= 1 then do:
     2790       return .
     2791     end.
     2792     DO varmvibr-cstaff = 1 TO EXTENT(cur-clmn-numbr-cstaff):
     2793       if cur-clmn-numbr-cstaff[varmvibr-cstaff] = cur-clmn-loc THEN move-elementbr-cstaff = varmvibr-cstaff.
     2794     END.
     2795     RUN re-move-clmnbr-cstaff (cur-clmn-loc, 1).
     2796   END PROCEDURE.
     2797   PROCEDURE mv-brw-defaultbr-cstaff:
     2798   def var old-session as logical no-undo.
     2799     old-session = SESSION:IMMEDIATE-DISPLAY.
     2800     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2801     do varmvlbr-cstaff = 1 to EXTENT(cur-clmn-numbr-cstaff):
     2802       RUN re-move-clmnbr-cstaff (cur-clmn-numbr-cstaff[varmvlbr-cstaff], varmvlbr-cstaff).
     2803     END.
     2804     RUN start-mv-clmnbr-cstaff.
     2805     SESSION:IMMEDIATE-DISPLAY = old-session.
     2806   END PROCEDURE.
     2807   .
     2808     run diasize_add_browse in this-procedure
     2809       (input  'width':u
     2810       ,input  browse br-changes :handle
     2811       ) .
     2812     run diasize_init in this-procedure .
     2813   WAIT-FOR GO OF FRAME Dialog-Frame.
     2814   END.
     2815   RUN disable_UI.
     2816   PROCEDURE disable_UI :
     2817     HIDE FRAME Dialog-Frame.
     2818   END PROCEDURE.
     2819   PROCEDURE enable_UI :
     2820     DISPLAY mark-num
     2821         WITH FRAME Dialog-Frame.
     2822     ENABLE b-quit B-mark B-sel B-Help br-cstaff BR-changes mark-num
     2823         WITH FRAME Dialog-Frame.
     2824     VIEW FRAME Dialog-Frame.
     2825     OPEN QUERY br-cstaff FOR EACH X_c-staff NO-LOCK INDEXED-REPOSITION.
     2826   END PROCEDURE.
     2827   PROCEDURE MyEnable :
     2828   assign
     2829   temp-changes.l_name:resizable in browse br-changes = true
     2830   temp-changes.v_old:resizable in browse br-changes = true
     2831   temp-changes.v_new:resizable in browse br-changes = true
     2832   temp-changes.l_name:width in browse br-changes = 30
     2833   temp-changes.v_old:width in browse br-changes = 40
     2834   temp-changes.v_new:width in browse br-changes = 40
     2835   .
     2836   DISPLAY mark-num
     2837   WITH FRAME Dialog-Frame.
     2838   ENABLE
     2839   b-quit
     2840   B-mark when LOOKUP("b-mark":U, bttns) > 0
     2841   B-sel when LOOKUP("b-sel":U, bttns) > 0
     2842   B-Help
     2843   br-cstaff
     2844   mark-num
     2845   br-changes
     2846   with FRAME Dialog-Frame .
     2847   VIEW FRAME Dialog-Frame .
     2848   END PROCEDURE.
     2849   PROCEDURE OpenBr :
     2850   CASE p-mode:
     2851       WHEN 'one':U THEN DO:
     2852         assign
     2853         frame Dialog-Frame:title = substitute("&1 &2"
     2854                                                 , frame Dialog-Frame:title
     2855                                                 , gbclcode-get-position ( input p-role
     2856                                                                          ,input p-role-level
     2857                                                                          ,input p-work-place
     2858                                                                          ,input p-staff-code ))
     2859         .
     2860         OPEN QUERY br-cstaff
     2861         FOR EACH X_c-staff NO-LOCK where
     2862             X_c-staff.role = p-role
     2863         AND X_c-staff.role-level = p-role-level
     2864         AND X_c-staff.work-place = p-work-place
     2865         AND X_c-staff.staff-code = p-staff-code
     2866         AND X_c-staff.date-start = p-date-start INDEXED-REPOSITION.
     2867       END.
     2868   END CASE.
     2869   APPLY "VALUE-CHANGED" TO br-cstaff in frame Dialog-Frame.
     2870   APPLY "ENTRY" TO br-cstaff.
     2871   END PROCEDURE.
     2872   PROCEDURE proc-br-cstaff :
     2873   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2874   if b-sel:sensitive in frame Dialog-Frame then dO:
     2875       if b-mark:sensitive then do:
     2876           apply "choose" to b-mark in frame Dialog-Frame.
     2877       end.
     2878       else do:
     2879           apply "choose" to b-sel in frame Dialog-Frame.
     2880       end.
     2881   end.
     2882   else do:
     2883       if b-lookup:sensitive then
     2884       apply "choose" to b-lookup in frame Dialog-Frame.
     2885   end.
     2886   END PROCEDURE.
     2887   PROCEDURE proc-view-changes :
     2888   define buffer buf_c-cli-hist for ub.c-cli-hist.
     2889   define buffer next_c-staff for ub.c-staff.
     2890   for each temp-changes:
     2891       delete temp-changes.
     2892   END.
     2893   if not available X_c-staff then do:
     2894     Open QUery br-changes for each temp-changes.
     2895     return.
     2896   end.
     2897   find first buf_c-cli-hist no-lock where
     2898             buf_c-cli-hist.obj-type = 'чел':U
     2899         and buf_c-cli-hist.obj-code = X_c-staff.psn-code
     2900         and buf_c-cli-hist.corr-user-db-num = X_c-staff.corr-user-db-num
     2901         and buf_c-cli-hist.chip-num = X_c-staff.chip-num no-error .
     2902   if not available buf_c-cli-hist then do:
     2903     message
     2904     "Неверная ссылка на c-cli-hist в таблице c-staff"
     2905     view-as alert-box error.
     2906   end.
     2907   else do:
     2908     define variable v-label-param as character no-undo .
     2909     v-label-param =
     2910       "date-end" + chr(4) + "По" + chr(4) + ""  .
     2911     run proc-full-temp-changes in this-procedure (
     2912                                                  input buf_c-cli-hist.action = integer('1':U)
     2913                                                 ,input buf_c-cli-hist.action = integer('99':U)
     2914                                                 ,input  buffer X_c-staff:handle
     2915                                                 ,input  'staff':U
     2916                                                 ,input  "date-end"
     2917                                                 ,input  v-label-param).
     2918   end.
     2919   Open QUery br-changes for each temp-changes.
     2920   END PROCEDURE.
     2921   FUNCTION get-action RETURNS CHARACTER
     2922     ( INPUT p-action AS integer ) :
     2923     define variable dops as character no-undo.
     2924   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     2925   RETURN dops.
     2926   END FUNCTION.
     2927   FUNCTION get-action-from-c-cli RETURNS CHARACTER
     2928     ( INPUT p-psn-code AS INTEGER, INPUT p-corr-user-db-num AS INTEGER, INPUT p-chip-num AS INTEGER ) :
     2929   define buffer buf_c-cli-hist for ub.c-cli-hist.
     2930   find first buf_c-cli-hist no-lock where
     2931             buf_c-cli-hist.obj-type = 'чел':U
     2932         and buf_c-cli-hist.obj-code = p-psn-code
     2933         and buf_c-cli-hist.corr-user-db-num = p-corr-user-db-num
     2934         and buf_c-cli-hist.chip-num = p-chip-num no-error .
     2935   IF AVAILABLE buf_c-cli-hist  THEN DO:
     2936       RETURN get-action(buf_c-cli-hist.action).
     2937   END.
     2938   RETURN chr(63).
     2939   END FUNCTION.
