       10   define input parameter p-role           like ub.staff.role no-undo .
       11   define input parameter p-role-level     like ub.staff.role-level no-undo .
       12   define input parameter p-work-place     like ub.staff.work-place no-undo .
       13   define input parameter p-staff-code     like ub.staff.staff-code no-undo .
       14   define input parameter p-date-start     like ub.staff.date-start no-undo .
       15   define input-output param p-rid-list    as  char no-undo .
       16   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       17   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       18   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       19   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       20   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
