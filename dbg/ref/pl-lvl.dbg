        1   define input parameter parparentproc   as widget-handle  no-undo .
        2   define input parameter p-obj-type      as character      no-undo.
        3   define input parameter p-obj-code      as integer        no-undo.
        4   define input parameter p-pl-code       as integer        no-undo.
        5   define input-output parameter  p-pl-level as decimal          no-undo.
        6   define output parameter p-ok      as logical          no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision: 10804996d925, 3000, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
        9   define variable vss-date        as character no-undo init "$Date: Ср апр 06 16:23:44 2022 +0300 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: pl-lvl.w $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: ref/pl-lvl.w $":U .
       12   define variable vss-description as character no-undo init "Редактирование записи в градуировочной таблице".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118   define variable v-pl-level-next    as integer      no-undo.
      119   define variable v-pl-level-prev    as integer      no-undo.
      120   define variable v-pl-qnty-next     as decimal      no-undo.
      121   define variable v-pl-qnty-prev     as decimal      no-undo.
      122   define variable v-new           as logical      no-undo.
      123   define buffer buf_pl-level    for pl-level .
      124   define buffer buf_pl-level-attr    for pl-level-attr .
      125   define buffer buf_place    for place .
      126   DEFINE BUTTON b-exit AUTO-GO
      127        LABEL "&Ввод"
      128        SIZE 10 BY 1
      129        BGCOLOR 8 .
      130   DEFINE BUTTON b-help
      131        LABEL "Помо&щь"
      132        SIZE 10 BY 1
      133        BGCOLOR 8 .
      134   DEFINE BUTTON b-quit AUTO-END-KEY
      135        LABEL "&Отмена"
      136        SIZE 10 BY 1
      137        BGCOLOR 8 .
      138   DEFINE VARIABLE v-pl-deltaV AS DECIMAL FORMAT "9.9999":U INITIAL 0
      139        VIEW-AS FILL-IN
      140        SIZE 11.6 BY 1 NO-UNDO.
      141   DEFINE VARIABLE v-pl-level AS INTEGER FORMAT ">>>>9":U INITIAL 0
      142        LABEL "Уровень, см"
      143        VIEW-AS FILL-IN
      144        SIZE 14 BY 1 NO-UNDO.
      145   DEFINE VARIABLE v-pl-level-next-str AS CHARACTER FORMAT "X(3)":U INITIAL "-"
      146        LABEL "Следующий уровнь"
      147         VIEW-AS TEXT
      148        SIZE 6.6 BY .67 NO-UNDO.
      149   DEFINE VARIABLE v-pl-level-prev-str AS CHARACTER FORMAT "X(3)":U INITIAL "-"
      150        LABEL "Предыдущий уровень"
      151         VIEW-AS TEXT
      152        SIZE 5 BY .67 NO-UNDO.
      153   DEFINE VARIABLE v-pl-qnty AS DECIMAL FORMAT "->,>>>,>>9.999":U INITIAL 0
      154        LABEL "Объем, литры"
      155        VIEW-AS FILL-IN
      156        SIZE 14 BY 1 NO-UNDO.
      157   DEFINE VARIABLE v-pl-qnty-next-str AS CHARACTER FORMAT "X(10)":U INITIAL "-"
      158        LABEL "Следующий объем"
      159         VIEW-AS TEXT
      160        SIZE 12.6 BY .67 NO-UNDO.
      161   DEFINE VARIABLE v-pl-qnty-prev-str AS CHARACTER FORMAT "X(10)":U INITIAL "-"
      162        LABEL "Предыдущий объем"
      163         VIEW-AS TEXT
      164        SIZE 11 BY .67 NO-UNDO.
      165   DEFINE VARIABLE v-pl-tarir-delta AS DECIMAL FORMAT "9.999":U INITIAL 0
      166        LABEL "Погрешность составления, %"
      167        VIEW-AS FILL-IN
      168        SIZE 9 BY 1 NO-UNDO.
      169   DEFINE FRAME Dialog-Frame
      170        b-exit AT ROW 1 COL 1
      171        b-quit AT ROW 1 COL 11
      172        b-help AT ROW 1 COL 61
      173        v-pl-level AT ROW 3.52 COL 13.8 COLON-ALIGNED WIDGET-ID 2
      174        v-pl-qnty AT ROW 3.52 COL 42.8 COLON-ALIGNED WIDGET-ID 4
      175        v-pl-tarir-delta AT ROW 3.52 COL 85.8 COLON-ALIGNED WIDGET-ID 14
      176        v-pl-deltaV AT ROW 3.52 COL 116.8 COLON-ALIGNED NO-LABEL WIDGET-ID 20
      177        v-pl-level-prev-str AT ROW 2.52 COL 22.2 COLON-ALIGNED WIDGET-ID 6
      178        v-pl-qnty-prev-str AT ROW 2.52 COL 53.6 COLON-ALIGNED WIDGET-ID 10
      179        v-pl-level-next-str AT ROW 4.81 COL 20.6 COLON-ALIGNED WIDGET-ID 8
      180        v-pl-qnty-next-str AT ROW 4.81 COL 38.6 WIDGET-ID 12
      181        "Вместимости, м3/мм:" VIEW-AS TEXT
      182             SIZE 20 BY .62 AT ROW 4.05 COL 98.8 WIDGET-ID 18
      183        "Коэффициент" VIEW-AS TEXT
      184             SIZE 12 BY .71 AT ROW 3.38 COL 98.8 WIDGET-ID 16
      185        SPACE(19.79) SKIP(2.33)
      186       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      187            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      188            TITLE "<insert dialog title>"
      189            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit WIDGET-ID 100.
      190   ASSIGN
      191          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      192          FRAME Dialog-Frame:HIDDEN           = TRUE.
      193   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      194   DO:
      195     APPLY "END-ERROR":U TO SELF.
      196   END.
      197   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      198   DO:
      199      assign
      200         v-pl-level
      201         v-pl-qnty
      202         v-pl-tarir-delta
      203         v-pl-deltaV
      204      .
      205      IF v-pl-level < 0
      206      OR v-pl-level = ?
      207      THEN DO:
      208         message
      209            "Уровень должен быть не меньше ноля"
      210            skip
      211         view-as alert-box information.
      212         RETURN NO-APPLY.
      213      END.
      214      IF v-pl-qnty < 0
      215      OR v-pl-qnty = ?
      216      THEN DO:
      217         message
      218            "Объем должен быть не меньше ноля"
      219            skip
      220         view-as alert-box information.
      221         RETURN NO-APPLY.
      222      END.
      223      if v-pl-deltaV <= 0
      224      then do :
      225        message
      226            "Коэффициент вместимости должен быть больше ноля"
      227            skip
      228        view-as alert-box information.
      229        RETURN NO-APPLY.
      230      end .
      231      run check-pl-level in this-procedure NO-ERROR.
      232      IF ERROR-STATUS:ERROR then do:
      233         message
      234            error-status:get-message(1) skip
      235            return-value
      236         view-as alert-box error .
      237         return no-apply .
      238      end.
      239      run prev-next-show in this-procedure.
      240      run save-pl-level  in this-procedure no-error.
      241      IF ERROR-STATUS:ERROR then do:
      242         message
      243            error-status:get-message(1) skip
      244            return-value
      245         view-as alert-box error .
      246         return no-apply .
      247      end.
      248      assign
      249         p-ok = true
      250      .
      251   END.
      252   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      253   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      254   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      255   on help of frame Dialog-Frame
      256   do:
      257     run gbl/app_help.p
      258       (input this-procedure :file-name
      259       ,input ''
      260       ,input ?
      261       ) no-error.
      262     if error-status :error then do:
      263       message
      264         "Ошибка при вызове помощи"
      265         error-status :get-message(1)
      266         view-as alert-box .
      267     end.
      268   end.
      269   run minbtn-set in this-procedure .
      270   on choose of b-help in frame Dialog-Frame
      271   do:
      272     apply "help":u to frame Dialog-Frame .
      273   end.
      274   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      275   procedure minbtn-set :
      276       do
      277           on error undo, return error return-value
      278           :
      279           define variable ii              as integer       no-undo .
      280           define variable fh              as widget-handle no-undo .
      281           define variable hh              as widget-handle no-undo .
      282           define variable v-h             as handle        extent 4 no-undo .
      283           define variable v-name-button   as character     no-undo .
      284           define variable v-help-old-x    as decimal       no-undo .
      285           define variable v-help-old-y    as decimal       no-undo .
      286           define variable v-help-old-size as decimal       no-undo .
      287           define variable v-frame-width   as decimal       no-undo .
      288           define variable jj              as integer       no-undo .
      289           do
      290               on error undo, return error
      291               :
      292               assign
      293                   v-frame-width = frame Dialog-Frame:width - 0.3
      294                   fh            = frame Dialog-Frame:first-child
      295                   hh            = fh:first-child
      296                   ii            = 1
      297                   .
      298               do while valid-handle(hh):
      299                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      300                   do:
      301                       case lc(hh:name) :
      302                           when "b-help" then
      303                               do:
      304                                   hh:load-image-up("cmp/b-help.bmp":u) .
      305                                   hh:load-image-down("cmp/b-help.bmp":u) .
      306                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      307                                   hh:TOOLTIP = "Помощь" .
      308                                   v-help-old-x = hh:column .
      309                                   v-help-old-y = hh:row    .
      310                                   v-help-old-size = hh:width .
      311                                   hh:width-chars = 2.5 .
      312                               end.
      313                           when "b-print" then
      314                               do:
      315                                   hh:load-image("cmp/b-print.bmp":u) .
      316                                   hh:TOOLTIP = "Печать" .
      317                                   v-h[ii] = hh:handle .
      318                                   ii = ii + 1 .
      319                                   hh:width-chars = 3 .
      320                               end.
      321                           when "b-history" or
      322                           when "b-hist" then
      323                               do:
      324                                   hh:load-image("cmp/b-hist.bmp":u) .
      325                                   hh:TOOLTIP = "История" .
      326                                   v-h[ii] = hh:handle .
      327                                   ii = ii + 1 .
      328                                   hh:width-chars = 3 .
      329                               end.
      330                           when "b-sch" then
      331                               do:
      332                                   hh:load-image("cmp/b-sch.bmp":u) .
      333                                   hh:TOOLTIP = "Установка Фильтра" .
      334                                   v-h[ii] = hh:handle .
      335                                   ii = ii + 1 .
      336                                   hh:width-chars = 3 .
      337                               end.
      338                           when "b-hist-user" then
      339                               do:
      340                                   hh:load-image("cmp/b-hist.bmp":u) .
      341                                   hh:TOOLTIP = "История пользователя" .
      342                                   ii = ii + 1 .
      343                               end.
      344                       end case.
      345                   end.
      346                   hh = hh:next-sibling.
      347               end.
      348               b-help:column = v-frame-width - b-help:width-chars.
      349               jj = 0.
      350               repeat ii = 4 to 1 by -1 :
      351                   if valid-handle (v-h[ii] ) then
      352                   do:
      353                       jj  = jj + 1 .
      354                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      355                       v-h[ii]:row    = v-help-old-y .
      356                   end.
      357               end.
      358           end.
      359       end.
      360   end procedure.
      361   MAIN-BLOCK:
      362   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      363      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      364      find  first buf_place
      365            where buf_place.obj-type = p-obj-type
      366               and buf_place.obj-code = p-obj-code
      367               and buf_place.pl-code  = p-pl-code
      368            no-lock
      369            no-error
      370            .
      371      IF p-pl-level <> ? THEN DO:
      372         find first buf_pl-level
      373              where buf_pl-level.obj-type = p-obj-type
      374                and buf_pl-level.obj-code = p-obj-code
      375                and buf_pl-level.pl-code  = p-pl-code
      376                and buf_pl-level.pl-level = p-pl-level
      377              share-lock
      378              no-wait
      379              no-error
      380              .
      381         IF NOT AVAILABLE buf_pl-level THEN DO:
      382            IF locked buf_pl-level THEN dO:
      383               return error "Эта запись градуировочной таблицы в данный момент редактируется".
      384            END.
      385            else do:
      386               return error "Не найдена запись в градуировочной таблице".
      387            end.
      388         END.
      389         find first buf_pl-level-attr exclusive-lock where buf_pl-level-attr.obj-type  = buf_pl-level.obj-type
      390                                                       and buf_pl-level-attr.obj-code  = buf_pl-level.obj-code
      391                                                       and buf_pl-level-attr.pl-code   = buf_pl-level.pl-code
      392                                                       and buf_pl-level-attr.pl-level  = buf_pl-level.pl-level
      393                                                       and buf_pl-level-attr.attr-code = "tarir-delta"
      394                                                       no-error .
      395         if not available buf_pl-level-attr
      396         then do :
      397           return error "Не найдена запись атрибута с погрешностью составления в градуировочной таблице".
      398         end .
      399         assign
      400            v-pl-level = buf_pl-level.pl-level
      401            v-pl-qnty  = buf_pl-level.pl-qnty
      402            v-pl-tarir-delta = decimal(buf_pl-level-attr.attr-value)
      403            v-pl-deltaV = ?
      404            FRAME Dialog-Frame:TITLE = SUBSTITUTE  ( "Изменение строки градуировочной таблицы для резервуара &1 (&2) &3 &4"
      405                                                   , p-pl-code
      406                                                   , buf_place.loc1
      407                                                   , p-obj-code
      408                                                   , p-obj-type
      409                                                   )
      410         .
      411         find first buf_pl-level-attr exclusive-lock where buf_pl-level-attr.obj-type  = buf_pl-level.obj-type
      412                                                       and buf_pl-level-attr.obj-code  = buf_pl-level.obj-code
      413                                                       and buf_pl-level-attr.pl-code   = buf_pl-level.pl-code
      414                                                       and buf_pl-level-attr.pl-level  = buf_pl-level.pl-level
      415                                                       and buf_pl-level-attr.attr-code = "deltaV"
      416                                                       no-error .
      417         if available buf_pl-level-attr
      418         then do :
      419           assign v-pl-deltaV = decimal(buf_pl-level-attr.attr-value) no-error .
      420         end .
      421      end.
      422      ELSE DO:
      423         assign
      424            v-new = TRUE
      425            v-pl-level = ?
      426            v-pl-qnty  = 0
      427            v-pl-deltaV = ?
      428            FRAME Dialog-Frame:TITLE = SUBSTITUTE  ( "Создание строки градуировочной таблицы для резервуара &1 (&2) &3 &4"
      429                                                   , p-pl-code
      430                                                   , buf_place.loc1
      431                                                   , p-obj-code
      432                                                   , p-obj-type
      433                                                   )
      434         .
      435         find first ub.place-attr no-lock where ub.place-attr.obj-type = buf_place.obj-type
      436                                            and ub.place-attr.obj-code = buf_place.obj-code
      437                                            and ub.place-attr.pl-code = buf_place.pl-code
      438                                            and ub.place-attr.attr-code = "place-type"
      439                                            no-error .
      440         if not available ub.place-attr
      441         or (available ub.place-attr and ub.place-attr.attr-value = "2")
      442         then do :
      443           v-pl-tarir-delta = 0.25 .
      444         end .
      445         else do :
      446           v-pl-tarir-delta = 0.2 .
      447         end .
      448      END.
      449      run check-pl-level in this-procedure NO-ERROR.
      450         IF ERROR-STATUS:ERROR then do:
      451            message
      452               error-status:get-message(1) skip
      453               return-value
      454            view-as alert-box error .
      455         end.
      456      run prev-next-show in this-procedure.
      457      RUN enable_UI.
      458      WAIT-FOR GO OF FRAME Dialog-Frame.
      459   END.
      460   RUN disable_UI.
      461   PROCEDURE check-pl-level :
      462   define buffer bf_pl-level    for pl-level .
      463   do
      464   on error undo, return error
      465   :
      466      IF p-pl-level <> v-pl-level
      467      THEN DO:
      468         find first bf_pl-level
      469              where bf_pl-level.obj-type = p-obj-type
      470                and bf_pl-level.obj-code = p-obj-code
      471                and bf_pl-level.pl-code  = p-pl-code
      472                and bf_pl-level.pl-level = v-pl-level
      473            no-lock
      474            no-error
      475            .
      476          IF AVAILABLE bf_pl-level THEN DO:
      477             RETURN ERROR SUBSTITUTE("Уже есть запись в градуировочной таблице с уровнем &1", v-pl-level) .
      478          END.
      479      END.
      480      IF v-pl-level <> ?
      481      THEN DO:
      482         find first bf_pl-level
      483            where bf_pl-level.obj-type = p-obj-type
      484               and bf_pl-level.obj-code = p-obj-code
      485               and bf_pl-level.pl-code  = p-pl-code
      486               and bf_pl-level.pl-level > v-pl-level
      487            no-lock
      488            no-error
      489            .
      490         IF AVAILABLE bf_pl-level then do:
      491            IF bf_pl-level.pl-qnty < v-pl-qnty THEN DO:
      492               RETURN ERROR SUBSTITUTE ( "Объем (&1) для текущего уровня (&2) больше, чем объем (&3) для следующего уровня (&4)"
      493                                       , v-pl-qnty
      494                                       , v-pl-level
      495                                       , bf_pl-level.pl-qnty
      496                                       , bf_pl-level.pl-level
      497                                       ) .
      498            END.
      499            assign
      500               v-pl-level-next = bf_pl-level.pl-level
      501               v-pl-qnty-next  = bf_pl-level.pl-qnty
      502            .
      503         end.
      504         find last  bf_pl-level
      505            where bf_pl-level.obj-type = p-obj-type
      506               and bf_pl-level.obj-code = p-obj-code
      507               and bf_pl-level.pl-code  = p-pl-code
      508               and bf_pl-level.pl-level < v-pl-level
      509            no-lock
      510            no-error
      511            .
      512         IF AVAILABLE bf_pl-level then do:
      513            IF bf_pl-level.pl-qnty > v-pl-qnty THEN DO:
      514               RETURN ERROR SUBSTITUTE ( "Объем (&1) для текущего уровня (&2) меньше, чем объем (&3) для предыдущего уровня (&4)"
      515                                       , v-pl-qnty
      516                                       , v-pl-level
      517                                       , bf_pl-level.pl-qnty
      518                                       , bf_pl-level.pl-level
      519                                       ) .
      520            END.
      521            assign
      522               v-pl-level-prev = bf_pl-level.pl-level
      523               v-pl-qnty-prev  = bf_pl-level.pl-qnty
      524            .
      525         end.
      526      end.
      527   end.
      528   END PROCEDURE.
      529   PROCEDURE disable_UI :
      530     HIDE FRAME Dialog-Frame.
      531   END PROCEDURE.
      532   PROCEDURE enable_UI :
      533     DISPLAY v-pl-level v-pl-qnty v-pl-tarir-delta v-pl-deltaV v-pl-level-prev-str
      534             v-pl-qnty-prev-str v-pl-level-next-str v-pl-qnty-next-str
      535         WITH FRAME Dialog-Frame.
      536     ENABLE b-exit b-quit b-help v-pl-level v-pl-qnty v-pl-tarir-delta v-pl-deltaV
      537            v-pl-level-prev-str v-pl-qnty-prev-str v-pl-level-next-str
      538            v-pl-qnty-next-str
      539         WITH FRAME Dialog-Frame.
      540     VIEW FRAME Dialog-Frame.
      541   END PROCEDURE.
      542   PROCEDURE prev-next-show :
      543   do
      544   on error undo, return error
      545   :
      546      assign
      547         v-pl-level-next-str  = IF v-pl-level-next <> 0 THEN STRING(v-pl-level-next) ELSE "-"
      548         v-pl-level-prev-str  = IF v-pl-level-prev <> 0 THEN STRING(v-pl-level-prev) ELSE "-"
      549         v-pl-qnty-next-str   = IF v-pl-qnty-next  <> 0 THEN STRING(v-pl-qnty-next ) ELSE "-"
      550         v-pl-qnty-prev-str   = IF v-pl-qnty-prev  <> 0 THEN STRING(v-pl-qnty-prev ) ELSE "-"
      551      .
      552      display
      553         v-pl-level-next-str
      554         v-pl-level-prev-str
      555         v-pl-qnty-next-str
      556         v-pl-qnty-prev-str
      557      WITH FRAME Dialog-Frame.
      558   end.
      559   END PROCEDURE.
      560   PROCEDURE save-pl-level :
      561   do
      562   transaction
      563   on error undo, return error
      564   :
      565      IF v-new THEN DO:
      566         create buf_pl-level .
      567         assign
      568            buf_pl-level.obj-type = p-obj-type
      569            buf_pl-level.obj-code = p-obj-code
      570            buf_pl-level.pl-code  = p-pl-code
      571         .
      572      END.
      573      assign
      574         buf_pl-level.pl-level = v-pl-level
      575         buf_pl-level.pl-qnty  = v-pl-qnty
      576      .
      577      find first buf_pl-level-attr exclusive-lock where buf_pl-level-attr.obj-type  = buf_pl-level.obj-type
      578                                                    and buf_pl-level-attr.obj-code  = buf_pl-level.obj-code
      579                                                    and buf_pl-level-attr.pl-code   = buf_pl-level.pl-code
      580                                                    and buf_pl-level-attr.pl-level  = buf_pl-level.pl-level
      581                                                    and buf_pl-level-attr.attr-code = "tarir-delta"
      582                                                    no-error .
      583      if not available buf_pl-level-attr
      584      then do :
      585        create buf_pl-level-attr .
      586        assign
      587          buf_pl-level-attr.obj-type  = buf_pl-level.obj-type
      588          buf_pl-level-attr.obj-code  = buf_pl-level.obj-code
      589          buf_pl-level-attr.pl-code   = buf_pl-level.pl-code
      590          buf_pl-level-attr.attr-code = "tarir-delta"
      591          buf_pl-level-attr.pl-level  = buf_pl-level.pl-level
      592        .
      593      end .
      594      assign buf_pl-level-attr.attr-value = string(v-pl-tarir-delta) .
      595      if v-pl-deltaV > 0
      596      then do :
      597        find first buf_pl-level-attr exclusive-lock where buf_pl-level-attr.obj-type  = buf_pl-level.obj-type
      598                                                      and buf_pl-level-attr.obj-code  = buf_pl-level.obj-code
      599                                                      and buf_pl-level-attr.pl-code   = buf_pl-level.pl-code
      600                                                      and buf_pl-level-attr.pl-level  = buf_pl-level.pl-level
      601                                                      and buf_pl-level-attr.attr-code = "deltaV"
      602                                                      no-error .
      603        if not available buf_pl-level-attr
      604        then do :
      605          create buf_pl-level-attr .
      606          assign
      607            buf_pl-level-attr.obj-type  = buf_pl-level.obj-type
      608            buf_pl-level-attr.obj-code  = buf_pl-level.obj-code
      609            buf_pl-level-attr.pl-code   = buf_pl-level.pl-code
      610            buf_pl-level-attr.attr-code = "deltaV"
      611            buf_pl-level-attr.pl-level  = buf_pl-level.pl-level
      612          .
      613        end .
      614        assign buf_pl-level-attr.attr-value = string(v-pl-deltaV) .
      615      end .
      616   end.
      617   END PROCEDURE.
