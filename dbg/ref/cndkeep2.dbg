        1   block-level on error undo, throw.
        2   define input parameter par-recid as recid no-undo.
        3   define input-output parameter par-sts like ub.condition-keeping.sts no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: cndkeep2.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: ref/cndkeep2.p $":U .
        9   define variable vss-description as character no-undo init "Изменение статуса условий хранения".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   DEFINE VARIABLE loc#log as logical no-undo .
       80   DEFINE BUFFER bf-condition-keeping for ub.condition-keeping.
       81   DEFINE VARIABLE choice as logical no-undo .
       82   DEFINE VARIABLE varold-sts like ub.condition-keeping.sts no-undo .
       83   _main:
       84   do
       85   on error undo, return error
       86   :
       87   FIND FIRST bf-condition-keeping WHERE
       88              recid(bf-condition-keeping) = par-recid.
       89   varold-sts = bf-condition-keeping.sts.
       90   if par-sts = ? then do:
       91     CASE varold-sts:
       92       when integer('0':U) then do:
       93         assign
       94         par-sts = integer('1':U).
       95       end.
       96       when integer('1':U) then do:
       97         assign
       98         par-sts = integer('0':U).
       99       end.
      100     END CASE.
      101   end.
      102   CASE par-sts:
      103     WHEN integer('0':U) then do:
      104       if integer('0':U) = bf-condition-keeping.sts  then do:
      105         message "Запись уже имеет статус ТЕКУЩИЙ!"
      106         view-as alert-box ERROR.
      107         par-sts = ?.
      108         return error.
      109       end.
      110       else do:
      111         message
      112         "Запись уже удалена - восстановить?"
      113         view-as alert-box QUestion buttons YEs-no update choice.
      114       end.
      115     end.
      116     WHEN integer('1':U) then do:
      117       if integer('1':U) = bf-condition-keeping.sts  then do:
      118         message "Запись уже имеет статус УДАЛЕН!"
      119         view-as alert-box ERROR.
      120         par-sts = ?.
      121         return error.
      122       end.
      123       else do:
      124         message
      125         "Удалить группу?"
      126         view-as alert-box QUestion buttons yes-no update choice.
      127       end.
      128     end.
      129   END CASE.
      130   if choice then
      131   assign
      132   bf-condition-keeping.sts = par-sts.
      133   release bf-condition-keeping no-error .
      134   if error-status:error then do:
      135     message
      136     "Ошибка при сохранении записи УСЛОВИЙ ХРАНЕНИЯ" skip
      137     error-status:get-message(1) skip
      138     return-value
      139     view-as alert-box error .
      140     undo _main, return error .
      141   end.
      142   par-sts = ?.
      143   end.
