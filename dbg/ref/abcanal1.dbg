     1120       ,output p-label
     1121       ,output p-user-can-edit
     1122       ,output p-output-display
     1123       ,output p-other
     1124       ,output p-prop-list
     1125       ,output p-prop-type-list
     1126       ,output p-prop-label-list
     1127       ,output p-global
     1128       ,output p-host
     1129       ,output p-shop
     1130       ,output p-store
     1131       ,output p-db
     1132       ,output p-region
     1133       ) no-error .
