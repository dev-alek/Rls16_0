        1   block-level on error undo, throw.
        2   DEFINE TEMP-TABLE x-abc-analysis      no-undo  LIKE ub.abc-analysis.
        3   DEFINE TEMP-TABLE x-abc-analysis-doc  no-undo  LIKE ub.abc-analysis-doc.
        4   DEFINE TEMP-TABLE x-abc-analysis-obj  no-undo LIKE  ub.abc-analysis-obj.
        5   DEFINE TEMP-TABLE x-abc-analysis-period  no-undo LIKE ub.abc-analysis-period.
        6   define input-output parameter p-doc-rec  as recid no-undo.
        7   define input parameter p-mode            as character no-undo .
        8   define input parameter table for  x-abc-analysis.
        9   define input parameter table for  x-abc-analysis-doc.
       10   define input parameter table for  x-abc-analysis-obj.
       11   define input parameter table for  x-abc-analysis-period.
       12   define variable  v-list-obj          like ub.abc-analysis.abc-hash-string-obj          no-undo .
       13   define variable  v-list-period       like ub.abc-analysis.abc-hash-string-period       no-undo .
       14   define variable  v-list-doc          like ub.abc-analysis.abc-hash-string-doc          no-undo .
       15   define variable  v-abc-hash-string-obj          like ub.abc-analysis.abc-hash-string-obj          no-undo .
       16   define variable  v-abc-hash-string-period       like ub.abc-analysis.abc-hash-string-period       no-undo .
       17   define variable  v-abc-hash-string-doc          like ub.abc-analysis.abc-hash-string-doc          no-undo .
       18   define variable  v-abc-possb-keep-string-obj    like ub.abc-analysis.abc-possb-keep-string-obj    no-undo .
       19   define variable  v-abc-possb-keep-string-period like ub.abc-analysis.abc-possb-keep-string-period no-undo .
       20   define variable  v-abc-possb-keep-string-doc    like ub.abc-analysis.abc-possb-keep-string-doc    no-undo .
       21   define variable  v-abc-string-obj               like ub.abc-analysis.abc-string-obj               no-undo .
       22   define variable  v-abc-string-period            like ub.abc-analysis.abc-string-period            no-undo .
       23   define variable  v-abc-string-doc               like ub.abc-analysis.abc-string-doc               no-undo .
       24   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       25   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       26   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       27   define variable vss-workfile    as character no-undo init "$Workfile: abcanal1.p $":U .
       28   define variable vss-archive     as character no-undo init "$Archive: ref/abcanal1.p $":U .
       29   define variable vss-description as character no-undo init "Сохранение изменений в карточке Заголовка АМ".
       30   procedure vss-get-info :
       31     define output parameter p-vss-revision    like vss-revision    no-undo .
       32     define output parameter p-vss-author      like vss-author      no-undo .
       33     define output parameter p-vss-date        like vss-date        no-undo .
       34     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       35     define output parameter p-vss-archive     like vss-archive     no-undo .
       36     define output parameter p-vss-description like vss-description no-undo .
       37     assign
       38       p-vss-revision    = vss-revision
       39       p-vss-author      = vss-author
       40       p-vss-date        = vss-date
       41       p-vss-workfile    = vss-workfile
       42       p-vss-archive     = vss-archive
       43       p-vss-description = vss-description
       44     .
       45   end procedure.
       46   procedure vss-get-parameters :
       47     define output parameter p-vss-parameters as character no-undo .
       48   end procedure.
       49   define new global shared variable g#vssrevis-logger as handle    no-undo .
       50   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       51   define variable v-vssrevis-logger                   as handle    no-undo .
       52   procedure vss-logevent :
       53     define input  parameter p-extra-paramters as character no-undo .
       54     define variable v-vssrevis-parameters as character no-undo .
       55     do
       56     on error undo, return error return-value
       57     :
       58       if  valid-handle(v-vssrevis-logger)
       59       and v-vssrevis-logger :get-signature("logevent") <> ""
       60       then do:
       61         run vss-get-parameters in this-procedure
       62           (output v-vssrevis-parameters
       63           ).
       64         run logevent in v-vssrevis-logger
       65           (input vss-workfile
       66           ,input vss-revision
       67           ,input v-vssrevis-parameters
       68           ,input p-extra-paramters
       69           ).
       70       end.
       71     end.
       72   end procedure.
       73   assign
       74     v-vssrevis-logger = g#vssrevis-logger
       75   .
       76   if  valid-handle(v-vssrevis-logger)
       77   and v-vssrevis-logger :get-signature("logevent") <> ""
       78   then do:
       79     assign
       80       v-vssrevis-logevent = true
       81     .
       82     run vss-logevent in this-procedure (input vss-description) .
       83   end.
       84   define new global shared variable g#language as character no-undo .
       85   if g#language <> '' and g#language <> 'rus':U then do:
       86     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       87   end.
       88   define new global shared variable g#library  as handle no-undo .
       89   define new global shared variable g#library2 as handle no-undo .
       90   define   shared variable g#auto as logical no-undo.
       91   define   shared variable g#news as logical no-undo.
       92   define   shared variable g#oxml as logical no-undo.
       93   define   shared variable g#esys as logical no-undo.
       94   define   shared variable g#news-source-db as integer no-undo.
       95   define   shared variable g#esys-source-esys as integer no-undo.
       96   define   shared variable g#db-num as integer   no-undo .
       97   define   shared variable g#userid as character no-undo .
       98   define   shared variable g#passwd as character no-undo .
       99   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      100   procedure cur-time :
      101      define output parameter p-today as date      no-undo .
      102      define output parameter p-time  as integer   no-undo .
      103     do
      104     on error undo, return error
      105     :
      106       define variable v-date1 as date      no-undo .
      107       define variable v-date2 as date      no-undo .
      108       define variable v-time  as integer   no-undo .
      109       assign
      110         v-date1 = today
      111         v-time  = time
      112         v-date2 = today
      113       .
      114       if v-date1 <> v-date2
      115       then do:
      116         assign
      117           v-date1 = today
      118           v-time  = v-time
      119         .
      120       end.
      121       assign
      122         p-today = v-date1
      123         p-time  = v-time
      124       .
      125     end.
      126   end.
      127   function cur-time-date returns character
      128   :
      129     return string(today, '99/99/9999':U) .
      130   end.
      131   function cur-time-mjd returns decimal
      132   :
      133     define variable v-date as date      no-undo .
      134     define variable v-time as integer   no-undo .
      135     run cur-time in this-procedure
      136       (output v-date
      137       ,output v-time
      138       ) .
      139     return integer(v-date) - 2400002 + (v-time / 86400) .
      140   end.
      141   function cur-time-get-ending-index returns integer
      142   (input p-number as integer
      143   )
      144   :
      145     if p-number < 0
      146     or p-number = ?
      147     then do:
      148       return 1 .
      149     end.
      150     define variable v-rest as integer   no-undo .
      151     assign
      152       p-number = p-number modulo 100
      153     .
      154     if p-number < 20
      155     then do:
      156       assign
      157         v-rest = p-number
      158       .
      159     end.
      160     else do:
      161       assign
      162         v-rest = p-number modulo 10
      163       .
      164     end.
      165     case v-rest :
      166       when 1
      167       then do:
      168         return 2 .
      169       end.
      170       when 2 or
      171       when 3 or
      172       when 4
      173       then do:
      174         return 3 .
      175       end.
      176       otherwise do:
      177         return 1 .
      178       end.
      179     end case .
      180   end.
      181   procedure cur-time-mjd-to-date :
      182      define input  parameter i-mjd-diff as decimal no-undo.
      183      define output parameter o-Date     as date    no-undo.
      184      define output parameter o-Time     as integer no-undo.
      185      define variable v-day-number as integer   no-undo .
      186      if    i-mjd-diff < 0
      187         or i-mjd-diff = ?
      188      then do:
      189         return "?" .
      190      end.
      191      assign
      192         v-day-number = truncate(i-mjd-diff,0).
      193         o-Date = date(v-day-number + 2400002).
      194         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      195     .
      196   end.
      197   function cur-time-mjd-to-string returns character
      198   (input p-mjd-diff as decimal
      199   )
      200   :
      201     define variable v-day-number as integer   no-undo .
      202     define variable v-seconds    as integer   no-undo .
      203     define variable v-hour       as integer   no-undo .
      204     define variable v-min        as integer   no-undo .
      205     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      206     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      207     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      208     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      209     if p-mjd-diff < 0
      210     or p-mjd-diff = ?
      211     then do:
      212       return "?" .
      213     end.
      214     assign
      215       v-day-number = integer(truncate(p-mjd-diff,0))
      216       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      217     .
      218     if v-seconds > 86400
      219     then do:
      220       assign
      221         v-seconds = 86400 - 1
      222       .
      223     end.
      224     if v-seconds < 0
      225     then do:
      226       assign
      227         v-seconds = 0
      228       .
      229     end.
      230     assign
      231       v-hour = truncate(v-seconds / 3600, 0)
      232     .
      233     assign
      234       v-seconds = v-seconds modulo 3600
      235     .
      236     assign
      237       v-min = truncate(v-seconds / 60, 0)
      238     .
      239     assign
      240       v-seconds = v-seconds modulo 60
      241     .
      242     return
      243         (if v-day-number <> 0
      244           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      245           else ""
      246         )
      247       + (if v-day-number <> 0 or v-hour <> 0
      248           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      249           else ""
      250         )
      251       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      252           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      253           else ""
      254         )
      255       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      256       .
      257   end.
      258   function cur-time-string returns character
      259   :
      260     define variable v-date as date      no-undo .
      261     define variable v-time as integer   no-undo .
      262     run cur-time in this-procedure
      263       (output v-date
      264       ,output v-time
      265       ) .
      266     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      267   end.
      268   function cur-time-string-sec returns character
      269   :
      270     define variable v-date as date      no-undo .
      271     define variable v-time as integer   no-undo .
      272     run cur-time in this-procedure
      273       (output v-date
      274       ,output v-time
      275       ) .
      276     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      277   end.
      278   function cur-time-custom  returns character
      279   (input p-prefix as character
      280   ,input p-date-format as character
      281   ,input p-delimiter as character
      282   ,input p-time-format as character
      283   ,input p-suffix as character
      284   )
      285   :
      286     define variable v-date as date      no-undo .
      287     define variable v-time as integer   no-undo .
      288     run cur-time in this-procedure
      289       (output v-date
      290       ,output v-time
      291       ) .
      292     return
      293       p-prefix
      294       + string(v-date, p-date-format)
      295       + p-delimiter
      296       + string(v-time, p-time-format)
      297       + p-suffix
      298       .
      299   end.
      300   function cur-time-print  returns character
      301   :
      302     define variable v-date as date      no-undo .
      303     define variable v-time as integer   no-undo .
      304     run cur-time in this-procedure
      305       (output v-date
      306       ,output v-time
      307       ) .
      308     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      309   end.
      310   function cur-time-datetime returns datetime
      311   :
      312     define variable v-char as character no-undo .
      313     define variable v-datetime as datetime no-undo .
      314     v-char = cur-time-string().
      315     v-datetime = datetime(v-char).
      316     return  v-datetime.
      317   end.
      318   function cur-time-string-msec returns character
      319   :
      320     define variable v-date as datetime  no-undo .
      321     v-date = now.
      322     return string(v-date) .
      323   end.
      324   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      325   define temp-table temp-index_name-value no-undo
      326   field name-key  as character
      327   field value-key as character
      328   index pi name-key
      329   .
      330   define temp-table temp-sub-index_name no-undo
      331   field name-key  as character
      332   field nn as integer
      333   index pi nn
      334   .
      335   procedure def-hash :
      336     do
      337     on error undo, return error return-value
      338     :
      339     define input  parameter p-full-string as character no-undo .
      340     define output parameter p-possb-keep-string as logical   no-undo .
      341     define output parameter p-string            as character no-undo .
      342     define output parameter p-hash-string       as character no-undo .
      343       p-full-string = trim( p-full-string ) .
      344       if length (p-full-string ) > 150 then do:
      345       assign
      346         p-possb-keep-string =  false
      347         p-string            =  substring(p-full-string,1,150)
      348         p-hash-string       =  encode(p-full-string)
      349       .
      350       end.
      351       else do:
      352       assign
      353         p-possb-keep-string =  true
      354         p-string            =  p-full-string
      355         p-hash-string       =  encode(p-full-string)
      356       .
      357       end.
      358     end.
      359   end procedure.
      360   procedure find-from-hash :
      361     do
      362     on error undo, return error return-value
      363     :
      364   define input  parameter  p-full-string            as character no-undo .
      365   define input  parameter  p-table-name             as character no-undo .
      366   define input  parameter  p-field-possb-keep-name  as character no-undo .
      367   define input  parameter  p-field-string-name      as character no-undo .
      368   define input  parameter  p-field-hash-string-name as character no-undo .
      369   define input  parameter  p-sub-table-name         as character no-undo .
      370   define output parameter  p-recid                  as recid     no-undo .
      371   define variable v-possb-keep-string as logical   no-undo .
      372   define variable v-string            as character no-undo .
      373   define variable v-hash-string       as character no-undo .
      374   define variable v-query-prepare     as character no-undo .
      375   define variable i  as integer no-undo .
      376   define variable qh as widget-handle no-undo .
      377   define variable bh as widget-handle no-undo .
      378   define variable p-rez as logical   no-undo .
      379   run def-hash in this-procedure (input  p-full-string ,
      380                 output v-possb-keep-string ,
      381                 output v-string            ,
      382                 output v-hash-string
      383                 ).
      384   p-recid = ? .
      385   create buffer bh for table p-table-name.
      386   create query qh.
      387      v-query-prepare =
      388       "for each " + p-table-name + " no-lock where "
      389       + p-field-possb-keep-name   + " = "  + string(v-possb-keep-string) + " and "
      390       + p-field-string-name       + " = '" + v-string            + "' and "
      391       + p-field-hash-string-name  + " = '" + v-hash-string       + "'"
      392       .
      393   if v-possb-keep-string = true then do:
      394       qh:set-buffers(bh).
      395       qh:query-prepare(v-query-prepare).
      396       qh:query-open.
      397       qh:get-first.
      398       p-recid = bh:recid.
      399   end.
      400   else do:
      401   message false "анализ hash" .
      402     qh:set-buffers(bh).
      403     qh:query-prepare(v-query-prepare).
      404     qh:query-open.
      405     qh:get-first.
      406     p-recid = bh:recid.
      407     repeat :
      408       qh:get-next.
      409       if bh:available then do:
      410          qh:get-first.
      411          run ver-sub-table in this-procedure (
      412              input  p-full-string ,
      413              input  p-table-name ,
      414              input  p-sub-table-name ,
      415              input  bh:recid  ,
      416              output p-rez
      417              ).
      418          if p-rez = true  then do:
      419             p-recid = bh:recid .
      420             leave.
      421          end.
      422          else do:
      423            next.
      424          end.
      425       end.
      426       leave.
      427     end.
      428   end.
      429   delete widget bh.
      430   delete widget qh.
      431     end.
      432   end procedure.
      433   procedure ver-sub-table :
      434     do
      435     on error undo, return error return-value
      436     :
      437   define input  parameter p-full-string as character no-undo .
      438   define input  parameter p-name-table as character no-undo .
      439   define input  parameter p-sub-name-table as character no-undo .
      440   define input  parameter p-recid as recid no-undo .
      441   define output parameter p-ok as logical   no-undo .
      442   define variable v-query-prepare     as character no-undo .
      443   define variable i  as integer no-undo .
      444   define variable qh as widget-handle no-undo .
      445   define variable bh as widget-handle no-undo .
      446   define variable p-rez as logical   no-undo .
      447   for each temp-index_name-value : delete temp-index_name-value . end.
      448   for each temp-sub-index_name : delete temp-sub-index_name . end.
      449       create buffer bh for table p-name-table.
      450       create query qh.
      451       v-query-prepare = "for each " + p-name-table + " no-lock where recid(" + p-name-table + ") = " + string ( p-recid ) .
      452       qh:set-buffers(bh).
      453       qh:query-prepare(v-query-prepare).
      454       qh:query-open.
      455       qh:get-first.
      456       p-recid = bh:recid.
      457   define variable v-inf-ind AS CHAR NO-UNDO.
      458   define variable v-name-pi as character no-undo .
      459   define variable v-num-fl-inkey as integer   no-undo .
      460   define variable v-num-fl       as integer   no-undo .
      461   define variable j as integer   no-undo .
      462   v-name-pi = bh:PRIMARY .
      463   v-inf-ind = "1".
      464   i = 0.
      465   DO while ( v-inf-ind <> ? )
      466       on error undo, return error:
      467       i = i + 1 .
      468       v-inf-ind = bh:INDEX-INFORMATION(i) .
      469       if v-inf-ind = ? then leave.
      470       if entry( 1 , v-inf-ind ) = v-name-pi then do:
      471          v-num-fl-inkey = ( num-entries(v-inf-ind) - 4 ) / 2 .
      472          v-num-fl       = ( num-entries(v-inf-ind) - 4 )     .
      473         if v-num-fl-inkey >= 1 then do:
      474             do j = 5 to v-num-fl  by 2 :
      475                 create temp-index_name-value .
      476                 assign
      477                   temp-index_name-value.name-key  = entry( j , v-inf-ind )
      478                   temp-index_name-value.value-key = bh:BUFFER-FIELD(entry( j , v-inf-ind )):BUFFER-VALUE
      479                 .
      480             end.
      481          end.
      482       end.
      483   END.
      484   define variable qh-sub as widget-handle no-undo .
      485   define variable bh-sub as widget-handle no-undo .
      486       create buffer bh-sub for table p-sub-name-table.
      487       create query qh-sub.
      488   define variable k as integer   no-undo init 0 .
      489       v-query-prepare = "for each " + p-sub-name-table + " no-lock where " .
      490       for each temp-index_name-value :
      491           v-query-prepare = v-query-prepare  + p-sub-name-table + "." + temp-index_name-value.name-key +
      492                         " = " + temp-index_name-value.value-key + " and " .
      493       end.
      494       v-query-prepare = v-query-prepare + " true = true " .
      495       qh-sub:set-buffers(bh-sub).
      496       qh-sub:query-prepare(v-query-prepare).
      497       qh-sub:query-open.
      498         v-name-pi = bh-sub:PRIMARY .
      499         v-inf-ind = "1".
      500         i = 0.
      501         DO while ( v-inf-ind <> ? )
      502             on error undo, return error:
      503             i = i + 1 .
      504             v-inf-ind = bh-sub:INDEX-INFORMATION(i) .
      505             if v-inf-ind = ? then leave.
      506             if entry( 1 , v-inf-ind ) = v-name-pi then do:
      507               v-num-fl-inkey = ( num-entries(v-inf-ind) - 4 ) / 2 .
      508               v-num-fl       = ( num-entries(v-inf-ind) - 4 )     .
      509               if v-num-fl-inkey >= 1 then do:
      510                   do j = 5 to v-num-fl  by 2 :
      511                       if not can-find (first temp-index_name-value  where temp-index_name-value.name-key =  entry( j , v-inf-ind )) then do:
      512                           create temp-sub-index_name .
      513                           assign
      514                             temp-sub-index_name.name-key  = entry( j , v-inf-ind )
      515                             temp-sub-index_name.nn  = j
      516                           .
      517                       end.
      518                   end.
      519               end.
      520             end.
      521         END.
      522         define variable v-qw as character no-undo .
      523         v-qw = "".
      524         qh-sub:GET-first.
      525         DO WHILE (bh-sub:AVAILABLE):
      526           for each temp-sub-index_name :
      527               v-qw = v-qw + string(bh-sub:BUFFER-FIELD(temp-sub-index_name.name-key):BUFFER-VALUE) .
      528           end.
      529           v-qw = v-qw + ",".
      530           qh-sub:GET-NEXT.
      531         END.
      532         p-ok = false .
      533         if trim(p-full-string, ",")  =  trim (v-qw, ",") then p-ok = true  .
      534       delete widget bh-sub.
      535       delete widget qh-sub.
      536       delete widget bh.
      537       delete widget qh.
      538     end.
      539   end procedure.
