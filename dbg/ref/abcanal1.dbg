      898   PROCEDURE find-def-analysis-obj :
      899   define input  parameter p-type     as character no-undo .
      900   define input  parameter p-obj-type as character no-undo .
      901   define input  parameter p-obj-code as integer   no-undo .
      902   define output parameter p-abc-id   as integer   no-undo .
      903   define output parameter p-db-num   as integer   no-undo .
      904     do
      905     on error undo, return error return-value
      906     :
      907     if p-type = "abc"  then do:
      908         define buffer buf_abc-analysis-obj for ub.abc-analysis-obj  .
      909         define buffer buf_abc-analysis     for ub.abc-analysis      .
      910         find first buf_abc-analysis-obj no-lock where
      911                   buf_abc-analysis-obj.obj-type = p-obj-type and
      912                   buf_abc-analysis-obj.obj-code = p-obj-code and
      913                   buf_abc-analysis-obj.is-def   = true use-index objdef no-error .
      914                   if available buf_abc-analysis-obj then do:
      915                       p-abc-id = buf_abc-analysis-obj.abc-id .
      916                       p-db-num = buf_abc-analysis-obj.db-num .
      917                   end.
      918                   else do:
      919                       p-abc-id = 0 .
      920                       p-db-num = 0.
      921                       return "На объекте нет анализа по умолчанию" .
      922                   end.
      923     end.
      924     if p-type = "xyz"  then do:
      925         define buffer buf_xyz-analysis-obj for ub.xyz-analysis-obj  .
      926         define buffer buf_xyz-analysis     for ub.xyz-analysis      .
      927         find first buf_xyz-analysis-obj no-lock where
      928                   buf_xyz-analysis-obj.obj-type = p-obj-type and
      929                   buf_xyz-analysis-obj.obj-code = p-obj-code and
      930                   buf_xyz-analysis-obj.is-def   = true use-index objdef no-error .
      931                   if available buf_xyz-analysis-obj then do:
      932                       p-abc-id = buf_xyz-analysis-obj.xyz-id .
      933                       p-db-num = buf_xyz-analysis-obj.db-num .
      934                   end.
      935                   else do:
      936                       p-abc-id = 0 .
      937                       p-db-num = 0 .
      938                       return "На объекте нет анализа по умолчанию" .
      939                   end.
      940     end.
      941     return .
      942   end.
      943   END PROCEDURE.
      944   procedure save-def-analysis-obj :
      945   define input  parameter p-type     as character no-undo .
      946   define input  parameter p-db-num   as integer   no-undo .
      947   define input  parameter p-abc-id   as integer   no-undo .
      948   define output parameter v-log      as logical   no-undo .
      949     do
      950     on error undo, return error return-value
      951     :
      952     v-log = true .
      953     if p-type = "abc"  then do:
      954         define buffer buf_abc-analysis-obj for ub.abc-analysis-obj  .
      955         define buffer buf_abc-obj          for ub.abc-analysis-obj  .
      956         define buffer buf_abc-analysis     for ub.abc-analysis      .
      957         for each buf_abc-obj no-lock where
      958                  buf_abc-obj.abc-id = p-abc-id and
      959                  buf_abc-obj.db-num = p-db-num :
      960               define variable v-exist    as logical   no-undo init false .
      961               define variable v-list-anal as character no-undo init ""    .
      962               for each  buf_abc-analysis-obj no-lock where
      963                         not (buf_abc-analysis-obj.abc-id = p-abc-id and
      964                              buf_abc-analysis-obj.db-num = p-db-num) and
      965                         buf_abc-analysis-obj.is-def   = true   and
      966                         buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
      967                         buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code
      968                         :
      969                   v-exist    = true .
      970                   v-list-anal = string( buf_abc-analysis-obj.abc-id ) + "," .
      971               end.
      972               if v-exist then do:
      973                   message "На объекте "
      974                   buf_abc-obj.obj-type
      975                   buf_abc-obj.obj-code
      976                   skip
      977                   "уже есть анализы по умолчанию , их внутренние номера :" skip
      978                   v-list-anal                                              skip
      979                   "Сделать по умолчанию анализ текущий " p-abc-id " ?"
      980                   view-as alert-box question
      981                   buttons yes-no update v-log .
      982                   if v-log then do:
      983                       for each  buf_abc-analysis-obj exclusive-lock where
      984                                 buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
      985                                 buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code :
      986                         if ( buf_abc-analysis-obj.abc-id = p-abc-id and
      987                              buf_abc-analysis-obj.db-num = p-db-num ) then
      988                                 buf_abc-analysis-obj.is-def   = true .
      989                         else buf_abc-analysis-obj.is-def   = false  .
      990                       end.
      991                   end.
      992               end.
      993               else do:
      994                 for each  buf_abc-analysis-obj exclusive-lock where
      995                           buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
      996                           buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code and
      997                           buf_abc-analysis-obj.abc-id = p-abc-id and
      998                           buf_abc-analysis-obj.db-num = p-db-num
      999                           :
     1000                     buf_abc-analysis-obj.is-def   = true .
     1001                 end.
     1002               end.
     1003         end.
     1004     end.
     1005     if p-type = "xyz"  then do:
     1006         define buffer buf_xyz-analysis-obj for ub.xyz-analysis-obj  .
     1007         define buffer buf_xyz-obj          for ub.xyz-analysis-obj  .
     1008         define buffer buf_xyz-analysis     for ub.xyz-analysis      .
     1009         for each buf_xyz-obj no-lock where
     1010                  buf_xyz-obj.xyz-id = p-abc-id and
     1011                  buf_xyz-obj.db-num = p-db-num :
     1012               v-exist = false .
     1013               v-list-anal = ""    .
     1014               for each  buf_xyz-analysis-obj no-lock where
     1015                         not (buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1016                              buf_xyz-analysis-obj.db-num = p-db-num) and
     1017                         buf_xyz-analysis-obj.is-def   = true   and
     1018                         buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1019                         buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code
     1020                         :
     1021                   v-exist    = true .
     1022                   v-list-anal = string( buf_xyz-analysis-obj.xyz-id ) + "," .
     1023               end.
     1024               if v-exist then do:
     1025                   message "На объекте "
     1026                   buf_xyz-obj.obj-type
     1027                   buf_xyz-obj.obj-code
     1028                   skip
     1029                   "уже есть анализы по умолчанию , их внутренние номера :" skip
     1030                   v-list-anal                                              skip
     1031                   "Сделать по умолчанию анализ текущий " p-abc-id " ?"
     1032                   view-as alert-box question
     1033                   buttons yes-no update v-log .
     1034                   if v-log then do:
     1035                       for each  buf_xyz-analysis-obj exclusive-lock where
     1036                                 buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1037                                 buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code :
     1038                         if ( buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1039                              buf_xyz-analysis-obj.db-num = p-db-num ) then
     1040                                 buf_xyz-analysis-obj.is-def   = true .
     1041                         else buf_xyz-analysis-obj.is-def   = false  .
     1042                       end.
     1043                   end.
     1044               end.
     1045               else do:
     1046                 for each  buf_xyz-analysis-obj exclusive-lock where
     1047                           buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1048                           buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code and
     1049                           buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1050                           buf_xyz-analysis-obj.db-num = p-db-num
     1051                           :
