     1367   find first x-abc-analysis no-error .
     1368   if error-status :error then do:
     1369             run err-mess ("Не найдена x-abc-analysis ").
     1370             return error "err":U.
     1371   end.
     1372   IF x-abc-analysis.abc-a  >= 100 or
     1373      x-abc-analysis.abc-b >= 100  or
     1374      x-abc-analysis.abc-a <= 0    or
     1375      x-abc-analysis.abc-b <= 0    then do:
     1376             run err-mess ("Не верно установлено соотношение ранжировани ").
     1377             return error "abc-rang":U.
     1378   END.
