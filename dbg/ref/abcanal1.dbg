     1380   define variable par-abc-type as character no-undo .
     1381   define variable  v-value-date    as date   no-undo .
     1382   define variable  v-value-decimal as decimal   no-undo .
     1383   define variable  v-value-integer as integer   no-undo .
     1384   define variable  v-value-logical as logical   no-undo .
     1385   define variable v-found as logical   no-undo .
     1386   run thbjattr_value in this-procedure  (
     1387     input   "",
     1388     input   0 ,
     1389     input   'abc-global':U ,
     1390     input   'abc-type'  ,
     1391     output  par-abc-type ,
     1392     output  v-value-date      ,
     1393     output  v-value-decimal   ,
     1394     output  v-value-integer   ,
     1395     output  v-value-logical   ,
     1396     output  par-type            ,
     1397     output  v-found
     1398     ) no-error
     1399     .
     1400     if error-status :error or v-found = false then do:
     1401         message "Нет настроек Ассортиментной политики !!!." view-as alert-box information .
     1402         return error return-value .
     1403     end.
     1404   case par-abc-type:
     1405       when "ABC":U
     1406       then do:
     1407         if x-abc-analysis.abc-a = 0 then do:
     1408             run err-mess ("Нe задан уровень А!").
     1409             return error "abc-rang":U.
     1410         end.
     1411         if x-abc-analysis.abc-b = 0 then do:
     1412             run err-mess ("Нe задан уровень  B !").
     1413             return error "abc-rang":U.
     1414         end.
     1415         if x-abc-analysis.abc-c = 0 then do:
     1416           assign
     1417             x-abc-analysis.abc-c = 100
     1418             x-abc-analysis.abc-d = 0
     1419             x-abc-analysis.abc-e = 0
     1420             x-abc-analysis.abc-f = 0
     1421           .
     1422         end.
     1423         if  x-abc-analysis.abc-a = x-abc-analysis.abc-b then do:
     1424             run err-mess ("Уровни ранжирования должны быть различны !").
     1425             return error "abc-rang":U.
     1426         end.
     1427         if not (x-abc-analysis.abc-a < x-abc-analysis.abc-b  and
     1428               x-abc-analysis.abc-b < x-abc-analysis.abc-c  )
     1429              then do:
     1430                 run err-mess ("Уровни ранжирования должны идти по возрастанию !").
     1431                 return error "abc-rang":U.
     1432              end.
     1433       end.
     1434       when "ABCD":U
     1435       then do:
     1436         if x-abc-analysis.abc-a = 0 then do:
     1437             run err-mess ("Нe задан уровень А!").
     1438             return error "abc-rang":U.
     1439         end.
     1440         if x-abc-analysis.abc-b = 0 then do:
     1441             run err-mess ("Нe задан уровень  B !").
     1442             return error "abc-rang":U.
     1443         end.
     1444         if x-abc-analysis.abc-c = 0 then do:
     1445             run err-mess ("Нe задан уровень  C !").
     1446             return error "abc-rang":U.
     1447         end.
     1448         if x-abc-analysis.abc-d = 0 then do:
     1449           assign
     1450             x-abc-analysis.abc-d = 100
     1451             x-abc-analysis.abc-e = 0
     1452             x-abc-analysis.abc-f = 0
     1453           .
     1454         end.
     1455         if   (x-abc-analysis.abc-a = x-abc-analysis.abc-b)  or
     1456              (x-abc-analysis.abc-b = x-abc-analysis.abc-c)   or
     1457              (x-abc-analysis.abc-a = x-abc-analysis.abc-c)
     1458           then do:
     1459             run err-mess ("Уровни ранжирования должны быть различны !").
     1460             return error "abc-rang":U.
     1461         end.
     1462         if not (x-abc-analysis.abc-a < x-abc-analysis.abc-b  and
     1463               x-abc-analysis.abc-b < x-abc-analysis.abc-c  and
     1464               x-abc-analysis.abc-c < x-abc-analysis.abc-d )
     1465              then do:
     1466                 run err-mess ("Уровни ранжирования должны идти по возрастанию !").
     1467                 return error "abc-rang":U.
     1468              end.
     1469       end.
     1470       when "ABCDE":U
     1471       then do:
     1472         if x-abc-analysis.abc-a = 0 then do:
     1473             run err-mess ("Нe задан уровень А!").
     1474             return error "abc-rang":U.
     1475         end.
     1476         if x-abc-analysis.abc-b = 0 then do:
     1477             run err-mess ("Нe задан уровень  B !").
     1478             return error "abc-rang":U.
     1479         end.
     1480         if x-abc-analysis.abc-c = 0 then do:
     1481             run err-mess ("Нe задан уровень  C !").
     1482             return error "abc-rang":U.
     1483         end.
     1484         if x-abc-analysis.abc-d = 0 then do:
     1485             run err-mess ("Нe задан уровень  D !").
     1486             return error "abc-rang":U.
     1487         end.
     1488         if x-abc-analysis.abc-e = 0 then do:
     1489           assign
     1490             x-abc-analysis.abc-e = 100
     1491             x-abc-analysis.abc-f = 0
     1492           .
     1493         end.
     1494         if   (x-abc-analysis.abc-a = x-abc-analysis.abc-b)  or
     1495              (x-abc-analysis.abc-a = x-abc-analysis.abc-c)  or
     1496              (x-abc-analysis.abc-a = x-abc-analysis.abc-d)  or
     1497              (x-abc-analysis.abc-b = x-abc-analysis.abc-c)  or
     1498              (x-abc-analysis.abc-b = x-abc-analysis.abc-d)
     1499           then do:
     1500             run err-mess ("Уровни ранжирования должны быть различны !").
     1501             return error "abc-rang":U.
     1502         end.
     1503         if not (x-abc-analysis.abc-a < x-abc-analysis.abc-b  and
     1504               x-abc-analysis.abc-b < x-abc-analysis.abc-c  and
     1505               x-abc-analysis.abc-c < x-abc-analysis.abc-d  and
     1506               x-abc-analysis.abc-d < x-abc-analysis.abc-e  )
     1507              then do:
     1508                 run err-mess ("Уровни ранжирования должны идти по возрастанию !").
     1509                 return error "abc-rang":U.
     1510              end.
     1511       end.
     1512       when "ABCDEF":U
     1513       then do:
     1514         if x-abc-analysis.abc-a = 0 then do:
     1515             run err-mess ("Нe задан уровень А!").
     1516             return error "abc-rang":U.
     1517         end.
     1518         if x-abc-analysis.abc-b = 0 then do:
     1519             run err-mess ("Нe задан уровень  B !").
     1520             return error "abc-rang":U.
     1521         end.
     1522         if x-abc-analysis.abc-c = 0 then do:
     1523             run err-mess ("Нe задан уровень  C !").
     1524             return error "abc-rang":U.
     1525         end.
     1526         if x-abc-analysis.abc-d = 0 then do:
     1527             run err-mess ("Нe задан уровень  D !").
     1528             return error "abc-rang":U.
     1529         end.
     1530         if x-abc-analysis.abc-f = 0 then do:
     1531             run err-mess ("Нe задан уровень  F !").
     1532             return error "abc-rang":U.
     1533         end.
     1534         if x-abc-analysis.abc-f = 0 then do:
     1535           assign
     1536             x-abc-analysis.abc-f = 100
     1537           .
     1538         end.
     1539         if   (x-abc-analysis.abc-a = x-abc-analysis.abc-b)  or
     1540              (x-abc-analysis.abc-a = x-abc-analysis.abc-c)  or
     1541              (x-abc-analysis.abc-a = x-abc-analysis.abc-d)  or
     1542              (x-abc-analysis.abc-a = x-abc-analysis.abc-e)  or
     1543              (x-abc-analysis.abc-b = x-abc-analysis.abc-c)  or
     1544              (x-abc-analysis.abc-b = x-abc-analysis.abc-d)  or
     1545              (x-abc-analysis.abc-b = x-abc-analysis.abc-e)  or
     1546              (x-abc-analysis.abc-c = x-abc-analysis.abc-d)  or
     1547              (x-abc-analysis.abc-c = x-abc-analysis.abc-e)
     1548           then do:
     1549             run err-mess ("Уровни ранжирования должны быть различны !").
     1550             return error "abc-rang":U.
     1551         end.
     1552         if not (x-abc-analysis.abc-a < x-abc-analysis.abc-b  and
     1553               x-abc-analysis.abc-b < x-abc-analysis.abc-c  and
     1554               x-abc-analysis.abc-c < x-abc-analysis.abc-d  and
     1555               x-abc-analysis.abc-d < x-abc-analysis.abc-e  and
     1556               x-abc-analysis.abc-e < x-abc-analysis.abc-f)
     1557              then do:
     1558                 run err-mess ("Уровни ранжирования должны идти по возрастанию !").
     1559                 return error "abc-rang":U.
     1560              end.
     1561       end.
     1562   end case.
     1563   if x-abc-analysis.abc-name = "":U then do:
     1564     run err-mess ("Название ABC анализа не может быть пустым").
     1565     return error "abc-name":U.
     1566   end.
     1567   if x-abc-analysis.cral-id = 0 then do:
     1568     run err-mess ("Не выбран КРИТЕРИЙ АНАЛИЗА").
     1569     return error "cral-id":U.
     1570   end.
     1571   if not can-find ( first x-abc-analysis-doc) then do: run err-mess ("Не заданы типы документов для анализа"). return error "doc":U. end.
     1572   if not can-find ( first x-abc-analysis-obj) then do: run err-mess ("Не заданы объекты для анализа"). return error "obj":U. end.
     1573   if not can-find ( first x-abc-analysis-period) then do: run err-mess ("Не заданы периоды для анализа"). return error "period":U. end.
     1574   find first ub.criterion-analysis no-lock where ub.criterion-analysis.cral-id = x-abc-analysis.cral-id no-error .
     1575   if not available ub.criterion-analysis then do: run err-mess ("Не верно задан критерий анализа.Ошибка поиска"). return error "cral-id":U. end.
     1576   if available ub.criterion-analysis and ub.criterion-analysis.cral-status <> 0  then do: run err-mess ("Критерий анализа не активный"). return error "cral-id":U. end.
     1577   define variable fl as logical   no-undo init false .
     1578   if lookup(string(criterion-analysis.cral-id) ,"5,7,9,11,13,15") > 0 then do:
     1579       for each x-abc-analysis-obj break by x-abc-analysis-obj.obj-type by x-abc-analysis-obj.obj-code :
     1580   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1581   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1582     (input  x-abc-analysis-obj.obj-type
     1583     ,input  x-abc-analysis-obj.obj-code
     1584     ,output v-host-code
     1585     )  .
     1586   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1587   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1588     (input  v-host-code
     1589     ,output v-base-code
     1590     )  .
     1591         if fl = false then
     1592             assign
     1593               v-first-base-code = v-base-code
     1594               fl = true
     1595             .
     1596         if v-first-base-code <> v-base-code then do:
     1597             run err-mess ("При выбранном валютном критерии анализа , выбранные объекты принадлежат к разным валютным фирмам. Анализ не возможен !!!").
     1598             return error "obj":U.
     1599         end.
     1600       end.
     1601   end.
     1602   _MAIN:
     1603   DO ON ERROR UNDO, RETURN ERROR
     1604   ON STOP UNDO, RETURN ERROR:
     1605   define variable v-date as date no-undo .
     1606   define variable v-time as integer no-undo .
     1607   run cur-time in this-procedure(output v-date, output v-time).
     1608     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1609       create ub.abc-analysis.
     1610       assign
     1611       ub.abc-analysis.abc-id = next-value(s-asmt, ub)
     1612       ub.abc-analysis.abc-date-create    = v-date
     1613       ub.abc-analysis.abc-time-create    = v-time
     1614       ub.abc-analysis.abc-db-num-create  = g#db-num
     1615       ub.abc-analysis.abc-who-create     = g#userid
     1616       ub.abc-analysis.db-num             = g#db-num
     1617   .
     1618       p-doc-rec = recid(ub.abc-analysis)
     1619       .
     1620     end.
     1621     else do:
     1622       FIND FIRST ub.abc-analysis where
     1623                 recid(ub.abc-analysis) = p-doc-rec No-ERROR.
     1624       if not available ub.abc-analysis then do:
     1625         message
     1626         vss-workfile vss-revision vss-description skip
     1627         "Не найдена запись - p-doc-rec" p-doc-rec
     1628         view-as alert-box error .
     1629         undo, return error '':u.
     1630       end.
     1631     end.
     1632     assign
     1633       ub.abc-analysis.cral-id     =  x-abc-analysis.cral-id
     1634       ub.abc-analysis.abc-name    =  x-abc-analysis.abc-name
     1635       ub.abc-analysis.abc-des     =  x-abc-analysis.abc-des
     1636       ub.abc-analysis.raad-a      =  x-abc-analysis.raad-a
     1637       ub.abc-analysis.raad-b      =  x-abc-analysis.raad-b
     1638       ub.abc-analysis.raad-c      =  x-abc-analysis.raad-c
     1639       ub.abc-analysis.raad-d      =  x-abc-analysis.raad-d
     1640       ub.abc-analysis.raad-e      =  x-abc-analysis.raad-e
     1641       ub.abc-analysis.raad-f      =  x-abc-analysis.raad-f
     1642       ub.abc-analysis.abc-a       =  x-abc-analysis.abc-a
     1643       ub.abc-analysis.abc-b       =  x-abc-analysis.abc-b
     1644       ub.abc-analysis.abc-c       =  x-abc-analysis.abc-c
     1645       ub.abc-analysis.abc-d       =  x-abc-analysis.abc-d
     1646       ub.abc-analysis.abc-e       =  x-abc-analysis.abc-e
     1647       ub.abc-analysis.abc-f       =  x-abc-analysis.abc-f
     1648       ub.abc-analysis.abc-a-prc-qnty  =  x-abc-analysis.abc-a-prc-qnty
     1649       ub.abc-analysis.abc-a-qnty      =  x-abc-analysis.abc-a-qnty
     1650       ub.abc-analysis.abc-a-sum-prc   =  x-abc-analysis.abc-a-sum-prc
     1651       ub.abc-analysis.abc-a-sum       =  x-abc-analysis.abc-a-sum
     1652       ub.abc-analysis.abc-b-prc-qnty  =  x-abc-analysis.abc-b-prc-qnty
     1653       ub.abc-analysis.abc-b-qnty      =  x-abc-analysis.abc-b-qnty
     1654       ub.abc-analysis.abc-b-sum-prc   =  x-abc-analysis.abc-b-sum-prc
     1655       ub.abc-analysis.abc-b-sum       =  x-abc-analysis.abc-b-sum
     1656       ub.abc-analysis.abc-c-prc-qnty  =  x-abc-analysis.abc-c-prc-qnty
     1657       ub.abc-analysis.abc-c-qnty      =  x-abc-analysis.abc-c-qnty
     1658       ub.abc-analysis.abc-c-sum-prc   =  x-abc-analysis.abc-c-sum-prc
     1659       ub.abc-analysis.abc-c-sum       =  x-abc-analysis.abc-c-sum
     1660       ub.abc-analysis.abc-d-prc-qnty  =  x-abc-analysis.abc-d-prc-qnty
     1661       ub.abc-analysis.abc-d-qnty      =  x-abc-analysis.abc-d-qnty
     1662       ub.abc-analysis.abc-d-sum-prc   =  x-abc-analysis.abc-d-sum-prc
     1663       ub.abc-analysis.abc-d-sum       =  x-abc-analysis.abc-d-sum
     1664       ub.abc-analysis.abc-e-prc-qnty  =  x-abc-analysis.abc-e-prc-qnty
     1665       ub.abc-analysis.abc-e-qnty      =  x-abc-analysis.abc-e-qnty
     1666       ub.abc-analysis.abc-e-sum-prc   =  x-abc-analysis.abc-e-sum-prc
     1667       ub.abc-analysis.abc-e-sum       =  x-abc-analysis.abc-e-sum
     1668       ub.abc-analysis.abc-f-prc-qnty  =  x-abc-analysis.abc-f-prc-qnty
     1669       ub.abc-analysis.abc-f-qnty      =  x-abc-analysis.abc-f-qnty
     1670       ub.abc-analysis.abc-f-sum-prc   =  x-abc-analysis.abc-f-sum-prc
     1671       ub.abc-analysis.abc-f-sum       =  x-abc-analysis.abc-f-sum
     1672       ub.abc-analysis.R-GOODS         =  x-abc-analysis.r-goods
     1673       ub.abc-analysis.double-line-proc          =  x-abc-analysis.double-line-proc
     1674       ub.abc-analysis.le-proc         =  x-abc-analysis.le-proc
     1675       ub.abc-analysis.abc-type        =  x-abc-analysis.abc-type
     1676     .
     1677   for each ub.abc-analysis-doc exclusive-lock where
     1678            ub.abc-analysis-doc.abc-id = ub.abc-analysis.abc-id and
     1679            ub.abc-analysis-doc.db-num = ub.abc-analysis.db-num   :
     1680       delete ub.abc-analysis-doc .
     1681   end.
     1682   v-list-doc = "".
     1683   for each x-abc-analysis-doc :
     1684        create ub.abc-analysis-doc.
     1685        BUFFER-COPY x-abc-analysis-doc  TO ub.abc-analysis-doc
     1686            assign
     1687              ub.abc-analysis-doc.abc-id = ub.abc-analysis.abc-id
     1688              ub.abc-analysis-doc.db-num = ub.abc-analysis.db-num
     1689            .
     1690             v-list-doc = v-list-doc +  x-abc-analysis-doc.abcd-ext-doc-type + "," .
     1691   end.
     1692   for each ub.abc-analysis-obj exclusive-lock where
     1693            ub.abc-analysis-obj.abc-id = ub.abc-analysis.abc-id and
     1694            ub.abc-analysis-obj.db-num = ub.abc-analysis.db-num   :
     1695       delete ub.abc-analysis-obj .
     1696   end.
     1697    v-list-obj = "".
     1698   for each x-abc-analysis-obj :
     1699        create ub.abc-analysis-obj.
     1700        BUFFER-COPY x-abc-analysis-obj  TO ub.abc-analysis-obj
     1701            assign
     1702              ub.abc-analysis-obj.abc-id = ub.abc-analysis.abc-id
     1703              ub.abc-analysis-obj.db-num = ub.abc-analysis.db-num
     1704            .
     1705        v-list-obj = v-list-obj + x-abc-analysis-obj.obj-type + string(x-abc-analysis-obj.obj-code) + "," .
     1706   end.
     1707   for each ub.abc-analysis-period exclusive-lock where
     1708            ub.abc-analysis-period.abc-id = ub.abc-analysis.abc-id and
     1709            ub.abc-analysis-period.db-num = ub.abc-analysis.db-num   :
     1710       delete ub.abc-analysis-period .
     1711   end.
     1712   v-list-period = "".
     1713   for each x-abc-analysis-period :
     1714        create ub.abc-analysis-period.
     1715        BUFFER-COPY x-abc-analysis-period TO ub.abc-analysis-period
     1716            assign
     1717              ub.abc-analysis-period.abc-id = ub.abc-analysis.abc-id
     1718              ub.abc-analysis-period.db-num = ub.abc-analysis.db-num
     1719            .
     1720            v-list-period = v-list-period + string ( x-abc-analysis-period.abcp-start,"99/99/9999") + "-"
     1721                                          + string ( x-abc-analysis-period.abcp-end,"99/99/9999")    + "," .
     1722   end.
     1723     run def-hash ( input   v-list-obj ,
     1724                    output  v-abc-possb-keep-string-obj,
     1725                    output  v-abc-string-obj ,
     1726                    output  v-abc-hash-string-obj       )
     1727                    .
     1728     run def-hash ( input   v-list-period ,
     1729                    output  v-abc-possb-keep-string-period,
     1730                    output  v-abc-string-period ,
     1731                    output  v-abc-hash-string-period       )
     1732                    .
     1733     run def-hash ( input   v-list-doc ,
     1734                    output  v-abc-possb-keep-string-doc,
     1735                    output  v-abc-string-doc ,
     1736                    output  v-abc-hash-string-doc       )
     1737                    .
     1738     assign
     1739       ub.abc-analysis.abc-hash-string-obj          =  v-abc-hash-string-obj
     1740       ub.abc-analysis.abc-hash-string-period       =  v-abc-hash-string-period
     1741       ub.abc-analysis.abc-hash-string-doc          =  v-abc-hash-string-doc
     1742       ub.abc-analysis.abc-possb-keep-string-obj    =  v-abc-possb-keep-string-obj
     1743       ub.abc-analysis.abc-possb-keep-string-period =  v-abc-possb-keep-string-period
     1744       ub.abc-analysis.abc-possb-keep-string-doc    =  v-abc-possb-keep-string-doc
     1745       ub.abc-analysis.abc-string-obj               =  v-abc-string-obj
     1746       ub.abc-analysis.abc-string-period            =  v-abc-string-period
     1747       ub.abc-analysis.abc-string-doc               =  v-abc-string-doc
     1748     .
     1749   end.
     1750   PROCEDURE err-mess:
     1751     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
     1752         message
     1753         p-mess
     1754         view-as alert-box error .
     1755   END PROCEDURE.
