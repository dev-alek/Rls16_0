      806   define variable v-exist as logical   no-undo .
      807   define variable p-id as integer   no-undo .
      808   define variable p-db as integer   no-undo .
      809   define variable  p-possb-keep-string-obj as logical   no-undo .
      810   define variable  p-string-obj            as character no-undo .
      811   define variable  p-hash-string-obj       as character no-undo .
      812   define variable  p-possb-keep-string-doc as logical   no-undo .
      813   define variable  p-string-doc            as character no-undo .
