        1   define input  parameter parparentproc as handle no-undo .
        2   define input  parameter p-mode as character no-undo .
        3   define input  parameter p-db-num  as integer   no-undo .
        4   define input  parameter p-id     as integer   no-undo .
        5   define input  parameter p-name as character no-undo .
        6   define input-output parameter p-recid as recid no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Корректировка состава количественныъх групп".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119     define variable v-cntxt-db-num        as integer   no-undo .
      120     define variable v-cntxt-userid        as character no-undo .
      121     define variable v-cntxt-level         as character no-undo .
      122     define variable v-cntxt-host-code-obj as integer   no-undo .
      123     define variable v-cntxt-obj-type      as character no-undo .
      124     define variable v-cntxt-obj-code      as integer   no-undo .
      125     define variable v-cntxt-db-num-obj    as integer   no-undo .
      126     define variable v-cntxt-is-admin      as logical   no-undo .
      127   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128     run mainmenu_getcntxt in parparentproc
      129       (output v-cntxt-db-num
      130       ,output v-cntxt-userid
      131       ,output v-cntxt-level
      132       ,output v-cntxt-host-code-obj
      133       ,output v-cntxt-obj-type
      134       ,output v-cntxt-obj-code
      135       ,output v-cntxt-db-num-obj
      136       ,output v-cntxt-is-admin
      137       ) .
      138   define variable v-sec as integer   no-undo .
      139   PROCEDURE qIq-ADD :
      140   define input  parameter p-db-num       as integer   no-undo .
      141   define input  parameter p-id           as integer   no-undo .
      142   define input  parameter p-ggr-qnty    as decimal   no-undo .
      143   define input  parameter p-use-discnt           as logical   no-undo .
      144   define input  parameter p-discnt-pc            as decimal   no-undo .
      145   define input  parameter p-method-round  as character no-undo .
      146   define input  parameter p-stts         as integer   no-undo .
      147   define input  parameter p-db-num-usr   as integer   no-undo .
      148   define input  parameter p-userid       as character no-undo .
      149   define output parameter p-recid as recid no-undo .
      150     do
      151     on error undo, return error return-value
      152     :
      153   if v-cntxt-db-num <> 0 then do :
      154      if p-db-num <> v-cntxt-db-num then do:
      155         message substitute(" Группа создана в другой БД (&1) , корректировать ее в текущей БД нельзя !" , p-db-num ) .
      156         return error substitute(" Группа создана в другой БД (&1) , корректировать ее нельзя !" , p-db-num).
      157      end.
      158   end.
      159   find first ub.qnty-in-qnty-group exclusive-lock where
      160           ub.qnty-in-qnty-group.qgr-db-num   = p-db-num  and
      161           ub.qnty-in-qnty-group.qgr-id       = p-id      and
      162           ub.qnty-in-qnty-group.ggr-qnty    = p-ggr-qnty
      163           no-error .
      164         if not available ub.qnty-in-qnty-group then do:
      165             create ub.qnty-in-qnty-group.
      166               assign
      167                   ub.qnty-in-qnty-group.qgr-db-num          = p-db-num
      168                   ub.qnty-in-qnty-group.qgr-id              = p-id
      169                   ub.qnty-in-qnty-group.ggr-qnty            = p-ggr-qnty
      170               .
      171         end.
      172         assign
      173           ub.qnty-in-qnty-group.use-discnt          = p-use-discnt
      174           ub.qnty-in-qnty-group.discnt-pc           = p-discnt-pc
      175           ub.qnty-in-qnty-group.method-round        = p-method-round
      176           ub.qnty-in-qnty-group.db-num-chg    = p-db-num-usr
      177           ub.qnty-in-qnty-group.stts          = p-stts
      178           ub.qnty-in-qnty-group.sys-date      = today
      179           ub.qnty-in-qnty-group.sys-time      = time
      180           ub.qnty-in-qnty-group.sys-time-chr  = string ( ub.qnty-in-qnty-group.sys-time,"hh:mm" )
      181           ub.qnty-in-qnty-group.who           = p-userid
      182           p-recid = recid ( ub.qnty-in-qnty-group )
      183         .
      184           run ref/h-grqu.p (buffer ub.qnty-in-qnty-group , input-output v-sec )  .
      185     end.
      186   end procedure.
      187   PROCEDURE qIq-DEL :
      188   define input  parameter p-db-num       as integer   no-undo .
      189   define input  parameter p-id           as integer   no-undo .
      190   define input  parameter p-ggr-qnty     as decimal   no-undo .
      191   define input  parameter p-db-num-usr   as integer   no-undo .
      192   define input  parameter p-userid       as character no-undo .
      193     do
      194     on error undo, return error return-value
      195     :
      196   if v-cntxt-db-num <> 0 then do :
      197      if p-db-num <> v-cntxt-db-num then do:
      198         message substitute(" Группа создана в другой БД (&1) , удалять ее в текущей БД нельзя !" , p-db-num ) .
      199         return error substitute(" Группа создана в другой БД (&1) , удалять ее нельзя !" , p-db-num).
      200      end.
      201   end.
      202   find first ub.qnty-in-qnty-group exclusive-lock where
      203           ub.qnty-in-qnty-group.qgr-db-num   = p-db-num  and
      204           ub.qnty-in-qnty-group.qgr-id       = p-id      and
      205           ub.qnty-in-qnty-group.ggr-qnty = p-ggr-qnty
      206           no-error .
      207    if not available ub.qnty-in-qnty-group then  return error .
      208         assign
      209           ub.qnty-in-qnty-group.db-num-chg    = p-db-num-usr
      210           ub.qnty-in-qnty-group.stts          = 1
      211           ub.qnty-in-qnty-group.sys-date      = today
      212           ub.qnty-in-qnty-group.sys-time      = time
      213           ub.qnty-in-qnty-group.sys-time-chr  = string(ub.qnty-in-qnty-group.sys-time,"hh:mm")
      214           ub.qnty-in-qnty-group.who           = p-userid
      215         .
      216         run ref/h-grqu.p (buffer ub.qnty-in-qnty-group , input-output v-sec )  .
      217     end.
      218   end procedure.
      219   PROCEDURE qIq-update :
      220   define input  parameter p-recid as recid no-undo .
      221   define input  parameter p-db-num       as integer   no-undo .
      222   define input  parameter p-id           as integer   no-undo .
      223   define input  parameter p-ggr-qnty    as decimal   no-undo .
      224   define input  parameter p-use-discnt           as logical   no-undo .
      225   define input  parameter p-discnt-pc            as decimal   no-undo .
      226   define input  parameter p-method-round  as character no-undo .
      227   define input  parameter p-stts         as integer   no-undo .
      228   define input  parameter p-db-num-usr   as integer   no-undo .
      229   define input  parameter p-userid       as character no-undo .
      230     do
      231     on error undo, return error return-value
      232     :
      233   if v-cntxt-db-num <> 0 then do :
      234      if p-db-num <> v-cntxt-db-num then do:
      235         message substitute(" Группа создана в другой БД (&1) , корректировать ее в текущей БД нельзя !" , p-db-num ) .
      236         return error substitute(" Группа создана в другой БД (&1) , корректировать ее нельзя !" , p-db-num).
      237      end.
      238   end.
      239   find first ub.qnty-in-qnty-group exclusive-lock where
      240        recid(ub.qnty-in-qnty-group )  = p-recid
      241           no-error .
      242         if not available ub.qnty-in-qnty-group then do:
      243             create ub.qnty-in-qnty-group.
      244               assign
      245                   ub.qnty-in-qnty-group.qgr-db-num          = p-db-num
      246                   ub.qnty-in-qnty-group.qgr-id              = p-id
      247                   ub.qnty-in-qnty-group.ggr-qnty            = p-ggr-qnty
      248               .
      249         end.
      250         assign
      251           ub.qnty-in-qnty-group.use-discnt    = p-use-discnt
      252           ub.qnty-in-qnty-group.discnt-pc     = p-discnt-pc
      253           ub.qnty-in-qnty-group.method-round  = p-method-round
      254           ub.qnty-in-qnty-group.db-num-chg    = p-db-num-usr
      255           ub.qnty-in-qnty-group.stts          = p-stts
      256           ub.qnty-in-qnty-group.sys-date      = today
      257           ub.qnty-in-qnty-group.sys-time      = time
      258           ub.qnty-in-qnty-group.sys-time-chr  = string ( ub.qnty-in-qnty-group.sys-time,"hh:mm" )
      259           ub.qnty-in-qnty-group.who           = p-userid
      260           p-recid = recid ( ub.qnty-in-qnty-group )
      261         .
      262           run ref/h-grqu.p (buffer ub.qnty-in-qnty-group , input-output v-sec )  .
      263     end.
      264   end procedure.
      265   DEFINE BUTTON B-Cancel AUTO-END-KEY
      266        LABEL "Отмена"
      267        SIZE 10 BY 1
      268        BGCOLOR 8 .
      269   DEFINE BUTTON B-Help
      270        LABEL "Помо&щь"
      271        SIZE 10 BY 1
      272        BGCOLOR 8 .
      273   DEFINE BUTTON B-save AUTO-GO
      274        LABEL "Ввод"
      275        SIZE 10 BY 1
      276        BGCOLOR 8 .
      277   DEFINE VARIABLE v-discnt-pc LIKE ub.qnty-in-qnty-group.discnt-pc
      278        LABEL "Процент скидки"
      279        VIEW-AS FILL-IN
      280        SIZE 7 BY 1 NO-UNDO.
      281   DEFINE VARIABLE v-ggr-qnty LIKE ub.qnty-in-qnty-group.ggr-qnty
      282        LABEL "Количество"
      283        VIEW-AS FILL-IN
      284        SIZE 26.5 BY 1 NO-UNDO.
      285   DEFINE VARIABLE V-method-round LIKE ub.qnty-in-qnty-group.method-round
      286        LABEL "Метод округления по скидке"
      287        VIEW-AS FILL-IN
      288        SIZE 25 BY 1 NO-UNDO.
      289   DEFINE VARIABLE v-name LIKE ub.qnty-group.name
      290        LABEL "Группа"
      291         VIEW-AS TEXT
      292        SIZE 71.5 BY .67
      293        FGCOLOR 1  NO-UNDO.
      294   DEFINE VARIABLE v-use-d AS LOGICAL INITIAL no
      295        LABEL "Использовать скидку"
      296        VIEW-AS TOGGLE-BOX
      297        SIZE 28 BY .83 NO-UNDO.
      298   DEFINE QUERY Dialog-Frame FOR
      299         ub.qnty-in-qnty-group SCROLLING.
      300   DEFINE FRAME Dialog-Frame
      301        B-save AT ROW 1 COL 1
      302        B-Cancel AT ROW 1 COL 11
      303        B-Help AT ROW 1 COL 77
      304        v-ggr-qnty AT ROW 4.75 COL 33.5 COLON-ALIGNED HELP
      305             ""
      306             LABEL "Количество" FORMAT ">>>,>>>,>>>,>>9.99"
      307        v-use-d AT ROW 5.75 COL 35.5
      308        v-discnt-pc AT ROW 6.75 COL 33.5 COLON-ALIGNED HELP
      309             ""
      310             LABEL "Процент скидки" FORMAT ">>9.99"
      311        V-method-round AT ROW 7.92 COL 33.5 COLON-ALIGNED HELP
      312             ""
      313             LABEL "Метод округления по скидке" FORMAT "X(28)"
      314        v-name AT ROW 2.67 COL 12 COLON-ALIGNED HELP
      315             ""
      316             LABEL "Группа" FORMAT "X(80)"
      317             FGCOLOR 1
      318        SPACE(1.99) SKIP(7.69)
      319       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      320            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      321            TITLE "Добавление количества в группу"
      322            DEFAULT-BUTTON B-save CANCEL-BUTTON B-Cancel.
      323   ASSIGN
      324          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      325          FRAME Dialog-Frame:HIDDEN           = TRUE.
      326   ASSIGN
      327          V-method-round:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      328   ASSIGN
      329          v-use-d:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      330   ON GO OF FRAME Dialog-Frame
      331   DO:
      332     RUN save-proc in this-procedure no-error .
      333     if error-status :error then return no-apply .
      334   END.
      335   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      336   DO:
      337     APPLY "END-ERROR":U TO SELF.
      338   END.
      339   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      340   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      341   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      342   on help of frame Dialog-Frame
      343   do:
      344     run gbl/app_help.p
      345       (input this-procedure :file-name
      346       ,input ''
      347       ,input ?
      348       ) no-error.
      349     if error-status :error then do:
      350       message
      351         "Ошибка при вызове помощи"
      352         error-status :get-message(1)
      353         view-as alert-box .
      354     end.
      355   end.
      356   run minbtn-set in this-procedure .
      357   on choose of b-help in frame Dialog-Frame
      358   do:
      359     apply "help":u to frame Dialog-Frame .
      360   end.
      361   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   procedure minbtn-set :
      363       do
      364           on error undo, return error return-value
      365           :
      366           define variable ii              as integer       no-undo .
      367           define variable fh              as widget-handle no-undo .
      368           define variable hh              as widget-handle no-undo .
      369           define variable v-h             as handle        extent 4 no-undo .
      370           define variable v-name-button   as character     no-undo .
      371           define variable v-help-old-x    as decimal       no-undo .
      372           define variable v-help-old-y    as decimal       no-undo .
      373           define variable v-help-old-size as decimal       no-undo .
      374           define variable v-frame-width   as decimal       no-undo .
      375           define variable jj              as integer       no-undo .
      376           do
      377               on error undo, return error
      378               :
      379               assign
      380                   v-frame-width = frame Dialog-Frame:width - 0.3
      381                   fh            = frame Dialog-Frame:first-child
      382                   hh            = fh:first-child
      383                   ii            = 1
      384                   .
      385               do while valid-handle(hh):
      386                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      387                   do:
      388                       case lc(hh:name) :
      389                           when "b-help" then
      390                               do:
      391                                   hh:load-image-up("cmp/b-help.bmp":u) .
      392                                   hh:load-image-down("cmp/b-help.bmp":u) .
      393                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      394                                   hh:TOOLTIP = "Помощь" .
      395                                   v-help-old-x = hh:column .
      396                                   v-help-old-y = hh:row    .
      397                                   v-help-old-size = hh:width .
      398                                   hh:width-chars = 2.5 .
      399                               end.
      400                           when "b-print" then
      401                               do:
      402                                   hh:load-image("cmp/b-print.bmp":u) .
      403                                   hh:TOOLTIP = "Печать" .
      404                                   v-h[ii] = hh:handle .
      405                                   ii = ii + 1 .
      406                                   hh:width-chars = 3 .
      407                               end.
      408                           when "b-history" or
      409                           when "b-hist" then
      410                               do:
      411                                   hh:load-image("cmp/b-hist.bmp":u) .
      412                                   hh:TOOLTIP = "История" .
      413                                   v-h[ii] = hh:handle .
      414                                   ii = ii + 1 .
      415                                   hh:width-chars = 3 .
      416                               end.
      417                           when "b-sch" then
      418                               do:
      419                                   hh:load-image("cmp/b-sch.bmp":u) .
      420                                   hh:TOOLTIP = "Установка Фильтра" .
      421                                   v-h[ii] = hh:handle .
      422                                   ii = ii + 1 .
      423                                   hh:width-chars = 3 .
      424                               end.
      425                           when "b-hist-user" then
      426                               do:
      427                                   hh:load-image("cmp/b-hist.bmp":u) .
      428                                   hh:TOOLTIP = "История пользователя" .
      429                                   ii = ii + 1 .
      430                               end.
      431                       end case.
      432                   end.
      433                   hh = hh:next-sibling.
      434               end.
      435               b-help:column = v-frame-width - b-help:width-chars.
      436               jj = 0.
      437               repeat ii = 4 to 1 by -1 :
      438                   if valid-handle (v-h[ii] ) then
      439                   do:
      440                       jj  = jj + 1 .
      441                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      442                       v-h[ii]:row    = v-help-old-y .
      443                   end.
      444               end.
      445           end.
      446       end.
      447   end procedure.
      448   MAIN-BLOCK:
      449   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      450      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      451     run init-proc in this-procedure .
      452     run  enable_UI in this-procedure  .
      453     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      454        disable  v-ggr-qnty with frame Dialog-Frame .
      455       WAIT-FOR GO OF FRAME Dialog-Frame FOCUS v-discnt-pc .
      456     end.
      457     else do:
      458        WAIT-FOR GO OF FRAME Dialog-Frame FOCUS v-ggr-qnty .
      459     end.
      460   END.
      461   run disable_ui in this-procedure .
      462   PROCEDURE disable_UI :
      463     HIDE FRAME Dialog-Frame.
      464   END PROCEDURE.
      465   PROCEDURE enable_UI :
      466     OPEN QUERY Dialog-Frame FOR EACH ub.qnty-in-qnty-group SHARE-LOCK.
      467     GET FIRST Dialog-Frame.
      468     DISPLAY v-ggr-qnty v-discnt-pc v-name
      469         WITH FRAME Dialog-Frame.
      470     ENABLE B-save B-Cancel B-Help v-ggr-qnty v-discnt-pc v-name
      471         WITH FRAME Dialog-Frame.
      472     VIEW FRAME Dialog-Frame.
      473   END PROCEDURE.
      474   PROCEDURE init-proc :
      475   define buffer buf_qnty-in-qnty-group for ub.qnty-in-qnty-group  .
      476   v-name = p-name .
      477   if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      478   find first buf_qnty-in-qnty-group no-lock where recid ( buf_qnty-in-qnty-group) = p-recid no-error .
      479         assign
      480             v-method-round = buf_qnty-in-qnty-group.method-round
      481             v-discnt-pc    = buf_qnty-in-qnty-group.discnt-pc
      482             v-ggr-qnty     = buf_qnty-in-qnty-group.ggr-qnty
      483             v-use-d        = buf_qnty-in-qnty-group.use-discnt
      484         .
      485   end.
      486   END PROCEDURE.
      487   PROCEDURE save-proc :
      488   ASSIGN frame Dialog-Frame
      489       v-method-round
      490       v-discnt-pc
      491       v-ggr-qnty
      492       v-use-d
      493        .
      494   if v-discnt-pc >= 100 then do:
      495      message "Процент не может быть 100 и выше !"  view-as alert-box error .
      496      return error return-value .
      497   end.
      498   if p-mode = 'ИЗМЕНЕНИЕ':U then
      499     run qiq-update in this-procedure (
      500         input  p-recid ,
      501         input  p-db-num      ,
      502         input  p-id          ,
      503         input  v-ggr-qnty   ,
      504         input  v-use-d  ,
      505         input  v-discnt-pc   ,
      506         input  v-method-round,
      507         input  0        ,
      508         input  v-cntxt-db-num  ,
      509         input  v-cntxt-userid
      510         ) .
      511    else
      512     run qiq-add in this-procedure (
      513           input  p-db-num      ,
      514           input  p-id          ,
      515           input  v-ggr-qnty    ,
      516           input  v-use-d       ,
      517           input  v-discnt-pc   ,
      518           input  v-method-round,
      519           input  0             ,
      520           input  v-cntxt-db-num ,
      521           input  v-cntxt-userid ,
      522           output p-recid
      523           ).
      524   END PROCEDURE.
