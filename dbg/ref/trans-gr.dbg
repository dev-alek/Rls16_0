        1   block-level on error undo, throw.
        2   define input  parameter p-cli-type as character no-undo .
        3   define input  parameter p-cli-code as integer   no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: trans-gr.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: ref/trans-gr.p $":U .
        9   define variable vss-description as character no-undo init "Процедура перехода Покупателя из группы в группу на основе его оборота".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   DEFINE BUFFER buf_buyer-group FOR ub.buyer-group.
       69   DEFINE BUFFER buf_buyer-in-buyer-group FOR ub.buyer-in-buyer-group.
       70   DEFINE BUFFER old_buyer-group FOR ub.buyer-group.
       71   DEFINE BUFFER old_buyer-in-buyer-group FOR ub.buyer-in-buyer-group.
       72   DEFINE BUFFER new_buyer-group FOR ub.buyer-group.
       73   DEFINE BUFFER new_buyer-in-buyer-group FOR ub.buyer-in-buyer-group.
       74   define buffer buf_global-state for ub.global-state  .
       75       find first  buf_global-state no-lock no-error .
       76               if  not available buf_global-state or buf_global-state.pl-use-grp-buy = false then return .
       77   define variable old-b-id       as integer   no-undo .
       78   define variable old-b-db-num   as integer   no-undo .
       79   define variable summ-tr as decimal   no-undo .
       80   define variable new-b-id       as integer   no-undo .
       81   define variable new-b-db-num   as integer   no-undo .
       82   define variable v-num as integer   no-undo .
       83   define variable v-sec as integer   no-undo .
       84       assign
       85         old-b-id      = 0
       86         old-b-db-num  = 0
       87         summ-tr       = 0
       88         new-b-id      = 0
       89         new-b-db-num  = 0
       90         v-num         = 0
       91       .
       92   for each  buf_buyer-in-buyer-group  no-lock where
       93             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code and
       94             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
       95             buf_buyer-in-buyer-group.stts = 0 ,
       96       first buf_buyer-group no-lock where
       97             buf_buyer-group.bgr-db-num = buf_buyer-in-buyer-group.bgr-db-num and
       98             buf_buyer-group.bgr-id     = buf_buyer-in-buyer-group.bgr-id and
       99             buf_buyer-group.gop-id     > 0 and
      100             buf_buyer-group.stts       = 0
      101       :
      102       assign
      103         old-b-id      = buf_buyer-group.bgr-id
      104         old-b-db-num  = buf_buyer-group.bgr-db-num
      105         summ-tr       = buf_buyer-group.oborot
      106         new-b-id      = buf_buyer-group.gop-id
      107         new-b-db-num  = buf_buyer-group.gop-db
      108         v-num         = v-num + 1
      109       .
      110   end.
      111   if v-num > 1 then do:
      112       message
      113      "Внимание ! Покупатель "
      114      p-cli-code
      115      p-cli-type
      116      " привязан к " v-num  " группам Покупателей (в статусе ТЕКУЩИЙ)"  view-as alert-box .
      117   end.
      118   if new-b-id = 0 then return .
      119   define variable current-oborot as decimal   no-undo .
      120   define buffer buf_turnover-buyer-main for ub.turnover-buyer-main  .
      121   current-oborot = 0 .
      122   for each buf_turnover-buyer-main no-lock where
      123            buf_turnover-buyer-main.cli-code = p-cli-code and
      124            buf_turnover-buyer-main.cli-type = p-cli-type
      125   :
      126       current-oborot = current-oborot + buf_turnover-buyer-main.sum-doc-rubl-itog .
      127   end.
      128   if current-oborot >= summ-tr then do:
      129       find first new_buyer-in-buyer-group exclusive-lock where
      130           new_buyer-in-buyer-group.bgr-id       = new-b-id       and
      131           new_buyer-in-buyer-group.bgr-db-num   = new-b-db-num   and
      132           new_buyer-in-buyer-group.bbg-obj-code = p-cli-code     and
      133           new_buyer-in-buyer-group.bbg-obj-type = p-cli-type     no-error .
      134           if available new_buyer-in-buyer-group then do:
      135               assign
      136                 new_buyer-in-buyer-group.stts         = 0
      137               .
      138           end.
      139           else do:
      140           create new_buyer-in-buyer-group.
      141           assign
      142             new_buyer-in-buyer-group.bgr-id       = new-b-id
      143             new_buyer-in-buyer-group.bgr-db-num   = new-b-db-num
      144             new_buyer-in-buyer-group.bbg-obj-code = p-cli-code
      145             new_buyer-in-buyer-group.bbg-obj-type = p-cli-type
      146             new_buyer-in-buyer-group.stts         = 0
      147           .
      148           end.
      149           run ref/h-grbuy.p (buffer new_buyer-in-buyer-group , input-output v-sec )  .
      150            release new_buyer-in-buyer-group.
      151           find first old_buyer-in-buyer-group exclusive-lock where
      152                       old_buyer-in-buyer-group.bgr-id       = old-b-id       and
      153                       old_buyer-in-buyer-group.bgr-db-num   = old-b-db-num   and
      154                       old_buyer-in-buyer-group.bbg-obj-code = p-cli-code     and
      155                       old_buyer-in-buyer-group.bbg-obj-type = p-cli-type     .
      156           assign
      157             old_buyer-in-buyer-group.stts         = 1
      158           .
      159           run ref/h-grbuy.p (buffer old_buyer-in-buyer-group , input-output v-sec )  .
      160           release old_buyer-in-buyer-group.
      161           run ref/trans-gr.p ( p-cli-type ,p-cli-code)  .
      162   end.
      163   return .
