      233             VIEW-AS COMBO-BOX
      234             LIST-ITEM-PAIRS "Да",1,
      235                        "Нет",0
      236             DROP-DOWN-LIST
      237             SIZE 9.5 BY 1
      238        tt-wth-ser.gds-rule AT ROW 11.25 COL 55 COLON-ALIGNED WIDGET-ID 28 FORMAT "X(2)"
      239             VIEW-AS FILL-IN
      240             SIZE 4 BY 1
      241        tt-wth-ser.gds-smb AT ROW 11.25 COL 84 COLON-ALIGNED WIDGET-ID 30
      242             LABEL "Значение" FORMAT "X(100)"
      243             VIEW-AS FILL-IN
      244             SIZE 9.5 BY 1
      245        tt-wth-ser.chk-par AT ROW 12.5 COL 13 WIDGET-ID 52
      246             LABEL "Номинал"
      247             VIEW-AS COMBO-BOX
      248             LIST-ITEM-PAIRS "Да",1,
      249                        "Нет",0
      250             DROP-DOWN-LIST
      251             SIZE 9.5 BY 1
      252        tt-wth-ser.par-rule AT ROW 12.5 COL 55 COLON-ALIGNED WIDGET-ID 66 FORMAT "X(2)"
      253             VIEW-AS FILL-IN
      254             SIZE 4 BY 1
      255        tt-wth-ser.par-smb AT ROW 12.5 COL 84 COLON-ALIGNED WIDGET-ID 68
      256             LABEL "Значение" FORMAT "X(100)"
      257             VIEW-AS FILL-IN
      258             SIZE 9.5 BY 1
      259        tt-wth-ser.chk-bdt AT ROW 14.75 COL 9 WIDGET-ID 46
      260             LABEL "Дата начала"
      261             VIEW-AS COMBO-BOX
      262             LIST-ITEM-PAIRS "Правило",1,
      263                        "Нет",0,
      264                        "Дата",2
      265             DROP-DOWN-LIST
      266             SIZE 9.5 BY 1
      267        tt-wth-ser.beg-dt AT ROW 14.75 COL 55 COLON-ALIGNED WIDGET-ID 38
      268             LABEL "Дата"
      269             VIEW-AS FILL-IN
      270             SIZE 11 BY 1
      271       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      272            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE  WIDGET-ID 100.
      273   DEFINE FRAME Dialog-Frame
      274        tt-wth-ser.beg-yy AT ROW 15.75 COL 55 COLON-ALIGNED WIDGET-ID 42
      275             LABEL "Год начала с симв."
