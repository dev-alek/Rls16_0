      291             LABEL "Дата окончания"
      292             VIEW-AS COMBO-BOX
      293             LIST-ITEM-PAIRS "Правило",1,
      294                        "Нет",0,
      295                        "Дата",2
      296             DROP-DOWN-LIST
      297             SIZE 9.5 BY 1
      298        tt-wth-ser.end-dt AT ROW 18 COL 55 COLON-ALIGNED WIDGET-ID 58
      299             LABEL "Дата"
      300             VIEW-AS FILL-IN
      301             SIZE 11 BY 1
      302        tt-wth-ser.end-yy AT ROW 19 COL 55 COLON-ALIGNED WIDGET-ID 62
      303             LABEL "Год окончания с симв."
      304             VIEW-AS FILL-IN
      305             SIZE 4 BY 1
      306        tt-wth-ser.end-yy-smb AT ROW 19 COL 87.5 COLON-ALIGNED WIDGET-ID 64
      307             LABEL "Кол-во симв." FORMAT "X(2)"
      308             VIEW-AS FILL-IN
      309             SIZE 4 BY 1
      310        tt-wth-ser.end-mm AT ROW 20 COL 55 COLON-ALIGNED WIDGET-ID 60
      311             LABEL "Месяц окончания с симв."
      312             VIEW-AS FILL-IN
      313             SIZE 4 BY 1
      314        tt-wth-ser.end-dd AT ROW 20 COL 87.5 COLON-ALIGNED WIDGET-ID 56
      315             LABEL "День окончания с симв."
      316             VIEW-AS FILL-IN
      317             SIZE 4 BY 1
      318        tt-wth-ser.PS AT ROW 21.5 COL 1.5 NO-LABEL WIDGET-ID 70
      319             VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-VERTICAL
      320             SIZE 96.5 BY 1.25
      321        tt-wth-ser.ser-code AT ROW 2.5 COL 13.5 COLON-ALIGNED WIDGET-ID 76
      322             LABEL "Код" FORMAT "999999999"
      323              VIEW-AS TEXT
      324             SIZE 9 BY .67
      325             FGCOLOR 4
      326        FILL-wth AT ROW 5 COL 27.5 COLON-ALIGNED NO-LABEL WIDGET-ID 82
      327        FILL-par AT ROW 5 COL 76.5 COLON-ALIGNED NO-LABEL WIDGET-ID 84
      328        "Срок годности" VIEW-AS TEXT
      329             SIZE 15 BY .67 AT ROW 14 COL 2.5 WIDGET-ID 96
      330             FGCOLOR 4
      331        "Структура маски" VIEW-AS TEXT
      332             SIZE 16 BY .67 AT ROW 8 COL 2.5 WIDGET-ID 94
      333             FGCOLOR 4
      334        "Маска:" VIEW-AS TEXT
      335             SIZE 6.5 BY .67 AT ROW 6.75 COL 8.5 WIDGET-ID 86
      336        RECT-2 AT ROW 14.25 COL 1.5 WIDGET-ID 90
      337        RECT-3 AT ROW 8.25 COL 1.5 WIDGET-ID 92
      338        SPACE(0.37) SKIP(9.24)
      339       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      340            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      341            TITLE "<insert dialog title>" WIDGET-ID 100.
      342   ASSIGN
      343          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      344          FRAME Dialog-Frame:HIDDEN           = TRUE.
      345   ASSIGN
      346          B-par:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      347   ASSIGN
      348          B-wth:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      349   ON GO OF FRAME Dialog-Frame
      350   DO:
      351       run proc-save in this-procedure no-error .
      352       if error-status:error then return no-apply.
      353   END.
      354   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      355   DO:
      356     APPLY "END-ERROR":U TO SELF.
      357   END.
      358   ON VALUE-CHANGED OF tt-wth-ser.authr IN FRAME Dialog-Frame
      359   DO:
      360     IF SELF:SCREEN-VALUE = '0' THEN DO:
      361     END.
      362   END.
      363   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
      364   DO:
      365      define variable v-rid-list  as   character            no-undo .
      366      define variable v-host-code like ub.sysconf.host-code no-undo .
      367      run ref/cwthhist.w (
      368                       input        parparentproc
      369                     , input        p-curr-host-code
      370                     , input        p-curr-obj-type
      371                     , input        p-curr-obj-code
      372                     , input        "":U
      373                     , input        "subject":U
      374                     , input        int(tt-wth-ser.wth-code:screen-value)
      375                     , INPUT        0
      376                     , input        ?
      377                     , input        ?
      378                     , input        ?
      379                     , input        ?
      380                     , input        "":U
      381                     , input        'wth-ser':U
      382                     , input        v-cntxt-db-num
      383                     , input        tt-wth-ser.ser-code
      384                     , input        tt-wth-ser.db-num
      385                     , input-output v-rid-list
      386                     ) no-error .
      387   END.
      388   ON CHOOSE OF B-par IN FRAME Dialog-Frame
      389   DO:
      390     define variable v-rid-list as character no-undo .
      391     run ref/wthp-ref.w (
      392                     input parparentproc
      393                    ,input  "b-sel,b-add"
      394                    ,input p-curr-host-code
      395                    ,input p-curr-obj-type
      396                    ,input p-curr-obj-code
      397                    ,input ( if int(tt-wth-ser.wth-code:screen-value) > 0 then 'МЦ':U else '')
      398                    ,input int(tt-wth-ser.wth-code:screen-value)
      399                    ,input-output v-rid-list).
      400           find first locked_wth-par exclusive-LOCK WHERE
      401                 recid(locked_wth-par) = integer(entry(1, v-rid-list)) NO-ERROR.
      402         if available locked_wth-par then ASSIGN tt-wth-ser.par-code:SCREEN-VALUE = string(LOCKED_wth-par.par-code)
      403                                                 fill-par:SCREEN-VALUE = STRING(LOCKED_wth-par.par-val).
      404   END.
      405   ON CHOOSE OF B-wth IN FRAME Dialog-Frame
      406   DO:
      407         v-rid-list = ''.
      408         run ref/wth-ref.w (
      409                            input parparentproc
      410                           ,input "b-sel"
      411                           ,input p-curr-host-code
      412                           ,input p-curr-obj-type
      413                           ,input p-curr-obj-code
      414                           ,input 'wth-ser':U
      415                           ,input-output v-rid-list) no-error.
      416         if v-rid-list = "" then return .
      417         find first locked_wealth exclusive-LOCK WHERE
      418                 recid(locked_wealth) = integer(entry(1, v-rid-list)) NO-ERROR.
      419         if available locked_wealth then do:
      420             ASSIGN tt-wth-ser.wth-code:SCREEN-VALUE = string(LOCKED_wealth.wth-code)
      421                    fill-wth:SCREEN-VALUE = LOCKED_wealth.wth-name.
      422            FIND b-wth-par WHERE b-wth-par.wth-code = LOCKED_wealth.wth-code NO-ERROR.
      423            IF AVAILABLE b-wth-par THEN do:
      424                tt-wth-ser.par-code:SCREEN-VALUE = string(b-wth-par.par-code).
      425                APPLY 'leave':U TO tt-wth-ser.par-code.
      426            END.
      427         END.
      428   END.
      429   ON VALUE-CHANGED OF tt-wth-ser.chk-bdt IN FRAME Dialog-Frame
      430   DO :
      431     IF SELF:SCREEN-VALUE = '1' THEN DO WITH FRAME Dialog-Frame:
      432         ENABLE tt-wth-ser.beg-dd
      433                tt-wth-ser.beg-mm
      434                tt-wth-ser.beg-yy
      435                tt-wth-ser.beg-yy-smb
      436        .
      437         DISABLE tt-wth-ser.beg-dt .
      438         tt-wth-ser.beg-dt:screen-value = "":U.
      439     END.
      440     ELSE IF SELF:SCREEN-VALUE = '2' THEN DO WITH FRAME Dialog-Frame:
      441         DISABLE tt-wth-ser.beg-dd
      442                tt-wth-ser.beg-mm
      443                tt-wth-ser.beg-yy
      444                tt-wth-ser.beg-yy-smb
      445        .
      446         ENABLE tt-wth-ser.beg-dt .
      447         tt-wth-ser.beg-dd:screen-value = "":U.
      448         tt-wth-ser.beg-mm:screen-value = "":U.
      449         tt-wth-ser.beg-yy:screen-value = "":U.
      450         tt-wth-ser.beg-yy-smb:screen-value = "":U.
      451     END.
      452     ELSE  do:
      453     DISABLE    tt-wth-ser.beg-dd
      454                tt-wth-ser.beg-mm
      455                tt-wth-ser.beg-yy
      456                tt-wth-ser.beg-yy-smb
      457                tt-wth-ser.beg-dt
      458          WITH FRAME Dialog-Frame.
      459          tt-wth-ser.beg-dd:screen-value = "":U.
      460          tt-wth-ser.beg-mm:screen-value = "":U.
      461          tt-wth-ser.beg-yy:screen-value = "":U.
      462          tt-wth-ser.beg-yy-smb:screen-value = "":U.
      463          tt-wth-ser.beg-dt:screen-value = "":U.
      464     end.
      465     apply 'tab':U to self.
      466   END.
      467   ON VALUE-CHANGED OF tt-wth-ser.chk-edt IN FRAME Dialog-Frame
      468   DO:
      469       IF SELF:SCREEN-VALUE = '1' THEN DO WITH FRAME Dialog-Frame:
      470         ENABLE tt-wth-ser.end-dd
      471                tt-wth-ser.end-mm
      472                tt-wth-ser.end-yy
      473                tt-wth-ser.end-yy-smb
      474        .
      475         DISABLE tt-wth-ser.end-dt .
      476         tt-wth-ser.end-dt:screen-value = "":U.
      477     END.
      478     ELSE IF SELF:SCREEN-VALUE = '2' THEN DO WITH FRAME Dialog-Frame:
      479         DISABLE tt-wth-ser.end-dd
      480                tt-wth-ser.end-mm
      481                tt-wth-ser.end-yy
      482                tt-wth-ser.end-yy-smb
      483        .
      484         ENABLE tt-wth-ser.end-dt .
      485         tt-wth-ser.end-dd:screen-value = "":U.
      486         tt-wth-ser.end-mm:screen-value = "":U.
      487         tt-wth-ser.end-yy:screen-value = "":U.
      488         tt-wth-ser.end-yy-smb:screen-value = "":U.
      489     END.
      490     ELSE  do:
      491        DISABLE    tt-wth-ser.end-dd
      492                tt-wth-ser.end-mm
      493                tt-wth-ser.end-yy
      494                tt-wth-ser.end-yy-smb
      495                tt-wth-ser.end-dt
      496          WITH FRAME Dialog-Frame.
      497          tt-wth-ser.end-dd:screen-value = "":U.
      498          tt-wth-ser.end-mm:screen-value = "":U.
      499          tt-wth-ser.end-yy:screen-value = "":U.
      500          tt-wth-ser.end-yy-smb:screen-value = "":U.
      501          tt-wth-ser.end-dt:screen-value = "":U.
      502     END.
      503     apply 'tab':U to self.
      504   END.
      505   ON VALUE-CHANGED OF tt-wth-ser.chk-gds IN FRAME Dialog-Frame
      506   DO:
      507     IF SELF:SCREEN-VALUE = '1' THEN DO:
      508       ENABLE  tt-wth-ser.gds-smb
      509               tt-wth-ser.gds-rule
      510       WITH FRAME Dialog-Frame.
      511     END.
      512     ELSE DO:
      513       DISABLE    tt-wth-ser.gds-smb
      514                     tt-wth-ser.gds-rule
      515       WITH FRAME Dialog-Frame.
      516       tt-wth-ser.gds-smb:screen-value = '':U.
      517       tt-wth-ser.gds-rule:screen-value = '':U.
      518     END.
      519     apply 'tab':U to self.
      520   END.
      521   ON VALUE-CHANGED OF tt-wth-ser.chk-par IN FRAME Dialog-Frame
      522   DO:
      523     IF SELF:SCREEN-VALUE = '1' THEN DO:
      524       ENABLE  tt-wth-ser.par-smb
      525               tt-wth-ser.par-rule
      526       WITH FRAME Dialog-Frame.
      527     END.
      528     ELSE DO:
      529       DISABLE    tt-wth-ser.par-smb
      530                  tt-wth-ser.par-rule
      531       WITH FRAME Dialog-Frame.
      532       tt-wth-ser.par-smb:screen-value = '':U.
      533       tt-wth-ser.par-rule:screen-value = '':U.
      534     END.
      535     apply 'tab':U to self.
      536   END.
      537   ON VALUE-CHANGED OF tt-wth-ser.chk-ser IN FRAME Dialog-Frame
      538   DO:
      539     IF SELF:SCREEN-VALUE = '1' THEN do:
      540       ENABLE  tt-wth-ser.ser-smb
      541               tt-wth-ser.ser-rule
      542       WITH FRAME Dialog-Frame.
      543     END.
      544     ELSE do:
      545       DISABLE    tt-wth-ser.ser-smb
      546                  tt-wth-ser.ser-rule
      547          WITH FRAME Dialog-Frame.
      548       tt-wth-ser.ser-smb:screen-value = '':U.
      549       tt-wth-ser.ser-rule:screen-value = '':U.
      550     END.
      551     apply 'tab':U to self.
      552   END.
      553   ON LEAVE OF tt-wth-ser.par-code IN FRAME Dialog-Frame
      554   DO:
      555       IF NOT SELF:MODIFIED THEN RETURN.
      556         find first locked_wth-par exclusive-LOCK WHERE
      557                 locked_wth-par.par-code = integer(SELF:SCREEN-VALUE)
      558                 AND  locked_wth-par.wth-code = integer(tt-wth-ser.wth-code:SCREEN-VALUE)      NO-ERROR.
      559         if available locked_wth-par then ASSIGN tt-wth-ser.par-code:SCREEN-VALUE = string(LOCKED_wth-par.par-code)
      560                                                 fill-par:SCREEN-VALUE = STRING(LOCKED_wth-par.par-val).
      561       SELF:MODIFIED = NO.
      562   END.
      563   ON LEAVE OF tt-wth-ser.wth-code IN FRAME Dialog-Frame
      564   DO:
      565     if not self:modified then return.
      566           find first locked_wealth exclusive-LOCK WHERE
      567                 locked_wealth.wth-code = integer(SELF:SCREEN-VALUE) NO-ERROR.
      568         if available locked_wealth then do:
      569             ASSIGN tt-wth-ser.wth-code:SCREEN-VALUE = string(LOCKED_wealth.wth-code)
      570                    fill-wth:SCREEN-VALUE = LOCKED_wealth.wth-name.
      571            FIND b-wth-par WHERE b-wth-par.wth-code = LOCKED_wealth.wth-code NO-ERROR.
      572            IF AVAILABLE b-wth-par THEN do:
      573                tt-wth-ser.par-code:SCREEN-VALUE = string(b-wth-par.par-code).
      574                APPLY 'leave':U TO tt-wth-ser.par-code.
      575            END.
      576         END.
      577         SELF:MODIFIED = NO.
      578   END.
      579   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      580   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      581   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      582   on help of frame Dialog-Frame
      583   do:
      584     run gbl/app_help.p
      585       (input this-procedure :file-name
      586       ,input ''
      587       ,input ?
      588       ) no-error.
      589     if error-status :error then do:
      590       message
      591         "Ошибка при вызове помощи"
      592         error-status :get-message(1)
      593         view-as alert-box .
      594     end.
      595   end.
      596   run minbtn-set in this-procedure .
      597   on choose of b-help in frame Dialog-Frame
      598   do:
      599     apply "help":u to frame Dialog-Frame .
      600   end.
      601   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      602   procedure minbtn-set :
      603       do
      604           on error undo, return error return-value
      605           :
      606           define variable ii              as integer       no-undo .
      607           define variable fh              as widget-handle no-undo .
      608           define variable hh              as widget-handle no-undo .
      609           define variable v-h             as handle        extent 4 no-undo .
      610           define variable v-name-button   as character     no-undo .
      611           define variable v-help-old-x    as decimal       no-undo .
      612           define variable v-help-old-y    as decimal       no-undo .
      613           define variable v-help-old-size as decimal       no-undo .
      614           define variable v-frame-width   as decimal       no-undo .
      615           define variable jj              as integer       no-undo .
      616           do
      617               on error undo, return error
      618               :
      619               assign
      620                   v-frame-width = frame Dialog-Frame:width - 0.3
      621                   fh            = frame Dialog-Frame:first-child
      622                   hh            = fh:first-child
      623                   ii            = 1
      624                   .
      625               do while valid-handle(hh):
      626                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      627                   do:
      628                       case lc(hh:name) :
      629                           when "b-help" then
      630                               do:
      631                                   hh:load-image-up("cmp/b-help.bmp":u) .
      632                                   hh:load-image-down("cmp/b-help.bmp":u) .
      633                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      634                                   hh:TOOLTIP = "Помощь" .
      635                                   v-help-old-x = hh:column .
      636                                   v-help-old-y = hh:row    .
      637                                   v-help-old-size = hh:width .
      638                                   hh:width-chars = 2.5 .
      639                               end.
      640                           when "b-print" then
      641                               do:
      642                                   hh:load-image("cmp/b-print.bmp":u) .
      643                                   hh:TOOLTIP = "Печать" .
      644                                   v-h[ii] = hh:handle .
      645                                   ii = ii + 1 .
      646                                   hh:width-chars = 3 .
      647                               end.
      648                           when "b-history" or
      649                           when "b-hist" then
      650                               do:
      651                                   hh:load-image("cmp/b-hist.bmp":u) .
      652                                   hh:TOOLTIP = "История" .
      653                                   v-h[ii] = hh:handle .
      654                                   ii = ii + 1 .
      655                                   hh:width-chars = 3 .
      656                               end.
      657                           when "b-sch" then
      658                               do:
      659                                   hh:load-image("cmp/b-sch.bmp":u) .
      660                                   hh:TOOLTIP = "Установка Фильтра" .
      661                                   v-h[ii] = hh:handle .
      662                                   ii = ii + 1 .
      663                                   hh:width-chars = 3 .
      664                               end.
      665                           when "b-hist-user" then
      666                               do:
      667                                   hh:load-image("cmp/b-hist.bmp":u) .
      668                                   hh:TOOLTIP = "История пользователя" .
      669                                   ii = ii + 1 .
      670                               end.
      671                       end case.
      672                   end.
      673                   hh = hh:next-sibling.
      674               end.
      675               b-help:column = v-frame-width - b-help:width-chars.
      676               jj = 0.
      677               repeat ii = 4 to 1 by -1 :
      678                   if valid-handle (v-h[ii] ) then
      679                   do:
      680                       jj  = jj + 1 .
      681                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      682                       v-h[ii]:row    = v-help-old-y .
      683                   end.
      684               end.
      685           end.
      686       end.
      687   end procedure.
      688   MAIN-BLOCK:
      689   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      690      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      691      ON stop UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      692     IF lookup(par-mode, 'ДОБАВЛЕНИЕ':U + chr(44) +
      693                         'ИЗМЕНЕНИЕ':U + chr(44) +
      694                         'ПРОСМОТР':U) = 0 THEN DO:
      695       MESSAGE
      696       "Неверное значение параметра par-mode" par-mode
      697       VIEW-AS ALERT-BOX ERROR.
      698       UNDO main-block, RETURN ERROR.
      699     END.
      700     IF par-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
      701       CREATE tt-wth-ser.
      702         IF pwth-code <> 0  THEN do:
      703           FIND FIRST LOCKED_wealth EXCLUSIVE-LOCK WHERE
      704                    LOCKED_wealth.wth-code = pwth-code NO-ERROR.
      705           IF NOT AVAILABLE LOCKED_wealth THEN DO:
      706               message vss-workfile vss-revision vss-description skip
      707               "Не найдена материальная ценность с кодом " pwth-code
      708               view-as alert-box error.
      709               return error.
      710           END.
      711           tt-wth-ser.wth-code = LOCKED_wealth.wth-code.
      712             IF ppar-code <> 0  THEN do:
      713               FIND FIRST LOCKED_wth-par EXCLUSIVE-LOCK WHERE
      714                        LOCKED_wth-par.wth-code = pwth-code
      715                   AND  LOCKED_wth-par.par-code = ppar-code NO-ERROR.
      716               IF NOT AVAILABLE LOCKED_wth-par THEN DO:
      717                   message vss-workfile vss-revision vss-description skip
      718                   "Не найдена материальная ценность с кодом " ppar-code
      719                   view-as alert-box error.
      720                   return error.
      721               END.
      722               tt-wth-ser.par-code = LOCKED_wth-par.par-code.
      723             END.
      724         END.
      725     END.
      726     ELSE DO:
      727        IF par-mode = 'ПРОСМОТР':U THEN DO:
      728          FIND FIRST LOCKED_wth-ser NO-LOCK WHERE
      729                   LOCKED_wth-ser.ser-code = pser-code
      730              AND  LOCKED_wth-ser.db-num = pdb-num NO-ERROR.
      731        END.
      732        ELSE DO:
      733            FIND FIRST LOCKED_wth-ser exclusive-LOCK WHERE
      734                   LOCKED_wth-ser.ser-code = pser-code
      735              AND  LOCKED_wth-ser.db-num = pdb-num NO-ERROR.
      736        END.
      737        IF NOT AVAILABLE LOCKED_wth-ser THEN DO:
      738           MESSAGE
      739           SUBSTITUTE("Не найден номинал с кодом &1 для МЦ с  кодом &2", ppar-code, pwth-code)
      740           VIEW-AS ALERT-BOX ERROR.
      741           UNDO main-block, RETURN ERROR.
      742       END.
      743       IF par-mode = 'ПРОСМОТР':U THEN DO:
      744          FIND FIRST LOCKED_wealth NO-LOCK WHERE
      745                   LOCKED_wealth.wth-code = LOCKED_wth-ser.wth-code NO-ERROR.
      746        END.
      747        ELSE DO:
      748            FIND FIRST LOCKED_wealth exclusive-LOCK WHERE
      749                       LOCKED_wealth.wth-code = LOCKED_wth-ser.wth-code NO-ERROR.
      750        END.
      751        IF NOT AVAILABLE LOCKED_wealth THEN DO:
      752           MESSAGE
      753           SUBSTITUTE("Не найдена МЦ с кодом &1 ",LOCKED_wth-ser.wth-code)
      754           VIEW-AS ALERT-BOX ERROR.
      755           UNDO main-block, RETURN ERROR.
      756       END.
      757       IF par-mode = 'ПРОСМОТР':U THEN DO:
      758          FIND FIRST LOCKED_wth-par NO-LOCK WHERE
      759                   LOCKED_wth-par.par-code = LOCKED_wth-ser.par-code
      760              AND  LOCKED_wth-par.wth-code = LOCKED_wth-ser.wth-code          NO-ERROR.
      761        END.
      762        ELSE DO:
      763            FIND FIRST LOCKED_wth-par exclusive-LOCK WHERE
      764               LOCKED_wth-par.par-code = LOCKED_wth-ser.par-code
      765               AND  LOCKED_wth-par.wth-code = LOCKED_wth-ser.wth-code            NO-ERROR.
      766        END.
      767        IF NOT AVAILABLE LOCKED_wth-par THEN DO:
      768           MESSAGE
      769           SUBSTITUTE("Не найден номинал с кодом &1 для МЦ с  кодом &2", LOCKED_wth-ser.par-code,  LOCKED_wth-ser.wth-code)
      770           VIEW-AS ALERT-BOX ERROR.
      771           UNDO main-block, RETURN ERROR.
      772       END.
      773       CREATE tt-wth-ser.
      774       BUFFER-COPY LOCKED_wth-ser TO tt-wth-ser.
      775     END.
      776   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      777     run mainmenu_getcntxt in parparentproc
      778       (output v-cntxt-db-num
      779       ,output v-cntxt-userid
      780       ,output v-cntxt-level
      781       ,output v-cntxt-host-code-obj
      782       ,output v-cntxt-obj-type
      783       ,output v-cntxt-obj-code
      784       ,output v-cntxt-db-num-obj
      785       ,output v-cntxt-is-admin
      786       ) .
      787     RUN Myenable IN THIS-PROCEDURE NO-ERROR.
      788     WAIT-FOR GO OF FRAME Dialog-Frame.
      789   END.
      790   RUN disable_UI.
      791   PROCEDURE disable_UI :
      792     HIDE FRAME Dialog-Frame.
      793   END PROCEDURE.
      794   PROCEDURE enable_UI :
      795     OPEN QUERY Dialog-Frame FOR EACH tt-wth-ser SHARE-LOCK.
      796     GET FIRST Dialog-Frame.
      797     DISPLAY FILL-wth FILL-par
      798         WITH FRAME Dialog-Frame.
      799     IF AVAILABLE tt-wth-ser THEN
      800       DISPLAY tt-wth-ser.series tt-wth-ser.wth-code tt-wth-ser.par-code
      801             tt-wth-ser.maska tt-wth-ser.authr tt-wth-ser.range-rule
      802             tt-wth-ser.range-smb tt-wth-ser.chk-ser tt-wth-ser.ser-rule
      803             tt-wth-ser.ser-smb tt-wth-ser.chk-gds tt-wth-ser.gds-rule
      804             tt-wth-ser.gds-smb tt-wth-ser.chk-par tt-wth-ser.par-rule
      805             tt-wth-ser.par-smb tt-wth-ser.chk-bdt tt-wth-ser.beg-dt
      806             tt-wth-ser.beg-yy tt-wth-ser.beg-yy-smb tt-wth-ser.beg-mm
      807             tt-wth-ser.beg-dd tt-wth-ser.chk-edt tt-wth-ser.end-dt
      808             tt-wth-ser.end-yy tt-wth-ser.end-yy-smb tt-wth-ser.end-mm
      809             tt-wth-ser.end-dd tt-wth-ser.PS tt-wth-ser.ser-code
      810         WITH FRAME Dialog-Frame.
      811     ENABLE RECT-2 RECT-3 B-exit b-quit B-hist B-Help tt-wth-ser.series
      812            tt-wth-ser.par-code tt-wth-ser.range-rule tt-wth-ser.range-smb
      813            tt-wth-ser.PS tt-wth-ser.ser-code FILL-wth FILL-par
      814         WITH FRAME Dialog-Frame.
      815     VIEW FRAME Dialog-Frame.
      816   END PROCEDURE.
      817   PROCEDURE MyEnable :
      818   ENABLE
      819   B-exit WHEN par-mode <> 'ПРОСМОТР':U
      820   b-quit
      821   B-Help
      822   b-hist WHEN par-mode = 'ИЗМЕНЕНИЕ':U OR par-mode = 'ПРОСМОТР':U
      823   WITH FRAME Dialog-Frame.
      824   IF par-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
      825       ENABLE
      826       tt-wth-ser.series
      827       tt-wth-ser.wth-code when not available locked_wealth
      828       tt-wth-ser.par-code when not available locked_wth-par
      829       b-wth when not available locked_wealth
      830       b-par when not available locked_wth-par
      831       WITH FRAME Dialog-Frame.
      832       tt-wth-ser.authr = 1.
      833       tt-wth-ser.chk-ser = 1.
      834   END.
      835   DISPLAY
      836      tt-wth-ser.series tt-wth-ser.wth-code tt-wth-ser.par-code tt-wth-ser.maska tt-wth-ser.authr tt-wth-ser.range-rule tt-wth-ser.range-smb tt-wth-ser.chk-ser tt-wth-ser.ser-rule tt-wth-ser.ser-smb tt-wth-ser.chk-gds tt-wth-ser.gds-rule tt-wth-ser.gds-smb tt-wth-ser.chk-par tt-wth-ser.par-rule tt-wth-ser.par-smb tt-wth-ser.chk-bdt tt-wth-ser.beg-dt tt-wth-ser.beg-yy tt-wth-ser.beg-yy-smb tt-wth-ser.beg-mm tt-wth-ser.beg-dd tt-wth-ser.chk-edt tt-wth-ser.end-dt tt-wth-ser.end-yy tt-wth-ser.end-yy-smb tt-wth-ser.end-mm tt-wth-ser.end-dd tt-wth-ser.PS tt-wth-ser.ser-code
      837   WITH FRAME Dialog-Frame  .
      838   VIEW FRAME Dialog-Frame.
      839   IF par-mode = 'ДОБАВЛЕНИЕ':U or par-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
      840       ENABLE
      841       tt-wth-ser.chk-ser
      842       tt-wth-ser.chk-par
      843       tt-wth-ser.chk-gds
      844       tt-wth-ser.chk-edt
      845       tt-wth-ser.chk-bdt
      846       tt-wth-ser.range-smb
      847       tt-wth-ser.range-rule
      848       tt-wth-ser.authr
      849       tt-wth-ser.maska
      850       tt-wth-ser.PS
      851       tt-wth-ser.series
      852    WITH FRAME Dialog-Frame.
      853       APPLY "VALUE-CHANGED":U TO tt-wth-ser.chk-ser .
      854       APPLY "VALUE-CHANGED":U TO tt-wth-ser.chk-par.
      855       APPLY "VALUE-CHANGED":U TO tt-wth-ser.chk-gds .
      856       APPLY "VALUE-CHANGED":U TO tt-wth-ser.chk-edt.
      857       APPLY "VALUE-CHANGED":U TO tt-wth-ser.chk-bdt.
      858   END.
      859   IF AVAILABLE LOCKED_wealth THEN fill-wth:SCREEN-VALUE = LOCKED_wealth.wth-name.
      860   IF AVAILABLE LOCKED_wth-par THEN fill-par:SCREEN-VALUE = string(LOCKED_wth-par.par-val).
      861   IF par-mode = 'ПРОСМОТР':U THEN DO:
      862     HIDE
      863     b-exit IN FRAME Dialog-Frame
      864     .
      865     ASSIGN
      866     b-quit:COLUMN = 1
      867     b-quit:LABEL = "&Выход".
      868   END.
      869   frame Dialog-Frame:title = substitute("Серия номинала &1 &4 материальной ценности &2  &3"
      870                                        ,if available LOCKED_wth-par then string (LOCKED_wth-par.par-val) else ""
      871                                        ,if available locked_wealth then locked_wealth.wth-name else ""
      872                                        ,par-mode
      873                                        ,if available LOCKED_wth-par then LOCKED_wth-par.par-unit else ""
      874                                         ).
      875   APPLY 'entry':U TO tt-wth-ser.series.
      876   END PROCEDURE.
      877   PROCEDURE proc-save :
      878   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
      879   IF par-mode = 'ПРОСМОТР':U THEN UNDO, RETURN ERROR.
      880   assign
      881   FRAME Dialog-Frame tt-wth-ser.series tt-wth-ser.wth-code tt-wth-ser.par-code tt-wth-ser.maska tt-wth-ser.authr tt-wth-ser.range-rule tt-wth-ser.range-smb tt-wth-ser.chk-ser tt-wth-ser.ser-rule tt-wth-ser.ser-smb tt-wth-ser.chk-gds tt-wth-ser.gds-rule tt-wth-ser.gds-smb tt-wth-ser.chk-par tt-wth-ser.par-rule tt-wth-ser.par-smb tt-wth-ser.chk-bdt tt-wth-ser.beg-dt tt-wth-ser.beg-yy tt-wth-ser.beg-yy-smb tt-wth-ser.beg-mm tt-wth-ser.beg-dd tt-wth-ser.chk-edt tt-wth-ser.end-dt tt-wth-ser.end-yy tt-wth-ser.end-yy-smb tt-wth-ser.end-mm tt-wth-ser.end-dd tt-wth-ser.PS tt-wth-ser.ser-code.
      882   if  par-mode = 'ИЗМЕНЕНИЕ':U then v-rec = recid(locked_wth-ser).
      883   run ref/wth-ser.p ( INPUT par-mode
      884                       , tt-wth-ser.ser-code
      885                       , tt-wth-ser.db-num
      886                       , tt-wth-ser.maska
      887                       , tt-wth-ser.series
      888                       , tt-wth-ser.authr
      889                       , tt-wth-ser.wth-code
      890                       , tt-wth-ser.par-code
      891                       , tt-wth-ser.beg-dd
      892                       , tt-wth-ser.beg-dt
      893                       , tt-wth-ser.beg-mm
      894                       , tt-wth-ser.beg-yy-smb
      895                       , tt-wth-ser.beg-yy
      896                       , tt-wth-ser.chk-bdt
      897                       , tt-wth-ser.chk-edt
      898                       , tt-wth-ser.chk-gds
      899                       , tt-wth-ser.chk-par
      900                       , tt-wth-ser.chk-ser
      901                       , tt-wth-ser.end-dd
      902                       , tt-wth-ser.end-dt
      903                       , tt-wth-ser.end-mm
      904                       , tt-wth-ser.end-yy-smb
      905                       , tt-wth-ser.end-yy
      906                       , tt-wth-ser.gds-rule
      907                       , tt-wth-ser.gds-smb
      908                       , tt-wth-ser.par-rule
      909                       , tt-wth-ser.par-smb
      910                       , tt-wth-ser.PS
      911                       , tt-wth-ser.qnty
      912                       , tt-wth-ser.range-rule
      913                       , tt-wth-ser.range-smb
      914                       , tt-wth-ser.ser-rule
      915                       , tt-wth-ser.ser-smb
      916                       ,INPUT NO
      917                       ,INPUT-OUTPUT v-rec  ) no-error .
      918   if error-status:error then do:
      919   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      920   define variable fh as widget-handle no-undo .
      921   define variable hh as widget-handle no-undo .
      922   define variable rv as character no-undo .
      923   assign
      924   rv = entry(1, return-value , chr(4)).
      925   if rv <> "":U then do:
      926     assign
      927     fh = frame Dialog-Frame:first-child
      928     hh = fh:first-child
      929     .
      930     do while valid-handle(hh):
      931       if hh:name = rv then do:
      932         APPLY "ENTRY" to hh.
      933         undo ,
      934         return error.
      935       end.
      936       hh = hh:next-sibling.
      937     end.
      938   end.
      939     undo, return error.
      940   end.
      941   p-rec = v-rec.
      942   END PROCEDURE.
