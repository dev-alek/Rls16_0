        1   def input  param mode as char no-undo.
        2   def input  param n-c  like ub.gds-prt.node-code no-undo.
        3   def output param rid  as recid init ? no-undo.
        4   define variable vss-revision    as character no-undo initial "$Revision$":U .
        5   define variable vss-author      as character no-undo initial "$Author$":U .
        6   define variable vss-date        as character no-undo initial "$Date$":U .
        7   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        8   define variable vss-archive     as character no-undo initial "$Archive$":U .
        9   define variable vss-description as character no-undo initial "Редактирование шкалы признаков".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   procedure proc-alt-shift-f2:
       80     if not ibs.th.gbl.gbl-var:rcode
       81   then
       82     run gbl\inidebug.p .
       83   end.
       84   procedure proc-alt-shift-f3:
       85     run gbl/prvssinf.p
       86       ( input this-procedure
       87       ) .
       88   end.
       89   define variable v-inform-launched as logical no-undo initial false .
       90   procedure proc-alt-shift-f4:
       91     define variable v-action as character no-undo .
       92     if v-inform-launched = false then do:
       93       assign
       94         v-inform-launched = true
       95       .
       96       run gbl/d-inform.w
       97         (  input self
       98         ,  input this-procedure
       99         , output v-action
      100         ) no-error .
      101       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      102       assign
      103         v-inform-launched = false
      104       .
      105     end.
      106   end.
      107   procedure proc-alt-f1:
      108     run gbl/corrhelp.p
      109       (input this-procedure
      110       ) .
      111   end .
      112   on alt-shift-f2 anywhere do:
      113     run proc-alt-shift-f2.
      114   end.
      115   on alt-shift-f3 anywhere do:
      116     run proc-alt-shift-f3 in this-procedure .
      117   end.
      118   on alt-shift-f4 anywhere do:
      119     run proc-alt-shift-f4 in this-procedure.
      120   end.
      121   on alt-f1 anywhere do:
      122     run proc-alt-f1 in this-procedure .
      123   end.
      124   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      126   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      127   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      128   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      129   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      130   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      131   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      132   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      133   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      134   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      135   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      136   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      137   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      138   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      139   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      140   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      141   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      142   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      143   define variable v-waitfram-action01         as character   no-undo .
      144   define variable v-waitfram-action02         as character   no-undo .
      145   define variable v-waitfram-action03         as character   no-undo .
      146   define variable mWaitFramTextBeg            as character   no-undo.
      147   define variable mWaitFramTextEnd            as character   no-undo.
      148   define variable mWaitFramView               as logical     no-undo.
      149   define variable mWaitProcEvent              as logical     no-undo init yes.
      150   define variable mWaitFramInterval           as integer     no-undo init 1 .
      151   define variable mWaitFramStop               as logical     no-undo.
      152   define variable mWaitFramStopUser           as logical     no-undo.
      153   define variable mWaitFramStopTimeOut        as logical     no-undo.
      154   define variable mWaitFramStartProc          as datetime-tz no-undo.
      155   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      156   define button B-WaitFramStop auto-end-key
      157        label "Стоп"
      158        size 10 by 1 tooltip "Остоновить процесс".
      159   define button B-viewProcInfo
      160        label "Информация"
      161        size 15 by 1 tooltip "Информация о процесс".
      162   define frame waitfram
      163     v-waitfram-action01 format "x(72)" no-label skip
      164     v-waitfram-action02 format "x(72)" no-label skip
      165     v-waitfram-action03 format "x(72)" no-label skip
      166     B-viewProcInfo
      167     B-WaitFramStop at row 4 col 30
      168     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      169     .
      170   define new global shared variable mBatchMode as logical no-undo init ?.
      171   define variable mFramBachModHandle as handle no-undo.
      172   mFramBachModHandle = frame waitfram:handle.
      173   define variable mFameOldVis as logical no-undo.
      174   define variable mVisCUrentVin as logical no-undo.
      175   if session:batch-mode
      176   then
      177      mBatchMode = yes.
      178   if mBatchMode = ? then do:
      179     mVisCUrentVin = current-window:visible.
      180     mFameOldVis = mFramBachModHandle:visible.
      181     mFramBachModHandle:visible  = yes.
      182     mBatchMode = mFramBachModHandle:visible ne yes.
      183     mFramBachModHandle:visible = mFameOldVis.
      184     current-window:visible = mVisCUrentVin.
      185   end.
      186    if  log-manager:logfile-name ne ?
      187     then DO:
      188         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      189         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      190         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      191     end.
      192   on choose of B-WaitFramStop in frame waitfram
      193   do:
      194     mWaitFramStop = yes.
      195     mWaitFramStopUser = yes.
      196   end.
      197   function waitfram-check-timeout returns logical():
      198      define variable vtime as int64 no-undo.
      199      if mWaitFramStopTimeOut
      200      then
      201         return yes.
      202      vtime = ( now - mWaitFramStartProc ) / 1000 .
      203      if     mWaitFramTimeOut ne ?
      204         and mWaitFramTimeOut ne 0
      205         and mWaitFramTimeOut lt vtime
      206      then do:
      207         mWaitFramStopTimeOut = yes.
      208      end.
      209      return mWaitFramStopTimeOut.
      210   end.
      211   procedure waitfram-hide :
      212     if not session:batch-mode
      213     then do
      214     on error undo, return error return-value
      215     :
      216       pause 0 before-hide .
      217       if not mBatchMode then
      218         hide frame waitfram .
      219     if     not mWaitFramView
      220        and mWaitProcEvent
      221     then
      222       process events .
      223     end.
      224   end procedure.
      225   procedure waitfram-show :
      226     define input  parameter p-message as character no-undo .
      227     define variable v-left-margin as integer   no-undo .
      228     if not session:batch-mode
      229     then do
      230     on error undo, return error return-value
      231     :
      232       if length(p-message) <= 70 then do:
      233         assign
      234           v-left-margin = integer((70 - length(p-message)) / 2)
      235         .
      236         assign
      237           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      238         .
      239         assign
      240           v-waitfram-action01 = " "
      241           v-waitfram-action02 = " "
      242                                    + fill(" ", v-left-margin)
      243                                    + p-message
      244           v-waitfram-action03 = " "
      245         .
      246       end.
      247       else do:
      248         define variable vRindex1 as integer no-undo.
      249         define variable vRindex2 as integer no-undo.
      250         vRindex1 = r-index(p-message," ",70).
      251         if vRindex1 = 0
      252         then
      253            vRindex1 = 70.
      254         if length(p-message)  <= vRindex1 + 70 then do:
      255           assign
      256             v-waitfram-action01 = " "
      257             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      258             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      259           .
      260         end.
      261         else do:
      262           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      263           if vRindex2 <= vRindex1
      264           then
      265              vRindex2 = vRindex1 + 70.
      266           assign
      267             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      268             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      269             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      270           .
      271         end.
      272       end.
      273       B-viewProcInfo:visible   in frame waitfram = no.
      274       B-viewProcInfo:sensitive in frame waitfram = no.
      275       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      276       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      277       if  (   mWaitFramView
      278          or  mWaitProcEvent)
      279          and not mBatchMode
      280       then
      281          display
      282             v-waitfram-action01 skip
      283             v-waitfram-action02 skip
      284             v-waitfram-action03 skip
      285          with frame waitfram .
      286       if     mWaitFramView
      287          then do:
      288             if     mWaitFramInterval ne ?
      289                and not mBatchMode
      290             then
      291                wait-for go of frame waitfram pause mWaitFramInterval.
      292          end.
      293          else
      294             if     mWaitProcEvent
      295                and not mBatchMode
      296             then
      297                process events .
      298     end.
      299   end procedure.
      300      procedure waitfram-show-this:
      301         define input  parameter iInterval as int64 no-undo.
      302         define variable vtime as int64 no-undo.
      303         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      304         mWaitFramInterval = iInterval.
      305         run waitfram-show (substitute("&1&2 &3&4" ,
      306                                       mWaitFramTextBeg ,
      307                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      308                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      309                                       mWaitFramTextEnd
      310                                      )
      311                           ).
      312      end.
      313      procedure WaitFramRunPause:
      314         define input  parameter iInterval as dec no-undo.
      315         define variable vStart  as datetime-tz no-undo.
      316         define variable vend    as datetime-tz no-undo.
      317         define variable vint as int64 no-undo.
      318         define variable vOk as logical no-undo.
      319         vStart = now.
      320         vend   = vStart.
      321         publish "WaitFramPause" (iInterval,output vOk).
      322         vend   =  now.
      323         vint = vend - vStart.
      324         vint = iInterval - vint / 1000.
      325         if     not mWaitFramStop
      326            and (   vint > 0
      327                 or (    not vOk
      328                     and iInterval eq ?
      329                     )
      330                 )
      331         then
      332            run waitfram-show-this (iInterval).
      333         vend   =  now.
      334         vint = vend - vStart.
      335         vint = iInterval - vint / 1000.
      336         if     not mWaitFramStop
      337            and vint > 0
      338         then do:
      339            run gbl/pause.p (vint * 1000).
      340         end.
      341         if iInterval ne ?
      342         then
      343            publish "WaitFramStop".
      344         waitfram-check-timeout().
      345      end.
      346      procedure WaitFramWaitFor:
      347         define input  parameter iInterval as dec no-undo.
      348         assign
      349            mWaitFramStartProc   = now
      350            mWaitFramStopUser    = no
      351            mWaitFramStopTimeOut = no
      352         .
      353         block-wait:
      354         do while not mWaitFramStop:
      355            run WaitFramRunPause (iInterval).
      356            if  waitfram-check-timeout()
      357            then do:
      358               leave block-wait.
      359            end.
      360         end.
      361         run waitfram-hide.
      362      end.
      363   procedure waitfram-join :
      364     define input  parameter p-line-1  as character no-undo .
      365     define input  parameter p-line-2  as character no-undo .
      366     define input  parameter p-line-3  as character no-undo .
      367     define output parameter p-message as character no-undo .
      368     do
      369     on error undo, return error return-value
      370     :
      371       assign
      372         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      373                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      374                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      375       .
      376     end.
      377   end procedure.
      378   function waitfram-join-function returns character
      379     (input p-line-1 as character
      380     ,input p-line-2 as character
      381     ,input p-line-3 as character
      382     ).
      383     define variable v-message as character no-undo .
      384     run waitfram-join in this-procedure
      385       (input  p-line-1
      386       ,input  p-line-2
      387       ,input  p-line-3
      388       ,output v-message
      389       ) .
      390     return v-message .
      391   end function .
      392   def var sc-name like ub.gds-prt.node-name format "x(40)" label "Название шкалы" no-undo.
      393   def var ld-n     as int no-undo.
      394   def var prt_root as int no-undo.
      395   def var v-ind    as integer no-undo .
      396   define variable v-ok as logical   no-undo .
      397   def temp-table ld no-undo
      398       field num  as integer
      399       field ord  as integer
      400       field name like ub.gds-prt.node-name
      401       index num is primary unique num .
      402   def temp-table nd no-undo
      403       field num  as integer
      404       field ord  as integer
      405       field name format "x(16)" like ub.gds-prt.node-name
      406       field new_ as logical init yes
      407       index num  is primary unique num ord.
      408   def query ld for ld .
      409   def browse ld query ld
      410          disp ld.name
      411          with size 13 by 10 no-labels title "Уровни" separators .
      412   def query nd for nd .
      413   def browse nd query nd
      414          disp nd.name
      415          with size 19 by 10 no-labels title "Признаки" separators .
      416   def button b-ok auto-go default
      417        LABEL "&Ввод"
      418        SIZE 10 BY 1.
      419   def button b-cancel  auto-endkey
      420       label "&Отмена"
      421        SIZE 10 BY 1.
      422   def button b-help
      423       label "Помо&щь"
      424        SIZE 10 BY 1.
      425   def button b-add-ld
      426       label "Добав"
      427        SIZE 8 BY 1.
      428   def button b-upd-ld
      429       label "Изм"
      430        SIZE 8 BY 1.
      431   def button b-del-ld
      432       label "Удал"
      433        SIZE 8 BY 1.
      434   def button b-ld-up
      435       label "Перест"
      436        SIZE 8 BY 1.
      437   def button b-add-nd
      438       label "Добав"
      439        SIZE 8 BY 1.
      440   def button b-upd-nd
      441       label "Изм"
      442        SIZE 8 BY 1.
      443   def button b-del-nd
      444       label "Удал"
      445        SIZE 8 BY 1.
      446   def button b-nd-up
      447       label "Перест"
      448        SIZE 8 BY 1.
      449   def frame td
      450   b-ok at row 1 col 1
      451   b-cancel at row 1 col 11
      452   b-help at row 1 col 21
      453   sc-name at row 2.5 col 5
      454   ld at row 4 col 11
      455   nd at row 4 col 47
      456   b-add-ld at row 14.5 col 2
      457   b-upd-ld at row 14.5 col 10
      458   b-del-ld at row 14.5 col 18
      459   b-ld-up at row 14.5 col 26
      460   b-add-nd at row 14.5 col 38
      461   b-upd-nd at row 14.5 col 46
      462   b-del-nd at row 14.5 col 54
      463   b-nd-up at row 14.5 col 62
      464   with view-as dialog-box scrollable side-labels three-d default-button b-ok
      465   title "".
      466   on row-display of nd do:
      467     if available nd
      468     and nd.new_ then do:
      469       assign
      470         name :fgcolor in browse nd = RED_COLOR .
      471       .
      472     end.
      473     else do:
      474       assign
      475         name :fgcolor in browse nd = BLACK_COLOR .
      476       .
      477     end.
      478   end.
      479   on choose of b-ld-up do:
      480       def var h1 as int no-undo.
      481       def var h2 as int no-undo.
      482       def var r as recid no-undo.
      483       if not available ld then do:
      484         return no-apply.
      485       end.
      486       assign
      487         r = recid(ld)
      488         h1 = ld.num
      489       .
      490       get prev  ld.
      491       if not available ld then do:
      492         return no-apply.
      493       end.
      494       assign
      495         h2 = ld.num
      496         ld.num = -2
      497       .
      498       find ld where recid( ld ) = r.
      499       assign
      500         ld.num  = h2
      501       .
      502       find ld where ld.num = -2 .
      503       assign
      504         ld.num  = h1
      505       .
      506       for each nd
      507         where nd.num = h2
      508       :
      509         assign
      510           nd.num = -2
      511         .
      512       end.
      513       for each nd
      514       where nd.num = h1
      515       :
      516         assign
      517           nd.num = h2
      518         .
      519       end.
      520       for each nd
      521         where nd.num = - 2
      522       :
      523         assign
      524           nd.num = h1
      525         .
      526       end.
      527       open query ld for each ld.
      528       reposition ld to recid r.
      529       define variable v-ok as logical   no-undo .
      530       assign
      531         v-ok = ld:select-focused-row( )
      532       .
      533       apply "value-changed":U to ld.
      534   end.
      535   on choose of b-nd-up do:
      536     def var r1    as recid     no-undo .
      537     def var h1    as integer   no-undo .
      538     def var name1 as character no-undo .
      539     def var r2    as recid     no-undo .
      540     def var h2    as integer   no-undo .
      541     def var name2 as character no-undo .
      542     if not available nd then do:
      543       return no-apply .
      544     end.
      545     if nd.new_ <> true then do:
      546       message
      547         "Нельзя менять порядок уже созданных признаков" skip
      548         view-as alert-box information .
      549       return no-apply .
      550     end.
      551     assign
      552       r1    = recid(nd)
      553       h1    = nd.ord
      554       name1 = nd.name
      555     .
      556     get prev  nd.
      557     if not available nd then do:
      558       return no-apply.
      559     end.
      560     if nd.new_ <> true then do:
      561       message
      562         "Нельзя менять порядок уже созданных признаков" skip
      563         "Нельзя поменять местами признаки" name1 "и" nd.name skip
      564         view-as alert-box information .
      565       find nd where recid( nd ) = r1.
      566       return no-apply .
      567     end.
      568     assign
      569       r2    = recid(nd)
      570       h2    = nd.ord
      571       name2 = nd.name
      572     .
      573     find nd where recid( nd ) = r1.
      574     assign
      575       nd.ord = ?
      576     .
      577     find nd where recid( nd ) = r2.
      578     assign
      579       nd.ord = h1
      580     .
      581     find nd where recid( nd ) = r1.
      582     assign
      583       nd.ord = h2
      584     .
      585     open query nd for each nd where nd.num = ld.num.
      586     reposition nd to recid r1.
      587     define variable v-ok as logical   no-undo .
      588     assign
      589       v-ok = nd :select-focused-row( )
      590     .
      591   end.
      592   on go of frame td do:
      593     def var ind  as integer no-undo init 0 .
      594     def var max_ as integer no-undo init 0 .
      595     def var j    as integer no-undo .
      596     if sc-name :screen-value = "" then do:
      597       message
      598         "Введите название шкалы."
      599         view-as alert-box error.
      600       apply "ENTRY":U to sc-name.
      601       return no-apply.
      602     end.
      603     if can-find (ub.gds-prt where
      604                 ub.gds-prt.root = yes AND
      605                 ub.gds-prt.node-name = sc-name:screen-value no-lock) and
      606       (mode = 'ДОБАВЛЕНИЕ':U or
      607         mode = 'КОПИРОВАНИЕ':U) then do:
      608       message
      609         "Шкала с таким названием уже есть."
      610         view-as alert-box error.
      611       apply "ENTRY":U to sc-name.
      612       return no-apply.
      613     end.
      614     for each ld
      615     :
      616       accumulate ld (count).
      617       if not can-find (first nd where nd.num = ld.num) then do:
      618         message
      619           "На уровне" ld.name skip
      620           "нет признаков."
      621           view-as alert-box error.
      622         return no-apply.
      623       end.
      624     end.
      625     if (accum count ld) = 0 then do:
      626       message
      627         "В шкале не задан ни один из уровней." skip
      628         "В системе может быть только одна пустая шкала." skip
      629         view-as alert-box error.
      630       return no-apply.
      631     end.
      632     for each ld
      633     :
      634       for each nd
      635         where nd.num = ld.num
      636       :
      637         assign
      638           nd.num = ind
      639         .
      640       end.
      641       assign
      642         ld.num = ind
      643         ind    = ind + 1
      644       .
      645     end.
      646     if mode = 'ИЗМЕНЕНИЕ':U then do:
      647       find ub.gds-prt
      648         where ub.gds-prt.node-code = n-c
      649         .
      650       for each ld
      651       :
      652         find last nd
      653           where nd.num = ld.num
      654           use-index num .
      655         assign
      656           max_ = nd.ord
      657           j = 0
      658         .
      659         for each nd
      660           where nd.num = ld.num
      661             and nd.ord <= max_
      662           by nd.ord
      663         :
      664           assign
      665             j = j + 1
      666             nd.ord = max_ + j
      667           .
      668         end.
      669       end.
      670     end.
      671     run create-scale no-error.
      672     if error-status :error then do:
      673       return no-apply.
      674     end.
      675   end.
      676   on choose of b-add-ld do:
      677       def var rr as recid no-undo.
      678       run add-ld( output rr ).
      679       if rr <> ? then do:
      680          open query ld for each ld.
      681          reposition ld to recid rr.
      682          apply "value-changed":U to ld.
      683          define variable v-ok as logical   no-undo .
      684          assign
      685            v-ok = ld :select-focused-row( )
      686          .
      687       end.
      688   end.
      689   on choose of b-add-nd do:
      690       def var rr as recid no-undo.
      691       if not available ld THEN return no-apply.
      692       run add-nd( output rr ).
      693       if rr <> ? then do:
      694          open query nd for each nd where nd.num = ld.num.       if available nd then do:        assign           v-ok = nd:select-focused-row ()         .       end.
      695       end.
      696   end.
      697   on choose of b-ok do:
      698       message "Закончить ввод шкалы?" view-as alert-box question buttons yes-no
      699                        set OK as log .
      700       if not OK THEN return no-apply.
      701   end.
      702   on choose of b-del-nd do:
      703       def var  r as recid no-undo.
      704       def var  rr as recid no-undo.
      705       if not available nd THEN return.
      706       if nd.new_ <> true then do:
      707         message
      708           "Нельзя удалять уже созданный признак" skip
      709           view-as alert-box information .
      710         return .
      711       end.
      712        message "Удалить признак?" view-as alert-box question buttons yes-no
      713                         set OK as log .
      714        if not OK THEN return no-apply.
      715        r = recid( nd ).
      716        get prev nd.
      717        rr = recid( nd ).
      718        find nd where recid( nd )  = r.
      719        delete nd .
      720        open query nd for each nd where nd.num = ld.num.
      721        reposition nd to recid rr no-error.
      722        define variable v-ok as logical   no-undo .
      723        if available nd then do:
      724          assign
      725            v-ok = nd :select-focused-row() .
      726          .
      727        end.
      728   end.
      729   on choose of b-del-ld do:
      730        def var  r as recid no-undo.
      731        def var  rr as recid no-undo.
      732        if not available ld THEN return no-apply.
      733        message "Удалить признак?" view-as alert-box question buttons yes-no
      734                         set OK as log .
      735        if not OK THEN return no-apply.
      736        r = recid( ld ).
      737        get prev ld.
      738        rr = recid( ld ).
      739        find ld where recid( ld )  = r.
      740        for each nd where nd.num = ld.num:
      741            delete nd.
      742        end.
      743        delete ld .
      744        open query ld for each ld.
      745        reposition ld to recid rr no-error.
      746        define variable v-ok as logical   no-undo .
      747        if available ld then do:
      748          assign
      749            v-ok = ld:select-focused-row()
      750          .
      751        end.
      752        apply "value-changed":U to ld.
      753   end.
      754   on choose of b-upd-ld do:
      755       run upd-ld.
      756   end.
      757   on choose of b-upd-nd do:
      758       if not available nd THEN return.
      759       run upd-nd.
      760   end.
      761   ON WINDOW-CLOSE OF FRAME td APPLY "END-ERROR":U TO SELF.
      762   on value-changed of ld in frame td do:
      763        open query nd for each nd where nd.num = ld.num.       if available nd then do:        assign           v-ok = nd:select-focused-row ()         .       end.
      764   end.
      765   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      766   on help of frame td
      767   do:
      768     run gbl/app_help.p
      769       (input this-procedure :file-name
      770       ,input ''
      771       ,input ?
      772       ) no-error.
      773     if error-status :error then do:
      774       message
      775         "Ошибка при вызове помощи"
      776         error-status :get-message(1)
      777         view-as alert-box .
      778     end.
      779   end.
      780   run minbtn-set in this-procedure .
      781   on choose of b-help in frame td
      782   do:
      783     apply "help":u to frame td .
      784   end.
      785   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      786   procedure minbtn-set :
      787       do
      788           on error undo, return error return-value
      789           :
      790           define variable ii              as integer       no-undo .
      791           define variable fh              as widget-handle no-undo .
      792           define variable hh              as widget-handle no-undo .
      793           define variable v-h             as handle        extent 4 no-undo .
      794           define variable v-name-button   as character     no-undo .
      795           define variable v-help-old-x    as decimal       no-undo .
      796           define variable v-help-old-y    as decimal       no-undo .
      797           define variable v-help-old-size as decimal       no-undo .
      798           define variable v-frame-width   as decimal       no-undo .
      799           define variable jj              as integer       no-undo .
      800           do
      801               on error undo, return error
      802               :
      803               assign
      804                   v-frame-width = frame td:width - 0.3
      805                   fh            = frame td:first-child
      806                   hh            = fh:first-child
      807                   ii            = 1
      808                   .
      809               do while valid-handle(hh):
      810                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      811                   do:
      812                       case lc(hh:name) :
      813                           when "b-help" then
      814                               do:
      815                                   hh:load-image-up("cmp/b-help.bmp":u) .
      816                                   hh:load-image-down("cmp/b-help.bmp":u) .
      817                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      818                                   hh:TOOLTIP = "Помощь" .
      819                                   v-help-old-x = hh:column .
      820                                   v-help-old-y = hh:row    .
      821                                   v-help-old-size = hh:width .
      822                                   hh:width-chars = 2.5 .
      823                               end.
      824                           when "b-print" then
      825                               do:
      826                                   hh:load-image("cmp/b-print.bmp":u) .
      827                                   hh:TOOLTIP = "Печать" .
      828                                   v-h[ii] = hh:handle .
      829                                   ii = ii + 1 .
      830                                   hh:width-chars = 3 .
      831                               end.
      832                           when "b-history" or
      833                           when "b-hist" then
      834                               do:
      835                                   hh:load-image("cmp/b-hist.bmp":u) .
      836                                   hh:TOOLTIP = "История" .
      837                                   v-h[ii] = hh:handle .
      838                                   ii = ii + 1 .
      839                                   hh:width-chars = 3 .
      840                               end.
      841                           when "b-sch" then
      842                               do:
      843                                   hh:load-image("cmp/b-sch.bmp":u) .
      844                                   hh:TOOLTIP = "Установка Фильтра" .
      845                                   v-h[ii] = hh:handle .
      846                                   ii = ii + 1 .
      847                                   hh:width-chars = 3 .
      848                               end.
      849                           when "b-hist-user" then
      850                               do:
      851                                   hh:load-image("cmp/b-hist.bmp":u) .
      852                                   hh:TOOLTIP = "История пользователя" .
      853                                   ii = ii + 1 .
      854                               end.
      855                       end case.
      856                   end.
      857                   hh = hh:next-sibling.
      858               end.
      859               b-help:column = v-frame-width - b-help:width-chars.
      860               jj = 0.
      861               repeat ii = 4 to 1 by -1 :
      862                   if valid-handle (v-h[ii] ) then
      863                   do:
      864                       jj  = jj + 1 .
      865                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      866                       v-h[ii]:row    = v-help-old-y .
      867                   end.
      868               end.
      869           end.
      870       end.
      871   end procedure.
      872   frame td :title = "Шкала.                              " + mode.
      873   if mode = 'КОПИРОВАНИЕ':U or
      874      mode = 'ИЗМЕНЕНИЕ':U then do:
      875     find gds-prt where gds-prt.node-code = n-c.
      876     if gds-prt.node-name = '_Пустая шкала':U then do:
      877       message "Изменение пустой шкалы невозможно."
      878               view-as alert-box error.
      879       return.
      880     end.
      881     assign
      882       sc-name = gds-prt.node-name
      883       prt_root = gds-prt.upper-code
      884       .
      885     for each ub.lvl-name where ub.lvl-name.upper-code = ub.gds-prt.upper-code:
      886       create ld.
      887       assign
      888         ld.num = lvl-name.level
      889         ld.name = lvl-name.lvl-name
      890         .
      891     end.
      892     run prt-tree (n-c).
      893     disp sc-name with frame td.
      894   end.
      895   if mode = 'КОПИРОВАНИЕ':U or
      896      mode = 'ДОБАВЛЕНИЕ':U then
      897     enable b-add-ld b-del-ld b-upd-ld b-ld-up with frame td.
      898   open query ld for each ld.
      899   ld :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
      900   nd :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
      901   enable sc-name ld nd b-ok b-cancel b-help
      902          b-add-nd b-del-nd b-upd-nd b-nd-up
      903          with frame td.
      904   if available ld then do:
      905       v-ok = ld :select-focused-row() .
      906       apply "value-changed":U to ld.
      907   end.
      908   wait-for go of frame td.
      909   procedure prt-tree:
      910   def input param uc like ub.gds-prt.upper-code no-undo.
      911   def buffer b-g-p for ub.gds-prt.
      912   def var nc         as int no-undo.
      913   def var next-level as log no-undo.
      914   find first b-g-p where b-g-p.upper-code = uc.
      915   find ld where ld.num = b-g-p.lvl-num.
      916   assign
      917     ld.ord = 0
      918     nc = b-g-p.node-code
      919     .
      920   if can-find (first b-g-p where b-g-p.upper-code = nc) then
      921     next-level = yes.
      922   else
      923     next-level = no.
      924   for each b-g-p where b-g-p.upper-code = uc:
      925     if b-g-p.prt-num > ld.ord then
      926       ld.ord = b-g-p.prt-num.
      927     create nd.
      928     assign
      929       nd.num  = b-g-p.lvl-num
      930       nd.ord  = b-g-p.prt-num
      931       nd.name = b-g-p.node-name
      932       .
      933     if mode = 'ИЗМЕНЕНИЕ':U then
      934       nd.new_ = no.
      935   end.
      936   if next-level then
      937     run prt-tree (nc).
      938   end procedure.
      939   PROCEDURE create-nodes :
      940     define input parameter p-curr-level     like nd.num              no-undo .
      941     define input parameter p-upper-code     like ub.gds-prt.upper-code  no-undo .
      942     define input parameter p-prt-root       like ub.gds-prt.prt-root no-undo .
      943     define input parameter p-parent-f-name  like ub.gds-prt.f-name      no-undo .
      944     define input parameter p-max-level      as integer  no-undo .
      945     define input parameter p-subtree-create as logical  no-undo .
      946     define buffer buf_gds-prt  for ub.gds-prt .
      947     define buffer buf_goods    for ub.goods .
      948     define buffer buf_bar-code for ub.bar-code .
      949     define buffer cur-node     for nd .
      950     def var v-curr-f-name  as character no-undo.
      951     def var v-b-code like ub.bar-code.b-code no-undo .
      952     do
      953     on error undo, return error
      954     :
      955       for each cur-node
      956         where cur-node.num = p-curr-level
      957       on error undo, return error
      958       :
      959         if p-parent-f-name = "" then do:
      960           assign
      961             v-curr-f-name = cur-node.name
      962           .
      963         end.
      964         else do:
      965           assign
      966             v-curr-f-name = p-parent-f-name + "/" + cur-node.name
      967           .
      968         end.
      969         if cur-node.new_
      970         or p-subtree-create then do:
      971           assign
      972             v-ind = v-ind + 1
      973           .
      974           if p-curr-level = p-max-level
      975           and (v-ind mod 10 = 0)
      976           then do:
      977             run waitfram-show in this-procedure
      978               (input "Создаем узел шкалы: " + v-curr-f-name
      979               ).
      980           end.
      981           do transaction
      982           on error undo, return error
      983           :
      984             create buf_gds-prt.
      985             assign
      986               buf_gds-prt.lvl-num    = p-curr-level
      987               buf_gds-prt.upper-code = p-upper-code
      988               buf_gds-prt.node-code  = next-value (s-gds-prt, ub)
      989               buf_gds-prt.node-name  = cur-node.name
      990               buf_gds-prt.f-name     = v-curr-f-name
      991               buf_gds-prt.prt-num    = cur-node.ord
      992               buf_gds-prt.root       = false
      993               buf_gds-prt.prt-root   = p-prt-root
      994               buf_gds-prt.is-term    = (p-curr-level = p-max-level )
      995             .
      996           end.
      997         end.
      998         else do:
      999           if p-curr-level < p-max-level  then do:
     1000             find first buf_gds-prt no-lock
     1001               where buf_gds-prt.upper-code = p-upper-code
     1002                 and buf_gds-prt.node-name  = cur-node.name
     1003               .
     1004           end.
     1005         end.
     1006         if p-curr-level < p-max-level then do:
     1007           run create-nodes in this-procedure
     1008             (input cur-node.num + 1
     1009             ,input buf_gds-prt.node-code
     1010             ,input p-prt-root
     1011             ,input v-curr-f-name
     1012             ,input p-max-level
     1013             ,input cur-node.new_ or p-subtree-create
     1014             ) no-error.
     1015           if error-status :error then do:
     1016             undo, return error.
     1017           end.
     1018         end.
     1019       end.
     1020     end.
     1021   END PROCEDURE.
     1022   PROCEDURE create-scale :
     1023     do
     1024     on error undo, return error
     1025     :
     1026       def var v-max-level as integer no-undo .
     1027       assign
     1028         v-max-level = 0
     1029       .
     1030       for each ld
     1031       :
     1032         assign
     1033           v-max-level = v-max-level + 1
     1034         .
     1035       end.
     1036       if mode = 'ДОБАВЛЕНИЕ':U
     1037       or mode = 'КОПИРОВАНИЕ':U
     1038       then do:
     1039         create ub.gds-prt.
     1040         assign
     1041           ub.gds-prt.lvl-num    = 0
     1042           ub.gds-prt.upper-code = next-value (s-gds-prt, ub)
     1043           ub.gds-prt.node-code  = next-value (s-gds-prt, ub)
     1044           ub.gds-prt.node-name  = input frame td sc-name
     1045           ub.gds-prt.prt-num    = 0
     1046           ub.gds-prt.root       = true
     1047           ub.gds-prt.prt-root   = ub.gds-prt.upper-code
     1048           ub.gds-prt.is-term    = (ub.gds-prt.lvl-num = v-max-level)
     1049           rid                = recid (gds-prt)
     1050           prt_root           = ub.gds-prt.upper-code
     1051         .
     1052         for each ld :
     1053           create ub.lvl-name.
     1054           assign
     1055             ub.lvl-name.level      = ld.num
     1056             ub.lvl-name.lvl-name   = ld.name
     1057             ub.lvl-name.upper-code = ub.gds-prt.upper-code
     1058             .
     1059         end.
     1060       end.
     1061       assign
     1062         rid = recid (gds-prt)
     1063         ub.gds-prt.node-name = input frame td sc-name
     1064       .
     1065       run create-nodes
     1066         (input 0
     1067         ,input gds-prt.node-code
     1068         ,input gds-prt.prt-root
     1069         ,input ""
     1070         ,input v-max-level - 1
     1071         ,input false
     1072         ) no-error.
     1073       if error-status :error then do:
     1074         run waitfram-hide in this-procedure .
     1075         undo, return error .
     1076       end.
     1077       run waitfram-hide in this-procedure .
     1078     end.
     1079   END PROCEDURE.
     1080   PROCEDURE add-ld:
     1081      def output param ri as recid no-undo init ?.
     1082      def button b-ok  auto-go default  size 10 by 1
     1083          label "&Ввод ".
     1084      def button b-cancel  auto-endkey  size 10 by 1
     1085          label "&Отмена".
     1086       form  b-ok   at 1 b-cancel at 11 skip
     1087               ld.name  label "Название"
     1088               space( 0.2 ) skip( 0.2 )
     1089               space( 0.2 )
     1090               with frame add-ld three-d side-labels  view-as dialog-box default-button b-ok
     1091                        title "У Р О В Е Н Ь".
     1092       on window-close of frame add-ld apply "end-error" to self.
     1093       on go of frame add-ld do:
     1094           if input ld.name = "" then do:
     1095               message "Введите название" view-as alert-box.
     1096               return no-apply.
     1097           end.
     1098           if can-find( first ld where ld.name = input frame add-ld  ld.name ) then do:
     1099               message "Уровень" input ld.name "уже есть" view-as alert-box.
     1100               return no-apply.
     1101           end.
     1102           create ld.
     1103           assign ld-n = ld-n + 1
     1104                       ld.num  = ld-n
     1105                       ld.name
     1106                       ri = recid( ld ).
     1107       end.
     1108       enable  ld.name b-ok b-cancel with frame add-ld.
     1109       wait-for go of frame add-ld.
     1110   END PROCEDURE.
     1111   PROCEDURE add-nd:
     1112      def output param ri as recid no-undo init ?.
     1113      def button b-ok  auto-go default size 10 by 1
     1114          label "&Ввод".
     1115      def button b-cancel  auto-endkey size 10 by 1
     1116          label "&Отмена".
     1117       form b-ok  at 1 b-cancel at 11
     1118               skip
     1119               nd.name label "Название"
     1120               space( 0.2 ) skip( 0.2 )
     1121               space( 0.2 )
     1122               with frame add-nd three-d side-labels  view-as dialog-box default-button b-ok
     1123                      title "П Р И З Н А К".
     1124       on window-close of frame add-nd apply "end-error" to self.
     1125       on go of frame add-nd do:
     1126           if input nd.name = "" then do:
     1127               message "Введите название" view-as alert-box.
     1128               return no-apply.
     1129           end.
     1130           if can-find( first nd where nd.num = ld.num
     1131                                            AND nd.name = input frame add-nd  nd.name ) then do:
     1132               message "Признак" input nd.name "уже есть" view-as alert-box.
     1133               return no-apply.
     1134           end.
     1135           create nd.
     1136           assign ld.ord = ld.ord + 1
     1137                       nd.ord = ld.ord
     1138                       nd.num  = ld.num
     1139                       nd.name
     1140                       ri = recid( nd ).
     1141       end.
     1142       enable  nd.name b-ok b-cancel with frame add-nd.
     1143       wait-for go of frame add-nd.
     1144   END PROCEDURE.
     1145   PROCEDURE upd-ld:
     1146      def var ri as recid no-undo .
     1147      def button b-ok  auto-go default
     1148          label "&Ввод".
     1149      def button b-cancel  auto-endkey
     1150          label "&Отмена".
     1151       form  b-ok   at 1 b-cancel at 11
     1152               skip
     1153               ld.name  label "Название"
     1154               space( 0.2 ) skip( 0.2 )
     1155               space( 0.2 )
     1156               with frame add-ld three-d side-labels  view-as dialog-box default-button b-ok
     1157                        title "У Р О В Е Н Ь -- изменение".
     1158       on window-close of frame add-ld apply "end-error" to self.
     1159       on go of frame add-ld do:
     1160           if input ld.name = "" then do:
     1161               message "Введите название" view-as alert-box.
     1162               return no-apply.
     1163           end.
     1164           if can-find( first ld where ld.name = input frame add-ld  ld.name
     1165                                           AND recid( ld ) <> ri ) then do:
     1166               message "Уровень" input ld.name "уже есть" view-as alert-box.
     1167               return no-apply.
     1168           end.
     1169           assign ld.name.
     1170           disp ld.name with browse ld.
     1171       end.
     1172       if not available ld THEN return.
     1173       ri = recid( ld ).
     1174       disp ld.name with frame add-ld.
     1175       enable  ld.name b-ok b-cancel with frame add-ld.
     1176       wait-for go of frame add-ld.
     1177   END PROCEDURE.
     1178   PROCEDURE upd-nd:
     1179      def var ri as recid no-undo .
     1180      if not available nd then do:
     1181        return .
     1182      end.
     1183      if nd.new_ <> true then do:
     1184        message
     1185          "Нельзя менять название уже созданного признака" skip
     1186          view-as alert-box information .
     1187        return .
     1188      end.
     1189      def button b-ok  auto-go default
     1190          label "&Ввод".
     1191      def button b-cancel  auto-endkey
     1192          label "&Отмена".
     1193       form  b-ok at 1 b-cancel at 11
     1194       skip
     1195               nd.name label "Название"
     1196               space( 0.2 ) skip( 0.2 )
     1197               space( 0.2 )
     1198               with frame add-nd three-d side-labels  view-as dialog-box default-button b-ok
     1199                      title "П Р И З Н А К -- изменение".
     1200       on window-close of frame add-nd apply "end-error" to self.
     1201       on go of frame add-nd do:
     1202           if input nd.name = "" then do:
     1203               message "Введите название" view-as alert-box.
     1204               return no-apply.
     1205           end.
     1206           if can-find( first nd where nd.num = ld.num
     1207                                            AND nd.name = input frame add-nd  nd.name
     1208                                            AND recid( nd ) <> ri ) then do:
     1209               message "Признак" input nd.name "уже есть" view-as alert-box.
     1210               apply "entry":U to nd.name.
     1211               return no-apply.
     1212           end.
     1213           assign nd.name.
     1214           disp nd.name with browse nd.
     1215       end.
     1216       if not available nd THEN return.
     1217       ri = recid( nd ).
     1218       disp nd.name with frame add-nd.
     1219       enable nd.name b-ok b-cancel with frame add-nd.
     1220       wait-for go of frame add-nd.
     1221   END PROCEDURE.
