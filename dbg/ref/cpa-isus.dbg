      389        LABEL "&Отмена"
      390        SIZE 10 BY 1
      391        BGCOLOR 8 .
      392   DEFINE VARIABLE for-obj-name AS CHARACTER FORMAT "X(256)":U
      393         VIEW-AS TEXT
      394        SIZE 37.88 BY 1 NO-UNDO.
      395   DEFINE VARIABLE v-host-name AS CHARACTER FORMAT "X(256)":U
