      398   DEFINE VARIABLE var-region AS CHARACTER FORMAT "X(256)":U
      399         VIEW-AS TEXT
      400        SIZE 24 BY 1 NO-UNDO.
      401   DEFINE VARIABLE Rs-cash-desk AS CHARACTER INITIAL "*"
      402        VIEW-AS RADIO-SET VERTICAL
      403        RADIO-BUTTONS
      404             "Все кассы", "*",
      405   "Выборочно", "N"
      406        SIZE 20 BY 2.25 NO-UNDO.
      407   DEFINE VARIABLE Rs-is-use AS CHARACTER
      408        VIEW-AS RADIO-SET VERTICAL
      409        RADIO-BUTTONS
      410             "Используется", "*",
      411   "Не используется", "-"
      412        SIZE 24 BY 3
      413        FGCOLOR 4  NO-UNDO.
      414   DEFINE VARIABLE RS-region AS INTEGER
