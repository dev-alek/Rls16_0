      427     QUERY BR-cash-desk NO-LOCK DISPLAY
      428         tt-cash-desk.cash-num FORMAT ">>>9":U
      429         tt-cash-desk.pos-type FORMAT "X(20)":U
      430       WITH NO-ROW-MARKERS SEPARATORS SIZE 46 BY 6.75 EXPANDABLE.
      431   DEFINE FRAME Dialog-Frame
      432        B-exit AT ROW 1 COL 1
      433        b-quit AT ROW 1 COL 11
      434        B-Help AT ROW 1 COL 54.88
      435        RS-region AT ROW 2.75 COL 3 NO-LABEL
      436        BR-cash-desk AT ROW 9 COL 27.5
      437        Rs-cash-desk AT ROW 9.25 COL 1.5 NO-LABEL
      438        B-cash-desk AT ROW 10.5 COL 22
      439        Rs-is-use AT ROW 12.5 COL 2 NO-LABEL
      440        var-region AT ROW 4.5 COL 18 COLON-ALIGNED NO-LABEL
      441        v-host-name AT ROW 6 COL 18 COLON-ALIGNED NO-LABEL
      442        for-obj-name AT ROW 7.5 COL 20.5 COLON-ALIGNED NO-LABEL
      443        RECT-region AT ROW 2.5 COL 1.5
      444        SPACE(3.62) SKIP(6.99)
      445       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      446            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      447            TITLE "Области использования типа кассового платежа"
      448            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      449   ASSIGN
      450          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      451          FRAME Dialog-Frame:HIDDEN           = TRUE.
      452   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      453   DO:
      454     APPLY "END-ERROR":U TO SELF.
      455   END.
      456   ON CHOOSE OF B-cash-desk IN FRAME Dialog-Frame
      457   DO:
      458     RUN proc-cash-desk IN THIS-PROCEDURE NO-ERROR.
      459     IF ERROR-STATUS:ERROR THEN do:
      460         ASSIGN
      461         rs-cash-desk = '*':U.
      462         DISPLAY
      463         rs-cash-desk
      464         WITH FRAME Dialog-Frame.
      465         RETURN NO-APPLY.
      466     END.
      467   END.
      468   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      469   DO:
      470     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      471     IF ERROR-STATUS:ERROR THEN DO:
      472         RETURN NO-APPLY.
      473     END.
      474   END.
      475   ON VALUE-CHANGED OF Rs-cash-desk IN FRAME Dialog-Frame
      476   DO:
      477     ASSIGN
      478     rs-cash-desk.
      479     CASE rs-cash-desk:
      480         WHEN '*':U THEN DO:
      481             DISABLE
      482             b-cash-desk
      483             WITH FRAME Dialog-Frame
      484             .
      485         END.
      486         WHEN 'N':U THEN DO:
      487             ENABLE
      488             b-cash-desk
      489             WITH FRAME Dialog-Frame
      490             .
      491             APPLY 'CHOSE' TO b-cash-desk.
      492       END.
      493     END CASE.
      494   END.
      495   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      496   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      497   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      498   on help of frame Dialog-Frame
      499   do:
      500     run gbl/app_help.p
      501       (input this-procedure :file-name
      502       ,input ''
      503       ,input ?
      504       ) no-error.
      505     if error-status :error then do:
      506       message
      507         "Ошибка при вызове помощи"
      508         error-status :get-message(1)
      509         view-as alert-box .
      510     end.
      511   end.
      512   run minbtn-set in this-procedure .
