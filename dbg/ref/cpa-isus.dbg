      516   end.
      517   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      518   procedure minbtn-set :
      519       do
      520           on error undo, return error return-value
      521           :
      522           define variable ii              as integer       no-undo .
      523           define variable fh              as widget-handle no-undo .
      524           define variable hh              as widget-handle no-undo .
      525           define variable v-h             as handle        extent 4 no-undo .
      526           define variable v-name-button   as character     no-undo .
      527           define variable v-help-old-x    as decimal       no-undo .
      528           define variable v-help-old-y    as decimal       no-undo .
      529           define variable v-help-old-size as decimal       no-undo .
      530           define variable v-frame-width   as decimal       no-undo .
      531           define variable jj              as integer       no-undo .
      532           do
      533               on error undo, return error
      534               :
      535               assign
      536                   v-frame-width = frame Dialog-Frame:width - 0.3
      537                   fh            = frame Dialog-Frame:first-child
      538                   hh            = fh:first-child
      539                   ii            = 1
      540                   .
      541               do while valid-handle(hh):
      542                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      543                   do:
      544                       case lc(hh:name) :
      545                           when "b-help" then
      546                               do:
      547                                   hh:load-image-up("cmp/b-help.bmp":u) .
      548                                   hh:load-image-down("cmp/b-help.bmp":u) .
      549                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      550                                   hh:TOOLTIP = "Помощь" .
      551                                   v-help-old-x = hh:column .
      552                                   v-help-old-y = hh:row    .
      553                                   v-help-old-size = hh:width .
      554                                   hh:width-chars = 2.5 .
      555                               end.
      556                           when "b-print" then
      557                               do:
      558                                   hh:load-image("cmp/b-print.bmp":u) .
      559                                   hh:TOOLTIP = "Печать" .
      560                                   v-h[ii] = hh:handle .
      561                                   ii = ii + 1 .
      562                                   hh:width-chars = 3 .
      563                               end.
      564                           when "b-history" or
      565                           when "b-hist" then
      566                               do:
      567                                   hh:load-image("cmp/b-hist.bmp":u) .
      568                                   hh:TOOLTIP = "История" .
      569                                   v-h[ii] = hh:handle .
      570                                   ii = ii + 1 .
      571                                   hh:width-chars = 3 .
      572                               end.
      573                           when "b-sch" then
      574                               do:
      575                                   hh:load-image("cmp/b-sch.bmp":u) .
      576                                   hh:TOOLTIP = "Установка Фильтра" .
      577                                   v-h[ii] = hh:handle .
      578                                   ii = ii + 1 .
      579                                   hh:width-chars = 3 .
      580                               end.
      581                           when "b-hist-user" then
      582                               do:
      583                                   hh:load-image("cmp/b-hist.bmp":u) .
      584                                   hh:TOOLTIP = "История пользователя" .
      585                                   ii = ii + 1 .
      586                               end.
      587                       end case.
      588                   end.
      589                   hh = hh:next-sibling.
      590               end.
      591               b-help:column = v-frame-width - b-help:width-chars.
      592               jj = 0.
      593               repeat ii = 4 to 1 by -1 :
      594                   if valid-handle (v-h[ii] ) then
      595                   do:
      596                       jj  = jj + 1 .
      597                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      598                       v-h[ii]:row    = v-help-old-y .
      599                   end.
      600               end.
      601           end.
      602       end.
      603   end procedure.
      604   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      605   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      606   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      607   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      608   define variable v-diasize-current-frame-width  as decimal   no-undo .
      609   define variable v-diasize-current-frame-height as decimal   no-undo .
      610   define variable v-diasize-change-size          as logical   no-undo .
      611   define variable v-diasize-resize-button        as handle    no-undo .
      612   define variable v-diasize-wndmax               as logical   no-undo .
      613   define variable v-diasize-wndstore             as logical   no-undo .
      614   define variable v-diasize-proc-name            as character no-undo .
      615   define variable v-diasize-browse-handle        as handle    no-undo .
      616   define variable v-diasize-browse-number        as integer   no-undo .
      617   define variable v-diasize-need-full-display    as logical   no-undo init false .
      618   define temp-table temp-diasize-handle no-undo
      619     field handle-value  as handle
      620     field save-position as decimal
      621     index xpk is primary unique handle-value
      622     .
      623   define temp-table temp-browse-handle no-undo
      624     field browse-type   as character
      625     field browse-number as integer
      626     field browse-handle as handle
      627     field original-size as decimal
      628     index xpk is primary unique browse-type browse-number
      629     index xie browse-type browse-handle
      630   .
      631   procedure diasize_change-height :
      632     define input  parameter p-change-value  as decimal   no-undo .
      633     define input  parameter p-move-resize   as logical   no-undo .
      634     define variable v-field-group-handle    as handle    no-undo .
      635     define variable v-object-handle         as handle    no-undo .
      636     define variable v-frame-height          as decimal   no-undo .
      637     define variable v-frame-virtual-height  as decimal   no-undo .
      638     define variable v-browse-height         as decimal   no-undo .
      639     define variable v-window-height         as decimal   no-undo .
      640     define variable v-window-virtual-height as decimal   no-undo .
      641     define variable v-change-sign           as integer   no-undo .
      642     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      643     define buffer buf_temp-browse-handle  for temp-browse-handle .
      644     if p-change-value > 0
      645     then do:
      646       if frame Dialog-Frame :height + p-change-value
      647           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      648       then do:
      649         assign
      650           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      651                           - (frame Dialog-Frame :height-chars)
      652         .
      653         if p-change-value <= 0
      654         then do:
      655           run diasize_position-resize-button in this-procedure .
      656           return .
      657         end.
      658       end.
      659     end.
      660     if p-change-value < 0
      661     then do:
      662       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      663       then do:
      664         assign
      665           p-change-value = v-diasize-orig-frame-height
      666                          - (frame Dialog-Frame :height-chars)
      667         .
      668         if p-change-value >= 0
      669         then do:
      670           run diasize_position-resize-button in this-procedure .
      671           return .
      672         end.
      673       end.
      674     end.
      675     if p-change-value >= 0
      676     then do:
      677       assign
      678         v-change-sign = 1
      679       .
      680     end.
      681     else do:
      682       assign
      683         v-change-sign = -1
      684       .
      685     end.
      686     assign
      687       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      688     .
      689     if p-change-value = 0
      690     then do:
      691       run diasize_position-resize-button in this-procedure .
      692       return .
      693     end.
      694     move_block:
      695     do
      696     on error undo move_block, retry move_block
      697     :
      698       if retry
      699       then do:
      700         do
      701         on error undo move_block, leave move_block
      702         :
      703           if p-change-value > 0
      704           then do:
      705             for each buf_temp-diasize-handle
      706             on error undo, next
      707             :
      708               assign
      709                 v-object-handle = buf_temp-diasize-handle.handle-value
      710               .
      711               if v-object-handle <> v-diasize-resize-button
      712               then do:
      713                 assign
      714                   v-object-handle :row = buf_temp-diasize-handle.save-position
      715                 .
      716               end.
      717             end.
      718             assign
      719               v-diasize-browse-handle :height = v-browse-height
      720             .
      721             for each buf_temp-browse-handle
      722               where buf_temp-browse-handle.browse-type = 'height':u
      723             on error undo, next
      724             :
      725               assign
      726                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      727               .
      728             end.
      729             assign
      730               frame Dialog-Frame :height = v-frame-height
      731             .
      732             if frame Dialog-Frame :scrollable = true
      733             then do:
      734               assign
      735                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      736               .
      737             end.
      738             run diasize_position-resize-button in this-procedure .
      739           end.
      740           else do:
      741             if frame Dialog-Frame :scrollable = true
      742             then do:
      743               assign
      744                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      745               .
      746             end.
      747             assign
      748               frame Dialog-Frame :height = v-frame-height
      749             .
      750             assign
      751               v-diasize-browse-handle :height = v-browse-height
      752             .
      753             for each buf_temp-browse-handle
      754               where buf_temp-browse-handle.browse-type = 'height':u
      755             on error undo, next
      756             :
      757               assign
      758                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      759               .
      760             end.
      761             for each buf_temp-diasize-handle
      762             on error undo, next
      763             :
      764               assign
      765                 v-object-handle = buf_temp-diasize-handle.handle-value
      766               .
      767               if v-object-handle <> v-diasize-resize-button
      768               then do:
      769                 assign
      770                   v-object-handle :row = buf_temp-diasize-handle.save-position
      771                 .
      772               end.
      773             end.
      774             run diasize_position-resize-button in this-procedure .
      775           end.
      776           assign
      777             v-diasize-change-size = false
      778           .
      779           leave move_block .
      780         end.
      781       end.
      782       assign
      783         v-diasize-need-full-display = true
      784       .
      785       if v-diasize-change-size = false
      786       then do:
      787         assign
      788           v-diasize-change-size = true
      789         .
      790       end.
      791       else do:
      792         return .
      793       end.
      794       assign
      795         v-frame-height = frame Dialog-Frame :height
      796         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      797         v-browse-height = v-diasize-browse-handle :height
      798       .
      799       for each buf_temp-browse-handle
      800         where buf_temp-browse-handle.browse-type = 'height':u
      801       :
      802         assign
      803           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      804         .
      805       end.
      806       for each buf_temp-diasize-handle
      807       :
      808         delete buf_temp-diasize-handle .
      809       end.
      810       assign
      811         v-field-group-handle = frame Dialog-Frame :first-child
      812       .
      813       do while valid-handle(v-field-group-handle)
      814       :
      815         assign
      816           v-object-handle = v-field-group-handle :first-child
      817         .
      818         do while valid-handle(v-object-handle)
      819         :
      820           if  v-object-handle <> v-diasize-browse-handle :handle
      821           and can-query(v-object-handle, "row")
      822           and can-query(v-object-handle, "height")
      823           and ( v-object-handle :row > v-diasize-browse-handle :row )
      824           then do:
      825             find first buf_temp-browse-handle
      826               where buf_temp-browse-handle.browse-type   = 'height':u
      827                 and buf_temp-browse-handle.browse-handle = v-object-handle
      828               no-error .
      829             if available buf_temp-browse-handle
      830             then do:
      831             end.
      832             else do:
      833               create buf_temp-diasize-handle .
      834               assign
      835                 buf_temp-diasize-handle.handle-value  = v-object-handle
      836                 buf_temp-diasize-handle.save-position = v-object-handle :row
      837               .
      838             end.
      839           end.
      840           assign
      841             v-object-handle = v-object-handle :next-sibling
      842           .
      843         end.
      844         assign
      845           v-field-group-handle = v-field-group-handle :next-sibling
      846         .
      847       end.
      848       do with frame Dialog-Frame
      849       :
      850         hide v-diasize-resize-button .
      851         assign
      852           v-diasize-resize-button :row    = 1
      853           v-diasize-resize-button :column = 1
      854         .
      855       end.
      856       if p-change-value > 0
      857       then do:
      858         if frame Dialog-Frame :scrollable = true
      859         then do:
      860           assign
      861             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      862             no-error .
      863           if error-status :error
      864           or error-status :get-message(1) <> ""
      865           then do:
      866             undo move_block, retry move_block .
      867           end.
      868         end.
      869         assign
      870           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      871           no-error .
      872         if error-status :error
      873         or error-status :get-message(1) <> ""
      874         then do:
      875           undo move_block, retry move_block .
      876         end.
      877         assign
      878           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      879           no-error .
      880         if error-status :error
      881         or error-status :get-message(1) <> ""
      882         then do:
      883           undo move_block, retry move_block .
      884         end.
      885         for each buf_temp-browse-handle
      886           where buf_temp-browse-handle.browse-type = 'height':u
      887         on error undo move_block, retry move_block
      888         :
      889           assign
      890             buf_temp-browse-handle.browse-handle :height
      891               = buf_temp-browse-handle.browse-handle :height + p-change-value
      892             no-error .
      893           if error-status :error
      894           or error-status :get-message(1) <> ""
      895           then do:
      896             undo move_block, retry move_block .
      897           end.
      898         end.
      899         for each buf_temp-diasize-handle
      900         on error undo move_block, retry move_block
      901         :
      902           assign
      903             v-object-handle = buf_temp-diasize-handle.handle-value
      904           .
      905           if v-object-handle <> v-diasize-resize-button
      906           then do:
      907             assign
      908               v-object-handle :row = v-object-handle :row + p-change-value
      909               no-error .
      910             if error-status :error
      911             or error-status :get-message(1) <> ""
      912             then do:
      913               undo move_block, retry move_block .
      914             end.
      915           end.
      916         end.
      917       end.
      918       else do:
      919         for each buf_temp-diasize-handle
      920         on error undo move_block, retry move_block
      921         :
      922           assign
      923             v-object-handle = buf_temp-diasize-handle.handle-value
      924           .
      925           if v-object-handle <> v-diasize-resize-button
      926           then do:
      927             assign
      928               v-object-handle :row = v-object-handle :row + p-change-value
      929               no-error .
      930             if error-status :error
      931             or error-status :get-message(1) <> ""
      932             then do:
      933               undo move_block, retry move_block .
      934             end.
      935           end.
      936         end.
      937         assign
      938           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      939           no-error .
      940         if error-status :error
      941         or error-status :get-message(1) <> ""
      942         then do:
      943           undo move_block, retry move_block .
      944         end.
      945         for each buf_temp-browse-handle
      946           where buf_temp-browse-handle.browse-type = 'height':u
      947         on error undo move_block, retry move_block
      948         :
      949           assign
      950             buf_temp-browse-handle.browse-handle :height
      951               = buf_temp-browse-handle.browse-handle :height + p-change-value
      952             no-error .
      953           if error-status :error
      954           or error-status :get-message(1) <> ""
      955           then do:
      956             undo move_block, retry move_block .
      957           end.
      958         end.
      959         assign
      960           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      961           no-error .
      962         if error-status :error
      963         or error-status :get-message(1) <> ""
      964         then do:
      965           undo move_block, retry move_block .
      966         end.
      967         if frame Dialog-Frame :scrollable = true
      968         then do:
      969           assign
      970             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      971             no-error .
      972           if error-status :error
      973           or error-status :get-message(1) <> ""
      974           then do:
      975             undo move_block, retry move_block .
      976           end.
      977         end.
      978       end.
      979       if p-move-resize = true
      980       then do:
      981         run diasize_position-resize-button in this-procedure .
      982       end.
      983       if v-diasize-wndstore = true
      984       then do:
      985         if connected("ub") = true
      986         then do:
      987           define variable v-cntxt-db-num        as integer   no-undo .
      988           define variable v-cntxt-userid        as character no-undo .
      989           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      990                                             , OUTPUT v-cntxt-userid
      991                                             ) .
      992           run gbl/wndsizew.p
      993             (input  v-cntxt-db-num
      994             ,input  v-cntxt-userid
      995             ,input  v-diasize-proc-name
      996             ,input  'height':u
      997             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      998             ) .
      999         end.
     1000       end.
     1001     end.
     1002     assign
     1003       v-diasize-change-size = false
     1004     .
     1005   end procedure.
     1006   procedure diasize_set-height :
     1007     define input  parameter p-new-height  as decimal   no-undo .
     1008     define input  parameter p-move-resize as logical   no-undo .
     1009     do
     1010     on error undo, return error return-value
     1011     :
     1012       run diasize_change-height in this-procedure
     1013         (input  (p-new-height - frame Dialog-Frame :height)
     1014         ,input  p-move-resize
     1015         ) .
     1016     end.
     1017   end procedure.
     1018   procedure diasize_change-width :
     1019     define input  parameter p-change-value as decimal   no-undo .
     1020     define input  parameter p-move-resize  as logical   no-undo .
     1021     define variable v-field-group-handle   as handle    no-undo .
     1022     define variable v-object-handle        as handle    no-undo .
     1023     define variable v-frame-width          as decimal   no-undo .
     1024     define variable v-frame-virtual-width  as decimal   no-undo .
     1025     define variable v-browse-width         as decimal   no-undo .
     1026     define variable v-window-width         as decimal   no-undo .
     1027     define variable v-window-virtual-width as decimal   no-undo .
     1028     define variable v-change-sign          as integer   no-undo .
     1029     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1030     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1031     if p-change-value > 0
     1032     then do:
     1033       if frame Dialog-Frame :width + p-change-value >
     1034           session :width-chars
     1035       then do:
     1036         assign
     1037           p-change-value = session :width-chars - frame Dialog-Frame :width
     1038         .
     1039         if p-change-value <= 0
     1040         then do:
     1041           run diasize_position-resize-button in this-procedure .
     1042           return .
     1043         end.
     1044       end.
     1045     end.
     1046     if p-change-value < 0
     1047     then do:
     1048       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1049       then do:
     1050         assign
     1051           p-change-value = v-diasize-orig-frame-width
     1052                          - frame Dialog-Frame :width
     1053         .
     1054         if p-change-value >= 0
     1055         then do:
     1056           run diasize_position-resize-button in this-procedure .
     1057           return .
     1058         end.
     1059       end.
     1060     end.
     1061     if p-change-value >= 0
     1062     then do:
     1063       assign
     1064         v-change-sign = 1
     1065       .
     1066     end.
     1067     else do:
     1068       assign
     1069         v-change-sign = -1
     1070       .
     1071     end.
     1072     assign
     1073       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1074     .
     1075     if p-change-value = 0
     1076     then do:
     1077       run diasize_position-resize-button in this-procedure .
     1078       return .
     1079     end.
     1080     move_block:
     1081     do
     1082     on error undo move_block, leave move_block
     1083     :
     1084       if retry
     1085       then do:
     1086         do
     1087         on error undo move_block, leave move_block
     1088         :
     1089           if p-change-value > 0
     1090           then do:
     1091             for each buf_temp-diasize-handle
     1092             on error undo, next
     1093             :
     1094               assign
     1095                 v-object-handle = buf_temp-diasize-handle.handle-value
     1096               .
     1097               if v-object-handle <> v-diasize-resize-button
     1098               then do:
     1099                 assign
     1100                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1101                 .
     1102               end.
     1103             end.
     1104             assign
     1105               v-diasize-browse-handle :width = v-browse-width
     1106             .
     1107             for each buf_temp-browse-handle
     1108               where buf_temp-browse-handle.browse-type = 'width':u
     1109             on error undo, next
     1110             :
     1111               assign
     1112                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1113               .
     1114             end.
     1115             assign
     1116               frame Dialog-Frame :width = v-frame-width
     1117             .
     1118             if frame Dialog-Frame :scrollable = true
     1119             then do:
     1120               assign
     1121                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1122               .
     1123             end.
     1124             run diasize_position-resize-button in this-procedure .
     1125           end.
     1126           else do:
     1127             if frame Dialog-Frame :scrollable = true
     1128             then do:
     1129               assign
     1130                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1131               .
     1132             end.
     1133             assign
     1134               frame Dialog-Frame :width = v-frame-width
     1135             .
     1136             for each buf_temp-browse-handle
     1137               where buf_temp-browse-handle.browse-type = 'width':u
     1138             on error undo, next
     1139             :
     1140               assign
     1141                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1142               .
     1143             end.
     1144             assign
     1145               v-diasize-browse-handle :width = v-browse-width
     1146             .
     1147             for each buf_temp-diasize-handle
     1148             on error undo, next
     1149             :
     1150               assign
     1151                 v-object-handle = buf_temp-diasize-handle.handle-value
     1152               .
     1153               if v-object-handle <> v-diasize-resize-button
     1154               then do:
     1155                 assign
     1156                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1157                 .
     1158               end.
     1159             end.
     1160             run diasize_position-resize-button in this-procedure .
     1161           end.
     1162           assign
     1163             v-diasize-change-size = false
     1164           .
     1165           leave move_block .
     1166         end.
     1167       end.
     1168       assign
     1169         v-diasize-need-full-display = true
     1170       .
     1171       if v-diasize-change-size = false
     1172       then do:
     1173         assign
     1174           v-diasize-change-size = true
     1175         .
     1176       end.
     1177       else do:
     1178         return .
     1179       end.
     1180       assign
     1181         v-frame-width = frame Dialog-Frame :width
     1182         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1183         v-browse-width = v-diasize-browse-handle :width
     1184       .
     1185       for each buf_temp-browse-handle
     1186         where buf_temp-browse-handle.browse-type = 'width':u
     1187       :
     1188         assign
     1189           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1190         .
     1191       end.
     1192       for each buf_temp-diasize-handle
     1193       :
     1194         delete buf_temp-diasize-handle .
     1195       end.
     1196       assign
     1197         v-field-group-handle = frame Dialog-Frame :first-child
     1198       .
     1199       do while valid-handle(v-field-group-handle)
     1200       :
     1201         assign
     1202           v-object-handle = v-field-group-handle :first-child
     1203         .
     1204         do while valid-handle(v-object-handle)
     1205         :
     1206           if  v-object-handle <> v-diasize-browse-handle :handle
     1207           and v-object-handle <> v-diasize-resize-button
     1208           and can-query(v-object-handle, "row")
     1209           and can-query(v-object-handle, "height")
     1210           and ( v-object-handle :col + v-object-handle :width
     1211                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1212               )
     1213           then do:
     1214             find first buf_temp-browse-handle
     1215               where buf_temp-browse-handle.browse-type   = 'width':u
     1216                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1217               no-error .
     1218             if available buf_temp-browse-handle
     1219             then do:
     1220             end.
     1221             else do:
     1222               create buf_temp-diasize-handle .
     1223               assign
     1224                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1225                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1226               .
     1227             end.
     1228           end.
     1229           assign
     1230             v-object-handle = v-object-handle :next-sibling
     1231           .
     1232         end.
     1233         assign
     1234           v-field-group-handle = v-field-group-handle :next-sibling
     1235         .
     1236       end.
     1237       do with frame Dialog-Frame
     1238       :
     1239         hide v-diasize-resize-button .
     1240         v-diasize-resize-button :row = 1.
     1241         v-diasize-resize-button :column = 1.
     1242       end.
     1243       if p-change-value > 0
     1244       then do:
     1245         if frame Dialog-Frame :scrollable = true
     1246         then do:
     1247           assign
     1248             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1249             no-error .
     1250           if error-status :error
     1251           or error-status :get-message(1) <> ""
     1252           then do:
     1253             undo move_block, retry move_block.
     1254           end.
     1255         end.
     1256         assign
     1257           frame Dialog-Frame :width = v-frame-width + p-change-value
     1258           no-error .
     1259         if error-status :error
     1260         or error-status :get-message(1) <> ""
     1261         then do:
     1262           undo move_block, retry move_block.
     1263         end.
     1264         assign
     1265           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1266         no-error .
     1267         if error-status :error
     1268         or error-status :get-message(1) <> ""
     1269         then do:
     1270           undo move_block, retry move_block.
     1271         end.
     1272         for each buf_temp-browse-handle
     1273           where buf_temp-browse-handle.browse-type = 'width':u
     1274         on error undo move_block, retry move_block
     1275         :
     1276           assign
     1277             buf_temp-browse-handle.browse-handle :width
     1278               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1279             no-error .
     1280           if error-status :error
     1281           or error-status :get-message(1) <> ""
     1282           then do:
     1283             undo move_block, retry move_block .
     1284           end.
     1285         end.
     1286         for each buf_temp-diasize-handle
     1287         on error undo move_block, retry move_block
     1288         :
     1289           assign
     1290             v-object-handle = buf_temp-diasize-handle.handle-value
     1291           .
     1292           if v-object-handle <> v-diasize-resize-button
     1293           then do:
     1294             assign
     1295               v-object-handle :col = v-object-handle :col + p-change-value
     1296               no-error .
     1297             if error-status :error
     1298             or error-status :get-message(1) <> ""
     1299             then do:
     1300               undo move_block, retry move_block .
     1301             end.
     1302           end.
     1303         end.
     1304       end.
     1305       else do:
     1306         for each buf_temp-diasize-handle
     1307         on error undo move_block, retry move_block
     1308         :
     1309           assign
     1310             v-object-handle = buf_temp-diasize-handle.handle-value
     1311           .
     1312           if v-object-handle <> v-diasize-resize-button
     1313           then do:
     1314             assign
     1315               v-object-handle :col = v-object-handle :col + p-change-value
     1316               no-error .
     1317             if error-status :error
     1318             or error-status :get-message(1) <> ""
     1319             then do:
     1320               undo move_block, retry move_block .
     1321             end.
     1322           end.
     1323         end.
     1324         for each buf_temp-browse-handle
     1325           where buf_temp-browse-handle.browse-type = 'width':u
     1326         on error undo move_block, retry move_block
     1327         :
     1328           assign
     1329             buf_temp-browse-handle.browse-handle :width
     1330               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1331             no-error .
     1332           if error-status :error
     1333           or error-status :get-message(1) <> ""
     1334           then do:
     1335             undo move_block, retry move_block .
     1336           end.
     1337         end.
     1338         assign
     1339           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1340           no-error .
     1341         if error-status :error
     1342         or error-status :get-message(1) <> ""
     1343         then do:
     1344           undo move_block, retry move_block.
     1345         end.
     1346         assign
     1347           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1348         no-error .
     1349         if error-status :error
     1350         or error-status :get-message(1) <> ""
     1351         then do:
     1352           undo move_block, retry move_block.
     1353         end.
     1354         if frame Dialog-Frame :scrollable = true
     1355         then do:
     1356           assign
     1357             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1358           no-error .
     1359           if error-status :error
     1360           or error-status :get-message(1) <> ""
     1361           then do:
     1362             undo move_block, retry move_block.
     1363           end.
     1364         end.
     1365       end.
     1366       if p-move-resize
     1367       then do:
     1368         run diasize_position-resize-button in this-procedure .
     1369       end.
     1370       if v-diasize-wndstore = true
     1371       then do:
     1372         if connected("ub") = true
     1373         then do:
     1374           define variable v-cntxt-db-num        as integer   no-undo .
     1375           define variable v-cntxt-userid        as character no-undo .
     1376           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1377                                             , OUTPUT v-cntxt-userid
     1378                                             ) .
     1379           run gbl/wndsizew.p
     1380             (input  v-cntxt-db-num
     1381             ,input  v-cntxt-userid
     1382             ,input  v-diasize-proc-name
     1383             ,input  'width':u
     1384             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1385             ) .
     1386         end.
     1387       end.
     1388     end.
     1389     assign
     1390       v-diasize-change-size = false
     1391     .
     1392   end procedure.
     1393   procedure diasize_set-width :
     1394     define input  parameter p-new-width  as decimal   no-undo .
     1395     define input  parameter p-move-resize as logical   no-undo .
     1396     do
     1397     on error undo, return error return-value
     1398     :
     1399       run diasize_change-width in this-procedure
     1400         (input  (p-new-width - frame Dialog-Frame :width)
     1401         ,input  p-move-resize
     1402         ) .
     1403     end.
     1404   end procedure.
     1405   procedure diasize_position-resize-button :
     1406     do with frame Dialog-Frame
     1407     :
     1408       hide v-diasize-resize-button .
     1409       assign
     1410         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1411                     - 1
     1412                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1413         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1414                     - 1
     1415                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1416       .
     1417       view v-diasize-resize-button .
     1418     end.
     1419   end procedure.
     1420   on alt-right anywhere
     1421   do:
     1422     run diasize_change-width in this-procedure
     1423       (input 1
     1424       ,input true
     1425       ) .
     1426     return no-apply .
     1427   end.
     1428   on alt-left anywhere
     1429   do:
     1430     run diasize_change-width in this-procedure
     1431       (input -1
     1432       ,input true
     1433       ) .
     1434     return no-apply .
     1435   end.
     1436   on alt-down anywhere
     1437   do:
     1438     run diasize_change-height in this-procedure
     1439       (input 1
     1440       ,input true
     1441       ) .
     1442     return no-apply .
     1443   end.
     1444   on alt-up anywhere
     1445   do:
     1446     run diasize_change-height in this-procedure
     1447       (input -1
     1448       ,input true
     1449       ) .
     1450     return no-apply .
     1451   end.
     1452   on alt-enter of frame Dialog-Frame
     1453   do:
     1454     run diasize_maximize in this-procedure
     1455       (input  ?
     1456       ).
     1457     return no-apply .
     1458   end.
     1459   procedure diasize_end-move :
     1460     do
     1461     on error undo, return error return-value
     1462     :
     1463       define variable v-row-delta as decimal   no-undo .
     1464       define variable v-col-delta as decimal   no-undo .
     1465       define variable v-new-row as decimal   no-undo .
     1466       define variable v-new-col as decimal   no-undo .
     1467       assign
     1468         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1469         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1470       .
     1471       assign
     1472         v-row-delta = v-new-row - frame Dialog-Frame :height
     1473         v-col-delta = v-new-col - frame Dialog-Frame :width
     1474       .
     1475       run diasize_change-height in this-procedure
     1476         (input v-row-delta
     1477         ,input true
     1478         ) .
     1479       run diasize_change-width in this-procedure
     1480         (input v-col-delta
     1481         ,input true
     1482         ) .
     1483     end.
     1484   end procedure.
     1485   procedure diasize_maximize :
     1486     define input  parameter p-action as logical   no-undo .
     1487     do
     1488     on error undo, return error return-value
     1489     :
     1490       if p-action = ?
     1491       then do:
     1492         if v-diasize-need-maximize = true
     1493         then do:
     1494           assign
     1495             p-action = true
     1496           .
     1497         end.
     1498         else do:
     1499           assign
     1500             p-action = false
     1501           .
     1502         end.
     1503       end.
     1504       if p-action = true
     1505       then do:
     1506         run diasize_change-height in this-procedure
     1507           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1508               - frame Dialog-Frame :height-chars
     1509           ,input true
     1510           ) .
     1511         run diasize_change-width in this-procedure
     1512           (input session :width-chars
     1513               - frame Dialog-Frame :width-chars
     1514           ,input true
     1515           ) .
     1516         assign
     1517           v-diasize-need-maximize = false
     1518         .
     1519       end.
     1520       else do:
     1521         run diasize_change-width in this-procedure
     1522           (input v-diasize-orig-frame-width
     1523               - frame Dialog-Frame :width-chars
     1524           ,input true
     1525           ) .
     1526         run diasize_change-height in this-procedure
     1527           (input v-diasize-orig-frame-height
     1528               - frame Dialog-Frame :height-chars
     1529           ,input true
     1530           ) .
     1531         assign
     1532           v-diasize-need-maximize = true
     1533         .
     1534       end.
     1535     end.
     1536   end procedure.
     1537   procedure diasize_restore-orig-size :
     1538     do
     1539     on error undo, return error return-value
     1540     :
     1541       assign
     1542         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1543         v-diasize-current-frame-height = frame Dialog-Frame :height
     1544       .
     1545       run diasize_set-height in this-procedure
     1546         (input  v-diasize-orig-frame-height
     1547         ,input  true
     1548         ) .
     1549       run diasize_set-width in this-procedure
     1550         (input  v-diasize-orig-frame-width
     1551         ,input  true
     1552         ) .
     1553     end.
     1554   end procedure.
     1555   procedure diasize_restore-current-size :
     1556     do
     1557     on error undo, return error return-value
     1558     :
     1559       run diasize_set-height in this-procedure
     1560         (input  v-diasize-current-frame-height
     1561         ,input  true
     1562         ) .
     1563       run diasize_set-width in this-procedure
     1564         (input  v-diasize-current-frame-width
     1565         ,input  true
     1566         ) .
     1567     end.
     1568   end procedure.
     1569   procedure diasize_set-browse-handle :
     1570     define input  parameter p-browse-handle as handle   no-undo .
     1571     define buffer buf_temp-browse-handle for temp-browse-handle .
     1572     do
     1573     on error undo, return error return-value
     1574     :
     1575       assign
     1576         v-diasize-browse-handle = p-browse-handle
     1577       .
     1578       for each buf_temp-browse-handle
     1579       on error undo, return error return-value
     1580       :
     1581         delete buf_temp-browse-handle .
     1582       end.
     1583     end.
     1584   end procedure.
     1585   procedure diasize_add_browse :
     1586     define input  parameter p-browse-type   as character no-undo .
     1587     define input  parameter p-browse-handle as handle    no-undo .
     1588     define buffer buf_temp-browse-handle for temp-browse-handle .
     1589     do
     1590     on error undo, return error return-value
     1591     :
     1592       assign
     1593         v-diasize-browse-number = v-diasize-browse-number + 1
     1594       .
     1595       create buf_temp-browse-handle .
     1596       assign
     1597         buf_temp-browse-handle.browse-type   = p-browse-type
     1598         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1599         buf_temp-browse-handle.browse-handle = p-browse-handle
     1600       .
     1601     end.
     1602   end procedure.
     1603   procedure diasize_init :
     1604     define variable v-default-value    as logical   no-undo .
     1605     define variable v-restore-saved    as logical   no-undo .
     1606     define variable v-resize-value-str as character no-undo .
     1607     do
     1608     on error undo, return error return-value
     1609     :
     1610       do with frame Dialog-Frame
     1611       :
     1612         assign
     1613           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1614           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1615           v-diasize-browse-handle     = browse BR-cash-desk :handle
     1616         .
     1617         create button v-diasize-resize-button
     1618         assign
     1619           parent        = frame Dialog-Frame :first-child
     1620           label         = "s"
     1621           height-pixels = 16
     1622           width-pixels  = 16
     1623           visible       = true
     1624           sensitive     = true
     1625           movable       = true
     1626           triggers:
     1627             on end-move persistent run diasize_end-move in this-procedure .
     1628           end triggers.
     1629         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1630         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1631         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1632         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1633         assign
     1634           v-diasize-wndmax = false
     1635         .
     1636         if connected("ub") = true
     1637         then do:
     1638           define variable v-cntxt-db-num        as integer   no-undo .
     1639           define variable v-cntxt-userid        as character no-undo .
     1640           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1641                                             , OUTPUT v-cntxt-userid
     1642                                             ) .
     1643           run gbl/wndpar_r.p
     1644             (input  v-cntxt-db-num
     1645             ,input  v-cntxt-userid
     1646             ,input  'wndmax':U
     1647             ,output v-diasize-wndmax
     1648             ,output v-default-value
     1649             ) .
     1650         end.
     1651         assign
     1652           v-diasize-wndstore = false
     1653         .
     1654         if connected("ub") = true
     1655         then do:
     1656           run gbl/wndpar_r.p
     1657             (input  v-cntxt-db-num
     1658             ,input  v-cntxt-userid
     1659             ,input  'wndstore':U
     1660             ,output v-diasize-wndstore
     1661             ,output v-default-value
     1662             ) .
     1663         end.
     1664         assign
     1665           v-diasize-proc-name = entry(1, program-name(2), '.')
     1666         .
     1667         if v-diasize-wndstore = true
     1668         then do:
     1669           assign
     1670             v-restore-saved = false
     1671           .
     1672           if connected("ub") = true
     1673           then do:
     1674             run gbl/wndsizer.p
     1675               (input  v-cntxt-db-num
     1676               ,input  v-cntxt-userid
     1677               ,input  v-diasize-proc-name
     1678               ,input  'height':u
     1679               ,output v-resize-value-str
     1680               ) .
     1681             if v-resize-value-str <> '':U
     1682             then do:
     1683               run diasize_change-height in this-procedure
     1684                 (input  integer(v-resize-value-str)
     1685                 ,input  true
     1686                 ) .
     1687               assign
     1688                 v-restore-saved = true
     1689               .
     1690             end.
     1691           end.
     1692           if connected("ub") = true
     1693           then do:
     1694             run gbl/wndsizer.p
     1695               (input  v-cntxt-db-num
     1696               ,input  v-cntxt-userid
     1697               ,input  v-diasize-proc-name
     1698               ,input  'width':u
     1699               ,output v-resize-value-str
     1700               ) .
     1701             if v-resize-value-str <> '':U
     1702             then do:
     1703               run diasize_change-width in this-procedure
     1704                 (input  integer(v-resize-value-str)
     1705                 ,input  true
     1706                 ) .
     1707               assign
     1708                 v-restore-saved = true
     1709               .
     1710             end.
     1711           end.
     1712           if v-restore-saved <> true
     1713           then do:
     1714             if v-diasize-wndmax = true
     1715             then do:
     1716               run diasize_maximize in this-procedure
     1717                 (input  true
     1718                 ) .
     1719             end.
     1720           end.
     1721         end.
     1722         else do:
     1723           if v-diasize-wndmax = true
     1724           then do:
     1725             run diasize_maximize in this-procedure
     1726               (input  true
     1727               ) .
     1728           end.
     1729         end.
     1730       end.
     1731     end.
     1732   end procedure.
     1733   procedure diasize_need-full-display :
     1734     define output parameter p-need-full-display as logical   no-undo .
     1735     do
     1736     on error undo, return error return-value
     1737     :
     1738       assign
     1739         p-need-full-display = v-diasize-need-full-display
     1740       .
     1741       assign
     1742         v-diasize-need-full-display = false
     1743       .
     1744     end.
     1745   end procedure.
     1746   procedure get-context :
     1747      define output parameter p-db-num as integer          no-undo.
     1748      define output parameter p-user-id as character        no-undo.
     1749      define variable v-login               as character    no-undo.
     1750      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1751      define buffer buf_user-login  for ub.user-login .
     1752      do
     1753      on error undo, return error
     1754      :
     1755            FIND FIRST buf_sys-ctrl no-lock.
     1756            ASSIGN
     1757               v-login = USERID("ub")
     1758               p-db-num = buf_sys-ctrl.db-num
     1759            .
     1760            FIND FIRST buf_user-login
     1761                 WHERE buf_user-login.db-num = p-db-num
     1762                   AND buf_user-login.user-login = v-login
     1763                 no-lock
     1764                 no-error
     1765                 .
     1766            IF AVAILABLE buf_user-login
     1767            THEN DO:
     1768               assign
     1769                  p-user-id = buf_user-login.user-id
     1770               .
     1771            END.
     1772      end.
     1773   end procedure.
     1774       run diasize_init in this-procedure .
     1775   MAIN-BLOCK:
     1776   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1777      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1778     RUN fill-table IN THIS-PROCEDURE.
     1779     RUN Myenable.
     1780     WAIT-FOR GO OF FRAME Dialog-Frame.
     1781   END.
     1782   RUN disable_UI.
     1783   PROCEDURE disable_UI :
     1784     HIDE FRAME Dialog-Frame.
     1785   END PROCEDURE.
     1786   PROCEDURE display-region :
     1787   DEFINE buffer buf_clients FOR ub.clients.
     1788   DEFINE buffer buf_objects FOR ub.clients.
     1789       assign
     1790       var-region = "Глобально"
     1791       v-host-name = "":U
     1792       for-obj-name = "":U.
     1793       if p-host-code <> 0 then do:
     1794           find first buf_clients No-LOCK WHERE
     1795                   buf_clients.obj-type = 'орг':U and
     1796                   buf_clients.obj-code = p-host-code No-ERROR.
     1797           ASSIGN
     1798           var-region = "Фирма: "
     1799           v-host-name = buf_Clients.obj-name
     1800           .
     1801       end.
     1802       if p-obj-code <> 0 then do:
     1803           find first buf_objects No-LOCK WHERE
     1804                   buf_objects.obj-type = p-obj-type and
     1805                   buf_objects.obj-code = p-obj-code No-ERROR.
     1806           ASSIGN
     1807           var-region = "Объект: "
     1808           for-obj-name = buf_objects.obj-name
     1809           .
     1810    end.
     1811    DISPLAY
     1812    var-region
     1813    WITH FRAME Dialog-Frame.
     1814    IF p-host-code <> 0 THEN DO:
     1815        DISPLAY
     1816        v-host-name
     1817        WITH FRAME Dialog-Frame.
     1818    END.
     1819    ELSE DO:
     1820        HIDE
     1821        v-host-name
     1822        IN FRAME Dialog-Frame.
     1823   END.
     1824    IF p-obj-code <> 0 THEN DO:
     1825        DISPLAY
     1826        for-obj-name
     1827        WITH FRAME Dialog-Frame.
     1828    END.
     1829    ELSE DO:
     1830        HIDE
     1831        for-obj-name
     1832        IN FRAME Dialog-Frame.
     1833   END.
     1834   END PROCEDURE.
     1835   PROCEDURE enable_UI :
     1836     DISPLAY RS-region Rs-cash-desk Rs-is-use var-region v-host-name for-obj-name
     1837         WITH FRAME Dialog-Frame.
     1838     ENABLE B-exit RECT-region b-quit B-Help RS-region BR-cash-desk Rs-cash-desk
     1839            B-cash-desk Rs-is-use var-region v-host-name for-obj-name
     1840         WITH FRAME Dialog-Frame.
     1841     VIEW FRAME Dialog-Frame.
     1842     OPEN QUERY BR-cash-desk FOR EACH tt-cash-desk NO-LOCK INDEXED-REPOSITION.
     1843   END PROCEDURE.
     1844   PROCEDURE fill-table :
     1845   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     1846   IF p-host-code = 0
     1847   OR p-obj-code = 0 THEN DO:
     1848       rs-is-use = p-attr-value.
     1849   END.
     1850   ELSE DO:
     1851   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1852   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1853     (input  p-obj-type
     1854     ,input  p-obj-code
     1855     ,output v-obj-db-num
     1856     )  .
     1857       DO ii = 1 TO NUM-ENTRIES(p-attr-value, chr(4)):
     1858           CREATE tt-cash-desk.
     1859           ASSIGN
     1860           rs-is-use = (IF integer(ENTRY(1, ENTRY(ii, p-attr-value, chr(4)))) < 0
     1861                         THEN '-'
     1862                         ELSE '*')
     1863           tt-cash-desk.cash-num = ABS(integer(ENTRY(1, ENTRY(ii, p-attr-value, chr(4)))))
     1864           tt-cash-desk.db-num = v-obj-db-num
     1865           tt-cash-desk.obj-code = p-obj-code
     1866           tt-cash-desk.pos-type = ENTRY(2, ENTRY(ii, p-attr-value, chr(4)))
     1867           .
     1868      END.
     1869   END.
     1870   END PROCEDURE.
     1871   PROCEDURE MyEnable :
     1872   assign
     1873   rs-region = (if p-host-code = 0
     1874                then 0
     1875                else (if p-obj-type = '':U then 1 else 2)
     1876                )
     1877   .
     1878   display
     1879   rs-region
     1880   rs-is-use
     1881   with frame Dialog-Frame .
     1882   IF rs-region = 2 THEN DO:
     1883     IF CAN-FIND(FIRST tt-cash-desk) THEN DO:
     1884         ASSIGN
     1885         rs-cash-desk= 'N'.
     1886     END.
     1887     ELSE DO:
     1888         ASSIGN
     1889         rs-cash-desk= '*'.
     1890     END.
     1891     DISPLAY
     1892     rs-cash-desk
     1893     WITH FRAME Dialog-Frame.
     1894     ENABLE
     1895     rs-cash-desk
     1896     b-cash-desk
     1897     WITH FRAME Dialog-Frame.
     1898   END.
     1899   ELSE DO:
     1900     ASSIGN
     1901     rs-cash-desk = '*':U
     1902     .
     1903     DISPLAY
     1904     rs-cash-desk
     1905     WITH FRAME Dialog-Frame.
     1906     DISABLE
     1907     rs-cash-desk
     1908     WITH FRAME Dialog-Frame.
     1909   END.
     1910    ENABLE
     1911    B-exit
     1912    RECT-region
     1913    rs-is-use
     1914    b-quit
     1915    B-Help
     1916    BR-cash-desk
     1917    WITH FRAME Dialog-Frame.
     1918    VIEW FRAME Dialog-Frame.
     1919    RUN display-region IN THIS-PROCEDURE.
     1920    OPEN QUERY BR-cash-desk FOR EACH tt-cash-desk NO-LOCK INDEXED-REPOSITION.
     1921   END PROCEDURE.
     1922   PROCEDURE proc-cash-desk :
     1923     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1924     define variable ii as integer no-undo .
     1925     define buffer buf_cash-desk for ub.cash-desk.
     1926     define buffer buf_tt-cash-desk for tt-cash-desk.
     1927     run ref/cashlist.w (input parparentproc
     1928                   ,INPUT "b-sel,b-mark"
     1929                   ,INPUT 'объект':U
     1930                   ,INPUT v-obj-db-num
     1931                   ,INPUT p-host-code
     1932                   ,INPUT 'маг':U
     1933                   ,INPUT p-obj-code
     1934                   ,INPUT ?
     1935                   ,OUTPUT v-rid-list) NO-ERROR.
     1936     IF error-status:error
     1937     OR v-rid-list = '':U THEN DO:
     1938         RETURN ERROR.
     1939     END.
     1940     for each buf_tt-cash-desk:
     1941       delete buf_tt-cash-desk.
     1942     end.
     1943     do ii = 1 to num-entries(v-rid-list):
     1944       find first buf_cash-desk no-lock where
     1945               recid(buf_cash-desk) = integer(entry(ii, v-rid-list)) no-error .
     1946       if available buf_cash-desk then do:
     1947         if buf_cash-desk.autonomy = integer('1':U) then do:
     1948           message
     1949           substitute("Касса &1 типа &2 является подчиненной кассой - для нее нельзя установить атрибут&3" +
     1950                      "Пропускаем"
     1951                      , buf_cash-desk.cash-num
     1952                      , buf_cash-desk.pos-type
     1953                      , chr(10)
     1954                      )
     1955           view-as alert-box WARNING.
     1956         end.
     1957         CREATE buf_tt-cash-desk.
     1958         buffer-copy buf_cash-desk to buf_tt-cash-desk.
     1959       end.
     1960     end.
     1961     OPEN QUERY BR-cash-desk FOR EACH tt-cash-desk NO-LOCK INDEXED-REPOSITION.
     1962   END PROCEDURE.
     1963   PROCEDURE proc-save :
     1964   DEFINE VARIABLE v-dop AS character NO-UNDO.
     1965   ASSIGN
     1966   FRAME Dialog-Frame
     1967   rs-region
     1968   rs-cash-desk
     1969   rs-is-use
     1970   .
     1971   IF rs-region = 2
     1972   AND rs-cash-desk = 'N':U THEN DO:
     1973       FOR EACH tt-cash-desk:
     1974           ASSIGN
     1975           v-dop = v-dop + (IF v-dop = '':U THEN '':U ELSE chr(4)) +
     1976                   (IF rs-is-use = '-' THEN '-' ELSE '':U) + string(tt-cash-desk.cash-num) + chr(44) + tt-cash-desk.pos-type.
     1977       END.
     1978       if v-dop = '':U then do:
     1979         message
     1980         "Не выбрано ни одной кассы"
     1981         view-as alert-box ERROR.
     1982         undo, return error .
     1983       end.
     1984       assign
     1985       p-attr-value = v-dop
     1986       p-ok = yes
     1987       .
     1988   END.
     1989   ELSE DO:
     1990       ASSIGN
     1991       p-attr-value = rs-is-use
     1992       p-ok = yes
     1993       .
     1994   END.
     1995   END PROCEDURE.
