      380   DEFINE BUTTON B-exit AUTO-GO
      381        LABEL "&Ввод"
      382        SIZE 10 BY 1
      383        BGCOLOR 8 .
      384   DEFINE BUTTON B-Help
      385        LABEL "Помо&щь"
      386        SIZE 10 BY 1
      387        BGCOLOR 8 .
