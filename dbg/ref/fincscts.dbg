      805   procedure prn-lib-reportviewer :
      806     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      807     define input parameter p-report-name-html as character no-undo .
      808     define input parameter p-param        as character no-undo .
      809     define variable v-excel           as character no-undo init 'TRUE' .
      810     define variable v-value-character as character no-undo .
      811     define variable v-value-integer   as character no-undo .
      812     define variable v-value-date      as date      no-undo .
      813     define variable v-value-decimal   as decimal   no-undo .
      814     define variable rep-excel         as logical   no-undo .
      815     define variable excel-string      as character no-undo .
      816     define variable v-param-type      as character no-undo .
      817     define variable v-tth             as handle    no-undo .
      818     run adm/shattri.p (
      819       input "get":U
      820       ,input  ""
      821       ,input  0
      822       ,input  'report-glob':U
      823       ,input  'rep-excel':U
      824       ,output v-value-character
      825       ,output v-value-date
      826       ,output v-value-decimal
      827       ,output v-value-integer
      828       ,output rep-excel
      829       ,output v-param-type
      830       ,INPUT-OUTPUT table-handle v-tth
      831       )  .
      832     if rep-excel then v-excel = "TRUE" .
      833     else v-excel = "FALSE" .
      834     if p-param eq ""
      835     then
