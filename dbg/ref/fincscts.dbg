      685           "Нет заданий на печать ! "
      686           view-as alert-box .
      687         Return  .
      688       End.
      689       run gbl/prnfilen.w
      690         (input  ""
      691         ,input  p-DisabledOptions
      692         ,input  string(v-report-name )
      693         ,input  7
      694         ,output v-user-action
      695         ,output v-printed
      696         ) .
      697       if v-printed then
