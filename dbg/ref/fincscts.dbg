     1084     define variable h-for-comp        as handle    no-undo .
     1085     define variable v-inform          as character no-undo .
     1086     define variable v-ind             as integer   no-undo .
     1087     define variable v-idx-field-qnty  as integer   no-undo .
     1088     define variable v-num-entries     as integer   no-undo .
     1089     define variable fh                as handle    no-undo .
     1090     define variable fh-main           as handle    no-undo .
     1091     define variable fh-old            as handle    no-undo .
     1092     define variable fh-new            as handle    no-undo .
     1093     define variable v-field-name      as character no-undo .
     1094     define variable v-field-lvl       as character no-undo .
     1095     define variable v-field-form      as character no-undo .
     1096     define variable v-search-exp      as character no-undo .
     1097     define variable v-srch-main       as character no-undo .
     1098     define variable v-word-link       as character no-undo .
     1099     define variable v-av-chip-num     as logical   no-undo .
     1100     define variable v-main-pi-fld-lst as character no-undo .
     1101     define variable v-main-fld-lst    as character no-undo .
     1102     define variable v-delim-list      as character no-undo .
     1103     define variable v-label           as character no-undo .
     1104     define variable v-old-value       as character no-undo case-sensitive.
     1105     define variable v-new-value       as character no-undo case-sensitive.
     1106     define variable v-chg-fields as character no-undo.
     1107     for each temp-changes:
     1108       delete temp-changes.
     1109     end.
     1110     if not p-hst-handle:available then do:
     1111       return .
     1112     end.
     1113     create buffer h-new-buf  for table p-hst-handle .
     1114     create buffer h-main-buf for table p-main-table .
     1115     assign
     1116       v-inform = h-main-buf:index-information(1)
     1117       v-ind    = 2
     1118     .
     1119     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1120     on error undo, return error
     1121     :
     1122       assign
     1123         v-inform = h-main-buf:index-information( v-ind )
     1124         v-ind    = v-ind + 1
     1125       .
     1126     end.
     1127     if v-inform = ?
     1128       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1129       or entry( 3, v-inform, ",":U ) <> "1":U
     1130     then do:
     1131       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1132     end.
     1133     assign
     1134       v-idx-field-qnty = num-entries( v-inform ) - 4
     1135     .
     1136     if v-idx-field-qnty < 2 then do:
     1137       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1138     end.
     1139     assign
     1140       v-srch-main   = "where":U
     1141       v-word-link   = "":U
     1142       v-av-chip-num = false
     1143       v-delim-list  = "":U
     1144     .
     1145     do v-ind = 1 to v-idx-field-qnty by 2
     1146     on error undo, return error
     1147     :
     1148       assign
     1149         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1150         fh                = p-hst-handle:buffer-field( v-field-name )
     1151         fh-main           = h-main-buf:buffer-field( v-field-name )
     1152         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1153         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1154       .
     1155       if fh:data-type ="character":U then do:
     1156         assign
     1157           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1158         .
     1159       end.
     1160       else do:
     1161         assign
     1162           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1163         .
     1164       end.
     1165       if v-delim-list = "":U then do:
     1166         assign
     1167           v-delim-list = ",":U
     1168         .
     1169       end.
     1170       if v-word-link = "":U then do:
     1171         assign
     1172           v-word-link = "and":U
     1173         .
     1174       end.
     1175     end.
     1176     assign
     1177       v-delim-list  = "":U
     1178     .
     1179     do v-ind = 1 to h-main-buf:num-fields
     1180     on error undo, return error
     1181     :
     1182       assign
     1183         fh-main      = h-main-buf:buffer-field( v-ind )
     1184         v-field-name = fh-main:name
     1185       .
     1186         assign
     1187           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1188         .
     1189         if v-delim-list = "":U then do:
     1190           assign
     1191             v-delim-list = ",":U
     1192           .
     1193         end.
     1194     end.
     1195     assign
     1196       v-inform = p-hst-handle:index-information(1)
     1197       v-ind    = 2
     1198     .
     1199     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1200     on error undo, return error
     1201     :
     1202       assign
     1203         v-inform = p-hst-handle:index-information( v-ind )
     1204         v-ind    = v-ind + 1
     1205       .
     1206     end.
     1207     if v-inform = ?
     1208       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1209       or entry( 3, v-inform, ",":U ) <> "1":U
     1210     then do:
     1211       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1212     end.
     1213     assign
     1214       v-idx-field-qnty = num-entries( v-inform ) - 4
     1215     .
     1216     if v-idx-field-qnty < 2 then do:
     1217       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1218     end.
     1219     assign
     1220       v-search-exp  = "where":U
     1221       v-word-link   = "":U
     1222       v-av-chip-num = false
     1223     .
     1224     do v-ind = 1 to v-idx-field-qnty by 2
     1225     on error undo, return error
     1226     :
     1227       assign
     1228         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1229         fh           = p-hst-handle:buffer-field( v-field-name )
     1230         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1231       .
     1232       if v-field-name = "chip-num":U then do:
     1233         assign
     1234           v-search-exp  = substitute( "&1 >", v-search-exp )
     1235           v-av-chip-num = true
     1236         .
     1237       end.
     1238       else do:
     1239         assign
     1240           v-search-exp = substitute( "&1 =", v-search-exp )
     1241         .
     1242       end.
     1243       if fh:data-type ="character":U then do:
     1244         assign
     1245           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1246         .
     1247       end.
     1248       else do:
     1249         assign
     1250           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1251         .
     1252       end.
     1253       if v-word-link = "":U then do:
     1254         assign
     1255           v-word-link = "and":U
     1256         .
     1257       end.
     1258     end.
     1259     if v-av-chip-num = false then do:
     1260       message
     1261         vss-workfile vss-revision vss-description skip
     1262         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1263         "Использование данной процедуры невозможно!" skip
     1264         view-as alert-box error .
     1265       return error .
     1266     end.
     1267     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1268     if not h-new-buf:available then do:
     1269       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1270       if not h-main-buf:available then do:
     1271         assign
     1272           h-for-comp = ?
     1273         .
     1274       end.
     1275       else do:
     1276         assign
     1277           h-for-comp = h-main-buf
     1278         .
     1279       end.
     1280     end.
     1281     else do:
     1282       assign
     1283         h-for-comp = h-new-buf
     1284       .
     1285     end.
     1286     assign
     1287       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1288     .
     1289     do v-ind = 1 to v-num-entries
     1290     on error undo, return error return-value
     1291     :
     1292       assign
     1293         v-field-name = entry( v-ind, v-main-fld-lst )
     1294         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1295         v-old-value  = fh-old:buffer-value()
     1296         v-label      = trim( fh-old:label )
     1297       .
     1298       if ( trim( p-field-list ) <> "":U
     1299            and lookup( v-field-name, p-field-list ) > 0
     1300          )
     1301          or trim( p-field-list ) = "":U
     1302       then do:
     1303         if h-for-comp <> ? then do:
     1304           assign
     1305             fh-new      = h-for-comp:buffer-field( v-field-name )
     1306             v-new-value = fh-new:buffer-value()
     1307           .
     1308         end.
     1309         else do:
     1310           assign
     1311             v-new-value = "":U
     1312           .
     1313         end.
     1314         if v-old-value <> v-new-value
     1315         then do:
     1316           create temp-changes.
     1317           assign
     1318             temp-changes.t_name = p-main-table
     1319             temp-changes.f_name = v-field-name
     1320             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1321             temp-changes.v_old  = trim( v-old-value )
     1322             temp-changes.v_new  = trim( v-new-value )
     1323             temp-changes.num_   = 0
     1324             temp-changes.fNotChange = v-old-value eq v-new-value
     1325           .
     1326         end.
     1327       end.
     1328     end.
     1329     assign
     1330       v-num-entries = num-entries( p-label-form, chr(8) )
     1331     .
     1332     do v-ind = 1 to v-num-entries
     1333     on error undo, return error return-value
     1334     :
     1335       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1336         assign
     1337           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1338           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1339           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1340         .
     1341         find first temp-changes
     1342           where temp-changes.f_name = v-field-name
     1343           no-error .
     1344         if available temp-changes then do:
     1345           if trim( v-field-lvl ) <> "":U then do:
     1346             assign
     1347               temp-changes.l_name = v-field-lvl
     1348             .
     1349           end.
     1350           if trim( v-field-form ) <> "":U then do:
     1351             assign
     1352               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1353             .
     1354             if h-for-comp <> ? then do:
     1355               assign
     1356                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1357               .
     1358             end.
     1359           end.
     1360         end.
     1361       end.
     1362       else do:
     1363         message
     1364           vss-workfile vss-revision vss-description skip
     1365           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1366           substitute( "список для поля '&1': '&2'"
     1367                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1368                       ,entry( v-ind, p-label-form, chr(8) )
     1369                     ) skip
     1370           substitute( "полный список: &2", p-label-form ) skip
     1371           view-as alert-box error .
     1372       end.
     1373     end.
     1374     delete object h-new-buf .
     1375     delete object h-main-buf .
     1376   END PROCEDURE.
     1377   FUNCTION get-bank-short-name RETURNS CHARACTER
     1378     ( BUFFER loc-c-fin-schet FOR ub.c-fin-schet )  FORWARD.
     1379   FUNCTION get-cli-name RETURNS CHARACTER
     1380    ( BUFFER loc-c-fin-schet FOR ub.c-fin-schet )  FORWARD.
     1381   FUNCTION get-currency RETURNS CHARACTER
     1382     ( BUFFER loc-c-fin-schet FOR ub.c-fin-schet )  FORWARD.
     1383   DEFINE BUTTON B-cli
     1384        IMAGE-UP FILE "btn-down-arrow":U
     1385        IMAGE-DOWN FILE "btn-down-arrow":U
     1386        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1387        LABEL "Btn 1"
     1388        SIZE 3 BY 1.
     1389   DEFINE BUTTON B-Help
     1390        LABEL "Помо&щь"
     1391        SIZE 3 BY 1
     1392        BGCOLOR 8 .
     1393   DEFINE BUTTON b-lkp
     1394        LABEL "&Просмотр"
     1395        SIZE 10 BY 1.
     1396   DEFINE BUTTON B-mark
     1397        LABEL "&*"
     1398        SIZE 3 BY 1.
     1399   DEFINE BUTTON b-quit AUTO-END-KEY
     1400        LABEL "&Выход"
     1401        SIZE 10 BY 1
     1402        BGCOLOR 8 .
     1403   DEFINE BUTTON B-sch
     1404        LABEL "&Фильтр"
     1405        SIZE 3 BY 1.
     1406   DEFINE BUTTON b-sel AUTO-GO
     1407        LABEL "Вы&бор"
     1408        SIZE 10 BY 1
     1409        BGCOLOR 8 .
     1410   DEFINE VARIABLE ED-notes AS CHARACTER
     1411        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1412        SIZE 98 BY 2
     1413        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1414   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1415         VIEW-AS TEXT
     1416        SIZE 6 BY 1
     1417        FGCOLOR 4  NO-UNDO.
     1418   DEFINE VARIABLE sch-c-schet AS CHARACTER FORMAT "X(20)":U
     1419        LABEL "Корр.счету"
     1420        VIEW-AS FILL-IN
     1421        SIZE 22 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1422   DEFINE VARIABLE sch-cli-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
     1423        LABEL "коду держателя"
     1424        VIEW-AS FILL-IN
     1425        SIZE 11 BY .92 NO-UNDO.
     1426   DEFINE VARIABLE sch-code AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1427        LABEL "коду"
     1428        VIEW-AS FILL-IN
     1429        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1430   DEFINE VARIABLE sch-r-schet AS CHARACTER FORMAT "X(20)":U
     1431        LABEL "Расч.счету"
     1432        VIEW-AS FILL-IN
     1433        SIZE 22 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1434   DEFINE VARIABLE RS-cli-type AS CHARACTER
     1435        VIEW-AS RADIO-SET HORIZONTAL
     1436        RADIO-BUTTONS
     1437             "Item 1", "1",
     1438   "Item 1", "2"
     1439        SIZE 19.38 BY 1.04 NO-UNDO.
     1440   DEFINE QUERY BR-changes FOR
     1441         temp-changes SCROLLING.
     1442   DEFINE QUERY br-schet FOR
     1443         X_c-fin-schet SCROLLING.
     1444   DEFINE BROWSE BR-changes
     1445     QUERY BR-changes DISPLAY
     1446         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1447   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1448   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1449       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6.21.
     1450   DEFINE BROWSE br-schet
     1451     QUERY br-schet DISPLAY
     1452         mark-string(recid(X_c-fin-schet), v-rid-list) FORMAT "X(1)":U
     1453         X_c-fin-schet.host-code COLUMN-LABEL "Код!фирмы" FORMAT "9999999999":U
     1454         X_c-fin-schet.code-schet COLUMN-LABEL "Код счета" FORMAT "9999999":U
     1455         X_c-fin-schet.code-bank COLUMN-LABEL "Код!банка" FORMAT "9999999":U
     1456         get-bank-short-name(buffer X_c-fin-schet) COLUMN-LABEL "Название банка" FORMAT "X(20)":U
     1457         X_c-fin-schet.cli-type + string(X_c-fin-schet.cli-code) COLUMN-LABEL "Держатель!счета" FORMAT "X(12)":U
     1458         get-cli-name(buffer X_c-fin-schet) COLUMN-LABEL "Название держателя счета" FORMAT "X(20)":U
     1459         X_c-fin-schet.corr-date COLUMN-LABEL "Дата корр." FORMAT "99/99/9999":U
     1460         string(X_c-fin-schet.corr-time, "HH:MM") COLUMN-LABEL "Время корр."
     1461         usrfulnf(X_c-fin-schet.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1462         X_c-fin-schet.status_ FORMAT "X(8)":U
     1463         X_c-fin-schet.r-schet COLUMN-LABEL "Р/счет" FORMAT "X(20)":U
     1464         X_c-fin-schet.c-schet COLUMN-LABEL "Коррсчет" FORMAT "X(20)":U
     1465         get-currency(buffer X_c-fin-schet) COLUMN-LABEL "Вал" FORMAT "X(3)":U
     1466     ENABLE
     1467         X_c-fin-schet.status_
     1468       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.5 BY 8.92.
     1469   DEFINE FRAME Dialog-Frame
     1470        b-quit AT ROW 1 COL 1
     1471        B-mark AT ROW 1 COL 11
     1472        b-sel AT ROW 1 COL 21
     1473        b-lkp AT ROW 1 COL 41
     1474        B-sch AT ROW 1 COL 92
     1475        B-Help AT ROW 1 COL 95
     1476        br-schet AT ROW 2.21 COL 1.38
     1477        ED-notes AT ROW 11.25 COL 1 NO-LABEL
     1478        sch-code AT ROW 13.38 COL 16.25 COLON-ALIGNED
     1479        sch-c-schet AT ROW 13.38 COL 36.63 COLON-ALIGNED
     1480        sch-r-schet AT ROW 13.38 COL 71.13 COLON-ALIGNED
     1481        RS-cli-type AT ROW 14.58 COL 30.13 NO-LABEL
     1482        sch-cli-code AT ROW 14.63 COL 16.13 COLON-ALIGNED
     1483        B-cli AT ROW 14.63 COL 50.5
     1484        BR-changes AT ROW 15.83 COL 1
     1485        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1486        "ПОИСК ПО" VIEW-AS TEXT
     1487             SIZE 9.25 BY 1 AT ROW 13.38 COL 1.38
     1488             FGCOLOR 4
     1489        SPACE(88.61) SKIP(7.66)
     1490       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1491            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1492            TITLE "Список истории банковских счетов"
     1493            CANCEL-BUTTON b-quit.
     1494   ASSIGN
     1495          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1496          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1497   ASSIGN
     1498          br-schet:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1.
     1499   ASSIGN
     1500          ED-notes:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1501   ON GO OF FRAME Dialog-Frame
     1502   DO:
     1503     p-rid-list = v-rid-list.
     1504   END.
     1505   ON CHOOSE OF B-cli IN FRAME Dialog-Frame
     1506   DO:
     1507   define variable ref-list as character no-undo.
     1508   define variable ref-rec as recid no-undo.
     1509   define buffer buf_clients for ub.clients.
     1510     run ref/cli-all.w ( input parParentProc
     1511                     , input "b-sel"
     1512                     , input RS-cli-type
     1513                     , input ?
     1514                     , input ?
     1515                     , input ?
     1516                     , input ?
     1517                     , input "without-obj":U
     1518                     , output ref-list) .
     1519       if ref-list = "" then   do:
     1520         apply "entry" to b-cli in frame Dialog-Frame.
     1521         return no-apply.
     1522        end.
     1523       ref-rec = integer( ref-list ).
     1524       FIND FIRST buf_clients WHERE recid (buf_clients) = ref-rec NO-LOCK .
     1525       if NOT (buf_clients.obj-type = 'орг':U
     1526               or
     1527               buf_clients.obj-type = 'чел':U ) then do:
     1528         message
     1529         "Выберите контрагента типа" 'орг':U "или" 'чел':U
     1530         view-as alert-box error .
     1531         return no-apply.
     1532       end.
     1533       assign
     1534       RS-cli-type =  buf_clients.obj-type
     1535       sch-cli-code = buf_clients.obj-code
     1536       .
     1537       display
     1538       RS-cli-type
     1539       sch-cli-code
     1540       with frame Dialog-Frame.
     1541   END.
     1542   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1543   DO:
     1544   define variable loc-doc-rec as recid no-undo .
     1545   define buffer buf_c-fin-schet for ub.c-fin-schet.
     1546     if NOT available X_c-fin-schet then do:
     1547       message
     1548       "Неправильно выбран банк."
     1549       view-as alert-box ERROR.
     1550       return no-apply.
     1551     end.
     1552     find first buf_c-fin-schet no-lock where
     1553                buf_c-fin-schet.host-code = X_c-fin-schet.host-code
     1554            AND buf_c-fin-schet.code-schet = X_c-fin-schet.code-schet use-index pi no-error .
     1555     if available buf_c-fin-schet and
     1556       recid(buf_c-fin-schet) = recid(X_c-fin-schet) then do:
     1557       message
     1558       "Данная запись истории пуста - т.к. соответствует СОЗДАНИЮ записи банковского счета" skip
     1559       "Просмотр невозможен"
     1560       view-as alert-box .
     1561       return no-apply.
     1562     end.
     1563     assign
     1564     loc-doc-rec = recid (X_c-fin-schet).
     1565     run ref/fincscti.w
     1566                   (
     1567                    input parParentProc
     1568                   ,input p-curr-host-code
     1569                   ,input 'ПРОСМОТР':U
     1570                   ,input X_c-fin-schet.host-code
     1571                   ,input X_c-fin-schet.code-schet
     1572                   ,input X_c-fin-schet.corr-user-db-num
     1573                   ,input X_c-fin-schet.chip-num
     1574                   ,input-output loc-doc-rec
     1575                                 )
     1576     .
     1577     reposition br-schet to recid loc-doc-rec no-error.
     1578     apply "entry" to br-schet in frame Dialog-Frame.
     1579     apply "value-changed" to br-schet in frame Dialog-Frame.
     1580   END.
     1581   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1582   DO:
     1583   define variable loc#log as logical no-undo .
     1584     if available X_c-fin-schet then do:
     1585   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1586   define variable v-str-recid14 as character no-undo .
     1587   define variable v-num-entry14 as integer   no-undo .
     1588   assign
     1589     v-str-recid14 = trim( string( recid( X_c-fin-schet ) , "->>>>>>>>>>>9":U ) )
     1590     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1591   .
     1592   if v-num-entry14 > 0 then do:
     1593     assign
     1594       entry( v-num-entry14, v-rid-list ) = "":U
     1595       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1596     .
     1597   end.
     1598   else do:
     1599     assign
     1600       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1601     .
     1602   end.
     1603       loc#log = br-schet:refresh() .
     1604       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1605           loc#log = br-schet:select-next-row ().
     1606           apply "VALUE-CHANGED" to br-schet in frame Dialog-Frame.
     1607       end.
     1608       if num-entries( v-rid-list ) = 0
     1609       then
     1610           hide mark-num in frame Dialog-Frame.
     1611       else
     1612           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1613     end.
     1614     apply "entry" to br-schet in frame Dialog-Frame.
     1615   END.
     1616   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1617   DO:
     1618         run gbl/markqwa.p (
     1619                    input b-mark:sensitive
     1620                  , input v-rid-list) no-error.
     1621     if error-status:error then return no-apply.
     1622   END.
     1623   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1624   DO:
     1625     run proc-b-sch in this-procedure no-error.
     1626     if error-status:error then return no-apply.
     1627   END.
     1628   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1629   DO:
     1630     if ( available X_c-fin-schet ) then do:
     1631       if ( v-rid-list = "" ) or b-mark:sensitive = no then
     1632       v-rid-list = string( recid( X_c-fin-schet ) ) .
     1633     end.
     1634   END.
     1635   ON RETURN OF br-schet IN FRAME Dialog-Frame
     1636   DO:
     1637       run proc-br-schet no-error.
     1638     if error-status:error then return no-apply.
     1639   END.
     1640   ON VALUE-CHANGED OF br-schet IN FRAME Dialog-Frame
     1641   DO:
     1642      DEFINE VARIABLE dops as character no-undo .
     1643     dops = if available X_c-fin-schet then X_c-fin-schet.ps else '':U.
     1644     ED-notes:screen-value = dops.
     1645   run proc-view-changes in this-procedure no-error.
     1646   END.
     1647   ON LEAVE OF ED-notes IN FRAME Dialog-Frame
     1648   DO:
     1649     define buffer ps_c-fin-schet for ub.c-fin-schet.
     1650     if not available X_c-fin-schet then return no-apply.
     1651      DO on stop undo, return no-apply:
     1652         FIND PS_c-fin-schet where
     1653              recid (ps_c-fin-schet) = recid(X_c-fin-schet) exclusive.
     1654         if ps_c-fin-schet.PS <> input frame Dialog-Frame ed-notes then
     1655         assign
     1656         ps_c-fin-schet.PS = input frame Dialog-Frame ed-notes
     1657         .
     1658      END.
     1659   END.
     1660   ON VALUE-CHANGED OF RS-cli-type IN FRAME Dialog-Frame
     1661   DO:
     1662     assign
     1663     RS-cli-type.
     1664   END.
     1665   ON CTRL-J OF sch-c-schet IN FRAME Dialog-Frame
     1666   DO:
     1667     run proc-find-c-schet in this-procedure(yes, input frame Dialog-Frame sch-c-schet) no-error.
     1668     if error-status:error then return no-apply.
     1669   END.
     1670   ON RETURN OF sch-c-schet IN FRAME Dialog-Frame
     1671   DO:
     1672     run proc-find-c-schet in this-procedure(no, input frame Dialog-Frame sch-c-schet) no-error.
     1673     if error-status:error then return no-apply.
     1674   END.
     1675   ON CTRL-J OF sch-cli-code IN FRAME Dialog-Frame
     1676   DO:
     1677     run proc-find-cli-code in this-procedure( input yes, input frame Dialog-Frame sch-cli-code) no-error.
     1678     if error-status:error then return no-apply.
     1679   END.
     1680   ON RETURN OF sch-cli-code IN FRAME Dialog-Frame
     1681   DO:
     1682     run proc-find-cli-code in this-procedure( input yes, input frame Dialog-Frame sch-cli-code) no-error.
     1683     if error-status:error then return no-apply.
     1684   END.
     1685   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     1686   DO:
     1687     run proc-find-code in this-procedure( input yes, input frame Dialog-Frame sch-code) no-error.
     1688     if error-status:error then return no-apply.
     1689   END.
     1690   ON RETURN OF sch-code IN FRAME Dialog-Frame
     1691   DO:
     1692     run proc-find-code in this-procedure ( input no, input frame Dialog-Frame sch-code) no-error.
     1693     if error-status:error then return no-apply.
     1694   END.
     1695   ON CTRL-J OF sch-r-schet IN FRAME Dialog-Frame
     1696   DO:
     1697     run proc-find-r-schet in this-procedure (input yes, input frame Dialog-Frame sch-r-schet) no-error.
     1698     if error-status:error then return no-apply.
     1699   END.
     1700   ON RETURN OF sch-r-schet IN FRAME Dialog-Frame
     1701   DO:
     1702     run proc-find-r-schet in this-procedure ( input no, input frame Dialog-Frame sch-r-schet) no-error.
     1703     if error-status:error then return no-apply.
     1704   END.
     1705   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1706   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1707   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1708   on help of frame Dialog-Frame
     1709   do:
     1710     run gbl/app_help.p
     1711       (input this-procedure :file-name
     1712       ,input ''
     1713       ,input ?
     1714       ) no-error.
     1715     if error-status :error then do:
     1716       message
     1717         "Ошибка при вызове помощи"
     1718         error-status :get-message(1)
     1719         view-as alert-box .
     1720     end.
     1721   end.
     1722   run minbtn-set in this-procedure .
     1723   on choose of b-help in frame Dialog-Frame
     1724   do:
     1725     apply "help":u to frame Dialog-Frame .
     1726   end.
     1727   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1728   procedure minbtn-set :
     1729       do
     1730           on error undo, return error return-value
     1731           :
     1732           define variable ii              as integer       no-undo .
     1733           define variable fh              as widget-handle no-undo .
     1734           define variable hh              as widget-handle no-undo .
     1735           define variable v-h             as handle        extent 4 no-undo .
     1736           define variable v-name-button   as character     no-undo .
     1737           define variable v-help-old-x    as decimal       no-undo .
     1738           define variable v-help-old-y    as decimal       no-undo .
     1739           define variable v-help-old-size as decimal       no-undo .
     1740           define variable v-frame-width   as decimal       no-undo .
     1741           define variable jj              as integer       no-undo .
     1742           do
     1743               on error undo, return error
     1744               :
     1745               assign
     1746                   v-frame-width = frame Dialog-Frame:width - 0.3
     1747                   fh            = frame Dialog-Frame:first-child
     1748                   hh            = fh:first-child
     1749                   ii            = 1
     1750                   .
     1751               do while valid-handle(hh):
     1752                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1753                   do:
     1754                       case lc(hh:name) :
     1755                           when "b-help" then
     1756                               do:
     1757                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1758                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1759                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1760                                   hh:TOOLTIP = "Помощь" .
     1761                                   v-help-old-x = hh:column .
     1762                                   v-help-old-y = hh:row    .
     1763                                   v-help-old-size = hh:width .
     1764                                   hh:width-chars = 2.5 .
     1765                               end.
     1766                           when "b-print" then
     1767                               do:
     1768                                   hh:load-image("cmp/b-print.bmp":u) .
     1769                                   hh:TOOLTIP = "Печать" .
     1770                                   v-h[ii] = hh:handle .
     1771                                   ii = ii + 1 .
     1772                                   hh:width-chars = 3 .
     1773                               end.
     1774                           when "b-history" or
     1775                           when "b-hist" then
     1776                               do:
     1777                                   hh:load-image("cmp/b-hist.bmp":u) .
     1778                                   hh:TOOLTIP = "История" .
     1779                                   v-h[ii] = hh:handle .
     1780                                   ii = ii + 1 .
     1781                                   hh:width-chars = 3 .
     1782                               end.
     1783                           when "b-sch" then
     1784                               do:
     1785                                   hh:load-image("cmp/b-sch.bmp":u) .
     1786                                   hh:TOOLTIP = "Установка Фильтра" .
     1787                                   v-h[ii] = hh:handle .
     1788                                   ii = ii + 1 .
     1789                                   hh:width-chars = 3 .
     1790                               end.
     1791                           when "b-hist-user" then
     1792                               do:
     1793                                   hh:load-image("cmp/b-hist.bmp":u) .
     1794                                   hh:TOOLTIP = "История пользователя" .
     1795                                   ii = ii + 1 .
     1796                               end.
     1797                       end case.
     1798                   end.
     1799                   hh = hh:next-sibling.
     1800               end.
     1801               b-help:column = v-frame-width - b-help:width-chars.
     1802               jj = 0.
     1803               repeat ii = 4 to 1 by -1 :
     1804                   if valid-handle (v-h[ii] ) then
     1805                   do:
     1806                       jj  = jj + 1 .
     1807                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1808                       v-h[ii]:row    = v-help-old-y .
     1809                   end.
     1810               end.
     1811           end.
     1812       end.
     1813   end procedure.
     1814   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1815   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1816   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1817   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1818   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1819   define variable v-diasize-current-frame-height as decimal   no-undo .
     1820   define variable v-diasize-change-size          as logical   no-undo .
     1821   define variable v-diasize-resize-button        as handle    no-undo .
     1822   define variable v-diasize-wndmax               as logical   no-undo .
     1823   define variable v-diasize-wndstore             as logical   no-undo .
     1824   define variable v-diasize-proc-name            as character no-undo .
     1825   define variable v-diasize-browse-handle        as handle    no-undo .
     1826   define variable v-diasize-browse-number        as integer   no-undo .
     1827   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1828   define temp-table temp-diasize-handle no-undo
     1829     field handle-value  as handle
     1830     field save-position as decimal
     1831     index xpk is primary unique handle-value
     1832     .
     1833   define temp-table temp-browse-handle no-undo
     1834     field browse-type   as character
     1835     field browse-number as integer
     1836     field browse-handle as handle
     1837     field original-size as decimal
     1838     index xpk is primary unique browse-type browse-number
     1839     index xie browse-type browse-handle
     1840   .
     1841   procedure diasize_change-height :
     1842     define input  parameter p-change-value  as decimal   no-undo .
     1843     define input  parameter p-move-resize   as logical   no-undo .
     1844     define variable v-field-group-handle    as handle    no-undo .
     1845     define variable v-object-handle         as handle    no-undo .
     1846     define variable v-frame-height          as decimal   no-undo .
     1847     define variable v-frame-virtual-height  as decimal   no-undo .
     1848     define variable v-browse-height         as decimal   no-undo .
     1849     define variable v-window-height         as decimal   no-undo .
     1850     define variable v-window-virtual-height as decimal   no-undo .
     1851     define variable v-change-sign           as integer   no-undo .
     1852     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1853     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1854     if p-change-value > 0
     1855     then do:
     1856       if frame Dialog-Frame :height + p-change-value
     1857           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1858       then do:
     1859         assign
     1860           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1861                           - (frame Dialog-Frame :height-chars)
     1862         .
     1863         if p-change-value <= 0
     1864         then do:
     1865           run diasize_position-resize-button in this-procedure .
     1866           return .
     1867         end.
     1868       end.
     1869     end.
     1870     if p-change-value < 0
     1871     then do:
     1872       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1873       then do:
     1874         assign
     1875           p-change-value = v-diasize-orig-frame-height
     1876                          - (frame Dialog-Frame :height-chars)
     1877         .
     1878         if p-change-value >= 0
     1879         then do:
     1880           run diasize_position-resize-button in this-procedure .
     1881           return .
     1882         end.
     1883       end.
     1884     end.
     1885     if p-change-value >= 0
     1886     then do:
     1887       assign
     1888         v-change-sign = 1
     1889       .
     1890     end.
     1891     else do:
     1892       assign
     1893         v-change-sign = -1
     1894       .
     1895     end.
     1896     assign
     1897       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1898     .
     1899     if p-change-value = 0
     1900     then do:
     1901       run diasize_position-resize-button in this-procedure .
     1902       return .
     1903     end.
     1904     move_block:
     1905     do
     1906     on error undo move_block, retry move_block
     1907     :
     1908       if retry
     1909       then do:
     1910         do
     1911         on error undo move_block, leave move_block
     1912         :
     1913           if p-change-value > 0
     1914           then do:
     1915             for each buf_temp-diasize-handle
     1916             on error undo, next
     1917             :
     1918               assign
     1919                 v-object-handle = buf_temp-diasize-handle.handle-value
     1920               .
     1921               if v-object-handle <> v-diasize-resize-button
     1922               then do:
     1923                 assign
     1924                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1925                 .
     1926               end.
     1927             end.
     1928             assign
     1929               v-diasize-browse-handle :height = v-browse-height
     1930             .
     1931             for each buf_temp-browse-handle
     1932               where buf_temp-browse-handle.browse-type = 'height':u
     1933             on error undo, next
     1934             :
     1935               assign
     1936                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1937               .
     1938             end.
     1939             assign
     1940               frame Dialog-Frame :height = v-frame-height
     1941             .
     1942             if frame Dialog-Frame :scrollable = true
     1943             then do:
     1944               assign
     1945                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1946               .
     1947             end.
     1948             run diasize_position-resize-button in this-procedure .
     1949           end.
     1950           else do:
     1951             if frame Dialog-Frame :scrollable = true
     1952             then do:
     1953               assign
     1954                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1955               .
     1956             end.
     1957             assign
     1958               frame Dialog-Frame :height = v-frame-height
     1959             .
     1960             assign
     1961               v-diasize-browse-handle :height = v-browse-height
     1962             .
     1963             for each buf_temp-browse-handle
     1964               where buf_temp-browse-handle.browse-type = 'height':u
     1965             on error undo, next
     1966             :
     1967               assign
     1968                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1969               .
     1970             end.
     1971             for each buf_temp-diasize-handle
     1972             on error undo, next
     1973             :
     1974               assign
     1975                 v-object-handle = buf_temp-diasize-handle.handle-value
     1976               .
     1977               if v-object-handle <> v-diasize-resize-button
     1978               then do:
     1979                 assign
     1980                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1981                 .
     1982               end.
     1983             end.
     1984             run diasize_position-resize-button in this-procedure .
     1985           end.
     1986           assign
     1987             v-diasize-change-size = false
     1988           .
     1989           leave move_block .
     1990         end.
     1991       end.
     1992       assign
     1993         v-diasize-need-full-display = true
     1994       .
     1995       if v-diasize-change-size = false
     1996       then do:
     1997         assign
     1998           v-diasize-change-size = true
     1999         .
     2000       end.
     2001       else do:
     2002         return .
     2003       end.
     2004       assign
     2005         v-frame-height = frame Dialog-Frame :height
     2006         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2007         v-browse-height = v-diasize-browse-handle :height
     2008       .
     2009       for each buf_temp-browse-handle
     2010         where buf_temp-browse-handle.browse-type = 'height':u
     2011       :
     2012         assign
     2013           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2014         .
     2015       end.
     2016       for each buf_temp-diasize-handle
     2017       :
     2018         delete buf_temp-diasize-handle .
     2019       end.
     2020       assign
     2021         v-field-group-handle = frame Dialog-Frame :first-child
     2022       .
     2023       do while valid-handle(v-field-group-handle)
     2024       :
     2025         assign
     2026           v-object-handle = v-field-group-handle :first-child
     2027         .
     2028         do while valid-handle(v-object-handle)
     2029         :
     2030           if  v-object-handle <> v-diasize-browse-handle :handle
     2031           and can-query(v-object-handle, "row")
     2032           and can-query(v-object-handle, "height")
     2033           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2034           then do:
     2035             find first buf_temp-browse-handle
     2036               where buf_temp-browse-handle.browse-type   = 'height':u
     2037                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2038               no-error .
     2039             if available buf_temp-browse-handle
     2040             then do:
     2041             end.
     2042             else do:
     2043               create buf_temp-diasize-handle .
     2044               assign
     2045                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2046                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2047               .
     2048             end.
     2049           end.
     2050           assign
     2051             v-object-handle = v-object-handle :next-sibling
     2052           .
     2053         end.
     2054         assign
     2055           v-field-group-handle = v-field-group-handle :next-sibling
     2056         .
     2057       end.
     2058       do with frame Dialog-Frame
     2059       :
     2060         hide v-diasize-resize-button .
     2061         assign
     2062           v-diasize-resize-button :row    = 1
     2063           v-diasize-resize-button :column = 1
     2064         .
     2065       end.
     2066       if p-change-value > 0
     2067       then do:
     2068         if frame Dialog-Frame :scrollable = true
     2069         then do:
     2070           assign
     2071             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2072             no-error .
     2073           if error-status :error
     2074           or error-status :get-message(1) <> ""
     2075           then do:
     2076             undo move_block, retry move_block .
     2077           end.
     2078         end.
     2079         assign
     2080           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2081           no-error .
     2082         if error-status :error
     2083         or error-status :get-message(1) <> ""
     2084         then do:
     2085           undo move_block, retry move_block .
     2086         end.
     2087         assign
     2088           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2089           no-error .
     2090         if error-status :error
     2091         or error-status :get-message(1) <> ""
     2092         then do:
     2093           undo move_block, retry move_block .
     2094         end.
     2095         for each buf_temp-browse-handle
     2096           where buf_temp-browse-handle.browse-type = 'height':u
     2097         on error undo move_block, retry move_block
     2098         :
     2099           assign
     2100             buf_temp-browse-handle.browse-handle :height
     2101               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2102             no-error .
     2103           if error-status :error
     2104           or error-status :get-message(1) <> ""
     2105           then do:
     2106             undo move_block, retry move_block .
     2107           end.
     2108         end.
     2109         for each buf_temp-diasize-handle
     2110         on error undo move_block, retry move_block
     2111         :
     2112           assign
     2113             v-object-handle = buf_temp-diasize-handle.handle-value
     2114           .
     2115           if v-object-handle <> v-diasize-resize-button
     2116           then do:
     2117             assign
     2118               v-object-handle :row = v-object-handle :row + p-change-value
     2119               no-error .
     2120             if error-status :error
     2121             or error-status :get-message(1) <> ""
     2122             then do:
     2123               undo move_block, retry move_block .
     2124             end.
     2125           end.
     2126         end.
     2127       end.
     2128       else do:
     2129         for each buf_temp-diasize-handle
     2130         on error undo move_block, retry move_block
     2131         :
     2132           assign
     2133             v-object-handle = buf_temp-diasize-handle.handle-value
     2134           .
     2135           if v-object-handle <> v-diasize-resize-button
     2136           then do:
     2137             assign
     2138               v-object-handle :row = v-object-handle :row + p-change-value
     2139               no-error .
     2140             if error-status :error
     2141             or error-status :get-message(1) <> ""
     2142             then do:
     2143               undo move_block, retry move_block .
     2144             end.
     2145           end.
     2146         end.
     2147         assign
     2148           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2149           no-error .
     2150         if error-status :error
     2151         or error-status :get-message(1) <> ""
     2152         then do:
     2153           undo move_block, retry move_block .
     2154         end.
     2155         for each buf_temp-browse-handle
     2156           where buf_temp-browse-handle.browse-type = 'height':u
     2157         on error undo move_block, retry move_block
     2158         :
     2159           assign
     2160             buf_temp-browse-handle.browse-handle :height
     2161               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2162             no-error .
     2163           if error-status :error
     2164           or error-status :get-message(1) <> ""
     2165           then do:
     2166             undo move_block, retry move_block .
     2167           end.
     2168         end.
     2169         assign
     2170           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2171           no-error .
     2172         if error-status :error
     2173         or error-status :get-message(1) <> ""
     2174         then do:
     2175           undo move_block, retry move_block .
     2176         end.
     2177         if frame Dialog-Frame :scrollable = true
     2178         then do:
     2179           assign
     2180             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2181             no-error .
     2182           if error-status :error
     2183           or error-status :get-message(1) <> ""
     2184           then do:
     2185             undo move_block, retry move_block .
     2186           end.
     2187         end.
     2188       end.
     2189       if p-move-resize = true
     2190       then do:
     2191         run diasize_position-resize-button in this-procedure .
     2192       end.
     2193       if v-diasize-wndstore = true
     2194       then do:
     2195         if connected("ub") = true
     2196         then do:
     2197           define variable v-cntxt-db-num        as integer   no-undo .
     2198           define variable v-cntxt-userid        as character no-undo .
     2199           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2200                                             , OUTPUT v-cntxt-userid
     2201                                             ) .
     2202           run gbl/wndsizew.p
     2203             (input  v-cntxt-db-num
     2204             ,input  v-cntxt-userid
     2205             ,input  v-diasize-proc-name
     2206             ,input  'height':u
     2207             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2208             ) .
     2209         end.
     2210       end.
     2211     end.
     2212     assign
     2213       v-diasize-change-size = false
     2214     .
     2215   end procedure.
     2216   procedure diasize_set-height :
     2217     define input  parameter p-new-height  as decimal   no-undo .
     2218     define input  parameter p-move-resize as logical   no-undo .
     2219     do
     2220     on error undo, return error return-value
     2221     :
     2222       run diasize_change-height in this-procedure
     2223         (input  (p-new-height - frame Dialog-Frame :height)
     2224         ,input  p-move-resize
     2225         ) .
     2226     end.
     2227   end procedure.
     2228   procedure diasize_change-width :
     2229     define input  parameter p-change-value as decimal   no-undo .
     2230     define input  parameter p-move-resize  as logical   no-undo .
     2231     define variable v-field-group-handle   as handle    no-undo .
     2232     define variable v-object-handle        as handle    no-undo .
     2233     define variable v-frame-width          as decimal   no-undo .
     2234     define variable v-frame-virtual-width  as decimal   no-undo .
     2235     define variable v-browse-width         as decimal   no-undo .
     2236     define variable v-window-width         as decimal   no-undo .
     2237     define variable v-window-virtual-width as decimal   no-undo .
     2238     define variable v-change-sign          as integer   no-undo .
     2239     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2240     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2241     if p-change-value > 0
     2242     then do:
     2243       if frame Dialog-Frame :width + p-change-value >
     2244           session :width-chars
     2245       then do:
     2246         assign
     2247           p-change-value = session :width-chars - frame Dialog-Frame :width
     2248         .
     2249         if p-change-value <= 0
     2250         then do:
     2251           run diasize_position-resize-button in this-procedure .
     2252           return .
     2253         end.
     2254       end.
     2255     end.
     2256     if p-change-value < 0
     2257     then do:
     2258       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2259       then do:
     2260         assign
     2261           p-change-value = v-diasize-orig-frame-width
     2262                          - frame Dialog-Frame :width
     2263         .
     2264         if p-change-value >= 0
     2265         then do:
     2266           run diasize_position-resize-button in this-procedure .
     2267           return .
     2268         end.
     2269       end.
     2270     end.
     2271     if p-change-value >= 0
     2272     then do:
     2273       assign
     2274         v-change-sign = 1
     2275       .
     2276     end.
     2277     else do:
     2278       assign
     2279         v-change-sign = -1
     2280       .
     2281     end.
     2282     assign
     2283       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2284     .
     2285     if p-change-value = 0
     2286     then do:
     2287       run diasize_position-resize-button in this-procedure .
     2288       return .
     2289     end.
     2290     move_block:
     2291     do
     2292     on error undo move_block, leave move_block
     2293     :
     2294       if retry
     2295       then do:
     2296         do
     2297         on error undo move_block, leave move_block
     2298         :
     2299           if p-change-value > 0
     2300           then do:
     2301             for each buf_temp-diasize-handle
     2302             on error undo, next
     2303             :
     2304               assign
     2305                 v-object-handle = buf_temp-diasize-handle.handle-value
     2306               .
     2307               if v-object-handle <> v-diasize-resize-button
     2308               then do:
     2309                 assign
     2310                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2311                 .
     2312               end.
     2313             end.
     2314             assign
     2315               v-diasize-browse-handle :width = v-browse-width
     2316             .
     2317             for each buf_temp-browse-handle
     2318               where buf_temp-browse-handle.browse-type = 'width':u
     2319             on error undo, next
     2320             :
     2321               assign
     2322                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2323               .
     2324             end.
     2325             assign
     2326               frame Dialog-Frame :width = v-frame-width
     2327             .
     2328             if frame Dialog-Frame :scrollable = true
     2329             then do:
     2330               assign
     2331                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2332               .
     2333             end.
     2334             run diasize_position-resize-button in this-procedure .
     2335           end.
     2336           else do:
     2337             if frame Dialog-Frame :scrollable = true
     2338             then do:
     2339               assign
     2340                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2341               .
     2342             end.
     2343             assign
     2344               frame Dialog-Frame :width = v-frame-width
     2345             .
     2346             for each buf_temp-browse-handle
     2347               where buf_temp-browse-handle.browse-type = 'width':u
     2348             on error undo, next
     2349             :
     2350               assign
     2351                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2352               .
     2353             end.
     2354             assign
     2355               v-diasize-browse-handle :width = v-browse-width
     2356             .
     2357             for each buf_temp-diasize-handle
     2358             on error undo, next
     2359             :
     2360               assign
     2361                 v-object-handle = buf_temp-diasize-handle.handle-value
     2362               .
     2363               if v-object-handle <> v-diasize-resize-button
     2364               then do:
     2365                 assign
     2366                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2367                 .
     2368               end.
     2369             end.
     2370             run diasize_position-resize-button in this-procedure .
     2371           end.
     2372           assign
     2373             v-diasize-change-size = false
     2374           .
     2375           leave move_block .
     2376         end.
     2377       end.
     2378       assign
     2379         v-diasize-need-full-display = true
     2380       .
     2381       if v-diasize-change-size = false
     2382       then do:
     2383         assign
     2384           v-diasize-change-size = true
     2385         .
     2386       end.
     2387       else do:
     2388         return .
     2389       end.
     2390       assign
     2391         v-frame-width = frame Dialog-Frame :width
     2392         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2393         v-browse-width = v-diasize-browse-handle :width
     2394       .
     2395       for each buf_temp-browse-handle
     2396         where buf_temp-browse-handle.browse-type = 'width':u
     2397       :
     2398         assign
     2399           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2400         .
     2401       end.
     2402       for each buf_temp-diasize-handle
     2403       :
     2404         delete buf_temp-diasize-handle .
     2405       end.
     2406       assign
     2407         v-field-group-handle = frame Dialog-Frame :first-child
     2408       .
     2409       do while valid-handle(v-field-group-handle)
     2410       :
     2411         assign
     2412           v-object-handle = v-field-group-handle :first-child
     2413         .
     2414         do while valid-handle(v-object-handle)
     2415         :
     2416           if  v-object-handle <> v-diasize-browse-handle :handle
     2417           and v-object-handle <> v-diasize-resize-button
     2418           and can-query(v-object-handle, "row")
     2419           and can-query(v-object-handle, "height")
     2420           and ( v-object-handle :col + v-object-handle :width
     2421                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2422               )
     2423           then do:
     2424             find first buf_temp-browse-handle
     2425               where buf_temp-browse-handle.browse-type   = 'width':u
     2426                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2427               no-error .
     2428             if available buf_temp-browse-handle
     2429             then do:
     2430             end.
     2431             else do:
     2432               create buf_temp-diasize-handle .
     2433               assign
     2434                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2435                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2436               .
     2437             end.
     2438           end.
     2439           assign
     2440             v-object-handle = v-object-handle :next-sibling
     2441           .
     2442         end.
     2443         assign
     2444           v-field-group-handle = v-field-group-handle :next-sibling
     2445         .
     2446       end.
     2447       do with frame Dialog-Frame
     2448       :
     2449         hide v-diasize-resize-button .
     2450         v-diasize-resize-button :row = 1.
     2451         v-diasize-resize-button :column = 1.
     2452       end.
     2453       if p-change-value > 0
     2454       then do:
     2455         if frame Dialog-Frame :scrollable = true
     2456         then do:
     2457           assign
     2458             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2459             no-error .
     2460           if error-status :error
     2461           or error-status :get-message(1) <> ""
     2462           then do:
     2463             undo move_block, retry move_block.
     2464           end.
     2465         end.
     2466         assign
     2467           frame Dialog-Frame :width = v-frame-width + p-change-value
     2468           no-error .
     2469         if error-status :error
     2470         or error-status :get-message(1) <> ""
     2471         then do:
     2472           undo move_block, retry move_block.
     2473         end.
     2474         assign
     2475           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2476         no-error .
     2477         if error-status :error
     2478         or error-status :get-message(1) <> ""
     2479         then do:
     2480           undo move_block, retry move_block.
     2481         end.
     2482         for each buf_temp-browse-handle
     2483           where buf_temp-browse-handle.browse-type = 'width':u
     2484         on error undo move_block, retry move_block
     2485         :
     2486           assign
     2487             buf_temp-browse-handle.browse-handle :width
     2488               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2489             no-error .
     2490           if error-status :error
     2491           or error-status :get-message(1) <> ""
     2492           then do:
     2493             undo move_block, retry move_block .
     2494           end.
     2495         end.
     2496         for each buf_temp-diasize-handle
     2497         on error undo move_block, retry move_block
     2498         :
     2499           assign
     2500             v-object-handle = buf_temp-diasize-handle.handle-value
     2501           .
     2502           if v-object-handle <> v-diasize-resize-button
     2503           then do:
     2504             assign
     2505               v-object-handle :col = v-object-handle :col + p-change-value
     2506               no-error .
     2507             if error-status :error
     2508             or error-status :get-message(1) <> ""
     2509             then do:
     2510               undo move_block, retry move_block .
     2511             end.
     2512           end.
     2513         end.
     2514       end.
     2515       else do:
     2516         for each buf_temp-diasize-handle
     2517         on error undo move_block, retry move_block
     2518         :
     2519           assign
     2520             v-object-handle = buf_temp-diasize-handle.handle-value
     2521           .
     2522           if v-object-handle <> v-diasize-resize-button
     2523           then do:
     2524             assign
     2525               v-object-handle :col = v-object-handle :col + p-change-value
     2526               no-error .
     2527             if error-status :error
     2528             or error-status :get-message(1) <> ""
     2529             then do:
     2530               undo move_block, retry move_block .
     2531             end.
     2532           end.
     2533         end.
     2534         for each buf_temp-browse-handle
     2535           where buf_temp-browse-handle.browse-type = 'width':u
     2536         on error undo move_block, retry move_block
     2537         :
     2538           assign
     2539             buf_temp-browse-handle.browse-handle :width
     2540               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2541             no-error .
     2542           if error-status :error
     2543           or error-status :get-message(1) <> ""
     2544           then do:
     2545             undo move_block, retry move_block .
     2546           end.
     2547         end.
     2548         assign
     2549           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2550           no-error .
     2551         if error-status :error
     2552         or error-status :get-message(1) <> ""
     2553         then do:
     2554           undo move_block, retry move_block.
     2555         end.
     2556         assign
     2557           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2558         no-error .
     2559         if error-status :error
     2560         or error-status :get-message(1) <> ""
     2561         then do:
     2562           undo move_block, retry move_block.
     2563         end.
     2564         if frame Dialog-Frame :scrollable = true
     2565         then do:
     2566           assign
     2567             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2568           no-error .
     2569           if error-status :error
     2570           or error-status :get-message(1) <> ""
     2571           then do:
     2572             undo move_block, retry move_block.
     2573           end.
     2574         end.
     2575       end.
     2576       if p-move-resize
     2577       then do:
     2578         run diasize_position-resize-button in this-procedure .
     2579       end.
     2580       if v-diasize-wndstore = true
     2581       then do:
     2582         if connected("ub") = true
     2583         then do:
     2584           define variable v-cntxt-db-num        as integer   no-undo .
     2585           define variable v-cntxt-userid        as character no-undo .
     2586           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2587                                             , OUTPUT v-cntxt-userid
     2588                                             ) .
     2589           run gbl/wndsizew.p
     2590             (input  v-cntxt-db-num
     2591             ,input  v-cntxt-userid
     2592             ,input  v-diasize-proc-name
     2593             ,input  'width':u
     2594             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2595             ) .
     2596         end.
     2597       end.
     2598     end.
     2599     assign
     2600       v-diasize-change-size = false
     2601     .
     2602   end procedure.
     2603   procedure diasize_set-width :
     2604     define input  parameter p-new-width  as decimal   no-undo .
     2605     define input  parameter p-move-resize as logical   no-undo .
     2606     do
     2607     on error undo, return error return-value
     2608     :
     2609       run diasize_change-width in this-procedure
     2610         (input  (p-new-width - frame Dialog-Frame :width)
     2611         ,input  p-move-resize
     2612         ) .
     2613     end.
     2614   end procedure.
     2615   procedure diasize_position-resize-button :
     2616     do with frame Dialog-Frame
     2617     :
     2618       hide v-diasize-resize-button .
     2619       assign
     2620         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2621                     - 1
     2622                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2623         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2624                     - 1
     2625                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2626       .
     2627       view v-diasize-resize-button .
     2628     end.
     2629   end procedure.
     2630   on alt-right anywhere
     2631   do:
     2632     run diasize_change-width in this-procedure
     2633       (input 1
     2634       ,input true
     2635       ) .
     2636     return no-apply .
     2637   end.
     2638   on alt-left anywhere
     2639   do:
     2640     run diasize_change-width in this-procedure
     2641       (input -1
     2642       ,input true
     2643       ) .
     2644     return no-apply .
     2645   end.
     2646   on alt-down anywhere
     2647   do:
     2648     run diasize_change-height in this-procedure
     2649       (input 1
     2650       ,input true
     2651       ) .
     2652     return no-apply .
     2653   end.
     2654   on alt-up anywhere
     2655   do:
     2656     run diasize_change-height in this-procedure
     2657       (input -1
     2658       ,input true
     2659       ) .
     2660     return no-apply .
     2661   end.
     2662   on alt-enter of frame Dialog-Frame
     2663   do:
     2664     run diasize_maximize in this-procedure
     2665       (input  ?
     2666       ).
     2667     return no-apply .
     2668   end.
     2669   procedure diasize_end-move :
     2670     do
     2671     on error undo, return error return-value
     2672     :
     2673       define variable v-row-delta as decimal   no-undo .
     2674       define variable v-col-delta as decimal   no-undo .
     2675       define variable v-new-row as decimal   no-undo .
     2676       define variable v-new-col as decimal   no-undo .
     2677       assign
     2678         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2679         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2680       .
     2681       assign
     2682         v-row-delta = v-new-row - frame Dialog-Frame :height
     2683         v-col-delta = v-new-col - frame Dialog-Frame :width
     2684       .
     2685       run diasize_change-height in this-procedure
     2686         (input v-row-delta
     2687         ,input true
     2688         ) .
     2689       run diasize_change-width in this-procedure
     2690         (input v-col-delta
     2691         ,input true
     2692         ) .
     2693     end.
     2694   end procedure.
     2695   procedure diasize_maximize :
     2696     define input  parameter p-action as logical   no-undo .
     2697     do
     2698     on error undo, return error return-value
     2699     :
     2700       if p-action = ?
     2701       then do:
     2702         if v-diasize-need-maximize = true
     2703         then do:
     2704           assign
     2705             p-action = true
     2706           .
     2707         end.
     2708         else do:
     2709           assign
     2710             p-action = false
     2711           .
     2712         end.
     2713       end.
     2714       if p-action = true
     2715       then do:
     2716         run diasize_change-height in this-procedure
     2717           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2718               - frame Dialog-Frame :height-chars
     2719           ,input true
     2720           ) .
     2721         run diasize_change-width in this-procedure
     2722           (input session :width-chars
     2723               - frame Dialog-Frame :width-chars
     2724           ,input true
     2725           ) .
     2726         assign
     2727           v-diasize-need-maximize = false
     2728         .
     2729       end.
     2730       else do:
     2731         run diasize_change-width in this-procedure
     2732           (input v-diasize-orig-frame-width
     2733               - frame Dialog-Frame :width-chars
     2734           ,input true
     2735           ) .
     2736         run diasize_change-height in this-procedure
     2737           (input v-diasize-orig-frame-height
     2738               - frame Dialog-Frame :height-chars
     2739           ,input true
     2740           ) .
     2741         assign
     2742           v-diasize-need-maximize = true
     2743         .
     2744       end.
     2745     end.
     2746   end procedure.
     2747   procedure diasize_restore-orig-size :
     2748     do
     2749     on error undo, return error return-value
     2750     :
     2751       assign
     2752         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2753         v-diasize-current-frame-height = frame Dialog-Frame :height
     2754       .
     2755       run diasize_set-height in this-procedure
     2756         (input  v-diasize-orig-frame-height
     2757         ,input  true
     2758         ) .
     2759       run diasize_set-width in this-procedure
     2760         (input  v-diasize-orig-frame-width
     2761         ,input  true
     2762         ) .
     2763     end.
     2764   end procedure.
     2765   procedure diasize_restore-current-size :
     2766     do
     2767     on error undo, return error return-value
     2768     :
     2769       run diasize_set-height in this-procedure
     2770         (input  v-diasize-current-frame-height
     2771         ,input  true
     2772         ) .
     2773       run diasize_set-width in this-procedure
     2774         (input  v-diasize-current-frame-width
     2775         ,input  true
     2776         ) .
