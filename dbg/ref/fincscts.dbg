     4762       (input false
     4763       ,input p-next
     4764       ,input substitute("and X_c-fin-schet.r-schet   begins &1 "
     4765         , p-r-schet)
     4766       ).
     4767   apply "entry":u to sch-r-schet in frame Dialog-Frame .
     4768   END PROCEDURE.
     4769   PROCEDURE proc-view-changes :
     4770   for each temp-changes:
     4771       delete temp-changes.
     4772   END.
     4773   if not available X_c-fin-schet then do:
     4774     Open QUery br-changes for each temp-changes.
     4775     return.
     4776   end.
     4777   define variable v-label-param as character no-undo .
     4778   v-label-param =
     4779     "c-schet" + chr(4) + "Корр.счет" + chr(4) + "" + chr(8)
     4780    + "cli-code" + chr(4) + "Код держателя" + chr(4) + "" + chr(8)
     4781    + "cli-type" + chr(4) + "Тип держателя" + chr(4) + "" + chr(8)
     4782    + "code-bank" + chr(4) + "Вн.Код банка" + chr(4) + "" + chr(8)
     4783    + "code-schet" + chr(4) + "Вн.код счета" + chr(4) + "" + chr(8)
     4784    + "curr-code" + chr(4) + "Код валюты" + chr(4) + "" + chr(8)
     4785    + "dop1" + chr(4) + "Дополн.к назв.держ.счета" + chr(4) + "" + chr(8)
     4786    + "dop2" + chr(4) + "Дополн.к назв.банка" + chr(4) + "" + chr(8)
     4787    + "host-code" + chr(4) + "Код фирмы" + chr(4) + "" + chr(8)
     4788    + "r-schet" + chr(4) + "Расч. счет" + chr(4) + "" + chr(8)
     4789    + "PS" + chr(4) + "Примечания" + chr(4) + ""  .
     4790    run proc-full-temp-changes in this-procedure (
     4791                                                input  buffer X_c-fin-schet:handle
     4792                                               ,input  'fin-schet':U
     4793                                               ,input  "c-schet,cli-code,cli-type,code-bank,code-schet,curr-code,dop1,dop2,host-code,r-schet,PS"
     4794                                               ,input  v-label-param).
     4795   Open QUery br-changes for each temp-changes.
     4796   END PROCEDURE.
     4797   FUNCTION get-bank-short-name RETURNS CHARACTER
     4798     ( BUFFER loc-c-fin-schet FOR ub.c-fin-schet ) :
     4799   define buffer buf_fin-bank for ub.fin-bank.
     4800   find first buf_fin-bank no-lock where
     4801               buf_fin-bank.code-bank = loc-c-fin-schet.code-bank
     4802                   AND    buf_fin-bank.host-code = loc-c-fin-schet.host-code  no-error.
     4803   if available buf_fin-bank then
     4804   RETURN (if buf_fin-bank.short-name <> "":U then buf_fin-bank.short-name else buf_fin-bank.bank-name).
     4805   return (string(loc-c-fin-schet.host-code) + string(loc-c-fin-schet.code-bank)).
     4806   END FUNCTION.
     4807   FUNCTION get-cli-name RETURNS CHARACTER
     4808    ( BUFFER loc-c-fin-schet FOR ub.c-fin-schet ) :
     4809   define buffer buf_clients for ub.clients.
     4810   find first buf_clients no-lock where
     4811               buf_clients.obj-type = loc-c-fin-schet.cli-type
     4812                   AND    buf_clients.obj-code = loc-c-fin-schet.cli-code  no-error.
     4813   if available buf_clients then
     4814   RETURN (buf_clients.obj-name).
     4815   return (loc-c-fin-schet.cli-type + string(loc-c-fin-schet.cli-code)).
     4816   END FUNCTION.
     4817   FUNCTION get-currency RETURNS CHARACTER
     4818     ( BUFFER loc-c-fin-schet FOR ub.c-fin-schet ) :
     4819   define buffer buf_currency for ub.currency.
     4820   find first buf_currency no-lock where
     4821               buf_currency.curr-code = loc-c-fin-schet.curr-code no-error.
     4822   if available buf_currency then
     4823     RETURN buf_currency.curr-abbr.
     4824   return string(loc-c-fin-schet.curr-code).
     4825   END FUNCTION.
