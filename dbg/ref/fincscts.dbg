     4689   PROCEDURE proc-find-c-schet :
     4690   define input parameter p-next as logical no-undo.
     4691   define input parameter p-c-schet like ub.c-fin-schet.c-schet no-undo.
     4692   display
     4693   "0":U @ sch-code
     4694   "0":U @ sch-cli-code
     4695   "":U @ sch-r-schet
     4696   with frame Dialog-Frame.
     4697   assign
     4698   p-c-schet = replace(p-c-schet, chr(34), "":U)
     4699   p-c-schet = replace(p-c-schet, chr(39), chr(39) + chr(39))
     4700   p-c-schet = chr(34) + p-c-schet + chr(34).
     4701   run OpenBr in this-procedure
     4702       (input false
     4703       ,input p-next
     4704       ,input substitute("and X_c-fin-schet.c-schet   begins &1 "
     4705         , p-c-schet)
     4706       ).
     4707   apply "entry":u to sch-c-schet in frame Dialog-Frame .
     4708   END PROCEDURE.
