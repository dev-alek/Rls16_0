      707   procedure prn-lib-open-stream :
      708     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      709     define input parameter p-page-size    as integer no-undo .
      710     define input parameter p-is-stream    as logical no-undo .
      711     define input parameter p-append       as logical no-undo .
      712     define variable v-report-name as character no-undo .
      713     do
      714       on error undo, return error
      715       :
      716       run prn-lib-get-report-name  in this-procedure (
      717         input parParentProc
      718         ,output v-report-name
      719         ).
      720       if p-is-stream then
      721       do:
      722         if p-append then
      723         do:
      724           output stream PrnLibStream to value( v-report-name )
      725             page-size value(p-page-size) append .
      726         end.
      727         if not p-append then
      728         do:
      729           output stream PrnLibStream to value( v-report-name )
      730             page-size value(p-page-size) .
      731         end.
      732       end.
      733       if not p-is-stream then
      734       do:
      735         if p-append then
      736         do:
      737           output to value( v-report-name )
      738             page-size value(p-page-size) append .
      739         end.
      740         if not p-append then
      741         do:
      742           output to value( v-report-name )
      743             page-size value(p-page-size) .
      744         end.
      745       end.
      746     end.
      747   end procedure.
      748   procedure prn-lib-open-exp :
      749     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      750     define input parameter p-is-stream    as logical no-undo .
      751     define input parameter p-is-append    as logical no-undo .
      752     define output parameter p-ReportFileName as char init "report" no-undo.
      753     define output parameter p-process as logical no-undo .
      754     define variable glog as logical no-undo .
      755     do
      756       on error undo, return error
      757       :
      758       SYSTEM-DIALOG GET-FILE p-ReportFileName
      759         TITLE      "Укажите путь"
      760         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      761         ASK-OVERWRITE
      762         CREATE-TEST-FILE
      763         SAVE-AS
      764         USE-FILENAME
      765         DEFAULT-EXTENSION "txt"
      766         UPDATE glog
      767         .
      768       if not glog then  return.
      769       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      770       if p-is-stream then
      771       do:
      772         if p-is-append then
      773         do:
      774           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      775         end.
      776         else
      777         do:
      778           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      779         end.
      780       end.
      781       else
      782       do:
      783         if p-is-append then
      784         do:
      785           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      786         end.
      787         else
      788         do:
      789           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      790         end.
      791       end.
      792       p-process = yes.
      793     end.
      794   end procedure.
