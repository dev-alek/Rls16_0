     1065   FUNCTION get-all-fields returns character (p-file-name as character ):
     1066   define variable v-dop as character no-undo .
     1067     find first _file no-lock where _file._file-name = p-file-name no-error .
     1068     if not available _file then return "":U.
     1069     for each _field no-lock where
     1070              _field._file-recid = recid(_file) :
     1071       assign
     1072       v-dop = v-dop + _field._field-name + chr(44)
     1073       .
     1074     end.
     1075     return trim(v-dop).
     1076   END FUNCTION.
     1077   PROCEDURE proc-full-temp-changes :
     1078     define input  parameter p-hst-handle as handle    no-undo .
