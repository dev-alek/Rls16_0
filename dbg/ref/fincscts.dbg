     3010   def var sort-labelbr-schet   as character no-undo .
     3011   def var sort-clmnbr-schet    as handle    no-undo .
     3012   def var cur-clmnbr-schet     as handle    no-undo .
     3013   def var cur-clmn-locbr-schet as integer   no-undo .
     3014   def var re-querybr-schet     as logical   initial no no-undo .
     3015   on start-search, ctrl-o of br-schet in frame Dialog-Frame do:
     3016      run sort-brbr-schet
     3017        (input (if available temp-changes
     3018                then recid(temp-changes)
     3019                else ?
     3020               )
     3021        ).
     3022   end.
     3023   PROCEDURE sort-brbr-schet :
     3024     define input parameter p-recid as recid no-undo .
     3025     if re-querybr-schet = no then do:
     3026       assign
     3027          cur-clmnbr-schet = br-schet:current-column in frame Dialog-Frame
     3028       .
     3029       if sort-clmnbr-schet <> ? then sort-clmnbr-schet:column-fgcolor = 0.
     3030       if cur-clmnbr-schet = sort-clmnbr-schet then do:
     3031         assign
     3032            sort-labelbr-schet = ""
     3033            sort-clmnbr-schet = ?
     3034         .
     3035        end.
     3036        else do:
     3037          assign
     3038            sort-labelbr-schet = cur-clmnbr-schet:label
     3039            sort-clmnbr-schet  = cur-clmnbr-schet
     3040            sort-clmnbr-schet:column-fgcolor = 4
     3041          .
     3042        end.
     3043      end.
     3044     assign
     3045       cur-clmn-locbr-schet = 1
     3046     .
     3047     def var column-handle as handle no-undo .
     3048     column-handle = br-schet:first-column.
     3049     do while valid-handle(column-handle) :
     3050       if column-handle = cur-clmnbr-schet then do:
     3051         leave .
     3052       end.
     3053       column-handle = column-handle:NEXT-COLUMN.
     3054       assign
     3055         cur-clmn-locbr-schet = cur-clmn-locbr-schet + 1
     3056       .
     3057     end.
     3058     case sort-labelbr-schet:
     3059           when X_c-fin-schet.c-schet:label in browse br-schet then DO:    assign       sort-column-name = "X_c-fin-schet.c-schet"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3060           when X_c-fin-schet.r-schet:label in browse br-schet then DO:    assign       sort-column-name = "X_c-fin-schet.r-schet"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3061           when X_c-fin-schet.corr-date:label in browse br-schet then DO:    assign       sort-column-name = "X_c-fin-schet.corr-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3062       otherwise do:
     3063         assign
     3064           sort-column-name = ""
     3065         .
     3066         run OpenBr in this-procedure ( input yes, input no, input '':U).
     3067           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-schet') then do:
     3068             run mv-brw-defaultbr-schet.
     3069           end.
     3070         if sort-labelbr-schet <> "" then do:
     3071           assign
     3072             cur-clmnbr-schet:column-fgcolor = 0
     3073           .
     3074         end.
     3075         assign
     3076           cur-clmn-locbr-schet = ?
     3077         .
     3078       end.
     3079     end case.
     3080       if cur-clmn-locbr-schet <> ? then do:
     3081         if can-do( this-procedure:internal-entries, 'ch-clmnbr-schet') then do:
     3082           run ch-clmnbr-schet in this-procedure (cur-clmn-locbr-schet).
     3083         end.
     3084       end.
     3085     if p-recid <> ? then do:
     3086       reposition br-schet to recid p-recid no-error.
     3087       apply "value-changed" to br-schet in frame Dialog-Frame.
     3088     end.
     3089     apply "entry" to br-schet in frame Dialog-Frame.
     3090   END PROCEDURE.
     3091   procedure re-open-query-srt-clmnbr-schet:
     3092   if cur-clmnbr-schet = ? then do:
     3093      run OpenBr in this-procedure ( input yes, input no, input '':U).
     3094   end.
     3095   else do:
     3096      assign re-querybr-schet = yes.
     3097      run sort-brbr-schet
     3098        (input (if available temp-changes
     3099                then recid(temp-changes)
     3100                else ?
     3101               )
     3102        ).
     3103      assign re-querybr-schet = no.
     3104   end.
     3105   end.
