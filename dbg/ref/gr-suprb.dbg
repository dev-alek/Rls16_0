        1   define input  parameter parparentproc as handle no-undo .
        2   define input  parameter p-mode as character no-undo .
        3   define input  parameter p-db-num  as integer   no-undo .
        4   define input  parameter p-id     as integer   no-undo .
        5   define input  parameter p-name as character no-undo .
        6   define input-output parameter p-recid as recid no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Добавление суммовой группы для ценообразования ".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119     define variable v-cntxt-db-num        as integer   no-undo .
      120     define variable v-cntxt-userid        as character no-undo .
      121     define variable v-cntxt-level         as character no-undo .
      122     define variable v-cntxt-host-code-obj as integer   no-undo .
      123     define variable v-cntxt-obj-type      as character no-undo .
      124     define variable v-cntxt-obj-code      as integer   no-undo .
      125     define variable v-cntxt-db-num-obj    as integer   no-undo .
      126     define variable v-cntxt-is-admin      as logical   no-undo .
      127   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128     run mainmenu_getcntxt in parparentproc
      129       (output v-cntxt-db-num
      130       ,output v-cntxt-userid
      131       ,output v-cntxt-level
      132       ,output v-cntxt-host-code-obj
      133       ,output v-cntxt-obj-type
      134       ,output v-cntxt-obj-code
      135       ,output v-cntxt-db-num-obj
      136       ,output v-cntxt-is-admin
      137       ) .
      138   define variable v-sec as integer   no-undo .
      139   PROCEDURE SIS-ADD :
      140   define input  parameter p-db-num       as integer   no-undo .
      141   define input  parameter p-id           as integer   no-undo .
      142   define input  parameter p-ssg-summa    as decimal   no-undo .
      143   define input  parameter p-use-discnt           as logical   no-undo .
      144   define input  parameter p-discnt-pc            as decimal   no-undo .
      145   define input  parameter p-discnt-method-round  as character no-undo .
      146   define input  parameter p-stts         as integer   no-undo .
      147   define input  parameter p-db-num-usr   as integer   no-undo .
      148   define input  parameter p-userid       as character no-undo .
      149   define output parameter p-recid as recid no-undo .
      150     do
      151     on error undo, return error return-value
      152     :
      153   find first ub.sum-in-sum-group exclusive-lock where
      154           ub.sum-in-sum-group.sgr-db-num   = p-db-num  and
      155           ub.sum-in-sum-group.sgr-id       = p-id      and
      156           ub.sum-in-sum-group.ssg-summa    = p-ssg-summa
      157           no-error .
      158         if not available ub.sum-in-sum-group then do:
      159             create ub.sum-in-sum-group.
      160               assign
      161                   ub.sum-in-sum-group.sgr-db-num          = p-db-num
      162                   ub.sum-in-sum-group.sgr-id              = p-id
      163                   ub.sum-in-sum-group.ssg-summa           = p-ssg-summa
      164                   ub.sum-in-sum-group.use-discnt          = p-use-discnt
      165                   ub.sum-in-sum-group.discnt-pc           = p-discnt-pc
      166                   ub.sum-in-sum-group.discnt-method-round = p-discnt-method-round
      167               .
      168         end.
      169         assign
      170           ub.sum-in-sum-group.db-num-chg    = p-db-num-usr
      171           ub.sum-in-sum-group.stts          = p-stts
      172           ub.sum-in-sum-group.sys-date      = today
      173           ub.sum-in-sum-group.sys-time      = time
      174           ub.sum-in-sum-group.sys-time-chr  = string ( ub.sum-in-sum-group.sys-time,"hh:mm" )
      175           ub.sum-in-sum-group.who           = p-userid
      176           ub.sum-in-sum-group.use-discnt          = p-use-discnt
      177           ub.sum-in-sum-group.discnt-pc           = p-discnt-pc
      178           ub.sum-in-sum-group.discnt-method-round = p-discnt-method-round
      179           p-recid = recid ( ub.sum-in-sum-group )
      180         .
      181         run ref/h-grsu.p (buffer ub.sum-in-sum-group , input-output v-sec )  .
      182     end.
      183   end procedure.
      184   PROCEDURE SIS-DEL :
      185   define input  parameter p-db-num       as integer   no-undo .
      186   define input  parameter p-id           as integer   no-undo .
      187   define input  parameter p-ssg-summa    as decimal   no-undo .
      188   define input  parameter p-db-num-usr   as integer   no-undo .
      189   define input  parameter p-userid       as character no-undo .
      190     do
      191     on error undo, return error return-value
      192     :
      193   find first ub.sum-in-sum-group exclusive-lock where
      194           ub.sum-in-sum-group.sgr-db-num   = p-db-num  and
      195           ub.sum-in-sum-group.sgr-id       = p-id      and
      196           ub.sum-in-sum-group.ssg-summa = p-ssg-summa
      197           no-error .
      198    if not available ub.sum-in-sum-group then  return error .
      199         assign
      200           ub.sum-in-sum-group.db-num-chg    = p-db-num-usr
      201           ub.sum-in-sum-group.stts          = 1
      202           ub.sum-in-sum-group.sys-date      = today
      203           ub.sum-in-sum-group.sys-time      = time
      204           ub.sum-in-sum-group.sys-time-chr  = string(ub.sum-in-sum-group.sys-time,"hh:mm")
      205           ub.sum-in-sum-group.who           = p-userid
      206         .
      207         run ref/h-grsu.p (buffer ub.sum-in-sum-group , input-output v-sec )  .
      208     end.
      209   end procedure.
      210   PROCEDURE SIS-UPDATE :
      211   define input  parameter p-recid as recid no-undo .
      212   define input  parameter p-db-num       as integer   no-undo .
      213   define input  parameter p-id           as integer   no-undo .
      214   define input  parameter p-ssg-summa    as decimal   no-undo .
      215   define input  parameter p-use-discnt           as logical   no-undo .
      216   define input  parameter p-discnt-pc            as decimal   no-undo .
      217   define input  parameter p-discnt-method-round  as character no-undo .
      218   define input  parameter p-stts         as integer   no-undo .
      219   define input  parameter p-db-num-usr   as integer   no-undo .
      220   define input  parameter p-userid       as character no-undo .
      221     do
      222     on error undo, return error return-value
      223     :
      224   find first ub.sum-in-sum-group exclusive-lock where
      225              recid(ub.sum-in-sum-group) = p-recid
      226              no-error .
      227         if not available ub.sum-in-sum-group then do:
      228             create ub.sum-in-sum-group.
      229               assign
      230                   ub.sum-in-sum-group.sgr-db-num          = p-db-num
      231                   ub.sum-in-sum-group.sgr-id              = p-id
      232                   ub.sum-in-sum-group.ssg-summa           = p-ssg-summa
      233                   ub.sum-in-sum-group.use-discnt          = p-use-discnt
      234                   ub.sum-in-sum-group.discnt-pc           = p-discnt-pc
      235                   ub.sum-in-sum-group.discnt-method-round = p-discnt-method-round
      236               .
      237         end.
      238         assign
      239           ub.sum-in-sum-group.sgr-db-num          = p-db-num
      240           ub.sum-in-sum-group.sgr-id              = p-id
      241           ub.sum-in-sum-group.ssg-summa           = p-ssg-summa
      242           ub.sum-in-sum-group.db-num-chg          = p-db-num-usr
      243           ub.sum-in-sum-group.stts                = p-stts
      244           ub.sum-in-sum-group.sys-date            = today
      245           ub.sum-in-sum-group.sys-time            = time
      246           ub.sum-in-sum-group.sys-time-chr        = string ( ub.sum-in-sum-group.sys-time , "hh:mm" )
      247           ub.sum-in-sum-group.who                 = p-userid
      248           ub.sum-in-sum-group.use-discnt          = p-use-discnt
      249           ub.sum-in-sum-group.discnt-pc           = p-discnt-pc
      250           ub.sum-in-sum-group.discnt-method-round = p-discnt-method-round
      251         .
      252         run ref/h-grsu.p (buffer ub.sum-in-sum-group , input-output v-sec )  .
      253     end.
      254   end procedure.
      255   DEFINE BUTTON B-Cancel AUTO-END-KEY
      256        LABEL "Отмена"
      257        SIZE 10 BY 1
      258        BGCOLOR 8 .
      259   DEFINE BUTTON B-Help
      260        LABEL "Помо&щь"
      261        SIZE 10 BY 1
      262        BGCOLOR 8 .
      263   DEFINE BUTTON B-save AUTO-GO
      264        LABEL "Ввод"
      265        SIZE 10 BY 1
      266        BGCOLOR 8 .
      267   DEFINE VARIABLE rubl AS CHARACTER FORMAT "X(256)":U
      268         VIEW-AS TEXT
      269        SIZE 14 BY .67
      270        FGCOLOR 4  NO-UNDO.
      271   DEFINE VARIABLE V-discnt-method-round LIKE ub.sum-in-sum-group.discnt-method-round
      272        LABEL "Метод округления по скидке"
      273        VIEW-AS FILL-IN
      274        SIZE 25 BY 1 NO-UNDO.
      275   DEFINE VARIABLE v-discnt-pc LIKE ub.sum-in-sum-group.discnt-pc
      276        LABEL "Процент скидки"
      277        VIEW-AS FILL-IN
      278        SIZE 7 BY 1 NO-UNDO.
      279   DEFINE VARIABLE v-name LIKE ub.sum-group.name
      280         VIEW-AS TEXT
      281        SIZE 55 BY .67
      282        FGCOLOR 1  NO-UNDO.
      283   DEFINE VARIABLE v-ssg-summa LIKE ub.sum-in-sum-group.ssg-summa
      284        LABEL "Сумма в суммовой группе"
      285        VIEW-AS FILL-IN
      286        SIZE 26.5 BY 1 NO-UNDO.
      287   DEFINE VARIABLE v-use-d AS LOGICAL INITIAL no
      288        LABEL "Использовать скидку"
      289        VIEW-AS TOGGLE-BOX
      290        SIZE 28 BY .83 NO-UNDO.
      291   DEFINE QUERY Dialog-Frame FOR
      292         ub.sum-in-sum-group SCROLLING.
      293   DEFINE FRAME Dialog-Frame
      294        B-save AT ROW 1 COL 1
      295        B-Cancel AT ROW 1 COL 11
      296        B-Help AT ROW 1 COL 77
      297        v-ssg-summa AT ROW 4.75 COL 33.5 COLON-ALIGNED HELP
      298             ""
      299             LABEL "Сумма в суммовой группе" FORMAT ">>>,>>>,>>>,>>9.99"
      300        v-use-d AT ROW 5.75 COL 35.5
      301        v-discnt-pc AT ROW 6.75 COL 33.5 COLON-ALIGNED HELP
      302             ""
      303             LABEL "Процент скидки" FORMAT ">>9.99"
      304        V-discnt-method-round AT ROW 7.92 COL 33.5 COLON-ALIGNED HELP
      305             ""
      306             LABEL "Метод округления по скидке" FORMAT "X(28)"
      307        v-name AT ROW 2.67 COL 12 COLON-ALIGNED HELP
      308             "" NO-LABEL FORMAT "X(80)"
      309             FGCOLOR 1
      310        rubl AT ROW 4.88 COL 60.75 COLON-ALIGNED NO-LABEL
      311        SPACE(10.74) SKIP(5.48)
      312       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      313            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      314            TITLE "Добавление суммовой группы для ценообразования"
      315            DEFAULT-BUTTON B-save CANCEL-BUTTON B-Cancel.
      316   ASSIGN
      317          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      318          FRAME Dialog-Frame:HIDDEN           = TRUE.
      319   ASSIGN
      320          V-discnt-method-round:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      321   ASSIGN
      322          v-use-d:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      323   ON GO OF FRAME Dialog-Frame
      324   DO:
      325     RUN save-proc in this-procedure no-error .
      326     if error-status :error then return no-apply .
      327   END.
      328   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      329   DO:
      330     APPLY "END-ERROR":U TO SELF.
      331   END.
      332   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      333   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      334   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      335   on help of frame Dialog-Frame
      336   do:
      337     run gbl/app_help.p
      338       (input this-procedure :file-name
      339       ,input ''
      340       ,input ?
      341       ) no-error.
      342     if error-status :error then do:
      343       message
      344         "Ошибка при вызове помощи"
      345         error-status :get-message(1)
      346         view-as alert-box .
      347     end.
      348   end.
      349   run minbtn-set in this-procedure .
      350   on choose of b-help in frame Dialog-Frame
      351   do:
      352     apply "help":u to frame Dialog-Frame .
      353   end.
      354   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      355   procedure minbtn-set :
      356       do
      357           on error undo, return error return-value
      358           :
      359           define variable ii              as integer       no-undo .
      360           define variable fh              as widget-handle no-undo .
      361           define variable hh              as widget-handle no-undo .
      362           define variable v-h             as handle        extent 4 no-undo .
      363           define variable v-name-button   as character     no-undo .
      364           define variable v-help-old-x    as decimal       no-undo .
      365           define variable v-help-old-y    as decimal       no-undo .
      366           define variable v-help-old-size as decimal       no-undo .
      367           define variable v-frame-width   as decimal       no-undo .
      368           define variable jj              as integer       no-undo .
      369           do
      370               on error undo, return error
      371               :
      372               assign
      373                   v-frame-width = frame Dialog-Frame:width - 0.3
      374                   fh            = frame Dialog-Frame:first-child
      375                   hh            = fh:first-child
      376                   ii            = 1
      377                   .
      378               do while valid-handle(hh):
      379                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      380                   do:
      381                       case lc(hh:name) :
      382                           when "b-help" then
      383                               do:
      384                                   hh:load-image-up("cmp/b-help.bmp":u) .
      385                                   hh:load-image-down("cmp/b-help.bmp":u) .
      386                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      387                                   hh:TOOLTIP = "Помощь" .
      388                                   v-help-old-x = hh:column .
      389                                   v-help-old-y = hh:row    .
      390                                   v-help-old-size = hh:width .
      391                                   hh:width-chars = 2.5 .
      392                               end.
      393                           when "b-print" then
      394                               do:
      395                                   hh:load-image("cmp/b-print.bmp":u) .
      396                                   hh:TOOLTIP = "Печать" .
      397                                   v-h[ii] = hh:handle .
      398                                   ii = ii + 1 .
      399                                   hh:width-chars = 3 .
      400                               end.
      401                           when "b-history" or
      402                           when "b-hist" then
      403                               do:
      404                                   hh:load-image("cmp/b-hist.bmp":u) .
      405                                   hh:TOOLTIP = "История" .
      406                                   v-h[ii] = hh:handle .
      407                                   ii = ii + 1 .
      408                                   hh:width-chars = 3 .
      409                               end.
      410                           when "b-sch" then
      411                               do:
      412                                   hh:load-image("cmp/b-sch.bmp":u) .
      413                                   hh:TOOLTIP = "Установка Фильтра" .
      414                                   v-h[ii] = hh:handle .
      415                                   ii = ii + 1 .
      416                                   hh:width-chars = 3 .
      417                               end.
      418                           when "b-hist-user" then
      419                               do:
      420                                   hh:load-image("cmp/b-hist.bmp":u) .
      421                                   hh:TOOLTIP = "История пользователя" .
      422                                   ii = ii + 1 .
      423                               end.
      424                       end case.
      425                   end.
      426                   hh = hh:next-sibling.
      427               end.
      428               b-help:column = v-frame-width - b-help:width-chars.
      429               jj = 0.
      430               repeat ii = 4 to 1 by -1 :
      431                   if valid-handle (v-h[ii] ) then
      432                   do:
      433                       jj  = jj + 1 .
      434                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      435                       v-h[ii]:row    = v-help-old-y .
      436                   end.
      437               end.
      438           end.
      439       end.
      440   end procedure.
      441   MAIN-BLOCK:
      442   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      443      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      444     run init-proc in this-procedure .
      445     run enable_ui in this-procedure .
      446     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      447        disable v-ssg-summa with frame Dialog-Frame.
      448        WAIT-FOR GO OF FRAME Dialog-Frame FOCUS v-discnt-pc .
      449     end.
      450     else do:
      451        WAIT-FOR GO OF FRAME Dialog-Frame FOCUS v-ssg-summa .
      452     end.
      453   END.
      454   run disable_ui in this-procedure .
      455   PROCEDURE disable_UI :
      456     HIDE FRAME Dialog-Frame.
      457   END PROCEDURE.
      458   PROCEDURE enable_UI :
      459     OPEN QUERY Dialog-Frame FOR EACH ub.sum-in-sum-group SHARE-LOCK.
      460     GET FIRST Dialog-Frame.
      461     DISPLAY v-ssg-summa v-discnt-pc v-name rubl
      462         WITH FRAME Dialog-Frame.
      463     ENABLE B-save B-Cancel B-Help v-ssg-summa v-discnt-pc v-name
      464         WITH FRAME Dialog-Frame.
      465     VIEW FRAME Dialog-Frame.
      466   END PROCEDURE.
      467   PROCEDURE init-proc :
      468     define buffer buf_sum-in-sum-group for ub.sum-in-sum-group  .
      469     v-name = p-name .
      470     rubl = "РУБ" .
      471     if p-mode = 'ИЗМЕНЕНИЕ':U  then do:
      472     find first buf_sum-in-sum-group no-lock where recid ( buf_sum-in-sum-group ) = p-recid no-error .
      473     if not available buf_sum-in-sum-group then
      474     message
      475       vss-workfile vss-revision vss-description skip
      476       error-status :get-message(1) skip
      477       return-value skip
      478       "Ошибка "
      479       view-as alert-box error
      480     .
      481     assign
      482      v-ssg-summa  =  buf_sum-in-sum-group.ssg-summa
      483      v-use-d      =  buf_sum-in-sum-group.use-discnt
      484      v-discnt-pc  =  buf_sum-in-sum-group.discnt-pc
      485      V-discnt-method-round =  buf_sum-in-sum-group.discnt-method-round
      486     .
      487     end.
      488   END PROCEDURE.
      489   PROCEDURE save-proc :
      490   ASSIGN frame Dialog-Frame
      491       V-discnt-method-round
      492       v-discnt-pc
      493       v-ssg-summa
      494       v-use-d
      495        .
      496   if v-discnt-pc >= 100 then do:
      497      message "Процент не может быть 100 и выше !"  view-as alert-box error .
      498      return error return-value .
      499   end.
      500   if p-mode = 'ДОБАВЛЕНИЕ':U then
      501   run sis-add in this-procedure (
      502    input  p-db-num      ,
      503    input  p-id          ,
      504    input  v-ssg-summa   ,
      505    input  v-use-d  ,
      506    input  v-discnt-pc   ,
      507    input  v-discnt-method-round,
      508    input  0        ,
      509    input  v-cntxt-db-num  ,
      510    input  v-cntxt-userid  ,
      511    output p-recid).
      512   else
      513   run sis-update in this-procedure (
      514    input p-recid ,
      515    input  p-db-num      ,
      516    input  p-id          ,
      517    input  v-ssg-summa   ,
      518    input  v-use-d  ,
      519    input  v-discnt-pc   ,
      520    input  v-discnt-method-round,
      521    input  0        ,
      522    input  v-cntxt-db-num  ,
      523    input  v-cntxt-userid
      524    ).
      525   END PROCEDURE.
