     3181   do:
     3182     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3183       (input  v-cntxt-db-num
     3184       ,input  v-cntxt-userid
     3185       ,input  0
     3186       ,input  'actn_client-requisite_add-upd':U
     3187       ,input  'global':U
     3188       ,input  0
     3189       ,input  '':U
     3190       ,input  0
     3191       ,input  0
     3192       ,input  0
     3193       ,input  0
     3194       ,input  false
     3195       ,output log-res
     3196       )  .
