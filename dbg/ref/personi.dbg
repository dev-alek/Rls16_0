     1399          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1400   ASSIGN
     1401          B-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-add:HANDLE.
     1402   ASSIGN
     1403          tt-clients.PS:RETURN-INSERTED IN FRAME Dialog-Frame  = TRUE.
     1404   ASSIGN
     1405          tt-person.psn-code:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-psn-code:HANDLE.
     1406   ON GO OF FRAME Dialog-Frame
     1407   DO:
     1408     run proc-save in this-procedure no-error.
     1409     if error-status:error then return no-apply.
     1410   END.
     1411   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1412   DO:
     1413     APPLY "END-ERROR":U TO SELF.
     1414   END.
     1415   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1416   DO:
     1417     DEFINE VARIABLE v-option AS CHARACTER NO-UNDO.
     1418   IF add-option = '':U THEN DO:
     1419       run gbl/pop-up.p ( input self :handle, input no ) no-error.
     1420      if error-status :error then do: return no-apply. end.
     1421   END.
     1422   if add-option = '':U then return no-apply.
     1423   v-option = add-option.
     1424   add-option = '':U.
     1425   run proc-b-add-staff in this-procedure ( input v-option) no-error.
     1426   if error-status:error then do:
     1427      return no-apply.
     1428   end.
     1429   END.
     1430   ON CHOOSE OF b-attr IN FRAME Dialog-Frame
     1431   DO:
     1432    define variable v-updated as logical no-undo .
     1433    define variable v-is-error as logical no-undo .
     1434    run ref/ca-attrr.p (
     1435                       input parparentproc
     1436                      ,input 'ПРОСМОТР':U
     1437                      ,input 'чел':U
     1438                      ,input tt-person.psn-code
     1439                      ,input YES
     1440                      ,output v-updated
     1441                      ,output v-is-error
     1442                      ) no-error.
     1443     if error-status:error
     1444     or v-is-error then do:
     1445       message
     1446       "Ошибка при вызове списка атрибутов клиента" skip
     1447       error-status:get-message(1) skip
     1448       return-value
     1449       view-as alert-box .
     1450       undo, return no-apply.
     1451     end.
     1452   END.
     1453   ON CHOOSE OF b-bank IN FRAME Dialog-Frame
     1454   DO:
     1455   define variable v-rid-list as character no-undo .
     1456   define variable v-rid as recid no-undo .
     1457   define variable glog as logical no-undo .
     1458   define variable v-status_ like ub.fin-schet.status_ no-undo init 'все':U.
     1459   if p-mode = 'ДОБАВЛЕНИЕ':U  then do:
     1460     glog = no.
     1461     message "Вы завершили ввод карточки клиента?"
     1462     view-as alert-box QUESTION buttons YEs-No update glog.
     1463     if not glog then return no-apply.
     1464     if glog then do:
     1465       run proc-save in this-procedure no-error .
     1466       if error-status:error then undo, return no-apply.
     1467       assign
     1468       p-mode = 'ИЗМЕНЕНИЕ':U.
     1469       run fill-table in this-procedure no-error .
     1470       if error-status:error then do:
     1471         undo, return no-apply .
     1472       end.
     1473       run Myenable in this-procedure .
     1474     END.
     1475   end.
     1476       run ref/finschts.w (
     1477                         INPUT parParentProc
     1478                        ,input v-cntxt-host-code-obj
     1479                        ,input "b-add":U
     1480                        ,input "cmp-host":U
     1481                        ,input 'чел':U
     1482                        ,input tt-person.psn-code
     1483                        ,input ?
     1484                        ,input v-cntxt-host-code-obj
     1485                        ,input 0
     1486                        ,input-output v-status_
     1487                        ,input-output v-rid-list ).
     1488   END.
     1489   ON CHOOSE OF b-dc IN FRAME Dialog-Frame
     1490   DO:
     1491   define variable rid-list    as  char no-undo .
     1492   run ref/discards.w (
     1493                   input parparentproc
     1494                  ,input ""
     1495                  ,input "client":U
     1496                  ,input v-cntxt-host-code-obj
     1497                  ,input v-cntxt-obj-type
     1498                  ,input v-cntxt-obj-code
     1499                  ,input '':U
     1500                  ,recid( locked_clients )
     1501                  ,output rid-list ).
     1502   END.
     1503   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1504   DO:
     1505     IF NOT AVAILABLE tt-staff THEN RETURN NO-APPLY.
     1506     DELETE tt-staff.
     1507     OPEN QUERY br-staff FOR  EACH tt-staff INDEXED-REPOSITION.
     1508   END.
     1509   ON CHOOSE OF b-hist IN FRAME Dialog-Frame
     1510   DO:
     1511   define variable v-rid-list as character no-undo .
     1512        run ref/cclihist.w (
     1513                         input parparentproc
     1514                       , input 0
     1515                       , input "":U
     1516                       , input 0
     1517                       , input "":U
     1518                       , input "one":U
     1519                       , input 'чел':U
     1520                       , input tt-person.psn-code
     1521                       , input ?
     1522                       , input ?
     1523                       , input "":U
     1524                       , input "":U
     1525                       , input v-cntxt-db-num
     1526                       , input-output v-rid-list  ) no-error .
     1527   END.
     1528   ON CHOOSE OF b-org IN FRAME Dialog-Frame
     1529   DO:
     1530     run ref/rpsn-org.w ( INPUT parParentProc, INPUT tt-person.psn-code ).
     1531   END.
     1532   ON CHOOSE OF b-region IN FRAME Dialog-Frame
     1533   DO:
     1534     define buffer buf_regions for ub.regions.
     1535     define variable v-reg-code like ub.regions.reg-code no-undo .
     1536     run ref/regions.w ( input  parParentProc
     1537                       , input  'выбор':U
     1538                       , output v-reg-code
     1539                       ).
     1540     if v-reg-code <> ? then do :
     1541       find first buf_regions no-lock
     1542         where buf_regions.reg-code = v-reg-code
     1543       no-error .
     1544       if not available buf_regions then do:
     1545         message
     1546           "Неверный код региона " v-reg-code
     1547         view-as alert-box error.
     1548         return no-apply.
     1549       end.
     1550       else do:
     1551         assign
     1552           tt-clients.reg-code = buf_regions.reg-code
     1553         .
     1554         display
     1555           tt-clients.reg-code
     1556         with frame Dialog-Frame.
     1557       end.
     1558     end.
     1559   END.
     1560   ON CHOOSE OF Docs IN FRAME Dialog-Frame
     1561   DO:
     1562   DEFINE VARIABLE v-output as character no-undo.
     1563   define variable v-input-output as character no-undo .
     1564   run str/all-docs.w (
     1565                       input parparentproc
     1566                       ,input ?
     1567                       ,input ?
     1568                       ,input ?
     1569                       ,input 'Контрагент':U
     1570                       ,input ?
     1571                       ,input ?
     1572                       ,input ?
     1573                       ,input ?
     1574                       ,input '':U
     1575                       ,input '':U
     1576                       ,input ?
     1577                       ,input recid(locked_clients)
     1578                       ,output v-input-output
     1579                       ) no-error .
     1580    apply "ENTRY" to b-exit.
     1581   END.
     1582   ON LEAVE OF tt-person.inn IN FRAME Dialog-Frame
     1583   DO:
     1584   define variable v-correct-inn as logical no-undo .
     1585   END.
     1586   ON VALUE-CHANGED OF jj_change-address IN FRAME Dialog-Frame
     1587   DO:
     1588   ASSIGN jj_change-address.
     1589   CASE jj_change-address:
     1590     when 0 THEN DO:
     1591       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1592         ASSIGN
     1593         tt-person.post-address
     1594         tt-person.post-city
     1595         tt-person.post-ind
     1596         .
     1597       end.
     1598       DISABLE
     1599       tt-person.post-address
     1600       tt-person.post-city
     1601       tt-person.post-ind
     1602       WITH FRAME Dialog-Frame.
     1603       HIDE
     1604       tt-person.post-address
     1605       tt-person.post-city
     1606       tt-person.post-ind
     1607       IN FRAME Dialog-Frame.
     1608       if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1609         DISPLAY
     1610         tt-person.address
     1611         tt-person.city
     1612         tt-person.ind
     1613         WITH FRAME Dialog-Frame.
     1614       end.
     1615       else do:
     1616         DISPLAY
     1617         tt-person.address
     1618         tt-person.city
     1619         tt-person.ind
     1620         WITH FRAME Dialog-Frame.
     1621       end.
     1622       if p-mode <> 'ПРОСМОТР':U then do:
     1623         ENABLE
     1624         tt-person.address
     1625         tt-person.city
     1626         tt-person.ind
     1627         WITH FRAME Dialog-Frame.
     1628       end.
     1629     END.
     1630     when 1 THEN DO:
     1631       if p-mode = 'ИЗМЕНЕНИЕ':U then
     1632       ASSIGN
     1633       tt-person.address
     1634       tt-person.city
     1635       tt-person.ind
     1636       .
     1637       DISABLE
     1638       tt-person.address
     1639       tt-person.city
     1640       tt-person.ind
     1641       WITH FRAME Dialog-Frame.
     1642       HIDE
     1643       tt-person.address
     1644       tt-person.city
     1645       tt-person.ind
     1646       IN FRAME Dialog-Frame.
     1647       if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1648         DISPLAY
     1649         tt-person.post-address
     1650         tt-person.post-city
     1651         tt-person.post-ind
     1652         WITH FRAME Dialog-Frame.
     1653       end.
     1654       else do:
     1655         DISPLAY
     1656         tt-person.post-address
     1657         tt-person.post-city
     1658         tt-person.post-ind
     1659         WITH FRAME Dialog-Frame.
     1660       end.
     1661       if p-mode <> 'ПРОСМОТР':U then do:
     1662         ENABLE
     1663         tt-person.post-address
     1664         tt-person.post-city
     1665         tt-person.post-ind
     1666         WITH FRAME Dialog-Frame.
     1667       end.
     1668     END.
     1669   END CASE.
     1670   END.
     1671   ON LEAVE OF tt-person.kpp IN FRAME Dialog-Frame
     1672   DO:
     1673   define variable checked as decimal.
     1674   assign
     1675   checked = decimal(input frame Dialog-Frame tt-person.kpp) No-error.
     1676   if error-status:error or NOT (checked = truncate(checked,0)) then do:
     1677       message "Нечисловой или неправильный КПП!" view-as alert-box.
     1678       return no-apply.
     1679   end.
     1680   END.
     1681   ON CHOOSE OF MENU-ITEM m-choose
     1682   DO:
     1683      DEFINE VARIABLE v-obj-code LIKE ub.clients.obj-code NO-UNDO.
     1684     run ref/chs-code.w (
     1685                      input 'чел':U
     1686                    , input v-cntxt-db-num
     1687                    , OUTPUT v-obj-code) no-error .
     1688     if not error-status:error
     1689     and v-obj-code <> ? then do:
     1690       display
     1691       v-obj-code @ tt-person.psn-code
     1692       with frame Dialog-Frame .
     1693     end.
     1694   END.
     1695   ON CHOOSE OF MENU-ITEM m_cashier
     1696   DO:
     1697     ASSIGN
     1698     add-option = 'C':U.
     1699     APPLY "CHOOSE" TO b-add IN FRAME Dialog-Frame.
     1700   END.
     1701   ON CHOOSE OF MENU-ITEM m_seller
     1702   DO:
     1703       ASSIGN
     1704       add-option = 'S':U.
     1705       APPLY "CHOOSE" TO b-add IN FRAME Dialog-Frame.
     1706   END.
     1707   ON LEAVE OF tt-person.passp-num IN FRAME Dialog-Frame
     1708   DO:
     1709     IF trim(tt-person.passp-num:SCREEN-VALUE) = "":U THEN
     1710         ASSIGN
     1711         tt-person.passp-num:SCREEN-VALUE = ?.
     1712   END.
     1713   ON VALUE-CHANGED OF tt-clients.turnover-buyer IN FRAME Dialog-Frame
     1714   DO:
     1715     ASSIGN tt-clients.turnover-buyer .
     1716     IF tt-clients.turnover-buyer THEN ENABLE tt-clients.turnover-buyer-gds WITH FRAME Dialog-Frame.
     1717         ELSE DISABLE tt-clients.turnover-buyer-gds WITH FRAME Dialog-Frame.
     1718   END.
     1719   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1720   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1721   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1722   on help of frame Dialog-Frame
     1723   do:
     1724     run gbl/app_help.p
     1725       (input this-procedure :file-name
     1726       ,input ''
     1727       ,input ?
     1728       ) no-error.
     1729     if error-status :error then do:
     1730       message
     1731         "Ошибка при вызове помощи"
     1732         error-status :get-message(1)
     1733         view-as alert-box .
     1734     end.
     1735   end.
     1736   run minbtn-set in this-procedure .
     1737   on choose of b-help in frame Dialog-Frame
     1738   do:
     1739     apply "help":u to frame Dialog-Frame .
     1740   end.
     1741   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1742   procedure minbtn-set :
     1743       do
     1744           on error undo, return error return-value
     1745           :
     1746           define variable ii              as integer       no-undo .
     1747           define variable fh              as widget-handle no-undo .
     1748           define variable hh              as widget-handle no-undo .
     1749           define variable v-h             as handle        extent 4 no-undo .
     1750           define variable v-name-button   as character     no-undo .
     1751           define variable v-help-old-x    as decimal       no-undo .
     1752           define variable v-help-old-y    as decimal       no-undo .
     1753           define variable v-help-old-size as decimal       no-undo .
     1754           define variable v-frame-width   as decimal       no-undo .
     1755           define variable jj              as integer       no-undo .
     1756           do
     1757               on error undo, return error
     1758               :
     1759               assign
     1760                   v-frame-width = frame Dialog-Frame:width - 0.3
     1761                   fh            = frame Dialog-Frame:first-child
     1762                   hh            = fh:first-child
     1763                   ii            = 1
     1764                   .
     1765               do while valid-handle(hh):
     1766                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1767                   do:
     1768                       case lc(hh:name) :
     1769                           when "b-help" then
     1770                               do:
     1771                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1772                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1773                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1774                                   hh:TOOLTIP = "Помощь" .
     1775                                   v-help-old-x = hh:column .
     1776                                   v-help-old-y = hh:row    .
     1777                                   v-help-old-size = hh:width .
     1778                                   hh:width-chars = 2.5 .
     1779                               end.
     1780                           when "b-print" then
     1781                               do:
     1782                                   hh:load-image("cmp/b-print.bmp":u) .
     1783                                   hh:TOOLTIP = "Печать" .
     1784                                   v-h[ii] = hh:handle .
     1785                                   ii = ii + 1 .
     1786                                   hh:width-chars = 3 .
     1787                               end.
     1788                           when "b-history" or
     1789                           when "b-hist" then
     1790                               do:
     1791                                   hh:load-image("cmp/b-hist.bmp":u) .
     1792                                   hh:TOOLTIP = "История" .
     1793                                   v-h[ii] = hh:handle .
     1794                                   ii = ii + 1 .
     1795                                   hh:width-chars = 3 .
     1796                               end.
     1797                           when "b-sch" then
     1798                               do:
     1799                                   hh:load-image("cmp/b-sch.bmp":u) .
     1800                                   hh:TOOLTIP = "Установка Фильтра" .
     1801                                   v-h[ii] = hh:handle .
     1802                                   ii = ii + 1 .
     1803                                   hh:width-chars = 3 .
     1804                               end.
     1805                           when "b-hist-user" then
     1806                               do:
     1807                                   hh:load-image("cmp/b-hist.bmp":u) .
     1808                                   hh:TOOLTIP = "История пользователя" .
     1809                                   ii = ii + 1 .
     1810                               end.
     1811                       end case.
     1812                   end.
     1813                   hh = hh:next-sibling.
     1814               end.
     1815               b-help:column = v-frame-width - b-help:width-chars.
     1816               jj = 0.
     1817               repeat ii = 4 to 1 by -1 :
     1818                   if valid-handle (v-h[ii] ) then
     1819                   do:
     1820                       jj  = jj + 1 .
     1821                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1822                       v-h[ii]:row    = v-help-old-y .
     1823                   end.
     1824               end.
     1825           end.
     1826       end.
     1827   end procedure.
     1828   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1829   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1830   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1831   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1832   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1833   define variable v-diasize-current-frame-height as decimal   no-undo .
     1834   define variable v-diasize-change-size          as logical   no-undo .
     1835   define variable v-diasize-resize-button        as handle    no-undo .
     1836   define variable v-diasize-wndmax               as logical   no-undo .
     1837   define variable v-diasize-wndstore             as logical   no-undo .
     1838   define variable v-diasize-proc-name            as character no-undo .
     1839   define variable v-diasize-browse-handle        as handle    no-undo .
     1840   define variable v-diasize-browse-number        as integer   no-undo .
     1841   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1842   define temp-table temp-diasize-handle no-undo
     1843     field handle-value  as handle
     1844     field save-position as decimal
     1845     index xpk is primary unique handle-value
     1846     .
     1847   define temp-table temp-browse-handle no-undo
     1848     field browse-type   as character
     1849     field browse-number as integer
     1850     field browse-handle as handle
     1851     field original-size as decimal
     1852     index xpk is primary unique browse-type browse-number
     1853     index xie browse-type browse-handle
     1854   .
     1855   procedure diasize_change-height :
     1856     define input  parameter p-change-value  as decimal   no-undo .
     1857     define input  parameter p-move-resize   as logical   no-undo .
     1858     define variable v-field-group-handle    as handle    no-undo .
     1859     define variable v-object-handle         as handle    no-undo .
     1860     define variable v-frame-height          as decimal   no-undo .
     1861     define variable v-frame-virtual-height  as decimal   no-undo .
     1862     define variable v-browse-height         as decimal   no-undo .
     1863     define variable v-window-height         as decimal   no-undo .
     1864     define variable v-window-virtual-height as decimal   no-undo .
     1865     define variable v-change-sign           as integer   no-undo .
     1866     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1867     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1868     if p-change-value > 0
     1869     then do:
     1870       if frame Dialog-Frame :height + p-change-value
     1871           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1872       then do:
     1873         assign
     1874           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1875                           - (frame Dialog-Frame :height-chars)
     1876         .
     1877         if p-change-value <= 0
     1878         then do:
     1879           run diasize_position-resize-button in this-procedure .
     1880           return .
     1881         end.
     1882       end.
     1883     end.
     1884     if p-change-value < 0
     1885     then do:
     1886       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1887       then do:
     1888         assign
     1889           p-change-value = v-diasize-orig-frame-height
     1890                          - (frame Dialog-Frame :height-chars)
     1891         .
     1892         if p-change-value >= 0
     1893         then do:
     1894           run diasize_position-resize-button in this-procedure .
     1895           return .
     1896         end.
     1897       end.
     1898     end.
     1899     if p-change-value >= 0
     1900     then do:
     1901       assign
     1902         v-change-sign = 1
     1903       .
     1904     end.
     1905     else do:
     1906       assign
     1907         v-change-sign = -1
     1908       .
     1909     end.
     1910     assign
     1911       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1912     .
     1913     if p-change-value = 0
     1914     then do:
     1915       run diasize_position-resize-button in this-procedure .
     1916       return .
     1917     end.
     1918     move_block:
     1919     do
     1920     on error undo move_block, retry move_block
     1921     :
     1922       if retry
     1923       then do:
     1924         do
     1925         on error undo move_block, leave move_block
     1926         :
     1927           if p-change-value > 0
     1928           then do:
     1929             for each buf_temp-diasize-handle
     1930             on error undo, next
     1931             :
     1932               assign
     1933                 v-object-handle = buf_temp-diasize-handle.handle-value
     1934               .
     1935               if v-object-handle <> v-diasize-resize-button
     1936               then do:
     1937                 assign
     1938                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1939                 .
     1940               end.
     1941             end.
     1942             assign
     1943               v-diasize-browse-handle :height = v-browse-height
     1944             .
     1945             for each buf_temp-browse-handle
     1946               where buf_temp-browse-handle.browse-type = 'height':u
     1947             on error undo, next
     1948             :
     1949               assign
     1950                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1951               .
     1952             end.
     1953             assign
     1954               frame Dialog-Frame :height = v-frame-height
     1955             .
     1956             if frame Dialog-Frame :scrollable = true
     1957             then do:
     1958               assign
     1959                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1960               .
     1961             end.
     1962             run diasize_position-resize-button in this-procedure .
     1963           end.
     1964           else do:
     1965             if frame Dialog-Frame :scrollable = true
     1966             then do:
     1967               assign
     1968                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1969               .
     1970             end.
     1971             assign
     1972               frame Dialog-Frame :height = v-frame-height
     1973             .
     1974             assign
     1975               v-diasize-browse-handle :height = v-browse-height
     1976             .
     1977             for each buf_temp-browse-handle
     1978               where buf_temp-browse-handle.browse-type = 'height':u
     1979             on error undo, next
     1980             :
     1981               assign
     1982                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1983               .
     1984             end.
     1985             for each buf_temp-diasize-handle
     1986             on error undo, next
     1987             :
     1988               assign
     1989                 v-object-handle = buf_temp-diasize-handle.handle-value
     1990               .
     1991               if v-object-handle <> v-diasize-resize-button
     1992               then do:
     1993                 assign
     1994                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1995                 .
     1996               end.
     1997             end.
     1998             run diasize_position-resize-button in this-procedure .
     1999           end.
     2000           assign
     2001             v-diasize-change-size = false
     2002           .
     2003           leave move_block .
     2004         end.
     2005       end.
     2006       assign
     2007         v-diasize-need-full-display = true
     2008       .
     2009       if v-diasize-change-size = false
     2010       then do:
     2011         assign
     2012           v-diasize-change-size = true
     2013         .
     2014       end.
     2015       else do:
     2016         return .
     2017       end.
     2018       assign
     2019         v-frame-height = frame Dialog-Frame :height
     2020         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2021         v-browse-height = v-diasize-browse-handle :height
     2022       .
     2023       for each buf_temp-browse-handle
     2024         where buf_temp-browse-handle.browse-type = 'height':u
     2025       :
     2026         assign
     2027           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2028         .
     2029       end.
     2030       for each buf_temp-diasize-handle
     2031       :
     2032         delete buf_temp-diasize-handle .
     2033       end.
     2034       assign
     2035         v-field-group-handle = frame Dialog-Frame :first-child
     2036       .
     2037       do while valid-handle(v-field-group-handle)
     2038       :
     2039         assign
     2040           v-object-handle = v-field-group-handle :first-child
     2041         .
     2042         do while valid-handle(v-object-handle)
     2043         :
     2044           if  v-object-handle <> v-diasize-browse-handle :handle
     2045           and can-query(v-object-handle, "row")
     2046           and can-query(v-object-handle, "height")
     2047           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2048           then do:
     2049             find first buf_temp-browse-handle
     2050               where buf_temp-browse-handle.browse-type   = 'height':u
     2051                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2052               no-error .
     2053             if available buf_temp-browse-handle
     2054             then do:
     2055             end.
     2056             else do:
     2057               create buf_temp-diasize-handle .
     2058               assign
     2059                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2060                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2061               .
     2062             end.
     2063           end.
     2064           assign
     2065             v-object-handle = v-object-handle :next-sibling
     2066           .
     2067         end.
     2068         assign
     2069           v-field-group-handle = v-field-group-handle :next-sibling
     2070         .
     2071       end.
     2072       do with frame Dialog-Frame
     2073       :
     2074         hide v-diasize-resize-button .
     2075         assign
     2076           v-diasize-resize-button :row    = 1
     2077           v-diasize-resize-button :column = 1
     2078         .
     2079       end.
     2080       if p-change-value > 0
     2081       then do:
     2082         if frame Dialog-Frame :scrollable = true
     2083         then do:
     2084           assign
     2085             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2086             no-error .
     2087           if error-status :error
     2088           or error-status :get-message(1) <> ""
     2089           then do:
     2090             undo move_block, retry move_block .
     2091           end.
     2092         end.
     2093         assign
     2094           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2095           no-error .
     2096         if error-status :error
     2097         or error-status :get-message(1) <> ""
     2098         then do:
     2099           undo move_block, retry move_block .
     2100         end.
     2101         assign
     2102           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2103           no-error .
     2104         if error-status :error
     2105         or error-status :get-message(1) <> ""
     2106         then do:
     2107           undo move_block, retry move_block .
     2108         end.
     2109         for each buf_temp-browse-handle
     2110           where buf_temp-browse-handle.browse-type = 'height':u
     2111         on error undo move_block, retry move_block
     2112         :
     2113           assign
     2114             buf_temp-browse-handle.browse-handle :height
     2115               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2116             no-error .
     2117           if error-status :error
     2118           or error-status :get-message(1) <> ""
     2119           then do:
     2120             undo move_block, retry move_block .
     2121           end.
     2122         end.
     2123         for each buf_temp-diasize-handle
     2124         on error undo move_block, retry move_block
     2125         :
     2126           assign
     2127             v-object-handle = buf_temp-diasize-handle.handle-value
     2128           .
     2129           if v-object-handle <> v-diasize-resize-button
     2130           then do:
     2131             assign
     2132               v-object-handle :row = v-object-handle :row + p-change-value
     2133               no-error .
     2134             if error-status :error
     2135             or error-status :get-message(1) <> ""
     2136             then do:
     2137               undo move_block, retry move_block .
     2138             end.
     2139           end.
     2140         end.
     2141       end.
     2142       else do:
     2143         for each buf_temp-diasize-handle
     2144         on error undo move_block, retry move_block
     2145         :
     2146           assign
     2147             v-object-handle = buf_temp-diasize-handle.handle-value
     2148           .
     2149           if v-object-handle <> v-diasize-resize-button
     2150           then do:
     2151             assign
     2152               v-object-handle :row = v-object-handle :row + p-change-value
     2153               no-error .
     2154             if error-status :error
     2155             or error-status :get-message(1) <> ""
     2156             then do:
     2157               undo move_block, retry move_block .
     2158             end.
     2159           end.
     2160         end.
     2161         assign
     2162           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2163           no-error .
     2164         if error-status :error
     2165         or error-status :get-message(1) <> ""
     2166         then do:
     2167           undo move_block, retry move_block .
     2168         end.
     2169         for each buf_temp-browse-handle
     2170           where buf_temp-browse-handle.browse-type = 'height':u
     2171         on error undo move_block, retry move_block
     2172         :
     2173           assign
     2174             buf_temp-browse-handle.browse-handle :height
     2175               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2176             no-error .
     2177           if error-status :error
     2178           or error-status :get-message(1) <> ""
     2179           then do:
     2180             undo move_block, retry move_block .
     2181           end.
     2182         end.
     2183         assign
     2184           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2185           no-error .
     2186         if error-status :error
     2187         or error-status :get-message(1) <> ""
     2188         then do:
     2189           undo move_block, retry move_block .
     2190         end.
     2191         if frame Dialog-Frame :scrollable = true
     2192         then do:
     2193           assign
     2194             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2195             no-error .
     2196           if error-status :error
     2197           or error-status :get-message(1) <> ""
     2198           then do:
     2199             undo move_block, retry move_block .
     2200           end.
     2201         end.
     2202       end.
     2203       if p-move-resize = true
     2204       then do:
     2205         run diasize_position-resize-button in this-procedure .
     2206       end.
     2207       if v-diasize-wndstore = true
     2208       then do:
     2209         if connected("ub") = true
     2210         then do:
     2211           define variable v-cntxt-db-num        as integer   no-undo .
     2212           define variable v-cntxt-userid        as character no-undo .
     2213           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2214                                             , OUTPUT v-cntxt-userid
     2215                                             ) .
     2216           run gbl/wndsizew.p
     2217             (input  v-cntxt-db-num
     2218             ,input  v-cntxt-userid
     2219             ,input  v-diasize-proc-name
     2220             ,input  'height':u
     2221             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2222             ) .
     2223         end.
     2224       end.
     2225     end.
     2226     assign
     2227       v-diasize-change-size = false
     2228     .
     2229   end procedure.
     2230   procedure diasize_set-height :
     2231     define input  parameter p-new-height  as decimal   no-undo .
     2232     define input  parameter p-move-resize as logical   no-undo .
     2233     do
     2234     on error undo, return error return-value
     2235     :
     2236       run diasize_change-height in this-procedure
     2237         (input  (p-new-height - frame Dialog-Frame :height)
     2238         ,input  p-move-resize
     2239         ) .
     2240     end.
     2241   end procedure.
     2242   procedure diasize_change-width :
     2243     define input  parameter p-change-value as decimal   no-undo .
     2244     define input  parameter p-move-resize  as logical   no-undo .
     2245     define variable v-field-group-handle   as handle    no-undo .
     2246     define variable v-object-handle        as handle    no-undo .
     2247     define variable v-frame-width          as decimal   no-undo .
     2248     define variable v-frame-virtual-width  as decimal   no-undo .
     2249     define variable v-browse-width         as decimal   no-undo .
     2250     define variable v-window-width         as decimal   no-undo .
     2251     define variable v-window-virtual-width as decimal   no-undo .
     2252     define variable v-change-sign          as integer   no-undo .
     2253     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2254     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2255     if p-change-value > 0
     2256     then do:
     2257       if frame Dialog-Frame :width + p-change-value >
     2258           session :width-chars
     2259       then do:
     2260         assign
     2261           p-change-value = session :width-chars - frame Dialog-Frame :width
     2262         .
     2263         if p-change-value <= 0
     2264         then do:
     2265           run diasize_position-resize-button in this-procedure .
     2266           return .
     2267         end.
     2268       end.
     2269     end.
     2270     if p-change-value < 0
     2271     then do:
     2272       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2273       then do:
     2274         assign
     2275           p-change-value = v-diasize-orig-frame-width
     2276                          - frame Dialog-Frame :width
     2277         .
     2278         if p-change-value >= 0
     2279         then do:
     2280           run diasize_position-resize-button in this-procedure .
     2281           return .
     2282         end.
     2283       end.
     2284     end.
     2285     if p-change-value >= 0
     2286     then do:
     2287       assign
     2288         v-change-sign = 1
     2289       .
     2290     end.
     2291     else do:
     2292       assign
     2293         v-change-sign = -1
     2294       .
     2295     end.
     2296     assign
     2297       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2298     .
     2299     if p-change-value = 0
     2300     then do:
     2301       run diasize_position-resize-button in this-procedure .
     2302       return .
     2303     end.
     2304     move_block:
     2305     do
     2306     on error undo move_block, leave move_block
     2307     :
     2308       if retry
     2309       then do:
     2310         do
     2311         on error undo move_block, leave move_block
     2312         :
     2313           if p-change-value > 0
     2314           then do:
     2315             for each buf_temp-diasize-handle
     2316             on error undo, next
     2317             :
     2318               assign
     2319                 v-object-handle = buf_temp-diasize-handle.handle-value
     2320               .
     2321               if v-object-handle <> v-diasize-resize-button
     2322               then do:
     2323                 assign
     2324                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2325                 .
     2326               end.
     2327             end.
     2328             assign
     2329               v-diasize-browse-handle :width = v-browse-width
     2330             .
     2331             for each buf_temp-browse-handle
     2332               where buf_temp-browse-handle.browse-type = 'width':u
     2333             on error undo, next
     2334             :
     2335               assign
     2336                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2337               .
     2338             end.
     2339             assign
     2340               frame Dialog-Frame :width = v-frame-width
     2341             .
     2342             if frame Dialog-Frame :scrollable = true
     2343             then do:
     2344               assign
     2345                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2346               .
     2347             end.
     2348             run diasize_position-resize-button in this-procedure .
     2349           end.
     2350           else do:
     2351             if frame Dialog-Frame :scrollable = true
     2352             then do:
     2353               assign
     2354                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2355               .
     2356             end.
     2357             assign
     2358               frame Dialog-Frame :width = v-frame-width
     2359             .
     2360             for each buf_temp-browse-handle
     2361               where buf_temp-browse-handle.browse-type = 'width':u
     2362             on error undo, next
     2363             :
     2364               assign
     2365                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2366               .
     2367             end.
     2368             assign
     2369               v-diasize-browse-handle :width = v-browse-width
     2370             .
     2371             for each buf_temp-diasize-handle
     2372             on error undo, next
     2373             :
     2374               assign
     2375                 v-object-handle = buf_temp-diasize-handle.handle-value
     2376               .
     2377               if v-object-handle <> v-diasize-resize-button
     2378               then do:
     2379                 assign
     2380                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2381                 .
     2382               end.
     2383             end.
     2384             run diasize_position-resize-button in this-procedure .
     2385           end.
     2386           assign
     2387             v-diasize-change-size = false
     2388           .
     2389           leave move_block .
     2390         end.
     2391       end.
     2392       assign
     2393         v-diasize-need-full-display = true
     2394       .
     2395       if v-diasize-change-size = false
     2396       then do:
     2397         assign
     2398           v-diasize-change-size = true
     2399         .
     2400       end.
     2401       else do:
     2402         return .
     2403       end.
     2404       assign
     2405         v-frame-width = frame Dialog-Frame :width
     2406         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2407         v-browse-width = v-diasize-browse-handle :width
     2408       .
     2409       for each buf_temp-browse-handle
     2410         where buf_temp-browse-handle.browse-type = 'width':u
     2411       :
     2412         assign
     2413           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2414         .
     2415       end.
     2416       for each buf_temp-diasize-handle
     2417       :
     2418         delete buf_temp-diasize-handle .
     2419       end.
     2420       assign
     2421         v-field-group-handle = frame Dialog-Frame :first-child
     2422       .
     2423       do while valid-handle(v-field-group-handle)
     2424       :
     2425         assign
     2426           v-object-handle = v-field-group-handle :first-child
     2427         .
     2428         do while valid-handle(v-object-handle)
     2429         :
     2430           if  v-object-handle <> v-diasize-browse-handle :handle
     2431           and v-object-handle <> v-diasize-resize-button
     2432           and can-query(v-object-handle, "row")
     2433           and can-query(v-object-handle, "height")
     2434           and ( v-object-handle :col + v-object-handle :width
     2435                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2436               )
     2437           then do:
     2438             find first buf_temp-browse-handle
     2439               where buf_temp-browse-handle.browse-type   = 'width':u
     2440                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2441               no-error .
     2442             if available buf_temp-browse-handle
     2443             then do:
     2444             end.
     2445             else do:
     2446               create buf_temp-diasize-handle .
     2447               assign
     2448                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2449                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2450               .
     2451             end.
     2452           end.
     2453           assign
     2454             v-object-handle = v-object-handle :next-sibling
     2455           .
     2456         end.
     2457         assign
     2458           v-field-group-handle = v-field-group-handle :next-sibling
     2459         .
     2460       end.
     2461       do with frame Dialog-Frame
     2462       :
     2463         hide v-diasize-resize-button .
     2464         v-diasize-resize-button :row = 1.
     2465         v-diasize-resize-button :column = 1.
     2466       end.
     2467       if p-change-value > 0
     2468       then do:
     2469         if frame Dialog-Frame :scrollable = true
     2470         then do:
     2471           assign
     2472             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2473             no-error .
     2474           if error-status :error
     2475           or error-status :get-message(1) <> ""
     2476           then do:
     2477             undo move_block, retry move_block.
     2478           end.
     2479         end.
     2480         assign
     2481           frame Dialog-Frame :width = v-frame-width + p-change-value
     2482           no-error .
     2483         if error-status :error
     2484         or error-status :get-message(1) <> ""
     2485         then do:
     2486           undo move_block, retry move_block.
     2487         end.
     2488         assign
     2489           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2490         no-error .
     2491         if error-status :error
     2492         or error-status :get-message(1) <> ""
     2493         then do:
     2494           undo move_block, retry move_block.
     2495         end.
     2496         for each buf_temp-browse-handle
     2497           where buf_temp-browse-handle.browse-type = 'width':u
     2498         on error undo move_block, retry move_block
     2499         :
     2500           assign
     2501             buf_temp-browse-handle.browse-handle :width
     2502               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2503             no-error .
     2504           if error-status :error
     2505           or error-status :get-message(1) <> ""
     2506           then do:
     2507             undo move_block, retry move_block .
     2508           end.
     2509         end.
     2510         for each buf_temp-diasize-handle
     2511         on error undo move_block, retry move_block
     2512         :
     2513           assign
     2514             v-object-handle = buf_temp-diasize-handle.handle-value
     2515           .
     2516           if v-object-handle <> v-diasize-resize-button
     2517           then do:
     2518             assign
     2519               v-object-handle :col = v-object-handle :col + p-change-value
     2520               no-error .
     2521             if error-status :error
     2522             or error-status :get-message(1) <> ""
     2523             then do:
     2524               undo move_block, retry move_block .
     2525             end.
     2526           end.
     2527         end.
     2528       end.
     2529       else do:
     2530         for each buf_temp-diasize-handle
     2531         on error undo move_block, retry move_block
     2532         :
     2533           assign
     2534             v-object-handle = buf_temp-diasize-handle.handle-value
     2535           .
     2536           if v-object-handle <> v-diasize-resize-button
     2537           then do:
     2538             assign
     2539               v-object-handle :col = v-object-handle :col + p-change-value
     2540               no-error .
     2541             if error-status :error
     2542             or error-status :get-message(1) <> ""
     2543             then do:
     2544               undo move_block, retry move_block .
     2545             end.
     2546           end.
     2547         end.
     2548         for each buf_temp-browse-handle
     2549           where buf_temp-browse-handle.browse-type = 'width':u
     2550         on error undo move_block, retry move_block
     2551         :
     2552           assign
     2553             buf_temp-browse-handle.browse-handle :width
     2554               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2555             no-error .
     2556           if error-status :error
     2557           or error-status :get-message(1) <> ""
     2558           then do:
     2559             undo move_block, retry move_block .
     2560           end.
     2561         end.
     2562         assign
     2563           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2564           no-error .
     2565         if error-status :error
     2566         or error-status :get-message(1) <> ""
     2567         then do:
     2568           undo move_block, retry move_block.
     2569         end.
     2570         assign
     2571           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2572         no-error .
     2573         if error-status :error
     2574         or error-status :get-message(1) <> ""
     2575         then do:
     2576           undo move_block, retry move_block.
     2577         end.
     2578         if frame Dialog-Frame :scrollable = true
     2579         then do:
     2580           assign
     2581             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2582           no-error .
     2583           if error-status :error
     2584           or error-status :get-message(1) <> ""
     2585           then do:
     2586             undo move_block, retry move_block.
     2587           end.
     2588         end.
     2589       end.
     2590       if p-move-resize
     2591       then do:
     2592         run diasize_position-resize-button in this-procedure .
     2593       end.
     2594       if v-diasize-wndstore = true
     2595       then do:
     2596         if connected("ub") = true
     2597         then do:
     2598           define variable v-cntxt-db-num        as integer   no-undo .
     2599           define variable v-cntxt-userid        as character no-undo .
     2600           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2601                                             , OUTPUT v-cntxt-userid
     2602                                             ) .
     2603           run gbl/wndsizew.p
     2604             (input  v-cntxt-db-num
     2605             ,input  v-cntxt-userid
     2606             ,input  v-diasize-proc-name
     2607             ,input  'width':u
     2608             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2609             ) .
     2610         end.
     2611       end.
     2612     end.
     2613     assign
     2614       v-diasize-change-size = false
     2615     .
     2616   end procedure.
     2617   procedure diasize_set-width :
     2618     define input  parameter p-new-width  as decimal   no-undo .
     2619     define input  parameter p-move-resize as logical   no-undo .
     2620     do
     2621     on error undo, return error return-value
     2622     :
     2623       run diasize_change-width in this-procedure
     2624         (input  (p-new-width - frame Dialog-Frame :width)
     2625         ,input  p-move-resize
     2626         ) .
     2627     end.
     2628   end procedure.
     2629   procedure diasize_position-resize-button :
     2630     do with frame Dialog-Frame
     2631     :
     2632       hide v-diasize-resize-button .
     2633       assign
     2634         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2635                     - 1
     2636                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2637         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2638                     - 1
     2639                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2640       .
     2641       view v-diasize-resize-button .
     2642     end.
     2643   end procedure.
     2644   on alt-right anywhere
     2645   do:
     2646     run diasize_change-width in this-procedure
     2647       (input 1
     2648       ,input true
     2649       ) .
     2650     return no-apply .
     2651   end.
     2652   on alt-left anywhere
     2653   do:
     2654     run diasize_change-width in this-procedure
     2655       (input -1
     2656       ,input true
     2657       ) .
     2658     return no-apply .
     2659   end.
     2660   on alt-down anywhere
     2661   do:
     2662     run diasize_change-height in this-procedure
     2663       (input 1
     2664       ,input true
     2665       ) .
     2666     return no-apply .
     2667   end.
     2668   on alt-up anywhere
     2669   do:
     2670     run diasize_change-height in this-procedure
     2671       (input -1
     2672       ,input true
     2673       ) .
     2674     return no-apply .
     2675   end.
     2676   on alt-enter of frame Dialog-Frame
     2677   do:
     2678     run diasize_maximize in this-procedure
     2679       (input  ?
     2680       ).
     2681     return no-apply .
     2682   end.
     2683   procedure diasize_end-move :
     2684     do
     2685     on error undo, return error return-value
     2686     :
     2687       define variable v-row-delta as decimal   no-undo .
     2688       define variable v-col-delta as decimal   no-undo .
     2689       define variable v-new-row as decimal   no-undo .
     2690       define variable v-new-col as decimal   no-undo .
     2691       assign
     2692         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2693         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2694       .
     2695       assign
     2696         v-row-delta = v-new-row - frame Dialog-Frame :height
     2697         v-col-delta = v-new-col - frame Dialog-Frame :width
     2698       .
     2699       run diasize_change-height in this-procedure
     2700         (input v-row-delta
     2701         ,input true
     2702         ) .
     2703       run diasize_change-width in this-procedure
     2704         (input v-col-delta
     2705         ,input true
     2706         ) .
     2707     end.
     2708   end procedure.
     2709   procedure diasize_maximize :
     2710     define input  parameter p-action as logical   no-undo .
     2711     do
     2712     on error undo, return error return-value
     2713     :
     2714       if p-action = ?
     2715       then do:
     2716         if v-diasize-need-maximize = true
     2717         then do:
     2718           assign
     2719             p-action = true
     2720           .
     2721         end.
     2722         else do:
     2723           assign
     2724             p-action = false
     2725           .
     2726         end.
     2727       end.
     2728       if p-action = true
     2729       then do:
     2730         run diasize_change-height in this-procedure
     2731           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2732               - frame Dialog-Frame :height-chars
     2733           ,input true
     2734           ) .
     2735         run diasize_change-width in this-procedure
     2736           (input session :width-chars
     2737               - frame Dialog-Frame :width-chars
     2738           ,input true
     2739           ) .
     2740         assign
     2741           v-diasize-need-maximize = false
     2742         .
     2743       end.
     2744       else do:
     2745         run diasize_change-width in this-procedure
     2746           (input v-diasize-orig-frame-width
     2747               - frame Dialog-Frame :width-chars
     2748           ,input true
     2749           ) .
     2750         run diasize_change-height in this-procedure
     2751           (input v-diasize-orig-frame-height
     2752               - frame Dialog-Frame :height-chars
     2753           ,input true
     2754           ) .
     2755         assign
     2756           v-diasize-need-maximize = true
     2757         .
     2758       end.
     2759     end.
     2760   end procedure.
     2761   procedure diasize_restore-orig-size :
     2762     do
     2763     on error undo, return error return-value
     2764     :
     2765       assign
     2766         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2767         v-diasize-current-frame-height = frame Dialog-Frame :height
     2768       .
     2769       run diasize_set-height in this-procedure
     2770         (input  v-diasize-orig-frame-height
     2771         ,input  true
     2772         ) .
     2773       run diasize_set-width in this-procedure
     2774         (input  v-diasize-orig-frame-width
     2775         ,input  true
     2776         ) .
     2777     end.
     2778   end procedure.
     2779   procedure diasize_restore-current-size :
     2780     do
     2781     on error undo, return error return-value
     2782     :
     2783       run diasize_set-height in this-procedure
     2784         (input  v-diasize-current-frame-height
     2785         ,input  true
     2786         ) .
     2787       run diasize_set-width in this-procedure
     2788         (input  v-diasize-current-frame-width
     2789         ,input  true
     2790         ) .
     2791     end.
     2792   end procedure.
     2793   procedure diasize_set-browse-handle :
     2794     define input  parameter p-browse-handle as handle   no-undo .
     2795     define buffer buf_temp-browse-handle for temp-browse-handle .
     2796     do
     2797     on error undo, return error return-value
     2798     :
     2799       assign
     2800         v-diasize-browse-handle = p-browse-handle
     2801       .
     2802       for each buf_temp-browse-handle
     2803       on error undo, return error return-value
     2804       :
     2805         delete buf_temp-browse-handle .
     2806       end.
     2807     end.
     2808   end procedure.
     2809   procedure diasize_add_browse :
     2810     define input  parameter p-browse-type   as character no-undo .
     2811     define input  parameter p-browse-handle as handle    no-undo .
     2812     define buffer buf_temp-browse-handle for temp-browse-handle .
     2813     do
     2814     on error undo, return error return-value
     2815     :
     2816       assign
     2817         v-diasize-browse-number = v-diasize-browse-number + 1
     2818       .
     2819       create buf_temp-browse-handle .
     2820       assign
     2821         buf_temp-browse-handle.browse-type   = p-browse-type
     2822         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2823         buf_temp-browse-handle.browse-handle = p-browse-handle
     2824       .
     2825     end.
     2826   end procedure.
     2827   procedure diasize_init :
     2828     define variable v-default-value    as logical   no-undo .
     2829     define variable v-restore-saved    as logical   no-undo .
     2830     define variable v-resize-value-str as character no-undo .
     2831     do
     2832     on error undo, return error return-value
     2833     :
     2834       do with frame Dialog-Frame
     2835       :
     2836         assign
     2837           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2838           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2839           v-diasize-browse-handle     = browse BR-staff :handle
     2840         .
     2841         create button v-diasize-resize-button
     2842         assign
     2843           parent        = frame Dialog-Frame :first-child
     2844           label         = "s"
     2845           height-pixels = 16
     2846           width-pixels  = 16
     2847           visible       = true
     2848           sensitive     = true
     2849           movable       = true
     2850           triggers:
     2851             on end-move persistent run diasize_end-move in this-procedure .
     2852           end triggers.
     2853         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2854         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2855         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2856         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2857         assign
     2858           v-diasize-wndmax = false
     2859         .
     2860         if connected("ub") = true
     2861         then do:
     2862           define variable v-cntxt-db-num        as integer   no-undo .
     2863           define variable v-cntxt-userid        as character no-undo .
     2864           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2865                                             , OUTPUT v-cntxt-userid
     2866                                             ) .
     2867           run gbl/wndpar_r.p
     2868             (input  v-cntxt-db-num
     2869             ,input  v-cntxt-userid
     2870             ,input  'wndmax':U
     2871             ,output v-diasize-wndmax
     2872             ,output v-default-value
     2873             ) .
     2874         end.
     2875         assign
     2876           v-diasize-wndstore = false
     2877         .
     2878         if connected("ub") = true
     2879         then do:
     2880           run gbl/wndpar_r.p
     2881             (input  v-cntxt-db-num
     2882             ,input  v-cntxt-userid
     2883             ,input  'wndstore':U
     2884             ,output v-diasize-wndstore
     2885             ,output v-default-value
     2886             ) .
     2887         end.
     2888         assign
     2889           v-diasize-proc-name = entry(1, program-name(2), '.')
     2890         .
     2891         if v-diasize-wndstore = true
     2892         then do:
     2893           assign
     2894             v-restore-saved = false
     2895           .
     2896           if connected("ub") = true
     2897           then do:
     2898             run gbl/wndsizer.p
     2899               (input  v-cntxt-db-num
     2900               ,input  v-cntxt-userid
     2901               ,input  v-diasize-proc-name
     2902               ,input  'height':u
     2903               ,output v-resize-value-str
     2904               ) .
     2905             if v-resize-value-str <> '':U
     2906             then do:
     2907               run diasize_change-height in this-procedure
     2908                 (input  integer(v-resize-value-str)
     2909                 ,input  true
     2910                 ) .
     2911               assign
     2912                 v-restore-saved = true
     2913               .
     2914             end.
     2915           end.
     2916           if connected("ub") = true
     2917           then do:
     2918             run gbl/wndsizer.p
     2919               (input  v-cntxt-db-num
     2920               ,input  v-cntxt-userid
     2921               ,input  v-diasize-proc-name
     2922               ,input  'width':u
     2923               ,output v-resize-value-str
     2924               ) .
     2925             if v-resize-value-str <> '':U
     2926             then do:
     2927               run diasize_change-width in this-procedure
     2928                 (input  integer(v-resize-value-str)
     2929                 ,input  true
     2930                 ) .
     2931               assign
     2932                 v-restore-saved = true
     2933               .
     2934             end.
     2935           end.
     2936           if v-restore-saved <> true
     2937           then do:
     2938             if v-diasize-wndmax = true
     2939             then do:
     2940               run diasize_maximize in this-procedure
     2941                 (input  true
     2942                 ) .
     2943             end.
     2944           end.
     2945         end.
     2946         else do:
     2947           if v-diasize-wndmax = true
     2948           then do:
     2949             run diasize_maximize in this-procedure
     2950               (input  true
     2951               ) .
     2952           end.
     2953         end.
     2954       end.
     2955     end.
     2956   end procedure.
     2957   procedure diasize_need-full-display :
     2958     define output parameter p-need-full-display as logical   no-undo .
     2959     do
     2960     on error undo, return error return-value
     2961     :
     2962       assign
     2963         p-need-full-display = v-diasize-need-full-display
     2964       .
     2965       assign
     2966         v-diasize-need-full-display = false
     2967       .
     2968     end.
     2969   end procedure.
     2970   procedure get-context :
     2971      define output parameter p-db-num as integer          no-undo.
     2972      define output parameter p-user-id as character        no-undo.
     2973      define variable v-login               as character    no-undo.
     2974      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2975      define buffer buf_user-login  for ub.user-login .
     2976      do
     2977      on error undo, return error
     2978      :
     2979            FIND FIRST buf_sys-ctrl no-lock.
     2980            ASSIGN
     2981               v-login = USERID("ub")
     2982               p-db-num = buf_sys-ctrl.db-num
     2983            .
     2984            FIND FIRST buf_user-login
     2985                 WHERE buf_user-login.db-num = p-db-num
     2986                   AND buf_user-login.user-login = v-login
     2987                 no-lock
     2988                 no-error
     2989                 .
     2990            IF AVAILABLE buf_user-login
     2991            THEN DO:
     2992               assign
     2993                  p-user-id = buf_user-login.user-id
     2994               .
     2995            END.
     2996      end.
     2997   end procedure.
     2998       run diasize_init in this-procedure .
     2999   MAIN-BLOCK:
     3000   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3001      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3002     assign
     3003       tt-person.inn :label in frame Dialog-Frame = "ИНН"
     3004       tt-person.kpp :label in frame Dialog-Frame = "КПП"
     3005     .
     3006     if p-mode  <> 'ДОБАВЛЕНИЕ':U
     3007     and p-mode <> 'ИЗМЕНЕНИЕ':U
     3008     and p-mode <> 'ПРОСМОТР':U
     3009     then do:
     3010         message
     3011         vss-workfile vss-revision vss-description skip
     3012         "Неверное значение параметров вызова p-mode"  p-mode
     3013         view-as alert-box ERROR.
     3014         undo, return error.
     3015     end.
     3016     if p-callpoint  <> 'C':U
     3017     and p-callpoint <> 'S':U
     3018     and p-callpoint <> "discards":U
     3019     and p-callpoint <> "cli-all":U
     3020     then do:
     3021         message
     3022         vss-workfile vss-revision vss-description skip
     3023         "Неверное значение параметров вызова p-callpoint"  p-callpoint
     3024         view-as alert-box ERROR.
     3025         undo, return error.
     3026     end.
     3027   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3028   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3029     (output v-db-num
     3030     )  .
     3031   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3032     run mainmenu_getcntxt in parparentproc
     3033       (output v-cntxt-db-num
     3034       ,output v-cntxt-userid
     3035       ,output v-cntxt-level
     3036       ,output v-cntxt-host-code-obj
     3037       ,output v-cntxt-obj-type
     3038       ,output v-cntxt-obj-code
     3039       ,output v-cntxt-db-num-obj
     3040       ,output v-cntxt-is-admin
     3041       ) .
     3042     run fill-table in this-procedure no-error.
     3043     if error-status:error then return error.
     3044     run Myenable in this-procedure .
     3045     WAIT-FOR GO OF FRAME Dialog-Frame.
     3046   END.
     3047   RUN disable_UI in this-procedure .
     3048   PROCEDURE disable_UI :
     3049     HIDE FRAME Dialog-Frame.
     3050   END PROCEDURE.
     3051   PROCEDURE enable_UI :
     3052     DISPLAY Rs-gender T-check-inn jj_change-address
     3053         WITH FRAME Dialog-Frame.
     3054     IF AVAILABLE tt-clients THEN
     3055       DISPLAY tt-clients.obj-name tt-clients.turnover-buyer
     3056             tt-clients.turnover-buyer-gds tt-clients.reg-code tt-clients.lim-kr
     3057             tt-clients.PS
     3058         WITH FRAME Dialog-Frame.
     3059     IF AVAILABLE tt-person THEN
     3060       DISPLAY tt-person.psn-code tt-person.date-birth tt-person.name1
     3061             tt-person.name2 tt-person.firm-name tt-person.position
     3062             tt-person.is-pboul tt-person.inn tt-person.kpp tt-person.phone1
     3063             tt-person.phone1-note tt-person.fax tt-person.e-mail tt-person.city
     3064             tt-person.post-city tt-person.post-ind tt-person.ind
     3065             tt-person.post-address tt-person.address tt-person.passp-ser
     3066             tt-person.passp-num tt-person.post-box tt-person.given-by
     3067         WITH FRAME Dialog-Frame.
     3068     ENABLE B-exit b-quit b-dc b-bank Docs b-org b-attr b-hist B-Help
     3069            tt-person.psn-code tt-clients.obj-name Rs-gender tt-person.date-birth
     3070            tt-person.name1 tt-person.name2 tt-clients.turnover-buyer
     3071            tt-person.firm-name tt-clients.turnover-buyer-gds tt-person.position
     3072            tt-person.is-pboul tt-person.inn tt-person.kpp T-check-inn
     3073            tt-person.phone1 tt-person.phone1-note tt-person.fax tt-person.e-mail
     3074            jj_change-address tt-person.city tt-person.post-city
     3075            tt-person.post-ind tt-person.ind tt-person.post-address
     3076            tt-person.address tt-person.passp-ser tt-person.passp-num
     3077            tt-person.post-box tt-clients.reg-code b-region tt-person.given-by
     3078            B-add B-del tt-clients.lim-kr BR-staff tt-clients.PS
     3079         WITH FRAME Dialog-Frame.
     3080     VIEW FRAME Dialog-Frame.
     3081     OPEN QUERY br-staff FOR  EACH tt-staff INDEXED-REPOSITION.
     3082   END PROCEDURE.
     3083   PROCEDURE fill-table :
     3084   define variable v-type as character no-undo .
     3085   define variable v-exist as logical no-undo .
     3086   DEFINE BUFFER buf_tt-staff FOR tt-staff.
     3087   DEFINE BUFFER buf_staff FOR ub.staff.
     3088    for each tt-clients :
     3089       delete tt-clients.
     3090     end.
     3091     for each tt-person :
     3092       delete tt-person.
     3093     end.
     3094     FOR EACH buf_tt-staff:
     3095         DELETE buf_tt-staff.
     3096     END.
     3097     if p-mode = 'ИЗМЕНЕНИЕ':U
     3098     or p-mode = 'ПРОСМОТР':U then do:
     3099      if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     3100         main-block:
     3101         do
     3102         on error  undo main-block, return error substitute( "&1 &2. &3&4&3&5"
     3103                                                           , vss-workfile
     3104                                                           , "Блокирование клиентма для редактирования"
     3105                                                           , return-value
     3106                                                           , chr(10)
     3107                                                           , error-status :get-message (1)
     3108                                                           )
     3109         on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     3110         on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     3111         :
     3112           find first locked_clients EXclusive-lock where
     3113                 recid(locked_clients) = p-rid .
     3114                   find first locked_person EXclusive-lock where
     3115                 locked_person.psn-code = locked_clients.obj-code .
     3116         end.
     3117       end.
     3118       else do:
     3119         find first locked_clients no-lock where
     3120                          recid(locked_clients) = p-rid no-error .
     3121         if not avail locked_clients then do:
     3122           find first locked_clients where
     3123                     locKed_clients.obj-type = 'чел':U
     3124                AND locKed_clients.obj-code = p-code no-error .
     3125         end.
     3126         if not available locked_clients then do:
     3127           message
     3128           vss-workfile vss-revision vss-description skip
     3129           "Не найдена запись КЛИЕНТ"
     3130           view-as alert-box error .
     3131           undo, return error.
     3132         end.
     3133         find first locked_person no-lock where
     3134                 locked_person.psn-code = locked_clients.obj-code no-error .
     3135         if not available locked_person then do:
     3136           message
     3137           vss-workfile vss-revision vss-description skip
     3138           "Не найдена запись ФИз.Лица"
     3139           view-as alert-box error .
     3140           undo, return error.
     3141         end.
     3142       end.
     3143       create tt-clients.
     3144       buffer-copy locked_clients to tt-clients.
     3145       create tt-person.
     3146       buffer-copy locked_person to tt-person.
     3147     end.
     3148     else do:
     3149       create tt-clients.
     3150       create tt-person.
     3151       assign
     3152       tt-clients.obj-type = 'орг':U
     3153       tt-clients.obj-code = 0
     3154       tt-clients.grp-code = p-grp-code
     3155       tt-person.psn-code = tt-clients.obj-code
     3156       tt-clients.stts = 0
     3157       .
     3158    end.
     3159    if p-mode <> 'ДОБАВЛЕНИЕ':U  then do:
     3160     FOR EACH buf_staff NO-LOCK WHERE
     3161             buf_staff.psn-code = tt-person.psn-code :
     3162       CREATE buf_tt-staff.
     3163       BUFFER-COPY buf_staff TO buf_tt-staff.
     3164     END.
     3165   end.
     3166   END PROCEDURE.
     3167   PROCEDURE Myenable :
     3168   define variable log-res as logical no-undo .
     3169   define variable for-code as integer no-undo .
     3170   define variable conf-par as character no-undo .
     3171   define variable par-type as character no-undo .
