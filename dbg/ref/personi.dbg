      664   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      665   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      666                                                       ,input p-range-type as character
      667                                                       ,input p-code as integer):
      668   define variable v-seq-val as integer no-undo .
      669   define buffer buf_code-range for ub.code-range.
      670   find first buf_code-range no-lock where
      671             buf_code-range.db-num = p-db-num
      672       and  buf_code-range.range-type = p-range-type
      673       and  buf_code-range.stts = 'u'
      674       and buf_code-range.first-code <= p-code
      675       and buf_code-range.last-code >= p-code no-error .
      676   if available buf_code-range then return yes.
      677   CASE p-range-type:
      678     when 'pngb':U then do:
      679       v-seq-val = current-value(s-pngb-code, ub).
      680     end.
      681     when 'fmgb':U then do:
      682       v-seq-val = current-value(s-fmgb-code, ub).
      683     end.
      684   END CASE.
      685   if p-code <= v-seq-val then do:
      686     find first buf_code-range no-lock where
      687               buf_code-range.db-num = p-db-num
      688         and  buf_code-range.range-type = p-range-type
      689         and  buf_code-range.stts = 'a'
      690         and buf_code-range.first-code <= p-code
      691         no-error .
      692    if available buf_code-range then return yes.
      693   end.
      694   find first buf_code-range no-lock where
      695             buf_code-range.db-num = p-db-num
      696       and  buf_code-range.range-type = p-range-type
      697       and  buf_code-range.stts = 'f'
      698       and buf_code-range.first-code <= p-code
      699       and buf_code-range.last-code >= p-code
      700       no-error .
      701   if available buf_code-range then return yes.
      702   return no.
      703   END FUNCTION.
      704   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      705                                                       ,input p-range-type as character
      706                                                       ,input p-code as integer):
      707   define variable v-seq-val as integer no-undo .
      708   define buffer buf_code-range for ub.code-range.
      709   CASE p-range-type:
      710     when 'pngb':U then do:
      711       v-seq-val = current-value(s-pngb-code, ub).
      712     end.
      713     when 'fmgb':U then do:
      714       v-seq-val = current-value(s-fmgb-code, ub).
      715     end.
      716   END CASE.
      717   if p-code <= v-seq-val then do:
      718     find first buf_code-range no-lock where
      719               buf_code-range.db-num = p-db-num
      720         and  buf_code-range.range-type = p-range-type
      721         and buf_code-range.first-code <= p-code
      722         and buf_code-range.last-code >= p-code no-error .
      723     if available buf_code-range then return yes.
      724   end.
      725   return no.
      726   END FUNCTION.
      727   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      728                                                       ,input p-db-num as integer
      729                                                       ,input p-staff-code as integer
      730                                                       ,input p-date as date
      731                                                        ):
      732   define buffer buf_staff for ub.staff.
      733   if p-date = ? then do:
      734     p-date = today .
      735   end.
      736   find first buf_staff no-lock where
      737             buf_staff.role = p-role
      738         and buf_staff.role-level = 'db':U
      739         and buf_staff.db-num = p-db-num
      740         and buf_staff.staff-code = p-staff-code
      741         and buf_staff.date-end >= p-date use-index pi  no-error .
      742   if available buf_staff then do:
      743     return buf_staff.psn-code.
      744   end.
      745   return 0.
      746   end FUNCTION.
      747   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      748                                                             ,input p-db-num as integer
      749                                                             ,input p-date as date
      750                                                                 ):
      751   define buffer buf_staff for ub.staff.
      752   define buffer buf2_staff for ub.staff.
      753   if p-date = ? then do:
      754     p-date = today .
      755   end.
      756   for each  buf_staff no-lock where
      757             buf_staff.role = p-role
      758         and buf_staff.db-num = p-db-num,
      759   first buf2_staff no-lock where
      760         buf2_staff.role = p-role
      761     and buf2_staff.role-level = 'db':U
      762     and buf2_staff.staff-code = buf_staff.staff-code
      763     and buf2_staff.date-start <= p-date
      764     and buf2_staff.date-end >= p-date
      765   by buf_staff.staff-code
      766   by date-start descending:
      767     return buf_staff.staff-code.
      768   end.
      769   end FUNCTION.
      770   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      771                                                  ,input p-db-num as integer
      772                                                  ,input p-psn-code as integer
      773                                                  ,input p-date as date
      774                                                  ,output p-c-password as character
      775                                                        ):
      776   define buffer buf_staff for ub.staff.
      777   if p-date = ? then do:
      778     p-date = today .
      779   end.
      780   find first buf_staff no-lock where
      781             buf_staff.role = p-role
      782         and buf_staff.role-level = 'db':U
      783         and buf_staff.db-num = p-db-num
      784        and buf_staff.date-end >= p-date
      785        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      786   if available buf_staff
      787   then do:
      788     assign
      789     p-c-password = buf_staff.password.
      790     return buf_staff.staff-code.
      791   end.
      792   p-c-password = ''.
      793   return 0.
      794   end FUNCTION.
      795   FUNCTION gbclcode-is-psn-role returns integer (
      796                                                 input p-role as character
      797                                                 ,input p-psn-code as integer
      798                                                 ,input p-date as date
      799                                                     ):
      800   define buffer buf_staff for ub.staff.
      801   if p-date = ? then do:
      802     p-date = today .
      803   end.
      804   for each buf_staff no-lock where
      805             buf_staff.psn-code = p-psn-code
      806        and  buf_staff.role = p-role
      807   by buf_staff.role-level
      808   by buf_staff.date-start
      809        :
      810     if  buf_staff.date-start <= p-date and
      811     buf_staff.date-end >= p-date  then do:
      812       return buf_staff.staff-code.
      813     end.
      814   end.
      815   return 0.
      816   end FUNCTION.
      817   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      818   define variable v-role-name as character no-undo .
      819   assign
      820   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      821   no-error .
      822   return v-role-name.
      823   END.
      824   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      825   FUNCTION gbclcode-get-position returns character ( input p-role as character
      826                                                     ,input p-role-level as character
      827                                                     ,input p-work-place as character
      828                                                     ,input p-staff-code as integer
      829                                                                ):
      830   define variable v-role-name as character no-undo .
      831   define variable v-role-level as character no-undo .
      832   define variable v-staff-code as integer no-undo .
      833   assign
      834   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      835   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      836   v-staff-code = p-staff-code
      837   no-error .
      838   return substitute("&1, &2, Код &3"
      839                   ,v-role-name
      840                   ,v-role-level
      841                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      842   END.
      843   FUNCTION gbclcode-get-work-place returns character (
      844                                                   input p-role as character
      845                                                  ,input p-role-level as character
      846                                                  ,input p-db-num as integer
      847                                                  ,input p-host-code as integer
      848                                                  ,input p-obj-type as character
      849                                                  ,input p-obj-code as integer
      850                                                  ) :
      851   define variable v-work-place as character no-undo .
      852   define variable v-obj-type as character no-undo .
      853     case p-role-level:
      854       when 'db':U then do:
      855         v-work-place = string(p-db-num, "99999").
      856       end.
      857       when 'firm':U then do:
      858         v-work-place = string(p-host-code, "99999").
      859       end.
      860       when 'object':U then do:
      861         assign
      862         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      863         .
      864       end.
      865     END CASE.
      866     return v-work-place.
      867   END FUNCTION.
      868   FUNCTION gbclcode-get-level-last-code returns integer (
      869                                                           input p-role as character
      870                                                         , input p-role-level as character
      871                                                         , input p-work-place as character
      872                                                         , input p-date-start as date
      873                                                         ):
      874   DEFINE VARIABLE v-today as date no-undo .
      875   define buffer buf_staff for ub.staff.
      876   if p-work-place = chr(63) then return ?.
      877   if p-date-start = ? then do:
      878     v-today = today .
      879   end.
      880   else do:
      881     v-today = p-date-start.
      882   end.
      883   find last buf_staff no-lock where
      884             buf_staff.role = p-role
      885        and  buf_staff.role-level = p-role-level
      886        and  buf_staff.work-place = p-work-place
      887        and  buf_staff.date-start <= v-today + 1
      888        and  buf_staff.date-end >= v-today + 1
      889        use-index pi  no-error .
      890   if available buf_staff
      891   then return buf_staff.staff-code.
      892   return 0.
      893   end FUNCTION.
      894   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      895   procedure cur-time :
      896      define output parameter p-today as date      no-undo .
      897      define output parameter p-time  as integer   no-undo .
      898     do
      899     on error undo, return error
      900     :
      901       define variable v-date1 as date      no-undo .
      902       define variable v-date2 as date      no-undo .
      903       define variable v-time  as integer   no-undo .
      904       assign
      905         v-date1 = today
      906         v-time  = time
      907         v-date2 = today
      908       .
      909       if v-date1 <> v-date2
      910       then do:
      911         assign
      912           v-date1 = today
      913           v-time  = v-time
      914         .
      915       end.
      916       assign
      917         p-today = v-date1
      918         p-time  = v-time
      919       .
      920     end.
      921   end.
      922   function cur-time-date returns character
      923   :
      924     return string(today, '99/99/9999':U) .
      925   end.
      926   function cur-time-mjd returns decimal
      927   :
      928     define variable v-date as date      no-undo .
      929     define variable v-time as integer   no-undo .
      930     run cur-time in this-procedure
      931       (output v-date
      932       ,output v-time
      933       ) .
      934     return integer(v-date) - 2400002 + (v-time / 86400) .
      935   end.
      936   function cur-time-get-ending-index returns integer
      937   (input p-number as integer
      938   )
      939   :
      940     if p-number < 0
      941     or p-number = ?
      942     then do:
      943       return 1 .
      944     end.
      945     define variable v-rest as integer   no-undo .
      946     assign
      947       p-number = p-number modulo 100
      948     .
      949     if p-number < 20
      950     then do:
      951       assign
      952         v-rest = p-number
      953       .
      954     end.
      955     else do:
      956       assign
      957         v-rest = p-number modulo 10
      958       .
      959     end.
      960     case v-rest :
      961       when 1
      962       then do:
      963         return 2 .
      964       end.
      965       when 2 or
      966       when 3 or
      967       when 4
      968       then do:
      969         return 3 .
      970       end.
      971       otherwise do:
      972         return 1 .
      973       end.
      974     end case .
      975   end.
      976   procedure cur-time-mjd-to-date :
      977      define input  parameter i-mjd-diff as decimal no-undo.
      978      define output parameter o-Date     as date    no-undo.
      979      define output parameter o-Time     as integer no-undo.
      980      define variable v-day-number as integer   no-undo .
      981      if    i-mjd-diff < 0
      982         or i-mjd-diff = ?
      983      then do:
      984         return "?" .
      985      end.
      986      assign
      987         v-day-number = truncate(i-mjd-diff,0).
      988         o-Date = date(v-day-number + 2400002).
      989         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      990     .
      991   end.
      992   function cur-time-mjd-to-string returns character
      993   (input p-mjd-diff as decimal
      994   )
      995   :
      996     define variable v-day-number as integer   no-undo .
      997     define variable v-seconds    as integer   no-undo .
      998     define variable v-hour       as integer   no-undo .
      999     define variable v-min        as integer   no-undo .
     1000     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1001     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1002     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1003     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1004     if p-mjd-diff < 0
     1005     or p-mjd-diff = ?
     1006     then do:
     1007       return "?" .
     1008     end.
     1009     assign
     1010       v-day-number = integer(truncate(p-mjd-diff,0))
     1011       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1012     .
     1013     if v-seconds > 86400
     1014     then do:
     1015       assign
     1016         v-seconds = 86400 - 1
     1017       .
     1018     end.
     1019     if v-seconds < 0
     1020     then do:
     1021       assign
     1022         v-seconds = 0
     1023       .
     1024     end.
     1025     assign
     1026       v-hour = truncate(v-seconds / 3600, 0)
     1027     .
     1028     assign
     1029       v-seconds = v-seconds modulo 3600
     1030     .
     1031     assign
     1032       v-min = truncate(v-seconds / 60, 0)
     1033     .
     1034     assign
     1035       v-seconds = v-seconds modulo 60
     1036     .
     1037     return
     1038         (if v-day-number <> 0
     1039           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1040           else ""
     1041         )
     1042       + (if v-day-number <> 0 or v-hour <> 0
     1043           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1044           else ""
     1045         )
     1046       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1047           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1048           else ""
     1049         )
     1050       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1051       .
     1052   end.
     1053   function cur-time-string returns character
     1054   :
     1055     define variable v-date as date      no-undo .
     1056     define variable v-time as integer   no-undo .
     1057     run cur-time in this-procedure
     1058       (output v-date
     1059       ,output v-time
     1060       ) .
     1061     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1062   end.
     1063   function cur-time-string-sec returns character
     1064   :
     1065     define variable v-date as date      no-undo .
     1066     define variable v-time as integer   no-undo .
     1067     run cur-time in this-procedure
     1068       (output v-date
     1069       ,output v-time
     1070       ) .
     1071     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1072   end.
     1073   function cur-time-custom  returns character
     1074   (input p-prefix as character
     1075   ,input p-date-format as character
     1076   ,input p-delimiter as character
     1077   ,input p-time-format as character
     1078   ,input p-suffix as character
     1079   )
     1080   :
     1081     define variable v-date as date      no-undo .
     1082     define variable v-time as integer   no-undo .
     1083     run cur-time in this-procedure
     1084       (output v-date
     1085       ,output v-time
     1086       ) .
     1087     return
     1088       p-prefix
     1089       + string(v-date, p-date-format)
     1090       + p-delimiter
     1091       + string(v-time, p-time-format)
     1092       + p-suffix
     1093       .
     1094   end.
     1095   function cur-time-print  returns character
     1096   :
     1097     define variable v-date as date      no-undo .
     1098     define variable v-time as integer   no-undo .
     1099     run cur-time in this-procedure
     1100       (output v-date
     1101       ,output v-time
     1102       ) .
     1103     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1104   end.
     1105   function cur-time-datetime returns datetime
     1106   :
     1107     define variable v-char as character no-undo .
     1108     define variable v-datetime as datetime no-undo .
     1109     v-char = cur-time-string().
     1110     v-datetime = datetime(v-char).
     1111     return  v-datetime.
     1112   end.
     1113   function cur-time-string-msec returns character
     1114   :
     1115     define variable v-date as datetime  no-undo .
     1116     v-date = now.
     1117     return string(v-date) .
     1118   end.
     1119   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1120   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1121   PROCEDURE request-proc-save-staff :
     1122   DEFINE INPUT PARAMETER p-child-handle AS HANDLE NO-UNDO.
     1123   define input parameter p-mode as character no-undo .
     1124   define input parameter p-callpoint as character no-undo .
     1125   define buffer buf_tt-staff for tt-staff.
     1126   IF p-mode <> 'ДОБАВЛЕНИЕ':U
     1127   OR LOOKUP(p-callpoint , 'C,S':U) = 0 THEN RETURN.
     1128   for each buf_tt-staff :
     1129       RUN proc-save-staff IN p-child-handle (
     1130                                              INPUT buf_tt-staff.role
     1131                                             ,INPUT buf_tt-staff.staff-code
     1132                                             ,INPUT buf_tt-staff.role-level
     1133                                             ,INPUT buf_tt-staff.db-num
     1134                                             ,INPUT buf_tt-staff.host-code
     1135                                             ,INPUT buf_tt-staff.obj-type
     1136                                             ,INPUT buf_tt-staff.obj-code
     1137                                             ,INPUT buf_tt-staff.password
     1138                                             ,input buf_tt-staff.date-start
     1139                                             ,input buf_tt-staff.date-end
     1140                                             ,input buf_tt-staff.work-place
     1141                                               ) NO-ERROR.
     1142       IF ERROR-STATUS:ERROR THEN DO:
     1143         UNDO, RETURN ERROR RETURN-VALUE.
     1144       END.
     1145   END.
     1146   END PROCEDURE.
