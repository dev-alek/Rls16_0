     3199   rs-gender:RADIO-BUTTONS IN FRAME Dialog-Frame =  "Муж" + chr(44) + STRING(NO) + chr(44) +
     3200                              "Жен" + chr(44) + STRING(yes) + chr(44) +
     3201                              "?" + chr(44) + chr(63)
     3202   .
     3203   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3204     (input  'is-fin'
     3205     ,input  0
     3206     ,input  ''
     3207     ,input  0
     3208     ,input  ''
     3209     ,input  ''
     3210     ,input  ''
     3211     ,input  no
     3212     ,output conf-par
     3213     ,output par-type
     3214     ) no-error .
     3215   IF not error-status:error then
     3216   assign
     3217   is-fin =  (if conf-par = "yes" then yes else no)
     3218   .
     3219   if can-find(first ub.cash-desk no-lock where
     3220                   ub.cash-desk.db-num = v-cntxt-db-num
     3221                and ub.cash-desk.pos-type = 'MAGIA-XML':U) then do:
     3222     assign
     3223     is-magia = yes
     3224     .
     3225   end.
     3226   run adm/shattri.p (
     3227         input "get":U
     3228       ,input  '':U
     3229       ,input  0
     3230       ,input  'cli-all':U
     3231       ,input  'nocorinn':U
     3232       ,output v-value-character
     3233       ,output v-value-date
     3234       ,output v-value-decimal
     3235       ,output v-value-integer
     3236       ,output nocorinn
     3237       ,output v-param-type
     3238       ,INPUT-OUTPUT table-handle v-tth
     3239       ) no-error .
     3240   delete object v-tth.
     3241   rs-gender = string(tt-person.gender).
     3242   b-add:MENU-MOUSE in frame Dialog-Frame  = 1.
     3243   assign
     3244   tt-person.post-address:column = tt-person.address:column
     3245   tt-person.post-address:label = tt-person.address:label
     3246   tt-person.post-city:column = tt-person.city:column
     3247   tt-person.post-city:label = tt-person.city:label
     3248   tt-person.post-ind:column = tt-person.ind:column
     3249   tt-person.post-ind:label = tt-person.ind:label
     3250   jj_change-address = 0
     3251   .
     3252   IF AVAILABLE tt-clients THEN
     3253     DISPLAY
     3254     tt-clients.obj-name
     3255     tt-clients.lim-kr
     3256     tt-clients.PS
     3257     tt-clients.turnover-buyer
     3258     tt-clients.turnover-buyer-gds
     3259     tt-clients.reg-code
     3260     WITH FRAME Dialog-Frame.
     3261   IF AVAILABLE tt-person THEN
     3262     DISPLAY
     3263     tt-person.psn-code
     3264     tt-person.date-birth
     3265     rs-gender
     3266     tt-person.name2
     3267     tt-person.name1
     3268     tt-person.firm-name
     3269     tt-person.position
     3270     tt-person.inn
     3271     t-check-inn when p-mode <> 'ПРОСМОТР':U
     3272     tt-person.is-pboul
     3273     tt-person.kpp
     3274     tt-person.phone1
     3275     tt-person.phone1-note
     3276     tt-person.fax
     3277     tt-person.e-mail
     3278     tt-person.city
     3279     tt-person.ind
     3280     tt-person.address
     3281     tt-person.post-box
     3282     tt-person.passp-ser
     3283     tt-person.passp-num
     3284     tt-person.given-by
     3285     WITH FRAME Dialog-Frame.
     3286   assign
     3287   frame Dialog-Frame :title = "Ч Е Л О В Е К:физич. лицо" + chr(32) + p-mode
     3288   .
     3289   if p-mode <> 'ПРОСМОТР':U then do:
     3290     ENABLE
     3291     B-exit
     3292     b-quit
     3293     b-dc   when p-mode <> 'ДОБАВЛЕНИЕ':U and p-callpoint <> "discards":U
     3294     b-bank
     3295     Docs   when p-mode <> 'ДОБАВЛЕНИЕ':U and v-cntxt-level = 'object':U
     3296     b-org  when p-mode <> 'ДОБАВЛЕНИЕ':U and v-cntxt-level = 'object':U
     3297     b-add when p-mode = 'ДОБАВЛЕНИЕ':U and lookup(p-callpoint, 'C,S':U) > 0
     3298     b-del when p-mode = 'ДОБАВЛЕНИЕ':U and lookup(p-callpoint, 'C,S':U) > 0
     3299     b-hist when p-mode <> 'ДОБАВЛЕНИЕ':U
     3300     B-Help
     3301     b-region when p-mode <> 'ПРОСМОТР':U
     3302     tt-person.psn-code  when p-mode = 'ДОБАВЛЕНИЕ':U
     3303     tt-person.date-birth
     3304     RS-gender
     3305     tt-clients.obj-name
     3306     tt-person.name2
     3307     tt-person.name1
     3308     tt-person.firm-name
     3309     tt-person.position
     3310     tt-person.inn
     3311     t-check-inn when nocorinn
     3312     tt-person.kpp
     3313     tt-person.phone1
     3314     tt-person.phone1-note
     3315     tt-person.fax
     3316     tt-person.e-mail
     3317     tt-person.is-pboul
     3318     tt-person.post-box
     3319     tt-person.passp-ser
     3320     tt-person.passp-num
     3321     tt-person.given-by
     3322     tt-clients.lim-kr when log-res
     3323     tt-clients.PS
     3324     br-staff
     3325     tt-clients.turnover-buyer when v-cntxt-db-num =0
     3326     tt-clients.turnover-buyer-gds when tt-clients.turnover-buyer = true and v-cntxt-db-num =0
     3327     jj_change-address
     3328     WITH FRAME Dialog-Frame.
     3329     tt-clients.PS:read-only = no.
     3330     HIDE
     3331     b-attr IN FRAME Dialog-Frame.
     3332   end.
     3333   else do:
     3334     ENABLE
     3335     b-quit
     3336     b-dc   when p-callpoint <> "discards":U and  v-cntxt-level = 'object':U
     3337     b-bank
     3338     Docs when  v-cntxt-level = 'object':U
     3339     b-org WHEN  v-cntxt-level = 'object':U
     3340     b-hist
     3341     B-Help
     3342     br-staff
     3343     tt-clients.PS
     3344     b-attr
     3345     jj_change-address
     3346     with frame Dialog-Frame .
     3347     assign
     3348     b-quit:label = "&Выход"
     3349     b-quit:column = 1
     3350     tt-clients.PS:read-only = yes
     3351       .
     3352     hide
     3353     b-exit
     3354     t-check-inn
     3355     in frame Dialog-Frame .
     3356   end.
     3357   MENU-ITEM m-choose:SENSITIVE IN MENU MENU-psn-code = (p-mode = 'ДОБАВЛЕНИЕ':U) .
     3358   if p-mode <> 'ДОБАВЛЕНИЕ':U then DO:
     3359     menu-item m_cashier:sensitive in menu menu-b-add = no.
     3360     menu-item m_seller:sensitive in menu menu-b-add = no.
     3361     HIDE
     3362     b-add
     3363     b-del
     3364     IN FRAME Dialog-Frame.
     3365   END.
     3366   assign
     3367   b-bank:label = "&Счета".
     3368     define variable v-use-grp-buy           as logical   no-undo .
     3369     define variable v-use-oborot-buy        as logical   no-undo .
     3370     define variable v-use-qnty-group        as logical   no-undo .
     3371     define variable v-use-sum-group         as logical   no-undo .
     3372     define variable v-use-add-code          as logical   no-undo .
     3373     define variable v-use-sys-date-time     as logical   no-undo .
     3374     define variable v-use-shift-date-num    as logical   no-undo .
     3375     define variable v-use-cassa             as logical   no-undo .
     3376     define variable v-use-val               as logical   no-undo .
     3377     define variable v-use-pay-type          as logical   no-undo .
     3378     define variable v-use-cash-pay          as logical   no-undo .
     3379     define variable v-use-child as logical   no-undo .
     3380   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3381   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run glstall in g#library
     3382   (  output v-use-grp-buy
     3383    , output v-use-oborot-buy
     3384    , output v-use-qnty-group
     3385    , output v-use-sum-group
     3386    , output v-use-add-code
     3387    , output v-use-sys-date-time
     3388    , output v-use-shift-date-num
     3389    , output v-use-cassa
     3390    , output v-use-val
     3391    , output v-use-pay-type
     3392    , output v-use-cash-pay
     3393    , output v-use-child
     3394           ) no-error .
     3395     if not ( v-use-grp-buy or v-use-oborot-buy ) then
     3396      hide tt-clients.turnover-buyer tt-clients.turnover-buyer-gds in frame Dialog-Frame.
     3397   OPEN QUERY br-staff FOR  EACH tt-staff INDEXED-REPOSITION.
     3398   VIEW FRAME Dialog-Frame.
     3399   APPLY "VALUE-CHANGED":U TO jj_change-address IN FRAME Dialog-Frame.
     3400   END PROCEDURE.
     3401   PROCEDURE proc-b-add-staff :
     3402   DEFINE INPUT PARAMETER p-role AS CHARACTER NO-UNDO.
     3403   run ref/rolei.p (
     3404                   input parparentproc
     3405                  ,input (IF p-mode = 'ДОБАВЛЕНИЕ':U
     3406                          THEN ('ДОБАВЛЕНИЕ':U + chr(44) + 'temp':U)
     3407                          ELSE p-mode)
     3408                  ,INPUT tt-clients.obj-code
     3409                  ,INPut p-role
     3410                  ,input 'db':U
     3411                  ,INPUT-OUTPUT p-rid
     3412                  ,input-output table tt-staff
     3413                  ) no-error.
     3414   IF error-status:ERROR  THEN do:
     3415      message error-status:get-message(1) return-value
     3416      view-as alert-box error .
     3417      UNDO, RETURN .
     3418    end.
     3419   OPEN QUERY br-staff FOR  EACH tt-staff INDEXED-REPOSITION.
     3420   END PROCEDURE.
     3421   PROCEDURE Proc-save :
     3422   define variable int-buf as integer no-undo .
     3423   define variable psw-buf as integer no-undo .
     3424   define variable glog as logical no-undo .
     3425   define variable v-no-check-inn as logical no-undo .
     3426   define variable ii as integer no-undo .
     3427   define variable v-return-value as character no-undo .
     3428   define variable v-staff-input as logical no-undo .
     3429   define buffer buf_tt-staff for tt-staff.
     3430   if p-mode = 'ДОБАВЛЕНИЕ':U  then
     3431   assign
     3432   frame Dialog-Frame
     3433   tt-person.psn-code
     3434   .
     3435   if p-mode = 'ДОБАВЛЕНИЕ':U
     3436   and lookup( p-callpoint, 'C,S':U)  > 0
     3437   then do:
     3438     for each buf_tt-staff :
     3439       if buf_tt-staff.role = p-callpoint then do:
     3440         v-staff-input = yes.
     3441         leave.
     3442       end.
     3443     end.
     3444     if v-staff-input = no then do:
     3445       message
     3446       substitute("Вы находитесь в режиме ввода физических лиц <&2>&1" +
     3447                 "однако Вы пытаетесь ввести данные по физ. лицу, не вводя данные для роли <&2>"
     3448                 , chr(10)
     3449                 , entry (lookup (p-callpoint, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     3450                 )
     3451       view-as alert-box error .
     3452       undo, return error .
     3453     end.
     3454   end.
     3455   IF tt-person.address:VISIBLE IN FRAME Dialog-Frame then
     3456   ASSIGN tt-person.address.
     3457   IF tt-person.city:VISIBLE IN FRAME Dialog-Frame then
     3458   ASSIGN tt-person.city.
     3459   IF tt-person.ind:VISIBLE IN FRAME Dialog-Frame then
     3460   ASSIGN tt-person.ind.
     3461   IF tt-person.post-address:VISIBLE IN FRAME Dialog-Frame then
     3462   ASSIGN tt-person.post-address.
     3463   IF tt-person.post-city:VISIBLE IN FRAME Dialog-Frame then
     3464   ASSIGN tt-person.post-city.
     3465   IF tt-person.post-ind:VISIBLE IN FRAME Dialog-Frame then
     3466   ASSIGN tt-person.post-ind.
     3467   IF (tt-person.address <> ''
     3468   or tt-person.city <> ''
     3469   OR tt-person.ind <> 0)
     3470   AND (tt-person.post-city = ''
     3471        AND
     3472        tt-person.post-address = ''
     3473        AND
     3474       tt-person.post-ind = 0) THEN DO:
     3475     message
     3476     substitute("Вы заполнили (некоторые) поля адреса РЕГИСТРАЦИИ,&1" +
     3477                "но не заполнили ни одного поля ПОЧТОВОГО адреса&1" +
     3478                "Скопировать поля адреса РЕГИСТРАЦИИ в поля ПОЧТОВОГО адреса?"
     3479                , chr(10))
     3480     VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     3481     IF glog THEN DO:
     3482         ASSIGN
     3483         tt-person.post-address = tt-person.address
     3484         tt-person.post-city = tt-person.city
     3485         tt-person.post-ind = tt-person.ind
     3486         .
     3487         DISPLAY
     3488         tt-person.post-address
     3489         tt-person.post-city
     3490         tt-person.post-ind
     3491         WITH FRAME Dialog-Frame.
     3492     END.
     3493   END.
     3494   assign
     3495   tt-person.firm-name
     3496   rs-gender
     3497   tt-person.gender = IF rs-gender = chr(63) THEN ? ELSE LOGICAL(rs-gender)
     3498   tt-person.date-birth
     3499   tt-person.position
     3500   tt-person.phone1
     3501   tt-person.phone1-note
     3502   tt-person.e-mail
     3503   tt-person.fax
     3504   tt-person.post-box
     3505   tt-person.is-pboul
     3506   tt-person.given-by
     3507   tt-person.passp-num = IF tt-person.passp-num:SCREEN-VALUE = ? THEN "":U ELSE tt-person.passp-num:SCREEN-VALUE
     3508   tt-person.passp-num = trim(tt-person.passp-num)
     3509   tt-person.passp-ser
     3510   tt-clients.obj-name
     3511   tt-clients.PS
     3512   tt-clients.lim-kr
     3513   tt-person.inn
     3514   t-check-inn
     3515   tt-person.kpp
     3516   tt-person.name1
     3517   tt-person.name2
     3518   .
     3519   _ii:
     3520   do ii = 1 to (if nocorinn AND T-check-inn then 2 else 1):
     3521     run ref/person1.p (
     3522                   input parparentproc
     3523                  ,input this-procedure:handle
     3524                 ,input-output p-rid
     3525                 ,input p-mode
     3526                 ,input p-callpoint
     3527                 ,input no
     3528                 ,input tt-person.psn-code
     3529                 ,input tt-clients.stts
     3530                 ,input tt-clients.obj-name
     3531                 ,input tt-clients.lim-kr
     3532                 ,input tt-clients.PS
     3533                 ,input tt-clients.grp-code
     3534                 ,input tt-person.address
     3535                 ,input tt-person.city
     3536                 ,input tt-person.date-birth
     3537                 ,input tt-person.e-mail
     3538                 ,input tt-person.fax
     3539                 ,input tt-person.firm-code
     3540                 ,input tt-person.firm-name
     3541                 ,input tt-person.gender
     3542                 ,input tt-person.given-by
     3543                 ,input tt-person.ind
     3544                 ,input tt-person.inn
     3545                 ,input (v-no-check-inn OR NOT t-check-inn)
     3546                 ,input tt-person.is-pboul
     3547                 ,input tt-person.kpp
     3548                 ,input tt-person.name1
     3549                 ,input tt-person.name2
     3550                 ,input tt-person.okonh
     3551                 ,input tt-person.okpo
     3552                 ,input tt-person.passp-num
     3553                 ,input tt-person.passp-ser
     3554                 ,input tt-person.phone1
     3555                 ,input tt-person.phone1-note
     3556                 ,input tt-person.position
     3557                 ,input tt-person.post-box
     3558                 ,input tt-person.post-address
     3559                 ,input tt-person.post-city
     3560                 ,input tt-person.post-ind
     3561                 ,input tt-clients.reg-code
     3562                 ,input tt-clients.turnover-buyer
     3563                 ,input tt-clients.turnover-buyer-gds
     3564     ) no-error .
     3565     if error-status:error then do:
     3566       v-return-value = return-value.
     3567       if v-return-value = "inn" and nocorinn then do:
     3568         message
     3569         "Введенный ИНН некорректен или не является ИНН для Вашей страны" skip
     3570         "Подтверждаете ввод ТАКОГО ИНН?"
     3571         view-as alert-box question buttons yes-no update v-no-check-inn.
     3572         if not v-no-check-inn then undo, return error .
     3573         next _ii.
     3574       end.
     3575       if v-return-value = 'inn-uniq' then do:
     3576         v-return-value = 'inn'.
     3577       end.
     3578   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3579   define variable fh as widget-handle no-undo .
     3580   define variable hh as widget-handle no-undo .
     3581   define variable rv as character no-undo .
     3582   assign
     3583   rv = entry(1, v-return-value , chr(4)).
     3584   if rv <> "":U then do:
     3585     assign
     3586     fh = frame Dialog-Frame:first-child
     3587     hh = fh:first-child
     3588     .
     3589     do while valid-handle(hh):
     3590       if hh:name = rv then do:
     3591         APPLY "ENTRY" to hh.
     3592         undo  ,
     3593         return error.
     3594       end.
     3595       hh = hh:next-sibling.
     3596     end.
     3597   end.
     3598       message
     3599       v-return-value view-as alert-box error .
     3600       undo, return error.
     3601     end.
     3602     ELSE LEAVE _ii.
     3603   end.
     3604   END PROCEDURE.
