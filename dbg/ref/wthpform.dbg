        1   DEFINE BUFFER locked_wealth FOR ub.wealth.
        2   DEFINE BUFFER locked_wth-par FOR ub.wth-par.
        3   DEFINE TEMP-TABLE tt-wth-par NO-UNDO LIKE ub.wth-par.
        4   define input parameter parparentproc as widget-handle no-undo .
        5   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo .
        6   define input parameter p-curr-obj-type  like ub.clients.obj-type no-undo .
        7   define input parameter p-curr-obj-code  like ub.clients.obj-code no-undo .
        8   define input param pwth-code like ub.wth-par.wth-code no-undo.
        9   define input param ppar-code like ub.wth-par.par-code no-undo.
       10   define input param par-mode as char no-undo.
       11   define output param p-rec as recid no-undo.
       12   define variable vss-revision    as character no-undo init "$Revision$":U .
       13   define variable vss-author      as character no-undo init "$Author$":U .
       14   define variable vss-date        as character no-undo init "$Date$":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       16   define variable vss-archive     as character no-undo init "$Archive$":U .
       17   define variable vss-description as character no-undo init "Карточка номинала материальной ценности ".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   procedure proc-alt-shift-f2:
       79     if not ibs.th.gbl.gbl-var:rcode
       80   then
       81     run gbl\inidebug.p .
       82   end.
       83   procedure proc-alt-shift-f3:
       84     run gbl/prvssinf.p
       85       ( input this-procedure
       86       ) .
       87   end.
       88   define variable v-inform-launched as logical no-undo initial false .
       89   procedure proc-alt-shift-f4:
       90     define variable v-action as character no-undo .
       91     if v-inform-launched = false then do:
       92       assign
       93         v-inform-launched = true
       94       .
       95       run gbl/d-inform.w
       96         (  input self
       97         ,  input this-procedure
       98         , output v-action
       99         ) no-error .
      100       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      101       assign
      102         v-inform-launched = false
      103       .
      104     end.
      105   end.
      106   procedure proc-alt-f1:
      107     run gbl/corrhelp.p
      108       (input this-procedure
      109       ) .
      110   end .
      111   on alt-shift-f2 anywhere do:
      112     run proc-alt-shift-f2.
      113   end.
      114   on alt-shift-f3 anywhere do:
      115     run proc-alt-shift-f3 in this-procedure .
      116   end.
      117   on alt-shift-f4 anywhere do:
      118     run proc-alt-shift-f4 in this-procedure.
      119   end.
      120   on alt-f1 anywhere do:
      121     run proc-alt-f1 in this-procedure .
      122   end.
      123   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124     define variable v-cntxt-db-num        as integer   no-undo .
      125     define variable v-cntxt-userid        as character no-undo .
      126     define variable v-cntxt-level         as character no-undo .
      127     define variable v-cntxt-host-code-obj as integer   no-undo .
      128     define variable v-cntxt-obj-type      as character no-undo .
      129     define variable v-cntxt-obj-code      as integer   no-undo .
      130     define variable v-cntxt-db-num-obj    as integer   no-undo .
      131     define variable v-cntxt-is-admin      as logical   no-undo .
      132   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      133   DEFINE BUFFER buf_units FOR ub.units.
      134   DEFINE BUFFER buf_currency FOR ub.currency.
      135   define buffer buf_wth-gds  for ub.wth-gds.
      136   define buffer buf_goods    for ub.goods.
      137   DEFINE BUTTON B-exit AUTO-GO
      138        LABEL "&Ввод"
      139        SIZE 10 BY 1
      140        BGCOLOR 8 .
      141   DEFINE BUTTON B-Help
      142        LABEL "Помо&щь"
      143        SIZE 3 BY 1
      144        BGCOLOR 8 .
      145   DEFINE BUTTON B-hist
      146        LABEL "Ис&тория"
      147        SIZE 3 BY 1.
      148   DEFINE BUTTON b-quit AUTO-END-KEY
      149        LABEL "&Отмена"
      150        SIZE 10 BY 1
      151        BGCOLOR 8 .
      152   DEFINE BUTTON B-unit
      153        IMAGE-UP FILE "btn-down-arrow":U
      154        IMAGE-DOWN FILE "btn-down-arrow":U
      155        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      156        LABEL "":L
      157        SIZE 3.13 BY 1.04
      158        BGCOLOR 8 FGCOLOR 0 .
      159   DEFINE BUTTON Bpar-feat
      160        IMAGE-UP FILE "btn-down-arrow":U
      161        IMAGE-DOWN FILE "btn-down-arrow":U
      162        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      163        LABEL "":L
      164        SIZE 3.13 BY 1.04
      165        BGCOLOR 8 FGCOLOR 0 .
      166   DEFINE VARIABLE Spar-feat AS CHARACTER
      167        VIEW-AS SELECTION-LIST SINGLE SCROLLBAR-VERTICAL
      168        LIST-ITEMS "Банкнота","Монета"
      169        SIZE 16.25 BY 1.5 NO-UNDO.
      170   DEFINE VARIABLE Spar-unit AS CHARACTER
      171        VIEW-AS SELECTION-LIST SINGLE SCROLLBAR-VERTICAL
      172        SIZE 15.88 BY 2.04 NO-UNDO.
      173   DEFINE FRAME Dialog-Frame
      174        B-exit AT ROW 1 COL 1.13
      175        b-quit AT ROW 1 COL 11.13
      176        B-hist AT ROW 1 COL 70
      177        B-Help AT ROW 1 COL 73
      178        tt-wth-par.par-val AT ROW 3.83 COL 25.5 COLON-ALIGNED
      179             LABEL "Номинал"
      180             VIEW-AS FILL-IN
      181             SIZE 13.63 BY 1
      182        tt-wth-par.par-rate AT ROW 5.33 COL 25.5 COLON-ALIGNED
      183             LABEL "Коэффициент"
      184             VIEW-AS FILL-IN
      185             SIZE 13.63 BY 1
      186        B-unit AT ROW 6.58 COL 44.5
      187        Spar-unit AT ROW 6.63 COL 27.5 NO-LABEL
      188        tt-wth-par.par-unit AT ROW 6.63 COL 25.5 COLON-ALIGNED NO-LABEL
      189             VIEW-AS FILL-IN
      190             SIZE 13.63 BY 1
      191        tt-wth-par.par-feat AT ROW 8.88 COL 25.5 COLON-ALIGNED
      192             LABEL "Доп. признак"
      193             VIEW-AS FILL-IN
      194             SIZE 15.75 BY 1
      195        Bpar-feat AT ROW 9.04 COL 44.75
      196        Spar-feat AT ROW 10.08 COL 27.5 NO-LABEL
      197        tt-wth-par.wth-code AT ROW 1.08 COL 40.5 COLON-ALIGNED NO-LABEL
      198              VIEW-AS TEXT
      199             SIZE 10.13 BY 1
      200             FGCOLOR 4
      201        locked_wth-par.par-code AT ROW 2.46 COL 40.25 COLON-ALIGNED NO-LABEL
      202              VIEW-AS TEXT
      203             SIZE 10.5 BY 1
      204             FGCOLOR 4
      205        "Код номинала" VIEW-AS TEXT
      206             SIZE 13.13 BY 1 AT ROW 2.5 COL 28
      207        "Код МЦ" VIEW-AS TEXT
      208             SIZE 7.88 BY 1 AT ROW 1.13 COL 28.13
      209        "Ед. изм.:" VIEW-AS TEXT
      210             SIZE 10.63 BY 1 AT ROW 6.71 COL 15.5
      211        SPACE(50.49) SKIP(4.57)
      212       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      213            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      214            TITLE "Номинал материальной ценности"
      215            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      216   ASSIGN
      217          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      218          FRAME Dialog-Frame:HIDDEN           = TRUE.
      219   ASSIGN
      220          B-unit:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      221   ASSIGN
      222          Bpar-feat:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      223   ASSIGN
      224          tt-wth-par.par-unit:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      225   ASSIGN
      226          Spar-feat:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      227   ASSIGN
      228          Spar-unit:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      229   ON GO OF FRAME Dialog-Frame
      230   DO:
      231     run proc-save in this-procedure no-error .
      232     if error-status:error then return no-apply.
      233   END.
      234   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      235   DO:
      236     APPLY "END-ERROR":U TO SELF.
      237   END.
      238   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
      239   DO:
      240       define variable v-rid-list  as   character            no-undo .
      241     define variable v-host-code like ub.sysconf.host-code no-undo .
      242     run ref/cwthhist.w (
      243                      input parparentproc
      244                    , input ?
      245                    , input '':U
      246                    , input 0
      247                    , input "":U
      248                    , input "subject":U
      249                    , input tt-wth-par.wth-code
      250                    , INPUT tt-wth-par.par-code
      251                    , input ?
      252                    , input ?
      253                    , input ?
      254                    , input ?
      255                    , input "":U
      256                    , input 'wth-par':U
      257                    , input v-cntxt-db-num
      258                    , input ?
      259                    , input ?
      260                    , input-output v-rid-list
      261                    ) no-error.
      262   if error-status:error then do:
      263     message return-value skip
      264             error-status:get-message(1)
      265     view-as alert-box.
      266   end.
      267   END.
      268   ON CHOOSE OF B-unit IN FRAME Dialog-Frame
      269   DO:
      270   run ch-units IN THIS-PROCEDURE .
      271   apply "entry" to tt-wth-par.par-unit in frame Dialog-Frame.
      272   END.
      273   ON CHOOSE OF Bpar-feat IN FRAME Dialog-Frame
      274   DO:
      275     VIEW
      276     spar-feat
      277     in frame Dialog-Frame.
      278     ENABLE
      279     spar-feat
      280     with frame Dialog-Frame.
      281   END.
      282   ON LEAVE OF tt-wth-par.par-unit IN FRAME Dialog-Frame
      283   DO:
      284       if locked_wealth.is-money then do:
      285           if input frame Dialog-Frame tt-wth-par.par-UNIT <> buf_currency.curr-abbr AND
      286              input frame Dialog-Frame tt-wth-par.par-UNIT <> buf_currency.part-abbr then do:
      287              message "Выберите сокр. название валюты или ее дробной части"
      288              view-as alert-box.
      289           end.
      290       end.
      291       else do:
      292           if not can-FIND( ub.units where ub.units.unit-name = input frame Dialog-Frame tt-wth-par.par-UNIT )
      293              then do:
      294              tt-wth-par.par-unit = "?".
      295              DISPLAY tt-wth-par.par-unit
      296              WITH FRAME Dialog-Frame.
      297              run ch-units IN this-procedure.
      298           end.
      299       end.
      300   END.
      301   ON LEAVE OF Spar-feat IN FRAME Dialog-Frame
      302   DO:
      303       display
      304     spar-feat:screen-value @ tt-wth-par.par-feat
      305     with frame Dialog-Frame.
      306     hide spar-feat
      307     in frame Dialog-Frame.
      308   END.
      309   ON MOUSE-SELECT-DBLCLICK OF Spar-feat IN FRAME Dialog-Frame
      310   DO:
      311      display
      312     spar-feat:screen-value @ tt-wth-par.par-feat
      313     with frame Dialog-Frame.
      314     hide spar-feat
      315     in frame Dialog-Frame.
      316   END.
      317   ON RETURN OF Spar-feat IN FRAME Dialog-Frame
      318   DO:
      319     display
      320     spar-feat:screen-value @ tt-wth-par.par-feat
      321     with frame Dialog-Frame.
      322     hide spar-feat
      323     in frame Dialog-Frame.
      324   END.
      325   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      326   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      327   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      328   on help of frame Dialog-Frame
      329   do:
      330     run gbl/app_help.p
      331       (input this-procedure :file-name
      332       ,input ''
      333       ,input ?
      334       ) no-error.
      335     if error-status :error then do:
      336       message
      337         "Ошибка при вызове помощи"
      338         error-status :get-message(1)
      339         view-as alert-box .
      340     end.
      341   end.
      342   run minbtn-set in this-procedure .
      343   on choose of b-help in frame Dialog-Frame
      344   do:
      345     apply "help":u to frame Dialog-Frame .
      346   end.
      347   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      348   procedure minbtn-set :
      349       do
      350           on error undo, return error return-value
      351           :
      352           define variable ii              as integer       no-undo .
      353           define variable fh              as widget-handle no-undo .
      354           define variable hh              as widget-handle no-undo .
      355           define variable v-h             as handle        extent 4 no-undo .
      356           define variable v-name-button   as character     no-undo .
      357           define variable v-help-old-x    as decimal       no-undo .
      358           define variable v-help-old-y    as decimal       no-undo .
      359           define variable v-help-old-size as decimal       no-undo .
      360           define variable v-frame-width   as decimal       no-undo .
      361           define variable jj              as integer       no-undo .
      362           do
      363               on error undo, return error
      364               :
      365               assign
      366                   v-frame-width = frame Dialog-Frame:width - 0.3
      367                   fh            = frame Dialog-Frame:first-child
      368                   hh            = fh:first-child
      369                   ii            = 1
      370                   .
      371               do while valid-handle(hh):
      372                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      373                   do:
      374                       case lc(hh:name) :
      375                           when "b-help" then
      376                               do:
      377                                   hh:load-image-up("cmp/b-help.bmp":u) .
      378                                   hh:load-image-down("cmp/b-help.bmp":u) .
      379                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      380                                   hh:TOOLTIP = "Помощь" .
      381                                   v-help-old-x = hh:column .
      382                                   v-help-old-y = hh:row    .
      383                                   v-help-old-size = hh:width .
      384                                   hh:width-chars = 2.5 .
      385                               end.
      386                           when "b-print" then
      387                               do:
      388                                   hh:load-image("cmp/b-print.bmp":u) .
      389                                   hh:TOOLTIP = "Печать" .
      390                                   v-h[ii] = hh:handle .
      391                                   ii = ii + 1 .
      392                                   hh:width-chars = 3 .
      393                               end.
      394                           when "b-history" or
      395                           when "b-hist" then
      396                               do:
      397                                   hh:load-image("cmp/b-hist.bmp":u) .
      398                                   hh:TOOLTIP = "История" .
      399                                   v-h[ii] = hh:handle .
      400                                   ii = ii + 1 .
      401                                   hh:width-chars = 3 .
      402                               end.
      403                           when "b-sch" then
      404                               do:
      405                                   hh:load-image("cmp/b-sch.bmp":u) .
      406                                   hh:TOOLTIP = "Установка Фильтра" .
      407                                   v-h[ii] = hh:handle .
      408                                   ii = ii + 1 .
      409                                   hh:width-chars = 3 .
      410                               end.
      411                           when "b-hist-user" then
      412                               do:
      413                                   hh:load-image("cmp/b-hist.bmp":u) .
      414                                   hh:TOOLTIP = "История пользователя" .
      415                                   ii = ii + 1 .
      416                               end.
      417                       end case.
      418                   end.
      419                   hh = hh:next-sibling.
      420               end.
      421               b-help:column = v-frame-width - b-help:width-chars.
      422               jj = 0.
      423               repeat ii = 4 to 1 by -1 :
      424                   if valid-handle (v-h[ii] ) then
      425                   do:
      426                       jj  = jj + 1 .
      427                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      428                       v-h[ii]:row    = v-help-old-y .
      429                   end.
      430               end.
      431           end.
      432       end.
      433   end procedure.
      434   MAIN-BLOCK:
      435   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      436      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      437      ON stop UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      438     IF lookup(par-mode, 'ДОБАВЛЕНИЕ':U + chr(44) +
      439                         'ИЗМЕНЕНИЕ':U + chr(44) +
      440                         'ПРОСМОТР':U) = 0 THEN DO:
      441     message
      442       "Неверное значение параметра par-mode" par-mode
      443       VIEW-AS ALERT-BOX ERROR.
      444       UNDO main-block, RETURN ERROR.
      445     END.
      446     IF pwth-code = 0  THEN DO:
      447         run ref/wth-ref.w (
      448                            input parparentproc
      449                           ,input "b-sel"
      450                           ,input p-curr-host-code
      451                           ,input p-curr-obj-type
      452                           ,input p-curr-obj-code
      453                           ,input 'все':U
      454                           ,input-output v-rid-list) no-error.
      455         if v-rid-list = "" then return error.
      456         find first locked_wealth exclusive-LOCK WHERE
      457                 recid(locked_wealth) = integer(entry(1, v-rid-list)) NO-ERROR.
      458     END.
      459     ELSE do:
      460       FIND FIRST LOCKED_wealth EXCLUSIVE-LOCK WHERE
      461                LOCKED_wealth.wth-code = pwth-code NO-ERROR.
      462       IF NOT AVAILABLE LOCKED_wealth THEN DO:
      463           message vss-workfile vss-revision vss-description skip
      464           "Не найдена материальная ценность с кодом " pwth-code
      465           view-as alert-box error.
      466           return error.
      467       END.
      468     END.
      469     IF par-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
      470       CREATE tt-wth-par.
      471       assign
      472       tt-wth-par.wth-code = LOCKED_wealth.wth-code
      473       .
      474     END.
      475     ELSE DO:
      476        IF par-mode = 'ПРОСМОТР':U THEN DO:
      477          FIND FIRST LOCKED_wth-par NO-LOCK WHERE
      478                   LOCKED_wth-par.wth-code = pwth-code
      479              AND  LOCKED_wth-par.par-code = ppar-code NO-ERROR.
      480        END.
      481        ELSE DO:
      482            FIND FIRST LOCKED_wth-par exclusive-LOCK WHERE
      483                     LOCKED_wth-par.wth-code = pwth-code
      484                AND  LOCKED_wth-par.par-code = ppar-code NO-ERROR.
      485        END.
      486        IF NOT AVAILABLE LOCKED_wth-par THEN DO:
      487           MESSAGE
      488           SUBSTITUTE("Не найден номинал с кодом &1 для МЦ с  кодом &2", ppar-code, pwth-code)
      489           VIEW-AS ALERT-BOX ERROR.
      490           UNDO main-block, RETURN ERROR.
      491       END.
      492       p-rec = recid(Locked_wth-par).
      493       CREATE tt-wth-par.
      494       BUFFER-COPY LOCKED_wth-par TO tt-wth-par.
      495     END.
      496   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      497     run mainmenu_getcntxt in parparentproc
      498       (output v-cntxt-db-num
      499       ,output v-cntxt-userid
      500       ,output v-cntxt-level
      501       ,output v-cntxt-host-code-obj
      502       ,output v-cntxt-obj-type
      503       ,output v-cntxt-obj-code
      504       ,output v-cntxt-db-num-obj
      505       ,output v-cntxt-is-admin
      506       ) .
      507     run Myenable IN THIS-PROCEDURE NO-ERROR.
      508     WAIT-FOR GO OF FRAME Dialog-Frame.
      509   END.
      510   run disable_UI.
      511   PROCEDURE ch-units :
      512   define variable ref-rec as recid no-undo .
      513   run ref/units.w ( input parparentproc
      514                   ,input yes
      515                   ,output ref-rec ).
      516   if ref-rec = ? then do:
      517     apply "entry" to b-unit in frame Dialog-Frame.
      518     return no-apply.
      519   end.
      520   FIND buf_units WHERE recid (buf_units) = ref-rec NO-LOCK.
      521   DISPLAY
      522   buf_units.unit-name @ tt-wth-par.par-UNIT
      523   with frame Dialog-Frame.
      524   END PROCEDURE.
      525   PROCEDURE disable_UI :
      526     HIDE FRAME Dialog-Frame.
      527   END PROCEDURE.
      528   PROCEDURE enable_UI :
      529     IF AVAILABLE locked_wth-par THEN
      530       DISPLAY locked_wth-par.par-code
      531         WITH FRAME Dialog-Frame.
      532     IF AVAILABLE tt-wth-par THEN
      533       DISPLAY tt-wth-par.par-val tt-wth-par.par-rate tt-wth-par.par-feat
      534             tt-wth-par.wth-code
      535         WITH FRAME Dialog-Frame.
      536     ENABLE B-exit b-quit B-hist B-Help tt-wth-par.par-val tt-wth-par.par-rate
      537            B-unit tt-wth-par.par-feat Bpar-feat tt-wth-par.wth-code
      538            locked_wth-par.par-code
      539         WITH FRAME Dialog-Frame.
      540     VIEW FRAME Dialog-Frame.
      541   END PROCEDURE.
      542   PROCEDURE MyEnable :
      543   define variable v-rid-list as char no-undo.
      544   if locked_wealth.curr-code <> ? then do:
      545       FIND FIRST buf_currency No-LOCK WHERE
      546                   buf_currency.curr-code = locked_wealth.curr-code NO-ERROR.
      547       if not avail buf_currency then do:
      548          message vss-workfile vss-revision vss-description skip
      549          SUBSTITUTE("Не найдена валюта с кодом &1" +
      550                      "для материальной ценности с кодом &1"
      551                     ,locked_wealth.curr-code
      552                     ,locked_wealth.wth-code)
      553           view-as alert-box error.
      554           return error.
      555       end.
      556   end.
      557   else if not locked_wealth.is-ser = 1 then do:
      558       FIND FIRST buf_units No-LOCK WHERE
      559                   buf_units.unit-name = locked_wealth.unit-base NO-ERROR.
      560       if not avail buf_units then do:
      561          message vss-workfile vss-revision vss-description skip
      562          substitute("Не найдена единица измерения &1" +
      563                     "для материальной ценности с кодом &1"
      564                     ,locked_wealth.unit-base
      565                     ,locked_wealth.wth-code)
      566           view-as alert-box error.
      567           return error.
      568       end.
      569   end.
      570   ENABLE
      571   B-exit WHEN par-mode <> 'ПРОСМОТР':U
      572   b-quit
      573   B-Help
      574   tt-wth-par.par-val when (par-mode = 'ДОБАВЛЕНИЕ':U or par-mode = 'ИЗМЕНЕНИЕ':U)
      575   tt-wth-par.par-rate when ((par-mode = 'ДОБАВЛЕНИЕ':U or par-mode = 'ИЗМЕНЕНИЕ':U) and locked_wealth.is-ser = 0 )
      576   tt-wth-par.par-feat when (par-mode = 'ДОБАВЛЕНИЕ':U or par-mode = 'ИЗМЕНЕНИЕ':U)
      577   b-hist WHEN par-mode <> 'ДОБАВЛЕНИЕ':U
      578   WITH FRAME Dialog-Frame.
      579   VIEW FRAME Dialog-Frame.
      580   if locked_wealth.is-money = yes then do:
      581       spar-unit:list-items = buf_currency.curr-abbr + chr(44) + buf_currency.part-abbr.
      582       view spar-unit
      583       in frame Dialog-Frame.
      584       ENABLE
      585       spar-unit when (par-mode = 'ДОБАВЛЕНИЕ':U  OR par-mode = 'ИЗМЕНЕНИЕ':U)
      586       bpar-feat when (par-mode = 'ДОБАВЛЕНИЕ':U  OR par-mode = 'ИЗМЕНЕНИЕ':U)
      587       with frame Dialog-Frame.
      588   end.
      589   else do:
      590       view
      591       b-unit
      592       tt-wth-par.par-unit
      593       in frame Dialog-Frame.
      594       ENABLE
      595       b-unit when ((par-mode = 'ДОБАВЛЕНИЕ':U or par-mode = 'ИЗМЕНЕНИЕ':U) and locked_wealth.is-ser = 0 )
      596       tt-wth-par.par-unit when ((par-mode = 'ДОБАВЛЕНИЕ':U or par-mode = 'ИЗМЕНЕНИЕ':U) and locked_wealth.is-ser = 0 )
      597       with frame Dialog-Frame.
      598   end.
      599   if par-mode = 'ИЗМЕНЕНИЕ':U or par-mode = 'ПРОСМОТР':U then do:
      600       DISPLAY
      601       tt-wth-par.wth-code
      602       locked_wth-par.par-code
      603       tt-wth-par.par-feat
      604       tt-wth-par.par-rate
      605       tt-wth-par.par-val
      606       WITH FRAME Dialog-Frame  .
      607       if locked_wealth.is-money = yes then do:
      608           assign
      609           spar-unit:screen-value = tt-wth-par.par-unit no-error.
      610       end.
      611       else do:
      612           display
      613           tt-wth-par.par-unit
      614           WITH FRAME Dialog-Frame  .
      615       end.
      616   end.
      617   if par-mode = 'ДОБАВЛЕНИЕ':U then do with frame Dialog-Frame :
      618       DISPLAY
      619       tt-wth-par.wth-code
      620       .
      621       if NOT locked_wealth.is-money then
      622       DISPLAY
      623       locked_wealth.unit-base @ tt-wth-par.par-unit
      624       .
      625       if locked_wealth.is-ser = 1 then do:
      626          tt-wth-par.par-rate:screen-value = '1'.
      627          for first buf_wth-gds no-lock where buf_wth-gds.wth-code = locked_wealth.wth-code,
      628              first buf_goods   no-lock where buf_goods.gds-code = buf_wth-gds.gds-code:
      629              display buf_goods.unit-base @ tt-wth-par.par-unit with frame Dialog-Frame.
      630              disable  tt-wth-par.par-unit
      631                       b-unit
      632              with frame Dialog-Frame.
      633          end.
      634       end.
      635   end.
      636   IF par-mode = 'ПРОСМОТР':U THEN DO:
      637     HIDE
      638     b-exit IN FRAME Dialog-Frame
      639     .
      640     ASSIGN
      641     b-quit:COLUMN = 1
      642     b-quit:LABEL = "&Выход".
      643   END.
      644   frame Dialog-Frame:title = substitute("&1 &2 &3"
      645                                        ,frame Dialog-Frame:title
      646                                        ,locked_wealth.wth-name
      647                                        ,par-mode).
      648   END PROCEDURE.
      649   PROCEDURE proc-save :
      650   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
      651   IF par-mode = 'ПРОСМОТР':U THEN UNDO, RETURN ERROR.
      652   assign
      653   FRAME Dialog-Frame
      654   tt-wth-par.par-feat
      655   tt-wth-par.par-rate
      656   tt-wth-par.par-unit
      657   tt-wth-par.par-val
      658   Spar-feat
      659   Spar-unit
      660   .
      661   if par-mode = 'ИЗМЕНЕНИЕ':U then v-rec = p-rec.
      662   run ref/wth-par1.p ( INPUT par-mode
      663                       ,INPUT NO
      664                       ,INPUT-OUTPUT v-rec
      665                       ,INPUT tt-wth-par.wth-code
      666                       ,INPUT tt-wth-par.par-code
      667                       ,INPUT tt-wth-par.par-val
      668                       ,INPUT tt-wth-par.par-feat
      669                       ,INPUT tt-wth-par.par-rate
      670                       ,INPUT (IF tt-wth-par.par-unit:VISIBLE IN FRAME Dialog-Frame
      671                               THEN tt-wth-par.par-unit
      672                               ELSE spar-unit)
      673                        ) NO-ERROR.
      674   if error-status:error then do:
      675   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      676   define variable fh as widget-handle no-undo .
      677   define variable hh as widget-handle no-undo .
      678   define variable rv as character no-undo .
      679   assign
      680   rv = entry(1, return-value , chr(4)).
      681   if rv <> "":U then do:
      682     assign
      683     fh = frame Dialog-Frame:first-child
      684     hh = fh:first-child
      685     .
      686     do while valid-handle(hh):
      687       if hh:name = rv then do:
      688         APPLY "ENTRY" to hh.
      689         undo ,
      690         return error.
      691       end.
      692       hh = hh:next-sibling.
      693     end.
      694   end.
      695     undo, return error.
      696   end.
      697   p-rec = v-rec.
      698   END PROCEDURE.
