        1   DEFINE TEMP-TABLE temp-oattr NO-UNDO LIKE ub.gds-obj-attr
        2          field user-can-edit as log
        3          field code as char
        4          field value_ as character
        5          INDEX attrc is
        6          UNIQUE PRIMARY
