     1523           and can-query(v-object-handle, "height")
     1524           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1525           then do:
     1526             find first buf_temp-browse-handle
     1527               where buf_temp-browse-handle.browse-type   = 'height':u
     1528                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1529               no-error .
     1530             if available buf_temp-browse-handle
     1531             then do:
     1532             end.
     1533             else do:
     1534               create buf_temp-diasize-handle .
     1535               assign
     1536                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1537                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1538               .
     1539             end.
     1540           end.
     1541           assign
     1542             v-object-handle = v-object-handle :next-sibling
     1543           .
     1544         end.
     1545         assign
     1546           v-field-group-handle = v-field-group-handle :next-sibling
     1547         .
