      651   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      652   def new shared temp-table goa-list no-undo like ub.gds-obj-attr
      653                           field rc as recid
      654                           field to-del as  logical
      655                           field order-num as integer
      656                           index rci is unique rc to-del
      657                           index gds-code-i is primary gds-code obj-type obj-code attr-code to-del
      658                           index iobj obj-type obj-code
      659                           index io order-num
      660                           .
      661   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      662   define temp-table tt-attr-property  no-undo
      663   field upper-attr-code as character
      664   field attr-code as character
      665   field table-name as character
      666   field edit-menu-section-num as integer
      667   field attr-label as character
      668   field menu-item-handle as widget-handle
      669   field user-can-edit as logical
      670   field menu-name as character
      671   field parent-handle as handle
      672   index pi is unique primary
      673   table-name
      674   menu-name
      675   upper-attr-code
      676   attr-code
      677   index i-section
      678   edit-menu-section-num
      679   .
      680   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      681   procedure attr-pop-create-items :
      682   define input parameter p-table-name as character no-undo .
      683   define input parameter p-get-section-num-proc-name as character no-undo .
      684   define input parameter p-get-attr-label-proc-name as character no-undo .
      685   define input parameter p-attr-choose-proc-name as character no-undo .
      686   define input parameter p-menu-handle as widget-handle no-undo .
      687   define input parameter p-attr-list as character no-undo .
      688   define variable ii as integer no-undo .
      689   define variable V-CREATED as logical no-undo .
      690   define variable v-tool-tip as character no-undo .
      691   define variable v-dop as character no-undo .
      692   define variable v-attr-item as character no-undo .
      693   define variable p-upper-attr-code as character no-undo .
      694   define buffer buf_tt-attr-property for tt-attr-property.
      695     do
      696     on error undo, return error return-value
      697     :
      698        do ii = 1 to num-entries (p-attr-list):
      699          v-attr-item = entry(ii, p-attr-list) .
      700          find first tt-attr-property where
      701                    tt-attr-property.table-name = p-table-name
      702                and tt-attr-property.attr-code = v-attr-item
      703                and tt-attr-property.upper-attr-code = p-upper-attr-code
      704                and tt-attr-property.menu-name = p-menu-handle:name  no-error .
      705          if not available tt-attr-property then do:
      706            create tt-attr-property.
      707            assign
      708            tt-attr-property.table-name = p-table-name
      709            tt-attr-property.attr-code = v-attr-item
      710            tt-attr-property.upper-attr-code = p-upper-attr-code
      711            tt-attr-property.menu-name = p-menu-handle:name
      712            .
      713            run value ( p-get-section-num-proc-name) (
      714                                                      input tt-attr-property.attr-code
      715                                                     ,output tt-attr-property.edit-menu-section-num ) no-error .
      716            run value ( p-get-attr-label-proc-name ) (
      717                                           input tt-attr-property.attr-code
      718                                          ,output v-tool-tip
      719                                          ,output tt-attr-property.attr-label
      720                                         ) no-error .
      721            release tt-attr-property.
      722          end.
      723        end.
      724        for each tt-attr-property where tt-attr-property.menu-name = p-menu-handle:name
      725        break
      726        by  tt-attr-property.edit-menu-section-num
      727        by  tt-attr-property.attr-label
      728        :
      729          if tt-attr-property.edit-menu-section-num > 0
      730          then do:
      731             if not valid-handle(tt-attr-property.menu-item-handle) then do:
      732               if num-entries(tt-attr-property.attr-code, chr(4)) > 1
      733               and entry(2, tt-attr-property.attr-code, chr(4)) <> '':U
      734               then do:
      735                 find first buf_tt-attr-property where
      736                           buf_tt-attr-property.table-name = p-table-name
      737                       and buf_tt-attr-property.menu-name = p-menu-handle:name
      738                       and buf_tt-attr-property.upper-attr-code = p-upper-attr-code
      739                       and buf_tt-attr-property.attr-code = entry(1, tt-attr-property.attr-code, chr(4)) no-error .
      740                 if not available buf_tt-attr-property then do:
      741                   create buf_tt-attr-property.
      742                   assign
      743                   buf_tt-attr-property.table-name = p-table-name
      744                   buf_tt-attr-property.attr-code = entry(1, tt-attr-property.attr-code, chr(4))
      745                   buf_tt-attr-property.upper-attr-code = p-upper-attr-code
      746                   buf_tt-attr-property.menu-name = p-menu-handle:name
      747                   .
      748                   create sub-menu buf_tt-attr-property.menu-item-handle
      749                   assign
      750                   name = entry(1, tt-attr-property.attr-code, chr(4))  + chr(4)  + p-menu-handle:name
      751                   parent = p-menu-handle.
      752                 end.
      753                 create menu-item tt-attr-property.menu-item-handle
      754                 assign
      755                 label = tt-attr-property.attr-label
      756                 name = tt-attr-property.attr-code  + chr(4)  + p-menu-handle:name
      757                 parent = buf_tt-attr-property.menu-item-handle
      758                 triggers:
      759                   on choose
      760                     persistent run value(p-attr-choose-proc-name + "-2") (
      761                                                                            input  entry(1, tt-attr-property.attr-code, chr(4) )
      762                                                                           ,input entry(2, tt-attr-property.attr-code, chr(4) )
      763                                                                             ) .
      764                 end triggers.
      765                 assign
      766                 v-created = yes.
      767               end.
      768               else do:
      769                 create menu-item tt-attr-property.menu-item-handle
      770                 assign
      771                 label = tt-attr-property.attr-label
      772                 name = entry(1, tt-attr-property.attr-code, chr(4)) + chr(4)  + p-menu-handle:name
      773                 parent = p-menu-handle
      774                 triggers:
      775                   on choose
      776                     persistent run value(p-attr-choose-proc-name) (
      777                                                                    input  entry(1, tt-attr-property.attr-code, chr(4) )) .
      778                 end triggers.
      779                 assign
      780                 v-created = yes.
      781               end.
      782             end.
      783             if last-of(tt-attr-property.edit-menu-section-num)
      784               then do:
      785               find first buf_tt-attr-property where
      786                         buf_tt-attr-property.table-name = p-table-name
      787                    and  buf_tt-attr-property.attr-code = substitute("&1&2&3"
      788                                                            , p-table-name
      789                                                            , tt-attr-property.edit-menu-section-num
      790                                                            , p-menu-handle:name
      791                                                            )
      792                     and buf_tt-attr-property.menu-name = p-menu-handle:name  no-error .
      793               if not available buf_tt-attr-property then do:
      794                 create buf_tt-attr-property.
      795                 assign
      796                 buf_tt-attr-property.table-name = p-table-name
      797                 buf_tt-attr-property.edit-menu-section-num =  - 1
      798                 buf_tt-attr-property.menu-name = p-menu-handle:name
      799                 buf_tt-attr-property.upper-attr-code = ''
      800                 buf_tt-attr-property.attr-code = substitute("&1&2&3"
      801                                                             , p-table-name
      802                                                             , tt-attr-property.edit-menu-section-num
      803                                                             , p-menu-handle:name
      804                                                             )
      805                 .
      806                 create menu-item buf_tt-attr-property.menu-item-handle
      807                 assign
      808                 subtype = "rule"
      809                 parent = p-menu-handle
      810                 .
      811               end.
      812             end.
      813          end.
      814        end.
      815        if not v-created then do:
      816           run attr-pop-clean-up in this-procedure ( input p-table-name).
      817        end.
      818     end.
      819   end procedure.
      820   procedure attr-pop-clean-up :
      821   define input parameter p-table-name as character no-undo .
      822     for each tt-attr-property where
      823             tt-attr-property.table-name = p-table-name
      824       and tt-attr-property.edit-menu-section-num > 0:
      825       if valid-handle ( tt-attr-property.menu-item-handle) then do:
      826         delete widget tt-attr-property.menu-item-handle.
      827       end.
      828       delete tt-attr-property.
      829     end.
      830     for each tt-attr-property where
      831              tt-attr-property.table-name = p-table-name
      832          and tt-attr-property.edit-menu-section-num =  - 1:
      833       if valid-handle ( tt-attr-property.menu-item-handle) then do:
      834         delete widget tt-attr-property.menu-item-handle.
      835       end.
      836       delete tt-attr-property.
      837     end.
      838   end procedure.
      839   define variable updated as logical no-undo.
      840   DEFINE VARIABLE added  as logical no-undo .
      841   define variable add-option as char no-undo.
      842   define variable ini-title as char no-undo.
      843   define variable temp-doc-rec as recid no-undo.
      844   define variable dops as character no-undo.
      845   define variable dopst as character no-undo.
      846   define variable v-curr-obj-type like ub.gds-obj-attr.obj-type no-undo .
      847   define variable v-curr-obj-code like ub.gds-obj-attr.obj-code no-undo .
      848   define variable v-is-tpsi-object as logical no-undo .
      849   define variable v-host-code like ub.sysconf.host-code no-undo .
      850   define variable v-tab-order as character no-undo .
      851   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      852   define variable send-ref as logical no-undo.
      853   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      854     (input  'send-ref'
      855     ,input  0
      856     ,input  ''
      857     ,input  0
      858     ,input  ''
      859     ,input  ''
      860     ,input  ''
      861     ,input  no
      862     ,output dops
      863     ,output dopst
      864     ) no-error .
      865     send-ref = (IF error-status:error or dops <> "yes" then no else yes).
      866   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      867   define new shared temp-table gds-list no-undo like ub.goods
      868     field qnty   as decimal
      869     field to-del as logical
      870     field order-num as integer
      871     field to-sel as logical
      872     field promo-code as character
      873     field ActionId  as int64
      874     field db-num as integer
      875     index art  is primary unique artic prod-type prod-code
      876     index code is         unique gds-code
      877     index oi order-num
      878     index isel to-sel
      879     .
      880   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      881   define  new shared  temp-table gds-list-hist no-undo
      882   field list-table as character
      883   field id as integer
      884   field line as integer
      885   field hist-mode as character
      886   field des as character
      887   field num-recs as integer
      888   field option_ as character
      889   field item_ as character
      890   field status_ as character
      891   field num-add as integer
      892   field num-ignored as integer
      893   field done as logical
      894   field err_ as logical
      895   field err-mes as character
      896   index pi is primary
      897   id
      898   line
      899   index isdone
      900   done
      901   .
      902   DEFINE MENU MENU-b-add.
      903   DEFINE BUTTON b-add
      904        LABEL "&Добавить":L
      905        SIZE 10 BY 1 TOOLTIP "Добавить атрибут товара на объекте".
      906   DEFINE BUTTON b-chg
      907        LABEL "&Изменить":L
      908        SIZE 10 BY 1 TOOLTIP "Изменить атрибут товара на объекте".
      909   DEFINE BUTTON b-del
      910        LABEL "&Удалить":L
      911        SIZE 10 BY 1 TOOLTIP "Удалить атрибут товара на объекте".
      912   DEFINE BUTTON B-exit AUTO-GO
      913        LABEL "&Ввод"
      914        SIZE 10 BY 1 TOOLTIP "Выход с сохранением".
      915   DEFINE BUTTON b-help
      916        LABEL "Помо&щь":L
      917        SIZE 10 BY 1.
      918   DEFINE BUTTON B-lookup
      919        LABEL "&Просмотр"
      920        SIZE 10 BY 1.
      921   DEFINE BUTTON b-quit AUTO-END-KEY
      922        LABEL "&Отмена":L
      923        SIZE 10 BY 1 TOOLTIP "Выход из режима".
      924   DEFINE VARIABLE goods-artic AS CHARACTER FORMAT "X(16)":U
      925         VIEW-AS TEXT
      926        SIZE 16.38 BY 1
      927        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      928   DEFINE VARIABLE Goods-dsc-name AS CHARACTER FORMAT "X(60)":U
      929         VIEW-AS TEXT
      930        SIZE 61.63 BY 1
      931        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      932   DEFINE VARIABLE goods-gds-code AS INTEGER FORMAT ">>>>>>>>>>":U INITIAL 0
      933         VIEW-AS TEXT
      934        SIZE 11 BY 1
      935        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      936   DEFINE VARIABLE goods-prod-code AS INTEGER FORMAT ">>>>>>>>>":U INITIAL 0
      937         VIEW-AS TEXT
      938        SIZE 9.63 BY 1
      939        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      940   DEFINE VARIABLE goods-prod-name AS CHARACTER FORMAT "X(60)":U
      941         VIEW-AS TEXT
      942        SIZE 46.75 BY 1
      943        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      944   DEFINE VARIABLE goods-prod-type AS CHARACTER FORMAT "X(3)":U
      945         VIEW-AS TEXT
      946        SIZE 3.75 BY 1
      947        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      948   DEFINE VARIABLE RS-p-mode AS CHARACTER
      949        VIEW-AS RADIO-SET VERTICAL
      950        RADIO-BUTTONS
      951             "Текущий", "1",
      952   "Объекты фирмы", "2",
      953   "Объекты БД", "3"
      954        SIZE 16.88 BY 2 NO-UNDO.
      955   DEFINE QUERY br-attr FOR
      956         temp-oattr SCROLLING.
      957   DEFINE BROWSE br-attr
      958     QUERY br-attr DISPLAY
      959         temp-oattr.attr-code COLUMN-LABEL "Атрибут" FORMAT "X(50)":U
      960         temp-oattr.attr-value COLUMN-LABEL "Значение" FORMAT "X(34)":U
      961         temp-oattr.obj-type FORMAT "X(3)":U
      962         temp-oattr.obj-code FORMAT "99999":U
      963       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.75 BY 15.33.
      964   DEFINE FRAME Dialog-Frame
      965        B-exit AT ROW 1 COL 1
      966        b-quit AT ROW 1 COL 11
      967        b-add AT ROW 1 COL 21
      968        B-lookup AT ROW 1 COL 31
      969        b-chg AT ROW 1 COL 41
      970        b-del AT ROW 1 COL 51
      971        b-help AT ROW 1.04 COL 70.13
      972        RS-p-mode AT ROW 2.08 COL 81.63 NO-LABEL
      973        br-attr AT ROW 4.46 COL 1
      974        goods-artic AT ROW 2.13 COL 1.88 NO-LABEL
      975        Goods-dsc-name AT ROW 2.13 COL 19 NO-LABEL
      976        goods-gds-code AT ROW 3.29 COL 1.75 NO-LABEL
      977        goods-prod-type AT ROW 3.29 COL 19 NO-LABEL
      978        goods-prod-code AT ROW 3.29 COL 23.38 NO-LABEL
      979        goods-prod-name AT ROW 3.29 COL 33.75 NO-LABEL
      980        "Объекты:" VIEW-AS TEXT
      981             SIZE 15.38 BY .92 AT ROW 1.13 COL 81.63
      982             FGCOLOR 4
      983        SPACE(2.74) SKIP(17.90)
      984       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      985            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      986            TITLE "Атрибуты товара на объекте".
      987   ASSIGN
      988          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      989          FRAME Dialog-Frame:HIDDEN           = TRUE.
      990   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      991   DO:
      992     APPLY "END-ERROR":U TO SELF.
      993   END.
      994   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      995   DO:
      996     define buffer buf_temp-oattr for temp-oattr.
      997     if add-option = "" then do:
      998          run gbl/pop-up.p (self:handle, no) no-error.
      999     end.
     1000     if add-option = "":U then return no-apply.
     1001     run proc-add-chg in this-procedure (yes ) no-error.
     1002     if error-status:error then do:
     1003       add-option = "":U.
     1004       return no-apply.
     1005     end.
     1006     OPEN QUERY br-attr FOR EACH temp-oattr NO-LOCK.
     1007     find first buf_temp-oattr no-lock where
     1008                buf_temp-oattr.code = add-option no-error.
     1009     add-option = "":U.
     1010     if avail buf_temp-oattr then
     1011         temp-doc-rec = recid(buf_temp-oattr).
     1012         else temp-doc-rec = ?.
     1013     reposition br-attr to recid temp-doc-rec no-error.
     1014     if error-status:error then return no-apply.
     1015   END.
     1016   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1017   DO:
     1018     if not avail temp-oattr then return no-apply.
     1019     run proc-add-chg in this-procedure ( no) no-error .
     1020     if error-status:error then return no-apply.
     1021     OPEN QUERY br-attr FOR EACH temp-oattr NO-LOCK.
     1022   END.
     1023   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1024   DO:
     1025   define variable loc#log             as logical   no-undo .
     1026   define variable attr-type           as character no-undo .
     1027   define variable attr-format         as character no-undo .
     1028   define variable attr-label          as character no-undo .
     1029   define variable attr-user-can-edit  as logical   no-undo .
     1030   define variable attr-output-display as logical   no-undo .
     1031   define variable attr-other          as character no-undo .
     1032   define variable jj                  as integer   no-undo .
     1033   define variable v-check             as character no-undo .
     1034   define variable v-correct           as logical   no-undo .
     1035   define variable v-error-code        as character no-undo .
     1036     if not available temp-oattr then return no-apply.
     1037       run gdsoattr-name in this-procedure
     1038         (input  temp-oattr.code
     1039         ,output attr-type
     1040         ,output attr-format
     1041         ,output attr-label
     1042         ,output attr-user-can-edit
     1043         ,output attr-output-display
     1044         ,output attr-other
     1045         ) no-error .
     1046       if error-status :error then do:
     1047         return no-apply .
     1048       end.
     1049     if not attr-user-can-edit then do:
     1050       message
     1051       "Атрибут нельзя удалить вручную"
     1052       view-as alert-box error .
     1053       return no-apply.
     1054     end.
     1055      do jj = 1 to num-entries(attr-other, chr(47)):
     1056       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "check-ext":U then do:
     1057         assign
     1058         v-check = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     1059         .
     1060       end.
     1061       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "check":U then do:
     1062         assign
     1063         v-check = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     1064         .
     1065       end.
     1066     end.
     1067     if v-check <> "":U then do:
     1068       run value(v-check)(
     1069                           input p-gds-code
     1070                         ,input p-obj-type
     1071                         ,input p-obj-code
     1072                         ,input attr-value
     1073                         ,input 'удаление':U
     1074                         ,output v-correct
     1075                         ,output v-error-code) no-error.
     1076       if error-status:error then do:
     1077         message
     1078         "Ошибка при проверке корректности удаления атрибута" skip
     1079         error-status:get-message(1) skip
     1080         view-as alert-box error .
     1081         undo, return no-apply .
     1082       end.
     1083       if not v-correct then do:
     1084         message
     1085         "Удаление атрибута некорректно" skip
     1086         return-value
     1087         view-as alert-box error .
     1088         undo, return no-apply .
     1089       end.
     1090     end.
     1091     loc#log = no.
     1092     message "Вы уверены, что хотите удалить атрибут " temp-oattr.attr-code skip
     1093             "на объекте " temp-oattr.obj-type temp-oattr.obj-code " для товара " goods-dsc-name
     1094             view-as alert-box QUESTIOn buttons YES-NO update loc#log.
     1095     if NOT loc#log then return no-apply.
     1096     delete temp-oattr.
     1097     updated = yes.
     1098    OPEN QUERY br-attr FOR EACH temp-oattr NO-LOCK.
     1099   END.
     1100   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1101   DO:
     1102     define buffer time_gds-obj-attr for ub.gds-obj-attr .
     1103     define variable v-now as datetime no-undo .
     1104     if available (temp-oattr) and temp-oattr.code = "dt-seasons" then do:
     1105       v-now = now .
     1106       find first time_gds-obj-attr exclusive-lock where time_gds-obj-attr.attr-code = "change-dt-seasons" and
     1107       time_gds-obj-attr.gds-code = temp-oattr.gds-code and
     1108       time_gds-obj-attr.obj-code = temp-oattr.obj-code and
     1109       time_gds-obj-attr.obj-type = temp-oattr.obj-type no-error .
     1110       if not available (time_gds-obj-attr) then
     1111       do:
     1112         create time_gds-obj-attr .
     1113         assign
     1114           time_gds-obj-attr.attr-code = "change-dt-seasons"
     1115           time_gds-obj-attr.gds-code  = temp-oattr.gds-code
     1116           time_gds-obj-attr.obj-code  = temp-oattr.obj-code
     1117           time_gds-obj-attr.obj-type  = temp-oattr.obj-type
     1118           .
     1119       end.
     1120       time_gds-obj-attr.attr-value  = iso-date(v-now) .
     1121       end.
     1122      RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     1123     IF ERROR-STATUS:ERROR THEN DO:
     1124        RETURN NO-APPLY.
     1125     END.
     1126   END.
     1127   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1128   DO:
     1129     if not available temp-oattr then return no-apply.
     1130     RUN proc-b-lookup IN THIS-PROCEDURE NO-ERROR.
     1131     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1132   END.
     1133   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1134   DO:
     1135   END.
     1136   ON MOUSE-SELECT-DBLCLICK OF br-attr IN FRAME Dialog-Frame
     1137   DO:
     1138     if not avail temp-oattr then return no-apply.
     1139     RUN proc-b-lookup IN THIS-PROCEDURE NO-ERROR.
     1140     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1141   END.
     1142   ON RETURN OF br-attr IN FRAME Dialog-Frame
     1143   DO:
     1144     if not avail temp-oattr then return no-apply.
     1145     RUN proc-b-lookup IN THIS-PROCEDURE NO-ERROR.
     1146     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1147   END.
     1148   ON VALUE-CHANGED OF RS-p-mode IN FRAME Dialog-Frame
     1149   DO:
     1150     assign
     1151     rs-p-mode
     1152     p-mode-obj = rs-p-mode
     1153     .
     1154     DO TRANSACTION on error undo,  return no-apply on stop undo, return no-apply:
     1155       case rs-p-mode:
     1156         when 'орг':U then do:
     1157           disable
     1158           b-del
     1159           b-add
     1160           b-chg
     1161           with frame Dialog-Frame.
     1162         end.
     1163         when 'объект':U then do:
     1164           enable
     1165           b-del when p-mode <> 'ПРОСМОТР':U
     1166           b-add when p-mode <> 'ПРОСМОТР':U
     1167           b-chg when p-mode <> 'ПРОСМОТР':U
     1168           with frame Dialog-Frame.
     1169         end.
     1170         when 'все':U then do:
     1171           disable
     1172           b-del when p-mode = 'ИЗМЕНЕНИЕ':U
     1173           b-add when p-mode = 'ИЗМЕНЕНИЕ':U
     1174           b-chg when p-mode = 'ИЗМЕНЕНИЕ':U
     1175           with frame Dialog-Frame.
     1176         end.
     1177         when "db":U then do:
     1178           disable
     1179           b-del when p-mode = 'ИЗМЕНЕНИЕ':U
     1180           b-add when p-mode = 'ИЗМЕНЕНИЕ':U
     1181           b-chg when p-mode = 'ИЗМЕНЕНИЕ':U
     1182           with frame Dialog-Frame.
     1183         end.
     1184       END CASE.
     1185       for each temp-oattr:
     1186         if p-mode = 'ИЗМЕНЕНИЕ':U
     1187         and (temp-oattr.obj-type = p-obj-type
     1188             and
     1189             temp-oattr.obj-code = p-obj-code) then.
     1190         else
     1191         delete temp-oattr.
     1192       end.
     1193       run attr-pop-clean-up in this-procedure ( input 'gds-obj-attr':U ).
     1194       run MyENable in this-procedure .
     1195       RUn init-proc(p-mode-obj).
     1196     END.
     1197   END.
     1198   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1199   on help of frame Dialog-Frame
     1200   do:
     1201     run gbl/app_help.p
     1202       (input this-procedure :file-name
     1203       ,input ''
     1204       ,input ?
     1205       ) no-error.
     1206     if error-status :error then do:
     1207       message
     1208         "Ошибка при вызове помощи"
     1209         error-status :get-message(1)
     1210         view-as alert-box .
     1211     end.
     1212   end.
     1213   run minbtn-set in this-procedure .
     1214   on choose of b-help in frame Dialog-Frame
     1215   do:
     1216     apply "help":u to frame Dialog-Frame .
     1217   end.
     1218   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1219   procedure minbtn-set :
     1220       do
     1221           on error undo, return error return-value
     1222           :
     1223           define variable ii              as integer       no-undo .
     1224           define variable fh              as widget-handle no-undo .
     1225           define variable hh              as widget-handle no-undo .
     1226           define variable v-h             as handle        extent 4 no-undo .
     1227           define variable v-name-button   as character     no-undo .
     1228           define variable v-help-old-x    as decimal       no-undo .
     1229           define variable v-help-old-y    as decimal       no-undo .
     1230           define variable v-help-old-size as decimal       no-undo .
     1231           define variable v-frame-width   as decimal       no-undo .
     1232           define variable jj              as integer       no-undo .
     1233           do
     1234               on error undo, return error
     1235               :
     1236               assign
     1237                   v-frame-width = frame Dialog-Frame:width - 0.3
     1238                   fh            = frame Dialog-Frame:first-child
     1239                   hh            = fh:first-child
     1240                   ii            = 1
     1241                   .
     1242               do while valid-handle(hh):
     1243                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1244                   do:
     1245                       case lc(hh:name) :
     1246                           when "b-help" then
     1247                               do:
     1248                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1249                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1250                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1251                                   hh:TOOLTIP = "Помощь" .
     1252                                   v-help-old-x = hh:column .
     1253                                   v-help-old-y = hh:row    .
     1254                                   v-help-old-size = hh:width .
     1255                                   hh:width-chars = 2.5 .
     1256                               end.
     1257                           when "b-print" then
     1258                               do:
     1259                                   hh:load-image("cmp/b-print.bmp":u) .
     1260                                   hh:TOOLTIP = "Печать" .
     1261                                   v-h[ii] = hh:handle .
     1262                                   ii = ii + 1 .
     1263                                   hh:width-chars = 3 .
     1264                               end.
     1265                           when "b-history" or
     1266                           when "b-hist" then
     1267                               do:
     1268                                   hh:load-image("cmp/b-hist.bmp":u) .
     1269                                   hh:TOOLTIP = "История" .
     1270                                   v-h[ii] = hh:handle .
     1271                                   ii = ii + 1 .
     1272                                   hh:width-chars = 3 .
     1273                               end.
     1274                           when "b-sch" then
     1275                               do:
     1276                                   hh:load-image("cmp/b-sch.bmp":u) .
     1277                                   hh:TOOLTIP = "Установка Фильтра" .
     1278                                   v-h[ii] = hh:handle .
     1279                                   ii = ii + 1 .
     1280                                   hh:width-chars = 3 .
     1281                               end.
     1282                           when "b-hist-user" then
     1283                               do:
     1284                                   hh:load-image("cmp/b-hist.bmp":u) .
     1285                                   hh:TOOLTIP = "История пользователя" .
     1286                                   ii = ii + 1 .
     1287                               end.
     1288                       end case.
     1289                   end.
     1290                   hh = hh:next-sibling.
     1291               end.
     1292               b-help:column = v-frame-width - b-help:width-chars.
     1293               jj = 0.
     1294               repeat ii = 4 to 1 by -1 :
     1295                   if valid-handle (v-h[ii] ) then
     1296                   do:
     1297                       jj  = jj + 1 .
     1298                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1299                       v-h[ii]:row    = v-help-old-y .
     1300                   end.
     1301               end.
     1302           end.
     1303       end.
     1304   end procedure.
     1305   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1306   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1307   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1308   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1309   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1310   define variable v-diasize-current-frame-height as decimal   no-undo .
     1311   define variable v-diasize-change-size          as logical   no-undo .
     1312   define variable v-diasize-resize-button        as handle    no-undo .
     1313   define variable v-diasize-wndmax               as logical   no-undo .
     1314   define variable v-diasize-wndstore             as logical   no-undo .
     1315   define variable v-diasize-proc-name            as character no-undo .
     1316   define variable v-diasize-browse-handle        as handle    no-undo .
     1317   define variable v-diasize-browse-number        as integer   no-undo .
     1318   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1319   define temp-table temp-diasize-handle no-undo
     1320     field handle-value  as handle
     1321     field save-position as decimal
     1322     index xpk is primary unique handle-value
     1323     .
     1324   define temp-table temp-browse-handle no-undo
     1325     field browse-type   as character
     1326     field browse-number as integer
     1327     field browse-handle as handle
     1328     field original-size as decimal
     1329     index xpk is primary unique browse-type browse-number
     1330     index xie browse-type browse-handle
     1331   .
     1332   procedure diasize_change-height :
     1333     define input  parameter p-change-value  as decimal   no-undo .
     1334     define input  parameter p-move-resize   as logical   no-undo .
     1335     define variable v-field-group-handle    as handle    no-undo .
     1336     define variable v-object-handle         as handle    no-undo .
     1337     define variable v-frame-height          as decimal   no-undo .
     1338     define variable v-frame-virtual-height  as decimal   no-undo .
     1339     define variable v-browse-height         as decimal   no-undo .
     1340     define variable v-window-height         as decimal   no-undo .
     1341     define variable v-window-virtual-height as decimal   no-undo .
     1342     define variable v-change-sign           as integer   no-undo .
     1343     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1344     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1345     if p-change-value > 0
     1346     then do:
     1347       if frame Dialog-Frame :height + p-change-value
     1348           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1349       then do:
     1350         assign
     1351           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1352                           - (frame Dialog-Frame :height-chars)
     1353         .
     1354         if p-change-value <= 0
     1355         then do:
     1356           run diasize_position-resize-button in this-procedure .
     1357           return .
     1358         end.
     1359       end.
     1360     end.
     1361     if p-change-value < 0
     1362     then do:
     1363       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1364       then do:
     1365         assign
     1366           p-change-value = v-diasize-orig-frame-height
     1367                          - (frame Dialog-Frame :height-chars)
     1368         .
     1369         if p-change-value >= 0
     1370         then do:
     1371           run diasize_position-resize-button in this-procedure .
     1372           return .
     1373         end.
     1374       end.
     1375     end.
     1376     if p-change-value >= 0
     1377     then do:
     1378       assign
     1379         v-change-sign = 1
     1380       .
     1381     end.
     1382     else do:
     1383       assign
     1384         v-change-sign = -1
     1385       .
     1386     end.
     1387     assign
     1388       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1389     .
     1390     if p-change-value = 0
     1391     then do:
     1392       run diasize_position-resize-button in this-procedure .
     1393       return .
     1394     end.
     1395     move_block:
     1396     do
     1397     on error undo move_block, retry move_block
     1398     :
     1399       if retry
     1400       then do:
     1401         do
     1402         on error undo move_block, leave move_block
     1403         :
     1404           if p-change-value > 0
     1405           then do:
     1406             for each buf_temp-diasize-handle
     1407             on error undo, next
     1408             :
     1409               assign
     1410                 v-object-handle = buf_temp-diasize-handle.handle-value
     1411               .
     1412               if v-object-handle <> v-diasize-resize-button
     1413               then do:
     1414                 assign
     1415                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1416                 .
     1417               end.
     1418             end.
     1419             assign
     1420               v-diasize-browse-handle :height = v-browse-height
     1421             .
     1422             for each buf_temp-browse-handle
     1423               where buf_temp-browse-handle.browse-type = 'height':u
     1424             on error undo, next
     1425             :
     1426               assign
     1427                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1428               .
     1429             end.
     1430             assign
     1431               frame Dialog-Frame :height = v-frame-height
     1432             .
     1433             if frame Dialog-Frame :scrollable = true
     1434             then do:
     1435               assign
     1436                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1437               .
     1438             end.
     1439             run diasize_position-resize-button in this-procedure .
     1440           end.
     1441           else do:
