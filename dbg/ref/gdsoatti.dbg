       15   DEFINE TEMP-TABLE tt0-gds-obj-attr NO-UNDO LIKE ub.gds-obj-attr.
       16   define input parameter parparentproc as widget-handle no-undo .
       17   define input parameter p-mode as character no-undo.
       18   define input parameter p-mode-obj as character no-undo .
       19   define input parameter p-gds-code as integer no-undo.
