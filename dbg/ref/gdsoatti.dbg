     1554           v-diasize-resize-button :column = 1
     1555         .
     1556       end.
     1557       if p-change-value > 0
     1558       then do:
     1559         if frame Dialog-Frame :scrollable = true
     1560         then do:
     1561           assign
     1562             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1563             no-error .
     1564           if error-status :error
     1565           or error-status :get-message(1) <> ""
     1566           then do:
     1567             undo move_block, retry move_block .
     1568           end.
     1569         end.
     1570         assign
