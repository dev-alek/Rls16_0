     1443             then do:
     1444               assign
     1445                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1446               .
     1447             end.
     1448             assign
     1449               frame Dialog-Frame :height = v-frame-height
     1450             .
     1451             assign
