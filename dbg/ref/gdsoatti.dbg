     1999             or error-status :get-message(1) <> ""
     2000             then do:
     2001               undo move_block, retry move_block .
     2002             end.
     2003           end.
     2004         end.
     2005       end.
     2006       else do:
     2007         for each buf_temp-diasize-handle
     2008         on error undo move_block, retry move_block
     2009         :
     2010           assign
     2011             v-object-handle = buf_temp-diasize-handle.handle-value
     2012           .
     2013           if v-object-handle <> v-diasize-resize-button
     2014           then do:
     2015             assign
     2016               v-object-handle :col = v-object-handle :col + p-change-value
     2017               no-error .
     2018             if error-status :error
     2019             or error-status :get-message(1) <> ""
     2020             then do:
     2021               undo move_block, retry move_block .
     2022             end.
     2023           end.
     2024         end.
     2025         for each buf_temp-browse-handle
     2026           where buf_temp-browse-handle.browse-type = 'width':u
     2027         on error undo move_block, retry move_block
     2028         :
     2029           assign
     2030             buf_temp-browse-handle.browse-handle :width
     2031               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2032             no-error .
     2033           if error-status :error
     2034           or error-status :get-message(1) <> ""
     2035           then do:
     2036             undo move_block, retry move_block .
     2037           end.
     2038         end.
     2039         assign
     2040           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2041           no-error .
     2042         if error-status :error
     2043         or error-status :get-message(1) <> ""
     2044         then do:
     2045           undo move_block, retry move_block.
     2046         end.
     2047         assign
     2048           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2049         no-error .
     2050         if error-status :error
     2051         or error-status :get-message(1) <> ""
     2052         then do:
     2053           undo move_block, retry move_block.
     2054         end.
     2055         if frame Dialog-Frame :scrollable = true
     2056         then do:
     2057           assign
     2058             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2059           no-error .
     2060           if error-status :error
     2061           or error-status :get-message(1) <> ""
     2062           then do:
     2063             undo move_block, retry move_block.
     2064           end.
     2065         end.
     2066       end.
     2067       if p-move-resize
     2068       then do:
     2069         run diasize_position-resize-button in this-procedure .
     2070       end.
     2071       if v-diasize-wndstore = true
     2072       then do:
     2073         if connected("ub") = true
     2074         then do:
     2075           define variable v-cntxt-db-num        as integer   no-undo .
     2076           define variable v-cntxt-userid        as character no-undo .
     2077           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2078                                             , OUTPUT v-cntxt-userid
     2079                                             ) .
     2080           run gbl/wndsizew.p
     2081             (input  v-cntxt-db-num
     2082             ,input  v-cntxt-userid
     2083             ,input  v-diasize-proc-name
     2084             ,input  'width':u
     2085             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2086             ) .
     2087         end.
     2088       end.
     2089     end.
     2090     assign
     2091       v-diasize-change-size = false
     2092     .
     2093   end procedure.
     2094   procedure diasize_set-width :
     2095     define input  parameter p-new-width  as decimal   no-undo .
     2096     define input  parameter p-move-resize as logical   no-undo .
     2097     do
     2098     on error undo, return error return-value
     2099     :
     2100       run diasize_change-width in this-procedure
     2101         (input  (p-new-width - frame Dialog-Frame :width)
     2102         ,input  p-move-resize
     2103         ) .
     2104     end.
     2105   end procedure.
     2106   procedure diasize_position-resize-button :
     2107     do with frame Dialog-Frame
     2108     :
     2109       hide v-diasize-resize-button .
     2110       assign
     2111         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2112                     - 1
     2113                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2114         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2115                     - 1
     2116                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2117       .
     2118       view v-diasize-resize-button .
     2119     end.
     2120   end procedure.
     2121   on alt-right anywhere
     2122   do:
     2123     run diasize_change-width in this-procedure
     2124       (input 1
     2125       ,input true
     2126       ) .
     2127     return no-apply .
     2128   end.
     2129   on alt-left anywhere
     2130   do:
     2131     run diasize_change-width in this-procedure
     2132       (input -1
     2133       ,input true
     2134       ) .
     2135     return no-apply .
     2136   end.
     2137   on alt-down anywhere
     2138   do:
     2139     run diasize_change-height in this-procedure
     2140       (input 1
     2141       ,input true
     2142       ) .
     2143     return no-apply .
     2144   end.
     2145   on alt-up anywhere
     2146   do:
     2147     run diasize_change-height in this-procedure
     2148       (input -1
     2149       ,input true
     2150       ) .
     2151     return no-apply .
     2152   end.
     2153   on alt-enter of frame Dialog-Frame
     2154   do:
     2155     run diasize_maximize in this-procedure
     2156       (input  ?
     2157       ).
     2158     return no-apply .
     2159   end.
     2160   procedure diasize_end-move :
     2161     do
     2162     on error undo, return error return-value
     2163     :
     2164       define variable v-row-delta as decimal   no-undo .
     2165       define variable v-col-delta as decimal   no-undo .
     2166       define variable v-new-row as decimal   no-undo .
     2167       define variable v-new-col as decimal   no-undo .
     2168       assign
     2169         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2170         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2171       .
     2172       assign
     2173         v-row-delta = v-new-row - frame Dialog-Frame :height
     2174         v-col-delta = v-new-col - frame Dialog-Frame :width
     2175       .
     2176       run diasize_change-height in this-procedure
     2177         (input v-row-delta
     2178         ,input true
     2179         ) .
     2180       run diasize_change-width in this-procedure
     2181         (input v-col-delta
     2182         ,input true
     2183         ) .
     2184     end.
     2185   end procedure.
     2186   procedure diasize_maximize :
     2187     define input  parameter p-action as logical   no-undo .
     2188     do
     2189     on error undo, return error return-value
     2190     :
     2191       if p-action = ?
     2192       then do:
     2193         if v-diasize-need-maximize = true
     2194         then do:
     2195           assign
     2196             p-action = true
     2197           .
     2198         end.
     2199         else do:
     2200           assign
     2201             p-action = false
     2202           .
     2203         end.
     2204       end.
     2205       if p-action = true
     2206       then do:
     2207         run diasize_change-height in this-procedure
     2208           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2209               - frame Dialog-Frame :height-chars
     2210           ,input true
     2211           ) .
     2212         run diasize_change-width in this-procedure
     2213           (input session :width-chars
     2214               - frame Dialog-Frame :width-chars
     2215           ,input true
     2216           ) .
     2217         assign
     2218           v-diasize-need-maximize = false
     2219         .
     2220       end.
     2221       else do:
     2222         run diasize_change-width in this-procedure
     2223           (input v-diasize-orig-frame-width
     2224               - frame Dialog-Frame :width-chars
     2225           ,input true
     2226           ) .
     2227         run diasize_change-height in this-procedure
     2228           (input v-diasize-orig-frame-height
     2229               - frame Dialog-Frame :height-chars
     2230           ,input true
     2231           ) .
     2232         assign
     2233           v-diasize-need-maximize = true
     2234         .
     2235       end.
     2236     end.
     2237   end procedure.
     2238   procedure diasize_restore-orig-size :
     2239     do
     2240     on error undo, return error return-value
     2241     :
     2242       assign
     2243         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2244         v-diasize-current-frame-height = frame Dialog-Frame :height
     2245       .
     2246       run diasize_set-height in this-procedure
     2247         (input  v-diasize-orig-frame-height
     2248         ,input  true
     2249         ) .
     2250       run diasize_set-width in this-procedure
     2251         (input  v-diasize-orig-frame-width
     2252         ,input  true
     2253         ) .
     2254     end.
     2255   end procedure.
     2256   procedure diasize_restore-current-size :
     2257     do
     2258     on error undo, return error return-value
     2259     :
     2260       run diasize_set-height in this-procedure
     2261         (input  v-diasize-current-frame-height
     2262         ,input  true
     2263         ) .
     2264       run diasize_set-width in this-procedure
     2265         (input  v-diasize-current-frame-width
     2266         ,input  true
     2267         ) .
     2268     end.
     2269   end procedure.
     2270   procedure diasize_set-browse-handle :
     2271     define input  parameter p-browse-handle as handle   no-undo .
     2272     define buffer buf_temp-browse-handle for temp-browse-handle .
     2273     do
     2274     on error undo, return error return-value
     2275     :
     2276       assign
     2277         v-diasize-browse-handle = p-browse-handle
     2278       .
     2279       for each buf_temp-browse-handle
     2280       on error undo, return error return-value
     2281       :
     2282         delete buf_temp-browse-handle .
     2283       end.
     2284     end.
     2285   end procedure.
     2286   procedure diasize_add_browse :
     2287     define input  parameter p-browse-type   as character no-undo .
     2288     define input  parameter p-browse-handle as handle    no-undo .
     2289     define buffer buf_temp-browse-handle for temp-browse-handle .
     2290     do
     2291     on error undo, return error return-value
     2292     :
     2293       assign
     2294         v-diasize-browse-number = v-diasize-browse-number + 1
     2295       .
     2296       create buf_temp-browse-handle .
     2297       assign
     2298         buf_temp-browse-handle.browse-type   = p-browse-type
     2299         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2300         buf_temp-browse-handle.browse-handle = p-browse-handle
     2301       .
     2302     end.
     2303   end procedure.
     2304   procedure diasize_init :
     2305     define variable v-default-value    as logical   no-undo .
     2306     define variable v-restore-saved    as logical   no-undo .
     2307     define variable v-resize-value-str as character no-undo .
     2308     do
     2309     on error undo, return error return-value
     2310     :
     2311       do with frame Dialog-Frame
     2312       :
     2313         assign
     2314           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2315           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2316           v-diasize-browse-handle     = browse br-attr :handle
     2317         .
     2318         create button v-diasize-resize-button
     2319         assign
     2320           parent        = frame Dialog-Frame :first-child
     2321           label         = "s"
     2322           height-pixels = 16
     2323           width-pixels  = 16
     2324           visible       = true
     2325           sensitive     = true
     2326           movable       = true
     2327           triggers:
     2328             on end-move persistent run diasize_end-move in this-procedure .
     2329           end triggers.
     2330         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2331         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2332         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2333         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2334         assign
     2335           v-diasize-wndmax = false
     2336         .
     2337         if connected("ub") = true
     2338         then do:
     2339           define variable v-cntxt-db-num        as integer   no-undo .
     2340           define variable v-cntxt-userid        as character no-undo .
     2341           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2342                                             , OUTPUT v-cntxt-userid
     2343                                             ) .
     2344           run gbl/wndpar_r.p
     2345             (input  v-cntxt-db-num
     2346             ,input  v-cntxt-userid
     2347             ,input  'wndmax':U
     2348             ,output v-diasize-wndmax
     2349             ,output v-default-value
     2350             ) .
     2351         end.
     2352         assign
     2353           v-diasize-wndstore = false
     2354         .
     2355         if connected("ub") = true
     2356         then do:
     2357           run gbl/wndpar_r.p
     2358             (input  v-cntxt-db-num
     2359             ,input  v-cntxt-userid
     2360             ,input  'wndstore':U
     2361             ,output v-diasize-wndstore
     2362             ,output v-default-value
     2363             ) .
     2364         end.
     2365         assign
     2366           v-diasize-proc-name = entry(1, program-name(2), '.')
     2367         .
     2368         if v-diasize-wndstore = true
     2369         then do:
     2370           assign
     2371             v-restore-saved = false
     2372           .
     2373           if connected("ub") = true
     2374           then do:
     2375             run gbl/wndsizer.p
     2376               (input  v-cntxt-db-num
     2377               ,input  v-cntxt-userid
     2378               ,input  v-diasize-proc-name
     2379               ,input  'height':u
     2380               ,output v-resize-value-str
     2381               ) .
     2382             if v-resize-value-str <> '':U
     2383             then do:
     2384               run diasize_change-height in this-procedure
     2385                 (input  integer(v-resize-value-str)
     2386                 ,input  true
     2387                 ) .
     2388               assign
     2389                 v-restore-saved = true
     2390               .
     2391             end.
     2392           end.
     2393           if connected("ub") = true
     2394           then do:
     2395             run gbl/wndsizer.p
     2396               (input  v-cntxt-db-num
     2397               ,input  v-cntxt-userid
     2398               ,input  v-diasize-proc-name
     2399               ,input  'width':u
     2400               ,output v-resize-value-str
     2401               ) .
     2402             if v-resize-value-str <> '':U
     2403             then do:
     2404               run diasize_change-width in this-procedure
     2405                 (input  integer(v-resize-value-str)
     2406                 ,input  true
     2407                 ) .
     2408               assign
     2409                 v-restore-saved = true
     2410               .
     2411             end.
     2412           end.
     2413           if v-restore-saved <> true
     2414           then do:
     2415             if v-diasize-wndmax = true
     2416             then do:
     2417               run diasize_maximize in this-procedure
     2418                 (input  true
     2419                 ) .
     2420             end.
     2421           end.
     2422         end.
     2423         else do:
     2424           if v-diasize-wndmax = true
     2425           then do:
     2426             run diasize_maximize in this-procedure
     2427               (input  true
     2428               ) .
     2429           end.
     2430         end.
     2431       end.
     2432     end.
     2433   end procedure.
     2434   procedure diasize_need-full-display :
     2435     define output parameter p-need-full-display as logical   no-undo .
     2436     do
     2437     on error undo, return error return-value
     2438     :
     2439       assign
     2440         p-need-full-display = v-diasize-need-full-display
     2441       .
     2442       assign
     2443         v-diasize-need-full-display = false
     2444       .
     2445     end.
     2446   end procedure.
     2447   procedure get-context :
     2448      define output parameter p-db-num as integer          no-undo.
     2449      define output parameter p-user-id as character        no-undo.
     2450      define variable v-login               as character    no-undo.
     2451      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2452      define buffer buf_user-login  for ub.user-login .
     2453      do
     2454      on error undo, return error
     2455      :
     2456            FIND FIRST buf_sys-ctrl no-lock.
     2457            ASSIGN
     2458               v-login = USERID("ub")
     2459               p-db-num = buf_sys-ctrl.db-num
     2460            .
     2461            FIND FIRST buf_user-login
     2462                 WHERE buf_user-login.db-num = p-db-num
     2463                   AND buf_user-login.user-login = v-login
     2464                 no-lock
     2465                 no-error
     2466                 .
     2467            IF AVAILABLE buf_user-login
     2468            THEN DO:
     2469               assign
     2470                  p-user-id = buf_user-login.user-id
     2471               .
     2472            END.
     2473      end.
     2474   end procedure.
     2475       run diasize_init in this-procedure .
     2476   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2477   do:
     2478     br-attr :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2479   end.
     2480   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2481   on f5 of frame Dialog-Frame anywhere
     2482   do:
     2483     OPEN QUERY br-attr FOR EACH temp-oattr NO-LOCK.
     2484       apply "VALUE-CHANGED" to br-attr.
     2485   end.
     2486   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2487   ON TAB ANYWHERE
     2488   DO:
     2489   define variable ii as integer no-undo .
     2490   define variable fh as widget-handle no-undo .
     2491   define variable hh as widget-handle no-undo .
     2492   define variable v-next-widget-name as character no-undo .
     2493   if v-tab-order <> '' then do:
     2494     if self:type = "TOGGLE-BOX" then
     2495     self:BGCOLOR = ?.
     2496     assign
     2497     ii = lookup(self:name, v-tab-order).
     2498     assign
     2499     ii = ii + 1
     2500     v-next-widget-name = entry(ii, v-tab-order)
     2501     no-error .
     2502     if error-status:error then do:
     2503       assign
     2504       ii = 1
     2505       v-next-widget-name = entry( ii, v-tab-order)
     2506       .
     2507     end.
     2508     assign
     2509     fh = frame Dialog-Frame:first-child
     2510     hh = fh:first-child
     2511     .
     2512     do while valid-handle(hh):
     2513       if hh:name = v-next-widget-name then do:
     2514         if hh:sensitive  = yes
     2515         AND hh:visible = yes then do:
     2516           if hh:type = "TOGGLE-BOX":U then do:
     2517             assign
     2518             hh:BGcolor = 1
     2519             .
     2520           end.
     2521           APPLY "ENTRY" to hh.
     2522           return no-apply.
     2523         end.
     2524         else do:
     2525           APPLY "TAB" to hh.
     2526           return no-apply.
     2527         end.
     2528       end.
     2529       hh = hh:next-sibling.
     2530     end.
     2531   end.
     2532   END.
     2533   ON BACK-TAB ANYWHERE
     2534   DO:
     2535   define variable ii as integer no-undo .
     2536   define variable fh as widget-handle no-undo .
     2537   define variable hh as widget-handle no-undo .
     2538   define variable v-next-widget-name as character no-undo .
     2539   if v-tab-order <> '' then do:
     2540     assign
     2541     ii = lookup(self:name, v-tab-order).
     2542     .
     2543     assign
     2544     ii = (if ii = 1
     2545           then  num-entries(v-tab-order)
     2546           else ii - 1
     2547           )
     2548     v-next-widget-name = entry(ii, v-tab-order)
     2549     .
     2550     assign
     2551     fh = frame Dialog-Frame:first-child
     2552     hh = fh:first-child
     2553     .
     2554     do while valid-handle(hh):
     2555       if hh:name = v-next-widget-name then do:
     2556         if hh:sensitive  = yes
     2557         AND hh:visible = yes then do:
     2558           if hh:type = "TOGGLE-BOX":U then do:
     2559             assign
     2560             hh:BGcolor = 1
     2561             .
     2562           end.
     2563           APPLY "ENTRY" to hh.
     2564           return no-apply.
     2565         end.
     2566         else do:
     2567         APPLY "BACK-TAB" to hh.
     2568         return no-apply.
     2569         end.
     2570       end.
     2571       hh = hh:next-sibling.
     2572     end.
     2573     end.
     2574   END.
     2575   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2576   ON RETURN ANYWHERE
     2577   DO:
     2578   define variable ii as integer no-undo .
     2579   define variable fh as widget-handle no-undo .
     2580   define variable hh as widget-handle no-undo .
     2581   define variable v-next-widget-name as character no-undo .
     2582     if v-tab-order <> '' then do:
     2583       assign
     2584       ii = lookup(self:name, v-tab-order).
     2585       if ii = num-entries(v-tab-order) then do:
     2586           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     2587           return no-apply.
     2588       end.
     2589       if self:type <> "BUTTON" and
     2590         self:type <> "EDITOR"  then do:
     2591         run proc-move-forward in this-procedure .
     2592         return no-apply.
     2593       end.
     2594       if self:type = "BUTTON" then do:
     2595         APPLY "CHOOSE" to self.
     2596       end.
     2597       if self:type = "TOGGLE-BOX" then
     2598       self:BGCOLOR = ?.
     2599       assign
     2600       ii = ii + 1
     2601       v-next-widget-name = entry(ii, v-tab-order)
     2602       no-error .
     2603       if error-status:error then do:
     2604         assign
     2605         ii = 1
     2606         v-next-widget-name = entry( ii, v-tab-order)
     2607         .
     2608       end.
     2609       assign
     2610       fh = frame Dialog-Frame:first-child
     2611       hh = fh:first-child
     2612       .
     2613       do while valid-handle(hh):
     2614         if hh:name = v-next-widget-name then do:
     2615           if hh:sensitive  = yes
     2616           AND hh:visible = yes then do:
     2617             if hh:type = "TOGGLE-BOX":U then do:
     2618               assign
     2619               hh:BGcolor = 1
     2620               .
     2621             end.
     2622             APPLY "ENTRY" to hh.
     2623             return no-apply.
     2624           end.
     2625           else do:
     2626             APPLY "TAB" to hh.
     2627             return no-apply.
     2628           end.
     2629         end.
     2630         hh = hh:next-sibling.
     2631       end.
     2632     end.
     2633   END.
     2634   procedure proc-move-forward :
     2635   define variable ii as integer no-undo .
     2636   define variable fh as widget-handle no-undo .
     2637   define variable hh as widget-handle no-undo .
     2638   define variable v-next-widget-name as character no-undo .
     2639   do
     2640   on error undo, return error
     2641   :
     2642     if v-tab-order <> '' then do:
     2643       if self:type = "TOGGLE-BOX" then
     2644       self:BGCOLOR = ?.
     2645       assign
     2646       ii = lookup(self:name, v-tab-order).
     2647       assign
     2648       ii = ii + 1
     2649       v-next-widget-name = entry(ii, v-tab-order)
     2650       no-error .
     2651       if error-status:error then do:
     2652         assign
     2653         ii = 1
     2654         v-next-widget-name = entry( ii, v-tab-order)
     2655         .
     2656       end.
     2657       assign
     2658       fh = frame Dialog-Frame:first-child
     2659       hh = fh:first-child
     2660       .
     2661       do while valid-handle(hh):
     2662         if hh:name = v-next-widget-name then do:
     2663           if hh:sensitive  = yes
     2664           AND hh:visible = yes then do:
     2665             if hh:type = "TOGGLE-BOX":U then do:
     2666               assign
     2667               hh:BGcolor = 1
     2668               .
     2669             end.
     2670             APPLY "ENTRY" to hh.
     2671             return.
     2672           end.
     2673           else do:
     2674             assign
     2675             ii = ii + 1
     2676             v-next-widget-name = entry(ii, v-tab-order)
     2677             no-error .
     2678             if error-status:error then do:
     2679               assign
     2680               ii = 1
     2681               v-next-widget-name = entry( ii, v-tab-order)
     2682               .
     2683             end.
     2684           end.
     2685         end.
     2686         hh = hh:next-sibling.
     2687       end.
     2688     end.
     2689   end.
     2690   end procedure.
     2691   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2692   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2693   MAIN-BLOCK:
     2694   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2695      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2696   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2697     run mainmenu_getcntxt in parparentproc
     2698       (output v-cntxt-db-num
     2699       ,output v-cntxt-userid
     2700       ,output v-cntxt-level
     2701       ,output v-cntxt-host-code-obj
     2702       ,output v-cntxt-obj-type
     2703       ,output v-cntxt-obj-code
     2704       ,output v-cntxt-db-num-obj
     2705       ,output v-cntxt-is-admin
     2706       ) .
     2707     ini-title  = frame Dialog-Frame:TITLE.
     2708     if NOT (p-mode = 'ПРОСМОТР':U
     2709           or p-mode = 'ИЗМЕНЕНИЕ':U
     2710           or p-mode = 'ДОБАВЛЕНИЕ':U
     2711           ) then do:
     2712       message
     2713       vss-workfile vss-revision vss-description skip
     2714       "Неверный параметр вызова p-mode" p-mode
     2715       view-as alert-box ERROR.
     2716       return error.
     2717     end.
     2718   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2719   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2720     (input  p-obj-type
     2721     ,input  p-obj-code
     2722     ,output v-host-code
     2723     )  .
     2724     if p-mode = 'ИЗМЕНЕНИЕ':U
     2725     or p-mode = 'ДОБАВЛЕНИЕ':U
     2726     then do:
     2727       assign
     2728       v-curr-obj-type = v-cntxt-obj-type
     2729       v-curr-obj-code = v-cntxt-obj-code
     2730       .
     2731       if not(p-obj-type = v-curr-obj-type
     2732              and
     2733              p-obj-code = v-curr-obj-code)
     2734          or v-curr-obj-type = "":U
     2735          or v-curr-obj-code = 0
     2736         then do:
     2737         message
     2738         vss-workfile vss-revision vss-description skip
     2739         "Редактирование атрибутов товара на объекте доступно только на текущем объекте" skip
     2740         "Текущий объект" v-curr-obj-type v-curr-obj-code
     2741         view-as alert-box error .
     2742         undo, return error.
     2743       end.
     2744     end.
     2745     for each  temp-oattr share-lock:
     2746       delete temp-oattr.
     2747     end.
     2748   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2749     RUN MyEnable in this-procedure .
     2750     Run init-proc(p-mode-obj).
     2751     WAIT-FOR GO OF FRAME Dialog-Frame.
     2752   END.
     2753   RUN disable_UI.
     2754   run attr-pop-clean-up in this-procedure ( input 'gds-obj-attr':U ).
     2755   if updated then return 'ИЗМЕНЕНИЕ':U.
     2756   PROCEDURE choose-to-edit :
     2757   define input parameter p-attr-code as character no-undo .
     2758   assign
     2759   add-option = p-attr-code
     2760   .
     2761   APPLY "CHOOSE" to b-add in frame Dialog-Frame .
     2762   END PROCEDURE.
     2763   PROCEDURE disable_UI :
     2764     HIDE FRAME Dialog-Frame.
     2765   END PROCEDURE.
     2766   PROCEDURE enable_UI :
     2767     DISPLAY RS-p-mode goods-artic Goods-dsc-name goods-gds-code goods-prod-type
     2768             goods-prod-code goods-prod-name
     2769         WITH FRAME Dialog-Frame.
     2770     ENABLE B-exit b-quit b-add B-lookup b-chg b-del b-help RS-p-mode goods-artic
     2771            Goods-dsc-name goods-gds-code goods-prod-type goods-prod-code
     2772            goods-prod-name
     2773         WITH FRAME Dialog-Frame.
     2774     VIEW FRAME Dialog-Frame.
     2775     OPEN QUERY br-attr FOR EACH temp-oattr NO-LOCK.
     2776   END PROCEDURE.
     2777   PROCEDURE init-proc :
     2778   DEFINE INPUT PARAMETER pp-mode as character no-undo.
     2779   define variable  attr-type           as character no-undo .
     2780   define variable  attr-format         as character no-undo .
     2781   define variable  attr-label          as character no-undo .
     2782   define variable  attr-value          as character no-undo .
     2783   define variable  attr-user-can-edit  as logical   no-undo .
     2784   define variable  attr-output-display as logical   no-undo .
     2785   define variable  attr-other          as character no-undo .
     2786   define buffer buf_goods for ub.goods.
     2787   define buffer buf_clients for ub.clients.
     2788   define buffer buf_prods for ub.clients.
     2789   for each  temp-oattr share-lock:
     2790     if p-mode = 'ИЗМЕНЕНИЕ':U
     2791     and (temp-oattr.obj-type = p-obj-type
     2792         and
     2793         temp-oattr.obj-code = p-obj-code) then.
     2794     else
     2795     delete temp-oattr.
     2796   end.
     2797   if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     2798     find first buf_goods where
     2799              buf_goods.gds-code =  p-gds-code no-lock no-error .
     2800     find first buf_prods where
     2801                 buf_prods.obj-code =  buf_goods.prod-code
     2802             and buf_prods.obj-type =  buf_goods.prod-type  no-lock no-error .
     2803     Assign
     2804     goods-dsc-name  = buf_Goods.gds-name
     2805     goods-artic     = buf_goods.artic
     2806     goods-gds-code  = buf_goods.gds-code
     2807     goods-prod-type = buf_goods.prod-type
     2808     goods-prod-code = buf_goods.prod-code
     2809     goods-prod-name = buf_prods.obj-name
     2810     .
     2811   display Goods-dsc-name goods-gds-code goods-artic
     2812   goods-prod-type goods-prod-code goods-prod-name
     2813     with frame Dialog-Frame  .
     2814   end.
     2815    For each tt0-gds-obj-attr where
     2816            tt0-gds-obj-attr.gds-code  = p-gds-code  no-lock :
     2817       if pp-mode = 'объект':U and NOT
     2818         (tt0-gds-obj-attr.obj-code = p-obj-code AND
     2819          tt0-gds-obj-attr.obj-type = p-obj-type) then NEXT.
     2820       if pp-mode = 'орг':U then do:
     2821         find first buf_clients no-lock where
     2822                 buf_Clients.obj-type = tt0-gds-obj-attr.obj-type
     2823             AND buf_Clients.obj-code = tt0-gds-obj-attr.obj-code no-error .
     2824         if not avail buf_Clients or buf_Clients.host-code <> v-host-code then NEXT.
     2825       end.
     2826       if pp-mode = "db":U then do:
     2827         find first buf_clients no-lock where
     2828                 buf_Clients.obj-type = tt0-gds-obj-attr.obj-type
     2829             AND buf_Clients.obj-code = tt0-gds-obj-attr.obj-code no-error .
     2830         if not avail buf_Clients or buf_Clients.db-num <> v-cntxt-db-num then NEXT.
     2831       end.
     2832       run gdsoattr-name ( input tt0-gds-obj-attr.attr-code ,
     2833                           output attr-type ,
     2834                           output attr-format,
     2835                           output attr-label,
     2836                           output attr-user-can-edit,
     2837                           output attr-output-display,
     2838                           output attr-other ).
     2839       if attr-output-display = true then DO:
     2840         find first temp-oattr where
     2841                   temp-oattr.code = tt0-gds-obj-attr.attr-code
     2842               AND temp-oattr.obj-code = tt0-gds-obj-attr.obj-code
     2843               AND temp-oattr.obj-type = tt0-gds-obj-attr.obj-type
     2844               AND temp-oattr.gds-code = tt0-gds-obj-attr.gds-code no-error.
     2845         if not available temp-oattr then do:
     2846           create temp-oattr.
     2847           assign
     2848           temp-oattr.attr-code = attr-label
     2849           Temp-oattr.value_ = tt0-gds-obj-attr.attr-value
     2850           Temp-oattr.attr-value = (if attr-type = 'L':U
     2851                                   then string(tt0-gds-obj-attr.attr-value = "yes":U, attr-format)
     2852                                   else tt0-gds-obj-attr.attr-value)
     2853           temp-oattr.user-can-edit = attr-user-can-edit
     2854           temp-oattr.code = tt0-gds-obj-attr.attr-code
     2855           temp-oattr.obj-code = tt0-gds-obj-attr.obj-code
     2856           temp-oattr.obj-type = tt0-gds-obj-attr.obj-type
     2857           temp-oattr.gds-code = tt0-gds-obj-attr.gds-code
     2858           .
     2859         end.
     2860       End.
     2861     End.
     2862     case pp-mode:
     2863       when 'все':U then do:
     2864       end.
     2865       when "db" then do:
     2866           frame Dialog-Frame:TITLE = ini-title + " - объекты БД " +
     2867                                       string(v-cntxt-db-num).
     2868       end.
     2869       when 'объект':U then do:
     2870           frame Dialog-Frame:TITLE = ini-title + chr(32) +
     2871                                       p-obj-type + chr(32) +
     2872                                       string(p-obj-code).
     2873       end.
     2874       when 'орг':U then do:
     2875           frame Dialog-Frame:TITLE = ini-title + " - объекты фирмы " +
     2876                                       string(v-host-code).
     2877       end.
     2878     end case.
     2879     OPEN QUERY br-attr FOR EACH temp-oattr NO-LOCK.
     2880   END PROCEDURE.
     2881   PROCEDURE MyEnable :
     2882   ASSIGN
     2883   b-add:POPUP-MENU IN FRAME Dialog-Frame = MENU MENU-b-add:HANDLE
     2884   b-add:MENU-MOUSE = 1
     2885   .
     2886   assign
     2887   v-tab-order = "b-exit,b-quit,b-add,b-lookup,b-chg,b-del,b-help,br-attr".
     2888   if p-mode <> 'ПРОСМОТР':U
     2889   and (rs-p-mode = 'объект':U
     2890        or
     2891        rs-p-mode = '')
     2892   then do:
     2893     run attr-pop-create-items in this-procedure  (
     2894                                                   input 'gds-obj-attr':U
     2895                                                   ,input 'gdsoattr-manual-edit'
     2896                                                   ,input 'gdsoattr-tooltip'
     2897                                                   ,input 'choose-to-edit'
     2898                                                   ,input menu menu-b-add:handle
     2899                                                   ,input 'scales-code,fbr-cost-rubl,gds-margins,free-price,sum-grp,increase-pc,round-method,petrol-purse,min-zapas,need-auth,proprietor,no-income-goods,taracode,calories-o,protein-o,fat-o,carbohydrate-o,doc-tickets,normal-wastage-o,dop-alt-name-o,dt-seasons,change-dt-seasons,mark-collect-type':u
     2900                                                 ).
     2901   end.
     2902   assign
     2903   rs-p-mode:radio-buttons in frame Dialog-Frame = "Текущий" + chr(44) + 'объект':U + chr(44) +
     2904                           "Объекты фирмы" + chr(44) + 'орг':U + chr(44) +
     2905                           "Объекты БД" + chr(44) + "db" +
     2906                           (if v-cntxt-db-num = 0 then (chr(44) + "Все объекты" + chr(44) + 'все':U) else "":U)
     2907                           .
     2908   RS-p-mode =  p-mode-obj.
     2909   DISPLAY Goods-dsc-name goods-gds-code goods-artic RS-p-mode
     2910       WITH FRAME Dialog-Frame.
     2911   ENABLE
     2912   b-exit when (p-mode <> 'ПРОСМОТР':U and p-mode-obj = 'объект':U)
     2913   b-quit
     2914   b-del when (p-mode <> 'ПРОСМОТР':U and p-mode-obj = 'объект':U)
     2915   b-add when (p-mode <> 'ПРОСМОТР':U and p-mode-obj = 'объект':U)
     2916   b-chg when (p-mode <> 'ПРОСМОТР':U and p-mode-obj = 'объект':U)
     2917   b-lookup
     2918   b-help br-attr Goods-dsc-name goods-gds-code goods-artic
     2919   RS-p-mode WHEN (p-mode-obj = 'орг':U OR p-mode-obj = 'объект':U)
     2920   WITH FRAME Dialog-Frame .
     2921   VIEW FRAME Dialog-Frame .
     2922   if p-mode = 'ПРОСМОТР':U then do:
     2923     hide
     2924     b-exit
     2925     in frame Dialog-Frame .
     2926     assign
     2927     b-quit:label = "&Выход"
     2928     b-quit:col    = 1
     2929     .
     2930   end.
     2931   if p-mode <> 'ПРОСМОТР':U then do:
     2932     if p-mode-obj = 'объект':U then do:
     2933       run gbl/tpsi-obj.p (
     2934                       input p-obj-type
     2935                       ,input p-obj-code
     2936                       ,output v-is-tpsi-object
     2937                                           ) no-error .
     2938     end.
     2939     find first tt-attr-property where
     2940               tt-attr-property.table-name = 'gds-obj-attr':U
     2941           and tt-attr-property.attr-code = 'proprietor':U no-error.
     2942     if available tt-attr-property then do:
     2943       assign
     2944       tt-attr-property.menu-item-handle:sensitive = v-is-tpsi-object
     2945       .
     2946     end.
     2947   end.
     2948   OPEN QUERY br-attr FOR EACH temp-oattr NO-LOCK.
     2949   APPLY "ENTRY" to br-attr.
     2950   END PROCEDURE.
     2951   PROCEDURE proc-add-chg :
     2952   define input parameter p-add as logical no-undo.
     2953   define variable attr-type           as character no-undo .
     2954   define variable attr-format         as character no-undo .
     2955   define variable attr-label          as character no-undo .
     2956   define variable attr-user-can-edit  as logical   no-undo .
     2957   define variable attr-output-display as logical   no-undo .
     2958   define variable attr-other          as character no-undo .
     2959   define variable attr-value          as character no-undo .
     2960   DEFINE VARIABLE v-attr-value        as character no-undo .
     2961   define variable loc#log             as logical   no-undo .
     2962   DEFINE VARIABLE v-init              as character no-undo .
     2963   define variable jj                  as integer   no-undo .
     2964   DEFINE VARIABLE v-spr               as character no-undo .
     2965   define variable v-spr-param         as character no-undo .
     2966   DEFINE VARIABLE v-setted            as logical   no-undo .
     2967   DEFINE VARIABLE v-deleted           as logical   no-undo .
     2968   define variable v-check             as character no-undo .
     2969   define variable v-error-code        as character no-undo .
     2970   define variable v-correct           as logical   no-undo .
     2971   CASE p-add:
     2972     when yes then do:
     2973       if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     2974         run temp-gdsoattr-exist in this-procedure(
     2975                                         input p-gds-code,
     2976                                         input p-obj-type,
     2977                                         input p-obj-code,
     2978                                         input add-option,
     2979                                         output loc#log)  no-error.
     2980         if error-status:error then return error.
     2981         if loc#log then do:
     2982           message
     2983           "Данный атрибут уже существует"
     2984           view-as alert-box error .
     2985           return error.
     2986         end.
     2987       end.
     2988       run gdsoattr-name in this-procedure
     2989         (input  add-option
     2990         ,output attr-type
     2991         ,output attr-format
     2992         ,output attr-label
     2993         ,output attr-user-can-edit
     2994         ,output attr-output-display
     2995         ,output attr-other
     2996         ) no-error .
     2997       if error-status :error then do:
     2998         return error .
     2999       end.
     3000       assign
     3001       added = yes.
     3002       do jj = 1 to num-entries(attr-other, chr(47)):
     3003         if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "init":U then do:
     3004           assign
     3005           v-init = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     3006           .
     3007         end.
     3008       end.
     3009       if  v-init <> "":U then do:
     3010           run  value(v-init)
     3011                       in this-procedure (p-gds-code, p-obj-type, p-obj-code, output attr-value) no-error .
     3012             if error-status:error then do:
     3013                 assign
     3014                 attr-value = "":U
     3015                 .
     3016             end.
     3017       end.
     3018       CASE attr-type:
     3019         when 'L':U then do:
     3020           assign
     3021           v-attr-value = "yes":U
     3022           .
     3023         end.
     3024         when 'I':U or when 'D':U then do:
     3025           assign
     3026           v-attr-value = if v-init <> "":U
     3027                         then attr-value
     3028                         else string(0)
     3029           .
     3030         end.
     3031         when 'T':U then do:
     3032           assign
     3033           v-attr-value = ?
     3034           .
     3035         end.
     3036         when 'C':U then do:
     3037           assign
     3038           v-attr-value = if v-init <> "":U
     3039                         then attr-value
     3040                         else "":U
     3041           .
     3042         end.
     3043       END CASE.
     3044       assign
     3045       attr-value = v-attr-value
     3046       .
     3047     end.
     3048     when no then do:
     3049       run gdsoattr-name in this-procedure(input temp-oattr.code,
     3050                                       output attr-type,
     3051                                       output attr-format,
     3052                                       output attr-label,
     3053                                       output attr-user-can-edit,
     3054                                       output attr-output-display,
     3055                                       output attr-other) no-error.
     3056       IF ERROR-STATUS:ERROR THEN DO:
     3057           message "Ошибка при определении названия и типа атрибута товара на объекте!"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     3058           return error.
     3059       END.
     3060       attr-value  = temp-oattr.value_.
     3061     end.
     3062   END CASE.
     3063   IF attr-user-can-edit Then DO:
     3064     do jj = 1 to num-entries(attr-other, chr(47)):
     3065       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "spr-ext":U
     3066       or entry(1, entry(jj, attr-other, chr(47)), "=":U) = "spr":U
     3067       then do:
     3068         assign
     3069         v-spr = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     3070         .
     3071       end.
     3072       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "spr-param":U then do:
     3073         assign
     3074         v-spr-param = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     3075         .
     3076       end.
     3077       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "check-ext":U then do:
     3078         assign
     3079         v-check = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     3080         .
     3081       end.
     3082       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "check":U then do:
     3083         assign
     3084         v-check = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     3085         .
     3086       end.
     3087     end.
     3088     if v-spr = "":U then do:
     3089       run gbl/d-prompt.w (
     3090         'title=':u + "Изменение атрибута товара на объекте" + '\':u
     3091       + 'text1=':u + attr-label + '\':u
     3092       + 'format=' + (if attr-type = 'L':U then "yes/no" else attr-format) + '\':u
     3093       + 'type=' + attr-type + '\':u
     3094       + 'fillin_row=2\':u
     3095       + 'fillin_col=4\':u
     3096       + 'fillin_width=20\':u
     3097       + 'fillin_height=1\':u
     3098       + 'max-chars=70\':u
     3099       + 'readonly=' + (if p-mode = 'ПРОСМОТР':U then 'yes':u else 'no':u) + '\':u
     3100       , input-output attr-value
     3101       ).
     3102       if return-value = 'false':u then return error.
     3103     end.
     3104     else do:
     3105       if v-spr-param = "":U then do:
     3106         run  value(v-spr) in this-procedure
     3107                                       (
     3108                                           input p-gds-code
     3109                                         ,input p-obj-type
     3110                                         ,input p-obj-code
     3111                                         ,input-output attr-value
     3112                                         ,output v-setted) no-error .
     3113       end.
     3114       else do:
     3115         run  value(v-spr) in this-procedure
     3116                                      (
     3117                                          input p-gds-code
     3118                                         ,input p-obj-type
     3119                                         ,input p-obj-code
     3120                                         ,input v-spr-param
     3121                                         ,input-output attr-value
     3122                                         ,output v-setted) no-error .
     3123       end.
     3124         if not v-setted then return error.
     3125     end.
     3126     if v-check <> "":U then do:
     3127       run value(v-check)(
     3128                          input p-gds-code
     3129                         ,input p-obj-type
     3130                         ,input p-obj-code
     3131                         ,input attr-value
     3132                         ,input (if p-add then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U)
     3133                         ,output v-correct
     3134                         ,output v-error-code) no-error.
     3135       if error-status:error then do:
     3136         message
     3137         "Ошибка при проверке корректности задаваемого значения атрибута" skip
     3138         error-status:get-message(1) skip
     3139         view-as alert-box error .
     3140         undo, return error .
     3141       end.
     3142       if not v-correct then do:
     3143         message
     3144         "Задаваемое значение атрибута некорректно" skip
     3145         return-value
     3146         view-as alert-box error .
     3147         undo, return error .
     3148       end.
     3149     end.
     3150     run temp-gdsoattr-write(
     3151         input p-gds-code,
     3152         input p-obj-type,
     3153         input p-obj-code,
     3154         input (if p-add then add-option else temp-oattr.code),
     3155         input attr-value) no-error .
     3156     IF not error-status:error then do:
     3157         assign
     3158         updated = yes
     3159         .
     3160        br-attr:refresh() in frame Dialog-Frame no-error .
     3161     END.
     3162     assign
     3163     added = no.
     3164   End.
     3165   Else message "Изменение атрибута невозможно !" view-as alert-box error.
     3166   END PROCEDURE.
     3167   PROCEDURE proc-b-lookup :
     3168   define variable attr-type           as character no-undo .
     3169   define variable attr-format         as character no-undo .
     3170   define variable attr-label          as character no-undo .
     3171   define variable attr-user-can-edit  as logical   no-undo .
     3172   define variable attr-output-display as logical   no-undo .
     3173   define variable attr-other          as character no-undo .
     3174   define variable attr-value          as character no-undo .
     3175   define variable v-run-name          as character no-undo .
     3176   define variable jj                  as integer   no-undo .
     3177   run gdsoattr-name in this-procedure(input temp-oattr.code,
     3178                                   output attr-type,
     3179                                   output attr-format,
     3180                                   output attr-label,
     3181                                   output attr-user-can-edit,
     3182                                   output attr-output-display,
     3183                                   output attr-other) no-error.
     3184   IF ERROR-STATUS:ERROR THEN DO:
     3185       message "Ошибка при определении названия и типа атрибута товара на объекте!"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     3186       return error.
     3187   END.
     3188   do jj = 1 to num-entries(attr-other, chr(47)):
     3189     if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "display" then do:
     3190       v-run-name = entry(2, entry(jj, attr-other, chr(47)), "=":U).
     3191       run value(v-run-name) in this-procedure(
     3192                                                input p-gds-code
     3193                                               ,input temp-oattr.attr-code
     3194                                               ,input temp-oattr.value_
     3195                                               ,input p-obj-type
     3196                                               ,input p-obj-code
     3197                                                )
     3198                                                no-error .
     3199       if error-status:error then undo, return error .
     3200       return .
     3201     end.
     3202   END.
     3203   BELL.
     3204   END PROCEDURE.
     3205   PROCEDURE proc-save :
     3206   DEFINE VARIABLE v-updated AS LOGICAL NO-UNDO.
     3207   define variable v-created as logical no-undo .
     3208   define variable v-deleted as logical no-undo .
     3209   define variable v-updated-str as character no-undo .
     3210   define variable v-type as character no-undo .
     3211   define variable v-issue-host-code like ub.sysconf.host-code no-undo .
     3212   for each temp-oattr NO-LOCK where
     3213            temp-oattr.gds-code = p-gds-code
     3214        AND temp-oattr.obj-type = p-obj-type
     3215        AND temp-oattr.obj-code = p-obj-code:
     3216      find first tt0-gds-obj-attr NO-LOCK WHERE
     3217             tt0-gds-obj-attr.gds-code = temp-oattr.gds-code
     3218       AND   tt0-gds-obj-attr.obj-type = temp-oattr.obj-type
     3219       AND   tt0-gds-obj-attr.obj-code = temp-oattr.obj-code
     3220       AND   tt0-gds-obj-attr.attr-code = temp-oattr.code no-error.
     3221     assign
     3222     v-updated = no.
     3223     if available  tt0-gds-obj-attr then do:
     3224       BUFFER-COMPARE temp-oattr
     3225                   TO tt0-gds-obj-attr
     3226                   case-sensitive
     3227                   SAVE result IN v-updated-str.
     3228       assign
     3229       v-created = yes
     3230       v-updated = (v-updated-str <> "":U)
     3231       .
     3232     end.
     3233     else do:
     3234       assign
     3235       v-updated = yes.
     3236     end.
     3237     if v-updated then do:
     3238       run tt0-gdsoattr-write in this-procedure(
     3239                                       input p-gds-code,
     3240                                       input temp-oattr.obj-type,
     3241                                       input temp-oattr.obj-code,
     3242                                       input temp-oattr.code,
     3243                                       input temp-oattr.value_)  no-error.
     3244       if error-status:error then do:
     3245         message
     3246         "Ошибка при сохранении атрибута товара на объекте" skip
     3247         "товар" p-gds-code skip
     3248         "объект" temp-oattr.obj-type temp-oattr.obj-code
     3249         "Атрибут" temp-oattr.attr-code
     3250         view-as alert-box  error .
     3251         undo, return error  .
     3252       end.
     3253       updated = yes.
     3254     end.
     3255     ASSIGN
     3256     p-updated = v-updated OR p-updated.
     3257   End.
     3258   FOR EACH tt0-gds-obj-attr where
     3259            tt0-gds-obj-attr.gds-code = p-gds-code
     3260        AND tt0-gds-obj-attr.obj-type = p-obj-type
     3261        AND tt0-gds-obj-attr.obj-code = p-obj-code:
     3262     FIND FIRST temp-oattr NO-LOCK WHERE
     3263               temp-oattr.gds-code = tt0-gds-obj-attr.gds-code
     3264           AND temp-oattr.obj-type = tt0-gds-obj-attr.obj-type
     3265           AND temp-oattr.obj-code = tt0-gds-obj-attr.obj-code
     3266           AND temp-oattr.code = tt0-gds-obj-attr.attr-code NO-ERROR.
     3267       IF NOT AVAILABLE temp-oattr THEN DO:
     3268         DELETE tt0-gds-obj-attr.
     3269         assign
     3270         v-deleted = yes.
     3271         ASSIGN
     3272         p-updated = (v-deleted OR p-updated).
     3273       END.
     3274   END.
     3275   if p-updated
     3276   and p-update-instantly then do:
     3277     run ref/gdsoatr1.p (
     3278                        input p-mode
     3279                       ,input p-gds-code
     3280                       ,input p-obj-type
     3281                       ,input p-obj-code
     3282                       ,INPUT table tt0-gds-obj-attr
     3283                       ) no-error .
     3284     if error-status:error then do:
     3285       message
     3286       substitute("Ошибка при сохранении атрибутов товара на объекте:&1&2&1&3"
     3287                  , chr(10)
     3288                  , error-status:get-message(1)
     3289                  , return-value )
     3290       view-as alert-box
     3291       error .
     3292       undo, return error .
     3293     end.
     3294   end.
     3295   END PROCEDURE.
     3296   PROCEDURE temp-gdsoattr-exist :
     3297    do
     3298     on error undo, return error
     3299     :
     3300       define input parameter p-gds-code like ub.gds-obj-attr.gds-code   no-undo .
     3301       define input parameter p-obj-type like ub.gds-obj-attr.obj-type   no-undo .
     3302       define input parameter p-obj-code like ub.gds-obj-attr.obj-code   no-undo .
     3303       define input parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
     3304       define output parameter p-exist    as logical no-undo .
     3305       define buffer buf_gds-obj-attr for ub.gds-obj-attr .
     3306       define buffer buf_temp-oattr for temp-oattr .
     3307       define variable v-type           as character no-undo .
     3308       define variable v-format         as character no-undo .
     3309       define variable v-label          as character no-undo .
     3310       define variable v-user-can-edit  as logical   no-undo .
     3311       define variable v-output-display as logical   no-undo .
     3312       define variable v-other          as character no-undo .
     3313       run gdsoattr-name in this-procedure
     3314         (input  p-code
     3315         ,output v-type
     3316         ,output v-format
     3317         ,output v-label
     3318         ,output v-user-can-edit
     3319         ,output v-output-display
     3320         ,output v-other
     3321         ) no-error .
     3322       if error-status :error then do:
     3323         undo, return error return-value .
     3324       end.
     3325       find first buf_temp-oattr no-lock where
     3326                  buf_temp-oattr.gds-code  = p-gds-code AND
     3327                  buf_temp-oattr.obj-type  = p-obj-type AND
     3328                  buf_temp-oattr.obj-code  = p-obj-code AND
     3329                  buf_temp-oattr.attr-code = p-code no-error .
     3330       if available buf_temp-oattr then do:
     3331         P-EXIST = YES.
     3332       end.
     3333     end.
     3334   END PROCEDURE.
     3335   PROCEDURE temp-gdsoattr-write :
     3336     do
     3337     on error undo, return error
     3338     :
     3339       define input parameter p-gds-code like ub.gds-obj-attr.gds-code   no-undo .
     3340       define input parameter p-obj-type like ub.gds-obj-attr.obj-type   no-undo .
     3341       define input parameter p-obj-code like ub.gds-obj-attr.obj-code   no-undo .
     3342       define input parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
     3343       define input parameter p-value    like ub.gds-obj-attr.attr-value no-undo .
     3344       define buffer buf_temp-oattr for temp-oattr .
     3345       define variable v-type           as character no-undo .
     3346       define variable v-format         as character no-undo .
     3347       define variable v-label          as character no-undo .
     3348       define variable v-user-can-edit  as logical   no-undo .
     3349       define variable v-output-display as logical   no-undo .
     3350       define variable v-other          as character no-undo .
     3351       run gdsoattr-name in this-procedure
     3352         (input  p-code
     3353         ,output v-type
     3354         ,output v-format
     3355         ,output v-label
     3356         ,output v-user-can-edit
     3357         ,output v-output-display
     3358         ,output v-other
     3359         ) no-error .
     3360       if error-status :error then do:
     3361         undo, return error return-value .
     3362       end.
     3363       find first buf_temp-oattr exclusive-lock where
     3364                  buf_temp-oattr.gds-code  = p-gds-code AND
     3365                  buf_temp-oattr.obj-type  = p-obj-type AND
     3366                  buf_temp-oattr.obj-code  = p-obj-code AND
     3367                  buf_temp-oattr.code      = p-code no-error no-wait .
     3368       if not available buf_temp-oattr then do:
     3369         create buf_temp-oattr .
     3370         assign
     3371           buf_temp-oattr.gds-code  = p-gds-code
     3372           buf_temp-oattr.obj-type  = p-obj-type
     3373           buf_temp-oattr.obj-code  = p-obj-code
     3374           buf_temp-oattr.attr-code = v-label
     3375           buf_temp-oattr.code      = p-code
     3376           buf_temp-oattr.attr-value = (if v-type = 'L':U then string(logical(p-value), v-format) else p-value)
     3377           buf_temp-oattr.value_ = p-value
     3378           no-error
     3379         .
     3380       end.
     3381       ELSE
     3382       ASSIGN
     3383       buf_temp-oattr.attr-value = (if v-type = 'L':U then string(logical(p-value), v-format) else p-value)
     3384       buf_temp-oattr.value_ = p-value
     3385       no-error.
     3386     end.
     3387   END PROCEDURE.
     3388   PROCEDURE tt0-gdsoattr-write :
     3389     do
     3390     on error undo, return error
     3391     :
     3392       define input parameter p-gds-code like ub.gds-obj-attr.gds-code   no-undo .
     3393       define input parameter p-obj-type like ub.gds-obj-attr.obj-type   no-undo .
     3394       define input parameter p-obj-code like ub.gds-obj-attr.obj-code   no-undo .
     3395       define input parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
     3396       define input parameter p-value    like ub.gds-obj-attr.attr-value no-undo .
     3397       define buffer buf_tt0-gds-obj-attr for tt0-gds-obj-attr .
     3398       define variable v-type           as character no-undo .
     3399       define variable v-format         as character no-undo .
     3400       define variable v-label          as character no-undo .
     3401       define variable v-user-can-edit  as logical   no-undo .
     3402       define variable v-output-display as logical   no-undo .
     3403       define variable v-other          as character no-undo .
     3404       run gdsoattr-name in this-procedure
     3405         (input  p-code
     3406         ,output v-type
     3407         ,output v-format
     3408         ,output v-label
     3409         ,output v-user-can-edit
     3410         ,output v-output-display
     3411         ,output v-other
     3412         ) no-error .
     3413       if error-status :error then do:
     3414         undo, return error return-value .
     3415       end.
     3416       find first buf_tt0-gds-obj-attr exclusive-lock where
     3417                  buf_tt0-gds-obj-attr.gds-code  = p-gds-code AND
     3418                  buf_tt0-gds-obj-attr.obj-type  = p-obj-type AND
     3419                  buf_tt0-gds-obj-attr.obj-code  = p-obj-code AND
     3420                  buf_tt0-gds-obj-attr.attr-code = p-code no-error .
     3421       if not available buf_tt0-gds-obj-attr then do:
     3422         create buf_tt0-gds-obj-attr .
     3423         assign
     3424           buf_tt0-gds-obj-attr.gds-code  = p-gds-code
     3425           buf_tt0-gds-obj-attr.obj-type  = p-obj-type
     3426           buf_tt0-gds-obj-attr.obj-code  = p-obj-code
     3427           buf_tt0-gds-obj-attr.attr-code = p-code
     3428           buf_tt0-gds-obj-attr.attr-value = p-value no-error
     3429         .
     3430       end.
     3431       ELSE
     3432       ASSIGN
     3433       buf_tt0-gds-obj-attr.attr-value = p-value no-error.
     3434       release buf_tt0-gds-obj-attr no-error .
     3435       if error-status:error then do:
     3436         undo, return error return-value .
     3437       end.
     3438     end.
     3439   END PROCEDURE.
