     1497         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1498         v-browse-height = v-diasize-browse-handle :height
     1499       .
     1500       for each buf_temp-browse-handle
     1501         where buf_temp-browse-handle.browse-type = 'height':u
