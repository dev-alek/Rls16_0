     1962         then do:
     1963           undo move_block, retry move_block.
     1964         end.
     1965         assign
     1966           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1967         no-error .
     1968         if error-status :error
     1969         or error-status :get-message(1) <> ""
     1970         then do:
     1971           undo move_block, retry move_block.
     1972         end.
     1973         for each buf_temp-browse-handle
     1974           where buf_temp-browse-handle.browse-type = 'width':u
     1975         on error undo move_block, retry move_block
     1976         :
     1977           assign
     1978             buf_temp-browse-handle.browse-handle :width
     1979               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1980             no-error .
