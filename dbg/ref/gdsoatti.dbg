     1688           define variable v-cntxt-db-num        as integer   no-undo .
     1689           define variable v-cntxt-userid        as character no-undo .
     1690           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1691                                             , OUTPUT v-cntxt-userid
     1692                                             ) .
     1693           run gbl/wndsizew.p
     1694             (input  v-cntxt-db-num
     1695             ,input  v-cntxt-userid
     1696             ,input  v-diasize-proc-name
     1697             ,input  'height':u
     1698             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1699             ) .
     1700         end.
     1701       end.
     1702     end.
     1703     assign
     1704       v-diasize-change-size = false
     1705     .
     1706   end procedure.
     1707   procedure diasize_set-height :
     1708     define input  parameter p-new-height  as decimal   no-undo .
     1709     define input  parameter p-move-resize as logical   no-undo .
     1710     do
     1711     on error undo, return error return-value
     1712     :
     1713       run diasize_change-height in this-procedure
     1714         (input  (p-new-height - frame Dialog-Frame :height)
     1715         ,input  p-move-resize
     1716         ) .
     1717     end.
     1718   end procedure.
     1719   procedure diasize_change-width :
     1720     define input  parameter p-change-value as decimal   no-undo .
     1721     define input  parameter p-move-resize  as logical   no-undo .
     1722     define variable v-field-group-handle   as handle    no-undo .
     1723     define variable v-object-handle        as handle    no-undo .
     1724     define variable v-frame-width          as decimal   no-undo .
     1725     define variable v-frame-virtual-width  as decimal   no-undo .
     1726     define variable v-browse-width         as decimal   no-undo .
     1727     define variable v-window-width         as decimal   no-undo .
     1728     define variable v-window-virtual-width as decimal   no-undo .
     1729     define variable v-change-sign          as integer   no-undo .
     1730     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1731     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1732     if p-change-value > 0
     1733     then do:
     1734       if frame Dialog-Frame :width + p-change-value >
     1735           session :width-chars
     1736       then do:
     1737         assign
     1738           p-change-value = session :width-chars - frame Dialog-Frame :width
     1739         .
     1740         if p-change-value <= 0
     1741         then do:
     1742           run diasize_position-resize-button in this-procedure .
     1743           return .
     1744         end.
     1745       end.
     1746     end.
     1747     if p-change-value < 0
     1748     then do:
     1749       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1750       then do:
     1751         assign
     1752           p-change-value = v-diasize-orig-frame-width
     1753                          - frame Dialog-Frame :width
     1754         .
     1755         if p-change-value >= 0
     1756         then do:
     1757           run diasize_position-resize-button in this-procedure .
     1758           return .
     1759         end.
     1760       end.
     1761     end.
     1762     if p-change-value >= 0
     1763     then do:
     1764       assign
     1765         v-change-sign = 1
     1766       .
     1767     end.
     1768     else do:
     1769       assign
     1770         v-change-sign = -1
     1771       .
     1772     end.
     1773     assign
     1774       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1775     .
     1776     if p-change-value = 0
     1777     then do:
     1778       run diasize_position-resize-button in this-procedure .
     1779       return .
     1780     end.
     1781     move_block:
