     1910           and can-query(v-object-handle, "height")
     1911           and ( v-object-handle :col + v-object-handle :width
     1912                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1913               )
     1914           then do:
     1915             find first buf_temp-browse-handle
     1916               where buf_temp-browse-handle.browse-type   = 'width':u
     1917                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1918               no-error .
