        1   DEFINE BUFFER locked_country FOR ub.country.
        2   DEFINE TEMP-TABLE tt-country NO-UNDO LIKE ub.country.
        3   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        4   define input parameter p-mode as character no-undo.
        5   define input parameter p-alpha1 like ub.country.alpha1 no-undo .
        6   define input-output parameter p-doc-rec as recid no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Карточка редактирования страны".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define variable v-waitfram-action01         as character   no-undo .
       69   define variable v-waitfram-action02         as character   no-undo .
       70   define variable v-waitfram-action03         as character   no-undo .
       71   define variable mWaitFramTextBeg            as character   no-undo.
       72   define variable mWaitFramTextEnd            as character   no-undo.
       73   define variable mWaitFramView               as logical     no-undo.
       74   define variable mWaitProcEvent              as logical     no-undo init yes.
       75   define variable mWaitFramInterval           as integer     no-undo init 1 .
       76   define variable mWaitFramStop               as logical     no-undo.
       77   define variable mWaitFramStopUser           as logical     no-undo.
       78   define variable mWaitFramStopTimeOut        as logical     no-undo.
       79   define variable mWaitFramStartProc          as datetime-tz no-undo.
       80   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       81   define button B-WaitFramStop auto-end-key
       82        label "Стоп"
       83        size 10 by 1 tooltip "Остоновить процесс".
       84   define button B-viewProcInfo
       85        label "Информация"
       86        size 15 by 1 tooltip "Информация о процесс".
       87   define frame waitfram
       88     v-waitfram-action01 format "x(72)" no-label skip
       89     v-waitfram-action02 format "x(72)" no-label skip
       90     v-waitfram-action03 format "x(72)" no-label skip
       91     B-viewProcInfo
       92     B-WaitFramStop at row 4 col 30
       93     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       94     .
       95   define new global shared variable mBatchMode as logical no-undo init ?.
       96   define variable mFramBachModHandle as handle no-undo.
       97   mFramBachModHandle = frame waitfram:handle.
       98   define variable mFameOldVis as logical no-undo.
       99   define variable mVisCUrentVin as logical no-undo.
      100   if session:batch-mode
      101   then
      102      mBatchMode = yes.
      103   if mBatchMode = ? then do:
      104     mVisCUrentVin = current-window:visible.
      105     mFameOldVis = mFramBachModHandle:visible.
      106     mFramBachModHandle:visible  = yes.
      107     mBatchMode = mFramBachModHandle:visible ne yes.
      108     mFramBachModHandle:visible = mFameOldVis.
      109     current-window:visible = mVisCUrentVin.
      110   end.
      111    if  log-manager:logfile-name ne ?
      112     then DO:
      113         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      114         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      115         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      116     end.
      117   on choose of B-WaitFramStop in frame waitfram
      118   do:
      119     mWaitFramStop = yes.
      120     mWaitFramStopUser = yes.
      121   end.
      122   function waitfram-check-timeout returns logical():
      123      define variable vtime as int64 no-undo.
      124      if mWaitFramStopTimeOut
      125      then
      126         return yes.
      127      vtime = ( now - mWaitFramStartProc ) / 1000 .
      128      if     mWaitFramTimeOut ne ?
      129         and mWaitFramTimeOut ne 0
      130         and mWaitFramTimeOut lt vtime
      131      then do:
      132         mWaitFramStopTimeOut = yes.
      133      end.
      134      return mWaitFramStopTimeOut.
      135   end.
      136   procedure waitfram-hide :
      137     if not session:batch-mode
      138     then do
      139     on error undo, return error return-value
      140     :
      141       pause 0 before-hide .
      142       if not mBatchMode then
      143         hide frame waitfram .
      144     if     not mWaitFramView
      145        and mWaitProcEvent
      146     then
      147       process events .
      148     end.
      149   end procedure.
      150   procedure waitfram-show :
      151     define input  parameter p-message as character no-undo .
      152     define variable v-left-margin as integer   no-undo .
      153     if not session:batch-mode
      154     then do
      155     on error undo, return error return-value
      156     :
      157       if length(p-message) <= 70 then do:
      158         assign
      159           v-left-margin = integer((70 - length(p-message)) / 2)
      160         .
      161         assign
      162           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      163         .
      164         assign
      165           v-waitfram-action01 = " "
      166           v-waitfram-action02 = " "
      167                                    + fill(" ", v-left-margin)
      168                                    + p-message
      169           v-waitfram-action03 = " "
      170         .
      171       end.
      172       else do:
      173         define variable vRindex1 as integer no-undo.
      174         define variable vRindex2 as integer no-undo.
      175         vRindex1 = r-index(p-message," ",70).
      176         if vRindex1 = 0
      177         then
      178            vRindex1 = 70.
      179         if length(p-message)  <= vRindex1 + 70 then do:
      180           assign
      181             v-waitfram-action01 = " "
      182             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      183             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      184           .
      185         end.
      186         else do:
      187           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      188           if vRindex2 <= vRindex1
      189           then
      190              vRindex2 = vRindex1 + 70.
      191           assign
      192             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      193             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      194             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      195           .
      196         end.
      197       end.
      198       B-viewProcInfo:visible   in frame waitfram = no.
      199       B-viewProcInfo:sensitive in frame waitfram = no.
      200       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      201       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      202       if  (   mWaitFramView
      203          or  mWaitProcEvent)
      204          and not mBatchMode
      205       then
      206          display
      207             v-waitfram-action01 skip
      208             v-waitfram-action02 skip
      209             v-waitfram-action03 skip
      210          with frame waitfram .
      211       if     mWaitFramView
      212          then do:
      213             if     mWaitFramInterval ne ?
      214                and not mBatchMode
      215             then
      216                wait-for go of frame waitfram pause mWaitFramInterval.
      217          end.
      218          else
      219             if     mWaitProcEvent
      220                and not mBatchMode
      221             then
      222                process events .
      223     end.
      224   end procedure.
      225      procedure waitfram-show-this:
      226         define input  parameter iInterval as int64 no-undo.
      227         define variable vtime as int64 no-undo.
      228         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      229         mWaitFramInterval = iInterval.
      230         run waitfram-show (substitute("&1&2 &3&4" ,
      231                                       mWaitFramTextBeg ,
      232                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      233                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      234                                       mWaitFramTextEnd
      235                                      )
      236                           ).
      237      end.
      238      procedure WaitFramRunPause:
      239         define input  parameter iInterval as dec no-undo.
      240         define variable vStart  as datetime-tz no-undo.
      241         define variable vend    as datetime-tz no-undo.
      242         define variable vint as int64 no-undo.
      243         define variable vOk as logical no-undo.
      244         vStart = now.
      245         vend   = vStart.
      246         publish "WaitFramPause" (iInterval,output vOk).
      247         vend   =  now.
      248         vint = vend - vStart.
      249         vint = iInterval - vint / 1000.
      250         if     not mWaitFramStop
      251            and (   vint > 0
      252                 or (    not vOk
      253                     and iInterval eq ?
      254                     )
      255                 )
      256         then
      257            run waitfram-show-this (iInterval).
      258         vend   =  now.
      259         vint = vend - vStart.
      260         vint = iInterval - vint / 1000.
      261         if     not mWaitFramStop
      262            and vint > 0
      263         then do:
      264            run gbl/pause.p (vint * 1000).
      265         end.
      266         if iInterval ne ?
      267         then
      268            publish "WaitFramStop".
      269         waitfram-check-timeout().
      270      end.
      271      procedure WaitFramWaitFor:
      272         define input  parameter iInterval as dec no-undo.
      273         assign
      274            mWaitFramStartProc   = now
      275            mWaitFramStopUser    = no
      276            mWaitFramStopTimeOut = no
      277         .
      278         block-wait:
      279         do while not mWaitFramStop:
      280            run WaitFramRunPause (iInterval).
      281            if  waitfram-check-timeout()
      282            then do:
      283               leave block-wait.
      284            end.
      285         end.
      286         run waitfram-hide.
      287      end.
      288   procedure waitfram-join :
      289     define input  parameter p-line-1  as character no-undo .
      290     define input  parameter p-line-2  as character no-undo .
      291     define input  parameter p-line-3  as character no-undo .
      292     define output parameter p-message as character no-undo .
      293     do
      294     on error undo, return error return-value
      295     :
      296       assign
      297         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      298                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      299                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      300       .
      301     end.
      302   end procedure.
      303   function waitfram-join-function returns character
      304     (input p-line-1 as character
      305     ,input p-line-2 as character
      306     ,input p-line-3 as character
      307     ).
      308     define variable v-message as character no-undo .
      309     run waitfram-join in this-procedure
      310       (input  p-line-1
      311       ,input  p-line-2
      312       ,input  p-line-3
      313       ,output v-message
      314       ) .
      315     return v-message .
      316   end function .
      317   define new global shared variable g#language as character no-undo .
      318   if g#language <> '' and g#language <> 'rus':U then do:
      319     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      320   end.
      321   define new global shared variable g#library  as handle no-undo .
      322   define new global shared variable g#library2 as handle no-undo .
      323   procedure proc-alt-shift-f2:
      324     if not ibs.th.gbl.gbl-var:rcode
      325   then
      326     run gbl\inidebug.p .
      327   end.
      328   procedure proc-alt-shift-f3:
      329     run gbl/prvssinf.p
      330       ( input this-procedure
      331       ) .
      332   end.
      333   define variable v-inform-launched as logical no-undo initial false .
      334   procedure proc-alt-shift-f4:
      335     define variable v-action as character no-undo .
      336     if v-inform-launched = false then do:
      337       assign
      338         v-inform-launched = true
      339       .
      340       run gbl/d-inform.w
      341         (  input self
      342         ,  input this-procedure
      343         , output v-action
      344         ) no-error .
      345       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      346       assign
      347         v-inform-launched = false
      348       .
      349     end.
      350   end.
      351   procedure proc-alt-f1:
      352     run gbl/corrhelp.p
      353       (input this-procedure
      354       ) .
      355   end .
      356   on alt-shift-f2 anywhere do:
      357     run proc-alt-shift-f2.
      358   end.
      359   on alt-shift-f3 anywhere do:
      360     run proc-alt-shift-f3 in this-procedure .
      361   end.
      362   on alt-shift-f4 anywhere do:
      363     run proc-alt-shift-f4 in this-procedure.
      364   end.
      365   on alt-f1 anywhere do:
      366     run proc-alt-f1 in this-procedure .
      367   end.
      368   define variable v-tab-order as character no-undo.
      369   define variable v-db-num LIKE ub.db.db-num no-undo.
      370   DEFINE BUTTON B-exit AUTO-GO
      371        LABEL "&Ввод"
      372        SIZE 10 BY 1
      373        BGCOLOR 8 .
      374   DEFINE BUTTON B-Help
      375        LABEL "Помо&щь"
      376        SIZE 10 BY 1
      377        BGCOLOR 8 .
      378   DEFINE BUTTON B-hist
      379        LABEL "Ис&тория"
      380        SIZE 10 BY 1.
      381   DEFINE BUTTON b-quit AUTO-END-KEY
      382        LABEL "&Отмена"
      383        SIZE 10 BY 1
      384        BGCOLOR 8 .
      385   DEFINE QUERY Dialog-Frame FOR
      386         tt-country SCROLLING.
      387   DEFINE FRAME Dialog-Frame
      388        B-exit AT ROW 1 COL 1
      389        b-quit AT ROW 1 COL 11
      390        B-hist AT ROW 1 COL 41
      391        B-Help AT ROW 1 COL 61
      392        tt-country.alpha1 AT ROW 3 COL 18 COLON-ALIGNED
      393             LABEL "Код страны - 1"
      394             VIEW-AS FILL-IN
      395             SIZE 3.5 BY 1
      396        tt-country.num-code AT ROW 3 COL 39 COLON-ALIGNED
      397             LABEL "Цифровой код"
      398             VIEW-AS FILL-IN
      399             SIZE 4 BY 1
      400        tt-country.alpha2 AT ROW 4.5 COL 18 COLON-ALIGNED
      401             LABEL "Код страны - 2"
      402             VIEW-AS FILL-IN
      403             SIZE 5 BY 1
      404        tt-country.short-name AT ROW 6 COL 18 COLON-ALIGNED
      405             LABEL "Короткое назв."
      406             VIEW-AS FILL-IN
      407             SIZE 25 BY 1
      408        tt-country.long-name AT ROW 8 COL 18 COLON-ALIGNED
      409             LABEL "Название страны"
      410             VIEW-AS FILL-IN
      411             SIZE 54 BY 1
      412        SPACE(2.37) SKIP(1.45)
      413       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      414            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      415            TITLE "Страна"
      416            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      417   ASSIGN
      418          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      419          FRAME Dialog-Frame:HIDDEN           = TRUE.
      420   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      421   DO:
      422     APPLY "END-ERROR":U TO SELF.
      423   END.
      424   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      425   DO:
      426     run proc-save in this-procedure no-error.
      427     if error-status:error then return no-apply.
      428   END.
      429   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
      430   DO:
      431      DEFINE VARIABLE v-rid-list AS CHARACTER NO-undo.
      432         run ref/ccountrs.w (
      433                        INPUT parparentproc
      434                       ,INPUT '':U
      435                       ,INPUT 'one':U
      436                       ,INPUT tt-country.num-code
      437                       ,INPUT-OUTPUT v-rid-list) NO-ERROR.
      438   END.
      439   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      440   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      441   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      442   on help of frame Dialog-Frame
      443   do:
      444     run gbl/app_help.p
      445       (input this-procedure :file-name
      446       ,input ''
      447       ,input ?
      448       ) no-error.
      449     if error-status :error then do:
      450       message
      451         "Ошибка при вызове помощи"
      452         error-status :get-message(1)
      453         view-as alert-box .
      454     end.
      455   end.
      456   run minbtn-set in this-procedure .
      457   on choose of b-help in frame Dialog-Frame
      458   do:
      459     apply "help":u to frame Dialog-Frame .
      460   end.
      461   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      462   procedure minbtn-set :
      463       do
      464           on error undo, return error return-value
      465           :
      466           define variable ii              as integer       no-undo .
      467           define variable fh              as widget-handle no-undo .
      468           define variable hh              as widget-handle no-undo .
      469           define variable v-h             as handle        extent 4 no-undo .
      470           define variable v-name-button   as character     no-undo .
      471           define variable v-help-old-x    as decimal       no-undo .
      472           define variable v-help-old-y    as decimal       no-undo .
      473           define variable v-help-old-size as decimal       no-undo .
      474           define variable v-frame-width   as decimal       no-undo .
      475           define variable jj              as integer       no-undo .
      476           do
      477               on error undo, return error
      478               :
      479               assign
      480                   v-frame-width = frame Dialog-Frame:width - 0.3
      481                   fh            = frame Dialog-Frame:first-child
      482                   hh            = fh:first-child
      483                   ii            = 1
      484                   .
      485               do while valid-handle(hh):
      486                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      487                   do:
      488                       case lc(hh:name) :
      489                           when "b-help" then
      490                               do:
      491                                   hh:load-image-up("cmp/b-help.bmp":u) .
      492                                   hh:load-image-down("cmp/b-help.bmp":u) .
      493                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      494                                   hh:TOOLTIP = "Помощь" .
      495                                   v-help-old-x = hh:column .
      496                                   v-help-old-y = hh:row    .
      497                                   v-help-old-size = hh:width .
      498                                   hh:width-chars = 2.5 .
      499                               end.
      500                           when "b-print" then
      501                               do:
      502                                   hh:load-image("cmp/b-print.bmp":u) .
      503                                   hh:TOOLTIP = "Печать" .
      504                                   v-h[ii] = hh:handle .
      505                                   ii = ii + 1 .
      506                                   hh:width-chars = 3 .
      507                               end.
      508                           when "b-history" or
      509                           when "b-hist" then
      510                               do:
      511                                   hh:load-image("cmp/b-hist.bmp":u) .
      512                                   hh:TOOLTIP = "История" .
      513                                   v-h[ii] = hh:handle .
      514                                   ii = ii + 1 .
      515                                   hh:width-chars = 3 .
      516                               end.
      517                           when "b-sch" then
      518                               do:
      519                                   hh:load-image("cmp/b-sch.bmp":u) .
      520                                   hh:TOOLTIP = "Установка Фильтра" .
      521                                   v-h[ii] = hh:handle .
      522                                   ii = ii + 1 .
      523                                   hh:width-chars = 3 .
      524                               end.
      525                           when "b-hist-user" then
      526                               do:
      527                                   hh:load-image("cmp/b-hist.bmp":u) .
      528                                   hh:TOOLTIP = "История пользователя" .
      529                                   ii = ii + 1 .
      530                               end.
      531                       end case.
      532                   end.
      533                   hh = hh:next-sibling.
      534               end.
      535               b-help:column = v-frame-width - b-help:width-chars.
      536               jj = 0.
      537               repeat ii = 4 to 1 by -1 :
      538                   if valid-handle (v-h[ii] ) then
      539                   do:
      540                       jj  = jj + 1 .
      541                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      542                       v-h[ii]:row    = v-help-old-y .
      543                   end.
      544               end.
      545           end.
      546       end.
      547   end procedure.
      548   MAIN-BLOCK:
      549   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      550      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      551    if p-mode  <> 'ДОБАВЛЕНИЕ':U
      552    and p-mode <> 'ИЗМЕНЕНИЕ':U
      553    and p-mode <> 'ПРОСМОТР':U
      554    then do:
      555       message
      556       vss-workfile vss-revision vss-description skip
      557       "Неверное значение параметров вызова p-mode"  p-mode
      558       view-as alert-box ERROR.
      559       undo, return error.
      560    end.
      561   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      562   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      563     (output v-db-num
      564     )  .
      565   IF v-db-num <> 0
      566   AND (p-mode = 'ДОБАВЛЕНИЕ':U
      567        OR p-mode = 'ИЗМЕНЕНИЕ':U ) THEN DO:
      568         message
      569       vss-workfile vss-revision vss-description skip
      570       "Неверное значение параметра вызова p-mode" p-mode skip
      571       "Нельзя редактировать запись СТРАНЫ в УБД"
      572       view-as alert-box ERROR.
      573       return error .
      574   END.
      575     for each tt-country:
      576       delete tt-country.
      577     end.
      578     if p-mode = 'ИЗМЕНЕНИЕ':U
      579     or p-mode = 'ПРОСМОТР':U then do:
      580       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      581         find first locked_country EXclusive-lock where
      582                      recid(locked_country) = p-doc-rec no-wait no-error.
      583         if locked locked_country then do:
      584           message
      585           vss-workfile vss-revision vss-description skip
      586            "Запись СТРАНЫ занята"
      587           view-as alert-box error .
      588           undo, return error.
      589         end.
      590       end.
      591       else do:
      592         find first locked_country no-lock where
      593                          recid(locked_country) = p-doc-rec no-error .
      594         if not avail locked_country then do:
      595           find first locked_country no-lock where
      596                      locked_country.alpha1 = p-alpha1 no-error .
      597         end.
      598       end.
      599       if not available locked_country then do:
      600         message
      601         vss-workfile vss-revision vss-description skip
      602         "Не найдена запись СТРАНЫ"
      603         view-as alert-box error .
      604         undo, return error.
      605       end.
      606       create tt-country.
      607       buffer-copy locked_country to tt-country.
      608      end.
      609      else do:
      610             create tt-country.
      611            .
      612      end.
      613     RUN MYenable.
      614     WAIT-FOR GO OF FRAME Dialog-Frame.
      615   END.
      616   RUN disable_UI.
      617   PROCEDURE disable_UI :
      618     HIDE FRAME Dialog-Frame.
      619   END PROCEDURE.
      620   PROCEDURE enable_UI :
      621     OPEN QUERY Dialog-Frame FOR EACH tt-country SHARE-LOCK.
      622     GET FIRST Dialog-Frame.
      623     IF AVAILABLE tt-country THEN
      624       DISPLAY tt-country.alpha1 tt-country.num-code tt-country.alpha2
      625             tt-country.short-name tt-country.long-name
      626         WITH FRAME Dialog-Frame.
      627     ENABLE B-exit b-quit B-hist B-Help tt-country.alpha1 tt-country.num-code
      628            tt-country.alpha2 tt-country.short-name tt-country.long-name
      629         WITH FRAME Dialog-Frame.
      630     VIEW FRAME Dialog-Frame.
      631   END PROCEDURE.
      632   PROCEDURE MyEnable :
      633   IF AVAILABLE tt-country THEN
      634   DISPLAY tt-country.alpha1
      635   WITH FRAME Dialog-Frame.
      636   IF AVAILABLE locked_country THEN
      637   DISPLAY
      638   tt-country.alpha1
      639   tt-country.num-code
      640   tt-country.alpha2
      641   tt-country.short-name
      642   tt-country.long-name
      643   WITH FRAME Dialog-Frame.
      644   ENABLE
      645   B-exit WHEN p-mode <> 'ПРОСМОТР':U
      646   b-quit
      647   B-Help
      648   b-hist WHEN p-mode <> 'ДОБАВЛЕНИЕ':U
      649   tt-country.alpha1    WHEN p-mode = 'ДОБАВЛЕНИЕ':U
      650   tt-country.alpha2    WHEN p-mode <> 'ПРОСМОТР':U
      651   tt-country.num-code  WHEN p-mode = 'ДОБАВЛЕНИЕ':U
      652   tt-country.short-name  WHEN p-mode <> 'ПРОСМОТР':U
      653   tt-country.long-name  WHEN p-mode <> 'ПРОСМОТР':U
      654   WITH FRAME Dialog-Frame.
      655   VIEW FRAME Dialog-Frame.
      656   CASE p-mode:
      657     WHEN 'ПРОСМОТР':U THEN DO:
      658       HIDE b-exit IN FRAME Dialog-Frame.
      659       ASSIGN
      660       b-quit:LABEL = "&Выход".
      661     END.
      662     WHEN 'ДОБАВЛЕНИЕ':U THEN DO:
      663       FRAME Dialog-Frame:TITLE = "Ввод СТРАНЫ" .
      664     END.
      665   WHEN 'ИЗМЕНЕНИЕ':U THEN DO:
      666       FRAME Dialog-Frame:TITLE = "Редактирование СТРАНЫ".
      667     END.
      668   END CASE.
      669   END PROCEDURE.
      670   PROCEDURE proc-save :
      671   if p-mode = 'ПРОСМОТР':U then do:
      672       return error.
      673   end.
      674   if not available tt-country then do:
      675       create tt-country.
      676   end.
      677   assign
      678   frame Dialog-Frame
      679   tt-country.alpha1
      680   tt-country.alpha2
      681   tt-country.num-code
      682   tt-country.short-name
      683   tt-country.long-name
      684   .
      685    run ref/country1.p (
      686   input-output p-doc-rec
      687   ,input p-mode
      688   ,input tt-country.alpha1
      689   ,input tt-country.alpha2
      690   ,input tt-country.num-code
      691   ,input tt-country.short-name
      692   ,input tt-country.long-name
      693   )
      694   no-error.
      695   if error-status:error then do:
      696   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      697   define variable fh as widget-handle no-undo .
      698   define variable hh as widget-handle no-undo .
      699   define variable rv as character no-undo .
      700   assign
      701   rv = entry(1, return-value , chr(4)).
      702   if rv <> "":U then do:
      703     assign
      704     fh = frame Dialog-Frame:first-child
      705     hh = fh:first-child
      706     .
      707     do while valid-handle(hh):
      708       if hh:name = rv then do:
      709         APPLY "ENTRY" to hh.
      710         undo ,
      711         return error.
      712       end.
      713       hh = hh:next-sibling.
      714     end.
      715   end.
      716     undo, return error.
      717   end.
      718   END PROCEDURE.
