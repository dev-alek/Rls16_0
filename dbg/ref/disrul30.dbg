        1   block-level on error undo, throw.
        2   define parameter buffer bufp_dis-rule for ub.dis-rule.
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: disrul30.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: ref/disrul30.p $":U .
        8   define variable vss-description as character no-undo init "Запуск удаления правил скидок".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure progs-name :
       80     define input  parameter p-action-code         as character no-undo .
       81     define output parameter p-main-prog-name      as character no-undo .
       82     define output parameter p-list-db-proc-name   as character no-undo .
       83     define output parameter p-commit-proc-name    as character no-undo .
       84     define output parameter p-execution-proc-name as character no-undo .
       85     define output parameter p-recover-proc-name   as character no-undo .
       86     define output parameter p-after-proc-name     as character no-undo .
       87     do
       88     on error undo, return error
       89     :
       90       case p-action-code :
       91               when 'crush_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-crush-cdrg':U       p-execution-proc-name = 'exec-crush-cdrg':U       p-recover-proc-name   = 'rcvr-crush-cdrg':U       p-after-proc-name     = '':U     .   end.
       92               when 'delete_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-del-cdrg':U       p-execution-proc-name = 'exec-del-cdrg':U       p-recover-proc-name   = 'rcvr-del-cdrg':U       p-after-proc-name     = '':U     .   end.
       93               when 'delete_nu-prt-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-prt-bar-code':U       p-execution-proc-name = 'delete-prt-bar-code':U       p-recover-proc-name   = 'undo-delete-prt-bar-code':U       p-after-proc-name     = '':U     .   end.
       94               when 'delete_nu-part-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-part-bar-code':U       p-execution-proc-name = 'delete-part-bar-code':U       p-recover-proc-name   = 'undo-delete-part-bar-code':U       p-after-proc-name     = '':U     .   end.
       95               when 'delete_nu-ucli-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-ucli-bar-code':U       p-execution-proc-name = 'delete-ucli-bar-code':U       p-recover-proc-name   = 'undo-delete-ucli-bar-code':U       p-after-proc-name     = '':U     .   end.
       96               when 'delete_nu-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-del-dis-card':U       p-execution-proc-name = 'delete-dis-card':U       p-recover-proc-name   = 'undo-delete-dis-card':U       p-after-proc-name     = '':U     .   end.
       97               when 'chown-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-chown-dis-card':U       p-execution-proc-name = 'chown-dis-card':U       p-recover-proc-name   = 'undo-chown-dis-card':U       p-after-proc-name     = 'after-chown-dis-card':U     .   end.
       98               when 'delete_nu-dis-rule':U then do:     assign       p-main-prog-name      = 'trg/dis-rult.p':U       p-list-db-proc-name   = 'trg/disruldb.p':U       p-commit-proc-name    = 'block-del-dis-rule':U       p-execution-proc-name = 'delete-dis-rule':U       p-recover-proc-name   = 'undo-delete-dis-rule':U       p-after-proc-name     = '':U     .   end.
       99               when 'ren-art':U then do:     assign       p-main-prog-name      = 'trg/goodst.p':U       p-list-db-proc-name   = 'utl/renartcd.p':U       p-commit-proc-name    = 'comm-ren-art':U       p-execution-proc-name = 'exec-ren-art':U       p-recover-proc-name   = 'rcvr-ren-art':U       p-after-proc-name     = 'after-ren-art':U     .   end.
      100               when 'delete_nu-clob-data':U then do:     assign       p-main-prog-name      = 'trg/clobdatt.p':U       p-list-db-proc-name   = 'trg/clbdatdb.p':U       p-commit-proc-name    = 'block-del-clob-data':U       p-execution-proc-name = 'delete-clob-data':U       p-recover-proc-name   = 'undo-delete-clob-data':U       p-after-proc-name     = '':U     .   end.
      101               when 'delete_nu-layout':U then do:     assign       p-main-prog-name      = 'trg/layoutt.p':U       p-list-db-proc-name   = 'trg/layoutdb.p':U       p-commit-proc-name    = 'block-del-layout':U       p-execution-proc-name = 'delete-layout':U       p-recover-proc-name   = 'undo-delete-layout':U       p-after-proc-name     = '':U     .   end.
      102               otherwise do:
      103           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info0, p-action-code ).
      104         end.
      105       end case.
      106     end.
      107     return.
      108   end procedure.
      109   procedure progs-title :
      110     define input  parameter p-action-code         as character no-undo .
      111     define output parameter p-action-title      as character no-undo .
      112     do
      113     on error undo, return error
      114     :
      115       case p-action-code :
      116               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      117               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      118               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      119               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      120               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      121               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      122               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      123               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      124               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      125               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      126               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      127               otherwise do:
      128           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info0, p-action-code ).
      129         end.
      130       end case.
      131     end.
      132     return.
      133   end procedure.
      134   FUNCTION progs-title-function returns character(
      135      input  p-action-code         as character):
      136   define variable p-action-title      as character no-undo .
      137     do
      138     on error undo, return error
      139     :
      140       case p-action-code :
      141               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      142               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      143               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      144               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      145               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      146               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      147               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      148               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      149               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      150               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      151               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      152               otherwise do:
      153           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info0, p-action-code ).
      154         end.
      155       end case.
      156     end.
      157     return p-action-title.
      158   end FUNCTION.
      159   procedure get-row-keyr-string :
      160    define input  parameter p-key-rec  as character no-undo.
      161    define output parameter p-tbl-title as character no-undo.
      162    define output parameter p-rec-string  as character no-undo.
      163     do
      164     on error undo, return error
      165     :
      166       define variable v-full-tbl-name as character no-undo .
      167       define variable bh_tbl-name     as handle    no-undo .
      168       define variable fh              as handle    no-undo .
      169       define variable v-ok            as logical   no-undo .
      170       define variable v-field-num     as integer   no-undo .
      171       define variable v-count-fld     as integer   no-undo .
      172       define variable v-tbl-name as character no-undo.
      173       if p-key-rec = ?
      174         or p-key-rec = "":U
      175       then do:
      176         return error substitute( "&1 (get-row-keyr-string). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      177       end.
      178       assign
      179         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      180         v-full-tbl-name = "ub.":U + v-tbl-name
      181         v-field-num     = num-entries( p-key-rec, chr(3) ) - 1
      182         p-rec-string         = "":U
      183         v-count-fld     = 0
      184       .
      185       find ub._file
      186         where ub._file._file-name = v-tbl-name
      187         no-error.
      188       if not available ub._file then do:
      189         return error substitute( "&1. Таблица &2 отсутствует в БД", vss-include-info0, v-tbl-name ).
      190       end.
      191       assign
      192       p-tbl-title = ub._file._file-label
      193       .
      194       find ub._index
      195         where recid( ub._index  ) = ub._file._prime-index
      196         no-error.
      197       if not available ub._index
      198         or LC( ub._index._index-name ) = "default":U
      199       then do:
      200         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      201       end.
      202       block_where :
      203       for each ub._index-field of ub._index  ,
      204           each ub._field of _index-field
      205           break by _index-seq
      206       on error undo, return error
      207       :
      208         assign
      209           v-count-fld = v-count-fld + 1
      210         .
      211         if v-count-fld > v-field-num then do:
      212           leave block_where.
      213         end.
      214         if p-rec-string = "":U then do:
      215           assign
      216             p-rec-string = "":U
      217           .
      218         end.
      219         else do:
      220           assign
      221             p-rec-string = p-rec-string + chr(32) + chr(44)
      222           .
      223         end.
      224         assign
      225           p-rec-string = p-rec-string + (if p-rec-string = "":u then "":U else chr(32)) + substitute( "&1 = &2":U, ub._field._label, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
      226         .
      227       end.
      228       if v-count-fld <> v-field-num then do:
      229         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      230       end.
      231     end.
      232     return.
      233   end procedure.
      234   FUNCTION uniq-key-rec-string-f returns character(
      235      input  p-uniq-key-rec         as character):
      236   define variable v-tbl-title as character no-undo .
      237   define variable v-rec-string as character no-undo .
      238     do
      239     on error undo, return error
      240     :
      241       run get-row-keyr-string in this-procedure (
      242                                                 input p-uniq-key-rec
      243                                                 ,output v-tbl-title
      244                                                 ,output v-rec-string).
      245       assign
      246       v-rec-string = (if v-tbl-title <> ? and
      247                       v-tbl-title <> "":U
      248                       then (v-tbl-title + ":")
      249                      else "":U) + chr(32) + v-rec-string
      250       .
      251     end.
      252     return v-rec-string.
      253   end FUNCTION.
      254   procedure create_db-rec_route :
      255     define input parameter p1-uniq-key-rec as character no-undo .
      256     define input parameter p1-action       as character no-undo .
      257     define input parameter p1-operation    as character no-undo .
      258     define input parameter p1-send-db-list as character no-undo .
      259     define input parameter p1-db-init      as integer   no-undo .
      260     define input parameter p1-parameters   as character no-undo .
      261     define input parameter p1-answer-code  as integer   no-undo .
      262     define input parameter p1-answer-msg   as character no-undo .
      263     do
      264     on error undo, return error
      265     :
      266       define variable v-command     as character no-undo .
      267       define variable v-ind         as integer   no-undo .
      268       define variable v-num-entries as integer   no-undo .
      269       define variable v-curr-db     as integer   no-undo .
      270       define variable v-db-for-send as character no-undo .
      271       define variable v-db-num      as integer   no-undo .
      272       define variable v-db-num-char as character no-undo .
      273       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      274       find first buf_sys-ctrl no-lock .
      275       assign
      276         v-curr-db     = buf_sys-ctrl.db-num
      277         v-db-for-send = "":U
      278       .
      279       if v-curr-db = 0 then do:
      280         if p1-answer-code >= 0 then do:
      281           if v-curr-db <> p1-db-init then do:
      282             assign
      283               v-db-for-send = string( p1-db-init )
      284             .
      285           end.
      286         end.
      287         else do:
      288           assign
      289             v-num-entries = num-entries( p1-send-db-list, chr(44) )
      290           .
      291           do v-ind = 1 to v-num-entries:
      292             assign
      293               v-db-num-char = entry( v-ind, p1-send-db-list, chr(44) )
      294               v-db-num      = integer( v-db-num-char )
      295             .
      296             if v-db-num <> v-curr-db
      297               and v-db-num <> p1-db-init
      298             then do:
      299               if v-db-for-send = "":U then do:
      300                 assign
      301                   v-db-for-send = v-db-num-char
      302                 .
      303               end.
      304               else do:
      305                 assign
      306                   v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      307                 .
      308               end.
      309             end.
      310           end.
      311         end.
      312       end.
      313       else do:
      314         assign
      315           v-db-for-send = "0":U
      316         .
      317       end.
      318       if v-db-for-send <> "":U then do:
      319         assign
      320           v-command = "command":U + chr(1)
      321                       + "two-commit":U + chr(1)
      322                       + p1-action + chr(1)
      323                       + p1-operation + chr(1)
      324                       + p1-uniq-key-rec + chr(1)
      325                       + string( p1-db-init ) + chr(1)
      326                       + p1-parameters + chr(1)
      327                       + string( p1-answer-code ) + chr(1)
      328                       + p1-answer-msg
      329         .
      330         run nws/cr-route.p ( input 'send-cmd':U
      331                       ,input v-command
      332                       ,input ?
      333                       ,input v-db-for-send
      334                       ) no-error .
      335         if error-status :error then do:
      336           return error return-value.
      337         end.
      338       end.
      339     end.
      340     return.
      341   end procedure.
      342   procedure create_msg_route :
      343     define input parameter p2-send-db-list as character no-undo .
      344     define input parameter p2-msg          as character no-undo .
      345     do
      346     on error undo, return error
      347     :
      348       define variable v-msg-command as character no-undo .
      349       define variable v-ind         as integer   no-undo .
      350       define variable v-num-entries as integer   no-undo .
      351       define variable v-curr-db     as integer   no-undo .
      352       define variable v-db-for-send as character no-undo .
      353       define variable v-db-num      as integer   no-undo .
      354       define variable v-db-num-char as character no-undo .
      355       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      356       find first buf_sys-ctrl no-lock .
      357       assign
      358         v-curr-db     = buf_sys-ctrl.db-num
      359         v-db-for-send = "":U
      360       .
      361       if v-curr-db = 0 then do:
      362         assign
      363           v-num-entries = num-entries( p2-send-db-list, chr(44) )
      364         .
      365         do v-ind = 1 to v-num-entries:
      366           assign
      367             v-db-num-char = entry( v-ind, p2-send-db-list, chr(44) )
      368             v-db-num      = integer( v-db-num-char )
      369           .
      370           if v-db-num <> v-curr-db then do:
      371             if v-db-for-send = "":U then do:
      372               assign
      373                 v-db-for-send = v-db-num-char
      374               .
      375             end.
      376             else do:
      377               assign
      378                 v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      379               .
      380             end.
      381           end.
      382         end.
      383       end.
      384       else do:
      385         assign
      386           v-db-for-send = "0":U
      387         .
      388       end.
      389       if v-db-for-send <> "":U then do:
      390         assign
      391           v-msg-command = "command":U + chr(1)
      392                           + "message-to-log":U + chr(1)
      393                           + p2-msg
      394         .
      395         run nws/cr-route.p ( input 'send-cmd':U
      396                       ,input v-msg-command
      397                       ,input ?
      398                       ,input v-db-for-send
      399                       ) no-error .
      400         if error-status :error then do:
      401           return error substitute( "&1&2&3"
      402                                     , return-value
      403                                     , chr(10)
      404                                     , error-status :get-message(1)
      405                                   ).
      406         end.
      407       end.
      408     end.
      409     return.
      410   end procedure.
      411   function get-send-db-list returns character
      412     ( input p-curr-db     as integer
      413      ,input p-all-db-list as character
      414     )
      415   :
      416     define variable v-send-db-list as character no-undo .
      417     if p-curr-db = 0 then do:
      418       assign
      419         v-send-db-list = p-all-db-list
      420       .
      421     end.
      422     else do:
      423       assign
      424         v-send-db-list = string(p-curr-db)
      425       .
      426     end.
      427     return v-send-db-list .
      428   end function .
      429   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      430   procedure gen-key-rec :
      431     define input  parameter p-tbl-name    as character no-undo.
      432     define input  parameter p-bh_tbl-name as handle    no-undo.
      433     define output parameter p-key-rec     as character no-undo.
      434     do
      435     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      436     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      437     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      438     :
      439       define variable fh               as handle    no-undo .
      440       define variable v-ok             as logical   no-undo .
      441       define variable v-inform         as character no-undo .
      442       define variable v-ind            as integer   no-undo .
      443       define variable v-idx-field-qnty as integer   no-undo .
      444       if p-tbl-name = ?
      445         or p-tbl-name = "":U
      446       then do:
      447         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      448       end.
      449       if not p-bh_tbl-name:available then do:
      450         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      451       end.
      452       assign
      453         p-key-rec = p-tbl-name
      454         v-inform  = p-bh_tbl-name:index-information(1)
      455         v-ind     = 2
      456       .
      457       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      458       on error undo, return error
      459       :
      460         assign
      461           v-inform = p-bh_tbl-name:index-information( v-ind )
      462           v-ind    = v-ind + 1
      463         .
      464       end.
      465       if v-inform = ?
      466         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      467         or entry( 3, v-inform, ",":U ) <> "1":U
      468       then do:
      469         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      470       end.
      471       else do:
      472         assign
      473           v-idx-field-qnty = num-entries( v-inform ) - 4
      474         .
      475         if v-idx-field-qnty < 2 then do:
      476           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      477         end.
      478         do v-ind = 1 to v-idx-field-qnty by 2
      479         on error undo, return error
      480         :
      481           assign
      482             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      483             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      484           .
      485         end.
      486       end.
      487       if p-key-rec = ? then do:
      488         assign
      489           p-key-rec = "":U
      490         .
      491         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      492       end.
      493     end.
      494     return.
      495   end procedure.
      496   procedure gen-where-keyr-tab :
      497     define input  parameter i-tableSerach as character no-undo.
      498     define input  parameter i-tablekey   as character  no-undo.
      499     define input  parameter p-key-rec    as character  no-undo.
      500     define input  parameter p-key-handle as handle     no-undo .
      501     define input  parameter p-db-name    as character  no-undo .
      502     define input  parameter p-tt-handle  as handle     no-undo .
      503     define output parameter o-Where      as character  no-undo.
      504     do
      505     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      506     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      507     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      508     :
      509       define variable v-full-tbl-name  as character no-undo .
      510       define variable bh_tbl-name      as handle    no-undo .
      511       define variable fh_key           as handle    no-undo .
      512       define variable fh_search        as handle    no-undo .
      513       define variable v-field-num      as integer   no-undo .
      514       define variable v-count-fld      as integer   no-undo .
      515       define variable v-inform         as character no-undo .
      516       define variable v-ind            as integer   no-undo .
      517       define variable v-idx-field-qnty as integer   no-undo .
      518       define variable v-field-name     as character no-undo .
      519       define variable v-field-val      as character no-undo .
      520       define variable v-word-link      as character no-undo .
      521       define variable vTable           as character no-undo.
      522       define variable bh_tbl-key       as handle    no-undo .
      523       assign
      524         p-key-rec = trim( p-key-rec )
      525       .
      526       if p-key-handle <> ? then do:
      527         if not valid-handle(p-key-handle)
      528            or p-key-handle:type <> "buffer"
      529         then do:
      530           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      531         end.
      532         if num-entries( p-key-rec, chr(3) ) > 1
      533           or p-key-rec = ?
      534           or p-key-rec = "":U
      535         then do:
      536           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      537         end.
      538       end.
      539       else do:
      540         if p-key-rec = ?
      541           or p-key-rec = "":U
      542         then do:
      543           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      544         end.
      545       end.
      546       assign
      547         vTable = entry( 1 , p-key-rec, chr(3) )
      548       .
      549       if p-tt-handle <> ?
      550         and ( not valid-handle(p-tt-handle)
      551               or p-tt-handle:type <> "buffer"
      552             )
      553       then do:
      554         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      555       end.
      556       if p-tt-handle = ? then do:
      557         assign
      558           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      559         .
      560         create buffer bh_tbl-name for table v-full-tbl-name .
      561       end.
      562       else do:
      563         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      564       end.
      565       assign
      566         v-inform = bh_tbl-name:index-information(1)
      567         v-ind    = 2
      568       .
      569       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      570       on error undo, return error
      571       :
      572         assign
      573           v-inform = bh_tbl-name:index-information( v-ind )
      574           v-ind    = v-ind + 1
      575         .
      576       end.
      577       if v-inform = ?
      578         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      579         or entry( 3, v-inform, ",":U ) <> "1":U
      580       then do:
      581         delete object bh_tbl-name no-error.
      582         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      583       end.
      584       assign
      585         v-idx-field-qnty = num-entries( v-inform ) - 4
      586       .
      587       if v-idx-field-qnty < 2 then do:
      588         delete object bh_tbl-name no-error.
      589         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      590       end.
      591       assign
      592         o-where     = "where":U
      593         v-word-link = "":U
      594         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      595         v-count-fld = 0
      596       .
      597       if i-tablekey ne "" and i-tablekey ne ?
      598       then do:
      599         assign
      600           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      601         .
      602         create buffer bh_tbl-key for table v-full-tbl-name .
      603       end.
      604       if i-tableSerach ne "" and i-tableSerach ne ?
      605       then do:
      606         delete object bh_tbl-name no-error.
      607         assign
      608           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      609         .
      610         create buffer bh_tbl-name for table v-full-tbl-name .
      611       end.
      612       block_where:
      613       do v-ind = 1 to v-idx-field-qnty by 2
      614       on error undo, return error
      615       :
      616         assign
      617           v-count-fld = v-count-fld + 1
      618         .
      619         if p-key-handle = ?
      620           and v-count-fld > v-field-num
      621         then do:
      622           leave block_where.
      623         end.
      624         define variable VfieldKeyTable as handle no-undo.
      625         assign
      626           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      627           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      628         .
      629         if     bh_tbl-key ne ?
      630         then do:
      631            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      632            if VfieldKeyTable eq ?
      633            then next block_where.
      634         end.
      635         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      636         then
      637            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      638         else
      639            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      640         if p-key-handle = ? then do:
      641           assign
      642             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      643           .
      644         end.
      645         else do:
      646           assign
      647             fh_key = p-key-handle:buffer-field( v-field-name )
      648           .
      649           if fh_key = ?
      650             or not valid-handle( fh_key )
      651           then do:
      652             delete object bh_tbl-name.
      653             if     bh_tbl-key ne ?
      654             then
      655                delete object bh_tbl-key.
      656             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      657           end.
      658           assign
      659             v-field-val = fh_key:buffer-value
      660           .
      661         end.
      662         if fh_search:data-type ="character":U then do:
      663           assign
      664             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      665             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      666             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      667             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      668             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      669             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      670             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      671             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      672             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      673             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      674             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      675             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      676             v-field-val = substitute( '"&1"', v-field-val )
      677           .
      678         end.
      679         assign
      680           o-where = substitute( "&1 &2", o-where, v-field-val )
      681         .
      682         if v-word-link = "":U then do:
      683           assign
      684             v-word-link = "and":U
      685           .
      686         end.
      687       end.
      688       delete object bh_tbl-name.
      689       if     bh_tbl-key ne ?
      690       then
      691          delete object bh_tbl-key.
      692       if p-key-handle = ?
      693         and v-count-fld <> v-field-num
      694       then do:
      695         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      696       end.
      697     end.
      698   end procedure.
      699   procedure gen-hn-keyr-tab :
      700     define input  parameter i-tableSerach as character no-undo.
      701     define input  parameter i-tablekey   as character no-undo.
      702     define input  parameter p-key-rec    as character no-undo.
      703     define input  parameter p-key-handle as handle    no-undo .
      704     define input  parameter p-db-name    as character no-undo .
      705     define input  parameter p-tt-handle  as handle    no-undo .
      706     define input  parameter p-stts-lock  as integer   no-undo .
      707     define output parameter o-hn         as handle    no-undo.
      708     define variable v-full-tbl-name as character no-undo.
      709     define variable v-where         as character no-undo.
      710     define variable bh_tbl-name     as handle    no-undo.
      711     define variable vTable          as character no-undo.
      712     do
      713     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      714     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      715     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      716         run gen-where-keyr-tab(i-tableSerach,
      717                                i-tablekey,
      718                                p-key-rec,
      719                                p-key-handle,
      720                                p-db-name,
      721                                p-tt-handle,
      722                                output v-where).
      723         if i-tableSerach ne "" and i-tableSerach ne ?
      724         then do:
      725            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      726            create buffer bh_tbl-name for table v-full-tbl-name .
      727         end.
      728         else do:
      729            if p-tt-handle = ? then do:
      730               assign
      731                  vTable = entry( 1 , p-key-rec, chr(3) )
      732               .
      733               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      734               create buffer bh_tbl-name for table v-full-tbl-name .
      735            end.
      736            else do:
      737               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      738            end.
      739         end.
      740         if p-tt-handle = ? then do:
      741            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      742         end.
      743         else do:
      744            bh_tbl-name:find-first( v-where ) no-error .
      745         end.
      746         o-hn = bh_tbl-name.
      747      end.
      748   end procedure.
      749   procedure gen-hn-keyr :
      750     define input  parameter p-key-rec    as character no-undo.
      751     define input  parameter p-key-handle as handle    no-undo .
      752     define input  parameter p-db-name    as character no-undo .
      753     define input  parameter p-tt-handle  as handle    no-undo .
      754     define input  parameter p-stts-lock  as integer   no-undo .
      755     define output parameter o-hn         as handle    no-undo.
      756     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      757   end.
      758   procedure gen-row-keyr :
      759     define input  parameter p-key-rec    as character no-undo.
      760     define input  parameter p-key-handle as handle    no-undo .
      761     define input  parameter p-db-name    as character no-undo .
      762     define input  parameter p-tt-handle  as handle    no-undo .
      763     define input  parameter p-stts-lock  as integer   no-undo .
      764     define output parameter p-tbl-row    as rowid     no-undo.
      765     define output parameter p-tbl-name   as character no-undo.
      766     define variable vHn as handle no-undo.
      767       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      768       p-tbl-row = if vHn:available then vHn:rowid else ?.
      769       p-tbl-name =  vHn:table.
      770       delete object vHn no-error.
      771     if p-tbl-row = ? then do:
      772       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      773     end.
      774     else do:
      775       return.
      776     end.
      777   end procedure.
      778   procedure gen-key-fv :
      779     define input  parameter p-key-rec    as character no-undo .
      780     define output parameter p-field-list as character no-undo .
      781     define output parameter p-value-list as character no-undo.
      782     do
      783     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      784     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      785     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      786     :
      787       define variable v-full-tbl-name  as character no-undo .
      788       define variable bh_tbl-name      as handle    no-undo .
      789       define variable v-tbl-name       as character no-undo .
      790       define variable v-field-num      as integer   no-undo .
      791       define variable v-count-fld      as integer   no-undo .
      792       define variable v-inform         as character no-undo .
      793       define variable v-ind            as integer   no-undo .
      794       define variable v-idx-field-qnty as integer   no-undo .
      795       define variable v-delim-key      as character no-undo .
      796       if p-key-rec = ?
      797         or p-key-rec = "":U
      798       then do:
      799         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      800       end.
      801       assign
      802         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      803         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      804       .
      805       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      806       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      807       assign
      808         v-inform = bh_tbl-name:index-information(1)
      809         v-ind    = 2
      810       .
      811       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      812       on error undo, return error
      813       :
      814         assign
      815           v-inform = bh_tbl-name:index-information( v-ind )
      816           v-ind    = v-ind + 1
      817         .
      818       end.
      819       if v-inform = ?
      820         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      821         or entry( 3, v-inform, ",":U ) <> "1":U
      822       then do:
      823         delete object bh_tbl-name no-error.
      824         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      825       end.
      826       assign
      827         v-idx-field-qnty = num-entries( v-inform ) - 4
      828       .
      829       if v-idx-field-qnty < 2 then do:
      830         delete object bh_tbl-name no-error.
      831         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      832       end.
      833       assign
      834         p-field-list = "":U
      835         p-value-list = "":U
      836         v-delim-key  = "":U
      837         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      838         v-count-fld  = 0
      839       .
      840       block_where:
      841       do v-ind = 1 to v-idx-field-qnty by 2
      842       on error undo, return error
      843       :
      844         assign
      845           v-count-fld = v-count-fld + 1
      846         .
      847         if v-count-fld > v-field-num then do:
      848           leave block_where.
      849         end.
      850         assign
      851           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      852           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      853         .
      854         if v-ind = 1 then do:
      855           assign
      856             v-delim-key = chr(3)
      857           .
      858         end.
      859       end.
      860       delete object bh_tbl-name.
      861       if v-count-fld <> v-field-num then do:
      862         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      863       end.
      864     end.
      865   end procedure.
      866   procedure gen-key-field :
      867     define input  parameter p-table      as character no-undo .
      868     define output parameter p-field-list as character no-undo .
      869     do
      870     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      871     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      872     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      873     :
      874       define variable v-full-tbl-name  as character no-undo .
      875       define variable bh_tbl-name      as handle    no-undo .
      876       define variable v-tbl-name       as character no-undo .
      877       define variable v-field-num      as integer   no-undo .
      878       define variable v-count-fld      as integer   no-undo .
      879       define variable v-inform         as character no-undo .
      880       define variable v-ind            as integer   no-undo .
      881       define variable v-idx-field-qnty as integer   no-undo .
      882       define variable v-delim-key      as character no-undo .
      883       if p-table = ?
      884         or p-table = "":U
      885       then do:
      886         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      887       end.
      888       assign
      889         v-tbl-name      = p-table
      890         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      891       .
      892       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      893       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      894       assign
      895         v-inform = bh_tbl-name:index-information(1)
      896         v-ind    = 2
      897       .
      898       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      899       on error undo, return error
      900       :
      901         assign
      902           v-inform = bh_tbl-name:index-information( v-ind )
      903           v-ind    = v-ind + 1
      904         .
      905       end.
      906       if v-inform = ?
      907         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      908         or entry( 3, v-inform, ",":U ) <> "1":U
      909       then do:
      910         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      911       end.
      912       assign
      913         v-idx-field-qnty = num-entries( v-inform ) - 4
      914       .
      915       if v-idx-field-qnty < 2 then do:
      916         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      917       end.
      918       assign
      919         p-field-list = "":U
      920         v-delim-key  = "":U
      921         v-count-fld  = 0
      922       .
      923       block_where:
      924       do v-ind = 1 to v-idx-field-qnty by 2
      925       on error undo, return error
      926       :
      927         assign
      928           v-count-fld = v-count-fld + 1
      929         .
      930         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      931         if v-ind = 1 then do:
      932           assign
      933             v-delim-key = chr(3)
      934           .
      935         end.
      936       end.
      937       delete object bh_tbl-name.
      938     end.
      939   end procedure.
      940   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      941   define variable v-waitfram-action01         as character   no-undo .
      942   define variable v-waitfram-action02         as character   no-undo .
      943   define variable v-waitfram-action03         as character   no-undo .
      944   define variable mWaitFramTextBeg            as character   no-undo.
      945   define variable mWaitFramTextEnd            as character   no-undo.
      946   define variable mWaitFramView               as logical     no-undo.
      947   define variable mWaitProcEvent              as logical     no-undo init yes.
      948   define variable mWaitFramInterval           as integer     no-undo init 1 .
      949   define variable mWaitFramStop               as logical     no-undo.
      950   define variable mWaitFramStopUser           as logical     no-undo.
      951   define variable mWaitFramStopTimeOut        as logical     no-undo.
      952   define variable mWaitFramStartProc          as datetime-tz no-undo.
      953   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      954   define button B-WaitFramStop auto-end-key
      955        label "Стоп"
      956        size 10 by 1 tooltip "Остоновить процесс".
      957   define button B-viewProcInfo
      958        label "Информация"
      959        size 15 by 1 tooltip "Информация о процесс".
      960   define frame waitfram
      961     v-waitfram-action01 format "x(72)" no-label skip
      962     v-waitfram-action02 format "x(72)" no-label skip
      963     v-waitfram-action03 format "x(72)" no-label skip
      964     B-viewProcInfo
      965     B-WaitFramStop at row 4 col 30
      966     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      967     .
      968   define new global shared variable mBatchMode as logical no-undo init ?.
      969   define variable mFramBachModHandle as handle no-undo.
      970   mFramBachModHandle = frame waitfram:handle.
      971   define variable mFameOldVis as logical no-undo.
      972   define variable mVisCUrentVin as logical no-undo.
      973   if session:batch-mode
      974   then
      975      mBatchMode = yes.
      976   if mBatchMode = ? then do:
      977     mVisCUrentVin = current-window:visible.
      978     mFameOldVis = mFramBachModHandle:visible.
      979     mFramBachModHandle:visible  = yes.
      980     mBatchMode = mFramBachModHandle:visible ne yes.
      981     mFramBachModHandle:visible = mFameOldVis.
      982     current-window:visible = mVisCUrentVin.
      983   end.
      984    if  log-manager:logfile-name ne ?
      985     then DO:
      986         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      987         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      988         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      989     end.
      990   on choose of B-WaitFramStop in frame waitfram
      991   do:
      992     mWaitFramStop = yes.
      993     mWaitFramStopUser = yes.
      994   end.
      995   function waitfram-check-timeout returns logical():
      996      define variable vtime as int64 no-undo.
      997      if mWaitFramStopTimeOut
      998      then
      999         return yes.
     1000      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1001      if     mWaitFramTimeOut ne ?
     1002         and mWaitFramTimeOut ne 0
     1003         and mWaitFramTimeOut lt vtime
     1004      then do:
     1005         mWaitFramStopTimeOut = yes.
     1006      end.
     1007      return mWaitFramStopTimeOut.
     1008   end.
     1009   procedure waitfram-hide :
     1010     if not session:batch-mode
     1011     then do
     1012     on error undo, return error return-value
     1013     :
     1014       pause 0 before-hide .
     1015       if not mBatchMode then
     1016         hide frame waitfram .
     1017     if     not mWaitFramView
     1018        and mWaitProcEvent
     1019     then
     1020       process events .
     1021     end.
     1022   end procedure.
     1023   procedure waitfram-show :
     1024     define input  parameter p-message as character no-undo .
     1025     define variable v-left-margin as integer   no-undo .
     1026     if not session:batch-mode
     1027     then do
     1028     on error undo, return error return-value
     1029     :
     1030       if length(p-message) <= 70 then do:
     1031         assign
     1032           v-left-margin = integer((70 - length(p-message)) / 2)
     1033         .
     1034         assign
     1035           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1036         .
     1037         assign
     1038           v-waitfram-action01 = " "
     1039           v-waitfram-action02 = " "
     1040                                    + fill(" ", v-left-margin)
     1041                                    + p-message
     1042           v-waitfram-action03 = " "
     1043         .
     1044       end.
     1045       else do:
     1046         define variable vRindex1 as integer no-undo.
     1047         define variable vRindex2 as integer no-undo.
     1048         vRindex1 = r-index(p-message," ",70).
     1049         if vRindex1 = 0
     1050         then
     1051            vRindex1 = 70.
     1052         if length(p-message)  <= vRindex1 + 70 then do:
     1053           assign
     1054             v-waitfram-action01 = " "
     1055             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1056             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1057           .
     1058         end.
     1059         else do:
     1060           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1061           if vRindex2 <= vRindex1
     1062           then
     1063              vRindex2 = vRindex1 + 70.
     1064           assign
     1065             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1066             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1067             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1068           .
     1069         end.
     1070       end.
     1071       B-viewProcInfo:visible   in frame waitfram = no.
     1072       B-viewProcInfo:sensitive in frame waitfram = no.
     1073       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1074       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1075       if  (   mWaitFramView
     1076          or  mWaitProcEvent)
     1077          and not mBatchMode
     1078       then
     1079          display
     1080             v-waitfram-action01 skip
     1081             v-waitfram-action02 skip
     1082             v-waitfram-action03 skip
     1083          with frame waitfram .
     1084       if     mWaitFramView
     1085          then do:
     1086             if     mWaitFramInterval ne ?
     1087                and not mBatchMode
     1088             then
     1089                wait-for go of frame waitfram pause mWaitFramInterval.
     1090          end.
     1091          else
     1092             if     mWaitProcEvent
     1093                and not mBatchMode
     1094             then
     1095                process events .
     1096     end.
     1097   end procedure.
     1098      procedure waitfram-show-this:
     1099         define input  parameter iInterval as int64 no-undo.
     1100         define variable vtime as int64 no-undo.
     1101         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1102         mWaitFramInterval = iInterval.
     1103         run waitfram-show (substitute("&1&2 &3&4" ,
     1104                                       mWaitFramTextBeg ,
     1105                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1106                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1107                                       mWaitFramTextEnd
     1108                                      )
     1109                           ).
     1110      end.
     1111      procedure WaitFramRunPause:
     1112         define input  parameter iInterval as dec no-undo.
     1113         define variable vStart  as datetime-tz no-undo.
     1114         define variable vend    as datetime-tz no-undo.
     1115         define variable vint as int64 no-undo.
     1116         define variable vOk as logical no-undo.
     1117         vStart = now.
     1118         vend   = vStart.
     1119         publish "WaitFramPause" (iInterval,output vOk).
     1120         vend   =  now.
     1121         vint = vend - vStart.
     1122         vint = iInterval - vint / 1000.
     1123         if     not mWaitFramStop
     1124            and (   vint > 0
     1125                 or (    not vOk
     1126                     and iInterval eq ?
     1127                     )
     1128                 )
     1129         then
     1130            run waitfram-show-this (iInterval).
     1131         vend   =  now.
     1132         vint = vend - vStart.
     1133         vint = iInterval - vint / 1000.
     1134         if     not mWaitFramStop
     1135            and vint > 0
     1136         then do:
     1137            run gbl/pause.p (vint * 1000).
     1138         end.
     1139         if iInterval ne ?
     1140         then
     1141            publish "WaitFramStop".
     1142         waitfram-check-timeout().
     1143      end.
     1144      procedure WaitFramWaitFor:
     1145         define input  parameter iInterval as dec no-undo.
     1146         assign
     1147            mWaitFramStartProc   = now
     1148            mWaitFramStopUser    = no
     1149            mWaitFramStopTimeOut = no
     1150         .
     1151         block-wait:
     1152         do while not mWaitFramStop:
     1153            run WaitFramRunPause (iInterval).
     1154            if  waitfram-check-timeout()
     1155            then do:
     1156               leave block-wait.
     1157            end.
     1158         end.
     1159         run waitfram-hide.
     1160      end.
     1161   procedure waitfram-join :
     1162     define input  parameter p-line-1  as character no-undo .
     1163     define input  parameter p-line-2  as character no-undo .
     1164     define input  parameter p-line-3  as character no-undo .
     1165     define output parameter p-message as character no-undo .
     1166     do
     1167     on error undo, return error return-value
     1168     :
     1169       assign
     1170         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1171                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1172                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1173       .
     1174     end.
     1175   end procedure.
     1176   function waitfram-join-function returns character
     1177     (input p-line-1 as character
     1178     ,input p-line-2 as character
     1179     ,input p-line-3 as character
     1180     ).
     1181     define variable v-message as character no-undo .
     1182     run waitfram-join in this-procedure
     1183       (input  p-line-1
     1184       ,input  p-line-2
     1185       ,input  p-line-3
     1186       ,output v-message
     1187       ) .
     1188     return v-message .
     1189   end function .
     1190   define variable v-ii as integer no-undo .
     1191   define variable v-is as logical no-undo .
     1192   define variable v-ext-prg-handle as handle    no-undo .
     1193   define variable l-is-used as logical no-undo .
     1194   define variable v-is-remote-dbs as logical no-undo .
     1195   define variable v-obj-db-num like ub.clients.db-num no-undo .
     1196   define variable v-key-rec as character no-undo .
     1197   define variable v-param as character no-undo .
     1198   define variable v-list-db as character no-undo .
     1199   define variable v-sts-do as integer no-undo .
     1200   define variable v-sts-po as integer no-undo .
     1201   define variable v-can as logical no-undo .
     1202   define buffer buf_dis-rule for ub.dis-rule.
     1203   define buffer buf_dis-thbj-rule for ub.dis-thbj-rule.
     1204   _main:
     1205   do
     1206   on error undo, return error return-value
     1207   :
     1208     if bufp_dis-rule.obj-code > 0 then do:
     1209   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1210   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1211     (input  bufp_dis-rule.obj-type
     1212     ,input  bufp_dis-rule.obj-code
     1213     ,output v-obj-db-num
     1214     )  .
     1215     end.
     1216     if not can-find(first ub.db no-lock where ub.db.db-num > 0)
     1217     or (g#db-num = 0 and v-obj-db-num = g#db-num )
     1218     then do:
     1219       run value( "trg/dis-rult.p":U ) persistent set v-ext-prg-handle .
     1220     end.
     1221     else do:
     1222       assign
     1223       v-is-remote-dbs = yes
     1224       .
     1225     end.
     1226     _buf_dis-rule:
     1227     for each buf_dis-rule where
     1228             buf_dis-rule.rule-num = bufp_dis-rule.rule-num
     1229     on error undo _main, return error:
     1230       if v-is-remote-dbs then do:
     1231         if buf_dis-rule.obj-code > 0
     1232         and v-obj-db-num  > 0 then do:
     1233           run ref/dis-rul3.p (
     1234                         buffer buf_dis-rule
     1235                         ,input yes
     1236                         ,input yes
     1237                         ,output v-can
     1238                         ) no-error.
     1239           if error-status:error then do:
     1240             undo _main, return error  substitute("ПРАВИЛО СКИДОК №&1 не может быть удалено &2&3&2&4"
     1241                                   , buf_dis-rule.rule-num
     1242                                   , chr(10)
     1243                                   , error-status:get-message(1)
     1244                                   , return-value ).
     1245           end.
     1246           if not v-can then do:
     1247             undo _main, return error  substitute("ПРАВИЛО СКИДОК №&1 не может быть удалено &2&3"
     1248                                   , buf_dis-rule.rule-num
     1249                                   , chr(10)
     1250                                   , return-value ).
     1251           end.
     1252         end.
     1253         run gen-key-rec(
     1254                          input 'dis-rule':U
     1255                         ,input (buffer buf_dis-rule:handle )
     1256                         ,output v-key-rec
     1257                       ) no-error.
     1258         if error-status :error then do:
     1259           message
     1260             vss-workfile vss-revision vss-description skip
     1261             "Ошибка при генерации уникального ключа для правила скидок" skip
     1262             substitute( "номер правила &1", buf_dis-rule.rule-num ) skip
     1263             return-value
     1264             view-as alert-box error .
     1265           undo _main, return error.
     1266         end.
     1267         run get-db-list in this-procedure ( buffer buf_dis-rule, output v-list-db).
     1268         assign
     1269         v-param = string(buf_dis-rule.rule-num) + chr(4) +
     1270                   string(buf_dis-rule.sts) + chr(4) +
     1271                   v-list-db
     1272         .
     1273         assign
     1274         v-sts-do = buf_dis-rule.sts.
     1275         if g#db-num > 0 then do:
     1276           define buffer buf_route for ub.route.
     1277           find first buf_route no-lock where
     1278                     buf_route.name-rec = ("command":U + chr(1)
     1279                                           + "inquiry-two-commit":U + chr(1)
     1280                                           + 'delete_nu-dis-rule':U + chr(1)
     1281                                           + v-key-rec + chr(1)
     1282                                           + v-param) no-error.
     1283           if available buf_route then do:
     1284             message
     1285             substitute("Команда <Запуск удаления правила &1 из ГБД> уже отослана", buf_Dis-rule.rule-num)
     1286             view-as alert-box warning.
     1287             return no-apply.
     1288           end.
     1289         end.
     1290         run nws/db-rec.p (
     1291                             input 'delete_nu-dis-rule':U
     1292                             ,input v-key-rec
     1293                             ,input v-param
     1294                           ) no-error .
     1295         assign
     1296         v-sts-po = buf_dis-rule.sts.
     1297         if v-sts-po = v-sts-do
     1298         and not error-status:error
     1299         and not (buf_dis-rule.obj-code > 0
     1300             and v-obj-db-num  > 0 )
     1301         then do:
     1302           message
     1303           return-value skip
     1304           view-as alert-box error .
     1305           undo _main, return error.
     1306         end.
     1307         if g#db-num > 0 then do:
     1308           message
     1309           substitute("Отослана команда <Запуск удаления правила &1 из ГБД>", buf_Dis-rule.rule-num)
     1310           view-as alert-box.
     1311         end.
     1312       end.
     1313       else do:
     1314         run value( "proc-is-used-dis-rule" ) in v-ext-prg-handle (buffer buf_dis-rule, input g#db-num, output l-is-used) no-error .
     1315         if not error-status:error
     1316         and not l-is-used then do:
     1317           run ref/dis-rul3.p (
     1318                            buffer buf_dis-rule
     1319                           ,input no
     1320                           ,input yes
     1321                           ,output v-can
     1322                           ) no-error .
     1323         end.
     1324         if not error-status:error
     1325         and l-is-used then do:
     1326           message
     1327           return-value skip
     1328           view-as alert-box error .
     1329           undo _main, return error.
     1330         end.
     1331       end.
     1332       if error-status :error then do:
     1333         message
     1334           vss-workfile vss-revision vss-description skip
     1335           "Ошибка при удалении правила скидок" skip
     1336           substitute( "номер правила &1", buf_dis-rule.rule-num ) skip
     1337           return-value skip
     1338           error-status :get-message(1)
     1339           view-as alert-box error .
     1340         undo _main, return error.
     1341       end.
     1342     end.
     1343     if v-is-remote-dbs = no then
     1344     delete procedure v-ext-prg-handle .
     1345     run waitfram-hide in this-procedure .
     1346   end.
     1347   procedure get-db-list :
     1348   define parameter buffer buf_dis-rule for ub.dis-rule.
     1349   define output parameter p-list-db as character no-undo .
     1350   define buffer buf_clients for ub.clients.
     1351     do
     1352     on error undo, return error
     1353     :
     1354       if not (buf_dis-rule.obj-type = '':U
     1355               and
     1356               buf_dis-rule.obj-code = 0) then do:
     1357         find first buf_clients no-lock where
     1358                   buf_clients.obj-type = buf_dis-rule.obj-type
     1359               and buf_clients.obj-code = buf_dis-rule.obj-code no-error .
     1360         if not available buf_clients then do:
     1361           return error substitute("&1 Не найден объект &2&3 для правила скидки № &4"
     1362                                   ,vss-workfile
     1363                                   ,buf_dis-rule.obj-type
     1364                                   ,buf_dis-rule.obj-code
     1365                                   ,buf_dis-rule.rule-num ).
     1366         end.
     1367         if buf_clients.db-num = ? then do:
     1368           return error substitute("&1 Неверный номер БД &2 для объекта &3&4 правила скидки № &5"
     1369                                   ,vss-workfile
     1370                                   ,chr(63)
     1371                                   ,buf_dis-rule.obj-type
     1372                                   ,buf_dis-rule.obj-code
     1373                                   ,buf_dis-rule.rule-num ).
     1374         end.
     1375         if buf_clients.db-num > 0 then
     1376         assign
     1377           p-list-db = string(0) + chr(44) + string(buf_Clients.db-num)
     1378         .
     1379       end.
     1380       else do:
     1381         assign
     1382         p-list-db = chr(63).
     1383       end.
     1384     end.
     1385   end procedure.
