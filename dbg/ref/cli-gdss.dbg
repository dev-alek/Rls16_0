     3589   DEFINE VARIABLE v-without-zero as logical no-undo .
     3590   DEFINE VARIABLE choice as integer no-undo .
     3591   run gbl/d-askw.w
     3592                        (input "Печать остатков по контрагенту",
     3593                         input "Выберите опцию печати",
     3594                         input "|",
     3595                         input "Печатать нулевые остатки|Не печатать нулевые остатки|Выход",
     3596                         input "||",
     3597                         input 2,
     3598                         input 3,
     3599                         output choice).
     3600   if choice = 3 then return.
     3601   assign
     3602   v-without-zero = (choice = 2)
     3603   .
     3604    run ref/cli-gdsp.p (
     3605                   input parparentproc,
     3606                   input ENTRY(1, p-list-mode),
     3607                   input ENTRY(2, p-list-mode),
     3608                   input replace(FRAME Dialog-Frame:TITLE, chr(34), chr(39)),
     3609                   input v-without-zero,
     3610                   output  accum-in-qnty ,
     3611                   output  accum-out-qnty ,
     3612                   output  accum-ret-qnty  ,
     3613                   output  accum-in-base  ,
     3614                   output  accum-in-rubl  ,
     3615                   output  accum-out-sum  ,
     3616                   output  accum-ret-sum  ,
     3617                   output  accum-out-discnt  ,
     3618                   output  accum-ret-discnt  ,
     3619                   output  accum-supp-qnty  ,
     3620                   output  accum-supp-base  ,
     3621                   output  accum-supp-rubl
     3622                   ).
     3623      display
     3624       accum-in-qnty @ F-IN-QNTY
     3625       accum-in-base @ F-IN-SUM-BASE
     3626       accum-in-rubl @ F-IN-SUM-RUBL
     3627       accum-supp-qnty @ F-LEFT-QNTY
     3628       accum-supp-base @ F-LEFT-SUM-BASE
     3629       accum-supp-rubl @ F-LEFT-SUM-RUBL
     3630       accum-out-discnt @ F-OUT-DISCNT-BASE
     3631       accum-out-qnty @ F-OUT-QNTY
     3632       accum-out-sum @ F-OUT-SUM-BASE
     3633       accum-ret-discnt @ F-RET-DISCNT-BASE
     3634       accum-ret-qnty @ F-RET-QNTY
     3635       accum-ret-sum @ F-RET-SUM-BASE
     3636       with frame Dialog-Frame.
     3637   END PROCEDURE.
     3638   PROCEDURE Print-TotalProc :
     3639   Def Input Parameter work-mode as character format "X(1)" no-undo.
     3640   define variable v-process as logical no-undo .
     3641   define variable reportfilename as character no-undo .
     3642   if work-mode = "P" then do:
     3643       Line = fill("-", 177).
     3644       date_string = cur-time-print() .
     3645      run prn-lib-open-exp in this-procedure (
     3646                                               input parParentProc
     3647                                              ,input yes
     3648                                              ,input no
     3649                                              ,output ReportFileName
     3650                                              ,output v-process
     3651                                               ) .
     3652      if not v-process then return.
     3653       PUT  STREAM PrnLibStream UNFORMATTED
     3654       ( frame Dialog-Frame:title )
     3655       format "x(90)" SKIP(0)
     3656       date_string skip(0) .
     3657   end.
     3658   run waitfram-show in this-procedure ("Ждите...").
     3659   if work-mode = "P" then do:
     3660   PUT STREAM PrnLibStream UNFORMATTED
     3661   "Артикул" p-XL-delim
     3662   "Название_товара" p-XL-delim
     3663   "Ед.изм." p-XL-delim
     3664   "Код производителя" p-XL-delim
     3665   "Производитель" p-XL-delim
     3666   "Контрагент" p-XL-delim
     3667   "Артикул_контрагента" p-XL-delim
     3668   "Ед.изм._контрагента" p-XL-delim
     3669   "Кол-во/приход" p-XL-delim
     3670   "Кол-во/расход" p-XL-delim
     3671   "Кол-во/возврат" p-XL-delim
     3672   "Учетн.цены(баз.вал.)/приход" p-XL-delim
     3673   "Учетн.цены(руб.)/приход" p-XL-delim
     3674   "Продаж.цены(вал.продаж)/расход" p-XL-delim
     3675   "Продаж.цены(вал.продаж)/возврат" p-XL-delim
     3676   "Скидки(вал.продаж)/расход" p-XL-delim
     3677   "Скидки(вал.продаж)/возврат" p-XL-delim
     3678   "Последняя_ПН" p-XL-delim
     3679   "Валюта_посл.ПН" p-XL-delim
     3680   "Последн.цена_контрагента" p-XL-delim
     3681   "Кол-во/остатки" p-XL-delim
     3682   "Учетн.цены(баз.вал.)/остатки" p-XL-delim
     3683   "Учетн.цены(руб.)/остатки" p-XL-delim
     3684   SKIP.
     3685   end.
     3686       assign
     3687       accum-count = 0
     3688       accum-in-qnty = 0
     3689       accum-out-qnty = 0
     3690       accum-ret-qnty = 0
     3691       accum-in-base = 0
     3692       accum-in-rubl = 0
     3693       accum-out-sum = 0
     3694       accum-ret-sum = 0
     3695       accum-out-discnt = 0
     3696       accum-ret-discnt = 0
     3697       accum-supp-qnty = 0
     3698       accum-supp-base = 0
     3699       accum-supp-rubl = 0.
     3700   GET next br-docs.
     3701   DO WHILE available sb-cli-gds :
     3702       assign
     3703       accum-count = accum-count + 1
     3704       accum-in-qnty = accum-in-qnty + sb-cli-gds.in-qnty
     3705       accum-out-qnty = accum-out-qnty + sb-cli-gds.out-qnty
     3706       accum-ret-qnty = accum-ret-qnty + sb-cli-gds.ret-qnty
     3707       accum-in-base = accum-in-base + sb-cli-gds.in-base
     3708       accum-in-rubl = accum-in-rubl + sb-cli-gds.in-rubl
     3709       accum-out-sum = accum-out-sum + sb-cli-gds.out-sum
     3710       accum-ret-sum = accum-ret-sum + sb-cli-gds.ret-sum
     3711       accum-out-discnt = accum-out-discnt + sb-cli-gds.out-discnt
     3712       accum-ret-discnt = accum-ret-discnt + sb-cli-gds.ret-discnt
     3713       accum-supp-qnty = accum-supp-qnty + sb-cli-gds.supp-qnty
     3714       accum-supp-base = accum-supp-base + sb-cli-gds.supp-base
     3715       accum-supp-rubl = accum-supp-rubl + sb-cli-gds.supp-rubl.
     3716       if work-mode = "P" then do:
     3717           FIND FIRST ub.currency NO-LOCK WHERE ub.currency.curr-code = sb-cli-gds.exch-code
     3718           No-ERROR.
     3719           FIND FIRST ub.clients NO-LOCK WHERE ub.clients.obj-type = sb-cli-gds.prod-type AND
     3720                                            ub.clients.obj-code = sb-cli-gds.prod-code
     3721           No-ERROR.
     3722           if avail ub.clients then
     3723           cli-name = ub.clients.obj-name.
     3724           else
     3725           cli-name = "".
     3726           FIND FIRST ub.clients NO-LOCK WHERE ub.clients.obj-type = sb-cli-gds.prod-type AND
     3727                                            ub.clients.obj-code = sb-cli-gds.prod-code
     3728           No-ERROR.
     3729           FIND FIRST ub.goods No-LOCK WHERE ub.goods.prod-type = sb-cli-gds.prod-type AND
     3730                                                                       ub.goods.prod-code = sb-cli-gds.prod-code AND
     3731                                                                       ub.goods.artic = sb-cli-gds.artic
     3732           NO-ERROR.
     3733           IF AVAIL ub.goods then
     3734           assign
     3735           gds-name = ub.goods.gds-name
     3736           unit-base = ub.goods.unit-base.
     3737           else
     3738           assign
     3739           gds-name = ""
     3740           unit-base = "".
     3741           PUT STREAM PrnLibStream UNFORMATTED
     3742           sb-cli-gds.artic p-XL-delim
     3743           REPLACE(gds-name, " ", "_") p-XL-delim
     3744           unit-base p-XL-delim
     3745           (clients.obj-type + "_" + string(clients.obj-code)) p-XL-delim
     3746           REPLACE(clients.obj-name, " ", "_") p-XL-delim
     3747           REPLACE(cli-name, " ", "_") p-XL-delim
     3748           sb-cli-gds.cli-art p-XL-delim
     3749           sb-cli-gds.unit-cli p-XL-delim
     3750           sb-cli-gds.in-qnty p-XL-delim
     3751           sb-cli-gds.out-qnty p-XL-delim
     3752           sb-cli-gds.ret-qnty p-XL-delim
     3753           sb-cli-gds.in-base p-XL-delim
     3754           sb-cli-gds.in-rubl p-XL-delim
     3755           sb-cli-gds.out-sum p-XL-delim
     3756           sb-cli-gds.ret-sum p-XL-delim
     3757           sb-cli-gds.out-discnt p-XL-delim
     3758           sb-cli-gds.ret-discnt p-XL-delim
     3759           sb-cli-gds.in-code p-XL-delim
     3760           last-curr-code p-XL-delim
     3761           sb-cli-gds.price-cli p-XL-delim
     3762           sb-cli-gds.supp-qnty p-XL-delim
     3763           sb-cli-gds.supp-base p-XL-delim
     3764           sb-cli-gds.supp-rubl p-XL-delim
     3765           skip.
     3766       end.
     3767       GET next br-docs.
     3768       END.
     3769       IF work-mode = "P" then do:
     3770           PUT STREAM PrnLibStream UNFORMATTED
     3771           "ИТОГО_записей" p-XL-delim
     3772           string(accum-count) p-XL-delim
     3773           p-XL-delim
     3774           p-XL-delim
     3775           p-XL-delim
     3776           p-XL-delim
     3777           p-XL-delim
     3778           p-XL-delim
     3779           accum-in-qnty p-XL-delim
     3780           accum-out-qnty p-XL-delim
     3781           accum-ret-qnty p-XL-delim
     3782           accum-in-base p-XL-delim
     3783           accum-in-rubl p-XL-delim
     3784           accum-out-sum p-XL-delim
     3785           accum-ret-sum p-XL-delim
     3786           accum-out-discnt p-XL-delim
     3787           accum-ret-discnt p-XL-delim
     3788           p-XL-delim
     3789           p-XL-delim
     3790           p-XL-delim
     3791           accum-supp-qnty p-XL-delim
     3792           accum-supp-base p-XL-delim
     3793           accum-supp-rubl p-XL-delim
     3794           SKIP.
     3795          output  STREAM PrnLibStream CLOSE.
     3796           run waitfram-hide in this-procedure .
     3797      end.
     3798      run waitfram-hide in this-procedure .
     3799       display
     3800       accum-in-qnty @ F-IN-QNTY
     3801       accum-in-base @ F-IN-SUM-BASE
     3802       accum-in-rubl @ F-IN-SUM-RUBL
     3803       accum-supp-qnty @ F-LEFT-QNTY
     3804       accum-supp-base @ F-LEFT-SUM-BASE
     3805       accum-supp-rubl @ F-LEFT-SUM-RUBL
     3806       accum-out-discnt @ F-OUT-DISCNT-BASE
     3807       accum-out-qnty @ F-OUT-QNTY
     3808       accum-out-sum @ F-OUT-SUM-BASE
     3809       accum-ret-discnt @ F-RET-DISCNT-BASE
     3810       accum-ret-qnty @ F-RET-QNTY
     3811       accum-ret-sum @ F-RET-SUM-BASE
     3812       with frame Dialog-Frame.
     3813   END PROCEDURE.
     3814   FUNCTION get-ext-artic RETURNS CHARACTER
     3815     (buffer loc-cli-gds for sb-cli-gds ) :
     3816       find first buf-goods no-lock
     3817           where buf-goods.prod-type = loc-cli-gds.prod-type
     3818           and buf-goods.prod-code = loc-cli-gds.prod-code
     3819           and buf-goods.artic = loc-cli-gds.artic
     3820           no-error.
     3821       if not avail buf-goods then return "".
     3822       find first ub.ext-artic no-lock
     3823           where ub.ext-artic.cli-type = loc-cli-gds.cli-type
     3824           and ub.ext-artic.cli-code = loc-cli-gds.cli-code
     3825           and ub.ext-artic.gds-code = buf-goods.gds-code
     3826           no-error.
     3827       if avail ub.ext-artic then
     3828           return ub.ext-artic.ext-artic.
     3829       else
     3830           return "".
     3831   END FUNCTION.
     3832   FUNCTION get-cli-name RETURNS CHARACTER
     3833     (buffer loc-cli-gds for sb-cli-gds ) :
     3834       define variable dop like ub.clients.obj-name.
     3835       FIND FIRST ub.clients NO-LOCK WHERE ub.clients.obj-type = loc-cli-gds.cli-type AND
     3836                                        ub.clients.obj-code = loc-cli-gds.cli-code
     3837       No-ERROR.
     3838       IF avail ub.clients then dop = ub.clients.obj-name.
     3839       ELSE dop = "".
     3840     RETURN dop.
     3841   END FUNCTION.
     3842   FUNCTION get-gds-name RETURNS CHARACTER
     3843     (buffer loc-cli-gds for sb-cli-gds ) :
     3844       define variable dop like ub.goods.gds-name.
     3845       FIND FIRST ub.goods NO-LOCK WHERE ub.goods.prod-type = loc-cli-gds.prod-type AND
     3846                                      ub.goods.prod-code = loc-cli-gds.prod-code AND
     3847                                      ub.goods.artic = loc-cli-gds.artic
     3848       No-ERROR.
     3849       IF avail ub.goods then dop = ub.goods.gds-name.
     3850       ELSE dop = "".
     3851     RETURN dop.
     3852   END FUNCTION.
     3853   FUNCTION Get-last-curr-code RETURNS CHARACTER
     3854     (buffer loc-cli-gds for sb-cli-gds ) :
     3855       define variable dop like ub.currency.curr-abbr.
     3856       FIND FIRST ub.currency NO-LOCK WHERE ub.currency.curr-code = loc-cli-gds.exch-code
     3857       No-ERROR.
     3858       IF avail ub.currency then dop = ub.currency.curr-abbr.
     3859       ELSE dop = "".
     3860     RETURN dop.
     3861   END FUNCTION.
     3862   FUNCTION get-unit-base RETURNS CHARACTER
     3863     (buffer loc-cli-gds for sb-cli-gds ) :
     3864       define variable dop like ub.goods.gds-name.
     3865       FIND FIRST ub.goods NO-LOCK WHERE ub.goods.prod-type = loc-cli-gds.prod-type AND
     3866                                      ub.goods.prod-code = loc-cli-gds.prod-code AND
     3867                                      ub.goods.artic = loc-cli-gds.artic
     3868       No-ERROR.
     3869       IF avail ub.goods then dop = ub.goods.unit-base.
     3870       ELSE dop = "".
     3871     RETURN dop.
     3872   END FUNCTION.
