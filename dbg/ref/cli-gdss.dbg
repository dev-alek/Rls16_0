      773   procedure prn-lib-reportviewer :
      774     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      775     define input parameter p-report-name-html as character no-undo .
      776     define input parameter p-param        as character no-undo .
      777     define variable v-excel           as character no-undo init 'TRUE' .
      778     define variable v-value-character as character no-undo .
      779     define variable v-value-integer   as character no-undo .
      780     define variable v-value-date      as date      no-undo .
      781     define variable v-value-decimal   as decimal   no-undo .
      782     define variable rep-excel         as logical   no-undo .
      783     define variable excel-string      as character no-undo .
      784     define variable v-param-type      as character no-undo .
      785     define variable v-tth             as handle    no-undo .
      786     run adm/shattri.p (
      787       input "get":U
      788       ,input  ""
      789       ,input  0
      790       ,input  'report-glob':U
      791       ,input  'rep-excel':U
      792       ,output v-value-character
      793       ,output v-value-date
      794       ,output v-value-decimal
      795       ,output v-value-integer
      796       ,output rep-excel
      797       ,output v-param-type
      798       ,INPUT-OUTPUT table-handle v-tth
      799       )  .
      800     if rep-excel then v-excel = "TRUE" .
      801     else v-excel = "FALSE" .
      802     if p-param eq ""
      803     then
      804        p-param = "EXCEL:" + v-excel.
      805     else
      806        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      807     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      808   end procedure.
