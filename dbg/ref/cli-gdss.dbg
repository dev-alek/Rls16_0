      675   procedure prn-lib-open-stream :
      676     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      677     define input parameter p-page-size    as integer no-undo .
      678     define input parameter p-is-stream    as logical no-undo .
      679     define input parameter p-append       as logical no-undo .
      680     define variable v-report-name as character no-undo .
      681     do
      682       on error undo, return error
      683       :
      684       run prn-lib-get-report-name  in this-procedure (
      685         input parParentProc
      686         ,output v-report-name
      687         ).
      688       if p-is-stream then
      689       do:
      690         if p-append then
      691         do:
      692           output stream PrnLibStream to value( v-report-name )
      693             page-size value(p-page-size) append .
      694         end.
      695         if not p-append then
      696         do:
      697           output stream PrnLibStream to value( v-report-name )
      698             page-size value(p-page-size) .
      699         end.
      700       end.
      701       if not p-is-stream then
      702       do:
      703         if p-append then
      704         do:
      705           output to value( v-report-name )
      706             page-size value(p-page-size) append .
      707         end.
      708         if not p-append then
      709         do:
      710           output to value( v-report-name )
      711             page-size value(p-page-size) .
      712         end.
      713       end.
      714     end.
      715   end procedure.
      716   procedure prn-lib-open-exp :
      717     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      718     define input parameter p-is-stream    as logical no-undo .
      719     define input parameter p-is-append    as logical no-undo .
      720     define output parameter p-ReportFileName as char init "report" no-undo.
      721     define output parameter p-process as logical no-undo .
      722     define variable glog as logical no-undo .
      723     do
      724       on error undo, return error
      725       :
      726       SYSTEM-DIALOG GET-FILE p-ReportFileName
      727         TITLE      "Укажите путь"
      728         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      729         ASK-OVERWRITE
      730         CREATE-TEST-FILE
      731         SAVE-AS
      732         USE-FILENAME
      733         DEFAULT-EXTENSION "txt"
      734         UPDATE glog
      735         .
      736       if not glog then  return.
      737       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      738       if p-is-stream then
      739       do:
      740         if p-is-append then
      741         do:
      742           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      743         end.
      744         else
      745         do:
      746           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      747         end.
      748       end.
      749       else
      750       do:
      751         if p-is-append then
      752         do:
      753           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      754         end.
      755         else
      756         do:
      757           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      758         end.
      759       end.
      760       p-process = yes.
      761     end.
      762   end procedure.
