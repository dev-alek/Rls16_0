      855   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      856   procedure fltopend_fltopend :
      857   define input parameter p-parent-handle as handle no-undo .
      858   define input parameter p-qh as handle no-undo .
      859   define input parameter p-flt-open-open-query  as character no-undo .
      860   define input parameter p-where-cond as character no-undo .
      861   define input parameter p-use-indFIRST-query-tail as character no-undo .
      862   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      863   define input parameter p-indexed-reposition as character no-undo .
      864     do
      865     on error undo, return error
      866     :
      867   define variable v-prepare-string as character no-undo .
      868   define variable glog as logical no-undo .
      869   assign
      870   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      871                      p-where-cond + chr(32)  +
      872                      p-use-indFIRST-query-tail + chr(32) +
      873                      p-use-ind-sort-clmn-by + chr(32) +
      874                      p-indexed-reposition
      875   .
      876   assign
      877   glog = p-qh:query-prepare(v-prepare-string) no-error .
      878   if not glog
      879   or error-status:error then do:
      880     message error-status:get-message(1) view-as alert-box .
      881     undo, return error .
      882   end.
      883   assign
      884   glog = p-qh:query-open no-error .
      885   if not glog
      886   or error-status:error then do:
      887     message error-status:get-message(1) view-as alert-box .
      888     undo, return error .
      889   end.
      890     end.
      891   end procedure.
      892   procedure fltopend_fltfindd :
      893   define input parameter p-parent-handle as handle no-undo .
      894   define input parameter p-qh as handle no-undo .
      895   define input parameter p-rowid as rowid no-undo .
      896   define input parameter p-next as logical no-undo .
      897   define input parameter p-lock as integer no-undo .
      898   define input parameter p-bh as handle no-undo .
      899   define input parameter p-where-cond as character no-undo .
      900   define input parameter p-use-index-phrase as character no-undo .
      901   define variable glog as logical no-undo .
      902   define variable v-qh as handle no-undo .
      903   define variable v-bh as handle no-undo .
      904   define variable v-recid as recid no-undo .
      905   define variable v-prepare-string as character no-undo .
      906   do
      907   on error undo, return error
      908   on stop undo, return error
      909   :
      910     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      911     create buffer v-bh for table p-bh buffer-name p-bh:name.
      912     create query v-qh.
      913     v-qh:set-buffers(v-bh).
      914     v-prepare-string = substitute("for each &1 &2 &3"
      915                                     ,v-bh:name
      916                                     ,p-where-cond
      917                                     ,p-use-index-phrase).
      918     glog = v-qh:query-prepare(v-prepare-string) no-error.
      919     if not glog then do:
      920       delete object v-qh.
      921       delete object v-bh.
      922       undo, return error .
      923     end.
      924     glog = v-qh:query-open no-error .
      925     if not glog then do:
      926       delete object v-qh.
      927       delete object v-bh.
      928       undo, return error .
      929     end.
      930     if p-next then do:
      931       v-qh:reposition-to-rowid(p-rowid) no-error .
      932       glog = v-qh:get-next( p-lock) no-error .
      933       glog = v-qh:get-next( p-lock) no-error .
      934       if not glog or v-qh:query-off-end = yes then do:
      935         glog = v-qh:get-first( p-lock) no-error .
      936       end.
      937     end.
      938     else do:
      939       glog = v-qh:get-first( p-lock) no-error .
      940     end.
      941     v-recid = v-bh:recid no-error .
      942     delete object v-qh.
      943     delete object v-bh.
      944     return string(v-recid) .
      945   end.
      946   end procedure.
      947   procedure fltopend_fltfindq :
      948   define input parameter p-parent-handle as handle no-undo .
      949   define input parameter p-qh as handle no-undo .
      950   define input parameter p-next as logical no-undo .
      951   define input parameter p-lock as integer no-undo .
      952   define input parameter p-flt-open-open-query  as character no-undo .
      953   define input parameter p-where-cond as character no-undo .
      954   define input parameter p-use-indFIRST-query-tail as character no-undo .
      955   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      956   define input parameter p-indexed-reposition as character no-undo .
      957   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      958   define variable glog as logical no-undo .
      959   define variable v-qh as handle no-undo .
      960   define variable v-bh as handle no-undo extent 18.
      961   define variable v-rowid as rowid no-undo extent 18.
      962   define variable v-ii as integer no-undo .
      963   define variable v-prepare-string as character no-undo .
      964   do
      965   on error undo, return error
      966   on stop undo, return error
      967   :
      968     create query v-qh.
      969     do v-ii = 1 to p-qh:num-buffers:
      970       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      971       assign
      972       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      973       no-error.
      974       v-qh:add-buffer(v-bh[v-ii]).
      975     end.
      976     assign
      977     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      978                       p-where-cond + chr(32)  +
      979                       p-use-indFIRST-query-tail + chr(32) +
      980                       p-use-ind-sort-clmn-by + chr(32) +
      981                       p-indexed-reposition
      982     .
      983     glog = v-qh:query-prepare( v-prepare-string) no-error .
      984     if not glog then do:
      985       delete object v-qh.
      986       do v-ii = 1 to p-qh:num-buffers:
      987         delete object v-bh[v-ii].
      988       end.
      989       undo, return error .
      990     end.
      991     glog = v-qh:query-open no-error .
      992     if not glog then do:
      993       delete object v-qh.
      994       do v-ii = 1 to p-qh:num-buffers:
      995         delete object v-bh[v-ii].
      996       end.
      997       undo, return error .
      998     end.
      999     if p-next then do:
     1000       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1001       glog = v-qh:get-next( p-lock) no-error .
     1002       glog = v-qh:get-next( p-lock) no-error .
     1003       if not glog or v-qh:query-off-end = yes then do:
     1004         glog = v-qh:get-first( p-lock) no-error .
     1005       end.
     1006     end.
     1007     else do:
     1008       glog = v-qh:get-first( p-lock) no-error .
     1009     end.
     1010     do v-ii = 1 to p-qh:num-buffers:
     1011       assign
     1012       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1013       no-error.
     1014     end.
     1015     delete object v-qh.
     1016     do v-ii = 1 to p-qh:num-buffers:
     1017       delete object v-bh[v-ii].
     1018     end.
     1019   end.
     1020   end procedure.
