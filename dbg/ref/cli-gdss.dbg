        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-list-mode as character no-undo .
        3   define input parameter p-gds-rec   as recid no-undo .
        4   define input parameter p-rep-rec as recid no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":u .
        6   define variable vss-author      as character no-undo init "$Author$":u .
        7   define variable vss-date        as character no-undo init "$Date$":u .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        9   define variable vss-archive     as character no-undo init "$Archive$":u .
       10   define variable vss-description as character no-undo init "Показ товаров по контрагентам " .
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   procedure cur-time :
       73      define output parameter p-today as date      no-undo .
       74      define output parameter p-time  as integer   no-undo .
       75     do
       76     on error undo, return error
       77     :
       78       define variable v-date1 as date      no-undo .
       79       define variable v-date2 as date      no-undo .
       80       define variable v-time  as integer   no-undo .
       81       assign
       82         v-date1 = today
       83         v-time  = time
       84         v-date2 = today
       85       .
       86       if v-date1 <> v-date2
       87       then do:
       88         assign
       89           v-date1 = today
       90           v-time  = v-time
       91         .
       92       end.
       93       assign
       94         p-today = v-date1
       95         p-time  = v-time
       96       .
       97     end.
       98   end.
       99   function cur-time-date returns character
      100   :
      101     return string(today, '99/99/9999':U) .
      102   end.
      103   function cur-time-mjd returns decimal
      104   :
      105     define variable v-date as date      no-undo .
      106     define variable v-time as integer   no-undo .
      107     run cur-time in this-procedure
      108       (output v-date
      109       ,output v-time
      110       ) .
      111     return integer(v-date) - 2400002 + (v-time / 86400) .
      112   end.
      113   function cur-time-get-ending-index returns integer
      114   (input p-number as integer
      115   )
      116   :
      117     if p-number < 0
      118     or p-number = ?
      119     then do:
      120       return 1 .
      121     end.
      122     define variable v-rest as integer   no-undo .
      123     assign
      124       p-number = p-number modulo 100
      125     .
      126     if p-number < 20
      127     then do:
      128       assign
      129         v-rest = p-number
      130       .
      131     end.
      132     else do:
      133       assign
      134         v-rest = p-number modulo 10
      135       .
      136     end.
      137     case v-rest :
      138       when 1
      139       then do:
      140         return 2 .
      141       end.
      142       when 2 or
      143       when 3 or
      144       when 4
      145       then do:
      146         return 3 .
      147       end.
      148       otherwise do:
      149         return 1 .
      150       end.
      151     end case .
      152   end.
      153   procedure cur-time-mjd-to-date :
      154      define input  parameter i-mjd-diff as decimal no-undo.
      155      define output parameter o-Date     as date    no-undo.
      156      define output parameter o-Time     as integer no-undo.
      157      define variable v-day-number as integer   no-undo .
      158      if    i-mjd-diff < 0
      159         or i-mjd-diff = ?
      160      then do:
      161         return "?" .
      162      end.
      163      assign
      164         v-day-number = truncate(i-mjd-diff,0).
      165         o-Date = date(v-day-number + 2400002).
      166         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      167     .
      168   end.
      169   function cur-time-mjd-to-string returns character
      170   (input p-mjd-diff as decimal
      171   )
      172   :
      173     define variable v-day-number as integer   no-undo .
      174     define variable v-seconds    as integer   no-undo .
      175     define variable v-hour       as integer   no-undo .
      176     define variable v-min        as integer   no-undo .
      177     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      178     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      179     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      180     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      181     if p-mjd-diff < 0
      182     or p-mjd-diff = ?
      183     then do:
      184       return "?" .
      185     end.
      186     assign
      187       v-day-number = integer(truncate(p-mjd-diff,0))
      188       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      189     .
      190     if v-seconds > 86400
      191     then do:
      192       assign
      193         v-seconds = 86400 - 1
      194       .
      195     end.
      196     if v-seconds < 0
      197     then do:
      198       assign
      199         v-seconds = 0
      200       .
      201     end.
      202     assign
      203       v-hour = truncate(v-seconds / 3600, 0)
      204     .
      205     assign
      206       v-seconds = v-seconds modulo 3600
      207     .
      208     assign
      209       v-min = truncate(v-seconds / 60, 0)
      210     .
      211     assign
      212       v-seconds = v-seconds modulo 60
      213     .
      214     return
      215         (if v-day-number <> 0
      216           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      217           else ""
      218         )
      219       + (if v-day-number <> 0 or v-hour <> 0
      220           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      221           else ""
      222         )
      223       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      224           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      225           else ""
      226         )
      227       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      228       .
      229   end.
      230   function cur-time-string returns character
      231   :
      232     define variable v-date as date      no-undo .
      233     define variable v-time as integer   no-undo .
      234     run cur-time in this-procedure
      235       (output v-date
      236       ,output v-time
      237       ) .
      238     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      239   end.
      240   function cur-time-string-sec returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      249   end.
      250   function cur-time-custom  returns character
      251   (input p-prefix as character
      252   ,input p-date-format as character
      253   ,input p-delimiter as character
      254   ,input p-time-format as character
      255   ,input p-suffix as character
      256   )
      257   :
      258     define variable v-date as date      no-undo .
      259     define variable v-time as integer   no-undo .
      260     run cur-time in this-procedure
      261       (output v-date
      262       ,output v-time
      263       ) .
      264     return
      265       p-prefix
      266       + string(v-date, p-date-format)
      267       + p-delimiter
      268       + string(v-time, p-time-format)
      269       + p-suffix
      270       .
      271   end.
      272   function cur-time-print  returns character
      273   :
      274     define variable v-date as date      no-undo .
      275     define variable v-time as integer   no-undo .
      276     run cur-time in this-procedure
      277       (output v-date
      278       ,output v-time
      279       ) .
      280     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      281   end.
      282   function cur-time-datetime returns datetime
      283   :
      284     define variable v-char as character no-undo .
      285     define variable v-datetime as datetime no-undo .
      286     v-char = cur-time-string().
      287     v-datetime = datetime(v-char).
      288     return  v-datetime.
      289   end.
      290   function cur-time-string-msec returns character
      291   :
      292     define variable v-date as datetime  no-undo .
      293     v-date = now.
      294     return string(v-date) .
      295   end.
      296   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      297   define variable c-point  as character no-undo .
      298   define variable tbl      as character no-undo .
      299   define variable join-tbl as character no-undo .
      300   define variable fld      as character no-undo .
      301   define variable lab      as character no-undo .
      302   define variable spr      as character no-undo .
      303   define variable dim      as character no-undo .
      304   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      305   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      306   define new shared variable RepPathName        as character no-undo .
      307   define new shared variable PrintRubl          as logical   no-undo .
      308   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      309   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      310   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      311   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      312   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      313   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      314   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      315   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      316   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      317   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      318   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      319   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      320   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      321   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      322   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      323   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      324   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      325   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      326   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      327   procedure fltfield-clear :
      328     define output parameter loc-fld as character no-undo.
      329     define output parameter loc-lab as character no-undo .
      330     define output parameter loc-spr as character no-undo .
      331     define output parameter loc-dim as character no-undo .
      332     assign
      333       loc-fld = ""
      334       loc-lab = ""
      335       loc-spr = ""
      336       loc-dim = "0"
      337     .
      338   end procedure .
      339   procedure fltfield-add :
      340     define input        parameter par-fld as character no-undo.
      341     define input        parameter par-lab as character no-undo .
      342     define input        parameter par-spr as character no-undo .
      343     define input-output parameter loc-fld as character no-undo.
      344     define input-output parameter loc-lab as character no-undo .
      345     define input-output parameter loc-spr as character no-undo .
      346     define input-output parameter loc-dim as character no-undo .
      347     do
      348     on error undo, return error
      349     :
      350       assign
      351       loc-fld = if loc-dim = '0'
      352                 then par-fld
      353                 else (loc-fld + chr(44) + par-fld)
      354       loc-lab = if loc-dim = '0'
      355                 then par-lab
      356                 else (loc-lab + chr(44) + par-lab)
      357       loc-spr = if loc-dim = '0'
      358                 then par-spr
      359                 else (loc-spr + chr(44) + par-spr)
      360       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      361                 string(integer(if num-entries(loc-dim) > 1
      362                               then entry(2, loc-dim)
      363                               else entry(1, loc-dim)
      364                               ) + 1)
      365       no-error
      366       .
      367     end.
      368   end procedure.
      369   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      370   define variable v-waitfram-action01         as character   no-undo .
      371   define variable v-waitfram-action02         as character   no-undo .
      372   define variable v-waitfram-action03         as character   no-undo .
      373   define variable mWaitFramTextBeg            as character   no-undo.
      374   define variable mWaitFramTextEnd            as character   no-undo.
      375   define variable mWaitFramView               as logical     no-undo.
      376   define variable mWaitProcEvent              as logical     no-undo init yes.
      377   define variable mWaitFramInterval           as integer     no-undo init 1 .
      378   define variable mWaitFramStop               as logical     no-undo.
      379   define variable mWaitFramStopUser           as logical     no-undo.
      380   define variable mWaitFramStopTimeOut        as logical     no-undo.
      381   define variable mWaitFramStartProc          as datetime-tz no-undo.
      382   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      383   define button B-WaitFramStop auto-end-key
      384        label "Стоп"
      385        size 10 by 1 tooltip "Остоновить процесс".
      386   define button B-viewProcInfo
      387        label "Информация"
      388        size 15 by 1 tooltip "Информация о процесс".
      389   define frame waitfram
      390     v-waitfram-action01 format "x(72)" no-label skip
      391     v-waitfram-action02 format "x(72)" no-label skip
      392     v-waitfram-action03 format "x(72)" no-label skip
      393     B-viewProcInfo
      394     B-WaitFramStop at row 4 col 30
      395     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      396     .
      397   define new global shared variable mBatchMode as logical no-undo init ?.
      398   define variable mFramBachModHandle as handle no-undo.
      399   mFramBachModHandle = frame waitfram:handle.
      400   define variable mFameOldVis as logical no-undo.
      401   define variable mVisCUrentVin as logical no-undo.
      402   if session:batch-mode
      403   then
      404      mBatchMode = yes.
      405   if mBatchMode = ? then do:
      406     mVisCUrentVin = current-window:visible.
      407     mFameOldVis = mFramBachModHandle:visible.
      408     mFramBachModHandle:visible  = yes.
      409     mBatchMode = mFramBachModHandle:visible ne yes.
      410     mFramBachModHandle:visible = mFameOldVis.
      411     current-window:visible = mVisCUrentVin.
      412   end.
      413    if  log-manager:logfile-name ne ?
      414     then DO:
      415         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      416         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      417         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      418     end.
      419   on choose of B-WaitFramStop in frame waitfram
      420   do:
      421     mWaitFramStop = yes.
      422     mWaitFramStopUser = yes.
      423   end.
      424   function waitfram-check-timeout returns logical():
      425      define variable vtime as int64 no-undo.
      426      if mWaitFramStopTimeOut
      427      then
      428         return yes.
      429      vtime = ( now - mWaitFramStartProc ) / 1000 .
      430      if     mWaitFramTimeOut ne ?
      431         and mWaitFramTimeOut ne 0
      432         and mWaitFramTimeOut lt vtime
      433      then do:
      434         mWaitFramStopTimeOut = yes.
      435      end.
      436      return mWaitFramStopTimeOut.
      437   end.
      438   procedure waitfram-hide :
      439     if not session:batch-mode
      440     then do
      441     on error undo, return error return-value
      442     :
      443       pause 0 before-hide .
      444       if not mBatchMode then
      445         hide frame waitfram .
      446     if     not mWaitFramView
      447        and mWaitProcEvent
      448     then
      449       process events .
      450     end.
      451   end procedure.
      452   procedure waitfram-show :
      453     define input  parameter p-message as character no-undo .
      454     define variable v-left-margin as integer   no-undo .
      455     if not session:batch-mode
      456     then do
      457     on error undo, return error return-value
      458     :
      459       if length(p-message) <= 70 then do:
      460         assign
      461           v-left-margin = integer((70 - length(p-message)) / 2)
      462         .
      463         assign
      464           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      465         .
      466         assign
      467           v-waitfram-action01 = " "
      468           v-waitfram-action02 = " "
      469                                    + fill(" ", v-left-margin)
      470                                    + p-message
      471           v-waitfram-action03 = " "
      472         .
      473       end.
      474       else do:
      475         define variable vRindex1 as integer no-undo.
      476         define variable vRindex2 as integer no-undo.
      477         vRindex1 = r-index(p-message," ",70).
      478         if vRindex1 = 0
      479         then
      480            vRindex1 = 70.
      481         if length(p-message)  <= vRindex1 + 70 then do:
      482           assign
      483             v-waitfram-action01 = " "
      484             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      485             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      486           .
      487         end.
      488         else do:
      489           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      490           if vRindex2 <= vRindex1
      491           then
      492              vRindex2 = vRindex1 + 70.
      493           assign
      494             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      495             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      496             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      497           .
      498         end.
      499       end.
      500       B-viewProcInfo:visible   in frame waitfram = no.
      501       B-viewProcInfo:sensitive in frame waitfram = no.
      502       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      503       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      504       if  (   mWaitFramView
      505          or  mWaitProcEvent)
      506          and not mBatchMode
      507       then
      508          display
      509             v-waitfram-action01 skip
      510             v-waitfram-action02 skip
      511             v-waitfram-action03 skip
      512          with frame waitfram .
      513       if     mWaitFramView
      514          then do:
      515             if     mWaitFramInterval ne ?
      516                and not mBatchMode
      517             then
      518                wait-for go of frame waitfram pause mWaitFramInterval.
      519          end.
      520          else
      521             if     mWaitProcEvent
      522                and not mBatchMode
      523             then
      524                process events .
      525     end.
      526   end procedure.
      527      procedure waitfram-show-this:
      528         define input  parameter iInterval as int64 no-undo.
      529         define variable vtime as int64 no-undo.
      530         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      531         mWaitFramInterval = iInterval.
      532         run waitfram-show (substitute("&1&2 &3&4" ,
      533                                       mWaitFramTextBeg ,
      534                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      535                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      536                                       mWaitFramTextEnd
      537                                      )
      538                           ).
      539      end.
      540      procedure WaitFramRunPause:
      541         define input  parameter iInterval as dec no-undo.
      542         define variable vStart  as datetime-tz no-undo.
      543         define variable vend    as datetime-tz no-undo.
      544         define variable vint as int64 no-undo.
      545         define variable vOk as logical no-undo.
      546         vStart = now.
      547         vend   = vStart.
      548         publish "WaitFramPause" (iInterval,output vOk).
      549         vend   =  now.
      550         vint = vend - vStart.
      551         vint = iInterval - vint / 1000.
      552         if     not mWaitFramStop
      553            and (   vint > 0
      554                 or (    not vOk
      555                     and iInterval eq ?
      556                     )
      557                 )
      558         then
      559            run waitfram-show-this (iInterval).
      560         vend   =  now.
      561         vint = vend - vStart.
      562         vint = iInterval - vint / 1000.
      563         if     not mWaitFramStop
      564            and vint > 0
      565         then do:
      566            run gbl/pause.p (vint * 1000).
      567         end.
      568         if iInterval ne ?
      569         then
      570            publish "WaitFramStop".
      571         waitfram-check-timeout().
      572      end.
      573      procedure WaitFramWaitFor:
      574         define input  parameter iInterval as dec no-undo.
      575         assign
      576            mWaitFramStartProc   = now
      577            mWaitFramStopUser    = no
      578            mWaitFramStopTimeOut = no
      579         .
      580         block-wait:
      581         do while not mWaitFramStop:
      582            run WaitFramRunPause (iInterval).
      583            if  waitfram-check-timeout()
      584            then do:
      585               leave block-wait.
      586            end.
      587         end.
      588         run waitfram-hide.
      589      end.
      590   procedure waitfram-join :
      591     define input  parameter p-line-1  as character no-undo .
      592     define input  parameter p-line-2  as character no-undo .
      593     define input  parameter p-line-3  as character no-undo .
      594     define output parameter p-message as character no-undo .
      595     do
      596     on error undo, return error return-value
      597     :
      598       assign
      599         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      600                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      601                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      602       .
      603     end.
      604   end procedure.
      605   function waitfram-join-function returns character
      606     (input p-line-1 as character
      607     ,input p-line-2 as character
      608     ,input p-line-3 as character
      609     ).
      610     define variable v-message as character no-undo .
      611     run waitfram-join in this-procedure
      612       (input  p-line-1
      613       ,input  p-line-2
      614       ,input  p-line-3
      615       ,output v-message
      616       ) .
      617     return v-message .
      618   end function .
