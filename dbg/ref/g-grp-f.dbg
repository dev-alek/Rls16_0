        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-obj-type like ub.clients.obj-type no-undo .
        3   define input parameter p-obj-code like ub.clients.obj-code no-undo .
        4   define input parameter mode as char no-undo.
        5   define input parameter up-code like ub.gds-grp.upper-code no-undo.
        6   define input-output param rid as recid no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Форма для добавления / изменения группы товара".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118     define NEW SHARED temp-table  tt-tax no-undo
      119   field tax-code    like ub.tax.tax-code
      120   FIELD individual  like ub.tax.individual
      121   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
      122   field rate-code   like ub.tax-rate.rate-code
      123   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
      124   FIELD tax-type    like ub.tax.tax-type
      125   field rate-value  like ub.tax-rate-value.rate-value
      126   FIELD tax-rate-gds-rc  as recid
      127   FIELD to-cashdesk like ub.tax.to-cashdesk
      128   FIELD fact-date like ub.tax-rate-value.fact-date
      129   FIELD fact-order like ub.tax-rate-value.fact-order
      130   FIELD next-order like ub.tax-rate-value.fact-order
      131   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
      132   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
      133   FIELD corr-date like ub.tax-rate-gds.corr-date
      134   FIELD corr-time like ub.tax-rate-gds.corr-time
      135   index tax-code is unique primary tax-code fact-order descending rate-code.
      136     define temp-table  output-tax no-undo
      137   field tax-code    like ub.tax.tax-code
      138   FIELD individual  like ub.tax.individual
      139   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
      140   field rate-code   like ub.tax-rate.rate-code
      141   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
      142   FIELD tax-type    like ub.tax.tax-type
      143   field rate-value  like ub.tax-rate-value.rate-value
      144   FIELD tax-rate-gds-rc  as recid
      145   FIELD to-cashdesk like ub.tax.to-cashdesk
      146   FIELD fact-date like ub.tax-rate-value.fact-date
      147   FIELD fact-order like ub.tax-rate-value.fact-order
      148   FIELD next-order like ub.tax-rate-value.fact-order
      149   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
      150   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
      151   FIELD corr-date like ub.tax-rate-gds.corr-date
      152   FIELD corr-time like ub.tax-rate-gds.corr-time
      153   index tax-code is unique primary tax-code fact-order descending rate-code.
      154   define variable vss-include-info0 as character format "X(65)" no-undo
      155   initial "@(#)$Workfile$ $Revision$".
      156   define temp-table temp_grplib_grp no-undo
      157       field sel           as character
      158       field nabor         as character
      159       field full-name     as character
      160       field print-code    as character
      161       field sort-name     as character
      162       field node-code     as integer
      163       field upper-code    as integer
      164       field calc-method   as character
      165       field round-method  as character
      166       field increase-pc   as decimal
      167       field min-marg      as character
      168       field max-marg      as character
      169       field cli-type      as character
      170       field cli-code      as integer
      171       field notcorr      as character
      172       field name          as character
      173       field level         as integer
      174       field mark          as character
      175       index pi is primary unique sort-name
      176       index fn full-name
      177       index nc is unique node-code
      178       index sl sel
      179       index uc upper-code
      180   .
      181   define temp-table temp_grplib_found-grp no-undo
      182       field full-name   as character
      183       field sort-name   as character
      184       field node-code   as integer
      185       field level       as integer
      186       field is-terminal as logical
      187       index pi is primary unique sort-name
      188       index fn full-name
      189       index lv level
      190       index it is-terminal
      191   .
      192   define temp-table temp_found-result-nodelist no-undo
      193       field node-code     as recid
      194       field processed     as logical
      195       field sort-name     as character
      196       field full-name     as character
      197       index pi is primary unique node-code
      198       index ps processed
      199   .
      200   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
      201   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
      202   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
      203   procedure grplib-get-parameters :
      204   define input parameter p-store-type     as character        no-undo.
      205   define input parameter p-store-code     as integer          no-undo.
      206   do
      207   on error undo, return error
      208   :
      209       assign
      210           v-grplib-not-fill-extra-info = no
      211       .
      212   end.
      213   end procedure.
      214   procedure grplib-get-sort-name :
      215   do
      216   on error undo, return error
      217   :
      218   define input parameter p-node-code  as integer      no-undo.
      219   define output parameter p-sort-name as character    no-undo.
      220       define variable v-upper-code    as integer           no-undo.
      221       define buffer buf_gds-grp       for ub.gds-grp.
      222       define buffer buf_upper_gds-grp for ub.gds-grp.
      223       find first buf_gds-grp no-lock
      224            where buf_gds-grp.node-code = p-node-code
      225       no-error.
      226       if not available buf_gds-grp
      227       then do:
      228           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      229       end.
      230       assign
      231           p-sort-name  = ""
      232           v-upper-code = 1
      233       .
      234       do while buf_gds-grp.upper-code <> 0
      235       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      236       :
      237           assign
      238               p-sort-name  = buf_gds-grp.node-name
      239                            + (if p-sort-name <> "" then chr(2) else "")
      240                            + p-sort-name
      241               v-upper-code = buf_gds-grp.upper-code
      242           .
      243           find first buf_gds-grp no-lock
      244                where buf_gds-grp.node-code = v-upper-code
      245           no-error.
      246           if not available buf_gds-grp
      247           then do:
      248               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      249                                   + string( v-upper-code )
      250                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      251           end.
      252       end.
      253   end.
      254   end procedure.
      255   define variable vss-include-info1 as character format "X(65)" no-undo
      256   initial "@(#)$Workfile$ $Revision$".
      257   procedure grplib-get-full-name :
      258      define input parameter p-node-code  as integer      no-undo.
      259      define output parameter p-full-name as character    no-undo.
      260      do
      261   on error undo, return error
      262   :
      263       define variable v-upper-code    as integer           no-undo.
      264       define buffer buf_gds-grp       for ub.gds-grp.
      265       define buffer buf_upper_gds-grp for ub.gds-grp.
      266       find first buf_gds-grp no-lock
      267            where buf_gds-grp.node-code = p-node-code
      268       no-error.
      269       if not available buf_gds-grp
      270       then do:
      271           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      272       end.
      273       assign
      274           p-full-name  = ""
      275           v-upper-code = 1
      276       .
      277       do while buf_gds-grp.upper-code <> 0
      278       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      279       :
      280           assign
      281               p-full-name  = buf_gds-grp.node-name
      282                            + (if p-full-name <> "" then chr(47) else "")
      283                            + p-full-name
      284               v-upper-code = buf_gds-grp.upper-code
      285           .
      286           find first buf_gds-grp no-lock
      287                where buf_gds-grp.node-code = v-upper-code
      288           no-error.
      289           if not available buf_gds-grp
      290           then do:
      291               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      292                                   + string( v-upper-code )
      293                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      294           end.
      295       end.
      296       assign
      297       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      298       .
      299   end.
      300   end .
      301   procedure grplib-get-node-from-full-name :
      302   define input parameter p-full-name as character no-undo .
      303   define output parameter p-node-code as integer no-undo .
      304   define variable v-ii as integer no-undo .
      305   define variable v-upper-code as integer no-undo .
      306   define variable v-root-code as integer no-undo .
      307   define variable v-entry as character no-undo .
      308   define buffer buf_gds-grp       for ub.gds-grp.
      309   do
      310   on error undo, return error
      311   :
      312     find first buf_gds-grp no-lock
      313         where buf_gds-grp.upper-code = 0
      314     no-error .
      315     if not available buf_gds-grp
      316     then do:
      317         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      318     end.
      319     else do:
      320       assign
      321       v-root-code = buf_gds-grp.node-code
      322       .
      323     end.
      324     v-upper-code = v-root-code.
      325     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      326       assign
      327       v-entry = entry(v-ii, p-full-name, chr(47)).
      328       if v-entry = '' then leave.
      329       find first buf_gds-grp no-lock where
      330                 buf_gds-grp.node-name = v-entry
      331             and buf_gds-grp.upper-code = v-upper-code
      332             no-error.
      333       if not available buf_gds-grp then do:
      334         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      335       end.
      336       else do:
      337         p-node-code = buf_gds-grp.node-code.
      338         v-upper-code = buf_gds-grp.node-code.
      339       end.
      340     end.
      341   end.
      342   end .
      343   procedure grplib-get-root-code :
      344   do
      345   on error undo, return error
      346   :
      347   define output parameter p-root-code as integer      no-undo.
      348       define buffer buf_gds-grp       for ub.gds-grp.
      349       find first buf_gds-grp no-lock
      350           where buf_gds-grp.upper-code = 0
      351       no-error .
      352       if not available buf_gds-grp
      353       then do:
      354           undo, return error .
      355       end.
      356       else do:
      357           assign
      358               p-root-code = buf_gds-grp.node-code
      359           .
      360       end.
      361   end.
      362   end procedure.
      363   procedure grplib-find-grp-by-full-name :
      364   do
      365   on error undo, return error
      366   :
      367   define input parameter p-search-name  as character    no-undo.
      368   define input parameter p-fill-path    as logical      no-undo.
      369   define output parameter p-found       as logical      no-undo.
      370       define variable v-upper-code    as integer          no-undo.
      371       define variable v-counter       as integer           no-undo.
      372       define variable v-level         as integer           no-undo.
      373       define variable v-full-name     as character         no-undo.
      374       define variable v-sort-name     as character         no-undo.
      375       define buffer buf_gds-grp       for ub.gds-grp.
      376       assign
      377           p-search-name = replace( p-search-name, chr(47), chr(2) )
      378       .
      379       run grplib-get-root-code ( output v-upper-code ) no-error .
      380       if error-status :error
      381       then do:
      382           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
      383       end.
      384       assign
      385           v-full-name  = ""
      386           v-level      = num-entries( p-search-name, chr(2) )
      387       .
      388       for each temp_grplib_found-grp
      389       :
      390           delete temp_grplib_found-grp.
      391       end.
      392       start-name-analyze:
      393       do v-counter = 1 to v-level
      394       :
      395           if v-counter < v-level
      396           then do:
      397               find first buf_gds-grp no-lock
      398                    where buf_gds-grp.upper-code = v-upper-code
      399                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      400               no-error .
      401               if not available buf_gds-grp
      402               then do:
      403                   assign
      404                       v-full-name  = p-search-name
      405                       v-sort-name  = p-search-name
      406                   .
      407                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      408               end.
      409               else do:
      410                   assign
      411                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
      412                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
      413                       v-upper-code = buf_gds-grp.node-code
      414                   .
      415                   if p-fill-path = yes
      416                   then do:
      417                       create temp_grplib_found-grp.
      418                       assign
      419                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
      420                           temp_grplib_found-grp.sort-name = v-sort-name
      421                           temp_grplib_found-grp.node-code = v-upper-code
      422                           temp_grplib_found-grp.level     = v-counter
      423                       .
      424                   end.
      425               end.
      426           end.
      427           else do:
      428               for each buf_gds-grp no-lock
      429                  where buf_gds-grp.upper-code = v-upper-code
      430                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      431               :
      432                   assign
      433                       p-found = yes
      434                   .
      435                   create temp_grplib_found-grp.
      436                   assign
      437                       temp_grplib_found-grp.full-name = v-full-name
      438                                                           + (if v-full-name = "" then "" else chr(47) )
      439                                                           + buf_gds-grp.node-name + chr(47)
      440                       temp_grplib_found-grp.sort-name = v-sort-name
      441                                                           + ( if v-sort-name = "" then "" else chr(2) )
      442                                                           + buf_gds-grp.node-name
      443                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
      444                       temp_grplib_found-grp.level     = v-level
      445                   .
      446               end.
      447               if p-found = no
      448               then do:
      449                   assign
      450                       v-full-name  = p-search-name
      451                       v-sort-name  = p-search-name
      452                   .
      453                   for each temp_grplib_found-grp
      454                   :
      455                       delete temp_grplib_found-grp.
      456                   end.
      457                   assign
      458                       p-found = no
      459                   .
      460               end.
      461           end.
      462       end.
      463   end.
      464   end procedure.
      465   procedure grplib-find-all-subgroup :
      466   do
      467   on error undo, return error
      468   :
      469   define input parameter p-start-node-code    as integer      no-undo.
      470   define input parameter p-terminal-only      as logical      no-undo.
      471       define variable v-start-full-name   as character     no-undo.
      472       define variable v-start-sort-name   as character     no-undo.
      473       define variable v-not-found         as logical       no-undo.
      474       define variable v-is-terminal       as logical       no-undo.
      475       define buffer buf_gds-grp           for ub.gds-grp.
      476       create temp_found-result-nodelist.
      477       assign
      478           temp_found-result-nodelist.node-code = p-start-node-code
      479           temp_found-result-nodelist.processed = no
      480       .
      481       run grplib-get-full-name in this-procedure (
      482             input p-start-node-code
      483           , output v-start-full-name
      484       ).
      485       run grplib-get-full-name in this-procedure (
      486             input p-start-node-code
      487           , output v-start-sort-name
      488       ).
      489       process-nodes:
      490       do while yes
      491       :
      492           find first temp_found-result-nodelist
      493                where temp_found-result-nodelist.node-code = p-start-node-code
      494           .
      495           assign
      496               temp_found-result-nodelist.processed = yes
      497           .
      498           for each buf_gds-grp no-lock
      499              where buf_gds-grp.upper-code = p-start-node-code
      500           on error undo, return error
      501           :
      502               run grplib-is-terminal in this-procedure (
      503                     input buf_gds-grp.node-code
      504                   , output v-is-terminal
      505               ).
      506               if v-is-terminal = yes
      507               then do:
      508                   create temp_grplib_found-grp.
      509                   assign
      510                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      511                                                           chr(47) + buf_gds-grp.node-name + chr(47)
      512                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      513                                                           chr(2) + buf_gds-grp.node-name + chr(2)
      514                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      515                       temp_grplib_found-grp.is-terminal = yes
      516                   .
      517               end.
      518               else do:
      519                   create temp_found-result-nodelist.
      520                   assign
      521                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
      522                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      523                                                              chr(47) + buf_gds-grp.node-name + chr(47)
      524                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      525                                                              chr(2) + buf_gds-grp.node-name + chr(2)
      526                       temp_found-result-nodelist.processed = no
      527                   .
      528                   if p-terminal-only = no
      529                   then do:
      530                       create temp_grplib_found-grp.
      531                       assign
      532                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      533                                                               chr(47) + buf_gds-grp.node-name + chr(47)
      534                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      535                                                               chr(2) + buf_gds-grp.node-name + chr(2)
      536                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      537                           temp_grplib_found-grp.is-terminal = no
      538                       .
      539                   end.
      540               end.
      541           end.
      542           find first temp_found-result-nodelist
      543                where temp_found-result-nodelist.processed = no
      544           no-error.
      545           if not available temp_found-result-nodelist
      546           then do:
      547               leave process-nodes.
      548           end.
      549           else do:
      550               assign
      551                   p-start-node-code = temp_found-result-nodelist.node-code
      552                   v-start-full-name = temp_found-result-nodelist.full-name
      553                   v-start-sort-name = temp_found-result-nodelist.sort-name
      554               .
      555           end.
      556       end.
      557   end.
      558   end procedure.
      559   procedure grplib-expand-name :
      560   define input parameter p-start-name as character        no-undo.
      561   define output parameter p-end-name  as character        no-undo.
      562       define variable v-is-terminal   as logical      no-undo.
      563       define variable v-found         as character    no-undo.
      564       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
      565   do
      566   for buf_temp_grplib_found-grp
      567   on error undo, return error
      568   :
      569       run grplib-find-grp-by-full-name in this-procedure (
      570             input p-start-name
      571           , input no
      572           , output v-found
      573       ) no-error.
      574       run grplib-get-max-substring in this-procedure (
      575                   input length( p-start-name )
      576                 , output p-end-name
      577       ) no-error .
      578       if error-status :error
      579       then do:
      580           assign
      581               p-end-name = ""
      582           .
      583       end.
      584       else do:
      585           find first temp_grplib_found-grp
      586               where temp_grplib_found-grp.full-name = p-end-name
      587           no-error.
      588           if available temp_grplib_found-grp
      589           then do:
      590               find first buf_temp_grplib_found-grp
      591                   where buf_temp_grplib_found-grp.full-name begins p-end-name
      592                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
      593               no-error.
      594               if not available buf_temp_grplib_found-grp
      595               then do:
      596                   run grplib-is-terminal in this-procedure (
      597                       input temp_grplib_found-grp.node-code
      598                       , output v-is-terminal
      599                   ).
      600               end.
      601           end.
      602       end.
      603   end.
      604   end procedure.
      605   procedure grplib-get-max-substring :
      606   do
      607   on error undo, return error
      608   :
      609   define input parameter p-min-substring-length   as integer      no-undo.
      610   define output parameter p-substring             as character    no-undo.
      611           define variable v-char-counter  as integer           no-undo.
      612           define variable v-current-char  as character         no-undo.
      613           define variable v-names-counter  as integer           no-undo.
      614           define variable v-base-string   as character         no-undo.
      615           assign
      616               v-char-counter  = p-min-substring-length
      617           .
      618           find first temp_grplib_found-grp no-error.
      619           if not available temp_grplib_found-grp
      620           then do:
      621               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
      622           end.
      623           else do:
      624               assign
      625                   v-base-string  = temp_grplib_found-grp.full-name
      626                   v-char-counter = 0
      627               .
      628               counter-block:
      629               do while yes
      630               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
      631               :
      632                   assign
      633                       v-char-counter  = v-char-counter + 1
      634                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      635                       v-names-counter = 0
      636                   .
      637                   compare-block:
      638                   for each temp_grplib_found-grp
      639                   :
      640                       assign
      641                           v-names-counter = v-names-counter + 1
      642                       .
      643                       if v-names-counter = 1
      644                       then do:
      645                           next compare-block.
      646                       end.
      647                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      648                       then do:
      649                           leave counter-block.
      650                       end.
      651                   end.
      652                   if v-names-counter = 1
      653                   then do:
      654                       assign
      655                           p-substring = v-base-string
      656                       .
      657                       return.
      658                   end.
      659               end.
      660               assign
      661                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      662               .
      663           end.
      664   end.
      665   end procedure.
      666   procedure grplib-is-terminal :
      667   do
      668   on error undo, return error "Ошибка процедуры grplib-is-terminal"
      669   :
      670   define input parameter p-node-code      as integer      no-undo.
      671   define output parameter p-is-terminal   as logical      no-undo.
      672       define buffer buf_gds-grp       for ub.gds-grp.
      673       find first buf_gds-grp no-lock
      674           where buf_gds-grp.upper-code = p-node-code
      675       no-error .
      676       if not available buf_gds-grp
      677       then do:
      678           assign
      679               p-is-terminal = yes
      680           .
      681       end.
      682       else do:
      683           assign
      684               p-is-terminal = no
      685           .
      686       end.
      687   end.
      688   end procedure.
      689   procedure grplib-have-goods :
      690   do
      691   on error undo, return error
      692   :
      693   define input parameter p-node-code      as integer      no-undo.
      694   define output parameter p-have-goods   as logical      no-undo.
      695       define buffer buf_goods         for ub.goods.
      696       find first buf_goods no-lock
      697            where buf_goods.grp-code = p-node-code
      698       no-error .
      699       if available buf_goods
      700       then do:
      701           assign
      702               p-have-goods = yes
      703           .
      704       end.
      705       else do:
      706           assign
      707               p-have-goods = no
      708           .
      709       end.
      710   end.
      711   end procedure.
      712   procedure grplib-find-by-substring :
      713   do
      714   on error undo, return error
      715   :
      716   define input parameter p-start-code         as integer      no-undo.
      717   define input parameter p-full-search-string as character    no-undo.
      718   define output parameter p-found-code        as integer      no-undo.
      719   define output parameter p-full-name         as character    no-undo.
      720       define variable v-start-code     as integer           no-undo.
      721       define variable v-found          as logical  init no  no-undo.
      722       define buffer buf_gds-grp       for ub.gds-grp.
      723       search-grp:
      724       for each buf_gds-grp no-lock
      725           where buf_gds-grp.node-code > p-start-code
      726       :
      727           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
      728           then do:
      729               assign
      730                   p-found-code = buf_gds-grp.node-code
      731                   v-found      = yes
      732               .
      733               run grplib-get-full-name in this-procedure (
      734                     input p-found-code
      735                   , output p-full-name
      736               ) no-error .
      737               if error-status :error
      738               then do:
      739                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
      740               end.
      741               leave search-grp.
      742           end.
      743       end.
      744       if v-found = yes
      745       then do:
      746       end.
      747       else do:
      748           assign
      749               p-full-name  = ""
      750               p-found-code = 0
      751           .
      752       end.
      753   end.
      754   end procedure.
      755   procedure grplib-analyze-grp-name :
      756   do
      757   on error undo, return error
      758   :
      759   define input parameter p-grp-name       as character            no-undo.
      760   define input parameter p-upper-code     as integer              no-undo.
      761   define output parameter p-error-message as character init ""    no-undo.
      762       define variable v-char-list     as character    no-undo.
      763       define variable v-char-counter  as integer      no-undo.
      764       define variable v-full-name     as character    no-undo.
      765       if p-grp-name = "" then do:
      766           assign
      767               p-error-message = "Название группы не может быть пустым.".
      768           .
      769       end.
      770       else do:
      771           assign
      772               v-char-list = "47,92,58,63,34,60,62,171,187,183"
      773           .
      774           do v-char-counter = 1 to num-entries( v-char-list )
      775           :
      776               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
      777               then do:
      778                   assign
      779                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
      780                   .
      781                   return.
      782               end.
      783           end.
      784           if p-upper-code > 0
      785           then do:
      786               run grplib-get-full-name in this-procedure (
      787                     input p-upper-code
      788                   , output v-full-name
      789               ) no-error .
      790               if error-status :error
      791               then do:
      792                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
      793               end.
      794               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
      795               then do:
      796                   assign
      797                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
      798                   .
      799               end.
      800           end.
      801       end.
      802   end.
      803   end procedure.
      804   procedure grplib-get-lvl-num :
      805   define input parameter p-node-code  as integer      no-undo.
      806   define output parameter p-lvl-num   as integer      no-undo.
      807       define variable v-full-name    as character    no-undo.
      808   do
      809   on error undo, return error
      810   :
      811       run grplib-get-full-name in this-procedure (
      812             input p-node-code
      813           , output v-full-name
      814       ).
      815       assign
      816           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
      817       .
      818       if p-lvl-num = -1
      819       then do:
      820           assign
      821               p-lvl-num = 0
      822           .
      823       end.
      824   end.
      825   end procedure.
      826   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      827   procedure grp-obj-write :
      828   do
      829   on error undo, return error
      830   :
      831   define input parameter p-node-code  like ub.gds-grp-obj.node-code      no-undo.
      832   define input parameter p-host-code  as integer                          no-undo.
      833   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      834   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      835   define input parameter p-min-increase like ub.gds-grp-obj.min-increase  no-undo.
      836   define input parameter p-max-increase like ub.gds-grp-obj.max-increase  no-undo.
      837   define input parameter p-increase-pc like ub.gds-grp-obj.increase-pc  no-undo.
      838   define input parameter p-calc-method like ub.gds-grp-obj.calc-method no-undo .
      839   define input parameter p-round-method like ub.gds-grp-obj.round-method no-undo .
      840   define input parameter p-round-coef like ub.gds-grp-obj.round-coef no-undo .
      841   define input parameter p-cli-type   like ub.clients.obj-type            no-undo.
      842   define input parameter p-cli-code   like ub.clients.obj-code            no-undo.
      843   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
      844       find first buf_gds-grp-obj exclusive-lock
      845            where buf_gds-grp-obj.node-code  = p-node-code
      846              and buf_gds-grp-obj.host-code  = p-host-code
      847              and buf_gds-grp-obj.obj-type   = p-obj-type
      848              and buf_gds-grp-obj.obj-code   = p-obj-code
      849       no-error.
      850       if not available buf_gds-grp-obj
      851       then do:
      852           create buf_gds-grp-obj.
      853           assign
      854                   buf_gds-grp-obj.node-code  = p-node-code
      855                   buf_gds-grp-obj.host-code  = p-host-code
      856                   buf_gds-grp-obj.obj-type   = p-obj-type
      857                   buf_gds-grp-obj.obj-code   = p-obj-code
      858           .
      859       end.
      860       assign
      861       buf_gds-grp-obj.min-increase = p-min-increase
      862       buf_gds-grp-obj.max-increase = p-max-increase
      863       buf_gds-grp-obj.increase-pc = p-increase-pc
      864       buf_gds-grp-obj.calc-method = p-calc-method
      865       buf_gds-grp-obj.round-method = p-round-method
      866       buf_gds-grp-obj.round-coef = p-round-coef
      867       buf_gds-grp-obj.cli-type   = p-cli-type
      868       buf_gds-grp-obj.cli-code   = p-cli-code
      869       .
      870   end.
      871   end procedure.
      872   procedure grp-obj-margin-value :
      873   do
      874   on error undo, return error
      875   :
      876   define input parameter p-node-code as integer      no-undo.
      877   define input parameter p-obj-type  as character    no-undo.
      878   define input parameter p-obj-code  as integer      no-undo.
      879   define output parameter p-min-value as decimal      no-undo init ?.
      880   define output parameter p-max-value as decimal      no-undo init ?.
      881   define output parameter p-increase-pc as decimal      no-undo init ?.
      882   define output parameter p-round-method as character no-undo init "":U.
      883   define output parameter p-base as decimal no-undo init ?.
      884   define output parameter p-range-margin     as integer      no-undo.
      885   define output parameter p-exists-margin    as logical      no-undo.
      886   define output parameter p-range-increase     as integer      no-undo.
      887   define output parameter p-exists-increase    as logical      no-undo.
      888   define output parameter p-range-rmethod     as integer no-undo .
      889   define output parameter p-exists-rmethod    as logical no-undo .
      890   define variable v-host-code as integer      no-undo.
      891   DEFINE VARIABLE v-found as logical no-undo .
      892   DEFINE VARIABLE v-exists as logical no-undo .
      893   DEFINE VARIABLE v-range as integer no-undo .
      894   DEFINE VARIABLE jj as integer no-undo .
      895   DEFINE VARIABLE v-margin-found as logical no-undo .
      896   DEFINE VARIABLE v-increase-found as logical no-undo .
      897   DEFINE VARIABLE v-min-value as decimal      no-undo.
      898   DEFINE VARIABLE v-max-value as decimal      no-undo.
      899   DEFINE VARIABLE v-increase-pc as decimal      no-undo.
      900   define variable v-round-method as character no-undo .
      901   define variable v-base as decimal no-undo .
      902   define variable v-print-code as character no-undo .
      903   define buffer buf_gds-grp for ub.gds-grp.
      904   find first buf_gds-grp no-lock where
      905              buf_gds-grp.node-code = p-node-code no-error .
      906   if not avail buf_gds-grp and p-node-code <> 0 then do:
      907     message
      908       vss-workfile vss-revision vss-description
      909       skip "Не удалось найти группу товаров с кодом" p-node-code
      910       view-as alert-box error .
      911     undo, return error .
      912   end.
      913   if p-obj-type <> '' then do:
      914   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      915   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      916     (input  p-obj-type
      917     ,input  p-obj-code
      918     ,output v-host-code
      919     ) no-error .
      920     if error-status :error
      921     then do:
      922         message
      923           vss-workfile vss-revision vss-description
      924           skip "Не удалось найти фирму объекта"
      925           skip p-obj-type p-obj-code
      926           skip return-value
      927           skip trim(error-status :get-message(1))
      928               trim(error-status :get-message(2))
      929               trim(error-status :get-message(3))
      930               trim(error-status :get-message(4))
      931               trim(error-status :get-message(5))
      932         view-as alert-box error.
      933         undo, return error .
      934     end.
      935   end.
      936   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      937   do while v-found = no and jj < 2:
      938     if v-range <> 3 then do:
      939       find first buf_gds-grp-obj no-lock
      940           where buf_gds-grp-obj.node-code = p-node-code
      941             and buf_gds-grp-obj.host-code = v-host-code
      942             and buf_gds-grp-obj.obj-type  = p-obj-type
      943             and buf_gds-grp-obj.obj-code  = p-obj-code
      944       no-error .
      945     end.
      946     if v-range = 3 or not available buf_gds-grp-obj
      947     then do:
      948        if v-range <> 2 then do:
      949           find first buf_gds-grp-obj no-lock
      950               where buf_gds-grp-obj.node-code = p-node-code
      951                 and buf_gds-grp-obj.host-code = v-host-code
      952                 and buf_gds-grp-obj.obj-type  = ""
      953                 and buf_gds-grp-obj.obj-code  = 0
      954           no-error .
      955         end.
      956         if v-range = 2 or not available buf_gds-grp-obj
      957         then do:
      958             if v-range <> 1 then do:
      959               find first buf_gds-grp-obj no-lock
      960                   where buf_gds-grp-obj.node-code = p-node-code
      961                   and buf_gds-grp-obj.host-code = 0
      962                   and buf_gds-grp-obj.obj-type  = ""
      963                   and buf_gds-grp-obj.obj-code  = 0
      964               no-error .
      965             end.
      966             if v-range = 1 or not available buf_gds-grp-obj
      967             then do:
      968                 assign
      969                     v-exists = no
      970                 .
      971             end.
      972             else do:
      973                 assign
      974                     v-exists = yes
      975                     v-range = 1
      976                 .
      977             end.
      978         end.
      979         else do:
      980             assign
      981                 v-exists = yes
      982                 v-range  = 2
      983             .
      984         end.
      985     end.
      986     else do:
      987         assign
      988             v-exists = yes
      989             v-range  = 3
      990         .
      991     end.
      992     if available buf_gds-grp-obj
      993     then do:
      994       assign
      995       v-min-value    = buf_gds-grp-obj.min-increase
      996       v-max-value    = buf_gds-grp-obj.max-increase
      997       v-increase-pc  = buf_gds-grp-obj.increase-pc
      998       v-round-method = buf_gds-grp-obj.round-method
      999       v-base         = buf_gds-grp-obj.round-coef
     1000       .
     1001       assign
     1002       p-exists-margin = (if v-min-value <> ? and v-max-value <> ? and p-min-value = ?
     1003                           then yes
     1004                           else p-exists-margin)
     1005       p-range-margin = if p-exists-margin and p-min-value = ?
     1006                         then v-range
     1007                         else p-range-margin
     1008       p-min-value   =  if p-exists-margin and  p-min-value = ?
     1009                         then v-min-value
     1010                         else p-min-value
     1011       p-max-value   =  if p-exists-margin and  p-max-value = ?
     1012                         then v-max-value
     1013                         else p-max-value
     1014       p-exists-increase = (if v-increase-pc <> ? and p-increase-pc = ?
     1015                           then yes
     1016                           else p-exists-increase)
     1017       p-range-increase = if p-exists-increase and p-increase-pc = ?
     1018                         then v-range
     1019                         else p-range-increase
     1020       p-increase-pc = (if p-exists-increase and p-increase-pc = ?
     1021                         then v-increase-pc
     1022                         else p-increase-pc)
     1023       p-exists-rmethod = if v-round-method <> "":U and p-round-method = "":U
     1024                           then yes
     1025                           else p-exists-rmethod
     1026       p-range-rmethod = (if p-exists-rmethod and p-round-method = "":U
     1027                           then v-range
     1028                           else p-range-rmethod)
     1029       p-round-method  = (if p-exists-rmethod and p-round-method = "":U
     1030                           then v-round-method
     1031                           else p-round-method)
     1032       p-base          = (if p-exists-rmethod and p-base = ?
     1033                           then v-base
     1034                           else p-base)
     1035       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod) or (v-range <= 1)
     1036       jj = jj + 1
     1037       .
     1038     end.
     1039     else do:
     1040       assign
     1041       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod ) or (v-range <= 1)
     1042       jj = jj + 1
     1043       .
     1044     end.
     1045   end.
     1046   end.
     1047   end procedure.
     1048   procedure grp-obj-income-cli-value :
     1049   do
     1050   on error undo, return error
     1051   :
     1052   define input parameter p-node-code as integer      no-undo.
     1053   define input parameter p-obj-type  as character    no-undo.
     1054   define input parameter p-obj-code  as integer      no-undo.
     1055   define output parameter p-cli-type as character    no-undo init ?.
     1056   define output parameter p-cli-code as integer      no-undo init ?.
     1057   define output parameter p-range-income-cli     as integer      no-undo.
     1058   define output parameter p-exists-income-cli    as logical      no-undo.
     1059   define variable v-host-code as integer      no-undo.
     1060   DEFINE VARIABLE v-found as logical no-undo .
     1061   DEFINE VARIABLE v-exists as logical no-undo .
     1062   DEFINE VARIABLE v-range as integer no-undo .
     1063   DEFINE VARIABLE jj as integer no-undo .
     1064   DEFINE VARIABLE v-income-cli-found as logical no-undo .
     1065   DEFINE VARIABLE v-cli-type-value as char      no-undo.
     1066   DEFINE VARIABLE v-cli-code-value as int      no-undo.
     1067   define buffer buf_gds-grp for ub.gds-grp.
     1068   find first buf_gds-grp no-lock where
     1069              buf_gds-grp.node-code = p-node-code no-error .
     1070   if not avail buf_gds-grp and p-node-code <> 0 then do:
     1071     message
     1072       vss-workfile vss-revision vss-description
     1073       skip "Не удалось найти группу товаров с кодом" p-node-code
     1074       view-as alert-box error .
     1075     undo, return error .
     1076   end.
     1077   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1078   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1079     (input  p-obj-type
     1080     ,input  p-obj-code
     1081     ,output v-host-code
     1082     ) no-error .
     1083   if error-status :error
     1084   then do:
     1085       message
     1086         vss-workfile vss-revision vss-description
     1087         skip "Не удалось найти фирму объекта"
     1088         skip p-obj-type p-obj-code
     1089         skip return-value
     1090         skip trim(error-status :get-message(1))
     1091              trim(error-status :get-message(2))
     1092              trim(error-status :get-message(3))
     1093              trim(error-status :get-message(4))
     1094              trim(error-status :get-message(5))
     1095       view-as alert-box error.
     1096       undo, return error .
     1097   end.
     1098   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     1099   do while v-found = no and jj < 2:
     1100     if v-range <> 3 then do:
     1101       find first buf_gds-grp-obj no-lock
     1102           where buf_gds-grp-obj.node-code = p-node-code
     1103             and buf_gds-grp-obj.host-code = v-host-code
     1104             and buf_gds-grp-obj.obj-type  = p-obj-type
     1105             and buf_gds-grp-obj.obj-code  = p-obj-code
     1106       no-error .
     1107     end.
     1108     if v-range = 3 or not available buf_gds-grp-obj
     1109     then do:
     1110        if v-range <> 2 then do:
     1111           find first buf_gds-grp-obj no-lock
     1112               where buf_gds-grp-obj.node-code = p-node-code
     1113                 and buf_gds-grp-obj.host-code = v-host-code
     1114                 and buf_gds-grp-obj.obj-type  = ""
     1115                 and buf_gds-grp-obj.obj-code  = 0
     1116           no-error .
     1117         end.
     1118         if v-range = 2 or not available buf_gds-grp-obj
     1119         then do:
     1120             if v-range <> 1 then do:
     1121               find first buf_gds-grp-obj no-lock
     1122                   where buf_gds-grp-obj.node-code = p-node-code
     1123                   and buf_gds-grp-obj.host-code = 0
     1124                   and buf_gds-grp-obj.obj-type  = ""
     1125                   and buf_gds-grp-obj.obj-code  = 0
     1126               no-error .
     1127             end.
     1128             if v-range = 1 or not available buf_gds-grp-obj
     1129             then do:
     1130                 assign
     1131                     v-exists = no
     1132                 .
     1133             end.
     1134             else do:
     1135                 assign
     1136                     v-exists = yes
     1137                     v-range = 1
     1138                 .
     1139             end.
     1140         end.
     1141         else do:
     1142             assign
     1143                 v-exists = yes
     1144                 v-range  = 2
     1145             .
     1146         end.
     1147     end.
     1148     else do:
     1149         assign
     1150             v-exists = yes
     1151             v-range  = 3
     1152         .
     1153     end.
     1154     if available buf_gds-grp-obj
     1155     then do:
     1156       assign
     1157       v-cli-type-value    = buf_gds-grp-obj.cli-type
     1158       v-cli-code-value    = buf_gds-grp-obj.cli-code
     1159       .
     1160       assign
     1161       p-exists-income-cli = (if v-cli-type-value <> ? and v-cli-code-value <> ? and p-cli-type = ?
     1162                           then yes
     1163                           else p-exists-income-cli)
     1164       p-range-income-cli = if p-exists-income-cli and p-cli-type = ?
     1165                         then v-range
     1166                         else p-range-income-cli
     1167       p-cli-type   =  if p-exists-income-cli and  p-cli-type = ?
     1168                         then v-cli-type-value
     1169                         else p-cli-type
     1170       p-cli-code   =  if p-exists-income-cli and  p-cli-code = ?
     1171                         then v-cli-code-value
     1172                         else p-cli-code
     1173       v-found =  (p-exists-income-cli ) or (v-range <= 1)
     1174       jj = jj + 1
     1175       .
     1176     end.
     1177     else do:
     1178       assign
     1179       v-found =  (p-exists-income-cli  ) or (v-range <= 1)
     1180       jj = jj + 1
     1181       .
     1182     end.
     1183   end.
     1184   end.
     1185   end procedure.
     1186   define variable grp-code like ub.gds-grp.node-code no-undo.
     1187   define variable v-margins-range     as integer           no-undo.
     1188   define variable v-margins-exists    as logical           no-undo.
     1189   define variable v-increase-range    as integer           no-undo.
     1190   define variable v-increase-exists   as logical           no-undo.
     1191   define variable v-min-marg          as decimal           no-undo.
     1192   define variable v-max-marg          as decimal           no-undo.
     1193   define variable v-increase-pc       as decimal           no-undo.
     1194   define variable v-round-method      as character         no-undo .
     1195   define variable v-rmethod-range     as integer           no-undo .
     1196   define variable v-rmethod-exists    as logical           no-undo .
     1197   define variable v-base              as decimal           no-undo .
     1198   define variable v-round-method-str  as character         no-undo .
     1199   define variable v-host-code         like ub.sysconf.host-code no-undo .
     1200   define buffer upper_gds-grp for ub.gds-grp.
     1201   DEFINE BUTTON b-exit AUTO-GO
     1202        LABEL "&Ввод ":L
     1203        SIZE 10 BY 1.
     1204   DEFINE BUTTON b-quit AUTO-END-KEY
     1205        LABEL "&Отмена":L
     1206        SIZE 10 BY 1.
     1207   DEFINE BUTTON b-help AUTO-END-KEY
     1208        LABEL "Помо&щь":L
     1209        SIZE 10 BY 1.
     1210   DEFINE BUTTON b-tax
     1211        LABEL "&Налоги":L
     1212        SIZE 10 BY 1.
     1213   DEFINE BUTTON b-marg
     1214        LABEL "&Параметры на объектах":L
     1215        SIZE 40 BY 1.
     1216   DEFINE VARIABLE f-base AS DECIMAL FORMAT "->>>>9.99":U INITIAL 0
     1217        VIEW-AS FILL-IN
     1218        SIZE 15.38 BY 1
     1219        NO-UNDO.
     1220   DEFINE VARIABLE S-round-method AS CHARACTER
     1221        VIEW-AS SELECTION-LIST SINGLE SCROLLBAR-VERTICAL
     1222        SIZE 23.5 BY 5
     1223        BGCOLOR 15
     1224        NO-UNDO.
     1225   DEFINE RECTANGLE RECT-1
     1226        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1227        SIZE 92 BY 10.25.
     1228   DEFINE FRAME d-g-grp-f
     1229   b-exit AT ROW 1 COL 1
     1230   b-quit AT ROW 1 COL 11
     1231   b-tax  AT ROW 1 COL 21
     1232   b-marg  AT ROW 1 COL 31
     1233   b-help AT ROW 1 COL 81
     1234   ub.gds-grp.node-name AT ROW 2.5 COL 18 COLON-ALIGNED LABEL "Название" VIEW-AS FILL-IN SIZE 50 BY 1 format "X(90)"
     1235   "Правило назначения продажной цены для автопереоценок" VIEW-AS TEXT
     1236             SIZE 59 BY 1 AT ROW 4.1 COL 3 WIDGET-ID 4  FGCOLOR 4
     1237   "Метод расчета" VIEW-AS TEXT
     1238   SIZE 13 BY 1 AT ROW 5.1 COL 6 WIDGET-ID 4
     1239   "баз. цены:" VIEW-AS TEXT
     1240   SIZE 10 BY 1 AT ROW 6 COL 9 WIDGET-ID 4
     1241   ub.gds-grp.calc-method AT row 5.3 col 18 colon-aligned
     1242             no-label
     1243             VIEW-AS SELECTION-LIST SINGLE SCROLLBAR-VERTICAL
     1244             LIST-ITEMS
     1245             'Учетная':U,'Учет-резерв':U,'Накладная':U,'Накл-безНДС':U,'Учет-безНДС':U,'Учет+накл':U,'Уч+накл-НДС':U,'Не-считать':U,'Производит':U,'Произв-НДС':U,'ПорогПр-НДС':U,'ПорогПр+НДС':U
     1246             SIZE 30 BY 5
     1247   S-round-method AT ROW 5.3 col 66 COLON-ALIGNED
     1248             LABEL "Метод округления"
     1249   ub.gds-grp.increase-pc AT row 10.5 col 18 COLON-ALIGNED
     1250             LABEL "Наценка"
     1251             VIEW-AS FILL-IN
     1252             SIZE 10 BY 1
     1253   RECT-1 AT ROW 4 COL 1.5 WIDGET-ID 2
     1254   f-base AT ROW 10.5 COL 68 COLON-ALIGNED LABEL "База округления"
     1255   ub.gds-grp.print-code AT ROW 12.5 COL 18 COLON-ALIGNED LABEL "Код"
     1256             VIEW-AS FILL-IN
     1257             SIZE 30 BY 1
     1258   SPACE (5) SKIP (0) WITH VIEW-AS DIALOG-BOX SIDE-LABELS THREE-D SCROLLABLE DEFAULT-BUTTON b-exit.
     1259   ASSIGN FRAME d-g-grp-f:SCROLLABLE = FALSE.
     1260   ON GO OF FRAME d-g-grp-f DO:
     1261   DEFINE VARIABLE varnode-code like ub.gds-grp.node-code no-undo .
     1262   DEFINE VARIABLE varupper-code like ub.gds-grp.upper-code no-undo .
     1263   do on endkey undo, return no-apply on error undo, return no-apply on stop undo, return no-apply:
     1264   if mode = 'ДОБАВЛЕНИЕ':U then do:
     1265     assign
     1266     varnode-code = 0
     1267     varupper-code = up-code
     1268     .
     1269   end.
     1270   else do:
     1271     assign
     1272     varnode-code = ub.gds-grp.node-code
     1273     varupper-code = ub.gds-grp.upper-code
     1274     .
     1275   end.
     1276   assign
     1277   s-round-method
     1278   f-base
     1279   .
     1280     run ref/gdsgrp01.p (
     1281                     input mode
     1282                     ,input no
     1283                     ,input no
     1284                     ,input no
     1285                     ,input-output  varnode-code
     1286                     ,input-output  varupper-code
     1287                     ,input frame d-g-grp-f gds-grp.node-name
     1288                     ,input frame d-g-grp-f gds-grp.calc-method
     1289                     ,input frame d-g-grp-f gds-grp.increase-pc
     1290                     ,input frame d-g-grp-f gds-grp.print-code
     1291                     ,input s-round-method
     1292                     ,input f-base
     1293                     ,output rid
     1294                     ) no-error .
     1295     if error-status:error then UNDO, return no-apply.
     1296     run ref/dtaxgrpu.p (
     1297                     input varnode-code
     1298                    ,input varupper-code
     1299                    ,input yes
     1300                    ,input 0
     1301                    ,input "":U
     1302                    ,input 0
     1303                     ) no-error .
     1304     if error-status:error then undo, return no-apply.
     1305   end.
     1306   END.
     1307   ON CHOOSE OF b-tax in FRAME d-g-grp-f DO:
     1308     run proc-b-tax in this-procedure ( input parparentproc
     1309                                       ,input v-host-code
     1310                                       ,input p-obj-type
     1311                                       ,input p-obj-code
     1312                                       ,buffer ub.gds-grp
     1313                                       ,input mode) no-error.
     1314     if error-status:error then return no-apply.
     1315   END.
     1316   ON VALUE-CHANGED OF S-round-method IN FRAME d-g-grp-f
     1317   DO:
     1318     assign
     1319     S-round-method
     1320     .
     1321     if LOOKUP(s-round-method, 'Произвольно,Вверх,Коэффициент,9-99окончание':U) > 0 then do:
     1322       display
     1323       f-base
     1324       with frame d-g-grp-f.
     1325       if mode = 'ДОБАВЛЕНИЕ':U then
     1326       enable
     1327       f-base
     1328       with frame d-g-grp-f.
     1329     end.
     1330     else do:
     1331       hide
     1332       f-base
     1333       in frame d-g-grp-f.
     1334       disable
     1335       f-base
     1336       with frame d-g-grp-f.
     1337     end.
     1338   END.
     1339   ON CHOOSE OF b-marg in FRAME d-g-grp-f DO:
     1340       run ref/pr-marg.w (
     1341             input parparentproc
     1342           , input ub.gds-grp.node-code
     1343       ) no-error.
     1344       if error-status :error
     1345       then do:
     1346           message
     1347             vss-workfile vss-revision vss-description
     1348             skip "Ошибка при установке диапазона торговых наценок"
     1349             skip return-value
     1350             skip trim(error-status :get-message(1))
     1351                  trim(error-status :get-message(2))
     1352                  trim(error-status :get-message(3))
     1353                  trim(error-status :get-message(4))
     1354                  trim(error-status :get-message(5))
     1355           view-as alert-box error.
     1356           undo, return no-apply.
     1357       end.
     1358       run grp-obj-margin-value in this-procedure (
     1359                               input gds-grp.node-code
     1360                               , input p-obj-type
     1361                               , input p-obj-code
     1362                               , output v-min-marg
     1363                               , output v-max-marg
     1364                               , output v-increase-pc
     1365                               , output v-round-method
     1366                               , output v-base
     1367                               , output v-margins-range
     1368                               , output v-margins-exists
     1369                               , output v-increase-range
     1370                               , output v-increase-exists
     1371                               , output v-rmethod-range
     1372                               , output v-rmethod-exists
     1373       ) no-error .
     1374       display
     1375       v-increase-pc @ gds-grp.increase-pc
     1376       with frame d-g-grp-f.
     1377       assign
     1378       s-round-method:screen-value = v-round-method
     1379       f-base = v-base
     1380       .
     1381       APPLY "VALUE-CHANGED" to s-round-method.
     1382   END.
     1383   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1384   on help of frame d-g-grp-f
     1385   do:
     1386     run gbl/app_help.p
     1387       (input this-procedure :file-name
     1388       ,input ''
     1389       ,input ?
     1390       ) no-error.
     1391     if error-status :error then do:
     1392       message
     1393         "Ошибка при вызове помощи"
     1394         error-status :get-message(1)
     1395         view-as alert-box .
     1396     end.
     1397   end.
     1398   run minbtn-set in this-procedure .
     1399   on choose of b-help in frame d-g-grp-f
     1400   do:
     1401     apply "help":u to frame d-g-grp-f .
     1402   end.
     1403   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1404   procedure minbtn-set :
     1405       do
     1406           on error undo, return error return-value
     1407           :
     1408           define variable ii              as integer       no-undo .
     1409           define variable fh              as widget-handle no-undo .
     1410           define variable hh              as widget-handle no-undo .
     1411           define variable v-h             as handle        extent 4 no-undo .
     1412           define variable v-name-button   as character     no-undo .
     1413           define variable v-help-old-x    as decimal       no-undo .
     1414           define variable v-help-old-y    as decimal       no-undo .
     1415           define variable v-help-old-size as decimal       no-undo .
     1416           define variable v-frame-width   as decimal       no-undo .
     1417           define variable jj              as integer       no-undo .
     1418           do
     1419               on error undo, return error
     1420               :
     1421               assign
     1422                   v-frame-width = frame d-g-grp-f:width - 0.3
     1423                   fh            = frame d-g-grp-f:first-child
     1424                   hh            = fh:first-child
     1425                   ii            = 1
     1426                   .
     1427               do while valid-handle(hh):
     1428                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1429                   do:
     1430                       case lc(hh:name) :
     1431                           when "b-help" then
     1432                               do:
     1433                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1434                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1435                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1436                                   hh:TOOLTIP = "Помощь" .
     1437                                   v-help-old-x = hh:column .
     1438                                   v-help-old-y = hh:row    .
     1439                                   v-help-old-size = hh:width .
     1440                                   hh:width-chars = 2.5 .
     1441                               end.
     1442                           when "b-print" then
     1443                               do:
     1444                                   hh:load-image("cmp/b-print.bmp":u) .
     1445                                   hh:TOOLTIP = "Печать" .
     1446                                   v-h[ii] = hh:handle .
     1447                                   ii = ii + 1 .
     1448                                   hh:width-chars = 3 .
     1449                               end.
     1450                           when "b-history" or
     1451                           when "b-hist" then
     1452                               do:
     1453                                   hh:load-image("cmp/b-hist.bmp":u) .
     1454                                   hh:TOOLTIP = "История" .
     1455                                   v-h[ii] = hh:handle .
     1456                                   ii = ii + 1 .
     1457                                   hh:width-chars = 3 .
     1458                               end.
     1459                           when "b-sch" then
     1460                               do:
     1461                                   hh:load-image("cmp/b-sch.bmp":u) .
     1462                                   hh:TOOLTIP = "Установка Фильтра" .
     1463                                   v-h[ii] = hh:handle .
     1464                                   ii = ii + 1 .
     1465                                   hh:width-chars = 3 .
     1466                               end.
     1467                           when "b-hist-user" then
     1468                               do:
     1469                                   hh:load-image("cmp/b-hist.bmp":u) .
     1470                                   hh:TOOLTIP = "История пользователя" .
     1471                                   ii = ii + 1 .
     1472                               end.
     1473                       end case.
     1474                   end.
     1475                   hh = hh:next-sibling.
     1476               end.
     1477               b-help:column = v-frame-width - b-help:width-chars.
     1478               jj = 0.
     1479               repeat ii = 4 to 1 by -1 :
     1480                   if valid-handle (v-h[ii] ) then
     1481                   do:
     1482                       jj  = jj + 1 .
     1483                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1484                       v-h[ii]:row    = v-help-old-y .
     1485                   end.
     1486               end.
     1487           end.
     1488       end.
     1489   end procedure.
     1490   IF CURRENT-WINDOW:WINDOW-STATE = WINDOW-MINIMIZED
     1491   THEN CURRENT-WINDOW:WINDOW-STATE = WINDOW-NORMAL.
     1492   ON WINDOW-CLOSE OF FRAME d-g-grp-f APPLY "END-ERROR":U TO SELF.
     1493   define variable p-list as character no-undo .
     1494   assign
     1495   s-round-method:list-items in frame d-g-grp-f  = '9-окончание,9-99окончание,Без-дробных,Произвольно,Вверх,Коэффициент,Отключено':U.
     1496   if mode = 'ДОБАВЛЕНИЕ':U then do:
     1497     find upper_gds-grp no-lock where
     1498          upper_gds-grp.node-code = up-code no-error .
     1499     if not avail upper_gds-grp then do:
     1500       message
     1501       vss-workfile vss-revision vss-description skip
     1502       "Не найдена группа с кодом"
     1503       up-code
     1504       view-as alert-box error .
     1505       return error .
     1506     end.
     1507   end.
     1508   if mode = 'ИЗМЕНЕНИЕ':U then do:
     1509     find gds-grp where recid (gds-grp) =  rid.
     1510   end.
     1511   rid = ?.
     1512   run str/pr-listv.p (
     1513                    input 'Учетная,Учет-резерв,Накладная,Накл-безНДС,Учет-безНДС,Учет+накл,Уч+накл-НДС,Не-считать,Производит,Произв-НДС,ПорогПр-НДС,ПорогПр+НДС,Спецификация':U
     1514                   ,input (if mode = 'ИЗМЕНЕНИЕ':U
     1515                           then gds-grp.calc-method
     1516                           else "":U)
     1517                   ,output p-list) .
     1518   gds-grp.calc-method:list-items in frame d-g-grp-f  = p-list .
     1519   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1520   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1521     (input  p-obj-type
     1522     ,input  p-obj-code
     1523     ,output v-host-code
     1524     )  .
     1525   run ref/dtaxgrps.p (if avail gds-grp then gds-grp.node-code else 0,
     1526                  up-code,
     1527                  v-host-code,
     1528                  p-obj-type,
     1529                  p-obj-code) no-error.
     1530   if error-status:error then do:
     1531     message
     1532     error-status:get-message(1) skip
     1533     return-value
     1534     view-as alert-box error .
     1535     return error.
     1536   end.
     1537   frame d-g-grp-f:title = "ГРУППА ТОВАРОВ   -    " + mode.
     1538   if available gds-grp then do:
     1539       run grp-obj-margin-value in this-procedure (
     1540                               input gds-grp.node-code
     1541                               , input p-obj-type
     1542                               , input p-obj-code
     1543                               , output v-min-marg
     1544                               , output v-max-marg
     1545                               , output v-increase-pc
     1546                               , output v-round-method
     1547                               , output v-base
     1548                               , output v-margins-range
     1549                               , output v-margins-exists
     1550                               , output v-increase-range
     1551                               , output v-increase-exists
     1552                               , output v-rmethod-range
     1553                               , output v-rmethod-exists
     1554       ) no-error .
     1555       if error-status:error then do:
     1556         return error .
     1557       end.
     1558     disp
     1559     gds-grp.node-name
     1560     gds-grp.calc-method
     1561     v-increase-pc @ gds-grp.increase-pc
     1562     gds-grp.print-code
     1563     WITH FRAME d-g-grp-f.
     1564     assign
     1565     s-round-method:screen-value = v-round-method
     1566     f-base = v-base
     1567     .
     1568     APPLY "VALUE-CHANGED" to s-round-method.
     1569   end.
     1570   enable
     1571   gds-grp.node-name
     1572   gds-grp.calc-method
     1573   gds-grp.increase-pc  when mode = 'ДОБАВЛЕНИЕ':U
     1574   s-round-method when mode = 'ДОБАВЛЕНИЕ':U
     1575   gds-grp.print-code
     1576   b-exit
     1577   b-quit
     1578   b-tax
     1579   b-help WITH FRAME d-g-grp-f.
     1580   if mode = 'ИЗМЕНЕНИЕ':U then do:
     1581     run enable-button-marg in this-procedure ( input gds-grp.node-code ) no-error.
     1582     grp-code = gds-grp.node-code.
     1583     if (v-round-method = ''
     1584     or v-round-method = ?)
     1585     and not can-find(first ub.gds-grp where ub.gds-grp.upper-code = grp-code)
     1586     then do:
     1587       assign
     1588       v-round-method = 'Отключено':U.
     1589       s-round-method:screen-value = v-round-method.
     1590     end.
     1591   end.
     1592   if mode = 'ДОБАВЛЕНИЕ':U then do:
     1593     run grp-obj-margin-value in this-procedure (
     1594                             input upper_gds-grp.node-code
     1595                             , input p-obj-type
     1596                             , input p-obj-code
     1597                             , output v-min-marg
     1598                             , output v-max-marg
     1599                             , output v-increase-pc
     1600                             , output v-round-method
     1601                             , output v-base
     1602                             , output v-margins-range
     1603                             , output v-margins-exists
     1604                             , output v-increase-range
     1605                             , output v-increase-exists
     1606                             , output v-rmethod-range
     1607                             , output v-rmethod-exists
     1608     ) no-error .
     1609     if error-status:error or v-rmethod-exists = no then do:
     1610       assign
     1611       v-round-method = 'Отключено':U
     1612       .
     1613     end.
     1614     assign
     1615     gds-grp.calc-method:screen-value = upper_gds-grp.calc-method
     1616     s-round-method:screen-value = v-round-method
     1617     f-base = v-base
     1618     no-error .
     1619     APPLY "VALUE-CHANGED" to S-round-method.
     1620   end.
     1621   WAIT-FOR GO OF FRAME d-g-grp-f.
     1622   RUN disable_UI.
     1623   PROCEDURE disable_UI :
     1624     HIDE FRAME d-g-grp-f.
     1625   END PROCEDURE.
     1626   PROCEDURE enable-button-marg :
     1627   do
     1628   on error undo, return error
     1629   :
     1630   define input parameter p-node-code as integer      no-undo.
     1631       define variable v-is-terminal     as logical           no-undo.
     1632       define buffer buf_upper_gds-grp for ub.gds-grp.
     1633       define buffer buf_node_gds-grp  for ub.gds-grp.
     1634       if not b-marg :visible in FRAME d-g-grp-f
     1635       then do:
     1636       end.
     1637       else do:
     1638           run grplib-is-terminal in this-procedure ( input p-node-code, output v-is-terminal ) no-error.
     1639           if error-status :error
     1640           then do:
     1641               undo, return error "enable-button-marg: Не удается определить, корневая группа или терминальная." + chr(10) + return-value.
     1642           end.
     1643           if v-is-terminal = no
     1644           then do:
     1645               disable b-marg with FRAME d-g-grp-f.
     1646           end.
     1647           else do:
     1648               enable b-marg with FRAME d-g-grp-f.
     1649           end.
     1650       end.
     1651   end.
     1652   END PROCEDURE.
     1653   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1654   procedure cur-time :
     1655      define output parameter p-today as date      no-undo .
     1656      define output parameter p-time  as integer   no-undo .
     1657     do
     1658     on error undo, return error
     1659     :
     1660       define variable v-date1 as date      no-undo .
     1661       define variable v-date2 as date      no-undo .
     1662       define variable v-time  as integer   no-undo .
     1663       assign
     1664         v-date1 = today
     1665         v-time  = time
     1666         v-date2 = today
     1667       .
     1668       if v-date1 <> v-date2
     1669       then do:
     1670         assign
     1671           v-date1 = today
     1672           v-time  = v-time
     1673         .
     1674       end.
     1675       assign
     1676         p-today = v-date1
     1677         p-time  = v-time
     1678       .
     1679     end.
     1680   end.
     1681   function cur-time-date returns character
     1682   :
     1683     return string(today, '99/99/9999':U) .
     1684   end.
     1685   function cur-time-mjd returns decimal
     1686   :
     1687     define variable v-date as date      no-undo .
     1688     define variable v-time as integer   no-undo .
     1689     run cur-time in this-procedure
     1690       (output v-date
     1691       ,output v-time
     1692       ) .
     1693     return integer(v-date) - 2400002 + (v-time / 86400) .
     1694   end.
     1695   function cur-time-get-ending-index returns integer
     1696   (input p-number as integer
     1697   )
     1698   :
     1699     if p-number < 0
     1700     or p-number = ?
     1701     then do:
     1702       return 1 .
     1703     end.
     1704     define variable v-rest as integer   no-undo .
     1705     assign
     1706       p-number = p-number modulo 100
     1707     .
     1708     if p-number < 20
     1709     then do:
     1710       assign
     1711         v-rest = p-number
     1712       .
     1713     end.
     1714     else do:
     1715       assign
     1716         v-rest = p-number modulo 10
     1717       .
     1718     end.
     1719     case v-rest :
     1720       when 1
     1721       then do:
     1722         return 2 .
     1723       end.
     1724       when 2 or
     1725       when 3 or
     1726       when 4
     1727       then do:
     1728         return 3 .
     1729       end.
     1730       otherwise do:
     1731         return 1 .
     1732       end.
     1733     end case .
     1734   end.
     1735   procedure cur-time-mjd-to-date :
     1736      define input  parameter i-mjd-diff as decimal no-undo.
     1737      define output parameter o-Date     as date    no-undo.
     1738      define output parameter o-Time     as integer no-undo.
     1739      define variable v-day-number as integer   no-undo .
     1740      if    i-mjd-diff < 0
     1741         or i-mjd-diff = ?
     1742      then do:
     1743         return "?" .
     1744      end.
     1745      assign
     1746         v-day-number = truncate(i-mjd-diff,0).
     1747         o-Date = date(v-day-number + 2400002).
     1748         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1749     .
     1750   end.
     1751   function cur-time-mjd-to-string returns character
     1752   (input p-mjd-diff as decimal
     1753   )
     1754   :
     1755     define variable v-day-number as integer   no-undo .
     1756     define variable v-seconds    as integer   no-undo .
     1757     define variable v-hour       as integer   no-undo .
     1758     define variable v-min        as integer   no-undo .
     1759     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1760     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1761     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1762     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1763     if p-mjd-diff < 0
     1764     or p-mjd-diff = ?
     1765     then do:
     1766       return "?" .
     1767     end.
     1768     assign
     1769       v-day-number = integer(truncate(p-mjd-diff,0))
     1770       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1771     .
     1772     if v-seconds > 86400
     1773     then do:
     1774       assign
     1775         v-seconds = 86400 - 1
     1776       .
     1777     end.
     1778     if v-seconds < 0
     1779     then do:
     1780       assign
     1781         v-seconds = 0
     1782       .
     1783     end.
     1784     assign
     1785       v-hour = truncate(v-seconds / 3600, 0)
     1786     .
     1787     assign
     1788       v-seconds = v-seconds modulo 3600
     1789     .
     1790     assign
     1791       v-min = truncate(v-seconds / 60, 0)
     1792     .
     1793     assign
     1794       v-seconds = v-seconds modulo 60
     1795     .
     1796     return
     1797         (if v-day-number <> 0
     1798           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1799           else ""
     1800         )
     1801       + (if v-day-number <> 0 or v-hour <> 0
     1802           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1803           else ""
     1804         )
     1805       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1806           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1807           else ""
     1808         )
     1809       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1810       .
     1811   end.
     1812   function cur-time-string returns character
     1813   :
     1814     define variable v-date as date      no-undo .
     1815     define variable v-time as integer   no-undo .
     1816     run cur-time in this-procedure
     1817       (output v-date
     1818       ,output v-time
     1819       ) .
     1820     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1821   end.
     1822   function cur-time-string-sec returns character
     1823   :
     1824     define variable v-date as date      no-undo .
     1825     define variable v-time as integer   no-undo .
     1826     run cur-time in this-procedure
     1827       (output v-date
     1828       ,output v-time
     1829       ) .
     1830     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1831   end.
     1832   function cur-time-custom  returns character
     1833   (input p-prefix as character
     1834   ,input p-date-format as character
     1835   ,input p-delimiter as character
     1836   ,input p-time-format as character
     1837   ,input p-suffix as character
     1838   )
     1839   :
     1840     define variable v-date as date      no-undo .
     1841     define variable v-time as integer   no-undo .
     1842     run cur-time in this-procedure
     1843       (output v-date
     1844       ,output v-time
     1845       ) .
     1846     return
     1847       p-prefix
     1848       + string(v-date, p-date-format)
     1849       + p-delimiter
     1850       + string(v-time, p-time-format)
     1851       + p-suffix
     1852       .
     1853   end.
     1854   function cur-time-print  returns character
     1855   :
     1856     define variable v-date as date      no-undo .
     1857     define variable v-time as integer   no-undo .
     1858     run cur-time in this-procedure
     1859       (output v-date
     1860       ,output v-time
     1861       ) .
     1862     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1863   end.
     1864   function cur-time-datetime returns datetime
     1865   :
     1866     define variable v-char as character no-undo .
     1867     define variable v-datetime as datetime no-undo .
     1868     v-char = cur-time-string().
     1869     v-datetime = datetime(v-char).
     1870     return  v-datetime.
     1871   end.
     1872   function cur-time-string-msec returns character
     1873   :
     1874     define variable v-date as datetime  no-undo .
     1875     v-date = now.
     1876     return string(v-date) .
     1877   end.
     1878   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1879   PROCEDURE proc-b-tax:
     1880   define input parameter parparentproc    as handle           no-undo.
     1881   define input parameter p-host-code      as character        no-undo.
     1882   define input parameter p-obj-type       as character        no-undo.
     1883   define input parameter p-obj-code       as integer          no-undo.
     1884   define parameter buffer loc-gds-grp for ub.gds-grp.
     1885   define input parameter loc-mode as character no-undo .
     1886   DEFINE VARIABLE locfor-title as character no-undo .
     1887   DEFINE VARIABLE v-today as date no-undo .
     1888   DEFINE VARIABLE v-time as integer no-undo .
     1889   define buffer b_tt-tax for tt-tax.
     1890   if NOT can-find(first tt-tax No-LOCK ) then do:
     1891     bell.
     1892     return error.
     1893   end.
     1894   FOR EACH output-tax:
     1895     DELETE output-tax.
     1896   END.
     1897   locfor-title =  "Ставки налогов и их значения: " +
     1898                   (if loc-mode = 'ДОБАВЛЕНИЕ':U
     1899                    then frame d-g-grp-f:title
     1900                    else ( "группа " + string(loc-gds-grp.node-name))
     1901                    ).
     1902   run ref/taxgtree.w (
     1903                  input table tt-tax,
     1904                  output table output-tax,
     1905                  input parparentproc,
     1906                  input loc-mode,
     1907                  input "GDS-GRP":U,
     1908                  input ?,
     1909                  input (if loc-mode = 'ДОБАВЛЕНИЕ':U
     1910                         then ? else
     1911                         loc-gds-grp.node-code),
     1912                  input p-host-code,
     1913                  input p-obj-type,
     1914                  input p-obj-code,
     1915                  input locfor-title) no-error .
     1916   if error-status:error then return error.
     1917   DO on error UNDO, return error:
     1918     FOR EACH tt-tax break by tt-tax.tax-code:
     1919       if first-of(tt-tax.tax-code) then do:
     1920         if tt-tax.individual then next.
     1921         for each output-tax where
     1922                 output-tax.tax-code = tt-tax.tax-code:
     1923           if output-tax.tax-rate-gds-rc <> ? then do:
     1924             find first b_tt-tax where
     1925                        b_tt-tax.tax-rate-gds-rc = output-tax.tax-rate-gds-rc .
     1926             buffer-copy
     1927             output-tax to b_tt-tax.
     1928           end.
     1929           run cur-time in this-procedure(output v-today, output v-time).
     1930           if output-tax.tax-rate-gds-rc = ? and output-tax.fact-date > v-today then do:
     1931             create b_tt-tax.
     1932             buffer-copy
     1933             output-tax to b_tt-tax.
     1934           end.
     1935         end.
     1936       end.
     1937     END.
     1938   END.
     1939   END PROCEDURE.
