        1   block-level on error undo, throw.
        2   define input-output parameter p-doc-rec as recid no-undo.
        3   define input parameter p-mode            as character no-undo .
        4   define input parameter p-cond-keep-code like ub.condition-keeping.cond-keep-code no-undo .
        5   define input parameter p-cond-keep-name like ub.condition-keeping.cond-keep-name no-undo .
        6   define input parameter p-des like ub.condition-keeping.des no-undo .
        7   define input parameter p-h-mode-from like ub.condition-keeping.h-mode-from no-undo .
        8   define input parameter p-h-mode-to like ub.condition-keeping.h-mode-to no-undo .
        9   define input parameter p-t-mode-from like ub.condition-keeping.t-mode-from no-undo .
       10   define input parameter p-t-mode-to like ub.condition-keeping.t-mode-to no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: cndkeep1.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: ref/cndkeep1.p $":U .
       16   define variable vss-description as character no-undo init "Сохранение изменений в карточке условий хранения".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   define variable v-db-num like ub.db.db-num no-undo .
       87   define stream LogStream.
       88   if p-mode <> 'ДОБАВЛЕНИЕ':U
       89   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
       90     message
       91     vss-workfile vss-revision vss-description skip
       92     "Неверный параметр p-mode" p-mode
       93     view-as alert-box error .
       94     return error '':u.
       95   end.
       96   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       97   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
       98     (output v-db-num
       99     )  .
      100   if v-db-num <> 0 then do:
      101     run err-mess (substitute("Нельзя изменять запись УСЛОВИЙ ХРАНЕНИЯ в УБД: Номер текущей БД &1"
      102                   , v-db-num) ).
      103     undo, return error "":U.
      104   end.
      105   if p-cond-keep-name = "":U then do:
      106     run err-mess ("Название УСЛОВИЙ ХРАНЕНИЯ не может быть пустым").
      107     return error "cond-keep-name":U.
      108   end.
      109   _MAIN:
      110   DO ON ERROR UNDO, RETURN ERROR
      111   ON STOP UNDO, RETURN ERROR:
      112     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      113       create ub.condition-keeping.
      114       assign
      115       ub.condition-keeping.cond-keep-code = next-value(delivery, ub)
      116       p-doc-rec = recid(ub.condition-keeping)
      117       .
      118     end.
      119     else do:
      120       FIND FIRST ub.condition-keeping where
      121                 recid(ub.condition-keeping) = p-doc-rec No-ERROR.
      122       if not available ub.condition-keeping then do:
      123         message
      124         vss-workfile vss-revision vss-description skip
      125         "Не найдена запись УСЛОВИЙ ХРАНЕНИЯ - p-doc-rec" p-doc-rec
      126         view-as alert-box error .
      127         undo, return error '':u.
      128       end.
      129       if ub.condition-keeping.cond-keep-code <> p-cond-keep-code
      130       then do:
      131         message
      132         vss-workfile vss-revision vss-description skip
      133         "Для уже имеющейся записи нельзя изменить"
      134         "внутренний код" skip
      135         view-as alert-box ERROR.
      136         undo, return error '':U.
      137       end.
      138     end.
      139     assign
      140     ub.condition-keeping.cond-keep-name     = p-cond-keep-name
      141     ub.condition-keeping.des                 = p-des
      142     ub.condition-keeping.sts                 =  (if p-mode = 'ДОБАВЛЕНИЕ':U
      143                                then 0
      144                                else ub.condition-keeping.sts)
      145     ub.condition-keeping.t-mode-from         = p-t-mode-from
      146     ub.condition-keeping.t-mode-to         = p-t-mode-to
      147     ub.condition-keeping.h-mode-from         = p-h-mode-from
      148     ub.condition-keeping.h-mode-to         = p-h-mode-to
      149     .
      150     release ub.condition-keeping no-error.
      151     if error-status:error then do:
      152        run err-mess(substitute("Ошибка при сохранении записи УСЛОВИЙ ХРАНЕНИЯ с кодом &1: &2: &3"
      153                                , p-cond-keep-code
      154                                , ERROR-STATUS:GET-message(1)
      155                                , return-value
      156                                )).
      157       undo, return error "":U.
      158    end.
      159   end.
      160   PROCEDURE err-mess:
      161     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
      162         message
      163         p-mess
      164         view-as alert-box error .
      165   END PROCEDURE.
