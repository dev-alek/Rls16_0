        1   block-level on error undo, throw.
        2   define input-output parameter p-doc-rec as recid no-undo.
        3   define input parameter p-mode            as character no-undo .
        4   define input parameter p-deliv-type-code like ub.delivery-type-subject.deliv-type-code no-undo .
        5   define input parameter p-deliv-subj-code like ub.delivery-type-subject.deliv-subj-code no-undo .
        6   define input parameter p-des like ub.delivery-type-subject.des no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: dlvtysu1.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: ref/dlvtysu1.p $":U .
       12   define variable vss-description as character no-undo init "Сохранение изменений в карточке типа доставки от субъекта".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define variable v-db-num like ub.db.db-num no-undo .
       74   define buffer buf_delivery-type  for ub.delivery-type.
       75   define buffer buf_delivery-type-subject  for ub.delivery-type-subject.
       76   define buffer buf_delivery-subject  for ub.delivery-subject.
       77   if p-mode <> 'ДОБАВЛЕНИЕ':U
       78   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
       79     message
       80     vss-workfile vss-revision vss-description skip
       81     "Неверный параметр p-mode" p-mode
       82     view-as alert-box error .
       83     return error '':u.
       84   end.
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
       87     (output v-db-num
       88     )  .
       89   if v-db-num <> 0 then do:
       90     run err-mess (substitute("Нельзя изменять запись ТИП ДОСТАВКИ ОТ СУБЪЕКТА в УБД: Номер текущей БД &1"
       91                   , v-db-num) ).
       92     undo, return error "":U.
       93   end.
       94   find first buf_delivery-type no-lock where
       95               buf_delivery-type.deliv-type-code = p-deliv-type-code  no-error .
       96   if not available buf_delivery-type then do:
       97     run err-mess (substitute("Неправильная ссылка на ТИП ДОСТАВКИ, код типа доставки: &1"
       98                   , p-deliv-type-code) ).
       99     undo, return error "deliv-type-code":U.
      100   end.
      101   find first buf_delivery-subject no-lock where
      102               buf_delivery-subject.deliv-subj-code = p-deliv-subj-code  no-error .
      103   if not available buf_delivery-subject then do:
      104     run err-mess (substitute("Неправильная ссылка на СУБЪЕКТ ДОСТАВКИ, код субъекта доставки: &1"
      105                   , p-deliv-subj-code) ).
      106     undo, return error "deliv-subj-code":U.
      107   end.
      108   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      109     find first buf_delivery-type-subject no-lock where
      110               buf_delivery-type-subject.deliv-type-code = p-deliv-type-code
      111           AND buf_delivery-type-subject.deliv-subj-code = p-deliv-subj-code
      112                 no-error .
      113     if available buf_delivery-type-subject then do:
      114       run err-mess (substitute("Уже есть запись ТИПА ДОСТАВКИ ОТ СУБЪЕКТА, у которой код типа доставки: &1 и код субъекта доставки: &2"
      115                     , p-deliv-type-code
      116                     , p-deliv-subj-code) ).
      117       undo, return error "deliv-type-code":U.
      118     end.
      119   end.
      120   _MAIN:
      121   DO ON ERROR UNDO, RETURN ERROR
      122   ON STOP UNDO, RETURN ERROR:
      123     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      124       create ub.delivery-type-subject.
      125       assign
      126       ub.delivery-type-subject.deliv-type-code = p-deliv-type-code
      127       ub.delivery-type-subject.deliv-subj-code = p-deliv-subj-code
      128       p-doc-rec = recid(ub.delivery-type-subject)
      129       .
      130     end.
      131     else do:
      132       FIND FIRST ub.delivery-type-subject where
      133                 recid(ub.delivery-type-subject) = p-doc-rec No-ERROR.
      134       if not available ub.delivery-type-subject then do:
      135         message
      136         vss-workfile vss-revision vss-description skip
      137         "Не найдена запись ТИП ДОСТАВКИ ОТ СУБЪЕКТА - p-doc-rec" p-doc-rec
      138         view-as alert-box error .
      139         undo, return error '':u.
      140       end.
      141       if ub.delivery-type-subject.deliv-type-code <> p-deliv-type-code
      142       then do:
      143         message
      144         vss-workfile vss-revision vss-description skip
      145         "Для уже имеющейся записи нельзя изменить"
      146         "внутренний код типа доставки" skip
      147         view-as alert-box ERROR.
      148         undo, return error '':U.
      149       end.
      150       if ub.delivery-type-subject.deliv-subj-code <> p-deliv-subj-code
      151       then do:
      152         message
      153         vss-workfile vss-revision vss-description skip
      154         "Для уже имеющейся записи нельзя изменить"
      155         "внутренний код субъекта доставки" skip
      156         view-as alert-box ERROR.
      157         undo, return error '':U.
      158       end.
      159     end.
      160     assign
      161     ub.delivery-type-subject.des                 = p-des
      162     ub.delivery-type-subject.sts                 =  (if p-mode = 'ДОБАВЛЕНИЕ':U
      163                                then 0
      164                                else ub.delivery-type-subject.sts)
      165     .
      166     release ub.delivery-type-subject no-error.
      167     if error-status:error then do:
      168        run err-mess(substitute("Ошибка при сохранении записи ТИП ДОСТАВКИ ОТ СУБЪЕКТА: тип доставки &1, код субъекта &2 : &3: &4"
      169                                , p-deliv-type-code
      170                                , p-deliv-subj-code
      171                                , ERROR-STATUS:GET-message(1)
      172                                , return-value
      173                                )).
      174       undo, return error "":U.
      175    end.
      176   end.
      177   PROCEDURE err-mess:
      178     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
      179         message
      180         p-mess
      181         view-as alert-box error .
      182   END PROCEDURE.
