        1   DEFINE BUFFER buf_regions FOR ub.regions.
        2   define input  parameter parParentProc as widget-handle                    no-undo .
        3   define input  parameter p-mode        as character                        no-undo .
        4   define output parameter p-reg-code    like ub.regions.reg-code initial ?  no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   procedure proc-alt-shift-f2:
       81     if not ibs.th.gbl.gbl-var:rcode
       82   then
       83     run gbl\inidebug.p .
       84   end.
       85   procedure proc-alt-shift-f3:
       86     run gbl/prvssinf.p
       87       ( input this-procedure
       88       ) .
       89   end.
       90   define variable v-inform-launched as logical no-undo initial false .
       91   procedure proc-alt-shift-f4:
       92     define variable v-action as character no-undo .
       93     if v-inform-launched = false then do:
       94       assign
       95         v-inform-launched = true
       96       .
       97       run gbl/d-inform.w
       98         (  input self
       99         ,  input this-procedure
      100         , output v-action
      101         ) no-error .
      102       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      103       assign
      104         v-inform-launched = false
      105       .
      106     end.
      107   end.
      108   procedure proc-alt-f1:
      109     run gbl/corrhelp.p
      110       (input this-procedure
      111       ) .
      112   end .
      113   on alt-shift-f2 anywhere do:
      114     run proc-alt-shift-f2.
      115   end.
      116   on alt-shift-f3 anywhere do:
      117     run proc-alt-shift-f3 in this-procedure .
      118   end.
      119   on alt-shift-f4 anywhere do:
      120     run proc-alt-shift-f4 in this-procedure.
      121   end.
      122   on alt-f1 anywhere do:
      123     run proc-alt-f1 in this-procedure .
      124   end.
      125   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126   define variable v-waitfram-action01         as character   no-undo .
      127   define variable v-waitfram-action02         as character   no-undo .
      128   define variable v-waitfram-action03         as character   no-undo .
      129   define variable mWaitFramTextBeg            as character   no-undo.
      130   define variable mWaitFramTextEnd            as character   no-undo.
      131   define variable mWaitFramView               as logical     no-undo.
      132   define variable mWaitProcEvent              as logical     no-undo init yes.
      133   define variable mWaitFramInterval           as integer     no-undo init 1 .
      134   define variable mWaitFramStop               as logical     no-undo.
      135   define variable mWaitFramStopUser           as logical     no-undo.
      136   define variable mWaitFramStopTimeOut        as logical     no-undo.
      137   define variable mWaitFramStartProc          as datetime-tz no-undo.
      138   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      139   define button B-WaitFramStop auto-end-key
      140        label "Стоп"
      141        size 10 by 1 tooltip "Остоновить процесс".
      142   define button B-viewProcInfo
      143        label "Информация"
      144        size 15 by 1 tooltip "Информация о процесс".
      145   define frame waitfram
      146     v-waitfram-action01 format "x(72)" no-label skip
      147     v-waitfram-action02 format "x(72)" no-label skip
      148     v-waitfram-action03 format "x(72)" no-label skip
      149     B-viewProcInfo
      150     B-WaitFramStop at row 4 col 30
      151     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      152     .
      153   define new global shared variable mBatchMode as logical no-undo init ?.
      154   define variable mFramBachModHandle as handle no-undo.
      155   mFramBachModHandle = frame waitfram:handle.
      156   define variable mFameOldVis as logical no-undo.
      157   define variable mVisCUrentVin as logical no-undo.
      158   if session:batch-mode
      159   then
      160      mBatchMode = yes.
      161   if mBatchMode = ? then do:
      162     mVisCUrentVin = current-window:visible.
      163     mFameOldVis = mFramBachModHandle:visible.
      164     mFramBachModHandle:visible  = yes.
      165     mBatchMode = mFramBachModHandle:visible ne yes.
      166     mFramBachModHandle:visible = mFameOldVis.
      167     current-window:visible = mVisCUrentVin.
      168   end.
      169    if  log-manager:logfile-name ne ?
      170     then DO:
      171         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      172         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      173         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      174     end.
      175   on choose of B-WaitFramStop in frame waitfram
      176   do:
      177     mWaitFramStop = yes.
      178     mWaitFramStopUser = yes.
      179   end.
      180   function waitfram-check-timeout returns logical():
      181      define variable vtime as int64 no-undo.
      182      if mWaitFramStopTimeOut
      183      then
      184         return yes.
      185      vtime = ( now - mWaitFramStartProc ) / 1000 .
      186      if     mWaitFramTimeOut ne ?
      187         and mWaitFramTimeOut ne 0
      188         and mWaitFramTimeOut lt vtime
      189      then do:
      190         mWaitFramStopTimeOut = yes.
      191      end.
      192      return mWaitFramStopTimeOut.
      193   end.
      194   procedure waitfram-hide :
      195     if not session:batch-mode
      196     then do
      197     on error undo, return error return-value
      198     :
      199       pause 0 before-hide .
      200       if not mBatchMode then
      201         hide frame waitfram .
      202     if     not mWaitFramView
      203        and mWaitProcEvent
      204     then
      205       process events .
      206     end.
      207   end procedure.
      208   procedure waitfram-show :
      209     define input  parameter p-message as character no-undo .
      210     define variable v-left-margin as integer   no-undo .
      211     if not session:batch-mode
      212     then do
      213     on error undo, return error return-value
      214     :
      215       if length(p-message) <= 70 then do:
      216         assign
      217           v-left-margin = integer((70 - length(p-message)) / 2)
      218         .
      219         assign
      220           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      221         .
      222         assign
      223           v-waitfram-action01 = " "
      224           v-waitfram-action02 = " "
      225                                    + fill(" ", v-left-margin)
      226                                    + p-message
      227           v-waitfram-action03 = " "
      228         .
      229       end.
      230       else do:
      231         define variable vRindex1 as integer no-undo.
      232         define variable vRindex2 as integer no-undo.
      233         vRindex1 = r-index(p-message," ",70).
      234         if vRindex1 = 0
      235         then
      236            vRindex1 = 70.
      237         if length(p-message)  <= vRindex1 + 70 then do:
      238           assign
      239             v-waitfram-action01 = " "
      240             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      241             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      242           .
      243         end.
      244         else do:
      245           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      246           if vRindex2 <= vRindex1
      247           then
      248              vRindex2 = vRindex1 + 70.
      249           assign
      250             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      251             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      252             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      253           .
      254         end.
      255       end.
      256       B-viewProcInfo:visible   in frame waitfram = no.
      257       B-viewProcInfo:sensitive in frame waitfram = no.
      258       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      259       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      260       if  (   mWaitFramView
      261          or  mWaitProcEvent)
      262          and not mBatchMode
      263       then
      264          display
      265             v-waitfram-action01 skip
      266             v-waitfram-action02 skip
      267             v-waitfram-action03 skip
      268          with frame waitfram .
      269       if     mWaitFramView
      270          then do:
      271             if     mWaitFramInterval ne ?
      272                and not mBatchMode
      273             then
      274                wait-for go of frame waitfram pause mWaitFramInterval.
      275          end.
      276          else
      277             if     mWaitProcEvent
      278                and not mBatchMode
      279             then
      280                process events .
      281     end.
      282   end procedure.
      283      procedure waitfram-show-this:
      284         define input  parameter iInterval as int64 no-undo.
      285         define variable vtime as int64 no-undo.
      286         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      287         mWaitFramInterval = iInterval.
      288         run waitfram-show (substitute("&1&2 &3&4" ,
      289                                       mWaitFramTextBeg ,
      290                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      291                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      292                                       mWaitFramTextEnd
      293                                      )
      294                           ).
      295      end.
      296      procedure WaitFramRunPause:
      297         define input  parameter iInterval as dec no-undo.
      298         define variable vStart  as datetime-tz no-undo.
      299         define variable vend    as datetime-tz no-undo.
      300         define variable vint as int64 no-undo.
      301         define variable vOk as logical no-undo.
      302         vStart = now.
      303         vend   = vStart.
      304         publish "WaitFramPause" (iInterval,output vOk).
      305         vend   =  now.
      306         vint = vend - vStart.
      307         vint = iInterval - vint / 1000.
      308         if     not mWaitFramStop
      309            and (   vint > 0
      310                 or (    not vOk
      311                     and iInterval eq ?
      312                     )
      313                 )
      314         then
      315            run waitfram-show-this (iInterval).
      316         vend   =  now.
      317         vint = vend - vStart.
      318         vint = iInterval - vint / 1000.
      319         if     not mWaitFramStop
      320            and vint > 0
      321         then do:
      322            run gbl/pause.p (vint * 1000).
      323         end.
      324         if iInterval ne ?
      325         then
      326            publish "WaitFramStop".
      327         waitfram-check-timeout().
      328      end.
      329      procedure WaitFramWaitFor:
      330         define input  parameter iInterval as dec no-undo.
      331         assign
      332            mWaitFramStartProc   = now
      333            mWaitFramStopUser    = no
      334            mWaitFramStopTimeOut = no
      335         .
      336         block-wait:
      337         do while not mWaitFramStop:
      338            run WaitFramRunPause (iInterval).
      339            if  waitfram-check-timeout()
      340            then do:
      341               leave block-wait.
      342            end.
      343         end.
      344         run waitfram-hide.
      345      end.
      346   procedure waitfram-join :
      347     define input  parameter p-line-1  as character no-undo .
      348     define input  parameter p-line-2  as character no-undo .
      349     define input  parameter p-line-3  as character no-undo .
      350     define output parameter p-message as character no-undo .
      351     do
      352     on error undo, return error return-value
      353     :
      354       assign
      355         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      356                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      357                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      358       .
      359     end.
      360   end procedure.
      361   function waitfram-join-function returns character
      362     (input p-line-1 as character
      363     ,input p-line-2 as character
      364     ,input p-line-3 as character
      365     ).
      366     define variable v-message as character no-undo .
      367     run waitfram-join in this-procedure
      368       (input  p-line-1
      369       ,input  p-line-2
      370       ,input  p-line-3
      371       ,output v-message
      372       ) .
      373     return v-message .
      374   end function .
      375   define variable vss-include-info1 as character format "X(65)" no-undo
      376   initial "@(#)$Workfile$ $Revision$".
      377   define temp-table temp_p-fmt_string-part no-undo
      378       field str-key       as integer
      379       field string-part   as character
      380       index pi is primary unique
      381           str-key
      382   .
      383   define variable v-p-fmt-1-str-key    as integer      no-undo.
      384   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
      385                                     iInput AS INTEGER).
      386     def var v-start-print as integer no-undo .
      387     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
      388     assign
      389       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
      390     .
      391     RETURN v-start-print .
      392   END FUNCTION.
      393   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
      394                                     iInput AS INTEGER).
      395     def var v-start-print as integer no-undo .
      396     assign
      397       v-start-print = INTEGER(iEndPix - 1 - iInput)
      398     .
      399     if v-start-print < 0 then return 0.
      400     RETURN v-start-print .
      401   END FUNCTION.
      402   function p-fmt-align-string returns character (
      403         p-in-string      as character
      404       , p-page-width     as integer
      405       , p-align-type     as character
      406   ).
      407       define variable v-string-length     as integer      no-undo.
      408       define variable v-out-string        as character    no-undo.
      409       assign
      410           v-string-length = length( trim( p-in-string ) )
      411       .
      412       if v-string-length >= p-page-width
      413       then do:
      414           assign
      415               v-out-string = trim( p-in-string )
      416           .
      417       end.
      418       else do:
      419           case p-align-type
      420           :
      421               when 'left':U
      422               then do:
      423                   assign
      424                       v-out-string = trim( p-in-string )
      425                   .
      426               end.
      427               when 'right':U
      428               then do:
      429                   assign
      430                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      431                   .
      432               end.
      433               when 'center':U
      434               then do:
      435                   assign
      436                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      437                   .
      438               end.
      439           end case.
      440       end.
      441       return v-out-string .
      442   end function.
      443   procedure p-fmt-split-string :
      444   define input parameter p-source-string  as character        no-undo.
      445   define input parameter p-split-length   as integer          no-undo.
      446   define output parameter p-string-1      as character        no-undo.
      447   define output parameter p-string-2      as character        no-undo.
      448   do
      449   on error undo, return error
      450   :
      451       define variable v-space-pos    as integer      no-undo.
      452       if length( p-source-string ) <= p-split-length
      453       then do:
      454           assign
      455               p-string-1 = p-source-string
      456           .
      457       end.
      458       else do:
      459           assign
      460               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      461           .
      462           if v-space-pos = 0
      463           then do:
      464               assign
      465                   v-space-pos = index( p-source-string, " ":U )
      466               .
      467           end.
      468           if v-space-pos = 0
      469           then do:
      470               assign
      471                   p-string-1 = substring( p-source-string, 1, p-split-length )
      472                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      473               .
      474           end.
      475           else do:
      476               assign
      477                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      478                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      479               .
      480           end.
      481       end.
      482   end.
      483   end procedure.
      484   procedure p-fmt-round :
      485   define input parameter p-qnty               as decimal          no-undo.
      486   define input parameter p-price-no-VAT       as decimal          no-undo.
      487   define input parameter p-VAT                as decimal          no-undo.
      488   define input parameter p-SLT                as decimal          no-undo.
      489   define input parameter p-road-tax           as decimal          no-undo.
      490   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      491   define output parameter p-new-VAT           as decimal          no-undo.
      492   define output parameter p-new-SLT           as decimal          no-undo.
      493   define output parameter p-new-sum-VAT       as decimal          no-undo.
      494   define output parameter p-new-sum-SLT       as decimal          no-undo.
      495   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      496   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      497   define output parameter p-new-sum-full      as decimal          no-undo.
      498       define variable v-vat-pc    as decimal      no-undo.
      499       define variable v-slt-pc    as decimal      no-undo.
      500   do
      501   on error undo, return error
      502   :
      503       if p-price-no-VAT = 0
      504       then do:
      505           assign
      506               p-new-price-no-VAT = 0.0
      507               p-new-VAT          = ?
      508               p-new-SLT          = ?
      509               p-new-sum-VAT      = 0.0
      510               p-new-sum-SLT      = 0.0
      511               p-new-sum-no-VAT   = 0.0
      512               p-new-sum-road-tax = 0.0
      513               p-new-sum-full     = 0.0
      514           .
      515       end.
      516       else do:
      517           assign
      518               v-vat-pc            = p-VAT / p-price-no-VAT
      519               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      520               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      521               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      522               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      523               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      524               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      525               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      526               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      527               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      528           .
      529       end.
      530   end.
      531   end procedure.
      532   procedure p-fmt-split :
      533   define input parameter p-in-string      as character        no-undo.
      534   define input parameter p-split-length   as integer          no-undo.
      535       define variable v-start-pos     as integer      no-undo.
      536       define variable v-end-pos       as integer      no-undo.
      537       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      538   do
      539   for buf_temp_p-fmt_string-part
      540   on error undo, return error
      541   :
      542       empty temp-table buf_temp_p-fmt_string-part.
      543       if p-split-length < 1
      544       then do:
      545           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      546       end.
      547       assign
      548           p-in-string                 = trim( p-in-string )
      549           v-p-fmt-1-str-key   = 0
      550           v-start-pos                 = 1
      551           v-end-pos                   = length( p-in-string )
      552       .
      553       run p-fmt-get-string-range in this-procedure (
      554             input p-in-string
      555           , input p-split-length
      556           , input v-start-pos
      557           , output v-start-pos
      558           , output v-end-pos
      559       ).
      560       do while v-end-pos <> 0
      561       :
      562           create buf_temp_p-fmt_string-part.
      563           assign
      564               v-p-fmt-1-str-key = v-p-fmt-1-str-key + 1
      565           .
      566           assign
      567               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-1-str-key
      568               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      569           .
      570           assign
      571               v-start-pos = v-end-pos + 1
      572           .
      573           run p-fmt-get-string-range in this-procedure (
      574                 input p-in-string
      575               , input p-split-length
      576               , input v-start-pos
      577               , output v-start-pos
      578               , output v-end-pos
      579           ).
      580       end.
      581   end.
      582   end procedure.
      583   procedure p-fmt-get-string-range :
      584   define input parameter p-in-string      as character        no-undo.
      585   define input parameter p-split-length   as integer          no-undo.
      586   define input parameter p-old-start-pos  as integer          no-undo.
      587   define output parameter p-start-pos     as integer          no-undo.
      588   define output parameter p-end-pos       as integer          no-undo.
      589       define variable v-init-string    as character    no-undo.
      590       define variable v-temp-char      as character    no-undo.
      591       define variable v-temp-pos       as integer      no-undo.
      592       define variable v-counter        as integer      no-undo.
      593   do
      594   on error undo, return error
      595   :
      596       assign
      597           p-start-pos   = p-old-start-pos
      598           v-init-string = substring( p-in-string, p-start-pos )
      599       no-error.
      600       if error-status :error
      601       or trim( v-init-string ) = "":U
      602       then do:
      603           assign
      604               p-end-pos = 0
      605           .
      606           undo, return .
      607       end.
      608       assign
      609           v-temp-char   = substring( v-init-string, 1, 1 )
      610       .
      611       do
      612       while trim( v-temp-char ) = "":U
      613       :
      614           assign
      615               p-start-pos     = p-start-pos + 1
      616               v-init-string   = substring( p-in-string, p-start-pos )
      617               v-temp-char     = substring( v-init-string, 1, 1 )
      618           .
      619       end.
      620       assign
      621           v-temp-pos  = p-split-length
      622           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      623           v-counter   = 0
      624       .
      625       search-word-end:
      626       do
      627       while trim( v-temp-char ) <> "":U
      628       :
      629           assign
      630               v-counter   = v-counter + 1
      631           .
      632           if v-counter > 20
      633           then do:
      634               assign
      635                   v-temp-pos  = p-split-length
      636               .
      637               leave search-word-end.
      638           end.
      639           assign
      640               v-temp-pos  = v-temp-pos - 1
      641               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      642           .
      643       end.
      644       assign
      645           p-end-pos = p-start-pos + v-temp-pos - 1
      646       .
      647   end.
      648   end procedure.
