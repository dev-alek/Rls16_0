      682   define  stream PrnLibStream.
      683   procedure prn-lib-prn-file :
      684     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      685     define input parameter p-DIsabledoptions as integer no-undo .
      686     define variable v-report-name as character no-undo .
      687     define variable v-user-action as character no-undo .
      688     define variable v-printed     as logical   no-undo .
      689     define variable v-exist       as logical   no-undo .
      690     do
      691       on error undo, return error
      692       :
      693       run prn-lib-get-report-name  in this-procedure (
      694         input parParentProc
      695         ,output v-report-name
      696         ).
      697   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      698   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      699     (input  v-report-name
      700     ,input  2
      701     ,output v-exist
      702     )  .
      703       if NOT v-exist then
      704       DO:
      705         Message
      706           "Нет заданий на печать ! "
      707           view-as alert-box .
      708         Return  .
      709       End.
      710       run gbl/prnfilen.w
      711         (input  ""
      712         ,input  p-DisabledOptions
      713         ,input  string(v-report-name )
      714         ,input  7
      715         ,output v-user-action
      716         ,output v-printed
      717         ) .
      718       if v-printed then
      719       do:
      720         return "YES" .
      721       end.
      722       else
      723       do:
      724         return "NO" .
      725       end.
      726     end.
      727   end procedure.
      728   procedure prn-lib-open-stream :
      729     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      730     define input parameter p-page-size    as integer no-undo .
      731     define input parameter p-is-stream    as logical no-undo .
      732     define input parameter p-append       as logical no-undo .
      733     define variable v-report-name as character no-undo .
      734     do
      735       on error undo, return error
      736       :
      737       run prn-lib-get-report-name  in this-procedure (
      738         input parParentProc
      739         ,output v-report-name
      740         ).
      741       if p-is-stream then
      742       do:
      743         if p-append then
      744         do:
      745           output stream PrnLibStream to value( v-report-name )
      746             page-size value(p-page-size) append .
      747         end.
      748         if not p-append then
      749         do:
      750           output stream PrnLibStream to value( v-report-name )
      751             page-size value(p-page-size) .
      752         end.
      753       end.
      754       if not p-is-stream then
      755       do:
      756         if p-append then
      757         do:
      758           output to value( v-report-name )
      759             page-size value(p-page-size) append .
      760         end.
      761         if not p-append then
      762         do:
      763           output to value( v-report-name )
      764             page-size value(p-page-size) .
      765         end.
      766       end.
      767     end.
      768   end procedure.
      769   procedure prn-lib-open-exp :
      770     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      771     define input parameter p-is-stream    as logical no-undo .
      772     define input parameter p-is-append    as logical no-undo .
      773     define output parameter p-ReportFileName as char init "report" no-undo.
      774     define output parameter p-process as logical no-undo .
      775     define variable glog as logical no-undo .
      776     do
      777       on error undo, return error
      778       :
      779       SYSTEM-DIALOG GET-FILE p-ReportFileName
      780         TITLE      "Укажите путь"
      781         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      782         ASK-OVERWRITE
      783         CREATE-TEST-FILE
      784         SAVE-AS
      785         USE-FILENAME
      786         DEFAULT-EXTENSION "txt"
      787         UPDATE glog
      788         .
      789       if not glog then  return.
      790       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      791       if p-is-stream then
      792       do:
      793         if p-is-append then
      794         do:
      795           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      796         end.
      797         else
      798         do:
      799           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      800         end.
      801       end.
      802       else
      803       do:
      804         if p-is-append then
      805         do:
      806           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      807         end.
      808         else
      809         do:
      810           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      811         end.
      812       end.
      813       p-process = yes.
      814     end.
      815   end procedure.
      816   procedure prn-lib-get-report-name :
      817     define input parameter parParentProc  as widget-handle no-undo.
      818     define output parameter p-report-name as character no-undo .
      819     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      820   end procedure.
      821   procedure prn-lib-reportviewer-report-name :
      822     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      823     define input parameter p-report-name-html as character no-undo .
      824     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      825   end procedure.
      826   procedure prn-lib-reportviewer :
      827     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      828     define input parameter p-report-name-html as character no-undo .
      829     define input parameter p-param        as character no-undo .
      830     define variable v-excel           as character no-undo init 'TRUE' .
      831     define variable v-value-character as character no-undo .
      832     define variable v-value-integer   as character no-undo .
      833     define variable v-value-date      as date      no-undo .
      834     define variable v-value-decimal   as decimal   no-undo .
      835     define variable rep-excel         as logical   no-undo .
      836     define variable excel-string      as character no-undo .
      837     define variable v-param-type      as character no-undo .
      838     define variable v-tth             as handle    no-undo .
      839     run adm/shattri.p (
      840       input "get":U
      841       ,input  ""
      842       ,input  0
      843       ,input  'report-glob':U
      844       ,input  'rep-excel':U
      845       ,output v-value-character
      846       ,output v-value-date
      847       ,output v-value-decimal
      848       ,output v-value-integer
      849       ,output rep-excel
      850       ,output v-param-type
      851       ,INPUT-OUTPUT table-handle v-tth
      852       )  .
      853     if rep-excel then v-excel = "TRUE" .
      854     else v-excel = "FALSE" .
      855     if p-param eq ""
      856     then
      857        p-param = "EXCEL:" + v-excel.
      858     else
      859        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      860     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      861   end procedure.
      862   define variable v-regions-mark-list as character no-undo.
      863   FUNCTION mark-str-regions RETURNS CHARACTER
      864     ( buffer buf_regions for ub.regions, input v-regions-mark-list as character)  FORWARD.
      865   DEFINE BUTTON B-exit AUTO-END-KEY
      866        LABEL "&Выход"
      867        SIZE 10 BY 1
      868        BGCOLOR 8 .
      869   DEFINE BUTTON B-Help
      870        LABEL "Помо&щь"
      871        SIZE 10 BY 1
      872        BGCOLOR 8 .
      873   DEFINE BUTTON b-mark
      874        LABEL "&*"
      875        SIZE 3 BY 1.
      876   DEFINE BUTTON b-print
      877        LABEL "Печ&ать"
      878        SIZE 10 BY 1
      879        BGCOLOR 8 .
      880   DEFINE BUTTON B-sel AUTO-GO
      881        LABEL "Вы&бор"
      882        SIZE 10 BY 1
      883        BGCOLOR 8 .
      884   DEFINE VARIABLE mark-num AS INTEGER FORMAT ">>>9":U INITIAL 0
      885         VIEW-AS TEXT
      886        SIZE 14 BY .67
      887        FGCOLOR 4  NO-UNDO.
      888   DEFINE QUERY br-region FOR
      889         buf_regions SCROLLING.
      890   DEFINE BROWSE br-region
      891     QUERY br-region NO-LOCK DISPLAY
      892         mark-str-regions(buffer buf_regions, v-regions-mark-list) COLUMN-LABEL "*"
      893               WIDTH 1
      894         buf_regions.reg-code COLUMN-LABEL "Код" FORMAT "ZZ9":U
      895         buf_regions.reg-name COLUMN-LABEL "Регион" FORMAT "X(40)":U
      896               WIDTH 54
      897       WITH NO-ROW-MARKERS NO-COLUMN-SCROLLING SEPARATORS SIZE 60 BY 15 FIT-LAST-COLUMN.
      898   DEFINE FRAME Dialog-Frame
      899        B-exit AT ROW 1 COL 1 WIDGET-ID 2
      900        B-sel AT ROW 1 COL 11 WIDGET-ID 6
      901        b-mark AT ROW 1 COL 26 WIDGET-ID 8
      902        b-print AT ROW 1 COL 40.5 WIDGET-ID 12
      903        B-Help AT ROW 1 COL 50.5 WIDGET-ID 4
      904        br-region AT ROW 3 COL 1 WIDGET-ID 200
      905        mark-num AT ROW 2 COL 1 NO-LABEL WIDGET-ID 10
      906        SPACE(46.00) SKIP(15.33)
      907       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      908            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      909            TITLE "Справочник регионов РФ" WIDGET-ID 100.
      910   ASSIGN
      911          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      912          FRAME Dialog-Frame:HIDDEN           = TRUE.
      913   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      914   DO:
      915     APPLY "END-ERROR":U TO SELF.
      916   END.
      917   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      918   DO:
      919   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      920   if lookup(self :type
      921            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      922            ) = 0
      923   then do:
      924     message
      925       "$Workfile$"
      926       "Указанному интерфейсному элементу фокус не может быть передан" skip
      927       "Интерфейсный элемент" self :name  skip
      928       "Тип" self :type  skip
      929       "Процедура" this-procedure :file-name skip
      930       view-as alert-box .
      931   end.
      932   else do:
      933     apply "entry":u to self  .
      934     if focus :handle <> self :handle  then do:
      935       return no-apply .
      936     end.
      937   end.
      938   END.
      939   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      940   DO:
      941   define variable v-log as logical no-undo.
      942        if available buf_regions then do:
      943   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      944   define variable v-str-recid7 as character no-undo .
      945   define variable v-num-entry7 as integer   no-undo .
      946   assign
      947     v-str-recid7 = trim( string( recid( buf_regions ) , "->>>>>>>>>>>9":U ) )
      948     v-num-entry7 = lookup( v-str-recid7 , v-regions-mark-list )
      949   .
      950   if v-num-entry7 > 0 then do:
      951     assign
      952       entry( v-num-entry7, v-regions-mark-list ) = "":U
      953       v-regions-mark-list = trim( replace( v-regions-mark-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      954     .
      955   end.
      956   else do:
      957     assign
      958       v-regions-mark-list = v-regions-mark-list + ( if v-regions-mark-list = "":U then "":U else chr(44) ) + v-str-recid7
      959     .
      960   end.
      961         v-log = br-region:refresh() .
      962         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then  do:
      963           v-log = br-region:select-next-row ().
      964           apply "iteration-changed" to br-region in frame Dialog-Frame.
      965         end.
      966         if num-entries( v-regions-mark-list ) = 0 then
      967             hide mark-num in frame Dialog-Frame.
      968         else
      969             disp num-entries( v-regions-mark-list ) @ mark-num with frame Dialog-Frame.
      970       end.
      971       apply "entry" to br-region in frame Dialog-Frame.
      972   END.
      973   ON CHOOSE OF b-print IN FRAME Dialog-Frame
      974   DO:
      975     if not available buf_regions then return no-apply.
      976     run proc-b-print in this-procedure no-error.
      977     if error-status:error then do:
      978       return no-apply.
      979     end.
      980   END.
      981   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      982   DO:
      983     if available buf_regions then do:
      984       assign
      985         p-reg-code = buf_regions.reg-code
      986       .
      987     end.
      988   END.
      989   ON MOUSE-SELECT-DBLCLICK OF br-region IN FRAME Dialog-Frame
      990   DO:
      991     if p-mode = 'выбор':U then do:
      992       apply "choose" to b-sel.
      993     end.
      994   END.
      995   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      996   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      997   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      998   on help of frame Dialog-Frame
      999   do:
     1000     run gbl/app_help.p
     1001       (input this-procedure :file-name
     1002       ,input ''
     1003       ,input ?
     1004       ) no-error.
     1005     if error-status :error then do:
     1006       message
     1007         "Ошибка при вызове помощи"
     1008         error-status :get-message(1)
     1009         view-as alert-box .
     1010     end.
     1011   end.
     1012   run minbtn-set in this-procedure .
     1013   on choose of b-help in frame Dialog-Frame
     1014   do:
     1015     apply "help":u to frame Dialog-Frame .
     1016   end.
     1017   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1018   procedure minbtn-set :
     1019       do
     1020           on error undo, return error return-value
     1021           :
     1022           define variable ii              as integer       no-undo .
     1023           define variable fh              as widget-handle no-undo .
     1024           define variable hh              as widget-handle no-undo .
     1025           define variable v-h             as handle        extent 4 no-undo .
     1026           define variable v-name-button   as character     no-undo .
     1027           define variable v-help-old-x    as decimal       no-undo .
     1028           define variable v-help-old-y    as decimal       no-undo .
     1029           define variable v-help-old-size as decimal       no-undo .
     1030           define variable v-frame-width   as decimal       no-undo .
     1031           define variable jj              as integer       no-undo .
     1032           do
     1033               on error undo, return error
     1034               :
     1035               assign
     1036                   v-frame-width = frame Dialog-Frame:width - 0.3
     1037                   fh            = frame Dialog-Frame:first-child
     1038                   hh            = fh:first-child
     1039                   ii            = 1
     1040                   .
     1041               do while valid-handle(hh):
     1042                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1043                   do:
     1044                       case lc(hh:name) :
     1045                           when "b-help" then
     1046                               do:
     1047                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1048                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1049                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1050                                   hh:TOOLTIP = "Помощь" .
     1051                                   v-help-old-x = hh:column .
     1052                                   v-help-old-y = hh:row    .
     1053                                   v-help-old-size = hh:width .
     1054                                   hh:width-chars = 2.5 .
     1055                               end.
     1056                           when "b-print" then
     1057                               do:
     1058                                   hh:load-image("cmp/b-print.bmp":u) .
     1059                                   hh:TOOLTIP = "Печать" .
     1060                                   v-h[ii] = hh:handle .
     1061                                   ii = ii + 1 .
     1062                                   hh:width-chars = 3 .
     1063                               end.
     1064                           when "b-history" or
     1065                           when "b-hist" then
     1066                               do:
     1067                                   hh:load-image("cmp/b-hist.bmp":u) .
     1068                                   hh:TOOLTIP = "История" .
     1069                                   v-h[ii] = hh:handle .
     1070                                   ii = ii + 1 .
     1071                                   hh:width-chars = 3 .
     1072                               end.
     1073                           when "b-sch" then
     1074                               do:
     1075                                   hh:load-image("cmp/b-sch.bmp":u) .
     1076                                   hh:TOOLTIP = "Установка Фильтра" .
     1077                                   v-h[ii] = hh:handle .
     1078                                   ii = ii + 1 .
     1079                                   hh:width-chars = 3 .
     1080                               end.
     1081                           when "b-hist-user" then
     1082                               do:
     1083                                   hh:load-image("cmp/b-hist.bmp":u) .
     1084                                   hh:TOOLTIP = "История пользователя" .
     1085                                   ii = ii + 1 .
     1086                               end.
     1087                       end case.
     1088                   end.
     1089                   hh = hh:next-sibling.
     1090               end.
     1091               b-help:column = v-frame-width - b-help:width-chars.
     1092               jj = 0.
     1093               repeat ii = 4 to 1 by -1 :
     1094                   if valid-handle (v-h[ii] ) then
     1095                   do:
     1096                       jj  = jj + 1 .
     1097                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1098                       v-h[ii]:row    = v-help-old-y .
     1099                   end.
     1100               end.
     1101           end.
     1102       end.
     1103   end procedure.
     1104   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1105   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1106   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1107   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1108   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1109   define variable v-diasize-current-frame-height as decimal   no-undo .
     1110   define variable v-diasize-change-size          as logical   no-undo .
     1111   define variable v-diasize-resize-button        as handle    no-undo .
     1112   define variable v-diasize-wndmax               as logical   no-undo .
     1113   define variable v-diasize-wndstore             as logical   no-undo .
     1114   define variable v-diasize-proc-name            as character no-undo .
     1115   define variable v-diasize-browse-handle        as handle    no-undo .
     1116   define variable v-diasize-browse-number        as integer   no-undo .
     1117   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1118   define temp-table temp-diasize-handle no-undo
     1119     field handle-value  as handle
     1120     field save-position as decimal
     1121     index xpk is primary unique handle-value
     1122     .
     1123   define temp-table temp-browse-handle no-undo
     1124     field browse-type   as character
     1125     field browse-number as integer
     1126     field browse-handle as handle
     1127     field original-size as decimal
     1128     index xpk is primary unique browse-type browse-number
     1129     index xie browse-type browse-handle
     1130   .
     1131   procedure diasize_change-height :
     1132     define input  parameter p-change-value  as decimal   no-undo .
     1133     define input  parameter p-move-resize   as logical   no-undo .
     1134     define variable v-field-group-handle    as handle    no-undo .
     1135     define variable v-object-handle         as handle    no-undo .
     1136     define variable v-frame-height          as decimal   no-undo .
     1137     define variable v-frame-virtual-height  as decimal   no-undo .
     1138     define variable v-browse-height         as decimal   no-undo .
     1139     define variable v-window-height         as decimal   no-undo .
     1140     define variable v-window-virtual-height as decimal   no-undo .
     1141     define variable v-change-sign           as integer   no-undo .
     1142     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1143     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1144     if p-change-value > 0
     1145     then do:
     1146       if frame Dialog-Frame :height + p-change-value
     1147           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1148       then do:
     1149         assign
     1150           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1151                           - (frame Dialog-Frame :height-chars)
     1152         .
     1153         if p-change-value <= 0
     1154         then do:
     1155           run diasize_position-resize-button in this-procedure .
     1156           return .
     1157         end.
     1158       end.
     1159     end.
     1160     if p-change-value < 0
     1161     then do:
     1162       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1163       then do:
     1164         assign
     1165           p-change-value = v-diasize-orig-frame-height
     1166                          - (frame Dialog-Frame :height-chars)
     1167         .
     1168         if p-change-value >= 0
     1169         then do:
     1170           run diasize_position-resize-button in this-procedure .
     1171           return .
     1172         end.
     1173       end.
     1174     end.
     1175     if p-change-value >= 0
     1176     then do:
     1177       assign
     1178         v-change-sign = 1
     1179       .
     1180     end.
     1181     else do:
     1182       assign
     1183         v-change-sign = -1
     1184       .
     1185     end.
     1186     assign
     1187       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1188     .
     1189     if p-change-value = 0
     1190     then do:
     1191       run diasize_position-resize-button in this-procedure .
     1192       return .
     1193     end.
     1194     move_block:
     1195     do
     1196     on error undo move_block, retry move_block
     1197     :
     1198       if retry
     1199       then do:
     1200         do
     1201         on error undo move_block, leave move_block
     1202         :
     1203           if p-change-value > 0
     1204           then do:
     1205             for each buf_temp-diasize-handle
     1206             on error undo, next
     1207             :
     1208               assign
     1209                 v-object-handle = buf_temp-diasize-handle.handle-value
     1210               .
     1211               if v-object-handle <> v-diasize-resize-button
     1212               then do:
     1213                 assign
     1214                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1215                 .
     1216               end.
     1217             end.
     1218             assign
     1219               v-diasize-browse-handle :height = v-browse-height
     1220             .
     1221             for each buf_temp-browse-handle
     1222               where buf_temp-browse-handle.browse-type = 'height':u
     1223             on error undo, next
     1224             :
     1225               assign
     1226                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1227               .
     1228             end.
     1229             assign
     1230               frame Dialog-Frame :height = v-frame-height
     1231             .
     1232             if frame Dialog-Frame :scrollable = true
     1233             then do:
     1234               assign
     1235                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1236               .
     1237             end.
     1238             run diasize_position-resize-button in this-procedure .
     1239           end.
     1240           else do:
     1241             if frame Dialog-Frame :scrollable = true
     1242             then do:
     1243               assign
     1244                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1245               .
     1246             end.
     1247             assign
     1248               frame Dialog-Frame :height = v-frame-height
     1249             .
     1250             assign
     1251               v-diasize-browse-handle :height = v-browse-height
     1252             .
     1253             for each buf_temp-browse-handle
     1254               where buf_temp-browse-handle.browse-type = 'height':u
     1255             on error undo, next
     1256             :
     1257               assign
     1258                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1259               .
     1260             end.
     1261             for each buf_temp-diasize-handle
     1262             on error undo, next
     1263             :
     1264               assign
     1265                 v-object-handle = buf_temp-diasize-handle.handle-value
     1266               .
     1267               if v-object-handle <> v-diasize-resize-button
     1268               then do:
     1269                 assign
     1270                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1271                 .
     1272               end.
     1273             end.
     1274             run diasize_position-resize-button in this-procedure .
     1275           end.
     1276           assign
     1277             v-diasize-change-size = false
     1278           .
     1279           leave move_block .
     1280         end.
     1281       end.
     1282       assign
     1283         v-diasize-need-full-display = true
     1284       .
     1285       if v-diasize-change-size = false
     1286       then do:
     1287         assign
     1288           v-diasize-change-size = true
     1289         .
     1290       end.
     1291       else do:
     1292         return .
     1293       end.
     1294       assign
     1295         v-frame-height = frame Dialog-Frame :height
     1296         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1297         v-browse-height = v-diasize-browse-handle :height
     1298       .
     1299       for each buf_temp-browse-handle
     1300         where buf_temp-browse-handle.browse-type = 'height':u
     1301       :
     1302         assign
     1303           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1304         .
     1305       end.
     1306       for each buf_temp-diasize-handle
     1307       :
     1308         delete buf_temp-diasize-handle .
     1309       end.
     1310       assign
     1311         v-field-group-handle = frame Dialog-Frame :first-child
     1312       .
     1313       do while valid-handle(v-field-group-handle)
     1314       :
     1315         assign
     1316           v-object-handle = v-field-group-handle :first-child
     1317         .
     1318         do while valid-handle(v-object-handle)
     1319         :
     1320           if  v-object-handle <> v-diasize-browse-handle :handle
     1321           and can-query(v-object-handle, "row")
     1322           and can-query(v-object-handle, "height")
     1323           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1324           then do:
     1325             find first buf_temp-browse-handle
     1326               where buf_temp-browse-handle.browse-type   = 'height':u
     1327                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1328               no-error .
     1329             if available buf_temp-browse-handle
     1330             then do:
     1331             end.
     1332             else do:
     1333               create buf_temp-diasize-handle .
     1334               assign
     1335                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1336                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1337               .
     1338             end.
     1339           end.
     1340           assign
     1341             v-object-handle = v-object-handle :next-sibling
     1342           .
     1343         end.
     1344         assign
     1345           v-field-group-handle = v-field-group-handle :next-sibling
     1346         .
     1347       end.
     1348       do with frame Dialog-Frame
     1349       :
     1350         hide v-diasize-resize-button .
     1351         assign
     1352           v-diasize-resize-button :row    = 1
     1353           v-diasize-resize-button :column = 1
     1354         .
     1355       end.
     1356       if p-change-value > 0
     1357       then do:
     1358         if frame Dialog-Frame :scrollable = true
     1359         then do:
     1360           assign
     1361             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1362             no-error .
     1363           if error-status :error
     1364           or error-status :get-message(1) <> ""
     1365           then do:
     1366             undo move_block, retry move_block .
     1367           end.
     1368         end.
     1369         assign
     1370           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1371           no-error .
     1372         if error-status :error
     1373         or error-status :get-message(1) <> ""
     1374         then do:
     1375           undo move_block, retry move_block .
     1376         end.
     1377         assign
     1378           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1379           no-error .
     1380         if error-status :error
     1381         or error-status :get-message(1) <> ""
     1382         then do:
     1383           undo move_block, retry move_block .
     1384         end.
     1385         for each buf_temp-browse-handle
     1386           where buf_temp-browse-handle.browse-type = 'height':u
     1387         on error undo move_block, retry move_block
     1388         :
     1389           assign
     1390             buf_temp-browse-handle.browse-handle :height
     1391               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1392             no-error .
     1393           if error-status :error
     1394           or error-status :get-message(1) <> ""
     1395           then do:
     1396             undo move_block, retry move_block .
     1397           end.
     1398         end.
     1399         for each buf_temp-diasize-handle
     1400         on error undo move_block, retry move_block
     1401         :
     1402           assign
     1403             v-object-handle = buf_temp-diasize-handle.handle-value
     1404           .
     1405           if v-object-handle <> v-diasize-resize-button
     1406           then do:
     1407             assign
     1408               v-object-handle :row = v-object-handle :row + p-change-value
     1409               no-error .
     1410             if error-status :error
     1411             or error-status :get-message(1) <> ""
     1412             then do:
     1413               undo move_block, retry move_block .
     1414             end.
     1415           end.
     1416         end.
     1417       end.
     1418       else do:
     1419         for each buf_temp-diasize-handle
     1420         on error undo move_block, retry move_block
     1421         :
     1422           assign
     1423             v-object-handle = buf_temp-diasize-handle.handle-value
     1424           .
     1425           if v-object-handle <> v-diasize-resize-button
     1426           then do:
     1427             assign
     1428               v-object-handle :row = v-object-handle :row + p-change-value
     1429               no-error .
     1430             if error-status :error
     1431             or error-status :get-message(1) <> ""
     1432             then do:
     1433               undo move_block, retry move_block .
     1434             end.
     1435           end.
     1436         end.
     1437         assign
     1438           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1439           no-error .
     1440         if error-status :error
     1441         or error-status :get-message(1) <> ""
     1442         then do:
     1443           undo move_block, retry move_block .
     1444         end.
     1445         for each buf_temp-browse-handle
     1446           where buf_temp-browse-handle.browse-type = 'height':u
     1447         on error undo move_block, retry move_block
     1448         :
     1449           assign
     1450             buf_temp-browse-handle.browse-handle :height
     1451               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1452             no-error .
     1453           if error-status :error
     1454           or error-status :get-message(1) <> ""
     1455           then do:
     1456             undo move_block, retry move_block .
     1457           end.
     1458         end.
     1459         assign
     1460           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1461           no-error .
     1462         if error-status :error
     1463         or error-status :get-message(1) <> ""
     1464         then do:
     1465           undo move_block, retry move_block .
     1466         end.
     1467         if frame Dialog-Frame :scrollable = true
     1468         then do:
     1469           assign
     1470             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1471             no-error .
     1472           if error-status :error
     1473           or error-status :get-message(1) <> ""
     1474           then do:
     1475             undo move_block, retry move_block .
     1476           end.
     1477         end.
     1478       end.
     1479       if p-move-resize = true
     1480       then do:
     1481         run diasize_position-resize-button in this-procedure .
     1482       end.
     1483       if v-diasize-wndstore = true
     1484       then do:
     1485         if connected("ub") = true
     1486         then do:
     1487           define variable v-cntxt-db-num        as integer   no-undo .
     1488           define variable v-cntxt-userid        as character no-undo .
     1489           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1490                                             , OUTPUT v-cntxt-userid
     1491                                             ) .
     1492           run gbl/wndsizew.p
     1493             (input  v-cntxt-db-num
     1494             ,input  v-cntxt-userid
     1495             ,input  v-diasize-proc-name
     1496             ,input  'height':u
     1497             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1498             ) .
     1499         end.
     1500       end.
     1501     end.
     1502     assign
     1503       v-diasize-change-size = false
     1504     .
     1505   end procedure.
     1506   procedure diasize_set-height :
     1507     define input  parameter p-new-height  as decimal   no-undo .
     1508     define input  parameter p-move-resize as logical   no-undo .
     1509     do
     1510     on error undo, return error return-value
     1511     :
     1512       run diasize_change-height in this-procedure
     1513         (input  (p-new-height - frame Dialog-Frame :height)
     1514         ,input  p-move-resize
     1515         ) .
     1516     end.
     1517   end procedure.
     1518   procedure diasize_change-width :
     1519     define input  parameter p-change-value as decimal   no-undo .
     1520     define input  parameter p-move-resize  as logical   no-undo .
     1521     define variable v-field-group-handle   as handle    no-undo .
     1522     define variable v-object-handle        as handle    no-undo .
     1523     define variable v-frame-width          as decimal   no-undo .
     1524     define variable v-frame-virtual-width  as decimal   no-undo .
     1525     define variable v-browse-width         as decimal   no-undo .
     1526     define variable v-window-width         as decimal   no-undo .
     1527     define variable v-window-virtual-width as decimal   no-undo .
     1528     define variable v-change-sign          as integer   no-undo .
     1529     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1530     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1531     if p-change-value > 0
     1532     then do:
     1533       if frame Dialog-Frame :width + p-change-value >
     1534           session :width-chars
     1535       then do:
     1536         assign
     1537           p-change-value = session :width-chars - frame Dialog-Frame :width
     1538         .
     1539         if p-change-value <= 0
     1540         then do:
     1541           run diasize_position-resize-button in this-procedure .
     1542           return .
     1543         end.
     1544       end.
     1545     end.
     1546     if p-change-value < 0
     1547     then do:
     1548       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1549       then do:
     1550         assign
     1551           p-change-value = v-diasize-orig-frame-width
     1552                          - frame Dialog-Frame :width
     1553         .
     1554         if p-change-value >= 0
     1555         then do:
     1556           run diasize_position-resize-button in this-procedure .
     1557           return .
     1558         end.
     1559       end.
     1560     end.
     1561     if p-change-value >= 0
     1562     then do:
     1563       assign
     1564         v-change-sign = 1
     1565       .
     1566     end.
     1567     else do:
     1568       assign
     1569         v-change-sign = -1
     1570       .
     1571     end.
     1572     assign
     1573       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1574     .
     1575     if p-change-value = 0
     1576     then do:
     1577       run diasize_position-resize-button in this-procedure .
     1578       return .
     1579     end.
     1580     move_block:
     1581     do
     1582     on error undo move_block, leave move_block
     1583     :
     1584       if retry
     1585       then do:
     1586         do
     1587         on error undo move_block, leave move_block
     1588         :
     1589           if p-change-value > 0
     1590           then do:
     1591             for each buf_temp-diasize-handle
     1592             on error undo, next
     1593             :
     1594               assign
     1595                 v-object-handle = buf_temp-diasize-handle.handle-value
     1596               .
     1597               if v-object-handle <> v-diasize-resize-button
     1598               then do:
     1599                 assign
     1600                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1601                 .
     1602               end.
     1603             end.
     1604             assign
     1605               v-diasize-browse-handle :width = v-browse-width
     1606             .
     1607             for each buf_temp-browse-handle
     1608               where buf_temp-browse-handle.browse-type = 'width':u
     1609             on error undo, next
     1610             :
     1611               assign
     1612                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1613               .
     1614             end.
     1615             assign
     1616               frame Dialog-Frame :width = v-frame-width
     1617             .
     1618             if frame Dialog-Frame :scrollable = true
     1619             then do:
     1620               assign
     1621                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1622               .
     1623             end.
     1624             run diasize_position-resize-button in this-procedure .
     1625           end.
     1626           else do:
     1627             if frame Dialog-Frame :scrollable = true
     1628             then do:
     1629               assign
     1630                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1631               .
     1632             end.
     1633             assign
     1634               frame Dialog-Frame :width = v-frame-width
     1635             .
     1636             for each buf_temp-browse-handle
     1637               where buf_temp-browse-handle.browse-type = 'width':u
     1638             on error undo, next
     1639             :
     1640               assign
     1641                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1642               .
     1643             end.
     1644             assign
     1645               v-diasize-browse-handle :width = v-browse-width
     1646             .
     1647             for each buf_temp-diasize-handle
     1648             on error undo, next
     1649             :
     1650               assign
     1651                 v-object-handle = buf_temp-diasize-handle.handle-value
     1652               .
     1653               if v-object-handle <> v-diasize-resize-button
     1654               then do:
     1655                 assign
     1656                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1657                 .
     1658               end.
     1659             end.
     1660             run diasize_position-resize-button in this-procedure .
     1661           end.
     1662           assign
     1663             v-diasize-change-size = false
     1664           .
     1665           leave move_block .
     1666         end.
     1667       end.
     1668       assign
     1669         v-diasize-need-full-display = true
     1670       .
     1671       if v-diasize-change-size = false
     1672       then do:
     1673         assign
     1674           v-diasize-change-size = true
     1675         .
     1676       end.
     1677       else do:
     1678         return .
     1679       end.
     1680       assign
     1681         v-frame-width = frame Dialog-Frame :width
     1682         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1683         v-browse-width = v-diasize-browse-handle :width
     1684       .
     1685       for each buf_temp-browse-handle
     1686         where buf_temp-browse-handle.browse-type = 'width':u
     1687       :
     1688         assign
     1689           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1690         .
     1691       end.
     1692       for each buf_temp-diasize-handle
     1693       :
     1694         delete buf_temp-diasize-handle .
     1695       end.
     1696       assign
     1697         v-field-group-handle = frame Dialog-Frame :first-child
     1698       .
     1699       do while valid-handle(v-field-group-handle)
     1700       :
     1701         assign
     1702           v-object-handle = v-field-group-handle :first-child
     1703         .
     1704         do while valid-handle(v-object-handle)
     1705         :
     1706           if  v-object-handle <> v-diasize-browse-handle :handle
     1707           and v-object-handle <> v-diasize-resize-button
     1708           and can-query(v-object-handle, "row")
     1709           and can-query(v-object-handle, "height")
     1710           and ( v-object-handle :col + v-object-handle :width
     1711                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1712               )
     1713           then do:
     1714             find first buf_temp-browse-handle
     1715               where buf_temp-browse-handle.browse-type   = 'width':u
     1716                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1717               no-error .
     1718             if available buf_temp-browse-handle
     1719             then do:
     1720             end.
     1721             else do:
     1722               create buf_temp-diasize-handle .
     1723               assign
     1724                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1725                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1726               .
     1727             end.
     1728           end.
     1729           assign
     1730             v-object-handle = v-object-handle :next-sibling
     1731           .
     1732         end.
     1733         assign
     1734           v-field-group-handle = v-field-group-handle :next-sibling
     1735         .
     1736       end.
     1737       do with frame Dialog-Frame
     1738       :
     1739         hide v-diasize-resize-button .
     1740         v-diasize-resize-button :row = 1.
     1741         v-diasize-resize-button :column = 1.
     1742       end.
     1743       if p-change-value > 0
     1744       then do:
     1745         if frame Dialog-Frame :scrollable = true
     1746         then do:
     1747           assign
     1748             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1749             no-error .
     1750           if error-status :error
     1751           or error-status :get-message(1) <> ""
     1752           then do:
     1753             undo move_block, retry move_block.
     1754           end.
     1755         end.
     1756         assign
     1757           frame Dialog-Frame :width = v-frame-width + p-change-value
     1758           no-error .
     1759         if error-status :error
     1760         or error-status :get-message(1) <> ""
     1761         then do:
     1762           undo move_block, retry move_block.
     1763         end.
     1764         assign
     1765           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1766         no-error .
     1767         if error-status :error
     1768         or error-status :get-message(1) <> ""
     1769         then do:
     1770           undo move_block, retry move_block.
     1771         end.
     1772         for each buf_temp-browse-handle
     1773           where buf_temp-browse-handle.browse-type = 'width':u
     1774         on error undo move_block, retry move_block
     1775         :
     1776           assign
     1777             buf_temp-browse-handle.browse-handle :width
     1778               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1779             no-error .
     1780           if error-status :error
     1781           or error-status :get-message(1) <> ""
     1782           then do:
     1783             undo move_block, retry move_block .
     1784           end.
     1785         end.
     1786         for each buf_temp-diasize-handle
     1787         on error undo move_block, retry move_block
     1788         :
     1789           assign
     1790             v-object-handle = buf_temp-diasize-handle.handle-value
     1791           .
     1792           if v-object-handle <> v-diasize-resize-button
     1793           then do:
     1794             assign
     1795               v-object-handle :col = v-object-handle :col + p-change-value
     1796               no-error .
     1797             if error-status :error
     1798             or error-status :get-message(1) <> ""
     1799             then do:
     1800               undo move_block, retry move_block .
     1801             end.
     1802           end.
     1803         end.
     1804       end.
     1805       else do:
     1806         for each buf_temp-diasize-handle
     1807         on error undo move_block, retry move_block
     1808         :
     1809           assign
     1810             v-object-handle = buf_temp-diasize-handle.handle-value
     1811           .
     1812           if v-object-handle <> v-diasize-resize-button
     1813           then do:
     1814             assign
     1815               v-object-handle :col = v-object-handle :col + p-change-value
     1816               no-error .
     1817             if error-status :error
     1818             or error-status :get-message(1) <> ""
     1819             then do:
     1820               undo move_block, retry move_block .
     1821             end.
     1822           end.
     1823         end.
     1824         for each buf_temp-browse-handle
     1825           where buf_temp-browse-handle.browse-type = 'width':u
     1826         on error undo move_block, retry move_block
     1827         :
     1828           assign
     1829             buf_temp-browse-handle.browse-handle :width
     1830               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1831             no-error .
     1832           if error-status :error
     1833           or error-status :get-message(1) <> ""
     1834           then do:
     1835             undo move_block, retry move_block .
     1836           end.
     1837         end.
     1838         assign
     1839           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1840           no-error .
     1841         if error-status :error
     1842         or error-status :get-message(1) <> ""
     1843         then do:
     1844           undo move_block, retry move_block.
     1845         end.
     1846         assign
     1847           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1848         no-error .
     1849         if error-status :error
     1850         or error-status :get-message(1) <> ""
     1851         then do:
     1852           undo move_block, retry move_block.
     1853         end.
     1854         if frame Dialog-Frame :scrollable = true
     1855         then do:
     1856           assign
     1857             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1858           no-error .
     1859           if error-status :error
     1860           or error-status :get-message(1) <> ""
     1861           then do:
     1862             undo move_block, retry move_block.
     1863           end.
     1864         end.
     1865       end.
     1866       if p-move-resize
     1867       then do:
     1868         run diasize_position-resize-button in this-procedure .
     1869       end.
     1870       if v-diasize-wndstore = true
     1871       then do:
     1872         if connected("ub") = true
     1873         then do:
     1874           define variable v-cntxt-db-num        as integer   no-undo .
     1875           define variable v-cntxt-userid        as character no-undo .
     1876           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1877                                             , OUTPUT v-cntxt-userid
     1878                                             ) .
     1879           run gbl/wndsizew.p
     1880             (input  v-cntxt-db-num
     1881             ,input  v-cntxt-userid
     1882             ,input  v-diasize-proc-name
     1883             ,input  'width':u
     1884             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1885             ) .
     1886         end.
     1887       end.
     1888     end.
     1889     assign
     1890       v-diasize-change-size = false
     1891     .
     1892   end procedure.
     1893   procedure diasize_set-width :
     1894     define input  parameter p-new-width  as decimal   no-undo .
     1895     define input  parameter p-move-resize as logical   no-undo .
     1896     do
     1897     on error undo, return error return-value
     1898     :
     1899       run diasize_change-width in this-procedure
     1900         (input  (p-new-width - frame Dialog-Frame :width)
     1901         ,input  p-move-resize
     1902         ) .
     1903     end.
     1904   end procedure.
     1905   procedure diasize_position-resize-button :
     1906     do with frame Dialog-Frame
     1907     :
     1908       hide v-diasize-resize-button .
     1909       assign
     1910         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1911                     - 1
     1912                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1913         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1914                     - 1
     1915                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1916       .
     1917       view v-diasize-resize-button .
     1918     end.
     1919   end procedure.
     1920   on alt-right anywhere
     1921   do:
     1922     run diasize_change-width in this-procedure
     1923       (input 1
     1924       ,input true
     1925       ) .
     1926     return no-apply .
     1927   end.
     1928   on alt-left anywhere
     1929   do:
     1930     run diasize_change-width in this-procedure
     1931       (input -1
     1932       ,input true
     1933       ) .
     1934     return no-apply .
     1935   end.
     1936   on alt-down anywhere
     1937   do:
     1938     run diasize_change-height in this-procedure
     1939       (input 1
     1940       ,input true
     1941       ) .
     1942     return no-apply .
     1943   end.
     1944   on alt-up anywhere
     1945   do:
     1946     run diasize_change-height in this-procedure
     1947       (input -1
     1948       ,input true
     1949       ) .
     1950     return no-apply .
     1951   end.
     1952   on alt-enter of frame Dialog-Frame
     1953   do:
     1954     run diasize_maximize in this-procedure
     1955       (input  ?
     1956       ).
     1957     return no-apply .
     1958   end.
     1959   procedure diasize_end-move :
     1960     do
     1961     on error undo, return error return-value
     1962     :
     1963       define variable v-row-delta as decimal   no-undo .
     1964       define variable v-col-delta as decimal   no-undo .
     1965       define variable v-new-row as decimal   no-undo .
     1966       define variable v-new-col as decimal   no-undo .
     1967       assign
     1968         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1969         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1970       .
     1971       assign
     1972         v-row-delta = v-new-row - frame Dialog-Frame :height
     1973         v-col-delta = v-new-col - frame Dialog-Frame :width
     1974       .
     1975       run diasize_change-height in this-procedure
     1976         (input v-row-delta
     1977         ,input true
     1978         ) .
     1979       run diasize_change-width in this-procedure
     1980         (input v-col-delta
     1981         ,input true
     1982         ) .
     1983     end.
     1984   end procedure.
     1985   procedure diasize_maximize :
     1986     define input  parameter p-action as logical   no-undo .
     1987     do
     1988     on error undo, return error return-value
     1989     :
     1990       if p-action = ?
     1991       then do:
     1992         if v-diasize-need-maximize = true
     1993         then do:
     1994           assign
     1995             p-action = true
     1996           .
     1997         end.
     1998         else do:
     1999           assign
     2000             p-action = false
     2001           .
     2002         end.
     2003       end.
     2004       if p-action = true
     2005       then do:
     2006         run diasize_change-height in this-procedure
     2007           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2008               - frame Dialog-Frame :height-chars
     2009           ,input true
     2010           ) .
     2011         run diasize_change-width in this-procedure
     2012           (input session :width-chars
     2013               - frame Dialog-Frame :width-chars
     2014           ,input true
     2015           ) .
     2016         assign
     2017           v-diasize-need-maximize = false
     2018         .
     2019       end.
     2020       else do:
     2021         run diasize_change-width in this-procedure
     2022           (input v-diasize-orig-frame-width
     2023               - frame Dialog-Frame :width-chars
     2024           ,input true
     2025           ) .
     2026         run diasize_change-height in this-procedure
     2027           (input v-diasize-orig-frame-height
     2028               - frame Dialog-Frame :height-chars
     2029           ,input true
     2030           ) .
     2031         assign
     2032           v-diasize-need-maximize = true
     2033         .
     2034       end.
     2035     end.
     2036   end procedure.
     2037   procedure diasize_restore-orig-size :
     2038     do
     2039     on error undo, return error return-value
     2040     :
     2041       assign
     2042         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2043         v-diasize-current-frame-height = frame Dialog-Frame :height
     2044       .
     2045       run diasize_set-height in this-procedure
     2046         (input  v-diasize-orig-frame-height
     2047         ,input  true
     2048         ) .
     2049       run diasize_set-width in this-procedure
     2050         (input  v-diasize-orig-frame-width
     2051         ,input  true
     2052         ) .
     2053     end.
     2054   end procedure.
     2055   procedure diasize_restore-current-size :
     2056     do
     2057     on error undo, return error return-value
     2058     :
     2059       run diasize_set-height in this-procedure
     2060         (input  v-diasize-current-frame-height
     2061         ,input  true
     2062         ) .
     2063       run diasize_set-width in this-procedure
     2064         (input  v-diasize-current-frame-width
     2065         ,input  true
     2066         ) .
     2067     end.
     2068   end procedure.
     2069   procedure diasize_set-browse-handle :
     2070     define input  parameter p-browse-handle as handle   no-undo .
     2071     define buffer buf_temp-browse-handle for temp-browse-handle .
     2072     do
     2073     on error undo, return error return-value
     2074     :
     2075       assign
     2076         v-diasize-browse-handle = p-browse-handle
     2077       .
     2078       for each buf_temp-browse-handle
     2079       on error undo, return error return-value
     2080       :
     2081         delete buf_temp-browse-handle .
     2082       end.
     2083     end.
     2084   end procedure.
     2085   procedure diasize_add_browse :
     2086     define input  parameter p-browse-type   as character no-undo .
     2087     define input  parameter p-browse-handle as handle    no-undo .
     2088     define buffer buf_temp-browse-handle for temp-browse-handle .
     2089     do
     2090     on error undo, return error return-value
     2091     :
     2092       assign
     2093         v-diasize-browse-number = v-diasize-browse-number + 1
     2094       .
     2095       create buf_temp-browse-handle .
     2096       assign
     2097         buf_temp-browse-handle.browse-type   = p-browse-type
     2098         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2099         buf_temp-browse-handle.browse-handle = p-browse-handle
     2100       .
     2101     end.
     2102   end procedure.
     2103   procedure diasize_init :
     2104     define variable v-default-value    as logical   no-undo .
     2105     define variable v-restore-saved    as logical   no-undo .
     2106     define variable v-resize-value-str as character no-undo .
     2107     do
     2108     on error undo, return error return-value
     2109     :
     2110       do with frame Dialog-Frame
     2111       :
     2112         assign
     2113           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2114           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2115           v-diasize-browse-handle     = browse br-region :handle
     2116         .
     2117         create button v-diasize-resize-button
     2118         assign
     2119           parent        = frame Dialog-Frame :first-child
     2120           label         = "s"
     2121           height-pixels = 16
     2122           width-pixels  = 16
     2123           visible       = true
     2124           sensitive     = true
     2125           movable       = true
     2126           triggers:
     2127             on end-move persistent run diasize_end-move in this-procedure .
     2128           end triggers.
     2129         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2130         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2131         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2132         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2133         assign
     2134           v-diasize-wndmax = false
     2135         .
     2136         if connected("ub") = true
     2137         then do:
     2138           define variable v-cntxt-db-num        as integer   no-undo .
     2139           define variable v-cntxt-userid        as character no-undo .
     2140           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2141                                             , OUTPUT v-cntxt-userid
     2142                                             ) .
     2143           run gbl/wndpar_r.p
     2144             (input  v-cntxt-db-num
     2145             ,input  v-cntxt-userid
     2146             ,input  'wndmax':U
     2147             ,output v-diasize-wndmax
     2148             ,output v-default-value
     2149             ) .
     2150         end.
     2151         assign
     2152           v-diasize-wndstore = false
     2153         .
     2154         if connected("ub") = true
     2155         then do:
     2156           run gbl/wndpar_r.p
     2157             (input  v-cntxt-db-num
     2158             ,input  v-cntxt-userid
     2159             ,input  'wndstore':U
     2160             ,output v-diasize-wndstore
     2161             ,output v-default-value
     2162             ) .
     2163         end.
     2164         assign
     2165           v-diasize-proc-name = entry(1, program-name(2), '.')
     2166         .
     2167         if v-diasize-wndstore = true
     2168         then do:
     2169           assign
     2170             v-restore-saved = false
     2171           .
     2172           if connected("ub") = true
     2173           then do:
     2174             run gbl/wndsizer.p
     2175               (input  v-cntxt-db-num
     2176               ,input  v-cntxt-userid
     2177               ,input  v-diasize-proc-name
     2178               ,input  'height':u
     2179               ,output v-resize-value-str
     2180               ) .
     2181             if v-resize-value-str <> '':U
     2182             then do:
     2183               run diasize_change-height in this-procedure
     2184                 (input  integer(v-resize-value-str)
     2185                 ,input  true
     2186                 ) .
     2187               assign
     2188                 v-restore-saved = true
     2189               .
     2190             end.
     2191           end.
     2192           if connected("ub") = true
     2193           then do:
     2194             run gbl/wndsizer.p
     2195               (input  v-cntxt-db-num
     2196               ,input  v-cntxt-userid
     2197               ,input  v-diasize-proc-name
     2198               ,input  'width':u
     2199               ,output v-resize-value-str
     2200               ) .
     2201             if v-resize-value-str <> '':U
     2202             then do:
     2203               run diasize_change-width in this-procedure
     2204                 (input  integer(v-resize-value-str)
     2205                 ,input  true
     2206                 ) .
     2207               assign
     2208                 v-restore-saved = true
     2209               .
     2210             end.
     2211           end.
     2212           if v-restore-saved <> true
     2213           then do:
     2214             if v-diasize-wndmax = true
     2215             then do:
     2216               run diasize_maximize in this-procedure
     2217                 (input  true
     2218                 ) .
     2219             end.
     2220           end.
     2221         end.
     2222         else do:
     2223           if v-diasize-wndmax = true
     2224           then do:
     2225             run diasize_maximize in this-procedure
     2226               (input  true
     2227               ) .
     2228           end.
     2229         end.
     2230       end.
     2231     end.
     2232   end procedure.
     2233   procedure diasize_need-full-display :
     2234     define output parameter p-need-full-display as logical   no-undo .
     2235     do
     2236     on error undo, return error return-value
     2237     :
     2238       assign
     2239         p-need-full-display = v-diasize-need-full-display
     2240       .
     2241       assign
     2242         v-diasize-need-full-display = false
     2243       .
     2244     end.
     2245   end procedure.
     2246   procedure get-context :
     2247      define output parameter p-db-num as integer          no-undo.
     2248      define output parameter p-user-id as character        no-undo.
     2249      define variable v-login               as character    no-undo.
     2250      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2251      define buffer buf_user-login  for ub.user-login .
     2252      do
     2253      on error undo, return error
     2254      :
     2255            FIND FIRST buf_sys-ctrl no-lock.
     2256            ASSIGN
     2257               v-login = USERID("ub")
     2258               p-db-num = buf_sys-ctrl.db-num
     2259            .
     2260            FIND FIRST buf_user-login
     2261                 WHERE buf_user-login.db-num = p-db-num
     2262                   AND buf_user-login.user-login = v-login
     2263                 no-lock
     2264                 no-error
     2265                 .
     2266            IF AVAILABLE buf_user-login
     2267            THEN DO:
     2268               assign
     2269                  p-user-id = buf_user-login.user-id
     2270               .
     2271            END.
     2272      end.
     2273   end procedure.
     2274       run diasize_init in this-procedure .
     2275   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2276   on F2 of frame Dialog-Frame anywhere do:
     2277     if b-exit :sensitive then DO: apply "CHOOSE":U to b-exit in frame Dialog-Frame. END.
     2278     return no-apply.
     2279   end.
     2280   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2281   on INS of frame Dialog-Frame anywhere do:
     2282     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2283     return no-apply.
     2284   end.
     2285   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2286   on F2 of frame Dialog-Frame anywhere do:
     2287     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2288     return no-apply.
     2289   end.
     2290   MAIN-BLOCK:
     2291   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2292      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2293     RUN my-enable in this-procedure .
     2294     WAIT-FOR GO OF FRAME Dialog-Frame.
     2295   END.
     2296   RUN my-disable.
     2297   PROCEDURE disable_UI :
     2298     HIDE FRAME Dialog-Frame.
     2299   END PROCEDURE.
     2300   PROCEDURE enable_UI :
     2301     DISPLAY mark-num
     2302         WITH FRAME Dialog-Frame.
     2303     ENABLE B-exit B-sel b-mark b-print B-Help br-region mark-num
     2304         WITH FRAME Dialog-Frame.
     2305     VIEW FRAME Dialog-Frame.
     2306     OPEN QUERY br-region FOR EACH buf_regions NO-LOCK INDEXED-REPOSITION.
     2307   END PROCEDURE.
     2308   PROCEDURE my-disable :
     2309     run disable_UI in this-procedure .
     2310   END PROCEDURE.
     2311   PROCEDURE my-enable :
     2312     enable
     2313       b-exit
     2314       b-sel     when (p-mode = 'выбор':U)
     2315       b-help
     2316       b-print
     2317       br-region
     2318       mark-num
     2319     with frame Dialog-Frame.
     2320     hide
     2321       mark-num
     2322     in frame Dialog-Frame.
     2323     view frame Dialog-Frame.
     2324     OPEN QUERY br-region FOR EACH buf_regions NO-LOCK INDEXED-REPOSITION.
     2325   END PROCEDURE.
     2326   PROCEDURE proc-b-print :
     2327   define variable v-line            as character no-undo .
     2328   define variable v-curr-doc-rowid  as rowid     no-undo .
     2329   define frame reg-frame
     2330     sym1                 column-label ":"         format "X(1)"   space(0)
     2331     buf_regions.reg-code column-label "Код"       format "zz9"    space(0)
     2332     sym2                 column-label ":"         format "X(1)"   space(0)
     2333     buf_regions.reg-name column-label "Название"  format "X(120)" space(0)
     2334     sym3                 column-label ":"         format "X(1)"   space(0)
     2335   header
     2336     string( "Страница " ) format "x(9)" at 100 page-number(prnlibstream) at 115 format ">>9" skip
     2337     v-line format "x(126)" at 1
     2338   with width 160 down stream-io use-text.
     2339   form header
     2340     v-line format "x(126)" at 1 skip
     2341     "Продолжение - на следующей странице" at 30 skip
     2342   with frame bottomframe width 160 page-bottom no-labels no-box .
     2343   assign
     2344     v-line = fill("-", 300)
     2345   .
     2346   run prn-lib-open-stream  in this-procedure ( input parParentProc
     2347                                              , input 62
     2348                                              , input yes
     2349                                              , input no
     2350                                              ).
     2351   view  stream prnlibstream frame bottomframe .
     2352   put stream prnlibstream "РЕГИОНЫ РФ":U at center-field(1,126, length("РЕГИОНЫ РФ":U)) skip(2).
     2353   assign
     2354     v-curr-doc-rowid = rowid( buf_regions )
     2355   .
     2356   do while available buf_regions :
     2357     get prev br-region.
     2358   end.
     2359   get next br-region.
     2360   do while available buf_regions :
     2361     display stream prnlibstream
     2362       sym1
     2363       buf_regions.reg-code
     2364       sym2
     2365       buf_regions.reg-name
     2366       sym3
     2367     with frame reg-frame.
     2368     down stream prnlibstream with frame reg-frame.
     2369     get next br-region.
     2370   end.
     2371   put stream prnlibstream v-line format "x(126)" at 1 .
     2372   hide  stream prnlibstream frame bottomframe .
     2373   output  stream prnlibstream close.
     2374   reposition br-region to rowid v-curr-doc-rowid no-error.
     2375   apply "display" to br-region in frame Dialog-Frame.
     2376   run waitfram-hide in this-procedure .
     2377   run prn-lib-prn-file in this-procedure ( input parparentproc
     2378                                          , input 8
     2379                                          ).
     2380   END PROCEDURE.
     2381   FUNCTION mark-str-regions RETURNS CHARACTER
     2382     ( buffer buf_regions for ub.regions, input v-regions-mark-list as character) :
     2383     RETURN (if ( lookup( string( recid( buf_regions ) ) , v-regions-mark-list ) ) > 0 then "*":u else '':u ).
     2384   END FUNCTION.
