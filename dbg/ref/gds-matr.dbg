     2477   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     2478   DO:
     2479   define variable is-many as logical   no-undo .
     2480     if del-option = "":U then do:
     2481        run gbl/pop-up.p ( input self :handle, input yes ) no-error.
     2482        if error-status :error then do:
     2483        return no-apply. end.
     2484     end.
     2485     if del-option = "":U then do:
     2486         return no-apply.
     2487     end.
     2488   if del-option = "list":U then do:
     2489   assign
     2490     p-rid-list = ""
     2491     del-option = ""
     2492   .
     2493     run str/gds-list.w (input parparentproc, input v-cntxt-host-code-obj, input v-cntxt-obj-type, input v-cntxt-obj-code ) no-error .
     2494     for each gds-list :
     2495        find first buf_matrix-goods
     2496        where buf_matrix-goods.gds-code = gds-list.gds-code
     2497        and Buf_matrix-goods.db-num = p-db-num
     2498        and Buf_matrix-goods.asmt-id = p-id
     2499        no-error.
     2500        if available buf_matrix-goods then do :
     2501              if p-rid-list = "" then do :
     2502                 assign p-rid-list = string( recid(Buf_matrix-goods)) .
     2503              end.
     2504              else do :
     2505                 assign p-rid-list = p-rid-list + "," + string( recid(Buf_matrix-goods)) .
     2506              end.
     2507        end.
     2508        else do :
     2509           message
     2510             substitute( "Выбранный товар &1 &2", gds-list.artic, gds-list.gds-name ) skip
     2511             "не входит в данную Ассортиментную матрицу"
     2512           view-as alert-box information.
     2513        end.
     2514     end.
     2515     run ver-db no-error .
     2516     if error-status :error then return no-apply .
     2517     assign is-many = true .
     2518   end.
     2519   else do :
     2520     assign
     2521       is-many = false
     2522       del-option = ""
     2523     .
     2524     if  buf_matrix.asmt-status = 1  then do:
     2525         message "Корректировать и удалять можно  в  АССОРТИМЕНТНОЙ МАТРИЦЕ в статусе тек."
     2526         view-as alert-box information .
     2527         return no-apply.
     2528     end.
     2529     run ver-db no-error .
     2530     if error-status :error then return no-apply .
     2531     if num-entries(p-rid-list) > 0 then do:
     2532       message "Удалять выделенные записи ?"
     2533       view-as alert-box question
     2534       Buttons yes-no update v-logq as log.
     2535       if v-logq = false then return .
     2536       assign is-many = true .
     2537     end.
     2538   end.
     2539   run proc-b-del in this-procedure ( p-rid-list , is-many ) no-error.
     2540   if error-status:error then return no-apply.
     2541   END.
     2542   ON CHOOSE OF B-grpAcc IN FRAME Dialog-Frame
     2543   DO:
     2544   run ver-db no-error .
     2545   if error-status :error then return no-apply .
     2546   if  buf_matrix.asmt-status = 1  then do:
     2547       message "Корректировать можно  в  АССОРТИМЕНТНОЙ МАТРИЦЕ в статусе тек."
     2548       view-as alert-box information .
     2549       return no-apply.
