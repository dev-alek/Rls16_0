     3975             run gbl/wndsizer.p
     3976               (input  v-cntxt-db-num
     3977               ,input  v-cntxt-userid
     3978               ,input  v-diasize-proc-name
     3979               ,input  'height':u
     3980               ,output v-resize-value-str
     3981               ) .
     3982             if v-resize-value-str <> '':U
     3983             then do:
     3984               run diasize_change-height in this-procedure
     3985                 (input  integer(v-resize-value-str)
     3986                 ,input  true
     3987                 ) .
     3988               assign
     3989                 v-restore-saved = true
     3990               .
     3991             end.
     3992           end.
     3993           if connected("ub") = true
     3994           then do:
     3995             run gbl/wndsizer.p
     3996               (input  v-cntxt-db-num
     3997               ,input  v-cntxt-userid
     3998               ,input  v-diasize-proc-name
     3999               ,input  'width':u
     4000               ,output v-resize-value-str
     4001               ) .
     4002             if v-resize-value-str <> '':U
