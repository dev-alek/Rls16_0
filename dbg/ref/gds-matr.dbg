     2627     assign
     2628       entry( v-num-entry30, p-rid-list ) = "":U
     2629       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2630     .
     2631   end.
     2632   else do:
     2633     assign
     2634       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid30
     2635     .
     2636   end.
     2637       end.
     2638   END.
     2639   ELSE DO:
     2640       for each buf_Matrix-goods no-lock where  buf_matrix-goods.db-num = p-db-num  and buf_matrix-goods.asmt-id = p-id and buf_matrix-goods.asmg-status = p-sts :
     2641   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2642   define variable v-str-recid32 as character no-undo .
     2643   define variable v-num-entry32 as integer   no-undo .
     2644   assign
     2645     v-str-recid32 = trim( string( recid( buf_Matrix-goods ) , "->>>>>>>>>>>9":U ) )
     2646     v-num-entry32 = lookup( v-str-recid32 , p-rid-list )
     2647   .
     2648   if v-num-entry32 > 0 then do:
     2649     assign
     2650       entry( v-num-entry32, p-rid-list ) = "":U
     2651       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2652     .
     2653   end.
     2654   else do:
