     4047   procedure get-context :
     4048      define output parameter p-db-num as integer          no-undo.
     4049      define output parameter p-user-id as character        no-undo.
     4050      define variable v-login               as character    no-undo.
     4051      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4052      define buffer buf_user-login  for ub.user-login .
     4053      do
     4054      on error undo, return error
     4055      :
     4056            FIND FIRST buf_sys-ctrl no-lock.
     4057            ASSIGN
     4058               v-login = USERID("ub")
     4059               p-db-num = buf_sys-ctrl.db-num
     4060            .
     4061            FIND FIRST buf_user-login
     4062                 WHERE buf_user-login.db-num = p-db-num
     4063                   AND buf_user-login.user-login = v-login
     4064                 no-lock
     4065                 no-error
     4066                 .
     4067            IF AVAILABLE buf_user-login
     4068            THEN DO:
     4069               assign
     4070                  p-user-id = buf_user-login.user-id
     4071               .
     4072            END.
     4073      end.
     4074   end procedure.
     4075       run diasize_init in this-procedure .
     4076   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4077   on f5 of frame Dialog-Frame anywhere
     4078   do:
     4079      assign v-doc-rec = ?. if available Buf_matrix-goods then v-doc-rec = recid(Buf_matrix-goods). run OpenBr. reposition BROWSE-am-goods to recid v-doc-rec no-error. apply 'entry' to BROWSE-am-goods.
     4080       apply "VALUE-CHANGED" to BROWSE-am-goods.
     4081   end.
     4082   def var sort-labelBROWSE-am-goods   as character no-undo .
     4083   def var sort-clmnBROWSE-am-goods    as handle    no-undo .
     4084   def var cur-clmnBROWSE-am-goods     as handle    no-undo .
     4085   def var cur-clmn-locBROWSE-am-goods as integer   no-undo .
     4086   def var re-queryBROWSE-am-goods     as logical   initial no no-undo .
     4087   on start-search, ctrl-o of BROWSE-am-goods in frame Dialog-Frame do:
     4088      run sort-brBROWSE-am-goods
     4089        (input (if available buf_Matrix
     4090                then recid(buf_Matrix)
     4091                else ?
     4092               )
     4093        ).
     4094   end.
     4095   PROCEDURE sort-brBROWSE-am-goods :
     4096     define input parameter p-recid as recid no-undo .
     4097     if re-queryBROWSE-am-goods = no then do:
     4098       assign
     4099          cur-clmnBROWSE-am-goods = BROWSE-am-goods:current-column in frame Dialog-Frame
     4100       .
     4101       if sort-clmnBROWSE-am-goods <> ? then sort-clmnBROWSE-am-goods:column-fgcolor = 0.
     4102       if cur-clmnBROWSE-am-goods = sort-clmnBROWSE-am-goods then do:
     4103         assign
     4104            sort-labelBROWSE-am-goods = ""
     4105            sort-clmnBROWSE-am-goods = ?
     4106         .
     4107        end.
     4108        else do:
     4109          assign
     4110            sort-labelBROWSE-am-goods = cur-clmnBROWSE-am-goods:label
     4111            sort-clmnBROWSE-am-goods  = cur-clmnBROWSE-am-goods
     4112            sort-clmnBROWSE-am-goods:column-fgcolor = 4
     4113          .
     4114        end.
     4115      end.
     4116     assign
     4117       cur-clmn-locBROWSE-am-goods = 1
     4118     .
     4119     def var column-handle as handle no-undo .
     4120     column-handle = BROWSE-am-goods:first-column.
     4121     do while valid-handle(column-handle) :
     4122       if column-handle = cur-clmnBROWSE-am-goods then do:
     4123         leave .
     4124       end.
     4125       column-handle = column-handle:NEXT-COLUMN.
     4126       assign
     4127         cur-clmn-locBROWSE-am-goods = cur-clmn-locBROWSE-am-goods + 1
     4128       .
     4129     end.
     4130     case sort-labelBROWSE-am-goods:
     4131           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(buf_Matrix-goods), &1&2&1)', chr(34), p-rid-list)     .     run OpenBr.   . END.
     4132           when 'Артикул! '  then DO:    assign       sort-column-name = "Buf_goods.artic"     .     run OpenBr.   . END.
     4133           when 'Название! '  then DO:    assign       sort-column-name = "Buf_goods.gds-name"     .     run OpenBr.   . END.
     4134           when 'Кто!изменил'  then DO:    assign       sort-column-name = "Buf_matrix-goods.asmg-who-update"     .     run OpenBr.   . END.
     4135           when 'Дата!изменения'  then DO:    assign       sort-column-name = "Buf_matrix-goods.asmg-date-update"     .     run OpenBr.   . END.
     4136           when 'Время!изм '  then DO:    assign       sort-column-name = "STRING(buf_Matrix-goods.asmg-time-update,'HH:MM')"     .     run OpenBr.   . END.
     4137           when 'БД!изм'  then DO:    assign       sort-column-name = "Buf_matrix-goods.asmg-db-num-update"     .     run OpenBr.   . END.
     4138           when 'Дата!создания'  then DO:    assign       sort-column-name = "Buf_matrix-goods.asmg-date-create"     .     run OpenBr.   . END.
     4139           when 'Время! '  then DO:    assign       sort-column-name = "STRING(buf_Matrix-goods.asmg-time-create,'HH:MM')"     .     run OpenBr.   . END.
     4140           when 'Кто!создал'  then DO:    assign       sort-column-name = "Buf_matrix-goods.asmg-who-create"     .     run OpenBr.   . END.
     4141           when 'БД!соз'  then DO:    assign       sort-column-name = "Buf_matrix-goods.asmg-db-num-create"     .     run OpenBr.   . END.
     4142           when 'Статус! '  then DO:    assign       sort-column-name = "entry (lookup (STRING(buf_Matrix-goods.asmg-status), '0,1,50,99':U), 'тек,удал,блок,удаление':U)"     .     run OpenBr.   . END.
     4143           when 'ИЖТ! '  then DO:   assign       sort-column-name = substitute('dynamic-function(&1indicator-life-gds&1, recid(buf_Matrix-goods))', chr(34))     .     run OpenBr.   . END.
     4144           when 'Acc!Min'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1assort-min&1,recid(buf_Matrix-goods))',chr(34))     .     run OpenBr.   . END.
     4145           when 'Группа! '  then DO:    assign       sort-column-name = "Buf_goods.grp-name"     .     run OpenBr.   . END.
     4146           when ' !Ш'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1f-shablon&1,recid(buf_Matrix-goods))',chr(34))     .     run OpenBr.   . END.
     4147       otherwise do:
     4148         assign
     4149           sort-column-name = ""
     4150         .
     4151         run OpenBr.
     4152         if sort-labelBROWSE-am-goods <> "" then do:
     4153           assign
     4154             cur-clmnBROWSE-am-goods:column-fgcolor = 0
     4155           .
     4156         end.
     4157         assign
     4158           cur-clmn-locBROWSE-am-goods = ?
     4159         .
     4160       end.
     4161     end case.
     4162     if p-recid <> ? then do:
     4163       reposition BROWSE-am-goods to recid p-recid no-error.
     4164       apply "value-changed" to BROWSE-am-goods in frame Dialog-Frame.
     4165     end.
     4166     apply "entry" to BROWSE-am-goods in frame Dialog-Frame.
     4167   END PROCEDURE.
     4168   procedure re-open-query-srt-clmnBROWSE-am-goods:
     4169   if cur-clmnBROWSE-am-goods = ? then do:
     4170      run OpenBr.
     4171   end.
     4172   else do:
     4173      assign re-queryBROWSE-am-goods = yes.
     4174      run sort-brBROWSE-am-goods
     4175        (input (if available buf_Matrix
     4176                then recid(buf_Matrix)
     4177                else ?
     4178               )
     4179        ).
     4180      assign re-queryBROWSE-am-goods = no.
     4181   end.
     4182   end.
     4183   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4184   on F9 of frame Dialog-Frame anywhere do:
