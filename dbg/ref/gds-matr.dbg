       19   define variable is-objLink as logical   no-undo .
       20   define variable is-objLink-id as integer   no-undo .
       21   define variable is-objLink-db as integer   no-undo .
       22   define variable del-option     as character no-undo .
       23   define buffer buf_matrix for ub.assortment-matrix .
       24   find first buf_matrix no-lock where
       25              buf_matrix.asmt-id  = p-id     and
       26              buf_matrix.db-num   = p-db-num no-error .
       27   define variable vss-revision    as character no-undo init "$Revision$":U .
       28   define variable vss-author      as character no-undo init "$Author$":U .
       29   define variable vss-date        as character no-undo init "$Date$":U .
       30   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       31   define variable vss-archive     as character no-undo init "$Archive$":U .
       32   define variable vss-description as character no-undo init "Ассортиментныая матрица".
       33   procedure vss-get-info :
       34     define output parameter p-vss-revision    like vss-revision    no-undo .
       35     define output parameter p-vss-author      like vss-author      no-undo .
       36     define output parameter p-vss-date        like vss-date        no-undo .
       37     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       38     define output parameter p-vss-archive     like vss-archive     no-undo .
       39     define output parameter p-vss-description like vss-description no-undo .
       40     assign
       41       p-vss-revision    = vss-revision
       42       p-vss-author      = vss-author
       43       p-vss-date        = vss-date
       44       p-vss-workfile    = vss-workfile
       45       p-vss-archive     = vss-archive
       46       p-vss-description = vss-description
       47     .
       48   end procedure.
       49   procedure vss-get-parameters :
       50     define output parameter p-vss-parameters as character no-undo .
       51   end procedure.
       52   define new global shared variable g#vssrevis-logger as handle    no-undo .
       53   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       54   define variable v-vssrevis-logger                   as handle    no-undo .
       55   procedure vss-logevent :
       56     define input  parameter p-extra-paramters as character no-undo .
       57     define variable v-vssrevis-parameters as character no-undo .
       58     do
       59     on error undo, return error return-value
       60     :
       61       if  valid-handle(v-vssrevis-logger)
       62       and v-vssrevis-logger :get-signature("logevent") <> ""
       63       then do:
       64         run vss-get-parameters in this-procedure
       65           (output v-vssrevis-parameters
       66           ).
       67         run logevent in v-vssrevis-logger
       68           (input vss-workfile
       69           ,input vss-revision
       70           ,input v-vssrevis-parameters
       71           ,input p-extra-paramters
       72           ).
       73       end.
       74     end.
       75   end procedure.
       76   assign
       77     v-vssrevis-logger = g#vssrevis-logger
       78   .
       79   if  valid-handle(v-vssrevis-logger)
       80   and v-vssrevis-logger :get-signature("logevent") <> ""
       81   then do:
       82     assign
       83       v-vssrevis-logevent = true
       84     .
       85     run vss-logevent in this-procedure (input vss-description) .
       86   end.
       87   define new global shared variable g#language as character no-undo .
       88   if g#language <> '' and g#language <> 'rus':U then do:
       89     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       90   end.
       91   define new global shared variable g#library  as handle no-undo .
       92   define new global shared variable g#library2 as handle no-undo .
       93   define   shared variable g#auto as logical no-undo.
       94   define   shared variable g#news as logical no-undo.
       95   define   shared variable g#oxml as logical no-undo.
       96   define   shared variable g#esys as logical no-undo.
       97   define   shared variable g#news-source-db as integer no-undo.
       98   define   shared variable g#esys-source-esys as integer no-undo.
       99   define   shared variable g#db-num as integer   no-undo .
      100   define   shared variable g#userid as character no-undo .
      101   define   shared variable g#passwd as character no-undo .
      102   procedure proc-alt-shift-f2:
      103     if not ibs.th.gbl.gbl-var:rcode
      104   then
      105     run gbl\inidebug.p .
      106   end.
      107   procedure proc-alt-shift-f3:
      108     run gbl/prvssinf.p
      109       ( input this-procedure
      110       ) .
      111   end.
      112   define variable v-inform-launched as logical no-undo initial false .
      113   procedure proc-alt-shift-f4:
      114     define variable v-action as character no-undo .
      115     if v-inform-launched = false then do:
      116       assign
      117         v-inform-launched = true
      118       .
      119       run gbl/d-inform.w
      120         (  input self
      121         ,  input this-procedure
      122         , output v-action
      123         ) no-error .
      124       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      125       assign
      126         v-inform-launched = false
      127       .
      128     end.
      129   end.
      130   procedure proc-alt-f1:
      131     run gbl/corrhelp.p
      132       (input this-procedure
      133       ) .
      134   end .
      135   on alt-shift-f2 anywhere do:
      136     run proc-alt-shift-f2.
      137   end.
      138   on alt-shift-f3 anywhere do:
      139     run proc-alt-shift-f3 in this-procedure .
      140   end.
      141   on alt-shift-f4 anywhere do:
      142     run proc-alt-shift-f4 in this-procedure.
      143   end.
      144   on alt-f1 anywhere do:
      145     run proc-alt-f1 in this-procedure .
      146   end.
      147   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      148   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      149   define new shared variable RepPathName        as character no-undo .
      150   define new shared variable PrintRubl          as logical   no-undo .
      151   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      152   define variable v-waitfram-action01         as character   no-undo .
      153   define variable v-waitfram-action02         as character   no-undo .
      154   define variable v-waitfram-action03         as character   no-undo .
      155   define variable mWaitFramTextBeg            as character   no-undo.
      156   define variable mWaitFramTextEnd            as character   no-undo.
      157   define variable mWaitFramView               as logical     no-undo.
      158   define variable mWaitProcEvent              as logical     no-undo init yes.
      159   define variable mWaitFramInterval           as integer     no-undo init 1 .
      160   define variable mWaitFramStop               as logical     no-undo.
      161   define variable mWaitFramStopUser           as logical     no-undo.
      162   define variable mWaitFramStopTimeOut        as logical     no-undo.
      163   define variable mWaitFramStartProc          as datetime-tz no-undo.
      164   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      165   define button B-WaitFramStop auto-end-key
      166        label "Стоп"
      167        size 10 by 1 tooltip "Остоновить процесс".
      168   define button B-viewProcInfo
      169        label "Информация"
      170        size 15 by 1 tooltip "Информация о процесс".
      171   define frame waitfram
      172     v-waitfram-action01 format "x(72)" no-label skip
      173     v-waitfram-action02 format "x(72)" no-label skip
      174     v-waitfram-action03 format "x(72)" no-label skip
      175     B-viewProcInfo
      176     B-WaitFramStop at row 4 col 30
      177     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      178     .
      179   define new global shared variable mBatchMode as logical no-undo init ?.
      180   define variable mFramBachModHandle as handle no-undo.
      181   mFramBachModHandle = frame waitfram:handle.
      182   define variable mFameOldVis as logical no-undo.
      183   define variable mVisCUrentVin as logical no-undo.
      184   if session:batch-mode
      185   then
      186      mBatchMode = yes.
      187   if mBatchMode = ? then do:
      188     mVisCUrentVin = current-window:visible.
      189     mFameOldVis = mFramBachModHandle:visible.
      190     mFramBachModHandle:visible  = yes.
      191     mBatchMode = mFramBachModHandle:visible ne yes.
      192     mFramBachModHandle:visible = mFameOldVis.
      193     current-window:visible = mVisCUrentVin.
      194   end.
      195    if  log-manager:logfile-name ne ?
      196     then DO:
      197         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      198         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      199         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      200     end.
      201   on choose of B-WaitFramStop in frame waitfram
      202   do:
      203     mWaitFramStop = yes.
      204     mWaitFramStopUser = yes.
      205   end.
      206   function waitfram-check-timeout returns logical():
      207      define variable vtime as int64 no-undo.
      208      if mWaitFramStopTimeOut
      209      then
      210         return yes.
      211      vtime = ( now - mWaitFramStartProc ) / 1000 .
      212      if     mWaitFramTimeOut ne ?
      213         and mWaitFramTimeOut ne 0
      214         and mWaitFramTimeOut lt vtime
      215      then do:
      216         mWaitFramStopTimeOut = yes.
      217      end.
      218      return mWaitFramStopTimeOut.
      219   end.
      220   procedure waitfram-hide :
      221     if not session:batch-mode
      222     then do
      223     on error undo, return error return-value
      224     :
      225       pause 0 before-hide .
      226       if not mBatchMode then
      227         hide frame waitfram .
      228     if     not mWaitFramView
      229        and mWaitProcEvent
      230     then
      231       process events .
      232     end.
      233   end procedure.
      234   procedure waitfram-show :
      235     define input  parameter p-message as character no-undo .
      236     define variable v-left-margin as integer   no-undo .
      237     if not session:batch-mode
      238     then do
      239     on error undo, return error return-value
      240     :
      241       if length(p-message) <= 70 then do:
      242         assign
      243           v-left-margin = integer((70 - length(p-message)) / 2)
      244         .
      245         assign
      246           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      247         .
      248         assign
      249           v-waitfram-action01 = " "
      250           v-waitfram-action02 = " "
      251                                    + fill(" ", v-left-margin)
      252                                    + p-message
      253           v-waitfram-action03 = " "
      254         .
      255       end.
      256       else do:
      257         define variable vRindex1 as integer no-undo.
      258         define variable vRindex2 as integer no-undo.
      259         vRindex1 = r-index(p-message," ",70).
      260         if vRindex1 = 0
      261         then
      262            vRindex1 = 70.
      263         if length(p-message)  <= vRindex1 + 70 then do:
      264           assign
      265             v-waitfram-action01 = " "
      266             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      267             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      268           .
      269         end.
      270         else do:
      271           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      272           if vRindex2 <= vRindex1
      273           then
      274              vRindex2 = vRindex1 + 70.
      275           assign
      276             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      277             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      278             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      279           .
      280         end.
      281       end.
      282       B-viewProcInfo:visible   in frame waitfram = no.
      283       B-viewProcInfo:sensitive in frame waitfram = no.
      284       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      285       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      286       if  (   mWaitFramView
      287          or  mWaitProcEvent)
      288          and not mBatchMode
      289       then
      290          display
      291             v-waitfram-action01 skip
      292             v-waitfram-action02 skip
      293             v-waitfram-action03 skip
      294          with frame waitfram .
      295       if     mWaitFramView
      296          then do:
      297             if     mWaitFramInterval ne ?
      298                and not mBatchMode
      299             then
      300                wait-for go of frame waitfram pause mWaitFramInterval.
      301          end.
      302          else
      303             if     mWaitProcEvent
      304                and not mBatchMode
      305             then
      306                process events .
      307     end.
      308   end procedure.
      309      procedure waitfram-show-this:
      310         define input  parameter iInterval as int64 no-undo.
      311         define variable vtime as int64 no-undo.
      312         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      313         mWaitFramInterval = iInterval.
      314         run waitfram-show (substitute("&1&2 &3&4" ,
      315                                       mWaitFramTextBeg ,
      316                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      317                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      318                                       mWaitFramTextEnd
      319                                      )
      320                           ).
      321      end.
      322      procedure WaitFramRunPause:
      323         define input  parameter iInterval as dec no-undo.
      324         define variable vStart  as datetime-tz no-undo.
      325         define variable vend    as datetime-tz no-undo.
      326         define variable vint as int64 no-undo.
      327         define variable vOk as logical no-undo.
      328         vStart = now.
      329         vend   = vStart.
      330         publish "WaitFramPause" (iInterval,output vOk).
      331         vend   =  now.
      332         vint = vend - vStart.
      333         vint = iInterval - vint / 1000.
      334         if     not mWaitFramStop
      335            and (   vint > 0
      336                 or (    not vOk
      337                     and iInterval eq ?
      338                     )
      339                 )
      340         then
      341            run waitfram-show-this (iInterval).
      342         vend   =  now.
      343         vint = vend - vStart.
      344         vint = iInterval - vint / 1000.
      345         if     not mWaitFramStop
      346            and vint > 0
      347         then do:
      348            run gbl/pause.p (vint * 1000).
      349         end.
      350         if iInterval ne ?
      351         then
      352            publish "WaitFramStop".
      353         waitfram-check-timeout().
      354      end.
      355      procedure WaitFramWaitFor:
      356         define input  parameter iInterval as dec no-undo.
      357         assign
      358            mWaitFramStartProc   = now
      359            mWaitFramStopUser    = no
      360            mWaitFramStopTimeOut = no
      361         .
      362         block-wait:
      363         do while not mWaitFramStop:
      364            run WaitFramRunPause (iInterval).
      365            if  waitfram-check-timeout()
      366            then do:
      367               leave block-wait.
      368            end.
      369         end.
      370         run waitfram-hide.
      371      end.
      372   procedure waitfram-join :
      373     define input  parameter p-line-1  as character no-undo .
      374     define input  parameter p-line-2  as character no-undo .
      375     define input  parameter p-line-3  as character no-undo .
      376     define output parameter p-message as character no-undo .
      377     do
      378     on error undo, return error return-value
      379     :
      380       assign
      381         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      382                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      383                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      384       .
      385     end.
      386   end procedure.
      387   function waitfram-join-function returns character
      388     (input p-line-1 as character
      389     ,input p-line-2 as character
      390     ,input p-line-3 as character
      391     ).
      392     define variable v-message as character no-undo .
      393     run waitfram-join in this-procedure
      394       (input  p-line-1
      395       ,input  p-line-2
      396       ,input  p-line-3
      397       ,output v-message
      398       ) .
      399     return v-message .
      400   end function .
      401   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      402   define  stream PrnLibStream.
      403   procedure prn-lib-prn-file :
      404     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      405     define input parameter p-DIsabledoptions as integer no-undo .
      406     define variable v-report-name as character no-undo .
      407     define variable v-user-action as character no-undo .
      408     define variable v-printed     as logical   no-undo .
      409     define variable v-exist       as logical   no-undo .
      410     do
      411       on error undo, return error
      412       :
      413       run prn-lib-get-report-name  in this-procedure (
      414         input parParentProc
      415         ,output v-report-name
      416         ).
      417   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      418   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      419     (input  v-report-name
      420     ,input  2
      421     ,output v-exist
      422     )  .
      423       if NOT v-exist then
      424       DO:
      425         Message
      426           "Нет заданий на печать ! "
      427           view-as alert-box .
      428         Return  .
      429       End.
      430       run gbl/prnfilen.w
      431         (input  ""
      432         ,input  p-DisabledOptions
      433         ,input  string(v-report-name )
      434         ,input  7
      435         ,output v-user-action
      436         ,output v-printed
      437         ) .
      438       if v-printed then
      439       do:
      440         return "YES" .
      441       end.
      442       else
      443       do:
      444         return "NO" .
      445       end.
      446     end.
      447   end procedure.
      448   procedure prn-lib-open-stream :
      449     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      450     define input parameter p-page-size    as integer no-undo .
      451     define input parameter p-is-stream    as logical no-undo .
      452     define input parameter p-append       as logical no-undo .
      453     define variable v-report-name as character no-undo .
      454     do
      455       on error undo, return error
      456       :
      457       run prn-lib-get-report-name  in this-procedure (
      458         input parParentProc
      459         ,output v-report-name
      460         ).
      461       if p-is-stream then
      462       do:
      463         if p-append then
      464         do:
      465           output stream PrnLibStream to value( v-report-name )
      466             page-size value(p-page-size) append .
      467         end.
      468         if not p-append then
      469         do:
      470           output stream PrnLibStream to value( v-report-name )
      471             page-size value(p-page-size) .
      472         end.
      473       end.
      474       if not p-is-stream then
      475       do:
      476         if p-append then
      477         do:
      478           output to value( v-report-name )
      479             page-size value(p-page-size) append .
      480         end.
      481         if not p-append then
      482         do:
      483           output to value( v-report-name )
      484             page-size value(p-page-size) .
      485         end.
      486       end.
      487     end.
      488   end procedure.
      489   procedure prn-lib-open-exp :
      490     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      491     define input parameter p-is-stream    as logical no-undo .
      492     define input parameter p-is-append    as logical no-undo .
      493     define output parameter p-ReportFileName as char init "report" no-undo.
      494     define output parameter p-process as logical no-undo .
      495     define variable glog as logical no-undo .
      496     do
      497       on error undo, return error
      498       :
      499       SYSTEM-DIALOG GET-FILE p-ReportFileName
      500         TITLE      "Укажите путь"
      501         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      502         ASK-OVERWRITE
      503         CREATE-TEST-FILE
      504         SAVE-AS
      505         USE-FILENAME
      506         DEFAULT-EXTENSION "txt"
      507         UPDATE glog
      508         .
      509       if not glog then  return.
      510       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      511       if p-is-stream then
      512       do:
      513         if p-is-append then
      514         do:
      515           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      516         end.
      517         else
      518         do:
      519           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      520         end.
      521       end.
      522       else
      523       do:
      524         if p-is-append then
      525         do:
      526           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      527         end.
      528         else
      529         do:
      530           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      531         end.
      532       end.
      533       p-process = yes.
      534     end.
      535   end procedure.
      536   procedure prn-lib-get-report-name :
      537     define input parameter parParentProc  as widget-handle no-undo.
      538     define output parameter p-report-name as character no-undo .
      539     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      540   end procedure.
      541   procedure prn-lib-reportviewer-report-name :
      542     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      543     define input parameter p-report-name-html as character no-undo .
      544     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      545   end procedure.
      546   procedure prn-lib-reportviewer :
      547     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      548     define input parameter p-report-name-html as character no-undo .
      549     define input parameter p-param        as character no-undo .
      550     define variable v-excel           as character no-undo init 'TRUE' .
      551     define variable v-value-character as character no-undo .
      552     define variable v-value-integer   as character no-undo .
      553     define variable v-value-date      as date      no-undo .
      554     define variable v-value-decimal   as decimal   no-undo .
      555     define variable rep-excel         as logical   no-undo .
      556     define variable excel-string      as character no-undo .
      557     define variable v-param-type      as character no-undo .
      558     define variable v-tth             as handle    no-undo .
      559     run adm/shattri.p (
      560       input "get":U
      561       ,input  ""
      562       ,input  0
      563       ,input  'report-glob':U
      564       ,input  'rep-excel':U
      565       ,output v-value-character
      566       ,output v-value-date
      567       ,output v-value-decimal
      568       ,output v-value-integer
      569       ,output rep-excel
      570       ,output v-param-type
      571       ,INPUT-OUTPUT table-handle v-tth
      572       )  .
      573     if rep-excel then v-excel = "TRUE" .
      574     else v-excel = "FALSE" .
      575     if p-param eq ""
      576     then
      577        p-param = "EXCEL:" + v-excel.
      578     else
      579        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      580     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      581   end procedure.
      582   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      583   procedure cur-time :
      584      define output parameter p-today as date      no-undo .
      585      define output parameter p-time  as integer   no-undo .
      586     do
      587     on error undo, return error
      588     :
      589       define variable v-date1 as date      no-undo .
      590       define variable v-date2 as date      no-undo .
      591       define variable v-time  as integer   no-undo .
      592       assign
      593         v-date1 = today
      594         v-time  = time
      595         v-date2 = today
      596       .
      597       if v-date1 <> v-date2
      598       then do:
      599         assign
      600           v-date1 = today
      601           v-time  = v-time
      602         .
      603       end.
      604       assign
      605         p-today = v-date1
      606         p-time  = v-time
      607       .
      608     end.
      609   end.
      610   function cur-time-date returns character
      611   :
      612     return string(today, '99/99/9999':U) .
      613   end.
      614   function cur-time-mjd returns decimal
      615   :
      616     define variable v-date as date      no-undo .
      617     define variable v-time as integer   no-undo .
      618     run cur-time in this-procedure
      619       (output v-date
      620       ,output v-time
      621       ) .
      622     return integer(v-date) - 2400002 + (v-time / 86400) .
      623   end.
      624   function cur-time-get-ending-index returns integer
      625   (input p-number as integer
      626   )
      627   :
      628     if p-number < 0
      629     or p-number = ?
      630     then do:
      631       return 1 .
      632     end.
      633     define variable v-rest as integer   no-undo .
      634     assign
      635       p-number = p-number modulo 100
      636     .
      637     if p-number < 20
      638     then do:
      639       assign
      640         v-rest = p-number
      641       .
      642     end.
      643     else do:
      644       assign
      645         v-rest = p-number modulo 10
      646       .
      647     end.
      648     case v-rest :
      649       when 1
      650       then do:
      651         return 2 .
      652       end.
      653       when 2 or
      654       when 3 or
      655       when 4
      656       then do:
      657         return 3 .
      658       end.
      659       otherwise do:
      660         return 1 .
      661       end.
      662     end case .
      663   end.
      664   procedure cur-time-mjd-to-date :
      665      define input  parameter i-mjd-diff as decimal no-undo.
      666      define output parameter o-Date     as date    no-undo.
      667      define output parameter o-Time     as integer no-undo.
      668      define variable v-day-number as integer   no-undo .
      669      if    i-mjd-diff < 0
      670         or i-mjd-diff = ?
      671      then do:
      672         return "?" .
      673      end.
      674      assign
      675         v-day-number = truncate(i-mjd-diff,0).
      676         o-Date = date(v-day-number + 2400002).
      677         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      678     .
      679   end.
      680   function cur-time-mjd-to-string returns character
      681   (input p-mjd-diff as decimal
      682   )
      683   :
      684     define variable v-day-number as integer   no-undo .
      685     define variable v-seconds    as integer   no-undo .
      686     define variable v-hour       as integer   no-undo .
      687     define variable v-min        as integer   no-undo .
      688     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      689     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      690     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      691     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      692     if p-mjd-diff < 0
      693     or p-mjd-diff = ?
      694     then do:
      695       return "?" .
      696     end.
      697     assign
      698       v-day-number = integer(truncate(p-mjd-diff,0))
      699       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      700     .
      701     if v-seconds > 86400
      702     then do:
      703       assign
      704         v-seconds = 86400 - 1
      705       .
      706     end.
      707     if v-seconds < 0
      708     then do:
      709       assign
      710         v-seconds = 0
      711       .
      712     end.
      713     assign
      714       v-hour = truncate(v-seconds / 3600, 0)
      715     .
      716     assign
      717       v-seconds = v-seconds modulo 3600
      718     .
      719     assign
      720       v-min = truncate(v-seconds / 60, 0)
      721     .
      722     assign
      723       v-seconds = v-seconds modulo 60
      724     .
      725     return
      726         (if v-day-number <> 0
      727           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      728           else ""
      729         )
      730       + (if v-day-number <> 0 or v-hour <> 0
      731           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      732           else ""
      733         )
      734       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      735           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      736           else ""
      737         )
      738       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      739       .
      740   end.
      741   function cur-time-string returns character
      742   :
      743     define variable v-date as date      no-undo .
      744     define variable v-time as integer   no-undo .
      745     run cur-time in this-procedure
      746       (output v-date
      747       ,output v-time
      748       ) .
      749     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      750   end.
      751   function cur-time-string-sec returns character
      752   :
      753     define variable v-date as date      no-undo .
      754     define variable v-time as integer   no-undo .
      755     run cur-time in this-procedure
      756       (output v-date
      757       ,output v-time
      758       ) .
      759     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      760   end.
      761   function cur-time-custom  returns character
      762   (input p-prefix as character
      763   ,input p-date-format as character
      764   ,input p-delimiter as character
      765   ,input p-time-format as character
      766   ,input p-suffix as character
      767   )
      768   :
      769     define variable v-date as date      no-undo .
      770     define variable v-time as integer   no-undo .
      771     run cur-time in this-procedure
      772       (output v-date
      773       ,output v-time
      774       ) .
      775     return
      776       p-prefix
      777       + string(v-date, p-date-format)
      778       + p-delimiter
      779       + string(v-time, p-time-format)
      780       + p-suffix
      781       .
      782   end.
      783   function cur-time-print  returns character
      784   :
      785     define variable v-date as date      no-undo .
      786     define variable v-time as integer   no-undo .
      787     run cur-time in this-procedure
      788       (output v-date
      789       ,output v-time
      790       ) .
      791     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      792   end.
      793   function cur-time-datetime returns datetime
      794   :
      795     define variable v-char as character no-undo .
      796     define variable v-datetime as datetime no-undo .
      797     v-char = cur-time-string().
      798     v-datetime = datetime(v-char).
      799     return  v-datetime.
      800   end.
      801   function cur-time-string-msec returns character
      802   :
      803     define variable v-date as datetime  no-undo .
      804     v-date = now.
      805     return string(v-date) .
      806   end.
