     3913         assign
     3914           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3915           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3916           v-diasize-browse-handle     = browse BROWSE-am-goods :handle
     3917         .
     3918         create button v-diasize-resize-button
     3919         assign
     3920           parent        = frame Dialog-Frame :first-child
     3921           label         = "s"
     3922           height-pixels = 16
     3923           width-pixels  = 16
     3924           visible       = true
     3925           sensitive     = true
     3926           movable       = true
     3927           triggers:
     3928             on end-move persistent run diasize_end-move in this-procedure .
     3929           end triggers.
     3930         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3931         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3932         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3933         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3934         assign
     3935           v-diasize-wndmax = false
     3936         .
     3937         if connected("ub") = true
     3938         then do:
     3939           define variable v-cntxt-db-num        as integer   no-undo .
     3940           define variable v-cntxt-userid        as character no-undo .
     3941           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3942                                             , OUTPUT v-cntxt-userid
     3943                                             ) .
     3944           run gbl/wndpar_r.p
     3945             (input  v-cntxt-db-num
     3946             ,input  v-cntxt-userid
     3947             ,input  'wndmax':U
     3948             ,output v-diasize-wndmax
     3949             ,output v-default-value
     3950             ) .
     3951         end.
     3952         assign
     3953           v-diasize-wndstore = false
     3954         .
     3955         if connected("ub") = true
     3956         then do:
     3957           run gbl/wndpar_r.p
     3958             (input  v-cntxt-db-num
     3959             ,input  v-cntxt-userid
     3960             ,input  'wndstore':U
     3961             ,output v-diasize-wndstore
     3962             ,output v-default-value
     3963             ) .
     3964         end.
     3965         assign
     3966           v-diasize-proc-name = entry(1, program-name(2), '.')
     3967         .
     3968         if v-diasize-wndstore = true
     3969         then do:
     3970           assign
     3971             v-restore-saved = false
     3972           .
     3973           if connected("ub") = true
