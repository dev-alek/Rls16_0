      864   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      865   procedure fltopend_fltopend :
      866   define input parameter p-parent-handle as handle no-undo .
      867   define input parameter p-qh as handle no-undo .
      868   define input parameter p-flt-open-open-query  as character no-undo .
      869   define input parameter p-where-cond as character no-undo .
      870   define input parameter p-use-indFIRST-query-tail as character no-undo .
      871   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      872   define input parameter p-indexed-reposition as character no-undo .
      873     do
      874     on error undo, return error
      875     :
      876   define variable v-prepare-string as character no-undo .
      877   define variable glog as logical no-undo .
      878   assign
      879   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      880                      p-where-cond + chr(32)  +
      881                      p-use-indFIRST-query-tail + chr(32) +
      882                      p-use-ind-sort-clmn-by + chr(32) +
      883                      p-indexed-reposition
      884   .
      885   assign
      886   glog = p-qh:query-prepare(v-prepare-string) no-error .
      887   if not glog
      888   or error-status:error then do:
      889     message error-status:get-message(1) view-as alert-box .
      890     undo, return error .
      891   end.
      892   assign
      893   glog = p-qh:query-open no-error .
      894   if not glog
      895   or error-status:error then do:
      896     message error-status:get-message(1) view-as alert-box .
      897     undo, return error .
      898   end.
      899     end.
      900   end procedure.
      901   procedure fltopend_fltfindd :
      902   define input parameter p-parent-handle as handle no-undo .
      903   define input parameter p-qh as handle no-undo .
      904   define input parameter p-rowid as rowid no-undo .
      905   define input parameter p-next as logical no-undo .
      906   define input parameter p-lock as integer no-undo .
      907   define input parameter p-bh as handle no-undo .
      908   define input parameter p-where-cond as character no-undo .
      909   define input parameter p-use-index-phrase as character no-undo .
      910   define variable glog as logical no-undo .
      911   define variable v-qh as handle no-undo .
      912   define variable v-bh as handle no-undo .
      913   define variable v-recid as recid no-undo .
      914   define variable v-prepare-string as character no-undo .
      915   do
      916   on error undo, return error
      917   on stop undo, return error
      918   :
      919     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      920     create buffer v-bh for table p-bh buffer-name p-bh:name.
      921     create query v-qh.
      922     v-qh:set-buffers(v-bh).
      923     v-prepare-string = substitute("for each &1 &2 &3"
      924                                     ,v-bh:name
      925                                     ,p-where-cond
      926                                     ,p-use-index-phrase).
      927     glog = v-qh:query-prepare(v-prepare-string) no-error.
      928     if not glog then do:
      929       delete object v-qh.
      930       delete object v-bh.
      931       undo, return error .
      932     end.
      933     glog = v-qh:query-open no-error .
      934     if not glog then do:
      935       delete object v-qh.
      936       delete object v-bh.
      937       undo, return error .
      938     end.
      939     if p-next then do:
      940       v-qh:reposition-to-rowid(p-rowid) no-error .
      941       glog = v-qh:get-next( p-lock) no-error .
      942       glog = v-qh:get-next( p-lock) no-error .
      943       if not glog or v-qh:query-off-end = yes then do:
      944         glog = v-qh:get-first( p-lock) no-error .
      945       end.
      946     end.
      947     else do:
      948       glog = v-qh:get-first( p-lock) no-error .
      949     end.
      950     v-recid = v-bh:recid no-error .
      951     delete object v-qh.
      952     delete object v-bh.
      953     return string(v-recid) .
      954   end.
      955   end procedure.
      956   procedure fltopend_fltfindq :
      957   define input parameter p-parent-handle as handle no-undo .
      958   define input parameter p-qh as handle no-undo .
      959   define input parameter p-next as logical no-undo .
      960   define input parameter p-lock as integer no-undo .
      961   define input parameter p-flt-open-open-query  as character no-undo .
      962   define input parameter p-where-cond as character no-undo .
      963   define input parameter p-use-indFIRST-query-tail as character no-undo .
      964   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      965   define input parameter p-indexed-reposition as character no-undo .
      966   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      967   define variable glog as logical no-undo .
      968   define variable v-qh as handle no-undo .
      969   define variable v-bh as handle no-undo extent 18.
      970   define variable v-rowid as rowid no-undo extent 18.
      971   define variable v-ii as integer no-undo .
      972   define variable v-prepare-string as character no-undo .
      973   do
      974   on error undo, return error
      975   on stop undo, return error
      976   :
      977     create query v-qh.
      978     do v-ii = 1 to p-qh:num-buffers:
      979       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      980       assign
      981       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      982       no-error.
      983       v-qh:add-buffer(v-bh[v-ii]).
      984     end.
      985     assign
      986     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      987                       p-where-cond + chr(32)  +
      988                       p-use-indFIRST-query-tail + chr(32) +
      989                       p-use-ind-sort-clmn-by + chr(32) +
      990                       p-indexed-reposition
      991     .
      992     glog = v-qh:query-prepare( v-prepare-string) no-error .
      993     if not glog then do:
      994       delete object v-qh.
      995       do v-ii = 1 to p-qh:num-buffers:
      996         delete object v-bh[v-ii].
      997       end.
      998       undo, return error .
      999     end.
     1000     glog = v-qh:query-open no-error .
     1001     if not glog then do:
     1002       delete object v-qh.
     1003       do v-ii = 1 to p-qh:num-buffers:
     1004         delete object v-bh[v-ii].
     1005       end.
     1006       undo, return error .
     1007     end.
     1008     if p-next then do:
     1009       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1010       glog = v-qh:get-next( p-lock) no-error .
     1011       glog = v-qh:get-next( p-lock) no-error .
     1012       if not glog or v-qh:query-off-end = yes then do:
     1013         glog = v-qh:get-first( p-lock) no-error .
     1014       end.
     1015     end.
     1016     else do:
     1017       glog = v-qh:get-first( p-lock) no-error .
     1018     end.
     1019     do v-ii = 1 to p-qh:num-buffers:
     1020       assign
     1021       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1022       no-error.
     1023     end.
     1024     delete object v-qh.
     1025     do v-ii = 1 to p-qh:num-buffers:
     1026       delete object v-bh[v-ii].
     1027     end.
     1028   end.
     1029   end procedure.
     1030   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1031   FUNCTION mark-string RETURNS CHARACTER
     1032     ( input p-recid as recid, input mark-list as character  ) :
     1033     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1034   END FUNCTION.
     1035   define new global shared variable g#lib-Matrix  as handle no-undo .
     1036   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1037   procedure gds-ind1 :
     1038   main-block:
     1039     do
     1040   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1041   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1042   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1043     :
     1044   define input-output parameter p-doc-rec  as recid no-undo.
     1045   define input  parameter p-gds-code                   like  ub.gds-obj-prop.gds-code no-undo.
     1046   define input  parameter p-obj-type                   like  ub.gds-obj-prop.obj-type no-undo.
     1047   define input  parameter p-obj-code                   like  ub.gds-obj-prop.obj-code no-undo.
     1048   define input  parameter p-gdop-igt                   like  ub.gds-obj-prop.gdop-igt no-undo.
     1049   define input  parameter p-gdop-assort-min            like  ub.gds-obj-prop.gdop-assort-min  no-undo.
     1050   define input  parameter p-gdop-min-stock             like  ub.gds-obj-prop.gdop-min-stock   no-undo.
     1051   define input  parameter p-grop-level-always-presence like  ub.gds-obj-prop.grop-level-always-presence  no-undo.
     1052   define input  parameter p-grop-max-stock             like  ub.gds-obj-prop.grop-max-stock              no-undo.
     1053   define input  parameter p-grop-min-order             like  ub.gds-obj-prop.grop-min-order              no-undo.
     1054   define buffer bufs_gds-obj-prop for ub.gds-obj-prop.
     1055   define variable v-db-num like ub.db.db-num no-undo .
     1056   define variable v-db-num-obj like ub.db.db-num no-undo .
     1057   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1058   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1059     (output v-db-num
     1060     )  .
     1061   define variable v-date as date no-undo .
     1062   define variable v-time as integer no-undo .
     1063   run cur-time in this-procedure(output v-date, output v-time).
     1064     find first bufs_gds-obj-prop exclusive-lock where
     1065               bufs_gds-obj-prop.gds-code          = p-gds-code   and
     1066               bufs_gds-obj-prop.obj-type          = p-obj-type   and
     1067               bufs_gds-obj-prop.obj-code          = p-obj-code  no-error .
     1068       if not available bufs_gds-obj-prop then do:
     1069           create bufs_gds-obj-prop.
     1070           assign
     1071               bufs_gds-obj-prop.gds-code           = p-gds-code
     1072               bufs_gds-obj-prop.grop-date-update   = v-date
     1073               bufs_gds-obj-prop.grop-time-update   = v-time
     1074               bufs_gds-obj-prop.grop-db-num-update = v-db-num
     1075               bufs_gds-obj-prop.obj-type           = p-obj-type
     1076               bufs_gds-obj-prop.obj-code           = p-obj-code
     1077           no-error .
     1078           if error-status :error then message "Ошибка при создании записи" error-status :error error-status :get-message(1) .
     1079       end.
     1080   if  p-gdop-igt                     <> ? then    bufs_gds-obj-prop.gdop-igt                   = p-gdop-igt.
     1081   if  p-gdop-assort-min              <> ? then    bufs_gds-obj-prop.gdop-assort-min            = p-gdop-assort-min.
     1082   if  p-gdop-min-stock               <> ? then    bufs_gds-obj-prop.gdop-min-stock             = p-gdop-min-stock  .
     1083   if  p-grop-level-always-presence   <> ? then    bufs_gds-obj-prop.grop-level-always-presence = p-grop-level-always-presence.
     1084   if  p-grop-max-stock               <> ? then    bufs_gds-obj-prop.grop-max-stock             = p-grop-max-stock           .
     1085   if  p-grop-min-order               <> ? then    bufs_gds-obj-prop.grop-min-order             = p-grop-min-order           .
     1086         p-doc-rec = recid(bufs_gds-obj-prop)    .
     1087   end.
     1088   end procedure.
     1089   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1090   def
     1091   new shared
     1092   temp-table  obj-list no-undo
     1093     field obj-type like ub.clients.obj-type
     1094     field obj-code like ub.clients.obj-code
     1095     field obj-name like ub.clients.obj-name
     1096     field obj-id   as integer
     1097     field db-num   as integer
     1098     index pi is primary unique obj-id
     1099     index ie1 obj-type obj-code
     1100     index ie2 obj-name
     1101   .
     1102   procedure create_obj-list :
     1103      define input parameter p-obj-type like ub.clients.obj-type no-undo .
     1104      define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1105      do
     1106      on error undo, return error return-value
     1107      :
     1108         define buffer cli-obj for ub.clients .
     1109         define variable p-var as integer no-undo .
     1110         define buffer buf_obj-list for obj-list .
     1111         find last buf_obj-list  use-index pi no-error .
     1112         if available buf_obj-list
     1113         then
     1114            p-var = buf_obj-list.obj-id + 1.
     1115         else
     1116            p-var = 1.
     1117         find first cli-obj where
     1118                   cli-obj.obj-type = p-obj-type
     1119               and cli-obj.obj-code = p-obj-code
     1120         no-lock no-error.
     1121         if available cli-obj
     1122         then do:
     1123            create buf_obj-list.
     1124            assign
     1125               buf_obj-list.obj-id   = p-var
     1126               buf_obj-list.obj-code = cli-obj.obj-code
     1127               buf_obj-list.obj-type = cli-obj.obj-type
     1128               buf_obj-list.obj-name = cli-obj.obj-name
     1129               buf_obj-list.db-num   = cli-obj.db-num
     1130            .
     1131         end.
     1132      end.
     1133   end.
     1134   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1135   define variable v-longchar-asstro  as longchar no-undo .
     1136   define temp-table temp-goods no-undo
     1137     field gds-code as integer
     1138     field status_  as integer
     1139     index pi gds-code
     1140   .
     1141   PROCEDURE translate-to-other :
     1142   define input  parameter p-asmt-id as integer   no-undo .
     1143   define input  parameter p-db-num  as integer   no-undo .
     1144     do
     1145     on error undo, return error return-value
     1146     :
     1147   define variable v-recid as recid no-undo .
     1148   define buffer Oth_assortment-matrix-goods for ub.assortment-matrix-goods  .
     1149   define buffer obj_assortment-matrix for ub.assortment-matrix  .
     1150   define buffer sh_assortment-matrix for ub.assortment-matrix  .
     1151   define buffer bufs_gds-obj-prop for ub.gds-obj-prop  .
     1152     find first  sh_assortment-matrix no-lock where
     1153                 sh_assortment-matrix.asmt-id = p-asmt-id and
     1154                 sh_assortment-matrix.db-num  = p-db-num  and
     1155                 sh_assortment-matrix.asmt-status = 0 and
     1156                 sh_assortment-matrix.asmt-type = 'Шаблон':U no-error .
     1157   if not available sh_assortment-matrix then return .
     1158   define variable v-doc-rec as recid no-undo .
     1159   define variable v-gds-prop-recid as recid no-undo .
     1160   define variable v-stt as integer   no-undo .
     1161   v-longchar-asstro = "".
     1162      run waitfram-show in this-procedure  ("Передача изменений в связанные матрицы ... " ) .
     1163      for each obj_assortment-matrix no-lock where
     1164               obj_assortment-matrix.asmt-status = 0 and
     1165               obj_assortment-matrix.asmt-type = 'Объект':U ,
     1166         first ub.assortment-matrix-attr no-lock where
     1167               ub.assortment-matrix-attr.asmt-id    = obj_assortment-matrix.asmt-id and
     1168               ub.assortment-matrix-attr.db-num     = obj_assortment-matrix.db-num and
     1169               ub.assortment-matrix-attr.attr-code  = 'RootShablon':U and
     1170               ub.assortment-matrix-attr.attr-value = substitute("&1&3&2" , p-asmt-id, p-db-num,chr(4))
     1171               :
     1172           run waitfram-show in this-procedure ( substitute(" Передаю изменения в Матрицу: &1" ,obj_assortment-matrix.asmt-name )) .
     1173           for each temp-goods :
     1174              if temp-goods.status_ = 0 then do:
     1175                   find first Oth_assortment-matrix-goods no-lock where
     1176                               Oth_assortment-matrix-goods.asmt-id  = ub.assortment-matrix-attr.asmt-id and
     1177                               Oth_assortment-matrix-goods.db-num   = ub.assortment-matrix-attr.db-num  and
     1178                               Oth_assortment-matrix-goods.gds-code = temp-goods.gds-code and
     1179                               Oth_assortment-matrix-goods.asmg-status = 0 no-error .
     1180                       if not available Oth_assortment-matrix-goods then do:
     1181   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat1 in g#lib-Matrix
     1182    (input this-procedure
     1183    ,input-output v-doc-rec
     1184    ,input 'ДОБАВЛЕНИЕ':U
     1185    ,input ub.assortment-matrix-attr.asmt-id
     1186    ,input ub.assortment-matrix-attr.db-num
     1187    ,input temp-goods.gds-code
     1188    ,input ''
     1189     ) no-error .
     1190                           if error-status :error then do:
     1191                             v-longchar-asstro = v-longchar-asstro + return-value + chr(10) .
     1192                             next.
     1193                           end.
     1194                       end.
     1195                 end.
     1196                 else do:
     1197                   v-stt = 1.
     1198                   find first Oth_assortment-matrix-goods no-lock where
     1199                               Oth_assortment-matrix-goods.asmt-id  = ub.assortment-matrix-attr.asmt-id and
     1200                               Oth_assortment-matrix-goods.db-num   = ub.assortment-matrix-attr.db-num  and
     1201                               Oth_assortment-matrix-goods.gds-code = temp-goods.gds-code and
     1202                               Oth_assortment-matrix-goods.asmg-status = 0 no-error .
     1203                       if available Oth_assortment-matrix-goods then do:
     1204                           v-recid = recid(Oth_assortment-matrix-goods).
     1205                           find first bufs_gds-obj-prop exclusive-lock where
     1206                                      bufs_gds-obj-prop.gds-code = Oth_assortment-matrix-goods.gds-code   and
     1207                                      bufs_gds-obj-prop.obj-type = Oth_assortment-matrix-goods.obj-type   and
     1208                                      bufs_gds-obj-prop.obj-code = Oth_assortment-matrix-goods.obj-code  no-error .
     1209                           if not available bufs_gds-obj-prop
     1210                             or not (bufs_gds-obj-prop.gdop-igt = 'Пусто':U or
     1211                                     bufs_gds-obj-prop.gdop-igt = 'На вывод из ассортимента':U ) then do:
     1212                           v-longchar-asstro = v-longchar-asstro +
     1213                           substitute("Принудительная смена ИЖТ_ товара &1  на ПУСТО на объекте &2&3&4" ,
     1214                               Oth_assortment-matrix-goods.gds-code ,
     1215                               Oth_assortment-matrix-goods.obj-type ,
     1216                               Oth_assortment-matrix-goods.obj-code ,
     1217                               chr(10)) .
     1218                           run gds-ind1
     1219                               (input-output v-gds-prop-recid
     1220                               ,Oth_assortment-matrix-goods.gds-code
     1221                               ,Oth_assortment-matrix-goods.obj-type
     1222                               ,Oth_assortment-matrix-goods.obj-code
     1223                               ,'Пусто':U
     1224                               ,?
     1225                               ,?
     1226                               ,?
     1227                               ,?
     1228                               ,?
     1229                               ) no-error  .
     1230                             end.
     1231                             if not error-status :error then do:
     1232   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat2 in g#lib-Matrix
     1233    (input this-procedure
     1234    ,input v-recid
     1235    ,input-output v-stt
     1236    ,input no
     1237     ) no-error .
     1238                                   if error-status :error then do:
     1239                                      v-longchar-asstro = v-longchar-asstro + return-value + chr(10) .
     1240                                   end.
     1241                              end.
     1242                              else do:
     1243                                 v-longchar-asstro = v-longchar-asstro + return-value + chr(10) .
     1244                              end.
     1245                       end.
     1246                  end.
     1247           end.
     1248      end.
     1249      run waitfram-hide in this-procedure.
     1250   end.
     1251   END PROCEDURE.
