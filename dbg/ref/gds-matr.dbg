        1   DEFINE BUFFER Buf_goods FOR ub.goods.
        2   DEFINE BUFFER Buf_matrix-goods FOR ub.assortment-matrix-goods.
        3   define input  parameter parParentProc AS WIDGET-HANDLE NO-UNDO.
        4   define input  parameter p-id        like ub.assortment-matrix.asmt-id  no-undo .
        5   define input  parameter p-db-num as integer   no-undo .
        6   define input  parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        7   define input  parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        8   define input  parameter p-mode  as character no-undo .
        9   define variable bttns   as character no-undo init "b-add".
       10   if p-mode = "no-button"  then bttns = "" .
       11   define variable p-sts   as integer   no-undo .
       12   define variable p-rid-list                    as character no-undo .
       13   define variable v-gdop-min-stock              as decimal   no-undo .
       14   define variable v-grop-max-stock              as decimal   no-undo .
       15   define variable v-grop-level-always-presence  as decimal   no-undo .
       16   define variable v-grop-min-order              as decimal   no-undo .
       17   define variable v-log as logical   no-undo .
