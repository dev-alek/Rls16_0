     4005                 (input  integer(v-resize-value-str)
     4006                 ,input  true
     4007                 ) .
     4008               assign
     4009                 v-restore-saved = true
     4010               .
     4011             end.
     4012           end.
     4013           if v-restore-saved <> true
     4014           then do:
     4015             if v-diasize-wndmax = true
     4016             then do:
     4017               run diasize_maximize in this-procedure
     4018                 (input  true
     4019                 ) .
     4020             end.
     4021           end.
     4022         end.
     4023         else do:
     4024           if v-diasize-wndmax = true
     4025           then do:
     4026             run diasize_maximize in this-procedure
     4027               (input  true
     4028               ) .
     4029           end.
     4030         end.
     4031       end.
     4032     end.
     4033   end procedure.
     4034   procedure diasize_need-full-display :
     4035     define output parameter p-need-full-display as logical   no-undo .
     4036     do
     4037     on error undo, return error return-value
     4038     :
     4039       assign
     4040         p-need-full-display = v-diasize-need-full-display
     4041       .
     4042       assign
     4043         v-diasize-need-full-display = false
     4044       .
