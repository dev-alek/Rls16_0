     2812   end.
     2813   run minbtn-set in this-procedure .
     2814   on choose of b-help in frame Dialog-Frame
     2815   do:
     2816     apply "help":u to frame Dialog-Frame .
     2817   end.
     2818   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2819   procedure minbtn-set :
     2820       do
     2821           on error undo, return error return-value
     2822           :
     2823           define variable ii              as integer       no-undo .
     2824           define variable fh              as widget-handle no-undo .
     2825           define variable hh              as widget-handle no-undo .
     2826           define variable v-h             as handle        extent 4 no-undo .
     2827           define variable v-name-button   as character     no-undo .
     2828           define variable v-help-old-x    as decimal       no-undo .
     2829           define variable v-help-old-y    as decimal       no-undo .
     2830           define variable v-help-old-size as decimal       no-undo .
     2831           define variable v-frame-width   as decimal       no-undo .
     2832           define variable jj              as integer       no-undo .
     2833           do
     2834               on error undo, return error
     2835               :
     2836               assign
     2837                   v-frame-width = frame Dialog-Frame:width - 0.3
     2838                   fh            = frame Dialog-Frame:first-child
     2839                   hh            = fh:first-child
     2840                   ii            = 1
     2841                   .
     2842               do while valid-handle(hh):
     2843                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2844                   do:
     2845                       case lc(hh:name) :
     2846                           when "b-help" then
     2847                               do:
     2848                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2849                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2850                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2851                                   hh:TOOLTIP = "Помощь" .
     2852                                   v-help-old-x = hh:column .
     2853                                   v-help-old-y = hh:row    .
     2854                                   v-help-old-size = hh:width .
     2855                                   hh:width-chars = 2.5 .
     2856                               end.
     2857                           when "b-print" then
     2858                               do:
     2859                                   hh:load-image("cmp/b-print.bmp":u) .
     2860                                   hh:TOOLTIP = "Печать" .
     2861                                   v-h[ii] = hh:handle .
     2862                                   ii = ii + 1 .
     2863                                   hh:width-chars = 3 .
     2864                               end.
     2865                           when "b-history" or
     2866                           when "b-hist" then
     2867                               do:
     2868                                   hh:load-image("cmp/b-hist.bmp":u) .
     2869                                   hh:TOOLTIP = "История" .
     2870                                   v-h[ii] = hh:handle .
     2871                                   ii = ii + 1 .
     2872                                   hh:width-chars = 3 .
     2873                               end.
     2874                           when "b-sch" then
     2875                               do:
     2876                                   hh:load-image("cmp/b-sch.bmp":u) .
     2877                                   hh:TOOLTIP = "Установка Фильтра" .
     2878                                   v-h[ii] = hh:handle .
     2879                                   ii = ii + 1 .
     2880                                   hh:width-chars = 3 .
     2881                               end.
     2882                           when "b-hist-user" then
     2883                               do:
     2884                                   hh:load-image("cmp/b-hist.bmp":u) .
     2885                                   hh:TOOLTIP = "История пользователя" .
     2886                                   ii = ii + 1 .
     2887                               end.
     2888                       end case.
     2889                   end.
     2890                   hh = hh:next-sibling.
     2891               end.
     2892               b-help:column = v-frame-width - b-help:width-chars.
     2893               jj = 0.
     2894               repeat ii = 4 to 1 by -1 :
     2895                   if valid-handle (v-h[ii] ) then
     2896                   do:
     2897                       jj  = jj + 1 .
     2898                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2899                       v-h[ii]:row    = v-help-old-y .
     2900                   end.
     2901               end.
     2902           end.
     2903       end.
     2904   end procedure.
     2905   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2906   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2907   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2908   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2909   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2910   define variable v-diasize-current-frame-height as decimal   no-undo .
     2911   define variable v-diasize-change-size          as logical   no-undo .
     2912   define variable v-diasize-resize-button        as handle    no-undo .
     2913   define variable v-diasize-wndmax               as logical   no-undo .
     2914   define variable v-diasize-wndstore             as logical   no-undo .
     2915   define variable v-diasize-proc-name            as character no-undo .
     2916   define variable v-diasize-browse-handle        as handle    no-undo .
     2917   define variable v-diasize-browse-number        as integer   no-undo .
     2918   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2919   define temp-table temp-diasize-handle no-undo
     2920     field handle-value  as handle
     2921     field save-position as decimal
     2922     index xpk is primary unique handle-value
     2923     .
     2924   define temp-table temp-browse-handle no-undo
     2925     field browse-type   as character
     2926     field browse-number as integer
     2927     field browse-handle as handle
     2928     field original-size as decimal
     2929     index xpk is primary unique browse-type browse-number
     2930     index xie browse-type browse-handle
     2931   .
     2932   procedure diasize_change-height :
     2933     define input  parameter p-change-value  as decimal   no-undo .
     2934     define input  parameter p-move-resize   as logical   no-undo .
     2935     define variable v-field-group-handle    as handle    no-undo .
     2936     define variable v-object-handle         as handle    no-undo .
     2937     define variable v-frame-height          as decimal   no-undo .
     2938     define variable v-frame-virtual-height  as decimal   no-undo .
     2939     define variable v-browse-height         as decimal   no-undo .
     2940     define variable v-window-height         as decimal   no-undo .
     2941     define variable v-window-virtual-height as decimal   no-undo .
     2942     define variable v-change-sign           as integer   no-undo .
     2943     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2944     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2945     if p-change-value > 0
     2946     then do:
     2947       if frame Dialog-Frame :height + p-change-value
     2948           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2949       then do:
     2950         assign
     2951           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2952                           - (frame Dialog-Frame :height-chars)
     2953         .
     2954         if p-change-value <= 0
     2955         then do:
     2956           run diasize_position-resize-button in this-procedure .
     2957           return .
     2958         end.
     2959       end.
     2960     end.
     2961     if p-change-value < 0
     2962     then do:
     2963       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2964       then do:
     2965         assign
     2966           p-change-value = v-diasize-orig-frame-height
     2967                          - (frame Dialog-Frame :height-chars)
     2968         .
     2969         if p-change-value >= 0
     2970         then do:
     2971           run diasize_position-resize-button in this-procedure .
     2972           return .
     2973         end.
     2974       end.
     2975     end.
     2976     if p-change-value >= 0
     2977     then do:
     2978       assign
     2979         v-change-sign = 1
     2980       .
     2981     end.
     2982     else do:
     2983       assign
     2984         v-change-sign = -1
     2985       .
     2986     end.
     2987     assign
     2988       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2989     .
     2990     if p-change-value = 0
     2991     then do:
     2992       run diasize_position-resize-button in this-procedure .
     2993       return .
     2994     end.
     2995     move_block:
     2996     do
     2997     on error undo move_block, retry move_block
     2998     :
     2999       if retry
     3000       then do:
     3001         do
     3002         on error undo move_block, leave move_block
     3003         :
     3004           if p-change-value > 0
     3005           then do:
     3006             for each buf_temp-diasize-handle
     3007             on error undo, next
     3008             :
     3009               assign
     3010                 v-object-handle = buf_temp-diasize-handle.handle-value
     3011               .
     3012               if v-object-handle <> v-diasize-resize-button
     3013               then do:
     3014                 assign
     3015                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3016                 .
     3017               end.
     3018             end.
     3019             assign
     3020               v-diasize-browse-handle :height = v-browse-height
     3021             .
     3022             for each buf_temp-browse-handle
     3023               where buf_temp-browse-handle.browse-type = 'height':u
     3024             on error undo, next
     3025             :
     3026               assign
     3027                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3028               .
     3029             end.
     3030             assign
     3031               frame Dialog-Frame :height = v-frame-height
     3032             .
     3033             if frame Dialog-Frame :scrollable = true
     3034             then do:
     3035               assign
     3036                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3037               .
     3038             end.
     3039             run diasize_position-resize-button in this-procedure .
     3040           end.
     3041           else do:
     3042             if frame Dialog-Frame :scrollable = true
     3043             then do:
     3044               assign
     3045                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3046               .
     3047             end.
     3048             assign
     3049               frame Dialog-Frame :height = v-frame-height
     3050             .
     3051             assign
     3052               v-diasize-browse-handle :height = v-browse-height
     3053             .
     3054             for each buf_temp-browse-handle
     3055               where buf_temp-browse-handle.browse-type = 'height':u
     3056             on error undo, next
     3057             :
     3058               assign
     3059                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3060               .
     3061             end.
     3062             for each buf_temp-diasize-handle
     3063             on error undo, next
     3064             :
     3065               assign
     3066                 v-object-handle = buf_temp-diasize-handle.handle-value
     3067               .
     3068               if v-object-handle <> v-diasize-resize-button
     3069               then do:
     3070                 assign
     3071                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3072                 .
     3073               end.
     3074             end.
     3075             run diasize_position-resize-button in this-procedure .
     3076           end.
     3077           assign
     3078             v-diasize-change-size = false
     3079           .
     3080           leave move_block .
     3081         end.
     3082       end.
     3083       assign
     3084         v-diasize-need-full-display = true
     3085       .
     3086       if v-diasize-change-size = false
     3087       then do:
     3088         assign
     3089           v-diasize-change-size = true
     3090         .
     3091       end.
     3092       else do:
     3093         return .
     3094       end.
     3095       assign
     3096         v-frame-height = frame Dialog-Frame :height
     3097         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3098         v-browse-height = v-diasize-browse-handle :height
     3099       .
     3100       for each buf_temp-browse-handle
     3101         where buf_temp-browse-handle.browse-type = 'height':u
     3102       :
     3103         assign
     3104           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3105         .
     3106       end.
     3107       for each buf_temp-diasize-handle
     3108       :
     3109         delete buf_temp-diasize-handle .
     3110       end.
     3111       assign
     3112         v-field-group-handle = frame Dialog-Frame :first-child
     3113       .
     3114       do while valid-handle(v-field-group-handle)
     3115       :
     3116         assign
     3117           v-object-handle = v-field-group-handle :first-child
     3118         .
     3119         do while valid-handle(v-object-handle)
     3120         :
     3121           if  v-object-handle <> v-diasize-browse-handle :handle
     3122           and can-query(v-object-handle, "row")
     3123           and can-query(v-object-handle, "height")
     3124           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3125           then do:
     3126             find first buf_temp-browse-handle
     3127               where buf_temp-browse-handle.browse-type   = 'height':u
     3128                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3129               no-error .
     3130             if available buf_temp-browse-handle
     3131             then do:
     3132             end.
     3133             else do:
     3134               create buf_temp-diasize-handle .
     3135               assign
     3136                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3137                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3138               .
     3139             end.
     3140           end.
     3141           assign
     3142             v-object-handle = v-object-handle :next-sibling
     3143           .
     3144         end.
     3145         assign
     3146           v-field-group-handle = v-field-group-handle :next-sibling
     3147         .
     3148       end.
     3149       do with frame Dialog-Frame
     3150       :
     3151         hide v-diasize-resize-button .
     3152         assign
     3153           v-diasize-resize-button :row    = 1
     3154           v-diasize-resize-button :column = 1
     3155         .
     3156       end.
     3157       if p-change-value > 0
     3158       then do:
     3159         if frame Dialog-Frame :scrollable = true
     3160         then do:
     3161           assign
     3162             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3163             no-error .
     3164           if error-status :error
     3165           or error-status :get-message(1) <> ""
     3166           then do:
     3167             undo move_block, retry move_block .
     3168           end.
     3169         end.
     3170         assign
     3171           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3172           no-error .
     3173         if error-status :error
     3174         or error-status :get-message(1) <> ""
     3175         then do:
     3176           undo move_block, retry move_block .
     3177         end.
     3178         assign
     3179           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3180           no-error .
     3181         if error-status :error
     3182         or error-status :get-message(1) <> ""
     3183         then do:
     3184           undo move_block, retry move_block .
     3185         end.
     3186         for each buf_temp-browse-handle
     3187           where buf_temp-browse-handle.browse-type = 'height':u
     3188         on error undo move_block, retry move_block
     3189         :
     3190           assign
     3191             buf_temp-browse-handle.browse-handle :height
     3192               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3193             no-error .
     3194           if error-status :error
     3195           or error-status :get-message(1) <> ""
     3196           then do:
     3197             undo move_block, retry move_block .
     3198           end.
     3199         end.
     3200         for each buf_temp-diasize-handle
     3201         on error undo move_block, retry move_block
     3202         :
     3203           assign
     3204             v-object-handle = buf_temp-diasize-handle.handle-value
     3205           .
     3206           if v-object-handle <> v-diasize-resize-button
     3207           then do:
     3208             assign
     3209               v-object-handle :row = v-object-handle :row + p-change-value
     3210               no-error .
     3211             if error-status :error
     3212             or error-status :get-message(1) <> ""
     3213             then do:
     3214               undo move_block, retry move_block .
     3215             end.
     3216           end.
     3217         end.
     3218       end.
     3219       else do:
     3220         for each buf_temp-diasize-handle
     3221         on error undo move_block, retry move_block
     3222         :
     3223           assign
     3224             v-object-handle = buf_temp-diasize-handle.handle-value
     3225           .
     3226           if v-object-handle <> v-diasize-resize-button
     3227           then do:
     3228             assign
     3229               v-object-handle :row = v-object-handle :row + p-change-value
     3230               no-error .
     3231             if error-status :error
     3232             or error-status :get-message(1) <> ""
     3233             then do:
     3234               undo move_block, retry move_block .
     3235             end.
     3236           end.
     3237         end.
     3238         assign
     3239           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3240           no-error .
     3241         if error-status :error
     3242         or error-status :get-message(1) <> ""
     3243         then do:
     3244           undo move_block, retry move_block .
     3245         end.
     3246         for each buf_temp-browse-handle
     3247           where buf_temp-browse-handle.browse-type = 'height':u
     3248         on error undo move_block, retry move_block
     3249         :
     3250           assign
     3251             buf_temp-browse-handle.browse-handle :height
     3252               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3253             no-error .
     3254           if error-status :error
     3255           or error-status :get-message(1) <> ""
     3256           then do:
     3257             undo move_block, retry move_block .
     3258           end.
     3259         end.
     3260         assign
     3261           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3262           no-error .
     3263         if error-status :error
     3264         or error-status :get-message(1) <> ""
     3265         then do:
     3266           undo move_block, retry move_block .
     3267         end.
     3268         if frame Dialog-Frame :scrollable = true
     3269         then do:
     3270           assign
     3271             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3272             no-error .
     3273           if error-status :error
     3274           or error-status :get-message(1) <> ""
     3275           then do:
     3276             undo move_block, retry move_block .
     3277           end.
     3278         end.
     3279       end.
     3280       if p-move-resize = true
     3281       then do:
     3282         run diasize_position-resize-button in this-procedure .
     3283       end.
     3284       if v-diasize-wndstore = true
     3285       then do:
     3286         if connected("ub") = true
     3287         then do:
     3288           define variable v-cntxt-db-num        as integer   no-undo .
     3289           define variable v-cntxt-userid        as character no-undo .
     3290           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3291                                             , OUTPUT v-cntxt-userid
     3292                                             ) .
     3293           run gbl/wndsizew.p
     3294             (input  v-cntxt-db-num
     3295             ,input  v-cntxt-userid
     3296             ,input  v-diasize-proc-name
     3297             ,input  'height':u
     3298             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3299             ) .
     3300         end.
     3301       end.
     3302     end.
     3303     assign
     3304       v-diasize-change-size = false
     3305     .
     3306   end procedure.
     3307   procedure diasize_set-height :
     3308     define input  parameter p-new-height  as decimal   no-undo .
     3309     define input  parameter p-move-resize as logical   no-undo .
     3310     do
     3311     on error undo, return error return-value
     3312     :
     3313       run diasize_change-height in this-procedure
     3314         (input  (p-new-height - frame Dialog-Frame :height)
     3315         ,input  p-move-resize
     3316         ) .
     3317     end.
     3318   end procedure.
     3319   procedure diasize_change-width :
     3320     define input  parameter p-change-value as decimal   no-undo .
     3321     define input  parameter p-move-resize  as logical   no-undo .
     3322     define variable v-field-group-handle   as handle    no-undo .
     3323     define variable v-object-handle        as handle    no-undo .
     3324     define variable v-frame-width          as decimal   no-undo .
     3325     define variable v-frame-virtual-width  as decimal   no-undo .
     3326     define variable v-browse-width         as decimal   no-undo .
     3327     define variable v-window-width         as decimal   no-undo .
     3328     define variable v-window-virtual-width as decimal   no-undo .
     3329     define variable v-change-sign          as integer   no-undo .
     3330     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3331     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3332     if p-change-value > 0
     3333     then do:
     3334       if frame Dialog-Frame :width + p-change-value >
     3335           session :width-chars
     3336       then do:
     3337         assign
     3338           p-change-value = session :width-chars - frame Dialog-Frame :width
     3339         .
     3340         if p-change-value <= 0
     3341         then do:
     3342           run diasize_position-resize-button in this-procedure .
     3343           return .
     3344         end.
     3345       end.
     3346     end.
     3347     if p-change-value < 0
     3348     then do:
     3349       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3350       then do:
     3351         assign
     3352           p-change-value = v-diasize-orig-frame-width
     3353                          - frame Dialog-Frame :width
     3354         .
     3355         if p-change-value >= 0
     3356         then do:
     3357           run diasize_position-resize-button in this-procedure .
     3358           return .
     3359         end.
     3360       end.
     3361     end.
     3362     if p-change-value >= 0
     3363     then do:
     3364       assign
     3365         v-change-sign = 1
     3366       .
     3367     end.
     3368     else do:
     3369       assign
     3370         v-change-sign = -1
     3371       .
     3372     end.
     3373     assign
     3374       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3375     .
     3376     if p-change-value = 0
     3377     then do:
     3378       run diasize_position-resize-button in this-procedure .
     3379       return .
     3380     end.
     3381     move_block:
     3382     do
     3383     on error undo move_block, leave move_block
     3384     :
     3385       if retry
     3386       then do:
     3387         do
     3388         on error undo move_block, leave move_block
     3389         :
     3390           if p-change-value > 0
     3391           then do:
     3392             for each buf_temp-diasize-handle
     3393             on error undo, next
     3394             :
     3395               assign
     3396                 v-object-handle = buf_temp-diasize-handle.handle-value
     3397               .
     3398               if v-object-handle <> v-diasize-resize-button
     3399               then do:
     3400                 assign
     3401                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3402                 .
     3403               end.
     3404             end.
     3405             assign
     3406               v-diasize-browse-handle :width = v-browse-width
     3407             .
     3408             for each buf_temp-browse-handle
     3409               where buf_temp-browse-handle.browse-type = 'width':u
     3410             on error undo, next
     3411             :
     3412               assign
     3413                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3414               .
     3415             end.
     3416             assign
     3417               frame Dialog-Frame :width = v-frame-width
     3418             .
     3419             if frame Dialog-Frame :scrollable = true
     3420             then do:
     3421               assign
     3422                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3423               .
     3424             end.
     3425             run diasize_position-resize-button in this-procedure .
     3426           end.
     3427           else do:
     3428             if frame Dialog-Frame :scrollable = true
     3429             then do:
     3430               assign
     3431                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3432               .
     3433             end.
     3434             assign
     3435               frame Dialog-Frame :width = v-frame-width
     3436             .
     3437             for each buf_temp-browse-handle
     3438               where buf_temp-browse-handle.browse-type = 'width':u
     3439             on error undo, next
     3440             :
     3441               assign
     3442                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3443               .
     3444             end.
     3445             assign
     3446               v-diasize-browse-handle :width = v-browse-width
     3447             .
     3448             for each buf_temp-diasize-handle
     3449             on error undo, next
     3450             :
     3451               assign
     3452                 v-object-handle = buf_temp-diasize-handle.handle-value
     3453               .
     3454               if v-object-handle <> v-diasize-resize-button
     3455               then do:
     3456                 assign
     3457                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3458                 .
     3459               end.
     3460             end.
     3461             run diasize_position-resize-button in this-procedure .
     3462           end.
     3463           assign
     3464             v-diasize-change-size = false
     3465           .
     3466           leave move_block .
     3467         end.
     3468       end.
     3469       assign
     3470         v-diasize-need-full-display = true
     3471       .
     3472       if v-diasize-change-size = false
     3473       then do:
     3474         assign
     3475           v-diasize-change-size = true
     3476         .
     3477       end.
     3478       else do:
     3479         return .
     3480       end.
     3481       assign
     3482         v-frame-width = frame Dialog-Frame :width
     3483         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3484         v-browse-width = v-diasize-browse-handle :width
     3485       .
     3486       for each buf_temp-browse-handle
     3487         where buf_temp-browse-handle.browse-type = 'width':u
     3488       :
     3489         assign
     3490           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3491         .
     3492       end.
     3493       for each buf_temp-diasize-handle
     3494       :
     3495         delete buf_temp-diasize-handle .
     3496       end.
     3497       assign
     3498         v-field-group-handle = frame Dialog-Frame :first-child
     3499       .
     3500       do while valid-handle(v-field-group-handle)
     3501       :
     3502         assign
     3503           v-object-handle = v-field-group-handle :first-child
     3504         .
     3505         do while valid-handle(v-object-handle)
     3506         :
     3507           if  v-object-handle <> v-diasize-browse-handle :handle
     3508           and v-object-handle <> v-diasize-resize-button
     3509           and can-query(v-object-handle, "row")
     3510           and can-query(v-object-handle, "height")
     3511           and ( v-object-handle :col + v-object-handle :width
     3512                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3513               )
     3514           then do:
     3515             find first buf_temp-browse-handle
     3516               where buf_temp-browse-handle.browse-type   = 'width':u
     3517                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3518               no-error .
     3519             if available buf_temp-browse-handle
     3520             then do:
     3521             end.
     3522             else do:
     3523               create buf_temp-diasize-handle .
     3524               assign
     3525                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3526                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3527               .
     3528             end.
     3529           end.
     3530           assign
     3531             v-object-handle = v-object-handle :next-sibling
     3532           .
     3533         end.
     3534         assign
     3535           v-field-group-handle = v-field-group-handle :next-sibling
     3536         .
     3537       end.
     3538       do with frame Dialog-Frame
     3539       :
     3540         hide v-diasize-resize-button .
     3541         v-diasize-resize-button :row = 1.
     3542         v-diasize-resize-button :column = 1.
     3543       end.
     3544       if p-change-value > 0
     3545       then do:
     3546         if frame Dialog-Frame :scrollable = true
     3547         then do:
     3548           assign
     3549             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3550             no-error .
     3551           if error-status :error
     3552           or error-status :get-message(1) <> ""
     3553           then do:
     3554             undo move_block, retry move_block.
     3555           end.
     3556         end.
     3557         assign
     3558           frame Dialog-Frame :width = v-frame-width + p-change-value
     3559           no-error .
     3560         if error-status :error
     3561         or error-status :get-message(1) <> ""
     3562         then do:
     3563           undo move_block, retry move_block.
     3564         end.
     3565         assign
     3566           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3567         no-error .
     3568         if error-status :error
     3569         or error-status :get-message(1) <> ""
     3570         then do:
     3571           undo move_block, retry move_block.
     3572         end.
     3573         for each buf_temp-browse-handle
     3574           where buf_temp-browse-handle.browse-type = 'width':u
     3575         on error undo move_block, retry move_block
     3576         :
     3577           assign
     3578             buf_temp-browse-handle.browse-handle :width
     3579               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3580             no-error .
     3581           if error-status :error
     3582           or error-status :get-message(1) <> ""
     3583           then do:
     3584             undo move_block, retry move_block .
     3585           end.
     3586         end.
     3587         for each buf_temp-diasize-handle
     3588         on error undo move_block, retry move_block
     3589         :
     3590           assign
     3591             v-object-handle = buf_temp-diasize-handle.handle-value
     3592           .
     3593           if v-object-handle <> v-diasize-resize-button
     3594           then do:
     3595             assign
     3596               v-object-handle :col = v-object-handle :col + p-change-value
     3597               no-error .
     3598             if error-status :error
     3599             or error-status :get-message(1) <> ""
     3600             then do:
     3601               undo move_block, retry move_block .
     3602             end.
     3603           end.
     3604         end.
     3605       end.
     3606       else do:
     3607         for each buf_temp-diasize-handle
     3608         on error undo move_block, retry move_block
     3609         :
     3610           assign
     3611             v-object-handle = buf_temp-diasize-handle.handle-value
     3612           .
     3613           if v-object-handle <> v-diasize-resize-button
     3614           then do:
     3615             assign
     3616               v-object-handle :col = v-object-handle :col + p-change-value
     3617               no-error .
     3618             if error-status :error
     3619             or error-status :get-message(1) <> ""
     3620             then do:
     3621               undo move_block, retry move_block .
     3622             end.
     3623           end.
     3624         end.
     3625         for each buf_temp-browse-handle
     3626           where buf_temp-browse-handle.browse-type = 'width':u
     3627         on error undo move_block, retry move_block
     3628         :
     3629           assign
     3630             buf_temp-browse-handle.browse-handle :width
     3631               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3632             no-error .
     3633           if error-status :error
     3634           or error-status :get-message(1) <> ""
     3635           then do:
     3636             undo move_block, retry move_block .
     3637           end.
     3638         end.
     3639         assign
     3640           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3641           no-error .
     3642         if error-status :error
     3643         or error-status :get-message(1) <> ""
     3644         then do:
     3645           undo move_block, retry move_block.
     3646         end.
     3647         assign
     3648           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3649         no-error .
     3650         if error-status :error
     3651         or error-status :get-message(1) <> ""
     3652         then do:
     3653           undo move_block, retry move_block.
     3654         end.
     3655         if frame Dialog-Frame :scrollable = true
     3656         then do:
     3657           assign
     3658             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3659           no-error .
     3660           if error-status :error
     3661           or error-status :get-message(1) <> ""
     3662           then do:
     3663             undo move_block, retry move_block.
     3664           end.
     3665         end.
     3666       end.
     3667       if p-move-resize
     3668       then do:
     3669         run diasize_position-resize-button in this-procedure .
     3670       end.
     3671       if v-diasize-wndstore = true
     3672       then do:
     3673         if connected("ub") = true
     3674         then do:
     3675           define variable v-cntxt-db-num        as integer   no-undo .
     3676           define variable v-cntxt-userid        as character no-undo .
     3677           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3678                                             , OUTPUT v-cntxt-userid
     3679                                             ) .
     3680           run gbl/wndsizew.p
     3681             (input  v-cntxt-db-num
     3682             ,input  v-cntxt-userid
     3683             ,input  v-diasize-proc-name
     3684             ,input  'width':u
     3685             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3686             ) .
     3687         end.
     3688       end.
     3689     end.
     3690     assign
     3691       v-diasize-change-size = false
     3692     .
     3693   end procedure.
     3694   procedure diasize_set-width :
     3695     define input  parameter p-new-width  as decimal   no-undo .
     3696     define input  parameter p-move-resize as logical   no-undo .
     3697     do
     3698     on error undo, return error return-value
     3699     :
     3700       run diasize_change-width in this-procedure
     3701         (input  (p-new-width - frame Dialog-Frame :width)
     3702         ,input  p-move-resize
     3703         ) .
     3704     end.
     3705   end procedure.
     3706   procedure diasize_position-resize-button :
     3707     do with frame Dialog-Frame
     3708     :
     3709       hide v-diasize-resize-button .
     3710       assign
     3711         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3712                     - 1
     3713                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3714         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3715                     - 1
     3716                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3717       .
     3718       view v-diasize-resize-button .
     3719     end.
     3720   end procedure.
     3721   on alt-right anywhere
     3722   do:
     3723     run diasize_change-width in this-procedure
     3724       (input 1
     3725       ,input true
     3726       ) .
     3727     return no-apply .
     3728   end.
     3729   on alt-left anywhere
     3730   do:
     3731     run diasize_change-width in this-procedure
     3732       (input -1
     3733       ,input true
     3734       ) .
     3735     return no-apply .
     3736   end.
     3737   on alt-down anywhere
     3738   do:
     3739     run diasize_change-height in this-procedure
     3740       (input 1
     3741       ,input true
     3742       ) .
     3743     return no-apply .
     3744   end.
     3745   on alt-up anywhere
     3746   do:
     3747     run diasize_change-height in this-procedure
     3748       (input -1
     3749       ,input true
     3750       ) .
     3751     return no-apply .
     3752   end.
     3753   on alt-enter of frame Dialog-Frame
     3754   do:
     3755     run diasize_maximize in this-procedure
     3756       (input  ?
     3757       ).
     3758     return no-apply .
     3759   end.
     3760   procedure diasize_end-move :
     3761     do
     3762     on error undo, return error return-value
     3763     :
     3764       define variable v-row-delta as decimal   no-undo .
     3765       define variable v-col-delta as decimal   no-undo .
     3766       define variable v-new-row as decimal   no-undo .
     3767       define variable v-new-col as decimal   no-undo .
     3768       assign
     3769         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3770         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3771       .
     3772       assign
     3773         v-row-delta = v-new-row - frame Dialog-Frame :height
     3774         v-col-delta = v-new-col - frame Dialog-Frame :width
     3775       .
     3776       run diasize_change-height in this-procedure
     3777         (input v-row-delta
     3778         ,input true
     3779         ) .
     3780       run diasize_change-width in this-procedure
     3781         (input v-col-delta
     3782         ,input true
     3783         ) .
     3784     end.
     3785   end procedure.
     3786   procedure diasize_maximize :
     3787     define input  parameter p-action as logical   no-undo .
     3788     do
     3789     on error undo, return error return-value
     3790     :
     3791       if p-action = ?
     3792       then do:
     3793         if v-diasize-need-maximize = true
     3794         then do:
     3795           assign
     3796             p-action = true
     3797           .
     3798         end.
     3799         else do:
     3800           assign
     3801             p-action = false
     3802           .
     3803         end.
     3804       end.
     3805       if p-action = true
