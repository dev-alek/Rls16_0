     4216   RUN Get-Gl-Set-Proc-Otkl IN THIS-PROCEDURE(
     4217       buf_Matrix.obj-type,
     4218       buf_Matrix.obj-code
     4219       ).
     4220   MAIN-BLOCK:
     4221   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4222      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4223   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4224   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     4225     (output v-db-num
     4226     )  .
     4227     run ini-proc in this-procedure .
     4228     run my_enable in this-procedure .
     4229      hide mark-num in frame Dialog-Frame .
     4230     if v-doc-rec <> ? then
     4231     reposition BROWSE-am-goods to recid v-doc-rec no-error.
     4232   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4233   DEF VAR cur-clmn-numBROWSE-am-goods as INT EXTENT 16 no-undo.
     4234   DEF VAR varmviBROWSE-am-goods       as INT no-undo.
     4235   DEF VAR varmvjBROWSE-am-goods       as INT no-undo.
     4236   DEF VAR varmvkBROWSE-am-goods       as INT no-undo.
     4237   DEF VAR varmvlBROWSE-am-goods       as INT no-undo.
     4238   DEF VAR move-elementBROWSE-am-goods as INT no-undo.
     4239   def var jjBROWSE-am-goods           as int no-undo.
     4240   do varmviBROWSE-am-goods = 1 to EXTENT(cur-clmn-numBROWSE-am-goods):
     4241     ASSIGN cur-clmn-numBROWSE-am-goods[varmviBROWSE-am-goods] = varmviBROWSE-am-goods.
     4242   END.
     4243   RUN start-mv-clmnBROWSE-am-goods.
     4244   PROCEDURE start-mv-clmnBROWSE-am-goods:
     4245   def var old-session as logical no-undo.
     4246      old-session = SESSION:IMMEDIATE-DISPLAY.
     4247      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4248      SESSION:IMMEDIATE-DISPLAY = old-session.
     4249   END.
     4250   ON ctrl-cursor-right OF BROWSE BROWSE-am-goods do:
     4251     RUN re-move-clmnBROWSE-am-goods ( 1, 16).
     4252   END.
     4253   ON ctrl-cursor-left OF BROWSE BROWSE-am-goods do:
     4254     RUN re-move-clmnBROWSE-am-goods (16, 1).
     4255   END.
     4256   PROCEDURE re-move-clmnBROWSE-am-goods:
     4257     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     4258     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     4259     DO varmviBROWSE-am-goods = 1 TO EXTENT(cur-clmn-numBROWSE-am-goods):
     4260       if cur-clmn-numBROWSE-am-goods[varmviBROWSE-am-goods] = source-column THEN cur-clmn-numBROWSE-am-goods[varmviBROWSE-am-goods] = -1.
     4261     END.
     4262     if BROWSE-am-goods:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     4263     if source-column > target-column THEN
     4264     DO varmvjBROWSE-am-goods = source-column - 1 to target-column BY -1:
     4265       DO varmviBROWSE-am-goods = 1 TO EXTENT(cur-clmn-numBROWSE-am-goods):
     4266           if cur-clmn-numBROWSE-am-goods[varmviBROWSE-am-goods] = varmvjBROWSE-am-goods THEN DO:
     4267             cur-clmn-numBROWSE-am-goods[varmviBROWSE-am-goods] = cur-clmn-numBROWSE-am-goods[varmviBROWSE-am-goods] + 1.
     4268           END.
     4269       END.
     4270     END.
     4271     ELSE
     4272     DO varmvjBROWSE-am-goods = source-column + 1 to target-column:
     4273       DO varmviBROWSE-am-goods = 1 TO EXTENT(cur-clmn-numBROWSE-am-goods):
     4274         if cur-clmn-numBROWSE-am-goods[varmviBROWSE-am-goods] = varmvjBROWSE-am-goods THEN DO:
     4275           cur-clmn-numBROWSE-am-goods[varmviBROWSE-am-goods] = cur-clmn-numBROWSE-am-goods[varmviBROWSE-am-goods] - 1.
     4276         END.
     4277       END.
     4278     END.
     4279     DO varmviBROWSE-am-goods = 1 TO EXTENT(cur-clmn-numBROWSE-am-goods):
     4280       if cur-clmn-numBROWSE-am-goods[varmviBROWSE-am-goods] = -1 THEN cur-clmn-numBROWSE-am-goods[varmviBROWSE-am-goods] = target-column.
     4281     END.
     4282   END PROCEDURE.
     4283   PROCEDURE ch-clmnBROWSE-am-goods:
     4284     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     4285     if cur-clmn-loc <= 1 then do:
     4286       return .
     4287     end.
     4288     DO varmviBROWSE-am-goods = 1 TO EXTENT(cur-clmn-numBROWSE-am-goods):
     4289       if cur-clmn-numBROWSE-am-goods[varmviBROWSE-am-goods] = cur-clmn-loc THEN move-elementBROWSE-am-goods = varmviBROWSE-am-goods.
     4290     END.
     4291     RUN re-move-clmnBROWSE-am-goods (cur-clmn-loc, 1).
     4292   END PROCEDURE.
     4293   PROCEDURE mv-brw-defaultBROWSE-am-goods:
     4294   def var old-session as logical no-undo.
     4295     old-session = SESSION:IMMEDIATE-DISPLAY.
     4296     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4297     do varmvlBROWSE-am-goods = 1 to EXTENT(cur-clmn-numBROWSE-am-goods):
     4298       RUN re-move-clmnBROWSE-am-goods (cur-clmn-numBROWSE-am-goods[varmvlBROWSE-am-goods], varmvlBROWSE-am-goods).
     4299     END.
     4300     RUN start-mv-clmnBROWSE-am-goods.
     4301     SESSION:IMMEDIATE-DISPLAY = old-session.
     4302   END PROCEDURE.
     4303   .
     4304     apply "VALUE-CHANGED" to BROWSE-am-goods in frame Dialog-Frame.
     4305     WAIT-FOR GO OF FRAME Dialog-Frame focus BROWSE-am-goods.
     4306   END.
     4307   run disable_ui in this-procedure .
     4308   PROCEDURE assort-polit :
     4309   do
     4310   on error undo, return error return-value
     4311   :
     4312   end.
     4313   END PROCEDURE.
     4314   PROCEDURE calc-itogi :
     4315   DEFINE BUFFER Buf_matrix-goods1 FOR ub.assortment-matrix-goods.
     4316   DEFINE VARIABLE  v-value as CHARACTER  NO-UNDO INITIAL "".
     4317   DEFINE VARIABLE  lIsObj       as LOGICAL    NO-UNDO INITIAL FALSE.
     4318   DEFINE VARIABLE  v-iAsmt-id   as INTEGER    NO-UNDO INITIAL 0.
     4319   DEFINE VARIABLE  v-iDb-num    as INTEGER    NO-UNDO INITIAL 0.
     4320   DEFINE VARIABLE  v-type       as CHARACTER  NO-UNDO INITIAL "".
     4321   DEFINE VARIABLE  cError       as CHARACTER  NO-UNDO INITIAL "".
     4322   ASSIGN
     4323      v-kol-all       = 0
     4324      v-kol-del       = 0
     4325      v-kol-in-shabl  = 0
     4326      v-raznost       = 0
     4327      v-proc-otkl     = 0
     4328      .
     4329   RUN Get-Gl-Param-Proc-Otkl in THIS-PROCEDURE(
     4330       p-Id,
     4331       p-Db-num,
     4332       OUTPUT cError
     4333       ).
     4334   if cError <> "" THEN DO:
     4335      MESSAGE
     4336         PROGRAM-NAME(1) ":"  SKIP
     4337         "Ошибок быть не должно !" SKIP
     4338         cError SKIP
     4339         VIEW-AS ALERT-BOX INFO BUTTONS OK.
     4340   END.
     4341   ASSIGN
     4342      v-kol-all       = v-gl-iAM-Gds-All
     4343      v-kol-del       = v-gl-iAM-Gds-Vyv
     4344      v-kol-in-shabl  = v-gl-iAM-Sbl-Gds-All
     4345      v-raznost       = (IF v-gl-lAM-Is-Obj AND v-gl-lAM-Ref-Shablon
     4346                            THEN (v-gl-iAM-Gds-All  - v-gl-iAM-Sbl-Gds-All)
     4347                            ELSE 0)
     4348      v-proc-otkl     = v-gl-dAM-Proc-Otkl
     4349      .
     4350   DISPLAY
     4351      v-kol-all
     4352      v-kol-del
     4353      v-kol-in-shabl
     4354      v-raznost
     4355      v-proc-otkl
     4356      WITH FRAME Dialog-Frame.
     4357   END PROCEDURE.
     4358   PROCEDURE create-tt-gds :
     4359   define input  parameter p-gds-code as integer   no-undo .
     4360   define input  parameter p-status as integer   no-undo .
     4361   find first temp-goods where
     4362     temp-goods.gds-code = p-gds-code no-error .
     4363     if not available temp-goods then create temp-goods.
     4364       assign
     4365         temp-goods.gds-code = p-gds-code
     4366         temp-goods.status_ = p-status
     4367         .
     4368   END PROCEDURE.
     4369   PROCEDURE disable_UI :
     4370     HIDE FRAME Dialog-Frame.
     4371   END PROCEDURE.
     4372   PROCEDURE econom-mode :
     4373   define output parameter p-is as logical   no-undo .
     4374   p-is = true .
     4375   END PROCEDURE.
     4376   PROCEDURE enable_UI :
     4377     DISPLAY RS-sts a-n-c sch-artic ED_asmg-des mark-num FILL-IN-1 FILL-IN-7
     4378             v-user-name-create v-user-name-corr v-kol-all v-kol-in-shabl v-raznost
     4379             v-proc-otkl v-kol-del
     4380         WITH FRAME Dialog-Frame.
     4381     ENABLE b-quit B-mark B-mark-all B-mark-del-all B-sel B-add B-lookup B-chg
     4382            B-del B-copy B-print B-Help B-chg-izt B-grpAcc RS-sts a-n-c sch-artic
     4383            BROWSE-am-goods ED_asmg-des mark-num FILL-IN-1 FILL-IN-7
     4384            v-user-name-create v-user-name-corr v-kol-all v-kol-in-shabl v-raznost
     4385            v-proc-otkl v-kol-del
     4386         WITH FRAME Dialog-Frame.
     4387     VIEW FRAME Dialog-Frame.
     4388     OPEN QUERY BROWSE-am-goods FOR EACH Buf_matrix-goods       WHERE Buf_matrix-goods.db-num =  p-db-num         AND Buf_matrix-goods.asmt-id = p-id NO-LOCK,          first Buf_goods NO-LOCK where Buf_matrix-goods.gds-code =  Buf_goods.gds-code .
     4389   END PROCEDURE.
     4390   PROCEDURE ini-proc :
     4391   define buffer obj_assortment-matrix for ub.assortment-matrix  .
     4392   define buffer sh_assortment-matrix for ub.assortment-matrix  .
     4393     for each temp-goods :
     4394         delete temp-goods.
     4395     end.
     4396     is-shablonLink = false .
     4397     is-objLink = false .
     4398     if buf_matrix.asmt-type <> 'Объект':U  then do:
     4399      for each obj_assortment-matrix no-lock where
     4400               obj_assortment-matrix.asmt-status = 0 and
     4401               obj_assortment-matrix.asmt-type = 'Объект':U ,
     4402         first ub.assortment-matrix-attr no-lock where
     4403               ub.assortment-matrix-attr.asmt-id    = obj_assortment-matrix.asmt-id and
     4404               ub.assortment-matrix-attr.db-num     = obj_assortment-matrix.db-num and
     4405               ub.assortment-matrix-attr.attr-code  = 'RootShablon':U and
     4406               ub.assortment-matrix-attr.attr-value = substitute("&1&3&2" , buf_matrix.asmt-id,buf_matrix.db-num,chr(4))
     4407               :
     4408               is-shablonLink = true  .
     4409               leave.
     4410      end.
     4411     end.
     4412     else do:
     4413       find first ub.assortment-matrix-attr no-lock where
     4414             ub.assortment-matrix-attr.asmt-id    = buf_matrix.asmt-id and
     4415             ub.assortment-matrix-attr.db-num     = buf_matrix.db-num and
     4416             ub.assortment-matrix-attr.attr-code  = 'RootShablon':U
     4417        no-error .
     4418        if available ub.assortment-matrix-attr then do:
     4419           find first sh_assortment-matrix no-lock where
     4420                       sh_assortment-matrix.asmt-status = 0 and
     4421                       sh_assortment-matrix.asmt-type   = 'Шаблон':U and
     4422                       sh_assortment-matrix.asmt-id     = int(entry(1,ub.assortment-matrix-attr.attr-value,chr(4))) and
     4423                       sh_assortment-matrix.db-num = int(entry(2,ub.assortment-matrix-attr.attr-value,chr(4))) no-error .
     4424           if available sh_assortment-matrix then do:
     4425              assign
     4426               is-objLink = true
     4427               is-objLink-id = sh_assortment-matrix.asmt-id
     4428               is-objLink-db = sh_assortment-matrix.db-num
     4429             .
     4430           end.
     4431        end.
     4432     end.
     4433   END PROCEDURE.
     4434   PROCEDURE init-gds-rec :
     4435   if available buf_goods then do:
     4436      gds-rec = recid (buf_goods) .
     4437   end.
     4438   END PROCEDURE.
     4439   PROCEDURE my_enable :
     4440   define variable v-db-num like ub.db.db-num no-undo .
     4441   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4442   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     4443     (output v-db-num
     4444     )  .
     4445   Buf_matrix-goods.asmg-db-num-update:read-only in browse BROWSE-am-goods = true .
     4446   p-indicator-life-gds:resizable in browse BROWSE-am-goods = true .
     4447   p-name:resizable  in browse BROWSE-am-goods = true .
     4448   p-indicator-life-gds:width in browse BROWSE-am-goods = 8.
     4449   ASSIGN
     4450   rs-sts:RADIO-BUTTONS IN FRAME Dialog-Frame
     4451                 = "Текущие&+" + chr(44) +  '0':U + chr(44) +
     4452                 "Все&!" + chr(44) + 'все':U + chr(44) +
     4453                 "Удаленные&-" + chr(44) + '1':U
     4454   rs-sts = (IF p-sts = ? THEN '0':U ELSE string(p-sts))
     4455   .
     4456   rs-sts = '0':U .
     4457   DISPLAY mark-num
     4458   FILL-IN-1
     4459   RS-sts
     4460   fill-in-7
     4461   WITH FRAME Dialog-Frame.
     4462   if is-shablonLink then enable B-link-obj with frame Dialog-Frame .
     4463   else do:
     4464     disable B-link-obj with frame Dialog-Frame .
     4465     hide B-link-obj in frame Dialog-Frame .
     4466   end.
     4467   if is-objLink then do:
     4468    p-shablon:visible  in browse BROWSE-am-goods = true   .
     4469   end.
     4470   else do:
     4471    p-shablon:visible  in browse BROWSE-am-goods = false  .
     4472   end.
     4473   ENABLE
     4474   b-quit
     4475   B-mark when transaction = false
     4476   B-mark-all when transaction = false
     4477   B-mark-del-all when transaction = false
     4478   B-sel when LOOKUP("b-sel":U, bttns) > 0
     4479   B-add when LOOKUP("b-add":U, bttns) > 0  and transaction = false
     4480   B-lookup
     4481   B-chg when LOOKUP("b-add":U, bttns) > 0  and transaction = false
     4482   B-del when LOOKUP("b-add":U, bttns) > 0   and transaction = false
     4483   B-print
     4484   B-grpAcc
     4485   B-Help
     4486   B-copy when LOOKUP("b-add":U, bttns) > 0   and transaction = false
     4487   BROWSE-am-goods
     4488   mark-num
     4489   RS-sts
     4490   ed_asmg-des
     4491   a-n-c
     4492   sch-artic
     4493   B-chg-izt when LOOKUP("b-add":U, bttns) > 0  and transaction = false
     4494   with FRAME Dialog-Frame.
     4495   if buf_matrix.asmt-type <> 'Объект':U  then do:
     4496      hide B-grpAcc in frame Dialog-Frame .
     4497   end.
     4498   ed_asmg-des:READ-ONLY = TRUE.
     4499   run openbr in this-procedure no-error.
     4500   IF ERROR-STATUS:ERROR  THEN RETURN error.
     4501   END PROCEDURE.
     4502   PROCEDURE openBr :
     4503   define variable p-open-query     as logical   no-undo init true .
     4504   def var l-query-was-opened as logical no-undo .
     4505   define variable doc-rec  as recid     no-undo .
     4506   define variable  p-find-next      as logical   no-undo .
     4507   define variable  p-find-condition as character no-undo .
     4508   ASSIGN  FRAME Dialog-Frame
     4509     rs-sts
     4510       .
     4511   ASSIGN
     4512     p-sts = (IF rs-sts = 'все':U THEN ? ELSE INTEGER(rs-sts))
     4513     .
     4514   def var sort-column-phrase as character no-undo .
     4515   case sort-column-name :
     4516     when "" then do:
     4517       assign
     4518         sort-column-phrase = ""
     4519       .
     4520     end.
     4521     otherwise do:
     4522       assign
     4523         sort-column-phrase = "by " + sort-column-name
     4524       .
     4525     end.
     4526   end case.
     4527   define variable title0 as character no-undo init "Ассортиментная матрица" .
     4528    title0 = "Ассортиментная матрица " + buf_matrix.asmt-name.
     4529   IF p-sts = ? THEN DO:
     4530       frame Dialog-Frame:TITLE = title0  .
     4531   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4532   define variable  l-disable-where-46  as logical   no-undo .
     4533   define variable  l-filter-open-46    as logical   .
     4534   define variable  flt-rec-46       as recid     no-undo .
     4535   define variable  filter-name-46      as character no-undo .
     4536   define variable  where-phrase-46     as character no-undo .
     4537   define variable  sort-phrase-46      as character no-undo .
     4538   define variable  where-phrase-rus-46 as character no-undo .
     4539   define variable  sort-phrase-rus-46  as character no-undo .
     4540     run waitfram-show in this-procedure
     4541       (input "ЖДИТЕ ..."
     4542       ).
     4543   run gbl/flt-get.p
     4544     (input filter-point
     4545     ,output flt-rec-46
     4546     ,output filter-name-46
     4547     ,output where-phrase-46
     4548     ,output sort-phrase-46
     4549     ,output where-phrase-rus-46
     4550     ,output sort-phrase-rus-46
     4551     ).
     4552   if p-open-query then do:
     4553       run set-filter-name in this-procedure
     4554         (INPUT filter-name-46
     4555         ) no-error .
     4556     assign
     4557       l-filter-open-46 = false
     4558     .
     4559     if flt-rec-46 <> ?
     4560       or sort-column-phrase > ""
     4561     then do:
     4562       define variable  parameter-2-46 as character no-undo .
     4563       define variable  parameter-3-46 as character no-undo .
     4564       define variable  parameter-4-46 as character no-undo .
     4565       define variable  parameter-5-46 as character no-undo .
     4566       define variable  parameter-6-46 as character no-undo .
     4567       define variable  parameter-7-46 as character no-undo .
     4568         assign
     4569         parameter-3-46 =
     4570                                 "FOR EACH Buf_matrix-goods"
     4571         parameter-4-46 =
     4572           (
     4573             if (" Buf_matrix-goods.db-num = p-db-num  AND Buf_matrix-goods.asmt-id = p-id " + " " + where-phrase-46) <> ""
     4574             then  substitute(' Buf_matrix-goods.db-num = &1 AND Buf_matrix-goods.asmt-id = &2 ' , p-db-num , p-id  )  + " " + where-phrase-46
     4575             else "true"
     4576           )
     4577         parameter-5-46 = (" " + "" + " " + ", first Buf_goods NO-LOCK where Buf_matrix-goods.gds-code = Buf_goods.gds-code")
     4578         parameter-6-46 = if sort-phrase-46 = ''
     4579                              then
     4580           (
     4581           " " + "  " +
     4582             " " + sort-column-phrase +
     4583           " " + " "
     4584           )
     4585                              else
     4586           (
     4587           " " + "  " +
     4588             " " + sort-column-phrase +
     4589           " " + sort-phrase-46
     4590           )
     4591         parameter-7-46 =
     4592           "   "
     4593       .
     4594       do
     4595       on stop undo, leave
     4596       on error undo, leave
     4597       :
     4598         assign
     4599           l-disable-where-46 =
     4600             (" Buf_matrix-goods.db-num = p-db-num  AND Buf_matrix-goods.asmt-id = p-id " + " " + where-phrase-46 = "")
     4601         .
     4602         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4603                             ,input query BROWSE-am-goods:handle
     4604                             ,input parameter-3-46
     4605                             ,input parameter-4-46
     4606                             ,input parameter-5-46
     4607                             ,input parameter-6-46
     4608                             ,input parameter-7-46
     4609                             )
     4610         .
     4611         assign
     4612           l-filter-open-46 = true
     4613         .
     4614       end.
     4615       if l-filter-open-46 = false then do:
     4616         message
     4617           "Ошибка при фильтрации / сортировке" skip
     4618           "Будут показаны записи без учета фильтра" skip
     4619           view-as alert-box .
     4620       end.
     4621       else do:
     4622           assign
     4623             l-query-was-opened = true
     4624           .
     4625       end.
     4626     end.
     4627     if l-filter-open-46 = false then do:
     4628       OPEN QUERY BROWSE-am-goods FOR EACH Buf_matrix-goods no-lock
     4629         where  Buf_matrix-goods.db-num = p-db-num  AND Buf_matrix-goods.asmt-id = p-id
     4630       , first Buf_goods NO-LOCK where Buf_matrix-goods.gds-code = Buf_goods.gds-code
     4631     .
     4632         assign
     4633           l-query-was-opened = true
     4634         .
     4635     end.
     4636   end.
     4637   else do:
     4638     assign
     4639       doc-rec = recid( buf_matrix-goods )
     4640     .
     4641     do
     4642     on stop undo, leave
     4643     on error undo, leave
     4644     :
     4645       if query BROWSE-am-goods:handle:get-buffer-handle(1) = (buffer Buf_matrix-goods:handle) then do:
     4646         assign
     4647         parameter-2-46 = (if p-find-next then "true":u else "false":u )
     4648         parameter-4-46 =
     4649           "where ":u +  substitute(' Buf_matrix-goods.db-num = &1 AND Buf_matrix-goods.asmt-id = &2 ' , p-db-num , p-id  )  + " ":u + where-phrase-46 + " ":u + p-find-condition + " " + ""
     4650         parameter-5-46 = "  "
     4651       .
     4652         run fltopend_fltfindd in this-procedure  (
     4653                             input this-procedure:handle
     4654                             ,input query BROWSE-am-goods:handle
     4655                             ,input rowid(buf_matrix-goods)
     4656                             ,input logical(parameter-2-46)
     4657                             ,input no-lock
     4658                             ,input (buffer buf_matrix-goods:handle)
     4659                             ,input parameter-4-46
     4660                             ,input parameter-5-46
     4661                             ) no-error.
     4662         .
     4663         assign
     4664           doc-rec = integer(return-value)
     4665           v-fltopend-rowid[1] = ?
     4666         .
     4667       end.
     4668       else do:
     4669         assign
     4670         parameter-2-46 = (if p-find-next then "true":u else "false":u )
     4671         parameter-3-46 =  "FOR EACH Buf_matrix-goods"
     4672         parameter-4-46 =
     4673           (
     4674             if (" Buf_matrix-goods.db-num = p-db-num  AND Buf_matrix-goods.asmt-id = p-id " + " " + where-phrase-46) <> ""
     4675             then  substitute(' Buf_matrix-goods.db-num = &1 AND Buf_matrix-goods.asmt-id = &2 ' , p-db-num , p-id  )  + " " + where-phrase-46
     4676             else "true"
     4677           )
     4678         parameter-5-46 = (" " + "" + " " + ", first Buf_goods NO-LOCK where Buf_matrix-goods.gds-code = Buf_goods.gds-code" + " " + p-find-condition)
     4679         parameter-6-46 = if sort-phrase-46 = ''
     4680                              then
     4681           (
     4682           " " + "  " +
     4683             " " + sort-column-phrase +
     4684           " " + " "
     4685           )
     4686                              else
     4687           (
     4688           " " + "  " +
     4689             " " + sort-column-phrase +
     4690           " " + sort-phrase-46
     4691           )
     4692         parameter-7-46 =
     4693           "   "
     4694       .
     4695         run fltopend_fltfindq in this-procedure  (
     4696                             input this-procedure:handle
     4697                             ,input query BROWSE-am-goods:handle
     4698                             ,input logical(parameter-2-46)
     4699                             ,input no-lock
     4700                             ,input parameter-3-46
     4701                             ,input parameter-4-46
     4702                             ,input parameter-5-46
     4703                             ,input parameter-6-46
     4704                             ,input parameter-7-46
     4705                             ,output v-fltopend-rowid
     4706                             ) no-error.
     4707         .
     4708         doc-rec = ?.
     4709       end.
     4710       assign
     4711         l-query-was-opened = true
     4712       .
     4713     end.
     4714   end.
     4715     run waitfram-hide in this-procedure .
     4716   END.
     4717   ELSE DO:
     4718       frame Dialog-Frame:TITLE = title0 + chr(32) + entry (lookup (STRING(p-sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U).
     4719   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4720   define variable  l-disable-where-48  as logical   no-undo .
     4721   define variable  l-filter-open-48    as logical   .
     4722   define variable  flt-rec-48       as recid     no-undo .
     4723   define variable  filter-name-48      as character no-undo .
     4724   define variable  where-phrase-48     as character no-undo .
     4725   define variable  sort-phrase-48      as character no-undo .
     4726   define variable  where-phrase-rus-48 as character no-undo .
     4727   define variable  sort-phrase-rus-48  as character no-undo .
     4728     run waitfram-show in this-procedure
     4729       (input "ЖДИТЕ ..."
     4730       ).
     4731   run gbl/flt-get.p
     4732     (input filter-point
     4733     ,output flt-rec-48
     4734     ,output filter-name-48
     4735     ,output where-phrase-48
     4736     ,output sort-phrase-48
     4737     ,output where-phrase-rus-48
     4738     ,output sort-phrase-rus-48
     4739     ).
     4740   if p-open-query then do:
     4741       run set-filter-name in this-procedure
     4742         (INPUT filter-name-48
     4743         ) no-error .
     4744     assign
     4745       l-filter-open-48 = false
     4746     .
     4747     if flt-rec-48 <> ?
     4748       or sort-column-phrase > ""
     4749     then do:
     4750       define variable  parameter-2-48 as character no-undo .
     4751       define variable  parameter-3-48 as character no-undo .
     4752       define variable  parameter-4-48 as character no-undo .
     4753       define variable  parameter-5-48 as character no-undo .
     4754       define variable  parameter-6-48 as character no-undo .
     4755       define variable  parameter-7-48 as character no-undo .
     4756         assign
     4757         parameter-3-48 =
     4758                                 "FOR EACH Buf_matrix-goods"
     4759         parameter-4-48 =
     4760           (
     4761             if (" buf_matrix-goods.db-num = p-db-num  and buf_matrix-goods.asmt-id = p-id and buf_matrix-goods.asmg-status = p-sts " + " " + where-phrase-48) <> ""
     4762             then  substitute(' Buf_matrix-goods.db-num = &1 AND Buf_matrix-goods.asmt-id = &2 and buf_Matrix-goods.asmg-status = &3' , p-db-num , p-id , p-sts )  + " " + where-phrase-48
     4763             else "true"
     4764           )
     4765         parameter-5-48 = (" " + "" + " " + ", first Buf_goods NO-LOCK where Buf_matrix-goods.gds-code = Buf_goods.gds-code")
     4766         parameter-6-48 = if sort-phrase-48 = ''
     4767                              then
     4768           (
     4769           " " + "  " +
     4770             " " + sort-column-phrase +
     4771           " " + " "
     4772           )
     4773                              else
     4774           (
     4775           " " + "  " +
     4776             " " + sort-column-phrase +
     4777           " " + sort-phrase-48
     4778           )
     4779         parameter-7-48 =
     4780           "   "
     4781       .
     4782       do
     4783       on stop undo, leave
     4784       on error undo, leave
     4785       :
     4786         assign
     4787           l-disable-where-48 =
     4788             (" buf_matrix-goods.db-num = p-db-num  and buf_matrix-goods.asmt-id = p-id and buf_matrix-goods.asmg-status = p-sts " + " " + where-phrase-48 = "")
     4789         .
     4790         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4791                             ,input query BROWSE-am-goods:handle
     4792                             ,input parameter-3-48
     4793                             ,input parameter-4-48
     4794                             ,input parameter-5-48
     4795                             ,input parameter-6-48
     4796                             ,input parameter-7-48
     4797                             )
     4798         .
     4799         assign
     4800           l-filter-open-48 = true
     4801         .
     4802       end.
     4803       if l-filter-open-48 = false then do:
     4804         message
     4805           "Ошибка при фильтрации / сортировке" skip
     4806           "Будут показаны записи без учета фильтра" skip
     4807           view-as alert-box .
     4808       end.
     4809       else do:
     4810           assign
     4811             l-query-was-opened = true
     4812           .
     4813       end.
     4814     end.
     4815     if l-filter-open-48 = false then do:
     4816       OPEN QUERY BROWSE-am-goods FOR EACH Buf_matrix-goods no-lock
     4817         where  buf_matrix-goods.db-num = p-db-num  and buf_matrix-goods.asmt-id = p-id and buf_matrix-goods.asmg-status = p-sts
     4818       , first Buf_goods NO-LOCK where Buf_matrix-goods.gds-code = Buf_goods.gds-code
     4819     .
     4820         assign
     4821           l-query-was-opened = true
     4822         .
     4823     end.
     4824   end.
     4825   else do:
     4826     assign
     4827       doc-rec = recid( buf_matrix-goods )
     4828     .
     4829     do
     4830     on stop undo, leave
     4831     on error undo, leave
     4832     :
     4833       if query BROWSE-am-goods:handle:get-buffer-handle(1) = (buffer Buf_matrix-goods:handle) then do:
     4834         assign
     4835         parameter-2-48 = (if p-find-next then "true":u else "false":u )
     4836         parameter-4-48 =
     4837           "where ":u +  substitute(' Buf_matrix-goods.db-num = &1 AND Buf_matrix-goods.asmt-id = &2 and buf_Matrix-goods.asmg-status = &3' , p-db-num , p-id , p-sts )  + " ":u + where-phrase-48 + " ":u + p-find-condition + " " + ""
     4838         parameter-5-48 = "  "
     4839       .
     4840         run fltopend_fltfindd in this-procedure  (
     4841                             input this-procedure:handle
     4842                             ,input query BROWSE-am-goods:handle
     4843                             ,input rowid(buf_matrix-goods)
     4844                             ,input logical(parameter-2-48)
     4845                             ,input no-lock
     4846                             ,input (buffer buf_matrix-goods:handle)
     4847                             ,input parameter-4-48
     4848                             ,input parameter-5-48
     4849                             ) no-error.
     4850         .
     4851         assign
     4852           doc-rec = integer(return-value)
     4853           v-fltopend-rowid[1] = ?
     4854         .
     4855       end.
     4856       else do:
     4857         assign
     4858         parameter-2-48 = (if p-find-next then "true":u else "false":u )
     4859         parameter-3-48 =  "FOR EACH Buf_matrix-goods"
     4860         parameter-4-48 =
     4861           (
     4862             if (" buf_matrix-goods.db-num = p-db-num  and buf_matrix-goods.asmt-id = p-id and buf_matrix-goods.asmg-status = p-sts " + " " + where-phrase-48) <> ""
     4863             then  substitute(' Buf_matrix-goods.db-num = &1 AND Buf_matrix-goods.asmt-id = &2 and buf_Matrix-goods.asmg-status = &3' , p-db-num , p-id , p-sts )  + " " + where-phrase-48
     4864             else "true"
     4865           )
     4866         parameter-5-48 = (" " + "" + " " + ", first Buf_goods NO-LOCK where Buf_matrix-goods.gds-code = Buf_goods.gds-code" + " " + p-find-condition)
     4867         parameter-6-48 = if sort-phrase-48 = ''
     4868                              then
     4869           (
     4870           " " + "  " +
     4871             " " + sort-column-phrase +
     4872           " " + " "
     4873           )
     4874                              else
     4875           (
     4876           " " + "  " +
     4877             " " + sort-column-phrase +
     4878           " " + sort-phrase-48
     4879           )
     4880         parameter-7-48 =
     4881           "   "
     4882       .
     4883         run fltopend_fltfindq in this-procedure  (
     4884                             input this-procedure:handle
     4885                             ,input query BROWSE-am-goods:handle
     4886                             ,input logical(parameter-2-48)
     4887                             ,input no-lock
     4888                             ,input parameter-3-48
     4889                             ,input parameter-4-48
     4890                             ,input parameter-5-48
     4891                             ,input parameter-6-48
     4892                             ,input parameter-7-48
     4893                             ,output v-fltopend-rowid
     4894                             ) no-error.
     4895         .
     4896         doc-rec = ?.
     4897       end.
     4898       assign
     4899         l-query-was-opened = true
     4900       .
     4901     end.
     4902   end.
     4903     run waitfram-hide in this-procedure .
     4904   END.
     4905   APPLY "VALUE-CHANGED" TO BROWSE-am-goods in frame Dialog-Frame.
     4906   APPLY "ENTRY" TO BROWSE-am-goods.
     4907   RUN calc-itogi .
     4908   END PROCEDURE.
     4909   PROCEDURE proc-add :
     4910   define output parameter p-doc-rec as recid no-undo .
     4911   define variable v-host-code as integer   no-undo .
     4912   DEFINE VARIABLE dTmp-1 as DECIMAL NO-UNDO INITIAL 0.
     4913   DEFINE VARIABLE dTmp-2 as DECIMAL NO-UNDO INITIAL 0.
     4914   DEFINE VARIABLE dTmp-3 as DECIMAL NO-UNDO INITIAL 0.
     4915   DEFINE VARIABLE iCountGds as INTEGER    NO-UNDO INITIAL 0.
     4916   DEFINE VARIABLE cTmp      as CHARACTER  NO-UNDO INITIAL "".
     4917   DEFINE VARIABLE iDelta    as INTEGER    NO-UNDO INITIAL 0.
     4918   DEFINE VARIABLE cError    as CHARACTER  NO-UNDO INITIAL "".
     4919   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4920   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4921     (input  p-curr-obj-type
     4922     ,input  p-curr-obj-code
     4923     ,output v-host-code
     4924     )  .
     4925   for each tt-gds-list :
     4926      delete tt-gds-list.
     4927   end.
     4928   run str/chsgdsls.w
     4929   (   parParentProc ,
     4930       input "gds-matr" ,
     4931       input "Ассортиментная матрица " + buf_matrix.asmt-name  , ? , ? ,
     4932       input v-host-code,
     4933       input-output varschartic,
     4934       output ref-list,
     4935       output table tt-gds-list,
     4936       false )
     4937        no-error .
     4938        if error-status :error then do:
     4939        message
     4940           vss-workfile vss-revision vss-description skip
     4941           error-status :get-message(1) skip
     4942           return-value skip
     4943           view-as alert-box error
     4944           .
     4945        end.
     4946    v-longchar = "" .
     4947    v-err-ext = false .
     4948   DEFINE VARIABLE vss-include-info50 AS CHARACTER FORMAT "x(65)" NO-UNDO INITIAL "@(#)$Workfile$ $Revision$".
     4949   FOR EACH tt-gds-list NO-LOCK:
     4950       IF NOT CAN-FIND(FIRST ub.Assortment-matrix-goods WHERE
     4951                             ub.Assortment-matrix-goods.Asmt-id      = buf_matrix.Asmt-id
     4952                         AND ub.Assortment-matrix-goods.Db-num       = buf_matrix.db-num
     4953                         AND ub.Assortment-matrix-goods.gds-code     = tt-gds-list.gds-code
     4954                         AND ub.Assortment-matrix-goods.asmg-status  = INTEGER('0':U)
     4955                         NO-LOCK) THEN DO:
     4956          ASSIGN
     4957             iDelta = iDelta + 1.
     4958       END.
     4959   END.
     4960    RUN Cntrl-AM-Add-1 IN THIS-PROCEDURE(
     4961        iDelta,
     4962        OUTPUT cError
     4963        ).
     4964    if cError <> "" THEN DO:
     4965       RETURN ERROR cError.
     4966    END.
     4967    run waitfram-show in this-procedure ( "Добавление товаров в ассортиментную матрицу ... " ) .
     4968     for each tt-gds-list:
     4969   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat1 in g#lib-Matrix
     4970    (input this-procedure
     4971    ,input-output p-doc-rec
     4972    ,input 'ДОБАВЛЕНИЕ':U
     4973    ,input buf_matrix.asmt-id
     4974    ,input buf_matrix.db-num
     4975    ,input tt-gds-list.gds-code
     4976    ,input ''
     4977     ) no-error .
     4978          if error-status :error then do:
     4979             v-longchar = v-longchar + return-value  + chr(10).
     4980             v-err-ext  = true  .
     4981             next.
     4982          end.
     4983          run create-tt-gds in this-procedure  (tt-gds-list.gds-code, 0 ) .
     4984    end.
     4985   run waitfram-hide in this-procedure .
     4986   if v-err-ext = true  then do:
     4987   define variable v-ok as logical   no-undo .
     4988     run gbl/d-longchar.w (
     4989         ? ,
     4990           'Editor_row=2\':u
     4991         + 'title=При добавлении в Ассортиментные матрицы\':u
     4992         + 'Editor_col=1\':u
     4993         + 'Editor_width=96\':u
     4994         + 'Editor_height=21\':u
     4995         + 'readonly=yes\':u
     4996       ,input-output v-longchar
     4997       ,output v-ok ) no-error .
     4998   end.
     4999   END PROCEDURE.
     5000   PROCEDURE proc-b-del :
     5001   define input  parameter p-recid as character no-undo .
     5002   define input  parameter p-model as logical   no-undo .
     5003   define variable loc#log as logical no-undo.
     5004   define variable v-log as logical   no-undo .
     5005   define variable v-sts like ub.assortment-matrix-goods.asmg-status no-undo .
     5006   define variable loc-doc-rec as recid no-undo.
     5007   define variable i as integer   no-undo .
     5008   do
     5009   on error undo, return error
     5010   on stop undo, return error
     5011   :
     5012   v-err-ext  = false   .
     5013   define variable vss-include-info51 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5014   do:
     5015     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5016       (input  v-cntxt-db-num
     5017       ,input  v-cntxt-userid
     5018       ,input  0
     5019       ,input  'actn_assort-matr-gds_deletion':U
     5020       ,input  'global':U
     5021       ,input  0
     5022       ,input  '':U
     5023       ,input  0
     5024       ,input  0
     5025       ,input  0
     5026       ,input  0
     5027       ,input  true
     5028       ,output v-log
     5029       )  .
     5030   end.
     5031    if not v-log then return no-apply .
     5032     assign
     5033     v-sts = ?
     5034     loc-doc-rec = RECID(buf_Matrix-goods)
     5035     .
     5036     if p-model = false then do:
     5037   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat2 in g#lib-Matrix
     5038    (input this-procedure
     5039    ,input recid(buf_Matrix-goods)
     5040    ,input-output v-sts
     5041    ,input true
     5042     ) no-error .
     5043       if error-status:error then do:
     5044          message return-value
     5045          view-as alert-box information .
     5046          undo, return error.
     5047       end.
     5048       run create-tt-gds in this-procedure  (buf_Matrix-goods.gds-code, 1 ) .
     5049       if return-value <> "" then message  substitute("&1 &2" ,buf_Matrix-goods.gds-code, return-value  ) view-as alert-box information .
     5050     end.
     5051     else do:
     5052         v-longchar = "".
     5053         v-err-ext  = false   .
     5054         repeat i = 1 to num-entries(p-recid) :
     5055         find first buf_Matrix-goods no-lock where
     5056              recid(buf_Matrix-goods) = integer(entry(i,p-recid )) no-error .
     5057           if buf_Matrix-goods.asmg-status = 0 then do:
     5058   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat2 in g#lib-Matrix
     5059    (input this-procedure
     5060    ,input entry(i,p-recid)
     5061    ,input-output v-sts
     5062    ,input false
     5063     ) no-error .
     5064                  if error-status :error then do:
     5065                     v-longchar = v-longchar + return-value  + chr(10).
     5066                     v-err-ext  = true  .
     5067                  end.
     5068                  if not error-status :error then do:
     5069                     run create-tt-gds in this-procedure  (buf_Matrix-goods.gds-code, 1 ) .
     5070                     if return-value <> "" then do:
     5071                         v-longchar = v-longchar + substitute("&1 &2&3" ,buf_Matrix-goods.gds-code, return-value ,chr(10)) .
     5072                         v-err-ext  = true  .
     5073                     end.
     5074                  end.
     5075           end.
     5076         end.
     5077       assign
     5078         p-recid = ""
     5079         p-rid-list = ""
     5080       .
     5081       if v-err-ext = true  then do:
     5082       define variable v-ok as logical   no-undo .
     5083         run gbl/d-longchar.w (
     5084               ?,
     5085               'Editor_row=2\':u
     5086             + 'title=При корректировке в Ассортиментные матрицы\':u
     5087             + 'Editor_col=1\':u
     5088             + 'Editor_width=96\':u
     5089             + 'Editor_height=21\':u
     5090             + 'readonly=yes\':u
     5091           ,input-output v-longchar
     5092           ,output v-ok ) no-error .
     5093       end.
     5094     end.
     5095     run openbr in this-procedure .
     5096     REPOSITION BROWSE-am-goods to recid loc-doc-rec No-error.
     5097     if error-status:error then do:                           find first pos_assortment-matrix no-lock where                                   recid(pos_assortment-matrix) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи AM" skip                            string(if avail pos_assortment-matrix                                     then  substitute("Вн код AM: &1"                                                     , pos_assortment-matrix.asmt-id)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     5098     if available buf_Matrix-goods then do:
     5099       loc#log = BROWSE-am-goods:select-focused-row( ) IN FRAME Dialog-Frame.
     5100       loc#log = BROWSE-am-goods:refresh() .
     5101     end.
     5102     RUN calc-itogi IN THIS-PROCEDURE.
     5103     apply "ENTRY" to BROWSE-am-goods.
     5104   end.
     5105   END PROCEDURE.
     5106   PROCEDURE proc-b-izt :
     5107   define input  parameter p-recid as character no-undo .
     5108     do
     5109     on error undo, return error return-value
     5110     :
     5111     define variable i as integer   no-undo .
     5112     define variable v-old as character no-undo .
     5113     define variable v-new as character no-undo .
     5114        empty temp-table gds-list.
     5115        empty temp-table obj-list.
     5116         repeat i = 1 to num-entries(p-recid) :
     5117           find first buf_Matrix-goods no-lock where
     5118                 recid(buf_Matrix-goods) = integer(entry(i,p-recid)) no-error .
     5119           find first buf_goods no-lock where
     5120                      buf_goods.gds-code = buf_Matrix-goods.gds-code.
     5121                 create gds-list.
     5122                 buffer-copy buf_goods to gds-list.
     5123         end.
     5124     run create_obj-list ( buf_matrix.obj-type , buf_matrix.obj-code ) .
     5125     run ref/graf-igt.w ( output v-old, output v-new ) .
     5126         if not ( v-old = "" and v-new = "" )  then do:
     5127             run ref/chg-igt.p
     5128               ( input v-old, input v-new , input true ) no-error  .
     5129                 if error-status :error then
     5130                 message
     5131                   vss-workfile vss-revision vss-description skip
     5132                   error-status :get-message(1) skip
     5133                   return-value skip
     5134                   ""
     5135                   view-as alert-box error
     5136                 .
     5137         end.
     5138     end.
     5139   END PROCEDURE.
     5140   PROCEDURE proc-b-print :
     5141   define variable v-doc-rec as recid no-undo .
     5142   define variable accum-count as integer.
     5143   define variable date_string     as      character    no-undo.
     5144   define variable Line            as      character    no-undo.
     5145   define variable v-time-cr as character no-undo .
     5146   define variable v-time-up as character no-undo .
     5147   define variable v-st      as character no-undo .
     5148   DEFINE FRAME buf_Matrix-list
     5149         Buf_goods.artic FORMAT "X(16)":U
     5150         Buf_goods.gds-name FORMAT "X(30)":U
     5151         Buf_matrix-goods.asmg-who-update COLUMN-LABEL "Кто!изменил" FORMAT "X(8)":U
     5152         Buf_matrix-goods.asmg-date-update COLUMN-LABEL "Дата!изменения" FORMAT "99/99/99":U
     5153         p-time-upd COLUMN-LABEL "Время" FORMAT "x(5)":U
     5154         Buf_matrix-goods.asmg-db-num-update COLUMN-LABEL "БД!изм" FORMAT ">>>>9":U
     5155         Buf_matrix-goods.asmg-date-create COLUMN-LABEL "Дата!создания" FORMAT "99/99/99":U
     5156         p-time-cr COLUMN-LABEL "Время" FORMAT "x(5)":U
     5157         Buf_matrix-goods.asmg-who-create COLUMN-LABEL "Кто!создал" FORMAT "X(8)":U
     5158         Buf_matrix-goods.asmg-db-num-create COLUMN-LABEL "БД!соз" FORMAT ">>>>9":U
     5159         p-status COLUMN-LABEL "Статус" FORMAT "x(6)":U
     5160         v-indicator-life-gds COLUMN-LABEL "ИЖТ" FORMAT "x(20)":U
     5161         v-assort-min         column-label "AMin" format "*/ "
     5162   HEADER  date_string AT 5 format "X(35)"
     5163    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5164   Line format "X(195)" AT 1
     5165   with width 232 down stream-io use-text    .
     5166   Line = fill("-", 195).
     5167   date_string = cur-time-print() .
     5168   run prn-lib-open-stream  in this-procedure (
     5169                                                input parParentProc
     5170                                               ,input 43
     5171                                               ,input yes
     5172                                               ,input no
     5173                                               ).
     5174   PUT  STREAM PrnLibStream
     5175   SPACE(25) ( frame Dialog-Frame:title )
     5176   format "x(90)" SKIP(1) .
     5177   FORM HEADER
     5178   Line format "X(195)" AT 1 SKIP
     5179   "Продолжение - на следующей странице" AT 30 SKIP
     5180   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5181   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5182   FORM with FRAME buf_Matrix-list  .
     5183   run waitfram-show in this-procedure ("Ждите...").
     5184   v-doc-rec = recid(buf_Matrix-goods).
     5185   DO WHILE available buf_Matrix-goods :
     5186     GET prev BROWSE-am-goods.
     5187   END.
     5188   GET next BROWSE-am-goods.
     5189   DO WHILE available buf_Matrix-goods :
     5190   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5191   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     5192     (input  buf_matrix.obj-type
     5193     ,input  buf_matrix.obj-code
     5194     ,input  ?
     5195     ,input  ?
     5196     ,input  ?
     5197     ,input  buf_Matrix-goods.gds-code
     5198     ,output v-assort-min
     5199     ,output v-indicator-life-gds
     5200     ,output v-gdop-min-stock
     5201     ,output v-grop-max-stock
     5202     ,output v-grop-level-always-presence
     5203     ,output v-grop-min-order
     5204     )  .
     5205     Display STREAM PrnLibStream
     5206       STRING (buf_Matrix-goods.asmg-time-create,'HH:MM') @ p-time-cr
     5207       STRING (buf_Matrix-goods.asmg-time-update,'HH:MM') @ p-time-upd
     5208              entry (lookup (STRING(p-sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) @ p-status
     5209               Buf_goods.artic
     5210               Buf_goods.gds-name
     5211               Buf_matrix-goods.asmg-who-update
     5212               Buf_matrix-goods.asmg-date-update
     5213               Buf_matrix-goods.asmg-db-num-update
     5214               Buf_matrix-goods.asmg-date-create
     5215               Buf_matrix-goods.asmg-who-create
     5216               Buf_matrix-goods.asmg-db-num-create
     5217               v-indicator-life-gds
     5218               v-assort-min
     5219    with FRAME buf_Matrix-list .
     5220     DOWN STREAM PrnLibStream 1
     5221     with FRAME buf_Matrix-list  .
     5222     assign
     5223     accum-count = accum-count + 1
     5224     .
     5225     GET next BROWSE-am-goods.
     5226   END.
     5227   UNDERLINE  STREAM PrnLibStream
     5228       p-time-cr
     5229       p-time-upd
     5230       p-status
     5231       Buf_goods.artic
     5232       Buf_goods.gds-name
     5233       Buf_matrix-goods.asmg-who-update
     5234       Buf_matrix-goods.asmg-date-update
     5235       Buf_matrix-goods.asmg-db-num-update
     5236       Buf_matrix-goods.asmg-date-create
     5237       Buf_matrix-goods.asmg-who-create
     5238       Buf_matrix-goods.asmg-db-num-create
     5239       v-indicator-life-gds
     5240       v-assort-min
     5241   with FRAME buf_Matrix-list .
     5242   DISPLAY STREAM PrnLibStream
     5243   "ИТОГО"     @ Buf_goods.artic
     5244   accum-count @ Buf_goods.gds-name
     5245   with frame buf_Matrix-list.
     5246   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5247   HIDE  STREAM PrnLibStream FRAME buf_Matrix-List.
     5248   output  STREAM PrnLibStream CLOSE.
     5249   REPOSITION BROWSE-am-goods to recid v-doc-rec no-error.
     5250   APPLY "entry" to BROWSE-am-goods.
     5251   run waitfram-hide in this-procedure .
     5252   run prn-lib-prn-file in this-procedure (
     5253                                             input parParentProc
     5254                                             ,input 8
     5255                                             ).
     5256   END PROCEDURE.
     5257   PROCEDURE proc-br :
     5258   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5259   if b-sel:sensitive in frame Dialog-Frame then dO:
     5260       if b-mark:sensitive then do:
     5261           apply "choose" to b-mark in frame Dialog-Frame.
     5262       end.
     5263       else do:
     5264           apply "choose" to b-sel in frame Dialog-Frame.
     5265       end.
     5266   end.
     5267   else do:
     5268       if b-lookup:sensitive then
     5269       apply "choose" to b-lookup in frame Dialog-Frame.
     5270   end.
     5271   END PROCEDURE.
     5272   PROCEDURE proc-copy :
     5273   define output parameter p-doc-rec as recid no-undo .
     5274   define variable  v-rid-list as character no-undo .
     5275   define buffer bb_assortment-matrix for assortment-matrix.
     5276   define buffer bb_assortment-matrix-goods for ub.assortment-matrix-goods.
     5277   define variable v-calc0    as integer   no-undo init 1 .
     5278   define variable v-calc     as integer   no-undo init 0 .
     5279   define variable v-calc-err as integer   no-undo init 0 .
     5280   DEFINE VARIABLE iDelta     as INTEGER   NO-UNDO INITIAL 0.
     5281   DEFINE VARIABLE cError     as CHARACTER NO-UNDO INITIAL "".
     5282    v-longchar = "" .
     5283    v-err-ext = false .
     5284   run ref/assmatr.w ( input parParentProc , input 'b-sel', p-curr-obj-type , p-curr-obj-code , ? ,  ?, input-output  v-rid-list ).
     5285   if v-rid-list <> "" then do:
     5286      find first bb_assortment-matrix no-lock where recid(bb_assortment-matrix) = int(v-rid-list) no-error .
     5287      if available bb_assortment-matrix then do:
     5288         RUN Get-Delta-Gds-2-Matrix in THIS-PROCEDURE(
     5289             BUFFER bb_assortment-matrix,
     5290             BUFFER buf_matrix,
     5291             OUTPUT iDelta
     5292             ).
     5293         RUN Cntrl-AM-Add-1 IN THIS-PROCEDURE(
     5294             iDelta,
     5295             OUTPUT cError
     5296             ).
     5297         IF cError <> "" THEN DO:
     5298            RETURN ERROR cError.
     5299         END.
     5300         for each  bb_assortment-matrix-goods no-lock where
     5301                   bb_assortment-matrix-goods.asmg-status  = 0 and
     5302                   bb_assortment-matrix-goods.db-num = bb_assortment-matrix.db-num and
     5303                   bb_assortment-matrix-goods.asmt-id = bb_assortment-matrix.asmt-id :
     5304                   run waitfram-show in this-procedure  ("Копирование из ассортиментной матрицы " + bb_assortment-matrix.asmt-name + " " + string(v-calc0) ) .
     5305   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat1 in g#lib-Matrix
     5306    (input this-procedure
     5307    ,input-output p-doc-rec
     5308    ,input 'ДОБАВЛЕНИЕ':U
     5309    ,input buf_matrix.asmt-id
     5310    ,input buf_matrix.db-num
     5311    ,input bb_assortment-matrix-goods.gds-code
     5312    ,input bb_assortment-matrix-goods.asmg-des
     5313     ) no-error .
     5314                   if not error-status :error  then do:
     5315                      v-calc = v-calc + 1 .
     5316                      run create-tt-gds in this-procedure  (bb_assortment-matrix-goods.gds-code, 0 ) .
     5317                   end.
     5318                   else do:
     5319                     v-longchar = v-longchar + return-value  + chr(10).
     5320                     v-err-ext  = true  .
     5321                     v-calc-err = v-calc-err + 1 .
     5322                   end.
     5323                   v-calc0 = v-calc0 + 1 .
     5324         end.
     5325         run waitfram-hide in this-procedure .
     5326         message
     5327         "Скопировано" v-calc "товаров" skip
     5328         "Ошибок"      v-calc-err       skip
     5329         view-as alert-box information .
     5330         if v-err-ext = true  then do:
     5331         define variable v-ok as logical   no-undo .
     5332           run gbl/d-longchar.w (
     5333               ? ,
     5334                 'Editor_row=2\':u
     5335               + 'title=При добавлении в Ассортиментные матрицы\':u
     5336               + 'Editor_col=1\':u
     5337               + 'Editor_width=96\':u
     5338               + 'Editor_height=21\':u
     5339               + 'readonly=yes\':u
     5340             ,input-output v-longchar
     5341             ,output v-ok ) no-error .
     5342         end.
     5343      end.
     5344   end.
     5345   END PROCEDURE.
     5346   PROCEDURE proc-find-artic :
     5347   define input parameter par-next as logical no-undo.
     5348   define input parameter pardoc-code as character no-undo.
     5349   define buffer buff_matrix-goods for ub.assortment-matrix-goods.
     5350   define variable doc-rec as recid no-undo.
     5351     doc-rec = ? .
     5352     find first  Buff_matrix-goods no-lock where
     5353                 Buff_matrix-goods.db-num   = p-db-num
     5354             AND Buff_matrix-goods.asmt-id  = p-id
     5355             and can-find(first  buf_goods no-lock where
     5356                                 buf_goods.gds-code =  Buff_matrix-goods.gds-code and
     5357                                 buf_goods.artic begins pardoc-code
     5358                                 )
     5359             no-error  .
     5360     if available Buff_matrix-goods then
     5361     doc-rec = recid (Buff_matrix-goods) .
     5362     reposition BROWSE-am-goods to recid doc-rec no-error .
     5363     if not error-status :error then do:
     5364        apply "VALUE-CHANGED" to  BROWSE-am-goods  in frame Dialog-Frame.
     5365     end.
     5366     else do:
     5367          message " Запись не найдена " view-as alert-box information .
     5368     end.
     5369   END PROCEDURE.
     5370   PROCEDURE proc-find-code :
     5371   define input parameter par-next as logical no-undo.
     5372   define input parameter pardoc-code as INTEGER no-undo.
     5373   define buffer buff_matrix-goods for ub.assortment-matrix-goods.
     5374   define variable doc-rec as recid no-undo.
     5375     doc-rec = ? .
     5376     find first  Buff_matrix-goods no-lock where
     5377                 Buff_matrix-goods.gds-code = pardoc-code
     5378             AND Buff_matrix-goods.db-num   = p-db-num
     5379             AND Buff_matrix-goods.asmt-id  = p-id
     5380             no-error  .
     5381     if available Buff_matrix-goods then
     5382     doc-rec = recid (Buff_matrix-goods) .
     5383     reposition BROWSE-am-goods to recid doc-rec no-error .
     5384     if not error-status :error then do:
     5385        apply "VALUE-CHANGED" to  BROWSE-am-goods  in frame Dialog-Frame.
     5386     end.
     5387     else do:
     5388          message " Запись не найдена " view-as alert-box information .
     5389     end.
     5390   END PROCEDURE.
     5391   PROCEDURE proc-find-name :
     5392   define input parameter par-next as logical no-undo.
     5393   define input parameter par-name as character no-undo .
     5394   define buffer buff_matrix-goods for ub.assortment-matrix-goods.
     5395   define buffer buff_goods for ub.goods.
     5396   define variable doc-rec as recid no-undo.
     5397     doc-rec = ? .
     5398         for each  buff_matrix-goods no-lock where
     5399                   buff_matrix-goods.db-num   = p-db-num and
     5400                   buff_matrix-goods.asmt-id  = p-id ,
     5401             first buff_goods no-lock where
     5402                   buff_goods.gds-code = buff_matrix-goods.gds-code and
     5403                   buff_goods.gds-name begins par-name
     5404                   :
     5405                   doc-rec = recid (Buff_matrix-goods) .
     5406                   leave.
     5407         end.
     5408     reposition BROWSE-am-goods to recid doc-rec no-error .
     5409     if not error-status :error then do:
     5410        apply "VALUE-CHANGED" to  BROWSE-am-goods  in frame Dialog-Frame.
     5411     end.
     5412     else do:
     5413          message " Запись не найдена " view-as alert-box information .
     5414     end.
     5415   END PROCEDURE.
     5416   PROCEDURE set-filter-name :
     5417   define input parameter p-filter-name as character no-undo .
     5418     do with frame Dialog-Frame:
     5419       if p-filter-name > "" then do:
     5420         assign
     5421           frame Dialog-Frame:title
     5422             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     5423         .
     5424         assign
     5425           b-sch :TOOLTIP = "Установлен фильтр " + p-filter-name
     5426         .
     5427       end.
     5428       else do:
     5429         assign
     5430           b-sch :TOOLTIP = ""
     5431         .
     5432       end.
     5433     end.
     5434   END PROCEDURE.
     5435   PROCEDURE ver-db :
     5436   if v-cntxt-db-num <> 0 then do:
     5437       if  buf_matrix.asmt-type = 'Шаблон':U  then do:
     5438           if v-cntxt-db-num <> buf_matrix.asmt-db-num-create then do:
     5439             message
     5440               "Нельзя редактировать ШАБЛОН Ассортиментная матрица созданный в чужой УБД"
     5441               view-as alert-box error.
     5442               return  error.
     5443           end.
     5444       end.
     5445       else do:
     5446           define variable obj-db-num as integer   no-undo .
     5447   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5448   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     5449     (input  buf_matrix.obj-type
     5450     ,input  buf_matrix.obj-code
     5451     ,output obj-db-num
     5452     )  .
     5453           if v-cntxt-db-num <> 0 and  v-cntxt-db-num <> obj-db-num  then do:
     5454             message
     5455               "Нельзя редактировать запись Ассортиментная матрица чужой УБД"
     5456               view-as alert-box error.
     5457               return  error.
     5458           end.
     5459       end.
     5460   end.
     5461   END PROCEDURE.
