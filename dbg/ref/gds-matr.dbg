     2054        SIZE 10 BY 1.
     2055   DEFINE VARIABLE ED_asmg-des AS CHARACTER
     2056        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     2057        SIZE 72 BY 2 NO-UNDO.
     2058   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Статус:"
     2059         VIEW-AS TEXT
     2060        SIZE 7.5 BY 1
     2061        FGCOLOR 4  NO-UNDO.
     2062   DEFINE VARIABLE FILL-IN-7 AS CHARACTER FORMAT "X(256)":U INITIAL "Поиск:"
     2063         VIEW-AS TEXT
     2064        SIZE 6 BY 1
     2065        FGCOLOR 4  NO-UNDO.
     2066   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     2067         VIEW-AS TEXT
     2068        SIZE 2.5 BY 1
     2069        FGCOLOR 4  NO-UNDO.
     2070   DEFINE VARIABLE sch-artic AS CHARACTER FORMAT "X(256)":U
     2071        VIEW-AS FILL-IN
     2072        SIZE 14 BY 1 TOOLTIP "Поиск по артиклу" NO-UNDO.
     2073   DEFINE VARIABLE sch-code AS INTEGER FORMAT ">>>>>>>>>>>>9":U INITIAL 0
     2074        VIEW-AS FILL-IN
     2075        SIZE 10.5 BY 1 TOOLTIP "Поиск по коду" NO-UNDO.
     2076   DEFINE VARIABLE sch-name AS CHARACTER FORMAT "X(256)":U
     2077        VIEW-AS FILL-IN
     2078        SIZE 37.5 BY 1 TOOLTIP "Поиск по началу Наименования" NO-UNDO.
     2079   DEFINE VARIABLE v-kol-all AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 0
     2080        LABEL "Всего в АМ"
     2081         VIEW-AS TEXT
     2082        SIZE 10 BY .67 TOOLTIP "Общее количество товаров в матрице(SCU) в статусе ТЕК" NO-UNDO.
     2083   DEFINE VARIABLE v-kol-del AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 0
     2084        LABEL "На вывод"
     2085         VIEW-AS TEXT
     2086        SIZE 10 BY .67 TOOLTIP "Количество товаров в матрице(SCU) с ИЖТ на вывод из ассортимента в статусе ТЕК"
     2087        FGCOLOR 4  NO-UNDO.
     2088   DEFINE VARIABLE v-kol-in-shabl AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 0
     2089        LABEL "в шаблоне"
     2090         VIEW-AS TEXT
     2091        SIZE 10 BY .67 TOOLTIP "Общее количество товаров в матрице(SCU) в статусе ТЕК" NO-UNDO.
     2092   DEFINE VARIABLE v-proc-otkl AS DECIMAL FORMAT "->>,>>9.99":U INITIAL 0
