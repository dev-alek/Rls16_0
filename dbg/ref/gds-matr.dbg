     1360   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1361   procedure correct-message :
     1362   define input  parameter p-longchar as longchar no-undo .
     1363   define variable v-longchar as longchar no-undo .
     1364   define variable v-err-ext  as logical  no-undo .
     1365     do
     1366     on error undo, return error return-value
     1367     :
     1368      run get-long-message in this-procedure  (output v-longchar ).
     1369       v-longchar = v-longchar + p-longchar.
     1370       v-err-ext  = true .
     1371       run set-long-message  in this-procedure  (input v-longchar,  input v-err-ext ).
     1372     end.
     1373   end procedure.
     1374   define variable v-longchar as longchar no-undo .
     1375   define variable v-err-ext as logical   no-undo .
     1376   procedure get-long-message  :
     1377   define output parameter p-longchar  as longchar no-undo .
     1378     do
     1379     on error undo, return error return-value
     1380     :
     1381        p-longchar = v-longchar .
     1382     end.
     1383   end procedure.
     1384   procedure set-long-message :
     1385   define input  parameter  p-longchar as longchar   no-undo .
     1386   define input  parameter  p-err-ext as logical   no-undo .
     1387     do
     1388     on error undo, return error return-value
     1389     :
     1390       v-longchar  =  p-longchar .
     1391       v-err-ext   =  p-err-ext  .
     1392     end.
     1393   end procedure.
     1394   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1395   define new global shared variable g#attr-lib  as handle no-undo .
     1396   define variable v-attr-lib-variable as handle no-undo .
     1397   procedure assmatat-code :
     1398     define input  parameter p-code           as character no-undo .
     1399     define output parameter p-type           as character no-undo .
     1400     define output parameter p-format         as character no-undo .
     1401     define output parameter p-label          as character no-undo .
     1402     define output parameter p-user-can-edit  as logical   no-undo .
     1403     define output parameter p-output-display as logical   no-undo .
     1404     define output parameter p-other          as character no-undo .
     1405     do
     1406     on error undo, return error
     1407     :
     1408           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run assmatat-code in g#attr-lib
     1409         (input  p-code
     1410         ,output p-type
     1411         ,output p-format
     1412         ,output p-label
     1413         ,output p-user-can-edit
     1414         ,output p-output-display
     1415         ,output p-other
     1416         ) no-error .
     1417       if error-status :error
     1418       then do:
     1419         undo, return error return-value .
     1420       end.
     1421     end.
     1422   end procedure.
     1423   procedure assmatat-tooltip :
