     1953   FUNCTION f-shablon RETURNS logical
     1954   ( input p-rec as recid ) :
     1955   define buffer buf_matrix-goods for ub.assortment-matrix-goods .
     1956   define buffer sh_assortment-matrix-goods for ub.assortment-matrix-goods  .
     1957   find first buf_matrix-goods no-lock where recid (buf_matrix-goods) = p-rec no-error .
     1958   if error-status :error then return no .
     1959     if is-objLink = true  then do:
     1960         find first sh_assortment-matrix-goods no-lock where
     1961                    sh_assortment-matrix-goods.asmt-id = is-objLink-id and
     1962                    sh_assortment-matrix-goods.db-num  = is-objLink-db and
     1963                    sh_assortment-matrix-goods.asmg-status  = 0          and
     1964                    sh_assortment-matrix-goods.gds-code   =  buf_matrix-goods.gds-code no-error .
     1965           if available sh_assortment-matrix-goods then return true .
     1966           else return false .
     1967     end.
     1968     else do:
     1969       return true .
     1970     end.
     1971   end function.
