     2578   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     2579   DO:
     2580     define variable loc#log as logical no-undo .
     2581     if AVAILABLE Buf_matrix-goods  then do:
     2582   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2583   define variable v-str-recid28 as character no-undo .
     2584   define variable v-num-entry28 as integer   no-undo .
     2585   assign
     2586     v-str-recid28 = trim( string( recid( Buf_matrix-goods ) , "->>>>>>>>>>>9":U ) )
     2587     v-num-entry28 = lookup( v-str-recid28 , p-rid-list )
     2588   .
     2589   if v-num-entry28 > 0 then do:
     2590     assign
     2591       entry( v-num-entry28, p-rid-list ) = "":U
     2592       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2593     .
     2594   end.
     2595   else do:
     2596     assign
     2597       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid28
     2598     .
     2599   end.
     2600       loc#log = BROWSE-am-goods:refresh() .
     2601       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     2602           loc#log = BROWSE-am-goods:select-next-row ().
     2603           apply "VALUE-CHANGED" to BROWSE-am-goods in frame Dialog-Frame.
     2604       end.
     2605       if num-entries( p-rid-list ) = 0
     2606       then
     2607           hide mark-num in frame Dialog-Frame.
     2608       else
     2609           disp num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
     2610     end.
     2611     apply "entry" to BROWSE-am-goods in frame Dialog-Frame.
     2612   END.
