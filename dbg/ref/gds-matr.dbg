     1571   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1572   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1573   DEFINE VARIABLE vss-include-info19 AS CHARACTER FORMAT "x(65)" NO-UNDO INITIAL "@(#)$Workfile$ $Revision$".
     1574   FUNCTION indicator-life-gds-n RETURNS CHARACTER ( input p-rec as recid ) FORWARD.
     1575   DEFINE VARIABLE v-gl-iProc-Otkl AS DECIMAL NO-UNDO INITIAL 0.
     1576   DEFINE VARIABLE v-gl-lAM-Is-Obj         AS LOGICAL NO-UNDO INITIAL FALSE.
     1577   DEFINE VARIABLE v-gl-iAM-Gds-All        AS INTEGER NO-UNDO INITIAL 0.
     1578   DEFINE VARIABLE v-gl-iAM-Sbl-Gds-All    AS INTEGER NO-UNDO INITIAL 0.
     1579   DEFINE VARIABLE v-gl-iAM-Gds-Vyv        AS INTEGER NO-UNDO INITIAL 0.
     1580   DEFINE VARIABLE v-gl-lAM-Ref-Shablon    AS LOGICAL NO-UNDO INITIAL FALSE.
     1581   DEFINE VARIABLE v-gl-dAM-Proc-Otkl      AS DECIMAL NO-UNDO INITIAL 0.
     1582   DEFINE VARIABLE v-gl-dAM-Proc-Otkl-Ras  AS DECIMAL NO-UNDO INITIAL 0.
     1583   FUNCTION Is-Gds-In-AssMatr RETURN LOGICAL(
     1584      p-Gds-code AS INTEGER,
     1585      p-Asmt-id  AS INTEGER,
     1586      p-Db-num   AS INTEGER):
     1587      DEFINE BUFFER buf_Gds FOR Ub.Assortment-matrix-goods.
     1588      RETURN CAN-FIND(FIRST buf_Gds WHERE
     1589                            buf_Gds.Asmt-id     = p-Asmt-id
     1590                        AND buf_Gds.Db-num      = p-Db-num
     1591                        AND buf_Gds.Gds-code    = p-Gds-code
     1592                        AND buf_Gds.Asmg-status = INTEGER('0':U)
     1593                      NO-LOCK).
     1594   END FUNCTION.
     1595   PROCEDURE Get-Delta-Gds-2-Matrix:
     1596      DEFINE PARAMETER BUFFER buf_AM-1 FOR ub.Assortment-matrix.
     1597      DEFINE PARAMETER BUFFER buf_AM-2 FOR ub.Assortment-matrix.
     1598      DEFINE OUTPUT PARAMETER iDelta AS INTEGER NO-UNDO INITIAL 0.
     1599      DEFINE BUFFER buf_Gds-1 FOR ub.Assortment-matrix-goods.
     1600      DEFINE BUFFER buf_Gds-2 FOR ub.Assortment-matrix-goods.
     1601      FOR EACH buf_Gds-1 WHERE
     1602               buf_Gds-1.Asmt-id = buf_AM-1.Asmt-id
     1603           AND buf_Gds-1.Db-num  = buf_AM-1.Db-num
     1604           AND buf_Gds-1.Asmg-status = INTEGER('0':U)
     1605          NO-LOCK:
     1606          IF NOT CAN-FIND(FIRST buf_Gds-2 WHERE
     1607                                buf_Gds-2.Asmt-id     = buf_AM-2.Asmt-id
     1608                            AND buf_Gds-2.Db-num      = buf_AM-2.Db-num
     1609                            AND buf_Gds-2.Gds-code    = buf_Gds-1.Gds-code
     1610                            AND buf_Gds-2.Asmg-status = INTEGER('0':U)
     1611                            NO-LOCK) THEN DO:
     1612             ASSIGN
     1613                iDelta = iDelta + 1.
     1614          END.
     1615      END.
     1616      RETURN.
     1617   END PROCEDURE.
     1618   PROCEDURE Cntrl-AM-Add-1:
     1619      DEFINE INPUT PARAMETER iDelta  AS INTEGER   NO-UNDO.
     1620      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1621      IF v-gl-iProc-Otkl = 0      THEN RETURN.
     1622      IF NOT v-gl-lAM-Is-Obj      THEN RETURN.
     1623      IF NOT v-gl-lAM-Ref-Shablon THEN RETURN.
     1624      RUN Calc-Proc-Otkl IN THIS-PROCEDURE(iDelta).
     1625      IF iDelta = 0 THEN DO:
     1626         IF v-gl-dAM-Proc-Otkl >= v-gl-iProc-Otkl THEN DO:
     1627            cError = "В данной матрице процент отклонения товаров от шаблона (=" + STRING(v-gl-dAM-Proc-Otkl) + ")" + chr(10) +
     1628                     " больше допустимого (=" + STRING( v-gl-iProc-Otkl) +  ")." + chr(10) +
     1629                     "Добавление товаров невозможно !".
     1630         END.
     1631      END. ELSE DO:
     1632         IF v-gl-dAM-Proc-Otkl-Ras >= v-gl-iProc-Otkl THEN DO:
     1633            cError = "В данной матрице будущий расчетный процент отклонения товаров от шаблона (=" + STRING(v-gl-dAM-Proc-Otkl-Ras) + ")" + chr(10) +
     1634                     " больше допустимого (=" + STRING( v-gl-iProc-Otkl ) +  ")." + chr(10) +
     1635                     " Добавление товаров невозможно !".
     1636         END.
     1637      END.
     1638      RETURN.
     1639   END PROCEDURE.
     1640   PROCEDURE Get-Gl-Param-Proc-Otkl:
     1641      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     1642      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     1643      DEFINE OUTPUT PARAMETER  cError    AS CHARACTER  NO-UNDO INITIAL "".
     1644      DEFINE BUFFER buf_AM   FOR ub.Assortment-Matrix.
     1645      FIND FIRST buf_AM WHERE
     1646                 buf_AM.asmt-id = p-Asmt-id
     1647             AND buf_AM.db-num  = p-Db-num
     1648           NO-LOCK NO-ERROR.
     1649      IF NOT AVAILABLE buf_AM THEN DO:
     1650         cError = PROGRAM-NAME(1) +  ":Не найдена АМ id=" + STRING(p-Asmt-id) + " db-num=" + STRING(p-Db-num).
     1651         RETURN.
     1652      END.
     1653      RUN Get-Gl-Set-Proc-Otkl IN THIS-PROCEDURE(
     1654          buf_AM.obj-type,
     1655          buf_AM.obj-code
     1656          ).
     1657      RUN Get-Gl-Param-AM-All in THIS-PROCEDURE(
     1658          buf_AM.Asmt-id,
     1659          buf_AM.db-num
     1660          ).
     1661      RETURN.
     1662   END PROCEDURE.
     1663   PROCEDURE Get-Gl-Param-AM-All:
     1664      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     1665      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     1666      DEFINE VARIABLE lIsAmObj    AS LOGICAL    NO-UNDO INITIAL FALSE.
     1667      DEFINE VARIABLE iSh-Asmt-id AS INTEGER    NO-UNDO INITIAL 0.
     1668      DEFINE VARIABLE iSh-Db-num  AS INTEGER    NO-UNDO INITIAL 0.
     1669      DEFINE VARIABLE cSh-Type    AS CHARACTER  NO-UNDO INITIAL "".
     1670      DEFINE VARIABLE cError      AS CHARACTER  NO-UNDO INITIAL "".
     1671      DEFINE VARIABLE dAmt        AS DECIMAL    EXTENT 2  NO-UNDO INITIAL 0.
     1672      DEFINE VARIABLE cMode       AS CHARACTER  NO-UNDO INITIAL "".
     1673      ASSIGN
     1674         v-gl-iAM-Gds-All     = 0
     1675         v-gl-iAM-Sbl-Gds-All = 0
     1676         v-gl-iAM-Gds-Vyv     = 0
     1677         v-gl-dAM-Proc-Otkl   = 0
     1678         v-gl-lAM-Ref-Shablon = FALSE
     1679         .
     1680      RUN Get-Param-AM IN THIS-PROCEDURE (
     1681          p-Asmt-id,
     1682          p-Db-num,
     1683          OUTPUT lIsAmObj,
     1684          OUTPUT iSh-Asmt-id,
     1685          OUTPUT iSh-Db-num,
     1686          OUTPUT cSh-Type,
     1687          OUTPUT cError
     1688          ).
     1689      IF cError <> "" THEN DO:
     1690         MESSAGE
     1691            PROGRAM-NAME(1) ":" SKIP
     1692            "Такого быть не должно !!!" SKIP
     1693            cError SKIP
     1694            VIEW-AS ALERT-BOX INFO BUTTONS OK.
     1695         RETURN.
     1696      END.
     1697      ASSIGN
     1698         cMode                 = (IF lIsAmObj THEN "IL_GDS":U ELSE "")
     1699         v-gl-lAM-Ref-Shablon  = (IF iSh-Asmt-id = 0 THEN FALSE ELSE TRUE)
     1700         .
     1701      RUN Get-Param-AM-Gds IN THIS-PROCEDURE(
     1702          p-Asmt-Id,
     1703          p-Db-num,
     1704          '0':U,
     1705          cMode,
     1706          OUTPUT dAmt
     1707          ).
     1708      ASSIGN
     1709         v-gl-iAM-Gds-All = dAmt[1]
     1710         v-gl-iAM-Gds-Vyv = (IF lIsAmObj THEN dAmt[2] ELSE 0)
     1711         .
     1712       IF NOT v-gl-lAM-Ref-Shablon THEN DO:
     1713          RETURN.
     1714       END.
     1715      RUN Get-Param-AM-Gds IN THIS-PROCEDURE(
     1716          iSh-Asmt-id,
     1717          iSh-Db-num,
     1718          '0':U,
     1719          "",
     1720          OUTPUT dAmt
     1721          ).
     1722      ASSIGN
     1723         v-gl-iAM-Sbl-Gds-All = dAmt[1].
     1724      RUN Calc-Proc-Otkl IN THIS-PROCEDURE(0).
     1725      RETURN.
     1726   END PROCEDURE.
     1727   PROCEDURE Get-Param-AM-Gds:
     1728      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     1729      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     1730      DEFINE INPUT PARAMETER   p-Stat    AS INTEGER    NO-UNDO.
     1731      DEFINE INPUT PARAMETER   p-Mode    AS CHARACTER  NO-UNDO.
     1732      DEFINE OUTPUT PARAMETER  o-dAmt    AS DECIMAL    EXTENT 2 NO-UNDO INITIAL 0.
     1733      DEFINE BUFFER buf_AM-goods FOR ub.Assortment-matrix-goods.
     1734      FOR EACH buf_AM-goods WHERE
     1735               buf_AM-goods.Asmt-id      = p-Asmt-Id
     1736           AND buf_AM-goods.Db-num       = p-Db-num
     1737           AND buf_AM-goods.asmg-status  = p-Stat
     1738          NO-LOCK:
     1739          ASSIGN
     1740             o-dAmt[1] = o-dAmt[1] + 1.
     1741          IF CAN-DO("IL_GDS":U, p-Mode) THEN DO:
     1742             IF Indicator-life-gds-n(recid(buf_AM-goods)) = 'На вывод из ассортимента':U THEN DO:
     1743                ASSIGN
     1744                   o-dAmt[2] = o-dAmt[2] + 1.
     1745             END.
     1746          END.
     1747      END.
     1748      RETURN.
     1749   END PROCEDURE.
     1750   PROCEDURE Get-Param-AM:
     1751      DEFINE INPUT  PARAMETER  p-Asmt-id   AS INTEGER   NO-UNDO.
     1752      DEFINE INPUT  PARAMETER  p-Db-num    AS INTEGER   NO-UNDO.
     1753      DEFINE OUTPUT PARAMETER  lIsObj      AS LOGICAL   NO-UNDO INITIAL FALSE.
     1754      DEFINE OUTPUT PARAMETER  o-Asmt-id   AS INTEGER   NO-UNDO INITIAL 0.
     1755      DEFINE OUTPUT PARAMETER  o-Db-Num    AS INTEGER   NO-UNDO INITIAL 0.
     1756      DEFINE OUTPUT PARAMETER  v-Type      AS CHARACTER NO-UNDO INITIAL "".
     1757      DEFINE OUTPUT PARAMETER  cError      AS CHARACTER NO-UNDO INITIAL "".
     1758      DEFINE VARIABLE v-value AS  CHARACTER NO-UNDO INITIAL "".
     1759      DEFINE BUFFER buf_AM   FOR ub.Assortment-Matrix.
     1760      DEFINE BUFFER buf_AM-2 FOR ub.Assortment-Matrix.
     1761      ASSIGN
     1762         v-gl-lAM-Is-Obj = FALSE.
     1763      FIND FIRST buf_AM WHERE
     1764                 buf_AM.asmt-id = p-Asmt-id
     1765             AND buf_AM.db-num  = p-Db-num
     1766           NO-LOCK NO-ERROR.
     1767      IF NOT AVAILABLE buf_AM THEN DO:
     1768         cError = "Не найдена АМ id=" + STRING(p-Asmt-id) + " db-num=" + STRING(p-Db-num).
     1769         RETURN.
     1770      END.
     1771      IF buf_AM.asmt-type <> 'Объект':U THEN DO:
     1772         RETURN.
     1773      END. ELSE DO:
     1774         ASSIGN
     1775            lIsObj           = TRUE
     1776            v-gl-lAM-Is-Obj  = TRUE
     1777            .
     1778      END.
     1779      run assmatat-value (
     1780          input buf_AM.asmt-id
     1781         ,input buf_AM.db-num
     1782         ,input 'RootShablon':U
     1783         ,output v-value
     1784         ,output v-type
     1785         ) .
     1786      IF v-value = "" OR v-value = ? THEN DO:
     1787         RETURN.
     1788      END.
     1789      ASSIGN
     1790         o-Asmt-id = INTEGER(ENTRY(1, v-value, chr(4)))
     1791         o-Db-num  = INTEGER(ENTRY(2, v-value, chr(4)))
     1792         NO-ERROR.
     1793      IF ERROR-STATUS:ERROR THEN DO:
     1794         cError = PROGRAM-NAME(1) + ":" + ERROR-STATUS:GET-MESSAGE(1).
     1795         RETURN.
     1796      END.
     1797      FIND FIRST buf_AM-2 WHERE
     1798                 buf_AM-2.asmt-id = o-Asmt-id
     1799             AND buf_AM-2.db-num  = o-Db-num
     1800           NO-LOCK NO-ERROR.
     1801      IF NOT AVAILABLE buf_AM-2 THEN DO:
     1802         cError = "Не найден шаблон АМ id=" + STRING(o-Asmt-id) + " db-num=" + STRING(o-Db-num).
     1803         RETURN.
     1804      END.
     1805      RETURN.
     1806   END PROCEDURE.
     1807   PROCEDURE Get-Gl-Set-Proc-Otkl:
     1808      DEFINE INPUT PARAMETER  cObj-type AS CHARACTER NO-UNDO.
     1809      DEFINE INPUT PARAMETER  iObj-code AS INTEGER   NO-UNDO.
     1810      DEFINE VARIABLE v-Character   AS CHARACTER  NO-UNDO .
     1811      DEFINE VARIABLE v-Date        AS DATE       NO-UNDO .
     1812      DEFINE VARIABLE v-Decimal     AS DECIMAL    NO-UNDO .
     1813      DEFINE VARIABLE v-Integer     AS INTEGER    NO-UNDO .
     1814      DEFINE VARIABLE v-Logical     AS LOGICAL    NO-UNDO .
     1815      DEFINE VARIABLE v-Param-Type  AS CHARACTER  NO-UNDO .
     1816      ASSIGN
     1817         v-gl-iProc-Otkl = 0
     1818         .
     1819      EMPTY TEMP-TABLE thbjattr_thbj-attr .
     1820      RUN adm/shattri.p (
     1821              INPUT  "get":U,
     1822              INPUT  cObj-type,
     1823              INPUT  iObj-code,
     1824              INPUT  'Ass-obj':U,
     1825              INPUT  'ass-proc-matr-shabl':U ,
     1826              OUTPUT v-Character,
     1827              OUTPUT v-Date,
     1828              OUTPUT v-Decimal,
     1829              OUTPUT v-Integer,
     1830              OUTPUT v-Logical,
     1831              OUTPUT v-Param-Type,
     1832              INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1833          ) NO-ERROR.
     1834      IF ERROR-STATUS:ERROR THEN DO:
     1835         ASSIGN
     1836            v-Integer  = 0
     1837            v-Decimal  = 0.
     1838      END. ELSE DO:
     1839         ASSIGN
     1840            v-gl-iProc-Otkl = v-Integer
     1841            .
     1842      END.
     1843      RETURN.
     1844   END PROCEDURE.
     1845   PROCEDURE Calc-Proc-Otkl:
     1846      DEFINE INPUT PARAMETER iDeltaGds AS INTEGER NO-UNDO.
     1847      DEFINE VARIABLE iTmp AS INTEGER NO-UNDO INITIAL 0.
     1848      ASSIGN
     1849         v-gl-dAM-Proc-Otkl     = 0
     1850         v-gl-dAM-Proc-Otkl-Ras = 0
     1851         .
     1852      IF NOT v-gl-lAM-Ref-Shablon THEN DO:
     1853         RETURN.
     1854      END.
     1855      IF v-gl-iAM-Sbl-Gds-All = 0 THEN DO:
     1856         ASSIGN
     1857            v-gl-dAM-Proc-Otkl     = 999999
     1858            v-gl-dAM-Proc-Otkl-Ras = 999999
     1859            .
     1860         RETURN.
     1861      END.
     1862      ASSIGN
     1863         iTmp = (v-gl-iAM-Gds-All - v-gl-iAM-Sbl-Gds-All)
     1864         v-gl-dAM-Proc-Otkl     = ROUND(iTmp * 100 / v-gl-iAM-Sbl-Gds-All, 2)
     1865         v-gl-dAM-Proc-Otkl-Ras = ROUND((iTmp + iDeltaGds)  * 100 / v-gl-iAM-Sbl-Gds-All, 2)
     1866         .
     1867      RETURN.
     1868   END PROCEDURE.
     1869   FUNCTION indicator-life-gds-n RETURNS CHARACTER
     1870   ( input p-rec as recid ) :
     1871   define buffer buf_matrix-goods for ub.assortment-matrix-goods .
