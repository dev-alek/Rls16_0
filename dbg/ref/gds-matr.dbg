     1441   procedure assmatat-value :
     1442     define input  parameter p-asmt-id     like ub.assortment-matrix-attr.asmt-id     no-undo .
     1443     define input  parameter p-db-num     like ub.assortment-matrix-attr.db-num     no-undo .
     1444     define input  parameter p-code      like ub.assortment-matrix-attr.attr-code  no-undo .
     1445     define output parameter p-value     like ub.assortment-matrix-attr.attr-value no-undo .
     1446     define output parameter p-type      as character no-undo .
     1447     do
     1448     on error undo, return error
     1449     :
     1450           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run assmatat-value in g#attr-lib
     1451         (input  p-asmt-id
