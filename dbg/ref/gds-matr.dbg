     2094         VIEW-AS TEXT
     2095        SIZE 9 BY .67 TOOLTIP "Общее количество товаров в матрице(SCU) в статусе ТЕК" NO-UNDO.
     2096   DEFINE VARIABLE v-raznost AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
     2097        LABEL "разность"
     2098         VIEW-AS TEXT
     2099        SIZE 8.5 BY .67 TOOLTIP "Общее количество товаров в матрице(SCU) в статусе ТЕК" NO-UNDO.
     2100   DEFINE VARIABLE v-user-name-corr AS CHARACTER FORMAT "X(256)":U
     2101        LABEL "Изменил"
     2102         VIEW-AS TEXT
     2103        SIZE 20 BY .67
     2104        FGCOLOR 4  NO-UNDO.
     2105   DEFINE VARIABLE v-user-name-create AS CHARACTER FORMAT "X(256)":U
     2106        LABEL "Создал"
     2107         VIEW-AS TEXT
     2108        SIZE 20.5 BY .67
     2109        FGCOLOR 4  NO-UNDO.
     2110   DEFINE VARIABLE a-n-c AS INTEGER INITIAL 1
     2111        VIEW-AS RADIO-SET HORIZONTAL
     2112        RADIO-BUTTONS
     2113             "А", 1,
     2114   "Н", 2,
     2115   "К", 3
     2116        SIZE 12 BY 1 TOOLTIP "Поиск товара по Артиклу, Названию , Коду" NO-UNDO.
     2117   DEFINE VARIABLE RS-sts AS CHARACTER
     2118        VIEW-AS RADIO-SET HORIZONTAL
     2119        RADIO-BUTTONS
     2120             "Текушие-", "1",
     2121   "Все-", "2",
     2122   "Удаленные3", "3"
     2123        SIZE 31.38 BY 1 NO-UNDO.
     2124   DEFINE QUERY BROWSE-am-goods FOR
     2125         Buf_matrix-goods,
     2126         Buf_goods SCROLLING.
     2127   DEFINE BROWSE BROWSE-am-goods
     2128     QUERY BROWSE-am-goods NO-LOCK DISPLAY
     2129         mark-string(recid( buf_Matrix-goods) , p-rid-list) @ p-mark COLUMN-LABEL "*" FORMAT "x(1)":U
     2130         f-shablon(recid( buf_Matrix-goods)) @ p-shablon COLUMN-LABEL " !Ш" FORMAT "+/-":U
     2131         Buf_goods.artic FORMAT "X(16)":U COLUMN-LABEL 'Артикул! '
     2132         STRING ( if Buf_goods.stts <> 0 then substring(Buf_goods.gds-name,1,15) + " <УДАЛЕН>"  else Buf_goods.gds-name ) @ p-name COLUMN-LABEL 'Название! ' FORMAT "X(30)":U
     2133         Buf_matrix-goods.asmg-date-update COLUMN-LABEL "Дата!изменения" FORMAT "99/99/99":U
     2134         STRING (buf_Matrix-goods.asmg-time-update, 'HH:MM' ) FORMAT "x(5)":U  COLUMN-LABEL 'Время!изм '
     2135         Buf_matrix-goods.asmg-db-num-update COLUMN-LABEL "БД!изм" FORMAT ">>>>9":U
     2136         Buf_matrix-goods.asmg-date-create COLUMN-LABEL "Дата!создания" FORMAT "99/99/99":U
     2137         STRING (buf_Matrix-goods.asmg-time-create, 'HH:MM' )  FORMAT "x(5)":U COLUMN-LABEL "Время! "
     2138         indicator-life-gds(recid( buf_Matrix-goods) ) @ p-indicator-life-gds COLUMN-LABEL "ИЖТ! " FORMAT "x(15)":U
     2139         assort-min(recid( buf_Matrix-goods) ) @ p-assort-min COLUMN-LABEL "Acc!Min" FORMAT "*/":U
     2140         Buf_matrix-goods.asmg-db-num-create COLUMN-LABEL "БД!соз" FORMAT ">>>>9":U
     2141         entry (lookup (STRING(buf_Matrix-goods.asmg-status), '0,1,50,99':U), 'тек,удал,блок,удаление':U) @ p-status COLUMN-LABEL "Статус! " FORMAT "x(6)":U
     2142         Buf_goods.grp-name COLUMN-LABEL "Группа! " FORMAT "x(45)":U
     2143         Buf_goods.gds-code COLUMN-LABEL "Группа!код "
     2144     ENABLE
     2145         Buf_matrix-goods.asmg-db-num-update
     2146       WITH NO-ROW-MARKERS SEPARATORS SIZE 96.5 BY 13.5 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
     2147   DEFINE FRAME Dialog-Frame
     2148        b-quit AT ROW 1 COL 1
     2149        B-mark AT ROW 1 COL 11
     2150        B-mark-all AT ROW 1 COL 14 WIDGET-ID 12
     2151        B-mark-del-all AT ROW 1 COL 17 WIDGET-ID 14
     2152        B-sel AT ROW 1 COL 23
     2153        B-add AT ROW 1 COL 33
     2154        B-lookup AT ROW 1 COL 43
     2155        B-chg AT ROW 1 COL 53
     2156        B-del AT ROW 1 COL 63
     2157        B-copy AT ROW 1 COL 73.13
     2158        B-print AT ROW 1 COL 92.38
     2159        B-Help AT ROW 1 COL 95
     2160        B-chg-izt AT ROW 2 COL 63 WIDGET-ID 10
     2161        B-grpAcc AT ROW 2 COL 73.13 WIDGET-ID 8
     2162        b-sch AT ROW 2 COL 95 WIDGET-ID 6
     2163        RS-sts AT ROW 2.17 COL 9.63 NO-LABEL
     2164        a-n-c AT ROW 3 COL 9.5 NO-LABEL
     2165        sch-name AT ROW 3 COL 20.5 COLON-ALIGNED NO-LABEL
     2166        sch-code AT ROW 3 COL 20.5 COLON-ALIGNED NO-LABEL
     2167        sch-artic AT ROW 3 COL 20.5 COLON-ALIGNED NO-LABEL
     2168        B-link-obj AT ROW 3 COL 94.5 WIDGET-ID 16
     2169        BROWSE-am-goods AT ROW 4.25 COL 1
     2170        ED_asmg-des AT ROW 19.75 COL 25.5 NO-LABEL
     2171        mark-num AT ROW 1 COL 18.25 COLON-ALIGNED NO-LABEL
     2172        FILL-IN-1 AT ROW 2.13 COL 1.5 NO-LABEL
     2173        FILL-IN-7 AT ROW 2.96 COL 2.5 NO-LABEL
     2174        v-user-name-create AT ROW 17.75 COL 8.5 COLON-ALIGNED WIDGET-ID 2
     2175        v-user-name-corr AT ROW 17.75 COL 74.5 COLON-ALIGNED WIDGET-ID 4
     2176        v-kol-all AT ROW 18.75 COL 12.5 COLON-ALIGNED WIDGET-ID 18
     2177        v-kol-in-shabl AT ROW 18.75 COL 35 COLON-ALIGNED WIDGET-ID 22
     2178        v-raznost AT ROW 18.75 COL 58 COLON-ALIGNED WIDGET-ID 24
     2179        v-proc-otkl AT ROW 18.75 COL 84.5 COLON-ALIGNED WIDGET-ID 26
     2180        v-kol-del AT ROW 20.25 COL 12.5 COLON-ALIGNED WIDGET-ID 20
     2181        SPACE(73.24) SKIP(0.86)
     2182       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2183            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2184            TITLE "Ассортиментная матрица".
     2185   ASSIGN
     2186          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2187          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2188   ASSIGN
     2189          B-del:POPUP-MENU IN FRAME Dialog-Frame       = MENU menu-del:HANDLE.
     2190   ASSIGN
     2191          B-link-obj:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2192   ASSIGN
     2193          b-sch:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2194   ASSIGN
     2195          sch-code:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2196   ASSIGN
     2197          sch-name:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2198   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2199   OR ENDKEY OF FRAME Dialog-Frame
     2200   OR END-ERROR OF FRAME DIALOG-FRAME
     2201   DO:
     2202     run gbl/markqwa.p
     2203         ( input b-mark:sensitive
     2204         , input p-rid-list ) no-error.
     2205     if error-status:error then return no-apply.
     2206     if buf_matrix.asmt-type <> 'Шаблон':U then return .
     2207      run translate-to-other ( buf_matrix.asmt-id, buf_matrix.db-num ).
     2208       if v-longchar-asstro <> ""  then do:
     2209       define variable v-ok as logical   no-undo .
     2210       run gbl/d-longchar.w (
     2211               ?,
     2212               'Editor_row=2\':u
     2213             + 'title=При транслировании в Ассортиментные матрицы\':u
     2214             + 'Editor_col=1\':u
     2215             + 'Editor_width=96\':u
     2216             + 'Editor_height=21\':u
     2217             + 'readonly=yes\':u
     2218           ,input-output v-longchar-asstro
     2219           ,output v-ok ) no-error .
     2220           v-longchar-asstro = "" .
     2221   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clear-longmess in g#lib-Matrix
     2222      .
     2223       end.
     2224      return .
     2225   END.
     2226   ON VALUE-CHANGED OF a-n-c IN FRAME Dialog-Frame
     2227   DO:
     2228     ASSIGN a-n-c .
     2229     case a-n-c  :
     2230     when 1 then do:
     2231       enable sch-artic with frame Dialog-Frame .
     2232       hide sch-name sch-code in frame Dialog-Frame .
     2233     end.
     2234     when 2 then do:
     2235       enable sch-name with frame Dialog-Frame .
     2236       hide sch-artic sch-code in frame Dialog-Frame .
     2237     end.
     2238     when 3  then do:
     2239       enable sch-code with frame Dialog-Frame .
     2240       hide sch-name sch-artic in frame Dialog-Frame .
     2241     end.
     2242     end case.
     2243   END.
