     2618       for each buf_Matrix-goods no-lock where Buf_matrix-goods.db-num = p-db-num  AND Buf_matrix-goods.asmt-id = p-id :
     2619   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2620   define variable v-str-recid30 as character no-undo .
     2621   define variable v-num-entry30 as integer   no-undo .
