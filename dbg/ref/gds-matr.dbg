     3823           (input v-diasize-orig-frame-width
     3824               - frame Dialog-Frame :width-chars
     3825           ,input true
     3826           ) .
     3827         run diasize_change-height in this-procedure
     3828           (input v-diasize-orig-frame-height
     3829               - frame Dialog-Frame :height-chars
     3830           ,input true
     3831           ) .
     3832         assign
