        1   DEFINE BUFFER X_c-gds-hist FOR ub.c-gds-hist.
        2   DEFINE BUFFER x_c-gds-obj-prop FOR ub.c-gds-obj-prop.
        3   DEFINE BUFFER X_curr_clients FOR ub.clients.
        4   DEFINE BUFFER x_gds-obj-prop FOR ub.gds-obj-prop.
        5   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        6   define input parameter p-gds-code like ub.gds-obj-prop.gds-code no-undo .
        7   define input parameter p-obj-type like ub.clients.obj-type no-undo.
        8   define input parameter p-obj-code like ub.clients.obj-code no-undo.
        9   define input-output param p-rid-list    as  char no-undo .
       10   define variable bttns  as char   no-undo .
       11   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       12   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       13   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       14   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       15   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       16   define variable vss-description AS CHAR NO-UNDO INIT "Список истории индикаторов товара на объекте":U.
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   procedure proc-alt-shift-f2:
       87     if not ibs.th.gbl.gbl-var:rcode
       88   then
       89     run gbl\inidebug.p .
       90   end.
       91   procedure proc-alt-shift-f3:
       92     run gbl/prvssinf.p
       93       ( input this-procedure
       94       ) .
       95   end.
       96   define variable v-inform-launched as logical no-undo initial false .
       97   procedure proc-alt-shift-f4:
       98     define variable v-action as character no-undo .
       99     if v-inform-launched = false then do:
      100       assign
      101         v-inform-launched = true
      102       .
      103       run gbl/d-inform.w
      104         (  input self
      105         ,  input this-procedure
      106         , output v-action
      107         ) no-error .
      108       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      109       assign
      110         v-inform-launched = false
      111       .
      112     end.
      113   end.
      114   procedure proc-alt-f1:
      115     run gbl/corrhelp.p
      116       (input this-procedure
      117       ) .
      118   end .
      119   on alt-shift-f2 anywhere do:
      120     run proc-alt-shift-f2.
      121   end.
      122   on alt-shift-f3 anywhere do:
      123     run proc-alt-shift-f3 in this-procedure .
      124   end.
      125   on alt-shift-f4 anywhere do:
      126     run proc-alt-shift-f4 in this-procedure.
      127   end.
      128   on alt-f1 anywhere do:
      129     run proc-alt-f1 in this-procedure .
      130   end.
      131   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      132   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      133   define new shared variable RepPathName        as character no-undo .
      134   define new shared variable PrintRubl          as logical   no-undo .
      135   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      136   define variable v-waitfram-action01         as character   no-undo .
      137   define variable v-waitfram-action02         as character   no-undo .
      138   define variable v-waitfram-action03         as character   no-undo .
      139   define variable mWaitFramTextBeg            as character   no-undo.
      140   define variable mWaitFramTextEnd            as character   no-undo.
      141   define variable mWaitFramView               as logical     no-undo.
      142   define variable mWaitProcEvent              as logical     no-undo init yes.
      143   define variable mWaitFramInterval           as integer     no-undo init 1 .
      144   define variable mWaitFramStop               as logical     no-undo.
      145   define variable mWaitFramStopUser           as logical     no-undo.
      146   define variable mWaitFramStopTimeOut        as logical     no-undo.
      147   define variable mWaitFramStartProc          as datetime-tz no-undo.
      148   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      149   define button B-WaitFramStop auto-end-key
      150        label "Стоп"
      151        size 10 by 1 tooltip "Остоновить процесс".
      152   define button B-viewProcInfo
      153        label "Информация"
      154        size 15 by 1 tooltip "Информация о процесс".
      155   define frame waitfram
      156     v-waitfram-action01 format "x(72)" no-label skip
      157     v-waitfram-action02 format "x(72)" no-label skip
      158     v-waitfram-action03 format "x(72)" no-label skip
      159     B-viewProcInfo
      160     B-WaitFramStop at row 4 col 30
      161     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      162     .
      163   define new global shared variable mBatchMode as logical no-undo init ?.
      164   define variable mFramBachModHandle as handle no-undo.
      165   mFramBachModHandle = frame waitfram:handle.
      166   define variable mFameOldVis as logical no-undo.
      167   define variable mVisCUrentVin as logical no-undo.
      168   if session:batch-mode
      169   then
      170      mBatchMode = yes.
      171   if mBatchMode = ? then do:
      172     mVisCUrentVin = current-window:visible.
      173     mFameOldVis = mFramBachModHandle:visible.
      174     mFramBachModHandle:visible  = yes.
      175     mBatchMode = mFramBachModHandle:visible ne yes.
      176     mFramBachModHandle:visible = mFameOldVis.
      177     current-window:visible = mVisCUrentVin.
      178   end.
      179    if  log-manager:logfile-name ne ?
      180     then DO:
      181         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      182         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      183         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      184     end.
      185   on choose of B-WaitFramStop in frame waitfram
      186   do:
      187     mWaitFramStop = yes.
      188     mWaitFramStopUser = yes.
      189   end.
      190   function waitfram-check-timeout returns logical():
      191      define variable vtime as int64 no-undo.
      192      if mWaitFramStopTimeOut
      193      then
      194         return yes.
      195      vtime = ( now - mWaitFramStartProc ) / 1000 .
      196      if     mWaitFramTimeOut ne ?
      197         and mWaitFramTimeOut ne 0
      198         and mWaitFramTimeOut lt vtime
      199      then do:
      200         mWaitFramStopTimeOut = yes.
      201      end.
      202      return mWaitFramStopTimeOut.
      203   end.
      204   procedure waitfram-hide :
      205     if not session:batch-mode
      206     then do
      207     on error undo, return error return-value
      208     :
      209       pause 0 before-hide .
      210       if not mBatchMode then
      211         hide frame waitfram .
      212     if     not mWaitFramView
      213        and mWaitProcEvent
      214     then
      215       process events .
      216     end.
      217   end procedure.
      218   procedure waitfram-show :
      219     define input  parameter p-message as character no-undo .
      220     define variable v-left-margin as integer   no-undo .
      221     if not session:batch-mode
      222     then do
      223     on error undo, return error return-value
      224     :
      225       if length(p-message) <= 70 then do:
      226         assign
      227           v-left-margin = integer((70 - length(p-message)) / 2)
      228         .
      229         assign
      230           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      231         .
      232         assign
      233           v-waitfram-action01 = " "
      234           v-waitfram-action02 = " "
      235                                    + fill(" ", v-left-margin)
      236                                    + p-message
      237           v-waitfram-action03 = " "
      238         .
      239       end.
      240       else do:
      241         define variable vRindex1 as integer no-undo.
      242         define variable vRindex2 as integer no-undo.
      243         vRindex1 = r-index(p-message," ",70).
      244         if vRindex1 = 0
      245         then
      246            vRindex1 = 70.
      247         if length(p-message)  <= vRindex1 + 70 then do:
      248           assign
      249             v-waitfram-action01 = " "
      250             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      251             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      252           .
      253         end.
      254         else do:
      255           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      256           if vRindex2 <= vRindex1
      257           then
      258              vRindex2 = vRindex1 + 70.
      259           assign
      260             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      261             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      262             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      263           .
      264         end.
      265       end.
      266       B-viewProcInfo:visible   in frame waitfram = no.
      267       B-viewProcInfo:sensitive in frame waitfram = no.
      268       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      269       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      270       if  (   mWaitFramView
      271          or  mWaitProcEvent)
      272          and not mBatchMode
      273       then
      274          display
      275             v-waitfram-action01 skip
      276             v-waitfram-action02 skip
      277             v-waitfram-action03 skip
      278          with frame waitfram .
      279       if     mWaitFramView
      280          then do:
      281             if     mWaitFramInterval ne ?
      282                and not mBatchMode
      283             then
      284                wait-for go of frame waitfram pause mWaitFramInterval.
      285          end.
      286          else
      287             if     mWaitProcEvent
      288                and not mBatchMode
      289             then
      290                process events .
      291     end.
      292   end procedure.
      293      procedure waitfram-show-this:
      294         define input  parameter iInterval as int64 no-undo.
      295         define variable vtime as int64 no-undo.
      296         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      297         mWaitFramInterval = iInterval.
      298         run waitfram-show (substitute("&1&2 &3&4" ,
      299                                       mWaitFramTextBeg ,
      300                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      301                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      302                                       mWaitFramTextEnd
      303                                      )
      304                           ).
      305      end.
      306      procedure WaitFramRunPause:
      307         define input  parameter iInterval as dec no-undo.
      308         define variable vStart  as datetime-tz no-undo.
      309         define variable vend    as datetime-tz no-undo.
      310         define variable vint as int64 no-undo.
      311         define variable vOk as logical no-undo.
      312         vStart = now.
      313         vend   = vStart.
      314         publish "WaitFramPause" (iInterval,output vOk).
      315         vend   =  now.
      316         vint = vend - vStart.
      317         vint = iInterval - vint / 1000.
      318         if     not mWaitFramStop
      319            and (   vint > 0
      320                 or (    not vOk
      321                     and iInterval eq ?
      322                     )
      323                 )
      324         then
      325            run waitfram-show-this (iInterval).
      326         vend   =  now.
      327         vint = vend - vStart.
      328         vint = iInterval - vint / 1000.
      329         if     not mWaitFramStop
      330            and vint > 0
      331         then do:
      332            run gbl/pause.p (vint * 1000).
      333         end.
      334         if iInterval ne ?
      335         then
      336            publish "WaitFramStop".
      337         waitfram-check-timeout().
      338      end.
      339      procedure WaitFramWaitFor:
      340         define input  parameter iInterval as dec no-undo.
      341         assign
      342            mWaitFramStartProc   = now
      343            mWaitFramStopUser    = no
      344            mWaitFramStopTimeOut = no
      345         .
      346         block-wait:
      347         do while not mWaitFramStop:
      348            run WaitFramRunPause (iInterval).
      349            if  waitfram-check-timeout()
      350            then do:
      351               leave block-wait.
      352            end.
      353         end.
      354         run waitfram-hide.
      355      end.
      356   procedure waitfram-join :
      357     define input  parameter p-line-1  as character no-undo .
      358     define input  parameter p-line-2  as character no-undo .
      359     define input  parameter p-line-3  as character no-undo .
      360     define output parameter p-message as character no-undo .
      361     do
      362     on error undo, return error return-value
      363     :
      364       assign
      365         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      366                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      367                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      368       .
      369     end.
      370   end procedure.
      371   function waitfram-join-function returns character
      372     (input p-line-1 as character
      373     ,input p-line-2 as character
      374     ,input p-line-3 as character
      375     ).
      376     define variable v-message as character no-undo .
      377     run waitfram-join in this-procedure
      378       (input  p-line-1
      379       ,input  p-line-2
      380       ,input  p-line-3
      381       ,output v-message
      382       ) .
      383     return v-message .
      384   end function .
      385   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      386   define  stream PrnLibStream.
      387   procedure prn-lib-prn-file :
      388     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      389     define input parameter p-DIsabledoptions as integer no-undo .
      390     define variable v-report-name as character no-undo .
      391     define variable v-user-action as character no-undo .
      392     define variable v-printed     as logical   no-undo .
      393     define variable v-exist       as logical   no-undo .
      394     do
      395       on error undo, return error
      396       :
      397       run prn-lib-get-report-name  in this-procedure (
      398         input parParentProc
      399         ,output v-report-name
      400         ).
      401   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      402   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      403     (input  v-report-name
      404     ,input  2
      405     ,output v-exist
      406     )  .
      407       if NOT v-exist then
      408       DO:
      409         Message
      410           "Нет заданий на печать ! "
      411           view-as alert-box .
      412         Return  .
      413       End.
      414       run gbl/prnfilen.w
      415         (input  ""
      416         ,input  p-DisabledOptions
      417         ,input  string(v-report-name )
      418         ,input  7
      419         ,output v-user-action
      420         ,output v-printed
      421         ) .
      422       if v-printed then
      423       do:
      424         return "YES" .
      425       end.
      426       else
      427       do:
      428         return "NO" .
      429       end.
      430     end.
      431   end procedure.
      432   procedure prn-lib-open-stream :
      433     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      434     define input parameter p-page-size    as integer no-undo .
      435     define input parameter p-is-stream    as logical no-undo .
      436     define input parameter p-append       as logical no-undo .
      437     define variable v-report-name as character no-undo .
      438     do
      439       on error undo, return error
      440       :
      441       run prn-lib-get-report-name  in this-procedure (
      442         input parParentProc
      443         ,output v-report-name
      444         ).
      445       if p-is-stream then
      446       do:
      447         if p-append then
      448         do:
      449           output stream PrnLibStream to value( v-report-name )
      450             page-size value(p-page-size) append .
      451         end.
      452         if not p-append then
      453         do:
      454           output stream PrnLibStream to value( v-report-name )
      455             page-size value(p-page-size) .
      456         end.
      457       end.
      458       if not p-is-stream then
      459       do:
      460         if p-append then
      461         do:
      462           output to value( v-report-name )
      463             page-size value(p-page-size) append .
      464         end.
      465         if not p-append then
      466         do:
      467           output to value( v-report-name )
      468             page-size value(p-page-size) .
      469         end.
      470       end.
      471     end.
      472   end procedure.
      473   procedure prn-lib-open-exp :
      474     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      475     define input parameter p-is-stream    as logical no-undo .
      476     define input parameter p-is-append    as logical no-undo .
      477     define output parameter p-ReportFileName as char init "report" no-undo.
      478     define output parameter p-process as logical no-undo .
      479     define variable glog as logical no-undo .
      480     do
      481       on error undo, return error
      482       :
      483       SYSTEM-DIALOG GET-FILE p-ReportFileName
      484         TITLE      "Укажите путь"
      485         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      486         ASK-OVERWRITE
      487         CREATE-TEST-FILE
      488         SAVE-AS
      489         USE-FILENAME
      490         DEFAULT-EXTENSION "txt"
      491         UPDATE glog
      492         .
      493       if not glog then  return.
      494       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      495       if p-is-stream then
      496       do:
      497         if p-is-append then
      498         do:
      499           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      500         end.
      501         else
      502         do:
      503           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      504         end.
      505       end.
      506       else
      507       do:
      508         if p-is-append then
      509         do:
      510           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      511         end.
      512         else
      513         do:
      514           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      515         end.
      516       end.
      517       p-process = yes.
      518     end.
      519   end procedure.
      520   procedure prn-lib-get-report-name :
      521     define input parameter parParentProc  as widget-handle no-undo.
      522     define output parameter p-report-name as character no-undo .
      523     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      524   end procedure.
      525   procedure prn-lib-reportviewer-report-name :
      526     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      527     define input parameter p-report-name-html as character no-undo .
      528     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      529   end procedure.
      530   procedure prn-lib-reportviewer :
      531     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      532     define input parameter p-report-name-html as character no-undo .
      533     define input parameter p-param        as character no-undo .
      534     define variable v-excel           as character no-undo init 'TRUE' .
      535     define variable v-value-character as character no-undo .
      536     define variable v-value-integer   as character no-undo .
      537     define variable v-value-date      as date      no-undo .
      538     define variable v-value-decimal   as decimal   no-undo .
      539     define variable rep-excel         as logical   no-undo .
      540     define variable excel-string      as character no-undo .
      541     define variable v-param-type      as character no-undo .
      542     define variable v-tth             as handle    no-undo .
      543     run adm/shattri.p (
      544       input "get":U
      545       ,input  ""
      546       ,input  0
      547       ,input  'report-glob':U
      548       ,input  'rep-excel':U
      549       ,output v-value-character
      550       ,output v-value-date
      551       ,output v-value-decimal
      552       ,output v-value-integer
      553       ,output rep-excel
      554       ,output v-param-type
      555       ,INPUT-OUTPUT table-handle v-tth
      556       )  .
      557     if rep-excel then v-excel = "TRUE" .
      558     else v-excel = "FALSE" .
      559     if p-param eq ""
      560     then
      561        p-param = "EXCEL:" + v-excel.
      562     else
      563        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      564     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      565   end procedure.
      566   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      567   procedure cur-time :
      568      define output parameter p-today as date      no-undo .
      569      define output parameter p-time  as integer   no-undo .
      570     do
      571     on error undo, return error
      572     :
      573       define variable v-date1 as date      no-undo .
      574       define variable v-date2 as date      no-undo .
      575       define variable v-time  as integer   no-undo .
      576       assign
      577         v-date1 = today
      578         v-time  = time
      579         v-date2 = today
      580       .
      581       if v-date1 <> v-date2
      582       then do:
      583         assign
      584           v-date1 = today
      585           v-time  = v-time
      586         .
      587       end.
      588       assign
      589         p-today = v-date1
      590         p-time  = v-time
      591       .
      592     end.
      593   end.
      594   function cur-time-date returns character
      595   :
      596     return string(today, '99/99/9999':U) .
      597   end.
      598   function cur-time-mjd returns decimal
      599   :
      600     define variable v-date as date      no-undo .
      601     define variable v-time as integer   no-undo .
      602     run cur-time in this-procedure
      603       (output v-date
      604       ,output v-time
      605       ) .
      606     return integer(v-date) - 2400002 + (v-time / 86400) .
      607   end.
      608   function cur-time-get-ending-index returns integer
      609   (input p-number as integer
      610   )
      611   :
      612     if p-number < 0
      613     or p-number = ?
      614     then do:
      615       return 1 .
      616     end.
      617     define variable v-rest as integer   no-undo .
      618     assign
      619       p-number = p-number modulo 100
      620     .
      621     if p-number < 20
      622     then do:
      623       assign
      624         v-rest = p-number
      625       .
      626     end.
      627     else do:
      628       assign
      629         v-rest = p-number modulo 10
      630       .
      631     end.
      632     case v-rest :
      633       when 1
      634       then do:
      635         return 2 .
      636       end.
      637       when 2 or
      638       when 3 or
      639       when 4
      640       then do:
      641         return 3 .
      642       end.
      643       otherwise do:
      644         return 1 .
      645       end.
      646     end case .
      647   end.
      648   procedure cur-time-mjd-to-date :
      649      define input  parameter i-mjd-diff as decimal no-undo.
      650      define output parameter o-Date     as date    no-undo.
      651      define output parameter o-Time     as integer no-undo.
      652      define variable v-day-number as integer   no-undo .
      653      if    i-mjd-diff < 0
      654         or i-mjd-diff = ?
      655      then do:
      656         return "?" .
      657      end.
      658      assign
      659         v-day-number = truncate(i-mjd-diff,0).
      660         o-Date = date(v-day-number + 2400002).
      661         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      662     .
      663   end.
      664   function cur-time-mjd-to-string returns character
      665   (input p-mjd-diff as decimal
      666   )
      667   :
      668     define variable v-day-number as integer   no-undo .
      669     define variable v-seconds    as integer   no-undo .
      670     define variable v-hour       as integer   no-undo .
      671     define variable v-min        as integer   no-undo .
      672     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      673     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      674     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      675     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      676     if p-mjd-diff < 0
      677     or p-mjd-diff = ?
      678     then do:
      679       return "?" .
      680     end.
      681     assign
      682       v-day-number = integer(truncate(p-mjd-diff,0))
      683       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      684     .
      685     if v-seconds > 86400
      686     then do:
      687       assign
      688         v-seconds = 86400 - 1
      689       .
      690     end.
      691     if v-seconds < 0
      692     then do:
      693       assign
      694         v-seconds = 0
      695       .
      696     end.
      697     assign
      698       v-hour = truncate(v-seconds / 3600, 0)
      699     .
      700     assign
      701       v-seconds = v-seconds modulo 3600
      702     .
      703     assign
      704       v-min = truncate(v-seconds / 60, 0)
      705     .
      706     assign
      707       v-seconds = v-seconds modulo 60
      708     .
      709     return
      710         (if v-day-number <> 0
      711           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      712           else ""
      713         )
      714       + (if v-day-number <> 0 or v-hour <> 0
      715           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      716           else ""
      717         )
      718       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      719           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      720           else ""
      721         )
      722       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      723       .
      724   end.
      725   function cur-time-string returns character
      726   :
      727     define variable v-date as date      no-undo .
      728     define variable v-time as integer   no-undo .
      729     run cur-time in this-procedure
      730       (output v-date
      731       ,output v-time
      732       ) .
      733     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      734   end.
      735   function cur-time-string-sec returns character
      736   :
      737     define variable v-date as date      no-undo .
      738     define variable v-time as integer   no-undo .
      739     run cur-time in this-procedure
      740       (output v-date
      741       ,output v-time
      742       ) .
      743     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      744   end.
      745   function cur-time-custom  returns character
      746   (input p-prefix as character
      747   ,input p-date-format as character
      748   ,input p-delimiter as character
      749   ,input p-time-format as character
      750   ,input p-suffix as character
      751   )
      752   :
      753     define variable v-date as date      no-undo .
      754     define variable v-time as integer   no-undo .
      755     run cur-time in this-procedure
      756       (output v-date
      757       ,output v-time
      758       ) .
      759     return
      760       p-prefix
      761       + string(v-date, p-date-format)
      762       + p-delimiter
      763       + string(v-time, p-time-format)
      764       + p-suffix
      765       .
      766   end.
      767   function cur-time-print  returns character
      768   :
      769     define variable v-date as date      no-undo .
      770     define variable v-time as integer   no-undo .
      771     run cur-time in this-procedure
      772       (output v-date
      773       ,output v-time
      774       ) .
      775     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      776   end.
      777   function cur-time-datetime returns datetime
      778   :
      779     define variable v-char as character no-undo .
      780     define variable v-datetime as datetime no-undo .
      781     v-char = cur-time-string().
      782     v-datetime = datetime(v-char).
      783     return  v-datetime.
      784   end.
      785   function cur-time-string-msec returns character
      786   :
      787     define variable v-date as datetime  no-undo .
      788     v-date = now.
      789     return string(v-date) .
      790   end.
      791   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      792   function usrfulnf returns character ( input p-user-id as character):
      793   define variable v-user-name as character no-undo .
      794   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      795   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      796     (input  p-user-id
      797     ,output v-user-name
      798     ) no-error .
      799   if error-status:error
      800   or v-user-name = ""
      801   then do:
      802     return p-user-id.
      803   end.
      804   else do:
      805     return v-user-name.
      806   end.
      807   end function.
      808   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      809   define variable sort-column-name as character no-undo .
      810   define variable v-db-num LIKE ub.db.db-num no-undo.
      811   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      812   define NEW SHARED temp-table temp-changes no-undo
      813   field f_name as character
      814   field l_name as character
      815   field v_old as character
      816   field v_new as character
      817   field t_name as character
      818   field num_ as integer
      819   field uniq-key-rec as character
      820   field action as integer
      821   field fNotChange as logical
      822   index pi is unique primary
      823   num_
      824   t_name
      825   f_name
      826   index
      827   Chan
      828   fnotChange
      829   t_name
      830   f_name
      831   index imain uniq-key-rec
      832   .
      833   FUNCTION get-all-fields returns character (p-file-name as character ):
      834   define variable v-dop as character no-undo .
      835     find first _file no-lock where _file._file-name = p-file-name no-error .
      836     if not available _file then return "":U.
      837     for each _field no-lock where
      838              _field._file-recid = recid(_file) :
      839       assign
      840       v-dop = v-dop + _field._field-name + chr(44)
      841       .
      842     end.
      843     return trim(v-dop).
      844   END FUNCTION.
      845   PROCEDURE proc-full-temp-changes :
      846     define input  parameter p-hst-handle as handle    no-undo .
      847     define input  parameter p-main-table as character no-undo .
      848     define input  parameter p-field-list as character no-undo .
      849     define input  parameter p-label-form as character no-undo .
      850     define variable h-new-buf         as handle    no-undo .
      851     define variable h-main-buf        as handle    no-undo .
      852     define variable h-for-comp        as handle    no-undo .
      853     define variable v-inform          as character no-undo .
      854     define variable v-ind             as integer   no-undo .
      855     define variable v-idx-field-qnty  as integer   no-undo .
      856     define variable v-num-entries     as integer   no-undo .
      857     define variable fh                as handle    no-undo .
      858     define variable fh-main           as handle    no-undo .
      859     define variable fh-old            as handle    no-undo .
      860     define variable fh-new            as handle    no-undo .
      861     define variable v-field-name      as character no-undo .
      862     define variable v-field-lvl       as character no-undo .
      863     define variable v-field-form      as character no-undo .
      864     define variable v-search-exp      as character no-undo .
      865     define variable v-srch-main       as character no-undo .
      866     define variable v-word-link       as character no-undo .
      867     define variable v-av-chip-num     as logical   no-undo .
      868     define variable v-main-pi-fld-lst as character no-undo .
      869     define variable v-main-fld-lst    as character no-undo .
      870     define variable v-delim-list      as character no-undo .
      871     define variable v-label           as character no-undo .
      872     define variable v-old-value       as character no-undo case-sensitive.
      873     define variable v-new-value       as character no-undo case-sensitive.
      874     define variable v-chg-fields as character no-undo.
      875     for each temp-changes:
      876       delete temp-changes.
      877     end.
      878     if not p-hst-handle:available then do:
      879       return .
      880     end.
      881     create buffer h-new-buf  for table p-hst-handle .
      882     create buffer h-main-buf for table p-main-table .
      883     assign
      884       v-inform = h-main-buf:index-information(1)
      885       v-ind    = 2
      886     .
      887     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      888     on error undo, return error
      889     :
      890       assign
      891         v-inform = h-main-buf:index-information( v-ind )
      892         v-ind    = v-ind + 1
      893       .
      894     end.
      895     if v-inform = ?
      896       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      897       or entry( 3, v-inform, ",":U ) <> "1":U
      898     then do:
      899       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      900     end.
      901     assign
      902       v-idx-field-qnty = num-entries( v-inform ) - 4
      903     .
      904     if v-idx-field-qnty < 2 then do:
      905       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      906     end.
      907     assign
      908       v-srch-main   = "where":U
      909       v-word-link   = "":U
      910       v-av-chip-num = false
      911       v-delim-list  = "":U
      912     .
      913     do v-ind = 1 to v-idx-field-qnty by 2
      914     on error undo, return error
      915     :
      916       assign
      917         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      918         fh                = p-hst-handle:buffer-field( v-field-name )
      919         fh-main           = h-main-buf:buffer-field( v-field-name )
      920         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      921         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      922       .
      923       if fh:data-type ="character":U then do:
      924         assign
      925           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      926         .
      927       end.
      928       else do:
      929         assign
      930           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      931         .
      932       end.
      933       if v-delim-list = "":U then do:
      934         assign
      935           v-delim-list = ",":U
      936         .
      937       end.
      938       if v-word-link = "":U then do:
      939         assign
      940           v-word-link = "and":U
      941         .
      942       end.
      943     end.
      944     assign
      945       v-delim-list  = "":U
      946     .
      947     do v-ind = 1 to h-main-buf:num-fields
      948     on error undo, return error
      949     :
      950       assign
      951         fh-main      = h-main-buf:buffer-field( v-ind )
      952         v-field-name = fh-main:name
      953       .
      954         assign
      955           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      956         .
      957         if v-delim-list = "":U then do:
      958           assign
      959             v-delim-list = ",":U
      960           .
      961         end.
      962     end.
      963     assign
      964       v-inform = p-hst-handle:index-information(1)
      965       v-ind    = 2
      966     .
      967     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      968     on error undo, return error
      969     :
      970       assign
      971         v-inform = p-hst-handle:index-information( v-ind )
      972         v-ind    = v-ind + 1
      973       .
      974     end.
      975     if v-inform = ?
      976       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      977       or entry( 3, v-inform, ",":U ) <> "1":U
      978     then do:
      979       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      980     end.
      981     assign
      982       v-idx-field-qnty = num-entries( v-inform ) - 4
      983     .
      984     if v-idx-field-qnty < 2 then do:
      985       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      986     end.
      987     assign
      988       v-search-exp  = "where":U
      989       v-word-link   = "":U
      990       v-av-chip-num = false
      991     .
      992     do v-ind = 1 to v-idx-field-qnty by 2
      993     on error undo, return error
      994     :
      995       assign
      996         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      997         fh           = p-hst-handle:buffer-field( v-field-name )
      998         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      999       .
     1000       if v-field-name = "chip-num":U then do:
     1001         assign
     1002           v-search-exp  = substitute( "&1 >", v-search-exp )
     1003           v-av-chip-num = true
     1004         .
     1005       end.
     1006       else do:
     1007         assign
     1008           v-search-exp = substitute( "&1 =", v-search-exp )
     1009         .
     1010       end.
     1011       if fh:data-type ="character":U then do:
     1012         assign
     1013           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1014         .
     1015       end.
     1016       else do:
     1017         assign
     1018           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1019         .
     1020       end.
     1021       if v-word-link = "":U then do:
     1022         assign
     1023           v-word-link = "and":U
     1024         .
     1025       end.
     1026     end.
     1027     if v-av-chip-num = false then do:
     1028       message
     1029         vss-workfile vss-revision vss-description skip
     1030         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1031         "Использование данной процедуры невозможно!" skip
     1032         view-as alert-box error .
     1033       return error .
     1034     end.
     1035     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1036     if not h-new-buf:available then do:
     1037       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1038       if not h-main-buf:available then do:
     1039         assign
     1040           h-for-comp = ?
     1041         .
     1042       end.
     1043       else do:
     1044         assign
     1045           h-for-comp = h-main-buf
     1046         .
     1047       end.
     1048     end.
     1049     else do:
     1050       assign
     1051         h-for-comp = h-new-buf
     1052       .
     1053     end.
     1054     assign
     1055       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1056     .
     1057     do v-ind = 1 to v-num-entries
     1058     on error undo, return error return-value
     1059     :
     1060       assign
     1061         v-field-name = entry( v-ind, v-main-fld-lst )
     1062         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1063         v-old-value  = fh-old:buffer-value()
     1064         v-label      = trim( fh-old:label )
     1065       .
     1066       if ( trim( p-field-list ) <> "":U
     1067            and lookup( v-field-name, p-field-list ) > 0
     1068          )
     1069          or trim( p-field-list ) = "":U
     1070       then do:
     1071         if h-for-comp <> ? then do:
     1072           assign
     1073             fh-new      = h-for-comp:buffer-field( v-field-name )
     1074             v-new-value = fh-new:buffer-value()
     1075           .
     1076         end.
     1077         else do:
     1078           assign
     1079             v-new-value = "":U
     1080           .
     1081         end.
     1082         if v-old-value <> v-new-value
     1083         then do:
     1084           create temp-changes.
     1085           assign
     1086             temp-changes.t_name = p-main-table
     1087             temp-changes.f_name = v-field-name
     1088             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1089             temp-changes.v_old  = trim( v-old-value )
     1090             temp-changes.v_new  = trim( v-new-value )
     1091             temp-changes.num_   = 0
     1092             temp-changes.fNotChange = v-old-value eq v-new-value
     1093           .
     1094         end.
     1095       end.
     1096     end.
     1097     assign
     1098       v-num-entries = num-entries( p-label-form, chr(8) )
     1099     .
     1100     do v-ind = 1 to v-num-entries
     1101     on error undo, return error return-value
     1102     :
     1103       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1104         assign
     1105           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1106           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1107           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1108         .
     1109         find first temp-changes
     1110           where temp-changes.f_name = v-field-name
     1111           no-error .
     1112         if available temp-changes then do:
     1113           if trim( v-field-lvl ) <> "":U then do:
     1114             assign
     1115               temp-changes.l_name = v-field-lvl
     1116             .
     1117           end.
     1118           if trim( v-field-form ) <> "":U then do:
     1119             assign
     1120               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1121             .
     1122             if h-for-comp <> ? then do:
     1123               assign
     1124                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1125               .
     1126             end.
     1127           end.
     1128         end.
     1129       end.
     1130       else do:
     1131         message
     1132           vss-workfile vss-revision vss-description skip
     1133           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1134           substitute( "список для поля '&1': '&2'"
     1135                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1136                       ,entry( v-ind, p-label-form, chr(8) )
     1137                     ) skip
     1138           substitute( "полный список: &2", p-label-form ) skip
     1139           view-as alert-box error .
     1140       end.
     1141     end.
     1142     delete object h-new-buf .
     1143     delete object h-main-buf .
     1144   END PROCEDURE.
     1145   FUNCTION get-subject RETURNS CHARACTER
     1146       ( p-subject as character )  FORWARD.
     1147   FUNCTION mark-string RETURNS CHARACTER
     1148     ( BUFFER loc-c-gds-obj-prop FOR c-gds-obj-prop, input mark-list as character )  FORWARD.
     1149   DEFINE BUTTON B-Help
     1150        LABEL "Помо&щь"
     1151        SIZE 3 BY 1
     1152        BGCOLOR 8 .
     1153   DEFINE BUTTON B-lookup
     1154        LABEL "&Просмотр"
     1155        SIZE 10 BY 1.
     1156   DEFINE BUTTON B-mark
     1157        LABEL "&*"
     1158        SIZE 3 BY 1.
     1159   DEFINE BUTTON b-quit AUTO-END-KEY
     1160        LABEL "&Выход"
     1161        SIZE 10 BY 1
     1162        BGCOLOR 8 .
     1163   DEFINE BUTTON B-sel
     1164        LABEL "Вы&бор"
     1165        SIZE 10 BY 1.
     1166   DEFINE QUERY BR-changes FOR
     1167         temp-changes SCROLLING.
     1168   DEFINE QUERY br-gdsind FOR
     1169         X_c-gds-hist SCROLLING.
     1170   DEFINE BROWSE BR-changes
     1171     QUERY BR-changes DISPLAY
     1172         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(255)" WIDTH 45
     1173   temp-changes.v_old COLUMn-LABEL "Было" format "X(255)" WIDTH 45
     1174   temp-changes.v_new COLUMn-LABEL "Стало" format "X(255)" WIDTH 45
     1175       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.53
     1176            TITLE?.
     1177   DEFINE BROWSE br-gdsind
     1178     QUERY br-gdsind NO-LOCK DISPLAY
     1179         get-subject(X_c-gds-hist.subject) COLUMN-LABEL "Предмет изменений" FORMAT "X(45)":U
     1180     x_c-gds-hist.corr-date COLUMN-LABEL "Дата !изменения" FORMAT "99/99/99":U
     1181           WIDTH 11
     1182     string(X_c-gds-hist.corr-time, "HH:MM") COLUMN-LABEL "Время!измен" FORMAT "X(5)":U
     1183     x_c-gds-hist.corr-user-db-num COLUMN-LABEL "БД!изм" FORMAT ">>>>9":U
     1184           WIDTH 3
     1185     usrfulnf(x_c-gds-hist.corr-user-name) COLUMN-LABEL "Кто!изменил" FORMAT "X(8)":U
     1186       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 10 ROW-HEIGHT-CHARS .75 FIT-LAST-COLUMN.
     1187   DEFINE FRAME Dialog-Frame
     1188        b-quit AT ROW 1 COL 1
     1189        B-mark AT ROW 1 COL 11
     1190        B-sel AT ROW 1 COL 14
     1191        B-lookup AT ROW 1 COL 35.5
     1192        B-Help AT ROW 1 COL 95
     1193        br-gdsind AT ROW 2.27 COL 1
     1194        BR-changes AT ROW 12.5 COL 1
     1195        SPACE(0.12) SKIP(0.01)
     1196       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1197            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1198            TITLE "История индикаторов товаров на объекте"
     1199            CANCEL-BUTTON b-quit.
     1200   ASSIGN
     1201          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1202          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1203   ASSIGN
     1204          B-lookup:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1205   ASSIGN
     1206          B-mark:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1207   ASSIGN
     1208          B-sel:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1209   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1210   DO:
     1211     APPLY "END-ERROR":U TO SELF.
     1212   END.
     1213   ON RETURN OF br-gdsind IN FRAME Dialog-Frame
     1214   or MOUSE-SELECT-DBLCLICK OF br-gdsind IN FRAME Dialog-Frame
     1215       DO:
     1216       run proc-br-gdsind no-error.
     1217     if error-status:error then return no-apply.
     1218   END.
     1219   ON VALUE-CHANGED OF br-gdsind IN FRAME Dialog-Frame
     1220   DO:
     1221     run proc-view-changes in this-procedure no-error.
     1222   END.
     1223   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1224   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1225   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1226   on help of frame Dialog-Frame
     1227   do:
     1228     run gbl/app_help.p
     1229       (input this-procedure :file-name
     1230       ,input ''
     1231       ,input ?
     1232       ) no-error.
     1233     if error-status :error then do:
     1234       message
     1235         "Ошибка при вызове помощи"
     1236         error-status :get-message(1)
     1237         view-as alert-box .
     1238     end.
     1239   end.
     1240   run minbtn-set in this-procedure .
     1241   on choose of b-help in frame Dialog-Frame
     1242   do:
     1243     apply "help":u to frame Dialog-Frame .
     1244   end.
     1245   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1246   procedure minbtn-set :
     1247       do
     1248           on error undo, return error return-value
     1249           :
     1250           define variable ii              as integer       no-undo .
     1251           define variable fh              as widget-handle no-undo .
     1252           define variable hh              as widget-handle no-undo .
     1253           define variable v-h             as handle        extent 4 no-undo .
     1254           define variable v-name-button   as character     no-undo .
     1255           define variable v-help-old-x    as decimal       no-undo .
     1256           define variable v-help-old-y    as decimal       no-undo .
     1257           define variable v-help-old-size as decimal       no-undo .
     1258           define variable v-frame-width   as decimal       no-undo .
     1259           define variable jj              as integer       no-undo .
     1260           do
     1261               on error undo, return error
     1262               :
     1263               assign
     1264                   v-frame-width = frame Dialog-Frame:width - 0.3
     1265                   fh            = frame Dialog-Frame:first-child
     1266                   hh            = fh:first-child
     1267                   ii            = 1
     1268                   .
     1269               do while valid-handle(hh):
     1270                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1271                   do:
     1272                       case lc(hh:name) :
     1273                           when "b-help" then
     1274                               do:
     1275                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1276                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1277                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1278                                   hh:TOOLTIP = "Помощь" .
     1279                                   v-help-old-x = hh:column .
     1280                                   v-help-old-y = hh:row    .
     1281                                   v-help-old-size = hh:width .
     1282                                   hh:width-chars = 2.5 .
     1283                               end.
     1284                           when "b-print" then
     1285                               do:
     1286                                   hh:load-image("cmp/b-print.bmp":u) .
     1287                                   hh:TOOLTIP = "Печать" .
     1288                                   v-h[ii] = hh:handle .
     1289                                   ii = ii + 1 .
     1290                                   hh:width-chars = 3 .
     1291                               end.
     1292                           when "b-history" or
     1293                           when "b-hist" then
     1294                               do:
     1295                                   hh:load-image("cmp/b-hist.bmp":u) .
     1296                                   hh:TOOLTIP = "История" .
     1297                                   v-h[ii] = hh:handle .
     1298                                   ii = ii + 1 .
     1299                                   hh:width-chars = 3 .
     1300                               end.
     1301                           when "b-sch" then
     1302                               do:
     1303                                   hh:load-image("cmp/b-sch.bmp":u) .
     1304                                   hh:TOOLTIP = "Установка Фильтра" .
     1305                                   v-h[ii] = hh:handle .
     1306                                   ii = ii + 1 .
     1307                                   hh:width-chars = 3 .
     1308                               end.
     1309                           when "b-hist-user" then
     1310                               do:
     1311                                   hh:load-image("cmp/b-hist.bmp":u) .
     1312                                   hh:TOOLTIP = "История пользователя" .
     1313                                   ii = ii + 1 .
     1314                               end.
     1315                       end case.
     1316                   end.
     1317                   hh = hh:next-sibling.
     1318               end.
     1319               b-help:column = v-frame-width - b-help:width-chars.
     1320               jj = 0.
     1321               repeat ii = 4 to 1 by -1 :
     1322                   if valid-handle (v-h[ii] ) then
     1323                   do:
     1324                       jj  = jj + 1 .
     1325                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1326                       v-h[ii]:row    = v-help-old-y .
     1327                   end.
     1328               end.
     1329           end.
     1330       end.
     1331   end procedure.
     1332   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1333   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1334   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1335   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1336   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1337   define variable v-diasize-current-frame-height as decimal   no-undo .
     1338   define variable v-diasize-change-size          as logical   no-undo .
     1339   define variable v-diasize-resize-button        as handle    no-undo .
     1340   define variable v-diasize-wndmax               as logical   no-undo .
     1341   define variable v-diasize-wndstore             as logical   no-undo .
     1342   define variable v-diasize-proc-name            as character no-undo .
     1343   define variable v-diasize-browse-handle        as handle    no-undo .
     1344   define variable v-diasize-browse-number        as integer   no-undo .
     1345   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1346   define temp-table temp-diasize-handle no-undo
     1347     field handle-value  as handle
     1348     field save-position as decimal
     1349     index xpk is primary unique handle-value
     1350     .
     1351   define temp-table temp-browse-handle no-undo
     1352     field browse-type   as character
     1353     field browse-number as integer
     1354     field browse-handle as handle
     1355     field original-size as decimal
     1356     index xpk is primary unique browse-type browse-number
     1357     index xie browse-type browse-handle
     1358   .
     1359   procedure diasize_change-height :
     1360     define input  parameter p-change-value  as decimal   no-undo .
     1361     define input  parameter p-move-resize   as logical   no-undo .
     1362     define variable v-field-group-handle    as handle    no-undo .
     1363     define variable v-object-handle         as handle    no-undo .
     1364     define variable v-frame-height          as decimal   no-undo .
     1365     define variable v-frame-virtual-height  as decimal   no-undo .
     1366     define variable v-browse-height         as decimal   no-undo .
     1367     define variable v-window-height         as decimal   no-undo .
     1368     define variable v-window-virtual-height as decimal   no-undo .
     1369     define variable v-change-sign           as integer   no-undo .
     1370     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1371     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1372     if p-change-value > 0
     1373     then do:
     1374       if frame Dialog-Frame :height + p-change-value
     1375           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1376       then do:
     1377         assign
     1378           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1379                           - (frame Dialog-Frame :height-chars)
     1380         .
     1381         if p-change-value <= 0
     1382         then do:
     1383           run diasize_position-resize-button in this-procedure .
     1384           return .
     1385         end.
     1386       end.
     1387     end.
     1388     if p-change-value < 0
     1389     then do:
     1390       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1391       then do:
     1392         assign
     1393           p-change-value = v-diasize-orig-frame-height
     1394                          - (frame Dialog-Frame :height-chars)
     1395         .
     1396         if p-change-value >= 0
     1397         then do:
     1398           run diasize_position-resize-button in this-procedure .
     1399           return .
     1400         end.
     1401       end.
     1402     end.
     1403     if p-change-value >= 0
     1404     then do:
     1405       assign
     1406         v-change-sign = 1
     1407       .
     1408     end.
     1409     else do:
     1410       assign
     1411         v-change-sign = -1
     1412       .
     1413     end.
     1414     assign
     1415       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1416     .
     1417     if p-change-value = 0
     1418     then do:
     1419       run diasize_position-resize-button in this-procedure .
     1420       return .
     1421     end.
     1422     move_block:
     1423     do
     1424     on error undo move_block, retry move_block
     1425     :
     1426       if retry
     1427       then do:
     1428         do
     1429         on error undo move_block, leave move_block
     1430         :
     1431           if p-change-value > 0
     1432           then do:
     1433             for each buf_temp-diasize-handle
     1434             on error undo, next
     1435             :
     1436               assign
     1437                 v-object-handle = buf_temp-diasize-handle.handle-value
     1438               .
     1439               if v-object-handle <> v-diasize-resize-button
     1440               then do:
     1441                 assign
     1442                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1443                 .
     1444               end.
     1445             end.
     1446             assign
     1447               v-diasize-browse-handle :height = v-browse-height
     1448             .
     1449             for each buf_temp-browse-handle
     1450               where buf_temp-browse-handle.browse-type = 'height':u
     1451             on error undo, next
     1452             :
     1453               assign
     1454                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1455               .
     1456             end.
     1457             assign
     1458               frame Dialog-Frame :height = v-frame-height
     1459             .
     1460             if frame Dialog-Frame :scrollable = true
     1461             then do:
     1462               assign
     1463                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1464               .
     1465             end.
     1466             run diasize_position-resize-button in this-procedure .
     1467           end.
     1468           else do:
     1469             if frame Dialog-Frame :scrollable = true
     1470             then do:
     1471               assign
     1472                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1473               .
     1474             end.
     1475             assign
     1476               frame Dialog-Frame :height = v-frame-height
     1477             .
     1478             assign
     1479               v-diasize-browse-handle :height = v-browse-height
     1480             .
     1481             for each buf_temp-browse-handle
     1482               where buf_temp-browse-handle.browse-type = 'height':u
     1483             on error undo, next
     1484             :
     1485               assign
     1486                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1487               .
     1488             end.
     1489             for each buf_temp-diasize-handle
     1490             on error undo, next
     1491             :
     1492               assign
     1493                 v-object-handle = buf_temp-diasize-handle.handle-value
     1494               .
     1495               if v-object-handle <> v-diasize-resize-button
     1496               then do:
     1497                 assign
     1498                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1499                 .
     1500               end.
     1501             end.
     1502             run diasize_position-resize-button in this-procedure .
     1503           end.
     1504           assign
     1505             v-diasize-change-size = false
     1506           .
     1507           leave move_block .
     1508         end.
     1509       end.
     1510       assign
     1511         v-diasize-need-full-display = true
     1512       .
     1513       if v-diasize-change-size = false
     1514       then do:
     1515         assign
     1516           v-diasize-change-size = true
     1517         .
     1518       end.
     1519       else do:
     1520         return .
     1521       end.
     1522       assign
     1523         v-frame-height = frame Dialog-Frame :height
     1524         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1525         v-browse-height = v-diasize-browse-handle :height
     1526       .
     1527       for each buf_temp-browse-handle
     1528         where buf_temp-browse-handle.browse-type = 'height':u
     1529       :
     1530         assign
     1531           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1532         .
     1533       end.
     1534       for each buf_temp-diasize-handle
     1535       :
     1536         delete buf_temp-diasize-handle .
     1537       end.
     1538       assign
     1539         v-field-group-handle = frame Dialog-Frame :first-child
     1540       .
     1541       do while valid-handle(v-field-group-handle)
     1542       :
     1543         assign
     1544           v-object-handle = v-field-group-handle :first-child
     1545         .
     1546         do while valid-handle(v-object-handle)
     1547         :
     1548           if  v-object-handle <> v-diasize-browse-handle :handle
     1549           and can-query(v-object-handle, "row")
     1550           and can-query(v-object-handle, "height")
     1551           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1552           then do:
     1553             find first buf_temp-browse-handle
     1554               where buf_temp-browse-handle.browse-type   = 'height':u
     1555                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1556               no-error .
     1557             if available buf_temp-browse-handle
     1558             then do:
     1559             end.
     1560             else do:
     1561               create buf_temp-diasize-handle .
     1562               assign
     1563                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1564                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1565               .
     1566             end.
     1567           end.
     1568           assign
     1569             v-object-handle = v-object-handle :next-sibling
     1570           .
     1571         end.
     1572         assign
     1573           v-field-group-handle = v-field-group-handle :next-sibling
     1574         .
     1575       end.
     1576       do with frame Dialog-Frame
     1577       :
     1578         hide v-diasize-resize-button .
     1579         assign
     1580           v-diasize-resize-button :row    = 1
     1581           v-diasize-resize-button :column = 1
     1582         .
     1583       end.
     1584       if p-change-value > 0
     1585       then do:
     1586         if frame Dialog-Frame :scrollable = true
     1587         then do:
     1588           assign
     1589             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1590             no-error .
     1591           if error-status :error
     1592           or error-status :get-message(1) <> ""
     1593           then do:
     1594             undo move_block, retry move_block .
     1595           end.
     1596         end.
     1597         assign
     1598           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1599           no-error .
     1600         if error-status :error
     1601         or error-status :get-message(1) <> ""
     1602         then do:
     1603           undo move_block, retry move_block .
     1604         end.
     1605         assign
     1606           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1607           no-error .
     1608         if error-status :error
     1609         or error-status :get-message(1) <> ""
     1610         then do:
     1611           undo move_block, retry move_block .
     1612         end.
     1613         for each buf_temp-browse-handle
     1614           where buf_temp-browse-handle.browse-type = 'height':u
     1615         on error undo move_block, retry move_block
     1616         :
     1617           assign
     1618             buf_temp-browse-handle.browse-handle :height
     1619               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1620             no-error .
     1621           if error-status :error
     1622           or error-status :get-message(1) <> ""
     1623           then do:
     1624             undo move_block, retry move_block .
     1625           end.
     1626         end.
     1627         for each buf_temp-diasize-handle
     1628         on error undo move_block, retry move_block
     1629         :
     1630           assign
     1631             v-object-handle = buf_temp-diasize-handle.handle-value
     1632           .
     1633           if v-object-handle <> v-diasize-resize-button
     1634           then do:
     1635             assign
     1636               v-object-handle :row = v-object-handle :row + p-change-value
     1637               no-error .
     1638             if error-status :error
     1639             or error-status :get-message(1) <> ""
     1640             then do:
     1641               undo move_block, retry move_block .
     1642             end.
     1643           end.
     1644         end.
     1645       end.
     1646       else do:
     1647         for each buf_temp-diasize-handle
     1648         on error undo move_block, retry move_block
     1649         :
     1650           assign
     1651             v-object-handle = buf_temp-diasize-handle.handle-value
     1652           .
     1653           if v-object-handle <> v-diasize-resize-button
     1654           then do:
     1655             assign
     1656               v-object-handle :row = v-object-handle :row + p-change-value
     1657               no-error .
     1658             if error-status :error
     1659             or error-status :get-message(1) <> ""
     1660             then do:
     1661               undo move_block, retry move_block .
     1662             end.
     1663           end.
     1664         end.
     1665         assign
     1666           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1667           no-error .
     1668         if error-status :error
     1669         or error-status :get-message(1) <> ""
     1670         then do:
     1671           undo move_block, retry move_block .
     1672         end.
     1673         for each buf_temp-browse-handle
     1674           where buf_temp-browse-handle.browse-type = 'height':u
     1675         on error undo move_block, retry move_block
     1676         :
     1677           assign
     1678             buf_temp-browse-handle.browse-handle :height
     1679               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1680             no-error .
     1681           if error-status :error
     1682           or error-status :get-message(1) <> ""
     1683           then do:
     1684             undo move_block, retry move_block .
     1685           end.
     1686         end.
     1687         assign
     1688           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1689           no-error .
     1690         if error-status :error
     1691         or error-status :get-message(1) <> ""
     1692         then do:
     1693           undo move_block, retry move_block .
     1694         end.
     1695         if frame Dialog-Frame :scrollable = true
     1696         then do:
     1697           assign
     1698             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1699             no-error .
     1700           if error-status :error
     1701           or error-status :get-message(1) <> ""
     1702           then do:
     1703             undo move_block, retry move_block .
     1704           end.
     1705         end.
     1706       end.
     1707       if p-move-resize = true
     1708       then do:
     1709         run diasize_position-resize-button in this-procedure .
     1710       end.
     1711       if v-diasize-wndstore = true
     1712       then do:
     1713         if connected("ub") = true
     1714         then do:
     1715           define variable v-cntxt-db-num        as integer   no-undo .
     1716           define variable v-cntxt-userid        as character no-undo .
     1717           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1718                                             , OUTPUT v-cntxt-userid
     1719                                             ) .
     1720           run gbl/wndsizew.p
     1721             (input  v-cntxt-db-num
     1722             ,input  v-cntxt-userid
     1723             ,input  v-diasize-proc-name
     1724             ,input  'height':u
     1725             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1726             ) .
     1727         end.
     1728       end.
     1729     end.
     1730     assign
     1731       v-diasize-change-size = false
     1732     .
     1733   end procedure.
     1734   procedure diasize_set-height :
     1735     define input  parameter p-new-height  as decimal   no-undo .
     1736     define input  parameter p-move-resize as logical   no-undo .
     1737     do
     1738     on error undo, return error return-value
     1739     :
     1740       run diasize_change-height in this-procedure
     1741         (input  (p-new-height - frame Dialog-Frame :height)
     1742         ,input  p-move-resize
     1743         ) .
     1744     end.
     1745   end procedure.
     1746   procedure diasize_change-width :
     1747     define input  parameter p-change-value as decimal   no-undo .
     1748     define input  parameter p-move-resize  as logical   no-undo .
     1749     define variable v-field-group-handle   as handle    no-undo .
     1750     define variable v-object-handle        as handle    no-undo .
     1751     define variable v-frame-width          as decimal   no-undo .
     1752     define variable v-frame-virtual-width  as decimal   no-undo .
     1753     define variable v-browse-width         as decimal   no-undo .
     1754     define variable v-window-width         as decimal   no-undo .
     1755     define variable v-window-virtual-width as decimal   no-undo .
     1756     define variable v-change-sign          as integer   no-undo .
     1757     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1758     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1759     if p-change-value > 0
     1760     then do:
     1761       if frame Dialog-Frame :width + p-change-value >
     1762           session :width-chars
     1763       then do:
     1764         assign
     1765           p-change-value = session :width-chars - frame Dialog-Frame :width
     1766         .
     1767         if p-change-value <= 0
     1768         then do:
     1769           run diasize_position-resize-button in this-procedure .
     1770           return .
     1771         end.
     1772       end.
     1773     end.
     1774     if p-change-value < 0
     1775     then do:
     1776       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1777       then do:
     1778         assign
     1779           p-change-value = v-diasize-orig-frame-width
     1780                          - frame Dialog-Frame :width
     1781         .
     1782         if p-change-value >= 0
     1783         then do:
     1784           run diasize_position-resize-button in this-procedure .
     1785           return .
     1786         end.
     1787       end.
     1788     end.
     1789     if p-change-value >= 0
     1790     then do:
     1791       assign
     1792         v-change-sign = 1
     1793       .
     1794     end.
     1795     else do:
     1796       assign
     1797         v-change-sign = -1
     1798       .
     1799     end.
     1800     assign
     1801       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1802     .
     1803     if p-change-value = 0
     1804     then do:
     1805       run diasize_position-resize-button in this-procedure .
     1806       return .
     1807     end.
     1808     move_block:
     1809     do
     1810     on error undo move_block, leave move_block
     1811     :
     1812       if retry
     1813       then do:
     1814         do
     1815         on error undo move_block, leave move_block
     1816         :
     1817           if p-change-value > 0
     1818           then do:
     1819             for each buf_temp-diasize-handle
     1820             on error undo, next
     1821             :
     1822               assign
     1823                 v-object-handle = buf_temp-diasize-handle.handle-value
     1824               .
     1825               if v-object-handle <> v-diasize-resize-button
     1826               then do:
     1827                 assign
     1828                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1829                 .
     1830               end.
     1831             end.
     1832             assign
     1833               v-diasize-browse-handle :width = v-browse-width
     1834             .
     1835             for each buf_temp-browse-handle
     1836               where buf_temp-browse-handle.browse-type = 'width':u
     1837             on error undo, next
     1838             :
     1839               assign
     1840                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1841               .
     1842             end.
     1843             assign
     1844               frame Dialog-Frame :width = v-frame-width
     1845             .
     1846             if frame Dialog-Frame :scrollable = true
     1847             then do:
     1848               assign
     1849                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1850               .
     1851             end.
     1852             run diasize_position-resize-button in this-procedure .
     1853           end.
     1854           else do:
     1855             if frame Dialog-Frame :scrollable = true
     1856             then do:
     1857               assign
     1858                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1859               .
     1860             end.
     1861             assign
     1862               frame Dialog-Frame :width = v-frame-width
     1863             .
     1864             for each buf_temp-browse-handle
     1865               where buf_temp-browse-handle.browse-type = 'width':u
     1866             on error undo, next
     1867             :
     1868               assign
     1869                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1870               .
     1871             end.
     1872             assign
     1873               v-diasize-browse-handle :width = v-browse-width
     1874             .
     1875             for each buf_temp-diasize-handle
     1876             on error undo, next
     1877             :
     1878               assign
     1879                 v-object-handle = buf_temp-diasize-handle.handle-value
     1880               .
     1881               if v-object-handle <> v-diasize-resize-button
     1882               then do:
     1883                 assign
     1884                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1885                 .
     1886               end.
     1887             end.
     1888             run diasize_position-resize-button in this-procedure .
     1889           end.
     1890           assign
     1891             v-diasize-change-size = false
     1892           .
     1893           leave move_block .
     1894         end.
     1895       end.
     1896       assign
     1897         v-diasize-need-full-display = true
     1898       .
     1899       if v-diasize-change-size = false
     1900       then do:
     1901         assign
     1902           v-diasize-change-size = true
     1903         .
     1904       end.
     1905       else do:
     1906         return .
     1907       end.
     1908       assign
     1909         v-frame-width = frame Dialog-Frame :width
     1910         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1911         v-browse-width = v-diasize-browse-handle :width
     1912       .
     1913       for each buf_temp-browse-handle
     1914         where buf_temp-browse-handle.browse-type = 'width':u
     1915       :
     1916         assign
     1917           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1918         .
     1919       end.
     1920       for each buf_temp-diasize-handle
     1921       :
     1922         delete buf_temp-diasize-handle .
     1923       end.
     1924       assign
     1925         v-field-group-handle = frame Dialog-Frame :first-child
     1926       .
     1927       do while valid-handle(v-field-group-handle)
     1928       :
     1929         assign
     1930           v-object-handle = v-field-group-handle :first-child
     1931         .
     1932         do while valid-handle(v-object-handle)
     1933         :
     1934           if  v-object-handle <> v-diasize-browse-handle :handle
     1935           and v-object-handle <> v-diasize-resize-button
     1936           and can-query(v-object-handle, "row")
     1937           and can-query(v-object-handle, "height")
     1938           and ( v-object-handle :col + v-object-handle :width
     1939                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1940               )
     1941           then do:
     1942             find first buf_temp-browse-handle
     1943               where buf_temp-browse-handle.browse-type   = 'width':u
     1944                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1945               no-error .
     1946             if available buf_temp-browse-handle
     1947             then do:
     1948             end.
     1949             else do:
     1950               create buf_temp-diasize-handle .
     1951               assign
     1952                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1953                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1954               .
     1955             end.
     1956           end.
     1957           assign
     1958             v-object-handle = v-object-handle :next-sibling
     1959           .
     1960         end.
     1961         assign
     1962           v-field-group-handle = v-field-group-handle :next-sibling
     1963         .
     1964       end.
     1965       do with frame Dialog-Frame
     1966       :
     1967         hide v-diasize-resize-button .
     1968         v-diasize-resize-button :row = 1.
     1969         v-diasize-resize-button :column = 1.
     1970       end.
     1971       if p-change-value > 0
     1972       then do:
     1973         if frame Dialog-Frame :scrollable = true
     1974         then do:
     1975           assign
     1976             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1977             no-error .
     1978           if error-status :error
     1979           or error-status :get-message(1) <> ""
     1980           then do:
     1981             undo move_block, retry move_block.
     1982           end.
     1983         end.
     1984         assign
     1985           frame Dialog-Frame :width = v-frame-width + p-change-value
     1986           no-error .
     1987         if error-status :error
     1988         or error-status :get-message(1) <> ""
     1989         then do:
     1990           undo move_block, retry move_block.
     1991         end.
     1992         assign
     1993           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1994         no-error .
     1995         if error-status :error
     1996         or error-status :get-message(1) <> ""
     1997         then do:
     1998           undo move_block, retry move_block.
     1999         end.
     2000         for each buf_temp-browse-handle
     2001           where buf_temp-browse-handle.browse-type = 'width':u
     2002         on error undo move_block, retry move_block
     2003         :
     2004           assign
     2005             buf_temp-browse-handle.browse-handle :width
     2006               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2007             no-error .
     2008           if error-status :error
     2009           or error-status :get-message(1) <> ""
     2010           then do:
     2011             undo move_block, retry move_block .
     2012           end.
     2013         end.
     2014         for each buf_temp-diasize-handle
     2015         on error undo move_block, retry move_block
     2016         :
     2017           assign
     2018             v-object-handle = buf_temp-diasize-handle.handle-value
     2019           .
     2020           if v-object-handle <> v-diasize-resize-button
     2021           then do:
     2022             assign
     2023               v-object-handle :col = v-object-handle :col + p-change-value
     2024               no-error .
     2025             if error-status :error
     2026             or error-status :get-message(1) <> ""
     2027             then do:
     2028               undo move_block, retry move_block .
     2029             end.
     2030           end.
     2031         end.
     2032       end.
     2033       else do:
     2034         for each buf_temp-diasize-handle
     2035         on error undo move_block, retry move_block
     2036         :
     2037           assign
     2038             v-object-handle = buf_temp-diasize-handle.handle-value
     2039           .
     2040           if v-object-handle <> v-diasize-resize-button
     2041           then do:
     2042             assign
     2043               v-object-handle :col = v-object-handle :col + p-change-value
     2044               no-error .
     2045             if error-status :error
     2046             or error-status :get-message(1) <> ""
     2047             then do:
     2048               undo move_block, retry move_block .
     2049             end.
     2050           end.
     2051         end.
     2052         for each buf_temp-browse-handle
     2053           where buf_temp-browse-handle.browse-type = 'width':u
     2054         on error undo move_block, retry move_block
     2055         :
     2056           assign
     2057             buf_temp-browse-handle.browse-handle :width
     2058               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2059             no-error .
     2060           if error-status :error
     2061           or error-status :get-message(1) <> ""
     2062           then do:
     2063             undo move_block, retry move_block .
     2064           end.
     2065         end.
     2066         assign
     2067           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2068           no-error .
     2069         if error-status :error
     2070         or error-status :get-message(1) <> ""
     2071         then do:
     2072           undo move_block, retry move_block.
     2073         end.
     2074         assign
     2075           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2076         no-error .
     2077         if error-status :error
     2078         or error-status :get-message(1) <> ""
     2079         then do:
     2080           undo move_block, retry move_block.
     2081         end.
     2082         if frame Dialog-Frame :scrollable = true
     2083         then do:
     2084           assign
     2085             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2086           no-error .
     2087           if error-status :error
     2088           or error-status :get-message(1) <> ""
     2089           then do:
     2090             undo move_block, retry move_block.
     2091           end.
     2092         end.
     2093       end.
     2094       if p-move-resize
     2095       then do:
     2096         run diasize_position-resize-button in this-procedure .
     2097       end.
     2098       if v-diasize-wndstore = true
     2099       then do:
     2100         if connected("ub") = true
     2101         then do:
     2102           define variable v-cntxt-db-num        as integer   no-undo .
     2103           define variable v-cntxt-userid        as character no-undo .
     2104           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2105                                             , OUTPUT v-cntxt-userid
     2106                                             ) .
     2107           run gbl/wndsizew.p
     2108             (input  v-cntxt-db-num
     2109             ,input  v-cntxt-userid
     2110             ,input  v-diasize-proc-name
     2111             ,input  'width':u
     2112             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2113             ) .
     2114         end.
     2115       end.
     2116     end.
     2117     assign
     2118       v-diasize-change-size = false
     2119     .
     2120   end procedure.
     2121   procedure diasize_set-width :
     2122     define input  parameter p-new-width  as decimal   no-undo .
     2123     define input  parameter p-move-resize as logical   no-undo .
     2124     do
     2125     on error undo, return error return-value
     2126     :
     2127       run diasize_change-width in this-procedure
     2128         (input  (p-new-width - frame Dialog-Frame :width)
     2129         ,input  p-move-resize
     2130         ) .
     2131     end.
     2132   end procedure.
     2133   procedure diasize_position-resize-button :
     2134     do with frame Dialog-Frame
     2135     :
     2136       hide v-diasize-resize-button .
     2137       assign
     2138         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2139                     - 1
     2140                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2141         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2142                     - 1
     2143                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2144       .
     2145       view v-diasize-resize-button .
     2146     end.
     2147   end procedure.
     2148   on alt-right anywhere
     2149   do:
     2150     run diasize_change-width in this-procedure
     2151       (input 1
     2152       ,input true
     2153       ) .
     2154     return no-apply .
     2155   end.
     2156   on alt-left anywhere
     2157   do:
     2158     run diasize_change-width in this-procedure
     2159       (input -1
     2160       ,input true
     2161       ) .
     2162     return no-apply .
     2163   end.
     2164   on alt-down anywhere
     2165   do:
     2166     run diasize_change-height in this-procedure
     2167       (input 1
     2168       ,input true
     2169       ) .
     2170     return no-apply .
     2171   end.
     2172   on alt-up anywhere
     2173   do:
     2174     run diasize_change-height in this-procedure
     2175       (input -1
     2176       ,input true
     2177       ) .
     2178     return no-apply .
     2179   end.
     2180   on alt-enter of frame Dialog-Frame
     2181   do:
     2182     run diasize_maximize in this-procedure
     2183       (input  ?
     2184       ).
     2185     return no-apply .
     2186   end.
     2187   procedure diasize_end-move :
     2188     do
     2189     on error undo, return error return-value
     2190     :
     2191       define variable v-row-delta as decimal   no-undo .
     2192       define variable v-col-delta as decimal   no-undo .
     2193       define variable v-new-row as decimal   no-undo .
     2194       define variable v-new-col as decimal   no-undo .
     2195       assign
     2196         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2197         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2198       .
     2199       assign
     2200         v-row-delta = v-new-row - frame Dialog-Frame :height
     2201         v-col-delta = v-new-col - frame Dialog-Frame :width
     2202       .
     2203       run diasize_change-height in this-procedure
     2204         (input v-row-delta
     2205         ,input true
     2206         ) .
     2207       run diasize_change-width in this-procedure
     2208         (input v-col-delta
     2209         ,input true
     2210         ) .
     2211     end.
     2212   end procedure.
     2213   procedure diasize_maximize :
     2214     define input  parameter p-action as logical   no-undo .
     2215     do
     2216     on error undo, return error return-value
     2217     :
     2218       if p-action = ?
     2219       then do:
     2220         if v-diasize-need-maximize = true
     2221         then do:
     2222           assign
     2223             p-action = true
     2224           .
     2225         end.
     2226         else do:
     2227           assign
     2228             p-action = false
     2229           .
     2230         end.
     2231       end.
     2232       if p-action = true
     2233       then do:
     2234         run diasize_change-height in this-procedure
     2235           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2236               - frame Dialog-Frame :height-chars
     2237           ,input true
     2238           ) .
     2239         run diasize_change-width in this-procedure
     2240           (input session :width-chars
     2241               - frame Dialog-Frame :width-chars
     2242           ,input true
     2243           ) .
     2244         assign
     2245           v-diasize-need-maximize = false
     2246         .
     2247       end.
     2248       else do:
     2249         run diasize_change-width in this-procedure
     2250           (input v-diasize-orig-frame-width
     2251               - frame Dialog-Frame :width-chars
     2252           ,input true
     2253           ) .
     2254         run diasize_change-height in this-procedure
     2255           (input v-diasize-orig-frame-height
     2256               - frame Dialog-Frame :height-chars
     2257           ,input true
     2258           ) .
     2259         assign
     2260           v-diasize-need-maximize = true
     2261         .
     2262       end.
     2263     end.
     2264   end procedure.
     2265   procedure diasize_restore-orig-size :
     2266     do
     2267     on error undo, return error return-value
     2268     :
     2269       assign
     2270         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2271         v-diasize-current-frame-height = frame Dialog-Frame :height
     2272       .
     2273       run diasize_set-height in this-procedure
     2274         (input  v-diasize-orig-frame-height
     2275         ,input  true
     2276         ) .
     2277       run diasize_set-width in this-procedure
     2278         (input  v-diasize-orig-frame-width
     2279         ,input  true
     2280         ) .
     2281     end.
     2282   end procedure.
     2283   procedure diasize_restore-current-size :
     2284     do
     2285     on error undo, return error return-value
     2286     :
     2287       run diasize_set-height in this-procedure
     2288         (input  v-diasize-current-frame-height
     2289         ,input  true
     2290         ) .
     2291       run diasize_set-width in this-procedure
     2292         (input  v-diasize-current-frame-width
     2293         ,input  true
     2294         ) .
     2295     end.
     2296   end procedure.
     2297   procedure diasize_set-browse-handle :
     2298     define input  parameter p-browse-handle as handle   no-undo .
     2299     define buffer buf_temp-browse-handle for temp-browse-handle .
     2300     do
     2301     on error undo, return error return-value
     2302     :
     2303       assign
     2304         v-diasize-browse-handle = p-browse-handle
     2305       .
     2306       for each buf_temp-browse-handle
     2307       on error undo, return error return-value
     2308       :
     2309         delete buf_temp-browse-handle .
     2310       end.
     2311     end.
     2312   end procedure.
     2313   procedure diasize_add_browse :
     2314     define input  parameter p-browse-type   as character no-undo .
     2315     define input  parameter p-browse-handle as handle    no-undo .
     2316     define buffer buf_temp-browse-handle for temp-browse-handle .
     2317     do
     2318     on error undo, return error return-value
     2319     :
     2320       assign
     2321         v-diasize-browse-number = v-diasize-browse-number + 1
     2322       .
     2323       create buf_temp-browse-handle .
     2324       assign
     2325         buf_temp-browse-handle.browse-type   = p-browse-type
     2326         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2327         buf_temp-browse-handle.browse-handle = p-browse-handle
     2328       .
     2329     end.
     2330   end procedure.
     2331   procedure diasize_init :
     2332     define variable v-default-value    as logical   no-undo .
     2333     define variable v-restore-saved    as logical   no-undo .
     2334     define variable v-resize-value-str as character no-undo .
     2335     do
     2336     on error undo, return error return-value
     2337     :
     2338       do with frame Dialog-Frame
     2339       :
     2340         assign
     2341           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2342           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2343           v-diasize-browse-handle     = browse BR-changes :handle
     2344         .
     2345         create button v-diasize-resize-button
     2346         assign
     2347           parent        = frame Dialog-Frame :first-child
     2348           label         = "s"
     2349           height-pixels = 16
     2350           width-pixels  = 16
     2351           visible       = true
     2352           sensitive     = true
     2353           movable       = true
     2354           triggers:
     2355             on end-move persistent run diasize_end-move in this-procedure .
     2356           end triggers.
     2357         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2358         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2359         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2360         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2361         assign
     2362           v-diasize-wndmax = false
     2363         .
     2364         if connected("ub") = true
     2365         then do:
     2366           define variable v-cntxt-db-num        as integer   no-undo .
     2367           define variable v-cntxt-userid        as character no-undo .
     2368           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2369                                             , OUTPUT v-cntxt-userid
     2370                                             ) .
     2371           run gbl/wndpar_r.p
     2372             (input  v-cntxt-db-num
     2373             ,input  v-cntxt-userid
     2374             ,input  'wndmax':U
     2375             ,output v-diasize-wndmax
     2376             ,output v-default-value
     2377             ) .
     2378         end.
     2379         assign
     2380           v-diasize-wndstore = false
     2381         .
     2382         if connected("ub") = true
     2383         then do:
     2384           run gbl/wndpar_r.p
     2385             (input  v-cntxt-db-num
     2386             ,input  v-cntxt-userid
     2387             ,input  'wndstore':U
     2388             ,output v-diasize-wndstore
     2389             ,output v-default-value
     2390             ) .
     2391         end.
     2392         assign
     2393           v-diasize-proc-name = entry(1, program-name(2), '.')
     2394         .
     2395         if v-diasize-wndstore = true
     2396         then do:
     2397           assign
     2398             v-restore-saved = false
     2399           .
     2400           if connected("ub") = true
     2401           then do:
     2402             run gbl/wndsizer.p
     2403               (input  v-cntxt-db-num
     2404               ,input  v-cntxt-userid
     2405               ,input  v-diasize-proc-name
     2406               ,input  'height':u
     2407               ,output v-resize-value-str
     2408               ) .
     2409             if v-resize-value-str <> '':U
     2410             then do:
     2411               run diasize_change-height in this-procedure
     2412                 (input  integer(v-resize-value-str)
     2413                 ,input  true
     2414                 ) .
     2415               assign
     2416                 v-restore-saved = true
     2417               .
     2418             end.
     2419           end.
     2420           if connected("ub") = true
     2421           then do:
     2422             run gbl/wndsizer.p
     2423               (input  v-cntxt-db-num
     2424               ,input  v-cntxt-userid
     2425               ,input  v-diasize-proc-name
     2426               ,input  'width':u
     2427               ,output v-resize-value-str
     2428               ) .
     2429             if v-resize-value-str <> '':U
     2430             then do:
     2431               run diasize_change-width in this-procedure
     2432                 (input  integer(v-resize-value-str)
     2433                 ,input  true
     2434                 ) .
     2435               assign
     2436                 v-restore-saved = true
     2437               .
     2438             end.
     2439           end.
     2440           if v-restore-saved <> true
     2441           then do:
     2442             if v-diasize-wndmax = true
     2443             then do:
     2444               run diasize_maximize in this-procedure
     2445                 (input  true
     2446                 ) .
     2447             end.
     2448           end.
     2449         end.
     2450         else do:
     2451           if v-diasize-wndmax = true
     2452           then do:
     2453             run diasize_maximize in this-procedure
     2454               (input  true
     2455               ) .
     2456           end.
     2457         end.
     2458       end.
     2459     end.
     2460   end procedure.
     2461   procedure diasize_need-full-display :
     2462     define output parameter p-need-full-display as logical   no-undo .
     2463     do
     2464     on error undo, return error return-value
     2465     :
     2466       assign
     2467         p-need-full-display = v-diasize-need-full-display
     2468       .
     2469       assign
     2470         v-diasize-need-full-display = false
     2471       .
     2472     end.
     2473   end procedure.
     2474   procedure get-context :
     2475      define output parameter p-db-num as integer          no-undo.
     2476      define output parameter p-user-id as character        no-undo.
     2477      define variable v-login               as character    no-undo.
     2478      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2479      define buffer buf_user-login  for ub.user-login .
     2480      do
     2481      on error undo, return error
     2482      :
     2483            FIND FIRST buf_sys-ctrl no-lock.
     2484            ASSIGN
     2485               v-login = USERID("ub")
     2486               p-db-num = buf_sys-ctrl.db-num
     2487            .
     2488            FIND FIRST buf_user-login
     2489                 WHERE buf_user-login.db-num = p-db-num
     2490                   AND buf_user-login.user-login = v-login
     2491                 no-lock
     2492                 no-error
     2493                 .
     2494            IF AVAILABLE buf_user-login
     2495            THEN DO:
     2496               assign
     2497                  p-user-id = buf_user-login.user-id
     2498               .
     2499            END.
     2500      end.
     2501   end procedure.
     2502       run diasize_init in this-procedure .
     2503   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2504   do:
     2505     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2506   end.
     2507   MAIN-BLOCK:
     2508   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2509      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2510     find first X_gds-obj-prop no-lock where
     2511                X_gds-obj-prop.obj-type = p-obj-type and
     2512                X_gds-obj-prop.obj-code = p-obj-code and
     2513                X_gds-obj-prop.gds-code = p-gds-code
     2514                no-error.
     2515       if not available X_gds-obj-prop then do:
     2516           message
     2517           "Нет истории по товару gds-code "  p-gds-code skip
     2518           "на объекте " p-obj-type   p-obj-code
     2519           view-as alert-box ERROR.
     2520           return.
     2521       end.
     2522   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2523   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2524     (output v-db-num
     2525     )  .
     2526     RUN MyEnable.
     2527     RUn OpenBR.
     2528     if v-doc-rec <> ? then
     2529     REPOSITION br-gdsind to recid v-doc-rec No-ERROR.
     2530   WAIT-FOR GO OF FRAME Dialog-Frame.
     2531   END.
     2532   RUN disable_UI.
     2533   PROCEDURE disable_UI :
     2534     HIDE FRAME Dialog-Frame.
     2535   END PROCEDURE.
     2536   PROCEDURE enable_UI :
     2537     ENABLE b-quit B-Help br-gdsind BR-changes
     2538         WITH FRAME Dialog-Frame.
     2539     VIEW FRAME Dialog-Frame.
     2540     OPEN QUERY br-gdsind FOR EACH X_c-gds-hist NO-LOCK  INDEXED-REPOSITION.
     2541   END PROCEDURE.
     2542   PROCEDURE MyEnable :
     2543   ASSIGN
     2544   temp-changes.l_name:resizable in browse br-changes = true
     2545   temp-changes.v_old:resizable in browse br-changes = true
     2546   temp-changes.v_new:resizable in browse br-changes = true
     2547   temp-changes.l_name:width in browse br-changes = 30
     2548   temp-changes.v_old:width in browse br-changes = 40
     2549   temp-changes.v_new:width in browse br-changes = 40
     2550    br-changes:TITLE IN FRAME Dialog-Frame  = "":U
     2551   .
     2552   ENABLE
     2553   b-quit
     2554   B-Help
     2555   br-gdsind
     2556   with FRAME Dialog-Frame .
     2557   VIEW FRAME Dialog-Frame .
     2558   END PROCEDURE.
     2559   PROCEDURE OpenBr :
     2560   OPEN QUERY br-gdsind
     2561   FOR EACH X_c-gds-hist NO-LOCK WHERE X_c-gds-hist.gds-code = p-gds-code
     2562      AND (X_c-gds-hist.subject = 'gds-obj-prop':U
     2563           OR
     2564           X_c-gds-hist.subject = 'gds-obj-prop-attr':U
     2565           )
     2566       BY X_c-gds-hist.gds-code
     2567       BY X_c-gds-hist.corr-date
     2568       BY X_c-gds-hist.corr-time
     2569       INDEXED-REPOSITION
     2570   .
     2571           .
     2572   APPLY "VALUE-CHANGED" TO br-gdsind in frame Dialog-Frame.
     2573   APPLY "ENTRY" TO br-gdsind.
     2574   END PROCEDURE.
     2575   PROCEDURE proc-br-gdsind :
     2576   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2577   if b-sel:sensitive in frame Dialog-Frame then dO:
     2578       if b-mark:sensitive then do:
     2579           apply "choose" to b-mark in frame Dialog-Frame.
     2580       end.
     2581       else do:
     2582           apply "choose" to b-sel in frame Dialog-Frame.
     2583       end.
     2584   end.
     2585   else do:
     2586       if b-lookup:sensitive then
     2587       apply "choose" to b-lookup in frame Dialog-Frame.
     2588   end.
     2589   END PROCEDURE.
     2590   PROCEDURE proc-view-changes :
     2591   DEFINE VARIABLE v-description AS CHARACTER NO-UNDO.
     2592   for each temp-changes:
     2593       delete temp-changes.
     2594   END.
     2595   if not available X_c-gds-hist then do:
     2596     Open QUery br-changes for each temp-changes.
     2597     return.
     2598   end.
     2599   run ref/cgdshisv.p (
     2600                      input X_c-gds-hist.gds-code
     2601                     ,input X_c-gds-hist.chip-num
     2602                     ,input X_c-gds-hist.corr-user-db-num
     2603                     ,input X_c-gds-hist.host-code
     2604                     ,input X_c-gds-hist.obj-type
     2605                     ,input X_c-gds-hist.obj-code
     2606                     ,input X_c-gds-hist.subject
     2607                     ,input X_c-gds-hist.action
     2608                     ,input no
     2609                     ,input "":U
     2610                     ,output v-description
     2611                  ) no-error .
     2612   Open QUery br-changes for each temp-changes.
     2613   assign
     2614   br-changes:title in frame Dialog-Frame = v-description
     2615   .
     2616   END PROCEDURE.
     2617   FUNCTION get-subject RETURNS CHARACTER
     2618       ( p-subject as character ) :
     2619     RETURN entry (lookup (p-subject, 'goods,goods-attr,gds-host-attr,gds-obj-attr,fbr-gds-obj,s-coeff,bar-code,bar-code-attr,bar-code-obj-attr,prod-bc,varianty-delivery-gds-obj,gds-season,tax-rate-gds,assortment-matrix-goods,gds-obj-prop,pl-gds,pl-gds-pump,sert-join,pl-gds-attr,dis-gds-rule,ext-artic,ext-classif,recipe,recipe-gds,gds-obj,gds-obj-prop-attr':U), 'Товар,Атр-т товара,Атр-т тов. на фирме,Атр-т тов. на объекте,Атрибут РЕСТОРАНа,Сезонный коэфф,Бар-код,Атрибуты бар-кодов,Атрибуты бар-кода на объекте,ДопБК,Варианты доставки,Сезон товара,Ставки налогов,Содержимое ассортиментных матр,Индикаторы,Товар на складском месте,Товар на ТРК,Сертификат на товар,АттрТовара на скл.месте,Скидка Товара на объ.,Внешний артикул товара,Внешний классификатор,Рецепт,Товар рецепта,Товар на объекте,Атр-т тов. для заказов':U).
     2620   END FUNCTION.
     2621   FUNCTION mark-string RETURNS CHARACTER
     2622     ( BUFFER loc-c-gds-obj-prop FOR c-gds-obj-prop, input mark-list as character ) :
     2623   RETURN ( IF LOOKUP( STRING( RECID( loc-c-gds-obj-prop ) ), mark-list ) > 0 THEN "*" ELSE "":U ).
     2624   END FUNCTION.
