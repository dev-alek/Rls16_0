        1   DEFINE BUFFER buf_clients FOR ub.clients.
        2   DEFINE BUFFER buf_db FOR ub.db.
        3   DEFINE BUFFER buf_fbr-prn FOR ub.fbr-prn.
        4   DEFINE BUFFER buf_fbr-prn-grp FOR ub.fbr-prn-grp.
        5   DEFINE BUFFER buf_gds-grp FOR ub.gds-grp.
        6   define input parameter parparentproc as widget-handle no-undo .
        7   define input parameter par-mode as character no-undo.
        8   define input parameter bttns as character no-undo.
        9   define input parameter p-db-num like ub.fbr-prn.db-num no-undo.
       10   define input parameter p-prn-num like ub.fbr-prn.prn-num no-undo.
       11   define input parameter p-obj-type like ub.fbr-prn-gds.obj-type no-undo.
       12   define input parameter p-obj-code like ub.fbr-prn-gds.obj-code no-undo.
       13   define input parameter p-node-code like ub.fbr-prn-grp.node-code no-undo .
       14   define input-output parameter par-recid as recid no-undo.
       15   define variable vss-revision    as character no-undo init "$Revision$":U .
       16   define variable vss-author      as character no-undo init "$Author$":U .
       17   define variable vss-date        as character no-undo init "$Date$":U .
       18   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       19   define variable vss-archive     as character no-undo init "$Archive$":U .
       20   define variable vss-description as character no-undo init "Группы товаров на  принтере кухни".
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define new global shared variable g#library  as handle no-undo .
       80   define new global shared variable g#library2 as handle no-undo .
       81   procedure proc-alt-shift-f2:
       82     if not ibs.th.gbl.gbl-var:rcode
       83   then
       84     run gbl\inidebug.p .
       85   end.
       86   procedure proc-alt-shift-f3:
       87     run gbl/prvssinf.p
       88       ( input this-procedure
       89       ) .
       90   end.
       91   define variable v-inform-launched as logical no-undo initial false .
       92   procedure proc-alt-shift-f4:
       93     define variable v-action as character no-undo .
       94     if v-inform-launched = false then do:
       95       assign
       96         v-inform-launched = true
       97       .
       98       run gbl/d-inform.w
       99         (  input self
      100         ,  input this-procedure
      101         , output v-action
      102         ) no-error .
      103       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      104       assign
      105         v-inform-launched = false
      106       .
      107     end.
      108   end.
      109   procedure proc-alt-f1:
      110     run gbl/corrhelp.p
      111       (input this-procedure
      112       ) .
      113   end .
      114   on alt-shift-f2 anywhere do:
      115     run proc-alt-shift-f2.
      116   end.
      117   on alt-shift-f3 anywhere do:
      118     run proc-alt-shift-f3 in this-procedure .
      119   end.
      120   on alt-shift-f4 anywhere do:
      121     run proc-alt-shift-f4 in this-procedure.
      122   end.
      123   on alt-f1 anywhere do:
      124     run proc-alt-f1 in this-procedure .
      125   end.
      126   define variable vss-include-info0 as character format "X(65)" no-undo
      127   initial "@(#)$Workfile$ $Revision$".
      128   procedure grplib-get-full-name :
      129      define input parameter p-node-code  as integer      no-undo.
      130      define output parameter p-full-name as character    no-undo.
      131      do
      132   on error undo, return error
      133   :
      134       define variable v-upper-code    as integer           no-undo.
      135       define buffer buf_gds-grp       for ub.gds-grp.
      136       define buffer buf_upper_gds-grp for ub.gds-grp.
      137       find first buf_gds-grp no-lock
      138            where buf_gds-grp.node-code = p-node-code
      139       no-error.
      140       if not available buf_gds-grp
      141       then do:
      142           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      143       end.
      144       assign
      145           p-full-name  = ""
      146           v-upper-code = 1
      147       .
      148       do while buf_gds-grp.upper-code <> 0
      149       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      150       :
      151           assign
      152               p-full-name  = buf_gds-grp.node-name
      153                            + (if p-full-name <> "" then chr(47) else "")
      154                            + p-full-name
      155               v-upper-code = buf_gds-grp.upper-code
      156           .
      157           find first buf_gds-grp no-lock
      158                where buf_gds-grp.node-code = v-upper-code
      159           no-error.
      160           if not available buf_gds-grp
      161           then do:
      162               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      163                                   + string( v-upper-code )
      164                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      165           end.
      166       end.
      167       assign
      168       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      169       .
      170   end.
      171   end .
      172   procedure grplib-get-node-from-full-name :
      173   define input parameter p-full-name as character no-undo .
      174   define output parameter p-node-code as integer no-undo .
      175   define variable v-ii as integer no-undo .
      176   define variable v-upper-code as integer no-undo .
      177   define variable v-root-code as integer no-undo .
      178   define variable v-entry as character no-undo .
      179   define buffer buf_gds-grp       for ub.gds-grp.
      180   do
      181   on error undo, return error
      182   :
      183     find first buf_gds-grp no-lock
      184         where buf_gds-grp.upper-code = 0
      185     no-error .
      186     if not available buf_gds-grp
      187     then do:
      188         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      189     end.
      190     else do:
      191       assign
      192       v-root-code = buf_gds-grp.node-code
      193       .
      194     end.
      195     v-upper-code = v-root-code.
      196     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      197       assign
      198       v-entry = entry(v-ii, p-full-name, chr(47)).
      199       if v-entry = '' then leave.
      200       find first buf_gds-grp no-lock where
      201                 buf_gds-grp.node-name = v-entry
      202             and buf_gds-grp.upper-code = v-upper-code
      203             no-error.
      204       if not available buf_gds-grp then do:
      205         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      206       end.
      207       else do:
      208         p-node-code = buf_gds-grp.node-code.
      209         v-upper-code = buf_gds-grp.node-code.
      210       end.
      211     end.
      212   end.
      213   end .
      214   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      215   define variable v-waitfram-action01         as character   no-undo .
      216   define variable v-waitfram-action02         as character   no-undo .
      217   define variable v-waitfram-action03         as character   no-undo .
      218   define variable mWaitFramTextBeg            as character   no-undo.
      219   define variable mWaitFramTextEnd            as character   no-undo.
      220   define variable mWaitFramView               as logical     no-undo.
      221   define variable mWaitProcEvent              as logical     no-undo init yes.
      222   define variable mWaitFramInterval           as integer     no-undo init 1 .
      223   define variable mWaitFramStop               as logical     no-undo.
      224   define variable mWaitFramStopUser           as logical     no-undo.
      225   define variable mWaitFramStopTimeOut        as logical     no-undo.
      226   define variable mWaitFramStartProc          as datetime-tz no-undo.
      227   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      228   define button B-WaitFramStop auto-end-key
      229        label "Стоп"
      230        size 10 by 1 tooltip "Остоновить процесс".
      231   define button B-viewProcInfo
      232        label "Информация"
      233        size 15 by 1 tooltip "Информация о процесс".
      234   define frame waitfram
      235     v-waitfram-action01 format "x(72)" no-label skip
      236     v-waitfram-action02 format "x(72)" no-label skip
      237     v-waitfram-action03 format "x(72)" no-label skip
      238     B-viewProcInfo
      239     B-WaitFramStop at row 4 col 30
      240     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      241     .
      242   define new global shared variable mBatchMode as logical no-undo init ?.
      243   define variable mFramBachModHandle as handle no-undo.
      244   mFramBachModHandle = frame waitfram:handle.
      245   define variable mFameOldVis as logical no-undo.
      246   define variable mVisCUrentVin as logical no-undo.
      247   if session:batch-mode
      248   then
      249      mBatchMode = yes.
      250   if mBatchMode = ? then do:
      251     mVisCUrentVin = current-window:visible.
      252     mFameOldVis = mFramBachModHandle:visible.
      253     mFramBachModHandle:visible  = yes.
      254     mBatchMode = mFramBachModHandle:visible ne yes.
      255     mFramBachModHandle:visible = mFameOldVis.
      256     current-window:visible = mVisCUrentVin.
      257   end.
      258    if  log-manager:logfile-name ne ?
      259     then DO:
      260         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      261         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      262         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      263     end.
      264   on choose of B-WaitFramStop in frame waitfram
      265   do:
      266     mWaitFramStop = yes.
      267     mWaitFramStopUser = yes.
      268   end.
      269   function waitfram-check-timeout returns logical():
      270      define variable vtime as int64 no-undo.
      271      if mWaitFramStopTimeOut
      272      then
      273         return yes.
      274      vtime = ( now - mWaitFramStartProc ) / 1000 .
      275      if     mWaitFramTimeOut ne ?
      276         and mWaitFramTimeOut ne 0
      277         and mWaitFramTimeOut lt vtime
      278      then do:
      279         mWaitFramStopTimeOut = yes.
      280      end.
      281      return mWaitFramStopTimeOut.
      282   end.
      283   procedure waitfram-hide :
      284     if not session:batch-mode
      285     then do
      286     on error undo, return error return-value
      287     :
      288       pause 0 before-hide .
      289       if not mBatchMode then
      290         hide frame waitfram .
      291     if     not mWaitFramView
      292        and mWaitProcEvent
      293     then
      294       process events .
      295     end.
      296   end procedure.
      297   procedure waitfram-show :
      298     define input  parameter p-message as character no-undo .
      299     define variable v-left-margin as integer   no-undo .
      300     if not session:batch-mode
      301     then do
      302     on error undo, return error return-value
      303     :
      304       if length(p-message) <= 70 then do:
      305         assign
      306           v-left-margin = integer((70 - length(p-message)) / 2)
      307         .
      308         assign
      309           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      310         .
      311         assign
      312           v-waitfram-action01 = " "
      313           v-waitfram-action02 = " "
      314                                    + fill(" ", v-left-margin)
      315                                    + p-message
      316           v-waitfram-action03 = " "
      317         .
      318       end.
      319       else do:
      320         define variable vRindex1 as integer no-undo.
      321         define variable vRindex2 as integer no-undo.
      322         vRindex1 = r-index(p-message," ",70).
      323         if vRindex1 = 0
      324         then
      325            vRindex1 = 70.
      326         if length(p-message)  <= vRindex1 + 70 then do:
      327           assign
      328             v-waitfram-action01 = " "
      329             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      330             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      331           .
      332         end.
      333         else do:
      334           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      335           if vRindex2 <= vRindex1
      336           then
      337              vRindex2 = vRindex1 + 70.
      338           assign
      339             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      340             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      341             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      342           .
      343         end.
      344       end.
      345       B-viewProcInfo:visible   in frame waitfram = no.
      346       B-viewProcInfo:sensitive in frame waitfram = no.
      347       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      348       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      349       if  (   mWaitFramView
      350          or  mWaitProcEvent)
      351          and not mBatchMode
      352       then
      353          display
      354             v-waitfram-action01 skip
      355             v-waitfram-action02 skip
      356             v-waitfram-action03 skip
      357          with frame waitfram .
      358       if     mWaitFramView
      359          then do:
      360             if     mWaitFramInterval ne ?
      361                and not mBatchMode
      362             then
      363                wait-for go of frame waitfram pause mWaitFramInterval.
      364          end.
      365          else
      366             if     mWaitProcEvent
      367                and not mBatchMode
      368             then
      369                process events .
      370     end.
      371   end procedure.
      372      procedure waitfram-show-this:
      373         define input  parameter iInterval as int64 no-undo.
      374         define variable vtime as int64 no-undo.
      375         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      376         mWaitFramInterval = iInterval.
      377         run waitfram-show (substitute("&1&2 &3&4" ,
      378                                       mWaitFramTextBeg ,
      379                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      380                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      381                                       mWaitFramTextEnd
      382                                      )
      383                           ).
      384      end.
      385      procedure WaitFramRunPause:
      386         define input  parameter iInterval as dec no-undo.
      387         define variable vStart  as datetime-tz no-undo.
      388         define variable vend    as datetime-tz no-undo.
      389         define variable vint as int64 no-undo.
      390         define variable vOk as logical no-undo.
      391         vStart = now.
      392         vend   = vStart.
      393         publish "WaitFramPause" (iInterval,output vOk).
      394         vend   =  now.
      395         vint = vend - vStart.
      396         vint = iInterval - vint / 1000.
      397         if     not mWaitFramStop
      398            and (   vint > 0
      399                 or (    not vOk
      400                     and iInterval eq ?
      401                     )
      402                 )
      403         then
      404            run waitfram-show-this (iInterval).
      405         vend   =  now.
      406         vint = vend - vStart.
      407         vint = iInterval - vint / 1000.
      408         if     not mWaitFramStop
      409            and vint > 0
      410         then do:
      411            run gbl/pause.p (vint * 1000).
      412         end.
      413         if iInterval ne ?
      414         then
      415            publish "WaitFramStop".
      416         waitfram-check-timeout().
      417      end.
      418      procedure WaitFramWaitFor:
      419         define input  parameter iInterval as dec no-undo.
      420         assign
      421            mWaitFramStartProc   = now
      422            mWaitFramStopUser    = no
      423            mWaitFramStopTimeOut = no
      424         .
      425         block-wait:
      426         do while not mWaitFramStop:
      427            run WaitFramRunPause (iInterval).
      428            if  waitfram-check-timeout()
      429            then do:
      430               leave block-wait.
      431            end.
      432         end.
      433         run waitfram-hide.
      434      end.
      435   procedure waitfram-join :
      436     define input  parameter p-line-1  as character no-undo .
      437     define input  parameter p-line-2  as character no-undo .
      438     define input  parameter p-line-3  as character no-undo .
      439     define output parameter p-message as character no-undo .
      440     do
      441     on error undo, return error return-value
      442     :
      443       assign
      444         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      445                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      446                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      447       .
      448     end.
      449   end procedure.
      450   function waitfram-join-function returns character
      451     (input p-line-1 as character
      452     ,input p-line-2 as character
      453     ,input p-line-3 as character
      454     ).
      455     define variable v-message as character no-undo .
      456     run waitfram-join in this-procedure
      457       (input  p-line-1
      458       ,input  p-line-2
      459       ,input  p-line-3
      460       ,output v-message
      461       ) .
      462     return v-message .
      463   end function .
      464   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      465   procedure cur-time :
      466      define output parameter p-today as date      no-undo .
      467      define output parameter p-time  as integer   no-undo .
      468     do
      469     on error undo, return error
      470     :
      471       define variable v-date1 as date      no-undo .
      472       define variable v-date2 as date      no-undo .
      473       define variable v-time  as integer   no-undo .
      474       assign
      475         v-date1 = today
      476         v-time  = time
      477         v-date2 = today
      478       .
      479       if v-date1 <> v-date2
      480       then do:
      481         assign
      482           v-date1 = today
      483           v-time  = v-time
      484         .
      485       end.
      486       assign
      487         p-today = v-date1
      488         p-time  = v-time
      489       .
      490     end.
      491   end.
      492   function cur-time-date returns character
      493   :
      494     return string(today, '99/99/9999':U) .
      495   end.
      496   function cur-time-mjd returns decimal
      497   :
      498     define variable v-date as date      no-undo .
      499     define variable v-time as integer   no-undo .
      500     run cur-time in this-procedure
      501       (output v-date
      502       ,output v-time
      503       ) .
      504     return integer(v-date) - 2400002 + (v-time / 86400) .
      505   end.
      506   function cur-time-get-ending-index returns integer
      507   (input p-number as integer
      508   )
      509   :
      510     if p-number < 0
      511     or p-number = ?
      512     then do:
      513       return 1 .
      514     end.
      515     define variable v-rest as integer   no-undo .
      516     assign
      517       p-number = p-number modulo 100
      518     .
      519     if p-number < 20
      520     then do:
      521       assign
      522         v-rest = p-number
      523       .
      524     end.
      525     else do:
      526       assign
      527         v-rest = p-number modulo 10
      528       .
      529     end.
      530     case v-rest :
      531       when 1
      532       then do:
      533         return 2 .
      534       end.
      535       when 2 or
      536       when 3 or
      537       when 4
      538       then do:
      539         return 3 .
      540       end.
      541       otherwise do:
      542         return 1 .
      543       end.
      544     end case .
      545   end.
      546   procedure cur-time-mjd-to-date :
      547      define input  parameter i-mjd-diff as decimal no-undo.
      548      define output parameter o-Date     as date    no-undo.
      549      define output parameter o-Time     as integer no-undo.
      550      define variable v-day-number as integer   no-undo .
      551      if    i-mjd-diff < 0
      552         or i-mjd-diff = ?
      553      then do:
      554         return "?" .
      555      end.
      556      assign
      557         v-day-number = truncate(i-mjd-diff,0).
      558         o-Date = date(v-day-number + 2400002).
      559         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      560     .
      561   end.
      562   function cur-time-mjd-to-string returns character
      563   (input p-mjd-diff as decimal
      564   )
      565   :
      566     define variable v-day-number as integer   no-undo .
      567     define variable v-seconds    as integer   no-undo .
      568     define variable v-hour       as integer   no-undo .
      569     define variable v-min        as integer   no-undo .
      570     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      571     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      572     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      573     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      574     if p-mjd-diff < 0
      575     or p-mjd-diff = ?
      576     then do:
      577       return "?" .
      578     end.
      579     assign
      580       v-day-number = integer(truncate(p-mjd-diff,0))
      581       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      582     .
      583     if v-seconds > 86400
      584     then do:
      585       assign
      586         v-seconds = 86400 - 1
      587       .
      588     end.
      589     if v-seconds < 0
      590     then do:
      591       assign
      592         v-seconds = 0
      593       .
      594     end.
      595     assign
      596       v-hour = truncate(v-seconds / 3600, 0)
      597     .
      598     assign
      599       v-seconds = v-seconds modulo 3600
      600     .
      601     assign
      602       v-min = truncate(v-seconds / 60, 0)
      603     .
      604     assign
      605       v-seconds = v-seconds modulo 60
      606     .
      607     return
      608         (if v-day-number <> 0
      609           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      610           else ""
      611         )
      612       + (if v-day-number <> 0 or v-hour <> 0
      613           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      614           else ""
      615         )
      616       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      617           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      618           else ""
      619         )
      620       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      621       .
      622   end.
      623   function cur-time-string returns character
      624   :
      625     define variable v-date as date      no-undo .
      626     define variable v-time as integer   no-undo .
      627     run cur-time in this-procedure
      628       (output v-date
      629       ,output v-time
      630       ) .
      631     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      632   end.
      633   function cur-time-string-sec returns character
      634   :
      635     define variable v-date as date      no-undo .
      636     define variable v-time as integer   no-undo .
      637     run cur-time in this-procedure
      638       (output v-date
      639       ,output v-time
      640       ) .
      641     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      642   end.
      643   function cur-time-custom  returns character
      644   (input p-prefix as character
      645   ,input p-date-format as character
      646   ,input p-delimiter as character
      647   ,input p-time-format as character
      648   ,input p-suffix as character
      649   )
      650   :
      651     define variable v-date as date      no-undo .
      652     define variable v-time as integer   no-undo .
      653     run cur-time in this-procedure
      654       (output v-date
      655       ,output v-time
      656       ) .
      657     return
      658       p-prefix
      659       + string(v-date, p-date-format)
      660       + p-delimiter
      661       + string(v-time, p-time-format)
      662       + p-suffix
      663       .
      664   end.
      665   function cur-time-print  returns character
      666   :
      667     define variable v-date as date      no-undo .
      668     define variable v-time as integer   no-undo .
      669     run cur-time in this-procedure
      670       (output v-date
      671       ,output v-time
      672       ) .
      673     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      674   end.
      675   function cur-time-datetime returns datetime
      676   :
      677     define variable v-char as character no-undo .
      678     define variable v-datetime as datetime no-undo .
      679     v-char = cur-time-string().
      680     v-datetime = datetime(v-char).
      681     return  v-datetime.
      682   end.
      683   function cur-time-string-msec returns character
      684   :
      685     define variable v-date as datetime  no-undo .
      686     v-date = now.
      687     return string(v-date) .
      688   end.
