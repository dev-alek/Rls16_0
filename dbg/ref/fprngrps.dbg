      692   define new shared variable PrintRubl          as logical   no-undo .
      693   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      694   define  stream PrnLibStream.
      695   procedure prn-lib-prn-file :
      696     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      697     define input parameter p-DIsabledoptions as integer no-undo .
      698     define variable v-report-name as character no-undo .
      699     define variable v-user-action as character no-undo .
      700     define variable v-printed     as logical   no-undo .
      701     define variable v-exist       as logical   no-undo .
      702     do
      703       on error undo, return error
      704       :
      705       run prn-lib-get-report-name  in this-procedure (
      706         input parParentProc
      707         ,output v-report-name
      708         ).
      709   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      710   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      711     (input  v-report-name
      712     ,input  2
      713     ,output v-exist
      714     )  .
      715       if NOT v-exist then
      716       DO:
      717         Message
      718           "Нет заданий на печать ! "
      719           view-as alert-box .
      720         Return  .
      721       End.
      722       run gbl/prnfilen.w
      723         (input  ""
      724         ,input  p-DisabledOptions
      725         ,input  string(v-report-name )
      726         ,input  7
      727         ,output v-user-action
      728         ,output v-printed
      729         ) .
      730       if v-printed then
      731       do:
      732         return "YES" .
      733       end.
      734       else
      735       do:
      736         return "NO" .
      737       end.
      738     end.
      739   end procedure.
      740   procedure prn-lib-open-stream :
      741     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      742     define input parameter p-page-size    as integer no-undo .
      743     define input parameter p-is-stream    as logical no-undo .
      744     define input parameter p-append       as logical no-undo .
      745     define variable v-report-name as character no-undo .
      746     do
      747       on error undo, return error
      748       :
      749       run prn-lib-get-report-name  in this-procedure (
      750         input parParentProc
      751         ,output v-report-name
      752         ).
      753       if p-is-stream then
      754       do:
      755         if p-append then
      756         do:
      757           output stream PrnLibStream to value( v-report-name )
      758             page-size value(p-page-size) append .
      759         end.
      760         if not p-append then
      761         do:
      762           output stream PrnLibStream to value( v-report-name )
      763             page-size value(p-page-size) .
      764         end.
      765       end.
      766       if not p-is-stream then
      767       do:
      768         if p-append then
      769         do:
      770           output to value( v-report-name )
      771             page-size value(p-page-size) append .
      772         end.
      773         if not p-append then
      774         do:
      775           output to value( v-report-name )
      776             page-size value(p-page-size) .
      777         end.
      778       end.
      779     end.
      780   end procedure.
      781   procedure prn-lib-open-exp :
      782     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      783     define input parameter p-is-stream    as logical no-undo .
      784     define input parameter p-is-append    as logical no-undo .
      785     define output parameter p-ReportFileName as char init "report" no-undo.
      786     define output parameter p-process as logical no-undo .
      787     define variable glog as logical no-undo .
      788     do
      789       on error undo, return error
      790       :
      791       SYSTEM-DIALOG GET-FILE p-ReportFileName
      792         TITLE      "Укажите путь"
      793         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      794         ASK-OVERWRITE
      795         CREATE-TEST-FILE
      796         SAVE-AS
      797         USE-FILENAME
      798         DEFAULT-EXTENSION "txt"
      799         UPDATE glog
      800         .
      801       if not glog then  return.
      802       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      803       if p-is-stream then
      804       do:
      805         if p-is-append then
      806         do:
      807           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      808         end.
      809         else
      810         do:
      811           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      812         end.
      813       end.
      814       else
      815       do:
      816         if p-is-append then
      817         do:
      818           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      819         end.
      820         else
      821         do:
      822           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      823         end.
      824       end.
      825       p-process = yes.
      826     end.
      827   end procedure.
      828   procedure prn-lib-get-report-name :
      829     define input parameter parParentProc  as widget-handle no-undo.
      830     define output parameter p-report-name as character no-undo .
      831     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      832   end procedure.
      833   procedure prn-lib-reportviewer-report-name :
