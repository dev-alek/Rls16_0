      974   if not loc#log then return no-apply.
      975   glog = no.
      976   message
      977   "После удаления товары (блюда) данной группы НЕ БУДУТ" skip
      978   "автоматически появляться в списке товаров" skip
      979   "ЭТОГО принтера ( с номером " buf_fbr-prn-grp.prn-num " )" skip
      980   "при появлении их в наличии на объекте" buf_fbr-prn-grp.obj-type buf_fbr-prn-grp.obj-code skip(1)
      981   "Вы уверены ?" skip
      982   " "
      983   view-as alert-box question buttons OK-Cancel update glog.
      984   if not glog then return no-apply.
