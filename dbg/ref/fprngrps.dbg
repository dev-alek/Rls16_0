      994   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      995   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      996   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      997   on help of frame Dialog-Frame
      998   do:
      999     run gbl/app_help.p
     1000       (input this-procedure :file-name
     1001       ,input ''
