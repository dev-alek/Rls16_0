     1007         error-status :get-message(1)
     1008         view-as alert-box .
     1009     end.
     1010   end.
     1011   run minbtn-set in this-procedure .
     1012   on choose of b-help in frame Dialog-Frame
     1013   do:
     1014     apply "help":u to frame Dialog-Frame .
     1015   end.
     1016   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1017   procedure minbtn-set :
     1018       do
     1019           on error undo, return error return-value
     1020           :
     1021           define variable ii              as integer       no-undo .
     1022           define variable fh              as widget-handle no-undo .
     1023           define variable hh              as widget-handle no-undo .
     1024           define variable v-h             as handle        extent 4 no-undo .
     1025           define variable v-name-button   as character     no-undo .
     1026           define variable v-help-old-x    as decimal       no-undo .
     1027           define variable v-help-old-y    as decimal       no-undo .
     1028           define variable v-help-old-size as decimal       no-undo .
     1029           define variable v-frame-width   as decimal       no-undo .
     1030           define variable jj              as integer       no-undo .
     1031           do
     1032               on error undo, return error
     1033               :
     1034               assign
     1035                   v-frame-width = frame Dialog-Frame:width - 0.3
     1036                   fh            = frame Dialog-Frame:first-child
     1037                   hh            = fh:first-child
     1038                   ii            = 1
     1039                   .
     1040               do while valid-handle(hh):
     1041                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1042                   do:
     1043                       case lc(hh:name) :
     1044                           when "b-help" then
     1045                               do:
     1046                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1047                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1048                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1049                                   hh:TOOLTIP = "Помощь" .
     1050                                   v-help-old-x = hh:column .
     1051                                   v-help-old-y = hh:row    .
     1052                                   v-help-old-size = hh:width .
     1053                                   hh:width-chars = 2.5 .
     1054                               end.
     1055                           when "b-print" then
     1056                               do:
     1057                                   hh:load-image("cmp/b-print.bmp":u) .
     1058                                   hh:TOOLTIP = "Печать" .
     1059                                   v-h[ii] = hh:handle .
     1060                                   ii = ii + 1 .
     1061                                   hh:width-chars = 3 .
     1062                               end.
     1063                           when "b-history" or
     1064                           when "b-hist" then
     1065                               do:
     1066                                   hh:load-image("cmp/b-hist.bmp":u) .
     1067                                   hh:TOOLTIP = "История" .
     1068                                   v-h[ii] = hh:handle .
     1069                                   ii = ii + 1 .
     1070                                   hh:width-chars = 3 .
     1071                               end.
     1072                           when "b-sch" then
     1073                               do:
     1074                                   hh:load-image("cmp/b-sch.bmp":u) .
     1075                                   hh:TOOLTIP = "Установка Фильтра" .
     1076                                   v-h[ii] = hh:handle .
     1077                                   ii = ii + 1 .
     1078                                   hh:width-chars = 3 .
     1079                               end.
     1080                           when "b-hist-user" then
     1081                               do:
     1082                                   hh:load-image("cmp/b-hist.bmp":u) .
     1083                                   hh:TOOLTIP = "История пользователя" .
     1084                                   ii = ii + 1 .
     1085                               end.
     1086                       end case.
     1087                   end.
     1088                   hh = hh:next-sibling.
     1089               end.
     1090               b-help:column = v-frame-width - b-help:width-chars.
     1091               jj = 0.
     1092               repeat ii = 4 to 1 by -1 :
     1093                   if valid-handle (v-h[ii] ) then
     1094                   do:
     1095                       jj  = jj + 1 .
     1096                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1097                       v-h[ii]:row    = v-help-old-y .
     1098                   end.
     1099               end.
     1100           end.
     1101       end.
     1102   end procedure.
     1103   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1104   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1105   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1106   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1107   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1108   define variable v-diasize-current-frame-height as decimal   no-undo .
     1109   define variable v-diasize-change-size          as logical   no-undo .
     1110   define variable v-diasize-resize-button        as handle    no-undo .
     1111   define variable v-diasize-wndmax               as logical   no-undo .
     1112   define variable v-diasize-wndstore             as logical   no-undo .
     1113   define variable v-diasize-proc-name            as character no-undo .
     1114   define variable v-diasize-browse-handle        as handle    no-undo .
     1115   define variable v-diasize-browse-number        as integer   no-undo .
     1116   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1117   define temp-table temp-diasize-handle no-undo
     1118     field handle-value  as handle
     1119     field save-position as decimal
     1120     index xpk is primary unique handle-value
     1121     .
     1122   define temp-table temp-browse-handle no-undo
     1123     field browse-type   as character
     1124     field browse-number as integer
     1125     field browse-handle as handle
     1126     field original-size as decimal
     1127     index xpk is primary unique browse-type browse-number
     1128     index xie browse-type browse-handle
     1129   .
     1130   procedure diasize_change-height :
     1131     define input  parameter p-change-value  as decimal   no-undo .
     1132     define input  parameter p-move-resize   as logical   no-undo .
     1133     define variable v-field-group-handle    as handle    no-undo .
     1134     define variable v-object-handle         as handle    no-undo .
     1135     define variable v-frame-height          as decimal   no-undo .
     1136     define variable v-frame-virtual-height  as decimal   no-undo .
     1137     define variable v-browse-height         as decimal   no-undo .
     1138     define variable v-window-height         as decimal   no-undo .
     1139     define variable v-window-virtual-height as decimal   no-undo .
     1140     define variable v-change-sign           as integer   no-undo .
     1141     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1142     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1143     if p-change-value > 0
     1144     then do:
     1145       if frame Dialog-Frame :height + p-change-value
     1146           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1147       then do:
     1148         assign
     1149           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1150                           - (frame Dialog-Frame :height-chars)
     1151         .
     1152         if p-change-value <= 0
     1153         then do:
     1154           run diasize_position-resize-button in this-procedure .
     1155           return .
     1156         end.
     1157       end.
     1158     end.
     1159     if p-change-value < 0
     1160     then do:
     1161       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1162       then do:
     1163         assign
     1164           p-change-value = v-diasize-orig-frame-height
     1165                          - (frame Dialog-Frame :height-chars)
     1166         .
     1167         if p-change-value >= 0
     1168         then do:
     1169           run diasize_position-resize-button in this-procedure .
     1170           return .
     1171         end.
     1172       end.
     1173     end.
     1174     if p-change-value >= 0
     1175     then do:
     1176       assign
     1177         v-change-sign = 1
     1178       .
     1179     end.
     1180     else do:
     1181       assign
     1182         v-change-sign = -1
     1183       .
     1184     end.
     1185     assign
     1186       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1187     .
     1188     if p-change-value = 0
     1189     then do:
     1190       run diasize_position-resize-button in this-procedure .
     1191       return .
     1192     end.
     1193     move_block:
     1194     do
     1195     on error undo move_block, retry move_block
     1196     :
     1197       if retry
     1198       then do:
     1199         do
     1200         on error undo move_block, leave move_block
     1201         :
     1202           if p-change-value > 0
     1203           then do:
     1204             for each buf_temp-diasize-handle
     1205             on error undo, next
     1206             :
     1207               assign
     1208                 v-object-handle = buf_temp-diasize-handle.handle-value
     1209               .
     1210               if v-object-handle <> v-diasize-resize-button
     1211               then do:
     1212                 assign
     1213                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1214                 .
     1215               end.
     1216             end.
     1217             assign
     1218               v-diasize-browse-handle :height = v-browse-height
     1219             .
     1220             for each buf_temp-browse-handle
     1221               where buf_temp-browse-handle.browse-type = 'height':u
     1222             on error undo, next
     1223             :
     1224               assign
     1225                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1226               .
     1227             end.
     1228             assign
     1229               frame Dialog-Frame :height = v-frame-height
     1230             .
     1231             if frame Dialog-Frame :scrollable = true
     1232             then do:
     1233               assign
     1234                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1235               .
     1236             end.
     1237             run diasize_position-resize-button in this-procedure .
     1238           end.
     1239           else do:
     1240             if frame Dialog-Frame :scrollable = true
     1241             then do:
     1242               assign
     1243                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1244               .
     1245             end.
     1246             assign
     1247               frame Dialog-Frame :height = v-frame-height
     1248             .
     1249             assign
     1250               v-diasize-browse-handle :height = v-browse-height
     1251             .
     1252             for each buf_temp-browse-handle
     1253               where buf_temp-browse-handle.browse-type = 'height':u
     1254             on error undo, next
     1255             :
     1256               assign
     1257                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1258               .
     1259             end.
     1260             for each buf_temp-diasize-handle
     1261             on error undo, next
     1262             :
     1263               assign
     1264                 v-object-handle = buf_temp-diasize-handle.handle-value
     1265               .
     1266               if v-object-handle <> v-diasize-resize-button
     1267               then do:
     1268                 assign
     1269                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1270                 .
     1271               end.
     1272             end.
     1273             run diasize_position-resize-button in this-procedure .
     1274           end.
     1275           assign
     1276             v-diasize-change-size = false
     1277           .
     1278           leave move_block .
     1279         end.
     1280       end.
     1281       assign
     1282         v-diasize-need-full-display = true
     1283       .
     1284       if v-diasize-change-size = false
     1285       then do:
     1286         assign
     1287           v-diasize-change-size = true
     1288         .
     1289       end.
     1290       else do:
     1291         return .
     1292       end.
     1293       assign
     1294         v-frame-height = frame Dialog-Frame :height
     1295         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1296         v-browse-height = v-diasize-browse-handle :height
     1297       .
     1298       for each buf_temp-browse-handle
     1299         where buf_temp-browse-handle.browse-type = 'height':u
     1300       :
     1301         assign
     1302           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1303         .
     1304       end.
     1305       for each buf_temp-diasize-handle
     1306       :
     1307         delete buf_temp-diasize-handle .
     1308       end.
     1309       assign
     1310         v-field-group-handle = frame Dialog-Frame :first-child
     1311       .
     1312       do while valid-handle(v-field-group-handle)
     1313       :
     1314         assign
     1315           v-object-handle = v-field-group-handle :first-child
     1316         .
     1317         do while valid-handle(v-object-handle)
     1318         :
     1319           if  v-object-handle <> v-diasize-browse-handle :handle
     1320           and can-query(v-object-handle, "row")
     1321           and can-query(v-object-handle, "height")
     1322           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1323           then do:
     1324             find first buf_temp-browse-handle
     1325               where buf_temp-browse-handle.browse-type   = 'height':u
     1326                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1327               no-error .
     1328             if available buf_temp-browse-handle
     1329             then do:
     1330             end.
     1331             else do:
     1332               create buf_temp-diasize-handle .
     1333               assign
     1334                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1335                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1336               .
     1337             end.
     1338           end.
     1339           assign
     1340             v-object-handle = v-object-handle :next-sibling
     1341           .
     1342         end.
     1343         assign
     1344           v-field-group-handle = v-field-group-handle :next-sibling
     1345         .
     1346       end.
     1347       do with frame Dialog-Frame
     1348       :
     1349         hide v-diasize-resize-button .
     1350         assign
     1351           v-diasize-resize-button :row    = 1
     1352           v-diasize-resize-button :column = 1
     1353         .
     1354       end.
     1355       if p-change-value > 0
     1356       then do:
     1357         if frame Dialog-Frame :scrollable = true
     1358         then do:
     1359           assign
     1360             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1361             no-error .
     1362           if error-status :error
     1363           or error-status :get-message(1) <> ""
     1364           then do:
     1365             undo move_block, retry move_block .
     1366           end.
     1367         end.
     1368         assign
     1369           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1370           no-error .
     1371         if error-status :error
     1372         or error-status :get-message(1) <> ""
     1373         then do:
     1374           undo move_block, retry move_block .
     1375         end.
     1376         assign
     1377           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1378           no-error .
     1379         if error-status :error
     1380         or error-status :get-message(1) <> ""
     1381         then do:
     1382           undo move_block, retry move_block .
     1383         end.
     1384         for each buf_temp-browse-handle
     1385           where buf_temp-browse-handle.browse-type = 'height':u
     1386         on error undo move_block, retry move_block
     1387         :
     1388           assign
     1389             buf_temp-browse-handle.browse-handle :height
     1390               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1391             no-error .
     1392           if error-status :error
     1393           or error-status :get-message(1) <> ""
     1394           then do:
     1395             undo move_block, retry move_block .
     1396           end.
     1397         end.
     1398         for each buf_temp-diasize-handle
     1399         on error undo move_block, retry move_block
     1400         :
     1401           assign
     1402             v-object-handle = buf_temp-diasize-handle.handle-value
     1403           .
     1404           if v-object-handle <> v-diasize-resize-button
     1405           then do:
     1406             assign
     1407               v-object-handle :row = v-object-handle :row + p-change-value
     1408               no-error .
     1409             if error-status :error
     1410             or error-status :get-message(1) <> ""
     1411             then do:
     1412               undo move_block, retry move_block .
     1413             end.
     1414           end.
     1415         end.
     1416       end.
     1417       else do:
     1418         for each buf_temp-diasize-handle
     1419         on error undo move_block, retry move_block
     1420         :
     1421           assign
     1422             v-object-handle = buf_temp-diasize-handle.handle-value
     1423           .
     1424           if v-object-handle <> v-diasize-resize-button
     1425           then do:
     1426             assign
     1427               v-object-handle :row = v-object-handle :row + p-change-value
     1428               no-error .
     1429             if error-status :error
     1430             or error-status :get-message(1) <> ""
     1431             then do:
     1432               undo move_block, retry move_block .
     1433             end.
     1434           end.
     1435         end.
     1436         assign
     1437           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1438           no-error .
     1439         if error-status :error
     1440         or error-status :get-message(1) <> ""
     1441         then do:
     1442           undo move_block, retry move_block .
     1443         end.
     1444         for each buf_temp-browse-handle
     1445           where buf_temp-browse-handle.browse-type = 'height':u
     1446         on error undo move_block, retry move_block
     1447         :
     1448           assign
     1449             buf_temp-browse-handle.browse-handle :height
     1450               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1451             no-error .
     1452           if error-status :error
     1453           or error-status :get-message(1) <> ""
     1454           then do:
     1455             undo move_block, retry move_block .
     1456           end.
     1457         end.
     1458         assign
     1459           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1460           no-error .
     1461         if error-status :error
     1462         or error-status :get-message(1) <> ""
     1463         then do:
     1464           undo move_block, retry move_block .
     1465         end.
     1466         if frame Dialog-Frame :scrollable = true
     1467         then do:
     1468           assign
     1469             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1470             no-error .
     1471           if error-status :error
     1472           or error-status :get-message(1) <> ""
     1473           then do:
     1474             undo move_block, retry move_block .
     1475           end.
     1476         end.
     1477       end.
     1478       if p-move-resize = true
     1479       then do:
     1480         run diasize_position-resize-button in this-procedure .
     1481       end.
     1482       if v-diasize-wndstore = true
     1483       then do:
     1484         if connected("ub") = true
     1485         then do:
     1486           define variable v-cntxt-db-num        as integer   no-undo .
     1487           define variable v-cntxt-userid        as character no-undo .
     1488           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1489                                             , OUTPUT v-cntxt-userid
     1490                                             ) .
     1491           run gbl/wndsizew.p
     1492             (input  v-cntxt-db-num
     1493             ,input  v-cntxt-userid
     1494             ,input  v-diasize-proc-name
     1495             ,input  'height':u
     1496             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1497             ) .
     1498         end.
     1499       end.
     1500     end.
     1501     assign
     1502       v-diasize-change-size = false
     1503     .
     1504   end procedure.
     1505   procedure diasize_set-height :
     1506     define input  parameter p-new-height  as decimal   no-undo .
     1507     define input  parameter p-move-resize as logical   no-undo .
     1508     do
     1509     on error undo, return error return-value
     1510     :
     1511       run diasize_change-height in this-procedure
     1512         (input  (p-new-height - frame Dialog-Frame :height)
     1513         ,input  p-move-resize
     1514         ) .
     1515     end.
     1516   end procedure.
     1517   procedure diasize_change-width :
     1518     define input  parameter p-change-value as decimal   no-undo .
     1519     define input  parameter p-move-resize  as logical   no-undo .
     1520     define variable v-field-group-handle   as handle    no-undo .
     1521     define variable v-object-handle        as handle    no-undo .
     1522     define variable v-frame-width          as decimal   no-undo .
     1523     define variable v-frame-virtual-width  as decimal   no-undo .
     1524     define variable v-browse-width         as decimal   no-undo .
     1525     define variable v-window-width         as decimal   no-undo .
     1526     define variable v-window-virtual-width as decimal   no-undo .
     1527     define variable v-change-sign          as integer   no-undo .
     1528     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1529     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1530     if p-change-value > 0
     1531     then do:
     1532       if frame Dialog-Frame :width + p-change-value >
     1533           session :width-chars
     1534       then do:
     1535         assign
     1536           p-change-value = session :width-chars - frame Dialog-Frame :width
     1537         .
     1538         if p-change-value <= 0
     1539         then do:
     1540           run diasize_position-resize-button in this-procedure .
     1541           return .
     1542         end.
     1543       end.
     1544     end.
     1545     if p-change-value < 0
     1546     then do:
     1547       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1548       then do:
     1549         assign
     1550           p-change-value = v-diasize-orig-frame-width
     1551                          - frame Dialog-Frame :width
     1552         .
     1553         if p-change-value >= 0
     1554         then do:
     1555           run diasize_position-resize-button in this-procedure .
     1556           return .
     1557         end.
     1558       end.
     1559     end.
     1560     if p-change-value >= 0
     1561     then do:
     1562       assign
     1563         v-change-sign = 1
     1564       .
     1565     end.
     1566     else do:
     1567       assign
     1568         v-change-sign = -1
     1569       .
     1570     end.
     1571     assign
     1572       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1573     .
     1574     if p-change-value = 0
     1575     then do:
     1576       run diasize_position-resize-button in this-procedure .
     1577       return .
     1578     end.
     1579     move_block:
     1580     do
     1581     on error undo move_block, leave move_block
     1582     :
     1583       if retry
     1584       then do:
     1585         do
     1586         on error undo move_block, leave move_block
     1587         :
     1588           if p-change-value > 0
     1589           then do:
     1590             for each buf_temp-diasize-handle
     1591             on error undo, next
     1592             :
     1593               assign
     1594                 v-object-handle = buf_temp-diasize-handle.handle-value
     1595               .
     1596               if v-object-handle <> v-diasize-resize-button
     1597               then do:
     1598                 assign
     1599                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1600                 .
     1601               end.
     1602             end.
     1603             assign
     1604               v-diasize-browse-handle :width = v-browse-width
     1605             .
     1606             for each buf_temp-browse-handle
     1607               where buf_temp-browse-handle.browse-type = 'width':u
     1608             on error undo, next
     1609             :
     1610               assign
     1611                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1612               .
     1613             end.
     1614             assign
     1615               frame Dialog-Frame :width = v-frame-width
     1616             .
     1617             if frame Dialog-Frame :scrollable = true
     1618             then do:
     1619               assign
     1620                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1621               .
     1622             end.
     1623             run diasize_position-resize-button in this-procedure .
     1624           end.
     1625           else do:
     1626             if frame Dialog-Frame :scrollable = true
     1627             then do:
     1628               assign
     1629                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1630               .
     1631             end.
     1632             assign
     1633               frame Dialog-Frame :width = v-frame-width
     1634             .
     1635             for each buf_temp-browse-handle
     1636               where buf_temp-browse-handle.browse-type = 'width':u
     1637             on error undo, next
     1638             :
     1639               assign
     1640                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1641               .
     1642             end.
     1643             assign
     1644               v-diasize-browse-handle :width = v-browse-width
     1645             .
     1646             for each buf_temp-diasize-handle
     1647             on error undo, next
     1648             :
     1649               assign
     1650                 v-object-handle = buf_temp-diasize-handle.handle-value
     1651               .
     1652               if v-object-handle <> v-diasize-resize-button
     1653               then do:
     1654                 assign
     1655                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1656                 .
     1657               end.
     1658             end.
     1659             run diasize_position-resize-button in this-procedure .
     1660           end.
     1661           assign
     1662             v-diasize-change-size = false
     1663           .
     1664           leave move_block .
     1665         end.
     1666       end.
     1667       assign
     1668         v-diasize-need-full-display = true
     1669       .
     1670       if v-diasize-change-size = false
     1671       then do:
     1672         assign
     1673           v-diasize-change-size = true
     1674         .
     1675       end.
     1676       else do:
     1677         return .
     1678       end.
     1679       assign
     1680         v-frame-width = frame Dialog-Frame :width
     1681         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1682         v-browse-width = v-diasize-browse-handle :width
     1683       .
     1684       for each buf_temp-browse-handle
     1685         where buf_temp-browse-handle.browse-type = 'width':u
     1686       :
     1687         assign
     1688           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1689         .
     1690       end.
     1691       for each buf_temp-diasize-handle
     1692       :
     1693         delete buf_temp-diasize-handle .
     1694       end.
     1695       assign
     1696         v-field-group-handle = frame Dialog-Frame :first-child
     1697       .
     1698       do while valid-handle(v-field-group-handle)
     1699       :
     1700         assign
     1701           v-object-handle = v-field-group-handle :first-child
     1702         .
     1703         do while valid-handle(v-object-handle)
     1704         :
     1705           if  v-object-handle <> v-diasize-browse-handle :handle
     1706           and v-object-handle <> v-diasize-resize-button
     1707           and can-query(v-object-handle, "row")
     1708           and can-query(v-object-handle, "height")
     1709           and ( v-object-handle :col + v-object-handle :width
     1710                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1711               )
     1712           then do:
     1713             find first buf_temp-browse-handle
     1714               where buf_temp-browse-handle.browse-type   = 'width':u
     1715                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1716               no-error .
     1717             if available buf_temp-browse-handle
     1718             then do:
     1719             end.
     1720             else do:
     1721               create buf_temp-diasize-handle .
     1722               assign
     1723                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1724                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1725               .
     1726             end.
     1727           end.
     1728           assign
     1729             v-object-handle = v-object-handle :next-sibling
     1730           .
     1731         end.
     1732         assign
     1733           v-field-group-handle = v-field-group-handle :next-sibling
     1734         .
     1735       end.
     1736       do with frame Dialog-Frame
     1737       :
     1738         hide v-diasize-resize-button .
     1739         v-diasize-resize-button :row = 1.
     1740         v-diasize-resize-button :column = 1.
     1741       end.
     1742       if p-change-value > 0
     1743       then do:
     1744         if frame Dialog-Frame :scrollable = true
     1745         then do:
     1746           assign
     1747             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1748             no-error .
     1749           if error-status :error
     1750           or error-status :get-message(1) <> ""
     1751           then do:
     1752             undo move_block, retry move_block.
     1753           end.
     1754         end.
     1755         assign
     1756           frame Dialog-Frame :width = v-frame-width + p-change-value
     1757           no-error .
     1758         if error-status :error
     1759         or error-status :get-message(1) <> ""
     1760         then do:
     1761           undo move_block, retry move_block.
     1762         end.
     1763         assign
     1764           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1765         no-error .
     1766         if error-status :error
     1767         or error-status :get-message(1) <> ""
     1768         then do:
     1769           undo move_block, retry move_block.
     1770         end.
     1771         for each buf_temp-browse-handle
     1772           where buf_temp-browse-handle.browse-type = 'width':u
     1773         on error undo move_block, retry move_block
     1774         :
     1775           assign
     1776             buf_temp-browse-handle.browse-handle :width
     1777               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1778             no-error .
     1779           if error-status :error
     1780           or error-status :get-message(1) <> ""
     1781           then do:
     1782             undo move_block, retry move_block .
     1783           end.
     1784         end.
     1785         for each buf_temp-diasize-handle
     1786         on error undo move_block, retry move_block
     1787         :
     1788           assign
     1789             v-object-handle = buf_temp-diasize-handle.handle-value
     1790           .
     1791           if v-object-handle <> v-diasize-resize-button
     1792           then do:
     1793             assign
     1794               v-object-handle :col = v-object-handle :col + p-change-value
     1795               no-error .
     1796             if error-status :error
     1797             or error-status :get-message(1) <> ""
     1798             then do:
     1799               undo move_block, retry move_block .
     1800             end.
     1801           end.
     1802         end.
     1803       end.
     1804       else do:
     1805         for each buf_temp-diasize-handle
     1806         on error undo move_block, retry move_block
     1807         :
     1808           assign
     1809             v-object-handle = buf_temp-diasize-handle.handle-value
     1810           .
     1811           if v-object-handle <> v-diasize-resize-button
     1812           then do:
     1813             assign
     1814               v-object-handle :col = v-object-handle :col + p-change-value
     1815               no-error .
     1816             if error-status :error
     1817             or error-status :get-message(1) <> ""
     1818             then do:
     1819               undo move_block, retry move_block .
     1820             end.
     1821           end.
     1822         end.
     1823         for each buf_temp-browse-handle
     1824           where buf_temp-browse-handle.browse-type = 'width':u
     1825         on error undo move_block, retry move_block
     1826         :
     1827           assign
     1828             buf_temp-browse-handle.browse-handle :width
     1829               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1830             no-error .
     1831           if error-status :error
     1832           or error-status :get-message(1) <> ""
     1833           then do:
     1834             undo move_block, retry move_block .
     1835           end.
     1836         end.
     1837         assign
     1838           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1839           no-error .
     1840         if error-status :error
     1841         or error-status :get-message(1) <> ""
     1842         then do:
     1843           undo move_block, retry move_block.
     1844         end.
     1845         assign
     1846           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1847         no-error .
     1848         if error-status :error
     1849         or error-status :get-message(1) <> ""
     1850         then do:
     1851           undo move_block, retry move_block.
     1852         end.
     1853         if frame Dialog-Frame :scrollable = true
     1854         then do:
     1855           assign
     1856             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1857           no-error .
     1858           if error-status :error
     1859           or error-status :get-message(1) <> ""
     1860           then do:
     1861             undo move_block, retry move_block.
     1862           end.
     1863         end.
     1864       end.
     1865       if p-move-resize
     1866       then do:
     1867         run diasize_position-resize-button in this-procedure .
     1868       end.
     1869       if v-diasize-wndstore = true
     1870       then do:
     1871         if connected("ub") = true
     1872         then do:
     1873           define variable v-cntxt-db-num        as integer   no-undo .
     1874           define variable v-cntxt-userid        as character no-undo .
     1875           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1876                                             , OUTPUT v-cntxt-userid
     1877                                             ) .
     1878           run gbl/wndsizew.p
     1879             (input  v-cntxt-db-num
     1880             ,input  v-cntxt-userid
     1881             ,input  v-diasize-proc-name
     1882             ,input  'width':u
     1883             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1884             ) .
     1885         end.
     1886       end.
     1887     end.
     1888     assign
     1889       v-diasize-change-size = false
     1890     .
     1891   end procedure.
     1892   procedure diasize_set-width :
     1893     define input  parameter p-new-width  as decimal   no-undo .
     1894     define input  parameter p-move-resize as logical   no-undo .
     1895     do
     1896     on error undo, return error return-value
     1897     :
     1898       run diasize_change-width in this-procedure
     1899         (input  (p-new-width - frame Dialog-Frame :width)
     1900         ,input  p-move-resize
     1901         ) .
     1902     end.
     1903   end procedure.
     1904   procedure diasize_position-resize-button :
     1905     do with frame Dialog-Frame
     1906     :
     1907       hide v-diasize-resize-button .
     1908       assign
     1909         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1910                     - 1
     1911                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1912         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1913                     - 1
     1914                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1915       .
     1916       view v-diasize-resize-button .
     1917     end.
     1918   end procedure.
     1919   on alt-right anywhere
     1920   do:
     1921     run diasize_change-width in this-procedure
     1922       (input 1
     1923       ,input true
     1924       ) .
     1925     return no-apply .
     1926   end.
     1927   on alt-left anywhere
     1928   do:
     1929     run diasize_change-width in this-procedure
     1930       (input -1
     1931       ,input true
     1932       ) .
     1933     return no-apply .
     1934   end.
     1935   on alt-down anywhere
     1936   do:
     1937     run diasize_change-height in this-procedure
     1938       (input 1
     1939       ,input true
     1940       ) .
     1941     return no-apply .
     1942   end.
     1943   on alt-up anywhere
     1944   do:
     1945     run diasize_change-height in this-procedure
     1946       (input -1
     1947       ,input true
     1948       ) .
     1949     return no-apply .
     1950   end.
     1951   on alt-enter of frame Dialog-Frame
     1952   do:
     1953     run diasize_maximize in this-procedure
     1954       (input  ?
     1955       ).
     1956     return no-apply .
     1957   end.
     1958   procedure diasize_end-move :
     1959     do
     1960     on error undo, return error return-value
     1961     :
     1962       define variable v-row-delta as decimal   no-undo .
     1963       define variable v-col-delta as decimal   no-undo .
     1964       define variable v-new-row as decimal   no-undo .
     1965       define variable v-new-col as decimal   no-undo .
     1966       assign
     1967         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1968         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1969       .
     1970       assign
     1971         v-row-delta = v-new-row - frame Dialog-Frame :height
     1972         v-col-delta = v-new-col - frame Dialog-Frame :width
     1973       .
     1974       run diasize_change-height in this-procedure
     1975         (input v-row-delta
     1976         ,input true
     1977         ) .
     1978       run diasize_change-width in this-procedure
     1979         (input v-col-delta
     1980         ,input true
     1981         ) .
     1982     end.
     1983   end procedure.
     1984   procedure diasize_maximize :
     1985     define input  parameter p-action as logical   no-undo .
     1986     do
     1987     on error undo, return error return-value
     1988     :
     1989       if p-action = ?
     1990       then do:
     1991         if v-diasize-need-maximize = true
     1992         then do:
     1993           assign
     1994             p-action = true
     1995           .
     1996         end.
     1997         else do:
     1998           assign
     1999             p-action = false
     2000           .
     2001         end.
     2002       end.
     2003       if p-action = true
     2004       then do:
     2005         run diasize_change-height in this-procedure
     2006           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2007               - frame Dialog-Frame :height-chars
     2008           ,input true
     2009           ) .
     2010         run diasize_change-width in this-procedure
     2011           (input session :width-chars
     2012               - frame Dialog-Frame :width-chars
     2013           ,input true
     2014           ) .
     2015         assign
     2016           v-diasize-need-maximize = false
     2017         .
     2018       end.
     2019       else do:
     2020         run diasize_change-width in this-procedure
     2021           (input v-diasize-orig-frame-width
     2022               - frame Dialog-Frame :width-chars
     2023           ,input true
     2024           ) .
     2025         run diasize_change-height in this-procedure
     2026           (input v-diasize-orig-frame-height
     2027               - frame Dialog-Frame :height-chars
     2028           ,input true
     2029           ) .
     2030         assign
     2031           v-diasize-need-maximize = true
     2032         .
     2033       end.
     2034     end.
     2035   end procedure.
     2036   procedure diasize_restore-orig-size :
     2037     do
     2038     on error undo, return error return-value
     2039     :
     2040       assign
     2041         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2042         v-diasize-current-frame-height = frame Dialog-Frame :height
     2043       .
     2044       run diasize_set-height in this-procedure
     2045         (input  v-diasize-orig-frame-height
     2046         ,input  true
     2047         ) .
     2048       run diasize_set-width in this-procedure
     2049         (input  v-diasize-orig-frame-width
     2050         ,input  true
     2051         ) .
     2052     end.
     2053   end procedure.
     2054   procedure diasize_restore-current-size :
     2055     do
     2056     on error undo, return error return-value
     2057     :
     2058       run diasize_set-height in this-procedure
     2059         (input  v-diasize-current-frame-height
     2060         ,input  true
     2061         ) .
     2062       run diasize_set-width in this-procedure
     2063         (input  v-diasize-current-frame-width
     2064         ,input  true
     2065         ) .
     2066     end.
     2067   end procedure.
     2068   procedure diasize_set-browse-handle :
     2069     define input  parameter p-browse-handle as handle   no-undo .
     2070     define buffer buf_temp-browse-handle for temp-browse-handle .
     2071     do
     2072     on error undo, return error return-value
     2073     :
     2074       assign
     2075         v-diasize-browse-handle = p-browse-handle
     2076       .
     2077       for each buf_temp-browse-handle
     2078       on error undo, return error return-value
     2079       :
     2080         delete buf_temp-browse-handle .
     2081       end.
     2082     end.
     2083   end procedure.
     2084   procedure diasize_add_browse :
     2085     define input  parameter p-browse-type   as character no-undo .
     2086     define input  parameter p-browse-handle as handle    no-undo .
     2087     define buffer buf_temp-browse-handle for temp-browse-handle .
     2088     do
     2089     on error undo, return error return-value
     2090     :
     2091       assign
     2092         v-diasize-browse-number = v-diasize-browse-number + 1
     2093       .
     2094       create buf_temp-browse-handle .
     2095       assign
     2096         buf_temp-browse-handle.browse-type   = p-browse-type
     2097         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2098         buf_temp-browse-handle.browse-handle = p-browse-handle
     2099       .
     2100     end.
     2101   end procedure.
     2102   procedure diasize_init :
     2103     define variable v-default-value    as logical   no-undo .
     2104     define variable v-restore-saved    as logical   no-undo .
     2105     define variable v-resize-value-str as character no-undo .
     2106     do
     2107     on error undo, return error return-value
     2108     :
     2109       do with frame Dialog-Frame
     2110       :
     2111         assign
     2112           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2113           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2114           v-diasize-browse-handle     = browse BR-prn-grp :handle
     2115         .
     2116         create button v-diasize-resize-button
     2117         assign
     2118           parent        = frame Dialog-Frame :first-child
     2119           label         = "s"
     2120           height-pixels = 16
     2121           width-pixels  = 16
     2122           visible       = true
     2123           sensitive     = true
     2124           movable       = true
     2125           triggers:
     2126             on end-move persistent run diasize_end-move in this-procedure .
     2127           end triggers.
     2128         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2129         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2130         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2131         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2132         assign
     2133           v-diasize-wndmax = false
     2134         .
     2135         if connected("ub") = true
     2136         then do:
     2137           define variable v-cntxt-db-num        as integer   no-undo .
     2138           define variable v-cntxt-userid        as character no-undo .
     2139           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2140                                             , OUTPUT v-cntxt-userid
     2141                                             ) .
     2142           run gbl/wndpar_r.p
     2143             (input  v-cntxt-db-num
     2144             ,input  v-cntxt-userid
     2145             ,input  'wndmax':U
     2146             ,output v-diasize-wndmax
     2147             ,output v-default-value
     2148             ) .
     2149         end.
     2150         assign
     2151           v-diasize-wndstore = false
     2152         .
     2153         if connected("ub") = true
     2154         then do:
     2155           run gbl/wndpar_r.p
     2156             (input  v-cntxt-db-num
     2157             ,input  v-cntxt-userid
     2158             ,input  'wndstore':U
     2159             ,output v-diasize-wndstore
     2160             ,output v-default-value
     2161             ) .
     2162         end.
     2163         assign
     2164           v-diasize-proc-name = entry(1, program-name(2), '.')
     2165         .
     2166         if v-diasize-wndstore = true
     2167         then do:
     2168           assign
     2169             v-restore-saved = false
     2170           .
     2171           if connected("ub") = true
     2172           then do:
     2173             run gbl/wndsizer.p
     2174               (input  v-cntxt-db-num
     2175               ,input  v-cntxt-userid
     2176               ,input  v-diasize-proc-name
     2177               ,input  'height':u
     2178               ,output v-resize-value-str
     2179               ) .
     2180             if v-resize-value-str <> '':U
     2181             then do:
     2182               run diasize_change-height in this-procedure
     2183                 (input  integer(v-resize-value-str)
     2184                 ,input  true
     2185                 ) .
     2186               assign
     2187                 v-restore-saved = true
     2188               .
     2189             end.
     2190           end.
     2191           if connected("ub") = true
     2192           then do:
     2193             run gbl/wndsizer.p
     2194               (input  v-cntxt-db-num
     2195               ,input  v-cntxt-userid
     2196               ,input  v-diasize-proc-name
     2197               ,input  'width':u
     2198               ,output v-resize-value-str
     2199               ) .
     2200             if v-resize-value-str <> '':U
     2201             then do:
     2202               run diasize_change-width in this-procedure
     2203                 (input  integer(v-resize-value-str)
     2204                 ,input  true
     2205                 ) .
     2206               assign
     2207                 v-restore-saved = true
     2208               .
     2209             end.
     2210           end.
     2211           if v-restore-saved <> true
     2212           then do:
     2213             if v-diasize-wndmax = true
     2214             then do:
     2215               run diasize_maximize in this-procedure
     2216                 (input  true
     2217                 ) .
     2218             end.
     2219           end.
     2220         end.
     2221         else do:
     2222           if v-diasize-wndmax = true
     2223           then do:
     2224             run diasize_maximize in this-procedure
     2225               (input  true
     2226               ) .
     2227           end.
     2228         end.
     2229       end.
     2230     end.
     2231   end procedure.
     2232   procedure diasize_need-full-display :
     2233     define output parameter p-need-full-display as logical   no-undo .
     2234     do
     2235     on error undo, return error return-value
     2236     :
     2237       assign
     2238         p-need-full-display = v-diasize-need-full-display
     2239       .
     2240       assign
     2241         v-diasize-need-full-display = false
     2242       .
     2243     end.
     2244   end procedure.
     2245   procedure get-context :
     2246      define output parameter p-db-num as integer          no-undo.
     2247      define output parameter p-user-id as character        no-undo.
     2248      define variable v-login               as character    no-undo.
     2249      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2250      define buffer buf_user-login  for ub.user-login .
     2251      do
     2252      on error undo, return error
     2253      :
     2254            FIND FIRST buf_sys-ctrl no-lock.
     2255            ASSIGN
     2256               v-login = USERID("ub")
     2257               p-db-num = buf_sys-ctrl.db-num
     2258            .
     2259            FIND FIRST buf_user-login
     2260                 WHERE buf_user-login.db-num = p-db-num
     2261                   AND buf_user-login.user-login = v-login
     2262                 no-lock
     2263                 no-error
     2264                 .
     2265            IF AVAILABLE buf_user-login
     2266            THEN DO:
     2267               assign
     2268                  p-user-id = buf_user-login.user-id
     2269               .
     2270            END.
     2271      end.
     2272   end procedure.
     2273       run diasize_init in this-procedure .
     2274   MAIN-BLOCK:
     2275   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2276      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2277   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2278     run mainmenu_getcntxt in parparentproc
     2279       (output v-cntxt-db-num
     2280       ,output v-cntxt-userid
     2281       ,output v-cntxt-level
     2282       ,output v-cntxt-host-code-obj
     2283       ,output v-cntxt-obj-type
     2284       ,output v-cntxt-obj-code
     2285       ,output v-cntxt-db-num-obj
     2286       ,output v-cntxt-is-admin
     2287       ) .
     2288       CASE par-mode:
     2289         when "printer":U or when "printer-object" then do:
     2290           FIND FIRST buf_fbr-prn no-lock where
     2291                     buf_fbr-prn.db-num = p-db-num
     2292                 AND buf_fbr-prn.prn-num = p-prn-num no-error.
     2293           if not available buf_fbr-prn then do:
     2294                     message
     2295                     "Неверное значение параметров p-db-num и/или p-prn-num" p-db-num p-prn-num
     2296                     view-as alert-box error.
     2297                     return error.
     2298           end.
     2299         end.
     2300         when "db":U then do:
     2301           find first buf_db no-lock where
     2302                     buf_db.db-num = p-db-num no-error.
     2303           if not available buf_db then do:
     2304             message
     2305             "Неверное значение параметра p-db-num" p-db-num
     2306             view-as alert-box error.
     2307             return error.
     2308           end.
     2309         end.
     2310         when "group" then do:
     2311           find first buf_gds-grp no-lock where
     2312                       buf_gds-grp.node-code = p-node-code no-error .
     2313           if not available buf_gds-grp then do:
     2314             message
     2315             "Неверное значение параметра p-node-code" p-node-code
     2316             view-as alert-box error.
     2317             return error.
     2318           end.
     2319         end.
     2320         when "object":U or when "printer-object":U then do:
     2321           find first buf_clients no-lock where
     2322                     buf_clients.obj-type = p-obj-type
     2323                 AND buf_clients.obj-code = p-obj-code
     2324                       no-error .
     2325           if not available buf_clients then do:
     2326             message
     2327             "Неверное значение параметров p-obj-type и/или p-obj-code" p-obj-type p-obj-code
     2328             view-as alert-box error.
     2329             return error.
     2330           end.
     2331         end.
     2332       END CASE.
     2333     RUN MyEnable in this-procedure .
     2334     run OpenBr in this-procedure .
     2335     WAIT-FOR GO OF FRAME Dialog-Frame.
     2336   END.
     2337   RUN disable_UI.
     2338   PROCEDURE disable_UI :
     2339     HIDE FRAME Dialog-Frame.
     2340   END PROCEDURE.
     2341   PROCEDURE enable_UI :
     2342     ENABLE B-exit B-add B-delete B-chg B-print B-help BR-prn-grp
     2343         WITH FRAME Dialog-Frame.
     2344     VIEW FRAME Dialog-Frame.
     2345   END PROCEDURE.
     2346   PROCEDURE MyEnable :
     2347   ENABLE
     2348   B-exit
     2349   B-add when par-mode = "printer":U or par-mode = "group"
     2350   B-delete when par-mode = "printer":U or par-mode = "group"
     2351   b-chg when par-mode = "group"
     2352   b-print
     2353   B-Help
     2354   BR-prn-grp
     2355    WITH FRAME Dialog-Frame.
     2356   VIEW FRAME Dialog-Frame.
     2357   END PROCEDURE.
     2358   PROCEDURE OpenBr :
     2359   define variable title0 as character no-undo .
     2360   title0 = "Группы товаров на принтере кухни".
     2361   CASE par-mode:
     2362     when "printer":U then do:
     2363       ASSIGN frame Dialog-Frame:TITLE = title0 + " Принтер: "+  string(p-prn-num).
     2364       OPEN QUERY BR-prn-grp
     2365       FOR EACH buf_fbr-prn-grp NO-LOCK where
     2366               buf_fbr-prn-grp.prn-num = p-prn-num and
     2367               buf_fbr-prn-grp.db-num = p-db-num .
     2368       end.
     2369       when 'все':U then do:
     2370         ASSIGN frame Dialog-Frame:TITLE = title0 .
     2371         OPEN QUERY BR-prn-grp
     2372         FOR EACH buf_fbr-prn-grp NO-LOCK .
     2373       end.
     2374       when "db":U then do:
     2375         ASSIGN frame Dialog-Frame:TITLE = title0 + " БД: "+  string(p-db-num).
     2376         OPEN QUERY BR-prn-grp
     2377         FOR EACH buf_fbr-prn-grp NO-LOCK where buf_fbr-prn-grp.db-num = p-db-num.
     2378       end.
     2379       when "group":U then do:
     2380         ASSIGN frame Dialog-Frame:TITLE = title0 + " Группа товаров: "+  string(p-node-code).
     2381         OPEN QUERY BR-prn-grp
     2382         FOR EACH buf_fbr-prn-grp NO-LOCK where
     2383                 buf_fbr-prn-grp.node-code = p-node-code .
     2384       end.
     2385       when "object":U then do:
     2386         ASSIGN frame Dialog-Frame:TITLE = title0 + " Объект: "+ p-obj-type + string(p-obj-code).
     2387         OPEN QUERY BR-prn-grp
     2388         FOR EACH buf_fbr-prn-grp NO-LOCK where
     2389                 buf_fbr-prn-grp.obj-type = p-obj-type
     2390             AND buf_fbr-prn-grp.obj-code = p-obj-code .
     2391       end.
     2392       when "printer-object":U then do:
     2393         ASSIGN frame Dialog-Frame:TITLE = title0 + " Принтер: "+  string(p-prn-num) + " Объект: " + p-obj-type + string(p-obj-code).
     2394         OPEN QUERY BR-prn-grp
     2395         FOR EACH buf_fbr-prn-grp NO-LOCK where
     2396                 buf_fbr-prn-grp.prn-num = p-prn-num
     2397             AND buf_fbr-prn-grp.db-num = p-db-num
     2398             AND buf_fbr-prn-grp.obj-type = p-obj-type
     2399             AND buf_fbr-prn-grp.obj-code = p-obj-code .
     2400       end.
     2401   END CASE.
     2402   END PROCEDURE.
     2403   PROCEDURE proc-add :
     2404   define variable v-rec as recid no-undo.
     2405   define variable loc#log as logical no-undo .
     2406   define buffer loc_fbr-prn-grp for ub.fbr-prn-grp.
     2407   define buffer loc_gds-grp for ub.fbr-prn.
     2408   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2409   do:
     2410     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2411       (input  v-cntxt-db-num
     2412       ,input  v-cntxt-userid
     2413       ,input  0
     2414       ,input  'actn_fbr-prn_work':U
     2415       ,input  'global':U
     2416       ,input  0
     2417       ,input  '':U
     2418       ,input  0
     2419       ,input  0
     2420       ,input  0
     2421       ,input  0
     2422       ,input  true
     2423       ,output loc#log
     2424       )  .
     2425   end.
     2426   if not loc#log then return no-apply.
     2427   CASE par-mode:
     2428     when "group":U then do:
     2429       run ref/fprngrpi.w (
     2430                      input parparentproc
     2431                     ,input 'ДОБАВЛЕНИЕ':U
     2432                     ,input "group":U
     2433                     ,input 0
     2434                     ,input 0
     2435                     ,input "":U
     2436                     ,input 0
     2437                     ,input p-node-code
     2438                     ,input-output v-rec) no-error.
     2439       if error-status:error then return error.
     2440    end.
     2441    when "printer":u then do:
     2442       run ref/fprngrpi.w (
     2443                      input parparentproc
     2444                     ,input 'ДОБАВЛЕНИЕ':U
     2445                     ,input "printer":U
     2446                     ,input 0
     2447                     ,input p-prn-num
     2448                     ,input "":U
     2449                     ,input 0
     2450                     ,input 0
     2451                     ,input-output v-rec) no-error.
     2452       if error-status:error then return error.
     2453     end.
     2454   END CASE.
     2455   RUN OpenBr in this-procedure.
     2456   reposition BR-prn-grp to recid v-rec no-error.
     2457   APPLY "ENTRY" to br-prn-grp in frame Dialog-Frame.
     2458   END PROCEDURE.
     2459   PROCEDURE proc-chg :
     2460   define variable v-rec as recid no-undo.
     2461   define variable loc#log as logical no-undo .
     2462   if not available buf_fbr-prn-grp then return error.
     2463   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2464   do:
     2465     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2466       (input  v-cntxt-db-num
     2467       ,input  v-cntxt-userid
     2468       ,input  0
     2469       ,input  'actn_fbr-prn_work':U
     2470       ,input  'global':U
     2471       ,input  0
     2472       ,input  '':U
     2473       ,input  0
     2474       ,input  0
     2475       ,input  0
     2476       ,input  0
     2477       ,input  true
     2478       ,output loc#log
     2479       )  .
     2480   end.
     2481   if not loc#log then return no-apply.
     2482   run ref/fprngrpi.w (
     2483                  input parparentproc
     2484                 ,input 'ИЗМЕНЕНИЕ':U
     2485                 ,input "":U
     2486                 ,input buf_fbr-prn-grp.db-num
     2487                 ,input buf_fbr-prn-grp.prn-num
     2488                 ,input buf_fbr-prn-grp.obj-type
     2489                 ,input buf_fbr-prn-grp.obj-code
     2490                 ,input buf_fbr-prn-grp.node-code
     2491                 ,input-output v-rec) no-error.
     2492   if error-status:error then return error.
     2493   reposition BR-prn-grp to recid v-rec no-error.
     2494   APPLY "ENTRY" to br-prn-grp in frame Dialog-Frame.
     2495   END PROCEDURE.
     2496   PROCEDURE proc-print :
     2497   define variable v-fbr-obj-name as character no-undo.
     2498   define variable v-obj-name as character no-undo.
     2499   define variable v-grp-full as character no-undo.
     2500   define variable v-rec as recid no-undo.
     2501   define variable LIne as character no-undo.
     2502   define variable ii as integer no-undo.
     2503   DEFINE FRAME List
     2504   buf_fbr-prn-grp.prn-num COLUMN-LABEL "Принтер"
     2505   v-fbr-obj-name column-label "Установлен на" format "X(121)"
     2506   v-grp-full column-label "Группа" format "X(65)"
     2507   v-obj-name column-label "Объект" format "x(8)"
     2508    HEADER
     2509       cur-time-print() AT 5 format "x(35)"
     2510           string( "Страница " + string( PAGE-NUMBER( Prnlibstream ) , ">>9") )
     2511               AT 66 format "X(15)" SKIP
     2512       Line format "x(119)" AT 1
     2513   with width 160 down use-text stream-io no-box .
     2514   if num-results( "BR-prn-grp" ) = 0 then  do:
     2515       message "Список  П У С Т !" skip view-as alert-box information .
     2516       return error .
     2517   end.
     2518   if session:set-wait-state( "compiler" ) then .
     2519   Line = fill( "-" , 1196 ) .
     2520   v-rec = recid( buf_fbr-prn-grp ) .
     2521   DO WHILE available buf_fbr-prn-grp :
     2522       GET prev br-prn-grp NO-LOCK .
     2523   END.
     2524   GET next br-prn-grp NO-LOCK .
     2525   ii = 1 .
     2526   run prn-lib-open-stream  in this-procedure (
     2527                                                input parParentProc
     2528                                               ,input 62
     2529                                               ,input yes
     2530                                               ,input no
     2531                                               ).
     2532   FORM HEADER
     2533   Line format "X(116)" SKIP
     2534   "Продолжение - на следующей странице" AT 30 SKIP
     2535   with FRAME CliBottomFrame width 160 PAGE-BOTTOM NO-LABELS no-box.
     2536   VIEW stream Prnlibstream FRAME CliBottomFrame .
     2537   PUT stream Prnlibstream space(20) frame Dialog-Frame:title format "X(80)" SKIP(2) .
     2538   FORM with frame List .
     2539   DO WHILE available buf_fbr-prn-grp :
     2540       DISPLAY stream Prnlibstream
     2541           buf_fbr-prn-grp.prn-num
     2542           get-fbr-obj-name(buf_fbr-prn-grp.db-num, buf_fbr-prn-grp.prn-num) @ v-fbr-obj-name
     2543           get-grp-name(buf_fbr-prn-grp.node-code) @ v-grp-full
     2544           buf_fbr-prn-grp.obj-type + string(buf_fbr-prn-grp.obj-code) @ v-obj-name
     2545          with frame List .
     2546       DOWN stream Prnlibstream 1
     2547       with frame List .
     2548       ii =  ii + 1 .
     2549       if ( ( ii modulo 10 ) = 0 ) AND ( ii >= 10 ) then
     2550       run waitfram-show in this-procedure ("Просмотрено строк : " + string( ii ) ) .
     2551       GET next br-prn-grp .
     2552   END.
     2553   PUT stream Prnlibstream Line format "X(116)" SKIP.
     2554   HIDE stream Prnlibstream FRAME CliBottomFrame .
     2555   output stream Prnlibstream close .
     2556   run prn-lib-prn-file in this-procedure (
     2557                                             input parParentProc
     2558                                             ,input 0
     2559                                             ).
     2560   reposition br-prn-grp to recid v-rec NO-ERROR .
     2561   run waitfram-hide in this-procedure.
     2562   END PROCEDURE.
     2563   FUNCTION get-fbr-obj-name RETURNS CHARACTER
     2564     ( input p-db-num as integer, input p-prn-num as integer ) :
     2565   define buffer loc_clients for ub.clients.
     2566   CASE par-mode:
     2567       when "printer":U then do:
     2568       end.
     2569       when "db":U or when 'все':U then do:
     2570               find first buf_fbr-prn no-lock where
     2571                           buf_fbr-prn.db-num = p-db-num
     2572                       AND buf_fbr-prn.prn-num = p-prn-num no-error.
     2573               if not available buf_fbr-prn then return ?.
     2574       end.
     2575   END CASE.
     2576   return (buf_fbr-prn.fbr-obj-type + string(buf_fbr-prn.fbr-obj-code)).
     2577   END FUNCTION.
     2578   FUNCTION get-grp-name RETURNS CHARACTER
     2579     ( p-node-code as integer) :
     2580   define variable v-grp-name as character no-undo.
     2581   run grplib-get-full-name in this-procedure(p-node-code, output v-grp-name) no-error.
     2582   if length(v-grp-name) >  65 then do:
     2583       overlay( v-grp-name, length(v-grp-name) - 65 + 1, 3) = "...":U.
     2584   end.
     2585     RETURN v-grp-name.
     2586   END FUNCTION.
     2587   FUNCTION get-obj-name RETURNS CHARACTER
     2588     ( input p-obj-type as character, input p-obj-code as integer ) :
     2589   define buffer loc_clients for ub.clients.
     2590   find first loc_clients no-lock where
     2591           buf_clients.obj-type = p-obj-type
     2592       AND loc_clients.obj-code = p-obj-code no-error.
     2593       if available loc_clients then
     2594     RETURN loc_clients.obj-name.
     2595     return (p-obj-type + string(p-obj-code)).
     2596   END FUNCTION.
