      957   do:
      958     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      959       (input  v-cntxt-db-num
      960       ,input  v-cntxt-userid
      961       ,input  0
      962       ,input  'actn_fbr-prn_work':U
      963       ,input  'global':U
      964       ,input  0
      965       ,input  '':U
      966       ,input  0
      967       ,input  0
      968       ,input  0
      969       ,input  0
      970       ,input  true
      971       ,output loc#log
      972       )  .
