      838   procedure prn-lib-reportviewer :
      839     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      840     define input parameter p-report-name-html as character no-undo .
      841     define input parameter p-param        as character no-undo .
      842     define variable v-excel           as character no-undo init 'TRUE' .
      843     define variable v-value-character as character no-undo .
      844     define variable v-value-integer   as character no-undo .
      845     define variable v-value-date      as date      no-undo .
      846     define variable v-value-decimal   as decimal   no-undo .
      847     define variable rep-excel         as logical   no-undo .
      848     define variable excel-string      as character no-undo .
      849     define variable v-param-type      as character no-undo .
      850     define variable v-tth             as handle    no-undo .
      851     run adm/shattri.p (
      852       input "get":U
      853       ,input  ""
      854       ,input  0
      855       ,input  'report-glob':U
      856       ,input  'rep-excel':U
      857       ,output v-value-character
      858       ,output v-value-date
      859       ,output v-value-decimal
      860       ,output v-value-integer
      861       ,output rep-excel
      862       ,output v-param-type
      863       ,INPUT-OUTPUT table-handle v-tth
      864       )  .
      865     if rep-excel then v-excel = "TRUE" .
      866     else v-excel = "FALSE" .
      867     if p-param eq ""
      868     then
      869        p-param = "EXCEL:" + v-excel.
      870     else
      871        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      872     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      873   end procedure.
