      874   procedure thbjattr_code_reg :
      875   define input  parameter p-upper-code     as character no-undo .
      876   define input  parameter p-code           as character no-undo .
      877   define output parameter p-label          as character no-undo .
      878   define output parameter p-user-can-edit  as logical   no-undo .
      879   define output parameter p-output-display as logical   no-undo .
      880   define output parameter p-other          as character no-undo .
      881   define output parameter p-prop-list      as character no-undo .
      882   define output parameter p-prop-type-list as character no-undo .
      883   define output parameter p-prop-label-list as character no-undo .
      884   define output parameter p-global          as logical no-undo .
      885   define output parameter p-host           as logical no-undo .
      886   define output parameter p-shop           as logical no-undo .
      887   define output parameter p-store          as logical no-undo .
      888   define output parameter p-db             as logical no-undo .
      889   define output parameter p-region         as logical no-undo .
      890   do
      891   on error undo, return error return-value
      892   :
      893       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      894       (input  p-upper-code
      895       ,input  p-code
      896       ,output p-label
      897       ,output p-user-can-edit
      898       ,output p-output-display
      899       ,output p-other
      900       ,output p-prop-list
      901       ,output p-prop-type-list
      902       ,output p-prop-label-list
      903       ,output p-global
      904       ,output p-host
      905       ,output p-shop
      906       ,output p-store
      907       ,output p-db
      908       ,output p-region
      909       ) no-error .
      910     if error-status :error
      911     then do:
      912       undo, return error substitute( "&1. &2&3&4", vss-include-info7, return-value, chr(10), error-status :get-message (1)).
      913     end.
      914   end.
      915   end procedure.
