     2356   function fnc-convert-dot-to-colon returns character
     2357       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     2358   function fnc-convert-dot-to-colon returns character
     2359   (input p-data as decimal, input p-accur as character, input p-num as integer):
     2360       define variable result as character no-undo.
     2361       define variable v-str-result as character no-undo.
     2362       if p-data = ? then p-data = 0 .
     2363       p-data = round(p-data, p-num).
     2364       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     2365       return v-str-result.
     2366   END FUNCTION.
