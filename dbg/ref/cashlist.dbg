     5422                   frame Dialog-Frame:TITLE = substitute("Справочник касс БД: &1 - неудаленные", pardb-num).
     5423                 filter-point = filter-point0 + parref-mode.
     5424   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5425   define variable  l-disable-where-52  as logical   no-undo .
     5426   define variable  l-filter-open-52    as logical   .
     5427   define variable  flt-rec-52       as recid     no-undo .
     5428   define variable  filter-name-52      as character no-undo .
     5429   define variable  where-phrase-52     as character no-undo .
     5430   define variable  sort-phrase-52      as character no-undo .
     5431   define variable  where-phrase-rus-52 as character no-undo .
     5432   define variable  sort-phrase-rus-52  as character no-undo .
     5433     run waitfram-show in this-procedure
     5434       (input "ЖДИТЕ ..."
     5435       ).
     5436   run gbl/flt-get.p
     5437     (input filter-point
     5438     ,output flt-rec-52
     5439     ,output filter-name-52
     5440     ,output where-phrase-52
     5441     ,output sort-phrase-52
     5442     ,output where-phrase-rus-52
     5443     ,output sort-phrase-rus-52
     5444     ).
     5445       run set-filter-name in this-procedure
     5446         (INPUT filter-name-52
     5447         ) no-error .
     5448     assign
     5449       l-filter-open-52 = false
     5450     .
     5451     if flt-rec-52 <> ?
     5452       or sort-column-phrase > ""
     5453     then do:
     5454       define variable  parameter-2-52 as character no-undo .
     5455       define variable  parameter-3-52 as character no-undo .
     5456       define variable  parameter-4-52 as character no-undo .
     5457       define variable  parameter-5-52 as character no-undo .
     5458       define variable  parameter-6-52 as character no-undo .
     5459       define variable  parameter-7-52 as character no-undo .
     5460         assign
     5461         parameter-3-52 =
     5462                                 "FOR EACH X_cash-desk"
     5463         parameter-4-52 =
     5464           (
     5465             if (" X_cash-desk.db-num = pardb-num and X_cash-desk.is-del = no " + " " + where-phrase-52) <> ""
     5466             then  substitute('X_cash-desk.db-num = &1 and X_cash-desk.is-del = no ', pardb-num)  + " " + where-phrase-52
     5467             else "true"
     5468           )
     5469         parameter-5-52 = (" " + "" + " " + "")
     5470         parameter-6-52 = if sort-phrase-52 = ''
     5471                              then
     5472           (
     5473           " " + "  " +
     5474             " " + sort-column-phrase +
     5475           " " + " by X_cash-desk.db-num by X_cash-desk.is-del by X_cash-desk.obj-code by X_cash-desk.cash-num "
     5476           )
     5477                              else
     5478           (
     5479           " " + "  " +
     5480             " " + sort-column-phrase +
     5481           " " + sort-phrase-52
     5482           )
     5483         parameter-7-52 =
     5484           "   "
     5485       .
     5486       do
     5487       on stop undo, leave
     5488       on error undo, leave
     5489       :
     5490         assign
     5491           l-disable-where-52 =
     5492             (" X_cash-desk.db-num = pardb-num and X_cash-desk.is-del = no " + " " + where-phrase-52 = "")
     5493         .
     5494         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     5495                             ,input query br-cash-desk:handle
     5496                             ,input parameter-3-52
     5497                             ,input parameter-4-52
     5498                             ,input parameter-5-52
     5499                             ,input parameter-6-52
     5500                             ,input parameter-7-52
     5501                             )
     5502         .
     5503         assign
     5504           l-filter-open-52 = true
     5505         .
     5506       end.
     5507       if l-filter-open-52 = false then do:
     5508         message
     5509           "Ошибка при фильтрации / сортировке" skip
     5510           "Будут показаны записи без учета фильтра" skip
     5511           view-as alert-box .
     5512       end.
     5513       else do:
     5514           assign
     5515             l-query-was-opened = true
     5516           .
     5517       end.
     5518     end.
     5519     if l-filter-open-52 = false then do:
     5520       OPEN QUERY br-cash-desk FOR EACH X_cash-desk
     5521         where  X_cash-desk.db-num = pardb-num and X_cash-desk.is-del = no
     5522          by X_cash-desk.db-num by X_cash-desk.is-del by X_cash-desk.obj-code by X_cash-desk.cash-num
     5523     .
     5524         assign
     5525           l-query-was-opened = true
     5526         .
     5527     end.
     5528     run waitfram-hide in this-procedure .
     5529               END.
     5530           END CASE.
     5531         end.
     5532     END CASE.
     5533     apply "entry" to br-cash-desk in frame Dialog-Frame.
     5534     if p-rec <> ? then reposition br-cash-desk to recid p-rec no-error.
     5535     if error-status:error then
     5536     do:
     5537       reposition br-cash-desk to row 1 no-error.
     5538     end.
     5539     run waitfram-hide in this-procedure .
     5540     if avail X_cash-desk then
     5541       APPLY "VALUE-CHANGED":U to br-cash-desk.
     5542   END PROCEDURE.
     5543   PROCEDURE proc-b-print :
     5544     define VARIABLE p-report-id         as character no-undo .
     5545     define variable v-file-name-rep-htm as character no-undo .
     5546     run get-report-num (output p-report-id).
     5547     v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     5548     define variable ii              as integer   no-undo.
     5549     define variable StartRecid      as integer   no-undo.
     5550     define variable v-fo-version    as CHARACTER no-undo.
     5551     define variable v-OptVer        as CHARACTER no-undo.
     5552     define variable v-ffd-version   as CHARACTER no-undo.
     5553     define variable v-GISMT_TIMEOUT as CHARACTER no-undo.
     5554     define variable v-GISMT_FAST    as CHARACTER no-undo.
     5555     define variable v-date          as CHARACTER no-undo.
     5556     define variable v-time          as CHARACTER no-undo.
     5557     define variable v-kkt-schema    as CHARACTER no-undo.
     5558     define variable v-autonomy      as character no-undo .
     5559     define variable v-addr-path     as character no-undo .
     5560     define variable v-signExecution as character no-undo .
     5561     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     5562     put stream OutStr-html unformatted
     5563       "<!DOCTYPE HTML>" skip
     5564       ' <html>' skip
     5565       '  <head>' skip
     5566       '   <meta charset="utf-8">' skip
     5567       '    <style type="text/css">' skip
     5568       '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     5569       '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     5570       '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     5571       '   </style>' skip
     5572       '  </head>' skip
     5573       .
     5574     put stream OutStr-html unformatted
     5575       '<body>' skip
     5576       '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     5577       '<thead>' skip
     5578       .
     5579     put stream OutStr-html unformatted
     5580       '<tr class="set_columns">' skip
     5581       '<td style="width: 60px;"></td>' skip
     5582       '<td style="width: 20px;"></td>' skip
     5583       '<td style="width: 40px;"></td>' skip
     5584       '<td style="width: 60px;"></td>' skip
     5585       '<td style="width: 80px;"></td>' skip
     5586       '<td style="width: 100px;"></td>' skip
     5587       '<td style="width: 50px;"></td>' skip
     5588       '<td style="width: 50px;"></td>' skip
     5589       '<td style="width: 100px;"></td>' skip
     5590       '<td style="width: 100px;"></td>' skip
     5591       '<td style="width: 70px;"></td>' skip
     5592       '<td style="width: 120px;"></td>' skip
     5593       '<td style="width: 100px;"></td>' skip
     5594       '<td style="width: 70px;"></td>' skip
     5595       '<td style="width: 70px;"></td>' skip
     5596       '<td style="width: 70px;"></td>' skip
     5597       '<td style="width: 70px;"></td>' skip
     5598       '<td style="width: 70px;"></td>' skip
     5599       '</tr>' skip
     5600       .
     5601     put stream OutStr-html unformatted
     5602       '<TR><TD colspan="18"></TD></TR>' skip
     5603       '<TR>' skip
     5604       '<Td colspan="18" style="height: 14px; text-align: center; font-weight: bold;">СПРАВОЧНИК КАСС</Td>' skip
     5605       '</TR>'skip
     5606       '</thead>' skip
     5607       '<tbody>' skip
     5608       '<tr>' skip
     5609       '<th rowspan="2" text_wrap="true" style="text-align: center;">Магазин</th>' skip
     5610       '<th rowspan="2" text_wrap="true" style="text-align: center;">БД</th>' skip
     5611       '<th rowspan="2" text_wrap="true" style="text-align: center;">Номер</th>' skip
     5612       '<th rowspan="2" text_wrap="true" style="text-align: center;">Тип POS</th>' skip
     5613       '<th rowspan="2" text_wrap="true" style="text-align: center;">Активность</th>' skip
     5614       '<th rowspan="2" text_wrap="true" style="text-align: center;">Адрес (путь к кассе)</th>' skip
     5615       '<th rowspan="2" text_wrap="true" style="text-align: center;">Тип ОС</th>' skip
     5616       '<th rowspan="2" text_wrap="true" style="text-align: center;">Признак исполнения</th>' skip
     5617       '<th rowspan="2" text_wrap="true" style="text-align: center;">Статус</th>' skip
     5618       '<th rowspan="2" text_wrap="true" style="text-align: center;">Удаленная дистанционно</th>' skip
     5619       '<th rowspan="2" text_wrap="true" style="text-align: center;">Версия протокола</th>' skip
     5620       '<th rowspan="2" text_wrap="true" style="text-align: center;">Версия кассовой программы</th>' skip
     5621       '<th rowspan="2" text_wrap="true" style="text-align: center;">Версия ПО «Коннектор»</th>' skip
     5622       '<th rowspan="2" text_wrap="true" style="text-align: center;">Схема интеграции ККТ</th>' skip
     5623       '<th rowspan="2" text_wrap="true" style="text-align: center;">Версия ФФД</th>' skip
     5624       '<th rowspan="2" text_wrap="true" style="text-align: center;">Таймаут ответа ГИСМТ</th>' skip
     5625       '<th rowspan="2" text_wrap="true" style="text-align: center;">Быстрый ответ ГИСМТ</th>' skip
     5626       '<th colspan="2" text_wrap="true" style="text-align: center;">Дата/время последнего опроса касс</th>' skip
     5627       '</tr>' skip
     5628       '<tr>' skip
     5629       '<td text_wrap="true" style="text-align: center;">Дата</td>' skip
     5630       '<td text_wrap="true" style="text-align: center;">Время</td>' skip
     5631       '</tr>' skip
     5632       .
     5633     put stream OutStr-html unformatted
     5634       '<tr>' skip
     5635       '<td style="text-align: center;">1</td>' skip
     5636       '<td style="text-align: center;">2</td>' skip
     5637       '<td style="text-align: center;">3</td>' skip
     5638       '<td style="text-align: center;">4</td>' skip
     5639       '<td style="text-align: center;">5</td>' skip
     5640       '<td style="text-align: center;">6</td>' skip
     5641       '<td style="text-align: center;">7</td>' skip
     5642       '<td style="text-align: center;">8</td>' skip
     5643       '<td style="text-align: center;">9</td>' skip
     5644       '<td style="text-align: center;">10</td>' skip
     5645       '<td style="text-align: center;">11</td>' skip
     5646       '<td style="text-align: center;">12</td>' skip
     5647       '<td style="text-align: center;">13</td>' skip
     5648       '<td style="text-align: center;">14</td>' skip
     5649       '<td style="text-align: center;">15</td>' skip
     5650       '<td style="text-align: center;">16</td>' skip
     5651       '<td style="text-align: center;">17</td>' skip
     5652       '<td style="text-align: center;">18</td>' skip
     5653       '<td style="text-align: center;">19</td>' skip
     5654       '</tr>' skip
     5655       .
     5656     define variable vQuery as handle no-undo.
     5657     vQuery = query br-cash-desk:handle.
     5658     do while available X_cash-desk:
     5659       put stream OutStr-html unformatted
     5660         '<tr>' skip
     5661         '<td text_wrap="true" style="text-align: center;">' + string(X_cash-desk.obj-code) + '</td>' skip
     5662         '<td text_wrap="true" style="text-align: center;">' + string(X_cash-desk.db-num) + '</td>' skip
     5663         '<td text_wrap="true" style="text-align: center;">' + string(X_cash-desk.cash-num) + '</td>' skip
     5664         '<td text_wrap="true" style="text-align: center;">' + string(X_cash-desk.pos-type) + '</td>' skip
     5665         .
     5666       case X_cash-desk.autonomy:
     5667         when 0 then
     5668           v-autonomy = 'Автономная касса':U .
     5669         when 1 then
     5670           v-autonomy = 'Подчиненная касса':U .
     5671         when 2 then
     5672           v-autonomy = 'Кассовый менеджер':U .
     5673       end case .
     5674       put stream OutStr-html unformatted
     5675         '<td text_wrap="true" style="text-align: center;">' + v-autonomy  + '</td>' skip .
     5676       if X_cash-desk.pos-type = 'IBM-XML':U or X_cash-desk.pos-type = 'Autotank':U then
     5677       do:
     5678         if num-entries(X_cash-desk.addr-path, chr(4)) > 1 then
     5679           v-addr-path = (entry(1, X_cash-desk.addr-path, chr(4)) + ":\\":U + entry(2, X_cash-desk.addr-path, chr(4))) .
     5680         else v-addr-path = X_cash-desk.addr-path .
     5681       end.
     5682       else v-addr-path = X_cash-desk.addr-path .
     5683       put stream OutStr-html unformatted
     5684         '<td text_wrap="true" style="text-align: center;">' + string(v-addr-path) + '</td>' skip
     5685         '<td text_wrap="true" style="text-align: center;">' + string(X_cash-desk.cash-os) + '</td>' skip
     5686         .
     5687       v-signExecution = signExecution(X_cash-desk.device-kind) .
     5688       put stream OutStr-html unformatted
     5689         '<td text_wrap="true" style="text-align: center;">' + string(v-signExecution) + '</td>' skip
     5690         .
     5691       put stream OutStr-html unformatted
     5692         '<td text_wrap="true" style="text-align: center;">' + string(if X_cash-desk.is-del then 'удал':U else 'тек':U) + '</td>' skip
     5693         '<td text_wrap="true" style="text-align: center;">' + string((if X_cash-desk.remote = 1 then '+' else ' ')) + '</td>' skip
     5694         '<td text_wrap="true" style="text-align: center;">' + if X_cash-desk.version <> ? then string(X_cash-desk.version) + '</td>' else "" + '</td>'skip
     5695         .
     5696       v-fo-version = get-fo-version( X_cash-desk.db-num, X_cash-desk.obj-code, X_cash-desk.pos-type, X_cash-desk.cash-num) .
     5697       if v-fo-version = ? then v-fo-version = "" .
     5698       put stream OutStr-html unformatted
     5699         '<td text_wrap="true" style="text-align: center;">' + string(v-fo-version) + '</td>' skip
     5700         .
     5701       v-OptVer = get-OptVer( X_cash-desk.db-num, X_cash-desk.obj-code, X_cash-desk.pos-type, X_cash-desk.cash-num) .
     5702       if (v-OptVer = ? or v-OptVer = '?') then v-OptVer = "" .
     5703       put stream OutStr-html unformatted
     5704         '<td text_wrap="true" style="text-align: center;">' + v-OptVer + '</td>' skip
     5705         .
     5706       v-kkt-schema = get-kkt-schema( X_cash-desk.db-num, X_cash-desk.obj-code, X_cash-desk.pos-type, X_cash-desk.cash-num) .
     5707       if v-kkt-schema = ? then v-kkt-schema = " - " .
     5708       put stream OutStr-html unformatted
     5709         '<td text_wrap="true" style="text-align: center;">' + string(v-kkt-schema) + '</td>' skip
     5710         .
     5711       v-ffd-version = get-ffd-version( X_cash-desk.db-num, X_cash-desk.obj-code, X_cash-desk.pos-type, X_cash-desk.cash-num) .
     5712       if v-ffd-version = ? then v-ffd-version = " - " .
     5713       put stream OutStr-html unformatted
     5714         '<td text_wrap="true" style="text-align: center;">' + string(v-ffd-version) + '</td>' skip
     5715         .
     5716       v-GISMT_TIMEOUT = string(get-GISMT_TIMEOUT( X_cash-desk.db-num, X_cash-desk.obj-code, X_cash-desk.pos-type, X_cash-desk.cash-num)) .
     5717       if v-GISMT_TIMEOUT = ? then v-GISMT_TIMEOUT = " - " .
     5718       put stream OutStr-html unformatted
     5719         '<td text_wrap="true" style="text-align: center;">' + string(v-GISMT_TIMEOUT) + '</td>' skip
     5720         .
     5721       v-GISMT_FAST = string(get-GISMT_FAST( X_cash-desk.db-num, X_cash-desk.obj-code, X_cash-desk.pos-type, X_cash-desk.cash-num)) .
     5722       if v-GISMT_FAST = ? then v-GISMT_FAST = " - " .
     5723       put stream OutStr-html unformatted
     5724         '<td text_wrap="true" style="text-align: center;">' + string(v-GISMT_FAST) + '</td>' skip
     5725         .
     5726       v-date = get-date( X_cash-desk.db-num, X_cash-desk.obj-code, X_cash-desk.pos-type, X_cash-desk.cash-num) .
     5727       if v-date = "" then v-date = " - " .
     5728       put stream OutStr-html unformatted
     5729         '<td text_wrap="true" style="text-align: center;">' + string(v-date) + '</td>' skip
     5730         .
     5731       v-time = get-time( X_cash-desk.db-num, X_cash-desk.obj-code, X_cash-desk.pos-type, X_cash-desk.cash-num) .
     5732       if v-time = "" then v-time = " - " .
     5733       put stream OutStr-html unformatted
     5734         '<td text_wrap="true" style="text-align: center;">' + string(v-time) + '</td>' skip
     5735         .
     5736       put stream OutStr-html unformatted
     5737         '</tr>' skip
     5738         .
     5739       ii =  ii + 1 .
     5740       if ( ( ii modulo 10 ) = 0 ) AND ( ii >= 10 ) then
     5741       do:
     5742         run waitfram-show in this-procedure ( "Просмотрено строк : " + string( ii ) ) .
     5743       end.
     5744       GET NEXT br-cash-desk.
     5745     END.
     5746     put stream OutStr-html unformatted
     5747       '</tbody>' skip
     5748       '</table>' skip
     5749       '</body>' skip
     5750       '</html>' skip
     5751       .
     5752     output stream OutStr-html close.
     5753     run prn-lib-reportviewer-report-name in this-procedure (
     5754       input parparentproc
     5755       ,input v-file-name-rep-htm
     5756       ) .
     5757     if error-status:error then
     5758     do:
     5759       message return-value view-as alert-box.
     5760       return .
     5761     end.
     5762     run waitfram-hide in this-procedure .
     5763   END PROCEDURE.
     5764   PROCEDURE proc-b-sch :
     5765     assign
     5766       tbl      = 'cash-desk'
     5767       join-tbl = 'X_cash-desk'
     5768       fld      = ""
     5769       lab      = ""
     5770       spr      = ""
     5771       dim      = '0'
     5772       .
     5773     run fltfield-add in this-procedure('autonomy', 'Активность', '',
     5774       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5775     run fltfield-add in this-procedure('db-num', 'БД', '',
     5776       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5777     run fltfield-add in this-procedure('obj-code', 'Код объекта', '',
     5778       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5779     run fltfield-add in this-procedure('cash-num', 'Номер', '',
     5780       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5781     run fltfield-add in this-procedure('pos-type', 'Тип POS', 'cd-types-real',
     5782       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5783     run fltfield-add in this-procedure('cash-on', 'Вкл', '',
     5784       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5785     run fltfield-add in this-procedure('addr-path', 'Адрес (путь к кассе)', '',
     5786       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5787     run fltfield-add in this-procedure('is-del', 'Удал.?', '',
     5788       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5789     run fltfield-add in this-procedure('registration-code', 'Регистрационный №', '',
     5790       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5791     run fltfield-add in this-procedure('serial-code', 'Серийный №', '',
     5792       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5793     run fltfield-add in this-procedure('device-kind', 'Признак исполнения', 'cd-device-kind',
     5794       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5795     DO on stop undo, leave:
     5796       run gbl/filter.w ( input parparentproc
     5797         ,input (filter-point0 + parref-mode + chr(4) +
     5798         filter-label  + chr(4) +
     5799         string(yes))
     5800         ,input tbl
     5801         ,input join-tbl
     5802         ,input fld
     5803         ,input lab
     5804         ,input spr
     5805         ,input dim).
     5806       RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     5807     END .
     5808   END PROCEDURE.
     5809   PROCEDURE proc-b-version :
     5810     define variable v-uniq-key-rec as character no-undo .
     5811     define variable glog           as logical   no-undo .
     5812     message
     5813       substitute("Проверить и изменить в справочнике касс (если неверная) версию ПО для кассы &1", X_cash-desk.cash-num)
     5814       view-as alert-box question buttons yes-no update glog.
     5815     if not glog then return.
     5816     run gen-key-rec in this-procedure ( input 'cash-desk':U
     5817       ,input (buffer X_cash-desk:handle)
     5818       ,output v-uniq-key-rec).
     5819     run str/diallog.w ( input parparentproc
     5820       ,input this-procedure
     5821       ,input 'str/get-chkf.p':U
     5822       ,input (v-cntxt-obj-type + chr(4) +
     5823       string(v-cntxt-obj-code) + chr(4) +
     5824       string(0) + chr(4) +
     5825       string(0) + chr(4) +
     5826       chr(4) +
     5827       chr(4) +
     5828       chr(4) +
     5829       substitute("&1=version,&2"
     5830       ,X_cash-desk.pos-type
     5831       ,v-uniq-key-rec)
     5832       )
     5833       ,input no
     5834       ,input ''
     5835       ,input 'Получение версии ПО кассы') .
     5836     run OpenBr in this-procedure  ( input yes, input no, input '':U).
     5837   END PROCEDURE.
     5838   PROCEDURE get-report-num :
     5839     define output parameter p-report-num as integer no-undo .
     5840     do
     5841       on error undo, return error return-value
     5842       :
     5843       run gbl/getrpnum.p (output p-report-num).
     5844     end.
     5845   END PROCEDURE.
     5846   FUNCTION cash-desk-auto RETURNS CHARACTER
     5847     ( p-autonomy AS INTEGER ) :
     5848     RETURN entry (lookup (string(p-autonomy), '0,1,2':U), 'Автономная касса,Подчиненная касса,Кассовый менеджер':U).
     5849   END FUNCTION.
     5850   FUNCTION signExecution RETURNS CHARACTER
     5851     ( INPUT p-device-kind AS INTEGER) :
     5852     return mdevice:GetLabel(integer(p-device-kind)).
     5853   END FUNCTION.
     5854   FUNCTION get-fo-version RETURNS CHARACTER
     5855     ( INPUT p-db-num AS INTEGER
     5856     ,INPUT p-obj-code AS INTEGER
     5857     ,INPUT p-pos-type AS CHARACTER
     5858     ,INPUT  p-cash-num AS INTEGER) :
     5859     DEFINE VARIABLE v-dop        AS CHARACTER NO-UNDO.
     5860     DEFINE VARIABLE v-fo-version AS CHARACTER NO-UNDO.
     5861     define variable v-date       as date      no-undo .
     5862     define variable v-decimal    as decimal   no-undo .
     5863     define variable v-integer    as integer   no-undo .
     5864     define variable v-logical    as logical   no-undo .
     5865     run cd-attr-value in this-procedure (
     5866       input   p-db-num
     5867       ,input  p-obj-code
     5868       ,input  p-pos-type
     5869       ,input  p-cash-num
     5870       ,input  (if p-pos-type = 'IBM-XML':U
     5871       then 'IBM-XML_operative':U
     5872       else 'AUTOTANK_operative':U)
     5873       ,input  (if p-pos-type = 'IBM-XML':U
     5874       then 'fo-version':U
     5875       else 'fo-version':U)
     5876       ,output v-fo-version
     5877       ,output v-date
     5878       ,output v-decimal
     5879       ,output v-integer
     5880       ,output v-logical
     5881       ,output v-dop) no-error.
     5882     RETURN v-fo-version.
     5883   END FUNCTION.
     5884   FUNCTION get-OptVer RETURNS CHARACTER
     5885     ( INPUT p-db-num AS INTEGER
     5886     ,INPUT p-obj-code AS INTEGER
