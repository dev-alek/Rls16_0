     3273   ON VALUE-CHANGED OF BR-cash-desk IN FRAME Dialog-Frame
     3274     DO:
     3275       assign
     3276         MENU-ITEM m_lookup-attr:sensitive in menu menu-b-attr     = no
     3277         MENU-ITEM m_update-attr:sensitive in menu menu-b-attr     = no
     3278         MENU-ITEM m_lookup-attr-2:sensitive in menu menu-b-attr-2 = no
     3279         MENU-ITEM m_update-attr-2:sensitive in menu menu-b-attr-2 = no
     3280         .
     3281       IF NOT AVAILABLE X_cash-desk THEN
     3282       DO:
     3283         DISABLE
     3284           b-version
     3285           with FRAME Dialog-Frame.
     3286       END.
     3287       ELSE
     3288       DO:
     3289         CASE X_cash-desk.pos-type:
     3290           WHEN 'IBM-XML':U OR
     3291           WHEN 'Autotank':U THEN
     3292             DO:
     3293               enable
     3294                 b-version
     3295                 when parref-mode <> 'все':U
     3296                 with FRAME Dialog-Frame.
     3297               assign
     3298                 MENU-ITEM m_lookup-attr:sensitive in menu menu-b-attr     = yes
     3299                 MENU-ITEM m_update-attr:sensitive in menu menu-b-attr     = yes
     3300                 MENU-ITEM m_lookup-attr-2:sensitive in menu menu-b-attr-2 = yes
     3301                 MENU-ITEM m_update-attr-2:sensitive in menu menu-b-attr-2 = yes
     3302                 .
     3303             END.
     3304           when 'IBS-TH':U then
     3305             do:
     3306               assign
     3307                 MENU-ITEM m_lookup-attr:sensitive in menu menu-b-attr     = yes
     3308                 MENU-ITEM m_update-attr:sensitive in menu menu-b-attr     = no
     3309                 MENU-ITEM m_lookup-attr-2:sensitive in menu menu-b-attr-2 = yes
     3310                 MENU-ITEM m_update-attr-2:sensitive in menu menu-b-attr-2 = yes
     3311                 .
     3312             end.
     3313           OTHERWISE
     3314           DO:
     3315             DISABLE
     3316               b-version
     3317               with FRAME Dialog-Frame.
     3318             assign
     3319               MENU-ITEM m_lookup-attr:sensitive in menu menu-b-attr     = yes
     3320               MENU-ITEM m_update-attr:sensitive in menu menu-b-attr     = yes
     3321               MENU-ITEM m_lookup-attr-2:sensitive in menu menu-b-attr-2 = yes
     3322               MENU-ITEM m_update-attr-2:sensitive in menu menu-b-attr-2 = yes
     3323               .
     3324           END.
     3325         END CASE.
     3326       END.
     3327     END.
