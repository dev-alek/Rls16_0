      846      define output parameter p-other          as character no-undo .
      847      define output parameter p-prop-list      as character no-undo .
      848      define output parameter p-prop-type-list as character no-undo .
      849      define output parameter p-prop-label-list as character no-undo .
      850      define output parameter p-global          as logical no-undo .
      851      define output parameter p-host           as logical no-undo .
      852      define output parameter p-shop           as logical no-undo .
      853      define output parameter p-store          as logical no-undo .
