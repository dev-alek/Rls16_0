     3203       ,output v-value-date31
     3204       ,output v-value-decimal31
     3205       ,output v-value-integer31
     3206       ,output cas-shft
     3207       ,output v-param-type31
     3208       ,INPUT-OUTPUT table-handle v-tth31
     3209       )  .
     3210   delete object v-tth31.
     3211       if cas-shft then
     3212       do:
     3213   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3214   define variable v-param-type32 as character no-undo .
     3215   define variable v-value-character32 as character no-undo .
     3216   define variable v-value-date32 as date no-undo .
     3217   define variable v-value-decimal32 as decimal no-undo .
     3218   define variable v-value-logical32 as INTEGER no-undo .
