     3174   ON CHOOSE OF B-shft IN FRAME Dialog-Frame
     3175     DO:
     3176       define variable old-list-mode as char.
     3177       define variable v-shft        as integer no-undo init 0.
     3178       define variable cas-shft      as logical no-undo.
     3179       define buffer check_cash-desk for ub.cash-desk.
     3180       if not available X_cash-desk then return no-apply.
     3181       FIND FIRST check_cash-desk where
     3182         recid(check_cash-desk) = recid(X_cash-desk) no-error.
     3183       if not avail check_cash-desk then return no-apply.
     3184       FIND FIRST ub.shop No-LOCK WHERE
     3185         ub.shop.obj-code = check_cash-desk.obj-code No-ERROR.
     3186       if not avail ub.shop then return no-apply.
     3187       find first ub.sysconf No-LOCK WHERE
     3188         ub.sysconf.host-code = ub.shop.host-code.
     3189   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3190   define variable v-param-type31 as character no-undo .
     3191   define variable v-value-character31 as character no-undo .
