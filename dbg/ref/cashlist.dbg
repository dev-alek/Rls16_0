     4492   procedure diasize_init :
     4493     define variable v-default-value    as logical   no-undo .
     4494     define variable v-restore-saved    as logical   no-undo .
     4495     define variable v-resize-value-str as character no-undo .
     4496     do
     4497     on error undo, return error return-value
     4498     :
     4499       do with frame Dialog-Frame
     4500       :
     4501         assign
     4502           v-diasize-orig-frame-height = frame Dialog-Frame :height
     4503           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     4504           v-diasize-browse-handle     = browse BR-cash-desk :handle
     4505         .
     4506         create button v-diasize-resize-button
     4507         assign
     4508           parent        = frame Dialog-Frame :first-child
     4509           label         = "s"
     4510           height-pixels = 16
     4511           width-pixels  = 16
     4512           visible       = true
     4513           sensitive     = true
     4514           movable       = true
     4515           triggers:
     4516             on end-move persistent run diasize_end-move in this-procedure .
     4517           end triggers.
     4518         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4519         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4520         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4521         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4522         assign
     4523           v-diasize-wndmax = false
     4524         .
     4525         if connected("ub") = true
     4526         then do:
     4527           define variable v-cntxt-db-num        as integer   no-undo .
     4528           define variable v-cntxt-userid        as character no-undo .
     4529           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4530                                             , OUTPUT v-cntxt-userid
     4531                                             ) .
     4532           run gbl/wndpar_r.p
     4533             (input  v-cntxt-db-num
     4534             ,input  v-cntxt-userid
     4535             ,input  'wndmax':U
     4536             ,output v-diasize-wndmax
     4537             ,output v-default-value
     4538             ) .
     4539         end.
     4540         assign
     4541           v-diasize-wndstore = false
     4542         .
     4543         if connected("ub") = true
     4544         then do:
     4545           run gbl/wndpar_r.p
     4546             (input  v-cntxt-db-num
     4547             ,input  v-cntxt-userid
     4548             ,input  'wndstore':U
     4549             ,output v-diasize-wndstore
     4550             ,output v-default-value
     4551             ) .
     4552         end.
     4553         assign
     4554           v-diasize-proc-name = entry(1, program-name(2), '.')
     4555         .
     4556         if v-diasize-wndstore = true
     4557         then do:
     4558           assign
     4559             v-restore-saved = false
     4560           .
     4561           if connected("ub") = true
     4562           then do:
     4563             run gbl/wndsizer.p
     4564               (input  v-cntxt-db-num
     4565               ,input  v-cntxt-userid
     4566               ,input  v-diasize-proc-name
     4567               ,input  'height':u
     4568               ,output v-resize-value-str
     4569               ) .
     4570             if v-resize-value-str <> '':U
     4571             then do:
     4572               run diasize_change-height in this-procedure
     4573                 (input  integer(v-resize-value-str)
     4574                 ,input  true
     4575                 ) .
     4576               assign
     4577                 v-restore-saved = true
     4578               .
     4579             end.
     4580           end.
     4581           if connected("ub") = true
     4582           then do:
     4583             run gbl/wndsizer.p
     4584               (input  v-cntxt-db-num
     4585               ,input  v-cntxt-userid
     4586               ,input  v-diasize-proc-name
     4587               ,input  'width':u
     4588               ,output v-resize-value-str
     4589               ) .
     4590             if v-resize-value-str <> '':U
     4591             then do:
     4592               run diasize_change-width in this-procedure
     4593                 (input  integer(v-resize-value-str)
     4594                 ,input  true
     4595                 ) .
     4596               assign
     4597                 v-restore-saved = true
     4598               .
     4599             end.
     4600           end.
     4601           if v-restore-saved <> true
     4602           then do:
     4603             if v-diasize-wndmax = true
     4604             then do:
     4605               run diasize_maximize in this-procedure
     4606                 (input  true
     4607                 ) .
     4608             end.
     4609           end.
     4610         end.
     4611         else do:
     4612           if v-diasize-wndmax = true
     4613           then do:
     4614             run diasize_maximize in this-procedure
     4615               (input  true
     4616               ) .
     4617           end.
     4618         end.
     4619       end.
     4620     end.
     4621   end procedure.
     4622   procedure diasize_need-full-display :
     4623     define output parameter p-need-full-display as logical   no-undo .
     4624     do
     4625     on error undo, return error return-value
     4626     :
     4627       assign
     4628         p-need-full-display = v-diasize-need-full-display
     4629       .
     4630       assign
     4631         v-diasize-need-full-display = false
     4632       .
     4633     end.
