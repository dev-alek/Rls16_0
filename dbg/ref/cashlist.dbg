     3385     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3386   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3387   on help of frame Dialog-Frame
     3388   do:
     3389     run gbl/app_help.p
     3390       (input this-procedure :file-name
     3391       ,input ''
     3392       ,input ?
     3393       ) no-error.
     3394     if error-status :error then do:
     3395       message
     3396         "Ошибка при вызове помощи"
     3397         error-status :get-message(1)
     3398         view-as alert-box .
