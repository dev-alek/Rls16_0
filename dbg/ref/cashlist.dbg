        6   DEFINE INPUT  PARAMETER parref-mode as character no-undo.
        7   DEFINE INPUT  PARAMETER pardb-num like ub.sys-ctrl.db-num no-undo.
        8   DEFINE INPUT  PARAMETER parhost-code like ub.sysconf.host-code no-undo.
        9   DEFINE INPUT  PARAMETER parobj-type like ub.clients.obj-type no-undo.
       10   DEFINE INPUT  PARAMETER parobj-code like ub.clients.obj-code no-undo.
       11   define input  parameter p-rec       as recid no-undo .
       12   DEFINE OUTPUT PARAMETER  p-rid-list    as  char no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision$":u .
       14   define variable vss-author      as character no-undo init "$Author$":u .
       15   define variable vss-date        as character no-undo init "$Date$":u .
       16   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       17   define variable vss-archive     as character no-undo init "$Archive$":u .
       18   define variable vss-description as character no-undo init "Справочник касс" .
       19   procedure vss-get-info :
