     4474   procedure diasize_add_browse :
     4475     define input  parameter p-browse-type   as character no-undo .
     4476     define input  parameter p-browse-handle as handle    no-undo .
     4477     define buffer buf_temp-browse-handle for temp-browse-handle .
     4478     do
     4479     on error undo, return error return-value
     4480     :
     4481       assign
     4482         v-diasize-browse-number = v-diasize-browse-number + 1
     4483       .
     4484       create buf_temp-browse-handle .
     4485       assign
     4486         buf_temp-browse-handle.browse-type   = p-browse-type
     4487         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4488         buf_temp-browse-handle.browse-handle = p-browse-handle
