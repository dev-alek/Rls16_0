     1126   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1127     define variable v-cntxt-db-num        as integer   no-undo .
     1128     define variable v-cntxt-userid        as character no-undo .
     1129     define variable v-cntxt-level         as character no-undo .
     1130     define variable v-cntxt-host-code-obj as integer   no-undo .
     1131     define variable v-cntxt-obj-type      as character no-undo .
     1132     define variable v-cntxt-obj-code      as integer   no-undo .
