     4277     end.
     4278     assign
     4279       v-diasize-change-size = false
     4280     .
     4281   end procedure.
     4282   procedure diasize_set-width :
     4283     define input  parameter p-new-width  as decimal   no-undo .
     4284     define input  parameter p-move-resize as logical   no-undo .
     4285     do
     4286     on error undo, return error return-value
     4287     :
     4288       run diasize_change-width in this-procedure
     4289         (input  (p-new-width - frame Dialog-Frame :width)
     4290         ,input  p-move-resize
     4291         ) .
     4292     end.
     4293   end procedure.
     4294   procedure diasize_position-resize-button :
     4295     do with frame Dialog-Frame
     4296     :
     4297       hide v-diasize-resize-button .
     4298       assign
     4299         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     4300                     - 1
     4301                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     4302         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     4303                     - 1
     4304                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     4305       .
     4306       view v-diasize-resize-button .
     4307     end.
     4308   end procedure.
     4309   on alt-right anywhere
     4310   do:
     4311     run diasize_change-width in this-procedure
     4312       (input 1
     4313       ,input true
     4314       ) .
     4315     return no-apply .
     4316   end.
     4317   on alt-left anywhere
     4318   do:
     4319     run diasize_change-width in this-procedure
     4320       (input -1
     4321       ,input true
     4322       ) .
     4323     return no-apply .
     4324   end.
     4325   on alt-down anywhere
     4326   do:
     4327     run diasize_change-height in this-procedure
     4328       (input 1
     4329       ,input true
     4330       ) .
     4331     return no-apply .
     4332   end.
     4333   on alt-up anywhere
     4334   do:
     4335     run diasize_change-height in this-procedure
     4336       (input -1
     4337       ,input true
     4338       ) .
     4339     return no-apply .
     4340   end.
     4341   on alt-enter of frame Dialog-Frame
     4342   do:
     4343     run diasize_maximize in this-procedure
     4344       (input  ?
     4345       ).
     4346     return no-apply .
     4347   end.
     4348   procedure diasize_end-move :
     4349     do
     4350     on error undo, return error return-value
     4351     :
     4352       define variable v-row-delta as decimal   no-undo .
     4353       define variable v-col-delta as decimal   no-undo .
     4354       define variable v-new-row as decimal   no-undo .
     4355       define variable v-new-col as decimal   no-undo .
     4356       assign
     4357         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     4358         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     4359       .
     4360       assign
     4361         v-row-delta = v-new-row - frame Dialog-Frame :height
     4362         v-col-delta = v-new-col - frame Dialog-Frame :width
     4363       .
     4364       run diasize_change-height in this-procedure
     4365         (input v-row-delta
     4366         ,input true
     4367         ) .
     4368       run diasize_change-width in this-procedure
     4369         (input v-col-delta
     4370         ,input true
     4371         ) .
     4372     end.
     4373   end procedure.
     4374   procedure diasize_maximize :
     4375     define input  parameter p-action as logical   no-undo .
     4376     do
     4377     on error undo, return error return-value
     4378     :
     4379       if p-action = ?
     4380       then do:
     4381         if v-diasize-need-maximize = true
     4382         then do:
     4383           assign
     4384             p-action = true
     4385           .
     4386         end.
     4387         else do:
     4388           assign
     4389             p-action = false
     4390           .
     4391         end.
     4392       end.
     4393       if p-action = true
     4394       then do:
     4395         run diasize_change-height in this-procedure
     4396           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     4397               - frame Dialog-Frame :height-chars
     4398           ,input true
     4399           ) .
     4400         run diasize_change-width in this-procedure
     4401           (input session :width-chars
     4402               - frame Dialog-Frame :width-chars
     4403           ,input true
     4404           ) .
     4405         assign
     4406           v-diasize-need-maximize = false
     4407         .
     4408       end.
     4409       else do:
     4410         run diasize_change-width in this-procedure
     4411           (input v-diasize-orig-frame-width
     4412               - frame Dialog-Frame :width-chars
     4413           ,input true
     4414           ) .
     4415         run diasize_change-height in this-procedure
     4416           (input v-diasize-orig-frame-height
     4417               - frame Dialog-Frame :height-chars
     4418           ,input true
     4419           ) .
     4420         assign
     4421           v-diasize-need-maximize = true
     4422         .
     4423       end.
     4424     end.
     4425   end procedure.
     4426   procedure diasize_restore-orig-size :
     4427     do
     4428     on error undo, return error return-value
     4429     :
     4430       assign
     4431         v-diasize-current-frame-width  = frame Dialog-Frame :width
     4432         v-diasize-current-frame-height = frame Dialog-Frame :height
     4433       .
     4434       run diasize_set-height in this-procedure
     4435         (input  v-diasize-orig-frame-height
     4436         ,input  true
     4437         ) .
     4438       run diasize_set-width in this-procedure
     4439         (input  v-diasize-orig-frame-width
     4440         ,input  true
     4441         ) .
     4442     end.
     4443   end procedure.
     4444   procedure diasize_restore-current-size :
     4445     do
     4446     on error undo, return error return-value
     4447     :
     4448       run diasize_set-height in this-procedure
     4449         (input  v-diasize-current-frame-height
     4450         ,input  true
     4451         ) .
     4452       run diasize_set-width in this-procedure
     4453         (input  v-diasize-current-frame-width
     4454         ,input  true
     4455         ) .
     4456     end.
     4457   end procedure.
     4458   procedure diasize_set-browse-handle :
     4459     define input  parameter p-browse-handle as handle   no-undo .
     4460     define buffer buf_temp-browse-handle for temp-browse-handle .
     4461     do
     4462     on error undo, return error return-value
     4463     :
     4464       assign
     4465         v-diasize-browse-handle = p-browse-handle
     4466       .
     4467       for each buf_temp-browse-handle
     4468       on error undo, return error return-value
     4469       :
     4470         delete buf_temp-browse-handle .
     4471       end.
     4472     end.
