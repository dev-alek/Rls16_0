     1136   FUNCTION mark-string RETURNS CHARACTER
     1137     ( input p-recid as recid, input mark-list as character  ) :
     1138     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1139   END FUNCTION.
     1140   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1141   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1142   procedure fltopend_fltopend :
     1143   define input parameter p-parent-handle as handle no-undo .
     1144   define input parameter p-qh as handle no-undo .
     1145   define input parameter p-flt-open-open-query  as character no-undo .
     1146   define input parameter p-where-cond as character no-undo .
     1147   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1148   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1149   define input parameter p-indexed-reposition as character no-undo .
     1150     do
     1151     on error undo, return error
     1152     :
     1153   define variable v-prepare-string as character no-undo .
     1154   define variable glog as logical no-undo .
     1155   assign
     1156   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1157                      p-where-cond + chr(32)  +
     1158                      p-use-indFIRST-query-tail + chr(32) +
     1159                      p-use-ind-sort-clmn-by + chr(32) +
     1160                      p-indexed-reposition
     1161   .
     1162   assign
     1163   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1164   if not glog
     1165   or error-status:error then do:
     1166     message error-status:get-message(1) view-as alert-box .
     1167     undo, return error .
     1168   end.
     1169   assign
     1170   glog = p-qh:query-open no-error .
     1171   if not glog
     1172   or error-status:error then do:
     1173     message error-status:get-message(1) view-as alert-box .
     1174     undo, return error .
     1175   end.
     1176     end.
     1177   end procedure.
     1178   procedure fltopend_fltfindd :
     1179   define input parameter p-parent-handle as handle no-undo .
     1180   define input parameter p-qh as handle no-undo .
     1181   define input parameter p-rowid as rowid no-undo .
     1182   define input parameter p-next as logical no-undo .
     1183   define input parameter p-lock as integer no-undo .
     1184   define input parameter p-bh as handle no-undo .
     1185   define input parameter p-where-cond as character no-undo .
     1186   define input parameter p-use-index-phrase as character no-undo .
     1187   define variable glog as logical no-undo .
     1188   define variable v-qh as handle no-undo .
     1189   define variable v-bh as handle no-undo .
     1190   define variable v-recid as recid no-undo .
     1191   define variable v-prepare-string as character no-undo .
     1192   do
     1193   on error undo, return error
     1194   on stop undo, return error
     1195   :
     1196     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1197     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1198     create query v-qh.
     1199     v-qh:set-buffers(v-bh).
     1200     v-prepare-string = substitute("for each &1 &2 &3"
     1201                                     ,v-bh:name
     1202                                     ,p-where-cond
     1203                                     ,p-use-index-phrase).
     1204     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1205     if not glog then do:
     1206       delete object v-qh.
     1207       delete object v-bh.
     1208       undo, return error .
     1209     end.
     1210     glog = v-qh:query-open no-error .
     1211     if not glog then do:
     1212       delete object v-qh.
     1213       delete object v-bh.
     1214       undo, return error .
     1215     end.
     1216     if p-next then do:
     1217       v-qh:reposition-to-rowid(p-rowid) no-error .
     1218       glog = v-qh:get-next( p-lock) no-error .
     1219       glog = v-qh:get-next( p-lock) no-error .
     1220       if not glog or v-qh:query-off-end = yes then do:
     1221         glog = v-qh:get-first( p-lock) no-error .
     1222       end.
     1223     end.
     1224     else do:
     1225       glog = v-qh:get-first( p-lock) no-error .
     1226     end.
     1227     v-recid = v-bh:recid no-error .
     1228     delete object v-qh.
     1229     delete object v-bh.
     1230     return string(v-recid) .
     1231   end.
     1232   end procedure.
     1233   procedure fltopend_fltfindq :
     1234   define input parameter p-parent-handle as handle no-undo .
     1235   define input parameter p-qh as handle no-undo .
     1236   define input parameter p-next as logical no-undo .
     1237   define input parameter p-lock as integer no-undo .
     1238   define input parameter p-flt-open-open-query  as character no-undo .
     1239   define input parameter p-where-cond as character no-undo .
     1240   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1241   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1242   define input parameter p-indexed-reposition as character no-undo .
     1243   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1244   define variable glog as logical no-undo .
     1245   define variable v-qh as handle no-undo .
     1246   define variable v-bh as handle no-undo extent 18.
     1247   define variable v-rowid as rowid no-undo extent 18.
     1248   define variable v-ii as integer no-undo .
     1249   define variable v-prepare-string as character no-undo .
     1250   do
     1251   on error undo, return error
     1252   on stop undo, return error
     1253   :
     1254     create query v-qh.
     1255     do v-ii = 1 to p-qh:num-buffers:
     1256       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1257       assign
     1258       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1259       no-error.
     1260       v-qh:add-buffer(v-bh[v-ii]).
     1261     end.
     1262     assign
     1263     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1264                       p-where-cond + chr(32)  +
     1265                       p-use-indFIRST-query-tail + chr(32) +
     1266                       p-use-ind-sort-clmn-by + chr(32) +
     1267                       p-indexed-reposition
     1268     .
     1269     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1270     if not glog then do:
     1271       delete object v-qh.
     1272       do v-ii = 1 to p-qh:num-buffers:
     1273         delete object v-bh[v-ii].
     1274       end.
     1275       undo, return error .
     1276     end.
     1277     glog = v-qh:query-open no-error .
     1278     if not glog then do:
     1279       delete object v-qh.
     1280       do v-ii = 1 to p-qh:num-buffers:
     1281         delete object v-bh[v-ii].
     1282       end.
     1283       undo, return error .
     1284     end.
     1285     if p-next then do:
     1286       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1287       glog = v-qh:get-next( p-lock) no-error .
     1288       glog = v-qh:get-next( p-lock) no-error .
     1289       if not glog or v-qh:query-off-end = yes then do:
     1290         glog = v-qh:get-first( p-lock) no-error .
     1291       end.
     1292     end.
     1293     else do:
     1294       glog = v-qh:get-first( p-lock) no-error .
     1295     end.
     1296     do v-ii = 1 to p-qh:num-buffers:
     1297       assign
     1298       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1299       no-error.
     1300     end.
     1301     delete object v-qh.
     1302     do v-ii = 1 to p-qh:num-buffers:
     1303       delete object v-bh[v-ii].
     1304     end.
     1305   end.
     1306   end procedure.
     1307   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1308   procedure gen-key-rec :
     1309     define input  parameter p-tbl-name    as character no-undo.
     1310     define input  parameter p-bh_tbl-name as handle    no-undo.
     1311     define output parameter p-key-rec     as character no-undo.
     1312     do
     1313     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1314     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1315     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1316     :
     1317       define variable fh               as handle    no-undo .
     1318       define variable v-ok             as logical   no-undo .
     1319       define variable v-inform         as character no-undo .
     1320       define variable v-ind            as integer   no-undo .
     1321       define variable v-idx-field-qnty as integer   no-undo .
     1322       if p-tbl-name = ?
     1323         or p-tbl-name = "":U
     1324       then do:
     1325         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info13 ).
     1326       end.
     1327       if not p-bh_tbl-name:available then do:
     1328         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info13, p-tbl-name ).
     1329       end.
     1330       assign
     1331         p-key-rec = p-tbl-name
     1332         v-inform  = p-bh_tbl-name:index-information(1)
     1333         v-ind     = 2
     1334       .
     1335       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1336       on error undo, return error
     1337       :
     1338         assign
     1339           v-inform = p-bh_tbl-name:index-information( v-ind )
     1340           v-ind    = v-ind + 1
     1341         .
     1342       end.
     1343       if v-inform = ?
     1344         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1345         or entry( 3, v-inform, ",":U ) <> "1":U
     1346       then do:
     1347         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info13, p-tbl-name ).
     1348       end.
     1349       else do:
     1350         assign
     1351           v-idx-field-qnty = num-entries( v-inform ) - 4
     1352         .
     1353         if v-idx-field-qnty < 2 then do:
     1354           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info13, v-inform, p-tbl-name ).
     1355         end.
     1356         do v-ind = 1 to v-idx-field-qnty by 2
     1357         on error undo, return error
     1358         :
     1359           assign
     1360             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1361             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1362           .
     1363         end.
     1364       end.
     1365       if p-key-rec = ? then do:
     1366         assign
     1367           p-key-rec = "":U
     1368         .
     1369         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info13, p-tbl-name ).
     1370       end.
     1371     end.
     1372     return.
     1373   end procedure.
     1374   procedure gen-where-keyr-tab :
     1375     define input  parameter i-tableSerach as character no-undo.
     1376     define input  parameter i-tablekey   as character  no-undo.
     1377     define input  parameter p-key-rec    as character  no-undo.
     1378     define input  parameter p-key-handle as handle     no-undo .
     1379     define input  parameter p-db-name    as character  no-undo .
     1380     define input  parameter p-tt-handle  as handle     no-undo .
     1381     define output parameter o-Where      as character  no-undo.
     1382     do
     1383     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1384     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1385     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1386     :
     1387       define variable v-full-tbl-name  as character no-undo .
     1388       define variable bh_tbl-name      as handle    no-undo .
     1389       define variable fh_key           as handle    no-undo .
     1390       define variable fh_search        as handle    no-undo .
     1391       define variable v-field-num      as integer   no-undo .
     1392       define variable v-count-fld      as integer   no-undo .
     1393       define variable v-inform         as character no-undo .
     1394       define variable v-ind            as integer   no-undo .
     1395       define variable v-idx-field-qnty as integer   no-undo .
     1396       define variable v-field-name     as character no-undo .
     1397       define variable v-field-val      as character no-undo .
     1398       define variable v-word-link      as character no-undo .
     1399       define variable vTable           as character no-undo.
     1400       define variable bh_tbl-key       as handle    no-undo .
     1401       assign
     1402         p-key-rec = trim( p-key-rec )
     1403       .
     1404       if p-key-handle <> ? then do:
     1405         if not valid-handle(p-key-handle)
     1406            or p-key-handle:type <> "buffer"
     1407         then do:
     1408           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info13 ).
     1409         end.
     1410         if num-entries( p-key-rec, chr(3) ) > 1
     1411           or p-key-rec = ?
     1412           or p-key-rec = "":U
     1413         then do:
     1414           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info13, p-key-rec ).
     1415         end.
     1416       end.
     1417       else do:
     1418         if p-key-rec = ?
     1419           or p-key-rec = "":U
     1420         then do:
     1421           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info13 ).
     1422         end.
     1423       end.
     1424       assign
     1425         vTable = entry( 1 , p-key-rec, chr(3) )
     1426       .
     1427       if p-tt-handle <> ?
     1428         and ( not valid-handle(p-tt-handle)
     1429               or p-tt-handle:type <> "buffer"
     1430             )
     1431       then do:
     1432         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info13, vTable, chr(10) ).
     1433       end.
     1434       if p-tt-handle = ? then do:
     1435         assign
     1436           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1437         .
     1438         create buffer bh_tbl-name for table v-full-tbl-name .
     1439       end.
     1440       else do:
     1441         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1442       end.
     1443       assign
     1444         v-inform = bh_tbl-name:index-information(1)
     1445         v-ind    = 2
     1446       .
     1447       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1448       on error undo, return error
     1449       :
     1450         assign
     1451           v-inform = bh_tbl-name:index-information( v-ind )
     1452           v-ind    = v-ind + 1
     1453         .
     1454       end.
     1455       if v-inform = ?
     1456         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1457         or entry( 3, v-inform, ",":U ) <> "1":U
     1458       then do:
     1459         delete object bh_tbl-name no-error.
     1460         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info13, vTable ).
     1461       end.
     1462       assign
     1463         v-idx-field-qnty = num-entries( v-inform ) - 4
     1464       .
     1465       if v-idx-field-qnty < 2 then do:
     1466         delete object bh_tbl-name no-error.
     1467         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info13, v-inform, vTable ).
     1468       end.
     1469       assign
     1470         o-where     = "where":U
     1471         v-word-link = "":U
     1472         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1473         v-count-fld = 0
     1474       .
     1475       if i-tablekey ne "" and i-tablekey ne ?
     1476       then do:
     1477         assign
     1478           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1479         .
     1480         create buffer bh_tbl-key for table v-full-tbl-name .
     1481       end.
     1482       if i-tableSerach ne "" and i-tableSerach ne ?
     1483       then do:
     1484         delete object bh_tbl-name no-error.
     1485         assign
     1486           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1487         .
     1488         create buffer bh_tbl-name for table v-full-tbl-name .
     1489       end.
     1490       block_where:
     1491       do v-ind = 1 to v-idx-field-qnty by 2
     1492       on error undo, return error
     1493       :
     1494         assign
     1495           v-count-fld = v-count-fld + 1
     1496         .
     1497         if p-key-handle = ?
     1498           and v-count-fld > v-field-num
     1499         then do:
     1500           leave block_where.
     1501         end.
     1502         define variable VfieldKeyTable as handle no-undo.
     1503         assign
     1504           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1505           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1506         .
     1507         if     bh_tbl-key ne ?
     1508         then do:
     1509            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1510            if VfieldKeyTable eq ?
     1511            then next block_where.
     1512         end.
     1513         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1514         then
     1515            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1516         else
     1517            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1518         if p-key-handle = ? then do:
     1519           assign
     1520             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1521           .
     1522         end.
     1523         else do:
     1524           assign
     1525             fh_key = p-key-handle:buffer-field( v-field-name )
     1526           .
     1527           if fh_key = ?
     1528             or not valid-handle( fh_key )
     1529           then do:
     1530             delete object bh_tbl-name.
     1531             if     bh_tbl-key ne ?
     1532             then
     1533                delete object bh_tbl-key.
     1534             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info13, p-key-handle:name, v-field-name ).
     1535           end.
     1536           assign
     1537             v-field-val = fh_key:buffer-value
     1538           .
     1539         end.
     1540         if fh_search:data-type ="character":U then do:
     1541           assign
     1542             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1543             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1544             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1545             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1546             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1547             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1548             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1549             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1550             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1551             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1552             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1553             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1554             v-field-val = substitute( '"&1"', v-field-val )
     1555           .
     1556         end.
     1557         assign
     1558           o-where = substitute( "&1 &2", o-where, v-field-val )
     1559         .
     1560         if v-word-link = "":U then do:
     1561           assign
     1562             v-word-link = "and":U
     1563           .
     1564         end.
     1565       end.
     1566       delete object bh_tbl-name.
     1567       if     bh_tbl-key ne ?
     1568       then
     1569          delete object bh_tbl-key.
     1570       if p-key-handle = ?
     1571         and v-count-fld <> v-field-num
     1572       then do:
     1573         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info13, vTable ).
     1574       end.
     1575     end.
     1576   end procedure.
     1577   procedure gen-hn-keyr-tab :
     1578     define input  parameter i-tableSerach as character no-undo.
     1579     define input  parameter i-tablekey   as character no-undo.
     1580     define input  parameter p-key-rec    as character no-undo.
     1581     define input  parameter p-key-handle as handle    no-undo .
     1582     define input  parameter p-db-name    as character no-undo .
     1583     define input  parameter p-tt-handle  as handle    no-undo .
     1584     define input  parameter p-stts-lock  as integer   no-undo .
     1585     define output parameter o-hn         as handle    no-undo.
     1586     define variable v-full-tbl-name as character no-undo.
     1587     define variable v-where         as character no-undo.
     1588     define variable bh_tbl-name     as handle    no-undo.
     1589     define variable vTable          as character no-undo.
     1590     do
     1591     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1592     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1593     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1594         run gen-where-keyr-tab(i-tableSerach,
     1595                                i-tablekey,
     1596                                p-key-rec,
     1597                                p-key-handle,
     1598                                p-db-name,
     1599                                p-tt-handle,
     1600                                output v-where).
     1601         if i-tableSerach ne "" and i-tableSerach ne ?
     1602         then do:
     1603            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1604            create buffer bh_tbl-name for table v-full-tbl-name .
     1605         end.
     1606         else do:
     1607            if p-tt-handle = ? then do:
     1608               assign
     1609                  vTable = entry( 1 , p-key-rec, chr(3) )
     1610               .
     1611               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1612               create buffer bh_tbl-name for table v-full-tbl-name .
     1613            end.
     1614            else do:
     1615               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1616            end.
     1617         end.
     1618         if p-tt-handle = ? then do:
     1619            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1620         end.
     1621         else do:
     1622            bh_tbl-name:find-first( v-where ) no-error .
     1623         end.
     1624         o-hn = bh_tbl-name.
     1625      end.
     1626   end procedure.
     1627   procedure gen-hn-keyr :
     1628     define input  parameter p-key-rec    as character no-undo.
     1629     define input  parameter p-key-handle as handle    no-undo .
     1630     define input  parameter p-db-name    as character no-undo .
     1631     define input  parameter p-tt-handle  as handle    no-undo .
     1632     define input  parameter p-stts-lock  as integer   no-undo .
     1633     define output parameter o-hn         as handle    no-undo.
     1634     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1635   end.
     1636   procedure gen-row-keyr :
     1637     define input  parameter p-key-rec    as character no-undo.
     1638     define input  parameter p-key-handle as handle    no-undo .
     1639     define input  parameter p-db-name    as character no-undo .
     1640     define input  parameter p-tt-handle  as handle    no-undo .
     1641     define input  parameter p-stts-lock  as integer   no-undo .
     1642     define output parameter p-tbl-row    as rowid     no-undo.
     1643     define output parameter p-tbl-name   as character no-undo.
     1644     define variable vHn as handle no-undo.
     1645       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1646       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1647       p-tbl-name =  vHn:table.
     1648       delete object vHn no-error.
     1649     if p-tbl-row = ? then do:
     1650       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info13, p-tbl-name, p-key-rec ).
     1651     end.
     1652     else do:
     1653       return.
     1654     end.
     1655   end procedure.
     1656   procedure gen-key-fv :
     1657     define input  parameter p-key-rec    as character no-undo .
     1658     define output parameter p-field-list as character no-undo .
     1659     define output parameter p-value-list as character no-undo.
     1660     do
     1661     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1662     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1663     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1664     :
     1665       define variable v-full-tbl-name  as character no-undo .
     1666       define variable bh_tbl-name      as handle    no-undo .
     1667       define variable v-tbl-name       as character no-undo .
     1668       define variable v-field-num      as integer   no-undo .
     1669       define variable v-count-fld      as integer   no-undo .
     1670       define variable v-inform         as character no-undo .
     1671       define variable v-ind            as integer   no-undo .
     1672       define variable v-idx-field-qnty as integer   no-undo .
     1673       define variable v-delim-key      as character no-undo .
     1674       if p-key-rec = ?
     1675         or p-key-rec = "":U
     1676       then do:
     1677         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info13 ).
     1678       end.
     1679       assign
     1680         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1681         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1682       .
     1683       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1684       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info13 ).
     1685       assign
     1686         v-inform = bh_tbl-name:index-information(1)
     1687         v-ind    = 2
     1688       .
     1689       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1690       on error undo, return error
     1691       :
     1692         assign
     1693           v-inform = bh_tbl-name:index-information( v-ind )
     1694           v-ind    = v-ind + 1
     1695         .
     1696       end.
     1697       if v-inform = ?
     1698         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1699         or entry( 3, v-inform, ",":U ) <> "1":U
     1700       then do:
     1701         delete object bh_tbl-name no-error.
     1702         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info13, v-tbl-name ).
     1703       end.
     1704       assign
     1705         v-idx-field-qnty = num-entries( v-inform ) - 4
     1706       .
     1707       if v-idx-field-qnty < 2 then do:
     1708         delete object bh_tbl-name no-error.
     1709         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info13, v-inform, v-tbl-name ).
     1710       end.
     1711       assign
     1712         p-field-list = "":U
     1713         p-value-list = "":U
     1714         v-delim-key  = "":U
     1715         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1716         v-count-fld  = 0
     1717       .
     1718       block_where:
     1719       do v-ind = 1 to v-idx-field-qnty by 2
     1720       on error undo, return error
     1721       :
     1722         assign
     1723           v-count-fld = v-count-fld + 1
     1724         .
     1725         if v-count-fld > v-field-num then do:
     1726           leave block_where.
     1727         end.
     1728         assign
     1729           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1730           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1731         .
     1732         if v-ind = 1 then do:
     1733           assign
     1734             v-delim-key = chr(3)
     1735           .
     1736         end.
     1737       end.
     1738       delete object bh_tbl-name.
     1739       if v-count-fld <> v-field-num then do:
     1740         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info13, v-tbl-name ).
     1741       end.
     1742     end.
     1743   end procedure.
     1744   procedure gen-key-field :
     1745     define input  parameter p-table      as character no-undo .
     1746     define output parameter p-field-list as character no-undo .
     1747     do
     1748     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1749     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1750     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1751     :
     1752       define variable v-full-tbl-name  as character no-undo .
     1753       define variable bh_tbl-name      as handle    no-undo .
     1754       define variable v-tbl-name       as character no-undo .
     1755       define variable v-field-num      as integer   no-undo .
     1756       define variable v-count-fld      as integer   no-undo .
     1757       define variable v-inform         as character no-undo .
     1758       define variable v-ind            as integer   no-undo .
     1759       define variable v-idx-field-qnty as integer   no-undo .
     1760       define variable v-delim-key      as character no-undo .
     1761       if p-table = ?
     1762         or p-table = "":U
     1763       then do:
     1764         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info13 ).
     1765       end.
     1766       assign
     1767         v-tbl-name      = p-table
     1768         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1769       .
     1770       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1771       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info13 ).
     1772       assign
     1773         v-inform = bh_tbl-name:index-information(1)
     1774         v-ind    = 2
     1775       .
     1776       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1777       on error undo, return error
     1778       :
     1779         assign
     1780           v-inform = bh_tbl-name:index-information( v-ind )
     1781           v-ind    = v-ind + 1
     1782         .
     1783       end.
     1784       if v-inform = ?
     1785         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1786         or entry( 3, v-inform, ",":U ) <> "1":U
     1787       then do:
     1788         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info13, v-tbl-name ).
     1789       end.
     1790       assign
     1791         v-idx-field-qnty = num-entries( v-inform ) - 4
     1792       .
     1793       if v-idx-field-qnty < 2 then do:
     1794         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info13, v-inform, v-tbl-name ).
     1795       end.
     1796       assign
     1797         p-field-list = "":U
     1798         v-delim-key  = "":U
     1799         v-count-fld  = 0
     1800       .
     1801       block_where:
     1802       do v-ind = 1 to v-idx-field-qnty by 2
     1803       on error undo, return error
     1804       :
     1805         assign
     1806           v-count-fld = v-count-fld + 1
     1807         .
     1808         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1809         if v-ind = 1 then do:
     1810           assign
     1811             v-delim-key = chr(3)
     1812           .
     1813         end.
     1814       end.
     1815       delete object bh_tbl-name.
     1816     end.
     1817   end procedure.
     1818   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1819   procedure cd-attr-code :
     1820     define input  parameter p-ucode          as character no-undo .
     1821     define input  parameter p-code           as character no-undo .
     1822     define output parameter p-type           as character no-undo .
     1823     define output parameter p-format         as character no-undo .
     1824     define output parameter p-label          as character no-undo .
     1825     define output parameter p-user-can-edit  as logical   no-undo .
     1826     define output parameter p-output-display as logical   no-undo .
     1827     define output parameter p-other          as character no-undo .
     1828     define output parameter p-prop-list      as character no-undo .
     1829     do
     1830     on error undo, return error return-value
     1831     :
     1832           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cd-attr-code in g#attr-lib
     1833         (input  p-ucode
     1834         ,input  p-code
     1835         ,output p-type
     1836         ,output p-format
     1837         ,output p-label
     1838         ,output p-user-can-edit
     1839         ,output p-output-display
     1840         ,output p-other
     1841         ,output p-prop-list
     1842         ) no-error .
     1843       if error-status :error
     1844       then do:
     1845         undo, return error return-value .
     1846       end.
     1847     end.
     1848   end procedure.
     1849   procedure cd-attr-tooltip :
     1850     define input  parameter p-ucode   as character no-undo .
     1851     define input  parameter p-code    as character no-undo .
     1852     define output parameter p-tooltip as character no-undo .
     1853     define output parameter p-label   as character no-undo .
     1854     do
     1855     on error undo, return error return-value
     1856     :
     1857           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cd-attr-tooltip in g#attr-lib
     1858         (input  p-ucode
     1859         ,input  p-code
     1860         ,output p-tooltip
     1861         ,output p-label
     1862         ) no-error .
     1863       if error-status :error
