     1865         undo, return error return-value .
     1866       end.
     1867     end.
     1868   end procedure.
     1869   procedure cd-attr-value :
     1870     define input  parameter p-db-num    like ub.cash-desk-attr.db-num        no-undo .
     1871     define input  parameter p-obj-code  like ub.cash-desk-attr.obj-code      no-undo .
     1872     define input  parameter p-pos-type  like ub.cash-desk-attr.pos-type      no-undo .
     1873     define input  parameter p-cash-num  like ub.cash-desk-attr.cash-num      no-undo .
     1874     define input  parameter p-ucode     like ub.cash-desk-attr.upper-attr-code      no-undo .
     1875     define input  parameter p-code      like ub.cash-desk-attr.attr-code      no-undo .
     1876     define output parameter p-character like ub.cash-desk-attr.attr-value-character    no-undo .
     1877     define output parameter p-date      like ub.cash-desk-attr.attr-value-date         no-undo .
     1878     define output parameter p-decimal   like ub.cash-desk-attr.attr-value-decimal      no-undo .
     1879     define output parameter p-integer   like ub.cash-desk-attr.attr-value-integer      no-undo .
     1880     define output parameter p-logical   like ub.cash-desk-attr.attr-value-logical      no-undo .
     1881     define output parameter p-type      as character no-undo .
     1882     do
     1883     on error undo, return error return-value
     1884     :
     1885           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cd-attr-value in g#attr-lib
     1886         (input  p-db-num
     1887         ,input  p-obj-code
     1888         ,input  p-pos-type
     1889         ,input  p-cash-num
     1890         ,input  p-ucode
     1891         ,input  p-code
     1892         ,output p-character
     1893         ,output p-date
     1894         ,output p-decimal
     1895         ,output p-integer
     1896         ,output p-logical
     1897         ,output p-type
     1898         ) no-error .
     1899       if error-status :error
     1900       then do:
     1901         undo, return error return-value .
     1902       end.
     1903     end.
     1904   end procedure.
     1905   procedure cd-attr-write :
     1906     define input parameter p-db-num    like ub.cash-desk-attr.db-num     no-undo .
     1907     define input parameter p-obj-code  like ub.cash-desk-attr.obj-code   no-undo .
     1908     define input parameter p-pos-type  like ub.cash-desk-attr.pos-type   no-undo .
     1909     define input parameter p-cash-num  like ub.cash-desk-attr.cash-num   no-undo .
     1910     define input parameter p-ucode     like ub.cash-desk-attr.upper-attr-code  no-undo .
     1911     define input parameter p-code      like ub.cash-desk-attr.attr-code  no-undo .
