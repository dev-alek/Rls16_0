     5914   FUNCTION get-ffd-version RETURNS CHARACTER
     5915     ( INPUT p-db-num AS INTEGER
     5916     ,INPUT p-obj-code AS INTEGER
     5917     ,INPUT p-pos-type AS CHARACTER
     5918     ,INPUT  p-cash-num AS INTEGER) :
     5919     DEFINE VARIABLE v-dop          AS CHARACTER NO-UNDO.
     5920     DEFINE VARIABLE v-ffd-version  AS CHARACTER NO-UNDO.
     5921     DEFINE VARIABLE v-kkt-version  AS CHARACTER NO-UNDO.
     5922     DEFINE VARIABLE v-ffd-version_ AS CHARACTER NO-UNDO.
     5923     define variable v-date         as date      no-undo .
     5924     define variable v-decimal      as decimal   no-undo .
     5925     define variable v-integer      as integer   no-undo .
     5926     define variable v-logical      as logical   no-undo .
     5927     run cd-attr-value in this-procedure (
     5928       input   p-db-num
     5929       ,input  p-obj-code
     5930       ,input  p-pos-type
     5931       ,input  p-cash-num
     5932       ,input  (if p-pos-type = 'IBM-XML':U
     5933       then 'IBM-XML_operative':U
     5934       else 'AUTOTANK_operative':U)
     5935       ,input  'USE_FFD_VERSION':U
     5936       ,output v-ffd-version
     5937       ,output v-date
     5938       ,output v-decimal
     5939       ,output v-integer
     5940       ,output v-logical
     5941       ,output v-dop) no-error.
     5942     case v-ffd-version :
     5943       when "0" then
     5944         do:
     5945           run cd-attr-value in this-procedure (
     5946             input   p-db-num
     5947             ,input  p-obj-code
     5948             ,input  p-pos-type
     5949             ,input  p-cash-num
     5950             ,input  (if p-pos-type = 'IBM-XML':U
     5951             then 'IBM-XML_operative':U
     5952             else 'AUTOTANK_operative':U)
     5953             ,input  'KKT_FFD_VERSION':U
     5954             ,output v-kkt-version
     5955             ,output v-date
     5956             ,output v-decimal
     5957             ,output v-integer
     5958             ,output v-logical
     5959             ,output v-dop) no-error.
     5960           if error-status:error or v-kkt-version = "0" or v-kkt-version = "" then v-ffd-version_ = "авт" .
     5961           else
     5962           do:
     5963             case v-kkt-version:
     5964               when "2" then
     5965                 v-ffd-version_ = "1.05(авт)" .
     5966               when "3" then
     5967                 v-ffd-version_ = "1.1(авт)" .
     5968               when "4" then
     5969                 v-ffd-version_ = "1.2(авт)" .
     5970             end case.
     5971           end.
     5972         end.
     5973       when "2" then
     5974         v-ffd-version_ = "1.05" .
     5975       when "3" then
     5976         v-ffd-version_ = "1.1" .
     5977       when "4" then
     5978         v-ffd-version_ = "1.2" .
     5979       otherwise
     5980       v-ffd-version_ = " - " .
     5981     end case .
     5982     RETURN v-ffd-version_.
     5983   END FUNCTION.
     5984   FUNCTION get-kkt-schema RETURNS CHARACTER
     5985     ( INPUT p-db-num AS INTEGER
     5986     ,INPUT p-obj-code AS INTEGER
     5987     ,INPUT p-pos-type AS CHARACTER
     5988     ,INPUT  p-cash-num AS INTEGER) :
     5989     DEFINE VARIABLE v-dop         AS CHARACTER NO-UNDO.
     5990     DEFINE VARIABLE v-kkt-schema  AS CHARACTER NO-UNDO.
     5991     DEFINE VARIABLE v-kkt-schema_ AS CHARACTER NO-UNDO.
     5992     define variable v-date        as date      no-undo .
     5993     define variable v-decimal     as decimal   no-undo .
     5994     define variable v-integer     as integer   no-undo .
     5995     define variable v-logical     as logical   no-undo .
     5996     run cd-attr-value in this-procedure (
     5997       input   p-db-num
     5998       ,input  p-obj-code
     5999       ,input  p-pos-type
     6000       ,input  p-cash-num
     6001       ,input  (if p-pos-type = 'IBM-XML':U
     6002       then 'IBM-XML_operative':U
     6003       else 'AUTOTANK_operative':U)
     6004       ,input  'KKT_SCHEMA':U
     6005       ,output v-kkt-schema
     6006       ,output v-date
     6007       ,output v-decimal
     6008       ,output v-integer
     6009       ,output v-logical
     6010       ,output v-dop) no-error.
     6011     case v-kkt-schema :
     6012       when "0" then
     6013         v-kkt-schema_ = "с ожиданием ответа" .
     6014       when "1" then
     6015         v-kkt-schema_ = "без ожидания ответа" .
     6016       otherwise
     6017       v-kkt-schema_ = " - " .
     6018     end case .
     6019     RETURN v-kkt-schema_.
     6020   END FUNCTION.
