     3895   procedure diasize_set-height :
     3896     define input  parameter p-new-height  as decimal   no-undo .
     3897     define input  parameter p-move-resize as logical   no-undo .
     3898     do
     3899     on error undo, return error return-value
     3900     :
     3901       run diasize_change-height in this-procedure
     3902         (input  (p-new-height - frame Dialog-Frame :height)
     3903         ,input  p-move-resize
     3904         ) .
     3905     end.
     3906   end procedure.
     3907   procedure diasize_change-width :
     3908     define input  parameter p-change-value as decimal   no-undo .
     3909     define input  parameter p-move-resize  as logical   no-undo .
     3910     define variable v-field-group-handle   as handle    no-undo .
