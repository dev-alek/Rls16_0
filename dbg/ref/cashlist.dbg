     3135       )  .
     3136   end.
     3137       if NOT glog then return no-apply .
     3138       message
     3139         "Вы уверены?"
     3140         view-as alert-box buttons YES-NO update glog.
     3141       if not glog then return no-apply.
     3142       rr = recid( check_cash-desk ).
     3143       v-on = ?.
     3144       run ref/cashdsk2.p ( input parparentproc
     3145         , input recid(check_cash-desk)
     3146         , input-output v-on) no-error .
     3147       if error-status:error then
     3148       do:
     3149         if return-value <> "":U then
     3150           message
     3151             return-value
     3152             view-as alert-box .
     3153         return no-apply.
     3154       end.
     3155       Browse br-cash-desk:REFRESH().
     3156       APPLY "ENTRY" To browse br-cash-desk.
     3157     END.
     3158   ON CHOOSE OF B-print IN FRAME Dialog-Frame
