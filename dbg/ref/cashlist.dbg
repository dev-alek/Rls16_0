     3915     define variable v-window-width         as decimal   no-undo .
     3916     define variable v-window-virtual-width as decimal   no-undo .
     3917     define variable v-change-sign          as integer   no-undo .
     3918     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3919     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3920     if p-change-value > 0
     3921     then do:
     3922       if frame Dialog-Frame :width + p-change-value >
     3923           session :width-chars
     3924       then do:
     3925         assign
     3926           p-change-value = session :width-chars - frame Dialog-Frame :width
     3927         .
     3928         if p-change-value <= 0
     3929         then do:
     3930           run diasize_position-resize-button in this-procedure .
     3931           return .
     3932         end.
     3933       end.
     3934     end.
     3935     if p-change-value < 0
     3936     then do:
     3937       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3938       then do:
     3939         assign
     3940           p-change-value = v-diasize-orig-frame-width
     3941                          - frame Dialog-Frame :width
     3942         .
     3943         if p-change-value >= 0
     3944         then do:
     3945           run diasize_position-resize-button in this-procedure .
     3946           return .
     3947         end.
     3948       end.
     3949     end.
     3950     if p-change-value >= 0
     3951     then do:
     3952       assign
     3953         v-change-sign = 1
     3954       .
     3955     end.
     3956     else do:
     3957       assign
     3958         v-change-sign = -1
     3959       .
     3960     end.
     3961     assign
     3962       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3963     .
     3964     if p-change-value = 0
     3965     then do:
     3966       run diasize_position-resize-button in this-procedure .
     3967       return .
     3968     end.
