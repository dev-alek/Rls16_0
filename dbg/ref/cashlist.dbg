     6077   FUNCTION get-GISMT_FAST RETURNS INTEGER
     6078     ( INPUT p-db-num AS INTEGER
     6079     ,INPUT p-obj-code AS INTEGER
     6080     ,INPUT p-pos-type AS CHARACTER
     6081     ,INPUT  p-cash-num AS INTEGER) :
     6082     DEFINE VARIABLE v-dop               AS CHARACTER NO-UNDO.
     6083     DEFINE VARIABLE v-GISMT_FAST_ANSWER AS INTEGER   no-undo init ?.
     6084     find first ub.cash-desk-attr no-lock where ub.cash-desk-attr.attr-code = 'GISMT_FAST_ANSWER':U and
     6085       ub.cash-desk-attr.cash-num = p-cash-num and
     6086       ub.cash-desk-attr.db-num = p-db-num and
     6087       ub.cash-desk-attr.obj-code = p-obj-code no-error .
     6088     if available (ub.cash-desk-attr) then v-GISMT_FAST_ANSWER = integer(ub.cash-desk-attr.attr-value-character) .
     6089     RETURN v-GISMT_FAST_ANSWER.
     6090   END FUNCTION.
     6091   FUNCTION get-GISMT_TIMEOUT RETURNS INTEGER
     6092     ( INPUT p-db-num AS INTEGER
     6093     ,INPUT p-obj-code AS INTEGER
     6094     ,INPUT p-pos-type AS CHARACTER
     6095     ,INPUT  p-cash-num AS INTEGER) :
     6096     DEFINE VARIABLE v-dop                   AS CHARACTER NO-UNDO.
     6097     DEFINE VARIABLE v-GISMT_CHECK_TIMEOUT   AS INTEGER   no-undo init ?.
     6098     DEFINE VARIABLE v-GISMT_OPENCON_TIMEOUT AS INTEGER   no-undo init ?.
     6099     DEFINE VARIABLE v-GISMT_TIMEOUT         AS INTEGER   no-undo init ?.
     6100     find first ub.cash-desk-attr no-lock where ub.cash-desk-attr.attr-code = 'GISMT_CHECK_TIMEOUT':U and
     6101       ub.cash-desk-attr.cash-num = p-cash-num and
     6102       ub.cash-desk-attr.db-num = p-db-num and
     6103       ub.cash-desk-attr.obj-code = p-obj-code no-error .
     6104     if available (ub.cash-desk-attr) then v-GISMT_CHECK_TIMEOUT = integer(ub.cash-desk-attr.attr-value-character) .
     6105     find first ub.cash-desk-attr no-lock where ub.cash-desk-attr.attr-code = 'GISMT_OPENCON_TIMEOUT':U and
     6106       ub.cash-desk-attr.cash-num = p-cash-num and
     6107       ub.cash-desk-attr.db-num = p-db-num and
     6108       ub.cash-desk-attr.obj-code = p-obj-code no-error .
     6109     if available (ub.cash-desk-attr) then v-GISMT_OPENCON_TIMEOUT = integer(ub.cash-desk-attr.attr-value-character) .
     6110     v-GISMT_TIMEOUT = v-GISMT_OPENCON_TIMEOUT + v-GISMT_CHECK_TIMEOUT .
     6111     RETURN v-GISMT_TIMEOUT.
     6112   END FUNCTION.
