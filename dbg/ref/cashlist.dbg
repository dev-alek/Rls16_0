     2519     mark-string( recid(X_cash-desk), v-rid-list ) COLUMN-LABEL "*" FORMAT "X(1)":U
     2520     X_cash-desk.cash-on COLUMN-LABEL "Вкл" FORMAT "+/":U
     2521     X_cash-desk.obj-code COLUMN-LABEL "Магазин" FORMAT "99999":U
     2522     X_cash-desk.db-num FORMAT ">>>>9":U
     2523     X_cash-desk.cash-num FORMAT ">>>9":U
     2524     entry (lookup (X_cash-desk.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U) COLUMN-LABEL "Тип POS" FORMAT "X(15)":U
     2525     cash-desk-auto(X_cash-desk.autonomy) COLUMN-LABEL "Активность" FORMAT "X(20)":U
     2526     if X_cash-desk.pos-type = 'IBM-XML':U
     2527     or X_cash-desk.pos-type = 'Autotank':U
     2528     then
     2529     (if num-entries(X_cash-desk.addr-path, chr(4)) > 1
     2530     then (entry(1, X_cash-desk.addr-path, chr(4)) + ":\\":U +
     2531     entry(2, X_cash-desk.addr-path, chr(4)))
     2532     else X_cash-desk.addr-path)
     2533     else X_cash-desk.addr-path COLUMN-LABEL "Адрес (путь к кассе)" FORMAT "X(35)":U
     2534     X_cash-desk.cash-os FORMAT "X(12)":U
     2535     signExecution(X_cash-desk.device-kind) COLUMN-LABEL "Признак исполнения" FORMAT "X(25)":U
     2536     string(if X_cash-desk.is-del then 'удал':U else 'тек':U) COLUMN-LABEL "Статус" FORMAT "X(8)":U
     2537     (if X_cash-desk.remote = 1 then yes else no) COLUMN-LABEL "Удаленная!дистанционно" FORMAT "+/":U
