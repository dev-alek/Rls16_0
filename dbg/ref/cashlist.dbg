     3235       end.
     3236       if cas-shft  then
     3237       do:
     3238         run ref/shftcshs.w (  input parparentproc
     3239           ,input (if lookup("b-add", bttns) > 0 then 'ИЗМЕНЕНИЕ':U else 'ПРОСМОТР':U)
     3240           ,input 'касс':U
     3241           ,input recid( check_cash-desk )
     3242           ,input  ?
     3243           ,input check_cash-desk.obj-code ) .
     3244       end.
