     4635   procedure get-context :
     4636      define output parameter p-db-num as integer          no-undo.
     4637      define output parameter p-user-id as character        no-undo.
     4638      define variable v-login               as character    no-undo.
     4639      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4640      define buffer buf_user-login  for ub.user-login .
     4641      do
     4642      on error undo, return error
     4643      :
     4644            FIND FIRST buf_sys-ctrl no-lock.
     4645            ASSIGN
     4646               v-login = USERID("ub")
     4647               p-db-num = buf_sys-ctrl.db-num
     4648            .
     4649            FIND FIRST buf_user-login
     4650                 WHERE buf_user-login.db-num = p-db-num
     4651                   AND buf_user-login.user-login = v-login
     4652                 no-lock
     4653                 no-error
     4654                 .
     4655            IF AVAILABLE buf_user-login
     4656            THEN DO:
     4657               assign
     4658                  p-user-id = buf_user-login.user-id
     4659               .
     4660            END.
     4661      end.
     4662   end procedure.
     4663       run diasize_init in this-procedure .
     4664   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4665   do:
     4666     br-cash-desk :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     4667   end.
     4668   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4669   procedure set-filter-name :
     4670   define input parameter p-filter-name as character no-undo .
     4671     do with frame Dialog-Frame:
     4672       if p-filter-name > "" then do:
     4673         assign
     4674           frame Dialog-Frame:title
     4675             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     4676         .
     4677         assign
     4678           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     4679         .
     4680       end.
     4681       else do:
     4682         assign
     4683           b-sch :tooltip = ""
     4684         .
     4685       end.
     4686     end.
     4687   end procedure.
     4688   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4689   on f5 of frame Dialog-Frame anywhere
     4690   do:
     4691      if available X_cash-desk then p-rec = recid(X_cash-desk). Run openbr in this-procedure  ( input yes, input no, input '':U).
     4692       apply "VALUE-CHANGED" to BR-cash-desk.
     4693   end.
     4694   MAIN-BLOCK:
     4695   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4696     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4697   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4698     run mainmenu_getcntxt in parparentproc
     4699       (output v-cntxt-db-num
     4700       ,output v-cntxt-userid
     4701       ,output v-cntxt-level
     4702       ,output v-cntxt-host-code-obj
     4703       ,output v-cntxt-obj-type
     4704       ,output v-cntxt-obj-code
     4705       ,output v-cntxt-db-num-obj
     4706       ,output v-cntxt-is-admin
     4707       ) .
     4708     FIND FIRST buf_cli No-LOCK WHERE
     4709       buf_cli.obj-type = parobj-type and
     4710       buf_cli.obj-code = parobj-code No-ERROR.
     4711     if not avail buf_cli then
     4712     do:
     4713       message
     4714         vss-workfile vss-revision vss-description skip
     4715         "Неверный вызов - parobj-type=" parobj-type "parobj-code=" parobj-code
     4716         view-as alert-box ERROR.
     4717       return.
     4718     end.
     4719     CASE parref-mode:
     4720       WHEN 'все':U        THEN
     4721         DO:
     4722         END.
     4723       WHen 'объект':U then
     4724         do:
     4725         end.
     4726       when "db":U then
     4727         do:
     4728         end.
     4729       otherwise
     4730       do:
     4731         message vss-workfile vss-revision vss-description skip
     4732           "Неверный вызов - parref-mode=" parref-mode
     4733           view-as alert-box ERROR.
     4734         return.
     4735       end.
     4736     end case.
     4737     v-mode = parref-mode.
     4738     if v-mode = 'все':U then del-mode = ?.
     4739     else del-mode = no.
     4740     RUN MyEnable in this-procedure .
     4741     HIDE mark-num in frame Dialog-Frame .
     4742     run OpenBR in this-procedure  ( input yes, input no, input '':U).
     4743     WAIT-FOR GO OF FRAME Dialog-Frame.
     4744   END.
     4745   RUN disable_UI.
     4746   PROCEDURE curshift :
     4747     DEFINE INPUT PARAMETER shop-code like ub.cash-desk.obj-code no-undo.
     4748     DEFINE INPUT PARAMETER silence as logical no-undo.
     4749   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4750   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     4751     (input  'маг':U
     4752     ,input  shop-code
     4753     ,output v-shift-date
     4754     ,output v-shift-num
     4755     ,output v-shift-name
     4756     ) no-error .
     4757     if error-status:error then
     4758     do:
     4759       if silence then
     4760         message return-value view-as alert-box ERROR.
     4761       return error return-value.
     4762     end.
     4763   END PROCEDURE.
     4764   PROCEDURE disable_UI :
     4765     HIDE FRAME Dialog-Frame.
     4766   END PROCEDURE.
     4767   PROCEDURE enable_UI :
     4768     DISPLAY mark-num Rs-object Rs-del
     4769       WITH FRAME Dialog-Frame.
     4770     ENABLE b-quit B-mark b-sel B-add B-chg B-del B-on B-shft B-attr B-print
     4771       B-hist B-sch B-Help mark-num Rs-object Rs-del B-cli-attr B-attr-2
     4772       b-version BR-cash-desk b-tso
     4773       WITH FRAME Dialog-Frame.
     4774     VIEW FRAME Dialog-Frame.
     4775   END PROCEDURE.
     4776   PROCEDURE MyEnable :
     4777     ASSIGN
     4778       b-attr:MENU-MOUSE IN frame Dialog-Frame       = 1
     4779       b-attr-2:MENU-MOUSE IN frame Dialog-Frame     = 1
     4780       rs-object:RADIO-BUTTONS IN FRAME Dialog-Frame = (IF parref-mode = 'все':U AND v-cntxt-db-num = 0
     4781                                                     THEN ("Все" + chr(44) + 'все':U + chr(44) +
     4782                                                         "БД" + chr(44) + 'db':U + chr(44) +
     4783                                                           parobj-type + string(parobj-code) + chr(44) + 'объект':U)
     4784                                                     ELSE ("БД" + chr(44) + 'db':U + chr(44) +
     4785                                                           parobj-type + string(parobj-code) + chr(44) + 'объект':U))
     4786       rs-del                                         = del-mode.
     4787     DISPLAY
     4788       mark-num
     4789       rs-del
     4790       WITH FRAME Dialog-Frame .
     4791     ENABLE
     4792       B-quit
     4793       B-mark
     4794       when lookup('b-mark':U, bttns) >0
     4795       B-sel
     4796       when lookup('b-sel':U, bttns) >0
     4797       B-add
     4798       when lookup('b-add':U, bttns) >0 and parref-mode <> 'все':U AND NOT TRANSACTION
     4799       B-chg
     4800       when lookup('b-add':U, bttns) >0 and parref-mode <> 'все':U AND NOT TRANSACTION
     4801       B-del
     4802       when lookup('b-add':U, bttns) >0 and parref-mode <> 'все':U AND NOT TRANSACTION
     4803       B-on
     4804       when lookup('b-on':U, bttns) >0 and parref-mode <> 'все':U AND NOT TRANSACTION
     4805       B-version
     4806       when lookup('b-add':U, bttns) >0 and parref-mode <> 'все':U AND NOT TRANSACTION
     4807       b-tso
     4808       b-attr
     4809       b-attr-2
     4810       b-cli-attr
     4811       B-shft
     4812       B-sch
     4813       B-print
     4814       B-hist
     4815       B-Help
     4816       rs-object
     4817       rs-del
     4818       WHEN parref-mode <> 'все':U
     4819       BR-cash-desk
     4820       mark-num
     4821       WITH FRAME Dialog-Frame .
     4822     VIEW FRAME Dialog-Frame .
     4823   END PROCEDURE.
     4824   PROCEDURE OpenBr :
     4825     define input  parameter p-open-query     as logical   no-undo .
     4826     define input  parameter p-find-next      as logical   no-undo .
     4827     define input  parameter p-find-condition as character no-undo .
     4828     define variable l-query-was-opened as logical   no-undo .
     4829     define variable sort-column-phrase as character no-undo .
     4830     case sort-column-name :
     4831       when "" then
     4832         do:
     4833           assign
     4834             sort-column-phrase = ""
     4835             .
     4836         end.
     4837       otherwise
     4838       do:
     4839         assign
     4840           sort-column-phrase = "by " + sort-column-name
     4841           .
     4842       end.
     4843     end case.
     4844     CASE v-mode:
     4845       when 'все':U then
     4846         do:
     4847           CASE del-mode :
     4848             WHEN ? THEN
     4849               DO:
     4850                 ASSIGN
     4851                   frame Dialog-Frame:TITLE = "Справочник касс"
     4852                   filter-point              = filter-point0 + parref-mode.
     4853   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
