      124   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   procedure cur-time :
      126      define output parameter p-today as date      no-undo .
      127      define output parameter p-time  as integer   no-undo .
      128     do
      129     on error undo, return error
      130     :
      131       define variable v-date1 as date      no-undo .
      132       define variable v-date2 as date      no-undo .
      133       define variable v-time  as integer   no-undo .
      134       assign
      135         v-date1 = today
      136         v-time  = time
      137         v-date2 = today
      138       .
      139       if v-date1 <> v-date2
      140       then do:
      141         assign
      142           v-date1 = today
      143           v-time  = v-time
      144         .
      145       end.
      146       assign
      147         p-today = v-date1
      148         p-time  = v-time
      149       .
      150     end.
      151   end.
      152   function cur-time-date returns character
      153   :
      154     return string(today, '99/99/9999':U) .
      155   end.
      156   function cur-time-mjd returns decimal
      157   :
      158     define variable v-date as date      no-undo .
      159     define variable v-time as integer   no-undo .
      160     run cur-time in this-procedure
      161       (output v-date
      162       ,output v-time
      163       ) .
      164     return integer(v-date) - 2400002 + (v-time / 86400) .
      165   end.
      166   function cur-time-get-ending-index returns integer
      167   (input p-number as integer
      168   )
      169   :
      170     if p-number < 0
      171     or p-number = ?
      172     then do:
      173       return 1 .
      174     end.
      175     define variable v-rest as integer   no-undo .
      176     assign
      177       p-number = p-number modulo 100
      178     .
      179     if p-number < 20
      180     then do:
      181       assign
      182         v-rest = p-number
      183       .
      184     end.
      185     else do:
      186       assign
      187         v-rest = p-number modulo 10
      188       .
      189     end.
      190     case v-rest :
      191       when 1
      192       then do:
      193         return 2 .
      194       end.
      195       when 2 or
      196       when 3 or
      197       when 4
      198       then do:
      199         return 3 .
      200       end.
      201       otherwise do:
      202         return 1 .
      203       end.
      204     end case .
      205   end.
      206   procedure cur-time-mjd-to-date :
      207      define input  parameter i-mjd-diff as decimal no-undo.
      208      define output parameter o-Date     as date    no-undo.
      209      define output parameter o-Time     as integer no-undo.
      210      define variable v-day-number as integer   no-undo .
      211      if    i-mjd-diff < 0
      212         or i-mjd-diff = ?
      213      then do:
      214         return "?" .
      215      end.
      216      assign
      217         v-day-number = truncate(i-mjd-diff,0).
      218         o-Date = date(v-day-number + 2400002).
      219         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      220     .
      221   end.
      222   function cur-time-mjd-to-string returns character
      223   (input p-mjd-diff as decimal
      224   )
      225   :
      226     define variable v-day-number as integer   no-undo .
      227     define variable v-seconds    as integer   no-undo .
      228     define variable v-hour       as integer   no-undo .
      229     define variable v-min        as integer   no-undo .
      230     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      231     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      232     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      233     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      234     if p-mjd-diff < 0
      235     or p-mjd-diff = ?
      236     then do:
      237       return "?" .
      238     end.
      239     assign
      240       v-day-number = integer(truncate(p-mjd-diff,0))
      241       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      242     .
      243     if v-seconds > 86400
      244     then do:
      245       assign
      246         v-seconds = 86400 - 1
      247       .
      248     end.
      249     if v-seconds < 0
      250     then do:
      251       assign
      252         v-seconds = 0
      253       .
      254     end.
      255     assign
      256       v-hour = truncate(v-seconds / 3600, 0)
      257     .
      258     assign
      259       v-seconds = v-seconds modulo 3600
      260     .
      261     assign
      262       v-min = truncate(v-seconds / 60, 0)
      263     .
      264     assign
      265       v-seconds = v-seconds modulo 60
      266     .
      267     return
      268         (if v-day-number <> 0
      269           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      270           else ""
      271         )
      272       + (if v-day-number <> 0 or v-hour <> 0
      273           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      274           else ""
      275         )
      276       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      277           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      278           else ""
      279         )
      280       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      281       .
      282   end.
      283   function cur-time-string returns character
      284   :
      285     define variable v-date as date      no-undo .
      286     define variable v-time as integer   no-undo .
      287     run cur-time in this-procedure
      288       (output v-date
      289       ,output v-time
      290       ) .
      291     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      292   end.
      293   function cur-time-string-sec returns character
      294   :
      295     define variable v-date as date      no-undo .
      296     define variable v-time as integer   no-undo .
      297     run cur-time in this-procedure
      298       (output v-date
      299       ,output v-time
      300       ) .
      301     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      302   end.
      303   function cur-time-custom  returns character
      304   (input p-prefix as character
      305   ,input p-date-format as character
      306   ,input p-delimiter as character
      307   ,input p-time-format as character
      308   ,input p-suffix as character
      309   )
      310   :
      311     define variable v-date as date      no-undo .
      312     define variable v-time as integer   no-undo .
      313     run cur-time in this-procedure
      314       (output v-date
      315       ,output v-time
      316       ) .
      317     return
      318       p-prefix
      319       + string(v-date, p-date-format)
      320       + p-delimiter
      321       + string(v-time, p-time-format)
      322       + p-suffix
      323       .
      324   end.
      325   function cur-time-print  returns character
      326   :
      327     define variable v-date as date      no-undo .
      328     define variable v-time as integer   no-undo .
      329     run cur-time in this-procedure
      330       (output v-date
      331       ,output v-time
      332       ) .
      333     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      334   end.
      335   function cur-time-datetime returns datetime
      336   :
      337     define variable v-char as character no-undo .
      338     define variable v-datetime as datetime no-undo .
      339     v-char = cur-time-string().
      340     v-datetime = datetime(v-char).
      341     return  v-datetime.
      342   end.
      343   function cur-time-string-msec returns character
      344   :
      345     define variable v-date as datetime  no-undo .
      346     v-date = now.
      347     return string(v-date) .
      348   end.
      349   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      350   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      351   define new shared variable RepPathName        as character no-undo .
      352   define new shared variable PrintRubl          as logical   no-undo .
      353   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      354   define variable c-point  as character no-undo .
      355   define variable tbl      as character no-undo .
      356   define variable join-tbl as character no-undo .
      357   define variable fld      as character no-undo .
      358   define variable lab      as character no-undo .
      359   define variable spr      as character no-undo .
      360   define variable dim      as character no-undo .
      361   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   procedure fltfield-clear :
      363     define output parameter loc-fld as character no-undo.
      364     define output parameter loc-lab as character no-undo .
      365     define output parameter loc-spr as character no-undo .
      366     define output parameter loc-dim as character no-undo .
      367     assign
      368       loc-fld = ""
      369       loc-lab = ""
      370       loc-spr = ""
      371       loc-dim = "0"
      372     .
      373   end procedure .
      374   procedure fltfield-add :
      375     define input        parameter par-fld as character no-undo.
      376     define input        parameter par-lab as character no-undo .
      377     define input        parameter par-spr as character no-undo .
      378     define input-output parameter loc-fld as character no-undo.
      379     define input-output parameter loc-lab as character no-undo .
      380     define input-output parameter loc-spr as character no-undo .
      381     define input-output parameter loc-dim as character no-undo .
      382     do
      383     on error undo, return error
      384     :
      385       assign
      386       loc-fld = if loc-dim = '0'
      387                 then par-fld
      388                 else (loc-fld + chr(44) + par-fld)
      389       loc-lab = if loc-dim = '0'
      390                 then par-lab
      391                 else (loc-lab + chr(44) + par-lab)
      392       loc-spr = if loc-dim = '0'
      393                 then par-spr
      394                 else (loc-spr + chr(44) + par-spr)
      395       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      396                 string(integer(if num-entries(loc-dim) > 1
      397                               then entry(2, loc-dim)
      398                               else entry(1, loc-dim)
      399                               ) + 1)
      400       no-error
      401       .
      402     end.
      403   end procedure.
      404   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      405   define  stream PrnLibStream.
      406   procedure prn-lib-prn-file :
      407     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      408     define input parameter p-DIsabledoptions as integer no-undo .
      409     define variable v-report-name as character no-undo .
      410     define variable v-user-action as character no-undo .
      411     define variable v-printed     as logical   no-undo .
      412     define variable v-exist       as logical   no-undo .
      413     do
      414       on error undo, return error
      415       :
      416       run prn-lib-get-report-name  in this-procedure (
      417         input parParentProc
      418         ,output v-report-name
      419         ).
      420   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      421   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      422     (input  v-report-name
      423     ,input  2
      424     ,output v-exist
      425     )  .
      426       if NOT v-exist then
      427       DO:
      428         Message
      429           "Нет заданий на печать ! "
      430           view-as alert-box .
      431         Return  .
      432       End.
      433       run gbl/prnfilen.w
      434         (input  ""
      435         ,input  p-DisabledOptions
      436         ,input  string(v-report-name )
      437         ,input  7
      438         ,output v-user-action
      439         ,output v-printed
      440         ) .
      441       if v-printed then
      442       do:
      443         return "YES" .
      444       end.
      445       else
      446       do:
      447         return "NO" .
      448       end.
      449     end.
      450   end procedure.
      451   procedure prn-lib-open-stream :
      452     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      453     define input parameter p-page-size    as integer no-undo .
      454     define input parameter p-is-stream    as logical no-undo .
      455     define input parameter p-append       as logical no-undo .
      456     define variable v-report-name as character no-undo .
      457     do
      458       on error undo, return error
      459       :
      460       run prn-lib-get-report-name  in this-procedure (
      461         input parParentProc
      462         ,output v-report-name
      463         ).
      464       if p-is-stream then
      465       do:
      466         if p-append then
      467         do:
      468           output stream PrnLibStream to value( v-report-name )
      469             page-size value(p-page-size) append .
      470         end.
      471         if not p-append then
      472         do:
      473           output stream PrnLibStream to value( v-report-name )
      474             page-size value(p-page-size) .
      475         end.
      476       end.
      477       if not p-is-stream then
      478       do:
      479         if p-append then
      480         do:
      481           output to value( v-report-name )
      482             page-size value(p-page-size) append .
      483         end.
      484         if not p-append then
      485         do:
      486           output to value( v-report-name )
      487             page-size value(p-page-size) .
      488         end.
      489       end.
      490     end.
      491   end procedure.
      492   procedure prn-lib-open-exp :
      493     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      494     define input parameter p-is-stream    as logical no-undo .
      495     define input parameter p-is-append    as logical no-undo .
      496     define output parameter p-ReportFileName as char init "report" no-undo.
      497     define output parameter p-process as logical no-undo .
      498     define variable glog as logical no-undo .
      499     do
      500       on error undo, return error
      501       :
      502       SYSTEM-DIALOG GET-FILE p-ReportFileName
      503         TITLE      "Укажите путь"
      504         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      505         ASK-OVERWRITE
      506         CREATE-TEST-FILE
      507         SAVE-AS
      508         USE-FILENAME
      509         DEFAULT-EXTENSION "txt"
      510         UPDATE glog
      511         .
      512       if not glog then  return.
      513       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      514       if p-is-stream then
      515       do:
      516         if p-is-append then
      517         do:
      518           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      519         end.
      520         else
      521         do:
      522           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      523         end.
      524       end.
      525       else
      526       do:
      527         if p-is-append then
      528         do:
      529           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      530         end.
      531         else
      532         do:
      533           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      534         end.
      535       end.
      536       p-process = yes.
      537     end.
      538   end procedure.
      539   procedure prn-lib-get-report-name :
      540     define input parameter parParentProc  as widget-handle no-undo.
      541     define output parameter p-report-name as character no-undo .
      542     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      543   end procedure.
      544   procedure prn-lib-reportviewer-report-name :
      545     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      546     define input parameter p-report-name-html as character no-undo .
      547     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      548   end procedure.
      549   procedure prn-lib-reportviewer :
      550     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      551     define input parameter p-report-name-html as character no-undo .
      552     define input parameter p-param        as character no-undo .
      553     define variable v-excel           as character no-undo init 'TRUE' .
      554     define variable v-value-character as character no-undo .
      555     define variable v-value-integer   as character no-undo .
      556     define variable v-value-date      as date      no-undo .
      557     define variable v-value-decimal   as decimal   no-undo .
      558     define variable rep-excel         as logical   no-undo .
      559     define variable excel-string      as character no-undo .
      560     define variable v-param-type      as character no-undo .
      561     define variable v-tth             as handle    no-undo .
      562     run adm/shattri.p (
      563       input "get":U
      564       ,input  ""
      565       ,input  0
      566       ,input  'report-glob':U
      567       ,input  'rep-excel':U
      568       ,output v-value-character
      569       ,output v-value-date
      570       ,output v-value-decimal
      571       ,output v-value-integer
      572       ,output rep-excel
      573       ,output v-param-type
      574       ,INPUT-OUTPUT table-handle v-tth
      575       )  .
      576     if rep-excel then v-excel = "TRUE" .
      577     else v-excel = "FALSE" .
      578     if p-param eq ""
      579     then
      580        p-param = "EXCEL:" + v-excel.
      581     else
      582        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      583     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      584   end procedure.
      585   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      586   define variable v-waitfram-action01         as character   no-undo .
      587   define variable v-waitfram-action02         as character   no-undo .
      588   define variable v-waitfram-action03         as character   no-undo .
      589   define variable mWaitFramTextBeg            as character   no-undo.
      590   define variable mWaitFramTextEnd            as character   no-undo.
      591   define variable mWaitFramView               as logical     no-undo.
      592   define variable mWaitProcEvent              as logical     no-undo init yes.
      593   define variable mWaitFramInterval           as integer     no-undo init 1 .
      594   define variable mWaitFramStop               as logical     no-undo.
      595   define variable mWaitFramStopUser           as logical     no-undo.
      596   define variable mWaitFramStopTimeOut        as logical     no-undo.
      597   define variable mWaitFramStartProc          as datetime-tz no-undo.
      598   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      599   define button B-WaitFramStop auto-end-key
      600        label "Стоп"
      601        size 10 by 1 tooltip "Остоновить процесс".
      602   define button B-viewProcInfo
      603        label "Информация"
      604        size 15 by 1 tooltip "Информация о процесс".
      605   define frame waitfram
      606     v-waitfram-action01 format "x(72)" no-label skip
      607     v-waitfram-action02 format "x(72)" no-label skip
      608     v-waitfram-action03 format "x(72)" no-label skip
      609     B-viewProcInfo
      610     B-WaitFramStop at row 4 col 30
      611     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      612     .
      613   define new global shared variable mBatchMode as logical no-undo init ?.
      614   define variable mFramBachModHandle as handle no-undo.
      615   mFramBachModHandle = frame waitfram:handle.
      616   define variable mFameOldVis as logical no-undo.
      617   define variable mVisCUrentVin as logical no-undo.
      618   if session:batch-mode
      619   then
      620      mBatchMode = yes.
      621   if mBatchMode = ? then do:
      622     mVisCUrentVin = current-window:visible.
      623     mFameOldVis = mFramBachModHandle:visible.
      624     mFramBachModHandle:visible  = yes.
      625     mBatchMode = mFramBachModHandle:visible ne yes.
      626     mFramBachModHandle:visible = mFameOldVis.
      627     current-window:visible = mVisCUrentVin.
      628   end.
      629    if  log-manager:logfile-name ne ?
      630     then DO:
      631         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      632         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      633         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      634     end.
      635   on choose of B-WaitFramStop in frame waitfram
      636   do:
      637     mWaitFramStop = yes.
      638     mWaitFramStopUser = yes.
      639   end.
      640   function waitfram-check-timeout returns logical():
      641      define variable vtime as int64 no-undo.
      642      if mWaitFramStopTimeOut
      643      then
      644         return yes.
      645      vtime = ( now - mWaitFramStartProc ) / 1000 .
      646      if     mWaitFramTimeOut ne ?
      647         and mWaitFramTimeOut ne 0
      648         and mWaitFramTimeOut lt vtime
      649      then do:
      650         mWaitFramStopTimeOut = yes.
      651      end.
      652      return mWaitFramStopTimeOut.
      653   end.
      654   procedure waitfram-hide :
      655     if not session:batch-mode
      656     then do
      657     on error undo, return error return-value
      658     :
      659       pause 0 before-hide .
      660       if not mBatchMode then
      661         hide frame waitfram .
      662     if     not mWaitFramView
      663        and mWaitProcEvent
      664     then
      665       process events .
      666     end.
      667   end procedure.
      668   procedure waitfram-show :
      669     define input  parameter p-message as character no-undo .
      670     define variable v-left-margin as integer   no-undo .
      671     if not session:batch-mode
      672     then do
      673     on error undo, return error return-value
      674     :
      675       if length(p-message) <= 70 then do:
      676         assign
      677           v-left-margin = integer((70 - length(p-message)) / 2)
      678         .
      679         assign
      680           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      681         .
      682         assign
      683           v-waitfram-action01 = " "
      684           v-waitfram-action02 = " "
      685                                    + fill(" ", v-left-margin)
      686                                    + p-message
      687           v-waitfram-action03 = " "
      688         .
      689       end.
      690       else do:
      691         define variable vRindex1 as integer no-undo.
      692         define variable vRindex2 as integer no-undo.
      693         vRindex1 = r-index(p-message," ",70).
      694         if vRindex1 = 0
      695         then
      696            vRindex1 = 70.
      697         if length(p-message)  <= vRindex1 + 70 then do:
      698           assign
      699             v-waitfram-action01 = " "
      700             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      701             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      702           .
      703         end.
      704         else do:
      705           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      706           if vRindex2 <= vRindex1
      707           then
      708              vRindex2 = vRindex1 + 70.
      709           assign
      710             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      711             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      712             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      713           .
      714         end.
      715       end.
      716       B-viewProcInfo:visible   in frame waitfram = no.
      717       B-viewProcInfo:sensitive in frame waitfram = no.
      718       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      719       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      720       if  (   mWaitFramView
      721          or  mWaitProcEvent)
      722          and not mBatchMode
      723       then
      724          display
      725             v-waitfram-action01 skip
      726             v-waitfram-action02 skip
      727             v-waitfram-action03 skip
      728          with frame waitfram .
      729       if     mWaitFramView
      730          then do:
      731             if     mWaitFramInterval ne ?
      732                and not mBatchMode
      733             then
      734                wait-for go of frame waitfram pause mWaitFramInterval.
      735          end.
      736          else
      737             if     mWaitProcEvent
      738                and not mBatchMode
      739             then
      740                process events .
      741     end.
      742   end procedure.
      743      procedure waitfram-show-this:
      744         define input  parameter iInterval as int64 no-undo.
      745         define variable vtime as int64 no-undo.
      746         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      747         mWaitFramInterval = iInterval.
      748         run waitfram-show (substitute("&1&2 &3&4" ,
      749                                       mWaitFramTextBeg ,
      750                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      751                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      752                                       mWaitFramTextEnd
      753                                      )
      754                           ).
      755      end.
      756      procedure WaitFramRunPause:
      757         define input  parameter iInterval as dec no-undo.
      758         define variable vStart  as datetime-tz no-undo.
      759         define variable vend    as datetime-tz no-undo.
      760         define variable vint as int64 no-undo.
      761         define variable vOk as logical no-undo.
      762         vStart = now.
      763         vend   = vStart.
      764         publish "WaitFramPause" (iInterval,output vOk).
      765         vend   =  now.
      766         vint = vend - vStart.
      767         vint = iInterval - vint / 1000.
      768         if     not mWaitFramStop
      769            and (   vint > 0
      770                 or (    not vOk
      771                     and iInterval eq ?
      772                     )
      773                 )
      774         then
      775            run waitfram-show-this (iInterval).
      776         vend   =  now.
      777         vint = vend - vStart.
      778         vint = iInterval - vint / 1000.
      779         if     not mWaitFramStop
      780            and vint > 0
      781         then do:
      782            run gbl/pause.p (vint * 1000).
      783         end.
      784         if iInterval ne ?
      785         then
      786            publish "WaitFramStop".
      787         waitfram-check-timeout().
      788      end.
      789      procedure WaitFramWaitFor:
      790         define input  parameter iInterval as dec no-undo.
      791         assign
      792            mWaitFramStartProc   = now
      793            mWaitFramStopUser    = no
      794            mWaitFramStopTimeOut = no
      795         .
      796         block-wait:
      797         do while not mWaitFramStop:
      798            run WaitFramRunPause (iInterval).
      799            if  waitfram-check-timeout()
      800            then do:
      801               leave block-wait.
      802            end.
      803         end.
      804         run waitfram-hide.
      805      end.
      806   procedure waitfram-join :
      807     define input  parameter p-line-1  as character no-undo .
      808     define input  parameter p-line-2  as character no-undo .
      809     define input  parameter p-line-3  as character no-undo .
      810     define output parameter p-message as character no-undo .
      811     do
      812     on error undo, return error return-value
      813     :
      814       assign
      815         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      816                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      817                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      818       .
      819     end.
      820   end procedure.
      821   function waitfram-join-function returns character
      822     (input p-line-1 as character
      823     ,input p-line-2 as character
      824     ,input p-line-3 as character
      825     ).
      826     define variable v-message as character no-undo .
      827     run waitfram-join in this-procedure
      828       (input  p-line-1
      829       ,input  p-line-2
      830       ,input  p-line-3
      831       ,output v-message
      832       ) .
      833     return v-message .
      834   end function .
