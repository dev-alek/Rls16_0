     3400   end.
     3401   run minbtn-set in this-procedure .
     3402   on choose of b-help in frame Dialog-Frame
     3403   do:
     3404     apply "help":u to frame Dialog-Frame .
     3405   end.
     3406   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3407   procedure minbtn-set :
     3408       do
     3409           on error undo, return error return-value
     3410           :
     3411           define variable ii              as integer       no-undo .
     3412           define variable fh              as widget-handle no-undo .
     3413           define variable hh              as widget-handle no-undo .
     3414           define variable v-h             as handle        extent 4 no-undo .
     3415           define variable v-name-button   as character     no-undo .
     3416           define variable v-help-old-x    as decimal       no-undo .
     3417           define variable v-help-old-y    as decimal       no-undo .
     3418           define variable v-help-old-size as decimal       no-undo .
     3419           define variable v-frame-width   as decimal       no-undo .
     3420           define variable jj              as integer       no-undo .
     3421           do
     3422               on error undo, return error
     3423               :
     3424               assign
     3425                   v-frame-width = frame Dialog-Frame:width - 0.3
     3426                   fh            = frame Dialog-Frame:first-child
     3427                   hh            = fh:first-child
     3428                   ii            = 1
     3429                   .
     3430               do while valid-handle(hh):
     3431                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3432                   do:
     3433                       case lc(hh:name) :
     3434                           when "b-help" then
     3435                               do:
     3436                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3437                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3438                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3439                                   hh:TOOLTIP = "Помощь" .
     3440                                   v-help-old-x = hh:column .
     3441                                   v-help-old-y = hh:row    .
     3442                                   v-help-old-size = hh:width .
     3443                                   hh:width-chars = 2.5 .
     3444                               end.
     3445                           when "b-print" then
     3446                               do:
     3447                                   hh:load-image("cmp/b-print.bmp":u) .
     3448                                   hh:TOOLTIP = "Печать" .
     3449                                   v-h[ii] = hh:handle .
     3450                                   ii = ii + 1 .
     3451                                   hh:width-chars = 3 .
     3452                               end.
     3453                           when "b-history" or
     3454                           when "b-hist" then
     3455                               do:
     3456                                   hh:load-image("cmp/b-hist.bmp":u) .
     3457                                   hh:TOOLTIP = "История" .
     3458                                   v-h[ii] = hh:handle .
     3459                                   ii = ii + 1 .
     3460                                   hh:width-chars = 3 .
     3461                               end.
     3462                           when "b-sch" then
     3463                               do:
     3464                                   hh:load-image("cmp/b-sch.bmp":u) .
     3465                                   hh:TOOLTIP = "Установка Фильтра" .
     3466                                   v-h[ii] = hh:handle .
     3467                                   ii = ii + 1 .
     3468                                   hh:width-chars = 3 .
     3469                               end.
     3470                           when "b-hist-user" then
     3471                               do:
     3472                                   hh:load-image("cmp/b-hist.bmp":u) .
     3473                                   hh:TOOLTIP = "История пользователя" .
     3474                                   ii = ii + 1 .
     3475                               end.
     3476                       end case.
     3477                   end.
     3478                   hh = hh:next-sibling.
     3479               end.
     3480               b-help:column = v-frame-width - b-help:width-chars.
     3481               jj = 0.
     3482               repeat ii = 4 to 1 by -1 :
     3483                   if valid-handle (v-h[ii] ) then
     3484                   do:
     3485                       jj  = jj + 1 .
     3486                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3487                       v-h[ii]:row    = v-help-old-y .
     3488                   end.
     3489               end.
     3490           end.
     3491       end.
     3492   end procedure.
     3493   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3494   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3495   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3496   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3497   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3498   define variable v-diasize-current-frame-height as decimal   no-undo .
     3499   define variable v-diasize-change-size          as logical   no-undo .
     3500   define variable v-diasize-resize-button        as handle    no-undo .
     3501   define variable v-diasize-wndmax               as logical   no-undo .
     3502   define variable v-diasize-wndstore             as logical   no-undo .
     3503   define variable v-diasize-proc-name            as character no-undo .
     3504   define variable v-diasize-browse-handle        as handle    no-undo .
     3505   define variable v-diasize-browse-number        as integer   no-undo .
     3506   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3507   define temp-table temp-diasize-handle no-undo
     3508     field handle-value  as handle
     3509     field save-position as decimal
     3510     index xpk is primary unique handle-value
     3511     .
     3512   define temp-table temp-browse-handle no-undo
     3513     field browse-type   as character
     3514     field browse-number as integer
     3515     field browse-handle as handle
     3516     field original-size as decimal
     3517     index xpk is primary unique browse-type browse-number
     3518     index xie browse-type browse-handle
     3519   .
     3520   procedure diasize_change-height :
     3521     define input  parameter p-change-value  as decimal   no-undo .
     3522     define input  parameter p-move-resize   as logical   no-undo .
     3523     define variable v-field-group-handle    as handle    no-undo .
     3524     define variable v-object-handle         as handle    no-undo .
     3525     define variable v-frame-height          as decimal   no-undo .
     3526     define variable v-frame-virtual-height  as decimal   no-undo .
     3527     define variable v-browse-height         as decimal   no-undo .
     3528     define variable v-window-height         as decimal   no-undo .
     3529     define variable v-window-virtual-height as decimal   no-undo .
     3530     define variable v-change-sign           as integer   no-undo .
     3531     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3532     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3533     if p-change-value > 0
     3534     then do:
     3535       if frame Dialog-Frame :height + p-change-value
     3536           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3537       then do:
     3538         assign
     3539           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3540                           - (frame Dialog-Frame :height-chars)
     3541         .
     3542         if p-change-value <= 0
     3543         then do:
     3544           run diasize_position-resize-button in this-procedure .
     3545           return .
     3546         end.
     3547       end.
     3548     end.
     3549     if p-change-value < 0
     3550     then do:
     3551       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3552       then do:
     3553         assign
     3554           p-change-value = v-diasize-orig-frame-height
     3555                          - (frame Dialog-Frame :height-chars)
     3556         .
     3557         if p-change-value >= 0
     3558         then do:
     3559           run diasize_position-resize-button in this-procedure .
     3560           return .
     3561         end.
     3562       end.
     3563     end.
     3564     if p-change-value >= 0
     3565     then do:
     3566       assign
     3567         v-change-sign = 1
     3568       .
     3569     end.
     3570     else do:
     3571       assign
     3572         v-change-sign = -1
     3573       .
     3574     end.
     3575     assign
     3576       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3577     .
     3578     if p-change-value = 0
     3579     then do:
     3580       run diasize_position-resize-button in this-procedure .
     3581       return .
     3582     end.
     3583     move_block:
     3584     do
     3585     on error undo move_block, retry move_block
     3586     :
     3587       if retry
     3588       then do:
     3589         do
     3590         on error undo move_block, leave move_block
     3591         :
     3592           if p-change-value > 0
     3593           then do:
     3594             for each buf_temp-diasize-handle
     3595             on error undo, next
     3596             :
     3597               assign
     3598                 v-object-handle = buf_temp-diasize-handle.handle-value
     3599               .
     3600               if v-object-handle <> v-diasize-resize-button
     3601               then do:
     3602                 assign
     3603                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3604                 .
     3605               end.
     3606             end.
     3607             assign
     3608               v-diasize-browse-handle :height = v-browse-height
     3609             .
     3610             for each buf_temp-browse-handle
     3611               where buf_temp-browse-handle.browse-type = 'height':u
     3612             on error undo, next
     3613             :
     3614               assign
     3615                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3616               .
     3617             end.
     3618             assign
     3619               frame Dialog-Frame :height = v-frame-height
     3620             .
     3621             if frame Dialog-Frame :scrollable = true
     3622             then do:
     3623               assign
     3624                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3625               .
     3626             end.
     3627             run diasize_position-resize-button in this-procedure .
     3628           end.
     3629           else do:
     3630             if frame Dialog-Frame :scrollable = true
     3631             then do:
     3632               assign
     3633                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3634               .
     3635             end.
     3636             assign
     3637               frame Dialog-Frame :height = v-frame-height
     3638             .
     3639             assign
     3640               v-diasize-browse-handle :height = v-browse-height
     3641             .
     3642             for each buf_temp-browse-handle
     3643               where buf_temp-browse-handle.browse-type = 'height':u
     3644             on error undo, next
     3645             :
     3646               assign
     3647                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3648               .
     3649             end.
     3650             for each buf_temp-diasize-handle
     3651             on error undo, next
     3652             :
     3653               assign
     3654                 v-object-handle = buf_temp-diasize-handle.handle-value
     3655               .
     3656               if v-object-handle <> v-diasize-resize-button
     3657               then do:
     3658                 assign
     3659                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3660                 .
     3661               end.
     3662             end.
     3663             run diasize_position-resize-button in this-procedure .
     3664           end.
     3665           assign
     3666             v-diasize-change-size = false
     3667           .
     3668           leave move_block .
     3669         end.
     3670       end.
