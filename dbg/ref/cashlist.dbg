     5895     run cd-attr-value in this-procedure (
     5896       input   p-db-num
     5897       ,input  p-obj-code
     5898       ,input  p-pos-type
     5899       ,input  p-cash-num
     5900       ,input  (if p-pos-type = 'IBM-XML':U
     5901       then 'IBM-XML_operative':U
     5902       else 'AUTOTANK_operative':U)
     5903       ,input  (if p-pos-type = 'IBM-XML':U
