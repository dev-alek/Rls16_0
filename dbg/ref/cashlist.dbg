     1055       (input  p-obj-type
     1056       ,input  p-obj-code
     1057       ,input  p-upper-code
     1058       ,input  table-handle p-tth
     1059       ) no-error .
     1060     if error-status :error
     1061     then do:
     1062       delete object p-tth.
     1063       undo, return error return-value .
     1064     end.
     1065     delete object p-tth.
     1066   end.
     1067   end procedure.
