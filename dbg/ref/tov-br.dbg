     1466         or error-status :get-message(1) <> ""
     1467         then do:
     1468           undo move_block, retry move_block .
     1469         end.
     1470         for each buf_temp-browse-handle
     1471           where buf_temp-browse-handle.browse-type = 'height':u
     1472         on error undo move_block, retry move_block
     1473         :
     1474           assign
     1475             buf_temp-browse-handle.browse-handle :height
     1476               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1477             no-error .
     1478           if error-status :error
     1479           or error-status :get-message(1) <> ""
     1480           then do:
     1481             undo move_block, retry move_block .
     1482           end.
     1483         end.
     1484         for each buf_temp-diasize-handle
     1485         on error undo move_block, retry move_block
     1486         :
     1487           assign
     1488             v-object-handle = buf_temp-diasize-handle.handle-value
     1489           .
     1490           if v-object-handle <> v-diasize-resize-button
     1491           then do:
     1492             assign
     1493               v-object-handle :row = v-object-handle :row + p-change-value
     1494               no-error .
     1495             if error-status :error
     1496             or error-status :get-message(1) <> ""
     1497             then do:
     1498               undo move_block, retry move_block .
     1499             end.
     1500           end.
     1501         end.
     1502       end.
     1503       else do:
     1504         for each buf_temp-diasize-handle
     1505         on error undo move_block, retry move_block
     1506         :
     1507           assign
     1508             v-object-handle = buf_temp-diasize-handle.handle-value
     1509           .
     1510           if v-object-handle <> v-diasize-resize-button
     1511           then do:
     1512             assign
     1513               v-object-handle :row = v-object-handle :row + p-change-value
