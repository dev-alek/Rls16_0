     1553         then do:
     1554           assign
     1555             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1556             no-error .
     1557           if error-status :error
     1558           or error-status :get-message(1) <> ""
     1559           then do:
     1560             undo move_block, retry move_block .
     1561           end.
     1562         end.
     1563       end.
     1564       if p-move-resize = true
     1565       then do:
     1566         run diasize_position-resize-button in this-procedure .
     1567       end.
     1568       if v-diasize-wndstore = true
     1569       then do:
     1570         if connected("ub") = true
     1571         then do:
     1572           define variable v-cntxt-db-num        as integer   no-undo .
     1573           define variable v-cntxt-userid        as character no-undo .
     1574           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1575                                             , OUTPUT v-cntxt-userid
     1576                                             ) .
     1577           run gbl/wndsizew.p
     1578             (input  v-cntxt-db-num
     1579             ,input  v-cntxt-userid
     1580             ,input  v-diasize-proc-name
     1581             ,input  'height':u
     1582             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1583             ) .
     1584         end.
     1585       end.
     1586     end.
     1587     assign
     1588       v-diasize-change-size = false
     1589     .
     1590   end procedure.
     1591   procedure diasize_set-height :
     1592     define input  parameter p-new-height  as decimal   no-undo .
     1593     define input  parameter p-move-resize as logical   no-undo .
     1594     do
     1595     on error undo, return error return-value
     1596     :
     1597       run diasize_change-height in this-procedure
     1598         (input  (p-new-height - frame Dialog-Frame :height)
     1599         ,input  p-move-resize
     1600         ) .
     1601     end.
     1602   end procedure.
     1603   procedure diasize_change-width :
     1604     define input  parameter p-change-value as decimal   no-undo .
     1605     define input  parameter p-move-resize  as logical   no-undo .
     1606     define variable v-field-group-handle   as handle    no-undo .
     1607     define variable v-object-handle        as handle    no-undo .
     1608     define variable v-frame-width          as decimal   no-undo .
     1609     define variable v-frame-virtual-width  as decimal   no-undo .
     1610     define variable v-browse-width         as decimal   no-undo .
     1611     define variable v-window-width         as decimal   no-undo .
     1612     define variable v-window-virtual-width as decimal   no-undo .
     1613     define variable v-change-sign          as integer   no-undo .
     1614     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1615     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1616     if p-change-value > 0
     1617     then do:
     1618       if frame Dialog-Frame :width + p-change-value >
     1619           session :width-chars
     1620       then do:
     1621         assign
     1622           p-change-value = session :width-chars - frame Dialog-Frame :width
     1623         .
     1624         if p-change-value <= 0
     1625         then do:
     1626           run diasize_position-resize-button in this-procedure .
     1627           return .
     1628         end.
     1629       end.
     1630     end.
     1631     if p-change-value < 0
     1632     then do:
     1633       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1634       then do:
     1635         assign
     1636           p-change-value = v-diasize-orig-frame-width
     1637                          - frame Dialog-Frame :width
     1638         .
     1639         if p-change-value >= 0
     1640         then do:
     1641           run diasize_position-resize-button in this-procedure .
     1642           return .
     1643         end.
     1644       end.
     1645     end.
     1646     if p-change-value >= 0
     1647     then do:
     1648       assign
     1649         v-change-sign = 1
     1650       .
     1651     end.
     1652     else do:
     1653       assign
     1654         v-change-sign = -1
     1655       .
     1656     end.
     1657     assign
     1658       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1659     .
     1660     if p-change-value = 0
     1661     then do:
     1662       run diasize_position-resize-button in this-procedure .
     1663       return .
     1664     end.
     1665     move_block:
     1666     do
     1667     on error undo move_block, leave move_block
     1668     :
     1669       if retry
     1670       then do:
     1671         do
     1672         on error undo move_block, leave move_block
     1673         :
     1674           if p-change-value > 0
     1675           then do:
     1676             for each buf_temp-diasize-handle
     1677             on error undo, next
     1678             :
     1679               assign
     1680                 v-object-handle = buf_temp-diasize-handle.handle-value
     1681               .
     1682               if v-object-handle <> v-diasize-resize-button
     1683               then do:
     1684                 assign
     1685                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1686                 .
     1687               end.
     1688             end.
