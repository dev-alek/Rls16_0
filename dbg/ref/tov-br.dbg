        1   DEFINE BUFFER buf_clients FOR ub.clients.
        2   DEFINE BUFFER buf_goods FOR ub.goods.
        3   DEFINE NEW SHARED BUFFER buf_turnover-buyer FOR ub.turnover-buyer.
        4   DEFINE BUFFER buf_turnover-buyer-gds FOR ub.turnover-buyer-gds.
        5   DEFINE BUFFER buf_turnover-buyer-main FOR ub.turnover-buyer-main.
        6   define input  parameter parParentProc as handle no-undo .
        7   define input  parameter p-bttns        as character no-undo .
        8   define input  parameter p-cli-recid   as recid no-undo  .
        9   define output parameter p-rec-list    as character no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Обороты покупателя для ценообразовани ".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   procedure proc-alt-shift-f2:
       75     if not ibs.th.gbl.gbl-var:rcode
       76   then
       77     run gbl\inidebug.p .
       78   end.
       79   procedure proc-alt-shift-f3:
       80     run gbl/prvssinf.p
       81       ( input this-procedure
       82       ) .
       83   end.
       84   define variable v-inform-launched as logical no-undo initial false .
       85   procedure proc-alt-shift-f4:
       86     define variable v-action as character no-undo .
       87     if v-inform-launched = false then do:
       88       assign
       89         v-inform-launched = true
       90       .
       91       run gbl/d-inform.w
       92         (  input self
       93         ,  input this-procedure
       94         , output v-action
       95         ) no-error .
       96       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       97       assign
       98         v-inform-launched = false
       99       .
      100     end.
      101   end.
      102   procedure proc-alt-f1:
      103     run gbl/corrhelp.p
      104       (input this-procedure
      105       ) .
      106   end .
      107   on alt-shift-f2 anywhere do:
      108     run proc-alt-shift-f2.
      109   end.
      110   on alt-shift-f3 anywhere do:
      111     run proc-alt-shift-f3 in this-procedure .
      112   end.
      113   on alt-shift-f4 anywhere do:
      114     run proc-alt-shift-f4 in this-procedure.
      115   end.
      116   on alt-f1 anywhere do:
      117     run proc-alt-f1 in this-procedure .
      118   end.
      119   define new global shared variable g#library  as handle no-undo .
      120   define new global shared variable g#library2 as handle no-undo .
      121   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122     define variable v-cntxt-db-num        as integer   no-undo .
      123     define variable v-cntxt-userid        as character no-undo .
      124     define variable v-cntxt-level         as character no-undo .
      125     define variable v-cntxt-host-code-obj as integer   no-undo .
      126     define variable v-cntxt-obj-type      as character no-undo .
      127     define variable v-cntxt-obj-code      as integer   no-undo .
      128     define variable v-cntxt-db-num-obj    as integer   no-undo .
      129     define variable v-cntxt-is-admin      as logical   no-undo .
      130   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131     run mainmenu_getcntxt in parparentproc
      132       (output v-cntxt-db-num
      133       ,output v-cntxt-userid
      134       ,output v-cntxt-level
      135       ,output v-cntxt-host-code-obj
      136       ,output v-cntxt-obj-type
      137       ,output v-cntxt-obj-code
      138       ,output v-cntxt-db-num-obj
      139       ,output v-cntxt-is-admin
      140       ) .
      141   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      142   define variable v-waitfram-action01         as character   no-undo .
      143   define variable v-waitfram-action02         as character   no-undo .
      144   define variable v-waitfram-action03         as character   no-undo .
      145   define variable mWaitFramTextBeg            as character   no-undo.
      146   define variable mWaitFramTextEnd            as character   no-undo.
      147   define variable mWaitFramView               as logical     no-undo.
      148   define variable mWaitProcEvent              as logical     no-undo init yes.
      149   define variable mWaitFramInterval           as integer     no-undo init 1 .
      150   define variable mWaitFramStop               as logical     no-undo.
      151   define variable mWaitFramStopUser           as logical     no-undo.
      152   define variable mWaitFramStopTimeOut        as logical     no-undo.
      153   define variable mWaitFramStartProc          as datetime-tz no-undo.
      154   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      155   define button B-WaitFramStop auto-end-key
      156        label "Стоп"
      157        size 10 by 1 tooltip "Остоновить процесс".
      158   define button B-viewProcInfo
      159        label "Информация"
      160        size 15 by 1 tooltip "Информация о процесс".
      161   define frame waitfram
      162     v-waitfram-action01 format "x(72)" no-label skip
      163     v-waitfram-action02 format "x(72)" no-label skip
      164     v-waitfram-action03 format "x(72)" no-label skip
      165     B-viewProcInfo
      166     B-WaitFramStop at row 4 col 30
      167     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      168     .
      169   define new global shared variable mBatchMode as logical no-undo init ?.
      170   define variable mFramBachModHandle as handle no-undo.
      171   mFramBachModHandle = frame waitfram:handle.
      172   define variable mFameOldVis as logical no-undo.
      173   define variable mVisCUrentVin as logical no-undo.
      174   if session:batch-mode
      175   then
      176      mBatchMode = yes.
      177   if mBatchMode = ? then do:
      178     mVisCUrentVin = current-window:visible.
      179     mFameOldVis = mFramBachModHandle:visible.
      180     mFramBachModHandle:visible  = yes.
      181     mBatchMode = mFramBachModHandle:visible ne yes.
      182     mFramBachModHandle:visible = mFameOldVis.
      183     current-window:visible = mVisCUrentVin.
      184   end.
      185    if  log-manager:logfile-name ne ?
      186     then DO:
      187         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      188         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      189         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      190     end.
      191   on choose of B-WaitFramStop in frame waitfram
      192   do:
      193     mWaitFramStop = yes.
      194     mWaitFramStopUser = yes.
      195   end.
      196   function waitfram-check-timeout returns logical():
      197      define variable vtime as int64 no-undo.
      198      if mWaitFramStopTimeOut
      199      then
      200         return yes.
      201      vtime = ( now - mWaitFramStartProc ) / 1000 .
      202      if     mWaitFramTimeOut ne ?
      203         and mWaitFramTimeOut ne 0
      204         and mWaitFramTimeOut lt vtime
      205      then do:
      206         mWaitFramStopTimeOut = yes.
      207      end.
      208      return mWaitFramStopTimeOut.
      209   end.
      210   procedure waitfram-hide :
      211     if not session:batch-mode
      212     then do
      213     on error undo, return error return-value
      214     :
      215       pause 0 before-hide .
      216       if not mBatchMode then
      217         hide frame waitfram .
      218     if     not mWaitFramView
      219        and mWaitProcEvent
      220     then
      221       process events .
      222     end.
      223   end procedure.
      224   procedure waitfram-show :
      225     define input  parameter p-message as character no-undo .
      226     define variable v-left-margin as integer   no-undo .
      227     if not session:batch-mode
      228     then do
      229     on error undo, return error return-value
      230     :
      231       if length(p-message) <= 70 then do:
      232         assign
      233           v-left-margin = integer((70 - length(p-message)) / 2)
      234         .
      235         assign
      236           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      237         .
      238         assign
      239           v-waitfram-action01 = " "
      240           v-waitfram-action02 = " "
      241                                    + fill(" ", v-left-margin)
      242                                    + p-message
      243           v-waitfram-action03 = " "
      244         .
      245       end.
      246       else do:
      247         define variable vRindex1 as integer no-undo.
      248         define variable vRindex2 as integer no-undo.
      249         vRindex1 = r-index(p-message," ",70).
      250         if vRindex1 = 0
      251         then
      252            vRindex1 = 70.
      253         if length(p-message)  <= vRindex1 + 70 then do:
      254           assign
      255             v-waitfram-action01 = " "
      256             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      257             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      258           .
      259         end.
      260         else do:
      261           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      262           if vRindex2 <= vRindex1
      263           then
      264              vRindex2 = vRindex1 + 70.
      265           assign
      266             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      267             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      268             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      269           .
      270         end.
      271       end.
      272       B-viewProcInfo:visible   in frame waitfram = no.
      273       B-viewProcInfo:sensitive in frame waitfram = no.
      274       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      275       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      276       if  (   mWaitFramView
      277          or  mWaitProcEvent)
      278          and not mBatchMode
      279       then
      280          display
      281             v-waitfram-action01 skip
      282             v-waitfram-action02 skip
      283             v-waitfram-action03 skip
      284          with frame waitfram .
      285       if     mWaitFramView
      286          then do:
      287             if     mWaitFramInterval ne ?
      288                and not mBatchMode
      289             then
      290                wait-for go of frame waitfram pause mWaitFramInterval.
      291          end.
      292          else
      293             if     mWaitProcEvent
      294                and not mBatchMode
      295             then
      296                process events .
      297     end.
      298   end procedure.
      299      procedure waitfram-show-this:
      300         define input  parameter iInterval as int64 no-undo.
      301         define variable vtime as int64 no-undo.
      302         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      303         mWaitFramInterval = iInterval.
      304         run waitfram-show (substitute("&1&2 &3&4" ,
      305                                       mWaitFramTextBeg ,
      306                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      307                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      308                                       mWaitFramTextEnd
      309                                      )
      310                           ).
      311      end.
      312      procedure WaitFramRunPause:
      313         define input  parameter iInterval as dec no-undo.
      314         define variable vStart  as datetime-tz no-undo.
      315         define variable vend    as datetime-tz no-undo.
      316         define variable vint as int64 no-undo.
      317         define variable vOk as logical no-undo.
      318         vStart = now.
      319         vend   = vStart.
      320         publish "WaitFramPause" (iInterval,output vOk).
      321         vend   =  now.
      322         vint = vend - vStart.
      323         vint = iInterval - vint / 1000.
      324         if     not mWaitFramStop
      325            and (   vint > 0
      326                 or (    not vOk
      327                     and iInterval eq ?
      328                     )
      329                 )
      330         then
      331            run waitfram-show-this (iInterval).
      332         vend   =  now.
      333         vint = vend - vStart.
      334         vint = iInterval - vint / 1000.
      335         if     not mWaitFramStop
      336            and vint > 0
      337         then do:
      338            run gbl/pause.p (vint * 1000).
      339         end.
      340         if iInterval ne ?
      341         then
      342            publish "WaitFramStop".
      343         waitfram-check-timeout().
      344      end.
      345      procedure WaitFramWaitFor:
      346         define input  parameter iInterval as dec no-undo.
      347         assign
      348            mWaitFramStartProc   = now
      349            mWaitFramStopUser    = no
      350            mWaitFramStopTimeOut = no
      351         .
      352         block-wait:
      353         do while not mWaitFramStop:
      354            run WaitFramRunPause (iInterval).
      355            if  waitfram-check-timeout()
      356            then do:
      357               leave block-wait.
      358            end.
      359         end.
      360         run waitfram-hide.
      361      end.
      362   procedure waitfram-join :
      363     define input  parameter p-line-1  as character no-undo .
      364     define input  parameter p-line-2  as character no-undo .
      365     define input  parameter p-line-3  as character no-undo .
      366     define output parameter p-message as character no-undo .
      367     do
      368     on error undo, return error return-value
      369     :
      370       assign
      371         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      372                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      373                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      374       .
      375     end.
      376   end procedure.
      377   function waitfram-join-function returns character
      378     (input p-line-1 as character
      379     ,input p-line-2 as character
      380     ,input p-line-3 as character
      381     ).
      382     define variable v-message as character no-undo .
      383     run waitfram-join in this-procedure
      384       (input  p-line-1
      385       ,input  p-line-2
      386       ,input  p-line-3
      387       ,output v-message
      388       ) .
      389     return v-message .
      390   end function .
      391   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      392   define temp-table userobjs_temp-user-obj no-undo
      393     field obj-type as character
      394     field obj-code as integer
      395     index xpk is primary unique obj-type obj-code
      396     .
      397   procedure userobjs_clear :
      398     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      399     do
      400     on error undo, return error return-value
      401     :
      402       for each buf_userobjs_temp-user-obj
      403       on error undo, return error return-value
      404       :
      405         delete buf_userobjs_temp-user-obj .
      406       end.
      407     end.
      408   end .
      409   procedure userobjs_object-count :
      410     define output parameter p-total-count as integer   no-undo .
      411     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      412     do
      413     on error undo, return error return-value
      414     :
      415       assign
      416         p-total-count = 0
      417       .
      418       for each buf_userobjs_temp-user-obj
      419       on error undo, return error return-value
      420       :
      421         assign
      422           p-total-count = p-total-count + 1
      423         .
      424       end.
      425     end.
      426   end.
      427   procedure userobjs_append :
      428      define input  parameter p-obj-type as character no-undo .
      429      define input  parameter p-obj-code as integer   no-undo .
      430     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      431     do
      432     on error undo, return error return-value
      433     :
      434       find first buf_userobjs_temp-user-obj
      435         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      436           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      437         no-error .
      438       if not available buf_userobjs_temp-user-obj
      439       then do:
      440         create buf_userobjs_temp-user-obj .
      441         assign
      442           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      443           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      444         .
      445       end.
      446     end.
      447   end.
      448   procedure userobjs_object-exist :
      449     define output parameter p-object-exist as logical   no-undo .
      450     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      451     do
      452     on error undo, return error return-value
      453     :
      454       find first buf_userobjs_temp-user-obj
      455         no-error .
      456       if not available buf_userobjs_temp-user-obj
      457       then do:
      458         assign
      459           p-object-exist = false
      460         .
      461       end.
      462       else do:
      463         assign
      464           p-object-exist = true
      465         .
      466       end.
      467     end.
      468   end.
      469   procedure userobjs_transfer :
      470     define input  parameter p-callback-handle as handle no-undo .
      471     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      472     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      473     do
      474     on error undo, return error return-value
      475     :
      476       if valid-handle(p-callback-handle) <> true
      477       then do:
      478         message
      479           vss-workfile vss-revision vss-description skip
      480           "Ошибка задания входных параметров" skip
      481           "Неизвестный указатель на процедуру" skip
      482           view-as alert-box error .
      483         undo, return error return-value .
      484       end.
      485       if p-callback-handle :get-signature("userobjs_append") = ""
      486       then do:
      487         message
      488           vss-workfile vss-revision vss-description skip
      489           "Ошибка задания входных параметров" skip
      490           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      491                     ,p-callback-handle :file-name
      492                     ) skip
      493           view-as alert-box error .
      494         undo, return error return-value .
      495       end.
      496       for each buf_userobjs_temp-user-obj
      497       on error undo, return error return-value
      498       :
      499         run userobjs_append in p-callback-handle
      500           (input  buf_userobjs_temp-user-obj.obj-type
      501           ,input  buf_userobjs_temp-user-obj.obj-code
      502           ) .
      503       end.
      504     end.
      505   end procedure.
      506   procedure userobjs_select-one :
      507      define input  parameter parparentproc     as widget-handle no-undo .
      508      define input  parameter p-db-num          as integer   no-undo .
      509      define input  parameter p-user-id         as character no-undo .
      510      define input  parameter p-host-code-obj   as integer   no-undo .
      511      define input  parameter p-obj-type        as character no-undo .
      512      define input  parameter p-obj-code        as integer   no-undo .
      513      define output parameter p-user-select     as logical   no-undo .
      514      define output parameter p-select-obj-type as character no-undo .
      515      define output parameter p-select-obj-code as character no-undo .
      516     do
      517     on error undo, return error return-value
      518     :
      519       run gbl/userobjs.w
      520         (input  parparentproc
      521         ,input  this-procedure :handle
      522         ,input  p-db-num
      523         ,input  p-user-id
      524         ,input  p-host-code-obj
      525         ,input  p-obj-type
      526         ,input  p-obj-code
      527         ,INPUT  "b-sel"
      528         ,output p-user-select
      529         ,output p-select-obj-type
      530         ,output p-select-obj-code
      531         ) .
      532     end.
      533   end.
      534   procedure userobjs_select-many :
      535     define input  parameter parparentproc   as widget-handle no-undo .
      536     define input  parameter p-db-num        as integer   no-undo .
      537     define input  parameter p-user-id       as character no-undo .
      538     define input  parameter p-host-code-obj as integer   no-undo .
      539     define input  parameter p-obj-type      as character no-undo .
      540     define input  parameter p-obj-code      as integer   no-undo .
      541     define output parameter p-user-select   as logical   no-undo .
      542     define variable v-select-obj-type as character no-undo .
      543     define variable v-select-obj-code as integer   no-undo .
      544     do
      545     on error undo, return error return-value
      546     :
      547       run gbl/userobjs.w
      548         (input  parparentproc
      549         ,input  this-procedure :handle
      550         ,input  p-db-num
      551         ,input  p-user-id
      552         ,input  p-host-code-obj
      553         ,input  p-obj-type
      554         ,input  p-obj-code
      555         ,INPUT  "b-sel,b-mark"
      556         ,output p-user-select
      557         ,output v-select-obj-type
      558         ,output v-select-obj-code
      559         ) .
      560     end.
      561   end.
      562   procedure thobjs :
      563      define input        parameter parparentproc     as widget-handle no-undo .
      564      define input        parameter i-bttns           as character     no-undo .
      565      define input        parameter i-list-mode       as character     no-undo.
      566      define input        parameter i-obj-type        as character     no-undo.
      567      define input        parameter i-db-num          as integer       no-undo.
      568      define input        parameter i-host-code       as integer       no-undo.
      569      define input-output parameter p-rid-list        as character     no-undo .
      570   run ref/thobjs.p
      571           ( input parparentproc
      572            ,input  this-procedure :handle
      573           , input i-bttns
      574           , input i-list-mode
      575           , input i-obj-type
      576           , input i-db-num
      577           , input i-host-code
      578           , input-output p-rid-list ) no-error .
      579   end.
      580   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      581   procedure pricing_calc-itogo-buyer :
      582     do
      583     on error undo, return error return-value
      584     :
      585   define input  parameter  p-cli-type as character no-undo .
      586   define input  parameter  p-cli-code as integer   no-undo .
      587   define output parameter  p-itogo-sum-doc-rubl  as decimal   no-undo .
      588   define output parameter  p-itogo-sum-doc-base  as decimal   no-undo .
      589   define output parameter  p-itogo-sum-rash-base as decimal   no-undo .
      590   define output parameter  p-itogo-sum-rash      as decimal   no-undo .
      591   define output parameter  p-itogo-sum-vozv-base as decimal   no-undo .
      592   define output parameter  p-itogo-sum-vozv      as decimal   no-undo .
      593   define output parameter  p-itogo-qnty-doc      as decimal   no-undo .
      594   define output parameter  p-itogo-qnty-check    as decimal   no-undo .
      595   define buffer bb_turnover-buyer      for ub.turnover-buyer.
      596   define buffer bb_turnover-buyer-main for ub.turnover-buyer-main.
      597   assign
      598     p-ITOGO-sum-doc-rubl =  0
      599     p-ITOGO-sum-doc-base =  0
      600     p-ITOGO-sum-rash-base = 0
      601     p-ITOGO-sum-rash      = 0
      602     p-ITOGO-sum-vozv-base = 0
      603     p-ITOGO-sum-vozv      = 0
      604     p-ITOGO-qnty-doc      = 0
      605     p-ITOGO-qnty-check    = 0
      606   .
      607   for each bb_turnover-buyer-main no-lock where
      608            bb_turnover-buyer-main.cli-type = p-cli-type and
      609            bb_turnover-buyer-main.cli-code = p-cli-code
      610            :
      611       p-ITOGO-qnty-doc     = p-ITOGO-qnty-doc     + bb_turnover-buyer-main.qnty-doc-itog .
      612       p-ITOGO-qnty-check   = p-ITOGO-qnty-check   + bb_turnover-buyer-main.qnty-check-itog .
      613       p-ITOGO-sum-doc-rubl = p-ITOGO-sum-doc-rubl + bb_turnover-buyer-main.sum-doc-rubl-itog .
      614       p-ITOGO-sum-doc-base = p-ITOGO-sum-doc-base + bb_turnover-buyer-main.sum-doc-base-itog .
      615   end.
      616   for each bb_turnover-buyer no-lock where
      617            bb_turnover-buyer.cli-type = p-cli-type and
      618            bb_turnover-buyer.cli-code = p-cli-code
      619            :
      620       if bb_turnover-buyer.ext-doc-type = 'ee':U      or
      621          bb_turnover-buyer.ext-doc-type = 'es':U or
      622          bb_turnover-buyer.ext-doc-type = ""
      623          then do:
      624           p-ITOGO-sum-rash      = p-ITOGO-sum-rash      + bb_turnover-buyer.sum-doc-rubl .
      625           p-ITOGO-sum-rash-base = p-ITOGO-sum-rash-base + bb_turnover-buyer.sum-doc-base .
      626       end.
      627       else do:
      628           p-ITOGO-sum-vozv      = p-ITOGO-sum-vozv      + bb_turnover-buyer.sum-doc-rubl .
      629           p-ITOGO-sum-vozv-base = p-ITOGO-sum-vozv-base + bb_turnover-buyer.sum-doc-base .
      630       end.
      631   end.
      632     end.
      633   end procedure.
      634   define buffer root_clients for ub.clients  .
      635   define variable v-rec-list-cli as character no-undo .
      636   define variable g-log as logical   no-undo .
      637   define variable v-obj-list as character no-undo .
      638   function mark-string returns character
      639     ( buffer loc-table for ub.turnover-buyer-main, input mark-list as character  ) :
      640     return ( if lookup( string( recid( loc-table ) ), mark-list ) > 0 then "*" else "":U ).
      641   end function.
      642   function mark-string-2 returns character
      643     ( buffer loc-table for ub.turnover-buyer-gds , input mark-list as character  ) :
      644     return ( if lookup( string( recid( loc-table ) ), mark-list ) > 0 then "*" else "":U ).
      645   end function.
      646   function type-string-2 returns character
      647     ( buffer loc-table for ub.turnover-buyer-gds   ) :
      648   return entry (lookup (string(loc-table.type), '0,1,50,99':U), 'тек,удал,блок,удаление':U) .
      649   end function.
      650   function type-string returns character
      651     ( buffer loc-table for ub.turnover-buyer   ) :
      652   return entry (lookup (string(loc-table.type), '0,1':U), 'А,Р':U) .
      653   end function.
      654   DEFINE QUERY external_tables FOR buf_turnover-buyer-main.
      655   DEFINE BUTTON B-add
      656        LABEL "Добавить"
      657        SIZE 10 BY 1 TOOLTIP "Ручное добавление оборотов"
      658        BGCOLOR 8 .
      659   DEFINE BUTTON B-Cancel AUTO-END-KEY
      660        LABEL "Выход"
      661        SIZE 10 BY 1
      662        BGCOLOR 8 .
      663   DEFINE BUTTON B-chg
      664        LABEL "Изменить"
      665        SIZE 10 BY 1 TOOLTIP "Изменение ~"ручных~" оборотов"
      666        BGCOLOR 8 .
      667   DEFINE BUTTON B-Chk
      668        LABEL "Чек"
      669        SIZE 10 BY 1 TOOLTIP "Просмотр чека"
      670        BGCOLOR 8 .
      671   DEFINE BUTTON B-del
      672        LABEL "Удалить"
      673        SIZE 10 BY 1 TOOLTIP "Удаление ~"ручных~" оборотов"
      674        BGCOLOR 8 .
      675   DEFINE BUTTON B-doc
      676        LABEL "Документ"
      677        SIZE 10 BY 1 TOOLTIP "Просмотр документа"
      678        BGCOLOR 8 .
      679   DEFINE BUTTON B-Help
      680        LABEL "Помо&щь"
      681        SIZE 10 BY 1
      682        BGCOLOR 8 .
      683   DEFINE BUTTON B-lkp
      684        LABEL "Просмотр"
      685        SIZE 9.5 BY 1 TOOLTIP "Просмотр ~"ручных~" оборотов"
      686        BGCOLOR 8 .
      687   DEFINE BUTTON B-mark
      688        LABEL "*"
      689        SIZE 3.25 BY 1 TOOLTIP "Отметить оборот по объекту"
      690        BGCOLOR 8 .
      691   DEFINE BUTTON B-print
      692        LABEL "Печать"
      693        SIZE 8 BY 1 TOOLTIP "Печать справочника"
      694        BGCOLOR 8 .
      695   DEFINE BUTTON B-sel AUTO-GO
      696        LABEL "Выбор"
      697        SIZE 8 BY 1
      698        BGCOLOR 8 .
      699   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Тип:"
      700         VIEW-AS TEXT
      701        SIZE 4.5 BY .67
      702        FGCOLOR 4  NO-UNDO.
      703   DEFINE VARIABLE FILL-IN-2 AS CHARACTER FORMAT "X(256)":U INITIAL "Объекты:"
      704         VIEW-AS TEXT
      705        SIZE 9 BY .67
      706        FGCOLOR 4  NO-UNDO.
      707   DEFINE VARIABLE itogo-qnty-check AS INTEGER FORMAT "->,>>>,>>9" INITIAL 0
      708        LABEL "Всего чеков"
      709         VIEW-AS TEXT
      710        SIZE 11 BY .67
      711        FGCOLOR 4 .
      712   DEFINE VARIABLE ITOGO-qnty-doc AS INTEGER FORMAT "->,>>>,>>9" INITIAL 0
      713        LABEL "Всего документов"
      714         VIEW-AS TEXT
      715        SIZE 11 BY .67
      716        FGCOLOR 4 .
      717   DEFINE VARIABLE ITOGO-sum-doc-base AS DECIMAL FORMAT "->,>>>,>>>,>>9.99" INITIAL 0
      718        LABEL "Итого в ценах реализации(б.в.)"
      719         VIEW-AS TEXT
      720        SIZE 17 BY .67
      721        FGCOLOR 4 .
      722   DEFINE VARIABLE ITOGO-sum-doc-rubl AS DECIMAL FORMAT "->,>>>,>>>,>>9.99" INITIAL 0
      723        LABEL "Итого в ценах реализации(rub)"
      724         VIEW-AS TEXT
      725        SIZE 17 BY .67
      726        FGCOLOR 4 .
      727   DEFINE VARIABLE ITOGO-sum-rash AS DECIMAL FORMAT "->,>>>,>>>,>>9.99" INITIAL 0
      728        LABEL "Расходный оборот"
      729         VIEW-AS TEXT
      730        SIZE 17 BY .67
      731        FGCOLOR 4 .
      732   DEFINE VARIABLE ITOGO-sum-rash-base AS DECIMAL FORMAT "->,>>>,>>>,>>9.99" INITIAL 0
      733        LABEL "Расходный оборот"
      734         VIEW-AS TEXT
      735        SIZE 17 BY .67
      736        FGCOLOR 4 .
      737   DEFINE VARIABLE ITOGO-sum-vozv AS DECIMAL FORMAT "->,>>>,>>>,>>9.99" INITIAL 0
      738        LABEL "Возвратный оборот"
      739         VIEW-AS TEXT
      740        SIZE 17 BY .67
      741        FGCOLOR 4 .
      742   DEFINE VARIABLE ITOGO-sum-vozv-base AS DECIMAL FORMAT "->,>>>,>>>,>>9.99" INITIAL 0
      743        LABEL "Возвратный оборот"
      744         VIEW-AS TEXT
      745        SIZE 17 BY .67
      746        FGCOLOR 4 .
      747   DEFINE VARIABLE r-obj-choose AS INTEGER INITIAL 2
      748        VIEW-AS RADIO-SET HORIZONTAL
      749        RADIO-BUTTONS
      750             "Все", 2,
      751   "выборочно", 1
      752        SIZE 19.25 BY .67 TOOLTIP "Условие отбора записей" NO-UNDO.
      753   DEFINE VARIABLE r-type-add AS INTEGER INITIAL 2
      754        VIEW-AS RADIO-SET HORIZONTAL
      755        RADIO-BUTTONS
      756             "Все", 2,
      757   "Автоматические", 0,
      758   "Ручные", 1
      759        SIZE 32.25 BY .67 TOOLTIP "Условие отбора записей" NO-UNDO.
      760   DEFINE QUERY BROWSE-0ob FOR
      761         buf_turnover-buyer-main,
      762         buf_clients SCROLLING.
      763   DEFINE QUERY BROWSE-1ob FOR
      764         buf_turnover-buyer SCROLLING.
      765   DEFINE QUERY BROWSE-2ob-gds FOR
      766         buf_turnover-buyer-gds,
      767         buf_goods SCROLLING.
      768   DEFINE BROWSE BROWSE-0ob
      769     QUERY BROWSE-0ob NO-LOCK DISPLAY
      770         mark-string ( buffer buf_turnover-buyer-main, p-rec-list ) COLUMN-LABEL "*" FORMAT "x(1)":U
      771         buf_turnover-buyer-main.obj-type + " " + STRING (buf_turnover-buyer-main.obj-code)  COLUMN-LABEL "Объект" FORMAT "x(10)"
      772         buf_clients.obj-name COLUMN-LABEL "Наименование"  FORMAT  "x(20)"
      773   buf_turnover-buyer-main.sum-doc-base-itog  COLUMN-LABEL "В продаж.ценах(баз.в.)" FORMAT "->>>,>>>,>>>,>>9.99"
      774   buf_turnover-buyer-main.sum-doc-rubl-itog   COLUMN-LABEL "В продаж.ценах (РУБ)" FORMAT "->>>,>>>,>>>,>>9.99"
      775   buf_turnover-buyer-main.sum-acc-base-itog   COLUMN-LABEL "В учетных ценах(баз.в.)"  FORMAT "->>>,>>>,>>>,>>9.99"
      776   buf_turnover-buyer-main.sum-acc-rubl-itog   COLUMN-LABEL "В учетных ценах(РУБ)" FORMAT "->>>,>>>,>>>,>>9.99"
      777       buf_turnover-buyer-main.qnty-doc-itog  COLUMN-LABEL  "Кол-во документов"
      778       buf_turnover-buyer-main.qnty-check-itog  COLUMN-LABEL "Кол-во чеков"
      779       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6.38 ROW-HEIGHT-CHARS .67 EXPANDABLE.
      780   DEFINE BROWSE BROWSE-1ob
      781     QUERY BROWSE-1ob NO-LOCK DISPLAY
      782         type-string ( buffer buf_turnover-buyer ) COLUMN-LABEL "Т" FORMAT "x(1)":U
      783         buf_turnover-buyer.fact-date  COLUMN-LABEL "Дата" FORMAT "99/99/99":U
      784         buf_turnover-buyer.ext-doc-type  COLUMN-LABEL "TД" FORMAT "x(2)":U
      785         buf_turnover-buyer.sum-doc-base  COLUMN-LABEL "В прод.ценах(баз.в.)"  FORMAT "->>>,>>>,>>>,>>9.99"
      786         buf_turnover-buyer.sum-doc-rubl  COLUMN-LABEL "В прод.ценах(РУБ)"  FORMAT "->>>,>>>,>>>,>>9.99"
      787         buf_turnover-buyer.sum-acc-base  COLUMN-LABEL "В учетных ценах(баз.в.)"  FORMAT "->>>,>>>,>>>,>>9.99"
      788         buf_turnover-buyer.sum-acc-rubl  COLUMN-LABEL "В учетных ценах(РУБ)"  FORMAT "->>>,>>>,>>>,>>9.99"
      789             buf_turnover-buyer.qnty-doc    COLUMN-LABEL  "Кол-во документов"
      790             buf_turnover-buyer.qnty-check  COLUMN-LABEL "Кол-во чеков"
      791             buf_turnover-buyer.doc-code   COLUMN-LABEL "№ документа" FORMAT "x(16)":U
      792             buf_turnover-buyer.d-card     COLUMN-LABEL "№ ДК"   FORMAT "x(10)":U
      793             buf_turnover-buyer.inkas-code COLUMN-LABEL "№ чека" FORMAT "x(16)":U
      794   buf_turnover-buyer.sum-doc-base-itog   COLUMN-LABEL "В прод.ценах(баз.в.)!нараст.итог"  FORMAT "->>>,>>>,>>>,>>9.99"
      795   buf_turnover-buyer.sum-doc-rubl-itog   COLUMN-LABEL "В прод.ценах(РУБ)!нараст.итог" FORMAT "->>>,>>>,>>>,>>9.99"
      796   buf_turnover-buyer.sum-acc-base-itog   COLUMN-LABEL "В учетных ценах(баз.в.)!нараст.итог"  FORMAT "->>>,>>>,>>>,>>9.99"
      797   buf_turnover-buyer.sum-acc-rubl-itog   COLUMN-LABEL "В учетных ценах(РУБ)!нараст.итог"  FORMAT "->>>,>>>,>>>,>>9.99"
      798             buf_turnover-buyer.qnty-doc-itog    COLUMN-LABEL  "Кол-во докум!нараст.итог"
      799             buf_turnover-buyer.qnty-check-itog  COLUMN-LABEL "Кол-во чеков!нараст.итог"
      800             buf_turnover-buyer.sys-date   COLUMN-LABEL "Дата созд" FORMAT "99/99/99":U
      801             buf_turnover-buyer.sys-time-char COLUMN-LABEL "Время" FORMAT "X(5)":U
      802             buf_turnover-buyer.shift-date  COLUMN-LABEL "Смена" FORMAT "99/99/99":U
      803             buf_turnover-buyer.shift-name COLUMN-LABEL "№" FORMAT "X(2)"
      804             buf_turnover-buyer.shift-num  COLUMN-LABEL "П" FORMAT ">9"
      805       WITH NO-ROW-MARKERS SEPARATORS SIZE 48.13 BY 11.04
      806            TITLE "Обороты по покупателю по объекту" EXPANDABLE.
      807   DEFINE BROWSE BROWSE-2ob-gds
      808     QUERY BROWSE-2ob-gds NO-LOCK DISPLAY
      809         buf_turnover-buyer-gds.gds-code   COLUMN-LABEL "Код товара" FORMAT "999999999":U
      810         buf_goods.gds-name COLUMN-LABEL "Наименование товара" FORMAT "x(20)":U
      811         buf_turnover-buyer-gds.sum-doc-base  COLUMN-LABEL "В прод.ценах(баз.в.)" FORMAT "->>>,>>>,>>9.99"
      812         buf_turnover-buyer-gds.sum-doc-rubl  COLUMN-LABEL "В прод.ценах(РУБ)" FORMAT "->>>,>>>,>>9.99"
      813         buf_turnover-buyer-gds.sum-acc-base  COLUMN-LABEL "В учетных ценах(баз.в.)" FORMAT "->>>,>>>,>>9.99"
      814         buf_turnover-buyer-gds.sum-acc-rubl  COLUMN-LABEL "В учетных ценах(РУБ)" FORMAT "->>>,>>>,>>9.99"
      815             buf_turnover-buyer-gds.fact-date  COLUMN-LABEL "Дата" FORMAT "99/99/99":U
      816             buf_turnover-buyer-gds.doc-code   COLUMN-LABEL "№ документа" FORMAT "x(16)":U
      817             buf_turnover-buyer-gds.inkas-code COLUMN-LABEL "№ чека" FORMAT "x(16)":U
      818             buf_turnover-buyer-gds.d-card     COLUMN-LABEL "№ ДК"   FORMAT "x(6)":U
      819         buf_turnover-buyer-gds.sys-date   COLUMN-LABEL "Дата созд" FORMAT "99/99/99":U
      820         buf_turnover-buyer-gds.sys-time-char COLUMN-LABEL "Время" FORMAT "X(5)":U
      821         buf_turnover-buyer-gds.shift-date  COLUMN-LABEL "Смена" FORMAT "99/99/99":U
      822         buf_turnover-buyer-gds.shift-name  COLUMN-LABEL "№" FORMAT "X(2)"
      823         buf_turnover-buyer-gds.shift-num  COLUMN-LABEL "П" FORMAT ">9"
      824       WITH NO-ROW-MARKERS SEPARATORS SIZE 50.5 BY 11.04
      825            TITLE "Обороты в разрезе товаров" EXPANDABLE.
      826   DEFINE FRAME Dialog-Frame
      827        B-Cancel AT ROW 1 COL 1
      828        B-mark AT ROW 1 COL 10.88
      829        B-sel AT ROW 1 COL 14.25
      830        B-add AT ROW 1 COL 22.38
      831        B-chg AT ROW 1 COL 32.5
      832        B-lkp AT ROW 1 COL 42.5
      833        B-del AT ROW 1 COL 51.88
      834        B-doc AT ROW 1 COL 62
      835        B-Chk AT ROW 1 COL 72.13
      836        B-print AT ROW 1 COL 82.13
      837        B-Help AT ROW 1 COL 90.25
      838        r-obj-choose AT ROW 4.17 COL 10.88 NO-LABEL
      839        BROWSE-0ob AT ROW 4.88 COL 1.5
      840        r-type-add AT ROW 11.25 COL 6.75 NO-LABEL
      841        BROWSE-1ob AT ROW 12 COL 1.38
      842        BROWSE-2ob-gds AT ROW 12 COL 49.5
      843        ITOGO-sum-doc-base AT ROW 2 COL 81 COLON-ALIGNED
      844        ITOGO-sum-doc-rubl AT ROW 2.04 COL 31 COLON-ALIGNED
      845        ITOGO-sum-rash-base AT ROW 2.63 COL 81 COLON-ALIGNED
      846        ITOGO-sum-rash AT ROW 2.79 COL 31 COLON-ALIGNED
      847        ITOGO-sum-vozv-base AT ROW 3.38 COL 81 COLON-ALIGNED
      848        ITOGO-sum-vozv AT ROW 3.54 COL 31 COLON-ALIGNED
      849        ITOGO-qnty-doc AT ROW 4.08 COL 61.5 COLON-ALIGNED
      850        itogo-qnty-check AT ROW 4.08 COL 87 COLON-ALIGNED
      851        FILL-IN-2 AT ROW 4.17 COL 2.13 NO-LABEL
      852        FILL-IN-1 AT ROW 11.25 COL 1.5 NO-LABEL
      853        SPACE(94.38) SKIP(11.21)
      854       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      855            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      856            TITLE "Обороты по покупателю"
      857            DEFAULT-BUTTON B-sel CANCEL-BUTTON B-Cancel.
      858   ASSIGN
      859          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      860          FRAME Dialog-Frame:HIDDEN           = TRUE.
      861   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      862   DO:
      863     APPLY "END-ERROR":U TO SELF.
      864   END.
      865   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      866   DO:
      867   define variable v-rec-id as recid no-undo init ?.
      868   define variable v-recid-main as recid no-undo .
      869   find current buf_turnover-buyer-main no-error .
      870   if available buf_turnover-buyer-main then do:
      871      v-recid-main = recid (buf_turnover-buyer-main) .
      872   end.
      873     run ref/tov-bri.w ( Parparentproc, 'ДОБАВЛЕНИЕ':U , root_clients.obj-type ,  root_clients.obj-code ,  input-output v-rec-id ) .
      874     define buffer bbuf_turnover-buyer for ub.turnover-buyer  .
      875     find first bbuf_turnover-buyer no-lock where recid(bbuf_turnover-buyer) =  v-rec-id no-error .
      876     if available  bbuf_turnover-buyer then do:
      877        run ref/calctur1.p ( bbuf_turnover-buyer.cli-type , bbuf_turnover-buyer.cli-code ,
      878                         bbuf_turnover-buyer.obj-type , bbuf_turnover-buyer.obj-code ,
      879                         bbuf_turnover-buyer.fact-order  ) .
      880     end.
      881     run refresh-itogo.
      882     OPEN QUERY BROWSE-0ob FOR EACH buf_turnover-buyer-main WHERE     ( r-obj-choose = 2 OR       lookup((buf_turnover-buyer-main.obj-type + string(buf_turnover-buyer-main.obj-code)) ,        v-obj-list ) > 0 ) AND     buf_turnover-buyer-main.cli-type = root_clients.obj-type AND     buf_turnover-buyer-main.cli-code = root_clients.obj-code NO-LOCK ,            EACH buf_clients WHERE buf_clients.obj-code = buf_turnover-buyer-main.obj-code                        AND buf_clients.obj-type = buf_turnover-buyer-main.obj-type                                                             NO-LOCK .
      883     reposition BROWSE-0ob to recid v-recid-main no-error .
      884     OPEN QUERY BROWSE-1ob FOR EACH buf_turnover-buyer NO-LOCK WHERE     ( r-type-add = 2 OR buf_turnover-buyer.type =  r-type-add ) AND buf_turnover-buyer.obj-type = buf_turnover-buyer-main.obj-type AND buf_turnover-buyer.obj-code = buf_turnover-buyer-main.obj-code AND buf_turnover-buyer.cli-type = buf_turnover-buyer-main.cli-type    AND buf_turnover-buyer.cli-code = buf_turnover-buyer-main.cli-code  USE-INDEX clients  .
      885     reposition BROWSE-1ob to recid v-rec-id no-error .
      886   END.
      887   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
      888   DO:
      889   define variable v-rec-id as recid no-undo init ?.
      890   define variable v-recid-main as recid no-undo .
      891   if not available buf_turnover-buyer then return.
      892     if buf_turnover-buyer.type = 0 then do:
      893        message "Автоматически созданные обороты изменять нельзя! " view-as alert-box information .
      894        return .
      895     end.
      896   v-rec-id = recid(buf_turnover-buyer) .
      897   find current buf_turnover-buyer-main no-error .
      898   if available buf_turnover-buyer-main then do:
      899      v-recid-main = recid (buf_turnover-buyer-main) .
      900   end.
