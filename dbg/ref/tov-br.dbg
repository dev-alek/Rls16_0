     1752       end.
     1753       assign
     1754         v-diasize-need-full-display = true
     1755       .
     1756       if v-diasize-change-size = false
     1757       then do:
     1758         assign
     1759           v-diasize-change-size = true
     1760         .
     1761       end.
     1762       else do:
     1763         return .
     1764       end.
     1765       assign
     1766         v-frame-width = frame Dialog-Frame :width
     1767         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1768         v-browse-width = v-diasize-browse-handle :width
     1769       .
     1770       for each buf_temp-browse-handle
     1771         where buf_temp-browse-handle.browse-type = 'width':u
     1772       :
     1773         assign
