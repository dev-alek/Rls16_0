     1215   .
     1216   procedure diasize_change-height :
     1217     define input  parameter p-change-value  as decimal   no-undo .
     1218     define input  parameter p-move-resize   as logical   no-undo .
     1219     define variable v-field-group-handle    as handle    no-undo .
     1220     define variable v-object-handle         as handle    no-undo .
     1221     define variable v-frame-height          as decimal   no-undo .
     1222     define variable v-frame-virtual-height  as decimal   no-undo .
     1223     define variable v-browse-height         as decimal   no-undo .
     1224     define variable v-window-height         as decimal   no-undo .
     1225     define variable v-window-virtual-height as decimal   no-undo .
     1226     define variable v-change-sign           as integer   no-undo .
     1227     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1228     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1229     if p-change-value > 0
     1230     then do:
     1231       if frame Dialog-Frame :height + p-change-value
     1232           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1233       then do:
     1234         assign
     1235           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1236                           - (frame Dialog-Frame :height-chars)
     1237         .
     1238         if p-change-value <= 0
     1239         then do:
     1240           run diasize_position-resize-button in this-procedure .
     1241           return .
     1242         end.
     1243       end.
     1244     end.
     1245     if p-change-value < 0
     1246     then do:
     1247       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1248       then do:
     1249         assign
     1250           p-change-value = v-diasize-orig-frame-height
     1251                          - (frame Dialog-Frame :height-chars)
     1252         .
     1253         if p-change-value >= 0
     1254         then do:
     1255           run diasize_position-resize-button in this-procedure .
     1256           return .
     1257         end.
     1258       end.
     1259     end.
     1260     if p-change-value >= 0
     1261     then do:
     1262       assign
     1263         v-change-sign = 1
     1264       .
     1265     end.
     1266     else do:
     1267       assign
     1268         v-change-sign = -1
     1269       .
     1270     end.
     1271     assign
     1272       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1273     .
     1274     if p-change-value = 0
     1275     then do:
     1276       run diasize_position-resize-button in this-procedure .
     1277       return .
     1278     end.
     1279     move_block:
     1280     do
     1281     on error undo move_block, retry move_block
     1282     :
     1283       if retry
     1284       then do:
     1285         do
     1286         on error undo move_block, leave move_block
     1287         :
     1288           if p-change-value > 0
     1289           then do:
     1290             for each buf_temp-diasize-handle
     1291             on error undo, next
     1292             :
     1293               assign
     1294                 v-object-handle = buf_temp-diasize-handle.handle-value
     1295               .
     1296               if v-object-handle <> v-diasize-resize-button
     1297               then do:
     1298                 assign
     1299                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1300                 .
     1301               end.
     1302             end.
     1303             assign
     1304               v-diasize-browse-handle :height = v-browse-height
     1305             .
     1306             for each buf_temp-browse-handle
     1307               where buf_temp-browse-handle.browse-type = 'height':u
     1308             on error undo, next
     1309             :
     1310               assign
     1311                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1312               .
     1313             end.
     1314             assign
     1315               frame Dialog-Frame :height = v-frame-height
     1316             .
     1317             if frame Dialog-Frame :scrollable = true
     1318             then do:
     1319               assign
     1320                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1321               .
     1322             end.
     1323             run diasize_position-resize-button in this-procedure .
     1324           end.
     1325           else do:
     1326             if frame Dialog-Frame :scrollable = true
     1327             then do:
     1328               assign
     1329                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1330               .
     1331             end.
     1332             assign
     1333               frame Dialog-Frame :height = v-frame-height
     1334             .
     1335             assign
     1336               v-diasize-browse-handle :height = v-browse-height
     1337             .
     1338             for each buf_temp-browse-handle
     1339               where buf_temp-browse-handle.browse-type = 'height':u
     1340             on error undo, next
     1341             :
     1342               assign
     1343                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1344               .
     1345             end.
     1346             for each buf_temp-diasize-handle
     1347             on error undo, next
     1348             :
     1349               assign
     1350                 v-object-handle = buf_temp-diasize-handle.handle-value
     1351               .
     1352               if v-object-handle <> v-diasize-resize-button
     1353               then do:
     1354                 assign
     1355                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1356                 .
     1357               end.
     1358             end.
     1359             run diasize_position-resize-button in this-procedure .
     1360           end.
     1361           assign
     1362             v-diasize-change-size = false
     1363           .
     1364           leave move_block .
     1365         end.
     1366       end.
     1367       assign
     1368         v-diasize-need-full-display = true
     1369       .
     1370       if v-diasize-change-size = false
     1371       then do:
     1372         assign
     1373           v-diasize-change-size = true
     1374         .
     1375       end.
     1376       else do:
     1377         return .
     1378       end.
     1379       assign
     1380         v-frame-height = frame Dialog-Frame :height
     1381         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1382         v-browse-height = v-diasize-browse-handle :height
     1383       .
     1384       for each buf_temp-browse-handle
     1385         where buf_temp-browse-handle.browse-type = 'height':u
     1386       :
     1387         assign
     1388           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1389         .
     1390       end.
     1391       for each buf_temp-diasize-handle
     1392       :
     1393         delete buf_temp-diasize-handle .
     1394       end.
     1395       assign
     1396         v-field-group-handle = frame Dialog-Frame :first-child
     1397       .
     1398       do while valid-handle(v-field-group-handle)
     1399       :
     1400         assign
     1401           v-object-handle = v-field-group-handle :first-child
     1402         .
     1403         do while valid-handle(v-object-handle)
     1404         :
     1405           if  v-object-handle <> v-diasize-browse-handle :handle
     1406           and can-query(v-object-handle, "row")
     1407           and can-query(v-object-handle, "height")
     1408           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1409           then do:
     1410             find first buf_temp-browse-handle
     1411               where buf_temp-browse-handle.browse-type   = 'height':u
     1412                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1413               no-error .
     1414             if available buf_temp-browse-handle
     1415             then do:
     1416             end.
     1417             else do:
     1418               create buf_temp-diasize-handle .
     1419               assign
     1420                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1421                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1422               .
     1423             end.
     1424           end.
     1425           assign
     1426             v-object-handle = v-object-handle :next-sibling
     1427           .
     1428         end.
     1429         assign
     1430           v-field-group-handle = v-field-group-handle :next-sibling
     1431         .
     1432       end.
     1433       do with frame Dialog-Frame
     1434       :
     1435         hide v-diasize-resize-button .
     1436         assign
     1437           v-diasize-resize-button :row    = 1
     1438           v-diasize-resize-button :column = 1
     1439         .
     1440       end.
     1441       if p-change-value > 0
     1442       then do:
     1443         if frame Dialog-Frame :scrollable = true
     1444         then do:
     1445           assign
     1446             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1447             no-error .
     1448           if error-status :error
     1449           or error-status :get-message(1) <> ""
     1450           then do:
     1451             undo move_block, retry move_block .
     1452           end.
     1453         end.
     1454         assign
     1455           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1456           no-error .
     1457         if error-status :error
     1458         or error-status :get-message(1) <> ""
     1459         then do:
     1460           undo move_block, retry move_block .
     1461         end.
     1462         assign
     1463           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1464           no-error .
