        1   DEFINE BUFFER locked_tare FOR ub.tare.
        2   DEFINE TEMP-TABLE tt-tare NO-UNDO LIKE ub.tare.
        3   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        4   define input parameter p-mode as character no-undo.
        5   define input parameter p-tare-code like ub.tare.tare-code no-undo.
        6   define input-output parameter p-rid as recid init ? no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Карточка ТАРЫ".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118   define variable v-db-num like ub.db.db-num no-undo .
      119   DEFINE BUTTON B-exit AUTO-GO
      120        LABEL "&Ввод"
      121        SIZE 10 BY 1
      122        BGCOLOR 8 .
      123   DEFINE BUTTON B-Help
      124        LABEL "Помо&щь"
      125        SIZE 3 BY 1
      126        BGCOLOR 8 .
      127   DEFINE BUTTON B-hist
      128        LABEL "Ис&тория"
      129        SIZE 3 BY 1.
      130   DEFINE BUTTON b-quit AUTO-END-KEY
      131        LABEL "&Отмена"
      132        SIZE 10 BY 1
      133        BGCOLOR 8 .
      134   DEFINE QUERY Dialog-Frame FOR
      135         tt-tare SCROLLING.
      136   DEFINE FRAME Dialog-Frame
      137        B-exit AT ROW 1 COL 1
      138        b-quit AT ROW 1 COL 11
      139        B-hist AT ROW 1 COL 58
      140        B-Help AT ROW 1 COL 61
      141        tt-tare.tare-code AT ROW 3.77 COL 20 COLON-ALIGNED
      142             LABEL "Код (аббревиатура)"
      143             VIEW-AS FILL-IN
      144             SIZE 9 BY 1
      145        tt-tare.tare-name AT ROW 5.27 COL 20 COLON-ALIGNED
      146             LABEL "Полное наименование"
      147             VIEW-AS FILL-IN
      148             SIZE 41 BY 1
      149        SPACE(6.12) SKIP(1.36)
      150       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      151            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      152            TITLE "ТАРА"
      153            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      154   ASSIGN
      155          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      156          FRAME Dialog-Frame:HIDDEN           = TRUE.
      157   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      158   DO:
      159     APPLY "END-ERROR":U TO SELF.
      160   END.
      161   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      162   DO:
      163     run proc-save in this-procedure no-error.
      164     if error-status:error then return no-apply.
      165   END.
      166   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
      167   DO:
      168     DEFINE VARIABLE v-rid-list AS CHARACTER NO-undo.
      169         run ref/ctares.w (
      170                        INPUT parparentproc
      171                       ,INPUT '':U
      172                       ,INPUT 'one':U
      173                       ,INPUT tt-tare.tare-code
      174                       ,INPUT-OUTPUT v-rid-list) NO-ERROR.
      175   END.
      176   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      177   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      178   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      179   on help of frame Dialog-Frame
      180   do:
      181     run gbl/app_help.p
      182       (input this-procedure :file-name
      183       ,input ''
      184       ,input ?
      185       ) no-error.
      186     if error-status :error then do:
      187       message
      188         "Ошибка при вызове помощи"
      189         error-status :get-message(1)
      190         view-as alert-box .
      191     end.
      192   end.
      193   run minbtn-set in this-procedure .
      194   on choose of b-help in frame Dialog-Frame
      195   do:
      196     apply "help":u to frame Dialog-Frame .
      197   end.
      198   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      199   procedure minbtn-set :
      200       do
      201           on error undo, return error return-value
      202           :
      203           define variable ii              as integer       no-undo .
      204           define variable fh              as widget-handle no-undo .
      205           define variable hh              as widget-handle no-undo .
      206           define variable v-h             as handle        extent 4 no-undo .
      207           define variable v-name-button   as character     no-undo .
      208           define variable v-help-old-x    as decimal       no-undo .
      209           define variable v-help-old-y    as decimal       no-undo .
      210           define variable v-help-old-size as decimal       no-undo .
      211           define variable v-frame-width   as decimal       no-undo .
      212           define variable jj              as integer       no-undo .
      213           do
      214               on error undo, return error
      215               :
      216               assign
      217                   v-frame-width = frame Dialog-Frame:width - 0.3
      218                   fh            = frame Dialog-Frame:first-child
      219                   hh            = fh:first-child
      220                   ii            = 1
      221                   .
      222               do while valid-handle(hh):
      223                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      224                   do:
      225                       case lc(hh:name) :
      226                           when "b-help" then
      227                               do:
      228                                   hh:load-image-up("cmp/b-help.bmp":u) .
      229                                   hh:load-image-down("cmp/b-help.bmp":u) .
      230                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      231                                   hh:TOOLTIP = "Помощь" .
      232                                   v-help-old-x = hh:column .
      233                                   v-help-old-y = hh:row    .
      234                                   v-help-old-size = hh:width .
      235                                   hh:width-chars = 2.5 .
      236                               end.
      237                           when "b-print" then
      238                               do:
      239                                   hh:load-image("cmp/b-print.bmp":u) .
      240                                   hh:TOOLTIP = "Печать" .
      241                                   v-h[ii] = hh:handle .
      242                                   ii = ii + 1 .
      243                                   hh:width-chars = 3 .
      244                               end.
      245                           when "b-history" or
      246                           when "b-hist" then
      247                               do:
      248                                   hh:load-image("cmp/b-hist.bmp":u) .
      249                                   hh:TOOLTIP = "История" .
      250                                   v-h[ii] = hh:handle .
      251                                   ii = ii + 1 .
      252                                   hh:width-chars = 3 .
      253                               end.
      254                           when "b-sch" then
      255                               do:
      256                                   hh:load-image("cmp/b-sch.bmp":u) .
      257                                   hh:TOOLTIP = "Установка Фильтра" .
      258                                   v-h[ii] = hh:handle .
      259                                   ii = ii + 1 .
      260                                   hh:width-chars = 3 .
      261                               end.
      262                           when "b-hist-user" then
      263                               do:
      264                                   hh:load-image("cmp/b-hist.bmp":u) .
      265                                   hh:TOOLTIP = "История пользователя" .
      266                                   ii = ii + 1 .
      267                               end.
      268                       end case.
      269                   end.
      270                   hh = hh:next-sibling.
      271               end.
      272               b-help:column = v-frame-width - b-help:width-chars.
      273               jj = 0.
      274               repeat ii = 4 to 1 by -1 :
      275                   if valid-handle (v-h[ii] ) then
      276                   do:
      277                       jj  = jj + 1 .
      278                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      279                       v-h[ii]:row    = v-help-old-y .
      280                   end.
      281               end.
      282           end.
      283       end.
      284   end procedure.
      285   MAIN-BLOCK:
      286   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      287      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      288    if p-mode  <> 'ДОБАВЛЕНИЕ':U
      289    and p-mode <> 'ИЗМЕНЕНИЕ':U
      290    and p-mode <> 'ПРОСМОТР':U
      291    then do:
      292       message
      293       vss-workfile vss-revision vss-description skip
      294       "Неверное значение параметров вызова p-mode"  p-mode
      295       view-as alert-box ERROR.
      296       undo, return error.
      297    end.
      298   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      299   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      300     (output v-db-num
      301     )  .
      302    if p-mode <> 'ПРОСМОТР':U then do:
      303       if v-db-num <> 0
      304       then do:
      305         message
      306         vss-workfile vss-revision vss-description skip
      307         "Неверное значение параметров вызова p-mode - нельзя изменять/добавлять записи ЕД.ИЗМ в УБД"
      308         view-as alert-box ERROR.
      309         undo, return error.
      310       end.
      311     end.
      312     for each tt-tare:
      313           delete tt-tare.
      314       end.
      315     if p-mode = 'ИЗМЕНЕНИЕ':U
      316     or p-mode = 'ПРОСМОТР':U then do:
      317       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      318         find first locked_tare EXclusive-lock where
      319                      recid(locked_tare) = p-rid no-wait no-error.
      320         if locked locked_tare then do:
      321           message
      322           vss-workfile vss-revision vss-description skip
      323            "Запись ЕД.ИЗМ. занята"
      324           view-as alert-box error .
      325           undo, return error.
      326         end.
      327       end.
      328       else do:
      329         find first locked_tare no-lock where
      330                          recid(locked_tare) = p-rid no-error .
      331         if not avail locked_tare then do:
      332           find first locked_tare where
      333                     locKed_tare.tare-code = p-tare-code no-error .
      334         end.
      335       end.
      336       if not available locked_tare then do:
      337         message
      338         vss-workfile vss-revision vss-description skip
      339         "Не найдена запись ЕД.ИЗМ."
      340         view-as alert-box error .
      341         undo, return error.
      342       end.
      343       create tt-tare.
      344       buffer-copy locked_tare to tt-tare.
      345     end.
      346     else do:
      347       create tt-tare.
      348     end.
      349     RUN MYenable.
      350     WAIT-FOR GO OF FRAME Dialog-Frame.
      351   END.
      352   session:data-entry-return = no .
      353   RUN disable_UI.
      354   PROCEDURE disable_UI :
      355     HIDE FRAME Dialog-Frame.
      356   END PROCEDURE.
      357   PROCEDURE enable_UI :
      358     OPEN QUERY Dialog-Frame FOR EACH tt-tare SHARE-LOCK.
      359     GET FIRST Dialog-Frame.
      360     IF AVAILABLE tt-tare THEN
      361       DISPLAY tt-tare.tare-code tt-tare.tare-name
      362         WITH FRAME Dialog-Frame.
      363     ENABLE B-exit b-quit B-hist B-Help tt-tare.tare-code tt-tare.tare-name
      364         WITH FRAME Dialog-Frame.
      365     VIEW FRAME Dialog-Frame.
      366   END PROCEDURE.
      367   PROCEDURE MyEnable :
      368   session:data-entry-return = yes .
      369   IF AVAILABLE tt-tare THEN
      370       DISPLAY
      371       tt-tare.tare-name
      372       tt-tare.tare-code
      373       WITH FRAME Dialog-Frame .
      374     if p-mode = 'ПРОСМОТР':U then do:
      375       assign
      376       b-exit:label = "&Выход".
      377     end.
      378     ENABLE
      379     B-exit when p-mode <> 'ПРОСМОТР':U
      380     b-quit
      381     B-Help
      382     b-hist WHEN p-mode <> 'ДОБАВЛЕНИЕ':U
      383     tt-tare.tare-name when p-mode <> 'ПРОСМОТР':U
      384     tt-tare.tare-code when p-mode = 'ДОБАВЛЕНИЕ':U
      385     WITH FRAME Dialog-Frame .
      386     VIEW FRAME Dialog-Frame .
      387     IF p-mode = 'ИЗМЕНЕНИЕ':U then do:
      388      FRAME Dialog-Frame:title = "Изменение тары".
      389       DISPLAY
      390       tt-tare.tare-name
      391       tt-tare.tare-code
      392       WITH frame Dialog-Frame.
      393     end.
      394     if p-mode = 'ПРОСМОТР':U then do:
      395       hide
      396       b-exit in frame Dialog-Frame .
      397     end.
      398   END PROCEDURE.
      399   PROCEDURE proc-save :
      400   define variable v-rid as recid no-undo .
      401   assign
      402   frame Dialog-Frame
      403   tt-tare.tare-name
      404   tt-tare.tare-code
      405   .
      406   run ref/tare01.p (
      407    input-output v-rid
      408   ,input no
      409   ,input p-mode
      410   ,input tt-tare.tare-name
      411   ,input tt-tare.tare-code
      412   ,input tt-tare.key#_one
      413   ,input tt-tare.key#_two
      414   ,input tt-tare.charkey_one
      415   ,input tt-tare.charkey_two
      416   ) no-error.
      417   if error-status:error then do:
      418   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      419   define variable fh as widget-handle no-undo .
      420   define variable hh as widget-handle no-undo .
      421   define variable rv as character no-undo .
      422   assign
      423   rv = entry(1, return-value , chr(4)).
      424   if rv <> "":U then do:
      425     assign
      426     fh = frame Dialog-Frame:first-child
      427     hh = fh:first-child
      428     .
      429     do while valid-handle(hh):
      430       if hh:name = rv then do:
      431         APPLY "ENTRY" to hh.
      432         undo ,
      433         return error.
      434       end.
      435       hh = hh:next-sibling.
      436     end.
      437   end.
      438     undo, return error.
      439   end.
      440   p-rid = v-rid.
      441   END PROCEDURE.
