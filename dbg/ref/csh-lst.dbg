      111   ~
      112   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      113   procedure discfgru-check :
      114   define input parameter p-table-name as character no-undo .
      115   define input parameter p-templ-rl-root as integer no-undo .
      116   define input parameter p-time-templ-rl-root as integer no-undo .
      117   define input parameter p-pos-type as character no-undo .
      118   define output parameter p-disnct-role as character no-undo .
      119   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      120     do
      121     on error undo, return error return-value
      122     :
      123       find first buf_dis-cfg-rule no-lock where
      124               buf_dis-cfg-rule.table-name = p-table-name
      125           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      126           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
      127           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
      128       if not available buf_dis-cfg-rule
      129       or p-pos-type = "":U
      130       then do:
      131          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
      132                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      133                                  , p-templ-rl-root
      134                                  , (if p-time-templ-rl-root = ?
      135                                     then '':U
      136                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
      137                                     )
      138                                  ).
      139       end.
      140       assign
      141       p-disnct-role = buf_dis-cfg-rule.discnt-role
      142       .
      143     end.
      144   end procedure.
      145   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      146   FUNCTION get-region RETURNS CHARACTER
      147     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      148     define variable par-region as character no-undo.
      149     if parhost-code = 0 and
      150          parobj-type = "":U and
      151          parobj-code = 0 then do:
      152          par-region = "Глобально".
      153          return par-region.
      154       end.
      155       if parobj-type = 'орг':U then do:
      156          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      157          return par-region.
      158       end.
      159       if parobj-type = 'регион':U
      160       then do:
      161          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      162          return par-region.
      163       end.
      164       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      165       return par-region.
      166   END FUNCTION.
      167   FUNCTION get-objregion RETURNS CHARACTER
      168     (  input parobj-type as character, input parobj-code as integer ) :
      169     define variable par-region as character no-undo.
      170     if  parobj-type = "":U and
      171         parobj-code = 0
      172     then do:
      173        par-region = "Глобально".
      174     end.
      175     else if parobj-type = 'орг':U
      176     then do:
      177        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      178     end.
      179     else if parobj-type = 'регион':U
      180     then do:
      181        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      182     end.
      183     else
      184        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      185     return par-region.
      186   END FUNCTION.
      187   procedure discpru-name :
      188   define buffer buf_dis-rule for ub.dis-rule.
      189   do
      190     on error undo, return error
      191     :
      192     define input  parameter p-templ-rl-root  as integer no-undo .
      193     define output parameter p-label          as character no-undo .
      194     find first buf_dis-rule no-lock where
      195               buf_dis-rule.rule-num = p-templ-rl-root no-error.
      196     if available buf_dis-rule then do:
      197       if buf_dis-rule.rule-num > 0 then
      198       p-label = buf_dis-rule.des.
      199     end.
      200     else do:
      201       p-label = substitute("Неизвестный шаблон правила скидки &1", p-templ-rl-root).
      202     end.
      203   end.
      204   end procedure.
      205   function discpru-get-disc-label returns character ( input p-templ-rl-root as integer):
      206   define variable v-rule-label as character no-undo .
      207   run discpru-name in this-procedure ( input p-templ-rl-root
      208                                        ,output v-rule-label) no-error.
      209   return v-rule-label.
      210   end function.
      211   function discpru-get-disc-role-label returns character ( input p-discnt-role as character):
      212   define variable v-rule-label as character no-undo .
      213   return entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u).
      214   end function.
      215   procedure discpru-write :
      216     do
      217     on error undo, return error
      218     :
      219       define input parameter p-cdpay-code     like ub.dis-cp-rule.cdpay-code  no-undo .
      220       define input parameter p-curr-code      like ub.dis-cp-rule.curr-code  no-undo .
      221       define input parameter p-host-code      like ub.dis-cp-rule.host-code   no-undo .
      222       define input parameter p-obj-type       like ub.dis-cp-rule.obj-type   no-undo .
      223       define input parameter p-obj-code       like ub.dis-cp-rule.obj-code   no-undo .
      224       define input parameter p-pos-type       like ub.dis-cp-rule.pos-type   no-undo .
      225       define input parameter p-discnt-role    like ub.dis-cp-rule.discnt-role no-undo .
      226       define input parameter p-templ-rl-root  like ub.dis-cp-rule.templ-rl-root  no-undo .
      227       define input parameter p-time-templ-rl-root  like ub.dis-cp-rule.time-templ-rl-root  no-undo .
      228       define input parameter p-rule-num       like ub.dis-cp-rule.rule-num    no-undo .
      229       define input parameter p-nonunique      like ub.dis-cp-rule.nonunique   no-undo .
      230       define buffer buf_dis-rule for ub.dis-rule.
      231       define buffer buf_dis-cp-rule for ub.dis-cp-rule .
      232       define buffer lock_dis-cp-rule for ub.dis-cp-rule .
      233       define variable v-label          as character no-undo .
      234       define variable v-discnt-role as character no-undo .
      235       run discfgru-check in this-procedure (
      236                                             input 'dis-cp-rule':U
      237                                            ,input p-templ-rl-root
      238                                            ,input p-time-templ-rl-root
      239                                            ,input p-pos-type
      240                                            ,output v-discnt-role
      241                                             ) no-error .
      242       if error-status :error then do:
      243         undo, return error return-value .
      244       end.
      245       if p-discnt-role = ? then do:
      246         p-discnt-role = v-discnt-role.
      247       end.
      248       if p-discnt-role <> v-discnt-role then do:
      249         undo, return error substitute("Тип платежа &1 код валюты &2 фирма &3 &4 место использ. &5 скидка типа &6&7не может быть по шаблону &8 и расписанию &9"
      250                                 ,p-cdpay-code
      251                                 ,p-curr-code
      252                                 ,p-host-code
      253                                 ,(p-obj-type + string(p-obj-code))
      254                                 ,p-pos-type
      255                                 ,entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u)
      256                                 ,chr(10)
      257                                 ,p-templ-rl-root
      258                                 ,p-rule-num).
      259       end.
      260       if p-pos-type = ? then do:
      261   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      262   define variable v-param-type5 as character no-undo .
      263   define variable v-value-date5 as date no-undo .
      264   define variable v-value-decimal5 as decimal no-undo .
      265   define variable v-value-integer5 as INTEGER no-undo .
      266   define variable v-value-logical5 AS LOGICAL no-undo .
      267   define variable v-tth5 as handle no-undo .
      268   run adm/shattri.p (
      269       input "get":U
      270       ,input  p-obj-type
      271       ,input  p-obj-code
      272       ,input  'cd-sending':U
      273       ,input  'dflt-cd':U
      274       ,output p-pos-type
      275       ,output v-value-date5
      276       ,output v-value-decimal5
      277       ,output v-value-integer5
      278       ,output v-value-logical5
      279       ,output v-param-type5
      280       ,INPUT-OUTPUT table-handle v-tth5
      281       )  .
      282   delete object v-tth5 no-error.
      283       end.
      284       find first buf_dis-rule no-lock where
      285                 buf_dis-rule.rule-num = p-rule-num no-error.
      286       if not available buf_Dis-rule then do:
      287         undo, return error substitute("Тип платежа &1 код валюты &2 фирма &3 &4 место использ. &5 скидка типа &6&7не найдено правило скидки &8"
      288                                 ,p-cdpay-code
      289                                 ,p-curr-code
      290                                 ,p-host-code
      291                                 ,(p-obj-type + string(p-obj-code))
      292                                 ,p-pos-type
      293                                 ,entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u)
      294                                 ,chr(10)
      295                                 ,p-rule-num).
      296       end.
      297       if buf_dis-rule.root <> yes then do:
      298         undo, return error substitute("Тип платежа &1 код валюты &2 фирма &3 &4 место использ. &5 скидка типа &6&7правило скидки &8 - некорневое"
      299                                 ,p-cdpay-code
      300                                 ,p-curr-code
      301                                 ,p-host-code
      302                                 ,(p-obj-type + string(p-obj-code))
      303                                 ,p-pos-type
      304                                 ,entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u)
      305                                 ,chr(10)
      306                                 ,p-rule-num).
      307       end.
      308       if not (p-obj-type = buf_dis-rule.obj-type
      309           and p-obj-code = buf_dis-rule.obj-code) then do:
      310         undo, return error (substitute("Тип платежа &1 код валюты &2 фирма &3 &4 место использ. &5 скидка типа &6&7правило скидки &8"
      311                                 ,p-cdpay-code
      312                                 ,p-curr-code
      313                                 ,p-host-code
      314                                 ,(p-obj-type + string(p-obj-code))
      315                                 ,p-pos-type
      316                                 ,entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u)
      317                                 ,chr(10)
      318                                 ,p-rule-num)
      319                             +
      320                             substitute("Правило скидки &1 определено для &1&2" +
      321                                        "а привязка к ДК для &3"
      322                                        ,get-region( buf_Dis-rule.host-code, buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
      323                                        ,chr(10)
      324                                        ,get-region( p-host-code, p-obj-type, p-obj-code)
      325                                        ))
      326                                 .
      327       end.
      328       find first buf_dis-cp-rule exclusive-lock where
      329                  buf_dis-cp-rule.cdpay-code  = p-cdpay-code
      330              AND buf_dis-cp-rule.curr-code  = p-curr-code
      331              AND buf_dis-cp-rule.obj-type  = p-obj-type
      332              AND buf_dis-cp-rule.host-code = p-host-code
      333              AND buf_dis-cp-rule.obj-code  = p-obj-code
      334              AND buf_dis-cp-rule.pos-type  = p-pos-type
      335              AND buf_dis-cp-rule.discnt-role = p-discnt-role
      336              and buf_dis-cp-rule.nonunique = p-nonunique
      337              no-error .
      338       if not available buf_dis-cp-rule then do:
      339         create buf_dis-cp-rule .
      340         assign
      341         buf_dis-cp-rule.cdpay-code  = p-cdpay-code
      342         buf_dis-cp-rule.curr-code  = p-curr-code
      343         buf_dis-cp-rule.host-code  = p-host-code
      344         buf_dis-cp-rule.obj-type  = p-obj-type
      345         buf_dis-cp-rule.obj-code  = p-obj-code
      346         buf_dis-cp-rule.pos-type = p-pos-type
      347         buf_dis-cp-rule.discnt-role = v-discnt-role
      348         buf_dis-cp-rule.rule-num = p-rule-num
      349         buf_dis-cp-rule.nonunique = p-nonunique
      350         no-error
      351         .
      352       end.
      353       ASSIGN
      354       buf_dis-cp-rule.rule-num = p-rule-num
      355       buf_dis-cp-rule.rl-root = buf_Dis-rule.rl-root
      356       buf_dis-cp-rule.templ-rl-root = p-templ-rl-root
      357       buf_dis-cp-rule.time-templ-rl-root = p-time-templ-rl-root
      358       buf_dis-cp-rule.nonunique = p-nonunique
      359       no-error.
      360     end.
      361   end procedure.
      362   procedure discpru-delete :
      363   define input parameter p-cdpay-code     like ub.dis-cp-rule.cdpay-code  no-undo .
      364   define input parameter p-curr-code      like ub.dis-cp-rule.curr-code  no-undo .
      365   define input parameter p-host-code      like ub.dis-cp-rule.host-code   no-undo .
      366   define input parameter p-obj-type       like ub.dis-cp-rule.obj-type   no-undo .
      367   define input parameter p-obj-code       like ub.dis-cp-rule.obj-code   no-undo .
      368   define input parameter p-pos-type       like ub.dis-cp-rule.pos-type   no-undo .
      369   define input parameter p-discnt-role    like ub.dis-cp-rule.discnt-role no-undo .
      370   define input parameter p-nonunique      like ub.dis-cp-rule.nonunique   no-undo .
      371   define output parameter p-deleted       as logical no-undo .
      372   define variable v-rule-label as character no-undo .
      373   define buffer buf_dis-cp-rule for ub.dis-cp-rule.
      374   do
      375   on error undo, return error
      376   :
      377   find first buf_dis-cp-rule exclusive-lock where
      378               buf_dis-cp-rule.cdpay-code  = p-cdpay-code
      379           AND buf_dis-cp-rule.curr-code  = p-curr-code
      380           AND buf_dis-cp-rule.obj-type  = p-obj-type
      381           AND buf_dis-cp-rule.host-code = p-host-code
      382           AND buf_dis-cp-rule.obj-code  = p-obj-code
      383           AND buf_dis-cp-rule.pos-type  = p-pos-type
      384           AND buf_dis-cp-rule.discnt-role = p-discnt-role
      385           and buf_dis-cp-rule.nonunique = p-nonunique
      386           no-error .
      387   if not available buf_dis-cp-rule then do:
      388     return '':U.
      389   end.
      390   delete buf_dis-cp-rule no-error.
      391   if error-status:error then do:
      392     run discpru-name in this-procedure
      393       (input  buf_dis-cp-rule.templ-rl-root
      394       ,output v-rule-label
      395       ) no-error .
      396     undo, return error substitute("Ошибка при удалении скидки по типу касс. платежа:&1" +
      397                                  "скидка &2 (POS &3) на фирме &4 &5&6 для платежа&1&7&1&8"
      398                                   ,chr(10)
      399                                   ,v-rule-label
      400                                   ,p-pos-type
      401                                   ,p-host-code
      402                                   ,p-obj-type
      403                                   ,p-obj-code
      404                                   ,error-status:get-message(1)
      405                                   ,return-value ).
      406   end.
      407   p-deleted = yes.
      408   return '':U.
      409   end.
      410   end procedure.
      411   procedure discpru-edit :
      412   define input parameter p-mode as character no-undo .
      413   define input parameter p-cdpay-code   like ub.dis-cp-rule.cdpay-code no-undo .
      414   define input parameter p-curr-code   like ub.dis-cp-rule.curr-code no-undo .
      415   define input parameter p-host-code like ub.dis-cp-rule.host-code no-undo .
      416   define input parameter p-obj-type like ub.dis-cp-rule.obj-type no-undo .
      417   define input parameter p-obj-code like ub.dis-cp-rule.obj-code no-undo .
      418   define input parameter p-pos-type like ub.dis-cp-rule.pos-type no-undo .
      419   define input parameter p-discnt-role    like ub.dis-cp-rule.discnt-role no-undo .
      420   define input parameter p-templ-rl-root like ub.dis-cp-rule.templ-rl-root no-undo .
      421   define input parameter p-time-templ-rl-root like ub.dis-cp-rule.time-templ-rl-root no-undo .
      422   define input parameter p-cfg-NONUNIQUE as character no-undo .
      423   define input parameter p-check as integer no-undo .
      424   define input-output parameter p-rule-num as integer no-undo .
      425   define input-output parameter p-nonunique as character no-undo .
      426   define output parameter p-setted as logical no-undo .
      427   DEFINE VARIABLE v-value as character no-undo .
      428   define variable v-sts as integer no-undo .
      429   define variable v-rid-list as character no-undo .
      430   DEFINE VARIABLE v-rule-num as integer no-undo .
      431   define variable v-cd-dr-correct  as logical no-undo .
      432   define variable jj as integer no-undo .
      433   define variable conf-par as character no-undo .
      434   define variable conf-attr as character no-undo .
      435   define variable par-type as character no-undo .
      436   define variable dflt-cd as character no-undo .
      437   define variable v-cd-list as character no-undo .
      438   define variable v-is-time-rule as logical no-undo .
      439   define variable v-label as character no-undo .
      440   define variable v-nonunique as character no-undo .
      441   define variable v-mode as character no-undo .
      442   define buffer buf_dis-rule for ub.dis-rule.
      443   define buffer buf_dis-time-rule for ub.dis-time-rule .
      444   define buffer term_dis-rule for ub.dis-rule.
      445   define buffer buf_dis-cp-rule for ub.dis-cp-rule.
      446   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      447   define buffer buf_temp-cpdisc for temp-cpdisc.
      448   assign
      449   v-rule-num = p-rule-num.
      450   v-sts = integer('0':U).
      451   if v-rule-num <> 0
      452   and v-rule-num <> ?
      453   then do:
      454     find first buf_dis-rule no-lock where
      455               buf_dis-rule.rule-num = v-rule-num no-error .
      456     if error-status:error then do:
      457       message
      458       "Ошибка при поиске правила с номером" v-rule-num
      459       view-as alert-box error .
      460       return .
      461     end.
      462     assign
      463     v-rid-list = string(recid(buf_dis-rule))
      464     .
      465   end.
      466     run discpru-name in this-procedure (
      467                                   input p-templ-rl-root
      468                                   ,output v-label) no-error.
      469   if p-pos-type = ?
      470   or p-pos-type = '':U then do:
      471   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      472   define variable v-param-type6 as character no-undo .
      473   define variable v-value-date6 as date no-undo .
      474   define variable v-value-decimal6 as decimal no-undo .
      475   define variable v-value-integer6 as INTEGER no-undo .
      476   define variable v-value-logical6 AS LOGICAL no-undo .
      477   define variable v-tth6 as handle no-undo .
      478   run adm/shattri.p (
      479       input "get":U
      480       ,input  p-obj-type
      481       ,input  p-obj-code
      482       ,input  'cd-sending':U
      483       ,input  'dflt-cd':U
      484       ,output dflt-cd
      485       ,output v-value-date6
      486       ,output v-value-decimal6
      487       ,output v-value-integer6
      488       ,output v-value-logical6
      489       ,output v-param-type6
      490       ,INPUT-OUTPUT table-handle v-tth6
      491       )  .
      492   delete object v-tth6 no-error.
      493   end.
      494   else do:
      495     dflt-cd = p-pos-type.
      496   end.
      497   v-mode =  'dis-cp-rule':U + "=" + p-discnt-role + "=" + (if p-host-code = 0
      498                                                                then "global"
      499                                                                else (if p-obj-type = ''
      500                                                                     then "host"
      501                                                                     else "object")
      502                                                                ) .
      503   run ref/dis-ruls.w (
      504               input parparentproc
      505               ,input p-host-code
      506               ,input p-obj-type
      507               ,input p-obj-code
      508               ,input "b-add,b-sel":U
      509               ,input "upper-rule-num-object":u
      510               ,input p-templ-rl-root
      511               ,input p-time-templ-rl-root
      512               ,input 0
      513               ,input-output v-sts
      514               ,input-output v-rid-list ) no-error .
      515   do
      516   on error undo, return error return-value
      517   :
      518     if v-rid-list <> "":U then do:
      519       find first buf_dis-rule exclusive-lock where
      520                   recid(buf_dis-rule) = integer(v-rid-list) no-wait no-error .
      521       if not available buf_dis-rule
      522       then do:
      523         message
      524         "Ошибка при поиске правила с recid" v-rid-list
      525         view-as alert-box error .
      526         return .
      527       end.
      528       if buf_dis-rule.sts <> integer('0':U) then do:
      529         message
      530         "Правило скидки имеет статус" entry (lookup (string(buf_dis-rule.sts), '0,1,2,99,98':U), 'исп,не-исп,детализ,удаление,запр.удал':U) skip
      531         "Нельзя привязать к нему скидку на платеж"
      532         view-as alert-box error .
      533         return .
      534       end.
      535       find first buf_dis-cfg-rule no-lock where
      536               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      537           and buf_dis-cfg-rule.time-templ-rl-root = (if buf_dis-rule.time-templ-rl-root = -1
      538                                                      then 0
      539                                                      else buf_dis-rule.time-templ-rl-root)
      540           and buf_dis-cfg-rule.table-name = 'dis-cp-rule':U
      541           and buf_dis-cfg-rule.pos-type = dflt-cd no-error.
      542       if available buf_dis-cfg-rule then do:
      543         assign
      544         v-cd-dr-correct = yes
      545         .
      546       end.
      547       if not v-cd-dr-correct
      548       then do:
      549         message
      550         substitute("Правило скидки &1 неприменимо для касс &2.&3" +
      551                   "(АРМ АДМИНИСТРАТОР-Магазины(Фирмы)-Параметры-Общие опции коммуникации с кассами)"
      552                   ,buf_dis-rule.rule-num
      553                   ,dflt-cd
      554                   ,chr(10)
      555                   )
      556         view-as alert-box error .
      557         undo, return error .
      558       end.
      559      assign
      560       v-nonunique = if p-cfg-nonunique = '':U
      561                     then '':U
      562                     else string(buffer buf_Dis-rule:handle:buffer-field(p-cfg-nonunique):buffer-value).
      563       if p-check = 0
      564       or p-check = 2
      565       then do:
      566         find first buf_dis-cp-rule no-lock where
      567                    buf_dis-cp-rule.host-code = p-host-code
      568                 and buf_dis-cp-rule.obj-type = p-obj-type
      569                 and buf_dis-cp-rule.obj-code = p-obj-code
      570                 and buf_dis-cp-rule.curr-code = p-curr-code
      571                 and buf_dis-cp-rule.cdpay-code = p-cdpay-code
      572                 and buf_dis-cp-rule.pos-type = p-pos-type
      573                 and buf_dis-cp-rule.discnt-role = p-discnt-role
      574                 and buf_dis-cp-rule.nonunique = v-nonunique no-error .
      575         if available buf_dis-cp-rule
      576         and p-mode <> 'ИЗМЕНЕНИЕ':U
      577         then do:
      578           message
      579           "Скидка такого типа на данный тип платежа уже существует"
      580           view-as alert-box error .
      581           return error.
      582         end.
      583       end.
      584       if p-check = 1
      585       or p-check = 2
      586       then do:
      587         find first buf_temp-cpdisc no-lock where
      588                    buf_temp-cpdisc.host-code = p-host-code
      589                 and buf_temp-cpdisc.obj-type = p-obj-type
      590                 and buf_temp-cpdisc.obj-code = p-obj-code
      591                 and buf_temp-cpdisc.cdpay-code = p-cdpay-code
      592                 and buf_temp-cpdisc.curr-code = p-curr-code
      593                 and buf_temp-cpdisc.pos-type = p-pos-type
      594                 and buf_temp-cpdisc.discnt-role = p-discnt-role
      595                 and buf_temp-cpdisc.nonunique = v-nonunique no-error .
      596         if available buf_temp-cpdisc
      597         and buf_temp-cpdisc.rule-num <> 0
      598         and p-mode <> 'ИЗМЕНЕНИЕ':U
      599         then do:
      600           message
      601         "Скидка такого типа на данный тип платежа уже существует"
      602           view-as alert-box error .
      603           return error.
      604         end.
      605       end.
      606       if p-rule-num <> buf_dis-rule.rule-num then do:
      607         assign
      608         p-setted = yes
      609         p-rule-num = buf_dis-rule.rule-num
      610         p-nonunique = v-nonunique
      611         .
      612       end.
      613     end.
      614   end.
      615   end procedure.
      616   DEFINE VARIABLE var-object as character no-undo init 'dis-cp-rule':U.
      617   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      618   FUNCTION CIntBinS RETURNS CHARACTER(input vl_int as integer):
      619   def var vl_bin as char no-undo init "".
      620   if vl_int < 0 OR vl_int = ? then return ?.
      621   do while vl_int > 0:
      622     assign
      623     vl_bin = (if vl_int modulo 2 = 0
      624                 then "0":U
      625                 else "1":U) + vl_bin
      626     vl_int = truncate(vl_int / 2,0).
      627   end.
      628   return fill( "0":U, 32 - length(vl_bin)) + vl_bin .
      629   END FUNCTION.
      630   FUNCTION BinMask RETURNS LOGICAL(input vl_int as integer,
      631                                    input vl_binm as character):
      632   DEFINE VARIABLE vl_bin as character no-undo.
      633   DEFINE VARIABLE ii as integer no-undo.
      634   DEFINE VARIABLE ii-len as integer no-undo.
      635   DEFINE VARIABLE ii-lenm as integer no-undo.
      636   DEFINE VARIABLE mchar as character no-undo.
      637   DEFINE VARIABLE ichar as character no-undo.
      638   if vl_binm = ? then return ?.
      639   vl_bin = CIntBinS(vl_int).
      640   if vl_bin = ? then return ?.
      641   assign
      642   vl_binm = LEFT-TRIM(vl_binm, "X":U)
      643   ii-lenm = LENGTH(vl_binm)
      644   ii-len = LENGTH(vl_bin) - ii-lenm
      645   .
      646   if II-LENM > 32 THEN RETURN ?.
      647   DO II = 1 to II-LENm:
      648     assign
      649     mchar = SUBSTR(vl_binm, ii, 1)
      650     ichar = SUBSTR(vl_bin, ii + ii-len, 1)
      651     .
      652     IF not (MCHAR = "0":u or MCHAR = "1":u or MCHAR = "X":u) then return ?.
      653     IF ichar <> mchar AND mchar <> "X":U then return no.
      654   END.
      655   return yes.
      656   END FUNCTION.
      657   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      658   define SHARED temp-table temp-disc no-undo
      659   field rule-num as integer
      660   field host-code as integer
      661   field obj-type as character
      662   field obj-code as integer
      663   field templ-rl-root as integer
      664   field time-templ-rl-root as integer
      665   field discnt-role as character
      666   field nonunique as character
      667   field cfg-nonunique as character
      668   field pos-type as character
      669   field action as logical
      670   field label_ as character
      671   index pi is  unique primary
      672   pos-type discnt-role nonunique host-code obj-type obj-code action ASCENDING
      673   index action
      674   action
      675   index ipos
      676   pos-type discnt-role
      677   .
      678   procedure temp-dsc-value :
      679   define input  parameter p-pos-type  as character  no-undo .
      680   define input  parameter p-templ-rl-root as integer  no-undo .
      681   define input  parameter p-time-templ-rl-root as integer no-undo .
      682   define input  parameter p-discnt-role  as character  no-undo .
      683   define input  parameter p-cfg-nonunique as character no-undo .
      684   define input  parameter p-host-code as integer no-undo .
      685   define input  parameter p-obj-type  as character no-undo .
      686   define input  parameter p-obj-code as integer no-undo .
      687   define input  parameter p-0mode as character no-undo .
      688   define input  parameter p-mode      as character no-undo .
      689   define input  parameter p-rec as recid no-undo .
      690   define output parameter p-rule-num    as integer no-undo .
      691   define output parameter p-nonunique   as character no-undo .
      692   define buffer buf_temp-disc for temp-disc .
      693   define variable v-discnt-role as character no-undo .
      694   define variable v-rule-num as integer no-undo .
      695   define variable v-nonunique as character no-undo .
      696   define variable v-templ-rl-root as integer no-undo .
      697   define variable v-time-templ-rl-root as integer no-undo .
      698   define variable v-setted         as logical   no-undo .
      699   define variable choice as integer no-undo .
      700   do
      701   on error undo, return error
      702   :
      703     case var-object:
      704       when 'dis-gds-rule':U
      705       then do:
      706         run discfgru-check  in this-procedure (
      707                                                  input 'dis-gds-rule':U
      708                                                 ,input p-templ-rl-root
      709                                                 ,input p-time-templ-rl-root
      710                                                 ,input p-pos-type
      711                                                 ,output v-discnt-role) no-error.
      712       end.
      713       when 'dis-dc-rule':U then do:
      714         run discfgru-check  in this-procedure (
      715                                                  input 'dis-dc-rule':U
      716                                                 ,input p-templ-rl-root
      717                                                 ,input p-time-templ-rl-root
      718                                                 ,input p-pos-type
      719                                                 ,output v-discnt-role) no-error.
      720       end.
      721       when 'dis-cp-rule':U then do:
      722         run discfgru-check  in this-procedure (
      723                                                  input 'dis-cp-rule':U
      724                                                 ,input p-templ-rl-root
      725                                                 ,input p-time-templ-rl-root
      726                                                 ,input p-pos-type
      727                                                 ,output v-discnt-role) no-error.
      728       end.
      729       otherwise do:
      730         undo, return error .
      731       end.
      732     end case.
      733     if error-status :error
      734     then do:
      735       undo, return error return-value .
      736     end.
      737     if p-mode = "change":U
      738     then do:
      739       if p-rec <> ? then do:
      740         find first buf_temp-disc no-lock where
      741               recid(buf_temp-disc) = p-rec
      742           no-error .
      743       end.
      744       else do:
      745         find first buf_temp-disc no-lock where
      746                   buf_temp-disc.pos-type = p-pos-type
      747               and buf_temp-disc.discnt-role = p-discnt-role
      748               and buf_temp-disc.nonunique  = p-nonunique
      749               and buf_temp-disc.host-code = p-host-code
      750               and buf_temp-disc.obj-type = p-obj-type
      751               and buf_temp-disc.obj-code = p-obj-code
      752           no-error .
      753       end.
      754       if avail buf_temp-disc then do:
      755         assign
      756         v-rule-num =  buf_temp-disc.rule-num
      757         v-nonunique = buf_temp-disc.nonunique
      758         v-templ-rl-root = buf_temp-disc.templ-rl-root
      759         v-time-templ-rl-root = buf_temp-disc.time-templ-rl-root
      760         .
      761       end.
      762     end.
      763     CASE var-object:
      764     END CASE.
      765     if v-setted = no then do:
      766       return "not-set":U.
      767     end.
      768     p-rule-num = v-rule-num.
      769     p-nonunique = v-nonunique.
      770   end.
      771   end procedure.
      772   procedure temp-dsc-write :
      773     do
      774     on error undo, return error
      775     :
      776       define input parameter p-add      as logical no-undo .
      777       define input parameter p-pos-type as character  no-undo .
      778       define input parameter p-templ-rl-root as integer  no-undo .
      779       define input parameter p-time-templ-rl-root as integer  no-undo .
      780       define input parameter p-discnt-role as character  no-undo .
      781       define input parameter p-cfg-nonunique as character no-undo .
      782       define input parameter p-host-code as integer no-undo .
      783       define input parameter p-obj-type as character no-undo .
      784       define input parameter p-obj-code as integer no-undo .
      785       define input parameter p-rule-num  as integer no-undo .
      786       define input parameter p-action   like temp-disc.action no-undo .
      787       define input-output parameter p-rec as recid no-undo .
      788       define buffer buf_temp-disc for temp-disc .
      789       define variable v-discnt-role as character no-undo .
      790       define variable varhost-code like ub.clients.host-code no-undo.
      791       define variable varobj-type like ub.clients.obj-type no-undo.
      792       define variable varobj-code like ub.clients.obj-code no-undo.
      793       define variable choice as integer no-undo .
      794       define var loc#log as logical no-undo.
      795       define variable loc-action as logical no-undo.
      796       define variable v-nonunique as character no-undo .
      797       define buffer buf_dis-rule for ub.dis-rule.
      798       case var-object:
      799         when 'dis-gds-rule':U
      800         then do:
      801           run discfgru-check  in this-procedure (
      802                                                   input 'dis-gds-rule':U
      803                                                  ,input p-templ-rl-root
      804                                                  ,input p-time-templ-rl-root
      805                                                  ,input p-pos-type
      806                                                  ,output v-discnt-role) no-error.
      807         end.
      808         when 'dis-dc-rule':U
      809         then do:
      810           run discfgru-check  in this-procedure (
      811                                                   input 'dis-dc-rule':U
      812                                                  ,input p-templ-rl-root
      813                                                  ,input p-time-templ-rl-root
      814                                                  ,input p-pos-type
      815                                                  ,output v-discnt-role) no-error.
      816         end.
      817         when 'dis-cp-rule':U
      818         then do:
      819           run discfgru-check  in this-procedure (
      820                                                   input 'dis-cp-rule':U
      821                                                  ,input p-templ-rl-root
      822                                                  ,input p-time-templ-rl-root
      823                                                  ,input p-pos-type
      824                                                  ,output v-discnt-role) no-error.
      825         end.
      826         otherwise do:
      827           undo, return error .
      828         end.
      829       END CASE.
      830       if error-status :error then do:
      831         undo, return error return-value .
      832       end.
      833       if p-cfg-nonunique <> '':U
      834       and p-rule-num <> 0
      835       and p-rule-num <> ?
      836       then do:
      837         find first buf_dis-rule no-lock where
      838                 buf_dis-rule.rule-num = p-rule-num no-error.
      839         if not available buf_dis-rule then do:
      840           undo, return error substitute("Не найдено правило скидок &1", p-rule-num).
      841         end.
      842         assign
      843         v-nonunique = (if p-cfg-nonunique = '':U
      844                       then '':U
      845                       else (if p-cfg-nonunique begins "@"
      846                             then left-trim(p-cfg-nonunique, "@")
      847                             else string(buffer buf_Dis-rule:handle:buffer-field(p-cfg-nonunique):buffer-value)
      848                             ))
      849         .
      850       end.
      851       if p-rec <> ? then do:
      852         find first buf_temp-disc exclusive-lock where
      853                   recid(buf_temp-disc) = p-rec no-error .
      854       end.
      855       else do:
      856         find first buf_temp-disc exclusive-lock where
      857                   buf_temp-disc.pos-type = p-pos-type
      858                 and buf_temp-disc.discnt-role = p-discnt-role
      859                 and buf_temp-disc.host-code = p-host-code
      860                 and buf_temp-disc.obj-type = p-obj-type
      861                 and buf_temp-disc.obj-code = p-obj-code
      862                 and buf_temp-disc.nonunique = v-nonunique
      863                 no-error .
      864       end.
      865       if not available buf_temp-disc then do:
      866         create buf_temp-disc .
      867         assign
      868         buf_temp-disc.host-code = p-host-code
      869         buf_temp-disc.obj-type = p-obj-type
      870         buf_temp-disc.obj-code = p-obj-code
      871         buf_temp-disc.rule-num = p-rule-num
      872         buf_temp-disc.action = p-action
      873         buf_temp-disc.pos-type = p-pos-type
      874         buf_temp-disc.discnt-role = p-discnt-role
      875         buf_temp-disc.cfg-nonunique = p-cfg-nonunique
      876         buf_temp-disc.rule-num = p-rule-num
      877         buf_temp-disc.nonunique = v-nonunique
      878         buf_temp-disc.time-templ-rl-root = p-time-templ-rl-root
      879         buf_temp-disc.templ-rl-root = p-templ-rl-root
      880         p-rec = recid(buf_temp-disc)
      881         no-error
      882         .
      883       end.
      884       ELSE do:
      885         if p-add then do:
      886            message
      887            substitute("Такая скидка уже добавлена&1"
      888                       ,chr(10)
      889                   )
      890            view-as alert-box error .
      891           undo, return error "not-set" .
      892         end.
      893         ASSIGN
      894         buf_temp-disc.rule-num = p-rule-num
      895         buf_temp-disc.nonunique = v-nonunique
      896         buf_temp-disc.time-templ-rl-root = p-time-templ-rl-root
      897         buf_temp-disc.templ-rl-root = p-templ-rl-root
      898         p-rec = recid(buf_temp-disc)
      899         no-error.
      900       end.
      901     end.
      902   end procedure.
      903   procedure temp-dsc-exist :
      904   define input parameter p-pos-type as character  no-undo .
      905   define input parameter p-templ-rl-root as integer  no-undo .
      906   define input parameter p-time-templ-rl-root as integer no-undo .
      907   define input parameter p-discnt-role as character  no-undo .
      908   define input parameter p-nonunique as character no-undo .
      909   define input parameter p-host-code as integer no-undo .
      910   define input parameter p-obj-type as character no-undo .
      911   define input parameter p-obj-code as integer no-undo .
      912   define output parameter p-exist    as logical no-undo .
      913   define output parameter p-action as logical no-undo .
      914   define variable v-discnt-role as character no-undo .
      915   define buffer buf_temp-disc for temp-disc .
      916     do
      917     on error undo, return error
      918     :
      919       case var-object:
      920         when 'dis-gds-rule':U then do:
      921           run discfgru-check  in this-procedure (
      922                                                   input 'dis-gds-rule':U
      923                                                  ,input p-templ-rl-root
      924                                                  ,input p-time-templ-rl-root
      925                                                  ,input p-pos-type
      926                                                  ,output v-discnt-role) no-error.
      927         end.
      928         when 'dis-dc-rule':U then do:
      929           run discfgru-check  in this-procedure (
      930                                                   input 'dis-dc-rule':U
      931                                                  ,input p-templ-rl-root
      932                                                  ,input p-time-templ-rl-root
      933                                                  ,input p-pos-type
      934                                                  ,output v-discnt-role) no-error.
      935         end.
      936         otherwise do:
      937           undo, return error .
      938         end.
      939       end case.
      940       if error-status :error
      941       then do:
      942         undo, return error return-value .
      943       end.
      944       find first buf_temp-disc no-lock where
      945                  buf_temp-disc.pos-type = p-pos-type
      946               and buf_temp-disc.discnt-role = p-discnt-role
      947               and buf_temp-disc.host-code = p-host-code
      948               and buf_temp-disc.obj-type = p-obj-type
      949               and buf_temp-disc.obj-code = p-obj-code
      950               and buf_temp-disc.nonunique = p-nonunique no-error .
      951       if available buf_temp-disc then do:
      952         P-EXIST = YES.
      953         p-action = buf_temp-disc.action.
      954       end.
      955     end.
      956   end procedure.
      957   procedure temp-dsc-delete :
      958   define input parameter p-pos-type as character  no-undo .
      959   define input parameter p-discnt-role as character no-undo .
      960   define input parameter p-nonunique as character no-undo .
      961   define input parameter p-host-code  as integer no-undo .
      962   define input parameter p-obj-type as character no-undo .
      963   define input parameter p-obj-code as integer no-undo .
      964   define input parameter p-action as logical no-undo .
      965   define output parameter p-deleted  as logical no-undo .
      966   define buffer buf_temp-disc for temp-disc .
      967     do
      968     on error undo, return error :
      969       case var-object:
      970         when 'dis-gds-rule':U
      971         then do:
      972           error-status:error = no.
      973         end.
      974         when 'dis-dc-rule':U
      975         then do:
      976           error-status:error = no.
      977         end.
      978         when 'dis-cp-rule':U
      979         then do:
      980           error-status:error = no.
      981         end.
      982         otherwise do:
      983           undo, return error .
      984         end.
      985       END CASE.
      986       if error-status :error then do:
      987         undo, return error return-value .
      988       end.
      989       find first buf_temp-disc exclusive-lock where
      990                  buf_temp-disc.pos-type = p-pos-type
      991              and buf_temp-disc.discnt-role = p-discnt-role
      992              and buf_temp-disc.host-code = p-host-code
      993              and buf_temp-disc.obj-type = p-obj-type
      994              and buf_temp-disc.obj-code = p-obj-code
      995              and buf_temp-disc.nonunique = p-nonunique
      996              and buf_temp-disc.action = p-action
      997              no-error .
      998       if not available buf_temp-disc then do:
      999         P-DELETED = NO.
     1000       end.
     1001       ELSE DO:
     1002          delete buf_temp-disc.
     1003          P-DELETED = YES.
     1004       END.
     1005     end.
     1006   end procedure.
     1007   define variable p-rid-list  as character              no-undo .
     1008   define variable v-no-ask      as logical   no-undo .
     1009   define variable v-view-log    as logical   no-undo .
     1010   define variable log-file-name as character no-undo init "csh-lst.txt".
     1011   define variable v-stop        as logical   no-undo .
     1012   define variable v-choice      as integer   no-undo .
     1013   define variable v-i           as integer   no-undo .
     1014   define variable v-err-cnt     as integer   no-undo init 0 .
     1015   define variable v-deleted     as logical   no-undo .
     1016   DEFINE VARIABLE num-rec       as integer no-undo .
     1017   DEFINE VARIABLE num-rec-ok    as integer no-undo .
     1018   define variable v-cdpay-code like ub.dis-cp-rule.cdpay-code no-undo .
     1019   define variable v-curr-code  like ub.dis-cp-rule.curr-code  no-undo .
     1020   define variable v-obj-name   as character no-undo .
     1021   define variable v-rule-num   as integer   no-undo .
     1022   define variable v-nonunique  as character no-undo .
     1023   def buffer buf_cash-pay    for ub.cash-pay .
     1024   def buffer buf_dis-cp-rule for ub.dis-cp-rule .
     1025   assign
     1026   p-rid-list = p-parameter
     1027   no-error
     1028   .
     1029   if error-status:error then do:
     1030    run write-log-and-file in p-log-handle (
     1031           input 1
     1032         , input log-file-name
     1033         , input 1
     1034         , input substitute("Ошибка входных параметров &1:&2&3&4"
     1035                            , p-parameter
     1036                            , chr(10)
     1037                            , error-status:get-message(1)
     1038                            , return-value
     1039                            )).
     1040     assign
     1041     v-view-log = yes.
     1042   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1043   if v-view-log
     1044   and not g#news
     1045   and not g#auto
     1046   then do:
     1047     message
     1048     '!!!При изменении скидок кассовых платежей на объекте по списку кассовых платежей произошли ошибки!!!'  skip
     1049     "!!!Внимательно прочитайте Log-file!!"
     1050     view-as alert-box error .
     1051        define variable v-user-action10   as character no-undo .
     1052     define variable v-printed10       as logical   no-undo .
     1053     run gbl/prnfilen.w
     1054       (input  ('!!!При изменении скидок кассовых платежей на объекте по списку кассовых платежей произошли ошибки!!!')
     1055       ,input  0
     1056       ,input  (string("./":U) + 'csh-lst.txt')
     1057       ,input  7
     1058       ,output v-user-action10
     1059       ,output v-printed10
     1060       ) .
     1061   end.
     1062   if v-view-log = true
     1063   and (g#news
     1064   or g#auto)
     1065   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     1066   then do:
     1067      run cb_set-view-log in p-parent-handle ( input yes).
     1068   end.
     1069   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     1070     OS-DELETE value(string("./":U) + 'csh-lst.txt').
     1071   end.
     1072     return.
     1073   end.
     1074   run write-log  in p-log-handle( input 0, "&DLine").
     1075   _rid-list:
     1076   do v-i = 1 to num-entries(p-rid-list) :
     1077       find first buf_cash-pay no-lock
     1078       where recid(buf_cash-pay) = int( entry( v-i, p-rid-list ) ) no-error .
     1079       if not avail buf_cash-pay then do:
     1080          v-err-cnt = v-err-cnt + 1.
     1081          run write-log-and-file in p-log-handle (
     1082              input 1
     1083            , input log-file-name
     1084            , input 1
     1085            , input substitute("Некорректный recid кассового платежа: &1", entry( v-i, p-rid-list ) ) ).
     1086          next _rid-list.
     1087       end.
     1088       assign
     1089         v-cdpay-code = buf_cash-pay.cdpay-code
     1090         v-curr-code  = buf_cash-pay.curr-code
     1091         v-obj-name   = buf_cash-pay.obj-name
     1092       .
     1093       _main:
     1094       do
     1095       on error undo, return error
     1096       :
     1097           _temp-disc:
     1098           for each temp-disc no-lock break by temp-disc.obj-code
     1099               on error undo _main, return error:
     1100               if first-of (temp-disc.obj-code) then do:
     1101                   run write-log-and-file in p-log-handle (
     1102                         input 1
     1103                       , input log-file-name
     1104                       , input 1
     1105                       , input substitute("Изменение скидок платежа &3 на объекте &1&2 по списку кассовых платежей", temp-disc.obj-type, temp-disc.obj-code, v-obj-name)).
     1106               end.
     1107               assign
     1108                  v-nonunique = temp-disc.nonunique
     1109                  v-rule-num  = temp-disc.rule-num
     1110               .
     1111               CASE temp-disc.action:
     1112               when yes then do:
     1113                   run discpru-write in this-procedure (
     1114                                            input v-cdpay-code
     1115                                           ,input v-curr-code
     1116                                           ,input temp-disc.host-code
     1117                                           ,input temp-disc.obj-type
     1118                                           ,input temp-disc.obj-code
     1119                                           ,input temp-disc.pos-type
     1120                                           ,input temp-disc.discnt-role
     1121                                           ,input temp-disc.templ-rl-root
     1122                                           ,input temp-disc.time-templ-rl-root
     1123                                           ,input v-rule-num
     1124                                           ,input v-nonunique
     1125                                         ) no-error .
     1126                   if error-status:error then do:
     1127                       assign
     1128                         num-rec = num-rec + 1
     1129                         v-err-cnt = v-err-cnt + 1
     1130                       .
     1131                       run write-log-and-file in p-log-handle (
     1132                            input 1
     1133                          , input log-file-name
     1134                          , input 1
     1135                          , input substitute("Не удалось привязать скидку по платежу &7 на объекте &1&2: &3&4&5&6&4&8"
     1136                                           , temp-disc.obj-type
     1137                                           , temp-disc.obj-code
     1138                                           , entry( v-i, p-rid-list )
     1139                                           , chr(10)
     1140                                           , error-status:get-message(1)
     1141                                           , return-value
     1142                                           , v-obj-name
     1143                                           , temp-disc.label_
     1144                                            ) ).
     1145                       next _temp-disc .
     1146                   end.
     1147                   else do:
     1148                       assign
     1149                         num-rec = num-rec + 1
     1150                         num-rec-ok = num-rec-ok + 1
     1151                       .
     1152                   end.
     1153                   run show-counter in p-log-handle .
     1154                   run write-counter in p-log-handle (substitute("Обработано изменений &1 из них успешно &2"
     1155                                                               , num-rec
     1156                                                               , num-rec-ok
     1157                                                               )) no-error.
     1158                   run get-stop-state in p-log-handle ( output v-stop ).
     1159                   if v-stop then do:
     1160                     leave _rid-list.
     1161                   end.
     1162               end.
     1163               when no then do:
     1164                   run discpru-delete_m in this-procedure (
     1165                                            input v-cdpay-code
     1166                                           ,input v-curr-code
     1167                                           ,input temp-disc.host-code
     1168                                           ,input temp-disc.obj-type
     1169                                           ,input temp-disc.obj-code
     1170                                           ,input temp-disc.pos-type
     1171                                           ,input temp-disc.discnt-role
     1172                                           ,input v-nonunique
     1173                                           ,input temp-disc.rule-num
     1174                                           ,output v-deleted
     1175                                         ) no-error .
     1176                   if error-status:error or not v-deleted then do:
     1177                       assign
     1178                         num-rec = num-rec + 1
     1179                         v-err-cnt = v-err-cnt + 1
     1180                       .
     1181                       run write-log-and-file in p-log-handle (
     1182                            input 1
     1183                          , input log-file-name
     1184                          , input 1
     1185                          , input substitute("Не удалось удалить скидку по платежу &7 на объекте &1&2: &3&4&5&6&4&8"
     1186                                           , temp-disc.obj-type
     1187                                           , temp-disc.obj-code
     1188                                           , entry( v-i, p-rid-list )
     1189                                           , chr(10)
     1190                                           , error-status:get-message(1)
     1191                                           , return-value
     1192                                           , v-obj-name
     1193                                           , temp-disc.label_
     1194                                            ) ).
     1195                       next _temp-disc .
     1196                   end.
     1197                   else do:
     1198                       assign
     1199                         num-rec = num-rec + 1
     1200                         num-rec-ok = num-rec-ok + 1
     1201                       .
     1202                   end.
     1203                   run show-counter in p-log-handle .
     1204                   run write-counter in p-log-handle (substitute("Обработано изменений &1 из них успешно &2"
     1205                                                               , num-rec
     1206                                                               , num-rec-ok
     1207                                                               )) no-error.
     1208                   run get-stop-state in p-log-handle ( output v-stop ).
     1209                   if v-stop then do:
     1210                     leave _rid-list.
     1211                   end.
     1212               end.
     1213               END CASE.
     1214           end.
     1215       end.
     1216   end.
     1217   run write-log-and-file in p-log-handle (
     1218       input 1
     1219     , input log-file-name
     1220     , input 1
     1221     , input substitute("Пакетное изменение скидок по списку завершено: из &1 успешно изменено &2", num-rec, num-rec-ok )).
     1222   .
     1223   procedure discpru-delete_m :
     1224   define input parameter p-cdpay-code     like ub.dis-cp-rule.cdpay-code  no-undo .
     1225   define input parameter p-curr-code      like ub.dis-cp-rule.curr-code  no-undo .
     1226   define input parameter p-host-code      like ub.dis-cp-rule.host-code   no-undo .
     1227   define input parameter p-obj-type       like ub.dis-cp-rule.obj-type   no-undo .
     1228   define input parameter p-obj-code       like ub.dis-cp-rule.obj-code   no-undo .
     1229   define input parameter p-pos-type       like ub.dis-cp-rule.pos-type   no-undo .
     1230   define input parameter p-discnt-role    like ub.dis-cp-rule.discnt-role no-undo .
     1231   define input parameter p-nonunique      like ub.dis-cp-rule.nonunique   no-undo .
     1232   define input parameter p-rule-num       like ub.dis-cp-rule.rule-num   no-undo .
     1233   define output parameter p-deleted       as logical no-undo .
     1234   define variable v-rule-label as character no-undo .
     1235   define buffer buf_dis-cp-rule for ub.dis-cp-rule.
     1236   DO
     1237   on error undo, return error
     1238   :
     1239   if not ( p-rule-num = ? or p-rule-num = 0 ) then do:
     1240       find first buf_dis-cp-rule exclusive-lock
     1241       where buf_dis-cp-rule.rule-num = p-rule-num no-error.
     1242       if not available buf_dis-cp-rule then do:
     1243         return '':U.
     1244       end.
     1245       delete buf_dis-cp-rule no-error.
     1246       if error-status:error then do:
     1247         run discpru-name in this-procedure
     1248           (input  buf_dis-cp-rule.templ-rl-root
     1249           ,output v-rule-label
     1250           ) no-error .
     1251             undo, return error substitute("Ошибка при удалении скидки по типу касс. платежа:&1" +
     1252                                      "скидка &2 (POS &3) на фирме &4 &5&6 для платежа&1&7&1&8"
     1253                                       ,chr(10)
     1254                                       ,v-rule-label
     1255                                       ,p-pos-type
     1256                                       ,p-host-code
     1257                                       ,p-obj-type
     1258                                       ,p-obj-code
     1259                                       ,error-status:get-message(1)
     1260                                       ,return-value ).
     1261       end.
     1262   end.
     1263   else do:
     1264       find first buf_dis-cp-rule no-lock
     1265       where buf_dis-cp-rule.cdpay-code  = p-cdpay-code
     1266         and buf_dis-cp-rule.curr-code   = p-curr-code
     1267         and buf_dis-cp-rule.obj-type    = p-obj-type
     1268         and buf_dis-cp-rule.host-code   = p-host-code
     1269         and buf_dis-cp-rule.obj-code    = p-obj-code
     1270         and buf_dis-cp-rule.pos-type    = p-pos-type
     1271         and buf_dis-cp-rule.discnt-role = p-discnt-role
     1272         and buf_dis-cp-rule.nonunique   = p-nonunique no-error.
     1273       if not available buf_dis-cp-rule then do:
     1274         return '':U.
     1275       end.
     1276       for each buf_dis-cp-rule exclusive-lock
     1277       where buf_dis-cp-rule.cdpay-code  = p-cdpay-code
     1278         and buf_dis-cp-rule.curr-code   = p-curr-code
     1279         and buf_dis-cp-rule.obj-type    = p-obj-type
     1280         and buf_dis-cp-rule.host-code   = p-host-code
     1281         and buf_dis-cp-rule.obj-code    = p-obj-code
     1282         and buf_dis-cp-rule.pos-type    = p-pos-type
     1283         and buf_dis-cp-rule.discnt-role = p-discnt-role
     1284         and buf_dis-cp-rule.nonunique   = p-nonunique
     1285       :
     1286           delete buf_dis-cp-rule no-error.
     1287           if error-status:error then do:
     1288               run discpru-name in this-procedure (
     1289                    input  buf_dis-cp-rule.templ-rl-root
     1290                   ,output v-rule-label
     1291               ) no-error .
     1292                           undo, return error substitute("Ошибка при удалении скидки по типу касс. платежа:&1" +
     1293                                             "скидка &2 (POS &3) на фирме &4 &5&6 для платежа&1&7&1&8"
     1294                                             ,chr(10)
     1295                                             ,v-rule-label
     1296                                             ,p-pos-type
     1297                                             ,p-host-code
     1298                                             ,p-obj-type
     1299                                             ,p-obj-code
     1300                                             ,error-status:get-message(1)
     1301                                             ,return-value ).
     1302           end.
     1303       end.
     1304   end.
     1305   p-deleted = yes.
     1306   return '':U.
     1307   END.
     1308   end procedure.
