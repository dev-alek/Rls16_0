       92   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       94   define temp-table temp-drt-prop no-undo like ub.drt-prop.
       95   procedure disrules-fill-properties:
       96   define input  parameter p-templ-rl-root as integer   no-undo .
       97   define buffer buf_drt-prop for ub.drt-prop.
       98   define buffer buf_temp-drt-prop for temp-drt-prop.
       99   do
      100   on error undo, return error return-value
      101   :
      102     for each buf_temp-drt-prop:
      103       delete buf_temp-drt-prop.
      104     end.
      105     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      106       create buf_temp-drt-prop.
      107       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      108     end.
