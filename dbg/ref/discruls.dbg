        1   DEFINE BUFFER X_c-dis-rule FOR ub.c-dis-rule.
        2   DEFINE BUFFER X_curr_clients FOR ub.clients.
        3   DEFINE BUFFER X_upper-dis-rule FOR ub.dis-rule.
        4   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        5   define input parameter bttns  as char   no-undo .
        6   define input parameter p-mode  as char   no-undo .
        7   define input parameter p-rule-num like ub.dis-rule.rule-num no-undo .
        8   define input parameter p-upper-rule-num like ub.dis-rule.upper-rule-num no-undo .
        9   define input parameter p-obj-type like ub.clients.obj-type no-undo.
       10   define input parameter p-obj-code like ub.clients.obj-code no-undo.
       11   define input-output param p-rid-list    as  char no-undo .
       12   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       13   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       14   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       15   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       16   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       17   define variable vss-description AS CHAR NO-UNDO INIT "Список истории ПРАВИЛ СКИДОК":U.
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   procedure proc-alt-shift-f2:
       88     if not ibs.th.gbl.gbl-var:rcode
       89   then
       90     run gbl\inidebug.p .
       91   end.
       92   procedure proc-alt-shift-f3:
       93     run gbl/prvssinf.p
       94       ( input this-procedure
       95       ) .
       96   end.
       97   define variable v-inform-launched as logical no-undo initial false .
       98   procedure proc-alt-shift-f4:
       99     define variable v-action as character no-undo .
      100     if v-inform-launched = false then do:
      101       assign
      102         v-inform-launched = true
      103       .
      104       run gbl/d-inform.w
      105         (  input self
      106         ,  input this-procedure
      107         , output v-action
      108         ) no-error .
      109       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      110       assign
      111         v-inform-launched = false
      112       .
      113     end.
      114   end.
      115   procedure proc-alt-f1:
      116     run gbl/corrhelp.p
      117       (input this-procedure
      118       ) .
      119   end .
      120   on alt-shift-f2 anywhere do:
      121     run proc-alt-shift-f2.
      122   end.
      123   on alt-shift-f3 anywhere do:
      124     run proc-alt-shift-f3 in this-procedure .
      125   end.
      126   on alt-shift-f4 anywhere do:
      127     run proc-alt-shift-f4 in this-procedure.
      128   end.
      129   on alt-f1 anywhere do:
      130     run proc-alt-f1 in this-procedure .
      131   end.
      132   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      134   define new shared variable RepPathName        as character no-undo .
      135   define new shared variable PrintRubl          as logical   no-undo .
      136   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      137   define variable v-waitfram-action01         as character   no-undo .
      138   define variable v-waitfram-action02         as character   no-undo .
      139   define variable v-waitfram-action03         as character   no-undo .
      140   define variable mWaitFramTextBeg            as character   no-undo.
      141   define variable mWaitFramTextEnd            as character   no-undo.
      142   define variable mWaitFramView               as logical     no-undo.
      143   define variable mWaitProcEvent              as logical     no-undo init yes.
      144   define variable mWaitFramInterval           as integer     no-undo init 1 .
      145   define variable mWaitFramStop               as logical     no-undo.
      146   define variable mWaitFramStopUser           as logical     no-undo.
      147   define variable mWaitFramStopTimeOut        as logical     no-undo.
      148   define variable mWaitFramStartProc          as datetime-tz no-undo.
      149   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      150   define button B-WaitFramStop auto-end-key
      151        label "Стоп"
      152        size 10 by 1 tooltip "Остоновить процесс".
      153   define button B-viewProcInfo
      154        label "Информация"
      155        size 15 by 1 tooltip "Информация о процесс".
      156   define frame waitfram
      157     v-waitfram-action01 format "x(72)" no-label skip
      158     v-waitfram-action02 format "x(72)" no-label skip
      159     v-waitfram-action03 format "x(72)" no-label skip
      160     B-viewProcInfo
      161     B-WaitFramStop at row 4 col 30
      162     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      163     .
      164   define new global shared variable mBatchMode as logical no-undo init ?.
      165   define variable mFramBachModHandle as handle no-undo.
      166   mFramBachModHandle = frame waitfram:handle.
      167   define variable mFameOldVis as logical no-undo.
      168   define variable mVisCUrentVin as logical no-undo.
      169   if session:batch-mode
      170   then
      171      mBatchMode = yes.
      172   if mBatchMode = ? then do:
      173     mVisCUrentVin = current-window:visible.
      174     mFameOldVis = mFramBachModHandle:visible.
      175     mFramBachModHandle:visible  = yes.
      176     mBatchMode = mFramBachModHandle:visible ne yes.
      177     mFramBachModHandle:visible = mFameOldVis.
      178     current-window:visible = mVisCUrentVin.
      179   end.
      180    if  log-manager:logfile-name ne ?
      181     then DO:
      182         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      183         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      184         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      185     end.
      186   on choose of B-WaitFramStop in frame waitfram
      187   do:
      188     mWaitFramStop = yes.
      189     mWaitFramStopUser = yes.
      190   end.
      191   function waitfram-check-timeout returns logical():
      192      define variable vtime as int64 no-undo.
      193      if mWaitFramStopTimeOut
      194      then
      195         return yes.
      196      vtime = ( now - mWaitFramStartProc ) / 1000 .
      197      if     mWaitFramTimeOut ne ?
      198         and mWaitFramTimeOut ne 0
      199         and mWaitFramTimeOut lt vtime
      200      then do:
      201         mWaitFramStopTimeOut = yes.
      202      end.
      203      return mWaitFramStopTimeOut.
      204   end.
      205   procedure waitfram-hide :
      206     if not session:batch-mode
      207     then do
      208     on error undo, return error return-value
      209     :
      210       pause 0 before-hide .
      211       if not mBatchMode then
      212         hide frame waitfram .
      213     if     not mWaitFramView
      214        and mWaitProcEvent
      215     then
      216       process events .
      217     end.
      218   end procedure.
      219   procedure waitfram-show :
      220     define input  parameter p-message as character no-undo .
      221     define variable v-left-margin as integer   no-undo .
      222     if not session:batch-mode
      223     then do
      224     on error undo, return error return-value
      225     :
      226       if length(p-message) <= 70 then do:
      227         assign
      228           v-left-margin = integer((70 - length(p-message)) / 2)
      229         .
      230         assign
      231           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      232         .
      233         assign
      234           v-waitfram-action01 = " "
      235           v-waitfram-action02 = " "
      236                                    + fill(" ", v-left-margin)
      237                                    + p-message
      238           v-waitfram-action03 = " "
      239         .
      240       end.
      241       else do:
      242         define variable vRindex1 as integer no-undo.
      243         define variable vRindex2 as integer no-undo.
      244         vRindex1 = r-index(p-message," ",70).
      245         if vRindex1 = 0
      246         then
      247            vRindex1 = 70.
      248         if length(p-message)  <= vRindex1 + 70 then do:
      249           assign
      250             v-waitfram-action01 = " "
      251             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      252             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      253           .
      254         end.
      255         else do:
      256           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      257           if vRindex2 <= vRindex1
      258           then
      259              vRindex2 = vRindex1 + 70.
      260           assign
      261             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      262             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      263             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      264           .
      265         end.
      266       end.
      267       B-viewProcInfo:visible   in frame waitfram = no.
      268       B-viewProcInfo:sensitive in frame waitfram = no.
      269       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      270       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      271       if  (   mWaitFramView
      272          or  mWaitProcEvent)
      273          and not mBatchMode
      274       then
      275          display
      276             v-waitfram-action01 skip
      277             v-waitfram-action02 skip
      278             v-waitfram-action03 skip
      279          with frame waitfram .
      280       if     mWaitFramView
      281          then do:
      282             if     mWaitFramInterval ne ?
      283                and not mBatchMode
      284             then
      285                wait-for go of frame waitfram pause mWaitFramInterval.
      286          end.
      287          else
      288             if     mWaitProcEvent
      289                and not mBatchMode
      290             then
      291                process events .
      292     end.
      293   end procedure.
      294      procedure waitfram-show-this:
      295         define input  parameter iInterval as int64 no-undo.
      296         define variable vtime as int64 no-undo.
      297         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      298         mWaitFramInterval = iInterval.
      299         run waitfram-show (substitute("&1&2 &3&4" ,
      300                                       mWaitFramTextBeg ,
      301                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      302                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      303                                       mWaitFramTextEnd
      304                                      )
      305                           ).
      306      end.
      307      procedure WaitFramRunPause:
      308         define input  parameter iInterval as dec no-undo.
      309         define variable vStart  as datetime-tz no-undo.
      310         define variable vend    as datetime-tz no-undo.
      311         define variable vint as int64 no-undo.
      312         define variable vOk as logical no-undo.
      313         vStart = now.
      314         vend   = vStart.
      315         publish "WaitFramPause" (iInterval,output vOk).
      316         vend   =  now.
      317         vint = vend - vStart.
      318         vint = iInterval - vint / 1000.
      319         if     not mWaitFramStop
      320            and (   vint > 0
      321                 or (    not vOk
      322                     and iInterval eq ?
      323                     )
      324                 )
      325         then
      326            run waitfram-show-this (iInterval).
      327         vend   =  now.
      328         vint = vend - vStart.
      329         vint = iInterval - vint / 1000.
      330         if     not mWaitFramStop
      331            and vint > 0
      332         then do:
      333            run gbl/pause.p (vint * 1000).
      334         end.
      335         if iInterval ne ?
      336         then
      337            publish "WaitFramStop".
      338         waitfram-check-timeout().
      339      end.
      340      procedure WaitFramWaitFor:
      341         define input  parameter iInterval as dec no-undo.
      342         assign
      343            mWaitFramStartProc   = now
      344            mWaitFramStopUser    = no
      345            mWaitFramStopTimeOut = no
      346         .
      347         block-wait:
      348         do while not mWaitFramStop:
      349            run WaitFramRunPause (iInterval).
      350            if  waitfram-check-timeout()
      351            then do:
      352               leave block-wait.
      353            end.
      354         end.
      355         run waitfram-hide.
      356      end.
      357   procedure waitfram-join :
      358     define input  parameter p-line-1  as character no-undo .
      359     define input  parameter p-line-2  as character no-undo .
      360     define input  parameter p-line-3  as character no-undo .
      361     define output parameter p-message as character no-undo .
      362     do
      363     on error undo, return error return-value
      364     :
      365       assign
      366         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      367                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      368                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      369       .
      370     end.
      371   end procedure.
      372   function waitfram-join-function returns character
      373     (input p-line-1 as character
      374     ,input p-line-2 as character
      375     ,input p-line-3 as character
      376     ).
      377     define variable v-message as character no-undo .
      378     run waitfram-join in this-procedure
      379       (input  p-line-1
      380       ,input  p-line-2
      381       ,input  p-line-3
      382       ,output v-message
      383       ) .
      384     return v-message .
      385   end function .
      386   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      387   define  stream PrnLibStream.
      388   procedure prn-lib-prn-file :
      389     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      390     define input parameter p-DIsabledoptions as integer no-undo .
      391     define variable v-report-name as character no-undo .
      392     define variable v-user-action as character no-undo .
      393     define variable v-printed     as logical   no-undo .
      394     define variable v-exist       as logical   no-undo .
      395     do
      396       on error undo, return error
      397       :
      398       run prn-lib-get-report-name  in this-procedure (
      399         input parParentProc
      400         ,output v-report-name
      401         ).
      402   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      403   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      404     (input  v-report-name
      405     ,input  2
      406     ,output v-exist
      407     )  .
      408       if NOT v-exist then
      409       DO:
      410         Message
      411           "Нет заданий на печать ! "
      412           view-as alert-box .
      413         Return  .
      414       End.
      415       run gbl/prnfilen.w
      416         (input  ""
      417         ,input  p-DisabledOptions
      418         ,input  string(v-report-name )
      419         ,input  7
      420         ,output v-user-action
      421         ,output v-printed
      422         ) .
      423       if v-printed then
      424       do:
      425         return "YES" .
      426       end.
      427       else
      428       do:
      429         return "NO" .
      430       end.
      431     end.
      432   end procedure.
      433   procedure prn-lib-open-stream :
      434     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      435     define input parameter p-page-size    as integer no-undo .
      436     define input parameter p-is-stream    as logical no-undo .
      437     define input parameter p-append       as logical no-undo .
      438     define variable v-report-name as character no-undo .
      439     do
      440       on error undo, return error
      441       :
      442       run prn-lib-get-report-name  in this-procedure (
      443         input parParentProc
      444         ,output v-report-name
      445         ).
      446       if p-is-stream then
      447       do:
      448         if p-append then
      449         do:
      450           output stream PrnLibStream to value( v-report-name )
      451             page-size value(p-page-size) append .
      452         end.
      453         if not p-append then
      454         do:
      455           output stream PrnLibStream to value( v-report-name )
      456             page-size value(p-page-size) .
      457         end.
      458       end.
      459       if not p-is-stream then
      460       do:
      461         if p-append then
      462         do:
      463           output to value( v-report-name )
      464             page-size value(p-page-size) append .
      465         end.
      466         if not p-append then
      467         do:
      468           output to value( v-report-name )
      469             page-size value(p-page-size) .
      470         end.
      471       end.
      472     end.
      473   end procedure.
      474   procedure prn-lib-open-exp :
      475     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      476     define input parameter p-is-stream    as logical no-undo .
      477     define input parameter p-is-append    as logical no-undo .
      478     define output parameter p-ReportFileName as char init "report" no-undo.
      479     define output parameter p-process as logical no-undo .
      480     define variable glog as logical no-undo .
      481     do
      482       on error undo, return error
      483       :
      484       SYSTEM-DIALOG GET-FILE p-ReportFileName
      485         TITLE      "Укажите путь"
      486         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      487         ASK-OVERWRITE
      488         CREATE-TEST-FILE
      489         SAVE-AS
      490         USE-FILENAME
      491         DEFAULT-EXTENSION "txt"
      492         UPDATE glog
      493         .
      494       if not glog then  return.
      495       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      496       if p-is-stream then
      497       do:
      498         if p-is-append then
      499         do:
      500           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      501         end.
      502         else
      503         do:
      504           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      505         end.
      506       end.
      507       else
      508       do:
      509         if p-is-append then
      510         do:
      511           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      512         end.
      513         else
      514         do:
      515           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      516         end.
      517       end.
      518       p-process = yes.
      519     end.
      520   end procedure.
      521   procedure prn-lib-get-report-name :
      522     define input parameter parParentProc  as widget-handle no-undo.
      523     define output parameter p-report-name as character no-undo .
      524     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      525   end procedure.
      526   procedure prn-lib-reportviewer-report-name :
      527     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
