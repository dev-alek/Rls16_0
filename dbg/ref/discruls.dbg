     2955   PROCEDURE sort-brbr-c-dis-rule :
     2956     define input parameter p-recid as recid no-undo .
     2957     if re-querybr-c-dis-rule = no then do:
     2958       assign
     2959          cur-clmnbr-c-dis-rule = br-c-dis-rule:current-column in frame Dialog-Frame
     2960       .
     2961       if sort-clmnbr-c-dis-rule <> ? then sort-clmnbr-c-dis-rule:column-fgcolor = 0.
     2962       if cur-clmnbr-c-dis-rule = sort-clmnbr-c-dis-rule then do:
     2963         assign
     2964            sort-labelbr-c-dis-rule = ""
     2965            sort-clmnbr-c-dis-rule = ?
     2966         .
     2967        end.
     2968        else do:
     2969          assign
     2970            sort-labelbr-c-dis-rule = cur-clmnbr-c-dis-rule:label
     2971            sort-clmnbr-c-dis-rule  = cur-clmnbr-c-dis-rule
     2972            sort-clmnbr-c-dis-rule:column-fgcolor = 4
     2973          .
     2974        end.
     2975      end.
     2976     assign
     2977       cur-clmn-locbr-c-dis-rule = 1
     2978     .
     2979     def var column-handle as handle no-undo .
     2980     column-handle = br-c-dis-rule:first-column.
     2981     do while valid-handle(column-handle) :
     2982       if column-handle = cur-clmnbr-c-dis-rule then do:
     2983         leave .
     2984       end.
     2985       column-handle = column-handle:NEXT-COLUMN.
     2986       assign
     2987         cur-clmn-locbr-c-dis-rule = cur-clmn-locbr-c-dis-rule + 1
     2988       .
     2989     end.
     2990     case sort-labelbr-c-dis-rule:
     2991           when X_c-dis-rule.rule-num:label in browse br-c-dis-rule then DO:    assign       sort-column-name = "X_c-dis-rule.rule-num"     .     run OpenBr in this-procedure ( input YES, input NO, input NO).   . END.
     2992       otherwise do:
     2993         assign
     2994           sort-column-name = ""
     2995         .
     2996         run OpenBr in this-procedure ( input YES, input NO, input NO).
     2997           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-c-dis-rule') then do:
     2998             run mv-brw-defaultbr-c-dis-rule.
     2999           end.
     3000         if sort-labelbr-c-dis-rule <> "" then do:
     3001           assign
     3002             cur-clmnbr-c-dis-rule:column-fgcolor = 0
     3003           .
     3004         end.
     3005         assign
     3006           cur-clmn-locbr-c-dis-rule = ?
     3007         .
     3008       end.
     3009     end case.
     3010       if cur-clmn-locbr-c-dis-rule <> ? then do:
     3011         if can-do( this-procedure:internal-entries, 'ch-clmnbr-c-dis-rule') then do:
     3012           run ch-clmnbr-c-dis-rule in this-procedure (cur-clmn-locbr-c-dis-rule).
     3013         end.
     3014       end.
     3015     if p-recid <> ? then do:
     3016       reposition br-c-dis-rule to recid p-recid no-error.
     3017       apply "value-changed" to br-c-dis-rule in frame Dialog-Frame.
     3018     end.
     3019     apply "entry" to br-c-dis-rule in frame Dialog-Frame.
     3020   END PROCEDURE.
     3021   procedure re-open-query-srt-clmnbr-c-dis-rule:
     3022   if cur-clmnbr-c-dis-rule = ? then do:
