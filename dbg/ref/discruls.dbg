     3060   MAIN-BLOCK:
     3061   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3062      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3063    if LOOKUP(p-mode, ('все':U + chr(4) +
     3064                      "upper-rule-num":U + chr(4) +
     3065                      "one":U + chr(4) +
     3066                      'объект':U + chr(4) +
     3067                      "rl-root":U),
     3068                   chr(4)) = 0
     3069        then dO:
     3070       message
     3071       vss-workfile vss-revision vss-description skip
     3072       "Неверное значение параметров вызова p-mode"
     3073       p-mode
     3074       view-as alert-box ERROR.
     3075       return error .
     3076    end.
     3077     if p-mode = "upper-rule-num" then do:
     3078      find first X_upper-dis-rule no-lock where
     3079             X_upper-dis-rule.rule-num = p-upper-rule-num no-error.
     3080      if not available X_upper-dis-rule then do:
     3081       message
     3082       vss-workfile vss-revision vss-description skip
     3083       "Неверное значение параметров вызова p-upper-rule-num"
     3084       p-upper-rule-num
     3085       view-as alert-box ERROR.
     3086       return error .
     3087      end.
     3088     end.
     3089     if p-mode = "one" then do:
     3090      find first X_dis-rule no-lock where
     3091             X_dis-rule.rule-num = p-rule-num no-error.
     3092      if not available X_dis-rule then do:
     3093       message
     3094       vss-workfile vss-revision vss-description skip
     3095       "Неверное значение параметров вызова p-rule-num"
     3096       p-upper-rule-num
     3097       view-as alert-box ERROR.
     3098       return error .
     3099      end.
     3100     end.
     3101    if p-mode = 'объект':U then do:
     3102     find first X_curr_clients no-lock where
     3103               X_curr_clients.obj-type = p-obj-type
     3104          AND X_curr_clients.obj-code = p-obj-code no-error.
     3105     if not available X_curr_clients then do:
     3106       message
     3107       vss-workfile vss-revision vss-description skip
     3108       "Неверное значение параметра вызова p-obj-type p-obj-code"
     3109       p-obj-type p-obj-code
     3110       view-as alert-box ERROR.
     3111       return error .
     3112     end.
     3113   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3114   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3115     (input  p-obj-type
