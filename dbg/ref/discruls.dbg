     3315       l-filter-open-28 = false
     3316     .
     3317     if flt-rec-28 <> ?
     3318       or sort-column-phrase > ""
     3319     then do:
     3320       define variable  parameter-2-28 as character no-undo .
     3321       define variable  parameter-3-28 as character no-undo .
     3322       define variable  parameter-4-28 as character no-undo .
     3323       define variable  parameter-5-28 as character no-undo .
