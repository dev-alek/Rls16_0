     4212             if ("           X_c-dis-rule.rule-num  = p-rule-num        AND X_c-dis-rule.host-code = 0       OR  (X_c-dis-rule.host-code = v-host-code       and X_c-dis-rule.obj-type = '':U       and X_c-dis-rule.obj-code = 0)        OR  (X_c-dis-rule.host-code = v-host-code       and X_c-dis-rule.obj-type = p-obj-type       and X_c-dis-rule.obj-code = p-obj-code)                        " + " " + where-phrase-36) <> ""
     4213             then  substitute(' X_c-dis-rule.rule-num  = &1        AND X_c-dis-rule.host-code = 0       OR  (X_c-dis-rule.host-code = &2       and X_c-dis-rule.obj-type = &3&3       and X_c-dis-rule.obj-code = 0)        OR  (X_c-dis-rule.host-code = &2       and X_c-dis-rule.obj-type = &3&4&3       and X_c-dis-rule.obj-code = &5) ', p-rule-num, v-host-code, chr(34), p-obj-type, p-obj-code)   + " " + where-phrase-36
     4214             else "true"
     4215           )
     4216         parameter-5-36 = (" " + "" + " " + "" + " " + p-find-condition)
     4217         parameter-6-36 = if sort-phrase-36 = ''
     4218                              then
     4219           (
     4220           " " + "  " +
     4221             " " + sort-column-phrase +
     4222           " " + "  "
     4223           )
     4224                              else
     4225           (
     4226           " " + "  " +
     4227             " " + sort-column-phrase +
     4228           " " + sort-phrase-36
     4229           )
     4230         parameter-7-36 =
     4231           " indexed-reposition  "
     4232       .
     4233         run fltopend_fltfindq in this-procedure  (
     4234                             input this-procedure:handle
     4235                             ,input QUERY br-c-dis-rule:handle
     4236                             ,input logical(parameter-2-36)
     4237                             ,input no-lock
     4238                             ,input parameter-3-36
     4239                             ,input parameter-4-36
     4240                             ,input parameter-5-36
     4241                             ,input parameter-6-36
     4242                             ,input parameter-7-36
     4243                             ,output v-fltopend-rowid
     4244                             ) no-error.
     4245         .
     4246         v-doc-rec = ?.
     4247       end.
     4248       assign
     4249         l-query-was-opened = true
     4250       .
     4251     end.
     4252   end.
     4253     run waitfram-hide in this-procedure .
     4254       END.
     4255   END CASE.
     4256   if not p-open-query then
     4257   REPOSITION br-c-dis-rule to recid v-doc-rec No-ERROR.
     4258   if not p-open-query and v-fltopend-rowid[1] <> ? then
     4259   query br-c-dis-rule:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     4260   run waitfram-hide in this-procedure.
     4261   APPLY "VALUE-CHANGED" TO br-c-dis-rule in frame Dialog-Frame.
     4262   APPLY "ENTRY" TO br-c-dis-rule.
     4263   END PROCEDURE.
     4264   PROCEDURE proc-b-sch :
     4265   assign
     4266     tbl = 'c-dis-rule'
     4267     join-tbl = 'X_c-dis-rule'
     4268     fld = ""
     4269     lab = ""
     4270     spr = ""
     4271     dim = '0'
     4272     .
     4273   run fltfield-add in this-procedure('des', 'Описание правила скидок', '',
     4274   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4275   run fltfield-add in this-procedure('templ-rl-root', 'Номер типа(шаблона) правила', '',
     4276   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4277   if p-mode <> "one" then do:
     4278     run fltfield-add in this-procedure('rule-num', 'Номер правила', '',
     4279     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4280   end.
     4281   run fltfield-add in this-procedure('host-code', 'Фирма', 'cli',
     4282   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4283   run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', 'cli',
     4284   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4285   run fltfield-add in this-procedure('discnt-value', 'Значение скидки', '',
     4286   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4287   run fltfield-add in this-procedure('corr-date', '', '',
     4288   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4289   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     4290   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4291   run fltfield-add in this-procedure('corr-user-db-num', '', '',
     4292   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4293   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     4294   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4295   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     4296   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4297   run fltfield-add in this-procedure('is-news', 'СПН', '',
     4298   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4299   Filter-Block:
     4300   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4301       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4302       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4303     run gbl/filter.w ( INPUT parparentproc
     4304                      , INPUT (filter-point + chr(4) + filter-label)
     4305                      , INPUT tbl
     4306                      , INPUT join-tbl
     4307                      , INPUT fld
     4308                      , INPUT lab
     4309                      , INPUT spr
     4310                      , INPUT dim ).
     4311     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     4312   END.
     4313   END PROCEDURE.
     4314   PROCEDURE proc-br-c-dis-rule :
     4315   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4316   if b-sel:sensitive in frame Dialog-Frame then dO:
     4317       if b-mark:sensitive then do:
     4318           apply "choose" to b-mark in frame Dialog-Frame.
     4319       end.
     4320       else do:
     4321           apply "choose" to b-sel in frame Dialog-Frame.
     4322       end.
     4323   end.
     4324   else do:
     4325       if b-lookup:sensitive then
     4326       apply "choose" to b-lookup in frame Dialog-Frame.
     4327   end.
     4328   END PROCEDURE.
     4329   PROCEDURE proc-view-changes :
     4330   define buffer new_c-dis-rule for ub.c-dis-rule.
     4331   define buffer current_dis-rule for ub.dis-rule.
     4332   define variable v-chg-fields as character no-undo.
     4333   define variable v-old-fields as character no-undo.
     4334   define variable v-new-fields as character no-undo.
     4335   define variable ii as integer no-undo.
     4336   define variable v-is-created as logical no-undo .
     4337   define variable v-is-deleted as logical no-undo .
     4338   define variable jj as integer no-undo .
     4339   define variable v-field-name as character no-undo .
     4340   define variable v-field-label as character no-undo .
     4341   define variable v-field-function as character no-undo .
     4342   define variable  v-des               like ub.dis-rule.des               no-undo .
     4343   define variable  v-level-1           as character no-undo .
     4344   define variable  v-level-2           as character no-undo .
     4345   define variable  v-discnt-type       like ub.dis-rule.discnt-type       no-undo .
     4346   define variable  v-subject-type      like ub.dis-rule.subject-type      no-undo .
     4347   define variable  v-value-type        like ub.dis-rule.value-type        no-undo .
     4348   define variable  v-global            as integer no-undo .
     4349   define variable  v-host              as integer no-undo .
     4350   define variable  v-object            as integer no-undo .
     4351   define variable  v-output-display    as logical   no-undo .
     4352   define variable  v-tree              as character no-undo .
     4353   define variable  v-other             as character no-undo .
     4354   define variable v-using-fields as character no-undo .
     4355   define variable v-fields-name-list as character no-undo .
     4356   define variable v-fields-label-list as character no-undo .
     4357   define variable v-fields-function-list as character no-undo .
     4358   define buffer buf_temp-drt-prop for temp-drt-prop.
     4359   for each temp-changes:
     4360       delete temp-changes.
     4361   END.
     4362   if not available X_c-dis-rule then do:
     4363     Open QUery br-changes for each temp-changes.
     4364     return.
     4365   end.
     4366   assign
     4367   v-is-created = X_c-dis-rule.action = integer('1':U)
     4368   v-is-deleted = X_c-dis-rule.action = integer('99':U)
     4369   .
     4370   run dr-code in this-procedure ( input X_c-dis-rule.templ-rl-root
     4371                                 ,output v-des
     4372                                 ,output v-discnt-type
     4373                                 ,output v-subject-type
     4374                                 ,output v-value-type
     4375                                 ,output v-level-1
     4376                                 ,output v-level-2
     4377                                 ,output v-global
     4378                                 ,output v-host
     4379                                 ,output v-object
     4380                                 ,output v-output-display
     4381                                 ,output v-tree
     4382                                 ,output v-other
     4383                                                           ) no-error .
     4384   find first new_c-dis-rule no-lock where
     4385               new_c-dis-rule.rule-num = X_c-dis-rule.rule-num
     4386           AND new_c-dis-rule.chip-num > X_c-dis-rule.chip-num
     4387           AND new_c-dis-rule.corr-user-db-num = X_c-dis-rule.corr-user-db-num
     4388       no-error.
     4389   if not available new_c-dis-rule then do:
     4390       find first current_dis-rule no-lock where
     4391                    current_dis-rule.rule-num = X_c-dis-rule.rule-num no-error.
     4392       if not available current_dis-rule then do:
     4393            return error.
     4394       end.
     4395       buffer-compare current_dis-rule to X_c-dis-rule
     4396       case-sensitive
     4397       save result in v-chg-fields.
     4398   end.
     4399   else do:
     4400       buffer-compare new_c-dis-rule
     4401       except chip-num corr-date corr-time corr-user-name corr-user-db-num
     4402       to X_c-dis-rule
     4403       case-sensitive
     4404       save result in v-chg-fields.
     4405   end.
     4406   run disrules-fill-properties in this-procedure ( input X_c-dis-rule.templ-rl-root).
     4407   if X_c-dis-rule.lvl-num < 2
     4408   then do:
     4409     v-using-fields = v-level-1.
     4410   end.
     4411   else do:
     4412     v-using-fields = v-level-2.
     4413   end.
     4414   define variable ll as integer no-undo .
     4415   do ii = 1 to num-entries("other-inf,uniq-field,time-templ-rl-root,des,rule-num,dis-kat,discnt-value,doc-qnty,time-rule-num,tot-sum,charkey_one,charkey_two,charkey_three,key#_one,key#_two,key#_three,sts"):
     4416     if lookup(entry(ii, "other-inf,uniq-field,time-templ-rl-root,des,rule-num,dis-kat,discnt-value,doc-qnty,time-rule-num,tot-sum,charkey_one,charkey_two,charkey_three,key#_one,key#_two,key#_three,sts"), v-using-fields) > 0 then do:
     4417       assign
     4418       ll = ll + 1
     4419       v-fields-name-list = v-fields-name-list + (if ll  = 1 then '' else chr(44)) + entry(ii, "other-inf,uniq-field,time-templ-rl-root,des,rule-num,dis-kat,discnt-value,doc-qnty,time-rule-num,tot-sum,charkey_one,charkey_two,charkey_three,key#_one,key#_two,key#_three,sts")
     4420       v-fields-label-list = v-fields-label-list + (if ll = 1 then '' else chr(44)) + entry(ii, "Св-ва,Дерево,Шаблон расписания,Описание,№ правила,Категория скидки,Значение скидки,Количество,Номер расписания,Сумма в ценах продажи, , , , , , ,Статус")
     4421       v-fields-function-list = v-fields-function-list + (if ll = 1 then '' else chr(44)) + entry(ii, " , , , , , , , , , , , , , , , ,display-int-status")
     4422       .
     4423     end.
     4424   end.
     4425   do ii = 1 to num-entries(v-fields-name-list):
     4426     if X_c-dis-rule.lvl-num < 2
     4427     then do:
     4428       v-using-fields = v-level-1.
     4429     end.
     4430     else do:
     4431       v-using-fields = v-level-2.
     4432     end.
     4433     if lookup(entry(ii, v-fields-name-list), v-using-fields) > 0 then do:
     4434       find first buf_temp-drt-prop no-lock where
     4435                 buf_temp-drt-prop.upper-prop-code = entry(ii, v-fields-name-list)
     4436             and buf_temp-drt-prop.prop-code = "label" no-error.
     4437       if available buf_temp-drt-prop then do:
     4438         entry(ii, v-fields-label-list) = buf_temp-drt-prop.property-value.
     4439       end.
     4440       else do:
     4441       end.
     4442     end.
     4443     else do:
     4444     end.
     4445   end.
     4446   _ii:
     4447   do ii = 1 to num-entries(v-chg-fields):
     4448     assign
     4449     v-field-name = entry(ii, v-chg-fields)
     4450     jj = lookup(v-field-name, v-fields-name-list).
     4451       if jj = 0 then next _ii.
     4452       assign
     4453       v-field-label = entry(jj, v-fields-label-list)
     4454       v-field-function = entry(jj, v-fields-function-list)
     4455       .
     4456       create temp-changes.
     4457       assign
     4458       temp-changes.f_name = v-field-name
     4459       temp-changes.l_name = v-field-label
     4460       temp-changes.v_old =  (if v-is-created
     4461                              then "":U
     4462                              else string(buffer X_c-dis-rule:buffer-field(v-field-name):buffer-value))
     4463       temp-changes.v_new = (if v-is-deleted
     4464                             then "":U else (if available new_c-dis-rule
     4465                                               then string(buffer new_c-dis-rule:buffer-field(v-field-name):buffer-value)
     4466                                               else string(buffer current_dis-rule:buffer-field(v-field-name):buffer-value)
     4467                                               )
     4468                            )
     4469       .
     4470       if v-field-function <> chr(32) then do:
     4471         assign
     4472         temp-changes.v_old = DYNAMIC-function(v-field-function, temp-changes.v_old)
     4473         temp-changes.v_new = DYNAMIC-function(v-field-function, temp-changes.v_new)
     4474         .
     4475       end.
     4476     end.
     4477   assign
     4478   br-changes:title in frame Dialog-Frame = (if X_c-dis-rule.rule-num  <= 99999
     4479                                               then "Шаблон"
     4480                                               else (if X_c-dis-rule.upper-rule-num <= 99999
     4481                                                     then "Правило скидки"
     4482                                                     else "Детализация"))
     4483   .
     4484   Open QUery br-changes for each temp-changes.
     4485   END PROCEDURE.
     4486   FUNCTION get-action RETURNS CHARACTER
     4487     ( p-action as INTEGER ) :
     4488     define variable dops as character no-undo.
     4489   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     4490   RETURN dops.
     4491   END FUNCTION.
