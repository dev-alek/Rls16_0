     1537         mark-string(recid(X_c-dis-rule), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1538         X_c-dis-rule.des FORMAT "X(50)":U
     1539         X_c-dis-rule.is-news FORMAT "+/":U
