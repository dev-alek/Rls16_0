     2908   procedure get-context :
     2909      define output parameter p-db-num as integer          no-undo.
     2910      define output parameter p-user-id as character        no-undo.
     2911      define variable v-login               as character    no-undo.
     2912      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2913      define buffer buf_user-login  for ub.user-login .
     2914      do
     2915      on error undo, return error
     2916      :
     2917            FIND FIRST buf_sys-ctrl no-lock.
     2918            ASSIGN
     2919               v-login = USERID("ub")
     2920               p-db-num = buf_sys-ctrl.db-num
     2921            .
     2922            FIND FIRST buf_user-login
     2923                 WHERE buf_user-login.db-num = p-db-num
     2924                   AND buf_user-login.user-login = v-login
     2925                 no-lock
     2926                 no-error
     2927                 .
     2928            IF AVAILABLE buf_user-login
     2929            THEN DO:
     2930               assign
     2931                  p-user-id = buf_user-login.user-id
     2932               .
     2933            END.
     2934      end.
     2935   end procedure.
     2936   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2937   on f5 of frame Dialog-Frame anywhere
     2938   do:
     2939     v-doc-rec = ?. if available X_c-dis-rule then v-doc-rec = recid(X_c-dis-rule). run OpenBr in this-procedure ( input yes, input no, input no). reposition br-c-dis-rule to recid v-doc-rec no-error. v-doc-rec = ?.               APPLY 'value-changed' to br-c-dis-rule.
     2940       apply "VALUE-CHANGED" to br-c-dis-rule.
     2941   end.
     2942   def var sort-labelbr-c-dis-rule   as character no-undo .
     2943   def var sort-clmnbr-c-dis-rule    as handle    no-undo .
     2944   def var cur-clmnbr-c-dis-rule     as handle    no-undo .
     2945   def var cur-clmn-locbr-c-dis-rule as integer   no-undo .
     2946   def var re-querybr-c-dis-rule     as logical   initial no no-undo .
     2947   on start-search, ctrl-o of br-c-dis-rule in frame Dialog-Frame do:
     2948      run sort-brbr-c-dis-rule
     2949        (input (if available X_c-dis-rule
     2950                then recid(X_c-dis-rule)
     2951                else ?
     2952               )
     2953        ).
