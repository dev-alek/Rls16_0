      530   end procedure.
      531   procedure prn-lib-reportviewer :
      532     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      533     define input parameter p-report-name-html as character no-undo .
      534     define input parameter p-param        as character no-undo .
      535     define variable v-excel           as character no-undo init 'TRUE' .
      536     define variable v-value-character as character no-undo .
      537     define variable v-value-integer   as character no-undo .
      538     define variable v-value-date      as date      no-undo .
      539     define variable v-value-decimal   as decimal   no-undo .
      540     define variable rep-excel         as logical   no-undo .
      541     define variable excel-string      as character no-undo .
      542     define variable v-param-type      as character no-undo .
      543     define variable v-tth             as handle    no-undo .
      544     run adm/shattri.p (
      545       input "get":U
      546       ,input  ""
      547       ,input  0
      548       ,input  'report-glob':U
      549       ,input  'rep-excel':U
      550       ,output v-value-character
      551       ,output v-value-date
      552       ,output v-value-decimal
      553       ,output v-value-integer
      554       ,output rep-excel
      555       ,output v-param-type
      556       ,INPUT-OUTPUT table-handle v-tth
      557       )  .
      558     if rep-excel then v-excel = "TRUE" .
      559     else v-excel = "FALSE" .
      560     if p-param eq ""
      561     then
      562        p-param = "EXCEL:" + v-excel.
      563     else
      564        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      565     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      566   end procedure.
      567   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      568   procedure cur-time :
      569      define output parameter p-today as date      no-undo .
      570      define output parameter p-time  as integer   no-undo .
      571     do
      572     on error undo, return error
      573     :
      574       define variable v-date1 as date      no-undo .
      575       define variable v-date2 as date      no-undo .
      576       define variable v-time  as integer   no-undo .
      577       assign
      578         v-date1 = today
      579         v-time  = time
      580         v-date2 = today
      581       .
      582       if v-date1 <> v-date2
      583       then do:
      584         assign
      585           v-date1 = today
      586           v-time  = v-time
      587         .
      588       end.
      589       assign
      590         p-today = v-date1
      591         p-time  = v-time
      592       .
      593     end.
      594   end.
      595   function cur-time-date returns character
      596   :
      597     return string(today, '99/99/9999':U) .
      598   end.
      599   function cur-time-mjd returns decimal
      600   :
      601     define variable v-date as date      no-undo .
      602     define variable v-time as integer   no-undo .
      603     run cur-time in this-procedure
      604       (output v-date
      605       ,output v-time
      606       ) .
      607     return integer(v-date) - 2400002 + (v-time / 86400) .
      608   end.
      609   function cur-time-get-ending-index returns integer
      610   (input p-number as integer
      611   )
      612   :
      613     if p-number < 0
      614     or p-number = ?
      615     then do:
      616       return 1 .
      617     end.
      618     define variable v-rest as integer   no-undo .
      619     assign
      620       p-number = p-number modulo 100
      621     .
      622     if p-number < 20
      623     then do:
      624       assign
      625         v-rest = p-number
      626       .
      627     end.
      628     else do:
      629       assign
      630         v-rest = p-number modulo 10
      631       .
      632     end.
      633     case v-rest :
      634       when 1
      635       then do:
      636         return 2 .
      637       end.
      638       when 2 or
      639       when 3 or
      640       when 4
      641       then do:
      642         return 3 .
      643       end.
      644       otherwise do:
      645         return 1 .
      646       end.
      647     end case .
      648   end.
      649   procedure cur-time-mjd-to-date :
      650      define input  parameter i-mjd-diff as decimal no-undo.
      651      define output parameter o-Date     as date    no-undo.
      652      define output parameter o-Time     as integer no-undo.
      653      define variable v-day-number as integer   no-undo .
      654      if    i-mjd-diff < 0
      655         or i-mjd-diff = ?
      656      then do:
      657         return "?" .
      658      end.
      659      assign
      660         v-day-number = truncate(i-mjd-diff,0).
      661         o-Date = date(v-day-number + 2400002).
      662         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      663     .
      664   end.
      665   function cur-time-mjd-to-string returns character
      666   (input p-mjd-diff as decimal
      667   )
      668   :
      669     define variable v-day-number as integer   no-undo .
      670     define variable v-seconds    as integer   no-undo .
      671     define variable v-hour       as integer   no-undo .
      672     define variable v-min        as integer   no-undo .
      673     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      674     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      675     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      676     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      677     if p-mjd-diff < 0
      678     or p-mjd-diff = ?
      679     then do:
      680       return "?" .
      681     end.
      682     assign
      683       v-day-number = integer(truncate(p-mjd-diff,0))
      684       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      685     .
      686     if v-seconds > 86400
      687     then do:
      688       assign
      689         v-seconds = 86400 - 1
      690       .
      691     end.
      692     if v-seconds < 0
      693     then do:
      694       assign
      695         v-seconds = 0
      696       .
      697     end.
      698     assign
      699       v-hour = truncate(v-seconds / 3600, 0)
      700     .
      701     assign
      702       v-seconds = v-seconds modulo 3600
      703     .
      704     assign
      705       v-min = truncate(v-seconds / 60, 0)
      706     .
      707     assign
      708       v-seconds = v-seconds modulo 60
      709     .
      710     return
      711         (if v-day-number <> 0
      712           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      713           else ""
      714         )
      715       + (if v-day-number <> 0 or v-hour <> 0
      716           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      717           else ""
      718         )
      719       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      720           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      721           else ""
      722         )
      723       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      724       .
      725   end.
      726   function cur-time-string returns character
      727   :
      728     define variable v-date as date      no-undo .
      729     define variable v-time as integer   no-undo .
      730     run cur-time in this-procedure
      731       (output v-date
      732       ,output v-time
      733       ) .
      734     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      735   end.
      736   function cur-time-string-sec returns character
      737   :
      738     define variable v-date as date      no-undo .
      739     define variable v-time as integer   no-undo .
      740     run cur-time in this-procedure
      741       (output v-date
      742       ,output v-time
      743       ) .
      744     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      745   end.
      746   function cur-time-custom  returns character
      747   (input p-prefix as character
      748   ,input p-date-format as character
      749   ,input p-delimiter as character
      750   ,input p-time-format as character
      751   ,input p-suffix as character
      752   )
      753   :
      754     define variable v-date as date      no-undo .
      755     define variable v-time as integer   no-undo .
      756     run cur-time in this-procedure
      757       (output v-date
      758       ,output v-time
      759       ) .
      760     return
      761       p-prefix
      762       + string(v-date, p-date-format)
      763       + p-delimiter
      764       + string(v-time, p-time-format)
      765       + p-suffix
      766       .
      767   end.
      768   function cur-time-print  returns character
      769   :
      770     define variable v-date as date      no-undo .
      771     define variable v-time as integer   no-undo .
      772     run cur-time in this-procedure
      773       (output v-date
      774       ,output v-time
      775       ) .
      776     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      777   end.
      778   function cur-time-datetime returns datetime
      779   :
      780     define variable v-char as character no-undo .
      781     define variable v-datetime as datetime no-undo .
      782     v-char = cur-time-string().
      783     v-datetime = datetime(v-char).
      784     return  v-datetime.
      785   end.
      786   function cur-time-string-msec returns character
      787   :
      788     define variable v-date as datetime  no-undo .
      789     v-date = now.
      790     return string(v-date) .
      791   end.
      792   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      793   define variable c-point  as character no-undo .
      794   define variable tbl      as character no-undo .
      795   define variable join-tbl as character no-undo .
      796   define variable fld      as character no-undo .
      797   define variable lab      as character no-undo .
      798   define variable spr      as character no-undo .
      799   define variable dim      as character no-undo .
      800   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      801   procedure fltfield-clear :
      802     define output parameter loc-fld as character no-undo.
      803     define output parameter loc-lab as character no-undo .
      804     define output parameter loc-spr as character no-undo .
      805     define output parameter loc-dim as character no-undo .
      806     assign
      807       loc-fld = ""
      808       loc-lab = ""
      809       loc-spr = ""
      810       loc-dim = "0"
      811     .
      812   end procedure .
      813   procedure fltfield-add :
      814     define input        parameter par-fld as character no-undo.
      815     define input        parameter par-lab as character no-undo .
      816     define input        parameter par-spr as character no-undo .
      817     define input-output parameter loc-fld as character no-undo.
      818     define input-output parameter loc-lab as character no-undo .
      819     define input-output parameter loc-spr as character no-undo .
      820     define input-output parameter loc-dim as character no-undo .
      821     do
      822     on error undo, return error
      823     :
      824       assign
      825       loc-fld = if loc-dim = '0'
      826                 then par-fld
      827                 else (loc-fld + chr(44) + par-fld)
      828       loc-lab = if loc-dim = '0'
      829                 then par-lab
      830                 else (loc-lab + chr(44) + par-lab)
      831       loc-spr = if loc-dim = '0'
      832                 then par-spr
      833                 else (loc-spr + chr(44) + par-spr)
      834       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      835                 string(integer(if num-entries(loc-dim) > 1
      836                               then entry(2, loc-dim)
      837                               else entry(1, loc-dim)
      838                               ) + 1)
      839       no-error
      840       .
      841     end.
      842   end procedure.
      843   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      844   procedure dr-code :
      845     do
      846     on error undo, return error
      847     :
      848       define input  parameter  p-templ-rl-root     like ub.dis-rule.templ-rl-root     no-undo .
      849       define output parameter  p-des               like ub.dis-rule.des               no-undo .
      850       define output parameter  p-discnt-type       like ub.dis-rule.discnt-type       no-undo .
      851       define output parameter  p-subject-type      like ub.dis-rule.subject-type      no-undo .
      852       define output parameter  p-value-type        like ub.dis-rule.value-type        no-undo .
      853       define output parameter  p-level-1           as character no-undo .
      854       define output parameter  p-level-2           as character no-undo .
      855       define output parameter  p-global             as integer no-undo .
      856       define output parameter  p-host               as integer no-undo .
      857       define output parameter  p-object             as integer no-undo .
      858       define output parameter  p-output-display as logical   no-undo .
      859       define output parameter  p-tree           as char  no-undo .
      860       define output parameter  p-other          as character no-undo .
      861       define variable v-other as character no-undo .
      862       define buffer buf_dis-rule for ub.dis-rule .
      863       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      864       find first buf_dis-rule no-lock where
      865                 buf_dis-rule.rule-num = p-templ-rl-root no-error.
      866       find first buf_dis-cfg-rule no-lock where
      867               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      868           and buf_dis-cfg-rule.pos-type = '':U
      869           and buf_dis-cfg-rule.table-name = '':U
      870           and buf_dis-cfg-rule.discnt-role = '':U
      871           and buf_dis-cfg-rule.self-nonunique = '':U
      872               no-error.
      873       if not available buf_Dis-cfg-rule then do:
      874           undo, return error substitute("неизвестный шаблон скидки &1", p-templ-rl-root ).
      875       end.
      876       assign
      877       p-des = buf_dis-rule.des
      878       p-discnt-type = buf_dis-rule.discnt-type
      879       p-subject-type = buf_dis-rule.subject-type
      880       p-value-type = buf_dis-rule.value-type
      881       p-global = (if available buf_dis-cfg-rule
      882                   then buf_dis-cfg-rule.has-global
      883                   else 0)
      884       p-host = (if available buf_dis-cfg-rule
      885                 then buf_dis-cfg-rule.has-host
      886                 else 0)
      887       p-object = (if available buf_dis-cfg-rule
      888                 then buf_dis-cfg-rule.has-obj
      889                 else 0)
      890       p-output-display = (buf_dis-rule.sts = integer('0':U))
      891       p-tree = buf_Dis-rule.uniq-field
      892       p-other = buf_dis-rule.other-inf
      893       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      894       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      895                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      896                    else '')
      897       .
      898     end.
      899   end procedure.
      900   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      901   procedure disrules-fill-properties:
      902   define input  parameter p-templ-rl-root as integer   no-undo .
      903   define buffer buf_drt-prop for ub.drt-prop.
      904   define buffer buf_temp-drt-prop for temp-drt-prop.
      905   do
      906   on error undo, return error return-value
      907   :
      908     for each buf_temp-drt-prop:
      909       delete buf_temp-drt-prop.
      910     end.
      911     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      912       create buf_temp-drt-prop.
      913       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      914     end.
      915   end.
      916   end procedure.
      917   procedure disrules-get-interface-form :
      918   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
      919   define output parameter p-form-name as character no-undo .
      920   define buffer buf_temp-drt-prop for temp-drt-prop.
      921   define buffer buf_drt-prop for ub.drt-prop.
      922   find first buf_temp-drt-prop where
      923             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
      924         and buf_temp-drt-prop.upper-prop-code = "InputForm"
      925         and buf_temp-drt-prop.prop-code = "FormName" no-error.
      926   if not available buf_temp-drt-prop then do:
      927     find first buf_drt-prop where
      928               buf_drt-prop.templ-rl-root = p-templ-rl-root
      929           and buf_drt-prop.upper-prop-code = "InputForm"
      930           and buf_drt-prop.prop-code = "FormName" no-error.
      931     if available buf_drt-prop then do:
      932       p-form-name = buf_drt-prop.property-value.
      933     end.
      934     else do:
      935       p-form-name = "ref/dis-ruli.w".
      936     end.
      937   end.
      938   else do:
      939     p-form-name = buf_temp-drt-prop.property-value.
      940   end.
      941   end procedure.
      942   ~
      943   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      944   ~
      945   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      946   FUNCTION gtregion RETURNS CHARACTER
      947     ( input parhost-code as integer
      948     , input parobj-type as character
      949     , input parobj-code as integer
      950     , input p-tab as logical
      951     ) :
      952     def var par-region as character no-undo.
      953     if parhost-code = 0 and
      954          parobj-type = "":U and
      955          parobj-code = 0 then do:
      956          par-region = "Глобально".
      957          return par-region.
      958       end.
      959       if parobj-type = "" and
      960          parobj-code = 0 then do:
      961          par-region = if p-tab then fill(chr(32), 2) else "":U +
      962                       "Фирма" + chr(32) + string(parhost-code).
      963          return par-region.
      964       end.
      965       par-region = if p-tab then fill(chr(32), 4) else "":U +
      966                    parobj-type + chr(32) + string(parobj-code).
      967       return par-region.
      968   END FUNCTION.
      969   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      970   define  temp-table temp-changes no-undo
      971   field f_name as character
      972   field l_name as character
      973   field v_old as character
      974   field v_new as character
      975   field t_name as character
      976   field num_ as integer
      977   field uniq-key-rec as character
      978   field action as integer
      979   field fNotChange as logical
      980   index pi is unique primary
      981   num_
      982   t_name
      983   f_name
      984   index
      985   Chan
      986   fnotChange
      987   t_name
      988   f_name
      989   index imain uniq-key-rec
      990   .
      991   FUNCTION get-all-fields returns character (p-file-name as character ):
      992   define variable v-dop as character no-undo .
      993     find first _file no-lock where _file._file-name = p-file-name no-error .
      994     if not available _file then return "":U.
      995     for each _field no-lock where
      996              _field._file-recid = recid(_file) :
      997       assign
      998       v-dop = v-dop + _field._field-name + chr(44)
      999       .
     1000     end.
     1001     return trim(v-dop).
     1002   END FUNCTION.
     1003   PROCEDURE proc-full-temp-changes :
     1004     define input  parameter p-hst-handle as handle    no-undo .
     1005     define input  parameter p-main-table as character no-undo .
     1006     define input  parameter p-field-list as character no-undo .
     1007     define input  parameter p-label-form as character no-undo .
     1008     define variable h-new-buf         as handle    no-undo .
     1009     define variable h-main-buf        as handle    no-undo .
     1010     define variable h-for-comp        as handle    no-undo .
     1011     define variable v-inform          as character no-undo .
     1012     define variable v-ind             as integer   no-undo .
     1013     define variable v-idx-field-qnty  as integer   no-undo .
     1014     define variable v-num-entries     as integer   no-undo .
     1015     define variable fh                as handle    no-undo .
     1016     define variable fh-main           as handle    no-undo .
     1017     define variable fh-old            as handle    no-undo .
     1018     define variable fh-new            as handle    no-undo .
     1019     define variable v-field-name      as character no-undo .
     1020     define variable v-field-lvl       as character no-undo .
     1021     define variable v-field-form      as character no-undo .
     1022     define variable v-search-exp      as character no-undo .
     1023     define variable v-srch-main       as character no-undo .
     1024     define variable v-word-link       as character no-undo .
     1025     define variable v-av-chip-num     as logical   no-undo .
     1026     define variable v-main-pi-fld-lst as character no-undo .
     1027     define variable v-main-fld-lst    as character no-undo .
     1028     define variable v-delim-list      as character no-undo .
     1029     define variable v-label           as character no-undo .
     1030     define variable v-old-value       as character no-undo case-sensitive.
     1031     define variable v-new-value       as character no-undo case-sensitive.
     1032     define variable v-chg-fields as character no-undo.
     1033     for each temp-changes:
     1034       delete temp-changes.
     1035     end.
     1036     if not p-hst-handle:available then do:
     1037       return .
     1038     end.
     1039     create buffer h-new-buf  for table p-hst-handle .
     1040     create buffer h-main-buf for table p-main-table .
     1041     assign
     1042       v-inform = h-main-buf:index-information(1)
     1043       v-ind    = 2
     1044     .
     1045     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1046     on error undo, return error
     1047     :
     1048       assign
     1049         v-inform = h-main-buf:index-information( v-ind )
     1050         v-ind    = v-ind + 1
     1051       .
     1052     end.
     1053     if v-inform = ?
     1054       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1055       or entry( 3, v-inform, ",":U ) <> "1":U
     1056     then do:
     1057       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1058     end.
     1059     assign
     1060       v-idx-field-qnty = num-entries( v-inform ) - 4
     1061     .
     1062     if v-idx-field-qnty < 2 then do:
     1063       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1064     end.
     1065     assign
     1066       v-srch-main   = "where":U
     1067       v-word-link   = "":U
     1068       v-av-chip-num = false
     1069       v-delim-list  = "":U
     1070     .
     1071     do v-ind = 1 to v-idx-field-qnty by 2
     1072     on error undo, return error
     1073     :
     1074       assign
     1075         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1076         fh                = p-hst-handle:buffer-field( v-field-name )
     1077         fh-main           = h-main-buf:buffer-field( v-field-name )
     1078         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1079         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1080       .
     1081       if fh:data-type ="character":U then do:
     1082         assign
     1083           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1084         .
     1085       end.
     1086       else do:
     1087         assign
     1088           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1089         .
     1090       end.
     1091       if v-delim-list = "":U then do:
     1092         assign
     1093           v-delim-list = ",":U
     1094         .
     1095       end.
     1096       if v-word-link = "":U then do:
     1097         assign
     1098           v-word-link = "and":U
     1099         .
     1100       end.
     1101     end.
     1102     assign
     1103       v-delim-list  = "":U
     1104     .
     1105     do v-ind = 1 to h-main-buf:num-fields
     1106     on error undo, return error
     1107     :
     1108       assign
     1109         fh-main      = h-main-buf:buffer-field( v-ind )
     1110         v-field-name = fh-main:name
     1111       .
     1112         assign
     1113           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1114         .
     1115         if v-delim-list = "":U then do:
     1116           assign
     1117             v-delim-list = ",":U
     1118           .
     1119         end.
     1120     end.
     1121     assign
     1122       v-inform = p-hst-handle:index-information(1)
     1123       v-ind    = 2
     1124     .
     1125     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1126     on error undo, return error
     1127     :
     1128       assign
     1129         v-inform = p-hst-handle:index-information( v-ind )
     1130         v-ind    = v-ind + 1
     1131       .
     1132     end.
     1133     if v-inform = ?
     1134       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1135       or entry( 3, v-inform, ",":U ) <> "1":U
     1136     then do:
     1137       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1138     end.
     1139     assign
     1140       v-idx-field-qnty = num-entries( v-inform ) - 4
     1141     .
     1142     if v-idx-field-qnty < 2 then do:
     1143       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1144     end.
     1145     assign
     1146       v-search-exp  = "where":U
     1147       v-word-link   = "":U
     1148       v-av-chip-num = false
     1149     .
     1150     do v-ind = 1 to v-idx-field-qnty by 2
     1151     on error undo, return error
     1152     :
     1153       assign
     1154         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1155         fh           = p-hst-handle:buffer-field( v-field-name )
     1156         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1157       .
     1158       if v-field-name = "chip-num":U then do:
     1159         assign
     1160           v-search-exp  = substitute( "&1 >", v-search-exp )
     1161           v-av-chip-num = true
     1162         .
     1163       end.
     1164       else do:
     1165         assign
     1166           v-search-exp = substitute( "&1 =", v-search-exp )
     1167         .
     1168       end.
     1169       if fh:data-type ="character":U then do:
     1170         assign
     1171           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1172         .
     1173       end.
     1174       else do:
     1175         assign
     1176           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1177         .
     1178       end.
     1179       if v-word-link = "":U then do:
     1180         assign
     1181           v-word-link = "and":U
     1182         .
     1183       end.
     1184     end.
     1185     if v-av-chip-num = false then do:
     1186       message
     1187         vss-workfile vss-revision vss-description skip
     1188         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1189         "Использование данной процедуры невозможно!" skip
     1190         view-as alert-box error .
     1191       return error .
     1192     end.
     1193     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1194     if not h-new-buf:available then do:
     1195       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1196       if not h-main-buf:available then do:
     1197         assign
     1198           h-for-comp = ?
     1199         .
     1200       end.
     1201       else do:
     1202         assign
     1203           h-for-comp = h-main-buf
     1204         .
     1205       end.
     1206     end.
     1207     else do:
     1208       assign
     1209         h-for-comp = h-new-buf
     1210       .
     1211     end.
     1212     assign
     1213       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1214     .
     1215     do v-ind = 1 to v-num-entries
     1216     on error undo, return error return-value
     1217     :
     1218       assign
     1219         v-field-name = entry( v-ind, v-main-fld-lst )
     1220         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1221         v-old-value  = fh-old:buffer-value()
     1222         v-label      = trim( fh-old:label )
     1223       .
     1224       if ( trim( p-field-list ) <> "":U
     1225            and lookup( v-field-name, p-field-list ) > 0
     1226          )
     1227          or trim( p-field-list ) = "":U
     1228       then do:
     1229         if h-for-comp <> ? then do:
     1230           assign
     1231             fh-new      = h-for-comp:buffer-field( v-field-name )
     1232             v-new-value = fh-new:buffer-value()
     1233           .
     1234         end.
     1235         else do:
     1236           assign
     1237             v-new-value = "":U
     1238           .
     1239         end.
     1240         if v-old-value <> v-new-value
     1241         then do:
     1242           create temp-changes.
     1243           assign
     1244             temp-changes.t_name = p-main-table
     1245             temp-changes.f_name = v-field-name
     1246             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1247             temp-changes.v_old  = trim( v-old-value )
     1248             temp-changes.v_new  = trim( v-new-value )
     1249             temp-changes.num_   = 0
     1250             temp-changes.fNotChange = v-old-value eq v-new-value
     1251           .
     1252         end.
     1253       end.
     1254     end.
     1255     assign
     1256       v-num-entries = num-entries( p-label-form, chr(8) )
     1257     .
     1258     do v-ind = 1 to v-num-entries
     1259     on error undo, return error return-value
     1260     :
     1261       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1262         assign
     1263           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1264           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1265           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1266         .
     1267         find first temp-changes
     1268           where temp-changes.f_name = v-field-name
     1269           no-error .
     1270         if available temp-changes then do:
     1271           if trim( v-field-lvl ) <> "":U then do:
     1272             assign
     1273               temp-changes.l_name = v-field-lvl
     1274             .
     1275           end.
     1276           if trim( v-field-form ) <> "":U then do:
     1277             assign
     1278               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1279             .
     1280             if h-for-comp <> ? then do:
     1281               assign
     1282                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1283               .
     1284             end.
     1285           end.
     1286         end.
     1287       end.
     1288       else do:
     1289         message
     1290           vss-workfile vss-revision vss-description skip
     1291           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1292           substitute( "список для поля '&1': '&2'"
     1293                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1294                       ,entry( v-ind, p-label-form, chr(8) )
     1295                     ) skip
     1296           substitute( "полный список: &2", p-label-form ) skip
     1297           view-as alert-box error .
     1298       end.
     1299     end.
     1300     delete object h-new-buf .
     1301     delete object h-main-buf .
     1302   END PROCEDURE.
     1303   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1304   FUNCTION mark-string RETURNS CHARACTER
     1305     ( input p-recid as recid, input mark-list as character  ) :
     1306     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1307   END FUNCTION.
     1308   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1309   function usrfulnf returns character ( input p-user-id as character):
     1310   define variable v-user-name as character no-undo .
     1311   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1312   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     1313     (input  p-user-id
     1314     ,output v-user-name
     1315     ) no-error .
     1316   if error-status:error
     1317   or v-user-name = ""
     1318   then do:
     1319     return p-user-id.
     1320   end.
     1321   else do:
     1322     return v-user-name.
     1323   end.
     1324   end function.
     1325   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1326   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1327   procedure fltopend_fltopend :
     1328   define input parameter p-parent-handle as handle no-undo .
     1329   define input parameter p-qh as handle no-undo .
     1330   define input parameter p-flt-open-open-query  as character no-undo .
     1331   define input parameter p-where-cond as character no-undo .
     1332   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1333   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1334   define input parameter p-indexed-reposition as character no-undo .
     1335     do
     1336     on error undo, return error
     1337     :
     1338   define variable v-prepare-string as character no-undo .
     1339   define variable glog as logical no-undo .
     1340   assign
     1341   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1342                      p-where-cond + chr(32)  +
     1343                      p-use-indFIRST-query-tail + chr(32) +
     1344                      p-use-ind-sort-clmn-by + chr(32) +
     1345                      p-indexed-reposition
     1346   .
     1347   assign
     1348   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1349   if not glog
     1350   or error-status:error then do:
     1351     message error-status:get-message(1) view-as alert-box .
     1352     undo, return error .
     1353   end.
     1354   assign
     1355   glog = p-qh:query-open no-error .
     1356   if not glog
     1357   or error-status:error then do:
     1358     message error-status:get-message(1) view-as alert-box .
     1359     undo, return error .
     1360   end.
     1361     end.
     1362   end procedure.
     1363   procedure fltopend_fltfindd :
     1364   define input parameter p-parent-handle as handle no-undo .
     1365   define input parameter p-qh as handle no-undo .
     1366   define input parameter p-rowid as rowid no-undo .
     1367   define input parameter p-next as logical no-undo .
     1368   define input parameter p-lock as integer no-undo .
     1369   define input parameter p-bh as handle no-undo .
     1370   define input parameter p-where-cond as character no-undo .
     1371   define input parameter p-use-index-phrase as character no-undo .
     1372   define variable glog as logical no-undo .
     1373   define variable v-qh as handle no-undo .
     1374   define variable v-bh as handle no-undo .
     1375   define variable v-recid as recid no-undo .
     1376   define variable v-prepare-string as character no-undo .
     1377   do
     1378   on error undo, return error
     1379   on stop undo, return error
     1380   :
     1381     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1382     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1383     create query v-qh.
     1384     v-qh:set-buffers(v-bh).
     1385     v-prepare-string = substitute("for each &1 &2 &3"
     1386                                     ,v-bh:name
     1387                                     ,p-where-cond
     1388                                     ,p-use-index-phrase).
     1389     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1390     if not glog then do:
     1391       delete object v-qh.
     1392       delete object v-bh.
     1393       undo, return error .
     1394     end.
     1395     glog = v-qh:query-open no-error .
     1396     if not glog then do:
     1397       delete object v-qh.
     1398       delete object v-bh.
     1399       undo, return error .
     1400     end.
     1401     if p-next then do:
     1402       v-qh:reposition-to-rowid(p-rowid) no-error .
     1403       glog = v-qh:get-next( p-lock) no-error .
     1404       glog = v-qh:get-next( p-lock) no-error .
     1405       if not glog or v-qh:query-off-end = yes then do:
     1406         glog = v-qh:get-first( p-lock) no-error .
     1407       end.
     1408     end.
     1409     else do:
     1410       glog = v-qh:get-first( p-lock) no-error .
     1411     end.
     1412     v-recid = v-bh:recid no-error .
     1413     delete object v-qh.
     1414     delete object v-bh.
     1415     return string(v-recid) .
     1416   end.
     1417   end procedure.
     1418   procedure fltopend_fltfindq :
     1419   define input parameter p-parent-handle as handle no-undo .
     1420   define input parameter p-qh as handle no-undo .
     1421   define input parameter p-next as logical no-undo .
     1422   define input parameter p-lock as integer no-undo .
     1423   define input parameter p-flt-open-open-query  as character no-undo .
     1424   define input parameter p-where-cond as character no-undo .
     1425   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1426   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1427   define input parameter p-indexed-reposition as character no-undo .
     1428   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1429   define variable glog as logical no-undo .
     1430   define variable v-qh as handle no-undo .
     1431   define variable v-bh as handle no-undo extent 18.
     1432   define variable v-rowid as rowid no-undo extent 18.
     1433   define variable v-ii as integer no-undo .
     1434   define variable v-prepare-string as character no-undo .
     1435   do
     1436   on error undo, return error
     1437   on stop undo, return error
     1438   :
     1439     create query v-qh.
     1440     do v-ii = 1 to p-qh:num-buffers:
     1441       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1442       assign
     1443       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1444       no-error.
     1445       v-qh:add-buffer(v-bh[v-ii]).
     1446     end.
     1447     assign
     1448     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1449                       p-where-cond + chr(32)  +
     1450                       p-use-indFIRST-query-tail + chr(32) +
     1451                       p-use-ind-sort-clmn-by + chr(32) +
     1452                       p-indexed-reposition
     1453     .
     1454     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1455     if not glog then do:
     1456       delete object v-qh.
     1457       do v-ii = 1 to p-qh:num-buffers:
     1458         delete object v-bh[v-ii].
     1459       end.
     1460       undo, return error .
     1461     end.
     1462     glog = v-qh:query-open no-error .
     1463     if not glog then do:
     1464       delete object v-qh.
     1465       do v-ii = 1 to p-qh:num-buffers:
     1466         delete object v-bh[v-ii].
     1467       end.
     1468       undo, return error .
     1469     end.
     1470     if p-next then do:
     1471       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1472       glog = v-qh:get-next( p-lock) no-error .
     1473       glog = v-qh:get-next( p-lock) no-error .
     1474       if not glog or v-qh:query-off-end = yes then do:
     1475         glog = v-qh:get-first( p-lock) no-error .
     1476       end.
     1477     end.
     1478     else do:
     1479       glog = v-qh:get-first( p-lock) no-error .
     1480     end.
     1481     do v-ii = 1 to p-qh:num-buffers:
     1482       assign
     1483       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1484       no-error.
     1485     end.
     1486     delete object v-qh.
     1487     do v-ii = 1 to p-qh:num-buffers:
     1488       delete object v-bh[v-ii].
     1489     end.
     1490   end.
     1491   end procedure.
     1492   define variable v-rid-list as character no-undo .
     1493   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
     1494   define variable sort-column-name as character no-undo .
     1495   define variable v-db-num LIKE ub.db.db-num no-undo.
     1496   define variable filter-label0 as character no-undo init "История правил скидки" .
     1497   define variable filter-label as character no-undo init "История правил скидки" .
     1498   define variable filter-point as character no-undo init "discruls" .
     1499   define variable filter-point0 as character no-undo init "discruls" .
     1500   define variable v-host-code like ub.sysconf.host-code no-undo .
