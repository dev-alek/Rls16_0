     1502   define buffer X_dis-rule for ub.dis-rule.
     1503   FUNCTION get-action RETURNS CHARACTER
     1504     ( p-action as INTEGER )  FORWARD.
     1505   DEFINE BUTTON B-Help
     1506        LABEL "Помо&щь"
     1507        SIZE 3 BY 1
     1508        BGCOLOR 8 .
     1509   DEFINE BUTTON B-lookup
     1510        LABEL "Button 1"
     1511        SIZE 10 BY 1.
     1512   DEFINE BUTTON B-mark
     1513        LABEL "&*"
     1514        SIZE 3 BY 1.
     1515   DEFINE BUTTON b-quit AUTO-END-KEY
     1516        LABEL "&Выход"
     1517        SIZE 10 BY 1
     1518        BGCOLOR 8 .
     1519   DEFINE BUTTON B-sch
     1520        LABEL "&Фильтр"
     1521        SIZE 3 BY 1.
     1522   DEFINE BUTTON B-sel AUTO-GO
     1523        LABEL "Вы&бор"
     1524        SIZE 10 BY 1.
     1525   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1526         VIEW-AS TEXT
     1527        SIZE 6 BY 1
     1528        FGCOLOR 4  NO-UNDO.
     1529   DEFINE QUERY br-c-dis-rule FOR
     1530         X_c-dis-rule SCROLLING.
     1531   DEFINE QUERY BR-changes FOR
     1532         temp-changes SCROLLING.
     1533   DEFINE QUERY Dialog-Frame FOR
     1534         X_c-dis-rule SCROLLING.
