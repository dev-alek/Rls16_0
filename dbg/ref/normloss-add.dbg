        1   using ibs.th.str.gds.*.
        2   using ibs.th.str.mercury.*.
        3   using ibs.th.gbl.storage.*.
        4   using ibs.th.bge.mercury.*.
        5   DEFINE INPUT        PARAMETER parparentproc AS WIDGET-HANDLE  NO-UNDO.
        6   DEFINE INPUT        PARAMETER p-type        AS integer        NO-UNDO.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Добавление норм технологических потерь".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define variable v-waitfram-action01         as character   no-undo .
       69   define variable v-waitfram-action02         as character   no-undo .
       70   define variable v-waitfram-action03         as character   no-undo .
       71   define variable mWaitFramTextBeg            as character   no-undo.
       72   define variable mWaitFramTextEnd            as character   no-undo.
       73   define variable mWaitFramView               as logical     no-undo.
       74   define variable mWaitProcEvent              as logical     no-undo init yes.
       75   define variable mWaitFramInterval           as integer     no-undo init 1 .
       76   define variable mWaitFramStop               as logical     no-undo.
       77   define variable mWaitFramStopUser           as logical     no-undo.
       78   define variable mWaitFramStopTimeOut        as logical     no-undo.
       79   define variable mWaitFramStartProc          as datetime-tz no-undo.
       80   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       81   define button B-WaitFramStop auto-end-key
       82        label "Стоп"
       83        size 10 by 1 tooltip "Остоновить процесс".
       84   define button B-viewProcInfo
       85        label "Информация"
       86        size 15 by 1 tooltip "Информация о процесс".
       87   define frame waitfram
       88     v-waitfram-action01 format "x(72)" no-label skip
       89     v-waitfram-action02 format "x(72)" no-label skip
       90     v-waitfram-action03 format "x(72)" no-label skip
       91     B-viewProcInfo
       92     B-WaitFramStop at row 4 col 30
       93     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       94     .
       95   define new global shared variable mBatchMode as logical no-undo init ?.
       96   define variable mFramBachModHandle as handle no-undo.
       97   mFramBachModHandle = frame waitfram:handle.
       98   define variable mFameOldVis as logical no-undo.
       99   define variable mVisCUrentVin as logical no-undo.
      100   if session:batch-mode
      101   then
      102      mBatchMode = yes.
      103   if mBatchMode = ? then do:
      104     mVisCUrentVin = current-window:visible.
      105     mFameOldVis = mFramBachModHandle:visible.
      106     mFramBachModHandle:visible  = yes.
      107     mBatchMode = mFramBachModHandle:visible ne yes.
      108     mFramBachModHandle:visible = mFameOldVis.
      109     current-window:visible = mVisCUrentVin.
      110   end.
      111    if  log-manager:logfile-name ne ?
      112     then DO:
      113         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      114         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      115         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      116     end.
      117   on choose of B-WaitFramStop in frame waitfram
      118   do:
      119     mWaitFramStop = yes.
      120     mWaitFramStopUser = yes.
      121   end.
      122   function waitfram-check-timeout returns logical():
      123      define variable vtime as int64 no-undo.
      124      if mWaitFramStopTimeOut
      125      then
      126         return yes.
      127      vtime = ( now - mWaitFramStartProc ) / 1000 .
      128      if     mWaitFramTimeOut ne ?
      129         and mWaitFramTimeOut ne 0
      130         and mWaitFramTimeOut lt vtime
      131      then do:
      132         mWaitFramStopTimeOut = yes.
      133      end.
      134      return mWaitFramStopTimeOut.
      135   end.
      136   procedure waitfram-hide :
      137     if not session:batch-mode
      138     then do
      139     on error undo, return error return-value
      140     :
      141       pause 0 before-hide .
      142       if not mBatchMode then
      143         hide frame waitfram .
      144     if     not mWaitFramView
      145        and mWaitProcEvent
      146     then
      147       process events .
      148     end.
      149   end procedure.
      150   procedure waitfram-show :
      151     define input  parameter p-message as character no-undo .
      152     define variable v-left-margin as integer   no-undo .
      153     if not session:batch-mode
      154     then do
      155     on error undo, return error return-value
      156     :
      157       if length(p-message) <= 70 then do:
      158         assign
      159           v-left-margin = integer((70 - length(p-message)) / 2)
      160         .
      161         assign
      162           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      163         .
      164         assign
      165           v-waitfram-action01 = " "
      166           v-waitfram-action02 = " "
      167                                    + fill(" ", v-left-margin)
      168                                    + p-message
      169           v-waitfram-action03 = " "
      170         .
      171       end.
      172       else do:
      173         define variable vRindex1 as integer no-undo.
      174         define variable vRindex2 as integer no-undo.
      175         vRindex1 = r-index(p-message," ",70).
      176         if vRindex1 = 0
      177         then
      178            vRindex1 = 70.
      179         if length(p-message)  <= vRindex1 + 70 then do:
      180           assign
      181             v-waitfram-action01 = " "
      182             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      183             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      184           .
      185         end.
      186         else do:
      187           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      188           if vRindex2 <= vRindex1
      189           then
      190              vRindex2 = vRindex1 + 70.
      191           assign
      192             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      193             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      194             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      195           .
      196         end.
      197       end.
      198       B-viewProcInfo:visible   in frame waitfram = no.
      199       B-viewProcInfo:sensitive in frame waitfram = no.
      200       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      201       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      202       if  (   mWaitFramView
      203          or  mWaitProcEvent)
      204          and not mBatchMode
      205       then
      206          display
      207             v-waitfram-action01 skip
      208             v-waitfram-action02 skip
      209             v-waitfram-action03 skip
      210          with frame waitfram .
      211       if     mWaitFramView
      212          then do:
      213             if     mWaitFramInterval ne ?
      214                and not mBatchMode
      215             then
      216                wait-for go of frame waitfram pause mWaitFramInterval.
      217          end.
      218          else
      219             if     mWaitProcEvent
      220                and not mBatchMode
      221             then
      222                process events .
      223     end.
      224   end procedure.
      225      procedure waitfram-show-this:
      226         define input  parameter iInterval as int64 no-undo.
      227         define variable vtime as int64 no-undo.
      228         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      229         mWaitFramInterval = iInterval.
      230         run waitfram-show (substitute("&1&2 &3&4" ,
      231                                       mWaitFramTextBeg ,
      232                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      233                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      234                                       mWaitFramTextEnd
      235                                      )
      236                           ).
      237      end.
      238      procedure WaitFramRunPause:
      239         define input  parameter iInterval as dec no-undo.
      240         define variable vStart  as datetime-tz no-undo.
      241         define variable vend    as datetime-tz no-undo.
      242         define variable vint as int64 no-undo.
      243         define variable vOk as logical no-undo.
      244         vStart = now.
      245         vend   = vStart.
      246         publish "WaitFramPause" (iInterval,output vOk).
      247         vend   =  now.
      248         vint = vend - vStart.
      249         vint = iInterval - vint / 1000.
      250         if     not mWaitFramStop
      251            and (   vint > 0
      252                 or (    not vOk
      253                     and iInterval eq ?
      254                     )
      255                 )
      256         then
      257            run waitfram-show-this (iInterval).
      258         vend   =  now.
      259         vint = vend - vStart.
      260         vint = iInterval - vint / 1000.
      261         if     not mWaitFramStop
      262            and vint > 0
      263         then do:
      264            run gbl/pause.p (vint * 1000).
      265         end.
      266         if iInterval ne ?
      267         then
      268            publish "WaitFramStop".
      269         waitfram-check-timeout().
      270      end.
      271      procedure WaitFramWaitFor:
      272         define input  parameter iInterval as dec no-undo.
      273         assign
      274            mWaitFramStartProc   = now
      275            mWaitFramStopUser    = no
      276            mWaitFramStopTimeOut = no
      277         .
      278         block-wait:
      279         do while not mWaitFramStop:
      280            run WaitFramRunPause (iInterval).
      281            if  waitfram-check-timeout()
      282            then do:
      283               leave block-wait.
      284            end.
      285         end.
      286         run waitfram-hide.
      287      end.
      288   procedure waitfram-join :
      289     define input  parameter p-line-1  as character no-undo .
      290     define input  parameter p-line-2  as character no-undo .
      291     define input  parameter p-line-3  as character no-undo .
      292     define output parameter p-message as character no-undo .
      293     do
      294     on error undo, return error return-value
      295     :
      296       assign
      297         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      298                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      299                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      300       .
      301     end.
      302   end procedure.
      303   function waitfram-join-function returns character
      304     (input p-line-1 as character
      305     ,input p-line-2 as character
      306     ,input p-line-3 as character
      307     ).
      308     define variable v-message as character no-undo .
      309     run waitfram-join in this-procedure
      310       (input  p-line-1
      311       ,input  p-line-2
      312       ,input  p-line-3
      313       ,output v-message
      314       ) .
      315     return v-message .
      316   end function .
      317   define new global shared variable g#language as character no-undo .
      318   if g#language <> '' and g#language <> 'rus':U then do:
      319     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      320   end.
      321   procedure proc-alt-shift-f2:
      322     if not ibs.th.gbl.gbl-var:rcode
      323   then
      324     run gbl\inidebug.p .
      325   end.
      326   procedure proc-alt-shift-f3:
      327     run gbl/prvssinf.p
      328       ( input this-procedure
      329       ) .
      330   end.
      331   define variable v-inform-launched as logical no-undo initial false .
      332   procedure proc-alt-shift-f4:
      333     define variable v-action as character no-undo .
      334     if v-inform-launched = false then do:
      335       assign
      336         v-inform-launched = true
      337       .
      338       run gbl/d-inform.w
      339         (  input self
      340         ,  input this-procedure
      341         , output v-action
      342         ) no-error .
      343       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      344       assign
      345         v-inform-launched = false
      346       .
      347     end.
      348   end.
      349   procedure proc-alt-f1:
      350     run gbl/corrhelp.p
      351       (input this-procedure
      352       ) .
      353   end .
      354   on alt-shift-f2 anywhere do:
      355     run proc-alt-shift-f2.
      356   end.
      357   on alt-shift-f3 anywhere do:
      358     run proc-alt-shift-f3 in this-procedure .
      359   end.
      360   on alt-shift-f4 anywhere do:
      361     run proc-alt-shift-f4 in this-procedure.
      362   end.
      363   on alt-f1 anywhere do:
      364     run proc-alt-f1 in this-procedure .
      365   end.
      366   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      367     define variable v-cntxt-db-num        as integer   no-undo .
      368     define variable v-cntxt-userid        as character no-undo .
      369     define variable v-cntxt-level         as character no-undo .
      370     define variable v-cntxt-host-code-obj as integer   no-undo .
      371     define variable v-cntxt-obj-type      as character no-undo .
      372     define variable v-cntxt-obj-code      as integer   no-undo .
      373     define variable v-cntxt-db-num-obj    as integer   no-undo .
      374     define variable v-cntxt-is-admin      as logical   no-undo .
      375   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376     run mainmenu_getcntxt in parparentproc
      377       (output v-cntxt-db-num
      378       ,output v-cntxt-userid
      379       ,output v-cntxt-level
      380       ,output v-cntxt-host-code-obj
      381       ,output v-cntxt-obj-type
      382       ,output v-cntxt-obj-code
      383       ,output v-cntxt-db-num-obj
      384       ,output v-cntxt-is-admin
      385       ) .
      386   DEFINE BUFFER buf_norm-loss       for ub.norm-loss .
      387   DEFINE BUTTON B-exit AUTO-GO
      388        LABEL "&Ввод"
      389        SIZE 10 BY 1
      390        BGCOLOR 8 .
      391   DEFINE BUTTON B-Help
      392        LABEL "Помо&щь"
      393        SIZE 3 BY 1
      394        BGCOLOR 8 .
      395   DEFINE BUTTON b-quit AUTO-END-KEY
      396        LABEL "&Отмена"
      397        SIZE 10 BY 1
      398        BGCOLOR 8 .
      399   DEFINE VARIABLE f-clim-grp AS CHARACTER FORMAT "X(256)":U
      400        LABEL "Климатическая группа"
      401        VIEW-AS COMBO-BOX INNER-LINES 5
      402        LIST-ITEMS "1(1)","1(2)","2(1)","2(3)","3(1)","3(2)"
      403        DROP-DOWN-LIST
      404        SIZE 29 BY 1 NO-UNDO.
      405   DEFINE VARIABLE f-oil-grp AS CHARACTER FORMAT "X(9)":U
      406        LABEL "Группа нефтепродуктов"
      407        VIEW-AS COMBO-BOX INNER-LINES 4
      408        LIST-ITEMS "I","II","III","IV"
      409        DROP-DOWN-LIST
      410        SIZE 29 BY 1 NO-UNDO.
      411   DEFINE VARIABLE f-position AS CHARACTER FORMAT "X(256)":U
      412        LABEL "Расположение"
      413        VIEW-AS COMBO-BOX INNER-LINES 2
      414        LIST-ITEM-PAIRS "наземный","0",
      415                        "подземный","1"
      416        DROP-DOWN-LIST
      417        SIZE 29 BY 1 NO-UNDO.
      418   DEFINE VARIABLE f-season AS CHARACTER FORMAT "X(256)":U
      419        LABEL "Период"
      420        VIEW-AS COMBO-BOX INNER-LINES 2
      421        LIST-ITEM-PAIRS "весенне-летний","0",
      422                        "осенне-зимний","1"
      423        DROP-DOWN-LIST
      424        SIZE 29 BY 1 NO-UNDO.
      425   DEFINE VARIABLE f-sec-vol AS DECIMAL FORMAT "->>,>>9":U INITIAL 0
      426        LABEL "Вместительность"
      427        VIEW-AS FILL-IN
      428        SIZE 6.75 BY 1 TOOLTIP "[Ниж.ур]–[Верх.ур], если верх.ур не определен, то указ. только нижн.ур" NO-UNDO.
      429   DEFINE VARIABLE f-sec-vol-2 AS DECIMAL FORMAT "->>,>>9":U INITIAL 0
      430        VIEW-AS FILL-IN
      431        SIZE 6.75 BY 1 TOOLTIP "[Ниж.ур]–[Верх.ур], если верх.ур не определен, то указ. только нижн.ур" NO-UNDO.
      432   DEFINE VARIABLE f-value AS DECIMAL FORMAT "->>,>>9.999":U INITIAL 0
      433        VIEW-AS FILL-IN
      434        SIZE 29 BY 1 NO-UNDO.
      435   DEFINE FRAME Dialog-Frame
      436        B-exit AT ROW 1 COL 1
      437        b-quit AT ROW 1 COL 11
      438        B-Help AT ROW 1 COL 52.5
      439        f-clim-grp AT ROW 3.17 COL 23.25 COLON-ALIGNED WIDGET-ID 40
      440        f-position AT ROW 4.33 COL 23.25 COLON-ALIGNED WIDGET-ID 42
      441        f-sec-vol AT ROW 5.5 COL 23.25 COLON-ALIGNED WIDGET-ID 22
      442        f-sec-vol-2 AT ROW 5.5 COL 33.63 COLON-ALIGNED NO-LABEL WIDGET-ID 58
      443        f-oil-grp AT ROW 6.67 COL 23.25 COLON-ALIGNED WIDGET-ID 50
      444        f-season AT ROW 7.83 COL 23.25 COLON-ALIGNED WIDGET-ID 52
      445        f-value AT ROW 10.42 COL 14.25 NO-LABEL WIDGET-ID 54
      446        "Значение нормы технологических потерь" VIEW-AS TEXT
      447             SIZE 38 BY 1 AT ROW 9.17 COL 10.38 WIDGET-ID 56
      448        "-" VIEW-AS TEXT
      449             SIZE 2 BY .67 AT ROW 5.71 COL 33.13 WIDGET-ID 60
      450        SPACE(22.99) SKIP(5.82)
      451       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      452            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      453            TITLE "Нормы технологических потерь"
      454            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      455   ASSIGN
      456          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      457          FRAME Dialog-Frame:HIDDEN           = TRUE.
      458   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      459   DO:
      460       APPLY "END-ERROR":U TO SELF.
      461     END.
      462   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      463   DO:
      464       RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      465       IF ERROR-STATUS:error THEN RETURN NO-APPLY.
      466     END.
      467   ON VALUE-CHANGED OF f-clim-grp IN FRAME Dialog-Frame
      468   DO:
      469     assign f-clim-grp .
      470   END.
      471   ON VALUE-CHANGED OF f-oil-grp IN FRAME Dialog-Frame
      472   DO:
      473     assign
      474     f-oil-grp
      475     .
      476   END.
      477   ON VALUE-CHANGED OF f-position IN FRAME Dialog-Frame
      478   DO:
      479       assign
      480         f-position
      481       .
      482   END.
      483   ON VALUE-CHANGED OF f-season IN FRAME Dialog-Frame
      484   DO:
      485     assign
      486     f-season
      487     .
      488   END.
      489   ON LEAVE OF f-sec-vol IN FRAME Dialog-Frame
      490   DO:
      491         assign f-sec-vol .
      492     END.
      493   ON LEAVE OF f-sec-vol-2 IN FRAME Dialog-Frame
      494   DO:
      495         assign f-sec-vol-2 .
      496     END.
      497   ON LEAVE OF f-value IN FRAME Dialog-Frame
      498   DO:
      499     assign f-value .
      500     END.
      501   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      502     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      503   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      504   on help of frame Dialog-Frame
      505   do:
      506     run gbl/app_help.p
      507       (input this-procedure :file-name
      508       ,input ''
      509       ,input ?
      510       ) no-error.
      511     if error-status :error then do:
      512       message
      513         "Ошибка при вызове помощи"
      514         error-status :get-message(1)
      515         view-as alert-box .
      516     end.
      517   end.
      518   run minbtn-set in this-procedure .
      519   on choose of b-help in frame Dialog-Frame
      520   do:
      521     apply "help":u to frame Dialog-Frame .
      522   end.
      523   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      524   procedure minbtn-set :
      525       do
      526           on error undo, return error return-value
      527           :
      528           define variable ii              as integer       no-undo .
      529           define variable fh              as widget-handle no-undo .
      530           define variable hh              as widget-handle no-undo .
      531           define variable v-h             as handle        extent 4 no-undo .
      532           define variable v-name-button   as character     no-undo .
      533           define variable v-help-old-x    as decimal       no-undo .
      534           define variable v-help-old-y    as decimal       no-undo .
      535           define variable v-help-old-size as decimal       no-undo .
      536           define variable v-frame-width   as decimal       no-undo .
      537           define variable jj              as integer       no-undo .
      538           do
      539               on error undo, return error
      540               :
      541               assign
      542                   v-frame-width = frame Dialog-Frame:width - 0.3
      543                   fh            = frame Dialog-Frame:first-child
      544                   hh            = fh:first-child
      545                   ii            = 1
      546                   .
      547               do while valid-handle(hh):
      548                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      549                   do:
      550                       case lc(hh:name) :
      551                           when "b-help" then
      552                               do:
      553                                   hh:load-image-up("cmp/b-help.bmp":u) .
      554                                   hh:load-image-down("cmp/b-help.bmp":u) .
      555                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      556                                   hh:TOOLTIP = "Помощь" .
      557                                   v-help-old-x = hh:column .
      558                                   v-help-old-y = hh:row    .
      559                                   v-help-old-size = hh:width .
      560                                   hh:width-chars = 2.5 .
      561                               end.
      562                           when "b-print" then
      563                               do:
      564                                   hh:load-image("cmp/b-print.bmp":u) .
      565                                   hh:TOOLTIP = "Печать" .
      566                                   v-h[ii] = hh:handle .
      567                                   ii = ii + 1 .
      568                                   hh:width-chars = 3 .
      569                               end.
      570                           when "b-history" or
      571                           when "b-hist" then
      572                               do:
      573                                   hh:load-image("cmp/b-hist.bmp":u) .
      574                                   hh:TOOLTIP = "История" .
      575                                   v-h[ii] = hh:handle .
      576                                   ii = ii + 1 .
      577                                   hh:width-chars = 3 .
      578                               end.
      579                           when "b-sch" then
      580                               do:
      581                                   hh:load-image("cmp/b-sch.bmp":u) .
      582                                   hh:TOOLTIP = "Установка Фильтра" .
      583                                   v-h[ii] = hh:handle .
      584                                   ii = ii + 1 .
      585                                   hh:width-chars = 3 .
      586                               end.
      587                           when "b-hist-user" then
      588                               do:
      589                                   hh:load-image("cmp/b-hist.bmp":u) .
      590                                   hh:TOOLTIP = "История пользователя" .
      591                                   ii = ii + 1 .
      592                               end.
      593                       end case.
      594                   end.
      595                   hh = hh:next-sibling.
      596               end.
      597               b-help:column = v-frame-width - b-help:width-chars.
      598               jj = 0.
      599               repeat ii = 4 to 1 by -1 :
      600                   if valid-handle (v-h[ii] ) then
      601                   do:
      602                       jj  = jj + 1 .
      603                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      604                       v-h[ii]:row    = v-help-old-y .
      605                   end.
      606               end.
      607           end.
      608       end.
      609   end procedure.
      610   MAIN-BLOCK:
      611   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      612     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      613     RUN Myenable IN THIS-PROCEDURE.
      614     WAIT-FOR GO OF FRAME Dialog-Frame.
      615   END.
      616   RUN disable_UI.
      617   PROCEDURE disable_UI :
      618     HIDE FRAME Dialog-Frame.
      619   END PROCEDURE.
      620   PROCEDURE enable_UI :
      621     DISPLAY f-clim-grp f-position f-sec-vol f-sec-vol-2 f-oil-grp f-season f-value
      622         WITH FRAME Dialog-Frame.
      623     ENABLE B-exit b-quit B-Help f-clim-grp f-position f-sec-vol f-sec-vol-2
      624            f-oil-grp f-season f-value
      625         WITH FRAME Dialog-Frame.
      626     VIEW FRAME Dialog-Frame.
      627   END PROCEDURE.
      628   PROCEDURE enable_UI_fill :
      629   DISPLAY
      630       f-clim-grp
      631       f-oil-grp
      632       f-position
      633       f-season
      634       f-sec-vol
      635       f-sec-vol-2
      636       f-value
      637       with frame Dialog-Frame.
      638   END PROCEDURE.
      639   PROCEDURE MyEnable :
      640   enable
      641         f-clim-grp
      642         f-oil-grp
      643         f-position
      644         f-season
      645         f-sec-vol
      646         f-sec-vol-2
      647         f-value
      648         B-exit b-quit B-Help
      649         with frame Dialog-Frame .
      650     VIEW FRAME Dialog-Frame.
      651   END PROCEDURE.
      652   PROCEDURE proc-save :
      653   define variable ii  as integer no-undo .
      654     find last buf_norm-loss no-lock no-error.
      655     if available (buf_norm-loss) then do:
      656       ii = buf_norm-loss.id + 1 .
      657     end.
      658     else ii = 1 .
      659     create buf_norm-loss .
      660     assign
      661           buf_norm-loss.id         = ii
      662           buf_norm-loss.type       = p-type
      663           buf_norm-loss.clim-grp   = f-clim-grp
      664           buf_norm-loss.oil-grp    = f-oil-grp
      665           buf_norm-loss.position   = f-position
      666           buf_norm-loss.sec-vol1   = f-sec-vol
      667           buf_norm-loss.sec-vol2   = f-sec-vol-2
      668           buf_norm-loss.value-loss = decimal(f-value)
      669     .
      670   END PROCEDURE.
