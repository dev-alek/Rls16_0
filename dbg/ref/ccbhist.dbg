       14   define input parameter p-corr-user-db-num  like ub.c-cli-hist.corr-user-db-num no-undo .
       15   define input parameter p-corr-user-name  like ub.c-cli-hist.corr-user-name no-undo .
       16   define input parameter p-subject  like ub.c-cli-hist.subject no-undo .
       17   define input parameter p-db-num  like ub.c-cli-hist.corr-user-db-num no-undo .
       18   define input parameter p-chip-num  as int64 no-undo.
       19   define input-output param p-rid-list    as  char no-undo .
       20   vlable = if p-mode eq "one"  then "История по кассовой книге " + string(pid) else "История по кассовым книгам".
       21   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       22   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       23   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       24   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       25   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
