      868   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      869   procedure fltopend_fltopend :
      870   define input parameter p-parent-handle as handle no-undo .
      871   define input parameter p-qh as handle no-undo .
      872   define input parameter p-flt-open-open-query  as character no-undo .
      873   define input parameter p-where-cond as character no-undo .
      874   define input parameter p-use-indFIRST-query-tail as character no-undo .
      875   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      876   define input parameter p-indexed-reposition as character no-undo .
      877     do
      878     on error undo, return error
      879     :
      880   define variable v-prepare-string as character no-undo .
      881   define variable glog as logical no-undo .
      882   assign
      883   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      884                      p-where-cond + chr(32)  +
      885                      p-use-indFIRST-query-tail + chr(32) +
      886                      p-use-ind-sort-clmn-by + chr(32) +
      887                      p-indexed-reposition
      888   .
      889   assign
      890   glog = p-qh:query-prepare(v-prepare-string) no-error .
      891   if not glog
      892   or error-status:error then do:
      893     message error-status:get-message(1) view-as alert-box .
      894     undo, return error .
      895   end.
      896   assign
      897   glog = p-qh:query-open no-error .
      898   if not glog
      899   or error-status:error then do:
      900     message error-status:get-message(1) view-as alert-box .
      901     undo, return error .
      902   end.
      903     end.
      904   end procedure.
      905   procedure fltopend_fltfindd :
      906   define input parameter p-parent-handle as handle no-undo .
      907   define input parameter p-qh as handle no-undo .
      908   define input parameter p-rowid as rowid no-undo .
      909   define input parameter p-next as logical no-undo .
      910   define input parameter p-lock as integer no-undo .
      911   define input parameter p-bh as handle no-undo .
      912   define input parameter p-where-cond as character no-undo .
      913   define input parameter p-use-index-phrase as character no-undo .
      914   define variable glog as logical no-undo .
      915   define variable v-qh as handle no-undo .
      916   define variable v-bh as handle no-undo .
      917   define variable v-recid as recid no-undo .
      918   define variable v-prepare-string as character no-undo .
      919   do
      920   on error undo, return error
      921   on stop undo, return error
      922   :
      923     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      924     create buffer v-bh for table p-bh buffer-name p-bh:name.
      925     create query v-qh.
      926     v-qh:set-buffers(v-bh).
      927     v-prepare-string = substitute("for each &1 &2 &3"
      928                                     ,v-bh:name
      929                                     ,p-where-cond
      930                                     ,p-use-index-phrase).
      931     glog = v-qh:query-prepare(v-prepare-string) no-error.
      932     if not glog then do:
      933       delete object v-qh.
      934       delete object v-bh.
      935       undo, return error .
      936     end.
      937     glog = v-qh:query-open no-error .
      938     if not glog then do:
      939       delete object v-qh.
      940       delete object v-bh.
      941       undo, return error .
      942     end.
      943     if p-next then do:
      944       v-qh:reposition-to-rowid(p-rowid) no-error .
      945       glog = v-qh:get-next( p-lock) no-error .
      946       glog = v-qh:get-next( p-lock) no-error .
      947       if not glog or v-qh:query-off-end = yes then do:
      948         glog = v-qh:get-first( p-lock) no-error .
      949       end.
      950     end.
      951     else do:
      952       glog = v-qh:get-first( p-lock) no-error .
      953     end.
      954     v-recid = v-bh:recid no-error .
      955     delete object v-qh.
      956     delete object v-bh.
      957     return string(v-recid) .
      958   end.
      959   end procedure.
      960   procedure fltopend_fltfindq :
      961   define input parameter p-parent-handle as handle no-undo .
      962   define input parameter p-qh as handle no-undo .
      963   define input parameter p-next as logical no-undo .
      964   define input parameter p-lock as integer no-undo .
      965   define input parameter p-flt-open-open-query  as character no-undo .
      966   define input parameter p-where-cond as character no-undo .
      967   define input parameter p-use-indFIRST-query-tail as character no-undo .
      968   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      969   define input parameter p-indexed-reposition as character no-undo .
      970   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      971   define variable glog as logical no-undo .
      972   define variable v-qh as handle no-undo .
      973   define variable v-bh as handle no-undo extent 18.
      974   define variable v-rowid as rowid no-undo extent 18.
      975   define variable v-ii as integer no-undo .
      976   define variable v-prepare-string as character no-undo .
      977   do
      978   on error undo, return error
      979   on stop undo, return error
      980   :
      981     create query v-qh.
      982     do v-ii = 1 to p-qh:num-buffers:
      983       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      984       assign
      985       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      986       no-error.
      987       v-qh:add-buffer(v-bh[v-ii]).
      988     end.
      989     assign
      990     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      991                       p-where-cond + chr(32)  +
      992                       p-use-indFIRST-query-tail + chr(32) +
      993                       p-use-ind-sort-clmn-by + chr(32) +
      994                       p-indexed-reposition
      995     .
      996     glog = v-qh:query-prepare( v-prepare-string) no-error .
      997     if not glog then do:
      998       delete object v-qh.
      999       do v-ii = 1 to p-qh:num-buffers:
     1000         delete object v-bh[v-ii].
     1001       end.
     1002       undo, return error .
     1003     end.
     1004     glog = v-qh:query-open no-error .
     1005     if not glog then do:
     1006       delete object v-qh.
     1007       do v-ii = 1 to p-qh:num-buffers:
     1008         delete object v-bh[v-ii].
     1009       end.
     1010       undo, return error .
     1011     end.
     1012     if p-next then do:
     1013       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1014       glog = v-qh:get-next( p-lock) no-error .
     1015       glog = v-qh:get-next( p-lock) no-error .
     1016       if not glog or v-qh:query-off-end = yes then do:
     1017         glog = v-qh:get-first( p-lock) no-error .
     1018       end.
     1019     end.
     1020     else do:
     1021       glog = v-qh:get-first( p-lock) no-error .
     1022     end.
     1023     do v-ii = 1 to p-qh:num-buffers:
     1024       assign
     1025       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1026       no-error.
     1027     end.
     1028     delete object v-qh.
     1029     do v-ii = 1 to p-qh:num-buffers:
     1030       delete object v-bh[v-ii].
     1031     end.
     1032   end.
     1033   end procedure.
