      791   procedure prn-lib-reportviewer :
      792     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      793     define input parameter p-report-name-html as character no-undo .
      794     define input parameter p-param        as character no-undo .
      795     define variable v-excel           as character no-undo init 'TRUE' .
      796     define variable v-value-character as character no-undo .
      797     define variable v-value-integer   as character no-undo .
      798     define variable v-value-date      as date      no-undo .
      799     define variable v-value-decimal   as decimal   no-undo .
