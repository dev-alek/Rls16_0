     1077   FUNCTION get-all-fields returns character (p-file-name as character ):
     1078   define variable v-dop as character no-undo .
     1079     find first _file no-lock where _file._file-name = p-file-name no-error .
     1080     if not available _file then return "":U.
     1081     for each _field no-lock where
     1082              _field._file-recid = recid(_file) :
     1083       assign
     1084       v-dop = v-dop + _field._field-name + chr(44)
     1085       .
     1086     end.
     1087     return trim(v-dop).
     1088   END FUNCTION.
     1089   PROCEDURE proc-full-temp-changes :
     1090     define input  parameter p-act-create as logical   no-undo .
     1091     define input  parameter p-act-delete as logical   no-undo .
     1092     define input  parameter p-hst-handle as handle    no-undo .
     1093     define input  parameter p-main-table as character no-undo .
     1094     define input  parameter p-field-list as character no-undo .
     1095     define input  parameter p-label-form as character no-undo .
     1096     define variable h-new-buf         as handle    no-undo .
     1097     define variable h-main-buf        as handle    no-undo .
     1098     define variable h-for-comp        as handle    no-undo .
     1099     define variable v-inform          as character no-undo .
     1100     define variable v-ind             as integer   no-undo .
     1101     define variable v-idx-field-qnty  as integer   no-undo .
     1102     define variable v-num-entries     as integer   no-undo .
     1103     define variable fh                as handle    no-undo .
     1104     define variable fh-main           as handle    no-undo .
     1105     define variable fh-old            as handle    no-undo .
     1106     define variable fh-new            as handle    no-undo .
     1107     define variable v-field-name      as character no-undo .
     1108     define variable v-field-lvl       as character no-undo .
     1109     define variable v-field-form      as character no-undo .
     1110     define variable v-search-exp      as character no-undo .
     1111     define variable v-srch-main       as character no-undo .
     1112     define variable v-word-link       as character no-undo .
     1113     define variable v-av-chip-num     as logical   no-undo .
     1114     define variable v-main-pi-fld-lst as character no-undo .
     1115     define variable v-main-fld-lst    as character no-undo .
     1116     define variable v-delim-list      as character no-undo .
     1117     define variable v-label           as character no-undo .
     1118     define variable v-old-value       as character no-undo case-sensitive.
     1119     define variable v-new-value       as character no-undo case-sensitive.
     1120     define variable v-chg-fields as character no-undo.
     1121     for each temp-changes:
     1122       delete temp-changes.
     1123     end.
     1124     if not p-hst-handle:available then do:
     1125       return .
     1126     end.
     1127     create buffer h-new-buf  for table p-hst-handle .
     1128     create buffer h-main-buf for table p-main-table .
     1129     assign
     1130       v-inform = h-main-buf:index-information(1)
     1131       v-ind    = 2
     1132     .
     1133     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1134     on error undo, return error
     1135     :
     1136       assign
     1137         v-inform = h-main-buf:index-information( v-ind )
     1138         v-ind    = v-ind + 1
     1139       .
     1140     end.
     1141     if v-inform = ?
     1142       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1143       or entry( 3, v-inform, ",":U ) <> "1":U
     1144     then do:
     1145       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1146     end.
     1147     assign
     1148       v-idx-field-qnty = num-entries( v-inform ) - 4
     1149     .
     1150     if v-idx-field-qnty < 2 then do:
     1151       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1152     end.
     1153     assign
     1154       v-srch-main   = "where":U
     1155       v-word-link   = "":U
     1156       v-av-chip-num = false
     1157       v-delim-list  = "":U
     1158     .
     1159     do v-ind = 1 to v-idx-field-qnty by 2
     1160     on error undo, return error
     1161     :
     1162       assign
     1163         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1164         fh                = p-hst-handle:buffer-field( v-field-name )
     1165         fh-main           = h-main-buf:buffer-field( v-field-name )
     1166         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1167         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1168       .
     1169       if fh:data-type ="character":U then do:
     1170         assign
     1171           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1172         .
     1173       end.
     1174       else do:
     1175         assign
     1176           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1177         .
     1178       end.
     1179       if v-delim-list = "":U then do:
     1180         assign
     1181           v-delim-list = ",":U
     1182         .
     1183       end.
     1184       if v-word-link = "":U then do:
     1185         assign
     1186           v-word-link = "and":U
     1187         .
     1188       end.
     1189     end.
     1190     assign
     1191       v-delim-list  = "":U
     1192     .
     1193     do v-ind = 1 to h-main-buf:num-fields
     1194     on error undo, return error
     1195     :
     1196       assign
     1197         fh-main      = h-main-buf:buffer-field( v-ind )
     1198         v-field-name = fh-main:name
     1199       .
     1200         assign
     1201           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1202         .
     1203         if v-delim-list = "":U then do:
     1204           assign
     1205             v-delim-list = ",":U
     1206           .
     1207         end.
     1208     end.
     1209     assign
     1210       v-inform = p-hst-handle:index-information(1)
     1211       v-ind    = 2
     1212     .
     1213     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1214     on error undo, return error
     1215     :
     1216       assign
     1217         v-inform = p-hst-handle:index-information( v-ind )
     1218         v-ind    = v-ind + 1
     1219       .
     1220     end.
     1221     if v-inform = ?
     1222       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1223       or entry( 3, v-inform, ",":U ) <> "1":U
     1224     then do:
     1225       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1226     end.
     1227     assign
     1228       v-idx-field-qnty = num-entries( v-inform ) - 4
     1229     .
     1230     if v-idx-field-qnty < 2 then do:
     1231       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1232     end.
     1233     assign
     1234       v-search-exp  = "where":U
     1235       v-word-link   = "":U
     1236       v-av-chip-num = false
     1237     .
     1238     do v-ind = 1 to v-idx-field-qnty by 2
     1239     on error undo, return error
     1240     :
     1241       assign
     1242         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1243         fh           = p-hst-handle:buffer-field( v-field-name )
     1244         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1245       .
     1246       if v-field-name = "chip-num":U then do:
     1247         assign
     1248           v-search-exp  = substitute( "&1 >", v-search-exp )
     1249           v-av-chip-num = true
     1250         .
     1251       end.
     1252       else do:
     1253         assign
     1254           v-search-exp = substitute( "&1 =", v-search-exp )
     1255         .
     1256       end.
     1257       if fh:data-type ="character":U then do:
     1258         assign
     1259           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1260         .
     1261       end.
     1262       else do:
     1263         assign
     1264           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1265         .
     1266       end.
     1267       if v-word-link = "":U then do:
     1268         assign
     1269           v-word-link = "and":U
     1270         .
     1271       end.
     1272     end.
     1273     if v-av-chip-num = false then do:
     1274       message
     1275         vss-workfile vss-revision vss-description skip
     1276         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1277         "Использование данной процедуры невозможно!" skip
     1278         view-as alert-box error .
     1279       return error .
     1280     end.
     1281     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1282     if not h-new-buf:available then do:
     1283       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1284       if not h-main-buf:available then do:
     1285         assign
     1286           h-for-comp = ?
     1287         .
     1288       end.
     1289       else do:
     1290         assign
     1291           h-for-comp = h-main-buf
     1292         .
     1293       end.
     1294     end.
     1295     else do:
     1296       assign
     1297         h-for-comp = h-new-buf
     1298       .
     1299     end.
     1300     assign
     1301       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1302     .
     1303     do v-ind = 1 to v-num-entries
     1304     on error undo, return error return-value
     1305     :
     1306       assign
     1307         v-field-name = entry( v-ind, v-main-fld-lst )
     1308         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1309         v-old-value  = fh-old:buffer-value()
     1310         v-label      = trim( fh-old:label )
     1311       .
     1312       if ( trim( p-field-list ) <> "":U
     1313            and lookup( v-field-name, p-field-list ) > 0
     1314          )
     1315          or trim( p-field-list ) = "":U
     1316       then do:
     1317         if h-for-comp <> ? then do:
     1318           assign
     1319             fh-new      = h-for-comp:buffer-field( v-field-name )
     1320             v-new-value = fh-new:buffer-value()
     1321           .
     1322         end.
     1323         else do:
     1324           assign
     1325             v-new-value = "":U
     1326           .
     1327         end.
     1328           if p-act-create = true then do:
     1329             assign
     1330               v-old-value = "":U
     1331             .
     1332           end.
     1333           if p-act-delete = true then do:
     1334             assign
     1335               v-new-value = "":U
     1336             .
     1337           end.
     1338         if v-old-value <> v-new-value
     1339         then do:
     1340           create temp-changes.
     1341           assign
     1342             temp-changes.t_name = p-main-table
     1343             temp-changes.f_name = v-field-name
     1344             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1345             temp-changes.v_old  = trim( v-old-value )
     1346             temp-changes.v_new  = trim( v-new-value )
     1347             temp-changes.num_   = 0
     1348             temp-changes.fNotChange = v-old-value eq v-new-value
     1349           .
     1350         end.
     1351       end.
     1352     end.
     1353     assign
     1354       v-num-entries = num-entries( p-label-form, chr(8) )
     1355     .
     1356     do v-ind = 1 to v-num-entries
     1357     on error undo, return error return-value
     1358     :
     1359       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1360         assign
     1361           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1362           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1363           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1364         .
     1365         find first temp-changes
     1366           where temp-changes.f_name = v-field-name
     1367           no-error .
     1368         if available temp-changes then do:
     1369           if trim( v-field-lvl ) <> "":U then do:
     1370             assign
     1371               temp-changes.l_name = v-field-lvl
     1372             .
     1373           end.
     1374           if trim( v-field-form ) <> "":U then do:
     1375             assign
     1376               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1377             .
     1378             if h-for-comp <> ? then do:
     1379               assign
     1380                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1381               .
     1382             end.
     1383           end.
     1384         end.
     1385       end.
     1386       else do:
     1387         message
     1388           vss-workfile vss-revision vss-description skip
     1389           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1390           substitute( "список для поля '&1': '&2'"
     1391                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1392                       ,entry( v-ind, p-label-form, chr(8) )
     1393                     ) skip
     1394           substitute( "полный список: &2", p-label-form ) skip
     1395           view-as alert-box error .
     1396       end.
     1397     end.
     1398     delete object h-new-buf .
     1399     delete object h-main-buf .
     1400   END PROCEDURE.
     1401   FUNCTION get-action RETURNS CHARACTER
     1402     ( p-action as integer )  FORWARD.
     1403   FUNCTION get-source-type RETURNS CHARACTER
     1404     ( p-source-type as character )  FORWARD.
     1405   FUNCTION get-subject RETURNS CHARACTER
     1406     ( p-subject as character )  FORWARD.
     1407   FUNCTION local-open-br RETURNS logical
     1408     (  p-open-query     as logical    ,
     1409     p-find-next       as logical    ,
     1410     p-find-condition as character )  FORWARD.
     1411   DEFINE BUTTON B-Help
     1412        LABEL "Помо&щь"
     1413        SIZE 3 BY 1
     1414        BGCOLOR 8 .
     1415   DEFINE BUTTON B-mark
     1416        LABEL "&*"
     1417        SIZE 3 BY 1.
     1418   DEFINE BUTTON B-print
     1419        LABEL "Пе&чать"
     1420        SIZE 3 BY 1.
     1421   DEFINE BUTTON b-quit AUTO-END-KEY
     1422        LABEL "&Выход"
     1423        SIZE 10 BY 1
     1424        BGCOLOR 8 .
     1425   DEFINE BUTTON b-reason
     1426        LABEL "&Причина"
     1427        SIZE 10 BY 1.
     1428   DEFINE BUTTON B-sch
     1429        LABEL "&Фильтр"
     1430        SIZE 3 BY 1.
     1431   DEFINE BUTTON b-sel AUTO-GO
     1432        LABEL "Вы&бор"
     1433        SIZE 10 BY 1
     1434        BGCOLOR 8 .
     1435   DEFINE BUTTON b-nextlevel
     1436        LABEL "Детали"
     1437        SIZE 10 BY 1
     1438        BGCOLOR 8 .
     1439   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1440         VIEW-AS TEXT
     1441        SIZE 6 BY 1
     1442        FGCOLOR 4  NO-UNDO.
     1443   DEFINE VARIABLE sch-obj-code AS CHARACTER FORMAT "X(50)":U
     1444        LABEL "коду"
     1445        VIEW-AS FILL-IN
     1446        SIZE 10 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1447   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1448        LABEL "Дате изменения"
     1449        VIEW-AS FILL-IN
     1450        SIZE 11 BY 1 NO-UNDO.
     1451   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1452        LABEL "пользователю"
     1453        VIEW-AS FILL-IN
     1454        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1455   DEFINE VARIABLE sch-db-num AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1456        LABEL "БД"
     1457        VIEW-AS FILL-IN
     1458        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1459   DEFINE VARIABLE v-corr-user-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1460        LABEL "по БД"
     1461        VIEW-AS FILL-IN
     1462        SIZE 6 BY 1 NO-UNDO.
     1463   DEFINE QUERY BR-changes FOR
     1464         temp-changes SCROLLING.
     1465   DEFINE QUERY br-obj-hist FOR
     1466         X_c-obj-hist SCROLLING.
     1467   DEFINE BROWSE BR-changes
     1468     QUERY BR-changes DISPLAY
     1469         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(200)" width 40
     1470   temp-changes.v_old COLUMn-LABEL "Было" format "X(255)"
     1471   temp-changes.v_new COLUMn-LABEL "Стало" format "X(255)"
     1472       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1473   DEFINE BROWSE br-obj-hist
     1474     QUERY br-obj-hist NO-LOCK DISPLAY
     1475         mark-string(recid(X_c-obj-hist), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1476         X_c-obj-hist.id COLUMN-LABEL 'Код!КК' FORMAT '>>9':U
     1477         X_c-obj-hist.corr-date FORMAT "99/99/9999":U COLUMN-LABEL "Дата изм."
     1478         string(X_c-obj-hist.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1479         usrfulnf(X_c-obj-hist.corr-user-name) COLUMn-LABEL "Изменил" FORMAT "X(255)":U width 18
     1480         get-action(X_c-obj-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1481         X_c-obj-hist.corr-user-db-num FORMAT ">>>>9":U COLUMN-LABEL "Дб!созд."
     1482         X_c-obj-hist.is-news FORMAT "+/":U COLUMN-LABEL "Прием.!нов."
     1483         get-source-type(X_c-obj-hist.source-type) COLUMN-LABEL "Источн.!измен." WIDTH 7
     1484         X_c-obj-hist.source-ref FORMAT "X(20)":U COLUMN-LABEL "Ссылка на!источник." WIDTH 9
     1485          get-subject(X_c-obj-hist.subject) COLUMN-LABEL "Предмет изменения" FORMAT "X(35)":U WIDTH 15
     1486     ENABLE
     1487         X_c-obj-hist.corr-date
     1488       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1489   DEFINE FRAME Dialog-Frame
     1490        b-quit AT ROW 1 COL 1
     1491        B-mark AT ROW 1 COL 11
     1492        b-sel AT ROW 1 COL 21
     1493        v-corr-user-db-num AT ROW 1 COL 37 COLON-ALIGNED
     1494        b-nextlevel AT ROW 1 COL 70
     1495        b-reason AT ROW 1 COL 59
     1496        B-print AT ROW 1 COL 89
     1497        B-sch AT ROW 1 COL 92
     1498        B-Help AT ROW 1 COL 95
     1499        br-obj-hist AT ROW 2 COL 1
     1500        sch-db-num AT ROW 13.63 COL 60.13 COLON-ALIGNED
     1501        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1502        sch-obj-code AT ROW 13.67 COL 45.13 COLON-ALIGNED
     1503        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1504        BR-changes AT ROW 14.79 COL 1
     1505        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1506        "ПОИСК ПО" VIEW-AS TEXT
     1507             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1508             FGCOLOR 4
     1509        SPACE(89.48) SKIP(7.44)
     1510       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1511            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1512            TITLE
     1513            vlable
     1514            CANCEL-BUTTON b-quit.
     1515   ASSIGN
     1516          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1517          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1518   ASSIGN
     1519          br-obj-hist:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1520   ON GO OF FRAME Dialog-Frame
     1521   DO:
     1522     p-rid-list = v-rid-list.
     1523   END.
     1524   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1525   DO:
     1526     APPLY "END-ERROR":U TO SELF.
     1527   END.
     1528   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1529   DO:
     1530   define variable loc#log as logical no-undo .
     1531     if available X_c-obj-hist then do:
     1532   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1533   define variable v-str-recid15 as character no-undo .
     1534   define variable v-num-entry15 as integer   no-undo .
     1535   assign
     1536     v-str-recid15 = trim( string( recid( X_c-obj-hist ) , "->>>>>>>>>>>9":U ) )
     1537     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     1538   .
     1539   if v-num-entry15 > 0 then do:
     1540     assign
     1541       entry( v-num-entry15, v-rid-list ) = "":U
     1542       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1543     .
     1544   end.
     1545   else do:
     1546     assign
     1547       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1548     .
     1549   end.
     1550       loc#log = br-obj-hist:refresh() .
     1551       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1552           loc#log = br-obj-hist:select-next-row ().
     1553           apply "VALUE-CHANGED" to br-obj-hist in frame Dialog-Frame.
     1554       end.
     1555       if num-entries( v-rid-list ) = 0
     1556       then
     1557           hide mark-num in frame Dialog-Frame.
     1558       else
     1559           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1560     end.
     1561     apply "entry" to br-obj-hist in frame Dialog-Frame.
     1562   END.
     1563   ON CHOOSE OF b-nextlevel IN FRAME Dialog-Frame
     1564   DO:
     1565      define variable vRun as character no-undo.
     1566      vRun = this-procedure:file-name.
     1567      run value(vRun)
     1568         (
     1569          parParentProc,
     1570          p-curr-host-code,
     1571          p-curr-obj-type,
     1572          p-curr-obj-code,
     1573          bttns,
     1574          "one",
     1575          p-corr-user-db-num,
     1576          p-corr-user-name,
     1577          p-subject,
     1578          p-db-num,
     1579          X_c-obj-hist.chip-num ,
     1580          input-output p-rid-list ).
     1581      apply "entry" to br-obj-hist in frame Dialog-Frame.
     1582   END.
     1583   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1584   DO:
     1585       run proc-b-print in this-procedure no-error.
     1586     if error-status:error then return no-apply.
     1587   END.
     1588   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1589   DO:
     1590       run proc-b-sch in this-procedure no-error.
     1591     if error-status:error then return no-apply.
     1592   END.
     1593   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1594   DO:
     1595     if ( available X_c-obj-hist ) then do:
     1596       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1597       then
     1598       v-rid-list = string( recid( X_c-obj-hist ) ) .
     1599     end.
     1600   END.
     1601   ON MOUSE-SELECT-DBLCLICK OF br-obj-hist IN FRAME Dialog-Frame
     1602   DO:
     1603        run proc-br-obj-hist in this-procedure no-error.
     1604     if error-status:error then return no-apply.
     1605   END.
     1606   ON RETURN OF br-obj-hist IN FRAME Dialog-Frame
     1607   DO:
     1608       run proc-br-obj-hist in this-procedure no-error.
     1609     if error-status:error then return no-apply.
     1610   END.
     1611   ON VALUE-CHANGED OF br-obj-hist IN FRAME Dialog-Frame
     1612   DO:
     1613     run proc-view-changes in this-procedure no-error.
     1614   END.
     1615   ON CTRL-J OF sch-obj-code IN FRAME Dialog-Frame
     1616   DO:
     1617     run proc-find-obj-code in this-procedure(yes, input frame Dialog-Frame sch-obj-code) no-error.
     1618     if error-status:error then return no-apply.
     1619   END.
     1620   ON RETURN OF sch-obj-code IN FRAME Dialog-Frame
     1621   DO:
     1622     run proc-find-obj-code in this-procedure(no, input frame Dialog-Frame sch-obj-code) no-error.
     1623     if error-status:error then return no-apply.
     1624   END.
     1625   ON CTRL-J OF sch-corr-date IN FRAME Dialog-Frame
     1626   DO:
     1627      run proc-find-corr-date in this-procedure(yes, input frame Dialog-Frame sch-corr-date) no-error.
     1628     if error-status:error then return no-apply.
     1629   END.
     1630   ON RETURN OF sch-corr-date IN FRAME Dialog-Frame
     1631   DO:
     1632     run proc-find-corr-date in this-procedure(no, input frame Dialog-Frame sch-corr-date) no-error.
     1633     if error-status:error then return no-apply.
     1634   END.
     1635   ON CTRL-J OF sch-corr-user-name IN FRAME Dialog-Frame
     1636   DO:
     1637     run proc-find-user in this-procedure(yes, input frame Dialog-Frame sch-corr-user-name) no-error.
     1638     if error-status:error then return no-apply.
     1639   END.
     1640   ON RETURN OF sch-corr-user-name IN FRAME Dialog-Frame
     1641   DO:
     1642     run proc-find-user in this-procedure(no, input frame Dialog-Frame sch-corr-user-name) no-error.
     1643     if error-status:error then return no-apply.
     1644   END.
     1645   ON CTRL-J OF sch-db-num IN FRAME Dialog-Frame
     1646   DO:
     1647     run proc-find-db-num in this-procedure(yes, input frame Dialog-Frame sch-db-num) no-error.
     1648     if error-status:error then return no-apply.
     1649   END.
     1650   ON RETURN OF sch-db-num IN FRAME Dialog-Frame
     1651   DO:
     1652     run proc-find-db-num in this-procedure(no, input frame Dialog-Frame sch-db-num) no-error.
     1653     if error-status:error then return no-apply.
     1654   END.
     1655   ON RETURN OF v-corr-user-db-num IN FRAME Dialog-Frame
     1656   DO:
     1657     assign
     1658     v-corr-user-db-num
     1659     .
     1660     RUn OpenBR(yes, no, '':U, v-corr-user-db-num).
     1661   END.
     1662   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1663   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1664   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1665   on help of frame Dialog-Frame
     1666   do:
     1667     run gbl/app_help.p
     1668       (input this-procedure :file-name
     1669       ,input ''
     1670       ,input ?
     1671       ) no-error.
     1672     if error-status :error then do:
     1673       message
     1674         "Ошибка при вызове помощи"
     1675         error-status :get-message(1)
     1676         view-as alert-box .
     1677     end.
     1678   end.
     1679   run minbtn-set in this-procedure .
     1680   on choose of b-help in frame Dialog-Frame
     1681   do:
     1682     apply "help":u to frame Dialog-Frame .
     1683   end.
     1684   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1685   procedure minbtn-set :
     1686       do
     1687           on error undo, return error return-value
     1688           :
     1689           define variable ii              as integer       no-undo .
     1690           define variable fh              as widget-handle no-undo .
     1691           define variable hh              as widget-handle no-undo .
     1692           define variable v-h             as handle        extent 4 no-undo .
     1693           define variable v-name-button   as character     no-undo .
     1694           define variable v-help-old-x    as decimal       no-undo .
     1695           define variable v-help-old-y    as decimal       no-undo .
     1696           define variable v-help-old-size as decimal       no-undo .
     1697           define variable v-frame-width   as decimal       no-undo .
     1698           define variable jj              as integer       no-undo .
     1699           do
     1700               on error undo, return error
     1701               :
     1702               assign
     1703                   v-frame-width = frame Dialog-Frame:width - 0.3
     1704                   fh            = frame Dialog-Frame:first-child
     1705                   hh            = fh:first-child
     1706                   ii            = 1
     1707                   .
     1708               do while valid-handle(hh):
     1709                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1710                   do:
     1711                       case lc(hh:name) :
     1712                           when "b-help" then
     1713                               do:
     1714                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1715                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1716                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1717                                   hh:TOOLTIP = "Помощь" .
     1718                                   v-help-old-x = hh:column .
     1719                                   v-help-old-y = hh:row    .
     1720                                   v-help-old-size = hh:width .
     1721                                   hh:width-chars = 2.5 .
     1722                               end.
     1723                           when "b-print" then
     1724                               do:
     1725                                   hh:load-image("cmp/b-print.bmp":u) .
     1726                                   hh:TOOLTIP = "Печать" .
     1727                                   v-h[ii] = hh:handle .
     1728                                   ii = ii + 1 .
     1729                                   hh:width-chars = 3 .
     1730                               end.
     1731                           when "b-history" or
     1732                           when "b-hist" then
     1733                               do:
     1734                                   hh:load-image("cmp/b-hist.bmp":u) .
     1735                                   hh:TOOLTIP = "История" .
     1736                                   v-h[ii] = hh:handle .
     1737                                   ii = ii + 1 .
     1738                                   hh:width-chars = 3 .
     1739                               end.
     1740                           when "b-sch" then
     1741                               do:
     1742                                   hh:load-image("cmp/b-sch.bmp":u) .
     1743                                   hh:TOOLTIP = "Установка Фильтра" .
     1744                                   v-h[ii] = hh:handle .
     1745                                   ii = ii + 1 .
     1746                                   hh:width-chars = 3 .
     1747                               end.
     1748                           when "b-hist-user" then
     1749                               do:
     1750                                   hh:load-image("cmp/b-hist.bmp":u) .
     1751                                   hh:TOOLTIP = "История пользователя" .
     1752                                   ii = ii + 1 .
     1753                               end.
     1754                       end case.
     1755                   end.
     1756                   hh = hh:next-sibling.
     1757               end.
     1758               b-help:column = v-frame-width - b-help:width-chars.
     1759               jj = 0.
     1760               repeat ii = 4 to 1 by -1 :
     1761                   if valid-handle (v-h[ii] ) then
     1762                   do:
     1763                       jj  = jj + 1 .
     1764                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1765                       v-h[ii]:row    = v-help-old-y .
     1766                   end.
     1767               end.
     1768           end.
     1769       end.
     1770   end procedure.
     1771   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1772   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1773   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1774   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1775   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1776   define variable v-diasize-current-frame-height as decimal   no-undo .
     1777   define variable v-diasize-change-size          as logical   no-undo .
     1778   define variable v-diasize-resize-button        as handle    no-undo .
     1779   define variable v-diasize-wndmax               as logical   no-undo .
     1780   define variable v-diasize-wndstore             as logical   no-undo .
     1781   define variable v-diasize-proc-name            as character no-undo .
     1782   define variable v-diasize-browse-handle        as handle    no-undo .
     1783   define variable v-diasize-browse-number        as integer   no-undo .
     1784   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1785   define temp-table temp-diasize-handle no-undo
     1786     field handle-value  as handle
     1787     field save-position as decimal
     1788     index xpk is primary unique handle-value
     1789     .
     1790   define temp-table temp-browse-handle no-undo
     1791     field browse-type   as character
     1792     field browse-number as integer
     1793     field browse-handle as handle
     1794     field original-size as decimal
     1795     index xpk is primary unique browse-type browse-number
     1796     index xie browse-type browse-handle
     1797   .
     1798   procedure diasize_change-height :
     1799     define input  parameter p-change-value  as decimal   no-undo .
     1800     define input  parameter p-move-resize   as logical   no-undo .
     1801     define variable v-field-group-handle    as handle    no-undo .
     1802     define variable v-object-handle         as handle    no-undo .
     1803     define variable v-frame-height          as decimal   no-undo .
     1804     define variable v-frame-virtual-height  as decimal   no-undo .
     1805     define variable v-browse-height         as decimal   no-undo .
     1806     define variable v-window-height         as decimal   no-undo .
     1807     define variable v-window-virtual-height as decimal   no-undo .
     1808     define variable v-change-sign           as integer   no-undo .
     1809     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1810     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1811     if p-change-value > 0
     1812     then do:
     1813       if frame Dialog-Frame :height + p-change-value
     1814           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1815       then do:
     1816         assign
     1817           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1818                           - (frame Dialog-Frame :height-chars)
     1819         .
     1820         if p-change-value <= 0
     1821         then do:
     1822           run diasize_position-resize-button in this-procedure .
     1823           return .
     1824         end.
     1825       end.
     1826     end.
     1827     if p-change-value < 0
     1828     then do:
     1829       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1830       then do:
     1831         assign
     1832           p-change-value = v-diasize-orig-frame-height
     1833                          - (frame Dialog-Frame :height-chars)
     1834         .
     1835         if p-change-value >= 0
     1836         then do:
     1837           run diasize_position-resize-button in this-procedure .
     1838           return .
     1839         end.
     1840       end.
     1841     end.
     1842     if p-change-value >= 0
     1843     then do:
     1844       assign
     1845         v-change-sign = 1
     1846       .
     1847     end.
     1848     else do:
     1849       assign
     1850         v-change-sign = -1
     1851       .
     1852     end.
     1853     assign
     1854       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1855     .
     1856     if p-change-value = 0
     1857     then do:
     1858       run diasize_position-resize-button in this-procedure .
     1859       return .
     1860     end.
     1861     move_block:
     1862     do
     1863     on error undo move_block, retry move_block
     1864     :
     1865       if retry
     1866       then do:
     1867         do
     1868         on error undo move_block, leave move_block
     1869         :
     1870           if p-change-value > 0
     1871           then do:
     1872             for each buf_temp-diasize-handle
     1873             on error undo, next
     1874             :
     1875               assign
     1876                 v-object-handle = buf_temp-diasize-handle.handle-value
     1877               .
     1878               if v-object-handle <> v-diasize-resize-button
     1879               then do:
     1880                 assign
     1881                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1882                 .
     1883               end.
     1884             end.
     1885             assign
     1886               v-diasize-browse-handle :height = v-browse-height
     1887             .
     1888             for each buf_temp-browse-handle
     1889               where buf_temp-browse-handle.browse-type = 'height':u
     1890             on error undo, next
     1891             :
     1892               assign
     1893                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1894               .
     1895             end.
     1896             assign
     1897               frame Dialog-Frame :height = v-frame-height
     1898             .
     1899             if frame Dialog-Frame :scrollable = true
     1900             then do:
     1901               assign
     1902                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1903               .
     1904             end.
     1905             run diasize_position-resize-button in this-procedure .
     1906           end.
     1907           else do:
     1908             if frame Dialog-Frame :scrollable = true
     1909             then do:
     1910               assign
     1911                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1912               .
     1913             end.
     1914             assign
     1915               frame Dialog-Frame :height = v-frame-height
     1916             .
     1917             assign
     1918               v-diasize-browse-handle :height = v-browse-height
     1919             .
     1920             for each buf_temp-browse-handle
     1921               where buf_temp-browse-handle.browse-type = 'height':u
     1922             on error undo, next
     1923             :
     1924               assign
     1925                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1926               .
     1927             end.
     1928             for each buf_temp-diasize-handle
     1929             on error undo, next
     1930             :
     1931               assign
     1932                 v-object-handle = buf_temp-diasize-handle.handle-value
     1933               .
     1934               if v-object-handle <> v-diasize-resize-button
     1935               then do:
     1936                 assign
     1937                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1938                 .
     1939               end.
     1940             end.
     1941             run diasize_position-resize-button in this-procedure .
     1942           end.
     1943           assign
     1944             v-diasize-change-size = false
     1945           .
     1946           leave move_block .
     1947         end.
     1948       end.
     1949       assign
     1950         v-diasize-need-full-display = true
     1951       .
     1952       if v-diasize-change-size = false
     1953       then do:
     1954         assign
     1955           v-diasize-change-size = true
     1956         .
     1957       end.
     1958       else do:
     1959         return .
     1960       end.
     1961       assign
     1962         v-frame-height = frame Dialog-Frame :height
     1963         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1964         v-browse-height = v-diasize-browse-handle :height
     1965       .
     1966       for each buf_temp-browse-handle
     1967         where buf_temp-browse-handle.browse-type = 'height':u
     1968       :
     1969         assign
     1970           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1971         .
     1972       end.
     1973       for each buf_temp-diasize-handle
     1974       :
     1975         delete buf_temp-diasize-handle .
     1976       end.
     1977       assign
     1978         v-field-group-handle = frame Dialog-Frame :first-child
     1979       .
     1980       do while valid-handle(v-field-group-handle)
     1981       :
     1982         assign
     1983           v-object-handle = v-field-group-handle :first-child
     1984         .
     1985         do while valid-handle(v-object-handle)
     1986         :
     1987           if  v-object-handle <> v-diasize-browse-handle :handle
     1988           and can-query(v-object-handle, "row")
     1989           and can-query(v-object-handle, "height")
     1990           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1991           then do:
     1992             find first buf_temp-browse-handle
     1993               where buf_temp-browse-handle.browse-type   = 'height':u
     1994                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1995               no-error .
     1996             if available buf_temp-browse-handle
     1997             then do:
     1998             end.
     1999             else do:
     2000               create buf_temp-diasize-handle .
     2001               assign
     2002                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2003                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2004               .
     2005             end.
     2006           end.
     2007           assign
     2008             v-object-handle = v-object-handle :next-sibling
     2009           .
     2010         end.
     2011         assign
     2012           v-field-group-handle = v-field-group-handle :next-sibling
     2013         .
     2014       end.
     2015       do with frame Dialog-Frame
     2016       :
     2017         hide v-diasize-resize-button .
     2018         assign
     2019           v-diasize-resize-button :row    = 1
     2020           v-diasize-resize-button :column = 1
     2021         .
     2022       end.
     2023       if p-change-value > 0
     2024       then do:
     2025         if frame Dialog-Frame :scrollable = true
     2026         then do:
     2027           assign
     2028             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2029             no-error .
     2030           if error-status :error
     2031           or error-status :get-message(1) <> ""
     2032           then do:
     2033             undo move_block, retry move_block .
     2034           end.
     2035         end.
     2036         assign
     2037           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2038           no-error .
     2039         if error-status :error
     2040         or error-status :get-message(1) <> ""
     2041         then do:
     2042           undo move_block, retry move_block .
     2043         end.
     2044         assign
     2045           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2046           no-error .
     2047         if error-status :error
     2048         or error-status :get-message(1) <> ""
     2049         then do:
     2050           undo move_block, retry move_block .
     2051         end.
     2052         for each buf_temp-browse-handle
     2053           where buf_temp-browse-handle.browse-type = 'height':u
     2054         on error undo move_block, retry move_block
     2055         :
     2056           assign
     2057             buf_temp-browse-handle.browse-handle :height
     2058               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2059             no-error .
     2060           if error-status :error
     2061           or error-status :get-message(1) <> ""
     2062           then do:
     2063             undo move_block, retry move_block .
     2064           end.
     2065         end.
     2066         for each buf_temp-diasize-handle
     2067         on error undo move_block, retry move_block
     2068         :
     2069           assign
     2070             v-object-handle = buf_temp-diasize-handle.handle-value
     2071           .
     2072           if v-object-handle <> v-diasize-resize-button
     2073           then do:
     2074             assign
     2075               v-object-handle :row = v-object-handle :row + p-change-value
     2076               no-error .
     2077             if error-status :error
     2078             or error-status :get-message(1) <> ""
     2079             then do:
     2080               undo move_block, retry move_block .
     2081             end.
     2082           end.
     2083         end.
     2084       end.
     2085       else do:
     2086         for each buf_temp-diasize-handle
     2087         on error undo move_block, retry move_block
     2088         :
     2089           assign
     2090             v-object-handle = buf_temp-diasize-handle.handle-value
     2091           .
     2092           if v-object-handle <> v-diasize-resize-button
     2093           then do:
     2094             assign
     2095               v-object-handle :row = v-object-handle :row + p-change-value
     2096               no-error .
     2097             if error-status :error
     2098             or error-status :get-message(1) <> ""
     2099             then do:
     2100               undo move_block, retry move_block .
     2101             end.
     2102           end.
     2103         end.
     2104         assign
     2105           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2106           no-error .
     2107         if error-status :error
     2108         or error-status :get-message(1) <> ""
     2109         then do:
     2110           undo move_block, retry move_block .
     2111         end.
     2112         for each buf_temp-browse-handle
     2113           where buf_temp-browse-handle.browse-type = 'height':u
     2114         on error undo move_block, retry move_block
     2115         :
     2116           assign
     2117             buf_temp-browse-handle.browse-handle :height
     2118               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2119             no-error .
     2120           if error-status :error
     2121           or error-status :get-message(1) <> ""
     2122           then do:
     2123             undo move_block, retry move_block .
     2124           end.
     2125         end.
     2126         assign
     2127           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2128           no-error .
     2129         if error-status :error
     2130         or error-status :get-message(1) <> ""
     2131         then do:
     2132           undo move_block, retry move_block .
     2133         end.
     2134         if frame Dialog-Frame :scrollable = true
     2135         then do:
     2136           assign
     2137             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2138             no-error .
     2139           if error-status :error
     2140           or error-status :get-message(1) <> ""
     2141           then do:
     2142             undo move_block, retry move_block .
     2143           end.
     2144         end.
     2145       end.
     2146       if p-move-resize = true
     2147       then do:
     2148         run diasize_position-resize-button in this-procedure .
     2149       end.
     2150       if v-diasize-wndstore = true
     2151       then do:
     2152         if connected("ub") = true
     2153         then do:
     2154           define variable v-cntxt-db-num        as integer   no-undo .
     2155           define variable v-cntxt-userid        as character no-undo .
     2156           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2157                                             , OUTPUT v-cntxt-userid
     2158                                             ) .
     2159           run gbl/wndsizew.p
     2160             (input  v-cntxt-db-num
     2161             ,input  v-cntxt-userid
     2162             ,input  v-diasize-proc-name
     2163             ,input  'height':u
     2164             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2165             ) .
     2166         end.
     2167       end.
     2168     end.
     2169     assign
     2170       v-diasize-change-size = false
     2171     .
     2172   end procedure.
     2173   procedure diasize_set-height :
     2174     define input  parameter p-new-height  as decimal   no-undo .
     2175     define input  parameter p-move-resize as logical   no-undo .
     2176     do
     2177     on error undo, return error return-value
     2178     :
     2179       run diasize_change-height in this-procedure
     2180         (input  (p-new-height - frame Dialog-Frame :height)
     2181         ,input  p-move-resize
     2182         ) .
     2183     end.
     2184   end procedure.
     2185   procedure diasize_change-width :
     2186     define input  parameter p-change-value as decimal   no-undo .
     2187     define input  parameter p-move-resize  as logical   no-undo .
     2188     define variable v-field-group-handle   as handle    no-undo .
     2189     define variable v-object-handle        as handle    no-undo .
     2190     define variable v-frame-width          as decimal   no-undo .
     2191     define variable v-frame-virtual-width  as decimal   no-undo .
     2192     define variable v-browse-width         as decimal   no-undo .
     2193     define variable v-window-width         as decimal   no-undo .
     2194     define variable v-window-virtual-width as decimal   no-undo .
     2195     define variable v-change-sign          as integer   no-undo .
     2196     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2197     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2198     if p-change-value > 0
     2199     then do:
     2200       if frame Dialog-Frame :width + p-change-value >
     2201           session :width-chars
     2202       then do:
     2203         assign
     2204           p-change-value = session :width-chars - frame Dialog-Frame :width
     2205         .
     2206         if p-change-value <= 0
     2207         then do:
     2208           run diasize_position-resize-button in this-procedure .
     2209           return .
     2210         end.
     2211       end.
     2212     end.
     2213     if p-change-value < 0
     2214     then do:
     2215       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2216       then do:
     2217         assign
     2218           p-change-value = v-diasize-orig-frame-width
     2219                          - frame Dialog-Frame :width
     2220         .
     2221         if p-change-value >= 0
     2222         then do:
     2223           run diasize_position-resize-button in this-procedure .
     2224           return .
     2225         end.
     2226       end.
     2227     end.
     2228     if p-change-value >= 0
     2229     then do:
     2230       assign
     2231         v-change-sign = 1
     2232       .
     2233     end.
     2234     else do:
     2235       assign
     2236         v-change-sign = -1
     2237       .
     2238     end.
     2239     assign
     2240       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2241     .
     2242     if p-change-value = 0
     2243     then do:
     2244       run diasize_position-resize-button in this-procedure .
     2245       return .
     2246     end.
     2247     move_block:
     2248     do
     2249     on error undo move_block, leave move_block
     2250     :
     2251       if retry
     2252       then do:
     2253         do
     2254         on error undo move_block, leave move_block
     2255         :
     2256           if p-change-value > 0
     2257           then do:
     2258             for each buf_temp-diasize-handle
     2259             on error undo, next
     2260             :
     2261               assign
     2262                 v-object-handle = buf_temp-diasize-handle.handle-value
     2263               .
     2264               if v-object-handle <> v-diasize-resize-button
     2265               then do:
     2266                 assign
     2267                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2268                 .
     2269               end.
     2270             end.
     2271             assign
     2272               v-diasize-browse-handle :width = v-browse-width
     2273             .
     2274             for each buf_temp-browse-handle
     2275               where buf_temp-browse-handle.browse-type = 'width':u
     2276             on error undo, next
     2277             :
     2278               assign
     2279                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2280               .
     2281             end.
     2282             assign
     2283               frame Dialog-Frame :width = v-frame-width
     2284             .
     2285             if frame Dialog-Frame :scrollable = true
     2286             then do:
     2287               assign
     2288                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2289               .
     2290             end.
     2291             run diasize_position-resize-button in this-procedure .
     2292           end.
     2293           else do:
     2294             if frame Dialog-Frame :scrollable = true
     2295             then do:
     2296               assign
     2297                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2298               .
     2299             end.
     2300             assign
     2301               frame Dialog-Frame :width = v-frame-width
     2302             .
     2303             for each buf_temp-browse-handle
     2304               where buf_temp-browse-handle.browse-type = 'width':u
     2305             on error undo, next
     2306             :
     2307               assign
     2308                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2309               .
     2310             end.
     2311             assign
     2312               v-diasize-browse-handle :width = v-browse-width
     2313             .
     2314             for each buf_temp-diasize-handle
     2315             on error undo, next
     2316             :
     2317               assign
     2318                 v-object-handle = buf_temp-diasize-handle.handle-value
     2319               .
     2320               if v-object-handle <> v-diasize-resize-button
     2321               then do:
     2322                 assign
     2323                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2324                 .
     2325               end.
     2326             end.
     2327             run diasize_position-resize-button in this-procedure .
     2328           end.
     2329           assign
     2330             v-diasize-change-size = false
     2331           .
     2332           leave move_block .
     2333         end.
     2334       end.
     2335       assign
     2336         v-diasize-need-full-display = true
     2337       .
     2338       if v-diasize-change-size = false
     2339       then do:
     2340         assign
     2341           v-diasize-change-size = true
     2342         .
     2343       end.
     2344       else do:
     2345         return .
     2346       end.
     2347       assign
     2348         v-frame-width = frame Dialog-Frame :width
     2349         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2350         v-browse-width = v-diasize-browse-handle :width
     2351       .
     2352       for each buf_temp-browse-handle
     2353         where buf_temp-browse-handle.browse-type = 'width':u
     2354       :
     2355         assign
     2356           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2357         .
     2358       end.
     2359       for each buf_temp-diasize-handle
     2360       :
     2361         delete buf_temp-diasize-handle .
     2362       end.
     2363       assign
     2364         v-field-group-handle = frame Dialog-Frame :first-child
     2365       .
     2366       do while valid-handle(v-field-group-handle)
     2367       :
     2368         assign
     2369           v-object-handle = v-field-group-handle :first-child
     2370         .
     2371         do while valid-handle(v-object-handle)
     2372         :
     2373           if  v-object-handle <> v-diasize-browse-handle :handle
     2374           and v-object-handle <> v-diasize-resize-button
     2375           and can-query(v-object-handle, "row")
     2376           and can-query(v-object-handle, "height")
     2377           and ( v-object-handle :col + v-object-handle :width
     2378                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2379               )
     2380           then do:
     2381             find first buf_temp-browse-handle
     2382               where buf_temp-browse-handle.browse-type   = 'width':u
     2383                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2384               no-error .
     2385             if available buf_temp-browse-handle
     2386             then do:
     2387             end.
     2388             else do:
     2389               create buf_temp-diasize-handle .
     2390               assign
     2391                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2392                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2393               .
     2394             end.
     2395           end.
     2396           assign
     2397             v-object-handle = v-object-handle :next-sibling
     2398           .
     2399         end.
     2400         assign
     2401           v-field-group-handle = v-field-group-handle :next-sibling
     2402         .
     2403       end.
     2404       do with frame Dialog-Frame
     2405       :
     2406         hide v-diasize-resize-button .
     2407         v-diasize-resize-button :row = 1.
     2408         v-diasize-resize-button :column = 1.
     2409       end.
     2410       if p-change-value > 0
     2411       then do:
     2412         if frame Dialog-Frame :scrollable = true
     2413         then do:
     2414           assign
     2415             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2416             no-error .
     2417           if error-status :error
     2418           or error-status :get-message(1) <> ""
     2419           then do:
     2420             undo move_block, retry move_block.
     2421           end.
     2422         end.
     2423         assign
     2424           frame Dialog-Frame :width = v-frame-width + p-change-value
     2425           no-error .
     2426         if error-status :error
     2427         or error-status :get-message(1) <> ""
     2428         then do:
     2429           undo move_block, retry move_block.
     2430         end.
     2431         assign
     2432           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2433         no-error .
     2434         if error-status :error
     2435         or error-status :get-message(1) <> ""
     2436         then do:
     2437           undo move_block, retry move_block.
     2438         end.
     2439         for each buf_temp-browse-handle
     2440           where buf_temp-browse-handle.browse-type = 'width':u
     2441         on error undo move_block, retry move_block
     2442         :
     2443           assign
     2444             buf_temp-browse-handle.browse-handle :width
     2445               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2446             no-error .
     2447           if error-status :error
     2448           or error-status :get-message(1) <> ""
     2449           then do:
     2450             undo move_block, retry move_block .
     2451           end.
     2452         end.
     2453         for each buf_temp-diasize-handle
     2454         on error undo move_block, retry move_block
     2455         :
     2456           assign
     2457             v-object-handle = buf_temp-diasize-handle.handle-value
     2458           .
     2459           if v-object-handle <> v-diasize-resize-button
     2460           then do:
     2461             assign
     2462               v-object-handle :col = v-object-handle :col + p-change-value
     2463               no-error .
     2464             if error-status :error
     2465             or error-status :get-message(1) <> ""
     2466             then do:
     2467               undo move_block, retry move_block .
     2468             end.
     2469           end.
     2470         end.
     2471       end.
     2472       else do:
     2473         for each buf_temp-diasize-handle
     2474         on error undo move_block, retry move_block
     2475         :
     2476           assign
     2477             v-object-handle = buf_temp-diasize-handle.handle-value
     2478           .
     2479           if v-object-handle <> v-diasize-resize-button
     2480           then do:
     2481             assign
     2482               v-object-handle :col = v-object-handle :col + p-change-value
     2483               no-error .
     2484             if error-status :error
     2485             or error-status :get-message(1) <> ""
     2486             then do:
     2487               undo move_block, retry move_block .
     2488             end.
     2489           end.
     2490         end.
     2491         for each buf_temp-browse-handle
     2492           where buf_temp-browse-handle.browse-type = 'width':u
     2493         on error undo move_block, retry move_block
     2494         :
     2495           assign
     2496             buf_temp-browse-handle.browse-handle :width
     2497               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2498             no-error .
     2499           if error-status :error
     2500           or error-status :get-message(1) <> ""
     2501           then do:
     2502             undo move_block, retry move_block .
     2503           end.
     2504         end.
     2505         assign
     2506           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2507           no-error .
     2508         if error-status :error
     2509         or error-status :get-message(1) <> ""
     2510         then do:
     2511           undo move_block, retry move_block.
     2512         end.
     2513         assign
     2514           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2515         no-error .
     2516         if error-status :error
     2517         or error-status :get-message(1) <> ""
     2518         then do:
     2519           undo move_block, retry move_block.
     2520         end.
     2521         if frame Dialog-Frame :scrollable = true
     2522         then do:
     2523           assign
     2524             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2525           no-error .
     2526           if error-status :error
     2527           or error-status :get-message(1) <> ""
     2528           then do:
     2529             undo move_block, retry move_block.
     2530           end.
     2531         end.
     2532       end.
     2533       if p-move-resize
     2534       then do:
     2535         run diasize_position-resize-button in this-procedure .
     2536       end.
     2537       if v-diasize-wndstore = true
     2538       then do:
     2539         if connected("ub") = true
     2540         then do:
     2541           define variable v-cntxt-db-num        as integer   no-undo .
     2542           define variable v-cntxt-userid        as character no-undo .
     2543           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2544                                             , OUTPUT v-cntxt-userid
     2545                                             ) .
     2546           run gbl/wndsizew.p
     2547             (input  v-cntxt-db-num
     2548             ,input  v-cntxt-userid
     2549             ,input  v-diasize-proc-name
     2550             ,input  'width':u
     2551             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2552             ) .
     2553         end.
     2554       end.
     2555     end.
     2556     assign
     2557       v-diasize-change-size = false
     2558     .
     2559   end procedure.
     2560   procedure diasize_set-width :
     2561     define input  parameter p-new-width  as decimal   no-undo .
     2562     define input  parameter p-move-resize as logical   no-undo .
     2563     do
     2564     on error undo, return error return-value
     2565     :
     2566       run diasize_change-width in this-procedure
     2567         (input  (p-new-width - frame Dialog-Frame :width)
     2568         ,input  p-move-resize
     2569         ) .
     2570     end.
     2571   end procedure.
     2572   procedure diasize_position-resize-button :
     2573     do with frame Dialog-Frame
     2574     :
     2575       hide v-diasize-resize-button .
     2576       assign
     2577         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2578                     - 1
     2579                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2580         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2581                     - 1
     2582                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2583       .
     2584       view v-diasize-resize-button .
     2585     end.
     2586   end procedure.
     2587   on alt-right anywhere
     2588   do:
     2589     run diasize_change-width in this-procedure
     2590       (input 1
     2591       ,input true
     2592       ) .
     2593     return no-apply .
     2594   end.
     2595   on alt-left anywhere
     2596   do:
     2597     run diasize_change-width in this-procedure
     2598       (input -1
     2599       ,input true
     2600       ) .
     2601     return no-apply .
     2602   end.
     2603   on alt-down anywhere
     2604   do:
     2605     run diasize_change-height in this-procedure
     2606       (input 1
     2607       ,input true
     2608       ) .
     2609     return no-apply .
     2610   end.
     2611   on alt-up anywhere
     2612   do:
     2613     run diasize_change-height in this-procedure
     2614       (input -1
     2615       ,input true
     2616       ) .
     2617     return no-apply .
     2618   end.
     2619   on alt-enter of frame Dialog-Frame
     2620   do:
     2621     run diasize_maximize in this-procedure
     2622       (input  ?
     2623       ).
     2624     return no-apply .
     2625   end.
     2626   procedure diasize_end-move :
     2627     do
     2628     on error undo, return error return-value
     2629     :
     2630       define variable v-row-delta as decimal   no-undo .
     2631       define variable v-col-delta as decimal   no-undo .
     2632       define variable v-new-row as decimal   no-undo .
     2633       define variable v-new-col as decimal   no-undo .
     2634       assign
     2635         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2636         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2637       .
     2638       assign
     2639         v-row-delta = v-new-row - frame Dialog-Frame :height
     2640         v-col-delta = v-new-col - frame Dialog-Frame :width
     2641       .
     2642       run diasize_change-height in this-procedure
     2643         (input v-row-delta
     2644         ,input true
     2645         ) .
     2646       run diasize_change-width in this-procedure
     2647         (input v-col-delta
     2648         ,input true
     2649         ) .
     2650     end.
     2651   end procedure.
     2652   procedure diasize_maximize :
     2653     define input  parameter p-action as logical   no-undo .
     2654     do
     2655     on error undo, return error return-value
     2656     :
     2657       if p-action = ?
     2658       then do:
     2659         if v-diasize-need-maximize = true
     2660         then do:
     2661           assign
     2662             p-action = true
     2663           .
     2664         end.
     2665         else do:
     2666           assign
     2667             p-action = false
     2668           .
     2669         end.
     2670       end.
     2671       if p-action = true
     2672       then do:
     2673         run diasize_change-height in this-procedure
     2674           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2675               - frame Dialog-Frame :height-chars
     2676           ,input true
     2677           ) .
     2678         run diasize_change-width in this-procedure
     2679           (input session :width-chars
     2680               - frame Dialog-Frame :width-chars
     2681           ,input true
     2682           ) .
     2683         assign
     2684           v-diasize-need-maximize = false
     2685         .
     2686       end.
     2687       else do:
     2688         run diasize_change-width in this-procedure
     2689           (input v-diasize-orig-frame-width
     2690               - frame Dialog-Frame :width-chars
     2691           ,input true
     2692           ) .
     2693         run diasize_change-height in this-procedure
     2694           (input v-diasize-orig-frame-height
     2695               - frame Dialog-Frame :height-chars
     2696           ,input true
     2697           ) .
     2698         assign
     2699           v-diasize-need-maximize = true
     2700         .
     2701       end.
     2702     end.
     2703   end procedure.
     2704   procedure diasize_restore-orig-size :
     2705     do
     2706     on error undo, return error return-value
     2707     :
     2708       assign
     2709         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2710         v-diasize-current-frame-height = frame Dialog-Frame :height
     2711       .
     2712       run diasize_set-height in this-procedure
     2713         (input  v-diasize-orig-frame-height
     2714         ,input  true
     2715         ) .
     2716       run diasize_set-width in this-procedure
     2717         (input  v-diasize-orig-frame-width
     2718         ,input  true
     2719         ) .
     2720     end.
     2721   end procedure.
     2722   procedure diasize_restore-current-size :
     2723     do
     2724     on error undo, return error return-value
     2725     :
     2726       run diasize_set-height in this-procedure
     2727         (input  v-diasize-current-frame-height
     2728         ,input  true
     2729         ) .
     2730       run diasize_set-width in this-procedure
     2731         (input  v-diasize-current-frame-width
     2732         ,input  true
     2733         ) .
     2734     end.
     2735   end procedure.
     2736   procedure diasize_set-browse-handle :
     2737     define input  parameter p-browse-handle as handle   no-undo .
     2738     define buffer buf_temp-browse-handle for temp-browse-handle .
     2739     do
     2740     on error undo, return error return-value
     2741     :
     2742       assign
     2743         v-diasize-browse-handle = p-browse-handle
     2744       .
     2745       for each buf_temp-browse-handle
     2746       on error undo, return error return-value
     2747       :
     2748         delete buf_temp-browse-handle .
     2749       end.
     2750     end.
     2751   end procedure.
     2752   procedure diasize_add_browse :
     2753     define input  parameter p-browse-type   as character no-undo .
     2754     define input  parameter p-browse-handle as handle    no-undo .
     2755     define buffer buf_temp-browse-handle for temp-browse-handle .
     2756     do
     2757     on error undo, return error return-value
     2758     :
     2759       assign
     2760         v-diasize-browse-number = v-diasize-browse-number + 1
     2761       .
     2762       create buf_temp-browse-handle .
     2763       assign
     2764         buf_temp-browse-handle.browse-type   = p-browse-type
     2765         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2766         buf_temp-browse-handle.browse-handle = p-browse-handle
     2767       .
     2768     end.
     2769   end procedure.
     2770   procedure diasize_init :
     2771     define variable v-default-value    as logical   no-undo .
     2772     define variable v-restore-saved    as logical   no-undo .
     2773     define variable v-resize-value-str as character no-undo .
     2774     do
     2775     on error undo, return error return-value
     2776     :
     2777       do with frame Dialog-Frame
     2778       :
     2779         assign
     2780           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2781           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2782           v-diasize-browse-handle     = browse br-obj-hist :handle
     2783         .
     2784         create button v-diasize-resize-button
     2785         assign
     2786           parent        = frame Dialog-Frame :first-child
     2787           label         = "s"
     2788           height-pixels = 16
     2789           width-pixels  = 16
     2790           visible       = true
     2791           sensitive     = true
     2792           movable       = true
     2793           triggers:
     2794             on end-move persistent run diasize_end-move in this-procedure .
     2795           end triggers.
     2796         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2797         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2798         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2799         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2800         assign
     2801           v-diasize-wndmax = false
     2802         .
     2803         if connected("ub") = true
     2804         then do:
     2805           define variable v-cntxt-db-num        as integer   no-undo .
     2806           define variable v-cntxt-userid        as character no-undo .
     2807           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2808                                             , OUTPUT v-cntxt-userid
     2809                                             ) .
     2810           run gbl/wndpar_r.p
     2811             (input  v-cntxt-db-num
     2812             ,input  v-cntxt-userid
     2813             ,input  'wndmax':U
     2814             ,output v-diasize-wndmax
     2815             ,output v-default-value
     2816             ) .
     2817         end.
     2818         assign
     2819           v-diasize-wndstore = false
     2820         .
     2821         if connected("ub") = true
     2822         then do:
     2823           run gbl/wndpar_r.p
     2824             (input  v-cntxt-db-num
     2825             ,input  v-cntxt-userid
     2826             ,input  'wndstore':U
     2827             ,output v-diasize-wndstore
     2828             ,output v-default-value
     2829             ) .
     2830         end.
     2831         assign
     2832           v-diasize-proc-name = entry(1, program-name(2), '.')
     2833         .
     2834         if v-diasize-wndstore = true
     2835         then do:
     2836           assign
     2837             v-restore-saved = false
     2838           .
     2839           if connected("ub") = true
     2840           then do:
     2841             run gbl/wndsizer.p
     2842               (input  v-cntxt-db-num
     2843               ,input  v-cntxt-userid
     2844               ,input  v-diasize-proc-name
     2845               ,input  'height':u
     2846               ,output v-resize-value-str
     2847               ) .
     2848             if v-resize-value-str <> '':U
     2849             then do:
     2850               run diasize_change-height in this-procedure
     2851                 (input  integer(v-resize-value-str)
     2852                 ,input  true
     2853                 ) .
     2854               assign
     2855                 v-restore-saved = true
     2856               .
     2857             end.
     2858           end.
     2859           if connected("ub") = true
     2860           then do:
     2861             run gbl/wndsizer.p
     2862               (input  v-cntxt-db-num
     2863               ,input  v-cntxt-userid
     2864               ,input  v-diasize-proc-name
     2865               ,input  'width':u
     2866               ,output v-resize-value-str
     2867               ) .
     2868             if v-resize-value-str <> '':U
     2869             then do:
     2870               run diasize_change-width in this-procedure
     2871                 (input  integer(v-resize-value-str)
     2872                 ,input  true
     2873                 ) .
     2874               assign
     2875                 v-restore-saved = true
     2876               .
     2877             end.
     2878           end.
     2879           if v-restore-saved <> true
     2880           then do:
     2881             if v-diasize-wndmax = true
     2882             then do:
     2883               run diasize_maximize in this-procedure
     2884                 (input  true
     2885                 ) .
     2886             end.
     2887           end.
     2888         end.
     2889         else do:
     2890           if v-diasize-wndmax = true
     2891           then do:
     2892             run diasize_maximize in this-procedure
     2893               (input  true
     2894               ) .
     2895           end.
     2896         end.
     2897       end.
     2898     end.
     2899   end procedure.
     2900   procedure diasize_need-full-display :
     2901     define output parameter p-need-full-display as logical   no-undo .
     2902     do
     2903     on error undo, return error return-value
     2904     :
     2905       assign
     2906         p-need-full-display = v-diasize-need-full-display
     2907       .
     2908       assign
     2909         v-diasize-need-full-display = false
     2910       .
     2911     end.
