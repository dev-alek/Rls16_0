     3792       if l-filter-open-29 = false then do:
     3793         message
     3794           "Ошибка при фильтрации / сортировке" skip
     3795           "Будут показаны записи без учета фильтра" skip
     3796           view-as alert-box .
     3797       end.
     3798       else do:
     3799           assign
     3800             l-query-was-opened = true
     3801           .
     3802       end.
     3803     end.
     3804     if l-filter-open-29 = false then do:
     3805       OPEN QUERY br-obj-hist FOR EACH X_c-obj-hist
     3806         where  TRUE
     3807         indexed-reposition
     3808     .
     3809         assign
     3810           l-query-was-opened = true
     3811         .
     3812     end.
     3813   end.
     3814   else do:
     3815     assign
     3816       v-doc-rec = recid( X_c-obj-hist )
     3817     .
     3818     do
     3819     on stop undo, leave
     3820     on error undo, leave
     3821     :
     3822       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     3823         assign
     3824         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3825         parameter-4-29 =
     3826           "where ":u + " TRUE " + " ":u + where-phrase-29 + " ":u + p-find-condition + " " + ""
     3827         parameter-5-29 = ""
     3828       .
     3829         run fltopend_fltfindd in this-procedure  (
     3830                             input this-procedure:handle
     3831                             ,input query br-obj-hist:handle
     3832                             ,input rowid(X_c-obj-hist)
     3833                             ,input logical(parameter-2-29)
     3834                             ,input no-lock
     3835                             ,input (buffer X_c-obj-hist:handle)
     3836                             ,input parameter-4-29
     3837                             ,input parameter-5-29
     3838                             ) no-error.
     3839         .
     3840         assign
     3841           v-doc-rec = integer(return-value)
     3842           v-fltopend-rowid[1] = ?
     3843         .
     3844       end.
     3845       else do:
     3846         assign
     3847         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3848         parameter-3-29 =  "FOR EACH X_c-obj-hist"
     3849         parameter-4-29 =
     3850           (
     3851             if (" TRUE " + " " + where-phrase-29) <> ""
     3852             then " TRUE " + " " + where-phrase-29
     3853             else "true"
     3854           )
     3855         parameter-5-29 = (" " + "" + " " + "" + " " + p-find-condition)
     3856         parameter-6-29 = if sort-phrase-29 = ''
     3857                              then
     3858           (
     3859           " " + "" +
     3860             " " + sort-column-phrase +
     3861           " " + "  "
     3862           )
     3863                              else
     3864           (
     3865           " " + "" +
     3866             " " + sort-column-phrase +
     3867           " " + sort-phrase-29
     3868           )
     3869         parameter-7-29 =
     3870           " indexed-reposition  "
     3871       .
     3872         run fltopend_fltfindq in this-procedure  (
     3873                             input this-procedure:handle
     3874                             ,input query br-obj-hist:handle
     3875                             ,input logical(parameter-2-29)
     3876                             ,input no-lock
     3877                             ,input parameter-3-29
     3878                             ,input parameter-4-29
     3879                             ,input parameter-5-29
     3880                             ,input parameter-6-29
     3881                             ,input parameter-7-29
     3882                             ,output v-fltopend-rowid
     3883                             ) no-error.
     3884         .
     3885         v-doc-rec = ?.
     3886       end.
     3887       assign
     3888         l-query-was-opened = true
     3889       .
     3890     end.
     3891   end.
     3892     run waitfram-hide in this-procedure .
     3893     end.
     3894   end.
     3895   if not p-open-query and v-doc-rec <> ? then
     3896   REPOSITION br-obj-hist to recid v-doc-rec No-ERROR.
     3897   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3898   query br-obj-hist:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3899   run waitfram-hide in this-procedure .
     3900   APPLY "VALUE-CHANGED" TO br-obj-hist in frame Dialog-Frame.
     3901   APPLY "ENTRY" TO br-obj-hist.
     3902   END PROCEDURE.
     3903   PROCEDURE proc-b-print :
     3904   define variable date_string     as      char    no-undo.
     3905   define variable Line                as      char    no-undo.
     3906   define variable for-time as char.
     3907   define variable accum-count as integer.
     3908   define variable v-doc-rec as recid no-undo.
     3909   define variable v-subject-chr as character no-undo .
     3910   define variable v-upd-time as character no-undo .
     3911   define variable v-obj as character no-undo .
     3912   define variable v-action-chr as character no-undo .
     3913   define variable v-source-type as character no-undo .
     3914   DEFINE FRAME HistoryList
     3915   v-action-chr FORMAT "X(10)" COLUMN-LABEL "Действие"
     3916   v-subject-chr COLUMN-LABEL "Предмет изменений" FORMAT "X(20)"
     3917   X_c-obj-hist.is-news COLUMn-LABEL "СПН" FORMAT "+/ "
     3918   v-source-type COLUMn-LABEL "Источн.!измен"
     3919   X_c-obj-hist.source-ref COLUMn-LABEL "№"
     3920   X_c-obj-hist.corr-date
     3921   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     3922   X_c-obj-hist.corr-user-name
     3923   X_c-obj-hist.corr-user-db-num
     3924   HEADER  date_string AT 5 format "X(35)"
     3925   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     3926   Line format "X(195)" AT 1
     3927   with width 232 down stream-io use-text    .
     3928   Line = fill("-", 195).
     3929   date_string = cur-time-print() .
     3930   assign
     3931   v-doc-rec = recid( X_c-obj-hist ).
     3932   DO WHILE available X_c-obj-hist :
     3933         GET prev br-obj-hist.
     3934   END.
     3935   run prn-lib-open-stream  in this-procedure (
     3936                                                input parparentProc
     3937                                               ,input 43
     3938                                               ,input yes
     3939                                               ,input no
     3940                                               ).
     3941   PUT  STREAM PrnLibStream
     3942   SPACE(25) ( frame Dialog-Frame:title )
     3943   format "x(90)" SKIP(1) .
     3944   FORM HEADER
     3945   Line format "X(180)" AT 1 SKIP
     3946   "Продолжение - на следующей странице" AT 30 SKIP
     3947   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3948   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3949   FORM with FRAME HistoryList  .
     3950   run waitfram-show in this-procedure ("Ждите...").
     3951     GET next br-obj-hist.
     3952       DO WHILE available X_c-obj-hist :
     3953         Display STREAM PrnLibStream
     3954          get-action(X_c-obj-hist.action) @ v-action-chr
     3955          get-subject(X_c-obj-hist.subject) @ v-subject-chr
     3956         X_c-obj-hist.is-news
     3957         get-source-type(X_c-obj-hist.source-type) @ v-source-type
     3958         X_c-obj-hist.source-ref
     3959         X_c-obj-hist.corr-date
     3960         string(X_c-obj-hist.corr-time, "HH:MM:SS":U) @ v-upd-time
     3961         X_c-obj-hist.corr-user-name
     3962         X_c-obj-hist.corr-user-db-num
     3963         with FRAME HistoryList .
     3964     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     3965     assign
     3966     accum-count = accum-count + 1
     3967     .
     3968     GET next br-obj-hist.
     3969   END.
     3970   UNDERLINE  STREAM PrnLibStream
     3971   v-action-chr
     3972   v-subject-chr
     3973   X_c-obj-hist.is-news
     3974   v-source-type
     3975   X_c-obj-hist.source-ref
     3976   X_c-obj-hist.corr-date
     3977   v-upd-time
     3978   X_c-obj-hist.corr-user-name
     3979   X_c-obj-hist.corr-user-db-num
     3980   with FRAME HistoryList .
     3981   DISPLAY STREAM PrnLibStream
     3982   "ИТОГО"  @ v-obj
     3983   string(accum-count)  @ v-action-chr
     3984   with frame HistoryList.
     3985   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3986   HIDE  STREAM PrnLibStream FRAME CheckList.
     3987   output  STREAM PrnLibStream CLOSE.
     3988   run waitfram-hide in this-procedure.
     3989   run prn-lib-prn-file in this-procedure (
     3990                                             input parparentproc
     3991                                             ,input 8
     3992                                             ).
     3993   reposition br-obj-hist to recid v-doc-rec no-error.
     3994   apply "entry" to br-obj-hist in frame Dialog-Frame.
     3995   END PROCEDURE.
     3996   PROCEDURE proc-b-sch :
     3997   assign
     3998     tbl = "c-cashbook-head"
     3999     join-tbl = 'X_c-obj-hist'
     4000     fld = ""
     4001     lab = ""
     4002     spr = ""
     4003     dim = '0'
     4004     .
     4005   run fltfield-add in this-procedure('corr-date', 'Дата корр.', '',
     4006   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4007   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     4008   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4009   run fltfield-add in this-procedure('corr-user-db-num', 'БД корр.', '',
     4010   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4011   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     4012   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4013   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     4014   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4015   run fltfield-add in this-procedure('subject', 'Предмет изменения', 'obj-hist-subject',
     4016   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4017   run fltfield-add in this-procedure('source-type', 'Источник измен-я', 'hist-source-type',
     4018   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4019   run fltfield-add in this-procedure('source-ref', 'Код источника измен-я', '',
     4020   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4021   Filter-Block:
     4022   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4023       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4024       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4025     run gbl/filter.w ( INPUT parparentproc
     4026                      , INPUT filter-point + chr(4) + filter-label
     4027                      , INPUT tbl
     4028                      , INPUT join-tbl
     4029                      , INPUT fld
     4030                      , INPUT lab
     4031                      , INPUT spr
     4032                      , INPUT dim ).
     4033     RUN OpenBr in this-procedure ( input yes, input no, input '':U, input v-corr-user-db-num).
     4034   END.
     4035   END PROCEDURE.
     4036   PROCEDURE proc-find-corr-date :
     4037   define input parameter p-next as logical no-undo.
     4038   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     4039   define variable v-date-chr as character no-undo.
     4040   if p-date = ? then return .
     4041   display
     4042   0 @ sch-obj-code
     4043   0 @ sch-db-num
     4044   "":U @ sch-corr-user-name
     4045   with frame Dialog-Frame.
     4046   assign
     4047   v-date-chr = string(day(p-date)) + chr(47) +
     4048                    string(month(p-date)) + chr(47) +
     4049                    string(year(p-date)).
     4050          run OpenBr in this-procedure
     4051           (input false
     4052           ,input true
     4053           ,input substitute("and X_c-obj-hist.corr-date = &1 "
     4054             , v-date-chr)
     4055           ,input v-corr-user-db-num
     4056           ).
     4057         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     4058   END PROCEDURE.
     4059   PROCEDURE proc-find-db-num :
     4060   define input parameter p-next as logical no-undo.
     4061   define input parameter p-db-num like c-cashbook-head.corr-user-db-num no-undo.
     4062   define variable v-db-num as character no-undo.
     4063   assign
     4064   sch-corr-date = ?
     4065   .
     4066   display
     4067   "":U @ sch-corr-user-name
     4068   0 @ sch-obj-code
     4069   sch-corr-date
     4070   with frame Dialog-Frame.
     4071   assign
     4072   v-db-num = string(p-db-num).
     4073   run OpenBr in this-procedure
     4074       (input false
     4075       ,input p-next
     4076       ,input substitute("and X_c-obj-hist.corr-user-db-num = &1 "
     4077         , v-db-num)
     4078       ,input v-corr-user-db-num
     4079       ).
     4080   apply "entry":u to sch-db-num in frame Dialog-Frame .
     4081   END PROCEDURE.
     4082   PROCEDURE proc-find-user :
     4083   define input parameter p-next as logical no-undo.
     4084   define input parameter p-user like c-cashbook-head.corr-user-name no-undo.
     4085   assign
     4086   sch-corr-date = ?.
     4087   display
     4088   0 @ sch-db-num
     4089   sch-corr-date
     4090   0 @ sch-obj-code
     4091   with frame Dialog-Frame.
     4092   p-user = chr(34) + p-user + chr(34).
     4093   run OpenBr in this-procedure
     4094       (input false
     4095       ,input p-next
     4096       ,input substitute("and X_c-obj-hist.corr-user-name = &1 "
     4097         , p-user)
     4098       ,input v-corr-user-db-num
     4099       ).
     4100   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     4101   END PROCEDURE.
     4102   PROCEDURE proc-view-changes :
     4103   define variable v-description as character no-undo .
     4104   for each temp-changes:
     4105       delete temp-changes.
     4106   END.
     4107   if not available X_c-obj-hist then do:
     4108     b-nextlevel:visible IN FRAME Dialog-Frame = no.
     4109     Open QUery br-changes for each temp-changes.
     4110     return.
     4111   end.
     4112   b-nextlevel:visible IN FRAME Dialog-Frame = X_c-obj-hist.subject eq "*" .
     4113   run local-view-cange in this-procedure (output v-description) .
     4114   Open QUery br-changes for each temp-changes by temp-changes.fNotChange.
     4115   assign
     4116   br-changes:title in frame Dialog-Frame = v-description
     4117   .
     4118   END PROCEDURE.
     4119   FUNCTION get-action RETURNS CHARACTER
     4120     ( p-action as integer ) :
     4121   define variable dops as character no-undo.
     4122   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     4123   RETURN dops.
     4124   END FUNCTION.
     4125   FUNCTION get-source-type RETURNS CHARACTER
     4126     ( p-source-type as character ) :
     4127   define variable v-dop as character no-undo .
     4128   assign
     4129   v-dop = entry (lookup (p-source-type, ',db,esys,trn-doc,payment,fin-doc,import,recalc,wth-doc,ren-gdsc,upgrade,grp-chg,stop-list,dis-card':U), ',БД,ВС,Документ,Платеж,Фин.док.,Импорт,Пересчет,Документ МЦ,Коллизия,Апгрейд,Изм.группы,Стоплист,ДК':U)
     4130   no-error
     4131   .
     4132   RETURN v-dop.
     4133   END FUNCTION.
     4134   function get-subject returns character
     4135     ( p-subject as character ) :
     4136     return p-subject.
     4137   end function.
     4138   procedure local-view-cange:
     4139      define output parameter odescription as character no-undo.
     4140      if X_c-obj-hist.subject eq "cashbook"
     4141      then
     4142         run cashbook-proc (output odescription).
     4143      else if X_c-obj-hist.subject eq "cashbookrule"
     4144      then
     4145         run cashbookrule-proc (output odescription).
     4146      else if X_c-obj-hist.subject eq "c-goods-attr-any"
     4147      then
     4148         run cashbookgds-proc (output odescription).
     4149      else
     4150   end procedure.
     4151   function local-open-br returns logical
     4152   (  p-open-query     as logical    ,
     4153     p-find-next       as logical    ,
     4154     p-find-condition as character ):
     4155        define variable sort-column-phrase as character no-undo .
     4156        define variable l-query-was-opened as logical no-undo .
     4157        if p-mode eq "one"
     4158        then do:
     4159   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4160   define variable  l-disable-where-31  as logical   no-undo .
     4161   define variable  l-filter-open-31    as logical   .
     4162   define variable  flt-rec-31       as recid     no-undo .
     4163   define variable  filter-name-31      as character no-undo .
     4164   define variable  where-phrase-31     as character no-undo .
     4165   define variable  sort-phrase-31      as character no-undo .
     4166   define variable  where-phrase-rus-31 as character no-undo .
     4167   define variable  sort-phrase-rus-31  as character no-undo .
     4168     run waitfram-show in this-procedure
     4169       (input "ЖДИТЕ ..."
     4170       ).
     4171   run gbl/flt-get.p
     4172     (input filter-point
     4173     ,output flt-rec-31
     4174     ,output filter-name-31
     4175     ,output where-phrase-31
     4176     ,output sort-phrase-31
     4177     ,output where-phrase-rus-31
     4178     ,output sort-phrase-rus-31
     4179     ).
     4180   if p-open-query then do:
     4181       run set-filter-name in this-procedure
     4182         (INPUT filter-name-31
     4183         ) no-error .
     4184     assign
     4185       l-filter-open-31 = false
     4186     .
     4187     if flt-rec-31 <> ?
     4188       or sort-column-phrase > ""
     4189     then do:
     4190       define variable  parameter-2-31 as character no-undo .
     4191       define variable  parameter-3-31 as character no-undo .
     4192       define variable  parameter-4-31 as character no-undo .
     4193       define variable  parameter-5-31 as character no-undo .
     4194       define variable  parameter-6-31 as character no-undo .
     4195       define variable  parameter-7-31 as character no-undo .
     4196         assign
     4197         parameter-3-31 =
     4198                                 "FOR EACH X_c-obj-hist"
     4199         parameter-4-31 =
     4200           (
     4201             if ("           X_c-obj-hist.id         = pid  or           X_c-obj-hist.cashbookid = pid  " + " " + where-phrase-31) <> ""
     4202             then  substitute('  X_c-obj-hist.id  = &1  or           X_c-obj-hist.cashbookid  = &1 ', pid)   + " " + where-phrase-31
     4203             else "true"
     4204           )
     4205         parameter-5-31 = (" " + "" + " " + "")
     4206         parameter-6-31 = if sort-phrase-31 = ''
     4207                              then
     4208           (
     4209           " " + " " +
     4210             " " + sort-column-phrase +
     4211           " " + " by X_c-obj-hist.chip-num "
     4212           )
     4213                              else
     4214           (
     4215           " " + " " +
     4216             " " + sort-column-phrase +
     4217           " " + sort-phrase-31
     4218           )
     4219         parameter-7-31 =
     4220           " indexed-reposition  "
     4221       .
     4222       do
     4223       on stop undo, leave
     4224       on error undo, leave
     4225       :
     4226         assign
     4227           l-disable-where-31 =
     4228             ("           X_c-obj-hist.id         = pid  or           X_c-obj-hist.cashbookid = pid  " + " " + where-phrase-31 = "")
     4229         .
     4230         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4231                             ,input query br-obj-hist:handle
     4232                             ,input parameter-3-31
     4233                             ,input parameter-4-31
     4234                             ,input parameter-5-31
     4235                             ,input parameter-6-31
     4236                             ,input parameter-7-31
     4237                             )
     4238         .
     4239         assign
     4240           l-filter-open-31 = true
     4241         .
     4242       end.
     4243       if l-filter-open-31 = false then do:
     4244         message
     4245           "Ошибка при фильтрации / сортировке" skip
     4246           "Будут показаны записи без учета фильтра" skip
     4247           view-as alert-box .
     4248       end.
     4249       else do:
     4250           assign
     4251             l-query-was-opened = true
     4252           .
     4253       end.
     4254     end.
     4255     if l-filter-open-31 = false then do:
     4256       OPEN QUERY br-obj-hist FOR EACH X_c-obj-hist
     4257         where            X_c-obj-hist.id         = pid  or           X_c-obj-hist.cashbookid = pid
     4258          by X_c-obj-hist.chip-num
     4259         indexed-reposition
     4260     .
     4261         assign
     4262           l-query-was-opened = true
     4263         .
     4264     end.
     4265   end.
     4266   else do:
     4267     assign
     4268       v-doc-rec = recid( X_c-obj-hist )
     4269     .
     4270     do
     4271     on stop undo, leave
     4272     on error undo, leave
     4273     :
     4274       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     4275         assign
     4276         parameter-2-31 = (if p-find-next then "true":u else "false":u )
     4277         parameter-4-31 =
     4278           "where ":u +  substitute('  X_c-obj-hist.id  = &1  or           X_c-obj-hist.cashbookid  = &1 ', pid)   + " ":u + where-phrase-31 + " ":u + p-find-condition + " " + ""
     4279         parameter-5-31 = " "
     4280       .
     4281         run fltopend_fltfindd in this-procedure  (
     4282                             input this-procedure:handle
     4283                             ,input query br-obj-hist:handle
     4284                             ,input rowid(X_c-obj-hist)
     4285                             ,input logical(parameter-2-31)
     4286                             ,input no-lock
     4287                             ,input (buffer X_c-obj-hist:handle)
     4288                             ,input parameter-4-31
     4289                             ,input parameter-5-31
     4290                             ) no-error.
     4291         .
     4292         assign
     4293           v-doc-rec = integer(return-value)
     4294           v-fltopend-rowid[1] = ?
     4295         .
     4296       end.
     4297       else do:
     4298         assign
     4299         parameter-2-31 = (if p-find-next then "true":u else "false":u )
     4300         parameter-3-31 =  "FOR EACH X_c-obj-hist"
     4301         parameter-4-31 =
     4302           (
     4303             if ("           X_c-obj-hist.id         = pid  or           X_c-obj-hist.cashbookid = pid  " + " " + where-phrase-31) <> ""
     4304             then  substitute('  X_c-obj-hist.id  = &1  or           X_c-obj-hist.cashbookid  = &1 ', pid)   + " " + where-phrase-31
     4305             else "true"
     4306           )
     4307         parameter-5-31 = (" " + "" + " " + "" + " " + p-find-condition)
     4308         parameter-6-31 = if sort-phrase-31 = ''
     4309                              then
     4310           (
     4311           " " + " " +
     4312             " " + sort-column-phrase +
     4313           " " + " by X_c-obj-hist.chip-num "
     4314           )
     4315                              else
     4316           (
     4317           " " + " " +
     4318             " " + sort-column-phrase +
     4319           " " + sort-phrase-31
     4320           )
     4321         parameter-7-31 =
     4322           " indexed-reposition  "
     4323       .
     4324         run fltopend_fltfindq in this-procedure  (
     4325                             input this-procedure:handle
     4326                             ,input query br-obj-hist:handle
     4327                             ,input logical(parameter-2-31)
     4328                             ,input no-lock
     4329                             ,input parameter-3-31
     4330                             ,input parameter-4-31
     4331                             ,input parameter-5-31
     4332                             ,input parameter-6-31
     4333                             ,input parameter-7-31
     4334                             ,output v-fltopend-rowid
     4335                             ) no-error.
     4336         .
     4337         v-doc-rec = ?.
     4338       end.
     4339       assign
     4340         l-query-was-opened = true
     4341       .
     4342     end.
     4343   end.
     4344     run waitfram-hide in this-procedure .
     4345        end.
     4346        else do:
     4347   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4348   define variable  l-disable-where-33  as logical   no-undo .
     4349   define variable  l-filter-open-33    as logical   .
     4350   define variable  flt-rec-33       as recid     no-undo .
     4351   define variable  filter-name-33      as character no-undo .
     4352   define variable  where-phrase-33     as character no-undo .
     4353   define variable  sort-phrase-33      as character no-undo .
     4354   define variable  where-phrase-rus-33 as character no-undo .
     4355   define variable  sort-phrase-rus-33  as character no-undo .
     4356     run waitfram-show in this-procedure
     4357       (input "ЖДИТЕ ..."
     4358       ).
     4359   run gbl/flt-get.p
     4360     (input filter-point
     4361     ,output flt-rec-33
     4362     ,output filter-name-33
     4363     ,output where-phrase-33
     4364     ,output sort-phrase-33
     4365     ,output where-phrase-rus-33
     4366     ,output sort-phrase-rus-33
     4367     ).
     4368   if p-open-query then do:
     4369       run set-filter-name in this-procedure
     4370         (INPUT filter-name-33
     4371         ) no-error .
     4372     assign
     4373       l-filter-open-33 = false
     4374     .
     4375     if flt-rec-33 <> ?
     4376       or sort-column-phrase > ""
     4377     then do:
     4378       define variable  parameter-2-33 as character no-undo .
     4379       define variable  parameter-3-33 as character no-undo .
     4380       define variable  parameter-4-33 as character no-undo .
     4381       define variable  parameter-5-33 as character no-undo .
     4382       define variable  parameter-6-33 as character no-undo .
     4383       define variable  parameter-7-33 as character no-undo .
     4384         assign
     4385         parameter-3-33 =
     4386                                 "FOR EACH X_c-obj-hist"
     4387         parameter-4-33 =
     4388           (
     4389             if (" TRUE " + " " + where-phrase-33) <> ""
     4390             then " TRUE " + " " + where-phrase-33
     4391             else "true"
     4392           )
     4393         parameter-5-33 = (" " + "" + " " + "")
     4394         parameter-6-33 = if sort-phrase-33 = ''
     4395                              then
     4396           (
     4397           " " + "" +
     4398             " " + sort-column-phrase +
     4399           " " + "  "
     4400           )
     4401                              else
     4402           (
     4403           " " + "" +
     4404             " " + sort-column-phrase +
     4405           " " + sort-phrase-33
     4406           )
     4407         parameter-7-33 =
     4408           " indexed-reposition  "
     4409       .
     4410       do
     4411       on stop undo, leave
     4412       on error undo, leave
     4413       :
     4414         assign
     4415           l-disable-where-33 =
     4416             (" TRUE " + " " + where-phrase-33 = "")
     4417         .
     4418         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4419                             ,input query br-obj-hist:handle
     4420                             ,input parameter-3-33
     4421                             ,input parameter-4-33
     4422                             ,input parameter-5-33
     4423                             ,input parameter-6-33
     4424                             ,input parameter-7-33
     4425                             )
     4426         .
     4427         assign
     4428           l-filter-open-33 = true
     4429         .
     4430       end.
     4431       if l-filter-open-33 = false then do:
     4432         message
     4433           "Ошибка при фильтрации / сортировке" skip
     4434           "Будут показаны записи без учета фильтра" skip
     4435           view-as alert-box .
     4436       end.
     4437       else do:
     4438           assign
     4439             l-query-was-opened = true
     4440           .
     4441       end.
     4442     end.
     4443     if l-filter-open-33 = false then do:
     4444       OPEN QUERY br-obj-hist FOR EACH X_c-obj-hist
     4445         where  TRUE
     4446         indexed-reposition
     4447     .
     4448         assign
     4449           l-query-was-opened = true
     4450         .
     4451     end.
     4452   end.
     4453   else do:
     4454     assign
     4455       v-doc-rec = recid( X_c-obj-hist )
     4456     .
     4457     do
     4458     on stop undo, leave
     4459     on error undo, leave
     4460     :
     4461       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     4462         assign
     4463         parameter-2-33 = (if p-find-next then "true":u else "false":u )
     4464         parameter-4-33 =
     4465           "where ":u + " TRUE " + " ":u + where-phrase-33 + " ":u + p-find-condition + " " + ""
     4466         parameter-5-33 = ""
     4467       .
     4468         run fltopend_fltfindd in this-procedure  (
     4469                             input this-procedure:handle
     4470                             ,input query br-obj-hist:handle
     4471                             ,input rowid(X_c-obj-hist)
     4472                             ,input logical(parameter-2-33)
     4473                             ,input no-lock
     4474                             ,input (buffer X_c-obj-hist:handle)
     4475                             ,input parameter-4-33
     4476                             ,input parameter-5-33
     4477                             ) no-error.
     4478         .
     4479         assign
     4480           v-doc-rec = integer(return-value)
     4481           v-fltopend-rowid[1] = ?
     4482         .
     4483       end.
     4484       else do:
     4485         assign
     4486         parameter-2-33 = (if p-find-next then "true":u else "false":u )
     4487         parameter-3-33 =  "FOR EACH X_c-obj-hist"
     4488         parameter-4-33 =
     4489           (
     4490             if (" TRUE " + " " + where-phrase-33) <> ""
     4491             then " TRUE " + " " + where-phrase-33
     4492             else "true"
     4493           )
     4494         parameter-5-33 = (" " + "" + " " + "" + " " + p-find-condition)
     4495         parameter-6-33 = if sort-phrase-33 = ''
     4496                              then
     4497           (
     4498           " " + "" +
     4499             " " + sort-column-phrase +
     4500           " " + "  "
     4501           )
     4502                              else
     4503           (
     4504           " " + "" +
     4505             " " + sort-column-phrase +
     4506           " " + sort-phrase-33
     4507           )
     4508         parameter-7-33 =
     4509           " indexed-reposition  "
     4510       .
     4511         run fltopend_fltfindq in this-procedure  (
     4512                             input this-procedure:handle
     4513                             ,input query br-obj-hist:handle
     4514                             ,input logical(parameter-2-33)
     4515                             ,input no-lock
     4516                             ,input parameter-3-33
     4517                             ,input parameter-4-33
     4518                             ,input parameter-5-33
     4519                             ,input parameter-6-33
     4520                             ,input parameter-7-33
     4521                             ,output v-fltopend-rowid
     4522                             ) no-error.
     4523         .
     4524         v-doc-rec = ?.
     4525       end.
     4526       assign
     4527         l-query-was-opened = true
     4528       .
     4529     end.
     4530   end.
     4531     run waitfram-hide in this-procedure .
     4532        end.
     4533     return true.
     4534   end.
     4535   procedure cashbook-proc :
     4536   define output parameter p-description as character no-undo .
     4537   define buffer current_c-cashbook for ub.c-cashbook  .
     4538   define variable v-mess as character no-undo.
     4539   do
     4540   on error undo, return error return-value
     4541   :
     4542     find first current_c-cashbook no-lock where
     4543                 current_c-cashbook.id = X_c-obj-hist.id
     4544             and current_c-cashbook.chip-num = X_c-obj-hist.chip-num
     4545             and current_c-cashbook.corr-user-db-num = X_c-obj-hist.corr-user-db-num no-error .
     4546     if not avail current_c-cashbook then do:
     4547         v-mess = "Неверная ссылка на c-cashbook в таблице c-cashbook-head".
     4548         return error  v-mess .
     4549     end.
     4550   define variable v-label-param as character no-undo .
     4551     v-label-param =
     4552      "ext-code"     + chr(4) + "ext-code"                              + chr(4) + "" + chr(8)
     4553    + "CashBookName" + chr(4) + "Наименование"                          + chr(4) + "" + chr(8)
     4554    + "RuleOsn"      + chr(4) + "Правило заполнения графы Основание"    + chr(4) + "" + chr(8)
     4555    + "RulePril"     + chr(4) + "Правило заполнения графы Приложение"   + chr(4) + "" + chr(8)
     4556    + "Status_"      + chr(4) + "Статус"                                + chr(4) + "" + chr(8)
     4557    + "Credit"       + chr(4) + "Значение для заполнения поля «кредит»" + chr(4) + "" + chr(8)
     4558    + "FlagSepCash"  + chr(4) + "Отдельный ПКО для каждой кассы"        + chr(4) + "" + chr(8)
     4559    + "FlagSepFull"  + chr(4) + "Раздельно НП и ТНП"                    + chr(4) + "" + chr(8)
     4560    + "cli-type"     + chr(4) + "Тип контрагента"                       + chr(4) + "" + chr(8)
     4561    + "cli-code"     + chr(4) + "Код контрагента"                       + chr(4) + "" + chr(8)
     4562    + "takenfrom"    + chr(4) + "Принято от"                            + chr(4) + "" + chr(8)
     4563    + "Debit"        + chr(4) + "Значение для заполнения поля «дебет»"  + chr(4) + "" .
     4564     run proc-full-temp-changes in this-procedure (
     4565                                                  input current_c-cashbook.action = integer('1':U)
     4566                                                 ,input current_c-cashbook.action = integer('99':U)
     4567                                                 ,input  buffer current_c-cashbook:handle
     4568                                                 ,input  'CashBook':U
     4569                                                 ,input  "ext-code,CashBookName,RuleOsn,RulePril,Status_,Credit,FlagSepCash,FlagSepFull,Debit,cli-type,cli-code,takenfrom"
     4570                                                 ,input  v-label-param).
     4571   end.
     4572   end procedure.
     4573   procedure cashbookrule-proc :
     4574   define output parameter p-description as character no-undo .
     4575   define buffer current_c-cashbookrule for ub.c-cashbookrule  .
     4576   define variable v-mess as character no-undo.
     4577   do
     4578   on error undo, return error return-value
     4579   :
     4580     find first current_c-cashbookrule no-lock where
     4581                 current_c-cashbookrule.cashbookid = X_c-obj-hist.cashbookid
     4582             and current_c-cashbookrule.Obj-code = X_c-obj-hist.Obj-code
     4583             and current_c-cashbookrule.Obj-type = X_c-obj-hist.Obj-type
     4584             and current_c-cashbookrule.chip-num = X_c-obj-hist.chip-num
     4585             and current_c-cashbookrule.corr-user-db-num = X_c-obj-hist.corr-user-db-num no-error .
     4586     if not avail current_c-cashbookrule then do:
     4587         v-mess = "Неверная ссылка на c-cashbook в таблице c-cashbook-head".
     4588         return error  v-mess .
     4589     end.
     4590   define variable v-label-param as character no-undo .
     4591     v-label-param =
     4592      "RuleValue"     + chr(4) +
     4593          ( if  current_c-cashbookrule.Code eq "PkoMask" then "Маска ПКО"
     4594       else if  current_c-cashbookrule.Code eq "RkoMask" then "Маска РКО"
     4595       else if  current_c-cashbookrule.Code eq "currPko" then "Текущий ПКО"
     4596       else if  current_c-cashbookrule.Code eq "currRko" then "Текущий РКО"
     4597       else if  current_c-cashbookrule.Code eq "ManagerPosition" then "Должность руководителя"
     4598       else if  current_c-cashbookrule.Code eq "ManagerFIO" then "ФИО руководителя "
     4599       else if  current_c-cashbookrule.Code eq "BuhFIO" then "ФИО бухгалтера"
     4600       else if  current_c-cashbookrule.Code eq "Struct" then "Структурное подразделение"
     4601       else if  current_c-cashbookrule.Code eq "uchet" then "Учёт ведется"
     4602       else if  current_c-cashbookrule.Code eq "DptName" then "Наименование структурного подразделения по умлочанию"
     4603       else if  current_c-cashbookrule.Code eq "DptType" then "Тип структурного подразделения по умлочанию"
     4604       else if  current_c-cashbookrule.Code eq "DptCode" then "Код структурного подразделения по умлочанию"
     4605       else if  current_c-cashbookrule.Code eq "Pin" then "Пин"
     4606       else string(current_c-cashbookrule.Code) )
     4607                                  + chr(4) + "" .
     4608     run proc-full-temp-changes in this-procedure (
     4609                                                  input current_c-cashbookrule.action = integer('1':U)
     4610                                                 ,input current_c-cashbookrule.action = integer('99':U)
     4611                                                 ,input  buffer current_c-cashbookrule:handle
     4612                                                 ,input  'CashBookRule':U
     4613                                                 ,input  "RuleValue"
     4614                                                 ,input  v-label-param).
     4615   end.
     4616   end procedure.
     4617   procedure cashbookgds-proc :
     4618   define output parameter p-description as character no-undo .
     4619   define buffer current_c-goods-attr-any for ub.c-goods-attr-any  .
     4620   define variable v-mess as character no-undo.
     4621   do
     4622   on error undo, return error return-value
     4623   :
     4624     find first current_c-goods-attr-any no-lock where
     4625                current_c-goods-attr-any.Bush               = "cashbook"
     4626            and current_c-goods-attr-any.attr-code          = "cashbookid"
     4627            and current_c-goods-attr-any.attr-value         = string(X_c-obj-hist.cashbookid)
     4628            and current_c-goods-attr-any.chip-num             = X_c-obj-hist.chip-num
     4629            and current_c-goods-attr-any.corr-user-db-num     = X_c-obj-hist.corr-user-db-num no-error .
     4630     if not avail current_c-goods-attr-any then do:
     4631         v-mess = "Неверная ссылка на c-goods-attr-any в таблице c-cashbook-head".
     4632         return error  v-mess .
     4633     end.
     4634   define variable v-label-param as character no-undo .
     4635     v-label-param =
     4636      "gds-code"     + chr(4) + "Код товара " + chr(4) + "" .
     4637     run proc-full-temp-changes in this-procedure (
     4638                                                  input current_c-goods-attr-any.action = integer('1':U)
     4639                                                 ,input current_c-goods-attr-any.action = integer('99':U)
     4640                                                 ,input  buffer current_c-goods-attr-any:handle
     4641                                                 ,input  'goods-attr':U
     4642                                                 ,input  "gds-code"
     4643                                                 ,input  v-label-param).
     4644   end.
     4645   end procedure.
