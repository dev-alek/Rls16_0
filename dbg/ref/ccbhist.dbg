        1   define input  parameter pid as int64 no-undo.
        2   define variable vlable as character no-undo.
        3   DEFINE BUFFER X_c-obj-hist FOR c-cashbook-head.
        4   DEFINE BUFFER find_c-obj-hist FOR c-cashbook-head.
