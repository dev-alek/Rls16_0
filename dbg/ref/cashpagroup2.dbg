      565     .
      566   define new global shared variable mBatchMode as logical no-undo init ?.
      567   define variable mFramBachModHandle as handle no-undo.
      568   mFramBachModHandle = frame waitfram:handle.
      569   define variable mFameOldVis as logical no-undo.
      570   define variable mVisCUrentVin as logical no-undo.
      571   if session:batch-mode
      572   then
      573      mBatchMode = yes.
      574   if mBatchMode = ? then do:
      575     mVisCUrentVin = current-window:visible.
      576     mFameOldVis = mFramBachModHandle:visible.
      577     mFramBachModHandle:visible  = yes.
      578     mBatchMode = mFramBachModHandle:visible ne yes.
      579     mFramBachModHandle:visible = mFameOldVis.
      580     current-window:visible = mVisCUrentVin.
      581   end.
      582    if  log-manager:logfile-name ne ?
      583     then DO:
      584         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      585         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      586         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      587     end.
      588   on choose of B-WaitFramStop in frame waitfram
      589   do:
      590     mWaitFramStop = yes.
      591     mWaitFramStopUser = yes.
      592   end.
      593   function waitfram-check-timeout returns logical():
      594      define variable vtime as int64 no-undo.
      595      if mWaitFramStopTimeOut
      596      then
      597         return yes.
      598      vtime = ( now - mWaitFramStartProc ) / 1000 .
      599      if     mWaitFramTimeOut ne ?
      600         and mWaitFramTimeOut ne 0
      601         and mWaitFramTimeOut lt vtime
      602      then do:
      603         mWaitFramStopTimeOut = yes.
      604      end.
      605      return mWaitFramStopTimeOut.
      606   end.
      607   procedure waitfram-hide :
      608     if not session:batch-mode
      609     then do
      610     on error undo, return error return-value
      611     :
      612       pause 0 before-hide .
      613       if not mBatchMode then
      614         hide frame waitfram .
      615     if     not mWaitFramView
      616        and mWaitProcEvent
      617     then
      618       process events .
      619     end.
      620   end procedure.
      621   procedure waitfram-show :
      622     define input  parameter p-message as character no-undo .
      623     define variable v-left-margin as integer   no-undo .
      624     if not session:batch-mode
      625     then do
      626     on error undo, return error return-value
      627     :
      628       if length(p-message) <= 70 then do:
      629         assign
      630           v-left-margin = integer((70 - length(p-message)) / 2)
      631         .
      632         assign
      633           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      634         .
      635         assign
      636           v-waitfram-action01 = " "
      637           v-waitfram-action02 = " "
      638                                    + fill(" ", v-left-margin)
      639                                    + p-message
      640           v-waitfram-action03 = " "
      641         .
      642       end.
      643       else do:
      644         define variable vRindex1 as integer no-undo.
      645         define variable vRindex2 as integer no-undo.
      646         vRindex1 = r-index(p-message," ",70).
      647         if vRindex1 = 0
      648         then
      649            vRindex1 = 70.
      650         if length(p-message)  <= vRindex1 + 70 then do:
      651           assign
      652             v-waitfram-action01 = " "
      653             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      654             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      655           .
      656         end.
      657         else do:
      658           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      659           if vRindex2 <= vRindex1
      660           then
      661              vRindex2 = vRindex1 + 70.
      662           assign
      663             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      664             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      665             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      666           .
      667         end.
      668       end.
      669       B-viewProcInfo:visible   in frame waitfram = no.
      670       B-viewProcInfo:sensitive in frame waitfram = no.
      671       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      672       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      673       if  (   mWaitFramView
      674          or  mWaitProcEvent)
      675          and not mBatchMode
      676       then
      677          display
      678             v-waitfram-action01 skip
      679             v-waitfram-action02 skip
      680             v-waitfram-action03 skip
      681          with frame waitfram .
      682       if     mWaitFramView
      683          then do:
      684             if     mWaitFramInterval ne ?
      685                and not mBatchMode
      686             then
      687                wait-for go of frame waitfram pause mWaitFramInterval.
      688          end.
      689          else
      690             if     mWaitProcEvent
      691                and not mBatchMode
      692             then
      693                process events .
      694     end.
      695   end procedure.
      696      procedure waitfram-show-this:
      697         define input  parameter iInterval as int64 no-undo.
      698         define variable vtime as int64 no-undo.
      699         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      700         mWaitFramInterval = iInterval.
      701         run waitfram-show (substitute("&1&2 &3&4" ,
      702                                       mWaitFramTextBeg ,
      703                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      704                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      705                                       mWaitFramTextEnd
      706                                      )
      707                           ).
      708      end.
      709      procedure WaitFramRunPause:
      710         define input  parameter iInterval as dec no-undo.
      711         define variable vStart  as datetime-tz no-undo.
      712         define variable vend    as datetime-tz no-undo.
      713         define variable vint as int64 no-undo.
      714         define variable vOk as logical no-undo.
      715         vStart = now.
      716         vend   = vStart.
      717         publish "WaitFramPause" (iInterval,output vOk).
      718         vend   =  now.
      719         vint = vend - vStart.
      720         vint = iInterval - vint / 1000.
      721         if     not mWaitFramStop
      722            and (   vint > 0
      723                 or (    not vOk
      724                     and iInterval eq ?
      725                     )
      726                 )
      727         then
      728            run waitfram-show-this (iInterval).
      729         vend   =  now.
      730         vint = vend - vStart.
      731         vint = iInterval - vint / 1000.
      732         if     not mWaitFramStop
      733            and vint > 0
      734         then do:
      735            run gbl/pause.p (vint * 1000).
      736         end.
      737         if iInterval ne ?
      738         then
      739            publish "WaitFramStop".
      740         waitfram-check-timeout().
      741      end.
      742      procedure WaitFramWaitFor:
      743         define input  parameter iInterval as dec no-undo.
      744         assign
      745            mWaitFramStartProc   = now
      746            mWaitFramStopUser    = no
      747            mWaitFramStopTimeOut = no
      748         .
      749         block-wait:
      750         do while not mWaitFramStop:
      751            run WaitFramRunPause (iInterval).
      752            if  waitfram-check-timeout()
      753            then do:
      754               leave block-wait.
      755            end.
      756         end.
      757         run waitfram-hide.
      758      end.
      759   procedure waitfram-join :
      760     define input  parameter p-line-1  as character no-undo .
      761     define input  parameter p-line-2  as character no-undo .
      762     define input  parameter p-line-3  as character no-undo .
      763     define output parameter p-message as character no-undo .
      764     do
      765     on error undo, return error return-value
      766     :
      767       assign
      768         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      769                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      770                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      771       .
      772     end.
      773   end procedure.
      774   function waitfram-join-function returns character
      775     (input p-line-1 as character
      776     ,input p-line-2 as character
      777     ,input p-line-3 as character
      778     ).
      779     define variable v-message as character no-undo .
      780     run waitfram-join in this-procedure
      781       (input  p-line-1
      782       ,input  p-line-2
      783       ,input  p-line-3
      784       ,output v-message
      785       ) .
      786     return v-message .
      787   end function .
      788   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      789   FUNCTION mark-string RETURNS CHARACTER
      790     ( input p-recid as recid, input mark-list as character  ) :
      791     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      792   END FUNCTION.
      793    define  temp-table tmprecid
      794       field Frecid as recid init ?
      795       field fnum as character
      796       field fTable as character
      797    index num  fnum Frecid
      798    index itable is primary unique fTable Frecid
      799    .
      800   define variable fSelect as logical no-undo format "*/" column-label "".
      801   function isSelect return logical
      802       (iBuffer as handle  ):
      803       define buffer tmprecid for tmprecid.
      804       if iBuffer:available
      805       then
      806          find first tmprecid where tmprecid.fTable = iBuffer:TABLE
      807                                and tmprecid.Frecid = iBuffer:recid
      808          no-lock no-error.
      809       return available tmprecid.
      810    end.
      811   function setSelect return logical
      812       (iBuffer as handle  ):
      813       define buffer tmprecid for tmprecid.
      814       if iBuffer:available
      815       then do:
      816          find first tmprecid where tmprecid.fTable = iBuffer:TABLE
      817                                and tmprecid.Frecid = iBuffer:recid
      818          no-lock no-error.
      819          if available tmprecid
      820          then
      821             delete tmprecid.
      822          else do:
      823             create tmprecid.
      824             assign
      825                tmprecid.fTable = iBuffer:TABLE
      826                tmprecid.Frecid = iBuffer:recid
      827             .
      828          end.
      829       end.
      830       return available tmprecid.
      831    end.
      832    procedure rid-keep :
      833        run gbl/rid-keep.p (input table tmprecid) no-error.
      834    end.
      835    procedure rid-rest :
      836         run gbl/rid-rest.p (output table tmprecid) no-error.
      837    end.
      838   define variable log-res     as log       no-undo.
      839   define variable ri          as recid     no-undo.
      840   define variable v-rid       as recid     no-undo .
      841   define variable v-db-num like ub.db.db-num no-undo .
      842   FUNCTION getKeytype RETURNS CHARACTER
      843      ( iCode as char) FORWARD.
      844   FUNCTION getKeyName RETURNS CHARACTER
      845      ( iCode as char) FORWARD.
      846   FUNCTION getStatus RETURNS CHARACTER
      847      ( imisc as char, istatus as int   )  FORWARD.
      848   DEFINE BUTTON b-add
      849        LABEL "&Добавить":L
      850        SIZE 10 BY 1.
      851   DEFINE BUTTON b-del
      852        LABEL "&Удалить":L
      853        SIZE 10 BY 1.
      854   DEFINE BUTTON b-exit AUTO-GO
      855        LABEL "&Выход ":L
      856        SIZE 10 BY 1.
      857   DEFINE BUTTON b-help
      858        LABEL "Помо&щь":L
      859        SIZE 3 BY 1.
      860   DEFINE BUTTON b-sel
      861        LABEL "Вы&бор ":L
      862        SIZE 10 BY 1.
      863   DEFINE BUTTON b-upd
      864        LABEL "&Изменить":L
      865        SIZE 10 BY 1.
      866   define button b-hist
      867        label "Ис&тория":L
      868        size 10 by 1.
      869   define menu POPUP-MENU-b-hist
      870       menu-item mHistOne     label "История этой записи"
      871       menu-item mHistChiled  label "История потомков"
      872   .
      873   define variable mSearch   as character       format "x(60)":U
      874      label "Поиск"
      875      view-as fill-in
      876      size 60 by 1 no-undo.
      877   DEFINE QUERY cashpg FOR
      878         buf-code-func,
      879         buf-code-param SCROLLING.
      880   DEFINE BROWSE cashpg
      881     QUERY cashpg NO-LOCK DISPLAY
      882         isSelect(buffer buf-code-param:handle)     @ fselect
      883         getKeyName(buf-code-func.code) + " (" + buf-code-func.code + ")" @ buf-code-func.code COLUMN-LABEL "Наименование функции клавиши" FORMAT "x(30)":U
      884         getKeytype(buf-code-func.code) @ buf-code-func.misc1 COLUMN-LABEL "" FORMAT "x(3)":U
      885         buf-code-param.code COLUMN-LABEL "Дополнительное значение" FORMAT "x(23)":U
      886               WIDTH 23
      887         buf-code-param.CodeValue COLUMN-LABEL "Степень защиты" FORMAT "x(20)":U
      888               WIDTH 15
      889         getStatus (buf-code-param.misc1,buf-code-param.status_) COLUMN-LABEL "Cтатус" format "x(20)"
      890         buf-code-param.CodeName COLUMN-LABEL "Описание клавиши" FORMAT "x(60)":U
      891       WITH NO-ROW-MARKERS SEPARATORS SIZE 90 BY 20 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
      892   DEFINE FRAME f-c-p
      893        b-exit AT ROW 1 COL 1
      894        b-sel AT ROW 1 COL 14
      895        b-add AT ROW 1 COL 24
      896        b-del AT ROW 1 COL 34 WIDGET-ID 2
      897        b-upd AT ROW 1 COL 44.13
      898        b-hist AT ROW 1 COL 54.13
      899        b-help AT ROW 1 COL 71
      900        mSearch  AT ROW 2.5 col 1.2
      901        cashpg AT ROW 4 COL 1 WIDGET-ID 300
      902       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      903            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      904            TITLE "Настройки клавиатур":L.
      905   ASSIGN
      906          FRAME f-c-p:SCROLLABLE       = FALSE.
      907   on choose of menu-item mHistOne
      908   do:
      909      define variable v-rid-list as character no-undo.
      910      if avail buf-code-param then
      911      do:
      912         run ref/ccode.w (
      913                   buf-code-param.parent,
      914                   buf-code-param.code,
      915                   parparentproc,
      916                   0,
      917                   "",
      918                   0,
      919                   "",
      920                   "one",
      921                   ?,
      922                   "",
      923                   "" ,
      924                   v-cntxt-db-num,
      925                   ?,
      926                   input-output v-rid-list ) .
      927      end.
      928   end.
      929   on choose of menu-item mHistChiled
      930   do:
      931      define variable v-rid-list as character no-undo.
      932      if avail buf-code-param then
      933      do:
      934         run ref/ccode.w (
      935                   buf-code-param.parent,
      936                   buf-code-param.code,
      937                   parparentproc,
      938                   0,
      939                   "",
      940                   0,
      941                   "",
      942                   "parentBeg",
      943                   ?,
      944                   "",
      945                   "" ,
      946                   v-cntxt-db-num,
      947                   ?,
      948                   input-output v-rid-list ) .
      949      end.
      950   end.
      951   ON go OF FRAME f-c-p
      952   do:
      953   end.
      954   ON choose OF b-add IN FRAME f-c-p
      955   do:
      956      define variable vRec as recid no-undo.
      957      run ref/cashparamuk.w (
      958                               input parparentproc
      959                             , input 'ДОБАВЛЕНИЕ':U
      960                             , input iparent + chr(4) + icode + chr(4)
      961                             , input-output vRec).
      962      if vRec <> ? then  do:
      963            OPEN QUERY cashpg FOR EACH buf-code-func       WHERE buf-code-func.parent = iparent + chr(4) + icode NO-LOCK,       EACH  buf-code-param WHERE buf-code-param.parent =  buf-code-func.parent + chr(4) + buf-code-func.code NO-LOCK by getKeyName(buf-code-func.code) + " (" + buf-code-func.code + ")" INDEXED-REPOSITION.
      964            define buffer bcode   for ub.code.
      965            define buffer bparent for ub.code.
      966            define variable vparent as character no-undo.
      967            define variable vcode   as character no-undo.
      968            find first bcode where recid(bcode) eq vRec no-lock no-error.
      969            assign
      970               vparent  = bcode.parent
      971               vcode    = entry(num-entries (vparent,chr(4)),vparent,chr(4))
      972               entry(num-entries (vparent,chr(4)),vparent,chr(4)) = ""
      973               vparent = substring (vparent,1,length (vparent) - 1)
      974            .
      975            find first bparent where bparent.parent eq vparent
      976                                 and bparent.code eq vcode
      977            no-lock no-error.
      978            if available bparent
      979            then
      980               reposition cashpg to rowid rowid(bparent), rowid(bcode).
      981               apply "ENTRY" to cashpg.
      982      end.
      983   end.
      984   ON choose OF b-del IN FRAME f-c-p
      985   do:
      986      define buffer b1-code for code.
      987      if not avail buf-code-param or not avail buf-code-func then return.
      988      define variable v-ok as logical no-undo.
      989      message "Удалить запись параметра " getKeyName(buf-code-func.code) + " (" + buf-code-func.code + ")" " (" buf-code-param.code ")" "?"
      990         view-as alert-box question
      991         buttons yes-no
      992         title "Удаление"
      993         update v-ok .
      994      if not v-ok then return no-apply.
      995      do on error undo, return
      996      on stop undo, return:
      997         find first b1-code of buf-code-param exclusive-lock no-wait no-error.
      998         if locked b1-code then do:
      999            message
     1000               vss-workfile vss-revision vss-description skip
     1001               "Группа занята"
     1002            view-as alert-box error .
     1003            undo, return.
     1004         end.
     1005         if not available b1-code then do:
     1006            message
     1007               vss-workfile vss-revision vss-description skip
     1008               "Не найдена запись группы"
     1009            view-as alert-box error .
     1010            undo, return.
     1011         end.
     1012         delete b1-code.
     1013         OPEN QUERY cashpg FOR EACH buf-code-func       WHERE buf-code-func.parent = iparent + chr(4) + icode NO-LOCK,       EACH  buf-code-param WHERE buf-code-param.parent =  buf-code-func.parent + chr(4) + buf-code-func.code NO-LOCK by getKeyName(buf-code-func.code) + " (" + buf-code-func.code + ")" INDEXED-REPOSITION.
     1014         apply "ENTRY" to cashpg.
     1015      end.
     1016   end.
     1017   ON choose OF b-sel IN FRAME f-c-p
     1018   do:
     1019      if not avail buf-code-param then return.
     1020      setSelect(buffer buf-code-param:handle).
     1021       cashpg:refresh ().
     1022   end.
     1023   ON choose OF b-upd IN FRAME f-c-p
     1024   do:
     1025      define variable vRec as recid no-undo.
     1026      if not avail buf-code-param then return.
     1027      define variable v-ok as logical no-undo.
     1028      vRec = recid(buf-code-param).
     1029      run ref/cashparamuk.w (
     1030                               input parparentproc
     1031                             , input 'ИЗМЕНЕНИЕ':U
     1032                             , input buf-code-param.parent
     1033                             , input-output vRec).
     1034            OPEN QUERY cashpg FOR EACH buf-code-func       WHERE buf-code-func.parent = iparent + chr(4) + icode NO-LOCK,       EACH  buf-code-param WHERE buf-code-param.parent =  buf-code-func.parent + chr(4) + buf-code-func.code NO-LOCK by getKeyName(buf-code-func.code) + " (" + buf-code-func.code + ")" INDEXED-REPOSITION.
     1035            define buffer bcode   for ub.code.
     1036            define buffer bparent for ub.code.
     1037            define variable vparent as character no-undo.
     1038            define variable vcode   as character no-undo.
     1039            find first bcode where recid(bcode) eq vRec no-lock no-error.
     1040            assign
     1041               vparent  = bcode.parent
     1042               vcode    = entry(num-entries (vparent,chr(4)),vparent,chr(4))
     1043               entry(num-entries (vparent,chr(4)),vparent,chr(4)) = ""
     1044               vparent = substring (vparent,1,length (vparent) - 1)
     1045            .
     1046            find first bparent where bparent.parent eq vparent
     1047                                 and bparent.code eq vcode
     1048            no-lock no-error.
     1049            if available bparent
     1050            then
     1051               reposition cashpg to rowid rowid(bparent), rowid(bcode).
     1052            apply "ENTRY" to cashpg.
     1053         end.
     1054   on mouse-select-dblclick of cashpg in frame f-c-p
     1055   or return of b-upd in frame f-c-p
     1056   do:
     1057      if iMode eq 'ИЗМЕНЕНИЕ':U and v-db-num = 0
     1058         and available buf-code-param
     1059      then
     1060         apply "choose" to b-upd in frame f-c-p.
     1061   end.
     1062   on ENTER of mSearch in frame f-c-p
     1063   do:
     1064         define buffer buf-code-search1 for ub.code.
     1065         define buffer buf-code-search for ub.code.
     1066      assign
     1067        msearch
     1068      .
     1069      define variable vRowid1 as rowid no-undo.
     1070      define variable vRowid2 as rowid no-undo.
     1071      block-code:
     1072      for each buf-code-search1 where buf-code-search1.parent = iparent + chr(4) + icode no-lock
     1073      ,first buf-code-search where buf-code-search.parent =  buf-code-search1.parent + chr(4) + buf-code-search1.code
     1074      no-lock:
     1075         if               buf-code-search1.code  begins msearch
     1076            or getKeyName(buf-code-search1.code) begins msearch
     1077         then do:
     1078            vRowid1 = rowid(buf-code-search1).
     1079            leave block-code.
     1080         end.
     1081               define buffer buf-code-search2 for ub.code.
     1082         for each buf-code-search2 where buf-code-search2.parent =  buf-code-search1.parent + chr(4) + buf-code-search1.code
     1083                                    and buf-code-search2.code begins msearch
     1084         no-lock:
     1085            vRowid1 = rowid(buf-code-search1).
     1086            vRowid2 = rowid(buf-code-search2).
     1087            leave block-code.
     1088         end.
     1089      end.
     1090         if vRowid1 eq ?
     1091      then do:
     1092         message "Запись не найдена"
     1093         view-as alert-box.
     1094      end.
     1095      else do:
     1096         if vRowid2 eq ?
     1097         then
     1098            reposition cashpg to rowid vRowid1.
     1099         else
     1100            reposition cashpg to rowid vRowid1, vRowid2.
     1101         apply "ENTRY" to cashpg.
     1102      end.
     1103   end.
     1104   if valid-handle(active-window) and frame f-c-p:PARENT eq ?
     1105     then frame f-c-p:PARENT = active-window.
     1106   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1107   on help of frame f-c-p
     1108   do:
     1109     run gbl/app_help.p
     1110       (input this-procedure :file-name
     1111       ,input ''
     1112       ,input ?
     1113       ) no-error.
     1114     if error-status :error then do:
     1115       message
     1116         "Ошибка при вызове помощи"
     1117         error-status :get-message(1)
     1118         view-as alert-box .
     1119     end.
     1120   end.
     1121   run minbtn-set in this-procedure .
     1122   on choose of b-help in frame f-c-p
     1123   do:
     1124     apply "help":u to frame f-c-p .
     1125   end.
     1126   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1127   procedure minbtn-set :
     1128       do
     1129           on error undo, return error return-value
     1130           :
     1131           define variable ii              as integer       no-undo .
     1132           define variable fh              as widget-handle no-undo .
     1133           define variable hh              as widget-handle no-undo .
     1134           define variable v-h             as handle        extent 4 no-undo .
     1135           define variable v-name-button   as character     no-undo .
     1136           define variable v-help-old-x    as decimal       no-undo .
     1137           define variable v-help-old-y    as decimal       no-undo .
     1138           define variable v-help-old-size as decimal       no-undo .
     1139           define variable v-frame-width   as decimal       no-undo .
     1140           define variable jj              as integer       no-undo .
     1141           do
     1142               on error undo, return error
     1143               :
     1144               assign
     1145                   v-frame-width = frame f-c-p:width - 0.3
     1146                   fh            = frame f-c-p:first-child
     1147                   hh            = fh:first-child
     1148                   ii            = 1
     1149                   .
     1150               do while valid-handle(hh):
     1151                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1152                   do:
     1153                       case lc(hh:name) :
     1154                           when "b-help" then
     1155                               do:
     1156                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1157                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1158                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1159                                   hh:TOOLTIP = "Помощь" .
     1160                                   v-help-old-x = hh:column .
     1161                                   v-help-old-y = hh:row    .
     1162                                   v-help-old-size = hh:width .
     1163                                   hh:width-chars = 2.5 .
     1164                               end.
     1165                           when "b-print" then
     1166                               do:
     1167                                   hh:load-image("cmp/b-print.bmp":u) .
     1168                                   hh:TOOLTIP = "Печать" .
     1169                                   v-h[ii] = hh:handle .
     1170                                   ii = ii + 1 .
     1171                                   hh:width-chars = 3 .
     1172                               end.
     1173                           when "b-history" or
     1174                           when "b-hist" then
     1175                               do:
     1176                                   hh:load-image("cmp/b-hist.bmp":u) .
     1177                                   hh:TOOLTIP = "История" .
     1178                                   v-h[ii] = hh:handle .
     1179                                   ii = ii + 1 .
     1180                                   hh:width-chars = 3 .
     1181                               end.
     1182                           when "b-sch" then
     1183                               do:
     1184                                   hh:load-image("cmp/b-sch.bmp":u) .
     1185                                   hh:TOOLTIP = "Установка Фильтра" .
     1186                                   v-h[ii] = hh:handle .
     1187                                   ii = ii + 1 .
     1188                                   hh:width-chars = 3 .
     1189                               end.
     1190                           when "b-hist-user" then
     1191                               do:
     1192                                   hh:load-image("cmp/b-hist.bmp":u) .
     1193                                   hh:TOOLTIP = "История пользователя" .
     1194                                   ii = ii + 1 .
     1195                               end.
     1196                       end case.
     1197                   end.
     1198                   hh = hh:next-sibling.
     1199               end.
     1200               b-help:column = v-frame-width - b-help:width-chars.
     1201               jj = 0.
     1202               repeat ii = 4 to 1 by -1 :
     1203                   if valid-handle (v-h[ii] ) then
     1204                   do:
     1205                       jj  = jj + 1 .
     1206                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1207                       v-h[ii]:row    = v-help-old-y .
     1208                   end.
     1209               end.
     1210           end.
     1211       end.
     1212   end procedure.
     1213   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1214   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1215   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1216   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1217   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1218   define variable v-diasize-current-frame-height as decimal   no-undo .
     1219   define variable v-diasize-change-size          as logical   no-undo .
     1220   define variable v-diasize-resize-button        as handle    no-undo .
     1221   define variable v-diasize-wndmax               as logical   no-undo .
     1222   define variable v-diasize-wndstore             as logical   no-undo .
     1223   define variable v-diasize-proc-name            as character no-undo .
     1224   define variable v-diasize-browse-handle        as handle    no-undo .
     1225   define variable v-diasize-browse-number        as integer   no-undo .
     1226   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1227   define temp-table temp-diasize-handle no-undo
     1228     field handle-value  as handle
     1229     field save-position as decimal
     1230     index xpk is primary unique handle-value
     1231     .
     1232   define temp-table temp-browse-handle no-undo
     1233     field browse-type   as character
     1234     field browse-number as integer
     1235     field browse-handle as handle
     1236     field original-size as decimal
     1237     index xpk is primary unique browse-type browse-number
     1238     index xie browse-type browse-handle
     1239   .
     1240   procedure diasize_change-height :
     1241     define input  parameter p-change-value  as decimal   no-undo .
     1242     define input  parameter p-move-resize   as logical   no-undo .
     1243     define variable v-field-group-handle    as handle    no-undo .
     1244     define variable v-object-handle         as handle    no-undo .
     1245     define variable v-frame-height          as decimal   no-undo .
     1246     define variable v-frame-virtual-height  as decimal   no-undo .
     1247     define variable v-browse-height         as decimal   no-undo .
     1248     define variable v-window-height         as decimal   no-undo .
     1249     define variable v-window-virtual-height as decimal   no-undo .
     1250     define variable v-change-sign           as integer   no-undo .
     1251     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1252     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1253     if p-change-value > 0
     1254     then do:
     1255       if frame f-c-p :height + p-change-value
     1256           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1257       then do:
     1258         assign
     1259           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1260                           - (frame f-c-p :height-chars)
     1261         .
     1262         if p-change-value <= 0
     1263         then do:
     1264           run diasize_position-resize-button in this-procedure .
     1265           return .
     1266         end.
     1267       end.
     1268     end.
     1269     if p-change-value < 0
     1270     then do:
     1271       if frame f-c-p :height + p-change-value < v-diasize-orig-frame-height
     1272       then do:
     1273         assign
     1274           p-change-value = v-diasize-orig-frame-height
     1275                          - (frame f-c-p :height-chars)
     1276         .
     1277         if p-change-value >= 0
     1278         then do:
     1279           run diasize_position-resize-button in this-procedure .
     1280           return .
     1281         end.
     1282       end.
     1283     end.
     1284     if p-change-value >= 0
     1285     then do:
     1286       assign
     1287         v-change-sign = 1
     1288       .
     1289     end.
     1290     else do:
     1291       assign
     1292         v-change-sign = -1
     1293       .
     1294     end.
     1295     assign
     1296       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1297     .
     1298     if p-change-value = 0
     1299     then do:
     1300       run diasize_position-resize-button in this-procedure .
     1301       return .
     1302     end.
     1303     move_block:
     1304     do
     1305     on error undo move_block, retry move_block
     1306     :
     1307       if retry
     1308       then do:
     1309         do
     1310         on error undo move_block, leave move_block
     1311         :
     1312           if p-change-value > 0
     1313           then do:
     1314             for each buf_temp-diasize-handle
     1315             on error undo, next
     1316             :
     1317               assign
     1318                 v-object-handle = buf_temp-diasize-handle.handle-value
     1319               .
     1320               if v-object-handle <> v-diasize-resize-button
     1321               then do:
     1322                 assign
     1323                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1324                 .
     1325               end.
     1326             end.
     1327             assign
     1328               v-diasize-browse-handle :height = v-browse-height
     1329             .
     1330             for each buf_temp-browse-handle
     1331               where buf_temp-browse-handle.browse-type = 'height':u
     1332             on error undo, next
     1333             :
     1334               assign
     1335                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1336               .
     1337             end.
     1338             assign
     1339               frame f-c-p :height = v-frame-height
     1340             .
     1341             if frame f-c-p :scrollable = true
     1342             then do:
     1343               assign
     1344                 frame f-c-p :virtual-height = v-frame-virtual-height
     1345               .
     1346             end.
     1347             run diasize_position-resize-button in this-procedure .
     1348           end.
     1349           else do:
     1350             if frame f-c-p :scrollable = true
     1351             then do:
     1352               assign
     1353                 frame f-c-p :virtual-height = v-frame-virtual-height
     1354               .
     1355             end.
     1356             assign
     1357               frame f-c-p :height = v-frame-height
     1358             .
     1359             assign
     1360               v-diasize-browse-handle :height = v-browse-height
     1361             .
     1362             for each buf_temp-browse-handle
     1363               where buf_temp-browse-handle.browse-type = 'height':u
     1364             on error undo, next
     1365             :
     1366               assign
     1367                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1368               .
     1369             end.
     1370             for each buf_temp-diasize-handle
     1371             on error undo, next
     1372             :
     1373               assign
     1374                 v-object-handle = buf_temp-diasize-handle.handle-value
     1375               .
     1376               if v-object-handle <> v-diasize-resize-button
     1377               then do:
     1378                 assign
     1379                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1380                 .
     1381               end.
     1382             end.
     1383             run diasize_position-resize-button in this-procedure .
     1384           end.
     1385           assign
     1386             v-diasize-change-size = false
     1387           .
     1388           leave move_block .
     1389         end.
     1390       end.
     1391       assign
     1392         v-diasize-need-full-display = true
     1393       .
     1394       if v-diasize-change-size = false
     1395       then do:
     1396         assign
     1397           v-diasize-change-size = true
     1398         .
     1399       end.
     1400       else do:
     1401         return .
     1402       end.
     1403       assign
     1404         v-frame-height = frame f-c-p :height
     1405         v-frame-virtual-height = frame f-c-p :virtual-height
     1406         v-browse-height = v-diasize-browse-handle :height
     1407       .
     1408       for each buf_temp-browse-handle
     1409         where buf_temp-browse-handle.browse-type = 'height':u
     1410       :
     1411         assign
     1412           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1413         .
     1414       end.
     1415       for each buf_temp-diasize-handle
     1416       :
     1417         delete buf_temp-diasize-handle .
     1418       end.
     1419       assign
     1420         v-field-group-handle = frame f-c-p :first-child
     1421       .
     1422       do while valid-handle(v-field-group-handle)
     1423       :
     1424         assign
     1425           v-object-handle = v-field-group-handle :first-child
     1426         .
     1427         do while valid-handle(v-object-handle)
     1428         :
     1429           if  v-object-handle <> v-diasize-browse-handle :handle
     1430           and can-query(v-object-handle, "row")
     1431           and can-query(v-object-handle, "height")
     1432           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1433           then do:
     1434             find first buf_temp-browse-handle
     1435               where buf_temp-browse-handle.browse-type   = 'height':u
     1436                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1437               no-error .
     1438             if available buf_temp-browse-handle
     1439             then do:
     1440             end.
     1441             else do:
     1442               create buf_temp-diasize-handle .
     1443               assign
     1444                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1445                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1446               .
     1447             end.
     1448           end.
     1449           assign
     1450             v-object-handle = v-object-handle :next-sibling
     1451           .
     1452         end.
     1453         assign
     1454           v-field-group-handle = v-field-group-handle :next-sibling
     1455         .
     1456       end.
     1457       do with frame f-c-p
     1458       :
     1459         hide v-diasize-resize-button .
     1460         assign
     1461           v-diasize-resize-button :row    = 1
     1462           v-diasize-resize-button :column = 1
     1463         .
     1464       end.
     1465       if p-change-value > 0
     1466       then do:
     1467         if frame f-c-p :scrollable = true
     1468         then do:
     1469           assign
     1470             frame f-c-p :virtual-height = frame f-c-p :virtual-height + p-change-value
     1471             no-error .
     1472           if error-status :error
     1473           or error-status :get-message(1) <> ""
     1474           then do:
     1475             undo move_block, retry move_block .
     1476           end.
     1477         end.
     1478         assign
     1479           frame f-c-p :height = frame f-c-p :height + p-change-value
     1480           no-error .
     1481         if error-status :error
     1482         or error-status :get-message(1) <> ""
     1483         then do:
     1484           undo move_block, retry move_block .
     1485         end.
     1486         assign
     1487           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1488           no-error .
     1489         if error-status :error
     1490         or error-status :get-message(1) <> ""
     1491         then do:
     1492           undo move_block, retry move_block .
     1493         end.
     1494         for each buf_temp-browse-handle
     1495           where buf_temp-browse-handle.browse-type = 'height':u
     1496         on error undo move_block, retry move_block
     1497         :
     1498           assign
     1499             buf_temp-browse-handle.browse-handle :height
     1500               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1501             no-error .
     1502           if error-status :error
     1503           or error-status :get-message(1) <> ""
     1504           then do:
     1505             undo move_block, retry move_block .
     1506           end.
     1507         end.
     1508         for each buf_temp-diasize-handle
     1509         on error undo move_block, retry move_block
     1510         :
     1511           assign
     1512             v-object-handle = buf_temp-diasize-handle.handle-value
     1513           .
     1514           if v-object-handle <> v-diasize-resize-button
     1515           then do:
     1516             assign
     1517               v-object-handle :row = v-object-handle :row + p-change-value
     1518               no-error .
     1519             if error-status :error
     1520             or error-status :get-message(1) <> ""
     1521             then do:
     1522               undo move_block, retry move_block .
     1523             end.
     1524           end.
     1525         end.
     1526       end.
     1527       else do:
     1528         for each buf_temp-diasize-handle
     1529         on error undo move_block, retry move_block
     1530         :
     1531           assign
     1532             v-object-handle = buf_temp-diasize-handle.handle-value
     1533           .
     1534           if v-object-handle <> v-diasize-resize-button
     1535           then do:
     1536             assign
     1537               v-object-handle :row = v-object-handle :row + p-change-value
     1538               no-error .
     1539             if error-status :error
     1540             or error-status :get-message(1) <> ""
     1541             then do:
     1542               undo move_block, retry move_block .
     1543             end.
     1544           end.
     1545         end.
     1546         assign
     1547           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1548           no-error .
     1549         if error-status :error
     1550         or error-status :get-message(1) <> ""
     1551         then do:
     1552           undo move_block, retry move_block .
     1553         end.
     1554         for each buf_temp-browse-handle
     1555           where buf_temp-browse-handle.browse-type = 'height':u
     1556         on error undo move_block, retry move_block
     1557         :
     1558           assign
     1559             buf_temp-browse-handle.browse-handle :height
     1560               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1561             no-error .
     1562           if error-status :error
     1563           or error-status :get-message(1) <> ""
     1564           then do:
     1565             undo move_block, retry move_block .
     1566           end.
     1567         end.
     1568         assign
     1569           frame f-c-p :height = frame f-c-p :height + p-change-value
     1570           no-error .
     1571         if error-status :error
     1572         or error-status :get-message(1) <> ""
     1573         then do:
     1574           undo move_block, retry move_block .
     1575         end.
     1576         if frame f-c-p :scrollable = true
     1577         then do:
     1578           assign
     1579             frame f-c-p :virtual-height = frame f-c-p :virtual-height + p-change-value
     1580             no-error .
     1581           if error-status :error
     1582           or error-status :get-message(1) <> ""
     1583           then do:
     1584             undo move_block, retry move_block .
     1585           end.
     1586         end.
     1587       end.
     1588       if p-move-resize = true
     1589       then do:
     1590         run diasize_position-resize-button in this-procedure .
     1591       end.
     1592       if v-diasize-wndstore = true
     1593       then do:
     1594         if connected("ub") = true
     1595         then do:
     1596           define variable v-cntxt-db-num        as integer   no-undo .
     1597           define variable v-cntxt-userid        as character no-undo .
     1598           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1599                                             , OUTPUT v-cntxt-userid
     1600                                             ) .
     1601           run gbl/wndsizew.p
     1602             (input  v-cntxt-db-num
     1603             ,input  v-cntxt-userid
     1604             ,input  v-diasize-proc-name
     1605             ,input  'height':u
     1606             ,input  string(frame f-c-p :height - v-diasize-orig-frame-height)
     1607             ) .
     1608         end.
     1609       end.
     1610     end.
     1611     assign
     1612       v-diasize-change-size = false
     1613     .
     1614   end procedure.
     1615   procedure diasize_set-height :
     1616     define input  parameter p-new-height  as decimal   no-undo .
     1617     define input  parameter p-move-resize as logical   no-undo .
     1618     do
     1619     on error undo, return error return-value
     1620     :
     1621       run diasize_change-height in this-procedure
     1622         (input  (p-new-height - frame f-c-p :height)
     1623         ,input  p-move-resize
     1624         ) .
     1625     end.
     1626   end procedure.
     1627   procedure diasize_change-width :
     1628     define input  parameter p-change-value as decimal   no-undo .
     1629     define input  parameter p-move-resize  as logical   no-undo .
     1630     define variable v-field-group-handle   as handle    no-undo .
     1631     define variable v-object-handle        as handle    no-undo .
     1632     define variable v-frame-width          as decimal   no-undo .
     1633     define variable v-frame-virtual-width  as decimal   no-undo .
     1634     define variable v-browse-width         as decimal   no-undo .
     1635     define variable v-window-width         as decimal   no-undo .
     1636     define variable v-window-virtual-width as decimal   no-undo .
     1637     define variable v-change-sign          as integer   no-undo .
     1638     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1639     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1640     if p-change-value > 0
     1641     then do:
     1642       if frame f-c-p :width + p-change-value >
     1643           session :width-chars
     1644       then do:
     1645         assign
     1646           p-change-value = session :width-chars - frame f-c-p :width
     1647         .
     1648         if p-change-value <= 0
     1649         then do:
     1650           run diasize_position-resize-button in this-procedure .
     1651           return .
     1652         end.
     1653       end.
     1654     end.
     1655     if p-change-value < 0
     1656     then do:
     1657       if frame f-c-p :width + p-change-value < v-diasize-orig-frame-width
     1658       then do:
     1659         assign
     1660           p-change-value = v-diasize-orig-frame-width
     1661                          - frame f-c-p :width
     1662         .
     1663         if p-change-value >= 0
     1664         then do:
     1665           run diasize_position-resize-button in this-procedure .
     1666           return .
     1667         end.
     1668       end.
     1669     end.
     1670     if p-change-value >= 0
     1671     then do:
     1672       assign
     1673         v-change-sign = 1
     1674       .
     1675     end.
     1676     else do:
     1677       assign
     1678         v-change-sign = -1
     1679       .
     1680     end.
     1681     assign
     1682       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1683     .
     1684     if p-change-value = 0
     1685     then do:
     1686       run diasize_position-resize-button in this-procedure .
     1687       return .
     1688     end.
     1689     move_block:
     1690     do
     1691     on error undo move_block, leave move_block
     1692     :
     1693       if retry
     1694       then do:
     1695         do
     1696         on error undo move_block, leave move_block
     1697         :
     1698           if p-change-value > 0
     1699           then do:
     1700             for each buf_temp-diasize-handle
     1701             on error undo, next
     1702             :
     1703               assign
     1704                 v-object-handle = buf_temp-diasize-handle.handle-value
     1705               .
     1706               if v-object-handle <> v-diasize-resize-button
     1707               then do:
     1708                 assign
     1709                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1710                 .
     1711               end.
     1712             end.
     1713             assign
     1714               v-diasize-browse-handle :width = v-browse-width
     1715             .
     1716             for each buf_temp-browse-handle
     1717               where buf_temp-browse-handle.browse-type = 'width':u
     1718             on error undo, next
     1719             :
     1720               assign
     1721                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1722               .
     1723             end.
     1724             assign
     1725               frame f-c-p :width = v-frame-width
     1726             .
     1727             if frame f-c-p :scrollable = true
     1728             then do:
     1729               assign
     1730                 frame f-c-p :virtual-width = v-frame-virtual-width
     1731               .
     1732             end.
     1733             run diasize_position-resize-button in this-procedure .
     1734           end.
     1735           else do:
     1736             if frame f-c-p :scrollable = true
     1737             then do:
     1738               assign
     1739                 frame f-c-p :virtual-width = v-frame-virtual-width
     1740               .
     1741             end.
     1742             assign
     1743               frame f-c-p :width = v-frame-width
     1744             .
     1745             for each buf_temp-browse-handle
     1746               where buf_temp-browse-handle.browse-type = 'width':u
     1747             on error undo, next
     1748             :
     1749               assign
     1750                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1751               .
     1752             end.
     1753             assign
     1754               v-diasize-browse-handle :width = v-browse-width
     1755             .
     1756             for each buf_temp-diasize-handle
     1757             on error undo, next
     1758             :
     1759               assign
     1760                 v-object-handle = buf_temp-diasize-handle.handle-value
     1761               .
     1762               if v-object-handle <> v-diasize-resize-button
     1763               then do:
     1764                 assign
     1765                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1766                 .
     1767               end.
     1768             end.
     1769             run diasize_position-resize-button in this-procedure .
     1770           end.
     1771           assign
     1772             v-diasize-change-size = false
     1773           .
     1774           leave move_block .
     1775         end.
     1776       end.
     1777       assign
     1778         v-diasize-need-full-display = true
     1779       .
     1780       if v-diasize-change-size = false
     1781       then do:
     1782         assign
     1783           v-diasize-change-size = true
     1784         .
     1785       end.
     1786       else do:
     1787         return .
     1788       end.
     1789       assign
     1790         v-frame-width = frame f-c-p :width
     1791         v-frame-virtual-width = frame f-c-p :virtual-width
     1792         v-browse-width = v-diasize-browse-handle :width
     1793       .
     1794       for each buf_temp-browse-handle
     1795         where buf_temp-browse-handle.browse-type = 'width':u
     1796       :
     1797         assign
     1798           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1799         .
     1800       end.
     1801       for each buf_temp-diasize-handle
     1802       :
     1803         delete buf_temp-diasize-handle .
     1804       end.
     1805       assign
     1806         v-field-group-handle = frame f-c-p :first-child
     1807       .
     1808       do while valid-handle(v-field-group-handle)
     1809       :
     1810         assign
     1811           v-object-handle = v-field-group-handle :first-child
     1812         .
     1813         do while valid-handle(v-object-handle)
     1814         :
     1815           if  v-object-handle <> v-diasize-browse-handle :handle
     1816           and v-object-handle <> v-diasize-resize-button
     1817           and can-query(v-object-handle, "row")
     1818           and can-query(v-object-handle, "height")
     1819           and ( v-object-handle :col + v-object-handle :width
     1820                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1821               )
     1822           then do:
     1823             find first buf_temp-browse-handle
     1824               where buf_temp-browse-handle.browse-type   = 'width':u
     1825                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1826               no-error .
     1827             if available buf_temp-browse-handle
     1828             then do:
     1829             end.
     1830             else do:
     1831               create buf_temp-diasize-handle .
     1832               assign
     1833                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1834                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1835               .
     1836             end.
     1837           end.
     1838           assign
     1839             v-object-handle = v-object-handle :next-sibling
     1840           .
     1841         end.
     1842         assign
     1843           v-field-group-handle = v-field-group-handle :next-sibling
     1844         .
     1845       end.
     1846       do with frame f-c-p
     1847       :
     1848         hide v-diasize-resize-button .
     1849         v-diasize-resize-button :row = 1.
     1850         v-diasize-resize-button :column = 1.
     1851       end.
     1852       if p-change-value > 0
     1853       then do:
     1854         if frame f-c-p :scrollable = true
     1855         then do:
     1856           assign
     1857             frame f-c-p :virtual-width = frame f-c-p :virtual-width + p-change-value
     1858             no-error .
     1859           if error-status :error
     1860           or error-status :get-message(1) <> ""
     1861           then do:
     1862             undo move_block, retry move_block.
     1863           end.
     1864         end.
     1865         assign
     1866           frame f-c-p :width = v-frame-width + p-change-value
     1867           no-error .
     1868         if error-status :error
     1869         or error-status :get-message(1) <> ""
     1870         then do:
     1871           undo move_block, retry move_block.
     1872         end.
     1873         assign
     1874           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1875         no-error .
     1876         if error-status :error
     1877         or error-status :get-message(1) <> ""
     1878         then do:
     1879           undo move_block, retry move_block.
     1880         end.
     1881         for each buf_temp-browse-handle
     1882           where buf_temp-browse-handle.browse-type = 'width':u
     1883         on error undo move_block, retry move_block
     1884         :
     1885           assign
     1886             buf_temp-browse-handle.browse-handle :width
     1887               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1888             no-error .
     1889           if error-status :error
     1890           or error-status :get-message(1) <> ""
     1891           then do:
     1892             undo move_block, retry move_block .
     1893           end.
     1894         end.
     1895         for each buf_temp-diasize-handle
     1896         on error undo move_block, retry move_block
     1897         :
     1898           assign
     1899             v-object-handle = buf_temp-diasize-handle.handle-value
     1900           .
     1901           if v-object-handle <> v-diasize-resize-button
     1902           then do:
     1903             assign
     1904               v-object-handle :col = v-object-handle :col + p-change-value
     1905               no-error .
     1906             if error-status :error
     1907             or error-status :get-message(1) <> ""
     1908             then do:
     1909               undo move_block, retry move_block .
     1910             end.
     1911           end.
     1912         end.
     1913       end.
     1914       else do:
     1915         for each buf_temp-diasize-handle
     1916         on error undo move_block, retry move_block
     1917         :
     1918           assign
     1919             v-object-handle = buf_temp-diasize-handle.handle-value
     1920           .
     1921           if v-object-handle <> v-diasize-resize-button
     1922           then do:
     1923             assign
     1924               v-object-handle :col = v-object-handle :col + p-change-value
     1925               no-error .
     1926             if error-status :error
     1927             or error-status :get-message(1) <> ""
     1928             then do:
     1929               undo move_block, retry move_block .
     1930             end.
     1931           end.
     1932         end.
     1933         for each buf_temp-browse-handle
     1934           where buf_temp-browse-handle.browse-type = 'width':u
     1935         on error undo move_block, retry move_block
     1936         :
     1937           assign
     1938             buf_temp-browse-handle.browse-handle :width
     1939               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1940             no-error .
     1941           if error-status :error
     1942           or error-status :get-message(1) <> ""
     1943           then do:
     1944             undo move_block, retry move_block .
     1945           end.
     1946         end.
     1947         assign
     1948           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1949           no-error .
     1950         if error-status :error
     1951         or error-status :get-message(1) <> ""
     1952         then do:
     1953           undo move_block, retry move_block.
     1954         end.
     1955         assign
     1956           frame f-c-p :width = frame f-c-p :width + p-change-value
     1957         no-error .
     1958         if error-status :error
     1959         or error-status :get-message(1) <> ""
     1960         then do:
     1961           undo move_block, retry move_block.
     1962         end.
     1963         if frame f-c-p :scrollable = true
     1964         then do:
     1965           assign
     1966             frame f-c-p :virtual-width = frame f-c-p :virtual-width + p-change-value
     1967           no-error .
     1968           if error-status :error
     1969           or error-status :get-message(1) <> ""
     1970           then do:
     1971             undo move_block, retry move_block.
     1972           end.
     1973         end.
     1974       end.
     1975       if p-move-resize
     1976       then do:
     1977         run diasize_position-resize-button in this-procedure .
     1978       end.
     1979       if v-diasize-wndstore = true
     1980       then do:
     1981         if connected("ub") = true
     1982         then do:
     1983           define variable v-cntxt-db-num        as integer   no-undo .
     1984           define variable v-cntxt-userid        as character no-undo .
     1985           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1986                                             , OUTPUT v-cntxt-userid
     1987                                             ) .
     1988           run gbl/wndsizew.p
     1989             (input  v-cntxt-db-num
     1990             ,input  v-cntxt-userid
     1991             ,input  v-diasize-proc-name
     1992             ,input  'width':u
     1993             ,input  string(frame f-c-p :width - v-diasize-orig-frame-width)
     1994             ) .
     1995         end.
     1996       end.
     1997     end.
     1998     assign
     1999       v-diasize-change-size = false
     2000     .
     2001   end procedure.
     2002   procedure diasize_set-width :
     2003     define input  parameter p-new-width  as decimal   no-undo .
     2004     define input  parameter p-move-resize as logical   no-undo .
     2005     do
     2006     on error undo, return error return-value
     2007     :
     2008       run diasize_change-width in this-procedure
     2009         (input  (p-new-width - frame f-c-p :width)
     2010         ,input  p-move-resize
     2011         ) .
     2012     end.
     2013   end procedure.
     2014   procedure diasize_position-resize-button :
     2015     do with frame f-c-p
     2016     :
     2017       hide v-diasize-resize-button .
     2018       assign
     2019         v-diasize-resize-button :row = frame f-c-p :height - v-diasize-resize-button :height
     2020                     - 1
     2021                     - (frame f-c-p :border-bottom-pixels / session :pixels-per-row)
     2022         v-diasize-resize-button :col = frame f-c-p :width - v-diasize-resize-button :width
     2023                     - 1
     2024                     - (frame f-c-p :border-right-pixels / session :pixels-per-column)
     2025       .
     2026       view v-diasize-resize-button .
     2027     end.
     2028   end procedure.
     2029   on alt-right anywhere
     2030   do:
     2031     run diasize_change-width in this-procedure
     2032       (input 1
     2033       ,input true
     2034       ) .
     2035     return no-apply .
     2036   end.
     2037   on alt-left anywhere
     2038   do:
     2039     run diasize_change-width in this-procedure
     2040       (input -1
     2041       ,input true
     2042       ) .
     2043     return no-apply .
     2044   end.
     2045   on alt-down anywhere
     2046   do:
     2047     run diasize_change-height in this-procedure
     2048       (input 1
     2049       ,input true
     2050       ) .
     2051     return no-apply .
     2052   end.
     2053   on alt-up anywhere
     2054   do:
     2055     run diasize_change-height in this-procedure
     2056       (input -1
     2057       ,input true
     2058       ) .
     2059     return no-apply .
     2060   end.
     2061   on alt-enter of frame f-c-p
     2062   do:
     2063     run diasize_maximize in this-procedure
     2064       (input  ?
     2065       ).
     2066     return no-apply .
     2067   end.
     2068   procedure diasize_end-move :
     2069     do
     2070     on error undo, return error return-value
     2071     :
     2072       define variable v-row-delta as decimal   no-undo .
     2073       define variable v-col-delta as decimal   no-undo .
     2074       define variable v-new-row as decimal   no-undo .
     2075       define variable v-new-col as decimal   no-undo .
     2076       assign
     2077         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2078         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2079       .
     2080       assign
     2081         v-row-delta = v-new-row - frame f-c-p :height
     2082         v-col-delta = v-new-col - frame f-c-p :width
     2083       .
     2084       run diasize_change-height in this-procedure
     2085         (input v-row-delta
     2086         ,input true
     2087         ) .
     2088       run diasize_change-width in this-procedure
     2089         (input v-col-delta
     2090         ,input true
     2091         ) .
     2092     end.
     2093   end procedure.
     2094   procedure diasize_maximize :
     2095     define input  parameter p-action as logical   no-undo .
     2096     do
     2097     on error undo, return error return-value
     2098     :
     2099       if p-action = ?
     2100       then do:
     2101         if v-diasize-need-maximize = true
     2102         then do:
     2103           assign
     2104             p-action = true
     2105           .
     2106         end.
     2107         else do:
     2108           assign
     2109             p-action = false
     2110           .
     2111         end.
     2112       end.
     2113       if p-action = true
     2114       then do:
     2115         run diasize_change-height in this-procedure
     2116           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2117               - frame f-c-p :height-chars
     2118           ,input true
     2119           ) .
     2120         run diasize_change-width in this-procedure
     2121           (input session :width-chars
     2122               - frame f-c-p :width-chars
     2123           ,input true
     2124           ) .
     2125         assign
     2126           v-diasize-need-maximize = false
     2127         .
     2128       end.
     2129       else do:
     2130         run diasize_change-width in this-procedure
     2131           (input v-diasize-orig-frame-width
     2132               - frame f-c-p :width-chars
     2133           ,input true
     2134           ) .
     2135         run diasize_change-height in this-procedure
     2136           (input v-diasize-orig-frame-height
     2137               - frame f-c-p :height-chars
     2138           ,input true
     2139           ) .
     2140         assign
     2141           v-diasize-need-maximize = true
     2142         .
     2143       end.
     2144     end.
     2145   end procedure.
     2146   procedure diasize_restore-orig-size :
     2147     do
     2148     on error undo, return error return-value
     2149     :
     2150       assign
     2151         v-diasize-current-frame-width  = frame f-c-p :width
     2152         v-diasize-current-frame-height = frame f-c-p :height
     2153       .
     2154       run diasize_set-height in this-procedure
     2155         (input  v-diasize-orig-frame-height
     2156         ,input  true
     2157         ) .
     2158       run diasize_set-width in this-procedure
     2159         (input  v-diasize-orig-frame-width
     2160         ,input  true
     2161         ) .
     2162     end.
     2163   end procedure.
     2164   procedure diasize_restore-current-size :
     2165     do
     2166     on error undo, return error return-value
     2167     :
     2168       run diasize_set-height in this-procedure
     2169         (input  v-diasize-current-frame-height
     2170         ,input  true
     2171         ) .
     2172       run diasize_set-width in this-procedure
     2173         (input  v-diasize-current-frame-width
     2174         ,input  true
     2175         ) .
     2176     end.
     2177   end procedure.
     2178   procedure diasize_set-browse-handle :
     2179     define input  parameter p-browse-handle as handle   no-undo .
     2180     define buffer buf_temp-browse-handle for temp-browse-handle .
     2181     do
     2182     on error undo, return error return-value
     2183     :
     2184       assign
     2185         v-diasize-browse-handle = p-browse-handle
     2186       .
     2187       for each buf_temp-browse-handle
     2188       on error undo, return error return-value
     2189       :
     2190         delete buf_temp-browse-handle .
     2191       end.
     2192     end.
     2193   end procedure.
     2194   procedure diasize_add_browse :
     2195     define input  parameter p-browse-type   as character no-undo .
     2196     define input  parameter p-browse-handle as handle    no-undo .
     2197     define buffer buf_temp-browse-handle for temp-browse-handle .
     2198     do
     2199     on error undo, return error return-value
     2200     :
     2201       assign
     2202         v-diasize-browse-number = v-diasize-browse-number + 1
     2203       .
     2204       create buf_temp-browse-handle .
     2205       assign
     2206         buf_temp-browse-handle.browse-type   = p-browse-type
     2207         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2208         buf_temp-browse-handle.browse-handle = p-browse-handle
     2209       .
     2210     end.
     2211   end procedure.
     2212   procedure diasize_init :
     2213     define variable v-default-value    as logical   no-undo .
     2214     define variable v-restore-saved    as logical   no-undo .
     2215     define variable v-resize-value-str as character no-undo .
     2216     do
     2217     on error undo, return error return-value
     2218     :
     2219       do with frame f-c-p
     2220       :
     2221         assign
     2222           v-diasize-orig-frame-height = frame f-c-p :height
     2223           v-diasize-orig-frame-width  = frame f-c-p :width
     2224           v-diasize-browse-handle     = browse cashpg :handle
     2225         .
     2226         create button v-diasize-resize-button
     2227         assign
     2228           parent        = frame f-c-p :first-child
     2229           label         = "s"
     2230           height-pixels = 16
     2231           width-pixels  = 16
     2232           visible       = true
     2233           sensitive     = true
     2234           movable       = true
     2235           triggers:
     2236             on end-move persistent run diasize_end-move in this-procedure .
     2237           end triggers.
     2238         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2239         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2240         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2241         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2242         assign
     2243           v-diasize-wndmax = false
     2244         .
     2245         if connected("ub") = true
     2246         then do:
     2247           define variable v-cntxt-db-num        as integer   no-undo .
     2248           define variable v-cntxt-userid        as character no-undo .
     2249           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2250                                             , OUTPUT v-cntxt-userid
     2251                                             ) .
     2252           run gbl/wndpar_r.p
     2253             (input  v-cntxt-db-num
     2254             ,input  v-cntxt-userid
     2255             ,input  'wndmax':U
     2256             ,output v-diasize-wndmax
     2257             ,output v-default-value
     2258             ) .
     2259         end.
     2260         assign
     2261           v-diasize-wndstore = false
     2262         .
     2263         if connected("ub") = true
     2264         then do:
     2265           run gbl/wndpar_r.p
     2266             (input  v-cntxt-db-num
     2267             ,input  v-cntxt-userid
     2268             ,input  'wndstore':U
     2269             ,output v-diasize-wndstore
     2270             ,output v-default-value
     2271             ) .
     2272         end.
     2273         assign
     2274           v-diasize-proc-name = entry(1, program-name(2), '.')
     2275         .
     2276         if v-diasize-wndstore = true
     2277         then do:
     2278           assign
     2279             v-restore-saved = false
     2280           .
     2281           if connected("ub") = true
     2282           then do:
     2283             run gbl/wndsizer.p
     2284               (input  v-cntxt-db-num
     2285               ,input  v-cntxt-userid
     2286               ,input  v-diasize-proc-name
     2287               ,input  'height':u
     2288               ,output v-resize-value-str
     2289               ) .
     2290             if v-resize-value-str <> '':U
     2291             then do:
     2292               run diasize_change-height in this-procedure
     2293                 (input  integer(v-resize-value-str)
     2294                 ,input  true
     2295                 ) .
     2296               assign
     2297                 v-restore-saved = true
     2298               .
     2299             end.
     2300           end.
     2301           if connected("ub") = true
     2302           then do:
     2303             run gbl/wndsizer.p
     2304               (input  v-cntxt-db-num
     2305               ,input  v-cntxt-userid
     2306               ,input  v-diasize-proc-name
     2307               ,input  'width':u
     2308               ,output v-resize-value-str
     2309               ) .
     2310             if v-resize-value-str <> '':U
     2311             then do:
     2312               run diasize_change-width in this-procedure
     2313                 (input  integer(v-resize-value-str)
     2314                 ,input  true
     2315                 ) .
     2316               assign
     2317                 v-restore-saved = true
     2318               .
     2319             end.
     2320           end.
     2321           if v-restore-saved <> true
     2322           then do:
     2323             if v-diasize-wndmax = true
     2324             then do:
     2325               run diasize_maximize in this-procedure
     2326                 (input  true
     2327                 ) .
     2328             end.
     2329           end.
     2330         end.
     2331         else do:
     2332           if v-diasize-wndmax = true
     2333           then do:
     2334             run diasize_maximize in this-procedure
     2335               (input  true
     2336               ) .
     2337           end.
     2338         end.
     2339       end.
     2340     end.
     2341   end procedure.
     2342   procedure diasize_need-full-display :
     2343     define output parameter p-need-full-display as logical   no-undo .
     2344     do
     2345     on error undo, return error return-value
     2346     :
     2347       assign
     2348         p-need-full-display = v-diasize-need-full-display
     2349       .
     2350       assign
     2351         v-diasize-need-full-display = false
     2352       .
     2353     end.
     2354   end procedure.
     2355   procedure get-context :
     2356      define output parameter p-db-num as integer          no-undo.
     2357      define output parameter p-user-id as character        no-undo.
     2358      define variable v-login               as character    no-undo.
     2359      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2360      define buffer buf_user-login  for ub.user-login .
     2361      do
     2362      on error undo, return error
     2363      :
     2364            FIND FIRST buf_sys-ctrl no-lock.
     2365            ASSIGN
     2366               v-login = USERID("ub")
     2367               p-db-num = buf_sys-ctrl.db-num
     2368            .
     2369            FIND FIRST buf_user-login
     2370                 WHERE buf_user-login.db-num = p-db-num
     2371                   AND buf_user-login.user-login = v-login
     2372                 no-lock
     2373                 no-error
     2374                 .
     2375            IF AVAILABLE buf_user-login
     2376            THEN DO:
     2377               assign
     2378                  p-user-id = buf_user-login.user-id
     2379               .
     2380            END.
     2381      end.
     2382   end procedure.
     2383       run diasize_init in this-procedure .
     2384   on window-close of frame f-c-p
     2385     apply "END-ERROR":U to self.
     2386   MAIN-BLOCK:
     2387   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
     2388     on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
     2389      if imode eq 'ВЫБОР':U
     2390      then
     2391         run rid-rest no-error.
     2392   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2393     run mainmenu_getcntxt in parparentproc
     2394       (output v-cntxt-db-num
     2395       ,output v-cntxt-userid
     2396       ,output v-cntxt-level
     2397       ,output v-cntxt-host-code-obj
     2398       ,output v-cntxt-obj-type
     2399       ,output v-cntxt-obj-code
     2400       ,output v-cntxt-db-num-obj
     2401       ,output v-cntxt-is-admin
     2402       ) .
     2403   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2404   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2405     (output v-db-num
     2406     )  .
     2407     run enable_UI in this-procedure .
     2408     wait-for go of frame f-c-p focus cashpg.
     2409     if imode eq 'ВЫБОР':U
     2410     then
     2411        run rid-keep no-error.
     2412   end.
     2413   run disable_UI in this-procedure .
     2414   PROCEDURE disable_UI :
     2415     HIDE FRAME f-c-p.
     2416   END PROCEDURE.
     2417   PROCEDURE enable_UI :
     2418     enable
     2419       mSearch
     2420       cashpg
     2421       b-exit
     2422       b-sel
     2423       when iMode eq 'ВЫБОР':U
     2424       b-add
     2425       when iMode eq 'ИЗМЕНЕНИЕ':U and v-db-num = 0
     2426       b-del
     2427       when iMode eq 'ИЗМЕНЕНИЕ':U and v-db-num = 0
     2428       b-upd
     2429       when iMode eq 'ИЗМЕНЕНИЕ':U and v-db-num = 0
     2430       b-help
     2431       b-hist
     2432       with frame f-c-p.
     2433    b-hist:POPUP-MENU in frame f-c-p = menu POPUP-MENU-b-hist:HANDLE.
     2434      b-hist:MENU-MOUSE = 1.
     2435     fselect                :visible in browse cashpg = imode eq 'ВЫБОР':U.
     2436     OPEN QUERY cashpg FOR EACH buf-code-func       WHERE buf-code-func.parent = iparent + chr(4) + icode NO-LOCK,       EACH  buf-code-param WHERE buf-code-param.parent =  buf-code-func.parent + chr(4) + buf-code-func.code NO-LOCK by getKeyName(buf-code-func.code) + " (" + buf-code-func.code + ")" INDEXED-REPOSITION.
     2437   end procedure.
     2438   FUNCTION getKeytype RETURNS CHARACTER
     2439      ( iCode as char):
     2440      define buffer code for ub.code.
     2441      find first code where code.parent eq "CashFunKey"
     2442                        and code.code   eq iCode
     2443      no-lock no-error.
     2444      return if available code then code.misc1 else "".
     2445   end.
     2446   FUNCTION getStatus RETURNS CHARACTER
     2447      ( imisc as char, istatus as int   ):
     2448      define buffer code for ub.code.
     2449      if istatus eq 1
     2450      then
     2451         return "Необязательный".
     2452      else
     2453         return "Обязательный".
     2454   end.
     2455   FUNCTION getKeyName RETURNS CHARACTER
     2456      ( iCode as char):
     2457      define buffer code for ub.code.
     2458      find first code where code.parent eq "CashFunKey"
     2459                        and code.code   eq iCode
     2460      no-lock no-error.
     2461      return if available code then code.codename else "".
     2462   end.
