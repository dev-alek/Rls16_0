      357   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      358   define  stream PrnLibStream.
      359   procedure prn-lib-prn-file :
      360     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      361     define input parameter p-DIsabledoptions as integer no-undo .
      362     define variable v-report-name as character no-undo .
      363     define variable v-user-action as character no-undo .
      364     define variable v-printed     as logical   no-undo .
      365     define variable v-exist       as logical   no-undo .
      366     do
      367       on error undo, return error
      368       :
      369       run prn-lib-get-report-name  in this-procedure (
      370         input parParentProc
      371         ,output v-report-name
      372         ).
      373   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      374   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      375     (input  v-report-name
      376     ,input  2
      377     ,output v-exist
      378     )  .
      379       if NOT v-exist then
      380       DO:
      381         Message
      382           "Нет заданий на печать ! "
      383           view-as alert-box .
      384         Return  .
      385       End.
      386       run gbl/prnfilen.w
      387         (input  ""
      388         ,input  p-DisabledOptions
      389         ,input  string(v-report-name )
      390         ,input  7
      391         ,output v-user-action
      392         ,output v-printed
      393         ) .
      394       if v-printed then
      395       do:
