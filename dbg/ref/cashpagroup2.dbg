      124   procedure cur-time :
      125      define output parameter p-today as date      no-undo .
      126      define output parameter p-time  as integer   no-undo .
      127     do
      128     on error undo, return error
      129     :
      130       define variable v-date1 as date      no-undo .
      131       define variable v-date2 as date      no-undo .
      132       define variable v-time  as integer   no-undo .
      133       assign
      134         v-date1 = today
      135         v-time  = time
      136         v-date2 = today
      137       .
      138       if v-date1 <> v-date2
      139       then do:
      140         assign
      141           v-date1 = today
      142           v-time  = v-time
      143         .
      144       end.
      145       assign
      146         p-today = v-date1
      147         p-time  = v-time
      148       .
      149     end.
      150   end.
      151   function cur-time-date returns character
      152   :
      153     return string(today, '99/99/9999':U) .
      154   end.
      155   function cur-time-mjd returns decimal
      156   :
      157     define variable v-date as date      no-undo .
      158     define variable v-time as integer   no-undo .
      159     run cur-time in this-procedure
      160       (output v-date
      161       ,output v-time
      162       ) .
      163     return integer(v-date) - 2400002 + (v-time / 86400) .
      164   end.
      165   function cur-time-get-ending-index returns integer
      166   (input p-number as integer
      167   )
      168   :
      169     if p-number < 0
      170     or p-number = ?
      171     then do:
      172       return 1 .
      173     end.
      174     define variable v-rest as integer   no-undo .
      175     assign
      176       p-number = p-number modulo 100
      177     .
      178     if p-number < 20
      179     then do:
      180       assign
      181         v-rest = p-number
      182       .
      183     end.
      184     else do:
      185       assign
      186         v-rest = p-number modulo 10
      187       .
      188     end.
      189     case v-rest :
      190       when 1
      191       then do:
      192         return 2 .
      193       end.
      194       when 2 or
      195       when 3 or
      196       when 4
      197       then do:
      198         return 3 .
      199       end.
      200       otherwise do:
      201         return 1 .
      202       end.
      203     end case .
      204   end.
      205   procedure cur-time-mjd-to-date :
      206      define input  parameter i-mjd-diff as decimal no-undo.
      207      define output parameter o-Date     as date    no-undo.
      208      define output parameter o-Time     as integer no-undo.
      209      define variable v-day-number as integer   no-undo .
      210      if    i-mjd-diff < 0
      211         or i-mjd-diff = ?
      212      then do:
      213         return "?" .
      214      end.
      215      assign
      216         v-day-number = truncate(i-mjd-diff,0).
      217         o-Date = date(v-day-number + 2400002).
      218         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      219     .
      220   end.
      221   function cur-time-mjd-to-string returns character
      222   (input p-mjd-diff as decimal
      223   )
      224   :
      225     define variable v-day-number as integer   no-undo .
      226     define variable v-seconds    as integer   no-undo .
      227     define variable v-hour       as integer   no-undo .
      228     define variable v-min        as integer   no-undo .
      229     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      230     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      231     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      232     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      233     if p-mjd-diff < 0
      234     or p-mjd-diff = ?
      235     then do:
      236       return "?" .
      237     end.
      238     assign
      239       v-day-number = integer(truncate(p-mjd-diff,0))
      240       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      241     .
      242     if v-seconds > 86400
      243     then do:
      244       assign
      245         v-seconds = 86400 - 1
      246       .
      247     end.
      248     if v-seconds < 0
      249     then do:
      250       assign
      251         v-seconds = 0
      252       .
      253     end.
      254     assign
      255       v-hour = truncate(v-seconds / 3600, 0)
      256     .
      257     assign
      258       v-seconds = v-seconds modulo 3600
      259     .
      260     assign
      261       v-min = truncate(v-seconds / 60, 0)
      262     .
      263     assign
      264       v-seconds = v-seconds modulo 60
      265     .
      266     return
      267         (if v-day-number <> 0
      268           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      269           else ""
      270         )
      271       + (if v-day-number <> 0 or v-hour <> 0
      272           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      273           else ""
      274         )
      275       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      276           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      277           else ""
      278         )
      279       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      280       .
      281   end.
      282   function cur-time-string returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-string-sec returns character
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      301   end.
      302   function cur-time-custom  returns character
      303   (input p-prefix as character
      304   ,input p-date-format as character
      305   ,input p-delimiter as character
      306   ,input p-time-format as character
      307   ,input p-suffix as character
      308   )
      309   :
      310     define variable v-date as date      no-undo .
      311     define variable v-time as integer   no-undo .
      312     run cur-time in this-procedure
      313       (output v-date
      314       ,output v-time
      315       ) .
      316     return
      317       p-prefix
      318       + string(v-date, p-date-format)
      319       + p-delimiter
      320       + string(v-time, p-time-format)
      321       + p-suffix
      322       .
      323   end.
      324   function cur-time-print  returns character
      325   :
      326     define variable v-date as date      no-undo .
      327     define variable v-time as integer   no-undo .
      328     run cur-time in this-procedure
      329       (output v-date
      330       ,output v-time
      331       ) .
      332     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      333   end.
      334   function cur-time-datetime returns datetime
      335   :
      336     define variable v-char as character no-undo .
      337     define variable v-datetime as datetime no-undo .
      338     v-char = cur-time-string().
      339     v-datetime = datetime(v-char).
      340     return  v-datetime.
      341   end.
      342   function cur-time-string-msec returns character
      343   :
      344     define variable v-date as datetime  no-undo .
      345     v-date = now.
      346     return string(v-date) .
      347   end.
      348   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      349     define variable v-cntxt-db-num        as integer   no-undo .
