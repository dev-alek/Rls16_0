      499     define input parameter p-report-name-html as character no-undo .
      500     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      501   end procedure.
      502   procedure prn-lib-reportviewer :
      503     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      504     define input parameter p-report-name-html as character no-undo .
      505     define input parameter p-param        as character no-undo .
      506     define variable v-excel           as character no-undo init 'TRUE' .
      507     define variable v-value-character as character no-undo .
      508     define variable v-value-integer   as character no-undo .
      509     define variable v-value-date      as date      no-undo .
      510     define variable v-value-decimal   as decimal   no-undo .
      511     define variable rep-excel         as logical   no-undo .
      512     define variable excel-string      as character no-undo .
      513     define variable v-param-type      as character no-undo .
      514     define variable v-tth             as handle    no-undo .
      515     run adm/shattri.p (
      516       input "get":U
      517       ,input  ""
      518       ,input  0
      519       ,input  'report-glob':U
      520       ,input  'rep-excel':U
      521       ,output v-value-character
      522       ,output v-value-date
      523       ,output v-value-decimal
      524       ,output v-value-integer
      525       ,output rep-excel
      526       ,output v-param-type
      527       ,INPUT-OUTPUT table-handle v-tth
      528       )  .
      529     if rep-excel then v-excel = "TRUE" .
      530     else v-excel = "FALSE" .
      531     if p-param eq ""
      532     then
      533        p-param = "EXCEL:" + v-excel.
      534     else
      535        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      536     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      537   end procedure.
