     2952   end .
     2953   ON CHOOSE OF b-mi-tmp IN FRAME d-pl-form
     2954   DO:
     2955     define variable v-node-code as integer no-undo.
     2956     define variable v-sr-type-id as character no-undo.
     2957     define variable v-sr-type-izm as character no-undo .
     2958     v-node-code = 0 .
     2959       v-sr-type-izm = "0,1" .
     2960     run ref/sr-izm.w (input parparentproc ,
     2961                       input "b-sel"       ,
     2962                       input 'ПРОСМОТР':U     ,
     2963                       input v-sr-type-izm ,
     2964                       input "tmp"         ,
     2965                       input-output v-node-code,
     2966                       output v-sr-type-id) no-error.
     2967     if v-node-code <> 0 and v-node-code <> ? then do :
     2968       v-mi-tmp = v-node-code.
     2969       v-mi-tmp:screen-value = string(v-node-code).
     2970       find first tmp_sr-izmerenia no-lock where tmp_sr-izmerenia.node-code = v-mi-tmp .
     2971       apply "leave" to v-mi-tmp in frame d-pl-form .
