       82     define output parameter p-label          as character no-undo .
       83     define output parameter p-user-can-edit  as logical   no-undo .
       84     define output parameter p-output-display as logical   no-undo .
       85     define output parameter p-other          as character no-undo .
       86     do
       87     on error undo, return error
       88     :
       89           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
       90         (input  p-code
       91         ,output p-type
       92         ,output p-format
       93         ,output p-label
       94         ,output p-user-can-edit
       95         ,output p-output-display
       96         ,output p-other
       97         ) no-error .
       98       if error-status :error
       99       then do:
      100         undo, return error return-value .
      101       end.
      102     end.
