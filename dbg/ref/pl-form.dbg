      657   function is-sug returns logical
      658           (input p-gds-code as integer):
      659   define variable result as logical no-undo.
      660   define variable c-value as character no-undo.
      661   define variable c-type as character no-undo.
      662   do on error undo, return error:
      663           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
      664         (input  p-gds-code
      665         ,input  'fuel-type':U
      666         ,output c-value
      667         ,output c-type) no-error.
      668   end.
      669   result = logical(c-value = 'lgas':U) no-error.
      670   return result.
      671   end function.
      672   procedure proc-alt-shift-f2:
      673     if not ibs.th.gbl.gbl-var:rcode
      674   then
      675     run gbl\inidebug.p .
      676   end.
      677   procedure proc-alt-shift-f3:
      678     run gbl/prvssinf.p
      679       ( input this-procedure
      680       ) .
      681   end.
      682   define variable v-inform-launched as logical no-undo initial false .
      683   procedure proc-alt-shift-f4:
      684     define variable v-action as character no-undo .
      685     if v-inform-launched = false then do:
      686       assign
      687         v-inform-launched = true
      688       .
      689       run gbl/d-inform.w
      690         (  input self
      691         ,  input this-procedure
      692         , output v-action
      693         ) no-error .
      694       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      695       assign
      696         v-inform-launched = false
      697       .
      698     end.
      699   end.
      700   procedure proc-alt-f1:
      701     run gbl/corrhelp.p
      702       (input this-procedure
      703       ) .
      704   end .
      705   on alt-shift-f2 anywhere do:
      706     run proc-alt-shift-f2.
      707   end.
      708   on alt-shift-f3 anywhere do:
      709     run proc-alt-shift-f3 in this-procedure .
      710   end.
      711   on alt-shift-f4 anywhere do:
      712     run proc-alt-shift-f4 in this-procedure.
      713   end.
      714   on alt-f1 anywhere do:
      715     run proc-alt-f1 in this-procedure .
      716   end.
      717   procedure placelib_write-attr:
      718   define input  parameter p-code     like ub.place-attr.attr-code .
      719   define input  parameter p-obj-code like ub.place-attr.obj-code .
      720   define input  parameter p-obj-type like ub.place-attr.obj-type .
      721   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      722   define input  parameter p-value    like ub.place-attr.attr-value .
      723   define output parameter p-ok       as logical.
      724   define buffer buf_place-attr for ub.place-attr .
      725     do on error undo, return error return-value :
      726        p-ok = false.
      727        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      728                                                   and buf_place-attr.obj-code    = p-obj-code
      729                                                   and buf_place-attr.obj-type    = p-obj-type
      730                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      731        if not available buf_place-attr then do :
      732           create buf_place-attr.
      733           assign
      734             buf_place-attr.attr-code   = p-code
      735             buf_place-attr.attr-value  = p-value
      736             buf_place-attr.obj-code    = p-obj-code
      737             buf_place-attr.obj-type    = p-obj-type
      738             buf_place-attr.pl-code     = p-pl-code
      739           .
      740           p-ok = true.
      741        end.
      742        else do:
      743           buf_place-attr.attr-value  = p-value .
      744           p-ok = true.
      745        end.
      746     end.
      747   end.
      748   procedure placelib_get-attr:
      749   define input  parameter  p-code     like ub.place-attr.attr-code .
      750   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      751   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      752   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      753   define output parameter  p-value    like ub.place-attr.attr-value .
      754   define output parameter  p-ok       as logical.
      755   define buffer buf_place-attr for ub.place-attr .
      756     do on error undo, return error return-value :
      757        p-ok = false.
      758        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      759                                                   and buf_place-attr.obj-code    = p-obj-code
      760                                                   and buf_place-attr.obj-type    = p-obj-type
      761                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      762        if available buf_place-attr then do :
      763          p-value = buf_place-attr.attr-value.
      764          p-ok = true.
      765        end.
      766        else do :
      767          p-ok = false.
      768        end.
      769     end.
      770   end.
      771   procedure placelib_del-attr:
      772   define input parameter  p-code     like ub.place-attr.attr-code .
      773   define input parameter  p-obj-code like ub.place-attr.obj-code .
      774   define input parameter  p-obj-type like ub.place-attr.obj-type .
      775   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      776   define input parameter  p-value    like ub.place-attr.attr-value .
      777   define output parameter p-ok       as logical.
      778   define buffer buf_place-attr for ub.place-attr .
      779     do on error undo, return error return-value :
      780        p-ok = false.
      781        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      782                                                   and buf_place-attr.obj-code    = p-obj-code
      783                                                   and buf_place-attr.obj-type    = p-obj-type
      784                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      785        if available buf_place-attr then do :
      786           delete buf_place-attr.
      787           p-ok = true.
      788        end.
      789     end.
      790   end.
