     2995   end .
     2996   on del of v-mi-lvl in frame d-pl-form
     2997   do :
     2998     v-mi-lvl = 0   .
     2999     v-mi-lvl:screen-value = "0" .
     3000   end .
     3001   on leave of v-mi-tmp IN FRAME d-pl-form
     3002   do:
     3003     define variable vlog as logical no-undo .
     3004     define variable v-old-val as character no-undo .
     3005     v-old-val = string(v-mi-tmp) .
     3006     if v-mi-tmp:screen-value =  "?" then v-mi-tmp:screen-value = "0" .
     3007     find first tmp_sr-izmerenia no-lock where tmp_sr-izmerenia.node-code = integer(v-mi-tmp:screen-value) no-error .
     3008     if not available tmp_sr-izmerenia
     3009     then do :
     3010       if v-mi-tmp:screen-value <> "?"
     3011       and v-mi-tmp:screen-value <> "0"
     3012       then do :
     3013         message ("Не найдено средтсво измерения с кодом " + v-mi-tmp:screen-value) view-as alert-box .
     3014         v-mi-tmp:screen-value = v-old-val .
     3015       end .
     3016       return .
     3017     end .
     3018     else do :
     3019       if tmp_sr-izmerenia.sr-type-izm = 2
     3020       then do :
     3021         message "Средство измерения является Измерительной Системой!" view-as alert-box .
     3022         v-mi-tmp:screen-value = v-old-val .
     3023         return .
     3024       end .
     3025       if not tmp_sr-izmerenia.sr-temperature
     3026       then do :
     3027         message "Средство измерения НЕ измеряет температуру!" view-as alert-box .
     3028         v-mi-tmp:screen-value = v-old-val .
     3029         return .
     3030       end .
     3031       if tmp_sr-izmerenia.sr-type-izm = 0
     3032       and tmp_sr-izmerenia.sr-temperature
     3033       and tmp_sr-izmerenia.sr-density
     3034       and rvd-tmp:screen-value <> rvd-dnstv:screen-value
     3035       then do :
     3036         message "Бизнес-процессом не предусмотрено использование неравнозначных положений разрешения РВД по параметрам температура и плотность, " +
     3037                 "если автоматизированное СИ для одного из них предназначено для измерения обоих. " +
     3038                 "Сохранение неравнозначных положений разрешения РВД по параметрам температура и плотность запрещено. " +
     3039                 "Установить значение " + (if rvd-tmp:screen-value = "yes" then "'Да'" else "'Нет'") + " для РВД по плотности автоматически?"
     3040         view-as alert-box question buttons yes-no update vlog .
     3041         if vlog
     3042         then do :
     3043           rvd-dnstv:screen-value = rvd-tmp:screen-value .
     3044         end .
     3045       end .
     3046     end .
     3047     v-mi-tmp-name = tmp_sr-izmerenia.sr-model .
     3048     display v-mi-tmp-name with frame d-pl-form.
     3049     enable v-mi-tmp-name with frame d-pl-form.
     3050     assign v-mi-tmp .
     3051     if tmp_sr-izmerenia.sr-density
     3052     then do :
     3053         v-mi-dnst = v-mi-tmp .
     3054         v-mi-dnst:screen-value = v-mi-tmp:screen-value .
     3055         v-mi-dnst-name = v-mi-tmp-name .
     3056         find first dnst_sr-izmerenia no-lock where dnst_sr-izmerenia.node-code = v-mi-dnst .
     3057         display v-mi-dnst-name with frame d-pl-form.
     3058         enable v-mi-dnst-name with frame d-pl-form.
     3059     end .
     3060   end .
     3061   ON CHOOSE OF b-com-tanks IN FRAME d-pl-form
     3062   DO:
     3063     define variable place-list as character no-undo .
     3064     define buffer cv_place for ub.place .
     3065     define buffer cv_place-attr for ub.place-attr .
     3066     define buffer buf_pl-gds for ub.pl-gds .
     3067     define buffer cv_pl-gds for ub.pl-gds .
     3068     find first buf_pl-gds no-lock where buf_pl-gds.obj-type = tt-place.obj-type
     3069                                     and buf_pl-gds.obj-code = tt-place.obj-code
     3070                                     and buf_pl-gds.pl-code = tt-place.pl-code
     3071                                     no-error .
     3072     if not available buf_pl-gds
     3073     then do :
     3074       return no-apply .
     3075     end .
     3076     run ref/pl-list.w (
     3077                    input parparentproc
     3078                   ,input "b-sel,b-mark"
     3079                   ,input p-obj-type
     3080                   ,input p-obj-code
     3081                   ,input 'объект':U
     3082                  , input-output place-list).
     3083     if place-list = "cancel"
     3084     then do :
     3085       place-list = '' .
     3086     end .
     3087     if place-list <> '':U then do:
     3088       com-tanks = "" .
     3089       do ii = 1 to num-entries(place-list) :
     3090         find first cv_place no-lock where recid(cv_place) = integer(entry(ii, place-list)) .
     3091         if cv_place.obj-type = tt-place.obj-type
     3092         and cv_place.obj-code = tt-place.obj-code
     3093         and cv_place.pl-code = tt-place.pl-code
     3094         then do :
     3095           message "Нельзя связать резервуар с самим собой!" view-as alert-box .
     3096           next .
     3097         end .
     3098         find first cv_pl-gds no-lock where cv_pl-gds.obj-type = cv_place.obj-type
     3099                                        and cv_pl-gds.obj-code = cv_place.obj-code
     3100                                        and cv_pl-gds.pl-code = cv_place.pl-code
     3101                                        no-error .
     3102         if not available cv_pl-gds
     3103         then do :
     3104           message "Нельзя связать резервуар с резервуаром, на котором нет товара!" view-as alert-box .
     3105           next .
     3106         end .
     3107         if cv_pl-gds.gds-code <> buf_pl-gds.gds-code
     3108         then do :
     3109           message substitute("В сообщающихся резервуарах должен быть указан один товар! Связь с резервуаром №&1 не установлена!", cv_place.loc1) view-as alert-box .
     3110           next .
     3111         end .
     3112         if cv_pl-gds.fact-qnty <> 0
     3113         or cv_pl-gds.free-qnty <> 0
     3114         or cv_pl-gds.cli-free-qnty <> 0
     3115         or cv_pl-gds.cli-fact-qnty <> 0
     3116         then do :
     3117           message substitute("На резервуаре №&1 имеются расчетно-книжные остатки! Связь сообщающихся резервуаров не установлена!", cv_place.loc1) view-as alert-box .
     3118           next .
     3119         end .
     3120         find first cv_place-attr no-lock where cv_place-attr.obj-type = cv_place.obj-type
     3121                                            and cv_place-attr.obj-code = cv_place.obj-code
     3122                                            and cv_place-attr.pl-code  = cv_place.pl-code
     3123                                            and cv_place-attr.attr-code = "place-com-tanks"
     3124                                            no-error .
     3125         if available cv_place-attr
     3126         and cv_place-attr.attr-value > ""
     3127         then do :
     3128           message substitute("Резервуар №&1 уже привязан к резервуару №&2. Связь сообщающихся резервуаров не установлена!", cv_place.loc1, cv_place-attr.attr-value) view-as alert-box .
     3129           next .
     3130         end .
     3131         find first cv_place-attr no-lock where cv_place-attr.obj-type = cv_place.obj-type
     3132                                            and cv_place-attr.obj-code = cv_place.obj-code
     3133                                            and cv_place-attr.pl-code  = cv_place.pl-code
     3134                                            and cv_place-attr.attr-code = "place-gate-valve"
     3135                                            no-error .
     3136         if available cv_place-attr
     3137         and logical(cv_place-attr.attr-value)
     3138         then do :
     3139           message substitute("Резервуар №&1 имеет задвижку. Связь сообщающихся резервуаров не установлена!", cv_place.loc1) view-as alert-box .
     3140           next .
     3141         end .
     3142         if can-find(first pl-pump-nozzle no-lock where pl-pump-nozzle.obj-type = cv_pl-gds.obj-type
     3143                                                    and pl-pump-nozzle.obj-code = cv_pl-gds.obj-code
     3144                                                    and pl-pump-nozzle.pl-code  = cv_pl-gds.pl-code )
     3145         then do :
     3146           message "В сообщающихся резервуарах должна быть одна связка Резервуар – ТРК – Пистолеты по объекту! Связь сообщающихся резервуаров не установлена!" view-as alert-box .
     3147           next .
     3148         end .
     3149         com-tanks = com-tanks + cv_place.loc1 + "," .
     3150       end .
     3151       com-tanks = trim(com-tanks, ",") .
     3152       display com-tanks with frame d-pl-form .
     3153       if com-tanks > ""
     3154       then do :
     3155         is-main = yes .
     3156         v-is-main = "Главный" .
     3157         display v-is-main with frame d-pl-form .
     3158         if v-not-gas-place
     3159         then do :
     3160           enable t-auto-gate-valve with frame d-pl-form .
     3161         end .
     3162       end .
     3163     end.
     3164     v-com-vessel-changed = yes .
     3165   END.
     3166   ON CHOOSE OF b-gate-valve-tanks IN FRAME d-pl-form
     3167   DO:
     3168     define variable place-list as character no-undo .
     3169     define buffer gv_place for ub.place .
     3170     define buffer gv_place-attr for ub.place-attr .
     3171     define buffer buf_pl-gds for ub.pl-gds .
     3172     define buffer gv_pl-gds for ub.pl-gds .
     3173     find first buf_pl-gds no-lock where buf_pl-gds.obj-type = tt-place.obj-type
     3174                                     and buf_pl-gds.obj-code = tt-place.obj-code
     3175                                     and buf_pl-gds.pl-code = tt-place.pl-code
     3176                                     no-error .
     3177     if not available buf_pl-gds
     3178     then do :
     3179       return no-apply .
     3180     end .
     3181     run ref/pl-list.w (
     3182                    input parparentproc
     3183                   ,input "b-sel,b-mark"
     3184                   ,input p-obj-type
     3185                   ,input p-obj-code
     3186                   ,input 'объект':U
     3187                  , input-output place-list).
     3188     if place-list = "cancel"
     3189     then do :
     3190       place-list = '' .
     3191     end .
     3192     if place-list <> '':U then do:
     3193       gate-valve-tanks = "" .
     3194       do ii = 1 to num-entries(place-list) :
     3195         find first gv_place no-lock where recid(gv_place) = integer(entry(ii, place-list)) .
     3196         if gv_place.obj-type = tt-place.obj-type
     3197         and gv_place.obj-code = tt-place.obj-code
     3198         and gv_place.pl-code = tt-place.pl-code
     3199         then do :
     3200           message "Нельзя связать резервуар с самим собой!" view-as alert-box .
     3201           next .
     3202         end .
     3203         find first gv_pl-gds no-lock where gv_pl-gds.obj-type = gv_place.obj-type
     3204                                        and gv_pl-gds.obj-code = gv_place.obj-code
     3205                                        and gv_pl-gds.pl-code = gv_place.pl-code
     3206                                        no-error .
     3207         if not available gv_pl-gds
     3208         then do :
     3209           message "Нельзя связать резервуар с резервуаром, на котором нет товара!" view-as alert-box .
     3210           next .
     3211         end .
     3212         if gv_pl-gds.gds-code <> buf_pl-gds.gds-code
     3213         then do :
     3214           message substitute("В резервуарах должен быть указан один товар! Связь с резервуаром №&1 не установлена!", gv_place.loc1) view-as alert-box .
     3215           next .
     3216         end .
     3217         find first gv_place-attr no-lock where gv_place-attr.obj-type = gv_place.obj-type
     3218                                            and gv_place-attr.obj-code = gv_place.obj-code
     3219                                            and gv_place-attr.pl-code  = gv_place.pl-code
     3220                                            and gv_place-attr.attr-code = "place-gate-valve-tanks"
     3221                                            no-error .
     3222         if available gv_place-attr
     3223         and gv_place-attr.attr-value > ""
     3224         then do :
     3225           message substitute("Резервуар №&1 уже привязан к резервуару №&2. Связь задвижкой не установлена!", gv_place.loc1, gv_place-attr.attr-value) view-as alert-box .
     3226           next .
     3227         end .
     3228         find first gv_place-attr no-lock where gv_place-attr.obj-type = gv_place.obj-type
     3229                                            and gv_place-attr.obj-code = gv_place.obj-code
     3230                                            and gv_place-attr.pl-code  = gv_place.pl-code
     3231                                            and gv_place-attr.attr-code = "place-com-tanks"
     3232                                            no-error .
     3233         if available gv_place-attr
     3234         and gv_place-attr.attr-value > ""
     3235         then do :
     3236           message substitute("Резервуар №&1 сообщающийся с резервуаром №&2. Связь задвижкой не установлена!", gv_place.loc1, gv_place-attr.attr-value) view-as alert-box .
     3237           next .
     3238         end .
     3239         gate-valve-tanks = gate-valve-tanks + gv_place.loc1 + "," .
     3240       end .
     3241       gate-valve-tanks = trim(gate-valve-tanks, ",") .
     3242       display gate-valve-tanks with frame d-pl-form .
     3243     end.
     3244     v-gate-valve-tanks-changed = yes .
     3245   END.
     3246   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-pl-form:PARENT eq ?
     3247     THEN FRAME d-pl-form:PARENT = ACTIVE-WINDOW.
     3248   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3249   on help of frame d-pl-form
     3250   do:
     3251     run gbl/app_help.p
     3252       (input this-procedure :file-name
     3253       ,input ''
     3254       ,input ?
     3255       ) no-error.
     3256     if error-status :error then do:
     3257       message
     3258         "Ошибка при вызове помощи"
     3259         error-status :get-message(1)
     3260         view-as alert-box .
     3261     end.
     3262   end.
     3263   run minbtn-set in this-procedure .
     3264   on choose of b-help in frame d-pl-form
     3265   do:
     3266     apply "help":u to frame d-pl-form .
     3267   end.
     3268   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3269   procedure minbtn-set :
     3270       do
     3271           on error undo, return error return-value
     3272           :
     3273           define variable ii              as integer       no-undo .
     3274           define variable fh              as widget-handle no-undo .
     3275           define variable hh              as widget-handle no-undo .
     3276           define variable v-h             as handle        extent 4 no-undo .
     3277           define variable v-name-button   as character     no-undo .
     3278           define variable v-help-old-x    as decimal       no-undo .
     3279           define variable v-help-old-y    as decimal       no-undo .
     3280           define variable v-help-old-size as decimal       no-undo .
     3281           define variable v-frame-width   as decimal       no-undo .
     3282           define variable jj              as integer       no-undo .
     3283           do
     3284               on error undo, return error
     3285               :
     3286               assign
     3287                   v-frame-width = frame d-pl-form:width - 0.3
     3288                   fh            = frame d-pl-form:first-child
     3289                   hh            = fh:first-child
     3290                   ii            = 1
     3291                   .
     3292               do while valid-handle(hh):
     3293                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3294                   do:
     3295                       case lc(hh:name) :
     3296                           when "b-help" then
     3297                               do:
     3298                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3299                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3300                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3301                                   hh:TOOLTIP = "Помощь" .
     3302                                   v-help-old-x = hh:column .
     3303                                   v-help-old-y = hh:row    .
     3304                                   v-help-old-size = hh:width .
     3305                                   hh:width-chars = 2.5 .
     3306                               end.
     3307                           when "b-print" then
     3308                               do:
     3309                                   hh:load-image("cmp/b-print.bmp":u) .
     3310                                   hh:TOOLTIP = "Печать" .
     3311                                   v-h[ii] = hh:handle .
     3312                                   ii = ii + 1 .
     3313                                   hh:width-chars = 3 .
     3314                               end.
     3315                           when "b-history" or
     3316                           when "b-hist" then
     3317                               do:
     3318                                   hh:load-image("cmp/b-hist.bmp":u) .
     3319                                   hh:TOOLTIP = "История" .
     3320                                   v-h[ii] = hh:handle .
     3321                                   ii = ii + 1 .
     3322                                   hh:width-chars = 3 .
     3323                               end.
     3324                           when "b-sch" then
     3325                               do:
     3326                                   hh:load-image("cmp/b-sch.bmp":u) .
     3327                                   hh:TOOLTIP = "Установка Фильтра" .
     3328                                   v-h[ii] = hh:handle .
     3329                                   ii = ii + 1 .
     3330                                   hh:width-chars = 3 .
     3331                               end.
     3332                           when "b-hist-user" then
     3333                               do:
     3334                                   hh:load-image("cmp/b-hist.bmp":u) .
     3335                                   hh:TOOLTIP = "История пользователя" .
     3336                                   ii = ii + 1 .
     3337                               end.
     3338                       end case.
     3339                   end.
     3340                   hh = hh:next-sibling.
     3341               end.
     3342               b-help:column = v-frame-width - b-help:width-chars.
     3343               jj = 0.
     3344               repeat ii = 4 to 1 by -1 :
     3345                   if valid-handle (v-h[ii] ) then
     3346                   do:
     3347                       jj  = jj + 1 .
     3348                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3349                       v-h[ii]:row    = v-help-old-y .
     3350                   end.
     3351               end.
     3352           end.
     3353       end.
     3354   end procedure.
     3355   ON WINDOW-CLOSE OF FRAME d-pl-form do :
     3356     define variable vlog as logical no-undo .
     3357     message "Все введенные данные будут утеряны. Вы уверены, что хотите отказаться от внесенных изменений?"
     3358     view-as alert-box question buttons yes-no update vlog .
     3359     if not vlog then return no-apply .
     3360     p-rep-rec = ?.
     3361     APPLY "END-ERROR":U TO SELF.
     3362   end .
     3363   on "F2" ANYWHERE do:
     3364     define variable vlog as logical no-undo .
     3365     message "Все введенные данные будут утеряны. Вы уверены, что хотите отказаться от внесенных изменений?"
     3366     view-as alert-box question buttons yes-no update vlog .
     3367     if not vlog then return no-apply .
     3368     p-rep-rec = ?.
     3369   end .
     3370   on "ESC" ANYWHERE do:
     3371     define variable vlog as logical no-undo .
     3372     message "Все введенные данные будут утеряны. Вы уверены, что хотите отказаться от внесенных изменений?"
     3373     view-as alert-box question buttons yes-no update vlog .
     3374     if not vlog then return no-apply .
     3375     p-rep-rec = ?.
     3376   end .
     3377   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3378   ON TAB ANYWHERE
     3379   DO:
     3380   define variable ii as integer no-undo .
     3381   define variable fh as widget-handle no-undo .
     3382   define variable hh as widget-handle no-undo .
     3383   define variable v-next-widget-name as character no-undo .
     3384   if v-tab-order <> '' then do:
     3385     if self:type = "TOGGLE-BOX" then
     3386     self:BGCOLOR = ?.
     3387     assign
     3388     ii = lookup(self:name, v-tab-order).
     3389     assign
     3390     ii = ii + 1
     3391     v-next-widget-name = entry(ii, v-tab-order)
     3392     no-error .
     3393     if error-status:error then do:
     3394       assign
     3395       ii = 1
     3396       v-next-widget-name = entry( ii, v-tab-order)
     3397       .
     3398     end.
     3399     assign
     3400     fh = frame d-pl-form:first-child
     3401     hh = fh:first-child
     3402     .
     3403     do while valid-handle(hh):
     3404       if hh:name = v-next-widget-name then do:
     3405         if hh:sensitive  = yes
     3406         AND hh:visible = yes then do:
     3407           if hh:type = "TOGGLE-BOX":U then do:
     3408             assign
     3409             hh:BGcolor = 1
     3410             .
     3411           end.
     3412           APPLY "ENTRY" to hh.
     3413           return no-apply.
     3414         end.
     3415         else do:
     3416           APPLY "TAB" to hh.
     3417           return no-apply.
     3418         end.
     3419       end.
     3420       hh = hh:next-sibling.
     3421     end.
     3422   end.
     3423   END.
     3424   ON BACK-TAB ANYWHERE
     3425   DO:
     3426   define variable ii as integer no-undo .
     3427   define variable fh as widget-handle no-undo .
     3428   define variable hh as widget-handle no-undo .
     3429   define variable v-next-widget-name as character no-undo .
     3430   if v-tab-order <> '' then do:
     3431     assign
     3432     ii = lookup(self:name, v-tab-order).
     3433     .
     3434     assign
     3435     ii = (if ii = 1
     3436           then  num-entries(v-tab-order)
     3437           else ii - 1
     3438           )
     3439     v-next-widget-name = entry(ii, v-tab-order)
     3440     .
     3441     assign
     3442     fh = frame d-pl-form:first-child
     3443     hh = fh:first-child
     3444     .
     3445     do while valid-handle(hh):
     3446       if hh:name = v-next-widget-name then do:
     3447         if hh:sensitive  = yes
     3448         AND hh:visible = yes then do:
     3449           if hh:type = "TOGGLE-BOX":U then do:
     3450             assign
     3451             hh:BGcolor = 1
     3452             .
     3453           end.
     3454           APPLY "ENTRY" to hh.
     3455           return no-apply.
     3456         end.
     3457         else do:
     3458         APPLY "BACK-TAB" to hh.
     3459         return no-apply.
     3460         end.
     3461       end.
     3462       hh = hh:next-sibling.
     3463     end.
     3464     end.
     3465   END.
     3466   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3467   ON RETURN ANYWHERE
     3468   DO:
     3469   define variable ii as integer no-undo .
     3470   define variable fh as widget-handle no-undo .
     3471   define variable hh as widget-handle no-undo .
     3472   define variable v-next-widget-name as character no-undo .
     3473     if v-tab-order <> '' then do:
     3474       assign
     3475       ii = lookup(self:name, v-tab-order).
     3476       if ii = num-entries(v-tab-order) then do:
     3477           APPLY 'CHOOSE' TO b-exit in frame d-pl-form.
     3478           return no-apply.
     3479       end.
     3480       if self:type <> "BUTTON" and
     3481         self:type <> "EDITOR"  then do:
     3482         run proc-move-forward in this-procedure .
     3483         return no-apply.
     3484       end.
     3485       if self:type = "BUTTON" then do:
     3486         APPLY "CHOOSE" to self.
     3487       end.
     3488       if self:type = "TOGGLE-BOX" then
     3489       self:BGCOLOR = ?.
     3490       assign
     3491       ii = ii + 1
     3492       v-next-widget-name = entry(ii, v-tab-order)
     3493       no-error .
     3494       if error-status:error then do:
     3495         assign
     3496         ii = 1
     3497         v-next-widget-name = entry( ii, v-tab-order)
     3498         .
     3499       end.
     3500       assign
     3501       fh = frame d-pl-form:first-child
     3502       hh = fh:first-child
     3503       .
     3504       do while valid-handle(hh):
     3505         if hh:name = v-next-widget-name then do:
     3506           if hh:sensitive  = yes
     3507           AND hh:visible = yes then do:
     3508             if hh:type = "TOGGLE-BOX":U then do:
     3509               assign
     3510               hh:BGcolor = 1
     3511               .
     3512             end.
     3513             APPLY "ENTRY" to hh.
     3514             return no-apply.
     3515           end.
     3516           else do:
     3517             APPLY "TAB" to hh.
     3518             return no-apply.
     3519           end.
     3520         end.
     3521         hh = hh:next-sibling.
     3522       end.
     3523     end.
     3524   END.
     3525   procedure proc-move-forward :
     3526   define variable ii as integer no-undo .
     3527   define variable fh as widget-handle no-undo .
     3528   define variable hh as widget-handle no-undo .
     3529   define variable v-next-widget-name as character no-undo .
     3530   do
     3531   on error undo, return error
     3532   :
     3533     if v-tab-order <> '' then do:
     3534       if self:type = "TOGGLE-BOX" then
     3535       self:BGCOLOR = ?.
     3536       assign
     3537       ii = lookup(self:name, v-tab-order).
     3538       assign
     3539       ii = ii + 1
     3540       v-next-widget-name = entry(ii, v-tab-order)
     3541       no-error .
     3542       if error-status:error then do:
     3543         assign
     3544         ii = 1
     3545         v-next-widget-name = entry( ii, v-tab-order)
     3546         .
     3547       end.
     3548       assign
     3549       fh = frame d-pl-form:first-child
     3550       hh = fh:first-child
     3551       .
     3552       do while valid-handle(hh):
     3553         if hh:name = v-next-widget-name then do:
     3554           if hh:sensitive  = yes
     3555           AND hh:visible = yes then do:
     3556             if hh:type = "TOGGLE-BOX":U then do:
     3557               assign
     3558               hh:BGcolor = 1
     3559               .
     3560             end.
     3561             APPLY "ENTRY" to hh.
     3562             return.
     3563           end.
     3564           else do:
     3565             assign
     3566             ii = ii + 1
     3567             v-next-widget-name = entry(ii, v-tab-order)
     3568             no-error .
     3569             if error-status:error then do:
     3570               assign
     3571               ii = 1
     3572               v-next-widget-name = entry( ii, v-tab-order)
     3573               .
     3574             end.
     3575           end.
     3576         end.
     3577         hh = hh:next-sibling.
     3578       end.
     3579     end.
     3580   end.
     3581   end procedure.
     3582   MAIN-BLOCK:
     3583   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3584     ON STOP    UNDO MAIN-BLOCK,  LEAVE MAIN-BLOCK
     3585     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3586     if p-mode <> 'ИЗМЕНЕНИЕ':U
     3587       and p-mode <> 'ДОБАВЛЕНИЕ':U
     3588       and p-mode <> 'ПРОСМОТР':U then
     3589     do:
     3590       message
     3591         vss-workfile vss-revision vss-description skip
     3592         "Неверный параметр вызова p-mode" p-mode
     3593         view-as alert-box ERROR.
     3594       return error.
     3595     end.
     3596     case p-mode:
     3597       when 'ИЗМЕНЕНИЕ':U then do:
     3598         find first locked_place exclusive-lock
     3599           where recid (locked_place) = p-rep-rec
     3600           no-error .
     3601       end.
     3602       when 'ПРОСМОТР':U then do:
     3603         find first locked_place no-lock
     3604           where recid( locked_place ) = p-rep-rec
     3605           no-error .
     3606         if not available locked_place then do:
     3607           find first locked_place no-lock
     3608             where locked_place.obj-type = p-obj-type
     3609               and locked_place.obj-code = p-obj-code
     3610               and locked_place.pl-code  = p-pl-code
     3611             no-error .
     3612         end.
     3613       end.
     3614     end case.
     3615     if not available locked_place
     3616       and  p-mode <> 'ДОБАВЛЕНИЕ':U
     3617       then
     3618     do:
     3619       message
     3620         vss-workfile vss-revision vss-description skip
     3621         substitute ("Не найдена запись СКЛАДСКОГО МЕСТА &1 &2&3", p-pl-code, p-obj-type, p-obj-code ) skip
     3622         view-as alert-box error .
     3623       undo, return error.
     3624     end.
     3625     for each tt-place:
     3626       delete tt-place.
     3627     end.
     3628     create tt-place.
     3629     if p-mode = 'ДОБАВЛЕНИЕ':U then
     3630     do:
     3631       assign
     3632         tt-place.obj-type = p-obj-type
     3633         tt-place.obj-code = p-obj-code
     3634         .
     3635     end.
     3636     else
     3637     do:
     3638       buffer-copy locked_place to tt-place.
     3639     end.
     3640     v-rvd-is-meas-on = tt-place.is-meas .
     3641     if p-mode <> 'ПРОСМОТР':U then
     3642     do :
     3643       if ( tt-place.max-qnty = 0
     3644         or tt-place.max-qnty = ?
     3645         )
     3646         then
     3647       do:
     3648         assign
     3649           tt-place.chk-max-qnty = false
     3650           .
     3651       end.
     3652     end.
     3653     ii = 0.
     3654     do ii = 1 to num-entries('place-type,place-SI,place-diameter,dead-balance,water-level,dens-prov,place-virtual,place-twice-code,place-sert-urov,place-local,place-error-mass,place-asi-sertif,place-rvd-dnsty,place-rvd-lvl,place-rvd-tmp,place-SI-dens,place-SI-level,place-SI-temp,place-passp-num,place-passp-type,place-dead-high,place-temp-coef,disable-water-alarm,disable-level-alarm,place-ponton,place-ponton-mass,place-ponton-height,place-com-vessel,place-com-tanks,place-is-main,place-gate-valve,place-gate-valve-tanks,place-auto-gate-valve':u,','):
     3655       v-code = entry(ii,'place-type,place-SI,place-diameter,dead-balance,water-level,dens-prov,place-virtual,place-twice-code,place-sert-urov,place-local,place-error-mass,place-asi-sertif,place-rvd-dnsty,place-rvd-lvl,place-rvd-tmp,place-SI-dens,place-SI-level,place-SI-temp,place-passp-num,place-passp-type,place-dead-high,place-temp-coef,disable-water-alarm,disable-level-alarm,place-ponton,place-ponton-mass,place-ponton-height,place-com-vessel,place-com-tanks,place-is-main,place-gate-valve,place-gate-valve-tanks,place-auto-gate-valve':u) .
     3656       run placelib_get-attr  ( input v-code
     3657         ,input p-obj-code
     3658         ,input p-obj-type
     3659         ,input locked_place.pl-code
     3660         ,output v-value
     3661         ,output v-ok      ) no-error.
     3662       case v-code :
     3663         when "place-type" then do :
     3664           if v-ok then place-type = integer(v-value) .
     3665         end.
     3666         when "place-SI" then do :
     3667           if v-ok
     3668           then do :
     3669             place-si = integer(v-value) .
     3670             v-main-mi-old = place-si .
     3671             if v-main-mi-old = ? then v-main-mi-old = 0 .
     3672           end .
     3673         end.
     3674         when "place-diameter" then do :
     3675           if v-ok then place-diameter = decimal(v-value) .
     3676         end.
     3677         when "dead-balance" then do :
     3678           if v-ok then dead-balance = decimal(v-value) .
     3679         end.
     3680         when "water-level" then do :
     3681           if v-ok then water-level = integer(v-value) .
     3682         end.
     3683         when "dens-prov" then do :
     3684           if v-ok then dens-prov = decimal(v-value) .
     3685         end.
     3686         when "place-virtual" then do :
     3687           if v-ok then t-place-virtual = logical(v-value) .
     3688         end.
     3689         when "place-twice-code" then do:
     3690           if v-ok then place-twice-code = v-value .
     3691         end.
     3692         when "place-local" then do :
     3693           if v-ok then place-locat = integer(v-value) .
     3694         end.
     3695         when "place-error-mass" then do :
     3696           if v-value = "" then
     3697           do:
     3698             v-value = "0.15" .
     3699             run placelib_write-attr  (input v-code
     3700               ,input p-obj-code
     3701               ,input p-obj-type
     3702               ,input locked_place.pl-code
     3703               ,input v-value
     3704               ,output v-ok      ) no-error.
     3705           end.
     3706           if v-ok then error-mass = decimal(v-value) .
     3707         end.
     3708         when "place-asi-sertif" then do :
     3709           if v-value = "" then v-value = "no" .
     3710           if v-ok then t-asi-srtif = logical(v-value) .
     3711         end.
     3712         when "place-rvd-dnsty" then do :
     3713           if v-ok
     3714           then do :
     3715             rvd-dnstv = logical(v-value) .
     3716             v-rvd-dnsty-on = rvd-dnstv .
     3717           end .
     3718         end.
     3719         when "place-rvd-lvl" then do :
     3720           if v-ok
     3721           then do :
     3722             rvd-lvl = logical(v-value) .
     3723             v-rvd-lvl-on = rvd-lvl .
     3724           end.
     3725         end.
     3726         when "place-rvd-tmp" then do :
     3727           if v-ok
     3728           then do :
     3729             rvd-tmp = logical(v-value) .
     3730             v-rvd-temp-on = rvd-tmp .
     3731           end .
     3732         end.
     3733         when "place-SI-dens" then do :
     3734           if v-ok
     3735           then do :
     3736             v-mi-dnst = integer(v-value) .
     3737             v-dnst-mi-old = v-mi-dnst .
     3738             if v-dnst-mi-old = ? then v-dnst-mi-old = 0 .
     3739             find first dnst_sr-izmerenia no-lock where dnst_sr-izmerenia.node-code = v-mi-dnst no-error .
     3740           end .
     3741         end.
     3742         when "place-SI-level" then do :
     3743           if v-ok
     3744           then do :
     3745             v-mi-lvl = integer(v-value) .
     3746             v-lvl-mi-old = v-mi-lvl .
     3747             if v-lvl-mi-old = ? then v-lvl-mi-old = 0 .
     3748             find first lvl_sr-izmerenia no-lock where lvl_sr-izmerenia.node-code = v-mi-lvl no-error .
     3749           end .
     3750         end.
     3751         when "place-SI-temp" then do :
     3752           if v-ok
     3753           then do :
     3754             v-mi-tmp = integer(v-value) .
     3755             v-tmp-mi-old = v-mi-tmp .
     3756             if v-tmp-mi-old = ? then v-tmp-mi-old = 0 .
     3757             find first tmp_sr-izmerenia no-lock where tmp_sr-izmerenia.node-code = v-mi-tmp no-error .
     3758           end .
     3759         end.
     3760         when "place-passp-num" then do:
     3761           if v-ok then place-passp-num = v-value .
     3762         end.
     3763         when "place-passp-type" then do:
     3764           if v-ok then place-passp-type = v-value .
     3765         end.
     3766         when "place-dead-high" then do:
     3767           if v-ok then place-dead-high = decimal(v-value) .
     3768         end.
     3769         when "place-temp-coef" then do:
     3770           if v-ok then place-temp-coef = decimal(v-value) .
     3771         end.
     3772         when "place-ponton" then do :
     3773           if v-ok then t-ponton = logical(v-value) .
     3774         end.
     3775         when "place-ponton-mass" then do:
     3776           if v-ok then ponton-mass = decimal(v-value) no-error .
     3777         end.
     3778         when "place-ponton-height" then do:
     3779           if v-ok then ponton-height = decimal(v-value) no-error .
     3780         end.
     3781         when "place-com-vessel" then do :
     3782           if v-ok then t-com-vessel = logical(v-value) .
     3783         end.
     3784         when "place-com-tanks" then do:
     3785           if v-ok then com-tanks = v-value no-error .
     3786         end.
     3787         when "place-is-main" then do:
     3788           if v-ok then is-main = logical(v-value) no-error .
     3789         end.
     3790         when "place-gate-valve" then do :
     3791           if v-ok then t-gate-valve = logical(v-value) .
     3792         end.
     3793         when "place-gate-valve-tanks" then do:
     3794           if v-ok then gate-valve-tanks = v-value no-error .
     3795         end.
     3796         when "place-auto-gate-valve" then do :
     3797           if v-ok
     3798           then do :
     3799             t-auto-gate-valve = logical(v-value) .
     3800             v-old-auto-gate-valve = t-auto-gate-valve .
     3801           end .
     3802         end.
     3803       end case.
     3804     end.
     3805     run Myenable in this-procedure .
     3806     wait-for go of frame d-pl-form.
     3807   end.
     3808   run disable_UI in this-procedure .
     3809   PROCEDURE disable_UI :
     3810     HIDE FRAME d-pl-form.
     3811   END PROCEDURE.
     3812   PROCEDURE enable_UI :
     3813     DISPLAY t-place-virtual t-asi-srtif rvd-dnstv rvd-lvl rvd-tmp place-type
     3814             place-locat error-mass place-si dead-balance water-level place-diameter
     3815             dens-prov place-twice-code v-mi-dnst
     3816             v-mi-lvl v-mi-tmp place-passp-num place-passp-type
     3817             place-dead-high place-temp-coef
     3818             t-ponton ponton-mass ponton-height
     3819         WITH FRAME d-pl-form.
     3820     IF AVAILABLE tt-place THEN
     3821       DISPLAY tt-place.loc1 tt-place.loc2 tt-place.loc3 tt-place.loc4
     3822             tt-place.pl-name tt-place.is-meas tt-place.pl-code tt-place.issue-year
     3823             tt-place.start-date tt-place.add-qnty tt-place.max-qnty tt-place.PS tt-place.chk-max-qnty
     3824         WITH FRAME d-pl-form.
     3825     ENABLE b-exit b-quit B-hist b-help tt-place.loc1 tt-place.loc2 tt-place.loc3
     3826            tt-place.loc4 tt-place.pl-name t-place-virtual tt-place.is-meas
     3827            rvd-dnstv rvd-lvl rvd-tmp tt-place.issue-year place-type
     3828            tt-place.start-date place-locat tt-place.add-qnty error-mass
     3829            tt-place.max-qnty place-si r-sr-izm dead-balance water-level place-diameter
     3830            dens-prov place-twice-code tt-place.chk-max-qnty
     3831            tt-place.PS place-passp-num place-passp-type place-dead-high place-temp-coef
     3832            t-ponton ponton-mass ponton-height
     3833         WITH FRAME d-pl-form.
     3834   END PROCEDURE.
     3835   PROCEDURE Myenable :
     3836     run enable_UI in this-procedure .
     3837     assign
     3838       v-tab-order = "loc1,loc2,loc3,loc4,pl-name,is-meas,"
     3839                     + "issue-year,start-date,add-qnty,max-qnty,"
     3840                     + "ps,place-type,place-SI,r-sr-izm,v-mi-dnst,b-mi-dnst,v-mi-lvl,b-mi-lvl,v-mi-tmp,b-mi-tmp,"
     3841                     + "place-diameter,dead-balance,place-dead-high,place-temp-coef,dens-prov,t-place-virtual,place-twice-code,t-sert-urov,place-passp-num,place-passp-type".
     3842     if p-mode = 'ПРОСМОТР':U then do:
     3843       disable
     3844         all
     3845         with frame d-pl-form .
     3846       hide
     3847         b-exit
     3848         in frame d-pl-form .
     3849       assign
     3850         b-quit:label  = "&Выход"
     3851         b-quit:column = 1
     3852         .
     3853     end.
     3854     if p-mode = 'ДОБАВЛЕНИЕ':U then
     3855     do:
     3856       hide
     3857         tt-place.pl-code
     3858         in frame d-pl-form .
     3859     end.
     3860     assign
     3861       frame d-pl-form:title = substitute("Складское место &1 на объекте : &2&3 &4", tt-place.pl-code, p-obj-type, p-obj-code, p-mode)
     3862       .
     3863     if tt-place.is-meas then do:
     3864       enable t-asi-srtif with frame d-pl-form .
     3865     end.
     3866     enable v-mi-dnst b-mi-dnst with frame d-pl-form .
     3867     enable v-mi-lvl b-mi-lvl with frame d-pl-form .
     3868     enable v-mi-tmp b-mi-tmp with frame d-pl-form .
     3869     for first dop_sr-izmerenia no-lock where dop_sr-izmerenia.node-code = v-mi-lvl :
     3870       v-mi-lvl-name = dop_sr-izmerenia.sr-model .
     3871       display v-mi-lvl-name with frame d-pl-form.
     3872     end .
     3873     if p-mode <> 'ПРОСМОТР':U then enable v-mi-lvl-name with frame d-pl-form.
     3874     if v-mi-lvl = 0 then v-mi-lvl = ? .
     3875     for first dop_sr-izmerenia no-lock where dop_sr-izmerenia.node-code = v-mi-dnst :
     3876       v-mi-dnst-name = dop_sr-izmerenia.sr-model .
     3877       display v-mi-dnst-name with frame d-pl-form.
     3878     end .
     3879     if p-mode <> 'ПРОСМОТР':U then enable v-mi-dnst-name with frame d-pl-form.
     3880     if v-mi-dnst = 0 then v-mi-dnst = ? .
     3881     for first dop_sr-izmerenia no-lock where dop_sr-izmerenia.node-code = v-mi-tmp :
     3882       v-mi-tmp-name = dop_sr-izmerenia.sr-model .
     3883       display v-mi-tmp-name with frame d-pl-form.
     3884     end .
     3885     if p-mode <> 'ПРОСМОТР':U then enable v-mi-tmp-name with frame d-pl-form.
     3886     if v-mi-tmp = 0 then v-mi-tmp = ? .
     3887     for first sr-izmerenia no-lock where sr-izmerenia.node-code = place-si :
     3888       place-si-name = sr-izmerenia.sr-model .
     3889       display place-si-name with frame d-pl-form.
     3890     end .
     3891     if p-mode <> 'ПРОСМОТР':U then enable place-si-name with frame d-pl-form.
     3892     if place-si = 0 then place-si = ? .
     3893     apply "value-changed" to place-type .
     3894     hide t-com-vessel com-tanks b-com-tanks v-is-main gate-valve-tanks t-gate-valve b-gate-valve-tanks t-auto-gate-valve in frame d-pl-form .
     3895     if p-mode = 'ИЗМЕНЕНИЕ':U
     3896     then do :
     3897       disable
     3898         place-locat
     3899         tt-place.max-qnty
     3900         dead-balance
     3901         place-si
     3902         place-si-name
     3903         r-sr-izm
     3904         place-diameter
     3905         place-dead-high
     3906         place-temp-coef
     3907         dens-prov
     3908       with frame d-pl-form .
     3909       if place-type = 1
     3910       then do :
     3911         disable
     3912           t-ponton
     3913           ponton-mass
     3914           ponton-height
     3915         with frame d-pl-form .
     3916       end .
     3917     end .
     3918     run check-sug-NP-par .
     3919   END PROCEDURE.
     3920   PROCEDURE check-sug-NP-par :
     3921     define buffer buf_pl-gds for ub.pl-gds .
     3922     define variable c-value as character no-undo .
     3923     define variable c-type  as character no-undo .
     3924     v-not-gas-place = no .
     3925     v-sug-place = no .
     3926     find first buf_pl-gds no-lock where buf_pl-gds.obj-type = tt-place.obj-type
     3927                                     and buf_pl-gds.obj-code = tt-place.obj-code
     3928                                     and buf_pl-gds.pl-code = tt-place.pl-code
     3929                                     no-error .
     3930     if not available buf_pl-gds
     3931     then do :
     3932       return .
     3933     end .
     3934       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3935       (input  buf_pl-gds.gds-code
     3936       ,input  'fuel-type':U
     3937       ,output c-value
     3938       ,output c-type)
     3939     no-error.
     3940     if c-value = 'lgas':U
     3941     then do :
     3942       v-sug-place = yes .
     3943       display t-com-vessel com-tanks b-com-tanks v-is-main gate-valve-tanks t-gate-valve b-gate-valve-tanks with frame d-pl-form.
     3944       enable t-com-vessel t-gate-valve with frame d-pl-form.
     3945       if t-com-vessel
     3946       then do :
     3947         if is-main then v-is-main = "Главный" . else v-is-main = "Не главный" .
     3948         display v-is-main with frame d-pl-form.
     3949         enable com-tanks b-com-tanks with frame d-pl-form.
     3950         com-tanks:read-only in frame d-pl-form = yes.
     3951         if com-tanks > "" then disable b-com-tanks with frame d-pl-form.
     3952         disable t-gate-valve b-gate-valve-tanks with frame d-pl-form.
     3953       end .
     3954       if t-gate-valve
     3955       then do :
     3956         enable b-gate-valve-tanks with frame d-pl-form.
     3957         disable t-com-vessel b-com-tanks with frame d-pl-form.
     3958       end .
     3959     end .
     3960     else
     3961     if c-value = 'metan':U
     3962     or c-value = 'propan':U
     3963     then do :
     3964     end .
     3965     else do :
     3966       v-not-gas-place = yes .
     3967       display t-com-vessel com-tanks b-com-tanks v-is-main with frame d-pl-form.
     3968       enable t-com-vessel with frame d-pl-form.
     3969       if t-com-vessel
     3970       then do :
     3971         if is-main then v-is-main = "Главный" . else v-is-main = "Не главный" .
     3972         display v-is-main with frame d-pl-form.
     3973         enable com-tanks b-com-tanks with frame d-pl-form.
     3974         com-tanks:read-only in frame d-pl-form = yes.
     3975         if com-tanks > "" then disable b-com-tanks with frame d-pl-form.
     3976         display t-auto-gate-valve with frame d-pl-form.
     3977         if is-main
     3978         then do :
     3979           enable t-auto-gate-valve with frame d-pl-form.
     3980         end .
     3981         else do :
     3982           disable t-auto-gate-valve with frame d-pl-form.
     3983         end .
     3984       end .
     3985     end .
     3986   END PROCEDURE.
