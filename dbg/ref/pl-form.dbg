      858        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      859        LABEL "b-mi-lvl"
      860        SIZE 3 BY .88.
      861   DEFINE BUTTON b-com-tanks
      862        IMAGE-UP FILE "btn-down-arrow":U
      863        IMAGE-DOWN FILE "btn-down-arrow":U
      864        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      865        LABEL "b-mi-dnst"
      866        SIZE 3 BY .88.
      867   DEFINE BUTTON b-gate-valve-tanks
      868        IMAGE-UP FILE "btn-down-arrow":U
      869        IMAGE-DOWN FILE "btn-down-arrow":U
      870        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      871        LABEL "b-mi-dnst"
      872        SIZE 3 BY .88.
      873   DEFINE VARIABLE dead-balance AS DECIMAL FORMAT "->>,>>>,>>9.<<<":U INITIAL 0
      874        LABEL "Мертвый остаток(л)"
      875        VIEW-AS FILL-IN
      876        SIZE 11.63 BY 1 NO-UNDO.
      877   DEFINE VARIABLE water-level AS integer FORMAT ">>>>>9":U INITIAL 0
      878        LABEL "Допустимый уровень воды(мм)"
      879        VIEW-AS FILL-IN
      880        SIZE 11.63 BY 1 NO-UNDO.
      881   DEFINE VARIABLE dens-prov AS DECIMAL FORMAT "9.9999999999" INITIAL 0
      882        LABEL "Плотность при поверке резервуара(г/см3)"
      883        VIEW-AS FILL-IN
      884        SIZE 18 BY 1 NO-UNDO.
      885   DEFINE VARIABLE error-mass AS DECIMAL FORMAT "9.99":U INITIAL 0.15
      886        LABEL "Погр.изм.массы в трубопр. (%)"
      887        VIEW-AS FILL-IN
      888        SIZE-PIXELS 93 BY 24 NO-UNDO.
      889   DEFINE VARIABLE place-diameter AS DECIMAL FORMAT ">,>>>,>>9":U INITIAL 0
      890        LABEL "Диаметр резервуара(мм)"
      891        VIEW-AS FILL-IN
      892        SIZE 11.63 BY 1 NO-UNDO.
      893   DEFINE VARIABLE place-ratio-error AS DECIMAL FORMAT "9.99":U INITIAL 0.25
      894        LABEL "Относительная погрешность составления калибровочной таблицы"
      895        VIEW-AS FILL-IN
      896        SIZE 18 BY 1 NO-UNDO.
      897   DEFINE VARIABLE place-temp-coef AS DECIMAL FORMAT "9.9999999999":U INITIAL 0.0000125
      898        LABEL "Темп. коэф. линейного расширения материала стенки рез-ра(1/°С)"
      899        VIEW-AS FILL-IN
      900        SIZE 18 BY 1 NO-UNDO.
      901   DEFINE VARIABLE place-dead-high AS DECIMAL FORMAT ">,>>>,>>9":U INITIAL 0
      902        LABEL "Высота мертвой полости(мм)"
      903        VIEW-AS FILL-IN
      904        SIZE 11.63 BY 1 NO-UNDO.
      905   DEFINE VARIABLE place-si AS INTEGER FORMAT ">>>>>9":U INITIAL 0
      906        LABEL "Основное средство измерения"
      907        VIEW-AS FILL-IN
      908        SIZE 11 BY 1 NO-UNDO.
      909   DEFINE VARIABLE v-mi-dnst AS INTEGER FORMAT ">>>>>9":U INITIAL 0
      910        LABEL ""
      911        VIEW-AS FILL-IN
      912        SIZE 11 BY 1 NO-UNDO.
      913   DEFINE VARIABLE v-mi-tmp AS INTEGER FORMAT ">>>>>9":U INITIAL 0
      914        LABEL ""
      915        VIEW-AS FILL-IN
      916        SIZE 11 BY 1 NO-UNDO.
      917   DEFINE VARIABLE v-mi-lvl AS INTEGER FORMAT ">>>>>9":U INITIAL 0
      918        LABEL ""
      919        VIEW-AS FILL-IN
      920        SIZE 11 BY 1 NO-UNDO.
      921   DEFINE VARIABLE place-si-name AS character FORMAT "X(10)":U
      922        LABEL "Основное средство измерения"
      923        VIEW-AS FILL-IN
      924        SIZE 11 BY 1 NO-UNDO.
      925   DEFINE VARIABLE v-mi-lvl-name AS character FORMAT "X(10)":U
      926        LABEL ""
      927        VIEW-AS FILL-IN
      928        SIZE 11 BY 1 NO-UNDO.
      929   DEFINE VARIABLE v-mi-dnst-name AS character FORMAT "X(10)":U
      930        LABEL ""
      931        VIEW-AS FILL-IN
      932        SIZE 11 BY 1 NO-UNDO.
      933   DEFINE VARIABLE v-mi-tmp-name AS character FORMAT "X(10)":U
      934        LABEL ""
      935        VIEW-AS FILL-IN
      936        SIZE 11 BY 1 NO-UNDO.
      937   DEFINE VARIABLE place-twice-code AS CHARACTER FORMAT "x(8)"
      938        LABEL "Коды связанных резервуаров"
      939        VIEW-AS FILL-IN
      940        SIZE 18 BY 1 NO-UNDO.
      941   DEFINE VARIABLE place-passp-num AS CHARACTER FORMAT "x(256)"
      942        LABEL "Номер резервуара по паспорту"
      943        VIEW-AS FILL-IN
      944        SIZE 45 BY 1 NO-UNDO.
      945   DEFINE VARIABLE place-passp-type AS CHARACTER FORMAT "x(256)"
      946        LABEL "Тип резервуара по паспорту"
      947        VIEW-AS FILL-IN
      948        SIZE 45 BY 1 NO-UNDO.
      949   DEFINE VARIABLE place-locat AS INTEGER INITIAL 2
      950        VIEW-AS RADIO-SET HORIZONTAL
      951        RADIO-BUTTONS
      952             "Наземный", 1,
      953   "Подземный", 2
      954        SIZE 25.5 BY .92 NO-UNDO.
      955   DEFINE VARIABLE place-type AS INTEGER initial 2
      956        VIEW-AS RADIO-SET HORIZONTAL
      957        RADIO-BUTTONS
      958             "Вертикальный", 1,
      959   "Горизонтальный", 2
      960        SIZE 34.5 BY .92 NO-UNDO.
      961   DEFINE VARIABLE rvd-dnstv AS LOGICAL INITIAL no
      962        LABEL "Плотность"
      963        VIEW-AS TOGGLE-BOX
      964        SIZE 11.13 BY 1 NO-UNDO.
      965   DEFINE VARIABLE rvd-lvl AS LOGICAL INITIAL no
      966        LABEL "Уровень"
      967        VIEW-AS TOGGLE-BOX
      968        SIZE 11.13 BY 1 NO-UNDO.
      969   DEFINE VARIABLE rvd-tmp AS LOGICAL INITIAL no
      970        LABEL "Температура"
      971        VIEW-AS TOGGLE-BOX
      972        SIZE 13.5 BY 1 NO-UNDO.
      973   DEFINE VARIABLE t-asi-srtif AS LOGICAL INITIAL no
      974        LABEL "АСИ сертифицировано"
      975        VIEW-AS TOGGLE-BOX
      976        SIZE 22.13 BY 1 NO-UNDO.
      977   DEFINE VARIABLE t-place-virtual AS LOGICAL INITIAL no
      978        LABEL "Виртуальный резервуар"
      979        VIEW-AS TOGGLE-BOX
      980        SIZE 27 BY 1 NO-UNDO.
      981   DEFINE VARIABLE t-ponton AS LOGICAL INITIAL no
      982        LABEL "Понтон:"
      983        VIEW-AS TOGGLE-BOX
      984        SIZE 15 BY 1 NO-UNDO.
      985   DEFINE VARIABLE ponton-mass AS DECIMAL FORMAT ">>>>>>9.999":U INITIAL ? decimals 3
      986        LABEL "Масса понтона(кг)"
      987        VIEW-AS FILL-IN
      988        SIZE 12 BY 1 NO-UNDO.
      989   DEFINE VARIABLE ponton-height AS DECIMAL FORMAT ">>>>>>9.9":U INITIAL ? decimals 1
      990        LABEL "Высота всплытия(мм)"
      991        VIEW-AS FILL-IN
      992        SIZE 12 BY 1 NO-UNDO.
      993   DEFINE VARIABLE t-com-vessel AS LOGICAL INITIAL no
      994        LABEL "Сообщающиеся резервуары:"
      995        VIEW-AS TOGGLE-BOX
      996        SIZE 30 BY 1 NO-UNDO.
      997   DEFINE VARIABLE t-gate-valve AS LOGICAL INITIAL no
      998        LABEL "Задвижка:"
      999        VIEW-AS TOGGLE-BOX
     1000        SIZE 15 BY 1 NO-UNDO.
     1001   DEFINE VARIABLE com-tanks AS CHARACTER FORMAT "x(15)"
     1002        LABEL ""
     1003        VIEW-AS FILL-IN
     1004        SIZE 15 BY 1 NO-UNDO.
     1005   DEFINE VARIABLE gate-valve-tanks AS CHARACTER FORMAT "x(15)"
     1006        LABEL ""
     1007        VIEW-AS FILL-IN
     1008        SIZE 15 BY 1 NO-UNDO.
     1009   DEFINE VARIABLE v-is-main AS character FORMAT "x(11)"
     1010        LABEL ""
     1011        VIEW-AS fill-in
     1012        SIZE 11 BY 1 NO-UNDO.
     1013   DEFINE VARIABLE t-auto-gate-valve AS LOGICAL INITIAL no
     1014        LABEL "Автоматическая задвижка"
     1015        VIEW-AS TOGGLE-BOX
     1016        SIZE 25 BY 1 NO-UNDO.
     1017   DEFINE FRAME d-pl-form
     1018        b-exit AT ROW 1 COL 2
     1019        b-quit AT ROW 1 COL 12
     1020        B-hist AT ROW 1 COL 66.63
     1021        b-help AT ROW 1 COL 76.63
     1022        tt-place.loc1 AT ROW 3 COL 10 COLON-ALIGNED
     1023             LABEL "Коорд&1"
     1024             VIEW-AS FILL-IN
     1025             SIZE 11.63 BY 1
     1026        tt-place.loc2 AT ROW 3 COL 30.63 COLON-ALIGNED
     1027             LABEL "Коорд&2"
     1028             VIEW-AS FILL-IN
     1029             SIZE 11.63 BY 1
     1030        tt-place.loc3 AT ROW 3 COL 52.5 COLON-ALIGNED
     1031             LABEL "Коорд&3"
     1032             VIEW-AS FILL-IN
     1033             SIZE 11.63 BY 1
     1034        tt-place.loc4 AT ROW 3 COL 88.01 RIGHT-ALIGNED
     1035             LABEL "Коорд&4"
     1036             VIEW-AS FILL-IN
     1037             SIZE 11.63 BY 1
     1038        tt-place.pl-name AT ROW 4.25 COL 10 COLON-ALIGNED
     1039             LABEL "Название"
     1040             VIEW-AS FILL-IN
     1041             SIZE 77 BY 1
     1042        t-place-virtual AT ROW 5.46 COL 35.5 WIDGET-ID 28
     1043        t-asi-srtif AT ROW 5.46 COL 66.88 WIDGET-ID 22
     1044        tt-place.is-meas AT ROW 5.5 COL 10
     1045             LABEL "Измеряется приборами"
     1046             VIEW-AS TOGGLE-BOX
     1047             SIZE 23.63 BY 1
     1048        tt-place.pl-code AT ROW 6.75 COL 5.63 COLON-ALIGNED format "99999999999"
     1049             LABEL "Код"
     1050             VIEW-AS FILL-IN
     1051             SIZE 12.93 BY 1
     1052        rvd-dnstv AT ROW 6.75 COL 35 WIDGET-ID 40
     1053        rvd-lvl AT ROW 6.75 COL 52 WIDGET-ID 44
     1054        rvd-tmp AT ROW 6.75 COL 68 WIDGET-ID 46
     1055        "Доп. средства измерения:" VIEW-AS TEXT
     1056             SIZE 24 BY .75 AT ROW 7.7 COL 7 WIDGET-ID 50
     1057        v-mi-dnst AT ROW 7.7 COL 33 COLON-ALIGNED WIDGET-ID 52 no-label
     1058        v-mi-dnst-name AT ROW 7.7 COL 33 COLON-ALIGNED WIDGET-ID 52 no-label
     1059        b-mi-dnst AT ROW 7.7 COL 48 RIGHT-ALIGNED
     1060        v-mi-lvl AT ROW 7.7 COL 50 COLON-ALIGNED WIDGET-ID 52 no-label
     1061        v-mi-lvl-name AT ROW 7.7 COL 50 COLON-ALIGNED WIDGET-ID 52 no-label
     1062        b-mi-lvl AT ROW 7.7 COL 65 RIGHT-ALIGNED
     1063        v-mi-tmp AT ROW 7.7 COL 66 COLON-ALIGNED WIDGET-ID 52 no-label
     1064        v-mi-tmp-name AT ROW 7.7 COL 66 COLON-ALIGNED WIDGET-ID 52 no-label
     1065        b-mi-tmp AT ROW 7.7 COL 81 RIGHT-ALIGNED
     1066        tt-place.issue-year AT ROW 8.71 COL 21.63 COLON-ALIGNED
     1067             LABEL "Год выпуска"
     1068             VIEW-AS FILL-IN
     1069             SIZE 11.63 BY 1
     1070        place-type AT ROW 8.71 COL 88 RIGHT-ALIGNED NO-LABEL WIDGET-ID 8
     1071        tt-place.start-date AT ROW 9.71 COL 21.63 COLON-ALIGNED
     1072             LABEL "Ввод в эксплуатацию"
     1073             VIEW-AS FILL-IN
     1074             SIZE 11.63 BY 1
     1075        place-locat AT ROW 9.71 COL 88 RIGHT-ALIGNED NO-LABEL WIDGET-ID 30
     1076        t-ponton at row 10.81 col 2
     1077        ponton-mass at row 10.81 col 18
     1078        ponton-height  at row 10.81 col 50
     1079        tt-place.add-qnty AT ROW 11.92 COL 30.63 COLON-ALIGNED
     1080             LABEL "Объем трубопровода(л)"
     1081             VIEW-AS FILL-IN
     1082             SIZE 11.63 BY 1
     1083        error-mass AT ROW 11.92 COL 75.38 COLON-ALIGNED WIDGET-ID 38
     1084        tt-place.max-qnty AT ROW 12.92 COL 30.63 COLON-ALIGNED
     1085             LABEL "Макс. кол-во в резервуаре(л)"
     1086             VIEW-AS FILL-IN
     1087             SIZE 11.63 BY 1
     1088        place-si AT ROW 12.92 COL 75.38 COLON-ALIGNED WIDGET-ID 16
     1089        r-sr-izm AT ROW 12.92 COL 90 RIGHT-ALIGNED
     1090        place-si-name AT ROW 12.92 COL 75.38 COLON-ALIGNED
     1091        dead-balance AT ROW 13.92 COL 30.63 COLON-ALIGNED WIDGET-ID 18
     1092        water-level AT ROW 14.92 COL 30.63 COLON-ALIGNED WIDGET-ID 58
     1093        place-diameter AT ROW 13.92 COL 75.38 COLON-ALIGNED WIDGET-ID 18
     1094        place-dead-high at row 15.25 COL 88 RIGHT-ALIGNED
     1095        place-temp-coef at row 16.25 COL 88 RIGHT-ALIGNED
     1096        dens-prov AT ROW 17.25 COL 88 RIGHT-ALIGNED
     1097        t-auto-gate-valve at row 18.25 col 3
     1098        place-twice-code AT ROW 18.25 COL 88 RIGHT-ALIGNED WIDGET-ID 24
     1099        t-com-vessel at row 19.25 col 20
     1100        com-tanks at row 19.25 col 65 no-label
     1101        b-com-tanks at row 19.25 col 85
     1102        v-is-main at row 19.25 col 5 no-label
     1103        t-gate-valve at row 20.25 col 20
     1104        gate-valve-tanks at row 20.25 col 65 no-label
     1105        b-gate-valve-tanks at row 20.25 col 85
     1106        place-passp-num at row 21.5 col 88 right-aligned
     1107        place-passp-type at row 22.5 col 88 right-aligned
     1108        tt-place.chk-max-qnty AT ROW 24 COL 3 WIDGET-ID 2
     1109             LABEL "Проверять макс. допустимое кол-во товара на месте хранения"
     1110             VIEW-AS TOGGLE-BOX
     1111             SIZE 62.63 BY .83
     1112        tt-place.PS AT ROW 25 COL 2 NO-LABEL
     1113             VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1114             SIZE 87 BY 4
     1115        "Тип резервуара:" VIEW-AS TEXT
     1116             SIZE 15.63 BY .75 AT ROW 8.71 COL 37 WIDGET-ID 12
     1117        "РВД:" VIEW-AS TEXT
     1118             SIZE 8 BY 1 AT ROW 6.75 COL 27 WIDGET-ID 42
     1119        "Расположение резервуара:" VIEW-AS TEXT
     1120             SIZE 24.75 BY .92 AT ROW 9.75 COL 37 WIDGET-ID 34
     1121        SPACE(30.12) SKIP(16.65)
     1122       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1123            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1124            TITLE "Складское место".
     1125   ASSIGN
     1126          FRAME d-pl-form:SCROLLABLE       = FALSE.
     1127   ON CHOOSE OF b-exit IN FRAME d-pl-form
     1128   DO:
     1129   define variable vOk as logical no-undo .
     1130   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1131   if lookup(self :type
     1132            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1133            ) = 0
     1134   then do:
     1135     message
     1136       "$Workfile$"
     1137       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1138       "Интерфейсный элемент" self :name  skip
     1139       "Тип" self :type  skip
     1140       "Процедура" this-procedure :file-name skip
     1141       view-as alert-box .
     1142   end.
     1143   else do:
     1144     apply "entry":u to self  .
     1145     if focus :handle <> self :handle  then do:
     1146       return no-apply .
     1147     end.
     1148   end.
     1149   assign
     1150     tt-place.pl-name
     1151     tt-place.loc1
     1152     tt-place.loc2
     1153     tt-place.loc3
     1154     tt-place.loc4
     1155     tt-place.ps
     1156     tt-place.add-qnty
     1157     tt-place.is-meas
     1158     tt-place.max-qnty
     1159     tt-place.start-date
     1160     tt-place.issue-year
     1161     tt-place.chk-max-qnty
     1162     t-place-virtual
     1163     t-asi-srtif
     1164     place-locat
     1165     error-mass
     1166     rvd-dnstv
     1167     rvd-lvl
     1168     rvd-tmp
     1169     place-si
     1170     v-mi-dnst
     1171     v-mi-lvl
     1172     v-mi-tmp
     1173     ponton-mass
     1174     ponton-height
     1175     t-com-vessel
     1176     t-auto-gate-valve
     1177   .
     1178   if v-mi-dnst = ? then v-mi-dnst = 0 .
     1179   if v-mi-lvl = ?  then v-mi-lvl = 0 .
     1180   if v-mi-tmp = ? then v-mi-tmp = 0 .
     1181   if input frame d-pl-form dens-prov <> dens-prov then
     1182   do:
     1183     if input frame d-pl-form dens-prov = ?
     1184       or (  input frame d-pl-form dens-prov <= 0
     1185       or input frame d-pl-form dens-prov >= 1
     1186       )
     1187       then
     1188     do:
     1189       message "Неверно определена плотность при поверке резервуара" view-as alert-box error.
     1190       apply "entry" to dens-prov .
     1191       return no-apply.
     1192     end.
     1193     assign frame d-pl-form dens-prov.
     1194   end.
     1195   if place-type:screen-value = "1"
     1196   and t-ponton:screen-value = "yes"
     1197   then do :
     1198     if ponton-mass = 0
     1199     or ponton-mass = ?
     1200     then do :
     1201       message "Не указана масса понтона для вертикального резервуара с понтоном." skip
     1202               "Сохранение невозможно." skip
     1203               "Укажите массу понтона."
     1204       view-as alert-box error.
     1205       apply "entry" to ponton-mass .
     1206       return no-apply.
     1207     end .
     1208     if ponton-height = 0
     1209     or ponton-height = ?
     1210     then do :
     1211       message "Не указана высота всплытия понтона для вертикального резервуара с понтоном." skip
     1212               "Сохранение невозможно." skip
     1213               "Укажите высоту всплытия понтона."
     1214       view-as alert-box error.
     1215       apply "entry" to ponton-height .
     1216       return no-apply.
     1217     end .
     1218   end .
     1219   if t-com-vessel:screen-value = "yes"
     1220   then do :
     1221     if com-tanks:screen-value = ""
     1222     then do :
     1223       message "Укажите сообщающийся резервуар!" view-as alert-box error.
     1224       return no-apply.
     1225     end .
     1226   end .
     1227   if rvd-dnstv <> rvd-tmp
     1228   and ((available dnst_sr-izmerenia and dnst_sr-izmerenia.sr-type-izm = 0 and dnst_sr-izmerenia.sr-density and dnst_sr-izmerenia.sr-temperature)
     1229     or (available tmp_sr-izmerenia and tmp_sr-izmerenia.sr-type-izm = 0 and tmp_sr-izmerenia.sr-density and tmp_sr-izmerenia.sr-temperature))
     1230   then do :
     1231     message "Бизнес-процессом не предусмотрено использование неравнозначных положений разрешения РВД по параметрам температура и плотность, " +
     1232             "если дополнительное автоматизированное СИ предназначено для измерения обоих параметров. " +
     1233             "Сохранение неравнозначных положений разрешения РВД по параметрам температура и плотность запрещено. " +
     1234             "Установите разрешение РВД для температуры и плотности в равнозначные положения."
     1235     view-as alert-box .
     1236     return no-apply.
     1237   end .
     1238   if available dnst_sr-izmerenia
     1239   and available tmp_sr-izmerenia
     1240   and dnst_sr-izmerenia.node-code <> tmp_sr-izmerenia.node-code
     1241   and ((dnst_sr-izmerenia.sr-density and dnst_sr-izmerenia.sr-temperature)
     1242     or (tmp_sr-izmerenia.sr-density and tmp_sr-izmerenia.sr-temperature))
     1243   then do :
     1244     message "Нельзя устанавливать разные дополнительные СИ по плотности и температуре, если одно из них измеряет оба параметра." skip
     1245             "Сохранение невозможно."
     1246     view-as alert-box .
     1247     return no-apply.
     1248   end .
     1249   if place-si = ? or place-si = 0
     1250   then do :
     1251     message "Не указано основное средство измерения! Вы уверены, что хотите закончить настройку складского места?"
     1252     view-as alert-box question buttons yes-no update vOk .
     1253     if not vOk
     1254     then
     1255       return no-apply .
     1256   end .
     1257   else do :
     1258     find first sr-izmerenia no-lock where sr-izmerenia.node-code = place-si .
     1259     if sr-izmerenia.sr-level
     1260     and sr-izmerenia.sr-density
     1261     and sr-izmerenia.sr-temperature
     1262     and sr-izmerenia.sr-Weight
     1263     then do : end .
     1264     else do :
     1265       message "Выбранное основное средство измерения не настроено на измерение всех параметров! Вы уверены, что хотите закончить настройку складского места?"
     1266       view-as alert-box question buttons yes-no update vOk .
     1267       if not vOk
     1268       then
     1269         return no-apply .
     1270     end .
     1271   end .
     1272   if rvd-dnstv
     1273   then do :
     1274     if v-mi-dnst = ? or v-mi-dnst = 0
     1275     then do :
     1276       message "Не указано вспомогательное средство измерения плотности. Вы уверены, что хотите закончить настройку складского места?"
     1277       view-as alert-box question buttons yes-no update vOk .
     1278       if not vOk
     1279       then
     1280         return no-apply .
     1281     end .
     1282     else do :
     1283       find first sr-izmerenia no-lock where sr-izmerenia.node-code = v-mi-dnst .
     1284       if not sr-izmerenia.sr-density
     1285       then do :
     1286         message "Выбранное дополнительно средство измерения для плотности не настроено на измерение плотности! Вы уверены, что хотите закончить настройку складского места?"
