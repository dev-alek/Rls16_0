     2981   end .
     2982   on return of v-mi-tmp IN FRAME d-pl-form
     2983   do:
     2984     apply "leave" to v-mi-tmp IN FRAME d-pl-form .
     2985   end .
     2986   on del of v-mi-tmp in frame d-pl-form
     2987   do :
     2988     v-mi-tmp = 0   .
     2989     v-mi-tmp:screen-value = "0" .
     2990   end .
     2991   on del of v-mi-dnst in frame d-pl-form
