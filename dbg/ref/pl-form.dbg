     2244       run placelib_write-attr  (input "place-need-RVD-rvs"
     2245                                 ,input p-obj-code
     2246                                 ,input p-obj-type
     2247                                 ,input ub.place.pl-code
     2248                                 ,input string(no)
     2249                                 ,output v-ok      ) no-error.
     2250     end .
     2251   end.
     2252   if AVAILABLE (ub.place) then
     2253   do:
     2254   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
     2255     (input ?
     2256     ,input this-procedure:handle
     2257     ,input ?
     2258     ,input 'ref-event':U
     2259     ,input  buffer ub.place:handle
     2260     ,input  buffer ub.place:handle
     2261     ,input ''
     2262     ,input ''
     2263     ) no-error .
     2264     if error-status :error
     2265       then
     2266     do:
     2267       message
     2268         error-status:get-message(1) skip
     2269         return-value
     2270         view-as alert-box error .
     2271       return no-apply .
     2272     end.
     2273   end.
     2274   END.
     2275   ON CHOOSE OF B-hist IN FRAME d-pl-form
     2276   DO:
     2277       define variable v-rid-list as character no-undo.
     2278       run ref/cplchist.w
     2279         ( input parparentproc
     2280         , input p-obj-type
     2281         , input p-obj-code
     2282         , input "":u
     2283         , input "one":u
     2284         , input tt-place.obj-type
     2285         , input tt-place.obj-code
     2286         , input tt-place.pl-code
     2287         , input 0
     2288         , input 0
     2289         , input 0
     2290         , input '':u
     2291         , input-output v-rid-list
     2292         ) no-error .
     2293     END.
     2294   ON CHOOSE OF b-quit IN FRAME d-pl-form
     2295   DO:
     2296     define variable vlog as logical no-undo .
     2297     message "Все введенные данные будут утеряны. Вы уверены, что хотите отказаться от внесенных изменений?"
     2298     view-as alert-box question buttons yes-no update vlog .
     2299     if not vlog then return no-apply .
     2300     p-rep-rec = ?.
     2301   END.
     2302   ON LEAVE OF dens-prov IN FRAME d-pl-form
     2303   DO:
     2304     if input frame d-pl-form dens-prov <> dens-prov then do:
     2305       if input frame d-pl-form dens-prov = ?
     2306         or (  input frame d-pl-form dens-prov <= 0
     2307               or input frame d-pl-form dens-prov >= 1
     2308                 )
     2309       then do:
     2310         message "Неверно определена плотность при поверке резервуара" view-as alert-box error.
     2311         apply "entry" to dens-prov .
     2312         return no-apply.
     2313       end.
     2314       assign frame d-pl-form dens-prov.
     2315     end.
     2316   if AVAILABLE (ub.place) then
     2317   do:
     2318   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
     2319     (input ?
     2320     ,input this-procedure:handle
     2321     ,input ?
     2322     ,input 'ref-event':U
     2323     ,input  buffer ub.place:handle
     2324     ,input  buffer ub.place:handle
     2325     ,input ''
     2326     ,input ''
     2327     ) no-error .
     2328     if error-status :error
     2329       then
     2330     do:
     2331       message
     2332         error-status:get-message(1) skip
     2333         return-value
     2334         view-as alert-box error .
     2335       return no-apply .
     2336     end.
     2337   end.
     2338   END.
     2339   ON VALUE-CHANGED OF rvd-dnstv IN FRAME d-pl-form
     2340   DO:
     2341     define variable vlog as logical no-undo .
     2342     define variable v-tmp-old-val as character no-undo .
     2343     v-tmp-old-val = rvd-tmp:screen-value .
     2344     if available dnst_sr-izmerenia
     2345     and dnst_sr-izmerenia.sr-type-izm = 0
     2346     and dnst_sr-izmerenia.sr-density
     2347     and dnst_sr-izmerenia.sr-temperature
     2348     and rvd-dnstv:screen-value <> rvd-tmp:screen-value
     2349     then do :
     2350       message "Бизнес-процессом не предусмотрено использование неравнозначных положений разрешения РВД по параметрам температура и плотность, " +
     2351               "если автоматизированное СИ для одного из них предназначено для измерения обоих. " +
     2352               "Сохранение неравнозначных положений разрешения РВД по параметрам температура и плотность запрещено. " +
     2353               "Установить значение " + (if rvd-dnstv:screen-value = "yes" then "'Да'" else "'Нет'") + " для РВД по температуре автоматически?"
     2354       view-as alert-box question buttons yes-no update vlog .
     2355       if vlog
     2356       then do :
     2357         rvd-tmp:screen-value = rvd-dnstv:screen-value .
     2358       end .
     2359     end .
     2360     if p-mode =  'ИЗМЕНЕНИЕ':U then
     2361     do:
     2362       if rvd-dnstv:screen-value = "yes" then do:
     2363         if not v-rvd-on
     2364         and not v-rvd-dnsty-on
     2365         then do :
     2366           message "Для установки разрешения РВД необходимо указать причину перехода на РВД, номер заявки в ITSM, ФИО инициатора заявки."
     2367           view-as alert-box question buttons ok-cancel update vlog .
     2368           if not vlog
     2369           then do :
     2370             rvd-dnstv:screen-value = "no" .
     2371             rvd-tmp:screen-value = v-tmp-old-val .
     2372             return no-apply .
     2373           end .
     2374           v-rvd-reason-on = ? .
     2375           run ref/rvd-reasons.w (input parparentproc,
     2376                                  input 0,
     2377                                  output v-rvd-reason-on,
     2378                                  output v-ITSM-num-on,
     2379                                  output v-oper-fio-on)
     2380                                  .
     2381           if v-rvd-reason-on = ?
     2382           then do :
     2383             rvd-dnstv:screen-value = "no" .
     2384             rvd-tmp:screen-value = v-tmp-old-val .
     2385             return no-apply .
     2386           end .
     2387           v-rvd-on = yes .
     2388         end .
     2389       end.
     2390       else do:
     2391         if not v-rvd-off
     2392         and v-rvd-dnsty-on
     2393         then do :
     2394           message "Для снятия разрешения РВД необходимо указать причину перехода на АВД, номер заявки в ITSM, ФИО инициатора заявки."
     2395           view-as alert-box question buttons ok-cancel update vlog .
     2396           if not vlog
     2397           then do :
     2398             rvd-dnstv:screen-value = "yes" .
     2399             rvd-tmp:screen-value = v-tmp-old-val .
     2400             return no-apply .
     2401           end .
     2402           v-rvd-reason-off = ? .
     2403           run ref/rvd-reasons.w (input parparentproc,
     2404                                  input 0,
     2405                                  output v-rvd-reason-off,
     2406                                  output v-ITSM-num-off,
     2407                                  output v-oper-fio-off)
     2408                                  .
     2409           if v-rvd-reason-off = ?
     2410           then do :
     2411             rvd-dnstv:screen-value = "yes" .
     2412             rvd-tmp:screen-value = v-tmp-old-val .
     2413             return no-apply .
     2414           end .
     2415           v-rvd-off = yes .
     2416         end .
     2417       end.
     2418     end.
     2419   END.
