     2560   ON VALUE-CHANGED OF tt-place.is-meas IN FRAME d-pl-form
     2561   DO:
     2562     define variable vlog as logical no-undo .
     2563       if tt-place.is-meas:screen-value = "yes" then do:
     2564         if not v-rvd-off
     2565         and not v-rvd-is-meas-on
     2566         and p-mode = 'ИЗМЕНЕНИЕ':U
     2567         then do :
     2568           message "Для снятия разрешения РВД необходимо указать причину перехода на АВД, номер заявки в ITSM, ФИО инициатора заявки."
     2569           view-as alert-box question buttons ok-cancel update vlog .
     2570           if not vlog
     2571           then do :
     2572             tt-place.is-meas:screen-value = "no" .
     2573             return no-apply .
     2574           end .
     2575           v-rvd-reason-off = ? .
     2576           run ref/rvd-reasons.w (input parparentproc,
     2577                                  input 0,
     2578                                  output v-rvd-reason-off,
     2579                                  output v-ITSM-num-off,
     2580                                  output v-oper-fio-off)
     2581                                  .
     2582           if v-rvd-reason-off = ?
     2583           then do :
     2584             tt-place.is-meas:screen-value = "no" .
     2585             return no-apply .
     2586           end .
     2587           v-rvd-off = yes .
     2588         end .
     2589         enable t-asi-srtif with frame d-pl-form .
     2590       end.
     2591       else do:
     2592         if not v-rvd-on
     2593         and v-rvd-is-meas-on
     2594         and p-mode = 'ИЗМЕНЕНИЕ':U
     2595         then do :
     2596           message "Для установки разрешения РВД необходимо указать причину перехода на РВД, номер заявки в ITSM, ФИО инициатора заявки."
     2597           view-as alert-box question buttons ok-cancel update vlog .
     2598           if not vlog
     2599           then do :
     2600             tt-place.is-meas:screen-value = "yes" .
     2601             return no-apply .
     2602           end .
     2603           v-rvd-reason-on = ? .
     2604           run ref/rvd-reasons.w (input parparentproc,
     2605                                  input 0,
     2606                                  output v-rvd-reason-on,
     2607                                  output v-ITSM-num-on,
     2608                                  output v-oper-fio-on)
     2609                                  .
     2610           if v-rvd-reason-on = ?
     2611           then do :
     2612             tt-place.is-meas:screen-value = "yes" .
     2613             return no-apply .
     2614           end .
     2615           v-rvd-on = yes .
     2616         end .
     2617         disable t-asi-srtif with frame d-pl-form .
     2618       end.
     2619   END.
     2620   ON value-changed OF place-type IN FRAME d-pl-form
     2621   DO:
     2622     if place-type:screen-value = "1"
     2623     then do :
     2624       if p-mode = 'ДОБАВЛЕНИЕ':U
     2625       then do :
     2626         enable t-ponton with frame d-pl-form .
     2627         if t-ponton:screen-value = "yes"
     2628         then do :
     2629           enable ponton-mass ponton-height with frame d-pl-form .
     2630         end .
     2631         else do :
     2632           disable ponton-mass ponton-height with frame d-pl-form .
     2633         end .
     2634       end .
     2635     end .
     2636     if place-type:screen-value = "2"
     2637     then do :
     2638       disable t-ponton ponton-mass ponton-height with frame d-pl-form .
     2639     end .
     2640   END.
     2641   ON value-changed OF t-ponton IN FRAME d-pl-form
     2642   DO:
     2643     if t-ponton:screen-value = "yes"
     2644     then do :
     2645       enable ponton-mass ponton-height with frame d-pl-form .
     2646     end .
     2647     else do :
     2648       disable ponton-mass ponton-height with frame d-pl-form .
     2649     end .
     2650   END.
     2651   ON value-changed OF t-com-vessel IN FRAME d-pl-form
     2652   DO:
     2653     if t-com-vessel:screen-value = "yes"
     2654     then do :
     2655       enable b-com-tanks with frame d-pl-form .
     2656       disable t-gate-valve b-gate-valve-tanks with frame d-pl-form .
     2657       if v-not-gas-place
     2658       then do :
     2659         display t-auto-gate-valve with frame d-pl-form.
     2660         if is-main
     2661         then do :
     2662           enable t-auto-gate-valve with frame d-pl-form.
     2663         end .
     2664       end .
     2665     end .
     2666     else do :
     2667       if is-main
     2668       and num-entries(com-tanks) > 1
     2669       then do :
     2670         message substitute('Резервуар №&1 отмечен как "Главный", изменение связки сообщающихся резервуаров невозможно! Исключите из связки все "Не главные" резервуары!', tt-place.loc1)
     2671         view-as alert-box .
     2672         t-com-vessel:screen-value = "yes" .
     2673         return no-apply .
     2674       end .
     2675       if com-tanks > ""
     2676       then do :
     2677         message "Сообщающиеся резервуары будут разъединены! Вы уверены?" view-as alert-box question buttons yes-no update v-ok .
     2678         if v-ok
     2679         then do :
     2680           com-tanks = "" .
     2681           display com-tanks with frame d-pl-form .
     2682           disable b-com-tanks with frame d-pl-form .
     2683           hide v-is-main in frame d-pl-form .
     2684         end .
     2685         else do :
     2686           t-com-vessel:screen-value = "yes" .
     2687           return no-apply .
     2688         end .
     2689       end .
     2690       if v-sug-place
     2691       then do :
     2692         enable t-gate-valve b-gate-valve-tanks with frame d-pl-form .
     2693       end .
     2694       hide t-auto-gate-valve in frame d-pl-form.
     2695     end .
     2696     v-com-vessel-changed = yes .
     2697   END.
     2698   ON value-changed OF t-auto-gate-valve IN FRAME d-pl-form
     2699   DO:
     2700     if t-auto-gate-valve:screen-value = "no"
     2701     then do :
     2702       message "Чек-бокс «Автоматическая задвижка» будет выключен. Расчет плотности не будет рассчитываться на основании анализа убыли объема в резервуаре! Вы уверены?" view-as alert-box question buttons yes-no update v-ok .
     2703       if not v-ok
     2704       then do :
     2705         t-auto-gate-valve:screen-value = "yes" .
     2706         return no-apply .
     2707       end .
     2708     end .
     2709   END.
     2710   ON value-changed OF t-gate-valve IN FRAME d-pl-form
     2711   DO:
     2712     if t-gate-valve:screen-value = "yes"
     2713     then do :
     2714       enable b-gate-valve-tanks with frame d-pl-form .
     2715       disable t-com-vessel b-com-tanks with frame d-pl-form .
     2716     end .
     2717     else do :
     2718       if gate-valve-tanks > ""
     2719       then do :
     2720         gate-valve-tanks = "" .
     2721         display gate-valve-tanks with frame d-pl-form .
     2722         disable b-gate-valve-tanks with frame d-pl-form .
     2723       end .
     2724       enable t-com-vessel b-com-tanks with frame d-pl-form .
     2725     end .
     2726     v-gate-valve-tanks-changed = yes .
     2727   END.
     2728   ON CHOOSE OF r-sr-izm IN FRAME d-pl-form
     2729   DO:
     2730     define variable v-node-code as integer no-undo.
     2731     define variable v-sr-type as character no-undo.
     2732     v-node-code = 0 .
     2733     run ref/sr-izm.w (input parparentproc ,
     2734                       input "b-sel"       ,
     2735                       input 'ПРОСМОТР':U     ,
     2736                       input ""            ,
     2737                       input ""            ,
     2738                       input-output v-node-code,
     2739                       output v-sr-type) no-error.
     2740     if v-node-code <> 0 and v-node-code <> ? then do :
     2741       place-si = v-node-code.
     2742       place-si:screen-value = string(v-node-code).
     2743       find first osn_sr-izmerenia no-lock where osn_sr-izmerenia.node-code = place-si .
     2744       apply "leave" to place-si in frame d-pl-form .
     2745     end.
     2746   END.
     2747   on entry of place-si-name IN FRAME d-pl-form
     2748   do:
     2749     apply "entry" to place-si in frame d-pl-form.
     2750   end .
     2751   on entry of place-si IN FRAME d-pl-form
     2752   do:
     2753     hide place-si-name in frame d-pl-form.
     2754   end .
     2755   on return of place-si IN FRAME d-pl-form
     2756   do:
     2757     apply "leave" to place-si IN FRAME d-pl-form .
     2758   end .
     2759   on del of place-si in frame d-pl-form
     2760   do :
     2761     place-si = ? .
     2762     place-si:screen-value = "?" .
     2763   end .
     2764   on leave of place-si IN FRAME d-pl-form
     2765   do:
     2766     define variable v-old-val as character no-undo .
     2767     v-old-val = string(place-si) .
     2768     find first osn_sr-izmerenia no-lock where osn_sr-izmerenia.node-code = integer(place-si:screen-value) no-error .
     2769     if not available osn_sr-izmerenia
     2770     then do :
     2771       if place-si:screen-value <> "?"
     2772       and place-si:screen-value <> "0"
     2773       then do :
     2774         message ("Не найдено средство измерения с кодом " + place-si:screen-value) view-as alert-box .
     2775         place-si:screen-value = v-old-val .
     2776       end .
     2777       return .
     2778     end .
     2779     place-si-name = osn_sr-izmerenia.sr-model .
     2780     display place-si-name with frame d-pl-form.
     2781     enable place-si-name with frame d-pl-form.
     2782     assign place-si .
     2783   end .
     2784   ON CHOOSE OF b-mi-dnst IN FRAME d-pl-form
     2785   DO:
     2786     define variable v-node-code as integer no-undo.
     2787     define variable v-sr-type-id as character no-undo.
     2788     define variable v-sr-type-izm as character no-undo .
     2789     v-node-code = 0 .
     2790       v-sr-type-izm = "0,1" .
     2791     run ref/sr-izm.w (input parparentproc ,
     2792                       input "b-sel"       ,
     2793                       input 'ПРОСМОТР':U     ,
     2794                       input v-sr-type-izm ,
     2795                       input "dnst"        ,
     2796                       input-output v-node-code,
     2797                       output v-sr-type-id) no-error.
     2798     if v-node-code <> 0 and v-node-code <> ? then do :
     2799       v-mi-dnst = v-node-code.
     2800       v-mi-dnst:screen-value = string(v-node-code).
     2801       find first dnst_sr-izmerenia no-lock where dnst_sr-izmerenia.node-code = v-mi-dnst .
     2802       apply "leave" to v-mi-dnst in frame d-pl-form .
     2803     end.
     2804   END.
     2805   on entry of v-mi-dnst-name IN FRAME d-pl-form
     2806   do:
     2807     apply "entry" to v-mi-dnst in frame d-pl-form.
     2808   end .
     2809   on entry of v-mi-dnst IN FRAME d-pl-form
     2810   do:
     2811     hide v-mi-dnst-name in frame d-pl-form.
     2812   end .
     2813   on return of v-mi-dnst IN FRAME d-pl-form
     2814   do:
     2815     apply "leave" to v-mi-dnst IN FRAME d-pl-form .
     2816   end .
     2817   on del of v-mi-dnst in frame d-pl-form
     2818   do :
     2819     v-mi-dnst = 0 .
     2820     v-mi-dnst:screen-value = "0" .
     2821   end .
     2822   on leave of v-mi-dnst IN FRAME d-pl-form
     2823   do:
     2824     define variable vlog as logical no-undo .
     2825     define variable v-old-val as character no-undo .
     2826     v-old-val = string(v-mi-dnst) .
     2827     if v-mi-dnst:screen-value = "?" then v-mi-dnst:screen-value = "0" .
     2828     find first dnst_sr-izmerenia no-lock where dnst_sr-izmerenia.node-code = integer(v-mi-dnst:screen-value) no-error .
     2829     if not available dnst_sr-izmerenia
     2830     then do :
     2831       if v-mi-dnst:screen-value <> "?"
     2832       and v-mi-dnst:screen-value <> "0"
     2833       then do :
     2834         message ("Не найдено средство измерения с кодом " + v-mi-dnst:screen-value) view-as alert-box .
     2835         v-mi-dnst:screen-value = v-old-val .
     2836       end .
     2837       return .
     2838     end .
     2839     else do :
     2840       if dnst_sr-izmerenia.sr-type-izm = 2
     2841       then do :
     2842         message "Средство измерения является Измерительной Системой!" view-as alert-box .
     2843         v-mi-dnst:screen-value = v-old-val .
     2844         return .
     2845       end .
     2846       if not dnst_sr-izmerenia.sr-density
     2847       then do :
     2848         message "Средство измерения НЕ измеряет плотность!" view-as alert-box .
     2849         v-mi-dnst:screen-value = v-old-val .
     2850         return .
     2851       end .
     2852       if dnst_sr-izmerenia.sr-type-izm = 0
     2853       and dnst_sr-izmerenia.sr-density
     2854       and dnst_sr-izmerenia.sr-temperature
     2855       and rvd-dnstv:screen-value <> rvd-tmp:screen-value
     2856       then do :
     2857         message "Бизнес-процессом не предусмотрено использование неравнозначных положений разрешения РВД по параметрам температура и плотность, " +
     2858                 "если автоматизированное СИ для одного из них предназначено для измерения обоих. " +
     2859                 "Сохранение неравнозначных положений разрешения РВД по параметрам температура и плотность запрещено. " +
     2860                 "Установить значение " + (if rvd-dnstv:screen-value = "yes" then "'Да'" else "'Нет'") + " для РВД по температуре автоматически?"
     2861         view-as alert-box question buttons yes-no update vlog .
     2862         if vlog
     2863         then do :
     2864           rvd-tmp:screen-value = rvd-dnstv:screen-value .
     2865         end .
     2866       end .
     2867     end .
     2868     v-mi-dnst-name = dnst_sr-izmerenia.sr-model .
     2869     display v-mi-dnst-name with frame d-pl-form.
     2870     enable v-mi-dnst-name with frame d-pl-form.
     2871     assign v-mi-dnst .
     2872     if dnst_sr-izmerenia.sr-temperature
     2873     then do :
     2874         v-mi-tmp = v-mi-dnst .
     2875         v-mi-tmp:screen-value = v-mi-dnst:screen-value .
     2876         v-mi-tmp-name = v-mi-dnst-name .
     2877         find first tmp_sr-izmerenia no-lock where tmp_sr-izmerenia.node-code = v-mi-tmp .
     2878         display v-mi-tmp-name with frame d-pl-form.
     2879         enable v-mi-tmp-name with frame d-pl-form.
     2880     end .
     2881   end .
