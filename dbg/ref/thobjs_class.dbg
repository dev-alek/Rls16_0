        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision:$":U .
        3   define variable vss-author      as character no-undo init "$Author:$":U .
        4   define variable vss-date        as character no-undo init "$Date:$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
        6   define variable vss-archive     as character no-undo init "$Archive:$":U .
        7   define variable vss-description as character no-undo init "".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       63   define temp-table userobjs_temp-user-obj no-undo
       64     field obj-type as character
       65     field obj-code as integer
       66     index xpk is primary unique obj-type obj-code
       67     .
       68   procedure userobjs_clear :
       69     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       70     do
       71     on error undo, return error return-value
       72     :
       73       for each buf_userobjs_temp-user-obj
       74       on error undo, return error return-value
       75       :
       76         delete buf_userobjs_temp-user-obj .
       77       end.
       78     end.
       79   end .
       80   procedure userobjs_object-count :
       81     define output parameter p-total-count as integer   no-undo .
       82     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       83     do
       84     on error undo, return error return-value
       85     :
       86       assign
       87         p-total-count = 0
       88       .
       89       for each buf_userobjs_temp-user-obj
       90       on error undo, return error return-value
       91       :
       92         assign
       93           p-total-count = p-total-count + 1
       94         .
       95       end.
       96     end.
       97   end.
       98   procedure userobjs_append :
       99      define input  parameter p-obj-type as character no-undo .
      100      define input  parameter p-obj-code as integer   no-undo .
      101     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      102     do
      103     on error undo, return error return-value
      104     :
      105       find first buf_userobjs_temp-user-obj
      106         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      107           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      108         no-error .
      109       if not available buf_userobjs_temp-user-obj
      110       then do:
      111         create buf_userobjs_temp-user-obj .
      112         assign
      113           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      114           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      115         .
      116       end.
      117     end.
      118   end.
      119   procedure userobjs_object-exist :
      120     define output parameter p-object-exist as logical   no-undo .
      121     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      122     do
      123     on error undo, return error return-value
      124     :
      125       find first buf_userobjs_temp-user-obj
      126         no-error .
      127       if not available buf_userobjs_temp-user-obj
      128       then do:
      129         assign
      130           p-object-exist = false
      131         .
      132       end.
      133       else do:
      134         assign
      135           p-object-exist = true
      136         .
      137       end.
      138     end.
      139   end.
      140   procedure userobjs_transfer :
      141     define input  parameter p-callback-handle as handle no-undo .
      142     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      143     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      144     do
      145     on error undo, return error return-value
      146     :
      147       if valid-handle(p-callback-handle) <> true
      148       then do:
      149         message
      150           vss-workfile vss-revision vss-description skip
      151           "Ошибка задания входных параметров" skip
      152           "Неизвестный указатель на процедуру" skip
      153           view-as alert-box error .
      154         undo, return error return-value .
      155       end.
      156       if p-callback-handle :get-signature("userobjs_append") = ""
      157       then do:
      158         message
      159           vss-workfile vss-revision vss-description skip
      160           "Ошибка задания входных параметров" skip
      161           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      162                     ,p-callback-handle :file-name
      163                     ) skip
      164           view-as alert-box error .
      165         undo, return error return-value .
      166       end.
      167       for each buf_userobjs_temp-user-obj
      168       on error undo, return error return-value
      169       :
      170         run userobjs_append in p-callback-handle
      171           (input  buf_userobjs_temp-user-obj.obj-type
      172           ,input  buf_userobjs_temp-user-obj.obj-code
      173           ) .
      174       end.
      175     end.
      176   end procedure.
      177   procedure userobjs_select-one :
      178      define input  parameter parparentproc     as widget-handle no-undo .
      179      define input  parameter p-db-num          as integer   no-undo .
      180      define input  parameter p-user-id         as character no-undo .
      181      define input  parameter p-host-code-obj   as integer   no-undo .
      182      define input  parameter p-obj-type        as character no-undo .
      183      define input  parameter p-obj-code        as integer   no-undo .
      184      define output parameter p-user-select     as logical   no-undo .
      185      define output parameter p-select-obj-type as character no-undo .
      186      define output parameter p-select-obj-code as character no-undo .
      187     do
      188     on error undo, return error return-value
      189     :
      190       run gbl/userobjs.w
      191         (input  parparentproc
      192         ,input  this-procedure :handle
      193         ,input  p-db-num
      194         ,input  p-user-id
      195         ,input  p-host-code-obj
      196         ,input  p-obj-type
      197         ,input  p-obj-code
      198         ,INPUT  "b-sel"
      199         ,output p-user-select
      200         ,output p-select-obj-type
      201         ,output p-select-obj-code
      202         ) .
      203     end.
      204   end.
      205   procedure userobjs_select-many :
      206     define input  parameter parparentproc   as widget-handle no-undo .
      207     define input  parameter p-db-num        as integer   no-undo .
      208     define input  parameter p-user-id       as character no-undo .
      209     define input  parameter p-host-code-obj as integer   no-undo .
      210     define input  parameter p-obj-type      as character no-undo .
      211     define input  parameter p-obj-code      as integer   no-undo .
      212     define output parameter p-user-select   as logical   no-undo .
      213     define variable v-select-obj-type as character no-undo .
      214     define variable v-select-obj-code as integer   no-undo .
      215     do
      216     on error undo, return error return-value
      217     :
      218       run gbl/userobjs.w
      219         (input  parparentproc
      220         ,input  this-procedure :handle
      221         ,input  p-db-num
      222         ,input  p-user-id
      223         ,input  p-host-code-obj
      224         ,input  p-obj-type
      225         ,input  p-obj-code
      226         ,INPUT  "b-sel,b-mark"
      227         ,output p-user-select
      228         ,output v-select-obj-type
      229         ,output v-select-obj-code
      230         ) .
      231     end.
      232   end.
      233   procedure thobjs :
      234      define input        parameter parparentproc     as widget-handle no-undo .
      235      define input        parameter i-bttns           as character     no-undo .
      236      define input        parameter i-list-mode       as character     no-undo.
      237      define input        parameter i-obj-type        as character     no-undo.
      238      define input        parameter i-db-num          as integer       no-undo.
      239      define input        parameter i-host-code       as integer       no-undo.
      240      define input-output parameter p-rid-list        as character     no-undo .
      241   run ref/thobjs.p
      242           ( input parparentproc
      243            ,input  this-procedure :handle
      244           , input i-bttns
      245           , input i-list-mode
      246           , input i-obj-type
      247           , input i-db-num
      248           , input i-host-code
      249           , input-output p-rid-list ) no-error .
      250   end.
      251   define input        parameter parparentproc     as widget-handle no-undo .
      252   define input-output  parameter table for userobjs_temp-user-obj   .
      253   define input        parameter i-bttns             as character     no-undo .
      254   define input        parameter i-list-mode       as character     no-undo.
      255   define input        parameter i-obj-type        as character     no-undo.
      256   define input        parameter i-db-num          as integer       no-undo.
      257   define input        parameter i-host-code       as integer       no-undo.
      258   define input-output parameter p-rid-list        as character     no-undo .
      259   run thobjs in this-procedure
      260   (parparentproc,i-bttns,i-list-mode,i-obj-type,i-db-num,i-host-code, input-output p-rid-list).
