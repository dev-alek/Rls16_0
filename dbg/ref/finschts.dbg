     1030   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1031   FUNCTION mark-string RETURNS CHARACTER
     1032     ( input p-recid as recid, input mark-list as character  ) :
     1033     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1034   END FUNCTION.
     1035   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1036   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1037   procedure fltopend_fltopend :
     1038   define input parameter p-parent-handle as handle no-undo .
     1039   define input parameter p-qh as handle no-undo .
     1040   define input parameter p-flt-open-open-query  as character no-undo .
     1041   define input parameter p-where-cond as character no-undo .
     1042   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1043   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1044   define input parameter p-indexed-reposition as character no-undo .
     1045     do
     1046     on error undo, return error
     1047     :
     1048   define variable v-prepare-string as character no-undo .
     1049   define variable glog as logical no-undo .
     1050   assign
     1051   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1052                      p-where-cond + chr(32)  +
     1053                      p-use-indFIRST-query-tail + chr(32) +
     1054                      p-use-ind-sort-clmn-by + chr(32) +
     1055                      p-indexed-reposition
     1056   .
     1057   assign
     1058   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1059   if not glog
     1060   or error-status:error then do:
     1061     message error-status:get-message(1) view-as alert-box .
     1062     undo, return error .
     1063   end.
     1064   assign
     1065   glog = p-qh:query-open no-error .
     1066   if not glog
     1067   or error-status:error then do:
     1068     message error-status:get-message(1) view-as alert-box .
     1069     undo, return error .
     1070   end.
     1071     end.
     1072   end procedure.
     1073   procedure fltopend_fltfindd :
     1074   define input parameter p-parent-handle as handle no-undo .
     1075   define input parameter p-qh as handle no-undo .
     1076   define input parameter p-rowid as rowid no-undo .
     1077   define input parameter p-next as logical no-undo .
     1078   define input parameter p-lock as integer no-undo .
     1079   define input parameter p-bh as handle no-undo .
     1080   define input parameter p-where-cond as character no-undo .
     1081   define input parameter p-use-index-phrase as character no-undo .
     1082   define variable glog as logical no-undo .
     1083   define variable v-qh as handle no-undo .
     1084   define variable v-bh as handle no-undo .
     1085   define variable v-recid as recid no-undo .
     1086   define variable v-prepare-string as character no-undo .
     1087   do
     1088   on error undo, return error
     1089   on stop undo, return error
     1090   :
     1091     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1092     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1093     create query v-qh.
     1094     v-qh:set-buffers(v-bh).
     1095     v-prepare-string = substitute("for each &1 &2 &3"
     1096                                     ,v-bh:name
     1097                                     ,p-where-cond
     1098                                     ,p-use-index-phrase).
     1099     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1100     if not glog then do:
     1101       delete object v-qh.
     1102       delete object v-bh.
     1103       undo, return error .
     1104     end.
     1105     glog = v-qh:query-open no-error .
     1106     if not glog then do:
     1107       delete object v-qh.
     1108       delete object v-bh.
     1109       undo, return error .
     1110     end.
     1111     if p-next then do:
     1112       v-qh:reposition-to-rowid(p-rowid) no-error .
     1113       glog = v-qh:get-next( p-lock) no-error .
     1114       glog = v-qh:get-next( p-lock) no-error .
     1115       if not glog or v-qh:query-off-end = yes then do:
     1116         glog = v-qh:get-first( p-lock) no-error .
     1117       end.
     1118     end.
     1119     else do:
     1120       glog = v-qh:get-first( p-lock) no-error .
     1121     end.
     1122     v-recid = v-bh:recid no-error .
     1123     delete object v-qh.
     1124     delete object v-bh.
     1125     return string(v-recid) .
     1126   end.
     1127   end procedure.
     1128   procedure fltopend_fltfindq :
     1129   define input parameter p-parent-handle as handle no-undo .
     1130   define input parameter p-qh as handle no-undo .
     1131   define input parameter p-next as logical no-undo .
     1132   define input parameter p-lock as integer no-undo .
     1133   define input parameter p-flt-open-open-query  as character no-undo .
     1134   define input parameter p-where-cond as character no-undo .
     1135   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1136   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1137   define input parameter p-indexed-reposition as character no-undo .
     1138   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1139   define variable glog as logical no-undo .
     1140   define variable v-qh as handle no-undo .
     1141   define variable v-bh as handle no-undo extent 18.
     1142   define variable v-rowid as rowid no-undo extent 18.
     1143   define variable v-ii as integer no-undo .
     1144   define variable v-prepare-string as character no-undo .
     1145   do
     1146   on error undo, return error
     1147   on stop undo, return error
     1148   :
     1149     create query v-qh.
     1150     do v-ii = 1 to p-qh:num-buffers:
     1151       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1152       assign
     1153       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1154       no-error.
     1155       v-qh:add-buffer(v-bh[v-ii]).
     1156     end.
     1157     assign
     1158     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1159                       p-where-cond + chr(32)  +
     1160                       p-use-indFIRST-query-tail + chr(32) +
     1161                       p-use-ind-sort-clmn-by + chr(32) +
     1162                       p-indexed-reposition
     1163     .
     1164     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1165     if not glog then do:
     1166       delete object v-qh.
     1167       do v-ii = 1 to p-qh:num-buffers:
     1168         delete object v-bh[v-ii].
     1169       end.
     1170       undo, return error .
     1171     end.
     1172     glog = v-qh:query-open no-error .
     1173     if not glog then do:
     1174       delete object v-qh.
     1175       do v-ii = 1 to p-qh:num-buffers:
     1176         delete object v-bh[v-ii].
     1177       end.
     1178       undo, return error .
     1179     end.
     1180     if p-next then do:
     1181       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1182       glog = v-qh:get-next( p-lock) no-error .
     1183       glog = v-qh:get-next( p-lock) no-error .
     1184       if not glog or v-qh:query-off-end = yes then do:
     1185         glog = v-qh:get-first( p-lock) no-error .
     1186       end.
     1187     end.
     1188     else do:
     1189       glog = v-qh:get-first( p-lock) no-error .
     1190     end.
     1191     do v-ii = 1 to p-qh:num-buffers:
     1192       assign
     1193       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1194       no-error.
     1195     end.
     1196     delete object v-qh.
     1197     do v-ii = 1 to p-qh:num-buffers:
     1198       delete object v-bh[v-ii].
     1199     end.
     1200   end.
     1201   end procedure.
     1202   define variable filter-point as character no-undo init "finschts" .
     1203   define variable filter-point0 as character no-undo init "finschts" .
     1204   define variable filter-label as character no-undo init "Список банковских счетов" .
     1205   define variable filter-label0 as character no-undo init "Список банковских счетов" .
     1206   define variable sort-column-name as character no-undo .
     1207   define variable print-option as character no-undo.
     1208   define variable vipiska-option as character no-undo.
     1209   DEFINE VARIABLE v-db-num like ub.db.db-num no-undo .
     1210   define variable v-doc-rec as recid no-undo .
     1211   define variable v-rid-list as character no-undo .
     1212   define variable dops as character no-undo format "X(250)".
     1213   define variable dopst as character no-undo format "X(1)".
     1214   define buffer X_curr_sysconf for ub.sysconf.
     1215   define buffer X_clients-host for ub.clients.
     1216   define buffer pos_fin-schet for ub.fin-schet.
     1217   FUNCTION get-bank-short-name RETURNS CHARACTER
     1218     ( BUFFER loc-fin-schet FOR ub.fin-schet )  FORWARD.
     1219   FUNCTION get-cli-name RETURNS CHARACTER
     1220    ( BUFFER loc-fin-schet FOR ub.fin-schet )  FORWARD.
     1221   FUNCTION get-currency RETURNS CHARACTER
     1222     ( BUFFER loc-fin-schet FOR ub.fin-schet )  FORWARD.
     1223   DEFINE MENU MENU-B-print
     1224          MENU-ITEM m_one          LABEL "Один"
     1225          MENU-ITEM m_list         LABEL "Список"        .
     1226   DEFINE MENU MENU-B-vipiska
     1227          MENU-ITEM m_statement    LABEL "Документы выписки"
     1228          MENU-ITEM m_report       LABEL "Отчет в виде выписки".
     1229   DEFINE BUTTON B-add
     1230        LABEL "&Добавить"
     1231        SIZE 10 BY 1.
     1232   DEFINE BUTTON B-bank
     1233        LABEL "&Банк"
     1234        SIZE 10 BY 1.
     1235   DEFINE BUTTON B-chg
     1236        LABEL "&Изменить"
     1237        SIZE 10 BY 1.
     1238   DEFINE BUTTON B-cli
     1239        IMAGE-UP FILE "btn-down-arrow":U
     1240        IMAGE-DOWN FILE "btn-down-arrow":U
     1241        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1242        LABEL "Btn 1"
     1243        SIZE 3 BY 1.
     1244   DEFINE BUTTON B-copy
     1245        LABEL "&Копия"
     1246        SIZE 10 BY 1 TOOLTIP "Скопировать в другие фирмы".
     1247   DEFINE BUTTON B-del
     1248        LABEL "&Удалить"
     1249        SIZE 10 BY 1.
     1250   DEFINE BUTTON B-Help
     1251        LABEL "Помо&щь"
     1252        SIZE 3 BY 1
     1253        BGCOLOR 8 .
     1254   DEFINE BUTTON B-hist
     1255        LABEL "Ис&тория"
     1256        SIZE 3 BY 1.
     1257   DEFINE BUTTON b-lkp
     1258        LABEL "&Просмотр"
     1259        SIZE 10 BY 1.
     1260   DEFINE BUTTON B-mark
     1261        LABEL "&*"
     1262        SIZE 3 BY 1.
     1263   DEFINE BUTTON B-print
     1264        LABEL "Пе&чать"
     1265        SIZE 3 BY 1.
     1266   DEFINE BUTTON b-quit AUTO-END-KEY
     1267        LABEL "&Выход"
     1268        SIZE 10 BY 1
     1269        BGCOLOR 8 .
     1270   DEFINE BUTTON B-sch
     1271        LABEL "&Фильтр"
     1272        SIZE 3 BY 1.
     1273   DEFINE BUTTON b-sel AUTO-GO
     1274        LABEL "Вы&бор"
     1275        SIZE 10 BY 1
     1276        BGCOLOR 8 .
     1277   DEFINE BUTTON B-vipiska
     1278        LABEL "В&ыписка"
     1279        SIZE 10 BY 1.
     1280   DEFINE VARIABLE ED-notes AS CHARACTER
     1281        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1282        SIZE 98 BY 2
     1283        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1284   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1285         VIEW-AS TEXT
     1286        SIZE 6 BY 1
     1287        FGCOLOR 4  NO-UNDO.
     1288   DEFINE VARIABLE sch-c-schet AS CHARACTER FORMAT "X(20)":U
     1289        LABEL "Корр.счету"
     1290        VIEW-AS FILL-IN
     1291        SIZE 22 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1292   DEFINE VARIABLE sch-cli-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
     1293        LABEL "коду держателя"
     1294        VIEW-AS FILL-IN
     1295        SIZE 11 BY .92 NO-UNDO.
     1296   DEFINE VARIABLE sch-code AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1297        LABEL "коду"
     1298        VIEW-AS FILL-IN
     1299        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1300   DEFINE VARIABLE sch-r-schet AS CHARACTER FORMAT "X(20)":U
     1301        LABEL "Расч.счету"
     1302        VIEW-AS FILL-IN
     1303        SIZE 22 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1304   DEFINE VARIABLE RS-cli-type AS CHARACTER
     1305        VIEW-AS RADIO-SET HORIZONTAL
     1306        RADIO-BUTTONS
     1307             "Item 1", "1",
     1308   "Item 1", "2"
     1309        SIZE 19.38 BY 1.04 NO-UNDO.
     1310   DEFINE VARIABLE RS-status_ AS CHARACTER
     1311        VIEW-AS RADIO-SET HORIZONTAL
     1312        RADIO-BUTTONS
     1313             "Item 1", "1",
     1314   "Item 2", "2",
     1315   "Item 3", "3"
     1316        SIZE 33.5 BY 1 NO-UNDO.
     1317   DEFINE QUERY br-schet FOR
     1318         X_fin-schet SCROLLING.
     1319   DEFINE BROWSE br-schet
     1320     QUERY br-schet DISPLAY
     1321         mark-string(recid(X_fin-schet), v-rid-list) FORMAT "X(1)":U
     1322         X_fin-schet.host-code COLUMN-LABEL "Код!фирмы" FORMAT ">>>>>99999":U
     1323         X_fin-schet.code-schet COLUMN-LABEL "Код счета" FORMAT "9999999":U
     1324         X_fin-schet.code-bank COLUMN-LABEL "Код!банка" FORMAT "9999999":U
     1325         get-bank-short-name(buffer X_fin-schet) COLUMN-LABEL "Название банка" FORMAT "X(20)":U
     1326         X_fin-schet.status_ FORMAT "X(8)":U
     1327         X_fin-schet.cli-type + string(X_fin-schet.cli-code) COLUMN-LABEL "Держатель!счета" FORMAT "X(12)":U
     1328         get-cli-name(buffer X_fin-schet) COLUMN-LABEL "Название держателя счета" FORMAT "X(20)":U
     1329         X_fin-schet.r-schet FORMAT "X(20)":U
     1330         X_fin-schet.c-schet FORMAT "X(20)":U
     1331         get-currency(buffer X_fin-schet) COLUMN-LABEL "Вал" FORMAT "X(3)":U
     1332     ENABLE
     1333         X_fin-schet.status_
     1334       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.5 BY 13.33.
     1335   DEFINE FRAME Dialog-Frame
     1336        b-quit AT ROW 1 COL 1
     1337        B-mark AT ROW 1 COL 11
     1338        b-sel AT ROW 1 COL 21
     1339        B-add AT ROW 1 COL 31
     1340        b-lkp AT ROW 1 COL 41
     1341        B-chg AT ROW 1 COL 51
     1342        B-del AT ROW 1 COL 61
     1343        B-vipiska AT ROW 1 COL 71
     1344        B-print AT ROW 1 COL 86
     1345        B-hist AT ROW 1 COL 89
     1346        B-sch AT ROW 1 COL 92
     1347        B-Help AT ROW 1 COL 95
     1348        B-bank AT ROW 2 COL 51
     1349        B-copy AT ROW 2 COL 61
     1350        RS-status_ AT ROW 3 COL 1.5 NO-LABEL
     1351        br-schet AT ROW 4.25 COL 1.38
     1352        ED-notes AT ROW 17.71 COL 1 NO-LABEL
     1353        sch-code AT ROW 19.79 COL 16.38 COLON-ALIGNED
     1354        sch-c-schet AT ROW 19.79 COL 36.75 COLON-ALIGNED
     1355        sch-r-schet AT ROW 19.79 COL 71.25 COLON-ALIGNED
     1356        RS-cli-type AT ROW 20.88 COL 30.5 NO-LABEL
     1357        B-cli AT ROW 20.96 COL 50.75
     1358        sch-cli-code AT ROW 21 COL 16.38 COLON-ALIGNED
     1359        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1360        "ПОИСК ПО" VIEW-AS TEXT
     1361             SIZE 9.25 BY 1 AT ROW 19.79 COL 1.5
     1362             FGCOLOR 4
     1363        SPACE(88.49) SKIP(1.24)
     1364       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1365            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1366            TITLE "Список банковских счетов"
     1367            CANCEL-BUTTON b-quit.
     1368   ASSIGN
     1369          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1370          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1371   ASSIGN
     1372          B-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-print:HANDLE.
     1373   ASSIGN
     1374          B-vipiska:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-vipiska:HANDLE.
     1375   ASSIGN
     1376          br-schet:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1.
     1377   ON GO OF FRAME Dialog-Frame
     1378   DO:
     1379     p-rid-list = v-rid-list.
     1380   END.
     1381   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1382   DO:
     1383   define variable loc#log as logical no-undo.
     1384   define variable loc-doc-rec as recid no-undo .
     1385   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1386   do:
     1387     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1388       (input  v-cntxt-db-num
     1389       ,input  v-cntxt-userid
     1390       ,input  0
     1391       ,input  'actn_fin-bank-accounts_add-def':U
     1392       ,input  'firm':U
     1393       ,input  p-curr-host-code
     1394       ,input  '':U
     1395       ,input  0
     1396       ,input  0
     1397       ,input  0
     1398       ,input  0
     1399       ,input  true
     1400       ,output loc#log
     1401       )  .
     1402   end.
     1403   if not loc#log then return no-apply.
     1404   run ref/finschti.w
     1405                 (
     1406                    input parParentProc
     1407                   ,input p-curr-host-code
     1408                   ,input 'ДОБАВЛЕНИЕ':U
     1409                   ,input p-curr-host-code
     1410                   ,input 0
     1411                   ,input (if p-mode = "bank":U
     1412                           then p-code-bank
     1413                           else 0)
     1414                   ,input (if p-mode = 'орг':U
     1415                           or p-mode = "cmp-host":U
     1416                           then p-cli-type
     1417                           else "":U)
     1418                   ,input (if p-mode = 'орг':U
     1419                           or p-mode = "cmp-host":U
     1420                           then p-cli-code
     1421                           else 0)
     1422                   ,input (if p-mode = "currency":U
     1423                           then p-curr-code
     1424                           else 0)
     1425                   ,input-output loc-doc-rec
     1426                               ) no-error
     1427   .
     1428   if loc-doc-rec <> ? then do:
     1429     RUn OpenBR in this-procedure ( input yes, input no, input no).
     1430     reposition br-schet to recid loc-doc-rec no-error.
     1431     if error-status:error then do:                           find first pos_fin-schet no-lock where                                   recid(pos_fin-schet) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи БАНКОВСКИЙ СЧЕТ" skip                            string(if avail pos_fin-schet                                     then  substitute("Код фирмы: &1, вн. код счета &2"                                                     , pos_fin-schet.host-code                                                      , pos_fin-schet.code-schet)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     1432   end.
     1433   apply "entry" to br-schet in frame Dialog-Frame.
     1434   apply "value-changed" to br-schet in frame Dialog-Frame.
     1435   END.
     1436   ON CHOOSE OF B-bank IN FRAME Dialog-Frame
     1437   DO:
     1438   define variable loc-doc-rec as recid no-undo .
     1439   if not available X_fin-schet then return no-apply.
     1440   run ref/finbanki.w
     1441                 (
     1442                    input parParentProc
     1443                   ,input p-curr-host-code
     1444                   ,input 'ПРОСМОТР':U
     1445                   ,input X_fin-schet.host-code
     1446                   ,input X_fin-schet.code-bank
     1447                   ,input-output loc-doc-rec
     1448                               )
     1449   .
     1450   apply "entry" to br-schet in frame Dialog-Frame.
     1451   END.
     1452   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1453   DO:
     1454   define variable loc#log as logical no-undo.
     1455   define variable loc-doc-rec as recid no-undo .
     1456   if not available X_fin-schet then return no-apply.
     1457   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1458   do:
     1459     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1460       (input  v-cntxt-db-num
     1461       ,input  v-cntxt-userid
     1462       ,input  0
     1463       ,input  'actn_fin-bank-accounts_add-def':U
     1464       ,input  'firm':U
     1465       ,input  p-curr-host-code
     1466       ,input  '':U
     1467       ,input  0
     1468       ,input  0
     1469       ,input  0
     1470       ,input  0
     1471       ,input  true
     1472       ,output loc#log
     1473       )  .
     1474   end.
     1475   if not loc#log then return no-apply.
     1476   assign
     1477   loc-doc-rec = recid(X_fin-schet).
     1478   run ref/finschti.w
     1479                 (
     1480                    input parParentProc
     1481                   ,input p-curr-host-code
     1482                   ,input 'ИЗМЕНЕНИЕ':U
     1483                   ,input X_fin-schet.host-code
     1484                   ,input X_fin-schet.code-schet
     1485                   ,input X_fin-schet.code-bank
     1486                   ,input X_fin-schet.cli-type
     1487                   ,input X_fin-schet.cli-code
     1488                   ,input X_fin-schet.curr-code
     1489                   ,input-output loc-doc-rec
     1490                               )  no-error
     1491   .
     1492   if loc-doc-rec <> ? then do:
     1493     reposition br-schet to recid loc-doc-rec no-error.
     1494     if error-status:error then do:                           find first pos_fin-schet no-lock where                                   recid(pos_fin-schet) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи БАНКОВСКИЙ СЧЕТ" skip                            string(if avail pos_fin-schet                                     then  substitute("Код фирмы: &1, вн. код счета &2"                                                     , pos_fin-schet.host-code                                                      , pos_fin-schet.code-schet)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     1495   end.
     1496   apply "entry" to br-schet in frame Dialog-Frame.
     1497   apply "value-changed" to br-schet in frame Dialog-Frame.
     1498   END.
     1499   ON CHOOSE OF B-cli IN FRAME Dialog-Frame
     1500   DO:
     1501   define variable ref-list as character no-undo.
     1502   define variable ref-rec as recid no-undo.
     1503   define buffer buf_clients for ub.clients.
     1504     run ref/cli-all.w (
     1505                      input parParentProc
     1506                     ,input "b-sel"
     1507                     ,input RS-cli-type
     1508                     ,input ?
     1509                     ,input ?
     1510                     ,input ?
     1511                     ,input ?
     1512                     ,input "without-obj":U
     1513                     ,output ref-list) .
     1514       if ref-list = "" then   do:
     1515         apply "entry" to b-cli in frame Dialog-Frame.
     1516         return no-apply.
     1517        end.
     1518       ref-rec = integer( ref-list ).
     1519       FIND FIRST buf_clients WHERE recid (buf_clients) = ref-rec NO-LOCK .
     1520       if NOT (buf_clients.obj-type = 'орг':U
     1521               or
     1522               buf_clients.obj-type = 'чел':U ) then do:
     1523         message
     1524         "Выберите контрагента типа" 'орг':U "или" 'чел':U
     1525         view-as alert-box error .
     1526         return no-apply.
     1527       end.
     1528       assign
     1529       RS-cli-type =  buf_clients.obj-type
     1530       sch-cli-code = buf_clients.obj-code
     1531       .
     1532       display
     1533       RS-cli-type
     1534       sch-cli-code
     1535       with frame Dialog-Frame.
     1536   apply "return":u to sch-cli-code in frame Dialog-Frame .
     1537   END.
     1538   ON CHOOSE OF B-copy IN FRAME Dialog-Frame
     1539   DO:
     1540     run proc-copy in this-procedure no-error.
     1541     if error-status:error then return no-apply.
     1542   END.
     1543   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1544   DO:
     1545     run proc-b-del in this-procedure no-error.
     1546     if error-status:error then return no-apply.
     1547   END.
     1548   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     1549   DO:
     1550   define variable loc-doc-rec as recid no-undo .
     1551   define variable v-rid-list as character no-undo.
     1552     if NOT available X_fin-schet then do:
     1553       message
     1554       "Неправильно выбран банк."
     1555       view-as alert-box ERROR.
     1556       return no-apply.
     1557     end.
     1558     loc-doc-rec = recid (X_fin-schet).
     1559     .
     1560     run ref/fincscts.w
     1561                   (
     1562                    input parParentProc
     1563                   ,input p-curr-host-code
     1564                   ,input "":U
     1565                   ,input "one":U
     1566                   ,input X_fin-schet.host-code
     1567                   ,input X_fin-schet.cli-type
     1568                   ,input X_fin-schet.cli-code
     1569                   ,input X_fin-schet.curr-code
     1570                   ,input X_fin-schet.code-bank
     1571                   ,input X_fin-schet.code-schet
     1572                   ,input-output v-rid-list
     1573                                 )
     1574     .
     1575     reposition br-schet to recid loc-doc-rec no-error.
     1576     apply "entry" to br-schet in frame Dialog-Frame.
     1577     apply "value-changed" to br-schet in frame Dialog-Frame.
     1578   END.
     1579   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1580   DO:
     1581   define variable loc-doc-rec as recid no-undo .
     1582     if NOT available X_fin-schet then do:
     1583       message
     1584       "Неправильно выбран банк."
     1585       view-as alert-box ERROR.
     1586       return no-apply.
     1587     end.
     1588     loc-doc-rec = recid (X_fin-schet).
     1589     .
     1590     run ref/finschti.w
     1591                   (
     1592                    input parParentProc
     1593                   ,input p-curr-host-code
     1594                   ,input 'ПРОСМОТР':U
     1595                   ,input X_fin-schet.host-code
     1596                   ,input X_fin-schet.code-schet
     1597                   ,input X_fin-schet.code-bank
     1598                   ,input X_fin-schet.cli-type
     1599                   ,input X_fin-schet.cli-code
     1600                   ,input X_fin-schet.curr-code
     1601                   ,input-output loc-doc-rec
     1602                                 )
     1603     .
     1604     reposition br-schet to recid loc-doc-rec no-error.
     1605     apply "entry" to br-schet in frame Dialog-Frame.
     1606     apply "value-changed" to br-schet in frame Dialog-Frame.
     1607   END.
     1608   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1609   DO:
     1610   define variable loc#log as logical no-undo .
     1611     if available X_fin-schet then do:
     1612   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1613   define variable v-str-recid14 as character no-undo .
     1614   define variable v-num-entry14 as integer   no-undo .
     1615   assign
     1616     v-str-recid14 = trim( string( recid( X_fin-schet ) , "->>>>>>>>>>>9":U ) )
     1617     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1618   .
     1619   if v-num-entry14 > 0 then do:
     1620     assign
     1621       entry( v-num-entry14, v-rid-list ) = "":U
     1622       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1623     .
     1624   end.
     1625   else do:
     1626     assign
     1627       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1628     .
     1629   end.
     1630       loc#log = br-schet:refresh() .
     1631       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1632           loc#log = br-schet:select-next-row ().
     1633           apply "VALUE-CHANGED" to br-schet in frame Dialog-Frame.
     1634       end.
     1635       if num-entries( v-rid-list ) = 0
     1636       then
     1637           hide mark-num in frame Dialog-Frame.
     1638       else
     1639           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1640     end.
     1641     apply "entry" to br-schet in frame Dialog-Frame.
     1642   END.
     1643   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1644   DO:
     1645     if not avail X_fin-schet then return no-apply.
     1646     if print-option = '':U then do:
