     1681     end.
     1682     if vipiska-option = '':U then return no-apply.
     1683     RUN proc-b-vipiska IN THIS-PROCEDURE ( INPUT vipiska-option ) NO-ERROR.
     1684     IF ERROR-STATUS:ERROR THEN do:
