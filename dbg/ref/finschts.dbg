     2523               )
     2524           then do:
     2525             find first buf_temp-browse-handle
     2526               where buf_temp-browse-handle.browse-type   = 'width':u
     2527                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2528               no-error .
