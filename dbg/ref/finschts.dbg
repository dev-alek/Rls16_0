     2222             or error-status :get-message(1) <> ""
     2223             then do:
     2224               undo move_block, retry move_block .
     2225             end.
     2226           end.
     2227         end.
     2228       end.
     2229       else do:
     2230         for each buf_temp-diasize-handle
     2231         on error undo move_block, retry move_block
     2232         :
     2233           assign
     2234             v-object-handle = buf_temp-diasize-handle.handle-value
     2235           .
     2236           if v-object-handle <> v-diasize-resize-button
     2237           then do:
     2238             assign
     2239               v-object-handle :row = v-object-handle :row + p-change-value
     2240               no-error .
