      804   procedure prn-lib-reportviewer :
      805     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      806     define input parameter p-report-name-html as character no-undo .
      807     define input parameter p-param        as character no-undo .
      808     define variable v-excel           as character no-undo init 'TRUE' .
      809     define variable v-value-character as character no-undo .
      810     define variable v-value-integer   as character no-undo .
      811     define variable v-value-date      as date      no-undo .
      812     define variable v-value-decimal   as decimal   no-undo .
      813     define variable rep-excel         as logical   no-undo .
      814     define variable excel-string      as character no-undo .
      815     define variable v-param-type      as character no-undo .
      816     define variable v-tth             as handle    no-undo .
      817     run adm/shattri.p (
      818       input "get":U
      819       ,input  ""
      820       ,input  0
      821       ,input  'report-glob':U
      822       ,input  'rep-excel':U
      823       ,output v-value-character
      824       ,output v-value-date
      825       ,output v-value-decimal
      826       ,output v-value-integer
      827       ,output rep-excel
      828       ,output v-param-type
      829       ,INPUT-OUTPUT table-handle v-tth
      830       )  .
      831     if rep-excel then v-excel = "TRUE" .
      832     else v-excel = "FALSE" .
      833     if p-param eq ""
      834     then
      835        p-param = "EXCEL:" + v-excel.
      836     else
      837        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      838     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      839   end procedure.
      840   function diff-list returns character (
      841     input parfirst-list  as character,
      842     input parsecond-list as character,
      843     input pardelim       as character).
      844     if pardelim = ""
      845     or pardelim = ?
      846     then do:
      847       assign
      848         pardelim = ","
      849       .
      850     end.
      851     def var ind as integer no-undo .
      852     def var v-elem as character no-undo .
      853     def var v-result-list as character no-undo init "".
      854     def var v-num-parfirst-list as integer no-undo .
      855     assign
      856       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      857     .
      858     do ind = 1 to v-num-parfirst-list
      859     :
      860       assign
      861         v-elem = entry(ind, parfirst-list, pardelim)
      862       .
      863       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      864         assign
      865           v-result-list = v-result-list
      866                         + (if v-result-list > "" then pardelim else "")
      867                         + v-elem
      868         .
      869       end.
      870     end.
      871     return v-result-list .
      872   end function.
      873   function add-list returns character (
      874    input parfirst-list  as character,
      875    input parsecond-list as character,
      876    input pardelim       as character).
      877     if pardelim = ""
      878     or pardelim = ?
      879     then do:
      880       assign
      881         pardelim = ","
      882       .
      883     end.
      884     def var ind as integer no-undo .
      885     def var v-elem as character no-undo .
      886     def var v-result-list as character no-undo init "".
      887     def var v-num-parfirst-list as integer no-undo .
      888     assign
      889       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      890     .
      891     do ind = 1 to v-num-parfirst-list
      892     :
      893       assign
      894         v-elem = entry(ind, parfirst-list, pardelim)
      895       .
      896       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      897         assign
      898           v-result-list = v-result-list
      899                         + (if v-result-list > "" then pardelim else "")
      900                         + v-elem
      901         .
      902       end.
      903     end.
      904     def var v-num-parsecond-list as integer no-undo .
      905     assign
      906       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      907     .
      908     do ind = 1 to v-num-parsecond-list
      909     :
      910       assign
      911         v-elem = entry(ind, parsecond-list, pardelim)
      912       .
      913       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      914         assign
      915           v-result-list = v-result-list
      916                         + (if v-result-list > "" then pardelim else "")
      917                         + v-elem
      918         .
      919       end.
      920     end.
      921     return v-result-list .
      922   end function.
      923   function cross-list returns character (
      924    input parfirst-list  as character,
      925    input parsecond-list as character,
      926    input pardelim       as character).
      927     if pardelim = ""
      928     or pardelim = ?
      929     then do:
      930       assign
      931         pardelim = ","
      932       .
      933     end.
      934     def var ind as integer no-undo .
      935     def var v-elem as character no-undo .
      936     def var v-result-list as character no-undo init "".
      937     def var v-num-parfirst-list as integer no-undo .
      938     assign
      939       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      940     .
      941     do ind = 1 to v-num-parfirst-list
      942     :
      943       assign
      944         v-elem = entry(ind, parfirst-list, pardelim)
      945       .
      946       if lookup(v-elem, v-result-list, pardelim) = 0
      947       and lookup(v-elem, parsecond-list, pardelim) > 0
      948       then do:
      949         assign
      950           v-result-list = v-result-list
      951                         + (if v-result-list > "" then pardelim else "")
      952                         + v-elem
      953         .
      954       end.
      955     end.
      956     return v-result-list .
      957   end function.
      958   function radio-label returns character (
      959    input par-rs-value  as character,
      960    input par-rs-radio-buttons as character)
      961    .
      962    DEFINE variable v-result-label as character no-undo.
      963    assign
      964    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      965                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      966                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      967                             ), par-rs-radio-buttons
      968                           )
      969    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      970    .
      971   return v-result-label.
      972   end function.
      973   function m-radio-label returns character (
      974    input par-rs-value  as character,
      975    input par-rs-radio-buttons as character,
      976    input par-delim as character
      977    )
      978    .
      979    DEFINE variable v-result-label as character no-undo.
      980    assign
      981    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      982                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      983                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      984                             ), par-rs-radio-buttons, par-delim
      985                           )
      986    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      987    .
      988   return v-result-label.
      989   end function.
      990   FUNCTION mixlist returns character
      991   (
      992    input parfirst-list  as character
      993    ,input parsecond-list as character
      994    ,input pardelim       as character
      995    ,input pardelim-result as character ) :
      996     if pardelim = ""
      997     or pardelim = ?
      998     then do:
      999       assign
     1000         pardelim = ","
     1001       .
     1002     end.
     1003     def var ind as integer no-undo .
     1004     def var v-elem1 as character no-undo .
     1005     def var v-elem2 as character no-undo .
     1006     def var v-result-list as character no-undo init "".
     1007     do ind = 1 to num-entries(parfirst-list, pardelim)
     1008     :
     1009       assign
     1010         v-elem1 = entry(ind, parfirst-list, pardelim)
     1011         v-elem2 = entry(ind, parsecond-list, pardelim)
     1012       .
     1013         assign
     1014           v-result-list = v-result-list
     1015                         + (if v-result-list > "" then pardelim-result else "")
     1016                         + v-elem1 + pardelim-result + v-elem2
     1017         .
     1018     end.
     1019     return v-result-list .
     1020   END FUNCTION.
     1021   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1022     define variable v-cntxt-db-num        as integer   no-undo .
     1023     define variable v-cntxt-userid        as character no-undo .
     1024     define variable v-cntxt-level         as character no-undo .
     1025     define variable v-cntxt-host-code-obj as integer   no-undo .
     1026     define variable v-cntxt-obj-type      as character no-undo .
     1027     define variable v-cntxt-obj-code      as integer   no-undo .
     1028     define variable v-cntxt-db-num-obj    as integer   no-undo .
