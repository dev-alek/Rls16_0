     6328       RUn OpenBR in this-procedure ( input yes, input no, input no).
     6329       reposition br-schet to recid loc-doc-rec no-error.
     6330       if error-status:error then do:                           find first pos_fin-schet no-lock where                                   recid(pos_fin-schet) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи БАНКОВСКИЙ СЧЕТ" skip                            string(if avail pos_fin-schet                                     then  substitute("Код фирмы: &1, вн. код счета &2"                                                     , pos_fin-schet.host-code                                                      , pos_fin-schet.code-schet)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     6331     end.
     6332     else do:
     6333       display
     6334       X_fin-schet.status_
     6335       with browse br-schet.
     6336     end.
     6337   end.
     6338   END PROCEDURE.
     6339   PROCEDURE proc-b-print :
     6340   DEFINE INPUT PARAMETER loc-option as character no-undo.
     6341   if loc-option = '':U then return error.
     6342   CASE loc-option:
     6343   when 'ONE':U then do:
     6344     run proc-print-one in this-procedure .
     6345   end.
     6346   when 'LIST':U then do:
     6347     run proc-print-list no-error.
     6348   end.
     6349   end case.
     6350   loc-option = ''.
     6351   END PROCEDURE.
     6352   PROCEDURE proc-b-sch :
     6353   assign
     6354     tbl = 'fin-schet'
     6355     join-tbl = 'X_fin-schet'
     6356     fld = ""
     6357     lab = ""
     6358     spr = ""
     6359     dim = '0'
     6360     .
     6361   run fltfield-add in this-procedure('host-code', 'Кoд фирмы', '',
     6362   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6363   run fltfield-add in this-procedure('code-schet', 'Код счета', '',
     6364   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6365   run fltfield-add in this-procedure('code-bank', 'Код банка', '',
     6366   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6367   run fltfield-add in this-procedure('cli-type*cli-code', 'Держатель счета', 'cli',
     6368   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6369   run fltfield-add in this-procedure('c-schet', 'Коррсчет', '',
     6370   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6371   run fltfield-add in this-procedure('dop1', 'Доп к назв.держ.счета', '',
     6372   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6373   run fltfield-add in this-procedure('dop2', 'Доп к назв.банка', '',
     6374   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6375   run fltfield-add in this-procedure('r-schet', 'Р/счет', '',
     6376   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6377   run fltfield-add in this-procedure('curr-code', '', 'curr',
     6378   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6379   run fltfield-add in this-procedure('PS', 'Примечание', '',
     6380   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6381   run fltfield-add in this-procedure('status_', '', '',
     6382   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6383   Filter-Block:
     6384   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     6385       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     6386       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     6387     run gbl/filter.w ( INPUT parparentproc
     6388                      , INPUT (filter-point + chr(4) + filter-label)
     6389                      , INPUT tbl
     6390                      , INPUT join-tbl
     6391                      , INPUT fld
     6392                      , INPUT lab
     6393                      , INPUT spr
     6394                      , INPUT dim ).
     6395     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     6396   END.
     6397   END PROCEDURE.
     6398   PROCEDURE proc-b-vipiska :
     6399   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     6400   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     6401   CASE p-option :
     6402     WHEN 'report' THEN DO:
     6403       run rep/fextract.p ( input parparentproc
     6404                          , input X_fin-schet.host-code
     6405                          , input X_fin-schet.code-schet) no-error.
     6406     END.
     6407     WHEN 'statement' THEN DO:
     6408      run ref/finsttms.w (
     6409                  input parparentproc
     6410                 ,input v-cntxt-host-code-obj
     6411                 ,input "":U
     6412                 ,input 'code-schet':U
     6413                 ,input X_fin-schet.host-code
     6414                 ,input '':U
     6415                 ,input '':U
     6416                 ,input '':U
     6417                 ,input ?
     6418                 ,input ?
     6419                 ,input X_fin-schet.code-bank
     6420                 ,input X_fin-schet.code-schet
     6421                 ,input X_fin-schet.curr-code
     6422                 ,input-output v-rid-list).
     6423     END.
     6424   END CASE.
     6425   END PROCEDURE.
     6426   PROCEDURE proc-br-schet :
     6427     if b-sel:sensitive in frame Dialog-Frame then
     6428         if b-mark:sensitive then
     6429             apply "choose" to b-mark in frame Dialog-Frame.
     6430         else
     6431             apply "choose" to b-sel in frame Dialog-Frame.
     6432     else
     6433         if b-lkp:sensitive then
     6434             apply "choose" to b-lkp in frame Dialog-Frame.
     6435   END PROCEDURE.
     6436   PROCEDURE proc-copy :
     6437   define variable p-fin-code as integer no-undo .
     6438   define variable p-out-host-code like ub.sysconf.host-code no-undo.
     6439   define variable firm-rid-list as char no-undo.
     6440   define variable p-ok as logical no-undo .
     6441   define variable ii as integer no-undo .
     6442   define variable Jj as integer no-undo .
     6443   define variable kk as integer no-undo .
     6444   define variable p-ret as logical no-undo .
     6445   define variable glog as logical no-undo.
     6446   define variable v-out-host-code like ub.sysconf.host-code no-undo .
     6447   define variable v-recid-schet as recid no-undo.
     6448   define variable v-recid-bank as recid no-undo.
     6449   define variable v-new-rid-list as character no-undo .
     6450   define variable v-final-rid-list as character no-undo .
     6451   define variable v-stay-doc-rec as recid no-undo.
     6452   define buffer buf_sysconf  for ub.sysconf.
     6453   define buffer buf_fin-bank for ub.fin-bank.
     6454   define buffer buf_fin-schet for ub.fin-schet.
     6455   define buffer buf2_fin-bank for ub.fin-bank.
     6456   define buffer buf2_fin-schet for ub.fin-schet.
     6457   define variable vss-include-info61 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6458   do:
     6459     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6460       (input  v-cntxt-db-num
     6461       ,input  v-cntxt-userid
     6462       ,input  0
     6463       ,input  'actn_fin-bank-accounts_add-copy':U
     6464       ,input  'firm':U
     6465       ,input  p-host-code
     6466       ,input  '':U
     6467       ,input  0
     6468       ,input  0
     6469       ,input  0
     6470       ,input  0
     6471       ,input  true
     6472       ,output glog
     6473       )  .
     6474   end.
     6475   if not glog then  return .
     6476   if num-entries(v-rid-list) = 0 then do:
     6477     message
     6478     "Не отмечены записи для копирования !!!"
     6479     view-as alert-box error.
     6480     return error.
     6481   end.
     6482   assign
     6483   v-stay-doc-rec = recid(X_fin-schet)
     6484   .
     6485   run adm/sconfs.w (
     6486                 input parparentproc
     6487               , input "b-mark,b-sel":U
     6488               , input no
     6489               , input p-curr-host-code
     6490               , output v-out-host-code
     6491               , input-output firm-rid-list) .
     6492   if num-entries(firm-rid-list) = 0 then do:
     6493    message "Не выбрана фирмы для копирования !!!" .
     6494    return error.
     6495   end.
     6496   message
     6497   "Вы отметили " num-entries(firm-rid-list) " фирмы. " skip
     6498   "Скопировать выбранные счета в эти фирмы ?"
     6499   view-as alert-box question
     6500   buttons yes-no
     6501   update p-ok.
     6502   kk = 0.
     6503   if p-ok = false then return.
     6504   _ii:
     6505   repeat ii = 1 to num-entries(firm-rid-list) :
     6506     find first buf_sysconf no-lock where
     6507               recid(buf_sysconf) = integer(entry(ii, firm-rid-list)) no-error .
     6508     if not available buf_sysconf then next _ii.
     6509     if buf_sysconf.host-code = p-host-code then do:
     6510       message
     6511       "Нельзя скопировать счета в свою собственную фирму" buf_sysconf.host-code
     6512       view-as alert-box error .
     6513       next _ii.
     6514     end.
     6515     if buf_sysconf.firm-db-num <> X_sysconf.firm-db-num then do:
     6516       message
     6517       "Нельзя скопировать счета на фирму" buf_sysconf.host-code  skip
     6518       "Текущая БД " v-db-num "Главная БД данной фирмы" buf_sysconf.firm-db-num
     6519       view-as alert-box error .
     6520       next _ii.
     6521     end.
     6522   define variable vss-include-info62 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6523   do:
     6524     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6525       (input  v-cntxt-db-num
     6526       ,input  v-cntxt-userid
     6527       ,input  0
     6528       ,input  'actn_fin-bank-accounts_add-copy':U
     6529       ,input  'firm':U
     6530       ,input  buf_sysconf.host-code
     6531       ,input  '':U
     6532       ,input  0
     6533       ,input  0
     6534       ,input  0
     6535       ,input  0
     6536       ,input  no
     6537       ,output glog
     6538       )  .
     6539   end.
     6540     if not glog then do:
     6541       message
     6542       "Нельзя скопировать счета на фирму" buf_sysconf.host-code  skip
     6543       "У Вас нет прав на добавление банков и банковских счетов в фирме" buf_sysconf.host-code
     6544       view-as alert-box error .
     6545       next _ii.
     6546     end.
     6547     _rr:
     6548     repeat jj = 1 to num-entries(v-rid-list) :
     6549       for each buf_fin-schet where
     6550             recid(buf_fin-schet) =  integer(entry(jj, v-rid-list)):
     6551         if buf_fin-schet.cli-type = 'орг':U
     6552         AND buf_fin-schet.cli-code = buf_sysconf.host-code then do:
     6553           message
     6554           "Нельзя скопировать счета, для которых фирма является держателем счета" buf_sysconf.host-code
     6555           view-as alert-box error .
     6556           assign
     6557           v-new-rid-list = v-new-rid-list + (if v-new-rid-list = "":U then "":U else chr(44)) + entry(jj, v-rid-list)
     6558           .
     6559           next _rr.
     6560         end.
     6561         if buf_fin-schet.status_ = 'удал':U then do:
     6562           message
     6563           "Нельзя скопировать счета" buf_fin-schet.code-schet "на фирму" buf_sysconf.host-code  skip
     6564           "Счет имеет статус" 'удал':U "в фирме" p-host-code
     6565           view-as alert-box error .
     6566           assign
     6567           v-new-rid-list = v-new-rid-list + (if v-new-rid-list = "":U then "":U else chr(44)) + entry(jj, v-rid-list)
     6568           .
     6569           next _rr.
     6570         end.
     6571         find first buf_fin-bank no-lock where
     6572                   buf_fin-bank.host-code = p-host-code
     6573               AND buf_fin-bank.code-bank = buf_fin-schet.code-bank no-error .
     6574         if not available buf_fin-bank then next _rr.
     6575         find first buf2_fin-bank no-lock where
     6576                   buf2_fin-bank.host-code = buf_sysconf.host-code
     6577               AND buf2_fin-bank.bik = buf_fin-bank.bik
     6578               AND buf2_fin-bank.cor-acc = buf_fin-bank.cor-acc no-error .
     6579         if not available buf2_fin-bank then do:
     6580           assign
     6581           v-recid-bank = ?.
     6582           run ref/finbank1.p (
     6583           input-output v-recid-bank
     6584           ,input 'ДОБАВЛЕНИЕ':U
     6585           ,input no
     6586           ,input "bik"
     6587           ,input "":U
     6588           ,input buf_sysconf.host-code
     6589           ,input 0
     6590           ,input buf_fin-bank.addres
     6591           ,input buf_fin-bank.bank-city
     6592           ,input buf_fin-bank.addres1
     6593           ,input buf_fin-bank.bank-name
     6594           ,input buf_fin-bank.bik
     6595           ,input buf_fin-bank.cor-acc
     6596           ,input buf_fin-bank.e-mail
     6597           ,input buf_fin-bank.fax
     6598           ,input buf_fin-bank.inn
     6599           ,input buf_fin-bank.kpp
     6600           ,input buf_fin-bank.licenz
     6601           ,input buf_fin-bank.okato
     6602           ,input buf_fin-bank.okonx
     6603           ,input buf_fin-bank.okpo
     6604           ,input buf_fin-bank.otdel
     6605           ,input buf_fin-bank.phone
     6606           ,input (substitute("@Копирование с фирмы &1@ &2", p-host-code, buf_fin-bank.PS))
     6607           ,input buf_fin-bank.rkc
     6608           ,input buf_fin-bank.short-name
     6609           ,input buf_fin-bank.cl-bank
     6610           )
     6611           no-error.
     6612           if error-status:error then do:
     6613             assign
     6614             v-new-rid-list = v-new-rid-list + (if v-new-rid-list = "":U then "":U else chr(44)) + entry(jj, v-rid-list)
     6615             .
     6616             next _rr.
     6617           end.
     6618           find first buf2_fin-bank no-lock where
     6619                     recid(buf2_fin-bank) = v-recid-bank no-error.
     6620         end.
     6621         if available buf2_fin-bank then do:
     6622           if buf2_fin-bank.status_ = 'удал':U then do:
     6623             message
     6624             "Нельзя скопировать счета" buf_fin-schet.code-schet "на фирму" buf_sysconf.host-code  skip
     6625             "Банк счета имеет статус" 'удал':U "в фирме" buf_sysconf.host-code
     6626             view-as alert-box error .
     6627             assign
     6628             v-new-rid-list = v-new-rid-list + (if v-new-rid-list = "":U then "":U else chr(44)) + entry(jj, v-rid-list)
     6629             .
     6630             next _rr.
     6631           end.
     6632           find first buf2_fin-schet no-lock where
     6633                       buf2_fin-schet.host-code      = buf_sysconf.host-code
     6634                   AND buf2_fin-schet.code-bank      = buf2_fin-bank.code-bank
     6635                   AND buf2_fin-schet.c-schet      = buf_fin-schet.c-schet
     6636                   AND buf2_fin-schet.r-schet      = buf_fin-schet.r-schet no-error.
     6637           if not available buf2_fin-schet then do:
     6638             assign
     6639             v-recid-schet = ?.
     6640             run ref/finscht1.p (
     6641             input-output v-recid-schet
     6642             ,input 'ДОБАВЛЕНИЕ':U
     6643             ,input no
     6644             ,input "r-schet"
     6645             ,input buf_sysconf.host-code
     6646             ,input 0
     6647             ,input buf_fin-schet.c-schet
     6648             ,input buf_fin-schet.cli-type
     6649             ,input buf_fin-schet.cli-code
     6650             ,input buf2_fin-bank.code-bank
     6651             ,input buf_fin-schet.curr-code
     6652             ,input buf_fin-schet.dop1
     6653             ,input buf_fin-schet.dop2
     6654             ,input buf_fin-schet.r-schet
     6655             ,input (substitute("@Копирование с фирмы &1@ &2", p-host-code, buf_fin-schet.PS))
     6656             )
     6657             no-error.
     6658             find first buf2_fin-schet no-lock where
     6659                       recid(buf2_fin-schet) = v-recid-schet no-error .
     6660             if available buf2_fin-schet then do:
     6661               assign
     6662               kk = kk + 1
     6663               .
     6664             end.
     6665             else do:
     6666               assign
     6667               v-new-rid-list = v-new-rid-list + (if v-new-rid-list = "":U then "":U else chr(44)) + entry(jj, v-rid-list)
     6668               .
     6669             end.
     6670           end.
     6671         end.
     6672       end.
     6673     end.
     6674     assign
     6675     v-final-rid-list = cross-list(v-rid-list, v-new-rid-list, chr(44))
     6676     .
     6677   end.
     6678   v-rid-list = v-final-rid-list.
     6679   run OpenBr in this-procedure ( input yes, input no, input no).
     6680   reposition br-schet to recid v-stay-doc-rec no-error.
     6681   message
     6682   "Скопировано " kk  "записей" view-as alert-box .
     6683   END PROCEDURE.
     6684   PROCEDURE proc-find-c-schet :
     6685   define input parameter p-next as logical no-undo.
     6686   define input parameter p-c-schet like ub.fin-schet.c-schet no-undo.
     6687   display
     6688   "0":U @ sch-code
     6689   "0":U @ sch-cli-code
     6690   "":U @ sch-r-schet
     6691   with frame Dialog-Frame.
     6692   assign
     6693   p-c-schet = replace(p-c-schet, chr(34), "":U)
     6694   p-c-schet = replace(p-c-schet, chr(39), chr(39) + chr(39))
     6695   p-c-schet = chr(34) + p-c-schet + chr(34).
     6696   run OpenBr in this-procedure
     6697       (input false
     6698       ,input p-next
     6699       ,input substitute("and X_fin-schet.c-schet   begins &1 "
     6700         , p-c-schet)
     6701       ).
     6702   apply "entry":u to sch-c-schet in frame Dialog-Frame .
     6703   END PROCEDURE.
     6704   PROCEDURE proc-find-cli-code :
     6705   define input parameter p-next as logical no-undo.
     6706   define input parameter p-cli-code like ub.fin-schet.cli-code no-undo.
     6707   define variable v-cli-code as character no-undo.
     6708   assign
     6709   frame Dialog-Frame RS-cli-type .
     6710   display
     6711   "":U @ sch-c-schet
     6712   "":U @ sch-r-schet
     6713   0 @ sch-code
     6714   with frame Dialog-Frame.
     6715   assign
     6716   v-cli-code = string(p-cli-code).
     6717   run OpenBr in this-procedure
     6718       (input false
     6719       ,input p-next
     6720       ,input substitute("and X_fin-schet.cli-type = '&1' and X_fin-schet.cli-code = &2"
     6721         , RS-cli-type, v-cli-code )
     6722       ).
     6723   apply "entry":u to sch-cli-code in frame Dialog-Frame .
     6724   END PROCEDURE.
     6725   PROCEDURE proc-find-code :
     6726   define input parameter p-next as logical no-undo.
     6727   define input parameter p-code-schet like ub.fin-schet.code-schet no-undo.
     6728   define variable v-code-schet as character no-undo.
     6729   display
     6730   "0":U @ sch-cli-code
     6731   "":U @ sch-c-schet
     6732   "":U @ sch-r-schet
     6733   with frame Dialog-Frame.
     6734   assign
     6735   v-code-schet = string(p-code-schet).
     6736   run OpenBr in this-procedure
     6737       (input false
     6738       ,input p-next
     6739       ,input substitute("and X_fin-schet.code-schet = &1 "
     6740         , v-code-schet)
     6741       ).
     6742   apply "entry":u to sch-code in frame Dialog-Frame .
     6743   END PROCEDURE.
     6744   PROCEDURE proc-find-r-schet :
     6745   define input parameter p-next as logical no-undo.
     6746   define input parameter p-r-schet as character no-undo.
     6747   display
     6748   "0":U @ sch-code
     6749   "0":U @ sch-cli-code
     6750   "":U @ sch-c-schet
     6751   with frame Dialog-Frame.
     6752   assign
     6753   p-r-schet = replace(p-r-schet, chr(34), "":U)
     6754   p-r-schet = replace(p-r-schet, chr(39), chr(39) + chr(39))
     6755   p-r-schet = chr(34) + p-r-schet + chr(34).
     6756   run OpenBr in this-procedure
     6757       (input false
     6758       ,input p-next
     6759       ,input substitute("and X_fin-schet.r-schet   begins &1 "
     6760         , p-r-schet)
     6761       ).
     6762   apply "entry":u to sch-r-schet in frame Dialog-Frame .
     6763   END PROCEDURE.
     6764   PROCEDURE proc-print-list :
     6765   define variable v-doc-rec as recid no-undo .
     6766   define variable accum-count as integer.
     6767   define variable date_string     as      char    no-undo.
     6768   define variable Line            as      char    no-undo.
     6769   define variable v-bank-short-name     as character no-undo .
     6770   define variable v-cli-name      as character no-undo .
     6771   define variable v-curr-abbr     as character no-undo .
     6772   DEFINE FRAME fin-schet-list
     6773   X_fin-schet.host-code COLUMN-LABEL "Код!фирмы" format "9999999999"
     6774   X_fin-schet.code-schet
     6775   X_fin-schet.code-bank COLUMN-LABEL "Код банка"  format ">>>>>>9"
     6776   v-bank-short-name format "X(40)" COLUMN-LABEL "Банк"
     6777   X_fin-schet.cli-type
     6778   X_fin-schet.cli-code
     6779   v-cli-name  format "X(20)" COLUMn-LABEL "Держатель счета"
     6780   v-curr-abbr format "X(3)" COLUMn-LABEL "Вал"
     6781   X_fin-schet.status_
     6782   X_fin-schet.r-schet
     6783   X_fin-schet.c-schet
     6784   HEADER  date_string AT 5 format "X(35)"
     6785    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     6786   Line format "X(195)" AT 1
     6787   with width 232 down stream-io use-text    .
     6788   Line = fill("-", 195).
     6789   date_string = cur-time-print() .
     6790   run prn-lib-open-stream  in this-procedure (
     6791                                                input parParentProc
     6792                                               ,input 43
     6793                                               ,input yes
     6794                                               ,input no
     6795                                               ).
     6796   PUT  STREAM PrnLibStream
     6797   SPACE(25) ( frame Dialog-Frame:title )
     6798   format "x(90)" SKIP(1) .
     6799   FORM HEADER
     6800   Line format "X(195)" AT 1 SKIP
     6801   "Продолжение - на следующей странице" AT 30 SKIP
     6802   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     6803   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     6804   FORM with FRAME fin-schet-list  .
     6805   run waitfram-show in this-procedure ( input "Ждите...").
     6806   v-doc-rec = recid(X_fin-schet).
     6807   DO WHILE available X_fin-schet :
     6808     GET prev br-schet.
     6809   END.
     6810   GET next br-schet.
     6811   DO WHILE available X_fin-schet :
     6812     Display STREAM PrnLibStream
     6813     X_fin-schet.host-code
     6814     X_fin-schet.code-schet
     6815     X_fin-schet.code-bank
     6816     get-bank-short-name(buffer X_fin-schet) @  v-bank-short-name
     6817     X_fin-schet.cli-type
     6818     X_fin-schet.cli-code
     6819     get-cli-name(buffer X_fin-schet) @ v-cli-name
     6820     get-currency(buffer X_fin-schet)  @ v-curr-abbr
     6821     X_fin-schet.status_
     6822     X_fin-schet.r-schet
     6823     X_fin-schet.c-schet
     6824     with FRAME fin-schet-list .
     6825     DOWN STREAM PrnLibStream 1
     6826     with FRAME fin-schet-list  .
     6827     assign
     6828     accum-count = accum-count + 1
     6829     .
     6830     GET next br-schet.
     6831   END.
     6832   UNDERLINE  STREAM PrnLibStream
     6833   X_fin-schet.host-code
     6834   X_fin-schet.code-schet
     6835   X_fin-schet.code-bank
     6836   v-bank-short-name
     6837   X_fin-schet.cli-type
     6838   X_fin-schet.cli-code
     6839   v-cli-name
     6840   v-curr-abbr
     6841   X_fin-schet.status_
     6842   X_fin-schet.r-schet
     6843   X_fin-schet.c-schet
     6844   with FRAME fin-schet-list .
     6845   DISPLAY STREAM PrnLibStream
     6846   "ИТОГО" @ X_fin-schet.host-code
     6847   accum-count @ X_fin-schet.code-schet
     6848   with frame fin-schet-list.
     6849   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     6850   HIDE  STREAM PrnLibStream FRAME fin-schet-List.
     6851   output  STREAM PrnLibStream CLOSE.
     6852   REPOSITION br-schet to recid v-doc-rec no-error.
     6853   APPLY "entry" to br-schet.
     6854   run waitfram-hide in this-procedure .
     6855   run prn-lib-prn-file in this-procedure (
     6856                                             input parParentProc
     6857                                             ,input 8
     6858                                             ).
     6859   END PROCEDURE.
     6860   PROCEDURE proc-print-one :
     6861   if not available X_fin-schet then return error.
     6862   run ref/finschtp.p (
     6863                    INPUT parParentProc
     6864                    ,input X_fin-schet.host-code
     6865                    ,input X_fin-schet.code-schet
     6866                 ) no-error.
     6867   if error-status:error then do:
     6868     return error.
     6869   end.
     6870   END PROCEDURE.
     6871   FUNCTION get-bank-short-name RETURNS CHARACTER
     6872     ( BUFFER loc-fin-schet FOR ub.fin-schet ) :
     6873   define buffer buf_fin-bank for ub.fin-bank.
     6874   find first buf_fin-bank no-lock where
     6875               buf_fin-bank.code-bank = loc-fin-schet.code-bank
     6876                   AND    buf_fin-bank.host-code = loc-fin-schet.host-code  no-error.
     6877   if available buf_fin-bank then
     6878   RETURN (if buf_fin-bank.short-name <> "":U then buf_fin-bank.short-name else buf_fin-bank.bank-name).
     6879   return (string(loc-fin-schet.host-code) + string(loc-fin-schet.code-bank)).
     6880   END FUNCTION.
     6881   FUNCTION get-cli-name RETURNS CHARACTER
     6882    ( BUFFER loc-fin-schet FOR ub.fin-schet ) :
     6883   define buffer buf_clients for ub.clients.
     6884   find first buf_clients no-lock where
     6885               buf_clients.obj-type = loc-fin-schet.cli-type
     6886                   AND    buf_clients.obj-code = loc-fin-schet.cli-code  no-error.
     6887   if available buf_clients then
     6888   RETURN (buf_clients.obj-name).
     6889   return (loc-fin-schet.cli-type + string(loc-fin-schet.cli-code)).
     6890   END FUNCTION.
     6891   FUNCTION get-currency RETURNS CHARACTER
     6892     ( BUFFER loc-fin-schet FOR ub.fin-schet ) :
     6893   define buffer buf_currency for ub.currency.
     6894   find first buf_currency no-lock where
     6895               buf_currency.curr-code = loc-fin-schet.curr-code no-error.
     6896   if available buf_currency then
     6897     RETURN buf_currency.curr-abbr.
     6898   return string(loc-fin-schet.curr-code).
     6899   END FUNCTION.
