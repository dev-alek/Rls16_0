     3057   procedure get-context :
     3058      define output parameter p-db-num as integer          no-undo.
     3059      define output parameter p-user-id as character        no-undo.
     3060      define variable v-login               as character    no-undo.
     3061      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3062      define buffer buf_user-login  for ub.user-login .
     3063      do
     3064      on error undo, return error
     3065      :
     3066            FIND FIRST buf_sys-ctrl no-lock.
     3067            ASSIGN
     3068               v-login = USERID("ub")
     3069               p-db-num = buf_sys-ctrl.db-num
     3070            .
     3071            FIND FIRST buf_user-login
     3072                 WHERE buf_user-login.db-num = p-db-num
     3073                   AND buf_user-login.user-login = v-login
     3074                 no-lock
     3075                 no-error
     3076                 .
     3077            IF AVAILABLE buf_user-login
     3078            THEN DO:
     3079               assign
     3080                  p-user-id = buf_user-login.user-id
     3081               .
     3082            END.
     3083      end.
     3084   end procedure.
     3085       run diasize_init in this-procedure .
