     1699     dops = if available X_fin-schet then X_fin-schet.ps else '':U.
     1700     ED-notes:screen-value = dops.
     1701     if not available X_fin-schet
     1702     or not (X_fin-schet.cli-type = 'орг':U
     1703            and
     1704            X_fin-schet.cli-code = X_fin-schet.host-code) then do:
     1705       assign
     1706       menu-item m_statement:sensitive in menu menu-b-vipiska  = no.
     1707     end.
     1708     else do:
     1709       assign
     1710       menu-item m_statement:sensitive in menu menu-b-vipiska  = yes.
     1711     end.
     1712   END.
