      124     run proc-alt-shift-f4 in this-procedure.
      125   end.
      126   on alt-f1 anywhere do:
      127     run proc-alt-f1 in this-procedure .
      128   end.
      129   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   define variable c-point  as character no-undo .
      131   define variable tbl      as character no-undo .
      132   define variable join-tbl as character no-undo .
      133   define variable fld      as character no-undo .
      134   define variable lab      as character no-undo .
      135   define variable spr      as character no-undo .
      136   define variable dim      as character no-undo .
      137   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   procedure cur-time :
      139      define output parameter p-today as date      no-undo .
      140      define output parameter p-time  as integer   no-undo .
      141     do
      142     on error undo, return error
      143     :
      144       define variable v-date1 as date      no-undo .
      145       define variable v-date2 as date      no-undo .
      146       define variable v-time  as integer   no-undo .
      147       assign
      148         v-date1 = today
      149         v-time  = time
      150         v-date2 = today
      151       .
      152       if v-date1 <> v-date2
      153       then do:
      154         assign
      155           v-date1 = today
      156           v-time  = v-time
      157         .
      158       end.
      159       assign
      160         p-today = v-date1
      161         p-time  = v-time
      162       .
      163     end.
      164   end.
      165   function cur-time-date returns character
      166   :
      167     return string(today, '99/99/9999':U) .
      168   end.
      169   function cur-time-mjd returns decimal
      170   :
      171     define variable v-date as date      no-undo .
      172     define variable v-time as integer   no-undo .
      173     run cur-time in this-procedure
      174       (output v-date
      175       ,output v-time
      176       ) .
      177     return integer(v-date) - 2400002 + (v-time / 86400) .
      178   end.
      179   function cur-time-get-ending-index returns integer
      180   (input p-number as integer
      181   )
      182   :
      183     if p-number < 0
      184     or p-number = ?
      185     then do:
      186       return 1 .
      187     end.
      188     define variable v-rest as integer   no-undo .
      189     assign
      190       p-number = p-number modulo 100
      191     .
      192     if p-number < 20
      193     then do:
      194       assign
      195         v-rest = p-number
      196       .
      197     end.
      198     else do:
      199       assign
      200         v-rest = p-number modulo 10
      201       .
      202     end.
      203     case v-rest :
      204       when 1
      205       then do:
      206         return 2 .
      207       end.
      208       when 2 or
      209       when 3 or
      210       when 4
      211       then do:
      212         return 3 .
      213       end.
      214       otherwise do:
      215         return 1 .
      216       end.
      217     end case .
      218   end.
      219   procedure cur-time-mjd-to-date :
      220      define input  parameter i-mjd-diff as decimal no-undo.
      221      define output parameter o-Date     as date    no-undo.
      222      define output parameter o-Time     as integer no-undo.
      223      define variable v-day-number as integer   no-undo .
      224      if    i-mjd-diff < 0
      225         or i-mjd-diff = ?
      226      then do:
      227         return "?" .
      228      end.
      229      assign
      230         v-day-number = truncate(i-mjd-diff,0).
      231         o-Date = date(v-day-number + 2400002).
      232         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      233     .
      234   end.
      235   function cur-time-mjd-to-string returns character
      236   (input p-mjd-diff as decimal
      237   )
      238   :
      239     define variable v-day-number as integer   no-undo .
      240     define variable v-seconds    as integer   no-undo .
      241     define variable v-hour       as integer   no-undo .
      242     define variable v-min        as integer   no-undo .
      243     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      244     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      245     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      246     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      247     if p-mjd-diff < 0
      248     or p-mjd-diff = ?
      249     then do:
      250       return "?" .
      251     end.
      252     assign
      253       v-day-number = integer(truncate(p-mjd-diff,0))
      254       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      255     .
      256     if v-seconds > 86400
      257     then do:
      258       assign
      259         v-seconds = 86400 - 1
      260       .
      261     end.
      262     if v-seconds < 0
      263     then do:
      264       assign
      265         v-seconds = 0
      266       .
      267     end.
      268     assign
      269       v-hour = truncate(v-seconds / 3600, 0)
      270     .
      271     assign
      272       v-seconds = v-seconds modulo 3600
      273     .
      274     assign
      275       v-min = truncate(v-seconds / 60, 0)
      276     .
      277     assign
      278       v-seconds = v-seconds modulo 60
      279     .
      280     return
      281         (if v-day-number <> 0
      282           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      283           else ""
      284         )
      285       + (if v-day-number <> 0 or v-hour <> 0
      286           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      287           else ""
      288         )
      289       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      290           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      291           else ""
      292         )
      293       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      294       .
      295   end.
      296   function cur-time-string returns character
      297   :
      298     define variable v-date as date      no-undo .
      299     define variable v-time as integer   no-undo .
      300     run cur-time in this-procedure
      301       (output v-date
      302       ,output v-time
      303       ) .
      304     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      305   end.
      306   function cur-time-string-sec returns character
      307   :
      308     define variable v-date as date      no-undo .
      309     define variable v-time as integer   no-undo .
      310     run cur-time in this-procedure
      311       (output v-date
      312       ,output v-time
      313       ) .
      314     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      315   end.
      316   function cur-time-custom  returns character
      317   (input p-prefix as character
      318   ,input p-date-format as character
      319   ,input p-delimiter as character
      320   ,input p-time-format as character
      321   ,input p-suffix as character
      322   )
      323   :
      324     define variable v-date as date      no-undo .
      325     define variable v-time as integer   no-undo .
      326     run cur-time in this-procedure
      327       (output v-date
      328       ,output v-time
      329       ) .
      330     return
      331       p-prefix
      332       + string(v-date, p-date-format)
      333       + p-delimiter
      334       + string(v-time, p-time-format)
      335       + p-suffix
      336       .
      337   end.
      338   function cur-time-print  returns character
      339   :
      340     define variable v-date as date      no-undo .
      341     define variable v-time as integer   no-undo .
      342     run cur-time in this-procedure
      343       (output v-date
      344       ,output v-time
      345       ) .
      346     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      347   end.
      348   function cur-time-datetime returns datetime
      349   :
      350     define variable v-char as character no-undo .
      351     define variable v-datetime as datetime no-undo .
      352     v-char = cur-time-string().
      353     v-datetime = datetime(v-char).
      354     return  v-datetime.
      355   end.
      356   function cur-time-string-msec returns character
      357   :
      358     define variable v-date as datetime  no-undo .
      359     v-date = now.
      360     return string(v-date) .
      361   end.
      362   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      363   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      364   define new shared variable RepPathName        as character no-undo .
      365   define new shared variable PrintRubl          as logical   no-undo .
      366   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      367   define variable v-waitfram-action01         as character   no-undo .
      368   define variable v-waitfram-action02         as character   no-undo .
      369   define variable v-waitfram-action03         as character   no-undo .
      370   define variable mWaitFramTextBeg            as character   no-undo.
      371   define variable mWaitFramTextEnd            as character   no-undo.
      372   define variable mWaitFramView               as logical     no-undo.
      373   define variable mWaitProcEvent              as logical     no-undo init yes.
      374   define variable mWaitFramInterval           as integer     no-undo init 1 .
      375   define variable mWaitFramStop               as logical     no-undo.
      376   define variable mWaitFramStopUser           as logical     no-undo.
      377   define variable mWaitFramStopTimeOut        as logical     no-undo.
      378   define variable mWaitFramStartProc          as datetime-tz no-undo.
      379   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      380   define button B-WaitFramStop auto-end-key
      381        label "Стоп"
      382        size 10 by 1 tooltip "Остоновить процесс".
      383   define button B-viewProcInfo
      384        label "Информация"
      385        size 15 by 1 tooltip "Информация о процесс".
      386   define frame waitfram
      387     v-waitfram-action01 format "x(72)" no-label skip
      388     v-waitfram-action02 format "x(72)" no-label skip
      389     v-waitfram-action03 format "x(72)" no-label skip
      390     B-viewProcInfo
      391     B-WaitFramStop at row 4 col 30
      392     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      393     .
      394   define new global shared variable mBatchMode as logical no-undo init ?.
      395   define variable mFramBachModHandle as handle no-undo.
      396   mFramBachModHandle = frame waitfram:handle.
      397   define variable mFameOldVis as logical no-undo.
      398   define variable mVisCUrentVin as logical no-undo.
      399   if session:batch-mode
      400   then
      401      mBatchMode = yes.
      402   if mBatchMode = ? then do:
      403     mVisCUrentVin = current-window:visible.
      404     mFameOldVis = mFramBachModHandle:visible.
      405     mFramBachModHandle:visible  = yes.
      406     mBatchMode = mFramBachModHandle:visible ne yes.
      407     mFramBachModHandle:visible = mFameOldVis.
      408     current-window:visible = mVisCUrentVin.
      409   end.
      410    if  log-manager:logfile-name ne ?
      411     then DO:
      412         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      413         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      414         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      415     end.
      416   on choose of B-WaitFramStop in frame waitfram
      417   do:
      418     mWaitFramStop = yes.
      419     mWaitFramStopUser = yes.
      420   end.
      421   function waitfram-check-timeout returns logical():
      422      define variable vtime as int64 no-undo.
      423      if mWaitFramStopTimeOut
      424      then
      425         return yes.
      426      vtime = ( now - mWaitFramStartProc ) / 1000 .
      427      if     mWaitFramTimeOut ne ?
      428         and mWaitFramTimeOut ne 0
      429         and mWaitFramTimeOut lt vtime
      430      then do:
      431         mWaitFramStopTimeOut = yes.
      432      end.
      433      return mWaitFramStopTimeOut.
      434   end.
      435   procedure waitfram-hide :
      436     if not session:batch-mode
      437     then do
      438     on error undo, return error return-value
      439     :
      440       pause 0 before-hide .
      441       if not mBatchMode then
      442         hide frame waitfram .
      443     if     not mWaitFramView
      444        and mWaitProcEvent
      445     then
      446       process events .
      447     end.
      448   end procedure.
      449   procedure waitfram-show :
      450     define input  parameter p-message as character no-undo .
      451     define variable v-left-margin as integer   no-undo .
      452     if not session:batch-mode
      453     then do
      454     on error undo, return error return-value
      455     :
      456       if length(p-message) <= 70 then do:
      457         assign
      458           v-left-margin = integer((70 - length(p-message)) / 2)
      459         .
      460         assign
      461           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      462         .
      463         assign
      464           v-waitfram-action01 = " "
      465           v-waitfram-action02 = " "
      466                                    + fill(" ", v-left-margin)
      467                                    + p-message
      468           v-waitfram-action03 = " "
      469         .
      470       end.
      471       else do:
      472         define variable vRindex1 as integer no-undo.
      473         define variable vRindex2 as integer no-undo.
      474         vRindex1 = r-index(p-message," ",70).
      475         if vRindex1 = 0
      476         then
      477            vRindex1 = 70.
      478         if length(p-message)  <= vRindex1 + 70 then do:
      479           assign
      480             v-waitfram-action01 = " "
      481             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      482             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      483           .
      484         end.
      485         else do:
      486           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      487           if vRindex2 <= vRindex1
      488           then
      489              vRindex2 = vRindex1 + 70.
      490           assign
      491             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      492             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      493             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      494           .
      495         end.
      496       end.
      497       B-viewProcInfo:visible   in frame waitfram = no.
      498       B-viewProcInfo:sensitive in frame waitfram = no.
      499       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      500       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      501       if  (   mWaitFramView
      502          or  mWaitProcEvent)
      503          and not mBatchMode
      504       then
      505          display
      506             v-waitfram-action01 skip
      507             v-waitfram-action02 skip
      508             v-waitfram-action03 skip
      509          with frame waitfram .
      510       if     mWaitFramView
      511          then do:
      512             if     mWaitFramInterval ne ?
      513                and not mBatchMode
      514             then
      515                wait-for go of frame waitfram pause mWaitFramInterval.
      516          end.
      517          else
      518             if     mWaitProcEvent
      519                and not mBatchMode
      520             then
      521                process events .
      522     end.
      523   end procedure.
      524      procedure waitfram-show-this:
      525         define input  parameter iInterval as int64 no-undo.
      526         define variable vtime as int64 no-undo.
      527         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      528         mWaitFramInterval = iInterval.
      529         run waitfram-show (substitute("&1&2 &3&4" ,
      530                                       mWaitFramTextBeg ,
      531                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      532                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      533                                       mWaitFramTextEnd
      534                                      )
      535                           ).
      536      end.
      537      procedure WaitFramRunPause:
      538         define input  parameter iInterval as dec no-undo.
      539         define variable vStart  as datetime-tz no-undo.
      540         define variable vend    as datetime-tz no-undo.
      541         define variable vint as int64 no-undo.
      542         define variable vOk as logical no-undo.
      543         vStart = now.
      544         vend   = vStart.
      545         publish "WaitFramPause" (iInterval,output vOk).
      546         vend   =  now.
      547         vint = vend - vStart.
      548         vint = iInterval - vint / 1000.
      549         if     not mWaitFramStop
      550            and (   vint > 0
      551                 or (    not vOk
      552                     and iInterval eq ?
      553                     )
      554                 )
      555         then
      556            run waitfram-show-this (iInterval).
      557         vend   =  now.
      558         vint = vend - vStart.
      559         vint = iInterval - vint / 1000.
      560         if     not mWaitFramStop
      561            and vint > 0
      562         then do:
      563            run gbl/pause.p (vint * 1000).
      564         end.
      565         if iInterval ne ?
      566         then
      567            publish "WaitFramStop".
      568         waitfram-check-timeout().
      569      end.
      570      procedure WaitFramWaitFor:
      571         define input  parameter iInterval as dec no-undo.
      572         assign
      573            mWaitFramStartProc   = now
      574            mWaitFramStopUser    = no
      575            mWaitFramStopTimeOut = no
      576         .
      577         block-wait:
      578         do while not mWaitFramStop:
      579            run WaitFramRunPause (iInterval).
      580            if  waitfram-check-timeout()
      581            then do:
      582               leave block-wait.
      583            end.
      584         end.
      585         run waitfram-hide.
      586      end.
      587   procedure waitfram-join :
      588     define input  parameter p-line-1  as character no-undo .
      589     define input  parameter p-line-2  as character no-undo .
      590     define input  parameter p-line-3  as character no-undo .
      591     define output parameter p-message as character no-undo .
      592     do
      593     on error undo, return error return-value
      594     :
      595       assign
      596         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      597                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      598                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      599       .
      600     end.
      601   end procedure.
      602   function waitfram-join-function returns character
      603     (input p-line-1 as character
      604     ,input p-line-2 as character
      605     ,input p-line-3 as character
      606     ).
      607     define variable v-message as character no-undo .
      608     run waitfram-join in this-procedure
      609       (input  p-line-1
      610       ,input  p-line-2
      611       ,input  p-line-3
      612       ,output v-message
      613       ) .
      614     return v-message .
      615   end function .
      616   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      617   procedure fltfield-clear :
      618     define output parameter loc-fld as character no-undo.
      619     define output parameter loc-lab as character no-undo .
      620     define output parameter loc-spr as character no-undo .
      621     define output parameter loc-dim as character no-undo .
      622     assign
      623       loc-fld = ""
      624       loc-lab = ""
      625       loc-spr = ""
      626       loc-dim = "0"
      627     .
      628   end procedure .
      629   procedure fltfield-add :
      630     define input        parameter par-fld as character no-undo.
      631     define input        parameter par-lab as character no-undo .
      632     define input        parameter par-spr as character no-undo .
      633     define input-output parameter loc-fld as character no-undo.
      634     define input-output parameter loc-lab as character no-undo .
      635     define input-output parameter loc-spr as character no-undo .
      636     define input-output parameter loc-dim as character no-undo .
      637     do
      638     on error undo, return error
      639     :
      640       assign
      641       loc-fld = if loc-dim = '0'
      642                 then par-fld
      643                 else (loc-fld + chr(44) + par-fld)
      644       loc-lab = if loc-dim = '0'
      645                 then par-lab
      646                 else (loc-lab + chr(44) + par-lab)
      647       loc-spr = if loc-dim = '0'
      648                 then par-spr
      649                 else (loc-spr + chr(44) + par-spr)
      650       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      651                 string(integer(if num-entries(loc-dim) > 1
      652                               then entry(2, loc-dim)
      653                               else entry(1, loc-dim)
      654                               ) + 1)
      655       no-error
      656       .
      657     end.
      658   end procedure.
      659   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      660   define  stream PrnLibStream.
      661   procedure prn-lib-prn-file :
      662     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      663     define input parameter p-DIsabledoptions as integer no-undo .
      664     define variable v-report-name as character no-undo .
      665     define variable v-user-action as character no-undo .
      666     define variable v-printed     as logical   no-undo .
      667     define variable v-exist       as logical   no-undo .
