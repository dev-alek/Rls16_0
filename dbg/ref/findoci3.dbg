     3556   ON CHOOSE OF B-currency IN FRAME Dialog-Frame
     3557     DO:
     3558       define variable rr          as recid no-undo.
     3559       define variable v-curr-code like ub.fin-doc.curr-code no-undo.
     3560   define variable vss-include-info36 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3561   if lookup(self :type
     3562            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3563            ) = 0
     3564   then do:
     3565     message
     3566       "$Workfile$"
     3567       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3568       "Интерфейсный элемент" self :name  skip
     3569       "Тип" self :type  skip
     3570       "Процедура" this-procedure :file-name skip
     3571       view-as alert-box .
     3572   end.
     3573   else do:
     3574     apply "entry":u to self  .
     3575     if focus :handle <> self :handle  then do:
     3576       return no-apply .
     3577     end.
     3578   end.
     3579   assign
     3580     v-curr-code = tt-fin-doc.curr-code
     3581     tt-fin-doc.curr-code.
     3582   if available X_currency then rr = recid(X_currency).
     3583   else rr = ?.
     3584   run ref/currency.w (parparentproc, "b-sel", input-output rr ).
     3585   if rr <> ? then
     3586   do:
     3587     FIND FIRST X_currency WHERE
     3588       recid( X_currency ) = rr NO-LOCK .
     3589     assign
     3590       tt-fin-doc.curr-code = X_currency.curr-code
     3591       f-curr-abbr          = X_currency.curr-abbr
     3592       .
     3593     DISPLAY
     3594       tt-fin-doc.curr-code
     3595       f-curr-abbr
