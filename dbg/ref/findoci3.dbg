     5648          ,input tt-fin-doc.con-sum-rubl         ,input tt-fin-doc.con-sum-base         ,input tt-fin-doc.con-sum-doc          ,input tt-fin-doc.con-sum-contr        ,input tt-fin-doc.con-stat             ,input tt-fin-doc.payer-sign1                ,input tt-fin-doc.payer-sign2                ,input tt-fin-doc.payer-sign3                ,input tt-fin-doc.payer-sign4                ,input tt-fin-doc.receiver-sign1                ,input tt-fin-doc.receiver-sign2                ,input tt-fin-doc.receiver-sign3                ,input tt-fin-doc.receiver-sign4                ,input tt-fin-doc.obj-type                   ,input tt-fin-doc.obj-code                   ,input tt-fin-doc.doc-author                 ,input tt-fin-doc.fact-author                ,input tt-fin-doc.CashBookId
     5649          ,input table tt0-fin-doc-tax
     5650          ,input table tt0-fin-doc-attr
     5651          ,input yes
     5652          ,input table tt0-payment
     5653   ) no-error.
     5654   if error-status:error then do:
     5655   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5656   define variable fh as widget-handle no-undo .
     5657   define variable hh as widget-handle no-undo .
     5658   define variable rv as character no-undo .
     5659   assign
     5660   rv = entry(1, return-value , chr(4)).
     5661   if rv <> "":U then do:
     5662     assign
     5663     fh = frame Dialog-Frame:first-child
     5664     hh = fh:first-child
     5665     .
     5666     do while valid-handle(hh):
     5667       if hh:name = rv then do:
     5668         APPLY "ENTRY" to hh.
     5669         undo ,
     5670         return error.
     5671       end.
     5672       hh = hh:next-sibling.
     5673     end.
     5674   end.
     5675     undo, return error.
     5676   end.
     5677   END PROCEDURE.
