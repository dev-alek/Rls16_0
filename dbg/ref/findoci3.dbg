     4644   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4645   procedure minbtn-set :
     4646       do
     4647           on error undo, return error return-value
     4648           :
     4649           define variable ii              as integer       no-undo .
     4650           define variable fh              as widget-handle no-undo .
     4651           define variable hh              as widget-handle no-undo .
     4652           define variable v-h             as handle        extent 4 no-undo .
     4653           define variable v-name-button   as character     no-undo .
     4654           define variable v-help-old-x    as decimal       no-undo .
     4655           define variable v-help-old-y    as decimal       no-undo .
     4656           define variable v-help-old-size as decimal       no-undo .
     4657           define variable v-frame-width   as decimal       no-undo .
     4658           define variable jj              as integer       no-undo .
     4659           do
     4660               on error undo, return error
     4661               :
     4662               assign
     4663                   v-frame-width = frame Dialog-Frame:width - 0.3
     4664                   fh            = frame Dialog-Frame:first-child
     4665                   hh            = fh:first-child
     4666                   ii            = 1
     4667                   .
     4668               do while valid-handle(hh):
     4669                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     4670                   do:
     4671                       case lc(hh:name) :
     4672                           when "b-help" then
     4673                               do:
     4674                                   hh:load-image-up("cmp/b-help.bmp":u) .
     4675                                   hh:load-image-down("cmp/b-help.bmp":u) .
     4676                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     4677                                   hh:TOOLTIP = "Помощь" .
     4678                                   v-help-old-x = hh:column .
     4679                                   v-help-old-y = hh:row    .
     4680                                   v-help-old-size = hh:width .
     4681                                   hh:width-chars = 2.5 .
     4682                               end.
     4683                           when "b-print" then
     4684                               do:
     4685                                   hh:load-image("cmp/b-print.bmp":u) .
     4686                                   hh:TOOLTIP = "Печать" .
     4687                                   v-h[ii] = hh:handle .
     4688                                   ii = ii + 1 .
     4689                                   hh:width-chars = 3 .
     4690                               end.
     4691                           when "b-history" or
     4692                           when "b-hist" then
     4693                               do:
     4694                                   hh:load-image("cmp/b-hist.bmp":u) .
     4695                                   hh:TOOLTIP = "История" .
     4696                                   v-h[ii] = hh:handle .
     4697                                   ii = ii + 1 .
     4698                                   hh:width-chars = 3 .
     4699                               end.
     4700                           when "b-sch" then
     4701                               do:
     4702                                   hh:load-image("cmp/b-sch.bmp":u) .
     4703                                   hh:TOOLTIP = "Установка Фильтра" .
     4704                                   v-h[ii] = hh:handle .
     4705                                   ii = ii + 1 .
     4706                                   hh:width-chars = 3 .
     4707                               end.
     4708                           when "b-hist-user" then
     4709                               do:
     4710                                   hh:load-image("cmp/b-hist.bmp":u) .
     4711                                   hh:TOOLTIP = "История пользователя" .
     4712                                   ii = ii + 1 .
     4713                               end.
     4714                       end case.
     4715                   end.
     4716                   hh = hh:next-sibling.
     4717               end.
     4718               b-help:column = v-frame-width - b-help:width-chars.
     4719               jj = 0.
     4720               repeat ii = 4 to 1 by -1 :
     4721                   if valid-handle (v-h[ii] ) then
     4722                   do:
     4723                       jj  = jj + 1 .
     4724                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     4725                       v-h[ii]:row    = v-help-old-y .
     4726                   end.
     4727               end.
     4728           end.
     4729       end.
     4730   end procedure.
     4731   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4732   ON TAB ANYWHERE
     4733   DO:
     4734   define variable ii as integer no-undo .
     4735   define variable fh as widget-handle no-undo .
     4736   define variable hh as widget-handle no-undo .
     4737   define variable v-next-widget-name as character no-undo .
     4738   if v-tab-order <> '' then do:
     4739     if self:type = "TOGGLE-BOX" then
     4740     self:BGCOLOR = ?.
     4741     assign
     4742     ii = lookup(self:name, v-tab-order).
     4743     assign
     4744     ii = ii + 1
     4745     v-next-widget-name = entry(ii, v-tab-order)
     4746     no-error .
     4747     if error-status:error then do:
     4748       assign
     4749       ii = 1
     4750       v-next-widget-name = entry( ii, v-tab-order)
     4751       .
     4752     end.
     4753     assign
     4754     fh = frame Dialog-Frame:first-child
     4755     hh = fh:first-child
     4756     .
     4757     do while valid-handle(hh):
     4758       if hh:name = v-next-widget-name then do:
     4759         if hh:sensitive  = yes
     4760         AND hh:visible = yes then do:
     4761           if hh:type = "TOGGLE-BOX":U then do:
     4762             assign
     4763             hh:BGcolor = 1
     4764             .
     4765           end.
     4766           APPLY "ENTRY" to hh.
     4767           return no-apply.
     4768         end.
     4769         else do:
     4770           APPLY "TAB" to hh.
     4771           return no-apply.
     4772         end.
     4773       end.
     4774       hh = hh:next-sibling.
     4775     end.
     4776   end.
     4777   END.
     4778   ON BACK-TAB ANYWHERE
     4779   DO:
     4780   define variable ii as integer no-undo .
     4781   define variable fh as widget-handle no-undo .
     4782   define variable hh as widget-handle no-undo .
     4783   define variable v-next-widget-name as character no-undo .
     4784   if v-tab-order <> '' then do:
     4785     assign
     4786     ii = lookup(self:name, v-tab-order).
     4787     .
     4788     assign
     4789     ii = (if ii = 1
     4790           then  num-entries(v-tab-order)
     4791           else ii - 1
     4792           )
     4793     v-next-widget-name = entry(ii, v-tab-order)
     4794     .
     4795     assign
     4796     fh = frame Dialog-Frame:first-child
     4797     hh = fh:first-child
     4798     .
     4799     do while valid-handle(hh):
     4800       if hh:name = v-next-widget-name then do:
     4801         if hh:sensitive  = yes
     4802         AND hh:visible = yes then do:
     4803           if hh:type = "TOGGLE-BOX":U then do:
     4804             assign
     4805             hh:BGcolor = 1
     4806             .
     4807           end.
     4808           APPLY "ENTRY" to hh.
     4809           return no-apply.
     4810         end.
     4811         else do:
     4812         APPLY "BACK-TAB" to hh.
     4813         return no-apply.
     4814         end.
     4815       end.
     4816       hh = hh:next-sibling.
     4817     end.
     4818     end.
     4819   END.
     4820   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4821   ON RETURN ANYWHERE
     4822   DO:
     4823   define variable ii as integer no-undo .
     4824   define variable fh as widget-handle no-undo .
     4825   define variable hh as widget-handle no-undo .
     4826   define variable v-next-widget-name as character no-undo .
     4827     if v-tab-order <> '' then do:
     4828       assign
     4829       ii = lookup(self:name, v-tab-order).
     4830       if ii = num-entries(v-tab-order) then do:
     4831           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     4832           return no-apply.
     4833       end.
     4834       if self:type <> "BUTTON" and
     4835         self:type <> "EDITOR"  then do:
     4836         run proc-move-forward in this-procedure .
     4837         return no-apply.
     4838       end.
     4839       if self:type = "BUTTON" then do:
     4840         APPLY "CHOOSE" to self.
     4841       end.
     4842       if self:type = "TOGGLE-BOX" then
     4843       self:BGCOLOR = ?.
     4844       assign
     4845       ii = ii + 1
     4846       v-next-widget-name = entry(ii, v-tab-order)
     4847       no-error .
     4848       if error-status:error then do:
     4849         assign
     4850         ii = 1
     4851         v-next-widget-name = entry( ii, v-tab-order)
     4852         .
     4853       end.
     4854       assign
     4855       fh = frame Dialog-Frame:first-child
     4856       hh = fh:first-child
     4857       .
     4858       do while valid-handle(hh):
     4859         if hh:name = v-next-widget-name then do:
     4860           if hh:sensitive  = yes
     4861           AND hh:visible = yes then do:
     4862             if hh:type = "TOGGLE-BOX":U then do:
     4863               assign
     4864               hh:BGcolor = 1
     4865               .
     4866             end.
     4867             APPLY "ENTRY" to hh.
     4868             return no-apply.
     4869           end.
     4870           else do:
     4871             APPLY "TAB" to hh.
     4872             return no-apply.
     4873           end.
     4874         end.
     4875         hh = hh:next-sibling.
     4876       end.
     4877     end.
     4878   END.
     4879   procedure proc-move-forward :
     4880   define variable ii as integer no-undo .
     4881   define variable fh as widget-handle no-undo .
     4882   define variable hh as widget-handle no-undo .
     4883   define variable v-next-widget-name as character no-undo .
     4884   do
     4885   on error undo, return error
     4886   :
     4887     if v-tab-order <> '' then do:
     4888       if self:type = "TOGGLE-BOX" then
     4889       self:BGCOLOR = ?.
     4890       assign
     4891       ii = lookup(self:name, v-tab-order).
     4892       assign
     4893       ii = ii + 1
     4894       v-next-widget-name = entry(ii, v-tab-order)
     4895       no-error .
     4896       if error-status:error then do:
     4897         assign
     4898         ii = 1
     4899         v-next-widget-name = entry( ii, v-tab-order)
     4900         .
     4901       end.
     4902       assign
     4903       fh = frame Dialog-Frame:first-child
     4904       hh = fh:first-child
     4905       .
     4906       do while valid-handle(hh):
     4907         if hh:name = v-next-widget-name then do:
     4908           if hh:sensitive  = yes
     4909           AND hh:visible = yes then do:
     4910             if hh:type = "TOGGLE-BOX":U then do:
     4911               assign
     4912               hh:BGcolor = 1
     4913               .
     4914             end.
     4915             APPLY "ENTRY" to hh.
     4916             return.
     4917           end.
     4918           else do:
     4919             assign
     4920             ii = ii + 1
     4921             v-next-widget-name = entry(ii, v-tab-order)
     4922             no-error .
     4923             if error-status:error then do:
     4924               assign
     4925               ii = 1
     4926               v-next-widget-name = entry( ii, v-tab-order)
     4927               .
     4928             end.
     4929           end.
     4930         end.
     4931         hh = hh:next-sibling.
     4932       end.
     4933     end.
     4934   end.
     4935   end procedure.
