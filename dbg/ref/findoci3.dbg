     2764   ON CHOOSE OF B-payer-schet IN FRAME Dialog-Frame
     2765     DO:
     2766   define variable vss-include-info28 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2767   if lookup(self :type
     2768            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2769            ) = 0
     2770   then do:
     2771     message
     2772       "$Workfile$"
     2773       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2774       "Интерфейсный элемент" self :name  skip
     2775       "Тип" self :type  skip
     2776       "Процедура" this-procedure :file-name skip
     2777       view-as alert-box .
     2778   end.
     2779   else do:
     2780     apply "entry":u to self  .
     2781     if focus :handle <> self :handle  then do:
     2782       return no-apply .
     2783     end.
     2784   end.
     2785   define variable v-rid-list as character no-undo.
     2786   define variable ref-rec    as recid     no-undo.
     2787   define variable v-status_  like ub.fin-schet.status_ no-undo init 'тек':U.
     2788   define buffer buf_fin-schet for ub.fin-schet.
     2789   if not available X_payer then
     2790   do:
     2791     message
     2792       "Не выбран" 'ПЛАТЕЛЬЩИК'
     2793       view-as alert-box error .
     2794     return no-apply.
     2795   end.
     2796   if available X_payer-fin-schet then
     2797     assign
     2798       v-rid-list = string(recid(X_payer-fin-schet))
     2799       v-status_  = X_payer-fin-schet.status_
     2800       .
     2801   run ref/finschts.w (
     2802     INPUT parParentProc
     2803     ,p-curr-host-code
     2804     ,input "b-sel,b-add":U
     2805     ,input "cmp-host":U
     2806     ,input X_payer.obj-type
     2807     ,input X_payer.obj-code
     2808     ,input ?
     2809     ,input tt-fin-doc.host-code
     2810     ,input 0
     2811     ,input-output v-status_
     2812     ,input-output v-rid-list
     2813     ) no-error.
     2814   if v-rid-list = "" then
     2815   do:
     2816     apply "entry" to b-payer-schet in frame Dialog-Frame.
     2817     return no-apply.
     2818   end.
     2819   ref-rec = integer( v-rid-list ).
     2820   FIND FIRST buf_fin-schet WHERE
     2821     recid (buf_fin-schet) = ref-rec NO-LOCK  .
     2822   if tt-fin-doc.curr-code <> buf_fin-schet.curr-code then
     2823   do:
     2824     message
     2825       "Валюта выбранного Вами счета" 'ПЛАТЕЛЬЩИКА' "не совпадает с валютой платежа"
     2826       view-as alert-box error .
     2827     return no-apply.
     2828   end.
     2829   if buf_fin-schet.status_ <> 'тек':U then
     2830   do:
     2831     message
     2832       "Статус выбранного Вами счета" 'ПЛАТЕЛЬЩИКА' buf_fin-schet.status_ " - нельзя работать с таким счетом"
     2833       view-as alert-box error .
     2834     return no-apply.
     2835   end.
     2836   FIND FIRST X_payer-fin-schet WHERE
     2837     recid (X_payer-fin-schet) = ref-rec NO-LOCK .
     2838   find first X_payer-fin-bank no-lock where
     2839     X_payer-fin-bank.host-code = tt-fin-doc.host-code
     2840     AND X_payer-fin-bank.code-bank = X_payer-fin-schet.code-bank .
     2841   assign
     2842     tt-fin-doc.payer-bank-name  = X_payer-fin-bank.bank-name
     2843     tt-fin-doc.payer-bank-city  = X_payer-fin-bank.bank-city
     2844     tt-fin-doc.payer-dop1       = X_payer-fin-schet.dop1
     2845     tt-fin-doc.payer-dop2       = X_payer-fin-schet.dop2
     2846     tt-fin-doc.payer-bik        = X_payer-fin-bank.bik
     2847     tt-fin-doc.payer-c-schet    = X_payer-fin-schet.c-schet
     2848     tt-fin-doc.payer-r-schet    = X_payer-fin-schet.r-schet
     2849     tt-fin-doc.payer-code-schet = X_payer-fin-schet.code-schet
     2850     .
     2851   display
     2852     tt-fin-doc.payer-bank-name
     2853     tt-fin-doc.payer-bank-city
     2854     tt-fin-doc.payer-bik
     2855     tt-fin-doc.payer-c-schet
     2856     tt-fin-doc.payer-r-schet
     2857     with frame Dialog-Frame.
     2858   END.
     2859   ON LEAVE OF tt-fin-doc.payer-code IN FRAME Dialog-Frame
     2860     DO:
     2861   define variable vss-include-info29 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2862   if lookup(self :type
     2863            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2864            ) = 0
     2865   then do:
     2866     message
     2867       "$Workfile$"
     2868       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2869       "Интерфейсный элемент" self :name  skip
     2870       "Тип" self :type  skip
     2871       "Процедура" this-procedure :file-name skip
     2872       view-as alert-box .
     2873   end.
     2874   else do:
     2875     apply "entry":u to self  .
     2876     if focus :handle <> self :handle  then do:
     2877       return no-apply .
     2878     end.
     2879   end.
     2880   if   input frame Dialog-Frame tt-fin-doc.payer-code <> 0 then
     2881   do:
     2882     run check-payer in this-procedure no-error.
     2883     if error-status:error then
     2884     do:
     2885       return no-apply.
     2886     end.
     2887     define variable v-recid-schet as recid no-undo . define variable v-recid-bank as recid no-undo . CASE X_payer.obj-type:   when 'чел':U then do:              find first X_payer-person no-lock where               X_payer-person.psn-code = X_payer.obj-code .   end.   when 'орг':U then do:     find first X_payer-firm no-lock where               X_payer-firm.firm-code = X_payer.obj-code .   end. END CASE.   assign   tt-fin-doc.payer-type =  X_payer.obj-type   tt-fin-doc.payer-code = X_payer.obj-code   tt-fin-doc.payer-name = X_payer.obj-name   tt-fin-doc.payer-inn = (if X_payer.obj-type = 'чел':U                             then X_payer-person.inn                             else X_payer-firm.inn                             )   tt-fin-doc.payer-kpp = (if X_payer.obj-type = 'чел':U                             then X_payer-person.kpp                             else X_payer-firm.kpp                             )   .   run get-single-schet in this-procedure (                                           input p-host-code                                           ,input X_payer.obj-type                                           ,input X_payer.obj-code                                           ,input tt-fin-doc.curr-code                                           ,output v-recid-schet                                           ,output v-recid-bank).   if v-recid-schet <> ? then do:     find first X_payer-fin-schet no-lock where                 recid(X_payer-fin-schet) = v-recid-schet.     find first X_payer-fin-bank no-lock where                 recid(X_payer-fin-bank) = v-recid-bank.     assign     tt-fin-doc.payer-code-schet = X_payer-fin-schet.code-schet     tt-fin-doc.payer-bank-name = X_payer-fin-bank.bank-name       tt-fin-doc.payer-bank-city = X_payer-fin-bank.bank-city       tt-fin-doc.payer-dop1       = X_payer-fin-schet.dop1     tt-fin-doc.payer-dop2       = X_payer-fin-schet.dop2     tt-fin-doc.payer-bik = X_payer-fin-bank.bik     tt-fin-doc.payer-r-schet = X_payer-fin-schet.r-schet     tt-fin-doc.payer-c-schet = X_payer-fin-schet.c-schet     .   end.   else do:     RELEASE X_payer-fin-schet.     RELEASE X_payer-fin-bank.     assign     tt-fin-doc.payer-code-schet = 0     tt-fin-doc.payer-bank-name = "":U     tt-fin-doc.payer-bank-city = "":U     tt-fin-doc.payer-dop1      = "":U     tt-fin-doc.payer-dop2      = "":U     tt-fin-doc.payer-bik = "":U     tt-fin-doc.payer-r-schet = "":U     tt-fin-doc.payer-c-schet = "":U     .   end. display tt-fin-doc.payer-type tt-fin-doc.payer-code tt-fin-doc.payer-name tt-fin-doc.payer-inn tt-fin-doc.payer-kpp tt-fin-doc.payer-bank-name tt-fin-doc.payer-bank-city tt-fin-doc.payer-bik tt-fin-doc.payer-r-schet tt-fin-doc.payer-c-schet with frame Dialog-Frame.
     2888     CASE X_payer.obj-type:   when 'чел':U then do:              find first X_payer-person no-lock where               X_payer-person.psn-code = X_payer.obj-code .   end.   when 'орг':U then do:     find first X_payer-firm no-lock where               X_payer-firm.firm-code = X_payer.obj-code .   end. END CASE. assign tt-fin-doc.payer-sign1  = if X_payer.obj-type = 'орг':U                              then X_payer-firm.director                             else X_payer.obj-name . display tt-fin-doc.payer-sign1 with frame Dialog-Frame.
     2889   end.
     2890   END.
     2891   ON VALUE-CHANGED OF tt-fin-doc.payer-type IN FRAME Dialog-Frame
     2892     DO:
     2893       assign
     2894         tt-fin-doc.payer-type.
     2895       if   input frame Dialog-Frame tt-fin-doc.payer-code <> 0 then
     2896       do:
     2897         run check-payer in this-procedure no-error.
     2898         if error-status:error then
     2899         do:
     2900           return no-apply.
     2901         end.
     2902         define variable v-recid-schet as recid no-undo . define variable v-recid-bank as recid no-undo . CASE X_payer.obj-type:   when 'чел':U then do:              find first X_payer-person no-lock where               X_payer-person.psn-code = X_payer.obj-code .   end.   when 'орг':U then do:     find first X_payer-firm no-lock where               X_payer-firm.firm-code = X_payer.obj-code .   end. END CASE.   assign   tt-fin-doc.payer-type =  X_payer.obj-type   tt-fin-doc.payer-code = X_payer.obj-code   tt-fin-doc.payer-name = X_payer.obj-name   tt-fin-doc.payer-inn = (if X_payer.obj-type = 'чел':U                             then X_payer-person.inn                             else X_payer-firm.inn                             )   tt-fin-doc.payer-kpp = (if X_payer.obj-type = 'чел':U                             then X_payer-person.kpp                             else X_payer-firm.kpp                             )   .   run get-single-schet in this-procedure (                                           input p-host-code                                           ,input X_payer.obj-type                                           ,input X_payer.obj-code                                           ,input tt-fin-doc.curr-code                                           ,output v-recid-schet                                           ,output v-recid-bank).   if v-recid-schet <> ? then do:     find first X_payer-fin-schet no-lock where                 recid(X_payer-fin-schet) = v-recid-schet.     find first X_payer-fin-bank no-lock where                 recid(X_payer-fin-bank) = v-recid-bank.     assign     tt-fin-doc.payer-code-schet = X_payer-fin-schet.code-schet     tt-fin-doc.payer-bank-name = X_payer-fin-bank.bank-name       tt-fin-doc.payer-bank-city = X_payer-fin-bank.bank-city       tt-fin-doc.payer-dop1       = X_payer-fin-schet.dop1     tt-fin-doc.payer-dop2       = X_payer-fin-schet.dop2     tt-fin-doc.payer-bik = X_payer-fin-bank.bik     tt-fin-doc.payer-r-schet = X_payer-fin-schet.r-schet     tt-fin-doc.payer-c-schet = X_payer-fin-schet.c-schet     .   end.   else do:     RELEASE X_payer-fin-schet.     RELEASE X_payer-fin-bank.     assign     tt-fin-doc.payer-code-schet = 0     tt-fin-doc.payer-bank-name = "":U     tt-fin-doc.payer-bank-city = "":U     tt-fin-doc.payer-dop1      = "":U     tt-fin-doc.payer-dop2      = "":U     tt-fin-doc.payer-bik = "":U     tt-fin-doc.payer-r-schet = "":U     tt-fin-doc.payer-c-schet = "":U     .   end. display tt-fin-doc.payer-type tt-fin-doc.payer-code tt-fin-doc.payer-name tt-fin-doc.payer-inn tt-fin-doc.payer-kpp tt-fin-doc.payer-bank-name tt-fin-doc.payer-bank-city tt-fin-doc.payer-bik tt-fin-doc.payer-r-schet tt-fin-doc.payer-c-schet with frame Dialog-Frame.
     2903         CASE X_payer.obj-type:   when 'чел':U then do:              find first X_payer-person no-lock where               X_payer-person.psn-code = X_payer.obj-code .   end.   when 'орг':U then do:     find first X_payer-firm no-lock where               X_payer-firm.firm-code = X_payer.obj-code .   end. END CASE. assign tt-fin-doc.payer-sign1  = if X_payer.obj-type = 'орг':U                              then X_payer-firm.director                             else X_payer.obj-name . display tt-fin-doc.payer-sign1 with frame Dialog-Frame.
     2904       end.
     2905     END.
     2906   PROCEDURE check-payer :
     2907     define buffer buf_clients for ub.clients.
     2908     find first buf_clients no-lock where
     2909       buf_clients.obj-code = input frame Dialog-Frame tt-fin-doc.payer-code
     2910       and buf_clients.obj-type = input frame Dialog-Frame tt-fin-doc.payer-type no-error.
     2911     if not available buf_clients then
     2912     do:
     2913       if input frame Dialog-Frame tt-fin-doc.payer-code <> ?  then
     2914         message "Неправильный код или тип " 'ПЛАТЕЛЬЩИКА'.
     2915       apply "entry" to tt-fin-doc.payer-code in frame Dialog-Frame.
     2916       return error.
     2917     end.
     2918     find first X_payer no-lock where recid(X_payer) = recid(buf_clients).
     2919     assign
     2920       tt-fin-doc.payer-type = buf_clients.obj-type
     2921       tt-fin-doc.payer-code = buf_clients.obj-code
     2922       tt-fin-doc.payer-name = buf_clients.obj-name
     2923       .
     2924   find first ub.CashBook no-lock where ub.CashBook.id = tt-fin-doc.cashbookId no-error .
     2925   if ub.CashBook.cli-code = tt-fin-doc.payer-code and ub.CashBook.cli-type = tt-fin-doc.payer-type then do:
     2926   assign
     2927     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     2928     tt-fin-doc.cor-acc-value  = ub.CashBook.corrPko
     2929     tt-fin-doc.naznach-plat   = ub.CashBook.RuleOsnPko
     2930     .
     2931   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     2932     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     2933     and X_fin-code-cor-acc.status_ = integer('0':U)
     2934     no-error .
     2935   if available X_fin-code-cor-acc
     2936     then
     2937   do :
     2938     assign
     2939       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     2940       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     2941       .
     2942   end.
     2943   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     2944     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     2945     and X_fin-code-cor-acc1.status_ = integer('0':U)
     2946     no-error .
     2947   if available X_fin-code-cor-acc1
     2948     then
     2949   do :
     2950     assign
     2951       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     2952       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     2953       .
     2954   end.
     2955   end.
     2956   else
     2957   do:
     2958   if getCliKassa(tt-fin-doc.payer-type, tt-fin-doc.payer-code, "Vnecli", tt-fin-doc.cashbookId) then do:
     2959   assign
     2960     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     2961     .
     2962   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2963     and ub.CashBookRule.Obj-type   = 'всем':U
     2964     and ub.CashBookRule.Obj-code   = 0
     2965     and ub.CashBookRule.Code       = "corrPkoVne"
     2966     no-error.
     2967   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     2968   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2969     and ub.CashBookRule.Obj-type   = 'всем':U
     2970     and ub.CashBookRule.Obj-code   = 0
     2971     and ub.CashBookRule.Code       = "RuleOsnPkoVne"
     2972     no-error.
     2973   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     2974   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     2975     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     2976     and X_fin-code-cor-acc.status_ = integer('0':U)
     2977     no-error .
     2978   if available X_fin-code-cor-acc
     2979     then
     2980   do :
     2981     assign
     2982       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     2983       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     2984       .
     2985   end.
     2986   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     2987     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     2988     and X_fin-code-cor-acc1.status_ = integer('0':U)
     2989     no-error .
     2990   if available X_fin-code-cor-acc1
     2991     then
     2992   do :
     2993     assign
     2994       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     2995       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     2996       .
     2997   end.
     2998   end.
     2999   else do:
     3000   if getCliKassa(tt-fin-doc.payer-type, tt-fin-doc.payer-code, "Avanscli", tt-fin-doc.cashbookId) then do:
     3001   assign
     3002     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     3003     .
     3004   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3005     and ub.CashBookRule.Obj-type   = 'всем':U
     3006     and ub.CashBookRule.Obj-code   = 0
     3007     and ub.CashBookRule.Code       = "corrPkoAvans"
     3008     no-error.
     3009   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     3010   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3011     and ub.CashBookRule.Obj-type   = 'всем':U
     3012     and ub.CashBookRule.Obj-code   = 0
     3013     and ub.CashBookRule.Code       = "RuleOsnPkoAvans"
     3014     no-error.
     3015   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     3016   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     3017     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3018     and X_fin-code-cor-acc.status_ = integer('0':U)
     3019     no-error .
     3020   if available X_fin-code-cor-acc
     3021     then
     3022   do :
     3023     assign
     3024       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     3025       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     3026       .
     3027   end.
     3028   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     3029     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     3030     and X_fin-code-cor-acc1.status_ = integer('0':U)
     3031     no-error .
     3032   if available X_fin-code-cor-acc1
     3033     then
     3034   do :
     3035     assign
     3036       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     3037       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     3038       .
     3039   end.
     3040   end.
     3041   else do:
     3042   tt-fin-doc.naznach-plat = "".
     3043   end.
     3044   end.
     3045   end.
     3046     display
     3047       tt-fin-doc.payer-type
     3048       tt-fin-doc.payer-code
     3049       tt-fin-doc.payer-name
     3050       with frame Dialog-Frame.
     3051   END PROCEDURE.
     3052   on return of tt-fin-doc.payer-code in frame Dialog-Frame
     3053     do:
     3054       apply "leave" to tt-fin-doc.payer-code in frame Dialog-Frame.
     3055       return no-apply.
     3056     end.
     3057   ON LEAVE OF tt-fin-doc.payer-code IN FRAME Dialog-Frame
     3058     DO:
     3059   define buffer buf_clients for ub.clients .
     3060   assign tt-fin-doc.payer-code .
     3061   if tt-fin-doc.payer-code = 0 then leave.
     3062   FIND FIRST buf_clients WHERE buf_clients.obj-code = tt-fin-doc.payer-code
     3063   and buf_clients.obj-type = tt-fin-doc.payer-type NO-LOCK .
     3064   if NOT available (buf_clients) then
     3065   do:
     3066     message
     3067       "Выберите контрагента типа" 'орг':U "или" 'чел':U
     3068       view-as alert-box error .
     3069     return no-apply.
     3070   end.
     3071   find first X_payer no-lock where
     3072     recid(X_payer) = recid(buf_clients).
     3073   assign
     3074     tt-fin-doc.payer-type = buf_clients.obj-type
     3075     tt-fin-doc.payer-code = buf_clients.obj-code
     3076     tt-fin-doc.payer-name = buf_clients.obj-name
     3077     .
     3078   display
     3079     tt-fin-doc.payer-type
     3080     tt-fin-doc.payer-code
     3081     tt-fin-doc.payer-name
     3082     with frame Dialog-Frame.
     3083   define variable v-recid-schet as recid no-undo . define variable v-recid-bank as recid no-undo . CASE X_payer.obj-type:   when 'чел':U then do:              find first X_payer-person no-lock where               X_payer-person.psn-code = X_payer.obj-code .   end.   when 'орг':U then do:     find first X_payer-firm no-lock where               X_payer-firm.firm-code = X_payer.obj-code .   end. END CASE.   assign   tt-fin-doc.payer-type =  X_payer.obj-type   tt-fin-doc.payer-code = X_payer.obj-code   tt-fin-doc.payer-name = X_payer.obj-name   tt-fin-doc.payer-inn = (if X_payer.obj-type = 'чел':U                             then X_payer-person.inn                             else X_payer-firm.inn                             )   tt-fin-doc.payer-kpp = (if X_payer.obj-type = 'чел':U                             then X_payer-person.kpp                             else X_payer-firm.kpp                             )   .   run get-single-schet in this-procedure (                                           input p-host-code                                           ,input X_payer.obj-type                                           ,input X_payer.obj-code                                           ,input tt-fin-doc.curr-code                                           ,output v-recid-schet                                           ,output v-recid-bank).   if v-recid-schet <> ? then do:     find first X_payer-fin-schet no-lock where                 recid(X_payer-fin-schet) = v-recid-schet.     find first X_payer-fin-bank no-lock where                 recid(X_payer-fin-bank) = v-recid-bank.     assign     tt-fin-doc.payer-code-schet = X_payer-fin-schet.code-schet     tt-fin-doc.payer-bank-name = X_payer-fin-bank.bank-name       tt-fin-doc.payer-bank-city = X_payer-fin-bank.bank-city       tt-fin-doc.payer-dop1       = X_payer-fin-schet.dop1     tt-fin-doc.payer-dop2       = X_payer-fin-schet.dop2     tt-fin-doc.payer-bik = X_payer-fin-bank.bik     tt-fin-doc.payer-r-schet = X_payer-fin-schet.r-schet     tt-fin-doc.payer-c-schet = X_payer-fin-schet.c-schet     .   end.   else do:     RELEASE X_payer-fin-schet.     RELEASE X_payer-fin-bank.     assign     tt-fin-doc.payer-code-schet = 0     tt-fin-doc.payer-bank-name = "":U     tt-fin-doc.payer-bank-city = "":U     tt-fin-doc.payer-dop1      = "":U     tt-fin-doc.payer-dop2      = "":U     tt-fin-doc.payer-bik = "":U     tt-fin-doc.payer-r-schet = "":U     tt-fin-doc.payer-c-schet = "":U     .   end. display tt-fin-doc.payer-type tt-fin-doc.payer-code tt-fin-doc.payer-name tt-fin-doc.payer-inn tt-fin-doc.payer-kpp tt-fin-doc.payer-bank-name tt-fin-doc.payer-bank-city tt-fin-doc.payer-bik tt-fin-doc.payer-r-schet tt-fin-doc.payer-c-schet with frame Dialog-Frame.
     3084   CASE X_payer.obj-type:   when 'чел':U then do:              find first X_payer-person no-lock where               X_payer-person.psn-code = X_payer.obj-code .   end.   when 'орг':U then do:     find first X_payer-firm no-lock where               X_payer-firm.firm-code = X_payer.obj-code .   end. END CASE. assign tt-fin-doc.payer-sign1  = if X_payer.obj-type = 'орг':U                              then X_payer-firm.director                             else X_payer.obj-name . display tt-fin-doc.payer-sign1 with frame Dialog-Frame.
     3085   find first ub.CashBook no-lock where ub.CashBook.id = tt-fin-doc.cashbookId no-error .
     3086   if ub.CashBook.cli-code = tt-fin-doc.payer-code and ub.CashBook.cli-type = tt-fin-doc.payer-type then do:
     3087   assign
     3088     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     3089     tt-fin-doc.cor-acc-value  = ub.CashBook.corrPko
     3090     tt-fin-doc.naznach-plat   = ub.CashBook.RuleOsnPko
     3091     .
     3092   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     3093     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3094     and X_fin-code-cor-acc.status_ = integer('0':U)
     3095     no-error .
     3096   if available X_fin-code-cor-acc
     3097     then
     3098   do :
     3099     assign
     3100       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     3101       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     3102       .
     3103   end.
     3104   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     3105     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     3106     and X_fin-code-cor-acc1.status_ = integer('0':U)
     3107     no-error .
     3108   if available X_fin-code-cor-acc1
     3109     then
     3110   do :
     3111     assign
     3112       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     3113       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     3114       .
     3115   end.
     3116   assign
     3117     tt-fin-doc.including = "@, в том числе НДС" .
     3118     paramVne = "" .
     3119   end.
     3120   else
     3121   do:
     3122     if getCliKassa(tt-fin-doc.payer-type, tt-fin-doc.payer-code, "Vnecli", tt-fin-doc.cashbookId) then do:
     3123   assign
     3124     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     3125     .
     3126   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3127     and ub.CashBookRule.Obj-type   = 'всем':U
     3128     and ub.CashBookRule.Obj-code   = 0
     3129     and ub.CashBookRule.Code       = "corrPkoVne"
     3130     no-error.
     3131   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
