     5614                          else 0)
     5615   tt-fin-doc.cor-acc-value  = (if available X_fin-code-cor-acc
     5616                          then X_fin-code-cor-acc.code-value
     5617                          else "":U)
     5618   tt-fin-doc.an-uchet-code  = (if available X_fin-code-an-uchet
     5619                           then X_fin-code-an-uchet.fin-code
     5620                           else 0)
     5621   tt-fin-doc.an-uchet-value  = (if available X_fin-code-an-uchet
     5622                           then X_fin-code-an-uchet.code-value
     5623                           else "":U)
     5624   tt-fin-doc.cel-nazn-code  = (if available X_fin-code-cel-nazn
     5625                          then X_fin-code-cel-nazn.fin-code
     5626                          else 0)
     5627   tt-fin-doc.cel-nazn-value  = (if available X_fin-code-cel-nazn
     5628                          then X_fin-code-cel-nazn.code-value
     5629                          else "":U)
     5630   tt-fin-doc.curr-code
