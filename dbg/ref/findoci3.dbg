     5218       DISPLAY tt-fin-doc.prn-doc-code tt-fin-doc.vid-plat tt-fin-doc.fin-doc-code
     5219             tt-fin-doc.perm-date tt-fin-doc.user-name-perm tt-fin-doc.pay-date
     5220             tt-fin-doc.doc-date tt-fin-doc.user-name-doc tt-fin-doc.obj-type
     5221             tt-fin-doc.obj-code tt-fin-doc.user-name-pl tt-fin-doc.sttm-code
     5222             tt-fin-doc.fact-date tt-fin-doc.user-name-fact
     5223             tt-fin-doc.cor-acc-value tt-fin-doc.an-uchet-value
