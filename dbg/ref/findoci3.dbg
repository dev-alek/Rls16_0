     5259   PROCEDURE fill-main-table :
     5260   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5261   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     5262     (output v-db-num
     5263     )  .
     5264   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5265   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     5266     (input  p-host-code
     5267     ,output v-base-code
     5268     )  .
     5269   for each tt-fin-doc:
     5270     delete tt-fin-doc.
     5271   end.
     5272   for each tt0-fin-doc-attr:
     5273     delete tt0-fin-doc-attr.
     5274   end.
     5275   for each tt0-fin-doc-tax:
     5276     delete tt0-fin-doc-tax.
     5277   end.
     5278   if p-mode = 'ИЗМЕНЕНИЕ':U
     5279   or p-mode = 'ПРОСМОТР':U
     5280   or p-mode = 'КОПИРОВАНИЕ':U
     5281   then do:
     5282     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     5283       find first locked_fin-doc EXclusive-lock where
     5284                     recid(locked_fin-doc) = p-doc-rec no-wait no-error.
     5285       if locked locked_fin-doc then do:
     5286         message
     5287         substitute("Запись &1 занята", p-fin-doc-code)
     5288         view-as alert-box error .
     5289         undo, return error.
     5290       end.
     5291     end.
     5292     else do:
     5293       find first locked_fin-doc no-lock where
     5294                   recid(locked_fin-doc) = p-doc-rec no-error .
     5295         if not available locked_fin-doc then do:
     5296           find first locked_fin-doc no-lock where
     5297                       locked_fin-doc.host-code = p-host-code
     5298                   AND locked_fin-doc.fin-doc-code = p-fin-doc-code no-error .
     5299         end.
     5300     end.
     5301     if not available locked_fin-doc then do:
     5302       message
     5303       substitute("&1 &2 &3&4 Не найдена запись &5"
     5304                   ,vss-workfile
     5305                   ,vss-revision
     5306                   ,vss-description
     5307                   ,chr(10)
     5308                   ,p-fin-doc-code)
     5309       view-as alert-box error .
     5310       undo, return error.
     5311     end.
     5312     if p-mode = 'ИЗМЕНЕНИЕ':U
     5313     AND not (locked_fin-doc.status_ = 'новый':U
     5314               or locked_fin-doc.status_ = 'разрешен':U )
     5315     then do:
     5316       message
     5317       substitute("Финансовый документ &1 находится в статусе &2&3Изменение невозможно"
     5318                 ,p-fin-doc-code
     5319                 ,locked_fin-doc.status_
     5320                 ,chr(10))
     5321       view-as alert-box error .
     5322       undo, return error.
     5323     end.
     5324     create tt-fin-doc.
     5325     if p-mode = 'КОПИРОВАНИЕ':U then do:
     5326       buffer-copy locked_fin-doc
     5327       using
     5328       obj-type
     5329       obj-code
     5330       payer-type
     5331       payer-code
     5332       payer-name
     5333       payer-inn
     5334       payer-kpp
     5335       receiver-code
     5336       receiver-name
     5337       payer-code-schet
     5338       receiver-code-schet
     5339       payer-bank-name
     5340       payer-bank-city
     5341       payer-BIK
     5342       payer-c-schet
     5343       payer-r-schet
     5344       receiver-type
     5345       receiver-code
     5346       receiver-name
     5347       receiver-bank-name
     5348       receiver-bank-city
     5349       receiver-BIK
     5350       receiver-INN
     5351       receiver-kpp
     5352       receiver-c-schet
     5353       receiver-r-schet
     5354       an-uchet-code
     5355       an-uchet-value
     5356       cel-nazn-code
     5357       cel-nazn-value
     5358       contract-code
     5359       contract-curr
     5360       cor-acc-value
     5361       cor-acc
     5362       curr-code
     5363       naznach-plat
     5364       sum-doc
     5365       stat-pl
     5366       ocher-pl
     5367       payer-sign1
     5368       payer-sign2
     5369       CashBookId
     5370       to tt-fin-doc
     5371       assign
     5372       tt-fin-doc.host-code = p-host-code
     5373       .
     5374     end.
     5375     else do:
     5376       buffer-copy locked_fin-doc to tt-fin-doc.
     5377     end.
     5378   end.
     5379   if p-mode = 'ДОБАВЛЕНИЕ':U
     5380   or p-mode = 'КОПИРОВАНИЕ':U then do:
     5381     run ref/finfnoco.p (
     5382                     INPUT parParentProc
     5383                   ,INPUT this-procedure:handle
     5384                   ,input p-curr-host-code
     5385                   ,input (p-mode + chr(4) + 'manual':U)
     5386                   ,input p-host-code
     5387                   ,input p-doc-rec
     5388                   ,input p-fin-doc-code
     5389                   ,input 'ппп':U
     5390                   ,input 'ппп':U
     5391                   ,input p-obj-type
     5392                   ,input p-obj-code
     5393                   ,input p-contract-code
     5394                   ,input p-ob-doc-code
     5395                   ,input p-payer-type
     5396                   ,input p-payer-code
     5397                   ,input p-payer-code-schet
     5398                   ,input 'орг':U
     5399                   ,input p-host-code
     5400                   ,input p-receiver-code-schet
     5401                   ,input p-curr-code
     5402                   ,input p-cor-acc
     5403                   ,input p-cor-acc1
     5404                   ,input p-an-uchet-code
     5405                   ,input p-cel-nazn-code
     5406                   ,input (if available tt-fin-doc then tt-fin-doc.CashBookId else 0)
     5407                   ,input ""
     5408                   ,INPUT-OUTPUT table tt-fin-doc
     5409                   ,INPUT-OUTPUT table ttc-fin-doc
     5410                   ,output table tt0-fin-doc-attr
     5411                   ,output v-limit-access ) no-error .
     5412   end.
     5413   else do:
     5414     run ref/finfnoco.p (
     5415                     INPUT parParentProc
     5416                   ,INPUT this-procedure:handle
     5417                   ,input p-curr-host-code
     5418                   ,input p-mode  + chr(4) + 'manual':U
     5419                   ,input p-host-code
     5420                   ,input p-doc-rec
     5421                   ,input tt-fin-doc.fin-doc-code
     5422                   ,input 'ппп':U
     5423                   ,input tt-fin-doc.fin-ext-doc-type
     5424                   ,input tt-fin-doc.obj-type
     5425                   ,input tt-fin-doc.obj-code
     5426                   ,input tt-fin-doc.contract-code
     5427                   ,input p-ob-doc-code
     5428                   ,input tt-fin-doc.payer-type
     5429                   ,input tt-fin-doc.payer-code
     5430                   ,input tt-fin-doc.payer-code-schet
     5431                   ,input 'орг':U
     5432                   ,input p-host-code
     5433                   ,input tt-fin-doc.receiver-code-schet
     5434                   ,input tt-fin-doc.curr-code
     5435                   ,input tt-fin-doc.cor-acc
     5436                   ,input tt-fin-doc.cor-acc1
     5437                   ,input tt-fin-doc.an-uchet-code
     5438                   ,input tt-fin-doc.cel-nazn-code
     5439                   ,input tt-fin-doc.CashBookId
     5440                   ,input ""
     5441                   ,INPUT-OUTPUT table ttc-fin-doc
     5442                   ,INPUT-OUTPUT table tt-fin-doc
     5443                   ,output table tt0-fin-doc-attr
     5444                   ,output v-limit-access ) no-error .
     5445   end.
     5446   if error-status:error then do:
     5447     if not return-value = "exit" then do:
     5448       message
     5449       vss-workfile vss-revision vss-description skip
     5450       error-status:get-message(1) skip
     5451       return-value
     5452       view-as alert-box .
     5453     end.
     5454     undo, return error.
     5455   end.
     5456   find first tt-fin-doc.
     5457   run recalc in this-procedure ( input "curr-code":U).
     5458   if p-mode = 'КОПИРОВАНИЕ':U then do:
     5459     assign
     5460     v-copy-mode = yes
     5461     p-mode = 'ДОБАВЛЕНИЕ':U.
     5462     if tt-fin-doc.curr-code = 0  then
     5463     run recalc in this-procedure ( input "sum-doc").
     5464   end.
     5465   END PROCEDURE.
     5466   PROCEDURE Myenable :
     5467   tt-fin-doc.payer-inn:label in frame Dialog-Frame = "ИНН".
     5468   tt-fin-doc.receiver-inn:label in frame Dialog-Frame = "ИНН".
     5469   tt-fin-doc.payer-kpp:label in frame Dialog-Frame = "КПП".
     5470   tt-fin-doc.receiver-kpp:label in frame Dialog-Frame = "КПП".
     5471   define variable v-inn like ub.firm.inn no-undo .
     5472   define variable v-kpp like ub.firm.kpp no-undo .
     5473   define variable g-log as logical no-undo.
     5474   assign
     5475       tt-fin-doc.sum-rubl :label in frame Dialog-Frame = "Рубли"
     5476   .
     5477   run uf-get in this-procedure(
     5478       input  ('findoci-p':U + chr(4) + 'ппп':U)
     5479       ,input  g#userid
     5480       ,output v-uf-List_
     5481       ,output v-uf-Naim
     5482       ,output v-uf-print-graft
     5483       ,output v-uf-sort-gr
     5484       ,output v-uf-type-price
     5485       ,output v-uf-type-val
     5486   )  no-error.
     5487   if not error-status:error
     5488   and not v-uf-LIst_ = "":U
     5489   then do:
     5490       assign
     5491       v-view =  entry(1, v-uf-List_, chr(4))
     5492       .
     5493   end.
     5494   assign
     5495   frame Dialog-Frame:title = frame Dialog-Frame:title + chr(32) + x_clients-host.obj-name
     5496   tt-fin-doc.payer-type:radio-buttons = "Орг" + chr(44) + 'орг':U + chr(44) +
     5497                                            "Чел" + chr(44) + 'чел':U
     5498   rs-view:radio-buttons = "&Полн." + chr(44) + "full":U +  chr(44) +
     5499                                       "&Сокращ." + chr(44) + "brief":U + chr(44) +
     5500                                       "&Дог-р" + chr(44) + "contract":U
     5501   tt-fin-doc.obj-type:radio-buttons = "Маг" + chr(44) + 'маг':U + chr(44) +
     5502                                       "Скл" + chr(44) + 'скл':U
     5503   tt-fin-doc.vid-plat:list-items = 'почтой,телеграфом,электронно,':U
     5504   rs-view = v-view
     5505   v-an-uchet-tab-order = (if X_sysconf.is-corr-acc then "cor-acc-value,b-cor-acc," else "":U) +
     5506                          (if X_sysconf.is-an-uchet then "an-uchet-value,b-an-uchet," else "":U) +
     5507                          (if X_sysconf.is-code-cel-nazn then "cel-nazn-value,b-cel-nazn," else "":U)
     5508   v-an-uchet-tab-order =  "cor-acc-value,b-cor-acc," +
     5509                           "an-uchet-value,b-an-uchet," +
     5510                           "cel-nazn-value,b-cel-nazn,"
     5511   v-limit-access = (if p-mode = 'ПРОСМОТР':U then 10 else v-limit-access)
     5512   tt-fin-doc.obj-type:screen-value  = (if tt-fin-doc.obj-type = 'маг':U
     5513                                       or tt-fin-doc.obj-type = 'скл':U
     5514                                       then tt-fin-doc.obj-type
     5515                                       else tt-fin-doc.obj-type:screen-value)
     5516   .
     5517   if p-mode = 'ПРОСМОТР':U and
     5518   tt-fin-doc.contract-code = 0 then do:
     5519       assign
     5520       g-log = rs-view:disable(radio-label("contract":U, RS-view:radio-buttons))
     5521       .
     5522       if rs-view = "contract":U then
     5523       assign
     5524       rs-view = "full":U
     5525       v-not-uf-set = yes.
     5526   end.
     5527   find first X_currency no-lock where
     5528                 X_currency.curr-code = tt-fin-doc.curr-code.
     5529   assign
     5530     f-curr-abbr = X_Currency.curr-abbr.
     5531   if p-mode = 'ДОБАВЛЕНИЕ':U and tt-fin-doc.payer-type = "":U  then do:
     5532     assign
     5533     tt-fin-doc.payer-type = 'орг':U
     5534     .
     5535   end.
     5536   IF tt-fin-doc.sttm-code <> 0 THEN DO:
     5537     FIND FIRST X_fin-statement NO-LOCK WHERE
     5538               X_fin-statement.host-code  = tt-fin-doc.host-code
     5539           AND X_fin-statement.sttm-code  = tt-fin-doc.sttm-code NO-ERROR.
     5540     IF NOT AVAILABLE X_fin-statement THEN DO:
     5541       ASSIGN
     5542       v-sttm-prn-doc-CODE = "@НЕИЗВЕСТНАЯ ВЫПИСКА".
     5543     END.
     5544     ELSE DO:
     5545         ASSIGN
     5546         v-sttm-prn-doc-CODE = X_fin-statement.prn-doc-code.
     5547     END.
     5548   END.
     5549   if p-mode = 'ПРОСМОТР':U then do:
     5550       run proc-color-widgets in this-procedure("f-an-uchet-descr,f-cel-nazn-descr,f-contract-curr-abbr,f-contract-date,f-contract-prn-code,f-contract-rate," +                         "f-contract-scale,f-contract-type,f-cor-acc-descr,base-rate,base-scale,curr-code,exch-rate,exch-scale,contract-rate,contract-scale," +                         "fact-date,fin-doc-code,payer-code,payer-type,pay-date,perm-date,PS,receiver-code,receiver-type,sum-base,sum-rubl,sum-contr," +                         "user-name-doc,user-name-fact,user-name-perm.user-name-pl", no, yes, ?, ?).
     5551       run proc-color-widgets in this-procedure("F-curr-abbr,an-uchet-value,cel-nazn-value,cor-acc-value,doc-date," +                       "naznach-plat,payer-name,payer-inn,payer-kpp,payer-bank-name,payer-bank-city,payer-bik,payer-r-schet,payer-c-schet," +                       "prn-doc-code,receiver-name,receiver-inn,receiver-kpp,receiver-bank-name,receiver-bank-city,receiver-bik,receiver-r-schet,receiver-c-schet,payer-sign1,payer-sign2" +                       "sum-doc", no, yes, ?, ?).
     5552   end.
     5553   display
     5554   tt-fin-doc.exch-rate
     5555   tt-fin-doc.exch-scale
     5556   tt-fin-doc.sum-doc
     5557   (tt-fin-doc.sum-contr - tt-fin-doc.con-sum-contr ) @ f-rest-con-sum
     5558   tt-fin-doc.prn-doc-code
