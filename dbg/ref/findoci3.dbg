     4619     define variable v-sum-vat      like ub.fin-doc-tax.sum-vat-line-doc no-undo .
     4620     define variable v-sum-vat-chr  as character no-undo .
     4621     define variable v-each-vat-chr as character no-undo.
     4622     define variable v-vat-pc       as integer no-undo .
     4623   end procedure.
     4624   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
