     5576       .
     5577   end.
     5578   run change-view in this-procedure(rs-view).
     5579   VIEW FRAME Dialog-Frame.
     5580   if p-mode <> 'ПРОСМОТР':U then APPLY "ENTRY" to tt-fin-doc.prn-doc-code.
     5581   END PROCEDURE.
     5582   PROCEDURE proc-save :
     5583   define input parameter p-save as logical no-undo .
     5584   if p-mode = 'ПРОСМОТР':U or not available tt-fin-doc then do:
     5585       return error.
     5586   end.
     5587   assign
