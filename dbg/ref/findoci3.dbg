     5096     tt-fin-doc.sttm-code
     5097     v-sttm-prn-doc-code
     5098     with frame Dialog-Frame
     5099     .
     5100   ENABLE
     5101   b-quit
     5102   B-tax
     5103   b-cards
     5104   b-other
     5105   B-print when p-mode <> 'ДОБАВЛЕНИЕ':U
     5106   B-hist when p-mode <> 'ДОБАВЛЕНИЕ':U
     5107   B-Help
     5108   RS-view
     5109   b-payer-view
     5110   b-receiver-view
     5111   WITH FRAME Dialog-Frame.
     5112   if p-mode <> 'ПРОСМОТР':U then do:
     5113     ENABLE
     5114     B-exit
     5115     tt-fin-doc.prn-doc-code  when v-limit-access < 2
     5116     tt-fin-doc.doc-date when v-limit-access = 0
     5117     b-calc  when v-limit-access = 0
     5118     b-obj   when not v-is-auto-obj
     5119     tt-fin-doc.obj-type   when not v-is-auto-obj
     5120     tt-fin-doc.obj-code   when not v-is-auto-obj
     5121     tt-fin-doc.PS
     5122     WITH FRAME Dialog-Frame.
     5123     if v-limit-access = 0 then do:
     5124       ENABLE
     5125       tt-fin-doc.vid-plat
     5126       tt-fin-doc.curr-code
     5127       B-currency
     5128       tt-fin-doc.sum-doc
     5129       b-receiver-schet
     5130       tt-fin-doc.payer-code when tt-fin-doc.contract-code = 0
     5131       B-payer               when tt-fin-doc.contract-code = 0
     5132       b-payer-schet
     5133       tt-fin-doc.payer-type when tt-fin-doc.contract-code = 0
     5134       tt-fin-doc.payer-name when tt-fin-doc.contract-code = 0
     5135       tt-fin-doc.naznach-plat
     5136       tt-fin-doc.payer-sign1
     5137       tt-fin-doc.payer-sign2
     5138       WITH FRAME Dialog-Frame.
     5139       end.
     5140   end.
     5141   else do:
     5142     assign
     5143     b-quit:label = "&Выход"
     5144     b-quit:column = 1
     5145     .
     5146   end.
     5147   run hide-view-currency in this-procedure.
     5148   CASE p-view:
     5149     when "full":U then do:
     5150       assign
     5151       v-tab-order = "b-exit,b-quit,b-tax,b-cards,b-print,b-hist,b-help," + "prn-doc-code,vid-plat,doc-date,obj-type,obj-code,b-obj," +                             v-an-uchet-tab-order +                             "payer-type,payer-code,b-payer,payer-name,b-payer-schet,b-payer-view," +                              v-sum-curr-tab-order + "b-receiver-schet,b-receiver-view," +                              "naznach-plat,PS,payer-sign1,payer-sign2"
     5152       .
     5153       IF AVAILABLE tt-fin-doc THEN
     5154       display
     5155       f-bank
     5156       tt-fin-doc.receiver-type
     5157       tt-fin-doc.receiver-code
     5158       tt-fin-doc.receiver-name
     5159       tt-fin-doc.receiver-inn
     5160       tt-fin-doc.receiver-kpp
     5161       with frame Dialog-Frame
     5162       .
     5163       display
     5164       tt-fin-doc.cor-acc-value
     5165       f-cor-acc-descr
     5166       tt-fin-doc.an-uchet-value
     5167       f-an-uchet-descr
     5168       tt-fin-doc.cel-nazn-value
     5169       f-cel-nazn-descr
     5170       with frame Dialog-Frame
     5171       .
     5172       if v-limit-access < 3 then do:
     5173         ENABLE
     5174         tt-fin-doc.cor-acc-value
     5175         B-cor-acc
     5176         tt-fin-doc.an-uchet-value
     5177         B-an-uchet
     5178         tt-fin-doc.cel-nazn-value
     5179         B-cel-nazn
     5180         WITH FRAME Dialog-Frame.
     5181       end.
     5182     end.
     5183     when "brief":U then do:
     5184        assign
     5185        v-tab-order = "b-exit,b-quit,b-tax,b-cards,b-print,b-hist,b-help," +                              "prn-doc-code,vid-plat,doc-date," +                             "obj-type,obj-code,b-obj,payer-type,payer-code,b-payer,payer-name,b-payer-schet,b-payer-view," +                              v-sum-curr-tab-order + "b-receiver-schet,b-receiver-view," +                              "naznach-plat,PS,payer-sign1,payer-sign2"
     5186        .
     5187     end.
     5188     when "contract":U then do:
     5189       assign
     5190       v-tab-order = "b-exit,b-quit,b-tax,b-cards,b-print,b-hist,b-help," +                              "prn-doc-code,vid-plat,doc-date,obj-type,obj-code,b-obj," +                              v-contract-tab-order +                              "payer-type,payer-code,b-payer,payer-name,b-payer-schet,b-payer-view," +                              v-sum-curr-tab-order + "b-receiver-schet,b-receiver-view," +                              "naznach-plat,PS,payer-sign1,payer-sign2"
     5191       .
     5192       display
     5193       b-contract-view
     5194       f-contract-date when tt-fin-doc.contract-code <> 0
     5195       f-contract-prn-code when tt-fin-doc.contract-code <> 0
     5196       f-contract-type when tt-fin-doc.contract-code <> 0
     5197       f-contract-curr-abbr when tt-fin-doc.contract-code <> 0
     5198       tt-fin-doc.contract-curr when tt-fin-doc.contract-code <> 0
     5199       with frame Dialog-Frame
     5200       .
     5201       ENABLE
     5202       b-contract-view
     5203       with frame Dialog-Frame.
     5204     end.
     5205   END CASE.
     5206   END PROCEDURE.
     5207   PROCEDURE disable_UI :
     5208     HIDE FRAME Dialog-Frame.
     5209   END PROCEDURE.
     5210   PROCEDURE enable_UI :
     5211     OPEN QUERY Dialog-Frame FOR EACH locked_fin-doc SHARE-LOCK.
     5212     GET FIRST Dialog-Frame.
     5213     DISPLAY RS-view v-sttm-prn-doc-code f-cor-acc-descr f-an-uchet-descr
     5214             f-contract-curr-abbr f-contract-prn-code f-contract-date
     5215             f-contract-type f-cel-nazn-descr f-rest-con-sum F-curr-abbr f-bank
     5216         WITH FRAME Dialog-Frame.
