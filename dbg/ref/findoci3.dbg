     5225             tt-fin-doc.payer-inn tt-fin-doc.payer-kpp tt-fin-doc.payer-type
     5226             tt-fin-doc.payer-code tt-fin-doc.payer-name tt-fin-doc.payer-bank-name
     5227             tt-fin-doc.payer-bank-city tt-fin-doc.payer-r-schet
     5228             tt-fin-doc.payer-bik tt-fin-doc.payer-c-schet tt-fin-doc.sum-doc
     5229             tt-fin-doc.curr-code tt-fin-doc.exch-rate tt-fin-doc.exch-scale
     5230             tt-fin-doc.sum-rubl tt-fin-doc.base-rate tt-fin-doc.base-scale
     5231             tt-fin-doc.sum-base tt-fin-doc.contract-rate tt-fin-doc.contract-scale
     5232             tt-fin-doc.sum-contr tt-fin-doc.receiver-inn tt-fin-doc.receiver-kpp
     5233             tt-fin-doc.receiver-type tt-fin-doc.receiver-name
