     4484       do:
     4485         display
     4486           tt-fin-doc.contract-rate
     4487           tt-fin-doc.contract-scale
     4488           with frame Dialog-Frame.
     4489         assign
     4490           p-main-widget = "sum-doc":U.
     4491       end.
     4492     end.
     4493     CASE p-main-widget:
     4494       when "sum-doc" then
     4495         do:
     4496           assign
     4497             frame Dialog-Frame
     4498             tt-fin-doc.exch-rate
     4499             tt-fin-doc.exch-scale
     4500             tt-fin-doc.sum-doc
     4501             .
     4502           CASE tt-fin-doc.curr-code:
     4503             when 0 then
     4504               do:
     4505                 assign
     4506                   tt-fin-doc.sum-rubl = tt-fin-doc.sum-doc
     4507                   tt-fin-doc.sum-base = tt-fin-doc.sum-doc / tt-fin-doc.base-rate * tt-fin-doc.base-scale
     4508                   tt-fin-doc.sum-contr = (if tt-fin-doc.contract-curr = 0                                                       then tt-fin-doc.sum-rubl                                                       else tt-fin-doc.sum-rubl / (tt-fin-doc.contract-rate / tt-fin-doc.contract-scale)                                                     )
     4509                   .
     4510               end.
     4511             when v-base-code then
     4512               do:
     4513                 assign
     4514                   tt-fin-doc.sum-rubl = tt-fin-doc.sum-doc * tt-fin-doc.exch-rate / tt-fin-doc.exch-scale
     4515                   tt-fin-doc.sum-base = tt-fin-doc.sum-rubl / tt-fin-doc.base-rate * tt-fin-doc.base-scale
     4516                   tt-fin-doc.sum-contr = (if tt-fin-doc.contract-curr = 0                                                       then tt-fin-doc.sum-rubl                                                       else tt-fin-doc.sum-rubl / (tt-fin-doc.contract-rate / tt-fin-doc.contract-scale)                                                     )
     4517                   .
     4518               end.
     4519             otherwise
     4520             do:
     4521               assign
     4522                 tt-fin-doc.sum-rubl = tt-fin-doc.sum-doc * tt-fin-doc.exch-rate / tt-fin-doc.exch-scale
     4523                 tt-fin-doc.sum-base = tt-fin-doc.sum-rubl / tt-fin-doc.base-rate * tt-fin-doc.base-scale
     4524                 tt-fin-doc.sum-contr = (if tt-fin-doc.contract-curr = 0                                                       then tt-fin-doc.sum-rubl                                                       else tt-fin-doc.sum-rubl / (tt-fin-doc.contract-rate / tt-fin-doc.contract-scale)                                                     )
     4525                 .
     4526             end.
     4527           END CASE.
     4528         end.
     4529     END CASE.
     4530     assign
     4531       f-rest-con-sum = tt-fin-doc.sum-contr - tt-fin-doc.con-sum-contr
     4532       .
     4533     display
     4534       f-rest-con-sum
     4535       with frame Dialog-Frame.
     4536     if tt-fin-doc.sum-doc:visible in frame Dialog-Frame then
     4537       display
     4538         tt-fin-doc.sum-doc
     4539         tt-fin-doc.curr-code
     4540         with frame Dialog-Frame.
     4541     if tt-fin-doc.sum-rubl:visible in frame Dialog-Frame then
     4542       display
     4543         tt-fin-doc.sum-rubl
     4544         tt-fin-doc.exch-rate
     4545         tt-fin-doc.exch-scale
     4546         with frame Dialog-Frame.
     4547     if tt-fin-doc.sum-base:visible in frame Dialog-Frame then
     4548       display
     4549         tt-fin-doc.sum-base
     4550         tt-fin-doc.base-rate
     4551         tt-fin-doc.base-scale
     4552         with frame Dialog-Frame.
     4553     if tt-fin-doc.sum-contr:visible in frame Dialog-Frame then
     4554       display
     4555         tt-fin-doc.sum-contr
     4556         tt-fin-doc.contract-rate
     4557         tt-fin-doc.contract-scale
     4558         with frame Dialog-Frame.
     4559     if not v-first-start then
     4560       run proc-update-sum-vat-chr in this-procedure (input-output v-start).
     4561   END PROCEDURE.
     4562   procedure proc-create-default-tax :
     4563     do
     4564       on error undo, return error
     4565       :
     4566       If p-mode = 'ДОБАВЛЕНИЕ':U then
     4567       do:
     4568         if p-ob-doc-code = "" then
     4569         do:
     4570           find tt0-fin-doc-tax where
     4571             tt0-fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     4572             AND tt0-fin-doc-tax.host-code = tt-fin-doc.host-code no-error .
     4573           if not avail tt0-fin-doc-tax
     4574             and not AMBIGUOUS tt0-fin-doc-tax
     4575             then
     4576           do:
     4577             create tt0-fin-doc-tax.
     4578           end.
     4579           if AMBIGUOUS tt0-fin-doc-tax then return.
     4580           assign
     4581             tt0-fin-doc-tax.fin-doc-code     = tt-fin-doc.fin-doc-code
     4582             tt0-fin-doc-tax.host-code        = tt-fin-doc.host-code
     4583             tt0-fin-doc-tax.line-num         = 1
     4584             tt0-fin-doc-tax.slt-pc           = 0
     4585             tt0-fin-doc-tax.sum-line-doc     = tt-fin-doc.sum-doc
     4586             tt0-fin-doc-tax.sum-slt-line-doc = 0
     4587             tt0-fin-doc-tax.with-slt         = no
     4588             .
     4589           case paramVne:
     4590             when "vne" then do:
     4591             assign
     4592               tt0-fin-doc-tax.sum-vat-line-doc = 0
     4593               tt0-fin-doc-tax.vat-pc           = -1
     4594               tt0-fin-doc-tax.with-vat         = no
     4595               .
     4596             end.
     4597             when "avans" then do:
     4598             assign
     4599               tt0-fin-doc-tax.vat-pc           = 22
     4600               tt0-fin-doc-tax.sum-vat-line-doc = (tt-fin-doc.sum-doc * tt0-fin-doc-tax.vat-pc)/(100 + tt0-fin-doc-tax.vat-pc)
     4601               tt0-fin-doc-tax.with-vat         = yes
     4602               .
     4603             end.
     4604             otherwise do:
     4605             assign
     4606               tt0-fin-doc-tax.sum-vat-line-doc = 0
     4607               tt0-fin-doc-tax.vat-pc           = 0
     4608               tt0-fin-doc-tax.with-vat         = no
     4609               .
     4610             end.
     4611           end case .
     4612           release tt0-fin-doc-tax.
     4613         end.
     4614       end.
     4615     end.
     4616   end procedure.
     4617   procedure proc-update-sum-vat-chr :
