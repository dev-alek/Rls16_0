     4408     (input  tt-fin-doc.curr-code
     4409     ,input  tt-fin-doc.doc-date
     4410     ,output tt-fin-doc.exch-rate
     4411     ,output tt-fin-doc.exch-scale
     4412     ,output v-curr-abbr
     4413     )  .
     4414   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4415   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     4416     (input  tt-fin-doc.contract-curr
     4417     ,input  tt-fin-doc.doc-date
     4418     ,output tt-fin-doc.contract-rate
     4419     ,output tt-fin-doc.contract-scale
     4420     ,output v-curr-abbr
     4421     )  .
     4422       if tt-fin-doc.curr-code <> 0
     4423         or tt-fin-doc.curr-code <> v-base-code
     4424         or tt-fin-doc.curr-code <> tt-fin-doc.contract-curr
     4425         then
     4426       do:
     4427         if tt-fin-doc.curr-code <> 0 then
     4428           display
     4429             tt-fin-doc.exch-rate
     4430             tt-fin-doc.exch-scale
     4431             with frame Dialog-Frame.
     4432         assign
     4433           p-main-widget = "sum-doc":U.
     4434       end.
     4435     end.
     4436     if p-main-widget  = "doc-date":U then
     4437     do:
     4438       assign
     4439         frame Dialog-Frame
     4440         tt-fin-doc.sum-doc
     4441         .
     4442   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4443   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     4444     (input  tt-fin-doc.host-code
     4445     ,input  tt-fin-doc.doc-date
     4446     ,output tt-fin-doc.base-rate
     4447     ,output tt-fin-doc.base-scale
     4448     )  .
     4449   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4450   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     4451     (input  tt-fin-doc.curr-code
     4452     ,input  tt-fin-doc.doc-date
     4453     ,output tt-fin-doc.exch-rate
     4454     ,output tt-fin-doc.exch-scale
     4455     ,output v-curr-abbr
     4456     )  .
     4457   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4458   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     4459     (input  tt-fin-doc.contract-curr
     4460     ,input  tt-fin-doc.doc-date
     4461     ,output tt-fin-doc.contract-rate
     4462     ,output tt-fin-doc.contract-scale
     4463     ,output v-curr-abbr
     4464     )  .
     4465       if tt-fin-doc.base-rate:visible in frame Dialog-Frame then
     4466       do:
     4467         display
     4468           tt-fin-doc.base-rate
     4469           tt-fin-doc.base-scale
     4470           with frame Dialog-Frame.
     4471         assign
     4472           p-main-widget = "sum-doc":U.
     4473       end.
     4474       if tt-fin-doc.exch-rate:visible in frame Dialog-Frame then
     4475       do:
     4476         display
     4477           tt-fin-doc.exch-rate
     4478           tt-fin-doc.exch-scale
     4479           with frame Dialog-Frame.
     4480         assign
     4481           p-main-widget = "sum-doc":U.
     4482       end.
