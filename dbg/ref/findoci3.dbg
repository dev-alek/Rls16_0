     4104     apply "entry":u to self  .
     4105     if focus :handle <> self :handle  then do:
     4106       return no-apply .
     4107     end.
     4108   end.
     4109   assign
     4110     v-sum-doc = tt-fin-doc.sum-doc
     4111     tt-fin-doc.sum-doc
     4112     .
     4113   if v-sum-doc <> tt-fin-doc.sum-doc then
     4114     run recalc in this-procedure("sum-doc").
     4115   END.
     4116   PROCEDURE check-sums-rate :
     4117     define variable v-exch-rate  like ub.fin-doc.sum-doc no-undo .
     4118     define variable v-exch-scale like ub.fin-doc.sum-doc no-undo .
     4119   END PROCEDURE.
     4120   PROCEDURE disable-enable :
     4121     define input parameter p-main-widget as character no-undo.
     4122     define input parameter p-main-curr as character no-undo .
     4123     disable
     4124       tt-fin-doc.sum-doc
     4125       tt-fin-doc.sum-rubl
     4126       tt-fin-doc.sum-base
     4127       tt-fin-doc.base-rate
     4128       tt-fin-doc.base-scale
     4129       tt-fin-doc.exch-rate
     4130       tt-fin-doc.exch-scale
     4131       tt-fin-doc.sum-contr
     4132       tt-fin-doc.contract-rate
     4133       tt-fin-doc.contract-scale
     4134       with frame Dialog-Frame .
     4135     assign
     4136       v-main-sum  = if p-main-widget <> "":U then p-main-widget else v-main-sum
     4137       v-main-curr = if p-main-curr <> "":U then p-main-curr else v-main-curr
     4138       .
     4139     if v-limit-access > 0 then
     4140     do:
     4141       display
     4142         tt-fin-doc.sum-rubl
     4143         when v-rubf
     4144         tt-fin-doc.sum-base
     4145         when v-basef
     4146         tt-fin-doc.exch-rate
     4147         when v-exchf
     4148         tt-fin-doc.exch-scale
     4149         when v-exchf
     4150         tt-fin-doc.base-rate
     4151         when v-basef
     4152         tt-fin-doc.base-scale
     4153         when v-basef
     4154         tt-fin-doc.sum-contr
     4155         when v-contractf
     4156         tt-fin-doc.contract-rate
     4157         when v-contractratef
     4158         tt-fin-doc.contract-scale
     4159         when v-contractratef
     4160         with frame Dialog-Frame.
     4161       return.
     4162     end.
     4163     CASE p-main-widget:
     4164       when "sum-doc" then
     4165         do:
     4166           enable
     4167             tt-fin-doc.sum-doc
     4168             with frame Dialog-Frame.
     4169           APPLY "ENTRY" to tt-fin-doc.sum-doc.
     4170         end.
     4171     END CASE.
     4172     display
     4173       tt-fin-doc.sum-rubl
     4174       when v-rubf
     4175       tt-fin-doc.sum-base
     4176       when v-basef
     4177       tt-fin-doc.exch-rate
     4178       when v-exchf
     4179       tt-fin-doc.exch-scale
     4180       when v-exchf
     4181       tt-fin-doc.base-rate
     4182       when v-basef
     4183       tt-fin-doc.base-scale
     4184       when v-basef
     4185       tt-fin-doc.sum-contr
     4186       when v-contractf
     4187       tt-fin-doc.contract-rate
     4188       when v-contractratef
     4189       tt-fin-doc.contract-scale
     4190       when v-contractratef
     4191       with frame Dialog-Frame.
     4192     CASE rs-view:
     4193       when "full":u then
     4194         do:
     4195           assign
     4196             v-tab-order = "b-exit,b-quit,b-tax,b-cards,b-print,b-hist,b-help," + "prn-doc-code,vid-plat,doc-date,obj-type,obj-code,b-obj," +                             v-an-uchet-tab-order +                             "payer-type,payer-code,b-payer,payer-name,b-payer-schet,b-payer-view," +                              v-sum-curr-tab-order + "b-receiver-schet,b-receiver-view," +                              "naznach-plat,PS,payer-sign1,payer-sign2"
     4197             .
     4198         end.
     4199       when "brief":u then
     4200         do:
     4201           assign
     4202             v-tab-order = "b-exit,b-quit,b-tax,b-cards,b-print,b-hist,b-help," +                              "prn-doc-code,vid-plat,doc-date," +                             "obj-type,obj-code,b-obj,payer-type,payer-code,b-payer,payer-name,b-payer-schet,b-payer-view," +                              v-sum-curr-tab-order + "b-receiver-schet,b-receiver-view," +                              "naznach-plat,PS,payer-sign1,payer-sign2"
     4203             .
     4204         end.
     4205       when "contract":u then
     4206         do:
     4207           assign
     4208             v-tab-order = "b-exit,b-quit,b-tax,b-cards,b-print,b-hist,b-help," +                              "prn-doc-code,vid-plat,doc-date,obj-type,obj-code,b-obj," +                              v-contract-tab-order +                              "payer-type,payer-code,b-payer,payer-name,b-payer-schet,b-payer-view," +                              v-sum-curr-tab-order + "b-receiver-schet,b-receiver-view," +                              "naznach-plat,PS,payer-sign1,payer-sign2"
     4209             .
     4210         end.
     4211     END CASE.
     4212   END PROCEDURE.
     4213   define new global shared variable g#lib-farh as handle no-undo .
     4214   PROCEDURE fill-tables :
     4215     define buffer buf_fin-doc-tax  for ub.fin-doc-tax.
     4216     define buffer buf_fin-doc-attr for ub.fin-doc-attr.
     4217     define buffer buf_fin-ob-tax   for ub.fin-ob-tax.
     4218     define buffer buf_fin-connect  for ub.fin-connect.
     4219     define buffer buf_fin-ob       for ub.fin-ob.
     4220     define buffer buf_payment      for ub.payment.
     4221     if p-mode = 'ДОБАВЛЕНИЕ':U
     4222       AND p-ob-doc-code <> "" then
     4223     do:
     4224       for each buf_fin-ob-tax no-lock where
     4225         buf_fin-ob-tax.host-code = tt-fin-doc.fin-doc-code
     4226         AND buf_fin-ob-tax.doc-code = p-ob-doc-code:
     4227         create tt0-fin-doc-tax.
     4228         buffer-copy buf_fin-ob-tax to tt0-fin-doc-tax.
     4229       end.
     4230       return.
     4231     end.
     4232     if p-mode = 'ДОБАВЛЕНИЕ':U
     4233       and v-copy-mode = yes then
     4234     do:
     4235       for each buf_fin-doc-tax no-lock where
     4236         buf_fin-doc-tax.host-code = locked_fin-doc.host-code
     4237         AND buf_fin-doc-tax.fin-doc-code = locked_fin-doc.fin-doc-code
     4238         :
     4239         create tt0-fin-doc-tax.
     4240         buffer-copy buf_fin-doc-tax except fin-doc-code to tt0-fin-doc-tax
     4241           assign
     4242           tt0-fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     4243           .
     4244       end.
     4245       for each buf_payment no-lock where
     4246         buf_payment.source-type = 'платеж':U
     4247         AND buf_payment.source-ref = string(locked_fin-doc.fin-doc-code)
     4248         :
     4249         create tt0-payment.
     4250         buffer-copy buf_payment except source-ref to tt0-payment
     4251           assign
     4252           tt0-payment.source-ref = string(tt-fin-doc.fin-doc-code)
     4253           .
     4254       end.
     4255       for each buf_fin-doc-attr no-lock where
     4256         buf_fin-doc-attr.host-code = locked_fin-doc.host-code
     4257         AND buf_fin-doc-attr.fin-doc-code = locked_fin-doc.fin-doc-code
     4258         :
     4259         create tt0-fin-doc-attr.
     4260         buffer-copy buf_fin-doc-attr to tt0-fin-doc-attr
     4261           assign
     4262           tt0-fin-doc-attr.fin-doc-code = tt-fin-doc.fin-doc-code
     4263           .
     4264       end.
     4265     end.
     4266     else
     4267     do:
     4268       for each buf_fin-doc-tax no-lock where
     4269         buf_fin-doc-tax.host-code = tt-fin-doc.host-code
     4270         AND buf_fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     4271         :
     4272         create tt0-fin-doc-tax.
     4273         buffer-copy buf_fin-doc-tax to tt0-fin-doc-tax.
     4274       end.
     4275       for each buf_payment no-lock where
     4276         buf_payment.source-type = 'платеж':U
     4277         AND buf_payment.source-ref = string(tt-fin-doc.fin-doc-code)
     4278         :
     4279         create tt0-payment.
     4280         buffer-copy buf_payment to tt0-payment.
     4281       end.
     4282       for each buf_fin-doc-attr no-lock where
     4283         buf_fin-doc-attr.host-code = tt-fin-doc.host-code
     4284         AND buf_fin-doc-attr.fin-doc-code = tt-fin-doc.fin-doc-code
     4285         :
     4286         create tt0-fin-doc-attr.
     4287         buffer-copy buf_fin-doc-attr to tt0-fin-doc-attr.
     4288       end.
     4289       for each tt0-fin-doc-attr no-lock where
     4290         tt0-fin-doc-attr.host-code = tt-fin-doc.host-code
     4291         AND tt0-fin-doc-attr.fin-doc-code = tt-fin-doc.fin-doc-code
     4292         :
     4293       end.
     4294     end.
     4295   if (valid-handle(g#lib-farh) <> true) then do:   run str/lib-farh.p persistent no-error .   if error-status :error or (valid-handle(g#lib-farh) <> true) then do:     message       "Error starting lib-farh.p" skip       g#lib-farh skip       g#lib-farh :type skip       g#lib-farh :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-farh_fautoobj in g#lib-farh
     4296   (input tt-fin-doc.host-code
     4297   ,input tt-fin-doc.fin-doc-code
     4298   ,output v-is-auto-obj
     4299   )
     4300   .
     4301     if getCliKassa(tt-fin-doc.payer-type, tt-fin-doc.payer-code, "Vnecli", tt-fin-doc.cashbookId) then paramVne = "vne" .
     4302     else if getCliKassa(tt-fin-doc.payer-type, tt-fin-doc.payer-code, "Avanscli", tt-fin-doc.cashbookId) then paramVne = "avans" .
     4303     else paramVne = "" .
     4304     run proc-update-sum-vat-chr in this-procedure (input-output v-start).
     4305   END PROCEDURE.
     4306   PROCEDURE hide-view-currency :
     4307     define buffer buf_currency for ub.currency.
     4308     assign
     4309       v-rubf          = no
     4310       v-exchf         = no
     4311       v-basef         = no
     4312       v-baseratef     = no
     4313       v-contractf     = no
     4314       v-contractratef = no
     4315       .
     4316     hide
     4317       tt-fin-doc.sum-rubl in frame Dialog-Frame
     4318       tt-fin-doc.exch-rate
     4319       tt-fin-doc.exch-scale
     4320       tt-fin-doc.sum-base
     4321       tt-fin-doc.base-rate
     4322       tt-fin-doc.base-scale
     4323       tt-fin-doc.sum-contr
     4324       tt-fin-doc.contract-rate
     4325       tt-fin-doc.contract-scale
     4326       in frame Dialog-Frame .
     4327     if tt-fin-doc.curr-code <> 0 then
     4328     do:
     4329       if tt-fin-doc.curr-code:visible then
     4330         display
     4331           tt-fin-doc.exch-rate
     4332           tt-fin-doc.exch-scale
     4333           tt-fin-doc.sum-rubl
     4334           with frame Dialog-Frame.
     4335       assign
     4336         v-rubf  = yes
     4337         v-exchf = yes
     4338         .
     4339     end.
     4340     if v-base-code <> tt-fin-doc.curr-code
     4341       and v-base-code <> 0
     4342       then
     4343     do:
     4344       find first buf_currency no-lock where
     4345         buf_currency.curr-code = v-base-code .
     4346       assign
     4347         tt-fin-doc.sum-base:label = "Б.в.("  + buf_currency.curr-abbr + ")":U
     4348         .
     4349       if tt-fin-doc.curr-code:visible then
     4350         display
     4351           tt-fin-doc.base-rate
     4352           tt-fin-doc.base-scale
     4353           tt-fin-doc.sum-base
     4354           with frame Dialog-Frame.
     4355       assign
     4356         v-basef     = yes
     4357         v-baseratef = yes
     4358         .
     4359     end.
     4360     if tt-fin-doc.contract-code  <> 0 and
     4361       (tt-fin-doc.contract-curr <> 0
     4362       and tt-fin-doc.contract-curr <> tt-fin-doc.curr-code
     4363       and tt-fin-doc.contract-curr <> v-base-code
     4364       )
     4365       then
     4366     do:
     4367       find first buf_currency no-lock where
     4368         buf_currency.curr-code = tt-fin-doc.contract-curr .
     4369       assign
     4370         tt-fin-doc.sum-contr:label = "Вал.дог.("  + buf_currency.curr-abbr + ")":U
     4371         .
     4372       if tt-fin-doc.curr-code:visible then
     4373         display
     4374           tt-fin-doc.sum-contr
     4375           tt-fin-doc.contract-rate
     4376           tt-fin-doc.contract-scale
     4377           with frame Dialog-Frame.
     4378       assign
     4379         v-contractf     = yes
     4380         v-contractratef = yes
     4381         .
     4382     end.
     4383     assign
     4384       v-sum-curr-tab-order = v-sum-doc-tab-order
     4385       .
     4386     run disable-enable in this-procedure (v-main-sum, v-main-curr).
     4387   END PROCEDURE.
     4388   PROCEDURE recalc :
     4389     define input parameter p-main-widget as character no-undo.
     4390     define variable v-curr-abbr      like ub.currency.curr-abbr no-undo.
     4391     define variable v-contract-rate  like ub.fin-doc.exch-rate no-undo.
     4392     define variable v-contract-scale like ub.fin-doc.exch-scale no-undo.
     4393     if p-main-widget = "curr-code":u then
     4394     do:
     4395       assign
     4396         frame Dialog-Frame
     4397         tt-fin-doc.sum-doc
     4398         .
     4399   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
