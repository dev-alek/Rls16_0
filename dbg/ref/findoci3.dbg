      550   procedure uf-get :
      551     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      552     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      553     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      554     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      555     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      556     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      557     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      558     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      559     do
      560     on error undo, return error
      561     :
      562       define buffer buf_usr-flt for ubflt.usr-flt .
      563       define variable v-use-List_     as logical   no-undo .
      564       define variable v-type-List_     as character no-undo .
      565       define variable v-format-List_   as character no-undo .
      566       define variable v-use-Naim      as logical   no-undo .
      567       define variable v-type-Naim      as character no-undo .
      568       define variable v-format-Naim    as character no-undo .
      569       define variable v-use-print-graft as logical   no-undo .
      570       define variable v-use-sort-gr     as logical   no-undo .
      571       define variable v-use-type-price  as logical   no-undo .
      572       define variable v-use-type-val    as logical   no-undo .
      573       define variable v-label          as character no-undo .
      574       define variable v-tooltip        as character no-undo .
      575       define variable v-user-can-edit  as logical   no-undo .
      576       define variable v-output-display as logical   no-undo .
      577       define variable v-other          as character no-undo .
      578       run uf-name in this-procedure
      579          (input  entry(1, p-code, chr(4))
      580         ,output v-use-List_
      581         ,output v-type-List_
      582         ,output v-format-List_
      583         ,output v-use-Naim
      584         ,output v-type-Naim
      585         ,output v-format-Naim
      586         ,output v-use-print-graft
      587         ,output v-use-sort-gr
      588         ,output v-use-type-price
      589         ,output v-use-type-val
      590         ,output v-label
      591         ,output v-tooltip
      592         ,output v-user-can-edit
      593         ,output v-output-display
      594         ,output v-other
      595         ) no-error .
      596       if error-status :error then do:
      597         undo, return error return-value .
      598       end.
      599       find first buf_usr-flt no-lock where
      600                  buf_usr-flt.Call-point     = p-code AND
      601                  buf_usr-flt.user-name       = p-user-name
      602         no-error .
      603       if avail buf_usr-flt then do:
      604         assign
      605         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      606         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      607         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      608         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      609         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      610         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      611         .
      612       end.
      613       else do:
      614         assign
      615         p-List_        = (if v-use-List_       then "":U                    else ?)
      616         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      617         p-print-graft  = (if v-use-print-graft then no                      else ?)
      618         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      619         p-type-price   = (if v-use-type-price  then no                      else ?)
      620         p-type-val     = (if v-use-List_       then no                      else ?)
      621         .
      622       end.
      623     end.
      624   end procedure.
      625   procedure uf-set :
      626     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      627     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      628     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      629     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      630     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      631     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      632     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      633     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      634     do
      635     on error undo, return error
      636     :
      637       define buffer buf_usr-flt for ubflt.usr-flt .
      638       define variable v-use-List_     as logical   no-undo .
      639       define variable v-type-List_     as character no-undo .
      640       define variable v-format-List_   as character no-undo .
      641       define variable v-use-Naim      as logical   no-undo .
      642       define variable v-type-Naim      as character no-undo .
      643       define variable v-format-Naim    as character no-undo .
      644       define variable v-use-print-graft as logical   no-undo .
      645       define variable v-use-sort-gr   as logical   no-undo .
      646       define variable v-use-type-price as logical   no-undo .
      647       define variable v-use-type-val  as logical   no-undo .
      648       define variable v-tooltip        as character no-undo .
      649       define variable v-label          as character no-undo .
      650       define variable v-user-can-edit  as logical   no-undo .
      651       define variable v-output-display as logical   no-undo .
      652       define variable v-other          as character no-undo .
      653       run uf-name in this-procedure
      654         (input  entry(1, p-code, chr(4))
      655         ,output v-use-List_
      656         ,output v-type-List_
      657         ,output v-format-List_
      658         ,output v-use-Naim
      659         ,output v-type-Naim
      660         ,output v-format-Naim
      661         ,output v-use-print-graft
      662         ,output v-use-sort-gr
      663         ,output v-use-type-price
      664         ,output v-use-type-val
      665         ,output v-label
      666         ,output v-tooltip
      667         ,output v-user-can-edit
      668         ,output v-output-display
      669         ,output v-other
      670         ) no-error .
      671       if error-status :error then do:
      672         undo, return error return-value .
      673       end.
      674       find first buf_usr-flt where
      675                  buf_usr-flt.Call-point     = p-code AND
      676                  buf_usr-flt.user-name       = p-user-name
      677         no-error .
      678       if not avail buf_usr-flt then do:
      679           create buf_usr-flt .
      680           assign
      681           buf_usr-flt.call-point = p-code
      682           buf_usr-flt.user-name  = p-user-name
      683           .
      684       end.
      685       if avail buf_usr-flt then do:
      686        assign
      687        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      688        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      689        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      690        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      691        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      692        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      693       .
      694       release buf_usr-flt.
      695       end.
      696       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      697     end.
      698   end procedure.
      699   function diff-list returns character (
      700     input parfirst-list  as character,
      701     input parsecond-list as character,
      702     input pardelim       as character).
      703     if pardelim = ""
      704     or pardelim = ?
      705     then do:
      706       assign
      707         pardelim = ","
      708       .
      709     end.
      710     def var ind as integer no-undo .
      711     def var v-elem as character no-undo .
      712     def var v-result-list as character no-undo init "".
      713     def var v-num-parfirst-list as integer no-undo .
      714     assign
      715       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      716     .
      717     do ind = 1 to v-num-parfirst-list
      718     :
      719       assign
      720         v-elem = entry(ind, parfirst-list, pardelim)
      721       .
      722       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      723         assign
      724           v-result-list = v-result-list
      725                         + (if v-result-list > "" then pardelim else "")
      726                         + v-elem
      727         .
      728       end.
      729     end.
      730     return v-result-list .
      731   end function.
      732   function add-list returns character (
      733    input parfirst-list  as character,
      734    input parsecond-list as character,
      735    input pardelim       as character).
      736     if pardelim = ""
      737     or pardelim = ?
      738     then do:
      739       assign
      740         pardelim = ","
      741       .
      742     end.
      743     def var ind as integer no-undo .
      744     def var v-elem as character no-undo .
      745     def var v-result-list as character no-undo init "".
      746     def var v-num-parfirst-list as integer no-undo .
      747     assign
      748       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      749     .
      750     do ind = 1 to v-num-parfirst-list
      751     :
      752       assign
      753         v-elem = entry(ind, parfirst-list, pardelim)
      754       .
      755       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      756         assign
      757           v-result-list = v-result-list
      758                         + (if v-result-list > "" then pardelim else "")
      759                         + v-elem
      760         .
      761       end.
      762     end.
      763     def var v-num-parsecond-list as integer no-undo .
      764     assign
      765       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      766     .
      767     do ind = 1 to v-num-parsecond-list
      768     :
      769       assign
      770         v-elem = entry(ind, parsecond-list, pardelim)
      771       .
      772       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      773         assign
      774           v-result-list = v-result-list
      775                         + (if v-result-list > "" then pardelim else "")
      776                         + v-elem
      777         .
      778       end.
      779     end.
      780     return v-result-list .
      781   end function.
      782   function cross-list returns character (
      783    input parfirst-list  as character,
      784    input parsecond-list as character,
      785    input pardelim       as character).
      786     if pardelim = ""
      787     or pardelim = ?
      788     then do:
      789       assign
      790         pardelim = ","
      791       .
      792     end.
      793     def var ind as integer no-undo .
      794     def var v-elem as character no-undo .
      795     def var v-result-list as character no-undo init "".
      796     def var v-num-parfirst-list as integer no-undo .
      797     assign
      798       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      799     .
      800     do ind = 1 to v-num-parfirst-list
      801     :
      802       assign
      803         v-elem = entry(ind, parfirst-list, pardelim)
      804       .
      805       if lookup(v-elem, v-result-list, pardelim) = 0
      806       and lookup(v-elem, parsecond-list, pardelim) > 0
      807       then do:
      808         assign
      809           v-result-list = v-result-list
      810                         + (if v-result-list > "" then pardelim else "")
      811                         + v-elem
      812         .
      813       end.
      814     end.
      815     return v-result-list .
      816   end function.
      817   function radio-label returns character (
      818    input par-rs-value  as character,
      819    input par-rs-radio-buttons as character)
      820    .
      821    DEFINE variable v-result-label as character no-undo.
      822    assign
      823    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      824                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      825                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      826                             ), par-rs-radio-buttons
      827                           )
      828    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      829    .
      830   return v-result-label.
      831   end function.
      832   function m-radio-label returns character (
      833    input par-rs-value  as character,
      834    input par-rs-radio-buttons as character,
      835    input par-delim as character
      836    )
      837    .
      838    DEFINE variable v-result-label as character no-undo.
      839    assign
      840    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      841                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      842                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      843                             ), par-rs-radio-buttons, par-delim
      844                           )
      845    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      846    .
      847   return v-result-label.
      848   end function.
      849   FUNCTION mixlist returns character
      850   (
      851    input parfirst-list  as character
      852    ,input parsecond-list as character
      853    ,input pardelim       as character
      854    ,input pardelim-result as character ) :
      855     if pardelim = ""
      856     or pardelim = ?
      857     then do:
      858       assign
      859         pardelim = ","
      860       .
      861     end.
      862     def var ind as integer no-undo .
      863     def var v-elem1 as character no-undo .
      864     def var v-elem2 as character no-undo .
      865     def var v-result-list as character no-undo init "".
      866     do ind = 1 to num-entries(parfirst-list, pardelim)
      867     :
      868       assign
      869         v-elem1 = entry(ind, parfirst-list, pardelim)
      870         v-elem2 = entry(ind, parsecond-list, pardelim)
      871       .
      872         assign
      873           v-result-list = v-result-list
      874                         + (if v-result-list > "" then pardelim-result else "")
      875                         + v-elem1 + pardelim-result + v-elem2
      876         .
      877     end.
      878     return v-result-list .
      879   END FUNCTION.
