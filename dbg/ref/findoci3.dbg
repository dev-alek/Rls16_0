     1634   if error-status:error then return no-apply.
     1635   END.
     1636   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1637   DO:
     1638   define variable v-format as integer no-undo .
     1639   define variable v-log as logical no-undo .
     1640   define variable v-cmp as character no-undo .
     1641   buffer-compare tt-fin-doc to locked_fin-doc
     1642   case-sensitive
     1643   save result in v-cmp .
     1644   if v-cmp <> "":U then do:
     1645     message
     1646     "Вы изменили ПЛАТЕЖ, но не сохранили его" skip
     1647     "сохранить перед печатью?"
     1648     view-as alert-box QUESTION buttons YES-NO update v-log.
     1649   end.
     1650   run proc-save in this-procedure (v-log) no-error.
     1651   run ref/fdoc-prn.p (
     1652           input parparentproc
     1653         , input this-procedure
     1654         , input string(recid(locked_fin-doc))
     1655                         ) no-error.
     1656   if error-status:error then return no-apply.
     1657   END.
     1658   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1659   procedure proc-color-widgets :
     1660   define input parameter p-list as character no-undo .
     1661   define input parameter p-fg as logical no-undo .
     1662   define input parameter p-bg as logical no-undo .
     1663   define input parameter p-fgc as integer no-undo .
     1664   define input parameter p-bgc as integer no-undo .
     1665   define variable ii as integer no-undo .
     1666   define variable fh as widget-handle no-undo .
     1667   define variable hh as widget-handle no-undo .
     1668     do
     1669     on error undo, return error
     1670     :
     1671       assign
     1672       fh = frame Dialog-Frame:first-child
     1673       hh = fh:first-child
     1674       .
     1675       do while valid-handle(hh):
     1676         if LOOKUP(hh:name, p-list) > 0  then do:
     1677           assign
     1678           hh:fgcolor = (if p-fg then p-fgc else hh:fgcolor)
     1679           hh:bgcolor = (if p-bg then p-bgc else hh:bgcolor)
     1680           .
     1681         end.
     1682         hh = hh:next-sibling.
     1683       end.
     1684     end.
     1685   end procedure.
     1686   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile: findocip.i $ $Revision: ff8019e24d02, 2996, rls $".
     1687   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1688   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1689   procedure set-buffers :
     1690     DEFINE input parameter X_clients-host-recid as recid no-undo .
     1691     DEFINE input parameter X_firm-recid as recid no-undo .
     1692     DEFINE input parameter X_sysconf-recid as recid no-undo .
     1693     define input parameter X_fin-code-cor-acc-recid as recid no-undo .
     1694     define input parameter X_fin-code-cor-acc1-recid as recid no-undo .
     1695     define input parameter X_fin-code-an-uchet-recid as recid no-undo .
     1696     define input parameter X_fin-code-cel-nazn-recid as recid no-undo .
     1697     define input parameter X_currency-recid as recid no-undo .
     1698     define input parameter X_contract-currency-recid as recid no-undo .
     1699     DEFINE input parameter X_receiver-recid as recid no-undo .
     1700     DEFINE input parameter X_payer-recid as recid no-undo .
     1701     define input parameter X_curr_sysconf-recid as recid no-undo .
     1702     define input parameter X_payer-fin-schet-recid as recid no-undo .
     1703     define input parameter X_payer-fin-bank-recid as recid no-undo .
     1704     define input parameter X_payer-firm-recid as recid no-undo .
     1705     define input parameter X_payer-person-recid as recid no-undo .
     1706     define input parameter X_receiver-fin-schet-recid as recid no-undo .
     1707     define input parameter X_receiver-fin-bank-recid as recid no-undo .
     1708     define input parameter X_receiver-firm-recid as recid no-undo .
     1709     define input parameter X_receiver-person-recid as recid no-undo .
     1710     define input parameter X_contract-recid as recid no-undo .
     1711     define input parameter X_fin-ob-recid as recid no-undo .
     1712     define input parameter X_clients-obj-recid as recid no-undo .
     1713     define input parameter p-f-cor-acc1-descr as character no-undo .
     1714     define input parameter p-f-cor-acc-descr as character no-undo .
     1715     define input parameter p-f-an-uchet-descr as character no-undo .
     1716     define input parameter p-f-cel-nazn-descr as character no-undo .
     1717     do
     1718       on error undo, return error
     1719       :
     1720       find first X_clients-host no-lock where                   recid(X_clients-host)          = X_clients-host-recid no-error  .
     1721       find first X_firm no-lock where                           recid(X_firm)                  = X_firm-recid no-error .
     1722       find first X_sysconf no-lock where                        recid(X_sysconf)               = X_sysconf-recid no-error .
     1723       find first X_fin-code-cor-acc no-lock where               recid(X_fin-code-cor-acc)      = X_fin-code-cor-acc-recid no-error .
     1724       find first X_fin-code-cor-acc1 no-lock where              recid(X_fin-code-cor-acc1)     = X_fin-code-cor-acc1-recid no-error .
     1725       find first X_fin-code-an-uchet no-lock where              recid(X_fin-code-an-uchet)     = X_fin-code-an-uchet-recid no-error .
     1726       find first X_fin-code-cel-nazn no-lock where              recid(X_fin-code-cel-nazn)     = X_fin-code-cel-nazn-recid no-error .
     1727       find first X_currency no-lock where                       recid(X_currency)              = X_currency-recid no-error .
     1728       find first X_contract-currency no-lock where              recid(X_contract-currency)     = X_contract-currency-recid no-error .
     1729       find first X_receiver no-lock where                       recid(X_receiver)              = X_receiver-recid no-error .
     1730       find first X_payer no-lock where                          recid(X_payer)                 = X_payer-recid no-error .
     1731       find first X_curr_sysconf no-lock where                   recid(X_curr_sysconf)          = X_curr_sysconf-recid no-error .
     1732       find first X_payer-fin-schet no-lock where                recid(X_payer-fin-schet)       = X_payer-fin-schet-recid no-error .
     1733       find first X_payer-fin-bank no-lock where                 recid(X_payer-fin-bank)        = X_payer-fin-bank-recid no-error .
     1734       find first X_payer-firm no-lock where                     recid(X_payer-firm)            = X_payer-firm-recid no-error .
     1735       find first X_payer-person no-lock where                   recid(X_payer-person)          = X_payer-person-recid no-error .
     1736       find first X_receiver-fin-schet no-lock where             recid(X_receiver-fin-schet)    = X_receiver-fin-schet-recid no-error .
     1737       find first X_receiver-fin-bank no-lock where              recid(X_receiver-fin-bank)     = X_receiver-fin-bank-recid no-error .
     1738       find first X_receiver-firm no-lock where                  recid(X_receiver-firm)         = X_receiver-firm-recid no-error .
     1739       find first X_receiver-person no-lock where                recid(X_receiver-person)       = X_receiver-person-recid no-error .
     1740       find first X_contract no-lock where                       recid(X_contract)              = X_contract-recid no-error .
     1741       find first X_fin-ob no-lock where                         recid(X_fin-ob)                = X_fin-ob-recid no-error .
     1742       find first X_clients-obj no-lock where                    recid(X_clients-obj)           = X_clients-obj-recid no-error .
     1743       assign
     1744         f-cor-acc1-descr = p-f-cor-acc1-descr
     1745         f-cor-acc-descr  = p-f-cor-acc-descr
     1746         f-an-uchet-descr = p-f-an-uchet-descr
     1747         f-cel-nazn-descr = p-f-cel-nazn-descr
     1748         .
     1749     end.
     1750   end procedure.
     1751   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile: findocip.i $ $Revision: ff8019e24d02, 2996, rls $".
     1752   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1753   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1754   procedure get-single-schet :
     1755     define input parameter p-host-code like ub.sysconf.host-code no-undo .
     1756     define input parameter p-cli-type like ub.fin-schet.cli-type no-undo .
     1757     define input parameter p-cli-code like ub.fin-schet.cli-code no-undo .
     1758     define input parameter p-curr-code like ub.fin-schet.curr-code no-undo .
     1759     define output parameter p-recid-schet as recid no-undo .
     1760     define output parameter p-recid-bank as recid no-undo .
     1761     define variable ii as integer no-undo .
     1762     define buffer buf_fin-schet for ub.fin-schet.
     1763     define buffer buf_fin-bank  for ub.fin-bank.
     1764     do
     1765       on error undo, return error
     1766       :
     1767       for each buf_fin-schet no-lock where
     1768         buf_fin-schet.host-code = p-host-code
     1769         AND buf_fin-schet.cli-type = p-cli-type
     1770         AND buf_fin-schet.cli-code = p-cli-code
     1771         AND buf_fin-schet.curr-code = p-curr-code:
     1772         if buf_fin-schet.status_ = 'тек':U then
     1773         do:
     1774           find first buf_fin-bank no-lock where
     1775             buf_fin-bank.host-code = p-host-code
     1776             AND buf_fin-bank.code-bank = buf_fin-schet.code-bank no-error .
     1777           if avail buf_fin-bank and buf_fin-bank.status_ = 'тек':U then
     1778           do:
     1779             assign
     1780               p-recid-schet = recid(buf_fin-schet)
     1781               p-recid-bank  = recid(buf_fin-bank)
     1782               .
     1783             assign
     1784               ii = ii + 1
     1785               .
     1786           end.
     1787         end.
     1788         if ii > 1 then
     1789         do:
     1790           assign
     1791             p-recid-schet = ?
     1792             p-recid-bank  = ?
     1793             .
     1794         end.
     1795       end.
     1796     end.
     1797   end procedure.
     1798   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile: findocip.i $ $Revision: ff8019e24d02, 2996, rls $".
     1799   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1800   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1801   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1802   on ' ' of tt-fin-doc.doc-date in frame Dialog-Frame
     1803   do:
     1804     if (can-query (self, "sensitive")
     1805        and
     1806        self :sensitive = true
     1807        )
     1808     or (can-query (self, "read-only")
     1809        and
     1810        self :read-only = false
     1811        )
     1812     then do:
     1813       assign
     1814         self :screen-value = ?
     1815       .
     1816     end.
     1817     return no-apply.
     1818   end.
     1819   on delete-character of tt-fin-doc.doc-date in frame Dialog-Frame
     1820   do:
     1821     if (can-query (self, "sensitive")
     1822        and
     1823        self :sensitive = true
     1824        )
     1825     or (can-query (self, "read-only")
     1826        and
     1827        self :read-only = false
     1828        )
     1829     then do:
     1830       assign
     1831         self :screen-value = ?
     1832       .
     1833     end.
     1834     return no-apply.
     1835   end.
     1836   on ctrl-d of tt-fin-doc.doc-date in frame Dialog-Frame
     1837   do:
     1838     define variable v-curr-sv-date as date no-undo .
     1839     if (can-query (self, "sensitive")
     1840        and
     1841        self :sensitive = true
     1842        )
     1843     or (can-query (self, "read-only")
     1844        and
     1845        self :read-only = false
     1846        )
     1847     then do:
     1848       if self :handle <> focus :handle
     1849       then do:
     1850         apply "entry":u to self .
     1851       end.
     1852       run gbl/getcurdt.p
     1853         (output v-curr-sv-date
     1854         ) .
     1855       assign
     1856         self :screen-value = string(v-curr-sv-date) .
     1857       .
     1858     end.
     1859     return no-apply.
     1860   end.
     1861   on ctrl-b of tt-fin-doc.doc-date in frame Dialog-Frame
     1862   do:
     1863     if (can-query (self, "sensitive")
     1864        and
     1865        self :sensitive = true
     1866        )
     1867     or (can-query (self, "read-only")
     1868        and
     1869        self :read-only = false
     1870        )
     1871     then do:
     1872       if self :handle <> focus :handle
     1873       then do:
     1874         apply "entry":u to self .
     1875       end.
     1876       define variable v-curr-sv-date as date no-undo .
     1877       define variable v-new-sv-date  as date no-undo .
     1878       assign
     1879         v-curr-sv-date = date(self :screen-value) no-error
     1880       .
     1881       if v-curr-sv-date = ?
     1882       then do:
     1883         run gbl/getcurdt.p
     1884           (output v-curr-sv-date
     1885           ) .
     1886       end.
     1887       if v-curr-sv-date <> ?
     1888       then do:
     1889         assign
     1890           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1891         .
     1892         assign
     1893           self :screen-value = string(v-new-sv-date) .
     1894         .
     1895       end.
     1896     end.
     1897     return no-apply .
     1898   end.
     1899   on ctrl-e of tt-fin-doc.doc-date in frame Dialog-Frame
     1900   do:
     1901     if (can-query (self, "sensitive")
     1902        and
     1903        self :sensitive = true
     1904        )
     1905     or (can-query (self, "read-only")
     1906        and
     1907        self :read-only = false
     1908        )
     1909     then do:
     1910       if self :handle <> focus :handle
     1911       then do:
     1912         apply "entry":u to self .
     1913       end.
     1914       define variable v-curr-sv-date as date no-undo .
     1915       define variable v-new-sv-date  as date no-undo .
     1916       assign
     1917         v-curr-sv-date = date(self :screen-value) no-error
     1918       .
     1919       if v-curr-sv-date = ?
     1920       then do:
     1921         run gbl/getcurdt.p
     1922           (output v-curr-sv-date
     1923           ) .
     1924       end.
     1925       if v-curr-sv-date <> ?
     1926       then do:
     1927         run gbl/lastdate.p
     1928           (input  v-curr-sv-date
     1929           ,output v-new-sv-date
     1930           ).
     1931         assign
     1932           self :screen-value = string(v-new-sv-date) .
     1933         .
     1934       end.
     1935     end.
     1936     return no-apply .
     1937   end.
     1938   on ctrl-f of tt-fin-doc.doc-date in frame Dialog-Frame
     1939   do:
     1940     if (can-query (self, "sensitive")
     1941        and
     1942        self :sensitive = true
     1943        )
     1944     or (can-query (self, "read-only")
     1945        and
     1946        self :read-only = false
     1947        )
     1948     then do:
     1949       if self :handle <> focus :handle
     1950       then do:
     1951         apply "entry":u to self .
     1952       end.
     1953       define variable v-ok            as logical   no-undo .
     1954       define variable v-curr-sv-date  as date      no-undo .
     1955       define variable v-description   as character no-undo .
     1956       assign
     1957         v-curr-sv-date = date(self :screen-value) no-error
     1958       .
     1959       if v-curr-sv-date = ?
     1960       then do:
     1961         run gbl/getcurdt.p
     1962           (output v-curr-sv-date
     1963           ) .
     1964       end.
     1965       if v-curr-sv-date <> ?
     1966       then do:
     1967         run gbl/d-inpday.w
     1968           (input ?
     1969           ,input "Выбор даты"
     1970           ,input v-description
     1971           ,input ""
     1972           ,input-output v-curr-sv-date
     1973           ,output v-ok
     1974           ).
     1975         if v-ok = true
     1976         then do:
     1977           assign
     1978             self :screen-value = string(v-curr-sv-date) .
     1979           .
     1980         end.
     1981       end.
     1982     end.
     1983     return no-apply .
     1984   end.
     1985     define MENU m-ed-date21
     1986       MENU-ITEM m-ed-date21-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1987       MENU-ITEM m-ed-date21-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1988       MENU-ITEM m-ed-date21-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1989       MENU-ITEM m-ed-date21-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1990       .
     1991     if tt-fin-doc.doc-date :POPUP-MENU in frame Dialog-Frame = ?
     1992     then do:
     1993       ASSIGN
     1994         tt-fin-doc.doc-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date21 :HANDLE
     1995         tt-fin-doc.doc-date :MENU-MOUSE in frame Dialog-Frame = 3
     1996       .
     1997     end.
     1998     define variable v-label-handle21 as handle no-undo .
     1999     assign
     2000       v-label-handle21 = tt-fin-doc.doc-date :side-label-handle in frame Dialog-Frame
     2001     .
     2002     if valid-handle (v-label-handle21)
     2003     then do:
     2004       if v-label-handle21 :tooltip = ""
     2005       or v-label-handle21 :tooltip = ?
     2006       then do:
     2007         assign
     2008           v-label-handle21 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     2009         .
     2010       end.
     2011     end.
     2012     ON CHOOSE OF MENU-ITEM m-ed-date21-1 in menu m-ed-date21 DO:
     2013       apply "ctrl-b":U to tt-fin-doc.doc-date in frame Dialog-Frame .
     2014     END.
     2015     ON CHOOSE OF MENU-ITEM m-ed-date21-2 in menu m-ed-date21 DO:
     2016       apply "ctrl-d":U to tt-fin-doc.doc-date in frame Dialog-Frame .
     2017     END.
     2018     ON CHOOSE OF MENU-ITEM m-ed-date21-3 in menu m-ed-date21 DO:
     2019       apply "ctrl-e":U to tt-fin-doc.doc-date in frame Dialog-Frame .
     2020     END.
     2021     ON CHOOSE OF MENU-ITEM m-ed-date21-4 in menu m-ed-date21 DO:
     2022       apply "ctrl-f":U to tt-fin-doc.doc-date in frame Dialog-Frame .
     2023     END.
     2024   ON CHOOSE OF B-obj IN FRAME Dialog-Frame
     2025     DO:
     2026       define variable v-obj-type like ub.fin-doc.obj-type no-undo .
     2027       define variable v-obj-code like ub.fin-doc.obj-code no-undo .
     2028   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2029   if lookup(self :type
     2030            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2031            ) = 0
     2032   then do:
     2033     message
     2034       "$Workfile$"
     2035       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2036       "Интерфейсный элемент" self :name  skip
     2037       "Тип" self :type  skip
     2038       "Процедура" this-procedure :file-name skip
     2039       view-as alert-box .
     2040   end.
     2041   else do:
     2042     apply "entry":u to self  .
     2043     if focus :handle <> self :handle  then do:
     2044       return no-apply .
     2045     end.
     2046   end.
     2047   run str/chshobj.w ( tt-fin-doc.host-code
     2048     , tt-fin-doc.obj-type
     2049     , tt-fin-doc.obj-code
     2050     , output v-obj-type
     2051     , output v-obj-code
     2052     ) no-error .
     2053   if error-status:error
     2054     or (
     2055     v-obj-type = tt-fin-doc.obj-type
     2056     AND v-obj-code = tt-fin-doc.obj-code)
     2057     or v-obj-code = 0
     2058     or v-obj-type = "":U
     2059     then
     2060   do:
     2061     return no-apply.
     2062   end.
     2063   find first X_clients-obj no-lock where
     2064     X_clients-obj.obj-type = v-obj-type
     2065     AND X_clients-obj.obj-code = v-obj-code .
     2066   assign
     2067     tt-fin-doc.obj-type = X_clients-obj.obj-type
     2068     tt-fin-doc.obj-code = X_clients-obj.obj-code
     2069     .
     2070   display
     2071     tt-fin-doc.obj-type
     2072     tt-fin-doc.obj-code
     2073     with frame Dialog-Frame.
     2074   run check-obj in this-procedure (  input tt-fin-doc.obj-type
     2075     ,input tt-fin-doc.obj-code
     2076     )
     2077     no-error.
     2078   END.
     2079   ON LEAVE OF tt-fin-doc.obj-code IN FRAME Dialog-Frame
     2080     DO:
     2081   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2082   if lookup(self :type
     2083            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2084            ) = 0
     2085   then do:
     2086     message
     2087       "$Workfile$"
     2088       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2089       "Интерфейсный элемент" self :name  skip
     2090       "Тип" self :type  skip
     2091       "Процедура" this-procedure :file-name skip
     2092       view-as alert-box .
     2093   end.
     2094   else do:
     2095     apply "entry":u to self  .
     2096     if focus :handle <> self :handle  then do:
     2097       return no-apply .
     2098     end.
     2099   end.
     2100   if   input frame Dialog-Frame tt-fin-doc.obj-code <> 0 then
     2101   do:
     2102     run check-obj in this-procedure (
     2103       input frame Dialog-Frame tt-fin-doc.obj-type
     2104       ,input frame Dialog-Frame tt-fin-doc.obj-code
     2105       )
     2106       no-error.
     2107     if error-status:error then
     2108     do:
     2109       return no-apply.
     2110     end.
     2111   end.
     2112   END.
     2113   ON VALUE-CHANGED OF tt-fin-doc.obj-type IN FRAME Dialog-Frame
     2114     DO:
     2115       assign
     2116         tt-fin-doc.obj-type.
     2117       if   input frame Dialog-Frame tt-fin-doc.obj-code <> 0 then
     2118       do:
     2119         run check-obj in this-procedure (
     2120           input frame Dialog-Frame tt-fin-doc.obj-type
     2121           ,input frame Dialog-Frame tt-fin-doc.obj-code
     2122           )
     2123           no-error.
     2124         if error-status:error then
     2125         do:
     2126           return no-apply.
     2127         end.
     2128       end.
     2129     END.
     2130   PROCEDURE check-obj :
     2131     define input parameter p-check-obj-type as character no-undo .
     2132     define input parameter p-check-obj-code as integer no-undo .
     2133     define variable v-obj-db-num as integer no-undo init -1.
     2134     define variable v-cash-book  as integer no-undo .
     2135     define buffer buf_clients for ub.clients.
     2136     find first buf_clients no-lock where
     2137       buf_clients.obj-code = p-check-obj-code
     2138       and buf_clients.obj-type = p-check-obj-type no-error.
     2139     if not available buf_clients then
     2140     do:
     2141       if p-check-obj-code <> ?  then
     2142         message "Неправильный код или тип объекта" .
     2143       apply "entry" to tt-fin-doc.obj-code in frame Dialog-Frame.
     2144       return error.
     2145     end.
     2146     find first X_clients-obj no-lock where recid(X_clients-obj) = recid(buf_clients).
     2147     assign
     2148       tt-fin-doc.obj-type = buf_clients.obj-type
     2149       tt-fin-doc.obj-code = buf_clients.obj-code
     2150       .
     2151     display
     2152       tt-fin-doc.obj-type
     2153       tt-fin-doc.obj-code
     2154       with frame Dialog-Frame.
     2155     if not (tt-fin-doc.obj-type = '' and tt-fin-doc.obj-code = 0) then
     2156     do:
     2157   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2158   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2159     (input  tt-fin-doc.obj-type
     2160     ,input  tt-fin-doc.obj-code
     2161     ,output v-obj-db-num
     2162     )  .
     2163       define variable l-shift-on as logical no-undo .
     2164   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2165   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2166     (input  tt-fin-doc.obj-type
     2167     ,input  tt-fin-doc.obj-code
     2168     ,input  'shift-on=request'
     2169     ,output l-shift-on
     2170     )  .
     2171       assign
     2172         tt-fin-doc.shift-flag = (if l-shift-on
     2173                                     and lookup(tt-fin-doc.fin-ext-doc-type, 'пко,рко':U) > 0
     2174                                     and (tt-fin-doc.doc-author = 'manual':U or tt-fin-doc.doc-author = 'auto':U)
     2175                                     and v-obj-db-num = v-cntxt-db-num
     2176                                     then integer('1':U)
     2177                                     else 0)
     2178         .
     2179       for each thbjattr_thbj-attr:
     2180         delete thbjattr_thbj-attr.
     2181       end.
     2182       define variable mCashBook         as class     ibs.th.ref.cashbookstorage no-undo .
     2183       define variable par-type          as character no-undo .
     2184       define variable v-dpt-option      as character no-undo .
     2185       define variable v-dpt-dflt-name   as character no-undo .
     2186       define variable v-dpt-dflt-type   as character no-undo .
     2187       define variable v-dpt-dflt-code   as integer   no-undo .
     2188       define variable v-value-character as character no-undo .
     2189       define variable v-value-date      as date      no-undo .
     2190       define variable v-value-decimal   as decimal   no-undo .
     2191       define variable v-value-integer   as INTEGER   no-undo .
     2192       define variable v-value-logical   AS LOGICAL   no-undo .
     2193       define variable v-tth             as handle    no-undo .
     2194       define variable v-naznach-plat    as character no-undo .
     2195       define variable v-enclosure       as character no-undo .
     2196       define variable o-head-position   as character no-undo .
     2197       define variable o-director        as character no-undo .
     2198       define variable o-snr-accnt       as character no-undo .
     2199       define variable o-cashier         as character no-undo .
     2200       define variable v-head-position   as character no-undo .
     2201       define variable v-director        as character no-undo .
     2202       define variable v-snr-accnt       as character no-undo .
     2203       define variable v-cashier         as character no-undo .
     2204       define variable v-hist-code       as character no-undo .
     2205       define variable v-hist-name       as character no-undo .
     2206       define buffer buf_sysconf for ub.sysconf.
     2207       define buffer buf_shop    for ub.shop .
     2208       define buffer buf_store   for ub.store .
     2209       define buffer buf_firm    for ub.firm .
     2210       assign
     2211         v-tth = buffer thbjattr_thbj-attr:table-handle .
     2212       mCashBook = new ibs.th.ref.cashbookstorage () .
     2213       v-dpt-option    = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "Struct") .
     2214       v-dpt-dflt-name = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "DptName") .
     2215       v-dpt-dflt-type = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "DptType") .
     2216       v-dpt-dflt-code = integer(mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "DptCode")) .
     2217       o-head-position = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "ManagerPosition") .
     2218       o-director      = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "ManagerFIO") .
     2219       o-snr-accnt     = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "BuhFIO") .
     2220       delete object mCashBook no-error .
     2221       case v-dpt-option:
     2222         when "1" then
     2223           do:
     2224             for first ub.db-attr no-lock where ub.db-attr.db-num = v-cntxt-db-num
     2225             and ub.db-attr.attr-code = 'hist-code':U:
     2226               v-hist-code = ub.db-attr.attr-value .
     2227             end.
     2228             for first ub.db-attr no-lock where ub.db-attr.db-num = v-cntxt-db-num
     2229             and ub.db-attr.attr-code = 'hist-name':U:
     2230               v-hist-name = ub.db-attr.attr-value .
     2231             end.
     2232             if v-hist-code = "" then v-dpt-dflt-code = X_clients-obj.obj-code .
     2233             if v-hist-name = "" then v-dpt-dflt-name = X_clients-obj.obj-name .
     2234             v-dpt-dflt-type = X_clients-obj.obj-type  .
     2235           end.
     2236         when "0" then
     2237           do:
     2238             assign
     2239               v-dpt-dflt-name = ''
     2240               v-dpt-dflt-type = ''
     2241               v-dpt-dflt-code = 0
     2242               .
     2243           end.
     2244         otherwise
     2245         do:
     2246           assign
     2247             v-dpt-dflt-name = v-dpt-dflt-name
     2248             v-dpt-dflt-type = v-dpt-dflt-type
     2249             v-dpt-dflt-code = v-dpt-dflt-code
     2250             .
     2251         end.
     2252       end case.
     2253       find first buf_sysconf no-error .
     2254       case o-head-position:
     2255         when '0':U then
     2256           do:
     2257             v-head-position = buf_sysconf.head-position.
     2258           end.
     2259         when '1':U then
     2260           do:
     2261             v-head-position = "Директор".
     2262           end.
     2263         when '2':U then
     2264           do:
     2265             v-head-position = "Управляющий".
     2266           end.
     2267         otherwise
     2268         do :
     2269           v-head-position = o-head-position.
     2270         end.
     2271       end case.
     2272       find first buf_firm no-lock where
     2273         buf_firm.firm-code = buf_sysconf.host-code.
     2274       case o-director:
     2275         when '1':U then
     2276           do:
     2277             if p-obj-type = 'маг':U then
     2278             do:
     2279               find first buf_shop no-lock where
     2280                 buf_shop.obj-code = p-obj-code no-error .
     2281               if available buf_shop then
     2282               do:
     2283                 v-director = buf_shop.director.
     2284               end.
     2285             end.
     2286             if p-obj-type = 'скл':U then
     2287             do:
     2288               find first buf_store no-lock where
     2289                 buf_store.obj-code = p-obj-code no-error .
     2290               if available buf_store then
     2291               do:
     2292                 v-director = buf_store.store-boss.
     2293               end.
     2294             end.
     2295           end.
     2296         when '0':U then
     2297           do:
     2298             v-director = buf_firm.director.
     2299           end.
     2300         otherwise
     2301         do:
     2302           v-director = o-director .
     2303         end.
     2304       end case.
     2305       case o-snr-accnt:
     2306         when '1':U then
     2307           do:
     2308             if p-obj-type = 'маг':U then
     2309             do:
     2310               find first buf_shop no-lock where
     2311                 buf_shop.obj-code = p-obj-code no-error .
     2312               if available buf_shop then
     2313               do:
     2314                 v-snr-accnt = entry(1,buf_shop.acct,"|").
     2315               end.
     2316             end.
     2317             if p-obj-type = 'скл':U then
     2318             do:
     2319               v-snr-accnt = ''.
     2320             end.
     2321           end.
     2322         when '2':U then
     2323           do:
     2324             v-snr-accnt = buf_sysconf.snr-accnt.
     2325           end.
     2326         otherwise
     2327         do:
     2328           v-snr-accnt = o-snr-accnt .
     2329         end.
     2330       end case.
     2331     FIND FIRST ub.shift-staff No-LOCK WHERE
     2332       ub.shift-staff.obj-type   = p-obj-type AND
     2333       ub.shift-staff.obj-code   = p-obj-code AND
     2334       ub.shift-staff.shift-date = tt-fin-doc.shift-date AND
     2335       ub.shift-staff.shift-num  = tt-fin-doc.shift-num AND
     2336       ub.shift-staff.staff-role = no and
     2337       ub.shift-staff.psn-num    >= 0 No-ERROR.
     2338     assign
     2339       v-cashier = if available ub.shift-staff then string(ub.shift-staff.name, "X(30)") else "".
     2340     .
     2341     if tt-fin-doc.fin-ext-doc-type = 'рко':U then
     2342     do:
     2343       assign
     2344         tt-fin-doc.payer-sign1 = v-director
     2345         tt-fin-doc.payer-sign2 = v-snr-accnt
     2346         tt-fin-doc.payer-sign3 = v-cashier
     2347         .
     2348     end.
     2349     if tt-fin-doc.fin-ext-doc-type = 'пко':U then
     2350     do:
     2351       assign
     2352         tt-fin-doc.receiver-sign2 = v-snr-accnt
     2353         tt-fin-doc.receiver-sign3 = v-cashier
     2354         .
     2355     end.
     2356     find first ub.CashBook no-lock where ub.CashBook.id = tt-fin-doc.CashBookId no-error .
     2357     if available (ub.CashBook) then
     2358     do:
     2359       case ub.CashBook.RuleOsnRko:
     2360         when "0" then
     2361           tt-fin-doc.naznach-plat = "Выручка от реализации" .
     2362         when "1" or
     2363         when "2" then
     2364           tt-fin-doc.naznach-plat = "" .
     2365         otherwise
     2366         tt-fin-doc.naznach-plat = ub.CashBook.RuleOsnRko .
     2367       end case .
     2368       case ub.CashBook.RulePril:
     2369         when '0' then
     2370           do:
     2371             tt-fin-doc.enclosure = v-naznach-plat .
     2372           end.
     2373         when '1' then
     2374           do:
     2375             tt-fin-doc.enclosure = "" .
     2376           end.
     2377         otherwise
     2378         tt-fin-doc.enclosure = ub.CashBook.RulePril .
     2379       end case.
     2380       if ub.CashBook.CorrRko <> "" then
     2381       do:
     2382         for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = ub.CashBook.CorrRko
     2383           and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     2384           tt-fin-doc.cor-acc = ub.fin-code-cor-acc.fin-code .
     2385           tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     2386         end.
     2387       end.
     2388       if tt-fin-doc.cor-acc = ? or tt-fin-doc.cor-acc = 0 then
     2389       do:
     2390         for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = "57.01"
     2391           and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     2392           tt-fin-doc.cor-acc = ub.fin-code-cor-acc.fin-code .
     2393           tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     2394         end.
     2395       end.
     2396       if ub.CashBook.OsnAcct <> "" then
     2397       do:
     2398         for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = ub.CashBook.OsnAcct
     2399           and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     2400           tt-fin-doc.cor-acc1 = ub.fin-code-cor-acc.fin-code .
     2401           tt-fin-doc.cor-acc1-value = ub.fin-code-cor-acc.code-value .
     2402         end.
     2403       end.
     2404     end.
     2405     assign
     2406       tt-fin-doc.str-podr-name = if v-hist-name = "" then v-dpt-dflt-name else v-hist-name
     2407       tt-fin-doc.str-podr-type = v-dpt-dflt-type
     2408       tt-fin-doc.str-podr-code = v-dpt-dflt-code
     2409       .
     2410     display
     2411       tt-fin-doc.str-podr-name
     2412       tt-fin-doc.str-podr-type
     2413       tt-fin-doc.str-podr-code
     2414       tt-fin-doc.enclosure
     2415       tt-fin-doc.naznach-plat
     2416       tt-fin-doc.cor-acc
     2417       tt-fin-doc.cor-acc1
     2418       tt-fin-doc.cor-acc1-value
     2419       tt-fin-doc.cor-acc-value
     2420       with frame Dialog-Frame .
     2421     end.
     2422     else
     2423     do:
     2424       assign
     2425         tt-fin-doc.shift-flag = 0
     2426         .
     2427     end.
     2428   END PROCEDURE.
     2429   ON CHOOSE OF B-calc IN FRAME Dialog-Frame
     2430     DO:
     2431       run ref/findclci.w (
     2432         INPUT          parParentProc
     2433         ,input          "":U
     2434         ,INPUT          tt-fin-doc.doc-date
     2435         ,INPUT          tt-fin-doc.curr-code
     2436         ,INPUT          v-base-code
     2437         ,INPUT          tt-fin-doc.contract-curr
     2438         ,INPUT-OUTPUT   tt-fin-doc.sum-doc
     2439         ,INPUT-OUTPUT   tt-fin-doc.exch-rate
     2440         ,INPUT-OUTPUT   tt-fin-doc.exch-scale
     2441         ,INPUT-OUTPUT   tt-fin-doc.sum-rubl
     2442         ,INPUT-OUTPUT   tt-fin-doc.sum-base
     2443         ,INPUT-OUTPUT   tt-fin-doc.base-rate
     2444         ,INPUT-OUTPUT   tt-fin-doc.base-scale
     2445         ,INPUT-OUTPUT   tt-fin-doc.sum-contr
     2446         ,INPUT-OUTPUT   tt-fin-doc.contract-rate
     2447         ,INPUT-OUTPUT   tt-fin-doc.contract-scale ) no-error.
     2448       if error-status:error then return no-apply.
     2449       assign
     2450         f-rest-con-sum = tt-fin-doc.sum-contr - tt-fin-doc.con-sum-contr
     2451         .
     2452       display
     2453         tt-fin-doc.sum-rubl
     2454         when v-rubf
     2455         tt-fin-doc.sum-doc
     2456         tt-fin-doc.exch-rate
     2457         when v-exchf
     2458         tt-fin-doc.exch-scale
     2459         when v-exchf
     2460         tt-fin-doc.sum-base
     2461         when v-basef
     2462         tt-fin-doc.base-rate
     2463         when v-baseratef
     2464         tt-fin-doc.base-scale
     2465         when v-baseratef
     2466         tt-fin-doc.sum-contr
     2467         when v-contractf
     2468         tt-fin-doc.contract-rate
     2469         when v-contractratef
     2470         tt-fin-doc.contract-scale
     2471         when v-contractratef
     2472         f-rest-con-sum
     2473         with frame Dialog-Frame .
     2474     END.
     2475   ON CHOOSE OF B-receiver-schet IN FRAME Dialog-Frame
     2476     DO:
     2477       define variable v-rid-list as character no-undo.
     2478       define variable ref-rec    as recid     no-undo.
     2479       define variable v-status_  like ub.fin-schet.status_ no-undo init 'тек':U.
     2480       define buffer buf_fin-schet for ub.fin-schet .
     2481   define variable vss-include-info26 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2482   if lookup(self :type
     2483            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2484            ) = 0
     2485   then do:
     2486     message
     2487       "$Workfile$"
     2488       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2489       "Интерфейсный элемент" self :name  skip
     2490       "Тип" self :type  skip
     2491       "Процедура" this-procedure :file-name skip
     2492       view-as alert-box .
     2493   end.
     2494   else do:
     2495     apply "entry":u to self  .
     2496     if focus :handle <> self :handle  then do:
     2497       return no-apply .
     2498     end.
     2499   end.
     2500   if available X_receiver-fin-schet then
     2501     assign
     2502       v-rid-list = string(recid(X_receiver-fin-schet))
     2503       v-status_  = X_receiver-fin-schet.status_
     2504       .
     2505   run ref/finschts.w (
     2506     INPUT parParentProc
     2507     ,p-curr-host-code
     2508     ,input "b-sel,b-add":U
     2509     ,input "company-host":U
     2510     ,input 'орг':U
     2511     ,input p-host-code
     2512     ,input ?
     2513     ,input tt-fin-doc.host-code
     2514     ,input 0
     2515     ,input-output v-status_
     2516     ,input-output v-rid-list
     2517     ) no-error.
     2518   if v-rid-list = "" then
     2519   do:
     2520     apply "entry" to b-receiver-schet in frame Dialog-Frame.
     2521     return no-apply.
     2522   end.
     2523   ref-rec = integer( v-rid-list ).
     2524   FIND FIRST buf_fin-schet WHERE
     2525     recid (buf_fin-schet) = ref-rec NO-LOCK  .
     2526   if buf_fin-schet.curr-code <> tt-fin-doc.curr-code then
     2527   do:
     2528     message
     2529       "Валюта выбранного Вами счета" 'ПОЛУЧАТЕЛЯ' "не совпадает с валютой платежа"
     2530       view-as alert-box error .
     2531     return no-apply.
     2532   end.
     2533   if buf_fin-schet.status_ <> 'тек':U then
     2534   do:
     2535     message
     2536       "Статус выбранного Вами счета" 'ПОЛУЧАТЕЛЯ' buf_fin-schet.status_ " - нельзя работать с таким счетом"
     2537       view-as alert-box error .
     2538     return no-apply.
     2539   end.
     2540   FIND FIRST X_receiver-fin-schet WHERE
     2541     recid (X_receiver-fin-schet) = ref-rec NO-LOCK  .
     2542   find first X_receiver-fin-bank no-lock where
     2543     X_receiver-fin-bank.host-code = tt-fin-doc.host-code
     2544     AND X_receiver-fin-bank.code-bank = X_receiver-fin-schet.code-bank .
     2545   assign
     2546     tt-fin-doc.receiver-bank-name  = X_receiver-fin-bank.bank-name
     2547     tt-fin-doc.receiver-bank-city  = X_receiver-fin-bank.bank-city
     2548     tt-fin-doc.receiver-dop1       = X_receiver-fin-schet.dop1
     2549     tt-fin-doc.receiver-dop2       = X_receiver-fin-schet.dop2
     2550     tt-fin-doc.receiver-bik        = X_receiver-fin-bank.bik
     2551     tt-fin-doc.receiver-c-schet    = X_receiver-fin-schet.c-schet
     2552     tt-fin-doc.receiver-r-schet    = X_receiver-fin-schet.r-schet
     2553     tt-fin-doc.receiver-code-schet = X_receiver-fin-schet.code-schet
     2554     .
     2555   display
     2556     tt-fin-doc.receiver-bank-name
     2557     tt-fin-doc.receiver-bank-city
     2558     tt-fin-doc.receiver-bik
     2559     tt-fin-doc.receiver-c-schet
     2560     tt-fin-doc.receiver-r-schet
     2561     with frame Dialog-Frame.
     2562   END.
     2563   ON CHOOSE OF B-payer IN FRAME Dialog-Frame
     2564     DO:
     2565       define variable ref-list as character no-undo.
     2566       define variable ref-rec  as recid     no-undo.
     2567       define variable v-sum-vat-chr  as character no-undo .
     2568       define variable v-each-vat-chr as character no-undo.
     2569       define variable v-sum-vat      like ub.fin-doc-tax.sum-vat-line-doc no-undo .
     2570       define buffer buf_clients for ub.clients.
     2571   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2572   if lookup(self :type
     2573            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2574            ) = 0
     2575   then do:
     2576     message
     2577       "$Workfile$"
     2578       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2579       "Интерфейсный элемент" self :name  skip
     2580       "Тип" self :type  skip
     2581       "Процедура" this-procedure :file-name skip
     2582       view-as alert-box .
     2583   end.
     2584   else do:
     2585     apply "entry":u to self  .
     2586     if focus :handle <> self :handle  then do:
     2587       return no-apply .
     2588     end.
     2589   end.
     2590   run ref/cli-all.w ( parParentProc
     2591     ,"b-sel"
     2592     , tt-fin-doc.payer-type
     2593     , ?
     2594     , ?
     2595     , (if available X_payer then recid(X_payer) else ?)
     2596     , ?
     2597     , "without-obj":U
     2598     , output ref-list) .
     2599   if ref-list = "" then
     2600   do:
     2601     return no-apply.
     2602   end.
     2603   ref-rec = integer( ref-list ).
     2604   FIND FIRST buf_clients WHERE recid (buf_clients) = ref-rec NO-LOCK .
     2605   if NOT (buf_clients.obj-type = 'орг':U
     2606     or
     2607     buf_clients.obj-type = 'чел':U ) then
     2608   do:
     2609     message
     2610       "Выберите контрагента типа" 'орг':U "или" 'чел':U
     2611       view-as alert-box error .
     2612     return no-apply.
     2613   end.
     2614   find first X_payer no-lock where
     2615     recid(X_payer) = recid(buf_clients).
     2616   assign
     2617     tt-fin-doc.payer-type = buf_clients.obj-type
     2618     tt-fin-doc.payer-code = buf_clients.obj-code
     2619     tt-fin-doc.payer-name = buf_clients.obj-name
     2620     .
     2621   display
     2622     tt-fin-doc.payer-type
     2623     tt-fin-doc.payer-code
     2624     tt-fin-doc.payer-name
     2625     with frame Dialog-Frame.
     2626   define variable v-recid-schet as recid no-undo . define variable v-recid-bank as recid no-undo . CASE X_payer.obj-type:   when 'чел':U then do:              find first X_payer-person no-lock where               X_payer-person.psn-code = X_payer.obj-code .   end.   when 'орг':U then do:     find first X_payer-firm no-lock where               X_payer-firm.firm-code = X_payer.obj-code .   end. END CASE.   assign   tt-fin-doc.payer-type =  X_payer.obj-type   tt-fin-doc.payer-code = X_payer.obj-code   tt-fin-doc.payer-name = X_payer.obj-name   tt-fin-doc.payer-inn = (if X_payer.obj-type = 'чел':U                             then X_payer-person.inn                             else X_payer-firm.inn                             )   tt-fin-doc.payer-kpp = (if X_payer.obj-type = 'чел':U                             then X_payer-person.kpp                             else X_payer-firm.kpp                             )   .   run get-single-schet in this-procedure (                                           input p-host-code                                           ,input X_payer.obj-type                                           ,input X_payer.obj-code                                           ,input tt-fin-doc.curr-code                                           ,output v-recid-schet                                           ,output v-recid-bank).   if v-recid-schet <> ? then do:     find first X_payer-fin-schet no-lock where                 recid(X_payer-fin-schet) = v-recid-schet.     find first X_payer-fin-bank no-lock where                 recid(X_payer-fin-bank) = v-recid-bank.     assign     tt-fin-doc.payer-code-schet = X_payer-fin-schet.code-schet     tt-fin-doc.payer-bank-name = X_payer-fin-bank.bank-name       tt-fin-doc.payer-bank-city = X_payer-fin-bank.bank-city       tt-fin-doc.payer-dop1       = X_payer-fin-schet.dop1     tt-fin-doc.payer-dop2       = X_payer-fin-schet.dop2     tt-fin-doc.payer-bik = X_payer-fin-bank.bik     tt-fin-doc.payer-r-schet = X_payer-fin-schet.r-schet     tt-fin-doc.payer-c-schet = X_payer-fin-schet.c-schet     .   end.   else do:     RELEASE X_payer-fin-schet.     RELEASE X_payer-fin-bank.     assign     tt-fin-doc.payer-code-schet = 0     tt-fin-doc.payer-bank-name = "":U     tt-fin-doc.payer-bank-city = "":U     tt-fin-doc.payer-dop1      = "":U     tt-fin-doc.payer-dop2      = "":U     tt-fin-doc.payer-bik = "":U     tt-fin-doc.payer-r-schet = "":U     tt-fin-doc.payer-c-schet = "":U     .   end. display tt-fin-doc.payer-type tt-fin-doc.payer-code tt-fin-doc.payer-name tt-fin-doc.payer-inn tt-fin-doc.payer-kpp tt-fin-doc.payer-bank-name tt-fin-doc.payer-bank-city tt-fin-doc.payer-bik tt-fin-doc.payer-r-schet tt-fin-doc.payer-c-schet with frame Dialog-Frame.
     2627   CASE X_payer.obj-type:   when 'чел':U then do:              find first X_payer-person no-lock where               X_payer-person.psn-code = X_payer.obj-code .   end.   when 'орг':U then do:     find first X_payer-firm no-lock where               X_payer-firm.firm-code = X_payer.obj-code .   end. END CASE. assign tt-fin-doc.payer-sign1  = if X_payer.obj-type = 'орг':U                              then X_payer-firm.director                             else X_payer.obj-name . display tt-fin-doc.payer-sign1 with frame Dialog-Frame.
     2628   find first ub.CashBook no-lock where ub.CashBook.id = tt-fin-doc.cashbookId no-error .
     2629   if ub.CashBook.cli-code = tt-fin-doc.payer-code and ub.CashBook.cli-type = tt-fin-doc.payer-type then do:
     2630   assign
     2631     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     2632     tt-fin-doc.cor-acc-value  = ub.CashBook.corrPko
     2633     tt-fin-doc.naznach-plat   = ub.CashBook.RuleOsnPko
     2634     .
     2635   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     2636     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     2637     and X_fin-code-cor-acc.status_ = integer('0':U)
     2638     no-error .
     2639   if available X_fin-code-cor-acc
     2640     then
     2641   do :
     2642     assign
     2643       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     2644       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     2645       .
     2646   end.
     2647   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     2648     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     2649     and X_fin-code-cor-acc1.status_ = integer('0':U)
     2650     no-error .
     2651   if available X_fin-code-cor-acc1
     2652     then
     2653   do :
     2654     assign
     2655       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     2656       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     2657       .
     2658   end.
     2659   assign
     2660     tt-fin-doc.including = "@, в том числе НДС" .
     2661     paramVne = "" .
     2662   end.
     2663   else
     2664   do:
     2665     if getCliKassa(tt-fin-doc.payer-type, tt-fin-doc.payer-code, "Vnecli", tt-fin-doc.cashbookId) then do:
     2666   assign
     2667     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     2668     .
     2669   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2670     and ub.CashBookRule.Obj-type   = 'всем':U
     2671     and ub.CashBookRule.Obj-code   = 0
     2672     and ub.CashBookRule.Code       = "corrPkoVne"
     2673     no-error.
     2674   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     2675   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2676     and ub.CashBookRule.Obj-type   = 'всем':U
     2677     and ub.CashBookRule.Obj-code   = 0
     2678     and ub.CashBookRule.Code       = "RuleOsnPkoVne"
     2679     no-error.
     2680   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     2681   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     2682     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     2683     and X_fin-code-cor-acc.status_ = integer('0':U)
     2684     no-error .
     2685   if available X_fin-code-cor-acc
     2686     then
     2687   do :
     2688     assign
     2689       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     2690       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     2691       .
     2692   end.
     2693   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     2694     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     2695     and X_fin-code-cor-acc1.status_ = integer('0':U)
     2696     no-error .
     2697   if available X_fin-code-cor-acc1
     2698     then
     2699   do :
     2700     assign
     2701       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     2702       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     2703       .
     2704   end.
     2705   assign
     2706     tt-fin-doc.including = "@, в т.ч.: без налога (НДС)" .
     2707     paramVne = "vne" .
     2708   end.
     2709   else do:
     2710     if getCliKassa(tt-fin-doc.payer-type, tt-fin-doc.payer-code, "Avanscli", tt-fin-doc.cashbookId) then do:
     2711   assign
     2712     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     2713     .
     2714   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2715     and ub.CashBookRule.Obj-type   = 'всем':U
     2716     and ub.CashBookRule.Obj-code   = 0
     2717     and ub.CashBookRule.Code       = "corrPkoAvans"
     2718     no-error.
     2719   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     2720   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2721     and ub.CashBookRule.Obj-type   = 'всем':U
     2722     and ub.CashBookRule.Obj-code   = 0
     2723     and ub.CashBookRule.Code       = "RuleOsnPkoAvans"
     2724     no-error.
     2725   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     2726   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     2727     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     2728     and X_fin-code-cor-acc.status_ = integer('0':U)
     2729     no-error .
     2730   if available X_fin-code-cor-acc
     2731     then
     2732   do :
     2733     assign
