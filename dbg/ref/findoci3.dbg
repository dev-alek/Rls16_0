     3177   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3178     and ub.CashBookRule.Obj-type   = 'всем':U
     3179     and ub.CashBookRule.Obj-code   = 0
     3180     and ub.CashBookRule.Code       = "RuleOsnPkoAvans"
     3181     no-error.
     3182   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     3183   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     3184     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3185     and X_fin-code-cor-acc.status_ = integer('0':U)
