      149   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      150   define variable v-waitfram-action01         as character   no-undo .
      151   define variable v-waitfram-action02         as character   no-undo .
      152   define variable v-waitfram-action03         as character   no-undo .
      153   define variable mWaitFramTextBeg            as character   no-undo.
      154   define variable mWaitFramTextEnd            as character   no-undo.
      155   define variable mWaitFramView               as logical     no-undo.
      156   define variable mWaitProcEvent              as logical     no-undo init yes.
      157   define variable mWaitFramInterval           as integer     no-undo init 1 .
      158   define variable mWaitFramStop               as logical     no-undo.
      159   define variable mWaitFramStopUser           as logical     no-undo.
      160   define variable mWaitFramStopTimeOut        as logical     no-undo.
      161   define variable mWaitFramStartProc          as datetime-tz no-undo.
      162   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      163   define button B-WaitFramStop auto-end-key
      164        label "Стоп"
      165        size 10 by 1 tooltip "Остоновить процесс".
      166   define button B-viewProcInfo
      167        label "Информация"
      168        size 15 by 1 tooltip "Информация о процесс".
      169   define frame waitfram
      170     v-waitfram-action01 format "x(72)" no-label skip
      171     v-waitfram-action02 format "x(72)" no-label skip
      172     v-waitfram-action03 format "x(72)" no-label skip
      173     B-viewProcInfo
      174     B-WaitFramStop at row 4 col 30
      175     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      176     .
      177   define new global shared variable mBatchMode as logical no-undo init ?.
      178   define variable mFramBachModHandle as handle no-undo.
      179   mFramBachModHandle = frame waitfram:handle.
      180   define variable mFameOldVis as logical no-undo.
      181   define variable mVisCUrentVin as logical no-undo.
      182   if session:batch-mode
      183   then
      184      mBatchMode = yes.
      185   if mBatchMode = ? then do:
      186     mVisCUrentVin = current-window:visible.
      187     mFameOldVis = mFramBachModHandle:visible.
      188     mFramBachModHandle:visible  = yes.
      189     mBatchMode = mFramBachModHandle:visible ne yes.
      190     mFramBachModHandle:visible = mFameOldVis.
      191     current-window:visible = mVisCUrentVin.
      192   end.
      193    if  log-manager:logfile-name ne ?
      194     then DO:
      195         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      196         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      197         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      198     end.
      199   on choose of B-WaitFramStop in frame waitfram
      200   do:
      201     mWaitFramStop = yes.
      202     mWaitFramStopUser = yes.
      203   end.
      204   function waitfram-check-timeout returns logical():
      205      define variable vtime as int64 no-undo.
      206      if mWaitFramStopTimeOut
      207      then
      208         return yes.
      209      vtime = ( now - mWaitFramStartProc ) / 1000 .
      210      if     mWaitFramTimeOut ne ?
      211         and mWaitFramTimeOut ne 0
      212         and mWaitFramTimeOut lt vtime
      213      then do:
      214         mWaitFramStopTimeOut = yes.
      215      end.
      216      return mWaitFramStopTimeOut.
      217   end.
      218   procedure waitfram-hide :
      219     if not session:batch-mode
      220     then do
      221     on error undo, return error return-value
      222     :
      223       pause 0 before-hide .
      224       if not mBatchMode then
      225         hide frame waitfram .
      226     if     not mWaitFramView
      227        and mWaitProcEvent
      228     then
      229       process events .
      230     end.
      231   end procedure.
      232   procedure waitfram-show :
      233     define input  parameter p-message as character no-undo .
      234     define variable v-left-margin as integer   no-undo .
      235     if not session:batch-mode
      236     then do
      237     on error undo, return error return-value
      238     :
      239       if length(p-message) <= 70 then do:
      240         assign
      241           v-left-margin = integer((70 - length(p-message)) / 2)
      242         .
      243         assign
      244           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      245         .
      246         assign
      247           v-waitfram-action01 = " "
      248           v-waitfram-action02 = " "
      249                                    + fill(" ", v-left-margin)
      250                                    + p-message
      251           v-waitfram-action03 = " "
      252         .
      253       end.
      254       else do:
      255         define variable vRindex1 as integer no-undo.
      256         define variable vRindex2 as integer no-undo.
      257         vRindex1 = r-index(p-message," ",70).
      258         if vRindex1 = 0
      259         then
      260            vRindex1 = 70.
      261         if length(p-message)  <= vRindex1 + 70 then do:
      262           assign
      263             v-waitfram-action01 = " "
      264             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      265             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      266           .
      267         end.
      268         else do:
      269           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      270           if vRindex2 <= vRindex1
      271           then
      272              vRindex2 = vRindex1 + 70.
      273           assign
      274             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      275             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      276             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      277           .
      278         end.
      279       end.
      280       B-viewProcInfo:visible   in frame waitfram = no.
      281       B-viewProcInfo:sensitive in frame waitfram = no.
      282       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      283       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      284       if  (   mWaitFramView
      285          or  mWaitProcEvent)
      286          and not mBatchMode
      287       then
      288          display
      289             v-waitfram-action01 skip
      290             v-waitfram-action02 skip
      291             v-waitfram-action03 skip
      292          with frame waitfram .
      293       if     mWaitFramView
      294          then do:
      295             if     mWaitFramInterval ne ?
      296                and not mBatchMode
      297             then
      298                wait-for go of frame waitfram pause mWaitFramInterval.
      299          end.
      300          else
      301             if     mWaitProcEvent
      302                and not mBatchMode
      303             then
      304                process events .
      305     end.
      306   end procedure.
      307      procedure waitfram-show-this:
      308         define input  parameter iInterval as int64 no-undo.
      309         define variable vtime as int64 no-undo.
      310         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      311         mWaitFramInterval = iInterval.
      312         run waitfram-show (substitute("&1&2 &3&4" ,
      313                                       mWaitFramTextBeg ,
      314                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      315                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      316                                       mWaitFramTextEnd
      317                                      )
      318                           ).
      319      end.
      320      procedure WaitFramRunPause:
      321         define input  parameter iInterval as dec no-undo.
      322         define variable vStart  as datetime-tz no-undo.
      323         define variable vend    as datetime-tz no-undo.
      324         define variable vint as int64 no-undo.
      325         define variable vOk as logical no-undo.
      326         vStart = now.
      327         vend   = vStart.
      328         publish "WaitFramPause" (iInterval,output vOk).
      329         vend   =  now.
      330         vint = vend - vStart.
      331         vint = iInterval - vint / 1000.
      332         if     not mWaitFramStop
      333            and (   vint > 0
      334                 or (    not vOk
      335                     and iInterval eq ?
      336                     )
      337                 )
      338         then
      339            run waitfram-show-this (iInterval).
      340         vend   =  now.
      341         vint = vend - vStart.
      342         vint = iInterval - vint / 1000.
      343         if     not mWaitFramStop
      344            and vint > 0
      345         then do:
      346            run gbl/pause.p (vint * 1000).
      347         end.
      348         if iInterval ne ?
      349         then
      350            publish "WaitFramStop".
      351         waitfram-check-timeout().
      352      end.
      353      procedure WaitFramWaitFor:
      354         define input  parameter iInterval as dec no-undo.
      355         assign
      356            mWaitFramStartProc   = now
      357            mWaitFramStopUser    = no
      358            mWaitFramStopTimeOut = no
      359         .
      360         block-wait:
      361         do while not mWaitFramStop:
      362            run WaitFramRunPause (iInterval).
      363            if  waitfram-check-timeout()
      364            then do:
      365               leave block-wait.
      366            end.
      367         end.
      368         run waitfram-hide.
      369      end.
      370   procedure waitfram-join :
      371     define input  parameter p-line-1  as character no-undo .
      372     define input  parameter p-line-2  as character no-undo .
      373     define input  parameter p-line-3  as character no-undo .
      374     define output parameter p-message as character no-undo .
      375     do
      376     on error undo, return error return-value
      377     :
      378       assign
      379         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      380                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      381                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      382       .
      383     end.
      384   end procedure.
      385   function waitfram-join-function returns character
      386     (input p-line-1 as character
      387     ,input p-line-2 as character
      388     ,input p-line-3 as character
      389     ).
      390     define variable v-message as character no-undo .
      391     run waitfram-join in this-procedure
      392       (input  p-line-1
      393       ,input  p-line-2
      394       ,input  p-line-3
      395       ,output v-message
      396       ) .
      397     return v-message .
      398   end function .
      399   procedure proc-alt-shift-f2:
      400     if not ibs.th.gbl.gbl-var:rcode
      401   then
      402     run gbl\inidebug.p .
      403   end.
      404   procedure proc-alt-shift-f3:
      405     run gbl/prvssinf.p
      406       ( input this-procedure
      407       ) .
      408   end.
      409   define variable v-inform-launched as logical no-undo initial false .
      410   procedure proc-alt-shift-f4:
      411     define variable v-action as character no-undo .
      412     if v-inform-launched = false then do:
      413       assign
      414         v-inform-launched = true
      415       .
      416       run gbl/d-inform.w
      417         (  input self
      418         ,  input this-procedure
      419         , output v-action
      420         ) no-error .
      421       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      422       assign
      423         v-inform-launched = false
      424       .
      425     end.
      426   end.
      427   procedure proc-alt-f1:
      428     run gbl/corrhelp.p
      429       (input this-procedure
      430       ) .
      431   end .
      432   on alt-shift-f2 anywhere do:
      433     run proc-alt-shift-f2.
      434   end.
      435   on alt-shift-f3 anywhere do:
      436     run proc-alt-shift-f3 in this-procedure .
      437   end.
      438   on alt-shift-f4 anywhere do:
      439     run proc-alt-shift-f4 in this-procedure.
      440   end.
      441   on alt-f1 anywhere do:
      442     run proc-alt-f1 in this-procedure .
      443   end.
      444   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      445   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      446   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      447   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      448   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      449   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      450   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      451   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      452   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      453   procedure uf-name :
      454     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      455     define output parameter p-use-List_     as logical   no-undo .
      456     define output parameter p-type-List_     as character no-undo .
      457     define output parameter p-format-List_   as character no-undo .
      458     define output parameter p-use-Naim      as logical   no-undo .
      459     define output parameter p-type-Naim      as character no-undo .
      460     define output parameter p-format-Naim    as character no-undo .
      461     define output parameter p-use-print-graft as logical   no-undo .
      462     define output parameter p-use-sort-gr   as logical   no-undo .
      463     define output parameter p-use-type-price as logical   no-undo .
      464     define output parameter p-use-type-val  as logical   no-undo .
      465     define output parameter p-label          as character no-undo .
      466     define output parameter p-tooltip        as character no-undo .
      467     define output parameter p-user-can-edit  as logical   no-undo .
      468     define output parameter p-output-display as logical   no-undo .
      469     define output parameter p-other          as character no-undo .
      470     do
      471     on error undo, return error
      472     :
