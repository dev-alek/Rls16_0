     3164     paramVne = "vne" .
     3165   end.
     3166   else do:
     3167     if getCliKassa(tt-fin-doc.payer-type, tt-fin-doc.payer-code, "Avanscli", tt-fin-doc.cashbookId) then do:
     3168   assign
