     5235             tt-fin-doc.receiver-bank-city tt-fin-doc.receiver-r-schet
     5236             tt-fin-doc.receiver-bik tt-fin-doc.receiver-c-schet
     5237             tt-fin-doc.naznach-plat tt-fin-doc.PS tt-fin-doc.payer-sign1
     5238             tt-fin-doc.payer-sign2
