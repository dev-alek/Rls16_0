     3321   ON CHOOSE OF B-cashbook IN FRAME Dialog-Frame
     3322     DO:
     3323       define variable v-cb-brw as class ibs.th.ref.cashbookbrw no-undo .
     3324       v-cb-brw = new ibs.th.ref.cashbookbrw ( 'ВЫБОР':U, parparentproc ).
     3325       wait-for  v-cb-brw:ShowDialog() .
     3326       if v-cb-brw:out-list-id > ""
     3327         then
     3328       do :
     3329         find first ub.cashbook no-lock where ub.cashbook.id = int64(v-cb-brw:out-list-id) .
     3330         tt-fin-doc.cashbookId = ub.cashbook.id .
     3331         f-cashbook = ub.CashBook.CashBookName .
     3332         display
     3333           f-cashbook
     3334           with frame Dialog-Frame .
     3335         IF LOOKUP("update_prc-doc-code-mask", THIS-PROCEDURE:INTERNAL-ENTRIES) >  0
     3336           THEN
     3337           run update_prc-doc-code-mask (no).
     3338         run check-obj in this-procedure (   input tt-fin-doc.obj-type
     3339           ,input tt-fin-doc.obj-code
     3340           )
     3341           no-error.
     3342         find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = (if tt-fin-doc.fin-doc-type eq 'рко':U then ub.cashbook.corrRko else ub.cashbook.corrPko)
     3343           and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3344           and X_fin-code-cor-acc.status_ = integer('0':U)
     3345           no-error .
     3346         if available X_fin-code-cor-acc
     3347           then
     3348         do :
     3349           assign
     3350             tt-fin-doc.cor-acc-value = X_fin-code-cor-acc.code-value
     3351             f-cor-acc-descr          = X_fin-code-cor-acc.descr
     3352             tt-fin-doc.cor-acc       = X_fin-code-cor-acc.fin-code
     3353             .
     3354         end.
     3355         else
     3356         do:
     3357           if ub.cashbook.corrRko = "" then
     3358           do:
     3359             for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = "57.01"
     3360               and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     3361               tt-fin-doc.cor-acc = ub.fin-code-cor-acc.fin-code .
     3362               tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     3363             end.
     3364           end.
     3365         end.
     3366         if ub.CashBook.OsnAcct <> "" then
     3367         do:
     3368           find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = ub.CashBook.OsnAcct
     3369             and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3370             and X_fin-code-cor-acc.status_ = integer('0':U)
     3371             no-error .
     3372           if available X_fin-code-cor-acc
     3373             then
     3374           do :
     3375             assign
     3376               tt-fin-doc.cor-acc1-value = X_fin-code-cor-acc.code-value
     3377               f-cor-acc1-descr          = X_fin-code-cor-acc.descr
     3378               tt-fin-doc.cor-acc1       = X_fin-code-cor-acc.fin-code
     3379               .
     3380           end.
     3381           else
     3382           do:
     3383             assign
     3384               tt-fin-doc.cor-acc1-value = ""
     3385               f-cor-acc1-descr          = ""
     3386               tt-fin-doc.cor-acc1       = ?
     3387               .
     3388           end.
     3389         end.
     3390       end.
     3391       display
     3392         tt-fin-doc.cor-acc-value
     3393         f-cor-acc-descr
     3394         tt-fin-doc.cor-acc
     3395         tt-fin-doc.cor-acc1-value
     3396         f-cor-acc1-descr
     3397         tt-fin-doc.cor-acc1
     3398         with frame Dialog-Frame .
     3399     END.
