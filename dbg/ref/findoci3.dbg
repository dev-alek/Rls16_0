     2735       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     2736       .
     2737   end.
     2738   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     2739     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     2740     and X_fin-code-cor-acc1.status_ = integer('0':U)
     2741     no-error .
