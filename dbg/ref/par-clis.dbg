     1175   define  stream PrnLibStream.
     1176   procedure prn-lib-prn-file :
     1177     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1178     define input parameter p-DIsabledoptions as integer no-undo .
     1179     define variable v-report-name as character no-undo .
     1180     define variable v-user-action as character no-undo .
     1181     define variable v-printed     as logical   no-undo .
     1182     define variable v-exist       as logical   no-undo .
     1183     do
     1184       on error undo, return error
     1185       :
     1186       run prn-lib-get-report-name  in this-procedure (
     1187         input parParentProc
     1188         ,output v-report-name
     1189         ).
     1190   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1191   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1192     (input  v-report-name
     1193     ,input  2
     1194     ,output v-exist
     1195     )  .
     1196       if NOT v-exist then
     1197       DO:
     1198         Message
     1199           "Нет заданий на печать ! "
     1200           view-as alert-box .
     1201         Return  .
     1202       End.
     1203       run gbl/prnfilen.w
     1204         (input  ""
     1205         ,input  p-DisabledOptions
     1206         ,input  string(v-report-name )
     1207         ,input  7
     1208         ,output v-user-action
     1209         ,output v-printed
     1210         ) .
     1211       if v-printed then
     1212       do:
     1213         return "YES" .
     1214       end.
     1215       else
     1216       do:
     1217         return "NO" .
     1218       end.
     1219     end.
     1220   end procedure.
     1221   procedure prn-lib-open-stream :
     1222     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1223     define input parameter p-page-size    as integer no-undo .
     1224     define input parameter p-is-stream    as logical no-undo .
     1225     define input parameter p-append       as logical no-undo .
     1226     define variable v-report-name as character no-undo .
     1227     do
     1228       on error undo, return error
     1229       :
     1230       run prn-lib-get-report-name  in this-procedure (
     1231         input parParentProc
     1232         ,output v-report-name
     1233         ).
     1234       if p-is-stream then
     1235       do:
     1236         if p-append then
     1237         do:
     1238           output stream PrnLibStream to value( v-report-name )
     1239             page-size value(p-page-size) append .
     1240         end.
     1241         if not p-append then
     1242         do:
     1243           output stream PrnLibStream to value( v-report-name )
     1244             page-size value(p-page-size) .
     1245         end.
     1246       end.
     1247       if not p-is-stream then
     1248       do:
     1249         if p-append then
     1250         do:
     1251           output to value( v-report-name )
     1252             page-size value(p-page-size) append .
     1253         end.
     1254         if not p-append then
     1255         do:
     1256           output to value( v-report-name )
     1257             page-size value(p-page-size) .
     1258         end.
     1259       end.
     1260     end.
     1261   end procedure.
     1262   procedure prn-lib-open-exp :
     1263     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1264     define input parameter p-is-stream    as logical no-undo .
     1265     define input parameter p-is-append    as logical no-undo .
     1266     define output parameter p-ReportFileName as char init "report" no-undo.
     1267     define output parameter p-process as logical no-undo .
     1268     define variable glog as logical no-undo .
     1269     do
     1270       on error undo, return error
     1271       :
     1272       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1273         TITLE      "Укажите путь"
     1274         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1275         ASK-OVERWRITE
     1276         CREATE-TEST-FILE
     1277         SAVE-AS
     1278         USE-FILENAME
     1279         DEFAULT-EXTENSION "txt"
     1280         UPDATE glog
     1281         .
     1282       if not glog then  return.
     1283       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1284       if p-is-stream then
     1285       do:
     1286         if p-is-append then
     1287         do:
     1288           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1289         end.
     1290         else
     1291         do:
     1292           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1293         end.
     1294       end.
     1295       else
     1296       do:
     1297         if p-is-append then
     1298         do:
     1299           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1300         end.
     1301         else
     1302         do:
     1303           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1304         end.
     1305       end.
     1306       p-process = yes.
     1307     end.
     1308   end procedure.
     1309   procedure prn-lib-get-report-name :
     1310     define input parameter parParentProc  as widget-handle no-undo.
     1311     define output parameter p-report-name as character no-undo .
     1312     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1313   end procedure.
     1314   procedure prn-lib-reportviewer-report-name :
     1315     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1316     define input parameter p-report-name-html as character no-undo .
     1317     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1318   end procedure.
     1319   procedure prn-lib-reportviewer :
     1320     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1321     define input parameter p-report-name-html as character no-undo .
     1322     define input parameter p-param        as character no-undo .
     1323     define variable v-excel           as character no-undo init 'TRUE' .
     1324     define variable v-value-character as character no-undo .
     1325     define variable v-value-integer   as character no-undo .
     1326     define variable v-value-date      as date      no-undo .
     1327     define variable v-value-decimal   as decimal   no-undo .
     1328     define variable rep-excel         as logical   no-undo .
     1329     define variable excel-string      as character no-undo .
     1330     define variable v-param-type      as character no-undo .
     1331     define variable v-tth             as handle    no-undo .
     1332     run adm/shattri.p (
     1333       input "get":U
     1334       ,input  ""
     1335       ,input  0
     1336       ,input  'report-glob':U
     1337       ,input  'rep-excel':U
     1338       ,output v-value-character
     1339       ,output v-value-date
     1340       ,output v-value-decimal
     1341       ,output v-value-integer
     1342       ,output rep-excel
     1343       ,output v-param-type
     1344       ,INPUT-OUTPUT table-handle v-tth
     1345       )  .
     1346     if rep-excel then v-excel = "TRUE" .
     1347     else v-excel = "FALSE" .
     1348     if p-param eq ""
     1349     then
     1350        p-param = "EXCEL:" + v-excel.
     1351     else
     1352        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1353     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1354   end procedure.
     1355   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1356   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1357   procedure fltopend_fltopend :
     1358   define input parameter p-parent-handle as handle no-undo .
     1359   define input parameter p-qh as handle no-undo .
     1360   define input parameter p-flt-open-open-query  as character no-undo .
     1361   define input parameter p-where-cond as character no-undo .
     1362   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1363   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1364   define input parameter p-indexed-reposition as character no-undo .
     1365     do
     1366     on error undo, return error
     1367     :
     1368   define variable v-prepare-string as character no-undo .
     1369   define variable glog as logical no-undo .
     1370   assign
     1371   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1372                      p-where-cond + chr(32)  +
     1373                      p-use-indFIRST-query-tail + chr(32) +
     1374                      p-use-ind-sort-clmn-by + chr(32) +
     1375                      p-indexed-reposition
     1376   .
     1377   assign
     1378   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1379   if not glog
     1380   or error-status:error then do:
     1381     message error-status:get-message(1) view-as alert-box .
     1382     undo, return error .
     1383   end.
     1384   assign
     1385   glog = p-qh:query-open no-error .
     1386   if not glog
     1387   or error-status:error then do:
     1388     message error-status:get-message(1) view-as alert-box .
     1389     undo, return error .
     1390   end.
     1391     end.
     1392   end procedure.
     1393   procedure fltopend_fltfindd :
     1394   define input parameter p-parent-handle as handle no-undo .
     1395   define input parameter p-qh as handle no-undo .
     1396   define input parameter p-rowid as rowid no-undo .
     1397   define input parameter p-next as logical no-undo .
     1398   define input parameter p-lock as integer no-undo .
     1399   define input parameter p-bh as handle no-undo .
     1400   define input parameter p-where-cond as character no-undo .
     1401   define input parameter p-use-index-phrase as character no-undo .
     1402   define variable glog as logical no-undo .
     1403   define variable v-qh as handle no-undo .
     1404   define variable v-bh as handle no-undo .
     1405   define variable v-recid as recid no-undo .
     1406   define variable v-prepare-string as character no-undo .
     1407   do
     1408   on error undo, return error
     1409   on stop undo, return error
     1410   :
     1411     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1412     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1413     create query v-qh.
     1414     v-qh:set-buffers(v-bh).
     1415     v-prepare-string = substitute("for each &1 &2 &3"
     1416                                     ,v-bh:name
     1417                                     ,p-where-cond
     1418                                     ,p-use-index-phrase).
     1419     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1420     if not glog then do:
     1421       delete object v-qh.
     1422       delete object v-bh.
     1423       undo, return error .
     1424     end.
     1425     glog = v-qh:query-open no-error .
     1426     if not glog then do:
     1427       delete object v-qh.
     1428       delete object v-bh.
     1429       undo, return error .
     1430     end.
     1431     if p-next then do:
     1432       v-qh:reposition-to-rowid(p-rowid) no-error .
     1433       glog = v-qh:get-next( p-lock) no-error .
     1434       glog = v-qh:get-next( p-lock) no-error .
     1435       if not glog or v-qh:query-off-end = yes then do:
     1436         glog = v-qh:get-first( p-lock) no-error .
     1437       end.
     1438     end.
     1439     else do:
     1440       glog = v-qh:get-first( p-lock) no-error .
     1441     end.
     1442     v-recid = v-bh:recid no-error .
     1443     delete object v-qh.
     1444     delete object v-bh.
     1445     return string(v-recid) .
     1446   end.
     1447   end procedure.
     1448   procedure fltopend_fltfindq :
     1449   define input parameter p-parent-handle as handle no-undo .
     1450   define input parameter p-qh as handle no-undo .
     1451   define input parameter p-next as logical no-undo .
     1452   define input parameter p-lock as integer no-undo .
     1453   define input parameter p-flt-open-open-query  as character no-undo .
     1454   define input parameter p-where-cond as character no-undo .
     1455   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1456   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1457   define input parameter p-indexed-reposition as character no-undo .
     1458   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1459   define variable glog as logical no-undo .
     1460   define variable v-qh as handle no-undo .
     1461   define variable v-bh as handle no-undo extent 18.
     1462   define variable v-rowid as rowid no-undo extent 18.
     1463   define variable v-ii as integer no-undo .
     1464   define variable v-prepare-string as character no-undo .
     1465   do
     1466   on error undo, return error
     1467   on stop undo, return error
     1468   :
     1469     create query v-qh.
     1470     do v-ii = 1 to p-qh:num-buffers:
     1471       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1472       assign
     1473       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1474       no-error.
     1475       v-qh:add-buffer(v-bh[v-ii]).
     1476     end.
     1477     assign
     1478     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1479                       p-where-cond + chr(32)  +
     1480                       p-use-indFIRST-query-tail + chr(32) +
     1481                       p-use-ind-sort-clmn-by + chr(32) +
     1482                       p-indexed-reposition
     1483     .
     1484     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1485     if not glog then do:
     1486       delete object v-qh.
     1487       do v-ii = 1 to p-qh:num-buffers:
     1488         delete object v-bh[v-ii].
     1489       end.
     1490       undo, return error .
     1491     end.
     1492     glog = v-qh:query-open no-error .
     1493     if not glog then do:
     1494       delete object v-qh.
     1495       do v-ii = 1 to p-qh:num-buffers:
     1496         delete object v-bh[v-ii].
     1497       end.
     1498       undo, return error .
     1499     end.
     1500     if p-next then do:
     1501       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1502       glog = v-qh:get-next( p-lock) no-error .
     1503       glog = v-qh:get-next( p-lock) no-error .
     1504       if not glog or v-qh:query-off-end = yes then do:
     1505         glog = v-qh:get-first( p-lock) no-error .
     1506       end.
     1507     end.
     1508     else do:
     1509       glog = v-qh:get-first( p-lock) no-error .
     1510     end.
     1511     do v-ii = 1 to p-qh:num-buffers:
     1512       assign
     1513       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1514       no-error.
     1515     end.
     1516     delete object v-qh.
     1517     do v-ii = 1 to p-qh:num-buffers:
     1518       delete object v-bh[v-ii].
     1519     end.
     1520   end.
     1521   end procedure.
     1522   define variable sort-column-name as character no-undo.
     1523   define variable filter-point     as character NO-UNDO INIT "elc-clis".
     1524   define variable filter-label     as character NO-UNDO INIT "Коды клиентов в системе ПАРУС".
     1525   define variable filter-point0     as character NO-UNDO INIT "elc-clis".
     1526   define variable filter-label0     as character NO-UNDO INIT "Коды клиентов в системе ПАРУС".
     1527   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1528   FUNCTION get-cli-name RETURNS CHARACTER
     1529     ( INPUT p-uniq-key-rec AS CHARACTER )  FORWARD.
     1530   FUNCTION get-cli-type-code RETURNS CHARACTER
     1531     ( INPUT p-uniq-key-rec AS character )  FORWARD.
     1532   DEFINE BUTTON b-add
     1533        LABEL "&Добавить"
     1534        SIZE 10 BY 1.
     1535   DEFINE BUTTON b-cli
     1536        LABEL "Клиент"
     1537        SIZE 10 BY 1.
     1538   DEFINE BUTTON b-del
     1539        LABEL "&Удалить"
     1540        SIZE 10 BY 1.
     1541   DEFINE BUTTON B-Help
     1542        LABEL "Помо&щь"
     1543        SIZE 3 BY 1
     1544        BGCOLOR 8 .
     1545   DEFINE BUTTON B-mark
     1546        LABEL "&*"
     1547        SIZE 3 BY 1.
     1548   DEFINE BUTTON b-print
     1549        LABEL "&Печать"
     1550        SIZE 3 BY 1.
     1551   DEFINE BUTTON b-quit AUTO-END-KEY
     1552        LABEL "&Выход"
     1553        SIZE 10 BY 1
     1554        BGCOLOR 8 .
     1555   DEFINE BUTTON b-sch
     1556        LABEL "Фильтр"
     1557        SIZE 3 BY 1.
     1558   DEFINE BUTTON B-sel AUTO-GO
     1559        LABEL "Вы&бор"
     1560        SIZE 10 BY 1.
     1561   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1562         VIEW-AS TEXT
     1563        SIZE 6 BY 1
     1564        FGCOLOR 4  NO-UNDO.
     1565   DEFINE QUERY br-parus-cli FOR X_ext-classif, X_clients SCROLLING.
     1566   DEFINE BROWSE br-parus-cli
     1567     QUERY br-parus-cli NO-LOCK DISPLAY
     1568         mark-string(recid(X_ext-classif), v-rid-list) COLUMN-LABEL "" FORMAT "X(1)"
     1569   X_ext-classif.KEY#_one  COLUMN-LABEL "Код в!ПАРУС" FORMAT ">>>>>>>>9"
     1570   X_clients.obj-type COLUMN-LABEL "Тип!клиента" FORMAT "X(3)"
     1571   X_clients.obj-code COLUMN-LABEL "Код!клиента" FORMAT ">>>>>>>>9"
     1572   X_clients.obj-name COLUMN-LABEL "Название клиента" FORMAT "X(60)"
     1573       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.25 BY 20.38 FIT-LAST-COLUMN.
     1574   DEFINE FRAME Dialog-Frame
     1575        b-quit AT ROW 1 COL 1
     1576        B-mark AT ROW 1 COL 11 WIDGET-ID 4
     1577        B-sel AT ROW 1 COL 21 WIDGET-ID 6
     1578        b-add AT ROW 1 COL 31 WIDGET-ID 14
     1579        b-del AT ROW 1 COL 41 WIDGET-ID 16
     1580        b-cli AT ROW 1 COL 51 WIDGET-ID 2
     1581        b-sch AT ROW 1 COL 86 WIDGET-ID 12
     1582        b-print AT ROW 1 COL 89 WIDGET-ID 10
     1583        B-Help AT ROW 1 COL 95
     1584        br-parus-cli AT ROW 2.88 COL 1.5 WIDGET-ID 100
     1585        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL WIDGET-ID 8
     1586        SPACE(79.30) SKIP(21.26)
     1587       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1588            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1589            TITLE ""
     1590            CANCEL-BUTTON b-quit.
     1591   ASSIGN
     1592          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1593          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1594   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1595   DO:
     1596     APPLY "END-ERROR":U TO SELF.
     1597   END.
     1598   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1599   DO:
     1600     RUN proc-b-add IN THIS-PROCEDURE NO-ERROR.
     1601     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1602   END.
     1603   ON CHOOSE OF b-cli IN FRAME Dialog-Frame
     1604   DO:
     1605     IF NOT AVAILABLE X_clients THEN RETURN NO-APPLY.
     1606     run ref/showcli.p ( INPUT parparentproc
     1607                        ,INPUT X_clients.obj-type
     1608                        ,INPUT X_clients.obj-code) NO-ERROR.
     1609     APPLY "entry" TO br-parus-cli.
     1610   END.
     1611   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1612   DO:
     1613     IF NOT AVAILABLE X_ext-classif THEN RETURN NO-APPLY.
     1614     RUN proc-b-del IN THIS-PROCEDURE NO-ERROR.
     1615     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1616   END.
     1617   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1618   DO:
     1619     define variable loc#log as logical no-undo .
     1620     if available X_ext-classif then do:
     1621   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1622   define variable v-str-recid14 as character no-undo .
     1623   define variable v-num-entry14 as integer   no-undo .
     1624   assign
     1625     v-str-recid14 = trim( string( recid( X_ext-classif ) , "->>>>>>>>>>>9":U ) )
     1626     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1627   .
     1628   if v-num-entry14 > 0 then do:
     1629     assign
     1630       entry( v-num-entry14, v-rid-list ) = "":U
     1631       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1632     .
     1633   end.
     1634   else do:
     1635     assign
     1636       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1637     .
     1638   end.
     1639       loc#log = br-parus-cli:refresh() .
     1640       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1641           loc#log = br-parus-cli:select-next-row ().
     1642           apply "VALUE-CHANGED" to br-parus-cli in frame Dialog-Frame.
     1643       end.
     1644       if num-entries( v-rid-list ) = 0
     1645       then
     1646           hide mark-num in frame Dialog-Frame.
     1647       else
     1648           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1649     end.
     1650     apply "entry" to br-parus-cli in frame Dialog-Frame.
     1651   END.
     1652   ON CHOOSE OF b-print IN FRAME Dialog-Frame
     1653   DO:
     1654     run proc-b-print IN THIS-PROCEDURE NO-ERROR.
     1655     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1656   END.
     1657   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     1658   DO:
     1659     run proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1660     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1661   END.
     1662   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1663   DO:
     1664       if ( available X_ext-classif ) then do:
     1665       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1666       then
     1667       v-rid-list = string( recid( X_ext-classif ) ) .
     1668     end.
     1669   END.
     1670   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1671   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1672   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1673   on help of frame Dialog-Frame
     1674   do:
     1675     run gbl/app_help.p
     1676       (input this-procedure :file-name
     1677       ,input ''
     1678       ,input ?
     1679       ) no-error.
     1680     if error-status :error then do:
     1681       message
     1682         "Ошибка при вызове помощи"
     1683         error-status :get-message(1)
     1684         view-as alert-box .
     1685     end.
     1686   end.
     1687   run minbtn-set in this-procedure .
     1688   on choose of b-help in frame Dialog-Frame
     1689   do:
     1690     apply "help":u to frame Dialog-Frame .
     1691   end.
     1692   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1693   procedure minbtn-set :
     1694       do
     1695           on error undo, return error return-value
     1696           :
     1697           define variable ii              as integer       no-undo .
     1698           define variable fh              as widget-handle no-undo .
     1699           define variable hh              as widget-handle no-undo .
     1700           define variable v-h             as handle        extent 4 no-undo .
     1701           define variable v-name-button   as character     no-undo .
     1702           define variable v-help-old-x    as decimal       no-undo .
     1703           define variable v-help-old-y    as decimal       no-undo .
     1704           define variable v-help-old-size as decimal       no-undo .
     1705           define variable v-frame-width   as decimal       no-undo .
     1706           define variable jj              as integer       no-undo .
     1707           do
     1708               on error undo, return error
     1709               :
     1710               assign
     1711                   v-frame-width = frame Dialog-Frame:width - 0.3
     1712                   fh            = frame Dialog-Frame:first-child
     1713                   hh            = fh:first-child
     1714                   ii            = 1
     1715                   .
     1716               do while valid-handle(hh):
     1717                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1718                   do:
     1719                       case lc(hh:name) :
     1720                           when "b-help" then
     1721                               do:
     1722                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1723                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1724                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1725                                   hh:TOOLTIP = "Помощь" .
     1726                                   v-help-old-x = hh:column .
     1727                                   v-help-old-y = hh:row    .
     1728                                   v-help-old-size = hh:width .
     1729                                   hh:width-chars = 2.5 .
     1730                               end.
     1731                           when "b-print" then
     1732                               do:
     1733                                   hh:load-image("cmp/b-print.bmp":u) .
     1734                                   hh:TOOLTIP = "Печать" .
     1735                                   v-h[ii] = hh:handle .
     1736                                   ii = ii + 1 .
     1737                                   hh:width-chars = 3 .
     1738                               end.
     1739                           when "b-history" or
     1740                           when "b-hist" then
     1741                               do:
     1742                                   hh:load-image("cmp/b-hist.bmp":u) .
     1743                                   hh:TOOLTIP = "История" .
     1744                                   v-h[ii] = hh:handle .
     1745                                   ii = ii + 1 .
     1746                                   hh:width-chars = 3 .
     1747                               end.
     1748                           when "b-sch" then
     1749                               do:
     1750                                   hh:load-image("cmp/b-sch.bmp":u) .
     1751                                   hh:TOOLTIP = "Установка Фильтра" .
     1752                                   v-h[ii] = hh:handle .
     1753                                   ii = ii + 1 .
     1754                                   hh:width-chars = 3 .
     1755                               end.
     1756                           when "b-hist-user" then
     1757                               do:
     1758                                   hh:load-image("cmp/b-hist.bmp":u) .
     1759                                   hh:TOOLTIP = "История пользователя" .
     1760                                   ii = ii + 1 .
     1761                               end.
     1762                       end case.
     1763                   end.
     1764                   hh = hh:next-sibling.
     1765               end.
     1766               b-help:column = v-frame-width - b-help:width-chars.
     1767               jj = 0.
     1768               repeat ii = 4 to 1 by -1 :
     1769                   if valid-handle (v-h[ii] ) then
     1770                   do:
     1771                       jj  = jj + 1 .
     1772                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1773                       v-h[ii]:row    = v-help-old-y .
     1774                   end.
     1775               end.
     1776           end.
     1777       end.
     1778   end procedure.
     1779   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1780   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1781   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1782   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1783   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1784   define variable v-diasize-current-frame-height as decimal   no-undo .
     1785   define variable v-diasize-change-size          as logical   no-undo .
     1786   define variable v-diasize-resize-button        as handle    no-undo .
     1787   define variable v-diasize-wndmax               as logical   no-undo .
     1788   define variable v-diasize-wndstore             as logical   no-undo .
     1789   define variable v-diasize-proc-name            as character no-undo .
     1790   define variable v-diasize-browse-handle        as handle    no-undo .
     1791   define variable v-diasize-browse-number        as integer   no-undo .
     1792   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1793   define temp-table temp-diasize-handle no-undo
     1794     field handle-value  as handle
     1795     field save-position as decimal
     1796     index xpk is primary unique handle-value
     1797     .
     1798   define temp-table temp-browse-handle no-undo
     1799     field browse-type   as character
     1800     field browse-number as integer
     1801     field browse-handle as handle
     1802     field original-size as decimal
     1803     index xpk is primary unique browse-type browse-number
     1804     index xie browse-type browse-handle
     1805   .
     1806   procedure diasize_change-height :
     1807     define input  parameter p-change-value  as decimal   no-undo .
     1808     define input  parameter p-move-resize   as logical   no-undo .
     1809     define variable v-field-group-handle    as handle    no-undo .
     1810     define variable v-object-handle         as handle    no-undo .
     1811     define variable v-frame-height          as decimal   no-undo .
     1812     define variable v-frame-virtual-height  as decimal   no-undo .
     1813     define variable v-browse-height         as decimal   no-undo .
     1814     define variable v-window-height         as decimal   no-undo .
     1815     define variable v-window-virtual-height as decimal   no-undo .
     1816     define variable v-change-sign           as integer   no-undo .
     1817     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1818     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1819     if p-change-value > 0
     1820     then do:
     1821       if frame Dialog-Frame :height + p-change-value
     1822           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1823       then do:
     1824         assign
     1825           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1826                           - (frame Dialog-Frame :height-chars)
     1827         .
     1828         if p-change-value <= 0
     1829         then do:
     1830           run diasize_position-resize-button in this-procedure .
     1831           return .
     1832         end.
     1833       end.
     1834     end.
     1835     if p-change-value < 0
     1836     then do:
     1837       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1838       then do:
     1839         assign
     1840           p-change-value = v-diasize-orig-frame-height
     1841                          - (frame Dialog-Frame :height-chars)
     1842         .
     1843         if p-change-value >= 0
     1844         then do:
     1845           run diasize_position-resize-button in this-procedure .
     1846           return .
     1847         end.
     1848       end.
     1849     end.
     1850     if p-change-value >= 0
     1851     then do:
     1852       assign
     1853         v-change-sign = 1
     1854       .
     1855     end.
     1856     else do:
     1857       assign
     1858         v-change-sign = -1
     1859       .
     1860     end.
     1861     assign
     1862       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1863     .
     1864     if p-change-value = 0
     1865     then do:
     1866       run diasize_position-resize-button in this-procedure .
     1867       return .
     1868     end.
     1869     move_block:
     1870     do
     1871     on error undo move_block, retry move_block
     1872     :
     1873       if retry
     1874       then do:
     1875         do
     1876         on error undo move_block, leave move_block
     1877         :
     1878           if p-change-value > 0
     1879           then do:
     1880             for each buf_temp-diasize-handle
     1881             on error undo, next
     1882             :
     1883               assign
     1884                 v-object-handle = buf_temp-diasize-handle.handle-value
     1885               .
     1886               if v-object-handle <> v-diasize-resize-button
     1887               then do:
     1888                 assign
     1889                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1890                 .
     1891               end.
     1892             end.
     1893             assign
     1894               v-diasize-browse-handle :height = v-browse-height
     1895             .
     1896             for each buf_temp-browse-handle
     1897               where buf_temp-browse-handle.browse-type = 'height':u
     1898             on error undo, next
     1899             :
     1900               assign
     1901                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1902               .
     1903             end.
     1904             assign
     1905               frame Dialog-Frame :height = v-frame-height
     1906             .
     1907             if frame Dialog-Frame :scrollable = true
     1908             then do:
     1909               assign
     1910                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1911               .
     1912             end.
     1913             run diasize_position-resize-button in this-procedure .
     1914           end.
     1915           else do:
     1916             if frame Dialog-Frame :scrollable = true
     1917             then do:
     1918               assign
     1919                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1920               .
     1921             end.
     1922             assign
     1923               frame Dialog-Frame :height = v-frame-height
     1924             .
     1925             assign
     1926               v-diasize-browse-handle :height = v-browse-height
     1927             .
     1928             for each buf_temp-browse-handle
     1929               where buf_temp-browse-handle.browse-type = 'height':u
     1930             on error undo, next
     1931             :
     1932               assign
     1933                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1934               .
     1935             end.
     1936             for each buf_temp-diasize-handle
     1937             on error undo, next
     1938             :
     1939               assign
     1940                 v-object-handle = buf_temp-diasize-handle.handle-value
     1941               .
     1942               if v-object-handle <> v-diasize-resize-button
     1943               then do:
     1944                 assign
     1945                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1946                 .
     1947               end.
     1948             end.
     1949             run diasize_position-resize-button in this-procedure .
     1950           end.
     1951           assign
     1952             v-diasize-change-size = false
     1953           .
     1954           leave move_block .
     1955         end.
     1956       end.
     1957       assign
     1958         v-diasize-need-full-display = true
     1959       .
     1960       if v-diasize-change-size = false
     1961       then do:
     1962         assign
     1963           v-diasize-change-size = true
     1964         .
     1965       end.
     1966       else do:
     1967         return .
     1968       end.
     1969       assign
     1970         v-frame-height = frame Dialog-Frame :height
     1971         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1972         v-browse-height = v-diasize-browse-handle :height
     1973       .
     1974       for each buf_temp-browse-handle
     1975         where buf_temp-browse-handle.browse-type = 'height':u
     1976       :
     1977         assign
     1978           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1979         .
     1980       end.
     1981       for each buf_temp-diasize-handle
     1982       :
     1983         delete buf_temp-diasize-handle .
     1984       end.
     1985       assign
     1986         v-field-group-handle = frame Dialog-Frame :first-child
     1987       .
     1988       do while valid-handle(v-field-group-handle)
     1989       :
     1990         assign
     1991           v-object-handle = v-field-group-handle :first-child
     1992         .
     1993         do while valid-handle(v-object-handle)
     1994         :
     1995           if  v-object-handle <> v-diasize-browse-handle :handle
     1996           and can-query(v-object-handle, "row")
     1997           and can-query(v-object-handle, "height")
     1998           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1999           then do:
     2000             find first buf_temp-browse-handle
     2001               where buf_temp-browse-handle.browse-type   = 'height':u
     2002                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2003               no-error .
     2004             if available buf_temp-browse-handle
     2005             then do:
     2006             end.
     2007             else do:
     2008               create buf_temp-diasize-handle .
     2009               assign
     2010                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2011                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2012               .
     2013             end.
     2014           end.
     2015           assign
     2016             v-object-handle = v-object-handle :next-sibling
     2017           .
     2018         end.
     2019         assign
     2020           v-field-group-handle = v-field-group-handle :next-sibling
     2021         .
     2022       end.
     2023       do with frame Dialog-Frame
     2024       :
     2025         hide v-diasize-resize-button .
     2026         assign
     2027           v-diasize-resize-button :row    = 1
     2028           v-diasize-resize-button :column = 1
     2029         .
     2030       end.
     2031       if p-change-value > 0
     2032       then do:
     2033         if frame Dialog-Frame :scrollable = true
     2034         then do:
     2035           assign
     2036             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2037             no-error .
     2038           if error-status :error
     2039           or error-status :get-message(1) <> ""
     2040           then do:
     2041             undo move_block, retry move_block .
     2042           end.
     2043         end.
     2044         assign
     2045           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2046           no-error .
     2047         if error-status :error
     2048         or error-status :get-message(1) <> ""
     2049         then do:
     2050           undo move_block, retry move_block .
     2051         end.
     2052         assign
     2053           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2054           no-error .
     2055         if error-status :error
     2056         or error-status :get-message(1) <> ""
     2057         then do:
     2058           undo move_block, retry move_block .
     2059         end.
     2060         for each buf_temp-browse-handle
     2061           where buf_temp-browse-handle.browse-type = 'height':u
     2062         on error undo move_block, retry move_block
     2063         :
     2064           assign
     2065             buf_temp-browse-handle.browse-handle :height
     2066               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2067             no-error .
     2068           if error-status :error
     2069           or error-status :get-message(1) <> ""
     2070           then do:
     2071             undo move_block, retry move_block .
     2072           end.
     2073         end.
     2074         for each buf_temp-diasize-handle
     2075         on error undo move_block, retry move_block
     2076         :
     2077           assign
     2078             v-object-handle = buf_temp-diasize-handle.handle-value
     2079           .
     2080           if v-object-handle <> v-diasize-resize-button
     2081           then do:
     2082             assign
     2083               v-object-handle :row = v-object-handle :row + p-change-value
     2084               no-error .
     2085             if error-status :error
     2086             or error-status :get-message(1) <> ""
     2087             then do:
     2088               undo move_block, retry move_block .
     2089             end.
     2090           end.
     2091         end.
     2092       end.
     2093       else do:
     2094         for each buf_temp-diasize-handle
     2095         on error undo move_block, retry move_block
     2096         :
     2097           assign
     2098             v-object-handle = buf_temp-diasize-handle.handle-value
     2099           .
     2100           if v-object-handle <> v-diasize-resize-button
     2101           then do:
     2102             assign
     2103               v-object-handle :row = v-object-handle :row + p-change-value
     2104               no-error .
     2105             if error-status :error
     2106             or error-status :get-message(1) <> ""
     2107             then do:
     2108               undo move_block, retry move_block .
     2109             end.
     2110           end.
     2111         end.
     2112         assign
     2113           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2114           no-error .
     2115         if error-status :error
     2116         or error-status :get-message(1) <> ""
     2117         then do:
     2118           undo move_block, retry move_block .
     2119         end.
     2120         for each buf_temp-browse-handle
     2121           where buf_temp-browse-handle.browse-type = 'height':u
     2122         on error undo move_block, retry move_block
     2123         :
     2124           assign
     2125             buf_temp-browse-handle.browse-handle :height
     2126               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2127             no-error .
     2128           if error-status :error
     2129           or error-status :get-message(1) <> ""
     2130           then do:
     2131             undo move_block, retry move_block .
     2132           end.
     2133         end.
     2134         assign
     2135           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2136           no-error .
     2137         if error-status :error
     2138         or error-status :get-message(1) <> ""
     2139         then do:
     2140           undo move_block, retry move_block .
     2141         end.
     2142         if frame Dialog-Frame :scrollable = true
     2143         then do:
     2144           assign
     2145             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2146             no-error .
     2147           if error-status :error
     2148           or error-status :get-message(1) <> ""
     2149           then do:
     2150             undo move_block, retry move_block .
     2151           end.
     2152         end.
     2153       end.
     2154       if p-move-resize = true
     2155       then do:
     2156         run diasize_position-resize-button in this-procedure .
     2157       end.
     2158       if v-diasize-wndstore = true
     2159       then do:
     2160         if connected("ub") = true
     2161         then do:
     2162           define variable v-cntxt-db-num        as integer   no-undo .
     2163           define variable v-cntxt-userid        as character no-undo .
     2164           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2165                                             , OUTPUT v-cntxt-userid
     2166                                             ) .
     2167           run gbl/wndsizew.p
     2168             (input  v-cntxt-db-num
     2169             ,input  v-cntxt-userid
     2170             ,input  v-diasize-proc-name
     2171             ,input  'height':u
     2172             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2173             ) .
     2174         end.
     2175       end.
     2176     end.
     2177     assign
     2178       v-diasize-change-size = false
     2179     .
     2180   end procedure.
     2181   procedure diasize_set-height :
     2182     define input  parameter p-new-height  as decimal   no-undo .
     2183     define input  parameter p-move-resize as logical   no-undo .
     2184     do
     2185     on error undo, return error return-value
     2186     :
     2187       run diasize_change-height in this-procedure
     2188         (input  (p-new-height - frame Dialog-Frame :height)
     2189         ,input  p-move-resize
     2190         ) .
     2191     end.
