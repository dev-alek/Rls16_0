        1   DEFINE BUFFER X_clients FOR ub.clients.
        2   DEFINE BUFFER X_ext-classif FOR ub.ext-classif.
        3   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        4   DEFINE INPUT PARAMETER bttns AS character NO-UNDO.
        5   DEFINE INPUT PARAMETER p-list-mode AS character NO-UNDO.
        6   DEFINE INPUT-OUTPUT PARAMETER p-rid-list AS character NO-UNDO.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Коды клиентов в системе ПАРУС".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define variable v-waitfram-action01         as character   no-undo .
       69   define variable v-waitfram-action02         as character   no-undo .
       70   define variable v-waitfram-action03         as character   no-undo .
       71   define variable mWaitFramTextBeg            as character   no-undo.
       72   define variable mWaitFramTextEnd            as character   no-undo.
       73   define variable mWaitFramView               as logical     no-undo.
       74   define variable mWaitProcEvent              as logical     no-undo init yes.
       75   define variable mWaitFramInterval           as integer     no-undo init 1 .
       76   define variable mWaitFramStop               as logical     no-undo.
       77   define variable mWaitFramStopUser           as logical     no-undo.
       78   define variable mWaitFramStopTimeOut        as logical     no-undo.
       79   define variable mWaitFramStartProc          as datetime-tz no-undo.
       80   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       81   define button B-WaitFramStop auto-end-key
       82        label "Стоп"
       83        size 10 by 1 tooltip "Остоновить процесс".
       84   define button B-viewProcInfo
       85        label "Информация"
       86        size 15 by 1 tooltip "Информация о процесс".
       87   define frame waitfram
       88     v-waitfram-action01 format "x(72)" no-label skip
       89     v-waitfram-action02 format "x(72)" no-label skip
       90     v-waitfram-action03 format "x(72)" no-label skip
       91     B-viewProcInfo
       92     B-WaitFramStop at row 4 col 30
       93     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       94     .
       95   define new global shared variable mBatchMode as logical no-undo init ?.
       96   define variable mFramBachModHandle as handle no-undo.
       97   mFramBachModHandle = frame waitfram:handle.
       98   define variable mFameOldVis as logical no-undo.
       99   define variable mVisCUrentVin as logical no-undo.
      100   if session:batch-mode
      101   then
      102      mBatchMode = yes.
      103   if mBatchMode = ? then do:
      104     mVisCUrentVin = current-window:visible.
      105     mFameOldVis = mFramBachModHandle:visible.
      106     mFramBachModHandle:visible  = yes.
      107     mBatchMode = mFramBachModHandle:visible ne yes.
      108     mFramBachModHandle:visible = mFameOldVis.
      109     current-window:visible = mVisCUrentVin.
      110   end.
      111    if  log-manager:logfile-name ne ?
      112     then DO:
      113         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      114         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      115         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      116     end.
      117   on choose of B-WaitFramStop in frame waitfram
      118   do:
      119     mWaitFramStop = yes.
      120     mWaitFramStopUser = yes.
      121   end.
      122   function waitfram-check-timeout returns logical():
      123      define variable vtime as int64 no-undo.
      124      if mWaitFramStopTimeOut
      125      then
      126         return yes.
      127      vtime = ( now - mWaitFramStartProc ) / 1000 .
      128      if     mWaitFramTimeOut ne ?
      129         and mWaitFramTimeOut ne 0
      130         and mWaitFramTimeOut lt vtime
      131      then do:
      132         mWaitFramStopTimeOut = yes.
      133      end.
      134      return mWaitFramStopTimeOut.
      135   end.
      136   procedure waitfram-hide :
      137     if not session:batch-mode
      138     then do
      139     on error undo, return error return-value
      140     :
      141       pause 0 before-hide .
      142       if not mBatchMode then
      143         hide frame waitfram .
      144     if     not mWaitFramView
      145        and mWaitProcEvent
      146     then
      147       process events .
      148     end.
      149   end procedure.
      150   procedure waitfram-show :
      151     define input  parameter p-message as character no-undo .
      152     define variable v-left-margin as integer   no-undo .
      153     if not session:batch-mode
      154     then do
      155     on error undo, return error return-value
      156     :
      157       if length(p-message) <= 70 then do:
      158         assign
      159           v-left-margin = integer((70 - length(p-message)) / 2)
      160         .
      161         assign
      162           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      163         .
      164         assign
      165           v-waitfram-action01 = " "
      166           v-waitfram-action02 = " "
      167                                    + fill(" ", v-left-margin)
      168                                    + p-message
      169           v-waitfram-action03 = " "
      170         .
      171       end.
      172       else do:
      173         define variable vRindex1 as integer no-undo.
      174         define variable vRindex2 as integer no-undo.
      175         vRindex1 = r-index(p-message," ",70).
      176         if vRindex1 = 0
      177         then
      178            vRindex1 = 70.
      179         if length(p-message)  <= vRindex1 + 70 then do:
      180           assign
      181             v-waitfram-action01 = " "
      182             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      183             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      184           .
      185         end.
      186         else do:
      187           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      188           if vRindex2 <= vRindex1
      189           then
      190              vRindex2 = vRindex1 + 70.
      191           assign
      192             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      193             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      194             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      195           .
      196         end.
      197       end.
      198       B-viewProcInfo:visible   in frame waitfram = no.
      199       B-viewProcInfo:sensitive in frame waitfram = no.
      200       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      201       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      202       if  (   mWaitFramView
      203          or  mWaitProcEvent)
      204          and not mBatchMode
      205       then
      206          display
      207             v-waitfram-action01 skip
      208             v-waitfram-action02 skip
      209             v-waitfram-action03 skip
      210          with frame waitfram .
      211       if     mWaitFramView
      212          then do:
      213             if     mWaitFramInterval ne ?
      214                and not mBatchMode
      215             then
      216                wait-for go of frame waitfram pause mWaitFramInterval.
      217          end.
      218          else
      219             if     mWaitProcEvent
      220                and not mBatchMode
      221             then
      222                process events .
      223     end.
      224   end procedure.
      225      procedure waitfram-show-this:
      226         define input  parameter iInterval as int64 no-undo.
      227         define variable vtime as int64 no-undo.
      228         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      229         mWaitFramInterval = iInterval.
      230         run waitfram-show (substitute("&1&2 &3&4" ,
      231                                       mWaitFramTextBeg ,
      232                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      233                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      234                                       mWaitFramTextEnd
      235                                      )
      236                           ).
      237      end.
      238      procedure WaitFramRunPause:
      239         define input  parameter iInterval as dec no-undo.
      240         define variable vStart  as datetime-tz no-undo.
      241         define variable vend    as datetime-tz no-undo.
      242         define variable vint as int64 no-undo.
      243         define variable vOk as logical no-undo.
      244         vStart = now.
      245         vend   = vStart.
      246         publish "WaitFramPause" (iInterval,output vOk).
      247         vend   =  now.
      248         vint = vend - vStart.
      249         vint = iInterval - vint / 1000.
      250         if     not mWaitFramStop
      251            and (   vint > 0
      252                 or (    not vOk
      253                     and iInterval eq ?
      254                     )
      255                 )
      256         then
      257            run waitfram-show-this (iInterval).
      258         vend   =  now.
      259         vint = vend - vStart.
      260         vint = iInterval - vint / 1000.
      261         if     not mWaitFramStop
      262            and vint > 0
      263         then do:
      264            run gbl/pause.p (vint * 1000).
      265         end.
      266         if iInterval ne ?
      267         then
      268            publish "WaitFramStop".
      269         waitfram-check-timeout().
      270      end.
      271      procedure WaitFramWaitFor:
      272         define input  parameter iInterval as dec no-undo.
      273         assign
      274            mWaitFramStartProc   = now
      275            mWaitFramStopUser    = no
      276            mWaitFramStopTimeOut = no
      277         .
      278         block-wait:
      279         do while not mWaitFramStop:
      280            run WaitFramRunPause (iInterval).
      281            if  waitfram-check-timeout()
      282            then do:
      283               leave block-wait.
      284            end.
      285         end.
      286         run waitfram-hide.
      287      end.
      288   procedure waitfram-join :
      289     define input  parameter p-line-1  as character no-undo .
      290     define input  parameter p-line-2  as character no-undo .
      291     define input  parameter p-line-3  as character no-undo .
      292     define output parameter p-message as character no-undo .
      293     do
      294     on error undo, return error return-value
      295     :
      296       assign
      297         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      298                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      299                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      300       .
      301     end.
      302   end procedure.
      303   function waitfram-join-function returns character
      304     (input p-line-1 as character
      305     ,input p-line-2 as character
      306     ,input p-line-3 as character
      307     ).
      308     define variable v-message as character no-undo .
      309     run waitfram-join in this-procedure
      310       (input  p-line-1
      311       ,input  p-line-2
      312       ,input  p-line-3
      313       ,output v-message
      314       ) .
      315     return v-message .
      316   end function .
      317   define new global shared variable g#language as character no-undo .
      318   if g#language <> '' and g#language <> 'rus':U then do:
      319     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      320   end.
      321   procedure proc-alt-shift-f2:
      322     if not ibs.th.gbl.gbl-var:rcode
      323   then
      324     run gbl\inidebug.p .
      325   end.
      326   procedure proc-alt-shift-f3:
      327     run gbl/prvssinf.p
      328       ( input this-procedure
      329       ) .
      330   end.
      331   define variable v-inform-launched as logical no-undo initial false .
      332   procedure proc-alt-shift-f4:
      333     define variable v-action as character no-undo .
      334     if v-inform-launched = false then do:
      335       assign
      336         v-inform-launched = true
      337       .
      338       run gbl/d-inform.w
      339         (  input self
      340         ,  input this-procedure
      341         , output v-action
      342         ) no-error .
      343       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      344       assign
      345         v-inform-launched = false
      346       .
      347     end.
      348   end.
      349   procedure proc-alt-f1:
      350     run gbl/corrhelp.p
      351       (input this-procedure
      352       ) .
      353   end .
      354   on alt-shift-f2 anywhere do:
      355     run proc-alt-shift-f2.
      356   end.
      357   on alt-shift-f3 anywhere do:
      358     run proc-alt-shift-f3 in this-procedure .
      359   end.
      360   on alt-shift-f4 anywhere do:
      361     run proc-alt-shift-f4 in this-procedure.
      362   end.
      363   on alt-f1 anywhere do:
      364     run proc-alt-f1 in this-procedure .
      365   end.
      366   define new global shared variable g#library  as handle no-undo .
      367   define new global shared variable g#library2 as handle no-undo .
      368   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369     define variable v-cntxt-db-num        as integer   no-undo .
      370     define variable v-cntxt-userid        as character no-undo .
      371     define variable v-cntxt-level         as character no-undo .
      372     define variable v-cntxt-host-code-obj as integer   no-undo .
      373     define variable v-cntxt-obj-type      as character no-undo .
      374     define variable v-cntxt-obj-code      as integer   no-undo .
      375     define variable v-cntxt-db-num-obj    as integer   no-undo .
      376     define variable v-cntxt-is-admin      as logical   no-undo .
      377   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      378   procedure gen-key-rec :
      379     define input  parameter p-tbl-name    as character no-undo.
      380     define input  parameter p-bh_tbl-name as handle    no-undo.
      381     define output parameter p-key-rec     as character no-undo.
      382     do
      383     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      384     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      385     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      386     :
      387       define variable fh               as handle    no-undo .
      388       define variable v-ok             as logical   no-undo .
      389       define variable v-inform         as character no-undo .
      390       define variable v-ind            as integer   no-undo .
      391       define variable v-idx-field-qnty as integer   no-undo .
      392       if p-tbl-name = ?
      393         or p-tbl-name = "":U
      394       then do:
      395         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info2 ).
      396       end.
      397       if not p-bh_tbl-name:available then do:
      398         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      399       end.
      400       assign
      401         p-key-rec = p-tbl-name
      402         v-inform  = p-bh_tbl-name:index-information(1)
      403         v-ind     = 2
      404       .
      405       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      406       on error undo, return error
      407       :
      408         assign
      409           v-inform = p-bh_tbl-name:index-information( v-ind )
      410           v-ind    = v-ind + 1
      411         .
      412       end.
      413       if v-inform = ?
      414         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      415         or entry( 3, v-inform, ",":U ) <> "1":U
      416       then do:
      417         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, p-tbl-name ).
      418       end.
      419       else do:
      420         assign
      421           v-idx-field-qnty = num-entries( v-inform ) - 4
      422         .
      423         if v-idx-field-qnty < 2 then do:
      424           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, p-tbl-name ).
      425         end.
      426         do v-ind = 1 to v-idx-field-qnty by 2
      427         on error undo, return error
      428         :
      429           assign
      430             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      431             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      432           .
      433         end.
      434       end.
      435       if p-key-rec = ? then do:
      436         assign
      437           p-key-rec = "":U
      438         .
      439         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info2, p-tbl-name ).
      440       end.
      441     end.
      442     return.
      443   end procedure.
      444   procedure gen-where-keyr-tab :
      445     define input  parameter i-tableSerach as character no-undo.
      446     define input  parameter i-tablekey   as character  no-undo.
      447     define input  parameter p-key-rec    as character  no-undo.
      448     define input  parameter p-key-handle as handle     no-undo .
      449     define input  parameter p-db-name    as character  no-undo .
      450     define input  parameter p-tt-handle  as handle     no-undo .
      451     define output parameter o-Where      as character  no-undo.
      452     do
      453     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      454     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      455     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      456     :
      457       define variable v-full-tbl-name  as character no-undo .
      458       define variable bh_tbl-name      as handle    no-undo .
      459       define variable fh_key           as handle    no-undo .
      460       define variable fh_search        as handle    no-undo .
      461       define variable v-field-num      as integer   no-undo .
      462       define variable v-count-fld      as integer   no-undo .
      463       define variable v-inform         as character no-undo .
      464       define variable v-ind            as integer   no-undo .
      465       define variable v-idx-field-qnty as integer   no-undo .
      466       define variable v-field-name     as character no-undo .
      467       define variable v-field-val      as character no-undo .
      468       define variable v-word-link      as character no-undo .
      469       define variable vTable           as character no-undo.
      470       define variable bh_tbl-key       as handle    no-undo .
      471       assign
      472         p-key-rec = trim( p-key-rec )
      473       .
      474       if p-key-handle <> ? then do:
      475         if not valid-handle(p-key-handle)
      476            or p-key-handle:type <> "buffer"
      477         then do:
      478           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info2 ).
      479         end.
      480         if num-entries( p-key-rec, chr(3) ) > 1
      481           or p-key-rec = ?
      482           or p-key-rec = "":U
      483         then do:
      484           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info2, p-key-rec ).
      485         end.
      486       end.
      487       else do:
      488         if p-key-rec = ?
      489           or p-key-rec = "":U
      490         then do:
      491           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      492         end.
      493       end.
      494       assign
      495         vTable = entry( 1 , p-key-rec, chr(3) )
      496       .
      497       if p-tt-handle <> ?
      498         and ( not valid-handle(p-tt-handle)
      499               or p-tt-handle:type <> "buffer"
      500             )
      501       then do:
      502         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info2, vTable, chr(10) ).
      503       end.
      504       if p-tt-handle = ? then do:
      505         assign
      506           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      507         .
      508         create buffer bh_tbl-name for table v-full-tbl-name .
      509       end.
      510       else do:
      511         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      512       end.
      513       assign
      514         v-inform = bh_tbl-name:index-information(1)
      515         v-ind    = 2
      516       .
      517       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      518       on error undo, return error
      519       :
      520         assign
      521           v-inform = bh_tbl-name:index-information( v-ind )
      522           v-ind    = v-ind + 1
      523         .
      524       end.
      525       if v-inform = ?
      526         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      527         or entry( 3, v-inform, ",":U ) <> "1":U
      528       then do:
      529         delete object bh_tbl-name no-error.
      530         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info2, vTable ).
      531       end.
      532       assign
      533         v-idx-field-qnty = num-entries( v-inform ) - 4
      534       .
      535       if v-idx-field-qnty < 2 then do:
      536         delete object bh_tbl-name no-error.
      537         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, vTable ).
      538       end.
      539       assign
      540         o-where     = "where":U
      541         v-word-link = "":U
      542         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      543         v-count-fld = 0
      544       .
      545       if i-tablekey ne "" and i-tablekey ne ?
      546       then do:
      547         assign
      548           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      549         .
      550         create buffer bh_tbl-key for table v-full-tbl-name .
      551       end.
      552       if i-tableSerach ne "" and i-tableSerach ne ?
      553       then do:
      554         delete object bh_tbl-name no-error.
      555         assign
      556           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      557         .
      558         create buffer bh_tbl-name for table v-full-tbl-name .
      559       end.
      560       block_where:
      561       do v-ind = 1 to v-idx-field-qnty by 2
      562       on error undo, return error
      563       :
      564         assign
      565           v-count-fld = v-count-fld + 1
      566         .
      567         if p-key-handle = ?
      568           and v-count-fld > v-field-num
      569         then do:
      570           leave block_where.
      571         end.
      572         define variable VfieldKeyTable as handle no-undo.
      573         assign
      574           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      575           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      576         .
      577         if     bh_tbl-key ne ?
      578         then do:
      579            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      580            if VfieldKeyTable eq ?
      581            then next block_where.
      582         end.
      583         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      584         then
      585            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      586         else
      587            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      588         if p-key-handle = ? then do:
      589           assign
      590             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      591           .
      592         end.
      593         else do:
      594           assign
      595             fh_key = p-key-handle:buffer-field( v-field-name )
      596           .
      597           if fh_key = ?
      598             or not valid-handle( fh_key )
      599           then do:
      600             delete object bh_tbl-name.
      601             if     bh_tbl-key ne ?
      602             then
      603                delete object bh_tbl-key.
      604             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info2, p-key-handle:name, v-field-name ).
      605           end.
      606           assign
      607             v-field-val = fh_key:buffer-value
      608           .
      609         end.
      610         if fh_search:data-type ="character":U then do:
      611           assign
      612             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      613             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      614             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      615             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      616             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      617             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      618             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      619             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      620             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      621             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      622             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      623             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      624             v-field-val = substitute( '"&1"', v-field-val )
      625           .
      626         end.
      627         assign
      628           o-where = substitute( "&1 &2", o-where, v-field-val )
      629         .
      630         if v-word-link = "":U then do:
      631           assign
      632             v-word-link = "and":U
      633           .
      634         end.
      635       end.
      636       delete object bh_tbl-name.
      637       if     bh_tbl-key ne ?
      638       then
      639          delete object bh_tbl-key.
      640       if p-key-handle = ?
      641         and v-count-fld <> v-field-num
      642       then do:
      643         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info2, vTable ).
      644       end.
      645     end.
      646   end procedure.
      647   procedure gen-hn-keyr-tab :
      648     define input  parameter i-tableSerach as character no-undo.
      649     define input  parameter i-tablekey   as character no-undo.
      650     define input  parameter p-key-rec    as character no-undo.
      651     define input  parameter p-key-handle as handle    no-undo .
      652     define input  parameter p-db-name    as character no-undo .
      653     define input  parameter p-tt-handle  as handle    no-undo .
      654     define input  parameter p-stts-lock  as integer   no-undo .
      655     define output parameter o-hn         as handle    no-undo.
      656     define variable v-full-tbl-name as character no-undo.
      657     define variable v-where         as character no-undo.
      658     define variable bh_tbl-name     as handle    no-undo.
      659     define variable vTable          as character no-undo.
      660     do
      661     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      662     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      663     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      664         run gen-where-keyr-tab(i-tableSerach,
      665                                i-tablekey,
      666                                p-key-rec,
      667                                p-key-handle,
      668                                p-db-name,
      669                                p-tt-handle,
      670                                output v-where).
      671         if i-tableSerach ne "" and i-tableSerach ne ?
      672         then do:
      673            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      674            create buffer bh_tbl-name for table v-full-tbl-name .
      675         end.
      676         else do:
      677            if p-tt-handle = ? then do:
      678               assign
      679                  vTable = entry( 1 , p-key-rec, chr(3) )
      680               .
      681               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      682               create buffer bh_tbl-name for table v-full-tbl-name .
      683            end.
      684            else do:
      685               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      686            end.
      687         end.
      688         if p-tt-handle = ? then do:
      689            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      690         end.
      691         else do:
      692            bh_tbl-name:find-first( v-where ) no-error .
      693         end.
      694         o-hn = bh_tbl-name.
      695      end.
      696   end procedure.
      697   procedure gen-hn-keyr :
      698     define input  parameter p-key-rec    as character no-undo.
      699     define input  parameter p-key-handle as handle    no-undo .
      700     define input  parameter p-db-name    as character no-undo .
      701     define input  parameter p-tt-handle  as handle    no-undo .
      702     define input  parameter p-stts-lock  as integer   no-undo .
      703     define output parameter o-hn         as handle    no-undo.
      704     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      705   end.
      706   procedure gen-row-keyr :
      707     define input  parameter p-key-rec    as character no-undo.
      708     define input  parameter p-key-handle as handle    no-undo .
      709     define input  parameter p-db-name    as character no-undo .
      710     define input  parameter p-tt-handle  as handle    no-undo .
      711     define input  parameter p-stts-lock  as integer   no-undo .
      712     define output parameter p-tbl-row    as rowid     no-undo.
      713     define output parameter p-tbl-name   as character no-undo.
      714     define variable vHn as handle no-undo.
      715       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      716       p-tbl-row = if vHn:available then vHn:rowid else ?.
      717       p-tbl-name =  vHn:table.
      718       delete object vHn no-error.
      719     if p-tbl-row = ? then do:
      720       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info2, p-tbl-name, p-key-rec ).
      721     end.
      722     else do:
      723       return.
      724     end.
      725   end procedure.
      726   procedure gen-key-fv :
      727     define input  parameter p-key-rec    as character no-undo .
      728     define output parameter p-field-list as character no-undo .
      729     define output parameter p-value-list as character no-undo.
      730     do
      731     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      732     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      733     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      734     :
      735       define variable v-full-tbl-name  as character no-undo .
      736       define variable bh_tbl-name      as handle    no-undo .
      737       define variable v-tbl-name       as character no-undo .
      738       define variable v-field-num      as integer   no-undo .
      739       define variable v-count-fld      as integer   no-undo .
      740       define variable v-inform         as character no-undo .
      741       define variable v-ind            as integer   no-undo .
      742       define variable v-idx-field-qnty as integer   no-undo .
      743       define variable v-delim-key      as character no-undo .
      744       if p-key-rec = ?
      745         or p-key-rec = "":U
      746       then do:
      747         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      748       end.
      749       assign
      750         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      751         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      752       .
      753       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      754       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info2 ).
      755       assign
      756         v-inform = bh_tbl-name:index-information(1)
      757         v-ind    = 2
      758       .
      759       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      760       on error undo, return error
      761       :
      762         assign
      763           v-inform = bh_tbl-name:index-information( v-ind )
      764           v-ind    = v-ind + 1
      765         .
      766       end.
      767       if v-inform = ?
      768         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      769         or entry( 3, v-inform, ",":U ) <> "1":U
      770       then do:
      771         delete object bh_tbl-name no-error.
      772         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      773       end.
      774       assign
      775         v-idx-field-qnty = num-entries( v-inform ) - 4
      776       .
      777       if v-idx-field-qnty < 2 then do:
      778         delete object bh_tbl-name no-error.
      779         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      780       end.
      781       assign
      782         p-field-list = "":U
      783         p-value-list = "":U
      784         v-delim-key  = "":U
      785         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      786         v-count-fld  = 0
      787       .
      788       block_where:
      789       do v-ind = 1 to v-idx-field-qnty by 2
      790       on error undo, return error
      791       :
      792         assign
      793           v-count-fld = v-count-fld + 1
      794         .
      795         if v-count-fld > v-field-num then do:
      796           leave block_where.
      797         end.
      798         assign
      799           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      800           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      801         .
      802         if v-ind = 1 then do:
      803           assign
      804             v-delim-key = chr(3)
      805           .
      806         end.
      807       end.
      808       delete object bh_tbl-name.
      809       if v-count-fld <> v-field-num then do:
      810         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
      811       end.
      812     end.
      813   end procedure.
      814   procedure gen-key-field :
      815     define input  parameter p-table      as character no-undo .
      816     define output parameter p-field-list as character no-undo .
      817     do
      818     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      819     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      820     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      821     :
      822       define variable v-full-tbl-name  as character no-undo .
      823       define variable bh_tbl-name      as handle    no-undo .
      824       define variable v-tbl-name       as character no-undo .
      825       define variable v-field-num      as integer   no-undo .
      826       define variable v-count-fld      as integer   no-undo .
      827       define variable v-inform         as character no-undo .
      828       define variable v-ind            as integer   no-undo .
      829       define variable v-idx-field-qnty as integer   no-undo .
      830       define variable v-delim-key      as character no-undo .
      831       if p-table = ?
      832         or p-table = "":U
      833       then do:
      834         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info2 ).
      835       end.
      836       assign
      837         v-tbl-name      = p-table
      838         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      839       .
      840       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      841       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info2 ).
      842       assign
      843         v-inform = bh_tbl-name:index-information(1)
      844         v-ind    = 2
      845       .
      846       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      847       on error undo, return error
      848       :
      849         assign
      850           v-inform = bh_tbl-name:index-information( v-ind )
      851           v-ind    = v-ind + 1
      852         .
      853       end.
      854       if v-inform = ?
      855         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      856         or entry( 3, v-inform, ",":U ) <> "1":U
      857       then do:
      858         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      859       end.
      860       assign
      861         v-idx-field-qnty = num-entries( v-inform ) - 4
      862       .
      863       if v-idx-field-qnty < 2 then do:
      864         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      865       end.
      866       assign
      867         p-field-list = "":U
      868         v-delim-key  = "":U
      869         v-count-fld  = 0
      870       .
      871       block_where:
      872       do v-ind = 1 to v-idx-field-qnty by 2
      873       on error undo, return error
      874       :
      875         assign
      876           v-count-fld = v-count-fld + 1
      877         .
      878         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      879         if v-ind = 1 then do:
      880           assign
      881             v-delim-key = chr(3)
      882           .
      883         end.
      884       end.
      885       delete object bh_tbl-name.
      886     end.
      887   end procedure.
      888   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      889   define variable c-point  as character no-undo .
      890   define variable tbl      as character no-undo .
      891   define variable join-tbl as character no-undo .
      892   define variable fld      as character no-undo .
      893   define variable lab      as character no-undo .
      894   define variable spr      as character no-undo .
      895   define variable dim      as character no-undo .
      896   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      897   procedure fltfield-clear :
      898     define output parameter loc-fld as character no-undo.
      899     define output parameter loc-lab as character no-undo .
      900     define output parameter loc-spr as character no-undo .
      901     define output parameter loc-dim as character no-undo .
      902     assign
      903       loc-fld = ""
      904       loc-lab = ""
      905       loc-spr = ""
      906       loc-dim = "0"
      907     .
      908   end procedure .
      909   procedure fltfield-add :
      910     define input        parameter par-fld as character no-undo.
      911     define input        parameter par-lab as character no-undo .
      912     define input        parameter par-spr as character no-undo .
      913     define input-output parameter loc-fld as character no-undo.
      914     define input-output parameter loc-lab as character no-undo .
      915     define input-output parameter loc-spr as character no-undo .
      916     define input-output parameter loc-dim as character no-undo .
      917     do
      918     on error undo, return error
      919     :
      920       assign
      921       loc-fld = if loc-dim = '0'
      922                 then par-fld
      923                 else (loc-fld + chr(44) + par-fld)
      924       loc-lab = if loc-dim = '0'
      925                 then par-lab
      926                 else (loc-lab + chr(44) + par-lab)
      927       loc-spr = if loc-dim = '0'
      928                 then par-spr
      929                 else (loc-spr + chr(44) + par-spr)
      930       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      931                 string(integer(if num-entries(loc-dim) > 1
      932                               then entry(2, loc-dim)
      933                               else entry(1, loc-dim)
      934                               ) + 1)
      935       no-error
      936       .
      937     end.
      938   end procedure.
      939   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      940   FUNCTION mark-string RETURNS CHARACTER
      941     ( input p-recid as recid, input mark-list as character  ) :
      942     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      943   END FUNCTION.
      944   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      945   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      946   procedure cur-time :
      947      define output parameter p-today as date      no-undo .
      948      define output parameter p-time  as integer   no-undo .
      949     do
      950     on error undo, return error
      951     :
      952       define variable v-date1 as date      no-undo .
      953       define variable v-date2 as date      no-undo .
      954       define variable v-time  as integer   no-undo .
      955       assign
      956         v-date1 = today
      957         v-time  = time
      958         v-date2 = today
      959       .
      960       if v-date1 <> v-date2
      961       then do:
      962         assign
      963           v-date1 = today
      964           v-time  = v-time
      965         .
      966       end.
      967       assign
      968         p-today = v-date1
      969         p-time  = v-time
      970       .
      971     end.
      972   end.
      973   function cur-time-date returns character
      974   :
      975     return string(today, '99/99/9999':U) .
      976   end.
      977   function cur-time-mjd returns decimal
      978   :
      979     define variable v-date as date      no-undo .
      980     define variable v-time as integer   no-undo .
      981     run cur-time in this-procedure
      982       (output v-date
      983       ,output v-time
      984       ) .
      985     return integer(v-date) - 2400002 + (v-time / 86400) .
      986   end.
      987   function cur-time-get-ending-index returns integer
      988   (input p-number as integer
      989   )
      990   :
      991     if p-number < 0
      992     or p-number = ?
      993     then do:
      994       return 1 .
      995     end.
      996     define variable v-rest as integer   no-undo .
      997     assign
      998       p-number = p-number modulo 100
      999     .
     1000     if p-number < 20
     1001     then do:
     1002       assign
     1003         v-rest = p-number
     1004       .
     1005     end.
     1006     else do:
     1007       assign
     1008         v-rest = p-number modulo 10
     1009       .
     1010     end.
     1011     case v-rest :
     1012       when 1
     1013       then do:
     1014         return 2 .
     1015       end.
     1016       when 2 or
     1017       when 3 or
     1018       when 4
     1019       then do:
     1020         return 3 .
     1021       end.
     1022       otherwise do:
     1023         return 1 .
     1024       end.
     1025     end case .
     1026   end.
     1027   procedure cur-time-mjd-to-date :
     1028      define input  parameter i-mjd-diff as decimal no-undo.
     1029      define output parameter o-Date     as date    no-undo.
     1030      define output parameter o-Time     as integer no-undo.
     1031      define variable v-day-number as integer   no-undo .
     1032      if    i-mjd-diff < 0
     1033         or i-mjd-diff = ?
     1034      then do:
     1035         return "?" .
     1036      end.
     1037      assign
     1038         v-day-number = truncate(i-mjd-diff,0).
     1039         o-Date = date(v-day-number + 2400002).
     1040         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1041     .
     1042   end.
     1043   function cur-time-mjd-to-string returns character
     1044   (input p-mjd-diff as decimal
     1045   )
     1046   :
     1047     define variable v-day-number as integer   no-undo .
     1048     define variable v-seconds    as integer   no-undo .
     1049     define variable v-hour       as integer   no-undo .
     1050     define variable v-min        as integer   no-undo .
     1051     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1052     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1053     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1054     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1055     if p-mjd-diff < 0
     1056     or p-mjd-diff = ?
     1057     then do:
     1058       return "?" .
     1059     end.
     1060     assign
     1061       v-day-number = integer(truncate(p-mjd-diff,0))
     1062       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1063     .
     1064     if v-seconds > 86400
     1065     then do:
     1066       assign
     1067         v-seconds = 86400 - 1
     1068       .
     1069     end.
     1070     if v-seconds < 0
     1071     then do:
     1072       assign
     1073         v-seconds = 0
     1074       .
     1075     end.
     1076     assign
     1077       v-hour = truncate(v-seconds / 3600, 0)
     1078     .
     1079     assign
     1080       v-seconds = v-seconds modulo 3600
     1081     .
     1082     assign
     1083       v-min = truncate(v-seconds / 60, 0)
     1084     .
     1085     assign
     1086       v-seconds = v-seconds modulo 60
     1087     .
     1088     return
     1089         (if v-day-number <> 0
     1090           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1091           else ""
     1092         )
     1093       + (if v-day-number <> 0 or v-hour <> 0
     1094           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1095           else ""
     1096         )
     1097       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1098           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1099           else ""
     1100         )
     1101       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1102       .
     1103   end.
     1104   function cur-time-string returns character
     1105   :
     1106     define variable v-date as date      no-undo .
     1107     define variable v-time as integer   no-undo .
     1108     run cur-time in this-procedure
     1109       (output v-date
     1110       ,output v-time
     1111       ) .
     1112     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1113   end.
     1114   function cur-time-string-sec returns character
     1115   :
     1116     define variable v-date as date      no-undo .
     1117     define variable v-time as integer   no-undo .
     1118     run cur-time in this-procedure
     1119       (output v-date
     1120       ,output v-time
     1121       ) .
     1122     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1123   end.
     1124   function cur-time-custom  returns character
     1125   (input p-prefix as character
     1126   ,input p-date-format as character
     1127   ,input p-delimiter as character
     1128   ,input p-time-format as character
     1129   ,input p-suffix as character
     1130   )
     1131   :
     1132     define variable v-date as date      no-undo .
     1133     define variable v-time as integer   no-undo .
     1134     run cur-time in this-procedure
     1135       (output v-date
     1136       ,output v-time
     1137       ) .
     1138     return
     1139       p-prefix
     1140       + string(v-date, p-date-format)
     1141       + p-delimiter
     1142       + string(v-time, p-time-format)
     1143       + p-suffix
     1144       .
     1145   end.
     1146   function cur-time-print  returns character
     1147   :
     1148     define variable v-date as date      no-undo .
     1149     define variable v-time as integer   no-undo .
     1150     run cur-time in this-procedure
     1151       (output v-date
     1152       ,output v-time
     1153       ) .
     1154     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1155   end.
     1156   function cur-time-datetime returns datetime
     1157   :
     1158     define variable v-char as character no-undo .
     1159     define variable v-datetime as datetime no-undo .
     1160     v-char = cur-time-string().
     1161     v-datetime = datetime(v-char).
     1162     return  v-datetime.
     1163   end.
     1164   function cur-time-string-msec returns character
     1165   :
     1166     define variable v-date as datetime  no-undo .
     1167     v-date = now.
     1168     return string(v-date) .
     1169   end.
     1170   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
