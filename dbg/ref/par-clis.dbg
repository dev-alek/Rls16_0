     2193   procedure diasize_change-width :
     2194     define input  parameter p-change-value as decimal   no-undo .
     2195     define input  parameter p-move-resize  as logical   no-undo .
     2196     define variable v-field-group-handle   as handle    no-undo .
     2197     define variable v-object-handle        as handle    no-undo .
     2198     define variable v-frame-width          as decimal   no-undo .
     2199     define variable v-frame-virtual-width  as decimal   no-undo .
     2200     define variable v-browse-width         as decimal   no-undo .
     2201     define variable v-window-width         as decimal   no-undo .
     2202     define variable v-window-virtual-width as decimal   no-undo .
     2203     define variable v-change-sign          as integer   no-undo .
     2204     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2205     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2206     if p-change-value > 0
     2207     then do:
     2208       if frame Dialog-Frame :width + p-change-value >
     2209           session :width-chars
     2210       then do:
     2211         assign
     2212           p-change-value = session :width-chars - frame Dialog-Frame :width
     2213         .
     2214         if p-change-value <= 0
     2215         then do:
     2216           run diasize_position-resize-button in this-procedure .
     2217           return .
     2218         end.
     2219       end.
     2220     end.
     2221     if p-change-value < 0
     2222     then do:
     2223       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2224       then do:
     2225         assign
     2226           p-change-value = v-diasize-orig-frame-width
     2227                          - frame Dialog-Frame :width
     2228         .
     2229         if p-change-value >= 0
     2230         then do:
     2231           run diasize_position-resize-button in this-procedure .
     2232           return .
     2233         end.
     2234       end.
     2235     end.
     2236     if p-change-value >= 0
     2237     then do:
     2238       assign
     2239         v-change-sign = 1
     2240       .
     2241     end.
     2242     else do:
     2243       assign
     2244         v-change-sign = -1
     2245       .
     2246     end.
     2247     assign
     2248       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2249     .
     2250     if p-change-value = 0
     2251     then do:
     2252       run diasize_position-resize-button in this-procedure .
     2253       return .
     2254     end.
     2255     move_block:
     2256     do
     2257     on error undo move_block, leave move_block
     2258     :
     2259       if retry
     2260       then do:
     2261         do
     2262         on error undo move_block, leave move_block
     2263         :
     2264           if p-change-value > 0
     2265           then do:
     2266             for each buf_temp-diasize-handle
     2267             on error undo, next
     2268             :
     2269               assign
     2270                 v-object-handle = buf_temp-diasize-handle.handle-value
     2271               .
     2272               if v-object-handle <> v-diasize-resize-button
     2273               then do:
     2274                 assign
     2275                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2276                 .
     2277               end.
     2278             end.
     2279             assign
     2280               v-diasize-browse-handle :width = v-browse-width
     2281             .
     2282             for each buf_temp-browse-handle
     2283               where buf_temp-browse-handle.browse-type = 'width':u
     2284             on error undo, next
     2285             :
     2286               assign
     2287                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2288               .
     2289             end.
     2290             assign
     2291               frame Dialog-Frame :width = v-frame-width
     2292             .
     2293             if frame Dialog-Frame :scrollable = true
     2294             then do:
     2295               assign
     2296                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2297               .
     2298             end.
     2299             run diasize_position-resize-button in this-procedure .
     2300           end.
     2301           else do:
     2302             if frame Dialog-Frame :scrollable = true
     2303             then do:
     2304               assign
     2305                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2306               .
     2307             end.
     2308             assign
     2309               frame Dialog-Frame :width = v-frame-width
     2310             .
     2311             for each buf_temp-browse-handle
     2312               where buf_temp-browse-handle.browse-type = 'width':u
     2313             on error undo, next
     2314             :
     2315               assign
     2316                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2317               .
     2318             end.
     2319             assign
     2320               v-diasize-browse-handle :width = v-browse-width
     2321             .
     2322             for each buf_temp-diasize-handle
     2323             on error undo, next
     2324             :
     2325               assign
     2326                 v-object-handle = buf_temp-diasize-handle.handle-value
     2327               .
     2328               if v-object-handle <> v-diasize-resize-button
     2329               then do:
     2330                 assign
     2331                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2332                 .
     2333               end.
     2334             end.
     2335             run diasize_position-resize-button in this-procedure .
     2336           end.
     2337           assign
     2338             v-diasize-change-size = false
     2339           .
     2340           leave move_block .
     2341         end.
     2342       end.
     2343       assign
     2344         v-diasize-need-full-display = true
     2345       .
     2346       if v-diasize-change-size = false
     2347       then do:
     2348         assign
     2349           v-diasize-change-size = true
     2350         .
     2351       end.
     2352       else do:
     2353         return .
     2354       end.
     2355       assign
     2356         v-frame-width = frame Dialog-Frame :width
     2357         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2358         v-browse-width = v-diasize-browse-handle :width
     2359       .
     2360       for each buf_temp-browse-handle
     2361         where buf_temp-browse-handle.browse-type = 'width':u
     2362       :
     2363         assign
     2364           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2365         .
     2366       end.
     2367       for each buf_temp-diasize-handle
     2368       :
     2369         delete buf_temp-diasize-handle .
     2370       end.
     2371       assign
     2372         v-field-group-handle = frame Dialog-Frame :first-child
     2373       .
     2374       do while valid-handle(v-field-group-handle)
     2375       :
     2376         assign
     2377           v-object-handle = v-field-group-handle :first-child
     2378         .
     2379         do while valid-handle(v-object-handle)
     2380         :
     2381           if  v-object-handle <> v-diasize-browse-handle :handle
     2382           and v-object-handle <> v-diasize-resize-button
     2383           and can-query(v-object-handle, "row")
     2384           and can-query(v-object-handle, "height")
     2385           and ( v-object-handle :col + v-object-handle :width
     2386                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2387               )
     2388           then do:
     2389             find first buf_temp-browse-handle
     2390               where buf_temp-browse-handle.browse-type   = 'width':u
     2391                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2392               no-error .
     2393             if available buf_temp-browse-handle
     2394             then do:
     2395             end.
     2396             else do:
     2397               create buf_temp-diasize-handle .
     2398               assign
     2399                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2400                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2401               .
     2402             end.
     2403           end.
     2404           assign
     2405             v-object-handle = v-object-handle :next-sibling
     2406           .
     2407         end.
     2408         assign
     2409           v-field-group-handle = v-field-group-handle :next-sibling
     2410         .
     2411       end.
     2412       do with frame Dialog-Frame
     2413       :
     2414         hide v-diasize-resize-button .
     2415         v-diasize-resize-button :row = 1.
     2416         v-diasize-resize-button :column = 1.
     2417       end.
     2418       if p-change-value > 0
     2419       then do:
     2420         if frame Dialog-Frame :scrollable = true
     2421         then do:
     2422           assign
     2423             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2424             no-error .
     2425           if error-status :error
     2426           or error-status :get-message(1) <> ""
     2427           then do:
     2428             undo move_block, retry move_block.
     2429           end.
     2430         end.
     2431         assign
     2432           frame Dialog-Frame :width = v-frame-width + p-change-value
     2433           no-error .
     2434         if error-status :error
     2435         or error-status :get-message(1) <> ""
     2436         then do:
     2437           undo move_block, retry move_block.
     2438         end.
     2439         assign
     2440           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2441         no-error .
     2442         if error-status :error
     2443         or error-status :get-message(1) <> ""
     2444         then do:
     2445           undo move_block, retry move_block.
     2446         end.
     2447         for each buf_temp-browse-handle
     2448           where buf_temp-browse-handle.browse-type = 'width':u
     2449         on error undo move_block, retry move_block
     2450         :
     2451           assign
     2452             buf_temp-browse-handle.browse-handle :width
     2453               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2454             no-error .
     2455           if error-status :error
     2456           or error-status :get-message(1) <> ""
     2457           then do:
     2458             undo move_block, retry move_block .
     2459           end.
     2460         end.
     2461         for each buf_temp-diasize-handle
     2462         on error undo move_block, retry move_block
     2463         :
     2464           assign
     2465             v-object-handle = buf_temp-diasize-handle.handle-value
     2466           .
     2467           if v-object-handle <> v-diasize-resize-button
     2468           then do:
     2469             assign
     2470               v-object-handle :col = v-object-handle :col + p-change-value
     2471               no-error .
     2472             if error-status :error
     2473             or error-status :get-message(1) <> ""
     2474             then do:
     2475               undo move_block, retry move_block .
     2476             end.
     2477           end.
     2478         end.
     2479       end.
     2480       else do:
     2481         for each buf_temp-diasize-handle
     2482         on error undo move_block, retry move_block
     2483         :
     2484           assign
     2485             v-object-handle = buf_temp-diasize-handle.handle-value
     2486           .
     2487           if v-object-handle <> v-diasize-resize-button
     2488           then do:
     2489             assign
     2490               v-object-handle :col = v-object-handle :col + p-change-value
     2491               no-error .
     2492             if error-status :error
     2493             or error-status :get-message(1) <> ""
     2494             then do:
     2495               undo move_block, retry move_block .
     2496             end.
     2497           end.
     2498         end.
     2499         for each buf_temp-browse-handle
     2500           where buf_temp-browse-handle.browse-type = 'width':u
     2501         on error undo move_block, retry move_block
     2502         :
     2503           assign
     2504             buf_temp-browse-handle.browse-handle :width
     2505               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2506             no-error .
     2507           if error-status :error
     2508           or error-status :get-message(1) <> ""
     2509           then do:
     2510             undo move_block, retry move_block .
     2511           end.
     2512         end.
     2513         assign
     2514           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2515           no-error .
     2516         if error-status :error
     2517         or error-status :get-message(1) <> ""
     2518         then do:
     2519           undo move_block, retry move_block.
     2520         end.
     2521         assign
     2522           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2523         no-error .
     2524         if error-status :error
     2525         or error-status :get-message(1) <> ""
     2526         then do:
     2527           undo move_block, retry move_block.
     2528         end.
     2529         if frame Dialog-Frame :scrollable = true
     2530         then do:
     2531           assign
     2532             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2533           no-error .
     2534           if error-status :error
     2535           or error-status :get-message(1) <> ""
     2536           then do:
     2537             undo move_block, retry move_block.
     2538           end.
     2539         end.
     2540       end.
     2541       if p-move-resize
     2542       then do:
     2543         run diasize_position-resize-button in this-procedure .
     2544       end.
     2545       if v-diasize-wndstore = true
     2546       then do:
     2547         if connected("ub") = true
     2548         then do:
     2549           define variable v-cntxt-db-num        as integer   no-undo .
     2550           define variable v-cntxt-userid        as character no-undo .
     2551           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2552                                             , OUTPUT v-cntxt-userid
     2553                                             ) .
     2554           run gbl/wndsizew.p
     2555             (input  v-cntxt-db-num
     2556             ,input  v-cntxt-userid
     2557             ,input  v-diasize-proc-name
     2558             ,input  'width':u
     2559             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2560             ) .
     2561         end.
     2562       end.
     2563     end.
     2564     assign
     2565       v-diasize-change-size = false
     2566     .
     2567   end procedure.
     2568   procedure diasize_set-width :
     2569     define input  parameter p-new-width  as decimal   no-undo .
     2570     define input  parameter p-move-resize as logical   no-undo .
     2571     do
     2572     on error undo, return error return-value
     2573     :
     2574       run diasize_change-width in this-procedure
     2575         (input  (p-new-width - frame Dialog-Frame :width)
     2576         ,input  p-move-resize
     2577         ) .
     2578     end.
     2579   end procedure.
     2580   procedure diasize_position-resize-button :
     2581     do with frame Dialog-Frame
     2582     :
     2583       hide v-diasize-resize-button .
     2584       assign
     2585         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2586                     - 1
     2587                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2588         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2589                     - 1
     2590                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2591       .
     2592       view v-diasize-resize-button .
     2593     end.
     2594   end procedure.
     2595   on alt-right anywhere
     2596   do:
     2597     run diasize_change-width in this-procedure
     2598       (input 1
     2599       ,input true
     2600       ) .
     2601     return no-apply .
     2602   end.
     2603   on alt-left anywhere
     2604   do:
     2605     run diasize_change-width in this-procedure
     2606       (input -1
     2607       ,input true
     2608       ) .
     2609     return no-apply .
     2610   end.
     2611   on alt-down anywhere
     2612   do:
     2613     run diasize_change-height in this-procedure
     2614       (input 1
     2615       ,input true
     2616       ) .
     2617     return no-apply .
     2618   end.
     2619   on alt-up anywhere
     2620   do:
     2621     run diasize_change-height in this-procedure
     2622       (input -1
     2623       ,input true
     2624       ) .
     2625     return no-apply .
     2626   end.
     2627   on alt-enter of frame Dialog-Frame
     2628   do:
     2629     run diasize_maximize in this-procedure
     2630       (input  ?
     2631       ).
     2632     return no-apply .
     2633   end.
     2634   procedure diasize_end-move :
     2635     do
     2636     on error undo, return error return-value
     2637     :
     2638       define variable v-row-delta as decimal   no-undo .
     2639       define variable v-col-delta as decimal   no-undo .
     2640       define variable v-new-row as decimal   no-undo .
     2641       define variable v-new-col as decimal   no-undo .
     2642       assign
     2643         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2644         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2645       .
     2646       assign
     2647         v-row-delta = v-new-row - frame Dialog-Frame :height
     2648         v-col-delta = v-new-col - frame Dialog-Frame :width
     2649       .
     2650       run diasize_change-height in this-procedure
     2651         (input v-row-delta
     2652         ,input true
     2653         ) .
     2654       run diasize_change-width in this-procedure
     2655         (input v-col-delta
     2656         ,input true
     2657         ) .
     2658     end.
     2659   end procedure.
     2660   procedure diasize_maximize :
     2661     define input  parameter p-action as logical   no-undo .
     2662     do
     2663     on error undo, return error return-value
     2664     :
     2665       if p-action = ?
     2666       then do:
     2667         if v-diasize-need-maximize = true
     2668         then do:
     2669           assign
     2670             p-action = true
     2671           .
     2672         end.
     2673         else do:
     2674           assign
     2675             p-action = false
     2676           .
     2677         end.
     2678       end.
     2679       if p-action = true
     2680       then do:
     2681         run diasize_change-height in this-procedure
     2682           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2683               - frame Dialog-Frame :height-chars
     2684           ,input true
     2685           ) .
     2686         run diasize_change-width in this-procedure
     2687           (input session :width-chars
     2688               - frame Dialog-Frame :width-chars
     2689           ,input true
     2690           ) .
     2691         assign
     2692           v-diasize-need-maximize = false
     2693         .
     2694       end.
     2695       else do:
     2696         run diasize_change-width in this-procedure
     2697           (input v-diasize-orig-frame-width
     2698               - frame Dialog-Frame :width-chars
     2699           ,input true
     2700           ) .
     2701         run diasize_change-height in this-procedure
     2702           (input v-diasize-orig-frame-height
     2703               - frame Dialog-Frame :height-chars
     2704           ,input true
     2705           ) .
     2706         assign
     2707           v-diasize-need-maximize = true
     2708         .
     2709       end.
     2710     end.
     2711   end procedure.
     2712   procedure diasize_restore-orig-size :
     2713     do
     2714     on error undo, return error return-value
     2715     :
     2716       assign
     2717         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2718         v-diasize-current-frame-height = frame Dialog-Frame :height
     2719       .
     2720       run diasize_set-height in this-procedure
     2721         (input  v-diasize-orig-frame-height
     2722         ,input  true
     2723         ) .
     2724       run diasize_set-width in this-procedure
     2725         (input  v-diasize-orig-frame-width
     2726         ,input  true
     2727         ) .
     2728     end.
     2729   end procedure.
     2730   procedure diasize_restore-current-size :
     2731     do
     2732     on error undo, return error return-value
     2733     :
     2734       run diasize_set-height in this-procedure
     2735         (input  v-diasize-current-frame-height
     2736         ,input  true
     2737         ) .
     2738       run diasize_set-width in this-procedure
     2739         (input  v-diasize-current-frame-width
     2740         ,input  true
     2741         ) .
     2742     end.
     2743   end procedure.
     2744   procedure diasize_set-browse-handle :
     2745     define input  parameter p-browse-handle as handle   no-undo .
     2746     define buffer buf_temp-browse-handle for temp-browse-handle .
     2747     do
     2748     on error undo, return error return-value
     2749     :
     2750       assign
     2751         v-diasize-browse-handle = p-browse-handle
     2752       .
     2753       for each buf_temp-browse-handle
     2754       on error undo, return error return-value
     2755       :
     2756         delete buf_temp-browse-handle .
     2757       end.
     2758     end.
     2759   end procedure.
     2760   procedure diasize_add_browse :
     2761     define input  parameter p-browse-type   as character no-undo .
     2762     define input  parameter p-browse-handle as handle    no-undo .
     2763     define buffer buf_temp-browse-handle for temp-browse-handle .
     2764     do
     2765     on error undo, return error return-value
     2766     :
     2767       assign
     2768         v-diasize-browse-number = v-diasize-browse-number + 1
     2769       .
     2770       create buf_temp-browse-handle .
     2771       assign
     2772         buf_temp-browse-handle.browse-type   = p-browse-type
     2773         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2774         buf_temp-browse-handle.browse-handle = p-browse-handle
     2775       .
     2776     end.
     2777   end procedure.
     2778   procedure diasize_init :
     2779     define variable v-default-value    as logical   no-undo .
     2780     define variable v-restore-saved    as logical   no-undo .
     2781     define variable v-resize-value-str as character no-undo .
     2782     do
     2783     on error undo, return error return-value
     2784     :
     2785       do with frame Dialog-Frame
     2786       :
     2787         assign
     2788           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2789           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2790           v-diasize-browse-handle     = browse br-parus-cli :handle
     2791         .
     2792         create button v-diasize-resize-button
     2793         assign
     2794           parent        = frame Dialog-Frame :first-child
     2795           label         = "s"
     2796           height-pixels = 16
     2797           width-pixels  = 16
     2798           visible       = true
     2799           sensitive     = true
     2800           movable       = true
     2801           triggers:
     2802             on end-move persistent run diasize_end-move in this-procedure .
     2803           end triggers.
     2804         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2805         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2806         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2807         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2808         assign
     2809           v-diasize-wndmax = false
     2810         .
     2811         if connected("ub") = true
     2812         then do:
     2813           define variable v-cntxt-db-num        as integer   no-undo .
     2814           define variable v-cntxt-userid        as character no-undo .
     2815           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2816                                             , OUTPUT v-cntxt-userid
     2817                                             ) .
     2818           run gbl/wndpar_r.p
     2819             (input  v-cntxt-db-num
     2820             ,input  v-cntxt-userid
     2821             ,input  'wndmax':U
     2822             ,output v-diasize-wndmax
     2823             ,output v-default-value
     2824             ) .
     2825         end.
     2826         assign
     2827           v-diasize-wndstore = false
     2828         .
     2829         if connected("ub") = true
     2830         then do:
     2831           run gbl/wndpar_r.p
     2832             (input  v-cntxt-db-num
     2833             ,input  v-cntxt-userid
     2834             ,input  'wndstore':U
     2835             ,output v-diasize-wndstore
     2836             ,output v-default-value
     2837             ) .
     2838         end.
     2839         assign
     2840           v-diasize-proc-name = entry(1, program-name(2), '.')
     2841         .
     2842         if v-diasize-wndstore = true
     2843         then do:
     2844           assign
     2845             v-restore-saved = false
     2846           .
     2847           if connected("ub") = true
     2848           then do:
     2849             run gbl/wndsizer.p
     2850               (input  v-cntxt-db-num
     2851               ,input  v-cntxt-userid
     2852               ,input  v-diasize-proc-name
     2853               ,input  'height':u
     2854               ,output v-resize-value-str
     2855               ) .
     2856             if v-resize-value-str <> '':U
     2857             then do:
     2858               run diasize_change-height in this-procedure
     2859                 (input  integer(v-resize-value-str)
     2860                 ,input  true
     2861                 ) .
     2862               assign
     2863                 v-restore-saved = true
     2864               .
     2865             end.
     2866           end.
     2867           if connected("ub") = true
     2868           then do:
     2869             run gbl/wndsizer.p
     2870               (input  v-cntxt-db-num
     2871               ,input  v-cntxt-userid
     2872               ,input  v-diasize-proc-name
     2873               ,input  'width':u
     2874               ,output v-resize-value-str
     2875               ) .
     2876             if v-resize-value-str <> '':U
     2877             then do:
     2878               run diasize_change-width in this-procedure
     2879                 (input  integer(v-resize-value-str)
     2880                 ,input  true
     2881                 ) .
     2882               assign
     2883                 v-restore-saved = true
     2884               .
     2885             end.
     2886           end.
     2887           if v-restore-saved <> true
     2888           then do:
     2889             if v-diasize-wndmax = true
     2890             then do:
     2891               run diasize_maximize in this-procedure
     2892                 (input  true
     2893                 ) .
     2894             end.
     2895           end.
     2896         end.
     2897         else do:
     2898           if v-diasize-wndmax = true
     2899           then do:
     2900             run diasize_maximize in this-procedure
     2901               (input  true
     2902               ) .
     2903           end.
     2904         end.
     2905       end.
     2906     end.
     2907   end procedure.
     2908   procedure diasize_need-full-display :
     2909     define output parameter p-need-full-display as logical   no-undo .
     2910     do
     2911     on error undo, return error return-value
     2912     :
     2913       assign
     2914         p-need-full-display = v-diasize-need-full-display
     2915       .
     2916       assign
     2917         v-diasize-need-full-display = false
     2918       .
     2919     end.
     2920   end procedure.
     2921   procedure get-context :
     2922      define output parameter p-db-num as integer          no-undo.
     2923      define output parameter p-user-id as character        no-undo.
     2924      define variable v-login               as character    no-undo.
     2925      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2926      define buffer buf_user-login  for ub.user-login .
     2927      do
     2928      on error undo, return error
     2929      :
     2930            FIND FIRST buf_sys-ctrl no-lock.
     2931            ASSIGN
     2932               v-login = USERID("ub")
     2933               p-db-num = buf_sys-ctrl.db-num
     2934            .
     2935            FIND FIRST buf_user-login
     2936                 WHERE buf_user-login.db-num = p-db-num
     2937                   AND buf_user-login.user-login = v-login
     2938                 no-lock
     2939                 no-error
     2940                 .
     2941            IF AVAILABLE buf_user-login
     2942            THEN DO:
     2943               assign
     2944                  p-user-id = buf_user-login.user-id
     2945               .
     2946            END.
     2947      end.
     2948   end procedure.
     2949       run diasize_init in this-procedure .
     2950   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2951   procedure set-filter-name :
     2952   define input parameter p-filter-name as character no-undo .
     2953     do with frame Dialog-Frame:
     2954       if p-filter-name > "" then do:
     2955         assign
     2956           frame Dialog-Frame:title
     2957             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2958         .
     2959         assign
     2960           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2961         .
     2962       end.
     2963       else do:
     2964         assign
     2965           b-sch :tooltip = ""
     2966         .
     2967       end.
     2968     end.
     2969   end procedure.
     2970   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2971   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     2972     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     2973     return no-apply.
     2974   end.
     2975   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2976   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     2977     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     2978     return no-apply.
     2979   end.
     2980   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2981   on F8 of frame Dialog-Frame anywhere do:
     2982     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     2983     return no-apply.
     2984   end.
     2985   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2986   on INS of frame Dialog-Frame anywhere do:
     2987     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2988     return no-apply.
     2989   end.
     2990   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2991   on F2 of frame Dialog-Frame anywhere do:
     2992     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2993     return no-apply.
     2994   end.
     2995   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2996   on F2 of frame Dialog-Frame anywhere do:
     2997     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2998     return no-apply.
     2999   end.
     3000   MAIN-BLOCK:
     3001   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3002      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3003   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3004     run mainmenu_getcntxt in parparentproc
     3005       (output v-cntxt-db-num
     3006       ,output v-cntxt-userid
     3007       ,output v-cntxt-level
     3008       ,output v-cntxt-host-code-obj
     3009       ,output v-cntxt-obj-type
     3010       ,output v-cntxt-obj-code
     3011       ,output v-cntxt-db-num-obj
     3012       ,output v-cntxt-is-admin
     3013       ) .
     3014     v-rid-list = p-rid-list.
     3015     RUN Myenable.
     3016     WAIT-FOR GO OF FRAME Dialog-Frame.
     3017   END.
     3018   RUN disable_UI.
     3019   PROCEDURE disable_UI :
     3020     HIDE FRAME Dialog-Frame.
     3021   END PROCEDURE.
     3022   PROCEDURE enable_UI :
     3023     DISPLAY mark-num
     3024         WITH FRAME Dialog-Frame.
     3025     ENABLE b-quit B-mark B-sel b-add b-del b-cli b-sch b-print B-Help
     3026            br-parus-cli mark-num
     3027         WITH FRAME Dialog-Frame.
     3028     VIEW FRAME Dialog-Frame.
     3029     OPEN QUERY br-parus-cli FOR EACH X_ext-classif NO-LOCK,        FIRST X_clients NO-LOCK INDEXED-REPOSITION.
     3030   END PROCEDURE.
     3031   PROCEDURE MyEnable :
     3032   ENABLE
     3033   b-quit
     3034   b-cli
     3035   b-print
     3036   b-add when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction)
     3037   b-del when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction)
     3038   b-sch
     3039   B-Help
     3040   br-parus-cli
     3041   WITH FRAME Dialog-Frame.
     3042   VIEW FRAME Dialog-Frame.
     3043   RUN Openbr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     3044   END PROCEDURE.
     3045   PROCEDURE OpenBr :
     3046   define input  parameter p-open-query     as logical   no-undo .
     3047   define input  parameter p-find-next      as logical   no-undo .
     3048   define input  parameter p-find-condition as character no-undo .
     3049   define variable sort-column-phrase as character no-undo .
     3050   define variable l-query-was-opened as logical no-undo .
     3051   define variable title0 as character no-undo .
     3052   define buffer buf_clients for ub.clients.
     3053   case sort-column-name :
     3054     when "" then do:
     3055       assign
     3056         sort-column-phrase = ""
     3057       .
     3058     end.
     3059     otherwise do:
     3060       assign
     3061         sort-column-phrase = "by " + sort-column-name
     3062       .
     3063     end.
     3064   end case.
     3065   filter-point = filter-point0 + p-list-mode .
     3066   title0 = "Клиенты в системе ПАРУС".
     3067   ASSIGN
     3068   frame Dialog-Frame:title = substitute("&1", title0)
     3069   filter-label = SUBSTITUTE("&1"
     3070                             , frame Dialog-Frame:title
     3071                             )
     3072   .
     3073   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3074   define variable  l-disable-where-27  as logical   no-undo .
     3075   define variable  l-filter-open-27    as logical   .
     3076   define variable  flt-rec-27       as recid     no-undo .
     3077   define variable  filter-name-27      as character no-undo .
     3078   define variable  where-phrase-27     as character no-undo .
     3079   define variable  sort-phrase-27      as character no-undo .
     3080   define variable  where-phrase-rus-27 as character no-undo .
     3081   define variable  sort-phrase-rus-27  as character no-undo .
     3082   run gbl/flt-get.p
     3083     (input filter-point
     3084     ,output flt-rec-27
     3085     ,output filter-name-27
     3086     ,output where-phrase-27
     3087     ,output sort-phrase-27
     3088     ,output where-phrase-rus-27
     3089     ,output sort-phrase-rus-27
     3090     ).
     3091       run set-filter-name in this-procedure
     3092         (INPUT filter-name-27
     3093         ) no-error .
     3094     assign
     3095       l-filter-open-27 = false
     3096     .
     3097     if flt-rec-27 <> ?
     3098       or sort-column-phrase > ""
     3099     then do:
     3100       define variable  parameter-2-27 as character no-undo .
     3101       define variable  parameter-3-27 as character no-undo .
     3102       define variable  parameter-4-27 as character no-undo .
     3103       define variable  parameter-5-27 as character no-undo .
     3104       define variable  parameter-6-27 as character no-undo .
     3105       define variable  parameter-7-27 as character no-undo .
     3106         assign
     3107         parameter-3-27 =
     3108                                 "FOR EACH X_ext-classif"
     3109         parameter-4-27 =
     3110           (
     3111             if (" X_ext-classif.classif-subject = 'clients':U                         and X_ext-classif.classif-name = 'exp-parus-code':U                         AND X_ext-classif.db-num = - 1" + " " + where-phrase-27) <> ""
     3112             then  substitute('X_ext-classif.classif-subject = &1&2&1                         and X_ext-classif.classif-name = &1&3&1                         AND X_ext-classif.db-num = - 1', chr(34), 'clients':U, 'exp-parus-code':U) + " " + where-phrase-27
     3113             else "true"
     3114           )
     3115         parameter-5-27 = (" " + "" + " " + substitute(', FIRST X_clients NO-LOCK WHERE                                   X_clients.obj-type = ENTRY(2, X_eXt-classif.uniq-key-rec, chr(3)) AND                                   X_clients.obj-code = integer(ENTRY(3, X_eXt-classif.uniq-key-rec, chr(3)))'))
     3116         parameter-6-27 = if sort-phrase-27 = ''
     3117                              then
     3118           (
     3119           " " + "  " +
     3120             " " + sort-column-phrase +
     3121           " " + "  "
     3122           )
     3123                              else
     3124           (
     3125           " " + "  " +
     3126             " " + sort-column-phrase +
     3127           " " + sort-phrase-27
     3128           )
     3129         parameter-7-27 =
     3130           " INDEXED-REPOSITION  "
     3131       .
     3132       do
     3133       on stop undo, leave
     3134       on error undo, leave
     3135       :
     3136         assign
     3137           l-disable-where-27 =
     3138             (" X_ext-classif.classif-subject = 'clients':U                         and X_ext-classif.classif-name = 'exp-parus-code':U                         AND X_ext-classif.db-num = - 1" + " " + where-phrase-27 = "")
     3139         .
     3140         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3141                             ,input QUERY br-parus-cli:handle
     3142                             ,input parameter-3-27
     3143                             ,input parameter-4-27
     3144                             ,input parameter-5-27
     3145                             ,input parameter-6-27
     3146                             ,input parameter-7-27
     3147                             )
     3148         .
     3149         assign
     3150           l-filter-open-27 = true
     3151         .
     3152       end.
     3153       if l-filter-open-27 = false then do:
     3154         message
     3155           "Ошибка при фильтрации / сортировке" skip
     3156           "Будут показаны записи без учета фильтра" skip
     3157           view-as alert-box .
     3158       end.
     3159       else do:
     3160           assign
     3161             l-query-was-opened = true
     3162           .
     3163       end.
     3164     end.
     3165     if l-filter-open-27 = false then do:
     3166       OPEN QUERY br-parus-cli FOR EACH X_ext-classif
     3167         where  X_ext-classif.classif-subject = 'clients':U                         and X_ext-classif.classif-name = 'exp-parus-code':U                         AND X_ext-classif.db-num = - 1
     3168       , FIRST X_clients NO-LOCK WHERE                                   X_clients.obj-type = ENTRY(2, X_eXt-classif.uniq-key-rec, chr(3)) AND                                   X_clients.obj-code = integer(ENTRY(3, X_eXt-classif.uniq-key-rec, chr(3)))
     3169         INDEXED-REPOSITION
     3170     .
     3171         assign
     3172           l-query-was-opened = true
     3173         .
     3174     end.
     3175   APPLY "entry" TO br-parus-cli.
     3176   if available X_ext-classif then do:
     3177       APPLY "VALUE-CHANGED":U to br-parus-cli.
     3178   END.
     3179   END PROCEDURE.
     3180   PROCEDURE proc-b-add :
     3181   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     3182   define variable v-rid as recid no-undo .
     3183   DEFINE VARIABLE v-ok AS logical NO-UNDO.
     3184   DEFINE VARIABLE v-value-integer AS integer NO-UNDO.
     3185   define variable v-uniq-key-rec as character no-undo .
     3186   define buffer buf_clients for ub.clients.
     3187   message
     3188   "Выберите клиента, для которого Вы хотите добавить запись в системе ПАРУС"
     3189   view-as alert-box .
     3190   run ref/cli-all.w (   input parparentproc
     3191                     ,input "b-sel"
     3192                     ,input 'орг':U
     3193                     ,input 'все':U
     3194                     ,input 'текущие':U
     3195                     ,input ?
     3196                     ,input ",,,,,,NO,,"
     3197                     ,input "":U
     3198                     ,output v-rid-list) no-error.
     3199   if v-rid-list = '':U then return no-apply.
     3200   find first buf_clients where recid (buf_clients) = integer (v-rid-list) no-lock no-error.
     3201   if not (buf_clients.obj-type = 'орг':U
     3202          or
     3203          buf_clients.obj-type = 'чел':U) then do:
     3204     message
     3205     "Можно выбрать только ОРГАНИЗАЦИЮ или ФИЗ.ЛИЦО"
     3206     view-as alert-box error .
     3207     undo, return error .
     3208   end.
     3209   run gbl/d-integer.w (
     3210          input ?
     3211         ,input (
     3212         'title=':u + substitute("Добавление кода клиента в системе ПАРУС для &1&2"
     3213                                 ,buf_clients.obj-type
     3214                                 ,buf_clients.obj-code) + '\':u
     3215       + 'text1=':u + "Код клиента в систем ПАРУС" + '\':u
     3216       + 'format=' + ">>>>>>>>9" + '\':u
     3217       + 'fillin_row=2\':u
     3218       + 'fillin_col=30\':u
     3219       + 'fillin_width=10\':u
     3220       + 'fillin_height=1\':u
     3221       + 'max-chars=60\':u
     3222       + 'readonly=no' + '\':u)
     3223       , input-output v-value-integer
     3224       , output v-ok
     3225           ).
     3226   if not v-ok then return error.
     3227   run gen-key-rec IN THIS-PROCEDURE ( input 'clients':U
     3228                                  ,input (buffer buf_clients:handle)
     3229                                  ,output v-uniq-key-rec).
     3230   run ref/extclas1.p ( INPUT 'ДОБАВЛЕНИЕ':U
     3231                       ,INPUT NO
     3232                       ,INPUT-OUTPUT v-rid
     3233                       ,INPUT 'clients':U
     3234                       ,INPUT 'exp-parus-code':U
     3235                       ,input (-1)
     3236                       ,input v-value-integer
     3237                       ,input 0
     3238                       ,input 0
     3239                       ,input '':U
     3240                       ,input '':U
     3241                       ,input '':U
     3242                       ,input 0
     3243                       ,input v-uniq-key-rec ) no-error.
     3244   if error-status:error then do:
     3245     undo, return error .
     3246   end.
     3247   if v-rid <> ? then do:
     3248     run openbr in this-procedure ( input yes, input no, input '':U).
     3249     reposition br-parus-cli to recid v-rid no-error .
     3250     apply "entry" to br-parus-cli in frame Dialog-Frame .
     3251   end.
     3252   END PROCEDURE.
     3253   PROCEDURE proc-b-del :
     3254   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     3255   DEFINE VARIABLE glog AS logical NO-UNDO.
     3256   IF NOT AVAILABLE X_ext-classif THEN UNDO, RETURN ERROR.
     3257   v-rec = recid(X_ext-classif).
     3258   MESSAGE
     3259   "Вы действительно хотитет удалить эту запись?"
     3260   VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     3261   IF NOT glog THEN RETURN ERROR.
     3262   run ref/extclas3.p ( INPUT NO
     3263                       ,INPUT v-rec) NO-ERROR.
     3264   if not error-status:error then do:
     3265     run openbr in this-procedure ( input yes, input no, input '':U).
     3266     reposition br-parus-cli to row 1 no-error .
     3267     apply "entry" to br-parus-cli in frame Dialog-Frame .
     3268   end.
     3269   END PROCEDURE.
     3270   PROCEDURE proc-b-print :
     3271   DEFINE VARIABLE date_string              as   character no-undo .
     3272   DEFINE VARIABLE Line                     as   character no-undo .
     3273   DEFINE VARIABLE for-time                 as   character no-undo .
     3274   DEFINE VARIABLE accum-count              as   integer   no-undo .
     3275   define variable v-rid                    as   recid no-undo .
     3276   DEFINE FRAME list1
     3277   X_ext-classif.KEY#_one  COLUMN-LABEL "Код в!ПАРУС" FORMAT ">>>>>>>>9"
     3278   X_clients.obj-type COLUMN-LABEL "Тип!клиента" FORMAT "X(3)"
     3279   X_clients.obj-code COLUMN-LABEL "Код!клиента" FORMAT ">>>>>>>>9"
     3280   X_clients.obj-name COLUMN-LABEL "Название клиента" FORMAT "X(60)"
     3281   HEADER  date_string AT 5 format "X(35)"
     3282   string( "Страница " ) format "X(9)" AT 75 PAGE-NUMBER(PrnLibStream) AT 85 FORMAT ">>9" SKIP
     3283   Line format "X(192)" AT 1
     3284   with width 232 down stream-io use-text    .
     3285   Line = fill("-", 121).
     3286   date_string = cur-time-print() .
     3287   run prn-lib-open-stream  in this-procedure (
     3288                                                input parParentProc
     3289                                               ,input  62
     3290                                               ,input yes
     3291                                               ,input no
     3292                                               ).
     3293   PUT  STREAM PrnLibStream
     3294   SPACE(25) ( frame Dialog-Frame:title )
     3295   format "x(90)" SKIP(1) .
     3296   FORM HEADER
     3297   Line format "X(177)" AT 1 SKIP
     3298   "Продолжение - на следующей странице" AT 30 SKIP
     3299   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3300   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3301   v-rid = recid(X_ext-classif).
     3302   FORM with FRAME List1.
     3303   run waitfram-show in this-procedure ( input "Ждите...").
     3304   DO WHILE available X_ext-classif :
     3305      GET prev br-parus-cli.
     3306   END.
     3307   GET next br-parus-cli.
     3308   DO WHILE available X_ext-classif :
     3309     Display STREAM PrnLibStream
     3310     X_ext-classif.KEY#_one
     3311     X_clients.obj-type
     3312     X_clients.obj-code
     3313     X_clients.obj-name
     3314     with FRAME List1.
     3315     DOWN STREAM PrnLibStream
     3316     1
     3317     with FRAME List1.
     3318     assign
     3319     accum-count = accum-count + 1
     3320     .
     3321     GET next br-parus-cli.
     3322   END.
     3323   UNDERLINE  STREAM PrnLibStream
     3324   X_ext-classif.KEY#_one
     3325   X_clients.obj-type
     3326   X_clients.obj-code
     3327   X_clients.obj-name
     3328   with FRAME List1.
     3329   DISPLAY STREAM PrnLibStream
     3330   accum-count @ X_ext-classif.key#_one
     3331   with frame List1.
     3332   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3333   HIDE  STREAM PrnLibStream FRAME List1.
     3334   output  STREAM PrnLibStream CLOSE.
     3335   reposition br-parus-cli to recid v-rid no-error .
     3336   apply "ENTRY" to br-parus-cli in frame Dialog-Frame .
     3337   run waitfram-hide in this-procedure .
     3338   run prn-lib-prn-file in this-procedure (
     3339                                             input parParentProc
     3340                                             ,input 0
     3341                                             ).
     3342   END PROCEDURE.
     3343   PROCEDURE proc-b-sch :
     3344   define variable v-ri as recid no-undo .
     3345   assign
     3346   v-ri = (if avail X_ext-classif then recid(X_ext-classif) else ?)
     3347   .
     3348   assign
     3349   tbl = 'ext-classif':U
     3350   join-tbl = 'X_ext-classif'
     3351   fld = ""
     3352   lab = ""
     3353   spr = ""
     3354   dim = '0'
     3355   .
     3356   run fltfield-add in this-procedure('key#_one', 'Код клиента ПАРУС', '',
     3357   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3358   DO on stop undo, leave:
     3359       run gbl/filter.w ( INPUT parparentproc
     3360                    ,INPUT filter-point + chr(4) + filter-label
     3361                    ,INPUT tbl
     3362                    ,INPUT join-tbl
     3363                    ,INPUT fld
     3364                    ,INput lab
     3365                    ,INPUT spr
     3366                    ,INPUT  dim).
     3367       run OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     3368       if v-ri <> ? then do:
     3369         reposition br-parus-cli to recid v-ri no-error.
     3370       end.
     3371       APPLY "ENTRY" to br-parus-cli in frame Dialog-Frame .
     3372       APPLY "VALUE-CHANGED" to br-parus-cli.
     3373   END .
     3374   END PROCEDURE.
     3375   FUNCTION get-cli-name RETURNS CHARACTER
     3376     ( INPUT p-uniq-key-rec AS CHARACTER ) :
     3377   DEFINE VARIABLE v-rowid AS ROWID NO-UNDO.
     3378   DEFINE VARIABLE v-tbl-name AS character NO-UNDO.
     3379   DEFINE BUFFER buf_clients FOR ub.clients.
     3380   RUN gen-row-keyr IN THIS-PROCEDURE ( INPUT p-uniq-key-rec
     3381                                       ,input ?
     3382                                       ,INPUT "ub"
     3383                                       ,INPUT ?
     3384                                       ,INPUT NO-LOCK
     3385                                       ,OUTPUT v-rowid
     3386                                       ,OUTPUT v-tbl-name) no-error.
     3387   if error-status :error then do:
     3388     message
     3389       vss-workfile vss-revision vss-description skip
     3390       error-status :get-message(1)
     3391       error-status :get-message(2)
     3392     view-as alert-box error.
     3393     undo, return error.
     3394   end.
     3395   IF v-rowid = ? THEN RETURN 'НЕИЗВЕСТНЫЙ КЛИЕНТ'.
     3396   FIND FIRST buf_clients NO-LOCK WHERE ROWID(buf_clients) = v-rowid.
     3397   RETURN buf_clients.obj-name.
     3398   END FUNCTION.
     3399   FUNCTION get-cli-type-code RETURNS CHARACTER
     3400     ( INPUT p-uniq-key-rec AS character ) :
     3401   DEFINE VARIABLE v-rowid AS ROWID NO-UNDO.
     3402   DEFINE VARIABLE v-tbl-name AS character NO-UNDO.
     3403   DEFINE BUFFER buf_clients FOR ub.clients.
     3404       RUN gen-row-keyr IN THIS-PROCEDURE ( INPUT p-uniq-key-rec
     3405                                           ,INPUT ?
     3406                                           ,INPUT "ub"
     3407                                           ,INPUT ?
     3408                                           ,INPUT NO-LOCK
     3409                                           ,OUTPUT v-rowid
     3410                                           ,OUTPUT v-tbl-name) NO-ERROR.
     3411       if error-status :error then do:
     3412         message
     3413           vss-workfile vss-revision vss-description skip
     3414           error-status :get-message(1)
     3415           error-status :get-message(2)
     3416         view-as alert-box error.
     3417         undo, return error.
     3418       end.
     3419       IF v-rowid = ? THEN RETURN ''.
     3420       FIND FIRST buf_clients NO-LOCK WHERE ROWID(buf_clients) = v-rowid.
     3421       RETURN substitute("&1&2"
     3422                         ,buf_clients.obj-type
     3423                         ,buf_Clients.obj-code).
     3424   END FUNCTION.
