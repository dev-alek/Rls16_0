      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      124   define new shared variable RepPathName        as character no-undo .
      125   define new shared variable PrintRubl          as logical   no-undo .
      126   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   define variable v-waitfram-action01         as character   no-undo .
      128   define variable v-waitfram-action02         as character   no-undo .
      129   define variable v-waitfram-action03         as character   no-undo .
      130   define variable mWaitFramTextBeg            as character   no-undo.
      131   define variable mWaitFramTextEnd            as character   no-undo.
      132   define variable mWaitFramView               as logical     no-undo.
      133   define variable mWaitProcEvent              as logical     no-undo init yes.
      134   define variable mWaitFramInterval           as integer     no-undo init 1 .
      135   define variable mWaitFramStop               as logical     no-undo.
      136   define variable mWaitFramStopUser           as logical     no-undo.
      137   define variable mWaitFramStopTimeOut        as logical     no-undo.
      138   define variable mWaitFramStartProc          as datetime-tz no-undo.
      139   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      140   define button B-WaitFramStop auto-end-key
      141        label "Стоп"
      142        size 10 by 1 tooltip "Остоновить процесс".
      143   define button B-viewProcInfo
      144        label "Информация"
      145        size 15 by 1 tooltip "Информация о процесс".
      146   define frame waitfram
      147     v-waitfram-action01 format "x(72)" no-label skip
      148     v-waitfram-action02 format "x(72)" no-label skip
      149     v-waitfram-action03 format "x(72)" no-label skip
      150     B-viewProcInfo
      151     B-WaitFramStop at row 4 col 30
      152     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      153     .
      154   define new global shared variable mBatchMode as logical no-undo init ?.
      155   define variable mFramBachModHandle as handle no-undo.
      156   mFramBachModHandle = frame waitfram:handle.
      157   define variable mFameOldVis as logical no-undo.
      158   define variable mVisCUrentVin as logical no-undo.
      159   if session:batch-mode
      160   then
      161      mBatchMode = yes.
      162   if mBatchMode = ? then do:
      163     mVisCUrentVin = current-window:visible.
      164     mFameOldVis = mFramBachModHandle:visible.
      165     mFramBachModHandle:visible  = yes.
      166     mBatchMode = mFramBachModHandle:visible ne yes.
      167     mFramBachModHandle:visible = mFameOldVis.
      168     current-window:visible = mVisCUrentVin.
      169   end.
      170    if  log-manager:logfile-name ne ?
      171     then DO:
      172         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      173         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      174         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      175     end.
      176   on choose of B-WaitFramStop in frame waitfram
      177   do:
      178     mWaitFramStop = yes.
      179     mWaitFramStopUser = yes.
      180   end.
      181   function waitfram-check-timeout returns logical():
      182      define variable vtime as int64 no-undo.
      183      if mWaitFramStopTimeOut
      184      then
      185         return yes.
      186      vtime = ( now - mWaitFramStartProc ) / 1000 .
      187      if     mWaitFramTimeOut ne ?
      188         and mWaitFramTimeOut ne 0
      189         and mWaitFramTimeOut lt vtime
      190      then do:
      191         mWaitFramStopTimeOut = yes.
      192      end.
      193      return mWaitFramStopTimeOut.
      194   end.
      195   procedure waitfram-hide :
      196     if not session:batch-mode
      197     then do
      198     on error undo, return error return-value
      199     :
      200       pause 0 before-hide .
      201       if not mBatchMode then
      202         hide frame waitfram .
      203     if     not mWaitFramView
      204        and mWaitProcEvent
      205     then
      206       process events .
      207     end.
      208   end procedure.
      209   procedure waitfram-show :
      210     define input  parameter p-message as character no-undo .
      211     define variable v-left-margin as integer   no-undo .
      212     if not session:batch-mode
      213     then do
      214     on error undo, return error return-value
      215     :
      216       if length(p-message) <= 70 then do:
      217         assign
      218           v-left-margin = integer((70 - length(p-message)) / 2)
      219         .
      220         assign
      221           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      222         .
      223         assign
      224           v-waitfram-action01 = " "
      225           v-waitfram-action02 = " "
      226                                    + fill(" ", v-left-margin)
      227                                    + p-message
      228           v-waitfram-action03 = " "
      229         .
      230       end.
      231       else do:
      232         define variable vRindex1 as integer no-undo.
      233         define variable vRindex2 as integer no-undo.
      234         vRindex1 = r-index(p-message," ",70).
      235         if vRindex1 = 0
      236         then
      237            vRindex1 = 70.
      238         if length(p-message)  <= vRindex1 + 70 then do:
      239           assign
      240             v-waitfram-action01 = " "
      241             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      242             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      243           .
      244         end.
      245         else do:
      246           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      247           if vRindex2 <= vRindex1
      248           then
      249              vRindex2 = vRindex1 + 70.
      250           assign
      251             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      252             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      253             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      254           .
      255         end.
      256       end.
      257       B-viewProcInfo:visible   in frame waitfram = no.
      258       B-viewProcInfo:sensitive in frame waitfram = no.
      259       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      260       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      261       if  (   mWaitFramView
      262          or  mWaitProcEvent)
      263          and not mBatchMode
      264       then
      265          display
      266             v-waitfram-action01 skip
      267             v-waitfram-action02 skip
      268             v-waitfram-action03 skip
      269          with frame waitfram .
      270       if     mWaitFramView
      271          then do:
      272             if     mWaitFramInterval ne ?
      273                and not mBatchMode
      274             then
      275                wait-for go of frame waitfram pause mWaitFramInterval.
      276          end.
      277          else
      278             if     mWaitProcEvent
      279                and not mBatchMode
      280             then
      281                process events .
      282     end.
      283   end procedure.
      284      procedure waitfram-show-this:
      285         define input  parameter iInterval as int64 no-undo.
      286         define variable vtime as int64 no-undo.
      287         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      288         mWaitFramInterval = iInterval.
      289         run waitfram-show (substitute("&1&2 &3&4" ,
      290                                       mWaitFramTextBeg ,
      291                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      292                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      293                                       mWaitFramTextEnd
      294                                      )
      295                           ).
      296      end.
      297      procedure WaitFramRunPause:
      298         define input  parameter iInterval as dec no-undo.
      299         define variable vStart  as datetime-tz no-undo.
      300         define variable vend    as datetime-tz no-undo.
      301         define variable vint as int64 no-undo.
      302         define variable vOk as logical no-undo.
      303         vStart = now.
      304         vend   = vStart.
      305         publish "WaitFramPause" (iInterval,output vOk).
      306         vend   =  now.
      307         vint = vend - vStart.
      308         vint = iInterval - vint / 1000.
      309         if     not mWaitFramStop
      310            and (   vint > 0
      311                 or (    not vOk
      312                     and iInterval eq ?
      313                     )
      314                 )
      315         then
      316            run waitfram-show-this (iInterval).
      317         vend   =  now.
      318         vint = vend - vStart.
      319         vint = iInterval - vint / 1000.
      320         if     not mWaitFramStop
      321            and vint > 0
      322         then do:
      323            run gbl/pause.p (vint * 1000).
      324         end.
      325         if iInterval ne ?
      326         then
      327            publish "WaitFramStop".
      328         waitfram-check-timeout().
      329      end.
      330      procedure WaitFramWaitFor:
      331         define input  parameter iInterval as dec no-undo.
      332         assign
      333            mWaitFramStartProc   = now
      334            mWaitFramStopUser    = no
      335            mWaitFramStopTimeOut = no
      336         .
      337         block-wait:
      338         do while not mWaitFramStop:
      339            run WaitFramRunPause (iInterval).
      340            if  waitfram-check-timeout()
      341            then do:
      342               leave block-wait.
      343            end.
      344         end.
      345         run waitfram-hide.
      346      end.
      347   procedure waitfram-join :
      348     define input  parameter p-line-1  as character no-undo .
      349     define input  parameter p-line-2  as character no-undo .
      350     define input  parameter p-line-3  as character no-undo .
      351     define output parameter p-message as character no-undo .
      352     do
      353     on error undo, return error return-value
      354     :
      355       assign
      356         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      357                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      358                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      359       .
      360     end.
      361   end procedure.
      362   function waitfram-join-function returns character
      363     (input p-line-1 as character
      364     ,input p-line-2 as character
      365     ,input p-line-3 as character
      366     ).
      367     define variable v-message as character no-undo .
      368     run waitfram-join in this-procedure
      369       (input  p-line-1
      370       ,input  p-line-2
      371       ,input  p-line-3
      372       ,output v-message
      373       ) .
      374     return v-message .
      375   end function .
      376   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   define  stream PrnLibStream.
      378   procedure prn-lib-prn-file :
      379     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      380     define input parameter p-DIsabledoptions as integer no-undo .
      381     define variable v-report-name as character no-undo .
      382     define variable v-user-action as character no-undo .
      383     define variable v-printed     as logical   no-undo .
      384     define variable v-exist       as logical   no-undo .
      385     do
      386       on error undo, return error
      387       :
      388       run prn-lib-get-report-name  in this-procedure (
      389         input parParentProc
      390         ,output v-report-name
      391         ).
      392   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      393   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      394     (input  v-report-name
      395     ,input  2
      396     ,output v-exist
      397     )  .
      398       if NOT v-exist then
      399       DO:
      400         Message
      401           "Нет заданий на печать ! "
      402           view-as alert-box .
      403         Return  .
      404       End.
      405       run gbl/prnfilen.w
      406         (input  ""
      407         ,input  p-DisabledOptions
      408         ,input  string(v-report-name )
      409         ,input  7
      410         ,output v-user-action
      411         ,output v-printed
      412         ) .
      413       if v-printed then
      414       do:
      415         return "YES" .
      416       end.
      417       else
      418       do:
      419         return "NO" .
      420       end.
      421     end.
      422   end procedure.
      423   procedure prn-lib-open-stream :
      424     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      425     define input parameter p-page-size    as integer no-undo .
      426     define input parameter p-is-stream    as logical no-undo .
      427     define input parameter p-append       as logical no-undo .
      428     define variable v-report-name as character no-undo .
      429     do
      430       on error undo, return error
      431       :
      432       run prn-lib-get-report-name  in this-procedure (
      433         input parParentProc
      434         ,output v-report-name
      435         ).
      436       if p-is-stream then
      437       do:
      438         if p-append then
      439         do:
      440           output stream PrnLibStream to value( v-report-name )
      441             page-size value(p-page-size) append .
      442         end.
      443         if not p-append then
      444         do:
      445           output stream PrnLibStream to value( v-report-name )
      446             page-size value(p-page-size) .
      447         end.
      448       end.
      449       if not p-is-stream then
      450       do:
      451         if p-append then
      452         do:
      453           output to value( v-report-name )
      454             page-size value(p-page-size) append .
      455         end.
      456         if not p-append then
      457         do:
      458           output to value( v-report-name )
      459             page-size value(p-page-size) .
      460         end.
      461       end.
      462     end.
      463   end procedure.
      464   procedure prn-lib-open-exp :
      465     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      466     define input parameter p-is-stream    as logical no-undo .
      467     define input parameter p-is-append    as logical no-undo .
      468     define output parameter p-ReportFileName as char init "report" no-undo.
      469     define output parameter p-process as logical no-undo .
      470     define variable glog as logical no-undo .
      471     do
      472       on error undo, return error
      473       :
      474       SYSTEM-DIALOG GET-FILE p-ReportFileName
      475         TITLE      "Укажите путь"
      476         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      477         ASK-OVERWRITE
      478         CREATE-TEST-FILE
      479         SAVE-AS
      480         USE-FILENAME
      481         DEFAULT-EXTENSION "txt"
      482         UPDATE glog
      483         .
      484       if not glog then  return.
      485       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      486       if p-is-stream then
      487       do:
      488         if p-is-append then
      489         do:
      490           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      491         end.
      492         else
      493         do:
      494           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      495         end.
      496       end.
      497       else
      498       do:
      499         if p-is-append then
      500         do:
      501           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      502         end.
      503         else
      504         do:
      505           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      506         end.
      507       end.
      508       p-process = yes.
      509     end.
      510   end procedure.
      511   procedure prn-lib-get-report-name :
      512     define input parameter parParentProc  as widget-handle no-undo.
      513     define output parameter p-report-name as character no-undo .
      514     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      515   end procedure.
      516   procedure prn-lib-reportviewer-report-name :
      517     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      518     define input parameter p-report-name-html as character no-undo .
      519     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      520   end procedure.
      521   procedure prn-lib-reportviewer :
      522     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      523     define input parameter p-report-name-html as character no-undo .
      524     define input parameter p-param        as character no-undo .
      525     define variable v-excel           as character no-undo init 'TRUE' .
      526     define variable v-value-character as character no-undo .
      527     define variable v-value-integer   as character no-undo .
      528     define variable v-value-date      as date      no-undo .
      529     define variable v-value-decimal   as decimal   no-undo .
      530     define variable rep-excel         as logical   no-undo .
      531     define variable excel-string      as character no-undo .
      532     define variable v-param-type      as character no-undo .
      533     define variable v-tth             as handle    no-undo .
      534     run adm/shattri.p (
      535       input "get":U
      536       ,input  ""
      537       ,input  0
      538       ,input  'report-glob':U
      539       ,input  'rep-excel':U
      540       ,output v-value-character
      541       ,output v-value-date
      542       ,output v-value-decimal
      543       ,output v-value-integer
      544       ,output rep-excel
      545       ,output v-param-type
      546       ,INPUT-OUTPUT table-handle v-tth
      547       )  .
      548     if rep-excel then v-excel = "TRUE" .
      549     else v-excel = "FALSE" .
      550     if p-param eq ""
      551     then
      552        p-param = "EXCEL:" + v-excel.
      553     else
      554        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      555     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      556   end procedure.
      557   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      558   procedure cur-time :
      559      define output parameter p-today as date      no-undo .
      560      define output parameter p-time  as integer   no-undo .
      561     do
      562     on error undo, return error
      563     :
      564       define variable v-date1 as date      no-undo .
      565       define variable v-date2 as date      no-undo .
      566       define variable v-time  as integer   no-undo .
      567       assign
      568         v-date1 = today
      569         v-time  = time
      570         v-date2 = today
      571       .
      572       if v-date1 <> v-date2
      573       then do:
      574         assign
      575           v-date1 = today
      576           v-time  = v-time
      577         .
      578       end.
      579       assign
      580         p-today = v-date1
      581         p-time  = v-time
      582       .
      583     end.
      584   end.
      585   function cur-time-date returns character
      586   :
      587     return string(today, '99/99/9999':U) .
      588   end.
      589   function cur-time-mjd returns decimal
      590   :
      591     define variable v-date as date      no-undo .
      592     define variable v-time as integer   no-undo .
      593     run cur-time in this-procedure
      594       (output v-date
      595       ,output v-time
      596       ) .
      597     return integer(v-date) - 2400002 + (v-time / 86400) .
      598   end.
      599   function cur-time-get-ending-index returns integer
      600   (input p-number as integer
      601   )
      602   :
      603     if p-number < 0
      604     or p-number = ?
      605     then do:
      606       return 1 .
      607     end.
      608     define variable v-rest as integer   no-undo .
      609     assign
      610       p-number = p-number modulo 100
      611     .
      612     if p-number < 20
      613     then do:
      614       assign
      615         v-rest = p-number
      616       .
      617     end.
      618     else do:
      619       assign
      620         v-rest = p-number modulo 10
      621       .
      622     end.
      623     case v-rest :
      624       when 1
      625       then do:
      626         return 2 .
      627       end.
      628       when 2 or
      629       when 3 or
      630       when 4
      631       then do:
      632         return 3 .
      633       end.
      634       otherwise do:
      635         return 1 .
      636       end.
      637     end case .
      638   end.
      639   procedure cur-time-mjd-to-date :
      640      define input  parameter i-mjd-diff as decimal no-undo.
      641      define output parameter o-Date     as date    no-undo.
      642      define output parameter o-Time     as integer no-undo.
      643      define variable v-day-number as integer   no-undo .
      644      if    i-mjd-diff < 0
      645         or i-mjd-diff = ?
      646      then do:
      647         return "?" .
      648      end.
      649      assign
      650         v-day-number = truncate(i-mjd-diff,0).
      651         o-Date = date(v-day-number + 2400002).
      652         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      653     .
      654   end.
      655   function cur-time-mjd-to-string returns character
      656   (input p-mjd-diff as decimal
      657   )
      658   :
      659     define variable v-day-number as integer   no-undo .
      660     define variable v-seconds    as integer   no-undo .
      661     define variable v-hour       as integer   no-undo .
      662     define variable v-min        as integer   no-undo .
      663     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      664     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      665     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      666     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      667     if p-mjd-diff < 0
      668     or p-mjd-diff = ?
      669     then do:
      670       return "?" .
      671     end.
      672     assign
      673       v-day-number = integer(truncate(p-mjd-diff,0))
      674       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      675     .
      676     if v-seconds > 86400
      677     then do:
      678       assign
      679         v-seconds = 86400 - 1
      680       .
      681     end.
      682     if v-seconds < 0
      683     then do:
      684       assign
      685         v-seconds = 0
      686       .
      687     end.
      688     assign
      689       v-hour = truncate(v-seconds / 3600, 0)
      690     .
      691     assign
      692       v-seconds = v-seconds modulo 3600
      693     .
      694     assign
      695       v-min = truncate(v-seconds / 60, 0)
      696     .
      697     assign
      698       v-seconds = v-seconds modulo 60
      699     .
      700     return
      701         (if v-day-number <> 0
      702           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      703           else ""
      704         )
      705       + (if v-day-number <> 0 or v-hour <> 0
      706           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      707           else ""
      708         )
      709       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      710           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      711           else ""
      712         )
      713       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      714       .
      715   end.
      716   function cur-time-string returns character
      717   :
      718     define variable v-date as date      no-undo .
      719     define variable v-time as integer   no-undo .
      720     run cur-time in this-procedure
      721       (output v-date
      722       ,output v-time
      723       ) .
      724     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      725   end.
      726   function cur-time-string-sec returns character
      727   :
      728     define variable v-date as date      no-undo .
      729     define variable v-time as integer   no-undo .
      730     run cur-time in this-procedure
      731       (output v-date
      732       ,output v-time
      733       ) .
      734     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      735   end.
      736   function cur-time-custom  returns character
      737   (input p-prefix as character
      738   ,input p-date-format as character
      739   ,input p-delimiter as character
      740   ,input p-time-format as character
      741   ,input p-suffix as character
      742   )
      743   :
      744     define variable v-date as date      no-undo .
      745     define variable v-time as integer   no-undo .
      746     run cur-time in this-procedure
      747       (output v-date
      748       ,output v-time
      749       ) .
      750     return
      751       p-prefix
      752       + string(v-date, p-date-format)
      753       + p-delimiter
      754       + string(v-time, p-time-format)
      755       + p-suffix
      756       .
      757   end.
      758   function cur-time-print  returns character
      759   :
      760     define variable v-date as date      no-undo .
      761     define variable v-time as integer   no-undo .
      762     run cur-time in this-procedure
      763       (output v-date
      764       ,output v-time
      765       ) .
      766     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      767   end.
      768   function cur-time-datetime returns datetime
      769   :
      770     define variable v-char as character no-undo .
      771     define variable v-datetime as datetime no-undo .
      772     v-char = cur-time-string().
      773     v-datetime = datetime(v-char).
      774     return  v-datetime.
      775   end.
      776   function cur-time-string-msec returns character
      777   :
      778     define variable v-date as datetime  no-undo .
      779     v-date = now.
      780     return string(v-date) .
      781   end.
      782   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      783   FUNCTION mark-string RETURNS CHARACTER
      784     ( input p-recid as recid, input mark-list as character  ) :
      785     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      786   END FUNCTION.
      787   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      788   function usrfulnf returns character ( input p-user-id as character):
      789   define variable v-user-name as character no-undo .
      790   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      791   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      792     (input  p-user-id
      793     ,output v-user-name
      794     ) no-error .
      795   if error-status:error
      796   or v-user-name = ""
      797   then do:
      798     return p-user-id.
      799   end.
      800   else do:
      801     return v-user-name.
      802   end.
      803   end function.
      804   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      805   define variable sort-column-name as character no-undo .
      806   define variable v-db-num LIKE ub.db.db-num no-undo.
      807   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      808   define  temp-table temp-changes no-undo
      809   field f_name as character
      810   field l_name as character
      811   field v_old as character
      812   field v_new as character
      813   field t_name as character
      814   field num_ as integer
      815   field uniq-key-rec as character
      816   field action as integer
      817   field fNotChange as logical
      818   index pi is unique primary
      819   num_
      820   t_name
      821   f_name
      822   index
      823   Chan
      824   fnotChange
      825   t_name
      826   f_name
      827   index imain uniq-key-rec
      828   .
      829   FUNCTION get-all-fields returns character (p-file-name as character ):
      830   define variable v-dop as character no-undo .
      831     find first _file no-lock where _file._file-name = p-file-name no-error .
      832     if not available _file then return "":U.
      833     for each _field no-lock where
      834              _field._file-recid = recid(_file) :
      835       assign
      836       v-dop = v-dop + _field._field-name + chr(44)
      837       .
      838     end.
      839     return trim(v-dop).
      840   END FUNCTION.
      841   PROCEDURE proc-full-temp-changes :
      842     define input  parameter p-hst-handle as handle    no-undo .
      843     define input  parameter p-main-table as character no-undo .
      844     define input  parameter p-field-list as character no-undo .
      845     define input  parameter p-label-form as character no-undo .
      846     define variable h-new-buf         as handle    no-undo .
      847     define variable h-main-buf        as handle    no-undo .
      848     define variable h-for-comp        as handle    no-undo .
      849     define variable v-inform          as character no-undo .
      850     define variable v-ind             as integer   no-undo .
      851     define variable v-idx-field-qnty  as integer   no-undo .
      852     define variable v-num-entries     as integer   no-undo .
      853     define variable fh                as handle    no-undo .
      854     define variable fh-main           as handle    no-undo .
      855     define variable fh-old            as handle    no-undo .
      856     define variable fh-new            as handle    no-undo .
      857     define variable v-field-name      as character no-undo .
      858     define variable v-field-lvl       as character no-undo .
      859     define variable v-field-form      as character no-undo .
      860     define variable v-search-exp      as character no-undo .
      861     define variable v-srch-main       as character no-undo .
      862     define variable v-word-link       as character no-undo .
      863     define variable v-av-chip-num     as logical   no-undo .
      864     define variable v-main-pi-fld-lst as character no-undo .
      865     define variable v-main-fld-lst    as character no-undo .
      866     define variable v-delim-list      as character no-undo .
      867     define variable v-label           as character no-undo .
      868     define variable v-old-value       as character no-undo case-sensitive.
      869     define variable v-new-value       as character no-undo case-sensitive.
      870     define variable v-chg-fields as character no-undo.
      871     for each temp-changes:
      872       delete temp-changes.
      873     end.
      874     if not p-hst-handle:available then do:
      875       return .
      876     end.
      877     create buffer h-new-buf  for table p-hst-handle .
      878     create buffer h-main-buf for table p-main-table .
      879     assign
      880       v-inform = h-main-buf:index-information(1)
      881       v-ind    = 2
      882     .
      883     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      884     on error undo, return error
      885     :
      886       assign
      887         v-inform = h-main-buf:index-information( v-ind )
      888         v-ind    = v-ind + 1
      889       .
      890     end.
      891     if v-inform = ?
      892       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      893       or entry( 3, v-inform, ",":U ) <> "1":U
      894     then do:
      895       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      896     end.
      897     assign
      898       v-idx-field-qnty = num-entries( v-inform ) - 4
      899     .
      900     if v-idx-field-qnty < 2 then do:
      901       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      902     end.
      903     assign
      904       v-srch-main   = "where":U
      905       v-word-link   = "":U
      906       v-av-chip-num = false
      907       v-delim-list  = "":U
      908     .
      909     do v-ind = 1 to v-idx-field-qnty by 2
      910     on error undo, return error
      911     :
      912       assign
      913         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      914         fh                = p-hst-handle:buffer-field( v-field-name )
      915         fh-main           = h-main-buf:buffer-field( v-field-name )
      916         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      917         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      918       .
      919       if fh:data-type ="character":U then do:
      920         assign
      921           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      922         .
      923       end.
      924       else do:
      925         assign
      926           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      927         .
      928       end.
      929       if v-delim-list = "":U then do:
      930         assign
      931           v-delim-list = ",":U
      932         .
      933       end.
      934       if v-word-link = "":U then do:
      935         assign
      936           v-word-link = "and":U
      937         .
      938       end.
      939     end.
      940     assign
      941       v-delim-list  = "":U
      942     .
      943     do v-ind = 1 to h-main-buf:num-fields
      944     on error undo, return error
      945     :
      946       assign
      947         fh-main      = h-main-buf:buffer-field( v-ind )
      948         v-field-name = fh-main:name
      949       .
      950         assign
      951           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      952         .
      953         if v-delim-list = "":U then do:
      954           assign
      955             v-delim-list = ",":U
      956           .
      957         end.
      958     end.
      959     assign
      960       v-inform = p-hst-handle:index-information(1)
      961       v-ind    = 2
      962     .
      963     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      964     on error undo, return error
      965     :
      966       assign
      967         v-inform = p-hst-handle:index-information( v-ind )
      968         v-ind    = v-ind + 1
      969       .
      970     end.
      971     if v-inform = ?
      972       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      973       or entry( 3, v-inform, ",":U ) <> "1":U
      974     then do:
      975       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      976     end.
      977     assign
      978       v-idx-field-qnty = num-entries( v-inform ) - 4
      979     .
      980     if v-idx-field-qnty < 2 then do:
      981       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      982     end.
      983     assign
      984       v-search-exp  = "where":U
      985       v-word-link   = "":U
      986       v-av-chip-num = false
      987     .
      988     do v-ind = 1 to v-idx-field-qnty by 2
      989     on error undo, return error
      990     :
      991       assign
      992         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      993         fh           = p-hst-handle:buffer-field( v-field-name )
      994         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      995       .
      996       if v-field-name = "chip-num":U then do:
      997         assign
      998           v-search-exp  = substitute( "&1 >", v-search-exp )
      999           v-av-chip-num = true
     1000         .
     1001       end.
     1002       else do:
     1003         assign
     1004           v-search-exp = substitute( "&1 =", v-search-exp )
     1005         .
     1006       end.
     1007       if fh:data-type ="character":U then do:
     1008         assign
     1009           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1010         .
     1011       end.
     1012       else do:
     1013         assign
     1014           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1015         .
     1016       end.
     1017       if v-word-link = "":U then do:
     1018         assign
     1019           v-word-link = "and":U
     1020         .
     1021       end.
     1022     end.
     1023     if v-av-chip-num = false then do:
     1024       message
     1025         vss-workfile vss-revision vss-description skip
     1026         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1027         "Использование данной процедуры невозможно!" skip
     1028         view-as alert-box error .
     1029       return error .
     1030     end.
     1031     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1032     if not h-new-buf:available then do:
     1033       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1034       if not h-main-buf:available then do:
     1035         assign
     1036           h-for-comp = ?
     1037         .
     1038       end.
     1039       else do:
     1040         assign
     1041           h-for-comp = h-main-buf
     1042         .
     1043       end.
     1044     end.
     1045     else do:
     1046       assign
     1047         h-for-comp = h-new-buf
     1048       .
     1049     end.
     1050     assign
     1051       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1052     .
     1053     do v-ind = 1 to v-num-entries
     1054     on error undo, return error return-value
     1055     :
     1056       assign
     1057         v-field-name = entry( v-ind, v-main-fld-lst )
     1058         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1059         v-old-value  = fh-old:buffer-value()
     1060         v-label      = trim( fh-old:label )
     1061       .
     1062       if ( trim( p-field-list ) <> "":U
     1063            and lookup( v-field-name, p-field-list ) > 0
     1064          )
     1065          or trim( p-field-list ) = "":U
     1066       then do:
     1067         if h-for-comp <> ? then do:
     1068           assign
     1069             fh-new      = h-for-comp:buffer-field( v-field-name )
     1070             v-new-value = fh-new:buffer-value()
     1071           .
     1072         end.
     1073         else do:
     1074           assign
     1075             v-new-value = "":U
     1076           .
     1077         end.
     1078         if v-old-value <> v-new-value
     1079         then do:
     1080           create temp-changes.
     1081           assign
     1082             temp-changes.t_name = p-main-table
     1083             temp-changes.f_name = v-field-name
     1084             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1085             temp-changes.v_old  = trim( v-old-value )
     1086             temp-changes.v_new  = trim( v-new-value )
     1087             temp-changes.num_   = 0
     1088             temp-changes.fNotChange = v-old-value eq v-new-value
     1089           .
     1090         end.
     1091       end.
     1092     end.
     1093     assign
     1094       v-num-entries = num-entries( p-label-form, chr(8) )
     1095     .
     1096     do v-ind = 1 to v-num-entries
     1097     on error undo, return error return-value
     1098     :
     1099       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1100         assign
     1101           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1102           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1103           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1104         .
     1105         find first temp-changes
     1106           where temp-changes.f_name = v-field-name
     1107           no-error .
     1108         if available temp-changes then do:
     1109           if trim( v-field-lvl ) <> "":U then do:
     1110             assign
     1111               temp-changes.l_name = v-field-lvl
     1112             .
     1113           end.
     1114           if trim( v-field-form ) <> "":U then do:
     1115             assign
     1116               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1117             .
     1118             if h-for-comp <> ? then do:
     1119               assign
     1120                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1121               .
     1122             end.
     1123           end.
     1124         end.
     1125       end.
     1126       else do:
     1127         message
     1128           vss-workfile vss-revision vss-description skip
     1129           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1130           substitute( "список для поля '&1': '&2'"
     1131                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1132                       ,entry( v-ind, p-label-form, chr(8) )
     1133                     ) skip
     1134           substitute( "полный список: &2", p-label-form ) skip
     1135           view-as alert-box error .
     1136       end.
     1137     end.
     1138     delete object h-new-buf .
     1139     delete object h-main-buf .
     1140   END PROCEDURE.
     1141   DEFINE BUTTON B-Help
     1142        LABEL "Помо&щь"
     1143        SIZE 3 BY 1
     1144        BGCOLOR 8 .
     1145   DEFINE BUTTON B-mark
     1146        LABEL "&*"
     1147        SIZE 3 BY 1.
     1148   DEFINE BUTTON b-quit AUTO-END-KEY
     1149        LABEL "&Выход"
     1150        SIZE 10 BY 1
     1151        BGCOLOR 8 .
     1152   DEFINE BUTTON B-sel AUTO-GO
     1153        LABEL "Вы&бор"
     1154        SIZE 10 BY 1.
     1155   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1156         VIEW-AS TEXT
     1157        SIZE 6 BY 1
     1158        FGCOLOR 4  NO-UNDO.
     1159   DEFINE QUERY BR-changes FOR
     1160         temp-changes SCROLLING.
     1161   DEFINE QUERY br-wp FOR
     1162         X_c-sr-izmerenia SCROLLING.
     1163   DEFINE BROWSE BR-changes
     1164     QUERY BR-changes DISPLAY
     1165   temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(120)"
     1166   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1167   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1168       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.05.
     1169   DEFINE BROWSE br-wp
     1170     QUERY br-wp NO-LOCK DISPLAY
     1171         mark-string(recid(X_c-sr-izmerenia), p-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1172         usrfulnf(X_c-sr-izmerenia.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1173         X_c-sr-izmerenia.corr-date COLUMN-LABEL "Дата!измен" FORMAT "99/99/9999":U
     1174         string(X_c-sr-izmerenia.corr-time, "HH:MM") COLUMN-LABEL "Время!измен" FORMAT "X(5)":U
     1175         X_c-sr-izmerenia.node-code
     1176         X_c-sr-izmerenia.sr-model
     1177         X_c-sr-izmerenia.sr-type-id
     1178       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.24 FIT-LAST-COLUMN.
     1179   DEFINE FRAME Dialog-Frame
     1180        b-quit AT ROW 1 COL 1
     1181        B-mark AT ROW 1 COL 11
     1182        B-sel AT ROW 1 COL 21
     1183        B-Help AT ROW 1 COL 95
     1184        br-wp AT ROW 3 COL 1
     1185        BR-changes AT ROW 13 COL 1
     1186        mark-num AT ROW 1 COL 12.6 COLON-ALIGNED NO-LABEL
     1187        SPACE(78.52) SKIP(20.05)
     1188       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1189            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1190            TITLE "История средств измерения"
     1191            CANCEL-BUTTON b-quit.
     1192   ASSIGN
     1193          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1194          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1195   ASSIGN
     1196          br-wp:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1
     1197          br-wp:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE
     1198          br-wp:COLUMN-MOVABLE IN FRAME Dialog-Frame         = TRUE.
     1199   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1200   DO:
     1201     APPLY "END-ERROR":U TO SELF.
     1202   END.
     1203   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1204   DO:
     1205     define variable loc#log as logical no-undo .
     1206     if available X_c-sr-izmerenia then do:
     1207   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1208   define variable v-str-recid10 as character no-undo .
     1209   define variable v-num-entry10 as integer   no-undo .
     1210   assign
     1211     v-str-recid10 = trim( string( recid( X_c-sr-izmerenia ) , "->>>>>>>>>>>9":U ) )
     1212     v-num-entry10 = lookup( v-str-recid10 , p-rid-list )
     1213   .
     1214   if v-num-entry10 > 0 then do:
     1215     assign
     1216       entry( v-num-entry10, p-rid-list ) = "":U
     1217       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1218     .
     1219   end.
     1220   else do:
     1221     assign
     1222       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid10
     1223     .
     1224   end.
     1225       loc#log = br-wp:refresh() .
     1226       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1227           loc#log = br-wp:select-next-row ().
     1228           apply "VALUE-CHANGED" to br-wp in frame Dialog-Frame.
     1229       end.
     1230       if num-entries( p-rid-list ) = 0
     1231       then
     1232           hide mark-num in frame Dialog-Frame.
     1233       else
     1234           disp num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
     1235     end.
     1236     apply "entry" to br-wp in frame Dialog-Frame.
     1237   END.
     1238   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1239   DO:
     1240       if ( available X_c-sr-izmerenia ) then do:
     1241       if  ( p-rid-list = "" ) or b-mark:sensitive = no
     1242       then
     1243       p-rid-list = string( recid( X_c-sr-izmerenia ) ) .
     1244     end.
     1245   END.
     1246   ON RETURN OF br-wp IN FRAME Dialog-Frame
     1247   or MOUSE-SELECT-DBLCLICK OF br-wp IN FRAME Dialog-Frame
     1248       DO:
     1249       run proc-br-wp no-error.
     1250     if error-status:error then return no-apply.
     1251   END.
     1252   ON VALUE-CHANGED OF br-wp IN FRAME Dialog-Frame
     1253   DO:
     1254     run proc-view-changes in this-procedure no-error.
     1255   END.
     1256   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1257   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1258   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1259   on help of frame Dialog-Frame
     1260   do:
     1261     run gbl/app_help.p
     1262       (input this-procedure :file-name
     1263       ,input ''
     1264       ,input ?
     1265       ) no-error.
     1266     if error-status :error then do:
     1267       message
     1268         "Ошибка при вызове помощи"
     1269         error-status :get-message(1)
     1270         view-as alert-box .
     1271     end.
     1272   end.
     1273   run minbtn-set in this-procedure .
     1274   on choose of b-help in frame Dialog-Frame
     1275   do:
     1276     apply "help":u to frame Dialog-Frame .
     1277   end.
     1278   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1279   procedure minbtn-set :
     1280       do
     1281           on error undo, return error return-value
     1282           :
     1283           define variable ii              as integer       no-undo .
     1284           define variable fh              as widget-handle no-undo .
     1285           define variable hh              as widget-handle no-undo .
     1286           define variable v-h             as handle        extent 4 no-undo .
     1287           define variable v-name-button   as character     no-undo .
     1288           define variable v-help-old-x    as decimal       no-undo .
     1289           define variable v-help-old-y    as decimal       no-undo .
     1290           define variable v-help-old-size as decimal       no-undo .
     1291           define variable v-frame-width   as decimal       no-undo .
     1292           define variable jj              as integer       no-undo .
     1293           do
     1294               on error undo, return error
     1295               :
     1296               assign
     1297                   v-frame-width = frame Dialog-Frame:width - 0.3
     1298                   fh            = frame Dialog-Frame:first-child
     1299                   hh            = fh:first-child
     1300                   ii            = 1
     1301                   .
     1302               do while valid-handle(hh):
     1303                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1304                   do:
     1305                       case lc(hh:name) :
     1306                           when "b-help" then
     1307                               do:
     1308                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1309                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1310                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1311                                   hh:TOOLTIP = "Помощь" .
     1312                                   v-help-old-x = hh:column .
     1313                                   v-help-old-y = hh:row    .
     1314                                   v-help-old-size = hh:width .
     1315                                   hh:width-chars = 2.5 .
     1316                               end.
     1317                           when "b-print" then
     1318                               do:
     1319                                   hh:load-image("cmp/b-print.bmp":u) .
     1320                                   hh:TOOLTIP = "Печать" .
     1321                                   v-h[ii] = hh:handle .
     1322                                   ii = ii + 1 .
     1323                                   hh:width-chars = 3 .
     1324                               end.
     1325                           when "b-history" or
     1326                           when "b-hist" then
     1327                               do:
     1328                                   hh:load-image("cmp/b-hist.bmp":u) .
     1329                                   hh:TOOLTIP = "История" .
     1330                                   v-h[ii] = hh:handle .
     1331                                   ii = ii + 1 .
     1332                                   hh:width-chars = 3 .
     1333                               end.
     1334                           when "b-sch" then
     1335                               do:
     1336                                   hh:load-image("cmp/b-sch.bmp":u) .
     1337                                   hh:TOOLTIP = "Установка Фильтра" .
     1338                                   v-h[ii] = hh:handle .
     1339                                   ii = ii + 1 .
     1340                                   hh:width-chars = 3 .
     1341                               end.
     1342                           when "b-hist-user" then
     1343                               do:
     1344                                   hh:load-image("cmp/b-hist.bmp":u) .
     1345                                   hh:TOOLTIP = "История пользователя" .
     1346                                   ii = ii + 1 .
     1347                               end.
     1348                       end case.
     1349                   end.
     1350                   hh = hh:next-sibling.
     1351               end.
     1352               b-help:column = v-frame-width - b-help:width-chars.
     1353               jj = 0.
     1354               repeat ii = 4 to 1 by -1 :
     1355                   if valid-handle (v-h[ii] ) then
     1356                   do:
     1357                       jj  = jj + 1 .
     1358                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1359                       v-h[ii]:row    = v-help-old-y .
     1360                   end.
     1361               end.
     1362           end.
     1363       end.
     1364   end procedure.
     1365   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1366   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1367   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1368   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1369   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1370   define variable v-diasize-current-frame-height as decimal   no-undo .
     1371   define variable v-diasize-change-size          as logical   no-undo .
     1372   define variable v-diasize-resize-button        as handle    no-undo .
     1373   define variable v-diasize-wndmax               as logical   no-undo .
     1374   define variable v-diasize-wndstore             as logical   no-undo .
     1375   define variable v-diasize-proc-name            as character no-undo .
     1376   define variable v-diasize-browse-handle        as handle    no-undo .
     1377   define variable v-diasize-browse-number        as integer   no-undo .
     1378   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1379   define temp-table temp-diasize-handle no-undo
     1380     field handle-value  as handle
     1381     field save-position as decimal
     1382     index xpk is primary unique handle-value
     1383     .
     1384   define temp-table temp-browse-handle no-undo
     1385     field browse-type   as character
     1386     field browse-number as integer
     1387     field browse-handle as handle
     1388     field original-size as decimal
     1389     index xpk is primary unique browse-type browse-number
     1390     index xie browse-type browse-handle
     1391   .
     1392   procedure diasize_change-height :
     1393     define input  parameter p-change-value  as decimal   no-undo .
     1394     define input  parameter p-move-resize   as logical   no-undo .
     1395     define variable v-field-group-handle    as handle    no-undo .
     1396     define variable v-object-handle         as handle    no-undo .
     1397     define variable v-frame-height          as decimal   no-undo .
     1398     define variable v-frame-virtual-height  as decimal   no-undo .
     1399     define variable v-browse-height         as decimal   no-undo .
     1400     define variable v-window-height         as decimal   no-undo .
     1401     define variable v-window-virtual-height as decimal   no-undo .
     1402     define variable v-change-sign           as integer   no-undo .
     1403     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1404     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1405     if p-change-value > 0
     1406     then do:
     1407       if frame Dialog-Frame :height + p-change-value
     1408           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1409       then do:
     1410         assign
     1411           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1412                           - (frame Dialog-Frame :height-chars)
     1413         .
     1414         if p-change-value <= 0
     1415         then do:
     1416           run diasize_position-resize-button in this-procedure .
     1417           return .
     1418         end.
     1419       end.
     1420     end.
     1421     if p-change-value < 0
     1422     then do:
     1423       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1424       then do:
     1425         assign
     1426           p-change-value = v-diasize-orig-frame-height
     1427                          - (frame Dialog-Frame :height-chars)
     1428         .
     1429         if p-change-value >= 0
     1430         then do:
     1431           run diasize_position-resize-button in this-procedure .
     1432           return .
     1433         end.
     1434       end.
     1435     end.
     1436     if p-change-value >= 0
     1437     then do:
     1438       assign
     1439         v-change-sign = 1
     1440       .
     1441     end.
     1442     else do:
     1443       assign
     1444         v-change-sign = -1
     1445       .
     1446     end.
     1447     assign
     1448       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1449     .
     1450     if p-change-value = 0
     1451     then do:
     1452       run diasize_position-resize-button in this-procedure .
     1453       return .
     1454     end.
     1455     move_block:
     1456     do
     1457     on error undo move_block, retry move_block
     1458     :
     1459       if retry
     1460       then do:
     1461         do
     1462         on error undo move_block, leave move_block
     1463         :
     1464           if p-change-value > 0
     1465           then do:
     1466             for each buf_temp-diasize-handle
     1467             on error undo, next
     1468             :
     1469               assign
     1470                 v-object-handle = buf_temp-diasize-handle.handle-value
     1471               .
     1472               if v-object-handle <> v-diasize-resize-button
     1473               then do:
     1474                 assign
     1475                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1476                 .
     1477               end.
     1478             end.
     1479             assign
     1480               v-diasize-browse-handle :height = v-browse-height
     1481             .
     1482             for each buf_temp-browse-handle
     1483               where buf_temp-browse-handle.browse-type = 'height':u
     1484             on error undo, next
     1485             :
     1486               assign
     1487                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1488               .
     1489             end.
     1490             assign
     1491               frame Dialog-Frame :height = v-frame-height
     1492             .
     1493             if frame Dialog-Frame :scrollable = true
     1494             then do:
     1495               assign
     1496                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1497               .
     1498             end.
     1499             run diasize_position-resize-button in this-procedure .
     1500           end.
     1501           else do:
     1502             if frame Dialog-Frame :scrollable = true
     1503             then do:
     1504               assign
     1505                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1506               .
     1507             end.
     1508             assign
     1509               frame Dialog-Frame :height = v-frame-height
     1510             .
     1511             assign
     1512               v-diasize-browse-handle :height = v-browse-height
     1513             .
     1514             for each buf_temp-browse-handle
     1515               where buf_temp-browse-handle.browse-type = 'height':u
     1516             on error undo, next
     1517             :
     1518               assign
     1519                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1520               .
     1521             end.
     1522             for each buf_temp-diasize-handle
     1523             on error undo, next
     1524             :
     1525               assign
     1526                 v-object-handle = buf_temp-diasize-handle.handle-value
     1527               .
     1528               if v-object-handle <> v-diasize-resize-button
     1529               then do:
     1530                 assign
     1531                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1532                 .
     1533               end.
     1534             end.
     1535             run diasize_position-resize-button in this-procedure .
     1536           end.
     1537           assign
     1538             v-diasize-change-size = false
     1539           .
     1540           leave move_block .
     1541         end.
     1542       end.
     1543       assign
     1544         v-diasize-need-full-display = true
     1545       .
     1546       if v-diasize-change-size = false
     1547       then do:
     1548         assign
     1549           v-diasize-change-size = true
     1550         .
     1551       end.
     1552       else do:
     1553         return .
     1554       end.
     1555       assign
     1556         v-frame-height = frame Dialog-Frame :height
     1557         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1558         v-browse-height = v-diasize-browse-handle :height
     1559       .
     1560       for each buf_temp-browse-handle
     1561         where buf_temp-browse-handle.browse-type = 'height':u
     1562       :
     1563         assign
     1564           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1565         .
     1566       end.
     1567       for each buf_temp-diasize-handle
     1568       :
     1569         delete buf_temp-diasize-handle .
     1570       end.
     1571       assign
     1572         v-field-group-handle = frame Dialog-Frame :first-child
     1573       .
     1574       do while valid-handle(v-field-group-handle)
     1575       :
     1576         assign
     1577           v-object-handle = v-field-group-handle :first-child
     1578         .
     1579         do while valid-handle(v-object-handle)
     1580         :
     1581           if  v-object-handle <> v-diasize-browse-handle :handle
     1582           and can-query(v-object-handle, "row")
     1583           and can-query(v-object-handle, "height")
     1584           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1585           then do:
     1586             find first buf_temp-browse-handle
     1587               where buf_temp-browse-handle.browse-type   = 'height':u
     1588                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1589               no-error .
     1590             if available buf_temp-browse-handle
     1591             then do:
     1592             end.
     1593             else do:
     1594               create buf_temp-diasize-handle .
     1595               assign
     1596                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1597                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1598               .
     1599             end.
     1600           end.
     1601           assign
     1602             v-object-handle = v-object-handle :next-sibling
     1603           .
     1604         end.
     1605         assign
     1606           v-field-group-handle = v-field-group-handle :next-sibling
     1607         .
     1608       end.
     1609       do with frame Dialog-Frame
     1610       :
     1611         hide v-diasize-resize-button .
     1612         assign
     1613           v-diasize-resize-button :row    = 1
     1614           v-diasize-resize-button :column = 1
     1615         .
     1616       end.
     1617       if p-change-value > 0
     1618       then do:
     1619         if frame Dialog-Frame :scrollable = true
     1620         then do:
     1621           assign
     1622             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1623             no-error .
     1624           if error-status :error
     1625           or error-status :get-message(1) <> ""
     1626           then do:
     1627             undo move_block, retry move_block .
     1628           end.
     1629         end.
     1630         assign
     1631           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1632           no-error .
     1633         if error-status :error
     1634         or error-status :get-message(1) <> ""
     1635         then do:
     1636           undo move_block, retry move_block .
     1637         end.
     1638         assign
     1639           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1640           no-error .
     1641         if error-status :error
     1642         or error-status :get-message(1) <> ""
     1643         then do:
     1644           undo move_block, retry move_block .
     1645         end.
     1646         for each buf_temp-browse-handle
     1647           where buf_temp-browse-handle.browse-type = 'height':u
     1648         on error undo move_block, retry move_block
     1649         :
     1650           assign
     1651             buf_temp-browse-handle.browse-handle :height
     1652               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1653             no-error .
     1654           if error-status :error
     1655           or error-status :get-message(1) <> ""
     1656           then do:
     1657             undo move_block, retry move_block .
     1658           end.
     1659         end.
     1660         for each buf_temp-diasize-handle
     1661         on error undo move_block, retry move_block
     1662         :
     1663           assign
     1664             v-object-handle = buf_temp-diasize-handle.handle-value
     1665           .
     1666           if v-object-handle <> v-diasize-resize-button
     1667           then do:
     1668             assign
     1669               v-object-handle :row = v-object-handle :row + p-change-value
     1670               no-error .
     1671             if error-status :error
     1672             or error-status :get-message(1) <> ""
     1673             then do:
     1674               undo move_block, retry move_block .
     1675             end.
     1676           end.
     1677         end.
     1678       end.
     1679       else do:
     1680         for each buf_temp-diasize-handle
     1681         on error undo move_block, retry move_block
     1682         :
     1683           assign
     1684             v-object-handle = buf_temp-diasize-handle.handle-value
     1685           .
     1686           if v-object-handle <> v-diasize-resize-button
     1687           then do:
     1688             assign
     1689               v-object-handle :row = v-object-handle :row + p-change-value
     1690               no-error .
     1691             if error-status :error
     1692             or error-status :get-message(1) <> ""
     1693             then do:
     1694               undo move_block, retry move_block .
     1695             end.
     1696           end.
     1697         end.
     1698         assign
     1699           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1700           no-error .
     1701         if error-status :error
     1702         or error-status :get-message(1) <> ""
     1703         then do:
     1704           undo move_block, retry move_block .
     1705         end.
     1706         for each buf_temp-browse-handle
     1707           where buf_temp-browse-handle.browse-type = 'height':u
     1708         on error undo move_block, retry move_block
     1709         :
     1710           assign
     1711             buf_temp-browse-handle.browse-handle :height
     1712               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1713             no-error .
     1714           if error-status :error
     1715           or error-status :get-message(1) <> ""
     1716           then do:
     1717             undo move_block, retry move_block .
     1718           end.
     1719         end.
     1720         assign
     1721           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1722           no-error .
     1723         if error-status :error
     1724         or error-status :get-message(1) <> ""
     1725         then do:
     1726           undo move_block, retry move_block .
     1727         end.
     1728         if frame Dialog-Frame :scrollable = true
     1729         then do:
     1730           assign
     1731             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1732             no-error .
     1733           if error-status :error
     1734           or error-status :get-message(1) <> ""
     1735           then do:
     1736             undo move_block, retry move_block .
     1737           end.
     1738         end.
     1739       end.
     1740       if p-move-resize = true
     1741       then do:
     1742         run diasize_position-resize-button in this-procedure .
     1743       end.
     1744       if v-diasize-wndstore = true
     1745       then do:
     1746         if connected("ub") = true
     1747         then do:
     1748           define variable v-cntxt-db-num        as integer   no-undo .
     1749           define variable v-cntxt-userid        as character no-undo .
     1750           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1751                                             , OUTPUT v-cntxt-userid
     1752                                             ) .
     1753           run gbl/wndsizew.p
     1754             (input  v-cntxt-db-num
     1755             ,input  v-cntxt-userid
     1756             ,input  v-diasize-proc-name
     1757             ,input  'height':u
     1758             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1759             ) .
     1760         end.
     1761       end.
     1762     end.
     1763     assign
     1764       v-diasize-change-size = false
     1765     .
     1766   end procedure.
     1767   procedure diasize_set-height :
     1768     define input  parameter p-new-height  as decimal   no-undo .
     1769     define input  parameter p-move-resize as logical   no-undo .
     1770     do
     1771     on error undo, return error return-value
     1772     :
     1773       run diasize_change-height in this-procedure
     1774         (input  (p-new-height - frame Dialog-Frame :height)
     1775         ,input  p-move-resize
     1776         ) .
     1777     end.
     1778   end procedure.
     1779   procedure diasize_change-width :
     1780     define input  parameter p-change-value as decimal   no-undo .
     1781     define input  parameter p-move-resize  as logical   no-undo .
     1782     define variable v-field-group-handle   as handle    no-undo .
     1783     define variable v-object-handle        as handle    no-undo .
     1784     define variable v-frame-width          as decimal   no-undo .
     1785     define variable v-frame-virtual-width  as decimal   no-undo .
     1786     define variable v-browse-width         as decimal   no-undo .
     1787     define variable v-window-width         as decimal   no-undo .
     1788     define variable v-window-virtual-width as decimal   no-undo .
     1789     define variable v-change-sign          as integer   no-undo .
     1790     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1791     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1792     if p-change-value > 0
     1793     then do:
     1794       if frame Dialog-Frame :width + p-change-value >
     1795           session :width-chars
     1796       then do:
     1797         assign
     1798           p-change-value = session :width-chars - frame Dialog-Frame :width
     1799         .
     1800         if p-change-value <= 0
     1801         then do:
     1802           run diasize_position-resize-button in this-procedure .
     1803           return .
     1804         end.
     1805       end.
     1806     end.
     1807     if p-change-value < 0
     1808     then do:
     1809       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1810       then do:
     1811         assign
     1812           p-change-value = v-diasize-orig-frame-width
     1813                          - frame Dialog-Frame :width
     1814         .
     1815         if p-change-value >= 0
     1816         then do:
     1817           run diasize_position-resize-button in this-procedure .
     1818           return .
     1819         end.
     1820       end.
     1821     end.
     1822     if p-change-value >= 0
     1823     then do:
     1824       assign
     1825         v-change-sign = 1
     1826       .
     1827     end.
     1828     else do:
     1829       assign
     1830         v-change-sign = -1
     1831       .
     1832     end.
     1833     assign
     1834       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1835     .
     1836     if p-change-value = 0
     1837     then do:
     1838       run diasize_position-resize-button in this-procedure .
     1839       return .
     1840     end.
     1841     move_block:
     1842     do
     1843     on error undo move_block, leave move_block
     1844     :
     1845       if retry
     1846       then do:
     1847         do
     1848         on error undo move_block, leave move_block
     1849         :
     1850           if p-change-value > 0
     1851           then do:
     1852             for each buf_temp-diasize-handle
     1853             on error undo, next
     1854             :
     1855               assign
     1856                 v-object-handle = buf_temp-diasize-handle.handle-value
     1857               .
     1858               if v-object-handle <> v-diasize-resize-button
     1859               then do:
     1860                 assign
     1861                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1862                 .
     1863               end.
     1864             end.
     1865             assign
     1866               v-diasize-browse-handle :width = v-browse-width
     1867             .
     1868             for each buf_temp-browse-handle
     1869               where buf_temp-browse-handle.browse-type = 'width':u
     1870             on error undo, next
     1871             :
     1872               assign
     1873                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1874               .
     1875             end.
     1876             assign
     1877               frame Dialog-Frame :width = v-frame-width
     1878             .
     1879             if frame Dialog-Frame :scrollable = true
     1880             then do:
     1881               assign
     1882                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1883               .
     1884             end.
     1885             run diasize_position-resize-button in this-procedure .
     1886           end.
     1887           else do:
     1888             if frame Dialog-Frame :scrollable = true
     1889             then do:
     1890               assign
     1891                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1892               .
     1893             end.
     1894             assign
     1895               frame Dialog-Frame :width = v-frame-width
     1896             .
     1897             for each buf_temp-browse-handle
     1898               where buf_temp-browse-handle.browse-type = 'width':u
     1899             on error undo, next
     1900             :
     1901               assign
     1902                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1903               .
     1904             end.
     1905             assign
     1906               v-diasize-browse-handle :width = v-browse-width
     1907             .
     1908             for each buf_temp-diasize-handle
     1909             on error undo, next
     1910             :
     1911               assign
     1912                 v-object-handle = buf_temp-diasize-handle.handle-value
     1913               .
     1914               if v-object-handle <> v-diasize-resize-button
     1915               then do:
     1916                 assign
     1917                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1918                 .
     1919               end.
     1920             end.
     1921             run diasize_position-resize-button in this-procedure .
     1922           end.
     1923           assign
     1924             v-diasize-change-size = false
     1925           .
     1926           leave move_block .
     1927         end.
     1928       end.
     1929       assign
     1930         v-diasize-need-full-display = true
     1931       .
     1932       if v-diasize-change-size = false
     1933       then do:
     1934         assign
     1935           v-diasize-change-size = true
     1936         .
     1937       end.
     1938       else do:
     1939         return .
     1940       end.
     1941       assign
     1942         v-frame-width = frame Dialog-Frame :width
     1943         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1944         v-browse-width = v-diasize-browse-handle :width
     1945       .
     1946       for each buf_temp-browse-handle
     1947         where buf_temp-browse-handle.browse-type = 'width':u
     1948       :
     1949         assign
     1950           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1951         .
     1952       end.
     1953       for each buf_temp-diasize-handle
     1954       :
     1955         delete buf_temp-diasize-handle .
     1956       end.
     1957       assign
     1958         v-field-group-handle = frame Dialog-Frame :first-child
     1959       .
     1960       do while valid-handle(v-field-group-handle)
     1961       :
     1962         assign
     1963           v-object-handle = v-field-group-handle :first-child
     1964         .
     1965         do while valid-handle(v-object-handle)
     1966         :
     1967           if  v-object-handle <> v-diasize-browse-handle :handle
     1968           and v-object-handle <> v-diasize-resize-button
     1969           and can-query(v-object-handle, "row")
     1970           and can-query(v-object-handle, "height")
     1971           and ( v-object-handle :col + v-object-handle :width
     1972                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1973               )
     1974           then do:
     1975             find first buf_temp-browse-handle
     1976               where buf_temp-browse-handle.browse-type   = 'width':u
     1977                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1978               no-error .
     1979             if available buf_temp-browse-handle
     1980             then do:
     1981             end.
     1982             else do:
     1983               create buf_temp-diasize-handle .
     1984               assign
     1985                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1986                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1987               .
     1988             end.
     1989           end.
     1990           assign
     1991             v-object-handle = v-object-handle :next-sibling
     1992           .
     1993         end.
     1994         assign
     1995           v-field-group-handle = v-field-group-handle :next-sibling
     1996         .
     1997       end.
     1998       do with frame Dialog-Frame
     1999       :
     2000         hide v-diasize-resize-button .
     2001         v-diasize-resize-button :row = 1.
     2002         v-diasize-resize-button :column = 1.
     2003       end.
     2004       if p-change-value > 0
     2005       then do:
     2006         if frame Dialog-Frame :scrollable = true
     2007         then do:
     2008           assign
     2009             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2010             no-error .
     2011           if error-status :error
     2012           or error-status :get-message(1) <> ""
     2013           then do:
     2014             undo move_block, retry move_block.
     2015           end.
     2016         end.
     2017         assign
     2018           frame Dialog-Frame :width = v-frame-width + p-change-value
     2019           no-error .
     2020         if error-status :error
     2021         or error-status :get-message(1) <> ""
     2022         then do:
     2023           undo move_block, retry move_block.
     2024         end.
     2025         assign
     2026           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2027         no-error .
     2028         if error-status :error
     2029         or error-status :get-message(1) <> ""
     2030         then do:
     2031           undo move_block, retry move_block.
     2032         end.
     2033         for each buf_temp-browse-handle
     2034           where buf_temp-browse-handle.browse-type = 'width':u
     2035         on error undo move_block, retry move_block
     2036         :
     2037           assign
     2038             buf_temp-browse-handle.browse-handle :width
     2039               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2040             no-error .
     2041           if error-status :error
     2042           or error-status :get-message(1) <> ""
     2043           then do:
     2044             undo move_block, retry move_block .
     2045           end.
     2046         end.
     2047         for each buf_temp-diasize-handle
     2048         on error undo move_block, retry move_block
     2049         :
     2050           assign
     2051             v-object-handle = buf_temp-diasize-handle.handle-value
     2052           .
     2053           if v-object-handle <> v-diasize-resize-button
     2054           then do:
     2055             assign
     2056               v-object-handle :col = v-object-handle :col + p-change-value
     2057               no-error .
     2058             if error-status :error
     2059             or error-status :get-message(1) <> ""
     2060             then do:
     2061               undo move_block, retry move_block .
     2062             end.
     2063           end.
     2064         end.
     2065       end.
     2066       else do:
     2067         for each buf_temp-diasize-handle
     2068         on error undo move_block, retry move_block
     2069         :
     2070           assign
     2071             v-object-handle = buf_temp-diasize-handle.handle-value
     2072           .
     2073           if v-object-handle <> v-diasize-resize-button
     2074           then do:
     2075             assign
     2076               v-object-handle :col = v-object-handle :col + p-change-value
     2077               no-error .
     2078             if error-status :error
     2079             or error-status :get-message(1) <> ""
     2080             then do:
     2081               undo move_block, retry move_block .
     2082             end.
     2083           end.
     2084         end.
     2085         for each buf_temp-browse-handle
     2086           where buf_temp-browse-handle.browse-type = 'width':u
     2087         on error undo move_block, retry move_block
     2088         :
     2089           assign
     2090             buf_temp-browse-handle.browse-handle :width
     2091               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2092             no-error .
     2093           if error-status :error
     2094           or error-status :get-message(1) <> ""
     2095           then do:
     2096             undo move_block, retry move_block .
     2097           end.
     2098         end.
     2099         assign
     2100           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2101           no-error .
     2102         if error-status :error
     2103         or error-status :get-message(1) <> ""
     2104         then do:
     2105           undo move_block, retry move_block.
     2106         end.
     2107         assign
     2108           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2109         no-error .
     2110         if error-status :error
     2111         or error-status :get-message(1) <> ""
     2112         then do:
     2113           undo move_block, retry move_block.
     2114         end.
     2115         if frame Dialog-Frame :scrollable = true
     2116         then do:
     2117           assign
     2118             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2119           no-error .
     2120           if error-status :error
     2121           or error-status :get-message(1) <> ""
     2122           then do:
     2123             undo move_block, retry move_block.
     2124           end.
     2125         end.
     2126       end.
     2127       if p-move-resize
     2128       then do:
     2129         run diasize_position-resize-button in this-procedure .
     2130       end.
     2131       if v-diasize-wndstore = true
     2132       then do:
     2133         if connected("ub") = true
     2134         then do:
     2135           define variable v-cntxt-db-num        as integer   no-undo .
     2136           define variable v-cntxt-userid        as character no-undo .
     2137           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2138                                             , OUTPUT v-cntxt-userid
     2139                                             ) .
     2140           run gbl/wndsizew.p
     2141             (input  v-cntxt-db-num
     2142             ,input  v-cntxt-userid
     2143             ,input  v-diasize-proc-name
     2144             ,input  'width':u
     2145             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2146             ) .
     2147         end.
     2148       end.
     2149     end.
     2150     assign
     2151       v-diasize-change-size = false
     2152     .
     2153   end procedure.
     2154   procedure diasize_set-width :
     2155     define input  parameter p-new-width  as decimal   no-undo .
     2156     define input  parameter p-move-resize as logical   no-undo .
     2157     do
     2158     on error undo, return error return-value
     2159     :
     2160       run diasize_change-width in this-procedure
     2161         (input  (p-new-width - frame Dialog-Frame :width)
     2162         ,input  p-move-resize
     2163         ) .
     2164     end.
     2165   end procedure.
     2166   procedure diasize_position-resize-button :
     2167     do with frame Dialog-Frame
     2168     :
     2169       hide v-diasize-resize-button .
     2170       assign
     2171         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2172                     - 1
     2173                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2174         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2175                     - 1
     2176                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2177       .
     2178       view v-diasize-resize-button .
     2179     end.
     2180   end procedure.
     2181   on alt-right anywhere
     2182   do:
     2183     run diasize_change-width in this-procedure
     2184       (input 1
     2185       ,input true
     2186       ) .
     2187     return no-apply .
     2188   end.
     2189   on alt-left anywhere
     2190   do:
     2191     run diasize_change-width in this-procedure
     2192       (input -1
     2193       ,input true
     2194       ) .
     2195     return no-apply .
     2196   end.
     2197   on alt-down anywhere
     2198   do:
     2199     run diasize_change-height in this-procedure
     2200       (input 1
     2201       ,input true
     2202       ) .
     2203     return no-apply .
     2204   end.
     2205   on alt-up anywhere
     2206   do:
     2207     run diasize_change-height in this-procedure
     2208       (input -1
     2209       ,input true
     2210       ) .
     2211     return no-apply .
     2212   end.
     2213   on alt-enter of frame Dialog-Frame
     2214   do:
     2215     run diasize_maximize in this-procedure
     2216       (input  ?
     2217       ).
     2218     return no-apply .
     2219   end.
     2220   procedure diasize_end-move :
     2221     do
     2222     on error undo, return error return-value
     2223     :
     2224       define variable v-row-delta as decimal   no-undo .
     2225       define variable v-col-delta as decimal   no-undo .
     2226       define variable v-new-row as decimal   no-undo .
     2227       define variable v-new-col as decimal   no-undo .
     2228       assign
     2229         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2230         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2231       .
     2232       assign
     2233         v-row-delta = v-new-row - frame Dialog-Frame :height
     2234         v-col-delta = v-new-col - frame Dialog-Frame :width
     2235       .
     2236       run diasize_change-height in this-procedure
     2237         (input v-row-delta
     2238         ,input true
     2239         ) .
     2240       run diasize_change-width in this-procedure
     2241         (input v-col-delta
     2242         ,input true
     2243         ) .
     2244     end.
     2245   end procedure.
     2246   procedure diasize_maximize :
     2247     define input  parameter p-action as logical   no-undo .
     2248     do
     2249     on error undo, return error return-value
     2250     :
     2251       if p-action = ?
     2252       then do:
     2253         if v-diasize-need-maximize = true
     2254         then do:
     2255           assign
     2256             p-action = true
     2257           .
     2258         end.
     2259         else do:
     2260           assign
     2261             p-action = false
     2262           .
     2263         end.
     2264       end.
     2265       if p-action = true
     2266       then do:
     2267         run diasize_change-height in this-procedure
     2268           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2269               - frame Dialog-Frame :height-chars
     2270           ,input true
     2271           ) .
     2272         run diasize_change-width in this-procedure
     2273           (input session :width-chars
     2274               - frame Dialog-Frame :width-chars
     2275           ,input true
     2276           ) .
     2277         assign
     2278           v-diasize-need-maximize = false
     2279         .
     2280       end.
     2281       else do:
     2282         run diasize_change-width in this-procedure
     2283           (input v-diasize-orig-frame-width
     2284               - frame Dialog-Frame :width-chars
     2285           ,input true
     2286           ) .
     2287         run diasize_change-height in this-procedure
     2288           (input v-diasize-orig-frame-height
     2289               - frame Dialog-Frame :height-chars
     2290           ,input true
     2291           ) .
     2292         assign
     2293           v-diasize-need-maximize = true
     2294         .
     2295       end.
     2296     end.
     2297   end procedure.
     2298   procedure diasize_restore-orig-size :
     2299     do
     2300     on error undo, return error return-value
     2301     :
     2302       assign
     2303         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2304         v-diasize-current-frame-height = frame Dialog-Frame :height
     2305       .
     2306       run diasize_set-height in this-procedure
     2307         (input  v-diasize-orig-frame-height
     2308         ,input  true
     2309         ) .
     2310       run diasize_set-width in this-procedure
     2311         (input  v-diasize-orig-frame-width
     2312         ,input  true
     2313         ) .
     2314     end.
     2315   end procedure.
     2316   procedure diasize_restore-current-size :
     2317     do
     2318     on error undo, return error return-value
     2319     :
     2320       run diasize_set-height in this-procedure
     2321         (input  v-diasize-current-frame-height
     2322         ,input  true
     2323         ) .
     2324       run diasize_set-width in this-procedure
     2325         (input  v-diasize-current-frame-width
     2326         ,input  true
     2327         ) .
     2328     end.
     2329   end procedure.
     2330   procedure diasize_set-browse-handle :
     2331     define input  parameter p-browse-handle as handle   no-undo .
     2332     define buffer buf_temp-browse-handle for temp-browse-handle .
     2333     do
     2334     on error undo, return error return-value
     2335     :
     2336       assign
     2337         v-diasize-browse-handle = p-browse-handle
     2338       .
     2339       for each buf_temp-browse-handle
     2340       on error undo, return error return-value
     2341       :
     2342         delete buf_temp-browse-handle .
     2343       end.
     2344     end.
     2345   end procedure.
     2346   procedure diasize_add_browse :
     2347     define input  parameter p-browse-type   as character no-undo .
     2348     define input  parameter p-browse-handle as handle    no-undo .
     2349     define buffer buf_temp-browse-handle for temp-browse-handle .
     2350     do
     2351     on error undo, return error return-value
     2352     :
     2353       assign
     2354         v-diasize-browse-number = v-diasize-browse-number + 1
     2355       .
     2356       create buf_temp-browse-handle .
     2357       assign
     2358         buf_temp-browse-handle.browse-type   = p-browse-type
     2359         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2360         buf_temp-browse-handle.browse-handle = p-browse-handle
     2361       .
     2362     end.
     2363   end procedure.
     2364   procedure diasize_init :
     2365     define variable v-default-value    as logical   no-undo .
     2366     define variable v-restore-saved    as logical   no-undo .
     2367     define variable v-resize-value-str as character no-undo .
     2368     do
     2369     on error undo, return error return-value
     2370     :
     2371       do with frame Dialog-Frame
     2372       :
     2373         assign
     2374           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2375           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2376           v-diasize-browse-handle     = browse br-wp :handle
     2377         .
     2378         create button v-diasize-resize-button
     2379         assign
     2380           parent        = frame Dialog-Frame :first-child
     2381           label         = "s"
     2382           height-pixels = 16
     2383           width-pixels  = 16
     2384           visible       = true
     2385           sensitive     = true
     2386           movable       = true
     2387           triggers:
     2388             on end-move persistent run diasize_end-move in this-procedure .
     2389           end triggers.
     2390         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2391         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2392         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2393         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2394         assign
     2395           v-diasize-wndmax = false
     2396         .
     2397         if connected("ub") = true
     2398         then do:
     2399           define variable v-cntxt-db-num        as integer   no-undo .
     2400           define variable v-cntxt-userid        as character no-undo .
     2401           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2402                                             , OUTPUT v-cntxt-userid
     2403                                             ) .
     2404           run gbl/wndpar_r.p
     2405             (input  v-cntxt-db-num
     2406             ,input  v-cntxt-userid
     2407             ,input  'wndmax':U
     2408             ,output v-diasize-wndmax
     2409             ,output v-default-value
     2410             ) .
     2411         end.
     2412         assign
     2413           v-diasize-wndstore = false
     2414         .
     2415         if connected("ub") = true
     2416         then do:
     2417           run gbl/wndpar_r.p
     2418             (input  v-cntxt-db-num
     2419             ,input  v-cntxt-userid
     2420             ,input  'wndstore':U
     2421             ,output v-diasize-wndstore
     2422             ,output v-default-value
     2423             ) .
     2424         end.
     2425         assign
     2426           v-diasize-proc-name = entry(1, program-name(2), '.')
     2427         .
     2428         if v-diasize-wndstore = true
     2429         then do:
     2430           assign
     2431             v-restore-saved = false
     2432           .
     2433           if connected("ub") = true
     2434           then do:
     2435             run gbl/wndsizer.p
     2436               (input  v-cntxt-db-num
     2437               ,input  v-cntxt-userid
     2438               ,input  v-diasize-proc-name
     2439               ,input  'height':u
     2440               ,output v-resize-value-str
     2441               ) .
     2442             if v-resize-value-str <> '':U
     2443             then do:
     2444               run diasize_change-height in this-procedure
     2445                 (input  integer(v-resize-value-str)
     2446                 ,input  true
     2447                 ) .
     2448               assign
     2449                 v-restore-saved = true
     2450               .
     2451             end.
     2452           end.
     2453           if connected("ub") = true
     2454           then do:
     2455             run gbl/wndsizer.p
     2456               (input  v-cntxt-db-num
     2457               ,input  v-cntxt-userid
     2458               ,input  v-diasize-proc-name
     2459               ,input  'width':u
     2460               ,output v-resize-value-str
     2461               ) .
     2462             if v-resize-value-str <> '':U
     2463             then do:
     2464               run diasize_change-width in this-procedure
     2465                 (input  integer(v-resize-value-str)
     2466                 ,input  true
     2467                 ) .
     2468               assign
     2469                 v-restore-saved = true
     2470               .
     2471             end.
     2472           end.
     2473           if v-restore-saved <> true
     2474           then do:
     2475             if v-diasize-wndmax = true
     2476             then do:
     2477               run diasize_maximize in this-procedure
     2478                 (input  true
     2479                 ) .
     2480             end.
     2481           end.
     2482         end.
     2483         else do:
     2484           if v-diasize-wndmax = true
     2485           then do:
     2486             run diasize_maximize in this-procedure
     2487               (input  true
     2488               ) .
     2489           end.
     2490         end.
     2491       end.
     2492     end.
     2493   end procedure.
     2494   procedure diasize_need-full-display :
     2495     define output parameter p-need-full-display as logical   no-undo .
     2496     do
     2497     on error undo, return error return-value
     2498     :
     2499       assign
     2500         p-need-full-display = v-diasize-need-full-display
     2501       .
     2502       assign
     2503         v-diasize-need-full-display = false
     2504       .
     2505     end.
     2506   end procedure.
     2507   procedure get-context :
     2508      define output parameter p-db-num as integer          no-undo.
     2509      define output parameter p-user-id as character        no-undo.
     2510      define variable v-login               as character    no-undo.
     2511      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2512      define buffer buf_user-login  for ub.user-login .
     2513      do
     2514      on error undo, return error
     2515      :
     2516            FIND FIRST buf_sys-ctrl no-lock.
     2517            ASSIGN
     2518               v-login = USERID("ub")
     2519               p-db-num = buf_sys-ctrl.db-num
     2520            .
     2521            FIND FIRST buf_user-login
     2522                 WHERE buf_user-login.db-num = p-db-num
     2523                   AND buf_user-login.user-login = v-login
     2524                 no-lock
     2525                 no-error
     2526                 .
     2527            IF AVAILABLE buf_user-login
     2528            THEN DO:
     2529               assign
     2530                  p-user-id = buf_user-login.user-id
     2531               .
     2532            END.
     2533      end.
     2534   end procedure.
     2535   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2536   on f5 of frame Dialog-Frame anywhere
     2537   do:
     2538       v-doc-rec = recid(X_c-sr-izmerenia).
     2539       run openbr in this-procedure.
     2540       reposition br-wp to recid v-doc-rec no-error.
     2541       apply 'value-changed' to br-wp.
     2542       apply "VALUE-CHANGED" to BR-changes.
     2543   end.
     2544   def var sort-labelbr-wp   as character no-undo .
     2545   def var sort-clmnbr-wp    as handle    no-undo .
     2546   def var cur-clmnbr-wp     as handle    no-undo .
     2547   def var cur-clmn-locbr-wp as integer   no-undo .
     2548   def var re-querybr-wp     as logical   initial no no-undo .
     2549   on start-search, ctrl-o of br-wp in frame Dialog-Frame do:
     2550      run sort-brbr-wp
     2551        (input (if available temp-changes
     2552                then recid(temp-changes)
     2553                else ?
     2554               )
     2555        ).
     2556   end.
     2557   PROCEDURE sort-brbr-wp :
     2558     define input parameter p-recid as recid no-undo .
     2559     if re-querybr-wp = no then do:
     2560       assign
     2561          cur-clmnbr-wp = br-wp:current-column in frame Dialog-Frame
     2562       .
     2563       if sort-clmnbr-wp <> ? then sort-clmnbr-wp:column-fgcolor = 0.
     2564       if cur-clmnbr-wp = sort-clmnbr-wp then do:
     2565         assign
     2566            sort-labelbr-wp = ""
     2567            sort-clmnbr-wp = ?
     2568         .
     2569        end.
     2570        else do:
     2571          assign
     2572            sort-labelbr-wp = cur-clmnbr-wp:label
     2573            sort-clmnbr-wp  = cur-clmnbr-wp
     2574            sort-clmnbr-wp:column-fgcolor = 4
     2575          .
     2576        end.
     2577      end.
     2578     assign
     2579       cur-clmn-locbr-wp = 1
     2580     .
     2581     def var column-handle as handle no-undo .
     2582     column-handle = br-wp:first-column.
     2583     do while valid-handle(column-handle) :
     2584       if column-handle = cur-clmnbr-wp then do:
     2585         leave .
     2586       end.
     2587       column-handle = column-handle:NEXT-COLUMN.
     2588       assign
     2589         cur-clmn-locbr-wp = cur-clmn-locbr-wp + 1
     2590       .
     2591     end.
     2592     case sort-labelbr-wp:
     2593           when X_c-sr-izmerenia.sr-model:label in browse br-wp then DO:   assign     sort-column-name = "X_c-sr-izmerenia.sr-model"   .   run OpenBr.   . END.
     2594           when X_c-sr-izmerenia.corr-date:label in browse br-wp then DO:   assign     sort-column-name = "X_c-sr-izmerenia.corr-date"   .   run OpenBr.   . END.
     2595       otherwise do:
     2596         assign
     2597           sort-column-name = ""
     2598         .
     2599         run OpenBr.
     2600           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-wp') then do:
     2601             run mv-brw-defaultbr-wp.
     2602           end.
     2603         if sort-labelbr-wp <> "" then do:
     2604           assign
     2605             cur-clmnbr-wp:column-fgcolor = 0
     2606           .
     2607         end.
     2608         assign
     2609           cur-clmn-locbr-wp = ?
     2610         .
     2611       end.
     2612     end case.
     2613       if cur-clmn-locbr-wp <> ? then do:
     2614         if can-do( this-procedure:internal-entries, 'ch-clmnbr-wp') then do:
     2615           run ch-clmnbr-wp in this-procedure (cur-clmn-locbr-wp).
     2616         end.
     2617       end.
     2618     if p-recid <> ? then do:
     2619       reposition br-wp to recid p-recid no-error.
     2620       apply "value-changed" to br-wp in frame Dialog-Frame.
     2621     end.
     2622     apply "entry" to br-wp in frame Dialog-Frame.
     2623   END PROCEDURE.
     2624   procedure re-open-query-srt-clmnbr-wp:
     2625   if cur-clmnbr-wp = ? then do:
     2626      run OpenBr.
     2627   end.
     2628   else do:
     2629      assign re-querybr-wp = yes.
     2630      run sort-brbr-wp
     2631        (input (if available temp-changes
     2632                then recid(temp-changes)
     2633                else ?
     2634               )
     2635        ).
     2636      assign re-querybr-wp = no.
     2637   end.
     2638   end.
     2639   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2640   do:
     2641     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2642   end.
     2643   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2644   on INS of frame Dialog-Frame anywhere do:
     2645     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2646     return no-apply.
     2647   end.
     2648   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2649   on F2 of frame Dialog-Frame anywhere do:
     2650     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2651     return no-apply.
     2652   end.
     2653   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2654   on F2 of frame Dialog-Frame anywhere do:
     2655     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2656     return no-apply.
     2657   end.
     2658   MAIN-BLOCK:
     2659   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2660      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2661    if LOOKUP(p-mode, 'one':U, chr(4)) = 0 then dO:
     2662       message
     2663       vss-workfile vss-revision vss-description skip
     2664       "Неверное значение параметров вызова p-mode"
     2665       p-mode
     2666       view-as alert-box ERROR.
     2667       return error .
     2668    end.
     2669    if p-mode = "one":U then do:
     2670      find first X_c-sr-izmerenia no-lock
     2671           where X_c-sr-izmerenia.node-code = p-node-code no-error.
     2672       if not available X_c-sr-izmerenia then do:
     2673           message
     2674           vss-workfile vss-revision vss-description skip
     2675           substitute("Отсутствует история средства измерения с кодом &1", p-node-code)
     2676           view-as alert-box ERROR.
     2677           return.
     2678       end.
     2679     end.
     2680     RUN MyEnable.
     2681     RUn OpenBR.
     2682     HIDE mark-num in frame Dialog-Frame .
     2683     if v-doc-rec <> ? then
     2684     REPOSITION br-wp to recid v-doc-rec No-ERROR.
     2685    run diasize_add_browse in this-procedure
     2686       (input  'width':u
     2687       ,input  browse br-changes :handle
     2688       ) .
     2689    run diasize_init in this-procedure .
     2690   WAIT-FOR GO OF FRAME Dialog-Frame.
     2691   END.
     2692   RUN disable_UI.
     2693   PROCEDURE disable_UI :
     2694     HIDE FRAME Dialog-Frame.
     2695   END PROCEDURE.
     2696   PROCEDURE enable_UI :
     2697     DISPLAY mark-num
     2698         WITH FRAME Dialog-Frame.
     2699     ENABLE b-quit B-mark B-sel B-Help br-wp BR-changes mark-num
     2700         WITH FRAME Dialog-Frame.
     2701     VIEW FRAME Dialog-Frame.
     2702     OPEN QUERY br-wp FOR EACH X_c-sr-izmerenia NO-LOCK INDEXED-REPOSITION.
     2703   END PROCEDURE.
     2704   PROCEDURE MyEnable :
     2705   assign
     2706   temp-changes.l_name:resizable in browse br-changes = true
     2707   temp-changes.v_old:resizable in browse br-changes = true
     2708   temp-changes.v_new:resizable in browse br-changes = true
     2709   temp-changes.l_name:width in browse br-changes = 30
     2710   temp-changes.v_old:width in browse br-changes = 40
     2711   temp-changes.v_new:width in browse br-changes = 40
     2712   .
     2713   DISPLAY mark-num
     2714   WITH FRAME Dialog-Frame.
     2715   ENABLE
     2716   b-quit
     2717   B-mark when LOOKUP("b-mark":U, bttns) > 0
     2718   B-sel when LOOKUP("b-sel":U, bttns) > 0
     2719   B-Help
     2720   br-wp mark-num
     2721   br-changes
     2722   with FRAME Dialog-Frame.
     2723   VIEW FRAME Dialog-Frame.
     2724   END PROCEDURE.
     2725   PROCEDURE OpenBr :
     2726   define variable v-host-code as integer no-undo .
     2727   OPEN QUERY br-wp FOR EACH X_c-sr-izmerenia NO-LOCK
     2728                       where X_c-sr-izmerenia.node-code = p-node-code
     2729                                 INDEXED-REPOSITION.
     2730   APPLY "VALUE-CHANGED" TO br-wp in frame Dialog-Frame.
     2731   APPLY "ENTRY" TO br-wp.
     2732   END PROCEDURE.
     2733   PROCEDURE proc-br-wp :
     2734   END PROCEDURE.
     2735   PROCEDURE proc-view-changes :
     2736   define variable v-label-param as character no-undo .
     2737   v-label-param =   "node-code" + chr(4) + "Код средства измерения" + chr(4) + ""
     2738    + chr(8) + "sr-model"  + chr(4) + "Модель" + chr(4) + ""
     2739    + chr(8) + "sr-type-id"  + chr(4) + "Тип" + chr(4) + ""
     2740    + chr(8) + "sr-temp-line"  + chr(4) + "Температурный коэффициент линейного расширения материала средства измерения уровня" + chr(4) + ""
     2741    + chr(8) + "sr-abs-err-neft-water"  + chr(4) + "Абсолютная погрешность измерений уровня нефтепродукта и подтоварной воды" + chr(4) + ""
     2742    + chr(8) + "sr-abs-err-water"  + chr(4) + "Абсолютная погрешность измерений уровня подтоварной воды" + chr(4) + ""
     2743    + chr(8) + "sr-abs-err-dens"  + chr(4) + "Абсолютная погрешность измерений плотности нефтепродукта ареометром" + chr(4) + ""
     2744    + chr(8) + "sr-abs-err-temp-vol"  + chr(4) + "Абсолютная погрешность измерений температуры нефтепродукта при измерении его объема" + chr(4) + ""
     2745    + chr(8) + "sr-abs-err-temp-dens"  + chr(4) + "Абсолютная погрешность измерений температуры нефтепродукта при измерении его плотности" + chr(4) + ""
     2746    + chr(8) + "sr-otnos"  + chr(4) + "Предел допускаемой относительной погрешности средства обработки результатов измерений" + chr(4) + ""
     2747   .
     2748    run proc-full-temp-changes in this-procedure (
     2749                                                input  buffer X_c-sr-izmerenia:handle
     2750                                               ,input  'sr-izmerenia':U
     2751                                               ,input  "node-code,sr-model,sr-type-id,sr-temp-line,sr-abs-err-neft-water,sr-abs-err-water,sr-abs-err-dens,sr-abs-err-temp-vol,sr-abs-err-temp-dens,sr-otnos"
     2752                                               ,input  v-label-param).
     2753   Open QUery br-changes for each temp-changes.
     2754   END PROCEDURE.
