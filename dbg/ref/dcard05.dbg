        1   block-level on error undo, throw.
        2   define input parameter p-d-card                 like ub.dis-card.d-card no-undo .
        3   define input parameter p-type                   like ub.dis-card.type no-undo .
        4   define input parameter p-emitent-host-code      like ub.dis-card.emitent-host-code no-undo .
        5   define input parameter p-issue-code             like ub.dis-card.issue-code no-undo .
        6   define output parameter p-cli-mask              like ub.dis-card-mask.cli-mask no-undo .
        7   define output parameter p-full-number           like ub.dis-card.d-card no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: dcard05.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: ref/dcard05.p $":U .
       13   define variable vss-description as character no-undo init "Определение полного номера карты по первой подходящей маске для данной карты".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32       assign
       33         p-vss-parameters = substitute('&1|&2|&3|&4':u,p-d-card,p-type,p-emitent-host-code,p-issue-code)
       34       .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define variable v-host-code like ub.sysconf.host-code no-undo .
       78   define variable v-descr     as character no-undo .
       79   define variable v-is-correct as logical no-undo .
       80   define variable v-found      as logical no-undo .
       81   define variable v-type       as character no-undo .
       82   define variable v-d-str   as character no-undo .
       83   define variable ii as integer no-undo .
       84   define variable v-cli-mask as character no-undo .
       85   define variable v-full-number as character no-undo .
       86   define buffer buf_dis-card-mask for ub.dis-card-mask.
       87   do
       88   on error undo, return error substitute("&1 &2 &3:&4&5 &6"
       89                                           , vss-workfile
       90                                           , vss-revision
       91                                           , vss-description
       92                                           , chr(10)
       93                                           , error-status:get-message(1)
       94                                           , return-value )
       95   :
       96   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       97   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
       98     (input  'маг':U
       99     ,input  p-issue-code
      100     ,output v-host-code
      101     )  .
      102     _maska:
      103     for each buf_dis-card-mask no-lock where
      104             buf_dis-card-mask.emitent-host-code = p-emitent-host-code
      105         AND buf_dis-card-mask.type              = p-type
      106         AND buf_Dis-card-mask.stts              = integer('0':U)
      107     by buf_Dis-card-mask.host-code
      108     by buf_Dis-card-mask.obj-type
      109     by buf_Dis-card-mask.obj-code
      110     by buf_Dis-card-mask.rank:
      111       if index(buf_Dis-card-mask.cli-mask, 'D':U) = 0 then next.
      112       if index(buf_Dis-card-mask.cli-mask, chr(63)) > 0 then next.
      113       if buf_dis-card-mask.host-code <> 0
      114       And buf_dis-card-mask.host-code <> v-host-code then next.
      115       if
      116       buf_dis-card-mask.obj-type <> "":U
      117       AND
      118          (buf_dis-card-mask.obj-type <> 'маг':U
      119       or buf_dis-card-mask.obj-code <> p-issue-code) then NEXT.
      120       if buf_Dis-card-mask.use-on = integer('2':U) then NEXT.
      121       assign
      122       v-found = yes
      123       v-descr = "":U
      124       .
      125       assign
      126       v-cli-mask =  buf_dis-card-mask.cli-mask
      127       v-is-correct = ((num-entries(v-cli-mask, 'D') - 1) = length(p-d-card))
      128       no-error
      129       .
      130       if v-is-correct then do:
      131         assign
      132         v-full-number = v-cli-mask
      133         .
      134         do ii = 1 to length(p-d-card):
      135           substring(v-full-number, index(v-full-number, 'D'), 1)  =  substring(p-d-card, ii, 1).
      136         end.
      137         if index(v-full-number, 'C') > 0 then do:
      138           case buf_dis-card-mask.cc-run:
      139             when integer('1':U) then do:
      140               run gbl/pluhnalg.p ( input v-full-number, output p-full-number) no-error .
      141               if error-status:error then do:
      142                 undo, return error substitute("Ошибка при определении КЦ полного номера карты &1 по маске &2:&3&4&3&5"
      143                                                 , p-d-card
      144                                                 , v-cli-mask
      145                                                 , chr(10)
      146                                                 , error-status:get-message(1)
      147                                                 , return-value ).
      148               end.
      149             end.
      150             otherwise do:
      151               undo, return error substitute("Ошибка при определении полного номера карты &1 по маске &2:&3" +
      152                                           "Не задан алгоритм расчета КЦ"
      153                                           , p-d-card
      154                                           , v-cli-mask
      155                                           , chr(10)
      156                                           ).
      157             end.
      158           end case.
      159         end.
      160         else do:
      161           p-full-number = v-full-number.
      162         end.
      163         p-cli-mask = v-cli-mask.
      164         return .
      165       end.
      166     end.
      167     if not v-found then do:
      168       return substitute("Не удалось определить ПОЛНЫЙ номер ДК&5Для карты &1 (тип &2 эмитент &3) не определено ни одной действующей маски, для объекта выдачи карты маг&4"
      169                                     , p-d-card
      170                                     , p-type
      171                                     , p-emitent-host-code
      172                                     , p-issue-code
      173                                     , chr(10)
      174                                     ).
      175     end.
      176     else do:
      177       return substitute("Не удалось определить ПОЛНЫЙ номер ДК&5Карта &1 (тип &2 эмитент &3) не соответствует ни одной действующей маске, для объекта выдачи карты маг&4"
      178                                     , p-d-card
      179                                     , p-type
      180                                     , p-emitent-host-code
      181                                     , p-issue-code
      182                                     , chr(10)
      183                                     ).
      184     end.
      185   end.
