        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input PARAMETER        p-wth-code LIKE ub.wealth.wth-code NO-UNDO.
        6   define input PARAMETER        p-money AS LOG NO-UNDO.
        7   define input PARAMETER        p-ser AS INT NO-UNDO.
        8   define input PARAMETER        p-unit LIKE ub.wealth.unit-base no-undo.
        9   define input PARAMETER        p-curr-code LIKE ub.wealth.curr-code NO-UNDO.
       10   define input PARAMETER        p-name LIKE ub.wealth.wth-name NO-UNDO.
       11   define input  parameter       p-get-qnty-method as character no-undo .
       12   define input PARAMETER        p-ps LIKE ub.wealth.ps NO-UNDO.
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: wealth.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: ref/wealth.p $":U .
       18   define variable vss-description as character no-undo init "Сохранение МЦ".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   define variable v-mess as character no-undo .
       89   define buffer buf_wealth for ub.wealth.
       90   main-block:
       91   do
       92    on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       93    on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       94    on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       95   :
       96       if p-name = "" then do:
       97           v-mess =  "Введите название МЦ" .
       98           run err-mess in this-procedure ( input-output v-mess).
       99           return error (if p-silent = yes then v-mess else 'wth-name':U).
      100       end.
      101       if p-money = yes and p-curr-code = ? then do:
      102           v-mess = "Для материальных ценностей - денежных средств или имеющих денежный эквивалент~n
      103                 необходимо ввести код валюты" .
      104           run err-mess in this-procedure ( input-output v-mess).
      105           return error (if p-silent = yes then v-mess else 'curr-code':U).
      106       end.
      107       if NOT p-money  and p-unit = "" then do:
      108           v-mess = "Для материальных ценностей - не денежных средств  или не имеющих денежный эквивалент~n
      109                     необходимо ввести единицу измерения" .
      110           run err-mess in this-procedure ( input-output v-mess).
      111           return error (if p-silent = yes then v-mess else 'unit-base':U).
      112       end.
      113     if Lookup(p-get-qnty-method, '=sum,=1,=val-qnty':U) = 0 then do:
      114        v-mess = substitute("Неверное значение метода получения кол-ва МЦ = &1", p-get-qnty-method).
      115        run err-mess in this-procedure ( input-output v-mess).
      116        return error (if p-silent = yes then v-mess else 'wth-code':U).
      117     end.
      118     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      119       create buf_wealth.
      120         assign
      121         buf_wealth.wth-code = next-value(s-wth-code, ub)    .
      122     end.
      123     else  find first buf_wealth where  recid(buf_wealth) = p-rec exclusive-lock no-error.
      124     if not available buf_wealth then do:
      125        v-mess = substitute("Не найдена МЦ").
      126        run err-mess in this-procedure ( input-output v-mess).
      127        return error (if p-silent = yes then v-mess else 'wth-code':U).
      128      end.
      129       assign
      130       buf_wealth.wth-name = p-name
      131       buf_wealth.curr-code = p-curr-code
      132       buf_wealth.PS = p-PS
      133       buf_wealth.is-money = p-money
      134       buf_wealth.is-ser = p-ser
      135       buf_wealth.unit-base =  p-unit
      136       buf_wealth.get-qnty-method = p-get-qnty-method
      137       p-rec = recid(buf_wealth)
      138     .
      139     release buf_wealth no-error .
      140     if error-status:error then do:
      141       v-mess = substitute("Ошибка при сохранения МЦ:&1&2&3"
      142                            , error-status:get-message(1)
      143                            , chr(10)
      144                            , return-value
      145                            ).
      146       run err-mess in this-procedure ( input-output v-mess).
      147       return error (if p-silent = yes then v-mess else '':U).
      148     end.
      149   end.
      150   PROCEDURE err-mess:
      151     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      152     CASE p-silent:
      153       when yes then do:
      154         assign
      155         p-mess = substitute("Материальная ценность: код &1&3&4"
      156                            , p-wth-code
      157                            , chr(10)
      158                            , p-mess)
      159         .
      160       end.
      161       when no then do:
      162         message
      163         p-mess
      164         view-as alert-box error .
      165       end.
      166     end.
      167   END PROCEDURE.
