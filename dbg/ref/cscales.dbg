     3116   define variable  where-phrase-25     as character no-undo .
     3117   define variable  sort-phrase-25      as character no-undo .
     3118   define variable  where-phrase-rus-25 as character no-undo .
     3119   define variable  sort-phrase-rus-25  as character no-undo .
     3120     run waitfram-show in this-procedure
     3121       (input "ЖДИТЕ ..."
