     3153             then  substitute('X_c-scales.db-num = &1 AND X_c-scales.scales-num = &2                          AND X_c-scales.subject = &3&4&3 ', pardb-num, parscales-num, chr(34), p-subject) + " " + where-phrase-25
     3154             else "true"
     3155           )
     3156         parameter-5-25 = (" " + "" + " " + "")
     3157         parameter-6-25 = if sort-phrase-25 = ''
     3158                              then
     3159           (
     3160           " " + "  " +
     3161             " " + sort-column-phrase +
     3162           " " + "  "
     3163           )
     3164                              else
     3165           (
     3166           " " + "  " +
     3167             " " + sort-column-phrase +
     3168           " " + sort-phrase-25
     3169           )
     3170         parameter-7-25 =
     3171           "   "
     3172       .
     3173       do
     3174       on stop undo, leave
     3175       on error undo, leave
     3176       :
     3177         assign
     3178           l-disable-where-25 =
     3179             (" X_c-scales.db-num = pardb-num AND X_c-scales.scales-num = parscales-num                          AND X_c-scales.subject = p-subject " + " " + where-phrase-25 = "")
     3180         .
     3181         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3182                             ,input query br-c-scales:handle
     3183                             ,input parameter-3-25
     3184                             ,input parameter-4-25
     3185                             ,input parameter-5-25
     3186                             ,input parameter-6-25
