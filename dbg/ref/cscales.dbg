     3211           l-query-was-opened = true
     3212         .
     3213     end.
     3214     run waitfram-hide in this-procedure .
     3215       end.
     3216   END CASE.
     3217   apply "entry" to br-c-scales in frame Dialog-Frame.
     3218   reposition br-c-scales to row 1 no-error.
     3219   APPLY "VALUE-CHANGED":U to br-c-scales.
     3220   END PROCEDURE.
     3221   PROCEDURE proc-b-sch :
     3222   assign
     3223   tbl = 'c-scales'
     3224   join-tbl = 'X_c-scales'
     3225   fld = ""
     3226   lab = ""
     3227   spr = ""
     3228   dim = '0'
     3229   .
     3230   run fltfield-add in this-procedure('db-num', 'БД', '',
     3231   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3232   run fltfield-add in this-procedure('scales-num', 'Номер', '',
     3233   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3234   run fltfield-add in this-procedure('subject', 'Предмет изменений', 'scl-hist-subject',
     3235   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3236   run fltfield-add in this-procedure('address', 'Адрес', '',
     3237   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3238   run fltfield-add in this-procedure('corr-date', 'Дата изменений', '',
     3239   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3240   run fltfield-add in this-procedure('corr-time', 'Время изменений', 'time',
     3241   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3242   run fltfield-add in this-procedure('corr-user-db-num', 'БД изменений', '',
     3243   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3244   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     3245   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3246   run fltfield-add in this-procedure('is-del', 'Удаленная запись', '',
     3247   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3248   DO on stop undo, leave:
     3249       run gbl/filter.w ( input parparentproc
     3250                         ,input (filter-point + chr(4) + filter-label)
     3251                         ,input tbl
     3252                         ,input join-tbl
     3253                         ,input fld
     3254                         ,input lab
     3255                         ,input spr
     3256                         ,input dim).
     3257      RUN OpenBr in this-procedure ( INPUT yes, input no, input '':U).
     3258   END .
     3259   END PROCEDURE.
     3260   PROCEDURE proc-view-changes :
     3261   define variable v-description as character no-undo .
     3262   for each temp-changes:
     3263       delete temp-changes.
     3264   END.
     3265   if not available X_c-scales then do:
     3266     Open QUery br-changes for each temp-changes.
     3267     return.
     3268   end.
     3269   run ref/cscalv.p (
     3270                      input X_c-scales.db-num
     3271                     ,input X_c-scales.scales-num
     3272                     ,input X_c-scales.attr-code
     3273                     ,input X_c-scales.corr-user-db-num
     3274                     ,input X_c-scales.chip-num
     3275                     ,input X_c-scales.subject
     3276                     ,input 0
     3277                     ,input no
     3278                     ,output v-description
     3279                  ) no-error .
     3280   Open QUery br-changes for each temp-changes.
     3281   assign
     3282   br-changes:title in frame Dialog-Frame = v-description
     3283   .
     3284   END PROCEDURE.
     3285   FUNCTION get-action RETURNS CHARACTER
     3286     ( p-action as integer ) :
     3287      define variable dops as character no-undo.
     3288   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     3289   RETURN dops.
     3290   END FUNCTION.
