      756   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      757   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      758   procedure fltopend_fltopend :
      759   define input parameter p-parent-handle as handle no-undo .
      760   define input parameter p-qh as handle no-undo .
      761   define input parameter p-flt-open-open-query  as character no-undo .
      762   define input parameter p-where-cond as character no-undo .
      763   define input parameter p-use-indFIRST-query-tail as character no-undo .
      764   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      765   define input parameter p-indexed-reposition as character no-undo .
      766     do
      767     on error undo, return error
      768     :
      769   define variable v-prepare-string as character no-undo .
      770   define variable glog as logical no-undo .
      771   assign
      772   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      773                      p-where-cond + chr(32)  +
      774                      p-use-indFIRST-query-tail + chr(32) +
      775                      p-use-ind-sort-clmn-by + chr(32) +
      776                      p-indexed-reposition
      777   .
      778   assign
      779   glog = p-qh:query-prepare(v-prepare-string) no-error .
      780   if not glog
      781   or error-status:error then do:
      782     message error-status:get-message(1) view-as alert-box .
      783     undo, return error .
      784   end.
      785   assign
      786   glog = p-qh:query-open no-error .
      787   if not glog
      788   or error-status:error then do:
      789     message error-status:get-message(1) view-as alert-box .
      790     undo, return error .
      791   end.
      792     end.
      793   end procedure.
      794   procedure fltopend_fltfindd :
      795   define input parameter p-parent-handle as handle no-undo .
      796   define input parameter p-qh as handle no-undo .
      797   define input parameter p-rowid as rowid no-undo .
      798   define input parameter p-next as logical no-undo .
      799   define input parameter p-lock as integer no-undo .
      800   define input parameter p-bh as handle no-undo .
      801   define input parameter p-where-cond as character no-undo .
      802   define input parameter p-use-index-phrase as character no-undo .
      803   define variable glog as logical no-undo .
      804   define variable v-qh as handle no-undo .
      805   define variable v-bh as handle no-undo .
      806   define variable v-recid as recid no-undo .
      807   define variable v-prepare-string as character no-undo .
      808   do
      809   on error undo, return error
      810   on stop undo, return error
      811   :
      812     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      813     create buffer v-bh for table p-bh buffer-name p-bh:name.
      814     create query v-qh.
      815     v-qh:set-buffers(v-bh).
      816     v-prepare-string = substitute("for each &1 &2 &3"
      817                                     ,v-bh:name
      818                                     ,p-where-cond
      819                                     ,p-use-index-phrase).
      820     glog = v-qh:query-prepare(v-prepare-string) no-error.
      821     if not glog then do:
      822       delete object v-qh.
      823       delete object v-bh.
      824       undo, return error .
      825     end.
      826     glog = v-qh:query-open no-error .
      827     if not glog then do:
      828       delete object v-qh.
      829       delete object v-bh.
      830       undo, return error .
      831     end.
      832     if p-next then do:
      833       v-qh:reposition-to-rowid(p-rowid) no-error .
      834       glog = v-qh:get-next( p-lock) no-error .
      835       glog = v-qh:get-next( p-lock) no-error .
      836       if not glog or v-qh:query-off-end = yes then do:
      837         glog = v-qh:get-first( p-lock) no-error .
      838       end.
      839     end.
      840     else do:
      841       glog = v-qh:get-first( p-lock) no-error .
      842     end.
      843     v-recid = v-bh:recid no-error .
      844     delete object v-qh.
      845     delete object v-bh.
      846     return string(v-recid) .
      847   end.
      848   end procedure.
      849   procedure fltopend_fltfindq :
      850   define input parameter p-parent-handle as handle no-undo .
      851   define input parameter p-qh as handle no-undo .
      852   define input parameter p-next as logical no-undo .
      853   define input parameter p-lock as integer no-undo .
      854   define input parameter p-flt-open-open-query  as character no-undo .
      855   define input parameter p-where-cond as character no-undo .
      856   define input parameter p-use-indFIRST-query-tail as character no-undo .
      857   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      858   define input parameter p-indexed-reposition as character no-undo .
      859   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      860   define variable glog as logical no-undo .
      861   define variable v-qh as handle no-undo .
      862   define variable v-bh as handle no-undo extent 18.
      863   define variable v-rowid as rowid no-undo extent 18.
      864   define variable v-ii as integer no-undo .
      865   define variable v-prepare-string as character no-undo .
      866   do
      867   on error undo, return error
      868   on stop undo, return error
      869   :
      870     create query v-qh.
      871     do v-ii = 1 to p-qh:num-buffers:
      872       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      873       assign
      874       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      875       no-error.
      876       v-qh:add-buffer(v-bh[v-ii]).
      877     end.
      878     assign
      879     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      880                       p-where-cond + chr(32)  +
      881                       p-use-indFIRST-query-tail + chr(32) +
      882                       p-use-ind-sort-clmn-by + chr(32) +
      883                       p-indexed-reposition
      884     .
      885     glog = v-qh:query-prepare( v-prepare-string) no-error .
      886     if not glog then do:
      887       delete object v-qh.
      888       do v-ii = 1 to p-qh:num-buffers:
      889         delete object v-bh[v-ii].
      890       end.
      891       undo, return error .
      892     end.
      893     glog = v-qh:query-open no-error .
      894     if not glog then do:
      895       delete object v-qh.
      896       do v-ii = 1 to p-qh:num-buffers:
      897         delete object v-bh[v-ii].
      898       end.
      899       undo, return error .
      900     end.
      901     if p-next then do:
      902       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      903       glog = v-qh:get-next( p-lock) no-error .
      904       glog = v-qh:get-next( p-lock) no-error .
      905       if not glog or v-qh:query-off-end = yes then do:
      906         glog = v-qh:get-first( p-lock) no-error .
      907       end.
      908     end.
      909     else do:
      910       glog = v-qh:get-first( p-lock) no-error .
      911     end.
      912     do v-ii = 1 to p-qh:num-buffers:
      913       assign
      914       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      915       no-error.
      916     end.
      917     delete object v-qh.
      918     do v-ii = 1 to p-qh:num-buffers:
      919       delete object v-bh[v-ii].
      920     end.
      921   end.
      922   end procedure.
      923   define variable log-res as log no-undo.
      924   define variable rr as recid no-undo.
      925   define variable jj as integer no-undo .
      926   define variable str as character no-undo.
      927   define variable conf-par as character no-undo.
      928   define variable par-type as character no-undo.
      929   define variable vartbl-name as character no-undo.
      930   define variable varact      as character no-undo.
      931   define variable filter-point0 as character no-undo  init "cscales".
      932   define variable filter-point as character no-undo  init "cscales".
      933   define variable filter-label0 as character no-undo  init "Справочник истории весов".
      934   define variable filter-label as character no-undo init "Справочник истории весов".
      935   define variable v-rid-list as character no-undo .
      936   define variable sort-column-name as character no-undo .
      937   define variable v-doc-rec as recid no-undo .
      938   define NEW SHARED buffer c-scales for ub.c-scales .
      939   define buffer X_scales for ub.scales.
      940   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      941   define NEW SHARED temp-table temp-changes no-undo
      942   field f_name as character
      943   field l_name as character
      944   field v_old as character
      945   field v_new as character
      946   field t_name as character
      947   field num_ as integer
      948   field uniq-key-rec as character
      949   field action as integer
      950   field fNotChange as logical
      951   index pi is unique primary
      952   num_
      953   t_name
      954   f_name
      955   index
      956   Chan
      957   fnotChange
      958   t_name
      959   f_name
      960   index imain uniq-key-rec
      961   .
      962   FUNCTION get-all-fields returns character (p-file-name as character ):
      963   define variable v-dop as character no-undo .
      964     find first _file no-lock where _file._file-name = p-file-name no-error .
      965     if not available _file then return "":U.
      966     for each _field no-lock where
      967              _field._file-recid = recid(_file) :
      968       assign
      969       v-dop = v-dop + _field._field-name + chr(44)
      970       .
      971     end.
      972     return trim(v-dop).
      973   END FUNCTION.
      974   PROCEDURE proc-full-temp-changes :
      975     define input  parameter p-hst-handle as handle    no-undo .
      976     define input  parameter p-main-table as character no-undo .
      977     define input  parameter p-field-list as character no-undo .
      978     define input  parameter p-label-form as character no-undo .
      979     define variable h-new-buf         as handle    no-undo .
      980     define variable h-main-buf        as handle    no-undo .
      981     define variable h-for-comp        as handle    no-undo .
      982     define variable v-inform          as character no-undo .
      983     define variable v-ind             as integer   no-undo .
      984     define variable v-idx-field-qnty  as integer   no-undo .
      985     define variable v-num-entries     as integer   no-undo .
      986     define variable fh                as handle    no-undo .
      987     define variable fh-main           as handle    no-undo .
      988     define variable fh-old            as handle    no-undo .
      989     define variable fh-new            as handle    no-undo .
      990     define variable v-field-name      as character no-undo .
      991     define variable v-field-lvl       as character no-undo .
      992     define variable v-field-form      as character no-undo .
      993     define variable v-search-exp      as character no-undo .
      994     define variable v-srch-main       as character no-undo .
      995     define variable v-word-link       as character no-undo .
      996     define variable v-av-chip-num     as logical   no-undo .
      997     define variable v-main-pi-fld-lst as character no-undo .
      998     define variable v-main-fld-lst    as character no-undo .
      999     define variable v-delim-list      as character no-undo .
     1000     define variable v-label           as character no-undo .
     1001     define variable v-old-value       as character no-undo case-sensitive.
     1002     define variable v-new-value       as character no-undo case-sensitive.
     1003     define variable v-chg-fields as character no-undo.
     1004     for each temp-changes:
     1005       delete temp-changes.
     1006     end.
     1007     if not p-hst-handle:available then do:
     1008       return .
     1009     end.
     1010     create buffer h-new-buf  for table p-hst-handle .
     1011     create buffer h-main-buf for table p-main-table .
     1012     assign
     1013       v-inform = h-main-buf:index-information(1)
     1014       v-ind    = 2
     1015     .
     1016     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1017     on error undo, return error
     1018     :
     1019       assign
     1020         v-inform = h-main-buf:index-information( v-ind )
     1021         v-ind    = v-ind + 1
     1022       .
     1023     end.
     1024     if v-inform = ?
     1025       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1026       or entry( 3, v-inform, ",":U ) <> "1":U
     1027     then do:
     1028       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1029     end.
     1030     assign
     1031       v-idx-field-qnty = num-entries( v-inform ) - 4
     1032     .
     1033     if v-idx-field-qnty < 2 then do:
     1034       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1035     end.
     1036     assign
     1037       v-srch-main   = "where":U
     1038       v-word-link   = "":U
     1039       v-av-chip-num = false
     1040       v-delim-list  = "":U
     1041     .
     1042     do v-ind = 1 to v-idx-field-qnty by 2
     1043     on error undo, return error
     1044     :
     1045       assign
     1046         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1047         fh                = p-hst-handle:buffer-field( v-field-name )
     1048         fh-main           = h-main-buf:buffer-field( v-field-name )
     1049         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1050         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1051       .
     1052       if fh:data-type ="character":U then do:
     1053         assign
     1054           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1055         .
     1056       end.
     1057       else do:
     1058         assign
     1059           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1060         .
     1061       end.
     1062       if v-delim-list = "":U then do:
     1063         assign
     1064           v-delim-list = ",":U
     1065         .
     1066       end.
     1067       if v-word-link = "":U then do:
     1068         assign
     1069           v-word-link = "and":U
     1070         .
     1071       end.
     1072     end.
     1073     assign
     1074       v-delim-list  = "":U
     1075     .
     1076     do v-ind = 1 to h-main-buf:num-fields
     1077     on error undo, return error
     1078     :
     1079       assign
     1080         fh-main      = h-main-buf:buffer-field( v-ind )
     1081         v-field-name = fh-main:name
     1082       .
     1083         assign
     1084           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1085         .
     1086         if v-delim-list = "":U then do:
     1087           assign
     1088             v-delim-list = ",":U
     1089           .
     1090         end.
     1091     end.
     1092     assign
     1093       v-inform = p-hst-handle:index-information(1)
     1094       v-ind    = 2
     1095     .
     1096     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1097     on error undo, return error
     1098     :
     1099       assign
     1100         v-inform = p-hst-handle:index-information( v-ind )
     1101         v-ind    = v-ind + 1
     1102       .
     1103     end.
     1104     if v-inform = ?
     1105       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1106       or entry( 3, v-inform, ",":U ) <> "1":U
     1107     then do:
     1108       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1109     end.
     1110     assign
     1111       v-idx-field-qnty = num-entries( v-inform ) - 4
     1112     .
     1113     if v-idx-field-qnty < 2 then do:
     1114       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1115     end.
     1116     assign
     1117       v-search-exp  = "where":U
     1118       v-word-link   = "":U
     1119       v-av-chip-num = false
     1120     .
     1121     do v-ind = 1 to v-idx-field-qnty by 2
     1122     on error undo, return error
     1123     :
     1124       assign
     1125         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1126         fh           = p-hst-handle:buffer-field( v-field-name )
     1127         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1128       .
     1129       if v-field-name = "chip-num":U then do:
     1130         assign
     1131           v-search-exp  = substitute( "&1 >", v-search-exp )
     1132           v-av-chip-num = true
     1133         .
     1134       end.
     1135       else do:
     1136         assign
     1137           v-search-exp = substitute( "&1 =", v-search-exp )
     1138         .
     1139       end.
     1140       if fh:data-type ="character":U then do:
     1141         assign
     1142           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1143         .
     1144       end.
     1145       else do:
     1146         assign
     1147           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1148         .
     1149       end.
     1150       if v-word-link = "":U then do:
     1151         assign
     1152           v-word-link = "and":U
     1153         .
     1154       end.
     1155     end.
     1156     if v-av-chip-num = false then do:
     1157       message
     1158         vss-workfile vss-revision vss-description skip
     1159         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1160         "Использование данной процедуры невозможно!" skip
     1161         view-as alert-box error .
     1162       return error .
     1163     end.
     1164     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1165     if not h-new-buf:available then do:
     1166       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1167       if not h-main-buf:available then do:
     1168         assign
     1169           h-for-comp = ?
     1170         .
     1171       end.
     1172       else do:
     1173         assign
     1174           h-for-comp = h-main-buf
     1175         .
     1176       end.
     1177     end.
     1178     else do:
     1179       assign
     1180         h-for-comp = h-new-buf
     1181       .
     1182     end.
     1183     assign
     1184       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1185     .
     1186     do v-ind = 1 to v-num-entries
     1187     on error undo, return error return-value
     1188     :
     1189       assign
     1190         v-field-name = entry( v-ind, v-main-fld-lst )
     1191         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1192         v-old-value  = fh-old:buffer-value()
     1193         v-label      = trim( fh-old:label )
     1194       .
     1195       if ( trim( p-field-list ) <> "":U
     1196            and lookup( v-field-name, p-field-list ) > 0
     1197          )
     1198          or trim( p-field-list ) = "":U
     1199       then do:
     1200         if h-for-comp <> ? then do:
     1201           assign
     1202             fh-new      = h-for-comp:buffer-field( v-field-name )
     1203             v-new-value = fh-new:buffer-value()
     1204           .
     1205         end.
     1206         else do:
     1207           assign
     1208             v-new-value = "":U
     1209           .
     1210         end.
     1211         if v-old-value <> v-new-value
     1212         then do:
     1213           create temp-changes.
     1214           assign
     1215             temp-changes.t_name = p-main-table
     1216             temp-changes.f_name = v-field-name
     1217             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1218             temp-changes.v_old  = trim( v-old-value )
     1219             temp-changes.v_new  = trim( v-new-value )
     1220             temp-changes.num_   = 0
     1221             temp-changes.fNotChange = v-old-value eq v-new-value
     1222           .
     1223         end.
     1224       end.
     1225     end.
     1226     assign
     1227       v-num-entries = num-entries( p-label-form, chr(8) )
     1228     .
     1229     do v-ind = 1 to v-num-entries
     1230     on error undo, return error return-value
     1231     :
     1232       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1233         assign
     1234           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1235           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1236           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1237         .
     1238         find first temp-changes
     1239           where temp-changes.f_name = v-field-name
     1240           no-error .
     1241         if available temp-changes then do:
     1242           if trim( v-field-lvl ) <> "":U then do:
     1243             assign
     1244               temp-changes.l_name = v-field-lvl
     1245             .
     1246           end.
     1247           if trim( v-field-form ) <> "":U then do:
     1248             assign
     1249               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1250             .
     1251             if h-for-comp <> ? then do:
     1252               assign
     1253                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1254               .
     1255             end.
     1256           end.
     1257         end.
     1258       end.
     1259       else do:
     1260         message
     1261           vss-workfile vss-revision vss-description skip
     1262           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1263           substitute( "список для поля '&1': '&2'"
     1264                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1265                       ,entry( v-ind, p-label-form, chr(8) )
     1266                     ) skip
     1267           substitute( "полный список: &2", p-label-form ) skip
     1268           view-as alert-box error .
     1269       end.
     1270     end.
     1271     delete object h-new-buf .
     1272     delete object h-main-buf .
     1273   END PROCEDURE.
     1274   FUNCTION get-action RETURNS CHARACTER
     1275     ( p-action as integer )  FORWARD.
     1276   DEFINE BUTTON B-Help
     1277        LABEL "Помо&щь"
     1278        SIZE 3 BY 1
     1279        BGCOLOR 8 .
     1280   DEFINE BUTTON B-mark
     1281        LABEL "&*"
     1282        SIZE 3 BY 1.
     1283   DEFINE BUTTON b-quit AUTO-END-KEY
     1284        LABEL "&Выход"
     1285        SIZE 10 BY 1
     1286        BGCOLOR 8 .
     1287   DEFINE BUTTON B-sch
     1288        LABEL "&Фильтр"
     1289        SIZE 3 BY 1.
     1290   DEFINE BUTTON b-sel AUTO-GO
     1291        LABEL "Вы&бор"
     1292        SIZE 10 BY 1.
     1293   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1294        VIEW-AS FILL-IN
     1295        SIZE 9 BY 1
     1296        FGCOLOR 4  NO-UNDO.
     1297   DEFINE QUERY BR-c-scales FOR
     1298         X_c-scales SCROLLING.
     1299   DEFINE QUERY BR-changes FOR
     1300         temp-changes SCROLLING.
     1301   DEFINE BROWSE BR-c-scales
     1302     QUERY BR-c-scales NO-LOCK DISPLAY
     1303         mark-string( recid(X_c-scales), v-rid-list ) COLUMN-LABEL "*" FORMAT "X(1)":U
     1304         entry (lookup (X_c-scales.subject, 'scales,scales-grp,scales-gds,scales-attr':U), 'Весы,Группы товаров на весах,Товар на весах,Атрибут весов':U) COLUMN-LABEL "Предмет изменений" FORMAT "X(20)":U
     1305         get-action(X_c-scales.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1306         X_c-scales.corr-date COLUMN-LABEL "Дата корр" FORMAT "99/99/9999":U
     1307         usrfulnf(X_c-scales.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1308         string(X_c-scales.corr-time, "HH:MM")
     1309       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 12.33.
     1310   DEFINE BROWSE BR-changes
     1311     QUERY BR-changes DISPLAY
     1312         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(255)" width 20
     1313   temp-changes.v_old COLUMn-LABEL "Было" format "X(40)"
     1314   temp-changes.v_new COLUMn-LABEL "Стало" format "X(40)"
     1315       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6.
     1316   DEFINE FRAME Dialog-Frame
     1317        b-quit AT ROW 1 COL 1
     1318        B-mark AT ROW 1 COL 11
     1319        b-sel AT ROW 1 COL 14
     1320        B-sch AT ROW 1 COL 92
     1321        B-Help AT ROW 1 COL 95
     1322        mark-num AT ROW 2.27 COL 9 COLON-ALIGNED NO-LABEL
     1323        BR-c-scales AT ROW 3.43 COL 1
     1324        BR-changes AT ROW 16.03 COL 1
     1325        SPACE(0.24) SKIP(0.01)
     1326       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1327            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1328            TITLE "Справочник истории весов"
     1329            CANCEL-BUTTON b-quit.
     1330   ASSIGN
     1331          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1332          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1333   ON GO OF FRAME Dialog-Frame
     1334   DO:
     1335     p-rid-list = v-rid-list.
     1336   END.
     1337   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1338   DO:
     1339     APPLY "END-ERROR":U TO SELF.
     1340   END.
     1341   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1342   DO:
     1343   define variable glog as logical no-undo .
     1344    if not available X_c-scales then return no-apply.
     1345   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1346   define variable v-str-recid13 as character no-undo .
     1347   define variable v-num-entry13 as integer   no-undo .
     1348   assign
     1349     v-str-recid13 = trim( string( recid( X_c-scales ) , "->>>>>>>>>>>9":U ) )
     1350     v-num-entry13 = lookup( v-str-recid13 , v-rid-list )
     1351   .
     1352   if v-num-entry13 > 0 then do:
     1353     assign
     1354       entry( v-num-entry13, v-rid-list ) = "":U
     1355       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1356     .
     1357   end.
     1358   else do:
     1359     assign
     1360       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid13
     1361     .
     1362   end.
     1363    glog = br-c-scales :refresh( )  in frame Dialog-Frame.
     1364     if not can-do ("MOUSE-SELECT-DBLCLICK,Return", last-event:function) then do:
     1365       glog = br-c-scales:select-next-row () in frame Dialog-Frame.
     1366       apply "value-changed" to br-c-scales in frame Dialog-Frame.
     1367     end.
     1368     if num-entries (v-rid-list) = 0 then
     1369         hide mark-num in frame Dialog-Frame.
     1370     else
     1371     disp num-entries (v-rid-list) @ mark-num
     1372     with frame Dialog-Frame.
     1373     apply "entry" to br-c-scales in frame Dialog-Frame.
     1374   END.
     1375   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1376   DO:
     1377     run proc-b-sch in this-procedure no-error.
     1378     if error-status:error then return no-apply.
     1379   END.
     1380   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1381   DO:
     1382       if ( available X_c-scales ) AND ( v-rid-list = "" ) then
     1383           v-rid-list = string( recid( X_c-scales ) ) .
     1384   END.
     1385   ON RETURN OF BR-c-scales IN FRAME Dialog-Frame
     1386   DO:
     1387         apply "DEFAULT-ACTION":U to self.
     1388   END.
     1389   ON VALUE-CHANGED OF BR-c-scales IN FRAME Dialog-Frame
     1390   DO:
     1391     run proc-view-changes in this-procedure no-error.
     1392   END.
     1393   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1394   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1395   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1396   on help of frame Dialog-Frame
     1397   do:
     1398     run gbl/app_help.p
     1399       (input this-procedure :file-name
     1400       ,input ''
     1401       ,input ?
     1402       ) no-error.
     1403     if error-status :error then do:
     1404       message
     1405         "Ошибка при вызове помощи"
     1406         error-status :get-message(1)
     1407         view-as alert-box .
     1408     end.
     1409   end.
     1410   run minbtn-set in this-procedure .
     1411   on choose of b-help in frame Dialog-Frame
     1412   do:
     1413     apply "help":u to frame Dialog-Frame .
     1414   end.
     1415   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1416   procedure minbtn-set :
     1417       do
     1418           on error undo, return error return-value
     1419           :
     1420           define variable ii              as integer       no-undo .
     1421           define variable fh              as widget-handle no-undo .
     1422           define variable hh              as widget-handle no-undo .
     1423           define variable v-h             as handle        extent 4 no-undo .
     1424           define variable v-name-button   as character     no-undo .
     1425           define variable v-help-old-x    as decimal       no-undo .
     1426           define variable v-help-old-y    as decimal       no-undo .
     1427           define variable v-help-old-size as decimal       no-undo .
     1428           define variable v-frame-width   as decimal       no-undo .
     1429           define variable jj              as integer       no-undo .
     1430           do
     1431               on error undo, return error
     1432               :
     1433               assign
     1434                   v-frame-width = frame Dialog-Frame:width - 0.3
     1435                   fh            = frame Dialog-Frame:first-child
     1436                   hh            = fh:first-child
     1437                   ii            = 1
     1438                   .
     1439               do while valid-handle(hh):
     1440                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1441                   do:
     1442                       case lc(hh:name) :
     1443                           when "b-help" then
     1444                               do:
     1445                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1446                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1447                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1448                                   hh:TOOLTIP = "Помощь" .
     1449                                   v-help-old-x = hh:column .
     1450                                   v-help-old-y = hh:row    .
     1451                                   v-help-old-size = hh:width .
     1452                                   hh:width-chars = 2.5 .
     1453                               end.
     1454                           when "b-print" then
     1455                               do:
     1456                                   hh:load-image("cmp/b-print.bmp":u) .
     1457                                   hh:TOOLTIP = "Печать" .
     1458                                   v-h[ii] = hh:handle .
     1459                                   ii = ii + 1 .
     1460                                   hh:width-chars = 3 .
     1461                               end.
     1462                           when "b-history" or
     1463                           when "b-hist" then
     1464                               do:
     1465                                   hh:load-image("cmp/b-hist.bmp":u) .
     1466                                   hh:TOOLTIP = "История" .
     1467                                   v-h[ii] = hh:handle .
     1468                                   ii = ii + 1 .
     1469                                   hh:width-chars = 3 .
     1470                               end.
     1471                           when "b-sch" then
     1472                               do:
     1473                                   hh:load-image("cmp/b-sch.bmp":u) .
     1474                                   hh:TOOLTIP = "Установка Фильтра" .
     1475                                   v-h[ii] = hh:handle .
     1476                                   ii = ii + 1 .
     1477                                   hh:width-chars = 3 .
     1478                               end.
     1479                           when "b-hist-user" then
     1480                               do:
     1481                                   hh:load-image("cmp/b-hist.bmp":u) .
     1482                                   hh:TOOLTIP = "История пользователя" .
     1483                                   ii = ii + 1 .
     1484                               end.
     1485                       end case.
     1486                   end.
     1487                   hh = hh:next-sibling.
     1488               end.
     1489               b-help:column = v-frame-width - b-help:width-chars.
     1490               jj = 0.
     1491               repeat ii = 4 to 1 by -1 :
     1492                   if valid-handle (v-h[ii] ) then
     1493                   do:
     1494                       jj  = jj + 1 .
     1495                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1496                       v-h[ii]:row    = v-help-old-y .
     1497                   end.
     1498               end.
     1499           end.
     1500       end.
     1501   end procedure.
     1502   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1503   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1504   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1505   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1506   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1507   define variable v-diasize-current-frame-height as decimal   no-undo .
     1508   define variable v-diasize-change-size          as logical   no-undo .
     1509   define variable v-diasize-resize-button        as handle    no-undo .
     1510   define variable v-diasize-wndmax               as logical   no-undo .
     1511   define variable v-diasize-wndstore             as logical   no-undo .
     1512   define variable v-diasize-proc-name            as character no-undo .
     1513   define variable v-diasize-browse-handle        as handle    no-undo .
     1514   define variable v-diasize-browse-number        as integer   no-undo .
     1515   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1516   define temp-table temp-diasize-handle no-undo
     1517     field handle-value  as handle
     1518     field save-position as decimal
     1519     index xpk is primary unique handle-value
     1520     .
     1521   define temp-table temp-browse-handle no-undo
     1522     field browse-type   as character
     1523     field browse-number as integer
     1524     field browse-handle as handle
     1525     field original-size as decimal
     1526     index xpk is primary unique browse-type browse-number
     1527     index xie browse-type browse-handle
     1528   .
     1529   procedure diasize_change-height :
     1530     define input  parameter p-change-value  as decimal   no-undo .
     1531     define input  parameter p-move-resize   as logical   no-undo .
     1532     define variable v-field-group-handle    as handle    no-undo .
     1533     define variable v-object-handle         as handle    no-undo .
     1534     define variable v-frame-height          as decimal   no-undo .
     1535     define variable v-frame-virtual-height  as decimal   no-undo .
     1536     define variable v-browse-height         as decimal   no-undo .
     1537     define variable v-window-height         as decimal   no-undo .
     1538     define variable v-window-virtual-height as decimal   no-undo .
     1539     define variable v-change-sign           as integer   no-undo .
     1540     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1541     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1542     if p-change-value > 0
     1543     then do:
     1544       if frame Dialog-Frame :height + p-change-value
     1545           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1546       then do:
     1547         assign
     1548           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1549                           - (frame Dialog-Frame :height-chars)
     1550         .
     1551         if p-change-value <= 0
     1552         then do:
     1553           run diasize_position-resize-button in this-procedure .
     1554           return .
     1555         end.
     1556       end.
     1557     end.
     1558     if p-change-value < 0
     1559     then do:
     1560       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1561       then do:
     1562         assign
     1563           p-change-value = v-diasize-orig-frame-height
     1564                          - (frame Dialog-Frame :height-chars)
     1565         .
     1566         if p-change-value >= 0
     1567         then do:
     1568           run diasize_position-resize-button in this-procedure .
     1569           return .
     1570         end.
     1571       end.
     1572     end.
     1573     if p-change-value >= 0
     1574     then do:
     1575       assign
     1576         v-change-sign = 1
     1577       .
     1578     end.
     1579     else do:
     1580       assign
     1581         v-change-sign = -1
     1582       .
     1583     end.
     1584     assign
     1585       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1586     .
     1587     if p-change-value = 0
     1588     then do:
     1589       run diasize_position-resize-button in this-procedure .
     1590       return .
     1591     end.
     1592     move_block:
     1593     do
     1594     on error undo move_block, retry move_block
     1595     :
     1596       if retry
     1597       then do:
     1598         do
     1599         on error undo move_block, leave move_block
     1600         :
     1601           if p-change-value > 0
     1602           then do:
     1603             for each buf_temp-diasize-handle
     1604             on error undo, next
     1605             :
     1606               assign
     1607                 v-object-handle = buf_temp-diasize-handle.handle-value
     1608               .
     1609               if v-object-handle <> v-diasize-resize-button
     1610               then do:
     1611                 assign
     1612                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1613                 .
     1614               end.
     1615             end.
     1616             assign
     1617               v-diasize-browse-handle :height = v-browse-height
     1618             .
     1619             for each buf_temp-browse-handle
     1620               where buf_temp-browse-handle.browse-type = 'height':u
     1621             on error undo, next
     1622             :
     1623               assign
     1624                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1625               .
     1626             end.
     1627             assign
     1628               frame Dialog-Frame :height = v-frame-height
     1629             .
     1630             if frame Dialog-Frame :scrollable = true
     1631             then do:
     1632               assign
     1633                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1634               .
     1635             end.
     1636             run diasize_position-resize-button in this-procedure .
     1637           end.
     1638           else do:
     1639             if frame Dialog-Frame :scrollable = true
     1640             then do:
     1641               assign
     1642                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1643               .
     1644             end.
     1645             assign
     1646               frame Dialog-Frame :height = v-frame-height
     1647             .
     1648             assign
     1649               v-diasize-browse-handle :height = v-browse-height
     1650             .
     1651             for each buf_temp-browse-handle
     1652               where buf_temp-browse-handle.browse-type = 'height':u
     1653             on error undo, next
     1654             :
     1655               assign
     1656                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1657               .
     1658             end.
     1659             for each buf_temp-diasize-handle
     1660             on error undo, next
     1661             :
     1662               assign
     1663                 v-object-handle = buf_temp-diasize-handle.handle-value
     1664               .
     1665               if v-object-handle <> v-diasize-resize-button
     1666               then do:
     1667                 assign
     1668                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1669                 .
     1670               end.
     1671             end.
     1672             run diasize_position-resize-button in this-procedure .
     1673           end.
     1674           assign
     1675             v-diasize-change-size = false
     1676           .
     1677           leave move_block .
     1678         end.
     1679       end.
     1680       assign
     1681         v-diasize-need-full-display = true
     1682       .
     1683       if v-diasize-change-size = false
     1684       then do:
     1685         assign
     1686           v-diasize-change-size = true
     1687         .
     1688       end.
     1689       else do:
     1690         return .
     1691       end.
     1692       assign
     1693         v-frame-height = frame Dialog-Frame :height
     1694         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1695         v-browse-height = v-diasize-browse-handle :height
     1696       .
     1697       for each buf_temp-browse-handle
     1698         where buf_temp-browse-handle.browse-type = 'height':u
     1699       :
     1700         assign
     1701           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1702         .
     1703       end.
     1704       for each buf_temp-diasize-handle
     1705       :
     1706         delete buf_temp-diasize-handle .
     1707       end.
     1708       assign
     1709         v-field-group-handle = frame Dialog-Frame :first-child
     1710       .
     1711       do while valid-handle(v-field-group-handle)
     1712       :
     1713         assign
     1714           v-object-handle = v-field-group-handle :first-child
     1715         .
     1716         do while valid-handle(v-object-handle)
     1717         :
     1718           if  v-object-handle <> v-diasize-browse-handle :handle
     1719           and can-query(v-object-handle, "row")
     1720           and can-query(v-object-handle, "height")
     1721           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1722           then do:
     1723             find first buf_temp-browse-handle
     1724               where buf_temp-browse-handle.browse-type   = 'height':u
     1725                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1726               no-error .
     1727             if available buf_temp-browse-handle
     1728             then do:
     1729             end.
     1730             else do:
     1731               create buf_temp-diasize-handle .
     1732               assign
     1733                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1734                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1735               .
     1736             end.
     1737           end.
     1738           assign
     1739             v-object-handle = v-object-handle :next-sibling
     1740           .
     1741         end.
     1742         assign
     1743           v-field-group-handle = v-field-group-handle :next-sibling
     1744         .
     1745       end.
     1746       do with frame Dialog-Frame
     1747       :
     1748         hide v-diasize-resize-button .
     1749         assign
     1750           v-diasize-resize-button :row    = 1
     1751           v-diasize-resize-button :column = 1
     1752         .
     1753       end.
     1754       if p-change-value > 0
     1755       then do:
     1756         if frame Dialog-Frame :scrollable = true
     1757         then do:
     1758           assign
     1759             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1760             no-error .
     1761           if error-status :error
     1762           or error-status :get-message(1) <> ""
     1763           then do:
     1764             undo move_block, retry move_block .
     1765           end.
     1766         end.
     1767         assign
     1768           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1769           no-error .
     1770         if error-status :error
     1771         or error-status :get-message(1) <> ""
     1772         then do:
     1773           undo move_block, retry move_block .
     1774         end.
     1775         assign
     1776           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1777           no-error .
     1778         if error-status :error
     1779         or error-status :get-message(1) <> ""
     1780         then do:
     1781           undo move_block, retry move_block .
     1782         end.
     1783         for each buf_temp-browse-handle
     1784           where buf_temp-browse-handle.browse-type = 'height':u
     1785         on error undo move_block, retry move_block
     1786         :
     1787           assign
     1788             buf_temp-browse-handle.browse-handle :height
     1789               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1790             no-error .
     1791           if error-status :error
     1792           or error-status :get-message(1) <> ""
     1793           then do:
     1794             undo move_block, retry move_block .
     1795           end.
     1796         end.
     1797         for each buf_temp-diasize-handle
     1798         on error undo move_block, retry move_block
     1799         :
     1800           assign
     1801             v-object-handle = buf_temp-diasize-handle.handle-value
     1802           .
     1803           if v-object-handle <> v-diasize-resize-button
     1804           then do:
     1805             assign
     1806               v-object-handle :row = v-object-handle :row + p-change-value
     1807               no-error .
     1808             if error-status :error
     1809             or error-status :get-message(1) <> ""
     1810             then do:
     1811               undo move_block, retry move_block .
     1812             end.
     1813           end.
     1814         end.
     1815       end.
     1816       else do:
     1817         for each buf_temp-diasize-handle
     1818         on error undo move_block, retry move_block
     1819         :
     1820           assign
     1821             v-object-handle = buf_temp-diasize-handle.handle-value
     1822           .
     1823           if v-object-handle <> v-diasize-resize-button
     1824           then do:
     1825             assign
     1826               v-object-handle :row = v-object-handle :row + p-change-value
     1827               no-error .
     1828             if error-status :error
     1829             or error-status :get-message(1) <> ""
     1830             then do:
     1831               undo move_block, retry move_block .
     1832             end.
     1833           end.
     1834         end.
     1835         assign
     1836           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1837           no-error .
     1838         if error-status :error
     1839         or error-status :get-message(1) <> ""
     1840         then do:
     1841           undo move_block, retry move_block .
     1842         end.
     1843         for each buf_temp-browse-handle
     1844           where buf_temp-browse-handle.browse-type = 'height':u
     1845         on error undo move_block, retry move_block
     1846         :
     1847           assign
     1848             buf_temp-browse-handle.browse-handle :height
     1849               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1850             no-error .
     1851           if error-status :error
     1852           or error-status :get-message(1) <> ""
     1853           then do:
     1854             undo move_block, retry move_block .
     1855           end.
     1856         end.
     1857         assign
     1858           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1859           no-error .
     1860         if error-status :error
     1861         or error-status :get-message(1) <> ""
     1862         then do:
     1863           undo move_block, retry move_block .
     1864         end.
     1865         if frame Dialog-Frame :scrollable = true
     1866         then do:
     1867           assign
     1868             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1869             no-error .
     1870           if error-status :error
     1871           or error-status :get-message(1) <> ""
     1872           then do:
     1873             undo move_block, retry move_block .
     1874           end.
     1875         end.
     1876       end.
     1877       if p-move-resize = true
     1878       then do:
     1879         run diasize_position-resize-button in this-procedure .
     1880       end.
     1881       if v-diasize-wndstore = true
     1882       then do:
     1883         if connected("ub") = true
     1884         then do:
     1885           define variable v-cntxt-db-num        as integer   no-undo .
     1886           define variable v-cntxt-userid        as character no-undo .
     1887           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1888                                             , OUTPUT v-cntxt-userid
     1889                                             ) .
     1890           run gbl/wndsizew.p
     1891             (input  v-cntxt-db-num
     1892             ,input  v-cntxt-userid
     1893             ,input  v-diasize-proc-name
     1894             ,input  'height':u
     1895             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1896             ) .
     1897         end.
     1898       end.
     1899     end.
     1900     assign
     1901       v-diasize-change-size = false
     1902     .
     1903   end procedure.
     1904   procedure diasize_set-height :
     1905     define input  parameter p-new-height  as decimal   no-undo .
     1906     define input  parameter p-move-resize as logical   no-undo .
     1907     do
     1908     on error undo, return error return-value
     1909     :
     1910       run diasize_change-height in this-procedure
     1911         (input  (p-new-height - frame Dialog-Frame :height)
     1912         ,input  p-move-resize
     1913         ) .
     1914     end.
     1915   end procedure.
     1916   procedure diasize_change-width :
     1917     define input  parameter p-change-value as decimal   no-undo .
     1918     define input  parameter p-move-resize  as logical   no-undo .
     1919     define variable v-field-group-handle   as handle    no-undo .
     1920     define variable v-object-handle        as handle    no-undo .
     1921     define variable v-frame-width          as decimal   no-undo .
     1922     define variable v-frame-virtual-width  as decimal   no-undo .
     1923     define variable v-browse-width         as decimal   no-undo .
     1924     define variable v-window-width         as decimal   no-undo .
     1925     define variable v-window-virtual-width as decimal   no-undo .
     1926     define variable v-change-sign          as integer   no-undo .
     1927     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1928     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1929     if p-change-value > 0
     1930     then do:
     1931       if frame Dialog-Frame :width + p-change-value >
     1932           session :width-chars
     1933       then do:
     1934         assign
     1935           p-change-value = session :width-chars - frame Dialog-Frame :width
     1936         .
     1937         if p-change-value <= 0
     1938         then do:
     1939           run diasize_position-resize-button in this-procedure .
     1940           return .
     1941         end.
     1942       end.
     1943     end.
     1944     if p-change-value < 0
     1945     then do:
     1946       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1947       then do:
     1948         assign
     1949           p-change-value = v-diasize-orig-frame-width
     1950                          - frame Dialog-Frame :width
     1951         .
     1952         if p-change-value >= 0
     1953         then do:
     1954           run diasize_position-resize-button in this-procedure .
     1955           return .
     1956         end.
     1957       end.
     1958     end.
     1959     if p-change-value >= 0
     1960     then do:
     1961       assign
     1962         v-change-sign = 1
     1963       .
     1964     end.
     1965     else do:
     1966       assign
     1967         v-change-sign = -1
     1968       .
     1969     end.
     1970     assign
     1971       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1972     .
     1973     if p-change-value = 0
     1974     then do:
     1975       run diasize_position-resize-button in this-procedure .
     1976       return .
     1977     end.
     1978     move_block:
     1979     do
     1980     on error undo move_block, leave move_block
     1981     :
     1982       if retry
     1983       then do:
     1984         do
     1985         on error undo move_block, leave move_block
     1986         :
     1987           if p-change-value > 0
     1988           then do:
     1989             for each buf_temp-diasize-handle
     1990             on error undo, next
     1991             :
     1992               assign
     1993                 v-object-handle = buf_temp-diasize-handle.handle-value
     1994               .
     1995               if v-object-handle <> v-diasize-resize-button
     1996               then do:
     1997                 assign
     1998                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1999                 .
     2000               end.
     2001             end.
     2002             assign
     2003               v-diasize-browse-handle :width = v-browse-width
     2004             .
     2005             for each buf_temp-browse-handle
     2006               where buf_temp-browse-handle.browse-type = 'width':u
     2007             on error undo, next
     2008             :
     2009               assign
     2010                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2011               .
     2012             end.
     2013             assign
     2014               frame Dialog-Frame :width = v-frame-width
     2015             .
     2016             if frame Dialog-Frame :scrollable = true
     2017             then do:
     2018               assign
     2019                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2020               .
     2021             end.
     2022             run diasize_position-resize-button in this-procedure .
     2023           end.
     2024           else do:
     2025             if frame Dialog-Frame :scrollable = true
     2026             then do:
     2027               assign
     2028                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2029               .
     2030             end.
     2031             assign
     2032               frame Dialog-Frame :width = v-frame-width
     2033             .
     2034             for each buf_temp-browse-handle
     2035               where buf_temp-browse-handle.browse-type = 'width':u
     2036             on error undo, next
     2037             :
     2038               assign
     2039                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2040               .
     2041             end.
     2042             assign
     2043               v-diasize-browse-handle :width = v-browse-width
     2044             .
     2045             for each buf_temp-diasize-handle
     2046             on error undo, next
     2047             :
     2048               assign
     2049                 v-object-handle = buf_temp-diasize-handle.handle-value
     2050               .
     2051               if v-object-handle <> v-diasize-resize-button
     2052               then do:
     2053                 assign
     2054                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2055                 .
     2056               end.
     2057             end.
     2058             run diasize_position-resize-button in this-procedure .
     2059           end.
     2060           assign
     2061             v-diasize-change-size = false
     2062           .
     2063           leave move_block .
     2064         end.
     2065       end.
     2066       assign
     2067         v-diasize-need-full-display = true
     2068       .
     2069       if v-diasize-change-size = false
     2070       then do:
     2071         assign
     2072           v-diasize-change-size = true
     2073         .
     2074       end.
     2075       else do:
     2076         return .
     2077       end.
     2078       assign
     2079         v-frame-width = frame Dialog-Frame :width
     2080         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2081         v-browse-width = v-diasize-browse-handle :width
     2082       .
     2083       for each buf_temp-browse-handle
     2084         where buf_temp-browse-handle.browse-type = 'width':u
     2085       :
     2086         assign
     2087           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2088         .
     2089       end.
     2090       for each buf_temp-diasize-handle
     2091       :
     2092         delete buf_temp-diasize-handle .
     2093       end.
     2094       assign
     2095         v-field-group-handle = frame Dialog-Frame :first-child
     2096       .
     2097       do while valid-handle(v-field-group-handle)
     2098       :
     2099         assign
     2100           v-object-handle = v-field-group-handle :first-child
     2101         .
     2102         do while valid-handle(v-object-handle)
     2103         :
     2104           if  v-object-handle <> v-diasize-browse-handle :handle
     2105           and v-object-handle <> v-diasize-resize-button
     2106           and can-query(v-object-handle, "row")
     2107           and can-query(v-object-handle, "height")
     2108           and ( v-object-handle :col + v-object-handle :width
     2109                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2110               )
     2111           then do:
     2112             find first buf_temp-browse-handle
     2113               where buf_temp-browse-handle.browse-type   = 'width':u
     2114                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2115               no-error .
     2116             if available buf_temp-browse-handle
     2117             then do:
     2118             end.
     2119             else do:
     2120               create buf_temp-diasize-handle .
     2121               assign
     2122                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2123                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2124               .
     2125             end.
     2126           end.
     2127           assign
     2128             v-object-handle = v-object-handle :next-sibling
     2129           .
     2130         end.
     2131         assign
     2132           v-field-group-handle = v-field-group-handle :next-sibling
     2133         .
     2134       end.
     2135       do with frame Dialog-Frame
     2136       :
     2137         hide v-diasize-resize-button .
     2138         v-diasize-resize-button :row = 1.
     2139         v-diasize-resize-button :column = 1.
     2140       end.
     2141       if p-change-value > 0
     2142       then do:
     2143         if frame Dialog-Frame :scrollable = true
     2144         then do:
     2145           assign
     2146             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2147             no-error .
     2148           if error-status :error
     2149           or error-status :get-message(1) <> ""
     2150           then do:
     2151             undo move_block, retry move_block.
     2152           end.
     2153         end.
     2154         assign
     2155           frame Dialog-Frame :width = v-frame-width + p-change-value
     2156           no-error .
     2157         if error-status :error
     2158         or error-status :get-message(1) <> ""
     2159         then do:
     2160           undo move_block, retry move_block.
     2161         end.
     2162         assign
     2163           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2164         no-error .
     2165         if error-status :error
     2166         or error-status :get-message(1) <> ""
     2167         then do:
     2168           undo move_block, retry move_block.
     2169         end.
     2170         for each buf_temp-browse-handle
     2171           where buf_temp-browse-handle.browse-type = 'width':u
     2172         on error undo move_block, retry move_block
     2173         :
     2174           assign
     2175             buf_temp-browse-handle.browse-handle :width
     2176               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2177             no-error .
     2178           if error-status :error
     2179           or error-status :get-message(1) <> ""
     2180           then do:
     2181             undo move_block, retry move_block .
     2182           end.
     2183         end.
     2184         for each buf_temp-diasize-handle
     2185         on error undo move_block, retry move_block
     2186         :
     2187           assign
     2188             v-object-handle = buf_temp-diasize-handle.handle-value
     2189           .
     2190           if v-object-handle <> v-diasize-resize-button
     2191           then do:
     2192             assign
     2193               v-object-handle :col = v-object-handle :col + p-change-value
     2194               no-error .
     2195             if error-status :error
     2196             or error-status :get-message(1) <> ""
     2197             then do:
     2198               undo move_block, retry move_block .
     2199             end.
     2200           end.
     2201         end.
     2202       end.
     2203       else do:
     2204         for each buf_temp-diasize-handle
     2205         on error undo move_block, retry move_block
     2206         :
     2207           assign
     2208             v-object-handle = buf_temp-diasize-handle.handle-value
     2209           .
     2210           if v-object-handle <> v-diasize-resize-button
     2211           then do:
     2212             assign
     2213               v-object-handle :col = v-object-handle :col + p-change-value
     2214               no-error .
     2215             if error-status :error
     2216             or error-status :get-message(1) <> ""
     2217             then do:
     2218               undo move_block, retry move_block .
     2219             end.
     2220           end.
     2221         end.
     2222         for each buf_temp-browse-handle
     2223           where buf_temp-browse-handle.browse-type = 'width':u
     2224         on error undo move_block, retry move_block
     2225         :
     2226           assign
     2227             buf_temp-browse-handle.browse-handle :width
     2228               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2229             no-error .
     2230           if error-status :error
     2231           or error-status :get-message(1) <> ""
     2232           then do:
     2233             undo move_block, retry move_block .
     2234           end.
     2235         end.
     2236         assign
     2237           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2238           no-error .
     2239         if error-status :error
     2240         or error-status :get-message(1) <> ""
     2241         then do:
     2242           undo move_block, retry move_block.
     2243         end.
     2244         assign
     2245           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2246         no-error .
     2247         if error-status :error
     2248         or error-status :get-message(1) <> ""
     2249         then do:
     2250           undo move_block, retry move_block.
     2251         end.
     2252         if frame Dialog-Frame :scrollable = true
     2253         then do:
     2254           assign
     2255             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2256           no-error .
     2257           if error-status :error
     2258           or error-status :get-message(1) <> ""
     2259           then do:
     2260             undo move_block, retry move_block.
     2261           end.
     2262         end.
     2263       end.
     2264       if p-move-resize
     2265       then do:
     2266         run diasize_position-resize-button in this-procedure .
     2267       end.
     2268       if v-diasize-wndstore = true
     2269       then do:
     2270         if connected("ub") = true
     2271         then do:
     2272           define variable v-cntxt-db-num        as integer   no-undo .
     2273           define variable v-cntxt-userid        as character no-undo .
     2274           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2275                                             , OUTPUT v-cntxt-userid
     2276                                             ) .
     2277           run gbl/wndsizew.p
     2278             (input  v-cntxt-db-num
     2279             ,input  v-cntxt-userid
     2280             ,input  v-diasize-proc-name
     2281             ,input  'width':u
     2282             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2283             ) .
     2284         end.
     2285       end.
     2286     end.
     2287     assign
     2288       v-diasize-change-size = false
     2289     .
     2290   end procedure.
     2291   procedure diasize_set-width :
     2292     define input  parameter p-new-width  as decimal   no-undo .
     2293     define input  parameter p-move-resize as logical   no-undo .
     2294     do
     2295     on error undo, return error return-value
     2296     :
     2297       run diasize_change-width in this-procedure
     2298         (input  (p-new-width - frame Dialog-Frame :width)
     2299         ,input  p-move-resize
     2300         ) .
     2301     end.
     2302   end procedure.
     2303   procedure diasize_position-resize-button :
     2304     do with frame Dialog-Frame
     2305     :
     2306       hide v-diasize-resize-button .
     2307       assign
     2308         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2309                     - 1
     2310                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2311         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2312                     - 1
     2313                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2314       .
     2315       view v-diasize-resize-button .
     2316     end.
     2317   end procedure.
     2318   on alt-right anywhere
     2319   do:
     2320     run diasize_change-width in this-procedure
     2321       (input 1
     2322       ,input true
     2323       ) .
     2324     return no-apply .
     2325   end.
     2326   on alt-left anywhere
     2327   do:
     2328     run diasize_change-width in this-procedure
     2329       (input -1
     2330       ,input true
     2331       ) .
     2332     return no-apply .
     2333   end.
     2334   on alt-down anywhere
     2335   do:
     2336     run diasize_change-height in this-procedure
     2337       (input 1
     2338       ,input true
     2339       ) .
     2340     return no-apply .
     2341   end.
     2342   on alt-up anywhere
     2343   do:
     2344     run diasize_change-height in this-procedure
     2345       (input -1
     2346       ,input true
     2347       ) .
     2348     return no-apply .
     2349   end.
     2350   on alt-enter of frame Dialog-Frame
     2351   do:
     2352     run diasize_maximize in this-procedure
     2353       (input  ?
     2354       ).
     2355     return no-apply .
     2356   end.
     2357   procedure diasize_end-move :
     2358     do
     2359     on error undo, return error return-value
     2360     :
     2361       define variable v-row-delta as decimal   no-undo .
     2362       define variable v-col-delta as decimal   no-undo .
     2363       define variable v-new-row as decimal   no-undo .
     2364       define variable v-new-col as decimal   no-undo .
     2365       assign
     2366         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2367         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2368       .
     2369       assign
     2370         v-row-delta = v-new-row - frame Dialog-Frame :height
     2371         v-col-delta = v-new-col - frame Dialog-Frame :width
     2372       .
     2373       run diasize_change-height in this-procedure
     2374         (input v-row-delta
     2375         ,input true
     2376         ) .
     2377       run diasize_change-width in this-procedure
     2378         (input v-col-delta
     2379         ,input true
     2380         ) .
     2381     end.
     2382   end procedure.
     2383   procedure diasize_maximize :
     2384     define input  parameter p-action as logical   no-undo .
     2385     do
     2386     on error undo, return error return-value
     2387     :
     2388       if p-action = ?
     2389       then do:
     2390         if v-diasize-need-maximize = true
     2391         then do:
     2392           assign
     2393             p-action = true
     2394           .
     2395         end.
     2396         else do:
     2397           assign
     2398             p-action = false
     2399           .
     2400         end.
     2401       end.
     2402       if p-action = true
     2403       then do:
     2404         run diasize_change-height in this-procedure
     2405           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2406               - frame Dialog-Frame :height-chars
     2407           ,input true
     2408           ) .
     2409         run diasize_change-width in this-procedure
     2410           (input session :width-chars
     2411               - frame Dialog-Frame :width-chars
     2412           ,input true
     2413           ) .
     2414         assign
     2415           v-diasize-need-maximize = false
     2416         .
     2417       end.
     2418       else do:
     2419         run diasize_change-width in this-procedure
     2420           (input v-diasize-orig-frame-width
     2421               - frame Dialog-Frame :width-chars
     2422           ,input true
     2423           ) .
     2424         run diasize_change-height in this-procedure
     2425           (input v-diasize-orig-frame-height
     2426               - frame Dialog-Frame :height-chars
     2427           ,input true
     2428           ) .
     2429         assign
     2430           v-diasize-need-maximize = true
     2431         .
     2432       end.
     2433     end.
     2434   end procedure.
     2435   procedure diasize_restore-orig-size :
     2436     do
     2437     on error undo, return error return-value
     2438     :
     2439       assign
     2440         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2441         v-diasize-current-frame-height = frame Dialog-Frame :height
     2442       .
     2443       run diasize_set-height in this-procedure
     2444         (input  v-diasize-orig-frame-height
     2445         ,input  true
     2446         ) .
     2447       run diasize_set-width in this-procedure
     2448         (input  v-diasize-orig-frame-width
     2449         ,input  true
     2450         ) .
     2451     end.
     2452   end procedure.
     2453   procedure diasize_restore-current-size :
     2454     do
     2455     on error undo, return error return-value
     2456     :
     2457       run diasize_set-height in this-procedure
     2458         (input  v-diasize-current-frame-height
     2459         ,input  true
     2460         ) .
     2461       run diasize_set-width in this-procedure
     2462         (input  v-diasize-current-frame-width
     2463         ,input  true
     2464         ) .
     2465     end.
     2466   end procedure.
     2467   procedure diasize_set-browse-handle :
     2468     define input  parameter p-browse-handle as handle   no-undo .
     2469     define buffer buf_temp-browse-handle for temp-browse-handle .
     2470     do
     2471     on error undo, return error return-value
     2472     :
     2473       assign
     2474         v-diasize-browse-handle = p-browse-handle
     2475       .
     2476       for each buf_temp-browse-handle
     2477       on error undo, return error return-value
     2478       :
     2479         delete buf_temp-browse-handle .
     2480       end.
     2481     end.
     2482   end procedure.
     2483   procedure diasize_add_browse :
     2484     define input  parameter p-browse-type   as character no-undo .
     2485     define input  parameter p-browse-handle as handle    no-undo .
     2486     define buffer buf_temp-browse-handle for temp-browse-handle .
     2487     do
     2488     on error undo, return error return-value
     2489     :
     2490       assign
     2491         v-diasize-browse-number = v-diasize-browse-number + 1
     2492       .
     2493       create buf_temp-browse-handle .
     2494       assign
     2495         buf_temp-browse-handle.browse-type   = p-browse-type
     2496         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2497         buf_temp-browse-handle.browse-handle = p-browse-handle
     2498       .
     2499     end.
     2500   end procedure.
     2501   procedure diasize_init :
     2502     define variable v-default-value    as logical   no-undo .
     2503     define variable v-restore-saved    as logical   no-undo .
     2504     define variable v-resize-value-str as character no-undo .
     2505     do
     2506     on error undo, return error return-value
     2507     :
     2508       do with frame Dialog-Frame
     2509       :
     2510         assign
     2511           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2512           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2513           v-diasize-browse-handle     = browse br-c-scales :handle
     2514         .
     2515         create button v-diasize-resize-button
     2516         assign
     2517           parent        = frame Dialog-Frame :first-child
     2518           label         = "s"
     2519           height-pixels = 16
     2520           width-pixels  = 16
     2521           visible       = true
     2522           sensitive     = true
     2523           movable       = true
     2524           triggers:
     2525             on end-move persistent run diasize_end-move in this-procedure .
     2526           end triggers.
     2527         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2528         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2529         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2530         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2531         assign
     2532           v-diasize-wndmax = false
     2533         .
     2534         if connected("ub") = true
     2535         then do:
     2536           define variable v-cntxt-db-num        as integer   no-undo .
     2537           define variable v-cntxt-userid        as character no-undo .
     2538           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2539                                             , OUTPUT v-cntxt-userid
     2540                                             ) .
     2541           run gbl/wndpar_r.p
     2542             (input  v-cntxt-db-num
     2543             ,input  v-cntxt-userid
     2544             ,input  'wndmax':U
     2545             ,output v-diasize-wndmax
     2546             ,output v-default-value
     2547             ) .
     2548         end.
     2549         assign
     2550           v-diasize-wndstore = false
     2551         .
     2552         if connected("ub") = true
     2553         then do:
     2554           run gbl/wndpar_r.p
     2555             (input  v-cntxt-db-num
     2556             ,input  v-cntxt-userid
     2557             ,input  'wndstore':U
     2558             ,output v-diasize-wndstore
     2559             ,output v-default-value
     2560             ) .
     2561         end.
     2562         assign
     2563           v-diasize-proc-name = entry(1, program-name(2), '.')
     2564         .
     2565         if v-diasize-wndstore = true
     2566         then do:
     2567           assign
     2568             v-restore-saved = false
     2569           .
     2570           if connected("ub") = true
     2571           then do:
     2572             run gbl/wndsizer.p
     2573               (input  v-cntxt-db-num
     2574               ,input  v-cntxt-userid
     2575               ,input  v-diasize-proc-name
     2576               ,input  'height':u
     2577               ,output v-resize-value-str
     2578               ) .
     2579             if v-resize-value-str <> '':U
     2580             then do:
     2581               run diasize_change-height in this-procedure
     2582                 (input  integer(v-resize-value-str)
     2583                 ,input  true
     2584                 ) .
     2585               assign
     2586                 v-restore-saved = true
     2587               .
     2588             end.
     2589           end.
     2590           if connected("ub") = true
     2591           then do:
     2592             run gbl/wndsizer.p
     2593               (input  v-cntxt-db-num
     2594               ,input  v-cntxt-userid
     2595               ,input  v-diasize-proc-name
     2596               ,input  'width':u
     2597               ,output v-resize-value-str
     2598               ) .
     2599             if v-resize-value-str <> '':U
     2600             then do:
     2601               run diasize_change-width in this-procedure
     2602                 (input  integer(v-resize-value-str)
     2603                 ,input  true
     2604                 ) .
     2605               assign
     2606                 v-restore-saved = true
     2607               .
     2608             end.
     2609           end.
     2610           if v-restore-saved <> true
     2611           then do:
     2612             if v-diasize-wndmax = true
     2613             then do:
     2614               run diasize_maximize in this-procedure
     2615                 (input  true
     2616                 ) .
     2617             end.
     2618           end.
     2619         end.
     2620         else do:
     2621           if v-diasize-wndmax = true
     2622           then do:
     2623             run diasize_maximize in this-procedure
     2624               (input  true
     2625               ) .
     2626           end.
     2627         end.
     2628       end.
     2629     end.
     2630   end procedure.
     2631   procedure diasize_need-full-display :
     2632     define output parameter p-need-full-display as logical   no-undo .
     2633     do
     2634     on error undo, return error return-value
     2635     :
     2636       assign
     2637         p-need-full-display = v-diasize-need-full-display
     2638       .
     2639       assign
     2640         v-diasize-need-full-display = false
     2641       .
     2642     end.
     2643   end procedure.
     2644   procedure get-context :
     2645      define output parameter p-db-num as integer          no-undo.
     2646      define output parameter p-user-id as character        no-undo.
     2647      define variable v-login               as character    no-undo.
     2648      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2649      define buffer buf_user-login  for ub.user-login .
     2650      do
     2651      on error undo, return error
     2652      :
     2653            FIND FIRST buf_sys-ctrl no-lock.
     2654            ASSIGN
     2655               v-login = USERID("ub")
     2656               p-db-num = buf_sys-ctrl.db-num
     2657            .
     2658            FIND FIRST buf_user-login
     2659                 WHERE buf_user-login.db-num = p-db-num
     2660                   AND buf_user-login.user-login = v-login
     2661                 no-lock
     2662                 no-error
     2663                 .
     2664            IF AVAILABLE buf_user-login
     2665            THEN DO:
     2666               assign
     2667                  p-user-id = buf_user-login.user-id
     2668               .
     2669            END.
     2670      end.
     2671   end procedure.
     2672   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2673   on f5 of frame Dialog-Frame anywhere
     2674   do:
     2675     v-doc-rec = recid(X_c-scales). run openbr in this-procedure ( INPUT yes, input no, input '':U). reposition br-c-scales to recid v-doc-rec no-error.
     2676       apply "VALUE-CHANGED" to BR-c-scales.
     2677   end.
     2678   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2679   do:
     2680     BR-c-scales :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2681   end.
     2682   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2683   procedure set-filter-name :
     2684   define input parameter p-filter-name as character no-undo .
     2685     do with frame Dialog-Frame:
     2686       if p-filter-name > "" then do:
     2687         assign
     2688           frame Dialog-Frame:title
     2689             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2690         .
     2691         assign
     2692           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2693         .
     2694       end.
     2695       else do:
     2696         assign
     2697           b-sch :tooltip = ""
     2698         .
     2699       end.
     2700     end.
     2701   end procedure.
     2702   def var sort-labelbr-c-scales   as character no-undo .
     2703   def var sort-clmnbr-c-scales    as handle    no-undo .
     2704   def var cur-clmnbr-c-scales     as handle    no-undo .
     2705   def var cur-clmn-locbr-c-scales as integer   no-undo .
     2706   def var re-querybr-c-scales     as logical   initial no no-undo .
     2707   on start-search, ctrl-o of br-c-scales in frame Dialog-Frame do:
     2708      run sort-brbr-c-scales
     2709        (input (if available X_c-scales
     2710                then recid(X_c-scales)
     2711                else ?
     2712               )
     2713        ).
     2714   end.
     2715   PROCEDURE sort-brbr-c-scales :
     2716     define input parameter p-recid as recid no-undo .
     2717     if re-querybr-c-scales = no then do:
     2718       assign
     2719          cur-clmnbr-c-scales = br-c-scales:current-column in frame Dialog-Frame
     2720       .
     2721       if sort-clmnbr-c-scales <> ? then sort-clmnbr-c-scales:column-fgcolor = 0.
     2722       if cur-clmnbr-c-scales = sort-clmnbr-c-scales then do:
     2723         assign
     2724            sort-labelbr-c-scales = ""
     2725            sort-clmnbr-c-scales = ?
     2726         .
     2727        end.
     2728        else do:
     2729          assign
     2730            sort-labelbr-c-scales = cur-clmnbr-c-scales:label
     2731            sort-clmnbr-c-scales  = cur-clmnbr-c-scales
     2732            sort-clmnbr-c-scales:column-fgcolor = 4
     2733          .
     2734        end.
     2735      end.
     2736     assign
     2737       cur-clmn-locbr-c-scales = 1
     2738     .
     2739     def var column-handle as handle no-undo .
     2740     column-handle = br-c-scales:first-column.
     2741     do while valid-handle(column-handle) :
     2742       if column-handle = cur-clmnbr-c-scales then do:
     2743         leave .
     2744       end.
     2745       column-handle = column-handle:NEXT-COLUMN.
     2746       assign
     2747         cur-clmn-locbr-c-scales = cur-clmn-locbr-c-scales + 1
     2748       .
     2749     end.
     2750     case sort-labelbr-c-scales:
     2751           when X_c-scales.corr-date:label in browse br-c-scales then DO:    assign       sort-column-name = "X_c-scales.corr-date"     .     run OpenBr in this-procedure ( INPUT yes, input no, input '':U).   . END.
     2752       otherwise do:
     2753         assign
     2754           sort-column-name = ""
     2755         .
     2756         run OpenBr in this-procedure ( INPUT yes, input no, input '':U).
     2757         if sort-labelbr-c-scales <> "" then do:
     2758           assign
     2759             cur-clmnbr-c-scales:column-fgcolor = 0
     2760           .
     2761         end.
     2762         assign
     2763           cur-clmn-locbr-c-scales = ?
     2764         .
     2765       end.
     2766     end case.
     2767     if p-recid <> ? then do:
     2768       reposition br-c-scales to recid p-recid no-error.
     2769       apply "value-changed" to br-c-scales in frame Dialog-Frame.
     2770     end.
     2771     apply "entry" to br-c-scales in frame Dialog-Frame.
     2772   END PROCEDURE.
     2773   procedure re-open-query-srt-clmnbr-c-scales:
     2774   if cur-clmnbr-c-scales = ? then do:
     2775      run OpenBr in this-procedure ( INPUT yes, input no, input '':U).
     2776   end.
     2777   else do:
     2778      assign re-querybr-c-scales = yes.
     2779      run sort-brbr-c-scales
     2780        (input (if available X_c-scales
     2781                then recid(X_c-scales)
     2782                else ?
     2783               )
     2784        ).
     2785      assign re-querybr-c-scales = no.
     2786   end.
     2787   end.
     2788   MAIN-BLOCK:
     2789   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2790      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2791     CASE parref-mode:
     2792      WHEN 'все':U        THEN DO:
     2793      END.
     2794      WHEN "one":U THEN DO:
     2795        find first X_scales no-lock where
     2796                   X_scales.db-num = pardb-num
     2797              AND  X_scales.scales-num = parscales-num no-error .
     2798        if not available X_scales then do:
     2799           message
     2800           vss-workfile vss-revision vss-description skip
     2801           "Неверный значение параметров pardb-num parscales-num"
     2802           view-as alert-box ERROR.
     2803           return.
     2804        end.
     2805      END.
     2806      otherwise do:
     2807         message vss-workfile vss-revision vss-description skip
     2808         "Неверный вызов - parref-mode=" parref-mode
     2809         view-as alert-box ERROR.
     2810         return.
     2811       end.
     2812     end case.
     2813     v-rid-list = p-rid-list.
     2814     RUN MyEnable.
     2815     HIDE mark-num in frame Dialog-Frame .
     2816     run OpenBR in this-procedure ( INPUT yes, input no, input '':U).
     2817     run diasize_add_browse in this-procedure
     2818       (input  'width':u
     2819       ,input  browse br-changes :handle
     2820       ) .
     2821     run diasize_init in this-procedure .
     2822     WAIT-FOR GO OF FRAME Dialog-Frame.
     2823   END.
     2824   RUN disable_UI.
     2825   PROCEDURE disable_UI :
     2826     HIDE FRAME Dialog-Frame.
     2827   END PROCEDURE.
     2828   PROCEDURE enable_UI :
     2829     DISPLAY mark-num
     2830         WITH FRAME Dialog-Frame.
     2831     ENABLE b-quit B-mark b-sel B-sch B-Help mark-num BR-c-scales BR-changes
     2832         WITH FRAME Dialog-Frame.
     2833     VIEW FRAME Dialog-Frame.
     2834   END PROCEDURE.
     2835   PROCEDURE MyEnable :
     2836   br-changes:title in frame Dialog-Frame  = "":U.
     2837   assign
     2838   temp-changes.l_name:resizable in browse br-changes = true
     2839   temp-changes.v_old:resizable in browse br-changes = true
     2840   temp-changes.v_new:resizable in browse br-changes = true
     2841   temp-changes.l_name:width in browse br-changes = 30
     2842   temp-changes.v_old:width in browse br-changes = 40
     2843   temp-changes.v_new:width in browse br-changes = 40
     2844   .
     2845   DISPLAY
     2846   mark-num
     2847   br-changes
     2848   WITH FRAME Dialog-Frame.
     2849   ENABLE
     2850   B-quit
     2851   B-mark when lookup('b-mark':U, bttns) >0
     2852   B-sel when lookup('b-sel':U, bttns) >0
     2853   B-sch
     2854   B-Help
     2855   BR-c-scales
     2856   br-changes
     2857   mark-num
     2858   WITH FRAME Dialog-Frame.
     2859   VIEW FRAME Dialog-Frame.
     2860   END PROCEDURE.
     2861   PROCEDURE OpenBr :
     2862   define input  parameter p-open-query     as logical   no-undo .
     2863   define input  parameter p-find-next      as logical   no-undo .
     2864   define input  parameter p-find-condition as character no-undo .
     2865   define variable l-query-was-opened as logical no-undo .
     2866   define variable sort-column-phrase as character no-undo .
     2867   case sort-column-name :
     2868     when "" then do:
     2869       assign
     2870         sort-column-phrase = ""
     2871       .
     2872     end.
     2873     otherwise do:
     2874       assign
     2875         sort-column-phrase = "by " + sort-column-name
     2876       .
     2877     end.
     2878   end case.
     2879   CASE parref-mode:
     2880       when 'все':U then do:
     2881           ASSIGN frame Dialog-Frame:TITLE = "Справочник истории весов"
     2882           filter-point = filter-point0 + parref-mode
     2883           filter-label = substitute("&1", filter-label0)
     2884           .
     2885   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2886   define variable  l-disable-where-21  as logical   no-undo .
     2887   define variable  l-filter-open-21    as logical   .
     2888   define variable  flt-rec-21       as recid     no-undo .
     2889   define variable  filter-name-21      as character no-undo .
     2890   define variable  where-phrase-21     as character no-undo .
     2891   define variable  sort-phrase-21      as character no-undo .
     2892   define variable  where-phrase-rus-21 as character no-undo .
     2893   define variable  sort-phrase-rus-21  as character no-undo .
     2894     run waitfram-show in this-procedure
     2895       (input "ЖДИТЕ ..."
     2896       ).
     2897   run gbl/flt-get.p
     2898     (input filter-point
     2899     ,output flt-rec-21
     2900     ,output filter-name-21
     2901     ,output where-phrase-21
     2902     ,output sort-phrase-21
     2903     ,output where-phrase-rus-21
     2904     ,output sort-phrase-rus-21
     2905     ).
     2906       run set-filter-name in this-procedure
     2907         (INPUT filter-name-21
     2908         ) no-error .
     2909     assign
     2910       l-filter-open-21 = false
     2911     .
     2912     if flt-rec-21 <> ?
     2913       or sort-column-phrase > ""
     2914     then do:
     2915       define variable  parameter-2-21 as character no-undo .
     2916       define variable  parameter-3-21 as character no-undo .
     2917       define variable  parameter-4-21 as character no-undo .
     2918       define variable  parameter-5-21 as character no-undo .
     2919       define variable  parameter-6-21 as character no-undo .
     2920       define variable  parameter-7-21 as character no-undo .
     2921         assign
     2922         parameter-3-21 =
     2923                                 "FOR EACH X_c-scales"
     2924         parameter-4-21 =
     2925           (
     2926             if (" TRUE " + " " + where-phrase-21) <> ""
     2927             then " TRUE " + " " + where-phrase-21
     2928             else "true"
     2929           )
     2930         parameter-5-21 = (" " + "" + " " + "")
     2931         parameter-6-21 = if sort-phrase-21 = ''
     2932                              then
     2933           (
     2934           " " + "  " +
     2935             " " + sort-column-phrase +
     2936           " " + "  "
     2937           )
     2938                              else
     2939           (
     2940           " " + "  " +
     2941             " " + sort-column-phrase +
     2942           " " + sort-phrase-21
     2943           )
     2944         parameter-7-21 =
     2945           "   "
     2946       .
     2947       do
     2948       on stop undo, leave
     2949       on error undo, leave
     2950       :
     2951         assign
     2952           l-disable-where-21 =
     2953             (" TRUE " + " " + where-phrase-21 = "")
     2954         .
     2955         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2956                             ,input query br-c-scales:handle
     2957                             ,input parameter-3-21
     2958                             ,input parameter-4-21
     2959                             ,input parameter-5-21
     2960                             ,input parameter-6-21
     2961                             ,input parameter-7-21
     2962                             )
     2963         .
     2964         assign
     2965           l-filter-open-21 = true
     2966         .
     2967       end.
     2968       if l-filter-open-21 = false then do:
     2969         message
     2970           "Ошибка при фильтрации / сортировке" skip
     2971           "Будут показаны записи без учета фильтра" skip
     2972           view-as alert-box .
     2973       end.
     2974       else do:
     2975           assign
     2976             l-query-was-opened = true
     2977           .
     2978       end.
     2979     end.
     2980     if l-filter-open-21 = false then do:
     2981       OPEN QUERY br-c-scales FOR EACH X_c-scales
     2982         where  TRUE
     2983     .
     2984         assign
     2985           l-query-was-opened = true
     2986         .
     2987     end.
     2988     run waitfram-hide in this-procedure .
     2989       end.
     2990       when "one":U then do:
     2991           ASSIGN frame Dialog-Frame:TITLE = substitute("Справочник истории весов: БД &1 весы N&2"
     2992                                                          ,pardb-num
     2993                                                          ,parscales-num)
     2994           filter-point = filter-point0 + parref-mode
     2995           filter-label = substitute("&1 Одни весы", filter-label0)
     2996           .
     2997   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2998   define variable  l-disable-where-23  as logical   no-undo .
     2999   define variable  l-filter-open-23    as logical   .
     3000   define variable  flt-rec-23       as recid     no-undo .
     3001   define variable  filter-name-23      as character no-undo .
     3002   define variable  where-phrase-23     as character no-undo .
     3003   define variable  sort-phrase-23      as character no-undo .
     3004   define variable  where-phrase-rus-23 as character no-undo .
     3005   define variable  sort-phrase-rus-23  as character no-undo .
     3006     run waitfram-show in this-procedure
     3007       (input "ЖДИТЕ ..."
     3008       ).
     3009   run gbl/flt-get.p
     3010     (input filter-point
     3011     ,output flt-rec-23
     3012     ,output filter-name-23
     3013     ,output where-phrase-23
     3014     ,output sort-phrase-23
     3015     ,output where-phrase-rus-23
     3016     ,output sort-phrase-rus-23
     3017     ).
     3018       run set-filter-name in this-procedure
     3019         (INPUT filter-name-23
     3020         ) no-error .
     3021     assign
     3022       l-filter-open-23 = false
     3023     .
     3024     if flt-rec-23 <> ?
     3025       or sort-column-phrase > ""
     3026     then do:
     3027       define variable  parameter-2-23 as character no-undo .
     3028       define variable  parameter-3-23 as character no-undo .
     3029       define variable  parameter-4-23 as character no-undo .
     3030       define variable  parameter-5-23 as character no-undo .
     3031       define variable  parameter-6-23 as character no-undo .
     3032       define variable  parameter-7-23 as character no-undo .
     3033         assign
     3034         parameter-3-23 =
     3035                                 "FOR EACH X_c-scales"
     3036         parameter-4-23 =
     3037           (
     3038             if (" X_c-scales.db-num = pardb-num AND X_c-scales.scales-num = parscales-num" + " " + where-phrase-23) <> ""
     3039             then  substitute('X_c-scales.db-num = &1 AND X_c-scales.scales-num = &2', pardb-num, parscales-num) + " " + where-phrase-23
     3040             else "true"
     3041           )
     3042         parameter-5-23 = (" " + "" + " " + "")
     3043         parameter-6-23 = if sort-phrase-23 = ''
     3044                              then
     3045           (
     3046           " " + "  " +
     3047             " " + sort-column-phrase +
     3048           " " + "  "
     3049           )
     3050                              else
     3051           (
     3052           " " + "  " +
     3053             " " + sort-column-phrase +
     3054           " " + sort-phrase-23
     3055           )
     3056         parameter-7-23 =
     3057           "   "
     3058       .
     3059       do
     3060       on stop undo, leave
     3061       on error undo, leave
     3062       :
     3063         assign
     3064           l-disable-where-23 =
     3065             (" X_c-scales.db-num = pardb-num AND X_c-scales.scales-num = parscales-num" + " " + where-phrase-23 = "")
     3066         .
     3067         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3068                             ,input query br-c-scales:handle
     3069                             ,input parameter-3-23
     3070                             ,input parameter-4-23
     3071                             ,input parameter-5-23
     3072                             ,input parameter-6-23
     3073                             ,input parameter-7-23
     3074                             )
     3075         .
     3076         assign
     3077           l-filter-open-23 = true
     3078         .
     3079       end.
     3080       if l-filter-open-23 = false then do:
     3081         message
     3082           "Ошибка при фильтрации / сортировке" skip
     3083           "Будут показаны записи без учета фильтра" skip
     3084           view-as alert-box .
     3085       end.
     3086       else do:
     3087           assign
     3088             l-query-was-opened = true
     3089           .
     3090       end.
     3091     end.
     3092     if l-filter-open-23 = false then do:
     3093       OPEN QUERY br-c-scales FOR EACH X_c-scales
     3094         where  X_c-scales.db-num = pardb-num AND X_c-scales.scales-num = parscales-num
     3095     .
     3096         assign
     3097           l-query-was-opened = true
     3098         .
     3099     end.
     3100     run waitfram-hide in this-procedure .
     3101       end.
     3102       when "one-subject":U then do:
     3103           ASSIGN frame Dialog-Frame:TITLE = substitute("Справочник истории весов: БД &1 весы N&2 &3"
     3104                                                          , pardb-num
     3105                                                          , parscales-num
     3106                                                          , p-subject
     3107                                                          )
     3108           filter-point = filter-point0 + parref-mode
     3109           filter-label = substitute("&1 Одни весы, Предмет изменений", filter-label0)
     3110           .
     3111   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3112   define variable  l-disable-where-25  as logical   no-undo .
     3113   define variable  l-filter-open-25    as logical   .
     3114   define variable  flt-rec-25       as recid     no-undo .
