     3137     .
     3138     if flt-rec-25 <> ?
     3139       or sort-column-phrase > ""
     3140     then do:
     3141       define variable  parameter-2-25 as character no-undo .
     3142       define variable  parameter-3-25 as character no-undo .
     3143       define variable  parameter-4-25 as character no-undo .
     3144       define variable  parameter-5-25 as character no-undo .
     3145       define variable  parameter-6-25 as character no-undo .
