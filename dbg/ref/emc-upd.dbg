        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   define input parameter p-mode as character no-undo.
        3   define input-output parameter p-rid as recid init ? no-undo.
        4   define buffer codeupdate for code .
        5   define variable vss-revision    as character no-undo init "$Revision: $":U .
        6   define variable vss-author      as character no-undo init "$Author: $":U .
        7   define variable vss-date        as character no-undo init "$Date: $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: $":U .
       10   define variable vss-description as character no-undo init "Карточка Код ОКЕИ код ККТ".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   define variable v-db-num like ub.db.db-num no-undo .
      117   .
      118   DEFINE BUTTON B-Help
      119        LABEL "Помо&щь"
      120        SIZE 10 BY 1
      121        BGCOLOR 8 .
      122   DEFINE BUTTON b-quit AUTO-END-KEY
      123        LABEL "&Отмена"
      124        SIZE 10 BY 1
      125        BGCOLOR 8 .
      126   DEFINE BUTTON B-save AUTO-GO
      127        LABEL "&Ввод"
      128        SIZE 10 BY 1
      129        BGCOLOR 8 .
      130   DEFINE VARIABLE mNAIM AS CHARACTER FORMAT "X(256)":U
      131        LABEL "Наименование"
      132        VIEW-AS FILL-IN
      133        SIZE 40 BY 1 NO-UNDO.
      134   DEFINE VARIABLE mOKEI AS INTEGER FORMAT ">>>>>999":U INITIAL 0
      135        LABEL "Код"
      136        VIEW-AS FILL-IN
      137        SIZE 14 BY 1 NO-UNDO.
      138   DEFINE FRAME Dialog-Frame
      139        B-save AT ROW 1 COL 1
      140        b-quit AT ROW 1 COL 11
      141        B-Help AT ROW 1 COL 36
      142        mOKEI AT ROW 2.5 COL 18 COLON-ALIGNED WIDGET-ID 2
      143        mNAIM AT ROW 5 COL 18 COLON-ALIGNED WIDGET-ID 8
      144        SPACE(18.24) SKIP(0.62)
      145       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      146            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      147            TITLE "Редактирование ЕМЦ"
      148            DEFAULT-BUTTON B-save CANCEL-BUTTON b-quit.
      149   ASSIGN
      150          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      151          FRAME Dialog-Frame:HIDDEN           = TRUE.
      152   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      153   DO:
      154     APPLY "END-ERROR":U TO SELF.
      155   END.
      156   ON CHOOSE OF B-save IN FRAME Dialog-Frame
      157   DO:
      158     Assign
      159     mOKEI
      160     mNAIM
      161         .
      162       if mNAIM = "" then do:
      163         message "Введите Наименование ! " view-as  alert-box  error.
      164         apply "entry"  to mNAIM .
      165         return no-apply.
      166       end.
      167       if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      168         create code.
      169       end.
      170       if p-mode = 'ДОБАВЛЕНИЕ':U OR p-mode = 'ИЗМЕНЕНИЕ':U  then
      171          Assign
      172             code.code = string(mOKEI)
      173             code.codename = mNAIM
      174             p-rid = recid(code)
      175             .
      176        else p-rid = ? .
      177   END.
      178   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      179   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      180   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      181   on help of frame Dialog-Frame
      182   do:
      183     run gbl/app_help.p
      184       (input this-procedure :file-name
      185       ,input ''
      186       ,input ?
      187       ) no-error.
      188     if error-status :error then do:
      189       message
      190         "Ошибка при вызове помощи"
      191         error-status :get-message(1)
      192         view-as alert-box .
      193     end.
      194   end.
      195   run minbtn-set in this-procedure .
      196   on choose of b-help in frame Dialog-Frame
      197   do:
      198     apply "help":u to frame Dialog-Frame .
      199   end.
      200   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      201   procedure minbtn-set :
      202       do
      203           on error undo, return error return-value
      204           :
      205           define variable ii              as integer       no-undo .
      206           define variable fh              as widget-handle no-undo .
      207           define variable hh              as widget-handle no-undo .
      208           define variable v-h             as handle        extent 4 no-undo .
      209           define variable v-name-button   as character     no-undo .
      210           define variable v-help-old-x    as decimal       no-undo .
      211           define variable v-help-old-y    as decimal       no-undo .
      212           define variable v-help-old-size as decimal       no-undo .
      213           define variable v-frame-width   as decimal       no-undo .
      214           define variable jj              as integer       no-undo .
      215           do
      216               on error undo, return error
      217               :
      218               assign
      219                   v-frame-width = frame Dialog-Frame:width - 0.3
      220                   fh            = frame Dialog-Frame:first-child
      221                   hh            = fh:first-child
      222                   ii            = 1
      223                   .
      224               do while valid-handle(hh):
      225                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      226                   do:
      227                       case lc(hh:name) :
      228                           when "b-help" then
      229                               do:
      230                                   hh:load-image-up("cmp/b-help.bmp":u) .
      231                                   hh:load-image-down("cmp/b-help.bmp":u) .
      232                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      233                                   hh:TOOLTIP = "Помощь" .
      234                                   v-help-old-x = hh:column .
      235                                   v-help-old-y = hh:row    .
      236                                   v-help-old-size = hh:width .
      237                                   hh:width-chars = 2.5 .
      238                               end.
      239                           when "b-print" then
      240                               do:
      241                                   hh:load-image("cmp/b-print.bmp":u) .
      242                                   hh:TOOLTIP = "Печать" .
      243                                   v-h[ii] = hh:handle .
      244                                   ii = ii + 1 .
      245                                   hh:width-chars = 3 .
      246                               end.
      247                           when "b-history" or
      248                           when "b-hist" then
      249                               do:
      250                                   hh:load-image("cmp/b-hist.bmp":u) .
      251                                   hh:TOOLTIP = "История" .
      252                                   v-h[ii] = hh:handle .
      253                                   ii = ii + 1 .
      254                                   hh:width-chars = 3 .
      255                               end.
      256                           when "b-sch" then
      257                               do:
      258                                   hh:load-image("cmp/b-sch.bmp":u) .
      259                                   hh:TOOLTIP = "Установка Фильтра" .
      260                                   v-h[ii] = hh:handle .
      261                                   ii = ii + 1 .
      262                                   hh:width-chars = 3 .
      263                               end.
      264                           when "b-hist-user" then
      265                               do:
      266                                   hh:load-image("cmp/b-hist.bmp":u) .
      267                                   hh:TOOLTIP = "История пользователя" .
      268                                   ii = ii + 1 .
      269                               end.
      270                       end case.
      271                   end.
      272                   hh = hh:next-sibling.
      273               end.
      274               b-help:column = v-frame-width - b-help:width-chars.
      275               jj = 0.
      276               repeat ii = 4 to 1 by -1 :
      277                   if valid-handle (v-h[ii] ) then
      278                   do:
      279                       jj  = jj + 1 .
      280                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      281                       v-h[ii]:row    = v-help-old-y .
      282                   end.
      283               end.
      284           end.
      285       end.
      286   end procedure.
      287   MAIN-BLOCK:
      288   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      289      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      290      if p-mode <> 'ДОБАВЛЕНИЕ':U and
      291         p-mode <> 'ИЗМЕНЕНИЕ':U
      292      then do:
      293         message
      294         vss-workfile vss-revision vss-description skip
      295         "Неверное значение параметров вызова p-mode"  p-mode
      296         view-as alert-box ERROR.
      297         undo, return error.
      298      end.
      299   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      300   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      301     (output v-db-num
      302     )  .
      303      if v-db-num <> 0 then do:
      304         message
      305         vss-workfile vss-revision vss-description skip
      306         "Неверное значение параметров вызова p-mode - нельзя изменять/добавлять записи <Тип ЕМЦ Код> в УБД"
      307         view-as alert-box ERROR.
      308         undo, return error.
      309      end.
      310      if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      311         find first code where
      312                    recid(code) = p-rid exclusive-lock no-wait no-error.
      313         if locked code then do:
      314            message
      315               vss-workfile vss-revision vss-description skip
      316               "Запись <Тип ЕМЦ - Код> занята"
      317            view-as alert-box error .
      318            undo, return error.
      319         end.
      320         if not available code then do:
      321            message
      322               vss-workfile vss-revision vss-description skip
      323               "Не найдена запись <Тип ЕМЦ - Код>"
      324            view-as alert-box error .
      325            undo, return error.
      326         end.
      327         assign
      328            mOKEI = int(code.code)
      329            mNAIM = Code.CodeName
      330         .
      331      end.
      332      run enable_UI in this-procedure .
      333      if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      334         ENABLE mOKEI WITH FRAME Dialog-Frame.
      335         apply "entry" to mOKEI in FRAME Dialog-Frame.
      336      end.
      337      WAIT-FOR GO OF FRAME Dialog-Frame.
      338   END.
      339   session:data-entry-return = no .
      340   RUN disable_UI.
      341   PROCEDURE disable_UI :
      342     HIDE FRAME Dialog-Frame.
      343   END PROCEDURE.
      344   PROCEDURE enable_UI :
      345     DISPLAY mOKEI mNAIM
      346         WITH FRAME Dialog-Frame.
      347     ENABLE B-save b-quit B-Help mNAIM
      348         WITH FRAME Dialog-Frame.
      349     VIEW FRAME Dialog-Frame.
      350     if p-mode = 'ДОБАВЛЕНИЕ':U
      351     then ENABLE  mOKEI
      352         WITH FRAME Dialog-Frame.
      353     VIEW FRAME Dialog-Frame.
      354   END PROCEDURE.
      355   PROCEDURE proc-save :
      356      define buffer units for units.
      357      assign frame Dialog-Frame
      358         mOKEI
      359         mNAIM
      360         .
      361      do on error undo, return error
      362      on stop undo, return error:
      363         if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      364            find first code where
      365                       code.parent = "EMC"
      366                   and code.code   = string(mOKEI)
      367            no-lock no-error.
      368            if avail code then do:
      369               message
      370                  "Уже есть такая запись Тип ЕМЦ Код :" mOKEI
      371               view-as alert-box error .
      372               return error.
      373            end.
      374            create code.
      375            assign
      376               code.parent = "EMC"
      377               code.code   = string(mOKEI, fill("9", max(length(string(mOKEI)), 3)))
      378               code.codename   = string(mNAIM, fill("9", max(length(string(mNAIM)), 3)))
      379               code.nwsgbd = yes
      380            .
      381         end.
      382      end.
      383      p-rid = recid(code).
      384   END PROCEDURE.
