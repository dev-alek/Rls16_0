     1235   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1236   DO:
     1237     define variable loc#log as logical no-undo .
     1238     if available X_tare then do:
     1239   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1240   define variable v-str-recid14 as character no-undo .
     1241   define variable v-num-entry14 as integer   no-undo .
     1242   assign
     1243     v-str-recid14 = trim( string( recid( X_tare ) , "->>>>>>>>>>>9":U ) )
     1244     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1245   .
     1246   if v-num-entry14 > 0 then do:
     1247     assign
     1248       entry( v-num-entry14, v-rid-list ) = "":U
     1249       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1250     .
     1251   end.
     1252   else do:
     1253     assign
     1254       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1255     .
     1256   end.
     1257       loc#log = br-tares:refresh() .
     1258       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1259           loc#log = br-tares:select-next-row ().
     1260           apply "VALUE-CHANGED" to br-tares in frame Dialog-Frame.
     1261       end.
     1262       if num-entries( v-rid-list ) = 0
     1263       then
     1264           hide mark-num in frame Dialog-Frame.
     1265       else
     1266           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1267     end.
     1268     apply "entry" to br-tares in frame Dialog-Frame.
     1269   END.
