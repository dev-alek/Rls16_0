     3005                             ,input query br-tares:handle
     3006                             ,input parameter-3-32
     3007                             ,input parameter-4-32
     3008                             ,input parameter-5-32
     3009                             ,input parameter-6-32
     3010                             ,input parameter-7-32
     3011                             )
     3012         .
     3013         assign
     3014           l-filter-open-32 = true
     3015         .
     3016       end.
     3017       if l-filter-open-32 = false then do:
