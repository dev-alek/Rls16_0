     3076             if (" true " + " " + where-phrase-32) <> ""
     3077             then " true " + " " + where-phrase-32
     3078             else "true"
     3079           )
     3080         parameter-5-32 = (" " + "" + " " + "" + " " + p-find-condition)
     3081         parameter-6-32 = if sort-phrase-32 = ''
     3082                              then
     3083           (
     3084           " " + "  " +
     3085             " " + sort-column-phrase +
     3086           " " + "  "
     3087           )
