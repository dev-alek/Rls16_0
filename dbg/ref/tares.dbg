     3098                             input this-procedure:handle
     3099                             ,input query br-tares:handle
     3100                             ,input logical(parameter-2-32)
     3101                             ,input no-lock
     3102                             ,input parameter-3-32
     3103                             ,input parameter-4-32
     3104                             ,input parameter-5-32
     3105                             ,input parameter-6-32
     3106                             ,input parameter-7-32
     3107                             ,output v-fltopend-rowid
     3108                             ) no-error.
     3109         .
     3110         v-doc-rec = ?.
     3111       end.
     3112       assign
