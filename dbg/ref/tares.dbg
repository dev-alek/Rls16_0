     2949     ,output where-phrase-32
     2950     ,output sort-phrase-32
     2951     ,output where-phrase-rus-32
     2952     ,output sort-phrase-rus-32
     2953     ).
     2954   if p-open-query then do:
     2955       run set-filter-name in this-procedure
     2956         (INPUT filter-name-32
     2957         ) no-error .
     2958     assign
     2959       l-filter-open-32 = false
     2960     .
     2961     if flt-rec-32 <> ?
     2962       or sort-column-phrase > ""
     2963     then do:
     2964       define variable  parameter-2-32 as character no-undo .
     2965       define variable  parameter-3-32 as character no-undo .
     2966       define variable  parameter-4-32 as character no-undo .
     2967       define variable  parameter-5-32 as character no-undo .
     2968       define variable  parameter-6-32 as character no-undo .
     2969       define variable  parameter-7-32 as character no-undo .
     2970         assign
     2971         parameter-3-32 =
     2972                                 "FOR EACH X_tare"
     2973         parameter-4-32 =
     2974           (
     2975             if (" true " + " " + where-phrase-32) <> ""
     2976             then " true " + " " + where-phrase-32
     2977             else "true"
     2978           )
     2979         parameter-5-32 = (" " + "" + " " + "")
     2980         parameter-6-32 = if sort-phrase-32 = ''
     2981                              then
     2982           (
     2983           " " + "  " +
     2984             " " + sort-column-phrase +
