     1295     if error-status:error then return no-apply.
     1296   END.
     1297   ON VALUE-CHANGED OF RS-stts IN FRAME Dialog-Frame
     1298   DO:
     1299     ASSIGN
     1300     rs-stts
     1301     p-stts = (IF rs-stts = 'все':U THEN ? ELSE INTEGER(rs-stts))
     1302     .
     1303     RUN openbr IN THIS-PROCEDURE ( input yes, input no, input no) NO-ERROR .
     1304     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1305   END.
     1306   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1307   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1308   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1309   on help of frame Dialog-Frame
     1310   do:
     1311     run gbl/app_help.p
     1312       (input this-procedure :file-name
     1313       ,input ''
     1314       ,input ?
     1315       ) no-error.
     1316     if error-status :error then do:
     1317       message
     1318         "Ошибка при вызове помощи"
     1319         error-status :get-message(1)
     1320         view-as alert-box .
     1321     end.
     1322   end.
     1323   run minbtn-set in this-procedure .
     1324   on choose of b-help in frame Dialog-Frame
     1325   do:
     1326     apply "help":u to frame Dialog-Frame .
     1327   end.
     1328   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1329   procedure minbtn-set :
     1330       do
     1331           on error undo, return error return-value
     1332           :
     1333           define variable ii              as integer       no-undo .
     1334           define variable fh              as widget-handle no-undo .
     1335           define variable hh              as widget-handle no-undo .
     1336           define variable v-h             as handle        extent 4 no-undo .
     1337           define variable v-name-button   as character     no-undo .
     1338           define variable v-help-old-x    as decimal       no-undo .
     1339           define variable v-help-old-y    as decimal       no-undo .
     1340           define variable v-help-old-size as decimal       no-undo .
     1341           define variable v-frame-width   as decimal       no-undo .
     1342           define variable jj              as integer       no-undo .
     1343           do
     1344               on error undo, return error
     1345               :
     1346               assign
     1347                   v-frame-width = frame Dialog-Frame:width - 0.3
     1348                   fh            = frame Dialog-Frame:first-child
     1349                   hh            = fh:first-child
     1350                   ii            = 1
     1351                   .
     1352               do while valid-handle(hh):
     1353                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1354                   do:
     1355                       case lc(hh:name) :
     1356                           when "b-help" then
     1357                               do:
     1358                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1359                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1360                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1361                                   hh:TOOLTIP = "Помощь" .
     1362                                   v-help-old-x = hh:column .
     1363                                   v-help-old-y = hh:row    .
     1364                                   v-help-old-size = hh:width .
     1365                                   hh:width-chars = 2.5 .
     1366                               end.
     1367                           when "b-print" then
     1368                               do:
     1369                                   hh:load-image("cmp/b-print.bmp":u) .
     1370                                   hh:TOOLTIP = "Печать" .
     1371                                   v-h[ii] = hh:handle .
     1372                                   ii = ii + 1 .
     1373                                   hh:width-chars = 3 .
     1374                               end.
     1375                           when "b-history" or
     1376                           when "b-hist" then
     1377                               do:
     1378                                   hh:load-image("cmp/b-hist.bmp":u) .
     1379                                   hh:TOOLTIP = "История" .
     1380                                   v-h[ii] = hh:handle .
     1381                                   ii = ii + 1 .
     1382                                   hh:width-chars = 3 .
     1383                               end.
     1384                           when "b-sch" then
     1385                               do:
     1386                                   hh:load-image("cmp/b-sch.bmp":u) .
     1387                                   hh:TOOLTIP = "Установка Фильтра" .
     1388                                   v-h[ii] = hh:handle .
     1389                                   ii = ii + 1 .
     1390                                   hh:width-chars = 3 .
     1391                               end.
     1392                           when "b-hist-user" then
     1393                               do:
     1394                                   hh:load-image("cmp/b-hist.bmp":u) .
     1395                                   hh:TOOLTIP = "История пользователя" .
     1396                                   ii = ii + 1 .
     1397                               end.
     1398                       end case.
     1399                   end.
     1400                   hh = hh:next-sibling.
     1401               end.
     1402               b-help:column = v-frame-width - b-help:width-chars.
     1403               jj = 0.
     1404               repeat ii = 4 to 1 by -1 :
     1405                   if valid-handle (v-h[ii] ) then
     1406                   do:
     1407                       jj  = jj + 1 .
     1408                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1409                       v-h[ii]:row    = v-help-old-y .
     1410                   end.
     1411               end.
     1412           end.
     1413       end.
     1414   end procedure.
     1415   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1416   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1417   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1418   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1419   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1420   define variable v-diasize-current-frame-height as decimal   no-undo .
     1421   define variable v-diasize-change-size          as logical   no-undo .
     1422   define variable v-diasize-resize-button        as handle    no-undo .
     1423   define variable v-diasize-wndmax               as logical   no-undo .
     1424   define variable v-diasize-wndstore             as logical   no-undo .
     1425   define variable v-diasize-proc-name            as character no-undo .
     1426   define variable v-diasize-browse-handle        as handle    no-undo .
     1427   define variable v-diasize-browse-number        as integer   no-undo .
     1428   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1429   define temp-table temp-diasize-handle no-undo
     1430     field handle-value  as handle
     1431     field save-position as decimal
     1432     index xpk is primary unique handle-value
     1433     .
     1434   define temp-table temp-browse-handle no-undo
     1435     field browse-type   as character
     1436     field browse-number as integer
     1437     field browse-handle as handle
     1438     field original-size as decimal
     1439     index xpk is primary unique browse-type browse-number
     1440     index xie browse-type browse-handle
     1441   .
     1442   procedure diasize_change-height :
     1443     define input  parameter p-change-value  as decimal   no-undo .
     1444     define input  parameter p-move-resize   as logical   no-undo .
     1445     define variable v-field-group-handle    as handle    no-undo .
     1446     define variable v-object-handle         as handle    no-undo .
     1447     define variable v-frame-height          as decimal   no-undo .
     1448     define variable v-frame-virtual-height  as decimal   no-undo .
     1449     define variable v-browse-height         as decimal   no-undo .
     1450     define variable v-window-height         as decimal   no-undo .
     1451     define variable v-window-virtual-height as decimal   no-undo .
     1452     define variable v-change-sign           as integer   no-undo .
     1453     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1454     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1455     if p-change-value > 0
     1456     then do:
     1457       if frame Dialog-Frame :height + p-change-value
     1458           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1459       then do:
     1460         assign
     1461           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1462                           - (frame Dialog-Frame :height-chars)
     1463         .
     1464         if p-change-value <= 0
     1465         then do:
     1466           run diasize_position-resize-button in this-procedure .
     1467           return .
     1468         end.
     1469       end.
     1470     end.
     1471     if p-change-value < 0
     1472     then do:
     1473       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1474       then do:
     1475         assign
     1476           p-change-value = v-diasize-orig-frame-height
     1477                          - (frame Dialog-Frame :height-chars)
     1478         .
     1479         if p-change-value >= 0
     1480         then do:
     1481           run diasize_position-resize-button in this-procedure .
     1482           return .
     1483         end.
     1484       end.
     1485     end.
     1486     if p-change-value >= 0
     1487     then do:
     1488       assign
     1489         v-change-sign = 1
     1490       .
     1491     end.
     1492     else do:
     1493       assign
     1494         v-change-sign = -1
     1495       .
     1496     end.
     1497     assign
     1498       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1499     .
     1500     if p-change-value = 0
     1501     then do:
     1502       run diasize_position-resize-button in this-procedure .
     1503       return .
     1504     end.
     1505     move_block:
     1506     do
     1507     on error undo move_block, retry move_block
     1508     :
     1509       if retry
     1510       then do:
     1511         do
     1512         on error undo move_block, leave move_block
     1513         :
     1514           if p-change-value > 0
     1515           then do:
     1516             for each buf_temp-diasize-handle
     1517             on error undo, next
     1518             :
     1519               assign
     1520                 v-object-handle = buf_temp-diasize-handle.handle-value
     1521               .
     1522               if v-object-handle <> v-diasize-resize-button
     1523               then do:
     1524                 assign
     1525                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1526                 .
     1527               end.
     1528             end.
     1529             assign
     1530               v-diasize-browse-handle :height = v-browse-height
     1531             .
     1532             for each buf_temp-browse-handle
     1533               where buf_temp-browse-handle.browse-type = 'height':u
     1534             on error undo, next
     1535             :
     1536               assign
     1537                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1538               .
     1539             end.
     1540             assign
     1541               frame Dialog-Frame :height = v-frame-height
     1542             .
     1543             if frame Dialog-Frame :scrollable = true
     1544             then do:
     1545               assign
     1546                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1547               .
     1548             end.
     1549             run diasize_position-resize-button in this-procedure .
     1550           end.
     1551           else do:
     1552             if frame Dialog-Frame :scrollable = true
     1553             then do:
     1554               assign
     1555                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1556               .
     1557             end.
     1558             assign
     1559               frame Dialog-Frame :height = v-frame-height
     1560             .
     1561             assign
     1562               v-diasize-browse-handle :height = v-browse-height
     1563             .
     1564             for each buf_temp-browse-handle
     1565               where buf_temp-browse-handle.browse-type = 'height':u
     1566             on error undo, next
     1567             :
     1568               assign
     1569                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1570               .
     1571             end.
     1572             for each buf_temp-diasize-handle
     1573             on error undo, next
     1574             :
     1575               assign
     1576                 v-object-handle = buf_temp-diasize-handle.handle-value
     1577               .
     1578               if v-object-handle <> v-diasize-resize-button
     1579               then do:
     1580                 assign
     1581                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1582                 .
     1583               end.
     1584             end.
     1585             run diasize_position-resize-button in this-procedure .
     1586           end.
     1587           assign
     1588             v-diasize-change-size = false
     1589           .
     1590           leave move_block .
     1591         end.
     1592       end.
     1593       assign
     1594         v-diasize-need-full-display = true
     1595       .
     1596       if v-diasize-change-size = false
     1597       then do:
     1598         assign
     1599           v-diasize-change-size = true
     1600         .
     1601       end.
     1602       else do:
     1603         return .
     1604       end.
     1605       assign
     1606         v-frame-height = frame Dialog-Frame :height
     1607         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1608         v-browse-height = v-diasize-browse-handle :height
     1609       .
     1610       for each buf_temp-browse-handle
     1611         where buf_temp-browse-handle.browse-type = 'height':u
     1612       :
     1613         assign
     1614           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1615         .
     1616       end.
     1617       for each buf_temp-diasize-handle
     1618       :
     1619         delete buf_temp-diasize-handle .
     1620       end.
     1621       assign
     1622         v-field-group-handle = frame Dialog-Frame :first-child
     1623       .
     1624       do while valid-handle(v-field-group-handle)
     1625       :
     1626         assign
     1627           v-object-handle = v-field-group-handle :first-child
     1628         .
     1629         do while valid-handle(v-object-handle)
     1630         :
     1631           if  v-object-handle <> v-diasize-browse-handle :handle
     1632           and can-query(v-object-handle, "row")
     1633           and can-query(v-object-handle, "height")
     1634           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1635           then do:
     1636             find first buf_temp-browse-handle
     1637               where buf_temp-browse-handle.browse-type   = 'height':u
     1638                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1639               no-error .
     1640             if available buf_temp-browse-handle
     1641             then do:
     1642             end.
     1643             else do:
     1644               create buf_temp-diasize-handle .
     1645               assign
     1646                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1647                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1648               .
     1649             end.
     1650           end.
     1651           assign
     1652             v-object-handle = v-object-handle :next-sibling
     1653           .
     1654         end.
     1655         assign
     1656           v-field-group-handle = v-field-group-handle :next-sibling
     1657         .
     1658       end.
     1659       do with frame Dialog-Frame
     1660       :
     1661         hide v-diasize-resize-button .
     1662         assign
     1663           v-diasize-resize-button :row    = 1
     1664           v-diasize-resize-button :column = 1
     1665         .
     1666       end.
     1667       if p-change-value > 0
     1668       then do:
     1669         if frame Dialog-Frame :scrollable = true
     1670         then do:
     1671           assign
     1672             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1673             no-error .
     1674           if error-status :error
     1675           or error-status :get-message(1) <> ""
     1676           then do:
     1677             undo move_block, retry move_block .
     1678           end.
     1679         end.
     1680         assign
     1681           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1682           no-error .
     1683         if error-status :error
     1684         or error-status :get-message(1) <> ""
     1685         then do:
     1686           undo move_block, retry move_block .
     1687         end.
     1688         assign
     1689           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1690           no-error .
     1691         if error-status :error
     1692         or error-status :get-message(1) <> ""
     1693         then do:
     1694           undo move_block, retry move_block .
     1695         end.
     1696         for each buf_temp-browse-handle
     1697           where buf_temp-browse-handle.browse-type = 'height':u
     1698         on error undo move_block, retry move_block
     1699         :
     1700           assign
     1701             buf_temp-browse-handle.browse-handle :height
     1702               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1703             no-error .
     1704           if error-status :error
     1705           or error-status :get-message(1) <> ""
     1706           then do:
     1707             undo move_block, retry move_block .
     1708           end.
     1709         end.
     1710         for each buf_temp-diasize-handle
     1711         on error undo move_block, retry move_block
     1712         :
     1713           assign
     1714             v-object-handle = buf_temp-diasize-handle.handle-value
     1715           .
     1716           if v-object-handle <> v-diasize-resize-button
     1717           then do:
     1718             assign
     1719               v-object-handle :row = v-object-handle :row + p-change-value
     1720               no-error .
     1721             if error-status :error
     1722             or error-status :get-message(1) <> ""
     1723             then do:
     1724               undo move_block, retry move_block .
     1725             end.
     1726           end.
     1727         end.
     1728       end.
     1729       else do:
     1730         for each buf_temp-diasize-handle
     1731         on error undo move_block, retry move_block
     1732         :
     1733           assign
     1734             v-object-handle = buf_temp-diasize-handle.handle-value
     1735           .
     1736           if v-object-handle <> v-diasize-resize-button
     1737           then do:
     1738             assign
     1739               v-object-handle :row = v-object-handle :row + p-change-value
     1740               no-error .
     1741             if error-status :error
     1742             or error-status :get-message(1) <> ""
     1743             then do:
     1744               undo move_block, retry move_block .
     1745             end.
     1746           end.
     1747         end.
     1748         assign
     1749           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1750           no-error .
     1751         if error-status :error
     1752         or error-status :get-message(1) <> ""
     1753         then do:
     1754           undo move_block, retry move_block .
     1755         end.
     1756         for each buf_temp-browse-handle
     1757           where buf_temp-browse-handle.browse-type = 'height':u
     1758         on error undo move_block, retry move_block
     1759         :
     1760           assign
     1761             buf_temp-browse-handle.browse-handle :height
     1762               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1763             no-error .
     1764           if error-status :error
     1765           or error-status :get-message(1) <> ""
     1766           then do:
     1767             undo move_block, retry move_block .
     1768           end.
     1769         end.
     1770         assign
     1771           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1772           no-error .
     1773         if error-status :error
     1774         or error-status :get-message(1) <> ""
     1775         then do:
     1776           undo move_block, retry move_block .
     1777         end.
     1778         if frame Dialog-Frame :scrollable = true
     1779         then do:
     1780           assign
     1781             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1782             no-error .
     1783           if error-status :error
     1784           or error-status :get-message(1) <> ""
     1785           then do:
     1786             undo move_block, retry move_block .
     1787           end.
     1788         end.
     1789       end.
     1790       if p-move-resize = true
     1791       then do:
     1792         run diasize_position-resize-button in this-procedure .
     1793       end.
     1794       if v-diasize-wndstore = true
     1795       then do:
     1796         if connected("ub") = true
     1797         then do:
     1798           define variable v-cntxt-db-num        as integer   no-undo .
     1799           define variable v-cntxt-userid        as character no-undo .
     1800           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1801                                             , OUTPUT v-cntxt-userid
     1802                                             ) .
     1803           run gbl/wndsizew.p
     1804             (input  v-cntxt-db-num
     1805             ,input  v-cntxt-userid
     1806             ,input  v-diasize-proc-name
     1807             ,input  'height':u
     1808             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1809             ) .
     1810         end.
     1811       end.
     1812     end.
     1813     assign
     1814       v-diasize-change-size = false
     1815     .
     1816   end procedure.
     1817   procedure diasize_set-height :
     1818     define input  parameter p-new-height  as decimal   no-undo .
     1819     define input  parameter p-move-resize as logical   no-undo .
     1820     do
     1821     on error undo, return error return-value
     1822     :
     1823       run diasize_change-height in this-procedure
     1824         (input  (p-new-height - frame Dialog-Frame :height)
     1825         ,input  p-move-resize
     1826         ) .
     1827     end.
     1828   end procedure.
     1829   procedure diasize_change-width :
     1830     define input  parameter p-change-value as decimal   no-undo .
     1831     define input  parameter p-move-resize  as logical   no-undo .
     1832     define variable v-field-group-handle   as handle    no-undo .
     1833     define variable v-object-handle        as handle    no-undo .
     1834     define variable v-frame-width          as decimal   no-undo .
     1835     define variable v-frame-virtual-width  as decimal   no-undo .
     1836     define variable v-browse-width         as decimal   no-undo .
     1837     define variable v-window-width         as decimal   no-undo .
     1838     define variable v-window-virtual-width as decimal   no-undo .
     1839     define variable v-change-sign          as integer   no-undo .
     1840     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1841     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1842     if p-change-value > 0
     1843     then do:
     1844       if frame Dialog-Frame :width + p-change-value >
     1845           session :width-chars
     1846       then do:
     1847         assign
     1848           p-change-value = session :width-chars - frame Dialog-Frame :width
     1849         .
     1850         if p-change-value <= 0
     1851         then do:
     1852           run diasize_position-resize-button in this-procedure .
     1853           return .
     1854         end.
     1855       end.
     1856     end.
     1857     if p-change-value < 0
     1858     then do:
     1859       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1860       then do:
     1861         assign
     1862           p-change-value = v-diasize-orig-frame-width
     1863                          - frame Dialog-Frame :width
     1864         .
     1865         if p-change-value >= 0
     1866         then do:
     1867           run diasize_position-resize-button in this-procedure .
     1868           return .
     1869         end.
     1870       end.
     1871     end.
     1872     if p-change-value >= 0
     1873     then do:
     1874       assign
     1875         v-change-sign = 1
     1876       .
     1877     end.
     1878     else do:
     1879       assign
     1880         v-change-sign = -1
     1881       .
     1882     end.
     1883     assign
     1884       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1885     .
     1886     if p-change-value = 0
     1887     then do:
     1888       run diasize_position-resize-button in this-procedure .
     1889       return .
     1890     end.
     1891     move_block:
     1892     do
     1893     on error undo move_block, leave move_block
     1894     :
     1895       if retry
     1896       then do:
     1897         do
     1898         on error undo move_block, leave move_block
     1899         :
     1900           if p-change-value > 0
     1901           then do:
     1902             for each buf_temp-diasize-handle
     1903             on error undo, next
     1904             :
     1905               assign
     1906                 v-object-handle = buf_temp-diasize-handle.handle-value
     1907               .
     1908               if v-object-handle <> v-diasize-resize-button
     1909               then do:
     1910                 assign
     1911                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1912                 .
     1913               end.
     1914             end.
     1915             assign
     1916               v-diasize-browse-handle :width = v-browse-width
     1917             .
     1918             for each buf_temp-browse-handle
     1919               where buf_temp-browse-handle.browse-type = 'width':u
     1920             on error undo, next
     1921             :
     1922               assign
     1923                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1924               .
     1925             end.
     1926             assign
     1927               frame Dialog-Frame :width = v-frame-width
     1928             .
     1929             if frame Dialog-Frame :scrollable = true
     1930             then do:
     1931               assign
     1932                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1933               .
     1934             end.
     1935             run diasize_position-resize-button in this-procedure .
     1936           end.
     1937           else do:
     1938             if frame Dialog-Frame :scrollable = true
     1939             then do:
     1940               assign
     1941                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1942               .
     1943             end.
     1944             assign
     1945               frame Dialog-Frame :width = v-frame-width
     1946             .
     1947             for each buf_temp-browse-handle
     1948               where buf_temp-browse-handle.browse-type = 'width':u
     1949             on error undo, next
     1950             :
     1951               assign
     1952                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1953               .
     1954             end.
     1955             assign
     1956               v-diasize-browse-handle :width = v-browse-width
     1957             .
     1958             for each buf_temp-diasize-handle
     1959             on error undo, next
     1960             :
     1961               assign
     1962                 v-object-handle = buf_temp-diasize-handle.handle-value
     1963               .
     1964               if v-object-handle <> v-diasize-resize-button
     1965               then do:
