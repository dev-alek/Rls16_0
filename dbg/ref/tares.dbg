     1070         mark-string(recid(X_tare), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1071         X_tare.tare-code FORMAT "x(8)":U
     1072         X_tare.tare-name FORMAT "x(50)":U
     1073         entry (lookup (STRING(X_tare.stts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) COLUMN-LABEL "Статус"
     1074     ENABLE
     1075         X_tare.tare-name
     1076       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 18.
     1077   DEFINE FRAME Dialog-Frame
     1078        b-quit AT ROW 1 COL 1
     1079        B-mark AT ROW 1 COL 11
     1080        B-sel AT ROW 1 COL 21
     1081        B-add AT ROW 1 COL 31
     1082        b-lkp AT ROW 1 COL 41
     1083        B-chg AT ROW 1 COL 51
     1084        B-del AT ROW 1 COL 61
     1085        b-sch AT ROW 1 COL 86.5 WIDGET-ID 2
     1086        B-print AT ROW 1 COL 89
     1087        B-hist AT ROW 1 COL 92
     1088        B-Help AT ROW 1 COL 95
     1089        RS-stts AT ROW 2.5 COL 3.5 NO-LABEL
     1090        br-tares AT ROW 4 COL 1
     1091        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1092        SPACE(78.62) SKIP(20.03)
     1093       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1094            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1095            TITLE "Тара"
     1096            CANCEL-BUTTON b-quit.
     1097   ASSIGN
     1098          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1099          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1100   ON GO OF FRAME Dialog-Frame
     1101   DO:
     1102     p-rid-list = v-rid-list.
     1103   END.
     1104   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1105   OR ENDKEY OF FRAME Dialog-Frame DO:
     1106     run gbl/markqwa.p (
     1107                              input b-mark:sensitive
     1108                             , input v-rid-list) no-error.
     1109     if error-status:error then return no-apply.
     1110     APPLY "END-ERROR":U TO SELF.
     1111   END.
