     2778     REPOSITION br-tares to recid v-doc-rec No-ERROR.
     2779   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2780   DEF VAR cur-clmn-numbr-tares as INT EXTENT 4 no-undo.
     2781   DEF VAR varmvibr-tares       as INT no-undo.
     2782   DEF VAR varmvjbr-tares       as INT no-undo.
     2783   DEF VAR varmvkbr-tares       as INT no-undo.
     2784   DEF VAR varmvlbr-tares       as INT no-undo.
     2785   DEF VAR move-elementbr-tares as INT no-undo.
     2786   def var jjbr-tares           as int no-undo.
     2787   do varmvibr-tares = 1 to EXTENT(cur-clmn-numbr-tares):
     2788     ASSIGN cur-clmn-numbr-tares[varmvibr-tares] = varmvibr-tares.
     2789   END.
     2790   RUN start-mv-clmnbr-tares.
     2791   PROCEDURE start-mv-clmnbr-tares:
     2792   def var old-session as logical no-undo.
     2793      old-session = SESSION:IMMEDIATE-DISPLAY.
     2794      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2795          IF  p-mode = 'все':U  THEN DO:
     2796      DO jjbr-tares = NUM-ENTRIES('1,2,3,4') TO 1 BY -1:
     2797        RUN re-move-clmnbr-tares ( cur-clmn-numbr-tares[INTEGER(ENTRY (jjbr-tares, '1,2,3,4'))] , 1).
     2798      END.
     2799          END.
     2800      SESSION:IMMEDIATE-DISPLAY = old-session.
     2801   END.
     2802   ON ctrl-cursor-right OF BROWSE br-tares do:
     2803     RUN re-move-clmnbr-tares ( 1, 4).
     2804   END.
     2805   ON ctrl-cursor-left OF BROWSE br-tares do:
     2806     RUN re-move-clmnbr-tares (4, 1).
     2807   END.
     2808   PROCEDURE re-move-clmnbr-tares:
     2809     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2810     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2811     DO varmvibr-tares = 1 TO EXTENT(cur-clmn-numbr-tares):
     2812       if cur-clmn-numbr-tares[varmvibr-tares] = source-column THEN cur-clmn-numbr-tares[varmvibr-tares] = -1.
     2813     END.
     2814     if br-tares:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2815     if source-column > target-column THEN
     2816     DO varmvjbr-tares = source-column - 1 to target-column BY -1:
     2817       DO varmvibr-tares = 1 TO EXTENT(cur-clmn-numbr-tares):
     2818           if cur-clmn-numbr-tares[varmvibr-tares] = varmvjbr-tares THEN DO:
     2819             cur-clmn-numbr-tares[varmvibr-tares] = cur-clmn-numbr-tares[varmvibr-tares] + 1.
     2820           END.
     2821       END.
     2822     END.
     2823     ELSE
     2824     DO varmvjbr-tares = source-column + 1 to target-column:
     2825       DO varmvibr-tares = 1 TO EXTENT(cur-clmn-numbr-tares):
     2826         if cur-clmn-numbr-tares[varmvibr-tares] = varmvjbr-tares THEN DO:
     2827           cur-clmn-numbr-tares[varmvibr-tares] = cur-clmn-numbr-tares[varmvibr-tares] - 1.
     2828         END.
     2829       END.
     2830     END.
     2831     DO varmvibr-tares = 1 TO EXTENT(cur-clmn-numbr-tares):
     2832       if cur-clmn-numbr-tares[varmvibr-tares] = -1 THEN cur-clmn-numbr-tares[varmvibr-tares] = target-column.
     2833     END.
     2834   END PROCEDURE.
     2835   PROCEDURE ch-clmnbr-tares:
     2836     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2837     if cur-clmn-loc <= 1 then do:
     2838       return .
     2839     end.
     2840     DO varmvibr-tares = 1 TO EXTENT(cur-clmn-numbr-tares):
     2841       if cur-clmn-numbr-tares[varmvibr-tares] = cur-clmn-loc THEN move-elementbr-tares = varmvibr-tares.
     2842     END.
     2843     RUN re-move-clmnbr-tares (cur-clmn-loc, 1).
     2844   END PROCEDURE.
     2845   PROCEDURE mv-brw-defaultbr-tares:
     2846   def var old-session as logical no-undo.
     2847     old-session = SESSION:IMMEDIATE-DISPLAY.
     2848     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2849     do varmvlbr-tares = 1 to EXTENT(cur-clmn-numbr-tares):
     2850       RUN re-move-clmnbr-tares (cur-clmn-numbr-tares[varmvlbr-tares], varmvlbr-tares).
     2851     END.
     2852     RUN start-mv-clmnbr-tares.
     2853     SESSION:IMMEDIATE-DISPLAY = old-session.
     2854   END PROCEDURE.
     2855   .
     2856   WAIT-FOR GO OF FRAME Dialog-Frame.
     2857   END.
     2858   RUN disable_UI.
     2859   PROCEDURE disable_UI :
     2860     HIDE FRAME Dialog-Frame.
     2861   END PROCEDURE.
     2862   PROCEDURE enable_UI :
     2863     DISPLAY RS-stts mark-num
     2864         WITH FRAME Dialog-Frame.
     2865     ENABLE b-quit B-mark B-sel B-add b-lkp B-chg B-del b-sch B-print B-hist
     2866            B-Help RS-stts br-tares mark-num
     2867         WITH FRAME Dialog-Frame.
     2868     VIEW FRAME Dialog-Frame.
     2869     OPEN QUERY br-tares FOR EACH X_tare NO-LOCK INDEXED-REPOSITION.
     2870   END PROCEDURE.
     2871   PROCEDURE MyENable :
     2872   ASSIGN
     2873   rs-stts:RADIO-BUTTONS IN FRAME Dialog-Frame
     2874                          = "Текущие&+" + chr(44) +  '0':U + chr(44) +
     2875                          "Все&!" + chr(44) + 'все':U + chr(44) +
     2876                           "Удаленные&-" + chr(44) + '1':U
     2877   rs-stts = (IF p-stts = ? THEN 'все':U ELSE string(p-stts))
     2878   X_tare.tare-name:read-only in browse br-tares  = yes
     2879   .
     2880   DISPLAY mark-num
     2881   WITH FRAME Dialog-Frame.
     2882   ENABLE
     2883   b-quit
     2884   B-mark when LOOKUP("b-mark":U, bttns) > 0
     2885   B-sel when LOOKUP("b-sel":U, bttns) > 0
     2886   B-add when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     2887   b-lkp
     2888   B-chg when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     2889   B-del when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     2890   b-sch
     2891   B-print
     2892   B-Help
     2893   B-hist
     2894   br-tares
     2895   mark-num
     2896   rs-stts
     2897   with FRAME Dialog-Frame.
     2898   VIEW FRAME Dialog-Frame.
     2899   END PROCEDURE.
     2900   PROCEDURE OpenBr :
     2901   define input  parameter p-open-query     as logical   no-undo .
     2902   define input  parameter p-find-next      as logical   no-undo .
     2903   define input  parameter p-find-condition as character no-undo .
     2904   define variable title0 as character no-undo .
     2905   DEFINE VARIABLE l-query-was-opened as logical no-undo .
     2906   define variable title00 as character no-undo.
     2907   define variable title01 as character no-undo.
     2908   assign
     2909   title0 = "Список тары"
     2910   title00 = "Список тары"
     2911   .
     2912   run waitfram-show in this-procedure ( INPUT "Ждите...").
     2913   DEFINE VARIABLE sort-column-phrase as character no-undo .
     2914   case sort-column-name :
     2915     when "" then do:
     2916       assign
     2917         sort-column-phrase = ""
     2918       .
     2919     end.
     2920     otherwise do:
     2921       assign
     2922         sort-column-phrase = "by " + sort-column-name
     2923       .
     2924     end.
     2925   end case.
     2926   define variable l-open-query as logical   no-undo .
     2927     IF p-stts = ? THEN DO:
     2928         assign
     2929         filter-point-name = title00 .
     2930         frame Dialog-Frame:TITLE = title0 .
     2931         ASSIGN
     2932         frame Dialog-Frame:TITLE = SUBSTITUTE("&1", title00).
     2933   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2934   define variable  l-disable-where-32  as logical   no-undo .
