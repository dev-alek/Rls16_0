      387         ).
      388   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      389   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      390     (input  v-report-name
      391     ,input  2
      392     ,output v-exist
      393     )  .
      394       if NOT v-exist then
      395       DO:
      396         Message
      397           "Нет заданий на печать ! "
      398           view-as alert-box .
      399         Return  .
      400       End.
      401       run gbl/prnfilen.w
      402         (input  ""
      403         ,input  p-DisabledOptions
      404         ,input  string(v-report-name )
      405         ,input  7
      406         ,output v-user-action
      407         ,output v-printed
      408         ) .
      409       if v-printed then
      410       do:
      411         return "YES" .
      412       end.
      413       else
      414       do:
      415         return "NO" .
      416       end.
      417     end.
      418   end procedure.
      419   procedure prn-lib-open-stream :
      420     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      421     define input parameter p-page-size    as integer no-undo .
      422     define input parameter p-is-stream    as logical no-undo .
      423     define input parameter p-append       as logical no-undo .
      424     define variable v-report-name as character no-undo .
      425     do
      426       on error undo, return error
      427       :
      428       run prn-lib-get-report-name  in this-procedure (
      429         input parParentProc
      430         ,output v-report-name
      431         ).
      432       if p-is-stream then
      433       do:
      434         if p-append then
      435         do:
      436           output stream PrnLibStream to value( v-report-name )
      437             page-size value(p-page-size) append .
      438         end.
      439         if not p-append then
      440         do:
      441           output stream PrnLibStream to value( v-report-name )
      442             page-size value(p-page-size) .
      443         end.
      444       end.
      445       if not p-is-stream then
      446       do:
      447         if p-append then
      448         do:
      449           output to value( v-report-name )
      450             page-size value(p-page-size) append .
      451         end.
      452         if not p-append then
      453         do:
      454           output to value( v-report-name )
      455             page-size value(p-page-size) .
      456         end.
      457       end.
      458     end.
      459   end procedure.
      460   procedure prn-lib-open-exp :
      461     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      462     define input parameter p-is-stream    as logical no-undo .
      463     define input parameter p-is-append    as logical no-undo .
      464     define output parameter p-ReportFileName as char init "report" no-undo.
      465     define output parameter p-process as logical no-undo .
      466     define variable glog as logical no-undo .
      467     do
      468       on error undo, return error
      469       :
      470       SYSTEM-DIALOG GET-FILE p-ReportFileName
      471         TITLE      "Укажите путь"
      472         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      473         ASK-OVERWRITE
      474         CREATE-TEST-FILE
      475         SAVE-AS
      476         USE-FILENAME
      477         DEFAULT-EXTENSION "txt"
      478         UPDATE glog
      479         .
      480       if not glog then  return.
      481       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      482       if p-is-stream then
      483       do:
      484         if p-is-append then
      485         do:
      486           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      487         end.
      488         else
      489         do:
      490           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      491         end.
      492       end.
      493       else
      494       do:
      495         if p-is-append then
      496         do:
      497           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      498         end.
      499         else
      500         do:
      501           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      502         end.
      503       end.
      504       p-process = yes.
      505     end.
      506   end procedure.
      507   procedure prn-lib-get-report-name :
      508     define input parameter parParentProc  as widget-handle no-undo.
      509     define output parameter p-report-name as character no-undo .
      510     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      511   end procedure.
      512   procedure prn-lib-reportviewer-report-name :
      513     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      514     define input parameter p-report-name-html as character no-undo .
      515     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      516   end procedure.
      517   procedure prn-lib-reportviewer :
      518     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      519     define input parameter p-report-name-html as character no-undo .
      520     define input parameter p-param        as character no-undo .
      521     define variable v-excel           as character no-undo init 'TRUE' .
      522     define variable v-value-character as character no-undo .
      523     define variable v-value-integer   as character no-undo .
      524     define variable v-value-date      as date      no-undo .
      525     define variable v-value-decimal   as decimal   no-undo .
      526     define variable rep-excel         as logical   no-undo .
      527     define variable excel-string      as character no-undo .
      528     define variable v-param-type      as character no-undo .
      529     define variable v-tth             as handle    no-undo .
      530     run adm/shattri.p (
      531       input "get":U
      532       ,input  ""
      533       ,input  0
      534       ,input  'report-glob':U
      535       ,input  'rep-excel':U
      536       ,output v-value-character
      537       ,output v-value-date
      538       ,output v-value-decimal
      539       ,output v-value-integer
      540       ,output rep-excel
      541       ,output v-param-type
      542       ,INPUT-OUTPUT table-handle v-tth
      543       )  .
      544     if rep-excel then v-excel = "TRUE" .
      545     else v-excel = "FALSE" .
      546     if p-param eq ""
      547     then
      548        p-param = "EXCEL:" + v-excel.
      549     else
      550        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      551     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      552   end procedure.
      553   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      554   procedure cur-time :
      555      define output parameter p-today as date      no-undo .
      556      define output parameter p-time  as integer   no-undo .
      557     do
      558     on error undo, return error
      559     :
      560       define variable v-date1 as date      no-undo .
      561       define variable v-date2 as date      no-undo .
      562       define variable v-time  as integer   no-undo .
      563       assign
      564         v-date1 = today
      565         v-time  = time
      566         v-date2 = today
      567       .
      568       if v-date1 <> v-date2
      569       then do:
      570         assign
      571           v-date1 = today
      572           v-time  = v-time
      573         .
      574       end.
      575       assign
      576         p-today = v-date1
      577         p-time  = v-time
      578       .
      579     end.
      580   end.
      581   function cur-time-date returns character
      582   :
      583     return string(today, '99/99/9999':U) .
      584   end.
      585   function cur-time-mjd returns decimal
      586   :
      587     define variable v-date as date      no-undo .
      588     define variable v-time as integer   no-undo .
      589     run cur-time in this-procedure
      590       (output v-date
      591       ,output v-time
      592       ) .
      593     return integer(v-date) - 2400002 + (v-time / 86400) .
      594   end.
      595   function cur-time-get-ending-index returns integer
      596   (input p-number as integer
      597   )
      598   :
      599     if p-number < 0
      600     or p-number = ?
      601     then do:
      602       return 1 .
      603     end.
      604     define variable v-rest as integer   no-undo .
      605     assign
      606       p-number = p-number modulo 100
      607     .
      608     if p-number < 20
      609     then do:
      610       assign
      611         v-rest = p-number
      612       .
      613     end.
      614     else do:
      615       assign
      616         v-rest = p-number modulo 10
      617       .
      618     end.
      619     case v-rest :
      620       when 1
      621       then do:
      622         return 2 .
      623       end.
      624       when 2 or
      625       when 3 or
      626       when 4
      627       then do:
      628         return 3 .
      629       end.
      630       otherwise do:
      631         return 1 .
      632       end.
      633     end case .
      634   end.
      635   procedure cur-time-mjd-to-date :
      636      define input  parameter i-mjd-diff as decimal no-undo.
      637      define output parameter o-Date     as date    no-undo.
      638      define output parameter o-Time     as integer no-undo.
      639      define variable v-day-number as integer   no-undo .
      640      if    i-mjd-diff < 0
      641         or i-mjd-diff = ?
      642      then do:
      643         return "?" .
      644      end.
      645      assign
      646         v-day-number = truncate(i-mjd-diff,0).
      647         o-Date = date(v-day-number + 2400002).
      648         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      649     .
      650   end.
      651   function cur-time-mjd-to-string returns character
      652   (input p-mjd-diff as decimal
      653   )
      654   :
      655     define variable v-day-number as integer   no-undo .
      656     define variable v-seconds    as integer   no-undo .
      657     define variable v-hour       as integer   no-undo .
      658     define variable v-min        as integer   no-undo .
      659     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      660     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      661     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      662     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      663     if p-mjd-diff < 0
      664     or p-mjd-diff = ?
      665     then do:
      666       return "?" .
      667     end.
      668     assign
      669       v-day-number = integer(truncate(p-mjd-diff,0))
      670       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      671     .
      672     if v-seconds > 86400
      673     then do:
      674       assign
      675         v-seconds = 86400 - 1
      676       .
      677     end.
      678     if v-seconds < 0
      679     then do:
      680       assign
      681         v-seconds = 0
      682       .
      683     end.
      684     assign
      685       v-hour = truncate(v-seconds / 3600, 0)
      686     .
      687     assign
      688       v-seconds = v-seconds modulo 3600
      689     .
      690     assign
      691       v-min = truncate(v-seconds / 60, 0)
      692     .
      693     assign
      694       v-seconds = v-seconds modulo 60
      695     .
      696     return
      697         (if v-day-number <> 0
      698           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      699           else ""
      700         )
      701       + (if v-day-number <> 0 or v-hour <> 0
      702           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      703           else ""
      704         )
      705       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      706           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      707           else ""
      708         )
      709       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      710       .
      711   end.
      712   function cur-time-string returns character
      713   :
      714     define variable v-date as date      no-undo .
      715     define variable v-time as integer   no-undo .
      716     run cur-time in this-procedure
      717       (output v-date
      718       ,output v-time
      719       ) .
      720     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      721   end.
      722   function cur-time-string-sec returns character
      723   :
      724     define variable v-date as date      no-undo .
      725     define variable v-time as integer   no-undo .
      726     run cur-time in this-procedure
      727       (output v-date
      728       ,output v-time
      729       ) .
      730     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      731   end.
      732   function cur-time-custom  returns character
      733   (input p-prefix as character
      734   ,input p-date-format as character
      735   ,input p-delimiter as character
      736   ,input p-time-format as character
      737   ,input p-suffix as character
      738   )
      739   :
      740     define variable v-date as date      no-undo .
      741     define variable v-time as integer   no-undo .
      742     run cur-time in this-procedure
      743       (output v-date
      744       ,output v-time
      745       ) .
      746     return
      747       p-prefix
      748       + string(v-date, p-date-format)
      749       + p-delimiter
      750       + string(v-time, p-time-format)
      751       + p-suffix
      752       .
      753   end.
      754   function cur-time-print  returns character
      755   :
      756     define variable v-date as date      no-undo .
      757     define variable v-time as integer   no-undo .
      758     run cur-time in this-procedure
      759       (output v-date
      760       ,output v-time
      761       ) .
      762     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      763   end.
      764   function cur-time-datetime returns datetime
      765   :
      766     define variable v-char as character no-undo .
      767     define variable v-datetime as datetime no-undo .
      768     v-char = cur-time-string().
      769     v-datetime = datetime(v-char).
      770     return  v-datetime.
      771   end.
      772   function cur-time-string-msec returns character
      773   :
      774     define variable v-date as datetime  no-undo .
      775     v-date = now.
      776     return string(v-date) .
      777   end.
      778   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      779     define variable v-cntxt-db-num        as integer   no-undo .
      780     define variable v-cntxt-userid        as character no-undo .
      781     define variable v-cntxt-level         as character no-undo .
      782     define variable v-cntxt-host-code-obj as integer   no-undo .
      783     define variable v-cntxt-obj-type      as character no-undo .
      784     define variable v-cntxt-obj-code      as integer   no-undo .
      785     define variable v-cntxt-db-num-obj    as integer   no-undo .
      786     define variable v-cntxt-is-admin      as logical   no-undo .
      787   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      788   FUNCTION mark-string RETURNS CHARACTER
      789     ( input p-recid as recid, input mark-list as character  ) :
      790     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      791   END FUNCTION.
      792   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      793   define variable c-point  as character no-undo .
      794   define variable tbl      as character no-undo .
      795   define variable join-tbl as character no-undo .
      796   define variable fld      as character no-undo .
      797   define variable lab      as character no-undo .
      798   define variable spr      as character no-undo .
      799   define variable dim      as character no-undo .
      800   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      801   procedure fltfield-clear :
      802     define output parameter loc-fld as character no-undo.
      803     define output parameter loc-lab as character no-undo .
      804     define output parameter loc-spr as character no-undo .
      805     define output parameter loc-dim as character no-undo .
      806     assign
      807       loc-fld = ""
      808       loc-lab = ""
      809       loc-spr = ""
      810       loc-dim = "0"
      811     .
      812   end procedure .
      813   procedure fltfield-add :
      814     define input        parameter par-fld as character no-undo.
      815     define input        parameter par-lab as character no-undo .
      816     define input        parameter par-spr as character no-undo .
      817     define input-output parameter loc-fld as character no-undo.
      818     define input-output parameter loc-lab as character no-undo .
      819     define input-output parameter loc-spr as character no-undo .
      820     define input-output parameter loc-dim as character no-undo .
      821     do
      822     on error undo, return error
      823     :
      824       assign
      825       loc-fld = if loc-dim = '0'
      826                 then par-fld
      827                 else (loc-fld + chr(44) + par-fld)
      828       loc-lab = if loc-dim = '0'
      829                 then par-lab
      830                 else (loc-lab + chr(44) + par-lab)
      831       loc-spr = if loc-dim = '0'
      832                 then par-spr
      833                 else (loc-spr + chr(44) + par-spr)
      834       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      835                 string(integer(if num-entries(loc-dim) > 1
      836                               then entry(2, loc-dim)
      837                               else entry(1, loc-dim)
      838                               ) + 1)
      839       no-error
      840       .
      841     end.
      842   end procedure.
      843   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      844   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      845   procedure fltopend_fltopend :
      846   define input parameter p-parent-handle as handle no-undo .
      847   define input parameter p-qh as handle no-undo .
      848   define input parameter p-flt-open-open-query  as character no-undo .
      849   define input parameter p-where-cond as character no-undo .
      850   define input parameter p-use-indFIRST-query-tail as character no-undo .
      851   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      852   define input parameter p-indexed-reposition as character no-undo .
      853     do
      854     on error undo, return error
      855     :
      856   define variable v-prepare-string as character no-undo .
      857   define variable glog as logical no-undo .
      858   assign
      859   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      860                      p-where-cond + chr(32)  +
      861                      p-use-indFIRST-query-tail + chr(32) +
      862                      p-use-ind-sort-clmn-by + chr(32) +
      863                      p-indexed-reposition
      864   .
      865   assign
      866   glog = p-qh:query-prepare(v-prepare-string) no-error .
      867   if not glog
      868   or error-status:error then do:
      869     message error-status:get-message(1) view-as alert-box .
      870     undo, return error .
      871   end.
      872   assign
      873   glog = p-qh:query-open no-error .
      874   if not glog
      875   or error-status:error then do:
      876     message error-status:get-message(1) view-as alert-box .
      877     undo, return error .
      878   end.
      879     end.
      880   end procedure.
      881   procedure fltopend_fltfindd :
      882   define input parameter p-parent-handle as handle no-undo .
      883   define input parameter p-qh as handle no-undo .
      884   define input parameter p-rowid as rowid no-undo .
      885   define input parameter p-next as logical no-undo .
      886   define input parameter p-lock as integer no-undo .
      887   define input parameter p-bh as handle no-undo .
      888   define input parameter p-where-cond as character no-undo .
      889   define input parameter p-use-index-phrase as character no-undo .
      890   define variable glog as logical no-undo .
      891   define variable v-qh as handle no-undo .
      892   define variable v-bh as handle no-undo .
      893   define variable v-recid as recid no-undo .
      894   define variable v-prepare-string as character no-undo .
      895   do
      896   on error undo, return error
      897   on stop undo, return error
      898   :
      899     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      900     create buffer v-bh for table p-bh buffer-name p-bh:name.
      901     create query v-qh.
      902     v-qh:set-buffers(v-bh).
      903     v-prepare-string = substitute("for each &1 &2 &3"
      904                                     ,v-bh:name
      905                                     ,p-where-cond
      906                                     ,p-use-index-phrase).
      907     glog = v-qh:query-prepare(v-prepare-string) no-error.
      908     if not glog then do:
      909       delete object v-qh.
      910       delete object v-bh.
      911       undo, return error .
      912     end.
      913     glog = v-qh:query-open no-error .
      914     if not glog then do:
      915       delete object v-qh.
      916       delete object v-bh.
      917       undo, return error .
      918     end.
      919     if p-next then do:
      920       v-qh:reposition-to-rowid(p-rowid) no-error .
      921       glog = v-qh:get-next( p-lock) no-error .
      922       glog = v-qh:get-next( p-lock) no-error .
      923       if not glog or v-qh:query-off-end = yes then do:
      924         glog = v-qh:get-first( p-lock) no-error .
      925       end.
      926     end.
      927     else do:
      928       glog = v-qh:get-first( p-lock) no-error .
      929     end.
      930     v-recid = v-bh:recid no-error .
      931     delete object v-qh.
      932     delete object v-bh.
      933     return string(v-recid) .
      934   end.
      935   end procedure.
      936   procedure fltopend_fltfindq :
      937   define input parameter p-parent-handle as handle no-undo .
      938   define input parameter p-qh as handle no-undo .
      939   define input parameter p-next as logical no-undo .
      940   define input parameter p-lock as integer no-undo .
      941   define input parameter p-flt-open-open-query  as character no-undo .
      942   define input parameter p-where-cond as character no-undo .
      943   define input parameter p-use-indFIRST-query-tail as character no-undo .
      944   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      945   define input parameter p-indexed-reposition as character no-undo .
      946   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      947   define variable glog as logical no-undo .
      948   define variable v-qh as handle no-undo .
      949   define variable v-bh as handle no-undo extent 18.
      950   define variable v-rowid as rowid no-undo extent 18.
      951   define variable v-ii as integer no-undo .
      952   define variable v-prepare-string as character no-undo .
      953   do
      954   on error undo, return error
      955   on stop undo, return error
      956   :
      957     create query v-qh.
      958     do v-ii = 1 to p-qh:num-buffers:
      959       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      960       assign
      961       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      962       no-error.
      963       v-qh:add-buffer(v-bh[v-ii]).
      964     end.
      965     assign
      966     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      967                       p-where-cond + chr(32)  +
      968                       p-use-indFIRST-query-tail + chr(32) +
      969                       p-use-ind-sort-clmn-by + chr(32) +
      970                       p-indexed-reposition
      971     .
      972     glog = v-qh:query-prepare( v-prepare-string) no-error .
      973     if not glog then do:
      974       delete object v-qh.
      975       do v-ii = 1 to p-qh:num-buffers:
      976         delete object v-bh[v-ii].
      977       end.
      978       undo, return error .
      979     end.
      980     glog = v-qh:query-open no-error .
      981     if not glog then do:
      982       delete object v-qh.
      983       do v-ii = 1 to p-qh:num-buffers:
      984         delete object v-bh[v-ii].
      985       end.
      986       undo, return error .
      987     end.
      988     if p-next then do:
      989       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      990       glog = v-qh:get-next( p-lock) no-error .
      991       glog = v-qh:get-next( p-lock) no-error .
      992       if not glog or v-qh:query-off-end = yes then do:
      993         glog = v-qh:get-first( p-lock) no-error .
      994       end.
      995     end.
      996     else do:
      997       glog = v-qh:get-first( p-lock) no-error .
      998     end.
      999     do v-ii = 1 to p-qh:num-buffers:
     1000       assign
     1001       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1002       no-error.
     1003     end.
     1004     delete object v-qh.
     1005     do v-ii = 1 to p-qh:num-buffers:
     1006       delete object v-bh[v-ii].
     1007     end.
     1008   end.
     1009   end procedure.
     1010   define variable v-rid-list as character no-undo .
