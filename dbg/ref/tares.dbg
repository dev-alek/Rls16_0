     2988           (
     2989           " " + "  " +
     2990             " " + sort-column-phrase +
     2991           " " + sort-phrase-32
     2992           )
     2993         parameter-7-32 =
     2994           " indexed-reposition  "
     2995       .
     2996       do
     2997       on stop undo, leave
     2998       on error undo, leave
     2999       :
     3000         assign
