     3301       assign
     3302         l-query-was-opened = true
     3303       .
     3304     end.
     3305   end.
     3306     run waitfram-hide in this-procedure .
     3307   end.
     3308   if not p-open-query then
     3309   REPOSITION br-tares to recid v-doc-rec No-ERROR.
     3310   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3311   query br-tares:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3312   run waitfram-hide in this-procedure.
     3313   APPLY "VALUE-CHANGED" TO br-tares in frame Dialog-Frame.
     3314   APPLY "ENTRY" TO br-tares.
     3315   END PROCEDURE.
     3316   PROCEDURE proc-b-del :
     3317   define variable loc#log as logical no-undo.
     3318   define variable v-stts like ub.tare.stts no-undo .
     3319   DEFINE VARIABLE loc-doc-rec AS RECID NO-UNDO.
     3320   if not available X_tare then return error.
     3321   do
     3322   on error undo, return error
     3323   on stop undo, return error
     3324   :
     3325   define variable vss-include-info35 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3326   do:
     3327     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3328       (input  v-cntxt-db-num
     3329       ,input  v-cntxt-userid
     3330       ,input  0
     3331       ,input  'actn_tare_update':U
     3332       ,input  'global':U
     3333       ,input  0
     3334       ,input  '':U
     3335       ,input  0
     3336       ,input  0
     3337       ,input  0
     3338       ,input  0
     3339       ,input  true
     3340       ,output loc#log
     3341       )  .
     3342   end.
     3343   if not loc#log then return error.
     3344     assign
     3345     v-stts = ?
     3346     loc-doc-rec = RECID(X_tare)
     3347     .
     3348     run ref/tare02.p (
     3349                     input recid(X_tare)
     3350                     ,input no
     3351                     ,input-output v-stts
     3352                    ) no-error .
     3353     if error-status:error then undo, return error.
     3354     RUN OpenBr ( input yes, input no, input no).
     3355     REPOSITION br-tares to recid loc-doc-rec No-error.
     3356     if error-status:error then do:                           find first pos_tare no-lock where                                   recid(pos_tare) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ТАРЫ" skip                            string(if avail pos_tare                                     then  substitute("Код тары: &1"                                                     , pos_tare.tare-code)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     3357     if available X_tare then do:
     3358       loc#log = br-tares:select-focused-row( ) IN FRAME Dialog-Frame.
     3359     end.
     3360     apply "ENTRY" to br-tares.
     3361   end.
     3362   END PROCEDURE.
     3363   PROCEDURE proc-b-print :
     3364   define variable v-doc-rec as recid no-undo .
     3365   define variable accum-count as integer.
     3366   define variable date_string     as      char    no-undo.
     3367   define variable Line            as      char    no-undo.
     3368   DEFINE VARIABLE v-stts-chr AS CHARACTER NO-UNDO.
     3369   DEFINE FRAME tare-list
     3370   X_tare.tare-code COLUMN-LABEL "Код"
     3371   X_tare.tare-name COLUMN-LABEL "Название"
     3372   v-stts-chr FORMAT "X(8)" COLUMN-LABEL "Статус"
     3373   HEADER  date_string AT 5 format "X(35)"
     3374    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     3375   Line format "X(195)" AT 1
     3376   with width 232 down stream-io use-text    .
     3377   Line = fill("-", 195).
     3378   date_string = cur-time-print() .
     3379   run prn-lib-open-stream  in this-procedure (
     3380                                                input parParentProc
     3381                                               ,input 43
     3382                                               ,input yes
     3383                                               ,input no
     3384                                               ).
     3385   PUT  STREAM PrnLibStream
     3386   SPACE(25) ( frame Dialog-Frame:title )
     3387   format "x(90)" SKIP(1) .
     3388   FORM HEADER
     3389   Line format "X(195)" AT 1 SKIP
     3390   "Продолжение - на следующей странице" AT 30 SKIP
     3391   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3392   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3393   FORM with FRAME tare-list  .
     3394   run waitfram-show in this-procedure ("Ждите...").
     3395   v-doc-rec = recid(X_tare).
     3396   DO WHILE available X_tare :
     3397     GET prev br-tares.
     3398   END.
     3399   GET next br-tares.
     3400   DO WHILE available X_tare :
     3401     Display STREAM PrnLibStream
     3402      X_tare.tare-name
     3403     entry (lookup (STRING(p-stts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) @ v-stts-chr
     3404     X_tare.tare-code
     3405   with FRAME tare-list .
     3406     DOWN STREAM PrnLibStream 1
     3407     with FRAME tare-list  .
     3408     assign
     3409     accum-count = accum-count + 1
     3410     .
     3411     GET next br-tares.
     3412   END.
     3413   UNDERLINE  STREAM PrnLibStream
     3414   X_tare.tare-code
     3415   X_tare.tare-name
     3416   v-stts-chr
     3417   with FRAME tare-list .
     3418   DISPLAY STREAM PrnLibStream
     3419   "ИТОГО" @ X_tare.tare-name
     3420   accum-count @ v-stts-chr
     3421   with frame tare-list.
     3422   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3423   HIDE  STREAM PrnLibStream FRAME tare-List.
     3424   output  STREAM PrnLibStream CLOSE.
     3425   REPOSITION br-tares to recid v-doc-rec no-error.
     3426   APPLY "entry" to br-tares.
     3427   run waitfram-hide in this-procedure .
     3428   run prn-lib-prn-file in this-procedure (
     3429                                             input parParentProc
     3430                                             ,input 8
     3431                                             ).
     3432   END PROCEDURE.
     3433   PROCEDURE proc-b-sch :
     3434   assign
     3435     tbl = 'tare'
     3436     join-tbl = 'X_tare'
     3437     fld = ""
     3438     lab = ""
     3439     spr = ""
     3440     dim = '0'
     3441     .
     3442   run fltfield-add in this-procedure('tare-code', 'Код тары', '',
     3443   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3444   run fltfield-add in this-procedure('tare-name', 'Название', '',
     3445   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3446   Filter-Block:
     3447   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     3448       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     3449       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     3450     run gbl/filter.w ( INPUT parparentproc
     3451                       , INPUT (filter-point + chr(4) +
     3452                               filter-point-name)
     3453                       , INPUT tbl
     3454                       , INPUT join-tbl
     3455                       , INPUT fld
     3456                       , INPUT lab
     3457                       , INPUT spr
     3458                       , INPUT dim ).
     3459     run OpenBr in this-procedure ( input yes, input no, input '':U).
     3460   END.
     3461   END PROCEDURE.
     3462   PROCEDURE proc-br-tares :
     3463   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3464   if b-sel:sensitive in frame Dialog-Frame then dO:
     3465       if b-mark:sensitive then do:
     3466           apply "choose" to b-mark in frame Dialog-Frame.
     3467       end.
     3468       else do:
     3469           apply "choose" to b-sel in frame Dialog-Frame.
     3470       end.
     3471   end.
     3472   else do:
     3473       if b-lkp:sensitive then
     3474       apply "choose" to b-lkp in frame Dialog-Frame.
     3475   end.
     3476   END PROCEDURE.
