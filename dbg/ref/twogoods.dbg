     1327   procedure diasize_set-height :
     1328     define input  parameter p-new-height  as decimal   no-undo .
     1329     define input  parameter p-move-resize as logical   no-undo .
     1330     do
     1331     on error undo, return error return-value
     1332     :
     1333       run diasize_change-height in this-procedure
     1334         (input  (p-new-height - frame Dialog-Frame :height)
     1335         ,input  p-move-resize
     1336         ) .
     1337     end.
     1338   end procedure.
     1339   procedure diasize_change-width :
     1340     define input  parameter p-change-value as decimal   no-undo .
     1341     define input  parameter p-move-resize  as logical   no-undo .
     1342     define variable v-field-group-handle   as handle    no-undo .
     1343     define variable v-object-handle        as handle    no-undo .
     1344     define variable v-frame-width          as decimal   no-undo .
     1345     define variable v-frame-virtual-width  as decimal   no-undo .
     1346     define variable v-browse-width         as decimal   no-undo .
     1347     define variable v-window-width         as decimal   no-undo .
     1348     define variable v-window-virtual-width as decimal   no-undo .
     1349     define variable v-change-sign          as integer   no-undo .
     1350     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1351     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1352     if p-change-value > 0
     1353     then do:
     1354       if frame Dialog-Frame :width + p-change-value >
     1355           session :width-chars
     1356       then do:
     1357         assign
     1358           p-change-value = session :width-chars - frame Dialog-Frame :width
     1359         .
     1360         if p-change-value <= 0
     1361         then do:
     1362           run diasize_position-resize-button in this-procedure .
     1363           return .
     1364         end.
     1365       end.
     1366     end.
     1367     if p-change-value < 0
     1368     then do:
     1369       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1370       then do:
     1371         assign
     1372           p-change-value = v-diasize-orig-frame-width
     1373                          - frame Dialog-Frame :width
     1374         .
     1375         if p-change-value >= 0
     1376         then do:
     1377           run diasize_position-resize-button in this-procedure .
     1378           return .
     1379         end.
     1380       end.
     1381     end.
     1382     if p-change-value >= 0
     1383     then do:
     1384       assign
     1385         v-change-sign = 1
     1386       .
     1387     end.
     1388     else do:
     1389       assign
     1390         v-change-sign = -1
     1391       .
     1392     end.
     1393     assign
     1394       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1395     .
     1396     if p-change-value = 0
     1397     then do:
     1398       run diasize_position-resize-button in this-procedure .
     1399       return .
     1400     end.
