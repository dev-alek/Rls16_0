     1687       if p-move-resize
     1688       then do:
     1689         run diasize_position-resize-button in this-procedure .
     1690       end.
     1691       if v-diasize-wndstore = true
     1692       then do:
     1693         if connected("ub") = true
     1694         then do:
     1695           define variable v-cntxt-db-num        as integer   no-undo .
     1696           define variable v-cntxt-userid        as character no-undo .
     1697           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1698                                             , OUTPUT v-cntxt-userid
     1699                                             ) .
     1700           run gbl/wndsizew.p
     1701             (input  v-cntxt-db-num
     1702             ,input  v-cntxt-userid
     1703             ,input  v-diasize-proc-name
     1704             ,input  'width':u
     1705             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1706             ) .
     1707         end.
     1708       end.
     1709     end.
     1710     assign
     1711       v-diasize-change-size = false
     1712     .
     1713   end procedure.
     1714   procedure diasize_set-width :
     1715     define input  parameter p-new-width  as decimal   no-undo .
     1716     define input  parameter p-move-resize as logical   no-undo .
     1717     do
     1718     on error undo, return error return-value
     1719     :
     1720       run diasize_change-width in this-procedure
     1721         (input  (p-new-width - frame Dialog-Frame :width)
     1722         ,input  p-move-resize
     1723         ) .
     1724     end.
     1725   end procedure.
     1726   procedure diasize_position-resize-button :
     1727     do with frame Dialog-Frame
     1728     :
     1729       hide v-diasize-resize-button .
     1730       assign
     1731         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1732                     - 1
     1733                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1734         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1735                     - 1
     1736                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1737       .
     1738       view v-diasize-resize-button .
     1739     end.
     1740   end procedure.
     1741   on alt-right anywhere
     1742   do:
     1743     run diasize_change-width in this-procedure
     1744       (input 1
     1745       ,input true
     1746       ) .
     1747     return no-apply .
     1748   end.
     1749   on alt-left anywhere
     1750   do:
     1751     run diasize_change-width in this-procedure
     1752       (input -1
     1753       ,input true
     1754       ) .
     1755     return no-apply .
     1756   end.
     1757   on alt-down anywhere
     1758   do:
     1759     run diasize_change-height in this-procedure
     1760       (input 1
     1761       ,input true
     1762       ) .
     1763     return no-apply .
     1764   end.
     1765   on alt-up anywhere
     1766   do:
     1767     run diasize_change-height in this-procedure
     1768       (input -1
     1769       ,input true
     1770       ) .
     1771     return no-apply .
     1772   end.
     1773   on alt-enter of frame Dialog-Frame
     1774   do:
     1775     run diasize_maximize in this-procedure
     1776       (input  ?
     1777       ).
     1778     return no-apply .
     1779   end.
     1780   procedure diasize_end-move :
     1781     do
     1782     on error undo, return error return-value
     1783     :
     1784       define variable v-row-delta as decimal   no-undo .
     1785       define variable v-col-delta as decimal   no-undo .
     1786       define variable v-new-row as decimal   no-undo .
     1787       define variable v-new-col as decimal   no-undo .
     1788       assign
     1789         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1790         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1791       .
     1792       assign
     1793         v-row-delta = v-new-row - frame Dialog-Frame :height
     1794         v-col-delta = v-new-col - frame Dialog-Frame :width
     1795       .
     1796       run diasize_change-height in this-procedure
     1797         (input v-row-delta
     1798         ,input true
     1799         ) .
     1800       run diasize_change-width in this-procedure
     1801         (input v-col-delta
     1802         ,input true
     1803         ) .
     1804     end.
     1805   end procedure.
     1806   procedure diasize_maximize :
     1807     define input  parameter p-action as logical   no-undo .
     1808     do
     1809     on error undo, return error return-value
     1810     :
     1811       if p-action = ?
     1812       then do:
     1813         if v-diasize-need-maximize = true
     1814         then do:
     1815           assign
     1816             p-action = true
     1817           .
     1818         end.
     1819         else do:
     1820           assign
     1821             p-action = false
     1822           .
     1823         end.
     1824       end.
     1825       if p-action = true
     1826       then do:
     1827         run diasize_change-height in this-procedure
     1828           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1829               - frame Dialog-Frame :height-chars
     1830           ,input true
     1831           ) .
     1832         run diasize_change-width in this-procedure
     1833           (input session :width-chars
     1834               - frame Dialog-Frame :width-chars
     1835           ,input true
     1836           ) .
     1837         assign
     1838           v-diasize-need-maximize = false
     1839         .
     1840       end.
     1841       else do:
     1842         run diasize_change-width in this-procedure
     1843           (input v-diasize-orig-frame-width
     1844               - frame Dialog-Frame :width-chars
     1845           ,input true
     1846           ) .
     1847         run diasize_change-height in this-procedure
     1848           (input v-diasize-orig-frame-height
     1849               - frame Dialog-Frame :height-chars
     1850           ,input true
     1851           ) .
     1852         assign
     1853           v-diasize-need-maximize = true
     1854         .
     1855       end.
     1856     end.
     1857   end procedure.
     1858   procedure diasize_restore-orig-size :
     1859     do
     1860     on error undo, return error return-value
     1861     :
     1862       assign
     1863         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1864         v-diasize-current-frame-height = frame Dialog-Frame :height
     1865       .
     1866       run diasize_set-height in this-procedure
     1867         (input  v-diasize-orig-frame-height
     1868         ,input  true
     1869         ) .
     1870       run diasize_set-width in this-procedure
     1871         (input  v-diasize-orig-frame-width
     1872         ,input  true
     1873         ) .
     1874     end.
     1875   end procedure.
     1876   procedure diasize_restore-current-size :
     1877     do
     1878     on error undo, return error return-value
     1879     :
     1880       run diasize_set-height in this-procedure
     1881         (input  v-diasize-current-frame-height
     1882         ,input  true
     1883         ) .
     1884       run diasize_set-width in this-procedure
     1885         (input  v-diasize-current-frame-width
     1886         ,input  true
     1887         ) .
     1888     end.
     1889   end procedure.
     1890   procedure diasize_set-browse-handle :
     1891     define input  parameter p-browse-handle as handle   no-undo .
     1892     define buffer buf_temp-browse-handle for temp-browse-handle .
     1893     do
     1894     on error undo, return error return-value
     1895     :
     1896       assign
     1897         v-diasize-browse-handle = p-browse-handle
     1898       .
     1899       for each buf_temp-browse-handle
     1900       on error undo, return error return-value
     1901       :
     1902         delete buf_temp-browse-handle .
     1903       end.
     1904     end.
     1905   end procedure.
     1906   procedure diasize_add_browse :
     1907     define input  parameter p-browse-type   as character no-undo .
     1908     define input  parameter p-browse-handle as handle    no-undo .
     1909     define buffer buf_temp-browse-handle for temp-browse-handle .
     1910     do
     1911     on error undo, return error return-value
     1912     :
     1913       assign
     1914         v-diasize-browse-number = v-diasize-browse-number + 1
     1915       .
     1916       create buf_temp-browse-handle .
     1917       assign
     1918         buf_temp-browse-handle.browse-type   = p-browse-type
     1919         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1920         buf_temp-browse-handle.browse-handle = p-browse-handle
     1921       .
     1922     end.
     1923   end procedure.
     1924   procedure diasize_init :
     1925     define variable v-default-value    as logical   no-undo .
     1926     define variable v-restore-saved    as logical   no-undo .
     1927     define variable v-resize-value-str as character no-undo .
     1928     do
     1929     on error undo, return error return-value
     1930     :
     1931       do with frame Dialog-Frame
     1932       :
     1933         assign
     1934           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1935           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1936           v-diasize-browse-handle     = browse BR-gds :handle
     1937         .
     1938         create button v-diasize-resize-button
     1939         assign
     1940           parent        = frame Dialog-Frame :first-child
     1941           label         = "s"
     1942           height-pixels = 16
     1943           width-pixels  = 16
     1944           visible       = true
     1945           sensitive     = true
     1946           movable       = true
     1947           triggers:
     1948             on end-move persistent run diasize_end-move in this-procedure .
     1949           end triggers.
     1950         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1951         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1952         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1953         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1954         assign
     1955           v-diasize-wndmax = false
     1956         .
     1957         if connected("ub") = true
     1958         then do:
     1959           define variable v-cntxt-db-num        as integer   no-undo .
     1960           define variable v-cntxt-userid        as character no-undo .
     1961           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1962                                             , OUTPUT v-cntxt-userid
     1963                                             ) .
     1964           run gbl/wndpar_r.p
     1965             (input  v-cntxt-db-num
     1966             ,input  v-cntxt-userid
     1967             ,input  'wndmax':U
     1968             ,output v-diasize-wndmax
     1969             ,output v-default-value
     1970             ) .
     1971         end.
     1972         assign
     1973           v-diasize-wndstore = false
     1974         .
     1975         if connected("ub") = true
     1976         then do:
     1977           run gbl/wndpar_r.p
     1978             (input  v-cntxt-db-num
     1979             ,input  v-cntxt-userid
     1980             ,input  'wndstore':U
     1981             ,output v-diasize-wndstore
     1982             ,output v-default-value
     1983             ) .
     1984         end.
     1985         assign
     1986           v-diasize-proc-name = entry(1, program-name(2), '.')
     1987         .
     1988         if v-diasize-wndstore = true
     1989         then do:
     1990           assign
     1991             v-restore-saved = false
     1992           .
     1993           if connected("ub") = true
     1994           then do:
     1995             run gbl/wndsizer.p
     1996               (input  v-cntxt-db-num
     1997               ,input  v-cntxt-userid
     1998               ,input  v-diasize-proc-name
     1999               ,input  'height':u
     2000               ,output v-resize-value-str
     2001               ) .
     2002             if v-resize-value-str <> '':U
     2003             then do:
     2004               run diasize_change-height in this-procedure
     2005                 (input  integer(v-resize-value-str)
     2006                 ,input  true
     2007                 ) .
     2008               assign
     2009                 v-restore-saved = true
     2010               .
     2011             end.
     2012           end.
     2013           if connected("ub") = true
     2014           then do:
     2015             run gbl/wndsizer.p
     2016               (input  v-cntxt-db-num
     2017               ,input  v-cntxt-userid
     2018               ,input  v-diasize-proc-name
     2019               ,input  'width':u
     2020               ,output v-resize-value-str
     2021               ) .
     2022             if v-resize-value-str <> '':U
     2023             then do:
     2024               run diasize_change-width in this-procedure
     2025                 (input  integer(v-resize-value-str)
     2026                 ,input  true
     2027                 ) .
     2028               assign
     2029                 v-restore-saved = true
     2030               .
     2031             end.
     2032           end.
     2033           if v-restore-saved <> true
     2034           then do:
     2035             if v-diasize-wndmax = true
     2036             then do:
     2037               run diasize_maximize in this-procedure
     2038                 (input  true
     2039                 ) .
     2040             end.
     2041           end.
     2042         end.
     2043         else do:
     2044           if v-diasize-wndmax = true
     2045           then do:
     2046             run diasize_maximize in this-procedure
     2047               (input  true
     2048               ) .
     2049           end.
     2050         end.
     2051       end.
     2052     end.
     2053   end procedure.
     2054   procedure diasize_need-full-display :
     2055     define output parameter p-need-full-display as logical   no-undo .
     2056     do
     2057     on error undo, return error return-value
     2058     :
     2059       assign
     2060         p-need-full-display = v-diasize-need-full-display
     2061       .
     2062       assign
     2063         v-diasize-need-full-display = false
     2064       .
     2065     end.
     2066   end procedure.
     2067   procedure get-context :
     2068      define output parameter p-db-num as integer          no-undo.
     2069      define output parameter p-user-id as character        no-undo.
     2070      define variable v-login               as character    no-undo.
     2071      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2072      define buffer buf_user-login  for ub.user-login .
     2073      do
     2074      on error undo, return error
     2075      :
     2076            FIND FIRST buf_sys-ctrl no-lock.
     2077            ASSIGN
     2078               v-login = USERID("ub")
     2079               p-db-num = buf_sys-ctrl.db-num
     2080            .
     2081            FIND FIRST buf_user-login
     2082                 WHERE buf_user-login.db-num = p-db-num
     2083                   AND buf_user-login.user-login = v-login
     2084                 no-lock
     2085                 no-error
     2086                 .
     2087            IF AVAILABLE buf_user-login
     2088            THEN DO:
     2089               assign
     2090                  p-user-id = buf_user-login.user-id
     2091               .
     2092            END.
     2093      end.
     2094   end procedure.
     2095       run diasize_init in this-procedure .
     2096   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2097   on F9 of frame Dialog-Frame anywhere do:
     2098     run get-goods-recid.
     2099     if gds-rec = ? then
     2100       return no-apply.
     2101     run ref/gds-form.w ( input parparentproc
     2102                         ,input 'ПРОСМОТР':U
     2103                         ,input ?
     2104                         ,input ?
     2105                         ,input ?
     2106                         ,input-output gds-rec).
     2107     apply "entry" to br-gds in frame Dialog-Frame.
     2108     return no-apply.
     2109   end.
     2110   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2111   procedure set-filter-name :
     2112   define input parameter p-filter-name as character no-undo .
     2113     do with frame Dialog-Frame:
     2114       if p-filter-name > "" then do:
     2115         assign
     2116           frame Dialog-Frame:title
     2117             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2118         .
     2119         assign
     2120           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2121         .
     2122       end.
     2123       else do:
     2124         assign
     2125           b-sch :tooltip = ""
     2126         .
     2127       end.
     2128     end.
     2129   end procedure.
     2130   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2131   on f5 of frame Dialog-Frame anywhere
     2132   do:
     2133     v-doc-rec = recid(X_gds-obj). Run Openbr in this-procedure ( input yes, input no, input '':U). reposition br-gds to recid v-doc-rec no-error. v-doc-rec = ?.
     2134       apply "VALUE-CHANGED" to BR-gds.
     2135   end.
     2136   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2137   do:
     2138     BR-gds :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2139   end.
     2140   MAIN-BLOCK:
     2141   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2142      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2143     RUN enable_UI.
     2144     apply "value-changed" to rs-action.
     2145     Run OpenBr in this-procedure ( input yes, input no, input '':U).
     2146   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2147   DEF VAR cur-clmn-numbr-gds as INT EXTENT 9 no-undo.
     2148   DEF VAR varmvibr-gds       as INT no-undo.
     2149   DEF VAR varmvjbr-gds       as INT no-undo.
     2150   DEF VAR varmvkbr-gds       as INT no-undo.
     2151   DEF VAR varmvlbr-gds       as INT no-undo.
     2152   DEF VAR move-elementbr-gds as INT no-undo.
     2153   def var jjbr-gds           as int no-undo.
     2154   do varmvibr-gds = 1 to EXTENT(cur-clmn-numbr-gds):
     2155     ASSIGN cur-clmn-numbr-gds[varmvibr-gds] = varmvibr-gds.
     2156   END.
     2157   RUN start-mv-clmnbr-gds.
     2158   PROCEDURE start-mv-clmnbr-gds:
     2159   def var old-session as logical no-undo.
     2160      old-session = SESSION:IMMEDIATE-DISPLAY.
     2161      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2162          IF  p-mode = 'объект':U  THEN DO:
     2163      DO jjbr-gds = NUM-ENTRIES('1,2,3,4,5,6,7,8,9') TO 1 BY -1:
     2164        RUN re-move-clmnbr-gds ( cur-clmn-numbr-gds[INTEGER(ENTRY (jjbr-gds, '1,2,3,4,5,6,7,8,9'))] ,  + 1).
     2165      END.
     2166          END.
     2167      SESSION:IMMEDIATE-DISPLAY = old-session.
     2168   END.
     2169   ON ctrl-cursor-right OF BROWSE br-gds do:
     2170     RUN re-move-clmnbr-gds (  + 1, 9).
     2171   END.
     2172   ON ctrl-cursor-left OF BROWSE br-gds do:
     2173     RUN re-move-clmnbr-gds (9,  + 1).
     2174   END.
     2175   PROCEDURE re-move-clmnbr-gds:
     2176     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2177     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2178     DO varmvibr-gds = 1 TO EXTENT(cur-clmn-numbr-gds):
     2179       if cur-clmn-numbr-gds[varmvibr-gds] = source-column THEN cur-clmn-numbr-gds[varmvibr-gds] = -1.
     2180     END.
     2181     if br-gds:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2182     if source-column > target-column THEN
     2183     DO varmvjbr-gds = source-column - 1 to target-column BY -1:
     2184       DO varmvibr-gds = 1 TO EXTENT(cur-clmn-numbr-gds):
     2185           if cur-clmn-numbr-gds[varmvibr-gds] = varmvjbr-gds THEN DO:
     2186             cur-clmn-numbr-gds[varmvibr-gds] = cur-clmn-numbr-gds[varmvibr-gds] + 1.
     2187           END.
     2188       END.
     2189     END.
     2190     ELSE
     2191     DO varmvjbr-gds = source-column + 1 to target-column:
     2192       DO varmvibr-gds = 1 TO EXTENT(cur-clmn-numbr-gds):
     2193         if cur-clmn-numbr-gds[varmvibr-gds] = varmvjbr-gds THEN DO:
     2194           cur-clmn-numbr-gds[varmvibr-gds] = cur-clmn-numbr-gds[varmvibr-gds] - 1.
     2195         END.
     2196       END.
     2197     END.
     2198     DO varmvibr-gds = 1 TO EXTENT(cur-clmn-numbr-gds):
     2199       if cur-clmn-numbr-gds[varmvibr-gds] = -1 THEN cur-clmn-numbr-gds[varmvibr-gds] = target-column.
     2200     END.
     2201   END PROCEDURE.
     2202   PROCEDURE ch-clmnbr-gds:
     2203     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2204     if cur-clmn-loc <=  + 1 then do:
     2205       return .
     2206     end.
     2207     DO varmvibr-gds = 1 TO EXTENT(cur-clmn-numbr-gds):
     2208       if cur-clmn-numbr-gds[varmvibr-gds] = cur-clmn-loc THEN move-elementbr-gds = varmvibr-gds.
     2209     END.
     2210     RUN re-move-clmnbr-gds (cur-clmn-loc,  + 1).
     2211   END PROCEDURE.
     2212   PROCEDURE mv-brw-defaultbr-gds:
     2213   def var old-session as logical no-undo.
     2214     old-session = SESSION:IMMEDIATE-DISPLAY.
     2215     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2216     do varmvlbr-gds =  + 1 to EXTENT(cur-clmn-numbr-gds):
     2217       RUN re-move-clmnbr-gds (cur-clmn-numbr-gds[varmvlbr-gds], varmvlbr-gds).
     2218     END.
     2219     RUN start-mv-clmnbr-gds.
     2220     SESSION:IMMEDIATE-DISPLAY = old-session.
     2221   END PROCEDURE.
     2222   .
     2223     WAIT-FOR GO OF FRAME Dialog-Frame.
     2224   END.
     2225   RUN disable_UI.
     2226   PROCEDURE disable_UI :
     2227     HIDE FRAME Dialog-Frame.
     2228   END PROCEDURE.
     2229   PROCEDURE enable_UI :
     2230     DISPLAY rs-action for-prod-name for-gds-code for-sort
     2231         WITH FRAME Dialog-Frame.
     2232     ENABLE B-exit B-parts B-reshparts B-sch B-Help rs-action BR-gds for-prod-name
     2233            for-gds-code for-sort
     2234         WITH FRAME Dialog-Frame.
     2235     VIEW FRAME Dialog-Frame.
     2236   END PROCEDURE.
     2237   PROCEDURE get-goods-recid :
     2238   if avail X_gds-obj then
     2239   gds-rec = recid(X_goods).
     2240   else
     2241   gds-rec = ?.
     2242   END PROCEDURE.
     2243   PROCEDURE MyEnable :
     2244     ENABLE B-exit B-sch B-Help BR-gds
     2245         WITH FRAME Dialog-Frame.
     2246     VIEW FRAME Dialog-Frame.
     2247   END PROCEDURE.
     2248   PROCEDURE OpenBr :
     2249   define input  parameter p-open-query     as logical   no-undo .
     2250   define input  parameter p-find-next      as logical   no-undo .
     2251   define input  parameter p-find-condition as character no-undo .
     2252   define variable l-query-was-opened as logical no-undo .
     2253   run waitfram-show in this-procedure ("Ждите...").
     2254   define variable sort-column-phrase as character no-undo .
     2255   case sort-column-name :
     2256     when "" then do:
     2257       assign
     2258         sort-column-phrase = ""
     2259       .
     2260     end.
     2261     otherwise do:
     2262       assign
     2263         sort-column-phrase = "by " + sort-column-name
     2264       .
     2265     end.
     2266   end case.
     2267   CASE p-mode:
     2268       when 'объект':U then do:
     2269           ASSIGN frame Dialog-Frame:TITLE = "Товары с двумя ед.изм. на объекте " + loc-store-type + string(loc-store-code)
     2270           filter-point = filter-point0 + p-mode
     2271           filter-label = substitute("&1 Один объект", filter-label0)
     2272           .
     2273           case rs-action:
     2274             when "all":U then do:
     2275   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2276   define variable  l-disable-where-14  as logical   no-undo .
