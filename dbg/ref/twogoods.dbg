     2602   FUNCTION is-case RETURNS LOGICAL
     2603     ( buffer loc-gds-obj for X_gds-obj  ) :
     2604   DEFINE BUFFER LOC-PARTS FOR ub.parts.
     2605     find FIRST loc-parts No-LOCK WHERE
     2606                loc-parts.artic = loc-gds-obj.artic AND
     2607                loc-parts.prod-type = loc-gds-obj.prod-type AND
     2608                loc-parts.prod-code = loc-gds-obj.prod-code AND
     2609                loc-parts.obj-type = loc-gds-obj.obj-type AND
     2610                loc-parts.obj-code = loc-gds-obj.obj-code AND
     2611                loc-parts.out-code = 'free-zone':U and
     2612                LOC-PARTS.CLI-QNTY > 1 no-error.
     2613     RETURN avail(loc-parts).
     2614   END FUNCTION.
     2615   FUNCTION is-stuck RETURNS LOGICAL
     2616     ( buffer loc-gds-obj for X_gds-obj ) :
     2617   define buffer loc-parts for ub.parts.
     2618     find FIRST loc-parts No-LOCK WHERE
     2619                loc-parts.artic = loc-gds-obj.artic AND
     2620                loc-parts.prod-type = loc-gds-obj.prod-type AND
     2621                loc-parts.prod-code = loc-gds-obj.prod-code AND
     2622                loc-parts.obj-type = loc-gds-obj.obj-type AND
     2623                loc-parts.obj-code = loc-gds-obj.obj-code AND
     2624                loc-parts.out-code = 'free-zone':U and
     2625                LOC-PARTS.CLI-QNTY = 1 no-error.
     2626     RETURN avail(loc-parts).
     2627   END FUNCTION.
     2628   FUNCTION Prod-name RETURNS CHARACTER
     2629     ( input p-prod-type as character, input p-prod-code as integer) :
     2630   FIND FIRST ub.clients no-LOCK where
     2631              ub.clients.obj-type = p-prod-type AND
     2632              ub.clients.obj-code = p-prod-code NO-ERROR.
     2633     if avail ub.clients then
     2634     return ub.clients.obj-name.
     2635     else
     2636     RETURN "".
     2637   END FUNCTION.
