     2290     ,output filter-name-14
     2291     ,output where-phrase-14
     2292     ,output sort-phrase-14
     2293     ,output where-phrase-rus-14
     2294     ,output sort-phrase-rus-14
     2295     ).
     2296       run set-filter-name in this-procedure
     2297         (INPUT filter-name-14
     2298         ) no-error .
     2299     assign
     2300       l-filter-open-14 = false
     2301     .
     2302     if flt-rec-14 <> ?
     2303       or sort-column-phrase > ""
     2304     then do:
     2305       define variable  parameter-2-14 as character no-undo .
     2306       define variable  parameter-3-14 as character no-undo .
     2307       define variable  parameter-4-14 as character no-undo .
     2308       define variable  parameter-5-14 as character no-undo .
     2309       define variable  parameter-6-14 as character no-undo .
     2310       define variable  parameter-7-14 as character no-undo .
     2311         assign
     2312         parameter-3-14 =
     2313                                 "FOR EACH X_gds-obj NO-LOCK"
     2314         parameter-4-14 =
     2315           (
     2316             if (" X_gds-obj.obj-type = loc-store-type AND X_gds-obj.obj-code = loc-store-code and X_gds-obj.fact-qnty <> 0 " + " " + where-phrase-14) <> ""
     2317             then  substitute('X_gds-obj.obj-type = &1&2&1 AND X_gds-obj.obj-code = &3 and X_gds-obj.fact-qnty <> 0 '                                    , chr(34), loc-store-type, loc-store-code) + " " + where-phrase-14
     2318             else "true"
     2319           )
     2320         parameter-5-14 = (" " + "" + " " + substitute(', FIRST X_goods NO-LOCK WHERE X_goods.gds-code = X_gds-obj.gds-code,              FIRST X_units WHERE X_units.unit-name = X_goods.unit-base AND LOOKUP(&1&2&1, X_units.type) > 0,             FIRST X_parts No-LOCK WHERE X_parts.artic = X_gds-obj.artic AND X_parts.prod-type = X_gds-obj.prod-type AND             X_parts.prod-code = X_gds-obj.prod-code AND X_parts.obj-type = X_gds-obj.obj-type AND             X_parts.obj-code = X_gds-obj.obj-code AND X_parts.out-code = &1&3&1  ', chr(34), '2ед':U, 'free-zone':U))
     2321         parameter-6-14 = if sort-phrase-14 = ''
     2322                              then
     2323           (
     2324           " " + " " +
     2325             " " + sort-column-phrase +
     2326           " " + "  "
     2327           )
     2328                              else
     2329           (
     2330           " " + " " +
     2331             " " + sort-column-phrase +
     2332           " " + sort-phrase-14
     2333           )
     2334         parameter-7-14 =
     2335           "   "
     2336       .
     2337       do
     2338       on stop undo, leave
     2339       on error undo, leave
     2340       :
     2341         assign
     2342           l-disable-where-14 =
     2343             (" X_gds-obj.obj-type = loc-store-type AND X_gds-obj.obj-code = loc-store-code and X_gds-obj.fact-qnty <> 0 " + " " + where-phrase-14 = "")
     2344         .
