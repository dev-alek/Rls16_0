     2372         where  X_gds-obj.obj-type = loc-store-type AND X_gds-obj.obj-code = loc-store-code and X_gds-obj.fact-qnty <> 0
     2373       , FIRST X_goods NO-LOCK WHERE X_goods.gds-code = X_gds-obj.gds-code,              FIRST X_units WHERE X_units.unit-name = X_goods.unit-base AND LOOKUP('2ед':U, X_units.type) > 0,             FIRST X_parts No-LOCK WHERE X_parts.artic = X_gds-obj.artic AND X_parts.prod-type = X_gds-obj.prod-type AND             X_parts.prod-code = X_gds-obj.prod-code AND X_parts.obj-type = X_gds-obj.obj-type AND             X_parts.obj-code = X_gds-obj.obj-code AND X_parts.out-code = 'free-zone':U
     2374     .
     2375         assign
     2376           l-query-was-opened = true
     2377         .
     2378     end.
     2379     run waitfram-hide in this-procedure .
     2380             end.
