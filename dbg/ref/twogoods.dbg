        1   DEFINE BUFFER X_gds-obj FOR ub.gds-obj.
        2   DEFINE BUFFER X_goods FOR ub.goods.
        3   DEFINE BUFFER X_parts FOR ub.parts.
        4   DEFINE BUFFER X_units FOR ub.units.
        5   define input parameter parparentproc as widget-handle no-undo .
        6   define input parameter p-mode  as character no-undo .
        7   define input parameter loc-store-type like ub.clients.obj-type no-undo.
        8   define input parameter loc-store-code like ub.clients.obj-code no-undo.
        9   define variable vss-revision    as character no-undo init "$Revision$":u .
       10   define variable vss-author      as character no-undo init "$Author$":u .
       11   define variable vss-date        as character no-undo init "$Date$":u .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       13   define variable vss-archive     as character no-undo init "$Archive$":u .
       14   define variable vss-description as character no-undo init "Товары с двумя ед измерения на объекте" .
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   procedure proc-alt-shift-f2:
       76     if not ibs.th.gbl.gbl-var:rcode
       77   then
       78     run gbl\inidebug.p .
       79   end.
       80   procedure proc-alt-shift-f3:
       81     run gbl/prvssinf.p
       82       ( input this-procedure
       83       ) .
       84   end.
       85   define variable v-inform-launched as logical no-undo initial false .
       86   procedure proc-alt-shift-f4:
       87     define variable v-action as character no-undo .
       88     if v-inform-launched = false then do:
       89       assign
       90         v-inform-launched = true
       91       .
       92       run gbl/d-inform.w
       93         (  input self
       94         ,  input this-procedure
       95         , output v-action
       96         ) no-error .
       97       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       98       assign
       99         v-inform-launched = false
      100       .
      101     end.
      102   end.
      103   procedure proc-alt-f1:
      104     run gbl/corrhelp.p
      105       (input this-procedure
      106       ) .
      107   end .
      108   on alt-shift-f2 anywhere do:
      109     run proc-alt-shift-f2.
      110   end.
      111   on alt-shift-f3 anywhere do:
      112     run proc-alt-shift-f3 in this-procedure .
      113   end.
      114   on alt-shift-f4 anywhere do:
      115     run proc-alt-shift-f4 in this-procedure.
      116   end.
      117   on alt-f1 anywhere do:
      118     run proc-alt-f1 in this-procedure .
      119   end.
      120   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121   define variable c-point  as character no-undo .
      122   define variable tbl      as character no-undo .
      123   define variable join-tbl as character no-undo .
      124   define variable fld      as character no-undo .
      125   define variable lab      as character no-undo .
      126   define variable spr      as character no-undo .
      127   define variable dim      as character no-undo .
      128   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129   define variable v-waitfram-action01         as character   no-undo .
      130   define variable v-waitfram-action02         as character   no-undo .
      131   define variable v-waitfram-action03         as character   no-undo .
      132   define variable mWaitFramTextBeg            as character   no-undo.
      133   define variable mWaitFramTextEnd            as character   no-undo.
      134   define variable mWaitFramView               as logical     no-undo.
      135   define variable mWaitProcEvent              as logical     no-undo init yes.
      136   define variable mWaitFramInterval           as integer     no-undo init 1 .
      137   define variable mWaitFramStop               as logical     no-undo.
      138   define variable mWaitFramStopUser           as logical     no-undo.
      139   define variable mWaitFramStopTimeOut        as logical     no-undo.
      140   define variable mWaitFramStartProc          as datetime-tz no-undo.
      141   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      142   define button B-WaitFramStop auto-end-key
      143        label "Стоп"
      144        size 10 by 1 tooltip "Остоновить процесс".
      145   define button B-viewProcInfo
      146        label "Информация"
      147        size 15 by 1 tooltip "Информация о процесс".
      148   define frame waitfram
      149     v-waitfram-action01 format "x(72)" no-label skip
      150     v-waitfram-action02 format "x(72)" no-label skip
      151     v-waitfram-action03 format "x(72)" no-label skip
      152     B-viewProcInfo
      153     B-WaitFramStop at row 4 col 30
      154     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      155     .
      156   define new global shared variable mBatchMode as logical no-undo init ?.
      157   define variable mFramBachModHandle as handle no-undo.
      158   mFramBachModHandle = frame waitfram:handle.
      159   define variable mFameOldVis as logical no-undo.
      160   define variable mVisCUrentVin as logical no-undo.
      161   if session:batch-mode
      162   then
      163      mBatchMode = yes.
      164   if mBatchMode = ? then do:
      165     mVisCUrentVin = current-window:visible.
      166     mFameOldVis = mFramBachModHandle:visible.
      167     mFramBachModHandle:visible  = yes.
      168     mBatchMode = mFramBachModHandle:visible ne yes.
      169     mFramBachModHandle:visible = mFameOldVis.
      170     current-window:visible = mVisCUrentVin.
      171   end.
      172    if  log-manager:logfile-name ne ?
      173     then DO:
      174         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      175         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      176         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      177     end.
      178   on choose of B-WaitFramStop in frame waitfram
      179   do:
      180     mWaitFramStop = yes.
      181     mWaitFramStopUser = yes.
      182   end.
      183   function waitfram-check-timeout returns logical():
      184      define variable vtime as int64 no-undo.
      185      if mWaitFramStopTimeOut
      186      then
      187         return yes.
      188      vtime = ( now - mWaitFramStartProc ) / 1000 .
      189      if     mWaitFramTimeOut ne ?
      190         and mWaitFramTimeOut ne 0
      191         and mWaitFramTimeOut lt vtime
      192      then do:
      193         mWaitFramStopTimeOut = yes.
      194      end.
      195      return mWaitFramStopTimeOut.
      196   end.
      197   procedure waitfram-hide :
      198     if not session:batch-mode
      199     then do
      200     on error undo, return error return-value
      201     :
      202       pause 0 before-hide .
      203       if not mBatchMode then
      204         hide frame waitfram .
      205     if     not mWaitFramView
      206        and mWaitProcEvent
      207     then
      208       process events .
      209     end.
      210   end procedure.
      211   procedure waitfram-show :
      212     define input  parameter p-message as character no-undo .
      213     define variable v-left-margin as integer   no-undo .
      214     if not session:batch-mode
      215     then do
      216     on error undo, return error return-value
      217     :
      218       if length(p-message) <= 70 then do:
      219         assign
      220           v-left-margin = integer((70 - length(p-message)) / 2)
      221         .
      222         assign
      223           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      224         .
      225         assign
      226           v-waitfram-action01 = " "
      227           v-waitfram-action02 = " "
      228                                    + fill(" ", v-left-margin)
      229                                    + p-message
      230           v-waitfram-action03 = " "
      231         .
      232       end.
      233       else do:
      234         define variable vRindex1 as integer no-undo.
      235         define variable vRindex2 as integer no-undo.
      236         vRindex1 = r-index(p-message," ",70).
      237         if vRindex1 = 0
      238         then
      239            vRindex1 = 70.
      240         if length(p-message)  <= vRindex1 + 70 then do:
      241           assign
      242             v-waitfram-action01 = " "
      243             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      244             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      245           .
      246         end.
      247         else do:
      248           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      249           if vRindex2 <= vRindex1
      250           then
      251              vRindex2 = vRindex1 + 70.
      252           assign
      253             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      254             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      255             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      256           .
      257         end.
      258       end.
      259       B-viewProcInfo:visible   in frame waitfram = no.
      260       B-viewProcInfo:sensitive in frame waitfram = no.
      261       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      262       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      263       if  (   mWaitFramView
      264          or  mWaitProcEvent)
      265          and not mBatchMode
      266       then
      267          display
      268             v-waitfram-action01 skip
      269             v-waitfram-action02 skip
      270             v-waitfram-action03 skip
      271          with frame waitfram .
      272       if     mWaitFramView
      273          then do:
      274             if     mWaitFramInterval ne ?
      275                and not mBatchMode
      276             then
      277                wait-for go of frame waitfram pause mWaitFramInterval.
      278          end.
      279          else
      280             if     mWaitProcEvent
      281                and not mBatchMode
      282             then
      283                process events .
      284     end.
      285   end procedure.
      286      procedure waitfram-show-this:
      287         define input  parameter iInterval as int64 no-undo.
      288         define variable vtime as int64 no-undo.
      289         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      290         mWaitFramInterval = iInterval.
      291         run waitfram-show (substitute("&1&2 &3&4" ,
      292                                       mWaitFramTextBeg ,
      293                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      294                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      295                                       mWaitFramTextEnd
      296                                      )
      297                           ).
      298      end.
      299      procedure WaitFramRunPause:
      300         define input  parameter iInterval as dec no-undo.
      301         define variable vStart  as datetime-tz no-undo.
      302         define variable vend    as datetime-tz no-undo.
      303         define variable vint as int64 no-undo.
      304         define variable vOk as logical no-undo.
      305         vStart = now.
      306         vend   = vStart.
      307         publish "WaitFramPause" (iInterval,output vOk).
      308         vend   =  now.
      309         vint = vend - vStart.
      310         vint = iInterval - vint / 1000.
      311         if     not mWaitFramStop
      312            and (   vint > 0
      313                 or (    not vOk
      314                     and iInterval eq ?
      315                     )
      316                 )
      317         then
      318            run waitfram-show-this (iInterval).
      319         vend   =  now.
      320         vint = vend - vStart.
      321         vint = iInterval - vint / 1000.
      322         if     not mWaitFramStop
      323            and vint > 0
      324         then do:
      325            run gbl/pause.p (vint * 1000).
      326         end.
      327         if iInterval ne ?
      328         then
      329            publish "WaitFramStop".
      330         waitfram-check-timeout().
      331      end.
      332      procedure WaitFramWaitFor:
      333         define input  parameter iInterval as dec no-undo.
      334         assign
      335            mWaitFramStartProc   = now
      336            mWaitFramStopUser    = no
      337            mWaitFramStopTimeOut = no
      338         .
      339         block-wait:
      340         do while not mWaitFramStop:
      341            run WaitFramRunPause (iInterval).
      342            if  waitfram-check-timeout()
      343            then do:
      344               leave block-wait.
      345            end.
      346         end.
      347         run waitfram-hide.
      348      end.
      349   procedure waitfram-join :
      350     define input  parameter p-line-1  as character no-undo .
      351     define input  parameter p-line-2  as character no-undo .
      352     define input  parameter p-line-3  as character no-undo .
      353     define output parameter p-message as character no-undo .
      354     do
      355     on error undo, return error return-value
      356     :
      357       assign
      358         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      359                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      360                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      361       .
      362     end.
      363   end procedure.
      364   function waitfram-join-function returns character
      365     (input p-line-1 as character
      366     ,input p-line-2 as character
      367     ,input p-line-3 as character
      368     ).
      369     define variable v-message as character no-undo .
      370     run waitfram-join in this-procedure
      371       (input  p-line-1
      372       ,input  p-line-2
      373       ,input  p-line-3
      374       ,output v-message
      375       ) .
      376     return v-message .
      377   end function .
      378   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      379   procedure fltfield-clear :
      380     define output parameter loc-fld as character no-undo.
      381     define output parameter loc-lab as character no-undo .
      382     define output parameter loc-spr as character no-undo .
      383     define output parameter loc-dim as character no-undo .
      384     assign
      385       loc-fld = ""
      386       loc-lab = ""
      387       loc-spr = ""
      388       loc-dim = "0"
      389     .
      390   end procedure .
      391   procedure fltfield-add :
      392     define input        parameter par-fld as character no-undo.
      393     define input        parameter par-lab as character no-undo .
      394     define input        parameter par-spr as character no-undo .
      395     define input-output parameter loc-fld as character no-undo.
      396     define input-output parameter loc-lab as character no-undo .
      397     define input-output parameter loc-spr as character no-undo .
      398     define input-output parameter loc-dim as character no-undo .
      399     do
      400     on error undo, return error
      401     :
      402       assign
      403       loc-fld = if loc-dim = '0'
      404                 then par-fld
      405                 else (loc-fld + chr(44) + par-fld)
      406       loc-lab = if loc-dim = '0'
      407                 then par-lab
      408                 else (loc-lab + chr(44) + par-lab)
      409       loc-spr = if loc-dim = '0'
      410                 then par-spr
      411                 else (loc-spr + chr(44) + par-spr)
      412       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      413                 string(integer(if num-entries(loc-dim) > 1
      414                               then entry(2, loc-dim)
      415                               else entry(1, loc-dim)
      416                               ) + 1)
      417       no-error
      418       .
      419     end.
      420   end procedure.
      421   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      422   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      423   procedure fltopend_fltopend :
      424   define input parameter p-parent-handle as handle no-undo .
      425   define input parameter p-qh as handle no-undo .
      426   define input parameter p-flt-open-open-query  as character no-undo .
      427   define input parameter p-where-cond as character no-undo .
      428   define input parameter p-use-indFIRST-query-tail as character no-undo .
      429   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      430   define input parameter p-indexed-reposition as character no-undo .
      431     do
      432     on error undo, return error
      433     :
      434   define variable v-prepare-string as character no-undo .
      435   define variable glog as logical no-undo .
      436   assign
      437   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      438                      p-where-cond + chr(32)  +
      439                      p-use-indFIRST-query-tail + chr(32) +
      440                      p-use-ind-sort-clmn-by + chr(32) +
      441                      p-indexed-reposition
      442   .
      443   assign
      444   glog = p-qh:query-prepare(v-prepare-string) no-error .
      445   if not glog
      446   or error-status:error then do:
      447     message error-status:get-message(1) view-as alert-box .
      448     undo, return error .
      449   end.
      450   assign
      451   glog = p-qh:query-open no-error .
      452   if not glog
      453   or error-status:error then do:
      454     message error-status:get-message(1) view-as alert-box .
      455     undo, return error .
      456   end.
      457     end.
      458   end procedure.
      459   procedure fltopend_fltfindd :
      460   define input parameter p-parent-handle as handle no-undo .
      461   define input parameter p-qh as handle no-undo .
      462   define input parameter p-rowid as rowid no-undo .
      463   define input parameter p-next as logical no-undo .
      464   define input parameter p-lock as integer no-undo .
      465   define input parameter p-bh as handle no-undo .
      466   define input parameter p-where-cond as character no-undo .
      467   define input parameter p-use-index-phrase as character no-undo .
      468   define variable glog as logical no-undo .
      469   define variable v-qh as handle no-undo .
      470   define variable v-bh as handle no-undo .
      471   define variable v-recid as recid no-undo .
      472   define variable v-prepare-string as character no-undo .
      473   do
      474   on error undo, return error
      475   on stop undo, return error
      476   :
      477     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      478     create buffer v-bh for table p-bh buffer-name p-bh:name.
      479     create query v-qh.
      480     v-qh:set-buffers(v-bh).
      481     v-prepare-string = substitute("for each &1 &2 &3"
      482                                     ,v-bh:name
      483                                     ,p-where-cond
      484                                     ,p-use-index-phrase).
      485     glog = v-qh:query-prepare(v-prepare-string) no-error.
      486     if not glog then do:
      487       delete object v-qh.
      488       delete object v-bh.
      489       undo, return error .
      490     end.
      491     glog = v-qh:query-open no-error .
      492     if not glog then do:
      493       delete object v-qh.
      494       delete object v-bh.
      495       undo, return error .
      496     end.
      497     if p-next then do:
      498       v-qh:reposition-to-rowid(p-rowid) no-error .
      499       glog = v-qh:get-next( p-lock) no-error .
      500       glog = v-qh:get-next( p-lock) no-error .
      501       if not glog or v-qh:query-off-end = yes then do:
      502         glog = v-qh:get-first( p-lock) no-error .
      503       end.
      504     end.
      505     else do:
      506       glog = v-qh:get-first( p-lock) no-error .
      507     end.
      508     v-recid = v-bh:recid no-error .
      509     delete object v-qh.
      510     delete object v-bh.
      511     return string(v-recid) .
      512   end.
      513   end procedure.
      514   procedure fltopend_fltfindq :
      515   define input parameter p-parent-handle as handle no-undo .
      516   define input parameter p-qh as handle no-undo .
      517   define input parameter p-next as logical no-undo .
      518   define input parameter p-lock as integer no-undo .
      519   define input parameter p-flt-open-open-query  as character no-undo .
      520   define input parameter p-where-cond as character no-undo .
      521   define input parameter p-use-indFIRST-query-tail as character no-undo .
      522   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      523   define input parameter p-indexed-reposition as character no-undo .
      524   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      525   define variable glog as logical no-undo .
      526   define variable v-qh as handle no-undo .
      527   define variable v-bh as handle no-undo extent 18.
      528   define variable v-rowid as rowid no-undo extent 18.
      529   define variable v-ii as integer no-undo .
      530   define variable v-prepare-string as character no-undo .
      531   do
      532   on error undo, return error
      533   on stop undo, return error
      534   :
      535     create query v-qh.
      536     do v-ii = 1 to p-qh:num-buffers:
      537       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      538       assign
      539       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      540       no-error.
      541       v-qh:add-buffer(v-bh[v-ii]).
      542     end.
      543     assign
      544     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      545                       p-where-cond + chr(32)  +
      546                       p-use-indFIRST-query-tail + chr(32) +
      547                       p-use-ind-sort-clmn-by + chr(32) +
      548                       p-indexed-reposition
      549     .
      550     glog = v-qh:query-prepare( v-prepare-string) no-error .
      551     if not glog then do:
      552       delete object v-qh.
      553       do v-ii = 1 to p-qh:num-buffers:
      554         delete object v-bh[v-ii].
      555       end.
      556       undo, return error .
      557     end.
      558     glog = v-qh:query-open no-error .
      559     if not glog then do:
      560       delete object v-qh.
      561       do v-ii = 1 to p-qh:num-buffers:
      562         delete object v-bh[v-ii].
      563       end.
      564       undo, return error .
      565     end.
      566     if p-next then do:
      567       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      568       glog = v-qh:get-next( p-lock) no-error .
      569       glog = v-qh:get-next( p-lock) no-error .
      570       if not glog or v-qh:query-off-end = yes then do:
      571         glog = v-qh:get-first( p-lock) no-error .
      572       end.
      573     end.
      574     else do:
      575       glog = v-qh:get-first( p-lock) no-error .
      576     end.
      577     do v-ii = 1 to p-qh:num-buffers:
      578       assign
      579       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      580       no-error.
      581     end.
      582     delete object v-qh.
      583     do v-ii = 1 to p-qh:num-buffers:
      584       delete object v-bh[v-ii].
      585     end.
      586   end.
      587   end procedure.
      588   define variable filter-point as character no-undo init "twogoods" .
      589   define variable filter-point0 as character no-undo init "twogoods" .
      590   define variable filter-label as character no-undo init "Товары_с_2_ед_изм" .
      591   define variable filter-label0 as character no-undo init "Товары_с_2_ед_изм" . .
      592   define variable sort-column-name as character no-undo .
      593   define variable gds-rec as recid no-undo .
      594   define variable v-doc-rec as recid no-undo .
      595   FUNCTION is-case RETURNS LOGICAL
      596     ( buffer loc-gds-obj for X_gds-obj  )  FORWARD.
      597   FUNCTION is-stuck RETURNS LOGICAL
      598     ( buffer loc-gds-obj for X_gds-obj )  FORWARD.
      599   FUNCTION Prod-name RETURNS CHARACTER
      600     ( input p-prod-type as character, input p-prod-code as integer)  FORWARD.
      601   DEFINE BUTTON B-exit AUTO-GO
      602        LABEL "&Выход"
      603        SIZE 10 BY 1
      604        BGCOLOR 8 .
      605   DEFINE BUTTON B-Help
      606        LABEL "Помо&щь"
      607        SIZE 3 BY 1
      608        BGCOLOR 8 .
      609   DEFINE BUTTON B-parts
      610        LABEL "&Коробки"
      611        SIZE 10 BY 1.
      612   DEFINE BUTTON B-reshparts
      613        LABEL "&Штуки"
      614        SIZE 10 BY 1.
      615   DEFINE BUTTON B-sch
      616        LABEL "&Фильтр"
      617        SIZE 3 BY 1.
      618   DEFINE VARIABLE for-gds-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
      619         VIEW-AS TEXT
      620        SIZE 14.25 BY 1 NO-UNDO.
      621   DEFINE VARIABLE for-prod-name AS CHARACTER FORMAT "X(256)":U
      622         VIEW-AS TEXT
      623        SIZE 73.88 BY 1
      624        FGCOLOR 4  NO-UNDO.
      625   DEFINE VARIABLE for-sort AS CHARACTER FORMAT "X(30)":U
      626         VIEW-AS TEXT
      627        SIZE 16.63 BY 1
      628        FGCOLOR 4  NO-UNDO.
      629   DEFINE VARIABLE rs-action AS CHARACTER INITIAL "all"
      630        VIEW-AS RADIO-SET HORIZONTAL
      631        RADIO-BUTTONS
      632             "Все", "all",
      633   "Неразбитые партии", "split",
      634   "Штуки", "fuse"
      635        SIZE 50.38 BY 1 NO-UNDO.
      636   DEFINE QUERY BR-gds FOR
      637         X_gds-obj,
      638         X_goods,
      639         X_units,
      640         X_parts SCROLLING.
      641   DEFINE BROWSE BR-gds
      642     QUERY BR-gds NO-LOCK DISPLAY
      643         is-case(buffer X_gds-obj) COLUMN-LABEL "Кор-ки" FORMAT "+/":U
      644         is-stuck(buffer X_gds-obj) COLUMN-LABEL "Штуки" FORMAT "+/":U
      645         X_goods.artic FORMAT "X(16)":U
      646         X_goods.gds-name FORMAT "X(25)":U
      647         X_units.unit-name COLUMN-LABEL "Учет!ед.изм." FORMAT "X(3)":U
      648         X_goods.unit-cli COLUMN-LABEL "Ед.изм.!п-ка" FORMAT "X(3)":U
      649         X_goods.prod-type + string(X_goods.prod-code) COLUMN-LABEL "Пр-ль" FORMAT "X(12)":U
      650         X_goods.min-rate COLUMN-LABEL "Мин. кол-во в шт." FORMAT ">>,>>9.999":U
      651         X_goods.max-rate COLUMN-LABEL "Макс. кол-во в шт" FORMAT ">>,>>9.999":U
      652         X_gds-obj.free-qnty FORMAT "->>,>>>,>>9.999":U
      653         X_gds-obj.fact-qnty FORMAT "->>,>>>,>>9.999":U
      654       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.5 BY 16.38.
      655   DEFINE FRAME Dialog-Frame
      656        B-exit AT ROW 1 COL 1.13
      657        B-parts AT ROW 1 COL 21
      658        B-reshparts AT ROW 1 COL 31
      659        B-sch AT ROW 1 COL 92
      660        B-Help AT ROW 1 COL 95
      661        rs-action AT ROW 5 COL 2.63 NO-LABEL
      662        BR-gds AT ROW 6.08 COL 1.88
      663        for-prod-name AT ROW 2.5 COL 10.13 NO-LABEL
      664        for-gds-code AT ROW 2.5 COL 82.75 COLON-ALIGNED NO-LABEL
      665        for-sort AT ROW 3.79 COL 13.38 COLON-ALIGNED NO-LABEL
      666        "Пр-ль:" VIEW-AS TEXT
      667             SIZE 7.25 BY 1 AT ROW 2.5 COL 1.63
      668        "Сорт/Проба:" VIEW-AS TEXT
      669             SIZE 11.75 BY 1 AT ROW 3.79 COL 2.13
      670        SPACE(86.11) SKIP(18.20)
      671       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      672            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      673            TITLE "Товары с 2 ед изм"
      674            DEFAULT-BUTTON B-exit.
      675   ASSIGN
      676          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      677          FRAME Dialog-Frame:HIDDEN           = TRUE.
      678   ASSIGN
      679          BR-gds:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1.
      680   ON RETURN OF FRAME Dialog-Frame
      681   DO:
      682     APPLY "DEFAULT-ACTION" to br-gds.
      683   END.
      684   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      685   DO:
      686     APPLY "END-ERROR":U TO SELF.
      687   END.
      688   ON CHOOSE OF B-parts IN FRAME Dialog-Frame
      689   DO:
      690   define variable v-doc-rec as recid no-undo .
      691       if avail X_gds-obj then do:
      692       v-doc-rec = recid(X_gds-obj).
      693       run ref/twoparts.w (
      694       input parparentproc,
      695       input "split":U,
      696       input p-mode,
      697       input X_gds-obj.artic,
      698       input X_gds-obj.prod-type,
      699       input X_gds-obj.prod-code,
      700       input X_gds-obj.obj-type,
      701       input X_gds-obj.obj-code) no-error.
      702     run openbr in this-procedure ( input yes, input no, input '':U).
      703     reposition  BR-gds to recid v-doc-rec no-error.
      704     end.
      705   END.
      706   ON CHOOSE OF B-reshparts IN FRAME Dialog-Frame
      707   DO:
      708   define variable v-doc-rec as recid no-undo .
      709       if avail X_gds-obj then do:
      710       v-doc-rec = recid(X_gds-obj).
      711       run ref/twoparts.w (
      712       input parparentproc,
      713       input "fuse":U,
      714       input p-mode,
      715       input X_gds-obj.artic,
      716       input X_gds-obj.prod-type,
      717       input X_gds-obj.prod-code,
      718       input X_gds-obj.obj-type,
      719       input X_gds-obj.obj-code) no-error.
      720     run openbr in this-procedure ( input yes, input no, input '':U).
      721     reposition BR-gds to recid v-doc-rec no-error.
      722       .
      723     end.
      724   END.
      725   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
      726   DO:
      727     assign
      728     tbl = 'gds-obj'
      729     join-tbl = 'X_gds-obj'
      730     fld = '':U
      731     spr = '':U
      732     lab = '':U
      733     dim = '0':U
      734     .
      735     run fltfield-add in this-procedure('artic', 'Артикул', '',
      736     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      737     run fltfield-add in this-procedure('gds-code', 'Код товара', '',
      738     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      739     run fltfield-add in this-procedure('prod-type*prod-code', 'Производитель', 'cli',
      740     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      741     run fltfield-add in this-procedure('free-qnty', 'Своб.кол-во', '',
      742     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      743     run fltfield-add in this-procedure('fact-qnty', 'Факт.кол-во', '',
      744     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      745     DO on stop undo, leave:
      746         run gbl/filter.w ( input parparentproc
      747                            ,input (filter-point + chr(4) + filter-label)
      748                            ,input tbl
      749                            ,input join-tbl
      750                            ,input fld
      751                            ,input lab
      752                            ,input spr
      753                            ,input dim).
      754         RUN OpenBr in this-procedure ( input yes, input no, input '':U).
      755     END .
      756   END.
      757   ON DEFAULT-ACTION OF BR-gds IN FRAME Dialog-Frame
      758   DO:
      759       if avail X_gds-obj then
      760           apply "CHOOSE":U to b-parts.
      761   END.
      762   ON RETURN OF BR-gds IN FRAME Dialog-Frame
      763   DO:
      764     APPLY "DEFAULT-ACTION" to br-gds.
      765   END.
      766   ON VALUE-CHANGED OF BR-gds IN FRAME Dialog-Frame
      767   DO:
      768     if avail X_gds-obj then do:
      769         assign gds-rec = recid(X_goods).
      770         for-prod-name = prod-name(X_goods.prod-type, x_goods.prod-code).
      771         for-gds-code = X_goods.gds-code.
      772         for-sort = X_goods.sort.
      773     end.
      774     else
      775     assign
      776     gds-rec = ?
      777     for-prod-name = ""
      778     for-gds-code = ?
      779     for-sort = ''
      780     .
      781     display
      782     for-prod-name
      783     for-gds-code
      784     for-sort
      785     with frame Dialog-Frame.
      786   END.
      787   ON VALUE-CHANGED OF rs-action IN FRAME Dialog-Frame
      788   DO:
      789     assign rs-action.
      790     case rs-action:
      791       when "all":U then do:
      792           ENABLE
      793           b-parts
      794           b-reshparts
      795           with frame Dialog-Frame.
      796       end.
      797       when "split":U then do:
      798           ENABLE
      799           b-parts
      800           with frame Dialog-Frame.
      801           DISABLE
      802           b-reshparts
      803           with frame Dialog-Frame.
      804       end.
      805       when "fuse":U then do:
      806           ENABLE
      807           b-reshparts
      808           with frame Dialog-Frame.
      809           DISABLE
      810           b-parts
      811           with frame Dialog-Frame.
      812       end.
      813     end case.
      814     run OpenBr in this-procedure ( input yes, input no, input '':U).
      815   END.
      816   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      817   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      818   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      819   on help of frame Dialog-Frame
      820   do:
      821     run gbl/app_help.p
      822       (input this-procedure :file-name
      823       ,input ''
      824       ,input ?
      825       ) no-error.
      826     if error-status :error then do:
      827       message
      828         "Ошибка при вызове помощи"
      829         error-status :get-message(1)
      830         view-as alert-box .
      831     end.
      832   end.
      833   run minbtn-set in this-procedure .
      834   on choose of b-help in frame Dialog-Frame
      835   do:
      836     apply "help":u to frame Dialog-Frame .
      837   end.
      838   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      839   procedure minbtn-set :
      840       do
      841           on error undo, return error return-value
      842           :
      843           define variable ii              as integer       no-undo .
      844           define variable fh              as widget-handle no-undo .
      845           define variable hh              as widget-handle no-undo .
      846           define variable v-h             as handle        extent 4 no-undo .
      847           define variable v-name-button   as character     no-undo .
      848           define variable v-help-old-x    as decimal       no-undo .
      849           define variable v-help-old-y    as decimal       no-undo .
      850           define variable v-help-old-size as decimal       no-undo .
      851           define variable v-frame-width   as decimal       no-undo .
      852           define variable jj              as integer       no-undo .
      853           do
      854               on error undo, return error
      855               :
      856               assign
      857                   v-frame-width = frame Dialog-Frame:width - 0.3
      858                   fh            = frame Dialog-Frame:first-child
      859                   hh            = fh:first-child
      860                   ii            = 1
      861                   .
      862               do while valid-handle(hh):
      863                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      864                   do:
      865                       case lc(hh:name) :
      866                           when "b-help" then
      867                               do:
      868                                   hh:load-image-up("cmp/b-help.bmp":u) .
      869                                   hh:load-image-down("cmp/b-help.bmp":u) .
      870                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      871                                   hh:TOOLTIP = "Помощь" .
      872                                   v-help-old-x = hh:column .
      873                                   v-help-old-y = hh:row    .
      874                                   v-help-old-size = hh:width .
      875                                   hh:width-chars = 2.5 .
      876                               end.
      877                           when "b-print" then
      878                               do:
      879                                   hh:load-image("cmp/b-print.bmp":u) .
      880                                   hh:TOOLTIP = "Печать" .
      881                                   v-h[ii] = hh:handle .
      882                                   ii = ii + 1 .
      883                                   hh:width-chars = 3 .
      884                               end.
      885                           when "b-history" or
      886                           when "b-hist" then
      887                               do:
      888                                   hh:load-image("cmp/b-hist.bmp":u) .
      889                                   hh:TOOLTIP = "История" .
      890                                   v-h[ii] = hh:handle .
      891                                   ii = ii + 1 .
      892                                   hh:width-chars = 3 .
      893                               end.
      894                           when "b-sch" then
      895                               do:
      896                                   hh:load-image("cmp/b-sch.bmp":u) .
      897                                   hh:TOOLTIP = "Установка Фильтра" .
      898                                   v-h[ii] = hh:handle .
      899                                   ii = ii + 1 .
      900                                   hh:width-chars = 3 .
      901                               end.
      902                           when "b-hist-user" then
      903                               do:
      904                                   hh:load-image("cmp/b-hist.bmp":u) .
      905                                   hh:TOOLTIP = "История пользователя" .
      906                                   ii = ii + 1 .
      907                               end.
      908                       end case.
      909                   end.
      910                   hh = hh:next-sibling.
      911               end.
      912               b-help:column = v-frame-width - b-help:width-chars.
      913               jj = 0.
      914               repeat ii = 4 to 1 by -1 :
      915                   if valid-handle (v-h[ii] ) then
      916                   do:
      917                       jj  = jj + 1 .
      918                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      919                       v-h[ii]:row    = v-help-old-y .
      920                   end.
      921               end.
      922           end.
      923       end.
      924   end procedure.
      925   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      926   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      927   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      928   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      929   define variable v-diasize-current-frame-width  as decimal   no-undo .
      930   define variable v-diasize-current-frame-height as decimal   no-undo .
      931   define variable v-diasize-change-size          as logical   no-undo .
      932   define variable v-diasize-resize-button        as handle    no-undo .
      933   define variable v-diasize-wndmax               as logical   no-undo .
      934   define variable v-diasize-wndstore             as logical   no-undo .
      935   define variable v-diasize-proc-name            as character no-undo .
      936   define variable v-diasize-browse-handle        as handle    no-undo .
      937   define variable v-diasize-browse-number        as integer   no-undo .
      938   define variable v-diasize-need-full-display    as logical   no-undo init false .
      939   define temp-table temp-diasize-handle no-undo
      940     field handle-value  as handle
      941     field save-position as decimal
      942     index xpk is primary unique handle-value
      943     .
      944   define temp-table temp-browse-handle no-undo
      945     field browse-type   as character
      946     field browse-number as integer
      947     field browse-handle as handle
      948     field original-size as decimal
      949     index xpk is primary unique browse-type browse-number
      950     index xie browse-type browse-handle
      951   .
      952   procedure diasize_change-height :
      953     define input  parameter p-change-value  as decimal   no-undo .
      954     define input  parameter p-move-resize   as logical   no-undo .
      955     define variable v-field-group-handle    as handle    no-undo .
      956     define variable v-object-handle         as handle    no-undo .
      957     define variable v-frame-height          as decimal   no-undo .
      958     define variable v-frame-virtual-height  as decimal   no-undo .
      959     define variable v-browse-height         as decimal   no-undo .
      960     define variable v-window-height         as decimal   no-undo .
      961     define variable v-window-virtual-height as decimal   no-undo .
      962     define variable v-change-sign           as integer   no-undo .
      963     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      964     define buffer buf_temp-browse-handle  for temp-browse-handle .
      965     if p-change-value > 0
      966     then do:
      967       if frame Dialog-Frame :height + p-change-value
      968           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      969       then do:
      970         assign
      971           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      972                           - (frame Dialog-Frame :height-chars)
      973         .
      974         if p-change-value <= 0
      975         then do:
      976           run diasize_position-resize-button in this-procedure .
      977           return .
      978         end.
      979       end.
      980     end.
      981     if p-change-value < 0
      982     then do:
      983       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      984       then do:
      985         assign
      986           p-change-value = v-diasize-orig-frame-height
      987                          - (frame Dialog-Frame :height-chars)
      988         .
      989         if p-change-value >= 0
      990         then do:
      991           run diasize_position-resize-button in this-procedure .
      992           return .
      993         end.
      994       end.
      995     end.
      996     if p-change-value >= 0
      997     then do:
      998       assign
      999         v-change-sign = 1
     1000       .
     1001     end.
     1002     else do:
     1003       assign
     1004         v-change-sign = -1
     1005       .
     1006     end.
     1007     assign
     1008       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1009     .
     1010     if p-change-value = 0
     1011     then do:
     1012       run diasize_position-resize-button in this-procedure .
     1013       return .
     1014     end.
     1015     move_block:
     1016     do
     1017     on error undo move_block, retry move_block
     1018     :
     1019       if retry
     1020       then do:
     1021         do
     1022         on error undo move_block, leave move_block
     1023         :
     1024           if p-change-value > 0
     1025           then do:
     1026             for each buf_temp-diasize-handle
     1027             on error undo, next
     1028             :
     1029               assign
     1030                 v-object-handle = buf_temp-diasize-handle.handle-value
     1031               .
     1032               if v-object-handle <> v-diasize-resize-button
     1033               then do:
     1034                 assign
     1035                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1036                 .
     1037               end.
     1038             end.
     1039             assign
     1040               v-diasize-browse-handle :height = v-browse-height
     1041             .
     1042             for each buf_temp-browse-handle
     1043               where buf_temp-browse-handle.browse-type = 'height':u
     1044             on error undo, next
     1045             :
     1046               assign
     1047                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1048               .
     1049             end.
     1050             assign
     1051               frame Dialog-Frame :height = v-frame-height
     1052             .
     1053             if frame Dialog-Frame :scrollable = true
     1054             then do:
     1055               assign
     1056                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1057               .
     1058             end.
     1059             run diasize_position-resize-button in this-procedure .
     1060           end.
     1061           else do:
     1062             if frame Dialog-Frame :scrollable = true
     1063             then do:
     1064               assign
     1065                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1066               .
     1067             end.
     1068             assign
     1069               frame Dialog-Frame :height = v-frame-height
     1070             .
     1071             assign
     1072               v-diasize-browse-handle :height = v-browse-height
     1073             .
     1074             for each buf_temp-browse-handle
     1075               where buf_temp-browse-handle.browse-type = 'height':u
     1076             on error undo, next
