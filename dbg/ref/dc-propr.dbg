        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-mode   as character no-undo .
        4   define input parameter p-d-card like ub.dis-card.d-card no-undo .
        5   define input parameter p-emitent-host-code like ub.dis-card.emitent-host-code no-undo .
        6   define input parameter p-type like ub.dis-card.type no-undo .
        7   define input parameter p-host-code like ub.sysconf.host-code no-undo .
        8   define input parameter p-obj-type  like ub.clients.obj-type  no-undo .
        9   define input parameter p-obj-code  like ub.clients.obj-code  no-undo .
       10   define input parameter p-update-on-exit as logical no-undo .
       11   define output parameter p-modified as logical no-undo .
       12   define output parameter p-is-error as logical no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: dc-propr.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: ref/dc-propr.p $":U .
       18   define variable vss-description as character no-undo init "Запуск интерфейса редактирования атрибутов ДК".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   procedure lock-dcp :
       90   define input parameter p-d-card as character no-undo .
       91   define parameter buffer locked_dis-card-property for ub.dis-card-property.
       92     do
       93     on error undo, return error
       94     on stop undo, return error
       95     on end-key undo, return error
       96     :
       97         Find first locked_dis-card-property exclusive-lock  where
       98                 locked_dis-card-property.d-card = p-d-card
       99             AND locked_dis-card-property.host-code = 0
      100             AND locked_dis-card-property.obj-type = '':U
      101             AND locked_dis-card-property.obj-code = 0
      102             and locked_dis-card-property.dt-code = 0
      103             and locked_dis-card-property.node-code = 0
      104             no-error no-wait.
      105         if not available locked_dis-card-property
      106         and not locked locked_dis-card-property then do:
      107           create locked_dis-card-property.
      108           assign
      109           locked_dis-card-property.host-code = 0
      110           locked_dis-card-property.obj-type =  '':U
      111           locked_dis-card-property.obj-code = 0
      112           locked_dis-card-property.d-card = p-d-card
      113           locked_dis-card-property.dtm-code = 0
      114           locked_dis-card-property.dt-code = 0
      115           locked_dis-card-property.node-code = 0
      116           .
      117         end.
      118         if locked locked_dis-card-property then do:
      119         Find first locked_dis-card-property exclusive-lock  where
      120                 locked_dis-card-property.d-card = p-d-card
      121             AND locked_dis-card-property.host-code = 0
      122             AND locked_dis-card-property.obj-type = '':U
      123             AND locked_dis-card-property.obj-code = 0
      124             and locked_dis-card-property.dt-code = 0
      125             and locked_dis-card-property.node-code = 0
      126             no-error .
      127         end.
      128     end.
      129   end procedure.
      130   define variable v-update-attr as logical no-undo .
      131   define temp-table tt0-dis-card-property no-undo like ub.dis-card-property.
      132   define buffer buf_dis-card-property for ub.dis-card-property.
      133   define buffer locked_dis-card-property for ub.dis-card-property.
      134   do
      135   on stop undo, return error
      136   :
      137     for each tt0-dis-card-property:
      138       delete tt0-dis-card-property.
      139     end.
      140     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      141       do on error undo, return error return-value :
      142         run lock-dcp in this-procedure ( input p-d-card, buffer locked_dis-card-property).
      143       end.
      144       FOR EACH buf_dis-card-property no-lock  where
      145       buf_dis-card-property.d-card = p-d-card
      146       on error undo, return error :
      147         if buf_dis-card-property.dtm-code = 0 then next.
      148         CREATE tt0-dis-card-property.
      149         BUFFER-COPY buf_dis-card-property TO tt0-dis-card-property.
      150       END.
      151       run ref/discprpi.w (
      152                       input parparentproc
      153                     , input p-mode
      154                     , input p-d-card
      155                     , input p-emitent-host-code
      156                     , input p-type
      157                     , input p-host-code
      158                     , input p-obj-type
      159                     , input p-obj-code
      160                     , input p-update-on-exit
      161                     , output p-modified
      162                     , input-output table tt0-dis-card-property
      163                           ) no-error.
      164       if error-status:error then do:
      165         assign
      166         p-is-error = yes.
      167       end.
      168       for each tt0-dis-card-property:
      169         delete tt0-dis-card-property.
      170       end.
      171     end.
      172     else do:
      173       FOR EACH buf_dis-card-property no-lock where
      174            buf_dis-card-property.d-card = p-d-card
      175       :
      176         if buf_dis-card-property.dtm-code = 0 then next.
      177         CREATE tt0-dis-card-property.
      178         BUFFER-COPY buf_dis-card-property TO tt0-dis-card-property.
      179       END.
      180       run ref/discprpi.w (
      181                       input parparentproc
      182                     , input p-mode
      183                     , input p-d-card
      184                     , input p-emitent-host-code
      185                     , input p-type
      186                     , input p-host-code
      187                     , input p-obj-type
      188                     , input p-obj-code
      189                     , input p-update-on-exit
      190                     , output p-modified
      191                     , input-output table tt0-dis-card-property
      192                           ) no-error.
      193       if error-status:error then do:
      194         assign
      195         p-is-error = yes.
      196       end.
      197       for each tt0-dis-card-property:
      198         delete tt0-dis-card-property.
      199       end.
      200     end.
      201   end.
