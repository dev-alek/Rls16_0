        1   DEFINE BUFFER X_c-group-period-validity FOR ub.c-group-period-validity.
        2   DEFINE BUFFER X_curr_clients FOR ub.clients.
        3   DEFINE BUFFER X_group-period-validity FOR ub.group-period-validity.
        4   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        5   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo.
        6   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo.
        7   define input parameter bttns  as char   no-undo .
        8   define input parameter p-mode  as char   no-undo .
        9   define input parameter p-gr-per-val-code like ub.group-period-validity.gr-per-val-code no-undo .
       10   define input-output param p-rid-list    as  char no-undo .
       11   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       12   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       13   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       14   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       15   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       16   define variable vss-description AS CHAR NO-UNDO INIT "Список истории групп сроков годности":U.
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      124   define new shared variable RepPathName        as character no-undo .
      125   define new shared variable PrintRubl          as logical   no-undo .
      126   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   define variable v-waitfram-action01         as character   no-undo .
      128   define variable v-waitfram-action02         as character   no-undo .
      129   define variable v-waitfram-action03         as character   no-undo .
      130   define variable mWaitFramTextBeg            as character   no-undo.
      131   define variable mWaitFramTextEnd            as character   no-undo.
      132   define variable mWaitFramView               as logical     no-undo.
      133   define variable mWaitProcEvent              as logical     no-undo init yes.
      134   define variable mWaitFramInterval           as integer     no-undo init 1 .
      135   define variable mWaitFramStop               as logical     no-undo.
      136   define variable mWaitFramStopUser           as logical     no-undo.
      137   define variable mWaitFramStopTimeOut        as logical     no-undo.
      138   define variable mWaitFramStartProc          as datetime-tz no-undo.
      139   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      140   define button B-WaitFramStop auto-end-key
      141        label "Стоп"
      142        size 10 by 1 tooltip "Остоновить процесс".
      143   define button B-viewProcInfo
      144        label "Информация"
      145        size 15 by 1 tooltip "Информация о процесс".
      146   define frame waitfram
      147     v-waitfram-action01 format "x(72)" no-label skip
      148     v-waitfram-action02 format "x(72)" no-label skip
      149     v-waitfram-action03 format "x(72)" no-label skip
      150     B-viewProcInfo
      151     B-WaitFramStop at row 4 col 30
      152     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      153     .
      154   define new global shared variable mBatchMode as logical no-undo init ?.
      155   define variable mFramBachModHandle as handle no-undo.
      156   mFramBachModHandle = frame waitfram:handle.
      157   define variable mFameOldVis as logical no-undo.
      158   define variable mVisCUrentVin as logical no-undo.
      159   if session:batch-mode
      160   then
      161      mBatchMode = yes.
      162   if mBatchMode = ? then do:
      163     mVisCUrentVin = current-window:visible.
      164     mFameOldVis = mFramBachModHandle:visible.
      165     mFramBachModHandle:visible  = yes.
      166     mBatchMode = mFramBachModHandle:visible ne yes.
      167     mFramBachModHandle:visible = mFameOldVis.
      168     current-window:visible = mVisCUrentVin.
      169   end.
      170    if  log-manager:logfile-name ne ?
      171     then DO:
      172         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      173         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      174         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      175     end.
      176   on choose of B-WaitFramStop in frame waitfram
      177   do:
      178     mWaitFramStop = yes.
      179     mWaitFramStopUser = yes.
      180   end.
      181   function waitfram-check-timeout returns logical():
      182      define variable vtime as int64 no-undo.
      183      if mWaitFramStopTimeOut
      184      then
      185         return yes.
      186      vtime = ( now - mWaitFramStartProc ) / 1000 .
      187      if     mWaitFramTimeOut ne ?
      188         and mWaitFramTimeOut ne 0
      189         and mWaitFramTimeOut lt vtime
      190      then do:
      191         mWaitFramStopTimeOut = yes.
      192      end.
      193      return mWaitFramStopTimeOut.
      194   end.
      195   procedure waitfram-hide :
      196     if not session:batch-mode
      197     then do
      198     on error undo, return error return-value
      199     :
      200       pause 0 before-hide .
      201       if not mBatchMode then
      202         hide frame waitfram .
      203     if     not mWaitFramView
      204        and mWaitProcEvent
      205     then
      206       process events .
      207     end.
      208   end procedure.
      209   procedure waitfram-show :
      210     define input  parameter p-message as character no-undo .
      211     define variable v-left-margin as integer   no-undo .
      212     if not session:batch-mode
      213     then do
      214     on error undo, return error return-value
      215     :
      216       if length(p-message) <= 70 then do:
      217         assign
      218           v-left-margin = integer((70 - length(p-message)) / 2)
      219         .
      220         assign
      221           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      222         .
      223         assign
      224           v-waitfram-action01 = " "
      225           v-waitfram-action02 = " "
      226                                    + fill(" ", v-left-margin)
      227                                    + p-message
      228           v-waitfram-action03 = " "
      229         .
      230       end.
      231       else do:
      232         define variable vRindex1 as integer no-undo.
      233         define variable vRindex2 as integer no-undo.
      234         vRindex1 = r-index(p-message," ",70).
      235         if vRindex1 = 0
      236         then
      237            vRindex1 = 70.
      238         if length(p-message)  <= vRindex1 + 70 then do:
      239           assign
      240             v-waitfram-action01 = " "
      241             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      242             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      243           .
      244         end.
      245         else do:
      246           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      247           if vRindex2 <= vRindex1
      248           then
      249              vRindex2 = vRindex1 + 70.
      250           assign
      251             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      252             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      253             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      254           .
      255         end.
      256       end.
      257       B-viewProcInfo:visible   in frame waitfram = no.
      258       B-viewProcInfo:sensitive in frame waitfram = no.
      259       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      260       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      261       if  (   mWaitFramView
      262          or  mWaitProcEvent)
      263          and not mBatchMode
      264       then
      265          display
      266             v-waitfram-action01 skip
      267             v-waitfram-action02 skip
      268             v-waitfram-action03 skip
      269          with frame waitfram .
      270       if     mWaitFramView
      271          then do:
      272             if     mWaitFramInterval ne ?
      273                and not mBatchMode
      274             then
      275                wait-for go of frame waitfram pause mWaitFramInterval.
      276          end.
      277          else
      278             if     mWaitProcEvent
      279                and not mBatchMode
      280             then
      281                process events .
      282     end.
      283   end procedure.
      284      procedure waitfram-show-this:
      285         define input  parameter iInterval as int64 no-undo.
      286         define variable vtime as int64 no-undo.
      287         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      288         mWaitFramInterval = iInterval.
      289         run waitfram-show (substitute("&1&2 &3&4" ,
      290                                       mWaitFramTextBeg ,
      291                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      292                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      293                                       mWaitFramTextEnd
      294                                      )
      295                           ).
      296      end.
      297      procedure WaitFramRunPause:
      298         define input  parameter iInterval as dec no-undo.
      299         define variable vStart  as datetime-tz no-undo.
      300         define variable vend    as datetime-tz no-undo.
      301         define variable vint as int64 no-undo.
      302         define variable vOk as logical no-undo.
      303         vStart = now.
      304         vend   = vStart.
      305         publish "WaitFramPause" (iInterval,output vOk).
      306         vend   =  now.
      307         vint = vend - vStart.
      308         vint = iInterval - vint / 1000.
      309         if     not mWaitFramStop
      310            and (   vint > 0
      311                 or (    not vOk
      312                     and iInterval eq ?
      313                     )
      314                 )
      315         then
      316            run waitfram-show-this (iInterval).
      317         vend   =  now.
      318         vint = vend - vStart.
      319         vint = iInterval - vint / 1000.
      320         if     not mWaitFramStop
      321            and vint > 0
      322         then do:
      323            run gbl/pause.p (vint * 1000).
      324         end.
      325         if iInterval ne ?
      326         then
      327            publish "WaitFramStop".
      328         waitfram-check-timeout().
      329      end.
      330      procedure WaitFramWaitFor:
      331         define input  parameter iInterval as dec no-undo.
      332         assign
      333            mWaitFramStartProc   = now
      334            mWaitFramStopUser    = no
      335            mWaitFramStopTimeOut = no
      336         .
      337         block-wait:
      338         do while not mWaitFramStop:
      339            run WaitFramRunPause (iInterval).
      340            if  waitfram-check-timeout()
      341            then do:
      342               leave block-wait.
      343            end.
      344         end.
      345         run waitfram-hide.
      346      end.
      347   procedure waitfram-join :
      348     define input  parameter p-line-1  as character no-undo .
      349     define input  parameter p-line-2  as character no-undo .
      350     define input  parameter p-line-3  as character no-undo .
      351     define output parameter p-message as character no-undo .
      352     do
      353     on error undo, return error return-value
      354     :
      355       assign
      356         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      357                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      358                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      359       .
      360     end.
      361   end procedure.
      362   function waitfram-join-function returns character
      363     (input p-line-1 as character
      364     ,input p-line-2 as character
      365     ,input p-line-3 as character
      366     ).
      367     define variable v-message as character no-undo .
      368     run waitfram-join in this-procedure
      369       (input  p-line-1
      370       ,input  p-line-2
      371       ,input  p-line-3
      372       ,output v-message
      373       ) .
      374     return v-message .
      375   end function .
      376   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   define  stream PrnLibStream.
      378   procedure prn-lib-prn-file :
      379     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      380     define input parameter p-DIsabledoptions as integer no-undo .
      381     define variable v-report-name as character no-undo .
      382     define variable v-user-action as character no-undo .
      383     define variable v-printed     as logical   no-undo .
      384     define variable v-exist       as logical   no-undo .
      385     do
      386       on error undo, return error
      387       :
      388       run prn-lib-get-report-name  in this-procedure (
      389         input parParentProc
      390         ,output v-report-name
      391         ).
      392   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      393   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      394     (input  v-report-name
      395     ,input  2
      396     ,output v-exist
      397     )  .
      398       if NOT v-exist then
      399       DO:
      400         Message
      401           "Нет заданий на печать ! "
      402           view-as alert-box .
      403         Return  .
      404       End.
      405       run gbl/prnfilen.w
      406         (input  ""
      407         ,input  p-DisabledOptions
      408         ,input  string(v-report-name )
      409         ,input  7
      410         ,output v-user-action
      411         ,output v-printed
      412         ) .
      413       if v-printed then
      414       do:
      415         return "YES" .
      416       end.
      417       else
      418       do:
      419         return "NO" .
      420       end.
      421     end.
      422   end procedure.
      423   procedure prn-lib-open-stream :
      424     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      425     define input parameter p-page-size    as integer no-undo .
      426     define input parameter p-is-stream    as logical no-undo .
      427     define input parameter p-append       as logical no-undo .
      428     define variable v-report-name as character no-undo .
      429     do
      430       on error undo, return error
      431       :
      432       run prn-lib-get-report-name  in this-procedure (
      433         input parParentProc
      434         ,output v-report-name
      435         ).
      436       if p-is-stream then
      437       do:
      438         if p-append then
      439         do:
      440           output stream PrnLibStream to value( v-report-name )
      441             page-size value(p-page-size) append .
      442         end.
      443         if not p-append then
      444         do:
      445           output stream PrnLibStream to value( v-report-name )
      446             page-size value(p-page-size) .
      447         end.
      448       end.
      449       if not p-is-stream then
      450       do:
      451         if p-append then
      452         do:
      453           output to value( v-report-name )
      454             page-size value(p-page-size) append .
      455         end.
      456         if not p-append then
      457         do:
      458           output to value( v-report-name )
      459             page-size value(p-page-size) .
      460         end.
      461       end.
      462     end.
      463   end procedure.
      464   procedure prn-lib-open-exp :
      465     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      466     define input parameter p-is-stream    as logical no-undo .
      467     define input parameter p-is-append    as logical no-undo .
      468     define output parameter p-ReportFileName as char init "report" no-undo.
      469     define output parameter p-process as logical no-undo .
      470     define variable glog as logical no-undo .
      471     do
      472       on error undo, return error
      473       :
      474       SYSTEM-DIALOG GET-FILE p-ReportFileName
      475         TITLE      "Укажите путь"
      476         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      477         ASK-OVERWRITE
      478         CREATE-TEST-FILE
      479         SAVE-AS
      480         USE-FILENAME
      481         DEFAULT-EXTENSION "txt"
      482         UPDATE glog
      483         .
      484       if not glog then  return.
      485       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      486       if p-is-stream then
      487       do:
      488         if p-is-append then
      489         do:
      490           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      491         end.
      492         else
      493         do:
      494           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      495         end.
      496       end.
      497       else
      498       do:
      499         if p-is-append then
      500         do:
      501           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      502         end.
      503         else
      504         do:
      505           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      506         end.
      507       end.
      508       p-process = yes.
      509     end.
      510   end procedure.
      511   procedure prn-lib-get-report-name :
      512     define input parameter parParentProc  as widget-handle no-undo.
      513     define output parameter p-report-name as character no-undo .
      514     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      515   end procedure.
      516   procedure prn-lib-reportviewer-report-name :
      517     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      518     define input parameter p-report-name-html as character no-undo .
      519     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      520   end procedure.
      521   procedure prn-lib-reportviewer :
      522     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      523     define input parameter p-report-name-html as character no-undo .
      524     define input parameter p-param        as character no-undo .
      525     define variable v-excel           as character no-undo init 'TRUE' .
      526     define variable v-value-character as character no-undo .
      527     define variable v-value-integer   as character no-undo .
      528     define variable v-value-date      as date      no-undo .
      529     define variable v-value-decimal   as decimal   no-undo .
      530     define variable rep-excel         as logical   no-undo .
      531     define variable excel-string      as character no-undo .
      532     define variable v-param-type      as character no-undo .
      533     define variable v-tth             as handle    no-undo .
      534     run adm/shattri.p (
      535       input "get":U
      536       ,input  ""
      537       ,input  0
      538       ,input  'report-glob':U
      539       ,input  'rep-excel':U
      540       ,output v-value-character
      541       ,output v-value-date
      542       ,output v-value-decimal
      543       ,output v-value-integer
      544       ,output rep-excel
      545       ,output v-param-type
      546       ,INPUT-OUTPUT table-handle v-tth
      547       )  .
      548     if rep-excel then v-excel = "TRUE" .
      549     else v-excel = "FALSE" .
      550     if p-param eq ""
      551     then
      552        p-param = "EXCEL:" + v-excel.
      553     else
      554        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      555     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      556   end procedure.
      557   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      558   procedure cur-time :
      559      define output parameter p-today as date      no-undo .
      560      define output parameter p-time  as integer   no-undo .
      561     do
      562     on error undo, return error
      563     :
      564       define variable v-date1 as date      no-undo .
      565       define variable v-date2 as date      no-undo .
      566       define variable v-time  as integer   no-undo .
      567       assign
      568         v-date1 = today
      569         v-time  = time
      570         v-date2 = today
      571       .
      572       if v-date1 <> v-date2
      573       then do:
      574         assign
      575           v-date1 = today
      576           v-time  = v-time
      577         .
      578       end.
      579       assign
      580         p-today = v-date1
      581         p-time  = v-time
      582       .
      583     end.
      584   end.
      585   function cur-time-date returns character
      586   :
      587     return string(today, '99/99/9999':U) .
      588   end.
      589   function cur-time-mjd returns decimal
      590   :
      591     define variable v-date as date      no-undo .
      592     define variable v-time as integer   no-undo .
      593     run cur-time in this-procedure
      594       (output v-date
      595       ,output v-time
      596       ) .
      597     return integer(v-date) - 2400002 + (v-time / 86400) .
      598   end.
      599   function cur-time-get-ending-index returns integer
      600   (input p-number as integer
      601   )
      602   :
      603     if p-number < 0
      604     or p-number = ?
      605     then do:
      606       return 1 .
      607     end.
      608     define variable v-rest as integer   no-undo .
      609     assign
      610       p-number = p-number modulo 100
      611     .
      612     if p-number < 20
      613     then do:
      614       assign
      615         v-rest = p-number
      616       .
      617     end.
      618     else do:
      619       assign
      620         v-rest = p-number modulo 10
      621       .
      622     end.
      623     case v-rest :
      624       when 1
      625       then do:
      626         return 2 .
      627       end.
      628       when 2 or
      629       when 3 or
      630       when 4
      631       then do:
      632         return 3 .
      633       end.
      634       otherwise do:
      635         return 1 .
      636       end.
      637     end case .
      638   end.
      639   procedure cur-time-mjd-to-date :
      640      define input  parameter i-mjd-diff as decimal no-undo.
      641      define output parameter o-Date     as date    no-undo.
      642      define output parameter o-Time     as integer no-undo.
      643      define variable v-day-number as integer   no-undo .
      644      if    i-mjd-diff < 0
      645         or i-mjd-diff = ?
      646      then do:
      647         return "?" .
      648      end.
      649      assign
      650         v-day-number = truncate(i-mjd-diff,0).
      651         o-Date = date(v-day-number + 2400002).
      652         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      653     .
      654   end.
      655   function cur-time-mjd-to-string returns character
      656   (input p-mjd-diff as decimal
      657   )
      658   :
      659     define variable v-day-number as integer   no-undo .
      660     define variable v-seconds    as integer   no-undo .
      661     define variable v-hour       as integer   no-undo .
      662     define variable v-min        as integer   no-undo .
      663     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      664     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      665     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      666     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      667     if p-mjd-diff < 0
      668     or p-mjd-diff = ?
      669     then do:
      670       return "?" .
      671     end.
      672     assign
      673       v-day-number = integer(truncate(p-mjd-diff,0))
      674       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      675     .
      676     if v-seconds > 86400
      677     then do:
      678       assign
      679         v-seconds = 86400 - 1
      680       .
      681     end.
      682     if v-seconds < 0
      683     then do:
      684       assign
      685         v-seconds = 0
      686       .
      687     end.
      688     assign
      689       v-hour = truncate(v-seconds / 3600, 0)
      690     .
      691     assign
      692       v-seconds = v-seconds modulo 3600
      693     .
      694     assign
      695       v-min = truncate(v-seconds / 60, 0)
      696     .
      697     assign
      698       v-seconds = v-seconds modulo 60
      699     .
      700     return
      701         (if v-day-number <> 0
      702           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      703           else ""
      704         )
      705       + (if v-day-number <> 0 or v-hour <> 0
      706           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      707           else ""
      708         )
      709       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      710           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      711           else ""
      712         )
      713       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      714       .
      715   end.
      716   function cur-time-string returns character
      717   :
      718     define variable v-date as date      no-undo .
      719     define variable v-time as integer   no-undo .
      720     run cur-time in this-procedure
      721       (output v-date
      722       ,output v-time
      723       ) .
      724     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      725   end.
      726   function cur-time-string-sec returns character
      727   :
      728     define variable v-date as date      no-undo .
      729     define variable v-time as integer   no-undo .
      730     run cur-time in this-procedure
      731       (output v-date
      732       ,output v-time
      733       ) .
      734     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      735   end.
      736   function cur-time-custom  returns character
      737   (input p-prefix as character
      738   ,input p-date-format as character
      739   ,input p-delimiter as character
      740   ,input p-time-format as character
      741   ,input p-suffix as character
      742   )
      743   :
      744     define variable v-date as date      no-undo .
      745     define variable v-time as integer   no-undo .
      746     run cur-time in this-procedure
      747       (output v-date
      748       ,output v-time
      749       ) .
      750     return
      751       p-prefix
      752       + string(v-date, p-date-format)
      753       + p-delimiter
      754       + string(v-time, p-time-format)
      755       + p-suffix
      756       .
      757   end.
      758   function cur-time-print  returns character
      759   :
      760     define variable v-date as date      no-undo .
      761     define variable v-time as integer   no-undo .
      762     run cur-time in this-procedure
      763       (output v-date
      764       ,output v-time
      765       ) .
      766     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      767   end.
      768   function cur-time-datetime returns datetime
      769   :
      770     define variable v-char as character no-undo .
      771     define variable v-datetime as datetime no-undo .
      772     v-char = cur-time-string().
      773     v-datetime = datetime(v-char).
      774     return  v-datetime.
      775   end.
      776   function cur-time-string-msec returns character
      777   :
      778     define variable v-date as datetime  no-undo .
      779     v-date = now.
      780     return string(v-date) .
      781   end.
      782   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      783   FUNCTION mark-string RETURNS CHARACTER
      784     ( input p-recid as recid, input mark-list as character  ) :
      785     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      786   END FUNCTION.
      787   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      788   function usrfulnf returns character ( input p-user-id as character):
      789   define variable v-user-name as character no-undo .
      790   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      791   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      792     (input  p-user-id
      793     ,output v-user-name
      794     ) no-error .
      795   if error-status:error
      796   or v-user-name = ""
      797   then do:
      798     return p-user-id.
      799   end.
      800   else do:
      801     return v-user-name.
      802   end.
      803   end function.
      804   define variable v-rid-list as character no-undo .
      805   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      806   define variable sort-column-name as character no-undo .
      807   define variable v-db-num LIKE ub.db.db-num no-undo.
      808   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      809   define  temp-table temp-changes no-undo
      810   field f_name as character
      811   field l_name as character
      812   field v_old as character
      813   field v_new as character
      814   field t_name as character
      815   field num_ as integer
      816   field uniq-key-rec as character
      817   field action as integer
      818   field fNotChange as logical
      819   index pi is unique primary
      820   num_
      821   t_name
      822   f_name
      823   index
      824   Chan
      825   fnotChange
      826   t_name
      827   f_name
      828   index imain uniq-key-rec
      829   .
      830   FUNCTION get-all-fields returns character (p-file-name as character ):
      831   define variable v-dop as character no-undo .
      832     find first _file no-lock where _file._file-name = p-file-name no-error .
      833     if not available _file then return "":U.
      834     for each _field no-lock where
      835              _field._file-recid = recid(_file) :
      836       assign
      837       v-dop = v-dop + _field._field-name + chr(44)
      838       .
      839     end.
      840     return trim(v-dop).
      841   END FUNCTION.
      842   PROCEDURE proc-full-temp-changes :
      843     define input  parameter p-hst-handle as handle    no-undo .
      844     define input  parameter p-main-table as character no-undo .
      845     define input  parameter p-field-list as character no-undo .
      846     define input  parameter p-label-form as character no-undo .
      847     define variable h-new-buf         as handle    no-undo .
      848     define variable h-main-buf        as handle    no-undo .
      849     define variable h-for-comp        as handle    no-undo .
      850     define variable v-inform          as character no-undo .
      851     define variable v-ind             as integer   no-undo .
      852     define variable v-idx-field-qnty  as integer   no-undo .
      853     define variable v-num-entries     as integer   no-undo .
      854     define variable fh                as handle    no-undo .
      855     define variable fh-main           as handle    no-undo .
      856     define variable fh-old            as handle    no-undo .
      857     define variable fh-new            as handle    no-undo .
      858     define variable v-field-name      as character no-undo .
      859     define variable v-field-lvl       as character no-undo .
      860     define variable v-field-form      as character no-undo .
      861     define variable v-search-exp      as character no-undo .
      862     define variable v-srch-main       as character no-undo .
      863     define variable v-word-link       as character no-undo .
      864     define variable v-av-chip-num     as logical   no-undo .
      865     define variable v-main-pi-fld-lst as character no-undo .
      866     define variable v-main-fld-lst    as character no-undo .
      867     define variable v-delim-list      as character no-undo .
      868     define variable v-label           as character no-undo .
      869     define variable v-old-value       as character no-undo case-sensitive.
      870     define variable v-new-value       as character no-undo case-sensitive.
      871     define variable v-chg-fields as character no-undo.
      872     for each temp-changes:
      873       delete temp-changes.
      874     end.
      875     if not p-hst-handle:available then do:
      876       return .
      877     end.
      878     create buffer h-new-buf  for table p-hst-handle .
      879     create buffer h-main-buf for table p-main-table .
      880     assign
      881       v-inform = h-main-buf:index-information(1)
      882       v-ind    = 2
      883     .
      884     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      885     on error undo, return error
      886     :
      887       assign
      888         v-inform = h-main-buf:index-information( v-ind )
      889         v-ind    = v-ind + 1
      890       .
      891     end.
      892     if v-inform = ?
      893       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      894       or entry( 3, v-inform, ",":U ) <> "1":U
      895     then do:
      896       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      897     end.
      898     assign
      899       v-idx-field-qnty = num-entries( v-inform ) - 4
      900     .
      901     if v-idx-field-qnty < 2 then do:
      902       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      903     end.
      904     assign
      905       v-srch-main   = "where":U
      906       v-word-link   = "":U
      907       v-av-chip-num = false
      908       v-delim-list  = "":U
      909     .
      910     do v-ind = 1 to v-idx-field-qnty by 2
      911     on error undo, return error
      912     :
      913       assign
      914         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      915         fh                = p-hst-handle:buffer-field( v-field-name )
      916         fh-main           = h-main-buf:buffer-field( v-field-name )
      917         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      918         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      919       .
      920       if fh:data-type ="character":U then do:
      921         assign
      922           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      923         .
      924       end.
      925       else do:
      926         assign
      927           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      928         .
      929       end.
      930       if v-delim-list = "":U then do:
      931         assign
      932           v-delim-list = ",":U
      933         .
      934       end.
      935       if v-word-link = "":U then do:
      936         assign
      937           v-word-link = "and":U
      938         .
      939       end.
      940     end.
      941     assign
      942       v-delim-list  = "":U
      943     .
      944     do v-ind = 1 to h-main-buf:num-fields
      945     on error undo, return error
      946     :
      947       assign
      948         fh-main      = h-main-buf:buffer-field( v-ind )
      949         v-field-name = fh-main:name
      950       .
      951         assign
      952           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      953         .
      954         if v-delim-list = "":U then do:
      955           assign
      956             v-delim-list = ",":U
      957           .
      958         end.
      959     end.
      960     assign
      961       v-inform = p-hst-handle:index-information(1)
      962       v-ind    = 2
      963     .
      964     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      965     on error undo, return error
      966     :
      967       assign
      968         v-inform = p-hst-handle:index-information( v-ind )
      969         v-ind    = v-ind + 1
      970       .
      971     end.
      972     if v-inform = ?
      973       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      974       or entry( 3, v-inform, ",":U ) <> "1":U
      975     then do:
      976       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      977     end.
      978     assign
      979       v-idx-field-qnty = num-entries( v-inform ) - 4
      980     .
      981     if v-idx-field-qnty < 2 then do:
      982       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      983     end.
      984     assign
      985       v-search-exp  = "where":U
      986       v-word-link   = "":U
      987       v-av-chip-num = false
      988     .
      989     do v-ind = 1 to v-idx-field-qnty by 2
      990     on error undo, return error
      991     :
      992       assign
      993         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      994         fh           = p-hst-handle:buffer-field( v-field-name )
      995         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      996       .
      997       if v-field-name = "chip-num":U then do:
      998         assign
      999           v-search-exp  = substitute( "&1 >", v-search-exp )
     1000           v-av-chip-num = true
     1001         .
     1002       end.
     1003       else do:
     1004         assign
     1005           v-search-exp = substitute( "&1 =", v-search-exp )
     1006         .
     1007       end.
     1008       if fh:data-type ="character":U then do:
     1009         assign
     1010           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1011         .
     1012       end.
     1013       else do:
     1014         assign
     1015           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1016         .
     1017       end.
     1018       if v-word-link = "":U then do:
     1019         assign
     1020           v-word-link = "and":U
     1021         .
     1022       end.
     1023     end.
     1024     if v-av-chip-num = false then do:
     1025       message
     1026         vss-workfile vss-revision vss-description skip
     1027         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1028         "Использование данной процедуры невозможно!" skip
     1029         view-as alert-box error .
     1030       return error .
     1031     end.
     1032     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1033     if not h-new-buf:available then do:
     1034       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1035       if not h-main-buf:available then do:
     1036         assign
     1037           h-for-comp = ?
     1038         .
     1039       end.
     1040       else do:
     1041         assign
     1042           h-for-comp = h-main-buf
     1043         .
     1044       end.
     1045     end.
     1046     else do:
     1047       assign
     1048         h-for-comp = h-new-buf
     1049       .
     1050     end.
     1051     assign
     1052       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1053     .
     1054     do v-ind = 1 to v-num-entries
     1055     on error undo, return error return-value
     1056     :
     1057       assign
     1058         v-field-name = entry( v-ind, v-main-fld-lst )
     1059         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1060         v-old-value  = fh-old:buffer-value()
     1061         v-label      = trim( fh-old:label )
     1062       .
     1063       if ( trim( p-field-list ) <> "":U
     1064            and lookup( v-field-name, p-field-list ) > 0
     1065          )
     1066          or trim( p-field-list ) = "":U
     1067       then do:
     1068         if h-for-comp <> ? then do:
     1069           assign
     1070             fh-new      = h-for-comp:buffer-field( v-field-name )
     1071             v-new-value = fh-new:buffer-value()
     1072           .
     1073         end.
     1074         else do:
     1075           assign
     1076             v-new-value = "":U
     1077           .
     1078         end.
     1079         if v-old-value <> v-new-value
     1080         then do:
     1081           create temp-changes.
     1082           assign
     1083             temp-changes.t_name = p-main-table
     1084             temp-changes.f_name = v-field-name
     1085             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1086             temp-changes.v_old  = trim( v-old-value )
     1087             temp-changes.v_new  = trim( v-new-value )
     1088             temp-changes.num_   = 0
     1089             temp-changes.fNotChange = v-old-value eq v-new-value
     1090           .
     1091         end.
     1092       end.
     1093     end.
     1094     assign
     1095       v-num-entries = num-entries( p-label-form, chr(8) )
     1096     .
     1097     do v-ind = 1 to v-num-entries
     1098     on error undo, return error return-value
     1099     :
     1100       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1101         assign
     1102           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1103           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1104           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1105         .
     1106         find first temp-changes
     1107           where temp-changes.f_name = v-field-name
     1108           no-error .
     1109         if available temp-changes then do:
     1110           if trim( v-field-lvl ) <> "":U then do:
     1111             assign
     1112               temp-changes.l_name = v-field-lvl
     1113             .
     1114           end.
     1115           if trim( v-field-form ) <> "":U then do:
     1116             assign
     1117               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1118             .
     1119             if h-for-comp <> ? then do:
     1120               assign
     1121                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1122               .
     1123             end.
     1124           end.
     1125         end.
     1126       end.
     1127       else do:
     1128         message
     1129           vss-workfile vss-revision vss-description skip
     1130           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1131           substitute( "список для поля '&1': '&2'"
     1132                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1133                       ,entry( v-ind, p-label-form, chr(8) )
     1134                     ) skip
     1135           substitute( "полный список: &2", p-label-form ) skip
     1136           view-as alert-box error .
     1137       end.
     1138     end.
     1139     delete object h-new-buf .
     1140     delete object h-main-buf .
     1141   END PROCEDURE.
     1142   DEFINE BUTTON B-Help
     1143        LABEL "Помо&щь"
     1144        SIZE 3 BY 1
     1145        BGCOLOR 8 .
     1146   DEFINE BUTTON b-lkp
     1147        LABEL "&Просмотр"
     1148        SIZE 10 BY 1.
     1149   DEFINE BUTTON B-mark
     1150        LABEL "&*"
     1151        SIZE 3 BY 1.
     1152   DEFINE BUTTON b-quit AUTO-END-KEY
     1153        LABEL "&Выход"
     1154        SIZE 10 BY 1
     1155        BGCOLOR 8 .
     1156   DEFINE BUTTON B-sel AUTO-GO
     1157        LABEL "Вы&бор"
     1158        SIZE 10 BY 1.
     1159   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1160         VIEW-AS TEXT
     1161        SIZE 6 BY 1
     1162        FGCOLOR 4  NO-UNDO.
     1163   DEFINE QUERY BR-changes FOR
     1164         temp-changes SCROLLING.
     1165   DEFINE QUERY BR-gperval FOR
     1166         X_c-group-period-validity SCROLLING.
     1167   DEFINE BROWSE BR-changes
     1168     QUERY BR-changes DISPLAY
     1169         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1170   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1171   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1172       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.04.
     1173   DEFINE BROWSE BR-gperval
     1174     QUERY BR-gperval NO-LOCK DISPLAY
     1175         mark-string(recid(X_c-group-period-validity), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1176         usrfulnf(X_c-group-period-validity.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1177         X_c-group-period-validity.corr-date COLUMN-LABEL "Дата!измен" FORMAT "99/99/9999":U
     1178         string(X_c-group-period-validity.corr-time, "HH:MM") COLUMN-LABEL "Время!измен" FORMAT "X(5)":U
     1179         X_c-group-period-validity.gr-per-val-name FORMAT "X(50)":U
     1180         entry (lookup (string(X_c-group-period-validity.sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U)
     1181         X_c-group-period-validity.gr-per-from FORMAT "999":U
     1182         X_c-group-period-validity.gr-per-to FORMAT "999":U
     1183         X_c-group-period-validity.des FORMAT "X(255)":U
     1184         X_c-group-period-validity.gr-per-val-code COLUMN-LABEL "Вн.код группы" FORMAT ">>9":U
     1185       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.25.
     1186   DEFINE FRAME Dialog-Frame
     1187        b-quit AT ROW 1 COL 1
     1188        B-mark AT ROW 1 COL 11
     1189        B-sel AT ROW 1 COL 21
     1190        b-lkp AT ROW 1 COL 61
     1191        B-Help AT ROW 1 COL 95
     1192        BR-gperval AT ROW 3 COL 1
     1193        BR-changes AT ROW 13 COL 1
     1194        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1195        SPACE(78.62) SKIP(20.04)
     1196       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1197            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1198            TITLE "История групп сроков годности"
     1199            CANCEL-BUTTON b-quit.
     1200   ASSIGN
     1201          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1202          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1203   ASSIGN
     1204          b-lkp:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1205   ON GO OF FRAME Dialog-Frame
     1206   DO:
     1207     p-rid-list = v-rid-list.
     1208   END.
     1209   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1210   DO:
     1211     APPLY "END-ERROR":U TO SELF.
     1212   END.
     1213   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1214   DO:
     1215     define variable loc#log as logical no-undo .
     1216     if available X_c-group-period-validity then do:
     1217   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1218   define variable v-str-recid10 as character no-undo .
     1219   define variable v-num-entry10 as integer   no-undo .
     1220   assign
     1221     v-str-recid10 = trim( string( recid( X_c-group-period-validity ) , "->>>>>>>>>>>9":U ) )
     1222     v-num-entry10 = lookup( v-str-recid10 , v-rid-list )
     1223   .
     1224   if v-num-entry10 > 0 then do:
     1225     assign
     1226       entry( v-num-entry10, v-rid-list ) = "":U
     1227       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1228     .
     1229   end.
     1230   else do:
     1231     assign
     1232       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid10
     1233     .
     1234   end.
     1235       loc#log = BR-gperval:refresh() .
     1236       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1237           loc#log = BR-gperval:select-next-row ().
     1238           apply "VALUE-CHANGED" to BR-gperval in frame Dialog-Frame.
     1239       end.
     1240       if num-entries( v-rid-list ) = 0
     1241       then
     1242           hide mark-num in frame Dialog-Frame.
     1243       else
     1244           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1245     end.
     1246     apply "entry" to BR-gperval in frame Dialog-Frame.
     1247   END.
     1248   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1249   DO:
     1250       if ( available X_c-group-period-validity ) then do:
     1251       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1252       then
     1253       v-rid-list = string( recid( X_c-group-period-validity ) ) .
     1254     end.
     1255   END.
     1256   ON RETURN OF BR-gperval IN FRAME Dialog-Frame
     1257   or MOUSE-SELECT-DBLCLICK OF br-gperval IN FRAME Dialog-Frame
     1258       DO:
     1259       run proc-br-gperval no-error.
     1260     if error-status:error then return no-apply.
     1261   END.
     1262   ON VALUE-CHANGED OF BR-gperval IN FRAME Dialog-Frame
     1263   DO:
     1264     run proc-view-changes in this-procedure no-error.
     1265   END.
     1266   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1267   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1268   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1269   on help of frame Dialog-Frame
     1270   do:
     1271     run gbl/app_help.p
     1272       (input this-procedure :file-name
     1273       ,input ''
     1274       ,input ?
     1275       ) no-error.
     1276     if error-status :error then do:
     1277       message
     1278         "Ошибка при вызове помощи"
     1279         error-status :get-message(1)
     1280         view-as alert-box .
     1281     end.
     1282   end.
     1283   run minbtn-set in this-procedure .
     1284   on choose of b-help in frame Dialog-Frame
     1285   do:
     1286     apply "help":u to frame Dialog-Frame .
     1287   end.
     1288   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1289   procedure minbtn-set :
     1290       do
     1291           on error undo, return error return-value
     1292           :
     1293           define variable ii              as integer       no-undo .
     1294           define variable fh              as widget-handle no-undo .
     1295           define variable hh              as widget-handle no-undo .
     1296           define variable v-h             as handle        extent 4 no-undo .
     1297           define variable v-name-button   as character     no-undo .
     1298           define variable v-help-old-x    as decimal       no-undo .
     1299           define variable v-help-old-y    as decimal       no-undo .
     1300           define variable v-help-old-size as decimal       no-undo .
     1301           define variable v-frame-width   as decimal       no-undo .
     1302           define variable jj              as integer       no-undo .
     1303           do
     1304               on error undo, return error
     1305               :
     1306               assign
     1307                   v-frame-width = frame Dialog-Frame:width - 0.3
     1308                   fh            = frame Dialog-Frame:first-child
     1309                   hh            = fh:first-child
     1310                   ii            = 1
     1311                   .
     1312               do while valid-handle(hh):
     1313                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1314                   do:
     1315                       case lc(hh:name) :
     1316                           when "b-help" then
     1317                               do:
     1318                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1319                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1320                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1321                                   hh:TOOLTIP = "Помощь" .
     1322                                   v-help-old-x = hh:column .
     1323                                   v-help-old-y = hh:row    .
     1324                                   v-help-old-size = hh:width .
     1325                                   hh:width-chars = 2.5 .
     1326                               end.
     1327                           when "b-print" then
     1328                               do:
     1329                                   hh:load-image("cmp/b-print.bmp":u) .
     1330                                   hh:TOOLTIP = "Печать" .
     1331                                   v-h[ii] = hh:handle .
     1332                                   ii = ii + 1 .
     1333                                   hh:width-chars = 3 .
     1334                               end.
     1335                           when "b-history" or
     1336                           when "b-hist" then
     1337                               do:
     1338                                   hh:load-image("cmp/b-hist.bmp":u) .
     1339                                   hh:TOOLTIP = "История" .
     1340                                   v-h[ii] = hh:handle .
     1341                                   ii = ii + 1 .
     1342                                   hh:width-chars = 3 .
     1343                               end.
     1344                           when "b-sch" then
     1345                               do:
     1346                                   hh:load-image("cmp/b-sch.bmp":u) .
     1347                                   hh:TOOLTIP = "Установка Фильтра" .
     1348                                   v-h[ii] = hh:handle .
     1349                                   ii = ii + 1 .
     1350                                   hh:width-chars = 3 .
     1351                               end.
     1352                           when "b-hist-user" then
     1353                               do:
     1354                                   hh:load-image("cmp/b-hist.bmp":u) .
     1355                                   hh:TOOLTIP = "История пользователя" .
     1356                                   ii = ii + 1 .
     1357                               end.
     1358                       end case.
     1359                   end.
     1360                   hh = hh:next-sibling.
     1361               end.
     1362               b-help:column = v-frame-width - b-help:width-chars.
     1363               jj = 0.
     1364               repeat ii = 4 to 1 by -1 :
     1365                   if valid-handle (v-h[ii] ) then
     1366                   do:
     1367                       jj  = jj + 1 .
     1368                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1369                       v-h[ii]:row    = v-help-old-y .
     1370                   end.
     1371               end.
     1372           end.
     1373       end.
     1374   end procedure.
     1375   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1376   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1377   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1378   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1379   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1380   define variable v-diasize-current-frame-height as decimal   no-undo .
     1381   define variable v-diasize-change-size          as logical   no-undo .
     1382   define variable v-diasize-resize-button        as handle    no-undo .
     1383   define variable v-diasize-wndmax               as logical   no-undo .
     1384   define variable v-diasize-wndstore             as logical   no-undo .
     1385   define variable v-diasize-proc-name            as character no-undo .
     1386   define variable v-diasize-browse-handle        as handle    no-undo .
     1387   define variable v-diasize-browse-number        as integer   no-undo .
     1388   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1389   define temp-table temp-diasize-handle no-undo
     1390     field handle-value  as handle
     1391     field save-position as decimal
     1392     index xpk is primary unique handle-value
     1393     .
     1394   define temp-table temp-browse-handle no-undo
     1395     field browse-type   as character
     1396     field browse-number as integer
     1397     field browse-handle as handle
     1398     field original-size as decimal
     1399     index xpk is primary unique browse-type browse-number
     1400     index xie browse-type browse-handle
     1401   .
     1402   procedure diasize_change-height :
     1403     define input  parameter p-change-value  as decimal   no-undo .
     1404     define input  parameter p-move-resize   as logical   no-undo .
     1405     define variable v-field-group-handle    as handle    no-undo .
     1406     define variable v-object-handle         as handle    no-undo .
     1407     define variable v-frame-height          as decimal   no-undo .
     1408     define variable v-frame-virtual-height  as decimal   no-undo .
     1409     define variable v-browse-height         as decimal   no-undo .
     1410     define variable v-window-height         as decimal   no-undo .
     1411     define variable v-window-virtual-height as decimal   no-undo .
     1412     define variable v-change-sign           as integer   no-undo .
     1413     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1414     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1415     if p-change-value > 0
     1416     then do:
     1417       if frame Dialog-Frame :height + p-change-value
     1418           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1419       then do:
     1420         assign
     1421           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1422                           - (frame Dialog-Frame :height-chars)
     1423         .
     1424         if p-change-value <= 0
     1425         then do:
     1426           run diasize_position-resize-button in this-procedure .
     1427           return .
     1428         end.
     1429       end.
     1430     end.
     1431     if p-change-value < 0
     1432     then do:
     1433       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1434       then do:
     1435         assign
     1436           p-change-value = v-diasize-orig-frame-height
     1437                          - (frame Dialog-Frame :height-chars)
     1438         .
     1439         if p-change-value >= 0
     1440         then do:
     1441           run diasize_position-resize-button in this-procedure .
     1442           return .
     1443         end.
     1444       end.
     1445     end.
     1446     if p-change-value >= 0
     1447     then do:
     1448       assign
     1449         v-change-sign = 1
     1450       .
     1451     end.
     1452     else do:
     1453       assign
     1454         v-change-sign = -1
     1455       .
     1456     end.
     1457     assign
     1458       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1459     .
     1460     if p-change-value = 0
     1461     then do:
     1462       run diasize_position-resize-button in this-procedure .
     1463       return .
     1464     end.
     1465     move_block:
     1466     do
     1467     on error undo move_block, retry move_block
     1468     :
     1469       if retry
     1470       then do:
     1471         do
     1472         on error undo move_block, leave move_block
     1473         :
     1474           if p-change-value > 0
     1475           then do:
     1476             for each buf_temp-diasize-handle
     1477             on error undo, next
     1478             :
     1479               assign
     1480                 v-object-handle = buf_temp-diasize-handle.handle-value
     1481               .
     1482               if v-object-handle <> v-diasize-resize-button
     1483               then do:
     1484                 assign
     1485                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1486                 .
     1487               end.
     1488             end.
     1489             assign
     1490               v-diasize-browse-handle :height = v-browse-height
     1491             .
     1492             for each buf_temp-browse-handle
     1493               where buf_temp-browse-handle.browse-type = 'height':u
     1494             on error undo, next
     1495             :
     1496               assign
     1497                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1498               .
     1499             end.
     1500             assign
     1501               frame Dialog-Frame :height = v-frame-height
     1502             .
     1503             if frame Dialog-Frame :scrollable = true
     1504             then do:
     1505               assign
     1506                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1507               .
     1508             end.
     1509             run diasize_position-resize-button in this-procedure .
     1510           end.
     1511           else do:
     1512             if frame Dialog-Frame :scrollable = true
     1513             then do:
     1514               assign
     1515                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1516               .
     1517             end.
     1518             assign
     1519               frame Dialog-Frame :height = v-frame-height
     1520             .
     1521             assign
     1522               v-diasize-browse-handle :height = v-browse-height
     1523             .
     1524             for each buf_temp-browse-handle
     1525               where buf_temp-browse-handle.browse-type = 'height':u
     1526             on error undo, next
     1527             :
     1528               assign
     1529                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1530               .
     1531             end.
     1532             for each buf_temp-diasize-handle
     1533             on error undo, next
     1534             :
     1535               assign
     1536                 v-object-handle = buf_temp-diasize-handle.handle-value
     1537               .
     1538               if v-object-handle <> v-diasize-resize-button
     1539               then do:
     1540                 assign
     1541                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1542                 .
     1543               end.
     1544             end.
     1545             run diasize_position-resize-button in this-procedure .
     1546           end.
     1547           assign
     1548             v-diasize-change-size = false
     1549           .
     1550           leave move_block .
     1551         end.
     1552       end.
     1553       assign
     1554         v-diasize-need-full-display = true
     1555       .
     1556       if v-diasize-change-size = false
     1557       then do:
     1558         assign
     1559           v-diasize-change-size = true
     1560         .
     1561       end.
     1562       else do:
     1563         return .
     1564       end.
     1565       assign
     1566         v-frame-height = frame Dialog-Frame :height
     1567         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1568         v-browse-height = v-diasize-browse-handle :height
     1569       .
     1570       for each buf_temp-browse-handle
     1571         where buf_temp-browse-handle.browse-type = 'height':u
     1572       :
     1573         assign
     1574           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1575         .
     1576       end.
     1577       for each buf_temp-diasize-handle
     1578       :
     1579         delete buf_temp-diasize-handle .
     1580       end.
     1581       assign
     1582         v-field-group-handle = frame Dialog-Frame :first-child
     1583       .
     1584       do while valid-handle(v-field-group-handle)
     1585       :
     1586         assign
     1587           v-object-handle = v-field-group-handle :first-child
     1588         .
     1589         do while valid-handle(v-object-handle)
     1590         :
     1591           if  v-object-handle <> v-diasize-browse-handle :handle
     1592           and can-query(v-object-handle, "row")
     1593           and can-query(v-object-handle, "height")
     1594           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1595           then do:
     1596             find first buf_temp-browse-handle
     1597               where buf_temp-browse-handle.browse-type   = 'height':u
     1598                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1599               no-error .
     1600             if available buf_temp-browse-handle
     1601             then do:
     1602             end.
     1603             else do:
     1604               create buf_temp-diasize-handle .
     1605               assign
     1606                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1607                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1608               .
     1609             end.
     1610           end.
     1611           assign
     1612             v-object-handle = v-object-handle :next-sibling
     1613           .
     1614         end.
     1615         assign
     1616           v-field-group-handle = v-field-group-handle :next-sibling
     1617         .
     1618       end.
     1619       do with frame Dialog-Frame
     1620       :
     1621         hide v-diasize-resize-button .
     1622         assign
     1623           v-diasize-resize-button :row    = 1
     1624           v-diasize-resize-button :column = 1
     1625         .
     1626       end.
     1627       if p-change-value > 0
     1628       then do:
     1629         if frame Dialog-Frame :scrollable = true
     1630         then do:
     1631           assign
     1632             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1633             no-error .
     1634           if error-status :error
     1635           or error-status :get-message(1) <> ""
     1636           then do:
     1637             undo move_block, retry move_block .
     1638           end.
     1639         end.
     1640         assign
     1641           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1642           no-error .
     1643         if error-status :error
     1644         or error-status :get-message(1) <> ""
     1645         then do:
     1646           undo move_block, retry move_block .
     1647         end.
     1648         assign
     1649           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1650           no-error .
     1651         if error-status :error
     1652         or error-status :get-message(1) <> ""
     1653         then do:
     1654           undo move_block, retry move_block .
     1655         end.
     1656         for each buf_temp-browse-handle
     1657           where buf_temp-browse-handle.browse-type = 'height':u
     1658         on error undo move_block, retry move_block
     1659         :
     1660           assign
     1661             buf_temp-browse-handle.browse-handle :height
     1662               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1663             no-error .
     1664           if error-status :error
     1665           or error-status :get-message(1) <> ""
     1666           then do:
     1667             undo move_block, retry move_block .
     1668           end.
     1669         end.
     1670         for each buf_temp-diasize-handle
     1671         on error undo move_block, retry move_block
     1672         :
     1673           assign
     1674             v-object-handle = buf_temp-diasize-handle.handle-value
     1675           .
     1676           if v-object-handle <> v-diasize-resize-button
     1677           then do:
     1678             assign
     1679               v-object-handle :row = v-object-handle :row + p-change-value
     1680               no-error .
     1681             if error-status :error
     1682             or error-status :get-message(1) <> ""
     1683             then do:
     1684               undo move_block, retry move_block .
     1685             end.
     1686           end.
     1687         end.
     1688       end.
     1689       else do:
     1690         for each buf_temp-diasize-handle
     1691         on error undo move_block, retry move_block
     1692         :
     1693           assign
     1694             v-object-handle = buf_temp-diasize-handle.handle-value
     1695           .
     1696           if v-object-handle <> v-diasize-resize-button
     1697           then do:
     1698             assign
     1699               v-object-handle :row = v-object-handle :row + p-change-value
     1700               no-error .
     1701             if error-status :error
     1702             or error-status :get-message(1) <> ""
     1703             then do:
     1704               undo move_block, retry move_block .
     1705             end.
     1706           end.
     1707         end.
     1708         assign
     1709           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1710           no-error .
     1711         if error-status :error
     1712         or error-status :get-message(1) <> ""
     1713         then do:
     1714           undo move_block, retry move_block .
     1715         end.
     1716         for each buf_temp-browse-handle
     1717           where buf_temp-browse-handle.browse-type = 'height':u
     1718         on error undo move_block, retry move_block
     1719         :
     1720           assign
     1721             buf_temp-browse-handle.browse-handle :height
     1722               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1723             no-error .
     1724           if error-status :error
     1725           or error-status :get-message(1) <> ""
     1726           then do:
     1727             undo move_block, retry move_block .
     1728           end.
     1729         end.
     1730         assign
     1731           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1732           no-error .
     1733         if error-status :error
     1734         or error-status :get-message(1) <> ""
     1735         then do:
     1736           undo move_block, retry move_block .
     1737         end.
     1738         if frame Dialog-Frame :scrollable = true
     1739         then do:
     1740           assign
     1741             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1742             no-error .
     1743           if error-status :error
     1744           or error-status :get-message(1) <> ""
     1745           then do:
     1746             undo move_block, retry move_block .
     1747           end.
     1748         end.
     1749       end.
     1750       if p-move-resize = true
     1751       then do:
     1752         run diasize_position-resize-button in this-procedure .
     1753       end.
     1754       if v-diasize-wndstore = true
     1755       then do:
     1756         if connected("ub") = true
     1757         then do:
     1758           define variable v-cntxt-db-num        as integer   no-undo .
     1759           define variable v-cntxt-userid        as character no-undo .
     1760           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1761                                             , OUTPUT v-cntxt-userid
     1762                                             ) .
     1763           run gbl/wndsizew.p
     1764             (input  v-cntxt-db-num
     1765             ,input  v-cntxt-userid
     1766             ,input  v-diasize-proc-name
     1767             ,input  'height':u
     1768             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1769             ) .
     1770         end.
     1771       end.
     1772     end.
     1773     assign
     1774       v-diasize-change-size = false
     1775     .
     1776   end procedure.
     1777   procedure diasize_set-height :
     1778     define input  parameter p-new-height  as decimal   no-undo .
     1779     define input  parameter p-move-resize as logical   no-undo .
     1780     do
     1781     on error undo, return error return-value
     1782     :
     1783       run diasize_change-height in this-procedure
     1784         (input  (p-new-height - frame Dialog-Frame :height)
     1785         ,input  p-move-resize
     1786         ) .
     1787     end.
     1788   end procedure.
     1789   procedure diasize_change-width :
     1790     define input  parameter p-change-value as decimal   no-undo .
     1791     define input  parameter p-move-resize  as logical   no-undo .
     1792     define variable v-field-group-handle   as handle    no-undo .
     1793     define variable v-object-handle        as handle    no-undo .
     1794     define variable v-frame-width          as decimal   no-undo .
     1795     define variable v-frame-virtual-width  as decimal   no-undo .
     1796     define variable v-browse-width         as decimal   no-undo .
     1797     define variable v-window-width         as decimal   no-undo .
     1798     define variable v-window-virtual-width as decimal   no-undo .
     1799     define variable v-change-sign          as integer   no-undo .
     1800     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1801     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1802     if p-change-value > 0
     1803     then do:
     1804       if frame Dialog-Frame :width + p-change-value >
     1805           session :width-chars
     1806       then do:
     1807         assign
     1808           p-change-value = session :width-chars - frame Dialog-Frame :width
     1809         .
     1810         if p-change-value <= 0
     1811         then do:
     1812           run diasize_position-resize-button in this-procedure .
     1813           return .
     1814         end.
     1815       end.
     1816     end.
     1817     if p-change-value < 0
     1818     then do:
     1819       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1820       then do:
     1821         assign
     1822           p-change-value = v-diasize-orig-frame-width
     1823                          - frame Dialog-Frame :width
     1824         .
     1825         if p-change-value >= 0
     1826         then do:
     1827           run diasize_position-resize-button in this-procedure .
     1828           return .
     1829         end.
     1830       end.
     1831     end.
     1832     if p-change-value >= 0
     1833     then do:
     1834       assign
     1835         v-change-sign = 1
     1836       .
     1837     end.
     1838     else do:
     1839       assign
     1840         v-change-sign = -1
     1841       .
     1842     end.
     1843     assign
     1844       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1845     .
     1846     if p-change-value = 0
     1847     then do:
     1848       run diasize_position-resize-button in this-procedure .
     1849       return .
     1850     end.
     1851     move_block:
     1852     do
     1853     on error undo move_block, leave move_block
     1854     :
     1855       if retry
     1856       then do:
     1857         do
     1858         on error undo move_block, leave move_block
     1859         :
     1860           if p-change-value > 0
     1861           then do:
     1862             for each buf_temp-diasize-handle
     1863             on error undo, next
     1864             :
     1865               assign
     1866                 v-object-handle = buf_temp-diasize-handle.handle-value
     1867               .
     1868               if v-object-handle <> v-diasize-resize-button
     1869               then do:
     1870                 assign
     1871                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1872                 .
     1873               end.
     1874             end.
     1875             assign
     1876               v-diasize-browse-handle :width = v-browse-width
     1877             .
     1878             for each buf_temp-browse-handle
     1879               where buf_temp-browse-handle.browse-type = 'width':u
     1880             on error undo, next
     1881             :
     1882               assign
     1883                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1884               .
     1885             end.
     1886             assign
     1887               frame Dialog-Frame :width = v-frame-width
     1888             .
     1889             if frame Dialog-Frame :scrollable = true
     1890             then do:
     1891               assign
     1892                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1893               .
     1894             end.
     1895             run diasize_position-resize-button in this-procedure .
     1896           end.
     1897           else do:
     1898             if frame Dialog-Frame :scrollable = true
     1899             then do:
     1900               assign
     1901                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1902               .
     1903             end.
     1904             assign
     1905               frame Dialog-Frame :width = v-frame-width
     1906             .
     1907             for each buf_temp-browse-handle
     1908               where buf_temp-browse-handle.browse-type = 'width':u
     1909             on error undo, next
     1910             :
     1911               assign
     1912                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1913               .
     1914             end.
     1915             assign
     1916               v-diasize-browse-handle :width = v-browse-width
     1917             .
     1918             for each buf_temp-diasize-handle
     1919             on error undo, next
     1920             :
     1921               assign
     1922                 v-object-handle = buf_temp-diasize-handle.handle-value
     1923               .
     1924               if v-object-handle <> v-diasize-resize-button
     1925               then do:
     1926                 assign
     1927                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1928                 .
     1929               end.
     1930             end.
     1931             run diasize_position-resize-button in this-procedure .
     1932           end.
     1933           assign
     1934             v-diasize-change-size = false
     1935           .
     1936           leave move_block .
     1937         end.
     1938       end.
     1939       assign
     1940         v-diasize-need-full-display = true
     1941       .
     1942       if v-diasize-change-size = false
     1943       then do:
     1944         assign
     1945           v-diasize-change-size = true
     1946         .
     1947       end.
     1948       else do:
     1949         return .
     1950       end.
     1951       assign
     1952         v-frame-width = frame Dialog-Frame :width
     1953         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1954         v-browse-width = v-diasize-browse-handle :width
     1955       .
     1956       for each buf_temp-browse-handle
     1957         where buf_temp-browse-handle.browse-type = 'width':u
     1958       :
     1959         assign
     1960           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1961         .
     1962       end.
     1963       for each buf_temp-diasize-handle
     1964       :
     1965         delete buf_temp-diasize-handle .
     1966       end.
     1967       assign
     1968         v-field-group-handle = frame Dialog-Frame :first-child
     1969       .
     1970       do while valid-handle(v-field-group-handle)
     1971       :
     1972         assign
     1973           v-object-handle = v-field-group-handle :first-child
     1974         .
     1975         do while valid-handle(v-object-handle)
     1976         :
     1977           if  v-object-handle <> v-diasize-browse-handle :handle
     1978           and v-object-handle <> v-diasize-resize-button
     1979           and can-query(v-object-handle, "row")
     1980           and can-query(v-object-handle, "height")
     1981           and ( v-object-handle :col + v-object-handle :width
     1982                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1983               )
     1984           then do:
     1985             find first buf_temp-browse-handle
     1986               where buf_temp-browse-handle.browse-type   = 'width':u
     1987                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1988               no-error .
     1989             if available buf_temp-browse-handle
     1990             then do:
     1991             end.
     1992             else do:
     1993               create buf_temp-diasize-handle .
     1994               assign
     1995                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1996                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1997               .
     1998             end.
     1999           end.
     2000           assign
     2001             v-object-handle = v-object-handle :next-sibling
     2002           .
     2003         end.
     2004         assign
     2005           v-field-group-handle = v-field-group-handle :next-sibling
     2006         .
     2007       end.
     2008       do with frame Dialog-Frame
     2009       :
     2010         hide v-diasize-resize-button .
     2011         v-diasize-resize-button :row = 1.
     2012         v-diasize-resize-button :column = 1.
     2013       end.
     2014       if p-change-value > 0
     2015       then do:
     2016         if frame Dialog-Frame :scrollable = true
     2017         then do:
     2018           assign
     2019             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2020             no-error .
     2021           if error-status :error
     2022           or error-status :get-message(1) <> ""
     2023           then do:
     2024             undo move_block, retry move_block.
     2025           end.
     2026         end.
     2027         assign
     2028           frame Dialog-Frame :width = v-frame-width + p-change-value
     2029           no-error .
     2030         if error-status :error
     2031         or error-status :get-message(1) <> ""
     2032         then do:
     2033           undo move_block, retry move_block.
     2034         end.
     2035         assign
     2036           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2037         no-error .
     2038         if error-status :error
     2039         or error-status :get-message(1) <> ""
     2040         then do:
     2041           undo move_block, retry move_block.
     2042         end.
     2043         for each buf_temp-browse-handle
     2044           where buf_temp-browse-handle.browse-type = 'width':u
     2045         on error undo move_block, retry move_block
     2046         :
     2047           assign
     2048             buf_temp-browse-handle.browse-handle :width
     2049               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2050             no-error .
     2051           if error-status :error
     2052           or error-status :get-message(1) <> ""
     2053           then do:
     2054             undo move_block, retry move_block .
     2055           end.
     2056         end.
     2057         for each buf_temp-diasize-handle
     2058         on error undo move_block, retry move_block
     2059         :
     2060           assign
     2061             v-object-handle = buf_temp-diasize-handle.handle-value
     2062           .
     2063           if v-object-handle <> v-diasize-resize-button
     2064           then do:
     2065             assign
     2066               v-object-handle :col = v-object-handle :col + p-change-value
     2067               no-error .
     2068             if error-status :error
     2069             or error-status :get-message(1) <> ""
     2070             then do:
     2071               undo move_block, retry move_block .
     2072             end.
     2073           end.
     2074         end.
     2075       end.
     2076       else do:
     2077         for each buf_temp-diasize-handle
     2078         on error undo move_block, retry move_block
     2079         :
     2080           assign
     2081             v-object-handle = buf_temp-diasize-handle.handle-value
     2082           .
     2083           if v-object-handle <> v-diasize-resize-button
     2084           then do:
     2085             assign
     2086               v-object-handle :col = v-object-handle :col + p-change-value
     2087               no-error .
     2088             if error-status :error
     2089             or error-status :get-message(1) <> ""
     2090             then do:
     2091               undo move_block, retry move_block .
     2092             end.
     2093           end.
     2094         end.
     2095         for each buf_temp-browse-handle
     2096           where buf_temp-browse-handle.browse-type = 'width':u
     2097         on error undo move_block, retry move_block
     2098         :
     2099           assign
     2100             buf_temp-browse-handle.browse-handle :width
     2101               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2102             no-error .
     2103           if error-status :error
     2104           or error-status :get-message(1) <> ""
     2105           then do:
     2106             undo move_block, retry move_block .
     2107           end.
     2108         end.
     2109         assign
     2110           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2111           no-error .
     2112         if error-status :error
     2113         or error-status :get-message(1) <> ""
     2114         then do:
     2115           undo move_block, retry move_block.
     2116         end.
     2117         assign
     2118           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2119         no-error .
     2120         if error-status :error
     2121         or error-status :get-message(1) <> ""
     2122         then do:
     2123           undo move_block, retry move_block.
     2124         end.
     2125         if frame Dialog-Frame :scrollable = true
     2126         then do:
     2127           assign
     2128             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2129           no-error .
     2130           if error-status :error
     2131           or error-status :get-message(1) <> ""
     2132           then do:
     2133             undo move_block, retry move_block.
     2134           end.
     2135         end.
     2136       end.
     2137       if p-move-resize
     2138       then do:
     2139         run diasize_position-resize-button in this-procedure .
     2140       end.
     2141       if v-diasize-wndstore = true
     2142       then do:
     2143         if connected("ub") = true
     2144         then do:
     2145           define variable v-cntxt-db-num        as integer   no-undo .
     2146           define variable v-cntxt-userid        as character no-undo .
     2147           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2148                                             , OUTPUT v-cntxt-userid
     2149                                             ) .
     2150           run gbl/wndsizew.p
     2151             (input  v-cntxt-db-num
     2152             ,input  v-cntxt-userid
     2153             ,input  v-diasize-proc-name
     2154             ,input  'width':u
     2155             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2156             ) .
     2157         end.
     2158       end.
     2159     end.
     2160     assign
     2161       v-diasize-change-size = false
     2162     .
     2163   end procedure.
     2164   procedure diasize_set-width :
     2165     define input  parameter p-new-width  as decimal   no-undo .
     2166     define input  parameter p-move-resize as logical   no-undo .
     2167     do
     2168     on error undo, return error return-value
     2169     :
     2170       run diasize_change-width in this-procedure
     2171         (input  (p-new-width - frame Dialog-Frame :width)
     2172         ,input  p-move-resize
     2173         ) .
     2174     end.
     2175   end procedure.
     2176   procedure diasize_position-resize-button :
     2177     do with frame Dialog-Frame
     2178     :
     2179       hide v-diasize-resize-button .
     2180       assign
     2181         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2182                     - 1
     2183                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2184         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2185                     - 1
     2186                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2187       .
     2188       view v-diasize-resize-button .
     2189     end.
     2190   end procedure.
     2191   on alt-right anywhere
     2192   do:
     2193     run diasize_change-width in this-procedure
     2194       (input 1
     2195       ,input true
     2196       ) .
     2197     return no-apply .
     2198   end.
     2199   on alt-left anywhere
     2200   do:
     2201     run diasize_change-width in this-procedure
     2202       (input -1
     2203       ,input true
     2204       ) .
     2205     return no-apply .
     2206   end.
     2207   on alt-down anywhere
     2208   do:
     2209     run diasize_change-height in this-procedure
     2210       (input 1
     2211       ,input true
     2212       ) .
     2213     return no-apply .
     2214   end.
     2215   on alt-up anywhere
     2216   do:
     2217     run diasize_change-height in this-procedure
     2218       (input -1
     2219       ,input true
     2220       ) .
     2221     return no-apply .
     2222   end.
     2223   on alt-enter of frame Dialog-Frame
     2224   do:
     2225     run diasize_maximize in this-procedure
     2226       (input  ?
     2227       ).
     2228     return no-apply .
     2229   end.
     2230   procedure diasize_end-move :
     2231     do
     2232     on error undo, return error return-value
     2233     :
     2234       define variable v-row-delta as decimal   no-undo .
     2235       define variable v-col-delta as decimal   no-undo .
     2236       define variable v-new-row as decimal   no-undo .
     2237       define variable v-new-col as decimal   no-undo .
     2238       assign
     2239         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2240         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2241       .
     2242       assign
     2243         v-row-delta = v-new-row - frame Dialog-Frame :height
     2244         v-col-delta = v-new-col - frame Dialog-Frame :width
     2245       .
     2246       run diasize_change-height in this-procedure
     2247         (input v-row-delta
     2248         ,input true
     2249         ) .
     2250       run diasize_change-width in this-procedure
     2251         (input v-col-delta
     2252         ,input true
     2253         ) .
     2254     end.
     2255   end procedure.
     2256   procedure diasize_maximize :
     2257     define input  parameter p-action as logical   no-undo .
     2258     do
     2259     on error undo, return error return-value
     2260     :
     2261       if p-action = ?
     2262       then do:
     2263         if v-diasize-need-maximize = true
     2264         then do:
     2265           assign
     2266             p-action = true
     2267           .
     2268         end.
     2269         else do:
     2270           assign
     2271             p-action = false
     2272           .
     2273         end.
     2274       end.
     2275       if p-action = true
     2276       then do:
     2277         run diasize_change-height in this-procedure
     2278           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2279               - frame Dialog-Frame :height-chars
     2280           ,input true
     2281           ) .
     2282         run diasize_change-width in this-procedure
     2283           (input session :width-chars
     2284               - frame Dialog-Frame :width-chars
     2285           ,input true
     2286           ) .
     2287         assign
     2288           v-diasize-need-maximize = false
     2289         .
     2290       end.
     2291       else do:
     2292         run diasize_change-width in this-procedure
     2293           (input v-diasize-orig-frame-width
     2294               - frame Dialog-Frame :width-chars
     2295           ,input true
     2296           ) .
     2297         run diasize_change-height in this-procedure
     2298           (input v-diasize-orig-frame-height
     2299               - frame Dialog-Frame :height-chars
     2300           ,input true
     2301           ) .
     2302         assign
     2303           v-diasize-need-maximize = true
     2304         .
     2305       end.
     2306     end.
     2307   end procedure.
     2308   procedure diasize_restore-orig-size :
     2309     do
     2310     on error undo, return error return-value
     2311     :
     2312       assign
     2313         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2314         v-diasize-current-frame-height = frame Dialog-Frame :height
     2315       .
     2316       run diasize_set-height in this-procedure
     2317         (input  v-diasize-orig-frame-height
     2318         ,input  true
     2319         ) .
     2320       run diasize_set-width in this-procedure
     2321         (input  v-diasize-orig-frame-width
     2322         ,input  true
     2323         ) .
     2324     end.
     2325   end procedure.
     2326   procedure diasize_restore-current-size :
     2327     do
     2328     on error undo, return error return-value
     2329     :
     2330       run diasize_set-height in this-procedure
     2331         (input  v-diasize-current-frame-height
     2332         ,input  true
     2333         ) .
     2334       run diasize_set-width in this-procedure
     2335         (input  v-diasize-current-frame-width
     2336         ,input  true
     2337         ) .
     2338     end.
     2339   end procedure.
     2340   procedure diasize_set-browse-handle :
     2341     define input  parameter p-browse-handle as handle   no-undo .
     2342     define buffer buf_temp-browse-handle for temp-browse-handle .
     2343     do
     2344     on error undo, return error return-value
     2345     :
     2346       assign
     2347         v-diasize-browse-handle = p-browse-handle
     2348       .
     2349       for each buf_temp-browse-handle
     2350       on error undo, return error return-value
     2351       :
     2352         delete buf_temp-browse-handle .
     2353       end.
     2354     end.
