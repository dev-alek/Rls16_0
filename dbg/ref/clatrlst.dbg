      391   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      392   procedure cur-time :
      393      define output parameter p-today as date      no-undo .
      394      define output parameter p-time  as integer   no-undo .
      395     do
      396     on error undo, return error
      397     :
      398       define variable v-date1 as date      no-undo .
      399       define variable v-date2 as date      no-undo .
      400       define variable v-time  as integer   no-undo .
      401       assign
      402         v-date1 = today
      403         v-time  = time
      404         v-date2 = today
      405       .
      406       if v-date1 <> v-date2
      407       then do:
      408         assign
      409           v-date1 = today
      410           v-time  = v-time
      411         .
      412       end.
      413       assign
      414         p-today = v-date1
      415         p-time  = v-time
      416       .
      417     end.
      418   end.
      419   function cur-time-date returns character
      420   :
      421     return string(today, '99/99/9999':U) .
      422   end.
      423   function cur-time-mjd returns decimal
      424   :
      425     define variable v-date as date      no-undo .
      426     define variable v-time as integer   no-undo .
      427     run cur-time in this-procedure
      428       (output v-date
      429       ,output v-time
      430       ) .
      431     return integer(v-date) - 2400002 + (v-time / 86400) .
      432   end.
      433   function cur-time-get-ending-index returns integer
      434   (input p-number as integer
      435   )
      436   :
      437     if p-number < 0
      438     or p-number = ?
      439     then do:
      440       return 1 .
      441     end.
      442     define variable v-rest as integer   no-undo .
      443     assign
      444       p-number = p-number modulo 100
      445     .
      446     if p-number < 20
      447     then do:
      448       assign
      449         v-rest = p-number
      450       .
      451     end.
      452     else do:
      453       assign
      454         v-rest = p-number modulo 10
      455       .
      456     end.
      457     case v-rest :
      458       when 1
      459       then do:
      460         return 2 .
      461       end.
      462       when 2 or
      463       when 3 or
      464       when 4
      465       then do:
      466         return 3 .
      467       end.
      468       otherwise do:
      469         return 1 .
      470       end.
      471     end case .
      472   end.
      473   procedure cur-time-mjd-to-date :
      474      define input  parameter i-mjd-diff as decimal no-undo.
      475      define output parameter o-Date     as date    no-undo.
      476      define output parameter o-Time     as integer no-undo.
      477      define variable v-day-number as integer   no-undo .
      478      if    i-mjd-diff < 0
      479         or i-mjd-diff = ?
      480      then do:
      481         return "?" .
      482      end.
      483      assign
      484         v-day-number = truncate(i-mjd-diff,0).
      485         o-Date = date(v-day-number + 2400002).
      486         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      487     .
      488   end.
      489   function cur-time-mjd-to-string returns character
      490   (input p-mjd-diff as decimal
      491   )
      492   :
      493     define variable v-day-number as integer   no-undo .
      494     define variable v-seconds    as integer   no-undo .
      495     define variable v-hour       as integer   no-undo .
      496     define variable v-min        as integer   no-undo .
      497     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дн€" ] .
      498     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      499     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      500     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      501     if p-mjd-diff < 0
      502     or p-mjd-diff = ?
      503     then do:
      504       return "?" .
      505     end.
      506     assign
      507       v-day-number = integer(truncate(p-mjd-diff,0))
      508       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      509     .
      510     if v-seconds > 86400
      511     then do:
      512       assign
      513         v-seconds = 86400 - 1
      514       .
      515     end.
      516     if v-seconds < 0
      517     then do:
      518       assign
      519         v-seconds = 0
      520       .
      521     end.
      522     assign
      523       v-hour = truncate(v-seconds / 3600, 0)
      524     .
      525     assign
      526       v-seconds = v-seconds modulo 3600
      527     .
      528     assign
      529       v-min = truncate(v-seconds / 60, 0)
      530     .
      531     assign
      532       v-seconds = v-seconds modulo 60
      533     .
      534     return
      535         (if v-day-number <> 0
      536           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      537           else ""
      538         )
      539       + (if v-day-number <> 0 or v-hour <> 0
      540           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      541           else ""
      542         )
      543       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      544           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      545           else ""
      546         )
      547       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      548       .
      549   end.
      550   function cur-time-string returns character
      551   :
      552     define variable v-date as date      no-undo .
      553     define variable v-time as integer   no-undo .
      554     run cur-time in this-procedure
      555       (output v-date
      556       ,output v-time
      557       ) .
      558     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      559   end.
      560   function cur-time-string-sec returns character
      561   :
      562     define variable v-date as date      no-undo .
      563     define variable v-time as integer   no-undo .
      564     run cur-time in this-procedure
      565       (output v-date
      566       ,output v-time
      567       ) .
      568     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      569   end.
      570   function cur-time-custom  returns character
      571   (input p-prefix as character
      572   ,input p-date-format as character
      573   ,input p-delimiter as character
      574   ,input p-time-format as character
      575   ,input p-suffix as character
      576   )
      577   :
      578     define variable v-date as date      no-undo .
      579     define variable v-time as integer   no-undo .
      580     run cur-time in this-procedure
      581       (output v-date
      582       ,output v-time
      583       ) .
      584     return
      585       p-prefix
      586       + string(v-date, p-date-format)
      587       + p-delimiter
      588       + string(v-time, p-time-format)
      589       + p-suffix
      590       .
      591   end.
      592   function cur-time-print  returns character
      593   :
      594     define variable v-date as date      no-undo .
      595     define variable v-time as integer   no-undo .
      596     run cur-time in this-procedure
      597       (output v-date
      598       ,output v-time
      599       ) .
      600     return "ƒата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      601   end.
      602   function cur-time-datetime returns datetime
      603   :
      604     define variable v-char as character no-undo .
      605     define variable v-datetime as datetime no-undo .
      606     v-char = cur-time-string().
      607     v-datetime = datetime(v-char).
      608     return  v-datetime.
      609   end.
      610   function cur-time-string-msec returns character
      611   :
      612     define variable v-date as datetime  no-undo .
      613     v-date = now.
      614     return string(v-date) .
      615   end.
      616   define variable parhost-code like ub.sysconf.host-code no-undo .
      617   define variable parobj-type like ub.clients.obj-type no-undo .
      618   define variable parobj-code like ub.clients.obj-code no-undo .
      619   define variable pardelete-ok as logical no-undo .
      620   DEFINE VARIABLE var-object as character no-undo init 'clients-attr':U.
      621   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      622   FUNCTION CIntBinS RETURNS CHARACTER(input vl_int as integer):
      623   def var vl_bin as char no-undo init "".
      624   if vl_int < 0 OR vl_int = ? then return ?.
      625   do while vl_int > 0:
      626     assign
      627     vl_bin = (if vl_int modulo 2 = 0
      628                 then "0":U
      629                 else "1":U) + vl_bin
      630     vl_int = truncate(vl_int / 2,0).
      631   end.
      632   return fill( "0":U, 32 - length(vl_bin)) + vl_bin .
      633   END FUNCTION.
      634   FUNCTION BinMask RETURNS LOGICAL(input vl_int as integer,
      635                                    input vl_binm as character):
      636   DEFINE VARIABLE vl_bin as character no-undo.
      637   DEFINE VARIABLE ii as integer no-undo.
      638   DEFINE VARIABLE ii-len as integer no-undo.
      639   DEFINE VARIABLE ii-lenm as integer no-undo.
      640   DEFINE VARIABLE mchar as character no-undo.
      641   DEFINE VARIABLE ichar as character no-undo.
      642   if vl_binm = ? then return ?.
      643   vl_bin = CIntBinS(vl_int).
      644   if vl_bin = ? then return ?.
      645   assign
      646   vl_binm = LEFT-TRIM(vl_binm, "X":U)
      647   ii-lenm = LENGTH(vl_binm)
      648   ii-len = LENGTH(vl_bin) - ii-lenm
      649   .
      650   if II-LENM > 32 THEN RETURN ?.
      651   DO II = 1 to II-LENm:
      652     assign
      653     mchar = SUBSTR(vl_binm, ii, 1)
      654     ichar = SUBSTR(vl_bin, ii + ii-len, 1)
      655     .
      656     IF not (MCHAR = "0":u or MCHAR = "1":u or MCHAR = "X":u) then return ?.
      657     IF ichar <> mchar AND mchar <> "X":U then return no.
      658   END.
      659   return yes.
      660   END FUNCTION.
      661   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      662   define SHARED temp-table temp-attr no-undo
      663   field attr-code like ub.gds-obj-attr.attr-code
      664   field attr-value like ub.gds-obj-attr.attr-value
      665   field host-code as integer
      666   field obj-type as character
      667   field obj-code as integer
      668   field user-can-edit as log
      669   field code as char
      670   field action as logical
      671   field other-inf as character
      672   index pi is  unique primary
      673   attr-code host-code obj-type obj-code ASCENDING
      674   index action
      675   action
      676   .
      677   procedure tempattr-value :
      678    do
      679     on error undo, return error
      680     :
      681       define input  parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
      682       define input  parameter p-host-code as integer no-undo .
      683       define input  parameter p-obj-type as character no-undo .
      684       define input  parameter p-obj-code as integer no-undo .
      685       define input  parameter p-mode      as character no-undo .
      686       define output parameter p-value    like ub.gds-obj-attr.attr-value no-undo .
      687       define output parameter p-type     as character no-undo .
      688       define buffer buf_temp-attr for temp-attr .
      689       define variable v-format         as character no-undo .
      690       define variable v-label          as character no-undo .
      691       define variable v-user-can-edit  as logical   no-undo .
      692       define variable v-output-display as logical   no-undo .
      693       define variable v-other          as character no-undo .
      694       define variable v-range          as integer   no-undo .
      695       define variable jj               as integer   no-undo .
      696       define variable v-spr            as logical   no-undo .
      697       define variable v-spr-name       as character no-undo .
      698       define variable v-spr-param      as character no-undo .
      699       define variable v-setted         as logical   no-undo .
      700       case var-object:
      701         when 'gds-obj-attr':U
      702         then do:
      703           run gdsoattr-name in this-procedure
      704             (input  p-code
      705             ,output p-type
      706             ,output v-format
      707             ,output v-label
      708             ,output v-user-can-edit
      709             ,output v-output-display
      710             ,output v-other
      711             ) no-error .
      712         end.
      713         when 'gds-host-attr':U
      714         then do:
      715           run gdshattr-name in this-procedure
      716             (input  p-code
      717             ,output p-type
      718             ,output v-format
      719             ,output v-label
      720             ,output v-user-can-edit
      721             ,output v-output-display
      722             ,output v-other
      723             ) no-error .
      724         end.
      725         when 'clients-attr':U
      726         then do:
      727           run clntattr-code in this-procedure
      728             (input  p-code
      729             ,output p-type
      730             ,output v-format
      731             ,output v-label
      732             ,output v-user-can-edit
      733             ,output v-output-display
      734             ,output v-other
      735             ) no-error .
      736         end.
      737         when 'goods-attr':U
      738         then do:
      739           run gds-attr-name in this-procedure
      740             (input  p-code
      741             ,output p-type
      742             ,output v-format
      743             ,output v-label
      744             ,output v-user-can-edit
      745             ,output v-output-display
      746             ,output v-other
      747             ) no-error .
      748         end.
      749         otherwise do:
      750           undo, return error .
      751         end.
      752       end case.
      753       if error-status :error
      754       then do:
      755         undo, return error return-value .
      756       end.
      757       if v-user-can-edit
      758       then do:
      759         do jj = 1 to num-entries(v-other, chr(47)):
      760           if entry(1, entry(jj, v-other, chr(47)), "=":U) = "spr":U then do:
      761             assign
      762             v-spr-name = entry(2, entry(jj, v-other, chr(47)), "=":U)
      763             .
      764           end.
      765           if entry(1, entry(jj, v-other, chr(47)), "=":U) = "spr-param":U then do:
      766             assign
      767             v-spr-param = entry(2, entry(jj, v-other, chr(47)), "=":U)
      768             .
      769           end.
      770        end.
      771         if v-spr-name <> "":U then do:
      772           if p-mode = "change":U
      773           then do:
      774             find first buf_temp-attr no-lock where
      775                       buf_temp-attr.attr-code = p-code
      776                   and buf_temp-attr.host-code = p-host-code
      777                   and buf_temp-attr.obj-type = p-obj-type
      778                   and buf_temp-attr.obj-code = p-obj-code
      779               no-error .
      780             if avail buf_temp-attr then do:
      781               assign
      782                 p-value =  buf_temp-attr.attr-value
      783               .
      784             end.
      785             else do:
      786               assign
      787                 p-value = if p-type = 'L':U then "no":U else ""
      788               .
      789             end.
      790           end.
      791           CASE var-object:
      792             when 'gds-obj-attr':U then do:
      793               if v-spr-param = "":U then do:
      794                 run value (
      795                             v-spr-name)
      796                             in this-procedure (
      797                                                   input 0
      798                                                 ,input parobj-type
      799                                                 ,input parobj-code
      800                                                 ,input-output p-value
      801                                                 ,output v-setted) no-error .
      802               end.
      803               else do:
      804                 run value (
      805                             v-spr-name)
      806                             in this-procedure (
      807                                                   input 0
      808                                                 ,input parobj-type
      809                                                 ,input parobj-code
      810                                                 ,input v-spr-param
      811                                                 ,input-output p-value
      812                                                 ,output v-setted) no-error .
      813               end.
      814               if error-status :error then do:
      815                 undo, return error "Ќеизвестный справочник дл€ получени€ значени€ атрибут товара на объекте" + " " + p-code .
      816               end.
      817             end.
      818             when 'clients-attr':U then do:
      819             if v-spr-param = "":U then do:
      820               run   value ( v-spr-name ) in this-procedure
      821                   (  input 0
      822                     ,input parobj-type
      823                     ,input parobj-code
      824                     ,input-output p-value
      825                     ,output v-setted )
      826                     no-error .
      827             end.
      828             end.
      829             END CASE.
      830           if v-setted = no then do:
      831             return "not-set":U.
      832           end.
      833           assign
      834           v-spr = yes
      835           .
      836         end.
      837       end.
      838       if not v-spr then do:
      839         find first buf_temp-attr no-lock where
      840                   buf_temp-attr.attr-code = p-code
      841               and buf_temp-attr.host-code = p-host-code
      842               and buf_temp-attr.obj-type = p-obj-type
      843               and buf_temp-attr.obj-code = p-obj-code
      844           no-error .
      845         if avail buf_temp-attr then do:
      846           assign
      847             p-value =  buf_temp-attr.attr-value
      848           .
      849         end.
      850         else do:
      851           assign
      852             p-value = if p-type = 'L':U then "no":U else ""
      853           .
      854         end.
      855       end.
      856     end.
      857   end procedure.
      858   procedure tempattr-write :
      859     do
      860     on error undo, return error
      861     :
      862       define input parameter p-add      as logical no-undo .
      863       define input parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
      864       define input parameter p-host-code as integer no-undo .
      865       define input parameter p-obj-type as character no-undo .
      866       define input parameter p-obj-code as integer no-undo .
      867       define input parameter p-value    like ub.gds-obj-attr.attr-value no-undo .
      868       define input parameter p-action   like temp-attr.action no-undo .
      869       define buffer buf_temp-attr for temp-attr .
      870       define variable v-type           as character no-undo .
      871       define variable v-format         as character no-undo .
      872       define variable v-label          as character no-undo .
      873       define variable v-user-can-edit  as logical   no-undo .
      874       define variable v-output-display as logical   no-undo .
      875       define variable v-other          as character no-undo .
      876       define variable v-range          as integer   no-undo .
      877       define variable var-region  as character no-undo.
      878       DEFINE VARIABLE v-sel-vals as character no-undo .
      879       DEFINE VARIABLE v-sel-labels as character no-undo .
      880       define variable varhost-code like ub.sysconf.host-code no-undo.
      881       define variable varobj-type like ub.clients.obj-type no-undo.
      882       define variable varobj-code like ub.clients.obj-code no-undo.
      883       define variable choice as integer no-undo .
      884       case var-object:
      885         when 'gds-obj-attr':U
      886         then do:
      887           run gdsoattr-name in this-procedure
      888             (input  p-code
      889             ,output v-type
      890             ,output v-format
      891             ,output v-label
      892             ,output v-user-can-edit
      893             ,output v-output-display
      894             ,output v-other
      895             ) no-error .
      896         end.
      897         when 'gds-host-attr':U
      898         then do:
      899           run gdshattr-name in this-procedure
      900             (input  p-code
      901             ,output v-type
      902             ,output v-format
      903             ,output v-label
      904             ,output v-user-can-edit
      905             ,output v-output-display
      906             ,output v-other
      907             ) no-error .
      908         end.
      909         when 'clients-attr':U
      910         then do:
      911           run clntattr-code in this-procedure
      912             (input  p-code
      913             ,output v-type
      914             ,output v-format
      915             ,output v-label
      916             ,output v-user-can-edit
      917             ,output v-output-display
      918             ,output v-other
      919             ) no-error .
      920         end.
      921         when 'goods-attr':U
      922         then do:
      923           run gds-attr-name in this-procedure
      924             (input  p-code
      925             ,output v-type
      926             ,output v-format
      927             ,output v-label
      928             ,output v-user-can-edit
      929             ,output v-output-display
      930             ,output v-other
      931             ) no-error .
      932         end.
      933         otherwise do:
      934           undo, return error .
      935         end.
      936       END CASE.
      937       if error-status :error then do:
      938         undo, return error return-value .
      939       end.
      940       if not v-user-can-edit then do:
      941         message
      942         "«апрещено редактировать атрибут" v-label
      943         view-as alert-box error .
      944         undo, return error.
      945       end.
      946       find first buf_temp-attr exclusive-lock where
      947                  buf_temp-attr.attr-code = p-code
      948               and buf_temp-attr.host-code = p-host-code
      949               and buf_temp-attr.obj-type = p-obj-type
      950               and buf_temp-attr.obj-code = p-obj-code no-error .
      951       if not available buf_temp-attr then do:
      952         create buf_temp-attr .
      953         assign
      954           buf_temp-attr.attr-code = p-code
      955           buf_temp-attr.host-code = p-host-code
      956           buf_temp-attr.obj-type = p-obj-type
      957           buf_temp-attr.obj-code = p-obj-code
      958           buf_temp-attr.attr-value = p-value
      959           buf_temp-attr.action = p-action
      960           buf_temp-attr.code = v-label
      961           buf_temp-attr.other-inf = v-other
      962           no-error
      963         .
      964       end.
      965       ELSE
      966       ASSIGN
      967       buf_temp-attr.attr-value = p-value no-error.
      968     end.
      969   end procedure.
      970   procedure tempattr-exist :
      971     do
      972     on error undo, return error
      973     :
      974       define input parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
      975       define input parameter p-host-code as integer no-undo .
      976       define input parameter p-obj-type as character no-undo .
      977       define input parameter p-obj-code as integer no-undo .
      978       define output parameter p-exist    as logical no-undo .
      979       define output parameter p-action as logical no-undo .
      980       define buffer buf_temp-attr for temp-attr .
      981       define variable v-type           as character no-undo .
      982       define variable v-format         as character no-undo .
      983       define variable v-label          as character no-undo .
      984       define variable v-user-can-edit  as logical   no-undo .
      985       define variable v-output-display as logical   no-undo .
      986       define variable v-other          as character no-undo .
      987       define variable v-range          as integer   no-undo .
      988       case var-object:
      989         when 'gds-obj-attr':U then do:
      990           run gdsoattr-name in this-procedure
      991             (input  p-code
      992             ,output v-type
      993             ,output v-format
      994             ,output v-label
      995             ,output v-user-can-edit
      996             ,output v-output-display
      997             ,output v-other
      998             ) no-error .
      999         end.
     1000         when 'gds-host-attr':U
     1001         then do:
     1002           run gdshattr-name in this-procedure
     1003             (input  p-code
     1004             ,output v-type
     1005             ,output v-format
     1006             ,output v-label
     1007             ,output v-user-can-edit
     1008             ,output v-output-display
     1009             ,output v-other
     1010             ) no-error .
     1011         end.
     1012         when 'clients-attr':U
     1013         then do:
     1014           run clntattr-code in this-procedure
     1015             (input  p-code
     1016             ,output v-type
     1017             ,output v-format
     1018             ,output v-label
     1019             ,output v-user-can-edit
     1020             ,output v-output-display
     1021             ,output v-other
     1022             ) no-error .
     1023         end.
     1024         when 'goods-attr':U then do:
     1025           run gds-attr-name in this-procedure
     1026             (input  p-code
     1027             ,output v-type
     1028             ,output v-format
     1029             ,output v-label
     1030             ,output v-user-can-edit
     1031             ,output v-output-display
     1032             ,output v-other
     1033             ) no-error .
     1034         end.
     1035         otherwise do:
     1036           undo, return error .
     1037         end.
     1038       end case.
     1039       if error-status :error
     1040       then do:
     1041         undo, return error return-value .
     1042       end.
     1043       find first buf_temp-attr no-lock where
     1044                  buf_temp-attr.attr-code = p-code
     1045               and buf_temp-attr.host-code = p-host-code
     1046               and buf_temp-attr.obj-type = p-obj-type
     1047               and buf_temp-attr.obj-code = p-obj-code no-error .
     1048       if available buf_temp-attr then do:
     1049         P-EXIST = YES.
     1050         p-action = buf_temp-attr.action.
     1051       end.
     1052     end.
     1053   end procedure.
     1054   procedure tempattr-delete :
     1055     do
     1056     on error undo, return error
     1057     :
     1058       define input parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
     1059       define input parameter p-host-code as integer no-undo .
     1060       define input parameter p-obj-type as character no-undo .
     1061       define input parameter p-obj-code as integer no-undo .
     1062       define output parameter p-deleted  as logical no-undo .
     1063       define buffer buf_temp-attr for temp-attr .
     1064       define variable v-type           as character no-undo .
     1065       define variable v-format         as character no-undo .
     1066       define variable v-label          as character no-undo .
     1067       define variable v-user-can-edit  as logical   no-undo .
     1068       define variable v-output-display as logical   no-undo .
     1069       define variable v-other          as character no-undo .
     1070       define variable v-range          as integer   no-undo .
     1071       case var-object:
     1072         when 'gds-obj-attr':U
     1073         then do:
     1074           run gdsoattr-name in this-procedure
     1075             (input  p-code
     1076             ,output v-type
     1077             ,output v-format
     1078             ,output v-label
     1079             ,output v-user-can-edit
     1080             ,output v-output-display
     1081             ,output v-other
     1082             ) no-error .
     1083         end.
     1084         when 'gds-host-attr':U
     1085         then do:
     1086           run gdshattr-name in this-procedure
     1087             (input  p-code
     1088             ,output v-type
     1089             ,output v-format
     1090             ,output v-label
     1091             ,output v-user-can-edit
     1092             ,output v-output-display
     1093             ,output v-other
     1094             ) no-error .
     1095         end.
     1096         when 'clients-attr':U
     1097         then do:
     1098           run clntattr-code in this-procedure
     1099             (input  p-code
     1100             ,output v-type
     1101             ,output v-format
     1102             ,output v-label
     1103             ,output v-user-can-edit
     1104             ,output v-output-display
     1105             ,output v-other
     1106             ) no-error .
     1107         end.
     1108         when 'goods-attr':U
     1109         then do:
     1110           run gds-attr-name in this-procedure
     1111             (input  p-code
     1112             ,output v-type
     1113             ,output v-format
     1114             ,output v-label
     1115             ,output v-user-can-edit
     1116             ,output v-output-display
     1117             ,output v-other
     1118             ) no-error .
     1119         end.
     1120         otherwise do:
     1121           undo, return error .
     1122         end.
     1123       END CASE.
     1124       if error-status :error then do:
     1125         undo, return error return-value .
     1126       end.
     1127       find first buf_temp-attr exclusive-lock where
     1128                  buf_temp-attr.attr-code = p-code
     1129               and buf_temp-attr.host-code = p-host-code
     1130               and buf_temp-attr.obj-type = p-obj-type
     1131               and buf_temp-attr.obj-code = p-obj-code no-error .
     1132       if not available buf_temp-attr then do:
     1133         P-DELETED = NO.
     1134       end.
     1135       ELSE DO:
     1136          delete buf_temp-attr.
     1137          P-DELETED = YES.
     1138       END.
     1139     end.
     1140   end procedure.
     1141   define variable v-no-ask as logical no-undo .
     1142   define variable v-view-log as logical no-undo .
     1143   define variable log-file-name                as character      no-undo init "clatrlst.txt".
     1144   define variable v-stop                       as logical        no-undo .
     1145   define variable v-choice as integer no-undo .
     1146   DEFINE VARIABLE num-rec as integer no-undo .
     1147   DEFINE VARIABLE num-rec-ok as integer no-undo .
     1148   define variable v-mes as character no-undo .
     1149   assign
     1150   parhost-code = integer(entry(1, p-parameter, chr(4)))
     1151   parobj-type  = entry(2, p-parameter, chr(4))
     1152   parobj-code = integer(entry(3, p-parameter, chr(4)))
     1153   pardelete-ok = logical(entry(4, p-parameter, chr(4)))
     1154   no-error
     1155   .
     1156   if error-status:error then do:
     1157    run write-log-and-file in p-log-handle (
     1158           input 1
     1159         , input log-file-name
     1160         , input 1
     1161         , input substitute("ќшибка входных параметров &1:&2&3&4"
     1162                            , p-parameter
     1163                            , chr(10)
     1164                            , error-status:get-message(1)
     1165                            , return-value
     1166                            )).
     1167     assign
     1168     v-view-log = yes.
     1169   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1170   if v-view-log
     1171   and not g#news
     1172   and not g#auto
     1173   then do:
     1174     message
     1175     '!!!ѕри изменении атрибутов клиента по списку клиентов произошли ошибки!!!'  skip
     1176     "!!!¬нимательно прочитайте Log-file!!"
     1177     view-as alert-box error .
     1178        define variable v-user-action7   as character no-undo .
     1179     define variable v-printed7       as logical   no-undo .
     1180     run gbl/prnfilen.w
     1181       (input  ('!!!ѕри изменении атрибутов клиента по списку клиентов произошли ошибки!!!')
     1182       ,input  0
     1183       ,input  (string("./":U) + 'clatrlst.txt')
     1184       ,input  7
     1185       ,output v-user-action7
     1186       ,output v-printed7
     1187       ) .
     1188   end.
     1189   if v-view-log = true
     1190   and (g#news
     1191   or g#auto)
     1192   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     1193   then do:
     1194      run cb_set-view-log in p-parent-handle ( input yes).
     1195   end.
     1196   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     1197     OS-DELETE value(string("./":U) + 'clatrlst.txt').
     1198   end.
     1199     return .
     1200   end.
     1201   run write-log  in p-log-handle(
     1202                                    input 0
     1203                                  , "&DLine").
     1204   run write-log-and-file in p-log-handle (
     1205         input 1
     1206       , input log-file-name
     1207       , input 1
     1208       , input substitute("»зменение атрибутов клиентов по списку клиентов")).
     1209   _cli-list:
     1210   for each cli-list No-LOCK ,
     1211       first ub.clients No-LOCK WHERE
     1212             ub.clients.obj-type = cli-list.obj-type AND
     1213             ub.clients.obj-code = cli-list.obj-code
     1214     ON ERROR undo, NEXT:
     1215       num-rec = num-rec + 1.
     1216       run do-changes in this-procedure (
     1217                                          input ub.clients.obj-type
     1218                                         ,input ub.clients.obj-code) no-error .
     1219       if error-status:error then do:
     1220         assign
     1221         v-view-log = yes.
     1222         run write-log-and-file in p-log-handle (
     1223                   input 1
     1224                 , input log-file-name
     1225                 , input 1
     1226                 , input return-value
     1227                                             ).
     1228          if v-no-ask  then do:
     1229           run gbl/d-askw.w (
     1230                         input "»зменение атрибутов клиентов по списку"
     1231                         ,input substitute("клиент &1&2 - не удалось провести изменение атрибутов клиента"
     1232                                         , cli-list.obj-type
     1233                                         , cli-list.obj-code
     1234                                         )
     1235                         ,input "|"
     1236                         ,input ("ѕродолжить|" +
     1237                               "ѕродолжить и больше не запрашивать подтверждени€ на продолжение|" +
     1238                               "ѕрекратить")
     1239                         ,input "||"
     1240                         ,input 1
     1241                         ,input 3
     1242                         ,output v-choice).
     1243           if v-choice = 3 then do:
     1244             leave.
     1245           end.
     1246           if v-choice = 2 then do:
     1247             assign
     1248             v-no-ask = yes.
     1249           end.
     1250          end.
     1251       end.
     1252       else do:
     1253         num-rec-ok = num-rec-ok + 1.
     1254         if pardelete-ok then delete cli-list.
     1255       end.
     1256       run show-counter in p-log-handle .
     1257       run write-counter in p-log-handle (substitute("ќбработано &1 из них успешно &2"
     1258                                                   , num-rec
     1259                                                   , num-rec-ok
     1260                                                   )) no-error.
     1261       run get-stop-state in p-log-handle (
     1262           output v-stop
     1263       ).
     1264       if v-stop then do:
     1265         leave _cli-list.
     1266       end.
     1267   END.
     1268   run write-log-and-file in p-log-handle (
     1269         input 1
     1270       , input log-file-name
     1271       , input 1
     1272       , input substitute("ѕакетное изменение атрибутов по списку клиентов завершено: из &1 клиентов списка успешно изменено &2", num-rec, num-rec-ok )).
     1273   .
     1274   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1275   if v-view-log
     1276   and not g#news
     1277   and not g#auto
     1278   then do:
     1279     message
     1280     '!!!ѕри изменении атрибутов клиентов по списку клиентов произошли ошибки!!!'  skip
     1281     "!!!¬нимательно прочитайте Log-file!!"
     1282     view-as alert-box error .
     1283        define variable v-user-action9   as character no-undo .
     1284     define variable v-printed9       as logical   no-undo .
     1285     run gbl/prnfilen.w
     1286       (input  ('!!!ѕри изменении атрибутов клиентов по списку клиентов произошли ошибки!!!')
     1287       ,input  0
     1288       ,input  (string("./":U) + 'clatrlst.txt')
     1289       ,input  7
     1290       ,output v-user-action9
     1291       ,output v-printed9
     1292       ) .
     1293   end.
     1294   if v-view-log = true
     1295   and (g#news
     1296   or g#auto)
     1297   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     1298   then do:
     1299      run cb_set-view-log in p-parent-handle ( input yes).
     1300   end.
     1301   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     1302     OS-DELETE value(string("./":U) + 'clatrlst.txt').
     1303   end.
     1304   procedure do-changes :
     1305   define input parameter parobj-type like ub.clients.obj-type no-undo .
     1306   define input parameter parobj-code like ub.clients.obj-code no-undo .
     1307   DEFINE VARIABLE loc#log as logical no-undo .
     1308   DEFINE VARIABLE var-deleted as logical no-undo .
     1309       _main:
     1310     do
     1311     on error undo, return error
     1312     :
     1313       for each temp-attr no-lock
     1314           on error undo _main, return error:
     1315         CASE temp-attr.action:
     1316           when yes then do:
     1317             run clntattr-write in this-procedure(
     1318                                                   input parobj-type,
     1319                                                   input parobj-code,
     1320                                                   input temp-attr.attr-code,
     1321                                                   input temp-attr.attr-value
     1322                                                       )  no-error.
     1323             IF ERROR-STATUS:ERROR THEN DO:
     1324                 assign v-mes = substitute("клиент &1&2: ошибка при записи атрибута клиента &3:&4&5 &6&4"  +                    "ќбратитесь к администратору системы"                     , cli-list.obj-type                    , cli-list.obj-code                     , temp-attr.attr-value                    , chr(10)                        , error-status:get-message(1)                    , return-value ).
     1325                 undo _main,   return error v-mes.
     1326             END.
     1327           end.
     1328           when no then do:
     1329             var-deleted = no.
     1330             run clntattr-delete in this-procedure(
     1331                                                   input parobj-type,
     1332                                                   input parobj-code,
     1333                                                   input temp-attr.attr-code,
     1334                                                   output var-deleted
     1335                                                       )  no-error.
     1336             IF ERROR-STATUS:ERROR THEN DO:
     1337                 assign v-mes = substitute("клиент &1&2: ошибка при удалении атрибута клиента &3:&4&5 &6&4"  +                    "ќбратитесь к администратору системы"                     , cli-list.obj-type                    , cli-list.obj-code                     , temp-attr.attr-value                    , chr(10)                        , error-status:get-message(1)                    , return-value ).
     1338                 undo _main, return error v-mes.
     1339             END.
     1340           end.
     1341         END CASE.
     1342       end.
     1343     end.
     1344   end procedure.
