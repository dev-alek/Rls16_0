        1   block-level on error undo, throw.
        2   define input  parameter p-old as character no-undo .
        3   define input  parameter p-new as character no-undo .
        4   define input  parameter p-ask as logical   no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: chg-igt.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: ref/chg-igt.p $":U .
       10   define variable vss-description as character no-undo init "Процедура изменения ИЖТ".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   procedure proc-alt-shift-f2:
       81     if not ibs.th.gbl.gbl-var:rcode
       82   then
       83     run gbl\inidebug.p .
       84   end.
       85   procedure proc-alt-shift-f3:
       86     run gbl/prvssinf.p
       87       ( input this-procedure
       88       ) .
       89   end.
       90   define variable v-inform-launched as logical no-undo initial false .
       91   procedure proc-alt-shift-f4:
       92     define variable v-action as character no-undo .
       93     if v-inform-launched = false then do:
       94       assign
       95         v-inform-launched = true
       96       .
       97       run gbl/d-inform.w
       98         (  input self
       99         ,  input this-procedure
      100         , output v-action
      101         ) no-error .
      102       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      103       assign
      104         v-inform-launched = false
      105       .
      106     end.
      107   end.
      108   procedure proc-alt-f1:
      109     run gbl/corrhelp.p
      110       (input this-procedure
      111       ) .
      112   end .
      113   on alt-shift-f2 anywhere do:
      114     run proc-alt-shift-f2.
      115   end.
      116   on alt-shift-f3 anywhere do:
      117     run proc-alt-shift-f3 in this-procedure .
      118   end.
      119   on alt-shift-f4 anywhere do:
      120     run proc-alt-shift-f4 in this-procedure.
      121   end.
      122   on alt-f1 anywhere do:
      123     run proc-alt-f1 in this-procedure .
      124   end.
      125   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126   define variable v-waitfram-action01         as character   no-undo .
      127   define variable v-waitfram-action02         as character   no-undo .
      128   define variable v-waitfram-action03         as character   no-undo .
      129   define variable mWaitFramTextBeg            as character   no-undo.
      130   define variable mWaitFramTextEnd            as character   no-undo.
      131   define variable mWaitFramView               as logical     no-undo.
      132   define variable mWaitProcEvent              as logical     no-undo init yes.
      133   define variable mWaitFramInterval           as integer     no-undo init 1 .
      134   define variable mWaitFramStop               as logical     no-undo.
      135   define variable mWaitFramStopUser           as logical     no-undo.
      136   define variable mWaitFramStopTimeOut        as logical     no-undo.
      137   define variable mWaitFramStartProc          as datetime-tz no-undo.
      138   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      139   define button B-WaitFramStop auto-end-key
      140        label "Стоп"
      141        size 10 by 1 tooltip "Остоновить процесс".
      142   define button B-viewProcInfo
      143        label "Информация"
      144        size 15 by 1 tooltip "Информация о процесс".
      145   define frame waitfram
      146     v-waitfram-action01 format "x(72)" no-label skip
      147     v-waitfram-action02 format "x(72)" no-label skip
      148     v-waitfram-action03 format "x(72)" no-label skip
      149     B-viewProcInfo
      150     B-WaitFramStop at row 4 col 30
      151     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      152     .
      153   define new global shared variable mBatchMode as logical no-undo init ?.
      154   define variable mFramBachModHandle as handle no-undo.
      155   mFramBachModHandle = frame waitfram:handle.
      156   define variable mFameOldVis as logical no-undo.
      157   define variable mVisCUrentVin as logical no-undo.
      158   if session:batch-mode
      159   then
      160      mBatchMode = yes.
      161   if mBatchMode = ? then do:
      162     mVisCUrentVin = current-window:visible.
      163     mFameOldVis = mFramBachModHandle:visible.
      164     mFramBachModHandle:visible  = yes.
      165     mBatchMode = mFramBachModHandle:visible ne yes.
      166     mFramBachModHandle:visible = mFameOldVis.
      167     current-window:visible = mVisCUrentVin.
      168   end.
      169    if  log-manager:logfile-name ne ?
      170     then DO:
      171         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      172         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      173         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      174     end.
      175   on choose of B-WaitFramStop in frame waitfram
      176   do:
      177     mWaitFramStop = yes.
      178     mWaitFramStopUser = yes.
      179   end.
      180   function waitfram-check-timeout returns logical():
      181      define variable vtime as int64 no-undo.
      182      if mWaitFramStopTimeOut
      183      then
      184         return yes.
      185      vtime = ( now - mWaitFramStartProc ) / 1000 .
      186      if     mWaitFramTimeOut ne ?
      187         and mWaitFramTimeOut ne 0
      188         and mWaitFramTimeOut lt vtime
      189      then do:
      190         mWaitFramStopTimeOut = yes.
      191      end.
      192      return mWaitFramStopTimeOut.
      193   end.
      194   procedure waitfram-hide :
      195     if not session:batch-mode
      196     then do
      197     on error undo, return error return-value
      198     :
      199       pause 0 before-hide .
      200       if not mBatchMode then
      201         hide frame waitfram .
      202     if     not mWaitFramView
      203        and mWaitProcEvent
      204     then
      205       process events .
      206     end.
      207   end procedure.
      208   procedure waitfram-show :
      209     define input  parameter p-message as character no-undo .
      210     define variable v-left-margin as integer   no-undo .
      211     if not session:batch-mode
      212     then do
      213     on error undo, return error return-value
      214     :
      215       if length(p-message) <= 70 then do:
      216         assign
      217           v-left-margin = integer((70 - length(p-message)) / 2)
      218         .
      219         assign
      220           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      221         .
      222         assign
      223           v-waitfram-action01 = " "
      224           v-waitfram-action02 = " "
      225                                    + fill(" ", v-left-margin)
      226                                    + p-message
      227           v-waitfram-action03 = " "
      228         .
      229       end.
      230       else do:
      231         define variable vRindex1 as integer no-undo.
      232         define variable vRindex2 as integer no-undo.
      233         vRindex1 = r-index(p-message," ",70).
      234         if vRindex1 = 0
      235         then
      236            vRindex1 = 70.
      237         if length(p-message)  <= vRindex1 + 70 then do:
      238           assign
      239             v-waitfram-action01 = " "
      240             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      241             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      242           .
      243         end.
      244         else do:
      245           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      246           if vRindex2 <= vRindex1
      247           then
      248              vRindex2 = vRindex1 + 70.
      249           assign
      250             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      251             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      252             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      253           .
      254         end.
      255       end.
      256       B-viewProcInfo:visible   in frame waitfram = no.
      257       B-viewProcInfo:sensitive in frame waitfram = no.
      258       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      259       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      260       if  (   mWaitFramView
      261          or  mWaitProcEvent)
      262          and not mBatchMode
      263       then
      264          display
      265             v-waitfram-action01 skip
      266             v-waitfram-action02 skip
      267             v-waitfram-action03 skip
      268          with frame waitfram .
      269       if     mWaitFramView
      270          then do:
      271             if     mWaitFramInterval ne ?
      272                and not mBatchMode
      273             then
      274                wait-for go of frame waitfram pause mWaitFramInterval.
      275          end.
      276          else
      277             if     mWaitProcEvent
      278                and not mBatchMode
      279             then
      280                process events .
      281     end.
      282   end procedure.
      283      procedure waitfram-show-this:
      284         define input  parameter iInterval as int64 no-undo.
      285         define variable vtime as int64 no-undo.
      286         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      287         mWaitFramInterval = iInterval.
      288         run waitfram-show (substitute("&1&2 &3&4" ,
      289                                       mWaitFramTextBeg ,
      290                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      291                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      292                                       mWaitFramTextEnd
      293                                      )
      294                           ).
      295      end.
      296      procedure WaitFramRunPause:
      297         define input  parameter iInterval as dec no-undo.
      298         define variable vStart  as datetime-tz no-undo.
      299         define variable vend    as datetime-tz no-undo.
      300         define variable vint as int64 no-undo.
      301         define variable vOk as logical no-undo.
      302         vStart = now.
      303         vend   = vStart.
      304         publish "WaitFramPause" (iInterval,output vOk).
      305         vend   =  now.
      306         vint = vend - vStart.
      307         vint = iInterval - vint / 1000.
      308         if     not mWaitFramStop
      309            and (   vint > 0
      310                 or (    not vOk
      311                     and iInterval eq ?
      312                     )
      313                 )
      314         then
      315            run waitfram-show-this (iInterval).
      316         vend   =  now.
      317         vint = vend - vStart.
      318         vint = iInterval - vint / 1000.
      319         if     not mWaitFramStop
      320            and vint > 0
      321         then do:
      322            run gbl/pause.p (vint * 1000).
      323         end.
      324         if iInterval ne ?
      325         then
      326            publish "WaitFramStop".
      327         waitfram-check-timeout().
      328      end.
      329      procedure WaitFramWaitFor:
      330         define input  parameter iInterval as dec no-undo.
      331         assign
      332            mWaitFramStartProc   = now
      333            mWaitFramStopUser    = no
      334            mWaitFramStopTimeOut = no
      335         .
      336         block-wait:
      337         do while not mWaitFramStop:
      338            run WaitFramRunPause (iInterval).
      339            if  waitfram-check-timeout()
      340            then do:
      341               leave block-wait.
      342            end.
      343         end.
      344         run waitfram-hide.
      345      end.
      346   procedure waitfram-join :
      347     define input  parameter p-line-1  as character no-undo .
      348     define input  parameter p-line-2  as character no-undo .
      349     define input  parameter p-line-3  as character no-undo .
      350     define output parameter p-message as character no-undo .
      351     do
      352     on error undo, return error return-value
      353     :
      354       assign
      355         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      356                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      357                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      358       .
      359     end.
      360   end procedure.
      361   function waitfram-join-function returns character
      362     (input p-line-1 as character
      363     ,input p-line-2 as character
      364     ,input p-line-3 as character
      365     ).
      366     define variable v-message as character no-undo .
      367     run waitfram-join in this-procedure
      368       (input  p-line-1
      369       ,input  p-line-2
      370       ,input  p-line-3
      371       ,output v-message
      372       ) .
      373     return v-message .
      374   end function .
      375   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   procedure cur-time :
      377      define output parameter p-today as date      no-undo .
      378      define output parameter p-time  as integer   no-undo .
      379     do
      380     on error undo, return error
      381     :
      382       define variable v-date1 as date      no-undo .
      383       define variable v-date2 as date      no-undo .
      384       define variable v-time  as integer   no-undo .
      385       assign
      386         v-date1 = today
      387         v-time  = time
      388         v-date2 = today
      389       .
      390       if v-date1 <> v-date2
      391       then do:
      392         assign
      393           v-date1 = today
      394           v-time  = v-time
      395         .
      396       end.
      397       assign
      398         p-today = v-date1
      399         p-time  = v-time
      400       .
      401     end.
      402   end.
      403   function cur-time-date returns character
      404   :
      405     return string(today, '99/99/9999':U) .
      406   end.
      407   function cur-time-mjd returns decimal
      408   :
      409     define variable v-date as date      no-undo .
      410     define variable v-time as integer   no-undo .
      411     run cur-time in this-procedure
      412       (output v-date
      413       ,output v-time
      414       ) .
      415     return integer(v-date) - 2400002 + (v-time / 86400) .
      416   end.
      417   function cur-time-get-ending-index returns integer
      418   (input p-number as integer
      419   )
      420   :
      421     if p-number < 0
      422     or p-number = ?
      423     then do:
      424       return 1 .
      425     end.
      426     define variable v-rest as integer   no-undo .
      427     assign
      428       p-number = p-number modulo 100
      429     .
      430     if p-number < 20
      431     then do:
      432       assign
      433         v-rest = p-number
      434       .
      435     end.
      436     else do:
      437       assign
      438         v-rest = p-number modulo 10
      439       .
      440     end.
      441     case v-rest :
      442       when 1
      443       then do:
      444         return 2 .
      445       end.
      446       when 2 or
      447       when 3 or
      448       when 4
      449       then do:
      450         return 3 .
      451       end.
      452       otherwise do:
      453         return 1 .
      454       end.
      455     end case .
      456   end.
      457   procedure cur-time-mjd-to-date :
      458      define input  parameter i-mjd-diff as decimal no-undo.
      459      define output parameter o-Date     as date    no-undo.
      460      define output parameter o-Time     as integer no-undo.
      461      define variable v-day-number as integer   no-undo .
      462      if    i-mjd-diff < 0
      463         or i-mjd-diff = ?
      464      then do:
      465         return "?" .
      466      end.
      467      assign
      468         v-day-number = truncate(i-mjd-diff,0).
      469         o-Date = date(v-day-number + 2400002).
      470         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      471     .
      472   end.
      473   function cur-time-mjd-to-string returns character
      474   (input p-mjd-diff as decimal
      475   )
      476   :
      477     define variable v-day-number as integer   no-undo .
      478     define variable v-seconds    as integer   no-undo .
      479     define variable v-hour       as integer   no-undo .
      480     define variable v-min        as integer   no-undo .
      481     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      482     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      483     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      484     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      485     if p-mjd-diff < 0
      486     or p-mjd-diff = ?
      487     then do:
      488       return "?" .
      489     end.
      490     assign
      491       v-day-number = integer(truncate(p-mjd-diff,0))
      492       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      493     .
      494     if v-seconds > 86400
      495     then do:
      496       assign
      497         v-seconds = 86400 - 1
      498       .
      499     end.
      500     if v-seconds < 0
      501     then do:
      502       assign
      503         v-seconds = 0
      504       .
      505     end.
      506     assign
      507       v-hour = truncate(v-seconds / 3600, 0)
      508     .
      509     assign
      510       v-seconds = v-seconds modulo 3600
      511     .
      512     assign
      513       v-min = truncate(v-seconds / 60, 0)
      514     .
      515     assign
      516       v-seconds = v-seconds modulo 60
      517     .
      518     return
      519         (if v-day-number <> 0
      520           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      521           else ""
      522         )
      523       + (if v-day-number <> 0 or v-hour <> 0
      524           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      525           else ""
      526         )
      527       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      528           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      529           else ""
      530         )
      531       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      532       .
      533   end.
      534   function cur-time-string returns character
      535   :
      536     define variable v-date as date      no-undo .
      537     define variable v-time as integer   no-undo .
      538     run cur-time in this-procedure
      539       (output v-date
      540       ,output v-time
      541       ) .
      542     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      543   end.
      544   function cur-time-string-sec returns character
      545   :
      546     define variable v-date as date      no-undo .
      547     define variable v-time as integer   no-undo .
      548     run cur-time in this-procedure
      549       (output v-date
      550       ,output v-time
      551       ) .
      552     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      553   end.
      554   function cur-time-custom  returns character
      555   (input p-prefix as character
      556   ,input p-date-format as character
      557   ,input p-delimiter as character
      558   ,input p-time-format as character
      559   ,input p-suffix as character
      560   )
      561   :
      562     define variable v-date as date      no-undo .
      563     define variable v-time as integer   no-undo .
      564     run cur-time in this-procedure
      565       (output v-date
      566       ,output v-time
      567       ) .
      568     return
      569       p-prefix
      570       + string(v-date, p-date-format)
      571       + p-delimiter
      572       + string(v-time, p-time-format)
      573       + p-suffix
      574       .
      575   end.
      576   function cur-time-print  returns character
      577   :
      578     define variable v-date as date      no-undo .
      579     define variable v-time as integer   no-undo .
      580     run cur-time in this-procedure
      581       (output v-date
      582       ,output v-time
      583       ) .
      584     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      585   end.
      586   function cur-time-datetime returns datetime
      587   :
      588     define variable v-char as character no-undo .
      589     define variable v-datetime as datetime no-undo .
      590     v-char = cur-time-string().
      591     v-datetime = datetime(v-char).
      592     return  v-datetime.
      593   end.
      594   function cur-time-string-msec returns character
      595   :
      596     define variable v-date as datetime  no-undo .
      597     v-date = now.
      598     return string(v-date) .
      599   end.
      600   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      601   def
      602    shared
      603   temp-table  obj-list no-undo
      604     field obj-type like ub.clients.obj-type
      605     field obj-code like ub.clients.obj-code
      606     field obj-name like ub.clients.obj-name
      607     field obj-id   as integer
      608     field db-num   as integer
      609     index pi is primary unique obj-id
      610     index ie1 obj-type obj-code
      611     index ie2 obj-name
      612   .
      613   procedure create_obj-list :
      614      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      615      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      616      do
      617      on error undo, return error return-value
      618      :
      619         define buffer cli-obj for ub.clients .
      620         define variable p-var as integer no-undo .
      621         define buffer buf_obj-list for obj-list .
      622         find last buf_obj-list  use-index pi no-error .
      623         if available buf_obj-list
      624         then
      625            p-var = buf_obj-list.obj-id + 1.
      626         else
      627            p-var = 1.
      628         find first cli-obj where
      629                   cli-obj.obj-type = p-obj-type
      630               and cli-obj.obj-code = p-obj-code
      631         no-lock no-error.
      632         if available cli-obj
      633         then do:
      634            create buf_obj-list.
      635            assign
      636               buf_obj-list.obj-id   = p-var
      637               buf_obj-list.obj-code = cli-obj.obj-code
      638               buf_obj-list.obj-type = cli-obj.obj-type
      639               buf_obj-list.obj-name = cli-obj.obj-name
      640               buf_obj-list.db-num   = cli-obj.db-num
      641            .
      642         end.
      643      end.
      644   end.
      645   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      646   define shared temp-table gds-list no-undo like ub.goods
      647     field qnty   as decimal
      648     field to-del as logical
      649     field order-num as integer
      650     field to-sel as logical
      651     field promo-code as character
      652     field ActionId  as int64
      653     field db-num as integer
      654     index art  is primary unique artic prod-type prod-code
      655     index code is         unique gds-code
      656     index oi order-num
      657     index isel to-sel
      658     .
      659   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      660   define  shared  temp-table gds-list-hist no-undo
      661   field list-table as character
      662   field id as integer
      663   field line as integer
      664   field hist-mode as character
      665   field des as character
      666   field num-recs as integer
      667   field option_ as character
      668   field item_ as character
      669   field status_ as character
      670   field num-add as integer
      671   field num-ignored as integer
      672   field done as logical
      673   field err_ as logical
      674   field err-mes as character
      675   index pi is primary
      676   id
      677   line
      678   index isdone
      679   done
      680   .
      681   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      682   procedure gds-ind1 :
      683   main-block:
      684     do
      685   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      686   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      687   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      688     :
      689   define input-output parameter p-doc-rec  as recid no-undo.
      690   define input  parameter p-gds-code                   like  ub.gds-obj-prop.gds-code no-undo.
      691   define input  parameter p-obj-type                   like  ub.gds-obj-prop.obj-type no-undo.
      692   define input  parameter p-obj-code                   like  ub.gds-obj-prop.obj-code no-undo.
      693   define input  parameter p-gdop-igt                   like  ub.gds-obj-prop.gdop-igt no-undo.
      694   define input  parameter p-gdop-assort-min            like  ub.gds-obj-prop.gdop-assort-min  no-undo.
      695   define input  parameter p-gdop-min-stock             like  ub.gds-obj-prop.gdop-min-stock   no-undo.
      696   define input  parameter p-grop-level-always-presence like  ub.gds-obj-prop.grop-level-always-presence  no-undo.
      697   define input  parameter p-grop-max-stock             like  ub.gds-obj-prop.grop-max-stock              no-undo.
      698   define input  parameter p-grop-min-order             like  ub.gds-obj-prop.grop-min-order              no-undo.
      699   define buffer bufs_gds-obj-prop for ub.gds-obj-prop.
      700   define variable v-db-num like ub.db.db-num no-undo .
      701   define variable v-db-num-obj like ub.db.db-num no-undo .
      702   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      703   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      704     (output v-db-num
      705     )  .
      706   define variable v-date as date no-undo .
      707   define variable v-time as integer no-undo .
      708   run cur-time in this-procedure(output v-date, output v-time).
      709     find first bufs_gds-obj-prop exclusive-lock where
      710               bufs_gds-obj-prop.gds-code          = p-gds-code   and
      711               bufs_gds-obj-prop.obj-type          = p-obj-type   and
      712               bufs_gds-obj-prop.obj-code          = p-obj-code  no-error .
      713       if not available bufs_gds-obj-prop then do:
      714           create bufs_gds-obj-prop.
      715           assign
      716               bufs_gds-obj-prop.gds-code           = p-gds-code
      717               bufs_gds-obj-prop.grop-date-update   = v-date
      718               bufs_gds-obj-prop.grop-time-update   = v-time
      719               bufs_gds-obj-prop.grop-db-num-update = v-db-num
      720               bufs_gds-obj-prop.obj-type           = p-obj-type
      721               bufs_gds-obj-prop.obj-code           = p-obj-code
      722           no-error .
      723           if error-status :error then message "Ошибка при создании записи" error-status :error error-status :get-message(1) .
      724       end.
      725   if  p-gdop-igt                     <> ? then    bufs_gds-obj-prop.gdop-igt                   = p-gdop-igt.
      726   if  p-gdop-assort-min              <> ? then    bufs_gds-obj-prop.gdop-assort-min            = p-gdop-assort-min.
      727   if  p-gdop-min-stock               <> ? then    bufs_gds-obj-prop.gdop-min-stock             = p-gdop-min-stock  .
      728   if  p-grop-level-always-presence   <> ? then    bufs_gds-obj-prop.grop-level-always-presence = p-grop-level-always-presence.
      729   if  p-grop-max-stock               <> ? then    bufs_gds-obj-prop.grop-max-stock             = p-grop-max-stock           .
      730   if  p-grop-min-order               <> ? then    bufs_gds-obj-prop.grop-min-order             = p-grop-min-order           .
      731         p-doc-rec = recid(bufs_gds-obj-prop)    .
      732   end.
      733   end procedure.
      734   define buffer buf_gds-obj-prop for ub.gds-obj-prop .
      735   define buffer buf_gds-obj      for ub.gds-obj .
      736   define variable v-i as integer   no-undo .
      737   define variable Temp1 as integer   no-undo .
      738   define variable v-gds-prop-recid as recid no-undo .
      739   define variable v-num as integer no-undo init 0.
      740   define variable v-flag as logical   no-undo init false .
      741   define variable v-log-name as character no-undo .
      742   define stream Err .
      743   run gbl/_tmpfile.p ("wb", ".txt", output v-log-name) .
      744   output stream err to value(v-log-name).
      745   put stream err
      746       "Текущий ИЖТ " p-old " меняем на " p-new skip
      747       "СПИСОК ТОВАРОВ С ДРУГИМ ТЕКУЩИМ ИЖТ" skip.
      748   for each obj-list NO-LOCK:
      749       run waitfram-show ("Объект " + obj-list.obj-name ) .
      750       put stream err unformatted
      751           "Объект "                chr(9)
      752           obj-list.obj-type        chr(9)
      753           obj-list.obj-code
      754           skip.
      755       v-i = 0.
      756       Label-gds-list:
      757       for each gds-list NO-LOCK:
      758           v-i = v-i + 1.
      759   If Integer(1) = 0 Then Temp1  = 100  .
      760                         Else Temp1 = Integer(1) .
      761        IF ( v-i modulo Temp1 = 0 ) AND ( v-i >= Temp1 ) then
      762            RUN waitfram-show( "Обработано строк : " + string( v-i )) .
      763           CASE p-ask:
      764                WHEN FALSE THEN DO:
      765                     FIND FIRST buf_gds-obj-prop WHERE
      766                                buf_gds-obj-prop.obj-type = obj-list.obj-type
      767                            AND buf_gds-obj-prop.obj-code = obj-list.obj-code
      768                            AND buf_gds-obj-prop.gds-code = gds-list.gds-code
      769                            AND buf_gds-obj-prop.gdop-igt = p-old
      770                          NO-LOCK NO-ERROR.
      771                     if AVAILABLE buf_gds-obj-prop THEN DO:
      772                        RUN gds-ind1
      773                            (input-output v-gds-prop-recid
      774                             ,buf_gds-obj-prop.gds-code
      775                             ,buf_gds-obj-prop.obj-type
      776                             ,buf_gds-obj-prop.obj-code
      777                             ,p-new
      778                             ,?
      779                             ,?
      780                             ,?
      781                             ,?
      782                             ,?
      783                             ) .
      784                     END.
      785                END.
      786                WHEN TRUE THEN DO:
      787                     FIND FIRST buf_gds-obj-prop WHERE
      788                                buf_gds-obj-prop.obj-type = obj-list.obj-type
      789                            AND buf_gds-obj-prop.obj-code = obj-list.obj-code
      790                            AND buf_gds-obj-prop.gds-code = gds-list.gds-code
      791                          NO-LOCK NO-ERROR.
      792                     if AVAILABLE buf_gds-obj-prop
      793                        AND  buf_gds-obj-prop.gdop-igt = p-old
      794                        THEN DO:
      795                        RUN gds-ind1 (input-output v-gds-prop-recid
      796                                      ,buf_gds-obj-prop.gds-code
      797                                      ,buf_gds-obj-prop.obj-type
      798                                      ,buf_gds-obj-prop.obj-code
      799                                      ,p-new
      800                                      ,?
      801                                      ,?
      802                                      ,?
      803                                      ,?
      804                                      ,?
      805                                     ).
      806                        NEXT Label-gds-list.
      807                     END.
      808                     ELSE DO:
      809                        if not AVAILABLE buf_gds-obj-prop
      810                           THEN DO:
      811                           NEXT Label-gds-list.
      812                        END.
      813                        if AVAILABLE buf_gds-obj-prop
      814                           AND  buf_gds-obj-prop.gdop-igt = p-new
      815                           THEN DO:
      816                           NEXT Label-gds-list.
      817                        END.
      818                        if (v-num = 0 or v-num = 1 or v-num = 3) THEN DO:
      819                            RUN gbl/d-askw.w(
      820                                input "Вопрос по переходу ИЖТ"
      821                               ,input "Товар " + gds-list.artic + " " + gds-list.gds-name + chr(10)
      822                                      + "Объект " + obj-list.obj-type + string(obj-list.obj-code) + chr(10)
      823                                      + "ИЖТ = " + caps( buf_gds-obj-prop.gdop-igt) + chr(10)
      824                                      + "заданный Старый ИЖТ = " + caps(p-old) + chr(10)
      825                                      + "Вы действительно хотите изменить " + caps(buf_gds-obj-prop.gdop-igt) + " на " + caps(p-new) + " ?" + chr(10)
      826                               ,input "|^"
      827                               ,input "Да|Да для всех^confirm|Нет|Нет для всех^confirm"
      828                               ,input "Заменить на новый ИЖТ только этот товар|"
      829                                      + "Заменить на новый ИЖТ все товары списка|"
      830                                      + "Пропустить этот товар|"
      831                                      + "Пропустить все товары, где старый ИЖТ не = "
      832                                      + p-old
      833                               ,input 1
      834                               ,input 3
      835                               ,output v-num
      836                               ).
      837                        END.
      838                        if v-num = 1 or v-num = 2 THEN DO:
      839                           v-flag = true .
      840                           put STREAM err
      841                               gds-list.artic
      842                               gds-list.prod-type + " " + string ( gds-list.prod-code)
      843                               gds-list.gds-name
      844                               buf_gds-obj-prop.gdop-igt
      845                               skip.
      846                           RUN gds-ind1 (input-output v-gds-prop-recid
      847                                         ,buf_gds-obj-prop.gds-code
      848                                         ,buf_gds-obj-prop.obj-type
      849                                         ,buf_gds-obj-prop.obj-code
      850                                         ,p-new
      851                                         ,?
      852                                         ,?
      853                                         ,?
      854                                         ,?
      855                                         ,?
      856                                        ).
      857                        END.
      858                     END.
      859               END.
      860           END CASE.
      861       end.
      862   end.
      863   output stream err close.
      864   run waitfram-hide.
      865   if v-flag = true AND p-ask then do:
      866       define variable v-user-action as character no-undo .
      867       define variable v-printed     as logical   no-undo .
      868         run gbl/prnfilen.w
      869           (input  "Товары с другим текущим ИЖТ"
      870           ,input  0
      871           ,input  v-log-name
      872           ,input  7
      873           ,output v-user-action
      874           ,output v-printed
      875           ).
      876   end.
      877   RETURN.
