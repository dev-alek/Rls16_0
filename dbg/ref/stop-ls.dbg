      367   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368   FUNCTION mark-string RETURNS CHARACTER
      369     ( input p-recid as recid, input mark-list as character  ) :
      370     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      371   END FUNCTION.
      372   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      373     define variable v-cntxt-db-num        as integer   no-undo .
      374     define variable v-cntxt-userid        as character no-undo .
      375     define variable v-cntxt-level         as character no-undo .
      376     define variable v-cntxt-host-code-obj as integer   no-undo .
      377     define variable v-cntxt-obj-type      as character no-undo .
      378     define variable v-cntxt-obj-code      as integer   no-undo .
      379     define variable v-cntxt-db-num-obj    as integer   no-undo .
      380     define variable v-cntxt-is-admin      as logical   no-undo .
      381   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      382   define variable c-point  as character no-undo .
      383   define variable tbl      as character no-undo .
      384   define variable join-tbl as character no-undo .
      385   define variable fld      as character no-undo .
      386   define variable lab      as character no-undo .
      387   define variable spr      as character no-undo .
      388   define variable dim      as character no-undo .
      389   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      390   procedure fltfield-clear :
      391     define output parameter loc-fld as character no-undo.
      392     define output parameter loc-lab as character no-undo .
      393     define output parameter loc-spr as character no-undo .
      394     define output parameter loc-dim as character no-undo .
      395     assign
      396       loc-fld = ""
      397       loc-lab = ""
      398       loc-spr = ""
      399       loc-dim = "0"
      400     .
      401   end procedure .
      402   procedure fltfield-add :
      403     define input        parameter par-fld as character no-undo.
      404     define input        parameter par-lab as character no-undo .
      405     define input        parameter par-spr as character no-undo .
      406     define input-output parameter loc-fld as character no-undo.
      407     define input-output parameter loc-lab as character no-undo .
      408     define input-output parameter loc-spr as character no-undo .
      409     define input-output parameter loc-dim as character no-undo .
      410     do
      411     on error undo, return error
      412     :
      413       assign
      414       loc-fld = if loc-dim = '0'
      415                 then par-fld
      416                 else (loc-fld + chr(44) + par-fld)
      417       loc-lab = if loc-dim = '0'
      418                 then par-lab
      419                 else (loc-lab + chr(44) + par-lab)
      420       loc-spr = if loc-dim = '0'
      421                 then par-spr
      422                 else (loc-spr + chr(44) + par-spr)
      423       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      424                 string(integer(if num-entries(loc-dim) > 1
      425                               then entry(2, loc-dim)
      426                               else entry(1, loc-dim)
      427                               ) + 1)
      428       no-error
      429       .
      430     end.
      431   end procedure.
      432   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      433   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      434   procedure fltopend_fltopend :
      435   define input parameter p-parent-handle as handle no-undo .
      436   define input parameter p-qh as handle no-undo .
      437   define input parameter p-flt-open-open-query  as character no-undo .
      438   define input parameter p-where-cond as character no-undo .
      439   define input parameter p-use-indFIRST-query-tail as character no-undo .
      440   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      441   define input parameter p-indexed-reposition as character no-undo .
      442     do
      443     on error undo, return error
      444     :
      445   define variable v-prepare-string as character no-undo .
      446   define variable glog as logical no-undo .
      447   assign
      448   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      449                      p-where-cond + chr(32)  +
      450                      p-use-indFIRST-query-tail + chr(32) +
      451                      p-use-ind-sort-clmn-by + chr(32) +
      452                      p-indexed-reposition
      453   .
      454   assign
      455   glog = p-qh:query-prepare(v-prepare-string) no-error .
      456   if not glog
      457   or error-status:error then do:
      458     message error-status:get-message(1) view-as alert-box .
      459     undo, return error .
      460   end.
      461   assign
      462   glog = p-qh:query-open no-error .
      463   if not glog
      464   or error-status:error then do:
      465     message error-status:get-message(1) view-as alert-box .
      466     undo, return error .
      467   end.
      468     end.
      469   end procedure.
      470   procedure fltopend_fltfindd :
      471   define input parameter p-parent-handle as handle no-undo .
      472   define input parameter p-qh as handle no-undo .
      473   define input parameter p-rowid as rowid no-undo .
      474   define input parameter p-next as logical no-undo .
      475   define input parameter p-lock as integer no-undo .
      476   define input parameter p-bh as handle no-undo .
      477   define input parameter p-where-cond as character no-undo .
      478   define input parameter p-use-index-phrase as character no-undo .
      479   define variable glog as logical no-undo .
      480   define variable v-qh as handle no-undo .
      481   define variable v-bh as handle no-undo .
      482   define variable v-recid as recid no-undo .
      483   define variable v-prepare-string as character no-undo .
      484   do
      485   on error undo, return error
      486   on stop undo, return error
      487   :
      488     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      489     create buffer v-bh for table p-bh buffer-name p-bh:name.
      490     create query v-qh.
      491     v-qh:set-buffers(v-bh).
      492     v-prepare-string = substitute("for each &1 &2 &3"
      493                                     ,v-bh:name
      494                                     ,p-where-cond
      495                                     ,p-use-index-phrase).
      496     glog = v-qh:query-prepare(v-prepare-string) no-error.
      497     if not glog then do:
      498       delete object v-qh.
      499       delete object v-bh.
      500       undo, return error .
      501     end.
      502     glog = v-qh:query-open no-error .
      503     if not glog then do:
      504       delete object v-qh.
      505       delete object v-bh.
      506       undo, return error .
      507     end.
      508     if p-next then do:
      509       v-qh:reposition-to-rowid(p-rowid) no-error .
      510       glog = v-qh:get-next( p-lock) no-error .
      511       glog = v-qh:get-next( p-lock) no-error .
      512       if not glog or v-qh:query-off-end = yes then do:
      513         glog = v-qh:get-first( p-lock) no-error .
      514       end.
      515     end.
      516     else do:
      517       glog = v-qh:get-first( p-lock) no-error .
      518     end.
      519     v-recid = v-bh:recid no-error .
      520     delete object v-qh.
      521     delete object v-bh.
      522     return string(v-recid) .
      523   end.
      524   end procedure.
      525   procedure fltopend_fltfindq :
      526   define input parameter p-parent-handle as handle no-undo .
      527   define input parameter p-qh as handle no-undo .
      528   define input parameter p-next as logical no-undo .
      529   define input parameter p-lock as integer no-undo .
      530   define input parameter p-flt-open-open-query  as character no-undo .
      531   define input parameter p-where-cond as character no-undo .
      532   define input parameter p-use-indFIRST-query-tail as character no-undo .
      533   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      534   define input parameter p-indexed-reposition as character no-undo .
      535   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      536   define variable glog as logical no-undo .
      537   define variable v-qh as handle no-undo .
      538   define variable v-bh as handle no-undo extent 18.
      539   define variable v-rowid as rowid no-undo extent 18.
      540   define variable v-ii as integer no-undo .
      541   define variable v-prepare-string as character no-undo .
      542   do
      543   on error undo, return error
      544   on stop undo, return error
      545   :
      546     create query v-qh.
      547     do v-ii = 1 to p-qh:num-buffers:
      548       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      549       assign
      550       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      551       no-error.
      552       v-qh:add-buffer(v-bh[v-ii]).
      553     end.
      554     assign
      555     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      556                       p-where-cond + chr(32)  +
      557                       p-use-indFIRST-query-tail + chr(32) +
      558                       p-use-ind-sort-clmn-by + chr(32) +
      559                       p-indexed-reposition
      560     .
      561     glog = v-qh:query-prepare( v-prepare-string) no-error .
      562     if not glog then do:
      563       delete object v-qh.
      564       do v-ii = 1 to p-qh:num-buffers:
      565         delete object v-bh[v-ii].
      566       end.
      567       undo, return error .
      568     end.
      569     glog = v-qh:query-open no-error .
      570     if not glog then do:
      571       delete object v-qh.
      572       do v-ii = 1 to p-qh:num-buffers:
      573         delete object v-bh[v-ii].
      574       end.
      575       undo, return error .
      576     end.
      577     if p-next then do:
      578       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      579       glog = v-qh:get-next( p-lock) no-error .
      580       glog = v-qh:get-next( p-lock) no-error .
      581       if not glog or v-qh:query-off-end = yes then do:
      582         glog = v-qh:get-first( p-lock) no-error .
      583       end.
      584     end.
      585     else do:
      586       glog = v-qh:get-first( p-lock) no-error .
      587     end.
      588     do v-ii = 1 to p-qh:num-buffers:
      589       assign
      590       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      591       no-error.
      592     end.
      593     delete object v-qh.
      594     do v-ii = 1 to p-qh:num-buffers:
      595       delete object v-bh[v-ii].
      596     end.
      597   end.
      598   end procedure.
      599   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      600   define variable v-doc-rec as recid no-undo .
      601   define variable filter-label as character no-undo .
      602   define variable filter-label0 as character no-undo init "Список Стоплистов" .
      603   define variable filter-point as character no-undo .
      604   define variable filter-point0 as character no-undo init "stop-ls" .
      605   DEFINE VARIABLE sort-column-name as character no-undo .
      606   DEFINE VARIABLE add-option AS CHARACTER NO-UNDO.
      607   DEFINE VARIABLE chg-option AS CHARACTER NO-UNDO.
      608   DEFINE MENU MENU-b-add
      609          MENU-ITEM m_import       LABEL "Импорт (формат СИБНЕФТЬ)"
      610          MENU-ITEM m_manual       LABEL "Вручную"
      611          MENU-ITEM m_copy         LABEL "Копия"         .
      612   DEFINE MENU PMENU-b-chg
      613          MENU-ITEM m_import-chg   LABEL "Импорт (формат СИБНЕФТЬ)"
      614          MENU-ITEM m_manual-chg   LABEL "Вручную"       .
      615   DEFINE BUTTON b-add
      616        LABEL "&Добавить"
      617        SIZE 10 BY 1.
      618   DEFINE BUTTON b-cd
      619        LABEL "На кассу"
      620        SIZE 10 BY 1.
      621   DEFINE BUTTON b-chg
      622        LABEL "&Изменить"
      623        SIZE 10 BY 1.
      624   DEFINE BUTTON b-close
      625        LABEL "Закрыть"
      626        SIZE 10 BY 1.
      627   DEFINE BUTTON b-del
      628        LABEL "&Удалить"
      629        SIZE 10 BY 1.
      630   DEFINE BUTTON B-Help
      631        LABEL "Помо&щь"
      632        SIZE 3 BY 1
      633        BGCOLOR 8 .
      634   DEFINE BUTTON b-history
      635        LABEL "Btn 1"
      636        SIZE 3 BY 1.
      637   DEFINE BUTTON b-lkp
      638        LABEL "&Просмотр"
      639        SIZE 10 BY 1.
      640   DEFINE BUTTON B-mark
      641        LABEL "&*"
      642        SIZE 3 BY 1.
      643   DEFINE BUTTON b-quit AUTO-END-KEY
      644        LABEL "&Выход"
      645        SIZE 10 BY 1
      646        BGCOLOR 8 .
      647   DEFINE BUTTON b-sch
      648        LABEL "Фильтр"
      649        SIZE 3 BY 1.
      650   DEFINE BUTTON B-sel AUTO-GO
      651        LABEL "Вы&бор"
      652        SIZE 10 BY 1.
      653   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
      654         VIEW-AS TEXT
      655        SIZE 6 BY 1
      656        FGCOLOR 4  NO-UNDO.
      657   DEFINE QUERY BR-stop-list FOR X_stop-list SCROLLING.
      658   DEFINE BROWSE BR-stop-list
      659     QUERY BR-stop-list NO-LOCK DISPLAY
      660         mark-string(recid(X_stop-list), v-rid-list) COLUMN-LABEL "*" FORMAT "X(2)"
      661   X_stop-list.stop-list-code COLUMN-LABEL "№ стоплиста" FORMAT "X(9)"
      662   X_stop-list.doc-date  COLUMN-LABEL "Дата стоплиста" FORMAT "99/99/9999"
      663   X_stop-list.fact-date COLUMN-LABEL "Факт.Дата" FORMAT "99/99/9999"
      664   X_stop-list.sys-time COLUMN-LABEL "Факт.время" FORMAT "X(10)"
      665   X_stop-list.status_ COLUMN-LABEL "Статус" FORMAT "X(10)"
      666       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.88 BY 19 FIT-LAST-COLUMN.
      667   DEFINE FRAME Dialog-Frame
      668        b-quit AT ROW 1 COL 1
      669        B-mark AT ROW 1 COL 11
      670        B-sel AT ROW 1 COL 21
      671        b-add AT ROW 1 COL 31
      672        b-chg AT ROW 1 COL 41
      673        b-del AT ROW 1 COL 51
      674        b-lkp AT ROW 1 COL 61
      675        b-history AT ROW 1 COL 89 WIDGET-ID 2
      676        b-sch AT ROW 1 COL 92
      677        B-Help AT ROW 1 COL 95
      678        b-close AT ROW 2 COL 31
      679        b-cd AT ROW 2 COL 61
      680        BR-stop-list AT ROW 3 COL 1
      681        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
      682        SPACE(79.40) SKIP(20.47)
      683       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      684            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      685            TITLE "Стоплисты по ДК"
      686            CANCEL-BUTTON b-quit.
      687   ASSIGN
      688          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      689          FRAME Dialog-Frame:HIDDEN           = TRUE.
      690   ASSIGN
      691          b-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-add:HANDLE.
      692   ASSIGN
      693          b-chg:POPUP-MENU IN FRAME Dialog-Frame       = MENU PMENU-b-chg:HANDLE.
      694   ON GO OF FRAME Dialog-Frame
