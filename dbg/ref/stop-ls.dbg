      724       run gbl/pop-up.p ( input self:handle
      725                        , input no) no-error.
      726       if error-status:error or chg-option = "":U then return no-apply.
      727     END.
      728     RUN proc-b-chg IN THIS-PROCEDURE ( input chg-option) no-error.
      729     IF ERROR-STATUS:ERROR THEN DO:
      730        chg-option = '':U.
      731        RETURN NO-APPLY.
      732     END.
      733     chg-option = '':U.
      734   END.
      735   ON CHOOSE OF b-close IN FRAME Dialog-Frame
      736   DO:
      737     DEFINE VARIABLE v-rec AS RECID NO-UNDO.
      738     DEFINE VARIABLE glog AS LOGICAL no-undo.
      739     IF NOT AVAILABLE X_stop-list THEN RETURN NO-APPLY.
      740   define variable v-ok as logical no-undo .
      741   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      742   do:
      743     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      744       (input  v-cntxt-db-num
      745       ,input  v-cntxt-userid
      746       ,input  0
      747       ,input  'actn_stop-list_fact':U
      748       ,input  'global':U
      749       ,input  0
      750       ,input  '':U
      751       ,input  0
      752       ,input  0
      753       ,input  0
      754       ,input  0
      755       ,input  true
      756       ,output v-ok
      757       )  .
      758   end.
      759   if v-ok <> true
      760   then do:
      761     undo, return no-apply .
      762   end.
      763     MESSAGE
      764     SUBSTITUTE("Вы действительно хотите закрыть стоплист &1?"
      765                  , X_stop-list.stop-list-code)
      766     VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
      767     IF NOT glog THEN RETURN NO-APPLY.
      768     v-rec = RECID(X_stop-list).
      769     run ref/stop-l2.p (
      770                     input parparentproc
      771                    ,INPUT RECID(X_stop-list)
      772                    ,INPUT NO
      773                    ) NO-ERROR.
      774     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      775     run proc-b-cd in this-procedure  .
      776     run Openbr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
      777     REPOSITION br-stop-list TO RECID v-rec NO-ERROR.
      778     APPLY "ENtRY" TO br-stop-list.
      779     APPLY "value-changed" TO br-stop-list.
      780   END.
      781   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      782   DO:
      783     DEFINE VARIABLE glog AS LOGICAL no-undo.
      784     IF NOT AVAILABLE X_stop-list THEN RETURN NO-APPLY.
      785   define variable v-ok as logical no-undo .
      786   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      787   do:
      788     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      789       (input  v-cntxt-db-num
      790       ,input  v-cntxt-userid
      791       ,input  0
      792       ,input  'actn_stop-list_preparation':U
      793       ,input  'global':U
      794       ,input  0
      795       ,input  '':U
      796       ,input  0
      797       ,input  0
      798       ,input  0
      799       ,input  0
      800       ,input  true
      801       ,output v-ok
      802       )  .
      803   end.
      804   if v-ok <> true
      805   then do:
      806     undo, return no-apply .
      807   end.
      808     MESSAGE
      809     SUBSTITUTE("Вы действительно хотите удалить стоплист &1?"
      810              , X_stop-list.stop-list-code)
      811     VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
      812     IF NOT glog THEN RETURN NO-APPLY.
      813     run ref/stop-l3.p ( INPUT RECID(X_stop-list)
      814                    ,INPUT NO
      815                    ) NO-ERROR.
      816     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      817     run Openbr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
      818     APPLY "ENtRY" TO br-stop-list.
      819     APPLY "value-changed" TO br-stop-list.
      820   END.
      821   ON CHOOSE OF b-history IN FRAME Dialog-Frame
      822   DO:
      823   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      824   IF NOT AVAILABLE X_stop-list THEN RETURN NO-APPLY.
      825     run ref/cstop-ls.w ( INPUT parparentproc
      826                         ,INPUT '':U
      827                         ,INPUT "one"
      828                         ,INPUT X_stop-list.stop-list-code
      829                         ,INPUT-OUTPUT v-rid-list) NO-ERROR.
      830   END.
      831   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      832   DO:
      833     run proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
      834     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      835   END.
      836   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      837   DO:
      838     define variable loc#log as logical no-undo .
      839     if available X_stop-list then do:
      840   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      841   define variable v-str-recid10 as character no-undo .
      842   define variable v-num-entry10 as integer   no-undo .
      843   assign
      844     v-str-recid10 = trim( string( recid( X_stop-list ) , "->>>>>>>>>>>9":U ) )
      845     v-num-entry10 = lookup( v-str-recid10 , v-rid-list )
      846   .
      847   if v-num-entry10 > 0 then do:
      848     assign
      849       entry( v-num-entry10, v-rid-list ) = "":U
      850       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      851     .
      852   end.
      853   else do:
      854     assign
      855       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid10
      856     .
      857   end.
      858       loc#log = br-stop-list:refresh() .
      859       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      860           loc#log = br-stop-list:select-next-row ().
      861           apply "VALUE-CHANGED" to br-stop-list in frame Dialog-Frame.
      862       end.
      863       if num-entries( v-rid-list ) = 0
      864       then
      865           hide mark-num in frame Dialog-Frame.
      866       else
      867           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
      868     end.
      869     apply "entry" to br-stop-list in frame Dialog-Frame.
      870   END.
      871   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
      872   DO:
      873     run proc-b-sch IN THIS-PROCEDURE NO-ERROR.
      874     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      875   END.
      876   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      877   DO:
      878       if ( available X_stop-list ) then do:
      879       if  ( v-rid-list = "" ) or b-mark:sensitive = no
      880       then
      881       v-rid-list = string( recid( X_stop-list ) ) .
      882     end.
      883   END.
      884   ON CHOOSE OF MENU-ITEM m_copy
      885   DO:
      886     ASSIGN
      887     ADD-OPTION = "copy":U.
      888     RUN proc-b-add IN THIS-PROCEDURE  ( add-option) NO-ERROR.
      889     IF error-status:ERROR THEN DO:
      890       add-option = '':U.
      891       RETURN NO-APPLY.
      892     END.
      893     add-option = '':U.
      894   END.
      895   ON CHOOSE OF MENU-ITEM m_import
      896   DO:
      897     ASSIGN
      898     ADD-OPTION = "import":U.
      899     RUN proc-b-add IN THIS-PROCEDURE  ( add-option) NO-ERROR.
      900     IF error-status:ERROR THEN DO:
      901       add-option = '':U.
      902       RETURN NO-APPLY.
      903     END.
      904     add-option = '':U.
      905   END.
      906   ON CHOOSE OF MENU-ITEM m_import-chg
      907   DO:
      908         ASSIGN
      909       chg-OPTION = "import":U.
      910       RUN proc-b-chg IN THIS-PROCEDURE  ( chg-option) NO-ERROR.
      911       IF error-status:ERROR THEN DO:
      912         chg-option = '':U.
      913         RETURN NO-APPLY.
      914       END.
      915       chg-option = '':U.
      916   END.
      917   ON CHOOSE OF MENU-ITEM m_manual
      918   DO:
      919       ASSIGN
      920     ADD-OPTION = "manual":U.
      921     RUN proc-b-add IN THIS-PROCEDURE  ( add-option) NO-ERROR.
      922     IF error-status:ERROR THEN DO:
      923       add-option = '':U.
      924       RETURN NO-APPLY.
      925     END.
      926     add-option = '':U.
      927   END.
      928   ON CHOOSE OF MENU-ITEM m_manual-chg
      929   DO:
      930       ASSIGN
      931         chg-OPTION = "manual":U.
      932         RUN proc-b-chg IN THIS-PROCEDURE  ( chg-option) NO-ERROR.
      933         IF error-status:ERROR THEN DO:
      934           chg-option = '':U.
      935           RETURN NO-APPLY.
      936         END.
      937         chg-option = '':U.
      938   END.
      939   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      940   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      941   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      942   on help of frame Dialog-Frame
      943   do:
      944     run gbl/app_help.p
      945       (input this-procedure :file-name
      946       ,input ''
      947       ,input ?
      948       ) no-error.
      949     if error-status :error then do:
      950       message
      951         "Ошибка при вызове помощи"
      952         error-status :get-message(1)
      953         view-as alert-box .
      954     end.
      955   end.
      956   run minbtn-set in this-procedure .
      957   on choose of b-help in frame Dialog-Frame
      958   do:
      959     apply "help":u to frame Dialog-Frame .
      960   end.
      961   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      962   procedure minbtn-set :
      963       do
      964           on error undo, return error return-value
      965           :
      966           define variable ii              as integer       no-undo .
      967           define variable fh              as widget-handle no-undo .
      968           define variable hh              as widget-handle no-undo .
      969           define variable v-h             as handle        extent 4 no-undo .
      970           define variable v-name-button   as character     no-undo .
      971           define variable v-help-old-x    as decimal       no-undo .
      972           define variable v-help-old-y    as decimal       no-undo .
      973           define variable v-help-old-size as decimal       no-undo .
      974           define variable v-frame-width   as decimal       no-undo .
      975           define variable jj              as integer       no-undo .
      976           do
      977               on error undo, return error
      978               :
      979               assign
      980                   v-frame-width = frame Dialog-Frame:width - 0.3
      981                   fh            = frame Dialog-Frame:first-child
      982                   hh            = fh:first-child
      983                   ii            = 1
      984                   .
      985               do while valid-handle(hh):
      986                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      987                   do:
      988                       case lc(hh:name) :
      989                           when "b-help" then
      990                               do:
      991                                   hh:load-image-up("cmp/b-help.bmp":u) .
      992                                   hh:load-image-down("cmp/b-help.bmp":u) .
      993                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      994                                   hh:TOOLTIP = "Помощь" .
      995                                   v-help-old-x = hh:column .
      996                                   v-help-old-y = hh:row    .
      997                                   v-help-old-size = hh:width .
      998                                   hh:width-chars = 2.5 .
      999                               end.
     1000                           when "b-print" then
     1001                               do:
     1002                                   hh:load-image("cmp/b-print.bmp":u) .
     1003                                   hh:TOOLTIP = "Печать" .
     1004                                   v-h[ii] = hh:handle .
     1005                                   ii = ii + 1 .
     1006                                   hh:width-chars = 3 .
     1007                               end.
     1008                           when "b-history" or
     1009                           when "b-hist" then
     1010                               do:
     1011                                   hh:load-image("cmp/b-hist.bmp":u) .
     1012                                   hh:TOOLTIP = "История" .
     1013                                   v-h[ii] = hh:handle .
     1014                                   ii = ii + 1 .
     1015                                   hh:width-chars = 3 .
     1016                               end.
     1017                           when "b-sch" then
     1018                               do:
     1019                                   hh:load-image("cmp/b-sch.bmp":u) .
     1020                                   hh:TOOLTIP = "Установка Фильтра" .
     1021                                   v-h[ii] = hh:handle .
     1022                                   ii = ii + 1 .
     1023                                   hh:width-chars = 3 .
     1024                               end.
     1025                           when "b-hist-user" then
     1026                               do:
     1027                                   hh:load-image("cmp/b-hist.bmp":u) .
     1028                                   hh:TOOLTIP = "История пользователя" .
     1029                                   ii = ii + 1 .
     1030                               end.
     1031                       end case.
     1032                   end.
     1033                   hh = hh:next-sibling.
     1034               end.
     1035               b-help:column = v-frame-width - b-help:width-chars.
     1036               jj = 0.
     1037               repeat ii = 4 to 1 by -1 :
     1038                   if valid-handle (v-h[ii] ) then
     1039                   do:
     1040                       jj  = jj + 1 .
     1041                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1042                       v-h[ii]:row    = v-help-old-y .
     1043                   end.
     1044               end.
     1045           end.
     1046       end.
     1047   end procedure.
     1048   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1049   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1050   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1051   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1052   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1053   define variable v-diasize-current-frame-height as decimal   no-undo .
     1054   define variable v-diasize-change-size          as logical   no-undo .
     1055   define variable v-diasize-resize-button        as handle    no-undo .
     1056   define variable v-diasize-wndmax               as logical   no-undo .
     1057   define variable v-diasize-wndstore             as logical   no-undo .
     1058   define variable v-diasize-proc-name            as character no-undo .
     1059   define variable v-diasize-browse-handle        as handle    no-undo .
     1060   define variable v-diasize-browse-number        as integer   no-undo .
     1061   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1062   define temp-table temp-diasize-handle no-undo
     1063     field handle-value  as handle
     1064     field save-position as decimal
     1065     index xpk is primary unique handle-value
     1066     .
     1067   define temp-table temp-browse-handle no-undo
     1068     field browse-type   as character
     1069     field browse-number as integer
     1070     field browse-handle as handle
     1071     field original-size as decimal
     1072     index xpk is primary unique browse-type browse-number
     1073     index xie browse-type browse-handle
     1074   .
     1075   procedure diasize_change-height :
     1076     define input  parameter p-change-value  as decimal   no-undo .
     1077     define input  parameter p-move-resize   as logical   no-undo .
     1078     define variable v-field-group-handle    as handle    no-undo .
     1079     define variable v-object-handle         as handle    no-undo .
     1080     define variable v-frame-height          as decimal   no-undo .
     1081     define variable v-frame-virtual-height  as decimal   no-undo .
     1082     define variable v-browse-height         as decimal   no-undo .
     1083     define variable v-window-height         as decimal   no-undo .
     1084     define variable v-window-virtual-height as decimal   no-undo .
     1085     define variable v-change-sign           as integer   no-undo .
     1086     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1087     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1088     if p-change-value > 0
     1089     then do:
     1090       if frame Dialog-Frame :height + p-change-value
     1091           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1092       then do:
     1093         assign
     1094           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1095                           - (frame Dialog-Frame :height-chars)
     1096         .
     1097         if p-change-value <= 0
     1098         then do:
     1099           run diasize_position-resize-button in this-procedure .
     1100           return .
     1101         end.
     1102       end.
     1103     end.
     1104     if p-change-value < 0
     1105     then do:
     1106       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1107       then do:
     1108         assign
     1109           p-change-value = v-diasize-orig-frame-height
     1110                          - (frame Dialog-Frame :height-chars)
     1111         .
     1112         if p-change-value >= 0
     1113         then do:
     1114           run diasize_position-resize-button in this-procedure .
     1115           return .
     1116         end.
     1117       end.
     1118     end.
     1119     if p-change-value >= 0
     1120     then do:
     1121       assign
     1122         v-change-sign = 1
     1123       .
     1124     end.
     1125     else do:
     1126       assign
     1127         v-change-sign = -1
     1128       .
     1129     end.
     1130     assign
     1131       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1132     .
     1133     if p-change-value = 0
     1134     then do:
     1135       run diasize_position-resize-button in this-procedure .
     1136       return .
     1137     end.
     1138     move_block:
     1139     do
     1140     on error undo move_block, retry move_block
     1141     :
     1142       if retry
     1143       then do:
     1144         do
     1145         on error undo move_block, leave move_block
     1146         :
     1147           if p-change-value > 0
     1148           then do:
     1149             for each buf_temp-diasize-handle
     1150             on error undo, next
     1151             :
     1152               assign
     1153                 v-object-handle = buf_temp-diasize-handle.handle-value
     1154               .
     1155               if v-object-handle <> v-diasize-resize-button
     1156               then do:
     1157                 assign
     1158                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1159                 .
     1160               end.
     1161             end.
     1162             assign
     1163               v-diasize-browse-handle :height = v-browse-height
     1164             .
     1165             for each buf_temp-browse-handle
     1166               where buf_temp-browse-handle.browse-type = 'height':u
     1167             on error undo, next
     1168             :
     1169               assign
     1170                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1171               .
     1172             end.
     1173             assign
     1174               frame Dialog-Frame :height = v-frame-height
     1175             .
     1176             if frame Dialog-Frame :scrollable = true
     1177             then do:
     1178               assign
     1179                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1180               .
     1181             end.
     1182             run diasize_position-resize-button in this-procedure .
     1183           end.
     1184           else do:
     1185             if frame Dialog-Frame :scrollable = true
     1186             then do:
     1187               assign
     1188                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1189               .
     1190             end.
     1191             assign
     1192               frame Dialog-Frame :height = v-frame-height
     1193             .
     1194             assign
     1195               v-diasize-browse-handle :height = v-browse-height
     1196             .
     1197             for each buf_temp-browse-handle
     1198               where buf_temp-browse-handle.browse-type = 'height':u
     1199             on error undo, next
     1200             :
     1201               assign
     1202                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1203               .
     1204             end.
     1205             for each buf_temp-diasize-handle
     1206             on error undo, next
     1207             :
     1208               assign
     1209                 v-object-handle = buf_temp-diasize-handle.handle-value
     1210               .
     1211               if v-object-handle <> v-diasize-resize-button
     1212               then do:
     1213                 assign
     1214                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1215                 .
     1216               end.
     1217             end.
     1218             run diasize_position-resize-button in this-procedure .
     1219           end.
     1220           assign
     1221             v-diasize-change-size = false
     1222           .
     1223           leave move_block .
     1224         end.
     1225       end.
     1226       assign
     1227         v-diasize-need-full-display = true
     1228       .
     1229       if v-diasize-change-size = false
     1230       then do:
     1231         assign
     1232           v-diasize-change-size = true
     1233         .
     1234       end.
     1235       else do:
     1236         return .
     1237       end.
     1238       assign
     1239         v-frame-height = frame Dialog-Frame :height
     1240         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1241         v-browse-height = v-diasize-browse-handle :height
     1242       .
     1243       for each buf_temp-browse-handle
     1244         where buf_temp-browse-handle.browse-type = 'height':u
     1245       :
     1246         assign
     1247           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1248         .
     1249       end.
     1250       for each buf_temp-diasize-handle
     1251       :
     1252         delete buf_temp-diasize-handle .
     1253       end.
     1254       assign
     1255         v-field-group-handle = frame Dialog-Frame :first-child
     1256       .
     1257       do while valid-handle(v-field-group-handle)
     1258       :
     1259         assign
     1260           v-object-handle = v-field-group-handle :first-child
     1261         .
     1262         do while valid-handle(v-object-handle)
     1263         :
     1264           if  v-object-handle <> v-diasize-browse-handle :handle
     1265           and can-query(v-object-handle, "row")
     1266           and can-query(v-object-handle, "height")
     1267           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1268           then do:
     1269             find first buf_temp-browse-handle
     1270               where buf_temp-browse-handle.browse-type   = 'height':u
     1271                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1272               no-error .
     1273             if available buf_temp-browse-handle
     1274             then do:
     1275             end.
     1276             else do:
     1277               create buf_temp-diasize-handle .
     1278               assign
     1279                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1280                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1281               .
     1282             end.
     1283           end.
     1284           assign
     1285             v-object-handle = v-object-handle :next-sibling
     1286           .
     1287         end.
     1288         assign
     1289           v-field-group-handle = v-field-group-handle :next-sibling
     1290         .
     1291       end.
     1292       do with frame Dialog-Frame
     1293       :
     1294         hide v-diasize-resize-button .
     1295         assign
     1296           v-diasize-resize-button :row    = 1
     1297           v-diasize-resize-button :column = 1
     1298         .
     1299       end.
     1300       if p-change-value > 0
     1301       then do:
     1302         if frame Dialog-Frame :scrollable = true
     1303         then do:
     1304           assign
     1305             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1306             no-error .
     1307           if error-status :error
     1308           or error-status :get-message(1) <> ""
     1309           then do:
     1310             undo move_block, retry move_block .
     1311           end.
     1312         end.
     1313         assign
     1314           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1315           no-error .
     1316         if error-status :error
     1317         or error-status :get-message(1) <> ""
     1318         then do:
     1319           undo move_block, retry move_block .
     1320         end.
     1321         assign
     1322           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1323           no-error .
     1324         if error-status :error
     1325         or error-status :get-message(1) <> ""
     1326         then do:
     1327           undo move_block, retry move_block .
     1328         end.
     1329         for each buf_temp-browse-handle
     1330           where buf_temp-browse-handle.browse-type = 'height':u
     1331         on error undo move_block, retry move_block
     1332         :
     1333           assign
     1334             buf_temp-browse-handle.browse-handle :height
     1335               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1336             no-error .
     1337           if error-status :error
     1338           or error-status :get-message(1) <> ""
     1339           then do:
     1340             undo move_block, retry move_block .
     1341           end.
     1342         end.
     1343         for each buf_temp-diasize-handle
     1344         on error undo move_block, retry move_block
     1345         :
     1346           assign
     1347             v-object-handle = buf_temp-diasize-handle.handle-value
     1348           .
     1349           if v-object-handle <> v-diasize-resize-button
     1350           then do:
     1351             assign
     1352               v-object-handle :row = v-object-handle :row + p-change-value
     1353               no-error .
     1354             if error-status :error
     1355             or error-status :get-message(1) <> ""
     1356             then do:
     1357               undo move_block, retry move_block .
     1358             end.
     1359           end.
     1360         end.
     1361       end.
     1362       else do:
     1363         for each buf_temp-diasize-handle
     1364         on error undo move_block, retry move_block
     1365         :
     1366           assign
     1367             v-object-handle = buf_temp-diasize-handle.handle-value
     1368           .
     1369           if v-object-handle <> v-diasize-resize-button
     1370           then do:
     1371             assign
     1372               v-object-handle :row = v-object-handle :row + p-change-value
     1373               no-error .
     1374             if error-status :error
     1375             or error-status :get-message(1) <> ""
     1376             then do:
     1377               undo move_block, retry move_block .
     1378             end.
     1379           end.
     1380         end.
     1381         assign
     1382           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1383           no-error .
     1384         if error-status :error
     1385         or error-status :get-message(1) <> ""
     1386         then do:
     1387           undo move_block, retry move_block .
     1388         end.
     1389         for each buf_temp-browse-handle
     1390           where buf_temp-browse-handle.browse-type = 'height':u
     1391         on error undo move_block, retry move_block
     1392         :
     1393           assign
     1394             buf_temp-browse-handle.browse-handle :height
     1395               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1396             no-error .
     1397           if error-status :error
     1398           or error-status :get-message(1) <> ""
     1399           then do:
     1400             undo move_block, retry move_block .
     1401           end.
     1402         end.
     1403         assign
     1404           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1405           no-error .
     1406         if error-status :error
     1407         or error-status :get-message(1) <> ""
     1408         then do:
     1409           undo move_block, retry move_block .
     1410         end.
     1411         if frame Dialog-Frame :scrollable = true
     1412         then do:
     1413           assign
     1414             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1415             no-error .
     1416           if error-status :error
     1417           or error-status :get-message(1) <> ""
     1418           then do:
     1419             undo move_block, retry move_block .
     1420           end.
     1421         end.
     1422       end.
     1423       if p-move-resize = true
     1424       then do:
     1425         run diasize_position-resize-button in this-procedure .
     1426       end.
     1427       if v-diasize-wndstore = true
     1428       then do:
     1429         if connected("ub") = true
     1430         then do:
     1431           define variable v-cntxt-db-num        as integer   no-undo .
     1432           define variable v-cntxt-userid        as character no-undo .
     1433           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1434                                             , OUTPUT v-cntxt-userid
     1435                                             ) .
     1436           run gbl/wndsizew.p
     1437             (input  v-cntxt-db-num
     1438             ,input  v-cntxt-userid
     1439             ,input  v-diasize-proc-name
     1440             ,input  'height':u
     1441             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1442             ) .
     1443         end.
     1444       end.
     1445     end.
     1446     assign
     1447       v-diasize-change-size = false
     1448     .
     1449   end procedure.
     1450   procedure diasize_set-height :
     1451     define input  parameter p-new-height  as decimal   no-undo .
     1452     define input  parameter p-move-resize as logical   no-undo .
     1453     do
     1454     on error undo, return error return-value
     1455     :
     1456       run diasize_change-height in this-procedure
     1457         (input  (p-new-height - frame Dialog-Frame :height)
     1458         ,input  p-move-resize
     1459         ) .
     1460     end.
     1461   end procedure.
     1462   procedure diasize_change-width :
     1463     define input  parameter p-change-value as decimal   no-undo .
     1464     define input  parameter p-move-resize  as logical   no-undo .
     1465     define variable v-field-group-handle   as handle    no-undo .
     1466     define variable v-object-handle        as handle    no-undo .
     1467     define variable v-frame-width          as decimal   no-undo .
     1468     define variable v-frame-virtual-width  as decimal   no-undo .
     1469     define variable v-browse-width         as decimal   no-undo .
     1470     define variable v-window-width         as decimal   no-undo .
     1471     define variable v-window-virtual-width as decimal   no-undo .
     1472     define variable v-change-sign          as integer   no-undo .
     1473     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1474     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1475     if p-change-value > 0
     1476     then do:
     1477       if frame Dialog-Frame :width + p-change-value >
     1478           session :width-chars
     1479       then do:
     1480         assign
     1481           p-change-value = session :width-chars - frame Dialog-Frame :width
     1482         .
     1483         if p-change-value <= 0
     1484         then do:
     1485           run diasize_position-resize-button in this-procedure .
     1486           return .
     1487         end.
     1488       end.
     1489     end.
     1490     if p-change-value < 0
     1491     then do:
     1492       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1493       then do:
     1494         assign
     1495           p-change-value = v-diasize-orig-frame-width
     1496                          - frame Dialog-Frame :width
     1497         .
     1498         if p-change-value >= 0
     1499         then do:
     1500           run diasize_position-resize-button in this-procedure .
     1501           return .
     1502         end.
     1503       end.
     1504     end.
     1505     if p-change-value >= 0
     1506     then do:
     1507       assign
     1508         v-change-sign = 1
     1509       .
     1510     end.
     1511     else do:
     1512       assign
     1513         v-change-sign = -1
     1514       .
     1515     end.
     1516     assign
     1517       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1518     .
     1519     if p-change-value = 0
     1520     then do:
     1521       run diasize_position-resize-button in this-procedure .
     1522       return .
     1523     end.
     1524     move_block:
     1525     do
     1526     on error undo move_block, leave move_block
     1527     :
     1528       if retry
     1529       then do:
     1530         do
     1531         on error undo move_block, leave move_block
     1532         :
     1533           if p-change-value > 0
     1534           then do:
     1535             for each buf_temp-diasize-handle
     1536             on error undo, next
     1537             :
     1538               assign
     1539                 v-object-handle = buf_temp-diasize-handle.handle-value
     1540               .
     1541               if v-object-handle <> v-diasize-resize-button
     1542               then do:
     1543                 assign
     1544                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1545                 .
     1546               end.
     1547             end.
     1548             assign
     1549               v-diasize-browse-handle :width = v-browse-width
     1550             .
     1551             for each buf_temp-browse-handle
     1552               where buf_temp-browse-handle.browse-type = 'width':u
     1553             on error undo, next
     1554             :
     1555               assign
     1556                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1557               .
     1558             end.
     1559             assign
     1560               frame Dialog-Frame :width = v-frame-width
     1561             .
     1562             if frame Dialog-Frame :scrollable = true
     1563             then do:
     1564               assign
     1565                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1566               .
     1567             end.
     1568             run diasize_position-resize-button in this-procedure .
     1569           end.
     1570           else do:
     1571             if frame Dialog-Frame :scrollable = true
     1572             then do:
     1573               assign
     1574                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1575               .
     1576             end.
     1577             assign
     1578               frame Dialog-Frame :width = v-frame-width
     1579             .
     1580             for each buf_temp-browse-handle
     1581               where buf_temp-browse-handle.browse-type = 'width':u
     1582             on error undo, next
     1583             :
     1584               assign
     1585                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1586               .
     1587             end.
     1588             assign
     1589               v-diasize-browse-handle :width = v-browse-width
     1590             .
     1591             for each buf_temp-diasize-handle
     1592             on error undo, next
     1593             :
     1594               assign
     1595                 v-object-handle = buf_temp-diasize-handle.handle-value
     1596               .
     1597               if v-object-handle <> v-diasize-resize-button
     1598               then do:
     1599                 assign
     1600                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1601                 .
     1602               end.
     1603             end.
     1604             run diasize_position-resize-button in this-procedure .
     1605           end.
     1606           assign
     1607             v-diasize-change-size = false
     1608           .
     1609           leave move_block .
     1610         end.
     1611       end.
     1612       assign
     1613         v-diasize-need-full-display = true
     1614       .
     1615       if v-diasize-change-size = false
     1616       then do:
     1617         assign
     1618           v-diasize-change-size = true
     1619         .
     1620       end.
     1621       else do:
     1622         return .
     1623       end.
     1624       assign
     1625         v-frame-width = frame Dialog-Frame :width
     1626         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1627         v-browse-width = v-diasize-browse-handle :width
     1628       .
     1629       for each buf_temp-browse-handle
     1630         where buf_temp-browse-handle.browse-type = 'width':u
     1631       :
     1632         assign
     1633           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1634         .
     1635       end.
     1636       for each buf_temp-diasize-handle
     1637       :
     1638         delete buf_temp-diasize-handle .
     1639       end.
     1640       assign
     1641         v-field-group-handle = frame Dialog-Frame :first-child
     1642       .
     1643       do while valid-handle(v-field-group-handle)
     1644       :
     1645         assign
     1646           v-object-handle = v-field-group-handle :first-child
     1647         .
     1648         do while valid-handle(v-object-handle)
     1649         :
     1650           if  v-object-handle <> v-diasize-browse-handle :handle
     1651           and v-object-handle <> v-diasize-resize-button
     1652           and can-query(v-object-handle, "row")
     1653           and can-query(v-object-handle, "height")
     1654           and ( v-object-handle :col + v-object-handle :width
     1655                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1656               )
     1657           then do:
     1658             find first buf_temp-browse-handle
     1659               where buf_temp-browse-handle.browse-type   = 'width':u
     1660                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1661               no-error .
     1662             if available buf_temp-browse-handle
     1663             then do:
     1664             end.
     1665             else do:
     1666               create buf_temp-diasize-handle .
     1667               assign
     1668                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1669                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1670               .
     1671             end.
     1672           end.
     1673           assign
     1674             v-object-handle = v-object-handle :next-sibling
     1675           .
     1676         end.
     1677         assign
     1678           v-field-group-handle = v-field-group-handle :next-sibling
     1679         .
     1680       end.
     1681       do with frame Dialog-Frame
     1682       :
     1683         hide v-diasize-resize-button .
     1684         v-diasize-resize-button :row = 1.
     1685         v-diasize-resize-button :column = 1.
     1686       end.
     1687       if p-change-value > 0
     1688       then do:
     1689         if frame Dialog-Frame :scrollable = true
     1690         then do:
     1691           assign
     1692             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1693             no-error .
     1694           if error-status :error
     1695           or error-status :get-message(1) <> ""
     1696           then do:
     1697             undo move_block, retry move_block.
     1698           end.
     1699         end.
     1700         assign
     1701           frame Dialog-Frame :width = v-frame-width + p-change-value
     1702           no-error .
     1703         if error-status :error
     1704         or error-status :get-message(1) <> ""
     1705         then do:
     1706           undo move_block, retry move_block.
     1707         end.
     1708         assign
     1709           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1710         no-error .
     1711         if error-status :error
     1712         or error-status :get-message(1) <> ""
     1713         then do:
     1714           undo move_block, retry move_block.
     1715         end.
     1716         for each buf_temp-browse-handle
     1717           where buf_temp-browse-handle.browse-type = 'width':u
     1718         on error undo move_block, retry move_block
     1719         :
     1720           assign
     1721             buf_temp-browse-handle.browse-handle :width
     1722               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1723             no-error .
     1724           if error-status :error
     1725           or error-status :get-message(1) <> ""
     1726           then do:
     1727             undo move_block, retry move_block .
     1728           end.
     1729         end.
     1730         for each buf_temp-diasize-handle
     1731         on error undo move_block, retry move_block
     1732         :
     1733           assign
     1734             v-object-handle = buf_temp-diasize-handle.handle-value
     1735           .
     1736           if v-object-handle <> v-diasize-resize-button
     1737           then do:
     1738             assign
     1739               v-object-handle :col = v-object-handle :col + p-change-value
     1740               no-error .
     1741             if error-status :error
     1742             or error-status :get-message(1) <> ""
     1743             then do:
     1744               undo move_block, retry move_block .
     1745             end.
     1746           end.
     1747         end.
     1748       end.
     1749       else do:
     1750         for each buf_temp-diasize-handle
     1751         on error undo move_block, retry move_block
     1752         :
     1753           assign
     1754             v-object-handle = buf_temp-diasize-handle.handle-value
     1755           .
     1756           if v-object-handle <> v-diasize-resize-button
     1757           then do:
     1758             assign
     1759               v-object-handle :col = v-object-handle :col + p-change-value
     1760               no-error .
     1761             if error-status :error
     1762             or error-status :get-message(1) <> ""
     1763             then do:
     1764               undo move_block, retry move_block .
     1765             end.
     1766           end.
     1767         end.
     1768         for each buf_temp-browse-handle
     1769           where buf_temp-browse-handle.browse-type = 'width':u
     1770         on error undo move_block, retry move_block
     1771         :
     1772           assign
     1773             buf_temp-browse-handle.browse-handle :width
     1774               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1775             no-error .
     1776           if error-status :error
     1777           or error-status :get-message(1) <> ""
     1778           then do:
     1779             undo move_block, retry move_block .
     1780           end.
     1781         end.
     1782         assign
     1783           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1784           no-error .
     1785         if error-status :error
     1786         or error-status :get-message(1) <> ""
     1787         then do:
     1788           undo move_block, retry move_block.
     1789         end.
     1790         assign
     1791           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1792         no-error .
     1793         if error-status :error
     1794         or error-status :get-message(1) <> ""
     1795         then do:
     1796           undo move_block, retry move_block.
     1797         end.
     1798         if frame Dialog-Frame :scrollable = true
     1799         then do:
     1800           assign
     1801             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1802           no-error .
     1803           if error-status :error
     1804           or error-status :get-message(1) <> ""
     1805           then do:
     1806             undo move_block, retry move_block.
     1807           end.
     1808         end.
     1809       end.
     1810       if p-move-resize
     1811       then do:
     1812         run diasize_position-resize-button in this-procedure .
     1813       end.
     1814       if v-diasize-wndstore = true
     1815       then do:
     1816         if connected("ub") = true
     1817         then do:
     1818           define variable v-cntxt-db-num        as integer   no-undo .
     1819           define variable v-cntxt-userid        as character no-undo .
     1820           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1821                                             , OUTPUT v-cntxt-userid
     1822                                             ) .
     1823           run gbl/wndsizew.p
     1824             (input  v-cntxt-db-num
     1825             ,input  v-cntxt-userid
     1826             ,input  v-diasize-proc-name
     1827             ,input  'width':u
     1828             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1829             ) .
     1830         end.
     1831       end.
     1832     end.
     1833     assign
     1834       v-diasize-change-size = false
     1835     .
     1836   end procedure.
     1837   procedure diasize_set-width :
     1838     define input  parameter p-new-width  as decimal   no-undo .
     1839     define input  parameter p-move-resize as logical   no-undo .
     1840     do
     1841     on error undo, return error return-value
     1842     :
     1843       run diasize_change-width in this-procedure
     1844         (input  (p-new-width - frame Dialog-Frame :width)
     1845         ,input  p-move-resize
     1846         ) .
     1847     end.
     1848   end procedure.
     1849   procedure diasize_position-resize-button :
     1850     do with frame Dialog-Frame
     1851     :
     1852       hide v-diasize-resize-button .
     1853       assign
     1854         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1855                     - 1
     1856                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1857         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1858                     - 1
     1859                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1860       .
     1861       view v-diasize-resize-button .
     1862     end.
     1863   end procedure.
     1864   on alt-right anywhere
     1865   do:
     1866     run diasize_change-width in this-procedure
     1867       (input 1
     1868       ,input true
     1869       ) .
     1870     return no-apply .
     1871   end.
     1872   on alt-left anywhere
     1873   do:
     1874     run diasize_change-width in this-procedure
     1875       (input -1
     1876       ,input true
     1877       ) .
     1878     return no-apply .
     1879   end.
     1880   on alt-down anywhere
     1881   do:
     1882     run diasize_change-height in this-procedure
     1883       (input 1
     1884       ,input true
     1885       ) .
     1886     return no-apply .
     1887   end.
     1888   on alt-up anywhere
     1889   do:
     1890     run diasize_change-height in this-procedure
     1891       (input -1
     1892       ,input true
     1893       ) .
     1894     return no-apply .
     1895   end.
     1896   on alt-enter of frame Dialog-Frame
     1897   do:
     1898     run diasize_maximize in this-procedure
     1899       (input  ?
     1900       ).
     1901     return no-apply .
     1902   end.
     1903   procedure diasize_end-move :
     1904     do
     1905     on error undo, return error return-value
     1906     :
     1907       define variable v-row-delta as decimal   no-undo .
     1908       define variable v-col-delta as decimal   no-undo .
     1909       define variable v-new-row as decimal   no-undo .
     1910       define variable v-new-col as decimal   no-undo .
     1911       assign
     1912         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1913         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1914       .
     1915       assign
     1916         v-row-delta = v-new-row - frame Dialog-Frame :height
     1917         v-col-delta = v-new-col - frame Dialog-Frame :width
     1918       .
     1919       run diasize_change-height in this-procedure
     1920         (input v-row-delta
     1921         ,input true
     1922         ) .
     1923       run diasize_change-width in this-procedure
     1924         (input v-col-delta
     1925         ,input true
     1926         ) .
     1927     end.
     1928   end procedure.
     1929   procedure diasize_maximize :
     1930     define input  parameter p-action as logical   no-undo .
     1931     do
     1932     on error undo, return error return-value
     1933     :
     1934       if p-action = ?
     1935       then do:
     1936         if v-diasize-need-maximize = true
     1937         then do:
     1938           assign
     1939             p-action = true
     1940           .
     1941         end.
     1942         else do:
     1943           assign
     1944             p-action = false
     1945           .
     1946         end.
     1947       end.
     1948       if p-action = true
     1949       then do:
     1950         run diasize_change-height in this-procedure
     1951           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1952               - frame Dialog-Frame :height-chars
     1953           ,input true
     1954           ) .
     1955         run diasize_change-width in this-procedure
     1956           (input session :width-chars
     1957               - frame Dialog-Frame :width-chars
     1958           ,input true
     1959           ) .
     1960         assign
     1961           v-diasize-need-maximize = false
     1962         .
     1963       end.
     1964       else do:
     1965         run diasize_change-width in this-procedure
     1966           (input v-diasize-orig-frame-width
     1967               - frame Dialog-Frame :width-chars
     1968           ,input true
     1969           ) .
     1970         run diasize_change-height in this-procedure
     1971           (input v-diasize-orig-frame-height
     1972               - frame Dialog-Frame :height-chars
     1973           ,input true
     1974           ) .
     1975         assign
     1976           v-diasize-need-maximize = true
     1977         .
     1978       end.
     1979     end.
     1980   end procedure.
     1981   procedure diasize_restore-orig-size :
     1982     do
     1983     on error undo, return error return-value
     1984     :
     1985       assign
     1986         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1987         v-diasize-current-frame-height = frame Dialog-Frame :height
     1988       .
     1989       run diasize_set-height in this-procedure
     1990         (input  v-diasize-orig-frame-height
     1991         ,input  true
     1992         ) .
     1993       run diasize_set-width in this-procedure
     1994         (input  v-diasize-orig-frame-width
     1995         ,input  true
     1996         ) .
     1997     end.
     1998   end procedure.
     1999   procedure diasize_restore-current-size :
     2000     do
     2001     on error undo, return error return-value
     2002     :
     2003       run diasize_set-height in this-procedure
     2004         (input  v-diasize-current-frame-height
     2005         ,input  true
     2006         ) .
     2007       run diasize_set-width in this-procedure
     2008         (input  v-diasize-current-frame-width
     2009         ,input  true
     2010         ) .
     2011     end.
     2012   end procedure.
     2013   procedure diasize_set-browse-handle :
     2014     define input  parameter p-browse-handle as handle   no-undo .
     2015     define buffer buf_temp-browse-handle for temp-browse-handle .
     2016     do
     2017     on error undo, return error return-value
     2018     :
     2019       assign
     2020         v-diasize-browse-handle = p-browse-handle
     2021       .
     2022       for each buf_temp-browse-handle
     2023       on error undo, return error return-value
     2024       :
     2025         delete buf_temp-browse-handle .
     2026       end.
     2027     end.
     2028   end procedure.
     2029   procedure diasize_add_browse :
     2030     define input  parameter p-browse-type   as character no-undo .
     2031     define input  parameter p-browse-handle as handle    no-undo .
     2032     define buffer buf_temp-browse-handle for temp-browse-handle .
     2033     do
     2034     on error undo, return error return-value
     2035     :
     2036       assign
     2037         v-diasize-browse-number = v-diasize-browse-number + 1
     2038       .
     2039       create buf_temp-browse-handle .
     2040       assign
     2041         buf_temp-browse-handle.browse-type   = p-browse-type
     2042         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2043         buf_temp-browse-handle.browse-handle = p-browse-handle
     2044       .
     2045     end.
     2046   end procedure.
     2047   procedure diasize_init :
     2048     define variable v-default-value    as logical   no-undo .
     2049     define variable v-restore-saved    as logical   no-undo .
     2050     define variable v-resize-value-str as character no-undo .
     2051     do
     2052     on error undo, return error return-value
     2053     :
     2054       do with frame Dialog-Frame
     2055       :
     2056         assign
     2057           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2058           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2059           v-diasize-browse-handle     = browse BR-stop-list :handle
     2060         .
     2061         create button v-diasize-resize-button
     2062         assign
     2063           parent        = frame Dialog-Frame :first-child
     2064           label         = "s"
     2065           height-pixels = 16
     2066           width-pixels  = 16
     2067           visible       = true
     2068           sensitive     = true
     2069           movable       = true
     2070           triggers:
     2071             on end-move persistent run diasize_end-move in this-procedure .
     2072           end triggers.
     2073         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2074         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2075         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2076         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2077         assign
     2078           v-diasize-wndmax = false
     2079         .
     2080         if connected("ub") = true
     2081         then do:
     2082           define variable v-cntxt-db-num        as integer   no-undo .
     2083           define variable v-cntxt-userid        as character no-undo .
     2084           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2085                                             , OUTPUT v-cntxt-userid
     2086                                             ) .
     2087           run gbl/wndpar_r.p
     2088             (input  v-cntxt-db-num
     2089             ,input  v-cntxt-userid
     2090             ,input  'wndmax':U
     2091             ,output v-diasize-wndmax
     2092             ,output v-default-value
     2093             ) .
     2094         end.
     2095         assign
     2096           v-diasize-wndstore = false
     2097         .
     2098         if connected("ub") = true
     2099         then do:
     2100           run gbl/wndpar_r.p
     2101             (input  v-cntxt-db-num
     2102             ,input  v-cntxt-userid
     2103             ,input  'wndstore':U
     2104             ,output v-diasize-wndstore
     2105             ,output v-default-value
     2106             ) .
     2107         end.
     2108         assign
     2109           v-diasize-proc-name = entry(1, program-name(2), '.')
     2110         .
     2111         if v-diasize-wndstore = true
     2112         then do:
     2113           assign
     2114             v-restore-saved = false
     2115           .
     2116           if connected("ub") = true
     2117           then do:
     2118             run gbl/wndsizer.p
     2119               (input  v-cntxt-db-num
     2120               ,input  v-cntxt-userid
     2121               ,input  v-diasize-proc-name
     2122               ,input  'height':u
     2123               ,output v-resize-value-str
     2124               ) .
     2125             if v-resize-value-str <> '':U
     2126             then do:
     2127               run diasize_change-height in this-procedure
     2128                 (input  integer(v-resize-value-str)
     2129                 ,input  true
     2130                 ) .
     2131               assign
     2132                 v-restore-saved = true
     2133               .
     2134             end.
     2135           end.
     2136           if connected("ub") = true
     2137           then do:
     2138             run gbl/wndsizer.p
     2139               (input  v-cntxt-db-num
     2140               ,input  v-cntxt-userid
     2141               ,input  v-diasize-proc-name
     2142               ,input  'width':u
     2143               ,output v-resize-value-str
     2144               ) .
     2145             if v-resize-value-str <> '':U
     2146             then do:
     2147               run diasize_change-width in this-procedure
     2148                 (input  integer(v-resize-value-str)
     2149                 ,input  true
     2150                 ) .
     2151               assign
     2152                 v-restore-saved = true
     2153               .
     2154             end.
     2155           end.
     2156           if v-restore-saved <> true
     2157           then do:
     2158             if v-diasize-wndmax = true
     2159             then do:
     2160               run diasize_maximize in this-procedure
     2161                 (input  true
     2162                 ) .
     2163             end.
     2164           end.
     2165         end.
     2166         else do:
     2167           if v-diasize-wndmax = true
     2168           then do:
     2169             run diasize_maximize in this-procedure
     2170               (input  true
     2171               ) .
     2172           end.
     2173         end.
     2174       end.
     2175     end.
     2176   end procedure.
     2177   procedure diasize_need-full-display :
     2178     define output parameter p-need-full-display as logical   no-undo .
     2179     do
     2180     on error undo, return error return-value
     2181     :
     2182       assign
     2183         p-need-full-display = v-diasize-need-full-display
     2184       .
     2185       assign
     2186         v-diasize-need-full-display = false
     2187       .
     2188     end.
     2189   end procedure.
     2190   procedure get-context :
     2191      define output parameter p-db-num as integer          no-undo.
     2192      define output parameter p-user-id as character        no-undo.
     2193      define variable v-login               as character    no-undo.
     2194      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2195      define buffer buf_user-login  for ub.user-login .
     2196      do
     2197      on error undo, return error
     2198      :
     2199            FIND FIRST buf_sys-ctrl no-lock.
     2200            ASSIGN
     2201               v-login = USERID("ub")
     2202               p-db-num = buf_sys-ctrl.db-num
     2203            .
     2204            FIND FIRST buf_user-login
     2205                 WHERE buf_user-login.db-num = p-db-num
     2206                   AND buf_user-login.user-login = v-login
     2207                 no-lock
     2208                 no-error
     2209                 .
     2210            IF AVAILABLE buf_user-login
     2211            THEN DO:
     2212               assign
     2213                  p-user-id = buf_user-login.user-id
     2214               .
     2215            END.
     2216      end.
     2217   end procedure.
     2218       run diasize_init in this-procedure .
     2219   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2220   do:
     2221     BR-stop-list :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2222   end.
     2223   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2224   on INS of frame Dialog-Frame anywhere do:
     2225     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2226     return no-apply.
     2227   end.
     2228   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2229   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     2230     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     2231     return no-apply.
     2232   end.
     2233   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2234   on F3 of frame Dialog-Frame anywhere do:
     2235     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     2236     return no-apply.
     2237   end.
     2238   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2239   on F2 of frame Dialog-Frame anywhere do:
     2240     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2241     return no-apply.
     2242   end.
     2243   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2244   on F2 of frame Dialog-Frame anywhere do:
     2245     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2246     return no-apply.
     2247   end.
     2248   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2249   on ALT-F8 of frame Dialog-Frame anywhere do:
     2250     if b-history :sensitive then DO: apply "CHOOSE":U to b-history in frame Dialog-Frame. END.
     2251     return no-apply.
     2252   end.
     2253   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2254   procedure set-filter-name :
     2255   define input parameter p-filter-name as character no-undo .
     2256     do with frame Dialog-Frame:
     2257       if p-filter-name > "" then do:
     2258         assign
     2259           frame Dialog-Frame:title
     2260             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2261         .
     2262         assign
     2263           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2264         .
     2265       end.
     2266       else do:
     2267         assign
     2268           b-sch :tooltip = ""
     2269         .
     2270       end.
     2271     end.
     2272   end procedure.
     2273   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2274   on f5 of frame Dialog-Frame anywhere
     2275   do:
     2276      v-doc-rec = ?. if available X_stop-list then v-doc-rec = recid(X_stop-list).                run openbr in this-procedure ( input yes, input no, input '':U) no-error.                REPOSITION br-stop-list to recid v-doc-rec No-ERROR.
     2277       apply "VALUE-CHANGED" to BR-stop-list.
     2278   end.
     2279   MAIN-BLOCK:
     2280   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2281      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2282   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2283     run mainmenu_getcntxt in parparentproc
     2284       (output v-cntxt-db-num
     2285       ,output v-cntxt-userid
     2286       ,output v-cntxt-level
     2287       ,output v-cntxt-host-code-obj
     2288       ,output v-cntxt-obj-type
     2289       ,output v-cntxt-obj-code
     2290       ,output v-cntxt-db-num-obj
     2291       ,output v-cntxt-is-admin
     2292       ) .
     2293     ASSIGN
     2294     v-rid-list = p-rid-list.
     2295     RUN Myenable IN THIS-PROCEDURE NO-ERROR.
     2296     IF v-rid-list <> '':U THEN DO:
     2297       REPOSITION br-stop-list to RECID INTEGER(entry(1, v-rid-list)) NO-ERROR.
     2298       APPLY "entry" to br-stop-list.
     2299       APPLY "value-changed" TO br-stop-list.
     2300     END.
     2301     WAIT-FOR GO OF FRAME Dialog-Frame.
     2302   END.
     2303   RUN disable_UI.
     2304   PROCEDURE disable_UI :
     2305     HIDE FRAME Dialog-Frame.
     2306   END PROCEDURE.
     2307   PROCEDURE enable_UI :
     2308     DISPLAY mark-num
     2309         WITH FRAME Dialog-Frame.
     2310     ENABLE b-quit B-mark B-sel b-add b-chg b-del b-lkp b-history b-sch B-Help
     2311            b-close b-cd BR-stop-list mark-num
     2312         WITH FRAME Dialog-Frame.
     2313     VIEW FRAME Dialog-Frame.
     2314     OPEN QUERY BR-stop-list FOR EACH X_stop-list NO-LOCK WHERE        X_stop-list.classif-type = 'dis-card':U      INDEXED-REPOSITION.
     2315   END PROCEDURE.
     2316   PROCEDURE MyEnable :
     2317   ASSIGN
     2318   b-add:MENU-MOUSE  IN FRAME Dialog-Frame = 1
     2319   b-chg:MENU-MOUSE  IN FRAME Dialog-Frame = 1
     2320   .
     2321   ENABLE
     2322   b-quit
     2323   B-mark  when lookup("b-mark", bttns) > 0
     2324   B-sel when lookup("b-sel", bttns) > 0
     2325   b-add when lookup("b-add", bttns) > 0 AND v-cntxt-db-num = 0 AND NOT TRANSACTION
     2326   b-chg when lookup("b-add", bttns) > 0 AND v-cntxt-db-num = 0 AND NOT TRANSACTION
     2327   b-del when lookup("b-add", bttns) > 0 AND v-cntxt-db-num = 0 AND NOT TRANSACTION
     2328   b-close when lookup("b-add", bttns) > 0 AND v-cntxt-db-num = 0 AND NOT TRANSACTION
     2329   b-cd
     2330   b-lkp
     2331   b-history
     2332   b-sch
     2333   B-Help
     2334   BR-stop-list
     2335   WITH FRAME Dialog-Frame .
     2336   VIEW FRAME Dialog-Frame .
     2337   run openbr in this-procedure ( input yes, input no, input '':U).
     2338   END PROCEDURE.
     2339   PROCEDURE OpenBr :
     2340   define input  parameter p-open-query     as logical   no-undo .
     2341   define input  parameter p-find-next      as logical   no-undo .
     2342   define input  parameter p-find-condition as character no-undo .
     2343   define variable l-query-was-opened as logical no-undo .
     2344   run waitfram-show in this-procedure ( input "Ждите...").
     2345   define variable sort-column-phrase as character no-undo .
     2346   case sort-column-name :
     2347     when "" then do:
     2348       assign
     2349         sort-column-phrase = ""
     2350       .
     2351     end.
     2352     otherwise do:
     2353       assign
     2354         sort-column-phrase = "by " + sort-column-name
     2355       .
     2356     end.
     2357   end case.
     2358    CASE p-list-mode:
     2359      WHEN 'все':U THEN DO:
     2360       ASSIGN
     2361       FRAME Dialog-Frame:TITLE = substitute("СТОПЛИСТЫ ПО ДК")
     2362         filter-label = filter-label0
     2363         filter-point = filter-point0
     2364         .
     2365         if sort-column-name = '':u then do:
     2366   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2367   define variable  l-disable-where-25  as logical   no-undo .
     2368   define variable  l-filter-open-25    as logical   .
     2369   define variable  flt-rec-25       as recid     no-undo .
     2370   define variable  filter-name-25      as character no-undo .
     2371   define variable  where-phrase-25     as character no-undo .
     2372   define variable  sort-phrase-25      as character no-undo .
     2373   define variable  where-phrase-rus-25 as character no-undo .
     2374   define variable  sort-phrase-rus-25  as character no-undo .
     2375     run waitfram-show in this-procedure
     2376       (input "ЖДИТЕ ..."
     2377       ).
     2378   run gbl/flt-get.p
     2379     (input filter-point
     2380     ,output flt-rec-25
     2381     ,output filter-name-25
     2382     ,output where-phrase-25
     2383     ,output sort-phrase-25
     2384     ,output where-phrase-rus-25
     2385     ,output sort-phrase-rus-25
     2386     ).
     2387   if p-open-query then do:
     2388       run set-filter-name in this-procedure
     2389         (INPUT filter-name-25
     2390         ) no-error .
     2391     assign
     2392       l-filter-open-25 = false
     2393     .
     2394     if flt-rec-25 <> ?
     2395       or sort-column-phrase > ""
     2396     then do:
     2397       define variable  parameter-2-25 as character no-undo .
     2398       define variable  parameter-3-25 as character no-undo .
     2399       define variable  parameter-4-25 as character no-undo .
     2400       define variable  parameter-5-25 as character no-undo .
     2401       define variable  parameter-6-25 as character no-undo .
     2402       define variable  parameter-7-25 as character no-undo .
     2403         assign
     2404         parameter-3-25 =
     2405                                 "FOR EACH X_stop-list"
     2406         parameter-4-25 =
     2407           (
     2408             if (" X_stop-list.classif-type = 'dis-card':U                           " + " " + where-phrase-25) <> ""
     2409             then  substitute('X_stop-list.classif-type = &1&2&1', chr(34), 'dis-card':U)   + " " + where-phrase-25
     2410             else "true"
     2411           )
     2412         parameter-5-25 = (" " + "" + " " + "")
     2413         parameter-6-25 = if sort-phrase-25 = ''
     2414                              then
     2415           (
     2416           " " + "  " +
     2417             " " + sort-column-phrase +
     2418           " " + " by X_stop-list.stop-list-code descending"
     2419           )
     2420                              else
     2421           (
     2422           " " + "  " +
     2423             " " + sort-column-phrase +
     2424           " " + sort-phrase-25
     2425           )
     2426         parameter-7-25 =
     2427           " indexed-reposition  "
     2428       .
     2429       do
     2430       on stop undo, leave
     2431       on error undo, leave
     2432       :
     2433         assign
     2434           l-disable-where-25 =
     2435             (" X_stop-list.classif-type = 'dis-card':U                           " + " " + where-phrase-25 = "")
     2436         .
     2437         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2438                             ,input QUERY br-stop-list:handle
     2439                             ,input parameter-3-25
     2440                             ,input parameter-4-25
     2441                             ,input parameter-5-25
     2442                             ,input parameter-6-25
     2443                             ,input parameter-7-25
     2444                             )
     2445         .
     2446         assign
     2447           l-filter-open-25 = true
     2448         .
     2449       end.
     2450       if l-filter-open-25 = false then do:
     2451         message
     2452           "Ошибка при фильтрации / сортировке" skip
     2453           "Будут показаны записи без учета фильтра" skip
     2454           view-as alert-box .
     2455       end.
     2456       else do:
     2457           assign
     2458             l-query-was-opened = true
     2459           .
     2460       end.
     2461     end.
     2462     if l-filter-open-25 = false then do:
     2463       OPEN QUERY br-stop-list FOR EACH X_stop-list
     2464         where  X_stop-list.classif-type = 'dis-card':U
     2465          by X_stop-list.stop-list-code descending
     2466         indexed-reposition
     2467     .
     2468         assign
     2469           l-query-was-opened = true
     2470         .
     2471     end.
     2472   end.
     2473   else do:
     2474     assign
     2475       v-doc-rec = recid( X_stop-list )
     2476     .
     2477     do
     2478     on stop undo, leave
     2479     on error undo, leave
     2480     :
     2481       if QUERY br-stop-list:handle:get-buffer-handle(1) = (buffer X_stop-list:handle) then do:
     2482         assign
     2483         parameter-2-25 = (if p-find-next then "true":u else "false":u )
     2484         parameter-4-25 =
     2485           "where ":u +  substitute('X_stop-list.classif-type = &1&2&1', chr(34), 'dis-card':U)   + " ":u + where-phrase-25 + " ":u + p-find-condition + " " + ""
     2486         parameter-5-25 = "  "
     2487       .
     2488         run fltopend_fltfindd in this-procedure  (
     2489                             input this-procedure:handle
     2490                             ,input QUERY br-stop-list:handle
     2491                             ,input rowid(X_stop-list)
     2492                             ,input logical(parameter-2-25)
     2493                             ,input no-lock
     2494                             ,input (buffer X_stop-list:handle)
     2495                             ,input parameter-4-25
     2496                             ,input parameter-5-25
     2497                             ) no-error.
     2498         .
     2499         assign
     2500           v-doc-rec = integer(return-value)
     2501           v-fltopend-rowid[1] = ?
     2502         .
     2503       end.
     2504       else do:
     2505         assign
     2506         parameter-2-25 = (if p-find-next then "true":u else "false":u )
     2507         parameter-3-25 =  "FOR EACH X_stop-list"
     2508         parameter-4-25 =
     2509           (
     2510             if (" X_stop-list.classif-type = 'dis-card':U                           " + " " + where-phrase-25) <> ""
     2511             then  substitute('X_stop-list.classif-type = &1&2&1', chr(34), 'dis-card':U)   + " " + where-phrase-25
     2512             else "true"
     2513           )
     2514         parameter-5-25 = (" " + "" + " " + "" + " " + p-find-condition)
     2515         parameter-6-25 = if sort-phrase-25 = ''
     2516                              then
     2517           (
     2518           " " + "  " +
     2519             " " + sort-column-phrase +
     2520           " " + " by X_stop-list.stop-list-code descending"
     2521           )
     2522                              else
     2523           (
     2524           " " + "  " +
     2525             " " + sort-column-phrase +
     2526           " " + sort-phrase-25
     2527           )
     2528         parameter-7-25 =
     2529           " indexed-reposition  "
     2530       .
     2531         run fltopend_fltfindq in this-procedure  (
     2532                             input this-procedure:handle
     2533                             ,input QUERY br-stop-list:handle
     2534                             ,input logical(parameter-2-25)
     2535                             ,input no-lock
     2536                             ,input parameter-3-25
     2537                             ,input parameter-4-25
     2538                             ,input parameter-5-25
     2539                             ,input parameter-6-25
     2540                             ,input parameter-7-25
     2541                             ,output v-fltopend-rowid
     2542                             ) no-error.
     2543         .
     2544         v-doc-rec = ?.
     2545       end.
     2546       assign
     2547         l-query-was-opened = true
     2548       .
     2549     end.
     2550   end.
     2551     run waitfram-hide in this-procedure .
     2552         end.
     2553      END.
     2554    END CASE.
     2555   if not p-open-query and v-doc-rec <> ? then
     2556   REPOSITION br-stop-list to recid v-doc-rec No-ERROR.
     2557   if not p-open-query and v-fltopend-rowid[1] <> ? then
     2558   query br-stop-list:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     2559   run waitfram-hide in this-procedure .
     2560   APPLY "VALUE-CHANGED" TO br-stop-list in frame Dialog-Frame.
     2561   APPLY "ENTRY" TO br-stop-list.
     2562   END PROCEDURE.
     2563   PROCEDURE proc-b-add :
     2564   DEFINE INPUT PARAMETER p-add-option AS CHARACTER NO-UNDO.
     2565   define variable v-stop-list-code as character no-undo .
     2566   define variable v-ok as logical no-undo .
     2567   DEFINE variable v-loc-rid-list AS CHARACTER NO-UNDO.
     2568   DEFINE BUFFER buf_stop-list FOR ub.stop-list.
     2569   define variable vss-include-info26 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2570   do:
     2571     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2572       (input  v-cntxt-db-num
     2573       ,input  v-cntxt-userid
     2574       ,input  0
     2575       ,input  'actn_stop-list_preparation':U
     2576       ,input  'global':U
     2577       ,input  0
     2578       ,input  '':U
     2579       ,input  0
     2580       ,input  0
     2581       ,input  0
     2582       ,input  0
     2583       ,input  true
     2584       ,output v-ok
     2585       )  .
     2586   end.
     2587   if v-ok <> true
     2588   then do:
     2589     undo, return no-apply .
     2590   end.
     2591   CASE p-add-option:
     2592     WHEN "import" THEN DO:
     2593       run str/diallog.w (
     2594             input parParentProc
     2595           , input this-procedure
     2596           , input "ref/impstpl.w":U
     2597           , input ('ДОБАВЛЕНИЕ':U + chr(4) + '':U)
     2598           , input no
     2599           , input "&Стоп"
     2600           , input substitute("Импорт стоплистов по ДК")
     2601       ) no-error.
     2602     END.
     2603     WHEN  "manual" THEN DO:
     2604       run ref/stop-l1.p ( input no
     2605                       ,output v-stop-list-code) NO-ERROR.
     2606     END.
     2607     WHEN "copy" THEN DO:
     2608       message
     2609       substitute("Выберите стоплист-оригинал для копирования&1" +
     2610                 "(полученный новый стоплист будет дополнен НОВЫМИ картами для тех клиентов-держателей,&1" +
     2611                 "чьи карты были в стоплисте-оригинале в статусе &2 или &3"
     2612                 , chr(10)
     2613                 , 'стоп-клиент':U
     2614                 , 'стоп-карта;стоп-клиент':U)
     2615       view-as alert-box .
     2616       run ref/stop-ls.w ( input parparentproc
     2617                       ,input "b-sel"
     2618                       ,input 'все':U
     2619                       ,input-output v-loc-rid-list) no-error.
     2620       if v-loc-rid-list = "":U then undo, return error .
     2621       run waitfram-show in this-procedure ( "Ждите..." ).
     2622       find first buf_stop-list no-lock where
     2623                 recid(buf_stop-list) = integer(v-loc-rid-list).
     2624       run ref/stop-l4.p ( input no
     2625                     ,input buf_stop-list.stop-list-code
     2626                     ,output v-stop-list-code) NO-ERROR.
     2627       run waitfram-hide in this-procedure .
     2628     END.
     2629   END CASE.
     2630   RUN openbr IN THIS-PROCEDURE  ( INPUT YES, INPUT NO, INPUT '':U) NO-ERROR.
     2631   APPLY "ENTRY" TO br-stop-list IN FRAME Dialog-Frame.
     2632   APPLY "VALUE-CHANGED" TO br-stop-list.
     2633   END PROCEDURE.
     2634   PROCEDURE proc-b-cd :
     2635   run str/diallog.w (
     2636                     input parparentproc
     2637                     ,input this-procedure
     2638                     ,input 'str/snd-stpl.p':U
     2639                     ,input X_stop-list.stop-list-code
     2640                     ,input yes
     2641                     ,input '':U
     2642                     ,input 'Отправка информации по стоплистам на кассы текущей БД') no-error .
     2643   END PROCEDURE.
     2644   PROCEDURE proc-b-chg :
     2645   DEFINE INPUT PARAMETER p-chg-option AS CHARACTER NO-UNDO.
     2646   DEFINE VARIABLE v-rec AS RECID  NO-UNDO.
     2647   DEFINE VARIABLE v-loc-rid-list AS character  NO-UNDO.
     2648   IF NOT AVAILABLE X_stop-list THEN RETURN NO-APPLY.
     2649   define variable v-ok as logical no-undo .
     2650   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2651   do:
     2652     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2653       (input  v-cntxt-db-num
     2654       ,input  v-cntxt-userid
     2655       ,input  0
     2656       ,input  'actn_stop-list_preparation':U
     2657       ,input  'global':U
     2658       ,input  0
     2659       ,input  '':U
     2660       ,input  0
     2661       ,input  0
     2662       ,input  0
     2663       ,input  0
     2664       ,input  true
     2665       ,output v-ok
     2666       )  .
     2667   end.
     2668   if v-ok <> true
     2669   then do:
     2670     undo, return no-apply .
     2671   end.
     2672   v-rec = recid(X_stop-list).
     2673   CASE p-chg-option:
     2674     WHEN "import" THEN DO:
     2675       run str/diallog.w (
     2676             input parParentProc
     2677           , input this-procedure
     2678           , input "ref/impstpl.w":U
     2679           , input ('ИЗМЕНЕНИЕ':U + chr(4) + X_stop-list.stop-list-code)
     2680           , input no
     2681           , input "&Стоп"
     2682           , input substitute("Импорт стоплистов по ДК")
     2683       ) no-error.
     2684     END.
     2685     WHEN "manual" THEN DO:
     2686       run ref/stop-lls.w ( INPUT parparentproc
     2687                         ,INPUT "b-add":U
     2688                         ,INPUT 'ИЗМЕНЕНИЕ':U
     2689                         ,INPUT X_stop-list.stop-list-code
     2690                         ,input '':U
     2691                         ,INPUT-OUTPUT v-loc-rid-list ) NO-ERROR.
     2692     END.
     2693   END CASE.
     2694   IF NOT ERROR-STATUS:ERROR THEN DO:
     2695     RUN Openbr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, input '':U).
     2696     REPOSITION br-stop-list to RECID v-rec NO-ERROR.
     2697     APPLY "ENTRY" TO BROWSE br-stop-list.
     2698     APPLY "value-changed" TO BROWSE br-stop-list.
     2699   END.
     2700   END PROCEDURE.
     2701   PROCEDURE proc-b-lkp :
     2702   DEFINE VARIABLE v-loc-rid-list AS CHARACTER NO-UNDO.
     2703   IF NOT AVAILABLE X_stop-list THEN RETURN ERROR.
     2704   run ref/stop-lls.w ( INPUT parparentproc
     2705                   ,INPUT "":U
     2706                   ,INPUT 'ПРОСМОТР':U
     2707                   ,INPUT X_stop-list.stop-list-code
     2708                   ,input '':U
     2709                   ,INPUT-OUTPUT v-loc-rid-list ) NO-ERROR.
     2710   END PROCEDURE.
     2711   PROCEDURE proc-b-sch :
     2712   define variable v-ri as recid no-undo .
     2713   assign
     2714   v-ri = (if avail X_stop-list then recid(X_stop-list) else ?)
     2715   .
     2716   assign
     2717   tbl = 'stop-list'
     2718   join-tbl = 'X_stop-list'
     2719   fld = ""
     2720   lab = ""
     2721   spr = ""
     2722   dim = '0'
     2723   .
     2724   run fltfield-add in this-procedure('doc-date', 'Дата стоплиста', '',
     2725   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2726   run fltfield-add in this-procedure('fact-date', 'Факт.Дата стоплиста', '',
     2727   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2728   run fltfield-add in this-procedure('stop-list-code', 'N стоплиста', '',
     2729   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2730   DO on stop undo, leave:
     2731       run gbl/filter.w ( INPUT parparentproc
     2732                    ,INPUT filter-point + chr(4) + filter-label
     2733                    ,INPUT tbl
     2734                    ,INPUT join-tbl
     2735                    ,INPUT fld
     2736                    ,INput lab
     2737                    ,INPUT spr
     2738                    ,INPUT  dim).
     2739       RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     2740       if v-ri <> ? then do:
     2741         reposition br-stop-list to recid v-ri no-error.
     2742       end.
     2743       APPLY "ENTRY" to br-stop-list in frame Dialog-Frame .
     2744   END .
     2745   END PROCEDURE.
