      700     APPLY "END-ERROR":U TO SELF.
      701   END.
      702   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      703   DO:
      704    IF add-option = '':U THEN DO:
      705       run gbl/pop-up.p ( input self:handle
      706                        , input no) no-error.
      707       if error-status:error or add-option = "":U then return no-apply.
      708     END.
      709     run proc-b-add IN THIS-PROCEDURE ( add-option) NO-ERROR.
      710     IF ERROR-STATUS:ERROR THEN do:
      711         add-option = "":U.
      712         RETURN NO-APPLY.
      713     END.
      714     add-option = "":U.
      715   END.
      716   ON CHOOSE OF b-cd IN FRAME Dialog-Frame
