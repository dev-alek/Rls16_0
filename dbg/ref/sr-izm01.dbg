        1   block-level on error undo, throw.
        2   define input parameter p-node-code                   as integer   no-undo .
        3   define input parameter p-sr-type-izm                 as integer   no-undo .
        4   define input parameter p-sr-model                    as character no-undo .
        5   define input parameter p-sr-level                    as integer   no-undo .
        6   define input parameter p-sr-temperature              as integer   no-undo .
        7   define input parameter p-sr-density                  as integer   no-undo .
        8   define input parameter p-sr-Weight                   as integer   no-undo .
        9   define input parameter p-sr-type-level-measuring     as integer   no-undo .
       10   define input parameter p-sr-type-id                  as integer   no-undo .
       11   define input parameter p-sr-abs-err-neft-water       as decimal   no-undo .
       12   define input parameter p-sr-relative-err-neft-water  as decimal   no-undo .
       13   define input parameter p-sr-abs-err-water            as decimal   no-undo .
       14   define input parameter p-sr-relative-err-water       as decimal   no-undo .
       15   define input parameter p-sr-abs-err-dens             as decimal   no-undo .
       16   define input parameter p-sr-abs-err-temp-vol         as decimal   no-undo .
       17   define input parameter p-sr-abs-err-temp-dens        as decimal   no-undo .
       18   define input parameter p-sr-relative-err-dens        as decimal   no-undo .
       19   define input parameter p-sr-abs-err-dens-lgas-liquid as decimal   no-undo .
       20   define input parameter p-sr-relative-err-dens-lgas-liquid as decimal   no-undo .
       21   define input parameter p-sr-abs-err-dens-lgas-vapor  as decimal   no-undo .
       22   define input parameter p-sr-otnos                    as decimal   no-undo .
       23   define input parameter p-sr-temp-line                as decimal   no-undo .
       24   define input parameter p-sr-not-used                 as integer   no-undo .
       25   define variable vss-revision    as character no-undo init "$Revision: c93c7157b47d, 2925, rls $":U .
       26   define variable vss-author      as character no-undo init "$Author: VRukavishnikov $":U .
       27   define variable vss-date        as character no-undo init "$Date: ѕн но€ 22 19:49:14 2021 +0300 $":U .
       28   define variable vss-workfile    as character no-undo init "$Workfile: sr-izm01.p $":U .
       29   define variable vss-archive     as character no-undo init "$Archive: ref/sr-izm01.p $":U .
       30   define variable vss-description as character no-undo init "—охранение изменений в карточке средства измерени€ (прибора)".
       31   procedure vss-get-info :
       32     define output parameter p-vss-revision    like vss-revision    no-undo .
       33     define output parameter p-vss-author      like vss-author      no-undo .
       34     define output parameter p-vss-date        like vss-date        no-undo .
       35     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       36     define output parameter p-vss-archive     like vss-archive     no-undo .
       37     define output parameter p-vss-description like vss-description no-undo .
       38     assign
       39       p-vss-revision    = vss-revision
       40       p-vss-author      = vss-author
       41       p-vss-date        = vss-date
       42       p-vss-workfile    = vss-workfile
       43       p-vss-archive     = vss-archive
       44       p-vss-description = vss-description
       45     .
       46   end procedure.
       47   procedure vss-get-parameters :
       48     define output parameter p-vss-parameters as character no-undo .
       49   end procedure.
       50   define new global shared variable g#vssrevis-logger as handle    no-undo .
       51   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       52   define variable v-vssrevis-logger                   as handle    no-undo .
       53   procedure vss-logevent :
       54     define input  parameter p-extra-paramters as character no-undo .
       55     define variable v-vssrevis-parameters as character no-undo .
       56     do
       57     on error undo, return error return-value
       58     :
       59       if  valid-handle(v-vssrevis-logger)
       60       and v-vssrevis-logger :get-signature("logevent") <> ""
       61       then do:
       62         run vss-get-parameters in this-procedure
       63           (output v-vssrevis-parameters
       64           ).
       65         run logevent in v-vssrevis-logger
       66           (input vss-workfile
       67           ,input vss-revision
       68           ,input v-vssrevis-parameters
       69           ,input p-extra-paramters
       70           ).
       71       end.
       72     end.
       73   end procedure.
       74   assign
       75     v-vssrevis-logger = g#vssrevis-logger
       76   .
       77   if  valid-handle(v-vssrevis-logger)
       78   and v-vssrevis-logger :get-signature("logevent") <> ""
       79   then do:
       80     assign
       81       v-vssrevis-logevent = true
       82     .
       83     run vss-logevent in this-procedure (input vss-description) .
       84   end.
       85   define new global shared variable g#language as character no-undo .
       86   if g#language <> '' and g#language <> 'rus':U then do:
       87     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       88   end.
       89   define buffer buf_sr-izmerenia for ub.sr-izmerenia .
       90     if p-sr-model > "" then .
       91     else do:
       92       undo, throw new Progress.Lang.AppError(
       93         substitute("&1 &2 &3&4ѕожалуйста заполните наименование модели средства измерени€",
       94                    vss-workfile, vss-revision, vss-description, chr(10))
       95       ) .
       96     end .
       97     if can-find (first buf_sr-izmerenia
       98     where buf_sr-izmerenia.sr-model                    = p-sr-model
       99       AND buf_sr-izmerenia.sr-level                    = (p-sr-level > 0)
      100       AND buf_sr-izmerenia.sr-temperature              = (p-sr-temperature > 0)
      101       AND buf_sr-izmerenia.sr-density                  = (p-sr-density > 0)
      102       AND buf_sr-izmerenia.sr-Weight                   = (p-sr-Weight > 0)
      103       AND buf_sr-izmerenia.sr-type-id                  = p-sr-type-id
      104       AND buf_sr-izmerenia.sr-abs-err-neft-water       = p-sr-abs-err-neft-water
      105       AND buf_sr-izmerenia.sr-abs-err-water            = p-sr-abs-err-water
      106       AND buf_sr-izmerenia.sr-abs-err-dens             = p-sr-abs-err-dens
      107       AND buf_sr-izmerenia.sr-abs-err-temp-vol         = p-sr-abs-err-temp-vol
      108       AND buf_sr-izmerenia.sr-abs-err-temp-dens        = p-sr-abs-err-temp-dens
      109       AND buf_sr-izmerenia.sr-otnos                    = p-sr-otnos
      110       AND buf_sr-izmerenia.sr-temp-line                = p-sr-temp-line
      111       AND buf_sr-izmerenia.sr-type-izm                 = p-sr-type-izm
      112       AND buf_sr-izmerenia.sr-type-level-measuring     = p-sr-type-level-measuring
      113       AND buf_sr-izmerenia.sr-relative-err-neft-water  = p-sr-relative-err-neft-water
      114       AND buf_sr-izmerenia.sr-relative-err-water       = p-sr-relative-err-water
      115       AND buf_sr-izmerenia.sr-relative-err-dens        = p-sr-relative-err-dens
      116       AND buf_sr-izmerenia.sr-abs-err-dens-lgas-liquid = p-sr-abs-err-dens-lgas-liquid
      117       AND buf_sr-izmerenia.sr-relative-err-dens-lgas-liquid = p-sr-relative-err-dens-lgas-liquid
      118       AND buf_sr-izmerenia.sr-abs-err-dens-lgas-vapor       = p-sr-abs-err-dens-lgas-vapor
      119       AND buf_sr-izmerenia.node-code                       <> p-node-code
      120     ) then do:
      121       undo, throw new Progress.Lang.AppError(
      122         substitute("&1 &2 &3&4”же существует запись с совпадающими характеристиками, код которой отличаетс€ от [&5]",
      123                    vss-workfile, vss-revision, vss-description, chr(10),
      124                    p-node-code)
      125       ) .
      126     end .
      127     find first buf_sr-izmerenia exclusive-lock
      128          where buf_sr-izmerenia.node-code = p-node-code no-error no-wait .
      129     if locked(buf_sr-izmerenia) then do:
      130       undo, throw new Progress.Lang.AppError(
      131         substitute("&1 &2 &3&4«апись о средстве измерени€ с ид. [&5] зан€та другим пользователем",
      132                    vss-workfile, vss-revision, vss-description, chr(10),
      133                    p-node-code )
      134         ) .
      135     end .
      136     if available buf_sr-izmerenia then do:
      137     end .
      138     else do :
      139       create buf_sr-izmerenia .
      140       assign
      141         buf_sr-izmerenia.node-code = p-node-code
      142       .
      143     end .
      144     assign
      145       buf_sr-izmerenia.sr-model                    = p-sr-model
      146       buf_sr-izmerenia.sr-level                    = (p-sr-level > 0)
      147       buf_sr-izmerenia.sr-temperature              = (p-sr-temperature > 0)
      148       buf_sr-izmerenia.sr-density                  = (p-sr-density > 0)
      149       buf_sr-izmerenia.sr-Weight                   = (p-sr-Weight > 0)
      150       buf_sr-izmerenia.sr-type-id                  = p-sr-type-id
      151       buf_sr-izmerenia.sr-abs-err-neft-water       = p-sr-abs-err-neft-water
      152       buf_sr-izmerenia.sr-abs-err-water            = p-sr-abs-err-water
      153       buf_sr-izmerenia.sr-abs-err-dens             = p-sr-abs-err-dens
      154       buf_sr-izmerenia.sr-abs-err-temp-vol         = p-sr-abs-err-temp-vol
      155       buf_sr-izmerenia.sr-abs-err-temp-dens        = p-sr-abs-err-temp-dens
      156       buf_sr-izmerenia.sr-otnos                    = p-sr-otnos
      157       buf_sr-izmerenia.sr-temp-line                = p-sr-temp-line
      158       buf_sr-izmerenia.sr-type-izm                 = p-sr-type-izm
      159       buf_sr-izmerenia.sr-type-level-measuring     = p-sr-type-level-measuring
      160       buf_sr-izmerenia.sr-relative-err-neft-water  = p-sr-relative-err-neft-water
      161       buf_sr-izmerenia.sr-relative-err-water       = p-sr-relative-err-water
      162       buf_sr-izmerenia.sr-relative-err-dens        = p-sr-relative-err-dens
      163       buf_sr-izmerenia.sr-abs-err-dens-lgas-liquid = p-sr-abs-err-dens-lgas-liquid
      164       buf_sr-izmerenia.sr-relative-err-dens-lgas-liquid = p-sr-relative-err-dens-lgas-liquid
      165       buf_sr-izmerenia.sr-abs-err-dens-lgas-vapor  = p-sr-abs-err-dens-lgas-vapor
      166       buf_sr-izmerenia.sr-not-used                 = (p-sr-not-used > 0)
      167     .
      168     validate buf_sr-izmerenia .
