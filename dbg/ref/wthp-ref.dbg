     1516         ENABLE b-parts b-series WITH FRAME Dialog-Frame.
     1517     END.
     1518     ELSE DO:
     1519       DISABLE b-parts b-series WITH FRAME Dialog-Frame.
     1520     END.
     1521   END.
     1522   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1523   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1524   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1525   on help of frame Dialog-Frame
     1526   do:
     1527     run gbl/app_help.p
     1528       (input this-procedure :file-name
     1529       ,input ''
     1530       ,input ?
     1531       ) no-error.
     1532     if error-status :error then do:
     1533       message
     1534         "Ошибка при вызове помощи"
     1535         error-status :get-message(1)
     1536         view-as alert-box .
     1537     end.
     1538   end.
     1539   run minbtn-set in this-procedure .
     1540   on choose of b-help in frame Dialog-Frame
     1541   do:
     1542     apply "help":u to frame Dialog-Frame .
     1543   end.
     1544   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1545   procedure minbtn-set :
     1546       do
     1547           on error undo, return error return-value
     1548           :
     1549           define variable ii              as integer       no-undo .
     1550           define variable fh              as widget-handle no-undo .
     1551           define variable hh              as widget-handle no-undo .
     1552           define variable v-h             as handle        extent 4 no-undo .
     1553           define variable v-name-button   as character     no-undo .
     1554           define variable v-help-old-x    as decimal       no-undo .
     1555           define variable v-help-old-y    as decimal       no-undo .
     1556           define variable v-help-old-size as decimal       no-undo .
     1557           define variable v-frame-width   as decimal       no-undo .
     1558           define variable jj              as integer       no-undo .
     1559           do
     1560               on error undo, return error
     1561               :
     1562               assign
     1563                   v-frame-width = frame Dialog-Frame:width - 0.3
     1564                   fh            = frame Dialog-Frame:first-child
     1565                   hh            = fh:first-child
     1566                   ii            = 1
     1567                   .
     1568               do while valid-handle(hh):
     1569                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1570                   do:
     1571                       case lc(hh:name) :
     1572                           when "b-help" then
     1573                               do:
     1574                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1575                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1576                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1577                                   hh:TOOLTIP = "Помощь" .
     1578                                   v-help-old-x = hh:column .
     1579                                   v-help-old-y = hh:row    .
     1580                                   v-help-old-size = hh:width .
     1581                                   hh:width-chars = 2.5 .
     1582                               end.
     1583                           when "b-print" then
     1584                               do:
     1585                                   hh:load-image("cmp/b-print.bmp":u) .
     1586                                   hh:TOOLTIP = "Печать" .
     1587                                   v-h[ii] = hh:handle .
     1588                                   ii = ii + 1 .
     1589                                   hh:width-chars = 3 .
     1590                               end.
     1591                           when "b-history" or
     1592                           when "b-hist" then
     1593                               do:
     1594                                   hh:load-image("cmp/b-hist.bmp":u) .
     1595                                   hh:TOOLTIP = "История" .
     1596                                   v-h[ii] = hh:handle .
     1597                                   ii = ii + 1 .
     1598                                   hh:width-chars = 3 .
     1599                               end.
     1600                           when "b-sch" then
     1601                               do:
     1602                                   hh:load-image("cmp/b-sch.bmp":u) .
     1603                                   hh:TOOLTIP = "Установка Фильтра" .
     1604                                   v-h[ii] = hh:handle .
     1605                                   ii = ii + 1 .
     1606                                   hh:width-chars = 3 .
     1607                               end.
     1608                           when "b-hist-user" then
     1609                               do:
     1610                                   hh:load-image("cmp/b-hist.bmp":u) .
     1611                                   hh:TOOLTIP = "История пользователя" .
     1612                                   ii = ii + 1 .
     1613                               end.
     1614                       end case.
     1615                   end.
     1616                   hh = hh:next-sibling.
     1617               end.
     1618               b-help:column = v-frame-width - b-help:width-chars.
     1619               jj = 0.
     1620               repeat ii = 4 to 1 by -1 :
     1621                   if valid-handle (v-h[ii] ) then
     1622                   do:
     1623                       jj  = jj + 1 .
     1624                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1625                       v-h[ii]:row    = v-help-old-y .
     1626                   end.
     1627               end.
     1628           end.
     1629       end.
     1630   end procedure.
     1631   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1632   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1633   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1634   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1635   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1636   define variable v-diasize-current-frame-height as decimal   no-undo .
     1637   define variable v-diasize-change-size          as logical   no-undo .
     1638   define variable v-diasize-resize-button        as handle    no-undo .
     1639   define variable v-diasize-wndmax               as logical   no-undo .
     1640   define variable v-diasize-wndstore             as logical   no-undo .
     1641   define variable v-diasize-proc-name            as character no-undo .
     1642   define variable v-diasize-browse-handle        as handle    no-undo .
     1643   define variable v-diasize-browse-number        as integer   no-undo .
     1644   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1645   define temp-table temp-diasize-handle no-undo
     1646     field handle-value  as handle
     1647     field save-position as decimal
     1648     index xpk is primary unique handle-value
     1649     .
     1650   define temp-table temp-browse-handle no-undo
     1651     field browse-type   as character
     1652     field browse-number as integer
     1653     field browse-handle as handle
     1654     field original-size as decimal
     1655     index xpk is primary unique browse-type browse-number
     1656     index xie browse-type browse-handle
     1657   .
     1658   procedure diasize_change-height :
     1659     define input  parameter p-change-value  as decimal   no-undo .
     1660     define input  parameter p-move-resize   as logical   no-undo .
     1661     define variable v-field-group-handle    as handle    no-undo .
     1662     define variable v-object-handle         as handle    no-undo .
     1663     define variable v-frame-height          as decimal   no-undo .
     1664     define variable v-frame-virtual-height  as decimal   no-undo .
     1665     define variable v-browse-height         as decimal   no-undo .
     1666     define variable v-window-height         as decimal   no-undo .
     1667     define variable v-window-virtual-height as decimal   no-undo .
     1668     define variable v-change-sign           as integer   no-undo .
     1669     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1670     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1671     if p-change-value > 0
     1672     then do:
     1673       if frame Dialog-Frame :height + p-change-value
     1674           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1675       then do:
     1676         assign
     1677           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1678                           - (frame Dialog-Frame :height-chars)
     1679         .
     1680         if p-change-value <= 0
     1681         then do:
     1682           run diasize_position-resize-button in this-procedure .
     1683           return .
     1684         end.
     1685       end.
     1686     end.
     1687     if p-change-value < 0
     1688     then do:
     1689       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1690       then do:
     1691         assign
     1692           p-change-value = v-diasize-orig-frame-height
     1693                          - (frame Dialog-Frame :height-chars)
     1694         .
     1695         if p-change-value >= 0
     1696         then do:
     1697           run diasize_position-resize-button in this-procedure .
     1698           return .
     1699         end.
     1700       end.
     1701     end.
     1702     if p-change-value >= 0
     1703     then do:
     1704       assign
     1705         v-change-sign = 1
     1706       .
     1707     end.
     1708     else do:
     1709       assign
     1710         v-change-sign = -1
     1711       .
     1712     end.
     1713     assign
     1714       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1715     .
     1716     if p-change-value = 0
     1717     then do:
     1718       run diasize_position-resize-button in this-procedure .
     1719       return .
     1720     end.
     1721     move_block:
     1722     do
     1723     on error undo move_block, retry move_block
     1724     :
     1725       if retry
     1726       then do:
     1727         do
     1728         on error undo move_block, leave move_block
     1729         :
     1730           if p-change-value > 0
     1731           then do:
     1732             for each buf_temp-diasize-handle
     1733             on error undo, next
     1734             :
     1735               assign
     1736                 v-object-handle = buf_temp-diasize-handle.handle-value
     1737               .
     1738               if v-object-handle <> v-diasize-resize-button
     1739               then do:
     1740                 assign
     1741                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1742                 .
     1743               end.
