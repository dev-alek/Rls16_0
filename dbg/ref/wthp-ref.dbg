     2968   define variable  sort-phrase-32      as character no-undo .
     2969   define variable  where-phrase-rus-32 as character no-undo .
     2970   define variable  sort-phrase-rus-32  as character no-undo .
     2971     run waitfram-show in this-procedure
     2972       (input "ЖДИТЕ ..."
     2973       ).
     2974   run gbl/flt-get.p
     2975     (input filter-point
     2976     ,output flt-rec-32
     2977     ,output filter-name-32
     2978     ,output where-phrase-32
     2979     ,output sort-phrase-32
     2980     ,output where-phrase-rus-32
     2981     ,output sort-phrase-rus-32
     2982     ).
     2983       run set-filter-name in this-procedure
     2984         (INPUT filter-name-32
     2985         ) no-error .
     2986     assign
     2987       l-filter-open-32 = false
     2988     .
     2989     if flt-rec-32 <> ?
     2990       or sort-column-phrase > ""
     2991     then do:
     2992       define variable  parameter-2-32 as character no-undo .
     2993       define variable  parameter-3-32 as character no-undo .
     2994       define variable  parameter-4-32 as character no-undo .
     2995       define variable  parameter-5-32 as character no-undo .
     2996       define variable  parameter-6-32 as character no-undo .
     2997       define variable  parameter-7-32 as character no-undo .
     2998         assign
     2999         parameter-3-32 =
     3000                                 "FOR EACH X_wth-par"
     3001         parameter-4-32 =
     3002           (
     3003             if (" true " + " " + where-phrase-32) <> ""
     3004             then " true " + " " + where-phrase-32
     3005             else "true"
     3006           )
     3007         parameter-5-32 = (" " + "" + " " + ", FIRST X_wealth NO-LOCK where X_wealth.wth-code = X_wth-par.wth-code")
     3008         parameter-6-32 = if sort-phrase-32 = ''
     3009                              then
     3010           (
     3011           " " + "  " +
     3012             " " + sort-column-phrase +
     3013           " " + "  "
     3014           )
     3015                              else
     3016           (
     3017           " " + "  " +
     3018             " " + sort-column-phrase +
     3019           " " + sort-phrase-32
     3020           )
     3021         parameter-7-32 =
     3022           "   "
     3023       .
     3024       do
     3025       on stop undo, leave
     3026       on error undo, leave
     3027       :
     3028         assign
     3029           l-disable-where-32 =
     3030             (" true " + " " + where-phrase-32 = "")
     3031         .
     3032         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3033                             ,input QUERY br-wthp:handle
     3034                             ,input parameter-3-32
     3035                             ,input parameter-4-32
     3036                             ,input parameter-5-32
     3037                             ,input parameter-6-32
     3038                             ,input parameter-7-32
     3039                             )
     3040         .
     3041         assign
     3042           l-filter-open-32 = true
     3043         .
     3044       end.
     3045       if l-filter-open-32 = false then do:
     3046         message
     3047           "Ошибка при фильтрации / сортировке" skip
     3048           "Будут показаны записи без учета фильтра" skip
     3049           view-as alert-box .
     3050       end.
     3051       else do:
     3052           assign
     3053             l-query-was-opened = true
     3054           .
     3055       end.
     3056     end.
     3057     if l-filter-open-32 = false then do:
     3058       OPEN QUERY br-wthp FOR EACH X_wth-par
     3059         where  true
     3060       , FIRST X_wealth NO-LOCK where X_wealth.wth-code = X_wth-par.wth-code
     3061     .
     3062         assign
     3063           l-query-was-opened = true
     3064         .
     3065     end.
     3066     run waitfram-hide in this-procedure .
     3067       end.
     3068       when 'ser_wealth':U then do:
     3069                   ASSIGN
     3070           frame Dialog-Frame:TITLE = "Номиналы серийных МЦ "
     3071           filter-point = "Номиналы серийных МЦ " + p-list-mode
     3072           filter-label = substitute("&1 Одна МЦ", filter-label0)
     3073           .
     3074   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3075   define variable  l-disable-where-34  as logical   no-undo .
     3076   define variable  l-filter-open-34    as logical   .
     3077   define variable  flt-rec-34       as recid     no-undo .
     3078   define variable  filter-name-34      as character no-undo .
     3079   define variable  where-phrase-34     as character no-undo .
     3080   define variable  sort-phrase-34      as character no-undo .
     3081   define variable  where-phrase-rus-34 as character no-undo .
     3082   define variable  sort-phrase-rus-34  as character no-undo .
     3083     run waitfram-show in this-procedure
     3084       (input "ЖДИТЕ ..."
     3085       ).
     3086   run gbl/flt-get.p
     3087     (input filter-point
     3088     ,output flt-rec-34
     3089     ,output filter-name-34
     3090     ,output where-phrase-34
     3091     ,output sort-phrase-34
     3092     ,output where-phrase-rus-34
     3093     ,output sort-phrase-rus-34
     3094     ).
     3095       run set-filter-name in this-procedure
     3096         (INPUT filter-name-34
     3097         ) no-error .
     3098     assign
     3099       l-filter-open-34 = false
     3100     .
     3101     if flt-rec-34 <> ?
     3102       or sort-column-phrase > ""
     3103     then do:
     3104       define variable  parameter-2-34 as character no-undo .
     3105       define variable  parameter-3-34 as character no-undo .
     3106       define variable  parameter-4-34 as character no-undo .
     3107       define variable  parameter-5-34 as character no-undo .
     3108       define variable  parameter-6-34 as character no-undo .
     3109       define variable  parameter-7-34 as character no-undo .
     3110         assign
     3111         parameter-3-34 =
     3112                                 "FOR EACH X_wth-par"
     3113         parameter-4-34 =
     3114           (
     3115             if (" " + " " + where-phrase-34) <> ""
     3116             then " " + " " + where-phrase-34
     3117             else "true"
     3118           )
     3119         parameter-5-34 = (" " + "" + " " + ", FIRST X_wealth NO-LOCK where X_wealth.wth-code = X_wth-par.wth-code")
     3120         parameter-6-34 = if sort-phrase-34 = ''
     3121                              then
     3122           (
     3123           " " + " and x_wealth.is-ser = 1  " +
     3124             " " + sort-column-phrase +
     3125           " " + "  "
     3126           )
     3127                              else
     3128           (
     3129           " " + " and x_wealth.is-ser = 1  " +
     3130             " " + sort-column-phrase +
     3131           " " + sort-phrase-34
     3132           )
     3133         parameter-7-34 =
     3134           "   "
     3135       .
     3136       do
     3137       on stop undo, leave
     3138       on error undo, leave
     3139       :
     3140         assign
     3141           l-disable-where-34 =
     3142             (" " + " " + where-phrase-34 = "")
     3143         .
     3144         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3145                             ,input QUERY br-wthp:handle
     3146                             ,input parameter-3-34
     3147                             ,input parameter-4-34
     3148                             ,input parameter-5-34
     3149                             ,input parameter-6-34
     3150                             ,input parameter-7-34
     3151                             )
     3152         .
     3153         assign
     3154           l-filter-open-34 = true
     3155         .
     3156       end.
     3157       if l-filter-open-34 = false then do:
     3158         message
     3159           "Ошибка при фильтрации / сортировке" skip
     3160           "Будут показаны записи без учета фильтра" skip
     3161           view-as alert-box .
     3162       end.
     3163       else do:
     3164           assign
     3165             l-query-was-opened = true
     3166           .
     3167       end.
     3168     end.
     3169     if l-filter-open-34 = false then do:
     3170       OPEN QUERY br-wthp FOR EACH X_wth-par
     3171       , FIRST X_wealth NO-LOCK where X_wealth.wth-code = X_wth-par.wth-code
     3172          and x_wealth.is-ser = 1
     3173     .
     3174         assign
     3175           l-query-was-opened = true
     3176         .
     3177     end.
     3178     run waitfram-hide in this-procedure .
     3179       end.
     3180       when 'МЦ':U then do:
     3181           ASSIGN
     3182           frame Dialog-Frame:TITLE = "Номиналы материальной ценности " + b-wealth.wth-name
     3183           filter-point = "Номиналы материальных ценностей " + p-list-mode
     3184           filter-label = substitute("&1 Одна МЦ", filter-label0)
     3185           .
     3186   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3187   define variable  l-disable-where-36  as logical   no-undo .
     3188   define variable  l-filter-open-36    as logical   .
     3189   define variable  flt-rec-36       as recid     no-undo .
     3190   define variable  filter-name-36      as character no-undo .
     3191   define variable  where-phrase-36     as character no-undo .
     3192   define variable  sort-phrase-36      as character no-undo .
     3193   define variable  where-phrase-rus-36 as character no-undo .
     3194   define variable  sort-phrase-rus-36  as character no-undo .
     3195     run waitfram-show in this-procedure
     3196       (input "ЖДИТЕ ..."
     3197       ).
     3198   run gbl/flt-get.p
     3199     (input filter-point
     3200     ,output flt-rec-36
     3201     ,output filter-name-36
     3202     ,output where-phrase-36
     3203     ,output sort-phrase-36
     3204     ,output where-phrase-rus-36
     3205     ,output sort-phrase-rus-36
     3206     ).
     3207       run set-filter-name in this-procedure
     3208         (INPUT filter-name-36
     3209         ) no-error .
     3210     assign
     3211       l-filter-open-36 = false
     3212     .
     3213     if flt-rec-36 <> ?
     3214       or sort-column-phrase > ""
     3215     then do:
     3216       define variable  parameter-2-36 as character no-undo .
     3217       define variable  parameter-3-36 as character no-undo .
     3218       define variable  parameter-4-36 as character no-undo .
     3219       define variable  parameter-5-36 as character no-undo .
     3220       define variable  parameter-6-36 as character no-undo .
     3221       define variable  parameter-7-36 as character no-undo .
     3222         assign
     3223         parameter-3-36 =
     3224                                 "FOR EACH X_wth-par"
     3225         parameter-4-36 =
     3226           (
     3227             if (" X_wth-par.wth-code = pwth-code " + " " + where-phrase-36) <> ""
     3228             then  substitute('X_wth-par.wth-code = &1', pwth-code)  + " " + where-phrase-36
     3229             else "true"
     3230           )
     3231         parameter-5-36 = (" " + "" + " " + ", FIRST X_wealth NO-LOCK where X_wealth.wth-code = X_wth-par.wth-code")
     3232         parameter-6-36 = if sort-phrase-36 = ''
     3233                              then
     3234           (
     3235           " " + "  " +
     3236             " " + sort-column-phrase +
     3237           " " + "  "
     3238           )
     3239                              else
     3240           (
     3241           " " + "  " +
     3242             " " + sort-column-phrase +
     3243           " " + sort-phrase-36
     3244           )
     3245         parameter-7-36 =
     3246           "   "
     3247       .
     3248       do
     3249       on stop undo, leave
     3250       on error undo, leave
     3251       :
     3252         assign
     3253           l-disable-where-36 =
     3254             (" X_wth-par.wth-code = pwth-code " + " " + where-phrase-36 = "")
     3255         .
     3256         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3257                             ,input QUERY br-wthp:handle
     3258                             ,input parameter-3-36
     3259                             ,input parameter-4-36
     3260                             ,input parameter-5-36
     3261                             ,input parameter-6-36
     3262                             ,input parameter-7-36
     3263                             )
     3264         .
     3265         assign
     3266           l-filter-open-36 = true
     3267         .
     3268       end.
     3269       if l-filter-open-36 = false then do:
     3270         message
     3271           "Ошибка при фильтрации / сортировке" skip
     3272           "Будут показаны записи без учета фильтра" skip
     3273           view-as alert-box .
     3274       end.
     3275       else do:
     3276           assign
     3277             l-query-was-opened = true
     3278           .
     3279       end.
     3280     end.
     3281     if l-filter-open-36 = false then do:
     3282       OPEN QUERY br-wthp FOR EACH X_wth-par
     3283         where  X_wth-par.wth-code = pwth-code
     3284       , FIRST X_wealth NO-LOCK where X_wealth.wth-code = X_wth-par.wth-code
     3285     .
     3286         assign
     3287           l-query-was-opened = true
     3288         .
     3289     end.
     3290     run waitfram-hide in this-procedure .
     3291       end.
     3292   END CASE.
     3293   if v-doc-rec <> ? then reposition br-wthp to recid v-doc-rec no-error.
     3294   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3295   query br-wthp:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3296   apply "entry" to br-wthp in frame Dialog-Frame.
     3297   run waitfram-hide in this-procedure .
     3298   if avail X_wth-par then
     3299   APPLY "VALUE-CHANGED":U to br-wthp.
     3300   apply "value-changed" to br-wthp in frame Dialog-Frame.
     3301   END PROCEDURE.
     3302   PROCEDURE PrintProc :
     3303   define variable date_string     as      char    no-undo.
     3304   define variable Line                as      char    no-undo.
     3305   define variable for-time as char.
     3306   DEFINE FRAME Wth-List
     3307   X_wealth.wth-code     column-label "Код"
     3308   X_wealth.wth-name     column-label "Название"
     3309   X_wealth.is-money     column-label "Денежн.!эквив."
     3310   X_wealth.curr-code    column-label "Код!валюты"
     3311   X_wealth.unit-base    column-label "Валюта/!Ед.изм."
     3312   X_wth-par.par-code     column-label "Код!номинала"
     3313   X_wth-par.par-val     column-label "Номинал"
     3314   X_wth-par.par-unit     column-label "Ед.изм.!номинала"
     3315   X_wth-par.par-rate     column-label "Коэфф."
     3316   X_wth-par.par-feat     column-label "Доп. признак"
     3317   HEADER  date_string AT 5 format "X(35)"
     3318   string( "Страница " ) format "X(9)" AT 100 PAGE-NUMBER(PrnLibStream) AT 110 FORMAT ">>9" SKIP
     3319   Line format "X(138)" AT 1
     3320   with width 160 down stream-io use-text    .
     3321   Line = fill("-", 122).
     3322   date_string = cur-time-print() .
     3323   run prn-lib-open-stream  in this-procedure (
     3324                                                input parParentProc
     3325                                               ,input 62
     3326                                               ,input yes
     3327                                               ,input no
     3328                                               ).
     3329   PUT  STREAM PrnLibStream
     3330   SPACE(25) ( frame Dialog-Frame:title )
     3331   format "x(90)" SKIP(1) .
     3332   FORM HEADER
     3333   Line AT 1 SKIP
     3334   "Продолжение - на следующей странице" AT 30 SKIP
     3335   with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
     3336   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3337   FORM with FRAME Wth-List  .
     3338   run waitfram-show in this-procedure ( input "Ждите...").
     3339   GET next br-wthp.
     3340   DO WHILE available X_wth-par :
     3341     Display STREAM PrnLibStream
     3342     X_wealth.wth-code
     3343     X_wealth.wth-name
     3344     X_wealth.is-money
     3345     X_wealth.curr-code
     3346     X_wealth.unit-base
     3347     X_wth-par.par-code
     3348     X_wth-par.par-val
     3349     X_wth-par.par-unit
     3350     X_wth-par.par-rate
     3351     X_wth-par.par-feat
     3352     with FRAME Wth-List .
     3353     DOWN STREAM PrnLibStream 1 with FRAME Wth-List  .
     3354     GET next br-wthp.
     3355   END.
     3356   UNDERLINE  STREAM PrnLibStream
     3357   X_wealth.wth-code
     3358   X_wealth.wth-name
     3359   X_wealth.is-money
     3360   X_wealth.curr-code
     3361   X_wealth.unit-base
     3362   X_wth-par.par-code
     3363   X_wth-par.par-val
     3364   X_wth-par.par-unit
     3365   X_wth-par.par-rate
     3366   X_wth-par.par-feat
     3367   with FRAME Wth-List .
     3368   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3369   HIDE  STREAM PrnLibStream FRAME CheckList.
     3370   output  STREAM PrnLibStream CLOSE.
     3371   run waitfram-hide in this-procedure .
     3372   run prn-lib-prn-file in this-procedure (
     3373                                             input parParentProc
     3374                                             ,input 0
     3375                                             ).
     3376   END PROCEDURE.
