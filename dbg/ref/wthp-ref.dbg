      556   procedure prn-lib-reportviewer :
      557     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      558     define input parameter p-report-name-html as character no-undo .
      559     define input parameter p-param        as character no-undo .
      560     define variable v-excel           as character no-undo init 'TRUE' .
      561     define variable v-value-character as character no-undo .
      562     define variable v-value-integer   as character no-undo .
      563     define variable v-value-date      as date      no-undo .
      564     define variable v-value-decimal   as decimal   no-undo .
      565     define variable rep-excel         as logical   no-undo .
      566     define variable excel-string      as character no-undo .
      567     define variable v-param-type      as character no-undo .
      568     define variable v-tth             as handle    no-undo .
      569     run adm/shattri.p (
      570       input "get":U
      571       ,input  ""
      572       ,input  0
      573       ,input  'report-glob':U
      574       ,input  'rep-excel':U
      575       ,output v-value-character
      576       ,output v-value-date
      577       ,output v-value-decimal
      578       ,output v-value-integer
      579       ,output rep-excel
      580       ,output v-param-type
      581       ,INPUT-OUTPUT table-handle v-tth
      582       )  .
      583     if rep-excel then v-excel = "TRUE" .
      584     else v-excel = "FALSE" .
      585     if p-param eq ""
      586     then
      587        p-param = "EXCEL:" + v-excel.
      588     else
      589        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      590     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      591   end procedure.
      592   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      593   define variable v-waitfram-action01         as character   no-undo .
      594   define variable v-waitfram-action02         as character   no-undo .
      595   define variable v-waitfram-action03         as character   no-undo .
      596   define variable mWaitFramTextBeg            as character   no-undo.
      597   define variable mWaitFramTextEnd            as character   no-undo.
      598   define variable mWaitFramView               as logical     no-undo.
      599   define variable mWaitProcEvent              as logical     no-undo init yes.
      600   define variable mWaitFramInterval           as integer     no-undo init 1 .
      601   define variable mWaitFramStop               as logical     no-undo.
      602   define variable mWaitFramStopUser           as logical     no-undo.
      603   define variable mWaitFramStopTimeOut        as logical     no-undo.
      604   define variable mWaitFramStartProc          as datetime-tz no-undo.
      605   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      606   define button B-WaitFramStop auto-end-key
      607        label "Стоп"
      608        size 10 by 1 tooltip "Остоновить процесс".
      609   define button B-viewProcInfo
      610        label "Информация"
      611        size 15 by 1 tooltip "Информация о процесс".
      612   define frame waitfram
      613     v-waitfram-action01 format "x(72)" no-label skip
      614     v-waitfram-action02 format "x(72)" no-label skip
      615     v-waitfram-action03 format "x(72)" no-label skip
      616     B-viewProcInfo
      617     B-WaitFramStop at row 4 col 30
      618     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      619     .
      620   define new global shared variable mBatchMode as logical no-undo init ?.
      621   define variable mFramBachModHandle as handle no-undo.
      622   mFramBachModHandle = frame waitfram:handle.
      623   define variable mFameOldVis as logical no-undo.
      624   define variable mVisCUrentVin as logical no-undo.
      625   if session:batch-mode
      626   then
      627      mBatchMode = yes.
      628   if mBatchMode = ? then do:
      629     mVisCUrentVin = current-window:visible.
      630     mFameOldVis = mFramBachModHandle:visible.
      631     mFramBachModHandle:visible  = yes.
      632     mBatchMode = mFramBachModHandle:visible ne yes.
      633     mFramBachModHandle:visible = mFameOldVis.
      634     current-window:visible = mVisCUrentVin.
      635   end.
      636    if  log-manager:logfile-name ne ?
      637     then DO:
      638         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      639         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      640         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      641     end.
      642   on choose of B-WaitFramStop in frame waitfram
      643   do:
      644     mWaitFramStop = yes.
      645     mWaitFramStopUser = yes.
      646   end.
      647   function waitfram-check-timeout returns logical():
      648      define variable vtime as int64 no-undo.
      649      if mWaitFramStopTimeOut
      650      then
      651         return yes.
      652      vtime = ( now - mWaitFramStartProc ) / 1000 .
      653      if     mWaitFramTimeOut ne ?
      654         and mWaitFramTimeOut ne 0
      655         and mWaitFramTimeOut lt vtime
      656      then do:
      657         mWaitFramStopTimeOut = yes.
      658      end.
      659      return mWaitFramStopTimeOut.
      660   end.
      661   procedure waitfram-hide :
      662     if not session:batch-mode
      663     then do
      664     on error undo, return error return-value
      665     :
      666       pause 0 before-hide .
      667       if not mBatchMode then
      668         hide frame waitfram .
      669     if     not mWaitFramView
      670        and mWaitProcEvent
      671     then
      672       process events .
      673     end.
      674   end procedure.
      675   procedure waitfram-show :
      676     define input  parameter p-message as character no-undo .
      677     define variable v-left-margin as integer   no-undo .
      678     if not session:batch-mode
      679     then do
      680     on error undo, return error return-value
      681     :
      682       if length(p-message) <= 70 then do:
      683         assign
      684           v-left-margin = integer((70 - length(p-message)) / 2)
      685         .
      686         assign
      687           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      688         .
      689         assign
      690           v-waitfram-action01 = " "
      691           v-waitfram-action02 = " "
      692                                    + fill(" ", v-left-margin)
      693                                    + p-message
      694           v-waitfram-action03 = " "
      695         .
      696       end.
      697       else do:
      698         define variable vRindex1 as integer no-undo.
      699         define variable vRindex2 as integer no-undo.
      700         vRindex1 = r-index(p-message," ",70).
      701         if vRindex1 = 0
      702         then
      703            vRindex1 = 70.
      704         if length(p-message)  <= vRindex1 + 70 then do:
      705           assign
      706             v-waitfram-action01 = " "
      707             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      708             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      709           .
      710         end.
      711         else do:
      712           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      713           if vRindex2 <= vRindex1
      714           then
      715              vRindex2 = vRindex1 + 70.
      716           assign
      717             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      718             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      719             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      720           .
      721         end.
      722       end.
      723       B-viewProcInfo:visible   in frame waitfram = no.
      724       B-viewProcInfo:sensitive in frame waitfram = no.
      725       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      726       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      727       if  (   mWaitFramView
      728          or  mWaitProcEvent)
      729          and not mBatchMode
      730       then
      731          display
      732             v-waitfram-action01 skip
      733             v-waitfram-action02 skip
      734             v-waitfram-action03 skip
      735          with frame waitfram .
      736       if     mWaitFramView
      737          then do:
      738             if     mWaitFramInterval ne ?
      739                and not mBatchMode
      740             then
      741                wait-for go of frame waitfram pause mWaitFramInterval.
      742          end.
      743          else
      744             if     mWaitProcEvent
      745                and not mBatchMode
      746             then
      747                process events .
      748     end.
      749   end procedure.
      750      procedure waitfram-show-this:
      751         define input  parameter iInterval as int64 no-undo.
      752         define variable vtime as int64 no-undo.
      753         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      754         mWaitFramInterval = iInterval.
      755         run waitfram-show (substitute("&1&2 &3&4" ,
      756                                       mWaitFramTextBeg ,
      757                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      758                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      759                                       mWaitFramTextEnd
      760                                      )
      761                           ).
      762      end.
      763      procedure WaitFramRunPause:
      764         define input  parameter iInterval as dec no-undo.
      765         define variable vStart  as datetime-tz no-undo.
      766         define variable vend    as datetime-tz no-undo.
      767         define variable vint as int64 no-undo.
      768         define variable vOk as logical no-undo.
      769         vStart = now.
      770         vend   = vStart.
      771         publish "WaitFramPause" (iInterval,output vOk).
      772         vend   =  now.
      773         vint = vend - vStart.
      774         vint = iInterval - vint / 1000.
      775         if     not mWaitFramStop
      776            and (   vint > 0
      777                 or (    not vOk
      778                     and iInterval eq ?
      779                     )
      780                 )
      781         then
      782            run waitfram-show-this (iInterval).
      783         vend   =  now.
      784         vint = vend - vStart.
      785         vint = iInterval - vint / 1000.
      786         if     not mWaitFramStop
      787            and vint > 0
      788         then do:
      789            run gbl/pause.p (vint * 1000).
      790         end.
      791         if iInterval ne ?
      792         then
      793            publish "WaitFramStop".
      794         waitfram-check-timeout().
      795      end.
      796      procedure WaitFramWaitFor:
      797         define input  parameter iInterval as dec no-undo.
      798         assign
      799            mWaitFramStartProc   = now
      800            mWaitFramStopUser    = no
      801            mWaitFramStopTimeOut = no
      802         .
      803         block-wait:
      804         do while not mWaitFramStop:
      805            run WaitFramRunPause (iInterval).
      806            if  waitfram-check-timeout()
      807            then do:
      808               leave block-wait.
      809            end.
      810         end.
      811         run waitfram-hide.
      812      end.
      813   procedure waitfram-join :
      814     define input  parameter p-line-1  as character no-undo .
      815     define input  parameter p-line-2  as character no-undo .
      816     define input  parameter p-line-3  as character no-undo .
      817     define output parameter p-message as character no-undo .
      818     do
      819     on error undo, return error return-value
      820     :
      821       assign
      822         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      823                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      824                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      825       .
      826     end.
      827   end procedure.
      828   function waitfram-join-function returns character
      829     (input p-line-1 as character
      830     ,input p-line-2 as character
      831     ,input p-line-3 as character
      832     ).
      833     define variable v-message as character no-undo .
      834     run waitfram-join in this-procedure
      835       (input  p-line-1
      836       ,input  p-line-2
      837       ,input  p-line-3
      838       ,output v-message
      839       ) .
      840     return v-message .
      841   end function .
      842   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      843     define variable v-cntxt-db-num        as integer   no-undo .
      844     define variable v-cntxt-userid        as character no-undo .
      845     define variable v-cntxt-level         as character no-undo .
      846     define variable v-cntxt-host-code-obj as integer   no-undo .
      847     define variable v-cntxt-obj-type      as character no-undo .
      848     define variable v-cntxt-obj-code      as integer   no-undo .
      849     define variable v-cntxt-db-num-obj    as integer   no-undo .
      850     define variable v-cntxt-is-admin      as logical   no-undo .
      851   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      852   FUNCTION mark-string RETURNS CHARACTER
      853     ( input p-recid as recid, input mark-list as character  ) :
      854     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      855   END FUNCTION.
      856   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      857   procedure wth-lib_cur-stock-place:
      858   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
      859   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
      860   define input  parameter parw-p-code like ub.wth-pobj.w-p-code  no-undo.
      861   define input  parameter parwth-code like ub.wth-pobj.wth-code  no-undo.
      862   define output parameter parstock    like ub.wth-pobj.income-pl no-undo.
      863   define buffer bf_wth-pobj for ub.wth-pobj.
      864   find first bf_wth-pobj where bf_wth-pobj.obj-type = parobj-type and
      865                                bf_wth-pobj.obj-code = parobj-code and
      866                                bf_wth-pobj.w-p-code = parw-p-code and
      867                                bf_wth-pobj.wth-code = parwth-code no-lock no-error.
      868   if available bf_wth-pobj then assign parstock = bf_wth-pobj.income-pl - bf_wth-pobj.incass-pl.
      869                            else assign parstock = 0.
      870   end procedure.
      871   procedure wth-lib_cur-stock-obj:
      872   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
      873   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
      874   define input  parameter parwth-code like ub.wth-obj.wth-code   no-undo.
      875   define output parameter parstock    like ub.wth-obj.income     no-undo.
      876   define buffer bf_wth-obj for ub.wth-obj.
      877   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
      878                               bf_wth-obj.obj-code = parobj-code and
      879                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
      880   if available bf_wth-obj then assign parstock = bf_wth-obj.income - bf_wth-obj.incass.
      881                           else assign parstock = 0.
      882   end.
      883   FUNCTION wth-lib_cur-stock-obj-func RETURNS DECIMAL (INPUT parobj-type AS CHARACTER,
      884                                                        INPUT parobj-code AS INTEGER,
      885                                                        INPUT parwth-code AS INTEGER):
      886   define buffer bf_wth-obj for ub.wth-obj.
      887   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
      888                               bf_wth-obj.obj-code = parobj-code and
      889                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
      890   if available bf_wth-obj then return (bf_wth-obj.income - bf_wth-obj.incass).
      891                           else return 0.00.
      892   end function.
      893   FUNCTION wth-lib_cur-stock-host-func RETURNS DECIMAL (INPUT parhost-code AS INTEGER,
      894                                                         INPUT parwth-code  AS INTEGER):
      895   define buffer bf_wth-obj for ub.wth-obj.
      896   define variable v-stock like ub.wth-obj.income no-undo.
      897   for each bf_wth-obj no-lock where bf_wth-obj.host-code = parhost-code and
      898                                     bf_wth-obj.wth-code = parwth-code :
      899     v-stock = v-stock +  bf_wth-obj.income - bf_wth-obj.incass.
      900   end.
      901   return v-stock.
      902   end function.
      903   procedure wth-lib_full-inf-shift:
      904   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parshift-date   like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num    like ub.shift-obj.shift-num   no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.shift-date = parshift-date and                        cur_wth-line.shift-num  = parshift-num  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-sdn no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                                                                             start_wth-line.wth-code   = parwth-code         and                                (start_wth-line.shift-date = parshift-date and                           start_wth-line.shift-num  < parshift-num  or                            start_wth-line.shift-date < parshift-date ) and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-sdn no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income - cur_wth-line.incass              parincome        = cur_wth-line.income                     parincome-cassa  = cur_wth-line.income-cassa               parincome-other  = cur_wth-line.income-other               parincass        = cur_wth-line.incass                     parincass-bank   = cur_wth-line.incass-bank                parincass-other  = cur_wth-line.incass-other.              parincass-cassa  = cur_wth-line.incass-cassa.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income     - start_wth-line.incass               parstock-end     = cur_wth-line.income       - cur_wth-line.incass                 parincome        = cur_wth-line.income       - start_wth-line.income               parincome-cassa  = cur_wth-line.income-cassa - start_wth-line.income-cassa         parincome-other  = cur_wth-line.income-other - start_wth-line.income-other         parincass        = cur_wth-line.incass       - start_wth-line.incass               parincass-bank   = cur_wth-line.incass-bank  - start_wth-line.incass-bank          parincass-other  = cur_wth-line.incass-other - start_wth-line.incass-other.        parincass-cassa  = cur_wth-line.incass-cassa - start_wth-line.incass-cassa.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income - start_wth-line.incass                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      905   end procedure.
      906   procedure wth-lib_full-inf-shift-inter:
      907   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parshift-date   like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num    like ub.shift-obj.shift-num   no-undo.                        define input  parameter parshift-date1  like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num1   like ub.shift-obj.shift-num   no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                     