     1382     assign
     1383       entry( v-num-entry16, v-rid-list ) = "":U
     1384       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1385     .
     1386   end.
     1387   else do:
     1388     assign
     1389       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid16
     1390     .
     1391   end.
     1392       br-wthp:refresh().
     1393       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1394               glog = br-wthp:select-next-row ().
     1395               apply "iteration-changed" to br-wthp in frame Dialog-Frame.
     1396           end.
     1397       if num-entries( v-rid-list ) = 0 then
     1398           hide mark-num in frame Dialog-Frame.
     1399       else
     1400           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1401     end.
     1402     apply "entry" to br-wthp in frame Dialog-Frame.
     1403   END.
