               parincass        = cur_wth-line.incass                     parincass-bank   = cur_wth-line.incass-bank                parincass-other  = cur_wth-line.incass-other.              parincass-cassa  = cur_wth-line.incass-cassa.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income     - start_wth-line.incass               parstock-end     = cur_wth-line.income       - cur_wth-line.incass                 parincome        = cur_wth-line.income       - start_wth-line.income               parincome-cassa  = cur_wth-line.income-cassa - start_wth-line.income-cassa         parincome-other  = cur_wth-line.income-other - start_wth-line.income-other         parincass        = cur_wth-line.incass       - start_wth-line.incass               parincass-bank   = cur_wth-line.incass-bank  - start_wth-line.incass-bank          parincass-other  = cur_wth-line.incass-other - start_wth-line.incass-other.        parincass-cassa  = cur_wth-line.incass-cassa - start_wth-line.incass-cassa.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income - start_wth-line.incass                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      923   end procedure.
      924   procedure wth-lib_full-inf-calend-date-place:
      925   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input parameter parw-p-code  like ub.wth-line.w-p-code  no-undo.                        define input parameter parfact-date like ub.wth-line.fact-date no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                        cur_wth-line.w-p-code   = parw-p-code and                                                               cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.fact-date  = parfact-date  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-cld-pl no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                start_wth-line.w-p-code = parw-p-code and                                                             start_wth-line.wth-code   = parwth-code         and                                start_wth-line.fact-date  < parfact-date   and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-cld-pl no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income-pl - cur_wth-line.incass-pl              parincome        = cur_wth-line.income-pl                     parincome-cassa  = cur_wth-line.income-cassa-pl               parincome-other  = cur_wth-line.income-other-pl               parincass        = cur_wth-line.incass-pl                     parincass-bank   = cur_wth-line.incass-bank-pl                parincass-other  = cur_wth-line.incass-other-pl.              parincass-cassa  = cur_wth-line.incass-cassa-pl.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income-pl     - start_wth-line.incass-pl               parstock-end     = cur_wth-line.income-pl       - cur_wth-line.incass-pl                 parincome        = cur_wth-line.income-pl       - start_wth-line.income-pl               parincome-cassa  = cur_wth-line.income-cassa-pl - start_wth-line.income-cassa-pl         parincome-other  = cur_wth-line.income-other-pl - start_wth-line.income-other-pl         parincass        = cur_wth-line.incass-pl       - start_wth-line.incass-pl               parincass-bank   = cur_wth-line.incass-bank-pl  - start_wth-line.incass-bank-pl          parincass-other  = cur_wth-line.incass-other-pl - start_wth-line.incass-other-pl.        parincass-cassa  = cur_wth-line.incass-cassa-pl - start_wth-line.incass-cassa-pl.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income-pl - start_wth-line.incass-pl                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      926   end procedure.
      927   FUNCTION get-curr RETURNS CHARACTER
      928     (buffer loc-wealth for ub.wealth ) :
      929   define buffer buf_currency for ub.currency.
      930   if loc-wealth.curr-code = ? or loc-wealth.is-money = no then
      931   return loc-wealth.unit-base.
      932   FIND FIRST buf_currency no-lock where
      933             buf_currency.curr-code = loc-wealth.curr-code No-ERROR.
      934   if avail buf_currency then
      935     RETURN buf_currency.curr-abbr.
      936   else return "".
      937   END FUNCTION.
      938   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      939   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      940   procedure fltopend_fltopend :
      941   define input parameter p-parent-handle as handle no-undo .
      942   define input parameter p-qh as handle no-undo .
      943   define input parameter p-flt-open-open-query  as character no-undo .
      944   define input parameter p-where-cond as character no-undo .
      945   define input parameter p-use-indFIRST-query-tail as character no-undo .
      946   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      947   define input parameter p-indexed-reposition as character no-undo .
      948     do
      949     on error undo, return error
      950     :
      951   define variable v-prepare-string as character no-undo .
      952   define variable glog as logical no-undo .
      953   assign
      954   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      955                      p-where-cond + chr(32)  +
      956                      p-use-indFIRST-query-tail + chr(32) +
      957                      p-use-ind-sort-clmn-by + chr(32) +
      958                      p-indexed-reposition
      959   .
      960   assign
      961   glog = p-qh:query-prepare(v-prepare-string) no-error .
      962   if not glog
      963   or error-status:error then do:
      964     message error-status:get-message(1) view-as alert-box .
      965     undo, return error .
      966   end.
      967   assign
      968   glog = p-qh:query-open no-error .
      969   if not glog
      970   or error-status:error then do:
      971     message error-status:get-message(1) view-as alert-box .
      972     undo, return error .
      973   end.
      974     end.
      975   end procedure.
      976   procedure fltopend_fltfindd :
      977   define input parameter p-parent-handle as handle no-undo .
      978   define input parameter p-qh as handle no-undo .
      979   define input parameter p-rowid as rowid no-undo .
      980   define input parameter p-next as logical no-undo .
      981   define input parameter p-lock as integer no-undo .
      982   define input parameter p-bh as handle no-undo .
      983   define input parameter p-where-cond as character no-undo .
      984   define input parameter p-use-index-phrase as character no-undo .
      985   define variable glog as logical no-undo .
      986   define variable v-qh as handle no-undo .
      987   define variable v-bh as handle no-undo .
      988   define variable v-recid as recid no-undo .
      989   define variable v-prepare-string as character no-undo .
      990   do
      991   on error undo, return error
      992   on stop undo, return error
      993   :
      994     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      995     create buffer v-bh for table p-bh buffer-name p-bh:name.
      996     create query v-qh.
      997     v-qh:set-buffers(v-bh).
      998     v-prepare-string = substitute("for each &1 &2 &3"
      999                                     ,v-bh:name
     1000                                     ,p-where-cond
     1001                                     ,p-use-index-phrase).
     1002     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1003     if not glog then do:
     1004       delete object v-qh.
     1005       delete object v-bh.
     1006       undo, return error .
     1007     end.
     1008     glog = v-qh:query-open no-error .
     1009     if not glog then do:
     1010       delete object v-qh.
     1011       delete object v-bh.
     1012       undo, return error .
     1013     end.
     1014     if p-next then do:
     1015       v-qh:reposition-to-rowid(p-rowid) no-error .
     1016       glog = v-qh:get-next( p-lock) no-error .
     1017       glog = v-qh:get-next( p-lock) no-error .
     1018       if not glog or v-qh:query-off-end = yes then do:
     1019         glog = v-qh:get-first( p-lock) no-error .
     1020       end.
     1021     end.
     1022     else do:
     1023       glog = v-qh:get-first( p-lock) no-error .
     1024     end.
     1025     v-recid = v-bh:recid no-error .
     1026     delete object v-qh.
     1027     delete object v-bh.
     1028     return string(v-recid) .
     1029   end.
     1030   end procedure.
     1031   procedure fltopend_fltfindq :
     1032   define input parameter p-parent-handle as handle no-undo .
     1033   define input parameter p-qh as handle no-undo .
     1034   define input parameter p-next as logical no-undo .
     1035   define input parameter p-lock as integer no-undo .
     1036   define input parameter p-flt-open-open-query  as character no-undo .
     1037   define input parameter p-where-cond as character no-undo .
     1038   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1039   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1040   define input parameter p-indexed-reposition as character no-undo .
     1041   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1042   define variable glog as logical no-undo .
     1043   define variable v-qh as handle no-undo .
     1044   define variable v-bh as handle no-undo extent 18.
     1045   define variable v-rowid as rowid no-undo extent 18.
     1046   define variable v-ii as integer no-undo .
     1047   define variable v-prepare-string as character no-undo .
     1048   do
     1049   on error undo, return error
     1050   on stop undo, return error
     1051   :
     1052     create query v-qh.
     1053     do v-ii = 1 to p-qh:num-buffers:
     1054       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1055       assign
     1056       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1057       no-error.
     1058       v-qh:add-buffer(v-bh[v-ii]).
     1059     end.
     1060     assign
     1061     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1062                       p-where-cond + chr(32)  +
     1063                       p-use-indFIRST-query-tail + chr(32) +
     1064                       p-use-ind-sort-clmn-by + chr(32) +
     1065                       p-indexed-reposition
     1066     .
     1067     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1068     if not glog then do:
     1069       delete object v-qh.
     1070       do v-ii = 1 to p-qh:num-buffers:
     1071         delete object v-bh[v-ii].
     1072       end.
     1073       undo, return error .
     1074     end.
     1075     glog = v-qh:query-open no-error .
     1076     if not glog then do:
     1077       delete object v-qh.
     1078       do v-ii = 1 to p-qh:num-buffers:
     1079         delete object v-bh[v-ii].
     1080       end.
     1081       undo, return error .
     1082     end.
     1083     if p-next then do:
     1084       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1085       glog = v-qh:get-next( p-lock) no-error .
     1086       glog = v-qh:get-next( p-lock) no-error .
     1087       if not glog or v-qh:query-off-end = yes then do:
     1088         glog = v-qh:get-first( p-lock) no-error .
     1089       end.
     1090     end.
     1091     else do:
     1092       glog = v-qh:get-first( p-lock) no-error .
     1093     end.
     1094     do v-ii = 1 to p-qh:num-buffers:
     1095       assign
     1096       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1097       no-error.
     1098     end.
     1099     delete object v-qh.
     1100     do v-ii = 1 to p-qh:num-buffers:
     1101       delete object v-bh[v-ii].
     1102     end.
     1103   end.
     1104   end procedure.
