     2364         end.
     2365         assign
     2366           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2367           no-error .
     2368         if error-status :error
     2369         or error-status :get-message(1) <> ""
     2370         then do:
     2371           undo move_block, retry move_block.
     2372         end.
     2373         assign
     2374           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2375         no-error .
     2376         if error-status :error
     2377         or error-status :get-message(1) <> ""
     2378         then do:
     2379           undo move_block, retry move_block.
     2380         end.
     2381         if frame Dialog-Frame :scrollable = true
     2382         then do:
     2383           assign
     2384             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2385           no-error .
     2386           if error-status :error
     2387           or error-status :get-message(1) <> ""
     2388           then do:
     2389             undo move_block, retry move_block.
     2390           end.
     2391         end.
     2392       end.
     2393       if p-move-resize
     2394       then do:
     2395         run diasize_position-resize-button in this-procedure .
     2396       end.
     2397       if v-diasize-wndstore = true
     2398       then do:
     2399         if connected("ub") = true
     2400         then do:
     2401           define variable v-cntxt-db-num        as integer   no-undo .
     2402           define variable v-cntxt-userid        as character no-undo .
     2403           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2404                                             , OUTPUT v-cntxt-userid
     2405                                             ) .
     2406           run gbl/wndsizew.p
     2407             (input  v-cntxt-db-num
     2408             ,input  v-cntxt-userid
     2409             ,input  v-diasize-proc-name
     2410             ,input  'width':u
     2411             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2412             ) .
     2413         end.
     2414       end.
     2415     end.
     2416     assign
     2417       v-diasize-change-size = false
     2418     .
     2419   end procedure.
     2420   procedure diasize_set-width :
     2421     define input  parameter p-new-width  as decimal   no-undo .
     2422     define input  parameter p-move-resize as logical   no-undo .
     2423     do
     2424     on error undo, return error return-value
     2425     :
     2426       run diasize_change-width in this-procedure
     2427         (input  (p-new-width - frame Dialog-Frame :width)
     2428         ,input  p-move-resize
     2429         ) .
     2430     end.
     2431   end procedure.
     2432   procedure diasize_position-resize-button :
     2433     do with frame Dialog-Frame
     2434     :
     2435       hide v-diasize-resize-button .
     2436       assign
     2437         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2438                     - 1
     2439                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2440         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2441                     - 1
     2442                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2443       .
     2444       view v-diasize-resize-button .
     2445     end.
     2446   end procedure.
     2447   on alt-right anywhere
     2448   do:
     2449     run diasize_change-width in this-procedure
     2450       (input 1
     2451       ,input true
     2452       ) .
     2453     return no-apply .
     2454   end.
     2455   on alt-left anywhere
     2456   do:
     2457     run diasize_change-width in this-procedure
     2458       (input -1
     2459       ,input true
     2460       ) .
     2461     return no-apply .
     2462   end.
     2463   on alt-down anywhere
     2464   do:
     2465     run diasize_change-height in this-procedure
     2466       (input 1
     2467       ,input true
     2468       ) .
     2469     return no-apply .
     2470   end.
     2471   on alt-up anywhere
     2472   do:
     2473     run diasize_change-height in this-procedure
     2474       (input -1
     2475       ,input true
     2476       ) .
     2477     return no-apply .
     2478   end.
     2479   on alt-enter of frame Dialog-Frame
     2480   do:
     2481     run diasize_maximize in this-procedure
     2482       (input  ?
     2483       ).
     2484     return no-apply .
     2485   end.
     2486   procedure diasize_end-move :
     2487     do
     2488     on error undo, return error return-value
     2489     :
     2490       define variable v-row-delta as decimal   no-undo .
     2491       define variable v-col-delta as decimal   no-undo .
     2492       define variable v-new-row as decimal   no-undo .
     2493       define variable v-new-col as decimal   no-undo .
     2494       assign
     2495         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2496         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2497       .
     2498       assign
     2499         v-row-delta = v-new-row - frame Dialog-Frame :height
     2500         v-col-delta = v-new-col - frame Dialog-Frame :width
     2501       .
     2502       run diasize_change-height in this-procedure
     2503         (input v-row-delta
     2504         ,input true
     2505         ) .
     2506       run diasize_change-width in this-procedure
     2507         (input v-col-delta
     2508         ,input true
     2509         ) .
     2510     end.
     2511   end procedure.
     2512   procedure diasize_maximize :
     2513     define input  parameter p-action as logical   no-undo .
     2514     do
     2515     on error undo, return error return-value
     2516     :
     2517       if p-action = ?
     2518       then do:
     2519         if v-diasize-need-maximize = true
     2520         then do:
     2521           assign
     2522             p-action = true
     2523           .
     2524         end.
     2525         else do:
     2526           assign
     2527             p-action = false
     2528           .
     2529         end.
     2530       end.
     2531       if p-action = true
     2532       then do:
     2533         run diasize_change-height in this-procedure
     2534           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2535               - frame Dialog-Frame :height-chars
     2536           ,input true
     2537           ) .
     2538         run diasize_change-width in this-procedure
     2539           (input session :width-chars
     2540               - frame Dialog-Frame :width-chars
     2541           ,input true
     2542           ) .
     2543         assign
     2544           v-diasize-need-maximize = false
     2545         .
     2546       end.
     2547       else do:
     2548         run diasize_change-width in this-procedure
     2549           (input v-diasize-orig-frame-width
     2550               - frame Dialog-Frame :width-chars
     2551           ,input true
     2552           ) .
     2553         run diasize_change-height in this-procedure
     2554           (input v-diasize-orig-frame-height
     2555               - frame Dialog-Frame :height-chars
     2556           ,input true
     2557           ) .
     2558         assign
     2559           v-diasize-need-maximize = true
     2560         .
     2561       end.
     2562     end.
     2563   end procedure.
     2564   procedure diasize_restore-orig-size :
     2565     do
     2566     on error undo, return error return-value
     2567     :
     2568       assign
     2569         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2570         v-diasize-current-frame-height = frame Dialog-Frame :height
     2571       .
     2572       run diasize_set-height in this-procedure
     2573         (input  v-diasize-orig-frame-height
     2574         ,input  true
     2575         ) .
     2576       run diasize_set-width in this-procedure
     2577         (input  v-diasize-orig-frame-width
     2578         ,input  true
     2579         ) .
     2580     end.
     2581   end procedure.
     2582   procedure diasize_restore-current-size :
     2583     do
     2584     on error undo, return error return-value
     2585     :
     2586       run diasize_set-height in this-procedure
     2587         (input  v-diasize-current-frame-height
     2588         ,input  true
     2589         ) .
     2590       run diasize_set-width in this-procedure
     2591         (input  v-diasize-current-frame-width
     2592         ,input  true
     2593         ) .
     2594     end.
     2595   end procedure.
     2596   procedure diasize_set-browse-handle :
     2597     define input  parameter p-browse-handle as handle   no-undo .
     2598     define buffer buf_temp-browse-handle for temp-browse-handle .
     2599     do
     2600     on error undo, return error return-value
     2601     :
     2602       assign
     2603         v-diasize-browse-handle = p-browse-handle
     2604       .
     2605       for each buf_temp-browse-handle
     2606       on error undo, return error return-value
     2607       :
     2608         delete buf_temp-browse-handle .
     2609       end.
     2610     end.
     2611   end procedure.
     2612   procedure diasize_add_browse :
     2613     define input  parameter p-browse-type   as character no-undo .
     2614     define input  parameter p-browse-handle as handle    no-undo .
     2615     define buffer buf_temp-browse-handle for temp-browse-handle .
     2616     do
     2617     on error undo, return error return-value
     2618     :
     2619       assign
     2620         v-diasize-browse-number = v-diasize-browse-number + 1
     2621       .
     2622       create buf_temp-browse-handle .
     2623       assign
     2624         buf_temp-browse-handle.browse-type   = p-browse-type
     2625         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2626         buf_temp-browse-handle.browse-handle = p-browse-handle
     2627       .
     2628     end.
     2629   end procedure.
     2630   procedure diasize_init :
     2631     define variable v-default-value    as logical   no-undo .
     2632     define variable v-restore-saved    as logical   no-undo .
     2633     define variable v-resize-value-str as character no-undo .
     2634     do
     2635     on error undo, return error return-value
     2636     :
     2637       do with frame Dialog-Frame
     2638       :
     2639         assign
     2640           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2641           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2642           v-diasize-browse-handle     = browse BR-wthp :handle
     2643         .
     2644         create button v-diasize-resize-button
     2645         assign
     2646           parent        = frame Dialog-Frame :first-child
     2647           label         = "s"
     2648           height-pixels = 16
     2649           width-pixels  = 16
     2650           visible       = true
     2651           sensitive     = true
     2652           movable       = true
     2653           triggers:
     2654             on end-move persistent run diasize_end-move in this-procedure .
     2655           end triggers.
     2656         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2657         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2658         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2659         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2660         assign
     2661           v-diasize-wndmax = false
     2662         .
     2663         if connected("ub") = true
     2664         then do:
     2665           define variable v-cntxt-db-num        as integer   no-undo .
     2666           define variable v-cntxt-userid        as character no-undo .
     2667           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2668                                             , OUTPUT v-cntxt-userid
     2669                                             ) .
     2670           run gbl/wndpar_r.p
     2671             (input  v-cntxt-db-num
     2672             ,input  v-cntxt-userid
     2673             ,input  'wndmax':U
     2674             ,output v-diasize-wndmax
     2675             ,output v-default-value
     2676             ) .
     2677         end.
     2678         assign
     2679           v-diasize-wndstore = false
     2680         .
     2681         if connected("ub") = true
     2682         then do:
     2683           run gbl/wndpar_r.p
     2684             (input  v-cntxt-db-num
     2685             ,input  v-cntxt-userid
     2686             ,input  'wndstore':U
     2687             ,output v-diasize-wndstore
     2688             ,output v-default-value
     2689             ) .
     2690         end.
     2691         assign
     2692           v-diasize-proc-name = entry(1, program-name(2), '.')
     2693         .
     2694         if v-diasize-wndstore = true
     2695         then do:
     2696           assign
     2697             v-restore-saved = false
     2698           .
     2699           if connected("ub") = true
     2700           then do:
     2701             run gbl/wndsizer.p
     2702               (input  v-cntxt-db-num
     2703               ,input  v-cntxt-userid
     2704               ,input  v-diasize-proc-name
     2705               ,input  'height':u
     2706               ,output v-resize-value-str
     2707               ) .
     2708             if v-resize-value-str <> '':U
     2709             then do:
     2710               run diasize_change-height in this-procedure
     2711                 (input  integer(v-resize-value-str)
     2712                 ,input  true
     2713                 ) .
     2714               assign
     2715                 v-restore-saved = true
     2716               .
     2717             end.
     2718           end.
     2719           if connected("ub") = true
     2720           then do:
     2721             run gbl/wndsizer.p
     2722               (input  v-cntxt-db-num
     2723               ,input  v-cntxt-userid
     2724               ,input  v-diasize-proc-name
     2725               ,input  'width':u
     2726               ,output v-resize-value-str
     2727               ) .
     2728             if v-resize-value-str <> '':U
     2729             then do:
     2730               run diasize_change-width in this-procedure
     2731                 (input  integer(v-resize-value-str)
     2732                 ,input  true
     2733                 ) .
     2734               assign
     2735                 v-restore-saved = true
     2736               .
     2737             end.
     2738           end.
     2739           if v-restore-saved <> true
     2740           then do:
     2741             if v-diasize-wndmax = true
     2742             then do:
     2743               run diasize_maximize in this-procedure
     2744                 (input  true
     2745                 ) .
     2746             end.
     2747           end.
     2748         end.
     2749         else do:
     2750           if v-diasize-wndmax = true
     2751           then do:
     2752             run diasize_maximize in this-procedure
     2753               (input  true
     2754               ) .
     2755           end.
     2756         end.
     2757       end.
     2758     end.
     2759   end procedure.
     2760   procedure diasize_need-full-display :
     2761     define output parameter p-need-full-display as logical   no-undo .
     2762     do
     2763     on error undo, return error return-value
     2764     :
     2765       assign
     2766         p-need-full-display = v-diasize-need-full-display
     2767       .
     2768       assign
     2769         v-diasize-need-full-display = false
     2770       .
     2771     end.
     2772   end procedure.
     2773   procedure get-context :
     2774      define output parameter p-db-num as integer          no-undo.
     2775      define output parameter p-user-id as character        no-undo.
     2776      define variable v-login               as character    no-undo.
     2777      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2778      define buffer buf_user-login  for ub.user-login .
     2779      do
     2780      on error undo, return error
     2781      :
     2782            FIND FIRST buf_sys-ctrl no-lock.
     2783            ASSIGN
     2784               v-login = USERID("ub")
     2785               p-db-num = buf_sys-ctrl.db-num
     2786            .
     2787            FIND FIRST buf_user-login
     2788                 WHERE buf_user-login.db-num = p-db-num
     2789                   AND buf_user-login.user-login = v-login
     2790                 no-lock
     2791                 no-error
     2792                 .
     2793            IF AVAILABLE buf_user-login
     2794            THEN DO:
     2795               assign
     2796                  p-user-id = buf_user-login.user-id
     2797               .
     2798            END.
     2799      end.
     2800   end procedure.
     2801       run diasize_init in this-procedure .
     2802   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2803   procedure set-filter-name :
     2804   define input parameter p-filter-name as character no-undo .
     2805     do with frame Dialog-Frame:
     2806       if p-filter-name > "" then do:
     2807         assign
     2808           frame Dialog-Frame:title
     2809             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2810         .
     2811         assign
     2812           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2813         .
     2814       end.
     2815       else do:
     2816         assign
     2817           b-sch :tooltip = ""
     2818         .
     2819       end.
     2820     end.
     2821   end procedure.
     2822   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2823   on INS of frame Dialog-Frame anywhere do:
     2824     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2825     return no-apply.
     2826   end.
     2827   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2828   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     2829     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     2830     return no-apply.
     2831   end.
     2832   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2833   on F4 of frame Dialog-Frame anywhere do:
     2834     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame Dialog-Frame. END.
     2835     return no-apply.
     2836   end.
     2837   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2838   on F8 of frame Dialog-Frame anywhere do:
     2839     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     2840     return no-apply.
     2841   end.
     2842   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2843   on F2 of frame Dialog-Frame anywhere do:
     2844     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2845     return no-apply.
     2846   end.
     2847   define variable vss-include-info26 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2848   on F2 of frame Dialog-Frame anywhere do:
     2849     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2850     return no-apply.
     2851   end.
     2852   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2853   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     2854     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     2855     return no-apply.
     2856   end.
     2857   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2858   do:
     2859     br-wthp :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2860   end.
     2861   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2862   on f5 of frame Dialog-Frame anywhere
     2863   do:
     2864      v-doc-rec = ?. if available X_wth-par then assign v-doc-rec = recid( X_wth-par). run openbr in this-procedure ( input yes, input no, input '':U).                reposition br-wthp to recid v-doc-rec no-error. APPLY 'ENTRY' to br-wthp. APPLY 'VALUe-CHANGED' to br-wthp.
     2865       apply "VALUE-CHANGED" to BR-wthp.
     2866   end.
     2867   MAIN-BLOCK:
     2868   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2869      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2870   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2871     run mainmenu_getcntxt in parparentproc
     2872       (output v-cntxt-db-num
     2873       ,output v-cntxt-userid
     2874       ,output v-cntxt-level
     2875       ,output v-cntxt-host-code-obj
     2876       ,output v-cntxt-obj-type
     2877       ,output v-cntxt-obj-code
     2878       ,output v-cntxt-db-num-obj
     2879       ,output v-cntxt-is-admin
     2880       ) .
     2881     if p-list-mode = 'МЦ':U then do:
     2882       FIND FIRST b-wealth No-LOCK where
     2883                   b-wealth.wth-code = pwth-code No-ERROR.
     2884       IF NOT AVAIL b-wealth then do:
     2885         message vss-workfile vss-revision vss-description skip
     2886         "Не найдена материальная ценность с кодом " pwth-code
     2887         view-as alert-box.
     2888         return error.
     2889       end.
     2890     end.
     2891     v-rid-list = p-rid-list.
     2892     if v-rid-list <> '':U then do:
     2893       assign
     2894       v-doc-rec = integer(v-rid-list)
     2895       no-error .
     2896     end.
     2897     RUN Myenable in this-procedure .
     2898     RUN OpenBR in this-procedure ( input yes, input no, input '':U).
     2899     APPLY "ENTRY" to br-wthp.
     2900     WAIT-FOR GO OF FRAME Dialog-Frame.
     2901   END.
     2902   RUN disable_UI in this-procedure .
     2903   PROCEDURE disable_UI :
     2904     HIDE FRAME Dialog-Frame.
     2905   END PROCEDURE.
     2906   PROCEDURE enable_UI :
     2907     DISPLAY mark-num
     2908         WITH FRAME Dialog-Frame.
     2909     ENABLE b-quit B-mark B-sel B-add B-chg B-del B-print B-hist B-sch B-Help
     2910            BR-wthp mark-num
     2911         WITH FRAME Dialog-Frame.
     2912     VIEW FRAME Dialog-Frame.
     2913   END PROCEDURE.
     2914   PROCEDURE MyEnable :
     2915   define variable glog as logical no-undo .
     2916   ENABLE
     2917   br-wthp
     2918   b-quit
     2919   b-mark WHEN LOOKUP("b-mark":U, bttns) > 0
     2920   b-sel  WHEN LOOKUP("b-sel":U, bttns) > 0
     2921   b-print
     2922   b-sch
     2923   b-help
     2924   b-parts
     2925   b-series
     2926   b-add WHEN (LOOKUP("b-add":U, bttns) > 0 AND g#db-num = 0)
     2927   b-chg WHEN (LOOKUP("b-add":U, bttns) > 0 AND g#db-num = 0)
     2928   b-hist
     2929   WITH FRAME Dialog-Frame.
     2930   VIEW FRAME Dialog-Frame.
     2931   HIDE
     2932   b-del in FRAME Dialog-Frame.
     2933   if available X_wth-par then
     2934   glog = br-wthp:select-focused-row( ).
     2935   END PROCEDURE.
     2936   PROCEDURE OpenBr :
     2937   define input  parameter p-open-query     as logical   no-undo .
     2938   define input  parameter p-find-next      as logical   no-undo .
     2939   define input  parameter p-find-condition as character no-undo .
     2940   define variable l-query-was-opened as logical no-undo .
     2941   run waitfram-show in this-procedure (  input "Ждите...").
     2942   define variable sort-column-phrase as character no-undo .
     2943   case sort-column-name :
     2944     when "" then do:
     2945       assign
     2946         sort-column-phrase = ""
     2947       .
     2948     end.
     2949     otherwise do:
     2950       assign
     2951         sort-column-phrase = "by " + sort-column-name
     2952       .
     2953     end.
     2954   end case.
     2955   CASE p-list-mode:
     2956       when 'все':U then do:
     2957           ASSIGN
     2958           frame Dialog-Frame:TITLE = "Номиналы материальных ценностей "
     2959           filter-point = "Номиналы материальных ценностей " + p-list-mode
     2960           filter-label = substitute("&1", filter-label0)
     2961           .
     2962   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2963   define variable  l-disable-where-32  as logical   no-undo .
     2964   define variable  l-filter-open-32    as logical   .
     2965   define variable  flt-rec-32       as recid     no-undo .
     2966   define variable  filter-name-32      as character no-undo .
