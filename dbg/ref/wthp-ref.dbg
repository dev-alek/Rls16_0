      458   procedure prn-lib-open-stream :
      459     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      460     define input parameter p-page-size    as integer no-undo .
      461     define input parameter p-is-stream    as logical no-undo .
      462     define input parameter p-append       as logical no-undo .
      463     define variable v-report-name as character no-undo .
      464     do
      465       on error undo, return error
      466       :
      467       run prn-lib-get-report-name  in this-procedure (
      468         input parParentProc
      469         ,output v-report-name
      470         ).
      471       if p-is-stream then
      472       do:
      473         if p-append then
      474         do:
      475           output stream PrnLibStream to value( v-report-name )
      476             page-size value(p-page-size) append .
      477         end.
      478         if not p-append then
      479         do:
      480           output stream PrnLibStream to value( v-report-name )
      481             page-size value(p-page-size) .
      482         end.
      483       end.
      484       if not p-is-stream then
      485       do:
      486         if p-append then
      487         do:
      488           output to value( v-report-name )
      489             page-size value(p-page-size) append .
      490         end.
      491         if not p-append then
      492         do:
      493           output to value( v-report-name )
      494             page-size value(p-page-size) .
      495         end.
      496       end.
      497     end.
      498   end procedure.
      499   procedure prn-lib-open-exp :
      500     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      501     define input parameter p-is-stream    as logical no-undo .
      502     define input parameter p-is-append    as logical no-undo .
      503     define output parameter p-ReportFileName as char init "report" no-undo.
      504     define output parameter p-process as logical no-undo .
      505     define variable glog as logical no-undo .
      506     do
      507       on error undo, return error
      508       :
      509       SYSTEM-DIALOG GET-FILE p-ReportFileName
      510         TITLE      "Укажите путь"
      511         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      512         ASK-OVERWRITE
      513         CREATE-TEST-FILE
      514         SAVE-AS
      515         USE-FILENAME
      516         DEFAULT-EXTENSION "txt"
      517         UPDATE glog
      518         .
      519       if not glog then  return.
      520       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      521       if p-is-stream then
      522       do:
      523         if p-is-append then
      524         do:
      525           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      526         end.
      527         else
      528         do:
      529           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      530         end.
      531       end.
      532       else
      533       do:
      534         if p-is-append then
      535         do:
      536           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      537         end.
      538         else
      539         do:
      540           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      541         end.
      542       end.
      543       p-process = yes.
      544     end.
      545   end procedure.
      546   procedure prn-lib-get-report-name :
      547     define input parameter parParentProc  as widget-handle no-undo.
      548     define output parameter p-report-name as character no-undo .
      549     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      550   end procedure.
      551   procedure prn-lib-reportviewer-report-name :
