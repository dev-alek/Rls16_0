      357   define variable c-point  as character no-undo .
      358   define variable tbl      as character no-undo .
      359   define variable join-tbl as character no-undo .
      360   define variable fld      as character no-undo .
      361   define variable lab      as character no-undo .
      362   define variable spr      as character no-undo .
