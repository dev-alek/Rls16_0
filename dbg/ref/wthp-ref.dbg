      412   define  stream PrnLibStream.
      413   procedure prn-lib-prn-file :
      414     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      415     define input parameter p-DIsabledoptions as integer no-undo .
      416     define variable v-report-name as character no-undo .
      417     define variable v-user-action as character no-undo .
