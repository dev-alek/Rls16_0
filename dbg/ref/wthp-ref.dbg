      365   procedure fltfield-clear :
      366     define output parameter loc-fld as character no-undo.
      367     define output parameter loc-lab as character no-undo .
      368     define output parameter loc-spr as character no-undo .
      369     define output parameter loc-dim as character no-undo .
      370     assign
      371       loc-fld = ""
      372       loc-lab = ""
      373       loc-spr = ""
      374       loc-dim = "0"
      375     .
      376   end procedure .
      377   procedure fltfield-add :
      378     define input        parameter par-fld as character no-undo.
      379     define input        parameter par-lab as character no-undo .
      380     define input        parameter par-spr as character no-undo .
      381     define input-output parameter loc-fld as character no-undo.
      382     define input-output parameter loc-lab as character no-undo .
      383     define input-output parameter loc-spr as character no-undo .
      384     define input-output parameter loc-dim as character no-undo .
      385     do
      386     on error undo, return error
      387     :
      388       assign
      389       loc-fld = if loc-dim = '0'
      390                 then par-fld
      391                 else (loc-fld + chr(44) + par-fld)
      392       loc-lab = if loc-dim = '0'
      393                 then par-lab
      394                 else (loc-lab + chr(44) + par-lab)
      395       loc-spr = if loc-dim = '0'
      396                 then par-spr
      397                 else (loc-spr + chr(44) + par-spr)
      398       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      399                 string(integer(if num-entries(loc-dim) > 1
      400                               then entry(2, loc-dim)
      401                               else entry(1, loc-dim)
      402                               ) + 1)
      403       no-error
      404       .
      405     end.
      406   end procedure.
