     4125       return.
     4126     end.
     4127   end.
     4128   if LOOKUP("one":U, p-mode, chr(4)) > 0 then do:
     4129     find first X_fin-doc no-lock where
     4130                 X_fin-doc.host-code = p-host-code
     4131             AND X_fin-doc.fin-doc-code = p-fin-doc-code no-error .
     4132     if not available X_fin-doc then do:
