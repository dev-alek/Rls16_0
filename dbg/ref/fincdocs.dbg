     1547   DEFINE VARIABLE sch-prn-doc-code AS CHARACTER FORMAT "X(16)":U
     1548        LABEL "номеру"
     1549        VIEW-AS FILL-IN
     1550        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1551   DEFINE VARIABLE sch-r-schet AS CHARACTER FORMAT "X(35)":U
