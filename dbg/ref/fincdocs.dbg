     1555   DEFINE VARIABLE RS-cli-type AS CHARACTER
     1556        VIEW-AS RADIO-SET HORIZONTAL
     1557        RADIO-BUTTONS
     1558             "Item 1", "1",
     1559   "Item 1", "2"
