     5328   PROCEDURE proc-br-c-fin-doc :
     5329   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5330   if b-sel:sensitive in frame Dialog-Frame then dO:
     5331       if b-mark:sensitive then do:
     5332           apply "choose" to b-mark in frame Dialog-Frame.
     5333       end.
     5334       else do:
     5335           apply "choose" to b-sel in frame Dialog-Frame.
     5336       end.
     5337   end.
     5338   else do:
     5339       if b-lookup:sensitive then
     5340       apply "choose" to b-lookup in frame Dialog-Frame.
     5341   end.
     5342   END PROCEDURE.
     5343   PROCEDURE proc-find-bik :
     5344   define input parameter p-next as logical no-undo.
     5345   define input parameter p-bik like ub.fin-doc.receiver-bik no-undo.
     5346   assign
     5347   frame Dialog-Frame Rs-receiver-payer.
     5348   assign
     5349   sch-doc-date = ?
     5350   sch-fact-date = ?
     5351   sch-pay-date = ?
     5352   .
     5353   display
     5354   "":U @ sch-prn-doc-code
     5355   "":U @ sch-name
     5356   0 @ sch-cli-code
     5357   0 @ sch-curr-code
     5358   sch-doc-date
     5359   sch-fact-date
     5360   sch-pay-date
     5361   with frame Dialog-Frame.
     5362   if not is-cash-mode then
     5363   display
     5364   "":U @ sch-r-schet
     5365   "":U @ sch-c-schet
     5366   with frame Dialog-Frame .
     5367   assign
     5368   p-bik = replace(p-bik, chr(34), "":U)
     5369   p-bik = replace(p-bik, chr(39), chr(39) + chr(39))
     5370   p-bik = chr(34) + p-bik + chr(34).
     5371   if RS-receiver-payer = "receiver":U then do:
     5372   run OpenBr in this-procedure
     5373       (input false
     5374       ,input p-next
     5375       ,input substitute("and X_c-fin-doc.receiver-bik   begins &1 "
     5376         , p-bik)
     5377       ).
     5378   end.
     5379   if RS-receiver-payer = "payer":U then do:
     5380   run OpenBr in this-procedure
     5381       (input false
     5382       ,input p-next
     5383       ,input substitute("and X_c-fin-doc.payer-bik   begins &1 "
     5384         , p-bik)
     5385       ).
     5386   end.
     5387   apply "entry":u to sch-bik in frame Dialog-Frame .
     5388   END PROCEDURE.
