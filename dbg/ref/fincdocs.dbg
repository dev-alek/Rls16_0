     3272       apply "VALUE-CHANGED" to br-c-fin-doc.
     3273   end.
     3274   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3275   procedure set-filter-name :
     3276   define input parameter p-filter-name as character no-undo .
     3277     do with frame Dialog-Frame:
     3278       if p-filter-name > "" then do:
     3279         assign
     3280           frame Dialog-Frame:title
     3281             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3282         .
     3283         assign
     3284           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3285         .
     3286       end.
     3287       else do:
     3288         assign
     3289           b-sch :tooltip = ""
     3290         .
     3291       end.
     3292     end.
     3293   end procedure.
     3294   def var sort-labelbr-c-fin-doc   as character no-undo .
     3295   def var sort-clmnbr-c-fin-doc    as handle    no-undo .
     3296   def var cur-clmnbr-c-fin-doc     as handle    no-undo .
     3297   def var cur-clmn-locbr-c-fin-doc as integer   no-undo .
     3298   def var re-querybr-c-fin-doc     as logical   initial no no-undo .
     3299   on start-search, ctrl-o of br-c-fin-doc in frame Dialog-Frame do:
     3300      run sort-brbr-c-fin-doc
     3301        (input (if available X_c-fin-doc
     3302                then recid(X_c-fin-doc)
     3303                else ?
     3304               )
     3305        ).
     3306   end.
     3307   PROCEDURE sort-brbr-c-fin-doc :
     3308     define input parameter p-recid as recid no-undo .
     3309     if re-querybr-c-fin-doc = no then do:
     3310       assign
     3311          cur-clmnbr-c-fin-doc = br-c-fin-doc:current-column in frame Dialog-Frame
     3312       .
     3313       if sort-clmnbr-c-fin-doc <> ? then sort-clmnbr-c-fin-doc:column-fgcolor = 0.
     3314       if cur-clmnbr-c-fin-doc = sort-clmnbr-c-fin-doc then do:
     3315         assign
     3316            sort-labelbr-c-fin-doc = ""
     3317            sort-clmnbr-c-fin-doc = ?
     3318         .
     3319        end.
     3320        else do:
     3321          assign
     3322            sort-labelbr-c-fin-doc = cur-clmnbr-c-fin-doc:label
     3323            sort-clmnbr-c-fin-doc  = cur-clmnbr-c-fin-doc
     3324            sort-clmnbr-c-fin-doc:column-fgcolor = 4
     3325          .
     3326        end.
     3327      end.
     3328     assign
     3329       cur-clmn-locbr-c-fin-doc = 1
     3330     .
     3331     def var column-handle as handle no-undo .
     3332     column-handle = br-c-fin-doc:first-column.
     3333     do while valid-handle(column-handle) :
     3334       if column-handle = cur-clmnbr-c-fin-doc then do:
     3335         leave .
     3336       end.
     3337       column-handle = column-handle:NEXT-COLUMN.
     3338       assign
     3339         cur-clmn-locbr-c-fin-doc = cur-clmn-locbr-c-fin-doc + 1
     3340       .
     3341     end.
     3342     case sort-labelbr-c-fin-doc:
     3343           when X_c-fin-doc.prn-doc-code:label in browse br-c-fin-doc then DO:    assign       sort-column-name = "X_c-fin-doc.prn-doc-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3344       otherwise do:
     3345         assign
     3346           sort-column-name = ""
     3347         .
     3348         run OpenBr in this-procedure ( input yes, input no, input '':U).
     3349           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-c-fin-doc') then do:
     3350             run mv-brw-defaultbr-c-fin-doc.
     3351           end.
     3352         if sort-labelbr-c-fin-doc <> "" then do:
     3353           assign
     3354             cur-clmnbr-c-fin-doc:column-fgcolor = 0
     3355           .
     3356         end.
     3357         assign
     3358           cur-clmn-locbr-c-fin-doc = ?
     3359         .
     3360       end.
     3361     end case.
     3362       if cur-clmn-locbr-c-fin-doc <> ? then do:
     3363         if can-do( this-procedure:internal-entries, 'ch-clmnbr-c-fin-doc') then do:
     3364           run ch-clmnbr-c-fin-doc in this-procedure (cur-clmn-locbr-c-fin-doc).
     3365         end.
     3366       end.
     3367     if p-recid <> ? then do:
     3368       reposition br-c-fin-doc to recid p-recid no-error.
     3369       apply "value-changed" to br-c-fin-doc in frame Dialog-Frame.
     3370     end.
     3371     apply "entry" to br-c-fin-doc in frame Dialog-Frame.
     3372   END PROCEDURE.
     3373   procedure re-open-query-srt-clmnbr-c-fin-doc:
     3374   if cur-clmnbr-c-fin-doc = ? then do:
     3375      run OpenBr in this-procedure ( input yes, input no, input '':U).
     3376   end.
     3377   else do:
     3378      assign re-querybr-c-fin-doc = yes.
     3379      run sort-brbr-c-fin-doc
     3380        (input (if available X_c-fin-doc
     3381                then recid(X_c-fin-doc)
     3382                else ?
     3383               )
     3384        ).
     3385      assign re-querybr-c-fin-doc = no.
     3386   end.
     3387   end.
     3388   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3389   do:
     3390     br-c-fin-doc :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3391   end.
