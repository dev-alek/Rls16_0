     4061   MAIN-BLOCK:
     4062   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4063      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4064   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4065     run mainmenu_getcntxt in parparentproc
     4066       (output v-cntxt-db-num
     4067       ,output v-cntxt-userid
     4068       ,output v-cntxt-level
     4069       ,output v-cntxt-host-code-obj
     4070       ,output v-cntxt-obj-type
     4071       ,output v-cntxt-obj-code
     4072       ,output v-cntxt-db-num-obj
     4073       ,output v-cntxt-is-admin
     4074       ) .
     4075     find first X_curr_sysconf no-lock where
     4076                     X_curr_sysconf.host-code = p-curr-host-code no-error.
     4077     if not available X_curr_sysconf then do:
     4078       message
     4079       vss-workfile vss-revision vss-description skip
     4080       "Неверное значение параметра вызова p-curr-host-code"
     4081       p-curr-host-code
     4082       view-as alert-box ERROR.
     4083       return.
     4084     end.
     4085    if LOOKUP(p-mode, ('все':U + chr(4) +
     4086                       "One":U + chr(4) +
     4087                       'удаление':U + chr(4) +
     4088                       'объект':U),
     4089             chr(4)) = 0
     4090        then dO:
     4091       message
     4092       vss-workfile vss-revision vss-description skip
     4093       "Неверное значение параметров вызова p-mode"
     4094       p-mode
     4095       view-as alert-box ERROR.
     4096       return.
     4097    end.
     4098   find first X_clients-host no-lock where
     4099               X_clients-host.obj-type = 'орг':U
     4100           and X_clients-host.obj-code = p-host-code no-error.
     4101   if not available X_clients-host then do:
     4102       message
     4103       vss-workfile vss-revision vss-description skip
     4104       "Неверное значение параметра вызова p-host-code"
     4105       p-host-code
     4106       view-as alert-box ERROR.
     4107       return.
     4108   end.
     4109   if LOOKUP('все':U, p-mode, chr(4)) > 0
     4110   or LOOKUP('объект':U, p-mode, chr(4)) > 0
     4111   or LOOKUP('удаленные':U, p-mode, chr(4)) > 0
     4112   then do:
     4113     assign is-cash-mode = no.
     4114   end.
     4115   if lookup('объект':U, p-mode, chr(4) ) > 0 then do:
     4116     find first X_obj no-lock where
     4117             X_obj.obj-type = p-obj-type
     4118         and X_obj.obj-code = p-obj-code no-error.
     4119     if not available x_OBJ then do:
