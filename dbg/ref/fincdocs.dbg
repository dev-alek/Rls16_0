     5318                      , INPUT (filter-point + chr(4) + filter-label)
     5319                      , INPUT tbl
     5320                      , INPUT join-tbl
     5321                      , INPUT fld
     5322                      , INPUT lab
     5323                      , INPUT spr
     5324                      , INPUT dim ).
     5325     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
