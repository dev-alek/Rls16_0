     1503   DEFINE VARIABLE ED-notes AS CHARACTER
     1504        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1505        SIZE 98 BY 2
     1506        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1507   DEFINE VARIABLE f-poisk AS CHARACTER FORMAT "X(256)":U INITIAL "ПОИСК ПО:"
     1508         VIEW-AS TEXT
     1509        SIZE 9.6 BY .67
     1510        FGCOLOR 4  NO-UNDO.
     1511   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1512         VIEW-AS TEXT
     1513        SIZE 6 BY 1
     1514        FGCOLOR 4  NO-UNDO.
     1515   DEFINE VARIABLE sch-BIK AS CHARACTER FORMAT "X(9)":U
     1516        LABEL "БИК"
     1517        VIEW-AS FILL-IN
     1518        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1519   DEFINE VARIABLE sch-c-schet AS CHARACTER FORMAT "X(9)":U
     1520        LABEL "Корр.счет"
     1521        VIEW-AS FILL-IN
     1522        SIZE 22 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1523   DEFINE VARIABLE sch-cli-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
     1524        LABEL "код"
