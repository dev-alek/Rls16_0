     5511   PROCEDURE proc-find-date :
     5512   define input parameter p-next as logical no-undo.
     5513   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     5514   define input parameter p-what-date as character no-undo.
     5515   define variable v-date-chr as character no-undo.
     5516   if p-date = ? then return .
     5517   display
     5518   "":U @ sch-BIK
     5519   "":U @ sch-name
     5520   0 @ sch-cli-code
     5521   "":U @ sch-c-schet
     5522   0 @ sch-curr-code
     5523   "":U @ sch-prn-doc-code
     5524   "":U @ sch-r-schet
     5525   with frame Dialog-Frame.
     5526   CASE p-what-date:
     5527       when "doc-date":U then do:
     5528         assign
     5529         sch-pay-date = ?
     5530         sch-fact-date = ?
     5531         .
     5532         display
     5533         sch-fact-date
     5534         sch-pay-date
     5535         with frame Dialog-Frame.
     5536       end.
     5537       when "fact-date":U then do:
     5538         assign
     5539         sch-doc-date = ?
     5540         sch-pay-date = ?
     5541         .
     5542         display
     5543         sch-doc-date
     5544         sch-pay-date
     5545         with frame Dialog-Frame.
     5546       end.
     5547       when "pay-date":U then do:
     5548         assign
     5549         sch-doc-date = ?
     5550         sch-fact-date = ?
     5551         .
     5552         display
     5553         sch-fact-date
     5554         sch-doc-date
     5555         with frame Dialog-Frame.
     5556       end.
     5557   END CASE.
     5558   assign
     5559   v-date-chr = string(day(p-date)) + chr(47) +
     5560                    string(month(p-date)) + chr(47) +
     5561                    string(year(p-date)).
     5562   CASE p-what-date:
     5563       when "doc-date":U then do:
     5564          run OpenBr in this-procedure
     5565           (input false
     5566           ,input true
     5567           ,input substitute("and X_c-fin-doc.doc-date = &1 "
     5568             , v-date-chr)
     5569           ).
     5570         apply "entry":u to sch-doc-date in frame Dialog-Frame.
     5571       end.
     5572       when "fact-date":U then do:
     5573          run OpenBr in this-procedure
     5574           (input false
     5575           ,input true
     5576           ,input substitute("and X_c-fin-doc.fact-date = &1 "
     5577             , v-date-chr)
     5578           ).
     5579         apply "entry":u to sch-fact-date in frame Dialog-Frame.
     5580       end.
     5581           when "pay-date":U then do:
     5582          run OpenBr in this-procedure
     5583           (input false
     5584           ,input true
     5585           ,input substitute("and X_c-fin-doc.pay-date = &1 "
     5586             , v-date-chr)
     5587           ).
     5588         apply "entry":u to sch-pay-date in frame Dialog-Frame.
     5589       end.
     5590   END CASE.
     5591   END PROCEDURE.
