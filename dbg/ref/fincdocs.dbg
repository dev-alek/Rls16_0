     1542        SIZE 31 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1543   DEFINE VARIABLE sch-pay-date AS DATE FORMAT "99/99/9999":U
