      657   define  stream PrnLibStream.
      658   procedure prn-lib-prn-file :
      659     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      660     define input parameter p-DIsabledoptions as integer no-undo .
      661     define variable v-report-name as character no-undo .
      662     define variable v-user-action as character no-undo .
      663     define variable v-printed     as logical   no-undo .
      664     define variable v-exist       as logical   no-undo .
      665     do
      666       on error undo, return error
      667       :
      668       run prn-lib-get-report-name  in this-procedure (
      669         input parParentProc
