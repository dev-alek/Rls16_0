     1089   define new global shared variable g#lib-trn2 as handle no-undo .
     1090   define new global shared variable g#lib-trn3 as handle no-undo .
     1091   define new global shared variable g#lib-trn4 as handle no-undo .
     1092   define variable filter-point as character no-undo init "fincdocs" .
     1093   define variable filter-point0 as character no-undo init "fincdocs" .
     1094   define variable filter-label as character no-undo init "Список истории платажей" .
     1095   define variable filter-label0 as character no-undo init "Список истории платежей" .
     1096   define variable v-rid-list as character no-undo .
     1097   define variable sort-column-name as character no-undo .
     1098   define variable client-option as character no-undo.
     1099   define variable schet-option as character no-undo.
     1100   DEFINE VARIABLE v-db-num like ub.db.db-num no-undo .
     1101   define variable v-doc-rec as recid no-undo .
     1102   define variable is-cash-mode as logical no-undo init ?.
     1103   DEFINE VARIABLE v-fin-doc-shift-name-num AS CHARACTER NO-UNDO.
     1104   define variable dops as character no-undo format "X(250)".
     1105   define variable dopst as character no-undo format "X(1)".
     1106   DEFINE BUFFER X_cli-fin-schet FOR ub.fin-schet.
     1107   DEFINE BUFFER X_clients FOR ub.clients.
     1108   DEFINE BUFFER X_obj FOR ub.clients.
     1109   DEFINE BUFFER X_contract FOR ub.contract.
     1110   DEFINE BUFFER X_currency FOR ub.currency.
     1111   DEFINE BUFFER X_fin-schet FOR ub.fin-schet.
     1112   define buffer X_curr_sysconf for ub.sysconf.
     1113   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1114   define  temp-table temp-changes no-undo
     1115   field f_name as character
     1116   field l_name as character
     1117   field v_old as character
     1118   field v_new as character
     1119   field t_name as character
     1120   field num_ as integer
     1121   field uniq-key-rec as character
     1122   field action as integer
     1123   field fNotChange as logical
     1124   index pi is unique primary
     1125   num_
     1126   t_name
     1127   f_name
     1128   index
     1129   Chan
     1130   fnotChange
     1131   t_name
     1132   f_name
     1133   index imain uniq-key-rec
     1134   .
     1135   FUNCTION get-all-fields returns character (p-file-name as character ):
     1136   define variable v-dop as character no-undo .
     1137     find first _file no-lock where _file._file-name = p-file-name no-error .
     1138     if not available _file then return "":U.
     1139     for each _field no-lock where
     1140              _field._file-recid = recid(_file) :
     1141       assign
     1142       v-dop = v-dop + _field._field-name + chr(44)
     1143       .
     1144     end.
     1145     return trim(v-dop).
     1146   END FUNCTION.
     1147   PROCEDURE proc-full-temp-changes :
     1148     define input  parameter p-hst-handle as handle    no-undo .
     1149     define input  parameter p-main-table as character no-undo .
     1150     define input  parameter p-field-list as character no-undo .
     1151     define input  parameter p-label-form as character no-undo .
     1152     define variable h-new-buf         as handle    no-undo .
     1153     define variable h-main-buf        as handle    no-undo .
     1154     define variable h-for-comp        as handle    no-undo .
     1155     define variable v-inform          as character no-undo .
     1156     define variable v-ind             as integer   no-undo .
     1157     define variable v-idx-field-qnty  as integer   no-undo .
     1158     define variable v-num-entries     as integer   no-undo .
     1159     define variable fh                as handle    no-undo .
     1160     define variable fh-main           as handle    no-undo .
     1161     define variable fh-old            as handle    no-undo .
     1162     define variable fh-new            as handle    no-undo .
     1163     define variable v-field-name      as character no-undo .
     1164     define variable v-field-lvl       as character no-undo .
     1165     define variable v-field-form      as character no-undo .
     1166     define variable v-search-exp      as character no-undo .
     1167     define variable v-srch-main       as character no-undo .
     1168     define variable v-word-link       as character no-undo .
     1169     define variable v-av-chip-num     as logical   no-undo .
     1170     define variable v-main-pi-fld-lst as character no-undo .
     1171     define variable v-main-fld-lst    as character no-undo .
     1172     define variable v-delim-list      as character no-undo .
     1173     define variable v-label           as character no-undo .
     1174     define variable v-old-value       as character no-undo case-sensitive.
     1175     define variable v-new-value       as character no-undo case-sensitive.
     1176     define variable v-chg-fields as character no-undo.
     1177     for each temp-changes:
     1178       delete temp-changes.
     1179     end.
     1180     if not p-hst-handle:available then do:
     1181       return .
     1182     end.
     1183     create buffer h-new-buf  for table p-hst-handle .
     1184     create buffer h-main-buf for table p-main-table .
     1185     assign
     1186       v-inform = h-main-buf:index-information(1)
     1187       v-ind    = 2
     1188     .
     1189     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1190     on error undo, return error
     1191     :
     1192       assign
     1193         v-inform = h-main-buf:index-information( v-ind )
     1194         v-ind    = v-ind + 1
     1195       .
     1196     end.
     1197     if v-inform = ?
     1198       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1199       or entry( 3, v-inform, ",":U ) <> "1":U
     1200     then do:
     1201       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1202     end.
     1203     assign
     1204       v-idx-field-qnty = num-entries( v-inform ) - 4
     1205     .
     1206     if v-idx-field-qnty < 2 then do:
     1207       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1208     end.
     1209     assign
     1210       v-srch-main   = "where":U
     1211       v-word-link   = "":U
     1212       v-av-chip-num = false
     1213       v-delim-list  = "":U
     1214     .
     1215     do v-ind = 1 to v-idx-field-qnty by 2
     1216     on error undo, return error
     1217     :
     1218       assign
     1219         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1220         fh                = p-hst-handle:buffer-field( v-field-name )
     1221         fh-main           = h-main-buf:buffer-field( v-field-name )
     1222         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1223         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1224       .
     1225       if fh:data-type ="character":U then do:
     1226         assign
     1227           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1228         .
     1229       end.
     1230       else do:
     1231         assign
     1232           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1233         .
     1234       end.
     1235       if v-delim-list = "":U then do:
     1236         assign
     1237           v-delim-list = ",":U
     1238         .
     1239       end.
     1240       if v-word-link = "":U then do:
     1241         assign
     1242           v-word-link = "and":U
     1243         .
     1244       end.
     1245     end.
     1246     assign
     1247       v-delim-list  = "":U
     1248     .
     1249     do v-ind = 1 to h-main-buf:num-fields
     1250     on error undo, return error
     1251     :
     1252       assign
     1253         fh-main      = h-main-buf:buffer-field( v-ind )
     1254         v-field-name = fh-main:name
     1255       .
     1256         assign
     1257           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1258         .
     1259         if v-delim-list = "":U then do:
     1260           assign
     1261             v-delim-list = ",":U
     1262           .
     1263         end.
     1264     end.
     1265     assign
     1266       v-inform = p-hst-handle:index-information(1)
     1267       v-ind    = 2
     1268     .
     1269     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1270     on error undo, return error
     1271     :
     1272       assign
     1273         v-inform = p-hst-handle:index-information( v-ind )
     1274         v-ind    = v-ind + 1
     1275       .
     1276     end.
     1277     if v-inform = ?
     1278       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1279       or entry( 3, v-inform, ",":U ) <> "1":U
     1280     then do:
     1281       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1282     end.
     1283     assign
     1284       v-idx-field-qnty = num-entries( v-inform ) - 4
     1285     .
     1286     if v-idx-field-qnty < 2 then do:
     1287       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1288     end.
     1289     assign
     1290       v-search-exp  = "where":U
     1291       v-word-link   = "":U
     1292       v-av-chip-num = false
     1293     .
     1294     do v-ind = 1 to v-idx-field-qnty by 2
     1295     on error undo, return error
     1296     :
     1297       assign
     1298         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1299         fh           = p-hst-handle:buffer-field( v-field-name )
     1300         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1301       .
     1302       if v-field-name = "chip-num":U then do:
     1303         assign
     1304           v-search-exp  = substitute( "&1 >", v-search-exp )
     1305           v-av-chip-num = true
     1306         .
     1307       end.
     1308       else do:
     1309         assign
     1310           v-search-exp = substitute( "&1 =", v-search-exp )
     1311         .
     1312       end.
     1313       if fh:data-type ="character":U then do:
     1314         assign
     1315           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1316         .
     1317       end.
     1318       else do:
     1319         assign
     1320           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1321         .
     1322       end.
     1323       if v-word-link = "":U then do:
     1324         assign
     1325           v-word-link = "and":U
     1326         .
     1327       end.
     1328     end.
     1329     if v-av-chip-num = false then do:
     1330       message
     1331         vss-workfile vss-revision vss-description skip
     1332         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1333         "Использование данной процедуры невозможно!" skip
     1334         view-as alert-box error .
     1335       return error .
     1336     end.
     1337     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1338     if not h-new-buf:available then do:
     1339       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1340       if not h-main-buf:available then do:
     1341         assign
     1342           h-for-comp = ?
     1343         .
     1344       end.
     1345       else do:
     1346         assign
     1347           h-for-comp = h-main-buf
     1348         .
     1349       end.
     1350     end.
     1351     else do:
     1352       assign
     1353         h-for-comp = h-new-buf
     1354       .
     1355     end.
     1356     assign
     1357       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1358     .
     1359     do v-ind = 1 to v-num-entries
     1360     on error undo, return error return-value
     1361     :
     1362       assign
     1363         v-field-name = entry( v-ind, v-main-fld-lst )
     1364         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1365         v-old-value  = fh-old:buffer-value()
     1366         v-label      = trim( fh-old:label )
     1367       .
     1368       if ( trim( p-field-list ) <> "":U
     1369            and lookup( v-field-name, p-field-list ) > 0
     1370          )
     1371          or trim( p-field-list ) = "":U
     1372       then do:
     1373         if h-for-comp <> ? then do:
     1374           assign
     1375             fh-new      = h-for-comp:buffer-field( v-field-name )
     1376             v-new-value = fh-new:buffer-value()
     1377           .
     1378         end.
     1379         else do:
     1380           assign
     1381             v-new-value = "":U
     1382           .
     1383         end.
     1384         if v-old-value <> v-new-value
     1385         then do:
     1386           create temp-changes.
     1387           assign
     1388             temp-changes.t_name = p-main-table
     1389             temp-changes.f_name = v-field-name
     1390             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1391             temp-changes.v_old  = trim( v-old-value )
     1392             temp-changes.v_new  = trim( v-new-value )
     1393             temp-changes.num_   = 0
     1394             temp-changes.fNotChange = v-old-value eq v-new-value
     1395           .
     1396         end.
     1397       end.
     1398     end.
     1399     assign
     1400       v-num-entries = num-entries( p-label-form, chr(8) )
     1401     .
     1402     do v-ind = 1 to v-num-entries
     1403     on error undo, return error return-value
     1404     :
     1405       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1406         assign
     1407           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1408           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1409           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1410         .
     1411         find first temp-changes
     1412           where temp-changes.f_name = v-field-name
     1413           no-error .
     1414         if available temp-changes then do:
     1415           if trim( v-field-lvl ) <> "":U then do:
     1416             assign
     1417               temp-changes.l_name = v-field-lvl
     1418             .
     1419           end.
     1420           if trim( v-field-form ) <> "":U then do:
     1421             assign
     1422               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1423             .
     1424             if h-for-comp <> ? then do:
     1425               assign
     1426                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1427               .
     1428             end.
     1429           end.
     1430         end.
     1431       end.
     1432       else do:
     1433         message
     1434           vss-workfile vss-revision vss-description skip
     1435           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1436           substitute( "список для поля '&1': '&2'"
     1437                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1438                       ,entry( v-ind, p-label-form, chr(8) )
     1439                     ) skip
     1440           substitute( "полный список: &2", p-label-form ) skip
     1441           view-as alert-box error .
     1442       end.
     1443     end.
     1444     delete object h-new-buf .
     1445     delete object h-main-buf .
     1446   END PROCEDURE.
     1447   FUNCTION get-contract RETURNS CHARACTER
     1448     ( BUFFER loc-c-fin-doc FOR ub.c-fin-doc )  FORWARD.
     1449   FUNCTION get-cashbookname RETURNS CHARACTER
