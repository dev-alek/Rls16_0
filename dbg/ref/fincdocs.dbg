     1567   DEFINE QUERY br-c-fin-doc FOR
     1568         X_c-fin-doc SCROLLING.
     1569   DEFINE QUERY BR-changes FOR
     1570         temp-changes SCROLLING.
     1571   DEFINE BROWSE br-c-fin-doc
     1572     QUERY br-c-fin-doc DISPLAY
     1573         mark-string(recid(X_c-fin-doc), v-rid-list) FORMAT "X(1)":U
     1574         X_c-fin-doc.host-code COLUMN-LABEL "Код!фирмы" FORMAT "999999999":U
     1575         X_c-fin-doc.prn-doc-code FORMAT "X(16)":U
     1576         X_c-fin-doc.doc-date FORMAT "99/99/9999":U
     1577         get-shift(BUFFER X_c-fin-doc, OUTPUT v-fin-doc-shift-name-num) COLUMN-LABEL "Дата!смены"
     1578         v-fin-doc-shift-name-num COLUMN-LABEL "Смена" format "X(6)"
     1579         usrfulnf(X_c-fin-doc.user-name-doc) COLUMN-LABEL "Создал" FORMAT "X(8)":U
     1580         X_c-fin-doc.fin-doc-type FORMAT "X(8)":U
     1581         X_c-fin-doc.status_ FORMAT "X(8)":U
     1582         X_c-fin-doc.sum-doc FORMAT ">,>>>,>>>,>>>,>>9.99":U
     1583         get-currency(buffer X_c-fin-doc) COLUMN-LABEL "Вал" FORMAT "X(3)":U
     1584         usrfulnf(X_c-fin-doc.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(8)":U
     1585         X_c-fin-doc.corr-date FORMAT "99/99/9999":U
     1586         string(X_c-fin-doc.corr-time, "hh:mm") COLUMN-LABEL "Время коррекц"
     1587         X_c-fin-doc.fin-ext-doc-type COLUMN-LABEL "Расш.тип" FORMAT "X(8)":U
     1588         X_c-fin-doc.perm-date FORMAT "99/99/9999":U
     1589         usrfulnf(X_c-fin-doc.user-name-perm) COLUMN-LABEL "Закрыл!на разр" FORMAT "X(8)":U
     1590         X_c-fin-doc.pay-date COLUMN-LABEL "Дата платежа!(пост.в банк)" FORMAT "99/99/9999":U
     1591         usrfulnf(X_c-fin-doc.user-name-pl) COLUMN-LABEL "Закрыл!на опл" FORMAT "X(8)":U
     1592         X_c-fin-doc.fact-date FORMAT "99/99/9999":U
     1593         usrfulnf(X_c-fin-doc.user-name-fact) COLUMN-LABEL "Закрыл!на факт" FORMAT "X(8)":U
     1594         if X_c-fin-doc.obj-code <> 0 then (X_c-fin-doc.obj-type + string(X_c-fin-doc.obj-code)) else "":U COLUMN-LABEL "Объект" FORMAT "X(8)":U
     1595         X_c-fin-doc.receiver-type + string(X_c-fin-doc.receiver-code) COLUMN-LABEL "Получатель" FORMAT "X(12)":U
     1596         X_c-fin-doc.payer-type + string(X_c-fin-doc.payer-code) COLUMN-LABEL "Плательщик" FORMAT "X(12)":U
     1597         get-contract(buffer X_c-fin-doc) COLUMN-LABEL "Договор" FORMAT "X(16)":U
     1598         X_c-fin-doc.fin-doc-code COLUMN-LABEL "Вн.N" FORMAT "999999999":U
     1599         get-CashbookName(X_c-fin-doc.cashbookid) COLUMN-LABEL "Кассовая книга" FORMAT "x(30)":U
     1600     ENABLE
     1601         X_c-fin-doc.prn-doc-code
     1602       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.5 BY 7.37.
     1603   DEFINE BROWSE BR-changes
     1604     QUERY BR-changes DISPLAY
     1605         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1606   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1607   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1608       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6.
     1609   DEFINE FRAME Dialog-Frame
     1610        b-quit AT ROW 1 COL 1
     1611        B-mark AT ROW 1 COL 11
     1612        b-sel AT ROW 1 COL 21
     1613        B-lookup AT ROW 1 COL 41
     1614        B-client AT ROW 1 COL 51
     1615        B-schet AT ROW 1 COL 61
     1616        B-print AT ROW 1 COL 89
     1617        B-sch AT ROW 1 COL 92
     1618        B-Help AT ROW 1 COL 95
     1619        br-c-fin-doc AT ROW 2 COL 1.4
     1620        ED-notes AT ROW 9.5 COL 1 NO-LABEL
     1621        sch-prn-doc-code AT ROW 11.57 COL 88.6 COLON-ALIGNED
     1622        sch-curr-code AT ROW 12.57 COL 9 COLON-ALIGNED
     1623        B-curr AT ROW 12.57 COL 15.5
     1624        sch-doc-date AT ROW 12.57 COL 38.1 COLON-ALIGNED
     1625        sch-fact-date AT ROW 12.57 COL 62 COLON-ALIGNED
     1626        sch-pay-date AT ROW 12.57 COL 86 COLON-ALIGNED
     1627        sch-c-schet AT ROW 13.77 COL 40.9 COLON-ALIGNED
     1628        RS-receiver-payer AT ROW 13.8 COL 1.6 NO-LABEL
     1629        sch-r-schet AT ROW 13.8 COL 75.3 COLON-ALIGNED
     1630        sch-BIK AT ROW 14.93 COL 7.5 COLON-ALIGNED
     1631        sch-cli-code AT ROW 14.93 COL 26 COLON-ALIGNED
     1632        RS-cli-type AT ROW 14.93 COL 39.6 NO-LABEL
     1633        sch-name AT ROW 14.93 COL 66.3 COLON-ALIGNED
     1634        B-cli AT ROW 14.97 COL 54.5
     1635        BR-changes AT ROW 16.03 COL 1
     1636        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1637        f-poisk AT ROW 11.77 COL 70.9 COLON-ALIGNED NO-LABEL WIDGET-ID 2
     1638        SPACE(16.80) SKIP(9.60)
     1639       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1640            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1641            TITLE "Список истории платежей"
     1642            CANCEL-BUTTON b-quit.
     1643   ASSIGN
     1644          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1645          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1646   ASSIGN
     1647          B-client:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-client:HANDLE.
     1648   ASSIGN
     1649          B-schet:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-schet:HANDLE.
     1650   ASSIGN
     1651          br-c-fin-doc:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1.
     1652   ON ENDKEY OF FRAME Dialog-Frame
     1653   DO:
     1654       run gbl/markqwa.p (
     1655                              input b-mark:sensitive
     1656                             , input v-rid-list) no-error.
     1657     if error-status:error then return no-apply.
     1658   END.
     1659   ON GO OF FRAME Dialog-Frame
     1660   DO:
     1661     p-rid-list = v-rid-list.
     1662   END.
     1663   ON CHOOSE OF B-cli IN FRAME Dialog-Frame
     1664   DO:
     1665   define variable ref-list as character no-undo.
     1666   define variable ref-rec as recid no-undo.
     1667   define buffer buf_clients for ub.clients.
     1668     run ref/cli-all.w ( parParentProc
     1669                     , "b-sel"
     1670                     , RS-cli-type
     1671                     , ?
     1672                     , ?
     1673                     , ?
     1674                     , ?
     1675                     , "without-obj":U
     1676                     , output ref-list) .
     1677       if ref-list = "" then   do:
     1678         apply "entry" to b-cli in frame Dialog-Frame.
     1679         return no-apply.
     1680        end.
     1681       ref-rec = integer( ref-list ).
     1682       FIND FIRST buf_clients WHERE recid (buf_clients) = ref-rec NO-LOCK .
     1683       if NOT (buf_clients.obj-type = 'орг':U
     1684               or
     1685               buf_clients.obj-type = 'чел':U ) then do:
     1686         message
     1687         "Выберите контрагента типа" 'орг':U "или" 'чел':U
     1688         view-as alert-box error .
     1689         return no-apply.
     1690       end.
     1691       assign
     1692       RS-cli-type =  buf_clients.obj-type
     1693       sch-cli-code = buf_clients.obj-code
     1694       .
     1695       display
     1696       RS-cli-type
     1697       sch-cli-code
     1698       with frame Dialog-Frame.
     1699   END.
     1700   ON CHOOSE OF B-client IN FRAME Dialog-Frame
     1701   DO:
     1702   define variable v-rid-list as character no-undo.
     1703   if not available X_c-fin-doc then return no-apply.
     1704   if client-option = '':U then do:
     1705           run gbl/pop-up.p (self:handle, no) no-error.
     1706   end.
     1707   if client-option = '':U then return no-apply.
     1708     run ref/showcli.p (input parParentProc
     1709                  ,(if client-option = "receiver" then X_c-fin-doc.receiver-type else X_c-fin-doc.payer-type)
     1710                  , (if client-option = "receiver" then X_c-fin-doc.receiver-code else X_c-fin-doc.payer-code)
     1711                                   ) no-error.
     1712    client-option = '':U.
     1713    APPLY "ENTRY" to br-c-fin-doc.
     1714   END.
     1715   ON CHOOSE OF B-curr IN FRAME Dialog-Frame
     1716   DO:
     1717   define variable rr as recid no-undo.
     1718   define buffer buf_currency for ub.currency.
     1719       rr = ? .
     1720       run ref/currency.w (parparentproc, "b-sel", input-output rr ).
     1721       if rr <> ? then do:
     1722           FIND FIRST buf_currency WHERE
     1723                recid( buf_currency ) = rr NO-LOCK .
     1724           DISPLAY
     1725           buf_currency.curr-code @ sch-curr-code
     1726           with frame Dialog-Frame .
     1727       end.
     1728   END.
     1729   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1730   DO:
     1731   if not available X_c-fin-doc then return no-apply.
     1732   run proc-b-lookup in this-procedure no-error.
     1733   if error-status:error then do:
     1734     return no-apply.
     1735   end.
     1736   END.
     1737   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1738   DO:
     1739   define variable loc#log as logical no-undo .
     1740     if available X_c-fin-doc then do:
     1741   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1742   define variable v-str-recid16 as character no-undo .
     1743   define variable v-num-entry16 as integer   no-undo .
     1744   assign
     1745     v-str-recid16 = trim( string( recid( X_c-fin-doc ) , "->>>>>>>>>>>9":U ) )
     1746     v-num-entry16 = lookup( v-str-recid16 , v-rid-list )
     1747   .
     1748   if v-num-entry16 > 0 then do:
     1749     assign
     1750       entry( v-num-entry16, v-rid-list ) = "":U
     1751       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1752     .
     1753   end.
     1754   else do:
     1755     assign
     1756       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid16
     1757     .
     1758   end.
     1759       loc#log = br-c-fin-doc:refresh() .
     1760       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1761           loc#log = br-c-fin-doc:select-next-row ().
     1762           apply "VALUE-CHANGED" to br-c-fin-doc in frame Dialog-Frame.
     1763       end.
     1764       if num-entries( v-rid-list ) = 0
     1765       then
     1766           hide mark-num in frame Dialog-Frame.
     1767       else
     1768           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1769     end.
     1770     apply "entry" to br-c-fin-doc in frame Dialog-Frame.
     1771   END.
     1772   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1773   DO:
     1774     run proc-b-print in this-procedure no-error.
     1775     if error-status:error then do:
     1776       return no-apply.
     1777     end.
     1778     APPLY "ENTRY" to br-c-fin-doc.
     1779   END.
     1780   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1781   DO:
     1782     run proc-b-sch in this-procedure no-error.
     1783     if error-status:error then return no-apply.
     1784   END.
     1785   ON CHOOSE OF B-schet IN FRAME Dialog-Frame
     1786   DO:
     1787   define variable loc-doc-rec as recid no-undo.
     1788   if not available X_c-fin-doc then return no-apply.
     1789   if schet-option = '':U then do:
     1790     run gbl/pop-up.p (self:handle, no) no-error.
     1791   end.
     1792   if schet-option = '':U then return no-apply.
     1793   if X_c-fin-doc.fin-doc-type = 'пко':U
     1794   or X_c-fin-doc.fin-doc-type = 'рко':U
     1795   or X_c-fin-doc.fin-doc-type = 'апп':U
     1796   or X_c-fin-doc.fin-doc-type = 'апр':U
     1797   then do:
     1798     message
     1799     "Нельзя посмотреть счет по платежу" skip
     1800     "платеж имеет тип" entry (lookup (X_c-fin-doc.fin-doc-type, 'пко,рко,ппп,рпп,апп,апр':U) + 1, ',':U + 'приходный кассовый ордер,расходный кассовый ордер,приходное платежное поручение,расходное платежное поручение,приходный АПЗ,расходный АПЗ':U)
     1801     view-as alert-box.
     1802     return no-apply.
     1803   end.
     1804   run ref/finschti.w
     1805                 (
     1806                    input parParentProc
     1807                   ,input p-curr-host-code
     1808                   ,input 'ПРОСМОТР':U
     1809                   ,input X_c-fin-doc.host-code
     1810                   ,input (if schet-option = "payer-schet":U
     1811                           then X_c-fin-doc.payer-code-schet
     1812                           else X_c-fin-doc.receiver-code-schet )
     1813                   ,input 0
     1814                   ,input (if schet-option = "payer-schet":U
     1815                          then X_c-fin-doc.payer-type
     1816                          else X_c-fin-doc.receiver-type)
     1817                   ,input (if schet-option = "payer-schet":U
     1818                          then X_c-fin-doc.payer-code
     1819                          else X_c-fin-doc.receiver-code)
     1820                   ,input X_fin-doc.curr-code
     1821                   ,input-output loc-doc-rec
     1822                               )
     1823   .
     1824    schet-option = '':U.
     1825    APPLY "ENTRY" to br-c-fin-doc.
     1826   END.
     1827   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1828   DO:
     1829     if ( available X_c-fin-doc ) then do:
     1830       if ( v-rid-list = "" ) or b-mark:sensitive = no then
     1831       v-rid-list = string( recid( X_c-fin-doc ) ) .
     1832     end.
     1833   END.
     1834   ON RETURN OF br-c-fin-doc IN FRAME Dialog-Frame
     1835   or MOUSE-SELECT-DBLCLICK OF br-c-fin-doc IN FRAME Dialog-Frame
     1836   DO:
     1837     run proc-br-c-fin-doc no-error.
     1838     if error-status:error then return no-apply.
     1839   END.
     1840   ON VALUE-CHANGED OF br-c-fin-doc IN FRAME Dialog-Frame
     1841   DO:
     1842     DEFINE VARIABLE dops as character no-undo .
     1843     dops = if available X_c-fin-doc then X_c-fin-doc.ps else '':U.
     1844     ED-notes:screen-value = dops.
     1845     run proc-view-changes in this-procedure no-error.
     1846   END.
     1847   ON LEAVE OF ED-notes IN FRAME Dialog-Frame
     1848   DO:
     1849     define buffer ps_fin-doc for ub.fin-doc.
     1850     if not available X_c-fin-doc then return no-apply.
     1851      DO on stop undo, return no-apply:
     1852         FIND PS_fin-doc where
     1853              recid (ps_fin-doc) = recid(X_c-fin-doc) exclusive.
     1854         if ps_fin-doc.PS <> input frame Dialog-Frame ed-notes then
     1855         assign
     1856         ps_fin-doc.PS = input frame Dialog-Frame ed-notes
     1857         .
     1858      END.
     1859   END.
     1860   ON CHOOSE OF MENU-ITEM payer
     1861   DO:
     1862       assign
     1863     client-option = "payer":U.
     1864     APPLY "CHOOSE" to b-client in frame Dialog-Frame.
     1865   END.
     1866   ON CHOOSE OF MENU-ITEM payer-schet
     1867   DO:
     1868       assign
     1869     schet-option = "payer":U.
     1870     APPLY "CHOOSE" to b-schet in frame Dialog-Frame.
     1871   END.
     1872   ON CHOOSE OF MENU-ITEM receiver
     1873   DO:
     1874     assign
     1875     client-option = "receiver":U.
     1876     APPLY "CHOOSE" to b-client in frame Dialog-Frame.
     1877   END.
     1878   ON CHOOSE OF MENU-ITEM receiver-schet
     1879   DO:
     1880     assign
     1881     schet-option = "receiver":U.
     1882     APPLY "CHOOSE" to b-schet in frame Dialog-Frame.
     1883   END.
     1884   ON VALUE-CHANGED OF RS-cli-type IN FRAME Dialog-Frame
     1885   DO:
     1886     assign
     1887     RS-cli-type.
     1888   END.
     1889   ON VALUE-CHANGED OF RS-receiver-payer IN FRAME Dialog-Frame
     1890   DO:
     1891     assign
     1892     Rs-receiver-payer.
     1893   END.
     1894   ON CTRL-J OF sch-BIK IN FRAME Dialog-Frame
     1895   DO:
     1896     run proc-find-bik in this-procedure(yes, input frame Dialog-Frame sch-bik) no-error.
     1897     if error-status:error then return no-apply.
     1898   END.
     1899   ON RETURN OF sch-BIK IN FRAME Dialog-Frame
     1900   DO:
     1901     run proc-find-bik in this-procedure(no, input frame Dialog-Frame sch-bik) no-error.
     1902     if error-status:error then return no-apply.
     1903   END.
     1904   ON CTRL-J OF sch-c-schet IN FRAME Dialog-Frame
     1905   DO:
     1906     run proc-find-c-schet in this-procedure(yes, input frame Dialog-Frame sch-c-schet) no-error.
     1907     if error-status:error then return no-apply.
     1908   END.
     1909   ON RETURN OF sch-c-schet IN FRAME Dialog-Frame
     1910   DO:
     1911     run proc-find-c-schet in this-procedure(no, input frame Dialog-Frame sch-c-schet) no-error.
     1912     if error-status:error then return no-apply.
     1913   END.
     1914   ON CTRL-J OF sch-cli-code IN FRAME Dialog-Frame
     1915   DO:
     1916     run proc-find-cli-code in this-procedure(yes, input frame Dialog-Frame sch-cli-code) no-error.
     1917     if error-status:error then return no-apply.
     1918   END.
     1919   ON RETURN OF sch-cli-code IN FRAME Dialog-Frame
     1920   DO:
     1921     run proc-find-cli-code in this-procedure(yes, input frame Dialog-Frame sch-cli-code) no-error.
     1922     if error-status:error then return no-apply.
     1923   END.
     1924   ON CTRL-J OF sch-curr-code IN FRAME Dialog-Frame
     1925   DO:
     1926     run proc-find-curr-code in this-procedure(yes, input frame Dialog-Frame sch-curr-code) no-error.
     1927     if error-status:error then return no-apply.
     1928   END.
     1929   ON RETURN OF sch-curr-code IN FRAME Dialog-Frame
     1930   DO:
     1931      run proc-find-curr-code in this-procedure(no, input frame Dialog-Frame sch-curr-code) no-error.
     1932     if error-status:error then return no-apply.
     1933   END.
     1934   ON CTRL-J OF sch-doc-date IN FRAME Dialog-Frame
     1935   DO:
     1936      run proc-find-date in this-procedure(yes, input frame Dialog-Frame sch-doc-date, "doc-date":U) no-error.
     1937     if error-status:error then return no-apply.
     1938   END.
     1939   ON RETURN OF sch-doc-date IN FRAME Dialog-Frame
     1940   DO:
     1941     run proc-find-date in this-procedure(no, input frame Dialog-Frame sch-doc-date, "doc-date":U) no-error.
     1942     if error-status:error then return no-apply.
     1943   END.
     1944   ON CTRL-J OF sch-fact-date IN FRAME Dialog-Frame
     1945   DO:
     1946     run proc-find-date in this-procedure(yes, input frame Dialog-Frame sch-fact-date, "fact-date":U) no-error.
     1947     if error-status:error then return no-apply.
     1948   END.
     1949   ON RETURN OF sch-fact-date IN FRAME Dialog-Frame
     1950   DO:
     1951       run proc-find-date in this-procedure(no, input frame Dialog-Frame sch-fact-date, "fact-date":U) no-error.
     1952     if error-status:error then return no-apply.
     1953   END.
     1954   ON CTRL-J OF sch-name IN FRAME Dialog-Frame
     1955   DO:
     1956     run proc-find-name in this-procedure(yes, input frame Dialog-Frame sch-name) no-error.
     1957     if error-status:error then return no-apply.
     1958   END.
     1959   ON RETURN OF sch-name IN FRAME Dialog-Frame
     1960   DO:
     1961     run proc-find-name in this-procedure(no, input frame Dialog-Frame sch-name) no-error.
     1962     if error-status:error then return no-apply.
     1963   END.
     1964   ON RETURN OF sch-pay-date IN FRAME Dialog-Frame
     1965   DO:
     1966       run proc-find-date in this-procedure(yes, input frame Dialog-Frame sch-pay-date, "pay-date":U) no-error.
     1967     if error-status:error then return no-apply.
     1968   END.
     1969   ON CTRL-J OF sch-prn-doc-code IN FRAME Dialog-Frame
     1970   DO:
     1971     run proc-find-prn-doc-code in this-procedure(yes, input frame Dialog-Frame sch-prn-doc-code) no-error.
     1972     if error-status:error then return no-apply.
     1973   END.
     1974   ON RETURN OF sch-prn-doc-code IN FRAME Dialog-Frame
     1975   DO:
     1976     run proc-find-prn-doc-code in this-procedure(no, input frame Dialog-Frame sch-prn-doc-code) no-error.
     1977     if error-status:error then return no-apply.
     1978   END.
     1979   ON CTRL-J OF sch-r-schet IN FRAME Dialog-Frame
     1980   DO:
     1981     run proc-find-r-schet in this-procedure(yes, input frame Dialog-Frame sch-r-schet) no-error.
     1982     if error-status:error then return no-apply.
     1983   END.
     1984   ON RETURN OF sch-r-schet IN FRAME Dialog-Frame
     1985   DO:
     1986     run proc-find-r-schet in this-procedure(no, input frame Dialog-Frame sch-r-schet) no-error.
     1987     if error-status:error then return no-apply.
     1988   END.
     1989   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1990   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1991   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1992   on help of frame Dialog-Frame
     1993   do:
     1994     run gbl/app_help.p
     1995       (input this-procedure :file-name
     1996       ,input ''
     1997       ,input ?
     1998       ) no-error.
     1999     if error-status :error then do:
     2000       message
     2001         "Ошибка при вызове помощи"
     2002         error-status :get-message(1)
     2003         view-as alert-box .
     2004     end.
     2005   end.
     2006   run minbtn-set in this-procedure .
     2007   on choose of b-help in frame Dialog-Frame
     2008   do:
     2009     apply "help":u to frame Dialog-Frame .
     2010   end.
     2011   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2012   procedure minbtn-set :
     2013       do
     2014           on error undo, return error return-value
     2015           :
     2016           define variable ii              as integer       no-undo .
     2017           define variable fh              as widget-handle no-undo .
     2018           define variable hh              as widget-handle no-undo .
     2019           define variable v-h             as handle        extent 4 no-undo .
     2020           define variable v-name-button   as character     no-undo .
     2021           define variable v-help-old-x    as decimal       no-undo .
     2022           define variable v-help-old-y    as decimal       no-undo .
     2023           define variable v-help-old-size as decimal       no-undo .
     2024           define variable v-frame-width   as decimal       no-undo .
     2025           define variable jj              as integer       no-undo .
     2026           do
     2027               on error undo, return error
     2028               :
     2029               assign
     2030                   v-frame-width = frame Dialog-Frame:width - 0.3
     2031                   fh            = frame Dialog-Frame:first-child
     2032                   hh            = fh:first-child
     2033                   ii            = 1
     2034                   .
     2035               do while valid-handle(hh):
     2036                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2037                   do:
     2038                       case lc(hh:name) :
     2039                           when "b-help" then
     2040                               do:
     2041                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2042                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2043                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2044                                   hh:TOOLTIP = "Помощь" .
     2045                                   v-help-old-x = hh:column .
     2046                                   v-help-old-y = hh:row    .
     2047                                   v-help-old-size = hh:width .
     2048                                   hh:width-chars = 2.5 .
     2049                               end.
     2050                           when "b-print" then
     2051                               do:
     2052                                   hh:load-image("cmp/b-print.bmp":u) .
     2053                                   hh:TOOLTIP = "Печать" .
     2054                                   v-h[ii] = hh:handle .
     2055                                   ii = ii + 1 .
     2056                                   hh:width-chars = 3 .
     2057                               end.
     2058                           when "b-history" or
     2059                           when "b-hist" then
     2060                               do:
     2061                                   hh:load-image("cmp/b-hist.bmp":u) .
     2062                                   hh:TOOLTIP = "История" .
     2063                                   v-h[ii] = hh:handle .
     2064                                   ii = ii + 1 .
     2065                                   hh:width-chars = 3 .
     2066                               end.
     2067                           when "b-sch" then
     2068                               do:
     2069                                   hh:load-image("cmp/b-sch.bmp":u) .
     2070                                   hh:TOOLTIP = "Установка Фильтра" .
     2071                                   v-h[ii] = hh:handle .
     2072                                   ii = ii + 1 .
     2073                                   hh:width-chars = 3 .
     2074                               end.
     2075                           when "b-hist-user" then
     2076                               do:
     2077                                   hh:load-image("cmp/b-hist.bmp":u) .
     2078                                   hh:TOOLTIP = "История пользователя" .
     2079                                   ii = ii + 1 .
     2080                               end.
     2081                       end case.
     2082                   end.
     2083                   hh = hh:next-sibling.
     2084               end.
     2085               b-help:column = v-frame-width - b-help:width-chars.
     2086               jj = 0.
     2087               repeat ii = 4 to 1 by -1 :
     2088                   if valid-handle (v-h[ii] ) then
     2089                   do:
     2090                       jj  = jj + 1 .
     2091                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2092                       v-h[ii]:row    = v-help-old-y .
     2093                   end.
     2094               end.
     2095           end.
     2096       end.
     2097   end procedure.
     2098   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2099   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2100   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2101   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2102   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2103   define variable v-diasize-current-frame-height as decimal   no-undo .
     2104   define variable v-diasize-change-size          as logical   no-undo .
     2105   define variable v-diasize-resize-button        as handle    no-undo .
     2106   define variable v-diasize-wndmax               as logical   no-undo .
     2107   define variable v-diasize-wndstore             as logical   no-undo .
     2108   define variable v-diasize-proc-name            as character no-undo .
     2109   define variable v-diasize-browse-handle        as handle    no-undo .
     2110   define variable v-diasize-browse-number        as integer   no-undo .
     2111   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2112   define temp-table temp-diasize-handle no-undo
     2113     field handle-value  as handle
     2114     field save-position as decimal
     2115     index xpk is primary unique handle-value
     2116     .
     2117   define temp-table temp-browse-handle no-undo
     2118     field browse-type   as character
     2119     field browse-number as integer
     2120     field browse-handle as handle
     2121     field original-size as decimal
     2122     index xpk is primary unique browse-type browse-number
     2123     index xie browse-type browse-handle
     2124   .
     2125   procedure diasize_change-height :
     2126     define input  parameter p-change-value  as decimal   no-undo .
     2127     define input  parameter p-move-resize   as logical   no-undo .
     2128     define variable v-field-group-handle    as handle    no-undo .
     2129     define variable v-object-handle         as handle    no-undo .
     2130     define variable v-frame-height          as decimal   no-undo .
     2131     define variable v-frame-virtual-height  as decimal   no-undo .
     2132     define variable v-browse-height         as decimal   no-undo .
     2133     define variable v-window-height         as decimal   no-undo .
     2134     define variable v-window-virtual-height as decimal   no-undo .
     2135     define variable v-change-sign           as integer   no-undo .
     2136     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2137     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2138     if p-change-value > 0
     2139     then do:
     2140       if frame Dialog-Frame :height + p-change-value
     2141           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2142       then do:
     2143         assign
     2144           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2145                           - (frame Dialog-Frame :height-chars)
     2146         .
     2147         if p-change-value <= 0
     2148         then do:
     2149           run diasize_position-resize-button in this-procedure .
     2150           return .
     2151         end.
     2152       end.
     2153     end.
     2154     if p-change-value < 0
     2155     then do:
     2156       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2157       then do:
     2158         assign
     2159           p-change-value = v-diasize-orig-frame-height
     2160                          - (frame Dialog-Frame :height-chars)
     2161         .
     2162         if p-change-value >= 0
     2163         then do:
     2164           run diasize_position-resize-button in this-procedure .
     2165           return .
     2166         end.
     2167       end.
     2168     end.
     2169     if p-change-value >= 0
     2170     then do:
     2171       assign
     2172         v-change-sign = 1
     2173       .
     2174     end.
     2175     else do:
     2176       assign
     2177         v-change-sign = -1
     2178       .
     2179     end.
     2180     assign
     2181       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2182     .
     2183     if p-change-value = 0
     2184     then do:
     2185       run diasize_position-resize-button in this-procedure .
     2186       return .
     2187     end.
     2188     move_block:
     2189     do
     2190     on error undo move_block, retry move_block
     2191     :
     2192       if retry
     2193       then do:
     2194         do
     2195         on error undo move_block, leave move_block
     2196         :
     2197           if p-change-value > 0
     2198           then do:
     2199             for each buf_temp-diasize-handle
     2200             on error undo, next
     2201             :
     2202               assign
     2203                 v-object-handle = buf_temp-diasize-handle.handle-value
     2204               .
     2205               if v-object-handle <> v-diasize-resize-button
     2206               then do:
     2207                 assign
     2208                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2209                 .
     2210               end.
     2211             end.
     2212             assign
     2213               v-diasize-browse-handle :height = v-browse-height
     2214             .
     2215             for each buf_temp-browse-handle
     2216               where buf_temp-browse-handle.browse-type = 'height':u
     2217             on error undo, next
     2218             :
     2219               assign
     2220                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2221               .
     2222             end.
     2223             assign
     2224               frame Dialog-Frame :height = v-frame-height
     2225             .
     2226             if frame Dialog-Frame :scrollable = true
     2227             then do:
     2228               assign
     2229                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2230               .
     2231             end.
     2232             run diasize_position-resize-button in this-procedure .
     2233           end.
     2234           else do:
     2235             if frame Dialog-Frame :scrollable = true
     2236             then do:
     2237               assign
     2238                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2239               .
     2240             end.
     2241             assign
     2242               frame Dialog-Frame :height = v-frame-height
     2243             .
     2244             assign
     2245               v-diasize-browse-handle :height = v-browse-height
     2246             .
     2247             for each buf_temp-browse-handle
     2248               where buf_temp-browse-handle.browse-type = 'height':u
     2249             on error undo, next
     2250             :
     2251               assign
     2252                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2253               .
     2254             end.
     2255             for each buf_temp-diasize-handle
     2256             on error undo, next
     2257             :
     2258               assign
     2259                 v-object-handle = buf_temp-diasize-handle.handle-value
     2260               .
     2261               if v-object-handle <> v-diasize-resize-button
     2262               then do:
     2263                 assign
     2264                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2265                 .
     2266               end.
     2267             end.
     2268             run diasize_position-resize-button in this-procedure .
     2269           end.
     2270           assign
     2271             v-diasize-change-size = false
     2272           .
     2273           leave move_block .
     2274         end.
     2275       end.
     2276       assign
     2277         v-diasize-need-full-display = true
     2278       .
     2279       if v-diasize-change-size = false
     2280       then do:
     2281         assign
     2282           v-diasize-change-size = true
     2283         .
     2284       end.
     2285       else do:
     2286         return .
     2287       end.
     2288       assign
     2289         v-frame-height = frame Dialog-Frame :height
     2290         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2291         v-browse-height = v-diasize-browse-handle :height
     2292       .
     2293       for each buf_temp-browse-handle
     2294         where buf_temp-browse-handle.browse-type = 'height':u
     2295       :
     2296         assign
     2297           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2298         .
     2299       end.
     2300       for each buf_temp-diasize-handle
     2301       :
     2302         delete buf_temp-diasize-handle .
     2303       end.
     2304       assign
     2305         v-field-group-handle = frame Dialog-Frame :first-child
     2306       .
     2307       do while valid-handle(v-field-group-handle)
     2308       :
     2309         assign
     2310           v-object-handle = v-field-group-handle :first-child
     2311         .
     2312         do while valid-handle(v-object-handle)
     2313         :
     2314           if  v-object-handle <> v-diasize-browse-handle :handle
     2315           and can-query(v-object-handle, "row")
     2316           and can-query(v-object-handle, "height")
     2317           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2318           then do:
     2319             find first buf_temp-browse-handle
     2320               where buf_temp-browse-handle.browse-type   = 'height':u
     2321                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2322               no-error .
     2323             if available buf_temp-browse-handle
     2324             then do:
     2325             end.
     2326             else do:
     2327               create buf_temp-diasize-handle .
     2328               assign
     2329                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2330                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2331               .
     2332             end.
     2333           end.
     2334           assign
     2335             v-object-handle = v-object-handle :next-sibling
     2336           .
     2337         end.
     2338         assign
     2339           v-field-group-handle = v-field-group-handle :next-sibling
     2340         .
     2341       end.
     2342       do with frame Dialog-Frame
     2343       :
     2344         hide v-diasize-resize-button .
     2345         assign
     2346           v-diasize-resize-button :row    = 1
     2347           v-diasize-resize-button :column = 1
     2348         .
     2349       end.
     2350       if p-change-value > 0
     2351       then do:
     2352         if frame Dialog-Frame :scrollable = true
     2353         then do:
     2354           assign
     2355             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2356             no-error .
     2357           if error-status :error
     2358           or error-status :get-message(1) <> ""
     2359           then do:
     2360             undo move_block, retry move_block .
     2361           end.
     2362         end.
     2363         assign
     2364           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2365           no-error .
     2366         if error-status :error
     2367         or error-status :get-message(1) <> ""
     2368         then do:
     2369           undo move_block, retry move_block .
     2370         end.
     2371         assign
     2372           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2373           no-error .
     2374         if error-status :error
     2375         or error-status :get-message(1) <> ""
     2376         then do:
     2377           undo move_block, retry move_block .
     2378         end.
     2379         for each buf_temp-browse-handle
     2380           where buf_temp-browse-handle.browse-type = 'height':u
     2381         on error undo move_block, retry move_block
     2382         :
     2383           assign
     2384             buf_temp-browse-handle.browse-handle :height
     2385               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2386             no-error .
     2387           if error-status :error
     2388           or error-status :get-message(1) <> ""
     2389           then do:
     2390             undo move_block, retry move_block .
     2391           end.
     2392         end.
     2393         for each buf_temp-diasize-handle
     2394         on error undo move_block, retry move_block
     2395         :
     2396           assign
     2397             v-object-handle = buf_temp-diasize-handle.handle-value
     2398           .
     2399           if v-object-handle <> v-diasize-resize-button
     2400           then do:
     2401             assign
     2402               v-object-handle :row = v-object-handle :row + p-change-value
     2403               no-error .
     2404             if error-status :error
     2405             or error-status :get-message(1) <> ""
     2406             then do:
     2407               undo move_block, retry move_block .
     2408             end.
     2409           end.
     2410         end.
     2411       end.
     2412       else do:
     2413         for each buf_temp-diasize-handle
     2414         on error undo move_block, retry move_block
     2415         :
     2416           assign
     2417             v-object-handle = buf_temp-diasize-handle.handle-value
     2418           .
     2419           if v-object-handle <> v-diasize-resize-button
     2420           then do:
     2421             assign
     2422               v-object-handle :row = v-object-handle :row + p-change-value
     2423               no-error .
     2424             if error-status :error
     2425             or error-status :get-message(1) <> ""
     2426             then do:
     2427               undo move_block, retry move_block .
     2428             end.
     2429           end.
     2430         end.
     2431         assign
     2432           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2433           no-error .
     2434         if error-status :error
     2435         or error-status :get-message(1) <> ""
     2436         then do:
     2437           undo move_block, retry move_block .
     2438         end.
     2439         for each buf_temp-browse-handle
     2440           where buf_temp-browse-handle.browse-type = 'height':u
     2441         on error undo move_block, retry move_block
     2442         :
     2443           assign
     2444             buf_temp-browse-handle.browse-handle :height
     2445               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2446             no-error .
     2447           if error-status :error
     2448           or error-status :get-message(1) <> ""
     2449           then do:
     2450             undo move_block, retry move_block .
     2451           end.
     2452         end.
     2453         assign
     2454           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2455           no-error .
     2456         if error-status :error
     2457         or error-status :get-message(1) <> ""
     2458         then do:
     2459           undo move_block, retry move_block .
     2460         end.
     2461         if frame Dialog-Frame :scrollable = true
     2462         then do:
     2463           assign
     2464             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2465             no-error .
     2466           if error-status :error
     2467           or error-status :get-message(1) <> ""
     2468           then do:
     2469             undo move_block, retry move_block .
     2470           end.
     2471         end.
     2472       end.
     2473       if p-move-resize = true
     2474       then do:
     2475         run diasize_position-resize-button in this-procedure .
     2476       end.
     2477       if v-diasize-wndstore = true
     2478       then do:
     2479         if connected("ub") = true
     2480         then do:
     2481           define variable v-cntxt-db-num        as integer   no-undo .
     2482           define variable v-cntxt-userid        as character no-undo .
     2483           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2484                                             , OUTPUT v-cntxt-userid
     2485                                             ) .
     2486           run gbl/wndsizew.p
     2487             (input  v-cntxt-db-num
     2488             ,input  v-cntxt-userid
     2489             ,input  v-diasize-proc-name
     2490             ,input  'height':u
     2491             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2492             ) .
     2493         end.
     2494       end.
     2495     end.
     2496     assign
     2497       v-diasize-change-size = false
     2498     .
     2499   end procedure.
     2500   procedure diasize_set-height :
     2501     define input  parameter p-new-height  as decimal   no-undo .
     2502     define input  parameter p-move-resize as logical   no-undo .
     2503     do
     2504     on error undo, return error return-value
     2505     :
     2506       run diasize_change-height in this-procedure
     2507         (input  (p-new-height - frame Dialog-Frame :height)
     2508         ,input  p-move-resize
     2509         ) .
     2510     end.
     2511   end procedure.
     2512   procedure diasize_change-width :
     2513     define input  parameter p-change-value as decimal   no-undo .
     2514     define input  parameter p-move-resize  as logical   no-undo .
     2515     define variable v-field-group-handle   as handle    no-undo .
     2516     define variable v-object-handle        as handle    no-undo .
     2517     define variable v-frame-width          as decimal   no-undo .
     2518     define variable v-frame-virtual-width  as decimal   no-undo .
     2519     define variable v-browse-width         as decimal   no-undo .
     2520     define variable v-window-width         as decimal   no-undo .
     2521     define variable v-window-virtual-width as decimal   no-undo .
     2522     define variable v-change-sign          as integer   no-undo .
     2523     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2524     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2525     if p-change-value > 0
     2526     then do:
     2527       if frame Dialog-Frame :width + p-change-value >
     2528           session :width-chars
     2529       then do:
     2530         assign
     2531           p-change-value = session :width-chars - frame Dialog-Frame :width
     2532         .
     2533         if p-change-value <= 0
     2534         then do:
     2535           run diasize_position-resize-button in this-procedure .
     2536           return .
     2537         end.
     2538       end.
     2539     end.
     2540     if p-change-value < 0
     2541     then do:
     2542       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2543       then do:
     2544         assign
     2545           p-change-value = v-diasize-orig-frame-width
     2546                          - frame Dialog-Frame :width
     2547         .
     2548         if p-change-value >= 0
     2549         then do:
     2550           run diasize_position-resize-button in this-procedure .
     2551           return .
     2552         end.
     2553       end.
     2554     end.
     2555     if p-change-value >= 0
     2556     then do:
     2557       assign
     2558         v-change-sign = 1
     2559       .
     2560     end.
     2561     else do:
     2562       assign
     2563         v-change-sign = -1
     2564       .
     2565     end.
     2566     assign
     2567       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2568     .
     2569     if p-change-value = 0
     2570     then do:
     2571       run diasize_position-resize-button in this-procedure .
     2572       return .
     2573     end.
     2574     move_block:
     2575     do
     2576     on error undo move_block, leave move_block
     2577     :
     2578       if retry
     2579       then do:
     2580         do
     2581         on error undo move_block, leave move_block
     2582         :
     2583           if p-change-value > 0
     2584           then do:
     2585             for each buf_temp-diasize-handle
     2586             on error undo, next
     2587             :
     2588               assign
     2589                 v-object-handle = buf_temp-diasize-handle.handle-value
     2590               .
     2591               if v-object-handle <> v-diasize-resize-button
     2592               then do:
     2593                 assign
     2594                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2595                 .
     2596               end.
     2597             end.
     2598             assign
     2599               v-diasize-browse-handle :width = v-browse-width
     2600             .
     2601             for each buf_temp-browse-handle
     2602               where buf_temp-browse-handle.browse-type = 'width':u
     2603             on error undo, next
     2604             :
     2605               assign
     2606                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2607               .
     2608             end.
     2609             assign
     2610               frame Dialog-Frame :width = v-frame-width
     2611             .
     2612             if frame Dialog-Frame :scrollable = true
     2613             then do:
     2614               assign
     2615                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2616               .
     2617             end.
     2618             run diasize_position-resize-button in this-procedure .
     2619           end.
     2620           else do:
     2621             if frame Dialog-Frame :scrollable = true
     2622             then do:
     2623               assign
     2624                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2625               .
     2626             end.
     2627             assign
     2628               frame Dialog-Frame :width = v-frame-width
     2629             .
     2630             for each buf_temp-browse-handle
     2631               where buf_temp-browse-handle.browse-type = 'width':u
     2632             on error undo, next
     2633             :
     2634               assign
     2635                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2636               .
     2637             end.
     2638             assign
     2639               v-diasize-browse-handle :width = v-browse-width
     2640             .
     2641             for each buf_temp-diasize-handle
     2642             on error undo, next
     2643             :
     2644               assign
     2645                 v-object-handle = buf_temp-diasize-handle.handle-value
     2646               .
     2647               if v-object-handle <> v-diasize-resize-button
     2648               then do:
     2649                 assign
     2650                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2651                 .
     2652               end.
     2653             end.
     2654             run diasize_position-resize-button in this-procedure .
     2655           end.
     2656           assign
     2657             v-diasize-change-size = false
     2658           .
     2659           leave move_block .
     2660         end.
     2661       end.
     2662       assign
     2663         v-diasize-need-full-display = true
     2664       .
     2665       if v-diasize-change-size = false
     2666       then do:
     2667         assign
     2668           v-diasize-change-size = true
     2669         .
     2670       end.
     2671       else do:
     2672         return .
     2673       end.
     2674       assign
     2675         v-frame-width = frame Dialog-Frame :width
     2676         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2677         v-browse-width = v-diasize-browse-handle :width
     2678       .
     2679       for each buf_temp-browse-handle
     2680         where buf_temp-browse-handle.browse-type = 'width':u
     2681       :
     2682         assign
     2683           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2684         .
     2685       end.
     2686       for each buf_temp-diasize-handle
     2687       :
     2688         delete buf_temp-diasize-handle .
     2689       end.
     2690       assign
     2691         v-field-group-handle = frame Dialog-Frame :first-child
     2692       .
     2693       do while valid-handle(v-field-group-handle)
     2694       :
     2695         assign
     2696           v-object-handle = v-field-group-handle :first-child
     2697         .
     2698         do while valid-handle(v-object-handle)
     2699         :
     2700           if  v-object-handle <> v-diasize-browse-handle :handle
     2701           and v-object-handle <> v-diasize-resize-button
     2702           and can-query(v-object-handle, "row")
     2703           and can-query(v-object-handle, "height")
     2704           and ( v-object-handle :col + v-object-handle :width
     2705                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2706               )
     2707           then do:
     2708             find first buf_temp-browse-handle
     2709               where buf_temp-browse-handle.browse-type   = 'width':u
     2710                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2711               no-error .
     2712             if available buf_temp-browse-handle
     2713             then do:
     2714             end.
     2715             else do:
     2716               create buf_temp-diasize-handle .
     2717               assign
     2718                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2719                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2720               .
     2721             end.
     2722           end.
     2723           assign
     2724             v-object-handle = v-object-handle :next-sibling
     2725           .
     2726         end.
     2727         assign
     2728           v-field-group-handle = v-field-group-handle :next-sibling
     2729         .
     2730       end.
     2731       do with frame Dialog-Frame
     2732       :
     2733         hide v-diasize-resize-button .
     2734         v-diasize-resize-button :row = 1.
     2735         v-diasize-resize-button :column = 1.
     2736       end.
     2737       if p-change-value > 0
     2738       then do:
     2739         if frame Dialog-Frame :scrollable = true
     2740         then do:
     2741           assign
     2742             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2743             no-error .
     2744           if error-status :error
     2745           or error-status :get-message(1) <> ""
     2746           then do:
     2747             undo move_block, retry move_block.
     2748           end.
     2749         end.
     2750         assign
     2751           frame Dialog-Frame :width = v-frame-width + p-change-value
     2752           no-error .
     2753         if error-status :error
     2754         or error-status :get-message(1) <> ""
     2755         then do:
     2756           undo move_block, retry move_block.
     2757         end.
     2758         assign
     2759           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2760         no-error .
     2761         if error-status :error
     2762         or error-status :get-message(1) <> ""
     2763         then do:
     2764           undo move_block, retry move_block.
     2765         end.
     2766         for each buf_temp-browse-handle
     2767           where buf_temp-browse-handle.browse-type = 'width':u
     2768         on error undo move_block, retry move_block
     2769         :
     2770           assign
     2771             buf_temp-browse-handle.browse-handle :width
     2772               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2773             no-error .
     2774           if error-status :error
     2775           or error-status :get-message(1) <> ""
     2776           then do:
     2777             undo move_block, retry move_block .
     2778           end.
     2779         end.
     2780         for each buf_temp-diasize-handle
     2781         on error undo move_block, retry move_block
     2782         :
     2783           assign
     2784             v-object-handle = buf_temp-diasize-handle.handle-value
     2785           .
     2786           if v-object-handle <> v-diasize-resize-button
     2787           then do:
     2788             assign
     2789               v-object-handle :col = v-object-handle :col + p-change-value
     2790               no-error .
     2791             if error-status :error
     2792             or error-status :get-message(1) <> ""
     2793             then do:
     2794               undo move_block, retry move_block .
     2795             end.
     2796           end.
     2797         end.
     2798       end.
     2799       else do:
     2800         for each buf_temp-diasize-handle
     2801         on error undo move_block, retry move_block
     2802         :
     2803           assign
     2804             v-object-handle = buf_temp-diasize-handle.handle-value
     2805           .
     2806           if v-object-handle <> v-diasize-resize-button
     2807           then do:
     2808             assign
     2809               v-object-handle :col = v-object-handle :col + p-change-value
     2810               no-error .
     2811             if error-status :error
     2812             or error-status :get-message(1) <> ""
     2813             then do:
     2814               undo move_block, retry move_block .
     2815             end.
     2816           end.
     2817         end.
     2818         for each buf_temp-browse-handle
     2819           where buf_temp-browse-handle.browse-type = 'width':u
     2820         on error undo move_block, retry move_block
     2821         :
     2822           assign
     2823             buf_temp-browse-handle.browse-handle :width
     2824               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2825             no-error .
     2826           if error-status :error
     2827           or error-status :get-message(1) <> ""
     2828           then do:
     2829             undo move_block, retry move_block .
     2830           end.
     2831         end.
     2832         assign
     2833           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2834           no-error .
     2835         if error-status :error
     2836         or error-status :get-message(1) <> ""
     2837         then do:
     2838           undo move_block, retry move_block.
     2839         end.
     2840         assign
     2841           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2842         no-error .
     2843         if error-status :error
     2844         or error-status :get-message(1) <> ""
     2845         then do:
     2846           undo move_block, retry move_block.
     2847         end.
     2848         if frame Dialog-Frame :scrollable = true
     2849         then do:
     2850           assign
     2851             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2852           no-error .
     2853           if error-status :error
     2854           or error-status :get-message(1) <> ""
     2855           then do:
     2856             undo move_block, retry move_block.
     2857           end.
     2858         end.
     2859       end.
     2860       if p-move-resize
     2861       then do:
     2862         run diasize_position-resize-button in this-procedure .
     2863       end.
     2864       if v-diasize-wndstore = true
     2865       then do:
     2866         if connected("ub") = true
     2867         then do:
     2868           define variable v-cntxt-db-num        as integer   no-undo .
     2869           define variable v-cntxt-userid        as character no-undo .
     2870           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2871                                             , OUTPUT v-cntxt-userid
     2872                                             ) .
     2873           run gbl/wndsizew.p
     2874             (input  v-cntxt-db-num
     2875             ,input  v-cntxt-userid
     2876             ,input  v-diasize-proc-name
     2877             ,input  'width':u
     2878             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2879             ) .
     2880         end.
     2881       end.
     2882     end.
     2883     assign
     2884       v-diasize-change-size = false
     2885     .
     2886   end procedure.
     2887   procedure diasize_set-width :
     2888     define input  parameter p-new-width  as decimal   no-undo .
     2889     define input  parameter p-move-resize as logical   no-undo .
     2890     do
     2891     on error undo, return error return-value
     2892     :
     2893       run diasize_change-width in this-procedure
     2894         (input  (p-new-width - frame Dialog-Frame :width)
     2895         ,input  p-move-resize
     2896         ) .
     2897     end.
     2898   end procedure.
     2899   procedure diasize_position-resize-button :
     2900     do with frame Dialog-Frame
     2901     :
     2902       hide v-diasize-resize-button .
     2903       assign
     2904         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2905                     - 1
     2906                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2907         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2908                     - 1
     2909                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2910       .
     2911       view v-diasize-resize-button .
     2912     end.
     2913   end procedure.
     2914   on alt-right anywhere
     2915   do:
     2916     run diasize_change-width in this-procedure
     2917       (input 1
     2918       ,input true
     2919       ) .
     2920     return no-apply .
     2921   end.
     2922   on alt-left anywhere
     2923   do:
     2924     run diasize_change-width in this-procedure
     2925       (input -1
     2926       ,input true
     2927       ) .
     2928     return no-apply .
     2929   end.
     2930   on alt-down anywhere
     2931   do:
     2932     run diasize_change-height in this-procedure
     2933       (input 1
     2934       ,input true
     2935       ) .
     2936     return no-apply .
     2937   end.
     2938   on alt-up anywhere
     2939   do:
     2940     run diasize_change-height in this-procedure
     2941       (input -1
     2942       ,input true
     2943       ) .
     2944     return no-apply .
     2945   end.
     2946   on alt-enter of frame Dialog-Frame
     2947   do:
     2948     run diasize_maximize in this-procedure
     2949       (input  ?
     2950       ).
     2951     return no-apply .
     2952   end.
     2953   procedure diasize_end-move :
     2954     do
     2955     on error undo, return error return-value
     2956     :
     2957       define variable v-row-delta as decimal   no-undo .
     2958       define variable v-col-delta as decimal   no-undo .
     2959       define variable v-new-row as decimal   no-undo .
     2960       define variable v-new-col as decimal   no-undo .
     2961       assign
     2962         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2963         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2964       .
     2965       assign
     2966         v-row-delta = v-new-row - frame Dialog-Frame :height
     2967         v-col-delta = v-new-col - frame Dialog-Frame :width
     2968       .
     2969       run diasize_change-height in this-procedure
     2970         (input v-row-delta
     2971         ,input true
     2972         ) .
     2973       run diasize_change-width in this-procedure
     2974         (input v-col-delta
     2975         ,input true
     2976         ) .
     2977     end.
     2978   end procedure.
     2979   procedure diasize_maximize :
     2980     define input  parameter p-action as logical   no-undo .
     2981     do
     2982     on error undo, return error return-value
     2983     :
     2984       if p-action = ?
     2985       then do:
     2986         if v-diasize-need-maximize = true
     2987         then do:
     2988           assign
     2989             p-action = true
     2990           .
     2991         end.
     2992         else do:
     2993           assign
     2994             p-action = false
     2995           .
     2996         end.
     2997       end.
     2998       if p-action = true
     2999       then do:
     3000         run diasize_change-height in this-procedure
     3001           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3002               - frame Dialog-Frame :height-chars
     3003           ,input true
     3004           ) .
     3005         run diasize_change-width in this-procedure
     3006           (input session :width-chars
     3007               - frame Dialog-Frame :width-chars
     3008           ,input true
     3009           ) .
     3010         assign
     3011           v-diasize-need-maximize = false
     3012         .
     3013       end.
     3014       else do:
     3015         run diasize_change-width in this-procedure
     3016           (input v-diasize-orig-frame-width
     3017               - frame Dialog-Frame :width-chars
     3018           ,input true
     3019           ) .
     3020         run diasize_change-height in this-procedure
     3021           (input v-diasize-orig-frame-height
     3022               - frame Dialog-Frame :height-chars
     3023           ,input true
     3024           ) .
     3025         assign
     3026           v-diasize-need-maximize = true
     3027         .
     3028       end.
     3029     end.
     3030   end procedure.
     3031   procedure diasize_restore-orig-size :
     3032     do
     3033     on error undo, return error return-value
     3034     :
     3035       assign
     3036         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3037         v-diasize-current-frame-height = frame Dialog-Frame :height
     3038       .
     3039       run diasize_set-height in this-procedure
     3040         (input  v-diasize-orig-frame-height
     3041         ,input  true
     3042         ) .
     3043       run diasize_set-width in this-procedure
     3044         (input  v-diasize-orig-frame-width
     3045         ,input  true
     3046         ) .
     3047     end.
     3048   end procedure.
     3049   procedure diasize_restore-current-size :
     3050     do
     3051     on error undo, return error return-value
     3052     :
     3053       run diasize_set-height in this-procedure
     3054         (input  v-diasize-current-frame-height
     3055         ,input  true
     3056         ) .
     3057       run diasize_set-width in this-procedure
     3058         (input  v-diasize-current-frame-width
     3059         ,input  true
     3060         ) .
     3061     end.
     3062   end procedure.
     3063   procedure diasize_set-browse-handle :
     3064     define input  parameter p-browse-handle as handle   no-undo .
     3065     define buffer buf_temp-browse-handle for temp-browse-handle .
     3066     do
     3067     on error undo, return error return-value
     3068     :
     3069       assign
     3070         v-diasize-browse-handle = p-browse-handle
     3071       .
     3072       for each buf_temp-browse-handle
     3073       on error undo, return error return-value
     3074       :
     3075         delete buf_temp-browse-handle .
     3076       end.
     3077     end.
     3078   end procedure.
     3079   procedure diasize_add_browse :
     3080     define input  parameter p-browse-type   as character no-undo .
     3081     define input  parameter p-browse-handle as handle    no-undo .
     3082     define buffer buf_temp-browse-handle for temp-browse-handle .
     3083     do
     3084     on error undo, return error return-value
     3085     :
     3086       assign
     3087         v-diasize-browse-number = v-diasize-browse-number + 1
     3088       .
     3089       create buf_temp-browse-handle .
     3090       assign
     3091         buf_temp-browse-handle.browse-type   = p-browse-type
     3092         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3093         buf_temp-browse-handle.browse-handle = p-browse-handle
     3094       .
     3095     end.
     3096   end procedure.
     3097   procedure diasize_init :
     3098     define variable v-default-value    as logical   no-undo .
     3099     define variable v-restore-saved    as logical   no-undo .
     3100     define variable v-resize-value-str as character no-undo .
     3101     do
     3102     on error undo, return error return-value
     3103     :
     3104       do with frame Dialog-Frame
     3105       :
     3106         assign
     3107           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3108           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3109           v-diasize-browse-handle     = browse BR-c-fin-doc :handle
     3110         .
     3111         create button v-diasize-resize-button
     3112         assign
     3113           parent        = frame Dialog-Frame :first-child
     3114           label         = "s"
     3115           height-pixels = 16
     3116           width-pixels  = 16
     3117           visible       = true
     3118           sensitive     = true
     3119           movable       = true
     3120           triggers:
     3121             on end-move persistent run diasize_end-move in this-procedure .
     3122           end triggers.
     3123         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3124         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3125         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3126         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3127         assign
     3128           v-diasize-wndmax = false
     3129         .
     3130         if connected("ub") = true
     3131         then do:
     3132           define variable v-cntxt-db-num        as integer   no-undo .
     3133           define variable v-cntxt-userid        as character no-undo .
     3134           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3135                                             , OUTPUT v-cntxt-userid
     3136                                             ) .
     3137           run gbl/wndpar_r.p
     3138             (input  v-cntxt-db-num
     3139             ,input  v-cntxt-userid
     3140             ,input  'wndmax':U
     3141             ,output v-diasize-wndmax
     3142             ,output v-default-value
     3143             ) .
     3144         end.
     3145         assign
     3146           v-diasize-wndstore = false
     3147         .
     3148         if connected("ub") = true
     3149         then do:
     3150           run gbl/wndpar_r.p
     3151             (input  v-cntxt-db-num
     3152             ,input  v-cntxt-userid
     3153             ,input  'wndstore':U
     3154             ,output v-diasize-wndstore
     3155             ,output v-default-value
     3156             ) .
     3157         end.
     3158         assign
     3159           v-diasize-proc-name = entry(1, program-name(2), '.')
     3160         .
     3161         if v-diasize-wndstore = true
     3162         then do:
     3163           assign
     3164             v-restore-saved = false
     3165           .
     3166           if connected("ub") = true
     3167           then do:
     3168             run gbl/wndsizer.p
     3169               (input  v-cntxt-db-num
     3170               ,input  v-cntxt-userid
     3171               ,input  v-diasize-proc-name
     3172               ,input  'height':u
     3173               ,output v-resize-value-str
     3174               ) .
     3175             if v-resize-value-str <> '':U
     3176             then do:
     3177               run diasize_change-height in this-procedure
     3178                 (input  integer(v-resize-value-str)
     3179                 ,input  true
     3180                 ) .
     3181               assign
     3182                 v-restore-saved = true
     3183               .
     3184             end.
     3185           end.
     3186           if connected("ub") = true
     3187           then do:
     3188             run gbl/wndsizer.p
     3189               (input  v-cntxt-db-num
     3190               ,input  v-cntxt-userid
     3191               ,input  v-diasize-proc-name
     3192               ,input  'width':u
     3193               ,output v-resize-value-str
     3194               ) .
     3195             if v-resize-value-str <> '':U
     3196             then do:
     3197               run diasize_change-width in this-procedure
     3198                 (input  integer(v-resize-value-str)
     3199                 ,input  true
     3200                 ) .
     3201               assign
     3202                 v-restore-saved = true
     3203               .
     3204             end.
     3205           end.
     3206           if v-restore-saved <> true
     3207           then do:
     3208             if v-diasize-wndmax = true
     3209             then do:
     3210               run diasize_maximize in this-procedure
     3211                 (input  true
     3212                 ) .
     3213             end.
     3214           end.
     3215         end.
     3216         else do:
     3217           if v-diasize-wndmax = true
     3218           then do:
     3219             run diasize_maximize in this-procedure
     3220               (input  true
     3221               ) .
     3222           end.
     3223         end.
     3224       end.
     3225     end.
     3226   end procedure.
     3227   procedure diasize_need-full-display :
     3228     define output parameter p-need-full-display as logical   no-undo .
     3229     do
     3230     on error undo, return error return-value
     3231     :
     3232       assign
     3233         p-need-full-display = v-diasize-need-full-display
     3234       .
     3235       assign
     3236         v-diasize-need-full-display = false
     3237       .
     3238     end.
     3239   end procedure.
     3240   procedure get-context :
     3241      define output parameter p-db-num as integer          no-undo.
     3242      define output parameter p-user-id as character        no-undo.
     3243      define variable v-login               as character    no-undo.
     3244      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3245      define buffer buf_user-login  for ub.user-login .
     3246      do
     3247      on error undo, return error
     3248      :
     3249            FIND FIRST buf_sys-ctrl no-lock.
     3250            ASSIGN
     3251               v-login = USERID("ub")
     3252               p-db-num = buf_sys-ctrl.db-num
     3253            .
     3254            FIND FIRST buf_user-login
     3255                 WHERE buf_user-login.db-num = p-db-num
     3256                   AND buf_user-login.user-login = v-login
     3257                 no-lock
     3258                 no-error
     3259                 .
     3260            IF AVAILABLE buf_user-login
     3261            THEN DO:
     3262               assign
     3263                  p-user-id = buf_user-login.user-id
     3264               .
     3265            END.
     3266      end.
     3267   end procedure.
     3268   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
