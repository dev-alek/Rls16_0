     4136       p-host-code p-fin-doc-code
     4137       view-as alert-box ERROR.
     4138       return.
     4139     end.
     4140     assign
     4141     is-cash-mode =  (X_fin-doc.fin-doc-type = 'пко':U
     4142                       OR X_fin-doc.fin-doc-type = 'рко':U)
     4143     .
     4144     find first X_sysconf no-lock where
     4145                     X_sysconf.host-code = p-host-code no-error.
     4146     if not available X_sysconf then do:
     4147       message
     4148       vss-workfile vss-revision vss-description skip
     4149       "Неверное значение параметра вызова p-host-code"
     4150       p-host-code
     4151       view-as alert-box ERROR.
     4152       return.
     4153     end.
     4154   end.
     4155   v-rid-list = p-rid-list.
