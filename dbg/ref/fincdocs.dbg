      682           view-as alert-box .
      683         Return  .
      684       End.
      685       run gbl/prnfilen.w
      686         (input  ""
      687         ,input  p-DisabledOptions
      688         ,input  string(v-report-name )
      689         ,input  7
      690         ,output v-user-action
      691         ,output v-printed
      692         ) .
      693       if v-printed then
      694       do:
      695         return "YES" .
      696       end.
      697       else
