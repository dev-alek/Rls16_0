     5865   FUNCTION get-contract RETURNS CHARACTER
     5866     ( BUFFER loc-c-fin-doc FOR ub.c-fin-doc ) :
     5867   define buffer buf_contract for ub.contract.
     5868     find first buf_contract no-lock where
     5869                   buf_contract.host-code = loc-c-fin-doc.host-code
     5870               AND buf_contract.contract-code = loc-c-fin-doc.contract-code no-error.
     5871       if available buf_contract then return buf_contract.contract-prn-code.
     5872     RETURN "".
     5873   END FUNCTION.
     5874   FUNCTION get-cashbookname RETURNS CHARACTER
     5875     ( input iCashbookID as int64) :
     5876   define buffer buf_cashbook for ub.cashbook.
     5877     find first buf_cashbook no-lock where
     5878                   buf_cashbook.id = iCashbookID
     5879        no-error.
     5880     if available buf_cashbook
     5881     then return buf_cashbook.CashBookName.
     5882     else return string(iCashbookID).
     5883   END FUNCTION.
     5884   FUNCTION get-currency RETURNS CHARACTER
     5885     ( BUFFER loc-c-fin-doc FOR ub.c-fin-doc ) :
     5886    define buffer buf_currency for ub.currency.
     5887     find first buf_currency no-lock where
     5888                   buf_currency.curr-code = loc-c-fin-doc.curr-code no-error.
     5889       if available buf_currency then return buf_currency.curr-abbr.
     5890     RETURN string(loc-c-fin-doc.curr-code).
     5891   END FUNCTION.
     5892   FUNCTION get-shift RETURNS DATE
     5893     ( BUFFER buf_c-fin-doc FOR ub.c-fin-doc, OUTPUT p-shift-name-num AS CHARACTER ) :
     5894   define variable v-fin-doc-shift-name-num as character no-undo.
     5895   define variable v-fin-doc-shift-name as character no-undo .
     5896   IF buf_c-fin-doc.shift-date = ? THEN DO:
     5897      RETURN ?.
     5898   END.
     5899   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_shiftnam in g#lib-trn3
     5900     (
     5901        input buf_c-fin-doc.obj-type
     5902     ,  input buf_c-fin-doc.obj-code
     5903     ,  input buf_c-fin-doc.shift-date
     5904     ,  input buf_c-fin-doc.shift-num
     5905     , output v-fin-doc-shift-name
     5906     , output v-fin-doc-shift-name-num
     5907     )        no-error .
     5908   ASSIGN
     5909   p-shift-name-num = v-fin-doc-shift-name-num
     5910    .
     5911   RETURN buf_c-fin-doc.shift-date.
     5912   END FUNCTION.
