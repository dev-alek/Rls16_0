      801   procedure prn-lib-reportviewer :
      802     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      803     define input parameter p-report-name-html as character no-undo .
      804     define input parameter p-param        as character no-undo .
      805     define variable v-excel           as character no-undo init 'TRUE' .
      806     define variable v-value-character as character no-undo .
      807     define variable v-value-integer   as character no-undo .
      808     define variable v-value-date      as date      no-undo .
      809     define variable v-value-decimal   as decimal   no-undo .
      810     define variable rep-excel         as logical   no-undo .
      811     define variable excel-string      as character no-undo .
      812     define variable v-param-type      as character no-undo .
      813     define variable v-tth             as handle    no-undo .
      814     run adm/shattri.p (
      815       input "get":U
      816       ,input  ""
      817       ,input  0
      818       ,input  'report-glob':U
      819       ,input  'rep-excel':U
      820       ,output v-value-character
      821       ,output v-value-date
      822       ,output v-value-decimal
      823       ,output v-value-integer
      824       ,output rep-excel
      825       ,output v-param-type
      826       ,INPUT-OUTPUT table-handle v-tth
      827       )  .
      828     if rep-excel then v-excel = "TRUE" .
      829     else v-excel = "FALSE" .
      830     if p-param eq ""
      831     then
      832        p-param = "EXCEL:" + v-excel.
      833     else
