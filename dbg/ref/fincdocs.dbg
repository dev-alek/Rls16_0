      703   procedure prn-lib-open-stream :
      704     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      705     define input parameter p-page-size    as integer no-undo .
      706     define input parameter p-is-stream    as logical no-undo .
      707     define input parameter p-append       as logical no-undo .
      708     define variable v-report-name as character no-undo .
      709     do
      710       on error undo, return error
      711       :
      712       run prn-lib-get-report-name  in this-procedure (
      713         input parParentProc
      714         ,output v-report-name
      715         ).
      716       if p-is-stream then
      717       do:
      718         if p-append then
      719         do:
      720           output stream PrnLibStream to value( v-report-name )
      721             page-size value(p-page-size) append .
      722         end.
      723         if not p-append then
      724         do:
      725           output stream PrnLibStream to value( v-report-name )
      726             page-size value(p-page-size) .
      727         end.
      728       end.
      729       if not p-is-stream then
      730       do:
      731         if p-append then
      732         do:
      733           output to value( v-report-name )
      734             page-size value(p-page-size) append .
      735         end.
      736         if not p-append then
      737         do:
      738           output to value( v-report-name )
      739             page-size value(p-page-size) .
      740         end.
      741       end.
      742     end.
      743   end procedure.
      744   procedure prn-lib-open-exp :
      745     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      746     define input parameter p-is-stream    as logical no-undo .
      747     define input parameter p-is-append    as logical no-undo .
      748     define output parameter p-ReportFileName as char init "report" no-undo.
      749     define output parameter p-process as logical no-undo .
      750     define variable glog as logical no-undo .
      751     do
      752       on error undo, return error
      753       :
      754       SYSTEM-DIALOG GET-FILE p-ReportFileName
      755         TITLE      "Укажите путь"
      756         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      757         ASK-OVERWRITE
      758         CREATE-TEST-FILE
      759         SAVE-AS
      760         USE-FILENAME
      761         DEFAULT-EXTENSION "txt"
      762         UPDATE glog
      763         .
      764       if not glog then  return.
      765       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      766       if p-is-stream then
      767       do:
      768         if p-is-append then
      769         do:
      770           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      771         end.
      772         else
      773         do:
      774           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      775         end.
      776       end.
      777       else
      778       do:
      779         if p-is-append then
      780         do:
      781           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      782         end.
      783         else
      784         do:
      785           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      786         end.
      787       end.
      788       p-process = yes.
      789     end.
      790   end procedure.
