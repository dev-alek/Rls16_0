        1   block-level on error undo, throw.
        2   define input  parameter p-cli-type as character no-undo .
        3   define input  parameter p-cli-code as integer   no-undo .
        4   define input  parameter p-obj-type as character no-undo .
        5   define input  parameter p-obj-code as integer   no-undo .
        6   define input  parameter p-fact-order as decimal no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: calctur1.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: ref/calctur1.p $":U .
       12   define variable vss-description as character no-undo init "Пересчет оборотов нарастающим итогом".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   define variable v-waitfram-action01         as character   no-undo .
       73   define variable v-waitfram-action02         as character   no-undo .
       74   define variable v-waitfram-action03         as character   no-undo .
       75   define variable mWaitFramTextBeg            as character   no-undo.
       76   define variable mWaitFramTextEnd            as character   no-undo.
       77   define variable mWaitFramView               as logical     no-undo.
       78   define variable mWaitProcEvent              as logical     no-undo init yes.
       79   define variable mWaitFramInterval           as integer     no-undo init 1 .
       80   define variable mWaitFramStop               as logical     no-undo.
       81   define variable mWaitFramStopUser           as logical     no-undo.
       82   define variable mWaitFramStopTimeOut        as logical     no-undo.
       83   define variable mWaitFramStartProc          as datetime-tz no-undo.
       84   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       85   define button B-WaitFramStop auto-end-key
       86        label "Стоп"
       87        size 10 by 1 tooltip "Остоновить процесс".
       88   define button B-viewProcInfo
       89        label "Информация"
       90        size 15 by 1 tooltip "Информация о процесс".
       91   define frame waitfram
       92     v-waitfram-action01 format "x(72)" no-label skip
       93     v-waitfram-action02 format "x(72)" no-label skip
       94     v-waitfram-action03 format "x(72)" no-label skip
       95     B-viewProcInfo
       96     B-WaitFramStop at row 4 col 30
       97     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       98     .
       99   define new global shared variable mBatchMode as logical no-undo init ?.
      100   define variable mFramBachModHandle as handle no-undo.
      101   mFramBachModHandle = frame waitfram:handle.
      102   define variable mFameOldVis as logical no-undo.
      103   define variable mVisCUrentVin as logical no-undo.
      104   if session:batch-mode
      105   then
      106      mBatchMode = yes.
      107   if mBatchMode = ? then do:
      108     mVisCUrentVin = current-window:visible.
      109     mFameOldVis = mFramBachModHandle:visible.
      110     mFramBachModHandle:visible  = yes.
      111     mBatchMode = mFramBachModHandle:visible ne yes.
      112     mFramBachModHandle:visible = mFameOldVis.
      113     current-window:visible = mVisCUrentVin.
      114   end.
      115    if  log-manager:logfile-name ne ?
      116     then DO:
      117         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      118         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      119         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      120     end.
      121   on choose of B-WaitFramStop in frame waitfram
      122   do:
      123     mWaitFramStop = yes.
      124     mWaitFramStopUser = yes.
      125   end.
      126   function waitfram-check-timeout returns logical():
      127      define variable vtime as int64 no-undo.
      128      if mWaitFramStopTimeOut
      129      then
      130         return yes.
      131      vtime = ( now - mWaitFramStartProc ) / 1000 .
      132      if     mWaitFramTimeOut ne ?
      133         and mWaitFramTimeOut ne 0
      134         and mWaitFramTimeOut lt vtime
      135      then do:
      136         mWaitFramStopTimeOut = yes.
      137      end.
      138      return mWaitFramStopTimeOut.
      139   end.
      140   procedure waitfram-hide :
      141     if not session:batch-mode
      142     then do
      143     on error undo, return error return-value
      144     :
      145       pause 0 before-hide .
      146       if not mBatchMode then
      147         hide frame waitfram .
      148     if     not mWaitFramView
      149        and mWaitProcEvent
      150     then
      151       process events .
      152     end.
      153   end procedure.
      154   procedure waitfram-show :
      155     define input  parameter p-message as character no-undo .
      156     define variable v-left-margin as integer   no-undo .
      157     if not session:batch-mode
      158     then do
      159     on error undo, return error return-value
      160     :
      161       if length(p-message) <= 70 then do:
      162         assign
      163           v-left-margin = integer((70 - length(p-message)) / 2)
      164         .
      165         assign
      166           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      167         .
      168         assign
      169           v-waitfram-action01 = " "
      170           v-waitfram-action02 = " "
      171                                    + fill(" ", v-left-margin)
      172                                    + p-message
      173           v-waitfram-action03 = " "
      174         .
      175       end.
      176       else do:
      177         define variable vRindex1 as integer no-undo.
      178         define variable vRindex2 as integer no-undo.
      179         vRindex1 = r-index(p-message," ",70).
      180         if vRindex1 = 0
      181         then
      182            vRindex1 = 70.
      183         if length(p-message)  <= vRindex1 + 70 then do:
      184           assign
      185             v-waitfram-action01 = " "
      186             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      187             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      188           .
      189         end.
      190         else do:
      191           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      192           if vRindex2 <= vRindex1
      193           then
      194              vRindex2 = vRindex1 + 70.
      195           assign
      196             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      197             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      198             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      199           .
      200         end.
      201       end.
      202       B-viewProcInfo:visible   in frame waitfram = no.
      203       B-viewProcInfo:sensitive in frame waitfram = no.
      204       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      205       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      206       if  (   mWaitFramView
      207          or  mWaitProcEvent)
      208          and not mBatchMode
      209       then
      210          display
      211             v-waitfram-action01 skip
      212             v-waitfram-action02 skip
      213             v-waitfram-action03 skip
      214          with frame waitfram .
      215       if     mWaitFramView
      216          then do:
      217             if     mWaitFramInterval ne ?
      218                and not mBatchMode
      219             then
      220                wait-for go of frame waitfram pause mWaitFramInterval.
      221          end.
      222          else
      223             if     mWaitProcEvent
      224                and not mBatchMode
      225             then
      226                process events .
      227     end.
      228   end procedure.
      229      procedure waitfram-show-this:
      230         define input  parameter iInterval as int64 no-undo.
      231         define variable vtime as int64 no-undo.
      232         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      233         mWaitFramInterval = iInterval.
      234         run waitfram-show (substitute("&1&2 &3&4" ,
      235                                       mWaitFramTextBeg ,
      236                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      237                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      238                                       mWaitFramTextEnd
      239                                      )
      240                           ).
      241      end.
      242      procedure WaitFramRunPause:
      243         define input  parameter iInterval as dec no-undo.
      244         define variable vStart  as datetime-tz no-undo.
      245         define variable vend    as datetime-tz no-undo.
      246         define variable vint as int64 no-undo.
      247         define variable vOk as logical no-undo.
      248         vStart = now.
      249         vend   = vStart.
      250         publish "WaitFramPause" (iInterval,output vOk).
      251         vend   =  now.
      252         vint = vend - vStart.
      253         vint = iInterval - vint / 1000.
      254         if     not mWaitFramStop
      255            and (   vint > 0
      256                 or (    not vOk
      257                     and iInterval eq ?
      258                     )
      259                 )
      260         then
      261            run waitfram-show-this (iInterval).
      262         vend   =  now.
      263         vint = vend - vStart.
      264         vint = iInterval - vint / 1000.
      265         if     not mWaitFramStop
      266            and vint > 0
      267         then do:
      268            run gbl/pause.p (vint * 1000).
      269         end.
      270         if iInterval ne ?
      271         then
      272            publish "WaitFramStop".
      273         waitfram-check-timeout().
      274      end.
      275      procedure WaitFramWaitFor:
      276         define input  parameter iInterval as dec no-undo.
      277         assign
      278            mWaitFramStartProc   = now
      279            mWaitFramStopUser    = no
      280            mWaitFramStopTimeOut = no
      281         .
      282         block-wait:
      283         do while not mWaitFramStop:
      284            run WaitFramRunPause (iInterval).
      285            if  waitfram-check-timeout()
      286            then do:
      287               leave block-wait.
      288            end.
      289         end.
      290         run waitfram-hide.
      291      end.
      292   procedure waitfram-join :
      293     define input  parameter p-line-1  as character no-undo .
      294     define input  parameter p-line-2  as character no-undo .
      295     define input  parameter p-line-3  as character no-undo .
      296     define output parameter p-message as character no-undo .
      297     do
      298     on error undo, return error return-value
      299     :
      300       assign
      301         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      302                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      303                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      304       .
      305     end.
      306   end procedure.
      307   function waitfram-join-function returns character
      308     (input p-line-1 as character
      309     ,input p-line-2 as character
      310     ,input p-line-3 as character
      311     ).
      312     define variable v-message as character no-undo .
      313     run waitfram-join in this-procedure
      314       (input  p-line-1
      315       ,input  p-line-2
      316       ,input  p-line-3
      317       ,output v-message
      318       ) .
      319     return v-message .
      320   end function .
      321   define variable   v-sum-acc-base       as decimal   no-undo init 0 .
      322   define variable   v-sum-acc-rubl       as decimal   no-undo init 0 .
      323   define variable   v-sum-doc-base       as decimal   no-undo init 0 .
      324   define variable   v-sum-doc-rubl       as decimal   no-undo init 0 .
      325   define variable   v-sum-slt-acc-base   as decimal   no-undo init 0 .
      326   define variable   v-sum-slt-acc-rubl   as decimal   no-undo init 0 .
      327   define variable   v-sum-slt-doc-base   as decimal   no-undo init 0 .
      328   define variable   v-sum-slt-doc-rubl   as decimal   no-undo init 0 .
      329   define variable   v-sum-vat-acc-base   as decimal   no-undo init 0 .
      330   define variable   v-sum-vat-acc-rubl   as decimal   no-undo init 0 .
      331   define variable   v-sum-vat-doc-base   as decimal   no-undo init 0 .
      332   define variable   v-sum-vat-doc-rubl   as decimal   no-undo init 0 .
      333   define variable   v-sum-qnty-doc       as decimal   no-undo init 0 .
      334   define variable   v-sum-qnty-check     as decimal   no-undo init 0 .
      335   run waitfram-show ( "Ждите..." ) .
      336   define buffer buf_turnover-buyer      for ub.turnover-buyer  .
      337   define buffer buf_turnover-buyer-main for ub.turnover-buyer-main  .
      338   define buffer buf_turnover-buyer-gds  for ub.turnover-buyer-gds  .
      339   find first buf_turnover-buyer no-lock where
      340       buf_turnover-buyer.cli-type  =  p-cli-type and
      341       buf_turnover-buyer.cli-code  =  p-cli-code and
      342       buf_turnover-buyer.obj-type  =  p-obj-type and
      343       buf_turnover-buyer.obj-code  =  p-obj-code and
      344       buf_turnover-buyer.fact-order < p-fact-order use-index clients no-error .
      345       if available buf_turnover-buyer then do:
      346       assign
      347           v-sum-acc-base      = buf_turnover-buyer.sum-acc-base-itog
      348           v-sum-acc-rubl      = buf_turnover-buyer.sum-acc-rubl-itog
      349           v-sum-doc-base      = buf_turnover-buyer.sum-doc-base-itog
      350           v-sum-doc-rubl      = buf_turnover-buyer.sum-doc-rubl-itog
      351           v-sum-slt-acc-base  = buf_turnover-buyer.sum-slt-acc-base-itog
      352           v-sum-slt-acc-rubl  = buf_turnover-buyer.sum-slt-acc-rubl-itog
      353           v-sum-slt-doc-base  = buf_turnover-buyer.sum-slt-doc-base-itog
      354           v-sum-slt-doc-rubl  = buf_turnover-buyer.sum-slt-doc-rubl-itog
      355           v-sum-vat-acc-base  = buf_turnover-buyer.sum-vat-acc-base-itog
      356           v-sum-vat-acc-rubl  = buf_turnover-buyer.sum-vat-acc-rubl-itog
      357           v-sum-vat-doc-base  = buf_turnover-buyer.sum-vat-doc-base-itog
      358           v-sum-vat-doc-rubl  = buf_turnover-buyer.sum-vat-doc-rubl-itog
      359           v-sum-qnty-doc      = buf_turnover-buyer.qnty-doc-itog
      360           v-sum-qnty-check    = buf_turnover-buyer.qnty-check-itog
      361       .
      362          if v-sum-qnty-doc      = ?  then v-sum-qnty-doc   = 0 .
      363          if v-sum-qnty-check    = ?  then v-sum-qnty-check = 0 .
      364       end.
      365       else do:
      366       assign
      367           v-sum-acc-base      = 0
      368           v-sum-acc-rubl      = 0
      369           v-sum-doc-base      = 0
      370           v-sum-doc-rubl      = 0
      371           v-sum-slt-acc-base  = 0
      372           v-sum-slt-acc-rubl  = 0
      373           v-sum-slt-doc-base  = 0
      374           v-sum-slt-doc-rubl  = 0
      375           v-sum-vat-acc-base  = 0
      376           v-sum-vat-acc-rubl  = 0
      377           v-sum-vat-doc-base  = 0
      378           v-sum-vat-doc-rubl  = 0
      379           v-sum-qnty-doc      = 0
      380           v-sum-qnty-check    = 0
      381       .
      382       end.
      383   for each buf_turnover-buyer exclusive-lock where
      384       buf_turnover-buyer.cli-type  =  p-cli-type and
      385       buf_turnover-buyer.cli-code  =  p-cli-code and
      386       buf_turnover-buyer.obj-type  =  p-obj-type and
      387       buf_turnover-buyer.obj-code  =  p-obj-code and
      388       buf_turnover-buyer.fact-order >= p-fact-order
      389       break by fact-order :
      390         assign
      391           v-sum-acc-base     =  v-sum-acc-base     +  buf_turnover-buyer.sum-acc-base
      392           v-sum-acc-rubl     =  v-sum-acc-rubl     +  buf_turnover-buyer.sum-acc-rubl
      393           v-sum-doc-base     =  v-sum-doc-base     +  buf_turnover-buyer.sum-doc-base
      394           v-sum-doc-rubl     =  v-sum-doc-rubl     +  buf_turnover-buyer.sum-doc-rubl
      395           v-sum-slt-acc-base =  v-sum-slt-acc-base +  buf_turnover-buyer.sum-slt-acc-base
      396           v-sum-slt-acc-rubl =  v-sum-slt-acc-rubl +  buf_turnover-buyer.sum-slt-acc-rubl
      397           v-sum-slt-doc-base =  v-sum-slt-doc-base +  buf_turnover-buyer.sum-slt-doc-base
      398           v-sum-slt-doc-rubl =  v-sum-slt-doc-rubl +  buf_turnover-buyer.sum-slt-doc-rubl
      399           v-sum-vat-acc-base =  v-sum-vat-acc-base +  buf_turnover-buyer.sum-vat-acc-base
      400           v-sum-vat-acc-rubl =  v-sum-vat-acc-rubl +  buf_turnover-buyer.sum-vat-acc-rubl
      401           v-sum-vat-doc-base =  v-sum-vat-doc-base +  buf_turnover-buyer.sum-vat-doc-base
      402           v-sum-vat-doc-rubl =  v-sum-vat-doc-rubl +  buf_turnover-buyer.sum-vat-doc-rubl
      403           .
      404           if buf_turnover-buyer.doc-code   <> "" then v-sum-qnty-doc = v-sum-qnty-doc + 1.
      405           if buf_turnover-buyer.inkas-code <> "" then v-sum-qnty-check = v-sum-qnty-check + 1.
      406         assign
      407           buf_turnover-buyer.sum-acc-base-itog      = v-sum-acc-base
      408           buf_turnover-buyer.sum-acc-rubl-itog      = v-sum-acc-rubl
      409           buf_turnover-buyer.sum-doc-base-itog      = v-sum-doc-base
      410           buf_turnover-buyer.sum-doc-rubl-itog      = v-sum-doc-rubl
      411           buf_turnover-buyer.sum-slt-acc-base-itog  = v-sum-slt-acc-base
      412           buf_turnover-buyer.sum-slt-acc-rubl-itog  = v-sum-slt-acc-rubl
      413           buf_turnover-buyer.sum-slt-doc-base-itog  = v-sum-slt-doc-base
      414           buf_turnover-buyer.sum-slt-doc-rubl-itog  = v-sum-slt-doc-rubl
      415           buf_turnover-buyer.sum-vat-acc-base-itog  = v-sum-vat-acc-base
      416           buf_turnover-buyer.sum-vat-acc-rubl-itog  = v-sum-vat-acc-rubl
      417           buf_turnover-buyer.sum-vat-doc-base-itog  = v-sum-vat-doc-base
      418           buf_turnover-buyer.sum-vat-doc-rubl-itog  = v-sum-vat-doc-rubl
      419           buf_turnover-buyer.qnty-doc-itog          = v-sum-qnty-doc
      420           buf_turnover-buyer.qnty-check-itog        = v-sum-qnty-check
      421           .
      422   end.
      423   run waitfram-show ( "Пересчет по объекту ..." ) .
      424   find first buf_turnover-buyer-main exclusive-lock where
      425         buf_turnover-buyer-main.cli-code     = p-cli-code  and
      426         buf_turnover-buyer-main.cli-type     = p-cli-type  and
      427         buf_turnover-buyer-main.obj-code     = p-obj-code  and
      428         buf_turnover-buyer-main.obj-type     = p-obj-type  no-error .
      429         if not available buf_turnover-buyer-main then  do:
      430            create buf_turnover-buyer-main .
      431         end.
      432         assign
      433           buf_turnover-buyer-main.cli-code     = p-cli-code
      434           buf_turnover-buyer-main.cli-type     = p-cli-type
      435           buf_turnover-buyer-main.obj-code     = p-obj-code
      436           buf_turnover-buyer-main.obj-type     = p-obj-type
      437           buf_turnover-buyer-main.obj-type     = p-obj-type
      438           buf_turnover-buyer-main.sum-acc-base-itog     =  v-sum-acc-base
      439           buf_turnover-buyer-main.sum-acc-rubl-itog     =  v-sum-acc-rubl
      440           buf_turnover-buyer-main.sum-doc-base-itog     =  v-sum-doc-base
      441           buf_turnover-buyer-main.sum-doc-rubl-itog     =  v-sum-doc-rubl
      442           buf_turnover-buyer-main.qnty-doc-itog   = v-sum-qnty-doc
      443           buf_turnover-buyer-main.qnty-check-itog = v-sum-qnty-check
      444         .
      445   run waitfram-hide .
