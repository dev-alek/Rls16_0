      802          return no-apply.
      803       end.
      804     end.
      805   END.
      806   ON LEAVE OF tt-fin-schet.code-bank IN FRAME Dialog-Frame
      807   DO:
      808   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      809   if lookup(self :type
      810            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      811            ) = 0
      812   then do:
      813     message
      814       "$Workfile$"
      815       "Указанному интерфейсному элементу фокус не может быть передан" skip
      816       "Интерфейсный элемент" self :name  skip
      817       "Тип" self :type  skip
