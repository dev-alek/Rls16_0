      739   ON CHOOSE OF B-print IN FRAME Dialog-Frame
      740   DO:
      741   define variable v-log as logical no-undo .
      742   define variable v-cmp as character no-undo .
      743   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      744   if lookup(self :type
      745            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      746            ) = 0
