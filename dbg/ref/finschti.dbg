      782   ON LEAVE OF tt-fin-schet.cli-code IN FRAME Dialog-Frame
      783   DO:
      784     if   input frame Dialog-Frame tt-fin-schet.cli-code <> 0
      785     and input frame Dialog-Frame tt-fin-schet.cli-code <> ?
      786     then do:
      787       run check-cli in this-procedure no-error.
      788       if error-status:error then do:
      789          return no-apply.
      790       end.
      791     end.
      792   END.
      793   ON VALUE-CHANGED OF tt-fin-schet.cli-type IN FRAME Dialog-Frame
      794   DO:
      795     assign
      796     tt-fin-schet.cli-type.
      797     if   input frame Dialog-Frame tt-fin-schet.cli-code <> 0
      798     and input frame Dialog-Frame tt-fin-schet.cli-code <> ?
