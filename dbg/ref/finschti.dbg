      526   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      527   if lookup(self :type
      528            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      529            ) = 0
      530   then do:
      531     message
      532       "$Workfile$"
      533       "Указанному интерфейсному элементу фокус не может быть передан" skip
      534       "Интерфейсный элемент" self :name  skip
      535       "Тип" self :type  skip
      536       "Процедура" this-procedure :file-name skip
      537       view-as alert-box .
      538   end.
      539   else do:
      540     apply "entry":u to self  .
      541     if focus :handle <> self :handle  then do:
      542       return no-apply .
      543     end.
      544   end.
      545   if available X_fin-bank then do:
      546       assign
      547        v-rid-list = string(recid(X_fin-bank))
      548        .
      549   end.
      550   run ref/finbanks.w (input parParentProc
      551                 , input p-curr-host-code
      552                 , input "b-sel":U
      553                 , input 'фирма':U
      554                 , input p-host-code
      555                 , input-output v-status_
      556                 , input-output v-rid-list).
      557       if v-rid-list = "" then   do:
      558         return no-apply.
      559        end.
      560       ref-rec = integer( v-rid-list ).
      561       FIND FIRST buf_fin-bank WHERE
      562                recid (buf_fin-bank) = ref-rec NO-LOCK .
      563       if buf_fin-bank.status_ <> 'тек':U then do:
      564         message
      565         "Статус выбранного Вами банка" buf_fin-bank.status_ " - нельзя работать с таким банком"
      566         view-as alert-box error .
      567         return no-apply.
      568       end.
      569       FIND FIRST X_fin-bank WHERE recid (X_fin-bank) = ref-rec NO-LOCK .
      570       assign
      571       tt-fin-schet.code-bank =  X_fin-bank.code-bank
      572       tt-fin-schet.c-schet = X_fin-bank.cor-acc
      573       f-bank-name = X_fin-bank.bank-name
      574        f-bik = X_fin-bank.bik
      575       .
      576       display
      577         tt-fin-schet.code-bank
      578         f-bank-name
      579         f-bik
      580         tt-fin-schet.c-schet
      581       with frame Dialog-Frame.
      582   END.
      583   ON CHOOSE OF B-cli IN FRAME Dialog-Frame
      584   DO:
      585   define variable ref-list as character no-undo.
      586   define variable ref-rec as recid no-undo.
      587   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      588   if lookup(self :type
      589            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      590            ) = 0
      591   then do:
      592     message
      593       "$Workfile$"
      594       "Указанному интерфейсному элементу фокус не может быть передан" skip
      595       "Интерфейсный элемент" self :name  skip
      596       "Тип" self :type  skip
      597       "Процедура" this-procedure :file-name skip
      598       view-as alert-box .
      599   end.
      600   else do:
      601     apply "entry":u to self  .
      602     if focus :handle <> self :handle  then do:
      603       return no-apply .
      604     end.
      605   end.
      606     run ref/cli-all.w (  parParentProc
      607                     , "b-sel"
      608                     , tt-fin-schet.cli-type
      609                     , ?
      610                     , ?
      611                     , ?
      612                     , ?
      613                     , "without-obj":U
      614                     , output ref-list) .
      615       if ref-list = "" then   do:
      616         return no-apply.
      617        end.
      618       ref-rec = integer( ref-list ).
      619       FIND FIRST X_schet-clients WHERE recid (X_schet-clients) = ref-rec NO-LOCK .
      620       if NOT (X_schet-clients.obj-type = 'орг':U
      621               or
      622               X_schet-clients.obj-type = 'чел':U ) then do:
      623         message
      624         "Выберите контрагента типа" 'орг':U "или" 'чел':U
      625         view-as alert-box error .
      626         return no-apply.
      627       end.
      628       assign
      629       tt-fin-schet.cli-type =  X_schet-clients.obj-type
      630       tt-fin-schet.cli-code = X_schet-clients.obj-code
      631       f-cli-name            =  X_schet-clients.obj-name
      632       .
      633       display
      634         tt-fin-schet.cli-type
      635         tt-fin-schet.cli-code
      636         f-cli-name
      637       with frame Dialog-Frame.
      638   END.
