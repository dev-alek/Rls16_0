       97   procedure proc-alt-shift-f2:
       98     if not ibs.th.gbl.gbl-var:rcode
       99   then
      100     run gbl\inidebug.p .
      101   end.
      102   procedure proc-alt-shift-f3:
      103     run gbl/prvssinf.p
      104       ( input this-procedure
      105       ) .
      106   end.
      107   define variable v-inform-launched as logical no-undo initial false .
      108   procedure proc-alt-shift-f4:
      109     define variable v-action as character no-undo .
      110     if v-inform-launched = false then do:
      111       assign
      112         v-inform-launched = true
      113       .
      114       run gbl/d-inform.w
      115         (  input self
      116         ,  input this-procedure
      117         , output v-action
      118         ) no-error .
      119       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      120       assign
      121         v-inform-launched = false
      122       .
      123     end.
      124   end.
      125   procedure proc-alt-f1:
      126     run gbl/corrhelp.p
      127       (input this-procedure
      128       ) .
      129   end .
      130   on alt-shift-f2 anywhere do:
      131     run proc-alt-shift-f2.
      132   end.
      133   on alt-shift-f3 anywhere do:
      134     run proc-alt-shift-f3 in this-procedure .
      135   end.
      136   on alt-shift-f4 anywhere do:
      137     run proc-alt-shift-f4 in this-procedure.
      138   end.
      139   on alt-f1 anywhere do:
      140     run proc-alt-f1 in this-procedure .
      141   end.
      142   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      143   define variable v-waitfram-action01         as character   no-undo .
      144   define variable v-waitfram-action02         as character   no-undo .
      145   define variable v-waitfram-action03         as character   no-undo .
      146   define variable mWaitFramTextBeg            as character   no-undo.
      147   define variable mWaitFramTextEnd            as character   no-undo.
      148   define variable mWaitFramView               as logical     no-undo.
      149   define variable mWaitProcEvent              as logical     no-undo init yes.
      150   define variable mWaitFramInterval           as integer     no-undo init 1 .
      151   define variable mWaitFramStop               as logical     no-undo.
      152   define variable mWaitFramStopUser           as logical     no-undo.
      153   define variable mWaitFramStopTimeOut        as logical     no-undo.
      154   define variable mWaitFramStartProc          as datetime-tz no-undo.
      155   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      156   define button B-WaitFramStop auto-end-key
      157        label "Стоп"
      158        size 10 by 1 tooltip "Остоновить процесс".
      159   define button B-viewProcInfo
      160        label "Информация"
      161        size 15 by 1 tooltip "Информация о процесс".
      162   define frame waitfram
      163     v-waitfram-action01 format "x(72)" no-label skip
      164     v-waitfram-action02 format "x(72)" no-label skip
      165     v-waitfram-action03 format "x(72)" no-label skip
      166     B-viewProcInfo
      167     B-WaitFramStop at row 4 col 30
      168     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      169     .
      170   define new global shared variable mBatchMode as logical no-undo init ?.
      171   define variable mFramBachModHandle as handle no-undo.
      172   mFramBachModHandle = frame waitfram:handle.
      173   define variable mFameOldVis as logical no-undo.
      174   define variable mVisCUrentVin as logical no-undo.
      175   if session:batch-mode
      176   then
      177      mBatchMode = yes.
      178   if mBatchMode = ? then do:
      179     mVisCUrentVin = current-window:visible.
      180     mFameOldVis = mFramBachModHandle:visible.
      181     mFramBachModHandle:visible  = yes.
      182     mBatchMode = mFramBachModHandle:visible ne yes.
      183     mFramBachModHandle:visible = mFameOldVis.
      184     current-window:visible = mVisCUrentVin.
      185   end.
      186    if  log-manager:logfile-name ne ?
      187     then DO:
      188         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      189         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      190         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      191     end.
      192   on choose of B-WaitFramStop in frame waitfram
      193   do:
      194     mWaitFramStop = yes.
      195     mWaitFramStopUser = yes.
      196   end.
      197   function waitfram-check-timeout returns logical():
      198      define variable vtime as int64 no-undo.
      199      if mWaitFramStopTimeOut
      200      then
      201         return yes.
      202      vtime = ( now - mWaitFramStartProc ) / 1000 .
      203      if     mWaitFramTimeOut ne ?
      204         and mWaitFramTimeOut ne 0
      205         and mWaitFramTimeOut lt vtime
      206      then do:
      207         mWaitFramStopTimeOut = yes.
      208      end.
      209      return mWaitFramStopTimeOut.
      210   end.
      211   procedure waitfram-hide :
      212     if not session:batch-mode
      213     then do
      214     on error undo, return error return-value
      215     :
      216       pause 0 before-hide .
      217       if not mBatchMode then
      218         hide frame waitfram .
      219     if     not mWaitFramView
      220        and mWaitProcEvent
      221     then
      222       process events .
      223     end.
      224   end procedure.
      225   procedure waitfram-show :
      226     define input  parameter p-message as character no-undo .
      227     define variable v-left-margin as integer   no-undo .
      228     if not session:batch-mode
      229     then do
      230     on error undo, return error return-value
      231     :
      232       if length(p-message) <= 70 then do:
      233         assign
      234           v-left-margin = integer((70 - length(p-message)) / 2)
      235         .
      236         assign
      237           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      238         .
      239         assign
      240           v-waitfram-action01 = " "
      241           v-waitfram-action02 = " "
      242                                    + fill(" ", v-left-margin)
      243                                    + p-message
      244           v-waitfram-action03 = " "
      245         .
      246       end.
      247       else do:
      248         define variable vRindex1 as integer no-undo.
      249         define variable vRindex2 as integer no-undo.
      250         vRindex1 = r-index(p-message," ",70).
      251         if vRindex1 = 0
      252         then
      253            vRindex1 = 70.
      254         if length(p-message)  <= vRindex1 + 70 then do:
      255           assign
      256             v-waitfram-action01 = " "
      257             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      258             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      259           .
      260         end.
      261         else do:
      262           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      263           if vRindex2 <= vRindex1
      264           then
      265              vRindex2 = vRindex1 + 70.
      266           assign
      267             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      268             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      269             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      270           .
      271         end.
      272       end.
      273       B-viewProcInfo:visible   in frame waitfram = no.
      274       B-viewProcInfo:sensitive in frame waitfram = no.
      275       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      276       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      277       if  (   mWaitFramView
      278          or  mWaitProcEvent)
      279          and not mBatchMode
      280       then
      281          display
      282             v-waitfram-action01 skip
      283             v-waitfram-action02 skip
      284             v-waitfram-action03 skip
      285          with frame waitfram .
      286       if     mWaitFramView
      287          then do:
      288             if     mWaitFramInterval ne ?
      289                and not mBatchMode
      290             then
      291                wait-for go of frame waitfram pause mWaitFramInterval.
      292          end.
      293          else
      294             if     mWaitProcEvent
      295                and not mBatchMode
      296             then
      297                process events .
      298     end.
      299   end procedure.
      300      procedure waitfram-show-this:
      301         define input  parameter iInterval as int64 no-undo.
      302         define variable vtime as int64 no-undo.
      303         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      304         mWaitFramInterval = iInterval.
      305         run waitfram-show (substitute("&1&2 &3&4" ,
      306                                       mWaitFramTextBeg ,
      307                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      308                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      309                                       mWaitFramTextEnd
      310                                      )
      311                           ).
      312      end.
      313      procedure WaitFramRunPause:
      314         define input  parameter iInterval as dec no-undo.
      315         define variable vStart  as datetime-tz no-undo.
      316         define variable vend    as datetime-tz no-undo.
      317         define variable vint as int64 no-undo.
      318         define variable vOk as logical no-undo.
      319         vStart = now.
      320         vend   = vStart.
      321         publish "WaitFramPause" (iInterval,output vOk).
      322         vend   =  now.
      323         vint = vend - vStart.
      324         vint = iInterval - vint / 1000.
      325         if     not mWaitFramStop
      326            and (   vint > 0
      327                 or (    not vOk
      328                     and iInterval eq ?
      329                     )
      330                 )
      331         then
      332            run waitfram-show-this (iInterval).
      333         vend   =  now.
      334         vint = vend - vStart.
      335         vint = iInterval - vint / 1000.
      336         if     not mWaitFramStop
      337            and vint > 0
      338         then do:
      339            run gbl/pause.p (vint * 1000).
      340         end.
      341         if iInterval ne ?
      342         then
      343            publish "WaitFramStop".
      344         waitfram-check-timeout().
      345      end.
      346      procedure WaitFramWaitFor:
      347         define input  parameter iInterval as dec no-undo.
      348         assign
      349            mWaitFramStartProc   = now
      350            mWaitFramStopUser    = no
      351            mWaitFramStopTimeOut = no
      352         .
      353         block-wait:
      354         do while not mWaitFramStop:
      355            run WaitFramRunPause (iInterval).
      356            if  waitfram-check-timeout()
      357            then do:
      358               leave block-wait.
      359            end.
      360         end.
      361         run waitfram-hide.
      362      end.
      363   procedure waitfram-join :
      364     define input  parameter p-line-1  as character no-undo .
      365     define input  parameter p-line-2  as character no-undo .
      366     define input  parameter p-line-3  as character no-undo .
      367     define output parameter p-message as character no-undo .
      368     do
      369     on error undo, return error return-value
      370     :
      371       assign
      372         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      373                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      374                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      375       .
      376     end.
      377   end procedure.
      378   function waitfram-join-function returns character
      379     (input p-line-1 as character
      380     ,input p-line-2 as character
      381     ,input p-line-3 as character
      382     ).
      383     define variable v-message as character no-undo .
      384     run waitfram-join in this-procedure
      385       (input  p-line-1
      386       ,input  p-line-2
      387       ,input  p-line-3
      388       ,output v-message
      389       ) .
      390     return v-message .
      391   end function .
