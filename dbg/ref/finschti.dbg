      821   else do:
      822     apply "entry":u to self  .
      823     if focus :handle <> self :handle  then do:
      824       return no-apply .
      825     end.
      826   end.
      827     if input frame Dialog-Frame tt-fin-schet.code-bank <> ?
      828     AND input frame Dialog-Frame tt-fin-schet.code-bank <> 0
      829     then do:
      830       find first X_fin-bank no-lock where
      831                             X_fin-bank.host-code = p-host-code
      832                     AND X_fin-bank.code-bank = input frame Dialog-Frame tt-fin-schet.code-bank no-error.
      833         if not available X_fin-bank then do:
      834             display
      835             0 @ tt-fin-schet.code-bank
      836             ? @ f-bank-name
      837             "":U @ tt-fin-schet.c-schet
      838             with frame Dialog-Frame .
      839             APPLY "CHOOSE" to b-bank.
      840             return no-apply.
      841         end.
      842         assign
      843         tt-fin-schet.code-bank = X_fin-bank.code-bank
      844         tt-fin-schet.c-schet = X_fin-bank.cor-acc
      845         f-bank-name =   X_fin-bank.bank-name
      846   .
      847         display
      848         tt-fin-schet.code-bank
      849         tt-fin-schet.c-schet
      850         f-bank-name
      851         with frame Dialog-Frame.
      852     end.
      853   END.
      854   ON LEAVE OF tt-fin-schet.curr-code IN FRAME Dialog-Frame
      855   DO:
      856     if input frame Dialog-Frame tt-fin-schet.curr-code <> ? then do:
      857       find first X_currency no-lock where
      858                       X_currency.curr-code = input frame Dialog-Frame tt-fin-schet.curr-code no-error.
      859         if not available X_currency then do:
      860             display
      861             ? @ tt-fin-schet.curr-code
      862             chr(63) @ f-curr-abbr
      863             with frame Dialog-Frame.
      864             APPLY "ENTRY" to tt-fin-schet.curr-code.
      865             return no-apply.
      866         end.
      867         assign
      868             tt-fin-schet.curr-code = X_currency.curr-code
      869             .
      870         display
      871           X_currency.curr-abbr @ f-curr-abbr
      872           tt-fin-schet.curr-code
      873           with frame Dialog-Frame.
      874      end.
      875   END.
      876   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      877   on help of frame Dialog-Frame
      878   do:
      879     run gbl/app_help.p
      880       (input this-procedure :file-name
      881       ,input ''
      882       ,input ?
      883       ) no-error.
      884     if error-status :error then do:
      885       message
      886         "Ошибка при вызове помощи"
      887         error-status :get-message(1)
      888         view-as alert-box .
      889     end.
      890   end.
      891   run minbtn-set in this-procedure .
      892   on choose of b-help in frame Dialog-Frame
      893   do:
      894     apply "help":u to frame Dialog-Frame .
      895   end.
      896   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      897   procedure minbtn-set :
      898       do
      899           on error undo, return error return-value
      900           :
      901           define variable ii              as integer       no-undo .
      902           define variable fh              as widget-handle no-undo .
      903           define variable hh              as widget-handle no-undo .
      904           define variable v-h             as handle        extent 4 no-undo .
      905           define variable v-name-button   as character     no-undo .
      906           define variable v-help-old-x    as decimal       no-undo .
      907           define variable v-help-old-y    as decimal       no-undo .
      908           define variable v-help-old-size as decimal       no-undo .
      909           define variable v-frame-width   as decimal       no-undo .
      910           define variable jj              as integer       no-undo .
      911           do
      912               on error undo, return error
      913               :
      914               assign
      915                   v-frame-width = frame Dialog-Frame:width - 0.3
      916                   fh            = frame Dialog-Frame:first-child
      917                   hh            = fh:first-child
      918                   ii            = 1
      919                   .
      920               do while valid-handle(hh):
      921                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      922                   do:
      923                       case lc(hh:name) :
      924                           when "b-help" then
      925                               do:
      926                                   hh:load-image-up("cmp/b-help.bmp":u) .
      927                                   hh:load-image-down("cmp/b-help.bmp":u) .
      928                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      929                                   hh:TOOLTIP = "Помощь" .
      930                                   v-help-old-x = hh:column .
      931                                   v-help-old-y = hh:row    .
      932                                   v-help-old-size = hh:width .
      933                                   hh:width-chars = 2.5 .
      934                               end.
      935                           when "b-print" then
      936                               do:
      937                                   hh:load-image("cmp/b-print.bmp":u) .
      938                                   hh:TOOLTIP = "Печать" .
      939                                   v-h[ii] = hh:handle .
      940                                   ii = ii + 1 .
      941                                   hh:width-chars = 3 .
      942                               end.
      943                           when "b-history" or
      944                           when "b-hist" then
      945                               do:
      946                                   hh:load-image("cmp/b-hist.bmp":u) .
      947                                   hh:TOOLTIP = "История" .
      948                                   v-h[ii] = hh:handle .
      949                                   ii = ii + 1 .
      950                                   hh:width-chars = 3 .
      951                               end.
      952                           when "b-sch" then
      953                               do:
      954                                   hh:load-image("cmp/b-sch.bmp":u) .
      955                                   hh:TOOLTIP = "Установка Фильтра" .
      956                                   v-h[ii] = hh:handle .
      957                                   ii = ii + 1 .
      958                                   hh:width-chars = 3 .
      959                               end.
      960                           when "b-hist-user" then
      961                               do:
      962                                   hh:load-image("cmp/b-hist.bmp":u) .
      963                                   hh:TOOLTIP = "История пользователя" .
      964                                   ii = ii + 1 .
      965                               end.
      966                       end case.
      967                   end.
      968                   hh = hh:next-sibling.
      969               end.
      970               b-help:column = v-frame-width - b-help:width-chars.
      971               jj = 0.
      972               repeat ii = 4 to 1 by -1 :
      973                   if valid-handle (v-h[ii] ) then
      974                   do:
      975                       jj  = jj + 1 .
      976                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      977                       v-h[ii]:row    = v-help-old-y .
      978                   end.
      979               end.
      980           end.
      981       end.
      982   end procedure.
      983   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      984   ON TAB ANYWHERE
      985   DO:
      986   define variable ii as integer no-undo .
      987   define variable fh as widget-handle no-undo .
      988   define variable hh as widget-handle no-undo .
      989   define variable v-next-widget-name as character no-undo .
      990   if v-tab-order <> '' then do:
      991     if self:type = "TOGGLE-BOX" then
      992     self:BGCOLOR = ?.
      993     assign
      994     ii = lookup(self:name, v-tab-order).
      995     assign
      996     ii = ii + 1
      997     v-next-widget-name = entry(ii, v-tab-order)
      998     no-error .
      999     if error-status:error then do:
     1000       assign
     1001       ii = 1
     1002       v-next-widget-name = entry( ii, v-tab-order)
     1003       .
     1004     end.
     1005     assign
     1006     fh = frame Dialog-Frame:first-child
     1007     hh = fh:first-child
     1008     .
     1009     do while valid-handle(hh):
     1010       if hh:name = v-next-widget-name then do:
     1011         if hh:sensitive  = yes
     1012         AND hh:visible = yes then do:
     1013           APPLY "ENTRY" to hh.
     1014           return no-apply.
     1015         end.
     1016         else do:
     1017           APPLY "TAB" to hh.
     1018           return no-apply.
     1019         end.
     1020       end.
     1021       hh = hh:next-sibling.
     1022     end.
     1023   end.
     1024   END.
     1025   ON BACK-TAB ANYWHERE
     1026   DO:
     1027   define variable ii as integer no-undo .
     1028   define variable fh as widget-handle no-undo .
     1029   define variable hh as widget-handle no-undo .
     1030   define variable v-next-widget-name as character no-undo .
     1031   if v-tab-order <> '' then do:
     1032     assign
     1033     ii = lookup(self:name, v-tab-order).
     1034     .
     1035     assign
     1036     ii = (if ii = 1
     1037           then  num-entries(v-tab-order)
     1038           else ii - 1
     1039           )
     1040     v-next-widget-name = entry(ii, v-tab-order)
     1041     .
     1042     assign
     1043     fh = frame Dialog-Frame:first-child
     1044     hh = fh:first-child
     1045     .
     1046     do while valid-handle(hh):
     1047       if hh:name = v-next-widget-name then do:
     1048         if hh:sensitive  = yes
     1049         AND hh:visible = yes then do:
     1050           APPLY "ENTRY" to hh.
     1051           return no-apply.
     1052         end.
     1053         else do:
     1054         APPLY "BACK-TAB" to hh.
     1055         return no-apply.
     1056         end.
     1057       end.
     1058       hh = hh:next-sibling.
     1059     end.
     1060     end.
     1061   END.
     1062   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1063   ON RETURN ANYWHERE
     1064   DO:
     1065   define variable ii as integer no-undo .
     1066   define variable fh as widget-handle no-undo .
     1067   define variable hh as widget-handle no-undo .
     1068   define variable v-next-widget-name as character no-undo .
     1069     if v-tab-order <> '' then do:
     1070       assign
     1071       ii = lookup(self:name, v-tab-order).
     1072       if ii = num-entries(v-tab-order) then do:
     1073           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     1074           return no-apply.
     1075       end.
     1076       if self:type <> "BUTTON" and
     1077         self:type <> "EDITOR"  then do:
     1078         run proc-move-forward in this-procedure .
     1079         return no-apply.
     1080       end.
     1081       if self:type = "BUTTON" then do:
     1082         APPLY "CHOOSE" to self.
     1083       end.
     1084       if self:type = "TOGGLE-BOX" then
     1085       self:BGCOLOR = ?.
     1086       assign
     1087       ii = ii + 1
     1088       v-next-widget-name = entry(ii, v-tab-order)
     1089       no-error .
     1090       if error-status:error then do:
     1091         assign
     1092         ii = 1
     1093         v-next-widget-name = entry( ii, v-tab-order)
     1094         .
     1095       end.
     1096       assign
     1097       fh = frame Dialog-Frame:first-child
     1098       hh = fh:first-child
     1099       .
     1100       do while valid-handle(hh):
     1101         if hh:name = v-next-widget-name then do:
     1102           if hh:sensitive  = yes
     1103           AND hh:visible = yes then do:
     1104             if hh:type = "TOGGLE-BOX":U then do:
     1105               assign
     1106               hh:BGcolor = 1
     1107               .
     1108             end.
     1109             APPLY "ENTRY" to hh.
     1110             return no-apply.
     1111           end.
     1112           else do:
     1113             APPLY "TAB" to hh.
     1114             return no-apply.
     1115           end.
     1116         end.
     1117         hh = hh:next-sibling.
     1118       end.
     1119     end.
     1120   END.
     1121   procedure proc-move-forward :
     1122   define variable ii as integer no-undo .
     1123   define variable fh as widget-handle no-undo .
     1124   define variable hh as widget-handle no-undo .
     1125   define variable v-next-widget-name as character no-undo .
     1126   do
     1127   on error undo, return error
     1128   :
     1129     if v-tab-order <> '' then do:
     1130       if self:type = "TOGGLE-BOX" then
     1131       self:BGCOLOR = ?.
     1132       assign
     1133       ii = lookup(self:name, v-tab-order).
     1134       assign
     1135       ii = ii + 1
     1136       v-next-widget-name = entry(ii, v-tab-order)
     1137       no-error .
     1138       if error-status:error then do:
     1139         assign
     1140         ii = 1
     1141         v-next-widget-name = entry( ii, v-tab-order)
     1142         .
     1143       end.
     1144       assign
     1145       fh = frame Dialog-Frame:first-child
     1146       hh = fh:first-child
     1147       .
     1148       do while valid-handle(hh):
     1149         if hh:name = v-next-widget-name then do:
     1150           if hh:sensitive  = yes
     1151           AND hh:visible = yes then do:
     1152             if hh:type = "TOGGLE-BOX":U then do:
     1153               assign
     1154               hh:BGcolor = 1
     1155               .
     1156             end.
     1157             APPLY "ENTRY" to hh.
     1158             return.
     1159           end.
     1160           else do:
     1161             assign
     1162             ii = ii + 1
     1163             v-next-widget-name = entry(ii, v-tab-order)
     1164             no-error .
     1165             if error-status:error then do:
     1166               assign
     1167               ii = 1
     1168               v-next-widget-name = entry( ii, v-tab-order)
     1169               .
     1170             end.
     1171           end.
     1172         end.
     1173         hh = hh:next-sibling.
     1174       end.
     1175     end.
     1176   end.
     1177   end procedure.
     1178   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1179   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1180   MAIN-BLOCK:
     1181   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1182      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1183    if p-mode  <> 'ДОБАВЛЕНИЕ':U
     1184    and p-mode <> 'ИЗМЕНЕНИЕ':U
     1185    and p-mode <> 'ПРОСМОТР':U
     1186    then do:
     1187       message
     1188       vss-workfile vss-revision vss-description skip
     1189       "Неверное значение параметров вызова p-mode"  p-mode
     1190       view-as alert-box ERROR.
     1191       undo, return error.
     1192    end.
     1193   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1194   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1195     (output v-db-num
     1196     )  .
     1197   find first X_sysconf no-lock where
     1198                   X_sysconf.host-code = p-host-code.
     1199   find first X_curr_sysconf no-lock where
     1200                   X_curr_sysconf.host-code = p-curr-host-code.
     1201    if p-mode <> 'ПРОСМОТР':U then do:
     1202       if X_curr_sysconf.host-code <> p-host-code
     1203       or v-db-num <> X_sysconf.firm-db-num
     1204       then do:
     1205         message
     1206         vss-workfile vss-revision vss-description skip
     1207         "Неверное значение параметров вызова p-mode и/или p-host-code и/или p-curr-host-code" p-mode p-host-code  p-curr-host-code
     1208         view-as alert-box ERROR.
     1209         undo, return error.
     1210       end.
     1211     end.
     1212     for each tt-fin-schet:
     1213           delete tt-fin-schet.
     1214       end.
     1215     if p-mode = 'ИЗМЕНЕНИЕ':U
     1216     or p-mode = 'ПРОСМОТР':U then do:
     1217       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1218         find first locked_fin-schet EXclusive-lock where
     1219                      recid(locked_fin-schet) = p-doc-rec no-wait no-error.
     1220         if locked locked_fin-schet then do:
     1221           message
     1222           vss-workfile vss-revision vss-description skip
     1223            "Запись БАНКОВСКОГО СЧЕТА занята"
     1224           view-as alert-box error .
     1225           undo, return error.
     1226         end.
     1227       end.
     1228       else do:
     1229         find first locked_fin-schet no-lock where
     1230                          recid(locked_fin-schet) = p-doc-rec no-error .
     1231         if not avail locked_fin-schet then do:
     1232           find first locked_fin-schet no-lock where
     1233                      locked_fin-schet.host-code = p-host-code
     1234                  AND locked_fin-schet.code-schet = p-code-schet no-error .
     1235         end.
     1236       end.
     1237       if not available locked_fin-schet then do:
     1238         message
     1239         vss-workfile vss-revision vss-description skip
     1240         "Не найдена запись БАНК"
     1241         view-as alert-box error .
     1242         undo, return error.
     1243       end.
     1244       create tt-fin-schet.
     1245       buffer-copy locked_fin-schet to tt-fin-schet.
     1246      end.
     1247      else do:
     1248             create tt-fin-schet.
     1249             assign
     1250             tt-fin-schet.host-code = p-host-code
     1251             tt-fin-schet.cli-type = 'орг':U
     1252             tt-fin-schet.code-bank = p-code-bank
     1253             tt-fin-schet.cli-type = (if p-cli-type <> "":U
     1254                                      then p-cli-type
     1255                                      else 'орг':U)
     1256             tt-fin-schet.cli-code = (if p-cli-code <> 0
     1257                                      then p-cli-code
     1258                                      else 0)
     1259             tt-fin-schet.curr-code = (if p-curr-code <> ?
     1260                                       then p-curr-code
     1261                                       else 0)
     1262             .
     1263      end.
     1264     RUN MYEnable no-error .
     1265     if error-status:error then do:
     1266       undo, return error.
     1267     end.
     1268     WAIT-FOR GO OF FRAME Dialog-Frame.
     1269   END.
     1270   RUN disable_UI.
     1271   PROCEDURE check-cli :
     1272   define buffer buf_clients for ub.clients.
     1273     find first X_schet-clients no-lock where
     1274               X_schet-clients.obj-type = tt-fin-schet.cli-type
     1275           AND X_schet-clients.obj-code = input frame Dialog-Frame tt-fin-schet.cli-code no-error.
     1276       if not available X_schet-clients then do:
     1277           display
     1278           ? @ tt-fin-schet.cli-code
     1279           chr(63) @ f-cli-name
     1280           with frame Dialog-Frame.
     1281           apply "entry" to tt-fin-schet.cli-code in frame Dialog-Frame.
     1282           return error.
     1283       end.
     1284       assign
     1285       tt-fin-schet.cli-code = X_schet-clients.obj-code
     1286       .
     1287       display
     1288       X_schet-clients.obj-name @ f-cli-name
     1289       tt-fin-schet.cli-code
     1290       with frame Dialog-Frame.
     1291   END PROCEDURE.
     1292   PROCEDURE disable_UI :
     1293     HIDE FRAME Dialog-Frame.
     1294   END PROCEDURE.
     1295   PROCEDURE enable_UI :
     1296     DISPLAY f-host-name f-cli-name f-bank-name f-bik f-curr-abbr
     1297         WITH FRAME Dialog-Frame.
     1298     IF AVAILABLE tt-fin-schet THEN
     1299       DISPLAY tt-fin-schet.host-code tt-fin-schet.code-schet tt-fin-schet.cli-code
     1300             tt-fin-schet.cli-type tt-fin-schet.code-bank tt-fin-schet.c-schet
     1301             tt-fin-schet.curr-code tt-fin-schet.r-schet tt-fin-schet.dop1
     1302             tt-fin-schet.dop2 tt-fin-schet.PS
     1303         WITH FRAME Dialog-Frame.
     1304     ENABLE B-exit b-quit B-print B-hist B-Help f-cli-name tt-fin-schet.cli-code
     1305            B-cli tt-fin-schet.cli-type tt-fin-schet.code-bank B-bank
     1306            tt-fin-schet.curr-code B-currency f-curr-abbr tt-fin-schet.r-schet
     1307            tt-fin-schet.dop1 tt-fin-schet.dop2 tt-fin-schet.PS
     1308         WITH FRAME Dialog-Frame.
     1309     VIEW FRAME Dialog-Frame.
     1310   END PROCEDURE.
     1311   PROCEDURE MyEnable :
     1312   assign
     1313   tt-fin-schet.cli-type:radio-buttons in frame Dialog-Frame = "Орг" + chr(44) + 'орг':U + chr(44) +
     1314                                         "Чел" + chr(44) + 'чел':U
     1315   v-tab-order = "B-exit,b-quit,b-print,b-hist,b-help,cli-type,cli-code,b-cli," +                    "code-bank,B-bank,r-schet,curr-code,B-currency,PS"
     1316   .
     1317   find first X_clients-host no-lock where
     1318               X_clients-host.obj-type = 'орг':U
     1319           AND X_clients-host.obj-code = p-host-code.
     1320   if p-mode <> 'ДОБАВЛЕНИЕ':U
     1321   or not (p-cli-type = "":U and p-cli-code = 0)
     1322   then do:
     1323     find first X_schet-clients no-lock where
     1324                 X_schet-clients.obj-type = tt-fin-schet.cli-type
     1325             AND X_schet-clients.obj-code = tt-fin-schet.cli-code no-error .
     1326     if not available X_schet-clients then do:
     1327       message
     1328       vss-workfile vss-revision vss-description skip
     1329       "Не найден клиент для счета" p-cli-type p-cli-code
     1330       view-as alert-box .
     1331       return error .
     1332     end.
     1333   end.
     1334   if p-mode <> 'ДОБАВЛЕНИЕ':U
     1335   or not (p-code-bank = 0)
     1336   then do:
     1337     find first X_fin-bank no-lock where
     1338                 X_fin-bank.host-code = tt-fin-schet.host-code
     1339             AND X_fin-bank.code-bank = tt-fin-schet.code-bank no-error .
     1340     if not available X_fin-bank then do:
     1341       message
     1342       vss-workfile vss-revision vss-description skip
     1343       "Не найден банк для счета" p-code-bank "фирма" p-host-code
     1344       view-as alert-box .
     1345       return error .
     1346     end.
     1347   end.
     1348   if p-mode <> 'ДОБАВЛЕНИЕ':U
     1349   or not (p-curr-code = ?)
     1350   then do:
     1351     find first X_currency no-lock where
     1352                 X_currency.curr-code = tt-fin-schet.curr-code no-error .
     1353     if not available X_currency then do:
     1354       message
     1355       vss-workfile vss-revision vss-description skip
     1356       "Не найдена валюта" p-curr-code p-curr-code
     1357       view-as alert-box .
     1358       return error .
     1359     end.
     1360   end.
     1361     DISPLAY
     1362     X_clients-host.obj-name @  f-host-name
     1363      WITH FRAME Dialog-Frame.
     1364   case p-mode:
     1365     when 'ДОБАВЛЕНИЕ':U then do:
     1366       DISPLAY
     1367       p-host-code @ tt-fin-schet.host-code
     1368       ? @ tt-fin-schet.code-schet
     1369       tt-fin-schet.code-bank
     1370       tt-fin-schet.cli-type
     1371       tt-fin-schet.cli-code
     1372       tt-fin-schet.curr-code
     1373       tt-fin-schet.dop1
     1374       tt-fin-schet.dop2
     1375       (if avail X_schet-clients
     1376       then X_schet-clients.obj-name
     1377       else "":U)  @ f-cli-name
     1378       (if available X_fin-bank
     1379       then X_fin-bank.bank-name
     1380       else "":U)  @ f-bank-name
     1381       (if available X_fin-bank
     1382       then X_fin-bank.bik
     1383       else "":U) @ f-bik
     1384       (if available X_currency
     1385       then X_currency.curr-abbr
     1386       else "":U) @ f-curr-abbr
     1387       WITH FRAME Dialog-Frame.
     1388     end.
     1389     otherwise do:
     1390       DISPLAY
     1391       tt-fin-schet.host-code
     1392       tt-fin-schet.code-schet
     1393       tt-fin-schet.code-bank
     1394       tt-fin-schet.cli-type
     1395       tt-fin-schet.cli-code
     1396       tt-fin-schet.dop1
     1397       tt-fin-schet.dop2
     1398       X_schet-clients.obj-name @ f-cli-name
     1399       X_fin-bank.bank-name @ f-bank-name
     1400       X_fin-bank.bik @ f-bik
     1401       X_currency.curr-abbr @ f-curr-abbr
     1402       tt-fin-schet.curr-code
     1403       tt-fin-schet.c-schet
     1404       tt-fin-schet.r-schet
     1405       tt-fin-schet.PS
     1406       WITH FRAME Dialog-Frame.
     1407     end.
     1408   END CASE.
     1409   if p-mode = 'ПРОСМОТР':U then do:
     1410   assign
     1411   b-quit:label = "&Выход"
     1412   .
     1413   hide
     1414   b-exit in frame Dialog-Frame.
     1415   end.
     1416   ENABLE
     1417   b-quit
     1418   B-exit when p-mode <> 'ПРОСМОТР':U
     1419   b-print when p-mode <> 'ДОБАВЛЕНИЕ':U
     1420   b-hist when p-mode <> 'ДОБАВЛЕНИЕ':U
     1421   b-cli when p-mode = 'ДОБАВЛЕНИЕ':U and (p-cli-type = "":U and p-cli-code = 0)
     1422   b-currency when (p-mode = 'ИЗМЕНЕНИЕ':U
     1423                   or
     1424                    (p-mode = 'ДОБАВЛЕНИЕ':U and p-curr-code = 0)
     1425                    )
     1426   b-bank when (p-mode = 'ИЗМЕНЕНИЕ':U
     1427                or
     1428               (p-mode = 'ДОБАВЛЕНИЕ':U and p-code-bank = 0)
     1429               )
     1430   B-Help
     1431   tt-fin-schet.cli-code when p-mode = 'ДОБАВЛЕНИЕ':U and (p-cli-type = "":U and p-cli-code = 0)
     1432   tt-fin-schet.cli-type when p-mode = 'ДОБАВЛЕНИЕ':U and (p-cli-type = "":U and p-cli-code = 0)
     1433   tt-fin-schet.curr-code when (p-mode = 'ИЗМЕНЕНИЕ':U
     1434                               or
     1435                               (p-mode = 'ДОБАВЛЕНИЕ':U and p-curr-code = 0)
     1436                               )
     1437   tt-fin-schet.r-schet when p-mode <> 'ПРОСМОТР':U
     1438   tt-fin-schet.PS when p-mode <> 'ПРОСМОТР':U
     1439   tt-fin-schet.code-bank when p-mode <> 'ПРОСМОТР':U
     1440   tt-fin-schet.dop1  when p-mode <> 'ПРОСМОТР':U
     1441   tt-fin-schet.dop2  when p-mode <> 'ПРОСМОТР':U
     1442   WITH FRAME Dialog-Frame.
     1443   VIEW FRAME Dialog-Frame.
     1444   END PROCEDURE.
     1445   PROCEDURE proc-save :
     1446   define input parameter p-save as logical no-undo .
     1447   if p-mode = 'ПРОСМОТР':U then do:
     1448       return error.
     1449   end.
     1450   if not available tt-fin-schet then do:
     1451       create tt-fin-schet.
     1452   end.
     1453   if not available X_schet-clients then do:
     1454       message
     1455       "Вы не выбрали держателя счета"
     1456       view-as alert-box error.
     1457       return error.
     1458   end.
     1459   if not available X_fin-bank then do:
     1460       message
     1461       "Вы не выбрали банк"
     1462       view-as alert-box error.
     1463       return error.
     1464   end.
     1465   if not available X_currency then do:
     1466       message
     1467       "Вы не выбрали валюту счета"
     1468       view-as alert-box error.
     1469       return error.
     1470   end.
     1471   assign
     1472   tt-fin-schet.c-schet frame Dialog-Frame
     1473   tt-fin-schet.cli-type
     1474   tt-fin-schet.cli-code
     1475   tt-fin-schet.code-bank
     1476   tt-fin-schet.curr-code
     1477   tt-fin-schet.dop1
     1478   tt-fin-schet.dop2
     1479   tt-fin-schet.r-schet
     1480   tt-fin-schet.PS
     1481   .
     1482   if not p-save then return.
     1483    run ref/finscht1.p (
     1484   input-output p-doc-rec
     1485   ,input p-mode
     1486   ,input no
     1487   ,input "r-schet"
     1488   ,input p-host-code
     1489   ,input p-code-schet
     1490   ,input tt-fin-schet.c-schet
     1491   ,input tt-fin-schet.cli-type
     1492   ,input tt-fin-schet.cli-code
     1493   ,input tt-fin-schet.code-bank
     1494   ,input tt-fin-schet.curr-code
     1495   ,INPUT tt-fin-schet.dop1
     1496   ,INPUT tt-fin-schet.dop2
     1497   ,input tt-fin-schet.r-schet
     1498   ,input tt-fin-schet.PS
     1499   )
     1500   no-error.
     1501   if error-status:error then do:
     1502   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1503   define variable fh as widget-handle no-undo .
     1504   define variable hh as widget-handle no-undo .
     1505   define variable rv as character no-undo .
     1506   assign
     1507   rv = entry(1, return-value , chr(4)).
     1508   if rv <> "":U then do:
     1509     assign
     1510     fh = frame Dialog-Frame:first-child
     1511     hh = fh:first-child
     1512     .
     1513     do while valid-handle(hh):
     1514       if hh:name = rv then do:
     1515         APPLY "ENTRY" to hh.
     1516         undo ,
     1517         return error.
     1518       end.
     1519       hh = hh:next-sibling.
     1520     end.
     1521   end.
     1522     undo, return error.
     1523   end.
     1524   END PROCEDURE.
