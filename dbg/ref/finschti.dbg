       15   define input parameter p-cli-type like ub.fin-schet.cli-type no-undo .
       16   define input parameter p-cli-code like ub.fin-schet.cli-code no-undo .
       17   define input parameter p-curr-code like ub.fin-schet.curr-code no-undo .
