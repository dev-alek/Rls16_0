        1   define input-output  parameter p-d-pcnt as decimal no-undo.
        2   define input-output  parameter p-d-cash-pcnt as decimal no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Ввод процентов скидки по умолчанию для типов ДК".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   procedure proc-alt-shift-f2:
       64     if not ibs.th.gbl.gbl-var:rcode
       65   then
       66     run gbl\inidebug.p .
       67   end.
       68   procedure proc-alt-shift-f3:
       69     run gbl/prvssinf.p
       70       ( input this-procedure
       71       ) .
       72   end.
       73   define variable v-inform-launched as logical no-undo initial false .
       74   procedure proc-alt-shift-f4:
       75     define variable v-action as character no-undo .
       76     if v-inform-launched = false then do:
       77       assign
       78         v-inform-launched = true
       79       .
       80       run gbl/d-inform.w
       81         (  input self
       82         ,  input this-procedure
       83         , output v-action
       84         ) no-error .
       85       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       86       assign
       87         v-inform-launched = false
       88       .
       89     end.
       90   end.
       91   procedure proc-alt-f1:
       92     run gbl/corrhelp.p
       93       (input this-procedure
       94       ) .
       95   end .
       96   on alt-shift-f2 anywhere do:
       97     run proc-alt-shift-f2.
       98   end.
       99   on alt-shift-f3 anywhere do:
      100     run proc-alt-shift-f3 in this-procedure .
      101   end.
      102   on alt-shift-f4 anywhere do:
      103     run proc-alt-shift-f4 in this-procedure.
      104   end.
      105   on alt-f1 anywhere do:
      106     run proc-alt-f1 in this-procedure .
      107   end.
      108   DEFINE BUTTON B-exit AUTO-GO
      109        LABEL "&Ввод"
      110        SIZE 10 BY 1
      111        BGCOLOR 8 .
      112   DEFINE BUTTON B-Help
      113        LABEL "Помо&щь"
      114        SIZE 10 BY 1
      115        BGCOLOR 8 .
      116   DEFINE BUTTON b-quit AUTO-END-KEY
      117        LABEL "&Отмена"
      118        SIZE 10 BY 1
      119        BGCOLOR 8 .
      120   DEFINE VARIABLE d-cash-pcnt AS DECIMAL FORMAT "->9.99%":U INITIAL 0
      121        VIEW-AS FILL-IN
      122        SIZE 8 BY 1
      123        FGCOLOR 4  NO-UNDO.
      124   DEFINE VARIABLE d-pcnt AS DECIMAL FORMAT "->9.99%":U INITIAL 0
      125        VIEW-AS FILL-IN
      126        SIZE 8 BY 1
      127        FGCOLOR 4  NO-UNDO.
      128   DEFINE VARIABLE n-d-cash-pcnt AS CHARACTER FORMAT "X(256)":U INITIAL "Процент скидки:"
      129         VIEW-AS TEXT
      130        SIZE 14.25 BY 1
      131        FGCOLOR 15  NO-UNDO.
      132   DEFINE VARIABLE n-d-pcnt AS CHARACTER FORMAT "X(256)":U INITIAL "Процент скидки:"
      133         VIEW-AS TEXT
      134        SIZE 14.25 BY 1
      135        FGCOLOR 15  NO-UNDO.
      136   DEFINE IMAGE l-d-cash-pcnt
      137        FILENAME "adeicon\lock":U
      138        SIZE 2.88 BY .92.
      139   DEFINE IMAGE l-d-pcnt
      140        FILENAME "adeicon\lock":U
      141        SIZE 2.88 BY .92.
      142   DEFINE FRAME Dialog-Frame
      143        B-exit AT ROW 1 COL 1
      144        b-quit AT ROW 1 COL 11
      145        B-Help AT ROW 1 COL 25.5
      146        d-pcnt AT ROW 2.54 COL 20.5 COLON-ALIGNED NO-LABEL
      147        d-cash-pcnt AT ROW 4 COL 20.38 COLON-ALIGNED NO-LABEL
      148        n-d-pcnt AT ROW 2.54 COL 6.88 NO-LABEL
      149        n-d-cash-pcnt AT ROW 4.17 COL 6.88 NO-LABEL
      150        l-d-cash-pcnt AT ROW 4.21 COL 3.63
      151        l-d-pcnt AT ROW 2.63 COL 3.63
      152        SPACE(36.98) SKIP(2.90)
      153       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      154            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      155            TITLE "Введите проценты скидок по умолчанию"
      156            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      157   ASSIGN
      158          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      159          FRAME Dialog-Frame:HIDDEN           = TRUE.
      160   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      161   DO:
      162     APPLY "END-ERROR":U TO SELF.
      163   END.
      164   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      165   DO:
      166     assign
      167     d-cash-pcnt
      168     d-pcnt
      169     p-d-pcnt = (if d-pcnt:sensitive then d-pcnt else p-d-pcnt)
      170     p-d-cash-pcnt = (if d-cash-pcnt:sensitive then d-cash-pcnt else p-d-cash-pcnt)
      171     .
      172   END.
      173   ON RIGHT-MOUSE-CLICK OF d-cash-pcnt IN FRAME Dialog-Frame
      174   DO:
      175       assign
      176       n-d-cash-pcnt:fgcolor = 15
      177       l-d-cash-pcnt:visible = true.
      178       display d-cash-pcnt with frame Dialog-Frame.
      179       disable d-cash-pcnt with frame Dialog-Frame.
      180   END.
      181   ON RIGHT-MOUSE-CLICK OF d-pcnt IN FRAME Dialog-Frame
      182   DO:
      183       assign
      184       n-d-pcnt:fgcolor = 15
      185       l-d-pcnt:visible = true.
      186       display d-pcnt with frame Dialog-Frame.
      187       disable d-pcnt with frame Dialog-Frame.
      188   END.
      189   ON MOUSE-SELECT-CLICK OF l-d-cash-pcnt IN FRAME Dialog-Frame
      190   DO:
      191      IF l-d-cash-pcnt:visible then do:
      192       assign
      193       n-d-cash-pcnt:fgcolor = ?
      194       l-d-cash-pcnt:visible = false.
      195       enable d-cash-pcnt with frame Dialog-Frame.
      196       APPLY "ENTRY" TO d-cash-pcnt.
      197     end.
      198   END.
      199   ON MOUSE-SELECT-CLICK OF l-d-pcnt IN FRAME Dialog-Frame
      200   DO:
      201      IF l-d-pcnt:visible then do:
      202       assign
      203       n-d-pcnt:fgcolor = ?
      204       l-d-pcnt:visible = false.
      205       enable d-pcnt with frame Dialog-Frame.
      206       APPLY "ENTRY" TO d-pcnt.
      207     end.
      208   END.
      209   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      210   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      211   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      212   on help of frame Dialog-Frame
      213   do:
      214     run gbl/app_help.p
      215       (input this-procedure :file-name
      216       ,input ''
      217       ,input ?
      218       ) no-error.
      219     if error-status :error then do:
      220       message
      221         "Ошибка при вызове помощи"
      222         error-status :get-message(1)
      223         view-as alert-box .
      224     end.
      225   end.
      226   run minbtn-set in this-procedure .
      227   on choose of b-help in frame Dialog-Frame
      228   do:
      229     apply "help":u to frame Dialog-Frame .
      230   end.
      231   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      232   procedure minbtn-set :
      233       do
      234           on error undo, return error return-value
      235           :
      236           define variable ii              as integer       no-undo .
      237           define variable fh              as widget-handle no-undo .
      238           define variable hh              as widget-handle no-undo .
      239           define variable v-h             as handle        extent 4 no-undo .
      240           define variable v-name-button   as character     no-undo .
      241           define variable v-help-old-x    as decimal       no-undo .
      242           define variable v-help-old-y    as decimal       no-undo .
      243           define variable v-help-old-size as decimal       no-undo .
      244           define variable v-frame-width   as decimal       no-undo .
      245           define variable jj              as integer       no-undo .
      246           do
      247               on error undo, return error
      248               :
      249               assign
      250                   v-frame-width = frame Dialog-Frame:width - 0.3
      251                   fh            = frame Dialog-Frame:first-child
      252                   hh            = fh:first-child
      253                   ii            = 1
      254                   .
      255               do while valid-handle(hh):
      256                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      257                   do:
      258                       case lc(hh:name) :
      259                           when "b-help" then
      260                               do:
      261                                   hh:load-image-up("cmp/b-help.bmp":u) .
      262                                   hh:load-image-down("cmp/b-help.bmp":u) .
      263                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      264                                   hh:TOOLTIP = "Помощь" .
      265                                   v-help-old-x = hh:column .
      266                                   v-help-old-y = hh:row    .
      267                                   v-help-old-size = hh:width .
      268                                   hh:width-chars = 2.5 .
      269                               end.
      270                           when "b-print" then
      271                               do:
      272                                   hh:load-image("cmp/b-print.bmp":u) .
      273                                   hh:TOOLTIP = "Печать" .
      274                                   v-h[ii] = hh:handle .
      275                                   ii = ii + 1 .
      276                                   hh:width-chars = 3 .
      277                               end.
      278                           when "b-history" or
      279                           when "b-hist" then
      280                               do:
      281                                   hh:load-image("cmp/b-hist.bmp":u) .
      282                                   hh:TOOLTIP = "История" .
      283                                   v-h[ii] = hh:handle .
      284                                   ii = ii + 1 .
      285                                   hh:width-chars = 3 .
      286                               end.
      287                           when "b-sch" then
      288                               do:
      289                                   hh:load-image("cmp/b-sch.bmp":u) .
      290                                   hh:TOOLTIP = "Установка Фильтра" .
      291                                   v-h[ii] = hh:handle .
      292                                   ii = ii + 1 .
      293                                   hh:width-chars = 3 .
      294                               end.
      295                           when "b-hist-user" then
      296                               do:
      297                                   hh:load-image("cmp/b-hist.bmp":u) .
      298                                   hh:TOOLTIP = "История пользователя" .
      299                                   ii = ii + 1 .
      300                               end.
      301                       end case.
      302                   end.
      303                   hh = hh:next-sibling.
      304               end.
      305               b-help:column = v-frame-width - b-help:width-chars.
      306               jj = 0.
      307               repeat ii = 4 to 1 by -1 :
      308                   if valid-handle (v-h[ii] ) then
      309                   do:
      310                       jj  = jj + 1 .
      311                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      312                       v-h[ii]:row    = v-help-old-y .
      313                   end.
      314               end.
      315           end.
      316       end.
      317   end procedure.
      318   MAIN-BLOCK:
      319   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      320      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      321     RUN MYenable.
      322     WAIT-FOR GO OF FRAME Dialog-Frame.
      323   END.
      324   RUN disable_UI.
      325   PROCEDURE disable_UI :
      326     HIDE FRAME Dialog-Frame.
      327   END PROCEDURE.
      328   PROCEDURE enable_UI :
      329     DISPLAY d-pcnt d-cash-pcnt n-d-pcnt n-d-cash-pcnt
      330         WITH FRAME Dialog-Frame.
      331     ENABLE B-exit b-quit B-Help l-d-cash-pcnt l-d-pcnt n-d-pcnt n-d-cash-pcnt
      332         WITH FRAME Dialog-Frame.
      333     VIEW FRAME Dialog-Frame.
      334   END PROCEDURE.
      335   PROCEDURE MyEnable :
      336   assign
      337   d-pcnt = p-d-pcnt
      338   d-cash-pcnt = p-d-cash-pcnt
      339   .
      340   DISPLAY d-pcnt d-cash-pcnt n-d-pcnt n-d-cash-pcnt
      341         WITH FRAME Dialog-Frame.
      342     ENABLE b-quit l-d-cash-pcnt l-d-pcnt B-exit B-Help n-d-pcnt n-d-cash-pcnt
      343         WITH FRAME Dialog-Frame.
      344     VIEW FRAME Dialog-Frame.
      345   if d-pcnt > 0 then do:
      346       APPLY "MOUSE-SELECT-CLICK" to l-d-pcnt.
      347   end.
      348   if d-cash-pcnt > 0 then do:
      349       APPLY "MOUSE-SELECT-CLICK" to l-d-cash-pcnt.
      350   end.
      351   END PROCEDURE.
