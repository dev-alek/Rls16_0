     3077   ON BACKSPACE OF tt-fin-doc.including IN FRAME Dialog-Frame
     3078   DO:
     3079   define variable v-offset as integer no-undo .
     3080     RUN proc-uho-check IN THIS-PROCEDURE(1) NO-ERROR.
     3081     IF ERROR-STATUS :ERROR THEN DO: RETURN NO-APPLY. END.
     3082     if tt-fin-doc.including :CURSOR-OFFSET > 1 then do :
     3083       assign
     3084       v-offset = tt-fin-doc.including:CURSOR-OFFSET
     3085       tt-fin-doc.including:screen-value = substring(tt-fin-doc.including:screen-value, 1, tt-fin-doc.including:CURSOR-OFFSET - 2) +
     3086                         substring(tt-fin-doc.including:screen-value, tt-fin-doc.including:CURSOR-OFFSET , length(tt-fin-doc.including:screen-value)  -  tt-fin-doc.including:CURSOR-OFFSET + 1)
     3087       tt-fin-doc.including:CURSOR-OFFSET = v-offset - 1
     3088       .
     3089     end.
     3090   END.
     3091   ON DELETE-CHARACTER OF tt-fin-doc.including IN FRAME Dialog-Frame
     3092   DO:
     3093   define variable v-offset as integer no-undo .
     3094     if tt-fin-doc.including:selection-start = ? then do:
     3095       RUN proc-uho-check IN THIS-PROCEDURE(0) NO-ERROR.
     3096       IF ERROR-STATUS :ERROR THEN DO: RETURN NO-APPLY. END.
     3097       assign
     3098       v-offset = tt-fin-doc.including:CURSOR-OFFSET
     3099       tt-fin-doc.including:screen-value = substring(tt-fin-doc.including:screen-value, 1, tt-fin-doc.including:CURSOR-OFFSET - 1) +
     3100                         substring(tt-fin-doc.including:screen-value, tt-fin-doc.including:CURSOR-OFFSET + 1, length(tt-fin-doc.including:screen-value)  -  tt-fin-doc.including:CURSOR-OFFSET + 1)
     3101       tt-fin-doc.including:CURSOR-OFFSET = v-offset
     3102       .
     3103     end.
     3104     else do:
     3105       IF  index(tt-fin-doc.including:SCREEN-VALUE IN FRAME Dialog-Frame, "@") > 0 then do:
     3106         IF tt-fin-doc.including:Selection-start >= index(tt-fin-doc.including:SCREEN-VALUE, "@") + 1 THEN   do:
     3107           RETURN no-apply.
     3108         end.
     3109       END.
     3110       tt-fin-doc.including:edit-clear().
     3111     end.
     3112   END.
