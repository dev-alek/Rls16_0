     6894   PROCEDURE proc-save :
     6895   define input parameter p-save as logical no-undo .
     6896   if p-mode = 'ПРОСМОТР':U or not available tt-fin-doc then do:
     6897       return error.
     6898   end.
     6899   if is-fact-and-edit() then do with frame Dialog-Frame:
     6900       assign
     6901           tt-fin-doc.prn-doc-code.
     6902   end.
     6903   else do:
     6904       assign
     6905       tt-fin-doc.prn-doc-code frame Dialog-Frame
     6906       tt-fin-doc.doc-date
     6907       tt-fin-doc.receiver-name
     6908       tt-fin-doc.obj-code
     6909       tt-fin-doc.obj-type
