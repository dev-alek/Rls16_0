      137   define new global shared variable g#library  as handle no-undo .
      138   define new global shared variable g#library2 as handle no-undo .
      139   define   shared variable g#auto as logical no-undo.
      140   define   shared variable g#news as logical no-undo.
      141   define   shared variable g#oxml as logical no-undo.
      142   define   shared variable g#esys as logical no-undo.
      143   define   shared variable g#news-source-db as integer no-undo.
      144   define   shared variable g#esys-source-esys as integer no-undo.
