      549   procedure uf-get :
      550     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      551     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      552     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      553     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      554     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      555     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      556     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      557     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      558     do
      559     on error undo, return error
      560     :
      561       define buffer buf_usr-flt for ubflt.usr-flt .
      562       define variable v-use-List_     as logical   no-undo .
      563       define variable v-type-List_     as character no-undo .
      564       define variable v-format-List_   as character no-undo .
      565       define variable v-use-Naim      as logical   no-undo .
      566       define variable v-type-Naim      as character no-undo .
      567       define variable v-format-Naim    as character no-undo .
      568       define variable v-use-print-graft as logical   no-undo .
      569       define variable v-use-sort-gr     as logical   no-undo .
      570       define variable v-use-type-price  as logical   no-undo .
      571       define variable v-use-type-val    as logical   no-undo .
      572       define variable v-label          as character no-undo .
      573       define variable v-tooltip        as character no-undo .
      574       define variable v-user-can-edit  as logical   no-undo .
      575       define variable v-output-display as logical   no-undo .
      576       define variable v-other          as character no-undo .
      577       run uf-name in this-procedure
      578          (input  entry(1, p-code, chr(4))
      579         ,output v-use-List_
      580         ,output v-type-List_
      581         ,output v-format-List_
      582         ,output v-use-Naim
      583         ,output v-type-Naim
      584         ,output v-format-Naim
      585         ,output v-use-print-graft
      586         ,output v-use-sort-gr
      587         ,output v-use-type-price
      588         ,output v-use-type-val
      589         ,output v-label
      590         ,output v-tooltip
      591         ,output v-user-can-edit
      592         ,output v-output-display
      593         ,output v-other
      594         ) no-error .
      595       if error-status :error then do:
      596         undo, return error return-value .
      597       end.
      598       find first buf_usr-flt no-lock where
      599                  buf_usr-flt.Call-point     = p-code AND
      600                  buf_usr-flt.user-name       = p-user-name
      601         no-error .
      602       if avail buf_usr-flt then do:
      603         assign
      604         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      605         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      606         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      607         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      608         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      609         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      610         .
      611       end.
      612       else do:
      613         assign
      614         p-List_        = (if v-use-List_       then "":U                    else ?)
      615         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      616         p-print-graft  = (if v-use-print-graft then no                      else ?)
      617         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      618         p-type-price   = (if v-use-type-price  then no                      else ?)
      619         p-type-val     = (if v-use-List_       then no                      else ?)
      620         .
      621       end.
      622     end.
      623   end procedure.
      624   procedure uf-set :
      625     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      626     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      627     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      628     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      629     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      630     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      631     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      632     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      633     do
      634     on error undo, return error
      635     :
      636       define buffer buf_usr-flt for ubflt.usr-flt .
      637       define variable v-use-List_     as logical   no-undo .
      638       define variable v-type-List_     as character no-undo .
      639       define variable v-format-List_   as character no-undo .
      640       define variable v-use-Naim      as logical   no-undo .
      641       define variable v-type-Naim      as character no-undo .
      642       define variable v-format-Naim    as character no-undo .
      643       define variable v-use-print-graft as logical   no-undo .
      644       define variable v-use-sort-gr   as logical   no-undo .
      645       define variable v-use-type-price as logical   no-undo .
      646       define variable v-use-type-val  as logical   no-undo .
      647       define variable v-tooltip        as character no-undo .
      648       define variable v-label          as character no-undo .
      649       define variable v-user-can-edit  as logical   no-undo .
      650       define variable v-output-display as logical   no-undo .
      651       define variable v-other          as character no-undo .
      652       run uf-name in this-procedure
      653         (input  entry(1, p-code, chr(4))
      654         ,output v-use-List_
      655         ,output v-type-List_
      656         ,output v-format-List_
      657         ,output v-use-Naim
      658         ,output v-type-Naim
      659         ,output v-format-Naim
      660         ,output v-use-print-graft
      661         ,output v-use-sort-gr
      662         ,output v-use-type-price
      663         ,output v-use-type-val
      664         ,output v-label
      665         ,output v-tooltip
      666         ,output v-user-can-edit
      667         ,output v-output-display
      668         ,output v-other
      669         ) no-error .
      670       if error-status :error then do:
      671         undo, return error return-value .
      672       end.
      673       find first buf_usr-flt where
      674                  buf_usr-flt.Call-point     = p-code AND
      675                  buf_usr-flt.user-name       = p-user-name
      676         no-error .
      677       if not avail buf_usr-flt then do:
      678           create buf_usr-flt .
      679           assign
      680           buf_usr-flt.call-point = p-code
      681           buf_usr-flt.user-name  = p-user-name
      682           .
      683       end.
      684       if avail buf_usr-flt then do:
      685        assign
      686        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      687        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      688        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      689        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      690        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      691        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      692       .
      693       release buf_usr-flt.
      694       end.
      695       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      696     end.
      697   end procedure.
      698   function diff-list returns character (
      699     input parfirst-list  as character,
      700     input parsecond-list as character,
      701     input pardelim       as character).
      702     if pardelim = ""
      703     or pardelim = ?
      704     then do:
      705       assign
      706         pardelim = ","
      707       .
      708     end.
      709     def var ind as integer no-undo .
      710     def var v-elem as character no-undo .
      711     def var v-result-list as character no-undo init "".
      712     def var v-num-parfirst-list as integer no-undo .
      713     assign
      714       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      715     .
      716     do ind = 1 to v-num-parfirst-list
      717     :
      718       assign
      719         v-elem = entry(ind, parfirst-list, pardelim)
      720       .
      721       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      722         assign
      723           v-result-list = v-result-list
      724                         + (if v-result-list > "" then pardelim else "")
      725                         + v-elem
      726         .
      727       end.
      728     end.
      729     return v-result-list .
      730   end function.
      731   function add-list returns character (
      732    input parfirst-list  as character,
      733    input parsecond-list as character,
      734    input pardelim       as character).
      735     if pardelim = ""
      736     or pardelim = ?
      737     then do:
      738       assign
      739         pardelim = ","
      740       .
      741     end.
      742     def var ind as integer no-undo .
      743     def var v-elem as character no-undo .
      744     def var v-result-list as character no-undo init "".
      745     def var v-num-parfirst-list as integer no-undo .
      746     assign
      747       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      748     .
      749     do ind = 1 to v-num-parfirst-list
      750     :
      751       assign
      752         v-elem = entry(ind, parfirst-list, pardelim)
      753       .
      754       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      755         assign
      756           v-result-list = v-result-list
      757                         + (if v-result-list > "" then pardelim else "")
      758                         + v-elem
      759         .
      760       end.
      761     end.
      762     def var v-num-parsecond-list as integer no-undo .
      763     assign
      764       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      765     .
      766     do ind = 1 to v-num-parsecond-list
      767     :
      768       assign
      769         v-elem = entry(ind, parsecond-list, pardelim)
      770       .
      771       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      772         assign
      773           v-result-list = v-result-list
      774                         + (if v-result-list > "" then pardelim else "")
      775                         + v-elem
      776         .
      777       end.
      778     end.
      779     return v-result-list .
      780   end function.
      781   function cross-list returns character (
      782    input parfirst-list  as character,
      783    input parsecond-list as character,
      784    input pardelim       as character).
      785     if pardelim = ""
      786     or pardelim = ?
      787     then do:
      788       assign
      789         pardelim = ","
      790       .
      791     end.
      792     def var ind as integer no-undo .
      793     def var v-elem as character no-undo .
      794     def var v-result-list as character no-undo init "".
      795     def var v-num-parfirst-list as integer no-undo .
      796     assign
      797       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      798     .
      799     do ind = 1 to v-num-parfirst-list
      800     :
      801       assign
      802         v-elem = entry(ind, parfirst-list, pardelim)
      803       .
      804       if lookup(v-elem, v-result-list, pardelim) = 0
      805       and lookup(v-elem, parsecond-list, pardelim) > 0
      806       then do:
      807         assign
      808           v-result-list = v-result-list
      809                         + (if v-result-list > "" then pardelim else "")
      810                         + v-elem
      811         .
      812       end.
      813     end.
      814     return v-result-list .
      815   end function.
      816   function radio-label returns character (
      817    input par-rs-value  as character,
      818    input par-rs-radio-buttons as character)
      819    .
      820    DEFINE variable v-result-label as character no-undo.
      821    assign
      822    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      823                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      824                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      825                             ), par-rs-radio-buttons
      826                           )
      827    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      828    .
      829   return v-result-label.
      830   end function.
      831   function m-radio-label returns character (
      832    input par-rs-value  as character,
      833    input par-rs-radio-buttons as character,
      834    input par-delim as character
      835    )
      836    .
      837    DEFINE variable v-result-label as character no-undo.
      838    assign
      839    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      840                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      841                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      842                             ), par-rs-radio-buttons, par-delim
      843                           )
      844    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      845    .
      846   return v-result-label.
      847   end function.
      848   FUNCTION mixlist returns character
      849   (
      850    input parfirst-list  as character
      851    ,input parsecond-list as character
      852    ,input pardelim       as character
      853    ,input pardelim-result as character ) :
      854     if pardelim = ""
      855     or pardelim = ?
      856     then do:
      857       assign
      858         pardelim = ","
      859       .
      860     end.
      861     def var ind as integer no-undo .
      862     def var v-elem1 as character no-undo .
      863     def var v-elem2 as character no-undo .
      864     def var v-result-list as character no-undo init "".
      865     do ind = 1 to num-entries(parfirst-list, pardelim)
      866     :
      867       assign
      868         v-elem1 = entry(ind, parfirst-list, pardelim)
      869         v-elem2 = entry(ind, parsecond-list, pardelim)
      870       .
      871         assign
      872           v-result-list = v-result-list
      873                         + (if v-result-list > "" then pardelim-result else "")
      874                         + v-elem1 + pardelim-result + v-elem2
      875         .
      876     end.
      877     return v-result-list .
      878   END FUNCTION.
      879   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
