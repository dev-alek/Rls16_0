     5133       "Тип" self :type  skip
     5134       "Процедура" this-procedure :file-name skip
     5135       view-as alert-box .
     5136   end.
     5137   else do:
     5138     apply "entry":u to self  .
     5139     if focus :handle <> self :handle  then do:
     5140       return no-apply .
     5141     end.
     5142   end.
     5143   assign
     5144     v-curr-code = tt-fin-doc.curr-code
     5145     tt-fin-doc.curr-code.
     5146   FIND FIRST X_currency WHERE
     5147     X_currency.curr-code = tt-fin-doc.curr-code NO-LOCK NO-error.
     5148   if not available X_currency then
     5149   do:
     5150     message
     5151       "Нет валюты с кодом"   tt-fin-doc.curr-code
     5152       view-as alert-box error.
     5153     assign
     5154       tt-fin-doc.curr-code = v-curr-code.
     5155     display
     5156       tt-fin-doc.curr-code
     5157       with frame Dialog-Frame.
     5158     .
     5159   end.
     5160   else
     5161   do:
     5162     assign
     5163       f-curr-abbr = X_currency.curr-abbr
     5164       .
     5165     display
     5166       f-curr-abbr
     5167       tt-fin-doc.curr-code
     5168       with frame Dialog-Frame.
     5169     .
     5170     if tt-fin-doc.curr-code <> v-curr-code then
     5171     do:
     5172       run recalc in this-procedure("curr-code":U) no-error.
     5173       if error-status:error then
     5174       do:
     5175         assign
     5176           tt-fin-doc.curr-code = v-curr-code
     5177           .
     5178         display tt-fin-doc.curr-code
     5179           with frame Dialog-Frame.
     5180       end.
     5181       run hide-view-currency in this-procedure .
     5182     end.
     5183   end.
     5184   END.
     5185   ON LEAVE OF tt-fin-doc.doc-date IN FRAME Dialog-Frame
     5186     DO:
     5187   define variable vss-include-info48 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5188   if lookup(self :type
     5189            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     5190            ) = 0
     5191   then do:
     5192     message
     5193       "$Workfile$"
     5194       "Указанному интерфейсному элементу фокус не может быть передан" skip
     5195       "Интерфейсный элемент" self :name  skip
     5196       "Тип" self :type  skip
     5197       "Процедура" this-procedure :file-name skip
     5198       view-as alert-box .
     5199   end.
     5200   else do:
     5201     apply "entry":u to self  .
     5202     if focus :handle <> self :handle  then do:
     5203       return no-apply .
     5204     end.
     5205   end.
     5206   define variable v-doc-date as date    no-undo.
     5207   define variable vlog       as logical no-undo .
     5208   if tt-fin-doc.shift-flag = integer('1':U) then
     5209   do:
     5210     if tt-fin-doc.shift-date >  input frame Dialog-Frame  tt-fin-doc.doc-date  then
     5211     do:
     5212       message
     5213         "Дата документа не может быть меньше даты смены!"
     5214         view-as alert-box error .
     5215       return no-apply.
     5216     end.
     5217   end.
     5218   assign
     5219     v-doc-date = tt-fin-doc.doc-date
     5220     tt-fin-doc.doc-date
     5221     .
     5222   if tt-fin-doc.doc-date <> v-doc-date
     5223     and (input frame Dialog-Frame   tt-fin-doc.sum-doc <> 0
     5224     or tt-fin-doc.sum-doc <> 0)
     5225     then
     5226   do:
     5227     message
     5228       "Пересчитать суммы документа в соответствии с курсами на новую дату?"
     5229       view-as alert-box QUESTION buttons YEs-NO update vlog.
     5230     if  vlog then
     5231     do:
     5232       run recalc in this-procedure ("doc-date":U) no-error.
     5233       if error-status:error then
     5234       do:
     5235         assign
     5236           tt-fin-doc.doc-date = v-doc-date
     5237           .
     5238         display tt-fin-doc.doc-date
     5239           with frame Dialog-Frame.
     5240       end.
     5241     end.
     5242   end.
     5243   END.
