     3238         tt-fin-doc.obj-type.
     3239       if   input frame Dialog-Frame tt-fin-doc.obj-code <> 0 then
     3240       do:
     3241         run check-obj in this-procedure (
     3242           input frame Dialog-Frame tt-fin-doc.obj-type
     3243           ,input frame Dialog-Frame tt-fin-doc.obj-code
     3244           )
     3245           no-error.
     3246         if error-status:error then
     3247         do:
     3248           return no-apply.
