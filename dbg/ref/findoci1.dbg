     2155   function clean_char return char
     2156   (INPUT in_str AS CHARACTER):
     2157       DEFINE VARIABLE out_str  AS CHARACTER NO-UNDO.
     2158       DEFINE VARIABLE i        AS INTEGER   NO-UNDO.
     2159       DEFINE VARIABLE new_str  AS CHARACTER NO-UNDO.
     2160       DEFINE VARIABLE ch_code  AS INTEGER   NO-UNDO.
     2161       out_str = "".
     2162       DO i = 1 TO LENGTH (in_str):
     2163           new_str = SUBSTRING(in_str, i, 1).
     2164           ch_code = ASC(new_str).
     2165           IF  ch_code >= 32
     2166           and ch_code < 1104
     2167           and ch_code <> 166
     2168           and ch_code <> 127
     2169           and new_str <> "?"
     2170           THEN out_str = out_str + new_str.
     2171       END.
     2172       RETURN out_str.
     2173   END.
     2174   function is-fact-and-edit returns logical ():
     2175       return (p-mode = 'ИЗМЕНЕНИЕ':U and locked_fin-doc.status_ = 'факт':U).
     2176   end.
