     1980   procedure c-fin-doc-attr-value :
     1981    do
     1982    on error undo, return error return-value
     1983    :
     1984   define input  parameter p-host-code    like ub.c-fin-doc-attr.host-code    no-undo .
     1985   define input  parameter p-fin-doc-code like ub.c-fin-doc-attr.fin-doc-code     no-undo .
     1986   define input parameter p-corr-user-db-num  like ub.c-fin-doc-attr.corr-user-db-num   no-undo .
     1987   define input parameter p-chip-num      like ub.c-fin-doc-attr.chip-num   no-undo .
     1988   define input  parameter p-attr-code    like ub.c-fin-doc-attr.attr-code    no-undo .
     1989   define output parameter p-attr-value   like ub.c-fin-doc-attr.attr-value   no-undo .
     1990   define variable  v-format         as character no-undo .
     1991   define variable  v-label          as character no-undo .
     1992   define variable  v-user-can-edit  as logical   no-undo .
     1993   define variable  v-output-display as logical   no-undo .
     1994   define variable  v-other          as character no-undo .
     1995   define variable  v-type           as character no-undo .
     1996   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
     1997   run fd-attr-code in this-procedure
     1998     (input  p-attr-code
     1999     ,output v-type
     2000     ,output v-format
     2001     ,output v-label
     2002     ,output v-user-can-edit
     2003     ,output v-output-display
     2004     ,output v-other
     2005     ) no-error .
     2006   if error-status :error then do:
     2007     undo, return error return-value .
     2008   end.
     2009   find first buf_c-fin-doc-attr no-lock where
     2010             buf_c-fin-doc-attr.attr-code    = p-attr-code
     2011         AND buf_c-fin-doc-attr.fin-doc-code      = p-fin-doc-code
     2012         AND buf_c-fin-doc-attr.host-code      = p-host-code
     2013         AND buf_c-fin-doc-attr.corr-user-db-num = p-corr-user-db-num
     2014         AND buf_c-fin-doc-attr.chip-num         = p-chip-num      no-error .
     2015     if available  buf_c-fin-doc-attr then do:
     2016       assign
     2017       p-attr-value = buf_c-fin-doc-attr.attr-value
     2018       .
     2019     end.
     2020     else do:
     2021       p-attr-value = ? .
     2022     end.
     2023    end.
     2024   end procedure.
     2025   procedure c-fin-doc-attr-value-nextchip :
