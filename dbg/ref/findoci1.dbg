      885   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      886   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      887   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      888   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      889   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      890   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      891   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      892   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      893   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      894   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      895   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      896   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      897   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      898     define variable v-cntxt-db-num        as integer   no-undo .
      899     define variable v-cntxt-userid        as character no-undo .
      900     define variable v-cntxt-level         as character no-undo .
      901     define variable v-cntxt-host-code-obj as integer   no-undo .
      902     define variable v-cntxt-obj-type      as character no-undo .
      903     define variable v-cntxt-obj-code      as integer   no-undo .
      904     define variable v-cntxt-db-num-obj    as integer   no-undo .
      905     define variable v-cntxt-is-admin      as logical   no-undo .
      906   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      907   function usrfulnf returns character ( input p-user-id as character):
      908   define variable v-user-name as character no-undo .
      909   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      910   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      911     (input  p-user-id
      912     ,output v-user-name
      913     ) no-error .
      914   if error-status:error
      915   or v-user-name = ""
      916   then do:
      917     return p-user-id.
      918   end.
      919   else do:
      920     return v-user-name.
      921   end.
      922   end function.
      923   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      924   procedure gen-key-rec :
      925     define input  parameter p-tbl-name    as character no-undo.
      926     define input  parameter p-bh_tbl-name as handle    no-undo.
      927     define output parameter p-key-rec     as character no-undo.
      928     do
      929     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      930     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      931     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      932     :
      933       define variable fh               as handle    no-undo .
      934       define variable v-ok             as logical   no-undo .
      935       define variable v-inform         as character no-undo .
      936       define variable v-ind            as integer   no-undo .
      937       define variable v-idx-field-qnty as integer   no-undo .
      938       if p-tbl-name = ?
      939         or p-tbl-name = "":U
      940       then do:
      941         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info7 ).
      942       end.
      943       if not p-bh_tbl-name:available then do:
      944         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info7, p-tbl-name ).
      945       end.
      946       assign
      947         p-key-rec = p-tbl-name
      948         v-inform  = p-bh_tbl-name:index-information(1)
      949         v-ind     = 2
      950       .
      951       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      952       on error undo, return error
      953       :
      954         assign
      955           v-inform = p-bh_tbl-name:index-information( v-ind )
      956           v-ind    = v-ind + 1
      957         .
      958       end.
      959       if v-inform = ?
      960         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      961         or entry( 3, v-inform, ",":U ) <> "1":U
      962       then do:
      963         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, p-tbl-name ).
      964       end.
      965       else do:
      966         assign
      967           v-idx-field-qnty = num-entries( v-inform ) - 4
      968         .
      969         if v-idx-field-qnty < 2 then do:
      970           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, p-tbl-name ).
      971         end.
      972         do v-ind = 1 to v-idx-field-qnty by 2
      973         on error undo, return error
      974         :
      975           assign
      976             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      977             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      978           .
      979         end.
      980       end.
      981       if p-key-rec = ? then do:
      982         assign
      983           p-key-rec = "":U
      984         .
      985         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info7, p-tbl-name ).
      986       end.
      987     end.
      988     return.
      989   end procedure.
      990   procedure gen-where-keyr-tab :
      991     define input  parameter i-tableSerach as character no-undo.
      992     define input  parameter i-tablekey   as character  no-undo.
      993     define input  parameter p-key-rec    as character  no-undo.
      994     define input  parameter p-key-handle as handle     no-undo .
      995     define input  parameter p-db-name    as character  no-undo .
      996     define input  parameter p-tt-handle  as handle     no-undo .
      997     define output parameter o-Where      as character  no-undo.
      998     do
      999     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1000     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1001     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1002     :
     1003       define variable v-full-tbl-name  as character no-undo .
     1004       define variable bh_tbl-name      as handle    no-undo .
     1005       define variable fh_key           as handle    no-undo .
     1006       define variable fh_search        as handle    no-undo .
     1007       define variable v-field-num      as integer   no-undo .
     1008       define variable v-count-fld      as integer   no-undo .
     1009       define variable v-inform         as character no-undo .
     1010       define variable v-ind            as integer   no-undo .
     1011       define variable v-idx-field-qnty as integer   no-undo .
     1012       define variable v-field-name     as character no-undo .
     1013       define variable v-field-val      as character no-undo .
     1014       define variable v-word-link      as character no-undo .
     1015       define variable vTable           as character no-undo.
     1016       define variable bh_tbl-key       as handle    no-undo .
     1017       assign
     1018         p-key-rec = trim( p-key-rec )
     1019       .
     1020       if p-key-handle <> ? then do:
     1021         if not valid-handle(p-key-handle)
     1022            or p-key-handle:type <> "buffer"
     1023         then do:
     1024           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info7 ).
     1025         end.
     1026         if num-entries( p-key-rec, chr(3) ) > 1
     1027           or p-key-rec = ?
     1028           or p-key-rec = "":U
     1029         then do:
     1030           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info7, p-key-rec ).
     1031         end.
     1032       end.
     1033       else do:
     1034         if p-key-rec = ?
     1035           or p-key-rec = "":U
     1036         then do:
     1037           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
     1038         end.
     1039       end.
     1040       assign
     1041         vTable = entry( 1 , p-key-rec, chr(3) )
     1042       .
     1043       if p-tt-handle <> ?
     1044         and ( not valid-handle(p-tt-handle)
     1045               or p-tt-handle:type <> "buffer"
     1046             )
     1047       then do:
     1048         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info7, vTable, chr(10) ).
     1049       end.
     1050       if p-tt-handle = ? then do:
     1051         assign
     1052           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1053         .
     1054         create buffer bh_tbl-name for table v-full-tbl-name .
     1055       end.
     1056       else do:
     1057         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1058       end.
     1059       assign
     1060         v-inform = bh_tbl-name:index-information(1)
     1061         v-ind    = 2
     1062       .
     1063       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1064       on error undo, return error
     1065       :
     1066         assign
     1067           v-inform = bh_tbl-name:index-information( v-ind )
     1068           v-ind    = v-ind + 1
     1069         .
     1070       end.
     1071       if v-inform = ?
     1072         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1073         or entry( 3, v-inform, ",":U ) <> "1":U
     1074       then do:
     1075         delete object bh_tbl-name no-error.
     1076         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info7, vTable ).
     1077       end.
     1078       assign
     1079         v-idx-field-qnty = num-entries( v-inform ) - 4
     1080       .
     1081       if v-idx-field-qnty < 2 then do:
     1082         delete object bh_tbl-name no-error.
     1083         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, vTable ).
     1084       end.
     1085       assign
     1086         o-where     = "where":U
     1087         v-word-link = "":U
     1088         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1089         v-count-fld = 0
     1090       .
     1091       if i-tablekey ne "" and i-tablekey ne ?
     1092       then do:
     1093         assign
     1094           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1095         .
     1096         create buffer bh_tbl-key for table v-full-tbl-name .
     1097       end.
     1098       if i-tableSerach ne "" and i-tableSerach ne ?
     1099       then do:
     1100         delete object bh_tbl-name no-error.
     1101         assign
     1102           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1103         .
     1104         create buffer bh_tbl-name for table v-full-tbl-name .
     1105       end.
     1106       block_where:
     1107       do v-ind = 1 to v-idx-field-qnty by 2
     1108       on error undo, return error
     1109       :
     1110         assign
     1111           v-count-fld = v-count-fld + 1
     1112         .
     1113         if p-key-handle = ?
     1114           and v-count-fld > v-field-num
     1115         then do:
     1116           leave block_where.
     1117         end.
     1118         define variable VfieldKeyTable as handle no-undo.
     1119         assign
     1120           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1121           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1122         .
     1123         if     bh_tbl-key ne ?
     1124         then do:
     1125            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1126            if VfieldKeyTable eq ?
     1127            then next block_where.
     1128         end.
     1129         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1130         then
     1131            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1132         else
     1133            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1134         if p-key-handle = ? then do:
     1135           assign
     1136             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1137           .
     1138         end.
     1139         else do:
     1140           assign
     1141             fh_key = p-key-handle:buffer-field( v-field-name )
     1142           .
     1143           if fh_key = ?
     1144             or not valid-handle( fh_key )
     1145           then do:
     1146             delete object bh_tbl-name.
     1147             if     bh_tbl-key ne ?
     1148             then
     1149                delete object bh_tbl-key.
     1150             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info7, p-key-handle:name, v-field-name ).
     1151           end.
     1152           assign
     1153             v-field-val = fh_key:buffer-value
     1154           .
     1155         end.
     1156         if fh_search:data-type ="character":U then do:
     1157           assign
     1158             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1159             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1160             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1161             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1162             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1163             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1164             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1165             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1166             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1167             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1168             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1169             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1170             v-field-val = substitute( '"&1"', v-field-val )
     1171           .
     1172         end.
     1173         assign
     1174           o-where = substitute( "&1 &2", o-where, v-field-val )
     1175         .
     1176         if v-word-link = "":U then do:
     1177           assign
     1178             v-word-link = "and":U
     1179           .
     1180         end.
     1181       end.
     1182       delete object bh_tbl-name.
     1183       if     bh_tbl-key ne ?
     1184       then
     1185          delete object bh_tbl-key.
     1186       if p-key-handle = ?
     1187         and v-count-fld <> v-field-num
     1188       then do:
     1189         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info7, vTable ).
     1190       end.
     1191     end.
     1192   end procedure.
     1193   procedure gen-hn-keyr-tab :
     1194     define input  parameter i-tableSerach as character no-undo.
     1195     define input  parameter i-tablekey   as character no-undo.
     1196     define input  parameter p-key-rec    as character no-undo.
     1197     define input  parameter p-key-handle as handle    no-undo .
     1198     define input  parameter p-db-name    as character no-undo .
     1199     define input  parameter p-tt-handle  as handle    no-undo .
     1200     define input  parameter p-stts-lock  as integer   no-undo .
     1201     define output parameter o-hn         as handle    no-undo.
     1202     define variable v-full-tbl-name as character no-undo.
     1203     define variable v-where         as character no-undo.
     1204     define variable bh_tbl-name     as handle    no-undo.
     1205     define variable vTable          as character no-undo.
     1206     do
     1207     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1208     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1209     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1210         run gen-where-keyr-tab(i-tableSerach,
     1211                                i-tablekey,
     1212                                p-key-rec,
     1213                                p-key-handle,
     1214                                p-db-name,
     1215                                p-tt-handle,
     1216                                output v-where).
     1217         if i-tableSerach ne "" and i-tableSerach ne ?
     1218         then do:
     1219            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1220            create buffer bh_tbl-name for table v-full-tbl-name .
     1221         end.
     1222         else do:
     1223            if p-tt-handle = ? then do:
     1224               assign
     1225                  vTable = entry( 1 , p-key-rec, chr(3) )
     1226               .
     1227               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1228               create buffer bh_tbl-name for table v-full-tbl-name .
     1229            end.
     1230            else do:
     1231               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1232            end.
     1233         end.
     1234         if p-tt-handle = ? then do:
     1235            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1236         end.
     1237         else do:
     1238            bh_tbl-name:find-first( v-where ) no-error .
     1239         end.
     1240         o-hn = bh_tbl-name.
     1241      end.
     1242   end procedure.
     1243   procedure gen-hn-keyr :
     1244     define input  parameter p-key-rec    as character no-undo.
     1245     define input  parameter p-key-handle as handle    no-undo .
     1246     define input  parameter p-db-name    as character no-undo .
     1247     define input  parameter p-tt-handle  as handle    no-undo .
     1248     define input  parameter p-stts-lock  as integer   no-undo .
     1249     define output parameter o-hn         as handle    no-undo.
     1250     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1251   end.
     1252   procedure gen-row-keyr :
     1253     define input  parameter p-key-rec    as character no-undo.
     1254     define input  parameter p-key-handle as handle    no-undo .
     1255     define input  parameter p-db-name    as character no-undo .
     1256     define input  parameter p-tt-handle  as handle    no-undo .
     1257     define input  parameter p-stts-lock  as integer   no-undo .
     1258     define output parameter p-tbl-row    as rowid     no-undo.
     1259     define output parameter p-tbl-name   as character no-undo.
     1260     define variable vHn as handle no-undo.
     1261       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1262       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1263       p-tbl-name =  vHn:table.
     1264       delete object vHn no-error.
     1265     if p-tbl-row = ? then do:
     1266       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info7, p-tbl-name, p-key-rec ).
     1267     end.
     1268     else do:
     1269       return.
     1270     end.
     1271   end procedure.
     1272   procedure gen-key-fv :
     1273     define input  parameter p-key-rec    as character no-undo .
     1274     define output parameter p-field-list as character no-undo .
     1275     define output parameter p-value-list as character no-undo.
     1276     do
     1277     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1278     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1279     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1280     :
     1281       define variable v-full-tbl-name  as character no-undo .
     1282       define variable bh_tbl-name      as handle    no-undo .
     1283       define variable v-tbl-name       as character no-undo .
     1284       define variable v-field-num      as integer   no-undo .
     1285       define variable v-count-fld      as integer   no-undo .
     1286       define variable v-inform         as character no-undo .
     1287       define variable v-ind            as integer   no-undo .
     1288       define variable v-idx-field-qnty as integer   no-undo .
     1289       define variable v-delim-key      as character no-undo .
     1290       if p-key-rec = ?
     1291         or p-key-rec = "":U
     1292       then do:
     1293         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
     1294       end.
     1295       assign
     1296         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1297         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1298       .
     1299       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1300       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info7 ).
     1301       assign
     1302         v-inform = bh_tbl-name:index-information(1)
     1303         v-ind    = 2
     1304       .
     1305       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1306       on error undo, return error
     1307       :
     1308         assign
     1309           v-inform = bh_tbl-name:index-information( v-ind )
     1310           v-ind    = v-ind + 1
     1311         .
     1312       end.
     1313       if v-inform = ?
     1314         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1315         or entry( 3, v-inform, ",":U ) <> "1":U
     1316       then do:
     1317         delete object bh_tbl-name no-error.
     1318         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1319       end.
     1320       assign
     1321         v-idx-field-qnty = num-entries( v-inform ) - 4
     1322       .
     1323       if v-idx-field-qnty < 2 then do:
     1324         delete object bh_tbl-name no-error.
     1325         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1326       end.
     1327       assign
     1328         p-field-list = "":U
     1329         p-value-list = "":U
     1330         v-delim-key  = "":U
     1331         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1332         v-count-fld  = 0
     1333       .
     1334       block_where:
     1335       do v-ind = 1 to v-idx-field-qnty by 2
     1336       on error undo, return error
     1337       :
     1338         assign
     1339           v-count-fld = v-count-fld + 1
     1340         .
     1341         if v-count-fld > v-field-num then do:
     1342           leave block_where.
     1343         end.
     1344         assign
     1345           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1346           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1347         .
     1348         if v-ind = 1 then do:
     1349           assign
     1350             v-delim-key = chr(3)
     1351           .
     1352         end.
     1353       end.
     1354       delete object bh_tbl-name.
     1355       if v-count-fld <> v-field-num then do:
     1356         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info7, v-tbl-name ).
     1357       end.
     1358     end.
     1359   end procedure.
     1360   procedure gen-key-field :
     1361     define input  parameter p-table      as character no-undo .
     1362     define output parameter p-field-list as character no-undo .
     1363     do
     1364     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1365     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1366     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1367     :
     1368       define variable v-full-tbl-name  as character no-undo .
     1369       define variable bh_tbl-name      as handle    no-undo .
     1370       define variable v-tbl-name       as character no-undo .
     1371       define variable v-field-num      as integer   no-undo .
     1372       define variable v-count-fld      as integer   no-undo .
     1373       define variable v-inform         as character no-undo .
     1374       define variable v-ind            as integer   no-undo .
     1375       define variable v-idx-field-qnty as integer   no-undo .
     1376       define variable v-delim-key      as character no-undo .
     1377       if p-table = ?
     1378         or p-table = "":U
     1379       then do:
     1380         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info7 ).
     1381       end.
     1382       assign
     1383         v-tbl-name      = p-table
     1384         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1385       .
     1386       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1387       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info7 ).
     1388       assign
     1389         v-inform = bh_tbl-name:index-information(1)
     1390         v-ind    = 2
     1391       .
     1392       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1393       on error undo, return error
     1394       :
     1395         assign
     1396           v-inform = bh_tbl-name:index-information( v-ind )
     1397           v-ind    = v-ind + 1
     1398         .
     1399       end.
     1400       if v-inform = ?
     1401         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1402         or entry( 3, v-inform, ",":U ) <> "1":U
     1403       then do:
     1404         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1405       end.
     1406       assign
     1407         v-idx-field-qnty = num-entries( v-inform ) - 4
     1408       .
     1409       if v-idx-field-qnty < 2 then do:
     1410         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1411       end.
     1412       assign
     1413         p-field-list = "":U
     1414         v-delim-key  = "":U
     1415         v-count-fld  = 0
     1416       .
     1417       block_where:
     1418       do v-ind = 1 to v-idx-field-qnty by 2
     1419       on error undo, return error
     1420       :
     1421         assign
     1422           v-count-fld = v-count-fld + 1
     1423         .
     1424         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1425         if v-ind = 1 then do:
     1426           assign
     1427             v-delim-key = chr(3)
     1428           .
     1429         end.
     1430       end.
     1431       delete object bh_tbl-name.
     1432     end.
     1433   end procedure.
     1434   function getCliKassa returns logical (input p-type as character, input p-code as integer, input p-attr as character, cashbookId as integer) :
     1435   define buffer bf_CashBookRule  for ub.CashBookRule .
     1436   define buffer buf_CashBookRule for ub.CashBookRule .
     1437   find first bf_CashBookRule no-lock where bf_CashBookRule.CashBookID = cashbookId
     1438     and bf_CashBookRule.Obj-type   = 'всем':U
     1439     and bf_CashBookRule.Obj-code   = 0
     1440     and bf_CashBookRule.Code       = p-attr + "-type"
     1441     no-error.
     1442   if available (bf_CashBookRule) then
     1443   do:
     1444     if p-type = bf_CashBookRule.RuleValue then
     1445     do:
     1446       find first buf_CashBookRule no-lock where buf_CashBookRule.CashBookID = cashbookId
     1447         and buf_CashBookRule.Obj-type   = 'всем':U
     1448         and buf_CashBookRule.Obj-code   = 0
     1449         and buf_CashBookRule.Code       = p-attr + "-code"
     1450         no-error.
     1451       if available (buf_CashBookRule) then do:
     1452           if p-code = integer(buf_CashBookRule.RuleValue) then return true .
     1453       end.
     1454     end.
     1455   end.
     1456   return false .
     1457   end function .
     1458   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile: findocip.i $ $Revision: ff8019e24d02, 2996, rls $".
     1459   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1460   procedure cur-time :
     1461      define output parameter p-today as date      no-undo .
     1462      define output parameter p-time  as integer   no-undo .
     1463     do
     1464     on error undo, return error
     1465     :
     1466       define variable v-date1 as date      no-undo .
     1467       define variable v-date2 as date      no-undo .
     1468       define variable v-time  as integer   no-undo .
     1469       assign
     1470         v-date1 = today
     1471         v-time  = time
     1472         v-date2 = today
     1473       .
     1474       if v-date1 <> v-date2
     1475       then do:
     1476         assign
     1477           v-date1 = today
     1478           v-time  = v-time
     1479         .
     1480       end.
     1481       assign
     1482         p-today = v-date1
     1483         p-time  = v-time
     1484       .
     1485     end.
     1486   end.
     1487   function cur-time-date returns character
     1488   :
     1489     return string(today, '99/99/9999':U) .
     1490   end.
     1491   function cur-time-mjd returns decimal
     1492   :
     1493     define variable v-date as date      no-undo .
     1494     define variable v-time as integer   no-undo .
     1495     run cur-time in this-procedure
     1496       (output v-date
     1497       ,output v-time
     1498       ) .
     1499     return integer(v-date) - 2400002 + (v-time / 86400) .
     1500   end.
     1501   function cur-time-get-ending-index returns integer
     1502   (input p-number as integer
     1503   )
     1504   :
     1505     if p-number < 0
     1506     or p-number = ?
     1507     then do:
     1508       return 1 .
     1509     end.
     1510     define variable v-rest as integer   no-undo .
     1511     assign
     1512       p-number = p-number modulo 100
     1513     .
     1514     if p-number < 20
     1515     then do:
     1516       assign
     1517         v-rest = p-number
     1518       .
     1519     end.
     1520     else do:
     1521       assign
     1522         v-rest = p-number modulo 10
     1523       .
     1524     end.
     1525     case v-rest :
     1526       when 1
     1527       then do:
     1528         return 2 .
     1529       end.
     1530       when 2 or
     1531       when 3 or
     1532       when 4
     1533       then do:
     1534         return 3 .
     1535       end.
     1536       otherwise do:
     1537         return 1 .
     1538       end.
     1539     end case .
     1540   end.
     1541   procedure cur-time-mjd-to-date :
     1542      define input  parameter i-mjd-diff as decimal no-undo.
     1543      define output parameter o-Date     as date    no-undo.
     1544      define output parameter o-Time     as integer no-undo.
     1545      define variable v-day-number as integer   no-undo .
     1546      if    i-mjd-diff < 0
     1547         or i-mjd-diff = ?
     1548      then do:
     1549         return "?" .
     1550      end.
     1551      assign
     1552         v-day-number = truncate(i-mjd-diff,0).
     1553         o-Date = date(v-day-number + 2400002).
     1554         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1555     .
     1556   end.
     1557   function cur-time-mjd-to-string returns character
     1558   (input p-mjd-diff as decimal
     1559   )
     1560   :
     1561     define variable v-day-number as integer   no-undo .
     1562     define variable v-seconds    as integer   no-undo .
     1563     define variable v-hour       as integer   no-undo .
     1564     define variable v-min        as integer   no-undo .
     1565     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1566     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1567     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1568     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1569     if p-mjd-diff < 0
     1570     or p-mjd-diff = ?
     1571     then do:
     1572       return "?" .
     1573     end.
     1574     assign
     1575       v-day-number = integer(truncate(p-mjd-diff,0))
     1576       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1577     .
     1578     if v-seconds > 86400
     1579     then do:
     1580       assign
     1581         v-seconds = 86400 - 1
     1582       .
     1583     end.
     1584     if v-seconds < 0
     1585     then do:
     1586       assign
     1587         v-seconds = 0
     1588       .
     1589     end.
     1590     assign
     1591       v-hour = truncate(v-seconds / 3600, 0)
     1592     .
     1593     assign
     1594       v-seconds = v-seconds modulo 3600
     1595     .
     1596     assign
     1597       v-min = truncate(v-seconds / 60, 0)
     1598     .
     1599     assign
     1600       v-seconds = v-seconds modulo 60
     1601     .
     1602     return
     1603         (if v-day-number <> 0
     1604           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1605           else ""
     1606         )
     1607       + (if v-day-number <> 0 or v-hour <> 0
     1608           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1609           else ""
     1610         )
     1611       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1612           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1613           else ""
     1614         )
     1615       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1616       .
     1617   end.
     1618   function cur-time-string returns character
     1619   :
     1620     define variable v-date as date      no-undo .
     1621     define variable v-time as integer   no-undo .
     1622     run cur-time in this-procedure
     1623       (output v-date
     1624       ,output v-time
     1625       ) .
     1626     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1627   end.
     1628   function cur-time-string-sec returns character
     1629   :
     1630     define variable v-date as date      no-undo .
     1631     define variable v-time as integer   no-undo .
     1632     run cur-time in this-procedure
     1633       (output v-date
     1634       ,output v-time
     1635       ) .
     1636     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1637   end.
     1638   function cur-time-custom  returns character
     1639   (input p-prefix as character
     1640   ,input p-date-format as character
     1641   ,input p-delimiter as character
     1642   ,input p-time-format as character
     1643   ,input p-suffix as character
     1644   )
     1645   :
     1646     define variable v-date as date      no-undo .
     1647     define variable v-time as integer   no-undo .
     1648     run cur-time in this-procedure
     1649       (output v-date
     1650       ,output v-time
     1651       ) .
     1652     return
     1653       p-prefix
     1654       + string(v-date, p-date-format)
     1655       + p-delimiter
     1656       + string(v-time, p-time-format)
     1657       + p-suffix
     1658       .
     1659   end.
     1660   function cur-time-print  returns character
     1661   :
     1662     define variable v-date as date      no-undo .
     1663     define variable v-time as integer   no-undo .
     1664     run cur-time in this-procedure
     1665       (output v-date
     1666       ,output v-time
     1667       ) .
     1668     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1669   end.
     1670   function cur-time-datetime returns datetime
     1671   :
     1672     define variable v-char as character no-undo .
     1673     define variable v-datetime as datetime no-undo .
     1674     v-char = cur-time-string().
     1675     v-datetime = datetime(v-char).
     1676     return  v-datetime.
     1677   end.
     1678   function cur-time-string-msec returns character
     1679   :
     1680     define variable v-date as datetime  no-undo .
     1681     v-date = now.
     1682     return string(v-date) .
     1683   end.
     1684   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1685   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1686   define new global shared variable g#attr-lib  as handle no-undo .
     1687   define variable v-attr-lib-variable as handle no-undo .
     1688   define variable v-is-auto-obj as logical no-undo .
