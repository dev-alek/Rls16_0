     6239   PROCEDURE change-view :
     6240   define input parameter p-view as character no-undo.
     6241   define variable v-can-back-shift as logical no-undo .
     6242   if not (tt-fin-doc.obj-type = ''
     6243   and tt-fin-doc.obj-code = 0) then do:
     6244   define variable vss-include-info61 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6245   do:
     6246     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
