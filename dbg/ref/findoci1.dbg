     4713   ON CHOOSE OF B-currency IN FRAME Dialog-Frame
     4714     DO:
     4715       define variable rr          as recid no-undo.
     4716       define variable v-curr-code like ub.fin-doc.curr-code no-undo.
     4717   define variable vss-include-info38 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4718   if lookup(self :type
     4719            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     4720            ) = 0
     4721   then do:
     4722     message
     4723       "$Workfile$"
     4724       "Указанному интерфейсному элементу фокус не может быть передан" skip
     4725       "Интерфейсный элемент" self :name  skip
     4726       "Тип" self :type  skip
     4727       "Процедура" this-procedure :file-name skip
     4728       view-as alert-box .
     4729   end.
     4730   else do:
     4731     apply "entry":u to self  .
     4732     if focus :handle <> self :handle  then do:
     4733       return no-apply .
     4734     end.
     4735   end.
     4736   assign
     4737     v-curr-code = tt-fin-doc.curr-code
     4738     tt-fin-doc.curr-code.
     4739   if available X_currency then rr = recid(X_currency).
     4740   else rr = ?.
     4741   run ref/currency.w (parparentproc, "b-sel", input-output rr ).
     4742   if rr <> ? then
     4743   do:
     4744     FIND FIRST X_currency WHERE
     4745       recid( X_currency ) = rr NO-LOCK .
     4746     assign
     4747       tt-fin-doc.curr-code = X_currency.curr-code
     4748       f-curr-abbr          = X_currency.curr-abbr
     4749       .
     4750     DISPLAY
     4751       tt-fin-doc.curr-code
     4752       f-curr-abbr
     4753       with frame Dialog-Frame .
     4754   end.
     4755   if tt-fin-doc.curr-code <> v-curr-code then
     4756   do:
     4757     run recalc in this-procedure("curr-code":U) no-error.
     4758     if error-status:error then
     4759     do:
     4760       assign
     4761         tt-fin-doc.curr-code = v-curr-code
     4762         .
     4763       display tt-fin-doc.curr-code
     4764         with frame Dialog-Frame.
     4765     end.
     4766     run hide-view-currency in this-procedure .
     4767   end.
     4768   END.
