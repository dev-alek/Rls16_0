     6719                   ,input tt-fin-doc.obj-code
     6720                   ,input tt-fin-doc.contract-code
     6721                   ,input p-ob-doc-code
     6722                   ,input tt-fin-doc.payer-type
     6723                   ,input tt-fin-doc.payer-code
     6724                   ,input 0
     6725                   ,input 'орг':U
     6726                   ,input p-host-code
     6727                   ,input 0
     6728                   ,input tt-fin-doc.curr-code
     6729                   ,input tt-fin-doc.cor-acc
     6730                   ,input tt-fin-doc.cor-acc1
     6731                   ,input tt-fin-doc.an-uchet-code
     6732                   ,input tt-fin-doc.cel-nazn-code
     6733                   ,input tt-fin-doc.CashBookId
     6734                   ,input ""
     6735                   ,INPUT-OUTPUT table ttc-fin-doc
     6736                   ,INPUT-OUTPUT table tt-fin-doc
     6737                   ,output table tt0-fin-doc-attr
     6738                   ,output v-limit-access ) no-error .
     6739   end.
     6740   if error-status:error then do:
     6741     if not return-value = "exit" then do:
     6742       message
     6743       vss-workfile vss-revision vss-description skip
     6744       error-status:get-message(1) skip
     6745       return-value
     6746       view-as alert-box .
     6747     end.
     6748     undo, return error.
     6749   end.
     6750   find first tt-fin-doc.
     6751   run recalc in this-procedure("curr-code":U).
     6752   if p-mode = 'КОПИРОВАНИЕ':U then do:
     6753     assign
     6754     v-copy-mode = yes
     6755     p-mode = 'ДОБАВЛЕНИЕ':U.
     6756     if tt-fin-doc.curr-code = 0  then
     6757     run recalc in this-procedure("sum-doc").
     6758   end.
     6759   END PROCEDURE.
     6760   PROCEDURE MycounterCurr :
     6761   define input  parameter iFileName as character no-undo.
     6762   define input  parameter ikey      as character no-undo.
     6763   define input  parameter icode     as character no-undo.
