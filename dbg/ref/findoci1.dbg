       28   define variable vss-revision    as character no-undo init "$Revision: d3f9048d4e8e, 3106, rls $":U .
       29   define variable vss-author      as character no-undo init "$Author: Ostroukhov $":U .
       30   define variable vss-date        as character no-undo init "$Date: Вт авг 09 09:15:01 2022 +0300 $":U .
