     2055             buf_c-fin-doc-attr.attr-code    = p-attr-code
     2056         and buf_c-fin-doc-attr.fin-doc-code      = p-fin-doc-code
     2057         and buf_c-fin-doc-attr.host-code      = p-host-code
     2058         and buf_c-fin-doc-attr.corr-user-db-num = p-corr-user-db-num
     2059         and buf_c-fin-doc-attr.chip-num         > p-chip-num      no-error .
     2060     if available  buf_c-fin-doc-attr then do:
