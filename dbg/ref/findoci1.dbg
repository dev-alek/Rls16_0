     2121   define output parameter p-attr-value   like ub.fin-doc-attr.attr-value   no-undo .
     2122   define variable  v-format         as character no-undo .
     2123   define variable  v-label          as character no-undo .
     2124   define variable  v-user-can-edit  as logical   no-undo .
     2125   define variable  v-output-display as logical   no-undo .
     2126   define variable  v-other          as character no-undo .
     2127   define variable  v-type           as character no-undo .
     2128   define buffer buf_fin-doc-attr for tt0-fin-doc-attr.
