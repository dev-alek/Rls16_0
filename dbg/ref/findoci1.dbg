     3131         procedure proc-uho-check :
     3132   DEFINE INPUT PARAMETER p-offset AS INTEGER NO-UNDO.
     3133     do
     3134     on error undo, return error
     3135     :
     3136       IF  index(tt-fin-doc.including:SCREEN-VALUE IN FRAME Dialog-Frame, "@") > 0 then do:
     3137         IF (tt-fin-doc.including:CURSOR-OFFSET >= index(tt-fin-doc.including:SCREEN-VALUE, "@") + 1
     3138         AND p-offset = 0)
     3139         OR (tt-fin-doc.including:CURSOR-OFFSET > index(tt-fin-doc.including:SCREEN-VALUE, "@") + 1
     3140         AND p-offset = 1)  THEN   do:
     3141           RETURN ERROR.
     3142         end.
     3143       END.
     3144     end.
     3145   end procedure.
     3146   ON CHOOSE OF B-obj IN FRAME Dialog-Frame
     3147     DO:
     3148       define variable v-obj-type like ub.fin-doc.obj-type no-undo .
     3149       define variable v-obj-code like ub.fin-doc.obj-code no-undo .
     3150   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3151   if lookup(self :type
     3152            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3153            ) = 0
     3154   then do:
     3155     message
     3156       "$Workfile$"
     3157       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3158       "Интерфейсный элемент" self :name  skip
     3159       "Тип" self :type  skip
     3160       "Процедура" this-procedure :file-name skip
     3161       view-as alert-box .
     3162   end.
     3163   else do:
     3164     apply "entry":u to self  .
     3165     if focus :handle <> self :handle  then do:
     3166       return no-apply .
     3167     end.
     3168   end.
     3169   run str/chshobj.w ( tt-fin-doc.host-code
     3170     , tt-fin-doc.obj-type
     3171     , tt-fin-doc.obj-code
     3172     , output v-obj-type
     3173     , output v-obj-code
     3174     ) no-error .
     3175   if error-status:error
     3176     or (
     3177     v-obj-type = tt-fin-doc.obj-type
     3178     AND v-obj-code = tt-fin-doc.obj-code)
     3179     or v-obj-code = 0
     3180     or v-obj-type = "":U
     3181     then
     3182   do:
     3183     return no-apply.
     3184   end.
     3185   find first X_clients-obj no-lock where
     3186     X_clients-obj.obj-type = v-obj-type
     3187     AND X_clients-obj.obj-code = v-obj-code .
