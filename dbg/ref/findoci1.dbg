     3921   PROCEDURE check-payer :
     3922     define buffer buf_clients for ub.clients.
     3923     find first buf_clients no-lock where
     3924       buf_clients.obj-code = input frame Dialog-Frame tt-fin-doc.payer-code
     3925       and buf_clients.obj-type = input frame Dialog-Frame tt-fin-doc.payer-type no-error.
     3926     if not available buf_clients then
     3927     do:
     3928       if input frame Dialog-Frame tt-fin-doc.payer-code <> ?  then
     3929         message "Неправильный код или тип " 'ПЛАТЕЛЬЩИКА'.
     3930       apply "entry" to tt-fin-doc.payer-code in frame Dialog-Frame.
     3931       return error.
     3932     end.
     3933     find first X_payer no-lock where recid(X_payer) = recid(buf_clients).
     3934     assign
     3935       tt-fin-doc.payer-type = buf_clients.obj-type
     3936       tt-fin-doc.payer-code = buf_clients.obj-code
     3937       tt-fin-doc.payer-name = buf_clients.obj-name
     3938       .
     3939   find first ub.CashBook no-lock where ub.CashBook.id = tt-fin-doc.cashbookId no-error .
     3940   if ub.CashBook.cli-code = tt-fin-doc.payer-code and ub.CashBook.cli-type = tt-fin-doc.payer-type then do:
     3941   assign
     3942     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     3943     tt-fin-doc.cor-acc-value  = ub.CashBook.corrPko
     3944     tt-fin-doc.naznach-plat   = ub.CashBook.RuleOsnPko
     3945     .
     3946   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     3947     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3948     and X_fin-code-cor-acc.status_ = integer('0':U)
     3949     no-error .
     3950   if available X_fin-code-cor-acc
     3951     then
     3952   do :
     3953     assign
     3954       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     3955       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     3956       .
     3957   end.
     3958   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     3959     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     3960     and X_fin-code-cor-acc1.status_ = integer('0':U)
     3961     no-error .
     3962   if available X_fin-code-cor-acc1
     3963     then
     3964   do :
     3965     assign
     3966       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     3967       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     3968       .
     3969   end.
     3970   end.
     3971   else
     3972   do:
     3973   if getCliKassa(tt-fin-doc.payer-type, tt-fin-doc.payer-code, "Vnecli", tt-fin-doc.cashbookId) then do:
     3974   assign
     3975     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     3976     .
     3977   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3978     and ub.CashBookRule.Obj-type   = 'всем':U
     3979     and ub.CashBookRule.Obj-code   = 0
     3980     and ub.CashBookRule.Code       = "corrPkoVne"
     3981     no-error.
     3982   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     3983   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3984     and ub.CashBookRule.Obj-type   = 'всем':U
     3985     and ub.CashBookRule.Obj-code   = 0
     3986     and ub.CashBookRule.Code       = "RuleOsnPkoVne"
     3987     no-error.
     3988   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     3989   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     3990     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3991     and X_fin-code-cor-acc.status_ = integer('0':U)
     3992     no-error .
