     5287   PROCEDURE disable-enable :
     5288     define input parameter p-main-widget as character no-undo.
     5289     define input parameter p-main-curr as character no-undo .
     5290     disable
     5291       tt-fin-doc.sum-doc
     5292       tt-fin-doc.sum-rubl
     5293       tt-fin-doc.sum-base
     5294       tt-fin-doc.base-rate
     5295       tt-fin-doc.base-scale
     5296       tt-fin-doc.exch-rate
     5297       tt-fin-doc.exch-scale
     5298       tt-fin-doc.sum-contr
     5299       tt-fin-doc.contract-rate
     5300       tt-fin-doc.contract-scale
     5301       with frame Dialog-Frame .
     5302     assign
     5303       v-main-sum  = if p-main-widget <> "":U then p-main-widget else v-main-sum
     5304       v-main-curr = if p-main-curr <> "":U then p-main-curr else v-main-curr
     5305       .
     5306     if v-limit-access > 0 then
     5307     do:
     5308       display
     5309         tt-fin-doc.sum-rubl
     5310         when v-rubf
     5311         tt-fin-doc.sum-base
     5312         when v-basef
     5313         tt-fin-doc.exch-rate
     5314         when v-exchf
     5315         tt-fin-doc.exch-scale
     5316         when v-exchf
     5317         tt-fin-doc.base-rate
     5318         when v-basef
     5319         tt-fin-doc.base-scale
     5320         when v-basef
     5321         tt-fin-doc.sum-contr
     5322         when v-contractf
     5323         tt-fin-doc.contract-rate
     5324         when v-contractratef
     5325         tt-fin-doc.contract-scale
     5326         when v-contractratef
     5327         with frame Dialog-Frame.
     5328       return.
     5329     end.
     5330     CASE p-main-widget:
     5331       when "sum-doc" then
     5332         do:
     5333           enable
     5334             tt-fin-doc.sum-doc
     5335             with frame Dialog-Frame.
     5336           APPLY "ENTRY" to tt-fin-doc.sum-doc.
     5337         end.
     5338     END CASE.
     5339     display
     5340       tt-fin-doc.sum-rubl
     5341       when v-rubf
     5342       tt-fin-doc.sum-base
     5343       when v-basef
     5344       tt-fin-doc.exch-rate
     5345       when v-exchf
     5346       tt-fin-doc.exch-scale
     5347       when v-exchf
     5348       tt-fin-doc.base-rate
     5349       when v-basef
     5350       tt-fin-doc.base-scale
     5351       when v-basef
     5352       tt-fin-doc.sum-contr
     5353       when v-contractf
     5354       tt-fin-doc.contract-rate
     5355       when v-contractratef
     5356       tt-fin-doc.contract-scale
     5357       when v-contractratef
     5358       with frame Dialog-Frame.
     5359     CASE rs-view:
     5360       when "full":u then
     5361         do:
     5362           assign
     5363             v-tab-order = "b-exit,b-quit,b-tax,b-cards,b-print,b-hist,b-help," +                            "prn-doc-code,doc-date,obj-type,obj-code,b-obj,b-receiver-view,str-podr-type,str-podr-code,str-podr-name," +                             v-an-uchet-tab-order +  v-sum-curr-tab-order +                            "payer-type,payer-code,b-payer,payer-name,b-payer-view,naznach-plat,including,enclosure," +                            "PS,receiver-sign2,receiver-sign3"
     5364             .
     5365         end.
     5366       when "brief":u then
     5367         do:
     5368           assign
     5369             v-tab-order = "b-exit,b-quit,b-tax,b-cards,b-print,b-hist,b-help," +                             "prn-doc-code,doc-date,obj-type,obj-code,b-obj,b-receiver-view," +                              v-sum-curr-tab-order +                            "payer-type,payer-code,b-payer,payer-name,b-payer-view,naznach-plat,including,enclosure," +                            "PS,receiver-sign2,receiver-sign3"
     5370             .
     5371         end.
     5372       when "contract":u then
     5373         do:
     5374           assign
     5375             v-tab-order = "b-exit,b-quit,b-tax,b-cards,b-print,b-hist,b-help," +                               "prn-doc-code,doc-date,obj-type,obj-code,b-obj,b-receiver-view," +                                v-contract-tab-order + v-sum-curr-tab-order +                                "payer-type,payer-code,b-payer,payer-name,b-payer-view,naznach-plat,including,enclosure," +                                 "PS,receiver-sign2,receiver-sign3"
     5376             .
     5377         end.
     5378     END CASE.
     5379   END PROCEDURE.
     5380   define new global shared variable g#lib-farh as handle no-undo .
     5381   PROCEDURE fill-tables :
     5382     define buffer buf_fin-doc-tax  for ub.fin-doc-tax.
     5383     define buffer buf_fin-doc-attr for ub.fin-doc-attr.
     5384     define buffer buf_fin-ob-tax   for ub.fin-ob-tax.
     5385     define buffer buf_fin-connect  for ub.fin-connect.
     5386     define buffer buf_fin-ob       for ub.fin-ob.
     5387     define buffer buf_payment      for ub.payment.
     5388     if p-mode = 'ДОБАВЛЕНИЕ':U
     5389       AND p-ob-doc-code <> "" then
     5390     do:
     5391       for each buf_fin-ob-tax no-lock where
     5392         buf_fin-ob-tax.host-code = tt-fin-doc.fin-doc-code
     5393         AND buf_fin-ob-tax.doc-code = p-ob-doc-code:
     5394         create tt0-fin-doc-tax.
     5395         buffer-copy buf_fin-ob-tax to tt0-fin-doc-tax.
     5396       end.
     5397       return.
     5398     end.
     5399     if p-mode = 'ДОБАВЛЕНИЕ':U
     5400       and v-copy-mode = yes then
     5401     do:
     5402       for each buf_fin-doc-tax no-lock where
     5403         buf_fin-doc-tax.host-code = locked_fin-doc.host-code
     5404         AND buf_fin-doc-tax.fin-doc-code = locked_fin-doc.fin-doc-code
     5405         :
     5406         create tt0-fin-doc-tax.
     5407         buffer-copy buf_fin-doc-tax except fin-doc-code to tt0-fin-doc-tax
     5408           assign
     5409           tt0-fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     5410           .
     5411       end.
     5412       for each buf_payment no-lock where
     5413         buf_payment.source-type = 'платеж':U
     5414         AND buf_payment.source-ref = string(locked_fin-doc.fin-doc-code)
     5415         :
     5416         create tt0-payment.
     5417         buffer-copy buf_payment except source-ref to tt0-payment
     5418           assign
     5419           tt0-payment.source-ref = string(tt-fin-doc.fin-doc-code)
     5420           .
     5421       end.
     5422       for each buf_fin-doc-attr no-lock where
     5423         buf_fin-doc-attr.host-code = locked_fin-doc.host-code
     5424         AND buf_fin-doc-attr.fin-doc-code = locked_fin-doc.fin-doc-code
     5425         :
     5426         create tt0-fin-doc-attr.
     5427         buffer-copy buf_fin-doc-attr to tt0-fin-doc-attr
     5428           assign
     5429           tt0-fin-doc-attr.fin-doc-code = tt-fin-doc.fin-doc-code
     5430           .
     5431       end.
     5432     end.
     5433     else
     5434     do:
     5435       for each buf_fin-doc-tax no-lock where
     5436         buf_fin-doc-tax.host-code = tt-fin-doc.host-code
     5437         AND buf_fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     5438         :
     5439         create tt0-fin-doc-tax.
     5440         buffer-copy buf_fin-doc-tax to tt0-fin-doc-tax.
     5441       end.
     5442       for each buf_payment no-lock where
     5443         buf_payment.source-type = 'платеж':U
     5444         AND buf_payment.source-ref = string(tt-fin-doc.fin-doc-code)
     5445         :
     5446         create tt0-payment.
     5447         buffer-copy buf_payment to tt0-payment.
     5448       end.
     5449       for each buf_fin-doc-attr no-lock where
     5450         buf_fin-doc-attr.host-code = tt-fin-doc.host-code
     5451         AND buf_fin-doc-attr.fin-doc-code = tt-fin-doc.fin-doc-code
     5452         :
     5453         create tt0-fin-doc-attr.
     5454         buffer-copy buf_fin-doc-attr to tt0-fin-doc-attr.
     5455       end.
     5456       for each tt0-fin-doc-attr no-lock where
     5457         tt0-fin-doc-attr.host-code = tt-fin-doc.host-code
     5458         AND tt0-fin-doc-attr.fin-doc-code = tt-fin-doc.fin-doc-code
     5459         :
     5460       end.
     5461     end.
     5462   if (valid-handle(g#lib-farh) <> true) then do:   run str/lib-farh.p persistent no-error .   if error-status :error or (valid-handle(g#lib-farh) <> true) then do:     message       "Error starting lib-farh.p" skip       g#lib-farh skip       g#lib-farh :type skip       g#lib-farh :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-farh_fautoobj in g#lib-farh
     5463   (input tt-fin-doc.host-code
     5464   ,input tt-fin-doc.fin-doc-code
     5465   ,output v-is-auto-obj
     5466   )
     5467   .
     5468     if getCliKassa(tt-fin-doc.payer-type, tt-fin-doc.payer-code, "Vnecli", tt-fin-doc.cashbookId) then paramVne = "vne" .
     5469     else if getCliKassa(tt-fin-doc.payer-type, tt-fin-doc.payer-code, "Avanscli", tt-fin-doc.cashbookId) then paramVne = "avans" .
     5470     else paramVne = "" .
     5471     run proc-update-sum-vat-chr in this-procedure (input-output v-start).
     5472   END PROCEDURE.
     5473   PROCEDURE hide-view-currency :
     5474     define buffer buf_currency for ub.currency.
     5475     assign
     5476       v-rubf          = no
     5477       v-exchf         = no
     5478       v-basef         = no
     5479       v-baseratef     = no
     5480       v-contractf     = no
     5481       v-contractratef = no
     5482       .
     5483     hide
     5484       tt-fin-doc.sum-rubl in frame Dialog-Frame
     5485       tt-fin-doc.exch-rate
     5486       tt-fin-doc.exch-scale
     5487       tt-fin-doc.sum-base
     5488       tt-fin-doc.base-rate
     5489       tt-fin-doc.base-scale
     5490       tt-fin-doc.sum-contr
     5491       tt-fin-doc.contract-rate
     5492       tt-fin-doc.contract-scale
     5493       in frame Dialog-Frame .
     5494     if tt-fin-doc.curr-code <> 0 then
     5495     do:
     5496       if tt-fin-doc.curr-code:visible then
     5497         display
     5498           tt-fin-doc.exch-rate
     5499           tt-fin-doc.exch-scale
     5500           tt-fin-doc.sum-rubl
     5501           with frame Dialog-Frame.
     5502       assign
     5503         v-rubf  = yes
     5504         v-exchf = yes
     5505         .
     5506     end.
     5507     if v-base-code <> tt-fin-doc.curr-code
     5508       and v-base-code <> 0
     5509       then
     5510     do:
     5511       find first buf_currency no-lock where
     5512         buf_currency.curr-code = v-base-code .
     5513       assign
     5514         tt-fin-doc.sum-base:label = "Б.в.("  + buf_currency.curr-abbr + ")":U
     5515         .
     5516       if tt-fin-doc.curr-code:visible then
     5517         display
     5518           tt-fin-doc.base-rate
     5519           tt-fin-doc.base-scale
     5520           tt-fin-doc.sum-base
     5521           with frame Dialog-Frame.
     5522       assign
     5523         v-basef     = yes
     5524         v-baseratef = yes
     5525         .
     5526     end.
     5527     if tt-fin-doc.contract-code  <> 0 and
     5528       (tt-fin-doc.contract-curr <> 0
     5529       and tt-fin-doc.contract-curr <> tt-fin-doc.curr-code
     5530       and tt-fin-doc.contract-curr <> v-base-code
     5531       )
     5532       then
     5533     do:
     5534       find first buf_currency no-lock where
     5535         buf_currency.curr-code = tt-fin-doc.contract-curr .
     5536       assign
     5537         tt-fin-doc.sum-contr:label = "Вал.дог.("  + buf_currency.curr-abbr + ")":U
     5538         .
     5539       if tt-fin-doc.curr-code:visible then
     5540         display
     5541           tt-fin-doc.sum-contr
     5542           tt-fin-doc.contract-rate
     5543           tt-fin-doc.contract-scale
     5544           with frame Dialog-Frame.
     5545       assign
     5546         v-contractf     = yes
     5547         v-contractratef = yes
     5548         .
     5549     end.
     5550     assign
     5551       v-sum-curr-tab-order = v-sum-doc-tab-order
     5552       .
     5553     run disable-enable in this-procedure (v-main-sum, v-main-curr).
     5554   END PROCEDURE.
     5555   PROCEDURE recalc :
     5556     define input parameter p-main-widget as character no-undo.
     5557     define variable v-curr-abbr      like ub.currency.curr-abbr no-undo.
     5558     define variable v-contract-rate  like ub.fin-doc.exch-rate no-undo.
     5559     define variable v-contract-scale like ub.fin-doc.exch-scale no-undo.
     5560     if p-main-widget = "curr-code":u then
     5561     do:
     5562       assign
     5563         frame Dialog-Frame
     5564         tt-fin-doc.sum-doc
     5565         .
     5566   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5567   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     5568     (input  tt-fin-doc.host-code
     5569     ,input  tt-fin-doc.doc-date
     5570     ,output tt-fin-doc.base-rate
     5571     ,output tt-fin-doc.base-scale
     5572     )  .
     5573   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5574   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     5575     (input  tt-fin-doc.curr-code
     5576     ,input  tt-fin-doc.doc-date
     5577     ,output tt-fin-doc.exch-rate
     5578     ,output tt-fin-doc.exch-scale
     5579     ,output v-curr-abbr
     5580     )  .
     5581   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5582   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     5583     (input  tt-fin-doc.contract-curr
     5584     ,input  tt-fin-doc.doc-date
     5585     ,output tt-fin-doc.contract-rate
     5586     ,output tt-fin-doc.contract-scale
     5587     ,output v-curr-abbr
     5588     )  .
     5589       if tt-fin-doc.curr-code <> 0
     5590         or tt-fin-doc.curr-code <> v-base-code
     5591         or tt-fin-doc.curr-code <> tt-fin-doc.contract-curr
     5592         then
     5593       do:
     5594         if tt-fin-doc.curr-code <> 0 then
     5595           display
     5596             tt-fin-doc.exch-rate
     5597             tt-fin-doc.exch-scale
     5598             with frame Dialog-Frame.
     5599         assign
     5600           p-main-widget = "sum-doc":U.
     5601       end.
     5602     end.
     5603     if p-main-widget  = "doc-date":U then
     5604     do:
     5605       assign
     5606         frame Dialog-Frame
     5607         tt-fin-doc.sum-doc
     5608         .
     5609   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5610   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     5611     (input  tt-fin-doc.host-code
     5612     ,input  tt-fin-doc.doc-date
     5613     ,output tt-fin-doc.base-rate
     5614     ,output tt-fin-doc.base-scale
     5615     )  .
     5616   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5617   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     5618     (input  tt-fin-doc.curr-code
     5619     ,input  tt-fin-doc.doc-date
     5620     ,output tt-fin-doc.exch-rate
     5621     ,output tt-fin-doc.exch-scale
     5622     ,output v-curr-abbr
     5623     )  .
     5624   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5625   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     5626     (input  tt-fin-doc.contract-curr
     5627     ,input  tt-fin-doc.doc-date
     5628     ,output tt-fin-doc.contract-rate
     5629     ,output tt-fin-doc.contract-scale
     5630     ,output v-curr-abbr
     5631     )  .
     5632       if tt-fin-doc.base-rate:visible in frame Dialog-Frame then
     5633       do:
     5634         display
     5635           tt-fin-doc.base-rate
     5636           tt-fin-doc.base-scale
     5637           with frame Dialog-Frame.
     5638         assign
     5639           p-main-widget = "sum-doc":U.
     5640       end.
     5641       if tt-fin-doc.exch-rate:visible in frame Dialog-Frame then
     5642       do:
     5643         display
     5644           tt-fin-doc.exch-rate
     5645           tt-fin-doc.exch-scale
     5646           with frame Dialog-Frame.
     5647         assign
     5648           p-main-widget = "sum-doc":U.
     5649       end.
     5650       if tt-fin-doc.contract-rate:visible in frame Dialog-Frame then
     5651       do:
     5652         display
     5653           tt-fin-doc.contract-rate
     5654           tt-fin-doc.contract-scale
     5655           with frame Dialog-Frame.
     5656         assign
     5657           p-main-widget = "sum-doc":U.
     5658       end.
     5659     end.
     5660     CASE p-main-widget:
     5661       when "sum-doc" then
     5662         do:
     5663           assign
     5664             frame Dialog-Frame
     5665             tt-fin-doc.exch-rate
     5666             tt-fin-doc.exch-scale
     5667             tt-fin-doc.sum-doc
     5668             .
     5669           CASE tt-fin-doc.curr-code:
     5670             when 0 then
     5671               do:
     5672                 assign
     5673                   tt-fin-doc.sum-rubl = tt-fin-doc.sum-doc
     5674                   tt-fin-doc.sum-base = tt-fin-doc.sum-doc / tt-fin-doc.base-rate * tt-fin-doc.base-scale
     5675                   tt-fin-doc.sum-contr = (if tt-fin-doc.contract-curr = 0                                                       then tt-fin-doc.sum-rubl                                                       else tt-fin-doc.sum-rubl / (tt-fin-doc.contract-rate / tt-fin-doc.contract-scale)                                                     )
     5676                   .
     5677               end.
     5678             when v-base-code then
     5679               do:
     5680                 assign
     5681                   tt-fin-doc.sum-rubl = tt-fin-doc.sum-doc * tt-fin-doc.exch-rate / tt-fin-doc.exch-scale
     5682                   tt-fin-doc.sum-base = tt-fin-doc.sum-rubl / tt-fin-doc.base-rate * tt-fin-doc.base-scale
     5683                   tt-fin-doc.sum-contr = (if tt-fin-doc.contract-curr = 0                                                       then tt-fin-doc.sum-rubl                                                       else tt-fin-doc.sum-rubl / (tt-fin-doc.contract-rate / tt-fin-doc.contract-scale)                                                     )
     5684                   .
     5685               end.
     5686             otherwise
     5687             do:
     5688               assign
     5689                 tt-fin-doc.sum-rubl = tt-fin-doc.sum-doc * tt-fin-doc.exch-rate / tt-fin-doc.exch-scale
     5690                 tt-fin-doc.sum-base = tt-fin-doc.sum-rubl / tt-fin-doc.base-rate * tt-fin-doc.base-scale
     5691                 tt-fin-doc.sum-contr = (if tt-fin-doc.contract-curr = 0                                                       then tt-fin-doc.sum-rubl                                                       else tt-fin-doc.sum-rubl / (tt-fin-doc.contract-rate / tt-fin-doc.contract-scale)                                                     )
     5692                 .
     5693             end.
     5694           END CASE.
     5695         end.
     5696     END CASE.
     5697     assign
     5698       f-rest-con-sum = tt-fin-doc.sum-contr - tt-fin-doc.con-sum-contr
     5699       .
     5700     display
     5701       f-rest-con-sum
     5702       with frame Dialog-Frame.
     5703     if tt-fin-doc.sum-doc:visible in frame Dialog-Frame then
     5704       display
     5705         tt-fin-doc.sum-doc
     5706         tt-fin-doc.curr-code
     5707         with frame Dialog-Frame.
     5708     if tt-fin-doc.sum-rubl:visible in frame Dialog-Frame then
     5709       display
     5710         tt-fin-doc.sum-rubl
     5711         tt-fin-doc.exch-rate
     5712         tt-fin-doc.exch-scale
     5713         with frame Dialog-Frame.
     5714     if tt-fin-doc.sum-base:visible in frame Dialog-Frame then
     5715       display
     5716         tt-fin-doc.sum-base
     5717         tt-fin-doc.base-rate
     5718         tt-fin-doc.base-scale
     5719         with frame Dialog-Frame.
     5720     if tt-fin-doc.sum-contr:visible in frame Dialog-Frame then
     5721       display
     5722         tt-fin-doc.sum-contr
     5723         tt-fin-doc.contract-rate
     5724         tt-fin-doc.contract-scale
     5725         with frame Dialog-Frame.
     5726     if not v-first-start then
     5727       run proc-update-sum-vat-chr in this-procedure (input-output v-start).
     5728   END PROCEDURE.
     5729   procedure proc-create-default-tax :
     5730     do
     5731       on error undo, return error
     5732       :
     5733       If p-mode = 'ДОБАВЛЕНИЕ':U then
     5734       do:
     5735         if p-ob-doc-code = "" then
     5736         do:
     5737           find tt0-fin-doc-tax where
     5738             tt0-fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     5739             AND tt0-fin-doc-tax.host-code = tt-fin-doc.host-code no-error .
     5740           if not avail tt0-fin-doc-tax
     5741             and not AMBIGUOUS tt0-fin-doc-tax
     5742             then
     5743           do:
     5744             create tt0-fin-doc-tax.
     5745           end.
     5746           if AMBIGUOUS tt0-fin-doc-tax then return.
     5747           assign
     5748             tt0-fin-doc-tax.fin-doc-code     = tt-fin-doc.fin-doc-code
     5749             tt0-fin-doc-tax.host-code        = tt-fin-doc.host-code
     5750             tt0-fin-doc-tax.line-num         = 1
     5751             tt0-fin-doc-tax.slt-pc           = 0
     5752             tt0-fin-doc-tax.sum-line-doc     = tt-fin-doc.sum-doc
     5753             tt0-fin-doc-tax.sum-slt-line-doc = 0
     5754             tt0-fin-doc-tax.with-slt         = no
     5755             .
     5756           case paramVne:
     5757             when "vne" then do:
     5758             assign
     5759               tt0-fin-doc-tax.sum-vat-line-doc = 0
     5760               tt0-fin-doc-tax.vat-pc           = -1
     5761               tt0-fin-doc-tax.with-vat         = no
     5762               .
     5763             end.
     5764             when "avans" then do:
     5765             assign
     5766               tt0-fin-doc-tax.vat-pc           = 22
     5767               tt0-fin-doc-tax.sum-vat-line-doc = (tt-fin-doc.sum-doc * tt0-fin-doc-tax.vat-pc)/(100 + tt0-fin-doc-tax.vat-pc)
     5768               tt0-fin-doc-tax.with-vat         = yes
     5769               .
     5770             end.
     5771             otherwise do:
     5772             assign
     5773               tt0-fin-doc-tax.sum-vat-line-doc = 0
     5774               tt0-fin-doc-tax.vat-pc           = 0
     5775               tt0-fin-doc-tax.with-vat         = no
     5776               .
     5777             end.
     5778           end case .
     5779           release tt0-fin-doc-tax.
     5780         end.
     5781       end.
     5782     end.
     5783   end procedure.
     5784   procedure proc-update-sum-vat-chr :
     5785     define input-output parameter p-start as integer no-undo .
     5786     define variable v-sum-vat      like ub.fin-doc-tax.sum-vat-line-doc no-undo .
     5787     define variable v-sum-vat-chr  as character no-undo .
     5788     define variable v-each-vat-chr as character no-undo.
     5789     define variable v-vat-pc       as integer no-undo .
     5790     do
     5791       on error undo, return error
     5792       :
     5793       for each tt0-fin-doc-tax no-lock where
     5794         tt0-fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     5795         AND tt0-fin-doc-tax.host-code = tt-fin-doc.host-code:
     5796         do:
     5797           if tt0-fin-doc-tax.with-vat then
     5798           do:
     5799             v-vat-pc = tt0-fin-doc-tax.vat-pc .
     5800             if paramVne <> "avans" then
     5801             do:
     5802               v-each-vat-chr = v-each-vat-chr +
     5803                 substitute (" &1% = &2;"
     5804                 , string(tt0-fin-doc-tax.vat-pc)
     5805                 , string(truncate(tt0-fin-doc-tax.sum-vat-line-doc, 0)) + chr(32) +  "руб." + chr(32) +
     5806                 (if tt0-fin-doc-tax.sum-vat-line-doc <> truncate(tt0-fin-doc-tax.sum-vat-line-doc, 0)
     5807                 then (string(100 * round(tt0-fin-doc-tax.sum-vat-line-doc - truncate(tt0-fin-doc-tax.sum-vat-line-doc, 0), 2))  + chr(32) + "коп.")
     5808                 else "":U)).
     5809             end.
     5810             else
     5811             do:
     5812               v-each-vat-chr = v-each-vat-chr +
     5813                 substitute (" = &1;"
     5814                 , string(truncate(tt0-fin-doc-tax.sum-vat-line-doc, 0)) + chr(32) +  "руб." + chr(32) +
     5815                 (if tt0-fin-doc-tax.sum-vat-line-doc <> truncate(tt0-fin-doc-tax.sum-vat-line-doc, 0)
     5816                 then (string(100 * round(tt0-fin-doc-tax.sum-vat-line-doc - truncate(tt0-fin-doc-tax.sum-vat-line-doc, 0), 2))  + chr(32) + "коп.")
     5817                 else "":U)).
     5818             end.
     5819           end.
     5820           v-sum-vat = v-sum-vat +
     5821             (if tt0-fin-doc-tax.with-vat then tt0-fin-doc-tax.sum-vat-line-doc else 0).
     5822         end.
     5823       end.
     5824       if tt-fin-doc.curr-code = 0 then
     5825       do:
     5826         case paramVne :
     5827         when "vne" then do:
     5828         if v-vat-pc > 0 then do:
     5829           v-sum-vat-chr = "в том числе НДС" + right-trim (v-each-vat-chr , ";").
     5830         end .
     5831         else
     5832         assign
     5833           v-sum-vat-chr = "в т.ч. без налога (НДС)"
     5834           .
     5835         end.
     5836         when "avans" then do:
     5837           if v-vat-pc <> 0 then v-sum-vat-chr = "в т.ч. " + string(v-vat-pc) + "/" + string(100 + v-vat-pc) + " (НДС)" + right-trim (v-each-vat-chr , ";").
     5838           else v-sum-vat-chr = "в т.ч. 22/122 (НДС)" + right-trim (v-each-vat-chr , ";").
     5839         end.
     5840         otherwise do:
     5841           v-sum-vat-chr = "в том числе НДС" + right-trim (v-each-vat-chr , ";").
     5842         end.
     5843       end case .
     5844       end.
     5845       else
     5846       do:
     5847         assign
     5848           v-sum-vat-chr = "в том числе НДС" + chr(32) +
     5849                         string(v-sum-vat)
     5850           .
     5851       end.
     5852       if p-start = 0 then
     5853         assign
     5854           frame Dialog-Frame
     5855           tt-fin-doc.including
     5856           .
     5857       if p-start = 1 then p-start = 0.
     5858       if num-entries(tt-fin-doc.including, "@":U) < 2 and p-start = 2 then
     5859       do:
     5860         assign
     5861           tt-fin-doc.including = tt-fin-doc.including + "@" +
     5862                                     (if tt-fin-doc.including = "":U
     5863                                     then "":U
     5864                                     else (chr(44) + chr(32) )
     5865                                     ) +
     5866                                     v-sum-vat-chr.
     5867       end.
     5868       if num-entries(tt-fin-doc.including, "@":U) > 1 then
     5869       do:
     5870         assign
     5871           entry(2, tt-fin-doc.including, "@":U) = chr(44) + chr(32)  + v-sum-vat-chr.
     5872       end.
     5873       display
     5874         tt-fin-doc.including
     5875         with frame Dialog-Frame .
     5876       if p-start = 2 then p-start = 0.
     5877     end.
     5878   end procedure.
     5879   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5880   on help of frame Dialog-Frame
     5881   do:
     5882     run gbl/app_help.p
     5883       (input this-procedure :file-name
     5884       ,input ''
     5885       ,input ?
     5886       ) no-error.
     5887     if error-status :error then do:
     5888       message
     5889         "Ошибка при вызове помощи"
     5890         error-status :get-message(1)
     5891         view-as alert-box .
     5892     end.
     5893   end.
     5894   run minbtn-set in this-procedure .
     5895   on choose of b-help in frame Dialog-Frame
     5896   do:
     5897     apply "help":u to frame Dialog-Frame .
     5898   end.
     5899   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5900   procedure minbtn-set :
     5901       do
     5902           on error undo, return error return-value
     5903           :
     5904           define variable ii              as integer       no-undo .
     5905           define variable fh              as widget-handle no-undo .
     5906           define variable hh              as widget-handle no-undo .
     5907           define variable v-h             as handle        extent 4 no-undo .
     5908           define variable v-name-button   as character     no-undo .
     5909           define variable v-help-old-x    as decimal       no-undo .
     5910           define variable v-help-old-y    as decimal       no-undo .
     5911           define variable v-help-old-size as decimal       no-undo .
     5912           define variable v-frame-width   as decimal       no-undo .
     5913           define variable jj              as integer       no-undo .
     5914           do
     5915               on error undo, return error
     5916               :
     5917               assign
     5918                   v-frame-width = frame Dialog-Frame:width - 0.3
     5919                   fh            = frame Dialog-Frame:first-child
     5920                   hh            = fh:first-child
     5921                   ii            = 1
     5922                   .
     5923               do while valid-handle(hh):
     5924                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     5925                   do:
     5926                       case lc(hh:name) :
     5927                           when "b-help" then
     5928                               do:
     5929                                   hh:load-image-up("cmp/b-help.bmp":u) .
     5930                                   hh:load-image-down("cmp/b-help.bmp":u) .
     5931                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     5932                                   hh:TOOLTIP = "Помощь" .
     5933                                   v-help-old-x = hh:column .
     5934                                   v-help-old-y = hh:row    .
     5935                                   v-help-old-size = hh:width .
     5936                                   hh:width-chars = 2.5 .
     5937                               end.
     5938                           when "b-print" then
     5939                               do:
     5940                                   hh:load-image("cmp/b-print.bmp":u) .
     5941                                   hh:TOOLTIP = "Печать" .
     5942                                   v-h[ii] = hh:handle .
     5943                                   ii = ii + 1 .
     5944                                   hh:width-chars = 3 .
     5945                               end.
     5946                           when "b-history" or
     5947                           when "b-hist" then
     5948                               do:
     5949                                   hh:load-image("cmp/b-hist.bmp":u) .
     5950                                   hh:TOOLTIP = "История" .
     5951                                   v-h[ii] = hh:handle .
     5952                                   ii = ii + 1 .
     5953                                   hh:width-chars = 3 .
     5954                               end.
     5955                           when "b-sch" then
     5956                               do:
     5957                                   hh:load-image("cmp/b-sch.bmp":u) .
     5958                                   hh:TOOLTIP = "Установка Фильтра" .
     5959                                   v-h[ii] = hh:handle .
     5960                                   ii = ii + 1 .
     5961                                   hh:width-chars = 3 .
     5962                               end.
     5963                           when "b-hist-user" then
     5964                               do:
     5965                                   hh:load-image("cmp/b-hist.bmp":u) .
     5966                                   hh:TOOLTIP = "История пользователя" .
     5967                                   ii = ii + 1 .
     5968                               end.
     5969                       end case.
     5970                   end.
     5971                   hh = hh:next-sibling.
     5972               end.
     5973               b-help:column = v-frame-width - b-help:width-chars.
     5974               jj = 0.
     5975               repeat ii = 4 to 1 by -1 :
     5976                   if valid-handle (v-h[ii] ) then
     5977                   do:
     5978                       jj  = jj + 1 .
     5979                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     5980                       v-h[ii]:row    = v-help-old-y .
     5981                   end.
     5982               end.
     5983           end.
     5984       end.
     5985   end procedure.
     5986   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5987   ON TAB ANYWHERE
     5988   DO:
     5989   define variable ii as integer no-undo .
     5990   define variable fh as widget-handle no-undo .
     5991   define variable hh as widget-handle no-undo .
     5992   define variable v-next-widget-name as character no-undo .
     5993   if v-tab-order <> '' then do:
     5994     if self:type = "TOGGLE-BOX" then
     5995     self:BGCOLOR = ?.
     5996     assign
     5997     ii = lookup(self:name, v-tab-order).
     5998     assign
     5999     ii = ii + 1
     6000     v-next-widget-name = entry(ii, v-tab-order)
     6001     no-error .
     6002     if error-status:error then do:
     6003       assign
     6004       ii = 1
     6005       v-next-widget-name = entry( ii, v-tab-order)
     6006       .
     6007     end.
     6008     assign
     6009     fh = frame Dialog-Frame:first-child
     6010     hh = fh:first-child
     6011     .
     6012     do while valid-handle(hh):
     6013       if hh:name = v-next-widget-name then do:
     6014         if hh:sensitive  = yes
     6015         AND hh:visible = yes then do:
     6016           if hh:type = "TOGGLE-BOX":U then do:
     6017             assign
     6018             hh:BGcolor = 1
     6019             .
     6020           end.
     6021           APPLY "ENTRY" to hh.
     6022           return no-apply.
     6023         end.
     6024         else do:
     6025           APPLY "TAB" to hh.
     6026           return no-apply.
     6027         end.
     6028       end.
     6029       hh = hh:next-sibling.
     6030     end.
     6031   end.
     6032   END.
     6033   ON BACK-TAB ANYWHERE
     6034   DO:
     6035   define variable ii as integer no-undo .
     6036   define variable fh as widget-handle no-undo .
     6037   define variable hh as widget-handle no-undo .
     6038   define variable v-next-widget-name as character no-undo .
     6039   if v-tab-order <> '' then do:
     6040     assign
     6041     ii = lookup(self:name, v-tab-order).
     6042     .
     6043     assign
     6044     ii = (if ii = 1
     6045           then  num-entries(v-tab-order)
     6046           else ii - 1
     6047           )
     6048     v-next-widget-name = entry(ii, v-tab-order)
     6049     .
     6050     assign
     6051     fh = frame Dialog-Frame:first-child
     6052     hh = fh:first-child
     6053     .
     6054     do while valid-handle(hh):
     6055       if hh:name = v-next-widget-name then do:
     6056         if hh:sensitive  = yes
     6057         AND hh:visible = yes then do:
     6058           if hh:type = "TOGGLE-BOX":U then do:
     6059             assign
     6060             hh:BGcolor = 1
     6061             .
     6062           end.
     6063           APPLY "ENTRY" to hh.
     6064           return no-apply.
     6065         end.
     6066         else do:
     6067         APPLY "BACK-TAB" to hh.
     6068         return no-apply.
     6069         end.
     6070       end.
     6071       hh = hh:next-sibling.
     6072     end.
     6073     end.
     6074   END.
     6075   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6076   ON RETURN ANYWHERE
     6077   DO:
     6078   define variable ii as integer no-undo .
     6079   define variable fh as widget-handle no-undo .
     6080   define variable hh as widget-handle no-undo .
     6081   define variable v-next-widget-name as character no-undo .
     6082     if v-tab-order <> '' then do:
     6083       assign
     6084       ii = lookup(self:name, v-tab-order).
     6085       if ii = num-entries(v-tab-order) then do:
     6086           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     6087           return no-apply.
     6088       end.
     6089       if self:type <> "BUTTON" and
     6090         self:type <> "EDITOR"  then do:
     6091         run proc-move-forward in this-procedure .
     6092         return no-apply.
     6093       end.
     6094       if self:type = "BUTTON" then do:
     6095         APPLY "CHOOSE" to self.
     6096       end.
     6097       if self:type = "TOGGLE-BOX" then
     6098       self:BGCOLOR = ?.
     6099       assign
     6100       ii = ii + 1
     6101       v-next-widget-name = entry(ii, v-tab-order)
     6102       no-error .
     6103       if error-status:error then do:
     6104         assign
     6105         ii = 1
     6106         v-next-widget-name = entry( ii, v-tab-order)
     6107         .
     6108       end.
     6109       assign
     6110       fh = frame Dialog-Frame:first-child
     6111       hh = fh:first-child
     6112       .
     6113       do while valid-handle(hh):
     6114         if hh:name = v-next-widget-name then do:
     6115           if hh:sensitive  = yes
     6116           AND hh:visible = yes then do:
     6117             if hh:type = "TOGGLE-BOX":U then do:
     6118               assign
     6119               hh:BGcolor = 1
     6120               .
     6121             end.
     6122             APPLY "ENTRY" to hh.
     6123             return no-apply.
     6124           end.
     6125           else do:
     6126             APPLY "TAB" to hh.
     6127             return no-apply.
     6128           end.
     6129         end.
     6130         hh = hh:next-sibling.
     6131       end.
     6132     end.
     6133   END.
     6134   procedure proc-move-forward :
     6135   define variable ii as integer no-undo .
     6136   define variable fh as widget-handle no-undo .
     6137   define variable hh as widget-handle no-undo .
     6138   define variable v-next-widget-name as character no-undo .
     6139   do
     6140   on error undo, return error
     6141   :
     6142     if v-tab-order <> '' then do:
     6143       if self:type = "TOGGLE-BOX" then
     6144       self:BGCOLOR = ?.
     6145       assign
     6146       ii = lookup(self:name, v-tab-order).
     6147       assign
     6148       ii = ii + 1
     6149       v-next-widget-name = entry(ii, v-tab-order)
     6150       no-error .
     6151       if error-status:error then do:
     6152         assign
     6153         ii = 1
     6154         v-next-widget-name = entry( ii, v-tab-order)
     6155         .
     6156       end.
     6157       assign
     6158       fh = frame Dialog-Frame:first-child
     6159       hh = fh:first-child
     6160       .
     6161       do while valid-handle(hh):
     6162         if hh:name = v-next-widget-name then do:
     6163           if hh:sensitive  = yes
     6164           AND hh:visible = yes then do:
     6165             if hh:type = "TOGGLE-BOX":U then do:
     6166               assign
     6167               hh:BGcolor = 1
     6168               .
     6169             end.
     6170             APPLY "ENTRY" to hh.
     6171             return.
     6172           end.
     6173           else do:
     6174             assign
     6175             ii = ii + 1
     6176             v-next-widget-name = entry(ii, v-tab-order)
     6177             no-error .
     6178             if error-status:error then do:
     6179               assign
     6180               ii = 1
     6181               v-next-widget-name = entry( ii, v-tab-order)
     6182               .
     6183             end.
     6184           end.
     6185         end.
     6186         hh = hh:next-sibling.
     6187       end.
     6188     end.
     6189   end.
     6190   end procedure.
