     6765    define variable mCounterStor as class ibs.th.ref.counter.counterstorage.
     6766    mCounterStor = new ibs.th.ref.counter.counterstorage().
     6767    oCount = mCounterStor:GetCountValue(G#db-num,"cashbookrule", current-ruleID, current-pko-rko ) + 1.
     6768    delete object mCounterStor.
     6769   end procedure.
     6770   PROCEDURE MycounterNext :
     6771   define input  parameter iFileName as character no-undo.
