     2579   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     2580   DO:
     2581   define variable v-format as integer no-undo .
     2582   define variable v-log as logical no-undo .
     2583   define variable v-cmp as character no-undo .
     2584   buffer-compare tt-fin-doc to locked_fin-doc
     2585   case-sensitive
     2586   save result in v-cmp .
     2587   if v-cmp <> "":U then do:
     2588     message
     2589     "Вы изменили ПЛАТЕЖ, но не сохранили его" skip
     2590     "сохранить перед печатью?"
     2591     view-as alert-box QUESTION buttons YES-NO update v-log.
     2592   end.
     2593   run proc-save in this-procedure (v-log) no-error.
     2594   run ref/fdoc-prn.p (
     2595           input parparentproc
     2596         , input this-procedure
     2597         , input string(recid(locked_fin-doc))
     2598                         ) no-error.
     2599   if error-status:error then return no-apply.
     2600   END.
     2601   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2602   procedure proc-color-widgets :
     2603   define input parameter p-list as character no-undo .
     2604   define input parameter p-fg as logical no-undo .
     2605   define input parameter p-bg as logical no-undo .
     2606   define input parameter p-fgc as integer no-undo .
     2607   define input parameter p-bgc as integer no-undo .
     2608   define variable ii as integer no-undo .
     2609   define variable fh as widget-handle no-undo .
     2610   define variable hh as widget-handle no-undo .
     2611     do
     2612     on error undo, return error
     2613     :
     2614       assign
     2615       fh = frame Dialog-Frame:first-child
     2616       hh = fh:first-child
     2617       .
     2618       do while valid-handle(hh):
     2619         if LOOKUP(hh:name, p-list) > 0  then do:
     2620           assign
     2621           hh:fgcolor = (if p-fg then p-fgc else hh:fgcolor)
     2622           hh:bgcolor = (if p-bg then p-bgc else hh:bgcolor)
     2623           .
     2624         end.
     2625         hh = hh:next-sibling.
     2626       end.
     2627     end.
     2628   end procedure.
     2629   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile: findocip.i $ $Revision: ff8019e24d02, 2996, rls $".
     2630   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2631   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2632   procedure set-buffers :
     2633     DEFINE input parameter X_clients-host-recid as recid no-undo .
     2634     DEFINE input parameter X_firm-recid as recid no-undo .
     2635     DEFINE input parameter X_sysconf-recid as recid no-undo .
     2636     define input parameter X_fin-code-cor-acc-recid as recid no-undo .
     2637     define input parameter X_fin-code-cor-acc1-recid as recid no-undo .
     2638     define input parameter X_fin-code-an-uchet-recid as recid no-undo .
     2639     define input parameter X_fin-code-cel-nazn-recid as recid no-undo .
     2640     define input parameter X_currency-recid as recid no-undo .
     2641     define input parameter X_contract-currency-recid as recid no-undo .
     2642     DEFINE input parameter X_receiver-recid as recid no-undo .
     2643     DEFINE input parameter X_payer-recid as recid no-undo .
     2644     define input parameter X_curr_sysconf-recid as recid no-undo .
     2645     define input parameter X_payer-fin-schet-recid as recid no-undo .
     2646     define input parameter X_payer-fin-bank-recid as recid no-undo .
     2647     define input parameter X_payer-firm-recid as recid no-undo .
     2648     define input parameter X_payer-person-recid as recid no-undo .
     2649     define input parameter X_receiver-fin-schet-recid as recid no-undo .
     2650     define input parameter X_receiver-fin-bank-recid as recid no-undo .
     2651     define input parameter X_receiver-firm-recid as recid no-undo .
     2652     define input parameter X_receiver-person-recid as recid no-undo .
     2653     define input parameter X_contract-recid as recid no-undo .
     2654     define input parameter X_fin-ob-recid as recid no-undo .
     2655     define input parameter X_clients-obj-recid as recid no-undo .
     2656     define input parameter p-f-cor-acc1-descr as character no-undo .
     2657     define input parameter p-f-cor-acc-descr as character no-undo .
     2658     define input parameter p-f-an-uchet-descr as character no-undo .
     2659     define input parameter p-f-cel-nazn-descr as character no-undo .
     2660     do
     2661       on error undo, return error
     2662       :
     2663       find first X_clients-host no-lock where                   recid(X_clients-host)          = X_clients-host-recid no-error  .
     2664       find first X_firm no-lock where                           recid(X_firm)                  = X_firm-recid no-error .
     2665       find first X_sysconf no-lock where                        recid(X_sysconf)               = X_sysconf-recid no-error .
     2666       find first X_fin-code-cor-acc no-lock where               recid(X_fin-code-cor-acc)      = X_fin-code-cor-acc-recid no-error .
     2667       find first X_fin-code-cor-acc1 no-lock where              recid(X_fin-code-cor-acc1)     = X_fin-code-cor-acc1-recid no-error .
     2668       find first X_fin-code-an-uchet no-lock where              recid(X_fin-code-an-uchet)     = X_fin-code-an-uchet-recid no-error .
     2669       find first X_fin-code-cel-nazn no-lock where              recid(X_fin-code-cel-nazn)     = X_fin-code-cel-nazn-recid no-error .
     2670       find first X_currency no-lock where                       recid(X_currency)              = X_currency-recid no-error .
     2671       find first X_contract-currency no-lock where              recid(X_contract-currency)     = X_contract-currency-recid no-error .
     2672       find first X_receiver no-lock where                       recid(X_receiver)              = X_receiver-recid no-error .
     2673       find first X_payer no-lock where                          recid(X_payer)                 = X_payer-recid no-error .
     2674       find first X_curr_sysconf no-lock where                   recid(X_curr_sysconf)          = X_curr_sysconf-recid no-error .
     2675       find first X_payer-fin-schet no-lock where                recid(X_payer-fin-schet)       = X_payer-fin-schet-recid no-error .
     2676       find first X_payer-fin-bank no-lock where                 recid(X_payer-fin-bank)        = X_payer-fin-bank-recid no-error .
     2677       find first X_payer-firm no-lock where                     recid(X_payer-firm)            = X_payer-firm-recid no-error .
     2678       find first X_payer-person no-lock where                   recid(X_payer-person)          = X_payer-person-recid no-error .
     2679       find first X_receiver-fin-schet no-lock where             recid(X_receiver-fin-schet)    = X_receiver-fin-schet-recid no-error .
     2680       find first X_receiver-fin-bank no-lock where              recid(X_receiver-fin-bank)     = X_receiver-fin-bank-recid no-error .
     2681       find first X_receiver-firm no-lock where                  recid(X_receiver-firm)         = X_receiver-firm-recid no-error .
     2682       find first X_receiver-person no-lock where                recid(X_receiver-person)       = X_receiver-person-recid no-error .
     2683       find first X_contract no-lock where                       recid(X_contract)              = X_contract-recid no-error .
     2684       find first X_fin-ob no-lock where                         recid(X_fin-ob)                = X_fin-ob-recid no-error .
     2685       find first X_clients-obj no-lock where                    recid(X_clients-obj)           = X_clients-obj-recid no-error .
     2686       assign
     2687         f-cor-acc1-descr = p-f-cor-acc1-descr
     2688         f-cor-acc-descr  = p-f-cor-acc-descr
     2689         f-an-uchet-descr = p-f-an-uchet-descr
     2690         f-cel-nazn-descr = p-f-cel-nazn-descr
     2691         .
     2692     end.
     2693   end procedure.
     2694   PROCEDURE proc-shift-name :
     2695     define buffer bf_shift-obj for ub.shift-obj.
     2696     define variable varfind-shift as integer initial 0.
     2697     define variable varshift-date like ub.shift-obj.shift-date no-undo.
     2698     define variable varshift-num  like ub.shift-obj.shift-num no-undo.
     2699     define variable varshift-name like ub.shift-obj.shift-name no-undo.
     2700     if input frame Dialog-Frame tt-fin-doc.shift-name <> tt-fin-doc.shift-name then
     2701     do:
     2702       if input frame Dialog-Frame tt-fin-doc.shift-date <> ? then
     2703       do:
     2704         for each  bf_shift-obj where
     2705           bf_shift-obj.obj-type   = tt-fin-doc.obj-type
     2706           and  bf_shift-obj.obj-code   = tt-fin-doc.obj-code
     2707           and  bf_shift-obj.shift-date = input frame Dialog-Frame tt-fin-doc.shift-date
     2708           and  bf_shift-obj.shift-name = input frame Dialog-Frame tt-fin-doc.shift-name
     2709           no-lock on error undo, return error return-value :
     2710           assign
     2711             varfind-shift = varfind-shift + 1
     2712             varshift-date = bf_shift-obj.shift-date
     2713             varshift-num  = bf_shift-obj.shift-num.
     2714           varshift-name = bf_shift-obj.shift-name.
     2715         end.
     2716         if varfind-shift = 0 or varfind-shift > 1 then
     2717         do:
     2718           if varfind-shift = 0 then
     2719           do:
     2720             message
     2721               substitute("Не найдена смена: &1&2 Дата &3 Номер смены "
     2722               ,tt-fin-doc.obj-type
     2723               ,tt-fin-doc.obj-code
     2724               ,input frame Dialog-Frame tt-fin-doc.shift-date
     2725               ,input frame Dialog-Frame tt-fin-doc.shift-name )
     2726               view-as alert-box error.
     2727           end.
     2728           else
     2729           do:
     2730             message
     2731               substitute("Найдено более одной смены с одним номером в сменном дне. Объект: &1&2 Дата &3 Номер смены &4 "
     2732               ,tt-fin-doc.obj-type
     2733               ,tt-fin-doc.obj-code
     2734               ,input frame Dialog-Frame tt-fin-doc.shift-date
     2735               ,input frame Dialog-Frame tt-fin-doc.shift-name )
     2736               view-as alert-box error.
     2737           end.
     2738           display
     2739             tt-fin-doc.shift-name with frame Dialog-Frame.
     2740           run proc-sht no-error.
     2741           if error-status:error then
     2742           do:
     2743             return error.
     2744           end.
     2745         end.
     2746         else
     2747         do:
     2748           assign frame Dialog-Frame
     2749             tt-fin-doc.shift-name.
     2750           assign
     2751             tt-fin-doc.shift-date = varshift-date
     2752             tt-fin-doc.shift-num  = varshift-num.
     2753           display
     2754             tt-fin-doc.shift-date
     2755             tt-fin-doc.shift-num
     2756             tt-fin-doc.shift-name with frame Dialog-Frame.
     2757         end.
     2758       end.
     2759     end.
     2760   END PROCEDURE.
     2761   PROCEDURE proc-shift-num :
     2762     define buffer bf_shift-obj for ub.shift-obj.
     2763     if input frame Dialog-Frame tt-fin-doc.shift-num <> tt-fin-doc.shift-num then
     2764     do:
     2765       if input frame Dialog-Frame tt-fin-doc.shift-date <> ? then
     2766       do:
     2767         find first bf_shift-obj where
     2768           bf_shift-obj.obj-type   = tt-fin-doc.obj-type
     2769           and  bf_shift-obj.obj-code   = tt-fin-doc.obj-code
     2770           and  bf_shift-obj.shift-date = input frame Dialog-Frame tt-fin-doc.shift-date
     2771           and  bf_shift-obj.shift-num  = input frame Dialog-Frame tt-fin-doc.shift-num  no-lock no-error.
     2772         if not available bf_shift-obj then
     2773         do:
     2774           message
     2775             substitute("Не найдена смена: &1&2 Дата &3 Порядок смены &4"
     2776             ,tt-fin-doc.obj-type
     2777             ,tt-fin-doc.obj-code
     2778             ,input frame Dialog-Frame tt-fin-doc.shift-date
     2779             ,input frame Dialog-Frame tt-fin-doc.shift-num)
     2780             view-as alert-box error.
     2781           display
     2782             tt-fin-doc.shift-num with frame Dialog-Frame.
     2783           run proc-sht no-error.
     2784           if error-status:error then
     2785           do:
     2786             return error.
     2787           end.
     2788         end.
     2789         else
     2790         do:
     2791           assign
     2792             tt-fin-doc.shift-date = bf_shift-obj.shift-date
     2793             tt-fin-doc.shift-num  = bf_shift-obj.shift-num
     2794             tt-fin-doc.shift-name = bf_shift-obj.shift-name.
     2795           display
     2796             tt-fin-doc.shift-date
     2797             tt-fin-doc.shift-num
     2798             tt-fin-doc.shift-name
     2799             with frame Dialog-Frame.
     2800         end.
     2801       end.
     2802     end.
     2803   END PROCEDURE.
     2804   PROCEDURE proc-sht :
     2805     define buffer bf_shift-obj for ub.shift-obj.
     2806     define variable varrid-list as character no-undo.
     2807     define variable varrecid    as recid     no-undo.
     2808     assign
     2809       varrid-list = "".
     2810     run str/sht-all.w ( input parparentproc
     2811       , input tt-fin-doc.obj-type
     2812       , input tt-fin-doc.obj-code
     2813       , input 'b-sel'
     2814       , input 'obj'
     2815       , input tt-fin-doc.obj-type
     2816       , input tt-fin-doc.obj-code
     2817       , input '':u
     2818       , input-output varrid-list) no-error .
     2819     if error-status:error or varrid-list = "":u then
     2820     do:
     2821       return error.
     2822     end.
     2823     else
     2824     do:
     2825       assign
     2826         varrecid = integer (entry(1, varrid-list)).
     2827       find first bf_shift-obj where recid(bf_shift-obj) = varrecid no-lock no-error.
     2828       if available bf_shift-obj then
     2829       do:
     2830         assign
     2831           tt-fin-doc.shift-date = bf_shift-obj.shift-date
     2832           tt-fin-doc.shift-num  = bf_shift-obj.shift-num
     2833           tt-fin-doc.shift-name = bf_shift-obj.shift-name.
     2834         display
     2835           tt-fin-doc.shift-date
     2836           tt-fin-doc.shift-num
     2837           tt-fin-doc.shift-name with frame Dialog-Frame.
     2838         assign
     2839           tt-fin-doc.doc-date = tt-fin-doc.shift-date
     2840           .
     2841         display tt-fin-doc.doc-date with frame Dialog-Frame.
     2842       end.
     2843     end.
     2844   END PROCEDURE.
     2845   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile: findocip.i $ $Revision: ff8019e24d02, 2996, rls $".
     2846   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2847   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2848   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2849   on ' ' of tt-fin-doc.doc-date in frame Dialog-Frame
     2850   do:
     2851     if (can-query (self, "sensitive")
     2852        and
     2853        self :sensitive = true
     2854        )
     2855     or (can-query (self, "read-only")
     2856        and
     2857        self :read-only = false
     2858        )
     2859     then do:
     2860       assign
     2861         self :screen-value = ?
     2862       .
     2863     end.
     2864     return no-apply.
     2865   end.
     2866   on delete-character of tt-fin-doc.doc-date in frame Dialog-Frame
     2867   do:
     2868     if (can-query (self, "sensitive")
     2869        and
     2870        self :sensitive = true
     2871        )
     2872     or (can-query (self, "read-only")
     2873        and
     2874        self :read-only = false
     2875        )
     2876     then do:
     2877       assign
     2878         self :screen-value = ?
     2879       .
     2880     end.
     2881     return no-apply.
     2882   end.
     2883   on ctrl-d of tt-fin-doc.doc-date in frame Dialog-Frame
     2884   do:
     2885     define variable v-curr-sv-date as date no-undo .
     2886     if (can-query (self, "sensitive")
     2887        and
     2888        self :sensitive = true
     2889        )
     2890     or (can-query (self, "read-only")
     2891        and
     2892        self :read-only = false
     2893        )
     2894     then do:
     2895       if self :handle <> focus :handle
     2896       then do:
     2897         apply "entry":u to self .
     2898       end.
     2899       run gbl/getcurdt.p
     2900         (output v-curr-sv-date
     2901         ) .
     2902       assign
     2903         self :screen-value = string(v-curr-sv-date) .
     2904       .
     2905     end.
     2906     return no-apply.
     2907   end.
     2908   on ctrl-b of tt-fin-doc.doc-date in frame Dialog-Frame
     2909   do:
     2910     if (can-query (self, "sensitive")
     2911        and
     2912        self :sensitive = true
     2913        )
     2914     or (can-query (self, "read-only")
     2915        and
     2916        self :read-only = false
     2917        )
     2918     then do:
     2919       if self :handle <> focus :handle
     2920       then do:
     2921         apply "entry":u to self .
     2922       end.
     2923       define variable v-curr-sv-date as date no-undo .
     2924       define variable v-new-sv-date  as date no-undo .
     2925       assign
     2926         v-curr-sv-date = date(self :screen-value) no-error
     2927       .
     2928       if v-curr-sv-date = ?
     2929       then do:
