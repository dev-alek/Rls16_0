     4311   define variable vss-include-info32 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4312   do:
     4313     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4314       (input  v-cntxt-db-num
     4315       ,input  v-cntxt-userid
     4316       ,input  0
     4317       ,input  'actn_fin-contract_lookup':U
     4318       ,input  'firm':U
     4319       ,input  tt-fin-doc.host-code
     4320       ,input  '':U
     4321       ,input  0
     4322       ,input  0
     4323       ,input  0
     4324       ,input  0
     4325       ,input  true
     4326       ,output g-log
