     6916                              else 0)
     6917       tt-fin-doc.cor-acc1-value = (if available X_fin-code-cor-acc1
     6918                              then X_fin-code-cor-acc1.code-value
     6919                              else "":U)
     6920       tt-fin-doc.cor-acc  = (if available X_fin-code-cor-acc
     6921                              then X_fin-code-cor-acc.fin-code
     6922                              else 0)
     6923       tt-fin-doc.cor-acc-value  = (if available X_fin-code-cor-acc
     6924                              then X_fin-code-cor-acc.code-value
     6925                              else "":U)
     6926       tt-fin-doc.an-uchet-code  = (if available X_fin-code-an-uchet
     6927                               then X_fin-code-an-uchet.fin-code
     6928                               else 0)
     6929       tt-fin-doc.an-uchet-value  = (if available X_fin-code-an-uchet
     6930                               then X_fin-code-an-uchet.code-value
     6931                               else "":U)
     6932       tt-fin-doc.cel-nazn-code  = (if available X_fin-code-cel-nazn
     6933                              then X_fin-code-cel-nazn.fin-code
     6934                              else 0)
     6935       tt-fin-doc.cel-nazn-value  = (if available X_fin-code-cel-nazn
     6936                              then X_fin-code-cel-nazn.code-value
     6937                              else "":U)
     6938       tt-fin-doc.contract-curr
     6939       tt-fin-doc.contract-rate
     6940       tt-fin-doc.contract-scale
     6941       tt-fin-doc.curr-code
     6942       tt-fin-doc.sum-doc
     6943       tt-fin-doc.payer-code
     6944       tt-fin-doc.payer-type
     6945       tt-fin-doc.payer-name
     6946       tt-fin-doc.naznach-plat = clean_char(tt-fin-doc.naznach-plat:screen-value)
     6947       tt-fin-doc.including = clean_char(tt-fin-doc.including:screen-value)
     6948       tt-fin-doc.enclosure = clean_char(tt-fin-doc.enclosure:screen-value)
     6949       tt-fin-doc.PS
     6950       tt-fin-doc.receiver-sign2
     6951       tt-fin-doc.receiver-sign3
     6952       tt-fin-doc.doc-author = (if p-mode = 'ДОБАВЛЕНИЕ':U then 'manual':U else tt-fin-doc.doc-author)
     6953       .
     6954       if not p-save then return.
     6955       run check-sums-rate in this-procedure no-error.
     6956       if error-status:error then return error.
     6957   end.
     6958   run ref/findoc0.p (
     6959   input-output p-doc-rec
     6960          ,input p-mode
     6961          ,input no
     6962          ,input tt-fin-doc.host-code            ,input tt-fin-doc.fin-doc-code         ,input tt-fin-doc.an-uchet-code        ,input tt-fin-doc.an-uchet-value       ,input tt-fin-doc.base-rate            ,input tt-fin-doc.base-scale           ,input tt-fin-doc.cel-nazn-code        ,input tt-fin-doc.cel-nazn-value       ,input tt-fin-doc.contract-code        ,input tt-fin-doc.contract-curr        ,input tt-fin-doc.contract-rate        ,input tt-fin-doc.contract-scale       ,input tt-fin-doc.cor-acc              ,input tt-fin-doc.cor-acc-value        ,input tt-fin-doc.cor-acc1             ,input tt-fin-doc.cor-acc1-value       ,input tt-fin-doc.curr-code            ,input tt-fin-doc.doc-date             ,input tt-fin-doc.shift-date           ,input tt-fin-doc.shift-num            ,input tt-fin-doc.shift-name           ,input tt-fin-doc.enclosure            ,input tt-fin-doc.exch-rate            ,input tt-fin-doc.exch-scale           ,input tt-fin-doc.f104                 ,input tt-fin-doc.f105                 ,input tt-fin-doc.f106                 ,input tt-fin-doc.f107                 ,input tt-fin-doc.f108                 ,input tt-fin-doc.f109                 ,input tt-fin-doc.f110                 ,input tt-fin-doc.f22                  ,input tt-fin-doc.f23                  ,input tt-fin-doc.fact-date            ,input tt-fin-doc.fin-doc-type         ,input tt-fin-doc.fin-ext-doc-type     ,input tt-fin-doc.in-doc-code          ,input tt-fin-doc.in-host-code         ,input tt-fin-doc.including            ,input tt-fin-doc.nazn-pl              ,input tt-fin-doc.naznach-plat         ,input tt-fin-doc.ocher-pl             ,input tt-fin-doc.out-doc-code         ,input tt-fin-doc.out-host-code        ,input tt-fin-doc.pay-date             ,input tt-fin-doc.payer-bank-name      ,input tt-fin-doc.payer-bank-city      ,input tt-fin-doc.payer-bik            ,input tt-fin-doc.payer-c-schet        ,input tt-fin-doc.payer-code           ,input tt-fin-doc.payer-code-schet     ,input tt-fin-doc.payer-dop1           ,input tt-fin-doc.payer-dop2           ,input tt-fin-doc.payer-inn            ,input tt-fin-doc.payer-kpp            ,input tt-fin-doc.payer-name           ,input tt-fin-doc.payer-okpo           ,input tt-fin-doc.payer-passport      ,input tt-fin-doc.payer-r-schet        ,input tt-fin-doc.payer-type           ,input tt-fin-doc.perm-date            ,input tt-fin-doc.prn-doc-code         ,input tt-fin-doc.PS                   ,input tt-fin-doc.receiver-bank-name   ,input tt-fin-doc.receiver-bank-city   ,input tt-fin-doc.receiver-bik         ,input tt-fin-doc.receiver-c-schet     ,input tt-fin-doc.receiver-code        ,input tt-fin-doc.receiver-code-schet  ,input tt-fin-doc.receiver-dop1        ,input tt-fin-doc.receiver-dop2        ,input tt-fin-doc.receiver-inn         ,input tt-fin-doc.receiver-kpp         ,input tt-fin-doc.receiver-name        ,input tt-fin-doc.receiver-okpo        ,input tt-fin-doc.receiver-passport    ,input tt-fin-doc.receiver-r-schet     ,input tt-fin-doc.receiver-type        ,input tt-fin-doc.srok-pl              ,input tt-fin-doc.stat-pl              ,input tt-fin-doc.str-podr-code        ,input tt-fin-doc.str-podr-type        ,input tt-fin-doc.str-podr-name        ,input tt-fin-doc.sum-base             ,input tt-fin-doc.sum-doc              ,input tt-fin-doc.sum-rubl             ,input tt-fin-doc.sum-contr            ,input tt-fin-doc.trn-doc-code         ,input tt-fin-doc.vid-opl              ,input tt-fin-doc.vid-plat
     6963          ,input tt-fin-doc.con-sum-rubl         ,input tt-fin-doc.con-sum-base         ,input tt-fin-doc.con-sum-doc          ,input tt-fin-doc.con-sum-contr        ,input tt-fin-doc.con-stat             ,input tt-fin-doc.payer-sign1                ,input tt-fin-doc.payer-sign2                ,input tt-fin-doc.payer-sign3                ,input tt-fin-doc.payer-sign4                ,input tt-fin-doc.receiver-sign1                ,input tt-fin-doc.receiver-sign2                ,input tt-fin-doc.receiver-sign3                ,input tt-fin-doc.receiver-sign4                ,input tt-fin-doc.obj-type                   ,input tt-fin-doc.obj-code                   ,input tt-fin-doc.doc-author                 ,input tt-fin-doc.fact-author                ,input tt-fin-doc.CashBookId
     6964          ,input table tt0-fin-doc-tax
     6965          ,input table tt0-fin-doc-attr
     6966          ,input yes
     6967          ,input table tt0-payment
     6968   ) no-error.
     6969   if error-status:error then do:
     6970   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6971   define variable fh as widget-handle no-undo .
     6972   define variable hh as widget-handle no-undo .
     6973   define variable rv as character no-undo .
     6974   assign
     6975   rv = entry(1, return-value , chr(4)).
     6976   if rv <> "":U then do:
     6977     assign
     6978     fh = frame Dialog-Frame:first-child
     6979     hh = fh:first-child
     6980     .
     6981     do while valid-handle(hh):
     6982       if hh:name = rv then do:
     6983         APPLY "ENTRY" to hh.
     6984         undo ,
     6985         return error.
     6986       end.
     6987       hh = hh:next-sibling.
     6988     end.
     6989   end.
     6990     undo, return error.
     6991   end.
     6992   if p-mode eq 'ДОБАВЛЕНИЕ':U
     6993   then
     6994      run update_prc-doc-code-mask(yes).
     6995   END PROCEDURE.
     6996   PROCEDURE update_prc-doc-code-mask :
     6997   define variable vCashBook as class ibs.th.ref.cashbookstorage no-undo.
     6998     define input  parameter IFlagSave as logical no-undo.
     6999     define variable vMask     as character no-undo.
     7000     define variable v-key     as character no-undo.
     7001     define variable vValue    as character no-undo.
     7002     if tt-fin-doc.prn-doc-code:screen-value in frame Dialog-Frame ne "" and IFlagSave
     7003     then
     7004        if tt-fin-doc.prn-doc-code:screen-value in frame Dialog-Frame ne mprn-doc-code-old
     7005        then do:
     7006           return.
     7007        end.
     7008     vCashBook = new ibs.th.ref.cashbookstorage () .
     7009     vmask = vCashBook:getSinglRule(tt-fin-doc.cashbookId, p-obj-type,p-obj-code, "PkoMask") .
     7010     MParam = if vCashBook:getSinglRule(tt-fin-doc.cashbookId, p-obj-type,p-obj-code, "uchet") eq "1"
     7011              then "year," + string(year(tt-fin-doc.shift-date))
     7012              else "".
     7013     delete object vCashBook no-error .
     7014     if vmask > ""
     7015     then.
     7016     else vmask = "[NNNN]/[obj-code]" .
     7017     find first ub.CashBookRule exclusive-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     7018                                                 and ub.CashBookRule.Obj-type = p-obj-type
     7019                                                 and ub.CashBookRule.Obj-code = p-obj-code
     7020                                              and ub.CashBookRule.Code = "currPko"
     7021                                              no-error .
     7022     if not available ub.CashBookRule
     7023     then do :
     7024        create ub.CashBookRule .
     7025        assign
     7026           ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     7027           ub.CashBookRule.Obj-type = p-obj-type
     7028           ub.CashBookRule.Obj-code = p-obj-code
     7029           ub.CashBookRule.Code = "currPko"
     7030           ub.CashBookRule.Status_ = 0
     7031           ub.CashBookRule.RuleValue = "1"
     7032        .
     7033         end.
     7034         run gen-key-rec in this-procedure ( input 'CashBookRule':U
     7035                                            ,input (buffer CashBookRule:handle)
     7036                                            ,output v-key).
     7037     subscribe   to "getCounter" anywhere run-procedure if IFlagSave then "Mycounternext" else "MycounterCurr".
     7038     assign
     7039           current-pko-rko = "currPKO"
     7040           current-ruleID = v-key
     7041         .
     7042         run utl/maskproc.p(parparentproc, vmask, "cashbook", tt-fin-doc.cashbookId, output vValue).
     7043         mprn-doc-code-old =  vValue.
     7044         tt-fin-doc.prn-doc-code = vValue.
     7045         display  tt-fin-doc.prn-doc-code with frame Dialog-Frame.
     7046      unsubscribe to "getCounter".
     7047   end procedure.
