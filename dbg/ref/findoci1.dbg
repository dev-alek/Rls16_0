     4334   ON CHOOSE OF B-cashbook IN FRAME Dialog-Frame
     4335     DO:
     4336       define variable v-cb-brw as class ibs.th.ref.cashbookbrw no-undo .
     4337       v-cb-brw = new ibs.th.ref.cashbookbrw ( 'ВЫБОР':U, parparentproc ).
     4338       wait-for  v-cb-brw:ShowDialog() .
     4339       if v-cb-brw:out-list-id > ""
     4340         then
     4341       do :
     4342         find first ub.cashbook no-lock where ub.cashbook.id = int64(v-cb-brw:out-list-id) .
     4343         tt-fin-doc.cashbookId = ub.cashbook.id .
     4344         f-cashbook = ub.CashBook.CashBookName .
     4345         display
     4346           f-cashbook
     4347           with frame Dialog-Frame .
     4348         IF LOOKUP("update_prc-doc-code-mask", THIS-PROCEDURE:INTERNAL-ENTRIES) >  0
     4349           THEN
     4350           run update_prc-doc-code-mask (no).
     4351         run check-obj in this-procedure (   input tt-fin-doc.obj-type
     4352           ,input tt-fin-doc.obj-code
     4353           )
     4354           no-error.
     4355         find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = (if tt-fin-doc.fin-doc-type eq 'рко':U then ub.cashbook.corrRko else ub.cashbook.corrPko)
     4356           and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     4357           and X_fin-code-cor-acc.status_ = integer('0':U)
     4358           no-error .
     4359         if available X_fin-code-cor-acc
     4360           then
     4361         do :
     4362           assign
     4363             tt-fin-doc.cor-acc-value = X_fin-code-cor-acc.code-value
     4364             f-cor-acc-descr          = X_fin-code-cor-acc.descr
     4365             tt-fin-doc.cor-acc       = X_fin-code-cor-acc.fin-code
     4366             .
     4367         end.
     4368         else
     4369         do:
     4370           if ub.cashbook.corrRko = "" then
     4371           do:
     4372             for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = "57.01"
     4373               and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     4374               tt-fin-doc.cor-acc = ub.fin-code-cor-acc.fin-code .
     4375               tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     4376             end.
     4377           end.
     4378         end.
     4379         if ub.CashBook.OsnAcct <> "" then
     4380         do:
     4381           find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = ub.CashBook.OsnAcct
     4382             and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     4383             and X_fin-code-cor-acc.status_ = integer('0':U)
     4384             no-error .
     4385           if available X_fin-code-cor-acc
     4386             then
     4387           do :
     4388             assign
     4389               tt-fin-doc.cor-acc1-value = X_fin-code-cor-acc.code-value
     4390               f-cor-acc1-descr          = X_fin-code-cor-acc.descr
     4391               tt-fin-doc.cor-acc1       = X_fin-code-cor-acc.fin-code
     4392               .
     4393           end.
     4394           else
     4395           do:
     4396             assign
     4397               tt-fin-doc.cor-acc1-value = ""
     4398               f-cor-acc1-descr          = ""
     4399               tt-fin-doc.cor-acc1       = ?
     4400               .
     4401           end.
     4402         end.
     4403       end.
     4404       display
     4405         tt-fin-doc.cor-acc-value
     4406         f-cor-acc-descr
     4407         tt-fin-doc.cor-acc
     4408         tt-fin-doc.cor-acc1-value
     4409         f-cor-acc1-descr
     4410         tt-fin-doc.cor-acc1
     4411         with frame Dialog-Frame .
     4412     END.
