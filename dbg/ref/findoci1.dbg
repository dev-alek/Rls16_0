     1743   procedure fin-doc-attr-write :
     1744    do
     1745    on error undo, return error return-value
     1746    :
     1747   define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
     1748   define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
     1749   define input parameter p-attr-code     like ub.fin-doc-attr.attr-code  no-undo .
     1750   define input parameter p-attr-value    like ub.fin-doc-attr.attr-value no-undo .
     1751   define variable  v-format         as character no-undo .
     1752   define variable  v-label          as character no-undo .
     1753   define variable  v-user-can-edit  as logical   no-undo .
     1754   define variable  v-output-display as logical   no-undo .
     1755   define variable  v-other          as character no-undo .
     1756   define variable  v-type           as character no-undo .
     1757   define buffer buf_fin-doc-attr for ub.fin-doc-attr.
     1758   run fd-attr-code in this-procedure
     1759                                     (input  p-attr-code
     1760                                     ,output v-type
     1761                                     ,output v-format
     1762                                     ,output v-label
     1763                                     ,output v-user-can-edit
     1764                                     ,output v-output-display
     1765                                     ,output v-other
     1766                                     ) no-error .
     1767   if error-status :error then do:
     1768     undo, return error return-value .
     1769   end.
     1770   find first buf_fin-doc-attr  exclusive-lock  where
     1771             buf_fin-doc-attr.attr-code    = p-attr-code
     1772         AND buf_fin-doc-attr.host-code    = p-host-code
     1773         AND buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code  no-error .
     1774     if not available  buf_fin-doc-attr then do:
     1775         create buf_fin-doc-attr.
     1776         assign
     1777         buf_fin-doc-attr.attr-code    = p-attr-code
     1778         buf_fin-doc-attr.attr-value   = p-attr-value
     1779         buf_fin-doc-attr.host-code    = p-host-code
     1780         buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code
     1781         .
     1782     end.
     1783     else do:
     1784          assign
     1785          buf_fin-doc-attr.attr-value = p-attr-value.
     1786     end.
     1787    end.
     1788   end procedure.
     1789   procedure fd-attr-exist :
     1790     do
     1791     on error undo, return error
     1792     :
     1793       define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
     1794       define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
     1795       define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
     1796       define output parameter p-exist   as logical  no-undo .
     1797       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
     1798       define variable  v-type           as character no-undo .
     1799       define variable  v-format         as character no-undo .
     1800       define variable  v-label          as character no-undo .
     1801       define variable  v-user-can-edit  as logical   no-undo .
     1802       define variable  v-output-display as logical   no-undo .
     1803       define variable  v-other          as character no-undo .
     1804       run fd-attr-code in this-procedure
     1805         (input  p-code
     1806         ,output v-type
     1807         ,output v-format
     1808         ,output v-label
     1809         ,output v-user-can-edit
     1810         ,output v-output-display
     1811         ,output v-other
     1812         ) no-error .
     1813       if error-status :error then do:
     1814         undo, return error return-value .
     1815       end.
     1816       find first buf_fin-doc-attr exclusive-lock
     1817         where buf_fin-doc-attr.host-code  = p-host-code
     1818           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
     1819           and buf_fin-doc-attr.attr-code = p-code
     1820         no-error .
     1821       if  available buf_fin-doc-attr then do:
     1822         p-exist = yes.
     1823       end.
     1824     end.
     1825   end procedure.
     1826   procedure fd-attr-delete :
     1827     do
     1828     on error undo, return error
     1829     :
     1830     define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
     1831     define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
     1832     define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
     1833     define output parameter p-deleted  as logical no-undo.
     1834       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
     1835       define variable  v-type           as character no-undo .
     1836       define variable  v-format         as character no-undo .
     1837       define variable  v-label          as character no-undo .
     1838       define variable  v-user-can-edit  as logical   no-undo .
     1839       define variable  v-output-display as logical   no-undo .
     1840       define variable  v-other          as character no-undo .
     1841       run fd-attr-code in this-procedure
     1842         (input  p-code
     1843         ,output v-type
     1844         ,output v-format
     1845         ,output v-label
     1846         ,output v-user-can-edit
     1847         ,output v-output-display
     1848         ,output v-other
     1849         ) no-error .
     1850       if error-status :error then do:
     1851         undo, return error return-value .
     1852       end.
     1853       find first buf_fin-doc-attr exclusive-lock
     1854         where buf_fin-doc-attr.host-code  = p-host-code
     1855           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
     1856           and buf_fin-doc-attr.attr-code = p-code
     1857         no-error NO-WAIT.
     1858       if not available buf_fin-doc-attr then do:
     1859         p-deleted = no.
     1860       end.
     1861       else do:
     1862         delete buf_fin-doc-attr no-error .
     1863         if error-status:error then do:
     1864           undo, return error return-value .
     1865         end.
     1866         p-deleted = yes.
     1867       end.
     1868     end.
     1869   end procedure.
