     6577   PROCEDURE fill-main-table :
     6578   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6579   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     6580     (output v-db-num
     6581     )  .
     6582   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6583   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     6584     (input  p-host-code
     6585     ,output v-base-code
     6586     )  .
     6587   for each tt-fin-doc:
     6588     delete tt-fin-doc.
     6589   end.
     6590   for each tt0-fin-doc-attr:
     6591     delete tt0-fin-doc-attr.
     6592   end.
     6593   for each tt0-fin-doc-tax:
     6594     delete tt0-fin-doc-tax.
     6595   end.
     6596   if p-mode = 'ИЗМЕНЕНИЕ':U
     6597   or p-mode = 'ПРОСМОТР':U
     6598   or p-mode = 'КОПИРОВАНИЕ':U
     6599   then do:
     6600     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     6601       find first locked_fin-doc EXclusive-lock where
     6602                     recid(locked_fin-doc) = p-doc-rec no-wait no-error.
     6603       if locked locked_fin-doc then do:
     6604         message
     6605         substitute("Запись &1 занята", p-fin-doc-code)
     6606         view-as alert-box error .
     6607         undo, return error.
     6608       end.
     6609     end.
     6610     else do:
     6611       find first locked_fin-doc no-lock where
     6612                   recid(locked_fin-doc) = p-doc-rec no-error .
     6613         if not available locked_fin-doc then do:
     6614           find first locked_fin-doc no-lock where
     6615                       locked_fin-doc.host-code = p-host-code
     6616                   AND locked_fin-doc.fin-doc-code = p-fin-doc-code no-error .
     6617         end.
     6618     end.
     6619     if not available locked_fin-doc then do:
     6620       message
     6621       substitute("&1 &2 &3&4 Не найдена запись &5"
     6622                   ,vss-workfile
     6623                   ,vss-revision
     6624                   ,vss-description
     6625                   ,chr(10)
     6626                   ,p-fin-doc-code)
     6627       view-as alert-box error .
     6628       undo, return error.
     6629     end.
     6630     create tt-fin-doc.
     6631     if p-mode = 'КОПИРОВАНИЕ':U then do:
     6632       buffer-copy locked_fin-doc
     6633       using
     6634       receiver-type
     6635       receiver-code
     6636       receiver-name
     6637       receiver-okpo
     6638       payer-type
     6639       payer-code
     6640       payer-name
     6641       an-uchet-code
     6642       an-uchet-value
     6643       cel-nazn-code
     6644       cel-nazn-value
     6645       contract-code
     6646       contract-curr
     6647       cor-acc-value
     6648       cor-acc1-value
     6649       cor-acc1
     6650       cor-acc
     6651       curr-code
     6652       enclosure
     6653       including
     6654       naznach-plat
     6655       obj-type
     6656       obj-code
     6657       str-podr-code
     6658       str-podr-name
     6659       str-podr-type
     6660       sum-doc
     6661       receiver-sign2
     6662       receiver-sign3
     6663       CashBookId
     6664       to tt-fin-doc
     6665       assign
     6666       tt-fin-doc.host-code = p-host-code
     6667       .
     6668     end.
     6669     else do:
     6670       buffer-copy locked_fin-doc to tt-fin-doc.
     6671     end.
     6672   end.
     6673   if p-mode = 'ДОБАВЛЕНИЕ':U
     6674   or p-mode = 'КОПИРОВАНИЕ':U then do:
     6675     run ref/finfnoco.p (
     6676                     INPUT parParentProc
     6677                   ,INPUT this-procedure:handle
     6678                   ,input p-curr-host-code
     6679                   ,input (p-mode + chr(4) + 'manual':U)
     6680                   ,input p-host-code
     6681                   ,input p-doc-rec
     6682                   ,input p-fin-doc-code
     6683                   ,input 'пко':U
     6684                   ,input 'пко':U
     6685                   ,input p-obj-type
     6686                   ,input p-obj-code
     6687                   ,input p-contract-code
     6688                   ,input p-ob-doc-code
     6689                   ,input p-payer-type
     6690                   ,input p-payer-code
     6691                   ,input 0
     6692                   ,input 'орг':U
     6693                   ,input p-host-code
     6694                   ,input 0
     6695                   ,input p-curr-code
     6696                   ,input p-cor-acc
     6697                   ,input p-cor-acc1
     6698                   ,input p-an-uchet-code
     6699                   ,input p-cel-nazn-code
     6700                   ,input (if available tt-fin-doc then tt-fin-doc.CashBookId else 0)
     6701                   ,input ""
     6702                   ,INPUT-OUTPUT table tt-fin-doc
     6703                   ,INPUT-OUTPUT table ttc-fin-doc
     6704                   ,output table tt0-fin-doc-attr
     6705                   ,output v-limit-access ) no-error .
     6706   end.
     6707   else do:
     6708     run ref/finfnoco.p (
     6709                     INPUT parParentProc
     6710                   ,INPUT this-procedure:handle
     6711                   ,input p-curr-host-code
     6712                   ,input p-mode
     6713                   ,input p-host-code
     6714                   ,input p-doc-rec
