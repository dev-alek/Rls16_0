     2070   procedure fin-doc-temp-attr-write :
     2071    do
     2072    on error undo, return error return-value
     2073    :
     2074   define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
     2075   define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
     2076   define input parameter p-attr-code     like ub.fin-doc-attr.attr-code  no-undo .
     2077   define input parameter p-attr-value    like ub.fin-doc-attr.attr-value no-undo .
     2078   define variable  v-format         as character no-undo .
     2079   define variable  v-label          as character no-undo .
     2080   define variable  v-user-can-edit  as logical   no-undo .
     2081   define variable  v-output-display as logical   no-undo .
     2082   define variable  v-other          as character no-undo .
     2083   define variable  v-type           as character no-undo .
     2084   define buffer buf_temp-fin-doc-attr for tt0-fin-doc-attr.
     2085   run fd-attr-code in this-procedure
     2086                                     (input  p-attr-code
     2087                                     ,output v-type
     2088                                     ,output v-format
     2089                                     ,output v-label
     2090                                     ,output v-user-can-edit
     2091                                     ,output v-output-display
     2092                                     ,output v-other
     2093                                     ) no-error .
     2094   if error-status :error then do:
     2095     undo, return error return-value .
     2096   end.
     2097   find first buf_temp-fin-doc-attr  exclusive-lock  where
     2098             buf_temp-fin-doc-attr.attr-code    = p-attr-code
     2099         AND buf_temp-fin-doc-attr.host-code    = p-host-code
     2100         AND buf_temp-fin-doc-attr.fin-doc-code     = p-fin-doc-code  no-error .
     2101     if not available  buf_temp-fin-doc-attr then do:
     2102         create buf_temp-fin-doc-attr.
     2103         assign
     2104         buf_temp-fin-doc-attr.attr-code    = p-attr-code
     2105         buf_temp-fin-doc-attr.attr-value   = p-attr-value
     2106         buf_temp-fin-doc-attr.host-code    = p-host-code
     2107         buf_temp-fin-doc-attr.fin-doc-code     = p-fin-doc-code
     2108         .
     2109     end.
     2110       assign
     2111       buf_temp-fin-doc-attr.attr-value = p-attr-value.
     2112    end.
     2113   end procedure.
     2114   procedure fin-doc-temp-attr-value :
