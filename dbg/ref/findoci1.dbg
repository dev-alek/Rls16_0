     5121   ON LEAVE OF tt-fin-doc.curr-code IN FRAME Dialog-Frame
     5122     DO:
     5123       define variable v-curr-code like ub.fin-doc.curr-code no-undo.
     5124   define variable vss-include-info47 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5125   if lookup(self :type
     5126            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     5127            ) = 0
     5128   then do:
     5129     message
