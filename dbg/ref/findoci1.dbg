     3218     if focus :handle <> self :handle  then do:
     3219       return no-apply .
     3220     end.
     3221   end.
     3222   if   input frame Dialog-Frame tt-fin-doc.obj-code <> 0 then
     3223   do:
     3224     run check-obj in this-procedure (
     3225       input frame Dialog-Frame tt-fin-doc.obj-type
     3226       ,input frame Dialog-Frame tt-fin-doc.obj-code
     3227       )
     3228       no-error.
