     3250       end.
     3251     END.
     3252   PROCEDURE check-obj :
     3253     define input parameter p-check-obj-type as character no-undo .
     3254     define input parameter p-check-obj-code as integer no-undo .
     3255     define variable v-obj-db-num as integer no-undo init -1.
     3256     define variable v-cash-book  as integer no-undo .
     3257     define buffer buf_clients for ub.clients.
     3258     find first buf_clients no-lock where
     3259       buf_clients.obj-code = p-check-obj-code
     3260       and buf_clients.obj-type = p-check-obj-type no-error.
     3261     if not available buf_clients then
     3262     do:
     3263       if p-check-obj-code <> ?  then
     3264         message "Неправильный код или тип объекта" .
     3265       apply "entry" to tt-fin-doc.obj-code in frame Dialog-Frame.
     3266       return error.
     3267     end.
     3268     find first X_clients-obj no-lock where recid(X_clients-obj) = recid(buf_clients).
     3269     assign
     3270       tt-fin-doc.obj-type = buf_clients.obj-type
     3271       tt-fin-doc.obj-code = buf_clients.obj-code
     3272       .
     3273     display
     3274       tt-fin-doc.obj-type
     3275       tt-fin-doc.obj-code
     3276       with frame Dialog-Frame.
     3277     if not (tt-fin-doc.obj-type = '' and tt-fin-doc.obj-code = 0) then
     3278     do:
     3279   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3280   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3281     (input  tt-fin-doc.obj-type
     3282     ,input  tt-fin-doc.obj-code
     3283     ,output v-obj-db-num
     3284     )  .
     3285       define variable l-shift-on as logical no-undo .
     3286   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3287   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3288     (input  tt-fin-doc.obj-type
     3289     ,input  tt-fin-doc.obj-code
     3290     ,input  'shift-on=request'
     3291     ,output l-shift-on
     3292     )  .
     3293       assign
     3294         tt-fin-doc.shift-flag = (if l-shift-on
     3295                                     and lookup(tt-fin-doc.fin-ext-doc-type, 'пко,рко':U) > 0
     3296                                     and (tt-fin-doc.doc-author = 'manual':U or tt-fin-doc.doc-author = 'auto':U)
     3297                                     and v-obj-db-num = v-cntxt-db-num
     3298                                     then integer('1':U)
     3299                                     else 0)
     3300         .
     3301       for each thbjattr_thbj-attr:
     3302         delete thbjattr_thbj-attr.
     3303       end.
     3304       define variable mCashBook         as class     ibs.th.ref.cashbookstorage no-undo .
     3305       define variable par-type          as character no-undo .
     3306       define variable v-dpt-option      as character no-undo .
     3307       define variable v-dpt-dflt-name   as character no-undo .
     3308       define variable v-dpt-dflt-type   as character no-undo .
     3309       define variable v-dpt-dflt-code   as integer   no-undo .
     3310       define variable v-value-character as character no-undo .
     3311       define variable v-value-date      as date      no-undo .
     3312       define variable v-value-decimal   as decimal   no-undo .
     3313       define variable v-value-integer   as INTEGER   no-undo .
     3314       define variable v-value-logical   AS LOGICAL   no-undo .
     3315       define variable v-tth             as handle    no-undo .
     3316       define variable v-naznach-plat    as character no-undo .
     3317       define variable v-enclosure       as character no-undo .
     3318       define variable o-head-position   as character no-undo .
     3319       define variable o-director        as character no-undo .
     3320       define variable o-snr-accnt       as character no-undo .
     3321       define variable o-cashier         as character no-undo .
     3322       define variable v-head-position   as character no-undo .
     3323       define variable v-director        as character no-undo .
     3324       define variable v-snr-accnt       as character no-undo .
     3325       define variable v-cashier         as character no-undo .
     3326       define variable v-hist-code       as character no-undo .
     3327       define variable v-hist-name       as character no-undo .
     3328       define buffer buf_sysconf for ub.sysconf.
     3329       define buffer buf_shop    for ub.shop .
     3330       define buffer buf_store   for ub.store .
     3331       define buffer buf_firm    for ub.firm .
     3332       assign
     3333         v-tth = buffer thbjattr_thbj-attr:table-handle .
     3334       mCashBook = new ibs.th.ref.cashbookstorage () .
     3335       v-dpt-option    = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "Struct") .
     3336       v-dpt-dflt-name = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "DptName") .
     3337       v-dpt-dflt-type = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "DptType") .
     3338       v-dpt-dflt-code = integer(mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "DptCode")) .
     3339       o-head-position = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "ManagerPosition") .
     3340       o-director      = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "ManagerFIO") .
     3341       o-snr-accnt     = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "BuhFIO") .
     3342       delete object mCashBook no-error .
     3343       case v-dpt-option:
     3344         when "1" then
     3345           do:
     3346             for first ub.db-attr no-lock where ub.db-attr.db-num = v-cntxt-db-num
     3347             and ub.db-attr.attr-code = 'hist-code':U:
     3348               v-hist-code = ub.db-attr.attr-value .
     3349             end.
     3350             for first ub.db-attr no-lock where ub.db-attr.db-num = v-cntxt-db-num
     3351             and ub.db-attr.attr-code = 'hist-name':U:
     3352               v-hist-name = ub.db-attr.attr-value .
     3353             end.
     3354             if v-hist-code = "" then v-dpt-dflt-code = X_clients-obj.obj-code .
     3355             if v-hist-name = "" then v-dpt-dflt-name = X_clients-obj.obj-name .
     3356             v-dpt-dflt-type = X_clients-obj.obj-type  .
     3357           end.
     3358         when "0" then
     3359           do:
     3360             assign
     3361               v-dpt-dflt-name = ''
     3362               v-dpt-dflt-type = ''
     3363               v-dpt-dflt-code = 0
     3364               .
     3365           end.
     3366         otherwise
     3367         do:
     3368           assign
     3369             v-dpt-dflt-name = v-dpt-dflt-name
     3370             v-dpt-dflt-type = v-dpt-dflt-type
     3371             v-dpt-dflt-code = v-dpt-dflt-code
     3372             .
     3373         end.
     3374       end case.
     3375       find first buf_sysconf no-error .
     3376       case o-head-position:
     3377         when '0':U then
     3378           do:
     3379             v-head-position = buf_sysconf.head-position.
     3380           end.
     3381         when '1':U then
     3382           do:
     3383             v-head-position = "Директор".
     3384           end.
     3385         when '2':U then
     3386           do:
     3387             v-head-position = "Управляющий".
     3388           end.
     3389         otherwise
     3390         do :
     3391           v-head-position = o-head-position.
     3392         end.
     3393       end case.
     3394       find first buf_firm no-lock where
     3395         buf_firm.firm-code = buf_sysconf.host-code.
     3396       case o-director:
     3397         when '1':U then
     3398           do:
     3399             if p-obj-type = 'маг':U then
     3400             do:
     3401               find first buf_shop no-lock where
     3402                 buf_shop.obj-code = p-obj-code no-error .
     3403               if available buf_shop then
     3404               do:
     3405                 v-director = buf_shop.director.
     3406               end.
     3407             end.
     3408             if p-obj-type = 'скл':U then
     3409             do:
     3410               find first buf_store no-lock where
     3411                 buf_store.obj-code = p-obj-code no-error .
     3412               if available buf_store then
     3413               do:
     3414                 v-director = buf_store.store-boss.
     3415               end.
     3416             end.
     3417           end.
     3418         when '0':U then
     3419           do:
     3420             v-director = buf_firm.director.
     3421           end.
     3422         otherwise
     3423         do:
     3424           v-director = o-director .
     3425         end.
     3426       end case.
     3427       case o-snr-accnt:
     3428         when '1':U then
     3429           do:
     3430             if p-obj-type = 'маг':U then
     3431             do:
     3432               find first buf_shop no-lock where
     3433                 buf_shop.obj-code = p-obj-code no-error .
     3434               if available buf_shop then
     3435               do:
     3436                 v-snr-accnt = entry(1,buf_shop.acct,"|").
     3437               end.
     3438             end.
     3439             if p-obj-type = 'скл':U then
     3440             do:
     3441               v-snr-accnt = ''.
     3442             end.
     3443           end.
     3444         when '2':U then
     3445           do:
     3446             v-snr-accnt = buf_sysconf.snr-accnt.
     3447           end.
     3448         otherwise
     3449         do:
     3450           v-snr-accnt = o-snr-accnt .
     3451         end.
     3452       end case.
     3453     if tt-fin-doc.shift-flag = integer('1':U) then
     3454     do:
     3455       define variable v-fin-doc-shift-date      as date      no-undo .
     3456       define variable v-fin-doc-shift-num       as integer   no-undo .
     3457       define variable v-fin-doc-shift-name      as character no-undo .
     3458       define variable v-fin-doc-shift-date-char as character no-undo .
     3459       define variable v-fin-doc-shift-num-char  as character no-undo .
     3460       define variable varobj-shift-date         as date      no-undo .
     3461       define variable varobj-shift-num          as integer   no-undo .
     3462       define variable varobj-shift-name         as character no-undo .
     3463       define variable v-can-back-shift          as logical   no-undo .
     3464   define variable vss-include-info26 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3465   do:
     3466     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3467       (input  v-cntxt-db-num
     3468       ,input  v-cntxt-userid
     3469       ,input  0
     3470       ,input  'actn_fin-doc_create-back-shift':U
     3471       ,input  'object':U
     3472       ,input  tt-fin-doc.host-code
     3473       ,input  tt-fin-doc.obj-type
     3474       ,input  tt-fin-doc.obj-code
     3475       ,input  0
     3476       ,input  0
     3477       ,input  0
     3478       ,input  false
     3479       ,output v-can-back-shift
     3480       )  .
     3481   end.
     3482   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3483   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     3484     (input  tt-fin-doc.obj-type
     3485     ,input  tt-fin-doc.obj-code
     3486     ,output varobj-shift-date
     3487     ,output varobj-shift-num
     3488     ,output varobj-shift-name
     3489     ) no-error .
     3490       if error-status :error then
     3491       do:
     3492         if not v-can-back-shift then
     3493         do:
     3494           return error substitute("Не найдена текущая смена на &1&2", tt-fin-doc.obj-type, tt-fin-doc.obj-code).
     3495         end.
     3496         else
     3497         do:
     3498           run proc-sht in this-procedure .
     3499         end.
     3500       end.
     3501       else
     3502       do:
     3503         assign
     3504           tt-fin-doc.shift-date = varobj-shift-date
     3505           tt-fin-doc.shift-num  = varobj-shift-num
     3506           tt-fin-doc.shift-name = varobj-shift-name
     3507           .
     3508       end.
     3509       define variable v-date as date    no-undo  .
     3510       define variable v-time as integer no-undo .
     3511       run cur-time in this-procedure(output v-date, output v-time).
     3512       display
     3513         tt-fin-doc.shift-date
     3514         tt-fin-doc.shift-num
     3515         tt-fin-doc.shift-name
     3516         with frame Dialog-Frame .
     3517       enable
     3518         r-sht
     3519         when (tt-fin-doc.shift-flag = integer('1':U) and v-limit-access = 0 and v-can-back-shift)
     3520         with frame Dialog-Frame.
     3521     end.
     3522     else
     3523     do:
     3524       hide
     3525         tt-fin-doc.shift-date
     3526         tt-fin-doc.shift-num
     3527         tt-fin-doc.shift-name
     3528         in frame Dialog-Frame .
     3529       disable
     3530         r-sht
     3531         with frame Dialog-Frame .
     3532     end.
     3533     FIND FIRST ub.shift-staff No-LOCK WHERE
     3534       ub.shift-staff.obj-type   = p-obj-type AND
     3535       ub.shift-staff.obj-code   = p-obj-code AND
     3536       ub.shift-staff.shift-date = tt-fin-doc.shift-date AND
     3537       ub.shift-staff.shift-num  = tt-fin-doc.shift-num AND
     3538       ub.shift-staff.staff-role = no and
     3539       ub.shift-staff.psn-num    >= 0 No-ERROR.
     3540     assign
     3541       v-cashier = if available ub.shift-staff then string(ub.shift-staff.name, "X(30)") else "".
     3542     .
     3543     if tt-fin-doc.fin-ext-doc-type = 'рко':U then
     3544     do:
     3545       assign
     3546         tt-fin-doc.payer-sign1 = v-director
     3547         tt-fin-doc.payer-sign2 = v-snr-accnt
     3548         tt-fin-doc.payer-sign3 = v-cashier
     3549         .
     3550     end.
     3551     if tt-fin-doc.fin-ext-doc-type = 'пко':U then
     3552     do:
     3553       assign
     3554         tt-fin-doc.receiver-sign2 = v-snr-accnt
     3555         tt-fin-doc.receiver-sign3 = v-cashier
     3556         .
     3557     end.
     3558     find first ub.CashBook no-lock where ub.CashBook.id = tt-fin-doc.CashBookId no-error .
     3559     if available (ub.CashBook) then
     3560     do:
     3561       case ub.CashBook.RuleOsnRko:
     3562         when "0" then
     3563           tt-fin-doc.naznach-plat = "Выручка от реализации" .
     3564         when "1" or
     3565         when "2" then
     3566           tt-fin-doc.naznach-plat = "" .
     3567         otherwise
     3568         tt-fin-doc.naznach-plat = ub.CashBook.RuleOsnRko .
     3569       end case .
     3570       case ub.CashBook.RulePril:
     3571         when '0' then
     3572           do:
     3573             tt-fin-doc.enclosure = v-naznach-plat .
     3574           end.
     3575         when '1' then
     3576           do:
     3577             tt-fin-doc.enclosure = "" .
     3578           end.
     3579         otherwise
     3580         tt-fin-doc.enclosure = ub.CashBook.RulePril .
     3581       end case.
     3582       if ub.CashBook.CorrRko <> "" then
     3583       do:
     3584         for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = ub.CashBook.CorrRko
     3585           and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     3586           tt-fin-doc.cor-acc = ub.fin-code-cor-acc.fin-code .
     3587           tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     3588         end.
     3589       end.
     3590       if tt-fin-doc.cor-acc = ? or tt-fin-doc.cor-acc = 0 then
     3591       do:
     3592         for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = "57.01"
     3593           and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     3594           tt-fin-doc.cor-acc = ub.fin-code-cor-acc.fin-code .
     3595           tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     3596         end.
     3597       end.
     3598       if ub.CashBook.OsnAcct <> "" then
     3599       do:
     3600         for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = ub.CashBook.OsnAcct
     3601           and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     3602           tt-fin-doc.cor-acc1 = ub.fin-code-cor-acc.fin-code .
     3603           tt-fin-doc.cor-acc1-value = ub.fin-code-cor-acc.code-value .
     3604         end.
     3605       end.
     3606     end.
     3607     assign
     3608       tt-fin-doc.str-podr-name = if v-hist-name = "" then v-dpt-dflt-name else v-hist-name
     3609       tt-fin-doc.str-podr-type = v-dpt-dflt-type
     3610       tt-fin-doc.str-podr-code = v-dpt-dflt-code
     3611       .
     3612     display
     3613       tt-fin-doc.str-podr-name
     3614       tt-fin-doc.str-podr-type
     3615       tt-fin-doc.str-podr-code
     3616       tt-fin-doc.enclosure
     3617       tt-fin-doc.naznach-plat
     3618       tt-fin-doc.cor-acc
     3619       tt-fin-doc.cor-acc1
     3620       tt-fin-doc.cor-acc1-value
     3621       tt-fin-doc.cor-acc-value
     3622       tt-fin-doc.receiver-sign2
     3623       tt-fin-doc.receiver-sign3
     3624       with frame Dialog-Frame .
     3625     end.
     3626     else
     3627     do:
     3628       assign
     3629         tt-fin-doc.shift-flag = 0
     3630         .
     3631     end.
     3632   END PROCEDURE.
     3633   ON CHOOSE OF B-calc IN FRAME Dialog-Frame
     3634     DO:
     3635       run ref/findclci.w (
     3636         INPUT          parParentProc
     3637         ,input          "":U
     3638         ,INPUT          tt-fin-doc.doc-date
     3639         ,INPUT          tt-fin-doc.curr-code
     3640         ,INPUT          v-base-code
     3641         ,INPUT          tt-fin-doc.contract-curr
     3642         ,INPUT-OUTPUT   tt-fin-doc.sum-doc
     3643         ,INPUT-OUTPUT   tt-fin-doc.exch-rate
     3644         ,INPUT-OUTPUT   tt-fin-doc.exch-scale
     3645         ,INPUT-OUTPUT   tt-fin-doc.sum-rubl
     3646         ,INPUT-OUTPUT   tt-fin-doc.sum-base
     3647         ,INPUT-OUTPUT   tt-fin-doc.base-rate
     3648         ,INPUT-OUTPUT   tt-fin-doc.base-scale
     3649         ,INPUT-OUTPUT   tt-fin-doc.sum-contr
     3650         ,INPUT-OUTPUT   tt-fin-doc.contract-rate
     3651         ,INPUT-OUTPUT   tt-fin-doc.contract-scale ) no-error.
     3652       if error-status:error then return no-apply.
     3653       assign
     3654         f-rest-con-sum = tt-fin-doc.sum-contr - tt-fin-doc.con-sum-contr
     3655         .
     3656       display
     3657         tt-fin-doc.sum-rubl
     3658         when v-rubf
     3659         tt-fin-doc.sum-doc
     3660         tt-fin-doc.exch-rate
     3661         when v-exchf
     3662         tt-fin-doc.exch-scale
     3663         when v-exchf
     3664         tt-fin-doc.sum-base
     3665         when v-basef
     3666         tt-fin-doc.base-rate
     3667         when v-baseratef
     3668         tt-fin-doc.base-scale
     3669         when v-baseratef
     3670         tt-fin-doc.sum-contr
     3671         when v-contractf
     3672         tt-fin-doc.contract-rate
     3673         when v-contractratef
     3674         tt-fin-doc.contract-scale
     3675         when v-contractratef
     3676         f-rest-con-sum
     3677         with frame Dialog-Frame .
     3678     END.
     3679   ON CHOOSE OF B-payer IN FRAME Dialog-Frame
     3680     DO:
     3681       define variable ref-list as character no-undo.
     3682       define variable ref-rec  as recid     no-undo.
     3683       define variable v-sum-vat-chr  as character no-undo .
     3684       define variable v-each-vat-chr as character no-undo.
     3685       define variable v-sum-vat      like ub.fin-doc-tax.sum-vat-line-doc no-undo .
     3686       define buffer buf_clients for ub.clients.
     3687   define variable vss-include-info28 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3688   if lookup(self :type
     3689            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3690            ) = 0
     3691   then do:
     3692     message
     3693       "$Workfile$"
     3694       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3695       "Интерфейсный элемент" self :name  skip
     3696       "Тип" self :type  skip
     3697       "Процедура" this-procedure :file-name skip
     3698       view-as alert-box .
     3699   end.
     3700   else do:
     3701     apply "entry":u to self  .
     3702     if focus :handle <> self :handle  then do:
     3703       return no-apply .
     3704     end.
     3705   end.
     3706   run ref/cli-all.w ( parParentProc
     3707     ,"b-sel"
     3708     , tt-fin-doc.payer-type
     3709     , ?
     3710     , ?
     3711     , (if available X_payer then recid(X_payer) else ?)
     3712     , ?
     3713     , "without-obj":U
     3714     , output ref-list) .
     3715   if ref-list = "" then
     3716   do:
     3717     return no-apply.
     3718   end.
     3719   ref-rec = integer( ref-list ).
     3720   FIND FIRST buf_clients WHERE recid (buf_clients) = ref-rec NO-LOCK .
     3721   if NOT (buf_clients.obj-type = 'орг':U
     3722     or
     3723     buf_clients.obj-type = 'чел':U ) then
     3724   do:
     3725     message
     3726       "Выберите контрагента типа" 'орг':U "или" 'чел':U
     3727       view-as alert-box error .
     3728     return no-apply.
     3729   end.
     3730   find first X_payer no-lock where
     3731     recid(X_payer) = recid(buf_clients).
     3732   assign
     3733     tt-fin-doc.payer-type = buf_clients.obj-type
     3734     tt-fin-doc.payer-code = buf_clients.obj-code
     3735     tt-fin-doc.payer-name = buf_clients.obj-name
     3736     .
     3737   display
     3738     tt-fin-doc.payer-type
     3739     tt-fin-doc.payer-code
     3740     tt-fin-doc.payer-name
     3741     with frame Dialog-Frame.
     3742   find first ub.CashBook no-lock where ub.CashBook.id = tt-fin-doc.cashbookId no-error .
     3743   if ub.CashBook.cli-code = tt-fin-doc.payer-code and ub.CashBook.cli-type = tt-fin-doc.payer-type then do:
     3744   assign
     3745     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     3746     tt-fin-doc.cor-acc-value  = ub.CashBook.corrPko
     3747     tt-fin-doc.naznach-plat   = ub.CashBook.RuleOsnPko
     3748     .
     3749   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     3750     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3751     and X_fin-code-cor-acc.status_ = integer('0':U)
     3752     no-error .
     3753   if available X_fin-code-cor-acc
     3754     then
     3755   do :
     3756     assign
     3757       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     3758       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     3759       .
     3760   end.
     3761   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     3762     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     3763     and X_fin-code-cor-acc1.status_ = integer('0':U)
     3764     no-error .
     3765   if available X_fin-code-cor-acc1
     3766     then
     3767   do :
     3768     assign
     3769       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     3770       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     3771       .
     3772   end.
     3773   assign
     3774     tt-fin-doc.including = "@, в том числе НДС" .
     3775     paramVne = "" .
     3776   end.
     3777   else
     3778   do:
     3779     if getCliKassa(tt-fin-doc.payer-type, tt-fin-doc.payer-code, "Vnecli", tt-fin-doc.cashbookId) then do:
     3780   assign
     3781     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     3782     .
     3783   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3784     and ub.CashBookRule.Obj-type   = 'всем':U
     3785     and ub.CashBookRule.Obj-code   = 0
     3786     and ub.CashBookRule.Code       = "corrPkoVne"
     3787     no-error.
     3788   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     3789   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3790     and ub.CashBookRule.Obj-type   = 'всем':U
     3791     and ub.CashBookRule.Obj-code   = 0
     3792     and ub.CashBookRule.Code       = "RuleOsnPkoVne"
     3793     no-error.
     3794   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     3795   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     3796     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3797     and X_fin-code-cor-acc.status_ = integer('0':U)
     3798     no-error .
     3799   if available X_fin-code-cor-acc
     3800     then
     3801   do :
     3802     assign
     3803       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     3804       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     3805       .
     3806   end.
     3807   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     3808     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     3809     and X_fin-code-cor-acc1.status_ = integer('0':U)
     3810     no-error .
     3811   if available X_fin-code-cor-acc1
     3812     then
     3813   do :
     3814     assign
     3815       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     3816       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     3817       .
     3818   end.
     3819   assign
     3820     tt-fin-doc.including = "@, в т.ч.: без налога (НДС)" .
     3821     paramVne = "vne" .
     3822   end.
     3823   else do:
     3824     if getCliKassa(tt-fin-doc.payer-type, tt-fin-doc.payer-code, "Avanscli", tt-fin-doc.cashbookId) then do:
     3825   assign
     3826     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     3827     .
     3828   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3829     and ub.CashBookRule.Obj-type   = 'всем':U
     3830     and ub.CashBookRule.Obj-code   = 0
     3831     and ub.CashBookRule.Code       = "corrPkoAvans"
     3832     no-error.
     3833   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     3834   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3835     and ub.CashBookRule.Obj-type   = 'всем':U
     3836     and ub.CashBookRule.Obj-code   = 0
     3837     and ub.CashBookRule.Code       = "RuleOsnPkoAvans"
     3838     no-error.
     3839   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     3840   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     3841     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3842     and X_fin-code-cor-acc.status_ = integer('0':U)
     3843     no-error .
     3844   if available X_fin-code-cor-acc
     3845     then
     3846   do :
     3847     assign
     3848       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     3849       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     3850       .
     3851   end.
     3852   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     3853     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
