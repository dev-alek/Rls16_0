      125   define variable MParam as character no-undo.
      126   DEFINE TEMP-TABLE ttc-fin-doc NO-UNDO LIKE ub.fin-doc.
      127   define variable v-base-code like ub.sysconf.host-code no-undo.
      128   define variable v-tab-order as character no-undo.
      129   define variable v-an-uchet-tab-order as character no-undo.
      130   define variable v-sum-curr-tab-order as character no-undo.
      131   define variable v-contract-tab-order as character no-undo init "b-contract-view,":U.
      132   define variable v-sum-doc-tab-order  as character no-undo init "sum-doc,curr-code,b-currency,b-calc,":U.
      133   define new global shared variable g#language as character no-undo .
      134   if g#language <> '' and g#language <> 'rus':U then do:
      135     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
