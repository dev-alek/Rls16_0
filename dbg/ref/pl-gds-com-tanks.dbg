      702           or error-status :get-message(1) <> ""
      703           then do:
      704             undo move_block, retry move_block .
      705           end.
      706         end.
      707       end.
      708       if p-move-resize = true
      709       then do:
      710         run diasize_position-resize-button in this-procedure .
      711       end.
      712       if v-diasize-wndstore = true
      713       then do:
      714         if connected("ub") = true
      715         then do:
      716           define variable v-cntxt-db-num        as integer   no-undo .
