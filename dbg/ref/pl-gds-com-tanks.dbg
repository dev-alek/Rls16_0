      722             (input  v-cntxt-db-num
      723             ,input  v-cntxt-userid
      724             ,input  v-diasize-proc-name
      725             ,input  'height':u
      726             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      727             ) .
