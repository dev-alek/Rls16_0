     1084         then do:
     1085           assign
     1086             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1087           no-error .
     1088           if error-status :error
     1089           or error-status :get-message(1) <> ""
     1090           then do:
