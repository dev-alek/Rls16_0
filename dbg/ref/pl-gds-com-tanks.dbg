        1   DEFINE BUFFER X_goods FOR goods.
        2   DEFINE BUFFER X_pl-gds FOR pl-gds.
        3   DEFINE BUFFER X_place FOR place.
        4   define temp-table tt-com-place
        5     field pl-code as integer
        6   .
        7   define input  parameter in-pl-code   like ub.pl-gds.pl-code   no-undo .
        8   define output parameter out-pl-code  like ub.pl-gds.pl-code   no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision$":u .
       10   define variable vss-author      as character no-undo init "$Author$":u .
       11   define variable vss-date        as character no-undo init "$Date$":u .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       13   define variable vss-archive     as character no-undo init "$Archive$":u .
       14   define variable vss-description as character no-undo init "Товары на складских местах" .
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   procedure placelib_write-attr:
       74   define input  parameter p-code     like ub.place-attr.attr-code .
       75   define input  parameter p-obj-code like ub.place-attr.obj-code .
       76   define input  parameter p-obj-type like ub.place-attr.obj-type .
       77   define input  parameter p-pl-code  like ub.place-attr.pl-code .
       78   define input  parameter p-value    like ub.place-attr.attr-value .
       79   define output parameter p-ok       as logical.
       80   define buffer buf_place-attr for ub.place-attr .
       81     do on error undo, return error return-value :
       82        p-ok = false.
       83        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
       84                                                   and buf_place-attr.obj-code    = p-obj-code
       85                                                   and buf_place-attr.obj-type    = p-obj-type
       86                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
       87        if not available buf_place-attr then do :
       88           create buf_place-attr.
       89           assign
       90             buf_place-attr.attr-code   = p-code
       91             buf_place-attr.attr-value  = p-value
       92             buf_place-attr.obj-code    = p-obj-code
       93             buf_place-attr.obj-type    = p-obj-type
       94             buf_place-attr.pl-code     = p-pl-code
       95           .
       96           p-ok = true.
       97        end.
       98        else do:
       99           buf_place-attr.attr-value  = p-value .
      100           p-ok = true.
      101        end.
      102     end.
      103   end.
      104   procedure placelib_get-attr:
      105   define input  parameter  p-code     like ub.place-attr.attr-code .
      106   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      107   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      108   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      109   define output parameter  p-value    like ub.place-attr.attr-value .
      110   define output parameter  p-ok       as logical.
      111   define buffer buf_place-attr for ub.place-attr .
      112     do on error undo, return error return-value :
      113        p-ok = false.
      114        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      115                                                   and buf_place-attr.obj-code    = p-obj-code
      116                                                   and buf_place-attr.obj-type    = p-obj-type
      117                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      118        if available buf_place-attr then do :
      119          p-value = buf_place-attr.attr-value.
      120          p-ok = true.
      121        end.
      122        else do :
      123          p-ok = false.
      124        end.
      125     end.
      126   end.
      127   procedure placelib_del-attr:
      128   define input parameter  p-code     like ub.place-attr.attr-code .
      129   define input parameter  p-obj-code like ub.place-attr.obj-code .
      130   define input parameter  p-obj-type like ub.place-attr.obj-type .
      131   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      132   define input parameter  p-value    like ub.place-attr.attr-value .
      133   define output parameter p-ok       as logical.
      134   define buffer buf_place-attr for ub.place-attr .
      135     do on error undo, return error return-value :
      136        p-ok = false.
      137        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      138                                                   and buf_place-attr.obj-code    = p-obj-code
      139                                                   and buf_place-attr.obj-type    = p-obj-type
      140                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      141        if available buf_place-attr then do :
      142           delete buf_place-attr.
      143           p-ok = true.
      144        end.
      145     end.
      146   end.
      147   define buffer b-goods for goods.
      148   define buffer b-place for place.
      149   define buffer b2-place for place.
      150   define variable glog         as logical   no-undo .
      151   define variable v-value      as character no-undo .
      152   define variable v-ok         as logical   no-undo .
      153   define variable ii           as integer   no-undo .
      154   DEFINE BUTTON B-exit AUTO-GO
      155        LABEL "&Выход"
      156        SIZE 10 BY 1
      157        BGCOLOR 8 .
      158   DEFINE BUTTON B-Help
      159        LABEL "Помо&щь"
      160        SIZE 3 BY 1
      161        BGCOLOR 8 .
      162   DEFINE BUTTON B-sel AUTO-GO
      163        LABEL "Вы&бор"
      164        SIZE 10 BY 1.
      165   DEFINE QUERY BR-pl-gds FOR
      166         tt-com-place,
      167         X_pl-gds,
      168         X_goods,
      169         X_place SCROLLING.
      170   DEFINE BROWSE BR-pl-gds
      171     QUERY BR-pl-gds NO-LOCK DISPLAY
      172   X_pl-gds.pl-code COLUMN-LABEL "Склд.место" FORMAT ">>>>>>>>>>9":U
      173   X_place.pl-name FORMAT "X(40)":U
      174   X_place.loc1 FORMAT "X(8)":U
      175   X_place.loc2 FORMAT "X(8)":U
      176   X_place.loc3 FORMAT "X(8)":U
      177   X_place.loc4 FORMAT "X(8)":U
      178   X_pl-gds.gds-code FORMAT "99999999999":U
      179   X_goods.artic FORMAT "X(16)":U
      180   X_goods.gds-name FORMAT "X(48)":U
      181   X_goods.prod-type FORMAT "X(3)":U
      182   X_goods.prod-code FORMAT ">>>>>>>>9":U
      183   X_pl-gds.free-qnty FORMAT "->>,>>>,>>9.999":U
      184   X_pl-gds.fact-qnty FORMAT "->>,>>>,>>9.999":U
      185   X_pl-gds.cli-free-qnty FORMAT "->>,>>>,>>9.999":U
      186   X_pl-gds.cli-fact-qnty FORMAT "->>,>>>,>>9.999":U
      187   X_pl-gds.tolerance COLUMN-LABEL "Допуст.отклонение" FORMAT "->>,>>>,>>9.<<<":U
      188   X_pl-gds.status_ FORMAT "X(8)":U
      189   ENABLE
      190   X_pl-gds.tolerance
      191       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 18.
      192   DEFINE FRAME Dialog-Frame
      193        B-exit AT ROW 1 COL 1.2
      194        B-sel AT ROW 1 COL 11
      195        B-Help AT ROW 1 COL 95
      196        BR-pl-gds AT ROW 3.95 COL 1
      197        SPACE(0.00) SKIP(0.17)
      198       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      199            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      200            TITLE "Товары на складских местах"
      201            DEFAULT-BUTTON B-exit.
      202   ASSIGN
      203          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      204          FRAME Dialog-Frame:HIDDEN           = TRUE.
      205   ASSIGN
      206          BR-pl-gds:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1.
      207   ON GO OF FRAME Dialog-Frame
      208   DO:
      209   END.
      210   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      211   DO:
      212     APPLY "END-ERROR":U TO SELF.
      213   END.
      214   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      215   DO:
      216   END.
      217   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      218   DO:
      219       if available X_pl-gds
      220       then
      221         out-pl-code = X_pl-gds.pl-code
      222       .
      223   END.
      224   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      225   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      226   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      227   on help of frame Dialog-Frame
      228   do:
      229     run gbl/app_help.p
      230       (input this-procedure :file-name
      231       ,input ''
      232       ,input ?
      233       ) no-error.
      234     if error-status :error then do:
      235       message
      236         "Ошибка при вызове помощи"
      237         error-status :get-message(1)
      238         view-as alert-box .
      239     end.
      240   end.
      241   run minbtn-set in this-procedure .
      242   on choose of b-help in frame Dialog-Frame
      243   do:
      244     apply "help":u to frame Dialog-Frame .
      245   end.
      246   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      247   procedure minbtn-set :
      248       do
      249           on error undo, return error return-value
      250           :
      251           define variable ii              as integer       no-undo .
      252           define variable fh              as widget-handle no-undo .
      253           define variable hh              as widget-handle no-undo .
      254           define variable v-h             as handle        extent 4 no-undo .
      255           define variable v-name-button   as character     no-undo .
      256           define variable v-help-old-x    as decimal       no-undo .
      257           define variable v-help-old-y    as decimal       no-undo .
      258           define variable v-help-old-size as decimal       no-undo .
      259           define variable v-frame-width   as decimal       no-undo .
      260           define variable jj              as integer       no-undo .
      261           do
      262               on error undo, return error
      263               :
      264               assign
      265                   v-frame-width = frame Dialog-Frame:width - 0.3
      266                   fh            = frame Dialog-Frame:first-child
      267                   hh            = fh:first-child
      268                   ii            = 1
      269                   .
      270               do while valid-handle(hh):
      271                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      272                   do:
      273                       case lc(hh:name) :
      274                           when "b-help" then
      275                               do:
      276                                   hh:load-image-up("cmp/b-help.bmp":u) .
      277                                   hh:load-image-down("cmp/b-help.bmp":u) .
      278                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      279                                   hh:TOOLTIP = "Помощь" .
      280                                   v-help-old-x = hh:column .
      281                                   v-help-old-y = hh:row    .
      282                                   v-help-old-size = hh:width .
      283                                   hh:width-chars = 2.5 .
      284                               end.
      285                           when "b-print" then
      286                               do:
      287                                   hh:load-image("cmp/b-print.bmp":u) .
      288                                   hh:TOOLTIP = "Печать" .
      289                                   v-h[ii] = hh:handle .
      290                                   ii = ii + 1 .
      291                                   hh:width-chars = 3 .
      292                               end.
      293                           when "b-history" or
      294                           when "b-hist" then
      295                               do:
      296                                   hh:load-image("cmp/b-hist.bmp":u) .
      297                                   hh:TOOLTIP = "История" .
      298                                   v-h[ii] = hh:handle .
      299                                   ii = ii + 1 .
      300                                   hh:width-chars = 3 .
      301                               end.
      302                           when "b-sch" then
      303                               do:
      304                                   hh:load-image("cmp/b-sch.bmp":u) .
      305                                   hh:TOOLTIP = "Установка Фильтра" .
      306                                   v-h[ii] = hh:handle .
      307                                   ii = ii + 1 .
      308                                   hh:width-chars = 3 .
      309                               end.
      310                           when "b-hist-user" then
      311                               do:
      312                                   hh:load-image("cmp/b-hist.bmp":u) .
      313                                   hh:TOOLTIP = "История пользователя" .
      314                                   ii = ii + 1 .
      315                               end.
      316                       end case.
      317                   end.
      318                   hh = hh:next-sibling.
      319               end.
      320               b-help:column = v-frame-width - b-help:width-chars.
      321               jj = 0.
      322               repeat ii = 4 to 1 by -1 :
      323                   if valid-handle (v-h[ii] ) then
      324                   do:
      325                       jj  = jj + 1 .
      326                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      327                       v-h[ii]:row    = v-help-old-y .
      328                   end.
      329               end.
      330           end.
      331       end.
      332   end procedure.
      333   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      334   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      335   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      336   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      337   define variable v-diasize-current-frame-width  as decimal   no-undo .
      338   define variable v-diasize-current-frame-height as decimal   no-undo .
      339   define variable v-diasize-change-size          as logical   no-undo .
      340   define variable v-diasize-resize-button        as handle    no-undo .
      341   define variable v-diasize-wndmax               as logical   no-undo .
      342   define variable v-diasize-wndstore             as logical   no-undo .
      343   define variable v-diasize-proc-name            as character no-undo .
      344   define variable v-diasize-browse-handle        as handle    no-undo .
      345   define variable v-diasize-browse-number        as integer   no-undo .
      346   define variable v-diasize-need-full-display    as logical   no-undo init false .
      347   define temp-table temp-diasize-handle no-undo
      348     field handle-value  as handle
      349     field save-position as decimal
      350     index xpk is primary unique handle-value
      351     .
      352   define temp-table temp-browse-handle no-undo
      353     field browse-type   as character
      354     field browse-number as integer
      355     field browse-handle as handle
      356     field original-size as decimal
      357     index xpk is primary unique browse-type browse-number
      358     index xie browse-type browse-handle
      359   .
      360   procedure diasize_change-height :
      361     define input  parameter p-change-value  as decimal   no-undo .
      362     define input  parameter p-move-resize   as logical   no-undo .
      363     define variable v-field-group-handle    as handle    no-undo .
      364     define variable v-object-handle         as handle    no-undo .
      365     define variable v-frame-height          as decimal   no-undo .
      366     define variable v-frame-virtual-height  as decimal   no-undo .
      367     define variable v-browse-height         as decimal   no-undo .
      368     define variable v-window-height         as decimal   no-undo .
      369     define variable v-window-virtual-height as decimal   no-undo .
      370     define variable v-change-sign           as integer   no-undo .
      371     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      372     define buffer buf_temp-browse-handle  for temp-browse-handle .
      373     if p-change-value > 0
      374     then do:
      375       if frame Dialog-Frame :height + p-change-value
      376           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      377       then do:
      378         assign
      379           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      380                           - (frame Dialog-Frame :height-chars)
      381         .
      382         if p-change-value <= 0
      383         then do:
      384           run diasize_position-resize-button in this-procedure .
      385           return .
      386         end.
      387       end.
      388     end.
      389     if p-change-value < 0
      390     then do:
      391       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      392       then do:
      393         assign
      394           p-change-value = v-diasize-orig-frame-height
      395                          - (frame Dialog-Frame :height-chars)
      396         .
      397         if p-change-value >= 0
      398         then do:
      399           run diasize_position-resize-button in this-procedure .
      400           return .
      401         end.
      402       end.
      403     end.
      404     if p-change-value >= 0
      405     then do:
      406       assign
      407         v-change-sign = 1
      408       .
      409     end.
      410     else do:
      411       assign
      412         v-change-sign = -1
      413       .
      414     end.
      415     assign
      416       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      417     .
      418     if p-change-value = 0
      419     then do:
      420       run diasize_position-resize-button in this-procedure .
      421       return .
      422     end.
      423     move_block:
      424     do
      425     on error undo move_block, retry move_block
      426     :
      427       if retry
      428       then do:
      429         do
      430         on error undo move_block, leave move_block
      431         :
      432           if p-change-value > 0
      433           then do:
      434             for each buf_temp-diasize-handle
      435             on error undo, next
      436             :
      437               assign
      438                 v-object-handle = buf_temp-diasize-handle.handle-value
      439               .
      440               if v-object-handle <> v-diasize-resize-button
      441               then do:
      442                 assign
      443                   v-object-handle :row = buf_temp-diasize-handle.save-position
      444                 .
      445               end.
      446             end.
      447             assign
      448               v-diasize-browse-handle :height = v-browse-height
      449             .
      450             for each buf_temp-browse-handle
      451               where buf_temp-browse-handle.browse-type = 'height':u
      452             on error undo, next
      453             :
      454               assign
      455                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      456               .
      457             end.
      458             assign
      459               frame Dialog-Frame :height = v-frame-height
      460             .
      461             if frame Dialog-Frame :scrollable = true
      462             then do:
      463               assign
      464                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      465               .
      466             end.
      467             run diasize_position-resize-button in this-procedure .
      468           end.
      469           else do:
      470             if frame Dialog-Frame :scrollable = true
      471             then do:
      472               assign
      473                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      474               .
      475             end.
      476             assign
      477               frame Dialog-Frame :height = v-frame-height
      478             .
      479             assign
      480               v-diasize-browse-handle :height = v-browse-height
      481             .
      482             for each buf_temp-browse-handle
      483               where buf_temp-browse-handle.browse-type = 'height':u
      484             on error undo, next
      485             :
      486               assign
      487                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      488               .
      489             end.
      490             for each buf_temp-diasize-handle
      491             on error undo, next
      492             :
      493               assign
      494                 v-object-handle = buf_temp-diasize-handle.handle-value
      495               .
      496               if v-object-handle <> v-diasize-resize-button
      497               then do:
      498                 assign
      499                   v-object-handle :row = buf_temp-diasize-handle.save-position
      500                 .
      501               end.
      502             end.
      503             run diasize_position-resize-button in this-procedure .
      504           end.
      505           assign
      506             v-diasize-change-size = false
      507           .
      508           leave move_block .
      509         end.
      510       end.
      511       assign
      512         v-diasize-need-full-display = true
      513       .
      514       if v-diasize-change-size = false
      515       then do:
      516         assign
      517           v-diasize-change-size = true
      518         .
      519       end.
      520       else do:
      521         return .
      522       end.
      523       assign
      524         v-frame-height = frame Dialog-Frame :height
      525         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      526         v-browse-height = v-diasize-browse-handle :height
      527       .
      528       for each buf_temp-browse-handle
      529         where buf_temp-browse-handle.browse-type = 'height':u
      530       :
      531         assign
      532           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      533         .
      534       end.
      535       for each buf_temp-diasize-handle
      536       :
      537         delete buf_temp-diasize-handle .
      538       end.
      539       assign
      540         v-field-group-handle = frame Dialog-Frame :first-child
      541       .
      542       do while valid-handle(v-field-group-handle)
      543       :
      544         assign
      545           v-object-handle = v-field-group-handle :first-child
      546         .
      547         do while valid-handle(v-object-handle)
      548         :
      549           if  v-object-handle <> v-diasize-browse-handle :handle
      550           and can-query(v-object-handle, "row")
      551           and can-query(v-object-handle, "height")
      552           and ( v-object-handle :row > v-diasize-browse-handle :row )
      553           then do:
      554             find first buf_temp-browse-handle
      555               where buf_temp-browse-handle.browse-type   = 'height':u
      556                 and buf_temp-browse-handle.browse-handle = v-object-handle
      557               no-error .
      558             if available buf_temp-browse-handle
      559             then do:
      560             end.
      561             else do:
      562               create buf_temp-diasize-handle .
      563               assign
      564                 buf_temp-diasize-handle.handle-value  = v-object-handle
      565                 buf_temp-diasize-handle.save-position = v-object-handle :row
      566               .
      567             end.
      568           end.
      569           assign
      570             v-object-handle = v-object-handle :next-sibling
      571           .
      572         end.
      573         assign
      574           v-field-group-handle = v-field-group-handle :next-sibling
      575         .
      576       end.
      577       do with frame Dialog-Frame
      578       :
      579         hide v-diasize-resize-button .
      580         assign
      581           v-diasize-resize-button :row    = 1
      582           v-diasize-resize-button :column = 1
      583         .
      584       end.
      585       if p-change-value > 0
      586       then do:
      587         if frame Dialog-Frame :scrollable = true
      588         then do:
      589           assign
      590             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      591             no-error .
      592           if error-status :error
      593           or error-status :get-message(1) <> ""
      594           then do:
      595             undo move_block, retry move_block .
      596           end.
      597         end.
      598         assign
      599           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      600           no-error .
      601         if error-status :error
      602         or error-status :get-message(1) <> ""
      603         then do:
      604           undo move_block, retry move_block .
      605         end.
      606         assign
      607           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      608           no-error .
      609         if error-status :error
      610         or error-status :get-message(1) <> ""
      611         then do:
      612           undo move_block, retry move_block .
      613         end.
      614         for each buf_temp-browse-handle
      615           where buf_temp-browse-handle.browse-type = 'height':u
      616         on error undo move_block, retry move_block
      617         :
      618           assign
      619             buf_temp-browse-handle.browse-handle :height
      620               = buf_temp-browse-handle.browse-handle :height + p-change-value
      621             no-error .
      622           if error-status :error
      623           or error-status :get-message(1) <> ""
      624           then do:
      625             undo move_block, retry move_block .
      626           end.
      627         end.
      628         for each buf_temp-diasize-handle
      629         on error undo move_block, retry move_block
      630         :
      631           assign
      632             v-object-handle = buf_temp-diasize-handle.handle-value
      633           .
      634           if v-object-handle <> v-diasize-resize-button
      635           then do:
      636             assign
      637               v-object-handle :row = v-object-handle :row + p-change-value
      638               no-error .
      639             if error-status :error
      640             or error-status :get-message(1) <> ""
      641             then do:
      642               undo move_block, retry move_block .
      643             end.
      644           end.
      645         end.
      646       end.
      647       else do:
      648         for each buf_temp-diasize-handle
      649         on error undo move_block, retry move_block
      650         :
      651           assign
      652             v-object-handle = buf_temp-diasize-handle.handle-value
      653           .
      654           if v-object-handle <> v-diasize-resize-button
      655           then do:
      656             assign
      657               v-object-handle :row = v-object-handle :row + p-change-value
      658               no-error .
      659             if error-status :error
      660             or error-status :get-message(1) <> ""
      661             then do:
      662               undo move_block, retry move_block .
      663             end.
      664           end.
      665         end.
      666         assign
      667           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      668           no-error .
      669         if error-status :error
      670         or error-status :get-message(1) <> ""
      671         then do:
      672           undo move_block, retry move_block .
      673         end.
      674         for each buf_temp-browse-handle
      675           where buf_temp-browse-handle.browse-type = 'height':u
      676         on error undo move_block, retry move_block
      677         :
      678           assign
      679             buf_temp-browse-handle.browse-handle :height
      680               = buf_temp-browse-handle.browse-handle :height + p-change-value
      681             no-error .
      682           if error-status :error
      683           or error-status :get-message(1) <> ""
      684           then do:
      685             undo move_block, retry move_block .
      686           end.
      687         end.
      688         assign
      689           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      690           no-error .
      691         if error-status :error
      692         or error-status :get-message(1) <> ""
      693         then do:
      694           undo move_block, retry move_block .
      695         end.
      696         if frame Dialog-Frame :scrollable = true
      697         then do:
      698           assign
      699             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      700             no-error .
