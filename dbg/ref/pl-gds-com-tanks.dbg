     1092           end.
     1093         end.
     1094       end.
     1095       if p-move-resize
     1096       then do:
     1097         run diasize_position-resize-button in this-procedure .
     1098       end.
     1099       if v-diasize-wndstore = true
     1100       then do:
     1101         if connected("ub") = true
     1102         then do:
     1103           define variable v-cntxt-db-num        as integer   no-undo .
     1104           define variable v-cntxt-userid        as character no-undo .
     1105           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1106                                             , OUTPUT v-cntxt-userid
     1107                                             ) .
     1108           run gbl/wndsizew.p
     1109             (input  v-cntxt-db-num
     1110             ,input  v-cntxt-userid
     1111             ,input  v-diasize-proc-name
     1112             ,input  'width':u
     1113             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1114             ) .
     1115         end.
     1116       end.
     1117     end.
     1118     assign
     1119       v-diasize-change-size = false
     1120     .
     1121   end procedure.
     1122   procedure diasize_set-width :
     1123     define input  parameter p-new-width  as decimal   no-undo .
     1124     define input  parameter p-move-resize as logical   no-undo .
     1125     do
     1126     on error undo, return error return-value
     1127     :
     1128       run diasize_change-width in this-procedure
     1129         (input  (p-new-width - frame Dialog-Frame :width)
     1130         ,input  p-move-resize
     1131         ) .
     1132     end.
     1133   end procedure.
     1134   procedure diasize_position-resize-button :
     1135     do with frame Dialog-Frame
     1136     :
     1137       hide v-diasize-resize-button .
     1138       assign
     1139         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1140                     - 1
     1141                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1142         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1143                     - 1
     1144                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1145       .
     1146       view v-diasize-resize-button .
     1147     end.
     1148   end procedure.
     1149   on alt-right anywhere
     1150   do:
     1151     run diasize_change-width in this-procedure
     1152       (input 1
     1153       ,input true
     1154       ) .
     1155     return no-apply .
     1156   end.
     1157   on alt-left anywhere
     1158   do:
     1159     run diasize_change-width in this-procedure
     1160       (input -1
     1161       ,input true
     1162       ) .
     1163     return no-apply .
     1164   end.
     1165   on alt-down anywhere
     1166   do:
     1167     run diasize_change-height in this-procedure
     1168       (input 1
     1169       ,input true
     1170       ) .
     1171     return no-apply .
     1172   end.
     1173   on alt-up anywhere
     1174   do:
     1175     run diasize_change-height in this-procedure
     1176       (input -1
     1177       ,input true
     1178       ) .
     1179     return no-apply .
     1180   end.
     1181   on alt-enter of frame Dialog-Frame
     1182   do:
     1183     run diasize_maximize in this-procedure
     1184       (input  ?
     1185       ).
     1186     return no-apply .
     1187   end.
     1188   procedure diasize_end-move :
     1189     do
     1190     on error undo, return error return-value
     1191     :
     1192       define variable v-row-delta as decimal   no-undo .
     1193       define variable v-col-delta as decimal   no-undo .
     1194       define variable v-new-row as decimal   no-undo .
     1195       define variable v-new-col as decimal   no-undo .
     1196       assign
     1197         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1198         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1199       .
     1200       assign
     1201         v-row-delta = v-new-row - frame Dialog-Frame :height
     1202         v-col-delta = v-new-col - frame Dialog-Frame :width
     1203       .
     1204       run diasize_change-height in this-procedure
     1205         (input v-row-delta
     1206         ,input true
     1207         ) .
     1208       run diasize_change-width in this-procedure
     1209         (input v-col-delta
     1210         ,input true
     1211         ) .
     1212     end.
     1213   end procedure.
     1214   procedure diasize_maximize :
     1215     define input  parameter p-action as logical   no-undo .
     1216     do
     1217     on error undo, return error return-value
     1218     :
     1219       if p-action = ?
     1220       then do:
     1221         if v-diasize-need-maximize = true
     1222         then do:
     1223           assign
     1224             p-action = true
     1225           .
     1226         end.
     1227         else do:
     1228           assign
     1229             p-action = false
     1230           .
     1231         end.
     1232       end.
     1233       if p-action = true
     1234       then do:
     1235         run diasize_change-height in this-procedure
     1236           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1237               - frame Dialog-Frame :height-chars
     1238           ,input true
     1239           ) .
     1240         run diasize_change-width in this-procedure
     1241           (input session :width-chars
     1242               - frame Dialog-Frame :width-chars
     1243           ,input true
     1244           ) .
     1245         assign
     1246           v-diasize-need-maximize = false
     1247         .
     1248       end.
     1249       else do:
     1250         run diasize_change-width in this-procedure
     1251           (input v-diasize-orig-frame-width
     1252               - frame Dialog-Frame :width-chars
     1253           ,input true
     1254           ) .
     1255         run diasize_change-height in this-procedure
     1256           (input v-diasize-orig-frame-height
     1257               - frame Dialog-Frame :height-chars
     1258           ,input true
     1259           ) .
     1260         assign
     1261           v-diasize-need-maximize = true
     1262         .
     1263       end.
     1264     end.
     1265   end procedure.
     1266   procedure diasize_restore-orig-size :
     1267     do
     1268     on error undo, return error return-value
     1269     :
     1270       assign
     1271         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1272         v-diasize-current-frame-height = frame Dialog-Frame :height
     1273       .
     1274       run diasize_set-height in this-procedure
     1275         (input  v-diasize-orig-frame-height
     1276         ,input  true
     1277         ) .
     1278       run diasize_set-width in this-procedure
     1279         (input  v-diasize-orig-frame-width
     1280         ,input  true
     1281         ) .
     1282     end.
     1283   end procedure.
     1284   procedure diasize_restore-current-size :
     1285     do
     1286     on error undo, return error return-value
     1287     :
     1288       run diasize_set-height in this-procedure
     1289         (input  v-diasize-current-frame-height
     1290         ,input  true
     1291         ) .
     1292       run diasize_set-width in this-procedure
     1293         (input  v-diasize-current-frame-width
     1294         ,input  true
     1295         ) .
     1296     end.
     1297   end procedure.
     1298   procedure diasize_set-browse-handle :
     1299     define input  parameter p-browse-handle as handle   no-undo .
     1300     define buffer buf_temp-browse-handle for temp-browse-handle .
     1301     do
     1302     on error undo, return error return-value
     1303     :
     1304       assign
     1305         v-diasize-browse-handle = p-browse-handle
     1306       .
     1307       for each buf_temp-browse-handle
     1308       on error undo, return error return-value
     1309       :
     1310         delete buf_temp-browse-handle .
     1311       end.
     1312     end.
     1313   end procedure.
     1314   procedure diasize_add_browse :
     1315     define input  parameter p-browse-type   as character no-undo .
     1316     define input  parameter p-browse-handle as handle    no-undo .
     1317     define buffer buf_temp-browse-handle for temp-browse-handle .
     1318     do
     1319     on error undo, return error return-value
     1320     :
     1321       assign
     1322         v-diasize-browse-number = v-diasize-browse-number + 1
     1323       .
     1324       create buf_temp-browse-handle .
     1325       assign
     1326         buf_temp-browse-handle.browse-type   = p-browse-type
     1327         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1328         buf_temp-browse-handle.browse-handle = p-browse-handle
     1329       .
     1330     end.
     1331   end procedure.
     1332   procedure diasize_init :
     1333     define variable v-default-value    as logical   no-undo .
     1334     define variable v-restore-saved    as logical   no-undo .
     1335     define variable v-resize-value-str as character no-undo .
     1336     do
     1337     on error undo, return error return-value
     1338     :
     1339       do with frame Dialog-Frame
     1340       :
     1341         assign
     1342           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1343           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1344           v-diasize-browse-handle     = browse BR-pl-gds :handle
     1345         .
     1346         create button v-diasize-resize-button
     1347         assign
     1348           parent        = frame Dialog-Frame :first-child
     1349           label         = "s"
     1350           height-pixels = 16
     1351           width-pixels  = 16
     1352           visible       = true
     1353           sensitive     = true
     1354           movable       = true
     1355           triggers:
     1356             on end-move persistent run diasize_end-move in this-procedure .
     1357           end triggers.
     1358         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1359         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1360         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1361         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1362         assign
     1363           v-diasize-wndmax = false
     1364         .
     1365         if connected("ub") = true
     1366         then do:
     1367           define variable v-cntxt-db-num        as integer   no-undo .
     1368           define variable v-cntxt-userid        as character no-undo .
     1369           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1370                                             , OUTPUT v-cntxt-userid
     1371                                             ) .
     1372           run gbl/wndpar_r.p
     1373             (input  v-cntxt-db-num
     1374             ,input  v-cntxt-userid
     1375             ,input  'wndmax':U
     1376             ,output v-diasize-wndmax
     1377             ,output v-default-value
     1378             ) .
     1379         end.
     1380         assign
     1381           v-diasize-wndstore = false
     1382         .
     1383         if connected("ub") = true
     1384         then do:
     1385           run gbl/wndpar_r.p
     1386             (input  v-cntxt-db-num
     1387             ,input  v-cntxt-userid
     1388             ,input  'wndstore':U
     1389             ,output v-diasize-wndstore
     1390             ,output v-default-value
     1391             ) .
     1392         end.
     1393         assign
     1394           v-diasize-proc-name = entry(1, program-name(2), '.')
     1395         .
     1396         if v-diasize-wndstore = true
     1397         then do:
     1398           assign
     1399             v-restore-saved = false
     1400           .
     1401           if connected("ub") = true
     1402           then do:
     1403             run gbl/wndsizer.p
     1404               (input  v-cntxt-db-num
     1405               ,input  v-cntxt-userid
     1406               ,input  v-diasize-proc-name
     1407               ,input  'height':u
     1408               ,output v-resize-value-str
     1409               ) .
     1410             if v-resize-value-str <> '':U
     1411             then do:
     1412               run diasize_change-height in this-procedure
     1413                 (input  integer(v-resize-value-str)
     1414                 ,input  true
     1415                 ) .
     1416               assign
     1417                 v-restore-saved = true
     1418               .
     1419             end.
     1420           end.
     1421           if connected("ub") = true
     1422           then do:
     1423             run gbl/wndsizer.p
     1424               (input  v-cntxt-db-num
     1425               ,input  v-cntxt-userid
     1426               ,input  v-diasize-proc-name
     1427               ,input  'width':u
     1428               ,output v-resize-value-str
     1429               ) .
     1430             if v-resize-value-str <> '':U
     1431             then do:
     1432               run diasize_change-width in this-procedure
     1433                 (input  integer(v-resize-value-str)
     1434                 ,input  true
     1435                 ) .
     1436               assign
     1437                 v-restore-saved = true
     1438               .
     1439             end.
     1440           end.
     1441           if v-restore-saved <> true
     1442           then do:
     1443             if v-diasize-wndmax = true
     1444             then do:
     1445               run diasize_maximize in this-procedure
     1446                 (input  true
     1447                 ) .
     1448             end.
     1449           end.
     1450         end.
     1451         else do:
     1452           if v-diasize-wndmax = true
     1453           then do:
     1454             run diasize_maximize in this-procedure
     1455               (input  true
     1456               ) .
     1457           end.
     1458         end.
     1459       end.
     1460     end.
     1461   end procedure.
     1462   procedure diasize_need-full-display :
     1463     define output parameter p-need-full-display as logical   no-undo .
     1464     do
     1465     on error undo, return error return-value
     1466     :
     1467       assign
     1468         p-need-full-display = v-diasize-need-full-display
     1469       .
     1470       assign
     1471         v-diasize-need-full-display = false
     1472       .
     1473     end.
     1474   end procedure.
     1475   procedure get-context :
     1476      define output parameter p-db-num as integer          no-undo.
     1477      define output parameter p-user-id as character        no-undo.
     1478      define variable v-login               as character    no-undo.
     1479      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1480      define buffer buf_user-login  for ub.user-login .
     1481      do
     1482      on error undo, return error
     1483      :
     1484            FIND FIRST buf_sys-ctrl no-lock.
     1485            ASSIGN
     1486               v-login = USERID("ub")
     1487               p-db-num = buf_sys-ctrl.db-num
     1488            .
     1489            FIND FIRST buf_user-login
     1490                 WHERE buf_user-login.db-num = p-db-num
     1491                   AND buf_user-login.user-login = v-login
     1492                 no-lock
     1493                 no-error
     1494                 .
     1495            IF AVAILABLE buf_user-login
     1496            THEN DO:
     1497               assign
     1498                  p-user-id = buf_user-login.user-id
     1499               .
     1500            END.
     1501      end.
     1502   end procedure.
     1503       run diasize_init in this-procedure .
     1504   MAIN-BLOCK:
     1505   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1506      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1507     assign
     1508     X_pl-gds.tolerance:read-only in browse BR-pl-gds = true.
     1509     find first b-place no-lock where b-place.pl-code = in-pl-code no-error .
     1510     if not available b-place
     1511     then do :
     1512       return .
     1513     end .
     1514     empty temp-table tt-com-place .
     1515     run placelib_get-attr  ( input "place-com-tanks"
     1516                             ,input b-place.obj-code
     1517                             ,input b-place.obj-type
     1518                             ,input b-place.pl-code
     1519                             ,output v-value
     1520                             ,output v-ok      ) no-error.
     1521     if v-ok
     1522     and v-value > ""
     1523     then do :
     1524       v-value = b-place.loc1 + "," + v-value .
     1525       do ii = 1 to num-entries(v-value) :
     1526         find first b2-place no-lock where b2-place.obj-type = b-place.obj-type
     1527                                       and b2-place.obj-code = b-place.obj-code
     1528                                       and b2-place.loc1     = entry(ii, v-value)
     1529                                       and b2-place.status_  = ""
     1530                                       no-error .
     1531         if available b2-place
     1532         then do :
     1533           create tt-com-place .
     1534           assign tt-com-place.pl-code = b2-place.pl-code .
     1535         end .
     1536       end .
     1537     end .
     1538     RUN MyENable.
     1539     RUN OpenBR in this-procedure  ( input yes, input no, input '':U).
     1540     APPLY "ENTRY" to br-pl-gds.
     1541     WAIT-FOR GO OF FRAME Dialog-Frame.
     1542   END.
     1543   RUN disable_UI.
     1544   PROCEDURE disable_UI :
     1545     HIDE FRAME Dialog-Frame.
     1546   END PROCEDURE.
     1547   PROCEDURE enable_UI :
     1548     ENABLE B-exit B-sel B-Help BR-pl-gds
     1549         WITH FRAME Dialog-Frame.
     1550     VIEW FRAME Dialog-Frame.
     1551   END PROCEDURE.
     1552   PROCEDURE Myenable :
     1553   ASSIGN
     1554   br-pl-gds:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame = 1.
     1555   ENABLE
     1556   B-exit
     1557   B-sel
     1558   B-Help
     1559   BR-pl-gds
     1560   WITH FRAME Dialog-Frame .
     1561   VIEW FRAME Dialog-Frame .
     1562   END PROCEDURE.
     1563   PROCEDURE OpenBr :
     1564   define input  parameter p-open-query     as logical   no-undo .
     1565   define input  parameter p-find-next      as logical   no-undo .
     1566   define input  parameter p-find-condition as character no-undo .
     1567   define variable l-query-was-opened as logical no-undo .
     1568   define buffer buf_clients for ub.clients.
     1569   open query BR-pl-gds
     1570   for each tt-com-place,
     1571       each X_pl-gds where X_pl-gds.pl-code = tt-com-place.pl-code no-lock,
     1572       each X_goods where X_goods.gds-code = X_pl-gds.gds-code no-lock,
     1573       each X_place where X_place.obj-code = X_pl-gds.obj-code
     1574                      and X_place.obj-type = X_pl-gds.obj-type
     1575                      and X_place.pl-code  = X_pl-gds.pl-code
     1576                      no-lock
     1577   .
     1578   if avail X_pl-gds then
     1579   APPLY "VALUE-CHANGED":U to br-pl-gds in frame Dialog-Frame.
     1580   END PROCEDURE.
