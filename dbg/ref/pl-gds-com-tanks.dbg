      729       end.
      730     end.
      731     assign
      732       v-diasize-change-size = false
      733     .
      734   end procedure.
      735   procedure diasize_set-height :
      736     define input  parameter p-new-height  as decimal   no-undo .
      737     define input  parameter p-move-resize as logical   no-undo .
      738     do
      739     on error undo, return error return-value
      740     :
      741       run diasize_change-height in this-procedure
      742         (input  (p-new-height - frame Dialog-Frame :height)
      743         ,input  p-move-resize
      744         ) .
      745     end.
      746   end procedure.
      747   procedure diasize_change-width :
      748     define input  parameter p-change-value as decimal   no-undo .
      749     define input  parameter p-move-resize  as logical   no-undo .
      750     define variable v-field-group-handle   as handle    no-undo .
      751     define variable v-object-handle        as handle    no-undo .
      752     define variable v-frame-width          as decimal   no-undo .
      753     define variable v-frame-virtual-width  as decimal   no-undo .
      754     define variable v-browse-width         as decimal   no-undo .
      755     define variable v-window-width         as decimal   no-undo .
      756     define variable v-window-virtual-width as decimal   no-undo .
      757     define variable v-change-sign          as integer   no-undo .
      758     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      759     define buffer buf_temp-browse-handle  for temp-browse-handle .
      760     if p-change-value > 0
      761     then do:
      762       if frame Dialog-Frame :width + p-change-value >
      763           session :width-chars
      764       then do:
      765         assign
      766           p-change-value = session :width-chars - frame Dialog-Frame :width
      767         .
      768         if p-change-value <= 0
      769         then do:
      770           run diasize_position-resize-button in this-procedure .
      771           return .
      772         end.
      773       end.
      774     end.
      775     if p-change-value < 0
      776     then do:
      777       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      778       then do:
      779         assign
      780           p-change-value = v-diasize-orig-frame-width
      781                          - frame Dialog-Frame :width
      782         .
      783         if p-change-value >= 0
      784         then do:
      785           run diasize_position-resize-button in this-procedure .
      786           return .
      787         end.
      788       end.
      789     end.
      790     if p-change-value >= 0
      791     then do:
      792       assign
      793         v-change-sign = 1
      794       .
      795     end.
      796     else do:
      797       assign
      798         v-change-sign = -1
      799       .
      800     end.
      801     assign
      802       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      803     .
      804     if p-change-value = 0
      805     then do:
      806       run diasize_position-resize-button in this-procedure .
      807       return .
      808     end.
      809     move_block:
      810     do
      811     on error undo move_block, leave move_block
      812     :
      813       if retry
      814       then do:
      815         do
      816         on error undo move_block, leave move_block
      817         :
      818           if p-change-value > 0
      819           then do:
      820             for each buf_temp-diasize-handle
      821             on error undo, next
      822             :
      823               assign
      824                 v-object-handle = buf_temp-diasize-handle.handle-value
      825               .
      826               if v-object-handle <> v-diasize-resize-button
      827               then do:
      828                 assign
      829                   v-object-handle :col = buf_temp-diasize-handle.save-position
      830                 .
      831               end.
      832             end.
      833             assign
      834               v-diasize-browse-handle :width = v-browse-width
      835             .
      836             for each buf_temp-browse-handle
      837               where buf_temp-browse-handle.browse-type = 'width':u
      838             on error undo, next
      839             :
      840               assign
      841                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      842               .
      843             end.
      844             assign
      845               frame Dialog-Frame :width = v-frame-width
      846             .
      847             if frame Dialog-Frame :scrollable = true
      848             then do:
      849               assign
      850                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      851               .
      852             end.
      853             run diasize_position-resize-button in this-procedure .
      854           end.
      855           else do:
      856             if frame Dialog-Frame :scrollable = true
      857             then do:
      858               assign
      859                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      860               .
      861             end.
      862             assign
      863               frame Dialog-Frame :width = v-frame-width
      864             .
      865             for each buf_temp-browse-handle
      866               where buf_temp-browse-handle.browse-type = 'width':u
      867             on error undo, next
      868             :
      869               assign
      870                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      871               .
      872             end.
      873             assign
      874               v-diasize-browse-handle :width = v-browse-width
      875             .
      876             for each buf_temp-diasize-handle
      877             on error undo, next
      878             :
      879               assign
      880                 v-object-handle = buf_temp-diasize-handle.handle-value
      881               .
      882               if v-object-handle <> v-diasize-resize-button
      883               then do:
      884                 assign
      885                   v-object-handle :col = buf_temp-diasize-handle.save-position
      886                 .
      887               end.
      888             end.
      889             run diasize_position-resize-button in this-procedure .
      890           end.
      891           assign
      892             v-diasize-change-size = false
      893           .
      894           leave move_block .
      895         end.
      896       end.
      897       assign
      898         v-diasize-need-full-display = true
      899       .
      900       if v-diasize-change-size = false
      901       then do:
      902         assign
      903           v-diasize-change-size = true
      904         .
      905       end.
      906       else do:
      907         return .
      908       end.
      909       assign
      910         v-frame-width = frame Dialog-Frame :width
      911         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      912         v-browse-width = v-diasize-browse-handle :width
      913       .
      914       for each buf_temp-browse-handle
      915         where buf_temp-browse-handle.browse-type = 'width':u
      916       :
      917         assign
      918           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      919         .
      920       end.
      921       for each buf_temp-diasize-handle
      922       :
      923         delete buf_temp-diasize-handle .
      924       end.
      925       assign
      926         v-field-group-handle = frame Dialog-Frame :first-child
      927       .
      928       do while valid-handle(v-field-group-handle)
      929       :
      930         assign
      931           v-object-handle = v-field-group-handle :first-child
      932         .
      933         do while valid-handle(v-object-handle)
      934         :
      935           if  v-object-handle <> v-diasize-browse-handle :handle
      936           and v-object-handle <> v-diasize-resize-button
      937           and can-query(v-object-handle, "row")
      938           and can-query(v-object-handle, "height")
      939           and ( v-object-handle :col + v-object-handle :width
      940                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      941               )
      942           then do:
      943             find first buf_temp-browse-handle
      944               where buf_temp-browse-handle.browse-type   = 'width':u
      945                 and buf_temp-browse-handle.browse-handle = v-object-handle
      946               no-error .
      947             if available buf_temp-browse-handle
      948             then do:
      949             end.
      950             else do:
      951               create buf_temp-diasize-handle .
      952               assign
      953                 buf_temp-diasize-handle.handle-value  = v-object-handle
      954                 buf_temp-diasize-handle.save-position = v-object-handle :col
      955               .
      956             end.
      957           end.
      958           assign
      959             v-object-handle = v-object-handle :next-sibling
      960           .
      961         end.
      962         assign
      963           v-field-group-handle = v-field-group-handle :next-sibling
      964         .
      965       end.
      966       do with frame Dialog-Frame
      967       :
      968         hide v-diasize-resize-button .
      969         v-diasize-resize-button :row = 1.
      970         v-diasize-resize-button :column = 1.
      971       end.
      972       if p-change-value > 0
      973       then do:
      974         if frame Dialog-Frame :scrollable = true
      975         then do:
      976           assign
      977             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      978             no-error .
      979           if error-status :error
      980           or error-status :get-message(1) <> ""
      981           then do:
      982             undo move_block, retry move_block.
      983           end.
      984         end.
      985         assign
      986           frame Dialog-Frame :width = v-frame-width + p-change-value
      987           no-error .
      988         if error-status :error
      989         or error-status :get-message(1) <> ""
      990         then do:
      991           undo move_block, retry move_block.
      992         end.
      993         assign
      994           v-diasize-browse-handle :width = v-browse-width + p-change-value
      995         no-error .
      996         if error-status :error
      997         or error-status :get-message(1) <> ""
      998         then do:
      999           undo move_block, retry move_block.
     1000         end.
     1001         for each buf_temp-browse-handle
     1002           where buf_temp-browse-handle.browse-type = 'width':u
     1003         on error undo move_block, retry move_block
     1004         :
     1005           assign
     1006             buf_temp-browse-handle.browse-handle :width
     1007               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1008             no-error .
     1009           if error-status :error
     1010           or error-status :get-message(1) <> ""
     1011           then do:
     1012             undo move_block, retry move_block .
     1013           end.
     1014         end.
     1015         for each buf_temp-diasize-handle
     1016         on error undo move_block, retry move_block
     1017         :
     1018           assign
     1019             v-object-handle = buf_temp-diasize-handle.handle-value
     1020           .
     1021           if v-object-handle <> v-diasize-resize-button
     1022           then do:
     1023             assign
     1024               v-object-handle :col = v-object-handle :col + p-change-value
     1025               no-error .
     1026             if error-status :error
     1027             or error-status :get-message(1) <> ""
     1028             then do:
     1029               undo move_block, retry move_block .
     1030             end.
     1031           end.
     1032         end.
     1033       end.
     1034       else do:
     1035         for each buf_temp-diasize-handle
     1036         on error undo move_block, retry move_block
     1037         :
     1038           assign
     1039             v-object-handle = buf_temp-diasize-handle.handle-value
     1040           .
     1041           if v-object-handle <> v-diasize-resize-button
     1042           then do:
     1043             assign
     1044               v-object-handle :col = v-object-handle :col + p-change-value
     1045               no-error .
     1046             if error-status :error
     1047             or error-status :get-message(1) <> ""
     1048             then do:
     1049               undo move_block, retry move_block .
     1050             end.
     1051           end.
     1052         end.
     1053         for each buf_temp-browse-handle
     1054           where buf_temp-browse-handle.browse-type = 'width':u
     1055         on error undo move_block, retry move_block
     1056         :
     1057           assign
     1058             buf_temp-browse-handle.browse-handle :width
     1059               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1060             no-error .
     1061           if error-status :error
     1062           or error-status :get-message(1) <> ""
     1063           then do:
     1064             undo move_block, retry move_block .
     1065           end.
     1066         end.
     1067         assign
     1068           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1069           no-error .
     1070         if error-status :error
     1071         or error-status :get-message(1) <> ""
     1072         then do:
     1073           undo move_block, retry move_block.
     1074         end.
