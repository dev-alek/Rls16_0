      129     index code is         unique gds-code
      130     index oi order-num
      131     index isel to-sel
      132     .
      133   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   define  new shared  temp-table gds-list-hist no-undo
      135   field list-table as character
      136   field id as integer
      137   field line as integer
      138   field hist-mode as character
      139   field des as character
      140   field num-recs as integer
      141   field option_ as character
      142   field item_ as character
      143   field status_ as character
      144   field num-add as integer
      145   field num-ignored as integer
      146   field done as logical
      147   field err_ as logical
      148   field err-mes as character
      149   index pi is primary
      150   id
      151   line
      152   index isdone
      153   done
      154   .
      155   def buffer b-sert for ub.sert.
      156   DEFINE BUTTON b-cli
      157        LABEL ""
      158        SIZE 2.5 BY .96.
      159   DEFINE BUTTON b-gds
      160        LABEL "Товар(ы)"
      161        SIZE 10 BY 1 TOOLTIP "Выбор одного или нескольких товаров".
      162   DEFINE BUTTON b-help
      163        LABEL "Помощь"
      164        SIZE 10 BY 1
      165        BGCOLOR 8 .
      166   DEFINE BUTTON b-hist
      167        LABEL "История"
      168        SIZE 10 BY 1 TOOLTIP "История сертификата".
      169   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      170        LABEL "Отмена"
      171        SIZE 10 BY 1
      172        BGCOLOR 8 .
      173   DEFINE BUTTON Btn_OK AUTO-GO
      174        LABEL "Ввод"
      175        SIZE 10 BY 1 TOOLTIP "Вод сертификата"
      176        BGCOLOR 8 .
      177   DEFINE VARIABLE v-c-name AS CHARACTER FORMAT "X(30)":U
      178        VIEW-AS FILL-IN
      179        SIZE 41.13 BY 1 NO-UNDO.
      180   DEFINE FRAME Dialog-Frame
      181        Btn_OK AT ROW 1 COL 1
      182        Btn_Cancel AT ROW 1 COL 11
      183        b-gds AT ROW 1 COL 31
      184        b-hist AT ROW 1 COL 41
      185        b-help AT ROW 1 COL 51
      186        ub.sert.cli-code AT ROW 4.04 COL 1 NO-LABEL
      187             VIEW-AS FILL-IN
      188             SIZE 14 BY 1
      189        ub.sert.cli-type AT ROW 4.04 COL 12.88 COLON-ALIGNED NO-LABEL
      190             VIEW-AS FILL-IN
      191             SIZE 6.5 BY 1
      192        v-c-name AT ROW 4.04 COL 22 COLON-ALIGNED NO-LABEL
      193        b-cli AT ROW 4.08 COL 21.5
      194        ub.sert.sert-code AT ROW 5.58 COL 12.5 COLON-ALIGNED FORMAT "X(35)"
      195             VIEW-AS FILL-IN
      196             SIZE 37 BY 1 TOOLTIP "Код сертификата"
      197        ub.sert.first-date AT ROW 6.92 COL 12.63 COLON-ALIGNED
      198             VIEW-AS FILL-IN
      199             SIZE 11 BY 1 TOOLTIP "Дата начала действия сертификата"
      200        ub.sert.last-date AT ROW 6.92 COL 47.25 COLON-ALIGNED
      201             LABEL "Дата окончания"
      202             VIEW-AS FILL-IN
      203             SIZE 11 BY 1 TOOLTIP "Дата окончания сертификата"
      204        ub.sert.sert-org AT ROW 8.17 COL 26 COLON-ALIGNED WIDGET-ID 2
      205             VIEW-AS FILL-IN
      206             SIZE 37 BY 1
      207        ub.sert.blank-num AT ROW 9.5 COL 13 COLON-ALIGNED WIDGET-ID 4
      208             VIEW-AS FILL-IN
      209             SIZE 21 BY 1
      210        ub.sert.PS AT ROW 10.79 COL 13 COLON-ALIGNED
      211             VIEW-AS FILL-IN
      212             SIZE 50.13 BY 1
      213        "Поставщик/Производитель:" VIEW-AS TEXT
      214             SIZE 28.75 BY .92 AT ROW 3.17 COL 1
      215        SPACE(35.37) SKIP(8.07)
      216       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      217            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      218            TITLE "Добавление/изменение сертификата"
      219            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.
      220   ASSIGN
      221          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      222          FRAME Dialog-Frame:HIDDEN           = TRUE.
      223   ASSIGN
      224          b-cli:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      225   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      226   DO:
      227     APPLY "END-ERROR":U TO SELF.
      228   END.
      229   ON CHOOSE OF b-gds IN FRAME Dialog-Frame
      230   DO:
      231     def var g-l as log init no no-undo.
      232     define variable v-host-code like ub.sysconf.host-code no-undo .
      233     message "Вы хотите задать этот сертификат для товара(ов)?"
      234       view-as alert-box question buttons Yes-No update g-l.
      235     if g-l then do:
      236   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      237   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      238     (input  p-curr-obj-type
      239     ,input  p-curr-obj-code
      240     ,output v-host-code
      241     )  .
      242      run str/gds-list.w (
      243                    input parparentproc
      244                   ,input v-host-code
      245                   ,input p-curr-obj-type
      246                   ,input p-curr-obj-code).
      247     end.
      248   END.
      249   ON CHOOSE OF b-hist IN FRAME Dialog-Frame
      250   DO:
      251       DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      252     IF NOT AVAILABLE ub.sert THEN RETURN.
      253     run ref/c-serts.w (
      254                   INPut parParentProc
      255                  ,INPUT '':U
      256                  ,INPUT 'onet'
      257                  ,INPUT sert.cli-type
      258                  ,INPUT sert.cli-code
      259                  ,INPUT sert.sert-code
      260                  ,INPUT 0
      261                  ,INPUT '':U
      262                  ,INPUT-OUTPUT v-rid-list) NO-ERROR.
      263   END.
      264   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      265   DO:
      266   define variable v-ii as integer no-undo .
      267   define variable v-ok  as integer no-undo .
      268   define variable v-err as integer no-undo .
      269   define variable v-host-code like ub.sysconf.host-code no-undo .
      270   def var p-l as log init no no-undo.
      271     if can-find(first b-sert where
      272                       b-sert.cli-type = ub.sert.cli-type and
      273                       b-sert.cli-code =  ub.sert.cli-code and
      274                       b-sert.sert-code = input ub.sert.sert-code and
      275                       recid(b-sert) <> recid(ub.sert) ) then do:
      276       message "По данному клиенту уже есть сертификат с кодом " input sert.sert-code
      277               sert.cli-type  sert.cli-code       view-as alert-box error.
      278       return no-apply.
      279     end.
      280     assign
      281     sert.last-date
      282     sert.first-date
      283     sert.ps
      284     sert.blank-num
      285     sert.sert-org
      286     ub.sert.sert-code.
      287     if sert.last-date = ? then do:
      288       message "Введите дату окончания сертификата" view-as alert-box error.
      289       return no-apply.
      290     end.
      291     if sert.first-date = ? then do:
      292       message "Введите дату начала действия сертификата" view-as alert-box error.
      293       return no-apply.
      294     end.
      295     if sert.sert-code = ?
      296     or sert.sert-code = ''
      297     then do:
      298       message "Введите номер сертификата" view-as alert-box error.
      299       return no-apply.
      300     end.
      301     if can-find(first gds-list) or
      302        can-find (first ub.sert-join where
      303                        ub.sert-join.cli-type = i-type and
      304                        ub.sert-join.cli-code = i-code AND
      305                        ub.sert-join.SERT-code = input ub.sert.sert-code
      306                        ) then.
      307     else do:
      308       if i-mode = 'ДОБАВЛЕНИЕ':U then do:
      309   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      310   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      311     (input  p-curr-obj-type
      312     ,input  p-curr-obj-code
      313     ,output v-host-code
      314     )  .
      315         run str/gds-list.w (
      316                       input parparentproc
      317                       ,input v-host-code
      318                       ,input p-curr-obj-type
      319                       ,input p-curr-obj-code).
      320       end.
      321       IF NOT CAN-FIND(FIRST GDS-LIST) THEN DO:
      322         message "Нет ни одного товара для данного сертификата. Будете задавать товар?"
      323             view-as alert-box question buttons Yes-No update g-log as log.
      324             if g-log then do:
      325                 enable b-gds with frame Dialog-Frame.
      326                 disp b-gds   with frame Dialog-Frame.
      327                 return no-apply.
      328             end.
      329             else p-l = yes.
      330       end.
      331     end.
      332     if not p-l then run cre-s-j(output v-ii, output v-ok, output v-err).
      333     message
      334     substitute("Обработано &1 товаров, создано &2 привязок к сертификату, ошибок &3", v-ii, v-ok, v-err)
      335     view-as alert-box .
      336     i-rec = recid(sert).
      337   END.
      338   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      339   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      340   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      341   on help of frame Dialog-Frame
      342   do:
      343     run gbl/app_help.p
      344       (input this-procedure :file-name
      345       ,input ''
      346       ,input ?
      347       ) no-error.
      348     if error-status :error then do:
      349       message
      350         "Ошибка при вызове помощи"
      351         error-status :get-message(1)
      352         view-as alert-box .
      353     end.
      354   end.
      355   run minbtn-set in this-procedure .
      356   on choose of b-help in frame Dialog-Frame
      357   do:
      358     apply "help":u to frame Dialog-Frame .
      359   end.
      360   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      361   procedure minbtn-set :
      362       do
      363           on error undo, return error return-value
      364           :
      365           define variable ii              as integer       no-undo .
      366           define variable fh              as widget-handle no-undo .
      367           define variable hh              as widget-handle no-undo .
      368           define variable v-h             as handle        extent 4 no-undo .
      369           define variable v-name-button   as character     no-undo .
      370           define variable v-help-old-x    as decimal       no-undo .
      371           define variable v-help-old-y    as decimal       no-undo .
      372           define variable v-help-old-size as decimal       no-undo .
      373           define variable v-frame-width   as decimal       no-undo .
      374           define variable jj              as integer       no-undo .
      375           do
      376               on error undo, return error
      377               :
      378               assign
      379                   v-frame-width = frame Dialog-Frame:width - 0.3
      380                   fh            = frame Dialog-Frame:first-child
      381                   hh            = fh:first-child
      382                   ii            = 1
      383                   .
      384               do while valid-handle(hh):
      385                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      386                   do:
      387                       case lc(hh:name) :
      388                           when "b-help" then
      389                               do:
      390                                   hh:load-image-up("cmp/b-help.bmp":u) .
      391                                   hh:load-image-down("cmp/b-help.bmp":u) .
      392                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      393                                   hh:TOOLTIP = "Помощь" .
      394                                   v-help-old-x = hh:column .
      395                                   v-help-old-y = hh:row    .
      396                                   v-help-old-size = hh:width .
      397                                   hh:width-chars = 2.5 .
      398                               end.
      399                           when "b-print" then
      400                               do:
      401                                   hh:load-image("cmp/b-print.bmp":u) .
      402                                   hh:TOOLTIP = "Печать" .
      403                                   v-h[ii] = hh:handle .
      404                                   ii = ii + 1 .
      405                                   hh:width-chars = 3 .
      406                               end.
      407                           when "b-history" or
      408                           when "b-hist" then
      409                               do:
      410                                   hh:load-image("cmp/b-hist.bmp":u) .
      411                                   hh:TOOLTIP = "История" .
      412                                   v-h[ii] = hh:handle .
      413                                   ii = ii + 1 .
      414                                   hh:width-chars = 3 .
      415                               end.
      416                           when "b-sch" then
      417                               do:
      418                                   hh:load-image("cmp/b-sch.bmp":u) .
      419                                   hh:TOOLTIP = "Установка Фильтра" .
      420                                   v-h[ii] = hh:handle .
      421                                   ii = ii + 1 .
      422                                   hh:width-chars = 3 .
      423                               end.
      424                           when "b-hist-user" then
      425                               do:
      426                                   hh:load-image("cmp/b-hist.bmp":u) .
      427                                   hh:TOOLTIP = "История пользователя" .
      428                                   ii = ii + 1 .
      429                               end.
      430                       end case.
      431                   end.
      432                   hh = hh:next-sibling.
      433               end.
      434               b-help:column = v-frame-width - b-help:width-chars.
      435               jj = 0.
      436               repeat ii = 4 to 1 by -1 :
      437                   if valid-handle (v-h[ii] ) then
      438                   do:
      439                       jj  = jj + 1 .
      440                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      441                       v-h[ii]:row    = v-help-old-y .
      442                   end.
      443               end.
      444           end.
      445       end.
      446   end procedure.
      447   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      448   on ' ' of ub.sert.first-date in frame Dialog-Frame
      449   do:
      450     if (can-query (self, "sensitive")
      451        and
      452        self :sensitive = true
      453        )
      454     or (can-query (self, "read-only")
      455        and
      456        self :read-only = false
      457        )
      458     then do:
      459       assign
      460         self :screen-value = ?
      461       .
      462     end.
      463     return no-apply.
      464   end.
      465   on delete-character of ub.sert.first-date in frame Dialog-Frame
      466   do:
      467     if (can-query (self, "sensitive")
      468        and
      469        self :sensitive = true
      470        )
      471     or (can-query (self, "read-only")
      472        and
      473        self :read-only = false
      474        )
      475     then do:
      476       assign
      477         self :screen-value = ?
      478       .
      479     end.
      480     return no-apply.
      481   end.
      482   on ctrl-d of ub.sert.first-date in frame Dialog-Frame
      483   do:
      484     define variable v-curr-sv-date as date no-undo .
      485     if (can-query (self, "sensitive")
      486        and
      487        self :sensitive = true
      488        )
      489     or (can-query (self, "read-only")
      490        and
      491        self :read-only = false
      492        )
      493     then do:
      494       if self :handle <> focus :handle
      495       then do:
      496         apply "entry":u to self .
      497       end.
      498       run gbl/getcurdt.p
      499         (output v-curr-sv-date
      500         ) .
      501       assign
      502         self :screen-value = string(v-curr-sv-date) .
      503       .
      504     end.
      505     return no-apply.
      506   end.
      507   on ctrl-b of ub.sert.first-date in frame Dialog-Frame
      508   do:
      509     if (can-query (self, "sensitive")
      510        and
      511        self :sensitive = true
      512        )
      513     or (can-query (self, "read-only")
      514        and
      515        self :read-only = false
      516        )
      517     then do:
      518       if self :handle <> focus :handle
      519       then do:
      520         apply "entry":u to self .
      521       end.
      522       define variable v-curr-sv-date as date no-undo .
      523       define variable v-new-sv-date  as date no-undo .
      524       assign
      525         v-curr-sv-date = date(self :screen-value) no-error
      526       .
      527       if v-curr-sv-date = ?
      528       then do:
      529         run gbl/getcurdt.p
      530           (output v-curr-sv-date
      531           ) .
      532       end.
      533       if v-curr-sv-date <> ?
      534       then do:
      535         assign
      536           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      537         .
      538         assign
      539           self :screen-value = string(v-new-sv-date) .
      540         .
      541       end.
      542     end.
      543     return no-apply .
