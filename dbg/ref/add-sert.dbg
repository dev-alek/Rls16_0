      893   MAIN-BLOCK:
      894   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      895      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      896      find ub.clients where ub.clients.obj-type = i-type and
      897                                   ub.clients.obj-code = i-code no-lock.
      898      if i-mode = 'ДОБАВЛЕНИЕ':U then do:
      899           disable b-gds with frame Dialog-Frame.
      900           create ub.sert.
      901           assign
      902               ub.sert.cli-type = i-type
      903               ub.sert.cli-code = i-code.
      904      end.
      905      else do:
      906         find ub.sert where recid(ub.sert) = i-rec.
      907         enable b-gds with frame Dialog-Frame.
      908      end.
      909      v-c-name = ub.clients.obj-name.
      910     RUN Myenable.
      911       WAIT-FOR GO OF FRAME Dialog-Frame.
      912   END.
      913   RUN disable_UI.
      914   PROCEDURE cre-s-j :
      915   define buffer gl-goods for ub.goods.
      916   define output parameter v-ii as integer no-undo .
      917   define output parameter v-ok  as integer no-undo .
      918   define output parameter v-err as integer no-undo .
      919   define variable v-b-code like ub.bar-code.b-code no-undo .
      920     _gds-list:
      921     for each gds-list :
      922       assign
      923       v-ii = v-ii + 1
      924       .
      925       find first gl-goods where
      926                 gl-goods.artic     = gds-list.artic     and
      927                 gl-goods.prod-type = gds-list.prod-type and
      928                 gl-goods.prod-code = gds-list.prod-code no-lock.
      929       FIND ub.gds-prt WHERE
      930            ub.gds-prt.upper-code = gds-list.prt-root NO-LOCK .
      931   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      932     (input  gl-goods.gds-code
      933     ,input  ?
      934     ,output v-b-code
      935     )  .
      936       find first ub.sert-join where
      937                 ub.sert-join.cli-type = i-type and
      938                 ub.sert-join.cli-code = i-code and
      939                 ub.sert-join.sert-code = ub.sert.sert-code and
      940                 ub.sert-join.b-code = v-b-code no-error.
      941       if not available ub.sert-join then do:
      942           create ub.sert-join.
      943           assign
      944           ub.sert-join.cli-type = i-type
      945           ub.sert-join.cli-code = i-code
      946           ub.sert-join.sert-code = ub.sert.sert-code
      947           ub.sert-join.b-code = v-b-code .
      948           release ub.sert-join no-error .
      949       end.
      950       if error-status:error then do:
      951         assign
      952         v-err = v-err + 1
      953         .
      954       end.
      955       else do:
      956         assign
      957         v-ok = v-ok + 1
      958         .
      959       end.
      960     end.
      961   END PROCEDURE.
      962   PROCEDURE disable_UI :
      963     HIDE FRAME Dialog-Frame.
      964   END PROCEDURE.
      965   PROCEDURE enable_UI :
      966     DISPLAY v-c-name
      967         WITH FRAME Dialog-Frame.
      968     IF AVAILABLE ub.sert THEN
      969       DISPLAY ub.sert.cli-code ub.sert.cli-type ub.sert.sert-code ub.sert.first-date
      970             ub.sert.last-date ub.sert.sert-org ub.sert.blank-num ub.sert.PS
      971         WITH FRAME Dialog-Frame.
      972     ENABLE Btn_OK Btn_Cancel b-gds b-hist b-help ub.sert.sert-code
      973            ub.sert.first-date ub.sert.last-date ub.sert.sert-org
      974            ub.sert.blank-num ub.sert.PS
      975         WITH FRAME Dialog-Frame.
      976     VIEW FRAME Dialog-Frame.
      977   END PROCEDURE.
      978   PROCEDURE MyEnable :
      979   DISPLAY
      980   v-c-name
      981   WITH FRAME Dialog-Frame.
      982   IF AVAILABLE ub.sert THEN
      983    DISPLAY
      984    ub.sert.cli-code
      985    ub.sert.cli-type
      986    ub.sert.sert-code
      987    ub.sert.first-date
      988    ub.sert.blank-num
      989    ub.sert.sert-org
      990    ub.sert.last-date
      991    ub.sert.PS
      992    WITH FRAME Dialog-Frame.
      993     ENABLE
      994     ub.sert.sert-code when i-mode = 'ДОБАВЛЕНИЕ':U
      995     ub.sert.first-date
      996     ub.sert.last-date
      997     ub.sert.blank-num
      998     ub.sert.sert-org
      999     ub.sert.PS
     1000     Btn_OK
     1001     Btn_Cancel
     1002     b-gds
     1003     b-help
     1004     b-hist WHEN i-mode <> 'ДОБАВЛЕНИЕ':U
     1005     WITH FRAME Dialog-Frame.
     1006     VIEW FRAME Dialog-Frame.
     1007   END PROCEDURE.
