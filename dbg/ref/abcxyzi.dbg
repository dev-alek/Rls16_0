      515   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      516   procedure cur-time :
      517      define output parameter p-today as date      no-undo .
      518      define output parameter p-time  as integer   no-undo .
      519     do
      520     on error undo, return error
      521     :
      522       define variable v-date1 as date      no-undo .
      523       define variable v-date2 as date      no-undo .
      524       define variable v-time  as integer   no-undo .
      525       assign
      526         v-date1 = today
      527         v-time  = time
      528         v-date2 = today
      529       .
      530       if v-date1 <> v-date2
      531       then do:
      532         assign
      533           v-date1 = today
      534           v-time  = v-time
      535         .
      536       end.
      537       assign
      538         p-today = v-date1
      539         p-time  = v-time
      540       .
      541     end.
      542   end.
      543   function cur-time-date returns character
      544   :
      545     return string(today, '99/99/9999':U) .
      546   end.
      547   function cur-time-mjd returns decimal
      548   :
      549     define variable v-date as date      no-undo .
      550     define variable v-time as integer   no-undo .
      551     run cur-time in this-procedure
      552       (output v-date
      553       ,output v-time
      554       ) .
      555     return integer(v-date) - 2400002 + (v-time / 86400) .
      556   end.
      557   function cur-time-get-ending-index returns integer
      558   (input p-number as integer
      559   )
      560   :
      561     if p-number < 0
      562     or p-number = ?
      563     then do:
      564       return 1 .
      565     end.
      566     define variable v-rest as integer   no-undo .
      567     assign
      568       p-number = p-number modulo 100
      569     .
      570     if p-number < 20
      571     then do:
      572       assign
      573         v-rest = p-number
      574       .
      575     end.
      576     else do:
      577       assign
      578         v-rest = p-number modulo 10
      579       .
      580     end.
      581     case v-rest :
      582       when 1
      583       then do:
      584         return 2 .
      585       end.
      586       when 2 or
      587       when 3 or
      588       when 4
      589       then do:
      590         return 3 .
      591       end.
      592       otherwise do:
      593         return 1 .
      594       end.
      595     end case .
      596   end.
      597   procedure cur-time-mjd-to-date :
      598      define input  parameter i-mjd-diff as decimal no-undo.
      599      define output parameter o-Date     as date    no-undo.
      600      define output parameter o-Time     as integer no-undo.
      601      define variable v-day-number as integer   no-undo .
      602      if    i-mjd-diff < 0
      603         or i-mjd-diff = ?
      604      then do:
      605         return "?" .
      606      end.
      607      assign
      608         v-day-number = truncate(i-mjd-diff,0).
      609         o-Date = date(v-day-number + 2400002).
      610         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      611     .
      612   end.
      613   function cur-time-mjd-to-string returns character
      614   (input p-mjd-diff as decimal
      615   )
      616   :
      617     define variable v-day-number as integer   no-undo .
      618     define variable v-seconds    as integer   no-undo .
      619     define variable v-hour       as integer   no-undo .
      620     define variable v-min        as integer   no-undo .
      621     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      622     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      623     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      624     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      625     if p-mjd-diff < 0
      626     or p-mjd-diff = ?
      627     then do:
      628       return "?" .
      629     end.
      630     assign
      631       v-day-number = integer(truncate(p-mjd-diff,0))
      632       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      633     .
      634     if v-seconds > 86400
      635     then do:
      636       assign
      637         v-seconds = 86400 - 1
      638       .
      639     end.
      640     if v-seconds < 0
      641     then do:
      642       assign
      643         v-seconds = 0
      644       .
      645     end.
      646     assign
      647       v-hour = truncate(v-seconds / 3600, 0)
      648     .
      649     assign
      650       v-seconds = v-seconds modulo 3600
      651     .
      652     assign
      653       v-min = truncate(v-seconds / 60, 0)
      654     .
      655     assign
      656       v-seconds = v-seconds modulo 60
      657     .
      658     return
      659         (if v-day-number <> 0
      660           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      661           else ""
      662         )
      663       + (if v-day-number <> 0 or v-hour <> 0
      664           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      665           else ""
      666         )
      667       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      668           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      669           else ""
      670         )
      671       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      672       .
      673   end.
      674   function cur-time-string returns character
      675   :
      676     define variable v-date as date      no-undo .
      677     define variable v-time as integer   no-undo .
      678     run cur-time in this-procedure
      679       (output v-date
      680       ,output v-time
      681       ) .
      682     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      683   end.
      684   function cur-time-string-sec returns character
      685   :
      686     define variable v-date as date      no-undo .
      687     define variable v-time as integer   no-undo .
      688     run cur-time in this-procedure
      689       (output v-date
      690       ,output v-time
      691       ) .
      692     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      693   end.
      694   function cur-time-custom  returns character
      695   (input p-prefix as character
      696   ,input p-date-format as character
      697   ,input p-delimiter as character
      698   ,input p-time-format as character
      699   ,input p-suffix as character
      700   )
      701   :
      702     define variable v-date as date      no-undo .
      703     define variable v-time as integer   no-undo .
      704     run cur-time in this-procedure
      705       (output v-date
      706       ,output v-time
      707       ) .
      708     return
      709       p-prefix
      710       + string(v-date, p-date-format)
      711       + p-delimiter
      712       + string(v-time, p-time-format)
      713       + p-suffix
      714       .
      715   end.
      716   function cur-time-print  returns character
      717   :
      718     define variable v-date as date      no-undo .
      719     define variable v-time as integer   no-undo .
      720     run cur-time in this-procedure
      721       (output v-date
      722       ,output v-time
      723       ) .
      724     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      725   end.
      726   function cur-time-datetime returns datetime
      727   :
      728     define variable v-char as character no-undo .
      729     define variable v-datetime as datetime no-undo .
      730     v-char = cur-time-string().
      731     v-datetime = datetime(v-char).
      732     return  v-datetime.
      733   end.
      734   function cur-time-string-msec returns character
      735   :
      736     define variable v-date as datetime  no-undo .
      737     v-date = now.
      738     return string(v-date) .
      739   end.
      740   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      741   define temp-table temp-index_name-value no-undo
      742   field name-key  as character
      743   field value-key as character
      744   index pi name-key
      745   .
      746   define temp-table temp-sub-index_name no-undo
      747   field name-key  as character
      748   field nn as integer
      749   index pi nn
      750   .
      751   procedure def-hash :
      752     do
      753     on error undo, return error return-value
      754     :
      755     define input  parameter p-full-string as character no-undo .
      756     define output parameter p-possb-keep-string as logical   no-undo .
      757     define output parameter p-string            as character no-undo .
      758     define output parameter p-hash-string       as character no-undo .
      759       p-full-string = trim( p-full-string ) .
      760       if length (p-full-string ) > 150 then do:
      761       assign
      762         p-possb-keep-string =  false
      763         p-string            =  substring(p-full-string,1,150)
      764         p-hash-string       =  encode(p-full-string)
      765       .
      766       end.
      767       else do:
      768       assign
      769         p-possb-keep-string =  true
      770         p-string            =  p-full-string
      771         p-hash-string       =  encode(p-full-string)
      772       .
      773       end.
      774     end.
      775   end procedure.
      776   procedure find-from-hash :
      777     do
      778     on error undo, return error return-value
      779     :
      780   define input  parameter  p-full-string            as character no-undo .
      781   define input  parameter  p-table-name             as character no-undo .
      782   define input  parameter  p-field-possb-keep-name  as character no-undo .
      783   define input  parameter  p-field-string-name      as character no-undo .
      784   define input  parameter  p-field-hash-string-name as character no-undo .
      785   define input  parameter  p-sub-table-name         as character no-undo .
      786   define output parameter  p-recid                  as recid     no-undo .
      787   define variable v-possb-keep-string as logical   no-undo .
      788   define variable v-string            as character no-undo .
      789   define variable v-hash-string       as character no-undo .
      790   define variable v-query-prepare     as character no-undo .
      791   define variable i  as integer no-undo .
      792   define variable qh as widget-handle no-undo .
      793   define variable bh as widget-handle no-undo .
      794   define variable p-rez as logical   no-undo .
      795   run def-hash in this-procedure (input  p-full-string ,
      796                 output v-possb-keep-string ,
      797                 output v-string            ,
      798                 output v-hash-string
      799                 ).
      800   p-recid = ? .
      801   create buffer bh for table p-table-name.
      802   create query qh.
      803      v-query-prepare =
      804       "for each " + p-table-name + " no-lock where "
      805       + p-field-possb-keep-name   + " = "  + string(v-possb-keep-string) + " and "
      806       + p-field-string-name       + " = '" + v-string            + "' and "
      807       + p-field-hash-string-name  + " = '" + v-hash-string       + "'"
      808       .
      809   if v-possb-keep-string = true then do:
      810       qh:set-buffers(bh).
      811       qh:query-prepare(v-query-prepare).
      812       qh:query-open.
      813       qh:get-first.
      814       p-recid = bh:recid.
      815   end.
      816   else do:
      817   message false "анализ hash" .
      818     qh:set-buffers(bh).
      819     qh:query-prepare(v-query-prepare).
      820     qh:query-open.
      821     qh:get-first.
      822     p-recid = bh:recid.
      823     repeat :
      824       qh:get-next.
      825       if bh:available then do:
      826          qh:get-first.
      827          run ver-sub-table in this-procedure (
      828              input  p-full-string ,
      829              input  p-table-name ,
      830              input  p-sub-table-name ,
      831              input  bh:recid  ,
      832              output p-rez
      833              ).
      834          if p-rez = true  then do:
      835             p-recid = bh:recid .
      836             leave.
      837          end.
      838          else do:
      839            next.
      840          end.
      841       end.
      842       leave.
      843     end.
      844   end.
      845   delete widget bh.
      846   delete widget qh.
      847     end.
      848   end procedure.
      849   procedure ver-sub-table :
      850     do
      851     on error undo, return error return-value
      852     :
      853   define input  parameter p-full-string as character no-undo .
      854   define input  parameter p-name-table as character no-undo .
      855   define input  parameter p-sub-name-table as character no-undo .
      856   define input  parameter p-recid as recid no-undo .
      857   define output parameter p-ok as logical   no-undo .
      858   define variable v-query-prepare     as character no-undo .
      859   define variable i  as integer no-undo .
      860   define variable qh as widget-handle no-undo .
      861   define variable bh as widget-handle no-undo .
      862   define variable p-rez as logical   no-undo .
      863   for each temp-index_name-value : delete temp-index_name-value . end.
      864   for each temp-sub-index_name : delete temp-sub-index_name . end.
      865       create buffer bh for table p-name-table.
      866       create query qh.
      867       v-query-prepare = "for each " + p-name-table + " no-lock where recid(" + p-name-table + ") = " + string ( p-recid ) .
      868       qh:set-buffers(bh).
      869       qh:query-prepare(v-query-prepare).
      870       qh:query-open.
      871       qh:get-first.
      872       p-recid = bh:recid.
      873   define variable v-inf-ind AS CHAR NO-UNDO.
      874   define variable v-name-pi as character no-undo .
      875   define variable v-num-fl-inkey as integer   no-undo .
      876   define variable v-num-fl       as integer   no-undo .
      877   define variable j as integer   no-undo .
      878   v-name-pi = bh:PRIMARY .
      879   v-inf-ind = "1".
      880   i = 0.
      881   DO while ( v-inf-ind <> ? )
      882       on error undo, return error:
      883       i = i + 1 .
      884       v-inf-ind = bh:INDEX-INFORMATION(i) .
      885       if v-inf-ind = ? then leave.
      886       if entry( 1 , v-inf-ind ) = v-name-pi then do:
      887          v-num-fl-inkey = ( num-entries(v-inf-ind) - 4 ) / 2 .
      888          v-num-fl       = ( num-entries(v-inf-ind) - 4 )     .
      889         if v-num-fl-inkey >= 1 then do:
      890             do j = 5 to v-num-fl  by 2 :
      891                 create temp-index_name-value .
      892                 assign
      893                   temp-index_name-value.name-key  = entry( j , v-inf-ind )
      894                   temp-index_name-value.value-key = bh:BUFFER-FIELD(entry( j , v-inf-ind )):BUFFER-VALUE
      895                 .
      896             end.
      897          end.
      898       end.
      899   END.
      900   define variable qh-sub as widget-handle no-undo .
      901   define variable bh-sub as widget-handle no-undo .
      902       create buffer bh-sub for table p-sub-name-table.
      903       create query qh-sub.
      904   define variable k as integer   no-undo init 0 .
      905       v-query-prepare = "for each " + p-sub-name-table + " no-lock where " .
      906       for each temp-index_name-value :
      907           v-query-prepare = v-query-prepare  + p-sub-name-table + "." + temp-index_name-value.name-key +
      908                         " = " + temp-index_name-value.value-key + " and " .
      909       end.
      910       v-query-prepare = v-query-prepare + " true = true " .
      911       qh-sub:set-buffers(bh-sub).
      912       qh-sub:query-prepare(v-query-prepare).
      913       qh-sub:query-open.
      914         v-name-pi = bh-sub:PRIMARY .
      915         v-inf-ind = "1".
      916         i = 0.
      917         DO while ( v-inf-ind <> ? )
      918             on error undo, return error:
      919             i = i + 1 .
      920             v-inf-ind = bh-sub:INDEX-INFORMATION(i) .
      921             if v-inf-ind = ? then leave.
      922             if entry( 1 , v-inf-ind ) = v-name-pi then do:
      923               v-num-fl-inkey = ( num-entries(v-inf-ind) - 4 ) / 2 .
      924               v-num-fl       = ( num-entries(v-inf-ind) - 4 )     .
      925               if v-num-fl-inkey >= 1 then do:
      926                   do j = 5 to v-num-fl  by 2 :
      927                       if not can-find (first temp-index_name-value  where temp-index_name-value.name-key =  entry( j , v-inf-ind )) then do:
      928                           create temp-sub-index_name .
      929                           assign
      930                             temp-sub-index_name.name-key  = entry( j , v-inf-ind )
      931                             temp-sub-index_name.nn  = j
      932                           .
      933                       end.
      934                   end.
      935               end.
      936             end.
      937         END.
      938         define variable v-qw as character no-undo .
      939         v-qw = "".
      940         qh-sub:GET-first.
      941         DO WHILE (bh-sub:AVAILABLE):
      942           for each temp-sub-index_name :
      943               v-qw = v-qw + string(bh-sub:BUFFER-FIELD(temp-sub-index_name.name-key):BUFFER-VALUE) .
      944           end.
      945           v-qw = v-qw + ",".
      946           qh-sub:GET-NEXT.
      947         END.
      948         p-ok = false .
      949         if trim(p-full-string, ",")  =  trim (v-qw, ",") then p-ok = true  .
      950       delete widget bh-sub.
      951       delete widget qh-sub.
      952       delete widget bh.
      953       delete widget qh.
      954     end.
      955   end procedure.
      956   PROCEDURE update-rang-def :
      957   define input  parameter p-recid as recid     no-undo .
      958   define input  parameter p-list-obj as character no-undo .
      959   define input  parameter p-a as decimal   no-undo .
      960   define input  parameter p-b as decimal   no-undo .
      961   define input  parameter p-c as decimal   no-undo .
      962   define input  parameter p-d as decimal   no-undo .
      963   define input  parameter p-e as decimal   no-undo .
      964   define input  parameter p-f as decimal   no-undo .
      965   define variable v-date as date no-undo .
      966   define variable v-time as integer no-undo .
      967   define variable v-exist as logical   no-undo .
      968   define variable p-id as integer   no-undo .
      969   define variable p-db as integer   no-undo .
      970   define variable  p-possb-keep-string-obj as logical   no-undo .
      971   define variable  p-string-obj            as character no-undo .
      972   define variable  p-hash-string-obj       as character no-undo .
      973   define buffer buf_rang-abc-def     for ub.rang-abc-def.
      974   define buffer buf_rang-abc-def-obj for ub.rang-abc-def-obj.
      975   find first buf_rang-abc-def exclusive-lock where recid(buf_rang-abc-def) = p-recid no-error .
      976   if not available buf_rang-abc-def then do:
      977       v-exist = false  .
      978       assign
      979         p-id = next-value(s-asmt, ub)
      980         p-db = g#db-num
      981       .
      982       create buf_rang-abc-def.
      983       run def-hash in this-procedure (
      984            input   p-list-obj
      985           ,output  p-possb-keep-string-obj
      986           ,output  p-string-obj
      987           ,output  p-hash-string-obj
      988           ).
      989   end.
      990   else do:
      991     assign
      992         v-exist = true
      993         p-id = buf_rang-abc-def.raad-id
      994         p-db = buf_rang-abc-def.db-num
      995         p-hash-string-obj       = buf_rang-abc-def.raad-hash-string-obj
      996         p-possb-keep-string-obj = buf_rang-abc-def.raad-possb-keep-string-obj
      997         p-string-obj            = buf_rang-abc-def.raad-string-obj
      998     .
      999   end.
     1000   run cur-time in this-procedure ( output v-date, output v-time ) .
     1001       assign
     1002             buf_rang-abc-def.raad-hash-string-obj       = p-hash-string-obj
     1003             buf_rang-abc-def.raad-possb-keep-string-obj = p-possb-keep-string-obj
     1004             buf_rang-abc-def.raad-string-obj            = p-string-obj
     1005             buf_rang-abc-def.raad-a                     = p-a
     1006             buf_rang-abc-def.raad-b                     = p-b
     1007             buf_rang-abc-def.raad-c                     = p-c
     1008             buf_rang-abc-def.raad-d                     = p-d
     1009             buf_rang-abc-def.raad-e                     = p-e
     1010             buf_rang-abc-def.raad-f                     = p-f
     1011             buf_rang-abc-def.raad-id                    = p-id
     1012             buf_rang-abc-def.raad-date                  = v-date
     1013             buf_rang-abc-def.raad-db-num                = g#db-num
     1014             buf_rang-abc-def.db-num                     = p-db
     1015             buf_rang-abc-def.raad-time                  = v-time
     1016             buf_rang-abc-def.raad-who                   = g#userid
     1017         .
     1018   if v-exist = true then do:
     1019      for each buf_rang-abc-def-obj exclusive-lock where
     1020               buf_rang-abc-def-obj.raad-id = buf_rang-abc-def.raad-id and
     1021               buf_rang-abc-def-obj.db-num  = buf_rang-abc-def.db-num :
     1022               delete buf_rang-abc-def-obj.
     1023      end.
     1024   end.
     1025   define variable i as integer   no-undo .
     1026   define variable k as integer   no-undo .
     1027   p-list-obj = trim(p-list-obj, "," ).
     1028   k = num-entries(p-list-obj, ",") .
     1029   repeat  i = 1 to k :
     1030     create buf_rang-abc-def-obj.
     1031     assign
     1032       buf_rang-abc-def-obj.raad-id  = buf_rang-abc-def.raad-id
     1033       buf_rang-abc-def-obj.db-num   = buf_rang-abc-def.db-num
     1034       buf_rang-abc-def-obj.obj-type = substring(entry(i, p-list-obj) , 1 , 3 )
     1035       buf_rang-abc-def-obj.obj-code = integer(substring(entry(i, p-list-obj) , 4 , 10 ))
     1036     .
     1037   end.
     1038   RELEASE buf_rang-abc-def .
     1039   END PROCEDURE.
     1040   PROCEDURE update-rang-xyz-def :
     1041   define input  parameter p-recid as recid     no-undo .
     1042   define input  parameter p-list-obj as character no-undo .
     1043   define input  parameter p-x as decimal   no-undo .
     1044   define input  parameter p-y as decimal   no-undo .
     1045   define input  parameter p-z as decimal   no-undo .
     1046   define variable v-date as date no-undo .
     1047   define variable v-time as integer no-undo .
     1048   define variable v-exist as logical   no-undo .
     1049   define variable p-id as integer   no-undo .
     1050   define variable p-db as integer   no-undo .
     1051   define variable  p-possb-keep-string-obj as logical   no-undo .
     1052   define variable  p-string-obj            as character no-undo .
     1053   define variable  p-hash-string-obj       as character no-undo .
     1054   define buffer buf_rang-xyz-def     for ub.rang-xyz-def.
     1055   define buffer buf_rang-xyz-def-obj for ub.rang-xyz-def-obj.
     1056   find first buf_rang-xyz-def exclusive-lock where recid(buf_rang-xyz-def) = p-recid no-error .
     1057   if not available buf_rang-xyz-def then do:
     1058       v-exist = false  .
     1059       assign
     1060         p-id = next-value(s-asmt, ub)
     1061         p-db = g#db-num
     1062       .
     1063       create buf_rang-xyz-def.
     1064       run def-hash in this-procedure (
     1065            input   p-list-obj
     1066           ,output  p-possb-keep-string-obj
     1067           ,output  p-string-obj
     1068           ,output  p-hash-string-obj
     1069           ).
     1070   end.
     1071   else do:
     1072     assign
     1073         v-exist = true
     1074         p-id = buf_rang-xyz-def.raxd-id
     1075         p-db = buf_rang-xyz-def.db-num
     1076         p-hash-string-obj       = buf_rang-xyz-def.raxd-hash-string-obj
     1077         p-possb-keep-string-obj = buf_rang-xyz-def.raxd-possb-keep-string-obj
     1078         p-string-obj            = buf_rang-xyz-def.raxd-string-obj
     1079     .
     1080   end.
     1081   run cur-time in this-procedure ( output v-date, output v-time ) .
     1082       assign
     1083             buf_rang-xyz-def.raxd-hash-string-obj       = p-hash-string-obj
     1084             buf_rang-xyz-def.raxd-possb-keep-string-obj = p-possb-keep-string-obj
     1085             buf_rang-xyz-def.raxd-string-obj            = p-string-obj
