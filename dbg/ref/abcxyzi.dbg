     2082   procedure correct-message :
     2083   define input  parameter p-longchar as longchar no-undo .
     2084   define variable v-longchar as longchar no-undo .
     2085   define variable v-err-ext  as logical  no-undo .
     2086     do
     2087     on error undo, return error return-value
     2088     :
     2089      run get-long-message in this-procedure  (output v-longchar ).
     2090       v-longchar = v-longchar + p-longchar.
     2091       v-err-ext  = true .
     2092       run set-long-message  in this-procedure  (input v-longchar,  input v-err-ext ).
     2093     end.
