     3078   def var sort-labelbrowse-goods   as character no-undo .
     3079   def var sort-clmnbrowse-goods    as handle    no-undo .
     3080   def var cur-clmnbrowse-goods     as handle    no-undo .
     3081   def var cur-clmn-locbrowse-goods as integer   no-undo .
     3082   def var re-querybrowse-goods     as logical   initial no no-undo .
     3083   on start-search, ctrl-o of browse-goods in frame Dialog-Frame do:
     3084      run sort-brbrowse-goods
     3085        (input (if available abcxyz-analysis-goods
     3086                then recid(abcxyz-analysis-goods)
     3087                else ?
     3088               )
     3089        ).
     3090   end.
     3091   PROCEDURE sort-brbrowse-goods :
     3092     define input parameter p-recid as recid no-undo .
     3093     if re-querybrowse-goods = no then do:
     3094       assign
     3095          cur-clmnbrowse-goods = browse-goods:current-column in frame Dialog-Frame
     3096       .
     3097       if sort-clmnbrowse-goods <> ? then sort-clmnbrowse-goods:column-fgcolor = 0.
     3098       if cur-clmnbrowse-goods = sort-clmnbrowse-goods then do:
     3099         assign
     3100            sort-labelbrowse-goods = ""
     3101            sort-clmnbrowse-goods = ?
     3102         .
     3103        end.
     3104        else do:
     3105          assign
     3106            sort-labelbrowse-goods = cur-clmnbrowse-goods:label
     3107            sort-clmnbrowse-goods  = cur-clmnbrowse-goods
     3108            sort-clmnbrowse-goods:column-fgcolor = 4
     3109          .
     3110        end.
     3111      end.
     3112     assign
     3113       cur-clmn-locbrowse-goods = 1
     3114     .
     3115     def var column-handle as handle no-undo .
     3116     column-handle = browse-goods:first-column.
     3117     do while valid-handle(column-handle) :
     3118       if column-handle = cur-clmnbrowse-goods then do:
     3119         leave .
     3120       end.
     3121       column-handle = column-handle:NEXT-COLUMN.
     3122       assign
     3123         cur-clmn-locbrowse-goods = cur-clmn-locbrowse-goods + 1
     3124       .
     3125     end.
     3126     case sort-labelbrowse-goods:
     3127           when '*! ! '  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(buf_abcxyz-analysis-goods), &1&2&1)', chr(34), rid-list)     .     run OpenBr (yes, no, '':U).   . END.
     3128           when 'Артикул! ! '  then DO:    assign       sort-column-name = "buf_goods.artic"     .     run OpenBr (yes, no, '':U).   . END.
     3129           when 'Название! ! '  then DO:    assign       sort-column-name = "buf_goods.gds-name"     .     run OpenBr (yes, no, '':U).   . END.
     3130           when 'A!B!C'  then DO:    assign       sort-column-name = "buf_abcxyz-analysis-goods.abcg-abc"     .     run OpenBr (yes, no, '':U).   . END.
     3131           when 'X!Y!Z'  then DO:    assign       sort-column-name = "Buf_abcxyz-analysis-goods.xyzg-xyz"     .     run OpenBr (yes, no, '':U).   . END.
     3132       otherwise do:
     3133         assign
     3134           sort-column-name = ""
     3135         .
     3136         run OpenBr (yes, no, '':U).
     3137         if sort-labelbrowse-goods <> "" then do:
     3138           assign
     3139             cur-clmnbrowse-goods:column-fgcolor = 0
     3140           .
     3141         end.
     3142         assign
     3143           cur-clmn-locbrowse-goods = ?
     3144         .
     3145       end.
     3146     end case.
     3147     if p-recid <> ? then do:
     3148       reposition browse-goods to recid p-recid no-error.
     3149       apply "value-changed" to browse-goods in frame Dialog-Frame.
     3150     end.
     3151     apply "entry" to browse-goods in frame Dialog-Frame.
     3152   END PROCEDURE.
     3153   procedure re-open-query-srt-clmnbrowse-goods:
     3154   if cur-clmnbrowse-goods = ? then do:
     3155      run OpenBr (yes, no, '':U).
     3156   end.
     3157   else do:
     3158      assign re-querybrowse-goods = yes.
     3159      run sort-brbrowse-goods
     3160        (input (if available abcxyz-analysis-goods
     3161                then recid(abcxyz-analysis-goods)
     3162                else ?
     3163               )
     3164        ).
     3165      assign re-querybrowse-goods = no.
     3166   end.
     3167   end.
     3168   MAIN-BLOCK:
     3169   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3170      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3171    define variable loc#log as logical   no-undo .
     3172   define variable vss-include-info33 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3173   do:
     3174     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3175       (input  v-cntxt-db-num
     3176       ,input  v-cntxt-userid
     3177       ,input  0
     3178       ,input  'actn_ABC-XYZ_lookup':U
     3179       ,input  'global':U
     3180       ,input  0
     3181       ,input  '':U
     3182       ,input  0
     3183       ,input  0
     3184       ,input  0
     3185       ,input  0
     3186       ,input  true
     3187       ,output loc#log
     3188       )  .
     3189   end.
     3190      if not loc#log then return .
     3191      buf_goods.artic:resizable in browse BROWSE-goods = true .
     3192      buf_goods.gds-name:resizable in browse BROWSE-goods = true .
     3193      v-izt:resizable in browse BROWSE-goods = true .
     3194      buf_goods.artic:read-only in browse BROWSE-goods = true .
     3195      ASSIGN b-print:POPUP-MENU IN FRAME Dialog-Frame = MENU POPUP-MENU-B-print:HANDLE.
     3196      ASSIGN b-print:MENU-MOUSE = 1.
