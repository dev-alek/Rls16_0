     3200   RUN disable_UI.
     3201   PROCEDURE calc-prc :
     3202   define input  parameter p-old as character no-undo .
     3203   define input  parameter p-new as character no-undo .
     3204   define input  parameter p-type as character no-undo .
     3205   define input  parameter p-all-sum as decimal   no-undo .
     3206   define input  parameter p-all-qnty as decimal   no-undo .
     3207   define input-output parameter  abc-prc-qnty  as decimal   no-undo .
     3208   define input-output parameter  abc-qnty      as decimal   no-undo .
     3209   define input-output parameter  abc-sum-prc   as decimal   no-undo .
     3210   define input-output parameter  abc-sum       as decimal   no-undo .
     3211   define input  parameter p-sum as decimal   no-undo .
     3212   if p-old  <> p-type and p-new <> p-type then return .
     3213   if p-old  = p-type then do:
     3214       assign
     3215         abc-qnty        = abc-qnty      - 1
     3216         abc-sum         = abc-sum       - p-sum
     3217         abc-sum-prc     = abc-sum  * 100 / p-all-sum
     3218         abc-prc-qnty    = abc-qnty * 100 / p-all-qnty
     3219       .
     3220   end.
     3221   if p-new  = p-type then do:
     3222       assign
     3223         abc-qnty        = abc-qnty      + 1
     3224         abc-sum         = abc-sum       + p-sum
     3225         abc-sum-prc     = abc-sum  * 100 / p-all-sum
     3226         abc-prc-qnty    = abc-qnty * 100 / p-all-qnty
     3227       .
     3228   end.
     3229   END PROCEDURE.
     3230   PROCEDURE disable_UI :
     3231     HIDE FRAME Dialog-Frame.
     3232   END PROCEDURE.
     3233   PROCEDURE enable_UI :
     3234     ENABLE B-cancel B-mark B-chg-izt B-add-AM B-del-AM B-spis-ord B-Help
     3235            B-add-AMin B-del-AMin B-ord B-print BROWSE-goods
     3236         WITH FRAME Dialog-Frame.
     3237     VIEW FRAME Dialog-Frame.
     3238     OPEN QUERY BROWSE-goods     FOR EACH  Buf_abcxyz-analysis-goods NO-LOCK         WHERE Buf_abcxyz-analysis-goods.abcx-id = v-id and               Buf_abcxyz-analysis-goods.db-num = v-db-num,                EACH  buf_goods of Buf_abcxyz-analysis-goods       .
     3239   END PROCEDURE.
     3240   PROCEDURE init-gds-rec :
     3241   gds-rec = recid(buf_goods) .
     3242   END PROCEDURE.
     3243   PROCEDURE make-gds-list :
     3244   do
     3245     on error undo, return error return-value
     3246     :
     3247   define buffer buf2_goods for ub.goods.
     3248   define buffer buf2_abc-analysis-goods for ub.abcxyz-analysis-goods.
     3249   define variable v-kol as integer   no-undo .
     3250   define variable i as integer   no-undo .
     3251   run waitfram-show ( "Подготовка временных таблиц.... ") .
     3252       for each gds-list : delete gds-list. end.
     3253       v-kol = num-entries( rid-list ) .
     3254       repeat i = 1 to v-kol :
     3255         find first buf2_abc-analysis-goods no-lock where recid(buf2_abc-analysis-goods) = integer(entry(i,rid-list)) no-error .
     3256         if available buf2_abc-analysis-goods then do:
     3257             find first buf2_goods no-lock where buf2_goods.gds-code = buf2_abc-analysis-goods.gds-code no-error .
     3258             if available buf2_goods then do:
     3259                 create gds-list.
     3260                 BUFFER-COPY buf2_goods TO gds-list .
     3261             end.
     3262         end.
     3263       end.
     3264    run waitfram-hide.
     3265     end.
     3266   END PROCEDURE.
     3267   PROCEDURE my_enable :
     3268   define buffer Buf2_abc-analysis-obj for ub.abc-analysis-obj.
     3269     ENABLE B-Cancel
     3270            B-mark
     3271            B-chg-izt
     3272            B-add-AM
     3273            B-del-AM
     3274            B-Help
     3275            B-add-AMin
     3276            B-del-AMin
     3277            B-print
     3278            BROWSE-goods
     3279         WITH FRAME Dialog-Frame.
     3280         hide
     3281         B-spis-ord
     3282         b-ord
     3283         in frame Dialog-Frame .
     3284     view frame dialog-frame.
     3285     FOR EACH Buf2_abc-analysis-obj WHERE
     3286              Buf2_abc-analysis-obj.abc-id = Buf_abcxyz-analysis.abc-id AND
     3287              Buf2_abc-analysis-obj.db-num = Buf_abcxyz-analysis.abc-db-num
     3288     no-lock :
     3289       run create_obj-list (Buf2_abc-analysis-obj.obj-type , Buf2_abc-analysis-obj.obj-code ) .
     3290     end.
     3291     frame Dialog-Frame:title = buf_abcxyz-analysis.abcx-name .
     3292     run openbr (yes, no, '':u).
     3293   END PROCEDURE.
     3294   PROCEDURE OPenbr :
     3295   define input  parameter p-open-query     as logical   no-undo .
     3296   define input  parameter p-find-next      as logical   no-undo .
     3297   define input  parameter p-find-condition as character no-undo .
     3298   define variable l-query-was-opened as logical no-undo .
     3299   define variable title0 as character no-undo.
     3300   define buffer buff_contract for contract.
     3301   define variable loc_contract-code as character no-undo .
     3302   define variable sort-column-phrase as character no-undo .
     3303   case sort-column-name :
     3304     when "" then do:
     3305       assign
     3306         sort-column-phrase = ""
     3307       .
     3308     end.
     3309     otherwise do:
     3310       assign
     3311         sort-column-phrase = "by " + sort-column-name
     3312       .
     3313     end.
     3314   end case.
     3315   define variable l-open-query as logical   no-undo .
     3316   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3317   define variable  l-disable-where-35  as logical   no-undo .
     3318   define variable  l-filter-open-35    as logical   .
     3319   define variable  flt-rec-35       as recid     no-undo .
     3320   define variable  filter-name-35      as character no-undo .
     3321   define variable  where-phrase-35     as character no-undo .
     3322   define variable  sort-phrase-35      as character no-undo .
     3323   define variable  where-phrase-rus-35 as character no-undo .
     3324   define variable  sort-phrase-rus-35  as character no-undo .
     3325     run waitfram-show in this-procedure
     3326       (input "ЖДИТЕ ..."
     3327       ).
     3328   run gbl/flt-get.p
     3329     (input filter-point
     3330     ,output flt-rec-35
     3331     ,output filter-name-35
     3332     ,output where-phrase-35
     3333     ,output sort-phrase-35
     3334     ,output where-phrase-rus-35
     3335     ,output sort-phrase-rus-35
     3336     ).
     3337   if p-open-query then do:
     3338       run set-filter-name in this-procedure
     3339         (INPUT filter-name-35
     3340         ) no-error .
     3341     assign
     3342       l-filter-open-35 = false
     3343     .
     3344     if flt-rec-35 <> ?
     3345       or sort-column-phrase > ""
     3346     then do:
     3347       define variable  parameter-2-35 as character no-undo .
     3348       define variable  parameter-3-35 as character no-undo .
     3349       define variable  parameter-4-35 as character no-undo .
     3350       define variable  parameter-5-35 as character no-undo .
     3351       define variable  parameter-6-35 as character no-undo .
     3352       define variable  parameter-7-35 as character no-undo .
     3353         assign
     3354         parameter-3-35 =
     3355                                 "FOR EACH Buf_abcxyz-analysis-goods"
     3356         parameter-4-35 =
     3357           (
     3358             if (" Buf_abcxyz-analysis-goods.abcx-id = v-id and  Buf_abcxyz-analysis-goods.db-num = v-db-num " + " " + where-phrase-35) <> ""
     3359             then substitute(' Buf_abcxyz-analysis-goods.abcx-id = &1 and  Buf_abcxyz-analysis-goods.db-num = &2 ' ,v-id , v-db-num  )  + " " + where-phrase-35
     3360             else "true"
     3361           )
     3362         parameter-5-35 = (" " + "" + " " + ", EACH  buf_goods OF Buf_abcxyz-analysis-goods NO-LOCK")
     3363         parameter-6-35 = if sort-phrase-35 = ''
     3364                              then
     3365           (
     3366           " " + " " +
     3367             " " + sort-column-phrase +
     3368           " " + " "
     3369           )
     3370                              else
     3371           (
     3372           " " + " " +
     3373             " " + sort-column-phrase +
     3374           " " + sort-phrase-35
     3375           )
     3376         parameter-7-35 =
     3377           "   "
     3378       .
     3379       do
     3380       on stop undo, leave
     3381       on error undo, leave
     3382       :
     3383         assign
     3384           l-disable-where-35 =
     3385             (" Buf_abcxyz-analysis-goods.abcx-id = v-id and  Buf_abcxyz-analysis-goods.db-num = v-db-num " + " " + where-phrase-35 = "")
     3386         .
     3387         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3388                             ,input query BROWSE-goods:handle
     3389                             ,input parameter-3-35
     3390                             ,input parameter-4-35
     3391                             ,input parameter-5-35
     3392                             ,input parameter-6-35
     3393                             ,input parameter-7-35
     3394                             )
     3395         .
     3396         assign
     3397           l-filter-open-35 = true
     3398         .
     3399       end.
     3400       if l-filter-open-35 = false then do:
     3401         message
     3402           "Ошибка при фильтрации / сортировке" skip
     3403           "Будут показаны записи без учета фильтра" skip
     3404           view-as alert-box .
     3405       end.
     3406       else do:
     3407           assign
     3408             l-query-was-opened = true
     3409           .
     3410       end.
     3411     end.
     3412     if l-filter-open-35 = false then do:
     3413       OPEN QUERY browse-goods FOR EACH  Buf_abcxyz-analysis-goods NO-LOCK
     3414         where  Buf_abcxyz-analysis-goods.abcx-id = v-id and  Buf_abcxyz-analysis-goods.db-num = v-db-num
     3415       , EACH  buf_goods OF Buf_abcxyz-analysis-goods NO-LOCK
     3416     .
     3417         assign
     3418           l-query-was-opened = true
     3419         .
     3420     end.
     3421   end.
     3422   else do:
     3423     assign
     3424       doc-rec = recid( Buf_abcxyz-analysis-goods )
     3425     .
     3426     do
     3427     on stop undo, leave
     3428     on error undo, leave
     3429     :
     3430       if query BROWSE-goods:handle:get-buffer-handle(1) = (buffer Buf_abcxyz-analysis-goods:handle) then do:
     3431         assign
     3432         parameter-2-35 = (if p-find-next then "true":u else "false":u )
     3433         parameter-4-35 =
     3434           "where ":u + substitute(' Buf_abcxyz-analysis-goods.abcx-id = &1 and  Buf_abcxyz-analysis-goods.db-num = &2 ' ,v-id , v-db-num  )  + " ":u + where-phrase-35 + " ":u + p-find-condition + " " + ""
     3435         parameter-5-35 = " "
     3436       .
     3437         run fltopend_fltfindd in this-procedure  (
     3438                             input this-procedure:handle
     3439                             ,input query BROWSE-goods:handle
     3440                             ,input rowid(Buf_abcxyz-analysis-goods)
     3441                             ,input logical(parameter-2-35)
     3442                             ,input no-lock
     3443                             ,input (buffer Buf_abcxyz-analysis-goods:handle)
     3444                             ,input parameter-4-35
     3445                             ,input parameter-5-35
     3446                             ) no-error.
     3447         .
     3448         assign
     3449           doc-rec = integer(return-value)
     3450           v-fltopend-rowid[1] = ?
     3451         .
     3452       end.
     3453       else do:
     3454         assign
     3455         parameter-2-35 = (if p-find-next then "true":u else "false":u )
     3456         parameter-3-35 =  "FOR EACH Buf_abcxyz-analysis-goods"
     3457         parameter-4-35 =
     3458           (
     3459             if (" Buf_abcxyz-analysis-goods.abcx-id = v-id and  Buf_abcxyz-analysis-goods.db-num = v-db-num " + " " + where-phrase-35) <> ""
     3460             then substitute(' Buf_abcxyz-analysis-goods.abcx-id = &1 and  Buf_abcxyz-analysis-goods.db-num = &2 ' ,v-id , v-db-num  )  + " " + where-phrase-35
     3461             else "true"
     3462           )
     3463         parameter-5-35 = (" " + "" + " " + ", EACH  buf_goods OF Buf_abcxyz-analysis-goods NO-LOCK" + " " + p-find-condition)
     3464         parameter-6-35 = if sort-phrase-35 = ''
     3465                              then
     3466           (
     3467           " " + " " +
     3468             " " + sort-column-phrase +
     3469           " " + " "
     3470           )
     3471                              else
     3472           (
     3473           " " + " " +
     3474             " " + sort-column-phrase +
     3475           " " + sort-phrase-35
     3476           )
     3477         parameter-7-35 =
     3478           "   "
     3479       .
     3480         run fltopend_fltfindq in this-procedure  (
     3481                             input this-procedure:handle
     3482                             ,input query BROWSE-goods:handle
     3483                             ,input logical(parameter-2-35)
     3484                             ,input no-lock
     3485                             ,input parameter-3-35
     3486                             ,input parameter-4-35
     3487                             ,input parameter-5-35
     3488                             ,input parameter-6-35
     3489                             ,input parameter-7-35
     3490                             ,output v-fltopend-rowid
     3491                             ) no-error.
     3492         .
     3493         doc-rec = ?.
     3494       end.
     3495       assign
     3496         l-query-was-opened = true
     3497       .
     3498     end.
     3499   end.
     3500     run waitfram-hide in this-procedure .
     3501   if not p-open-query then
     3502   REPOSITION browse-goods to recid doc-rec No-ERROR.
     3503   END PROCEDURE.
     3504   PROCEDURE print-proc :
     3505   define input  parameter p-obj as logical   no-undo .
     3506   define buffer b_abc-analysis for ub.abc-analysis.
     3507    find first b_abc-analysis no-lock where
     3508               b_abc-analysis.abc-id =  buf_abcxyz-analysis.abc-id and
     3509               b_abc-analysis.db-num =  buf_abcxyz-analysis.abc-db-num no-error .
     3510   define buffer b_xyz-analysis for ub.xyz-analysis.
     3511    find first b_xyz-analysis no-lock where
     3512               b_xyz-analysis.xyz-id =  buf_abcxyz-analysis.xyz-id and
     3513               b_xyz-analysis.db-num =  buf_abcxyz-analysis.xyz-db-num no-error .
     3514   if available b_xyz-analysis and
     3515      available b_abc-analysis then
     3516    run ref/abcxyzmt.p
     3517    (parParentProc
     3518    ,recid(buf_abcxyz-analysis)
     3519    ).
     3520   END PROCEDURE.
     3521   PROCEDURE proc-cgh-Am :
     3522       do
     3523       on error undo, return error return-value
     3524       :
     3525   define input  parameter v-new as logical   no-undo .
     3526   define buffer buf_matrix                  for  ub.assortment-matrix .
     3527   define buffer buf2_assortment-matrix-goods for ub.assortment-matrix-goods .
     3528   define buffer buf_gds-obj for ub.gds-obj.
     3529   define variable p-doc-rec as recid no-undo .
     3530   define variable v-sts as integer   no-undo .
     3531   DEFINE VARIABLE cError as CHARACTER NO-UNDO INITIAL "".
     3532   DEFINE VARIABLE iDelta as INTEGER   NO-UNDO INITIAL 0.
     3533   v-err-ext = false  .
     3534   v-longchar = "" .
     3535   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clear-longmess in g#lib-Matrix
     3536      .
     3537    run make-gds-list in this-procedure .
     3538    for each obj-list :
     3539         Label-AM:
     3540         for each  buf_matrix no-lock where
     3541             buf_matrix.asmt-status = 0 and
     3542             buf_matrix.obj-type = obj-list.obj-type and
     3543             buf_matrix.obj-code = obj-list.obj-code :
     3544              if v-new = true then do:
     3545                 run waitfram-show in this-procedure  ("Добавление товаров в ассортиментную матрицу  "  +
     3546                                                     buf_matrix.asmt-name +
     3547                                                     "  на объекте " +
     3548                                                     string( obj-list.obj-code )) .
     3549             end.
     3550             else do:
     3551                 run waitfram-show in this-procedure  ("Удаление товаров из ассортиментную матрицу  "  +
     3552                                                     buf_matrix.asmt-name +
     3553                                                     "  на объекте " +
     3554                                                     string( obj-list.obj-code )) .
     3555             end.
     3556             if v-new = true then do:
     3557                RUN Get-Gl-Param-Proc-Otkl in THIS-PROCEDURE(
     3558                    buf_matrix.asmt-id,
     3559                    buf_matrix.db-num,
     3560                    OUTPUT cError
     3561                    ).
     3562                if cError <> "" THEN DO:
     3563                   v-err-ext = true .
     3564                   v-longchar = v-longchar + cError + chr(10).
     3565                   NEXT Label-AM.
     3566                END.
     3567   DEFINE VARIABLE vss-include-info36 AS CHARACTER FORMAT "x(65)" NO-UNDO INITIAL "@(#)$Workfile$ $Revision$".
     3568   FOR EACH gds-list NO-LOCK:
     3569       IF NOT CAN-FIND(FIRST ub.Assortment-matrix-goods WHERE
     3570                             ub.Assortment-matrix-goods.Asmt-id      = buf_matrix.Asmt-id
     3571                         AND ub.Assortment-matrix-goods.Db-num       = buf_matrix.db-num
     3572                         AND ub.Assortment-matrix-goods.gds-code     = gds-list.gds-code
     3573                         AND ub.Assortment-matrix-goods.asmg-status  = INTEGER('0':U)
     3574                         NO-LOCK) THEN DO:
     3575          ASSIGN
     3576             iDelta = iDelta + 1.
     3577       END.
     3578   END.
     3579                RUN Cntrl-AM-Add-1 IN THIS-PROCEDURE(
     3580                    iDelta,
     3581                    OUTPUT cError
     3582                    ).
     3583                if cError <> "" THEN DO:
     3584                   v-err-ext = true .
     3585                   v-longchar = v-longchar + cError + chr(10).
     3586                   NEXT Label-AM.
     3587                END.
     3588             END.
     3589             for each gds-list :
     3590                   if v-new = true then do:
     3591                      find first buf_gds-obj no-lock where
     3592                           buf_gds-obj.obj-type = obj-list.obj-type and
     3593                           buf_gds-obj.obj-code = obj-list.obj-code and
     3594                           buf_gds-obj.gds-code = gds-list.gds-code no-error .
     3595                           if available buf_gds-obj then do:
     3596   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat1 in g#lib-Matrix
     3597    (input this-procedure
     3598    ,input-output p-doc-rec
     3599    ,input 'ДОБАВЛЕНИЕ':U
     3600    ,input buf_matrix.asmt-id
     3601    ,input buf_matrix.db-num
     3602    ,input gds-list.gds-code
     3603    ,input ''
     3604     ) no-error .
     3605                                 if error-status :error then do:
     3606                                   v-err-ext = true .
     3607                                   v-longchar = v-longchar + return-value + chr(10).
     3608                                 end.
     3609                           end.
     3610                   end.
     3611                   else do:
     3612                     find first buf2_assortment-matrix-goods no-lock where
     3613                         buf2_assortment-matrix-goods.asmt-id  = buf_matrix.asmt-id and
     3614                         buf2_assortment-matrix-goods.db-num   = buf_matrix.db-num  and
     3615                         buf2_assortment-matrix-goods.gds-code = gds-list.gds-code  and
     3616                         buf2_assortment-matrix-goods.asmg-status = 0
     3617                         no-error .
     3618                         if available buf2_assortment-matrix-goods then do:
     3619                             v-sts = int('1':U) .
     3620   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat2 in g#lib-Matrix
     3621    (input this-procedure
     3622    ,input recid(buf2_assortment-matrix-goods)
     3623    ,input-output v-sts
     3624    ,input no
     3625     ) no-error .
     3626                               if error-status :error then do:
     3627                                 v-err-ext = true .
     3628                                 v-longchar = v-longchar + return-value + chr(10) .
     3629                               end.
     3630                         end.
     3631                   end.
     3632             end.
     3633         end.
     3634    end.
     3635   run waitfram-hide in this-procedure .
     3636   if v-err-ext = true  then do:
     3637   define variable v-ok as logical   no-undo .
     3638     run gbl/d-longchar.w (
     3639           ?,
     3640           'Editor_row=2\':u
     3641         + 'title=При добавлении в Ассортиментные матрицы\':u
     3642         + 'Editor_col=1\':u
     3643         + 'Editor_width=96\':u
     3644         + 'Editor_height=21\':u
     3645         + 'readonly=yes\':u
     3646       ,input-output v-longchar
     3647       ,output v-ok ) no-error .
     3648           v-longchar = "" .
     3649   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clear-longmess in g#lib-Matrix
     3650      .
     3651   end.
     3652   run OpenBr (yes, no, '':U).
     3653   end.
     3654   END PROCEDURE.
     3655   PROCEDURE proc-cgh-Amin :
     3656       do
     3657       on error undo, return error return-value
     3658       :
     3659   define input  parameter v-new as logical   no-undo .
     3660     run make-gds-list in this-procedure .
     3661     run ref/chg-amin.p ( input v-new ) no-error  .
     3662         if error-status :error then
     3663             message vss-workfile vss-revision vss-description skip
     3664             error-status :get-message(1)
     3665             return-value
     3666             .
     3667     run OpenBr (yes, no, '':U).
     3668       end.
     3669   END PROCEDURE.
     3670   PROCEDURE proc-chg-abc :
     3671   END PROCEDURE.
     3672   PROCEDURE proc-chg-igt :
     3673       do
     3674       on error undo, return error return-value
     3675       :
     3676   define variable  v-old as character no-undo .
     3677   define variable  v-new as character no-undo .
     3678     run make-gds-list .
     3679     run ref/graf-igt.w ( output v-old, output v-new ).
     3680     if not(v-old = "" and v-new = "")  then do:
     3681         run ref/chg-igt.p ( input v-old, input v-new , input true ) no-error  .
     3682             if error-status :error then
     3683                 message vss-workfile vss-revision vss-description skip
     3684                 error-status :get-message(1)
     3685                 return-value
     3686                 .
     3687     end.
     3688   run OpenBr ( yes, no, '':U).
     3689       end.
     3690   END PROCEDURE.
     3691   PROCEDURE proc-disp-goods :
     3692   define variable   v-old-izt  as character no-undo .
     3693   define variable   v-old-amin  as character no-undo .
     3694   define variable   v-old-acc-mat  as character no-undo .
     3695   define variable vt-Amin as character no-undo .
     3696       assign
     3697       v-old-izt  = ""
     3698       v-izt      = ""
     3699       v-Amin     = ""
     3700       v-old-Amin = ""
     3701       v-acc-mat     =  ""
     3702       v-old-acc-mat = ""
     3703       .
     3704   END PROCEDURE.
     3705   PROCEDURE prt-goods :
     3706   define variable   v-old-izt  as character no-undo .
     3707   define variable   v-old-amin  as character no-undo .
     3708   define variable   v-old-acc-mat  as character no-undo .
     3709   define variable vt-Amin as character no-undo .
     3710   define variable t-izt as character no-undo .
     3711   define variable t-Amin as character no-undo .
     3712   define variable t-asm as character no-undo .
     3713   define variable            v-gdop-min-stock                as decimal   no-undo .
     3714   define variable            v-grop-max-stock                as decimal   no-undo .
     3715   define variable            v-grop-level-always-presence    as decimal   no-undo .
     3716   define variable            v-grop-min-order                as decimal   no-undo .
     3717       assign
     3718       v-old-izt  = ""
     3719       v-izt      = ""
     3720       v-Amin     = ""
     3721       v-old-Amin = ""
     3722       v-acc-mat     =  ""
     3723       v-old-acc-mat = ""
     3724       .
     3725   define buffer buf2_abc-analysis-gds-obj for ub.abc-analysis-gds-obj   .
     3726   define buffer buf2_assortment-matrix for ub.assortment-matrix.
     3727   define buffer buf2_assortment-matrix-goods for ub.assortment-matrix-goods.
     3728   DEFINE BUFFER Buf_abc-analysis-obj FOR ub.abc-analysis-obj.
     3729   FOR EACH Buf_abc-analysis-obj WHERE
     3730            Buf_abc-analysis-obj.abc-id = Buf_abcxyz-analysis.abc-id AND
     3731            Buf_abc-analysis-obj.db-num = Buf_abcxyz-analysis.abc-db-num
     3732            NO-LOCK,
     3733           EACH buf2_abc-analysis-gds-obj WHERE
     3734               buf2_abc-analysis-gds-obj.obj-type = Buf_abc-analysis-obj.obj-type AND
     3735               buf2_abc-analysis-gds-obj.obj-code = Buf_abc-analysis-obj.obj-code AND
     3736               buf2_abc-analysis-gds-obj.gds-code = Buf_abc-analysis-goods.gds-code AND
     3737               buf2_abc-analysis-gds-obj.abc-id   = Buf_abcxyz-analysis.abc-id AND
     3738               buf2_abc-analysis-gds-obj.db-num   = Buf_abcxyz-analysis.abc-db-num
     3739               NO-LOCK break
     3740               by Buf2_abc-analysis-gds-obj.gds-code
     3741               :
     3742                   find first buf2_assortment-matrix WHERE
     3743                         buf2_assortment-matrix.asmt-status        = 0  AND
     3744                         buf2_assortment-matrix.obj-type =  Buf_abc-analysis-obj.obj-type AND
     3745                         buf2_assortment-matrix.obj-code =  Buf_abc-analysis-obj.obj-code
     3746                         NO-LOCK no-error .
     3747                   find first buf2_assortment-matrix-goods WHERE
     3748                         buf2_assortment-matrix-goods.asmg-status        = 0  AND
     3749                         buf2_assortment-matrix-goods.asmt-id  =  buf2_assortment-matrix.asmt-id AND
     3750                         buf2_assortment-matrix-goods.db-num   =  buf2_assortment-matrix.db-num  AND
     3751                         buf2_assortment-matrix-goods.gds-code =  buf2_abc-analysis-gds-obj.gds-code
     3752                         NO-LOCK no-error .
     3753   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3754   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     3755     (input  Buf_abc-analysis-obj.obj-type
     3756     ,input  Buf_abc-analysis-obj.obj-code
     3757     ,input  ?
     3758     ,input  ?
     3759     ,input  ?
     3760     ,input  Buf_abc-analysis-goods.gds-code
     3761     ,output t-amin
     3762     ,output t-izt
     3763     ,output v-gdop-min-stock
     3764     ,output v-grop-max-stock
     3765     ,output v-grop-level-always-presence
     3766     ,output v-grop-min-order
     3767     )  .
     3768                if not available buf2_assortment-matrix-goods then t-asm = "0" .
     3769                                                              else t-asm = string(buf2_assortment-matrix-goods.asmt-id).
     3770               if first-of(Buf2_abc-analysis-gds-obj.gds-code) then do:
     3771                     assign
     3772                     v-old-izt  =  t-izt
     3773                     v-izt      =  t-izt
     3774                     v-Amin     =  t-amin
     3775                     v-old-Amin =  t-amin
     3776                     v-acc-mat     =  t-asm
     3777                     v-old-acc-mat =  t-asm
     3778                     .
     3779                     if  v-Amin = 'no'  then v-Amin = "не входит" .
     3780                                        else v-Amin = "входит" .
     3781                     if v-acc-mat = "0" then v-acc-mat = "не входит" .
     3782                                        else v-acc-mat = "входит" .
     3783               end.
     3784           if v-old-izt     <> t-izt            then  v-izt = "разное" .
     3785           if v-old-Amin    <> t-Amin           then  v-Amin = "разное" .
     3786           if v-old-acc-mat <> t-asm            then  v-acc-mat = "разное" .
     3787         assign
     3788           v-old-izt     = t-izt
     3789           v-old-Amin    = t-Amin
     3790           v-old-acc-mat = t-asm
     3791         .
     3792   end.
     3793   END PROCEDURE.
