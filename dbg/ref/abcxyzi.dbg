     2977   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2978   procedure minbtn-set :
     2979       do
     2980           on error undo, return error return-value
     2981           :
     2982           define variable ii              as integer       no-undo .
     2983           define variable fh              as widget-handle no-undo .
     2984           define variable hh              as widget-handle no-undo .
     2985           define variable v-h             as handle        extent 4 no-undo .
     2986           define variable v-name-button   as character     no-undo .
     2987           define variable v-help-old-x    as decimal       no-undo .
     2988           define variable v-help-old-y    as decimal       no-undo .
     2989           define variable v-help-old-size as decimal       no-undo .
     2990           define variable v-frame-width   as decimal       no-undo .
     2991           define variable jj              as integer       no-undo .
     2992           do
     2993               on error undo, return error
     2994               :
     2995               assign
     2996                   v-frame-width = frame Dialog-Frame:width - 0.3
     2997                   fh            = frame Dialog-Frame:first-child
     2998                   hh            = fh:first-child
     2999                   ii            = 1
     3000                   .
     3001               do while valid-handle(hh):
     3002                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3003                   do:
     3004                       case lc(hh:name) :
     3005                           when "b-help" then
     3006                               do:
     3007                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3008                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3009                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3010                                   hh:TOOLTIP = "Помощь" .
     3011                                   v-help-old-x = hh:column .
     3012                                   v-help-old-y = hh:row    .
     3013                                   v-help-old-size = hh:width .
     3014                                   hh:width-chars = 2.5 .
     3015                               end.
     3016                           when "b-print" then
     3017                               do:
     3018                                   hh:load-image("cmp/b-print.bmp":u) .
     3019                                   hh:TOOLTIP = "Печать" .
     3020                                   v-h[ii] = hh:handle .
     3021                                   ii = ii + 1 .
     3022                                   hh:width-chars = 3 .
     3023                               end.
     3024                           when "b-history" or
     3025                           when "b-hist" then
     3026                               do:
     3027                                   hh:load-image("cmp/b-hist.bmp":u) .
     3028                                   hh:TOOLTIP = "История" .
     3029                                   v-h[ii] = hh:handle .
     3030                                   ii = ii + 1 .
     3031                                   hh:width-chars = 3 .
     3032                               end.
     3033                           when "b-sch" then
     3034                               do:
     3035                                   hh:load-image("cmp/b-sch.bmp":u) .
     3036                                   hh:TOOLTIP = "Установка Фильтра" .
     3037                                   v-h[ii] = hh:handle .
     3038                                   ii = ii + 1 .
     3039                                   hh:width-chars = 3 .
     3040                               end.
     3041                           when "b-hist-user" then
     3042                               do:
     3043                                   hh:load-image("cmp/b-hist.bmp":u) .
     3044                                   hh:TOOLTIP = "История пользователя" .
     3045                                   ii = ii + 1 .
     3046                               end.
     3047                       end case.
     3048                   end.
     3049                   hh = hh:next-sibling.
     3050               end.
     3051               b-help:column = v-frame-width - b-help:width-chars.
     3052               jj = 0.
     3053               repeat ii = 4 to 1 by -1 :
     3054                   if valid-handle (v-h[ii] ) then
     3055                   do:
     3056                       jj  = jj + 1 .
     3057                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3058                       v-h[ii]:row    = v-help-old-y .
     3059                   end.
     3060               end.
     3061           end.
     3062       end.
     3063   end procedure.
     3064   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3065   on F9 of frame Dialog-Frame anywhere do:
     3066     run init-gds-rec.
     3067     if gds-rec = ? then
     3068       return no-apply.
     3069     run ref/gds-form.w ( input parparentproc
     3070                         ,input 'ПРОСМОТР':U
     3071                         ,input ?
     3072                         ,input ?
     3073                         ,input ?
     3074                         ,input-output gds-rec).
