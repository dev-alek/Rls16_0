     2294   DEFINE VARIABLE vss-include-info24 AS CHARACTER FORMAT "x(65)" NO-UNDO INITIAL "@(#)$Workfile$ $Revision$".
     2295   FUNCTION indicator-life-gds-n RETURNS CHARACTER ( input p-rec as recid ) FORWARD.
     2296   DEFINE VARIABLE v-gl-iProc-Otkl AS DECIMAL NO-UNDO INITIAL 0.
     2297   DEFINE VARIABLE v-gl-lAM-Is-Obj         AS LOGICAL NO-UNDO INITIAL FALSE.
     2298   DEFINE VARIABLE v-gl-iAM-Gds-All        AS INTEGER NO-UNDO INITIAL 0.
     2299   DEFINE VARIABLE v-gl-iAM-Sbl-Gds-All    AS INTEGER NO-UNDO INITIAL 0.
     2300   DEFINE VARIABLE v-gl-iAM-Gds-Vyv        AS INTEGER NO-UNDO INITIAL 0.
     2301   DEFINE VARIABLE v-gl-lAM-Ref-Shablon    AS LOGICAL NO-UNDO INITIAL FALSE.
     2302   DEFINE VARIABLE v-gl-dAM-Proc-Otkl      AS DECIMAL NO-UNDO INITIAL 0.
     2303   DEFINE VARIABLE v-gl-dAM-Proc-Otkl-Ras  AS DECIMAL NO-UNDO INITIAL 0.
     2304   FUNCTION Is-Gds-In-AssMatr RETURN LOGICAL(
     2305      p-Gds-code AS INTEGER,
     2306      p-Asmt-id  AS INTEGER,
     2307      p-Db-num   AS INTEGER):
     2308      DEFINE BUFFER buf_Gds FOR Ub.Assortment-matrix-goods.
     2309      RETURN CAN-FIND(FIRST buf_Gds WHERE
     2310                            buf_Gds.Asmt-id     = p-Asmt-id
     2311                        AND buf_Gds.Db-num      = p-Db-num
     2312                        AND buf_Gds.Gds-code    = p-Gds-code
     2313                        AND buf_Gds.Asmg-status = INTEGER('0':U)
     2314                      NO-LOCK).
     2315   END FUNCTION.
     2316   PROCEDURE Get-Delta-Gds-2-Matrix:
     2317      DEFINE PARAMETER BUFFER buf_AM-1 FOR ub.Assortment-matrix.
     2318      DEFINE PARAMETER BUFFER buf_AM-2 FOR ub.Assortment-matrix.
     2319      DEFINE OUTPUT PARAMETER iDelta AS INTEGER NO-UNDO INITIAL 0.
     2320      DEFINE BUFFER buf_Gds-1 FOR ub.Assortment-matrix-goods.
     2321      DEFINE BUFFER buf_Gds-2 FOR ub.Assortment-matrix-goods.
     2322      FOR EACH buf_Gds-1 WHERE
     2323               buf_Gds-1.Asmt-id = buf_AM-1.Asmt-id
     2324           AND buf_Gds-1.Db-num  = buf_AM-1.Db-num
     2325           AND buf_Gds-1.Asmg-status = INTEGER('0':U)
     2326          NO-LOCK:
     2327          IF NOT CAN-FIND(FIRST buf_Gds-2 WHERE
     2328                                buf_Gds-2.Asmt-id     = buf_AM-2.Asmt-id
     2329                            AND buf_Gds-2.Db-num      = buf_AM-2.Db-num
     2330                            AND buf_Gds-2.Gds-code    = buf_Gds-1.Gds-code
     2331                            AND buf_Gds-2.Asmg-status = INTEGER('0':U)
     2332                            NO-LOCK) THEN DO:
     2333             ASSIGN
     2334                iDelta = iDelta + 1.
     2335          END.
     2336      END.
     2337      RETURN.
     2338   END PROCEDURE.
     2339   PROCEDURE Cntrl-AM-Add-1:
     2340      DEFINE INPUT PARAMETER iDelta  AS INTEGER   NO-UNDO.
     2341      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     2342      IF v-gl-iProc-Otkl = 0      THEN RETURN.
     2343      IF NOT v-gl-lAM-Is-Obj      THEN RETURN.
     2344      IF NOT v-gl-lAM-Ref-Shablon THEN RETURN.
     2345      RUN Calc-Proc-Otkl IN THIS-PROCEDURE(iDelta).
     2346      IF iDelta = 0 THEN DO:
     2347         IF v-gl-dAM-Proc-Otkl >= v-gl-iProc-Otkl THEN DO:
     2348            cError = "В данной матрице процент отклонения товаров от шаблона (=" + STRING(v-gl-dAM-Proc-Otkl) + ")" + chr(10) +
     2349                     " больше допустимого (=" + STRING( v-gl-iProc-Otkl) +  ")." + chr(10) +
     2350                     "Добавление товаров невозможно !".
     2351         END.
     2352      END. ELSE DO:
     2353         IF v-gl-dAM-Proc-Otkl-Ras >= v-gl-iProc-Otkl THEN DO:
     2354            cError = "В данной матрице будущий расчетный процент отклонения товаров от шаблона (=" + STRING(v-gl-dAM-Proc-Otkl-Ras) + ")" + chr(10) +
     2355                     " больше допустимого (=" + STRING( v-gl-iProc-Otkl ) +  ")." + chr(10) +
     2356                     " Добавление товаров невозможно !".
     2357         END.
     2358      END.
     2359      RETURN.
     2360   END PROCEDURE.
     2361   PROCEDURE Get-Gl-Param-Proc-Otkl:
     2362      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     2363      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     2364      DEFINE OUTPUT PARAMETER  cError    AS CHARACTER  NO-UNDO INITIAL "".
     2365      DEFINE BUFFER buf_AM   FOR ub.Assortment-Matrix.
     2366      FIND FIRST buf_AM WHERE
     2367                 buf_AM.asmt-id = p-Asmt-id
     2368             AND buf_AM.db-num  = p-Db-num
     2369           NO-LOCK NO-ERROR.
     2370      IF NOT AVAILABLE buf_AM THEN DO:
     2371         cError = PROGRAM-NAME(1) +  ":Не найдена АМ id=" + STRING(p-Asmt-id) + " db-num=" + STRING(p-Db-num).
     2372         RETURN.
     2373      END.
     2374      RUN Get-Gl-Set-Proc-Otkl IN THIS-PROCEDURE(
     2375          buf_AM.obj-type,
     2376          buf_AM.obj-code
     2377          ).
     2378      RUN Get-Gl-Param-AM-All in THIS-PROCEDURE(
     2379          buf_AM.Asmt-id,
     2380          buf_AM.db-num
     2381          ).
     2382      RETURN.
     2383   END PROCEDURE.
     2384   PROCEDURE Get-Gl-Param-AM-All:
     2385      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     2386      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     2387      DEFINE VARIABLE lIsAmObj    AS LOGICAL    NO-UNDO INITIAL FALSE.
     2388      DEFINE VARIABLE iSh-Asmt-id AS INTEGER    NO-UNDO INITIAL 0.
     2389      DEFINE VARIABLE iSh-Db-num  AS INTEGER    NO-UNDO INITIAL 0.
     2390      DEFINE VARIABLE cSh-Type    AS CHARACTER  NO-UNDO INITIAL "".
     2391      DEFINE VARIABLE cError      AS CHARACTER  NO-UNDO INITIAL "".
     2392      DEFINE VARIABLE dAmt        AS DECIMAL    EXTENT 2  NO-UNDO INITIAL 0.
     2393      DEFINE VARIABLE cMode       AS CHARACTER  NO-UNDO INITIAL "".
     2394      ASSIGN
     2395         v-gl-iAM-Gds-All     = 0
     2396         v-gl-iAM-Sbl-Gds-All = 0
     2397         v-gl-iAM-Gds-Vyv     = 0
     2398         v-gl-dAM-Proc-Otkl   = 0
     2399         v-gl-lAM-Ref-Shablon = FALSE
     2400         .
     2401      RUN Get-Param-AM IN THIS-PROCEDURE (
     2402          p-Asmt-id,
     2403          p-Db-num,
     2404          OUTPUT lIsAmObj,
     2405          OUTPUT iSh-Asmt-id,
     2406          OUTPUT iSh-Db-num,
     2407          OUTPUT cSh-Type,
     2408          OUTPUT cError
     2409          ).
     2410      IF cError <> "" THEN DO:
     2411         MESSAGE
     2412            PROGRAM-NAME(1) ":" SKIP
     2413            "Такого быть не должно !!!" SKIP
     2414            cError SKIP
     2415            VIEW-AS ALERT-BOX INFO BUTTONS OK.
     2416         RETURN.
     2417      END.
     2418      ASSIGN
     2419         cMode                 = (IF lIsAmObj THEN "IL_GDS":U ELSE "")
     2420         v-gl-lAM-Ref-Shablon  = (IF iSh-Asmt-id = 0 THEN FALSE ELSE TRUE)
     2421         .
     2422      RUN Get-Param-AM-Gds IN THIS-PROCEDURE(
     2423          p-Asmt-Id,
     2424          p-Db-num,
     2425          '0':U,
     2426          cMode,
     2427          OUTPUT dAmt
     2428          ).
     2429      ASSIGN
     2430         v-gl-iAM-Gds-All = dAmt[1]
     2431         v-gl-iAM-Gds-Vyv = (IF lIsAmObj THEN dAmt[2] ELSE 0)
     2432         .
     2433       IF NOT v-gl-lAM-Ref-Shablon THEN DO:
     2434          RETURN.
     2435       END.
     2436      RUN Get-Param-AM-Gds IN THIS-PROCEDURE(
     2437          iSh-Asmt-id,
     2438          iSh-Db-num,
     2439          '0':U,
     2440          "",
     2441          OUTPUT dAmt
     2442          ).
     2443      ASSIGN
     2444         v-gl-iAM-Sbl-Gds-All = dAmt[1].
     2445      RUN Calc-Proc-Otkl IN THIS-PROCEDURE(0).
     2446      RETURN.
     2447   END PROCEDURE.
     2448   PROCEDURE Get-Param-AM-Gds:
     2449      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     2450      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     2451      DEFINE INPUT PARAMETER   p-Stat    AS INTEGER    NO-UNDO.
     2452      DEFINE INPUT PARAMETER   p-Mode    AS CHARACTER  NO-UNDO.
     2453      DEFINE OUTPUT PARAMETER  o-dAmt    AS DECIMAL    EXTENT 2 NO-UNDO INITIAL 0.
     2454      DEFINE BUFFER buf_AM-goods FOR ub.Assortment-matrix-goods.
     2455      FOR EACH buf_AM-goods WHERE
     2456               buf_AM-goods.Asmt-id      = p-Asmt-Id
     2457           AND buf_AM-goods.Db-num       = p-Db-num
     2458           AND buf_AM-goods.asmg-status  = p-Stat
     2459          NO-LOCK:
     2460          ASSIGN
     2461             o-dAmt[1] = o-dAmt[1] + 1.
     2462          IF CAN-DO("IL_GDS":U, p-Mode) THEN DO:
     2463             IF Indicator-life-gds-n(recid(buf_AM-goods)) = 'На вывод из ассортимента':U THEN DO:
     2464                ASSIGN
     2465                   o-dAmt[2] = o-dAmt[2] + 1.
     2466             END.
     2467          END.
     2468      END.
     2469      RETURN.
     2470   END PROCEDURE.
     2471   PROCEDURE Get-Param-AM:
     2472      DEFINE INPUT  PARAMETER  p-Asmt-id   AS INTEGER   NO-UNDO.
     2473      DEFINE INPUT  PARAMETER  p-Db-num    AS INTEGER   NO-UNDO.
     2474      DEFINE OUTPUT PARAMETER  lIsObj      AS LOGICAL   NO-UNDO INITIAL FALSE.
     2475      DEFINE OUTPUT PARAMETER  o-Asmt-id   AS INTEGER   NO-UNDO INITIAL 0.
     2476      DEFINE OUTPUT PARAMETER  o-Db-Num    AS INTEGER   NO-UNDO INITIAL 0.
     2477      DEFINE OUTPUT PARAMETER  v-Type      AS CHARACTER NO-UNDO INITIAL "".
     2478      DEFINE OUTPUT PARAMETER  cError      AS CHARACTER NO-UNDO INITIAL "".
     2479      DEFINE VARIABLE v-value AS  CHARACTER NO-UNDO INITIAL "".
     2480      DEFINE BUFFER buf_AM   FOR ub.Assortment-Matrix.
     2481      DEFINE BUFFER buf_AM-2 FOR ub.Assortment-Matrix.
     2482      ASSIGN
     2483         v-gl-lAM-Is-Obj = FALSE.
     2484      FIND FIRST buf_AM WHERE
     2485                 buf_AM.asmt-id = p-Asmt-id
     2486             AND buf_AM.db-num  = p-Db-num
     2487           NO-LOCK NO-ERROR.
     2488      IF NOT AVAILABLE buf_AM THEN DO:
     2489         cError = "Не найдена АМ id=" + STRING(p-Asmt-id) + " db-num=" + STRING(p-Db-num).
     2490         RETURN.
     2491      END.
     2492      IF buf_AM.asmt-type <> 'Объект':U THEN DO:
     2493         RETURN.
     2494      END. ELSE DO:
     2495         ASSIGN
     2496            lIsObj           = TRUE
     2497            v-gl-lAM-Is-Obj  = TRUE
     2498            .
     2499      END.
     2500      run assmatat-value (
     2501          input buf_AM.asmt-id
     2502         ,input buf_AM.db-num
     2503         ,input 'RootShablon':U
     2504         ,output v-value
     2505         ,output v-type
     2506         ) .
     2507      IF v-value = "" OR v-value = ? THEN DO:
     2508         RETURN.
     2509      END.
     2510      ASSIGN
     2511         o-Asmt-id = INTEGER(ENTRY(1, v-value, chr(4)))
     2512         o-Db-num  = INTEGER(ENTRY(2, v-value, chr(4)))
     2513         NO-ERROR.
     2514      IF ERROR-STATUS:ERROR THEN DO:
     2515         cError = PROGRAM-NAME(1) + ":" + ERROR-STATUS:GET-MESSAGE(1).
     2516         RETURN.
     2517      END.
     2518      FIND FIRST buf_AM-2 WHERE
     2519                 buf_AM-2.asmt-id = o-Asmt-id
     2520             AND buf_AM-2.db-num  = o-Db-num
     2521           NO-LOCK NO-ERROR.
     2522      IF NOT AVAILABLE buf_AM-2 THEN DO:
     2523         cError = "Не найден шаблон АМ id=" + STRING(o-Asmt-id) + " db-num=" + STRING(o-Db-num).
     2524         RETURN.
     2525      END.
     2526      RETURN.
     2527   END PROCEDURE.
     2528   PROCEDURE Get-Gl-Set-Proc-Otkl:
     2529      DEFINE INPUT PARAMETER  cObj-type AS CHARACTER NO-UNDO.
     2530      DEFINE INPUT PARAMETER  iObj-code AS INTEGER   NO-UNDO.
     2531      DEFINE VARIABLE v-Character   AS CHARACTER  NO-UNDO .
     2532      DEFINE VARIABLE v-Date        AS DATE       NO-UNDO .
     2533      DEFINE VARIABLE v-Decimal     AS DECIMAL    NO-UNDO .
     2534      DEFINE VARIABLE v-Integer     AS INTEGER    NO-UNDO .
     2535      DEFINE VARIABLE v-Logical     AS LOGICAL    NO-UNDO .
     2536      DEFINE VARIABLE v-Param-Type  AS CHARACTER  NO-UNDO .
     2537      ASSIGN
     2538         v-gl-iProc-Otkl = 0
     2539         .
     2540      EMPTY TEMP-TABLE thbjattr_thbj-attr .
     2541      RUN adm/shattri.p (
     2542              INPUT  "get":U,
     2543              INPUT  cObj-type,
     2544              INPUT  iObj-code,
     2545              INPUT  'Ass-obj':U,
     2546              INPUT  'ass-proc-matr-shabl':U ,
     2547              OUTPUT v-Character,
     2548              OUTPUT v-Date,
     2549              OUTPUT v-Decimal,
     2550              OUTPUT v-Integer,
     2551              OUTPUT v-Logical,
     2552              OUTPUT v-Param-Type,
     2553              INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2554          ) NO-ERROR.
     2555      IF ERROR-STATUS:ERROR THEN DO:
     2556         ASSIGN
     2557            v-Integer  = 0
     2558            v-Decimal  = 0.
     2559      END. ELSE DO:
     2560         ASSIGN
     2561            v-gl-iProc-Otkl = v-Integer
     2562            .
     2563      END.
     2564      RETURN.
     2565   END PROCEDURE.
     2566   PROCEDURE Calc-Proc-Otkl:
     2567      DEFINE INPUT PARAMETER iDeltaGds AS INTEGER NO-UNDO.
     2568      DEFINE VARIABLE iTmp AS INTEGER NO-UNDO INITIAL 0.
     2569      ASSIGN
     2570         v-gl-dAM-Proc-Otkl     = 0
     2571         v-gl-dAM-Proc-Otkl-Ras = 0
     2572         .
     2573      IF NOT v-gl-lAM-Ref-Shablon THEN DO:
     2574         RETURN.
     2575      END.
     2576      IF v-gl-iAM-Sbl-Gds-All = 0 THEN DO:
     2577         ASSIGN
     2578            v-gl-dAM-Proc-Otkl     = 999999
     2579            v-gl-dAM-Proc-Otkl-Ras = 999999
     2580            .
     2581         RETURN.
     2582      END.
     2583      ASSIGN
     2584         iTmp = (v-gl-iAM-Gds-All - v-gl-iAM-Sbl-Gds-All)
     2585         v-gl-dAM-Proc-Otkl     = ROUND(iTmp * 100 / v-gl-iAM-Sbl-Gds-All, 2)
     2586         v-gl-dAM-Proc-Otkl-Ras = ROUND((iTmp + iDeltaGds)  * 100 / v-gl-iAM-Sbl-Gds-All, 2)
     2587         .
     2588      RETURN.
     2589   END PROCEDURE.
     2590   FUNCTION indicator-life-gds-n RETURNS CHARACTER
     2591   ( input p-rec as recid ) :
     2592   define buffer buf_matrix-goods for ub.assortment-matrix-goods .
     2593   define variable v-gdop-min-stock              as decimal   no-undo .
     2594   define variable v-grop-max-stock              as decimal   no-undo .
     2595   define variable v-grop-level-always-presence  as decimal   no-undo .
     2596   define variable v-grop-min-order              as decimal   no-undo .
     2597   define variable v-assort-min                  as LOGICAL   NO-UNDO.
     2598   DEFINE variable v-indicator-life-gds          as CHARACTER NO-UNDO.
     2599   find first buf_matrix-goods no-lock where recid (buf_matrix-goods) = p-rec no-error .
     2600   if error-status :error then return '' .
     2601   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2602   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     2603     (input  buf_Matrix-goods.obj-type
     2604     ,input  buf_Matrix-goods.obj-code
     2605     ,input  ?
     2606     ,input  ?
     2607     ,input  ?
     2608     ,input  buf_Matrix-goods.gds-code
     2609     ,output v-assort-min
     2610     ,output v-indicator-life-gds
     2611     ,output v-gdop-min-stock
     2612     ,output v-grop-max-stock
     2613     ,output v-grop-level-always-presence
     2614     ,output v-grop-min-order
     2615     )  .
     2616     return v-indicator-life-gds.
     2617   end function.
     2618   define variable filter-point as character no-undo init "Просмотр АВС анализа" .
     2619   define variable filter-point0 as character no-undo init "Просмотр_АВС_анализа" .
     2620   define variable sort-column-name as character no-undo .
     2621   define variable doc-rec as recid no-undo .
     2622   define variable v-izt      as character no-undo .
     2623   define variable v-Acc-mat  as character no-undo .
     2624   define variable v-Amin     as character no-undo .
     2625   define variable v-obj-AssMin  as logical   no-undo .
     2626   define variable v-obj-igt     as character no-undo .
     2627   define variable rid-list   as character no-undo .
     2628   define variable list-mode as char  no-undo.
     2629   define variable doc-mode  as char  no-undo.
     2630   define variable line-rec  as recid no-undo.
     2631   define variable gds-rec   as recid no-undo.
     2632   define variable prt-rec   as recid no-undo.
     2633   define variable line-mode as char  no-undo.
     2634   find first buf_abcxyz-analysis no-lock where
     2635              buf_abcxyz-analysis.abcx-id = v-id and
     2636              buf_abcxyz-analysis.db-num = v-db-num
     2637               no-error .
     2638   if not available  buf_abcxyz-analysis then do:
     2639      message vss-workfile vss-revision vss-description skip
     2640             "Не найдена запись buf_abcxyz-analysis " skip
     2641              v-id v-db-num skip
     2642             return-value   skip
     2643             error-status :get-message(1) .
     2644      return.
     2645   end.
     2646   DEFINE VARIABLE v-ass-name AS CHARACTER FORMAT "X(256)":U
     2647        LABEL "Ассортиментная матрица"
     2648         VIEW-AS TEXT
     2649        SIZE 69.5 BY .67
     2650        NO-UNDO.
     2651   define variable g-log as logical   no-undo .
     2652   DEFINE MENU POPUP-MENU-B-print
     2653          MENU-ITEM m_goods        LABEL "Матрица"
     2654                 DISABLED
     2655          MENU-ITEM m_obj          LABEL "Список"        .
     2656   DEFINE BUTTON B-add-AM
     2657        LABEL "Добавить в АМ"
     2658        SIZE 16.5 BY 1 TOOLTIP "Добавить в ассортиментную матрицу по объекту".
     2659   DEFINE BUTTON B-add-AMin
     2660        LABEL "Добавить в АМin"
     2661        SIZE 16.5 BY 1 TOOLTIP "Добавить в ассортиментный минимум по объектам".
     2662   DEFINE BUTTON B-cancel AUTO-END-KEY
     2663        LABEL "&Выход"
     2664        SIZE 10 BY 1
     2665        BGCOLOR 8 .
     2666   DEFINE BUTTON B-chg-izt
     2667        LABEL "Изменить ИЖТ"
     2668        SIZE 12.5 BY 1 TOOLTIP "Изменить ИЖТ".
     2669   DEFINE BUTTON B-del-AM
     2670        LABEL "Удалить из АМ"
     2671        SIZE 16 BY 1 TOOLTIP "Удалить из  ассортиментных матриц по объектам".
     2672   DEFINE BUTTON B-del-AMin
     2673        LABEL "Удалить из АМin"
     2674        SIZE 16 BY 1 TOOLTIP "Удалить из  ассортиментных минимумов по объектам".
     2675   DEFINE BUTTON B-Help
     2676        LABEL "&Помощь"
     2677        SIZE 10 BY 1
     2678        BGCOLOR 8 .
     2679   DEFINE BUTTON B-mark
     2680        LABEL "&*"
     2681        SIZE 3 BY 1.
     2682   DEFINE BUTTON B-ord
     2683        LABEL "Новый заказ"
     2684        SIZE 13.5 BY 1 TOOLTIP "Сформировать заказ".
     2685   DEFINE BUTTON B-print
     2686        LABEL "Пе&чать"
     2687        SIZE 10 BY 1
     2688        BGCOLOR 8 .
     2689   DEFINE BUTTON B-spis-ord
     2690        LABEL "Заказы"
     2691        SIZE 13.5 BY 1 TOOLTIP "Список открытых заказов по отмеченным товарам".
     2692   DEFINE new shared QUERY BROWSE-goods FOR
     2693         Buf_abcxyz-analysis-goods,
     2694         buf_goods SCROLLING.
     2695   DEFINE BROWSE BROWSE-goods
     2696     QUERY BROWSE-goods NO-LOCK DISPLAY
     2697         mark-string(recid( buf_abcxyz-analysis-goods), rid-list) COLUMN-LABEL "*! ! " FORMAT "X(1)":U
     2698         buf_goods.artic                     COLUMN-LABEL "Артикул! ! " FORMAT "X(16)":U            WIDTH 10
     2699         buf_goods.gds-name                 COLUMN-LABEL "Название! ! " FORMAT "X(50)":U        WIDTH 20
     2700         Buf_abcxyz-analysis-goods.abcg-abc COLUMN-LABEL "A!B!C" FORMAT "X(1)":U
     2701         Buf_abcxyz-analysis-goods.xyzg-xyz COLUMN-LABEL "X!Y!Z" FORMAT "X(1)":U
     2702         v-izt      COLUMN-LABEL "ИЖТ! ! "           FORMAT "X(20)":U                                                WIDTH 10
     2703         v-Amin     COLUMN-LABEL "Ассорт.!min! "     FORMAT "X(9)":U                                                 wIDTH 9
     2704         v-Acc-mat  COLUMN-LABEL "Ассорт.!матрица! " FORMAT "X(9)":U                                                 WIDTH 9
     2705         enable
     2706             buf_goods.artic
     2707       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 20 FIT-LAST-COLUMN.
     2708   DEFINE FRAME Dialog-Frame
     2709        B-cancel AT ROW 1 COL 1
     2710        B-mark AT ROW 1 COL 15
     2711        B-chg-izt AT ROW 1 COL 18
     2712        B-add-AM AT ROW 1 COL 30.5
     2713        B-del-AM AT ROW 1 COL 47
     2714        B-spis-ord AT ROW 1 COL 63
     2715        B-Help AT ROW 1 COL 88
     2716        B-add-AMin AT ROW 2 COL 30.5
     2717        B-del-AMin AT ROW 2 COL 47
     2718        B-ord AT ROW 2 COL 63
     2719        B-print AT ROW 2 COL 88
     2720        BROWSE-goods AT ROW 3 COL 1
     2721        SPACE(0.12) SKIP(0.24)
     2722       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2723            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2724            TITLE "Просмотр результатов АВС + XYZ анализа"
     2725            CANCEL-BUTTON B-cancel.
     2726   ASSIGN
     2727          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2728          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2729   ASSIGN
     2730          B-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU POPUP-MENU-B-print:HANDLE.
     2731   ASSIGN
     2732          BROWSE-goods:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 3.
     2733   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2734   DO:
     2735     APPLY "END-ERROR":U TO SELF.
     2736   END.
     2737   ON CHOOSE OF B-add-AM IN FRAME Dialog-Frame
     2738   DO:
     2739     if num-entries( rid-list ) = 0 then do:
     2740       message "Не выбраны товары !!!" view-as alert-box information .
     2741       return no-apply.
     2742     end.
     2743     run proc-cgh-AM ( input true ) no-error .
     2744     if error-status :error then
     2745         message error-status :get-message(1)
     2746             return-value
     2747             "Ошибка вернулась из proc-cgh-Am"
     2748             view-as alert-box error .
     2749   END.
     2750   ON CHOOSE OF B-add-AMin IN FRAME Dialog-Frame
     2751   DO:
     2752     if num-entries( rid-list ) = 0 then do:
     2753       message "Не выбраны товары !!!" view-as alert-box information .
     2754       return no-apply.
     2755     end.
     2756     run proc-cgh-Amin ( input true ) no-error .
     2757     if error-status :error then
     2758         message error-status :get-message(1)
     2759             return-value
     2760             "Ошибка вернулась из proc-cgh-Amin"
     2761             view-as alert-box error .
     2762   END.
     2763   ON CHOOSE OF B-chg-izt IN FRAME Dialog-Frame
     2764   DO:
     2765     if num-entries( rid-list ) = 0 then do:
     2766       message "Не выбраны товары !!!" view-as alert-box information .
     2767       return no-apply.
     2768     end.
     2769     run proc-chg-igt no-error .
     2770     if error-status :error then
     2771         message error-status :get-message(1)
     2772             return-value
     2773             "Ошибка вернулась из proc-chg-igt"
     2774             view-as alert-box error .
     2775   END.
     2776   ON CHOOSE OF B-del-AM IN FRAME Dialog-Frame
     2777   DO:
     2778     if num-entries( rid-list ) = 0 then do:
     2779       message "Не выбраны товары !!!" view-as alert-box information .
     2780       return no-apply.
     2781     end.
     2782     run proc-cgh-AM ( input false ) no-error .
     2783     if error-status :error then
     2784         message error-status :get-message(1)
     2785             return-value
     2786             "Ошибка вернулась из proc-cgh-Am"
     2787             view-as alert-box error .
     2788   END.
     2789   ON CHOOSE OF B-del-AMin IN FRAME Dialog-Frame
     2790   DO:
     2791     if num-entries( rid-list ) = 0 then do:
     2792       message "Не выбраны товары !!!" view-as alert-box information .
     2793       return no-apply.
     2794     end.
     2795     run proc-cgh-Amin ( input false ) no-error .
     2796     if error-status :error then
     2797         message error-status :get-message(1)
     2798             return-value
     2799             "Ошибка вернулась из proc-cgh-Amin"
     2800             view-as alert-box error .
     2801   END.
     2802   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     2803   DO:
     2804       if available Buf_abcxyz-analysis-goods then do:
     2805   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2806   define variable v-str-recid27 as character no-undo .
     2807   define variable v-num-entry27 as integer   no-undo .
     2808   assign
     2809     v-str-recid27 = trim( string( recid( Buf_abcxyz-analysis-goods ) , "->>>>>>>>>>>9":U ) )
