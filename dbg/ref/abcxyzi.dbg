     1479   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1480   define  stream PrnLibStream.
     1481   procedure prn-lib-prn-file :
     1482     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1483     define input parameter p-DIsabledoptions as integer no-undo .
     1484     define variable v-report-name as character no-undo .
     1485     define variable v-user-action as character no-undo .
     1486     define variable v-printed     as logical   no-undo .
     1487     define variable v-exist       as logical   no-undo .
     1488     do
     1489       on error undo, return error
     1490       :
     1491       run prn-lib-get-report-name  in this-procedure (
     1492         input parParentProc
     1493         ,output v-report-name
     1494         ).
     1495   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1496   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1497     (input  v-report-name
     1498     ,input  2
     1499     ,output v-exist
     1500     )  .
     1501       if NOT v-exist then
     1502       DO:
     1503         Message
     1504           "Нет заданий на печать ! "
     1505           view-as alert-box .
     1506         Return  .
     1507       End.
     1508       run gbl/prnfilen.w
     1509         (input  ""
     1510         ,input  p-DisabledOptions
     1511         ,input  string(v-report-name )
     1512         ,input  7
     1513         ,output v-user-action
     1514         ,output v-printed
     1515         ) .
     1516       if v-printed then
     1517       do:
     1518         return "YES" .
     1519       end.
     1520       else
     1521       do:
     1522         return "NO" .
     1523       end.
     1524     end.
     1525   end procedure.
     1526   procedure prn-lib-open-stream :
     1527     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1528     define input parameter p-page-size    as integer no-undo .
     1529     define input parameter p-is-stream    as logical no-undo .
     1530     define input parameter p-append       as logical no-undo .
     1531     define variable v-report-name as character no-undo .
     1532     do
     1533       on error undo, return error
     1534       :
     1535       run prn-lib-get-report-name  in this-procedure (
     1536         input parParentProc
     1537         ,output v-report-name
     1538         ).
     1539       if p-is-stream then
     1540       do:
     1541         if p-append then
     1542         do:
     1543           output stream PrnLibStream to value( v-report-name )
     1544             page-size value(p-page-size) append .
     1545         end.
     1546         if not p-append then
     1547         do:
     1548           output stream PrnLibStream to value( v-report-name )
     1549             page-size value(p-page-size) .
     1550         end.
     1551       end.
     1552       if not p-is-stream then
     1553       do:
     1554         if p-append then
     1555         do:
     1556           output to value( v-report-name )
     1557             page-size value(p-page-size) append .
     1558         end.
     1559         if not p-append then
     1560         do:
     1561           output to value( v-report-name )
     1562             page-size value(p-page-size) .
     1563         end.
     1564       end.
     1565     end.
     1566   end procedure.
     1567   procedure prn-lib-open-exp :
     1568     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1569     define input parameter p-is-stream    as logical no-undo .
     1570     define input parameter p-is-append    as logical no-undo .
     1571     define output parameter p-ReportFileName as char init "report" no-undo.
     1572     define output parameter p-process as logical no-undo .
     1573     define variable glog as logical no-undo .
     1574     do
     1575       on error undo, return error
     1576       :
     1577       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1578         TITLE      "Укажите путь"
     1579         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1580         ASK-OVERWRITE
     1581         CREATE-TEST-FILE
     1582         SAVE-AS
     1583         USE-FILENAME
     1584         DEFAULT-EXTENSION "txt"
     1585         UPDATE glog
     1586         .
     1587       if not glog then  return.
     1588       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1589       if p-is-stream then
     1590       do:
     1591         if p-is-append then
     1592         do:
     1593           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1594         end.
     1595         else
     1596         do:
     1597           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1598         end.
     1599       end.
     1600       else
     1601       do:
     1602         if p-is-append then
     1603         do:
     1604           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1605         end.
     1606         else
     1607         do:
     1608           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1609         end.
     1610       end.
     1611       p-process = yes.
     1612     end.
     1613   end procedure.
     1614   procedure prn-lib-get-report-name :
     1615     define input parameter parParentProc  as widget-handle no-undo.
     1616     define output parameter p-report-name as character no-undo .
     1617     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1618   end procedure.
     1619   procedure prn-lib-reportviewer-report-name :
     1620     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1621     define input parameter p-report-name-html as character no-undo .
     1622     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1623   end procedure.
     1624   procedure prn-lib-reportviewer :
     1625     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1626     define input parameter p-report-name-html as character no-undo .
     1627     define input parameter p-param        as character no-undo .
     1628     define variable v-excel           as character no-undo init 'TRUE' .
     1629     define variable v-value-character as character no-undo .
     1630     define variable v-value-integer   as character no-undo .
     1631     define variable v-value-date      as date      no-undo .
     1632     define variable v-value-decimal   as decimal   no-undo .
     1633     define variable rep-excel         as logical   no-undo .
     1634     define variable excel-string      as character no-undo .
     1635     define variable v-param-type      as character no-undo .
     1636     define variable v-tth             as handle    no-undo .
     1637     run adm/shattri.p (
     1638       input "get":U
     1639       ,input  ""
     1640       ,input  0
     1641       ,input  'report-glob':U
     1642       ,input  'rep-excel':U
     1643       ,output v-value-character
     1644       ,output v-value-date
     1645       ,output v-value-decimal
     1646       ,output v-value-integer
     1647       ,output rep-excel
     1648       ,output v-param-type
     1649       ,INPUT-OUTPUT table-handle v-tth
     1650       )  .
     1651     if rep-excel then v-excel = "TRUE" .
     1652     else v-excel = "FALSE" .
     1653     if p-param eq ""
     1654     then
     1655        p-param = "EXCEL:" + v-excel.
     1656     else
     1657        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1658     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1659   end procedure.
     1660   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1661   function func-get-name-from-ext-type   returns char
     1662     ( p-ext-type as character   ,
     1663       p-caps     as logical ).
     1664   define variable v-ext-name as character no-undo .
     1665   run get-name-from-ext-type in this-procedure (
     1666       input p-ext-type  ,
     1667       input p-caps  ,
     1668       output v-ext-name )
     1669       no-error .
     1670       if error-status :error then do:
     1671          assign
     1672            v-ext-name = p-ext-type
     1673          .
     1674       end.
     1675    return (v-ext-name) .
     1676   end.
     1677   procedure get-name-from-ext-type :
     1678    do
     1679    on error undo, return error return-value
     1680    :
     1681   define input  parameter p-ext-type as character no-undo .
     1682   define input  parameter p-caps     as logical no-undo   .
     1683   define output parameter p-ext-name as character no-undo .
     1684   define variable v-num as integer no-undo .
     1685     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     1686       message
     1687         vss-include-info11 skip
     1688         "Неправильно задано значение входящего параметра! "
     1689         "Нет такого типа документов " p-ext-type
     1690         view-as alert-box error .
     1691         undo, return error .
     1692     end.
     1693     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     1694     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     1695     if p-caps  = true then do :
     1696        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     1697     end .
     1698     end.
     1699   end procedure.
