     1909   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1910   procedure fltopend_fltopend :
     1911   define input parameter p-parent-handle as handle no-undo .
     1912   define input parameter p-qh as handle no-undo .
     1913   define input parameter p-flt-open-open-query  as character no-undo .
     1914   define input parameter p-where-cond as character no-undo .
     1915   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1916   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1917   define input parameter p-indexed-reposition as character no-undo .
     1918     do
     1919     on error undo, return error
     1920     :
     1921   define variable v-prepare-string as character no-undo .
     1922   define variable glog as logical no-undo .
     1923   assign
     1924   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1925                      p-where-cond + chr(32)  +
     1926                      p-use-indFIRST-query-tail + chr(32) +
     1927                      p-use-ind-sort-clmn-by + chr(32) +
     1928                      p-indexed-reposition
     1929   .
     1930   assign
     1931   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1932   if not glog
     1933   or error-status:error then do:
     1934     message error-status:get-message(1) view-as alert-box .
     1935     undo, return error .
     1936   end.
     1937   assign
     1938   glog = p-qh:query-open no-error .
     1939   if not glog
     1940   or error-status:error then do:
     1941     message error-status:get-message(1) view-as alert-box .
     1942     undo, return error .
     1943   end.
     1944     end.
     1945   end procedure.
     1946   procedure fltopend_fltfindd :
     1947   define input parameter p-parent-handle as handle no-undo .
     1948   define input parameter p-qh as handle no-undo .
     1949   define input parameter p-rowid as rowid no-undo .
     1950   define input parameter p-next as logical no-undo .
     1951   define input parameter p-lock as integer no-undo .
     1952   define input parameter p-bh as handle no-undo .
     1953   define input parameter p-where-cond as character no-undo .
     1954   define input parameter p-use-index-phrase as character no-undo .
     1955   define variable glog as logical no-undo .
     1956   define variable v-qh as handle no-undo .
     1957   define variable v-bh as handle no-undo .
     1958   define variable v-recid as recid no-undo .
     1959   define variable v-prepare-string as character no-undo .
     1960   do
     1961   on error undo, return error
     1962   on stop undo, return error
     1963   :
     1964     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1965     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1966     create query v-qh.
     1967     v-qh:set-buffers(v-bh).
     1968     v-prepare-string = substitute("for each &1 &2 &3"
     1969                                     ,v-bh:name
     1970                                     ,p-where-cond
     1971                                     ,p-use-index-phrase).
     1972     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1973     if not glog then do:
     1974       delete object v-qh.
     1975       delete object v-bh.
     1976       undo, return error .
     1977     end.
     1978     glog = v-qh:query-open no-error .
     1979     if not glog then do:
     1980       delete object v-qh.
     1981       delete object v-bh.
     1982       undo, return error .
     1983     end.
     1984     if p-next then do:
     1985       v-qh:reposition-to-rowid(p-rowid) no-error .
     1986       glog = v-qh:get-next( p-lock) no-error .
     1987       glog = v-qh:get-next( p-lock) no-error .
     1988       if not glog or v-qh:query-off-end = yes then do:
     1989         glog = v-qh:get-first( p-lock) no-error .
     1990       end.
     1991     end.
     1992     else do:
     1993       glog = v-qh:get-first( p-lock) no-error .
     1994     end.
     1995     v-recid = v-bh:recid no-error .
     1996     delete object v-qh.
     1997     delete object v-bh.
     1998     return string(v-recid) .
     1999   end.
     2000   end procedure.
     2001   procedure fltopend_fltfindq :
     2002   define input parameter p-parent-handle as handle no-undo .
     2003   define input parameter p-qh as handle no-undo .
     2004   define input parameter p-next as logical no-undo .
     2005   define input parameter p-lock as integer no-undo .
     2006   define input parameter p-flt-open-open-query  as character no-undo .
     2007   define input parameter p-where-cond as character no-undo .
     2008   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2009   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2010   define input parameter p-indexed-reposition as character no-undo .
     2011   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     2012   define variable glog as logical no-undo .
     2013   define variable v-qh as handle no-undo .
     2014   define variable v-bh as handle no-undo extent 18.
     2015   define variable v-rowid as rowid no-undo extent 18.
     2016   define variable v-ii as integer no-undo .
     2017   define variable v-prepare-string as character no-undo .
     2018   do
     2019   on error undo, return error
     2020   on stop undo, return error
     2021   :
     2022     create query v-qh.
     2023     do v-ii = 1 to p-qh:num-buffers:
     2024       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     2025       assign
     2026       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     2027       no-error.
     2028       v-qh:add-buffer(v-bh[v-ii]).
     2029     end.
     2030     assign
     2031     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2032                       p-where-cond + chr(32)  +
     2033                       p-use-indFIRST-query-tail + chr(32) +
     2034                       p-use-ind-sort-clmn-by + chr(32) +
     2035                       p-indexed-reposition
     2036     .
     2037     glog = v-qh:query-prepare( v-prepare-string) no-error .
     2038     if not glog then do:
     2039       delete object v-qh.
     2040       do v-ii = 1 to p-qh:num-buffers:
     2041         delete object v-bh[v-ii].
     2042       end.
     2043       undo, return error .
     2044     end.
     2045     glog = v-qh:query-open no-error .
     2046     if not glog then do:
     2047       delete object v-qh.
     2048       do v-ii = 1 to p-qh:num-buffers:
     2049         delete object v-bh[v-ii].
     2050       end.
     2051       undo, return error .
     2052     end.
     2053     if p-next then do:
     2054       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     2055       glog = v-qh:get-next( p-lock) no-error .
     2056       glog = v-qh:get-next( p-lock) no-error .
     2057       if not glog or v-qh:query-off-end = yes then do:
     2058         glog = v-qh:get-first( p-lock) no-error .
     2059       end.
     2060     end.
     2061     else do:
     2062       glog = v-qh:get-first( p-lock) no-error .
     2063     end.
     2064     do v-ii = 1 to p-qh:num-buffers:
     2065       assign
     2066       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     2067       no-error.
     2068     end.
     2069     delete object v-qh.
     2070     do v-ii = 1 to p-qh:num-buffers:
     2071       delete object v-bh[v-ii].
     2072     end.
     2073   end.
     2074   end procedure.
