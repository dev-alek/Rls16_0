     1718   define variable v-grop-max-stock                as decimal   no-undo .
     1719   define variable v-grop-level-always-presence    as decimal   no-undo .
     1720   define variable v-grop-min-order                as decimal   no-undo .
     1721       assign
     1722         v-old-izt  = ""
     1723         v-izt      = ""
     1724         v-Amin     = ""
     1725         v-old-Amin = ""
     1726         v-acc-mat     = ""
     1727         v-old-acc-mat = ""
     1728         .
     1729   for each buf_analysis-obj where
     1730            buf_analysis-obj.abc-id = buf_abcxyz-analysis.abc-id and
     1731            buf_analysis-obj.db-num = buf_abcxyz-analysis.abc-db-num
     1732            no-lock,
     1733           each buf2_analysis-gds-obj where
     1734               buf2_analysis-gds-obj.obj-type = buf_analysis-obj.obj-type and
     1735               buf2_analysis-gds-obj.obj-code = buf_analysis-obj.obj-code and
     1736               buf2_analysis-gds-obj.gds-code = p-gds-code and
     1737               buf2_analysis-gds-obj.abc-id   = buf_abcxyz-analysis.abc-id and
     1738               buf2_analysis-gds-obj.db-num   = buf_abcxyz-analysis.abc-db-num
     1739               no-lock break
     1740               by buf2_analysis-gds-obj.gds-code
     1741               :
     1742                   find first buf2_assortment-matrix where
     1743                         buf2_assortment-matrix.asmt-status        = 0  and
     1744                         buf2_assortment-matrix.obj-type =  buf_analysis-obj.obj-type and
     1745                         buf2_assortment-matrix.obj-code =  buf_analysis-obj.obj-code
     1746                         no-lock no-error .
     1747                   find first buf2_assortment-matrix-goods where
     1748                         buf2_assortment-matrix-goods.asmg-status        = 0  and
     1749                         buf2_assortment-matrix-goods.asmt-id  =  buf2_assortment-matrix.asmt-id and
     1750                         buf2_assortment-matrix-goods.db-num   =  buf2_assortment-matrix.db-num  and
     1751                         buf2_assortment-matrix-goods.gds-code =  buf2_analysis-gds-obj.gds-code
     1752                         no-lock no-error .
     1753   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1754   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     1755     (input  buf_analysis-obj.obj-type
     1756     ,input  buf_analysis-obj.obj-code
     1757     ,input  ?
     1758     ,input  ?
     1759     ,input  ?
     1760     ,input  p-gds-code
     1761     ,output t-amin
     1762     ,output t-izt
     1763     ,output v-gdop-min-stock
     1764     ,output v-grop-max-stock
     1765     ,output v-grop-level-always-presence
     1766     ,output v-grop-min-order
     1767     )  .
     1768                if not available buf2_assortment-matrix-goods then t-asm = "0" .
     1769                                                              else t-asm = string(buf2_assortment-matrix-goods.asmt-id).
     1770               if first-of(buf2_analysis-gds-obj.gds-code) then do:
     1771                     assign
     1772                     v-old-izt  =  t-izt
     1773                     v-izt      =  t-izt
     1774                     v-amin     =  t-amin
     1775                     v-old-amin =  t-amin
     1776                     v-acc-mat     =  t-asm
     1777                     v-old-acc-mat =  t-asm
     1778                     .
     1779                     if  v-amin = 'no'  then v-amin = "не входит" .
     1780                                        else v-amin = "входит" .
     1781                     if v-acc-mat = "0" then v-acc-mat = "не входит" .
     1782                                        else v-acc-mat = "входит" .
     1783               end.
     1784           if v-old-izt     <> t-izt            then  v-izt = "разное" .
     1785           if v-old-amin    <> t-amin           then  v-amin = "разное" .
     1786           if v-old-acc-mat <> t-asm            then  v-acc-mat = "разное" .
     1787         assign
     1788           v-old-izt     = t-izt
     1789           v-old-amin    = t-amin
     1790           v-old-acc-mat = t-asm
     1791         .
     1792   end.
     1793   end procedure.
