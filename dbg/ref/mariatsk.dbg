      494   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
      495   define variable v-is-closed-shift-journal as integer no-undo .
      496   assign
      497   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
      498                               +
      499                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
      500                               +
      501                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
      502   .
      503   return v-is-closed-shift-journal.
      504   END FUNCTION.
      505   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
      506   define variable v-is-first-journal as logical no-undo .
      507   assign
      508   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
      509                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
      510                     or (p-journal-num =  integer(entry(1, '17':U)))
      511                     or (p-journal-num = integer(entry(1, '16':U)))
      512   .
      513   return v-is-first-journal.
      514   END FUNCTION.
      515   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
      516   define variable v-is-petrol-journal as logical no-undo .
      517   assign
      518   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
      519   return v-is-petrol-journal.
      520   END FUNCTION.
      521   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
      522   define variable v-max-record-num as integer no-undo .
      523   assign
      524   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
      525                       then 1489
      526                       else 2340).
      527   return v-max-record-num.
      528   END FUNCTION.
      529   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
      530   define variable v-max-record-num as integer no-undo .
      531   assign
      532   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
      533                       then 1489 * num-entries('30,31,32,33':U)
      534                       else 2340 * num-entries('17':U)).
      535   return v-max-record-num.
      536   END FUNCTION.
      537   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
      538                                           ,input p-rec-no as integer):
      539   define variable v-num-recs as integer no-undo .
      540   if tekka-is-petrol-journal (p-journal-num) then do:
      541     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
      542       assign
      543       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
      544       .
      545     end.
      546     else do:
      547       assign
      548       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
      549       .
      550     end.
      551   end.
      552   else do:
      553     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
      554       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
      555         assign
      556         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
      557         .
      558       end.
      559       else do:
      560         assign
      561         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
      562         .
      563       end.
      564     end.
      565     else do:
      566       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
      567         assign
      568         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
      569         .
      570       end.
      571       else do:
      572         assign
      573         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
      574         .
      575       end.
      576     end.
      577   end.
      578   return v-num-recs.
      579   END FUNCTION.
      580   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
      581                                              ,input p-is-petrol as logical
      582                                              ,input p-is-current as logical
      583                                              ,output p-rec-no as decimal
      584                                              ):
      585   define variable v-obj-num0 as integer no-undo .
      586   define variable v-obj-num as integer no-undo .
      587   define variable v-obj-num2 as integer no-undo .
      588   define variable p-num-recs2 as integer no-undo .
      589   define variable p-rec-no2 as integer no-undo .
      590   if p-is-petrol then do:
      591     assign
      592     v-obj-num0 = trunc(p-num-recs / 1489, 0)
      593     .
      594     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
      595     then
      596     assign
      597     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
      598     p-rec-no = p-num-recs modulo 1489
      599     .
      600     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
      601     then
      602     assign
      603     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
      604     p-rec-no = p-num-recs modulo 1489
      605     .
      606   end.
      607   else do:
      608     assign
      609     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
      610     p-num-recs = trunc(p-num-recs, 0)
      611     v-obj-num0 = trunc(p-num-recs / 2340, 0)
      612     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
      613     .
      614     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
      615     then
      616     assign
      617     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
      618     p-rec-no = p-num-recs modulo 2340
      619     .
      620     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
      621     then
      622     assign
      623     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
      624     p-rec-no = p-num-recs modulo 2340
      625     .
      626     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
      627     then
      628     assign
      629     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
      630     p-rec-no2 = p-num-recs2 modulo 2978
      631     .
      632     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
      633     then
      634     assign
      635     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
      636     p-rec-no2 = p-num-recs2 modulo 2978
      637     .
      638     assign
      639     p-rec-no = p-rec-no + p-rec-no2 / 10000
      640     .
      641   end.
      642   if v-obj-num = 0 then v-obj-num = 100.
      643   return v-obj-num.
      644   END FUNCTION.
      645   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
      646   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
      647   if lookup (string(p-obj-num), '17':U) > 0 then do:
      648      if p-is-ptrl then
      649      return integer(entry(1, '26,27,28,29':U)).
      650      if not p-is-ptrl then
      651      return integer(entry(1, '16':U)).
      652   end.
      653   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
      654   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
      655   return 0.
      656   END FUNCTION.
      657   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
      658   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
      659   if lookup (string(p-obj-num), '17':U) > 0 then do:
      660     if p-is-ptrl then
      661     return integer(entry(1, '26,27,28,29':U)).
      662     if not p-is-ptrl then
      663     return integer(entry(1, '16':U)).
      664   end.
      665   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
      666   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
      667   return 0.
      668   END FUNCTION.
      669   procedure tekkatsk-verify-schema :
      670   define input parameter p-obj-list as character no-undo .
      671   define input parameter p-dir-path as character no-undo .
      672   define variable v-obj-num as integer no-undo .
      673   define variable v-obj-name as character no-undo .
      674   define variable v-num-records as integer no-undo .
      675   define variable v-size_ as integer no-undo .
      676   define variable v-value as character no-undo .
      677   define variable ii as integer no-undo .
      678   define variable jj as integer no-undo .
      679   define variable ii-ibs as integer no-undo .
      680   define variable ii-tekka as integer no-undo .
      681   define variable v-result as character no-undo .
      682   define buffer buf_temp-tekka-schema for temp-tekka-schema.
      683   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
      684     do
      685     on error undo, return error
      686     :
      687        for each buf_temp-tekka-schema:
      688          delete buf_temp-tekka-schema.
      689        end.
      690        input from value('tekkasch.d').
      691        repeat :
      692          create buf_temp-tekka-schema.
      693          import buf_temp-tekka-schema.
      694          assign
      695          buf_temp-tekka-schema.host = 'IBS'
      696          ii = ii + 1.
      697          .
      698        end.
      699        input close.
      700        ii-ibs = ii.
      701         _ii:
      702         do ii = 1 to 256:
      703           if p-obj-list = "ALL"
      704           or lookup(string(ii), p-obj-list) > 0 then do:
      705             assign
      706             v-obj-num = 0
      707             v-obj-name = ''
      708             v-num-records = 0
      709             v-size_ = 0
      710             .
      711             run alienini-getkey in this-procedure (
      712                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      713                                                     ,input ('obj' + string(ii, '999'))
      714                                                     ,input 'oname'
      715                                                     ,output v-value) no-error .
      716             if v-value = ? then next _ii.
      717             assign
      718             v-obj-num = ii
      719             v-obj-name = v-value
      720             .
      721             run alienini-getkey in this-procedure (
      722                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      723                                                     ,input ('obj' + string(ii, '999'))
      724                                                     ,input 'size'
      725                                                     ,output v-value) no-error .
      726             assign
      727             v-num-records = integer(v-value) no-error  .
      728             if error-status:error
      729             or v-num-records = 0 then next _ii.
      730             run alienini-getkey in this-procedure (
      731                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      732                                                     ,input 'obj' + string(ii, '999')
      733                                                     ,input 'f000'
      734                                                     ,output v-value) no-error .
      735             assign
      736             v-size_ = integer(v-value) no-error  .
      737             if error-status:error
      738             or v-size_ = 0 then next _ii.
      739             _jj:
      740             do jj = 1 to 256:
      741               run alienini-getkey in this-procedure (
      742                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      743                                                       ,input 'obj' + string(ii, '999')
      744                                                       ,input 'f' + string(jj, '999')
      745                                                       ,output v-value) no-error .
      746               if v-value = ? then next _ii.
      747               create buf_temp-tekka-schema.
      748               assign
      749               buf_temp-tekka-schema.host = 'tekka'
      750               buf_temp-tekka-schema.obj-num = v-obj-num
      751               buf_temp-tekka-schema.obj-name = v-obj-name
      752               buf_temp-tekka-schema.num-records = v-num-records
      753               buf_temp-tekka-schema.size_ = v-size_
      754               buf_temp-tekka-schema.field-num = jj
      755               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
      756               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
      757                                                  then entry(2, entry(2, v-value, '#'), ':')
      758                                                  else '':U)
      759               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
      760               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
      761               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
      762                                                           , 'C,I,I,I,D,D,D,D,D':U)
      763               no-error
      764               .
      765               if error-status:error then do:
      766                 delete buf_temp-tekka-schema.
      767                 next _jj.
      768               end.
      769               run alienini-getkey in this-procedure (
      770                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      771                                                       ,input 'obj' + string(ii, '999') + 'name'
      772                                                       ,input 'n' + string(jj, '999')
      773                                                       ,output v-value) no-error .
      774               if v-value <> ? then
      775               buf_temp-tekka-schema.field-name = v-value.
      776             end.
      777           end.
      778         end.
      779         ii-tekka = ii - 1.
      780        if p-obj-list <> 'ALL' then do:
      781         if ii-tekka <> ii-ibs then do:
      782           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
      783                                   , ii-ibs
      784                                   , ii-tekka).
      785         end.
      786        end.
      787        for each buf_temp-tekka-schema where
      788               buf_temp-tekka-schema.host = 'tekka':
      789          find first buf2_temp-tekka-schema where
      790                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
      791                AND buf2_temp-tekka-schema.host = 'ibs'
      792                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
      793          if not available buf2_temp-tekka-schema then do:
      794           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
      795                                   , buf_temp-tekka-schema.field-num
      796                                   , buf_temp-tekka-schema.obj-num).
      797          end.
      798          buffer-compare buf_temp-tekka-schema
      799          to buf2_temp-tekka-schema
      800          save result in v-result.
      801          if v-result <> '':U then do:
      802           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
      803                                   , buf_temp-tekka-schema.field-num
      804                                   , buf_temp-tekka-schema.obj-num).
      805          end.
      806        end.
      807     end.
      808   end procedure.
      809   FUNCTION set-Sx returns character (input p-string as character):
      810   return p-string.
      811   END FUNCTION.
      812   FUNCTION get-Sx returns character (input p-string  as character):
      813   return p-string.
      814   END FUNCTION.
      815   FUNCTION set-B returns character (input p-string  as character):
      816   return chr(integer(p-string)).
      817   END FUNCTION.
      818   FUNCTION get-B returns character (input p-string  as character):
      819   return string(asc(p-string)).
      820   END FUNCTION.
      821   FUNCTION set-BF returns character (input p-string  as character):
      822   define variable v-dopi as integer no-undo .
      823   define variable ii as integer no-undo .
      824   do ii = 1 to 8:
      825     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
      826   end.
      827   return chr(v-dopi).
      828   END FUNCTION.
      829   FUNCTION get-BF returns character (input p-string  as character):
      830   define variable v-dopi as integer no-undo .
      831   define variable v-dops as character no-undo .
      832   define variable ii as integer no-undo .
      833   v-dopi = asc(p-string).
      834   do ii = 8 to 1 BY -1:
      835     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
      836   end.
      837   return v-dops.
      838   END FUNCTION.
      839   FUNCTION set-BN returns character (input p-string  as character
      840                                     ,input p-bin-group as character):
      841   define variable v-dopi as integer no-undo .
      842   define variable ii as integer no-undo .
      843   define variable jj as integer no-undo .
      844   define variable v-grp-nums as integer no-undo .
      845   define variable v-dopi2 as integer no-undo .
      846   v-grp-nums = num-entries(p-bin-group).
      847   do jj = 0 to v-grp-nums - 1:
      848     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
      849     do ii = 1 to 8:
      850       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
      851     end.
      852   end.
      853   return chr(v-dopi).
      854   END FUNCTION.
      855   FUNCTION get-BN returns character (input p-string  as character
      856                                     ,input p-bin-group as character):
      857   define variable v-dopi as integer no-undo .
      858   define variable v-dops as character no-undo .
      859   define variable v-grp-nums as integer no-undo .
      860   define variable ii as integer no-undo .
      861   define variable jj as integer no-undo .
      862   v-dopi = asc(p-string).
      863   v-grp-nums = num-entries(p-bin-group).
      864   do jj = 1 to v-grp-nums:
      865   do ii = 8 to 1 BY -1:
      866     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
      867   end.
      868   end.
      869   return v-dops.
      870   END FUNCTION.
      871   DEFINE BUTTON B-exit AUTO-GO
      872        LABEL "&Ввод"
      873        SIZE 10 BY 1
      874        BGCOLOR 8 .
      875   DEFINE BUTTON B-Help
      876        LABEL "Помо&щь"
      877        SIZE 10 BY 1
      878        BGCOLOR 8 .
      879   DEFINE BUTTON b-quit AUTO-END-KEY
      880        LABEL "&Отмена"
      881        SIZE 10 BY 1
      882        BGCOLOR 8 .
      883   DEFINE VARIABLE checktime-par AS INTEGER FORMAT ">>9":U INITIAL 0
      884        LABEL "Мин"
      885        VIEW-AS FILL-IN
      886        SIZE 7 BY 1 NO-UNDO.
      887   DEFINE VARIABLE dtime-par AS INTEGER FORMAT ">>9":U INITIAL 0
      888        LABEL "Мин"
      889        VIEW-AS FILL-IN
      890        SIZE 7 BY 1 NO-UNDO.
      891   DEFINE VARIABLE checktime AS LOGICAL INITIAL no
      892        LABEL "Периодичность выгрузки"
      893        VIEW-AS TOGGLE-BOX
      894        SIZE 34 BY 1 NO-UNDO.
      895   DEFINE VARIABLE dtime AS LOGICAL INITIAL no
      896        LABEL "Периодичность выгрузки журналов"
      897        VIEW-AS TOGGLE-BOX
      898        SIZE 34 BY 1 NO-UNDO.
      899   DEFINE VARIABLE t-income AS LOGICAL INITIAL no
      900        LABEL "Выгрузка данных по приходу топлива"
      901        VIEW-AS TOGGLE-BOX
      902        SIZE 42 BY 1 NO-UNDO.
      903   DEFINE VARIABLE t-rsrv-line AS LOGICAL INITIAL no
      904        LABEL "Выгрузка данных с уровнемеров"
      905        VIEW-AS TOGGLE-BOX
      906        SIZE 42 BY 1 NO-UNDO.
      907   DEFINE VARIABLE t-spool AS LOGICAL INITIAL no
      908        LABEL "Выгрузка чеков"
      909        VIEW-AS TOGGLE-BOX
      910        SIZE 42 BY 1 NO-UNDO.
      911   DEFINE VARIABLE zfactor AS LOGICAL INITIAL no
      912        LABEL "Выгрузка после z-отчета"
      913        VIEW-AS TOGGLE-BOX
      914        SIZE 34 BY 1 NO-UNDO.
      915   DEFINE FRAME Dialog-Frame
      916        B-exit AT ROW 1 COL 1
      917        b-quit AT ROW 1 COL 11
      918        B-Help AT ROW 1 COL 71
      919        t-spool AT ROW 2.5 COL 1
      920        dtime AT ROW 2.5 COL 46.5
      921        dtime-par AT ROW 2.5 COL 84.5 COLON-ALIGNED
      922        t-income AT ROW 4 COL 1
      923        checktime AT ROW 4 COL 46.5
      924        checktime-par AT ROW 4 COL 84.5 COLON-ALIGNED
      925        t-rsrv-line AT ROW 5.5 COL 1
      926        zfactor AT ROW 5.5 COL 46.5
      927        SPACE(13.99) SKIP(1.37)
      928       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      929            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      930            TITLE "Определение периодического задания для кассы MARIA"
      931            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      932   ASSIGN
      933          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      934          FRAME Dialog-Frame:HIDDEN           = TRUE.
      935   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      936   DO:
      937     APPLY "END-ERROR":U TO SELF.
      938   END.
      939   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      940   DO:
      941     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      942     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      943   END.
      944   ON VALUE-CHANGED OF checktime IN FRAME Dialog-Frame
      945   DO:
      946      ASSIGN
      947     checktime.
      948     CASE checktime:
      949         WHEN YES THEN DO:
      950            ENABLE
      951            checktime-par
      952            WITH FRAME Dialog-Frame.
      953         END.
      954         WHEN no THEN DO:
      955             checktime-par =0.
      956             DISPLAY
      957             checktime-par
      958             WITH FRAME Dialog-Frame.
      959             DISABLE
      960             checktime-par
      961             WITH FRAME Dialog-Frame.
      962         END.
      963     END CASE.
      964   END.
      965   ON VALUE-CHANGED OF dtime IN FRAME Dialog-Frame
      966   DO:
      967     ASSIGN
      968     dtime.
      969     CASE dtime:
      970         WHEN YES THEN DO:
      971            ENABLE
      972            dtime-par
      973            WITH FRAME Dialog-Frame.
      974         END.
      975         WHEN no THEN DO:
      976             dtime-par =0.
      977             DISPLAY
      978             dtime-par
      979             WITH FRAME Dialog-Frame.
      980             DISABLE
      981             dtime-par
      982             WITH FRAME Dialog-Frame.
      983         END.
      984     END CASE.
      985   END.
      986   ON VALUE-CHANGED OF t-income IN FRAME Dialog-Frame
      987   DO:
      988   ASSIGN  t-income.
      989   RUN proc-non-spool IN THIS-PROCEDURE NO-ERROR.
      990   IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      991   END.
      992   ON VALUE-CHANGED OF t-rsrv-line IN FRAME Dialog-Frame
      993   DO:
      994     ASSIGN  t-rsrv-line.
      995   RUN proc-non-spool IN THIS-PROCEDURE NO-ERROR.
      996   IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      997   END.
      998   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      999   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1000   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1001   on help of frame Dialog-Frame
     1002   do:
     1003     run gbl/app_help.p
     1004       (input this-procedure :file-name
     1005       ,input ''
     1006       ,input ?
     1007       ) no-error.
     1008     if error-status :error then do:
     1009       message
     1010         "Ошибка при вызове помощи"
     1011         error-status :get-message(1)
     1012         view-as alert-box .
     1013     end.
     1014   end.
     1015   run minbtn-set in this-procedure .
     1016   on choose of b-help in frame Dialog-Frame
     1017   do:
     1018     apply "help":u to frame Dialog-Frame .
     1019   end.
     1020   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1021   procedure minbtn-set :
     1022       do
     1023           on error undo, return error return-value
     1024           :
     1025           define variable ii              as integer       no-undo .
     1026           define variable fh              as widget-handle no-undo .
     1027           define variable hh              as widget-handle no-undo .
     1028           define variable v-h             as handle        extent 4 no-undo .
     1029           define variable v-name-button   as character     no-undo .
     1030           define variable v-help-old-x    as decimal       no-undo .
     1031           define variable v-help-old-y    as decimal       no-undo .
     1032           define variable v-help-old-size as decimal       no-undo .
     1033           define variable v-frame-width   as decimal       no-undo .
     1034           define variable jj              as integer       no-undo .
     1035           do
     1036               on error undo, return error
     1037               :
     1038               assign
     1039                   v-frame-width = frame Dialog-Frame:width - 0.3
     1040                   fh            = frame Dialog-Frame:first-child
     1041                   hh            = fh:first-child
     1042                   ii            = 1
     1043                   .
     1044               do while valid-handle(hh):
     1045                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1046                   do:
     1047                       case lc(hh:name) :
     1048                           when "b-help" then
     1049                               do:
     1050                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1051                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1052                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1053                                   hh:TOOLTIP = "Помощь" .
     1054                                   v-help-old-x = hh:column .
     1055                                   v-help-old-y = hh:row    .
     1056                                   v-help-old-size = hh:width .
     1057                                   hh:width-chars = 2.5 .
     1058                               end.
     1059                           when "b-print" then
     1060                               do:
     1061                                   hh:load-image("cmp/b-print.bmp":u) .
     1062                                   hh:TOOLTIP = "Печать" .
     1063                                   v-h[ii] = hh:handle .
     1064                                   ii = ii + 1 .
     1065                                   hh:width-chars = 3 .
     1066                               end.
     1067                           when "b-history" or
     1068                           when "b-hist" then
     1069                               do:
     1070                                   hh:load-image("cmp/b-hist.bmp":u) .
     1071                                   hh:TOOLTIP = "История" .
     1072                                   v-h[ii] = hh:handle .
     1073                                   ii = ii + 1 .
     1074                                   hh:width-chars = 3 .
     1075                               end.
     1076                           when "b-sch" then
     1077                               do:
     1078                                   hh:load-image("cmp/b-sch.bmp":u) .
     1079                                   hh:TOOLTIP = "Установка Фильтра" .
     1080                                   v-h[ii] = hh:handle .
     1081                                   ii = ii + 1 .
     1082                                   hh:width-chars = 3 .
     1083                               end.
     1084                           when "b-hist-user" then
     1085                               do:
     1086                                   hh:load-image("cmp/b-hist.bmp":u) .
     1087                                   hh:TOOLTIP = "История пользователя" .
     1088                                   ii = ii + 1 .
     1089                               end.
     1090                       end case.
     1091                   end.
     1092                   hh = hh:next-sibling.
     1093               end.
     1094               b-help:column = v-frame-width - b-help:width-chars.
     1095               jj = 0.
     1096               repeat ii = 4 to 1 by -1 :
     1097                   if valid-handle (v-h[ii] ) then
     1098                   do:
     1099                       jj  = jj + 1 .
     1100                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1101                       v-h[ii]:row    = v-help-old-y .
     1102                   end.
     1103               end.
     1104           end.
     1105       end.
     1106   end procedure.
     1107   MAIN-BLOCK:
     1108   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1109      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1110     RUN Myenable in this-procedure .
     1111     WAIT-FOR GO OF FRAME Dialog-Frame.
     1112   END.
     1113   RUN disable_UI.
     1114   PROCEDURE disable_UI :
     1115     HIDE FRAME Dialog-Frame.
     1116   END PROCEDURE.
     1117   PROCEDURE enable_UI :
     1118     DISPLAY t-spool dtime dtime-par t-income checktime checktime-par t-rsrv-line
     1119             zfactor
     1120         WITH FRAME Dialog-Frame.
     1121     ENABLE B-exit b-quit B-Help t-spool dtime dtime-par t-income checktime
     1122            checktime-par t-rsrv-line zfactor
     1123         WITH FRAME Dialog-Frame.
     1124     VIEW FRAME Dialog-Frame.
     1125   END PROCEDURE.
     1126   PROCEDURE fill-widgets :
     1127   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     1128   DEFINE VARIABLE v-exists-spool AS INTEGER NO-UNDO.
     1129   DEFINE VARIABLE v-exists-income AS INTEGER NO-UNDO.
     1130   DEFINE VARIABLE v-exists-rsrv-line AS INTEGER NO-UNDO.
     1131   define variable v-entry as character no-undo .
     1132   DO ii = 1 TO NUM-ENTRIES('26,27,28,29,30,31,32,33,16,17,42,43':U):
     1133       ASSIGN
     1134       v-exists-spool = v-EXISTS-spool + (IF LOOKUP(ENTRY(ii, '26,27,28,29,30,31,32,33,16,17,42,43':U ), p-obj-list) > 0
     1135                                         THEN 1
     1136                                         ELSE 0)
     1137       v-exists-income = v-EXISTS-income + (IF LOOKUP(ENTRY(ii, '48,49,50,51':U ), p-obj-list) > 0
     1138                                           THEN 1
     1139                                           ELSE 0)
     1140       v-exists-rsrv-line = v-EXISTS-rsrv-line + (IF LOOKUP(ENTRY(ii, '45,52':U ), p-obj-list) > 0
     1141                                                 THEN 1
     1142                                                 ELSE 0)
     1143       .
     1144   END.
     1145   ASSIGN
     1146   t-spool = (v-exists-spool = NUM-ENTRIES('26,27,28,29,30,31,32,33,16,17,42,43':U))
     1147   t-income = (v-exists-income = NUM-ENTRIES('48,49,50,51':U))
     1148   t-rsrv-line = (v-exists-rsrv-line = NUM-ENTRIES('45,52':U))
     1149   .
     1150   DO ii = 1 TO NUM-ENTRIES(p-params):
     1151       v-entry = ENTRY(ii, p-params).
     1152      IF v-entry BEGINS 'dtime':U THEN DO:
     1153          ASSIGN
     1154          dtime = YES
     1155          dtime-par = INTEGER(ENTRY(2, v-entry, '=':U))
     1156          .
     1157      END.
     1158      IF v-entry BEGINS 'checktime':U THEN DO:
     1159          ASSIGN
     1160          checktime = YES
     1161          checktime-par = INTEGER(ENTRY(2, v-entry, '=':U))
     1162          .
     1163      END.
     1164      IF v-entry BEGINS 'zfactor':U THEN DO:
     1165          ASSIGN
     1166          checktime = YES
     1167          .
     1168      END.
     1169   END.
     1170   END PROCEDURE.
     1171   PROCEDURE MyEnable :
     1172   DISPLAY
     1173   t-spool
     1174   dtime
     1175   dtime-par
     1176   checktime
     1177   checktime-par
     1178   zfactor
     1179   WITH FRAME Dialog-Frame.
     1180   ENABLE
     1181   B-exit
     1182   b-quit
     1183   B-Help
     1184   t-spool
     1185   dtime
     1186   dtime-par
     1187   zfactor
     1188   WITH FRAME Dialog-Frame.
     1189   VIEW FRAME Dialog-Frame.
     1190   END PROCEDURE.
     1191   PROCEDURE proc-non-spool :
     1192   define variable income-and-rsrv-line as logical no-undo .
     1193   income-and-rsrv-line = t-income and t-rsrv-line.
     1194     CASE income-and-rsrv-line:
     1195         WHEN yes THEN DO:
     1196           ENABLE
     1197           checktime
     1198           WITH FRAME Dialog-Frame.
     1199           APPLY "VALUE-changed" TO checktime.
     1200         END.
     1201         WHEN no THEN DO:
     1202             ASSIGN
     1203             checktime = NO.
     1204             disable
     1205             checktime
     1206             WITH FRAME Dialog-Frame.
     1207             APPLY "VALUE-changed" TO checktime.
     1208        END.
     1209     END CASE.
     1210   END PROCEDURE.
     1211   PROCEDURE proc-save :
     1212   ASSIGN
     1213   FRAME Dialog-Frame
     1214   t-spool
     1215   checktime
     1216   checktime-par WHEN checktime
     1217   dtime
     1218   dtime-par when dtime
     1219   zfactor
     1220   .
     1221   ASSIGN
     1222   p-obj-list = (IF t-spool
     1223                 then ('26,27,28,29,30,31,32,33,16,17,42,43':U + chr(44) + string(15))
     1224                 ELSE '')
     1225   p-obj-list = p-obj-list +
     1226               (IF t-income
     1227               then ((if p-obj-list = '':U then '':U else chr(44)) +
     1228                     '48,49,50,51':U + chr(44) + string(15)
     1229                     )
     1230               else '':U)
     1231   p-obj-list = p-obj-list +
     1232               (IF t-rsrv-line
     1233               then ( (if p-obj-list = '':U then '':U else chr(44)) +
     1234                      '45,52':U + chr(44) + string(15)
     1235                      )
     1236               else '':U)
     1237   p-params = (IF dtime
     1238             THEN ('dtime=' + string(dtime-par))
     1239              ELSE '':U) +
     1240             (IF checktime
     1241             THEN ('checktime=':U + string(checktime-par))
     1242             ELSE '':U) +
     1243             (IF zfactor THEN 'zfactor=1' ELSE '':U)
     1244   p-ok = yes.
     1245   END PROCEDURE.
