      975     ,output v-type
      976     ,output v-format
      977     ,output v-label
      978     ,output v-user-can-edit
      979     ,output v-output-display
      980     ,output v-other
      981     ) no-error .
      982   if error-status :error then do:
      983     undo, return error return-value .
      984   end.
      985   find first buf_fin-doc-attr no-lock where
      986             buf_fin-doc-attr.attr-code    = p-attr-code
      987         AND buf_fin-doc-attr.host-code     = p-host-code
      988         AND buf_fin-doc-attr.fin-doc-code = p-fin-doc-code      no-error .
      989     if available  buf_fin-doc-attr then do:
      990       assign
      991       p-attr-value = buf_fin-doc-attr.attr-value
      992       .
      993     end.
      994     else do:
      995       p-attr-value = ? .
      996     end.
      997    end.
      998   end procedure.
      999   procedure fd-attr-news :
     1000     do
     1001     on error undo, return error
     1002     :
     1003       define input  parameter p-code           as character no-undo .
