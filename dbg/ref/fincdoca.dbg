        1   DEFINE BUFFER X_c-fin-doc-attr FOR ub.c-fin-doc-attr.
        2   DEFINE BUFFER X_curr-sysconf FOR ub.clients.
        3   DEFINE BUFFER X_fin-doc-attr FOR ub.fin-doc-attr.
        4   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        5   define input parameter bttns  as char   no-undo .
        6   define input parameter p-mode  as char   no-undo .
        7   define input parameter p-host-code    like ub.fin-doc-attr.host-code no-undo.
        8   define input parameter p-fin-doc-code like ub.fin-doc-attr.fin-doc-code no-undo.
        9   define input parameter p-attr-code    like ub.fin-doc-attr.attr-code no-undo .
       10   define input-output param p-rid-list    as  char no-undo .
       11   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       12   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       13   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       14   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       15   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       16   define variable vss-description AS CHAR NO-UNDO INIT "Список истории атрибутов платежа":U.
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      124   define new shared variable RepPathName        as character no-undo .
      125   define new shared variable PrintRubl          as logical   no-undo .
      126   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   define variable v-waitfram-action01         as character   no-undo .
      128   define variable v-waitfram-action02         as character   no-undo .
      129   define variable v-waitfram-action03         as character   no-undo .
      130   define variable mWaitFramTextBeg            as character   no-undo.
      131   define variable mWaitFramTextEnd            as character   no-undo.
      132   define variable mWaitFramView               as logical     no-undo.
      133   define variable mWaitProcEvent              as logical     no-undo init yes.
      134   define variable mWaitFramInterval           as integer     no-undo init 1 .
      135   define variable mWaitFramStop               as logical     no-undo.
      136   define variable mWaitFramStopUser           as logical     no-undo.
      137   define variable mWaitFramStopTimeOut        as logical     no-undo.
      138   define variable mWaitFramStartProc          as datetime-tz no-undo.
      139   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      140   define button B-WaitFramStop auto-end-key
      141        label "Стоп"
      142        size 10 by 1 tooltip "Остоновить процесс".
      143   define button B-viewProcInfo
      144        label "Информация"
      145        size 15 by 1 tooltip "Информация о процесс".
      146   define frame waitfram
      147     v-waitfram-action01 format "x(72)" no-label skip
      148     v-waitfram-action02 format "x(72)" no-label skip
      149     v-waitfram-action03 format "x(72)" no-label skip
      150     B-viewProcInfo
      151     B-WaitFramStop at row 4 col 30
      152     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      153     .
      154   define new global shared variable mBatchMode as logical no-undo init ?.
      155   define variable mFramBachModHandle as handle no-undo.
      156   mFramBachModHandle = frame waitfram:handle.
      157   define variable mFameOldVis as logical no-undo.
      158   define variable mVisCUrentVin as logical no-undo.
      159   if session:batch-mode
      160   then
      161      mBatchMode = yes.
      162   if mBatchMode = ? then do:
      163     mVisCUrentVin = current-window:visible.
      164     mFameOldVis = mFramBachModHandle:visible.
      165     mFramBachModHandle:visible  = yes.
      166     mBatchMode = mFramBachModHandle:visible ne yes.
      167     mFramBachModHandle:visible = mFameOldVis.
      168     current-window:visible = mVisCUrentVin.
      169   end.
      170    if  log-manager:logfile-name ne ?
      171     then DO:
      172         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      173         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      174         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      175     end.
      176   on choose of B-WaitFramStop in frame waitfram
      177   do:
      178     mWaitFramStop = yes.
      179     mWaitFramStopUser = yes.
      180   end.
      181   function waitfram-check-timeout returns logical():
      182      define variable vtime as int64 no-undo.
      183      if mWaitFramStopTimeOut
      184      then
      185         return yes.
      186      vtime = ( now - mWaitFramStartProc ) / 1000 .
      187      if     mWaitFramTimeOut ne ?
      188         and mWaitFramTimeOut ne 0
      189         and mWaitFramTimeOut lt vtime
      190      then do:
      191         mWaitFramStopTimeOut = yes.
      192      end.
      193      return mWaitFramStopTimeOut.
      194   end.
      195   procedure waitfram-hide :
      196     if not session:batch-mode
      197     then do
      198     on error undo, return error return-value
      199     :
      200       pause 0 before-hide .
      201       if not mBatchMode then
      202         hide frame waitfram .
      203     if     not mWaitFramView
      204        and mWaitProcEvent
      205     then
      206       process events .
      207     end.
      208   end procedure.
      209   procedure waitfram-show :
      210     define input  parameter p-message as character no-undo .
      211     define variable v-left-margin as integer   no-undo .
      212     if not session:batch-mode
      213     then do
      214     on error undo, return error return-value
      215     :
      216       if length(p-message) <= 70 then do:
      217         assign
      218           v-left-margin = integer((70 - length(p-message)) / 2)
      219         .
      220         assign
      221           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      222         .
      223         assign
      224           v-waitfram-action01 = " "
      225           v-waitfram-action02 = " "
      226                                    + fill(" ", v-left-margin)
      227                                    + p-message
      228           v-waitfram-action03 = " "
      229         .
      230       end.
      231       else do:
      232         define variable vRindex1 as integer no-undo.
      233         define variable vRindex2 as integer no-undo.
      234         vRindex1 = r-index(p-message," ",70).
      235         if vRindex1 = 0
      236         then
      237            vRindex1 = 70.
      238         if length(p-message)  <= vRindex1 + 70 then do:
      239           assign
      240             v-waitfram-action01 = " "
      241             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      242             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      243           .
      244         end.
      245         else do:
      246           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      247           if vRindex2 <= vRindex1
      248           then
      249              vRindex2 = vRindex1 + 70.
      250           assign
      251             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      252             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      253             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      254           .
      255         end.
      256       end.
      257       B-viewProcInfo:visible   in frame waitfram = no.
      258       B-viewProcInfo:sensitive in frame waitfram = no.
      259       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      260       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      261       if  (   mWaitFramView
      262          or  mWaitProcEvent)
      263          and not mBatchMode
      264       then
      265          display
      266             v-waitfram-action01 skip
      267             v-waitfram-action02 skip
      268             v-waitfram-action03 skip
      269          with frame waitfram .
      270       if     mWaitFramView
      271          then do:
      272             if     mWaitFramInterval ne ?
      273                and not mBatchMode
      274             then
      275                wait-for go of frame waitfram pause mWaitFramInterval.
      276          end.
      277          else
      278             if     mWaitProcEvent
      279                and not mBatchMode
      280             then
      281                process events .
      282     end.
      283   end procedure.
      284      procedure waitfram-show-this:
      285         define input  parameter iInterval as int64 no-undo.
      286         define variable vtime as int64 no-undo.
      287         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      288         mWaitFramInterval = iInterval.
      289         run waitfram-show (substitute("&1&2 &3&4" ,
      290                                       mWaitFramTextBeg ,
      291                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      292                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      293                                       mWaitFramTextEnd
      294                                      )
      295                           ).
      296      end.
      297      procedure WaitFramRunPause:
      298         define input  parameter iInterval as dec no-undo.
      299         define variable vStart  as datetime-tz no-undo.
      300         define variable vend    as datetime-tz no-undo.
      301         define variable vint as int64 no-undo.
      302         define variable vOk as logical no-undo.
      303         vStart = now.
      304         vend   = vStart.
      305         publish "WaitFramPause" (iInterval,output vOk).
      306         vend   =  now.
      307         vint = vend - vStart.
      308         vint = iInterval - vint / 1000.
      309         if     not mWaitFramStop
      310            and (   vint > 0
      311                 or (    not vOk
      312                     and iInterval eq ?
      313                     )
      314                 )
      315         then
      316            run waitfram-show-this (iInterval).
      317         vend   =  now.
      318         vint = vend - vStart.
      319         vint = iInterval - vint / 1000.
      320         if     not mWaitFramStop
      321            and vint > 0
      322         then do:
      323            run gbl/pause.p (vint * 1000).
      324         end.
      325         if iInterval ne ?
      326         then
      327            publish "WaitFramStop".
      328         waitfram-check-timeout().
      329      end.
      330      procedure WaitFramWaitFor:
      331         define input  parameter iInterval as dec no-undo.
      332         assign
      333            mWaitFramStartProc   = now
      334            mWaitFramStopUser    = no
      335            mWaitFramStopTimeOut = no
      336         .
      337         block-wait:
      338         do while not mWaitFramStop:
      339            run WaitFramRunPause (iInterval).
      340            if  waitfram-check-timeout()
      341            then do:
      342               leave block-wait.
      343            end.
      344         end.
      345         run waitfram-hide.
      346      end.
      347   procedure waitfram-join :
      348     define input  parameter p-line-1  as character no-undo .
      349     define input  parameter p-line-2  as character no-undo .
      350     define input  parameter p-line-3  as character no-undo .
      351     define output parameter p-message as character no-undo .
      352     do
      353     on error undo, return error return-value
      354     :
      355       assign
      356         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      357                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      358                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      359       .
      360     end.
      361   end procedure.
      362   function waitfram-join-function returns character
      363     (input p-line-1 as character
      364     ,input p-line-2 as character
      365     ,input p-line-3 as character
      366     ).
      367     define variable v-message as character no-undo .
      368     run waitfram-join in this-procedure
      369       (input  p-line-1
      370       ,input  p-line-2
      371       ,input  p-line-3
      372       ,output v-message
      373       ) .
      374     return v-message .
      375   end function .
      376   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   define  stream PrnLibStream.
      378   procedure prn-lib-prn-file :
      379     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      380     define input parameter p-DIsabledoptions as integer no-undo .
      381     define variable v-report-name as character no-undo .
      382     define variable v-user-action as character no-undo .
      383     define variable v-printed     as logical   no-undo .
      384     define variable v-exist       as logical   no-undo .
      385     do
      386       on error undo, return error
      387       :
      388       run prn-lib-get-report-name  in this-procedure (
      389         input parParentProc
      390         ,output v-report-name
      391         ).
      392   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      393   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      394     (input  v-report-name
      395     ,input  2
      396     ,output v-exist
      397     )  .
      398       if NOT v-exist then
      399       DO:
      400         Message
      401           "Нет заданий на печать ! "
      402           view-as alert-box .
      403         Return  .
      404       End.
      405       run gbl/prnfilen.w
      406         (input  ""
      407         ,input  p-DisabledOptions
      408         ,input  string(v-report-name )
      409         ,input  7
      410         ,output v-user-action
      411         ,output v-printed
      412         ) .
      413       if v-printed then
      414       do:
      415         return "YES" .
      416       end.
      417       else
      418       do:
      419         return "NO" .
      420       end.
      421     end.
      422   end procedure.
      423   procedure prn-lib-open-stream :
      424     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      425     define input parameter p-page-size    as integer no-undo .
      426     define input parameter p-is-stream    as logical no-undo .
      427     define input parameter p-append       as logical no-undo .
      428     define variable v-report-name as character no-undo .
      429     do
      430       on error undo, return error
      431       :
      432       run prn-lib-get-report-name  in this-procedure (
      433         input parParentProc
      434         ,output v-report-name
      435         ).
      436       if p-is-stream then
      437       do:
      438         if p-append then
      439         do:
      440           output stream PrnLibStream to value( v-report-name )
      441             page-size value(p-page-size) append .
      442         end.
      443         if not p-append then
      444         do:
      445           output stream PrnLibStream to value( v-report-name )
      446             page-size value(p-page-size) .
      447         end.
      448       end.
      449       if not p-is-stream then
      450       do:
      451         if p-append then
      452         do:
      453           output to value( v-report-name )
      454             page-size value(p-page-size) append .
      455         end.
      456         if not p-append then
      457         do:
      458           output to value( v-report-name )
      459             page-size value(p-page-size) .
      460         end.
      461       end.
      462     end.
      463   end procedure.
      464   procedure prn-lib-open-exp :
      465     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      466     define input parameter p-is-stream    as logical no-undo .
      467     define input parameter p-is-append    as logical no-undo .
      468     define output parameter p-ReportFileName as char init "report" no-undo.
      469     define output parameter p-process as logical no-undo .
      470     define variable glog as logical no-undo .
      471     do
      472       on error undo, return error
      473       :
      474       SYSTEM-DIALOG GET-FILE p-ReportFileName
      475         TITLE      "Укажите путь"
      476         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      477         ASK-OVERWRITE
      478         CREATE-TEST-FILE
      479         SAVE-AS
      480         USE-FILENAME
      481         DEFAULT-EXTENSION "txt"
      482         UPDATE glog
      483         .
      484       if not glog then  return.
      485       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      486       if p-is-stream then
      487       do:
      488         if p-is-append then
      489         do:
      490           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      491         end.
      492         else
      493         do:
      494           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      495         end.
      496       end.
      497       else
      498       do:
      499         if p-is-append then
      500         do:
      501           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      502         end.
      503         else
      504         do:
      505           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      506         end.
      507       end.
      508       p-process = yes.
      509     end.
      510   end procedure.
      511   procedure prn-lib-get-report-name :
      512     define input parameter parParentProc  as widget-handle no-undo.
      513     define output parameter p-report-name as character no-undo .
      514     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      515   end procedure.
      516   procedure prn-lib-reportviewer-report-name :
      517     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      518     define input parameter p-report-name-html as character no-undo .
      519     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      520   end procedure.
      521   procedure prn-lib-reportviewer :
      522     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      523     define input parameter p-report-name-html as character no-undo .
      524     define input parameter p-param        as character no-undo .
      525     define variable v-excel           as character no-undo init 'TRUE' .
      526     define variable v-value-character as character no-undo .
      527     define variable v-value-integer   as character no-undo .
      528     define variable v-value-date      as date      no-undo .
      529     define variable v-value-decimal   as decimal   no-undo .
      530     define variable rep-excel         as logical   no-undo .
      531     define variable excel-string      as character no-undo .
      532     define variable v-param-type      as character no-undo .
      533     define variable v-tth             as handle    no-undo .
      534     run adm/shattri.p (
      535       input "get":U
      536       ,input  ""
      537       ,input  0
      538       ,input  'report-glob':U
      539       ,input  'rep-excel':U
      540       ,output v-value-character
      541       ,output v-value-date
      542       ,output v-value-decimal
      543       ,output v-value-integer
      544       ,output rep-excel
      545       ,output v-param-type
      546       ,INPUT-OUTPUT table-handle v-tth
      547       )  .
      548     if rep-excel then v-excel = "TRUE" .
      549     else v-excel = "FALSE" .
      550     if p-param eq ""
      551     then
      552        p-param = "EXCEL:" + v-excel.
      553     else
      554        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      555     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      556   end procedure.
      557   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      558   procedure cur-time :
      559      define output parameter p-today as date      no-undo .
      560      define output parameter p-time  as integer   no-undo .
      561     do
      562     on error undo, return error
      563     :
      564       define variable v-date1 as date      no-undo .
      565       define variable v-date2 as date      no-undo .
      566       define variable v-time  as integer   no-undo .
      567       assign
      568         v-date1 = today
      569         v-time  = time
      570         v-date2 = today
      571       .
      572       if v-date1 <> v-date2
      573       then do:
      574         assign
      575           v-date1 = today
      576           v-time  = v-time
      577         .
      578       end.
      579       assign
      580         p-today = v-date1
      581         p-time  = v-time
      582       .
      583     end.
      584   end.
      585   function cur-time-date returns character
      586   :
      587     return string(today, '99/99/9999':U) .
      588   end.
      589   function cur-time-mjd returns decimal
      590   :
      591     define variable v-date as date      no-undo .
      592     define variable v-time as integer   no-undo .
      593     run cur-time in this-procedure
      594       (output v-date
      595       ,output v-time
      596       ) .
      597     return integer(v-date) - 2400002 + (v-time / 86400) .
      598   end.
      599   function cur-time-get-ending-index returns integer
      600   (input p-number as integer
      601   )
      602   :
      603     if p-number < 0
      604     or p-number = ?
      605     then do:
      606       return 1 .
      607     end.
      608     define variable v-rest as integer   no-undo .
      609     assign
      610       p-number = p-number modulo 100
      611     .
      612     if p-number < 20
      613     then do:
      614       assign
      615         v-rest = p-number
      616       .
      617     end.
      618     else do:
      619       assign
      620         v-rest = p-number modulo 10
      621       .
      622     end.
      623     case v-rest :
      624       when 1
      625       then do:
      626         return 2 .
      627       end.
      628       when 2 or
      629       when 3 or
      630       when 4
      631       then do:
      632         return 3 .
      633       end.
      634       otherwise do:
      635         return 1 .
      636       end.
      637     end case .
      638   end.
      639   procedure cur-time-mjd-to-date :
      640      define input  parameter i-mjd-diff as decimal no-undo.
      641      define output parameter o-Date     as date    no-undo.
      642      define output parameter o-Time     as integer no-undo.
      643      define variable v-day-number as integer   no-undo .
      644      if    i-mjd-diff < 0
      645         or i-mjd-diff = ?
      646      then do:
      647         return "?" .
      648      end.
      649      assign
      650         v-day-number = truncate(i-mjd-diff,0).
      651         o-Date = date(v-day-number + 2400002).
      652         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      653     .
      654   end.
      655   function cur-time-mjd-to-string returns character
      656   (input p-mjd-diff as decimal
      657   )
      658   :
      659     define variable v-day-number as integer   no-undo .
      660     define variable v-seconds    as integer   no-undo .
      661     define variable v-hour       as integer   no-undo .
      662     define variable v-min        as integer   no-undo .
      663     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      664     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      665     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      666     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      667     if p-mjd-diff < 0
      668     or p-mjd-diff = ?
      669     then do:
      670       return "?" .
      671     end.
      672     assign
      673       v-day-number = integer(truncate(p-mjd-diff,0))
      674       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      675     .
      676     if v-seconds > 86400
      677     then do:
      678       assign
      679         v-seconds = 86400 - 1
      680       .
      681     end.
      682     if v-seconds < 0
      683     then do:
      684       assign
      685         v-seconds = 0
      686       .
      687     end.
      688     assign
      689       v-hour = truncate(v-seconds / 3600, 0)
      690     .
      691     assign
      692       v-seconds = v-seconds modulo 3600
      693     .
      694     assign
      695       v-min = truncate(v-seconds / 60, 0)
      696     .
      697     assign
      698       v-seconds = v-seconds modulo 60
      699     .
      700     return
      701         (if v-day-number <> 0
      702           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      703           else ""
      704         )
      705       + (if v-day-number <> 0 or v-hour <> 0
      706           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      707           else ""
      708         )
      709       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      710           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      711           else ""
      712         )
      713       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      714       .
      715   end.
      716   function cur-time-string returns character
      717   :
      718     define variable v-date as date      no-undo .
      719     define variable v-time as integer   no-undo .
      720     run cur-time in this-procedure
      721       (output v-date
      722       ,output v-time
      723       ) .
      724     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      725   end.
      726   function cur-time-string-sec returns character
      727   :
      728     define variable v-date as date      no-undo .
      729     define variable v-time as integer   no-undo .
      730     run cur-time in this-procedure
      731       (output v-date
      732       ,output v-time
      733       ) .
      734     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      735   end.
      736   function cur-time-custom  returns character
      737   (input p-prefix as character
      738   ,input p-date-format as character
      739   ,input p-delimiter as character
      740   ,input p-time-format as character
      741   ,input p-suffix as character
      742   )
      743   :
      744     define variable v-date as date      no-undo .
      745     define variable v-time as integer   no-undo .
      746     run cur-time in this-procedure
      747       (output v-date
      748       ,output v-time
      749       ) .
      750     return
      751       p-prefix
      752       + string(v-date, p-date-format)
      753       + p-delimiter
      754       + string(v-time, p-time-format)
      755       + p-suffix
      756       .
      757   end.
      758   function cur-time-print  returns character
      759   :
      760     define variable v-date as date      no-undo .
      761     define variable v-time as integer   no-undo .
      762     run cur-time in this-procedure
      763       (output v-date
      764       ,output v-time
      765       ) .
      766     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      767   end.
      768   function cur-time-datetime returns datetime
      769   :
      770     define variable v-char as character no-undo .
      771     define variable v-datetime as datetime no-undo .
      772     v-char = cur-time-string().
      773     v-datetime = datetime(v-char).
      774     return  v-datetime.
      775   end.
      776   function cur-time-string-msec returns character
      777   :
      778     define variable v-date as datetime  no-undo .
      779     v-date = now.
      780     return string(v-date) .
      781   end.
      782   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      783   procedure fd-attr-code :
      784     do
      785     on error undo, return error
      786     :
      787       define input  parameter p-code           as character no-undo .
      788       define output parameter p-type           as character no-undo .
      789       define output parameter p-format         as character no-undo .
      790       define output parameter p-label          as character no-undo .
      791       define output parameter p-user-can-edit  as logical   no-undo .
      792       define output parameter p-output-display as logical   no-undo .
      793       define output parameter p-other          as character no-undo .
      794       case p-code :
      795               when 'shift-date':U then do:     assign     p-label = "Дата смены"     p-type = 'T':U      p-format = "99/99/9999"     p-label = "Дата смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      796               when 'shift-num':U then do:     assign     p-label = "П.смены"     p-type = 'I':U      p-format = "99"     p-label = "П.смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      797               when 'shift-name':U then do:     assign     p-label = "№ смены"     p-type = 'C':U      p-format = "X(2)"     p-label = "№ смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      798               when 'barcode':U then do:     assign     p-label = "Штрих-код"     p-type = 'C':U      p-format = "X(20)"     p-label = "Штрих-код"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      799               when 'lockid':U then do:     assign     p-label = "ID блокировки чека"     p-type = 'C':U      p-format = "X(2)"     p-label = "ID блокировки чека"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      800               when 'cover_sheet':U then do:     assign     p-label = "Разбиение по номиналам"     p-type = 'C':U      p-format = "X(4000)"     p-label = "Разбиение по номиналам"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      801               when 'pre-vedom':U then do:     assign     p-label = "Атрибут для препроводительной ведомости"     p-type = 'C':U      p-format = "X(256)"     p-label = "Атрибут для препроводительной ведомости"     p-user-can-edit  = false     p-output-display = false     p-other = '':u      .   end.
      802               when 'contr-kb':U then do:     assign     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-type = 'I':U      p-format = ">>>9"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      803         otherwise do:
      804           undo, return error "неизвестный атрибут платежа" + " " + p-code .
      805         end.
      806       end.
      807     end.
      808   end procedure.
      809   procedure fd-attr-tooltip :
      810     do
      811     on error undo, return error
      812     :
      813       define input  parameter p-code    as character no-undo .
      814       define output parameter p-tooltip as character no-undo .
      815       define output parameter p-label   as character no-undo .
      816       case p-code :
      817               when 'shift-date':U then do:     assign     p-tooltip = "Дата смены"     p-label = "Дата смены" .   end.
      818               when 'shift-num':U then do:     assign     p-tooltip = "П.смены"     p-label = "П.смены" .   end.
      819               when 'shift-name':U then do:     assign     p-tooltip = "№ смены"     p-label = "№ смены" .   end.
      820               when 'barcode':U then do:     assign     p-tooltip = "Штрих-код"     p-label = "Штрих-код" .   end.
      821               when 'lockid':U then do:     assign     p-tooltip = "ID блокировки чека"     p-label = "ID блокировки чека" .   end.
      822               when 'cover_sheet':U then do:     assign     p-tooltip = "Разбиение по номиналам"     p-label = "Разбиение по номиналам" .   end.
      823               when 'pre-vedom':U then do:     assign     p-tooltip = "Атрибут для препроводительной ведомости"     p-label = "Атрибут для препроводительной ведомости" .   end.
      824               when 'contr-kb':U then do:     assign     p-tooltip = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами" .   end.
      825         otherwise do:
      826           undo, return error "неизвестный атрибут платежа" + " " + p-code .
      827         end.
      828       end.
      829     end.
      830   end procedure.
      831   procedure fin-doc-attr-write :
      832    do
      833    on error undo, return error return-value
      834    :
      835   define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      836   define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      837   define input parameter p-attr-code     like ub.fin-doc-attr.attr-code  no-undo .
      838   define input parameter p-attr-value    like ub.fin-doc-attr.attr-value no-undo .
      839   define variable  v-format         as character no-undo .
      840   define variable  v-label          as character no-undo .
      841   define variable  v-user-can-edit  as logical   no-undo .
      842   define variable  v-output-display as logical   no-undo .
      843   define variable  v-other          as character no-undo .
      844   define variable  v-type           as character no-undo .
      845   define buffer buf_fin-doc-attr for ub.fin-doc-attr.
      846   run fd-attr-code in this-procedure
      847                                     (input  p-attr-code
      848                                     ,output v-type
      849                                     ,output v-format
      850                                     ,output v-label
      851                                     ,output v-user-can-edit
      852                                     ,output v-output-display
      853                                     ,output v-other
      854                                     ) no-error .
      855   if error-status :error then do:
      856     undo, return error return-value .
      857   end.
      858   find first buf_fin-doc-attr  exclusive-lock  where
      859             buf_fin-doc-attr.attr-code    = p-attr-code
      860         AND buf_fin-doc-attr.host-code    = p-host-code
      861         AND buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code  no-error .
      862     if not available  buf_fin-doc-attr then do:
      863         create buf_fin-doc-attr.
      864         assign
      865         buf_fin-doc-attr.attr-code    = p-attr-code
      866         buf_fin-doc-attr.attr-value   = p-attr-value
      867         buf_fin-doc-attr.host-code    = p-host-code
      868         buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code
      869         .
      870     end.
      871     else do:
      872          assign
      873          buf_fin-doc-attr.attr-value = p-attr-value.
      874     end.
      875    end.
      876   end procedure.
      877   procedure fd-attr-exist :
      878     do
      879     on error undo, return error
      880     :
      881       define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      882       define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      883       define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
      884       define output parameter p-exist   as logical  no-undo .
      885       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
      886       define variable  v-type           as character no-undo .
      887       define variable  v-format         as character no-undo .
      888       define variable  v-label          as character no-undo .
      889       define variable  v-user-can-edit  as logical   no-undo .
      890       define variable  v-output-display as logical   no-undo .
      891       define variable  v-other          as character no-undo .
      892       run fd-attr-code in this-procedure
      893         (input  p-code
      894         ,output v-type
      895         ,output v-format
      896         ,output v-label
      897         ,output v-user-can-edit
      898         ,output v-output-display
      899         ,output v-other
      900         ) no-error .
      901       if error-status :error then do:
      902         undo, return error return-value .
      903       end.
      904       find first buf_fin-doc-attr exclusive-lock
      905         where buf_fin-doc-attr.host-code  = p-host-code
      906           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
      907           and buf_fin-doc-attr.attr-code = p-code
      908         no-error .
      909       if  available buf_fin-doc-attr then do:
      910         p-exist = yes.
      911       end.
      912     end.
      913   end procedure.
      914   procedure fd-attr-delete :
      915     do
      916     on error undo, return error
      917     :
      918     define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      919     define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      920     define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
      921     define output parameter p-deleted  as logical no-undo.
      922       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
      923       define variable  v-type           as character no-undo .
      924       define variable  v-format         as character no-undo .
      925       define variable  v-label          as character no-undo .
      926       define variable  v-user-can-edit  as logical   no-undo .
      927       define variable  v-output-display as logical   no-undo .
      928       define variable  v-other          as character no-undo .
      929       run fd-attr-code in this-procedure
      930         (input  p-code
      931         ,output v-type
      932         ,output v-format
      933         ,output v-label
      934         ,output v-user-can-edit
      935         ,output v-output-display
      936         ,output v-other
      937         ) no-error .
      938       if error-status :error then do:
      939         undo, return error return-value .
      940       end.
      941       find first buf_fin-doc-attr exclusive-lock
      942         where buf_fin-doc-attr.host-code  = p-host-code
      943           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
      944           and buf_fin-doc-attr.attr-code = p-code
      945         no-error NO-WAIT.
      946       if not available buf_fin-doc-attr then do:
      947         p-deleted = no.
      948       end.
      949       else do:
      950         delete buf_fin-doc-attr no-error .
      951         if error-status:error then do:
      952           undo, return error return-value .
      953         end.
      954         p-deleted = yes.
      955       end.
      956     end.
      957   end procedure.
      958   procedure fin-doc-attr-value :
      959    do
      960    on error undo, return error return-value
      961    :
      962   define input  parameter p-host-code    like ub.fin-doc-attr.host-code    no-undo .
      963   define input  parameter p-fin-doc-code like ub.fin-doc-attr.fin-doc-code     no-undo .
