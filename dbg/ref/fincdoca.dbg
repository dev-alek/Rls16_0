     1018   end procedure.
     1019   procedure c-fin-doc-attr-write :
     1020    do
     1021    on error undo, return error return-value
     1022    :
     1023   define input parameter p-host-code     like ub.c-fin-doc-attr.host-code  no-undo .
     1024   define input parameter p-fin-doc-code  like ub.c-fin-doc-attr.fin-doc-code   no-undo .
     1025   define input parameter p-corr-user-db-num  like ub.c-fin-doc-attr.corr-user-db-num   no-undo .
     1026   define input parameter p-chip-num      like ub.c-fin-doc-attr.chip-num   no-undo .
     1027   define input parameter p-attr-code     like ub.c-fin-doc-attr.attr-code  no-undo .
     1028   define input parameter p-attr-value    like ub.c-fin-doc-attr.attr-value no-undo .
     1029   define variable  v-format         as character no-undo .
     1030   define variable  v-label          as character no-undo .
     1031   define variable  v-user-can-edit  as logical   no-undo .
     1032   define variable  v-output-display as logical   no-undo .
     1033   define variable  v-other          as character no-undo .
     1034   define variable  v-type           as character no-undo .
     1035   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
     1036   run fd-attr-code in this-procedure
     1037                                     (input  p-attr-code
     1038                                     ,output v-type
     1039                                     ,output v-format
     1040                                     ,output v-label
     1041                                     ,output v-user-can-edit
     1042                                     ,output v-output-display
     1043                                     ,output v-other
     1044                                     ) no-error .
     1045   if error-status :error then do:
     1046     undo, return error return-value .
     1047   end.
     1048   find first buf_c-fin-doc-attr  exclusive-lock  where
     1049             buf_c-fin-doc-attr.attr-code    = p-attr-code
     1050         AND buf_c-fin-doc-attr.host-code    = p-host-code
     1051         AND buf_c-fin-doc-attr.fin-doc-code     = p-fin-doc-code
     1052         AND buf_c-fin-doc-attr.corr-user-db-num = p-corr-user-db-num
     1053         AND buf_c-fin-doc-attr.chip-num         = p-chip-num      no-error .
     1054     if not available  buf_c-fin-doc-attr then do:
     1055         create buf_c-fin-doc-attr.
     1056         assign
     1057         buf_c-fin-doc-attr.attr-code    = p-attr-code
     1058         buf_c-fin-doc-attr.attr-value   = p-attr-value
     1059         buf_c-fin-doc-attr.host-code    = p-host-code
     1060         buf_c-fin-doc-attr.fin-doc-code     = p-fin-doc-code
     1061         .
     1062     end.
     1063     else do:
     1064           buf_c-fin-doc-attr.attr-value   = p-attr-value .
     1065     end.
     1066    end.
     1067   end procedure.
     1068   procedure c-fin-doc-attr-value :
     1069    do
     1070    on error undo, return error return-value
     1071    :
     1072   define input  parameter p-host-code    like ub.c-fin-doc-attr.host-code    no-undo .
     1073   define input  parameter p-fin-doc-code like ub.c-fin-doc-attr.fin-doc-code     no-undo .
     1074   define input parameter p-corr-user-db-num  like ub.c-fin-doc-attr.corr-user-db-num   no-undo .
     1075   define input parameter p-chip-num      like ub.c-fin-doc-attr.chip-num   no-undo .
     1076   define input  parameter p-attr-code    like ub.c-fin-doc-attr.attr-code    no-undo .
     1077   define output parameter p-attr-value   like ub.c-fin-doc-attr.attr-value   no-undo .
     1078   define variable  v-format         as character no-undo .
     1079   define variable  v-label          as character no-undo .
     1080   define variable  v-user-can-edit  as logical   no-undo .
     1081   define variable  v-output-display as logical   no-undo .
     1082   define variable  v-other          as character no-undo .
     1083   define variable  v-type           as character no-undo .
     1084   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
     1085   run fd-attr-code in this-procedure
     1086     (input  p-attr-code
     1087     ,output v-type
     1088     ,output v-format
     1089     ,output v-label
     1090     ,output v-user-can-edit
     1091     ,output v-output-display
     1092     ,output v-other
     1093     ) no-error .
     1094   if error-status :error then do:
     1095     undo, return error return-value .
     1096   end.
     1097   find first buf_c-fin-doc-attr no-lock where
     1098             buf_c-fin-doc-attr.attr-code    = p-attr-code
     1099         AND buf_c-fin-doc-attr.fin-doc-code      = p-fin-doc-code
     1100         AND buf_c-fin-doc-attr.host-code      = p-host-code
     1101         AND buf_c-fin-doc-attr.corr-user-db-num = p-corr-user-db-num
     1102         AND buf_c-fin-doc-attr.chip-num         = p-chip-num      no-error .
     1103     if available  buf_c-fin-doc-attr then do:
     1104       assign
     1105       p-attr-value = buf_c-fin-doc-attr.attr-value
     1106       .
     1107     end.
     1108     else do:
     1109       p-attr-value = ? .
     1110     end.
     1111    end.
     1112   end procedure.
     1113   procedure c-fin-doc-attr-value-nextchip :
     1114    do
     1115    on error undo, return error return-value
     1116    :
     1117   define input  parameter p-host-code    like ub.c-fin-doc-attr.host-code    no-undo .
     1118   define input  parameter p-fin-doc-code like ub.c-fin-doc-attr.fin-doc-code     no-undo .
     1119   define input parameter p-corr-user-db-num  like ub.c-fin-doc-attr.corr-user-db-num   no-undo .
     1120   define input parameter p-chip-num      like ub.c-fin-doc-attr.chip-num   no-undo .
     1121   define input  parameter p-attr-code    like ub.c-fin-doc-attr.attr-code    no-undo .
     1122   define output parameter p-attr-value   like ub.c-fin-doc-attr.attr-value   no-undo .
     1123   define variable  v-format         as character no-undo .
     1124   define variable  v-label          as character no-undo .
     1125   define variable  v-user-can-edit  as logical   no-undo .
     1126   define variable  v-output-display as logical   no-undo .
     1127   define variable  v-other          as character no-undo .
     1128   define variable  v-type           as character no-undo .
     1129   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
     1130   run fd-attr-code in this-procedure
     1131     (input  p-attr-code
     1132     ,output v-type
     1133     ,output v-format
     1134     ,output v-label
     1135     ,output v-user-can-edit
     1136     ,output v-output-display
     1137     ,output v-other
     1138     ) no-error .
     1139   if error-status :error then do:
     1140     undo, return error return-value .
     1141   end.
     1142   find first buf_c-fin-doc-attr no-lock where
     1143             buf_c-fin-doc-attr.attr-code    = p-attr-code
     1144         and buf_c-fin-doc-attr.fin-doc-code      = p-fin-doc-code
     1145         and buf_c-fin-doc-attr.host-code      = p-host-code
     1146         and buf_c-fin-doc-attr.corr-user-db-num = p-corr-user-db-num
     1147         and buf_c-fin-doc-attr.chip-num         > p-chip-num      no-error .
     1148     if available  buf_c-fin-doc-attr then do:
     1149       assign
     1150       p-attr-value = buf_c-fin-doc-attr.attr-value
     1151       .
     1152     end.
     1153     else do:
     1154       p-attr-value = ? .
     1155     end.
     1156    end.
     1157   end procedure.
     1158   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1159   FUNCTION mark-string RETURNS CHARACTER
     1160     ( input p-recid as recid, input mark-list as character  ) :
     1161     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1162   END FUNCTION.
     1163   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1164   function usrfulnf returns character ( input p-user-id as character):
     1165   define variable v-user-name as character no-undo .
     1166   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1167   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     1168     (input  p-user-id
     1169     ,output v-user-name
     1170     ) no-error .
     1171   if error-status:error
     1172   or v-user-name = ""
     1173   then do:
     1174     return p-user-id.
     1175   end.
     1176   else do:
     1177     return v-user-name.
     1178   end.
     1179   end function.
     1180   define variable v-rid-list as character no-undo .
     1181   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
     1182   define variable sort-column-name as character no-undo .
     1183   define variable v-db-num LIKE ub.db.db-num no-undo.
     1184   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1185   define  temp-table temp-changes no-undo
     1186   field f_name as character
     1187   field l_name as character
     1188   field v_old as character
     1189   field v_new as character
     1190   field t_name as character
     1191   field num_ as integer
     1192   field uniq-key-rec as character
     1193   field action as integer
     1194   field fNotChange as logical
     1195   index pi is unique primary
     1196   num_
     1197   t_name
     1198   f_name
     1199   index
     1200   Chan
     1201   fnotChange
     1202   t_name
     1203   f_name
     1204   index imain uniq-key-rec
     1205   .
     1206   FUNCTION get-all-fields returns character (p-file-name as character ):
     1207   define variable v-dop as character no-undo .
     1208     find first _file no-lock where _file._file-name = p-file-name no-error .
     1209     if not available _file then return "":U.
     1210     for each _field no-lock where
     1211              _field._file-recid = recid(_file) :
     1212       assign
     1213       v-dop = v-dop + _field._field-name + chr(44)
     1214       .
     1215     end.
     1216     return trim(v-dop).
     1217   END FUNCTION.
     1218   PROCEDURE proc-full-temp-changes :
     1219     define input  parameter p-hst-handle as handle    no-undo .
     1220     define input  parameter p-main-table as character no-undo .
     1221     define input  parameter p-field-list as character no-undo .
     1222     define input  parameter p-label-form as character no-undo .
     1223     define variable h-new-buf         as handle    no-undo .
     1224     define variable h-main-buf        as handle    no-undo .
     1225     define variable h-for-comp        as handle    no-undo .
     1226     define variable v-inform          as character no-undo .
     1227     define variable v-ind             as integer   no-undo .
     1228     define variable v-idx-field-qnty  as integer   no-undo .
     1229     define variable v-num-entries     as integer   no-undo .
     1230     define variable fh                as handle    no-undo .
     1231     define variable fh-main           as handle    no-undo .
     1232     define variable fh-old            as handle    no-undo .
     1233     define variable fh-new            as handle    no-undo .
     1234     define variable v-field-name      as character no-undo .
     1235     define variable v-field-lvl       as character no-undo .
     1236     define variable v-field-form      as character no-undo .
     1237     define variable v-search-exp      as character no-undo .
     1238     define variable v-srch-main       as character no-undo .
     1239     define variable v-word-link       as character no-undo .
     1240     define variable v-av-chip-num     as logical   no-undo .
     1241     define variable v-main-pi-fld-lst as character no-undo .
     1242     define variable v-main-fld-lst    as character no-undo .
     1243     define variable v-delim-list      as character no-undo .
     1244     define variable v-label           as character no-undo .
     1245     define variable v-old-value       as character no-undo case-sensitive.
     1246     define variable v-new-value       as character no-undo case-sensitive.
     1247     define variable v-chg-fields as character no-undo.
     1248     for each temp-changes:
     1249       delete temp-changes.
     1250     end.
     1251     if not p-hst-handle:available then do:
     1252       return .
     1253     end.
     1254     create buffer h-new-buf  for table p-hst-handle .
     1255     create buffer h-main-buf for table p-main-table .
     1256     assign
     1257       v-inform = h-main-buf:index-information(1)
     1258       v-ind    = 2
     1259     .
     1260     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1261     on error undo, return error
     1262     :
     1263       assign
     1264         v-inform = h-main-buf:index-information( v-ind )
     1265         v-ind    = v-ind + 1
     1266       .
     1267     end.
     1268     if v-inform = ?
     1269       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1270       or entry( 3, v-inform, ",":U ) <> "1":U
     1271     then do:
     1272       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1273     end.
     1274     assign
     1275       v-idx-field-qnty = num-entries( v-inform ) - 4
     1276     .
     1277     if v-idx-field-qnty < 2 then do:
     1278       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1279     end.
     1280     assign
     1281       v-srch-main   = "where":U
     1282       v-word-link   = "":U
     1283       v-av-chip-num = false
     1284       v-delim-list  = "":U
     1285     .
     1286     do v-ind = 1 to v-idx-field-qnty by 2
     1287     on error undo, return error
     1288     :
     1289       assign
     1290         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1291         fh                = p-hst-handle:buffer-field( v-field-name )
     1292         fh-main           = h-main-buf:buffer-field( v-field-name )
     1293         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1294         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1295       .
     1296       if fh:data-type ="character":U then do:
     1297         assign
     1298           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1299         .
     1300       end.
     1301       else do:
     1302         assign
     1303           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1304         .
     1305       end.
     1306       if v-delim-list = "":U then do:
     1307         assign
     1308           v-delim-list = ",":U
     1309         .
     1310       end.
     1311       if v-word-link = "":U then do:
     1312         assign
     1313           v-word-link = "and":U
     1314         .
     1315       end.
     1316     end.
     1317     assign
     1318       v-delim-list  = "":U
     1319     .
     1320     do v-ind = 1 to h-main-buf:num-fields
     1321     on error undo, return error
     1322     :
     1323       assign
     1324         fh-main      = h-main-buf:buffer-field( v-ind )
     1325         v-field-name = fh-main:name
     1326       .
     1327         assign
     1328           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1329         .
     1330         if v-delim-list = "":U then do:
     1331           assign
     1332             v-delim-list = ",":U
     1333           .
     1334         end.
     1335     end.
     1336     assign
     1337       v-inform = p-hst-handle:index-information(1)
     1338       v-ind    = 2
     1339     .
     1340     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1341     on error undo, return error
     1342     :
     1343       assign
     1344         v-inform = p-hst-handle:index-information( v-ind )
     1345         v-ind    = v-ind + 1
     1346       .
     1347     end.
     1348     if v-inform = ?
     1349       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1350       or entry( 3, v-inform, ",":U ) <> "1":U
     1351     then do:
     1352       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1353     end.
     1354     assign
     1355       v-idx-field-qnty = num-entries( v-inform ) - 4
     1356     .
     1357     if v-idx-field-qnty < 2 then do:
     1358       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1359     end.
     1360     assign
     1361       v-search-exp  = "where":U
     1362       v-word-link   = "":U
     1363       v-av-chip-num = false
     1364     .
     1365     do v-ind = 1 to v-idx-field-qnty by 2
     1366     on error undo, return error
     1367     :
     1368       assign
     1369         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1370         fh           = p-hst-handle:buffer-field( v-field-name )
     1371         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1372       .
     1373       if v-field-name = "chip-num":U then do:
     1374         assign
     1375           v-search-exp  = substitute( "&1 >", v-search-exp )
     1376           v-av-chip-num = true
     1377         .
     1378       end.
     1379       else do:
     1380         assign
     1381           v-search-exp = substitute( "&1 =", v-search-exp )
     1382         .
     1383       end.
     1384       if fh:data-type ="character":U then do:
     1385         assign
     1386           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1387         .
     1388       end.
     1389       else do:
     1390         assign
     1391           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1392         .
     1393       end.
     1394       if v-word-link = "":U then do:
     1395         assign
     1396           v-word-link = "and":U
     1397         .
     1398       end.
     1399     end.
     1400     if v-av-chip-num = false then do:
     1401       message
     1402         vss-workfile vss-revision vss-description skip
     1403         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1404         "Использование данной процедуры невозможно!" skip
     1405         view-as alert-box error .
     1406       return error .
     1407     end.
     1408     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1409     if not h-new-buf:available then do:
     1410       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1411       if not h-main-buf:available then do:
     1412         assign
     1413           h-for-comp = ?
     1414         .
     1415       end.
     1416       else do:
     1417         assign
     1418           h-for-comp = h-main-buf
     1419         .
     1420       end.
     1421     end.
     1422     else do:
     1423       assign
     1424         h-for-comp = h-new-buf
     1425       .
     1426     end.
     1427     assign
     1428       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1429     .
     1430     do v-ind = 1 to v-num-entries
     1431     on error undo, return error return-value
     1432     :
     1433       assign
     1434         v-field-name = entry( v-ind, v-main-fld-lst )
     1435         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1436         v-old-value  = fh-old:buffer-value()
     1437         v-label      = trim( fh-old:label )
     1438       .
     1439       if ( trim( p-field-list ) <> "":U
     1440            and lookup( v-field-name, p-field-list ) > 0
     1441          )
     1442          or trim( p-field-list ) = "":U
     1443       then do:
     1444         if h-for-comp <> ? then do:
     1445           assign
     1446             fh-new      = h-for-comp:buffer-field( v-field-name )
     1447             v-new-value = fh-new:buffer-value()
     1448           .
     1449         end.
     1450         else do:
     1451           assign
     1452             v-new-value = "":U
     1453           .
     1454         end.
     1455         if v-old-value <> v-new-value
     1456         then do:
     1457           create temp-changes.
     1458           assign
     1459             temp-changes.t_name = p-main-table
     1460             temp-changes.f_name = v-field-name
     1461             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1462             temp-changes.v_old  = trim( v-old-value )
     1463             temp-changes.v_new  = trim( v-new-value )
     1464             temp-changes.num_   = 0
     1465             temp-changes.fNotChange = v-old-value eq v-new-value
     1466           .
     1467         end.
     1468       end.
     1469     end.
     1470     assign
     1471       v-num-entries = num-entries( p-label-form, chr(8) )
     1472     .
     1473     do v-ind = 1 to v-num-entries
     1474     on error undo, return error return-value
     1475     :
     1476       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1477         assign
     1478           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1479           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1480           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1481         .
     1482         find first temp-changes
     1483           where temp-changes.f_name = v-field-name
     1484           no-error .
     1485         if available temp-changes then do:
     1486           if trim( v-field-lvl ) <> "":U then do:
     1487             assign
     1488               temp-changes.l_name = v-field-lvl
     1489             .
     1490           end.
     1491           if trim( v-field-form ) <> "":U then do:
     1492             assign
     1493               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1494             .
     1495             if h-for-comp <> ? then do:
     1496               assign
     1497                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1498               .
     1499             end.
     1500           end.
     1501         end.
     1502       end.
     1503       else do:
     1504         message
     1505           vss-workfile vss-revision vss-description skip
     1506           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1507           substitute( "список для поля '&1': '&2'"
     1508                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1509                       ,entry( v-ind, p-label-form, chr(8) )
     1510                     ) skip
     1511           substitute( "полный список: &2", p-label-form ) skip
     1512           view-as alert-box error .
     1513       end.
     1514     end.
     1515     delete object h-new-buf .
     1516     delete object h-main-buf .
     1517   END PROCEDURE.
     1518   DEFINE BUTTON B-Help
     1519        LABEL "Помо&щь"
     1520        SIZE 3 BY 1
     1521        BGCOLOR 8 .
     1522   DEFINE BUTTON B-lookup
     1523        LABEL "&Просмотр"
     1524        SIZE 10 BY 1.
     1525   DEFINE BUTTON B-mark
     1526        LABEL "&*"
     1527        SIZE 3 BY 1.
     1528   DEFINE BUTTON b-quit AUTO-END-KEY
     1529        LABEL "&Выход"
     1530        SIZE 10 BY 1
     1531        BGCOLOR 8 .
     1532   DEFINE BUTTON B-sel AUTO-GO
     1533        LABEL "Вы&бор"
     1534        SIZE 10 BY 1.
     1535   DEFINE VARIABLE F-attr-label AS CHARACTER FORMAT "X(256)":U
     1536        LABEL "Атрибут"
     1537         VIEW-AS TEXT
     1538        SIZE 37.5 BY .67
     1539        FGCOLOR 4  NO-UNDO.
     1540   DEFINE VARIABLE F-fin-doc-code LIKE X_fin-doc-attr.fin-doc-code
     1541        LABEL "Вн. номер платежа"
     1542         VIEW-AS TEXT
     1543        SIZE 11 BY .67
     1544        FGCOLOR 4  NO-UNDO.
     1545   DEFINE VARIABLE F-host-code LIKE X_c-fin-doc-attr.host-code
     1546        LABEL "Фирма"
     1547         VIEW-AS TEXT
     1548        SIZE 8.5 BY .67
     1549        FGCOLOR 4  NO-UNDO.
     1550   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1551         VIEW-AS TEXT
     1552        SIZE 6 BY 1
     1553        FGCOLOR 4  NO-UNDO.
     1554   DEFINE QUERY br-attrs FOR
     1555         X_c-fin-doc-attr SCROLLING.
     1556   DEFINE QUERY BR-changes FOR
     1557         temp-changes SCROLLING.
     1558   DEFINE BROWSE br-attrs
     1559     QUERY br-attrs NO-LOCK DISPLAY
     1560         mark-string(recid(X_c-fin-doc-attr), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1561         usrfulnf(X_c-fin-doc-attr.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1562         X_c-fin-doc-attr.corr-date COLUMN-LABEL "Дата!измен" FORMAT "99/99/9999":U
     1563         string(X_c-fin-doc-attr.corr-time, "HH:MM") COLUMN-LABEL "Время!измен" FORMAT "X(5)":U
     1564       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.25 FIT-LAST-COLUMN.
     1565   DEFINE BROWSE BR-changes
     1566     QUERY BR-changes DISPLAY
     1567         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1568   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1569   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1570       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.04.
     1571   DEFINE FRAME Dialog-Frame
     1572        b-quit AT ROW 1 COL 1
     1573        B-mark AT ROW 1 COL 11
     1574        B-sel AT ROW 1 COL 21
     1575        B-lookup AT ROW 1 COL 61
     1576        B-Help AT ROW 1 COL 95
     1577        br-attrs AT ROW 3 COL 1
     1578        BR-changes AT ROW 13 COL 1
     1579        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1580        F-host-code AT ROW 2 COL 1 HELP
     1581             ""
     1582             LABEL "Фирма"
     1583             FGCOLOR 4
     1584        F-fin-doc-code AT ROW 2 COL 35 COLON-ALIGNED HELP
     1585             ""
     1586             LABEL "Вн. номер платежа"
     1587             FGCOLOR 4
     1588        F-attr-label AT ROW 2 COL 58 COLON-ALIGNED
     1589        SPACE(1.62) SKIP(19.37)
     1590       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1591            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1592            TITLE "История атрибутов платежа"
     1593            CANCEL-BUTTON b-quit.
     1594   ASSIGN
     1595          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1596          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1597   ASSIGN
     1598          B-lookup:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1599   ASSIGN
     1600          F-attr-label:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1601   ON GO OF FRAME Dialog-Frame
     1602   DO:
     1603     p-rid-list = v-rid-list.
     1604   END.
     1605   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1606   DO:
     1607     APPLY "END-ERROR":U TO SELF.
     1608   END.
     1609   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1610   DO:
     1611     define variable loc#log as logical no-undo .
     1612     if available X_c-fin-doc-attr then do:
     1613   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1614   define variable v-str-recid11 as character no-undo .
     1615   define variable v-num-entry11 as integer   no-undo .
     1616   assign
     1617     v-str-recid11 = trim( string( recid( X_c-fin-doc-attr ) , "->>>>>>>>>>>9":U ) )
     1618     v-num-entry11 = lookup( v-str-recid11 , v-rid-list )
     1619   .
     1620   if v-num-entry11 > 0 then do:
     1621     assign
     1622       entry( v-num-entry11, v-rid-list ) = "":U
     1623       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1624     .
     1625   end.
     1626   else do:
     1627     assign
     1628       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid11
     1629     .
     1630   end.
     1631       loc#log = br-attrs:refresh() .
     1632       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1633           loc#log = br-attrs:select-next-row ().
     1634           apply "VALUE-CHANGED" to br-attrs in frame Dialog-Frame.
     1635       end.
     1636       if num-entries( v-rid-list ) = 0
     1637       then
     1638           hide mark-num in frame Dialog-Frame.
     1639       else
     1640           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1641     end.
     1642     apply "entry" to br-attrs in frame Dialog-Frame.
     1643   END.
     1644   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1645   DO:
     1646       if ( available X_c-fin-doc-attr ) then do:
     1647       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1648       then
     1649       v-rid-list = string( recid( X_c-fin-doc-attr ) ) .
     1650     end.
     1651   END.
     1652   ON RETURN OF br-attrs IN FRAME Dialog-Frame
     1653   or MOUSE-SELECT-DBLCLICK OF br-attrs IN FRAME Dialog-Frame
     1654       DO:
     1655       run proc-br-attrs no-error.
     1656     if error-status:error then return no-apply.
     1657   END.
     1658   ON VALUE-CHANGED OF br-attrs IN FRAME Dialog-Frame
     1659   DO:
     1660     run proc-view-changes in this-procedure no-error.
     1661   END.
     1662   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1663   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1664   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1665   on help of frame Dialog-Frame
     1666   do:
     1667     run gbl/app_help.p
     1668       (input this-procedure :file-name
     1669       ,input ''
     1670       ,input ?
     1671       ) no-error.
     1672     if error-status :error then do:
     1673       message
     1674         "Ошибка при вызове помощи"
     1675         error-status :get-message(1)
     1676         view-as alert-box .
     1677     end.
     1678   end.
     1679   run minbtn-set in this-procedure .
     1680   on choose of b-help in frame Dialog-Frame
     1681   do:
     1682     apply "help":u to frame Dialog-Frame .
     1683   end.
     1684   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1685   procedure minbtn-set :
     1686       do
     1687           on error undo, return error return-value
     1688           :
     1689           define variable ii              as integer       no-undo .
     1690           define variable fh              as widget-handle no-undo .
     1691           define variable hh              as widget-handle no-undo .
     1692           define variable v-h             as handle        extent 4 no-undo .
     1693           define variable v-name-button   as character     no-undo .
     1694           define variable v-help-old-x    as decimal       no-undo .
     1695           define variable v-help-old-y    as decimal       no-undo .
     1696           define variable v-help-old-size as decimal       no-undo .
     1697           define variable v-frame-width   as decimal       no-undo .
     1698           define variable jj              as integer       no-undo .
     1699           do
     1700               on error undo, return error
     1701               :
     1702               assign
     1703                   v-frame-width = frame Dialog-Frame:width - 0.3
     1704                   fh            = frame Dialog-Frame:first-child
     1705                   hh            = fh:first-child
     1706                   ii            = 1
     1707                   .
     1708               do while valid-handle(hh):
     1709                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1710                   do:
     1711                       case lc(hh:name) :
     1712                           when "b-help" then
     1713                               do:
     1714                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1715                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1716                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1717                                   hh:TOOLTIP = "Помощь" .
     1718                                   v-help-old-x = hh:column .
     1719                                   v-help-old-y = hh:row    .
     1720                                   v-help-old-size = hh:width .
     1721                                   hh:width-chars = 2.5 .
     1722                               end.
     1723                           when "b-print" then
     1724                               do:
     1725                                   hh:load-image("cmp/b-print.bmp":u) .
     1726                                   hh:TOOLTIP = "Печать" .
     1727                                   v-h[ii] = hh:handle .
     1728                                   ii = ii + 1 .
     1729                                   hh:width-chars = 3 .
     1730                               end.
     1731                           when "b-history" or
     1732                           when "b-hist" then
     1733                               do:
     1734                                   hh:load-image("cmp/b-hist.bmp":u) .
     1735                                   hh:TOOLTIP = "История" .
     1736                                   v-h[ii] = hh:handle .
     1737                                   ii = ii + 1 .
     1738                                   hh:width-chars = 3 .
     1739                               end.
     1740                           when "b-sch" then
     1741                               do:
     1742                                   hh:load-image("cmp/b-sch.bmp":u) .
     1743                                   hh:TOOLTIP = "Установка Фильтра" .
     1744                                   v-h[ii] = hh:handle .
     1745                                   ii = ii + 1 .
     1746                                   hh:width-chars = 3 .
     1747                               end.
     1748                           when "b-hist-user" then
     1749                               do:
     1750                                   hh:load-image("cmp/b-hist.bmp":u) .
     1751                                   hh:TOOLTIP = "История пользователя" .
     1752                                   ii = ii + 1 .
     1753                               end.
     1754                       end case.
     1755                   end.
     1756                   hh = hh:next-sibling.
     1757               end.
     1758               b-help:column = v-frame-width - b-help:width-chars.
     1759               jj = 0.
     1760               repeat ii = 4 to 1 by -1 :
     1761                   if valid-handle (v-h[ii] ) then
     1762                   do:
     1763                       jj  = jj + 1 .
     1764                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1765                       v-h[ii]:row    = v-help-old-y .
     1766                   end.
     1767               end.
     1768           end.
     1769       end.
     1770   end procedure.
     1771   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1772   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1773   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1774   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1775   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1776   define variable v-diasize-current-frame-height as decimal   no-undo .
     1777   define variable v-diasize-change-size          as logical   no-undo .
     1778   define variable v-diasize-resize-button        as handle    no-undo .
     1779   define variable v-diasize-wndmax               as logical   no-undo .
     1780   define variable v-diasize-wndstore             as logical   no-undo .
     1781   define variable v-diasize-proc-name            as character no-undo .
     1782   define variable v-diasize-browse-handle        as handle    no-undo .
     1783   define variable v-diasize-browse-number        as integer   no-undo .
     1784   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1785   define temp-table temp-diasize-handle no-undo
     1786     field handle-value  as handle
     1787     field save-position as decimal
     1788     index xpk is primary unique handle-value
     1789     .
     1790   define temp-table temp-browse-handle no-undo
     1791     field browse-type   as character
     1792     field browse-number as integer
     1793     field browse-handle as handle
     1794     field original-size as decimal
     1795     index xpk is primary unique browse-type browse-number
     1796     index xie browse-type browse-handle
     1797   .
     1798   procedure diasize_change-height :
     1799     define input  parameter p-change-value  as decimal   no-undo .
     1800     define input  parameter p-move-resize   as logical   no-undo .
     1801     define variable v-field-group-handle    as handle    no-undo .
     1802     define variable v-object-handle         as handle    no-undo .
     1803     define variable v-frame-height          as decimal   no-undo .
     1804     define variable v-frame-virtual-height  as decimal   no-undo .
     1805     define variable v-browse-height         as decimal   no-undo .
     1806     define variable v-window-height         as decimal   no-undo .
     1807     define variable v-window-virtual-height as decimal   no-undo .
     1808     define variable v-change-sign           as integer   no-undo .
     1809     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1810     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1811     if p-change-value > 0
     1812     then do:
     1813       if frame Dialog-Frame :height + p-change-value
     1814           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1815       then do:
     1816         assign
     1817           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1818                           - (frame Dialog-Frame :height-chars)
     1819         .
     1820         if p-change-value <= 0
     1821         then do:
     1822           run diasize_position-resize-button in this-procedure .
     1823           return .
     1824         end.
     1825       end.
     1826     end.
     1827     if p-change-value < 0
     1828     then do:
     1829       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1830       then do:
     1831         assign
     1832           p-change-value = v-diasize-orig-frame-height
     1833                          - (frame Dialog-Frame :height-chars)
     1834         .
     1835         if p-change-value >= 0
     1836         then do:
     1837           run diasize_position-resize-button in this-procedure .
     1838           return .
     1839         end.
     1840       end.
     1841     end.
     1842     if p-change-value >= 0
     1843     then do:
     1844       assign
     1845         v-change-sign = 1
     1846       .
     1847     end.
     1848     else do:
     1849       assign
     1850         v-change-sign = -1
     1851       .
     1852     end.
     1853     assign
     1854       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1855     .
     1856     if p-change-value = 0
     1857     then do:
     1858       run diasize_position-resize-button in this-procedure .
     1859       return .
     1860     end.
     1861     move_block:
     1862     do
     1863     on error undo move_block, retry move_block
     1864     :
     1865       if retry
     1866       then do:
     1867         do
     1868         on error undo move_block, leave move_block
     1869         :
     1870           if p-change-value > 0
     1871           then do:
     1872             for each buf_temp-diasize-handle
     1873             on error undo, next
     1874             :
     1875               assign
     1876                 v-object-handle = buf_temp-diasize-handle.handle-value
     1877               .
     1878               if v-object-handle <> v-diasize-resize-button
     1879               then do:
     1880                 assign
     1881                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1882                 .
     1883               end.
     1884             end.
     1885             assign
     1886               v-diasize-browse-handle :height = v-browse-height
     1887             .
     1888             for each buf_temp-browse-handle
     1889               where buf_temp-browse-handle.browse-type = 'height':u
     1890             on error undo, next
     1891             :
     1892               assign
     1893                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1894               .
     1895             end.
     1896             assign
     1897               frame Dialog-Frame :height = v-frame-height
     1898             .
     1899             if frame Dialog-Frame :scrollable = true
     1900             then do:
     1901               assign
     1902                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1903               .
     1904             end.
     1905             run diasize_position-resize-button in this-procedure .
     1906           end.
     1907           else do:
     1908             if frame Dialog-Frame :scrollable = true
     1909             then do:
     1910               assign
     1911                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1912               .
     1913             end.
     1914             assign
     1915               frame Dialog-Frame :height = v-frame-height
     1916             .
     1917             assign
     1918               v-diasize-browse-handle :height = v-browse-height
     1919             .
     1920             for each buf_temp-browse-handle
     1921               where buf_temp-browse-handle.browse-type = 'height':u
     1922             on error undo, next
     1923             :
     1924               assign
     1925                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1926               .
     1927             end.
     1928             for each buf_temp-diasize-handle
     1929             on error undo, next
     1930             :
     1931               assign
     1932                 v-object-handle = buf_temp-diasize-handle.handle-value
     1933               .
     1934               if v-object-handle <> v-diasize-resize-button
     1935               then do:
     1936                 assign
     1937                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1938                 .
     1939               end.
     1940             end.
     1941             run diasize_position-resize-button in this-procedure .
     1942           end.
     1943           assign
     1944             v-diasize-change-size = false
     1945           .
     1946           leave move_block .
     1947         end.
     1948       end.
     1949       assign
     1950         v-diasize-need-full-display = true
     1951       .
     1952       if v-diasize-change-size = false
     1953       then do:
     1954         assign
     1955           v-diasize-change-size = true
     1956         .
     1957       end.
     1958       else do:
     1959         return .
     1960       end.
     1961       assign
     1962         v-frame-height = frame Dialog-Frame :height
     1963         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1964         v-browse-height = v-diasize-browse-handle :height
     1965       .
     1966       for each buf_temp-browse-handle
     1967         where buf_temp-browse-handle.browse-type = 'height':u
     1968       :
     1969         assign
     1970           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1971         .
     1972       end.
     1973       for each buf_temp-diasize-handle
     1974       :
     1975         delete buf_temp-diasize-handle .
     1976       end.
     1977       assign
     1978         v-field-group-handle = frame Dialog-Frame :first-child
     1979       .
     1980       do while valid-handle(v-field-group-handle)
     1981       :
     1982         assign
     1983           v-object-handle = v-field-group-handle :first-child
     1984         .
     1985         do while valid-handle(v-object-handle)
     1986         :
     1987           if  v-object-handle <> v-diasize-browse-handle :handle
     1988           and can-query(v-object-handle, "row")
     1989           and can-query(v-object-handle, "height")
     1990           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1991           then do:
     1992             find first buf_temp-browse-handle
     1993               where buf_temp-browse-handle.browse-type   = 'height':u
     1994                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1995               no-error .
     1996             if available buf_temp-browse-handle
     1997             then do:
     1998             end.
     1999             else do:
     2000               create buf_temp-diasize-handle .
     2001               assign
     2002                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2003                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2004               .
     2005             end.
     2006           end.
     2007           assign
     2008             v-object-handle = v-object-handle :next-sibling
     2009           .
     2010         end.
     2011         assign
     2012           v-field-group-handle = v-field-group-handle :next-sibling
     2013         .
     2014       end.
     2015       do with frame Dialog-Frame
     2016       :
     2017         hide v-diasize-resize-button .
     2018         assign
     2019           v-diasize-resize-button :row    = 1
     2020           v-diasize-resize-button :column = 1
     2021         .
     2022       end.
     2023       if p-change-value > 0
     2024       then do:
     2025         if frame Dialog-Frame :scrollable = true
     2026         then do:
     2027           assign
     2028             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2029             no-error .
     2030           if error-status :error
     2031           or error-status :get-message(1) <> ""
     2032           then do:
     2033             undo move_block, retry move_block .
     2034           end.
     2035         end.
     2036         assign
     2037           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2038           no-error .
     2039         if error-status :error
     2040         or error-status :get-message(1) <> ""
     2041         then do:
     2042           undo move_block, retry move_block .
     2043         end.
     2044         assign
     2045           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2046           no-error .
     2047         if error-status :error
     2048         or error-status :get-message(1) <> ""
     2049         then do:
     2050           undo move_block, retry move_block .
     2051         end.
     2052         for each buf_temp-browse-handle
     2053           where buf_temp-browse-handle.browse-type = 'height':u
     2054         on error undo move_block, retry move_block
     2055         :
     2056           assign
     2057             buf_temp-browse-handle.browse-handle :height
     2058               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2059             no-error .
     2060           if error-status :error
     2061           or error-status :get-message(1) <> ""
     2062           then do:
     2063             undo move_block, retry move_block .
     2064           end.
     2065         end.
     2066         for each buf_temp-diasize-handle
     2067         on error undo move_block, retry move_block
     2068         :
     2069           assign
     2070             v-object-handle = buf_temp-diasize-handle.handle-value
     2071           .
     2072           if v-object-handle <> v-diasize-resize-button
     2073           then do:
     2074             assign
     2075               v-object-handle :row = v-object-handle :row + p-change-value
     2076               no-error .
     2077             if error-status :error
     2078             or error-status :get-message(1) <> ""
     2079             then do:
     2080               undo move_block, retry move_block .
     2081             end.
     2082           end.
     2083         end.
     2084       end.
     2085       else do:
     2086         for each buf_temp-diasize-handle
     2087         on error undo move_block, retry move_block
     2088         :
     2089           assign
     2090             v-object-handle = buf_temp-diasize-handle.handle-value
     2091           .
     2092           if v-object-handle <> v-diasize-resize-button
     2093           then do:
     2094             assign
     2095               v-object-handle :row = v-object-handle :row + p-change-value
     2096               no-error .
     2097             if error-status :error
     2098             or error-status :get-message(1) <> ""
     2099             then do:
     2100               undo move_block, retry move_block .
     2101             end.
     2102           end.
     2103         end.
     2104         assign
     2105           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2106           no-error .
     2107         if error-status :error
     2108         or error-status :get-message(1) <> ""
     2109         then do:
     2110           undo move_block, retry move_block .
     2111         end.
     2112         for each buf_temp-browse-handle
     2113           where buf_temp-browse-handle.browse-type = 'height':u
     2114         on error undo move_block, retry move_block
     2115         :
     2116           assign
     2117             buf_temp-browse-handle.browse-handle :height
     2118               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2119             no-error .
     2120           if error-status :error
     2121           or error-status :get-message(1) <> ""
     2122           then do:
     2123             undo move_block, retry move_block .
     2124           end.
     2125         end.
     2126         assign
     2127           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2128           no-error .
     2129         if error-status :error
     2130         or error-status :get-message(1) <> ""
     2131         then do:
     2132           undo move_block, retry move_block .
     2133         end.
     2134         if frame Dialog-Frame :scrollable = true
     2135         then do:
     2136           assign
     2137             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2138             no-error .
     2139           if error-status :error
     2140           or error-status :get-message(1) <> ""
     2141           then do:
     2142             undo move_block, retry move_block .
     2143           end.
     2144         end.
     2145       end.
     2146       if p-move-resize = true
     2147       then do:
     2148         run diasize_position-resize-button in this-procedure .
     2149       end.
     2150       if v-diasize-wndstore = true
     2151       then do:
     2152         if connected("ub") = true
     2153         then do:
     2154           define variable v-cntxt-db-num        as integer   no-undo .
     2155           define variable v-cntxt-userid        as character no-undo .
     2156           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2157                                             , OUTPUT v-cntxt-userid
     2158                                             ) .
     2159           run gbl/wndsizew.p
     2160             (input  v-cntxt-db-num
     2161             ,input  v-cntxt-userid
     2162             ,input  v-diasize-proc-name
     2163             ,input  'height':u
     2164             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2165             ) .
     2166         end.
     2167       end.
     2168     end.
     2169     assign
     2170       v-diasize-change-size = false
     2171     .
     2172   end procedure.
     2173   procedure diasize_set-height :
     2174     define input  parameter p-new-height  as decimal   no-undo .
     2175     define input  parameter p-move-resize as logical   no-undo .
     2176     do
     2177     on error undo, return error return-value
     2178     :
     2179       run diasize_change-height in this-procedure
     2180         (input  (p-new-height - frame Dialog-Frame :height)
     2181         ,input  p-move-resize
     2182         ) .
     2183     end.
     2184   end procedure.
     2185   procedure diasize_change-width :
     2186     define input  parameter p-change-value as decimal   no-undo .
     2187     define input  parameter p-move-resize  as logical   no-undo .
     2188     define variable v-field-group-handle   as handle    no-undo .
     2189     define variable v-object-handle        as handle    no-undo .
     2190     define variable v-frame-width          as decimal   no-undo .
     2191     define variable v-frame-virtual-width  as decimal   no-undo .
     2192     define variable v-browse-width         as decimal   no-undo .
     2193     define variable v-window-width         as decimal   no-undo .
     2194     define variable v-window-virtual-width as decimal   no-undo .
     2195     define variable v-change-sign          as integer   no-undo .
     2196     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2197     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2198     if p-change-value > 0
     2199     then do:
     2200       if frame Dialog-Frame :width + p-change-value >
     2201           session :width-chars
     2202       then do:
     2203         assign
     2204           p-change-value = session :width-chars - frame Dialog-Frame :width
     2205         .
     2206         if p-change-value <= 0
     2207         then do:
     2208           run diasize_position-resize-button in this-procedure .
     2209           return .
     2210         end.
     2211       end.
     2212     end.
     2213     if p-change-value < 0
     2214     then do:
     2215       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2216       then do:
     2217         assign
     2218           p-change-value = v-diasize-orig-frame-width
     2219                          - frame Dialog-Frame :width
     2220         .
     2221         if p-change-value >= 0
     2222         then do:
     2223           run diasize_position-resize-button in this-procedure .
     2224           return .
     2225         end.
     2226       end.
     2227     end.
     2228     if p-change-value >= 0
     2229     then do:
     2230       assign
     2231         v-change-sign = 1
     2232       .
     2233     end.
     2234     else do:
     2235       assign
     2236         v-change-sign = -1
     2237       .
     2238     end.
     2239     assign
     2240       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2241     .
     2242     if p-change-value = 0
     2243     then do:
     2244       run diasize_position-resize-button in this-procedure .
     2245       return .
     2246     end.
     2247     move_block:
     2248     do
     2249     on error undo move_block, leave move_block
     2250     :
     2251       if retry
     2252       then do:
     2253         do
     2254         on error undo move_block, leave move_block
     2255         :
     2256           if p-change-value > 0
     2257           then do:
     2258             for each buf_temp-diasize-handle
     2259             on error undo, next
     2260             :
     2261               assign
     2262                 v-object-handle = buf_temp-diasize-handle.handle-value
     2263               .
     2264               if v-object-handle <> v-diasize-resize-button
     2265               then do:
     2266                 assign
     2267                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2268                 .
     2269               end.
     2270             end.
     2271             assign
     2272               v-diasize-browse-handle :width = v-browse-width
     2273             .
     2274             for each buf_temp-browse-handle
     2275               where buf_temp-browse-handle.browse-type = 'width':u
     2276             on error undo, next
     2277             :
     2278               assign
     2279                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2280               .
     2281             end.
     2282             assign
     2283               frame Dialog-Frame :width = v-frame-width
     2284             .
     2285             if frame Dialog-Frame :scrollable = true
     2286             then do:
     2287               assign
     2288                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2289               .
     2290             end.
     2291             run diasize_position-resize-button in this-procedure .
     2292           end.
     2293           else do:
     2294             if frame Dialog-Frame :scrollable = true
     2295             then do:
     2296               assign
     2297                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2298               .
     2299             end.
     2300             assign
     2301               frame Dialog-Frame :width = v-frame-width
     2302             .
     2303             for each buf_temp-browse-handle
     2304               where buf_temp-browse-handle.browse-type = 'width':u
     2305             on error undo, next
     2306             :
     2307               assign
     2308                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2309               .
     2310             end.
     2311             assign
     2312               v-diasize-browse-handle :width = v-browse-width
     2313             .
     2314             for each buf_temp-diasize-handle
     2315             on error undo, next
     2316             :
     2317               assign
     2318                 v-object-handle = buf_temp-diasize-handle.handle-value
     2319               .
     2320               if v-object-handle <> v-diasize-resize-button
     2321               then do:
     2322                 assign
     2323                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2324                 .
     2325               end.
     2326             end.
     2327             run diasize_position-resize-button in this-procedure .
     2328           end.
     2329           assign
     2330             v-diasize-change-size = false
     2331           .
     2332           leave move_block .
     2333         end.
     2334       end.
     2335       assign
     2336         v-diasize-need-full-display = true
     2337       .
     2338       if v-diasize-change-size = false
     2339       then do:
     2340         assign
     2341           v-diasize-change-size = true
     2342         .
     2343       end.
     2344       else do:
     2345         return .
     2346       end.
     2347       assign
     2348         v-frame-width = frame Dialog-Frame :width
     2349         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2350         v-browse-width = v-diasize-browse-handle :width
     2351       .
     2352       for each buf_temp-browse-handle
     2353         where buf_temp-browse-handle.browse-type = 'width':u
     2354       :
     2355         assign
     2356           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2357         .
     2358       end.
     2359       for each buf_temp-diasize-handle
     2360       :
     2361         delete buf_temp-diasize-handle .
     2362       end.
     2363       assign
     2364         v-field-group-handle = frame Dialog-Frame :first-child
     2365       .
     2366       do while valid-handle(v-field-group-handle)
     2367       :
     2368         assign
     2369           v-object-handle = v-field-group-handle :first-child
     2370         .
     2371         do while valid-handle(v-object-handle)
     2372         :
     2373           if  v-object-handle <> v-diasize-browse-handle :handle
     2374           and v-object-handle <> v-diasize-resize-button
     2375           and can-query(v-object-handle, "row")
     2376           and can-query(v-object-handle, "height")
     2377           and ( v-object-handle :col + v-object-handle :width
     2378                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2379               )
     2380           then do:
     2381             find first buf_temp-browse-handle
     2382               where buf_temp-browse-handle.browse-type   = 'width':u
     2383                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2384               no-error .
     2385             if available buf_temp-browse-handle
     2386             then do:
     2387             end.
     2388             else do:
     2389               create buf_temp-diasize-handle .
     2390               assign
     2391                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2392                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2393               .
     2394             end.
     2395           end.
     2396           assign
     2397             v-object-handle = v-object-handle :next-sibling
     2398           .
     2399         end.
     2400         assign
     2401           v-field-group-handle = v-field-group-handle :next-sibling
     2402         .
     2403       end.
     2404       do with frame Dialog-Frame
     2405       :
     2406         hide v-diasize-resize-button .
     2407         v-diasize-resize-button :row = 1.
     2408         v-diasize-resize-button :column = 1.
     2409       end.
     2410       if p-change-value > 0
     2411       then do:
     2412         if frame Dialog-Frame :scrollable = true
     2413         then do:
     2414           assign
     2415             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2416             no-error .
     2417           if error-status :error
     2418           or error-status :get-message(1) <> ""
     2419           then do:
     2420             undo move_block, retry move_block.
     2421           end.
     2422         end.
     2423         assign
     2424           frame Dialog-Frame :width = v-frame-width + p-change-value
     2425           no-error .
     2426         if error-status :error
     2427         or error-status :get-message(1) <> ""
     2428         then do:
     2429           undo move_block, retry move_block.
     2430         end.
     2431         assign
     2432           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2433         no-error .
     2434         if error-status :error
     2435         or error-status :get-message(1) <> ""
     2436         then do:
     2437           undo move_block, retry move_block.
     2438         end.
     2439         for each buf_temp-browse-handle
     2440           where buf_temp-browse-handle.browse-type = 'width':u
     2441         on error undo move_block, retry move_block
     2442         :
     2443           assign
     2444             buf_temp-browse-handle.browse-handle :width
     2445               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2446             no-error .
     2447           if error-status :error
     2448           or error-status :get-message(1) <> ""
     2449           then do:
     2450             undo move_block, retry move_block .
     2451           end.
     2452         end.
     2453         for each buf_temp-diasize-handle
     2454         on error undo move_block, retry move_block
     2455         :
     2456           assign
     2457             v-object-handle = buf_temp-diasize-handle.handle-value
     2458           .
     2459           if v-object-handle <> v-diasize-resize-button
     2460           then do:
     2461             assign
     2462               v-object-handle :col = v-object-handle :col + p-change-value
     2463               no-error .
     2464             if error-status :error
     2465             or error-status :get-message(1) <> ""
     2466             then do:
     2467               undo move_block, retry move_block .
     2468             end.
     2469           end.
     2470         end.
     2471       end.
     2472       else do:
     2473         for each buf_temp-diasize-handle
     2474         on error undo move_block, retry move_block
     2475         :
     2476           assign
     2477             v-object-handle = buf_temp-diasize-handle.handle-value
     2478           .
     2479           if v-object-handle <> v-diasize-resize-button
     2480           then do:
     2481             assign
     2482               v-object-handle :col = v-object-handle :col + p-change-value
     2483               no-error .
     2484             if error-status :error
     2485             or error-status :get-message(1) <> ""
     2486             then do:
     2487               undo move_block, retry move_block .
     2488             end.
     2489           end.
     2490         end.
     2491         for each buf_temp-browse-handle
     2492           where buf_temp-browse-handle.browse-type = 'width':u
     2493         on error undo move_block, retry move_block
     2494         :
     2495           assign
     2496             buf_temp-browse-handle.browse-handle :width
     2497               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2498             no-error .
     2499           if error-status :error
     2500           or error-status :get-message(1) <> ""
     2501           then do:
     2502             undo move_block, retry move_block .
     2503           end.
     2504         end.
     2505         assign
     2506           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2507           no-error .
     2508         if error-status :error
     2509         or error-status :get-message(1) <> ""
     2510         then do:
     2511           undo move_block, retry move_block.
     2512         end.
     2513         assign
     2514           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2515         no-error .
     2516         if error-status :error
     2517         or error-status :get-message(1) <> ""
     2518         then do:
     2519           undo move_block, retry move_block.
     2520         end.
     2521         if frame Dialog-Frame :scrollable = true
     2522         then do:
     2523           assign
     2524             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2525           no-error .
     2526           if error-status :error
     2527           or error-status :get-message(1) <> ""
     2528           then do:
     2529             undo move_block, retry move_block.
     2530           end.
     2531         end.
     2532       end.
     2533       if p-move-resize
     2534       then do:
     2535         run diasize_position-resize-button in this-procedure .
     2536       end.
     2537       if v-diasize-wndstore = true
     2538       then do:
     2539         if connected("ub") = true
     2540         then do:
     2541           define variable v-cntxt-db-num        as integer   no-undo .
     2542           define variable v-cntxt-userid        as character no-undo .
     2543           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2544                                             , OUTPUT v-cntxt-userid
     2545                                             ) .
     2546           run gbl/wndsizew.p
     2547             (input  v-cntxt-db-num
     2548             ,input  v-cntxt-userid
     2549             ,input  v-diasize-proc-name
     2550             ,input  'width':u
     2551             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2552             ) .
     2553         end.
     2554       end.
     2555     end.
     2556     assign
     2557       v-diasize-change-size = false
     2558     .
     2559   end procedure.
     2560   procedure diasize_set-width :
     2561     define input  parameter p-new-width  as decimal   no-undo .
     2562     define input  parameter p-move-resize as logical   no-undo .
     2563     do
     2564     on error undo, return error return-value
     2565     :
     2566       run diasize_change-width in this-procedure
     2567         (input  (p-new-width - frame Dialog-Frame :width)
     2568         ,input  p-move-resize
     2569         ) .
     2570     end.
     2571   end procedure.
     2572   procedure diasize_position-resize-button :
     2573     do with frame Dialog-Frame
     2574     :
     2575       hide v-diasize-resize-button .
     2576       assign
     2577         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2578                     - 1
     2579                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2580         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2581                     - 1
     2582                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2583       .
     2584       view v-diasize-resize-button .
     2585     end.
     2586   end procedure.
     2587   on alt-right anywhere
     2588   do:
     2589     run diasize_change-width in this-procedure
     2590       (input 1
     2591       ,input true
     2592       ) .
     2593     return no-apply .
     2594   end.
     2595   on alt-left anywhere
     2596   do:
     2597     run diasize_change-width in this-procedure
     2598       (input -1
     2599       ,input true
     2600       ) .
     2601     return no-apply .
     2602   end.
     2603   on alt-down anywhere
     2604   do:
     2605     run diasize_change-height in this-procedure
     2606       (input 1
     2607       ,input true
     2608       ) .
     2609     return no-apply .
     2610   end.
     2611   on alt-up anywhere
     2612   do:
     2613     run diasize_change-height in this-procedure
     2614       (input -1
     2615       ,input true
     2616       ) .
     2617     return no-apply .
     2618   end.
     2619   on alt-enter of frame Dialog-Frame
     2620   do:
     2621     run diasize_maximize in this-procedure
     2622       (input  ?
     2623       ).
     2624     return no-apply .
     2625   end.
     2626   procedure diasize_end-move :
     2627     do
     2628     on error undo, return error return-value
     2629     :
     2630       define variable v-row-delta as decimal   no-undo .
     2631       define variable v-col-delta as decimal   no-undo .
     2632       define variable v-new-row as decimal   no-undo .
     2633       define variable v-new-col as decimal   no-undo .
     2634       assign
     2635         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2636         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2637       .
     2638       assign
     2639         v-row-delta = v-new-row - frame Dialog-Frame :height
     2640         v-col-delta = v-new-col - frame Dialog-Frame :width
     2641       .
     2642       run diasize_change-height in this-procedure
     2643         (input v-row-delta
     2644         ,input true
     2645         ) .
     2646       run diasize_change-width in this-procedure
     2647         (input v-col-delta
     2648         ,input true
     2649         ) .
     2650     end.
     2651   end procedure.
     2652   procedure diasize_maximize :
     2653     define input  parameter p-action as logical   no-undo .
     2654     do
     2655     on error undo, return error return-value
     2656     :
     2657       if p-action = ?
     2658       then do:
     2659         if v-diasize-need-maximize = true
     2660         then do:
     2661           assign
     2662             p-action = true
     2663           .
     2664         end.
     2665         else do:
     2666           assign
     2667             p-action = false
     2668           .
     2669         end.
     2670       end.
     2671       if p-action = true
     2672       then do:
     2673         run diasize_change-height in this-procedure
     2674           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2675               - frame Dialog-Frame :height-chars
     2676           ,input true
     2677           ) .
     2678         run diasize_change-width in this-procedure
     2679           (input session :width-chars
     2680               - frame Dialog-Frame :width-chars
     2681           ,input true
     2682           ) .
     2683         assign
     2684           v-diasize-need-maximize = false
     2685         .
     2686       end.
     2687       else do:
     2688         run diasize_change-width in this-procedure
     2689           (input v-diasize-orig-frame-width
     2690               - frame Dialog-Frame :width-chars
     2691           ,input true
     2692           ) .
     2693         run diasize_change-height in this-procedure
     2694           (input v-diasize-orig-frame-height
     2695               - frame Dialog-Frame :height-chars
     2696           ,input true
     2697           ) .
     2698         assign
     2699           v-diasize-need-maximize = true
     2700         .
     2701       end.
     2702     end.
     2703   end procedure.
     2704   procedure diasize_restore-orig-size :
     2705     do
     2706     on error undo, return error return-value
     2707     :
     2708       assign
     2709         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2710         v-diasize-current-frame-height = frame Dialog-Frame :height
     2711       .
     2712       run diasize_set-height in this-procedure
     2713         (input  v-diasize-orig-frame-height
     2714         ,input  true
     2715         ) .
     2716       run diasize_set-width in this-procedure
     2717         (input  v-diasize-orig-frame-width
     2718         ,input  true
     2719         ) .
     2720     end.
     2721   end procedure.
     2722   procedure diasize_restore-current-size :
     2723     do
     2724     on error undo, return error return-value
     2725     :
     2726       run diasize_set-height in this-procedure
     2727         (input  v-diasize-current-frame-height
     2728         ,input  true
     2729         ) .
     2730       run diasize_set-width in this-procedure
     2731         (input  v-diasize-current-frame-width
     2732         ,input  true
     2733         ) .
     2734     end.
     2735   end procedure.
     2736   procedure diasize_set-browse-handle :
     2737     define input  parameter p-browse-handle as handle   no-undo .
     2738     define buffer buf_temp-browse-handle for temp-browse-handle .
     2739     do
     2740     on error undo, return error return-value
     2741     :
     2742       assign
     2743         v-diasize-browse-handle = p-browse-handle
     2744       .
     2745       for each buf_temp-browse-handle
     2746       on error undo, return error return-value
     2747       :
     2748         delete buf_temp-browse-handle .
     2749       end.
     2750     end.
     2751   end procedure.
     2752   procedure diasize_add_browse :
     2753     define input  parameter p-browse-type   as character no-undo .
     2754     define input  parameter p-browse-handle as handle    no-undo .
     2755     define buffer buf_temp-browse-handle for temp-browse-handle .
     2756     do
     2757     on error undo, return error return-value
     2758     :
     2759       assign
     2760         v-diasize-browse-number = v-diasize-browse-number + 1
     2761       .
     2762       create buf_temp-browse-handle .
     2763       assign
     2764         buf_temp-browse-handle.browse-type   = p-browse-type
     2765         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2766         buf_temp-browse-handle.browse-handle = p-browse-handle
     2767       .
     2768     end.
     2769   end procedure.
     2770   procedure diasize_init :
     2771     define variable v-default-value    as logical   no-undo .
     2772     define variable v-restore-saved    as logical   no-undo .
     2773     define variable v-resize-value-str as character no-undo .
     2774     do
     2775     on error undo, return error return-value
     2776     :
     2777       do with frame Dialog-Frame
     2778       :
     2779         assign
     2780           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2781           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2782           v-diasize-browse-handle     = browse br-attrs :handle
     2783         .
     2784         create button v-diasize-resize-button
     2785         assign
     2786           parent        = frame Dialog-Frame :first-child
     2787           label         = "s"
     2788           height-pixels = 16
     2789           width-pixels  = 16
     2790           visible       = true
     2791           sensitive     = true
     2792           movable       = true
     2793           triggers:
     2794             on end-move persistent run diasize_end-move in this-procedure .
     2795           end triggers.
     2796         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2797         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2798         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2799         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2800         assign
     2801           v-diasize-wndmax = false
     2802         .
     2803         if connected("ub") = true
     2804         then do:
     2805           define variable v-cntxt-db-num        as integer   no-undo .
     2806           define variable v-cntxt-userid        as character no-undo .
     2807           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2808                                             , OUTPUT v-cntxt-userid
     2809                                             ) .
     2810           run gbl/wndpar_r.p
     2811             (input  v-cntxt-db-num
     2812             ,input  v-cntxt-userid
     2813             ,input  'wndmax':U
     2814             ,output v-diasize-wndmax
     2815             ,output v-default-value
     2816             ) .
     2817         end.
     2818         assign
     2819           v-diasize-wndstore = false
     2820         .
     2821         if connected("ub") = true
     2822         then do:
     2823           run gbl/wndpar_r.p
     2824             (input  v-cntxt-db-num
     2825             ,input  v-cntxt-userid
     2826             ,input  'wndstore':U
     2827             ,output v-diasize-wndstore
     2828             ,output v-default-value
     2829             ) .
     2830         end.
     2831         assign
     2832           v-diasize-proc-name = entry(1, program-name(2), '.')
     2833         .
     2834         if v-diasize-wndstore = true
     2835         then do:
     2836           assign
     2837             v-restore-saved = false
     2838           .
     2839           if connected("ub") = true
     2840           then do:
     2841             run gbl/wndsizer.p
     2842               (input  v-cntxt-db-num
     2843               ,input  v-cntxt-userid
     2844               ,input  v-diasize-proc-name
     2845               ,input  'height':u
     2846               ,output v-resize-value-str
     2847               ) .
     2848             if v-resize-value-str <> '':U
     2849             then do:
     2850               run diasize_change-height in this-procedure
     2851                 (input  integer(v-resize-value-str)
     2852                 ,input  true
     2853                 ) .
     2854               assign
     2855                 v-restore-saved = true
     2856               .
     2857             end.
     2858           end.
     2859           if connected("ub") = true
     2860           then do:
     2861             run gbl/wndsizer.p
     2862               (input  v-cntxt-db-num
     2863               ,input  v-cntxt-userid
     2864               ,input  v-diasize-proc-name
     2865               ,input  'width':u
     2866               ,output v-resize-value-str
     2867               ) .
     2868             if v-resize-value-str <> '':U
     2869             then do:
     2870               run diasize_change-width in this-procedure
     2871                 (input  integer(v-resize-value-str)
     2872                 ,input  true
     2873                 ) .
     2874               assign
     2875                 v-restore-saved = true
     2876               .
     2877             end.
     2878           end.
     2879           if v-restore-saved <> true
     2880           then do:
     2881             if v-diasize-wndmax = true
     2882             then do:
     2883               run diasize_maximize in this-procedure
     2884                 (input  true
     2885                 ) .
     2886             end.
     2887           end.
     2888         end.
     2889         else do:
     2890           if v-diasize-wndmax = true
     2891           then do:
     2892             run diasize_maximize in this-procedure
     2893               (input  true
     2894               ) .
     2895           end.
     2896         end.
     2897       end.
     2898     end.
     2899   end procedure.
     2900   procedure diasize_need-full-display :
     2901     define output parameter p-need-full-display as logical   no-undo .
     2902     do
     2903     on error undo, return error return-value
     2904     :
     2905       assign
     2906         p-need-full-display = v-diasize-need-full-display
     2907       .
     2908       assign
     2909         v-diasize-need-full-display = false
     2910       .
     2911     end.
     2912   end procedure.
     2913   procedure get-context :
     2914      define output parameter p-db-num as integer          no-undo.
     2915      define output parameter p-user-id as character        no-undo.
     2916      define variable v-login               as character    no-undo.
     2917      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2918      define buffer buf_user-login  for ub.user-login .
     2919      do
     2920      on error undo, return error
     2921      :
     2922            FIND FIRST buf_sys-ctrl no-lock.
     2923            ASSIGN
     2924               v-login = USERID("ub")
     2925               p-db-num = buf_sys-ctrl.db-num
     2926            .
     2927            FIND FIRST buf_user-login
     2928                 WHERE buf_user-login.db-num = p-db-num
     2929                   AND buf_user-login.user-login = v-login
     2930                 no-lock
     2931                 no-error
     2932                 .
     2933            IF AVAILABLE buf_user-login
     2934            THEN DO:
     2935               assign
     2936                  p-user-id = buf_user-login.user-id
     2937               .
     2938            END.
     2939      end.
     2940   end procedure.
     2941   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2942   on f5 of frame Dialog-Frame anywhere
     2943   do:
     2944     v-doc-rec = recid(X_fin-doc-attr). run openbr in this-procedure. reposition br-attrs to recid v-doc-rec no-error.
     2945       apply "VALUE-CHANGED" to br-attrs.
     2946   end.
     2947   def var sort-labelbr-attrs   as character no-undo .
     2948   def var sort-clmnbr-attrs    as handle    no-undo .
     2949   def var cur-clmnbr-attrs     as handle    no-undo .
     2950   def var cur-clmn-locbr-attrs as integer   no-undo .
     2951   def var re-querybr-attrs     as logical   initial no no-undo .
     2952   on start-search, ctrl-o of br-attrs in frame Dialog-Frame do:
     2953      run sort-brbr-attrs
     2954        (input (if available X_c-fin-doc-attr
     2955                then recid(X_c-fin-doc-attr)
     2956                else ?
     2957               )
     2958        ).
     2959   end.
     2960   PROCEDURE sort-brbr-attrs :
     2961     define input parameter p-recid as recid no-undo .
     2962     if re-querybr-attrs = no then do:
     2963       assign
     2964          cur-clmnbr-attrs = br-attrs:current-column in frame Dialog-Frame
     2965       .
     2966       if sort-clmnbr-attrs <> ? then sort-clmnbr-attrs:column-fgcolor = 0.
     2967       if cur-clmnbr-attrs = sort-clmnbr-attrs then do:
     2968         assign
     2969            sort-labelbr-attrs = ""
     2970            sort-clmnbr-attrs = ?
     2971         .
     2972        end.
     2973        else do:
     2974          assign
     2975            sort-labelbr-attrs = cur-clmnbr-attrs:label
     2976            sort-clmnbr-attrs  = cur-clmnbr-attrs
     2977            sort-clmnbr-attrs:column-fgcolor = 4
     2978          .
     2979        end.
     2980      end.
     2981     assign
     2982       cur-clmn-locbr-attrs = 1
     2983     .
     2984     def var column-handle as handle no-undo .
     2985     column-handle = br-attrs:first-column.
     2986     do while valid-handle(column-handle) :
     2987       if column-handle = cur-clmnbr-attrs then do:
     2988         leave .
     2989       end.
     2990       column-handle = column-handle:NEXT-COLUMN.
     2991       assign
     2992         cur-clmn-locbr-attrs = cur-clmn-locbr-attrs + 1
     2993       .
     2994     end.
     2995     case sort-labelbr-attrs:
     2996           when X_c-fin-doc-attr.corr-date:label in browse br-attrs then DO:   assign     sort-column-name = "X_c-fin-doc-attr.corr-date"   .   run OpenBr.   . END.
     2997       otherwise do:
     2998         assign
     2999           sort-column-name = ""
     3000         .
     3001         run OpenBr.
     3002           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-attrs') then do:
     3003             run mv-brw-defaultbr-attrs.
     3004           end.
     3005         if sort-labelbr-attrs <> "" then do:
     3006           assign
     3007             cur-clmnbr-attrs:column-fgcolor = 0
     3008           .
     3009         end.
     3010         assign
     3011           cur-clmn-locbr-attrs = ?
     3012         .
     3013       end.
     3014     end case.
     3015       if cur-clmn-locbr-attrs <> ? then do:
     3016         if can-do( this-procedure:internal-entries, 'ch-clmnbr-attrs') then do:
     3017           run ch-clmnbr-attrs in this-procedure (cur-clmn-locbr-attrs).
     3018         end.
     3019       end.
     3020     if p-recid <> ? then do:
     3021       reposition br-attrs to recid p-recid no-error.
     3022       apply "value-changed" to br-attrs in frame Dialog-Frame.
     3023     end.
     3024     apply "entry" to br-attrs in frame Dialog-Frame.
     3025   END PROCEDURE.
     3026   procedure re-open-query-srt-clmnbr-attrs:
     3027   if cur-clmnbr-attrs = ? then do:
     3028      run OpenBr.
     3029   end.
     3030   else do:
     3031      assign re-querybr-attrs = yes.
     3032      run sort-brbr-attrs
     3033        (input (if available X_c-fin-doc-attr
     3034                then recid(X_c-fin-doc-attr)
     3035                else ?
     3036               )
     3037        ).
     3038      assign re-querybr-attrs = no.
     3039   end.
     3040   end.
     3041   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3042   do:
     3043     br-attrs :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3044   end.
     3045   MAIN-BLOCK:
     3046   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3047      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3048    if LOOKUP(p-mode, 'one':U,
     3049                   chr(4)) = 0
     3050        then dO:
     3051       message
     3052       vss-workfile vss-revision vss-description skip
     3053       "Неверное значение параметров вызова p-mode"
     3054       p-mode
     3055       view-as alert-box ERROR.
     3056       return error .
     3057    end.
     3058    if p-mode = "one":U then do:
     3059     find first X_fin-doc-attr no-lock where
     3060                   X_fin-doc-attr.host-code = p-host-code
     3061               AND X_fin-doc-attr.fin-doc-code = p-fin-doc-code
     3062               AND X_fin-doc-attr.attr-code = p-attr-code  no-error.
     3063       if not available X_fin-doc-attr then do:
     3064           message
     3065           vss-workfile vss-revision vss-description skip
     3066           "Неверное значение параметра вызова p-host-code и/или p-fin-doc-code и/или p-attr-code"
     3067           view-as alert-box ERROR.
     3068           return.
     3069       end.
     3070     end.
     3071   v-rid-list = p-rid-list.
     3072   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3073   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3074     (output v-db-num
     3075     )  .
     3076     RUN MyEnable.
     3077     RUn OpenBR.
     3078     HIDE mark-num in frame Dialog-Frame .
     3079     if v-doc-rec <> ? then
     3080     REPOSITION br-attrs to recid v-doc-rec No-ERROR.
     3081   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3082   DEF VAR cur-clmn-numbr-attrs as INT EXTENT 4 no-undo.
     3083   DEF VAR varmvibr-attrs       as INT no-undo.
     3084   DEF VAR varmvjbr-attrs       as INT no-undo.
     3085   DEF VAR varmvkbr-attrs       as INT no-undo.
     3086   DEF VAR varmvlbr-attrs       as INT no-undo.
     3087   DEF VAR move-elementbr-attrs as INT no-undo.
     3088   def var jjbr-attrs           as int no-undo.
     3089   do varmvibr-attrs = 1 to EXTENT(cur-clmn-numbr-attrs):
     3090     ASSIGN cur-clmn-numbr-attrs[varmvibr-attrs] = varmvibr-attrs.
     3091   END.
     3092   RUN start-mv-clmnbr-attrs.
     3093   PROCEDURE start-mv-clmnbr-attrs:
     3094   def var old-session as logical no-undo.
     3095      old-session = SESSION:IMMEDIATE-DISPLAY.
     3096      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3097          IF  p-mode = 'one'  THEN DO:
     3098      DO jjbr-attrs = NUM-ENTRIES('1,2,3,4') TO 1 BY -1:
     3099        RUN re-move-clmnbr-attrs ( cur-clmn-numbr-attrs[INTEGER(ENTRY (jjbr-attrs, '1,2,3,4'))] , 1).
     3100      END.
     3101          END.
     3102      SESSION:IMMEDIATE-DISPLAY = old-session.
     3103   END.
     3104   ON ctrl-cursor-right OF BROWSE br-attrs do:
     3105     RUN re-move-clmnbr-attrs ( 1, 4).
     3106   END.
     3107   ON ctrl-cursor-left OF BROWSE br-attrs do:
     3108     RUN re-move-clmnbr-attrs (4, 1).
     3109   END.
     3110   PROCEDURE re-move-clmnbr-attrs:
     3111     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3112     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3113     DO varmvibr-attrs = 1 TO EXTENT(cur-clmn-numbr-attrs):
     3114       if cur-clmn-numbr-attrs[varmvibr-attrs] = source-column THEN cur-clmn-numbr-attrs[varmvibr-attrs] = -1.
     3115     END.
     3116     if br-attrs:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3117     if source-column > target-column THEN
     3118     DO varmvjbr-attrs = source-column - 1 to target-column BY -1:
     3119       DO varmvibr-attrs = 1 TO EXTENT(cur-clmn-numbr-attrs):
     3120           if cur-clmn-numbr-attrs[varmvibr-attrs] = varmvjbr-attrs THEN DO:
     3121             cur-clmn-numbr-attrs[varmvibr-attrs] = cur-clmn-numbr-attrs[varmvibr-attrs] + 1.
     3122           END.
     3123       END.
     3124     END.
     3125     ELSE
     3126     DO varmvjbr-attrs = source-column + 1 to target-column:
     3127       DO varmvibr-attrs = 1 TO EXTENT(cur-clmn-numbr-attrs):
     3128         if cur-clmn-numbr-attrs[varmvibr-attrs] = varmvjbr-attrs THEN DO:
     3129           cur-clmn-numbr-attrs[varmvibr-attrs] = cur-clmn-numbr-attrs[varmvibr-attrs] - 1.
     3130         END.
     3131       END.
     3132     END.
     3133     DO varmvibr-attrs = 1 TO EXTENT(cur-clmn-numbr-attrs):
     3134       if cur-clmn-numbr-attrs[varmvibr-attrs] = -1 THEN cur-clmn-numbr-attrs[varmvibr-attrs] = target-column.
     3135     END.
     3136   END PROCEDURE.
     3137   PROCEDURE ch-clmnbr-attrs:
     3138     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3139     if cur-clmn-loc <= 1 then do:
     3140       return .
     3141     end.
     3142     DO varmvibr-attrs = 1 TO EXTENT(cur-clmn-numbr-attrs):
     3143       if cur-clmn-numbr-attrs[varmvibr-attrs] = cur-clmn-loc THEN move-elementbr-attrs = varmvibr-attrs.
     3144     END.
     3145     RUN re-move-clmnbr-attrs (cur-clmn-loc, 1).
     3146   END PROCEDURE.
     3147   PROCEDURE mv-brw-defaultbr-attrs:
     3148   def var old-session as logical no-undo.
     3149     old-session = SESSION:IMMEDIATE-DISPLAY.
     3150     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3151     do varmvlbr-attrs = 1 to EXTENT(cur-clmn-numbr-attrs):
     3152       RUN re-move-clmnbr-attrs (cur-clmn-numbr-attrs[varmvlbr-attrs], varmvlbr-attrs).
     3153     END.
     3154     RUN start-mv-clmnbr-attrs.
     3155     SESSION:IMMEDIATE-DISPLAY = old-session.
     3156   END PROCEDURE.
     3157   .
     3158    run diasize_add_browse in this-procedure
     3159       (input  'width':u
     3160       ,input  browse br-changes :handle
     3161       ) .
     3162    run diasize_init in this-procedure .
     3163   WAIT-FOR GO OF FRAME Dialog-Frame.
     3164   END.
     3165   RUN disable_UI.
     3166   PROCEDURE disable_UI :
     3167     HIDE FRAME Dialog-Frame.
     3168   END PROCEDURE.
     3169   PROCEDURE enable_UI :
     3170     DISPLAY mark-num F-host-code F-fin-doc-code F-attr-label
     3171         WITH FRAME Dialog-Frame.
     3172     ENABLE b-quit B-mark B-sel B-Help br-attrs BR-changes mark-num F-host-code
     3173            F-fin-doc-code F-attr-label
     3174         WITH FRAME Dialog-Frame.
     3175     VIEW FRAME Dialog-Frame.
     3176     OPEN QUERY br-attrs FOR EACH X_c-fin-doc-attr NO-LOCK INDEXED-REPOSITION.
     3177   END PROCEDURE.
     3178   PROCEDURE MyEnable :
     3179   DEFINE VARIABLE v-tooltip AS CHARACTER NO-UNDO.
     3180   IF p-attr-code <> "":U  THEN DO:
     3181     run fd-attr-tooltip in this-procedure (
     3182                 input  p-attr-code
     3183                 ,output v-tooltip
     3184                 ,output f-attr-label
     3185                 ) no-error .
     3186   END.
     3187   ASSIGN
     3188   f-host-code = p-host-code
     3189   f-fin-doc-code = p-fin-doc-code
     3190   .
     3191   assign
     3192   temp-changes.l_name:resizable in browse br-changes = true
     3193   temp-changes.v_old:resizable in browse br-changes = true
     3194   temp-changes.v_new:resizable in browse br-changes = true
     3195   temp-changes.l_name:width in browse br-changes = 30
     3196   temp-changes.v_old:width in browse br-changes = 40
     3197   temp-changes.v_new:width in browse br-changes = 40
     3198   .
     3199   DISPLAY mark-num
     3200   f-host-code
     3201   f-fin-doc-code
     3202   f-attr-label WHEN p-attr-code <> '':U
     3203   WITH FRAME Dialog-Frame.
     3204   ENABLE
     3205   b-quit
     3206   B-mark when LOOKUP("b-mark":U, bttns) > 0
     3207   B-sel when LOOKUP("b-sel":U, bttns) > 0
     3208   B-Help
     3209   br-attrs mark-num
     3210   br-changes
     3211   with FRAME Dialog-Frame.
     3212   VIEW FRAME Dialog-Frame.
     3213   END PROCEDURE.
     3214   PROCEDURE OpenBr :
     3215   OPEN QUERY br-attrs FOR EACH X_c-fin-doc-attr NO-LOCK where
     3216                                  X_c-fin-doc-attr.host-code = p-host-code
     3217                              AND X_c-fin-doc-attr.fin-doc-code = p-fin-doc-code
     3218                              AND X_c-fin-doc-attr.attr-code = p-attr-code
     3219                              AND X_c-fin-doc-attr.corr-user-db-num = 0
     3220                                 INDEXED-REPOSITION.
     3221   APPLY "VALUE-CHANGED" TO br-attrs in frame Dialog-Frame.
     3222   APPLY "ENTRY" TO br-attrs.
     3223   END PROCEDURE.
     3224   PROCEDURE proc-br-attrs :
     3225   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3226   if b-sel:sensitive in frame Dialog-Frame then dO:
     3227       if b-mark:sensitive then do:
     3228           apply "choose" to b-mark in frame Dialog-Frame.
     3229       end.
     3230       else do:
     3231           apply "choose" to b-sel in frame Dialog-Frame.
     3232       end.
     3233   end.
     3234   else do:
     3235       if b-lookup:sensitive then
     3236       apply "choose" to b-lookup in frame Dialog-Frame.
     3237   end.
     3238   END PROCEDURE.
     3239   PROCEDURE proc-view-changes :
     3240   define variable v-tooltip as character no-undo .
     3241   define variable v-label   as character no-undo .
     3242   define variable v-description as character no-undo .
     3243   for each temp-changes:
     3244       delete temp-changes.
     3245   END.
     3246   if not available X_c-fin-doc-attr then do:
     3247     Open QUery br-changes for each temp-changes.
     3248     return.
     3249   end.
     3250     run fd-attr-tooltip in this-procedure (
     3251                 input  X_c-fin-doc-attr.attr-code
     3252                 ,output v-tooltip
     3253                 ,output v-label
     3254                 ) no-error .
     3255     assign
     3256     v-description = "Атрибут" + chr(32) + v-label
     3257     .
     3258   define variable v-label-param as character no-undo .
     3259   v-label-param =
     3260     "attr-code" + chr(4) + "Атрибут" + chr(4) + "" + chr(8)
     3261    + "attr-value" + chr(4) + "Значение" + chr(4) + ""  .
     3262    run proc-full-temp-changes in this-procedure (
     3263                                                input  buffer X_c-fin-doc-attr:handle
     3264                                               ,input  'fin-doc-attr':U
     3265                                               ,input  "attr-code,attr-value"
     3266                                               ,input  v-label-param).
     3267   if p-attr-code = '':U then do:
     3268     hide br-changes
     3269     in frame Dialog-Frame .
     3270     assign
     3271     br-changes:title in frame Dialog-Frame = v-description
     3272     .
     3273     Open QUery br-changes for each temp-changes.
     3274     display
     3275     br-changes
     3276     with frame Dialog-Frame .
     3277   end.
     3278   else do:
     3279     Open QUery br-changes for each temp-changes.
     3280   end.
     3281   END PROCEDURE.
