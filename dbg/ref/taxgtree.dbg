        1   DEFINE TEMP-TABLE tt-tax-rate-value NO-UNDO LIKE ub.tax-rate-value
        2          field rc as recid
        3          field exp as logical
        4          index pi is unique primary
        5          tax-code
        6          rate-code
        7          host-code
        8          obj-type
        9          obj-code
       10          fact-order
       11          index irc is unique
       12          rc.
       13     define temp-table  tt-tax no-undo
       14   field tax-code    like ub.tax.tax-code
       15   FIELD individual  like ub.tax.individual
       16   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
       17   field rate-code   like ub.tax-rate.rate-code
       18   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
       19   FIELD tax-type    like ub.tax.tax-type
       20   field rate-value  like ub.tax-rate-value.rate-value
       21   FIELD tax-rate-gds-rc  as recid
       22   FIELD to-cashdesk like ub.tax.to-cashdesk
       23   FIELD fact-date like ub.tax-rate-value.fact-date
       24   FIELD fact-order like ub.tax-rate-value.fact-order
       25   FIELD next-order like ub.tax-rate-value.fact-order
       26   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
       27   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
       28   FIELD corr-date like ub.tax-rate-gds.corr-date
       29   FIELD corr-time like ub.tax-rate-gds.corr-time
       30   index tax-code is unique primary tax-code fact-order descending rate-code.
       31     DEFINE INPUT PARAMETER TABLE FOR tt-tax.
       32     define temp-table  output-tax no-undo
       33   field tax-code    like ub.tax.tax-code
       34   FIELD individual  like ub.tax.individual
       35   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
       36   field rate-code   like ub.tax-rate.rate-code
       37   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
       38   FIELD tax-type    like ub.tax.tax-type
       39   field rate-value  like ub.tax-rate-value.rate-value
       40   FIELD tax-rate-gds-rc  as recid
       41   FIELD to-cashdesk like ub.tax.to-cashdesk
       42   FIELD fact-date like ub.tax-rate-value.fact-date
       43   FIELD fact-order like ub.tax-rate-value.fact-order
       44   FIELD next-order like ub.tax-rate-value.fact-order
       45   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
       46   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
       47   FIELD corr-date like ub.tax-rate-gds.corr-date
       48   FIELD corr-time like ub.tax-rate-gds.corr-time
       49   index tax-code is unique primary tax-code fact-order descending rate-code.
       50     DEFINE OUTPUT PARAMETER TABLE FOR output-tax.
       51   DEFINE INPUT PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
       52   DEFINE INPUT PARAMETER parlist-mode as character no-undo.
       53   DEFINE INPUT PARAMETER partable-mode as character no-undo.
       54   DEFINE INPUT PARAMETER pargds-code like ub.goods.gds-code no-undo.
       55   DEFINE INPUT PARAMETER parnode-code like ub.gds-grp.node-code no-undo.
       56   DEFINE INPUT PARAMETER parhost-code like ub.sysconf.host-code no-undo.
       57   DEFINE INPUT PARAMETER parobj-type like ub.clients.obj-type no-undo.
       58   DEFINE INPUT PARAMETER parobj-code like ub.clients.obj-code no-undo.
       59   DEFINE INPUT PARAMETER par-title as character no-undo .
       60   define variable vss-revision    as character no-undo init "$Revision$":U .
       61   define variable vss-author      as character no-undo init "$Author$":U .
       62   define variable vss-date        as character no-undo init "$Date$":U .
       63   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       64   define variable vss-archive     as character no-undo init "$Archive$":U .
       65   define variable vss-description as character no-undo init "Дерево ставок налогов".
       66   procedure vss-get-info :
       67     define output parameter p-vss-revision    like vss-revision    no-undo .
       68     define output parameter p-vss-author      like vss-author      no-undo .
       69     define output parameter p-vss-date        like vss-date        no-undo .
       70     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       71     define output parameter p-vss-archive     like vss-archive     no-undo .
       72     define output parameter p-vss-description like vss-description no-undo .
       73     assign
       74       p-vss-revision    = vss-revision
       75       p-vss-author      = vss-author
       76       p-vss-date        = vss-date
       77       p-vss-workfile    = vss-workfile
       78       p-vss-archive     = vss-archive
       79       p-vss-description = vss-description
       80     .
       81   end procedure.
       82   procedure vss-get-parameters :
       83     define output parameter p-vss-parameters as character no-undo .
       84   end procedure.
       85   define new global shared variable g#vssrevis-logger as handle    no-undo .
       86   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       87   define variable v-vssrevis-logger                   as handle    no-undo .
       88   procedure vss-logevent :
       89     define input  parameter p-extra-paramters as character no-undo .
       90     define variable v-vssrevis-parameters as character no-undo .
       91     do
       92     on error undo, return error return-value
       93     :
       94       if  valid-handle(v-vssrevis-logger)
       95       and v-vssrevis-logger :get-signature("logevent") <> ""
       96       then do:
       97         run vss-get-parameters in this-procedure
       98           (output v-vssrevis-parameters
       99           ).
      100         run logevent in v-vssrevis-logger
      101           (input vss-workfile
      102           ,input vss-revision
      103           ,input v-vssrevis-parameters
      104           ,input p-extra-paramters
      105           ).
      106       end.
      107     end.
      108   end procedure.
      109   assign
      110     v-vssrevis-logger = g#vssrevis-logger
      111   .
      112   if  valid-handle(v-vssrevis-logger)
      113   and v-vssrevis-logger :get-signature("logevent") <> ""
      114   then do:
      115     assign
      116       v-vssrevis-logevent = true
      117     .
      118     run vss-logevent in this-procedure (input vss-description) .
      119   end.
      120   define new global shared variable g#language as character no-undo .
      121   if g#language <> '' and g#language <> 'rus':U then do:
      122     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      123   end.
      124   define new global shared variable g#library  as handle no-undo .
      125   define new global shared variable g#library2 as handle no-undo .
      126   define   shared variable g#auto as logical no-undo.
      127   define   shared variable g#news as logical no-undo.
      128   define   shared variable g#oxml as logical no-undo.
      129   define   shared variable g#esys as logical no-undo.
      130   define   shared variable g#news-source-db as integer no-undo.
      131   define   shared variable g#esys-source-esys as integer no-undo.
      132   define   shared variable g#db-num as integer   no-undo .
      133   define   shared variable g#userid as character no-undo .
      134   define   shared variable g#passwd as character no-undo .
      135   procedure proc-alt-shift-f2:
      136     if not ibs.th.gbl.gbl-var:rcode
      137   then
      138     run gbl\inidebug.p .
      139   end.
      140   procedure proc-alt-shift-f3:
      141     run gbl/prvssinf.p
      142       ( input this-procedure
      143       ) .
      144   end.
      145   define variable v-inform-launched as logical no-undo initial false .
      146   procedure proc-alt-shift-f4:
      147     define variable v-action as character no-undo .
      148     if v-inform-launched = false then do:
      149       assign
      150         v-inform-launched = true
      151       .
      152       run gbl/d-inform.w
      153         (  input self
      154         ,  input this-procedure
      155         , output v-action
      156         ) no-error .
      157       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      158       assign
      159         v-inform-launched = false
      160       .
      161     end.
      162   end.
      163   procedure proc-alt-f1:
      164     run gbl/corrhelp.p
      165       (input this-procedure
      166       ) .
      167   end .
      168   on alt-shift-f2 anywhere do:
      169     run proc-alt-shift-f2.
      170   end.
      171   on alt-shift-f3 anywhere do:
      172     run proc-alt-shift-f3 in this-procedure .
      173   end.
      174   on alt-shift-f4 anywhere do:
      175     run proc-alt-shift-f4 in this-procedure.
      176   end.
      177   on alt-f1 anywhere do:
      178     run proc-alt-f1 in this-procedure .
      179   end.
      180   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      181   procedure factord :
      182     define input  parameter p-fact-date            as date    no-undo .
      183     define input  parameter p-fact-time            as integer no-undo .
      184     define input  parameter p-fact-num             as integer no-undo .
      185     define input  parameter p-shift-date           as date    no-undo .
      186     define input  parameter p-shift-num            as integer no-undo .
      187     define input  parameter p-shift-on             as logical no-undo .
      188     define output parameter p-fact-order           as decimal no-undo .
      189     define output parameter p-shift-end-fact-order as decimal no-undo .
      190     define output parameter p-day-end-fact-order   as decimal no-undo .
      191     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      192     if p-fact-date = ?
      193     then do:
      194       return error "Не указана фактическая дата" .
      195     end.
      196     define variable v-fact-date-num as integer no-undo .
      197     assign
      198       v-fact-date-num = integer(p-fact-date)
      199     .
      200     if p-fact-num = ?
      201     or p-fact-num = 0
      202     then do:
      203       return error "Не задан p-fact-num " + string(p-fact-num) .
      204     end.
      205     if p-fact-num < 0
      206     then do:
      207       return error "Отрицательный fact-num " + string(p-fact-num) .
      208     end.
      209     if p-fact-num >= 100000000
      210     then do:
      211       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      212     end.
      213     if p-shift-on = true
      214     then do:
      215       if p-shift-date = ?
      216       then do:
      217         return error "Не задана дата смены" .
      218       end.
      219       if p-shift-num = ?
      220       or p-shift-num = 0
      221       then do:
      222         return error "Не задан номер смены" .
      223       end.
      224     end.
      225     else do:
      226       assign
      227         p-shift-date = p-fact-date
      228         p-shift-num  = 24
      229       .
      230     end.
      231     define variable v-shift-offset as integer no-undo .
      232     if p-shift-date = p-fact-date
      233     then do:
      234       assign
      235         v-shift-offset = 1
      236       .
      237     end.
      238     if p-shift-date < p-fact-date
      239     then do:
      240       assign
      241         v-shift-offset = 0
      242       .
      243     end.
      244     if p-shift-date > p-fact-date
      245     then do:
      246       message
      247         vss-workfile vss-revision vss-description skip
      248         "Неправильная дата закрытия смены" skip
      249         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      250         view-as alert-box error .
      251       undo, return error
      252         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      253           ,string(p-fact-date, '99/99/9999':U)
      254           ,string(p-shift-date, '99/99/9999':U)
      255           )
      256       .
      257     end.
      258     if p-shift-num < 1
      259     or p-shift-num > 24
      260     then do:
      261       message
      262         vss-workfile vss-revision vss-description skip
      263         "Неправильный номер смены" skip
      264         "p-shift-num" p-shift-num skip
      265         view-as alert-box error .
      266       undo, return error return-value .
      267     end.
      268     assign
      269       p-fact-order           = v-fact-date-num
      270                              + v-shift-offset * 0.5
      271                              + p-shift-num    * 0.02 - 0.01
      272                              + p-fact-num     * 0.0000000001
      273       p-shift-end-fact-order = v-fact-date-num
      274                              + v-shift-offset * 0.5
      275                              + p-shift-num    * 0.02
      276       p-day-end-fact-order   = v-fact-date-num
      277                              + 0.99
      278     .
      279     if p-fact-order           <= v-fact-date-num
      280     or p-shift-end-fact-order <= v-fact-date-num
      281     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      282     or p-shift-end-fact-order >= p-day-end-fact-order
      283     then do:
      284       message
      285         vss-workfile vss-revision vss-description skip
      286         "Внутренняя ошибка при генерации фактического номера" skip
      287         "p-fact-date"            p-fact-date            skip
      288         "p-fact-time"            p-fact-time            skip
      289         "p-fact-num"             p-fact-num             skip
      290         "p-shift-date"           p-shift-date           skip
      291         "p-shift-num"            p-shift-num            skip
      292         "p-shift-on"             p-shift-on             skip
      293         "p-shift-end-fact-order" p-shift-end-fact-order skip
      294         "p-day-end-fact-order"   p-day-end-fact-order   skip
      295         "v-fact-date-num"        v-fact-date-num        skip
      296         view-as alert-box error .
      297       undo, return error return-value .
      298     end.
      299   end procedure.
      300   procedure day-begin-fact-order :
      301     define input  parameter p-fact-date            as date    no-undo .
      302     define output parameter p-day-begin-fact-order as decimal no-undo .
      303     do
      304     on error undo, return error return-value
      305     :
      306       if p-fact-date = ?
      307       then do:
      308         assign
      309           p-day-begin-fact-order = 0
      310         .
      311       end.
      312       else do:
      313         assign
      314           p-day-begin-fact-order = integer(p-fact-date)
      315         .
      316       end.
      317     end.
      318   end procedure.
      319   procedure factord-max-fact-order :
      320     define output parameter p-max-fact-order as decimal   no-undo .
      321     do
      322     on error undo, return error return-value
      323     :
      324       run day-begin-fact-order in this-procedure
      325         (input  date(1, 1, 5000)
      326         ,output p-max-fact-order
      327         ) .
      328     end.
      329   end procedure.
      330   procedure factord-cut-archive :
      331     define input  parameter p-obj-type             as character no-undo .
      332     define input  parameter p-obj-code             as integer   no-undo .
      333     define input  parameter p-fact-date            as date      no-undo .
      334     define output parameter p-shift-on             as logical   no-undo .
      335     define output parameter p-shift-date           as date      no-undo .
      336     define output parameter p-shift-num            as integer   no-undo .
      337     define output parameter p-day-end-fact-order   as decimal   no-undo .
      338     define output parameter p-shift-end-fact-order as decimal   no-undo .
      339     define variable v-fact-order as decimal   no-undo .
      340     define buffer buf_shift-obj for ub.shift-obj .
      341     do
      342     on error undo, return error return-value
      343     :
      344   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      345   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      346     (input  p-obj-type
      347     ,input  p-obj-code
      348     ,input  'shift-on=request'
      349     ,output p-shift-on
      350     ) no-error .
      351       if error-status :error
      352       then do:
      353         message
      354           vss-workfile vss-revision vss-description skip
      355           "Ошибка при определении атрибута объекта" skip
      356           "Объект" p-obj-type p-obj-code skip
      357           error-status :get-message(1) skip
      358           return-value skip
      359           view-as alert-box error .
      360         undo, return error return-value .
      361       end.
      362       if p-shift-on = false
      363       then do:
      364         assign
      365           p-shift-date               = ?
      366           p-shift-num                = 0
      367         .
      368       end.
      369       else do:
      370         find first buf_shift-obj share-lock
      371           where buf_shift-obj.obj-type   = p-obj-type
      372             and buf_shift-obj.obj-code   = p-obj-code
      373             and buf_shift-obj.shift-date > p-fact-date
      374           use-index pi
      375           no-error .
      376         if not available buf_shift-obj
      377         or buf_shift-obj.status_ <> 'зкр':U
      378         then do:
      379           message
      380             vss-workfile vss-revision vss-description skip
      381             "Невозможно вычислить последнюю смену" skip
      382             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      383             "Объект" p-obj-type p-obj-code skip
      384             "Дата" p-fact-date skip
      385             view-as alert-box error .
      386           undo, return error return-value .
      387         end.
      388         find last buf_shift-obj share-lock
      389           where buf_shift-obj.obj-type = p-obj-type
      390             and buf_shift-obj.obj-code = p-obj-code
      391             and buf_shift-obj.shift-date <= p-fact-date
      392           use-index pi
      393           no-error .
      394         if available buf_shift-obj
      395         then do:
      396           if  buf_shift-obj.status_ = 'зкр':U
      397           then do:
      398             assign
      399               p-shift-date = buf_shift-obj.shift-date
      400               p-shift-num  = buf_shift-obj.shift-num
      401             .
      402           end.
      403           else do:
      404             message
      405               vss-workfile vss-revision vss-description skip
      406               "Невозможно вычислить последнюю смену" skip
      407               "Статус смены отличен от статуса" 'зкр':U skip
      408               "Объект" p-obj-type p-obj-code skip
      409               "Дата" p-fact-date skip
      410               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      411               view-as alert-box error .
      412             undo, return error return-value .
      413           end.
      414         end.
      415         else do:
      416           assign
      417             p-shift-date = p-fact-date - 1
      418             p-shift-num  = 1
      419           .
      420         end.
      421       end.
      422       run factord in this-procedure
      423         (input  p-fact-date
      424         ,input  1
      425         ,input  1
      426         ,input  p-shift-date
      427         ,input  p-shift-num
      428         ,input  p-shift-on
      429         ,output v-fact-order
      430         ,output p-shift-end-fact-order
      431         ,output p-day-end-fact-order
      432         ) no-error .
      433       if error-status :error
      434       then do:
      435         message
      436           vss-workfile vss-revision vss-description skip
      437           "Ошибка при вызове процедуры factord"
      438           error-status :get-message(1) skip
      439           return-value skip
      440           view-as alert-box error .
      441         undo, return error return-value .
      442       end.
      443     end.
      444   end procedure.
      445   procedure factord-lock-shift :
      446     define input  parameter p-obj-type  as character no-undo .
      447     define input  parameter p-obj-code  as integer   no-undo .
      448     define input  parameter p-fact-date as date      no-undo .
      449     define parameter buffer buf_shift-obj for ub.shift-obj .
      450     define variable v-shift-on      as logical   no-undo .
      451     define variable v-extra-message as character no-undo .
      452     define variable v-error as character no-undo .
      453     do
      454     on error undo, return error return-value
      455     :
      456   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      457   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      458     (input  p-obj-type
      459     ,input  p-obj-code
      460     ,input  'shift-on=request'
      461     ,output v-shift-on
      462     ) no-error .
      463       if error-status :error
      464       then do:
      465         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      466         undo, return error v-error .
      467       end.
      468       if v-shift-on = true
      469       then do:
      470         find first buf_shift-obj share-lock
      471           where buf_shift-obj.obj-type   = p-obj-type
      472             and buf_shift-obj.obj-code   = p-obj-code
      473             and buf_shift-obj.shift-date > p-fact-date
      474           use-index pi
      475           no-error .
      476         if not available buf_shift-obj
      477         or buf_shift-obj.status_ <> 'зкр':U
      478         then do:
      479           find last buf_shift-obj
      480             where buf_shift-obj.obj-type = p-obj-type
      481               and buf_shift-obj.obj-code = p-obj-code
      482               and buf_shift-obj.status_  = 'зкр':U
      483             use-index stts
      484             no-error .
      485           if available buf_shift-obj
      486           then do:
      487             assign
      488               v-extra-message =
      489                     substitute("Дата начала последеней закрытой смены на объекте &1"
      490                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      491                               )
      492             .
      493           end.
      494           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      495           undo, return error v-error .
      496         end.
      497       end.
      498     end.
      499   end procedure.
      500   procedure factord-end-day :
      501     define input  parameter p-fact-date            as date    no-undo .
      502     define output parameter p-day-end-fact-order   as decimal no-undo .
      503     do
      504     on error undo, return error return-value
      505     :
      506       if p-fact-date = ?
      507       then do:
      508         return error "Не указана фактическая дата" .
      509       end.
      510       assign
      511         p-day-end-fact-order = integer(p-fact-date) + 0.99
      512       .
      513     end.
      514   end procedure.
      515   procedure factord-to-date :
      516     define input  parameter p-fact-order as decimal no-undo .
      517     define output parameter p-fact-date  as date    no-undo .
      518     define variable v-ref-date  as date      no-undo .
      519     define variable v-ref-delta as integer   no-undo .
      520     do
      521     on error undo, return error return-value
      522     :
      523       if p-fact-order = ?
      524       or p-fact-order = 0
      525       then do:
      526         return error "Не указан fact-order" .
      527       end.
      528       assign
      529         v-ref-date  = date(1, 1, 2000)
      530       .
      531       assign
      532         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      533       .
      534       assign
      535         p-fact-date = v-ref-date + v-ref-delta
      536       .
      537     end.
      538   end procedure.
      539   procedure factord-to-fact-num :
      540     define input  parameter p-fact-order as decimal no-undo .
      541     define output parameter p-fact-num   as integer no-undo .
      542     define variable v-fact-order-trunc as decimal no-undo .
      543     do
      544     on error undo, return error return-value
      545     :
      546       if p-fact-order = ?
      547       or p-fact-order = 0
      548       then do:
      549         return error "Не указан fact-order" .
      550       end.
      551       assign
      552        v-fact-order-trunc = truncate(p-fact-order, 2)
      553       .
      554       assign
      555         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      556       .
      557     end.
      558   end procedure.
      559   procedure factord-to-shift-num :
      560     define input  parameter p-fact-order as decimal no-undo .
      561     define output parameter p-shift-num   as integer no-undo .
      562     define variable  p-shift-numd  as decimal   no-undo .
      563     define variable v-fact-order-trunc as decimal no-undo .
      564     do
      565     on error undo, return error return-value
      566     :
      567       if p-fact-order = ?
      568       or p-fact-order = 0
      569       then do:
      570         return error "Не указан fact-order" .
      571       end.
      572       assign
      573        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      574       .
      575       if v-fact-order-trunc < 0.5 then do:
      576         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      577       end.
      578       assign
      579         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      580         .
      581        assign
      582         p-shift-num = truncate (p-shift-numd , 0)
      583       .
      584     end.
      585   end procedure.
