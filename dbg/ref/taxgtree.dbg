      622   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      623   procedure cur-time :
      624      define output parameter p-today as date      no-undo .
      625      define output parameter p-time  as integer   no-undo .
      626     do
      627     on error undo, return error
      628     :
      629       define variable v-date1 as date      no-undo .
      630       define variable v-date2 as date      no-undo .
      631       define variable v-time  as integer   no-undo .
      632       assign
      633         v-date1 = today
      634         v-time  = time
      635         v-date2 = today
      636       .
      637       if v-date1 <> v-date2
      638       then do:
      639         assign
      640           v-date1 = today
      641           v-time  = v-time
      642         .
      643       end.
      644       assign
      645         p-today = v-date1
      646         p-time  = v-time
      647       .
      648     end.
      649   end.
      650   function cur-time-date returns character
      651   :
      652     return string(today, '99/99/9999':U) .
      653   end.
      654   function cur-time-mjd returns decimal
      655   :
      656     define variable v-date as date      no-undo .
      657     define variable v-time as integer   no-undo .
      658     run cur-time in this-procedure
      659       (output v-date
      660       ,output v-time
      661       ) .
      662     return integer(v-date) - 2400002 + (v-time / 86400) .
      663   end.
      664   function cur-time-get-ending-index returns integer
      665   (input p-number as integer
      666   )
      667   :
      668     if p-number < 0
      669     or p-number = ?
      670     then do:
      671       return 1 .
      672     end.
      673     define variable v-rest as integer   no-undo .
      674     assign
      675       p-number = p-number modulo 100
      676     .
      677     if p-number < 20
      678     then do:
      679       assign
      680         v-rest = p-number
      681       .
      682     end.
      683     else do:
      684       assign
      685         v-rest = p-number modulo 10
      686       .
      687     end.
      688     case v-rest :
      689       when 1
      690       then do:
      691         return 2 .
      692       end.
      693       when 2 or
      694       when 3 or
      695       when 4
      696       then do:
      697         return 3 .
      698       end.
      699       otherwise do:
      700         return 1 .
      701       end.
      702     end case .
      703   end.
      704   procedure cur-time-mjd-to-date :
      705      define input  parameter i-mjd-diff as decimal no-undo.
      706      define output parameter o-Date     as date    no-undo.
      707      define output parameter o-Time     as integer no-undo.
      708      define variable v-day-number as integer   no-undo .
      709      if    i-mjd-diff < 0
      710         or i-mjd-diff = ?
      711      then do:
      712         return "?" .
      713      end.
      714      assign
      715         v-day-number = truncate(i-mjd-diff,0).
      716         o-Date = date(v-day-number + 2400002).
      717         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      718     .
      719   end.
      720   function cur-time-mjd-to-string returns character
      721   (input p-mjd-diff as decimal
      722   )
      723   :
      724     define variable v-day-number as integer   no-undo .
      725     define variable v-seconds    as integer   no-undo .
      726     define variable v-hour       as integer   no-undo .
      727     define variable v-min        as integer   no-undo .
      728     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      729     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      730     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      731     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      732     if p-mjd-diff < 0
      733     or p-mjd-diff = ?
      734     then do:
      735       return "?" .
      736     end.
      737     assign
      738       v-day-number = integer(truncate(p-mjd-diff,0))
      739       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      740     .
      741     if v-seconds > 86400
      742     then do:
      743       assign
      744         v-seconds = 86400 - 1
      745       .
      746     end.
      747     if v-seconds < 0
      748     then do:
      749       assign
      750         v-seconds = 0
      751       .
      752     end.
      753     assign
      754       v-hour = truncate(v-seconds / 3600, 0)
      755     .
      756     assign
      757       v-seconds = v-seconds modulo 3600
      758     .
      759     assign
      760       v-min = truncate(v-seconds / 60, 0)
      761     .
      762     assign
      763       v-seconds = v-seconds modulo 60
      764     .
      765     return
      766         (if v-day-number <> 0
      767           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      768           else ""
      769         )
      770       + (if v-day-number <> 0 or v-hour <> 0
      771           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      772           else ""
      773         )
      774       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      775           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      776           else ""
      777         )
      778       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      779       .
      780   end.
      781   function cur-time-string returns character
      782   :
      783     define variable v-date as date      no-undo .
      784     define variable v-time as integer   no-undo .
      785     run cur-time in this-procedure
      786       (output v-date
      787       ,output v-time
      788       ) .
      789     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      790   end.
      791   function cur-time-string-sec returns character
      792   :
      793     define variable v-date as date      no-undo .
      794     define variable v-time as integer   no-undo .
      795     run cur-time in this-procedure
      796       (output v-date
      797       ,output v-time
      798       ) .
      799     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      800   end.
      801   function cur-time-custom  returns character
      802   (input p-prefix as character
      803   ,input p-date-format as character
      804   ,input p-delimiter as character
      805   ,input p-time-format as character
      806   ,input p-suffix as character
      807   )
      808   :
      809     define variable v-date as date      no-undo .
      810     define variable v-time as integer   no-undo .
      811     run cur-time in this-procedure
      812       (output v-date
      813       ,output v-time
      814       ) .
      815     return
      816       p-prefix
      817       + string(v-date, p-date-format)
      818       + p-delimiter
      819       + string(v-time, p-time-format)
      820       + p-suffix
      821       .
      822   end.
      823   function cur-time-print  returns character
      824   :
      825     define variable v-date as date      no-undo .
      826     define variable v-time as integer   no-undo .
      827     run cur-time in this-procedure
      828       (output v-date
      829       ,output v-time
      830       ) .
      831     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      832   end.
      833   function cur-time-datetime returns datetime
      834   :
      835     define variable v-char as character no-undo .
      836     define variable v-datetime as datetime no-undo .
      837     v-char = cur-time-string().
      838     v-datetime = datetime(v-char).
      839     return  v-datetime.
      840   end.
      841   function cur-time-string-msec returns character
      842   :
      843     define variable v-date as datetime  no-undo .
      844     v-date = now.
      845     return string(v-date) .
      846   end.
      847   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      848   FUNCTION get-region RETURNS CHARACTER
      849     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      850     define variable par-region as character no-undo.
      851     if parhost-code = 0 and
      852          parobj-type = "":U and
      853          parobj-code = 0 then do:
      854          par-region = "Глобально".
      855          return par-region.
      856       end.
      857       if parobj-type = 'орг':U then do:
      858          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      859          return par-region.
      860       end.
      861       if parobj-type = 'регион':U
      862       then do:
      863          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      864          return par-region.
      865       end.
      866       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      867       return par-region.
      868   END FUNCTION.
      869   FUNCTION get-objregion RETURNS CHARACTER
      870     (  input parobj-type as character, input parobj-code as integer ) :
      871     define variable par-region as character no-undo.
      872     if  parobj-type = "":U and
      873         parobj-code = 0
      874     then do:
      875        par-region = "Глобально".
      876     end.
      877     else if parobj-type = 'орг':U
      878     then do:
      879        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      880     end.
      881     else if parobj-type = 'регион':U
      882     then do:
      883        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      884     end.
      885     else
      886        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      887     return par-region.
      888   END FUNCTION.
