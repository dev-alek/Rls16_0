      890   function usrfulnf returns character ( input p-user-id as character):
      891   define variable v-user-name as character no-undo .
      892   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      893   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      894     (input  p-user-id
      895     ,output v-user-name
      896     ) no-error .
      897   if error-status:error
      898   or v-user-name = ""
      899   then do:
      900     return p-user-id.
      901   end.
      902   else do:
      903     return v-user-name.
      904   end.
      905   end function.
      906   define var var-rc as recid.
      907   define var fill-table-option as integer no-undo.
      908   FUNCTION get-mark0 RETURNS LOGICAL
      909     ( buffer loc-output-tax for output-tax )  FORWARD.
      910   FUNCTION get-var-rc RETURNS RECID
      911     ( input locpar-date as date)  FORWARD.
      912   DEFINE MENU MENU-B-restore
      913          MENU-ITEM m_one          LABEL "Вернуть первоначальную ставку  по данному налогу"
      914          MENU-ITEM m_all          LABEL "Вернуть первоначальное ставку по всем налогам".
      915   DEFINE BUTTON B-exit AUTO-GO
      916        LABEL "&Ввод"
      917        SIZE 10 BY 1
      918        BGCOLOR 8 .
      919   DEFINE BUTTON B-ext
      920        LABEL "&>>"
      921        SIZE 5 BY 1.
      922   DEFINE BUTTON B-Help
      923        LABEL "Помо&щь"
      924        SIZE 10 BY 1
      925        BGCOLOR 8 .
      926   DEFINE BUTTON B-hist
      927        LABEL "Ис&тория"
      928        SIZE 10 BY 1.
      929   DEFINE BUTTON b-quit AUTO-END-KEY
      930        LABEL "&Отмена"
      931        SIZE 10 BY 1
      932        BGCOLOR 8 .
      933   DEFINE BUTTON B-restore
      934        LABEL "Во&сстановить"
      935        SIZE 15 BY 1.
      936   DEFINE BUTTON B-selrate
      937        LABEL "Вы&бор ставки"
      938        SIZE 15 BY 1.
      939   DEFINE VARIABLE set-date AS DATE FORMAT "99/99/9999":U
      940        LABEL "с"
      941        VIEW-AS FILL-IN
      942        SIZE 11.25 BY 1.04 TOOLTIP "Время включения ставки" NO-UNDO.
      943   DEFINE VARIABLE RS-date AS INTEGER INITIAL 1
      944        VIEW-AS RADIO-SET HORIZONTAL
      945        RADIO-BUTTONS
      946             "Текущая дата", 1,
      947   "Все", 0
      948        SIZE 22.88 BY .88 NO-UNDO.
      949   DEFINE QUERY BR-tax-rate FOR
      950         ub.tax-rate SCROLLING.
      951   DEFINE QUERY BR-tax-rate-value FOR
      952         tt-tax-rate-value SCROLLING.
      953   DEFINE QUERY BR-tt-tax FOR
      954         output-tax SCROLLING.
      955   DEFINE BROWSE BR-tax-rate
      956     QUERY BR-tax-rate DISPLAY
      957         IF tax-rate.rate-code = output-tax.rate-code and get-mark0(buffer output-tax) then "*" else "" FORMAT "X(1)":U
      958         tax-rate.rate-code COLUMN-LABEL "Код!ставки" FORMAT ">>9":U
      959         tax-rate.rate-name FORMAT "X(25)":U
      960         tax-rate.status_ FORMAT "X(8)":U
      961       WITH NO-ROW-MARKERS SEPARATORS SIZE 45.5 BY 11.29
      962            TITLE "Коды ставок".
      963   DEFINE BROWSE BR-tax-rate-value
      964     QUERY BR-tax-rate-value DISPLAY
      965         if tt-tax-rate-value.rc = var-rc and get-mark0(buffer output-tax) then "*" else "" FORMAT "X(1)":U
      966         tt-tax-rate-value.rate-value FORMAT ">,>>>,>>>,>>9.99":U
      967         tt-tax-rate-value.fact-date FORMAT "99/99/9999":U
      968         tt-tax-rate-value.status_ FORMAT "X(8)":U
      969         get-region(tt-tax-rate-value.host-code, tt-tax-rate-value.obj-type, tt-tax-rate-value.obj-code) COLUMN-LABEL "Область!действия" FORMAT "X(14)":U
      970         usrfulnf(tt-tax-rate-value.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
      971         tt-tax-rate-value.corr-user-db-num COLUMN-LABEL "БД" FORMAT ">>>>9":U
      972               WIDTH 3
      973         tt-tax-rate-value.corr-date COLUMN-LABEL "Дата корр" FORMAT "99/99/9999":U
      974         string(tt-tax-rate-value.corr-time, "HH:MM") COLUMN-LABEL "Время корр" FORMAT "X(5)":U
      975       WITH SEPARATORS SIZE 52.5 BY 11.25
      976            TITLE "Значения ставок неинд. налогов".
      977   DEFINE BROWSE BR-tt-tax
      978     QUERY BR-tt-tax DISPLAY
      979         if get-mark0(buffer output-tax) then  "*" else '':U COLUMN-LABEL "*"
      980         output-tax.tax-code FORMAT "9":U
      981         output-tax.tax-name FORMAT "X(20)":U
      982         output-tax.tax-type FORMAT "X(1)":U
      983         output-tax.to-cashdesk COLUMN-LABEL "Посылать!на кассу" FORMAT "+/":U
      984         output-tax.individual COLUMN-LABEL "Инд." FORMAT "+/":U
      985         output-tax.rate-code COLUMN-LABEL "Код!ставки"
      986         output-tax.rate-value COLUMN-LABEL "Знач.!ставки" format "->>>9.99"
      987         output-tax.fact-date COLUMN-LABEL "Включена" FORMAT "99/99/9999":U
      988         usrfulnf(output-tax.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(10)":U
      989         output-tax.corr-user-db-num COLUMN-LABEL "БД" FORMAT ">>>9":U
      990               WIDTH 6
      991         output-tax.corr-date COLUMN-LABEL "Дата корр" FORMAT "99/99/9999":U
      992         string(output-tax.corr-time, "HH:MM") COLUMN-LABEL "Время корр" FORMAT "X(5)":U
      993       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
      994   DEFINE FRAME Dialog-Frame
      995        b-quit AT ROW 1 COL 1.13
      996        B-exit AT ROW 1 COL 11.13
      997        B-hist AT ROW 1 COL 51
      998        B-Help AT ROW 1 COL 71
      999        RS-date AT ROW 1.13 COL 21.75 NO-LABEL
     1000        BR-tt-tax AT ROW 2.08 COL 1
     1001        set-date AT ROW 9.67 COL 17.13 COLON-ALIGNED
     1002        B-ext AT ROW 9.67 COL 47.25
     1003        B-selrate AT ROW 9.71 COL 1
     1004        B-restore AT ROW 9.71 COL 31.38
     1005        BR-tax-rate AT ROW 10.88 COL 1
     1006        BR-tax-rate-value AT ROW 10.92 COL 46.88
     1007       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1008            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1009            TITLE "Значения ставок неиндивид. налогов"
     1010            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1011   ASSIGN
     1012          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1013          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1014   ASSIGN
     1015          B-restore:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-restore:HANDLE.
     1016   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1017   DO:
     1018     RUn initialize-table(0).
     1019     RUn fill-table(0, 1).
     1020     APPLY "END-ERROR":U TO SELF.
     1021   END.
     1022   ON CHOOSE OF B-ext IN FRAME Dialog-Frame
     1023   DO:
     1024      if not avail tt-tax-rate-value then RETURN NO-APPLY.
     1025     RUN proc-ext(var-rc, Rs-date) no-error.
     1026     if error-status:error then return no-apply.
     1027   END.
     1028   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     1029   DO:
     1030       DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1031           run ref/cgdshist.w (
     1032                           input parparentproc
     1033                         , input parhost-code
     1034                         , input parobj-type
     1035                         , input parobj-code
     1036                         , input "":U
     1037                         , "subject":U
     1038                         , input pargds-code
     1039                         , input ?
     1040                         , input ?
     1041                         , input ?
     1042                         , input ?
     1043                         , input "":U
     1044                         , input 'tax-rate-gds':U
     1045                         , input g#db-num
     1046                         , input-output v-rid-list  ) no-error .
     1047   END.
     1048   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1049   DO:
     1050       RUn initialize-table(0).
     1051          RUn fill-table(0, 1).
     1052   END.
     1053   ON CHOOSE OF B-restore IN FRAME Dialog-Frame
     1054   DO:
     1055    if rs-date = 0 then return no-apply.
     1056       if fill-table-option = -1 then do:
     1057       run gbl/pop-up.p (self:handle, no) no-error.
     1058       if error-status:error then return no-apply.
     1059     end.
     1060    if fill-table-option = -1 then return no-apply.
     1061    run proc-b-restore(fill-table-option) no-error.
     1062    if error-status:error then do:
     1063        fill-table-option = -1.
     1064        return no-apply.
     1065    end.
     1066   END.
     1067   ON CHOOSE OF B-selrate IN FRAME Dialog-Frame
     1068   DO:
     1069     assign set-date.
     1070     if not avail ub.tax-rate or
     1071     (ub.tax-rate.rate-code = output-tax.rate-code AND
     1072     (output-tax.fact-date = set-date or partable-mode = "GDS-GRP":U))  then do:
     1073       bell.
     1074       return no-apply.
     1075     end.
     1076     if rs-date = 0 then return no-apply.
     1077     run proc-b-selrate no-error.
     1078     if error-status:error then return no-apply.
     1079   END.
     1080   ON INSERT-MODE OF BR-tax-rate IN FRAME Dialog-Frame
     1081   DO:
     1082     APPLY "CHOOSE" to b-selrate.
     1083     return no-apply.
     1084   END.
     1085   ON VALUE-CHANGED OF BR-tax-rate IN FRAME Dialog-Frame
     1086   DO:
     1087     run Openbr-tax-rate-value(rs-date).
     1088   END.
     1089   ON MOUSE-SELECT-DBLCLICK OF BR-tax-rate-value IN FRAME Dialog-Frame
     1090   DO:
     1091     APPLY "CHOOSE" to b-ext.
     1092     return no-apply.
     1093   END.
     1094   ON VALUE-CHANGED OF BR-tt-tax IN FRAME Dialog-Frame
     1095   DO:
     1096   if not avail output-tax then return no-apply.
     1097     run OpenBr-tax-rate.
     1098   END.
     1099   ON CHOOSE OF MENU-ITEM m_all
     1100   DO:
     1101       if rs-date = 0 then return no-apply.
     1102     fill-table-option = 0.
     1103     run proc-b-restore(fill-table-option) no-error.
     1104       if error-status:error then do:
     1105            fill-table-option = -1.
     1106           return no-apply.
     1107       end.
     1108   END.
     1109   ON CHOOSE OF MENU-ITEM m_one
     1110   DO:
     1111       if rs-date = 0 then return no-apply.
     1112     fill-table-option = output-tax.tax-code.
     1113     run proc-b-restore(fill-table-option) no-error.
     1114       if error-status:error then do:
     1115           fill-table-option = -1.
     1116           return no-apply.
     1117       end.
     1118   END.
     1119   ON VALUE-CHANGED OF RS-date IN FRAME Dialog-Frame
     1120   DO:
     1121     define variable v-today as date      no-undo.
     1122     define variable v-time  as integer   no-undo.
     1123     assign RS-date.
     1124     case rs-date:
     1125       when 1 then do:
     1126         enable
     1127         b-selrate when lookup('ПРОСМОТР':U, parlist-mode) = 0
     1128         set-date when lookup('ПРОСМОТР':U, parlist-mode) = 0
     1129         with frame Dialog-Frame.
     1130       end.
     1131       when 0 then do:
     1132         disable
     1133         b-selrate  set-date
     1134         with frame Dialog-Frame.
     1135         hide set-date in frame Dialog-Frame.
     1136       end.
     1137     end case.
     1138     run fill-table(0, rs-date) no-error.
     1139     if error-status:error then return no-apply.
     1140     OPEN QUERY BR-tt-tax FOR EACH output-tax       WHERE output-tax.individual = FALSE NO-LOCK.
     1141     run cur-time in this-procedure ( output v-today                                   , output v-time                                   ).
     1142     var-rc = get-var-rc( v-today ).
     1143     APPLY "Value-changed" to br-tt-tax.
     1144     run Openbr-tax-rate-value(rs-date).
     1145     APPLY "ENTRY" to br-tax-rate.
     1146   END.
     1147   ON LEAVE OF set-date IN FRAME Dialog-Frame
     1148   DO:
     1149   DEFINE VARIABLE v-today as date no-undo .
     1150   DEFINE VARIABLE v-time as integer no-undo.
     1151   run cur-time in this-procedure ( output v-today                                   , output v-time                                   ).
     1152     if date(self:screen-value) < v-today then do:
     1153       bell.
     1154       return no-apply.
     1155     end.
     1156   END.
     1157   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1158   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1159   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1160   on help of frame Dialog-Frame
     1161   do:
     1162     run gbl/app_help.p
     1163       (input this-procedure :file-name
     1164       ,input ''
     1165       ,input ?
     1166       ) no-error.
     1167     if error-status :error then do:
     1168       message
     1169         "Ошибка при вызове помощи"
     1170         error-status :get-message(1)
     1171         view-as alert-box .
     1172     end.
     1173   end.
     1174   run minbtn-set in this-procedure .
     1175   on choose of b-help in frame Dialog-Frame
     1176   do:
     1177     apply "help":u to frame Dialog-Frame .
     1178   end.
     1179   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1180   procedure minbtn-set :
     1181       do
     1182           on error undo, return error return-value
     1183           :
     1184           define variable ii              as integer       no-undo .
     1185           define variable fh              as widget-handle no-undo .
     1186           define variable hh              as widget-handle no-undo .
     1187           define variable v-h             as handle        extent 4 no-undo .
     1188           define variable v-name-button   as character     no-undo .
     1189           define variable v-help-old-x    as decimal       no-undo .
     1190           define variable v-help-old-y    as decimal       no-undo .
     1191           define variable v-help-old-size as decimal       no-undo .
     1192           define variable v-frame-width   as decimal       no-undo .
     1193           define variable jj              as integer       no-undo .
     1194           do
     1195               on error undo, return error
     1196               :
     1197               assign
     1198                   v-frame-width = frame Dialog-Frame:width - 0.3
     1199                   fh            = frame Dialog-Frame:first-child
     1200                   hh            = fh:first-child
     1201                   ii            = 1
     1202                   .
     1203               do while valid-handle(hh):
     1204                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1205                   do:
     1206                       case lc(hh:name) :
     1207                           when "b-help" then
     1208                               do:
     1209                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1210                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1211                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1212                                   hh:TOOLTIP = "Помощь" .
     1213                                   v-help-old-x = hh:column .
     1214                                   v-help-old-y = hh:row    .
     1215                                   v-help-old-size = hh:width .
     1216                                   hh:width-chars = 2.5 .
     1217                               end.
     1218                           when "b-print" then
     1219                               do:
     1220                                   hh:load-image("cmp/b-print.bmp":u) .
     1221                                   hh:TOOLTIP = "Печать" .
     1222                                   v-h[ii] = hh:handle .
     1223                                   ii = ii + 1 .
     1224                                   hh:width-chars = 3 .
     1225                               end.
     1226                           when "b-history" or
     1227                           when "b-hist" then
     1228                               do:
     1229                                   hh:load-image("cmp/b-hist.bmp":u) .
     1230                                   hh:TOOLTIP = "История" .
     1231                                   v-h[ii] = hh:handle .
     1232                                   ii = ii + 1 .
     1233                                   hh:width-chars = 3 .
     1234                               end.
     1235                           when "b-sch" then
     1236                               do:
     1237                                   hh:load-image("cmp/b-sch.bmp":u) .
     1238                                   hh:TOOLTIP = "Установка Фильтра" .
     1239                                   v-h[ii] = hh:handle .
     1240                                   ii = ii + 1 .
     1241                                   hh:width-chars = 3 .
     1242                               end.
     1243                           when "b-hist-user" then
     1244                               do:
     1245                                   hh:load-image("cmp/b-hist.bmp":u) .
     1246                                   hh:TOOLTIP = "История пользователя" .
     1247                                   ii = ii + 1 .
     1248                               end.
     1249                       end case.
     1250                   end.
     1251                   hh = hh:next-sibling.
     1252               end.
     1253               b-help:column = v-frame-width - b-help:width-chars.
     1254               jj = 0.
     1255               repeat ii = 4 to 1 by -1 :
     1256                   if valid-handle (v-h[ii] ) then
     1257                   do:
     1258                       jj  = jj + 1 .
     1259                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1260                       v-h[ii]:row    = v-help-old-y .
     1261                   end.
     1262               end.
     1263           end.
     1264       end.
     1265   end procedure.
     1266   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1267   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1268   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1269   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1270   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1271   define variable v-diasize-current-frame-height as decimal   no-undo .
     1272   define variable v-diasize-change-size          as logical   no-undo .
     1273   define variable v-diasize-resize-button        as handle    no-undo .
     1274   define variable v-diasize-wndmax               as logical   no-undo .
     1275   define variable v-diasize-wndstore             as logical   no-undo .
     1276   define variable v-diasize-proc-name            as character no-undo .
     1277   define variable v-diasize-browse-handle        as handle    no-undo .
     1278   define variable v-diasize-browse-number        as integer   no-undo .
     1279   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1280   define temp-table temp-diasize-handle no-undo
     1281     field handle-value  as handle
     1282     field save-position as decimal
     1283     index xpk is primary unique handle-value
     1284     .
     1285   define temp-table temp-browse-handle no-undo
     1286     field browse-type   as character
     1287     field browse-number as integer
     1288     field browse-handle as handle
     1289     field original-size as decimal
     1290     index xpk is primary unique browse-type browse-number
     1291     index xie browse-type browse-handle
     1292   .
     1293   procedure diasize_change-height :
     1294     define input  parameter p-change-value  as decimal   no-undo .
     1295     define input  parameter p-move-resize   as logical   no-undo .
     1296     define variable v-field-group-handle    as handle    no-undo .
     1297     define variable v-object-handle         as handle    no-undo .
     1298     define variable v-frame-height          as decimal   no-undo .
     1299     define variable v-frame-virtual-height  as decimal   no-undo .
     1300     define variable v-browse-height         as decimal   no-undo .
     1301     define variable v-window-height         as decimal   no-undo .
     1302     define variable v-window-virtual-height as decimal   no-undo .
     1303     define variable v-change-sign           as integer   no-undo .
     1304     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1305     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1306     if p-change-value > 0
     1307     then do:
     1308       if frame Dialog-Frame :height + p-change-value
     1309           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1310       then do:
     1311         assign
     1312           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1313                           - (frame Dialog-Frame :height-chars)
     1314         .
     1315         if p-change-value <= 0
     1316         then do:
     1317           run diasize_position-resize-button in this-procedure .
     1318           return .
     1319         end.
     1320       end.
     1321     end.
     1322     if p-change-value < 0
     1323     then do:
     1324       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1325       then do:
     1326         assign
     1327           p-change-value = v-diasize-orig-frame-height
     1328                          - (frame Dialog-Frame :height-chars)
     1329         .
     1330         if p-change-value >= 0
     1331         then do:
     1332           run diasize_position-resize-button in this-procedure .
     1333           return .
     1334         end.
     1335       end.
     1336     end.
     1337     if p-change-value >= 0
     1338     then do:
     1339       assign
     1340         v-change-sign = 1
     1341       .
     1342     end.
     1343     else do:
     1344       assign
     1345         v-change-sign = -1
     1346       .
     1347     end.
     1348     assign
     1349       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1350     .
     1351     if p-change-value = 0
     1352     then do:
     1353       run diasize_position-resize-button in this-procedure .
     1354       return .
     1355     end.
     1356     move_block:
     1357     do
     1358     on error undo move_block, retry move_block
     1359     :
     1360       if retry
     1361       then do:
     1362         do
     1363         on error undo move_block, leave move_block
     1364         :
     1365           if p-change-value > 0
     1366           then do:
     1367             for each buf_temp-diasize-handle
     1368             on error undo, next
     1369             :
     1370               assign
     1371                 v-object-handle = buf_temp-diasize-handle.handle-value
     1372               .
     1373               if v-object-handle <> v-diasize-resize-button
     1374               then do:
     1375                 assign
     1376                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1377                 .
     1378               end.
     1379             end.
     1380             assign
     1381               v-diasize-browse-handle :height = v-browse-height
     1382             .
     1383             for each buf_temp-browse-handle
     1384               where buf_temp-browse-handle.browse-type = 'height':u
     1385             on error undo, next
     1386             :
     1387               assign
     1388                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1389               .
     1390             end.
     1391             assign
     1392               frame Dialog-Frame :height = v-frame-height
     1393             .
     1394             if frame Dialog-Frame :scrollable = true
     1395             then do:
     1396               assign
     1397                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1398               .
     1399             end.
     1400             run diasize_position-resize-button in this-procedure .
     1401           end.
     1402           else do:
     1403             if frame Dialog-Frame :scrollable = true
     1404             then do:
     1405               assign
     1406                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1407               .
     1408             end.
     1409             assign
     1410               frame Dialog-Frame :height = v-frame-height
     1411             .
     1412             assign
     1413               v-diasize-browse-handle :height = v-browse-height
     1414             .
     1415             for each buf_temp-browse-handle
     1416               where buf_temp-browse-handle.browse-type = 'height':u
     1417             on error undo, next
     1418             :
     1419               assign
     1420                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1421               .
     1422             end.
     1423             for each buf_temp-diasize-handle
     1424             on error undo, next
     1425             :
     1426               assign
     1427                 v-object-handle = buf_temp-diasize-handle.handle-value
     1428               .
     1429               if v-object-handle <> v-diasize-resize-button
     1430               then do:
     1431                 assign
     1432                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1433                 .
     1434               end.
     1435             end.
     1436             run diasize_position-resize-button in this-procedure .
     1437           end.
     1438           assign
     1439             v-diasize-change-size = false
     1440           .
     1441           leave move_block .
     1442         end.
     1443       end.
     1444       assign
     1445         v-diasize-need-full-display = true
     1446       .
     1447       if v-diasize-change-size = false
     1448       then do:
     1449         assign
     1450           v-diasize-change-size = true
     1451         .
     1452       end.
     1453       else do:
     1454         return .
     1455       end.
     1456       assign
     1457         v-frame-height = frame Dialog-Frame :height
     1458         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1459         v-browse-height = v-diasize-browse-handle :height
     1460       .
     1461       for each buf_temp-browse-handle
     1462         where buf_temp-browse-handle.browse-type = 'height':u
     1463       :
     1464         assign
     1465           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1466         .
     1467       end.
     1468       for each buf_temp-diasize-handle
     1469       :
     1470         delete buf_temp-diasize-handle .
     1471       end.
     1472       assign
     1473         v-field-group-handle = frame Dialog-Frame :first-child
     1474       .
     1475       do while valid-handle(v-field-group-handle)
     1476       :
     1477         assign
     1478           v-object-handle = v-field-group-handle :first-child
     1479         .
     1480         do while valid-handle(v-object-handle)
     1481         :
     1482           if  v-object-handle <> v-diasize-browse-handle :handle
     1483           and can-query(v-object-handle, "row")
     1484           and can-query(v-object-handle, "height")
     1485           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1486           then do:
     1487             find first buf_temp-browse-handle
     1488               where buf_temp-browse-handle.browse-type   = 'height':u
     1489                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1490               no-error .
     1491             if available buf_temp-browse-handle
     1492             then do:
     1493             end.
     1494             else do:
     1495               create buf_temp-diasize-handle .
     1496               assign
     1497                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1498                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1499               .
     1500             end.
     1501           end.
     1502           assign
     1503             v-object-handle = v-object-handle :next-sibling
     1504           .
     1505         end.
     1506         assign
     1507           v-field-group-handle = v-field-group-handle :next-sibling
     1508         .
     1509       end.
     1510       do with frame Dialog-Frame
     1511       :
     1512         hide v-diasize-resize-button .
     1513         assign
     1514           v-diasize-resize-button :row    = 1
     1515           v-diasize-resize-button :column = 1
     1516         .
     1517       end.
     1518       if p-change-value > 0
     1519       then do:
     1520         if frame Dialog-Frame :scrollable = true
     1521         then do:
     1522           assign
     1523             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1524             no-error .
     1525           if error-status :error
     1526           or error-status :get-message(1) <> ""
     1527           then do:
     1528             undo move_block, retry move_block .
     1529           end.
     1530         end.
     1531         assign
     1532           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1533           no-error .
     1534         if error-status :error
     1535         or error-status :get-message(1) <> ""
     1536         then do:
     1537           undo move_block, retry move_block .
     1538         end.
     1539         assign
     1540           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1541           no-error .
     1542         if error-status :error
     1543         or error-status :get-message(1) <> ""
     1544         then do:
     1545           undo move_block, retry move_block .
     1546         end.
     1547         for each buf_temp-browse-handle
     1548           where buf_temp-browse-handle.browse-type = 'height':u
     1549         on error undo move_block, retry move_block
     1550         :
     1551           assign
     1552             buf_temp-browse-handle.browse-handle :height
     1553               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1554             no-error .
     1555           if error-status :error
     1556           or error-status :get-message(1) <> ""
     1557           then do:
     1558             undo move_block, retry move_block .
     1559           end.
     1560         end.
     1561         for each buf_temp-diasize-handle
     1562         on error undo move_block, retry move_block
     1563         :
     1564           assign
     1565             v-object-handle = buf_temp-diasize-handle.handle-value
     1566           .
     1567           if v-object-handle <> v-diasize-resize-button
     1568           then do:
     1569             assign
     1570               v-object-handle :row = v-object-handle :row + p-change-value
     1571               no-error .
     1572             if error-status :error
     1573             or error-status :get-message(1) <> ""
     1574             then do:
     1575               undo move_block, retry move_block .
     1576             end.
     1577           end.
     1578         end.
     1579       end.
     1580       else do:
     1581         for each buf_temp-diasize-handle
     1582         on error undo move_block, retry move_block
     1583         :
     1584           assign
     1585             v-object-handle = buf_temp-diasize-handle.handle-value
     1586           .
     1587           if v-object-handle <> v-diasize-resize-button
     1588           then do:
     1589             assign
     1590               v-object-handle :row = v-object-handle :row + p-change-value
     1591               no-error .
     1592             if error-status :error
     1593             or error-status :get-message(1) <> ""
     1594             then do:
     1595               undo move_block, retry move_block .
     1596             end.
     1597           end.
     1598         end.
     1599         assign
     1600           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1601           no-error .
     1602         if error-status :error
     1603         or error-status :get-message(1) <> ""
     1604         then do:
     1605           undo move_block, retry move_block .
     1606         end.
     1607         for each buf_temp-browse-handle
     1608           where buf_temp-browse-handle.browse-type = 'height':u
     1609         on error undo move_block, retry move_block
     1610         :
     1611           assign
     1612             buf_temp-browse-handle.browse-handle :height
     1613               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1614             no-error .
     1615           if error-status :error
     1616           or error-status :get-message(1) <> ""
     1617           then do:
     1618             undo move_block, retry move_block .
     1619           end.
     1620         end.
     1621         assign
     1622           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1623           no-error .
     1624         if error-status :error
     1625         or error-status :get-message(1) <> ""
     1626         then do:
     1627           undo move_block, retry move_block .
     1628         end.
     1629         if frame Dialog-Frame :scrollable = true
     1630         then do:
     1631           assign
     1632             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1633             no-error .
     1634           if error-status :error
     1635           or error-status :get-message(1) <> ""
     1636           then do:
     1637             undo move_block, retry move_block .
     1638           end.
     1639         end.
     1640       end.
     1641       if p-move-resize = true
     1642       then do:
     1643         run diasize_position-resize-button in this-procedure .
     1644       end.
     1645       if v-diasize-wndstore = true
     1646       then do:
     1647         if connected("ub") = true
     1648         then do:
     1649           define variable v-cntxt-db-num        as integer   no-undo .
     1650           define variable v-cntxt-userid        as character no-undo .
     1651           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1652                                             , OUTPUT v-cntxt-userid
     1653                                             ) .
     1654           run gbl/wndsizew.p
     1655             (input  v-cntxt-db-num
     1656             ,input  v-cntxt-userid
     1657             ,input  v-diasize-proc-name
     1658             ,input  'height':u
     1659             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1660             ) .
     1661         end.
     1662       end.
     1663     end.
     1664     assign
     1665       v-diasize-change-size = false
     1666     .
     1667   end procedure.
     1668   procedure diasize_set-height :
     1669     define input  parameter p-new-height  as decimal   no-undo .
     1670     define input  parameter p-move-resize as logical   no-undo .
     1671     do
     1672     on error undo, return error return-value
     1673     :
     1674       run diasize_change-height in this-procedure
     1675         (input  (p-new-height - frame Dialog-Frame :height)
     1676         ,input  p-move-resize
     1677         ) .
     1678     end.
     1679   end procedure.
     1680   procedure diasize_change-width :
     1681     define input  parameter p-change-value as decimal   no-undo .
     1682     define input  parameter p-move-resize  as logical   no-undo .
     1683     define variable v-field-group-handle   as handle    no-undo .
     1684     define variable v-object-handle        as handle    no-undo .
     1685     define variable v-frame-width          as decimal   no-undo .
     1686     define variable v-frame-virtual-width  as decimal   no-undo .
     1687     define variable v-browse-width         as decimal   no-undo .
     1688     define variable v-window-width         as decimal   no-undo .
     1689     define variable v-window-virtual-width as decimal   no-undo .
     1690     define variable v-change-sign          as integer   no-undo .
     1691     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1692     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1693     if p-change-value > 0
     1694     then do:
     1695       if frame Dialog-Frame :width + p-change-value >
     1696           session :width-chars
     1697       then do:
     1698         assign
     1699           p-change-value = session :width-chars - frame Dialog-Frame :width
     1700         .
     1701         if p-change-value <= 0
     1702         then do:
     1703           run diasize_position-resize-button in this-procedure .
     1704           return .
     1705         end.
     1706       end.
     1707     end.
     1708     if p-change-value < 0
     1709     then do:
     1710       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1711       then do:
     1712         assign
     1713           p-change-value = v-diasize-orig-frame-width
     1714                          - frame Dialog-Frame :width
     1715         .
     1716         if p-change-value >= 0
     1717         then do:
     1718           run diasize_position-resize-button in this-procedure .
     1719           return .
     1720         end.
     1721       end.
     1722     end.
     1723     if p-change-value >= 0
     1724     then do:
     1725       assign
     1726         v-change-sign = 1
     1727       .
     1728     end.
     1729     else do:
     1730       assign
     1731         v-change-sign = -1
     1732       .
     1733     end.
     1734     assign
     1735       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1736     .
     1737     if p-change-value = 0
     1738     then do:
     1739       run diasize_position-resize-button in this-procedure .
     1740       return .
     1741     end.
     1742     move_block:
     1743     do
     1744     on error undo move_block, leave move_block
     1745     :
     1746       if retry
     1747       then do:
     1748         do
     1749         on error undo move_block, leave move_block
     1750         :
     1751           if p-change-value > 0
     1752           then do:
     1753             for each buf_temp-diasize-handle
     1754             on error undo, next
     1755             :
     1756               assign
     1757                 v-object-handle = buf_temp-diasize-handle.handle-value
     1758               .
     1759               if v-object-handle <> v-diasize-resize-button
     1760               then do:
     1761                 assign
     1762                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1763                 .
     1764               end.
     1765             end.
     1766             assign
     1767               v-diasize-browse-handle :width = v-browse-width
     1768             .
     1769             for each buf_temp-browse-handle
     1770               where buf_temp-browse-handle.browse-type = 'width':u
     1771             on error undo, next
     1772             :
     1773               assign
     1774                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1775               .
     1776             end.
     1777             assign
     1778               frame Dialog-Frame :width = v-frame-width
     1779             .
     1780             if frame Dialog-Frame :scrollable = true
     1781             then do:
     1782               assign
     1783                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1784               .
     1785             end.
     1786             run diasize_position-resize-button in this-procedure .
     1787           end.
     1788           else do:
     1789             if frame Dialog-Frame :scrollable = true
     1790             then do:
     1791               assign
     1792                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1793               .
     1794             end.
     1795             assign
     1796               frame Dialog-Frame :width = v-frame-width
     1797             .
     1798             for each buf_temp-browse-handle
     1799               where buf_temp-browse-handle.browse-type = 'width':u
     1800             on error undo, next
     1801             :
     1802               assign
     1803                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1804               .
     1805             end.
     1806             assign
     1807               v-diasize-browse-handle :width = v-browse-width
     1808             .
     1809             for each buf_temp-diasize-handle
     1810             on error undo, next
     1811             :
     1812               assign
     1813                 v-object-handle = buf_temp-diasize-handle.handle-value
     1814               .
     1815               if v-object-handle <> v-diasize-resize-button
     1816               then do:
     1817                 assign
     1818                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1819                 .
     1820               end.
     1821             end.
     1822             run diasize_position-resize-button in this-procedure .
     1823           end.
     1824           assign
     1825             v-diasize-change-size = false
     1826           .
     1827           leave move_block .
     1828         end.
     1829       end.
     1830       assign
     1831         v-diasize-need-full-display = true
     1832       .
     1833       if v-diasize-change-size = false
     1834       then do:
     1835         assign
     1836           v-diasize-change-size = true
     1837         .
     1838       end.
     1839       else do:
     1840         return .
     1841       end.
     1842       assign
     1843         v-frame-width = frame Dialog-Frame :width
     1844         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1845         v-browse-width = v-diasize-browse-handle :width
     1846       .
     1847       for each buf_temp-browse-handle
     1848         where buf_temp-browse-handle.browse-type = 'width':u
     1849       :
     1850         assign
     1851           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1852         .
     1853       end.
     1854       for each buf_temp-diasize-handle
     1855       :
     1856         delete buf_temp-diasize-handle .
     1857       end.
     1858       assign
     1859         v-field-group-handle = frame Dialog-Frame :first-child
     1860       .
     1861       do while valid-handle(v-field-group-handle)
     1862       :
     1863         assign
     1864           v-object-handle = v-field-group-handle :first-child
     1865         .
     1866         do while valid-handle(v-object-handle)
     1867         :
     1868           if  v-object-handle <> v-diasize-browse-handle :handle
     1869           and v-object-handle <> v-diasize-resize-button
     1870           and can-query(v-object-handle, "row")
     1871           and can-query(v-object-handle, "height")
     1872           and ( v-object-handle :col + v-object-handle :width
     1873                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1874               )
     1875           then do:
     1876             find first buf_temp-browse-handle
     1877               where buf_temp-browse-handle.browse-type   = 'width':u
     1878                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1879               no-error .
     1880             if available buf_temp-browse-handle
     1881             then do:
     1882             end.
     1883             else do:
     1884               create buf_temp-diasize-handle .
     1885               assign
     1886                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1887                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1888               .
     1889             end.
     1890           end.
     1891           assign
     1892             v-object-handle = v-object-handle :next-sibling
     1893           .
     1894         end.
     1895         assign
     1896           v-field-group-handle = v-field-group-handle :next-sibling
     1897         .
     1898       end.
     1899       do with frame Dialog-Frame
     1900       :
     1901         hide v-diasize-resize-button .
     1902         v-diasize-resize-button :row = 1.
     1903         v-diasize-resize-button :column = 1.
     1904       end.
     1905       if p-change-value > 0
     1906       then do:
     1907         if frame Dialog-Frame :scrollable = true
     1908         then do:
     1909           assign
     1910             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1911             no-error .
     1912           if error-status :error
     1913           or error-status :get-message(1) <> ""
     1914           then do:
     1915             undo move_block, retry move_block.
     1916           end.
     1917         end.
     1918         assign
     1919           frame Dialog-Frame :width = v-frame-width + p-change-value
     1920           no-error .
     1921         if error-status :error
     1922         or error-status :get-message(1) <> ""
     1923         then do:
     1924           undo move_block, retry move_block.
     1925         end.
     1926         assign
     1927           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1928         no-error .
     1929         if error-status :error
     1930         or error-status :get-message(1) <> ""
     1931         then do:
     1932           undo move_block, retry move_block.
     1933         end.
     1934         for each buf_temp-browse-handle
     1935           where buf_temp-browse-handle.browse-type = 'width':u
     1936         on error undo move_block, retry move_block
     1937         :
     1938           assign
     1939             buf_temp-browse-handle.browse-handle :width
     1940               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1941             no-error .
     1942           if error-status :error
     1943           or error-status :get-message(1) <> ""
     1944           then do:
     1945             undo move_block, retry move_block .
     1946           end.
     1947         end.
     1948         for each buf_temp-diasize-handle
     1949         on error undo move_block, retry move_block
     1950         :
     1951           assign
     1952             v-object-handle = buf_temp-diasize-handle.handle-value
     1953           .
     1954           if v-object-handle <> v-diasize-resize-button
     1955           then do:
     1956             assign
     1957               v-object-handle :col = v-object-handle :col + p-change-value
     1958               no-error .
     1959             if error-status :error
     1960             or error-status :get-message(1) <> ""
     1961             then do:
     1962               undo move_block, retry move_block .
     1963             end.
     1964           end.
     1965         end.
     1966       end.
     1967       else do:
     1968         for each buf_temp-diasize-handle
     1969         on error undo move_block, retry move_block
     1970         :
     1971           assign
     1972             v-object-handle = buf_temp-diasize-handle.handle-value
     1973           .
     1974           if v-object-handle <> v-diasize-resize-button
     1975           then do:
     1976             assign
     1977               v-object-handle :col = v-object-handle :col + p-change-value
     1978               no-error .
     1979             if error-status :error
     1980             or error-status :get-message(1) <> ""
     1981             then do:
     1982               undo move_block, retry move_block .
     1983             end.
     1984           end.
     1985         end.
     1986         for each buf_temp-browse-handle
     1987           where buf_temp-browse-handle.browse-type = 'width':u
     1988         on error undo move_block, retry move_block
     1989         :
     1990           assign
     1991             buf_temp-browse-handle.browse-handle :width
     1992               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1993             no-error .
     1994           if error-status :error
     1995           or error-status :get-message(1) <> ""
     1996           then do:
     1997             undo move_block, retry move_block .
     1998           end.
     1999         end.
     2000         assign
     2001           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2002           no-error .
     2003         if error-status :error
     2004         or error-status :get-message(1) <> ""
     2005         then do:
     2006           undo move_block, retry move_block.
     2007         end.
     2008         assign
     2009           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2010         no-error .
     2011         if error-status :error
     2012         or error-status :get-message(1) <> ""
     2013         then do:
     2014           undo move_block, retry move_block.
     2015         end.
     2016         if frame Dialog-Frame :scrollable = true
     2017         then do:
     2018           assign
     2019             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2020           no-error .
     2021           if error-status :error
     2022           or error-status :get-message(1) <> ""
     2023           then do:
     2024             undo move_block, retry move_block.
     2025           end.
     2026         end.
     2027       end.
     2028       if p-move-resize
     2029       then do:
     2030         run diasize_position-resize-button in this-procedure .
     2031       end.
     2032       if v-diasize-wndstore = true
     2033       then do:
     2034         if connected("ub") = true
     2035         then do:
     2036           define variable v-cntxt-db-num        as integer   no-undo .
     2037           define variable v-cntxt-userid        as character no-undo .
     2038           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2039                                             , OUTPUT v-cntxt-userid
     2040                                             ) .
     2041           run gbl/wndsizew.p
     2042             (input  v-cntxt-db-num
     2043             ,input  v-cntxt-userid
     2044             ,input  v-diasize-proc-name
     2045             ,input  'width':u
     2046             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2047             ) .
     2048         end.
     2049       end.
     2050     end.
     2051     assign
     2052       v-diasize-change-size = false
     2053     .
     2054   end procedure.
     2055   procedure diasize_set-width :
     2056     define input  parameter p-new-width  as decimal   no-undo .
     2057     define input  parameter p-move-resize as logical   no-undo .
     2058     do
     2059     on error undo, return error return-value
     2060     :
     2061       run diasize_change-width in this-procedure
     2062         (input  (p-new-width - frame Dialog-Frame :width)
     2063         ,input  p-move-resize
     2064         ) .
     2065     end.
     2066   end procedure.
     2067   procedure diasize_position-resize-button :
     2068     do with frame Dialog-Frame
     2069     :
     2070       hide v-diasize-resize-button .
     2071       assign
     2072         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2073                     - 1
     2074                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2075         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2076                     - 1
     2077                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2078       .
     2079       view v-diasize-resize-button .
     2080     end.
     2081   end procedure.
     2082   on alt-right anywhere
     2083   do:
     2084     run diasize_change-width in this-procedure
     2085       (input 1
     2086       ,input true
     2087       ) .
     2088     return no-apply .
     2089   end.
     2090   on alt-left anywhere
     2091   do:
     2092     run diasize_change-width in this-procedure
     2093       (input -1
     2094       ,input true
     2095       ) .
     2096     return no-apply .
     2097   end.
     2098   on alt-down anywhere
     2099   do:
     2100     run diasize_change-height in this-procedure
     2101       (input 1
     2102       ,input true
     2103       ) .
     2104     return no-apply .
     2105   end.
     2106   on alt-up anywhere
     2107   do:
     2108     run diasize_change-height in this-procedure
     2109       (input -1
     2110       ,input true
     2111       ) .
     2112     return no-apply .
     2113   end.
     2114   on alt-enter of frame Dialog-Frame
     2115   do:
     2116     run diasize_maximize in this-procedure
     2117       (input  ?
     2118       ).
     2119     return no-apply .
     2120   end.
     2121   procedure diasize_end-move :
     2122     do
     2123     on error undo, return error return-value
     2124     :
     2125       define variable v-row-delta as decimal   no-undo .
     2126       define variable v-col-delta as decimal   no-undo .
     2127       define variable v-new-row as decimal   no-undo .
     2128       define variable v-new-col as decimal   no-undo .
     2129       assign
     2130         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2131         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2132       .
     2133       assign
     2134         v-row-delta = v-new-row - frame Dialog-Frame :height
     2135         v-col-delta = v-new-col - frame Dialog-Frame :width
     2136       .
     2137       run diasize_change-height in this-procedure
     2138         (input v-row-delta
     2139         ,input true
     2140         ) .
     2141       run diasize_change-width in this-procedure
     2142         (input v-col-delta
     2143         ,input true
     2144         ) .
     2145     end.
     2146   end procedure.
     2147   procedure diasize_maximize :
     2148     define input  parameter p-action as logical   no-undo .
     2149     do
     2150     on error undo, return error return-value
     2151     :
     2152       if p-action = ?
     2153       then do:
     2154         if v-diasize-need-maximize = true
     2155         then do:
     2156           assign
     2157             p-action = true
     2158           .
     2159         end.
     2160         else do:
     2161           assign
     2162             p-action = false
     2163           .
     2164         end.
     2165       end.
     2166       if p-action = true
     2167       then do:
     2168         run diasize_change-height in this-procedure
     2169           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2170               - frame Dialog-Frame :height-chars
     2171           ,input true
     2172           ) .
     2173         run diasize_change-width in this-procedure
     2174           (input session :width-chars
     2175               - frame Dialog-Frame :width-chars
     2176           ,input true
     2177           ) .
     2178         assign
     2179           v-diasize-need-maximize = false
     2180         .
     2181       end.
     2182       else do:
     2183         run diasize_change-width in this-procedure
     2184           (input v-diasize-orig-frame-width
     2185               - frame Dialog-Frame :width-chars
     2186           ,input true
     2187           ) .
     2188         run diasize_change-height in this-procedure
     2189           (input v-diasize-orig-frame-height
     2190               - frame Dialog-Frame :height-chars
     2191           ,input true
     2192           ) .
     2193         assign
     2194           v-diasize-need-maximize = true
     2195         .
     2196       end.
     2197     end.
     2198   end procedure.
     2199   procedure diasize_restore-orig-size :
     2200     do
     2201     on error undo, return error return-value
     2202     :
     2203       assign
     2204         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2205         v-diasize-current-frame-height = frame Dialog-Frame :height
     2206       .
     2207       run diasize_set-height in this-procedure
     2208         (input  v-diasize-orig-frame-height
     2209         ,input  true
     2210         ) .
     2211       run diasize_set-width in this-procedure
     2212         (input  v-diasize-orig-frame-width
     2213         ,input  true
     2214         ) .
     2215     end.
     2216   end procedure.
     2217   procedure diasize_restore-current-size :
     2218     do
     2219     on error undo, return error return-value
     2220     :
     2221       run diasize_set-height in this-procedure
     2222         (input  v-diasize-current-frame-height
     2223         ,input  true
     2224         ) .
     2225       run diasize_set-width in this-procedure
     2226         (input  v-diasize-current-frame-width
     2227         ,input  true
     2228         ) .
     2229     end.
     2230   end procedure.
     2231   procedure diasize_set-browse-handle :
     2232     define input  parameter p-browse-handle as handle   no-undo .
     2233     define buffer buf_temp-browse-handle for temp-browse-handle .
     2234     do
     2235     on error undo, return error return-value
     2236     :
     2237       assign
     2238         v-diasize-browse-handle = p-browse-handle
     2239       .
     2240       for each buf_temp-browse-handle
     2241       on error undo, return error return-value
     2242       :
     2243         delete buf_temp-browse-handle .
     2244       end.
     2245     end.
     2246   end procedure.
     2247   procedure diasize_add_browse :
     2248     define input  parameter p-browse-type   as character no-undo .
     2249     define input  parameter p-browse-handle as handle    no-undo .
     2250     define buffer buf_temp-browse-handle for temp-browse-handle .
     2251     do
     2252     on error undo, return error return-value
     2253     :
     2254       assign
     2255         v-diasize-browse-number = v-diasize-browse-number + 1
     2256       .
     2257       create buf_temp-browse-handle .
     2258       assign
     2259         buf_temp-browse-handle.browse-type   = p-browse-type
     2260         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2261         buf_temp-browse-handle.browse-handle = p-browse-handle
     2262       .
     2263     end.
     2264   end procedure.
     2265   procedure diasize_init :
     2266     define variable v-default-value    as logical   no-undo .
     2267     define variable v-restore-saved    as logical   no-undo .
     2268     define variable v-resize-value-str as character no-undo .
     2269     do
     2270     on error undo, return error return-value
     2271     :
     2272       do with frame Dialog-Frame
     2273       :
     2274         assign
     2275           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2276           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2277           v-diasize-browse-handle     = browse BR-tt-tax :handle
     2278         .
     2279         create button v-diasize-resize-button
     2280         assign
     2281           parent        = frame Dialog-Frame :first-child
     2282           label         = "s"
     2283           height-pixels = 16
     2284           width-pixels  = 16
     2285           visible       = true
     2286           sensitive     = true
     2287           movable       = true
     2288           triggers:
     2289             on end-move persistent run diasize_end-move in this-procedure .
     2290           end triggers.
     2291         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2292         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2293         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2294         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2295         assign
     2296           v-diasize-wndmax = false
     2297         .
     2298         if connected("ub") = true
     2299         then do:
     2300           define variable v-cntxt-db-num        as integer   no-undo .
     2301           define variable v-cntxt-userid        as character no-undo .
     2302           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2303                                             , OUTPUT v-cntxt-userid
     2304                                             ) .
     2305           run gbl/wndpar_r.p
     2306             (input  v-cntxt-db-num
     2307             ,input  v-cntxt-userid
     2308             ,input  'wndmax':U
     2309             ,output v-diasize-wndmax
     2310             ,output v-default-value
     2311             ) .
     2312         end.
     2313         assign
     2314           v-diasize-wndstore = false
     2315         .
     2316         if connected("ub") = true
     2317         then do:
     2318           run gbl/wndpar_r.p
     2319             (input  v-cntxt-db-num
     2320             ,input  v-cntxt-userid
     2321             ,input  'wndstore':U
     2322             ,output v-diasize-wndstore
     2323             ,output v-default-value
     2324             ) .
     2325         end.
     2326         assign
     2327           v-diasize-proc-name = entry(1, program-name(2), '.')
     2328         .
     2329         if v-diasize-wndstore = true
     2330         then do:
     2331           assign
     2332             v-restore-saved = false
     2333           .
     2334           if connected("ub") = true
     2335           then do:
     2336             run gbl/wndsizer.p
     2337               (input  v-cntxt-db-num
     2338               ,input  v-cntxt-userid
     2339               ,input  v-diasize-proc-name
     2340               ,input  'height':u
     2341               ,output v-resize-value-str
     2342               ) .
     2343             if v-resize-value-str <> '':U
     2344             then do:
     2345               run diasize_change-height in this-procedure
     2346                 (input  integer(v-resize-value-str)
     2347                 ,input  true
     2348                 ) .
     2349               assign
     2350                 v-restore-saved = true
     2351               .
     2352             end.
     2353           end.
     2354           if connected("ub") = true
     2355           then do:
     2356             run gbl/wndsizer.p
     2357               (input  v-cntxt-db-num
     2358               ,input  v-cntxt-userid
     2359               ,input  v-diasize-proc-name
     2360               ,input  'width':u
     2361               ,output v-resize-value-str
     2362               ) .
     2363             if v-resize-value-str <> '':U
     2364             then do:
     2365               run diasize_change-width in this-procedure
     2366                 (input  integer(v-resize-value-str)
     2367                 ,input  true
     2368                 ) .
     2369               assign
     2370                 v-restore-saved = true
     2371               .
     2372             end.
     2373           end.
     2374           if v-restore-saved <> true
     2375           then do:
     2376             if v-diasize-wndmax = true
     2377             then do:
     2378               run diasize_maximize in this-procedure
     2379                 (input  true
     2380                 ) .
     2381             end.
     2382           end.
     2383         end.
     2384         else do:
     2385           if v-diasize-wndmax = true
     2386           then do:
     2387             run diasize_maximize in this-procedure
     2388               (input  true
     2389               ) .
     2390           end.
     2391         end.
     2392       end.
     2393     end.
     2394   end procedure.
     2395   procedure diasize_need-full-display :
     2396     define output parameter p-need-full-display as logical   no-undo .
     2397     do
     2398     on error undo, return error return-value
     2399     :
     2400       assign
     2401         p-need-full-display = v-diasize-need-full-display
     2402       .
     2403       assign
     2404         v-diasize-need-full-display = false
     2405       .
     2406     end.
     2407   end procedure.
     2408   procedure get-context :
     2409      define output parameter p-db-num as integer          no-undo.
     2410      define output parameter p-user-id as character        no-undo.
     2411      define variable v-login               as character    no-undo.
     2412      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2413      define buffer buf_user-login  for ub.user-login .
     2414      do
     2415      on error undo, return error
     2416      :
     2417            FIND FIRST buf_sys-ctrl no-lock.
     2418            ASSIGN
     2419               v-login = USERID("ub")
     2420               p-db-num = buf_sys-ctrl.db-num
     2421            .
     2422            FIND FIRST buf_user-login
     2423                 WHERE buf_user-login.db-num = p-db-num
     2424                   AND buf_user-login.user-login = v-login
     2425                 no-lock
     2426                 no-error
     2427                 .
     2428            IF AVAILABLE buf_user-login
     2429            THEN DO:
     2430               assign
     2431                  p-user-id = buf_user-login.user-id
     2432               .
     2433            END.
     2434      end.
     2435   end procedure.
     2436   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2437   on ' ' of set-date in frame Dialog-Frame
     2438   do:
     2439     if (can-query (self, "sensitive")
     2440        and
     2441        self :sensitive = true
     2442        )
     2443     or (can-query (self, "read-only")
     2444        and
     2445        self :read-only = false
     2446        )
     2447     then do:
     2448       assign
     2449         self :screen-value = ?
     2450       .
     2451     end.
     2452     return no-apply.
     2453   end.
     2454   on delete-character of set-date in frame Dialog-Frame
     2455   do:
     2456     if (can-query (self, "sensitive")
     2457        and
     2458        self :sensitive = true
     2459        )
     2460     or (can-query (self, "read-only")
     2461        and
     2462        self :read-only = false
     2463        )
     2464     then do:
     2465       assign
     2466         self :screen-value = ?
     2467       .
     2468     end.
     2469     return no-apply.
     2470   end.
     2471   on ctrl-d of set-date in frame Dialog-Frame
     2472   do:
     2473     define variable v-curr-sv-date as date no-undo .
     2474     if (can-query (self, "sensitive")
     2475        and
     2476        self :sensitive = true
     2477        )
     2478     or (can-query (self, "read-only")
     2479        and
     2480        self :read-only = false
     2481        )
     2482     then do:
     2483       if self :handle <> focus :handle
     2484       then do:
     2485         apply "entry":u to self .
     2486       end.
     2487       run gbl/getcurdt.p
     2488         (output v-curr-sv-date
     2489         ) .
     2490       assign
     2491         self :screen-value = string(v-curr-sv-date) .
     2492       .
     2493     end.
     2494     return no-apply.
     2495   end.
     2496   on ctrl-b of set-date in frame Dialog-Frame
     2497   do:
     2498     if (can-query (self, "sensitive")
     2499        and
     2500        self :sensitive = true
     2501        )
     2502     or (can-query (self, "read-only")
     2503        and
     2504        self :read-only = false
     2505        )
     2506     then do:
     2507       if self :handle <> focus :handle
     2508       then do:
     2509         apply "entry":u to self .
     2510       end.
     2511       define variable v-curr-sv-date as date no-undo .
     2512       define variable v-new-sv-date  as date no-undo .
     2513       assign
     2514         v-curr-sv-date = date(self :screen-value) no-error
     2515       .
     2516       if v-curr-sv-date = ?
     2517       then do:
     2518         run gbl/getcurdt.p
     2519           (output v-curr-sv-date
     2520           ) .
     2521       end.
     2522       if v-curr-sv-date <> ?
     2523       then do:
     2524         assign
     2525           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     2526         .
     2527         assign
     2528           self :screen-value = string(v-new-sv-date) .
     2529         .
     2530       end.
     2531     end.
     2532     return no-apply .
     2533   end.
     2534   on ctrl-e of set-date in frame Dialog-Frame
     2535   do:
     2536     if (can-query (self, "sensitive")
     2537        and
     2538        self :sensitive = true
     2539        )
     2540     or (can-query (self, "read-only")
     2541        and
     2542        self :read-only = false
     2543        )
     2544     then do:
     2545       if self :handle <> focus :handle
     2546       then do:
     2547         apply "entry":u to self .
     2548       end.
     2549       define variable v-curr-sv-date as date no-undo .
     2550       define variable v-new-sv-date  as date no-undo .
     2551       assign
     2552         v-curr-sv-date = date(self :screen-value) no-error
     2553       .
     2554       if v-curr-sv-date = ?
     2555       then do:
     2556         run gbl/getcurdt.p
     2557           (output v-curr-sv-date
     2558           ) .
     2559       end.
     2560       if v-curr-sv-date <> ?
     2561       then do:
     2562         run gbl/lastdate.p
     2563           (input  v-curr-sv-date
     2564           ,output v-new-sv-date
     2565           ).
     2566         assign
     2567           self :screen-value = string(v-new-sv-date) .
     2568         .
     2569       end.
     2570     end.
     2571     return no-apply .
     2572   end.
     2573   on ctrl-f of set-date in frame Dialog-Frame
     2574   do:
     2575     if (can-query (self, "sensitive")
     2576        and
     2577        self :sensitive = true
     2578        )
     2579     or (can-query (self, "read-only")
     2580        and
     2581        self :read-only = false
     2582        )
     2583     then do:
     2584       if self :handle <> focus :handle
     2585       then do:
     2586         apply "entry":u to self .
     2587       end.
     2588       define variable v-ok            as logical   no-undo .
     2589       define variable v-curr-sv-date  as date      no-undo .
     2590       define variable v-description   as character no-undo .
     2591       assign
     2592         v-curr-sv-date = date(self :screen-value) no-error
     2593       .
     2594       if v-curr-sv-date = ?
     2595       then do:
     2596         run gbl/getcurdt.p
     2597           (output v-curr-sv-date
     2598           ) .
     2599       end.
     2600       if v-curr-sv-date <> ?
     2601       then do:
     2602         run gbl/d-inpday.w
     2603           (input ?
     2604           ,input "Выбор даты"
     2605           ,input v-description
     2606           ,input ""
     2607           ,input-output v-curr-sv-date
     2608           ,output v-ok
     2609           ).
     2610         if v-ok = true
     2611         then do:
     2612           assign
     2613             self :screen-value = string(v-curr-sv-date) .
     2614           .
     2615         end.
     2616       end.
     2617     end.
     2618     return no-apply .
     2619   end.
     2620     define MENU m-ed-date12
     2621       MENU-ITEM m-ed-date12-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     2622       MENU-ITEM m-ed-date12-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     2623       MENU-ITEM m-ed-date12-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     2624       MENU-ITEM m-ed-date12-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     2625       .
     2626     if set-date :POPUP-MENU in frame Dialog-Frame = ?
     2627     then do:
     2628       ASSIGN
     2629         set-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date12 :HANDLE
     2630         set-date :MENU-MOUSE in frame Dialog-Frame = 3
     2631       .
     2632     end.
     2633     define variable v-label-handle12 as handle no-undo .
     2634     assign
     2635       v-label-handle12 = set-date :side-label-handle in frame Dialog-Frame
     2636     .
     2637     if valid-handle (v-label-handle12)
     2638     then do:
     2639       if v-label-handle12 :tooltip = ""
     2640       or v-label-handle12 :tooltip = ?
     2641       then do:
     2642         assign
     2643           v-label-handle12 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     2644         .
     2645       end.
     2646     end.
     2647     ON CHOOSE OF MENU-ITEM m-ed-date12-1 in menu m-ed-date12 DO:
     2648       apply "ctrl-b":U to set-date in frame Dialog-Frame .
     2649     END.
     2650     ON CHOOSE OF MENU-ITEM m-ed-date12-2 in menu m-ed-date12 DO:
     2651       apply "ctrl-d":U to set-date in frame Dialog-Frame .
     2652     END.
     2653     ON CHOOSE OF MENU-ITEM m-ed-date12-3 in menu m-ed-date12 DO:
     2654       apply "ctrl-e":U to set-date in frame Dialog-Frame .
     2655     END.
     2656     ON CHOOSE OF MENU-ITEM m-ed-date12-4 in menu m-ed-date12 DO:
     2657       apply "ctrl-f":U to set-date in frame Dialog-Frame .
     2658     END.
     2659   run diasize_add_browse in this-procedure
     2660     (input  'width':u
     2661     ,input  browse br-tax-rate :handle
     2662     ) .
     2663   run diasize_add_browse in this-procedure
     2664     (input  'width':u
     2665     ,input  browse BR-tax-rate-value :handle
     2666     ) .
     2667   MAIN-BLOCK:
     2668   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2669      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2670      define variable v-today as date      no-undo.
     2671      define variable v-time  as integer   no-undo.
     2672     if (partable-mode = "GOODS" and pargds-code = 0 and parnode-code = 0)  OR
     2673       (partable-mode = "GDS-GRP" and parnode-code = 0 ) then do:
     2674           message vss-workfile vss-revision vss-description skip
     2675           "Неверный параметры partable-mode и/или pargds-code и/или parnode-code"
     2676           view-as alert-box ERROR.
     2677           return error.
     2678       end.
     2679       if parhost-code = 0 or parobj-type = "" or parobj-code = 0 then do:
     2680           message vss-workfile vss-revision vss-description skip
     2681           "Неверный параметры parhost-code и/или parobj-type и/или parobj-code"
     2682           view-as alert-box ERROR.
     2683           return error.
     2684       end.
     2685       run initialize-table in this-procedure(0).
     2686     run fill-table in this-procedure(0, rs-date).
     2687     run MyEnable.
     2688     run cur-time in this-procedure ( output v-today                                   , output v-time                                   ).
     2689     var-rc = get-var-rc( v-today ).
     2690     run diasize_init in this-procedure .
     2691     WAIT-FOR GO OF FRAME Dialog-Frame.
     2692   END.
     2693   RUN disable_UI.
     2694   PROCEDURE disable_UI :
     2695     HIDE FRAME Dialog-Frame.
     2696   END PROCEDURE.
     2697   PROCEDURE enable_UI :
     2698     DISPLAY RS-date set-date
     2699         WITH FRAME Dialog-Frame.
     2700     ENABLE b-quit B-exit B-hist B-Help RS-date BR-tt-tax set-date B-ext B-selrate
     2701            B-restore BR-tax-rate BR-tax-rate-value
     2702         WITH FRAME Dialog-Frame.
     2703     VIEW FRAME Dialog-Frame.
     2704     OPEN QUERY BR-tt-tax FOR EACH output-tax       WHERE output-tax.individual = FALSE NO-LOCK.
     2705   END PROCEDURE.
     2706   PROCEDURE fill-table :
     2707   define input parameter partax-code like ub.tax.tax-code no-undo.
     2708   define input parameter parrs-date as integer no-undo.
     2709   define variable var-rate-value like ub.tax-rate-value.rate-value no-undo.
     2710   define variable varfact-date as date no-undo.
     2711   CASE parrs-date:
     2712       when 1 then do:
     2713           for each output-tax:
     2714             if partax-code = 0 or partax-code = output-tax.tax-code then do:
     2715               delete output-tax.
     2716             end.
     2717           end.
     2718           for each safe-tax no-lock:
     2719             if partax-code = 0 or partax-code = safe-tax.tax-code then do:
     2720               create output-tax.
     2721               buffer-copy safe-tax to output-tax.
     2722             end.
     2723           end.
     2724       end.
     2725       when 0 then do:
     2726         CASE partable-mode:
     2727           when "GOODS":U then do:
     2728             if pargds-code = 0 then return error.
     2729             run gds-all-history in this-procedure(pargds-code) no-error.
     2730             if error-status:error then return error.
     2731           end.
     2732           otherwise do:
     2733               return error.
     2734           end.
     2735         END CASE.
     2736       end.
     2737   end CASE.
     2738   END PROCEDURE.
     2739   PROCEDURE gds-all-history :
     2740   define input parameter locgds-code like ub.goods.gds-code no-undo.
     2741   define variable is-first as logical no-undo.
     2742   define variable nextfact-order like ub.tax-rate-gds.fact-order no-undo.
     2743   define variable max-fact-order like ub.tax-rate-gds.fact-order no-undo.
     2744   define variable var-rate-value like ub.tax-rate-value .rate-value no-undo.
     2745   DEFINE VARIABLE v-today as date no-undo .
     2746   DEFINE VARIABLE v-time as integer no-undo .
     2747   define buffer b_output-tax for output-tax.
     2748   for each output-tax:
     2749     delete output-tax.
     2750   end.
     2751   run cur-time in this-procedure ( output v-today                                   , output v-time                                   ).
     2752   run factord-max-fact-order in this-procedure(output max-fact-order) .
     2753   for each tt-tax No-LOCK
     2754            break by tt-tax.tax-code:
     2755     if first-of(tt-tax.tax-code) then do:
     2756       is-first = yes.
     2757       for each safe-tax No-LOCK WHERE
     2758                 safe-tax.tax-code = tt-tax.tax-code
     2759           BY safe-tax.fact-order descending:
     2760         IF safe-tax.rate-code <> tt-tax.rate-code OR safe-tax.fact-date > v-today then do:
     2761   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2762   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalo in g#library
     2763     (input  ?
     2764     ,input  tt-tax.tax-code
     2765     ,input  safe-tax.rate-code
     2766     ,input  safe-tax.fact-order
     2767     ,input  parhost-code
     2768     ,input  parobj-type
     2769     ,input  parobj-code
     2770     ,output var-rate-value
     2771     ) no-error .
     2772           create output-tax.
     2773           buffer-copy tt-tax except tax-rate-gds-rc to output-tax
     2774           assign
     2775           output-tax.rate-code = safe-tax.rate-code
     2776           output-tax.rate-value = var-rate-value
     2777           output-tax.fact-date = safe-tax.fact-date
     2778           output-tax.next-order = if is-first then max-fact-order else nextfact-order
     2779           output-tax.fact-order = safe-tax.fact-order
     2780           output-tax.tax-rate-gds-rc = if safe-tax.fact-date > v-today then ? else tt-tax.tax-rate-gds-rc
     2781           .
     2782           assign
     2783           is-first = no
     2784           nextfact-order = output-tax.fact-order
     2785           .
     2786         end.
     2787       END.
     2788       FOR each ub.tax-rate-gds No-lock where
     2789                 ub.tax-rate-gds.gds-coDe = locgds-code AND
     2790                 ub.tax-rate-gds.tax-code = tt-tax.tax-code AND
     2791                 ub.tax-rate-gds.host-code = 0 AND
     2792                 ub.tax-rate-gds.obj-type = "":U AND
     2793                 ub.tax-rate-gds.obj-code = 0
     2794                 BY ub.tax-rate-gds.fact-order descending:
     2795         FIND FIRST output-tax where
     2796                   output-tax.tax-code = tt-tax.tax-code AND
     2797                   output-tax.fact-order = ub.tax-rate-gds.fact-order No-ERROR.
     2798         if not avail output-tax then do:
     2799   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2800   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalo in g#library
     2801     (input  ?
     2802     ,input  ub.tax-rate-gds.tax-code
     2803     ,input  ub.tax-rate-gds.rate-code
     2804     ,input  ub.tax-rate-gds.fact-order
     2805     ,input  parhost-code
     2806     ,input  parobj-type
     2807     ,input  parobj-code
     2808     ,output var-rate-value
     2809     ) no-error .
     2810           create output-tax.
     2811           buffer-copy tt-tax except tax-rate-gds-rc to output-tax
     2812           assign
     2813           output-tax.rate-code = ub.tax-rate-gds.rate-code
     2814           output-tax.rate-value = var-rate-value
     2815           output-tax.fact-date = ub.tax-rate-gds.fact-date
     2816           output-tax.next-order = if is-first then max-fact-order else nextfact-order
     2817           output-tax.fact-order = ub.tax-rate-gds.fact-order
     2818           output-tax.tax-rate-gds-rc = (if ub.tax-rate-gds.fact-date = tt-tax.fact-date then tt-tax.tax-rate-gds-rc else ?)
     2819           .
     2820           assign
     2821           is-first = no
     2822           nextfact-order = output-tax.fact-order
     2823           .
     2824         end.
     2825       end.
     2826     end.
     2827   END.
     2828   for each output-tax No-LOCK:
     2829     var-rate-value = ?.
     2830     for each ub.tax-rate-value No-LOCK WHERE
     2831             ub.tax-rate-value.rate-code = output-tax.rate-code AND
     2832             ub.tax-rate-value.tax-code = output-tax.tax-code AND
     2833             ub.tax-rate-value.fact-order >= output-tax.fact-order AND
     2834             ub.tax-rate-value.fact-order < output-tax.next-order AND
     2835             ub.tax-rate-value.status_ = 'тек':U
     2836     break
     2837     by ub.tax-rate-value.fact-order
     2838     by ub.tax-rate-value.host-code
     2839     by ub.tax-rate-value.obj-type
     2840     by ub.tax-rate-value.obj-code
     2841     :
     2842       if ub.tax-rate-value.host-code = 0 OR
     2843           (ub.tax-rate-value.host-code = parhost-code
     2844           and ub.tax-rate-value.obj-code = 0
     2845           and ub.tax-rate-value.obj-type = "":U)
     2846           or
     2847           (ub.tax-rate-value.obj-type = parobj-type and
     2848           ub.tax-rate-value.obj-code = parobj-code) then do:
     2849           var-rate-value = ub.tax-rate-value.rate-value.
     2850       end.
     2851       if last-of(ub.tax-rate-value.fact-order) and var-rate-value <> ? then do:
     2852         FIND FIRST b_output-tax where
     2853                     b_output-tax.tax-code = output-tax.tax-code AND
     2854                     b_output-tax.fact-order = ub.tax-rate-value.fact-order No-ERROR.
     2855         if not avail b_output-tax then do:
     2856           create b_output-tax.
     2857           buffer-copy output-tax except tax-rate-gds-rc  to b_output-tax
     2858           assign
     2859           b_output-tax.rate-value = var-rate-value
     2860           b_output-tax.fact-date = ub.tax-rate-value.fact-date
     2861           b_output-tax.fact-order = ub.tax-rate-value.fact-order
     2862           .
     2863         end.
     2864       end.
     2865     end.
     2866   END.
     2867   END PROCEDURE.
     2868   PROCEDURE initialize-table :
     2869   define input parameter partax-code like ub.tax.tax-code no-undo.
     2870   for each safe-tax:
     2871     if partax-code = 0 or partax-code = safe-tax.tax-code then do:
     2872       delete safe-tax.
     2873     end.
     2874   end.
     2875   for each tt-tax no-lock:
     2876     if partax-code = 0 or partax-code = tt-tax.tax-code then do:
     2877       create safe-tax.
     2878       buffer-copy tt-tax to safe-tax.
     2879     end.
     2880   end.
     2881   END PROCEDURE.
     2882   PROCEDURE MyENable :
     2883   DEFINE VARIABLE v-today as date no-undo .
     2884   DEFINE VARIABLE v-time as integer no-undo .
     2885   find first ub.clients no-lock where
     2886              ub.clients.obj-type = 'орг':U and
     2887              ub.clients.obj-code = parhost-code No-error.
     2888   run cur-time in this-procedure ( output v-today                                   , output v-time                                   ).
     2889   ASSIGN
     2890   br-tt-tax:title in frame Dialog-Frame = par-title
     2891   set-date = v-today
     2892   set-date:visible in frame Dialog-Frame = if LOOKUP('ПРОСМОТР':U, parlist-mode) > 0 then no else yes
     2893   set-date:visible in frame Dialog-Frame = (partable-mode = "GOODS":U)
     2894   b-quit:label in frame Dialog-Frame  = if LOOKUP('ПРОСМОТР':U, parlist-mode) > 0 then "Выход" else b-quit:label
     2895   b-exit:visible in frame Dialog-Frame = if LOOKUP('ПРОСМОТР':U, parlist-mode) > 0 then no else yes
     2896   b-restore:visible in frame Dialog-Frame = no
     2897   b-restore:MENU-MOUSE in frame Dialog-Frame = 1
     2898   RS-date = 1
     2899   RS-date:visible in frame Dialog-Frame = (partable-mode = "GOODS":U)
     2900   frame Dialog-Frame:title = frame Dialog-Frame:title + chr(32) +
     2901                               "Фирма: " + (if avail ub.clients
     2902                                            then string(clients.obj-name, "x(30)")
     2903                                            else string(parhost-code)) + chr(32) +
     2904                               parobj-type + string(parobj-code)
     2905   .
     2906   if (partable-mode = "GOODS":U)
     2907   then
     2908   DISPLAY
     2909   RS-date
     2910   WITH FRAME Dialog-Frame.
     2911   if LOOKUP('ПРОСМОТР':U, parlist-mode) = 0 AND partable-mode = "GOODS":U then
     2912   display set-date
     2913   WITH FRAME Dialog-Frame.
     2914   ENABLE
     2915   B-exit when lookup('ПРОСМОТР':U, parlist-mode) = 0
     2916   b-quit
     2917   B-Help
     2918   b-hist WHEN partable-mode = "GOODS":U
     2919   B-selrate when lookup('ПРОСМОТР':U, parlist-mode) = 0
     2920   set-date when lookup('ПРОСМОТР':U, parlist-mode) = 0 and partable-mode = "GOODS":U
     2921   BR-tt-tax
     2922   BR-tax-rate
     2923   BR-tax-rate-value
     2924   B-ext
     2925   RS-date when ((pargds-code <> ? or parnode-code <> ?) AND partable-mode = "GOODS":U)
     2926   WITH FRAME Dialog-Frame.
     2927   VIEW FRAME Dialog-Frame.
     2928   OPEN QUERY BR-tt-tax FOR EACH output-tax       WHERE output-tax.individual = FALSE NO-LOCK.
     2929   var-rc = get-var-rc( v-today ).
     2930   APPLY "Value-changed" to br-tt-tax.
     2931   APPLY "ENTRY" to br-tax-rate.
     2932   END PROCEDURE.
     2933   PROCEDURE OpenBr-tax-rate :
     2934   define variable locvar-rc as recid     no-undo.
     2935   define variable v-today   as date      no-undo.
     2936   define variable v-time    as integer   no-undo.
     2937   define buffer b_tax-rate for ub.tax-rate.
     2938   Open query br-tax-rate for each ub.tax-rate where
     2939   ub.tax-rate.tax-code = output-tax.tax-code.
     2940   run cur-time in this-procedure ( output v-today                                   , output v-time                                   ).
     2941   assign
     2942       var-rc = get-var-rc( v-today )
     2943   .
     2944   find first b_tax-rate No-LOCK WHERE
     2945               b_tax-rate.rate-code = output-tax.rate-code AND
     2946               b_tax-rate.tax-code = output-tax.tax-code no-error.
     2947   if avail b_tax-rate then do:
     2948       locvar-rc = recid(b_tax-rate).
     2949   end.
     2950   reposition br-tax-rate to recid locvar-rc no-error.
     2951   APPLY "VALUE-CHANGED" to br-tax-rate in frame Dialog-Frame.
     2952   END PROCEDURE.
     2953   PROCEDURE OpenBr-tax-rate-value :
     2954   define input parameter par-date-option as integer no-undo.
     2955   define var var-tt-rc as recid.
     2956   define var var-fact-order like ub.tax-rate-value.fact-order no-undo.
     2957   define var var-reg as integer no-undo.
     2958   define var curvar-rc as recid no-undo.
     2959   define var upnode-rc as recid no-undo.
     2960   DEFINE VARIABLE v-today as date no-undo .
     2961   DEFINE VARIABLE v-time as integer no-undo .
     2962   define variable loc#log as logical no-undo .
     2963   define buffer b_tax-rate-value for ub.tax-rate-value.
     2964   define buffer b_tt-tax-rate-value for tt-tax-rate-value.
     2965   run cur-time in this-procedure ( output v-today                                   , output v-time                                   ).
     2966   run factord-end-day in this-procedure (input v-today, output var-fact-order).
     2967   for each tt-tax-rate-value:
     2968       delete tt-tax-rate-value.
     2969   end.
     2970   find last b_tax-rate-value No-LOCK WHERE
     2971               b_tax-rate-value.rate-code = ub.tax-rate.rate-code AND
     2972               b_tax-rate-value.tax-code = ub.tax-rate.tax-code AND
     2973               b_tax-rate-value.host-code = parhost-code AND
     2974               b_tax-rate-value.obj-type = parobj-type AND
     2975               b_tax-rate-value.obj-code = parobj-code AND
     2976               b_tax-rate-value.fact-order <= var-fact-order AND
     2977               b_tax-rate-value.status_ = 'тек':U
     2978               no-error.
     2979   if avail b_tax-rate-value then do:
     2980       assign
     2981       var-reg = 2
     2982       curvar-rc = recid(b_tax-rate-value)
     2983           .
     2984   end.
     2985   else do:
     2986       find last b_tax-rate-value No-LOCK WHERE
     2987               b_tax-rate-value.rate-code = ub.tax-rate.rate-code AND
     2988               b_tax-rate-value.tax-code = ub.tax-rate.tax-code AND
     2989               b_tax-rate-value.host-code = parhost-code AND
     2990               b_tax-rate-value.obj-type = "":U AND
     2991               b_tax-rate-value.obj-code = 0 AND
     2992               b_tax-rate-value.fact-order <= var-fact-order AND
     2993               b_tax-rate-value.status_ = 'тек':U
     2994               no-error.
     2995       if avail b_tax-rate-value then do:
     2996           assign
     2997           var-reg = 1
     2998             curvar-rc = recid(b_tax-rate-value)
     2999                   .
     3000       end.
     3001       else do:
     3002           find last b_tax-rate-value No-LOCK WHERE
     3003                   b_tax-rate-value.rate-code = ub.tax-rate.rate-code AND
     3004                   b_tax-rate-value.tax-code = ub.tax-rate.tax-code AND
     3005                   b_tax-rate-value.host-code = 0 AND
     3006                   b_tax-rate-value.obj-type = "":U AND
     3007                   b_tax-rate-value.obj-code = 0 AND
     3008                   b_tax-rate-value.fact-order <= var-fact-order AND
     3009                   b_tax-rate-value.status_ = 'тек':U
     3010                   no-error.
     3011           if avail b_tax-rate-value then do:
     3012               assign
     3013               var-reg = 0
     3014               curvar-rc = recid(b_tax-rate-value)
     3015               .
     3016           end.
     3017           else do:
     3018               assign
     3019               var-reg = -1
     3020               curvar-rc = ?
     3021               .
     3022           end.
     3023       end.
     3024   end.
     3025   CASE par-date-option:
     3026       when 0 then do:
     3027       for each ub.tax-rate-value where
     3028               ub.tax-rate-value.tax-code = ub.tax-rate.tax-code AND
     3029               ub.tax-rate-value.rate-code = ub.tax-rate.rate-code AND
     3030               ub.tax-rate-value.host-code = 0 AND
     3031               ub.tax-rate-value.obj-type = "" AND
     3032               ub.tax-rate-value.obj-code = 0
     3033               :
     3034       create
     3035       tt-tax-rate-value.
     3036       buffer-copy ub.tax-rate-value to tt-tax-rate-value
     3037       assign
     3038       tt-tax-rate-value.rc = recid(ub.tax-rate-value)
     3039       .
     3040       end.
     3041     end.
     3042     when 1 then do:
     3043       FIND LAST ub.tax-rate-value where
     3044               ub.tax-rate-value.tax-code = ub.tax-rate.tax-code AND
     3045               ub.tax-rate-value.rate-code = ub.tax-rate.rate-code AND
     3046               ub.tax-rate-value.host-code = 0 AND
     3047               ub.tax-rate-value.obj-type = "" AND
     3048               ub.tax-rate-value.obj-code = 0 AND
     3049               ub.tax-rate-value.fact-order <= var-fact-order AND
     3050               ub.tax-rate-value.status_ = 'тек':U No-ERROR.
     3051       if avail ub.tax-rate-value then  do:
     3052           create
     3053           tt-tax-rate-value.
     3054           buffer-copy ub.tax-rate-value to tt-tax-rate-value
     3055           assign
     3056           tt-tax-rate-value.rc = recid(ub.tax-rate-value)
     3057           .
     3058       end.
     3059     end.
     3060   END CASE.
     3061   if var-reg = 1 or var-reg = 2 then do:
     3062       for each ub.tax-rate-value where
     3063               ub.tax-rate-value.tax-code = ub.tax-rate.tax-code AND
     3064               ub.tax-rate-value.rate-code = ub.tax-rate.rate-code AND
     3065               ub.tax-rate-value.host-code > 0 AND
     3066               ub.tax-rate-value.obj-type = "" AND
     3067               ub.tax-rate-value.obj-code = 0 AND
     3068               (par-date-option = 0 or ub.tax-rate-value.fact-order <= var-fact-order)
     3069       break
     3070       by ub.tax-rate-value.host-code
     3071       by ub.tax-rate-value.obj-type
     3072       by ub.tax-rate-value.obj-code
     3073       by ub.tax-rate-value.fact-order
     3074       by ub.tax-rate-value.status_
     3075                     :
     3076         if par-date-option = 0 or last-of(ub.tax-rate-value.obj-code) then do:
     3077             create
     3078             tt-tax-rate-value.
     3079             buffer-copy ub.tax-rate-value to tt-tax-rate-value
     3080             assign
     3081             tt-tax-rate-value.rc = recid(ub.tax-rate-value)
     3082             .
     3083         end.
     3084       end.
     3085      for each tt-tax-rate-value where
     3086               tt-tax-rate-value.tax-code = ub.tax-rate.tax-code AND
     3087               tt-tax-rate-value.rate-code = ub.tax-rate.rate-code AND
     3088               tt-tax-rate-value.host-code = 0:
     3089       tt-tax-rate-value.exp = yes.
     3090      end.
     3091   end.
     3092   if var-reg = 2 then do:
     3093       for each ub.tax-rate-value where
     3094               ub.tax-rate-value.tax-code = ub.tax-rate.tax-code AND
     3095               ub.tax-rate-value.rate-code = ub.tax-rate.rate-code AND
     3096               ub.tax-rate-value.host-code = parhost-code AND
     3097               ub.tax-rate-value.obj-type <> "" AND
     3098               ub.tax-rate-value.obj-code <> 0 AND
     3099               (par-date-option = 0 or ub.tax-rate-value.fact-order <= var-fact-order)
     3100       break
     3101       by ub.tax-rate-value.host-code
     3102       by ub.tax-rate-value.obj-type
     3103       by ub.tax-rate-value.obj-code
     3104       by ub.tax-rate-value.fact-order
     3105       by ub.tax-rate-value.status_
     3106       :
     3107       if par-date-option = 0 or last-of(ub.tax-rate-value.obj-code) then do:
     3108           create
     3109           tt-tax-rate-value.
     3110           buffer-copy ub.tax-rate-value to tt-tax-rate-value
     3111           assign
     3112           tt-tax-rate-value.rc = recid(ub.tax-rate-value)
     3113           .
     3114       end.
     3115     end.
     3116     for each tt-tax-rate-value where
     3117           tt-tax-rate-value.tax-code = ub.tax-rate.tax-code AND
     3118           tt-tax-rate-value.rate-code = ub.tax-rate.rate-code AND
     3119           tt-tax-rate-value.host-code = parhost-code :
     3120        tt-tax-rate-value.exp = yes.
     3121     end.
     3122   end.
     3123   find first b_tt-tax-rate-value where
     3124       b_tt-tax-rate-value.rc = curvar-rc no-lock no-error.
     3125       if avail b_tt-tax-rate-value then
     3126       var-tt-rc = recid(b_tt-tax-rate-value).
     3127   open query br-tax-rate-value for each tt-tax-rate-value no-lock.
     3128   reposition br-tax-rate-value to recid var-tt-rc no-error.
     3129   if br-tax-rate-value:focused-row in frame Dialog-Frame = 1 then do:
     3130       loc#log = br-tax-rate-value:SELECT-PREV-ROW( ) .
     3131       if loc#log then do:
     3132           APPLY "CURSOR-DOWN" to br-tax-rate-value.
     3133       end.
     3134   end.
     3135   END PROCEDURE.
     3136   PROCEDURE proc-b-restore :
     3137   define input parameter par-fill-table-option as integer no-undo.
     3138   define variable v-today as date      no-undo.
     3139   define variable v-time  as integer   no-undo.
     3140     RUn initialize-table(par-fill-table-option) no-error.
     3141    RUn fill-table(par-fill-table-option, 1) no-error.
     3142    if error-status:error then do:
     3143       fill-table-option = -1.
     3144       return error.
     3145    end.
     3146    Open query br-tt-tax for each output-tax NO-LOCK WHERE output-tax.individual = FALSE.
     3147    run cur-time in this-procedure ( output v-today                                   , output v-time                                   ).
     3148    assign
     3149       var-rc = get-var-rc( v-today )
     3150    .
     3151   Run openbr-tax-rate no-error.
     3152    if error-status:error then do:
     3153       return error.
     3154    end.
     3155   Run openbr-tax-rate-value(RS-date) no-error.
     3156    if error-status:error then do:
     3157       return error.
     3158    end.
     3159   END PROCEDURE.
     3160   PROCEDURE proc-b-selrate :
     3161   define variable vartax-value like ub.tax-rate-value.rate-value no-undo.
     3162   define variable curtax-rc as recid no-undo.
     3163   define variable var-fact-order like ub.tax-rate-gds.fact-order no-undo.
     3164   define variable loc#log as logical no-undo .
     3165   define buffer b_output-tax for output-tax.
     3166   DEFINE VARIABLE var-old-date as date no-undo .
     3167   DEFINE VARIABLE var-old-order like ub.tax-rate-gds.fact-order no-undo .
     3168   DEFINE VARIABLE v-today as date no-undo .
     3169   DEFINE VARIABLE v-time as integer no-undo .
     3170     curtax-rc  = recid(output-tax).
     3171     run cur-time in this-procedure ( output v-today                                   , output v-time                                   ).
     3172     run factord-end-day in this-procedure (input set-date, output var-fact-order).
     3173     var-old-date = output-tax.fact-date.
     3174     if var-old-date <> ? then
     3175     run factord-end-day in this-procedure (input var-old-date, output var-old-order).
     3176     CASE set-date:
     3177       when v-today then do:
     3178         find first b_output-tax where
     3179                     recid(b_output-tax) = recid(output-tax) No-ERROR.
     3180       end.
     3181       otherwise do:
     3182         find first b_output-tax where
     3183                    b_output-tax.tax-code = ub.tax-rate.tax-code AND
     3184                    b_output-tax.rate-code = ub.tax-rate.rate-code AND
     3185                    b_output-tax.fact-order = var-fact-order No-ERROR.
     3186         if not avail b_output-tax then do:
     3187           find first b_output-tax where
     3188                     b_output-tax.tax-code = ub.tax-rate.tax-code AND
     3189                     b_output-tax.fact-order = var-fact-order No-ERROR.
     3190           if not avail b_output-tax then do:
     3191             create b_output-tax.
     3192           end.
     3193         end.
     3194       end.
     3195     END CASE.
     3196   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3197   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     3198     (input  recid(ub.tax-rate)
     3199     ,input  0
     3200     ,input  0
     3201     ,input  ?
     3202     ,input  parhost-code
     3203     ,input  parobj-type
     3204     ,input  parobj-code
     3205     ,output vartax-value
     3206     ) no-error .
     3207     if error-status:error or vartax-value = ? then do:
     3208        message "Неверное значение по ставке налога" view-as alert-box ERROR.
     3209        return error.
     3210     end.
     3211     buffer-copy output-tax except tax-rate-gds-rc to b_output-tax
     3212     assign
     3213     b_output-tax.rate-code = ub.tax-rate.rate-code
     3214     b_output-tax.rate-value = vartax-value
     3215     b_output-tax.fact-date = (if partable-mode = "GOODS":U then set-date else ?)
     3216     b_output-tax.fact-order = var-fact-order
     3217     .
     3218     if new(b_output-tax) then do:
     3219       create safe-tax.
     3220     end.
     3221     else do:
     3222       find first safe-tax where
     3223                  safe-tax.tax-code = b_output-tax.tax-code AND
     3224                  (safe-tax.fact-order = var-old-order or partable-mode = "GDS-GRP":U) No-ERROR.
     3225       if not avail safe-tax then do:
     3226         return error.
     3227       end.
     3228     end.
     3229     buffer-copy output-tax except tax-rate-gds-rc to safe-tax
     3230     assign
     3231     safe-tax.rate-code = ub.tax-rate.rate-code
     3232     safe-tax.rate-value = vartax-value
     3233     safe-tax.fact-date = (if partable-mode = "GOODS":U then set-date else ?)
     3234     safe-tax.fact-order = var-fact-order
     3235     .
     3236     var-rc = get-var-rc( v-today ).
     3237     Open query br-tt-tax for each output-tax No-LOCK WHERE output-tax.individual = FALSE.
     3238     REPOSITION br-tt-tax to recid curtax-rc No-ERROR.
     3239     if br-tt-tax:focused-row in frame Dialog-Frame = 1 then do:
     3240       loc#log = br-tt-tax:SELECT-PREV-ROW( ) .
     3241       if loc#log then do:
     3242           APPLY "CURSOR-DOWN" to br-tt-tax.
     3243       end.
     3244     end.
     3245     Run openbr-tax-rate.
     3246     Run openbr-tax-rate-value(RS-date).
     3247   END PROCEDURE.
     3248   PROCEDURE proc-ext :
     3249   define input parameter par-rc as recid no-undo.
     3250   define input parameter par-date-option as integer no-undo.
     3251   define var var-tt-rc as recid no-undo.
     3252   define var var-fact-order like ub.tax-rate-value.fact-order no-undo.
     3253   DEFINE VARIABLE v-today as date no-undo .
     3254   DEFINE VARIABLE v-time as integer no-undo .
     3255   define buffer b_tt-tax-rate-value for tt-tax-rate-value.
     3256   if tt-tax-rate-value.host-code <> 0 and
     3257      tt-tax-rate-value.obj-type <> "":U and
     3258      tt-tax-rate-value.obj-code <> 0 THEN do:
     3259      BELL.
     3260      return error.
     3261   end.
     3262   run cur-time in this-procedure ( output v-today                                   , output v-time                                   ).
     3263   run factord-end-day in this-procedure (input v-today, output var-fact-order).
     3264   var-tt-rc = recid(tt-tax-rate-value).
     3265   IF tt-tax-rate-value.host-code = 0 then do:
     3266     if tt-tax-rate-value.exp = yes then do:
     3267       FIND FIRST b_tt-tax-rate-value where
     3268                  b_tt-tax-rate-value.rc = par-rc No-ERROR.
     3269       if avail b_tt-tax-rate-value and
     3270                b_tt-tax-rate-value.tax-code = tt-tax-rate-value.tax-code AND
     3271                b_tt-tax-rate-value.rate-code = tt-tax-rate-value.rate-code
     3272       then.
     3273       else do:
     3274         FOR EACH b_tt-tax-rate-value where
     3275                 b_tt-tax-rate-value.tax-code = tt-tax-rate-value.tax-code AND
     3276                 b_tt-tax-rate-value.rate-code = tt-tax-rate-value.rate-code AND
     3277                 b_tt-tax-rate-value.host-code <> 0:
     3278           delete b_tt-tax-rate-value.
     3279         END.
     3280         find first b_tt-tax-rate-value where
     3281                    recid(b_tt-tax-rate-value) = recid(tt-tax-rate-value) No-ERROR.
     3282         if avail b_tt-tax-rate-value then do:
     3283           b_tt-tax-rate-value.exp = no.
     3284         end.
     3285       end.
     3286     end.
     3287     else do:
     3288       FOR EACH ub.tax-rate-value NO-LOCK where
     3289                ub.tax-rate-value.tax-code = tt-tax-rate-value.tax-code AND
     3290                ub.tax-rate-value.rate-code = tt-tax-rate-value.rate-code AND
     3291                ub.tax-rate-value.host-code <> 0 AND
     3292                ub.tax-rate-value.obj-type = "" AND
     3293                ub.tax-rate-value.obj-code = 0 AND
     3294               (par-date-option = 0 or ub.tax-rate-value.fact-order <= var-fact-order)
     3295       break
     3296       by ub.tax-rate-value.host-code
     3297       by ub.tax-rate-value.obj-type
     3298       by ub.tax-rate-value.obj-code
     3299       by ub.tax-rate-value.fact-order
     3300       by ub.tax-rate-value.status_
     3301       :
     3302         if par-date-option = 0 or last-of(ub.tax-rate-value.obj-code) then do:
     3303           create
     3304           b_tt-tax-rate-value.
     3305           buffer-copy ub.tax-rate-value to b_tt-tax-rate-value
     3306           assign
     3307           b_tt-tax-rate-value.rc = recid(ub.tax-rate-value)
     3308           .
     3309         end.
     3310       end.
     3311       find first b_tt-tax-rate-value where
     3312                   recid(b_tt-tax-rate-value) = recid(tt-tax-rate-value) No-ERROR.
     3313       if avail b_tt-tax-rate-value then do:
     3314           b_tt-tax-rate-value.exp = yes.
     3315       end.
     3316     end.
     3317   end.
     3318   else do:
     3319     if tt-tax-rate-value.exp = yes then do:
     3320       FIND FIRST b_tt-tax-rate-value where
     3321                  b_tt-tax-rate-value.rc = par-rc No-ERROR.
     3322       if avail b_tt-tax-rate-value and
     3323                b_tt-tax-rate-value.rate-code = tt-tax-rate-value.rate-code AND
     3324                b_tt-tax-rate-value.tax-code = tt-tax-rate-value.tax-code AND
     3325                b_tt-tax-rate-value.host-code = tt-tax-rate-value.host-code
     3326       then.
     3327       else do:
     3328         FOR EACH b_tt-tax-rate-value where
     3329                 b_tt-tax-rate-value.tax-code = tt-tax-rate-value.tax-code AND
     3330                 b_tt-tax-rate-value.rate-code = tt-tax-rate-value.rate-code AND
     3331                 b_tt-tax-rate-value.host-code = tt-tax-rate-value.host-code AND
     3332                 b_tt-tax-rate-value.obj-type <> "" and
     3333                 b_tt-tax-rate-value.obj-code <> 0:
     3334           delete b_tt-tax-rate-value.
     3335         END.
     3336         find first b_tt-tax-rate-value where
     3337                    recid(b_tt-tax-rate-value) = recid(tt-tax-rate-value) No-ERROR.
     3338         if avail b_tt-tax-rate-value then do:
     3339                   b_tt-tax-rate-value.exp = no.
     3340         end.
     3341       end.
     3342     end.
     3343     else do:
     3344       FOR EACH ub.tax-rate-value NO-LOCK where
     3345           ub.tax-rate-value.tax-code = tt-tax-rate-value.tax-code AND
     3346           ub.tax-rate-value.rate-code = tt-tax-rate-value.rate-code AND
     3347           ub.tax-rate-value.host-code = tt-tax-rate-value.host-code AND
     3348           ub.tax-rate-value.obj-type <> "" AND
     3349           ub.tax-rate-value.obj-code <> 0 AND
     3350           (par-date-option = 0 or ub.tax-rate-value.fact-order <= var-fact-order)
     3351       break
     3352       by ub.tax-rate-value.host-code
     3353       by ub.tax-rate-value.obj-type
     3354       by ub.tax-rate-value.obj-code
     3355       by ub.tax-rate-value.fact-order
     3356       by ub.tax-rate-value.status_
     3357       :
     3358         if par-date-option = 0 or last-of(ub.tax-rate-value.obj-code) then do:
     3359           create
     3360           b_tt-tax-rate-value.
     3361           buffer-copy ub.tax-rate-value to b_tt-tax-rate-value
     3362           assign
     3363           b_tt-tax-rate-value.rc = recid(ub.tax-rate-value)
     3364           .
     3365         end.
     3366       end.
     3367       find first b_tt-tax-rate-value where
     3368                  recid(b_tt-tax-rate-value) = recid(tt-tax-rate-value) No-ERROR.
     3369       if avail b_tt-tax-rate-value then do:
     3370                b_tt-tax-rate-value.exp = yes.
     3371       end.
     3372     END.
     3373   end.
     3374   open query br-tax-rate-value for each tt-tax-rate-value no-lock.
     3375   reposition br-tax-rate-value to recid var-tt-rc no-error.
     3376   END PROCEDURE.
     3377   FUNCTION get-mark0 RETURNS LOGICAL
     3378     ( buffer loc-output-tax for output-tax ) :
     3379   DEFINE VARIABLE v-today as date no-undo .
     3380   DEFINE VARIABLE v-time as integer no-undo .
     3381   run cur-time in this-procedure ( output v-today                                   , output v-time                                   ).
     3382   if loc-output-tax.tax-rate-gds-rc <> ? or
     3383      (parlist-mode = 'ДОБАВЛЕНИЕ':U and
     3384      partable-mode = 'GOODS':U and loc-output-tax.fact-date = v-today)
     3385      then return true.
     3386     RETURN FALSE.
     3387   END FUNCTION.
     3388   FUNCTION get-var-rc RETURNS RECID
     3389     ( input locpar-date as date) :
     3390   define var locvar-rc as recid no-undo.
     3391   define var var-fact-order like ub.tax-rate-value.fact-order no-undo.
     3392   define buffer b_tax-rate-value for ub.tax-rate-value.
     3393   run factord-end-day in this-procedure (input locpar-date, output var-fact-order).
     3394   find last b_tax-rate-value No-LOCK WHERE
     3395               b_tax-rate-value.rate-code = output-tax.rate-code AND
     3396               b_tax-rate-value.tax-code = output-tax.tax-code AND
     3397               b_tax-rate-value.host-code = parhost-code AND
     3398               b_tax-rate-value.obj-type = parobj-type AND
     3399               b_tax-rate-value.obj-code = parobj-code AND
     3400               b_tax-rate-value.fact-order <= var-fact-order AND
     3401               b_tax-rate-value.status_ = 'тек':U
     3402               no-error.
     3403   if avail b_tax-rate-value then do:
     3404       assign
     3405       locvar-rc = recid(b_tax-rate-value)
     3406           .
     3407   end.
     3408   else do:
     3409       find last b_tax-rate-value No-LOCK WHERE
     3410               b_tax-rate-value.rate-code = output-tax.rate-code AND
     3411               b_tax-rate-value.tax-code = output-tax.tax-code AND
     3412               b_tax-rate-value.host-code = parhost-code AND
     3413               b_tax-rate-value.obj-type = "":U AND
     3414               b_tax-rate-value.obj-code = 0 AND
     3415               b_tax-rate-value.fact-order <= var-fact-order AND
     3416               b_tax-rate-value.status_ = 'тек':U
     3417               no-error.
     3418       if avail b_tax-rate-value then do:
     3419           assign
     3420           locvar-rc = recid(b_tax-rate-value)
     3421                   .
     3422       end.
     3423       else do:
     3424           find last b_tax-rate-value No-LOCK WHERE
     3425                   b_tax-rate-value.rate-code = output-tax.rate-code AND
     3426                   b_tax-rate-value.tax-code = output-tax.tax-code AND
     3427                   b_tax-rate-value.host-code = 0 AND
     3428                   b_tax-rate-value.obj-type = "":U AND
     3429                   b_tax-rate-value.obj-code = 0 AND
     3430                   b_tax-rate-value.fact-order <= var-fact-order AND
     3431                   b_tax-rate-value.status_ = 'тек':U
     3432                   no-error.
     3433           if avail b_tax-rate-value then do:
     3434               assign
     3435                           locvar-rc = recid(b_tax-rate-value)
     3436                           .
     3437           end.
     3438           else do:
     3439               assign
     3440               locvar-rc = ?
     3441               .
     3442           end.
     3443       end.
     3444   end.
     3445   RETURN locvar-rc.
     3446   END FUNCTION.
