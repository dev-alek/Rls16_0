        1   block-level on error undo, throw.
        2   define input-output parameter p-doc-rec as recid no-undo.
        3   define input parameter p-mode            as character no-undo .
        4   define input parameter p-deliv-type-code like ub.delivery-type.deliv-type-code no-undo .
        5   define input parameter p-deliv-type-name like ub.delivery-type.deliv-type-name no-undo .
        6   define input parameter p-des like ub.delivery-type.des no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: dlvtype1.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: ref/dlvtype1.p $":U .
       12   define variable vss-description as character no-undo init "Сохранение изменений в карточке типа доставки".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable v-db-num like ub.db.db-num no-undo .
       83   if p-mode <> 'ДОБАВЛЕНИЕ':U
       84   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
       85     message
       86     vss-workfile vss-revision vss-description skip
       87     "Неверный параметр p-mode" p-mode
       88     view-as alert-box error .
       89     return error '':u.
       90   end.
       91   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
       93     (output v-db-num
       94     )  .
       95   if v-db-num <> 0 then do:
       96     run err-mess (substitute("Нельзя изменять запись ТИП ДОСТАВКИ в УБД: Номер текущей БД &1"
       97                   , v-db-num) ).
       98     undo, return error "":U.
       99   end.
      100   if p-deliv-type-name = "":U then do:
      101     run err-mess ("Название ТИПА ДОСТАВКИ не может быть пустым").
      102     return error "deliv-type-name":U.
      103   end.
      104   _MAIN:
      105   DO ON ERROR UNDO, RETURN ERROR
      106   ON STOP UNDO, RETURN ERROR:
      107     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      108       create ub.delivery-type.
      109       assign
      110       ub.delivery-type.deliv-type-code = next-value(delivery, ub)
      111       p-doc-rec = recid(ub.delivery-type)
      112       .
      113     end.
      114     else do:
      115       FIND FIRST ub.delivery-type where
      116                 recid(ub.delivery-type) = p-doc-rec No-ERROR.
      117       if not available ub.delivery-type then do:
      118         message
      119         vss-workfile vss-revision vss-description skip
      120         "Не найдена запись ТИП ДОСТАВКИ - p-doc-rec" p-doc-rec
      121         view-as alert-box error .
      122         undo, return error '':u.
      123       end.
      124       if ub.delivery-type.deliv-type-code <> p-deliv-type-code
      125       then do:
      126         message
      127         vss-workfile vss-revision vss-description skip
      128         "Для уже имеющейся записи нельзя изменить"
      129         "внутренний код" skip
      130         view-as alert-box ERROR.
      131         undo, return error '':U.
      132       end.
      133     end.
      134     assign
      135     ub.delivery-type.deliv-type-name     = p-deliv-type-name
      136     ub.delivery-type.des                 = p-des
      137     ub.delivery-type.sts                 =  (if p-mode = 'ДОБАВЛЕНИЕ':U
      138                                then 0
      139                                else ub.delivery-type.sts)
      140     .
      141     release ub.delivery-type no-error.
      142     if error-status:error then do:
      143        run err-mess(substitute("Ошибка при сохранении записи ТИП ДОСТАВКИ с кодом &1: &2: &3"
      144                                , p-deliv-type-code
      145                                , ERROR-STATUS:GET-message(1)
      146                                , return-value
      147                                )).
      148       undo, return error "":U.
      149    end.
      150   end.
      151   PROCEDURE err-mess:
      152     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
      153         message
      154         p-mess
      155         view-as alert-box error .
      156   END PROCEDURE.
