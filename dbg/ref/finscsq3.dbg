      645       OPEN QUERY br-fin-statement FOR EACH X_fin-statement
      646         where  X_fin-statement.host-code  = p-curr-host-code                      AND X_fin-statement.status_  = p-status_                      AND X_fin-statement.fins-ext-doc-type  = p-fins-ext-doc-type                      AND (X_fin-statement.doc-date  >= p-start-date  AND                         X_fin-statement.doc-date  <= p-end-date)
