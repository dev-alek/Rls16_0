     1519       define variable  parameter-2-15 as character no-undo .
     1520       define variable  parameter-3-15 as character no-undo .
     1521       define variable  parameter-4-15 as character no-undo .
     1522       define variable  parameter-5-15 as character no-undo .
     1523       define variable  parameter-6-15 as character no-undo .
     1524       define variable  parameter-7-15 as character no-undo .
     1525         assign
     1526         parameter-3-15 =
     1527                                 "FOR EACH X_fin-statement"
     1528         parameter-4-15 =
     1529           (
     1530             if (" X_fin-statement.host-code  = p-curr-host-code                      AND X_fin-statement.status_  = p-status_                      AND X_fin-statement.fins-ext-doc-type  = p-fins-ext-doc-type            " + " " + where-phrase-15) <> ""
     1531             then  substitute('X_fin-statement.host-code  = &1                      AND X_fin-statement.status_  = &2&3&2                      AND X_fin-statement.fins-ext-doc-type  = &2&4&2', p-curr-host-code, chr(34), p-status_, p-fins-ext-doc-type) + " " + where-phrase-15
     1532             else "true"
     1533           )
     1534         parameter-5-15 = (" " + "" + " " + "")
     1535         parameter-6-15 = if sort-phrase-15 = ''
     1536                              then
     1537           (
     1538           " " + "  " +
     1539             " " + sort-column-phrase +
     1540           " " + " by X_fin-statement.host-code by X_fin-statement.end-date descending "
     1541           )
     1542                              else
     1543           (
     1544           " " + "  " +
     1545             " " + sort-column-phrase +
     1546           " " + sort-phrase-15
     1547           )
     1548         parameter-7-15 =
     1549           " indexed-reposition  "
     1550       .
     1551       do
     1552       on stop undo, leave
     1553       on error undo, leave
     1554       :
     1555         assign
     1556           l-disable-where-15 =
     1557             (" X_fin-statement.host-code  = p-curr-host-code                      AND X_fin-statement.status_  = p-status_                      AND X_fin-statement.fins-ext-doc-type  = p-fins-ext-doc-type            " + " " + where-phrase-15 = "")
     1558         .
     1559         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     1560                             ,input QUERY br-fin-statement:handle
     1561                             ,input parameter-3-15
     1562                             ,input parameter-4-15
     1563                             ,input parameter-5-15
     1564                             ,input parameter-6-15
     1565                             ,input parameter-7-15
     1566                             )
     1567         .
     1568         assign
     1569           l-filter-open-15 = true
     1570         .
     1571       end.
     1572       if l-filter-open-15 = false then do:
     1573         message
     1574           "Ошибка при фильтрации / сортировке" skip
     1575           "Будут показаны записи без учета фильтра" skip
     1576           view-as alert-box .
     1577       end.
     1578       else do:
     1579           assign
     1580             l-query-was-opened = true
     1581           .
     1582       end.
     1583     end.
     1584     if l-filter-open-15 = false then do:
     1585       OPEN QUERY br-fin-statement FOR EACH X_fin-statement
     1586         where  X_fin-statement.host-code  = p-curr-host-code                      AND X_fin-statement.status_  = p-status_                      AND X_fin-statement.fins-ext-doc-type  = p-fins-ext-doc-type
     1587          by X_fin-statement.host-code by X_fin-statement.end-date descending
     1588         indexed-reposition
     1589     .
     1590         assign
     1591           l-query-was-opened = true
     1592         .
     1593     end.
     1594   end.
     1595   else do:
     1596     assign
     1597       v-doc-rec = recid( X_fin-statement )
     1598     .
     1599     do
     1600     on stop undo, leave
     1601     on error undo, leave
     1602     :
     1603       if QUERY br-fin-statement:handle:get-buffer-handle(1) = (buffer X_fin-statement:handle) then do:
     1604         assign
     1605         parameter-2-15 = (if p-find-next then "true":u else "false":u )
     1606         parameter-4-15 =
     1607           "where ":u +  substitute('X_fin-statement.host-code  = &1                      AND X_fin-statement.status_  = &2&3&2                      AND X_fin-statement.fins-ext-doc-type  = &2&4&2', p-curr-host-code, chr(34), p-status_, p-fins-ext-doc-type) + " ":u + where-phrase-15 + " ":u + p-find-condition + " " + ""
     1608         parameter-5-15 = "  "
     1609       .
     1610         run fltopend_fltfindd in this-procedure  (
     1611                             input this-procedure:handle
     1612                             ,input QUERY br-fin-statement:handle
     1613                             ,input rowid(X_fin-statement)
     1614                             ,input logical(parameter-2-15)
     1615                             ,input no-lock
     1616                             ,input (buffer X_fin-statement:handle)
     1617                             ,input parameter-4-15
     1618                             ,input parameter-5-15
     1619                             ) no-error.
     1620         .
     1621         assign
     1622           v-doc-rec = integer(return-value)
     1623           v-fltopend-rowid[1] = ?
     1624         .
     1625       end.
     1626       else do:
     1627         assign
     1628         parameter-2-15 = (if p-find-next then "true":u else "false":u )
     1629         parameter-3-15 =  "FOR EACH X_fin-statement"
     1630         parameter-4-15 =
     1631           (
     1632             if (" X_fin-statement.host-code  = p-curr-host-code                      AND X_fin-statement.status_  = p-status_                      AND X_fin-statement.fins-ext-doc-type  = p-fins-ext-doc-type            " + " " + where-phrase-15) <> ""
     1633             then  substitute('X_fin-statement.host-code  = &1                      AND X_fin-statement.status_  = &2&3&2                      AND X_fin-statement.fins-ext-doc-type  = &2&4&2', p-curr-host-code, chr(34), p-status_, p-fins-ext-doc-type) + " " + where-phrase-15
     1634             else "true"
     1635           )
     1636         parameter-5-15 = (" " + "" + " " + "" + " " + p-find-condition)
     1637         parameter-6-15 = if sort-phrase-15 = ''
     1638                              then
     1639           (
     1640           " " + "  " +
     1641             " " + sort-column-phrase +
     1642           " " + " by X_fin-statement.host-code by X_fin-statement.end-date descending "
     1643           )
     1644                              else
     1645           (
     1646           " " + "  " +
     1647             " " + sort-column-phrase +
     1648           " " + sort-phrase-15
     1649           )
     1650         parameter-7-15 =
     1651           " indexed-reposition  "
     1652       .
     1653         run fltopend_fltfindq in this-procedure  (
     1654                             input this-procedure:handle
     1655                             ,input QUERY br-fin-statement:handle
     1656                             ,input logical(parameter-2-15)
     1657                             ,input no-lock
     1658                             ,input parameter-3-15
     1659                             ,input parameter-4-15
     1660                             ,input parameter-5-15
     1661                             ,input parameter-6-15
     1662                             ,input parameter-7-15
     1663                             ,output v-fltopend-rowid
     1664                             ) no-error.
     1665         .
     1666         v-doc-rec = ?.
     1667       end.
     1668       assign
     1669         l-query-was-opened = true
     1670       .
     1671     end.
     1672   end.
     1673     run waitfram-hide in this-procedure .
     1674       END.
     1675   END CASE.
     1676     end.
     1677   end procedure.
