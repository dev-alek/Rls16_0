      616           l-disable-where-5 =
      617             (" X_fin-statement.host-code  = p-curr-host-code                      AND X_fin-statement.status_  = p-status_                      AND X_fin-statement.fins-ext-doc-type  = p-fins-ext-doc-type                      AND (X_fin-statement.doc-date  >= p-start-date  AND                         X_fin-statement.doc-date  <= p-end-date)            " + " " + where-phrase-5 = "")
      618         .
