      412   procedure fltfield-clear :
      413     define output parameter loc-fld as character no-undo.
      414     define output parameter loc-lab as character no-undo .
      415     define output parameter loc-spr as character no-undo .
      416     define output parameter loc-dim as character no-undo .
      417     assign
      418       loc-fld = ""
      419       loc-lab = ""
      420       loc-spr = ""
      421       loc-dim = "0"
      422     .
      423   end procedure .
      424   procedure fltfield-add :
      425     define input        parameter par-fld as character no-undo.
      426     define input        parameter par-lab as character no-undo .
      427     define input        parameter par-spr as character no-undo .
      428     define input-output parameter loc-fld as character no-undo.
      429     define input-output parameter loc-lab as character no-undo .
      430     define input-output parameter loc-spr as character no-undo .
      431     define input-output parameter loc-dim as character no-undo .
      432     do
      433     on error undo, return error
      434     :
      435       assign
      436       loc-fld = if loc-dim = '0'
      437                 then par-fld
      438                 else (loc-fld + chr(44) + par-fld)
      439       loc-lab = if loc-dim = '0'
      440                 then par-lab
      441                 else (loc-lab + chr(44) + par-lab)
      442       loc-spr = if loc-dim = '0'
      443                 then par-spr
      444                 else (loc-spr + chr(44) + par-spr)
      445       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      446                 string(integer(if num-entries(loc-dim) > 1
      447                               then entry(2, loc-dim)
      448                               else entry(1, loc-dim)
      449                               ) + 1)
      450       no-error
      451       .
      452     end.
      453   end procedure.
      454   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      455   define  stream PrnLibStream.
      456   procedure prn-lib-prn-file :
      457     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      458     define input parameter p-DIsabledoptions as integer no-undo .
      459     define variable v-report-name as character no-undo .
      460     define variable v-user-action as character no-undo .
      461     define variable v-printed     as logical   no-undo .
      462     define variable v-exist       as logical   no-undo .
      463     do
      464       on error undo, return error
      465       :
      466       run prn-lib-get-report-name  in this-procedure (
      467         input parParentProc
      468         ,output v-report-name
      469         ).
      470   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      471   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      472     (input  v-report-name
      473     ,input  2
      474     ,output v-exist
      475     )  .
      476       if NOT v-exist then
      477       DO:
      478         Message
      479           "Нет заданий на печать ! "
      480           view-as alert-box .
      481         Return  .
      482       End.
      483       run gbl/prnfilen.w
      484         (input  ""
      485         ,input  p-DisabledOptions
      486         ,input  string(v-report-name )
      487         ,input  7
      488         ,output v-user-action
      489         ,output v-printed
      490         ) .
      491       if v-printed then
      492       do:
      493         return "YES" .
      494       end.
      495       else
      496       do:
      497         return "NO" .
      498       end.
      499     end.
      500   end procedure.
      501   procedure prn-lib-open-stream :
      502     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      503     define input parameter p-page-size    as integer no-undo .
      504     define input parameter p-is-stream    as logical no-undo .
      505     define input parameter p-append       as logical no-undo .
      506     define variable v-report-name as character no-undo .
      507     do
      508       on error undo, return error
      509       :
      510       run prn-lib-get-report-name  in this-procedure (
      511         input parParentProc
      512         ,output v-report-name
      513         ).
      514       if p-is-stream then
      515       do:
      516         if p-append then
      517         do:
      518           output stream PrnLibStream to value( v-report-name )
      519             page-size value(p-page-size) append .
      520         end.
      521         if not p-append then
      522         do:
      523           output stream PrnLibStream to value( v-report-name )
      524             page-size value(p-page-size) .
      525         end.
      526       end.
      527       if not p-is-stream then
      528       do:
      529         if p-append then
      530         do:
      531           output to value( v-report-name )
      532             page-size value(p-page-size) append .
      533         end.
      534         if not p-append then
      535         do:
      536           output to value( v-report-name )
      537             page-size value(p-page-size) .
      538         end.
      539       end.
      540     end.
      541   end procedure.
      542   procedure prn-lib-open-exp :
      543     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      544     define input parameter p-is-stream    as logical no-undo .
      545     define input parameter p-is-append    as logical no-undo .
      546     define output parameter p-ReportFileName as char init "report" no-undo.
      547     define output parameter p-process as logical no-undo .
      548     define variable glog as logical no-undo .
      549     do
      550       on error undo, return error
      551       :
      552       SYSTEM-DIALOG GET-FILE p-ReportFileName
      553         TITLE      "Укажите путь"
      554         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      555         ASK-OVERWRITE
      556         CREATE-TEST-FILE
      557         SAVE-AS
      558         USE-FILENAME
      559         DEFAULT-EXTENSION "txt"
      560         UPDATE glog
      561         .
      562       if not glog then  return.
      563       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      564       if p-is-stream then
      565       do:
      566         if p-is-append then
      567         do:
      568           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      569         end.
      570         else
      571         do:
      572           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      573         end.
      574       end.
      575       else
      576       do:
      577         if p-is-append then
      578         do:
      579           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      580         end.
      581         else
      582         do:
      583           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      584         end.
      585       end.
      586       p-process = yes.
      587     end.
      588   end procedure.
      589   procedure prn-lib-get-report-name :
      590     define input parameter parParentProc  as widget-handle no-undo.
      591     define output parameter p-report-name as character no-undo .
      592     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      593   end procedure.
      594   procedure prn-lib-reportviewer-report-name :
      595     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      596     define input parameter p-report-name-html as character no-undo .
      597     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      598   end procedure.
      599   procedure prn-lib-reportviewer :
      600     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      601     define input parameter p-report-name-html as character no-undo .
      602     define input parameter p-param        as character no-undo .
      603     define variable v-excel           as character no-undo init 'TRUE' .
      604     define variable v-value-character as character no-undo .
      605     define variable v-value-integer   as character no-undo .
      606     define variable v-value-date      as date      no-undo .
      607     define variable v-value-decimal   as decimal   no-undo .
      608     define variable rep-excel         as logical   no-undo .
      609     define variable excel-string      as character no-undo .
      610     define variable v-param-type      as character no-undo .
      611     define variable v-tth             as handle    no-undo .
      612     run adm/shattri.p (
      613       input "get":U
      614       ,input  ""
      615       ,input  0
      616       ,input  'report-glob':U
      617       ,input  'rep-excel':U
      618       ,output v-value-character
      619       ,output v-value-date
      620       ,output v-value-decimal
      621       ,output v-value-integer
      622       ,output rep-excel
      623       ,output v-param-type
      624       ,INPUT-OUTPUT table-handle v-tth
      625       )  .
      626     if rep-excel then v-excel = "TRUE" .
      627     else v-excel = "FALSE" .
      628     if p-param eq ""
      629     then
      630        p-param = "EXCEL:" + v-excel.
      631     else
      632        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      633     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      634   end procedure.
      635   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      636   FUNCTION mark-string RETURNS CHARACTER
      637     ( input p-recid as recid, input mark-list as character  ) :
      638     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      639   END FUNCTION.
      640   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      641   procedure cur-time :
      642      define output parameter p-today as date      no-undo .
      643      define output parameter p-time  as integer   no-undo .
      644     do
      645     on error undo, return error
      646     :
      647       define variable v-date1 as date      no-undo .
      648       define variable v-date2 as date      no-undo .
      649       define variable v-time  as integer   no-undo .
      650       assign
      651         v-date1 = today
      652         v-time  = time
      653         v-date2 = today
      654       .
      655       if v-date1 <> v-date2
      656       then do:
      657         assign
      658           v-date1 = today
      659           v-time  = v-time
      660         .
      661       end.
      662       assign
      663         p-today = v-date1
      664         p-time  = v-time
      665       .
      666     end.
      667   end.
      668   function cur-time-date returns character
      669   :
      670     return string(today, '99/99/9999':U) .
      671   end.
      672   function cur-time-mjd returns decimal
      673   :
      674     define variable v-date as date      no-undo .
      675     define variable v-time as integer   no-undo .
      676     run cur-time in this-procedure
      677       (output v-date
      678       ,output v-time
      679       ) .
      680     return integer(v-date) - 2400002 + (v-time / 86400) .
      681   end.
      682   function cur-time-get-ending-index returns integer
      683   (input p-number as integer
      684   )
      685   :
      686     if p-number < 0
      687     or p-number = ?
      688     then do:
      689       return 1 .
      690     end.
      691     define variable v-rest as integer   no-undo .
      692     assign
      693       p-number = p-number modulo 100
      694     .
      695     if p-number < 20
      696     then do:
      697       assign
      698         v-rest = p-number
      699       .
      700     end.
      701     else do:
      702       assign
      703         v-rest = p-number modulo 10
      704       .
      705     end.
      706     case v-rest :
      707       when 1
      708       then do:
      709         return 2 .
      710       end.
      711       when 2 or
      712       when 3 or
      713       when 4
      714       then do:
      715         return 3 .
      716       end.
      717       otherwise do:
      718         return 1 .
      719       end.
      720     end case .
      721   end.
      722   procedure cur-time-mjd-to-date :
      723      define input  parameter i-mjd-diff as decimal no-undo.
      724      define output parameter o-Date     as date    no-undo.
      725      define output parameter o-Time     as integer no-undo.
      726      define variable v-day-number as integer   no-undo .
      727      if    i-mjd-diff < 0
      728         or i-mjd-diff = ?
      729      then do:
      730         return "?" .
      731      end.
      732      assign
      733         v-day-number = truncate(i-mjd-diff,0).
      734         o-Date = date(v-day-number + 2400002).
      735         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      736     .
      737   end.
      738   function cur-time-mjd-to-string returns character
      739   (input p-mjd-diff as decimal
      740   )
      741   :
      742     define variable v-day-number as integer   no-undo .
      743     define variable v-seconds    as integer   no-undo .
      744     define variable v-hour       as integer   no-undo .
      745     define variable v-min        as integer   no-undo .
      746     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      747     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      748     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      749     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      750     if p-mjd-diff < 0
      751     or p-mjd-diff = ?
      752     then do:
      753       return "?" .
      754     end.
      755     assign
      756       v-day-number = integer(truncate(p-mjd-diff,0))
      757       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      758     .
      759     if v-seconds > 86400
      760     then do:
      761       assign
      762         v-seconds = 86400 - 1
      763       .
      764     end.
      765     if v-seconds < 0
      766     then do:
      767       assign
      768         v-seconds = 0
      769       .
      770     end.
      771     assign
      772       v-hour = truncate(v-seconds / 3600, 0)
      773     .
      774     assign
      775       v-seconds = v-seconds modulo 3600
      776     .
      777     assign
      778       v-min = truncate(v-seconds / 60, 0)
      779     .
      780     assign
      781       v-seconds = v-seconds modulo 60
      782     .
      783     return
      784         (if v-day-number <> 0
      785           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      786           else ""
      787         )
      788       + (if v-day-number <> 0 or v-hour <> 0
      789           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      790           else ""
      791         )
      792       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      793           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      794           else ""
      795         )
      796       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      797       .
      798   end.
      799   function cur-time-string returns character
      800   :
      801     define variable v-date as date      no-undo .
      802     define variable v-time as integer   no-undo .
      803     run cur-time in this-procedure
      804       (output v-date
      805       ,output v-time
      806       ) .
      807     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      808   end.
      809   function cur-time-string-sec returns character
      810   :
      811     define variable v-date as date      no-undo .
      812     define variable v-time as integer   no-undo .
      813     run cur-time in this-procedure
      814       (output v-date
      815       ,output v-time
      816       ) .
      817     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      818   end.
      819   function cur-time-custom  returns character
      820   (input p-prefix as character
      821   ,input p-date-format as character
      822   ,input p-delimiter as character
      823   ,input p-time-format as character
      824   ,input p-suffix as character
      825   )
      826   :
      827     define variable v-date as date      no-undo .
      828     define variable v-time as integer   no-undo .
      829     run cur-time in this-procedure
      830       (output v-date
      831       ,output v-time
      832       ) .
      833     return
      834       p-prefix
      835       + string(v-date, p-date-format)
      836       + p-delimiter
      837       + string(v-time, p-time-format)
      838       + p-suffix
      839       .
      840   end.
      841   function cur-time-print  returns character
      842   :
      843     define variable v-date as date      no-undo .
      844     define variable v-time as integer   no-undo .
      845     run cur-time in this-procedure
      846       (output v-date
      847       ,output v-time
      848       ) .
      849     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      850   end.
      851   function cur-time-datetime returns datetime
      852   :
      853     define variable v-char as character no-undo .
      854     define variable v-datetime as datetime no-undo .
      855     v-char = cur-time-string().
      856     v-datetime = datetime(v-char).
      857     return  v-datetime.
      858   end.
      859   function cur-time-string-msec returns character
      860   :
      861     define variable v-date as datetime  no-undo .
      862     v-date = now.
      863     return string(v-date) .
      864   end.
      865   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      866   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      867   procedure fltopend_fltopend :
      868   define input parameter p-parent-handle as handle no-undo .
      869   define input parameter p-qh as handle no-undo .
      870   define input parameter p-flt-open-open-query  as character no-undo .
      871   define input parameter p-where-cond as character no-undo .
      872   define input parameter p-use-indFIRST-query-tail as character no-undo .
      873   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      874   define input parameter p-indexed-reposition as character no-undo .
      875     do
      876     on error undo, return error
      877     :
      878   define variable v-prepare-string as character no-undo .
      879   define variable glog as logical no-undo .
      880   assign
      881   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      882                      p-where-cond + chr(32)  +
      883                      p-use-indFIRST-query-tail + chr(32) +
      884                      p-use-ind-sort-clmn-by + chr(32) +
      885                      p-indexed-reposition
      886   .
      887   assign
      888   glog = p-qh:query-prepare(v-prepare-string) no-error .
      889   if not glog
      890   or error-status:error then do:
      891     message error-status:get-message(1) view-as alert-box .
      892     undo, return error .
      893   end.
      894   assign
      895   glog = p-qh:query-open no-error .
      896   if not glog
      897   or error-status:error then do:
      898     message error-status:get-message(1) view-as alert-box .
      899     undo, return error .
      900   end.
      901     end.
      902   end procedure.
      903   procedure fltopend_fltfindd :
      904   define input parameter p-parent-handle as handle no-undo .
      905   define input parameter p-qh as handle no-undo .
      906   define input parameter p-rowid as rowid no-undo .
      907   define input parameter p-next as logical no-undo .
      908   define input parameter p-lock as integer no-undo .
      909   define input parameter p-bh as handle no-undo .
      910   define input parameter p-where-cond as character no-undo .
      911   define input parameter p-use-index-phrase as character no-undo .
      912   define variable glog as logical no-undo .
      913   define variable v-qh as handle no-undo .
      914   define variable v-bh as handle no-undo .
      915   define variable v-recid as recid no-undo .
      916   define variable v-prepare-string as character no-undo .
      917   do
      918   on error undo, return error
      919   on stop undo, return error
      920   :
      921     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      922     create buffer v-bh for table p-bh buffer-name p-bh:name.
      923     create query v-qh.
      924     v-qh:set-buffers(v-bh).
      925     v-prepare-string = substitute("for each &1 &2 &3"
      926                                     ,v-bh:name
      927                                     ,p-where-cond
      928                                     ,p-use-index-phrase).
      929     glog = v-qh:query-prepare(v-prepare-string) no-error.
      930     if not glog then do:
      931       delete object v-qh.
      932       delete object v-bh.
      933       undo, return error .
      934     end.
      935     glog = v-qh:query-open no-error .
      936     if not glog then do:
      937       delete object v-qh.
      938       delete object v-bh.
      939       undo, return error .
      940     end.
      941     if p-next then do:
      942       v-qh:reposition-to-rowid(p-rowid) no-error .
      943       glog = v-qh:get-next( p-lock) no-error .
      944       glog = v-qh:get-next( p-lock) no-error .
      945       if not glog or v-qh:query-off-end = yes then do:
      946         glog = v-qh:get-first( p-lock) no-error .
      947       end.
      948     end.
      949     else do:
      950       glog = v-qh:get-first( p-lock) no-error .
      951     end.
      952     v-recid = v-bh:recid no-error .
      953     delete object v-qh.
      954     delete object v-bh.
      955     return string(v-recid) .
      956   end.
      957   end procedure.
      958   procedure fltopend_fltfindq :
      959   define input parameter p-parent-handle as handle no-undo .
      960   define input parameter p-qh as handle no-undo .
      961   define input parameter p-next as logical no-undo .
      962   define input parameter p-lock as integer no-undo .
      963   define input parameter p-flt-open-open-query  as character no-undo .
      964   define input parameter p-where-cond as character no-undo .
      965   define input parameter p-use-indFIRST-query-tail as character no-undo .
      966   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      967   define input parameter p-indexed-reposition as character no-undo .
      968   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      969   define variable glog as logical no-undo .
      970   define variable v-qh as handle no-undo .
      971   define variable v-bh as handle no-undo extent 18.
      972   define variable v-rowid as rowid no-undo extent 18.
      973   define variable v-ii as integer no-undo .
      974   define variable v-prepare-string as character no-undo .
      975   do
      976   on error undo, return error
      977   on stop undo, return error
      978   :
      979     create query v-qh.
      980     do v-ii = 1 to p-qh:num-buffers:
      981       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      982       assign
      983       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      984       no-error.
      985       v-qh:add-buffer(v-bh[v-ii]).
      986     end.
      987     assign
      988     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      989                       p-where-cond + chr(32)  +
      990                       p-use-indFIRST-query-tail + chr(32) +
      991                       p-use-ind-sort-clmn-by + chr(32) +
      992                       p-indexed-reposition
      993     .
      994     glog = v-qh:query-prepare( v-prepare-string) no-error .
      995     if not glog then do:
      996       delete object v-qh.
      997       do v-ii = 1 to p-qh:num-buffers:
      998         delete object v-bh[v-ii].
      999       end.
     1000       undo, return error .
     1001     end.
     1002     glog = v-qh:query-open no-error .
     1003     if not glog then do:
     1004       delete object v-qh.
     1005       do v-ii = 1 to p-qh:num-buffers:
     1006         delete object v-bh[v-ii].
     1007       end.
     1008       undo, return error .
     1009     end.
     1010     if p-next then do:
     1011       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1012       glog = v-qh:get-next( p-lock) no-error .
     1013       glog = v-qh:get-next( p-lock) no-error .
     1014       if not glog or v-qh:query-off-end = yes then do:
     1015         glog = v-qh:get-first( p-lock) no-error .
     1016       end.
     1017     end.
     1018     else do:
     1019       glog = v-qh:get-first( p-lock) no-error .
     1020     end.
     1021     do v-ii = 1 to p-qh:num-buffers:
     1022       assign
     1023       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1024       no-error.
     1025     end.
     1026     delete object v-qh.
     1027     do v-ii = 1 to p-qh:num-buffers:
     1028       delete object v-bh[v-ii].
     1029     end.
     1030   end.
     1031   end procedure.
