     5173     .
     5174     do
     5175     on stop undo, leave
     5176     on error undo, leave
     5177     :
     5178       if QUERY br-tt0-dis-dct-rule:handle:get-buffer-handle(1) = (buffer tt0-dis-dct-rule:handle) then do:
     5179         assign
     5180         parameter-2-42 = (if p-find-next then "true":u else "false":u )
     5181         parameter-4-42 =
     5182           "where ":u +  substitute('tt0-dis-dct-rule.type = &1&2&1 and tt0-dis-dct-rule.emitent-host-code = &3 ', chr(34), p-type, p-emitent-host-code) + " ":u + where-phrase-42 + " ":u + p-find-condition + " " + ""
     5183         parameter-5-42 = "  "
     5184       .
     5185         run fltopend_fltfindd in this-procedure  (
     5186                             input this-procedure:handle
     5187                             ,input QUERY br-tt0-dis-dct-rule:handle
     5188                             ,input rowid(tt0-dis-dct-rule)
     5189                             ,input logical(parameter-2-42)
     5190                             ,input no-lock
     5191                             ,input (buffer tt0-dis-dct-rule:handle)
     5192                             ,input parameter-4-42
     5193                             ,input parameter-5-42
     5194                             ) no-error.
     5195         .
     5196         assign
     5197           v-doc-rec = integer(return-value)
     5198           v-fltopend-rowid[1] = ?
     5199         .
     5200       end.
     5201       else do:
     5202         assign
     5203         parameter-2-42 = (if p-find-next then "true":u else "false":u )
     5204         parameter-3-42 =  "FOR EACH tt0-dis-dct-rule no-lock"
     5205         parameter-4-42 =
     5206           (
     5207             if (" tt0-dis-dct-rule.type = p-type and tt0-dis-dct-rule.emitent-host-code = p-emitent-host-code " + " " + where-phrase-42) <> ""
     5208             then  substitute('tt0-dis-dct-rule.type = &1&2&1 and tt0-dis-dct-rule.emitent-host-code = &3 ', chr(34), p-type, p-emitent-host-code) + " " + where-phrase-42
     5209             else "true"
     5210           )
     5211         parameter-5-42 = (" " + "" + " " + ", FIRST tt0-dis-card-type no-lock where tt0-dis-card-type.type = tt0-dis-dct-rule.type and                                                                      tt0-dis-card-type.emitent-host-code = tt0-dis-dct-rule.emitent-host-code" + " " + p-find-condition)
     5212         parameter-6-42 = if sort-phrase-42 = ''
     5213                              then
     5214           (
     5215           " " + "  " +
     5216             " " + sort-column-phrase +
     5217           " " + "  "
     5218           )
     5219                              else
     5220           (
     5221           " " + "  " +
     5222             " " + sort-column-phrase +
     5223           " " + sort-phrase-42
     5224           )
     5225         parameter-7-42 =
     5226           " indexed-reposition  "
     5227       .
     5228         run fltopend_fltfindq in this-procedure  (
     5229                             input this-procedure:handle
     5230                             ,input QUERY br-tt0-dis-dct-rule:handle
     5231                             ,input logical(parameter-2-42)
     5232                             ,input no-lock
     5233                             ,input parameter-3-42
     5234                             ,input parameter-4-42
     5235                             ,input parameter-5-42
     5236                             ,input parameter-6-42
     5237                             ,input parameter-7-42
     5238                             ,output v-fltopend-rowid
     5239                             ) no-error.
     5240         .
     5241         v-doc-rec = ?.
     5242       end.
     5243       assign
     5244         l-query-was-opened = true
     5245       .
     5246     end.
     5247   end.
     5248     run waitfram-hide in this-procedure .
     5249     END.
     5250   END CASE.
     5251   if not p-open-query then
     5252   REPOSITION br-tt0-dis-dct-rule to recid v-doc-rec No-ERROR.
     5253   if error-status:error then do:
     5254     REPOSITION br-tt0-dis-dct-rule to row 1 No-ERROR.
     5255   end.
     5256   run waitfram-hide in this-procedure.
     5257   APPLY "VALUE-CHANGED" TO br-tt0-dis-dct-rule in frame Dialog-Frame.
     5258   APPLY "ENTRY" TO br-tt0-dis-dct-rule.
     5259   END PROCEDURE.
     5260   PROCEDURE proc-b-mark :
     5261   define variable loc#log as logical no-undo .
     5262   if available X_dis-dct-rule then do:
     5263   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5264   define variable v-str-recid44 as character no-undo .
     5265   define variable v-num-entry44 as integer   no-undo .
     5266   assign
     5267     v-str-recid44 = trim( string( recid( X_dis-dct-rule ) , "->>>>>>>>>>>9":U ) )
     5268     v-num-entry44 = lookup( v-str-recid44 , v-rid-list )
     5269   .
     5270   if v-num-entry44 > 0 then do:
     5271     assign
     5272       entry( v-num-entry44, v-rid-list ) = "":U
     5273       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     5274     .
     5275   end.
     5276   else do:
     5277     assign
     5278       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid44
     5279     .
     5280   end.
     5281     loc#log = br-dis-dct-rule:refresh() IN FRAME Dialog-Frame .
     5282     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     5283         loc#log = br-dis-dct-rule:select-next-row ().
     5284         apply "VALUE-CHANGED" to br-dis-dct-rule in frame Dialog-Frame.
     5285     end.
     5286     if num-entries( v-rid-list ) = 0
     5287     then
     5288         hide mark-num in frame Dialog-Frame.
     5289     else
     5290         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     5291   end.
     5292   apply "entry" to br-dis-dct-rule in frame Dialog-Frame.
     5293   END PROCEDURE.
     5294   PROCEDURE proc-b-print :
     5295   define variable Line                as char         no-undo.
     5296   define variable v-rec as recid no-undo .
     5297   define variable ii as integer no-undo .
     5298   define variable v-mark as character no-undo .
     5299   define variable v-prod as character no-undo .
     5300   define variable v-d-name as character no-undo .
     5301   define variable v-pos-type as character no-undo .
     5302   Line = fill( "-" , 140 ) .
     5303   define frame list
     5304   v-mark COLUMN-LABEL '*' FORMAT "X(1)"
     5305   X_dis-card-type.emitent-host-code COLUMN-LABEL 'Эмитент' FORMAT ">>>>9"
     5306   X_dis-card-type.type COLUMN-LABEL 'Тип'
     5307   X_dis-dct-rule.templ-rl-root COLUMN-LABEL 'Тип правила' FORMAT ">>>>>>>>9"
     5308   v-pos-type COLUMN-LABEL 'Место использ.' FORMAT "X(10)"
     5309   X_dis-dct-rule.obj-type COLUMN-LABEL 'Тип объ' FORMAT "X(3)"
     5310   X_dis-dct-rule.obj-code COLUMN-LABEL 'Код объ' FORMAT ">>>>>>>>9"
     5311   v-d-name COLUMN-LABEL 'Тип скидки' FORMAT "X(20)"
     5312   X_dis-dct-rule.rule-num COLUMN-LABEL '№ правила' FORMAT ">>>>>>>>9"
     5313   X_dis-dct-rule.rl-root COLUMN-LABEL '№ корн.!правила' FORMAT ">>>>>>>>9"
     5314   HEADER
     5315   cur-time-print() AT 5 format "X(35)"
     5316   string( "Страница " + string( PAGE-NUMBER( PrnLibStream ) , ">>9") )
     5317   AT 86 format "X(15)" SKIP
     5318   Line format "x(130)" AT 1
     5319   with width 235 down use-text stream-io no-box .
     5320   v-rec = recid(X_dis-dct-rule).
     5321   DO WHILE available X_dis-dct-rule :
     5322     GET prev br-dis-dct-rule NO-LOCK .
     5323   END.
     5324   GET next br-dis-dct-rule NO-LOCK .
     5325   run prn-lib-open-stream  in this-procedure (
     5326                                                input parParentProc
     5327                                               ,input 43
     5328                                               ,input yes
     5329                                               ,input no
     5330                                               ).
     5331   FORM HEADER
     5332   Line format "X(130)" SKIP
     5333   "Продолжение - на следующей странице" AT 30 SKIP
     5334   with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS no-box.
     5335   VIEW stream PrnLibStream FRAME CliBottomFrame .
     5336   PUT stream PrnLibStream space(30)
     5337   frame Dialog-Frame:title format "X(100)" SKIP(2) .
     5338   FORM with frame List .
     5339   DO WHILE available X_dis-dct-rule :
     5340     DISPLAY stream PrnLibStream
     5341     mark-string(recid(X_dis-dct-rule), v-rid-list) @ v-mark
     5342     X_dis-card-type.emitent-host-code
     5343     X_dis-card-type.type
     5344     X_dis-dct-rule.templ-rl-root
     5345     cd-type-name(X_dis-dct-rule.pos-type) @ v-pos-type
     5346     X_dis-dct-rule.obj-type
     5347     X_dis-dct-rule.obj-code
     5348     dis-dct-rule-name(X_dis-dct-rule.discnt-role) @ v-d-name
     5349     X_dis-dct-rule.rule-num
     5350     X_dis-dct-rule.rl-root
     5351     with frame List .
     5352     DOWN stream PrnLibStream 1 with frame List .
     5353     ii =  ii + 1 .
     5354     if ( ( ii modulo 10 ) = 0 ) AND ( ii >= 10 ) then
     5355     run waitfram-show in this-procedure ( input ("Просмотрено строк : " + string( ii )) ) .
     5356     GET next br-dis-dct-rule .
     5357   END.
     5358   run waitfram-hide in this-procedure .
     5359   PUT stream PrnLibStream Line format "X(130)" SKIP.
     5360   HIDE stream PrnLibStream FRAME BottomFrame .
     5361   output stream PrnLibStream close .
     5362   run prn-lib-prn-file in this-procedure (
     5363                                             input parParentProc
     5364                                             ,input 0
     5365                                             ).
     5366   reposition br-dis-dct-rule to recid v-rec no-error.
     5367   if error-status:error then do:
     5368     reposition br-dis-dct-rule to row 1 no-error.
     5369   end.
     5370   APPLy "ENTRY" to br-dis-dct-rule.
     5371   END PROCEDURE.
     5372   PROCEDURE proc-b-sch :
     5373   assign
     5374     tbl = 'dis-dct-rule'
     5375     join-tbl = 'X_dis-dct-rule'
     5376     fld = ""
     5377     lab = ""
     5378     spr = ""
     5379     dim = '0'
     5380     .
     5381     run fltfield-add in this-procedure('templ-rl-root', 'Номер типа(шаблона) правила', '',
     5382     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5383     run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', 'cli',
     5384     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5385     run fltfield-add in this-procedure('rule-num', '№ правила', '',
     5386     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5387     run fltfield-add in this-procedure('rl-root', '№ корн.правила', '',
     5388     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5389     run fltfield-add in this-procedure('pos-type', 'Место использ.', 'cd-types-discnt',
     5390     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5391     run fltfield-add in this-procedure('discnt-role', 'Тип скидки', '',
     5392     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5393     run fltfield-add in this-procedure('type', 'Тип карты', '',
     5394     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5395     run fltfield-add in this-procedure('emitent-host-code', 'Код эмитента', '',
     5396     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5397   Filter-Block:
     5398   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5399       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5400       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5401     run gbl/filter.w ( INPUT parparentproc
     5402                        ,INPUT (filter-point + chr(4) + filter-label)
     5403                        ,INPUT tbl
     5404                        ,INPUT join-tbl
     5405                        ,INPUT fld
     5406                        ,INPUT lab
     5407                        ,INPUT spr
     5408                        ,INPUT dim ).
     5409     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     5410   END.
     5411   END PROCEDURE.
     5412   FUNCTION cd-type-name RETURNS CHARACTER
     5413     ( input p-pos-type as character ) :
     5414   RETURN entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U).
     5415   END FUNCTION.
     5416   FUNCTION dis-dct-rule-name RETURNS CHARACTER
     5417     ( input p-dis-dct-rule-code as character ) :
     5418   return entry (lookup (p-dis-dct-rule-code, 'calc-d-pcnt,calc-cash-d-pcnt,calc-categ,dis-tot-flag,def-categ,def-pcnt,def-cash-pcnt':u) + 1, ',' + 'Расчет %скидки ДК на товар,Расчет %скидки ДК на итог,Расчет категории ДК,Участие в итогах по ДК,Категория ДК по умолчанию,% скидки ДК на товар по умолч.,% скидки ДК на итог по умолч.':u).
     5419   END FUNCTION.
