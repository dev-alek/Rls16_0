     2828   define variable sort-column-phrase as character no-undo .
     2829   case sort-column-name :
     2830     when "" then do:
     2831       assign
     2832         sort-column-phrase = ""
     2833       .
     2834     end.
     2835     otherwise do:
     2836       assign
     2837         sort-column-phrase = "by " + sort-column-name
     2838       .
     2839     end.
     2840   end case.
     2841   if not( p-curr-obj-type = "":U and p-curr-obj-code = 0 ) then do:
     2842   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2843   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2844     (input  p-curr-obj-type
     2845     ,input  p-curr-obj-code
     2846     ,output p-host-code
     2847     )  .
     2848   end.
     2849   define variable l-open-query as logical   no-undo .
     2850   filter-point = filter-point0 + p-list-mode.
     2851   CASE p-list-mode :
