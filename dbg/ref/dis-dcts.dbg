        6   DEFINE BUFFER X_dis-dct-rule FOR ub.dis-dct-rule.
        7   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        8   define INPUT PARAMETER bttn AS CHARACTER NO-UNDO.
        9   define INPUT PARAMETER p-list-mode AS CHARACTER NO-UNDO.
