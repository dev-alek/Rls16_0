     1087         mark-string(recid(X_dis-dct-rule), v-rid-list) COLUMN-LABEL '*' FORMAT "X(1)"
     1088   X_dis-card-type.emitent-host-code COLUMN-LABEL 'Эмитент' format ">>>>9"
     1089   X_dis-card-type.type COLUMN-LABEL 'Тип'
     1090   X_dis-dct-rule.templ-rl-root COLUMN-LABEL 'Тип правила' FORMAT ">>>>>>>>9"
     1091   cd-type-name(X_dis-dct-rule.pos-type) COLUMN-LABEL 'Место использ.' FORMAT "X(10)"
     1092   X_dis-dct-rule.obj-type COLUMN-LABEL 'Тип объ' FORMAT "X(3)"
     1093   X_dis-dct-rule.obj-code COLUMN-LABEL 'Код объ' FORMAT ">>>>9"
     1094   dis-dct-rule-name(X_dis-dct-rule.discnt-role) COLUMN-LABEL 'Тип скидки' FORMAT "X(70)"
     1095   X_dis-dct-rule.rule-num COLUMN-LABEL '№ правила' FORMAT ">>>>>>>>9"
     1096   X_dis-dct-rule.rl-root COLUMN-LABEL '№ корн.!правила' FORMAT ">>>>>>>>9"
     1097       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 20 FIT-LAST-COLUMN.
     1098   DEFINE BROWSE BR-tt0-dis-dct-rule
     1099     QUERY BR-tt0-dis-dct-rule NO-LOCK DISPLAY
     1100         mark-string(recid(tt0-dis-dct-rule), v-rid-list) COLUMN-LABEL '*' FORMAT "X(1)"
     1101   tt0-dis-card-type.emitent-host-code COLUMN-LABEL 'Эмитент' format ">>>>9"
     1102   tt0-dis-card-type.type COLUMN-LABEL 'Тип'
     1103   tt0-dis-dct-rule.templ-rl-root COLUMN-LABEL 'Тип правила' FORMAT ">>>>>>>>9"
     1104   cd-type-name(tt0-dis-dct-rule.pos-type) COLUMN-LABEL 'Место использ.' FORMAT "X(10)"
     1105   tt0-dis-dct-rule.obj-type COLUMN-LABEL 'Тип объ' FORMAT "X(3)"
     1106   tt0-dis-dct-rule.obj-code COLUMN-LABEL 'Код объ' FORMAT ">>>>9"
     1107   dis-dct-rule-name(tt0-dis-dct-rule.discnt-role) COLUMN-LABEL 'Тип скидки' FORMAT "X(70)"
     1108   tt0-dis-dct-rule.rule-num COLUMN-LABEL '№ правила' FORMAT ">>>>>>>>9"
     1109   tt0-dis-dct-rule.rl-root COLUMN-LABEL '№ корн.!правила' FORMAT ">>>>>>>>9"
     1110       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 20 FIT-LAST-COLUMN.
     1111   DEFINE FRAME Dialog-Frame
     1112        b-quit AT ROW 1 COL 1
     1113        B-mark AT ROW 1 COL 11 WIDGET-ID 4
     1114        B-sel AT ROW 1 COL 21 WIDGET-ID 10
     1115        B-type AT ROW 1 COL 41 WIDGET-ID 14
     1116        b-dis-rule AT ROW 1 COL 51 WIDGET-ID 16
     1117        B-sch AT ROW 1 COL 86 WIDGET-ID 8
     1118        B-print AT ROW 1 COL 89 WIDGET-ID 6
     1119        b-history AT ROW 1 COL 92 WIDGET-ID 2
     1120        B-Help AT ROW 1 COL 95
     1121        BR-tt0-dis-dct-rule AT ROW 3 COL 1 WIDGET-ID 200
     1122        BR-dis-dct-rule AT ROW 3 COL 1 WIDGET-ID 100
     1123        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL WIDGET-ID 12
     1124        SPACE(78.50) SKIP(21.22)
     1125       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1126            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1127            TITLE "Скидки по типам ДК"
     1128            CANCEL-BUTTON b-quit.
     1129   ASSIGN
     1130          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1131          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1132   ON F5 OF FRAME Dialog-Frame
     1133   DO:
     1134      if br-tt0-dis-dct-rule:visible in frame Dialog-Frame then do:
     1135        v-doc-rec = recid(tt0-dis-dct-rule).
     1136        Run OpenBRtt in this-procedure ( input yes, input no, input '':U).
     1137        REPOSITION br-tt0-dis-dct-rule to recid v-doc-rec No-ERROR.
     1138        apply 'value-changed' to br-tt0-dis-dct-rule.
     1139      end.
     1140      else do:
     1141        v-doc-rec = recid(X_dis-dct-rule).
     1142        Run OpenBR in this-procedure ( input yes, input no, input '':U).
     1143        REPOSITION br-dis-dct-rule to recid v-doc-rec No-ERROR.
     1144        apply 'value-changed' to br-dis-dct-rule.
     1145      end.
     1146   END.
     1147   ON GO OF FRAME Dialog-Frame
     1148   DO:
     1149     p-rid-list = v-rid-list.
     1150   END.
     1151   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1152   DO:
     1153     APPLY "END-ERROR":U TO SELF.
     1154   END.
     1155   ON CHOOSE OF b-dis-rule IN FRAME Dialog-Frame
     1156   DO:
     1157   define variable v-rule-num as integer no-undo .
     1158     if temp-mode then do:
     1159       if not available tt0-dis-dct-rule then return no-apply.
     1160       v-rule-num = tt0-dis-dct-rule.rule-num.
     1161     end.
     1162     else do:
     1163       IF NOT AVAILABLE X_dis-dct-rule THEN RETURN NO-APPLY.
     1164       v-rule-num = X_dis-dct-rule.rule-num.
     1165     end.
     1166     run ref/show-dr.p ( INPUT parparentproc
     1167                        ,INPUT v-rule-num) NO-ERROR.
     1168     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1169   END.
     1170   ON CHOOSE OF b-history IN FRAME Dialog-Frame
     1171   DO:
     1172   define variable v-rid-list as character no-undo .
     1173   if not available X_dis-dct-rule then return no-apply.
     1174     run ref/dcctypes.w ( input parparentproc
     1175                       , input '':U
     1176                       , input ?
     1177                       , input X_dis-dct-rule.emitent-host-code
     1178                       , input X_dis-dct-rule.host-code
     1179                       , input X_dis-dct-rule.obj-type
     1180                       , input X_dis-dct-rule.obj-code
     1181                       , input X_dis-dct-rule.TYPE
     1182                       , input "subject":U
     1183                       , input 'dis-dct-rule':U
     1184                       , output v-rid-list ) no-error .
     1185   APPLY "ENTRY" to br-dis-dct-rule.
     1186   END.
     1187   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1188   DO:
     1189     RUN proc-b-mark IN THIS-PROCEDURE NO-ERROR.
     1190     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1191   END.
     1192   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1193   DO:
     1194     run proc-b-print in this-procedure no-error.
     1195     if error-status:error then do:
     1196       return no-apply.
     1197     end.
     1198     APPLY "ENTRY" to br-dis-dct-rule.
     1199   END.
     1200   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1201   DO:
     1202     RUN proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1203     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1204   END.
     1205   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1206   DO:
     1207     if temp-mode then do:
     1208       if ( available tt0-dis-dct-rule ) then do:
     1209         if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1210         then
     1211         v-rid-list = string( recid( tt0-dis-dct-rule ) ) .
     1212       end.
     1213     end.
     1214     else do:
     1215       if ( available X_dis-dct-rule ) then do:
     1216         if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1217         then
     1218         v-rid-list = string( recid( X_dis-dct-rule ) ) .
     1219       end.
     1220     end.
     1221   END.
     1222   ON CHOOSE OF B-type IN FRAME Dialog-Frame
     1223   DO:
     1224   DEFINE VARIABLE v-ref-rec AS RECID NO-UNDO.
     1225   define buffer buf_dis-card-type for ub.dis-card-type.
     1226     IF NOT AVAILABLE X_dis-card-type THEN RETURN NO-APPLY.
     1227     FIND FIRST buf_dis-card-type No-LOCK WHERE
     1228               buf_dis-card-type.type = X_dis-card-type.type
     1229           and buf_dis-card-type.emitent-host-code = X_dis-card-type.emitent-host-code  no-error .
     1230   if error-status:error then  return no-apply.
     1231   v-ref-rec = recid( buf_dis-card-type ) .
     1232    run ref/dc-typei.w ( input parparentproc
     1233                   , input 'ПРОСМОТР':U
     1234                   , input v-cntxt-host-code-obj
     1235                   , input v-cntxt-obj-type
     1236                   , input v-cntxt-obj-code
     1237                   , input-output v-ref-rec ).
     1238   apply "entry" to br-dis-dct-rule in frame Dialog-Frame.
     1239   END.
     1240   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1241   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1242   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1243   on help of frame Dialog-Frame
     1244   do:
     1245     run gbl/app_help.p
     1246       (input this-procedure :file-name
     1247       ,input ''
     1248       ,input ?
     1249       ) no-error.
     1250     if error-status :error then do:
     1251       message
     1252         "Ошибка при вызове помощи"
     1253         error-status :get-message(1)
     1254         view-as alert-box .
     1255     end.
     1256   end.
     1257   run minbtn-set in this-procedure .
     1258   on choose of b-help in frame Dialog-Frame
     1259   do:
     1260     apply "help":u to frame Dialog-Frame .
     1261   end.
     1262   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1263   procedure minbtn-set :
     1264       do
     1265           on error undo, return error return-value
     1266           :
     1267           define variable ii              as integer       no-undo .
     1268           define variable fh              as widget-handle no-undo .
     1269           define variable hh              as widget-handle no-undo .
     1270           define variable v-h             as handle        extent 4 no-undo .
     1271           define variable v-name-button   as character     no-undo .
     1272           define variable v-help-old-x    as decimal       no-undo .
     1273           define variable v-help-old-y    as decimal       no-undo .
     1274           define variable v-help-old-size as decimal       no-undo .
     1275           define variable v-frame-width   as decimal       no-undo .
     1276           define variable jj              as integer       no-undo .
     1277           do
     1278               on error undo, return error
     1279               :
     1280               assign
     1281                   v-frame-width = frame Dialog-Frame:width - 0.3
     1282                   fh            = frame Dialog-Frame:first-child
     1283                   hh            = fh:first-child
     1284                   ii            = 1
     1285                   .
     1286               do while valid-handle(hh):
     1287                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1288                   do:
     1289                       case lc(hh:name) :
     1290                           when "b-help" then
     1291                               do:
     1292                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1293                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1294                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1295                                   hh:TOOLTIP = "Помощь" .
     1296                                   v-help-old-x = hh:column .
     1297                                   v-help-old-y = hh:row    .
     1298                                   v-help-old-size = hh:width .
     1299                                   hh:width-chars = 2.5 .
     1300                               end.
     1301                           when "b-print" then
     1302                               do:
     1303                                   hh:load-image("cmp/b-print.bmp":u) .
     1304                                   hh:TOOLTIP = "Печать" .
     1305                                   v-h[ii] = hh:handle .
     1306                                   ii = ii + 1 .
     1307                                   hh:width-chars = 3 .
     1308                               end.
     1309                           when "b-history" or
     1310                           when "b-hist" then
     1311                               do:
     1312                                   hh:load-image("cmp/b-hist.bmp":u) .
     1313                                   hh:TOOLTIP = "История" .
     1314                                   v-h[ii] = hh:handle .
     1315                                   ii = ii + 1 .
     1316                                   hh:width-chars = 3 .
     1317                               end.
     1318                           when "b-sch" then
     1319                               do:
     1320                                   hh:load-image("cmp/b-sch.bmp":u) .
     1321                                   hh:TOOLTIP = "Установка Фильтра" .
     1322                                   v-h[ii] = hh:handle .
     1323                                   ii = ii + 1 .
     1324                                   hh:width-chars = 3 .
     1325                               end.
     1326                           when "b-hist-user" then
     1327                               do:
     1328                                   hh:load-image("cmp/b-hist.bmp":u) .
     1329                                   hh:TOOLTIP = "История пользователя" .
     1330                                   ii = ii + 1 .
     1331                               end.
     1332                       end case.
     1333                   end.
     1334                   hh = hh:next-sibling.
     1335               end.
     1336               b-help:column = v-frame-width - b-help:width-chars.
     1337               jj = 0.
     1338               repeat ii = 4 to 1 by -1 :
     1339                   if valid-handle (v-h[ii] ) then
     1340                   do:
     1341                       jj  = jj + 1 .
     1342                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1343                       v-h[ii]:row    = v-help-old-y .
     1344                   end.
     1345               end.
     1346           end.
     1347       end.
     1348   end procedure.
     1349   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1350   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1351   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1352   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1353   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1354   define variable v-diasize-current-frame-height as decimal   no-undo .
     1355   define variable v-diasize-change-size          as logical   no-undo .
     1356   define variable v-diasize-resize-button        as handle    no-undo .
     1357   define variable v-diasize-wndmax               as logical   no-undo .
     1358   define variable v-diasize-wndstore             as logical   no-undo .
     1359   define variable v-diasize-proc-name            as character no-undo .
     1360   define variable v-diasize-browse-handle        as handle    no-undo .
     1361   define variable v-diasize-browse-number        as integer   no-undo .
     1362   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1363   define temp-table temp-diasize-handle no-undo
     1364     field handle-value  as handle
     1365     field save-position as decimal
     1366     index xpk is primary unique handle-value
     1367     .
     1368   define temp-table temp-browse-handle no-undo
     1369     field browse-type   as character
     1370     field browse-number as integer
     1371     field browse-handle as handle
     1372     field original-size as decimal
     1373     index xpk is primary unique browse-type browse-number
     1374     index xie browse-type browse-handle
     1375   .
     1376   procedure diasize_change-height :
     1377     define input  parameter p-change-value  as decimal   no-undo .
     1378     define input  parameter p-move-resize   as logical   no-undo .
     1379     define variable v-field-group-handle    as handle    no-undo .
     1380     define variable v-object-handle         as handle    no-undo .
     1381     define variable v-frame-height          as decimal   no-undo .
     1382     define variable v-frame-virtual-height  as decimal   no-undo .
     1383     define variable v-browse-height         as decimal   no-undo .
     1384     define variable v-window-height         as decimal   no-undo .
     1385     define variable v-window-virtual-height as decimal   no-undo .
     1386     define variable v-change-sign           as integer   no-undo .
     1387     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1388     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1389     if p-change-value > 0
     1390     then do:
     1391       if frame Dialog-Frame :height + p-change-value
     1392           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1393       then do:
     1394         assign
     1395           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1396                           - (frame Dialog-Frame :height-chars)
     1397         .
     1398         if p-change-value <= 0
     1399         then do:
     1400           run diasize_position-resize-button in this-procedure .
     1401           return .
     1402         end.
     1403       end.
     1404     end.
     1405     if p-change-value < 0
     1406     then do:
     1407       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1408       then do:
     1409         assign
     1410           p-change-value = v-diasize-orig-frame-height
     1411                          - (frame Dialog-Frame :height-chars)
     1412         .
     1413         if p-change-value >= 0
     1414         then do:
     1415           run diasize_position-resize-button in this-procedure .
     1416           return .
     1417         end.
     1418       end.
     1419     end.
     1420     if p-change-value >= 0
     1421     then do:
     1422       assign
     1423         v-change-sign = 1
     1424       .
     1425     end.
     1426     else do:
     1427       assign
     1428         v-change-sign = -1
     1429       .
     1430     end.
     1431     assign
     1432       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1433     .
     1434     if p-change-value = 0
     1435     then do:
     1436       run diasize_position-resize-button in this-procedure .
     1437       return .
     1438     end.
     1439     move_block:
     1440     do
     1441     on error undo move_block, retry move_block
     1442     :
     1443       if retry
     1444       then do:
     1445         do
     1446         on error undo move_block, leave move_block
     1447         :
     1448           if p-change-value > 0
     1449           then do:
     1450             for each buf_temp-diasize-handle
     1451             on error undo, next
     1452             :
     1453               assign
     1454                 v-object-handle = buf_temp-diasize-handle.handle-value
     1455               .
     1456               if v-object-handle <> v-diasize-resize-button
     1457               then do:
     1458                 assign
     1459                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1460                 .
     1461               end.
     1462             end.
     1463             assign
     1464               v-diasize-browse-handle :height = v-browse-height
     1465             .
     1466             for each buf_temp-browse-handle
     1467               where buf_temp-browse-handle.browse-type = 'height':u
     1468             on error undo, next
     1469             :
     1470               assign
     1471                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1472               .
     1473             end.
     1474             assign
     1475               frame Dialog-Frame :height = v-frame-height
     1476             .
     1477             if frame Dialog-Frame :scrollable = true
     1478             then do:
     1479               assign
     1480                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1481               .
     1482             end.
     1483             run diasize_position-resize-button in this-procedure .
     1484           end.
     1485           else do:
     1486             if frame Dialog-Frame :scrollable = true
     1487             then do:
     1488               assign
     1489                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1490               .
     1491             end.
     1492             assign
     1493               frame Dialog-Frame :height = v-frame-height
     1494             .
     1495             assign
     1496               v-diasize-browse-handle :height = v-browse-height
     1497             .
     1498             for each buf_temp-browse-handle
     1499               where buf_temp-browse-handle.browse-type = 'height':u
     1500             on error undo, next
     1501             :
     1502               assign
     1503                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1504               .
     1505             end.
     1506             for each buf_temp-diasize-handle
     1507             on error undo, next
     1508             :
     1509               assign
     1510                 v-object-handle = buf_temp-diasize-handle.handle-value
     1511               .
     1512               if v-object-handle <> v-diasize-resize-button
     1513               then do:
     1514                 assign
     1515                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1516                 .
     1517               end.
     1518             end.
     1519             run diasize_position-resize-button in this-procedure .
     1520           end.
     1521           assign
     1522             v-diasize-change-size = false
     1523           .
     1524           leave move_block .
     1525         end.
     1526       end.
     1527       assign
     1528         v-diasize-need-full-display = true
     1529       .
     1530       if v-diasize-change-size = false
     1531       then do:
     1532         assign
     1533           v-diasize-change-size = true
     1534         .
     1535       end.
     1536       else do:
     1537         return .
     1538       end.
     1539       assign
     1540         v-frame-height = frame Dialog-Frame :height
     1541         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1542         v-browse-height = v-diasize-browse-handle :height
     1543       .
     1544       for each buf_temp-browse-handle
     1545         where buf_temp-browse-handle.browse-type = 'height':u
     1546       :
     1547         assign
     1548           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1549         .
     1550       end.
     1551       for each buf_temp-diasize-handle
     1552       :
     1553         delete buf_temp-diasize-handle .
     1554       end.
     1555       assign
     1556         v-field-group-handle = frame Dialog-Frame :first-child
     1557       .
     1558       do while valid-handle(v-field-group-handle)
     1559       :
     1560         assign
     1561           v-object-handle = v-field-group-handle :first-child
     1562         .
     1563         do while valid-handle(v-object-handle)
     1564         :
     1565           if  v-object-handle <> v-diasize-browse-handle :handle
     1566           and can-query(v-object-handle, "row")
     1567           and can-query(v-object-handle, "height")
     1568           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1569           then do:
     1570             find first buf_temp-browse-handle
     1571               where buf_temp-browse-handle.browse-type   = 'height':u
     1572                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1573               no-error .
     1574             if available buf_temp-browse-handle
     1575             then do:
     1576             end.
     1577             else do:
     1578               create buf_temp-diasize-handle .
     1579               assign
     1580                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1581                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1582               .
     1583             end.
     1584           end.
     1585           assign
     1586             v-object-handle = v-object-handle :next-sibling
     1587           .
     1588         end.
     1589         assign
     1590           v-field-group-handle = v-field-group-handle :next-sibling
     1591         .
     1592       end.
     1593       do with frame Dialog-Frame
     1594       :
     1595         hide v-diasize-resize-button .
     1596         assign
     1597           v-diasize-resize-button :row    = 1
     1598           v-diasize-resize-button :column = 1
     1599         .
     1600       end.
     1601       if p-change-value > 0
     1602       then do:
     1603         if frame Dialog-Frame :scrollable = true
     1604         then do:
     1605           assign
     1606             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1607             no-error .
     1608           if error-status :error
     1609           or error-status :get-message(1) <> ""
     1610           then do:
     1611             undo move_block, retry move_block .
     1612           end.
     1613         end.
     1614         assign
     1615           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1616           no-error .
     1617         if error-status :error
     1618         or error-status :get-message(1) <> ""
     1619         then do:
     1620           undo move_block, retry move_block .
     1621         end.
     1622         assign
     1623           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1624           no-error .
     1625         if error-status :error
     1626         or error-status :get-message(1) <> ""
     1627         then do:
     1628           undo move_block, retry move_block .
     1629         end.
     1630         for each buf_temp-browse-handle
     1631           where buf_temp-browse-handle.browse-type = 'height':u
     1632         on error undo move_block, retry move_block
     1633         :
     1634           assign
     1635             buf_temp-browse-handle.browse-handle :height
     1636               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1637             no-error .
     1638           if error-status :error
     1639           or error-status :get-message(1) <> ""
     1640           then do:
     1641             undo move_block, retry move_block .
     1642           end.
     1643         end.
     1644         for each buf_temp-diasize-handle
     1645         on error undo move_block, retry move_block
     1646         :
     1647           assign
     1648             v-object-handle = buf_temp-diasize-handle.handle-value
     1649           .
     1650           if v-object-handle <> v-diasize-resize-button
     1651           then do:
     1652             assign
     1653               v-object-handle :row = v-object-handle :row + p-change-value
     1654               no-error .
     1655             if error-status :error
     1656             or error-status :get-message(1) <> ""
     1657             then do:
     1658               undo move_block, retry move_block .
     1659             end.
     1660           end.
     1661         end.
     1662       end.
     1663       else do:
     1664         for each buf_temp-diasize-handle
     1665         on error undo move_block, retry move_block
     1666         :
     1667           assign
     1668             v-object-handle = buf_temp-diasize-handle.handle-value
     1669           .
     1670           if v-object-handle <> v-diasize-resize-button
     1671           then do:
     1672             assign
     1673               v-object-handle :row = v-object-handle :row + p-change-value
     1674               no-error .
     1675             if error-status :error
     1676             or error-status :get-message(1) <> ""
     1677             then do:
     1678               undo move_block, retry move_block .
     1679             end.
     1680           end.
     1681         end.
     1682         assign
     1683           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1684           no-error .
     1685         if error-status :error
     1686         or error-status :get-message(1) <> ""
     1687         then do:
     1688           undo move_block, retry move_block .
     1689         end.
     1690         for each buf_temp-browse-handle
     1691           where buf_temp-browse-handle.browse-type = 'height':u
     1692         on error undo move_block, retry move_block
     1693         :
     1694           assign
     1695             buf_temp-browse-handle.browse-handle :height
     1696               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1697             no-error .
     1698           if error-status :error
     1699           or error-status :get-message(1) <> ""
     1700           then do:
     1701             undo move_block, retry move_block .
     1702           end.
     1703         end.
     1704         assign
     1705           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1706           no-error .
     1707         if error-status :error
     1708         or error-status :get-message(1) <> ""
     1709         then do:
     1710           undo move_block, retry move_block .
     1711         end.
     1712         if frame Dialog-Frame :scrollable = true
     1713         then do:
     1714           assign
     1715             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1716             no-error .
     1717           if error-status :error
     1718           or error-status :get-message(1) <> ""
     1719           then do:
     1720             undo move_block, retry move_block .
     1721           end.
     1722         end.
     1723       end.
     1724       if p-move-resize = true
     1725       then do:
     1726         run diasize_position-resize-button in this-procedure .
     1727       end.
     1728       if v-diasize-wndstore = true
     1729       then do:
     1730         if connected("ub") = true
     1731         then do:
     1732           define variable v-cntxt-db-num        as integer   no-undo .
     1733           define variable v-cntxt-userid        as character no-undo .
     1734           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1735                                             , OUTPUT v-cntxt-userid
     1736                                             ) .
     1737           run gbl/wndsizew.p
     1738             (input  v-cntxt-db-num
     1739             ,input  v-cntxt-userid
     1740             ,input  v-diasize-proc-name
     1741             ,input  'height':u
     1742             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1743             ) .
     1744         end.
     1745       end.
     1746     end.
     1747     assign
     1748       v-diasize-change-size = false
     1749     .
     1750   end procedure.
     1751   procedure diasize_set-height :
     1752     define input  parameter p-new-height  as decimal   no-undo .
     1753     define input  parameter p-move-resize as logical   no-undo .
     1754     do
     1755     on error undo, return error return-value
     1756     :
     1757       run diasize_change-height in this-procedure
     1758         (input  (p-new-height - frame Dialog-Frame :height)
     1759         ,input  p-move-resize
     1760         ) .
     1761     end.
     1762   end procedure.
     1763   procedure diasize_change-width :
     1764     define input  parameter p-change-value as decimal   no-undo .
     1765     define input  parameter p-move-resize  as logical   no-undo .
     1766     define variable v-field-group-handle   as handle    no-undo .
     1767     define variable v-object-handle        as handle    no-undo .
     1768     define variable v-frame-width          as decimal   no-undo .
     1769     define variable v-frame-virtual-width  as decimal   no-undo .
     1770     define variable v-browse-width         as decimal   no-undo .
     1771     define variable v-window-width         as decimal   no-undo .
     1772     define variable v-window-virtual-width as decimal   no-undo .
     1773     define variable v-change-sign          as integer   no-undo .
     1774     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1775     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1776     if p-change-value > 0
     1777     then do:
     1778       if frame Dialog-Frame :width + p-change-value >
     1779           session :width-chars
     1780       then do:
     1781         assign
     1782           p-change-value = session :width-chars - frame Dialog-Frame :width
     1783         .
     1784         if p-change-value <= 0
     1785         then do:
     1786           run diasize_position-resize-button in this-procedure .
     1787           return .
     1788         end.
     1789       end.
     1790     end.
     1791     if p-change-value < 0
     1792     then do:
     1793       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1794       then do:
     1795         assign
     1796           p-change-value = v-diasize-orig-frame-width
     1797                          - frame Dialog-Frame :width
     1798         .
     1799         if p-change-value >= 0
     1800         then do:
     1801           run diasize_position-resize-button in this-procedure .
     1802           return .
     1803         end.
     1804       end.
     1805     end.
     1806     if p-change-value >= 0
     1807     then do:
     1808       assign
     1809         v-change-sign = 1
     1810       .
     1811     end.
     1812     else do:
     1813       assign
     1814         v-change-sign = -1
     1815       .
     1816     end.
     1817     assign
     1818       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1819     .
     1820     if p-change-value = 0
     1821     then do:
     1822       run diasize_position-resize-button in this-procedure .
     1823       return .
     1824     end.
     1825     move_block:
     1826     do
     1827     on error undo move_block, leave move_block
     1828     :
     1829       if retry
     1830       then do:
     1831         do
     1832         on error undo move_block, leave move_block
     1833         :
     1834           if p-change-value > 0
     1835           then do:
     1836             for each buf_temp-diasize-handle
     1837             on error undo, next
     1838             :
     1839               assign
     1840                 v-object-handle = buf_temp-diasize-handle.handle-value
     1841               .
     1842               if v-object-handle <> v-diasize-resize-button
     1843               then do:
     1844                 assign
     1845                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1846                 .
     1847               end.
     1848             end.
     1849             assign
     1850               v-diasize-browse-handle :width = v-browse-width
     1851             .
     1852             for each buf_temp-browse-handle
     1853               where buf_temp-browse-handle.browse-type = 'width':u
     1854             on error undo, next
     1855             :
     1856               assign
     1857                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1858               .
     1859             end.
     1860             assign
     1861               frame Dialog-Frame :width = v-frame-width
     1862             .
     1863             if frame Dialog-Frame :scrollable = true
     1864             then do:
     1865               assign
     1866                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1867               .
     1868             end.
     1869             run diasize_position-resize-button in this-procedure .
     1870           end.
     1871           else do:
     1872             if frame Dialog-Frame :scrollable = true
     1873             then do:
     1874               assign
     1875                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1876               .
     1877             end.
     1878             assign
     1879               frame Dialog-Frame :width = v-frame-width
     1880             .
     1881             for each buf_temp-browse-handle
     1882               where buf_temp-browse-handle.browse-type = 'width':u
     1883             on error undo, next
     1884             :
     1885               assign
     1886                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1887               .
     1888             end.
     1889             assign
     1890               v-diasize-browse-handle :width = v-browse-width
     1891             .
     1892             for each buf_temp-diasize-handle
     1893             on error undo, next
     1894             :
     1895               assign
     1896                 v-object-handle = buf_temp-diasize-handle.handle-value
     1897               .
     1898               if v-object-handle <> v-diasize-resize-button
     1899               then do:
     1900                 assign
     1901                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1902                 .
     1903               end.
     1904             end.
     1905             run diasize_position-resize-button in this-procedure .
     1906           end.
     1907           assign
     1908             v-diasize-change-size = false
     1909           .
     1910           leave move_block .
     1911         end.
     1912       end.
     1913       assign
     1914         v-diasize-need-full-display = true
     1915       .
     1916       if v-diasize-change-size = false
     1917       then do:
     1918         assign
     1919           v-diasize-change-size = true
     1920         .
     1921       end.
     1922       else do:
     1923         return .
     1924       end.
     1925       assign
     1926         v-frame-width = frame Dialog-Frame :width
     1927         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1928         v-browse-width = v-diasize-browse-handle :width
     1929       .
     1930       for each buf_temp-browse-handle
     1931         where buf_temp-browse-handle.browse-type = 'width':u
     1932       :
     1933         assign
     1934           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1935         .
     1936       end.
     1937       for each buf_temp-diasize-handle
     1938       :
     1939         delete buf_temp-diasize-handle .
     1940       end.
     1941       assign
     1942         v-field-group-handle = frame Dialog-Frame :first-child
     1943       .
     1944       do while valid-handle(v-field-group-handle)
     1945       :
     1946         assign
     1947           v-object-handle = v-field-group-handle :first-child
     1948         .
     1949         do while valid-handle(v-object-handle)
     1950         :
     1951           if  v-object-handle <> v-diasize-browse-handle :handle
     1952           and v-object-handle <> v-diasize-resize-button
     1953           and can-query(v-object-handle, "row")
     1954           and can-query(v-object-handle, "height")
     1955           and ( v-object-handle :col + v-object-handle :width
     1956                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1957               )
     1958           then do:
     1959             find first buf_temp-browse-handle
     1960               where buf_temp-browse-handle.browse-type   = 'width':u
     1961                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1962               no-error .
     1963             if available buf_temp-browse-handle
     1964             then do:
     1965             end.
     1966             else do:
     1967               create buf_temp-diasize-handle .
     1968               assign
     1969                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1970                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1971               .
     1972             end.
     1973           end.
     1974           assign
     1975             v-object-handle = v-object-handle :next-sibling
     1976           .
     1977         end.
     1978         assign
     1979           v-field-group-handle = v-field-group-handle :next-sibling
     1980         .
     1981       end.
     1982       do with frame Dialog-Frame
     1983       :
     1984         hide v-diasize-resize-button .
     1985         v-diasize-resize-button :row = 1.
     1986         v-diasize-resize-button :column = 1.
     1987       end.
     1988       if p-change-value > 0
     1989       then do:
     1990         if frame Dialog-Frame :scrollable = true
     1991         then do:
     1992           assign
     1993             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1994             no-error .
     1995           if error-status :error
     1996           or error-status :get-message(1) <> ""
     1997           then do:
     1998             undo move_block, retry move_block.
     1999           end.
     2000         end.
     2001         assign
     2002           frame Dialog-Frame :width = v-frame-width + p-change-value
     2003           no-error .
     2004         if error-status :error
     2005         or error-status :get-message(1) <> ""
     2006         then do:
     2007           undo move_block, retry move_block.
     2008         end.
     2009         assign
     2010           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2011         no-error .
     2012         if error-status :error
     2013         or error-status :get-message(1) <> ""
     2014         then do:
     2015           undo move_block, retry move_block.
     2016         end.
     2017         for each buf_temp-browse-handle
     2018           where buf_temp-browse-handle.browse-type = 'width':u
     2019         on error undo move_block, retry move_block
     2020         :
     2021           assign
     2022             buf_temp-browse-handle.browse-handle :width
     2023               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2024             no-error .
     2025           if error-status :error
     2026           or error-status :get-message(1) <> ""
     2027           then do:
     2028             undo move_block, retry move_block .
     2029           end.
     2030         end.
     2031         for each buf_temp-diasize-handle
     2032         on error undo move_block, retry move_block
     2033         :
     2034           assign
     2035             v-object-handle = buf_temp-diasize-handle.handle-value
     2036           .
     2037           if v-object-handle <> v-diasize-resize-button
     2038           then do:
     2039             assign
     2040               v-object-handle :col = v-object-handle :col + p-change-value
     2041               no-error .
     2042             if error-status :error
     2043             or error-status :get-message(1) <> ""
     2044             then do:
     2045               undo move_block, retry move_block .
     2046             end.
     2047           end.
     2048         end.
     2049       end.
     2050       else do:
     2051         for each buf_temp-diasize-handle
     2052         on error undo move_block, retry move_block
     2053         :
     2054           assign
     2055             v-object-handle = buf_temp-diasize-handle.handle-value
     2056           .
     2057           if v-object-handle <> v-diasize-resize-button
     2058           then do:
     2059             assign
     2060               v-object-handle :col = v-object-handle :col + p-change-value
     2061               no-error .
     2062             if error-status :error
     2063             or error-status :get-message(1) <> ""
     2064             then do:
     2065               undo move_block, retry move_block .
     2066             end.
     2067           end.
     2068         end.
     2069         for each buf_temp-browse-handle
     2070           where buf_temp-browse-handle.browse-type = 'width':u
     2071         on error undo move_block, retry move_block
     2072         :
     2073           assign
     2074             buf_temp-browse-handle.browse-handle :width
     2075               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2076             no-error .
     2077           if error-status :error
     2078           or error-status :get-message(1) <> ""
     2079           then do:
     2080             undo move_block, retry move_block .
     2081           end.
     2082         end.
     2083         assign
     2084           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2085           no-error .
     2086         if error-status :error
     2087         or error-status :get-message(1) <> ""
     2088         then do:
     2089           undo move_block, retry move_block.
     2090         end.
     2091         assign
     2092           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2093         no-error .
     2094         if error-status :error
     2095         or error-status :get-message(1) <> ""
     2096         then do:
     2097           undo move_block, retry move_block.
     2098         end.
     2099         if frame Dialog-Frame :scrollable = true
     2100         then do:
     2101           assign
     2102             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2103           no-error .
     2104           if error-status :error
     2105           or error-status :get-message(1) <> ""
     2106           then do:
     2107             undo move_block, retry move_block.
     2108           end.
     2109         end.
     2110       end.
     2111       if p-move-resize
     2112       then do:
     2113         run diasize_position-resize-button in this-procedure .
     2114       end.
     2115       if v-diasize-wndstore = true
     2116       then do:
     2117         if connected("ub") = true
     2118         then do:
     2119           define variable v-cntxt-db-num        as integer   no-undo .
     2120           define variable v-cntxt-userid        as character no-undo .
     2121           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2122                                             , OUTPUT v-cntxt-userid
     2123                                             ) .
     2124           run gbl/wndsizew.p
     2125             (input  v-cntxt-db-num
     2126             ,input  v-cntxt-userid
     2127             ,input  v-diasize-proc-name
     2128             ,input  'width':u
     2129             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2130             ) .
     2131         end.
     2132       end.
     2133     end.
     2134     assign
     2135       v-diasize-change-size = false
     2136     .
     2137   end procedure.
     2138   procedure diasize_set-width :
     2139     define input  parameter p-new-width  as decimal   no-undo .
     2140     define input  parameter p-move-resize as logical   no-undo .
     2141     do
     2142     on error undo, return error return-value
     2143     :
     2144       run diasize_change-width in this-procedure
     2145         (input  (p-new-width - frame Dialog-Frame :width)
     2146         ,input  p-move-resize
     2147         ) .
     2148     end.
     2149   end procedure.
     2150   procedure diasize_position-resize-button :
     2151     do with frame Dialog-Frame
     2152     :
     2153       hide v-diasize-resize-button .
     2154       assign
     2155         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2156                     - 1
     2157                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2158         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2159                     - 1
     2160                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2161       .
     2162       view v-diasize-resize-button .
     2163     end.
     2164   end procedure.
     2165   on alt-right anywhere
     2166   do:
     2167     run diasize_change-width in this-procedure
     2168       (input 1
     2169       ,input true
     2170       ) .
     2171     return no-apply .
     2172   end.
     2173   on alt-left anywhere
     2174   do:
     2175     run diasize_change-width in this-procedure
     2176       (input -1
     2177       ,input true
     2178       ) .
     2179     return no-apply .
     2180   end.
     2181   on alt-down anywhere
     2182   do:
     2183     run diasize_change-height in this-procedure
     2184       (input 1
     2185       ,input true
     2186       ) .
     2187     return no-apply .
     2188   end.
     2189   on alt-up anywhere
     2190   do:
     2191     run diasize_change-height in this-procedure
     2192       (input -1
     2193       ,input true
     2194       ) .
     2195     return no-apply .
     2196   end.
     2197   on alt-enter of frame Dialog-Frame
     2198   do:
     2199     run diasize_maximize in this-procedure
     2200       (input  ?
     2201       ).
     2202     return no-apply .
     2203   end.
     2204   procedure diasize_end-move :
     2205     do
     2206     on error undo, return error return-value
     2207     :
     2208       define variable v-row-delta as decimal   no-undo .
     2209       define variable v-col-delta as decimal   no-undo .
     2210       define variable v-new-row as decimal   no-undo .
     2211       define variable v-new-col as decimal   no-undo .
     2212       assign
     2213         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2214         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2215       .
     2216       assign
     2217         v-row-delta = v-new-row - frame Dialog-Frame :height
     2218         v-col-delta = v-new-col - frame Dialog-Frame :width
     2219       .
     2220       run diasize_change-height in this-procedure
     2221         (input v-row-delta
     2222         ,input true
     2223         ) .
     2224       run diasize_change-width in this-procedure
     2225         (input v-col-delta
     2226         ,input true
     2227         ) .
     2228     end.
     2229   end procedure.
     2230   procedure diasize_maximize :
     2231     define input  parameter p-action as logical   no-undo .
     2232     do
     2233     on error undo, return error return-value
     2234     :
     2235       if p-action = ?
     2236       then do:
     2237         if v-diasize-need-maximize = true
     2238         then do:
     2239           assign
     2240             p-action = true
     2241           .
     2242         end.
     2243         else do:
     2244           assign
     2245             p-action = false
     2246           .
     2247         end.
     2248       end.
     2249       if p-action = true
     2250       then do:
     2251         run diasize_change-height in this-procedure
     2252           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2253               - frame Dialog-Frame :height-chars
     2254           ,input true
     2255           ) .
     2256         run diasize_change-width in this-procedure
     2257           (input session :width-chars
     2258               - frame Dialog-Frame :width-chars
     2259           ,input true
     2260           ) .
     2261         assign
     2262           v-diasize-need-maximize = false
     2263         .
     2264       end.
     2265       else do:
     2266         run diasize_change-width in this-procedure
     2267           (input v-diasize-orig-frame-width
     2268               - frame Dialog-Frame :width-chars
     2269           ,input true
     2270           ) .
     2271         run diasize_change-height in this-procedure
     2272           (input v-diasize-orig-frame-height
     2273               - frame Dialog-Frame :height-chars
     2274           ,input true
     2275           ) .
     2276         assign
     2277           v-diasize-need-maximize = true
     2278         .
     2279       end.
     2280     end.
     2281   end procedure.
     2282   procedure diasize_restore-orig-size :
     2283     do
     2284     on error undo, return error return-value
     2285     :
     2286       assign
     2287         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2288         v-diasize-current-frame-height = frame Dialog-Frame :height
     2289       .
     2290       run diasize_set-height in this-procedure
     2291         (input  v-diasize-orig-frame-height
     2292         ,input  true
     2293         ) .
     2294       run diasize_set-width in this-procedure
     2295         (input  v-diasize-orig-frame-width
     2296         ,input  true
     2297         ) .
     2298     end.
     2299   end procedure.
     2300   procedure diasize_restore-current-size :
     2301     do
     2302     on error undo, return error return-value
     2303     :
     2304       run diasize_set-height in this-procedure
     2305         (input  v-diasize-current-frame-height
     2306         ,input  true
     2307         ) .
     2308       run diasize_set-width in this-procedure
     2309         (input  v-diasize-current-frame-width
     2310         ,input  true
     2311         ) .
     2312     end.
     2313   end procedure.
     2314   procedure diasize_set-browse-handle :
     2315     define input  parameter p-browse-handle as handle   no-undo .
     2316     define buffer buf_temp-browse-handle for temp-browse-handle .
     2317     do
     2318     on error undo, return error return-value
     2319     :
     2320       assign
     2321         v-diasize-browse-handle = p-browse-handle
     2322       .
     2323       for each buf_temp-browse-handle
     2324       on error undo, return error return-value
     2325       :
     2326         delete buf_temp-browse-handle .
     2327       end.
     2328     end.
     2329   end procedure.
     2330   procedure diasize_add_browse :
     2331     define input  parameter p-browse-type   as character no-undo .
     2332     define input  parameter p-browse-handle as handle    no-undo .
     2333     define buffer buf_temp-browse-handle for temp-browse-handle .
     2334     do
     2335     on error undo, return error return-value
     2336     :
     2337       assign
     2338         v-diasize-browse-number = v-diasize-browse-number + 1
     2339       .
     2340       create buf_temp-browse-handle .
     2341       assign
     2342         buf_temp-browse-handle.browse-type   = p-browse-type
     2343         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2344         buf_temp-browse-handle.browse-handle = p-browse-handle
     2345       .
     2346     end.
     2347   end procedure.
     2348   procedure diasize_init :
     2349     define variable v-default-value    as logical   no-undo .
     2350     define variable v-restore-saved    as logical   no-undo .
     2351     define variable v-resize-value-str as character no-undo .
     2352     do
     2353     on error undo, return error return-value
     2354     :
     2355       do with frame Dialog-Frame
     2356       :
     2357         assign
     2358           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2359           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2360           v-diasize-browse-handle     = browse br-dis-dct-rule :handle
     2361         .
     2362         create button v-diasize-resize-button
     2363         assign
     2364           parent        = frame Dialog-Frame :first-child
     2365           label         = "s"
     2366           height-pixels = 16
     2367           width-pixels  = 16
     2368           visible       = true
     2369           sensitive     = true
     2370           movable       = true
     2371           triggers:
     2372             on end-move persistent run diasize_end-move in this-procedure .
     2373           end triggers.
     2374         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2375         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2376         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2377         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2378         assign
     2379           v-diasize-wndmax = false
     2380         .
     2381         if connected("ub") = true
     2382         then do:
     2383           define variable v-cntxt-db-num        as integer   no-undo .
     2384           define variable v-cntxt-userid        as character no-undo .
     2385           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2386                                             , OUTPUT v-cntxt-userid
     2387                                             ) .
     2388           run gbl/wndpar_r.p
     2389             (input  v-cntxt-db-num
     2390             ,input  v-cntxt-userid
     2391             ,input  'wndmax':U
     2392             ,output v-diasize-wndmax
     2393             ,output v-default-value
     2394             ) .
     2395         end.
     2396         assign
     2397           v-diasize-wndstore = false
     2398         .
     2399         if connected("ub") = true
     2400         then do:
     2401           run gbl/wndpar_r.p
     2402             (input  v-cntxt-db-num
     2403             ,input  v-cntxt-userid
     2404             ,input  'wndstore':U
     2405             ,output v-diasize-wndstore
     2406             ,output v-default-value
     2407             ) .
     2408         end.
     2409         assign
     2410           v-diasize-proc-name = entry(1, program-name(2), '.')
     2411         .
     2412         if v-diasize-wndstore = true
     2413         then do:
     2414           assign
     2415             v-restore-saved = false
     2416           .
     2417           if connected("ub") = true
     2418           then do:
     2419             run gbl/wndsizer.p
     2420               (input  v-cntxt-db-num
     2421               ,input  v-cntxt-userid
     2422               ,input  v-diasize-proc-name
     2423               ,input  'height':u
     2424               ,output v-resize-value-str
     2425               ) .
     2426             if v-resize-value-str <> '':U
     2427             then do:
     2428               run diasize_change-height in this-procedure
     2429                 (input  integer(v-resize-value-str)
     2430                 ,input  true
     2431                 ) .
     2432               assign
     2433                 v-restore-saved = true
     2434               .
     2435             end.
     2436           end.
     2437           if connected("ub") = true
     2438           then do:
     2439             run gbl/wndsizer.p
     2440               (input  v-cntxt-db-num
     2441               ,input  v-cntxt-userid
     2442               ,input  v-diasize-proc-name
     2443               ,input  'width':u
     2444               ,output v-resize-value-str
     2445               ) .
     2446             if v-resize-value-str <> '':U
     2447             then do:
     2448               run diasize_change-width in this-procedure
     2449                 (input  integer(v-resize-value-str)
     2450                 ,input  true
     2451                 ) .
     2452               assign
     2453                 v-restore-saved = true
     2454               .
     2455             end.
     2456           end.
     2457           if v-restore-saved <> true
     2458           then do:
     2459             if v-diasize-wndmax = true
     2460             then do:
     2461               run diasize_maximize in this-procedure
     2462                 (input  true
     2463                 ) .
     2464             end.
     2465           end.
     2466         end.
     2467         else do:
     2468           if v-diasize-wndmax = true
     2469           then do:
     2470             run diasize_maximize in this-procedure
     2471               (input  true
     2472               ) .
     2473           end.
     2474         end.
     2475       end.
     2476     end.
     2477   end procedure.
     2478   procedure diasize_need-full-display :
     2479     define output parameter p-need-full-display as logical   no-undo .
     2480     do
     2481     on error undo, return error return-value
     2482     :
     2483       assign
     2484         p-need-full-display = v-diasize-need-full-display
     2485       .
     2486       assign
     2487         v-diasize-need-full-display = false
     2488       .
     2489     end.
     2490   end procedure.
     2491   procedure get-context :
     2492      define output parameter p-db-num as integer          no-undo.
     2493      define output parameter p-user-id as character        no-undo.
     2494      define variable v-login               as character    no-undo.
     2495      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2496      define buffer buf_user-login  for ub.user-login .
     2497      do
     2498      on error undo, return error
     2499      :
     2500            FIND FIRST buf_sys-ctrl no-lock.
     2501            ASSIGN
     2502               v-login = USERID("ub")
     2503               p-db-num = buf_sys-ctrl.db-num
     2504            .
     2505            FIND FIRST buf_user-login
     2506                 WHERE buf_user-login.db-num = p-db-num
     2507                   AND buf_user-login.user-login = v-login
     2508                 no-lock
     2509                 no-error
     2510                 .
     2511            IF AVAILABLE buf_user-login
     2512            THEN DO:
     2513               assign
     2514                  p-user-id = buf_user-login.user-id
     2515               .
     2516            END.
     2517      end.
     2518   end procedure.
     2519   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2520   procedure set-filter-name :
     2521   define input parameter p-filter-name as character no-undo .
     2522     do with frame Dialog-Frame:
     2523       if p-filter-name > "" then do:
     2524         assign
     2525           frame Dialog-Frame:title
     2526             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2527         .
     2528         assign
     2529           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2530         .
     2531       end.
     2532       else do:
     2533         assign
     2534           b-sch :tooltip = ""
     2535         .
     2536       end.
     2537     end.
     2538   end procedure.
     2539   def var sort-labelbr-dis-dct-rule   as character no-undo .
     2540   def var sort-clmnbr-dis-dct-rule    as handle    no-undo .
     2541   def var cur-clmnbr-dis-dct-rule     as handle    no-undo .
     2542   def var cur-clmn-locbr-dis-dct-rule as integer   no-undo .
     2543   def var re-querybr-dis-dct-rule     as logical   initial no no-undo .
     2544   on start-search, ctrl-o of br-dis-dct-rule in frame Dialog-Frame do:
     2545      run sort-brbr-dis-dct-rule
     2546        (input (if available X_dis-dct-rule
     2547                then recid(X_dis-dct-rule)
     2548                else ?
     2549               )
     2550        ).
     2551   end.
     2552   PROCEDURE sort-brbr-dis-dct-rule :
     2553     define input parameter p-recid as recid no-undo .
     2554     if re-querybr-dis-dct-rule = no then do:
     2555       assign
     2556          cur-clmnbr-dis-dct-rule = br-dis-dct-rule:current-column in frame Dialog-Frame
     2557       .
     2558       if sort-clmnbr-dis-dct-rule <> ? then sort-clmnbr-dis-dct-rule:column-fgcolor = 0.
     2559       if cur-clmnbr-dis-dct-rule = sort-clmnbr-dis-dct-rule then do:
     2560         assign
     2561            sort-labelbr-dis-dct-rule = ""
     2562            sort-clmnbr-dis-dct-rule = ?
     2563         .
     2564        end.
     2565        else do:
     2566          assign
     2567            sort-labelbr-dis-dct-rule = cur-clmnbr-dis-dct-rule:label
     2568            sort-clmnbr-dis-dct-rule  = cur-clmnbr-dis-dct-rule
     2569            sort-clmnbr-dis-dct-rule:column-fgcolor = 4
     2570          .
     2571        end.
     2572      end.
     2573     assign
     2574       cur-clmn-locbr-dis-dct-rule = 1
     2575     .
     2576     def var column-handle as handle no-undo .
     2577     column-handle = br-dis-dct-rule:first-column.
     2578     do while valid-handle(column-handle) :
     2579       if column-handle = cur-clmnbr-dis-dct-rule then do:
     2580         leave .
     2581       end.
     2582       column-handle = column-handle:NEXT-COLUMN.
     2583       assign
     2584         cur-clmn-locbr-dis-dct-rule = cur-clmn-locbr-dis-dct-rule + 1
     2585       .
     2586     end.
     2587     case sort-labelbr-dis-dct-rule:
     2588           when '*'  then DO:    assign       sort-column-name = "mark-string(recid(X_dis-dct-rule), v-rid-list)"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2589           when 'Эмитент'  then DO:    assign       sort-column-name = "X_dis-card-type.emitent-host-code"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2590           when 'Тип'  then DO:    assign       sort-column-name = "X_dis-card-type.type"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2591           when 'Тип правила'  then DO:    assign       sort-column-name = "X_dis-dct-rule.templ-rl-root"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2592           when 'Место использ.'  then DO:    assign       sort-column-name = "cd-type-name(X_dis-dct-rule.pos-type)"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2593           when 'Тип объ'  then DO:    assign       sort-column-name = "X_dis-dct-rule.obj-type"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2594           when 'Код объ'  then DO:    assign       sort-column-name = "X_dis-dct-rule.obj-code"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2595           when 'Тип скидки'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1dis-dct-rule-name&1, X_dis-dct-rule.discnt-role)', chr(34))     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2596           when '№ правила'  then DO:    assign       sort-column-name = "X_dis-dct-rule.rule-num"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2597           when '№ корн.!правила'  then DO:    assign       sort-column-name = "X_dis-dct-rule.rl-root"     .     run OpenBr in this-procedure ( input yes, input no, input no).   . END.
     2598       otherwise do:
     2599         assign
     2600           sort-column-name = ""
     2601         .
     2602         run OpenBr in this-procedure ( input yes, input no, input no).
     2603         if sort-labelbr-dis-dct-rule <> "" then do:
     2604           assign
     2605             cur-clmnbr-dis-dct-rule:column-fgcolor = 0
     2606           .
     2607         end.
     2608         assign
     2609           cur-clmn-locbr-dis-dct-rule = ?
     2610         .
     2611       end.
     2612     end case.
     2613     if p-recid <> ? then do:
     2614       reposition br-dis-dct-rule to recid p-recid no-error.
     2615       apply "value-changed" to br-dis-dct-rule in frame Dialog-Frame.
     2616     end.
     2617     apply "entry" to br-dis-dct-rule in frame Dialog-Frame.
     2618   END PROCEDURE.
     2619   procedure re-open-query-srt-clmnbr-dis-dct-rule:
     2620   if cur-clmnbr-dis-dct-rule = ? then do:
     2621      run OpenBr in this-procedure ( input yes, input no, input no).
     2622   end.
     2623   else do:
     2624      assign re-querybr-dis-dct-rule = yes.
     2625      run sort-brbr-dis-dct-rule
     2626        (input (if available X_dis-dct-rule
     2627                then recid(X_dis-dct-rule)
     2628                else ?
     2629               )
     2630        ).
     2631      assign re-querybr-dis-dct-rule = no.
     2632   end.
     2633   end.
     2634   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2635   do:
     2636     BR-dis-dct-rule :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2637   end.
     2638   MAIN-BLOCK:
     2639   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2640      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2641   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2642     run mainmenu_getcntxt in parparentproc
     2643       (output v-cntxt-db-num
     2644       ,output v-cntxt-userid
     2645       ,output v-cntxt-level
     2646       ,output v-cntxt-host-code-obj
     2647       ,output v-cntxt-obj-type
     2648       ,output v-cntxt-obj-code
     2649       ,output v-cntxt-db-num-obj
     2650       ,output v-cntxt-is-admin
     2651       ) .
     2652     IF lookup(p-list-mode, ('все':U + chr(4) +
     2653                             "pos" + chr(4) +
     2654                             "templ-rl-root" + chr(4) +
     2655                             "discnt-role" + chr(4) +
     2656                             'объект':U + chr(4) +
     2657                             ('объект':U + chr(44) + "pos-type":U) + chr(4) +
     2658                             ('объект':U + chr(44) + "templ-rl-root":U) + chr(4) +
     2659                             ('объект':U + chr(44) + "discnt-role":U) + chr(4) +
     2660                             "rule-num":U + chr(4) +
     2661                             "rl-root":U + chr(4) +
     2662                             'dis-card-type':U + chr(4) +
     2663                              ('dis-card-type':U + chr(44) + "temp")) , chr(4)) = 0
     2664     THEN DO:
     2665        MESSAGE
     2666        vss-workfile vss-revision vss-description skip
     2667        "Неверный параметр вызова p-list-mode " p-list-mode
     2668        VIEW-AS ALERT-BOX ERROR.
     2669        UNDO, RETURN ERROR.
     2670     END.
     2671     if p-list-mode = ('dis-card-type':U + chr(44) + "temp") then do:
     2672       temp-mode = yes.
     2673     end.
     2674     IF lookup('объект':U , p-list-mode) > 0 THEN DO:
     2675       IF p-curr-obj-type <> 'скл':U
     2676       AND p-curr-obj-type <> 'маг':U THEN DO:
     2677           MESSAGE
     2678           vss-workfile vss-revision vss-description skip
     2679           "Неверный параметр вызова p-curr-obj-type " p-curr-obj-type
     2680           VIEW-AS ALERT-BOX ERROR.
     2681           UNDO, RETURN ERROR.
     2682       END.
     2683       FIND FIRST X_clients-obj NO-LOCK WHERE
     2684                 X_clients-obj.obj-type = p-curr-obj-type
     2685            AND  X_clients-obj.obj-code = p-curr-obj-code NO-ERROR.
     2686       IF NOT AVAILABLE X_clients-obj THEN DO:
     2687           MESSAGE
     2688           vss-workfile vss-revision vss-description skip
     2689           "Неверные параметры вызова p-curr-obj-type p-curr-obj-code" p-curr-obj-type p-curr-obj-code
     2690           VIEW-AS ALERT-BOX ERROR.
     2691           UNDO, RETURN ERROR.
     2692       END.
     2693     end.
     2694     IF LOOKUP( "templ-rl-root", p-list-mode) > 0 THEN DO:
     2695         FIND FIRST PAR_dis-rule NO-LOCK WHERE
     2696                   par_dis-rule.rule-num = p-templ-rl-root no-error.
     2697         IF NOT AVAILABLE par_Dis-rule THEN DO:
     2698             MESSAGE
     2699             vss-workfile vss-revision vss-description skip
     2700             "Неверный параметр вызова p-templ-rl-root" p-templ-rl-root
     2701             VIEW-AS ALERT-BOX ERROR.
     2702             UNDO, RETURN ERROR.
     2703         END.
     2704     END.
     2705     IF LOOKUP( "pos-type", p-list-mode) > 0
     2706     AND lookup(p-pos-type, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA':U) = 0  THEN DO:
     2707         MESSAGE
     2708         vss-workfile vss-revision vss-description skip
     2709         "Неверный параметр вызова p-pos-type" p-pos-type
     2710         VIEW-AS ALERT-BOX ERROR.
     2711         UNDO, RETURN ERROR.
     2712     END.
     2713     IF LOOKUP( "discnt-role", p-list-mode) > 0 THEN DO:
     2714       FIND FIRST par_dis-cfg-rule NO-LOCK WHERE
     2715                 par_dis-cfg-rule.discnt-role = p-discnt-role
     2716             AND par_dis-cfg-rule.TABLE-name = 'dis-dct-rule':U NO-ERROR.
     2717       IF NOT AVAILABLE par_dis-cfg-rule  THEN DO:
     2718         MESSAGE
     2719         vss-workfile vss-revision vss-description skip
     2720         "Неверный параметр вызова p-discnt-role" p-discnt-role
     2721         VIEW-AS ALERT-BOX ERROR.
     2722         UNDO, RETURN ERROR.
     2723       END.
     2724     END.
     2725     if lookup('dis-card-type':U, p-list-mode) > 0
     2726     and not temp-mode  then do:
     2727       find first buf_dis-card-type no-lock where
     2728                 buf_dis-card-type.emitent-host-code = p-emitent-host-code
     2729             and buf_dis-card-type.type = p-type
     2730             and buf_dis-card-type.host-code = 0
     2731             and buf_dis-card-type.obj-type = '':U
     2732             and buf_dis-card-type.obj-code = 0 no-error .
     2733       if not available buf_dis-card-type then do:
     2734         MESSAGE
     2735         vss-workfile vss-revision vss-description skip(0)
     2736         substitute("Неверные параметры вызова p-emitent-host-code=&1&2" +
     2737                    "p-type=&3"
     2738                    ,p-emitent-host-code
     2739                    ,chr(10)
     2740                    ,p-type )
     2741         VIEW-AS ALERT-BOX ERROR.
     2742         UNDO, RETURN ERROR.
     2743       end.
     2744     end.
     2745     v-rid-list = p-rid-list.
     2746     if temp-mode then do:
     2747       run fill-tt0-dis-dct-rule in (this-procedure:instantiating-procedure) ( input (buffer tt00-dis-dct-rule:handle)).
     2748       run fill-tt0-dis-card-type in (this-procedure:instantiating-procedure) ( input (buffer tt00-dis-card-type:handle)).
     2749     end.
     2750     RUN Myenable IN THIS-PROCEDURE NO-ERROR.
     2751     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2752     WAIT-FOR GO OF FRAME Dialog-Frame.
     2753   END.
     2754   RUN disable_UI.
     2755   PROCEDURE disable_UI :
     2756     HIDE FRAME Dialog-Frame.
     2757   END PROCEDURE.
     2758   PROCEDURE enable_UI :
     2759     DISPLAY mark-num
     2760         WITH FRAME Dialog-Frame.
     2761     ENABLE b-quit B-mark B-sel B-type b-dis-rule B-sch B-print b-history B-Help
     2762            BR-tt0-dis-dct-rule BR-dis-dct-rule mark-num
     2763         WITH FRAME Dialog-Frame.
     2764     VIEW FRAME Dialog-Frame.
     2765     OPEN QUERY BR-dis-dct-rule FOR EACH X_dis-dct-rule NO-LOCK ,            FIRST X_dis-card-type NO-LOCK WHERE           X_dis-card-type.type = X_dis-dct-rule.type        AND X_dis-card-type.emitent-host-code = X_dis-dct-rule.emitent-host-code INDEXED-REPOSITION.    OPEN QUERY BR-tt0-dis-dct-rule FOR EACH tt0-dis-dct-rule NO-LOCK ,            FIRST tt0-dis-card-type NO-LOCK WHERE           tt0-dis-card-type.type = tt0-dis-dct-rule.type        AND tt0-dis-card-type.emitent-host-code = tt0-dis-dct-rule.emitent-host-code INDEXED-REPOSITION.
     2766   END PROCEDURE.
     2767   PROCEDURE MyEnable :
     2768   define variable v-h as handle no-undo .
     2769   v-h = BR-dis-dct-rule:FIRST-COLUMN IN FRAME Dialog-Frame.
     2770   DO while valid-handle(v-h) :
     2771     if v-h:LABEL = 'Тип скидки' then do:
     2772       v-h:RESIZABLE = YES.
     2773       leave.
     2774     end.
     2775     ELSE DO:
     2776       v-h = v-h:NEXT-COLUMN.
     2777     END.
     2778   END.
     2779   v-h = BR-tt0-dis-dct-rule:FIRST-COLUMN IN FRAME Dialog-Frame.
     2780   DO while valid-handle(v-h) :
     2781     if v-h:LABEL = 'Тип скидки' then do:
     2782       v-h:RESIZABLE = YES.
     2783       leave.
     2784     end.
     2785     ELSE DO:
     2786       v-h = v-h:NEXT-COLUMN.
     2787     END.
     2788   END.
     2789   DISPLAY
     2790   mark-num
     2791   WITH FRAME Dialog-Frame.
     2792   ENABLE
     2793   b-quit
     2794   B-mark WHEN LOOKUP("b-mark", bttn) > 0
     2795   B-sel WHEN LOOKUP("b-mark", bttn) > 0
     2796   b-type when not temp-mode
     2797   b-dis-rule
     2798   B-sch when not temp-mode
     2799   B-print when not temp-mode
     2800   b-history when not temp-mode
     2801   B-Help
     2802   WITH FRAME Dialog-Frame.
     2803   if temp-mode then do:
     2804       enable
     2805       BR-tt0-dis-dct-rule
     2806       with frame Dialog-Frame.
     2807       hide br-dis-dct-rule in frame Dialog-Frame.
     2808       VIEW FRAME Dialog-Frame.
     2809       RUn Openbrtt in this-procedure ( input yes, input no, input '':U).
     2810   end.
     2811   else do:
     2812       enable
     2813       BR-dis-dct-rule
     2814       with frame Dialog-Frame.
     2815       hide br-tt0-dis-dct-rule in frame Dialog-Frame.
     2816       VIEW FRAME Dialog-Frame.
     2817       RUn Openbr in this-procedure ( input yes, input no, input '':U).
     2818   end.
     2819   END PROCEDURE.
     2820   PROCEDURE OpenBr :
     2821   define input  parameter p-open-query     as logical   no-undo .
